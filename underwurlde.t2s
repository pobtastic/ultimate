; tap2sna.py file for Underwurlde. Run
;
;   $ tap2sna.py @underwurlde.t2s
;
; to create a Z80 snapshot.

https://zxaaa.net/DENIED/Underwurlde%20(1984)(Ultimate).tzx
Underwurlde.z80

--sim-load-config accelerator=speedlock

; The tape loader's own stub at $67F2 (DI; LD HL,$6801; LD DE,$6800;
; LD BC,$8800; LDIR; JP $7680) moves the game down into place before starting
; it, and the simulation runs that stub, so stopping at the start address
; leaves the game at its real addresses with nothing else to do here.
--start 30336
--stack 24576

;--ram call=utils:ram.decrypt_underwurlde

; from tape block #22 to address 16385.
;--ram load=22,$4001 ;  6913 bytes ; Loading SCREEN$
;--ram load=32,$67F2 ; 34821 bytes ; Game code

;--ram poke=$4000,$FF
