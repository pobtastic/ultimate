; Print Outlaw Name
;
; Used by the routine at #R$D3A7.
; .
; Prints the name of the outlaw who is wanted at the current level on the
; wanted poster. The name has two parts, printed on two lines. Each part is
; centred.
; #PUSHS #UDGTABLE { #POKES$5C79,$56
; #SIM(start=$A36D,stop=$A392,clear=1,sp=$5E00)
; #SIM(start=$A395,stop=$A3B3)
; #SIM(start=$C7D1,stop=$A3B7)
; #SIM(start=$A3B7,stop=$D3CE)
; #SIM(start=$D3CE,stop=$D3D1)
; #SCR$03,$00,$04,$08,$02(outlaw-name) } UDGTABLE# #POPS
;
; .
;
; Find the two parts of the name.
@label=PrintOutlawName
c$B1F4 LD HL,$B4A8    ; Point #REGhl at the table of names.
 $B1F7 LD A,($A260)   ; Fetch the level.
 $B1FA ADD A,A        ; Double it, as there are two parts for each level.
 $B1FB LD B,A         ; Keep the doubled level in #REGb, one part per level.
 $B1FC JR Z,$B205     ; Jump to #R$B205 if this is the first level.
@label=PrintOutlawName_Skip
*$B1FE BIT 7,(HL)     ; Test whether this is the last character of a part.
 $B200 INC HL         ; Move on to the next character.
 $B201 JR Z,$B1FE     ; Loop back until the end of the part.
 $B203 DJNZ $B1FE     ; Loop back until the right parts have been reached.
@label=PrintOutlawName_Found
*$B205 PUSH HL        ; {Copy #REGhl to #REGiy (using the stack).
 $B206 POP IY         ; }
; Print the first part.
 $B208 LD DE,$4083    ; Point #REGde at #N$4083 (in the screen buffer).
 $B20B CALL $B211     ; Call #R$B211 to print it.
; Print the second part.
 $B20E LD DE,$40A3    ; Point #REGde at #N$40A3 (in the screen buffer).
; Print a part of the name, centred on the screen address in #REGde. If
; the part has an even number of characters it is centred exactly, and otherwise
; it is half a character to the right, using a table which shifts a row of
; pixels right by four.
@label=PrintOutlawName_Part
*$B211 PUSH IY        ; {Copy #REGiy to #REGhl (using the stack).
 $B213 POP HL         ; }
 $B214 XOR A          ; Set the number of characters to zero.
@label=PrintOutlawName_Count
*$B215 BIT 7,(HL)     ; {Jump to #R$B21D if this is the last character.
 $B217 JR NZ,$B21D    ; }
 $B219 INC HL         ; Move on to the next character.
 $B21A INC A          ; Add one to the number of characters.
 $B21B JR $B215       ; Go back to check the next character.
@label=PrintOutlawName_Centre
*$B21D PUSH AF        ; Stash the number of characters, less one, on the stack.
 $B21E CPL            ; Invert it.
 $B21F AND %00000001  ; Keep bit 0.
 $B221 LD ($A213),A   ; Store it, which is one if there is an odd number of
                      ; characters.
 $B224 POP AF         ; Retrieve the number of characters.
 $B225 SRL A          ; Halve it.
 $B227 NEG            ; Negate it.
 $B229 ADD A,E        ; Add the horizontal position of the screen address.
 $B22A LD E,A         ; Move to the left by half the length.
; Print the next character.
@label=PrintOutlawName_Character
*$B22B LD A,(IY+$00)  ; Fetch the character.
 $B22E AND %01111111  ; Remove the terminator.
 $B230 CALL $D4EA     ; Convert the character to the number of its tile.
 $B233 LD L,A         ; Copy the number into #REGl.
 $B234 LD H,$00       ; Clear #REGh.
 $B236 ADD HL,HL      ; {Multiply it by eight.
 $B237 ADD HL,HL      ;
 $B238 ADD HL,HL      ; }
 $B239 LD BC,$8EA8    ; Point #REGbc at #R$8EA8.
 $B23C ADD HL,BC      ; Find the pixels of the character.
 $B23D EX DE,HL       ; Swap the pixels into #REGde and the screen address into
                      ; #REGhl.
 $B23E LD A,($A213)   ; Fetch the flag.
 $B241 AND A          ; {Jump to #R$B26A if there is an even number of
 $B242 JR Z,$B26A     ; characters.}
; There is an odd number of characters, so shift each character four
; pixels to the right across two cells.
 $B244 LD B,$FC       ; Point #REGb at the table which shifts a byte by four
                      ; pixels.
 $B246 LD A,$08       ; Set the number of rows to eight.
@label=PrintOutlawName_ShiftedRow
*$B248 EX AF,AF'      ; Keep the number of rows in the alternate accumulator.
 $B249 LD A,(DE)      ; Fetch a row of pixels.
 $B24A INC DE         ; Move on to the next row.
 $B24B LD C,A         ; Use them as an index into the table.
 $B24C LD A,(BC)      ; Fetch the left part of the shifted byte.
 $B24D OR (HL)        ; Combine it with the screen.
 $B24E LD (HL),A      ; Write it to the screen.
 $B24F INC L          ; Move across to the next cell.
 $B250 INC B          ; Point #REGb at the other half of the table.
 $B251 LD A,(BC)      ; Fetch the right part of the shifted byte.
 $B252 DEC B          ; Point #REGb back at the first half of the table.
 $B253 OR (HL)        ; Combine it with the screen.
 $B254 LD (HL),A      ; Write it to the screen.
 $B255 DEC L          ; Move back to the first cell.
 $B256 INC H          ; Move down a pixel row.
 $B257 EX AF,AF'      ; Fetch the number of rows.
 $B258 DEC A          ; Count down the rows.
 $B259 JR NZ,$B248    ; Loop back until all eight rows have been drawn.
@label=PrintOutlawName_Next
*$B25B LD A,H         ; Fetch the high byte of the screen address.
 $B25C SUB $08        ; Move back up to the top of the character.
 $B25E LD H,A         ; Keep the high byte of the screen address.
 $B25F INC L          ; Move across to the next cell.
 $B260 INC IY         ; Move on to the next character.
 $B262 EX DE,HL       ; Swap the screen address into #REGde.
 $B263 BIT 7,(IY-$01) ; Test whether this was the last character.
 $B267 RET NZ         ; Return if it was.
 $B268 JR $B22B       ; Go back for the next character.
; There is an even number of characters, so copy each character to the
; screen.
@label=PrintOutlawName_Aligned
*$B26A LD B,$08       ; Set the number of rows to eight.
@label=PrintOutlawName_AlignedRow
*$B26C LD A,(DE)      ; Fetch a row of pixels.
 $B26D INC DE         ; Move on to the next row.
 $B26E OR (HL)        ; Combine it with the screen.
 $B26F LD (HL),A      ; Write it to the screen.
 $B270 INC H          ; Move down a pixel row.
 $B271 DJNZ $B26C     ; Loop back until all eight rows have been drawn.
 $B273 JR $B25B       ; Go back to finish the character.

; Count Down Delay
;
; Used by the routine at #R$B347.
; .
; Counts down byte #N$0D of an object by two. When it goes below zero it
; is set to a new value, and so a figure which calls this routine gets an event
; every few frames.
;
; A The new value
; IX The address of the object
@label=CountDownDelay
c$B275 DEC (IX+$0D)  ; Count down byte #N$0D.
 $B278 DEC (IX+$0D)  ; Count it down again.
 $B27B RET P         ; Return if it has not gone below zero.
 $B27C LD (IX+$0D),A ; Set it to the new value.
 $B27F RET           ; Return.

; Draw Wide Sprites
;
; Used by the routines at #R$B9FB, #R$BA47, #R$BADD and #R$BB0B.
; .
; Draws several wide sprites one after another.
;
; B The number of sprites
; DE The address of the list of sprite numbers
; HL The address in the buffer
;
; Draw each sprite in the list.
@label=DrawWideSprites
c$B280 LD A,(DE)     ; Fetch the number of the next sprite.
 $B281 INC DE        ; Move on to the next sprite in the list.
 $B282 PUSH BC       ; Stash the number of sprites on the stack.
 $B283 PUSH DE       ; Stash the address of the list on the stack.
 $B284 CALL $B28C    ; Draw the sprite.
 $B287 POP DE        ; Retrieve the address of the list.
 $B288 POP BC        ; Retrieve the number of sprites.
 $B289 DJNZ $B280    ; Loop back until all of the sprites have been drawn.
 $B28B RET           ; Return.

; Draw Wide Sprite
;
; Used by the routine at #R$B280.
; .
; Draws a sprite which is eight rows high and four bytes wide into a
; buffer which has twenty four bytes in each row. The pixels are combined with
; what is already in the buffer. The horizontal pixel position is in #R$A220: if
; it is not a multiple of eight, the sprite data is a list of indexes into the
; tables which shift a byte by two, four or six pixels, and the sprite takes
; five bytes in each row of the buffer. The routine takes the data from the
; stack to make it faster.
;
; A The number of the sprite
; HL The address in the buffer
;
; Find the data of the sprite.
@label=DrawWideSprite
c$B28C EX DE,HL      ; Swap the address in the buffer into #REGde.
 $B28D LD BC,$6AC6   ; Point #REGbc at #R$6AC6.
 $B290 CALL $C75C    ; Point #REGhl at the data of the sprite.
 $B293 LD ($A21D),SP ; Save the stack pointer.
 $B297 LD SP,HL      ; Point the stack pointer at the data.
 $B298 EX DE,HL      ; Swap the address in the buffer back into #REGhl.
 $B299 LD A,($A220)  ; Fetch the horizontal pixel position.
 $B29C AND %00000110 ; Keep the offset within the byte.
 $B29E JR Z,$B2D6    ; Jump to #R$B2D6 if the sprite is on a byte boundary.
; The sprite is not on a byte boundary, so shift it using the shift
; tables.
 $B2A0 OR %11111000  ; Make the offset the high byte of the address of a shift
                     ; table.
 $B2A2 LD D,A        ; Point #REGd at the shift table.
 $B2A3 LD A,$08      ; Set the number of rows to eight.
@label=DrawWideSprite_ShiftedRow
*$B2A5 EX AF,AF'     ; Keep the number of rows in the alternate accumulator.
 $B2A6 POP BC        ; Fetch the indexes for the first two bytes of a row.
 $B2A7 LD E,C        ; Copy the first index into #REGe.
 $B2A8 LD A,(DE)     ; Fetch the shifted first byte.
 $B2A9 OR (HL)       ; Combine it with the buffer.
 $B2AA LD (HL),A     ; Write it to the buffer.
 $B2AB INC HL        ; Move on to the second byte.
 $B2AC INC D         ; Point #REGd at the overflow table.
 $B2AD LD A,(DE)     ; Fetch the overflow of the first byte.
 $B2AE DEC D         ; Point #REGd back at the shift table.
 $B2AF LD E,B        ; Copy the second index into #REGe.
 $B2B0 EX DE,HL      ; Swap the buffer address into #REGde.
 $B2B1 OR (HL)       ; Combine the overflow with the shifted second byte.
 $B2B2 LD (DE),A     ; Write it to the buffer.
 $B2B3 INC DE        ; Move on to the third byte.
 $B2B4 INC H         ; Point #REGh at the overflow table.
 $B2B5 LD A,(HL)     ; Fetch the overflow of the second byte.
 $B2B6 DEC H         ; Point #REGh back at the shift table.
 $B2B7 POP BC        ; Fetch the indexes for the next two bytes of the row.
 $B2B8 LD L,C        ; Copy the third index into #REGl.
 $B2B9 OR (HL)       ; Combine the third byte with the buffer.
 $B2BA LD (DE),A     ; Write it to the buffer.
 $B2BB INC DE        ; Move on to the fourth byte.
 $B2BC INC H         ; Point #REGh at the overflow table.
 $B2BD LD A,(HL)     ; Fetch the overflow of the third byte.
 $B2BE DEC H         ; Point #REGh back at the shift table.
 $B2BF LD L,B        ; Copy the fourth index into #REGl.
 $B2C0 OR (HL)       ; Combine it with the shifted fourth byte.
 $B2C1 LD (DE),A     ; Write it to the buffer.
 $B2C2 INC DE        ; Move on to the fifth byte.
 $B2C3 INC H         ; Point #REGh at the overflow table.
 $B2C4 EX DE,HL      ; Swap the buffer address into #REGhl.
 $B2C5 LD A,(DE)     ; Fetch the overflow of the fourth byte.
 $B2C6 OR (HL)       ; Combine it with the buffer.
 $B2C7 LD (HL),A     ; Write it to the buffer.
 $B2C8 DEC D         ; Point #REGd back at the shift table.
 $B2C9 LD BC,$0014   ; Set the distance to the next row of the buffer.
 $B2CC ADD HL,BC     ; Move on to the next row.
 $B2CD EX AF,AF'     ; Fetch the number of rows.
 $B2CE DEC A         ; Count down the rows.
 $B2CF JR NZ,$B2A5   ; Loop back until all eight rows have been drawn.
@label=DrawWideSprite_Done
*$B2D1 LD SP,($A21D) ; Restore the stack pointer.
 $B2D5 RET           ; Return.
; The sprite is on a byte boundary, so copy the bytes straight to the
; buffer.
@label=DrawWideSprite_Aligned
*$B2D6 LD B,$08      ; Set the number of rows to eight.
@label=DrawWideSprite_AlignedRow
*$B2D8 POP DE        ; Fetch two bytes of the row.
 $B2D9 LD (HL),E     ; Write the first to the buffer.
 $B2DA INC HL        ; Move on to the second byte.
 $B2DB LD (HL),D     ; Write the second to the buffer.
 $B2DC INC HL        ; Move on to the third byte.
 $B2DD POP DE        ; Fetch two more bytes of the row.
 $B2DE LD (HL),E     ; Write the third to the buffer.
 $B2DF INC HL        ; Move on to the fourth byte.
 $B2E0 LD (HL),D     ; Write the fourth to the buffer.
 $B2E1 LD DE,$0015   ; Set the distance to the next row of the buffer.
 $B2E4 ADD HL,DE     ; Move on to the next row.
 $B2E5 DJNZ $B2D8    ; Loop back until all eight rows have been drawn.
 $B2E7 JR $B2D1      ; Jump to #R$B2D1.

; Finish Town Stage
;
; Used by the routine at #R$A36D.
; .
; Called every frame in the town. When the outlaw has been shot (#R$A20A
; is one) it plays a tune, clears all the objects and goes on to the duel with
; the outlaw. The player is given a life to make up for the one which is taken
; when the next stage starts.
@label=FinishTownStage
c$B2E9 LD HL,$A20A   ; Point #REGhl at the outlaw shot flag.
 $B2EC LD A,(HL)     ; Fetch the flag.
 $B2ED CP $01        ; {Return if the outlaw has not just been shot.
 $B2EF RET NZ        ; }
 $B2F0 INC (HL)      ; Set the flag to two so that this does not happen again.
; Play the tune for shooting the outlaw.
 $B2F1 LD DE,$B1B5   ; {Call #R$AF8F to play #R$B1B5.
 $B2F4 CALL $AF8F    ; }
 $B2F7 CALL $C7C8    ; Remove all of the objects.
 $B2FA XOR A         ; {Write #N$00 to #R$A267 so the next stage is outside the
 $B2FB LD ($A267),A  ; town.}
 $B2FE LD ($A212),A  ; Clear the flag at #R$A212.
 $B301 LD HL,$0201   ; {Set one stage to play, of the kind which is the duel.
 $B304 LD ($A264),HL ; }
 $B307 LD HL,$A263   ; Point #REGhl at #R$A263.
 $B30A INC (HL)      ; Add one to the number of lives, to make up for the one which the
                     ; next stage takes.
 $B30B LD A,$01      ; {Write #N$01 to #R$A240 to show that a new stage is
 $B30D LD ($A240),A  ; starting.}
 $B310 LD A,$45      ; {Write #COLOUR$45 to #R$A266.
 $B312 LD ($A266),A  ; }
 $B315 JP $A3B3      ; Start the next stage.

; Create Direction Pointer
;
; Used by the routine at #R$B3BD.
; .
; Called every frame in the town. Puts a pointing hand (an object of type
; #N$0B) in the sixth object slot, next to the sheriff, if the slot is free.
; #R$B347 makes it point towards the outlaw.
;
; .
;
; Use the sixth slot if it is free.
@label=CreateDirectionPointer
c$B318 LD DE,$A2CD     ; Point #REGde at the sixth object slot.
 $B31B LD A,(DE)       ; Fetch the type of the object in the slot.
 $B31C AND A           ; {Return if the slot is in use.
 $B31D RET NZ          ; }
; Copy the template and place the pointer near the sheriff.
 $B31E PUSH DE         ; {Copy #REGde to #REGiy (using the stack).
 $B31F POP IY          ; }
 $B321 LD HL,$B337     ; Point #REGhl at #R$B337.
 $B324 LD BC,$0010     ; Set the size of an object slot in #REGbc.
 $B327 LDIR            ; Copy the template into the slot.
 $B329 LD B,$01        ; Set the distance from the sheriff to one cell.
 $B32B CALL $B6CD      ; Place the pointer one cell away from the sheriff.
 $B32E RET NZ          ; Return if that cell is blocked.
 $B32F CALL $B6F8      ; Set the position of the pointer within its cell.
 $B332 LD (IY+$00),$0B ; Turn the slot into a pointer.
 $B336 RET             ; Return.

; Pointer Template
;
; The initial contents of a slot for a pointer. The final two bytes point
; to the sprite list.
@label=PointerTemplate
b$B337 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; {Type, position, speed, size and
 $B33F DEFB $10,$10,$00,$00,$00,$00         ; counters.}
 $B345 DEFW $B3AB                           ; The sprite list of a pointer.

; Handle Pointer
;
; Type #N$0B: a pointing hand which hovers next to the sheriff and points
; to the outlaw. It works out whether the outlaw is further away across or up
; the screen, and which way, and so chooses one of two sprites and whether to
; flip it. It goes away when the sheriff is more than two cells away from it.
;
; .
;
; Slow down the changes of sprite, and remove the pointer if it is too far
; from the sheriff.
@label=HandlePointer
c$B347 LD A,$04       ; Set the new value of the counter.
 $B349 CALL $B275     ; Count down the counter.
 $B34C LD C,$02       ; Set the distance to two cells.
 $B34E CALL $B810     ; Check how close the sheriff is.
 $B351 JP NC,$C7BB    ; Remove the pointer if the sheriff has moved away.
; Find how far away the outlaw is horizontally.
 $B354 LD IY,$A2BD    ; Point #REGiy at #R$A2BD.
 $B358 CALL $B3AF     ; Fetch the horizontal position of the outlaw.
 $B35B EX DE,HL       ; Swap it into #REGde.
 $B35C LD IY,$A27D    ; Point #REGiy at #R$A27D.
 $B360 CALL $B3AF     ; Fetch the horizontal position of the sheriff.
 $B363 LD A,($A268)   ; {Fetch the view number and keep it in #REGb.
 $B366 LD B,A         ; }
 $B367 LD C,$00       ; Set the direction flags to zero.
 $B369 AND A          ; {Subtract the horizontal position of the sheriff.
 $B36A SBC HL,DE      ; }
 $B36C JR NC,$B372    ; Jump to #R$B372 if the outlaw is not to the left.
 $B36E CALL $D01B     ; Make the distance positive.
 $B371 INC C          ; Set bit 0 of the direction flags.
; Find how far away the outlaw is vertically.
@label=HandlePointer_Vertical
*$B372 PUSH HL        ; Stash the horizontal distance on the stack.
 $B373 LD IY,$A2BD    ; Point #REGiy at #R$A2BD.
 $B377 CALL $B3B6     ; Fetch the vertical position of the outlaw.
 $B37A EX DE,HL       ; Swap it into #REGde.
 $B37B LD IY,$A27D    ; Point #REGiy at #R$A27D.
 $B37F CALL $B3B6     ; Fetch the vertical position of the sheriff.
 $B382 AND A          ; {Subtract the vertical position of the sheriff.
 $B383 SBC HL,DE      ; }
 $B385 JR NC,$B38C    ; Jump to #R$B38C if the outlaw is not above.
 $B387 CALL $D01B     ; Make the distance positive.
 $B38A INC C          ; {Add two to the direction flags.
 $B38B INC C          ; }
; Compare the two distances, and choose the sprite.
@label=HandlePointer_Compare
*$B38C POP DE         ; Retrieve the horizontal distance.
 $B38D AND A          ; {Subtract it from the vertical distance.
 $B38E SBC HL,DE      ; }
 $B390 JR C,$B3A4     ; Jump to #R$B3A4 if the outlaw is further away
                      ; horizontally.
 $B392 RES 6,(IX+$07) ; Do not flip the sprite.
 $B396 LD A,C         ; Fetch the direction flags.
 $B397 CPL            ; Invert them.
 $B398 RRCA           ; Move bit 1 into bit 0.
@label=HandlePointer_ChooseSprite
*$B399 AND %00000001  ; Keep bit 0.
 $B39B XOR B          ; Combine it with bit 0 of the view number.
 $B39C ADD A,$30      ; Add #N$30 to give the number of the sprite.
 $B39E LD ($B3AD),A   ; Store it in the sprite list.
 $B3A1 JP $B741       ; Check for bullets and the sheriff, and draw the
                      ; pointer.
; The outlaw is further away horizontally, so flip the sprite.
@label=HandlePointer_Flip
*$B3A4 SET 6,(IX+$07) ; Flip the sprite.
 $B3A8 LD A,C         ; Fetch the direction flags.
 $B3A9 JR $B399       ; Choose the sprite.

; Pointer Sprite List
;
; The sprite list of a pointer. The sprite number, which is #N$30 or
; #N$31, is set by #R$B347.
; #SPRITE$30(pointer-1*) #SPRITE$31(pointer-2*)
@label=PointerSpriteList
b$B3AB DEFB $F4,$04,$00,$80

; Get Horizontal Position
;
; Used by the routine at #R$B347.
; .
; Fetches the horizontal position of an object.
;
;   IY The address of the object
; O:HL The horizontal position
@label=GetHorizontalPosition
c$B3AF LD L,(IY+$01) ; Fetch the low byte.
 $B3B2 LD H,(IY+$02) ; Fetch the high byte.
 $B3B5 RET           ; Return.

; Get Vertical Position
;
; Used by the routine at #R$B347.
; .
; Fetches the vertical position of an object.
;
;   IY The address of the object
; O:HL The vertical position
@label=GetVerticalPosition
c$B3B6 LD L,(IY+$03) ; Fetch the low byte.
 $B3B9 LD H,(IY+$04) ; Fetch the high byte.
 $B3BC RET           ; Return.

; Create Town Objects
;
; Used by the routine at #R$A36D.
; .
; Called every frame. In the town stage it updates the prices and makes
; new objects if there are free slots: bystanders, the outlaw, the pointer,
; money bags, cacti, the horse and the tumbleweed.
;
; .
;
; Return unless this is the town stage.
@label=CreateTownObjects
c$B3BD LD A,($A267)  ; {Return if this is a stage outside the town, which is the duel or
 $B3C0 AND A         ; the bonus stage.
 $B3C1 RET Z         ; }
; Update the prices and make any missing town objects.
 $B3C2 CALL $A5D5    ; Update the prices.
 $B3C5 CALL $B691    ; Make a bystander if there is a free slot.
 $B3C8 CALL $B420    ; Make the outlaw if there is a free slot.
 $B3CB CALL $B318    ; Make the pointer if there is a free slot.
 $B3CE CALL $A47E    ; Make a money bag if there is a free slot.
 $B3D1 CALL $A9ED    ; Make a cactus if there is a free slot.
 $B3D4 CALL $A981    ; Make the horse if there is a free slot.
 $B3D7 JP $A89C      ; Jump to #R$A89C.

; Handle Outlaw
;
; Types #N$0A and #N$16: the outlaw who is wanted at this level. A bullet
; hit sets #R$A20A to one, which makes #R$B2E9 end the stage. Otherwise the
; outlaw wanders about the town: if he touches the sheriff, the sheriff dies.
; Type #N$16 is made by #R$B420 instead of type #N$0A when the outlaw is to be a
; little faster.
;
; .
;
; Check whether a bullet has hit the outlaw.
@label=HandleOutlaw
c$B3DA CALL $B614    ; Check whether a bullet has hit the outlaw.
 $B3DD JR NC,$B3E6   ; Jump to #R$B3E6 if not.
 $B3DF LD A,$01      ; {Set #R$A20A.
 $B3E1 LD ($A20A),A  ; }
 $B3E4 JR $B409      ; Jump to #R$B409 to draw the outlaw.
; Check whether the outlaw has touched the sheriff, and make him wander.
@label=HandleOutlaw_Walk
*$B3E6 CALL $B631    ; Check whether the outlaw is touching the sheriff.
 $B3E9 JP C,$B754    ; Kill the sheriff if he is.
 $B3EC LD A,(IX+$05) ; Fetch the speed of the outlaw.
 $B3EF CALL $CCC2    ; Set the speeds from it.
 $B3F2 LD A,(IX+$07) ; Fetch the flags of the outlaw.
 $B3F5 PUSH AF       ; Stash them on the stack.
 $B3F6 CALL $CD8C    ; Move around any walls.
 $B3F9 POP AF        ; Retrieve the flags.
 $B3FA CALL $AED3    ; Make a footstep sound if a foot has gone down.
 $B3FD CALL $CCE5    ; Move the outlaw.
 $B400 CALL $B82A    ; Choose a new direction every so often.
 $B403 CALL $CC13    ; Set the direction the outlaw faces.
 $B406 CALL $CCAE    ; Move on to the next frame of the walk.
; Make the sprites for the outlaw.
@label=HandleOutlaw_Draw
*$B409 CALL $CB29    ; Choose the sprites for the figure.
 $B40C EX AF,AF'     ; Keep the sprite number in the alternate accumulator.
 $B40D LD L,A        ; Keep the sprite number in #REGl.
 $B40E LD A,($A260)  ; Fetch the level.
 $B411 ADD A,A       ; Double it.
 $B412 AND %00000110 ; Keep two bits.
 $B414 JR NZ,$B418   ; Jump to #R$B418 unless the sprite set is the first.
 $B416 LD A,$02      ; Use the second sprite set.
@label=HandleOutlaw_AddSpriteSet
*$B418 ADD A,L       ; Add the sprite set to the sprite number.
 $B419 EX AF,AF'     ; Keep the number in the alternate accumulator.
 $B41A LD HL,$A232   ; Point #REGhl at #R$A232.
 $B41D JP $CB60      ; Jump to #R$CB60.

; Create Outlaw
;
; Used by the routine at #R$B3BD.
; .
; Called every frame in the town. Puts the outlaw (an object of type #N$0A
; or #N$16) in a random cell of the town in the fifth object slot if the slot is
; free and the cell is not blocked. The outlaw is made faster, and given type
; #N($16), if a random number is less than sixteen times the level (the level is
; reduced by four from level sixteen).
@label=CreateOutlaw
c$B420 LD DE,$A2BD     ; Point #REGde at #R$A2BD.
 $B423 LD A,(DE)       ; Fetch the type of the object in the slot.
 $B424 AND A           ; Test whether the slot is in use.
 $B425 RET NZ          ; Return if it is.
 $B426 PUSH DE         ; {Copy #REGde to #REGiy (using the stack).
 $B427 POP IY          ; }
 $B429 LD HL,$B484     ; Point #REGhl at #R$B484.
 $B42C LD BC,$0010     ; Set the size of an object slot in #REGbc.
 $B42F LDIR            ; Copy the template into the slot.
; Choose a random cell.
 $B431 LD A,($A218)    ; {Keep a random horizontal cell from #N$00 to #N$0F in
 $B434 AND %00001111   ; #REGl.
 $B436 LD L,A          ; }
 $B437 LD A,($A219)    ; {Keep a random vertical cell from #N$00 to #N$0F in
 $B43A AND %00001111   ; #REGh.
 $B43C LD H,A          ; }
 $B43D LD (IY+$02),L   ; Set the horizontal cell of the outlaw.
 $B440 LD (IY+$04),H   ; Set the vertical cell of the outlaw.
 $B443 CALL $C738      ; Check whether the cell is blocked.
 $B446 CP $01          ; {Return if the cell is blocked.
 $B448 RET Z           ; }
; Choose the outlaw.
 $B449 LD A,($A260)    ; Fetch the level.
 $B44C LD HL,$B494     ; Point #REGhl at #R$B494.
 $B44F CALL $D275      ; Point #REGhl at the number for the level.
 $B452 LD A,(HL)       ; Fetch the number of the outlaw.
 $B453 LD (IY+$0A),A   ; Set it in the object.
 $B456 LD (IY+$00),$0A ; Make the slot an outlaw.
; Choose how fast the outlaw moves.
 $B45A LD A,($A21A)    ; Fetch a random number.
 $B45D AND %00000110   ; Keep bits 1 and 2.
 $B45F ADD A,$02       ; Add two to give a speed of two, four, six or eight.
 $B461 LD (IY+$05),A   ; Set the speed of the outlaw.
 $B464 LD A,($A260)    ; Fetch the level.
 $B467 CP $10          ; {Jump to #R$B46D if the level is below #N$10.
 $B469 JR C,$B46D      ; }
 $B46B SUB $04         ; Take four off the level.
@label=CreateOutlaw_MultiplyLevel
*$B46D RLCA            ; {Multiply the level by sixteen.
 $B46E RLCA            ;
 $B46F RLCA            ;
 $B470 RLCA            ; }
 $B471 LD C,A          ; Keep the level times sixteen in #REGc.
 $B472 LD A,($A21B)    ; Fetch another random number.
 $B475 CP C            ; {Return if it is not smaller than the number worked out from the
 $B476 RET NC          ; level.}
 $B477 LD A,(IY+$05)   ; Fetch the speed of the outlaw.
 $B47A ADD A,$08       ; Add eight.
 $B47C LD (IY+$05),A   ; Set the speed of the outlaw.
 $B47F LD (IY+$00),$16 ; Make the slot a faster outlaw.
 $B483 RET             ; Return.

; Outlaw Template
;
; The initial contents of a slot for the outlaw. The final two bytes point
; to the sprite list, which is made by #R$B3DA.
@label=OutlawTemplate
b$B484 DEFB $00,$80,$00,$80,$00,$00,$00,$00 ; {Type, position, speed, size and
 $B48C DEFB $10,$10,$00,$00,$00,$00         ; counters.}
 $B492 DEFW $A232                           ; The sprite list of the outlaw.

; Outlaw Numbers
;
; The number of the outlaw wanted at each level.
@label=OutlawNumbers
b$B494 DEFB $00,$01,$02,$03,$04,$05,$06,$07,$08,$09,$0A,$0B,$0C,$0D,$0E,$0F,$10,$11,$12,$13 ; #FOR($00,$13)||n|#R$B4A8(#N(#PEEK(#PC+n)))|,
                                                                                            ; ||

; Messaging: Outlaw Names
;
; The names of the outlaws. Each outlaw has two parts, which are printed
; on two lines of the wanted poster by #R$B1F4. The last character of each part
; has bit 7 set. A part of just a space is blank.
@label=OutlawNames
t$B4A8 DEFM "BUFFAL","O"+$80  ; "#STR(#PC)".
 $B4AF DEFM "BIL","L"+$80     ; "#STR(#PC)".
 $B4B3 DEFM "BILL","Y"+$80    ; "#STR(#PC)".
 $B4B8 DEFM "THE KI","D"+$80  ; "#STR(#PC)".
 $B4BF DEFM "SUNDANC","E"+$80 ; "#STR(#PC)".
 $B4C7 DEFM "KI","D"+$80      ; "#STR(#PC)".
 $B4CA DEFM "JESS","E"+$80    ; "#STR(#PC)".
 $B4CF DEFM "JAME","S"+$80    ; "#STR(#PC)".
 $B4D4 DEFM "BUTC","H"+$80    ; "#STR(#PC)".
 $B4D9 DEFM "CASSID","Y"+$80  ; "#STR(#PC)".
 $B4E0 DEFM "M","A"+$80       ; "#STR(#PC)".
 $B4E2 DEFM "BAKE","R"+$80    ; "#STR(#PC)".
 $B4E7 DEFM "WIL","D"+$80     ; "#STR(#PC)".
 $B4EB DEFM "BIL","L"+$80     ; "#STR(#PC)".
 $B4EF DEFM "RUMP","O"+$80    ; "#STR(#PC)".
 $B4F4 DEFM "KI","D"+$80      ; "#STR(#PC)".
 $B4F7 DEFM "CLEVE","R"+$80   ; "#STR(#PC)".
 $B4FD DEFM "JAK","E"+$80     ; "#STR(#PC)".
 $B501 DEFM "MILKI","E"+$80   ; "#STR(#PC)".
 $B507 DEFM "BAR KI","D"+$80  ; "#STR(#PC)".
 $B50E DEFM "KLONDIK","E"+$80 ; "#STR(#PC)".
 $B516 DEFM "PET","E"+$80     ; "#STR(#PC)".
 $B51A DEFM "BRONC","O"+$80   ; "#STR(#PC)".
 $B520 DEFM "COLARAD","O"+$80 ; "#STR(#PC)".
 $B528 DEFM "WAYK","O"+$80    ; "#STR(#PC)".
 $B52D DEFM "KI","D"+$80      ; "#STR(#PC)".
 $B530 DEFM "LON","E"+$80     ; "#STR(#PC)".
 $B534 DEFM "RANGE","R"+$80   ; "#STR(#PC)".
 $B53A DEFM "TONT","O"+$80    ; "#STR(#PC)".
 $B53F DEFM " "+$80,          ; "#STR(#PC)".
 $B540 DEFM "Q","D"+$80       ; "#STR(#PC)".
 $B542 DEFM "MCGRA","W"+$80   ; "#STR(#PC)".
 $B548 DEFM "MEXICAN","S"+$80 ; "#STR(#PC)".
 $B550 DEFM " "+$80,          ; "#STR(#PC)".
 $B551 DEFM "GU","N"+$80      ; "#STR(#PC)".
 $B554 DEFM "SLINGER","S"+$80 ; "#STR(#PC)".
 $B55C DEFM "BANDIT","S"+$80  ; "#STR(#PC)".
 $B563 DEFM " "+$80,          ; "#STR(#PC)".
 $B564 DEFM "HIL","L"+$80     ; "#STR(#PC)".
 $B568 DEFM "BILLY","S"+$80   ; "#STR(#PC)".

; Outlaw Rewards
;
; The reward for each outlaw, as three packed decimal bytes in dollars,
; most significant first.
@label=OutlawRewards
g$B56E DEFB $00,$03,$50
 $B571 DEFB $00,$07,$00
 $B574 DEFB $00,$15,$00
 $B577 DEFB $00,$20,$00
 $B57A DEFB $00,$25,$00
 $B57D DEFB $00,$30,$00
 $B580 DEFB $00,$36,$00
 $B583 DEFB $00,$40,$00
 $B586 DEFB $00,$56,$00
 $B589 DEFB $00,$61,$00
 $B58C DEFB $00,$70,$00
 $B58F DEFB $00,$75,$00
 $B592 DEFB $00,$80,$00
 $B595 DEFB $00,$85,$00
 $B598 DEFB $00,$95,$00
 $B59B DEFB $01,$00,$00
 $B59E DEFB $02,$50,$00
 $B5A1 DEFB $02,$70,$00
 $B5A4 DEFB $03,$10,$00
 $B5A7 DEFB $03,$40,$00

; Body Image Numbers
;
; The numbers of the images of the body of the outlaw in the duel, for his
; two steps, as two lists of three. The numbers are for the table of images at
; #R$6AC6 and the list for the step is chosen by #R$BC6C.
;
; .
;
; The first step.
@label=BodyImageNumbers
b$B5AA DEFB $1A,$1B,$1C ; #LET(b1=#PEEK($6AC6+#PEEK(#PC)*$02)+#PEEK($6AC7+#PEEK(#PC)*$02)*$100)#LET(b2=#PEEK($6AC6+#PEEK(#PC+$01)*$02)+#PEEK($6AC7+#PEEK(#PC+$01)*$02)*$100)#LET(b3=#PEEK($6AC6+#PEEK(#PC+$02)*$02)+#PEEK($6AC7+#PEEK(#PC+$02)*$02)*$100)#UDGARRAY(4,attr=$07,scale=3,step=4,flip=2)(({b1})-({b1}+$03)-$01;({b2})-({b2}+$03)-$01;({b3})-({b3}+$03)-$01)(body-#EVAL((#PC-$B5AA)/$03,16,2)*)
; The first step.
@label=BodyImageNumbers_SecondStep
 $B5AD DEFB $1D,$1E,$1F ; #LET(b1=#PEEK($6AC6+#PEEK(#PC)*$02)+#PEEK($6AC7+#PEEK(#PC)*$02)*$100)#LET(b2=#PEEK($6AC6+#PEEK(#PC+$01)*$02)+#PEEK($6AC7+#PEEK(#PC+$01)*$02)*$100)#LET(b3=#PEEK($6AC6+#PEEK(#PC+$02)*$02)+#PEEK($6AC7+#PEEK(#PC+$02)*$02)*$100)#UDGARRAY(4,attr=$07,scale=3,step=4,flip=2)(({b1})-({b1}+$03)-$01;({b2})-({b2}+$03)-$01;({b3})-({b3}+$03)-$01)(body-#EVAL((#PC-$B5AA)/$03,16,2)*)

; Face Image Numbers
;
; Five bytes for each outlaw, which are the numbers of the five images of
; his head and face in the duel, in the table of images at #R$6AC6. The wanted
; poster uses the last four of the five bytes as the numbers of its four images
; of the face.
@label=FaceImageNumbers
b$B5B0 DEFB $0E,$12,$02,$18,$14 ; #FACE(#EVAL((#PC-$B5B0)/$05))(face-#EVAL((#PC-$B5B0)/$05,16,2)*)
 $B5B5 DEFB $0E,$0D,$19,$10,$0A ; #FACE(#EVAL((#PC-$B5B0)/$05))(face-#EVAL((#PC-$B5B0)/$05,16,2)*)
 $B5BA DEFB $09,$08,$11,$01,$0F ; #FACE(#EVAL((#PC-$B5B0)/$05))(face-#EVAL((#PC-$B5B0)/$05,16,2)*)
 $B5BF DEFB $04,$0D,$0C,$06,$00 ; #FACE(#EVAL((#PC-$B5B0)/$05))(face-#EVAL((#PC-$B5B0)/$05,16,2)*)
 $B5C4 DEFB $13,$12,$07,$01,$00 ; #FACE(#EVAL((#PC-$B5B0)/$05))(face-#EVAL((#PC-$B5B0)/$05,16,2)*)
 $B5C9 DEFB $09,$12,$16,$0B,$0A ; #FACE(#EVAL((#PC-$B5B0)/$05))(face-#EVAL((#PC-$B5B0)/$05,16,2)*)
 $B5CE DEFB $04,$03,$07,$01,$00 ; #FACE(#EVAL((#PC-$B5B0)/$05))(face-#EVAL((#PC-$B5B0)/$05,16,2)*)
 $B5D3 DEFB $13,$08,$11,$10,$0A ; #FACE(#EVAL((#PC-$B5B0)/$05))(face-#EVAL((#PC-$B5B0)/$05,16,2)*)
 $B5D8 DEFB $09,$0D,$0C,$06,$01 ; #FACE(#EVAL((#PC-$B5B0)/$05))(face-#EVAL((#PC-$B5B0)/$05,16,2)*)
 $B5DD DEFB $13,$0D,$19,$0B,$0A ; #FACE(#EVAL((#PC-$B5B0)/$05))(face-#EVAL((#PC-$B5B0)/$05,16,2)*)
 $B5E2 DEFB $13,$08,$11,$01,$05 ; #FACE(#EVAL((#PC-$B5B0)/$05))(face-#EVAL((#PC-$B5B0)/$05,16,2)*)
 $B5E7 DEFB $09,$12,$16,$01,$05 ; #FACE(#EVAL((#PC-$B5B0)/$05))(face-#EVAL((#PC-$B5B0)/$05,16,2)*)
 $B5EC DEFB $13,$03,$07,$0B,$0A ; #FACE(#EVAL((#PC-$B5B0)/$05))(face-#EVAL((#PC-$B5B0)/$05,16,2)*)
 $B5F1 DEFB $09,$08,$11,$06,$0F ; #FACE(#EVAL((#PC-$B5B0)/$05))(face-#EVAL((#PC-$B5B0)/$05,16,2)*)
 $B5F6 DEFB $0E,$12,$11,$15,$17 ; #FACE(#EVAL((#PC-$B5B0)/$05))(face-#EVAL((#PC-$B5B0)/$05,16,2)*)
 $B5FB DEFB $04,$08,$02,$06,$05 ; #FACE(#EVAL((#PC-$B5B0)/$05))(face-#EVAL((#PC-$B5B0)/$05,16,2)*)
 $B600 DEFB $04,$03,$02,$01,$00 ; #FACE(#EVAL((#PC-$B5B0)/$05))(face-#EVAL((#PC-$B5B0)/$05,16,2)*)
 $B605 DEFB $0E,$03,$07,$0B,$0A ; #FACE(#EVAL((#PC-$B5B0)/$05))(face-#EVAL((#PC-$B5B0)/$05,16,2)*)
 $B60A DEFB $09,$03,$02,$10,$0F ; #FACE(#EVAL((#PC-$B5B0)/$05))(face-#EVAL((#PC-$B5B0)/$05,16,2)*)
 $B60F DEFB $09,$08,$16,$06,$00 ; #FACE(#EVAL((#PC-$B5B0)/$05))(face-#EVAL((#PC-$B5B0)/$05,16,2)*)

; Check Bullet Hit
;
; Used by the routines at #R$AA7F, #R$B3DA and #R$B719.
; .
; Checks whether any of the bullets (objects of type #N($02), in the
; second, third and fourth slots) is touching the object being handled.
;
;   IX The address of the object
; O:F The carry flag is set if a bullet is touching the object
; O:IY The address of the bullet, if there is one
@label=CheckBulletHit
c$B614 LD IY,$A28D   ; Point #REGiy at the second object slot.
 $B618 LD DE,$0010   ; Set the size of an object slot.
 $B61B LD B,$03      ; Set the number of bullet slots to three.
; Check whether this slot holds a bullet.
@label=CheckBulletHit_Loop
*$B61D LD A,(IY+$00) ; Fetch the type of the object.
 $B620 CP $02        ; {Jump to #R$B62C if it is not a bullet.
 $B622 JR NZ,$B62C   ; }
 $B624 PUSH BC       ; Stash the number of slots on the stack.
 $B625 PUSH DE       ; Stash the size of a slot on the stack.
 $B626 CALL $B647    ; Check whether the bullet is touching the object.
 $B629 POP DE        ; Retrieve the size of a slot.
 $B62A POP BC        ; Retrieve the number of slots.
 $B62B RET C         ; Return if the bullet is touching it.
; Check the next slot.
@label=CheckBulletHit_Next
*$B62C ADD IY,DE     ; Move on to the next slot.
 $B62E DJNZ $B61D    ; Loop back until all three slots have been checked.
 $B630 RET           ; Return.

; Check Sheriff Touch
;
; Used by the routines at #R$A4C9, #R$A8D5, #R$A9BF, #R$AA7F, #R$B3DA and
; #R$B719.
; .
; Checks whether the sheriff, on foot or on his horse, is touching the
; object being handled. It does nothing while #R$A208 is not zero.
;
;   IX The address of the object
; O:F The carry flag is set if the sheriff is touching the object
; O:IY The address of the sheriff
@label=CheckSheriffTouch
c$B631 LD A,($A208)  ; Fetch the counter.
 $B634 AND A         ; {Return, with carry clear, while the sheriff is
 $B635 RET NZ        ; protected.}
 $B636 LD IY,$A27D   ; Point #REGiy at #R$A27D.
 $B63A LD A,(IY+$00) ; Fetch the type of the object.
 $B63D CP $01        ; {Jump to #R$B647 if it is a sheriff on foot or a mounted
 $B63F JR Z,$B647    ; sheriff.
 $B641 CP $15        ;
 $B643 JR Z,$B647    ; }
 $B645 AND A         ; Clear the carry flag.
 $B646 RET           ; Return.

; Check Overlap
;
; Used by the routines at #R$B614 and #R$B631.
; .
; Checks whether two objects overlap. They overlap when the distance
; between their centres, both across and up the screen, is less than three
; quarters of the sum of their sizes.
;
;   IX The address of the first object
;   IY The address of the second object
; O:F The carry flag is set if the objects overlap
;
; Check the horizontal distance.
@label=CheckOverlap
c$B647 LD A,(IY+$08)  ; Fetch the horizontal size of the second object.
 $B64A ADD A,(IX+$08) ; Add the horizontal size of the first object.
 $B64D SRL A          ; Halve the sum.
 $B64F LD C,A         ; Keep half of the summed widths in #REGc.
 $B650 SRL A          ; Halve it again.
 $B652 ADD A,C        ; Add the first half to make three quarters of the sum.
 $B653 LD C,A         ; {Keep three quarters of the summed widths in #REGbc.
 $B654 LD B,$00       ; }
 $B656 LD L,(IX+$01)  ; {Fetch the horizontal position of the first object into
 $B659 LD H,(IX+$02)  ; #REGhl.}
 $B65C LD E,(IY+$01)  ; {Fetch the horizontal position of the second object
 $B65F LD D,(IY+$02)  ; into #REGde.}
 $B662 AND A          ; {Subtract one from the other.
 $B663 SBC HL,DE      ; }
 $B665 CALL C,$D01B   ; Make the distance positive.
 $B668 AND A          ; {Subtract the limit.
 $B669 SBC HL,BC      ; }
 $B66B RET NC         ; Return if the objects are too far apart horizontally.
; Check the vertical distance.
 $B66C LD A,(IY+$09)  ; Fetch the vertical size of the second object.
 $B66F ADD A,(IX+$09) ; Add the vertical size of the first object.
 $B672 SRL A          ; Halve the sum.
 $B674 LD C,A         ; Keep half of the summed heights in #REGc.
 $B675 SRL A          ; Halve it again.
 $B677 ADD A,C        ; Add the first half to make three quarters of the sum.
 $B678 LD C,A         ; {Keep three quarters of the summed heights in #REGbc.
 $B679 LD B,$00       ; }
 $B67B LD L,(IX+$03)  ; {Fetch the vertical position of the first object into
 $B67E LD H,(IX+$04)  ; #REGhl.}
 $B681 LD E,(IY+$03)  ; {Fetch the vertical position of the second object into
 $B684 LD D,(IY+$04)  ; #REGde.}
 $B687 AND A          ; {Subtract one from the other.
 $B688 SBC HL,DE      ; }
 $B68A CALL C,$D01B   ; Make the distance positive.
 $B68D AND A          ; {Subtract the limit.
 $B68E SBC HL,BC      ; }
 $B690 RET            ; Return.

; Create Bystander
;
; Used by the routine at #R$B3BD.
; .
; Called every frame in the town. Looks for a free slot among the tenth to
; thirteenth object slots, and if there is one puts a bystander (an object of
; type #N$06) in it, one cell away from the sheriff.
@label=CreateBystander
c$B691 LD IY,$A30D     ; Point #REGiy at the tenth object slot.
 $B695 LD DE,$0010     ; Set the size of an object slot.
 $B698 LD B,$04        ; Set the number of slots to four.
@label=CreateBystander_Loop
*$B69A LD A,(IY+$00)   ; Fetch the type of the object in the slot.
 $B69D AND A           ; {Jump to #R$B6A5 if the slot is free.
 $B69E JR Z,$B6A5      ; }
 $B6A0 ADD IY,DE       ; Move on to the next slot.
 $B6A2 DJNZ $B69A      ; Loop back until all four slots have been checked.
 $B6A4 RET             ; Return.
; Place a bystander in the free slot.
@label=CreateBystander_Found
*$B6A5 LD B,$01        ; Set the distance from the sheriff to one cell.
 $B6A7 CALL $B6CD      ; Place the bystander one cell away from the sheriff.
 $B6AA RET NZ          ; Return if that cell is blocked.
 $B6AB CALL $B6F8      ; Set the position of the bystander within its cell.
 $B6AE LD A,($A21A)    ; Fetch a random number.
 $B6B1 AND %00000110   ; Keep bits 1 and 2.
 $B6B3 ADD A,$04       ; Add four to give a speed of four, six, eight or ten.
 $B6B5 LD (IY+$05),A   ; Set the speed of the bystander.
 $B6B8 LD (IY+$00),$06 ; Turn the slot into a bystander.
 $B6BC LD (IY+$06),$01 ; Set the direction of the bystander.
 $B6C0 LD (IY+$08),$10 ; Set the horizontal size of the bystander.
 $B6C4 LD (IY+$09),$10 ; Set the vertical size of the bystander.
 $B6C8 LD (IY+$0D),$00 ; Clear the counter used for slowing down changes of
                       ; sprite.
 $B6CC RET             ; Return.

; Place Near Sheriff
;
; Used by the routines at #R$A47E, #R$A89C, #R$A981, #R$B318 and #R$B691.
; .
; Puts an object in a cell which is a number of cells away from the
; sheriff, both across and up the screen. Which of the four diagonal directions
; is used depends on the bottom two bits of the frame counter.
;
;   B The distance in cells
;   IY The address of the object
; O:F The zero flag is set if the cell is free
;
; Fetch the sheriff's cell and the frame counter.
@label=PlaceNearSheriff
c$B6CD LD A,($A27F)  ; {Fetch the horizontal cell of the sheriff and keep it in
 $B6D0 LD L,A        ; #REGl.}
 $B6D1 LD A,($A281)  ; {Fetch the vertical cell of the sheriff and keep it in
 $B6D4 LD H,A        ; #REGh.}
 $B6D5 LD A,($A216)  ; {Fetch the frame counter and keep it in #REGc.
 $B6D8 LD C,A        ; }
; Choose a diagonal from the bottom two bits of the frame.
 $B6D9 LD A,B        ; Fetch the distance.
 $B6DA BIT 0,C       ; {Jump to #R$B6E0 if bit 0 of the frame counter is clear.
 $B6DC JR Z,$B6E0    ; }
 $B6DE NEG           ; Go in the other direction horizontally.
@label=PlaceNearSheriff_AddHorizontal
*$B6E0 ADD A,L       ; Add the horizontal cell of the sheriff.
 $B6E1 AND %00001111 ; Wrap round the town.
 $B6E3 LD L,A        ; Keep the wrapped horizontal cell in #REGl.
 $B6E4 LD A,B        ; Fetch the distance again.
 $B6E5 BIT 1,C       ; {Jump to #R$B6EB if bit 1 of the frame counter is clear.
 $B6E7 JR Z,$B6EB    ; }
 $B6E9 NEG           ; Go in the other direction vertically.
@label=PlaceNearSheriff_AddVertical
*$B6EB ADD A,H       ; Add the vertical cell of the sheriff.
 $B6EC AND %00001111 ; Wrap round the town.
 $B6EE LD H,A        ; Keep the wrapped vertical cell in #REGh.
; Store the cell and test whether it is free.
 $B6EF LD (IY+$02),L ; Set the horizontal cell of the object.
 $B6F2 LD (IY+$04),H ; Set the vertical cell of the object.
 $B6F5 JP $C738      ; Jump to #R$C738.

; Set Position In Cell
;
; Used by the routines at #R$A89C, #R$B318 and #R$B691.
; .
; Sets where an object stands within its cell, from the position of the
; sheriff within his cell. The routine uses #REGc as left by #R$C738, and
; #R$B6CD must have been called first.
;
; IY The address of the object
;
; Set the horizontal position within the cell.
@label=SetPositionInCell
c$B6F8 LD A,($A27E)  ; Fetch the horizontal position of the sheriff within his
                     ; cell.
 $B6FB AND %11000000 ; Keep the top two bits.
 $B6FD OR %01000000  ; Set bit 6.
 $B6FF BIT 0,C       ; {Jump to #R$B705 if bit 0 of #REGc is clear.
 $B701 JR Z,$B705    ; }
 $B703 NEG           ; Negate the position.
@label=SetPositionInCell_Horizontal
*$B705 LD (IY+$01),A ; Set the horizontal position of the object within its
                     ; cell.
; Set the vertical position within the cell.
 $B708 LD A,($A280)  ; Fetch the vertical position of the sheriff within his
                     ; cell.
 $B70B AND %11000000 ; Keep the top two bits.
 $B70D OR %01000000  ; Set bit 6.
 $B70F BIT 1,C       ; {Jump to #R$B715 if bit 1 of #REGc is clear.
 $B711 JR Z,$B715    ; }
 $B713 NEG           ; Negate the position.
@label=SetPositionInCell_Vertical
*$B715 LD (IY+$03),A ; Set the vertical position of the object within its cell.
 $B718 RET           ; Return.

; Handle Bystander
;
; Type #N$06: a bystander who wanders about the town. He goes away when
; the sheriff is more than two cells away. If he is shot, the bullet turns into
; a puff of smoke, the fine is taken from the bounty and the bystander dies. If
; the sheriff on foot touches him, the sheriff dies; if the mounted sheriff
; does, the bystander dies.
@label=HandleBystander
c$B719 LD A,(IX+$05) ; Fetch the speed of the bystander.
 $B71C CALL $CCC2    ; Set the speeds from it.
 $B71F LD A,(IX+$07) ; Fetch the flags of the bystander.
 $B722 PUSH AF       ; Stash them on the stack.
 $B723 CALL $CD8C    ; Move around any walls.
 $B726 POP AF        ; Retrieve the flags.
 $B727 CALL $AED3    ; Make a footstep sound if a foot has gone down.
 $B72A CALL $CCE5    ; Move the bystander.
 $B72D CALL $B82A    ; Choose a new direction every so often.
 $B730 CALL $B7F0    ; Set the frame and the direction the bystander faces.
 $B733 LD C,$02      ; Set the distance to two cells.
 $B735 CALL $B810    ; Check how close the sheriff is.
 $B738 JP NC,$C7BB   ; Remove the bystander if the sheriff has moved away.
 $B73B LD BC,$B798   ; Point #REGbc at #R$B798.
 $B73E CALL $C79E    ; Choose the sprite list.
; This entry point is used by the routine at #R$B347.
; .
; Check whether a bullet or the sheriff has hit the bystander.
@label=HandleBystander_CheckHit
*$B741 CALL $B614    ; Check whether a bullet has hit the bystander.
 $B744 JR C,$B770    ; Jump to #R$B770 if it has.
 $B746 CALL $B631    ; Check whether the sheriff is touching the bystander.
 $B749 RET NC        ; Return if not.
 $B74A LD A,(IY+$00) ; Fetch the type of the sheriff.
 $B74D CP $15        ; {Jump to #R$B778 if he is mounted.
 $B74F JR Z,$B778    ; }
 $B751 CALL $B778    ; Take the fine from the bounty.
; Continue on to #R$B754.

; Kill Sheriff
;
; Used by the routines at #R$A8D5, #R$AA7F and #R$B3DA.
; .
; Makes the sheriff die, and removes the bullets. It is used when the
; sheriff touches something dangerous.
;
; IX The address of the object which killed the sheriff
; IY The address of the sheriff
;
; Make the sheriff die.
@label=KillSheriff
c$B754 PUSH IX       ; Stash the address of the object on the stack.
 $B756 PUSH IY       ; {Copy the address of the sheriff into #REGix (using the
 $B758 POP IX        ; stack).}
 $B75A CALL $B782    ; Make the sheriff die.
 $B75D LD A,(IX+$0C) ; Fetch the counter of the sheriff.
 $B760 SUB $04       ; Take four off it.
 $B762 LD (IX+$0C),A ; Store the reduced delay counter.
 $B765 POP IX        ; Retrieve the address of the object from the stack.
; Clear the three bullet slots.
 $B767 LD HL,$A28D   ; Point #REGhl at #R$A28D.
 $B76A LD BC,$0030   ; Set the size of the three bullet slots.
 $B76D JP $D6E1      ; Jump to #R$D6E1.

; Shoot Bystander
;
; Used by the routine at #R$B719.
; .
; Turns the bullet which has hit the object into a puff of smoke, and then
; goes on to take the fine for shooting a bystander.
;
; IY The address of the bullet
@label=ShootBystander
c$B770 LD (IY+$00),$07 ; Turn the bullet into a puff of smoke.
 $B774 LD (IY+$0C),$02 ; Set the length of the puff to two frames.
; Continue on to #R$B778.

; Take Fine
;
; Used by the routine at #R$B719.
; .
; Takes the fine from the bounty, prints the new bounty and then makes the
; object die.
;
; IX The address of the object
@label=TakeFine
c$B778 LD BC,($A25A) ; Fetch the fine.
 $B77C CALL $D347    ; Take it from the bounty.
 $B77F CALL $D390    ; Print the new bounty.
; Continue on to #R$B782.

; Start Dying
;
; Used by the routine at #R$B754.
; .
; Turns an object into a dying object (type #N$09), which falls and
; bounces, and then lies on the ground as a dead figure.
;
; IX The address of the object
@label=StartDying
c$B782 LD (IX+$00),$09 ; Turn the object into a dying object.
 $B786 LD (IX+$0C),$FA ; Set the counter.
 $B78A LD (IX+$0D),$18 ; Set the speed of the fall.
 $B78E LD HL,$B7A4     ; Point #REGhl at #R$B7A4.
 $B791 LD (IX+$0E),L   ; Store the low byte of the address.
 $B794 LD (IX+$0F),H   ; Store the high byte of the address.
 $B797 RET             ; Return.

; Bystander Sprite Lists
;
; The table of sprite lists for the two frames of a bystander, and the
; lists. The last list is for a dead figure.
@label=BystanderSpriteLists
b$B798 DEFW $B79C           ; {The addresses of #R$B79C and #R$B7A0.
 $B79A DEFW $B7A0           ; }
@label=BystanderSpriteLists_FirstFrame
 $B79C DEFB $F4,$04,$2D,$80 ; The first frame: #SPRITE$2D(bystander-1*).
@label=BystanderSpriteLists_SecondFrame
 $B7A0 DEFB $F4,$04,$2E,$80 ; The second frame: #SPRITE$2E(bystander-2*).
@label=BystanderSpriteLists_DeadFigure
 $B7A4 DEFB $F4,$00,$10,$80 ; A dead figure: sprite #N$10.
                            ; #SPRITE$10(head-3*).

; Show Game Over
;
; Used by the routine at #R$C049.
; .
; Shows the game over screen for the player whose game has ended, which
; has "GAME OVER" and the number of the player in large letters. It plays the
; game over tune.
; #PUSHS #UDGTABLE { #POKES$A23F,$00
; #SIM(start=$B7A8,stop=$B7CA,clear=1,sp=$5E00)
; #SCR$02(game-over) } UDGTABLE# #POPS
;
; .
;
; Show the game over screen.
@label=ShowGameOver
c$B7A8 LD E,$00      ; Set the attribute to #COLOUR$00.
 $B7AA CALL $D6D3    ; Set all the attributes.
 $B7AD CALL $D6DB    ; Clear the screen.
 $B7B0 LD A,($A23F)  ; Fetch the number of the current player, which is zero or
                     ; one.
 $B7B3 ADD A,$31     ; Make it the character "1" or "2".
 $B7B5 LD ($B7EE),A  ; Put it in the text.
; Print "GAME OVER".
 $B7B8 LD HL,$4826   ; Point #REGhl at #N$4826 (in the screen buffer).
 $B7BB LD DE,$B7DA   ; Point #REGde at #R$B7DA.
 $B7BE CALL $AA9A    ; Print it in large letters.
; Print the number of the player.
 $B7C1 LD HL,$48A8   ; Point #REGhl at #N$48A8 (in the screen buffer).
 $B7C4 LD DE,$B7E6   ; Point #REGde at #R$B7E6.
 $B7C7 CALL $AA9A    ; Print it in large letters.
; Play the tune.
 $B7CA LD HL,$0000   ; Set the length of the wait.
 $B7CD CALL $AE88    ; Wait for a while.
 $B7D0 XOR A         ; {Write #N$00 to #R$A242 to allow the tune to play.
 $B7D1 LD ($A242),A  ; }
 $B7D4 LD DE,$B1CF   ; Point #REGde at #R$B1CF.
 $B7D7 JP $AF76      ; Jump to #R$AF76.

; Messaging: Game Over Text
;
; The two messages of the game over screen. Each is an attribute byte, the
; characters and a zero terminator.
@label=GameOverTexts
t$B7DA DEFB $45          ; Attribute: #COLOUR(#PEEK(#PC)).
 $B7DB DEFM "GAME  OVER" ; "GAME  OVER".
 $B7E5 DEFB $00          ; Terminator.
@label=GameOverTexts_Player
 $B7E6 DEFB $45          ; Attribute: #COLOUR(#PEEK(#PC)).
 $B7E7 DEFM "PLAYER "    ; "PLAYER ".
 $B7EE DEFB $3F          ; The number of the player, written by #R$B7A8.
 $B7EF DEFB $00          ; Terminator.

; Set Frame And Flip
;
; Used by the routine at #R$B719.
; .
; Chooses the frame of a walking figure and whether its sprite is flipped,
; from the direction in which it is walking and the view. Bits 6 and 7 of byte
; #N$06 of the object hold the direction.
;
; IX The address of the object
;
; Choose the frame from the direction and the view.
@label=SetFrameAndFlip
c$B7F0 LD A,($A268)  ; {Fetch the view number and keep it in #REGb.
 $B7F3 LD B,A        ; }
 $B7F4 LD A,(IX+$06) ; Fetch the direction.
 $B7F7 SUB $40       ; Take one off the direction.
 $B7F9 RLCA          ; Move bit 7 into bit 0.
 $B7FA AND %00000001 ; Keep bit 0.
 $B7FC XOR B         ; Combine it with the view.
 $B7FD LD (IX+$0C),A ; Set the frame.
; Set the flip bit from the direction.
 $B800 LD A,(IX+$06) ; Fetch the direction.
 $B803 AND %01000000 ; Keep bit 6.
 $B805 LD C,A        ; Keep the flip bit in #REGc.
 $B806 LD A,(IX+$07) ; Fetch the flags.
 $B809 AND %10111111 ; Clear bit 6.
 $B80B OR C          ; Set bit 6 if the direction says so.
 $B80C LD (IX+$07),A ; Store the flags.
 $B80F RET           ; Return.

; Check Distance
;
; Used by the routines at #R$A4C9, #R$A8D5, #R$A9BF, #R$AA7F, #R$B347 and
; #R$B719.
; .
; Checks whether an object is within a number of cells of the sheriff,
; both across and up the screen.
;
;   C The distance in cells
;   IX The address of the object
; O:F The carry flag is set if the object is closer than that
;
; Compare the horizontal cells.
@label=CheckDistance
c$B810 LD A,($A27F)  ; Fetch the horizontal cell of the sheriff from
                     ; #R$A27D(#N$A27F).
 $B813 SUB (IX+$02)  ; Subtract the horizontal cell of the object.
 $B816 JP P,$B81B    ; Jump to #R$B81B if the difference is not negative.
 $B819 NEG           ; Make the difference positive.
@label=CheckDistance_CompareHorizontal
*$B81B CP C          ; Compare it with the distance.
 $B81C RET NC        ; Return if the object is too far away.
; Compare the vertical cells.
 $B81D LD A,($A281)  ; Fetch the vertical cell of the sheriff from
                     ; #R$A27D(#N$A281).
 $B820 SUB (IX+$04)  ; Subtract the vertical cell of the object.
 $B823 JP P,$B828    ; Jump to #R$B828 if the difference is not negative.
 $B826 NEG           ; Make the difference positive.
@label=CheckDistance_CompareVertical
*$B828 CP C          ; Compare it with the distance.
 $B829 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$C069 }
; LIST#

; Update Direction
;
; Used by the routines at #R$B3DA and #R$B719.
; .
; Makes a figure choose a new direction every so often. The bottom six
; bits of byte #N$06 count down the frames until the next change, and bits 6 and
; 7 are the direction. The direction is turned a quarter to the left or the
; right, and the counter is set to a new random number. A figure which has
; bumped into a wall (bit 0 of the flags) changes direction straight away, and a
; figure with bit 5 of the flags set never changes direction on its own.
;
; IX The address of the object
;
; Change direction at once if the figure has hit a wall.
@label=UpdateDirection
c$B82A BIT 0,(IX+$07) ; {Jump to #R$B83F if the figure has bumped into a wall.
 $B82E JR NZ,$B83F    ; }
 $B830 DEC (IX+$06)   ; Count down the counter.
 $B833 LD A,(IX+$06)  ; Fetch the counter.
 $B836 AND %00011111  ; Keep the bottom five bits.
 $B838 RET NZ         ; Return unless the counter is at a multiple of thirty
                      ; two.
 $B839 BIT 5,(IX+$07) ; {Jump to #R$B85A to return if the figure keeps its
 $B83D JR NZ,$B85A    ; direction.}
; Turn left or right and set a new counter.
@label=UpdateDirection_Random
*$B83F LD A,($A218)   ; Fetch a random number.
 $B842 CP $80         ; Compare it with #N$80.
 $B844 LD A,(IX+$06)  ; Fetch the direction and counter.
 $B847 JR NC,$B856    ; Jump to #R$B856 to turn left if the random number is
                      ; #N$80 or more.
 $B849 ADD A,$40      ; Turn right.
@label=UpdateDirection_Timer
*$B84B LD C,A         ; Keep the new direction in #REGc.
 $B84C LD A,($A219)   ; Fetch another random number.
 $B84F AND %00111111  ; Keep the bottom six bits.
 $B851 OR C           ; Combine it with the direction.
 $B852 LD (IX+$06),A  ; Store the new direction.
 $B855 RET            ; Return.
; The random number was #N$80 or more, so turn left.
@label=UpdateDirection_TurnLeft
*$B856 SUB $40        ; Turn left.
 $B858 JR $B84B       ; Go back to store the direction and counter.
@label=UpdateDirection_Finish
*$B85A RET            ; Return.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$DD28 }
; LIST#

; Run Stage Script
;
; Used by the routine at #R$A36D.
; .
; Called every frame. In the duel and the bonus stage, which both have
; #R$A267 set to zero, it runs the routine for the kind of stage which is in
; #R$A265, as long as there are still stages to play (#R$A264 is not zero). In
; kind #N$00 nothing happens, in kind #N$01 money bags are made, and in kind
; #N$02 the duel is set up.
;
; .
;
; This routine is only for the duel and the bonus stage.
@label=RunStageScript
c$B85B LD A,($A267)  ; {Return if #R$A267 is not zero, so this is the town.
 $B85E AND A         ;
 $B85F RET NZ        ; }
; The stage continues only while there is something left to play.
 $B860 LD A,($A264)  ; {Return if #R$A264 is zero.
 $B863 AND A         ;
 $B864 RET Z         ; }
 $B865 LD A,$01      ; {Set #R$A240, so that the objects can go without a life
 $B867 LD ($A240),A  ; being lost.}
 $B86A LD A,($A265)  ; Fetch the kind of stage.
 $B86D LD BC,$B873   ; Point #REGbc at #R$B873.
; Run the routine for the kind of stage.
 $B870 JP $C766      ; Jump to #R$C766.

; Stage Routines
;
; The routine for each kind of stage.
@label=StageRoutines
w$B873 DEFW $A448
 $B875 DEFW $C7E8
 $B877 DEFW $B879

; Set Up Duel
;
; Sets up the duel in the first two object slots. The first is the outlaw,
; in a random place in the middle of the screen, who will move about a random
; number of times before he draws, and the second is his gun.
;
; .
;
; Copy the outlaw and his gun into the first two slots.
@label=SetUpDuel
c$B879 LD DE,$A27D   ; Point #REGde at the first object slot.
 $B87C LD A,(DE)     ; Fetch the type of the object in the slot.
 $B87D AND A         ; {Return if the slot is in use.
 $B87E RET NZ        ; }
 $B87F PUSH DE       ; {Copy the address of the first object slot into #REGiy
 $B880 POP IY        ; (using the stack).}
 $B882 LD HL,$B8A3   ; Point #REGhl at #R$B8A3.
 $B885 LD BC,$0020   ; Set the size of two object slots in #REGbc.
 $B888 LDIR          ; Copy the templates into the slots.
; Choose how many times he moves and where he stands.
 $B88A LD A,($A218)  ; Fetch a random number.
 $B88D AND %00000111 ; Keep a number from #N$00 to #N$07.
 $B88F ADD A,$02     ; Add two to give two to nine.
 $B891 LD (IY+$0A),A ; Set the number of times the outlaw moves before he
                     ; draws.
 $B894 LD A,($A219)  ; Fetch another random number.
 $B897 AND %01111111 ; Keep a number from #N$00 to #N$7F.
 $B899 ADD A,$40     ; Add #N$40 to give the horizontal position of the outlaw.
 $B89B LD (IY+$02),A ; Set the horizontal position of the outlaw.
 $B89E XOR A         ; {Write #N$00 to #R$A211 so the draw message has not been
 $B89F LD ($A211),A  ; shown.}
 $B8A2 RET           ; Return.

; Duel Templates
;
; The initial contents of the two slots for the duel: the outlaw (type
; #N$0C) and his gun (type #N$0E). The final two bytes of the second point to
; the sprite list.
@label=DuelTemplates
b$B8A3 DEFB $0C,$00,$70,$00,$60,$00,$00,$00 ; {The outlaw.
 $B8AB DEFB $20,$40,$00,$01,$00,$00,$00,$00 ; }
 $B8B3 DEFB $0E,$00,$00,$00,$00,$00,$00,$00 ; {The outlaw's gun.
 $B8BB DEFB $00,$00,$00,$00,$00,$00         ; }
 $B8C1 DEFW $B8CF                           ; The sprite list of the gun.

; Gun Sprite Lists
;
; The table of sprite lists for the six frames of the outlaw's gun,
; followed by the lists. Each list has one sprite.
@label=GunSpriteLists
g$B8C3 DEFW $B8CF           ; {The addresses of the sprite lists.
 $B8C5 DEFW $B8D3           ;
 $B8C7 DEFW $B8D7           ;
 $B8C9 DEFW $B8DB           ;
 $B8CB DEFW $B8DF           ;
 $B8CD DEFW $B8E3           ; }
 $B8CF DEFB $00,$00,$01,$80 ; Sprite #N$01. #SPRITE$01(outlaw-gun-arm-1*).
 $B8D3 DEFB $00,$00,$02,$80 ; Sprite #N$02. #SPRITE$02(outlaw-gun-arm-2*).
 $B8D7 DEFB $00,$00,$03,$80 ; Sprite #N$03. #SPRITE$03(outlaw-gun-arm-3*).
 $B8DB DEFB $00,$00,$04,$80 ; Sprite #N$04. #SPRITE$04(outlaw-gun-arm-4*).
 $B8DF DEFB $00,$00,$05,$80 ; Sprite #N$05. #SPRITE$05(outlaw-gun-arm-5*).
 $B8E3 DEFB $00,$00,$06,$80 ; Sprite #N$06. #SPRITE$06(outlaw-gun-arm-6*).

; Handle Outlaw Gun
;
; Type #N$0E: the gun of the outlaw in the duel, which is in the slot
; after the outlaw. It stays with the outlaw. When the outlaw is waiting it is
; not drawn, and when he has drawn it goes through its six frames, which raise
; the gun, and then it fires: it makes a muzzle flash (type #N$0F) in the next
; slot, and counts the shot in #R$A212. The duel ends when the outlaw has fired
; six shots. The gun is removed when the outlaw is dying.
@label=HandleOutlawGun
c$B8E7 LD A,(IX-$10) ; Fetch the type of the outlaw.
 $B8EA CP $12        ; {Jump to #R$C7BB to remove the gun if the outlaw is
 $B8EC JP Z,$C7BB    ; dying.}
 $B8EF CP $11        ; {Jump to #R$B910 if the outlaw has been shot.
 $B8F1 JR Z,$B910    ; }
 $B8F3 CP $0C        ; {Jump to #R$B910 if the outlaw is waiting.
 $B8F5 JR Z,$B910    ; }
 $B8F7 LD A,(IX+$0C) ; Fetch the frame of the gun.
 $B8FA CP $05        ; {Jump to #R$B92A if the gun is fully raised.
 $B8FC JR Z,$B92A    ; }
 $B8FE CALL $B9DD    ; Advance the frame when it is time.
 $B901 LD A,(IX+$0C) ; Fetch the frame of the gun.
 $B904 LD BC,$B8C3   ; Point #REGbc at #R$B8C3.
 $B907 CALL $C75C    ; Point #REGhl at the sprite list for the frame.
 $B90A LD (IX+$0E),L ; Store the low byte of the address.
 $B90D LD (IX+$0F),H ; Store the high byte of the address.
; Put the gun next to the outlaw and draw it.
@label=HandleOutlawGun_Place
*$B910 LD A,(IX-$0E) ; Fetch the horizontal position of the outlaw.
 $B913 SUB $08       ; Move eight pixels to the left.
 $B915 LD (IX+$02),A ; Set the horizontal position of the gun.
 $B918 LD A,(IX-$10) ; Fetch the type of the outlaw.
 $B91B CP $11        ; Compare it with the type of a shot outlaw.
 $B91D LD A,(IX-$0C) ; Fetch the vertical position of the outlaw.
 $B920 JR Z,$B924    ; Jump to #R$B924 if he has been shot.
 $B922 ADD A,$0C     ; Move the gun down twelve pixels.
@label=HandleOutlawGun_SetPosition
*$B924 LD (IX+$04),A ; Set the vertical position of the gun.
 $B927 JP $BD52      ; Jump to #R$BD52.
; The gun is fully raised, so fire it unless it has already fired.
@label=HandleOutlawGun_Fire
*$B92A LD A,(IX+$10) ; Fetch the type of the object in the next slot.
 $B92D AND A         ; Test whether the slot is in use.
 $B92E JR NZ,$B910   ; Jump to #R$B910 if it is.
 $B930 LD HL,$A212   ; Point #REGhl at #R$A212.
 $B933 LD A,(HL)     ; Fetch the count.
 $B934 AND A         ; {Return if the outlaw has been hit.
 $B935 RET M         ; }
 $B936 INC A         ; Add one to the count.
 $B937 CP $07        ; {Jump to #R$B985 to end the duel if the outlaw has fired
 $B939 JR Z,$B985    ; six shots.}
 $B93B LD (HL),A     ; Store the count.
 $B93C PUSH IX       ; {Copy #REGix to #REGhl (using the stack).
 $B93E POP HL        ; }
 $B93F LD BC,$0010   ; Set the size of an object slot.
 $B942 ADD HL,BC     ; Point #REGhl at the next slot.
 $B943 PUSH HL       ; {Copy #REGhl to #REGiy (using the stack).
 $B944 POP IY        ; }
 $B946 EX DE,HL      ; Swap the address of the slot into #REGde.
 $B947 LD HL,$B95E   ; Point #REGhl at #R$B95E.
 $B94A LDIR          ; Copy the template into the slot.
 $B94C LD A,(IX+$02) ; Fetch the horizontal position of the gun.
 $B94F ADD A,$08     ; Move eight pixels to the right.
 $B951 LD (IY+$02),A ; Set the horizontal position of the flash.
 $B954 LD A,(IX+$04) ; Fetch the vertical position of the gun.
 $B957 ADD A,$06     ; Move six pixels down.
 $B959 LD (IY+$04),A ; Set the vertical position of the flash.
; Place and draw the gun.
 $B95C JR $B910      ; Jump to #R$B910.

; Muzzle Flash Template
;
; The initial contents of a slot for a muzzle flash (type #N$0F). The
; final two bytes point to the sprite list, whose sprite number is set by
; #R$B972.
; #SPRITE$07(flash-1*) #SPRITE$08(flash-2*)
; #SPRITE$09(flash-3*) #SPRITE$0A(flash-4*)
@label=MuzzleFlashTemplate
b$B95E DEFB $0F,$00,$00,$00,$00,$00,$00,$00 ; {Type, position, speed, size and
 $B966 DEFB $00,$00,$00,$00,$00,$00         ; counters.}
 $B96C DEFW $B96E                           ; The sprite list of the flash.
 $B96E DEFB $00,$00,$00,$80                 ; The sprite list.

; Handle Muzzle Flash
;
; Type #N$0F: the flash of the outlaw's gun when he fires. It grows for
; four frames, using sprites #N$07 to #N($0A), and then makes a bullet hole.
@label=HandleMuzzleFlash
c$B972 LD A,(IX+$0C) ; Fetch the frame.
 $B975 CP $04        ; {Jump to #R$B990 if the flash is over.
 $B977 JR Z,$B990    ; }
 $B979 INC A         ; Move on to the next frame.
 $B97A LD (IX+$0C),A ; Store the frame.
 $B97D ADD A,$06     ; Add six to give the number of the sprite.
 $B97F LD ($B970),A  ; Store it in the sprite list.
 $B982 JP $BD52      ; Jump to #R$BD52.

; End Duel
;
; Used by the routine at #R$B8E7.
; .
; Ends the duel when the outlaw has fired all his shots without being hit.
; The flag at #R$A240 is cleared, so the player loses a life when the objects
; have gone, and there are no more stages to play, so the town comes next.
; #R$B989 is also used to end a stage.
@label=EndDuel
c$B985 XOR A         ; {Write #N$00 to #R$A240 so that the loss of the sheriff
 $B986 LD ($A240),A  ; counts.}
; This entry point is used by the routine at #R$BB3A.
@label=EndDuel_EndStage
*$B989 XOR A         ; {Write #N$00 to #R$A264, the number of stages left to
 $B98A LD ($A264),A  ; play.}
 $B98D JP $C7C8      ; Jump to #R$C7C8.

; Make Bullet Hole
;
; Used by the routine at #R$B972.
; .
; Puts a bullet hole (an object of type #N$10) in a random place on the
; screen, in the first free slot of the first thirteen, which are searched
; downwards from the thirteenth. It makes a burst of noise and removes the
; muzzle flash.
@label=MakeBulletHole
c$B990 LD HL,$A33D   ; Point #REGhl at the thirteenth object slot.
 $B993 LD DE,$FFF0   ; Set the distance to the previous slot.
 $B996 LD B,$0D      ; Set the number of slots to thirteen.
@label=MakeBulletHole_Loop
*$B998 LD A,(HL)     ; Fetch the type of the object in the slot.
 $B999 AND A         ; Test whether the slot is in use.
 $B99A JR Z,$B9A0    ; Jump to #R$B9A0 if it is free.
 $B99C ADD HL,DE     ; Move on to the previous slot.
 $B99D DJNZ $B998    ; Loop back until all the slots have been checked.
 $B99F RET           ; Return.
; Place a bullet hole in the free slot.
@label=MakeBulletHole_Found
*$B9A0 EX DE,HL      ; Swap the address of the slot into #REGde.
 $B9A1 PUSH DE       ; {Copy the address of the slot into #REGiy (using the
 $B9A2 POP IY        ; stack).}
 $B9A4 LD HL,$B9C6   ; Point #REGhl at #R$B9C6.
 $B9A7 LD BC,$0010   ; Set the size of an object slot in #REGbc.
 $B9AA LDIR          ; Copy the template into the slot.
 $B9AC LD A,($A218)  ; Fetch a random number.
 $B9AF AND %01111111 ; Keep a number from #N$00 to #N$7F.
 $B9B1 ADD A,$38     ; Add #N$38 to give the horizontal position.
 $B9B3 LD (IY+$02),A ; Set the horizontal position of the hole.
 $B9B6 LD A,($A219)  ; Fetch another random number.
 $B9B9 AND %00111111 ; Keep a number from #N$00 to #N$3F.
 $B9BB ADD A,$60     ; Add #N$60 to give the vertical position.
 $B9BD LD (IY+$04),A ; Set the vertical position of the hole.
 $B9C0 CALL $AE98    ; Make a burst of noise.
; Remove the muzzle flash.
 $B9C3 JP $C7BB      ; Jump to #R$C7BB.

; Bullet Hole Template
;
; The initial contents of a slot for a bullet hole (type #N$10). The final
; two bytes point to the sprite list.
@label=BulletHoleTemplate
b$B9C6 DEFB $10,$00,$00,$00,$00,$00,$00,$00 ; {Type, position, speed, size and
 $B9CE DEFB $00,$00,$00,$00,$00,$00         ; counters.}
 $B9D4 DEFW $B9D6                           ; The sprite list of a bullet hole.
 $B9D6 DEFB $F0,$F0,$0B,$80                 ; The sprite list: sprite #N$0B at offset
                                            ; (#N($F0), #N$F0). #SPRITE$0B(bullet-hole*).

; Handle Bullet Hole
;
; Type #N$10: a bullet hole, which stays where it is.
@label=HandleBulletHole
c$B9DA JP $BD52      ; Jump to #R$BD52.

; Advance Gun Frame
;
; Used by the routine at #R$B8E7.
; .
; Moves the outlaw's gun on to its next frame. If the player has provoked
; the outlaw, which is when #R$A211 is one, the gun moves on every frame.
; Otherwise it moves on after a delay which is shorter at the higher levels of
; skill.
;
; IX The address of the gun
@label=AdvanceGunFrame
c$B9DD LD A,($A211)  ; Fetch #R$A211.
 $B9E0 CP $01        ; {Jump to #R$B9F7 to move to the next frame at once if the outlaw has
 $B9E2 JR Z,$B9F7    ; been provoked.}
 $B9E4 LD A,(IX+$05) ; {Jump to #R$B9EE if the delay is zero.
 $B9E7 AND A         ;
 $B9E8 JR Z,$B9EE    ; }
 $B9EA DEC (IX+$05)  ; Count down the delay.
 $B9ED RET           ; Return.
; The delay has finished, so set a new one from the skill level.
@label=AdvanceGunFrame_Reset
*$B9EE LD A,($A261)  ; Fetch #R$A261.
 $B9F1 CPL           ; Invert it.
 $B9F2 AND %00000111 ; Keep a number from #N$00 to #N$07, which is smaller at the
                     ; higher skill levels.
 $B9F4 LD (IX+$05),A ; Set the delay.
@label=AdvanceGunFrame_Next
*$B9F7 INC (IX+$0C)  ; Move on to the next frame.
 $B9FA RET           ; Return.

; Handle Waiting Outlaw
;
; Type #N$0C: the outlaw in the duel before he draws. He wanders about the
; screen, changing direction a random number of times (the count in
; #REGix+#N$0A), and at the end of the last move he draws his gun. If the player
; moves or fires before then he draws at once. He is hit if the crosshair is on
; him when the player fires.
; #PUSHS #UDGTABLE { #POKES$5C79,$56
; #SIM(start=$A36D,stop=$A392,clear=1,sp=$5E00)
; #SIM(start=$A395,stop=$A3B3)
; #POKES$A265,$02;$A266,$45
; #SIM(start=$A3B3,stop=$A3B7)
; #SIM(start=$A3B7,stop=$A3BA)
; #SIM(start=$A3BA,stop=$A3F6)
; #SIM(start=$A3F6,stop=$A3BA)
; #SIM(start=$A3BA,stop=$A3F6)
; #SIM(start=$A3F6,stop=$A3BA)
; #SIM(start=$A3BA,stop=$A3F6)
; #SCR$03,$02,$00,$18,$10(waiting-outlaw) } UDGTABLE# #POPS
;
; .
;
; Count down the current move, and draw if he has finished.
@label=HandleWaitingOutlaw
c$B9FB CALL $BA8B      ; Check whether the player has provoked the outlaw.
 $B9FE DEC (IX+$0B)    ; Count down the timer for the current move.
 $BA01 LD A,(IX+$0B)   ; Fetch the timer.
 $BA04 JR NZ,$BA0F     ; Jump if the move is not over.
 $BA06 OR (IX+$0A)     ; Combine the timer, which is zero, with the number of
                       ; moves left.
 $BA09 JP Z,$BAB1      ; Jump to make the outlaw draw if he has made all his
                       ; moves.
 $BA0C CALL $BC37      ; Choose a new move.
; Keep him on the screen and move him.
@label=HandleWaitingOutlaw_Move
*$BA0F CALL $BBDD      ; Keep the outlaw on the screen, which reverses his
                       ; speed at an edge.
 $BA12 LD A,(IX+$05)   ; Fetch the flags which show whether he has reached an
                       ; edge.
 $BA15 AND %00001111   ; Keep the four bits.
 $BA17 JR Z,$BA1D      ; Jump if he has not reached an edge.
 $BA19 LD (IX+$0B),$01 ; Make the move end on the next frame.
@label=HandleWaitingOutlaw_Update
*$BA1D CALL $BBCA      ; Move the outlaw.
; This entry point is used by the routines at #R$BAB1 and #R$BADA.
; .
; Check whether the crosshair has hit him.
@label=HandleWaitingOutlaw_CheckHit
*$BA20 CALL $BA63      ; Check whether the crosshair is on the outlaw.
 $BA23 JR NC,$BA32     ; Jump if the outlaw has not been hit.
 $BA25 LD A,$80        ; Set the flag which shows that the outlaw has been hit.
 $BA27 LD ($A212),A    ; Store the flag which shows the outlaw has been hit.
 $BA2A LD (IX+$00),$11 ; Turn the outlaw into a shot outlaw.
 $BA2E LD (IX+$0C),$00 ; Start at the first frame of falling.
; Draw the body of the outlaw.
@label=HandleWaitingOutlaw_DrawBody
*$BA32 LD A,(IX+$02)   ; {Fetch the horizontal position of the outlaw and keep
 $BA35 LD L,A          ; it in #REGl.}
 $BA36 LD ($A220),A    ; Store it as the horizontal pixel position for the
                       ; sprites.
 $BA39 LD H,(IX+$04)   ; Fetch the vertical position of the outlaw into #REGh.
 $BA3C CALL $D233      ; Find the address in the buffer.
 $BA3F CALL $BC6C      ; Choose the sprites of the body of the outlaw.
 $BA42 LD B,$03        ; Set the number of sprites to three.
 $BA44 CALL $B280      ; Draw the body of the outlaw into the buffer.
; Continue on to #R$BA47.

; Draw Outlaw Face
;
; Used by the routine at #R$BADD.
; .
; Draws the face of the outlaw, which is five sprites, into the buffer,
; below the body.
;
; HL The address in the buffer
;
; Find the face sprites for this outlaw.
@label=DrawOutlawFace
c$BA47 LD A,($A260)  ; Fetch the level.
 $BA4A EX DE,HL      ; Swap the address in the buffer into #REGde.
 $BA4B LD HL,$B494   ; Point #REGhl at #R$B494.
 $BA4E CALL $D275    ; Point #REGhl at the entry for the level.
 $BA51 LD L,(HL)     ; Fetch the number of the outlaw.
 $BA52 LD H,$00      ; Set the high byte.
 $BA54 LD C,L        ; {Make the outlaw number a sixteen bit index in #REGbc.
 $BA55 LD B,H        ; }
 $BA56 ADD HL,HL     ; {Multiply it by four.
 $BA57 ADD HL,HL     ; }
 $BA58 ADD HL,BC     ; Add the number to make it five times as big.
 $BA59 LD BC,$B5B0   ; Point #REGbc at #R$B5B0.
 $BA5C ADD HL,BC     ; Point #REGhl at the sprites of his face.
 $BA5D EX DE,HL      ; Swap the pointer to the face into #REGde and the address back into
                     ; #REGhl.
; Draw the five sprites of the face.
 $BA5E LD B,$05      ; Set the number of sprites to five.
 $BA60 JP $B280      ; Jump to #R$B280.

; Check Crosshair On Outlaw
;
; Used by the routine at #R$B9FB.
; .
; Checks whether the player's shot is on the outlaw. The outlaw cannot be
; hit once he has fired his first shot.
;
;   IX The address of the outlaw
; O:F The carry flag is set if the outlaw has been hit
;
; Return unless the player's shot is in the air.
@label=CheckCrosshairOnOutlaw
c$BA63 LD A,($A212)  ; {Return if #R$A212 is not zero.
 $BA66 AND A         ;
 $BA67 RET NZ        ; }
 $BA68 LD IY,$A34D   ; Point #REGiy at the fourteenth object slot, which holds the player's
                     ; shot.
 $BA6C LD A,(IY+$00) ; {Return if the shot slot is not in use.
 $BA6F AND A         ;
 $BA70 RET Z         ; }
; Test whether the shot is on the outlaw.
 $BA71 LD A,(IX+$02) ; Fetch the horizontal position of the outlaw.
 $BA74 ADD A,$04     ; Move four pixels to the right.
 $BA76 SUB (IY+$02)  ; Subtract the horizontal position of the shot.
 $BA79 NEG           ; Make it positive.
 $BA7B CP $18        ; {Return if the shot is #N$18 or more to the side.
 $BA7D RET NC        ; }
 $BA7E LD A,(IX+$04) ; Fetch the vertical position of the outlaw.
 $BA81 ADD A,$0C     ; Move twelve pixels up.
 $BA83 SUB (IY+$04)  ; Subtract the vertical position of the shot.
 $BA86 NEG           ; Make it positive.
 $BA88 CP $30        ; Compare it with forty eight.
 $BA8A RET           ; Return with the carry flag set if the shot is on the
                     ; outlaw.

; Check For Early Draw
;
; Used by the routine at #R$B9FB.
; .
; Reads the controls while the outlaw is waiting. If the player moves the
; crosshair or fires, the outlaw is provoked and starts to draw at once, and
; "DRAW!!" appears in yellow, if it is not already on the screen.
;
; IX The address of the outlaw
@label=CheckForEarlyDraw
c$BA8B LD A,(IX+$06) ; Fetch the flag which shows that the outlaw has been
                     ; provoked.
 $BA8E AND A         ; {Return if the outlaw has already been provoked.
 $BA8F RET NZ        ; }
 $BA90 CALL $D0E3    ; Read the controls.
 $BA93 AND A         ; {Return if nothing has been pressed.
 $BA94 RET Z         ; }
 $BA95 LD A,$01      ; Set the flag to one.
 $BA97 LD (IX+$06),A ; Store the flag which shows the outlaw is provoked.
 $BA9A LD (IX+$0A),A ; Make this the last move.
 $BA9D LD (IX+$0B),A ; Make the timer run out on the next frame.
 $BAA0 LD HL,$A211   ; Point #REGhl at #R$A211.
 $BAA3 LD A,(HL)     ; Fetch the flag.
 $BAA4 AND A         ; {Return if the draw message has already been printed.
 $BAA5 RET NZ        ; }
 $BAA6 LD (HL),$01   ; Set the flag to one.
; Print the "DRAW!!" message.
 $BAA8 LD HL,$502E   ; Point #REGhl at #N$502E (in the screen buffer).
 $BAAB LD DE,$BAD2   ; Point #REGde at #R$BAD2.
 $BAAE JP $AA9A      ; Jump to #R$AA9A.

; Start Outlaw Drawing
;
; Used by the routine at #R$B9FB.
; .
; Called when the outlaw has finished moving about. He is turned into an
; outlaw who is drawing (type #N$0D), and "DRAW!!" is printed in red if it is
; not yet on the screen.
;
; IX The address of the outlaw
@label=StartOutlawDrawing
c$BAB1 LD (IX+$00),$0D ; Turn the outlaw into one who is drawing.
 $BAB5 LD HL,$A211     ; Point #REGhl at #R$A211.
 $BAB8 LD A,(HL)       ; Fetch the flag.
 $BAB9 AND A           ; {Jump to #R$BAC7 if the draw message has been printed.
 $BABA JR NZ,$BAC7     ; }
 $BABC LD (HL),$02     ; Set the flag to two.
; Print the "DRAW!!" message.
 $BABE LD HL,$502E     ; Point #REGhl at #N$502E (in the screen buffer).
 $BAC1 LD DE,$BACA     ; Point #REGde at #R$BACA.
 $BAC4 CALL $AA9A      ; Print the message.
@label=StartOutlawDrawing_CheckHit
*$BAC7 JP $BA20        ; Jump to check whether he has been hit.

; Messaging: Draw Text
;
; The two "DRAW!!" messages, each of which is an attribute byte (red, then
; yellow), characters and a zero byte. Each "!" is the character code #N$5D,
; which is why they are not text.
@label=DrawMessages
t$BACA DEFB $42      ; Attribute: #COLOUR(#PEEK(#PC)).
 $BACB DEFM "DRAW"   ; "DRAW"
 $BACF DEFB $5D,$5D  ; Two exclamation marks.
 $BAD1 DEFB $00      ; Terminator.
@label=DrawMessages_Yellow
 $BAD2 DEFB $46      ; Attribute: #COLOUR(#PEEK(#PC)).
 $BAD3 DEFM "DRAW"   ; "DRAW"
 $BAD7 DEFB $5D,$5D  ; Two exclamation marks.
 $BAD9 DEFB $00      ; Terminator.

; Handle Drawing Outlaw
;
; Type #N$0D: the outlaw while he draws. He does not move.
@label=HandleDrawingOutlaw
c$BADA JP $BA20      ; Jump to check whether he has been hit, and draw him.

; Handle Shot Outlaw
;
; Type #N$11: an outlaw who has been hit. For six frames he is drawn with
; the two body sprites at #R$BBC8 and then he starts to die.
@label=HandleShotOutlaw
c$BADD INC (IX+$0C)    ; Move on to the next frame.
 $BAE0 LD A,(IX+$0C)   ; Fetch the frame.
 $BAE3 CP $06          ; {Jump to #R$BB03 if the six frames are over.
 $BAE5 JR Z,$BB03      ; }
 $BAE7 LD A,(IX+$02)   ; {Fetch the horizontal position of the outlaw and keep
 $BAEA LD L,A          ; it in #REGl.}
 $BAEB LD ($A220),A    ; Store it as the horizontal pixel position for the
                       ; sprites.
 $BAEE LD H,(IX+$04)   ; Fetch the vertical position of the outlaw into #REGh.
 $BAF1 CALL $D233      ; Find the address in the buffer.
 $BAF4 LD DE,$BBC8     ; Point #REGde at #R$BBC8.
 $BAF7 LD B,$02        ; Set the number of sprites to two.
 $BAF9 CALL $B280      ; Draw the body into the buffer.
 $BAFC LD BC,$FF88     ; Five buffer rows up is one hundred and twenty bytes.
 $BAFF ADD HL,BC       ; Move the address up five rows of the buffer.
 $BB00 JP $BA47        ; Jump to #R$BA47.
; Start the outlaw dying.
@label=HandleShotOutlaw_Die
*$BB03 LD (IX+$00),$12 ; Turn the outlaw into a dying outlaw.
 $BB07 LD (IX+$0C),$00 ; Start at the first frame of dying.
; Continue on to #R$BB0B.

; Handle Dying Outlaw
;
; Type #N$12: an outlaw who is dying. He sinks out of sight, a sprite
; fewer each four frames, and when he has gone the player is rewarded.
;
; .
;
; Give the reward when the last frame is over.
@label=HandleDyingOutlaw
c$BB0B LD A,(IX+$0C) ; Fetch the frame.
 $BB0E CP $03        ; {Jump to #R$BB3A to give the reward if it is three.
 $BB10 JR Z,$BB3A    ; }
; Draw the sprites of this frame.
 $BB12 LD E,A        ; Copy the frame into #REGe.
 $BB13 LD BC,$BBBB   ; Point #REGbc at #R$BBBB.
 $BB16 CALL $C75C    ; Fetch the pointer to the sprite list for the frame.
 $BB19 EX DE,HL      ; Swap the pointer into #REGde.
 $BB1A LD A,L        ; Fetch the frame.
 $BB1B NEG           ; Subtract it from zero.
 $BB1D ADD A,$04     ; Add four, to give the number of sprites for the frame.
 $BB1F LD B,A        ; Keep the number of body sprites in #REGb.
 $BB20 LD A,(IX+$02) ; {Fetch the horizontal position of the outlaw and keep it
 $BB23 LD L,A        ; in #REGl.}
 $BB24 LD ($A220),A  ; Store it as the horizontal pixel position for the
                     ; sprites.
 $BB27 LD H,(IX+$04) ; Fetch the vertical position of the outlaw into #REGh.
 $BB2A CALL $D233    ; Find the address in the buffer.
 $BB2D CALL $B280    ; Draw the sprites into the buffer.
; Move on a frame every fourth frame.
 $BB30 LD A,($A216)  ; Fetch the frame counter.
 $BB33 AND %00000011 ; Keep a number from #N$00 to #N$03.
 $BB35 RET NZ        ; Return unless it is every fourth frame.
 $BB36 INC (IX+$0C)  ; Move on to the next frame.
 $BB39 RET           ; Return.

; Give Reward
;
; Used by the routine at #R$BB0B.
; .
; Called when the outlaw has finished dying. Plays a tune and adds the
; reward for this outlaw to the player's bounty, then adds a life to make up for
; the one which the next stage takes, and moves on to the next level. The skill
; level goes up every second level, to a maximum of seven. Levels past the
; nineteenth go back to the sixteenth. After every fourth level the player plays
; a bonus stage in which money bags fall; otherwise the stage ends.
@label=GiveReward
c$BB3A LD DE,$B0A9   ; Point #REGde at #R$B0A9.
 $BB3D CALL $AF8F    ; Call #R$AF8F.
 $BB40 LD A,($A260)  ; Fetch the level.
 $BB43 LD C,A        ; {Multiply it by three.
 $BB44 ADD A,A       ;
 $BB45 ADD A,C       ; }
 $BB46 LD HL,$B56E   ; Point #REGhl at #R$B56E.
 $BB49 CALL $D275    ; Point #REGhl at the reward for the level.
 $BB4C INC HL        ; {Move on to the last byte of the reward.
 $BB4D INC HL        ; }
 $BB4E LD C,(HL)     ; Fetch the last byte into #REGc.
 $BB4F DEC HL        ; Move back a byte.
 $BB50 LD B,(HL)     ; Fetch the middle byte into #REGb.
 $BB51 DEC HL        ; Move back to the first byte.
 $BB52 EX DE,HL      ; Keep its address in #REGde.
 $BB53 CALL $D354    ; Add #REGbc to the bounty.
 $BB56 LD A,(DE)     ; {Add the first byte of the reward to the most significant byte of the
 $BB57 ADD A,(HL)    ; bounty.
 $BB58 DAA           ;
 $BB59 LD (HL),A     ; }
 $BB5A CALL $D390    ; Print the bounty.
 $BB5D LD HL,$A263   ; {Add one to the number of lives, to make up for the one which the
 $BB60 INC (HL)      ; next stage takes.}
 $BB61 LD HL,$A260   ; {Move on to the next level.
 $BB64 INC (HL)      ; }
 $BB65 LD A,(HL)     ; Fetch the level.
 $BB66 CP $14        ; {Jump to #R$BB6D if there are more levels.
 $BB68 JR C,$BB6D    ; }
 $BB6A LD A,$10      ; {Go back to the sixteenth level.
 $BB6C LD (HL),A     ; }
@label=GiveReward_Skill
*$BB6D AND %00000001 ; Test whether the level is odd.
 $BB6F JR NZ,$BB7A   ; Jump if it is.
 $BB71 LD HL,$A261   ; Point #REGhl at #R$A261.
 $BB74 LD A,(HL)     ; Fetch the skill level.
 $BB75 CP $07        ; {Jump to #R$BB7A if it is already as high as it goes.
 $BB77 JR Z,$BB7A    ; }
 $BB79 INC (HL)      ; Raise the skill level.
@label=GiveReward_CheckLevel
*$BB7A LD A,($A260)  ; Fetch the level.
 $BB7D AND %00000011 ; Test whether this is the fourth level.
 $BB7F JP NZ,$B989   ; End the stage if it is not.
; Show the bonus message, play a fanfare and set up the stage of money
; bags.
 $BB82 CALL $D0B7    ; Clear the buffer.
 $BB85 CALL $D0B4    ; Draw the buffer on the screen, which blanks it, and
                     ; clear it again.
; Print the bonus message.
 $BB88 LD HL,$40EB   ; Point #REGhl at #N$40EB (in the screen buffer).
 $BB8B LD DE,$BBB4   ; Point #REGde at #R$BBB4.
 $BB8E CALL $AA9A    ; Print the message.
 $BB91 LD DE,$B1E0   ; Point #REGde at #R$B1E0.
 $BB94 CALL $AF8F    ; Play the fanfare.
 $BB97 LD B,$02      ; Set the length of the delay.
 $BB99 LD HL,$0000   ; Set the longest wait, which is a count of zero.
 $BB9C CALL $AE82    ; Wait for a while.
 $BB9F LD HL,$0114   ; {Set #R$A264 to #N$14 bags and #R$A265 to the money-bag
 $BBA2 LD ($A264),HL ; stage.}
 $BBA5 CALL $C7C8    ; Remove all of the objects.
 $BBA8 LD A,$46      ; Set #REGa to #COLOUR$46.
 $BBAA LD ($A266),A  ; Store it as the screen colour.
 $BBAD LD HL,$A263   ; {Add another, to make up for the one which the bonus
 $BBB0 INC (HL)      ; stage takes.}
 $BBB1 JP $A3B3      ; Start the stage.

; Messaging: Bonus Text
;
; The message which is shown before the stage of money bags: an attribute
; byte, characters and a zero byte.
@label=BonusMessage
t$BBB4 DEFB $46      ; Attribute: #COLOUR(#PEEK(#PC)).
 $BBB5 DEFM "BONUS"  ; "BONUS"
 $BBBA DEFB $00      ; Terminator.

; Dying Outlaw Sprites
;
; The sprite lists of the dying outlaw, which are drawn in the buffer:
; #R$BBC1, #R$BBC5 and #R$BBC8, which is also used for a shot outlaw.
@label=DyingOutlawSprites
w$BBBB DEFW $BBC1           ; {The addresses of #R$BBC1, #R$BBC5 and #R$BBC8.
 $BBBD DEFW $BBC5           ;
 $BBBF DEFW $BBC8           ; }
@label=DyingOutlawSprites_FirstFrame
 $BBC1 DEFB $20,$21,$22,$23 ; The first frame: #SPRITE$20(legs-5*)
                            ; #SPRITE$21(legs-6*) #SPRITE$22(legs-7*) #SPRITE$23(legs-8*).
@label=DyingOutlawSprites_SecondFrame
 $BBC5 DEFB $24,$25,$26     ; The second frame: #SPRITE$24(man-1*)
                            ; #SPRITE$25(man-2*) #SPRITE$26(man-3*).
@label=DyingOutlawSprites_Shot
 $BBC8 DEFB $27,$28         ; A shot outlaw: #SPRITE$27(man-4*)
                            ; #SPRITE$28(bullet*).

; Move Duel Outlaw
;
; Used by the routine at #R$B9FB.
; .
; Moves the outlaw in the duel by his speeds. Both his positions are
; single bytes in this stage.
;
; IX The address of the outlaw
@label=MoveDuelOutlaw
c$BBCA LD A,(IX+$02)  ; Fetch the horizontal position.
 $BBCD ADD A,(IX+$01) ; Add the horizontal speed.
 $BBD0 LD (IX+$02),A  ; Set the new horizontal position.
 $BBD3 LD A,(IX+$04)  ; Fetch the vertical position.
 $BBD6 ADD A,(IX+$03) ; Add the vertical speed.
 $BBD9 LD (IX+$04),A  ; Set the new vertical position.
 $BBDC RET            ; Return.

; Keep Outlaw On Screen
;
; Used by the routine at #R$B9FB.
; .
; Checks whether the next move would take the outlaw past an edge of the
; area he moves in, and if so changes his speed so that he does not go past it,
; and sets a bit in #REGix+#N$05 for the edge: bit 0 for the left edge, bit 1
; for the right edge, bit 2 for the lower edge and bit 3 for the upper edge.
;
; IX The address of the outlaw
;
; Test the left edge.
@label=KeepOutlawOnScreen
c$BBDD LD (IX+$05),$00 ; Clear the flags for the edges.
 $BBE1 LD A,(IX+$02)   ; Fetch the horizontal position.
 $BBE4 ADD A,(IX+$01)  ; Add the horizontal speed.
 $BBE7 SUB $28         ; Subtract the left edge.
 $BBE9 JR NC,$BBF4     ; Jump if the outlaw is not past it.
 $BBEB NEG             ; Make the distance past the edge positive.
 $BBED LD (IX+$01),A   ; Set it as the horizontal speed, which bounces him back
                       ; to the right.
 $BBF0 SET 0,(IX+$05)  ; Set the flag for the left edge.
; Test the right edge.
@label=KeepOutlawOnScreen_Right
*$BBF4 LD A,(IX+$02)   ; Fetch the horizontal position.
 $BBF7 ADD A,(IX+$08)  ; Add the width of the outlaw.
 $BBFA ADD A,(IX+$01)  ; Add the horizontal speed.
 $BBFD SUB $D1         ; Subtract the right edge.
 $BBFF JR C,$BC0D      ; Jump if the outlaw is not past it.
 $BC01 NEG             ; Subtract it from zero, to give the distance still to
                       ; go to the edge.
 $BC03 ADD A,(IX+$01)  ; Add the horizontal speed.
 $BC06 LD (IX+$01),A   ; Set it as the horizontal speed, which stops him at the
                       ; edge.
 $BC09 SET 1,(IX+$05)  ; Set the flag for the right edge.
; Test the lower edge.
@label=KeepOutlawOnScreen_Lower
*$BC0D LD A,(IX+$04)   ; Fetch the vertical position.
 $BC10 ADD A,(IX+$03)  ; Add the vertical speed.
 $BC13 SUB $48         ; Subtract the lower edge.
 $BC15 JR NC,$BC20     ; Jump if the outlaw is not past it.
 $BC17 NEG             ; Make the distance past the edge positive.
 $BC19 LD (IX+$03),A   ; Set it as the vertical speed, which bounces him back
                       ; up.
 $BC1C SET 2,(IX+$05)  ; Set the flag for the lower edge.
; Test the upper edge.
@label=KeepOutlawOnScreen_Upper
*$BC20 LD A,(IX+$04)   ; Fetch the vertical position.
 $BC23 ADD A,(IX+$09)  ; Add the height of the outlaw.
 $BC26 ADD A,(IX+$03)  ; Add the vertical speed.
 $BC29 SUB $B9         ; Subtract the upper edge.
 $BC2B JR C,$BC36      ; Return if the outlaw is not past it.
 $BC2D NEG             ; Subtract it from zero, to give a speed which takes him
                       ; back down.
 $BC2F LD (IX+$03),A   ; Set it as the vertical speed.
 $BC32 SET 3,(IX+$05)  ; Set the flag for the upper edge.
@label=KeepOutlawOnScreen_Finish
*$BC36 RET             ; Return.

; Choose Outlaw Move
;
; Used by the routine at #R$B9FB.
; .
; Gives the waiting outlaw a new move: a speed in each direction of up to
; three, taken from random numbers, and a time for the move of eight to thirty
; nine frames. On the last move the speeds are doubled.
;
; IX The address of the outlaw
;
; Choose a horizontal speed.
@label=ChooseOutlawMove
c$BC37 LD A,($A218)  ; {Fetch a random number and keep it in #REGc.
 $BC3A LD C,A        ; }
 $BC3B AND %00000011 ; Keep a number from #N$00 to #N$03.
 $BC3D BIT 7,C       ; {Jump to #R$BC43 if the top bit of the random number is
 $BC3F JR Z,$BC43    ; clear.}
 $BC41 NEG           ; Make the speed negative.
; Store it, then choose a vertical speed.
@label=ChooseOutlawMove_Vertical
*$BC43 LD (IX+$01),A ; Set the horizontal speed.
 $BC46 LD A,($A219)  ; {Fetch another random number and keep it in #REGc.
 $BC49 LD C,A        ; }
 $BC4A AND %00000011 ; Keep a number from #N$00 to #N$03.
 $BC4C BIT 7,C       ; {Jump to #R$BC52 if the top bit of the random number is
 $BC4E JR Z,$BC52    ; clear.}
 $BC50 NEG           ; Make the speed negative.
; Store the vertical speed, then set the time of the move.
@label=ChooseOutlawMove_Time
*$BC52 LD (IX+$03),A ; Set the vertical speed.
 $BC55 LD A,($A216)  ; Fetch the frame counter.
 $BC58 AND %00011111 ; Keep a number from #N$00 to #N$1F.
 $BC5A ADD A,$08     ; Add eight.
 $BC5C LD (IX+$0B),A ; Set the timer for the move.
 $BC5F DEC (IX+$0A)  ; Count down the moves left.
 $BC62 RET NZ        ; Return unless that was the last move.
 $BC63 SLA (IX+$01)  ; Double the horizontal speed.
 $BC67 SLA (IX+$03)  ; Double the vertical speed.
 $BC6B RET           ; Return.

; Choose Outlaw Body
;
; Used by the routine at #R$B9FB.
; .
; Chooses which of the two sprite lists for the body of the outlaw to
; draw. He takes a step every fourth frame while he is moving.
;
;   IX The address of the outlaw
; O:DE The address of the sprite list
;
; Take a step every fourth frame while he is moving.
@label=ChooseOutlawBody
c$BC6C LD A,(IX+$01) ; Fetch the horizontal speed.
 $BC6F OR (IX+$03)   ; Combine it with the vertical speed.
 $BC72 JR Z,$BC86    ; Jump if he is not moving.
 $BC74 LD A,(IX+$0A) ; Fetch the number of moves left.
 $BC77 OR (IX+$0B)   ; Combine it with the timer.
 $BC7A JR Z,$BC86    ; Jump if both are zero.
 $BC7C LD A,($A216)  ; Fetch the frame counter.
 $BC7F AND %00000011 ; Keep a number from #N$00 to #N$03.
 $BC81 JR NZ,$BC86   ; Jump unless it is every fourth frame.
 $BC83 INC (IX+$0E)  ; Take a step.
; Choose the sprite list for the step.
@label=ChooseOutlawBody_Step
*$BC86 LD A,(IX+$0E) ; Fetch the step.
 $BC89 AND %00000001 ; Keep the lowest bit.
 $BC8B LD DE,$B5AA   ; Point #REGde at #R$B5AA.
 $BC8E RET Z         ; Return if the step is even.
 $BC8F LD DE,$B5AD   ; Point #REGde at #R$B5AD.
 $BC92 RET           ; Return.

; Create Crosshair
;
; Used by the routine at #R$C049.
; .
; Puts the crosshair (an object of type #N$03) in the last object slot, if
; it is not already there.
@label=CreateCrosshair
c$BC93 LD DE,$A35D   ; Point #REGde at the last object slot.
 $BC96 LD A,(DE)     ; {Return if the last object slot is in use.
 $BC97 AND A         ;
 $BC98 RET NZ        ; }
 $BC99 LD HL,$BCA2   ; Point #REGhl at #R$BCA2.
 $BC9C LD BC,$0010   ; Set the size of an object slot in #REGbc.
 $BC9F LDIR          ; Copy the template into the slot.
 $BCA1 RET           ; Return.

; Crosshair Template
;
; The initial contents of a slot for the crosshair (type #N$03). It starts
; in the middle of the screen. The final two bytes point to the sprite list.
@label=CrosshairTemplate
b$BCA2 DEFB $03,$00,$78,$00,$54,$08,$00,$00 ; {Type, position, speed, size and
 $BCAA DEFB $08,$08,$00,$00,$00,$00         ; counters.}
 $BCB0 DEFW $BCB2                           ; The address of #R$BCB2.
@label=CrosshairSpriteList
 $BCB2 DEFB $F4,$F4,$2C,$80                 ; The sprite list: sprite #N$2C at offset
                                            ; (#N($F4), #N$F4). #SPRITE$2C(crosshair*).

; Move Crosshair Left
;
; Used by the routine at #R$BCCA.
; .
; Part of the handler for the crosshair, which is entered when the left
; control is pressed. Moves the crosshair left, but not past the left limit.
;
; E The speed of the crosshair
; L The horizontal position of the crosshair
@label=MoveCrosshairLeft
c$BCB6 LD A,L        ; Fetch the horizontal position.
 $BCB7 SUB E         ; Subtract the speed.
 $BCB8 CP $2C        ; {Jump to #R$BCEE if the crosshair is not past it.
 $BCBA JR NC,$BCEE   ; }
 $BCBC LD A,$2C      ; Stop at the left limit.
 $BCBE JR $BCEE      ; Jump to set the position.

; Move Crosshair Down
;
; Used by the routine at #R$BCCA.
; .
; Part of the handler for the crosshair, which is entered when the down
; control is pressed. Moves the crosshair down, but not past the lower limit.
;
; E The speed of the crosshair
; H The vertical position of the crosshair
@label=MoveCrosshairDown
c$BCC0 LD A,H        ; Fetch the vertical position.
 $BCC1 SUB E         ; Subtract the speed.
 $BCC2 CP $54        ; {Jump to #R$BD22 if the crosshair is not past it.
 $BCC4 JR NC,$BD22   ; }
 $BCC6 LD A,$54      ; Stop at the lower limit.
 $BCC8 JR $BD22      ; Jump to set the position.

; Handle Crosshair
;
; Type #N$03: the crosshair, which the player moves about the screen in
; the duel to aim at the outlaw. It is moved by the controls, and stays between
; limits. When the fire control is pressed it fires the revolver.
;
; .
;
; Reload the revolver if it needs it.
@label=HandleCrosshair
c$BCCA CALL $C977    ; Call #R$C977.
 $BCCD LD L,(IX+$02) ; Fetch the horizontal position into #REGl.
 $BCD0 LD H,(IX+$04) ; Fetch the vertical position into #REGh.
 $BCD3 LD E,(IX+$05) ; Fetch the speed into #REGe.
; Read the controls.
 $BCD6 CALL $D0E3    ; Call #R$D0E3.
; Move left or right, but not past the edges.
 $BCD9 LD A,B        ; Fetch the controls into #REGa.
 $BCDA AND %00000011 ; Keep the two bits.
 $BCDC JR Z,$BCEF    ; Jump to #R$BCEF if neither or both are pressed.
 $BCDE CP $03        ; {Jump to #R$BCEF if both are pressed.
 $BCE0 JR Z,$BCEF    ; }
 $BCE2 CP $01        ; {Jump to #R$BCB6 to move left if left is pressed.
 $BCE4 JR Z,$BCB6    ; }
 $BCE6 LD A,L        ; Fetch the horizontal position.
 $BCE7 ADD A,E       ; Add the speed.
 $BCE8 CP $C5        ; {Jump to #R$BCEE if the crosshair is not past it.
 $BCEA JR C,$BCEE    ; }
 $BCEC LD A,$C4      ; Stop at the right limit.
; This entry point is used by the routine at #R$BCB6.
@label=HandleCrosshair_SetHorizontal
*$BCEE LD L,A        ; Set the horizontal position.
; See whether the controls are the keyboard.
@label=HandleCrosshair_Vertical
*$BCEF LD A,($A21C)  ; Fetch #R$A21C.
 $BCF2 RRCA          ; Move the bits for the controls into the low bits.
 $BCF3 AND %00000011 ; Keep the two bits.
 $BCF5 JP Z,$BD3A    ; Jump to #R$BD3A if the controls are the keyboard.
; Copy the joystick bits for up, down and fire into #REGb.
 $BCF8 LD A,B        ; Fetch the controls into #REGa.
 $BCF9 LD B,$00      ; Clear #REGb.
 $BCFB BIT 2,A       ; {Jump to #R$BD01 if up is not pressed.
 $BCFD JR Z,$BD01    ; }
 $BCFF SET 1,B       ; Set the bit for up.
@label=HandleCrosshair_TestDown
*$BD01 BIT 4,A       ; {Jump to #R$BD07 if down is not pressed.
 $BD03 JR Z,$BD07    ; }
 $BD05 SET 0,B       ; Set the bit for down.
@label=HandleCrosshair_TestFire
*$BD07 BIT 3,A       ; {Jump to #R$BD0D if the fire control is not pressed.
 $BD09 JR Z,$BD0D    ; }
 $BD0B SET 3,B       ; Set the bit for fire.
; Move up or down, but not past the edges.
@label=HandleCrosshair_MoveVertical
*$BD0D LD A,B        ; Fetch the controls.
 $BD0E AND %00000011 ; Keep the up and down bits.
 $BD10 JR Z,$BD23    ; Jump to #R$BD23 if neither or both are pressed.
 $BD12 CP $03        ; {Jump to #R$BD23 if both are pressed.
 $BD14 JR Z,$BD23    ; }
 $BD16 CP $01        ; {Jump to #R$BCC0 to move down if down is pressed.
 $BD18 JR Z,$BCC0    ; }
 $BD1A LD A,H        ; Fetch the vertical position.
 $BD1B ADD A,E       ; Add the speed.
 $BD1C CP $AD        ; {Jump to #R$BD22 if the crosshair is not past it.
 $BD1E JR C,$BD22    ; }
 $BD20 LD A,$AC      ; Stop at the upper limit.
; This entry point is used by the routine at #R$BCC0.
@label=HandleCrosshair_SetVertical
*$BD22 LD H,A        ; Set the vertical position.
; Store the new position.
@label=HandleCrosshair_SetPosition
*$BD23 LD (IX+$02),L ; Set the horizontal position of the crosshair.
 $BD26 LD (IX+$04),H ; Set the vertical position of the crosshair.
; Set the position for drawing.
 $BD29 LD A,H        ; {Fetch the vertical position and clear #REGh.
 $BD2A LD H,$00      ; }
 $BD2C LD ($A24E),HL ; Set #R$A24E.
 $BD2F LD L,A        ; Copy the vertical position into #REGl.
 $BD30 LD ($A250),HL ; Set #R$A250.
; Fire the revolver if the fire control is pressed, then draw the
; crosshair.
 $BD33 LD E,B        ; Pass the controls to the routine which fires the
                     ; revolver.
 $BD34 CALL $C9EC    ; Call #R$C9EC.
 $BD37 JP $BD69      ; Jump to #R$BD69.
; The controls are the keyboard, which sets the bits for down and up the
; other way round to the joysticks.
@label=HandleCrosshair_Keyboard
*$BD3A LD A,B        ; Fetch the controls.
 $BD3B LD B,$00      ; Clear #REGb.
 $BD3D BIT 2,A       ; {Jump to #R$BD43 if down is not pressed.
 $BD3F JR Z,$BD43    ; }
 $BD41 SET 0,B       ; Set the bit for down.
@label=HandleCrosshair_KeyboardTestUp
*$BD43 BIT 3,A       ; {Jump to #R$BD49 if up is not pressed.
 $BD45 JR Z,$BD49    ; }
 $BD47 SET 1,B       ; Set the bit for up.
@label=HandleCrosshair_KeyboardTestFire
*$BD49 BIT 4,A       ; {Jump to #R$BD4F if the fire control is not pressed.
 $BD4B JR Z,$BD4F    ; }
 $BD4D SET 3,B       ; Set the bit for fire.
; Move the crosshair up or down.
@label=HandleCrosshair_KeyboardMove
*$BD4F JP $BD0D      ; Jump to #R$BD0D.

; Draw Object
;
; Used by the routines at #R$B8E7, #R$B972, #R$B9DA and #R$C7C0.
; .
; Draws the sprites of an object which does not move with the town: the
; objects of the duel and the ones which stay in one place on the screen. The
; position of the object, which is a single byte for each direction, is where
; its sprites are drawn from. This routine also counts the object as drawn,
; which means that the stage is still running.
;
; IX The address of the object
@label=DrawObject
c$BD52 LD H,$00      ; Clear #REGh.
 $BD54 LD L,(IX+$02) ; Fetch the horizontal position of the object.
 $BD57 LD ($A24E),HL ; Set the horizontal position for drawing.
 $BD5A LD L,(IX+$04) ; Fetch the vertical position of the object.
 $BD5D LD ($A250),HL ; Set the vertical position for drawing.
 $BD60 JR $BD65      ; Jump to count the object and draw it.

; Draw Scrolling Object
;
; Used by the routine at #R$C1E7.
; .
; Draws the sprites of an object which is part of the town, where the
; position of the object has to be converted to a position on the screen.
;
; IX The address of the object
@label=DrawScrollingObject
c$BD62 CALL $C6C7    ; Work out the position of the object on the screen.
; This entry point is used by the routines at #R$BD52 and #R$C869.
@label=DrawScrollingObject_CountDrawn
*$BD65 LD HL,$A243   ; Point #REGhl at the count of objects drawn.
 $BD68 INC (HL)      ; Add one to it.
; Continue on to #R$BD69.

; Draw Sprite List
;
; Used by the routine at #R$BCCA.
; .
; Draws each sprite in the sprite list of an object. A sprite list is made
; of three bytes for each sprite: the horizontal offset, the vertical offset and
; the number of the sprite. The offsets are added to the position of the object,
; and the vertical offset of the object in byte #N$0D. A sprite which would
; start outside the screen is not drawn. The last byte of the list is #N$80.
;
; IX The address of the object
@label=DrawSpriteList
c$BD69 LD E,(IX+$0E)  ; {Fetch the address of the sprite list into #REGde.
 $BD6C LD D,(IX+$0F)  ; }
@label=DrawSpriteList_Next
*$BD6F LD A,(DE)      ; Fetch the horizontal offset of the sprite.
 $BD70 INC DE         ; Move on to the next byte.
 $BD71 CP $80         ; {Return if it is the terminator.
 $BD73 RET Z          ; }
 $BD74 LD HL,($A24E)  ; Fetch the horizontal position of the object.
 $BD77 CALL $D02C     ; Add the offset to it.
 $BD7A LD A,H         ; Fetch the high byte.
 $BD7B AND A          ; {Skip the sprite if its horizontal position is off the
 $BD7C JR NZ,$BDAA    ; screen.}
 $BD7E LD A,L         ; Fetch the low byte.
 $BD7F CP $CB         ; {Jump to #R$BDAA to skip the sprite if it is past it.
 $BD81 JR NC,$BDAA    ; }
 $BD83 CP $10         ; {Jump to #R$BDAA to skip the sprite if it is past it.
 $BD85 JR C,$BDAA     ; }
 $BD87 LD ($A220),A   ; Set the horizontal pixel position.
 $BD8A LD HL,($A250)  ; Fetch the vertical position of the object.
 $BD8D LD A,(DE)      ; Fetch the vertical offset of the sprite.
 $BD8E INC DE         ; Move on to the next byte.
 $BD8F ADD A,(IX+$0D) ; Add the vertical offset of the object.
 $BD92 CALL $D02C     ; Add the offset to the vertical position.
 $BD95 LD A,H         ; Fetch the high byte.
 $BD96 AND A          ; {Skip the sprite if its vertical position is off the
 $BD97 JR NZ,$BDAB    ; screen.}
 $BD99 LD A,L         ; Fetch the low byte.
 $BD9A CP $B8         ; {Jump to #R$BDAB to skip the sprite if it is past it.
 $BD9C JR NC,$BDAB    ; }
 $BD9E LD ($A221),A   ; Set the vertical pixel position.
 $BDA1 LD A,(DE)      ; Fetch the number of the sprite.
 $BDA2 INC DE         ; Move on to the next byte.
; Draw the sprite.
 $BDA3 PUSH DE        ; Stash the address in the list on the stack.
 $BDA4 CALL $BDAE     ; Call #R$BDAE.
 $BDA7 POP DE         ; Restore the address in the list from the stack.
; Go back for the next sprite.
 $BDA8 JR $BD6F       ; Jump to #R$BD6F.
; The sprite is off the screen horizontally, so skip the vertical
; offset as well.
@label=DrawSpriteList_Skip
*$BDAA INC DE         ; Skip the vertical offset.
; Skip the number of the sprite and go on to the next.
@label=DrawSpriteList_SkipSprite
*$BDAB INC DE         ; Skip the number of the sprite.
; Go back for the next sprite.
 $BDAC JR $BD6F       ; Jump to #R$BD6F.

; Draw Sprite
;
; Used by the routine at #R$BD69.
; .
; Draws a sprite into the buffer, which is the picture of the play area,
; with twenty four bytes in each of one hundred and twelve rows. The sprite data
; is a byte for the number of columns, a byte for the number of rows, and for
; each row, from the bottom to the top, a mask byte and a pixel byte for each
; column. The mask clears the bits under the sprite and the pixels are then
; added.
;
; A The number of the sprite
; IX The address of the object
;
; Bit 1 of #REGix+#N$07 is set to show that a sprite has been drawn. The
; sprite is shifted by the horizontal pixel position, which has to be even, and
; is flipped if bit 6 of the flags of the object is set. A shifted sprite is one
; byte wider, and the shifting is done by tables, which are built by #R$D4FD.
; The row of pixels is drawn by code for the right number of columns: the code
; was unrolled so that it can be fast, and the address in the jump at #R$A224 is
; set to the right place in it. The sprite data is taken off the stack. A sprite
; which is partly below the bottom or above the top of the play area has the
; rows which are outside it left out.
@label=DrawSprite
c$BDAE LD BC,$67F4    ; Point #REGbc at #R$67F4.
; Fetch the address of the sprite data.
 $BDB1 CALL $C75C     ; Call #R$C75C.
 $BDB4 EX DE,HL       ; Swap the address into #REGde.
 $BDB5 BIT 6,(IX+$07) ; {Jump to #R$BEF8 to draw the flipped sprite if the
 $BDB9 JP NZ,$BEF8    ; object is flipped.}
; Fetch the horizontal pixel position.
 $BDBC LD A,($A220)   ; Fetch #R$A220.
 $BDBF AND %00000110  ; Keep the shift, which is zero, two, four or six pixels.
; Draw the sprite unshifted.
 $BDC1 JP Z,$BE49     ; Jump to #R$BE49 if there is no shift.
 $BDC4 OR %11111000   ; Make the high byte of the address of the table for the
                      ; shift.
 $BDC6 LD H,A         ; Set #REGh.
 $BDC7 LD A,(DE)      ; Fetch the number of columns of the sprite.
 $BDC8 INC DE         ; Move on to the next byte.
 $BDC9 AND %00000111  ; Keep the low three bits.
 $BDCB INC A          ; Add one, as a shifted sprite is one byte wider.
 $BDCC LD B,A         ; Keep the widened column count in #REGb.
; Store the number of bytes in a row of the sprite.
 $BDCD LD ($A222),A   ; Set #R$A222.
 $BDD0 DEC A          ; Take one off again.
 $BDD1 AND %00000111  ; Keep the low three bits.
 $BDD3 ADD A,A        ; Double it.
 $BDD4 LD C,A         ; Keep twice the column count in #REGc.
 $BDD5 ADD A,A        ; {Multiply it by eight to make sixteen times the number
 $BDD6 ADD A,A        ; of columns.
 $BDD7 ADD A,A        ; }
 $BDD8 ADD A,C        ; Add the double to make eighteen times.
 $BDD9 NEG            ; Make it negative.
 $BDDB ADD A,$5D      ; Add #N$5D, which gives the distance from #R$BE87 to the code for the
                      ; number of columns. Each column has eighteen bytes of code.
@label=DrawSprite_SetJump
*$BDDD PUSH BC        ; Stash the number of columns on the stack.
 $BDDE PUSH HL        ; Stash the high byte of the shift table on the stack.
 $BDDF LD H,$00       ; Clear #REGh.
 $BDE1 AND A          ; Test the sign of the distance.
 $BDE2 JP P,$BDE6     ; Jump to #R$BDE6 if it is positive.
 $BDE5 DEC H          ; Make #REGhl negative.
@label=DrawSprite_SetJumpAddress
*$BDE6 LD L,A         ; Put the distance in #REGl.
 $BDE7 LD BC,$BE87    ; Point #REGbc at #R$BE87.
 $BDEA ADD HL,BC      ; Add the distance to give the address to jump to.
; Set the address of the jump at #R$A224.
 $BDEB LD ($A225),HL  ; Set #R$A225.
 $BDEE POP HL         ; Restore the shift table from the stack.
 $BDEF POP BC         ; Restore the number of bytes in a row from the stack.
 $BDF0 LD A,B         ; Fetch the number of bytes in a row.
 $BDF1 CPL            ; Invert it.
 $BDF2 ADD A,$1A      ; Add #N$1A, to give twenty five minus the number of
                      ; bytes.
; Store the distance from the end of a row to the start of the next.
 $BDF4 LD ($A227),A   ; Set #R$A227.
 $BDF7 EX DE,HL       ; Swap the address of the sprite data into #REGhl.
 $BDF8 LD C,$70       ; Set the number of rows in the buffer.
; Fetch the vertical position.
 $BDFA LD A,($A221)   ; Fetch #R$A221.
 $BDFD SUB $48        ; Subtract the position of the bottom row of the buffer.
 $BDFF JR C,$BE28     ; Jump to #R$BE28 if the sprite starts below it.
 $BE01 SUB C          ; Subtract the number of rows in the buffer.
 $BE02 RET NC         ; Return if the sprite starts above the top.
 $BE03 NEG            ; Make it positive, which is the number of rows up to the
                      ; top.
 $BE05 CP (HL)        ; Compare it with the number of rows in the sprite.
 $BE06 JR C,$BE09     ; Jump to #R$BE09 if there is room for fewer rows.
 $BE08 LD A,(HL)      ; Use the number of rows in the sprite.
@label=DrawSprite_FirstByte
*$BE09 INC HL         ; Move on to the first byte of data.
; Store the number of rows to draw.
 $BE0A LD ($A223),A   ; Set #R$A223.
@label=DrawSprite_StartRows
*$BE0D EX DE,HL       ; Swap the address of the data into #REGde.
 $BE0E PUSH HL        ; Stash the high byte of the shift table on the stack.
; Fetch the pixel position.
 $BE0F LD HL,($A220)  ; Fetch #R$A220.
; Find the address in the buffer.
 $BE12 CALL $D233     ; Call #R$D233.
 $BE15 LD C,L         ; {Keep the buffer address in #REGbc.
 $BE16 LD B,H         ; }
 $BE17 POP HL         ; Restore the shift table from the stack.
; Save the stack pointer.
 $BE18 LD ($A21D),SP  ; Set #R$A21D.
 $BE1C EX DE,HL       ; {Point the stack pointer at the sprite data.
 $BE1D LD SP,HL       ;
 $BE1E EX DE,HL       ; }
 $BE1F SET 1,(IX+$07) ; Set the flag which shows that a sprite has been drawn.
; Fetch the number of rows to draw.
 $BE23 LD A,($A223)   ; Fetch #R$A223.
; Draw the first row.
 $BE26 JR $BE85       ; Jump to #R$BE85.
@label=DrawSprite_Below
*$BE28 NEG            ; Make the number of rows below the bottom positive.
 $BE2A LD C,A         ; Keep the rows below the bottom of the sprite in #REGc.
 $BE2B LD A,(HL)      ; Fetch the number of rows in the sprite.
 $BE2C SUB C          ; Subtract the number below the bottom.
 $BE2D RET M          ; Return if the sprite is all below the bottom.
 $BE2E RET Z          ; Return if there is nothing left.
; Store the number of rows to draw.
 $BE2F LD ($A223),A   ; Set #R$A223.
 $BE32 LD B,$00       ; Clear #REGb.
 $BE34 DEC HL         ; Move back to the first byte of the sprite data.
 $BE35 LD A,(HL)      ; Fetch the number of columns.
 $BE36 AND %00111111  ; Keep the number of columns.
 $BE38 INC HL         ; {Move on to the data.
 $BE39 INC HL         ; }
 $BE3A SLA C          ; {Double the number of rows to skip.
 $BE3C RL B           ; }
@label=DrawSprite_SkipRows
*$BE3E ADD HL,BC      ; {Skip two bytes for each row below the bottom in each
 $BE3F DEC A          ; column.
 $BE40 JR NZ,$BE3E    ; }
; Start drawing at the bottom of the buffer.
 $BE42 LD A,$48       ; {Set #R$A221 to the bottom of the buffer.
 $BE44 LD ($A221),A   ; }
; Start the rows.
 $BE47 JR $BE0D       ; Jump to #R$BE0D.
@label=DrawSprite_Aligned
*$BE49 LD A,(DE)      ; Fetch the number of columns of the sprite.
 $BE4A INC DE         ; Move on to the next byte.
 $BE4B AND %00001111  ; Keep the low four bits.
; Store the number of bytes in a row of the sprite.
 $BE4D LD ($A222),A   ; Set #R$A222.
 $BE50 LD B,A         ; Keep the bytes in a row in #REGb.
 $BE51 ADD A,A        ; {Multiply it by eight.
 $BE52 ADD A,A        ;
 $BE53 ADD A,A        ; }
 $BE54 NEG            ; Make it negative.
 $BE56 SUB $04        ; Subtract four, which gives the distance from #R$BE87 to the code for
                      ; the number of columns. Each column has eight bytes of code.
; Set the address of the jump.
 $BE58 JP $BDDD       ; Jump to #R$BDDD.

; Draw Aligned Columns
;
; Draws the columns of a sprite which is not shifted or flipped. There is
; a piece of code for each of up to five columns, and the code for the width of
; the sprite is where the jump at #R$A224 starts. Each piece takes the mask and
; the pixels for one byte of the row from the sprite data on the stack, wipes
; the screen where the mask is and puts the pixels in. The buffer address is in
; #REGbc.
@label=DrawAlignedColumns
c$BE5B POP DE        ; Fetch the mask into #REGe and the pixels into #REGd.
 $BE5C LD A,(BC)     ; {Clear the screen bits under the mask.
 $BE5D CPL           ;
 $BE5E OR E          ;
 $BE5F CPL           ; }
 $BE60 OR D          ; Add the pixels.
 $BE61 LD (BC),A     ; {Store the byte and move on to the next.
 $BE62 INC BC        ; }
 $BE63 POP DE        ; Fetch the mask into #REGe and the pixels into #REGd.
 $BE64 LD A,(BC)     ; {Clear the screen bits under the mask.
 $BE65 CPL           ;
 $BE66 OR E          ;
 $BE67 CPL           ; }
 $BE68 OR D          ; Add the pixels.
 $BE69 LD (BC),A     ; {Store the byte and move on to the next.
 $BE6A INC BC        ; }
 $BE6B POP DE        ; Fetch the mask into #REGe and the pixels into #REGd.
 $BE6C LD A,(BC)     ; {Clear the screen bits under the mask.
 $BE6D CPL           ;
 $BE6E OR E          ;
 $BE6F CPL           ; }
 $BE70 OR D          ; Add the pixels.
 $BE71 LD (BC),A     ; {Store the byte and move on to the next.
 $BE72 INC BC        ; }
 $BE73 POP DE        ; Fetch the mask into #REGe and the pixels into #REGd.
 $BE74 LD A,(BC)     ; {Clear the screen bits under the mask.
 $BE75 CPL           ;
 $BE76 OR E          ;
 $BE77 CPL           ; }
 $BE78 OR D          ; Add the pixels.
 $BE79 LD (BC),A     ; {Store the byte and move on to the next.
 $BE7A INC BC        ; }
 $BE7B POP DE        ; Fetch the mask into #REGe and the pixels into #REGd.
 $BE7C LD A,(BC)     ; {Clear the screen bits under the mask.
 $BE7D CPL           ;
 $BE7E OR E          ;
 $BE7F CPL           ; }
 $BE80 OR D          ; Add the pixels.
 $BE81 LD (BC),A     ; Store the byte.
; Finish the row.
 $BE82 JP $BEE5      ; Jump to #R$BEE5.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$D08F }
; { #KNIGHTLORE$D780 }
; { #NIGHTSHADE$E49F }
; { #PENTAGRAM$B44F }
; LIST#

; Draw Sprite Row
;
; Used by the routines at #R$BDAE and #R$BEE5.
; .
; Starts to draw a row of a sprite. The number of rows left is kept in the
; alternate accumulator while the code for the columns uses #REGa. The jump at
; #R$A224 goes to the code for the columns of the sprite.
@label=DrawSpriteRow
c$BE85 EX AF,AF'     ; Save the number of rows left, and get #REGa.
 $BE86 LD A,(BC)     ; Fetch the first byte of the row from the buffer.
; Jump to the code for the columns.
@label=DrawSprite_Jump
 $BE87 JP $A224      ; Jump to #R$A224.

; Draw Shifted Columns
;
; Draws the columns of a sprite which is shifted to the right by two, four
; or six pixels. There is a piece of code for each of up to five columns of the
; sprite, and the code for the width of the sprite is where the jump at #R$A224
; starts. Each piece puts a column into two bytes of the buffer, using the table
; for the shift to split the mask and the pixels in two. The buffer address is
; in #REGbc.
;
; .
;
; The jump at #R$A224 starts here for five columns.
@label=DrawShiftedColumns
c$BE8A CPL           ; {Invert the screen byte, and fetch the mask into #REGe and the pixels
 $BE8B POP DE        ; into #REGd.}
 $BE8C LD L,E        ; {Clear the screen bits under the part of the mask which is in this
 $BE8D OR (HL)       ; byte.
 $BE8E CPL           ; }
 $BE8F LD L,D        ; {Add the part of the pixels which is in this byte.
 $BE90 OR (HL)       ; }
 $BE91 LD (BC),A     ; {Store the byte and move on to the next.
 $BE92 INC BC        ; }
 $BE93 INC H         ; {Point #REGh at the table for the bits which move into the next byte,
 $BE94 LD L,E        ; and fetch that screen byte.
 $BE95 LD A,(BC)     ; }
 $BE96 CPL           ; {Clear the screen bits under the part of the mask which has moved
 $BE97 OR (HL)       ; into it.
 $BE98 CPL           ; }
 $BE99 LD L,D        ; {Add the part of the pixels which has moved into it.
 $BE9A OR (HL)       ; }
 $BE9B DEC H         ; Point #REGh back at the first table.
; The jump at #R$A224 starts here for four columns.
 $BE9C CPL           ; {Invert the screen byte, and fetch the mask into #REGe and the pixels
 $BE9D POP DE        ; into #REGd.}
 $BE9E LD L,E        ; {Clear the screen bits under the part of the mask which is in this
 $BE9F OR (HL)       ; byte.
 $BEA0 CPL           ; }
 $BEA1 LD L,D        ; {Add the part of the pixels which is in this byte.
 $BEA2 OR (HL)       ; }
 $BEA3 LD (BC),A     ; {Store the byte and move on to the next.
 $BEA4 INC BC        ; }
 $BEA5 INC H         ; {Point #REGh at the table for the bits which move into the next byte,
 $BEA6 LD L,E        ; and fetch that screen byte.
 $BEA7 LD A,(BC)     ; }
 $BEA8 CPL           ; {Clear the screen bits under the part of the mask which has moved
 $BEA9 OR (HL)       ; into it.
 $BEAA CPL           ; }
 $BEAB LD L,D        ; {Add the part of the pixels which has moved into it.
 $BEAC OR (HL)       ; }
 $BEAD DEC H         ; Point #REGh back at the first table.
; The jump at #R$A224 starts here for three columns.
 $BEAE CPL           ; {Invert the screen byte, and fetch the mask into #REGe and the pixels
 $BEAF POP DE        ; into #REGd.}
 $BEB0 LD L,E        ; {Clear the screen bits under the part of the mask which is in this
 $BEB1 OR (HL)       ; byte.
 $BEB2 CPL           ; }
 $BEB3 LD L,D        ; {Add the part of the pixels which is in this byte.
 $BEB4 OR (HL)       ; }
 $BEB5 LD (BC),A     ; {Store the byte and move on to the next.
 $BEB6 INC BC        ; }
 $BEB7 INC H         ; {Point #REGh at the table for the bits which move into the next byte,
 $BEB8 LD L,E        ; and fetch that screen byte.
 $BEB9 LD A,(BC)     ; }
 $BEBA CPL           ; {Clear the screen bits under the part of the mask which has moved
 $BEBB OR (HL)       ; into it.
 $BEBC CPL           ; }
 $BEBD LD L,D        ; {Add the part of the pixels which has moved into it.
 $BEBE OR (HL)       ; }
 $BEBF DEC H         ; Point #REGh back at the first table.
; The jump at #R$A224 starts here for two columns.
 $BEC0 CPL           ; {Invert the screen byte, and fetch the mask into #REGe and the pixels
 $BEC1 POP DE        ; into #REGd.}
 $BEC2 LD L,E        ; {Clear the screen bits under the part of the mask which is in this
 $BEC3 OR (HL)       ; byte.
 $BEC4 CPL           ; }
 $BEC5 LD L,D        ; {Add the part of the pixels which is in this byte.
 $BEC6 OR (HL)       ; }
 $BEC7 LD (BC),A     ; {Store the byte and move on to the next.
 $BEC8 INC BC        ; }
 $BEC9 INC H         ; {Point #REGh at the table for the bits which move into the next byte,
 $BECA LD L,E        ; and fetch that screen byte.
 $BECB LD A,(BC)     ; }
 $BECC CPL           ; {Clear the screen bits under the part of the mask which has moved
 $BECD OR (HL)       ; into it.
 $BECE CPL           ; }
 $BECF LD L,D        ; {Add the part of the pixels which has moved into it.
 $BED0 OR (HL)       ; }
 $BED1 DEC H         ; Point #REGh back at the first table.
; The jump at #R$A224 starts here for one column.
 $BED2 CPL           ; {Invert the screen byte, and fetch the mask into #REGe and the pixels
 $BED3 POP DE        ; into #REGd.}
 $BED4 LD L,E        ; {Clear the screen bits under the part of the mask which is in this
 $BED5 OR (HL)       ; byte.
 $BED6 CPL           ; }
 $BED7 LD L,D        ; {Add the part of the pixels which is in this byte.
 $BED8 OR (HL)       ; }
 $BED9 LD (BC),A     ; {Store the byte and move on to the next.
 $BEDA INC BC        ; }
 $BEDB INC H         ; {Point #REGh at the table for the bits which move into the next byte,
 $BEDC LD L,E        ; and fetch that screen byte.
 $BEDD LD A,(BC)     ; }
 $BEDE CPL           ; {Clear the screen bits under the part of the mask which has moved
 $BEDF OR (HL)       ; into it.
 $BEE0 CPL           ; }
 $BEE1 LD L,D        ; {Add the part of the pixels which has moved into it.
 $BEE2 OR (HL)       ; }
 $BEE3 DEC H         ; Point #REGh back at the first table.
 $BEE4 LD (BC),A     ; Store the last byte of the row.
; Continue on to #R$BEE5.
; .
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$E4CD }
; LIST#

; Finish Sprite Row
;
; Used by the routines at #R$BE5B and #R$BFA3.
; .
; Moves to the next row of the buffer after a row of a sprite has been
; drawn, and starts the next row if there are any left.
@label=FinishSpriteRow
c$BEE5 LD A,($A227)  ; Fetch the distance from #R$A227 to the start of the next
                     ; row.
 $BEE8 ADD A,C       ; Add it to the low byte of the buffer address.
 $BEE9 LD C,A        ; Set the low byte.
 $BEEA LD A,B        ; Fetch the high byte.
 $BEEB ADC A,$00     ; Add the carry.
 $BEED LD B,A        ; Set the high byte.
 $BEEE EX AF,AF'     ; Fetch the number of rows left.
 $BEEF DEC A         ; Take one off.
; Draw the next row if there are any left.
 $BEF0 JP NZ,$BE85   ; Jump to #R$BE85 if there are any.
 $BEF3 LD SP,($A21D) ; Restore the stack pointer.
 $BEF7 RET           ; Return.

; Draw Flipped Sprite
;
; Used by the routine at #R$BDAE.
; .
; Draws a sprite which is flipped, so that it faces the other way. It
; works in the same way as #R$BDAE, but it draws from the right-hand end of each
; row to the left, and the tables turn the bits of each byte round as well as
; shifting them.
;
; DE The address of the sprite data
; IX The address of the object
;
; Fetch the horizontal pixel position.
@label=DrawFlippedSprite
c$BEF8 LD A,($A220)   ; Fetch #R$A220.
 $BEFB AND %00000110  ; Keep the shift, which is zero, two, four or six pixels.
; Draw the sprite unshifted.
 $BEFD JP Z,$BF8D     ; Jump to #R$BF8D if there is no shift.
 $BF00 OR %11110001   ; Make the high byte of the address of the table for the
                      ; shift.
 $BF02 LD H,A         ; Set #REGh.
 $BF03 LD A,(DE)      ; Fetch the number of columns of the sprite.
 $BF04 INC DE         ; Move on to the next byte.
 $BF05 AND %00000111  ; Keep the low three bits.
 $BF07 INC A          ; Add one, as a shifted sprite is one byte wider.
 $BF08 LD B,A         ; Keep the widened column count in #REGb.
; Store the number of bytes in a row of the sprite.
 $BF09 LD ($A222),A   ; Set #R$A222.
 $BF0C DEC A          ; Take one off again.
 $BF0D AND %00000111  ; Keep the low three bits.
 $BF0F ADD A,A        ; Double it.
 $BF10 LD C,A         ; Keep twice the column count in #REGc.
 $BF11 ADD A,A        ; {Multiply it by eight to make sixteen times the number
 $BF12 ADD A,A        ; of columns.
 $BF13 ADD A,A        ; }
 $BF14 ADD A,C        ; Add the double to make eighteen times.
 $BF15 NEG            ; Make it negative.
 $BF17 ADD A,$5D      ; Add #N$5D, which gives the distance from #R$BFD8 to the code for the
                      ; number of columns. Each column has eighteen bytes of code.
@label=DrawFlippedSprite_SetJump
*$BF19 PUSH BC        ; Stash the number of columns on the stack.
 $BF1A PUSH HL        ; Stash the high byte of the shift table on the stack.
 $BF1B LD H,$00       ; Clear #REGh.
 $BF1D AND A          ; {Jump to #R$BF22 if the distance is positive.
 $BF1E JP P,$BF22     ; }
 $BF21 DEC H          ; Make #REGhl negative.
@label=DrawFlippedSprite_SetJumpAddress
*$BF22 LD L,A         ; Put the distance in #REGl.
 $BF23 LD BC,$BFD8    ; Point #REGbc at #R$BFD8.
 $BF26 ADD HL,BC      ; Add the distance to give the address to jump to.
; Set the address of the jump at #R$A224.
 $BF27 LD ($A225),HL  ; Set #R$A225.
 $BF2A POP HL         ; Restore the shift table from the stack.
 $BF2B POP BC         ; Restore the number of bytes in a row from the stack.
 $BF2C LD A,B         ; Fetch the number of bytes in a row.
 $BF2D ADD A,$17      ; Add #N$17, to give twenty three more than the number of
                      ; bytes.
; Store the distance from the end of a row to the start of the next.
 $BF2F LD ($A227),A   ; Set #R$A227.
 $BF32 EX DE,HL       ; Swap the address of the sprite data into #REGhl.
 $BF33 LD C,$70       ; Set the number of rows in the buffer.
; Fetch the vertical position.
 $BF35 LD A,($A221)   ; Fetch #R$A221.
 $BF38 SUB $48        ; Subtract the position of the bottom row of the buffer.
 $BF3A JR C,$BF6C     ; Jump to #R$BF6C if the sprite starts below it.
 $BF3C SUB C          ; Subtract the number of rows in the buffer.
 $BF3D RET NC         ; Return if the sprite starts above the top.
 $BF3E NEG            ; Make it positive, which is the number of rows up to the
                      ; top.
 $BF40 CP (HL)        ; Compare it with the number of rows in the sprite.
 $BF41 JR C,$BF44     ; Jump to #R$BF44 if there is room for fewer rows.
 $BF43 LD A,(HL)      ; Use the number of rows in the sprite.
@label=DrawFlippedSprite_FirstByte
*$BF44 INC HL         ; Move on to the first byte of data.
; Store the number of rows to draw.
 $BF45 LD ($A223),A   ; Set #R$A223.
@label=DrawFlippedSprite_StartRows
*$BF48 EX DE,HL       ; Swap the address of the data into #REGde.
 $BF49 PUSH HL        ; Stash the high byte of the shift table on the stack.
; Fetch the pixel position.
 $BF4A LD HL,($A220)  ; Fetch #R$A220.
; Fetch the number of bytes in a row.
 $BF4D LD A,($A222)   ; Fetch #R$A222.
 $BF50 DEC A          ; Take one off.
 $BF51 ADD A,A        ; {Multiply it by eight to give the pixels in all but one of the
 $BF52 ADD A,A        ; columns.
 $BF53 ADD A,A        ; }
 $BF54 ADD A,L        ; Add it to the horizontal position, to give the right-hand end of the
                      ; row.
 $BF55 LD L,A         ; Set it in #REGl.
; Find the address in the buffer.
 $BF56 CALL $D233     ; Call #R$D233.
 $BF59 LD C,L         ; {Keep the buffer address in #REGbc.
 $BF5A LD B,H         ; }
 $BF5B POP HL         ; Restore the shift table from the stack.
; Save the stack pointer.
 $BF5C LD ($A21D),SP  ; Set #R$A21D.
 $BF60 EX DE,HL       ; {Point the stack pointer at the sprite data.
 $BF61 LD SP,HL       ;
 $BF62 EX DE,HL       ; }
 $BF63 SET 1,(IX+$07) ; Set the flag which shows that a sprite has been drawn.
; Fetch the number of rows to draw.
 $BF67 LD A,($A223)   ; Fetch #R$A223.
; Draw the first row.
 $BF6A JR $BFD6       ; Jump to #R$BFD6.
; The sprite starts below the bottom of the buffer, so skip those
; rows.
@label=DrawFlippedSprite_BelowBottom
*$BF6C NEG            ; Make the number of rows below the bottom positive.
 $BF6E LD C,A         ; Keep the rows below the bottom of the sprite in #REGc.
 $BF6F LD A,(HL)      ; Fetch the number of rows in the sprite.
 $BF70 SUB C          ; Subtract the number below the bottom.
 $BF71 RET M          ; Return if the sprite is all below the bottom.
 $BF72 RET Z          ; Return if there is nothing left.
; Store the number of rows to draw.
 $BF73 LD ($A223),A   ; Set #R$A223.
 $BF76 LD B,$00       ; Clear #REGb.
 $BF78 DEC HL         ; Move back to the first byte of the sprite data.
 $BF79 LD A,(HL)      ; Fetch the first byte of the sprite.
 $BF7A AND %00111111  ; Keep only the number of columns.
 $BF7C INC HL         ; {Move on to the data.
 $BF7D INC HL         ; }
 $BF7E SLA C          ; {Double the number of rows to skip.
 $BF80 RL B           ; }
@label=DrawFlippedSprite_SkipRows
*$BF82 ADD HL,BC      ; {Skip two bytes for each row below the bottom in each
 $BF83 DEC A          ; column.
 $BF84 JR NZ,$BF82    ; }
; Start drawing at the bottom of the buffer.
 $BF86 LD A,$48       ; {Set #R$A221 to the bottom of the buffer.
 $BF88 LD ($A221),A   ; }
; Start the rows.
 $BF8B JR $BF48       ; Jump to #R$BF48.
@label=DrawFlippedSprite_Aligned
*$BF8D LD H,$F9       ; Point #REGh at the table which only turns the bits
                      ; round.
 $BF8F LD A,(DE)      ; Fetch the number of columns of the sprite.
 $BF90 INC DE         ; Move on to the next byte.
 $BF91 AND %00001111  ; Keep the low four bits.
; Store the number of bytes in a row of the sprite.
 $BF93 LD ($A222),A   ; Set #R$A222.
 $BF96 LD B,A         ; Keep the bytes in a row in #REGb.
 $BF97 ADD A,A        ; {Multiply it by eight.
 $BF98 ADD A,A        ;
 $BF99 ADD A,A        ; }
 $BF9A ADD A,B        ; {Add it twice more to make ten times the number of
 $BF9B ADD A,B        ; columns.}
 $BF9C NEG            ; Make it negative.
 $BF9E SUB $03        ; Subtract three, which gives the distance from #R$BFD8 to the code
                      ; for the number of columns. Each column has ten bytes of code.
; Set the address of the jump.
 $BFA0 JP $BF19       ; Jump to #R$BF19.

; Draw Flipped Aligned Columns
;
; Draws the columns of a sprite which is flipped but not shifted. There is
; a piece of code for each of up to five columns, and the code for the width of
; the sprite is where the jump at #R$A224 starts. Each piece takes the mask and
; the pixels for one byte from the sprite data on the stack, turns them round
; with the table, wipes the screen where the mask is and puts the pixels in. It
; works from right to left.
;
; .
;
; The jump at #R$A224 starts here for five columns.
@label=DrawFlippedAlignedColumns
c$BFA3 POP DE        ; Restore the mask into #REGe and the pixels into #REGd
                     ; from the stack.
 $BFA4 LD L,E        ; {Turn the mask round and clear the screen bits under it.
 $BFA5 CPL           ;
 $BFA6 OR (HL)       ;
 $BFA7 CPL           ; }
 $BFA8 LD L,D        ; {Turn the pixels round and add them.
 $BFA9 OR (HL)       ; }
 $BFAA LD (BC),A     ; {Store the byte, move to the byte on the left and fetch
 $BFAB DEC BC        ; it.
 $BFAC LD A,(BC)     ; }
; The jump at #R$A224 starts here for four columns.
 $BFAD POP DE        ; Restore the mask into #REGe and the pixels into #REGd
                     ; from the stack.
 $BFAE LD L,E        ; {Turn the mask round and clear the screen bits under it.
 $BFAF CPL           ;
 $BFB0 OR (HL)       ;
 $BFB1 CPL           ; }
 $BFB2 LD L,D        ; {Turn the pixels round and add them.
 $BFB3 OR (HL)       ; }
 $BFB4 LD (BC),A     ; {Store the byte, move to the byte on the left and fetch
 $BFB5 DEC BC        ; it.
 $BFB6 LD A,(BC)     ; }
; The jump at #R$A224 starts here for three columns.
 $BFB7 POP DE        ; Restore the mask into #REGe and the pixels into #REGd
                     ; from the stack.
 $BFB8 LD L,E        ; {Turn the mask round and clear the screen bits under it.
 $BFB9 CPL           ;
 $BFBA OR (HL)       ;
 $BFBB CPL           ; }
 $BFBC LD L,D        ; {Turn the pixels round and add them.
 $BFBD OR (HL)       ; }
 $BFBE LD (BC),A     ; {Store the byte, move to the byte on the left and fetch
 $BFBF DEC BC        ; it.
 $BFC0 LD A,(BC)     ; }
; The jump at #R$A224 starts here for two columns.
 $BFC1 POP DE        ; Restore the mask into #REGe and the pixels into #REGd
                     ; from the stack.
 $BFC2 LD L,E        ; {Turn the mask round and clear the screen bits under it.
 $BFC3 CPL           ;
 $BFC4 OR (HL)       ;
 $BFC5 CPL           ; }
 $BFC6 LD L,D        ; {Turn the pixels round and add them.
 $BFC7 OR (HL)       ; }
 $BFC8 LD (BC),A     ; {Store the byte, move to the byte on the left and fetch
 $BFC9 DEC BC        ; it.
 $BFCA LD A,(BC)     ; }
; The jump at #R$A224 starts here for one column.
 $BFCB POP DE        ; Restore the mask into #REGe and the pixels into #REGd
                     ; from the stack.
 $BFCC LD L,E        ; {Turn the mask round and clear the screen bits under it.
 $BFCD CPL           ;
 $BFCE OR (HL)       ;
 $BFCF CPL           ; }
 $BFD0 LD L,D        ; {Turn the pixels round and add them.
 $BFD1 OR (HL)       ; }
 $BFD2 LD (BC),A     ; Store the byte.
; Finish the row.
 $BFD3 JP $BEE5      ; Jump to #R$BEE5.

; Draw Flipped Row
;
; Used by the routines at #R$BEF8 and #R$C036.
; .
; Starts to draw a row of a flipped sprite. The number of rows left is
; kept in the alternate accumulator while the code for the columns uses #REGa.
; The jump at #R$A224 goes to the code for the columns of the sprite.
@label=DrawFlippedRow
c$BFD6 EX AF,AF'     ; Save the number of rows left, and get #REGa.
 $BFD7 LD A,(BC)     ; Fetch the first byte of the row from the buffer.
; Jump to the code for the columns.
@label=DrawFlipped_SpriteJump
 $BFD8 JP $A224      ; Jump to #R$A224.

; Draw Flipped Shifted Columns
;
; Draws the columns of a sprite which is flipped and shifted. There is a
; piece of code for each of up to five columns of the sprite, and the code for
; the width of the sprite is where the jump at #R$A224 starts. Each piece puts a
; column into two bytes of the buffer, using the table for the shift to turn the
; mask and the pixels round and split them in two. It works from right to left.
;
; .
;
; The jump at #R$A224 starts here for five columns.
@label=DrawFlippedShiftedColumns
c$BFDB CPL           ; Invert the screen byte.
 $BFDC POP DE        ; Restore the mask into #REGe and the pixels into #REGd
                     ; from the stack.
 $BFDD LD L,E        ; {Clear the screen bits under the part of the mask which is in this
 $BFDE OR (HL)       ; byte.
 $BFDF CPL           ; }
 $BFE0 LD L,D        ; {Add the part of the pixels which is in this byte.
 $BFE1 OR (HL)       ; }
 $BFE2 LD (BC),A     ; {Store the byte and move on to the byte on the left.
 $BFE3 DEC BC        ; }
 $BFE4 DEC H         ; {Point #REGh at the table for the bits which move into the next byte,
 $BFE5 LD L,E        ; and fetch that screen byte.
 $BFE6 LD A,(BC)     ; }
 $BFE7 CPL           ; {Clear the screen bits under the part of the mask which has moved
 $BFE8 OR (HL)       ; into it.
 $BFE9 CPL           ; }
 $BFEA LD L,D        ; {Add the part of the pixels which has moved into it.
 $BFEB OR (HL)       ; }
 $BFEC INC H         ; Point #REGh back at the first table.
; The jump at #R$A224 starts here for four columns.
 $BFED CPL           ; Invert the screen byte.
 $BFEE POP DE        ; Restore the mask into #REGe and the pixels into #REGd
                     ; from the stack.
 $BFEF LD L,E        ; {Clear the screen bits under the part of the mask which is in this
 $BFF0 OR (HL)       ; byte.
 $BFF1 CPL           ; }
 $BFF2 LD L,D        ; {Add the part of the pixels which is in this byte.
 $BFF3 OR (HL)       ; }
 $BFF4 LD (BC),A     ; {Store the byte and move on to the byte on the left.
 $BFF5 DEC BC        ; }
 $BFF6 DEC H         ; {Point #REGh at the table for the bits which move into the next byte,
 $BFF7 LD L,E        ; and fetch that screen byte.
 $BFF8 LD A,(BC)     ; }
 $BFF9 CPL           ; {Clear the screen bits under the part of the mask which has moved
 $BFFA OR (HL)       ; into it.
 $BFFB CPL           ; }
 $BFFC LD L,D        ; {Add the part of the pixels which has moved into it.
 $BFFD OR (HL)       ; }
 $BFFE INC H         ; Point #REGh back at the first table.
; The jump at #R$A224 starts here for three columns.
 $BFFF CPL           ; Invert the screen byte.
 $C000 POP DE        ; Restore the mask into #REGe and the pixels into #REGd
                     ; from the stack.
 $C001 LD L,E        ; {Clear the screen bits under the part of the mask which is in this
 $C002 OR (HL)       ; byte.
 $C003 CPL           ; }
 $C004 LD L,D        ; {Add the part of the pixels which is in this byte.
 $C005 OR (HL)       ; }
 $C006 LD (BC),A     ; {Store the byte and move on to the byte on the left.
 $C007 DEC BC        ; }
 $C008 DEC H         ; {Point #REGh at the table for the bits which move into the next byte,
 $C009 LD L,E        ; and fetch that screen byte.
 $C00A LD A,(BC)     ; }
 $C00B CPL           ; {Clear the screen bits under the part of the mask which has moved
 $C00C OR (HL)       ; into it.
 $C00D CPL           ; }
 $C00E LD L,D        ; {Add the part of the pixels which has moved into it.
 $C00F OR (HL)       ; }
 $C010 INC H         ; Point #REGh back at the first table.
; The jump at #R$A224 starts here for two columns.
 $C011 CPL           ; Invert the screen byte.
 $C012 POP DE        ; Restore the mask into #REGe and the pixels into #REGd
                     ; from the stack.
 $C013 LD L,E        ; {Clear the screen bits under the part of the mask which is in this
 $C014 OR (HL)       ; byte.
 $C015 CPL           ; }
 $C016 LD L,D        ; {Add the part of the pixels which is in this byte.
 $C017 OR (HL)       ; }
 $C018 LD (BC),A     ; {Store the byte and move on to the byte on the left.
 $C019 DEC BC        ; }
 $C01A DEC H         ; {Point #REGh at the table for the bits which move into the next byte,
 $C01B LD L,E        ; and fetch that screen byte.
 $C01C LD A,(BC)     ; }
 $C01D CPL           ; {Clear the screen bits under the part of the mask which has moved
 $C01E OR (HL)       ; into it.
 $C01F CPL           ; }
 $C020 LD L,D        ; {Add the part of the pixels which has moved into it.
 $C021 OR (HL)       ; }
 $C022 INC H         ; Point #REGh back at the first table.
; The jump at #R$A224 starts here for one column.
 $C023 CPL           ; Invert the screen byte.
 $C024 POP DE        ; Restore the mask into #REGe and the pixels into #REGd
                     ; from the stack.
 $C025 LD L,E        ; {Clear the screen bits under the part of the mask which is in this
 $C026 OR (HL)       ; byte.
 $C027 CPL           ; }
 $C028 LD L,D        ; {Add the part of the pixels which is in this byte.
 $C029 OR (HL)       ; }
 $C02A LD (BC),A     ; {Store the byte and move on to the byte on the left.
 $C02B DEC BC        ; }
 $C02C DEC H         ; {Point #REGh at the table for the bits which move into the next byte,
 $C02D LD L,E        ; and fetch that screen byte.
 $C02E LD A,(BC)     ; }
 $C02F CPL           ; {Clear the screen bits under the part of the mask which has moved
 $C030 OR (HL)       ; into it.
 $C031 CPL           ; }
 $C032 LD L,D        ; {Add the part of the pixels which has moved into it.
 $C033 OR (HL)       ; }
 $C034 INC H         ; Point #REGh back at the first table.
 $C035 LD (BC),A     ; Store the last byte of the row.
; Continue on to #R$C036.

; Finish Flipped Sprite Row
;
; Moves to the next row of the buffer after a row of a flipped sprite has
; been drawn, and starts the next row if there are any left.
@label=FinishFlippedSpriteRow
c$C036 LD A,($A227)  ; Fetch the distance from #R$A227 to the start of the next
                     ; row.
 $C039 ADD A,C       ; Add it to the low byte of the buffer address.
 $C03A LD C,A        ; Set the low byte.
 $C03B LD A,B        ; Fetch the high byte.
 $C03C ADC A,$00     ; Add the carry.
 $C03E LD B,A        ; Set the high byte.
 $C03F EX AF,AF'     ; Fetch the number of rows left.
 $C040 DEC A         ; Take one off.
; Draw the next row if there are any left.
 $C041 JP NZ,$BFD6   ; Jump to #R$BFD6 if there are any.
 $C044 LD SP,($A21D) ; Restore the stack pointer.
 $C048 RET           ; Return.

; Check Sheriff Lost
;
; Used by the routine at #R$A36D.
; .
; Called every frame. If #R$A27D, which holds the sheriff, and #R$A35D,
; which holds the crosshair, are both empty, then a stage is starting or the
; sheriff has been lost. The routine takes a life away. When there is no life
; left it shows "GAME OVER" and works out the top score, or if there are two
; players it moves on to the other player. Otherwise it makes the sheriff
; arrive in the town, or the crosshair in the duel and the bonus stage.
;
; .
;
; Fetch the type of the first object slot.
@label=CheckSheriffLost
c$C049 LD A,($A27D)  ; {Fetch #R$A27D and keep it in #REGc.
 $C04C LD C,A        ; }
; Fetch the type of the last object slot.
 $C04D LD A,($A35D)  ; Fetch #R$A35D.
 $C050 OR C          ; {Return if either of the slots is in use.
 $C051 RET NZ        ; }
; Clear the delay before the next shot.
 $C052 LD ($A245),A  ; Set #R$A245.
; Clear the flag which shows that the revolver is being reloaded.
 $C055 LD ($A246),A  ; Set #R$A246.
; Fetch the options.
 $C058 LD A,($A21C)  ; Fetch #R$A21C.
; See whether there are two players.
 $C05B BIT 0,A       ; {Jump to #R$C084 if there are.
 $C05D JR NZ,$C084   ; }
; See #POKE(infinite_lives,Infinite Lives).
@label=CheckSheriffLost_TakeLife
*$C05F LD HL,$A263   ; Point #REGhl at #R$A263.
 $C062 DEC (HL)      ; Take one off.
; There are no lives left.
 $C063 JP M,$C0B6    ; Jump to #R$C0B6 if there are none.
; Clear the flag that a stage is starting.
 $C066 XOR A         ; {Write #N$00 to #R$A240.
 $C067 LD ($A240),A  ; }
; Fetch the kind of stage.
 $C06A LD A,($A265)  ; Fetch #R$A265.
; The stage has a crosshair.
 $C06D AND A         ; {Jump to #R$BC93 if it has.
 $C06E JP NZ,$BC93   ; }
; Copy the sheriff template into the first slot.
 $C071 LD HL,$C0BC   ; Point #REGhl at #R$C0BC.
 $C074 LD DE,$A27D   ; Point #REGde at #R$A27D.
 $C077 LD BC,$0010   ; Set the size of an object slot in #REGbc.
 $C07A LDIR          ; Copy the template into the slot.
; Set the top speed of the sheriff.
 $C07C LD A,$0A      ; {Set #R$A21F to #N$0A.
 $C07E LD ($A21F),A  ; }
; Draw the lives.
 $C081 JP $D27C      ; Jump to #R$D27C.
; Fetch the flag which shows that a stage is starting.
@label=CheckSheriffLost_TwoPlayers
*$C084 LD A,($A240)  ; Fetch #R$A240.
; Take a life if a stage is starting.
 $C087 AND A         ; {Jump to #R$C05F if it is.
 $C088 JR NZ,$C05F   ; }
; Fetch the number of lives.
 $C08A LD A,($A263)  ; Fetch #R$A263.
; The player has lives left.
 $C08D AND A         ; {Jump to #R$C0B1 if there are any.
 $C08E JR NZ,$C0B1   ; }
; Show "GAME OVER" for this player.
 $C090 CALL $B7A8    ; Call #R$B7A8.
; Fetch the number of the current player.
 $C093 LD A,($A23F)  ; Fetch #R$A23F.
; Check the top score if the second player has finished.
 $C096 AND A         ; {Jump to #R$A50A if the second player has finished.
 $C097 JP NZ,$A50A   ; }
; Switch to the other player.
@label=CheckSheriffLost_ChangePlayer
*$C09A XOR %00000001 ; Switch to the other player.
; Set the number of the current player.
 $C09C LD ($A23F),A  ; Set #R$A23F.
; Remove all of the objects.
 $C09F CALL $C7C8    ; Call #R$C7C8.
; Swap the states of the two players.
 $C0A2 CALL $A6EA    ; Call #R$A6EA.
; Show the number of the player.
 $C0A5 CALL $A6C9    ; Call #R$A6C9.
; Fetch the colour of the screen.
 $C0A8 LD A,($A266)  ; {Fetch #R$A266 and keep it in #REGe.
 $C0AB LD E,A        ; }
; Draw the screen furniture.
 $C0AC CALL $D2FB    ; Call #R$D2FB.
; Take a life.
 $C0AF JR $C05F      ; Jump to #R$C05F.
; Fetch the number of the current player.
@label=CheckSheriffLost_LivesLeft
*$C0B1 LD A,($A23F)  ; Fetch #R$A23F.
; Change to the other player.
 $C0B4 JR $C09A      ; Jump to #R$C09A.
; Show "GAME OVER".
@label=CheckSheriffLost_GameOver
*$C0B6 CALL $B7A8    ; Call #R$B7A8.
; Work out the top score.
 $C0B9 JP $A50D      ; Jump to #R$A50D.

; Sheriff Template
;
; The initial contents of a slot for the sheriff when he comes back after
; losing a life. It is an object of type #N$19, which waits sixteen frames
; before the sheriff arrives, at the place where he starts. The final two bytes
; point to the sprite list.
@label=SheriffTemplate
b$C0BC DEFB $19,$88,$04,$F0,$04,$00,$80,$00 ; {Type, position, speed, size and
 $C0C4 DEFB $10,$10,$00,$00,$10,$00         ; counters.}
 $C0CA DEFW $B7A4                           ; The sprite list, which is a dead
                                            ; figure.

; Advance Frame Counter
;
; Used by the routine at #R$A36D.
; .
; Adds one to the frame counter, and then updates the random numbers.
@label=AdvanceFrameCounter
c$C0CC LD HL,($A216) ; Fetch the frame counter.
 $C0CF INC HL        ; Add one.
 $C0D0 LD ($A216),HL ; Store the new frame counter.
; Continue on to #R$C0D3.

; Update Random Numbers
;
; Used by the routine at #R$A36D.
; .
; Stirs the two random numbers in #R$A218 and #R$A21A. The first uses
; #R$A216 and the refresh register, and the second uses the frame counter
; and the return address, so it is different for every routine which calls this.
;
; .
;
; Stir the first random number with the frame counter and the
; refresh register.
@label=UpdateRandomNumbers
c$C0D3 LD DE,($A216) ; Fetch #R$A216 into #REGde.
 $C0D7 LD HL,($A218) ; Fetch #R$A218.
 $C0DA LD A,R        ; Fetch the refresh register.
 $C0DC ADD A,E       ; Add the low byte of the frame counter.
 $C0DD ADD A,L       ; Add the low byte of the random number.
 $C0DE LD L,A        ; Set the low byte of the new number.
 $C0DF LD A,R        ; Fetch the refresh register again.
 $C0E1 ADD A,D       ; Add the high byte of the frame counter.
 $C0E2 ADD A,H       ; Add the high byte of the random number.
 $C0E3 LD H,A        ; Set the high byte of the new number.
; Store the first random number.
 $C0E4 LD ($A218),HL ; Set #R$A218.
; Stir the second random number with the frame counter and the
; return address.
 $C0E7 POP BC        ; {Fetch the return address into #REGbc, leaving it on the
 $C0E8 PUSH BC       ; stack.}
 $C0E9 LD HL,($A21A) ; Fetch #R$A21A.
 $C0EC LD A,C        ; Fetch the low byte of the return address.
 $C0ED SUB E         ; Subtract the low byte of the frame counter.
 $C0EE ADD A,L       ; Add the low byte of the random number.
 $C0EF LD L,A        ; Set the low byte of the new number.
 $C0F0 LD A,B        ; Fetch the high byte of the return address.
 $C0F1 SUB D         ; Subtract the high byte of the frame counter.
 $C0F2 ADD A,H       ; Add the high byte of the random number.
 $C0F3 LD H,A        ; Set the high byte of the new number.
; Store the second random number.
 $C0F4 LD ($A21A),HL ; Set #R$A21A.
 $C0F7 RET           ; Return.

; Draw Town
;
; Used by the routine at #R$A36D.
; .
; Called every frame. In the town, it draws the walls and the objects of
; the cells which are around the sheriff, in an order which is chosen so that
; the cells nearer the viewer are drawn after the ones behind them. The order
; depends on which of five of the cells next to the sheriff's cell have
; buildings in them, and is taken from five-byte entries in a table at #R$60B1.
; Each of the five bytes holds the offset of a cell from the sheriff's cell
; (bits 4 and 5 for the offset in the column, bits 6 and 7 for the offset in the
; row) and a kind of drawing to do in it (bits 0 and 1): #N$00 draws the objects
; in the cell, #N$01 draws the walls and #N$02 draws the edges. The sheriff's
; cell and three of its neighbours are drawn last. The town is a map of sixteen
; cells by sixteen, and when the view is rotated the cell numbers are turned
; round.
; #PUSHS #UDGTABLE { #POKES$5C79,$56
; #SIM(start=$A36D,stop=$A392,clear=1,sp=$5E00)
; #SIM(start=$A395,stop=$A3B3)
; #SIM(start=$C7D1,stop=$A3B7)
; #SIM(start=$A3B7,stop=$A3BA)
; #SIM(start=$A3BA,stop=$A3ED)
; #SIM(start=$A3ED,stop=$A3F0)
; #SIM(start=$A3F0,stop=$A3F3)
; #SIM(start=$A3F3,stop=$A3F6)
; #SCR$03,$0A,$01,$15,$0E(town) } UDGTABLE# #POPS
;
; .
;
; Return if this is not the town.
@label=DrawTown
c$C0F8 LD A,($A267)  ; Fetch #R$A267.
 $C0FB AND A         ; {Return if it is not.
 $C0FC RET Z         ; }
; The walls are not drawn on columns of the screen which already have a
; wall in them. The sixteen flags at #R$A248 cover columns of sixteen pixels.
; The left sixteen pixels and the right forty eight sit outside the play
; area, so they are marked as done.
 $C0FD LD HL,$E001   ; {Set #R$A248.
 $C100 LD ($A248),HL ; }
; Fetch the sheriff's cell.
 $C103 LD A,($A27F)  ; {Fetch the horizontal cell of the sheriff from #R$A27D(#N$A27F)
 $C106 LD L,A        ; and keep it in #REGl.}
 $C107 LD A,($A281)  ; {Fetch the vertical cell of the sheriff from #R$A27D(#N$A281)
 $C10A LD H,A        ; and keep it in #REGh.}
; Turn the cell round if the view is rotated.
 $C10B CALL $C372    ; Call #R$C372.
 $C10E PUSH HL       ; Stash the cell of the sheriff on the stack.
 $C10F LD E,$00      ; Clear the flags for the neighbouring cells.
; Find out which of five neighbouring cells have something in them. Taking
; the column and row of the sheriff's cell as x and y, they are the cells (x-1,
; y+1), (x-1, y), (x, y+1), (x-1, y-1) and (x+1, y+1).
 $C111 DEC L         ; Take one off the column...
 $C112 INC H         ; ...and add one to the row.
; Find the contents of the cell.
 $C113 CALL $C738    ; Call #R$C738.
 $C116 JR Z,$C11A    ; Jump to #R$C11A if it is empty.
 $C118 SET 0,E       ; Set the bit for the first cell.
; Test the cell at (x-1, y).
@label=DrawTown_TestSecondCell
*$C11A POP HL        ; Restore the cell of the sheriff from the stack.
 $C11B PUSH HL       ; Stash the cell of the sheriff on the stack.
 $C11C DEC L         ; Take one off the column.
; Find the contents of the cell.
 $C11D CALL $C738    ; Call #R$C738.
 $C120 JR Z,$C124    ; Jump to #R$C124 if it is empty.
 $C122 SET 1,E       ; Set the bit for the second cell.
; Test the cell at (x, y+1).
@label=DrawTown_TestThirdCell
*$C124 POP HL        ; Restore the cell of the sheriff from the stack.
 $C125 PUSH HL       ; Stash the cell of the sheriff on the stack.
 $C126 INC H         ; Add one to the row.
; Find the contents of the cell.
 $C127 CALL $C738    ; Call #R$C738.
 $C12A JR Z,$C12E    ; Jump to #R$C12E if it is empty.
 $C12C SET 2,E       ; Set the bit for the third cell.
; Test the cell at (x-1, y-1).
@label=DrawTown_TestFourthCell
*$C12E POP HL        ; Restore the cell of the sheriff from the stack.
 $C12F PUSH HL       ; Stash the cell of the sheriff on the stack.
 $C130 DEC L         ; Take one off the column...
 $C131 DEC H         ; ...and take one off the row.
; Find the contents of the cell.
 $C132 CALL $C738    ; Call #R$C738.
 $C135 JR Z,$C139    ; Jump to #R$C139 if it is empty.
 $C137 SET 3,E       ; Set the bit for the fourth cell.
; Test the cell at (x+1, y+1).
@label=DrawTown_TestFifthCell
*$C139 POP HL        ; Restore the cell of the sheriff from the stack.
 $C13A PUSH HL       ; Stash the cell of the sheriff on the stack.
 $C13B INC L         ; Add one to the column...
 $C13C INC H         ; ...and add one to the row.
; Find the contents of the cell.
 $C13D CALL $C738    ; Call #R$C738.
 $C140 JR Z,$C144    ; Jump to #R$C144 if it is empty.
 $C142 SET 4,E       ; Set the bit for the fifth cell.
; Point at the entry in the table of five bytes for the cells which have
; been found.
@label=DrawTown_FindEntry
*$C144 LD D,$00      ; Clear #REGd.
 $C146 LD A,E        ; Fetch the flags for the cells.
 $C147 EX DE,HL      ; Move the flags into #REGhl.
 $C148 LD E,L        ; {Copy them into #REGde.
 $C149 LD D,H        ; }
 $C14A ADD HL,HL     ; {Multiply them by four.
 $C14B ADD HL,HL     ; }
 $C14C ADD HL,DE     ; Add them again, to make five times.
 $C14D LD DE,$60B1   ; Point #REGde at #R$60B1.
 $C150 ADD HL,DE     ; Point #REGhl at the entry.
 $C151 EX DE,HL      ; Keep the address of the entry in #REGde.
 $C152 LD B,$05      ; Set the number of bytes to five.
; Draw the next cell from the entry.
@label=DrawTown_NextCell
*$C154 POP HL        ; Restore the cell of the sheriff from the stack.
 $C155 PUSH HL       ; Stash the cell of the sheriff on the stack.
 $C156 LD A,(DE)     ; Fetch the byte from the entry.
 $C157 INC DE        ; Move on to the next byte.
 $C158 BIT 5,A       ; {Jump to #R$C163 if the cell is in the same column as
 $C15A JR NZ,$C163   ; the sheriff.}
 $C15C BIT 4,A       ; {Jump to #R$C162 if this is not the next column.
 $C15E JR Z,$C162    ; }
 $C160 INC L         ; {Add two to the column.
 $C161 INC L         ; }
@label=DrawTown_ColumnOffset
*$C162 DEC L         ; Take one off the column, to make it one lower or one
                     ; higher.
@label=DrawTown_TestRow
*$C163 BIT 7,A       ; {Jump to #R$C16E if the cell is in the same row as the
 $C165 JR NZ,$C16E   ; sheriff.}
 $C167 BIT 6,A       ; {Jump to #R$C16D if this is not the next row.
 $C169 JR Z,$C16D    ; }
 $C16B INC H         ; {Add two to the row.
 $C16C INC H         ; }
@label=DrawTown_RowOffset
*$C16D DEC H         ; Take one off the row, to make it one lower or one
                     ; higher.
; Choose what to draw in the cell.
@label=DrawTown_KeepKind
*$C16E AND %00000011 ; Keep the kind of drawing.
 $C170 PUSH BC       ; {Stash the number of bytes left and the address in the entry on
 $C171 PUSH DE       ; the stack.}
; Make the draw routine return to #R$C182.
 $C172 LD DE,$C182   ; Point #REGde at #R$C182.
 $C175 PUSH DE       ; Stash it on the stack.
; Draw the objects in the cell if the kind is zero.
 $C176 JP Z,$C19F    ; Jump to #R$C19F if it is.
 $C179 DEC A         ; Take one off the kind.
; Draw the walls of the cell if the kind is one.
 $C17A JP Z,$C54B    ; Jump to #R$C54B if it is.
 $C17D DEC A         ; Take one off the kind.
; Draw the edges of the cell if the kind is two.
 $C17E JP Z,$C392    ; Jump to #R$C392 if it is.
; The kind is three, which is nothing.
 $C181 POP DE        ; Throw away the return address from the stack.
@label=DrawTown_AfterDraw
 $C182 POP DE        ; {Restore the address in the entry and the number of bytes left
 $C183 POP BC        ; from the stack.}
; Go back for the next byte of the entry.
 $C184 DJNZ $C154    ; Jump to #R$C154 if there are any left.
; Draw the sheriff's cell and the three cells after it: the cells with the
; row one lower, the column one higher, and both of those.
 $C186 POP HL        ; Restore the cell of the sheriff from the stack.
 $C187 PUSH HL       ; Stash the cell of the sheriff on the stack.
; Draw the edges and the objects in the cell.
 $C188 CALL $C19A    ; Call #R$C19A.
 $C18B POP HL        ; Restore the cell of the sheriff from the stack.
 $C18C PUSH HL       ; Stash the cell of the sheriff on the stack.
 $C18D DEC H         ; Take one off the row.
; Draw the edges and the objects in the cell.
 $C18E CALL $C19A    ; Call #R$C19A.
 $C191 POP HL        ; Restore the cell of the sheriff from the stack.
 $C192 PUSH HL       ; Stash the cell of the sheriff on the stack.
 $C193 INC L         ; Add one to the column.
; Draw the edges and the objects in the cell.
 $C194 CALL $C19A    ; Call #R$C19A.
 $C197 POP HL        ; Restore the cell of the sheriff from the stack.
 $C198 INC L         ; Add one to the column...
 $C199 DEC H         ; ...and take one off the row.
; The last cell goes on into the routine, which returns to the caller.
@label=DrawCellAndObjects
*$C19A PUSH HL       ; Stash the cell on the stack.
; Draw the edges of the cell.
 $C19B CALL $C392    ; Call #R$C392.
 $C19E POP HL        ; Restore the cell from the stack.
; Continue on to #R$C19F.
; .
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$CF08 }
; LIST#

; Draw Cell Objects
;
; Used by the routine at #R$C0F8.
; .
; Draws all of the objects which are in a cell of the town, with the ones
; which are furthest from the viewer first.
;
; HL The cell: the column in #REGl and the row in #REGh
@label=DrawCellObjects
c$C19F CALL $C1A4    ; Make a list of the objects in the cell.
 $C1A2 JR $C1E7      ; Jump to #R$C1E7.

; Find Objects In Cell
;
; Used by the routine at #R$C19F.
; .
; Makes a list at #R$C352 of the addresses of all of the objects which are
; in a cell. The list ends with a zero word.
;
; HL The cell: the column in #REGl and the row in #REGh
;
; Point at the list and the first object slot.
@label=FindObjectsInCell
c$C1A4 LD IY,$C352   ; Point #REGiy at #R$C352.
 $C1A8 LD IX,$A27D   ; Point #REGix at #R$A27D.
; Turn the cell round if the view is rotated.
 $C1AC CALL $C372    ; Call #R$C372.
 $C1AF EX DE,HL      ; Keep the column in #REGe and the row in #REGd.
; Look at this slot.
@label=FindObjectsInCell_Next
*$C1B0 LD A,(IX+$00) ; {Jump to #R$C1CF if the slot is not in use.
 $C1B3 AND A         ;
 $C1B4 JR Z,$C1CF    ; }
 $C1B6 LD A,E        ; {Jump to #R$C1CF if the object is not in the same
 $C1B7 CP (IX+$02)   ; column.
 $C1BA JR NZ,$C1CF   ; }
 $C1BC LD A,D        ; {Jump to #R$C1CF if the object is not in the same row.
 $C1BD CP (IX+$04)   ;
 $C1C0 JR NZ,$C1CF   ; }
 $C1C2 PUSH IX       ; {Copy the address of the object into #REGhl (using the
 $C1C4 POP HL        ; stack).}
 $C1C5 LD (IY+$00),L ; {Add the address of the object to the list.
 $C1C8 LD (IY+$01),H ; }
 $C1CB INC IY        ; {Move on to the next place in the list.
 $C1CD INC IY        ; }
@label=FindObjectsInCell_Skip
*$C1CF LD BC,$0010   ; {Move on to the next object slot.
 $C1D2 ADD IX,BC     ; }
 $C1D4 PUSH IX       ; {Copy the address of the slot into #REGhl (using the
 $C1D6 POP HL        ; stack).}
; See whether every slot has been looked at.
 $C1D7 LD BC,$A36D   ; {Test whether this is past the last slot.
 $C1DA AND A         ;
 $C1DB SBC HL,BC     ; }
; Go back for the next slot.
 $C1DD JR C,$C1B0    ; Jump to #R$C1B0 if it is not.
; End the list.
 $C1DF XOR A         ; {Write a zero word to the end of the list.
 $C1E0 LD (IY+$00),A ;
 $C1E3 LD (IY+$01),A ; }
 $C1E6 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$CFAF }
; LIST#

; Draw Objects In List
;
; Used by the routine at #R$C19F.
; .
; Draws the objects in the list at #R$C352, which are the objects in one
; cell. The objects are drawn so that the ones further from the viewer come
; first. Each time it takes the first object in the list which has not been
; drawn, compares it with each of the rest, and swaps it for any object which
; should be drawn before it. It then draws the object it is left with, and marks
; it as drawn by clearing bit 7 of the high byte of its address in the list.
;
; .
;
; Find the first object in the list which has not been drawn.
@label=DrawObjectsInList
c$C1E7 LD HL,$C352    ; Point #REGhl at #R$C352.
@label=DrawObjectsInList_First
*$C1EA LD E,(HL)      ; {Fetch the address of the next object into #REGde.
 $C1EB INC HL         ;
 $C1EC LD D,(HL)      ;
 $C1ED INC HL         ; }
 $C1EE LD A,D         ; {Return if this is the end of the list.
 $C1EF OR E           ;
 $C1F0 RET Z          ; }
 $C1F1 BIT 7,D        ; {Jump to #R$C1EA if it has been drawn.
 $C1F3 JR Z,$C1EA     ; }
; Remember where the next place in the list is.
 $C1F5 LD ($A24A),HL  ; Set #R$A24A.
 $C1F8 PUSH DE        ; {Copy the address of the object into #REGix (using the
 $C1F9 POP IX         ; stack).}
; Compare this object with each of the others which have not been drawn.
@label=DrawObjectsInList_Next
*$C1FB LD E,(HL)      ; {Fetch the address of the next object into #REGde.
 $C1FC INC HL         ;
 $C1FD LD D,(HL)      ;
 $C1FE INC HL         ; }
; Draw the first object if this is the end of the list.
 $C1FF LD A,D         ; {Jump to #R$C289 if it is.
 $C200 OR E           ;
 $C201 JP Z,$C289     ; }
 $C204 BIT 7,D        ; {Jump to #R$C1FB if it has been drawn.
 $C206 JR Z,$C1FB     ; }
; Remember where the next place in the list is.
 $C208 LD ($A24C),HL  ; Set #R$A24C.
 $C20B PUSH DE        ; {Copy the address of the object into #REGiy (using the
 $C20C POP IY         ; stack).}
 $C20E LD C,$00       ; Clear the number which says how the objects compare.
; Compare the objects from side to side. The number in #REGc stays at zero
; if the first object starts after the second ends, becomes two if the second
; starts after the first ends, and becomes one if they overlap.
 $C210 LD A,(IY+$01)  ; {Fetch the horizontal position of the second object and add its
 $C213 ADD A,(IY+$08) ; horizontal size.}
 $C216 RRA            ; {Halve it, add #N$40 and keep the result in #REGb.
 $C217 ADD A,$40      ;
 $C219 LD B,A         ; }
 $C21A LD A,(IX+$01)  ; {Fetch the horizontal position of the first object and subtract its
 $C21D SUB (IX+$08)   ; horizontal size.}
 $C220 RRA            ; {Halve it and add #N$40.
 $C221 ADD A,$40      ; }
 $C223 SUB B          ; {Jump to #R$C23E if the first object starts after the second
 $C224 JR NC,$C23E    ; ends.}
 $C226 LD A,(IX+$01)  ; {Fetch the horizontal position of the first object and add its
 $C229 ADD A,(IX+$08) ; horizontal size.}
 $C22C RRA            ; {Halve it, add #N$40 and keep the result in #REGb.
 $C22D ADD A,$40      ;
 $C22F LD B,A         ; }
 $C230 LD A,(IY+$01)  ; {Fetch the horizontal position of the second object and subtract its
 $C233 SUB (IY+$08)   ; horizontal size.}
 $C236 RRA            ; {Halve it and add #N$40.
 $C237 ADD A,$40      ; }
 $C239 SUB B          ; {Jump to #R$C23D if the second object starts before the first
 $C23A JR C,$C23D     ; ends.}
 $C23C INC C          ; Add one.
@label=DrawObjectsInList_AddOne
*$C23D INC C          ; Add one more.
; Compare the objects from front to back in the same way. This time the
; number in #REGc has zero, three or six added to it.
@label=DrawObjectsInList_Depth
*$C23E LD A,(IY+$03)  ; {Fetch the vertical position of the second object and add its
 $C241 ADD A,(IY+$09) ; vertical size.}
 $C244 RRA            ; {Halve it, add #N$40 and keep the result in #REGb.
 $C245 ADD A,$40      ;
 $C247 LD B,A         ; }
 $C248 LD A,(IX+$03)  ; {Fetch the vertical position of the first object and subtract its
 $C24B SUB (IX+$09)   ; vertical size.}
 $C24E RRA            ; {Halve it and add #N$40.
 $C24F ADD A,$40      ; }
 $C251 SUB B          ; Subtract the end of the second object.
 $C252 LD A,C         ; Fetch the number.
 $C253 JR NC,$C270    ; Jump to #R$C270 if the first object starts after the second
                      ; ends.
 $C255 LD A,(IX+$03)  ; {Fetch the vertical position of the first object and add its vertical
 $C258 ADD A,(IX+$09) ; size.}
 $C25B RRA            ; {Halve it, add #N$40 and keep the result in #REGb.
 $C25C ADD A,$40      ;
 $C25E LD B,A         ; }
 $C25F LD A,(IY+$03)  ; {Fetch the vertical position of the second object and subtract its
 $C262 SUB (IY+$09)   ; vertical size.}
 $C265 RRA            ; {Halve it and add #N$40.
 $C266 ADD A,$40      ; }
 $C268 SUB B          ; Subtract the end of the first object.
 $C269 LD A,C         ; Fetch the number.
 $C26A JR C,$C26E     ; Jump to #R$C26E if the second object starts before the first
                      ; ends.
 $C26C ADD A,$03      ; Add three.
@label=DrawObjectsInList_AddThree
*$C26E ADD A,$03      ; Add three more.
@label=DrawObjectsInList_Rotated
*$C270 LD C,A         ; Keep the number in #REGc.
; Fetch the rotation of the view.
 $C271 LD A,($A268)   ; Fetch #R$A268.
 $C274 AND %00000001  ; Test the lowest bit.
 $C276 JR Z,$C27C     ; Jump to #R$C27C if the view is not rotated.
 $C278 LD A,C         ; {Add #N$09 to the number, to use the second half of the
 $C279 ADD A,$09      ; table.
 $C27B LD C,A         ; }
@label=DrawObjectsInList_Choose
*$C27C LD A,C         ; Fetch the number.
 $C27D LD BC,$C295    ; Point #REGbc at #R$C295.
; Run the routine for the number.
 $C280 CALL $C766     ; Call #R$C766.
; Fetch the place in the list after the second object.
 $C283 LD HL,($A24C)  ; Fetch #R$A24C.
; Go back to compare the next object.
 $C286 JP $C1FB       ; Jump to #R$C1FB.
; There are no more objects to compare with, so the first object is the
; one to draw. Mark it as drawn, using the place kept at #R$A24A.
@label=DrawObjectsInList_Draw
*$C289 LD HL,($A24A)  ; {Clear bit 7 of the high byte of its address in the
 $C28C DEC HL         ; list.
 $C28D RES 7,(HL)     ; }
; Draw the object.
 $C28F CALL $BD62     ; Call #R$BD62.
; Go back to find the next object to draw.
 $C292 JP $C1E7       ; Jump to #R$C1E7.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$CFF2 }
; LIST#

; Object Order Routines
;
; The routines which are run by #R$C1E7 after it compares two objects, in
; two groups of nine. The number is made from the way the objects compare from
; side to side (zero to two) plus three times the way they compare from front to
; back (zero to two), and the second group is for a rotated view. A routine is
; #R$C2B9 to keep the first object, #R$C2BA to swap it for the second object, or
; #R$C2C5 to look at the objects more closely.
@label=ObjectOrderRoutines
w$C295 DEFW $C2B9
 $C297 DEFW $C2B9
 $C299 DEFW $C2B9
 $C29B DEFW $C2BA
 $C29D DEFW $C2C5
 $C29F DEFW $C2B9
 $C2A1 DEFW $C2BA
 $C2A3 DEFW $C2BA
 $C2A5 DEFW $C2B9
 $C2A7 DEFW $C2B9
 $C2A9 DEFW $C2BA
 $C2AB DEFW $C2BA
 $C2AD DEFW $C2B9
 $C2AF DEFW $C2C5
 $C2B1 DEFW $C2BA
 $C2B3 DEFW $C2B9
 $C2B5 DEFW $C2B9
 $C2B7 DEFW $C2B9

; Keep Object
;
; Keeps the first object as the one to be drawn first, so there is nothing
; to do.
@label=KeepObject
c$C2B9 RET           ; Return.

; Choose Other Object
;
; Used by the routine at #R$C2C5.
; .
; Swaps the first object for the second one, which has to be drawn before
; it.
;
; IY The address of the second object
@label=ChooseOtherObject
c$C2BA LD HL,($A24C) ; {Make the place in the list after the second object the place after
 $C2BD LD ($A24A),HL ; the first object.}
 $C2C0 PUSH IY       ; {Copy the address of the second object into #REGix
 $C2C2 POP IX        ; (using the stack).}
 $C2C4 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$D0C5 }
; LIST#

; Compare Object Depths
;
; Works out which of two objects which overlap should be drawn first. For
; each object it finds a number from the difference between a vertical and a
; horizontal edge, and it swaps the objects if the numbers are the wrong way
; round. The edges which it uses are different when the view is rotated.
;
; IX The address of the first object
; IY The address of the second object
@label=CompareObjectDepths
c$C2C5 LD A,($A268)   ; Fetch the rotation of the view.
 $C2C8 AND %00000001  ; Test the lowest bit.
 $C2CA JR NZ,$C31A    ; Jump if the view is rotated.
; Find the number for the second object, in #REGde.
 $C2CC LD A,(IY+$01)  ; {Fetch the horizontal position, add the horizontal size, halve it and
 $C2CF ADD A,(IY+$08) ; add #N$40.
 $C2D2 RRA            ;
 $C2D3 ADD A,$40      ; }
 $C2D5 LD C,A         ; {Keep it in #REGbc.
 $C2D6 LD B,$00       ; }
 $C2D8 LD A,(IY+$03)  ; {Fetch the vertical position, subtract the vertical size, halve it
 $C2DB SUB (IY+$09)   ; and add #N$40.
 $C2DE RRA            ;
 $C2DF ADD A,$40      ; }
 $C2E1 LD L,A         ; {Make the top edge a sixteen bit number in #REGhl.
 $C2E2 LD H,$00       ; }
 $C2E4 AND A          ; {Subtract the horizontal edge.
 $C2E5 SBC HL,BC      ; }
 $C2E7 LD BC,$0100    ; {Add #N$0100.
 $C2EA ADD HL,BC      ; }
 $C2EB SRL H          ; {Divide the result by two...
 $C2ED RR L           ; }
 $C2EF EX DE,HL       ; ...and keep it in #REGde.
; Find the number for the first object, in #REGhl, in the same way.
 $C2F0 LD A,(IX+$01)  ; {Fetch the horizontal position, add the horizontal size, halve it and
 $C2F3 ADD A,(IX+$08) ; add #N$40.
 $C2F6 RRA            ;
 $C2F7 ADD A,$40      ; }
 $C2F9 LD C,A         ; {Keep it in #REGbc.
 $C2FA LD B,$00       ; }
 $C2FC LD A,(IX+$03)  ; {Fetch the vertical position and subtract the vertical
 $C2FF SUB (IX+$09)   ; size.}
@label=CompareObjectDepths_Finish
*$C302 RRA            ; {Halve it and add #N$40.
 $C303 ADD A,$40      ; }
 $C305 LD L,A         ; {Make the top edge a sixteen bit number in #REGhl.
 $C306 LD H,$00       ; }
 $C308 AND A          ; {Subtract the horizontal edge.
 $C309 SBC HL,BC      ; }
 $C30B LD BC,$0100    ; {Add #N$0100.
 $C30E ADD HL,BC      ; }
 $C30F SRL H          ; {Divide the result by two.
 $C311 RR L           ; }
 $C313 AND A          ; {Subtract the number for the other object.
 $C314 SBC HL,DE      ; }
 $C316 RET NC         ; Return if the first number is not the lower.
 $C317 JP $C2BA       ; Otherwise swap the objects.
; Find the numbers when the view is rotated. The number for the first
; object goes in #REGde...
@label=CompareObjectDepths_Rotated
*$C31A LD A,(IX+$01)  ; {Fetch the horizontal position, subtract the horizontal size, halve
 $C31D SUB (IX+$08)   ; it and add #N$40.
 $C320 RRA            ;
 $C321 ADD A,$40      ; }
 $C323 LD C,A         ; {Keep it in #REGbc.
 $C324 LD B,$00       ; }
 $C326 LD A,(IX+$03)  ; {Fetch the vertical position, add the vertical size, halve it and add
 $C329 ADD A,(IX+$09) ; #N$40.
 $C32C RRA            ;
 $C32D ADD A,$40      ; }
 $C32F LD L,A         ; {Make the lower edge a sixteen bit number in #REGhl.
 $C330 LD H,$00       ; }
 $C332 AND A          ; {Subtract the horizontal edge.
 $C333 SBC HL,BC      ; }
 $C335 LD BC,$0100    ; {Add #N$0100.
 $C338 ADD HL,BC      ; }
 $C339 SRL H          ; {Divide the result by two...
 $C33B RR L           ; }
 $C33D EX DE,HL       ; ...and keep it in #REGde.
; ...and the number for the second object is found in #REGhl by the end of
; the routine above.
 $C33E LD A,(IY+$01)  ; {Fetch the horizontal position, subtract the horizontal size, halve
 $C341 SUB (IY+$08)   ; it and add #N$40.
 $C344 RRA            ;
 $C345 ADD A,$40      ; }
 $C347 LD C,A         ; {Keep it in #REGbc.
 $C348 LD B,$00       ; }
 $C34A LD A,(IY+$03)  ; {Fetch the vertical position and add the vertical size.
 $C34D ADD A,(IY+$09) ; }
; Go to find the number.
 $C350 JR $C302       ; Jump to #R$C302.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$D0D0 }
; LIST#

; Cell Object List
;
; The list of the objects in a cell, which is made by #R$C1A4. It has room
; for the addresses of fifteen objects and the zero word which ends the list.
@label=CellObjectList
g$C352 DEFW $0000
 $C354 DEFW $0000
 $C356 DEFW $0000
 $C358 DEFW $0000
 $C35A DEFW $0000
 $C35C DEFW $0000
 $C35E DEFW $0000
 $C360 DEFW $0000
 $C362 DEFW $0000
 $C364 DEFW $0000
 $C366 DEFW $0000
 $C368 DEFW $0000
 $C36A DEFW $0000
 $C36C DEFW $0000
 $C36E DEFW $0000
 $C370 DEFW $0000

; Convert Cell
;
; Used by the routines at #R$C0F8 and #R$C1A4.
; .
; Converts the column and the row of a cell between the map and the
; view. They are the same unless the view is rotated by a half turn, when
; each is replaced by fifteen minus itself, so that cell (x, y) on the map
; of sixteen by sixteen is (fifteen minus x, fifteen minus y) in the view.
; It does nothing when the view is not rotated.
;
;   L The column
;   H The row
; O:L The column to use
; O:H The row to use
;
; Return if the view is not rotated.
@label=ConvertCell
c$C372 LD A,($A268)  ; Fetch #R$A268.
 $C375 AND %00000001 ; Keep the bit which says that the view is rotated.
 $C377 RET Z         ; Return if it is not.
; Replace the column with fifteen minus the column.
 $C378 LD A,L        ; {Invert the column.
 $C379 CPL           ; }
 $C37A AND %00001111 ; Keep the low four bits, which is fifteen minus the
                     ; column.
 $C37C LD L,A        ; Set the column.
; Replace the row with fifteen minus the row.
 $C37D LD A,H        ; {Invert the row.
 $C37E CPL           ; }
 $C37F AND %00001111 ; Keep the low four bits, which is fifteen minus the row.
 $C381 LD H,A        ; Set the row.
 $C382 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$D17D }
; LIST#

; Convert Position
;
; Used by the routine at #R$C6C7.
; .
; Converts a position along one axis between the map and the view. It
; is the same unless the view is rotated by a half turn, when the position
; within the cell is inverted and the cell is replaced by fifteen minus
; itself. It does nothing when the view is not rotated.
;
;   L The position within the cell
;   H The cell
; O:L The position within the cell to use
; O:H The cell to use
;
; Return if the view is not rotated.
@label=ConvertPosition
c$C383 LD A,($A268)  ; Fetch #R$A268.
 $C386 AND %00000001 ; Keep the bit which says that the view is rotated.
 $C388 RET Z         ; Return if it is not.
; Invert the position within the cell.
 $C389 LD A,L        ; {Invert the low byte.
 $C38A CPL           ; }
 $C38B LD L,A        ; Set the low byte.
; Replace the cell with fifteen minus the cell.
 $C38C LD A,H        ; {Invert the cell.
 $C38D CPL           ; }
 $C38E AND %00001111 ; Keep the low four bits, which is fifteen minus the cell.
 $C390 LD H,A        ; Set the cell.
 $C391 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$D18E }
; LIST#

; Draw Cell
;
; Used by the routine at #R$C0F8.
; .
; Draws the outline of a cell of the town, using the lists of tiles in the
; table at #R$626C. There are two lists for each kind of cell: one for the edges
; at the bottom, drawn from the left corner, and one for the edges at the top,
; drawn from the right corner. Each list is drawn as two runs of eight tiles
; which are 16 pixels wide, using the first byte of each pair of bytes in the
; list, in the shape of a V for the bottom and an upside-down V for the top.
; When the view is rotated the two lists change places.
;
; L The column
; H The row
;
; Find the code of the cell.
@label=DrawCell
c$C392 CALL $C738    ; Call #R$C738.
 $C395 RET Z         ; Return if there is nothing in the cell.
; Double the code to make the number of its first list.
 $C396 ADD A,A       ; Double the code.
 $C397 PUSH AF       ; Stash it on the stack.
; Find the position of the cell on the screen.
 $C398 CALL $C6DC    ; Call #R$C6DC.
 $C39B POP AF        ; {Restore the list number from the stack, leaving it
 $C39C PUSH AF       ; there.}
; Draw the second list at the bottom when the view is rotated.
 $C39D LD HL,$A268   ; {Jump to #R$C3E7 if the view is rotated.
 $C3A0 BIT 0,(HL)    ;
 $C3A2 JR NZ,$C3E7   ; }
; Draw the edges at the bottom.
 $C3A4 CALL $C3EF    ; Call #R$C3EF.
 $C3A7 POP AF        ; Restore the list number from the stack.
 $C3A8 OR %00000001  ; Use the second list.
; Draw the edges at the top, starting from the right corner of the
; cell.
@label=DrawCell_Top
*$C3AA LD HL,($A24E) ; {Move #R$A24E sixteen pixels to the left.
 $C3AD LD DE,$FFF0   ;
 $C3B0 ADD HL,DE     ;
 $C3B1 LD ($A24E),HL ; }
 $C3B4 LD BC,$626C   ; Point #REGbc at #R$626C.
; Find the address of the list.
 $C3B7 CALL $C75C    ; Call #R$C75C.
 $C3BA PUSH HL       ; {Copy the list address to #REGiy (using the stack).
 $C3BB POP IY        ; }
; Draw tiles as they are.
 $C3BD XOR A         ; {Write #N$00 to *#R$A252.
 $C3BE LD ($A252),A  ; }
 $C3C1 LD BC,$0801   ; Set a count of eight tiles, and swap each for its pair.
; Draw eight tiles going up and to the left.
@label=DrawCell_TopLeft
*$C3C4 CALL $C468    ; Call #R$C468.
 $C3C7 CALL $C44A    ; Call #R$C44A.
 $C3CA DJNZ $C3C4    ; Jump to #R$C3C4 if there are any left.
; Move down by eight pixels to start the second run.
 $C3CC LD HL,($A250) ; {Move #R$A250 down by eight pixels.
 $C3CF LD DE,$FFF8   ;
 $C3D2 ADD HL,DE     ;
 $C3D3 LD ($A250),HL ; }
; Draw the rest of the tiles flipped.
 $C3D6 LD A,$01      ; {Write #N$01 to *#R$A252.
 $C3D8 LD ($A252),A  ; }
 $C3DB LD BC,$0801   ; Set a count of eight tiles, and swap each for its pair.
; Draw eight tiles going down and to the left.
@label=DrawCell_TopRight
*$C3DE CALL $C468    ; Call #R$C468.
 $C3E1 CALL $C463    ; Call #R$C463.
 $C3E4 DJNZ $C3DE    ; Jump to #R$C3DE if there are any left.
 $C3E6 RET           ; Return.
; The view is rotated, so draw the second list at the bottom and the
; first at the top.
@label=DrawCell_Rotated
*$C3E7 OR %00000001  ; Use the second list.
; Draw the edges at the bottom.
 $C3E9 CALL $C3EF    ; Call #R$C3EF.
 $C3EC POP AF        ; Restore the list number from the stack.
; Draw the edges at the top.
 $C3ED JR $C3AA      ; Jump to #R$C3AA.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$D19D }
; LIST#

; Draw Strips Left To Right
;
; Used by the routine at #R$C392.
; .
; Draws a list of sixteen tiles for the bottom edges of a cell, going down
; and to the right for the first eight and up and to the right for the second
; eight. The second eight are drawn flipped.
;
; A The number of the list in the table at #R$626C
;
; Find the address of the list.
@label=DrawStripsLeftToRight
c$C3EF LD BC,$626C   ; Point #REGbc at #R$626C.
 $C3F2 CALL $C75C    ; Call #R$C75C.
 $C3F5 PUSH HL       ; {Copy the list address to #REGiy (using the stack).
 $C3F6 POP IY        ; }
; Draw tiles as they are.
 $C3F8 XOR A         ; {Write #N$00 to *#R$A252.
 $C3F9 LD ($A252),A  ; }
 $C3FC LD BC,$0800   ; Set a count of eight tiles, without swapping any.
; Draw eight tiles going down and to the right.
@label=DrawStripsLeftToRight_Down
*$C3FF CALL $C468    ; Call #R$C468.
 $C402 CALL $C440    ; Call #R$C440.
 $C405 DJNZ $C3FF    ; Jump to #R$C3FF if there are any left.
; Move up by eight pixels to start the second run.
 $C407 LD HL,($A250) ; {Move #R$A250 up by eight pixels.
 $C40A LD DE,$0008   ;
 $C40D ADD HL,DE     ;
 $C40E LD ($A250),HL ; }
; Draw the rest of the tiles flipped.
 $C411 LD A,$01      ; {Write #N$01 to *#R$A252.
 $C413 LD ($A252),A  ; }
 $C416 LD BC,$0800   ; Set a count of eight tiles, without swapping any.
; Draw eight tiles going up and to the right.
@label=DrawStripsLeftToRight_Up
*$C419 CALL $C468    ; Call #R$C468.
 $C41C CALL $C427    ; Call #R$C427.
 $C41F DJNZ $C419    ; Jump to #R$C419 if there are any left.
 $C421 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$D1FA }
; LIST#

; Step Up Right Keep List
;
; Used by the routine at #R$C54B.
; .
; Moves the draw position up by eight pixels and right by sixteen
; pixels. It does not move on in the list of tiles.
;
; .
;
; Move up and to the right.
@label=StepUpRightKeepList
c$C422 LD DE,$0008   ; Set the vertical step to eight pixels up.
; Move to the right, without moving on in the list.
 $C425 JR $C42E      ; Jump to #R$C42E.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$D22D }
; LIST#

; Step Up Right
;
; Used by the routine at #R$C3EF.
; .
; Moves the draw position up by eight pixels and right by sixteen
; pixels, and moves on to the next two bytes of the list of tiles.
;
; IY The address of the tile in its list
;
; Move up and to the right, and on to the next tile.
@label=StepUpRight
c$C427 LD DE,$0008   ; Set the vertical step to eight pixels up.
; Move on to the next two bytes of the list.
@label=AdvanceListStepRight
*$C42A INC IY        ; {Move on to the next two bytes of the list.
 $C42C INC IY        ; }
; This entry point is used by the routine at #R$C422.
; .
; Move the position.
@label=StepRight
*$C42E LD HL,($A250) ; {Add the vertical step to #R$A250.
 $C431 ADD HL,DE     ;
 $C432 LD ($A250),HL ; }
 $C435 LD HL,($A24E) ; {Move #R$A24E sixteen pixels to the right.
 $C438 LD DE,$0010   ;
 $C43B ADD HL,DE     ;
 $C43C LD ($A24E),HL ; }
 $C43F RET           ; Return.
; This entry point is used by the routine at #R$C3EF.
; .
; Move down and to the right, and on to the next tile.
@label=StepDownRight
*$C440 LD DE,$FFF8   ; Set the vertical step to eight pixels down.
 $C443 JR $C42A      ; Jump to #R$C42A.
; This entry point is used by the routine at #R$C54B.
; .
; Move down and to the right.
@label=StepDownRightKeepList
*$C445 LD DE,$FFF8   ; Set the vertical step to eight pixels down.
 $C448 JR $C42E      ; Jump to #R$C42E.
; This entry point is used by the routine at #R$C392.
; .
; Move up and to the left, and on to the next tile.
@label=StepUpLeft
*$C44A LD DE,$0008   ; Set the vertical step to eight pixels up.
; Move on to the next two bytes of the list.
@label=AdvanceListStepLeft
*$C44D INC IY        ; {Move on to the next two bytes of the list.
 $C44F INC IY        ; }
 $C451 LD HL,($A250) ; {Add the vertical step to #R$A250.
 $C454 ADD HL,DE     ;
 $C455 LD ($A250),HL ; }
 $C458 LD HL,($A24E) ; {Move #R$A24E sixteen pixels to the left.
 $C45B LD DE,$FFF0   ;
 $C45E ADD HL,DE     ;
 $C45F LD ($A24E),HL ; }
 $C462 RET           ; Return.
; This entry point is used by the routine at #R$C392.
; .
; Move down and to the left, and on to the next tile.
@label=StepDownLeft
*$C463 LD DE,$FFF8   ; Set the vertical step to eight pixels down.
 $C466 JR $C44D      ; Jump to #R$C44D.

; Draw Strip
;
; Used by the routines at #R$C392 and #R$C3EF.
; .
; Draws one tile of the edge of a cell of the town, if its position is
; inside the area where the town is drawn, which is from #N$11 to #N$CF
; horizontally and below #N$0100 vertically. The tile number comes from the
; list at #REGiy, and is changed to the number of an image by a table at
; #R$5E2C and then by the swap flag.
;
; IY The address of the tile in its list
; C One to swap the image for the other of its pair
;
; Return if the tile is outside the play area horizontally.
@label=DrawStrip
c$C468 LD DE,($A24E) ; Fetch #R$A24E into #REGde.
 $C46C LD HL,$00CF   ; {Return if it is further to the right than #N$00CF.
 $C46F AND A         ;
 $C470 SBC HL,DE     ;
 $C472 RET C         ; }
 $C473 LD HL,$0010   ; {Return if it is not further to the right than #N$0010.
 $C476 SBC HL,DE     ;
 $C478 RET NC        ; }
; Return if the tile is off the screen vertically.
 $C479 LD HL,($A250) ; Fetch #R$A250.
 $C47C LD A,H        ; {Return if the high byte is not zero.
 $C47D AND A         ;
 $C47E RET NZ        ; }
 $C47F LD D,L        ; Keep the low byte of the vertical position in #REGd.
; Fetch the tile and find its image.
 $C480 LD A,C        ; Fetch the swap flag.
 $C481 PUSH BC       ; Stash the count of tiles on the stack.
 $C482 LD C,(IY+$00) ; {Fetch the tile number into #REGbc.
 $C485 LD B,$00      ; }
 $C487 LD HL,$5E2C   ; {Find the entry for the tile in #R$5E2C.
 $C48A ADD HL,BC     ; }
 $C48B XOR (HL)      ; Combine it with the swap flag, to make the number of the
                     ; image.
 $C48C LD BC,$8A2E   ; Point #REGbc at #R$8A2E.
; Find the address of the image.
 $C48F CALL $C75C    ; Call #R$C75C.
; Draw the image.
 $C492 CALL $C4A7    ; Call #R$C4A7.
 $C495 POP BC        ; Restore the count of tiles from the stack.
 $C496 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$D273 }
; LIST#

; Clip Edge Strip Top
;
; Used by the routine at #R$C4A7.
; .
; Skips the rows of an image that are
; below #R$D6EB. #REGa is the number of those
; rows, negated. It starts drawing at #N$48 and
; jumps to #R$C4B6.
;
; A The number of rows below the buffer, negated
; HL The address of the image
;
; Skip the rows that are below the buffer.
@label=ClipEdgeStripTop
c$C497 NEG           ; {Make the number of rows positive and keep it in #REGc.
 $C499 LD C,A        ; }
 $C49A LD A,(HL)     ; {Fetch the height of the image.
 $C49B INC HL        ; }
 $C49C SUB C         ; Subtract the rows that are below.
 $C49D RET M         ; {Return if there are none left.
 $C49E RET Z         ; }
 $C49F LD B,$00      ; {Skip the image data for those rows.
 $C4A1 ADD HL,BC     ;
 $C4A2 ADD HL,BC     ; }
 $C4A3 LD D,$48      ; Set the vertical position to #N$48.
 $C4A5 JR $C4B6      ; Jump to #R$C4B6.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$D2A2 }
; LIST#

; Draw Strip Graphic
;
; Used by the routines at #R$AB18 and #R$C468.
; .
; Draws an image which is sixteen pixels
; wide into #R$D6EB, combining it with what is
; already there. The image starts with a byte
; for the number of rows, followed by two bytes
; for each row. It is drawn from the bottom row
; up, and is cut off at the bottom and top of
; the buffer. The position is in #R$A24E and
; the image is moved to the right by #N($00),
; #N($02), #N$04 or #N$06 pixels, using #R$FA00
; and #R$F200. The image is flipped if #R$A252
; is not zero.
;
; D The vertical position of the bottom of the image
; E The horizontal position of the image
; HL The address of the image
;
; Clip the image to the buffer.
@label=DrawStripGraphic
c$C4A7 LD A,D        ; {Subtract #N$48 from the vertical position.
 $C4A8 SUB $48       ; }
 $C4AA JR C,$C497    ; Jump to #R$C497 if it is below the bottom.
 $C4AC SUB $70       ; Subtract #N$70.
 $C4AE RET NC        ; Return if it is above the top.
 $C4AF NEG           ; Make it the number of rows in the buffer.
 $C4B1 CP (HL)       ; {Jump to #R$C4B5 if it is fewer.
 $C4B2 JR C,$C4B5    ; }
 $C4B4 LD A,(HL)     ; Use the height of the image.
; Draw the rows that are in the buffer.
@label=DrawStripGraphic_FirstRow
*$C4B5 INC HL        ; Move on to the first row of the image.
; This entry point is used by the routine at #R$C497.
@label=DrawStripGraphic_Draw
*$C4B6 EX AF,AF'     ; Keep the number of rows in #REGa'.
 $C4B7 EX DE,HL      ; Put the position in #REGhl.
 $C4B8 CALL $D233    ; Call #R$D233.
 $C4BB EX DE,HL      ; Switch the buffer and the image.
 $C4BC LD ($A21D),SP ; Set #R$A21D.
 $C4C0 LD SP,HL      ; Point the stack at the image.
; Choose the draw path.
 $C4C1 LD A,($A24E)  ; Fetch #R$A24E.
 $C4C4 AND %00000110 ; Keep bits 1 and 2.
 $C4C6 JR Z,$C518    ; Jump to #R$C518 if the image is aligned.
 $C4C8 OR %11110000  ; Set the high bits of the page.
 $C4CA LD H,A        ; Set #REGh.
 $C4CB LD A,($A252)  ; Fetch #R$A252.
 $C4CE AND A         ; {Jump to #R$C4F7 if it is set.
 $C4CF JR NZ,$C4F7   ; }
 $C4D1 SET 3,H       ; Set bit 3 of #REGh.
 $C4D3 EX AF,AF'     ; Switch in the number of rows.
; Draw a shifted row.
@label=DrawStripGraphic_Shifted
*$C4D4 EX AF,AF'     ; Keep the number of rows in #REGa'.
 $C4D5 POP BC        ; {Fetch a row and point at the first byte.
 $C4D6 LD L,C        ; }
 $C4D7 LD A,(DE)     ; {Combine the bits which stay with the first byte of the
 $C4D8 OR (HL)       ; buffer.
 $C4D9 LD (DE),A     ; }
 $C4DA INC DE        ; {Move on to the next byte and page.
 $C4DB INC H         ; }
 $C4DC LD A,(DE)     ; {Combine the bits which moved on from the first byte.
 $C4DD OR (HL)       ; }
 $C4DE DEC H         ; {Point at the second byte of the image.
 $C4DF LD L,B        ; }
 $C4E0 OR (HL)       ; {Combine its bits which stay and store the byte.
 $C4E1 LD (DE),A     ; }
 $C4E2 INC DE        ; {Move on to the next byte and page.
 $C4E3 INC H         ; }
 $C4E4 LD A,(DE)     ; {Combine the bits which moved on with the next byte of
 $C4E5 OR (HL)       ; the buffer.
 $C4E6 LD (DE),A     ; }
 $C4E7 DEC H         ; Go back to the first page.
 $C4E8 EX DE,HL      ; {Move on to the next row of the buffer.
 $C4E9 LD BC,$0016   ;
 $C4EC ADD HL,BC     ;
 $C4ED EX DE,HL      ; }
 $C4EE EX AF,AF'     ; Switch in the number of rows.
 $C4EF DEC A         ; Count it down.
 $C4F0 JR NZ,$C4D4   ; Jump to #R$C4D4 until the rows are done.
; Put the stack back.
@label=DrawStrip_Finish
*$C4F2 LD SP,($A21D) ; {Fetch #R$A21D and return.
 $C4F6 RET           ; }
; Draw a shifted row that is flipped.
@label=DrawStripGraphic_MirroredShifted
*$C4F7 EX AF,AF'     ; Switch in the number of rows.
@label=DrawStripGraphic_MirroredLoop
*$C4F8 EX AF,AF'     ; Keep the number of rows in #REGa'.
 $C4F9 POP BC        ; {Fetch a row and point at the second byte.
 $C4FA LD L,B        ; }
 $C4FB LD A,(DE)     ; {Combine the bits which stay with the first byte of the
 $C4FC OR (HL)       ; buffer.
 $C4FD LD (DE),A     ; }
 $C4FE INC DE        ; {Move on to the next byte and page.
 $C4FF INC H         ; }
 $C500 LD A,(DE)     ; {Combine the bits which moved on.
 $C501 OR (HL)       ; }
 $C502 DEC H         ; {Point at the first byte of the image.
 $C503 LD L,C        ; }
 $C504 OR (HL)       ; {Combine its bits which stay and store the byte.
 $C505 LD (DE),A     ; }
 $C506 INC DE        ; {Move on to the next byte and page.
 $C507 INC H         ; }
 $C508 LD A,(DE)     ; {Combine the bits which moved on with the next byte of
 $C509 OR (HL)       ; the buffer.
 $C50A LD (DE),A     ; }
 $C50B DEC H         ; Go back to the first page.
 $C50C EX DE,HL      ; {Move on to the next row of the buffer.
 $C50D LD BC,$0016   ;
 $C510 ADD HL,BC     ;
 $C511 EX DE,HL      ; }
 $C512 EX AF,AF'     ; Switch in the number of rows.
 $C513 DEC A         ; Count it down.
 $C514 JR NZ,$C4F8   ; Jump to #R$C4F8 until the rows are done.
 $C516 JR $C4F2      ; Jump to #R$C4F2.
; Draw an aligned image.
@label=DrawStripGraphic_Aligned
*$C518 EX DE,HL      ; Put the buffer address in #REGhl.
 $C519 LD A,($A252)  ; {Fetch #R$A252 and test it.
 $C51C AND A         ; }
 $C51D JR NZ,$C533   ; Jump to #R$C533 if it is set.
 $C51F LD BC,$0017   ; Set #REGbc to #N$0017.
 $C522 EX AF,AF'     ; Switch in the number of rows.
@label=DrawStripGraphic_AlignedLoop
*$C523 EX AF,AF'     ; Keep the number of rows in #REGa'.
 $C524 POP DE        ; Fetch a row of the image.
 $C525 LD A,(HL)     ; {Combine the first byte with the buffer.
 $C526 OR E          ;
 $C527 LD (HL),A     ; }
 $C528 INC HL        ; Move on to the next byte of the buffer.
 $C529 LD A,(HL)     ; {Combine the second byte with the buffer.
 $C52A OR D          ;
 $C52B LD (HL),A     ; }
 $C52C ADD HL,BC     ; Move on to the next row of the buffer.
 $C52D EX AF,AF'     ; Switch in the number of rows.
 $C52E DEC A         ; Count it down.
 $C52F JR NZ,$C523   ; Jump to #R$C523 until the rows are done.
 $C531 JR $C4F2      ; Jump to #R$C4F2.
; Draw an aligned image that is flipped.
@label=DrawStripGraphic_AlignedMirrored
*$C533 LD B,$F9      ; Point #REGb at #R$F900.
 $C535 EX AF,AF'     ; Switch in the number of rows.
@label=DrawStripGraphic_AlignedMirroredLoop
*$C536 EX AF,AF'     ; Keep the number of rows in #REGa'.
 $C537 POP DE        ; Fetch a row of the image.
 $C538 LD C,D        ; Point at the second byte, turned round.
 $C539 LD A,(BC)     ; {Combine it with the first byte of the buffer.
 $C53A OR (HL)       ;
 $C53B LD (HL),A     ; }
 $C53C INC HL        ; Move on to the next byte of the buffer.
 $C53D LD C,E        ; Point at the first byte, turned round.
 $C53E LD A,(BC)     ; {Combine it with the second byte of the buffer.
 $C53F OR (HL)       ;
 $C540 LD (HL),A     ; }
 $C541 LD DE,$0017   ; {Move on to the next row of the buffer.
 $C544 ADD HL,DE     ; }
 $C545 EX AF,AF'     ; Switch in the number of rows.
 $C546 DEC A         ; Count it down.
 $C547 JR NZ,$C536   ; Jump to #R$C536 until the rows are done.
 $C549 JR $C4F2      ; Jump to #R$C4F2.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$D2B2 }
; LIST#

; Draw Cell With Walls
;
; Used by the routine at #R$C0F8.
; .
; Draws the walls of a building in a cell of
; the town, using the lists of tiles in #R$626C.
; The list is chosen from the code of the cell
; and #R$A268. Nothing is drawn if the cell is
; empty. A list holds sixteen steps of two tiles
; each, one above the other. They are drawn in
; two runs of eight, going down and to the right
; and then up and to the right, with the second
; run flipped by #R$A252, to make the two walls
; which can be seen. Each step is drawn by
; #R$C59B, and nothing more is drawn when all of
; the bits in #R$A248 are set.
;
; HL The cell: the column in #REGl and the row in #REGh
;
; Find the list of tiles.
@label=DrawCellWithWalls
c$C54B CALL $C738    ; Call #R$C738.
 $C54E RET Z         ; Return if the cell is empty.
 $C54F LD ($A253),A  ; Set #R$A253.
 $C552 ADD A,A       ; Double the code.
 $C553 LD HL,$A268   ; {Add #R$A268.
 $C556 OR (HL)       ; }
 $C557 LD BC,$626C   ; Point #REGbc at #R$626C.
 $C55A CALL $C75C    ; Call #R$C75C.
 $C55D PUSH HL       ; {Copy the list address to #REGiy (using the stack).
 $C55E POP IY        ; }
; Find the position and draw tiles as they are.
 $C560 CALL $C6DC    ; Call #R$C6DC.
 $C563 XOR A         ; {Write #N$00 to *#R$A252.
 $C564 LD ($A252),A  ; }
 $C567 LD B,$08      ; Set a count of #N$08.
; Draw eight steps going down and to the right.
@label=DrawCellWithWalls_Down
*$C569 CALL $C59B    ; Call #R$C59B.
 $C56C LD HL,($A248) ; Fetch #R$A248.
 $C56F LD A,L        ; {Return if all sixteen bits are set.
 $C570 AND H         ;
 $C571 CPL           ;
 $C572 AND A         ;
 $C573 RET Z         ; }
 $C574 CALL $C445    ; Call #R$C445.
 $C577 DJNZ $C569    ; Jump to #R$C569 if there are any left.
; Move up by eight pixels to start the second run.
 $C579 LD HL,($A250) ; {Move #R$A250 up by eight pixels.
 $C57C LD DE,$0008   ;
 $C57F ADD HL,DE     ;
 $C580 LD ($A250),HL ; }
; Draw the rest of the tiles flipped.
 $C583 LD A,$01      ; {Write #N$01 to *#R$A252.
 $C585 LD ($A252),A  ; }
 $C588 LD B,$08      ; Set a count of #N$08.
; Draw eight steps going up and to the right.
@label=DrawCellWithWalls_Up
*$C58A CALL $C59B    ; Call #R$C59B.
 $C58D LD HL,($A248) ; Fetch #R$A248.
 $C590 LD A,L        ; {Return if all sixteen bits are set.
 $C591 AND H         ;
 $C592 CPL           ;
 $C593 AND A         ;
 $C594 RET Z         ; }
 $C595 CALL $C422    ; Call #R$C422.
 $C598 DJNZ $C58A    ; Jump to #R$C58A if there are any left.
 $C59A RET           ; Return.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$D372 }
; LIST#

; Draw Wall Strips
;
; Used by the routine at #R$C54B.
; .
; Draws two wall tiles, one above the other,
; for a step along the edge of a cell. A bit in
; #R$A248 is set to record that the column has a
; wall in it, and if it already has one the step
; is skipped. The horizontal position in #R$A24E
; chooses the bit, and is written into the BIT
; instruction at #R$C5BB and the SET instruction
; at #R$C59B(#N$C5BF). The lower tile is drawn at
; #R$A250 by #R$C5F9, and the upper tile #N$40
; above it. The step is skipped if either
; position is off the screen. It always moves on
; to the next two tiles of the list.
;
; BC The count of steps in #REGb
; IY The address of the first tile of the step in its list
;
; Return unless the column is on the screen.
@label=DrawWallStrips
c$C59B LD HL,($A24E) ; Fetch #R$A24E.
 $C59E LD A,H        ; {Jump to #R$C5E4 if it is off the screen.
 $C59F AND A         ;
 $C5A0 JR NZ,$C5E4   ; }
; Keep the position and change the BIT and SET
; instructions.
 $C5A2 LD A,L        ; {Keep the horizontal position in #REGe.
 $C5A3 LD E,A        ; }
 $C5A4 RRCA          ; Move the bits which say which sixteen pixels it is in...
 $C5A5 AND %00111000 ; ...to make the number of a bit...
 $C5A7 OR %01000110  ; ...in the second byte of a BIT instruction.
 $C5A9 LD ($C5BC),A  ; Store it as the second byte of the BIT instruction at
                     ; #R$C5BB.
 $C5AC OR %10000000  ; Change it to the second byte of a SET instruction.
 $C5AE LD ($C5C0),A  ; Store it as the second byte of the SET instruction
                     ; at #R$C59B(#N$C5C0).
; Choose the byte of #R$A248.
 $C5B1 LD A,L        ; Fetch the horizontal position again.
 $C5B2 RLCA          ; Move the top bit of the horizontal position...
 $C5B3 AND %00000001 ; ...into a single bit.
 $C5B5 LD HL,$A248   ; Point #REGhl at #R$A248.
 $C5B8 JR Z,$C5BB    ; Jump to #R$C5BB if the position is in the first half of
                     ; the screen.
 $C5BA INC HL        ; Point #REGhl at the second byte of the flags.
; Test and set the flag for this column.
@label=DrawWallStrips_Test
*$C5BB BIT 0,(HL)    ; {Jump to #R$C5E4 if there is already a wall there.
 $C5BD JR NZ,$C5E4   ; }
 $C5BF SET 0,(HL)    ; Set the bit.
; Draw the lower tile.
 $C5C1 LD HL,($A250) ; Fetch #R$A250.
 $C5C4 LD A,H        ; {Jump to #R$C5E4 if it is off the screen.
 $C5C5 AND A         ;
 $C5C6 JR NZ,$C5E4   ; }
 $C5C8 LD D,L        ; Keep the low byte of the vertical position in #REGd.
 $C5C9 PUSH BC       ; {Stash the count of steps and the position on the stack.
 $C5CA PUSH DE       ; }
 $C5CB CALL $C5F9    ; Call #R$C5F9.
 $C5CE POP DE        ; Restore the position.
 $C5CF INC IY        ; Move on to the next tile of the list.
; Draw the upper tile.
 $C5D1 LD HL,($A250) ; Fetch #R$A250.
 $C5D4 LD BC,$0040   ; Set #REGbc to #N$0040.
 $C5D7 ADD HL,BC     ; Move up by that much.
 $C5D8 LD A,H        ; {Jump to #R$C5E0 if it is off the screen.
 $C5D9 AND A         ;
 $C5DA JR NZ,$C5E0   ; }
 $C5DC LD D,L        ; Keep the low byte of the vertical position in #REGd.
 $C5DD CALL $C5F9    ; Call #R$C5F9.
; Restore the count and move on.
@label=DrawWallStrips_RestoreCount
*$C5E0 POP BC        ; Restore the count of steps.
 $C5E1 INC IY        ; Move on to the next tile of the list.
 $C5E3 RET           ; Return.
; There is nothing to draw, so skip both of the tiles.
@label=DrawWallStrips_Skip
*$C5E4 INC IY        ; {Move on past the two tiles of the list.
 $C5E6 INC IY        ; }
 $C5E8 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$D3C2 }
; LIST#

; Clip Wall Strip Top
;
; Used by the routine at #R$C5F9.
; .
; Skips the rows of a wall tile that are
; below #R$D6EB. #REGa is the number of those
; rows, negated. It starts drawing at #N$48 and
; jumps to #R$C611.
;
; A The number of rows below the buffer, negated
; HL The address of the image
;
; Skip the rows that are below the buffer.
@label=ClipWallStripTop
c$C5E9 NEG           ; {Make the number of rows positive and keep it in #REGc.
 $C5EB LD C,A        ; }
 $C5EC LD A,(HL)     ; {Fetch the height of the image.
 $C5ED INC HL        ; }
 $C5EE SUB C         ; Subtract the rows that are below.
 $C5EF RET M         ; {Return if there are none left.
 $C5F0 RET Z         ; }
 $C5F1 LD B,$00      ; {Skip the image data for those rows.
 $C5F3 ADD HL,BC     ;
 $C5F4 ADD HL,BC     ; }
 $C5F5 LD D,$48      ; Set the vertical position to #N$48.
 $C5F7 JR $C611      ; Jump to #R$C611.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$D415 }
; LIST#

; Draw Wall Strip
;
; Used by the routine at #R$C59B.
; .
; Draws a wall tile, sixteen pixels wide,
; into #R$D6EB. The image has the same format as
; #R$C4A7, but it replaces the buffer. The masks
; from #R$C6C3 are written into the AND
; instructions. The image is flipped if #R$A252
; is not zero.
;
; D The vertical position of the bottom of the tile
; E The horizontal position of the tile
; IY The address of the tile number
;
; Find the image and clip it to the buffer.
@label=DrawWallStrip
c$C5F9 LD A,(IY+$00) ; Fetch the tile number.
 $C5FC LD BC,$8FF8   ; Point #REGbc at #R$8FF8.
 $C5FF CALL $C75C    ; Call #R$C75C.
 $C602 LD A,D        ; {Subtract #N$48 from the vertical position.
 $C603 SUB $48       ; }
 $C605 JR C,$C5E9    ; Jump to #R$C5E9 if it is below the bottom.
 $C607 SUB $70       ; Subtract #N$70.
 $C609 RET NC        ; Return if it is above the top.
 $C60A NEG           ; Make it the number of rows in the buffer.
 $C60C CP (HL)       ; Compare it with the height of the image.
 $C60D JR C,$C610    ; Jump to #R$C610 if it is fewer.
 $C60F LD A,(HL)     ; Use the height of the image.
; Draw the rows that are in the buffer.
@label=DrawWallStrip_FirstRow
*$C610 INC HL        ; Move on to the first row of the image.
; This entry point is used by the routine at #R$C5E9.
@label=DrawWallStrip_Rows
*$C611 EX AF,AF'     ; Keep the number of rows in #REGa'.
 $C612 EX DE,HL      ; Put the position in #REGhl.
 $C613 CALL $D233    ; Call #R$D233.
 $C616 EX DE,HL      ; Switch the buffer and the image.
 $C617 PUSH HL       ; Stash the image on the stack.
; Write the masks from #R$C6C3 into the AND
; instructions.
 $C618 LD A,($A24E)  ; Fetch #R$A24E.
 $C61B RRCA          ; Move the shift into the lowest bits.
 $C61C AND %00000011 ; Keep the lowest two bits.
 $C61E LD HL,$C6C3   ; Point #REGhl at #R$C6C3.
 $C621 CALL $D275    ; Call #R$D275.
 $C624 LD A,(HL)     ; Fetch the mask.
 $C625 LD ($C650),A  ; {Set the left-hand AND operands.
 $C628 LD ($C677),A  ; }
 $C62B CPL           ; Complement the mask.
 $C62C LD ($C65E),A  ; {Set the right-hand AND operands.
 $C62F LD ($C686),A  ; }
; Choose the draw path.
 $C632 POP HL        ; Restore the image from the stack.
 $C633 LD ($A21D),SP ; Set #R$A21D.
 $C637 LD SP,HL      ; Point the stack at the image.
 $C638 LD A,($A24E)  ; Fetch #R$A24E.
 $C63B AND %00000110 ; Keep bits 1 and 2.
 $C63D JR Z,$C696    ; Jump to #R$C696 if the image is aligned.
 $C63F OR %11110000  ; Set the high bits of the page.
 $C641 LD H,A        ; Set #REGh.
 $C642 LD A,($A252)  ; Fetch #R$A252.
 $C645 AND A         ; {Jump to #R$C671 if it is set.
 $C646 JR NZ,$C671   ; }
 $C648 SET 3,H       ; Set bit 3 of #REGh.
 $C64A EX AF,AF'     ; Switch in the number of rows.
; Draw a shifted row.
@label=DrawWallStrip_ShiftedRow
*$C64B EX AF,AF'     ; Keep the number of rows in #REGa'.
 $C64C POP BC        ; {Fetch a row and point at the first byte.
 $C64D LD L,C        ; }
 $C64E LD A,(DE)     ; Fetch the first byte of the buffer.
 $C64F AND %00000000 ; Keep the bits which are not covered.
 $C651 OR (HL)       ; {Combine it and store the byte.
 $C652 LD (DE),A     ; }
 $C653 INC DE        ; {Move on to the next byte and page.
 $C654 INC H         ; }
 $C655 LD A,(HL)     ; Look up the bits which moved on.
 $C656 DEC H         ; Go back to the first page.
 $C657 LD L,B        ; Point at the second byte of the image.
 $C658 OR (HL)       ; {Combine it and store the byte.
 $C659 LD (DE),A     ; }
 $C65A INC DE        ; {Move on to the next byte and page.
 $C65B INC H         ; }
 $C65C LD A,(DE)     ; Fetch the third byte of the buffer.
 $C65D AND %00000000 ; Keep the bits which are not covered.
 $C65F OR (HL)       ; {Combine it and store the byte.
 $C660 LD (DE),A     ; }
 $C661 DEC H         ; Go back to the first page.
 $C662 EX DE,HL      ; {Move on to the next row of the buffer.
 $C663 LD BC,$0016   ;
 $C666 ADD HL,BC     ;
 $C667 EX DE,HL      ; }
 $C668 EX AF,AF'     ; Switch in the number of rows.
 $C669 DEC A         ; Count it down.
 $C66A JR NZ,$C64B   ; Jump to #R$C64B until the rows are done.
; Put the stack back.
@label=DrawWallStrip_Finish
*$C66C LD SP,($A21D) ; {Fetch #R$A21D and return.
 $C670 RET           ; }
; Draw a shifted row that is flipped.
@label=DrawWallStrip_Flipped
*$C671 EX AF,AF'     ; Switch in the number of rows.
@label=DrawWallStrip_FlippedRow
*$C672 EX AF,AF'     ; Keep the number of rows in #REGa'.
 $C673 POP BC        ; {Fetch a row and point at the second byte.
 $C674 LD L,B        ; }
 $C675 LD A,(DE)     ; Fetch the first byte of the buffer.
 $C676 AND %00000000 ; Keep the bits which are not covered.
 $C678 OR (HL)       ; {Combine it and store the byte.
 $C679 LD (DE),A     ; }
 $C67A INC DE        ; {Move on to the next byte and page.
 $C67B INC H         ; }
 $C67C LD B,(HL)     ; Look up the bits which moved on.
 $C67D DEC H         ; Go back to the first page.
 $C67E LD L,C        ; Point at the first byte of the image.
 $C67F LD A,(HL)     ; Fetch the bits which stay.
 $C680 OR B          ; {Combine them and store the byte.
 $C681 LD (DE),A     ; }
 $C682 INC DE        ; {Move on to the next byte and page.
 $C683 INC H         ; }
 $C684 LD A,(DE)     ; Fetch the third byte of the buffer.
 $C685 AND %00000000 ; Keep the bits which are not covered.
 $C687 OR (HL)       ; {Combine it and store the byte.
 $C688 LD (DE),A     ; }
 $C689 DEC H         ; Go back to the first page.
 $C68A EX DE,HL      ; {Move on to the next row of the buffer.
 $C68B LD BC,$0016   ;
 $C68E ADD HL,BC     ;
 $C68F EX DE,HL      ; }
 $C690 EX AF,AF'     ; Switch in the number of rows.
 $C691 DEC A         ; Count it down.
 $C692 JR NZ,$C672   ; Jump to #R$C672 until the rows are done.
 $C694 JR $C66C      ; Jump to #R$C66C.
; Draw an aligned image.
@label=DrawWallStrip_Aligned
*$C696 EX DE,HL      ; Put the buffer address in #REGhl.
 $C697 LD A,($A252)  ; {Fetch #R$A252 and test it.
 $C69A AND A         ; }
 $C69B JR NZ,$C6AD   ; Jump to #R$C6AD if it is set.
 $C69D LD BC,$0017   ; Set #REGbc to #N$0017.
 $C6A0 EX AF,AF'     ; Switch in the number of rows.
@label=DrawWallStrip_AlignedRow
*$C6A1 EX AF,AF'     ; Keep the number of rows in #REGa'.
 $C6A2 POP DE        ; Fetch a row of the image.
 $C6A3 LD (HL),E     ; {Store the first byte and move on.
 $C6A4 INC HL        ; }
 $C6A5 LD (HL),D     ; Store the second byte.
 $C6A6 ADD HL,BC     ; Move on to the next row of the buffer.
 $C6A7 EX AF,AF'     ; Switch in the number of rows.
 $C6A8 DEC A         ; Count it down.
 $C6A9 JR NZ,$C6A1   ; Jump to #R$C6A1 until the rows are done.
 $C6AB JR $C66C      ; Jump to #R$C66C.
; Draw an aligned image that is flipped.
@label=DrawWallStrip_FlippedAligned
*$C6AD LD B,$F9      ; Set #REGb to #N$F9.
 $C6AF EX AF,AF'     ; Switch in the number of rows.
@label=DrawWallStrip_FlippedAlignedRow
*$C6B0 EX AF,AF'     ; Keep the number of rows in #REGa'.
 $C6B1 POP DE        ; Fetch a row of the image.
 $C6B2 LD C,D        ; Point at the second byte, turned round.
 $C6B3 LD A,(BC)     ; {Store it in the first byte of the buffer.
 $C6B4 LD (HL),A     ; }
 $C6B5 INC HL        ; Move on to the next byte of the buffer.
 $C6B6 LD C,E        ; Point at the first byte, turned round.
 $C6B7 LD A,(BC)     ; {Store it in the second byte of the buffer.
 $C6B8 LD (HL),A     ; }
 $C6B9 LD DE,$0017   ; {Move on to the next row of the buffer.
 $C6BC ADD HL,DE     ; }
 $C6BD EX AF,AF'     ; Switch in the number of rows.
 $C6BE DEC A         ; Count it down.
 $C6BF JR NZ,$C6B0   ; Jump to #R$C6B0 until the rows are done.
 $C6C1 JR $C66C      ; Jump to #R$C66C.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$D425 }
; LIST#

; Wall Tile Masks
;
; The four masks used by #R$C5F9 to keep
; the bits of the buffer on the left of a wall
; tile. The index is the shift to the right in
; twos of pixels: #N($00), #N($02), #N$04 or
; #N$06.
@label=WallTileMasks
b$C6C3 DEFB $00      ; Shift #N$00: #N$00.
 $C6C4 DEFB $C0      ; Shift #N$02: #N$C0.
 $C6C5 DEFB $F0      ; Shift #N$04: #N$F0.
 $C6C6 DEFB $FC      ; Shift #N$06: #N$FC.
; View the equivalent data in;
; #LIST
; { #NIGHTSHADE$D4EF }
; LIST#

; Project Object
;
; Used by the routine at #R$BD62.
; .
; Works out where an object is on the
; screen, in the same way as #R$C6DC. It fetches
; the position from the slot, calls #R$C383, and
; jumps to #R$C6E9. The result is put in #R$A24E
; and #R$A250.
;
; IX The address of the object
;
; Fetch the position and convert it.
@label=ProjectObject
c$C6C7 LD L,(IX+$03) ; {Fetch the vertical position.
 $C6CA LD H,(IX+$04) ; }
 $C6CD CALL $C383    ; Call #R$C383.
 $C6D0 PUSH HL       ; Stash it on the stack.
 $C6D1 LD L,(IX+$01) ; {Fetch the horizontal position.
 $C6D4 LD H,(IX+$02) ; }
 $C6D7 CALL $C383    ; Call #R$C383.
 $C6DA JR $C6E9      ; Jump to #R$C6E9.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$D4F3 }
; LIST#

; Project Cell
;
; Used by the routines at #R$AB18, #R$C392 and #R$C54B.
; .
; Works out where the corner of the cell
; last set by #R$C738 is on the screen. With the
; distances from the sheriff as dx and dy, the
; horizontal position is (dx + dy + #N$00F0) /
; 2 and the vertical position is (dy - dx +
; #N$01B0) / 4. They are put in #R$A24E and
; #R$A250. When bit 0 of #R$A268 is set, the
; sheriff's position is turned round.
;
; .
;
; Set the position of the corner of the
; cell.
@label=ProjectCell
c$C6DC LD A,($A255)  ; {Fetch #R$A255 as a position in #REGhl.
 $C6DF LD L,$00      ;
 $C6E1 LD H,A        ; }
 $C6E2 PUSH HL       ; Stash it on the stack.
 $C6E3 LD A,($A254)  ; {Fetch #R$A254 as a position in #REGhl.
 $C6E6 LD L,$00      ;
 $C6E8 LD H,A        ; }
; This entry point is used by the routine at #R$C6C7.
; .
; Find the position on the screen. #REGhl
; is the horizontal position, and the vertical
; position is on the stack.
@label=ProjectCell_Position
*$C6E9 LD DE,($A27E) ; Fetch the sheriff's horizontal
                     ; position from #R$A27D(#N$A27E).
 $C6ED LD A,($A268)  ; Fetch #R$A268.
 $C6F0 AND %00000001 ; Keep the lowest bit.
 $C6F2 JR Z,$C6FC    ; Jump to #R$C6FC if the view is not rotated.
 $C6F4 LD A,E        ; {Complement #REGe.
 $C6F5 CPL           ;
 $C6F6 LD E,A        ; }
 $C6F7 LD A,D        ; {Complement #REGd.
 $C6F8 CPL           ; }
 $C6F9 AND %00001111 ; Keep the lowest four bits.
 $C6FB LD D,A        ; Set #REGd.
; Find the horizontal distance.
@label=ProjectCell_X
*$C6FC AND A         ; {Subtract the sheriff's position.
 $C6FD SBC HL,DE     ; }
 $C6FF EX DE,HL      ; Copy the distance into #REGde.
 $C700 POP HL        ; Restore the vertical position from the stack.
; Find the vertical distance.
 $C701 LD BC,($A280) ; Fetch the sheriff's vertical
                     ; position from #R$A27D(#N$A280).
 $C705 LD A,($A268)  ; Fetch #R$A268.
 $C708 AND %00000001 ; Keep the lowest bit.
 $C70A JR Z,$C714    ; Jump to #R$C714 if the view is not rotated.
 $C70C LD A,C        ; {Complement #REGc.
 $C70D CPL           ;
 $C70E LD C,A        ; }
 $C70F LD A,B        ; {Complement #REGb.
 $C710 CPL           ; }
 $C711 AND %00001111 ; Keep the lowest four bits.
 $C713 LD B,A        ; Set #REGb.
; Work out the screen position.
@label=ProjectCell_Y
*$C714 AND A         ; {Subtract the sheriff's position.
 $C715 SBC HL,BC     ; }
 $C717 PUSH HL       ; Stash the distance on the stack.
 $C718 LD BC,$00F0   ; Set #REGbc to #N$00F0.
 $C71B ADD HL,DE     ; {Add the two distances and #N$00F0.
 $C71C ADD HL,BC     ; }
 $C71D SRA H         ; {Halve it.
 $C71F RR L          ; }
 $C721 LD ($A24E),HL ; Set #R$A24E.
 $C724 POP HL        ; Restore the vertical distance from the stack.
 $C725 AND A         ; {Subtract the horizontal distance.
 $C726 SBC HL,DE     ; }
 $C728 LD BC,$01B0   ; Set #REGbc to #N$01B0.
 $C72B ADD HL,BC     ; Add it.
 $C72C SRA H         ; {Divide it by four.
 $C72E RR L          ;
 $C730 SRA H         ;
 $C732 RR L          ; }
 $C734 LD ($A250),HL ; {Set #R$A250 and return.
 $C737 RET           ; }
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$D508 }
; LIST#

; Get Map Cell
;
; Used by the routines at #R$B420, #R$B6CD, #R$C0F8, #R$C392 and #R$C54B.
; .
; Fetches the code of a cell from #R$5FB1,
; which is sixteen rows of sixteen. #REGl is the
; column and #REGh is the row. It sets #R$A254
; and #R$A255. When bit 0 of #R$A268 is set, the
; map is read from the end.
;
;   HL The cell: the column in #REGl and the row in #REGh
; O:A The code for the cell
; O:F The zero flag is set if the cell is empty
;
; Work out the number of the cell.
@label=GetMapCell
c$C738 LD ($A254),HL ; Set #R$A254 and #R$A255.
 $C73B LD A,L        ; {Put the column in #REGa and the row in #REGhl.
 $C73C LD L,H        ;
 $C73D LD H,$00      ; }
 $C73F ADD HL,HL     ; {Multiply the row by #N$10.
 $C740 ADD HL,HL     ;
 $C741 ADD HL,HL     ;
 $C742 ADD HL,HL     ; }
 $C743 OR L          ; {Add the column.
 $C744 LD L,A        ; }
; Point at the map.
 $C745 LD BC,$5FB1   ; Point #REGbc at #R$5FB1.
 $C748 LD A,($A268)  ; Fetch #R$A268.
 $C74B AND %00000001 ; Keep the lowest bit.
 $C74D JR Z,$C758    ; Jump to #R$C758 if the view is not rotated.
; Read from the end.
 $C74F LD A,L        ; {Complement #REGhl.
 $C750 CPL           ;
 $C751 LD L,A        ;
 $C752 LD A,H        ;
 $C753 CPL           ;
 $C754 LD H,A        ; }
 $C755 LD BC,$60B1   ; Point #REGbc one past #R$5FB1.
; Fetch the code.
@label=GetMapCell_Fetch
*$C758 ADD HL,BC     ; Add the address of the map.
 $C759 LD A,(HL)     ; {Fetch the code and return.
 $C75A AND A         ;
 $C75B RET           ; }
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$D564 }
; LIST#

; Get Table Entry
;
; Used by the routines at #R$A8D5, #R$AB18, #R$ACF6, #R$AE10, #R$B28C, #R$B8E7,
; #R$BB0B, #R$BDAE, #R$C392, #R$C3EF, #R$C468, #R$C54B, #R$C5F9, #R$C766,
; #R$C795, #R$C977, #R$C9EC, #R$CB03, #R$CFA1, #R$CFDE, #R$D400 and #R$D565.
; .
; Fetches the word at #REGbc plus twice
; #REGa into #REGhl.
;
;   A The number of the entry
;   BC The address of the table
; O:HL The word from the table
;
; Find the address of the entry.
@label=GetTableEntry
c$C75C LD L,A        ; {Put the number of the entry in #REGhl.
 $C75D LD H,$00      ; }
 $C75F ADD HL,HL     ; Double it.
 $C760 ADD HL,BC     ; Add the address of the table.
; Fetch the word.
 $C761 LD A,(HL)     ; Fetch the low byte.
 $C762 INC HL        ; Move on to the high byte.
 $C763 LD H,(HL)     ; Fetch it into #REGh.
 $C764 LD L,A        ; {Put the low byte in #REGl and return.
 $C765 RET           ; }
; View the equivalent code in;
; #LIST
; { #MARTIANOIDS$C010 }
; { #NIGHTSHADE$D589 }
; { #PENTAGRAM$D692 }
; LIST#

; Run Table Routine
;
; Used by the routines at #R$A36D, #R$AB77, #R$B85B, #R$C1E7, #R$CC42 and
; #R$CD8C.
; .
; Calls #R$C75C to fetch a routine from a
; table, then jumps to #R$5CB0 so that the
; routine returns to the caller of this one.
;
; A The number of the entry
; BC The address of the table
;
; Fetch the address and jump to it.
@label=RunTableRoutine
c$C766 CALL $C75C    ; Call #R$C75C.
 $C769 JP $5CB0      ; Jump to #R$5CB0.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$D593 }
; LIST#

; Handle Dying
;
; Type #N$09: a figure which has been shot
; and is falling. It subtracts byte #N$0C from
; byte #N$0D and adds #N$02 to the speed, so the
; figure rises and then falls, and it calls
; #R$AF4F. #R$B782 starts the speed at #N$FA and
; the height at #N$18. When the height is zero it
; makes the type #N$08 and sets byte #N$0C to
; #N$20.
;
; IX The address of the object
;
; Turn into a body if the height is zero.
@label=HandleDying
c$C76C LD A,(IX+$0D)   ; Fetch byte #N$0D.
 $C76F AND A           ; {Jump to #R$C77B if it is not zero.
 $C770 JR NZ,$C77B     ; }
 $C772 LD (IX+$00),$08 ; Make the type #N$08.
 $C776 LD (IX+$0C),$20 ; {Set byte #N$0C to #N$20 and return.
 $C77A RET             ; }
; Move the figure.
@label=HandleDying_Move
*$C77B SUB (IX+$0C)    ; Subtract byte #N$0C from the height.
 $C77E JP M,$C790      ; Jump to #R$C790 if it is negative.
 $C781 LD (IX+$0D),A   ; Set byte #N$0D.
 $C784 CALL $AF4F      ; Call #R$AF4F.
 $C787 LD A,(IX+$0C)   ; Fetch byte #N$0C.
 $C78A ADD A,$02       ; Add #N$02.
 $C78C LD (IX+$0C),A   ; {Set byte #N$0C and return.
 $C78F RET             ; }
; Put the figure on the ground.
@label=HandleDying_Land
*$C790 LD (IX+$0D),$00 ; {Set byte #N$0D to #N$00 and return.
 $C794 RET             ; }

; Handle Smoke
;
; Type #N$07: a puff of smoke. It counts
; down byte #N$0C, then calls #R$C75C to fetch a
; sprite list from #R$C7AB. It jumps to #R$C7BB
; when the counter goes below zero.
;
; IX The address of the object
;
; Count down the frames.
@label=HandleSmoke
c$C795 DEC (IX+$0C)  ; Count down byte #N$0C.
 $C798 JP M,$C7BB    ; Jump to #R$C7BB if it is negative.
; Point at #R$C7AB.
 $C79B LD BC,$C7AB   ; Point #REGbc at #R$C7AB.
; This entry point is used by the routine at #R$B719.
; .
; Choose the sprite list. #REGbc holds the
; table.
@label=ChooseSpriteList
*$C79E LD A,(IX+$0C) ; Fetch byte #N$0C.
 $C7A1 CALL $C75C    ; Call #R$C75C.
 $C7A4 LD (IX+$0E),L ; {Set the sprite list and return.
 $C7A7 LD (IX+$0F),H ;
 $C7AA RET           ; }

; Smoke Sprite Lists
;
; The two sprite lists for a puff of
; smoke. The words point to #R$C7AF and
; #R$C7B3.
@label=SmokeSpriteLists
g$C7AB DEFW $C7AF           ; {The addresses of #R$C7AF and #R$C7B3.
 $C7AD DEFW $C7B3           ; }
; The first frame.
@label=SmokeSpriteLists_FirstFrame
 $C7AF DEFB $F8,$0F,$07,$80 ; Sprite #N$07 at offset (#N($F8), #N$0F).
                            ; #SPRITE$07(flash-1*).
; The second frame.
@label=SmokeSpriteLists_SecondFrame
 $C7B3 DEFB $F8,$0F,$09,$80 ; Sprite #N$09 at offset (#N($F8), #N$0F).
                            ; #SPRITE$09(flash-3*).

; Handle Body
;
; Type #N$08: a body lying on the ground.
; It counts down byte #N$0C, then makes the type
; #N$00. #R$C76C makes it last for #N$20 frames.
;
; IX The address of the object
;
; Count down the frames.
@label=HandleBody
c$C7B7 DEC (IX+$0C)    ; {Count down byte #N$0C and return if it is not zero.
 $C7BA RET NZ          ; }
; This entry point is used by the routines at #R$A4C9, #R$A8D5, #R$A9BF,
; #R$AA7F, #R$B347, #R$B719, #R$B8E7, #R$B990 and #R$C795.
; .
; Make the type #N$00.
@label=HandleBody_Remove
*$C7BB LD (IX+$00),$00 ; {Make the type #N$00 and return.
 $C7BF RET             ; }

; Handle Single Frame Object
;
; Type #N$05: an object which is drawn
; once and then removed. #R$CA30 makes it. It
; calls #R$BD52 and then makes the type #N$00.
;
; IX The address of the object
;
; Draw the object and remove it.
@label=HandleSingleFrameObject
c$C7C0 CALL $BD52      ; Call #R$BD52.
 $C7C3 LD (IX+$00),$00 ; {Make the type #N$00 and return.
 $C7C7 RET             ; }

; Remove All Objects
;
; Used by the routines at #R$B2E9, #R$B985, #R$BB3A, #R$C049 and #R$C7D1.
; .
; Jumps to #R$D6E1 to fill #N$00F0 bytes
; from #R$A27D with zero, which empties all
; fifteen object slots.
;
; .
;
; Set the address and the count.
@label=RemoveAllObjects
c$C7C8 LD HL,$A27D   ; Point #REGhl at #R$A27D.
 $C7CB LD BC,$00F0   ; Set #REGbc to #N$00F0.
 $C7CE JP $D6E1      ; Jump to #R$D6E1.

; Return To Town
;
; Used by the routine at #R$A36D.
; .
; Clears #R$D6EB and the object slots. It
; sets #R$A267 to #N($04), clears #R$A265 and sets
; #R$A266 to #COLOUR$47, then jumps to #R$A3B3.
;
; .
;
; Clear the buffer and the objects.
@label=ReturnToTown
c$C7D1 CALL $D0B7    ; Call #R$D0B7.
 $C7D4 CALL $C7C8    ; Call #R$C7C8.
; Put the game back in the town.
 $C7D7 LD A,$04      ; {Set #R$A267 to #N$04.
 $C7D9 LD ($A267),A  ; }
 $C7DC XOR A         ; {Clear #R$A265.
 $C7DD LD ($A265),A  ; }
 $C7E0 LD A,$47      ; {Set #R$A266 to #COLOUR$47.
 $C7E2 LD ($A266),A  ; }
 $C7E5 JP $A3B3      ; Jump to #R$A3B3.

; Make Bag
;
; Puts a type #N$04 bag in the first free slot
; among #R$A27D, #R$A28D and #R$A29D. It does this
; on every fourth frame, copies #R$C847, sets a
; random sideways speed from #R$C85B and #R$A261,
; a random downward speed, and a random horizontal
; start. Then it takes one from #R$A264.
;
; .
;
; Return unless it is time to make a bag.
@label=MakeBag
c$C7E8 LD A,($A216)  ; Fetch #R$A216.
 $C7EB AND %00000011 ; Keep the lowest two bits.
 $C7ED RET NZ        ; Return unless this is every fourth frame.
; Look for a free slot among the first three.
 $C7EE LD HL,$A27D   ; Point #REGhl at #R$A27D.
 $C7F1 LD DE,$0010   ; Set the size of an object slot in #REGde.
 $C7F4 LD B,$03      ; Set a count of #N$03.
@label=MakeBag_FindSlot
*$C7F6 LD A,(HL)     ; {Jump to #R$C7FE if the slot is free.
 $C7F7 AND A         ;
 $C7F8 JR Z,$C7FE    ; }
 $C7FA ADD HL,DE     ; Move on to the next slot.
 $C7FB DJNZ $C7F6    ; Jump to #R$C7F6 until all three have been tried.
 $C7FD RET           ; Return.
; Copy #R$C847 into the slot.
@label=MakeBag_FillSlot
*$C7FE PUSH HL       ; {Copy #REGhl to #REGiy (using the stack).
 $C7FF POP IY        ; }
 $C801 EX DE,HL      ; {Point #REGde at the slot and set #REGbc to its size.
 $C802 LD C,L        ;
 $C803 LD B,H        ; }
 $C804 LD HL,$C847   ; Point #REGhl at #R$C847.
 $C807 LDIR          ; Copy the template into the slot.
; Work out the sideways speed.
 $C809 LD A,($A261)  ; {Set #REGbc to #R$A261.
 $C80C LD C,A        ;
 $C80D LD B,$00      ; }
 $C80F LD HL,$C85B   ; {Point #REGhl at the #R$C85B entry for #R$A261.
 $C812 ADD HL,BC     ; }
 $C813 LD C,(HL)     ; Fetch the bound for this skill.
 $C814 LD A,($A218)  ; {Fetch #R$A218 and keep it in #REGb.
 $C817 LD B,A        ; }
 $C818 AND %01111111 ; Keep the lowest seven bits.
 $C81A ADD A,$08     ; Add #N$08.
 $C81C CALL $C863    ; Call #R$C863.
 $C81F BIT 7,B       ; {Jump to #R$C825 if bit 7 of the random number is not
 $C821 JR Z,$C825    ; set.}
 $C823 NEG           ; Make the sideways speed negative.
@label=MakeBag_SetSpeeds
*$C825 LD (IY+$0A),A ; Set the sideways speed.
; Work out the downward speed.
 $C828 LD A,($A219)  ; Fetch #R$A218(#N$A219).
 $C82B AND %00001111 ; Keep the lowest four bits.
 $C82D SLA C         ; Double the bound.
 $C82F ADD A,C       ; Add it.
 $C830 NEG           ; Make it negative.
 $C832 LD (IY+$0B),A ; Set the downward speed.
; Set the horizontal start and take one from
; #R$A264.
 $C835 LD A,($A21A)  ; Fetch #R$A21A.
 $C838 AND %01111111 ; Keep the lowest seven bits.
 $C83A ADD A,$40     ; Add #N$40.
 $C83C LD (IY+$02),A ; Set the horizontal position.
 $C83F LD A,($A264)  ; {Take one from #R$A264 and return.
 $C842 DEC A         ;
 $C843 LD ($A264),A  ;
 $C846 RET           ; }

; Bag Template
;
; The initial contents of a slot for a bag
; (type #N$04). The final two bytes point to
; #R$C857.
@label=BagTemplate
b$C847 DEFB $04,$00,$00,$00,$C0,$00,$00,$00 ; {Type, position, speed, size and
 $C84F DEFB $08,$08,$00,$00,$00,$00         ; counters.}
 $C855 DEFW $C857                           ; The address of #R$C857.
; The sprite list.
@label=BagSpriteList
 $C857 DEFB $F4,$F4,$29,$80                 ; Sprite #N$29 at offset (#N($F4), #N$F4).
                                            ; #SPRITE$29(money-bag*).

; Bag Speeds
;
; One number for each of the eight skill
; levels, from #N$0F to #N$2B in steps of #N$04.
; #R$C7E8 uses it as the upper bound of the
; sideways speed and, doubled, as the downward
; speed.
@label=BagSpeeds
b$C85B DEFB $0F      ; Skill #N$00: #N$0F.
 $C85C DEFB $13      ; Skill #N$01: #N$13.
 $C85D DEFB $17      ; Skill #N$02: #N$17.
 $C85E DEFB $1B      ; Skill #N$03: #N$1B.
 $C85F DEFB $1F      ; Skill #N$04: #N$1F.
 $C860 DEFB $23      ; Skill #N$05: #N$23.
 $C861 DEFB $27      ; Skill #N$06: #N$27.
 $C862 DEFB $2B      ; Skill #N$07: #N$2B.

; Reduce Number
;
; Used by the routine at #R$C7E8.
; .
; Subtracts #N$08 from #REGa until it is
; less than #REGc.
;
;   A The number
;   C The number which #REGa must be below
; O:A The result
;
; Subtract #N$08 until #REGa is less than
; #REGc.
@label=ReduceNumber
c$C863 CP C          ; {Return if #REGa is less than #REGc.
 $C864 RET C         ; }
 $C865 SUB $08       ; {Subtract #N$08 and jump to #R$C863.
 $C867 JR $C863      ; }

; Handle Bag
;
; Type #N$04: a bag falling in the bag
; stage. A hit adds #N$0100 to #R$A257 and removes
; the bag. Otherwise the speeds in bytes #N$0A and
; #N$0B are added to the position, and the bag is
; removed if it leaves the screen.
;
; IX The address of the bag
;
; Jump to #R$C8AF if the shot has hit the bag.
@label=HandleBag
c$C869 CALL $C8C8      ; Call #R$C8C8.
 $C86C JR C,$C8AF      ; Jump to #R$C8AF if the shot is touching.
; Move the bag sideways.
 $C86E LD L,(IX+$01)   ; {Fetch the horizontal position.
 $C871 LD H,(IX+$02)   ; }
 $C874 LD E,(IX+$0A)   ; Fetch the horizontal speed.
 $C877 CALL $C8F7      ; Call #R$C8F7.
 $C87A LD A,H          ; {Jump to #R$C8C3 if it is less than #N$10.
 $C87B CP $10          ;
 $C87D JR C,$C8C3      ; }
 $C87F CP $D8          ; {Jump to #R$C8C3 if it is #N$D8 or more.
 $C881 JR NC,$C8C3     ; }
 $C883 LD (IX+$01),L   ; {Set the horizontal position.
 $C886 LD (IX+$02),H   ; }
 $C889 LD L,H          ; {Make the pixel the screen position.
 $C88A LD H,$00        ; }
 $C88C LD ($A24E),HL   ; Set #R$A24E.
; Move the bag down.
 $C88F LD L,(IX+$03)   ; {Fetch the vertical position.
 $C892 LD H,(IX+$04)   ; }
 $C895 LD E,(IX+$0B)   ; Fetch the vertical speed.
 $C898 CALL $C8F7      ; Call #R$C8F7.
 $C89B LD A,H          ; {Jump to #R$C8C3 if it is less than #N$30.
 $C89C CP $30          ;
 $C89E JR C,$C8C3      ; }
 $C8A0 LD (IX+$03),L   ; {Set the vertical position.
 $C8A3 LD (IX+$04),H   ; }
 $C8A6 LD L,H          ; {Make the pixel the screen position.
 $C8A7 LD H,$00        ; }
 $C8A9 LD ($A250),HL   ; Set #R$A250.
 $C8AC JP $BD65        ; Jump to #R$BD65.
; Add #N$0100 to the bounty.
@label=HandleBag_Hit
*$C8AF LD BC,$0100     ; Set #REGbc to #N$0100.
 $C8B2 CALL $D354      ; Call #R$D354.
 $C8B5 CALL $D390      ; Call #R$D390.
; Play the sound and remove the bag.
@label=HandleBag_PlaySound
 $C8B8 LD A,$04        ; {Set #R$A23C to #N$04.
 $C8BA LD ($A23C),A    ; }
 $C8BD LD HL,$AECF     ; {Set #R$A23D to #R$AECF.
 $C8C0 LD ($A23D),HL   ; }
@label=RemoveBag
*$C8C3 LD (IX+$00),$00 ; {Make the type #N$00 and return.
 $C8C7 RET             ; }

; Check Shot Hit
;
; Used by the routine at #R$C869.
; .
; Tests whether the object is touching the
; shot in #R$A34D. The distances between the
; positions must both be less than the sum of the
; sizes.
;
;   IX The address of the object
; O:F The carry flag is set if the shot is touching the object
;
; Return unless there is a shot in #R$A34D.
@label=CheckShotHit
c$C8C8 LD IY,$A34D    ; Point #REGiy at #R$A34D.
 $C8CC LD A,(IY+$00)  ; {Return if #R$A34D is free.
 $C8CF AND A          ;
 $C8D0 RET Z          ; }
; Test the horizontal distance.
 $C8D1 LD A,(IX+$08)  ; {Add the horizontal sizes into #REGc.
 $C8D4 ADD A,(IY+$08) ;
 $C8D7 LD C,A         ; }
 $C8D8 LD A,(IX+$02)  ; {Subtract the horizontal positions.
 $C8DB SUB (IY+$02)   ; }
 $C8DE JR NC,$C8E2    ; Jump to #R$C8E2 if it is not negative.
 $C8E0 NEG            ; Make it positive.
@label=CheckShotHit_Horizontal
*$C8E2 CP C           ; {Return if the shot is too far away.
 $C8E3 RET NC         ; }
; Test the vertical distance.
 $C8E4 LD A,(IX+$09)  ; {Add the vertical sizes into #REGc.
 $C8E7 ADD A,(IY+$09) ;
 $C8EA LD C,A         ; }
 $C8EB LD A,(IX+$04)  ; {Subtract the vertical positions.
 $C8EE SUB (IY+$04)   ; }
 $C8F1 JR NC,$C8F5    ; Jump to #R$C8F5 if it is not negative.
 $C8F3 NEG            ; Make it positive.
@label=CheckShotHit_Vertical
*$C8F5 CP C           ; {Set carry if the shot is touching and return.
 $C8F6 RET            ; }

; Add Speed To Position
;
; Used by the routine at #R$C869.
; .
; Adds a signed speed to a position. The
; speed is multiplied by #N$10, so the high byte of
; the position is the pixel and the low byte is a
; fraction of a pixel.
;
;   E The speed
;   HL The position
; O:HL The new position
;
; Sign-extend the speed into #REGde.
@label=AddSpeedToPosition
c$C8F7 XOR A         ; Clear #REGa.
 $C8F8 BIT 7,E       ; {Jump to #R$C8FD if the speed is not negative.
 $C8FA JR Z,$C8FD    ; }
 $C8FC CPL           ; Set #REGa to #N$FF.
; Multiply the speed by #N$10 and add it.
@label=AddSpeedToPosition_Multiply
*$C8FD LD D,A        ; Put the high byte in #REGd.
 $C8FE SLA E         ; {Multiply the speed by #N$10.
 $C900 RL D          ;
 $C902 SLA E         ;
 $C904 RL D          ;
 $C906 SLA E         ;
 $C908 RL D          ;
 $C90A SLA E         ;
 $C90C RL D          ; }
 $C90E ADD HL,DE     ; {Add it to the position and return.
 $C90F RET           ; }

; Handle Mounted Sheriff
;
; Type #N$15: the sheriff on a horse. On every
; fourth frame it counts #R$A209 down. When that
; reaches zero, #R$A21F is set to #N$0A, the speed to
; #N$08, and the type to #N$01.
;
; IX The address of the sheriff
;
; Jump to #R$C930 unless it is time to count
; down.
@label=HandleMountedSheriff
c$C910 LD A,($A216)    ; Fetch #R$A216.
 $C913 ADD A,$02       ; Add #N$02.
 $C915 AND %00000011   ; Keep the lowest two bits.
 $C917 JR NZ,$C930     ; Jump to #R$C930 if this is not every fourth frame.
; Count down #R$A209.
 $C919 LD HL,$A209     ; Point #REGhl at #R$A209.
 $C91C LD A,(HL)       ; {Jump to #R$C930 if #R$A209 is zero.
 $C91D AND A           ;
 $C91E JR Z,$C930      ; }
 $C920 DEC (HL)        ; Count #R$A209 down.
 $C921 JR NZ,$C930     ; Jump to #R$C930 if it is not zero.
; Get off the horse.
 $C923 LD A,$0A        ; {Set #R$A21F to #N$0A.
 $C925 LD ($A21F),A    ; }
 $C928 LD (IX+$05),$08 ; Set the speed to #N$08.
 $C92C LD (IX+$00),$01 ; Make the type #N$01.
; Continue on to #R$C930.

; Handle Sheriff
;
; Used by the routine at #R$C910.
; .
; Type #N$01: the sheriff in the town. It
; counts down #R$A208, calls #R$C977, reads the
; controls, then turns, moves and fires. The sprites
; are written to #R$A228.
;
; IX The address of the sheriff
;
; Count down #R$A208.
@label=HandleSheriff
c$C930 LD HL,$A208   ; Point #REGhl at #R$A208.
 $C933 LD A,(HL)     ; {Jump to #R$C938 if #R$A208 is zero.
 $C934 AND A         ;
 $C935 JR Z,$C938    ; }
 $C937 DEC (HL)      ; Count #R$A208 down.
; Reload the revolver and read the controls.
@label=HandleSheriff_Reload
*$C938 CALL $C977    ; Call #R$C977.
 $C93B CALL $D0E3    ; Call #R$D0E3.
 $C93E LD A,($A21C)  ; Fetch #R$A21C.
 $C941 RRCA          ; Move the bits for the controls into the lowest bits.
 $C942 AND %00000011 ; Keep the two bits.
 $C944 JR NZ,$C94C   ; Jump to #R$C94C if the controls are not the keyboard.
; Copy the keyboard fire bit into bit 3.
 $C946 LD A,C        ; Fetch the controls.
 $C947 RRCA          ; Move bit 4 into bit 3.
 $C948 AND %00001000 ; Keep only that bit.
 $C94A OR C          ; {Combine it with the controls.
 $C94B LD C,A        ; }
; This entry point is used by the routine at #R$A452.
; .
; Turn, move, fire and draw. #REGc is the
; controls, and is zero when the sheriff has just
; arrived.
@label=HandleSheriff_Act
*$C94C LD E,C        ; Copy the controls into #REGe.
 $C94D CALL $CD0C    ; Call #R$CD0C.
 $C950 CALL $CB86    ; Call #R$CB86.
 $C953 PUSH DE       ; Stash the controls on the stack.
 $C954 CALL $CC42    ; Call #R$CC42.
 $C957 POP DE        ; Restore the controls from the stack.
 $C958 CALL $C9EC    ; Call #R$C9EC.
 $C95B CALL $CB29    ; Call #R$CB29.
 $C95E LD HL,$A228   ; Point #REGhl at #R$A228.
 $C961 CALL $CB60    ; Call #R$CB60.
 $C964 JP $CAEA      ; Jump to #R$CAEA.

; Figure Sprite Numbers
;
; The lower and middle sprite numbers for each
; walking frame. The lowest two bits choose the step,
; and bit 2, set from #R$CCBE, chooses the second
; set.
; #UDGTABLE(default,centre,centre,centre)
; { =h,c3 Bit 2 clear }
; { =h Frame | =h Lower | =h Middle }
; { #N$00 | #R$85A2 #SPRITE$1E(legs-3*) | #R$82E2 #SPRITE$17(torso-1*) }
; { #N$01 | #R$84EA #SPRITE$1C(legs-1*) | #R$82E2 #SPRITE$17(torso-1*) }
; { #N$02 | #R$85FE #SPRITE$1F(legs-4*) | #R$834A #SPRITE$18(torso-2*) }
; { #N$03 | #R$84EA #SPRITE$1C(legs-1*) | #R$834A #SPRITE$18(torso-2*) }
; { =h,c3 Bit 2 set }
; { =h Frame | =h Lower | =h Middle }
; { #N$04 | #R$86C8 #SPRITE$21(legs-6*) | #R$83B2 #SPRITE$19(torso-3*) }
; { #N$05 | #R$865A #SPRITE$20(legs-5*) | #R$83B2 #SPRITE$19(torso-3*) }
; { #N$06 | #R$8736 #SPRITE$22(legs-7*) | #R$841A #SPRITE$1A(torso-4*) }
; { #N$07 | #R$865A #SPRITE$20(legs-5*) | #R$841A #SPRITE$1A(torso-4*) }
; UDGTABLE#
;
; .
;
; Bit 2 clear.
@label=FigureSpriteNumbers
g$C967 DEFB $1E,$17  ; Frame #N$00: lower #R$85A2, middle #R$82E2.
 $C969 DEFB $1C,$17  ; Frame #N$01: lower #R$84EA, middle #R$82E2.
 $C96B DEFB $1F,$18  ; Frame #N$02: lower #R$85FE, middle #R$834A.
 $C96D DEFB $1C,$18  ; Frame #N$03: lower #R$84EA, middle #R$834A.
; Bit 2 set.
 $C96F DEFB $21,$19  ; Frame #N$04: lower #R$86C8, middle #R$83B2.
 $C971 DEFB $20,$19  ; Frame #N$05: lower #R$865A, middle #R$83B2.
 $C973 DEFB $22,$1A  ; Frame #N$06: lower #R$8736, middle #R$841A.
 $C975 DEFB $20,$1A  ; Frame #N$07: lower #R$865A, middle #R$841A.

; Reload Revolver
;
; Used by the routines at #R$BCCA and #R$C930.
; .
; Loads one bullet on every even frame while
; #R$A245 is zero and #R$A269 is clear. Reloading
; starts when #R$A262 is empty and #R$A246 is then
; set until the cylinder holds six. Each bullet takes
; #R$A25E from #R$A257. If the bounty cannot pay,
; #R$A269 is set.
;
; .
;
; Return unless it is time to load a bullet.
@label=ReloadRevolver
c$C977 LD A,($A269)  ; {Return if #R$A269 is set.
 $C97A AND A         ;
 $C97B RET NZ        ; }
 $C97C LD A,($A216)  ; Fetch #R$A216.
 $C97F AND %00000001 ; Keep the lowest bit.
 $C981 RET NZ        ; Return if this is an odd frame.
 $C982 LD A,($A245)  ; {Return if #R$A245 is set.
 $C985 AND A         ;
 $C986 RET NZ        ; }
; Start reloading if the cylinder is empty.
 $C987 LD HL,$A246   ; Point #REGhl at #R$A246.
 $C98A LD A,(HL)     ; {Fetch #R$A246 and test it.
 $C98B AND A         ; }
 $C98C LD A,($A262)  ; Fetch #R$A262.
 $C98F JR NZ,$C995   ; Jump to #R$C995 if #R$A246 is set.
 $C991 AND A         ; {Return if #R$A262 is not zero.
 $C992 RET NZ        ; }
 $C993 LD (HL),$01   ; Set #R$A246 to #N$01.
; Take the price and add a bullet.
@label=ReloadRevolver_Bullet
*$C995 LD BC,($A25E) ; Fetch #R$A25E.
 $C999 CALL $D36B    ; Call #R$D36B.
 $C99C JR C,$C9C3    ; Jump to #R$C9C3 if there is not enough.
 $C99E LD A,($A262)  ; {Add one to #R$A262.
 $C9A1 INC A         ;
 $C9A2 LD ($A262),A  ; }
 $C9A5 CP $06        ; {Jump to #R$C9AE if it is not six.
 $C9A7 JR NZ,$C9AE   ; }
 $C9A9 LD HL,$A246   ; {Clear #R$A246.
 $C9AC LD (HL),$00   ; }
; Colour the chamber and draw the bounty.
@label=ReloadRevolver_Show
*$C9AE DEC A         ; Make it the chamber number.
 $C9AF LD BC,$C9E0   ; Point #REGbc at #R$C9E0.
 $C9B2 CALL $C75C    ; Call #R$C75C.
 $C9B5 CALL $D272    ; Call #R$D272.
 $C9B8 LD A,$71      ; {Call #R$C9CF with #COLOUR$71.
 $C9BA CALL $C9CF    ; }
 $C9BD CALL $AF22    ; Call #R$AF22.
 $C9C0 JP $D390      ; Jump to #R$D390.
; Put the price back and stop reloading.
@label=ReloadRevolver_TooPoor
*$C9C3 CALL $D354    ; Call #R$D354.
 $C9C6 XOR A         ; {Clear #R$A246.
 $C9C7 LD ($A246),A  ; }
 $C9CA INC A         ; {Set #R$A269 to #N$01 and return.
 $C9CB LD ($A269),A  ;
 $C9CE RET           ; }

; Fill Chamber
;
; Used by the routines at #R$C977, #R$C9EC, #R$CB03 and #R$D565.
; .
; Fills a two-by-two block of screen
; attributes from #REGhl.
;
; A The attribute
; HL The address of the first attribute
;
; Set the size of the block.
@label=FillChamber
c$C9CF LD BC,$0202   ; Set the width and height to #N$02.
 $C9D2 LD DE,$001E   ; Set the distance to the next row to #N$001E.
; Fill each row.
@label=FillChamber_Row
*$C9D5 PUSH BC       ; Stash the width and height on the stack.
@label=FillChamber_Attribute
*$C9D6 LD (HL),A     ; Set an attribute.
 $C9D7 INC HL        ; Move on.
 $C9D8 DJNZ $C9D6    ; Jump to #R$C9D6 until the row is done.
 $C9DA ADD HL,DE     ; Move on to the next row.
 $C9DB POP BC        ; Restore the width and height from the stack.
 $C9DC DEC C         ; {Jump to #R$C9D5 until all of the rows are done.
 $C9DD JR NZ,$C9D5   ; }
 $C9DF RET           ; Return.

; Chamber Addresses
;
; The addresses in the screen attributes of the six chambers of the
; revolver which is shown at the bottom left of the screen.
@label=ChamberAddresses
g$C9E0 DEFW $5A27
 $C9E2 DEFW $5A49
 $C9E4 DEFW $5A89
 $C9E6 DEFW $5AA7
 $C9E8 DEFW $5A85
 $C9EA DEFW $5A45

; Fire Revolver
;
; Used by the routines at #R$BCCA and #R$C930.
; .
; Fires the revolver if the fire control is
; pressed, #R$A262 is not zero, and neither #R$A246
; nor #R$A244 is set. It calls #R$CA5D, takes one from
; #R$A262, and colours the chamber unless there were
; six. #R$A245 and #R$A244 are then set.
;
; E The controls
; IX The address of the object which fires
;
; Return unless a new shot can be made.
@label=FireRevolver
c$C9EC LD A,($A244)  ; {Jump to #R$CA28 if #R$A244 is set.
 $C9EF AND A         ;
 $C9F0 JR NZ,$CA28   ; }
 $C9F2 BIT 3,E       ; {Return if the fire control is not pressed.
 $C9F4 RET Z         ; }
 $C9F5 LD A,($A246)  ; {Return if #R$A246 is set.
 $C9F8 AND A         ;
 $C9F9 RET NZ        ; }
 $C9FA LD A,($A262)  ; {Return if #R$A262 is zero.
 $C9FD AND A         ;
 $C9FE RET Z         ; }
; Make the shot and take a bullet.
 $C9FF CALL $CA5D    ; Call #R$CA5D.
 $CA02 RET NC        ; Return if no shot was made.
 $CA03 LD A,($A262)  ; {Take one from #R$A262.
 $CA06 DEC A         ;
 $CA07 LD ($A262),A  ; }
 $CA0A INC A         ; Make it the number there were.
 $CA0B CP $06        ; {Jump to #R$CA1D if there were six.
 $CA0D JR Z,$CA1D    ; }
; Colour the chamber for the number there
; were.
 $CA0F LD BC,$C9E0   ; Point #REGbc at #R$C9E0.
 $CA12 CALL $C75C    ; Call #R$C75C.
 $CA15 CALL $D272    ; Call #R$D272.
 $CA18 LD A,$41      ; {Call #R$C9CF with #INK$41.
 $CA1A CALL $C9CF    ; }
; Start the firing pose and hold the fire
; control.
@label=FireRevolver_Fired
*$CA1D LD A,$05      ; {Set #R$A245 to #N$05.
 $CA1F LD ($A245),A  ; }
 $CA22 LD A,$01      ; {Set #R$A244 to #N$01 and return.
 $CA24 LD ($A244),A  ;
 $CA27 RET           ; }
; Clear #R$A244 when the fire control is
; released.
@label=FireRevolver_Held
*$CA28 BIT 3,E       ; {Return if the fire control is still
 $CA2A RET NZ        ; pressed.}
 $CA2B XOR A         ; {Clear #R$A244 and return.
 $CA2C LD ($A244),A  ;
 $CA2F RET           ; }

; Make Flash
;
; Used by the routine at #R$CA5D.
; .
; Puts a type #N$05 flash in #R$A34D. It copies
; the type and position of the object which fires, is
; eight by eight, and is drawn for one frame from
; #R$CA59.
;
;   IX The address of the object which fires
; O:F The carry flag is set
;
; Copy the type and position into #R$A34D.
@label=MakeFlash
c$CA30 PUSH IX         ; {Copy #REGix to #REGhl (using the stack).
 $CA32 POP HL          ; }
 $CA33 LD DE,$A34D     ; {Point #REGde and #REGiy at #R$A34D (using the stack).
 $CA36 PUSH DE         ;
 $CA37 POP IY          ; }
 $CA39 LD BC,$0005     ; Set a count of #N$0005.
 $CA3C LDIR            ; Copy the type and position.
; Turn the slot into a flash.
 $CA3E LD (IY+$00),$05 ; Make the type #N$05.
 $CA42 LD HL,$CA59     ; Point #REGhl at #R$CA59.
 $CA45 LD (IY+$08),$08 ; Set the horizontal size to #N$08.
 $CA49 LD (IY+$09),$08 ; Set the vertical size to #N$08.
 $CA4D LD (IY+$0D),$00 ; Clear the vertical offset.
 $CA51 LD (IY+$0E),L   ; {Set the sprite list.
 $CA54 LD (IY+$0F),H   ; }
 $CA57 SCF             ; {Set the carry flag and return.
 $CA58 RET             ; }

; Flash Sprite List
;
; The sprite list of a flash.
@label=FlashSpriteList
g$CA59 DEFB $F8,$F7,$0A ; Sprite #N$0A at offset (#N($F8), #N$F7).
                        ; #SPRITE$0A(flash-4*).
 $CA5C DEFB $80         ; Terminator.

; Make Shot
;
; Used by the routine at #R$C9EC.
; .
; Makes a shot. It plays #R$AF30. If #R$A267 is
; zero it jumps to #R$CA30. In the town it puts a type
; #N$02 bullet in #R$A28D, #R$A29D or #R$A2AD: a free
; slot, or a slot that is not a bullet, or a bullet that
; is not drawn. The bullet copies the firer's position
; and heading, and has speed #N$0C.
;
;   IX The address of the object which fires
; O:F The carry flag is set if a shot was made
;
; Play the rumble, or make a flash outside the
; town.
@label=MakeShot
c$CA5D CALL $AF30     ; Call #R$AF30.
 $CA60 LD A,($A267)   ; Fetch #R$A267.
 $CA63 AND A          ; {Jump to #R$CA30 if it is zero.
 $CA64 JR Z,$CA30     ; }
; Look for a free slot among the next three.
 $CA66 LD HL,$A28D    ; Point #REGhl at #R$A28D.
 $CA69 LD DE,$0010    ; Set the size of a slot to #N$0010.
 $CA6C LD B,$03       ; Set a count of #N$03.
 $CA6E PUSH BC        ; {Stash the count and the slot on the stack.
 $CA6F PUSH HL        ; }
; Use a slot if its type is zero.
@label=MakeShot_FindFree
*$CA70 LD A,(HL)      ; {Jump to #R$CA97 if the slot is free.
 $CA71 AND A          ;
 $CA72 JR Z,$CA97     ; }
 $CA74 ADD HL,DE      ; Move on to the next slot.
 $CA75 DJNZ $CA70     ; Jump to #R$CA70.
; Look for a slot that is not a bullet.
 $CA77 POP HL         ; {Restore the slot and the count from the
 $CA78 POP BC         ; stack.}
 $CA79 PUSH BC        ; {Stash the count and the slot on the stack.
 $CA7A PUSH HL        ; }
@label=MakeShot_FindOther
*$CA7B LD A,(HL)      ; {Jump to #R$CA97 if the type is not #N$02.
 $CA7C CP $02         ;
 $CA7E JR NZ,$CA97    ; }
 $CA80 ADD HL,DE      ; Move on to the next slot.
 $CA81 DJNZ $CA7B     ; Jump to #R$CA7B.
; Look for a bullet that is not drawn.
 $CA83 POP IY         ; Point #REGiy at the first slot.
 $CA85 POP BC         ; Restore the count from the stack.
@label=MakeShot_FindHidden
*$CA86 BIT 1,(IY+$07) ; {Jump to #R$CA92 if bit 1 of the flags is not
 $CA8A JR Z,$CA92     ; set.}
 $CA8C ADD IY,DE      ; Move on to the next slot.
 $CA8E DJNZ $CA86     ; Jump to #R$CA86.
 $CA90 AND A          ; {Clear the carry flag and return.
 $CA91 RET            ; }
; Use this slot.
@label=MakeShot_UseHidden
*$CA92 PUSH IY        ; {Copy #REGiy to #REGhl (using the stack).
 $CA94 POP HL         ; }
 $CA95 JR $CA99       ; Jump to #R$CA99.
@label=MakeShot_UseSlot
*$CA97 POP BC         ; {Throw away the count and the slot.
 $CA98 POP BC         ; }
; Fill the slot as a bullet.
@label=MakeShot_Bullet
*$CA99 LD (HL),$02    ; Make the type #N$02.
 $CA9B INC HL         ; Move on to the position.
 $CA9C PUSH IX        ; {Copy #REGix to #REGde (using the stack).
 $CA9E POP DE         ; }
 $CA9F INC DE         ; Move on to the position.
 $CAA0 EX DE,HL       ; Exchange #REGde and #REGhl.
 $CAA1 LD BC,$0004    ; Set a count of #N$0004.
 $CAA4 LDIR           ; Copy the position.
 $CAA6 LD A,$0C       ; {Set the speed to #N$0C and move on past the
 $CAA8 LD (DE),A      ; speed of the firer.
 $CAA9 INC DE         ;
 $CAAA INC HL         ; }
 $CAAB LD C,$02       ; Set a count of #N$02.
 $CAAD LDIR           ; Copy the heading and flags.
 $CAAF LD A,$0C       ; {Set the horizontal size to #N$0C.
 $CAB1 LD (DE),A      ; }
 $CAB2 INC DE         ; Move on.
 $CAB3 LD (DE),A      ; Set the vertical size to #N$0C.
 $CAB4 INC DE         ; {Move on to the sprite list.
 $CAB5 INC DE         ;
 $CAB6 INC DE         ;
 $CAB7 INC DE         ;
 $CAB8 INC DE         ; }
 $CAB9 EX DE,HL       ; Exchange #REGde and #REGhl.
 $CABA LD DE,$CAC2    ; Point #REGde at #R$CAC2.
 $CABD LD (HL),E      ; {Set the sprite list.
 $CABE INC HL         ;
 $CABF LD (HL),D      ; }
 $CAC0 SCF            ; {Set the carry flag and return.
 $CAC1 RET            ; }

; Bullet Sprite List
;
; The sprite list of a bullet.
@label=BulletSpriteList
g$CAC2 DEFB $FC,$14,$28 ; Sprite #N$28 at offset (#N($FC), #N$14).
                        ; #SPRITE$28(bullet*).
 $CAC5 DEFB $80         ; Terminator.

; Handle Bullet
;
; Type #N$02: a bullet fired by the sheriff in the
; town. It moves twice, checking the walls each time. If
; it hits a wall it becomes type #N$07.
;
; IX The address of the object
;
; Move the bullet in two steps.
@label=HandleBullet
c$CAC6 LD A,(IX+$05)   ; Fetch the speed.
 $CAC9 CALL $CCC2      ; Call #R$CCC2.
 $CACC CALL $CD8C      ; Call #R$CD8C.
 $CACF CALL $CCE5      ; Call #R$CCE5.
 $CAD2 CALL $CD90      ; Call #R$CD90.
 $CAD5 CALL $CCE5      ; Call #R$CCE5.
; Turn into smoke if it has hit a wall.
 $CAD8 RES 1,(IX+$07)  ; Clear bit 1 of the flags.
 $CADC BIT 0,(IX+$07)  ; {Return if it has not hit a wall.
 $CAE0 RET Z           ; }
 $CAE1 LD (IX+$00),$07 ; Turn the object into type #N$07.
 $CAE5 LD (IX+$0C),$02 ; {Set the counter to #N$02 and return.
 $CAE9 RET             ; }

; Show Firing Pose
;
; Used by the routine at #R$C930.
; .
; Changes the middle sprite of #R$A228 to a firing
; pose while #R$A245 is not zero. Type #N$15 is left as
; it is. Bit 2 of the walking frame chooses sprite #N$16
; or #N$1B.
;
; IX The address of the sheriff
;
; Return unless the sheriff on foot has just fired.
@label=ShowFiringPose
c$CAEA LD A,($A245)   ; {Return if #R$A245 is zero.
 $CAED AND A          ;
 $CAEE RET Z          ; }
 $CAEF LD A,(IX+$00)  ; Fetch the type.
 $CAF2 CP $15         ; {Return if the type is #N$15.
 $CAF4 RET Z          ; }
; Choose the firing torso from bit 2 of the walking
; frame.
 $CAF5 BIT 2,(IX+$0C) ; Test bit 2 of the walking frame.
 $CAF9 LD A,$16       ; Use sprite #N$16.
 $CAFB JR Z,$CAFF     ; Jump to #R$CAFF if bit 2 is not set.
 $CAFD ADD A,$05      ; Add #N$05.
; Store it as the middle sprite of #R$A228.
@label=ShowFiringPose_Store
*$CAFF LD ($A22D),A   ; {Set the middle sprite of #R$A228 and return.
 $CB02 RET            ; }

; Flash Chamber
;
; Used by the routine at #R$A36D.
; .
; Counts #R$A245 down and fills the chamber for
; #R$A262 from #R$CB24. The colours are used from the last
; to the first.
;
; .
;
; Count down #R$A245 and pick a colour from
; #R$CB24.
@label=FlashChamber
c$CB03 LD A,($A245)  ; {Return if #R$A245 is zero.
 $CB06 AND A         ;
 $CB07 RET Z         ; }
 $CB08 DEC A         ; {Count #R$A245 down.
 $CB09 LD ($A245),A  ; }
 $CB0C LD HL,$CB24   ; Point #REGhl at #R$CB24.
 $CB0F CALL $D275    ; Call #R$D275.
 $CB12 LD A,(HL)     ; Fetch the colour.
 $CB13 PUSH AF       ; Stash the colour on the stack.
; Fill the chamber for #R$A262.
 $CB14 LD A,($A262)  ; Fetch #R$A262.
 $CB17 LD BC,$C9E0   ; Point #REGbc at #R$C9E0.
 $CB1A CALL $C75C    ; Call #R$C75C.
 $CB1D CALL $D272    ; Call #R$D272.
 $CB20 POP AF        ; Restore the colour from the stack.
 $CB21 JP $C9CF      ; Jump to #R$C9CF.

; Chamber Colours
;
; The colours of the chamber of the revolver, used by #R$CB03 from the
; last to the first as the time since the sheriff fired counts down.
@label=ChamberColours
g$CB24 DEFB $41      ; #COLOUR(#PEEK(#PC)).
 $CB25 DEFB $51      ; #COLOUR(#PEEK(#PC)).
 $CB26 DEFB $59      ; #COLOUR(#PEEK(#PC)).
 $CB27 DEFB $79      ; #COLOUR(#PEEK(#PC)).
 $CB28 DEFB $79      ; #COLOUR(#PEEK(#PC)).

; Choose Figure Sprites
;
; Used by the routines at #R$B3DA and #R$C930.
; .
; Chooses the sprite numbers for a figure of three
; sprites, from the walking frame and #R$C967. Bit 2 of
; the walking frame chooses the second set. Types other
; than #N$01 and #N$0A use a horse for the middle sprite.
;
;   IX The address of the figure
; O:E The number of the sprite for the lower part
; O:D The number of the sprite for the middle part
; O:B The vertical offset for the sprite for the top part
; O:C The vertical offset for the sprite for the middle part
; O:A' The number of the sprite for the top part
;
; Fetch the lower and middle sprites from #R$C967.
@label=ChooseFigureSprites
c$CB29 LD L,(IX+$0C) ; {Fetch the walking frame into #REGhl.
 $CB2C LD H,$00      ; }
 $CB2E ADD HL,HL     ; Double it.
 $CB2F LD BC,$C967   ; Point #REGbc at #R$C967.
 $CB32 ADD HL,BC     ; Find the entry.
 $CB33 LD E,(HL)     ; {Fetch the lower and middle sprites.
 $CB34 INC HL        ;
 $CB35 LD D,(HL)     ; }
; Choose the vertical offsets from bit 2 of the
; walking frame.
 $CB36 LD A,(IX+$0C) ; Fetch the walking frame.
 $CB39 BIT 2,A       ; Test bit 2.
 $CB3B LD BC,$1A0F   ; Use #N$1A for the top and #N$0F for the middle.
 $CB3E JR NZ,$CB43   ; Jump to #R$CB43 if bit 2 is set.
 $CB40 LD BC,$190D   ; Use #N$19 for the top and #N$0D for the middle.
; Make the top sprite #N$0E or #N$0F.
@label=ChooseFigureSprites_Top
*$CB43 RRCA          ; {Move bit 2 into bit 0.
 $CB44 RRCA          ; }
 $CB45 AND %00000001 ; Keep only that bit.
 $CB47 ADD A,$0E     ; Add #N$0E.
 $CB49 EX AF,AF'     ; Keep it in #REGa'.
; Types #N$01 and #N$0A keep these sprites.
 $CB4A LD A,(IX+$00) ; Fetch the type.
 $CB4D CP $01        ; {Return if the type is #N$01.
 $CB4F RET Z         ; }
 $CB50 CP $0A        ; {Return if the type is #N$0A.
 $CB52 RET Z         ; }
; Use a horse for the middle sprite.
 $CB53 LD BC,$1909   ; Use #N$19 for the top and #N$09 for the middle.
 $CB56 LD A,D        ; Fetch the middle sprite.
 $CB57 SUB $17       ; Subtract #N$17.
 $CB59 RRCA          ; Move bit 1 into bit 0.
 $CB5A AND %00000001 ; Keep only that bit.
 $CB5C ADD A,$34     ; Add #N$34.
 $CB5E LD D,A        ; {Set the middle sprite and return.
 $CB5F RET           ; }

; Build Figure Sprite List
;
; Used by the routines at #R$B3DA and #R$C930.
; .
; Makes a sprite list of three sprites one above
; the other, using the numbers from #R$CB29. Types #N$15
; and #N$16 are moved eight to the left.
;
; B The vertical offset for the sprite for the top part
; C The vertical offset for the sprite for the middle part
; D The number of the sprite for the middle part
; E The number of the sprite for the lower part
; A' The number of the sprite for the top part
; HL The address of the sprite list to make
; IX The address of the figure
;
; Write the lower sprite.
@label=BuildFigureSpriteList
c$CB60 LD (HL),$F4   ; {Set the horizontal offset of the lower sprite to
 $CB62 INC HL        ; #N$F4, and move on.}
 $CB63 LD (HL),$04   ; {Set the vertical offset of the lower sprite to
 $CB65 INC HL        ; #N$04, and move on.}
 $CB66 LD (HL),E     ; {Set the number of the lower sprite, and move on.
 $CB67 INC HL        ; }
; Use a further left offset for types #N$15 and
; #N$16.
 $CB68 LD A,(IX+$00) ; Fetch the type.
 $CB6B SUB $15       ; Subtract #N$15.
 $CB6D CP $02        ; Compare it with #N$02.
 $CB6F LD A,$F4      ; Use a horizontal offset of #N$F4.
 $CB71 JR NC,$CB75   ; Jump to #R$CB75 unless the type is #N$15 or
                     ; #N$16.
 $CB73 SUB $08       ; Move the offset eight to the left.
; Write the middle sprite.
@label=BuildFigureSpriteList_Middle
*$CB75 LD (HL),A     ; {Set the horizontal offset of the middle sprite,
 $CB76 INC HL        ; and move on.}
 $CB77 LD (HL),C     ; {Set the vertical offset of the middle sprite,
 $CB78 INC HL        ; and move on.}
 $CB79 LD (HL),D     ; {Set the number of the middle sprite, and move
 $CB7A INC HL        ; on.}
; Write the top sprite and the terminator.
 $CB7B LD (HL),$F4   ; {Set the horizontal offset of the top sprite to
 $CB7D INC HL        ; #N$F4, and move on.}
 $CB7E LD (HL),B     ; {Set the vertical offset of the top sprite, and
 $CB7F INC HL        ; move on.}
 $CB80 EX AF,AF'     ; {Set the number of the top sprite, and move on.
 $CB81 LD (HL),A     ;
 $CB82 INC HL        ; }
 $CB83 LD (HL),$80   ; {Set the terminator and return.
 $CB85 RET           ; }

; Turn Sheriff
;
; Used by the routine at #R$C930.
; .
; Turns the sheriff to face the way the controls
; say. Bits 6 and 7 are the heading, and bits 0 to 2 count
; down a turn. Left and right turn him a quarter when the
; controls are the keyboard or bit 3 of #R$A21C is clear.
; Otherwise he turns a quarter at a time towards the
; direction that is pressed, and bit 2 is set when he
; faces it.
;
;   E The controls
;   IX The address of the sheriff
; O:E The controls
;
; Jump to #R$CC13 while a turn is still counting.
@label=TurnSheriff
c$CB86 LD A,(IX+$06) ; Fetch the heading and the time left in a turn.
 $CB89 AND %00000111 ; Keep the time left in a turn.
 $CB8B JR Z,$CB93    ; Jump to #R$CB93 if the sheriff is not turning.
 $CB8D DEC (IX+$06)  ; Count down the time.
 $CB90 JP $CC13      ; Jump to #R$CC13.
; Use the keyboard unless a joystick is set to give
; a direction.
@label=TurnSheriff_Choose
*$CB93 LD HL,$A21C   ; Point #REGhl at #R$A21C.
 $CB96 LD A,(HL)     ; Fetch #R$A21C.
 $CB97 AND %00000110 ; Keep the bits for the controls.
 $CB99 JR Z,$CBFD    ; Jump to #R$CBFD if the controls are the
                     ; keyboard.
 $CB9B BIT 3,(HL)    ; {Jump to #R$CBFD if bit 3 of #R$A21C is not set.
 $CB9D JR Z,$CBFD    ; }
 $CB9F LD A,($A268)  ; Fetch #R$A268.
 $CBA2 AND %00000001 ; Keep the lowest bit.
 $CBA4 CALL NZ,$CD23 ; Call #R$CD23 if the view is rotated.
; Turn towards the direction that is pressed.
 $CBA7 BIT 0,E       ; {Jump to #R$CBAF if left is pressed.
 $CBA9 JR NZ,$CBAF   ; }
 $CBAB BIT 2,E       ; {Jump to #R$CBBF if up is pressed.
 $CBAD JR NZ,$CBBF   ; }
; The controls are not for up.
@label=TurnSheriff_Right
*$CBAF BIT 1,E       ; {Jump to #R$CBE5 if right is pressed.
 $CBB1 JR NZ,$CBE5   ; }
 $CBB3 BIT 4,E       ; {Jump to #R$CBEC if down is pressed.
 $CBB5 JR NZ,$CBEC   ; }
 $CBB7 BIT 0,E       ; {Jump to #R$CBF3 if left is pressed.
 $CBB9 JR NZ,$CBF3   ; }
 $CBBB RES 2,E       ; Clear bit 2 of the controls.
 $CBBD JR $CBFD      ; Jump to #R$CBFD.
; The controls are for up.
@label=TurnSheriff_Up
*$CBBF LD A,(IX+$06) ; Fetch the heading.
; How far is the heading from the direction that is
; wanted?
@label=TurnSheriff_Difference
*$CBC2 AND %11000000 ; Keep only the heading.
 $CBC4 RES 2,E       ; Clear bit 2 of the controls.
 $CBC6 JR Z,$CBFA    ; Jump to #R$CBFA if he already faces that way.
 $CBC8 CP $40        ; {Jump to #R$CBD7 if he is a quarter turn away.
 $CBCA JR Z,$CBD7    ; }
 $CBCC CP $C0        ; {Jump to #R$CBDE if he is three quarter turns
 $CBCE JR Z,$CBDE    ; away.}
 $CBD0 LD A,($A218)  ; Fetch #R$A218.
 $CBD3 CP $80        ; {Jump to #R$CBDE if it is less than #N$80.
 $CBD5 JR C,$CBDE    ; }
; Turn back a quarter.
@label=TurnSheriff_Back
*$CBD7 LD A,(IX+$06) ; Fetch the heading.
 $CBDA SUB $40       ; Take a quarter turn off it.
 $CBDC JR $CC0E      ; Jump to #R$CC0E.
; Turn on a quarter.
@label=TurnSheriff_Forward
*$CBDE LD A,(IX+$06) ; Fetch the heading.
 $CBE1 ADD A,$40     ; Add a quarter turn to it.
 $CBE3 JR $CC0E      ; Jump to #R$CC0E.
; The controls are for right.
@label=TurnSheriff_ToRight
*$CBE5 LD A,(IX+$06) ; Fetch the heading.
 $CBE8 SUB $40       ; Take a quarter turn off it.
 $CBEA JR $CBC2      ; Jump to #R$CBC2.
; The controls are for down.
@label=TurnSheriff_ToDown
*$CBEC LD A,(IX+$06) ; Fetch the heading.
 $CBEF SUB $80       ; Take two quarter turns off it.
 $CBF1 JR $CBC2      ; Jump to #R$CBC2.
; The controls are for left.
@label=TurnSheriff_ToLeft
*$CBF3 LD A,(IX+$06) ; Fetch the heading.
 $CBF6 SUB $C0       ; Take three quarter turns off it.
 $CBF8 JR $CBC2      ; Jump to #R$CBC2.
; The sheriff faces the way he was asked to.
@label=TurnSheriff_Facing
*$CBFA SET 2,E       ; {Set bit 2 of the controls and return.
 $CBFC RET           ; }
; Left and right turn the sheriff a quarter.
@label=TurnSheriff_Keyboard
*$CBFD LD A,(IX+$06) ; Fetch the heading.
 $CC00 BIT 0,E       ; {Jump to #R$CC08 if left is not pressed.
 $CC02 JR Z,$CC08    ; }
 $CC04 SUB $40       ; Take a quarter turn off the heading.
 $CC06 OR %00000001  ; Start a turn.
; Right turns him the other way.
@label=TurnSheriff_KeyboardRight
*$CC08 BIT 1,E       ; {Jump to #R$CC10 if right is not pressed.
 $CC0A JR Z,$CC10    ; }
 $CC0C ADD A,$40     ; Add a quarter turn to the heading.
; Start a turn and store the heading.
@label=TurnSheriff_Start
*$CC0E OR %00000001  ; Start a turn.
@label=TurnSheriff_Store
*$CC10 LD (IX+$06),A ; Set the heading.
; Continue on to #R$CC13.
; .
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$DB89 }
; LIST#

; Set Facing Flags
;
; Used by the routines at #R$B3DA and #R$CB86.
; .
; Sets the flip bit and the walking-frame set from
; #R$CCBE. When #R$A268 is set, the heading is XORed with
; two so opposite headings swap.
;
; IX The address of the object
;
; Keep the heading in the lowest two bits.
@label=SetFacingFlags
c$CC13 LD A,(IX+$06) ; Fetch the heading.
 $CC16 RLCA          ; {Move the heading into the lowest two bits.
 $CC17 RLCA          ; }
 $CC18 AND %00000011 ; Keep only the heading.
 $CC1A LD L,A        ; Keep it in #REGl.
; XOR the heading with two if #R$A268 is set.
 $CC1B LD A,($A268)  ; Fetch #R$A268.
 $CC1E ADD A,A       ; Double it.
 $CC1F XOR L         ; XOR it with the heading.
 $CC20 LD L,A        ; Keep the index in #REGl.
 $CC21 LD H,$00      ; Clear #REGh.
 $CC23 LD BC,$CCBE   ; Point #REGbc at #R$CCBE.
 $CC26 ADD HL,BC     ; Find the entry.
; Set bits 6 and 7 of the flags.
 $CC27 LD A,(HL)     ; Fetch the entry.
 $CC28 AND %11000000 ; Keep bits 6 and 7.
 $CC2A LD C,A        ; Keep them in #REGc.
 $CC2B LD A,(IX+$07) ; Fetch the flags.
 $CC2E AND %00111111 ; Clear bits 6 and 7.
 $CC30 OR C          ; Set them from the table.
 $CC31 LD (IX+$07),A ; Set the flags.
; Set bit 2 of the walking frame.
 $CC34 LD A,(HL)     ; Fetch the entry again.
 $CC35 AND %00000100 ; Keep bit 2.
 $CC37 LD C,A        ; Keep it in #REGc.
 $CC38 LD A,(IX+$0C) ; Fetch the walking frame.
 $CC3B AND %11111011 ; Clear bit 2.
 $CC3D OR C          ; Set it from the table.
 $CC3E LD (IX+$0C),A ; {Set the walking frame and return.
 $CC41 RET           ; }
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$DC14 }
; LIST#

; Move Player
;
; Used by the routine at #R$C930.
; .
; Moves the sheriff one step. If bit 2 is set he
; speeds up. Otherwise he keeps his heading and slows
; down until he stops at a multiple of eight.
;
; E The controls
; IX The address of the sheriff
;
; Walk if bit 2 is set.
@label=MovePlayer
c$CC42 BIT 2,E       ; {Jump to #R$CC8A if the sheriff should walk.
 $CC44 JR NZ,$CC8A   ; }
; Otherwise slow down in the direction of the
; heading.
 $CC46 LD A,(IX+$06) ; Fetch the heading.
 $CC49 RLCA          ; {Move the heading into the lowest two bits.
 $CC4A RLCA          ; }
 $CC4B AND %00000011 ; Keep only the heading.
 $CC4D LD BC,$CC53   ; Point #REGbc at #R$CC53.
 $CC50 JP $C766      ; Jump to #R$C766.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$DC60 }
; LIST#

; Slow Down Routines
;
; The routines that #R$CC42 runs for each heading.
@label=SlowDownRoutines
g$CC53 DEFW $CC5B    ; Heading zero: #R$CC5B.
 $CC55 DEFW $CC74    ; Heading one: #R$CC74.
 $CC57 DEFW $CC79    ; Heading two: #R$CC79.
 $CC59 DEFW $CC80    ; Heading three: #R$CC80.

; Slow Player Down
;
; Works out the speed when the sheriff is not
; walking, from the distance to the next multiple of
; eight. Headings zero and two use the vertical position,
; one and three the horizontal. The speed is four, two or
; one. If he is already at a multiple of eight he stops.
;
; IX The address of the sheriff
;
; Heading zero.
@label=SlowPlayerDown
c$CC5B LD A,(IX+$03)   ; Fetch the vertical position.
; Find the distance to the next multiple of eight.
@label=SlowPlayerDown_Distance
*$CC5E AND %00000111   ; Keep the lowest three bits.
 $CC60 JR Z,$CC85      ; Jump to #R$CC85 if the position is a multiple of
                       ; eight.
 $CC62 NEG             ; {Find the distance to the next multiple of eight.
 $CC64 ADD A,$08       ; }
 $CC66 LD C,$04        ; Set a speed of four.
 $CC68 CP C            ; {Jump to #R$CC71 if the distance is four or more.
 $CC69 JR NC,$CC71     ; }
 $CC6B SRL C           ; Halve the speed.
 $CC6D CP C            ; {Jump to #R$CC71 if the distance is two or more.
 $CC6E JR NC,$CC71     ; }
 $CC70 LD C,A          ; Use the distance.
; Move the sheriff at this speed.
@label=SlowPlayerDown_Speed
*$CC71 LD A,C          ; {Jump to #R$CC97.
 $CC72 JR $CC97        ; }
; Heading one.
@label=SlowPlayerDown_One
 $CC74 LD A,(IX+$01)   ; Fetch the horizontal position.
 $CC77 JR $CC5E        ; Jump to #R$CC5E.
; Heading two.
@label=SlowPlayerDown_Two
 $CC79 LD A,(IX+$03)   ; Fetch the vertical position.
; Heading two or three.
@label=SlowPlayerDown_Negate
*$CC7C NEG             ; Make it negative.
 $CC7E JR $CC5E        ; Jump to #R$CC5E.
; Heading three.
@label=SlowPlayerDown_Three
 $CC80 LD A,(IX+$01)   ; Fetch the horizontal position.
 $CC83 JR $CC7C        ; Jump to #R$CC7C.
; The sheriff is at a multiple of eight, so he
; stops.
@label=SlowPlayerDown_Stop
*$CC85 LD (IX+$05),$00 ; {Set the speed to zero and return.
 $CC89 RET             ; }
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$DC79 }
; LIST#

; Speed Player Up
;
; Used by the routine at #R$CC42.
; .
; Raises the speed halfway towards #R$A21F and
; keeps it even.
;
;   IX The address of the sheriff
; O:A The speed
;
; Work out the average of the speed and #R$A21F.
@label=SpeedPlayerUp
c$CC8A LD A,($A21F)   ; Fetch #R$A21F.
 $CC8D SUB (IX+$05)   ; Subtract the speed.
 $CC90 SRL A          ; Halve the difference.
 $CC92 ADD A,(IX+$05) ; Add the speed.
 $CC95 AND %11111110  ; Keep it even.
; Continue on to #R$CC97.
; .
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$DCA8 }
; LIST#

; Move Player Forward
;
; Used by the routine at #R$CC5B.
; .
; Sets the speed and moves the sheriff one step in
; the direction of his heading, stopping at walls. A step
; plays #R$AED3 and #R$AEED, and moves on to the next
; walking frame.
;
; A The speed
; IX The address of the sheriff
;
; Set the speed and check the walls. Keep the flags
; from before the check for #R$AED3.
@label=MovePlayerForward
c$CC97 LD (IX+$05),A ; Set the speed.
 $CC9A CALL $CCC2    ; Call #R$CCC2.
 $CC9D LD A,(IX+$07) ; Fetch the flags.
 $CCA0 PUSH AF       ; Stash the flags on the stack.
 $CCA1 CALL $CD8C    ; Call #R$CD8C.
 $CCA4 POP AF        ; Restore the flags from the stack.
; Play the sounds and move the sheriff.
 $CCA5 CALL $AED3    ; Call #R$AED3.
 $CCA8 CALL $CCE5    ; Call #R$CCE5.
 $CCAB CALL $AEED    ; Call #R$AEED.
; Continue on to #R$CCAE.

; Next Sprite Number
;
; Used by the routine at #R$B3DA.
; .
; Moves on to the next of the four walking frames of
; a figure. They are the lowest two bits of the walking
; frame.
;
; IX The address of the figure
;
; Add one to the lowest two bits of the walking
; frame.
@label=NextSpriteNumber
c$CCAE LD A,(IX+$0C) ; {Fetch the walking frame and keep it in #REGc.
 $CCB1 LD C,A        ; }
 $CCB2 INC A         ; Add one.
 $CCB3 AND %00000011 ; Keep the lowest two bits.
 $CCB5 LD B,A        ; Keep them in #REGb.
; Put them back in the walking frame.
 $CCB6 LD A,C        ; Fetch the walking frame again.
 $CCB7 AND %11111100 ; Clear the lowest two bits.
 $CCB9 OR B          ; Put in the new frame.
 $CCBA LD (IX+$0C),A ; {Set the walking frame and return.
 $CCBD RET           ; }
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B18C }
; { #KNIGHTLORE$B98C }
; { #MARTIANOIDS$B063 }
; { #NIGHTSHADE$CEF8 }
; LIST#

; Facing Flags
;
; One byte for each heading. Bit 6 flips the sprites,
; and bit 2 chooses the second set of walking frames. When
; #R$A268 is set, #R$CC13 XORs the heading with two, so
; opposite headings swap.
@label=FacingFlags
g$CCBE DEFB %00000000 ; Heading zero.
 $CCBF DEFB %01000100 ; Heading one.
 $CCC0 DEFB %00000100 ; Heading two.
 $CCC1 DEFB %01000000 ; Heading three.

; Set Speeds From Heading
;
; Used by the routines at #R$B3DA, #R$B719, #R$CAC6 and #R$CC97.
; .
; Turns a speed into #R$A214 and #R$A215 from the
; heading of the object. Headings zero and two move
; vertically, one and three horizontally. Headings two and
; three have a negative speed.
;
; A The speed
; IX The address of the object
;
; Put the speed on the horizontal axis.
@label=SetSpeedsFromHeading
c$CCC2 LD H,$00       ; {Make the speed the horizontal speed, with no
 $CCC4 LD L,A         ; vertical speed.}
 $CCC5 BIT 6,(IX+$06) ; {Jump to #R$CCCE if the heading is horizontal.
 $CCC9 JR NZ,$CCCE    ; }
; Put the speed on the vertical axis.
 $CCCB LD H,A         ; {Make the speed the vertical speed, with no
 $CCCC LD L,$00       ; horizontal speed.}
; Make the speed negative for headings two and three.
@label=SetSpeedsFromHeading_Sign
*$CCCE BIT 7,(IX+$06) ; {Jump to #R$CCDC if the heading is not two or
 $CCD2 JR Z,$CCDC     ; three.}
 $CCD4 LD A,L         ; {Make the horizontal speed negative.
 $CCD5 NEG            ;
 $CCD7 LD L,A         ; }
 $CCD8 LD A,H         ; {Make the vertical speed negative.
 $CCD9 NEG            ;
 $CCDB LD H,A         ; }
; Store the speeds.
@label=SetSpeedsFromHeading_Store
*$CCDC LD A,L         ; {Set #R$A214.
 $CCDD LD ($A214),A   ; }
 $CCE0 LD A,H         ; {Set #R$A215 and return.
 $CCE1 LD ($A215),A   ;
 $CCE4 RET            ; }
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$DCE0 }
; LIST#

; Move Object
;
; Used by the routines at #R$A8D5, #R$B3DA, #R$B719, #R$CAC6 and #R$CC97.
; .
; Moves an object by the signed speeds at #R$A214 and
; #R$A215.
;
; IX The address of the object
;
; Add #R$A214 to the horizontal position.
@label=MoveObject
c$CCE5 LD A,($A214)  ; Fetch #R$A214.
 $CCE8 CALL $D023    ; Call #R$D023.
 $CCEB LD C,(IX+$01) ; {Fetch the horizontal position.
 $CCEE LD B,(IX+$02) ; }
 $CCF1 ADD HL,BC     ; Add the speed to it.
 $CCF2 LD (IX+$01),L ; {Set the horizontal position.
 $CCF5 LD (IX+$02),H ; }
; Add #R$A215 to the vertical position.
 $CCF8 LD A,($A215)  ; Fetch #R$A215.
 $CCFB CALL $D023    ; Call #R$D023.
 $CCFE LD C,(IX+$03) ; {Fetch the vertical position.
 $CD01 LD B,(IX+$04) ; }
 $CD04 ADD HL,BC     ; Add the speed to it.
 $CD05 LD (IX+$03),L ; {Set the vertical position and return.
 $CD08 LD (IX+$04),H ;
 $CD0B RET           ; }
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$DD01 }
; LIST#

; Check Rotate Key
;
; Used by the routine at #R$C930.
; .
; Rotates the view when the rotate control is pressed and
; then released. #R$A256 is set while it is held, and on
; release the lowest bit of #R$A268 is flipped.
;
; E The controls
;
; Set #R$A256 while the rotate control is held.
@label=CheckRotateKey
c$CD0C LD HL,$A256   ; Point #REGhl at #R$A256.
 $CD0F BIT 5,E       ; {Jump to #R$CD16 if rotate is not pressed.
 $CD11 JR Z,$CD16    ; }
 $CD13 LD (HL),$01   ; {Set #R$A256 and return.
 $CD15 RET           ; }
; Flip #R$A268 when the control is released.
@label=CheckRotateKey_Released
*$CD16 LD A,(HL)     ; {Return if the control was not held.
 $CD17 AND A         ;
 $CD18 RET Z         ; }
 $CD19 LD (HL),$00   ; Clear #R$A256.
 $CD1B LD HL,$A268   ; Point #REGhl at #R$A268.
 $CD1E LD A,(HL)     ; Fetch #R$A268.
 $CD1F XOR %00000001 ; Flip the lowest bit.
 $CD21 LD (HL),A     ; {Set #R$A268 and return.
 $CD22 RET           ; }
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$DB68 }
; LIST#

; Swap Controls
;
; Used by the routine at #R$CB86.
; .
; Swaps left with right, and up with down, so that the
; controls match a rotated view. Fire is kept.
;
;   E The controls
; O:E The swapped controls
;
; Keep fire, then swap left with right.
@label=SwapControls
c$CD23 LD A,E        ; Fetch the controls.
 $CD24 AND %00001000 ; Keep fire.
 $CD26 BIT 0,E       ; {Jump to #R$CD2C if left is not pressed.
 $CD28 JR Z,$CD2C    ; }
 $CD2A SET 1,A       ; Set the control for right.
; Swap right with left.
@label=SwapControls_Right
*$CD2C BIT 1,E       ; {Jump to #R$CD32 if right is not pressed.
 $CD2E JR Z,$CD32    ; }
 $CD30 SET 0,A       ; Set the control for left.
; Swap up with down.
@label=SwapControls_Up
*$CD32 BIT 2,E       ; {Jump to #R$CD38 if up is not pressed.
 $CD34 JR Z,$CD38    ; }
 $CD36 SET 4,A       ; Set the control for down.
; Swap down with up.
@label=SwapControls_Down
*$CD38 BIT 4,E       ; {Jump to #R$CD3E if down is not pressed.
 $CD3A JR Z,$CD3E    ; }
 $CD3C SET 2,A       ; Set the control for up.
; Store the swapped controls.
@label=SwapControls_Store
*$CD3E LD E,A        ; {Set the controls and return.
 $CD3F RET           ; }
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$DC43 }
; LIST#

; Check Walls Each Way
;
; Used by the routine at #R$A8D5.
; .
; Checks the walls for each speed on its own, so that the
; object slides along a wall instead of stopping. For each
; speed it sets the heading to the direction of that speed,
; and checks the walls with the other speed set to zero.
;
; IX The address of the object
;
; Check the walls for the horizontal speed.
@label=CheckWallsEachWay
c$CD40 LD A,($A214)  ; Fetch #R$A214.
 $CD43 AND A         ; {Jump to #R$CD66 if it is zero.
 $CD44 JR Z,$CD66    ; }
 $CD46 LD A,$40      ; Use heading one.
 $CD48 JP P,$CD4D    ; Jump to #R$CD4D if the speed is not negative.
 $CD4B OR %10000000  ; Use heading three.
; Set the heading, zero #R$A215, and check the walls.
@label=CheckWallsEachWay_SetHorizontal
*$CD4D LD C,A        ; Keep the heading in #REGc.
 $CD4E LD A,(IX+$06) ; Fetch the heading and flags.
 $CD51 AND %00111111 ; Keep the other bits.
 $CD53 OR C          ; Put in the new heading.
 $CD54 LD (IX+$06),A ; Set the heading and flags.
 $CD57 LD A,($A215)  ; Fetch #R$A215.
 $CD5A PUSH AF       ; Stash the vertical speed on the stack.
 $CD5B XOR A         ; {Set #R$A215 to #N$00.
 $CD5C LD ($A215),A  ; }
 $CD5F CALL $CD8C    ; Call #R$CD8C.
 $CD62 POP AF        ; Restore the vertical speed from the stack.
 $CD63 LD ($A215),A  ; Set #R$A215.
; Check the walls for the vertical speed.
@label=CheckWallsEachWay_Vertical
*$CD66 LD A,($A215)  ; Fetch #R$A215.
 $CD69 AND A         ; {Return if it is zero.
 $CD6A RET Z         ; }
 $CD6B LD A,$00      ; Use heading zero.
 $CD6D JP P,$CD72    ; Jump to #R$CD72 if the speed is not negative.
 $CD70 OR %10000000  ; Use heading two.
; Set the heading, zero #R$A214, and check the walls.
@label=CheckWallsEachWay_SetVertical
*$CD72 LD C,A        ; Keep the heading in #REGc.
 $CD73 LD A,(IX+$06) ; Fetch the heading and flags.
 $CD76 AND %00111111 ; Keep the other bits.
 $CD78 OR C          ; Put in the new heading.
 $CD79 LD (IX+$06),A ; Set the heading and flags.
 $CD7C LD A,($A214)  ; Fetch #R$A214.
 $CD7F PUSH AF       ; Stash the horizontal speed on the stack.
 $CD80 XOR A         ; {Set #R$A214 to #N$00.
 $CD81 LD ($A214),A  ; }
 $CD84 CALL $CD90    ; Call #R$CD90.
 $CD87 POP AF        ; Restore the horizontal speed from the stack.
 $CD88 LD ($A214),A  ; Set #R$A214.
 $CD8B RET           ; Return.

; Test Move
;
; Used by the routines at #R$B3DA, #R$B719, #R$CAC6, #R$CC97 and #R$CD40.
; .
; Checks whether an object can move in the direction of
; its heading without going into a wall. A wall changes the
; speeds so that the object stops, and sets bit 0 of the
; flags.
;
;   IX The address of the object
; O:F The carry flag is set if the object hit a wall
;
; Clear bit 0 of the flags, then run the routine for the
; heading.
@label=TestMove
c$CD8C RES 0,(IX+$07) ; Clear bit 0 of the flags of the object.
; This entry point is used by the routines at #R$CAC6 and #R$CD40.
; .
; Run the routine for the heading, without clearing the
; flag.
@label=CheckWalls
*$CD90 LD A,(IX+$06)  ; Fetch the heading.
 $CD93 RLCA           ; {Move the heading into the lowest two bits.
 $CD94 RLCA           ; }
 $CD95 AND %00000011  ; Keep only the heading.
 $CD97 LD BC,$CD9D    ; Point #REGbc at #R$CD9D.
 $CD9A JP $C766       ; Jump to #R$C766.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$DE59 }
; LIST#

; Check Walls Routines
;
; The routines that #R$CD90 runs for each heading.
@label=CheckWallsRoutines
g$CD9D DEFW $CDA5    ; Heading zero: #R$CDA5.
 $CD9F DEFW $CE08    ; Heading one: #R$CE08.
 $CDA1 DEFW $CE6B    ; Heading two: #R$CE6B.
 $CDA3 DEFW $CED0    ; Heading three: #R$CED0.

; Test Move Up
;
; Checks the walls for an object that is moving in the
; direction of heading zero. The front edge is the vertical
; position plus the vertical size. The two ends of that
; edge, now and after the move, are checked with #R$CF35.
;
;   IX The address of the object
; O:F The carry flag is set if the object hit a wall
;
; Find the left end and the front edge.
@label=TestMoveUp
c$CDA5 LD L,(IX+$01) ; {Fetch the horizontal position of the object.
 $CDA8 LD H,(IX+$02) ; }
 $CDAB LD C,(IX+$08) ; {Fetch the horizontal size.
 $CDAE LD B,$00      ; }
 $CDB0 AND A         ; {Subtract it to get the left end in #REGde.
 $CDB1 SBC HL,BC     ;
 $CDB3 EX DE,HL      ; }
 $CDB4 LD L,(IX+$03) ; {Fetch the vertical position of the object.
 $CDB7 LD H,(IX+$04) ; }
 $CDBA LD C,(IX+$09) ; Fetch the vertical size.
 $CDBD ADD HL,BC     ; Add it to get the front edge.
; Check the cell at the left end.
 $CDBE PUSH DE       ; {Stash the left end and the front edge on the stack.
 $CDBF PUSH HL       ; }
 $CDC0 CALL $CF35    ; Call #R$CF35.
 $CDC3 POP DE        ; {Restore the front edge and the left end from the
 $CDC4 POP HL        ; stack, with the registers swapped.}
 $CDC5 RET C         ; Return if the object has hit a wall.
; Check the cell at the right end, if it is in another
; cell.
 $CDC6 PUSH HL       ; {Stash the left end and the front edge on the stack.
 $CDC7 PUSH DE       ; }
 $CDC8 LD C,(IX+$08) ; {Double the horizontal size into #REGbc.
 $CDCB SLA C         ;
 $CDCD LD B,$00      ; }
 $CDCF LD A,H        ; {Find the right end of the front edge.
 $CDD0 ADD HL,BC     ; }
 $CDD1 CP H          ; {Jump to #R$CDF9 if it is in the same cell.
 $CDD2 JR Z,$CDF9    ; }
 $CDD4 EX DE,HL      ; Make the right end the one to check.
 $CDD5 CALL $CF35    ; Call #R$CF35.
 $CDD8 POP HL        ; {Restore the left end and the front edge from the
 $CDD9 POP DE        ; stack.}
 $CDDA RET C         ; Return if the object has hit a wall.
; Check the cells after the move.
 $CDDB LD A,($A215)  ; Fetch #R$A215.
 $CDDE LD C,A        ; {Make it a word in #REGbc.
 $CDDF LD B,$00      ; }
 $CDE1 LD A,H        ; {Find the front edge after the move.
 $CDE2 ADD HL,BC     ; }
 $CDE3 CP H          ; {Return if it is in the same cell.
 $CDE4 RET Z         ; }
 $CDE5 PUSH DE       ; {Stash the left end and the front edge on the stack.
 $CDE6 PUSH HL       ; }
 $CDE7 CALL $CF35    ; Call #R$CF35.
 $CDEA POP DE        ; {Restore the front edge and the left end from the
 $CDEB POP HL        ; stack, with the registers swapped.}
 $CDEC RET C         ; Return if the object has hit a wall.
 $CDED LD C,(IX+$08) ; {Double the horizontal size into #REGbc.
 $CDF0 SLA C         ;
 $CDF2 LD B,$00      ; }
 $CDF4 ADD HL,BC     ; Find the right end of the front edge.
 $CDF5 EX DE,HL      ; Make the right end the one to check.
; Check the cell at the right end.
 $CDF6 JP $CF35      ; Jump to #R$CF35.
; The ends are in the same cell, so only the cell beyond
; the front edge is checked.
@label=TestMoveUp_Same
*$CDF9 POP HL        ; {Restore the front edge and the left end from the
 $CDFA POP DE        ; stack.}
 $CDFB LD A,($A215)  ; Fetch #R$A215.
 $CDFE LD C,A        ; {Make it a word in #REGbc.
 $CDFF LD B,$00      ; }
 $CE01 LD A,H        ; {Find the front edge after the move.
 $CE02 ADD HL,BC     ; }
 $CE03 CP H          ; {Return if it is in the same cell.
 $CE04 RET Z         ; }
; Check the cell.
 $CE05 JP $CF35      ; Jump to #R$CF35.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$DE72 }
; LIST#

; Test Move Right
;
; Checks the walls for an object that is moving in the
; direction of heading one. The front edge is the horizontal
; position plus the horizontal size. The two ends of that
; edge, now and after the move, are checked with #R$CF50.
;
;   IX The address of the object
; O:F The carry flag is set if the object hit a wall
;
; Find the front edge and the lower end.
@label=TestMoveRight
c$CE08 LD L,(IX+$01) ; {Fetch the horizontal position of the object.
 $CE0B LD H,(IX+$02) ; }
 $CE0E LD C,(IX+$08) ; {Fetch the horizontal size.
 $CE11 LD B,$00      ; }
 $CE13 ADD HL,BC     ; {Add it to get the front edge in #REGde.
 $CE14 EX DE,HL      ; }
 $CE15 LD L,(IX+$03) ; {Fetch the vertical position of the object.
 $CE18 LD H,(IX+$04) ; }
 $CE1B LD C,(IX+$09) ; Fetch the vertical size.
 $CE1E AND A         ; {Subtract it to get the lower end.
 $CE1F SBC HL,BC     ; }
; Check the cell at the lower end.
 $CE21 PUSH DE       ; {Stash the front edge and the end on the stack.
 $CE22 PUSH HL       ; }
 $CE23 CALL $CF50    ; Call #R$CF50.
 $CE26 POP HL        ; {Restore the end and the front edge from the stack.
 $CE27 POP DE        ; }
 $CE28 RET C         ; Return if the object has hit a wall.
; Check the cell at the other end, if it is in another
; cell.
 $CE29 PUSH DE       ; {Stash the front edge and the end on the stack.
 $CE2A PUSH HL       ; }
 $CE2B LD C,(IX+$09) ; {Double the vertical size into #REGbc.
 $CE2E SLA C         ;
 $CE30 LD B,$00      ; }
 $CE32 LD A,H        ; {Find the other end of the front edge.
 $CE33 ADD HL,BC     ; }
 $CE34 CP H          ; {Jump to #R$CE5B if it is in the same cell.
 $CE35 JR Z,$CE5B    ; }
 $CE37 CALL $CF50    ; Call #R$CF50.
 $CE3A POP DE        ; {Restore the front edge and the end from the stack,
 $CE3B POP HL        ; with the registers swapped.}
 $CE3C RET C         ; Return if the object has hit a wall.
; Check the cells after the move.
 $CE3D LD A,($A214)  ; Fetch #R$A214.
 $CE40 LD C,A        ; {Make it a word in #REGbc.
 $CE41 LD B,$00      ; }
 $CE43 LD A,H        ; {Find the front edge after the move.
 $CE44 ADD HL,BC     ; }
 $CE45 CP H          ; {Return if it is in the same cell.
 $CE46 RET Z         ; }
 $CE47 EX DE,HL      ; Make the first end the one to check.
 $CE48 PUSH DE       ; {Stash the front edge and the end on the stack.
 $CE49 PUSH HL       ; }
 $CE4A CALL $CF50    ; Call #R$CF50.
 $CE4D POP HL        ; {Restore the end and the front edge from the stack.
 $CE4E POP DE        ; }
 $CE4F RET C         ; Return if the object has hit a wall.
 $CE50 LD C,(IX+$09) ; {Double the vertical size into #REGbc.
 $CE53 SLA C         ;
 $CE55 LD B,$00      ; }
 $CE57 ADD HL,BC     ; Find the other end of the front edge.
; Check the cell at the other end.
 $CE58 JP $CF50      ; Jump to #R$CF50.
; The ends are in the same cell, so only the cell beyond
; the front edge is checked.
@label=TestMoveRight_Same
*$CE5B POP DE        ; {Restore the end and the front edge from the stack,
 $CE5C POP HL        ; with the registers swapped.}
 $CE5D LD A,($A214)  ; Fetch #R$A214.
 $CE60 LD C,A        ; {Make it a word in #REGbc.
 $CE61 LD B,$00      ; }
 $CE63 LD A,H        ; {Find the front edge after the move.
 $CE64 ADD HL,BC     ; }
 $CE65 CP H          ; {Return if it is in the same cell.
 $CE66 RET Z         ; }
 $CE67 EX DE,HL      ; Make the front edge the one to check.
; Check the cell.
 $CE68 JP $CF50      ; Jump to #R$CF50.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$DED3 }
; LIST#

; Test Move Down
;
; Checks the walls for an object that is moving in the
; direction of heading two. The front edge is the vertical
; position minus the vertical size. The two ends of that
; edge, now and after the move, are checked with #R$CF48.
;
;   IX The address of the object
; O:F The carry flag is set if the object hit a wall
;
; Find the left end and the front edge.
@label=TestMoveDown
c$CE6B LD L,(IX+$01) ; {Fetch the horizontal position of the object.
 $CE6E LD H,(IX+$02) ; }
 $CE71 LD C,(IX+$08) ; {Fetch the horizontal size.
 $CE74 LD B,$00      ; }
 $CE76 AND A         ; {Subtract it to get the left end in #REGde.
 $CE77 SBC HL,BC     ;
 $CE79 EX DE,HL      ; }
 $CE7A LD L,(IX+$03) ; {Fetch the vertical position of the object.
 $CE7D LD H,(IX+$04) ; }
 $CE80 LD C,(IX+$09) ; Fetch the vertical size.
 $CE83 AND A         ; {Subtract it to get the front edge.
 $CE84 SBC HL,BC     ; }
; Check the cell at the left end.
 $CE86 PUSH DE       ; {Stash the left end and the front edge on the stack.
 $CE87 PUSH HL       ; }
 $CE88 CALL $CF48    ; Call #R$CF48.
 $CE8B POP DE        ; {Restore the front edge and the left end from the
 $CE8C POP HL        ; stack, with the registers swapped.}
 $CE8D RET C         ; Return if the object has hit a wall.
; Check the cell at the right end, if it is in another
; cell.
 $CE8E PUSH HL       ; {Stash the left end and the front edge on the stack.
 $CE8F PUSH DE       ; }
 $CE90 LD C,(IX+$08) ; {Double the horizontal size into #REGbc.
 $CE93 SLA C         ;
 $CE95 LD B,$00      ; }
 $CE97 LD A,H        ; {Find the right end of the front edge.
 $CE98 ADD HL,BC     ; }
 $CE99 CP H          ; {Jump to #R$CEC1 if it is in the same cell.
 $CE9A JR Z,$CEC1    ; }
 $CE9C EX DE,HL      ; Make the right end the one to check.
 $CE9D CALL $CF48    ; Call #R$CF48.
 $CEA0 POP HL        ; {Restore the left end and the front edge from the
 $CEA1 POP DE        ; stack.}
 $CEA2 RET C         ; Return if the object has hit a wall.
; Check the cells after the move.
 $CEA3 LD A,($A215)  ; Fetch #R$A215.
 $CEA6 LD C,A        ; {Make it a negative word in #REGbc.
 $CEA7 LD B,$FF      ; }
 $CEA9 LD A,H        ; {Find the front edge after the move.
 $CEAA ADD HL,BC     ; }
 $CEAB CP H          ; {Return if it is in the same cell.
 $CEAC RET Z         ; }
 $CEAD PUSH DE       ; {Stash the left end and the front edge on the stack.
 $CEAE PUSH HL       ; }
 $CEAF CALL $CF48    ; Call #R$CF48.
 $CEB2 POP DE        ; {Restore the front edge and the left end from the
 $CEB3 POP HL        ; stack, with the registers swapped.}
 $CEB4 RET C         ; Return if the object has hit a wall.
 $CEB5 LD C,(IX+$08) ; {Double the horizontal size into #REGbc.
 $CEB8 SLA C         ;
 $CEBA LD B,$00      ; }
 $CEBC ADD HL,BC     ; Find the right end of the front edge.
 $CEBD EX DE,HL      ; Make the right end the one to check.
; Check the cell at the right end.
 $CEBE JP $CF48      ; Jump to #R$CF48.
; The ends are in the same cell, so only the cell beyond
; the front edge is checked.
@label=TestMoveDown_Same
*$CEC1 POP HL        ; {Restore the front edge and the left end from the
 $CEC2 POP DE        ; stack.}
 $CEC3 LD A,($A215)  ; Fetch #R$A215.
 $CEC6 LD C,A        ; {Make it a negative word in #REGbc.
 $CEC7 LD B,$FF      ; }
 $CEC9 LD A,H        ; {Find the front edge after the move.
 $CECA ADD HL,BC     ; }
 $CECB CP H          ; {Return if it is in the same cell.
 $CECC RET Z         ; }
; Check the cell.
 $CECD JP $CF48      ; Jump to #R$CF48.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$DF34 }
; LIST#

; Test Move Left
;
; Checks the walls for an object that is moving in the
; direction of heading three. The front edge is the horizontal
; position minus the horizontal size. The two ends of that
; edge, now and after the move, are checked with #R$CF5F.
;
;   IX The address of the object
; O:F The carry flag is set if the object hit a wall
;
; Find the front edge and the lower end.
@label=TestMoveLeft
c$CED0 LD L,(IX+$01) ; {Fetch the horizontal position of the object.
 $CED3 LD H,(IX+$02) ; }
 $CED6 LD C,(IX+$08) ; {Fetch the horizontal size.
 $CED9 LD B,$00      ; }
 $CEDB AND A         ; {Subtract it to get the front edge in #REGde.
 $CEDC SBC HL,BC     ;
 $CEDE EX DE,HL      ; }
 $CEDF LD L,(IX+$03) ; {Fetch the vertical position of the object.
 $CEE2 LD H,(IX+$04) ; }
 $CEE5 LD C,(IX+$09) ; Fetch the vertical size.
 $CEE8 AND A         ; {Subtract it to get the lower end.
 $CEE9 SBC HL,BC     ; }
; Check the cell at the lower end.
 $CEEB PUSH DE       ; {Stash the front edge and the end on the stack.
 $CEEC PUSH HL       ; }
 $CEED CALL $CF5F    ; Call #R$CF5F.
 $CEF0 POP HL        ; {Restore the end and the front edge from the stack.
 $CEF1 POP DE        ; }
 $CEF2 RET C         ; Return if the object has hit a wall.
; Check the cell at the other end, if it is in another
; cell.
 $CEF3 PUSH DE       ; {Stash the front edge and the end on the stack.
 $CEF4 PUSH HL       ; }
 $CEF5 LD C,(IX+$09) ; {Double the vertical size into #REGbc.
 $CEF8 SLA C         ;
 $CEFA LD B,$00      ; }
 $CEFC LD A,H        ; {Find the other end of the front edge.
 $CEFD ADD HL,BC     ; }
 $CEFE CP H          ; {Jump to #R$CF25 if it is in the same cell.
 $CEFF JR Z,$CF25    ; }
 $CF01 CALL $CF5F    ; Call #R$CF5F.
 $CF04 POP DE        ; {Restore the front edge and the end from the stack,
 $CF05 POP HL        ; with the registers swapped.}
 $CF06 RET C         ; Return if the object has hit a wall.
; Check the cells after the move.
 $CF07 LD A,($A214)  ; Fetch #R$A214.
 $CF0A LD C,A        ; {Make it a negative word in #REGbc.
 $CF0B LD B,$FF      ; }
 $CF0D LD A,H        ; {Find the front edge after the move.
 $CF0E ADD HL,BC     ; }
 $CF0F CP H          ; {Return if it is in the same cell.
 $CF10 RET Z         ; }
 $CF11 EX DE,HL      ; Make the first end the one to check.
 $CF12 PUSH DE       ; {Stash the front edge and the end on the stack.
 $CF13 PUSH HL       ; }
 $CF14 CALL $CF5F    ; Call #R$CF5F.
 $CF17 POP HL        ; {Restore the end and the front edge from the stack.
 $CF18 POP DE        ; }
 $CF19 RET C         ; Return if the object has hit a wall.
 $CF1A LD C,(IX+$09) ; {Double the vertical size into #REGbc.
 $CF1D SLA C         ;
 $CF1F LD B,$00      ; }
 $CF21 ADD HL,BC     ; Find the other end of the front edge.
; Check the cell at the other end.
 $CF22 JP $CF5F      ; Jump to #R$CF5F.
; The ends are in the same cell, so only the cell beyond
; the front edge is checked.
@label=TestMoveLeft_Same
*$CF25 POP DE        ; {Restore the end and the front edge from the stack,
 $CF26 POP HL        ; with the registers swapped.}
 $CF27 LD A,($A214)  ; Fetch #R$A214.
 $CF2A LD C,A        ; {Make it a negative word in #REGbc.
 $CF2B LD B,$FF      ; }
 $CF2D LD A,H        ; {Find the front edge after the move.
 $CF2E ADD HL,BC     ; }
 $CF2F CP H          ; {Return if it is in the same cell.
 $CF30 RET Z         ; }
 $CF31 EX DE,HL      ; Make the front edge the one to check.
; Check the cell.
 $CF32 JP $CF5F      ; Jump to #R$CF5F.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$DF97 }
; LIST#

; Check Wall Vertical
;
; Used by the routine at #R$CDA5.
; .
; Checks whether an object that is moving in the direction
; of heading zero touches a wall in the cell containing a
; point. If it does, #R$A215 is reduced by twice the depth and
; the object is marked as having hit a wall.
;
;   DE The horizontal position of the point
;   HL The vertical position of the point
;   IX The address of the object
; O:F The carry flag is set if the object hit a wall
;
; Check the walls, then push the object back if it is
; touching one.
@label=CheckWallVertical
c$CF35 CALL $CFDE     ; Call #R$CFDE.
 $CF38 RET NC         ; Return if the object is not touching a wall.
; This entry point is used by the routine at #R$CF48.
; .
; Reduce #R$A215 by twice the depth.
@label=CheckWallVertical_PushBack
*$CF39 ADD A,A        ; {Double the depth and keep it in #REGc.
 $CF3A LD C,A         ; }
 $CF3B LD A,($A215)   ; Fetch #R$A215.
 $CF3E ADD A,C        ; {Add the depth and set #R$A215.
 $CF3F LD ($A215),A   ; }
; This entry point is used by the routine at #R$CF50.
; .
; Mark the object as having hit a wall.
@label=CheckWall_Hit
*$CF42 SET 0,(IX+$07) ; Set bit 0 of the flags of the object.
 $CF46 SCF            ; {Set the carry flag and return.
 $CF47 RET            ; }
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$DFFA }
; LIST#

; Check Wall Vertical Reverse
;
; Used by the routine at #R$CE6B.
; .
; Checks whether an object that is moving in the direction
; of heading two touches a wall in the cell containing a
; point. If it does, the depth is made positive and the object
; is pushed back by #R$CF39.
;
;   DE The horizontal position of the point
;   HL The vertical position of the point
;   IX The address of the object
; O:F The carry flag is set if the object hit a wall
;
; Check the walls, then push the object back if it is
; touching one.
@label=CheckWallVerticalReverse
c$CF48 CALL $CFDE    ; Call #R$CFDE.
 $CF4B RET NC        ; Return if the object is not touching a wall.
 $CF4C NEG           ; {Make the depth positive, and jump to #R$CF39.
 $CF4E JR $CF39      ; }
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$E00B }
; LIST#

; Check Wall Horizontal
;
; Used by the routine at #R$CE08.
; .
; Checks whether an object that is moving in the direction
; of heading one touches a wall in the cell containing a
; point. If it does, #R$A214 is reduced by twice the depth and
; the object is marked as having hit a wall.
;
;   DE The horizontal position of the point
;   HL The vertical position of the point
;   IX The address of the object
; O:F The carry flag is set if the object hit a wall
;
; Check the walls, then push the object back if it is
; touching one.
@label=CheckWallHorizontal
c$CF50 CALL $CFA1    ; Call #R$CFA1.
 $CF53 RET NC        ; Return if the object is not touching a wall.
; This entry point is used by the routine at #R$CF5F.
; .
; Reduce #R$A214 by twice the depth.
@label=CheckWallHorizontal_PushBack
*$CF54 ADD A,A       ; {Double the depth and keep it in #REGc.
 $CF55 LD C,A        ; }
 $CF56 LD A,($A214)  ; Fetch #R$A214.
 $CF59 ADD A,C       ; {Add the depth and set #R$A214.
 $CF5A LD ($A214),A  ; }
 $CF5D JR $CF42      ; Jump to #R$CF42.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$E013 }
; LIST#

; Check Wall Horizontal Reverse
;
; Used by the routine at #R$CED0.
; .
; Checks whether an object that is moving in the direction
; of heading three touches a wall in the cell containing a
; point. If it does, the depth is made positive and the object
; is pushed back by #R$CF54.
;
;   DE The horizontal position of the point
;   HL The vertical position of the point
;   IX The address of the object
; O:F The carry flag is set if the object hit a wall
;
; Check the walls, then push the object back if it is
; touching one.
@label=CheckWallHorizontalReverse
c$CF5F CALL $CFA1    ; Call #R$CFA1.
 $CF62 RET NC        ; Return if the object is not touching a wall.
 $CF63 NEG           ; {Make the depth positive, and jump to #R$CF54.
 $CF65 JR $CF54      ; }
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$E020 }
; LIST#

; Find Position In Cell
;
; Used by the routines at #R$CFA1 and #R$CFDE.
; .
; Finds the code of the cell at column #REGd and row
; #REGh in #R$5FB1, and where the object is in that cell. The
; position in the cell is half the distance from the corner,
; plus #N$40.
;
;   D The column of the cell
;   H The row of the cell
;   IX The address of the object
; O:A The code of the cell
; O:D The vertical position of the object in the cell
; O:E The horizontal position of the object in the cell
; O:F The zero flag is set if the cell is empty
;
; Keep the row and column, and find the corner of the cell.
@label=FindPositionInCell
c$CF67 LD B,H        ; {Keep the row in #REGb and the column in #REGc.
 $CF68 LD C,D        ; }
 $CF69 PUSH BC       ; Stash the row and column on the stack.
 $CF6A LD C,$00      ; {Make #REGde the corner of the column, and #REGbc the
 $CF6C LD E,C        ; corner of the row.}
; Find the horizontal position of the object in the cell.
 $CF6D LD L,(IX+$01) ; {Fetch the horizontal position of the object.
 $CF70 LD H,(IX+$02) ; }
 $CF73 AND A         ; {Subtract the corner of the column.
 $CF74 SBC HL,DE     ; }
 $CF76 SRL H         ; {Halve the distance.
 $CF78 RR L          ; }
 $CF7A LD A,L        ; {Add #N$40 and keep it in #REGe.
 $CF7B ADD A,$40     ;
 $CF7D LD E,A        ; }
; Find the vertical position of the object in the cell.
 $CF7E LD L,(IX+$03) ; {Fetch the vertical position of the object.
 $CF81 LD H,(IX+$04) ; }
 $CF84 AND A         ; {Subtract the corner of the row.
 $CF85 SBC HL,BC     ; }
 $CF87 SRL H         ; {Halve the distance.
 $CF89 RR L          ; }
 $CF8B LD A,L        ; {Add #N$40 and keep it in #REGd.
 $CF8C ADD A,$40     ;
 $CF8E LD D,A        ; }
; Find the code of the cell in #R$5FB1.
 $CF8F POP HL        ; Restore the row and column from the stack.
 $CF90 LD A,L        ; {Put the column in #REGa and the row in #REGhl.
 $CF91 LD L,H        ;
 $CF92 LD H,$00      ; }
 $CF94 ADD HL,HL     ; {Multiply the row by sixteen.
 $CF95 ADD HL,HL     ;
 $CF96 ADD HL,HL     ;
 $CF97 ADD HL,HL     ; }
 $CF98 OR L          ; {Add the column.
 $CF99 LD L,A        ; }
 $CF9A LD BC,$5FB1   ; {Add the address of #R$5FB1.
 $CF9D ADD HL,BC     ; }
 $CF9E LD A,(HL)     ; {Fetch the code of the cell and return.
 $CF9F AND A         ;
 $CFA0 RET           ; }
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$E028 }
; LIST#

; Check Walls Vertical First
;
; Used by the routines at #R$CF50 and #R$CF5F.
; .
; Checks whether an object touches any wall rectangle in
; the cell containing a point. The list for the cell is found
; from #R$6151. The vertical range is checked first.
;
;   DE The horizontal position of the point
;   HL The vertical position of the point
;   IX The address of the object
; O:A The depth into the wall along X, negative if they overlap
; O:F The carry flag is set if the object touches a wall
;
; Find the cell and its rectangle list.
@label=CheckWallsVerticalFirst
c$CFA1 CALL $CF67    ; Call #R$CF67.
 $CFA4 LD BC,$6151   ; Point #REGbc at #R$6151.
 $CFA7 CALL $C75C    ; Call #R$C75C.
 $CFAA PUSH HL       ; {Copy the rectangle list to #REGiy (using the stack).
 $CFAB POP IY        ; }
; Test the next rectangle.
@label=CheckWallsVerticalFirst_Next
*$CFAD LD A,(IY+$00) ; {Return if this is the end of the list.
 $CFB0 AND A         ;
 $CFB1 RET Z         ; }
 $CFB2 CALL $D002    ; Call #R$D002.
 $CFB5 JR NC,$CFBB   ; Jump to #R$CFBB if the object is not touching the
                     ; rectangle.
 $CFB7 CALL $CFC5    ; Call #R$CFC5.
 $CFBA RET C         ; Return if the object is touching the rectangle.
; Move on to the next rectangle.
@label=CheckWallsVerticalFirst_Skip
*$CFBB INC IY        ; {Move on to the next rectangle.
 $CFBD INC IY        ;
 $CFBF INC IY        ;
 $CFC1 INC IY        ; }
 $CFC3 JR $CFAD      ; Jump to #R$CFAD.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$E063 }
; LIST#

; Check Overlap Along X
;
; Used by the routines at #R$CFA1 and #R$CFDE.
; .
; Checks whether the horizontal range of an object, after
; it moves by #R$A214, overlaps the horizontal range of a
; rectangle of a wall. The distance between the middles is
; compared with half of the width of the object plus the half
; width of the rectangle.
;
;   E The horizontal position of the object in the cell
;   IX The address of the object
;   IY The address of the rectangle
; O:A The depth into the rectangle, negative if they overlap
; O:F The carry flag is set if the ranges overlap
;
; Find the sum of the half widths.
@label=CheckOverlapAlongX
c$CFC5 LD A,(IX+$08)  ; {Find the sum of half of the width of the object and
 $CFC8 SRL A          ; the half width of the rectangle, in #REGc.
 $CFCA ADD A,(IY+$02) ;
 $CFCD LD C,A         ; }
; Find the distance between the middles.
 $CFCE LD A,($A214)   ; Fetch #R$A214.
 $CFD1 SRA A          ; {Add half of it to the position, then find the
 $CFD3 ADD A,E        ; distance from the middle of the rectangle.
 $CFD4 SUB (IY+$00)   ; }
; Make the distance positive, then subtract the sum.
 $CFD7 JP P,$CFDC     ; {Make the distance positive.
 $CFDA NEG            ; }
@label=CheckOverlapAlongX_Depth
*$CFDC SUB C          ; Subtract the sum.
 $CFDD RET            ; Return.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$E087 }
; LIST#

; Check Walls Horizontal First
;
; Used by the routines at #R$CF35 and #R$CF48.
; .
; Checks whether an object touches any wall rectangle in
; the cell containing a point. The list for the cell is found
; from #R$6151. The horizontal range is checked first.
;
;   DE The horizontal position of the point
;   HL The vertical position of the point
;   IX The address of the object
; O:A The depth into the wall along Y, negative if they overlap
; O:F The carry flag is set if the object touches a wall
;
; Find the cell and its rectangle list.
@label=CheckWallsHorizontalFirst
c$CFDE CALL $CF67    ; Call #R$CF67.
 $CFE1 LD BC,$6151   ; Point #REGbc at #R$6151.
 $CFE4 CALL $C75C    ; Call #R$C75C.
 $CFE7 PUSH HL       ; {Copy the rectangle list to #REGiy (using the stack).
 $CFE8 POP IY        ; }
; Test the next rectangle.
@label=CheckWallsHorizontalFirst_Next
*$CFEA LD A,(IY+$00) ; {Return if this is the end of the list.
 $CFED AND A         ;
 $CFEE RET Z         ; }
 $CFEF CALL $CFC5    ; Call #R$CFC5.
 $CFF2 JR NC,$CFF8   ; Jump to #R$CFF8 if the object is not touching the
                     ; rectangle.
 $CFF4 CALL $D002    ; Call #R$D002.
 $CFF7 RET C         ; Return if the object is touching the rectangle.
; Move on to the next rectangle.
@label=CheckWallsHorizontalFirst_Skip
*$CFF8 INC IY        ; {Move on to the next rectangle.
 $CFFA INC IY        ;
 $CFFC INC IY        ;
 $CFFE INC IY        ; }
 $D000 JR $CFEA      ; Jump to #R$CFEA.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$E0A0 }
; LIST#

; Check Overlap Along Y
;
; Used by the routines at #R$CFA1 and #R$CFDE.
; .
; Checks whether the vertical range of an object, after it
; moves by #R$A215, overlaps the vertical range of a rectangle of
; a wall. The distance between the middles is compared with half
; of the height of the object plus the half height of the
; rectangle.
;
;   D The vertical position of the object in the cell
;   IX The address of the object
;   IY The address of the rectangle
; O:A The depth into the rectangle, negative if they overlap
; O:F The carry flag is set if the ranges overlap
;
; Find the sum of the half heights.
@label=CheckOverlapAlongY
c$D002 LD A,(IX+$09)  ; {Find the sum of half of the height of the object and
 $D005 SRL A          ; the half height of the rectangle, in #REGc.
 $D007 ADD A,(IY+$03) ;
 $D00A LD C,A         ; }
; Find the distance between the middles.
 $D00B LD A,($A215)   ; Fetch #R$A215.
 $D00E SRA A          ; {Add half of it to the position, then find the
 $D010 ADD A,D        ; distance from the middle of the rectangle.
 $D011 SUB (IY+$01)   ; }
; Make the distance positive, then subtract the sum.
 $D014 JP P,$D019     ; {Make the distance positive.
 $D017 NEG            ; }
@label=CheckOverlapAlongY_Depth
*$D019 SUB C          ; Subtract the sum.
 $D01A RET            ; Return.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$E0C4 }
; LIST#

; Negate HL
;
; Used by the routines at #R$B347 and #R$B647.
; .
; Makes #REGhl negative.
;
;   HL The word
; O:HL The negative of the word
;
; Invert both bytes, then add one.
@label=NegateHL
c$D01B LD A,L        ; {Invert the low byte.
 $D01C CPL           ;
 $D01D LD L,A        ; }
 $D01E LD A,H        ; {Invert the high byte.
 $D01F CPL           ;
 $D020 LD H,A        ; }
 $D021 INC HL        ; Add one.
 $D022 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #LUNARJETMAN$8947 }
; { #MARTIANOIDS$B4B1 }
; { #NIGHTSHADE$E0DD }
; { #TRANZAM$6BF6 }
; LIST#

; Sign Extend A To HL
;
; Used by the routine at #R$CCE5.
; .
; Makes a signed number into a signed word.
;
;   A The number
; O:HL The word
;
; Put the number in the low byte. The high byte is
; zero, or #N$FF if the number is negative.
@label=SignExtendAToHL
c$D023 LD L,A        ; Make the number the low byte.
 $D024 XOR A         ; Start with a high byte of zero.
 $D025 BIT 7,L       ; {Jump to #R$D02A if the number is not negative.
 $D027 JR Z,$D02A    ; }
 $D029 CPL           ; Make the high byte #N$FF.
@label=SignExtendAToHL_Set
*$D02A LD H,A        ; Set the high byte.
 $D02B RET           ; Return.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$E0E5 }
; LIST#

; Add Signed To HL
;
; Used by the routine at #R$BD69.
; .
; Adds a signed number to #REGhl.
;
;   A The number
;   HL The word
; O:HL The sum
;
; Add the number when it is not negative.
@label=AddSignedToHL
c$D02C AND A         ; {Jump to #R$D037 if the number is negative.
 $D02D JP M,$D037    ; }
 $D030 ADD A,L       ; {Add the number to the low byte.
 $D031 LD L,A        ; }
 $D032 LD A,H        ; {Add the carry to the high byte.
 $D033 ADC A,$00     ;
 $D035 LD H,A        ; }
 $D036 RET           ; Return.
; Add the number when it is negative.
@label=AddSignedToHL_Negative
*$D037 ADD A,L       ; {Add the number to the low byte.
 $D038 LD L,A        ; }
 $D039 LD A,H        ; {Subtract one from the high byte if there is no carry.
 $D03A ADC A,$FF     ;
 $D03C LD H,A        ; }
 $D03D RET           ; Return.

; Multiply A By DE
;
; Multiplies #REGa by #REGde.
;
;   A The first number
;   DE The second number
; O:HL The product
;
; Start with a product of zero, and count eight bits.
@label=MultiplyAByDE
c$D03E LD HL,$0000   ; Set the product to #N$0000.
 $D041 LD B,$08      ; Set a count of #N$08.
; Double the product, and add #REGde if the next bit of #REGa
; is set.
@label=MultiplyAByDE_Bit
*$D043 ADD HL,HL     ; Double the product.
 $D044 RLCA          ; Move the next bit of the first number into the carry
                     ; flag.
 $D045 JR NC,$D048   ; Jump to #R$D048 if it is not set.
 $D047 ADD HL,DE     ; Add the second number.
; Count down the bits.
@label=MultiplyAByDE_Next
*$D048 DJNZ $D043    ; Jump to #R$D043 until all the bits are done.
 $D04A RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CE0D }
; { #ATICATAC$9AAD }
; { #KNIGHTLORE$D4F9 }
; { #NIGHTSHADE$E0EE }
; { #TRANZAM$6F2F }
; { #UNDERWURLDE$AC68 }
; LIST#

; Copy Buffer To Screen
;
; Used by the routine at #R$D0B4.
; .
; Copies #R$D6EB to the screen, from the bottom row up. Each
; row copies #N$16 bytes. In the town the copy sits beside the panel.
; #PUSHS #UDGTABLE { #POKES$5C79,$56
; #SIM(start=$A36D,stop=$A392,clear=1,sp=$5E00)
; #SIM(start=$A395,stop=$A3B3)
; #SIM(start=$C7D1,stop=$A3B7)
; #SIM(start=$A3B7,stop=$A3BA)
; #SIM(start=$A3BA,stop=$A3ED)
; #SIM(start=$A3ED,stop=$A3F0)
; #SIM(start=$A3F0,stop=$A3F3)
; #SIM(start=$A3F3,stop=$A3F6)
; #SCR$03,$0A,$01,$15,$0E(copy-buffer) } UDGTABLE# #POPS
;
; .
;
; Keep the stack pointer, and point it at the playfield on the
; screen.
@label=CopyBufferToScreen
c$D04B LD ($A21D),SP ; Set #R$A21D.
 $D04F LD HL,$4FDB   ; Point #REGhl at #N$4FDB (in the screen buffer).
; Move it to the right in the town.
 $D052 CALL $D272    ; Call #R$D272.
 $D055 LD SP,HL      ; Point the stack pointer at it.
 $D056 LD B,$70      ; Set a count of #N$70 rows.
 $D058 LD HL,$D702   ; Point #REGhl at #R$D702.
; Copy a row from the buffer to the screen.
@label=CopyBufferToScreen_Row
*$D05B LD D,(HL)     ; {Copy eleven words of the row, working backwards.
 $D05C DEC HL        ;
 $D05D LD E,(HL)     ;
 $D05E DEC HL        ;
 $D05F PUSH DE       ;
 $D060 LD D,(HL)     ;
 $D061 DEC HL        ;
 $D062 LD E,(HL)     ;
 $D063 DEC HL        ;
 $D064 PUSH DE       ;
 $D065 LD D,(HL)     ;
 $D066 DEC HL        ;
 $D067 LD E,(HL)     ;
 $D068 DEC HL        ;
 $D069 PUSH DE       ;
 $D06A LD D,(HL)     ;
 $D06B DEC HL        ;
 $D06C LD E,(HL)     ;
 $D06D DEC HL        ;
 $D06E PUSH DE       ;
 $D06F LD D,(HL)     ;
 $D070 DEC HL        ;
 $D071 LD E,(HL)     ;
 $D072 DEC HL        ;
 $D073 PUSH DE       ;
 $D074 LD D,(HL)     ;
 $D075 DEC HL        ;
 $D076 LD E,(HL)     ;
 $D077 DEC HL        ;
 $D078 PUSH DE       ;
 $D079 LD D,(HL)     ;
 $D07A DEC HL        ;
 $D07B LD E,(HL)     ;
 $D07C DEC HL        ;
 $D07D PUSH DE       ;
 $D07E LD D,(HL)     ;
 $D07F DEC HL        ;
 $D080 LD E,(HL)     ;
 $D081 DEC HL        ;
 $D082 PUSH DE       ;
 $D083 LD D,(HL)     ;
 $D084 DEC HL        ;
 $D085 LD E,(HL)     ;
 $D086 DEC HL        ;
 $D087 PUSH DE       ;
 $D088 LD D,(HL)     ;
 $D089 DEC HL        ;
 $D08A LD E,(HL)     ;
 $D08B DEC HL        ;
 $D08C PUSH DE       ;
 $D08D LD D,(HL)     ;
 $D08E DEC HL        ;
 $D08F LD E,(HL)     ;
 $D090 PUSH DE       ; }
 $D091 EX DE,HL      ; Keep the address in the buffer in #REGde.
; Move up one pixel line on the screen.
 $D092 LD HL,$FF16   ; {Find the screen address one pixel line up.
 $D095 ADD HL,SP     ; }
 $D096 LD A,H        ; {Test whether it has crossed into the previous character
 $D097 CPL           ; row.}
 $D098 AND %00000111 ; Keep the bits for the pixel line.
 $D09A JP NZ,$D0A8   ; Jump to #R$D0A8 if it has not.
; Move to the previous character row.
 $D09D LD A,L        ; {Subtract #N$20 from the low byte.
 $D09E SUB $20       ;
 $D0A0 LD L,A        ; }
 $D0A1 JP C,$D0A8    ; Jump to #R$D0A8 if that is in the previous third.
 $D0A4 LD A,H        ; {Add #N$08 to the high byte.
 $D0A5 ADD A,$08     ;
 $D0A7 LD H,A        ; }
; Point at the next row.
@label=CopyBufferToScreen_Next
*$D0A8 LD SP,HL      ; Point the stack pointer at the new screen address.
 $D0A9 LD HL,$002D   ; {Find the end of the next row in the buffer.
 $D0AC ADD HL,DE     ; }
 $D0AD DJNZ $D05B    ; Jump to #R$D05B.
; Restore the stack pointer.
 $D0AF LD SP,($A21D) ; Fetch #R$A21D.
 $D0B3 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$E148 }
; LIST#

; Copy Buffer And Clear
;
; Used by the routines at #R$A36D and #R$BB3A.
; .
; Copies #R$D6EB to the screen and then clears it.
;
; .
;
; Copy the buffer to the screen.
@label=CopyBufferAndClear
c$D0B4 CALL $D04B    ; Call #R$D04B.
; Continue on to #R$D0B7.

; Clear Buffer
;
; Used by the routines at #R$A36D, #R$BB3A and #R$C7D1.
; .
; Clears #R$D6EB by pushing zeroes onto the stack, #N$18 bytes
; in each of #N$70 rows.
;
; O:HL The address of the start of the buffer
;
; Point at the end of #R$D6EB, and fill with zero.
@label=ClearBuffer
c$D0B7 LD HL,$E16B   ; Point #REGhl at the end of #R$D6EB.
 $D0BA LD DE,$0000   ; Set the fill word to #N$0000.
 $D0BD LD B,$70      ; Set a count of #N$70 rows.
; Keep the stack pointer, and point it at the end of the buffer.
 $D0BF LD ($A21D),SP ; Set #R$A21D.
 $D0C3 LD SP,HL      ; Point the stack pointer at the end of the buffer.
; Clear a row.
@label=ClearBuffer_Row
*$D0C4 PUSH DE       ; {Stash twelve zero words on the stack.
 $D0C5 PUSH DE       ;
 $D0C6 PUSH DE       ;
 $D0C7 PUSH DE       ;
 $D0C8 PUSH DE       ;
 $D0C9 PUSH DE       ;
 $D0CA PUSH DE       ;
 $D0CB PUSH DE       ;
 $D0CC PUSH DE       ;
 $D0CD PUSH DE       ;
 $D0CE PUSH DE       ;
 $D0CF PUSH DE       ; }
 $D0D0 DJNZ $D0C4    ; Jump to #R$D0C4.
; Keep the start of the buffer, and restore the stack pointer.
 $D0D2 LD HL,$0000   ; {Put the start of the buffer in #REGhl.
 $D0D5 ADD HL,SP     ; }
 $D0D6 LD SP,($A21D) ; Fetch #R$A21D.
 $D0DA RET           ; Return.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$E21D }
; LIST#

; Read Keyboard Port
;
; Used by the routines at #R$AC6A, #R$AF76, #R$D0F2, #R$D150, #R$D17C, #R$D1BE
; and #R$D206.
; .
; Reads the keyboard half-rows selected by #REGa. A zero bit
; selects a half-row, and more than one half-row can be read at once.
; The keys that are pressed come back as set bits 0 to 4.
;
;   A The half-rows to read, with a zero bit for each half-row
; O:A The keys pressed, in bits 0 to 4
; O:F The zero flag is set if no key is pressed
;
; Write the selector to port #N$FD, which has no effect on a
; 48K Spectrum, then read port #N$FE.
@label=ReadKeyboardPort
c$D0DB OUT ($FD),A   ; Write the selector to port #N$FD.
 $D0DD IN A,($FE)    ; Read the keyboard.
 $D0DF CPL           ; Make a one bit for each key which is pressed.
 $D0E0 AND %00011111 ; Keep the five bits for the keys.
 $D0E2 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B759 }
; { #CYBERUN$9BC3 }
; { #KNIGHTLORE$B5F7 }
; { #NIGHTSHADE$E239 }
; { #PENTAGRAM$B952 }
; LIST#

; Read Controls
;
; Used by the routines at #R$BA8B, #R$BCCA and #R$C930.
; .
; Reads the controls using the method in bits 1 and 2 of
; #R$A21C.
; #TABLE(default,centre,centre)
; { =h Bit | =h Meaning }
; { #N$00 | Left }
; { #N$01 | Right }
; { #N$02 | Up }
; { #N$03 | Fire }
; { #N$04 | Down }
; { #N$05 | Rotate the view }
; TABLE#
;
; O:B The controls, with bits 0 and 1, and 2 and 3, made exclusive
; O:C The controls
;
; Fetch the control method from #R$A21C.
@label=ReadControls
c$D0E3 LD A,($A21C)  ; Fetch #R$A21C.
 $D0E6 RRCA          ; Move the type of controls into the low bits.
 $D0E7 AND %00000011 ; Keep the two bits.
 $D0E9 JP Z,$D17C    ; Jump to #R$D17C if the method is the keyboard.
 $D0EC DEC A         ; {Jump to #R$D12B if it is a Kempston joystick.
 $D0ED JR Z,$D12B    ; }
 $D0EF DEC A         ; {Jump to #R$D150 if it is a cursor joystick.
 $D0F0 JR Z,$D150    ; }
; Continue on to #R$D0F2.
; .
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C8FF }
; { #KNIGHTLORE$D022 }
; { #NIGHTSHADE$E241 }
; { #PENTAGRAM$BDF8 }
; LIST#

; Read Interface 2 Joystick
;
; Reads an Interface 2 joystick. The first joystick is 1 to 5
; (left, right, down, up, fire) and the second is 6 to 0. The first
; row is reversed and the two are combined, so either can be used.
;
; O:C The controls
;
; Read 1 to 5.
@label=ReadInterface2Joystick
c$D0F2 LD A,$F7      ; {Read from the keyboard;
 $D0F4 CALL $D0DB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$F7 | 1 | 2 | 3 | 4 | 5 }
                     ; TABLE#}
 $D0F7 PUSH BC       ; Stash #REGbc on the stack.
 $D0F8 LD B,$05      ; Set a count of #N$05.
; Reverse the five keys into #REGc.
@label=ReadInterface2Joystick_Reverse
*$D0FA RRA           ; {Reverse the five keys into #REGc.
 $D0FB RL C          ;
 $D0FD DJNZ $D0FA    ; }
 $D0FF LD A,C        ; {Keep the reversed keys, and restore #REGbc.
 $D100 POP BC        ;
 $D101 LD C,A        ; }
; Read 6 to 0, and combine the two joysticks.
 $D102 LD A,$EF      ; {Read from the keyboard;
 $D104 CALL $D0DB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$EF | 0 | 9 | 8 | 7 | 6 }
                     ; TABLE#}
 $D107 OR C          ; Combine them with the reversed keys.
 $D108 LD C,$00      ; Clear the controls.
; Set bit 3 if fire is pressed.
 $D10A BIT 0,A       ; {Set bit 3 if fire is pressed.
 $D10C JR Z,$D110    ;
 $D10E SET 3,C       ; }
; Set bit 2 if up is pressed.
@label=ReadInterface2Joystick_TestUp
*$D110 BIT 1,A       ; {Set bit 2 if up is pressed.
 $D112 JR Z,$D116    ;
 $D114 SET 2,C       ; }
; Set bit 4 if down is pressed.
@label=ReadInterface2Joystick_TestDown
*$D116 BIT 2,A       ; {Set bit 4 if down is pressed.
 $D118 JR Z,$D11C    ;
 $D11A SET 4,C       ; }
; Set bit 1 if right is pressed.
@label=ReadInterface2Joystick_TestRight
*$D11C BIT 3,A       ; {Set bit 1 if right is pressed.
 $D11E JR Z,$D122    ;
 $D120 SET 1,C       ; }
; Set bit 0 if left is pressed.
@label=ReadInterface2Joystick_TestLeft
*$D122 BIT 4,A       ; {Set bit 0 if left is pressed.
 $D124 JR Z,$D128    ;
 $D126 SET 0,C       ; }
; Jump to #R$D1BE.
@label=ReadInterface2Joystick_Finish
*$D128 JP $D1BE      ; Jump to #R$D1BE.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C91B }
; { #KNIGHTLORE$D03E }
; { #NIGHTSHADE$E250 }
; LIST#

; Read Kempston Joystick
;
; Used by the routine at #R$D0E3.
; .
; Reads a Kempston joystick from port #N$1F.
;
; O:C The controls
;
; Read the joystick, and start with no controls.
@label=ReadKempstonJoystick
c$D12B IN A,($1F)    ; Read the joystick from port #N$1F.
 $D12D LD C,$00      ; Clear the controls.
; Set bit 1 if the joystick is pushed right.
 $D12F BIT 0,A       ; {Set bit 1 if the joystick is pushed right.
 $D131 JR Z,$D135    ;
 $D133 SET 1,C       ; }
; Set bit 0 if the joystick is pushed left.
@label=ReadKempstonJoystick_TestLeft
*$D135 BIT 1,A       ; {Set bit 0 if the joystick is pushed left.
 $D137 JR Z,$D13B    ;
 $D139 SET 0,C       ; }
; Set bit 4 if the joystick is pushed down.
@label=ReadKempstonJoystick_TestDown
*$D13B BIT 2,A       ; {Set bit 4 if the joystick is pushed down.
 $D13D JR Z,$D141    ;
 $D13F SET 4,C       ; }
; Set bit 2 if the joystick is pushed up.
@label=ReadKempstonJoystick_TestUp
*$D141 BIT 3,A       ; {Set bit 2 if the joystick is pushed up.
 $D143 JR Z,$D147    ;
 $D145 SET 2,C       ; }
; Set bit 3 if the fire button is pressed.
@label=ReadKempstonJoystick_TestFire
*$D147 BIT 4,A       ; {Set bit 3 if the fire button is pressed.
 $D149 JR Z,$D14D    ;
 $D14B SET 3,C       ; }
; Jump to #R$D1BE.
@label=ReadKempstonJoystick_Finish
*$D14D JP $D1BE      ; Jump to #R$D1BE.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C954 }
; { #KNIGHTLORE$D077 }
; { #NIGHTSHADE$E289 }
; LIST#

; Read Cursor Joystick
;
; Used by the routine at #R$D0E3.
; .
; Reads a cursor joystick. 5 is left, 8 is right, 7 is up, 6 is
; down and 0 is fire.
;
; O:C The controls
;
; Start with no controls, and read 5 for left.
@label=ReadCursorJoystick
c$D150 LD C,$00      ; Clear the controls.
 $D152 LD A,$F7      ; {Read from the keyboard;
 $D154 CALL $D0DB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$F7 | 1 | 2 | 3 | 4 | 5 }
                     ; TABLE#}
 $D157 BIT 4,A       ; {Set bit 0 if 5 is pressed.
 $D159 JR Z,$D15D    ;
 $D15B SET 0,C       ; }
; Read 0, 7, 8 and 6.
@label=ReadCursorJoystick_SecondRow
*$D15D LD A,$EF      ; {Read from the keyboard;
 $D15F CALL $D0DB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$EF | 0 | 9 | 8 | 7 | 6 }
                     ; TABLE#}
 $D162 BIT 0,A       ; {Set bit 3 if 0 is pressed.
 $D164 JR Z,$D168    ;
 $D166 SET 3,C       ; }
; Set bit 2 if 7 is pressed.
@label=ReadCursorJoystick_TestUp
*$D168 BIT 3,A       ; {Set bit 2 if 7 is pressed.
 $D16A JR Z,$D16E    ;
 $D16C SET 2,C       ; }
; Set bit 1 if 8 is pressed.
@label=ReadCursorJoystick_TestRight
*$D16E BIT 2,A       ; {Set bit 1 if 8 is pressed.
 $D170 JR Z,$D174    ;
 $D172 SET 1,C       ; }
; Set bit 4 if 6 is pressed, and jump to #R$D1BE.
@label=ReadCursorJoystick_TestDown
*$D174 BIT 4,A       ; {Jump to #R$D1BE if 6 is not pressed.
 $D176 JR Z,$D1BE    ; }
 $D178 SET 4,C       ; {Set bit 4, and jump to #R$D1BE.
 $D17A JR $D1BE      ; }
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C979 }
; { #KNIGHTLORE$D09C }
; { #NIGHTSHADE$E2AE }
; LIST#

; Read Keyboard
;
; Used by the routine at #R$D0E3.
; .
; Reads the controls from the keyboard. Left is X, V, M or B,
; right is C or N, up is any key from A to G or from H to ENTER, fire
; is any key from Q to T or from Y to P, and down is any key from 1 to
; 5 or from 6 to 0.
;
; O:C The controls
;
; Read left and right from CAPS SHIFT to V.
@label=ReadKeyboard
c$D17C LD A,$FE      ; {Read from the keyboard;
 $D17E CALL $D0DB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$FE | CAPS SHIFT | Z | X | C | V }
                     ; TABLE#}
 $D181 RRCA          ; {Move X to bit 0 and C to bit 1.
 $D182 RRCA          ; }
 $D183 BIT 2,A       ; {Set bit 0 if V is pressed.
 $D185 JR Z,$D189    ;
 $D187 SET 0,A       ; }
; Keep left and right, and read SPACE to B.
@label=ReadKeyboard_Movement
*$D189 AND %00000011 ; Keep bits 0 and 1.
 $D18B LD C,A        ; Put them in #REGc.
 $D18C LD A,$7F      ; {Read from the keyboard;
 $D18E CALL $D0DB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$7F | SPACE | SYMBOL SHIFT | M | N | B }
                     ; TABLE#}
 $D191 BIT 2,A       ; {Set bit 0 if M is pressed.
 $D193 JR Z,$D197    ;
 $D195 SET 0,C       ; }
; Set bit 1 if N is pressed.
@label=ReadKeyboard_TestN
*$D197 BIT 3,A       ; {Set bit 1 if N is pressed.
 $D199 JR Z,$D19D    ;
 $D19B SET 1,C       ; }
; Set bit 0 if B is pressed.
@label=ReadKeyboard_TestB
*$D19D BIT 4,A       ; {Set bit 0 if B is pressed.
 $D19F JR Z,$D1A3    ;
 $D1A1 SET 0,C       ; }
; Set bit 2 if any key from A to G or H to ENTER is pressed.
@label=ReadKeyboard_MiddleRows
*$D1A3 LD A,$BD      ; {Read from the keyboard;
 $D1A5 CALL $D0DB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$BD | A or H | S or J | D or K | F or L | G or ENTER }
                     ; TABLE#}
 $D1A8 JR Z,$D1AC    ; {Set bit 2 if any key is pressed.
 $D1AA SET 2,C       ; }
; Set bit 3 if any key from Q to T or Y to P is pressed.
@label=ReadKeyboard_TopRows
*$D1AC LD A,$DB      ; {Read from the keyboard;
 $D1AE CALL $D0DB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$DB | Q or Y | W or U | E or I | R or O | T or P }
                     ; TABLE#}
 $D1B1 JR Z,$D1B5    ; {Set bit 3 if any key is pressed.
 $D1B3 SET 3,C       ; }
; Set bit 4 if any key from 1 to 5 or 6 to 0 is pressed.
@label=ReadKeyboard_NumberRows
*$D1B5 LD A,$E7      ; {Read from the keyboard;
 $D1B7 CALL $D0DB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$E7 | 1 or 6 | 2 or 7 | 3 or 8 | 4 or 9 | 5 or 0 }
                     ; TABLE#}
 $D1BA JR Z,$D1BE    ; {Set bit 4 if any key is pressed.
 $D1BC SET 4,C       ; }
; Continue on to #R$D1BE.
; .
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$E2DA }
; LIST#

; Read View Key
;
; Used by the routines at #R$D0F2, #R$D12B, #R$D150 and #R$D17C.
; .
; Sets bit 5 of the controls if Z or SYMBOL SHIFT is pressed,
; then makes a copy in #REGb in which left and right are never both
; set, and bits 2 and 3 are never both set.
;
;   C The controls
; O:B The controls, with bits 0 and 1, and 2 and 3, made exclusive
; O:C The controls
;
; Read the key which rotates the view.
@label=ReadControls_Rotate
c$D1BE LD A,$7E      ; {Read from the keyboard;
 $D1C0 CALL $D0DB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$7E | CAPS SHIFT or SPACE | Z or SYMBOL SHIFT | X or M | C or N | V or B }
                     ; TABLE#}
 $D1C3 BIT 1,A       ; {Jump to #R$D1C9 if neither Z nor SYMBOL SHIFT is
 $D1C5 JR Z,$D1C9    ; pressed.}
 $D1C7 SET 5,C       ; Set bit 5.
; Make #REGb from the controls so that left and right are never
; both set, and bits 2 and 3 are never both set.
@label=ReadControls_Resolve
*$D1C9 PUSH DE       ; Stash #REGde on the stack.
 $D1CA LD A,($A247)  ; {Fetch #R$A247.
 $D1CD LD E,A        ; }
 $D1CE LD A,C        ; Fetch the controls.
 $D1CF AND %00000011 ; Keep left and right.
 $D1D1 CP $03        ; {Jump to #R$D1F5 if both are set.
 $D1D3 JR Z,$D1F5    ; }
 $D1D5 LD B,A        ; Keep them in #REGb.
 $D1D6 LD A,E        ; Fetch the last controls.
 $D1D7 AND %11111100 ; Clear their bits for left and right.
 $D1D9 OR B          ; Put in the new ones.
 $D1DA LD E,A        ; Keep them in #REGe.
; Do the same for bits 2 and 3.
@label=ReadControls_Vertical
*$D1DB LD A,C        ; Fetch the controls.
 $D1DC AND %00001100 ; Keep bits 2 and 3.
 $D1DE CP $0C        ; {Jump to #R$D1FD if both are set.
 $D1E0 JR Z,$D1FD    ; }
 $D1E2 LD D,A        ; Keep them in #REGd.
 $D1E3 OR B          ; Add them to #REGb.
 $D1E4 LD B,A        ; Keep them in #REGb.
 $D1E5 LD A,E        ; Fetch the last controls.
 $D1E6 AND %11110011 ; Clear their bits for the two controls.
 $D1E8 OR D          ; Put in the new ones.
 $D1E9 LD E,A        ; Keep them in #REGe.
; Store #R$A247 and add bit 4 to #REGb.
@label=ReadControls_Store
*$D1EA LD A,E        ; Fetch the last controls.
 $D1EB LD ($A247),A  ; Set #R$A247.
 $D1EE POP DE        ; Restore #REGde from the stack.
 $D1EF LD A,C        ; Fetch the controls.
 $D1F0 AND %00010000 ; Keep bit 4, for down.
 $D1F2 OR B          ; Add it to #REGb.
 $D1F3 LD B,A        ; Keep it in #REGb.
 $D1F4 RET           ; Return.
; Both left and right are set, so use the one which was not set
; last time.
@label=ReadControls_BothHorizontal
*$D1F5 LD A,E        ; Fetch the last controls.
 $D1F6 AND %00000011 ; Keep left and right.
 $D1F8 XOR %00000011 ; Turn the bits round.
 $D1FA LD B,A        ; Keep them in #REGb.
 $D1FB JR $D1DB      ; Jump to #R$D1DB.
; Bits 2 and 3 are both set, so use the one which was not set
; last time.
@label=ReadControls_BothVertical
*$D1FD LD A,E        ; Fetch the last controls.
 $D1FE AND %00001100 ; Keep bits 2 and 3.
 $D200 XOR %00001100 ; Turn the bits round.
 $D202 OR B          ; Add the horizontal controls.
 $D203 LD B,A        ; Keep them in #REGb.
 $D204 JR $D1EA      ; Jump to #R$D1EA.

; Pause Game
;
; Used by the routine at #R$A36D.
; .
; Pauses the game if CAPS SHIFT or SPACE is pressed on its own.
; #R$AF49 is played at the start and at the end. The game carries on
; when CAPS SHIFT or SPACE is pressed again.
;
; .
;
; Return unless CAPS SHIFT or SPACE is the only key being pressed.
@label=PauseGame
c$D206 LD A,$7E      ; {Read from the keyboard;
 $D208 CALL $D0DB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$7E | CAPS SHIFT or SPACE | Z or SYMBOL SHIFT | X or M | C or N | V or B }
                     ; TABLE#}
 $D20B BIT 0,A       ; {Return if neither CAPS SHIFT nor SPACE is pressed.
 $D20D RET Z         ; }
 $D20E AND %00011110 ; Keep the bits for the other keys.
 $D210 RET NZ        ; Return if any of them is pressed.
; Play the pause sound.
 $D211 CALL $AF49    ; Call #R$AF49.
; Wait for the key to be released.
@label=PauseGame_Release
*$D214 LD A,$7E      ; {Read the keys, and jump to #R$D214 while CAPS SHIFT or
 $D216 CALL $D0DB    ; SPACE is pressed.
 $D219 BIT 0,A       ;
 $D21B JR NZ,$D214   ; }
; Wait for a key to be pressed.
@label=PauseGame_Press
*$D21D LD A,$7E      ; {Read the keys, and jump to #R$D21D until CAPS SHIFT or
 $D21F CALL $D0DB    ; SPACE is pressed.
 $D222 BIT 0,A       ;
 $D224 JR Z,$D21D    ; }
; Play the pause sound.
 $D226 CALL $AF49    ; Call #R$AF49.
; Wait for the key to be released.
@label=PauseGame_ReleaseAgain
*$D229 LD A,$7E      ; {Read the keys, and jump to #R$D229 while CAPS SHIFT or
 $D22B CALL $D0DB    ; SPACE is pressed.
 $D22E BIT 0,A       ;
 $D230 JR NZ,$D229   ; }
 $D232 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CE22 }
; { #KNIGHTLORE$D50E }
; { #NIGHTSHADE$E32C }
; LIST#

; Calculate Buffer Address
;
; Used by the routines at #R$B9FB, #R$BADD, #R$BB0B, #R$BDAE, #R$BEF8, #R$C4A7
; and #R$C5F9.
; .
; Finds the address in #R$D6EB of a pixel. The first row of the
; buffer is at a vertical position of #N$48, and the first column is at
; a horizontal position of #N$10.
;
;   H The vertical position, from #N$48
;   L The horizontal position, from #N$10
; O:HL The address in the buffer
;
; Stash #REGbc.
@label=CalculateBufferAddress
c$D233 PUSH BC       ; Stash #REGbc on the stack.
; Work out the column from the horizontal position.
 $D234 SRL L         ; {Divide the horizontal position by eight.
 $D236 SRL L         ;
 $D238 SRL L         ; }
 $D23A LD A,L        ; {Keep the column, and start with the vertical position.
 $D23B LD L,H        ;
 $D23C LD H,$00      ; }
; Work out #N$18 times the vertical position.
 $D23E ADD HL,HL     ; {Multiply the vertical position by eight.
 $D23F ADD HL,HL     ;
 $D240 ADD HL,HL     ; }
 $D241 LD C,L        ; {Keep it.
 $D242 LD B,H        ; }
 $D243 ADD HL,HL     ; {Multiply it by two and add the eight times.
 $D244 ADD HL,BC     ; }
; Add the column and the start of the buffer.
 $D245 LD C,A        ; {Move the column into #REGbc.
 $D246 LD B,$00      ; }
 $D248 ADD HL,BC     ; Add it.
 $D249 LD BC,$D029   ; {Add the address of #R$D6EB, less the first row and
 $D24C ADD HL,BC     ; column.}
 $D24D POP BC        ; Restore #REGbc from the stack.
 $D24E RET           ; Return.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$E53A }
; LIST#

; Calculate Screen Address
;
; Used by the routines at #R$ACF6 and #R$AE10.
; .
; Finds the address on the screen of a pixel. The vertical
; position is measured from the bottom of the screen.
;
;   H The vertical position, from the bottom
;   L The horizontal position
; O:HL The address on the screen
;
; Stash #REGde, and copy the position to it.
@label=CalculateScreenAddress
c$D24F PUSH DE       ; Stash #REGde on the stack.
 $D250 EX DE,HL      ; Copy the position to #REGde.
; Work out the column from the horizontal position.
 $D251 LD A,E        ; {Divide the horizontal position by eight.
 $D252 RRCA          ;
 $D253 RRCA          ;
 $D254 RRCA          ; }
 $D255 AND %00011111 ; Keep the column.
 $D257 LD L,A        ; Store it.
; Work out the character row within a third of the screen.
 $D258 LD A,D        ; {Invert the vertical position and multiply it by four.
 $D259 CPL           ;
 $D25A RLCA          ;
 $D25B RLCA          ; }
 $D25C AND %11100000 ; Keep the character row within the third.
 $D25E OR L          ; {Make the low byte of the address.
 $D25F LD L,A        ; }
; Work out the third of the screen.
 $D260 LD A,D        ; {Invert the vertical position and divide it by eight.
 $D261 CPL           ;
 $D262 RRCA          ;
 $D263 RRCA          ;
 $D264 RRCA          ; }
 $D265 AND %00011000 ; Keep the third.
 $D267 LD H,A        ; Start the high byte.
; Work out the line within the character row, and make the high
; byte of the address.
 $D268 LD A,D        ; {Invert the vertical position.
 $D269 CPL           ; }
 $D26A AND %00000111 ; Keep the line within the character row.
 $D26C OR H          ; {Combine it with the third, add #N$38, and set the high
 $D26D ADD A,$38     ; byte.
 $D26F LD H,A        ; }
 $D270 POP DE        ; Restore #REGde from the stack.
 $D271 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$D135 }
; { #KNIGHTLORE$D826 }
; { #NIGHTSHADE$E556 }
; { #PENTAGRAM$B394 }
; LIST#

; Add Town Offset To HL
;
; Used by the routines at #R$C977, #R$C9EC, #R$CB03, #R$D04B, #R$D463, #R$D565
; and #R$D5C9.
; .
; Adds #R$A267 to a screen address, so a layout drawn at the
; left of the screen sits beside the town panel.
;
;   HL The screen address
; O:HL The new address
@label=AddTownOffsetToHL
c$D272 LD A,($A267)  ; Fetch #R$A267.
; Continue on to #R$D275.

; Add A To HL
;
; Used by the routines at #R$A6FC, #R$A7DA, #R$A8D5, #R$AAC4, #R$AAE7, #R$ACF6,
; #R$AEA9, #R$AF9A, #R$B420, #R$BA47, #R$BB3A, #R$C5F9, #R$CB03, #R$D3A7 and
; #R$D423.
; .
; Adds an unsigned number to
; #REGhl.
;
;   A The number
;   HL The address
; O:HL The new address
@label=AddAToHL
c$D275 ADD A,L       ; Add #REGa to #REGl.
 $D276 LD L,A        ; Copy it to #REGl.
 $D277 LD A,H        ; Fetch #REGh.
 $D278 ADC A,$00     ; Add #N$00 with carry.
 $D27A LD H,A        ; Copy it to #REGh.
 $D27B RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CE06 }
; { #ATICATAC$926C }
; { #CYBERUN$9BCF }
; { #KNIGHTLORE$D4F2 }
; { #NIGHTSHADE$E596 }
; { #PENTAGRAM$B519 }
; { #SABREWULF$9B37 }
; LIST#

; Draw Lives
;
; Used by the routines at #R$C049 and #R$D2FB.
; .
; Draws #N$04 sheriff hats from #R$D2AA in the lower left of the
; town screen. The hats for the lives in #R$A263 are in #COLOUR$46, and
; the hats for the lives which have been lost are in black. This does
; nothing when #R$A267 is zero.
; #PUSHS #UDGTABLE { #POKES$5C79,$56
; #SIM(start=$A36D,stop=$A392,clear=1,sp=$5E00)
; #SIM(start=$A395,stop=$A3B3)
; #SIM(start=$C7D1,stop=$A3B7)
; #SIM(start=$A3B7,stop=$D319)
; #SIM(start=$D319,stop=$D31C)
; #SCR$03,$00,$12,$08,$03(lives) } UDGTABLE# #POPS
;
; .
;
; Return if this is not the town.
@label=DrawLives
c$D27C LD A,($A267)  ; {Fetch #R$A267.
 $D27F AND A         ; }
 $D280 RET Z         ; Return if this is not the town.
; Draw the hats for the lives which are left.
 $D281 LD A,$46      ; {Set the attribute to #COLOUR$46.
 $D283 EX AF,AF'     ; }
 $D284 LD HL,$5040   ; Point #REGhl at #N$5040 (in the screen buffer).
 $D287 LD A,($A263)  ; Fetch #R$A263.
; Draw that many hats.
 $D28A CALL $D296    ; Call #R$D296.
; Draw the hats for the lives which have been lost.
 $D28D XOR A         ; {Set the attribute to #COLOUR$00.
 $D28E EX AF,AF'     ; }
 $D28F LD A,($A263)  ; Fetch #R$A263.
 $D292 NEG           ; {Find #N$04 minus the number of lives.
 $D294 ADD A,$04     ; }
; Draw hats from #R$D2AA, each of #N$02 tiles wide and #N$03
; high, from left to right.
@label=DrawLifeIcons
*$D296 AND A         ; {Return if there are no hats.
 $D297 RET Z         ; }
; Draw a hat.
 $D298 PUSH AF       ; Stash the number on the stack.
 $D299 LD DE,$D2AA   ; {Point #REGde at #R$D2AA, and set the size to #N$02 by
 $D29C LD BC,$0203   ; #N$03.}
 $D29F PUSH HL       ; Stash the screen address on the stack.
; Draw the hat.
 $D2A0 CALL $D595    ; Call #R$D595.
 $D2A3 POP HL        ; Restore the screen address from the stack.
; Move on to the next hat.
 $D2A4 INC L         ; {Move on two columns.
 $D2A5 INC L         ; }
 $D2A6 POP AF        ; Restore the number from the stack.
 $D2A7 DEC A         ; Count it down.
 $D2A8 JR $D296      ; Jump to #R$D296.

; Life Icon Tiles
;
; The numbers of the tiles of a sheriff hat, drawn by #R$D296 in
; three rows of two from #R$8CF0. Bits 6 and 7 of a number say how the
; tile is reflected.
@label=LifeIconTiles
b$D2AA DEFB $19      ; #UDGTABLE { #N(#PEEK(#PC)) |
                     ; #UDG($8CF0+#PEEK(#PC)*$08,attr=$46) } UDGTABLE#
 $D2AB DEFB $1A      ; #UDGTABLE { #N(#PEEK(#PC)) |
                     ; #UDG($8CF0+#PEEK(#PC)*$08,attr=$46) } UDGTABLE#
 $D2AC DEFB $1B      ; #UDGTABLE { #N(#PEEK(#PC)) |
                     ; #UDG($8CF0+#PEEK(#PC)*$08,attr=$46) } UDGTABLE#
 $D2AD DEFB $1C      ; #UDGTABLE { #N(#PEEK(#PC)) |
                     ; #UDG($8CF0+#PEEK(#PC)*$08,attr=$46) } UDGTABLE#
 $D2AE DEFB $1D      ; #UDGTABLE { #N(#PEEK(#PC)) |
                     ; #UDG($8CF0+#PEEK(#PC)*$08,attr=$46) } UDGTABLE#
 $D2AF DEFB $1E      ; #UDGTABLE { #N(#PEEK(#PC)) |
                     ; #UDG($8CF0+#PEEK(#PC)*$08,attr=$46) } UDGTABLE#

; Draw Digits
;
; Used by the routine at #R$D390.
; .
; Draws a number which is held as pairs of packed decimal digits,
; as double height characters from #R$8EB0.
; #PUSHS #UDGTABLE { #POKES$5C79,$56
; #SIM(start=$A36D,stop=$A392,clear=1,sp=$5E00)
; #SIM(start=$A395,stop=$A3B3)
; #SIM(start=$C7D1,stop=$A3B7)
; #SIM(start=$A3B7,stop=$D3A4)
; #SIM(start=$D3A4,stop=$A3BA)
; #SCR$03,$02,$16,$06,$02(digits) } UDGTABLE# #POPS
;
; B The number of bytes of the number
; DE The address of the number
; HL The screen address
; A' The attribute
;
; Prepare the upper digit.
@label=DrawDigits
c$D2B0 LD A,(DE)     ; Fetch the byte.
 $D2B1 RRCA          ; {Move the upper digit to the lower four bits.
 $D2B2 RRCA          ;
 $D2B3 RRCA          ;
 $D2B4 RRCA          ; }
 $D2B5 AND %00001111 ; Keep only bits 0-3.
 $D2B7 PUSH BC       ; Stash the counter on the stack.
 $D2B8 LD BC,$8EB0   ; Point #REGbc at #R$8EB0.
; Draw the upper digit.
 $D2BB CALL $D2C9    ; Call #R$D2C9.
; Prepare the lower digit.
 $D2BE LD A,(DE)     ; {Fetch the byte again, and move to the next one.
 $D2BF INC DE        ; }
 $D2C0 AND %00001111 ; Keep only bits 0-3.
; Draw the lower digit.
 $D2C2 CALL $D2C9    ; Call #R$D2C9.
 $D2C5 POP BC        ; Restore the counter from the stack.
 $D2C6 DJNZ $D2B0    ; Jump to #R$D2B0 if there are any left.
 $D2C8 RET           ; Return.

; Draw Character
;
; Used by the routines at #R$AB77, #R$ACF6 and #R$D2B0.
; .
; Draws a character which is #N$08 pixels wide and #N$10 high,
; from a font of #N$08 bytes for each character. The first four bytes
; are drawn as the upper half and the last four as the lower half, with
; every byte drawn on two lines.
;
;   A The number of the character
;   BC The address of the font
;   HL The screen address
;   A' The attribute
; O:HL The screen address of the next character on the right
;
; Find the character in the font.
@label=DrawCharacter
c$D2C9 PUSH BC       ; {Stash the registers on the stack.
 $D2CA PUSH DE       ;
 $D2CB PUSH HL       ; }
 $D2CC EX DE,HL      ; Keep the screen address in #REGde.
 $D2CD LD L,A        ; {Move the number of the character to #REGhl.
 $D2CE LD H,$00      ; }
 $D2D0 ADD HL,HL     ; {Multiply it by #N$08, and add the address of the font.
 $D2D1 ADD HL,HL     ;
 $D2D2 ADD HL,HL     ;
 $D2D3 ADD HL,BC     ; }
 $D2D4 EX DE,HL      ; Put the address of the character in #REGde and the screen
                     ; address in #REGhl.
; Draw the character.
 $D2D5 CALL $D2DD    ; Call #R$D2DD.
 $D2D8 POP HL        ; Restore the screen address from the stack.
 $D2D9 INC L         ; Move on to the next column.
 $D2DA POP DE        ; {Restore the registers from the stack.
 $D2DB POP BC        ; }
 $D2DC RET           ; Return.

; Draw Double Height Character
;
; Used by the routine at #R$D2C9.
; .
; Draws the two halves of a character, one on top of the other,
; each with the attribute.
;
; DE The address of the character
; HL The screen address
; A' The attribute
;
; Draw the upper half.
@label=DrawDoubleHeightCharacter
c$D2DD PUSH HL       ; Stash the screen address on the stack.
 $D2DE CALL $D2F0    ; Call #R$D2F0.
 $D2E1 POP HL        ; Restore the screen address from the stack.
; Set the attribute of the upper half.
 $D2E2 CALL $D63C    ; Call #R$D63C.
; Move down a row.
 $D2E5 CALL $D64F    ; Call #R$D64F.
; Draw the lower half.
 $D2E8 PUSH HL       ; Stash the screen address on the stack.
 $D2E9 CALL $D2F0    ; Call #R$D2F0.
 $D2EC POP HL        ; Restore the screen address from the stack.
; Set the attribute of the lower half.
 $D2ED JP $D63C      ; Jump to #R$D63C.

; Draw Double Lines
;
; Used by the routine at #R$D2DD.
; .
; Draws #N$04 bytes as #N$08 lines, with each byte drawn twice.
;
;   DE The address of the bytes
;   HL The screen address
; O:DE The address after the bytes
;
; Draw four bytes, each on two lines.
@label=DrawDoubleLines
c$D2F0 LD B,$04      ; Set a count of #N$04 bytes.
@label=DrawDoubleLines_Next
*$D2F2 LD A,(DE)     ; {Draw the next byte on two lines.
 $D2F3 INC DE        ;
 $D2F4 LD (HL),A     ;
 $D2F5 INC H         ;
 $D2F6 LD (HL),A     ;
 $D2F7 INC H         ; }
 $D2F8 DJNZ $D2F2    ; Jump to #R$D2F2 if there are any left.
 $D2FA RET           ; Return.

; Draw Game Screen
;
; Used by the routines at #R$A36D and #R$C049.
; .
; Draws the parts of the screen which do not change during a
; stage: the border of the playfield, the revolver, the frame of the
; telegram, the panel for the town and the lives and the bounty. The
; attributes are first set to the value in #REGe and the screen is
; cleared.
; #PUSHS #UDGTABLE { #POKES$5C79,$56
; #SIM(start=$A36D,stop=$A392,clear=1,sp=$5E00)
; #SIM(start=$A395,stop=$A3B3)
; #SIM(start=$C7D1,stop=$A3B7)
; #SIM(start=$A3B7,stop=$A3BA)
; #SCR$02(game-screen) } UDGTABLE#
; #HTML(<div hidden>)
; #SCR$02,$08,$00,$18,$10(screen-frame)
; #HTML(</div>)
; #POPS
;
; E The attribute for the whole screen
;
; Set the attributes and clear the screen.
@label=DrawGameScreen
c$D2FB CALL $D6D3    ; Call #R$D6D3.
 $D2FE CALL $D6DB    ; Call #R$D6DB.
; Print the telegram.
 $D301 CALL $A6FC    ; Call #R$A6FC.
; Use the tiles of the panel and the border.
 $D304 LD HL,$8CF0   ; {Set #R$A20F to #R$8CF0.
 $D307 LD ($A20F),HL ; }
; Draw the border of the playfield.
 $D30A CALL $D5C9    ; Call #R$D5C9.
; Draw the revolver.
 $D30D CALL $D565    ; Call #R$D565.
; Draw the frame of the telegram.
 $D310 CALL $D463    ; Call #R$D463.
; Draw the panel of the town, if this is the town.
 $D313 CALL $D3A7    ; Call #R$D3A7.
; Draw the pictures at the sides, if this is not the town.
 $D316 CALL $D327    ; Call #R$D327.
; Draw the lives.
 $D319 CALL $D27C    ; Call #R$D27C.
; Draw the bounty.
 $D31C JP $D37E      ; Jump to #R$D37E.

; Bounty Text
;
; The text which is drawn next to the bounty in the town, which starts
; with its attribute and ends with zero.
@label=BountyText
g$D31F DEFB $43      ; Attribute: #COLOUR(#PEEK(#PC)).
 $D320 DEFM "BOUNTY" ; "BOUNTY".
 $D326 DEFB $00      ; The end of the text.

; Draw Side Pictures
;
; Used by the routine at #R$D2FB.
; .
; Draws a block of tiles of #N$04 by #N$0A, from #R$5E04, on each
; side of the lower part of the screen of any stage which is not the
; town. The block at the left is drawn from right to left so that it is
; a reflection of the block at the right.
; #PUSHS #UDGTABLE { #POKES$5C79,$56
; #SIM(start=$A36D,stop=$A392,clear=1,sp=$5E00)
; #SIM(start=$A395,stop=$A3B3)
; #POKES$A265,$02;$A266,$45
; #SIM(start=$A3B3,stop=$A3B7)
; #SIM(start=$A3B7,stop=$D316)
; #SIM(start=$D316,stop=$D319)
; #SCR$03,$00,$0E,$20,$0A(side-pictures) } UDGTABLE# #POPS
;
; .
;
; Return if this is the town.
@label=DrawSidePictures
c$D327 LD A,($A267)  ; {Fetch #R$A267.
 $D32A AND A         ; }
 $D32B RET NZ        ; Return if this is the town.
; Draw the right hand block.
 $D32C LD A,$43      ; {Set the attribute to #COLOUR$43.
 $D32E EX AF,AF'     ; }
 $D32F LD HL,$48DC   ; Point #REGhl at #N$48DC (in the screen buffer).
 $D332 LD DE,$5E04   ; Point #REGde at #R$5E04.
 $D335 LD BC,$040A   ; Set the size of the block to #N$04 by #N$0A.
 $D338 CALL $D595    ; Call #R$D595.
; Draw the left hand block.
 $D33B LD HL,$48C3   ; Point #REGhl at #N$48C3 (in the screen buffer).
 $D33E LD DE,$5E04   ; Point #REGde at #R$5E04.
 $D341 LD BC,$040A   ; Set the size of the block to #N$04 by #N$0A.
 $D344 JP $D5AE      ; Jump to #R$D5AE.

; Take From Bounty
;
; Used by the routines at #R$A9BF and #R$B778.
; .
; Takes a price from the bounty, and sets the bounty to zero if it is more
; than the bounty.
;
; BC The price, as four binary coded decimal digits
@label=TakeFromBounty
c$D347 CALL $D36B    ; Take the price from the bounty.
 $D34A RET NC        ; Return if there was enough.
 $D34B LD HL,$A257   ; Point #REGhl at #R$A257.
 $D34E LD BC,$0003   ; Set the number of bytes to three.
 $D351 JP $D6E1      ; Jump to #R$D6E1.

; Add To Bounty
;
; Used by the routines at #R$A4C9, #R$A68F, #R$BB3A, #R$C869 and #R$C977.
; .
; Adds an amount to #R$A257, as #R$D36B subtracts from it. It also
; writes #N$00 to #R$A269, so the revolver may be loaded again.
;
; BC The amount, as four packed decimal digits
;
; Allow the revolver to be loaded.
@label=AddToBounty
c$D354 XOR A         ; {Write #N$00 to #R$A269.
 $D355 LD ($A269),A  ; }
; Add the lowest two digits.
 $D358 LD HL,$A259   ; Point #REGhl at #R$A259.
 $D35B LD A,C        ; {Add the lower two digits.
 $D35C ADD A,(HL)    ; }
 $D35D DAA           ; Make it decimal.
 $D35E LD (HL),A     ; Store the lowest two digits of #R$A257.
 $D35F DEC HL        ; Move on to the next byte.
; Add the middle two digits.
 $D360 LD A,B        ; {Add the next two digits and the carry.
 $D361 ADC A,(HL)    ; }
 $D362 DAA           ; Make it decimal.
 $D363 LD (HL),A     ; Store the middle two digits of #R$A257.
 $D364 DEC HL        ; Move on to the next byte.
; Add the highest two digits.
 $D365 LD A,(HL)     ; {Add the carry.
 $D366 ADC A,$00     ; }
 $D368 DAA           ; Make it decimal.
 $D369 LD (HL),A     ; Store the highest two digits of #R$A257.
 $D36A RET           ; Return.

; Subtract From Bounty
;
; Used by the routines at #R$C977 and #R$D347.
; .
; Subtracts an amount from #R$A257, as #R$D354 adds to it.
;
;   BC The amount, as four packed decimal digits
; O:F The carry flag is set if the amount is more than the bounty
;
; Subtract the lowest two digits.
@label=SubtractFromBounty
c$D36B LD HL,$A259   ; Point #REGhl at #R$A259.
 $D36E LD A,(HL)     ; {Subtract the lower two digits.
 $D36F SUB C         ; }
 $D370 DAA           ; Make it decimal.
 $D371 LD (HL),A     ; Store the lowest two digits of #R$A257.
 $D372 DEC HL        ; Move on to the next byte.
; Subtract the middle two digits.
 $D373 LD A,(HL)     ; {Subtract the next two digits and the carry.
 $D374 SBC A,B       ; }
 $D375 DAA           ; Make it decimal.
 $D376 LD (HL),A     ; Store the middle two digits of #R$A257.
 $D377 DEC HL        ; Move on to the next byte.
; Subtract the highest two digits.
 $D378 LD A,(HL)     ; {Subtract the carry.
 $D379 SBC A,$00     ; }
 $D37B DAA           ; Make it decimal.
 $D37C LD (HL),A     ; Store the highest two digits of #R$A257.
 $D37D RET           ; Return.

; Draw Bounty
;
; Used by the routine at #R$D2FB.
; .
; Draws #R$A257. In the town it also prints #R$D31F. It draws the
; symbol which goes next to the number.
; #PUSHS #UDGTABLE { #POKES$5C79,$56
; #SIM(start=$A36D,stop=$A392,clear=1,sp=$5E00)
; #SIM(start=$A395,stop=$A3B3)
; #SIM(start=$C7D1,stop=$A3B7)
; #SIM(start=$A3B7,stop=$D31C)
; #SIM(start=$D31C,stop=$A3BA)
; #SCR$03,$00,$15,$08,$03(bounty) } UDGTABLE# #POPS
;
; .
;
; Print the text in the town.
@label=DrawBounty
c$D37E LD A,($A267)  ; {Fetch #R$A267.
 $D381 AND A         ; }
 $D382 JR Z,$D38D    ; Jump to #R$D38D if this is not the town.
 $D384 LD HL,$50A0   ; Point #REGhl at #N$50A0 (in the screen buffer).
 $D387 LD DE,$D31F   ; Point #REGde at #R$D31F.
; Print the text.
 $D38A CALL $D4D7    ; Call #R$D4D7.
; Draw the symbol.
@label=DrawBounty_SkipText
*$D38D CALL $D54A    ; Call #R$D54A.
; Continue on to #R$D390.

; Draw Bounty Digits
;
; Used by the routines at #R$A4C9, #R$A9BF, #R$B778, #R$BB3A, #R$C869 and
; #R$C977.
; .
; Draws the six digits of #R$A257. The number is at a different
; place on the screen in the town.
;
; .
;
; Set the attribute and the number.
@label=DrawBountyDigits
c$D390 LD A,$47      ; {Set the attribute to #COLOUR$47.
 $D392 EX AF,AF'     ; }
 $D393 LD DE,$A257   ; Point #REGde at #R$A257.
; Choose the screen address.
 $D396 LD A,($A267)  ; {Fetch #R$A267.
 $D399 AND A         ; }
 $D39A LD HL,$50C2   ; Point #REGhl at #N$50C2 (in the screen buffer).
 $D39D JR NZ,$D3A2   ; Jump to #R$D3A2 if this is the town.
 $D39F LD HL,$5072   ; Point #REGhl at #N$5072 (in the screen buffer).
; Draw the digits.
@label=DrawBountyDigits_Draw
*$D3A2 LD B,$03      ; Set a count of #N$03 bytes.
 $D3A4 JP $D2B0      ; Jump to #R$D2B0.

; Draw Town Panel
;
; Used by the routine at #R$D2FB.
; .
; Draws the panel at the left of the screen of the town, which is
; #N$08 tiles wide and #N$12 high and has the wanted poster in it. The
; panel is drawn from pairs of bytes, which are the attribute and the
; tile, at #R$5E91. Then it prints the name of the outlaw, draws the
; picture of his face from four images, one above another, and draws the
; reward. This does nothing when #R$A267 is zero.
; #PUSHS #UDGTABLE { #POKES$5C79,$56
; #SIM(start=$A36D,stop=$A392,clear=1,sp=$5E00)
; #SIM(start=$A395,stop=$A3B3)
; #SIM(start=$C7D1,stop=$A3B7)
; #SIM(start=$A3B7,stop=$D313)
; #SIM(start=$D313,stop=$D316)
; #SCR$03,$00,$00,$08,$12(town-panel) } UDGTABLE# #POPS
;
; .
;
; Return if this is not the town.
@label=DrawTownPanel
c$D3A7 LD A,($A267)  ; {Fetch #R$A267, and test it.
 $D3AA AND A         ; }
 $D3AB RET Z         ; Return if this is not the town.
; Draw the panel tiles.
 $D3AC LD HL,$4000   ; Point #REGhl at #N$4000 (in the screen buffer).
 $D3AF LD DE,$5E91   ; Point #REGde at #R$5E91.
 $D3B2 LD C,$12      ; Set a count of #N$12 rows.
; Draw a row.
@label=DrawTownPanel_Row
*$D3B4 LD B,$08      ; Set a count of #N$08 tiles.
 $D3B6 PUSH HL       ; Stash the screen address of the row on the stack.
; Draw a tile.
@label=DrawTownPanel_Tile
*$D3B7 LD A,(DE)     ; {Fetch the attribute and then the tile.
 $D3B8 INC DE        ;
 $D3B9 EX AF,AF'     ;
 $D3BA LD A,(DE)     ;
 $D3BB INC DE        ; }
 $D3BC PUSH BC       ; Stash the counters on the stack.
 $D3BD LD BC,$8B48   ; Point #REGbc at #R$8B48.
 $D3C0 CALL $D639    ; Call #R$D639.
 $D3C3 POP BC        ; Restore the counters from the stack.
 $D3C4 INC L         ; Move on to the next column.
 $D3C5 DJNZ $D3B7    ; Jump to #R$D3B7 if there are any left.
 $D3C7 POP HL        ; Restore the screen address of the row from the stack.
; Move down a row.
 $D3C8 CALL $D64F    ; Call #R$D64F.
 $D3CB DEC C         ; {Jump to #R$D3B4 if there are rows left.
 $D3CC JR NZ,$D3B4   ; }
; Print the name of the outlaw.
 $D3CE CALL $B1F4    ; Call #R$B1F4.
; Find the face images.
 $D3D1 LD A,($A260)  ; Fetch #R$A260.
 $D3D4 LD HL,$B494   ; Point #REGhl at #R$B494.
 $D3D7 CALL $D275    ; Call #R$D275.
 $D3DA LD L,(HL)     ; {Fetch the number of the outlaw.
 $D3DB LD H,$00      ; }
 $D3DD LD C,L        ; {Keep it in #REGbc.
 $D3DE LD B,H        ; }
 $D3DF ADD HL,HL     ; {Multiply it by four.
 $D3E0 ADD HL,HL     ; }
 $D3E1 ADD HL,BC     ; Add it, which makes it five times the number.
 $D3E2 LD BC,$B5B0   ; {Add the address of #R$B5B0.
 $D3E5 ADD HL,BC     ; }
 $D3E6 INC HL        ; Skip the first byte of the record.
 $D3E7 EX DE,HL      ; Keep the address of the images in #REGde.
; Draw the face.
 $D3E8 LD HL,$4F42   ; Point #REGhl at #N$4F42 (in the screen buffer).
 $D3EB LD B,$04      ; Set a count of #N$04 images.
@label=DrawTownPanel_Face
*$D3ED LD A,(DE)     ; {Fetch the number of the next image.
 $D3EE INC DE        ; }
 $D3EF PUSH BC       ; {Stash the registers on the stack.
 $D3F0 PUSH DE       ;
 $D3F1 PUSH HL       ; }
; Draw the image.
 $D3F2 CALL $D400    ; Call #R$D400.
 $D3F5 POP HL        ; Restore the screen address from the stack.
; Move up a row.
 $D3F6 CALL $D659    ; Call #R$D659.
 $D3F9 POP DE        ; {Restore the registers from the stack.
 $D3FA POP BC        ; }
 $D3FB DJNZ $D3ED    ; Jump to #R$D3ED if there are any left.
 $D3FD JP $D423      ; Jump to #R$D423.

; Draw Poster Image
;
; Used by the routine at #R$D3A7.
; .
; Draws an image of thirty-two by eight pixels, as four bytes for
; each line, with the bottom line first. The addresses of the images are
; in #R$6AC6.
; #PUSHS #UDGTABLE { #POKES$5C79,$56
; #SIM(start=$A36D,stop=$A392,clear=1,sp=$5E00)
; #SIM(start=$A395,stop=$A3B3)
; #SIM(start=$C7D1,stop=$A3B7)
; #SIM(start=$A3B7,stop=$D3F2)
; #SIM(start=$D3F2,stop=$D3F5)
; #SCR$03,$02,$0A,$04,$01(poster-image) } UDGTABLE# #POPS
;
; A The number of the image
; HL The screen address of the bottom left of the image
;
; Find the image.
@label=DrawPosterImage
c$D400 EX DE,HL      ; Keep the screen address in #REGde.
 $D401 LD BC,$6AC6   ; Point #REGbc at #R$6AC6.
; Find the address of the image.
 $D404 CALL $C75C    ; Call #R$C75C.
; Read the image with the stack.
 $D407 LD ($A21D),SP ; Set #R$A21D.
 $D40B LD SP,HL      ; Point the stack pointer at the image.
 $D40C EX DE,HL      ; Put the screen address in #REGhl.
 $D40D LD B,$08      ; Set a count of #N$08 lines.
; Draw a line.
@label=DrawPosterImage_Line
*$D40F POP DE        ; {Draw the first two bytes of the line.
 $D410 LD (HL),E     ;
 $D411 INC HL        ;
 $D412 LD (HL),D     ;
 $D413 INC HL        ; }
 $D414 POP DE        ; {Draw the next two bytes of the line.
 $D415 LD (HL),E     ;
 $D416 INC HL        ;
 $D417 LD (HL),D     ; }
 $D418 LD DE,$FEFD   ; {Move up one line, and back to the first byte.
 $D41B ADD HL,DE     ; }
 $D41C DJNZ $D40F    ; Jump to #R$D40F if there are any left.
 $D41E LD SP,($A21D) ; Restore the stack pointer.
 $D422 RET           ; Return.

; Draw Reward
;
; Used by the routine at #R$D3A7.
; .
; Draws the reward for the outlaw on the poster, from #R$B56E for
; #R$A260. It is three bytes of packed decimal digits, without the
; zeroes at the start. The digits are drawn from one byte before #R$8EB0,
; so they are drawn one line lower.
; #PUSHS #UDGTABLE { #POKES$5C79,$56
; #SIM(start=$A36D,stop=$A392,clear=1,sp=$5E00)
; #SIM(start=$A395,stop=$A3B3)
; #SIM(start=$C7D1,stop=$A3B7)
; #SIM(start=$A3B7,stop=$D3FD)
; #SIM(start=$D3FD,stop=$D316)
; #SCR$03,$02,$0C,$03,$01(reward) } UDGTABLE# #POPS
;
; .
;
; Find the reward for the level.
@label=DrawReward
c$D423 LD A,($A260)  ; {Fetch #R$A260, and keep it in #REGc.
 $D426 LD C,A        ; }
 $D427 ADD A,A       ; {Multiply it by #N$03.
 $D428 ADD A,C       ; }
 $D429 LD HL,$B56E   ; Point #REGhl at #R$B56E.
 $D42C CALL $D275    ; Call #R$D275.
 $D42F EX DE,HL      ; Put the address in #REGde.
; Set the screen address.
 $D430 LD HL,$4882   ; Point #REGhl at #N$4882 (in the screen buffer).
 $D433 LD B,$03      ; Set a count of #N$03 bytes.
; Skip the leading zeroes.
@label=DrawReward_Skip
*$D435 LD A,(DE)     ; Fetch the byte.
 $D436 AND %11110000 ; Keep the upper digit.
 $D438 JR NZ,$D443   ; Jump to #R$D443 if it is not zero.
 $D43A LD A,(DE)     ; Fetch the byte.
 $D43B AND %00001111 ; Keep the lower digit.
 $D43D JR NZ,$D453   ; Jump to #R$D453 if it is not zero.
 $D43F INC DE        ; Move on to the next byte.
 $D440 DJNZ $D435    ; Jump to #R$D435 if there are any left.
 $D442 RET           ; Return.
; Draw the upper digit.
@label=DrawReward_Upper
*$D443 LD A,(DE)     ; Fetch the byte.
 $D444 RRCA          ; {Move the upper digit into the lower four bits.
 $D445 RRCA          ;
 $D446 RRCA          ;
 $D447 RRCA          ; }
 $D448 AND %00001111 ; Keep only bits 0-3.
 $D44A PUSH BC       ; Stash the counter on the stack.
 $D44B LD BC,$8EAF   ; Point #REGbc one byte before #R$8EB0.
; Draw the digit.
 $D44E CALL $D663    ; Call #R$D663.
 $D451 INC L         ; Move on to the next column.
 $D452 POP BC        ; Restore the counter from the stack.
; Draw the lower digit.
@label=DrawReward_Lower
*$D453 PUSH BC       ; Stash the counter on the stack.
 $D454 LD BC,$8EAF   ; Point #REGbc one byte before #R$8EB0.
 $D457 LD A,(DE)     ; {Fetch the byte and move to the next one.
 $D458 INC DE        ; }
 $D459 AND %00001111 ; Keep only bits 0-3.
; Draw the digit.
 $D45B CALL $D663    ; Call #R$D663.
 $D45E INC L         ; Move on to the next column.
 $D45F POP BC        ; Restore the counter from the stack.
 $D460 DJNZ $D443    ; Jump to #R$D443 if there are any left.
 $D462 RET           ; Return.

; Draw Telegram Frame
;
; Used by the routine at #R$D2FB.
; .
; Draws the frame of the telegram, which has the word at #R$D4CD in
; its lower edge. The corners and the edges are the same tiles at the top
; and the left, drawn reflected for the bottom and the right.
; #PUSHS #UDGTABLE { #POKES$5C79,$56
; #SIM(start=$A36D,stop=$A392,clear=1,sp=$5E00)
; #SIM(start=$A395,stop=$A3B3)
; #SIM(start=$C7D1,stop=$A3B7)
; #SIM(start=$A3B7,stop=$D310)
; #SIM(start=$D310,stop=$D313)
; #SCR$03,$10,$10,$10,$08(telegram-frame) } UDGTABLE# #POPS
;
; .
;
; Set the attribute and the tile set.
@label=DrawTelegramFrame
c$D463 LD A,$4F      ; {Set the attribute to #COLOUR$4F.
 $D465 EX AF,AF'     ; }
 $D466 LD BC,($A20F) ; Fetch #R$A20F.
; Draw the top left corner.
 $D46A LD HL,$500C   ; Point #REGhl at #N$500C (in the screen buffer).
; Move it to the right in the town.
 $D46D CALL $D272    ; Call #R$D272.
 $D470 LD A,$12      ; Set the tile to the top left corner.
 $D472 CALL $D639    ; Call #R$D639.
; Draw the top edge.
 $D475 INC L         ; Move on to the next column.
 $D476 LD E,$0E      ; {Set a count of #N$0E tiles, and fetch the top edge.
 $D478 LD A,$13      ; }
 $D47A CALL $D62F    ; Call #R$D62F.
; Draw the top right corner.
 $D47D LD A,$52      ; Set the tile to the top right corner.
 $D47F CALL $D639    ; Call #R$D639.
; Draw the left edge.
 $D482 LD HL,$502C   ; Point #REGhl at #N$502C (in the screen buffer).
; Move it to the right in the town.
 $D485 CALL $D272    ; Call #R$D272.
 $D488 LD E,$06      ; {Set a count of #N$06 tiles, and fetch the left edge.
 $D48A LD A,$14      ; }
 $D48C CALL $D623    ; Call #R$D623.
; Draw the right edge.
 $D48F LD HL,$503B   ; Point #REGhl at #N$503B (in the screen buffer).
; Move it to the right in the town.
 $D492 CALL $D272    ; Call #R$D272.
 $D495 LD E,$06      ; {Set a count of #N$06 tiles, and fetch the right edge.
 $D497 LD A,$54      ; }
 $D499 CALL $D623    ; Call #R$D623.
; Draw the bottom left corner.
 $D49C LD HL,$50EC   ; Point #REGhl at #N$50EC (in the screen buffer).
; Move it to the right in the town.
 $D49F CALL $D272    ; Call #R$D272.
 $D4A2 LD A,$92      ; Set the tile to the bottom left corner.
 $D4A4 CALL $D639    ; Call #R$D639.
; Draw the first part of the bottom edge.
 $D4A7 INC L         ; Move on to the next column.
 $D4A8 LD E,$03      ; {Set a count of #N$03 tiles, and fetch the bottom edge.
 $D4AA LD A,$93      ; }
 $D4AC CALL $D62F    ; Call #R$D62F.
; Draw the second part of the bottom edge.
 $D4AF LD HL,$50F8   ; Point #REGhl at #N$50F8 (in the screen buffer).
; Move it to the right in the town.
 $D4B2 CALL $D272    ; Call #R$D272.
 $D4B5 LD E,$03      ; {Set a count of #N$03 tiles, and fetch the bottom edge.
 $D4B7 LD A,$93      ; }
 $D4B9 CALL $D62F    ; Call #R$D62F.
; Draw the bottom right corner.
 $D4BC LD A,$D2      ; Set the tile to the bottom right corner.
 $D4BE CALL $D639    ; Call #R$D639.
; Print the word.
 $D4C1 LD HL,$50F0   ; Point #REGhl at #N$50F0 (in the screen buffer).
; Move it to the right in the town.
 $D4C4 CALL $D272    ; Call #R$D272.
 $D4C7 LD DE,$D4CD   ; Point #REGde at #R$D4CD.
 $D4CA JP $D4D7      ; Jump to #R$D4D7.

; Telegram Text
;
; The word which is printed in the frame of the telegram, which starts
; with its attribute and ends with zero.
@label=TelegramText
g$D4CD DEFB $4F        ; Attribute: #COLOUR(#PEEK(#PC)).
 $D4CE DEFM "TELEGRAM" ; "TELEGRAM".
 $D4D6 DEFB $00        ; The end of the text.

; Print Text
;
; Used by the routines at #R$AB77, #R$D37E and #R$D463.
; .
; Prints a text from #R$8EA8, one tile for each character. The text
; starts with an attribute and ends with #N$00.
; #PUSHS #UDGTABLE { #SIM(start=$D6DB,stop=$D6EA,clear=1,sp=$5E00)
; #SIM(start=$D6D3,stop=$D6EA,de=$47)
; #SIM(start=$ABE7,stop=$ABF0)
; #SCR$03,$0A,$17,$0D,$01(print-text) } UDGTABLE# #POPS
;
; DE The address of the attribute and the text
; HL The screen address
;
; Fetch the attribute.
@label=PrintText
c$D4D7 LD A,(DE)     ; {Fetch the attribute, and keep it in the alternate
 $D4D8 INC DE        ; accumulator.
 $D4D9 EX AF,AF'     ; }
; Print the next character.
@label=PrintText_Next
*$D4DA LD A,(DE)     ; {Return if it is the terminator.
 $D4DB AND A         ;
 $D4DC RET Z         ; }
 $D4DD INC DE        ; Move on to the next character.
 $D4DE CALL $D4EA    ; Call #R$D4EA.
 $D4E1 LD BC,$8EA8   ; Point #REGbc at #R$8EA8.
 $D4E4 CALL $D639    ; Call #R$D639.
 $D4E7 INC L         ; Move on to the next column.
 $D4E8 JR $D4DA      ; Jump to #R$D4DA.

; Convert Character
;
; Used by the routines at #R$A6FC, #R$A7DA, #R$AA9A, #R$ACF6, #R$B1F4 and
; #R$D4D7.
; .
; Converts a character into the number of its tile in #R$8EA8. The
; space is #N($00), the digits are from #N$01 to #N$0A and the letters
; begin at #N$0B. A character which is not one of these gives a number
; which has other bits set.
;
;   A The character
; O:A The number of the tile
;
; Make a space into zero.
@label=ConvertCharacter
c$D4EA SUB $20       ; {Take away #N($20), and keep it in #REGc.
 $D4EC LD C,A        ; }
 $D4ED AND %00111111 ; Keep only bits 0-5.
 $D4EF RET Z         ; Return if it is a space.
; Make the digits begin at one.
 $D4F0 LD A,C        ; {Take away #N($0F), and keep it in #REGc.
 $D4F1 SUB $0F       ;
 $D4F3 LD C,A        ; }
 $D4F4 AND %00111111 ; Keep only bits 0-5.
 $D4F6 CP $0B        ; {Return if it is a digit.
 $D4F8 RET C         ; }
; Make the letters begin at eleven.
 $D4F9 LD A,C        ; {Take away #N$07.
 $D4FA SUB $07       ; }
 $D4FC RET           ; Return.

; Build Shift Tables
;
; Used by the routine at #R$A36D.
; .
; Builds #R$FA00, #R$F200 and #R$F900, which the routines for
; drawing sprites use. Each table is a page, which has an entry for each
; value of a byte at the low byte of the address. For a byte which is
; moved to the right along a row by six pixels, page #N$FE has the part
; which stays in the byte and page #N$FF has the part which moves into
; the next byte. Pages #N$FC and #N$FD are the same for four pixels, and
; pages #N$FA and #N$FB for two. Pages #N$F6 and #N$F7, #N$F4 and #N$F5,
; and #N$F2 and #N$F3 are the same for the byte with its bits turned
; round, which is used for sprites which are reflected. #R$F900 has each
; byte with its bits turned round.
;
; .
;
; Build #R$FA00.
@label=BuildShiftTables
c$D4FD LD L,$00      ; Start with the byte at #N$00.
@label=BuildShiftTables_Normal
*$D4FF LD D,$00      ; {Make the word the byte.
 $D501 LD E,L        ; }
 $D502 LD H,$FF      ; Start at page #N$FF.
 $D504 LD B,$03      ; Set a count of #N$03 pairs.
; Shift the word left by two bits and store it.
@label=BuildShiftTables_NormalLoop
*$D506 SLA E         ; {Shift the word left by two bits.
 $D508 RL D          ;
 $D50A SLA E         ;
 $D50C RL D          ; }
 $D50E LD (HL),E     ; {Store the pair in the next two pages.
 $D50F DEC H         ;
 $D510 LD (HL),D     ;
 $D511 DEC H         ; }
 $D512 DJNZ $D506    ; Jump to #R$D506 if there are any left.
 $D514 INC L         ; Move on to the next byte.
 $D515 JR NZ,$D4FF   ; Jump to #R$D4FF if there are any left.
; Build #R$F200.
 $D517 LD L,$00      ; Start with the byte at #N$00.
@label=BuildShiftTables_Reversed
*$D519 LD D,$00      ; Clear the high byte of the word.
 $D51B LD B,$08      ; {Set a count of #N$08 bits, and copy the byte into
 $D51D LD A,L        ; #REGa.}
; Turn the bits of the byte round.
@label=BuildShiftTables_Reverse
*$D51E RRCA          ; {Move the next bit into #REGc from the other end.
 $D51F RL C          ; }
 $D521 DJNZ $D51E    ; Jump to #R$D51E if there are any left.
 $D523 LD E,C        ; Make the low byte the reversed byte.
 $D524 LD H,$F7      ; Start at page #N$F7.
 $D526 LD B,$03      ; Set a count of #N$03 pairs.
; Shift the word left by two bits and store it.
@label=BuildShiftTables_ReversedLoop
*$D528 SLA E         ; {Shift the word left by two bits.
 $D52A RL D          ;
 $D52C SLA E         ;
 $D52E RL D          ; }
 $D530 LD (HL),E     ; {Store the pair in the next two pages.
 $D531 DEC H         ;
 $D532 LD (HL),D     ;
 $D533 DEC H         ; }
 $D534 DJNZ $D528    ; Jump to #R$D528 if there are any left.
 $D536 INC L         ; Move on to the next byte.
 $D537 JR NZ,$D519   ; Jump to #R$D519 if there are any left.
; Build #R$F900.
 $D539 LD HL,$F900   ; Point #REGhl at #R$F900.
@label=BuildShiftTables_ReverseTable
*$D53C LD D,L        ; {Copy the byte into #REGd, and set a count of #N$08
 $D53D LD B,$08      ; bits.}
@label=BuildShiftTables_ReverseBits
*$D53F SRL D         ; {Move the lowest bit of the byte into the other end of
 $D541 RL E          ; #REGe.}
 $D543 DJNZ $D53F    ; Jump to #R$D53F if there are any left.
 $D545 LD (HL),E     ; Store the byte turned round.
 $D546 INC L         ; Move on to the next byte.
 $D547 JR NZ,$D53C   ; Jump to #R$D53C if there are any left.
 $D549 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$E0FB }
; LIST#

; Draw Bounty Symbol
;
; Used by the routine at #R$D37E.
; .
; Draws the symbol which goes before the bounty, as a block of two by two
; tiles.
; #PUSHS #UDGTABLE { #POKES$5C79,$56
; #SIM(start=$A36D,stop=$A392,clear=1,sp=$5E00)
; #SIM(start=$A395,stop=$A3B3)
; #SIM(start=$C7D1,stop=$A3B7)
; #SIM(start=$A3B7,stop=$D38D)
; #SIM(start=$D38D,stop=$D390)
; #SCR$03,$00,$16,$02,$02(bounty-symbol) } UDGTABLE# #POPS
;
; .
;
; Set the attribute and the tiles.
@label=DrawBountySymbol
c$D54A LD A,$47      ; {Set the attribute to #COLOUR$47.
 $D54C EX AF,AF'     ; }
 $D54D LD DE,$D561   ; Point #REGde at #R$D561.
; Choose the screen address.
 $D550 LD A,($A267)  ; {Fetch #R$A267.
 $D553 AND A         ; }
 $D554 LD HL,$50C0   ; Point #REGhl at #N$50C0 (in the screen buffer).
 $D557 JR NZ,$D55C   ; Jump to #R$D55C if this is the town.
 $D559 LD HL,$5070   ; Point #REGhl at #N$5070 (in the screen buffer).
; Draw the block.
@label=DrawBountySymbol_Draw
*$D55C LD BC,$0202   ; Set the size of the block to two by two.
 $D55F JR $D595      ; Jump to #R$D595.

; Bounty Symbol Tiles
;
; The numbers of the tiles of the symbol which goes before the
; bounty, drawn by #R$D54A in two rows of two from #R$8CF0. Bits 6
; and 7 of a number say how the tile is reflected.
@label=BountySymbolTiles
b$D561 DEFB $15      ; #UDGTABLE { #N(#PEEK(#PC)) |
                     ; #UDG($8CF0+#PEEK(#PC)*$08,attr=$47) } UDGTABLE#
 $D562 DEFB $16      ; #UDGTABLE { #N(#PEEK(#PC)) |
                     ; #UDG($8CF0+#PEEK(#PC)*$08,attr=$47) } UDGTABLE#
 $D563 DEFB $17      ; #UDGTABLE { #N(#PEEK(#PC)) |
                     ; #UDG($8CF0+#PEEK(#PC)*$08,attr=$47) } UDGTABLE#
 $D564 DEFB $18      ; #UDGTABLE { #N(#PEEK(#PC)) |
                     ; #UDG($8CF0+#PEEK(#PC)*$08,attr=$47) } UDGTABLE#

; Draw Revolver Display
;
; Used by the routine at #R$D2FB.
; .
; Draws the picture of the revolver, which is a block of eight by eight
; tiles, and then colours the chambers which are loaded.
; #PUSHS #UDGTABLE { #POKES$5C79,$56
; #SIM(start=$A36D,stop=$A392,clear=1,sp=$5E00)
; #SIM(start=$A395,stop=$A3B3)
; #SIM(start=$C7D1,stop=$A3B7)
; #SIM(start=$A3B7,stop=$D30D)
; #SIM(start=$D30D,stop=$D310)
; #SCR$03,$08,$10,$08,$08(revolver-display) } UDGTABLE# #POPS
;
; .
;
; Draw the picture of the revolver.
@label=DrawRevolverDisplay
c$D565 LD A,$41      ; {Set the attribute to #COLOUR$41.
 $D567 EX AF,AF'     ; }
 $D568 LD HL,$5004   ; Point #REGhl at #N$5004 (in the screen buffer).
; Move it to the right in the town.
 $D56B CALL $D272    ; Call #R$D272.
 $D56E LD DE,$5E51   ; Point #REGde at #R$5E51.
 $D571 LD BC,$0808   ; Set the size of the block to eight by eight.
; Draw the block.
 $D574 CALL $D595    ; Call #R$D595.
; Colour the chambers which are loaded.
 $D577 LD A,($A262)  ; {Return if #R$A262 is zero.
 $D57A AND A         ;
 $D57B RET Z         ; }
 $D57C LD E,A        ; Keep the number in #REGe.
 $D57D XOR A         ; Start with the first chamber.
; Colour a loaded chamber.
@label=DrawRevolverDisplay_Chamber
*$D57E PUSH AF       ; {Stash the chamber number and the number of bullets on
 $D57F PUSH DE       ; the stack.}
 $D580 LD BC,$C9E0   ; Point #REGbc at #R$C9E0.
; Find the attribute address of the chamber.
 $D583 CALL $C75C    ; Call #R$C75C.
; Move it to the right in the town.
 $D586 CALL $D272    ; Call #R$D272.
 $D589 LD A,$71      ; Set the attribute to #COLOUR$71.
; Colour the chamber.
 $D58B CALL $C9CF    ; Call #R$C9CF.
 $D58E POP DE        ; {Restore the chamber number and the number of bullets
 $D58F POP AF        ; from the stack.}
 $D590 INC A         ; Move on to the next chamber.
 $D591 CP E          ; {Jump to #R$D57E if there are chambers left.
 $D592 JR NZ,$D57E   ; }
 $D594 RET           ; Return.

; Draw Tile Block
;
; Used by the routines at #R$ADE3, #R$D27C, #R$D327, #R$D54A and #R$D565.
; .
; Draws a block of tiles, which are held as one byte for each tile, row by
; row from left to right and top to bottom. The tiles are from the tile set
; whose address is in #R$A20F.
;
; B The width of the block
; C The height of the block
; DE The address of the numbers of the tiles
; HL The screen address of the top left
; A' The attribute
;
; Draw each row from left to right.
@label=DrawTileBlock
c$D595 PUSH BC       ; {Stash the size and the screen address on the stack.
 $D596 PUSH HL       ; }
; Draw a tile.
@label=DrawTileBlock_Tile
*$D597 LD A,(DE)     ; {Fetch the number of the tile.
 $D598 INC DE        ; }
 $D599 PUSH BC       ; Stash the counters on the stack.
 $D59A LD BC,($A20F) ; Fetch #R$A20F.
 $D59E CALL $D639    ; Call #R$D639.
 $D5A1 POP BC        ; Restore the counters from the stack.
 $D5A2 INC L         ; Move on to the next column.
 $D5A3 DJNZ $D597    ; Jump to #R$D597 if there are tiles left in the row.
; Move down a row.
 $D5A5 POP HL        ; Restore the screen address of the row from the stack.
 $D5A6 CALL $D64F    ; Call #R$D64F.
 $D5A9 POP BC        ; Restore the size from the stack.
 $D5AA DEC C         ; Count down the rows.
 $D5AB JR NZ,$D595   ; Jump to #R$D595 if there are rows left.
 $D5AD RET           ; Return.

; Draw Tile Block Reflected
;
; Used by the routine at #R$D327.
; .
; The same as #R$D595, except that each row is drawn from right to left
; and each tile is reflected, which makes a reflection of the block.
;
; B The width of the block
; C The height of the block
; DE The address of the numbers of the tiles
; HL The screen address of the top right
; A' The attribute
;
; Draw each row from right to left.
@label=DrawTileBlockReflected
c$D5AE PUSH BC       ; {Stash the size and the screen address on the stack.
 $D5AF PUSH HL       ; }
; Draw a tile, reflected.
@label=DrawTileBlockReflected_Tile
*$D5B0 LD A,(DE)     ; {Fetch the number of the tile.
 $D5B1 INC DE        ; }
 $D5B2 XOR %01000000 ; Reflect it horizontally.
 $D5B4 PUSH BC       ; Stash the counters on the stack.
 $D5B5 LD BC,($A20F) ; Fetch #R$A20F.
; Draw the tile.
 $D5B9 CALL $D639    ; Call #R$D639.
 $D5BC POP BC        ; Restore the counters from the stack.
 $D5BD DEC L         ; Move on to the next column to the left.
 $D5BE DJNZ $D5B0    ; Jump to #R$D5B0 if there are tiles left in the row.
; Move down a row.
 $D5C0 POP HL        ; Restore the screen address of the row from the stack.
 $D5C1 CALL $D64F    ; Call #R$D64F.
 $D5C4 POP BC        ; Restore the size from the stack.
 $D5C5 DEC C         ; Count down the rows.
 $D5C6 JR NZ,$D5AE   ; Jump to #R$D5AE if there are rows left.
 $D5C8 RET           ; Return.

; Draw Border
;
; Used by the routine at #R$D2FB.
; .
; Draws the border around the playfield, which is twenty-four tiles wide
; and sixteen high. The corners and the edges are the same tiles at the top and
; the left, drawn reflected for the bottom and the right.
; #PUSHS #UDGTABLE { #POKES$5C79,$56
; #SIM(start=$A36D,stop=$A392,clear=1,sp=$5E00)
; #SIM(start=$A395,stop=$A3B3)
; #SIM(start=$C7D1,stop=$A3B7)
; #SIM(start=$A3B7,stop=$D30A)
; #SIM(start=$D30A,stop=$D30D)
; #SCR$03,$08,$00,$18,$10(border) } UDGTABLE# #POPS
;
; .
;
; Set the attribute and the tile set.
@label=DrawBorder
c$D5C9 LD A,$73      ; {Set the attribute to #COLOUR$73.
 $D5CB EX AF,AF'     ; }
 $D5CC LD BC,($A20F) ; Fetch #R$A20F.
; Draw the top left corner.
 $D5D0 LD HL,$4004   ; Point #REGhl at #N$4004 (in the screen buffer).
; Move it to the right in the town.
 $D5D3 CALL $D272    ; Call #R$D272.
 $D5D6 LD A,$01      ; Set the tile to the top left corner.
 $D5D8 CALL $D639    ; Call #R$D639.
; Draw the top edge.
 $D5DB INC L         ; Move on to the next column.
 $D5DC LD E,$16      ; {Set a count of #N$16 tiles, and fetch the top edge.
 $D5DE LD A,$02      ; }
 $D5E0 CALL $D62F    ; Call #R$D62F.
; Draw the top right corner.
 $D5E3 LD HL,$401B   ; Point #REGhl at #N$401B (in the screen buffer).
; Move it to the right in the town.
 $D5E6 CALL $D272    ; Call #R$D272.
 $D5E9 LD A,$41      ; Set the tile to the top right corner.
 $D5EB CALL $D639    ; Call #R$D639.
; Draw the bottom left corner.
 $D5EE LD HL,$48E4   ; Point #REGhl at #N$48E4 (in the screen buffer).
; Move it to the right in the town.
 $D5F1 CALL $D272    ; Call #R$D272.
 $D5F4 LD A,$81      ; Set the tile to the bottom left corner.
 $D5F6 CALL $D639    ; Call #R$D639.
; Draw the bottom edge.
 $D5F9 INC L         ; Move on to the next column.
 $D5FA LD E,$16      ; {Set a count of #N$16 tiles, and fetch the bottom edge.
 $D5FC LD A,$82      ; }
 $D5FE CALL $D62F    ; Call #R$D62F.
; Draw the bottom right corner.
 $D601 LD HL,$48FB   ; Point #REGhl at #N$48FB (in the screen buffer).
; Move it to the right in the town.
 $D604 CALL $D272    ; Call #R$D272.
 $D607 LD A,$C1      ; Set the tile to the bottom right corner.
 $D609 CALL $D639    ; Call #R$D639.
; Draw the left edge.
 $D60C LD HL,$4024   ; Point #REGhl at #N$4024 (in the screen buffer).
; Move it to the right in the town.
 $D60F CALL $D272    ; Call #R$D272.
 $D612 LD E,$0E      ; {Set a count of #N$0E tiles, and fetch the left edge.
 $D614 LD A,$03      ; }
 $D616 CALL $D623    ; Call #R$D623.
; Draw the right edge.
 $D619 LD HL,$403B   ; Point #REGhl at #N$403B (in the screen buffer).
; Move it to the right in the town.
 $D61C CALL $D272    ; Call #R$D272.
 $D61F LD E,$0E      ; {Set a count of #N$0E tiles, and fetch the right edge.
 $D621 LD A,$43      ; }
; Continue on to #R$D623.

; Draw Tile Column
;
; Used by the routines at #R$D463 and #R$D5C9.
; .
; Draws a number of tiles one below another.
;
; A The tile
; E The number of tiles
; BC The address of the tile set
; HL The screen address of the top
; A' The attribute
;
; Draw a tile and move down a row.
@label=DrawTileColumn
c$D623 PUSH AF       ; Stash the tile on the stack.
 $D624 CALL $D639    ; Call #R$D639.
 $D627 CALL $D64F    ; Call #R$D64F.
 $D62A POP AF        ; Restore the tile from the stack.
 $D62B DEC E         ; Count down the tiles.
 $D62C JR NZ,$D623   ; Jump to #R$D623 if there are any left.
 $D62E RET           ; Return.

; Draw Tile Row
;
; Used by the routines at #R$D463 and #R$D5C9.
; .
; Draws a number of tiles side by side.
;
; A The tile
; E The number of tiles
; BC The address of the tile set
; HL The screen address of the left
; A' The attribute
;
; Draw a tile and move on to the next column.
@label=DrawTileRow
c$D62F PUSH AF       ; Stash the tile on the stack.
 $D630 CALL $D639    ; Call #R$D639.
 $D633 POP AF        ; Restore the tile from the stack.
 $D634 INC L         ; Move on to the next column.
 $D635 DEC E         ; Count down the tiles.
 $D636 JR NZ,$D62F   ; Jump to #R$D62F if there are any left.
 $D638 RET           ; Return.

; Draw Tile
;
; Used by the routines at #R$A6FC, #R$A7DA, #R$D3A7, #R$D463, #R$D4D7, #R$D595,
; #R$D5AE, #R$D5C9, #R$D623 and #R$D62F.
; .
; Draws a tile of eight by eight pixels and sets its attribute.
;
; A The number of the tile, with bits 6 and 7 which say how to reflect it
; BC The address of the tile set
; HL The screen address
; A' The attribute
@label=DrawTile
c$D639 CALL $D663    ; Draw the tile.
; Continue on to #R$D63C.
; .
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$CB5B }
; LIST#

; Set Tile Attribute
;
; Used by the routines at #R$AAC4, #R$AAE7 and #R$D2DD.
; .
; Sets the attribute of the character square that holds the screen
; address.
;
; HL The screen address
; A' The attribute
;
; Find the attribute address from the screen address.
@label=SetTileAttribute
c$D63C PUSH DE       ; {Stash #REGde and #REGhl on the stack.
 $D63D PUSH HL       ; }
 $D63E LD A,H        ; {Find the third of the screen from the high byte.
 $D63F RRCA          ;
 $D640 RRCA          ;
 $D641 RRCA          ; }
 $D642 AND %00000011 ; Keep the two bits of the third.
 $D644 LD H,A        ; Make it the high byte of the attribute address.
 $D645 LD DE,$5800   ; {Add #N$5800, the start of the attribute buffer.
 $D648 ADD HL,DE     ; }
; Write the attribute.
 $D649 EX AF,AF'     ; Fetch the attribute.
 $D64A LD (HL),A     ; Set the attribute.
 $D64B EX AF,AF'     ; Keep it.
 $D64C POP HL        ; {Restore #REGhl and #REGde from the stack.
 $D64D POP DE        ; }
 $D64E RET           ; Return.

; Move Down Row
;
; Used by the routines at #R$AAE7, #R$D2DD, #R$D3A7, #R$D595, #R$D5AE and
; #R$D623.
; .
; Moves a screen address down by one row of characters.
;
;   HL The screen address
; O:HL The new screen address
@label=MoveDownRow
c$D64F LD A,L        ; {Add thirty-two to the low byte.
 $D650 ADD A,$20     ;
 $D652 LD L,A        ; }
 $D653 RET NC        ; Return if it has not gone into the next third.
 $D654 LD A,H        ; {Add eight to the high byte.
 $D655 ADD A,$08     ;
 $D657 LD H,A        ; }
 $D658 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #MARTIANOIDS$B6B2 }
; { #NIGHTSHADE$CB71 }
; { #UNDERWURLDE$98D5 }
; LIST#

; Move Up Row
;
; Used by the routine at #R$D3A7.
; .
; Moves a screen address up by one row of characters.
;
;   HL The screen address
; O:HL The new screen address
@label=MoveUpRow
c$D659 LD A,L        ; {Subtract thirty-two from the low byte.
 $D65A SUB $20       ;
 $D65C LD L,A        ; }
 $D65D RET NC        ; Return if it has not gone into the previous third.
 $D65E LD A,H        ; {Subtract eight from the high byte.
 $D65F SUB $08       ;
 $D661 LD H,A        ; }
 $D662 RET           ; Return.

; Draw Tile Pixels
;
; Used by the routines at #R$D423 and #R$D639.
; .
; Draws the pixels of a tile of eight by eight pixels. Bit 7 of the number
; of the tile says that it is reflected vertically and bit 6 that it is
; reflected horizontally.
;
; A The number of the tile, with bits 6 and 7 which say how to reflect it
; BC The address of the tile set
; HL The screen address
;
; Find the pixels of the tile.
@label=DrawTilePixels
c$D663 PUSH BC       ; {Save the registers.
 $D664 PUSH DE       ;
 $D665 PUSH HL       ;
 $D666 PUSH AF       ; }
 $D667 EX DE,HL      ; Keep the screen address in #REGde.
 $D668 AND %00111111 ; Keep the number of the tile.
 $D66A LD L,A        ; {Move it to #REGhl.
 $D66B LD H,$00      ; }
 $D66D ADD HL,HL     ; {Multiply it by eight.
 $D66E ADD HL,HL     ;
 $D66F ADD HL,HL     ; }
 $D670 ADD HL,BC     ; Add the address of the tile set.
 $D671 EX DE,HL      ; Put the address of the tile in #REGde and the screen address in
                     ; #REGhl.
; Choose how to reflect it.
 $D672 POP AF        ; Restore the number of the tile.
 $D673 RLCA          ; {Move bits 6 and 7 to bits 0 and 1.
 $D674 RLCA          ; }
 $D675 AND %00000011 ; Keep them.
 $D677 JR Z,$D686    ; Jump to draw the tile as it is if neither is set.
 $D679 DEC A         ; Count down.
 $D67A JR Z,$D68B    ; Jump to draw it reflected horizontally if that was one.
 $D67C DEC A         ; Count down.
 $D67D JR Z,$D690    ; Jump to draw it reflected vertically if that was two.
 $D67F CALL $D6BD    ; Otherwise draw it reflected both ways.
@label=DrawTilePixels_Done
*$D682 POP HL        ; {Restore the registers and return.
 $D683 POP DE        ;
 $D684 POP BC        ;
 $D685 RET           ; }
@label=DrawTilePixels_Normal
*$D686 CALL $D695    ; {Draw the tile as it is.
 $D689 JR $D682      ; }
@label=DrawTilePixels_Horizontal
*$D68B CALL $D69E    ; {Draw the tile reflected horizontally.
 $D68E JR $D682      ; }
@label=DrawTilePixels_Vertical
*$D690 CALL $D6AD    ; {Draw the tile reflected vertically.
 $D693 JR $D682      ; }

; Draw Tile Normal
;
; Used by the routine at #R$D663.
; .
; Draws a tile as it is.
;
; DE The address of the tile
; HL The screen address
@label=DrawTileNormal
c$D695 LD B,$08      ; Set the number of lines.
@label=DrawTileNormal_Line
*$D697 LD A,(DE)     ; {Draw a line.
 $D698 INC DE        ;
 $D699 LD (HL),A     ;
 $D69A INC H         ; }
 $D69B DJNZ $D697    ; Go back for the next line.
 $D69D RET           ; Return.

; Draw Tile Horizontal
;
; Used by the routine at #R$D663.
; .
; Draws a tile reflected horizontally, using the page of bytes turned
; round which is at #N$F9.
;
; DE The address of the tile
; HL The screen address
;
; Draw each line turned round.
@label=DrawTileHorizontal
c$D69E LD B,$08      ; Set the number of lines.
@label=DrawTileHorizontal_Line
*$D6A0 LD A,(DE)     ; {Fetch a line and keep it in #REGc.
 $D6A1 INC DE        ;
 $D6A2 LD C,A        ; }
 $D6A3 PUSH BC       ; Save the counters.
 $D6A4 LD B,$F9      ; Point #REGbc at the page of bytes turned round.
 $D6A6 LD A,(BC)     ; {Draw the line turned round.
 $D6A7 LD (HL),A     ;
 $D6A8 INC H         ; }
 $D6A9 POP BC        ; Restore the counters.
 $D6AA DJNZ $D6A0    ; Go back for the next line.
 $D6AC RET           ; Return.

; Draw Tile Vertical
;
; Used by the routine at #R$D663.
; .
; Draws a tile reflected vertically, which is the lines from the last to
; the first.
;
; DE The address of the tile
; HL The screen address
@label=DrawTileVertical
c$D6AD LD B,$08      ; Set the number of lines.
 $D6AF INC DE        ; {Move to the last line.
 $D6B0 INC DE        ;
 $D6B1 INC DE        ;
 $D6B2 INC DE        ;
 $D6B3 INC DE        ;
 $D6B4 INC DE        ;
 $D6B5 INC DE        ; }
@label=DrawTileVertical_Line
*$D6B6 LD A,(DE)     ; {Draw a line and move to the previous one.
 $D6B7 DEC DE        ;
 $D6B8 LD (HL),A     ;
 $D6B9 INC H         ; }
 $D6BA DJNZ $D6B6    ; Go back for the next line.
 $D6BC RET           ; Return.

; Draw Tile Both
;
; Used by the routine at #R$D663.
; .
; Draws a tile reflected both horizontally and vertically.
;
; DE The address of the tile
; HL The screen address
;
; Start at the last line.
@label=DrawTileBoth
c$D6BD LD B,$08      ; Set the number of lines.
 $D6BF INC DE        ; {Move to the last line.
 $D6C0 INC DE        ;
 $D6C1 INC DE        ;
 $D6C2 INC DE        ;
 $D6C3 INC DE        ;
 $D6C4 INC DE        ;
 $D6C5 INC DE        ; }
; Draw each line turned round, from last to first.
@label=DrawTileBoth_Line
*$D6C6 LD A,(DE)     ; {Fetch a line, move to the previous one and keep the
 $D6C7 DEC DE        ; line in #REGc.
 $D6C8 LD C,A        ; }
 $D6C9 PUSH BC       ; Save the counters.
 $D6CA LD B,$F9      ; Point #REGbc at the page of bytes turned round.
 $D6CC LD A,(BC)     ; {Draw the line turned round.
 $D6CD LD (HL),A     ;
 $D6CE INC H         ; }
 $D6CF POP BC        ; Restore the counters.
 $D6D0 DJNZ $D6C6    ; Go back for the next line.
 $D6D2 RET           ; Return.

; Set Attributes
;
; Used by the routines at #R$A50A, #R$A6C9, #R$AB77, #R$B7A8 and #R$D2FB.
; .
; Sets all of the attributes to a value.
;
; E The attribute
@label=SetAttributes
c$D6D3 LD HL,$5800   ; Point #REGhl at #N$5800 (in the attribute buffer).
 $D6D6 LD BC,$0300   ; Set the number of attributes.
 $D6D9 JR $D6E3      ; Jump to clear them.

; Clear Screen
;
; Used by the routines at #R$A50A, #R$A6C9, #R$AB77, #R$B7A8 and #R$D2FB.
; .
; Clears the pixel bytes of the screen.
@label=ClearScreen
c$D6DB LD HL,$4000   ; Point #REGhl at #N$4000 (in the screen buffer).
 $D6DE LD BC,$1800   ; Set the number of bytes.
; Continue on to #R$D6E1.
; .
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CE60 }
; { #ATICATAC$80B4 }
; { #COOKIE$74D4 }
; { #CYBERUN$9A7E }
; { #JETPAC$71B8 }
; { #KNIGHTLORE$D544 }
; { #LUNARJETMAN$84AD }
; { #NIGHTSHADE$E5A8 }
; { #PSSST$7439 }
; { #SABREWULF$BB81 }
; { #TRANZAM$7211 }
; LIST#

; Fill Memory
;
; Used by the routines at #R$A36D, #R$B754, #R$C7C8 and #R$D347.
; .
; Fills an area of memory with
; zero. The entry point at #R$D6E3 fills
; it with the byte in #REGe.
;
; BC Number of bytes
; HL Address of the first byte
@label=FillMemory
c$D6E1 LD E,$00      ; Set #REGe to #N$00.
; This entry point is used by the routine at #R$D6D3.
@label=FillMemory_WithValue
*$D6E3 LD (HL),E     ; Write #REGe.
 $D6E4 INC HL        ; Increment #REGhl.
 $D6E5 DEC BC        ; Decrement #REGbc.
 $D6E6 LD A,B        ; {Jump to #R$D6E3 if #REGbc is
 $D6E7 OR C          ; not zero.
 $D6E8 JR NZ,$D6E3   ; }
 $D6EA RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CE56 }
; { #KNIGHTLORE$D53A }
; { #MARTIANOIDS$B1A3 }
; { #NIGHTSHADE$E5BA }
; { #PENTAGRAM$CB77 }
; { #UNDERWURLDE$9569 }
; LIST#

; Playfield Buffer
