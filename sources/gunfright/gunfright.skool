; Blank Sprite
;
; A sprite which has no columns and no rows, so nothing is drawn. It is
; used for the sprite numbers #N$00, #N$0C, #N$0D, #N$32, #N$33.
@label=BlankSprite
b$68EA DEFB $00,$00  ; The number of columns and the number of rows.

