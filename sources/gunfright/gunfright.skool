; Movement Sound Counter
;
; Counted up each time #R$AEED is called for a moving figure. Its lowest
; bits say on which calls a tone is played.
@label=MovementSoundCounter
g$A207 DEFB $7F

; Protection Timer
;
; The time for which the sheriff is protected, which is counted down by
; the routine for the sheriff. While it is not zero the sheriff does not touch
; objects.
@label=ProtectionTimer
g$A208 DEFB $40

; Riding Timer
;
; The time for which the sheriff stays on a horse, which is counted down
; every fourth frame by the routine for a sheriff who is riding.
@label=RidingTimer
g$A209 DEFB $02

; Outlaw Shot Flag
;
; Set to one when the outlaw has been hit by a bullet in the town, which
; makes #R$B2E9 end the stage.
@label=OutlawShotFlag
g$A20A DEFB $9B

; Key One Held Flag
;
; One while key 1 is held down on the title screen.
@label=KeyOneHeldFlag
g$A20B DEFB $7F

; Key Two Held Flag
;
; One while key 2 is held down on the title screen.
@label=KeyTwoHeldFlag
g$A20C DEFB $40

; Key Three Held Flag
;
; One while key 3 is held down on the title screen.
@label=KeyThreeHeldFlag
g$A20D DEFB $03

; Menu Entry Number
;
; The number of the entry of the title screen menu which is being looked
; after.
@label=MenuEntryNumber
g$A20E DEFB $44

; Tile Set Address
;
; The address of the set of tiles which is used by the routines which draw
; blocks of tiles.
@label=TileSetAddress
g$A20F DEFW $C0FE

; Draw Message State
;
; Zero until the "DRAW!!" message has been printed in a duel. It is one if
; the player provoked the outlaw and two if the outlaw started to draw. While it
; is not zero the outlaw's gun moves on every frame.
@label=DrawMessageState
g$A211 DEFB $00

; Shots Fired Count
;
; The number of shots which the outlaw has fired in a duel.
@label=ShotsFiredCount
g$A212 DEFB $BF

; Name Offset Flag
;
; Used while the name of the outlaw is printed on the poster. It is one if
; the part of the name has an even number of characters, which means that it is
; printed half a character across.
@label=NameOffsetFlag
g$A213 DEFB $FE

; Horizontal Speed
;
; The signed horizontal speed of the object which is being moved, which is
; set by #R$CCC2 and used by #R$CCE5.
@label=HorizontalSpeed
g$A214 DEFB $00

; Vertical Speed
;
; The signed vertical speed of the object which is being moved, which is
; set by #R$CCC2 and used by #R$CCE5.
@label=VerticalSpeed
g$A215 DEFB $00

; Frame Counter
;
; Counts the frames of the game.
@label=FrameCounter
g$A216 DEFW $0000

; First Random Number
;
; The first of two random numbers, which are stirred by #R$C0D3.
@label=FirstRandomNumber
g$A218 DEFW $0000

; Second Random Number
;
; The second of two random numbers, which are stirred by #R$C0D3.
@label=SecondRandomNumber
g$A21A DEFW $0000

; Options
;
; The choices which are made on the title screen. Bit 0 is set for two
; players and bits 1 and 2 are the type of controls: zero for the keyboard, one
; for a Kempston joystick, two for a cursor joystick and three for an Interface
; 2 joystick. Bit 3 is set when the game starts, and makes a joystick give the
; direction which the sheriff faces instead of turning him.
@label=Options
g$A21C DEFB $00

; Saved Stack Pointer
;
; The stack pointer is kept here by the routines which use it to move
; data.
@label=SavedStackPointer
g$A21D DEFW $001E

; Top Speed
;
; The top speed of the sheriff, which is #N$0A when he walks and #N$12
; when he rides a horse.
@label=TopSpeed
g$A21F DEFB $00

; Sprite Horizontal Position
;
; The horizontal position of the sprite which is being drawn. Some other
; routines use it to keep a value.
@label=SpriteHorizontalPosition
g$A220 DEFB $00

; Sprite Vertical Position
;
; The vertical position of the sprite which is being drawn.
@label=SpriteVerticalPosition
g$A221 DEFB $1F

; Sprite Row Bytes
;
; The number of bytes in each row of the sprite which is being drawn.
@label=SpriteRowBytes
g$A222 DEFB $80

; Sprite Rows Left
;
; The number of rows of the sprite which is being drawn which are left to
; draw.
@label=SpriteRowsLeft
g$A223 DEFB $00

; Sprite Jump Opcode
;
; Used by the routines at #R$BE85 and #R$BFD6.
; .
; The opcode of a #N$C3 ("JP") instruction, which is written when the game
; starts. It is followed by its address, so the routines for drawing sprites
; jump from here to the code for the columns of the sprite.
@label=SpriteJumpOpcode
g$A224 DEFB $00

; Sprite Jump Address
;
; The address which is jumped to from #R$A224.
@label=SpriteJumpAddress
g$A225 DEFW $8007

; Sprite Row Step
;
; The distance in the buffer from the end of one row of the sprite to the
; start of the next.
@label=SpriteRowStep
g$A227 DEFB $38

; Sheriff Sprite List
;
; The sprite list of the sheriff, which has three sprites one above
; another. The sprite number of the second sprite, which is at #N$A22D, is
; changed when the sheriff has just fired.
@label=SheriffSpriteList
g$A228 DEFB $F8,$08,$40
 $A22B DEFB $3F,$78,$0F
 $A22E DEFB $C0,$3F,$90
 $A231 DEFB $0B

; Outlaw Sprite List
;
; The sprite list of the outlaw in the town, which has three sprites one
; above another and is made by #R$B3DA.
@label=OutlawSpriteList
g$A232 DEFB $C0,$1F,$C0
 $A235 DEFB $04,$20,$0E
 $A238 DEFB $00,$07,$80
 $A23B DEFB $01

; Sound Notes Left
;
; The number of notes left to play in the sound effect which is in
; progress. It is zero when there is none.
@label=SoundNotesLeft
g$A23C DEFB $80

; Sound Note Address
;
; The address one byte before the next note of the sound effect which is
; in progress.
@label=SoundNoteAddress
g$A23D DEFW $C007

; Current Player
;
; Zero for the first player and one for the second.
@label=CurrentPlayer
g$A23F DEFB $07

; Stage Running Flag
;
; Set to one when a stage starts. It is cleared when the stage ends well,
; and if it is still set when the objects have gone the player loses a life.
@label=StageRunningFlag
g$A240 DEFB $C0

; Start Game Flag
;
; Set to one on the title screen when the menu has finished and the game
; is to start.
@label=StartGameFlag
g$A241 DEFB $07

; Tune Played Flag
;
; Set to one when the title tune has been played, which stops it from
; being played again.
@label=TunePlayedFlag
g$A242 DEFB $E0

; Objects Drawn Count
;
; The number of objects which have been drawn in this frame. The stage is
; over when there is nothing left to do and this is zero.
@label=ObjectsDrawnCount
g$A243 DEFB $0F

; Fire Held Flag
;
; Set to one when the revolver has been fired and the fire control has not
; been released since.
@label=FireHeldFlag
g$A244 DEFB $40

; Fire Timer
;
; The time since the revolver was fired, which is counted down. The
; sheriff is shown firing while it is not zero, and the revolver is not
; reloaded.
@label=FireTimer
g$A245 DEFB $06

; Reloading Flag
;
; Set to one while the revolver is being loaded with bullets.
@label=ReloadingFlag
g$A246 DEFB $F0

; Last Controls
;
; The controls which were used last time, which are used by #R$D0E3 to
; settle which of two opposite controls is used when they are both pressed.
@label=LastControls
g$A247 DEFB $1F

; Column Flags
;
; The flags, one bit each for sixteen columns of the screen which are each
; sixteen pixels wide, which say that a wall has been drawn in the column.
@label=ColumnFlags
g$A248 DEFB $C0      ; The flags for the first eight columns.
 $A249 DEFB $03      ; The flags for the last eight columns.

; First Object Position
;
; The position in the list of objects of a cell of the town, at #R$C352,
; which is after the first object of those which are being compared.
@label=FirstObjectPosition
g$A24A DEFW $1FF8

; Second Object Position
;
; The position in the list of objects of a cell of the town, at #R$C352,
; which is after the second object of those which are being compared.
@label=SecondObjectPosition
g$A24C DEFW $03C0

; Screen Horizontal Position
;
; The horizontal position on the screen of the object or the part of a
; cell which is being drawn.
@label=ScreenHorizontalPosition
g$A24E DEFW $3FFC

; Screen Vertical Position
;
; The vertical position on the screen of the object or the part of a cell
; which is being drawn.
@label=ScreenVerticalPosition
g$A250 DEFW $01C0

; Flip Flag
;
; Zero if the sprite or tile which is being drawn is drawn as it is, and
; not zero if it is drawn as a reflection.
@label=FlipFlag
g$A252 DEFB $FF

; Cell Code
;
; The code of the cell of the town which is being drawn.
@label=CellCode
g$A253 DEFB $FF

; Cell Column
;
; The column of the cell of the town which was found last.
@label=CellColumn
g$A254 DEFB $40

; Cell Row
;
; The row of the cell of the town which was found last.
@label=CellRow
g$A255 DEFB $01

; Rotate Key Flag
;
; Set to one while the key for rotating the view is held down.
@label=RotateKeyFlag
g$A256 DEFB $BF

; Bounty
;
; The bounty of the current player, as three bytes of packed decimal
; digits with the most significant byte first. This is the start of the nineteen
; bytes of state for the current player.
@label=Bounty
g$A257 DEFB $FF,$C0  ; The two most significant bytes.
@label=Bounty_LastByte
 $A259 DEFB $00      ; The least significant byte.

; Fine
;
; The fine which is taken from the bounty when a bystander is shot, as a
; packed decimal word with the low byte first.
@label=Fine
g$A25A DEFB $FF      ; The low byte.
@label=Fine_HighByte
 $A25B DEFB $FF      ; The high byte.

; Horse Price
;
; The price of a horse, as a packed decimal word with the low byte first.
@label=HorsePrice
g$A25C DEFB $C0      ; The low byte.
@label=HorsePrice_HighByte
 $A25D DEFB $00      ; The high byte.

; Bullet Price
;
; The price of a bullet, as a packed decimal word with the low byte first.
@label=BulletPrice
g$A25E DEFB $FF      ; The low byte.
@label=BulletPrice_HighByte
 $A25F DEFB $FF      ; The high byte.

; Level
;
; The level which the current player has reached. It chooses the outlaw,
; the reward and the prices.
@label=Level
g$A260 DEFB $80

; Skill
;
; How difficult the game is, which goes up by one, to a most of seven,
; when the player completes some of the levels. It affects how fast the outlaws
; draw and how the bags fall.
@label=Skill
g$A261 DEFB $00

; Bullets Loaded
;
; The number of bullets in the revolver, from zero to six.
@label=BulletsLoaded
g$A262 DEFB $FF

; Lives
;
; The number of lives which the current player has left.
@label=Lives
g$A263 DEFB $FE

; Targets Left
;
; The number of money bags which are still to be made in the stage of the
; bags, or one for the stage of the duel. The stage goes on while it is not
; zero.
@label=TargetsLeft
g$A264 DEFB $80

; Stage Kind
;
; The kind of the stage when it is not in the town: zero for none, one for
; the money bags and two for the duel.
@label=StageKind
g$A265 DEFB $00

; Screen Attribute
;
; The attribute with which the screen is filled when the screen is drawn
; for a stage.
@label=ScreenAttribute
g$A266 DEFB $5F

; Town Offset
;
; Four in the town and zero in the other stages. It is the number of
; columns by which the screen is moved in the town, and it is used to tell the
; town from the other stages.
@label=TownOffset
g$A267 DEFB $FF

; View Rotation
;
; Bit 0 is set when the view of the town is rotated by a half turn.
@label=ViewRotation
g$A268 DEFB $80

; Bullet Unpaid Flag
;
; Set to one when the bounty cannot pay for a bullet, which stops the
; revolver from being loaded until the bounty goes up.
@label=BulletUnpaidFlag
g$A269 DEFB $00

; Other Player State
;
; The nineteen bytes of state for the player who is not playing, in the
; same order as the state of the current player which starts at #R$A257. #R$A6EA
; exchanges them.
@label=OtherPlayerState
g$A26A DEFB $7F,$FF,$00,$00,$7F,$FF,$00,$00,$00,$00,$00,$00 ; The bounty, the fine, the prices, the level, the skill, the
                                                            ; bullets loaded.
@label=OtherPlayerLives
 $A276 DEFB $00                                             ; The number of
                                                            ; lives.
 $A277 DEFB $00,$00,$00,$00,$00,$00                         ; The rest of the
                                                            ; state.

; Object Slot 1
;
; The first slot, which holds the sheriff in the town, the outlaw in the
; duel and the first of the money bags in the stage of the bags. There are
; fifteen slots of sixteen bytes. The first byte of a slot is the type of the
; object, which is zero for a slot which is not used. The layout of a slot is:
; byte #N$00 the type; bytes #N$01 and #N$02 the horizontal position; bytes
; #N$03 and #N$04 the vertical position; byte #N$05 the speed; byte #N$06 the
; heading, in bits 6 and 7, with zero for up the screen, one for the right, two
; for down and three for the left, and the time to turn in bits 0 to 2; byte
; #N$07 the flags, in which bit 0 says that the object has bumped into
; something, bit 1 says that it has been drawn and bit 6 says that it is
; flipped; bytes #N$08 and #N$09 the half width and the half height; bytes #N$0A
; and #N$0B counters; byte #N$0C the walking frame, in which bit 2 chooses the
; second set of frames; byte #N$0D the vertical offset; and bytes #N$0E and
; #N$0F the address of the sprite list.
@label=ObjectSlot_01
g$A27D DEFB $03,$C0,$00,$00,$03,$F0,$00,$00
 $A285 DEFB $00,$F0,$E3,$E0,$01,$08,$FD,$E0

; Object Slot 2
;
; The second slot, which holds a bullet of the sheriff in the town, and
; the gun of the outlaw in the duel. It is also the second of the money bags.
@label=ObjectSlot_02
g$A28D DEFB $01,$F8,$FE,$C0,$01,$78,$7F,$00
 $A295 DEFB $00,$84,$B8,$00,$00,$F0,$06,$00

; Object Slot 3
;
; The third slot, which holds a bullet of the sheriff in the town. It is
; also the third of the money bags.
@label=ObjectSlot_03
g$A29D DEFB $01,$F0,$1F,$00,$01,$F8,$3D,$00
 $A2A5 DEFB $01,$B8,$3F,$00,$00,$FC,$7F,$80

; Object Slot 4
;
; The fourth slot, which holds a bullet of the sheriff in the town.
@label=ObjectSlot_04
g$A2AD DEFB $00,$FC,$7F,$80,$00,$FF,$FE,$80
 $A2B5 DEFB $00,$BF,$FF,$80,$00,$FF,$FF,$80

; Object Slot 5
;
; The fifth slot, which holds the outlaw in the town.
@label=ObjectSlot_05
g$A2BD DEFB $00,$FF,$FF,$80,$00,$FF,$FE,$80
 $A2C5 DEFB $00,$5F,$FF,$80,$00,$7F,$FF,$00

; Object Slot 6
;
; The sixth slot, which holds the pointing hand next to the sheriff in the
; town.
@label=ObjectSlot_06
g$A2CD DEFB $00,$7F,$FF,$00,$00,$00,$00,$00
 $A2D5 DEFB $00,$7E,$7E,$00,$01,$FF,$FF,$80

; Object Slot 7
;
; The seventh slot, which holds the cactus.
@label=ObjectSlot_07
g$A2DD DEFB $03,$FF,$FF,$C0,$03,$FF,$FF,$C0
 $A2E5 DEFB $03,$FF,$FF,$C0,$03,$FF,$FF,$C0

; Object Slot 8
;
; The eighth slot, which holds the horse.
@label=ObjectSlot_08
g$A2ED DEFB $03,$FF,$FF,$C0,$03,$FF,$FF,$C0
 $A2F5 DEFB $03,$FF,$FF,$C0,$01,$3F,$FC,$80

; Object Slot 9
;
; The ninth slot, which holds the tumbleweed.
@label=ObjectSlot_09
g$A2FD DEFB $01,$3E,$7C,$80,$01,$FE,$7F,$80
 $A305 DEFB $01,$FE,$7F,$00,$00,$FE,$7F,$00

; Object Slot 10
;
; The tenth slot, which holds a bystander.
@label=ObjectSlot_10
g$A30D DEFB $00,$FE,$7F,$00,$00,$9E,$79,$00
 $A315 DEFB $00,$9E,$79,$00,$00,$7E,$7E,$00

; Object Slot 11
;
; The eleventh slot, which holds a bystander.
@label=ObjectSlot_11
g$A31D DEFB $00,$7E,$7E,$00,$00,$3E,$7C,$00
 $A325 DEFB $00,$3E,$7C,$00,$00,$2E,$74,$00

; Object Slot 12
;
; The twelfth slot, which holds a bystander.
@label=ObjectSlot_12
g$A32D DEFB $00,$3E,$7C,$00,$00,$00,$00,$00
 $A335 DEFB $00,$7E,$5C,$00,$00,$BE,$5D,$00

; Object Slot 13
;
; The thirteenth slot, which holds a bystander.
@label=ObjectSlot_13
g$A33D DEFB $17,$BE,$5D,$F8,$2F,$BE,$5D,$FC
 $A345 DEFB $2F,$80,$01,$FC,$00,$3E,$5C,$00

; Object Slot 14
;
; The fourteenth slot, which holds the shot which the sheriff fires in the
; stages outside the town.
@label=ObjectSlot_14
g$A34D DEFB $3F,$9E,$59,$FC,$00,$00,$00,$00
 $A355 DEFB $00,$7E,$7E,$00,$01,$FF,$FF,$80

; Object Slot 15
;
; The fifteenth slot, which holds the crosshair in the stages outside the
; town.
@label=ObjectSlot_15
g$A35D DEFB $03,$FF,$FF,$C0,$03,$FF,$FF,$C0
 $A365 DEFB $03,$FF,$FF,$C0,$03,$FF,$FF,$C0

; Initialise Game
;
; Used by the routine at #R$5E00.
; .
; The real start of the game. It checks the loader's signature, clears the
; game variables, builds the lookup tables, shows the title screen and menu,
; sets up the first player and then falls into the main loop at #R$A3BA.
; .
; When a game has ended and the high score has been shown, control comes back to
; #R$A37E so that the title screen is shown again.
@label=InitialiseGame
c$A36D LD SP,$5E00   ; Reset the stack pointer to just below the start of the
                     ; game.
 $A370 LD A,($5C79)  ; Fetch the high byte of the system frame counter.
 $A373 CP $56        ; {Return unless it holds #N$56, which is the value the tape loader
 $A375 RET NZ        ; leaves there.}
; Clear the game variables.
 $A376 LD HL,$A207   ; {Clear everything from #R$A207 onwards, #N$0166 bytes in all, which
 $A379 LD BC,$0166   ; covers every game variable.}
 $A37C JR $A384      ; Skip over the shorter clear below.
; This entry point is used by the routine at #R$A50A.
; .
; This entry point is used when the game has ended. It keeps the frame
; counter, the random seeds and the control method chosen on the menu.
@label=RestartGame
*$A37E LD HL,$A23C   ; {Clear everything from #R$A23C onwards, #N$0131 bytes in
 $A381 LD BC,$0131   ; all.}
@label=InitialiseGame_Clear
*$A384 CALL $D6E1    ; Fill the memory with zero.
; Set up the machine and show the title screen.
 $A387 CALL $D4FD    ; Build the pixel shifting lookup tables.
 $A38A LD A,$C3      ; {Write the opcode for a #N$C3 (JP) instruction to #R$A224, ready for
 $A38C LD ($A224),A  ; the sprite drawing routines to use.}
 $A38F XOR A         ; {Set the border to black.
 $A390 OUT ($FE),A   ; }
 $A392 CALL $AB77    ; Show the title screen and wait for the player to start
                     ; the game.
 $A395 LD A,($A21C)  ; Fetch the option flags.
 $A398 OR %00001000  ; Set bit 3, which records that a game is under way.
 $A39A LD ($A21C),A  ; Store the option flags again.
 $A39D CALL $A4EC    ; Convert the top score into text for the telegram panel.
 $A3A0 CALL $A6B5    ; Give both players their starting values.
 $A3A3 CALL $D0B7    ; Clear the off-screen playfield buffer.
 $A3A6 LD A,$01      ; {Write #N$01 to #R$A240 to show that a new stage is
 $A3A8 LD ($A240),A  ; starting.}
 $A3AB LD A,($A21C)  ; Fetch the option flags again.
 $A3AE BIT 0,A       ; Test bit 0, which is set for a two player game.
 $A3B0 CALL NZ,$A6C9 ; Print the current player number if there are two
                     ; players.
; This entry point is used by the routines at #R$B2E9, #R$BB3A and #R$C7D1.
; .
; Draw the screen for the next stage of the game and run it.
@label=StartStage
*$A3B3 LD A,($A266)  ; {Fetch the border and paper colour for the stage and keep the stage
 $A3B6 LD E,A        ; colour in #REGe.}
 $A3B7 CALL $D2FB    ; Draw the screen furniture.
; The main loop. It runs once for every frame of the game.
@label=MainLoop
*$A3BA XOR A         ; {Write #N$00 to #R$A243 to clear the count of objects drawn this
 $A3BB LD ($A243),A  ; frame.}
 $A3BE LD SP,$5E00   ; Reset the stack pointer, so that nothing can build up on
                     ; the stack.
 $A3C1 CALL $C049    ; Check whether the player has been lost and deal with it
                     ; if so.
; Run the handler for each of the fifteen object slots in turn.
 $A3C4 LD IX,$A27D   ; Point #REGix at #R$A27D.
@label=MainLoopNextObject
*$A3C8 LD A,(IX+$00) ; Fetch the type of the object in this slot.
 $A3CB LD BC,$A412   ; Point #REGbc at #R$A412.
 $A3CE CALL $C766    ; Call the handler for the type of object.
 $A3D1 CALL $C0D3    ; Update the random number seeds.
 $A3D4 LD BC,$0010   ; Set the size of an object slot in #REGbc.
 $A3D7 ADD IX,BC     ; Move #REGix on to the next slot.
 $A3D9 PUSH IX       ; {Copy the slot address into #REGhl (using the stack).
 $A3DB POP HL        ; }
 $A3DC LD BC,$A36D   ; The address past the last object slot goes into #REGbc.
 $A3DF AND A         ; {Loop back to #R$A3C8 until #REGix has moved past the
 $A3E0 SBC HL,BC     ; last slot.
 $A3E2 JR C,$A3C8    ; }
; Now do everything which does not belong to a single object.
 $A3E4 CALL $C0CC    ; Advance the frame counter.
 $A3E7 CALL $B85B    ; Create any objects which the current stage needs.
 $A3EA CALL $AB18    ; Draw the scenery sprites.
 $A3ED CALL $C0F8    ; Draw the town.
 $A3F0 CALL $CB03    ; Flash the chamber of the revolver which has just fired.
 $A3F3 CALL $D0B4    ; Copy the playfield buffer to the screen.
 $A3F6 CALL $AEA9    ; Play the next note of any sound effect.
 $A3F9 CALL $A7DA    ; Print the next letter of the telegram.
 $A3FC CALL $B2E9    ; Check whether the outlaw has been caught.
 $A3FF CALL $B3BD    ; Create new townspeople, the outlaw and the other town
                     ; objects.
 $A402 CALL $D206    ; Pause the game if the pause key is being pressed.
 $A405 LD A,($A264)  ; {Fetch the number of targets remaining in the stage and keep the
 $A408 LD C,A        ; number of targets left in #REGc.}
 $A409 LD A,($A243)  ; Fetch the count of objects drawn this frame.
 $A40C OR C          ; Combine the two counts.
 $A40D JP Z,$C7D1    ; Jump to #R$C7D1 if the stage has nothing left to do.
 $A410 JR $A3BA      ; Otherwise loop back to #R$A3BA for the next frame.

; Object Handler Table
;
; One address for each of the twenty-seven object types. The main loop at
; #R$A3BA uses the type held in the first byte of an object slot to pick the
; routine which looks after that object.
@label=ObjectHandlerTable
g$A412 DEFW $A448    ; {The routines for types #N$00 to #N$1A.
 $A414 DEFW $C930    ;
 $A416 DEFW $CAC6    ;
 $A418 DEFW $BCCA    ;
 $A41A DEFW $C869    ;
 $A41C DEFW $C7C0    ;
 $A41E DEFW $B719    ;
 $A420 DEFW $C795    ;
 $A422 DEFW $C7B7    ;
 $A424 DEFW $C76C    ;
 $A426 DEFW $B3DA    ;
 $A428 DEFW $B347    ;
 $A42A DEFW $B9FB    ;
 $A42C DEFW $BADA    ;
 $A42E DEFW $B8E7    ;
 $A430 DEFW $B972    ;
 $A432 DEFW $B9DA    ;
 $A434 DEFW $BADD    ;
 $A436 DEFW $BB0B    ;
 $A438 DEFW $AA7F    ;
 $A43A DEFW $A9BF    ;
 $A43C DEFW $C910    ;
 $A43E DEFW $B3DA    ;
 $A440 DEFW $A8D5    ;
 $A442 DEFW $A4C9    ;
 $A444 DEFW $A449    ;
 $A446 DEFW $A452    ; }

; Handle Empty Slot
;
; Type #N$00: an empty slot has nothing to do.
@label=HandleEmptySlot
c$A448 RET           ; Return.

; Handle Respawn Delay
;
; Type #N$19: the pause before the sheriff comes back after losing a life.
; The delay counter in byte #N$0C of the slot counts down, and then the object
; turns into type #N$1A.
@label=HandleRespawnDelay
c$A449 DEC (IX+$0C)    ; {Decrease the delay counter and return if it has not
 $A44C RET NZ          ; reached zero.}
 $A44D LD (IX+$00),$1A ; Turn the object into type #N$1A.
 $A451 RET             ; Return.

; Handle Sheriff Entrance
;
; Type #N$1A: the sheriff arriving back in the street. The vertical offset
; of the sprite in byte #N$0D grows by four every frame, with a rising sound,
; until it reaches #N$1C. The object then becomes a sheriff (type #N$01) and is
; protected from harm for a short time.
;
; .
;
; Raise the sprite and play a rising tone.
@label=HandleSheriffEntrance
c$A452 LD A,(IX+$0D)   ; Fetch the vertical offset of the sprite.
 $A455 ADD A,$04       ; Add #N$04 to the offset.
 $A457 LD (IX+$0D),A   ; Store the new offset.
 $A45A CALL $AF4F      ; Play a sound effect whose pitch depends on the offset.
 $A45D LD A,(IX+$0D)   ; Fetch the offset again.
 $A460 CP $1C          ; {Return if the offset is still below #N$1C.
 $A462 RET C           ; }
; The sheriff has arrived, so turn the object into a sheriff.
 $A463 LD (IX+$00),$01 ; Turn the object into a sheriff.
 $A467 LD (IX+$0D),$00 ; Reset the vertical offset of the sprite to zero.
 $A46B LD A,$10        ; {Write #N$10 to #R$A208 to make the sheriff invulnerable for a short
 $A46D LD ($A208),A    ; time.}
 $A470 LD HL,$A228     ; {Point the sprite list of the object at #R$A228.
 $A473 LD (IX+$0E),L   ;
 $A476 LD (IX+$0F),H   ; }
 $A479 LD C,$00        ; Clear #REGc, so that no controls are being pressed.
 $A47B JP $C94C        ; Carry on in the sheriff handler.

; Create Money Bag
;
; Used by the routine at #R$B3BD.
; .
; Creates a money bag (an object of type #N$18) in the seventh object slot
; when the player's bounty has dropped below $100. The bag appears close to the
; sheriff, in a free cell.
;
; .
;
; Return unless the bounty is below $100 and the slot is free.
@label=CreateMoneyBag
c$A47E LD HL,$A257     ; {Return unless the first two bytes of the bounty are both zero, which
 $A481 LD A,(HL)       ; means it is less than $100.
 $A482 INC HL          ;
 $A483 OR (HL)         ;
 $A484 RET NZ          ; }
 $A485 LD DE,$A2DD     ; Point #REGde at #R$A2DD.
 $A488 LD A,(DE)       ; Fetch the type of the object in the slot.
 $A489 AND A           ; {Return if the slot is already in use.
 $A48A RET NZ          ; }
; Copy the template and place the bag near the sheriff.
 $A48B PUSH DE         ; {Copy #REGde to #REGiy (using the stack).
 $A48C POP IY          ; }
 $A48E LD HL,$A4B5     ; Point #REGhl at #R$A4B5.
 $A491 LD BC,$0010     ; Set the size of an object slot in #REGbc.
 $A494 LDIR            ; Copy the template into the slot.
 $A496 LD B,$01        ; Set the distance from the sheriff to one cell.
 $A498 CALL $B6CD      ; Place the bag one cell away from the sheriff.
 $A49B RET NZ          ; Return if that cell is blocked.
; Choose a position inside the cell.
 $A49C LD A,($A218)    ; Fetch a random number.
 $A49F AND %00110000   ; Keep bits 4 and 5.
 $A4A1 ADD A,$80       ; Add #N$80 to give a position inside the cell.
 $A4A3 LD (IY+$01),A   ; Set the horizontal position of the bag within the
                       ; cell.
 $A4A6 LD A,($A219)    ; Fetch another random number.
 $A4A9 AND %00110000   ; Keep bits 4 and 5.
 $A4AB ADD A,$80       ; Add #N$80 to give a position inside the cell.
 $A4AD LD (IY+$03),A   ; Set the vertical position of the bag within the cell.
 $A4B0 LD (IY+$00),$18 ; Turn the slot into a money bag.
 $A4B4 RET             ; Return.

; Money Bag Template
;
; The initial contents of a slot for a money bag. The final two bytes
; point to the sprite list.
@label=MoneyBagTemplate
b$A4B5 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; {Type, position, speed, size and counters, which #R$A47E fills
 $A4BD DEFB $10,$10,$00,$00,$00,$00         ; in.}
 $A4C3 DEFW $A4C5                           ; The sprite list of a money bag.
 $A4C5 DEFB $F8,$04,$29,$80                 ; The sprite list: sprite #N$29 at offset
                                            ; (#N($F8), #N$04), then the terminator.
                                            ; #SPRITE$29(money-bag*).

; Handle Money Bag
;
; Type #N$18: a money bag put in the street by #R$A47E to help a player
; who has run out of money. It disappears if the sheriff moves away from it.
; When the sheriff touches it, it adds $100 to the bounty.
;
; .
;
; Remove the bag if the sheriff has moved away.
@label=HandleMoneyBag
c$A4C9 LD C,$02      ; Set the distance at which the bag stays alive to two
                     ; cells.
 $A4CB CALL $B810    ; Check how close the sheriff is.
 $A4CE JP NC,$C7BB   ; Remove the bag if the sheriff has moved away.
; Add $100 when the sheriff touches the bag.
 $A4D1 CALL $B631    ; Check whether the sheriff is touching the bag.
 $A4D4 RET NC        ; Return if not.
 $A4D5 LD BC,$0100   ; Set the $100 added to the bounty in #REGbc.
 $A4D8 CALL $D354    ; Add it to the bounty.
 $A4DB CALL $D390    ; Print the new bounty.
 $A4DE LD A,$08      ; {Write #N$08 to #R$A23C so that the pick-up sound lasts
 $A4E0 LD ($A23C),A  ; eight notes.}
 $A4E3 LD HL,$AEC7   ; {Point #R$A23D at the notes of the pick-up sound.
 $A4E6 LD ($A23D),HL ; }
 $A4E9 JP $C7BB      ; Remove the bag.

; Prepare Top Score Text
;
; Used by the routine at #R$A36D.
; .
; Converts the top score into the digits shown on the telegram panel.
@label=PrepareTopScoreText
c$A4EC LD DE,$A5D2   ; Point #REGde at the top score.
 $A4EF LD HL,$A872   ; Point #REGhl at #R$A872.
; This entry point is used by the routines at #R$A50A and #R$A6FC.
; .
; This entry point converts #REGb bytes of packed decimal digits at #REGde
; into characters at #REGhl.
@label=ConvertDigits
*$A4F2 LD B,$03      ; Set the number of bytes to convert to three.
@label=PrepareTopScoreText_ConvertDigitsLoop
*$A4F4 LD A,(DE)     ; Fetch a pair of digits.
 $A4F5 RRCA          ; {Shift the first digit into the bottom half of the byte.
 $A4F6 RRCA          ;
 $A4F7 RRCA          ;
 $A4F8 RRCA          ; }
 $A4F9 AND %00001111 ; Keep just the digit.
 $A4FB ADD A,$30     ; Convert the digit to a character.
 $A4FD LD (HL),A     ; Write it to the text.
 $A4FE INC HL        ; Move on to the next character.
 $A4FF LD A,(DE)     ; Fetch the pair of digits again.
 $A500 AND %00001111 ; Keep just the second digit.
 $A502 ADD A,$30     ; Convert it to a character.
 $A504 LD (HL),A     ; Write it to the text.
 $A505 INC DE        ; {Move on to the next pair of digits and the next
 $A506 INC HL        ; character.}
 $A507 DJNZ $A4F4    ; Loop back until every pair has been converted.
 $A509 RET           ; Return.

; Check Top Score
;
; Used by the routine at #R$C049.
; .
; Called when the last life of the last player has been lost. It works out
; which player scored most, and if that score beats the top score of the day it
; shows the "WELL DONE" screen and stores the new top score. Either way the game
; then goes back to the title screen.
;
; .
;
; The player states are swapped first so that the first player's score is
; in the current position.
@label=CheckTopScore
c$A50A CALL $A6EA    ; Swap the states of the two players.
; This entry point is used by the routine at #R$C049.
; .
; Compare the two scores, most significant byte first.
@label=CheckTopScore_SkipSwap
*$A50D LD B,$03      ; Set the number of bytes in a score to three.
 $A50F LD DE,$A257   ; Point #REGde at #R$A257.
 $A512 LD HL,$A26A   ; Point #REGhl at #R$A26A.
@label=CheckTopScore_CompareScoresLoop
*$A515 LD A,(DE)     ; Fetch a byte of the current score.
 $A516 CP (HL)       ; Compare it with the same byte of the other score.
 $A517 INC DE        ; {Move on to the next byte of each score.
 $A518 INC HL        ; }
 $A519 JR C,$A51F    ; Jump to #R$A51F if the other score is higher.
 $A51B JR NZ,$A538   ; Jump to #R$A538 if the current score is higher.
 $A51D DJNZ $A515    ; Loop back until all three bytes have been compared.
; The other player has the higher score (or the two are equal).
@label=CheckTopScore_SecondPlayer
*$A51F LD C,$01      ; Set the winner to be player two.
 $A521 LD DE,$A26A   ; Point #REGde at #R$A26A.
; Compare the winning score with the top score of the day.
@label=CheckTopScore_CompareWithTopScore
*$A524 PUSH DE       ; Stash the address of the winning score on the stack.
 $A525 LD HL,$A5D2   ; Point #REGhl at #R$A5D2.
 $A528 LD B,$03      ; Set the number of bytes in a score to three.
@label=CheckTopScore_CompareWithTopScoreLoop
*$A52A LD A,(DE)     ; Fetch a byte of the winning score.
 $A52B CP (HL)       ; Compare it with the same byte of the top score.
 $A52C INC DE        ; {Move on to the next byte of each score.
 $A52D INC HL        ; }
 $A52E JR C,$A534    ; Jump to #R$A534 if the winning score is lower.
 $A530 JR NZ,$A53F   ; Jump to #R$A53F if the winning score is higher.
 $A532 DJNZ $A52A    ; Loop back until all three bytes have been compared.
@label=CheckTopScore_NotBeaten
*$A534 POP DE        ; The top score has not been beaten, so discard the address of the
                     ; winning score.
 $A535 JP $A37E      ; Restart the game from the title screen.
; The current player has the higher score.
@label=CheckTopScore_FirstPlayer
*$A538 LD C,$00      ; Set the winner to be player one.
 $A53A LD DE,$A257   ; Point #REGde at #R$A257.
 $A53D JR $A524      ; Join in with the comparison with the top score.
; The top score has been beaten.
@label=CheckTopScore_Winner
*$A53F LD A,C        ; Fetch the winning player.
 $A540 ADD A,$31     ; Convert it to the character for the player number.
 $A542 LD ($A5B0),A  ; Write it into the "PLAYER" text.
 $A545 LD E,$00      ; Set the attribute to #COLOUR$00.
 $A547 CALL $D6D3    ; Clear the attributes.
 $A54A CALL $D6DB    ; Clear the pixels of the screen.
 $A54D POP DE        ; Retrieve the address of the winning score.
 $A54E LD HL,$A5D2   ; Point #REGhl at #R$A5D2.
 $A551 LD B,$03      ; Set the number of bytes in a score to three.
 $A553 CALL $A6F2    ; Swap the two scores, which stores the new top score.
 $A556 LD DE,$A5D2   ; Point #REGde at #R$A5D2.
 $A559 LD HL,$A5CB   ; Point #REGhl at #R$A5CB.
 $A55C CALL $A4F2    ; Convert the score to digits.
; Print the first line.
 $A55F LD HL,$4087   ; Point #REGhl at #N$4087 (in the screen buffer).
 $A562 LD DE,$A59D   ; Point #REGde at #R$A59D.
 $A565 CALL $AA9A    ; Print it in large letters.
; Print the second line.
 $A568 LD HL,$40E8   ; Point #REGhl at #N$40E8 (in the screen buffer).
 $A56B LD DE,$A5A8   ; Point #REGde at #R$A5A8.
 $A56E CALL $AA9A    ; Print it in large letters.
; Print the third line.
 $A571 LD HL,$4846   ; Point #REGhl at #N$4846 (in the screen buffer).
 $A574 LD DE,$A5B2   ; Point #REGde at #R$A5B2.
 $A577 CALL $AA9A    ; Print it in large letters.
; Print the fourth line.
 $A57A LD HL,$48A8   ; Point #REGhl at #N$48A8 (in the screen buffer).
 $A57D LD DE,$A5BE   ; Point #REGde at #R$A5BE.
 $A580 CALL $AA9A    ; Print it in large letters.
; Print the fifth line.
 $A583 LD HL,$5048   ; Point #REGhl at #N$5048 (in the screen buffer).
 $A586 LD DE,$A5C8   ; Point #REGde at #R$A5C8.
 $A589 CALL $AA9A    ; Print it in large letters.
 $A58C LD DE,$B1E0   ; Point #REGde at #R$B1E0.
 $A58F CALL $AF8F    ; Play the tune.
 $A592 LD B,$04      ; Set the number of delay loops to four.
 $A594 LD HL,$0000   ; Set the length of each delay loop.
 $A597 CALL $AE82    ; Wait for a while.
 $A59A JP $A37E      ; Restart the game from the title screen.

; Messaging: Score Text
;
; The messages shown when the top score has been beaten. Each is an
; attribute byte, the characters and a zero terminator. The #N$5E in the last
; message is the dollar sign of the font, and the score digits are written over
; the spaces after it.
@label=ScoreMessages
t$A59D DEFB $43          ; Attribute: #COLOUR(#PEEK(#PC)).
 $A59E DEFM "WELL DONE"  ; "WELL DONE".
 $A5A7 DEFB $00          ; Terminator.
@label=ScoreMessages_Player
 $A5A8 DEFB $44          ; Attribute: #COLOUR(#PEEK(#PC)).
 $A5A9 DEFM "PLAYER "    ; "PLAYER ".
 $A5B0 DEFB $20          ; The number of the winning player, written by #R$A53F. It is a
                         ; space until then.
 $A5B1 DEFB $00          ; Terminator.
@label=ScoreMessages_TodaysTop
 $A5B2 DEFB $46          ; Attribute: #COLOUR(#PEEK(#PC)).
 $A5B3 DEFM "TODAYS TOP" ; "TODAYS TOP".
 $A5BD DEFB $00          ; Terminator.
@label=ScoreMessages_ScoreIs
 $A5BE DEFB $45          ; Attribute: #COLOUR(#PEEK(#PC)).
 $A5BF DEFM "SCORE IS"   ; "SCORE IS".
 $A5C7 DEFB $00          ; Terminator.
@label=ScoreMessages_Score
 $A5C8 DEFB $47          ; Attribute: #COLOUR(#PEEK(#PC)).
 $A5C9 DEFB $5E          ; The dollar sign.
 $A5CA DEFM " "          ; A space.
@label=ScoreMessages_ScoreDigits
 $A5CB DEFM "      "     ; Room for the six digits of the score.
 $A5D1 DEFB $00          ; Terminator.

; Top Score
;
; The top score of the day as three packed decimal bytes, most significant
; first. It starts at $10000 and is replaced by #R$A50A when a player beats it.
@label=TopScore
g$A5D2 DEFB $01,$00,$00

; Update Prices
;
; Used by the routine at #R$B3BD.
; .
; Called every frame, but only does anything when the low byte of the
; frame counter is #N$BD, so once every 256 frames. It picks one of the three
; amounts on the telegram at random: the fine, the price of a horse or the price
; of a bullet. If the telegram has finished typing it chooses a new price from a
; table and retypes that line. The higher the level, the more prices the table
; offers, so prices tend to rise as the game goes on.
@label=UpdatePrices
c$A5D5 LD HL,($A216) ; Fetch the frame counter.
 $A5D8 LD A,L        ; Copy its low byte into #REGa.
 $A5D9 ADD A,$43     ; Add #N$43, which gives zero only when the low byte is
                     ; #N$BD.
 $A5DB RET NZ        ; Return unless it is.
 $A5DC LD A,($A218)  ; Fetch a random number.
 $A5DF AND %00000011 ; Keep bits 0 and 1.
 $A5E1 JR Z,$A627    ; Jump to #R$A627 to change the fine if the number is
                     ; zero.
 $A5E3 DEC A         ; {Jump to #R$A63B to change the price of a horse if the
 $A5E4 JR Z,$A63B    ; number is one.}
; Change the price of a bullet.
 $A5E6 CALL $A64F    ; Check whether the telegram has finished typing.
 $A5E9 RET NZ        ; Return if it has not.
 $A5EA XOR A         ; {Write #N$00 to #R$A830 to start typing the bullet line
 $A5EB LD ($A830),A  ; again.}
 $A5EE LD HL,$A25F   ; Point #REGhl at #R$A25F.
 $A5F1 LD DE,$A83D   ; Point #REGde at #R$A83D.
 $A5F4 EXX           ; Keep both in the alternate registers.
 $A5F5 LD HL,$A65F   ; Point #REGhl at #R$A65F.
; Choose a new price from the table at #REGhl, using more of the table as
; the level goes up.
@label=UpdatePrices_ChooseNewPrice
*$A5F8 LD A,($A260)  ; Fetch the level.
 $A5FB CP $06        ; {Jump to #R$A603 if the level is six or more.
 $A5FD JR NC,$A603   ; }
 $A5FF LD A,$02      ; Allow the first two prices.
 $A601 JR $A60D      ; Jump to #R$A60D.
@label=UpdatePrices_TestLevelThirteen
*$A603 CP $0D        ; {Jump to #R$A60B if the level is thirteen or more.
 $A605 JR NC,$A60B   ; }
 $A607 LD A,$04      ; Allow the first four prices.
 $A609 JR $A60D      ; Jump to #R$A60D.
@label=UpdatePrices_AllowEight
*$A60B LD A,$08      ; Allow all eight prices.
@label=UpdatePrices_StoreAllowed
*$A60D LD C,A        ; Copy the number of prices that are allowed into #REGc.
 $A60E LD A,($A219)  ; Fetch a random number.
 $A611 AND %00001111 ; Keep a number between #N$00 and #N$0F.
@label=UpdatePrices_ChooseNewPriceLoop
*$A613 CP C          ; {Jump to #R$A619 once the number is less than the number of prices
 $A614 JR C,$A619    ; allowed.}
 $A616 SUB C         ; Otherwise subtract the number of prices allowed.
 $A617 JR $A613      ; Loop back to #R$A613.
@label=UpdatePrices_ReadPrice
*$A619 ADD A,A       ; Double the number to get an offset into the table of
                     ; words.
 $A61A LD E,A        ; Copy the offset into #REGe.
 $A61B LD D,$00      ; Clear #REGd.
 $A61D ADD HL,DE     ; Point #REGhl at the chosen price.
 $A61E LD C,(HL)     ; Fetch the low byte of the price.
 $A61F INC HL        ; Move on to the high byte.
 $A620 LD B,(HL)     ; Fetch the high byte of the price.
 $A621 PUSH BC       ; Stash the price on the stack.
 $A622 EXX           ; Bring back the address of the price and the digits.
 $A623 POP BC        ; Fetch the new price into #REGbc.
 $A624 JP $A77D      ; Store the new price, convert it to text and start typing the line
                     ; again.
; Change the fine.
@label=UpdatePrices_Fine
*$A627 CALL $A64F    ; Check whether the telegram has finished typing.
 $A62A RET NZ        ; Return if it has not.
 $A62B XOR A         ; {Write #N$00 to #R$A854 to start typing the fine line
 $A62C LD ($A854),A  ; again.}
 $A62F LD HL,$A25B   ; Point #REGhl at #R$A25B.
 $A632 LD DE,$A861   ; Point #REGde at #R$A861.
 $A635 EXX           ; Keep both in the alternate registers.
 $A636 LD HL,$A67F   ; Point #REGhl at #R$A67F.
 $A639 JR $A5F8      ; Jump to #R$A5F8.
; Change the price of a horse.
@label=UpdatePrices_HorsePrice
*$A63B CALL $A64F    ; Check whether the telegram has finished typing.
 $A63E RET NZ        ; Return if it has not.
 $A63F XOR A         ; {Write #N$00 to #R$A842 to start typing the horse line
 $A640 LD ($A842),A  ; again.}
 $A643 LD HL,$A25D   ; Point #REGhl at #R$A25D.
 $A646 LD DE,$A84F   ; Point #REGde at #R$A84F.
 $A649 EXX           ; Keep both in the alternate registers.
 $A64A LD HL,$A66F   ; Point #REGhl at #R$A66F.
 $A64D JR $A5F8      ; Jump to #R$A5F8.

; Check Telegram Complete
;
; Used by the routine at #R$A5D5.
; .
; Checks whether every line of the telegram has been typed in full. A line
; is complete when its counter has reached #N$0E.
;
; O:F The zero flag is set if every line is complete
;
; Check each of the six telegram lines.
@label=CheckTelegramComplete
c$A64F LD HL,$A830   ; Point #REGhl at the first telegram line.
 $A652 LD DE,$0012   ; Set the size of a telegram line in #REGde.
 $A655 LD B,$06      ; Set the number of lines to six.
; Return unless this line is complete.
@label=CheckTelegramComplete_Loop
*$A657 LD A,(HL)     ; Fetch the counter of the line.
 $A658 CP $0E        ; Compare it with the number of characters in a line.
 $A65A RET NZ        ; Return if the line is not complete.
 $A65B ADD HL,DE     ; Move on to the next line.
 $A65C DJNZ $A657    ; Loop back until all six lines have been checked.
 $A65E RET           ; Return.

; Bullet Prices
;
; Eight prices for a bullet, as packed decimal words with the low byte
; first.
@label=BulletPrices
g$A65F DEFW $0005    ; {$5, $10, $15, $20, $25, $50, $75 and $100.
 $A661 DEFW $0010    ;
 $A663 DEFW $0015    ;
 $A665 DEFW $0020    ;
 $A667 DEFW $0025    ;
 $A669 DEFW $0050    ;
 $A66B DEFW $0075    ;
 $A66D DEFW $0100    ; }

; Horse Prices
;
; Eight prices for a horse, as packed decimal words with the low byte
; first.
@label=HorsePrices
g$A66F DEFW $0050    ; {$50, $75, $100, $150, $250, $350, $500 and $1000.
 $A671 DEFW $0075    ;
 $A673 DEFW $0100    ;
 $A675 DEFW $0150    ;
 $A677 DEFW $0250    ;
 $A679 DEFW $0350    ;
 $A67B DEFW $0500    ;
 $A67D DEFW $1000    ; }

; Fine Amounts
;
; Eight amounts for the fine, as packed decimal words with the low byte
; first.
@label=FineAmounts
g$A67F DEFW $0100    ; {$100, $150, $250, $400, $1000, $1500, $3000 and $5000.
 $A681 DEFW $0150    ;
 $A683 DEFW $0250    ;
 $A685 DEFW $0400    ;
 $A687 DEFW $1000    ;
 $A689 DEFW $1500    ;
 $A68B DEFW $3000    ;
 $A68D DEFW $5000    ; }

; Set Up Player
;
; Used by the routine at #R$A6B5.
; .
; Gives the current player the starting values for a new game: four lives,
; level zero, a bounty of $280, and the first stage, in which the player shoots
; twenty money bags.
;
; .
;
; Give the player four lives and start at level zero.
@label=SetUpPlayer
c$A68F LD A,$04      ; {Write #N$04 to #R$A263 to give the player four lives.
 $A691 LD ($A263),A  ; }
 $A694 XOR A         ; {Write #N$00 to #R$A260 to start on level zero.
 $A695 LD ($A260),A  ; }
 $A698 LD ($A261),A  ; Write #N$00 to #R$A261 to start at the easiest
                     ; difficulty.
; Set the starting bounty and the first stage.
 $A69B LD BC,$0280   ; Set the starting bounty of $280 in #REGbc.
 $A69E CALL $D354    ; Add it to the bounty.
 $A6A1 LD HL,$0114   ; Set the number of targets to twenty and the stage type to the money
                     ; bag shoot.
 $A6A4 LD ($A264),HL ; Store them.
 $A6A7 LD A,$46      ; {Write #N$46 to #R$A266 to colour the border and screen
 $A6A9 LD ($A266),A  ; yellow.}
; Make sure the prices are set.
 $A6AC CALL $A770    ; Make sure the price of a bullet is set.
 $A6AF CALL $A7B8    ; Make sure the price of a horse is set.
 $A6B2 JP $A7CB      ; Jump to #R$A7CB.

; Set Up Players
;
; Used by the routine at #R$A36D.
; .
; Gives both players the starting values. In a game for one player the
; second player is left with no lives.
;
; .
;
; Set up both players.
@label=SetUpPlayers
c$A6B5 CALL $A68F    ; Set up the first player.
 $A6B8 CALL $A6EA    ; Swap to the state of the second player.
 $A6BB CALL $A68F    ; Set up the second player.
; In a one player game, leave the second player with no lives.
 $A6BE LD A,($A21C)  ; Fetch the option flags.
 $A6C1 BIT 0,A       ; Test bit 0, which is set for a two player game.
 $A6C3 RET NZ        ; Return if there are two players.
 $A6C4 XOR A         ; {Write #N$00 to #R$A276 to leave the second player with
 $A6C5 LD ($A276),A  ; no lives.}
 $A6C8 RET           ; Return.

; Show Player Number
;
; Used by the routines at #R$A36D and #R$C049.
; .
; Clears the screen and prints the number of the player who is about to
; play in large letters, and then waits a moment.
@label=ShowPlayerNumber
c$A6C9 LD E,$00      ; Set the attribute to #COLOUR$00.
 $A6CB CALL $D6D3    ; Clear the attributes.
 $A6CE CALL $D6DB    ; Clear the pixels of the screen.
 $A6D1 LD A,($A23F)  ; Fetch the number of the current player, zero or one.
 $A6D4 ADD A,$31     ; Convert it to a character.
 $A6D6 LD ($B7EE),A  ; Write it into the "PLAYER" text.
 $A6D9 LD DE,$B7E6   ; Point #REGde at #R$B7E6.
; Print the "PLAYER" text.
 $A6DC LD HL,$4868   ; Point #REGhl at #N$4868 (in the screen buffer).
 $A6DF CALL $AA9A    ; Print it in large letters.
 $A6E2 LD B,$03      ; Set the number of delay loops to three.
 $A6E4 LD HL,$0000   ; Set the length of each delay loop.
 $A6E7 JP $AE82      ; Wait for a while.

; Swap Player States
;
; Used by the routines at #R$A50A, #R$A6B5 and #R$C049.
; .
; Exchanges the nineteen bytes of state for the current player, which
; start at #R$A257, with the nineteen bytes for the other player, which start at
; #R$A26A.
@label=SwapPlayerStates
c$A6EA LD HL,$A257   ; Point #REGhl at the state of the current player.
 $A6ED LD DE,$A26A   ; Point #REGde at #R$A26A.
 $A6F0 LD B,$13      ; Set the number of bytes to nineteen.
; This entry point is used by the routine at #R$A50A.
; .
; This entry point exchanges #REGb bytes at #REGhl with the bytes at
; #REGde.
@label=SwapBytes
*$A6F2 LD C,(HL)     ; Fetch a byte from the first block.
 $A6F3 LD A,(DE)     ; Fetch the matching byte of the second block.
 $A6F4 LD (HL),A     ; Put it into the first block.
 $A6F5 LD A,C        ; Take the byte from the first block.
 $A6F6 LD (DE),A     ; Put it into the second block.
 $A6F7 INC DE        ; {Move on to the next byte of each block.
 $A6F8 INC HL        ; }
 $A6F9 DJNZ $A6F2    ; Loop back until every byte has been swapped.
 $A6FB RET           ; Return.

; Print Telegram
;
; Used by the routine at #R$D2FB.
; .
; Prints the whole telegram panel in town. It converts the bullet price,
; the horse price and the fine into digits, prints the first four lines of the
; telegram and, in a game for two players, the line which shows the score of the
; player who is not currently playing.
; #PUSHS #UDGTABLE { #POKES$5C79,$56
; #SIM(start=$A36D,stop=$A392,clear=1,sp=$5E00)
; #SIM(start=$A395,stop=$A3B3)
; #SIM(start=$C7D1,stop=$A3B7)
; #SIM(start=$A3B7,stop=$D301)
; #SIM(start=$D301,stop=$D304)
; #SCR$03,$11,$11,$0E,$05(telegram) } UDGTABLE# #POPS
@label=PrintTelegram
c$A6FC LD A,($A267)             ; Fetch the town flag.
 $A6FF AND A                    ; {Return if the game is not in town.
 $A700 RET Z                    ; }
 $A701 LD HL,$A83D              ; Point #REGhl at #R$A83D.
 $A704 LD DE,$A25E              ; Point #REGde at #R$A25E.
 $A707 CALL $A781               ; Convert the price to digits.
 $A70A LD HL,$A84F              ; Point #REGhl at #R$A84F.
 $A70D LD DE,$A25C              ; Point #REGde at #R$A25C.
 $A710 CALL $A781               ; Convert the price to digits.
 $A713 LD HL,$A861              ; Point #REGhl at #R$A861.
 $A716 LD DE,$A25A              ; Point #REGde at #R$A25A.
 $A719 CALL $A781               ; Convert the amount to digits.
 $A71C LD DE,$A830              ; Point #REGde at #R$A830.
 $A71F LD B,$04                 ; Set the number of lines to four.
 $A721 CALL $A744               ; Print the four lines.
 $A724 LD A,($A21C)             ; Fetch the option flags.
 $A727 BIT 0,A                  ; {Return if the game has only one player.
 $A729 RET Z                    ; }
 $A72A LD A,($A23F)             ; Fetch the number of the current player.
 $A72D AND %00000001            ; Keep bit 0.
 $A72F JR NZ,$A766              ; Jump to #R$A766 if the second player is
                                ; playing.
 $A731 LD DE,$A88A              ; Point #REGde at #R$A88A.
@label=PrintTelegram_ScoreLine
*$A734 PUSH DE                  ; Stash the address of the line on the stack.
 $A735 LD HL,$A26A              ; Point #REGhl at #R$A26A.
 $A738 EX DE,HL                 ; Swap the two addresses.
 $A739 LD A,$0C                 ; Set the offset to the digits within the line.
 $A73B CALL $D275               ; Point #REGhl at the digits.
 $A73E CALL $A4F2               ; Convert the score to digits.
 $A741 POP DE                   ; Retrieve the address of the line.
 $A742 LD B,$01                 ; Set the number of lines to print to one.
; This entry point prints #REGb lines of the telegram, starting with the
; line at #REGde.
@label=PrintTelegram_Lines
*$A744 LD C,$0E                 ; Set the number of characters in a line to
                                ; fourteen.
 $A746 INC DE                   ; Skip the counter of the line.
 $A747 LD A,(DE)                ; Fetch the low byte of the screen address of
                                ; the line.
 $A748 INC DE                   ; Move on to the high byte.
 $A749 ADD A,$04                ; Add four to move past the left edge of the
                                ; panel.
 $A74B LD L,A                   ; Keep the low byte of the screen address in
                                ; #REGl.
 $A74C LD A,(DE)                ; Fetch the high byte of the screen address of
                                ; the line.
 $A74D INC DE                   ; Move on to the attribute.
 $A74E LD H,A                   ; Keep the high byte of the screen address in
                                ; #REGh.
 $A74F LD A,(DE)                ; Fetch the attribute of the line.
 $A750 INC DE                   ; Move on to the first character.
 $A751 EX AF,AF'                ; Keep the attribute in the alternate
                                ; accumulator.
@label=PrintTelegram_LinesLoop
*$A752 LD A,(DE)                ; Fetch a character.
 $A753 INC DE                   ; Move on to the next character.
 $A754 PUSH BC                  ; Stash the counters on the stack.
 $A755 CALL $D4EA               ; Convert the character to the number of its
                                ; tile.
 $A758 LD BC,$8EA8              ; Point #REGbc at #R$8EA8.
 $A75B CALL $D639               ; Draw the character on the screen.
 $A75E INC L                    ; Move to the next screen position.
 $A75F POP BC                   ; Retrieve the counters.
 $A760 DEC C                    ; Decrease the character counter.
 $A761 JR NZ,$A752              ; Loop back until the whole line has been
                                ; printed.
 $A763 DJNZ $A744               ; Loop back until every line has been printed.
 $A765 RET                      ; Return.
@label=PrintTelegram_FirstPlayerLine
*$A766 LD DE,$A878              ; Point #REGde at the score line for the first
                                ; player.
 $A769 JR $A734                 ; Jump to #R$A734.
 $A76B DEFB $C9,$AF,$32,$30,$A8 ; Unused.

; Reset Bullet Price
;
; Used by the routine at #R$A68F.
; .
; Gives bullets their starting price of $5 if the price is zero.
@label=ResetBulletPrice
c$A770 LD HL,$A25E              ; Point #REGhl at the bullet price.
 $A773 LD A,(HL)                ; Fetch the low byte of the price.
 $A774 INC HL                   ; Move on to the high byte.
 $A775 OR (HL)                  ; {Return if the bullet price is not zero.
 $A776 RET NZ                   ; }
 $A777 LD DE,$A83D              ; Point #REGde at #R$A83D.
 $A77A LD BC,$0005              ; Set the starting bullet price of $5 in
                                ; #REGbc.
; This entry point is used by the routines at #R$A5D5, #R$A7B8 and #R$A7CB.
; .
; This entry point stores the price in #REGbc and converts it to digits.
; It is used when the telegram changes a price.
@label=ResetBulletPrice_SetPrice
*$A77D LD (HL),B                ; Store the high byte of the price.
 $A77E DEC HL                   ; Move back to the low byte.
 $A77F LD (HL),C                ; Store the low byte of the price.
 $A780 EX DE,HL                 ; Point #REGhl at the digits.
; This entry point is used by the routine at #R$A6FC.
; .
; This entry point converts the two packed decimal bytes at #REGde, in the
; order low byte first, into digits at #REGhl. Leading zeros are not printed and
; are replaced by spaces after the digits instead.
@label=ConvertPriceToDigits
*$A781 LD BC,$0200              ; Set the number of bytes to two and clear the
                                ; count of leading zeros.
 $A784 INC DE                   ; Point #REGde at the high byte.
@label=ResetBulletPrice_ConvertPriceSkipZeros
*$A785 LD A,(DE)                ; Fetch a byte.
 $A786 AND %11110000            ; Keep the first digit.
 $A788 JR NZ,$A795              ; Jump to #R$A795 if it is not zero.
 $A78A INC C                    ; Count a leading zero.
 $A78B LD A,(DE)                ; Fetch the byte again.
 $A78C AND %00001111            ; Keep the second digit.
 $A78E JR NZ,$A7A0              ; Jump to #R$A7A0 if it is not zero.
 $A790 INC C                    ; Count another leading zero.
 $A791 DEC DE                   ; Move down to the next byte.
 $A792 DJNZ $A785               ; Loop back until both bytes have been checked.
 $A794 RET                      ; Return.
@label=ResetBulletPrice_ConvertPriceDigits
*$A795 LD A,(DE)                ; Fetch the byte.
 $A796 RRCA                     ; {Move the first digit into the bottom half of
 $A797 RRCA                     ; the byte.
 $A798 RRCA                     ;
 $A799 RRCA                     ; }
 $A79A AND %00001111            ; Keep the digit.
 $A79C ADD A,$30                ; Convert it to a character.
 $A79E LD (HL),A                ; Write it to the text.
 $A79F INC HL                   ; Move on to the next character.
@label=ResetBulletPrice_Done
*$A7A0 LD A,(DE)                ; Fetch the byte.
 $A7A1 AND %00001111            ; Keep the second digit.
 $A7A3 ADD A,$30                ; Convert it to a character.
 $A7A5 LD (HL),A                ; Write it to the text.
 $A7A6 INC HL                   ; Move on to the next character.
 $A7A7 DEC DE                   ; Move down to the next byte.
 $A7A8 DJNZ $A795               ; Loop back until both bytes have been
                                ; converted.
@label=ResetBulletPrice_ConvertPricePad
*$A7AA LD A,C                   ; Fetch the count of leading zeros.
 $A7AB AND A                    ; {Return once every leading zero has been
 $A7AC RET Z                    ; replaced.}
 $A7AD LD (HL),$20              ; Write a space.
 $A7AF INC HL                   ; Move on to the next character.
 $A7B0 DEC C                    ; Count the space.
 $A7B1 JR $A7AA                 ; Loop back to #R$A7AA.
 $A7B3 DEFB $C9,$AF,$32,$42,$A8 ; Unused.

; Reset Horse Price
;
; Used by the routine at #R$A68F.
; .
; Gives a horse its starting price of $50 if the price is zero.
@label=ResetHorsePrice
c$A7B8 LD HL,$A25C          ; Point #REGhl at the horse price.
 $A7BB LD A,(HL)            ; Fetch the low byte of the price.
 $A7BC INC HL               ; Move on to the high byte.
 $A7BD OR (HL)              ; {Return if the horse price is not zero.
 $A7BE RET NZ               ; }
 $A7BF LD DE,$A84F          ; Point #REGde at #R$A84F.
 $A7C2 LD BC,$0050          ; Set the starting horse price of $50 in #REGbc.
 $A7C5 JR $A77D             ; Store the price and convert it to digits.
 $A7C7 DEFB $AF,$32,$42,$A8 ; Unused.

; Reset Fine
;
; Used by the routine at #R$A68F.
; .
; Gives the fine its starting amount of $100 if the amount is zero.
@label=ResetFine
c$A7CB LD HL,$A25A   ; Point #REGhl at the fine.
 $A7CE LD A,(HL)     ; Fetch the low byte of the fine.
 $A7CF INC HL        ; Move on to the high byte.
 $A7D0 OR (HL)       ; {Return if the fine is not zero.
 $A7D1 RET NZ        ; }
 $A7D2 LD DE,$A861   ; Point #REGde at #R$A861.
 $A7D5 LD BC,$0100   ; Set the starting fine of $100 in #REGbc.
 $A7D8 JR $A77D      ; Store the fine and convert it to digits.

; Type Telegram
;
; Used by the routine at #R$A36D.
; .
; Called every frame in town. It makes the lines of the telegram appear
; one letter at a time, like a telegram being typed. Each line has a counter
; which is #N$0E once the line is complete. The first line which is not complete
; shows a blinking cursor on alternate frames, and on the other frames prints
; its next letter and clicks.
@label=TypeTelegram
c$A7DA LD A,($A267)  ; Fetch the town flag.
 $A7DD AND A         ; {Return if the game is not in town.
 $A7DE RET Z         ; }
 $A7DF LD B,$06      ; Set the number of lines to six.
 $A7E1 LD HL,$A830   ; Point #REGhl at #R$A830.
 $A7E4 LD DE,$0012   ; Set the size of a telegram line in #REGde.
 $A7E7 LD A,($A267)  ; {Fetch the town flag, which is also the column of the panel and keep
 $A7EA LD C,A        ; the panel column in #REGc.}
@label=TypeTelegram_NextLine
*$A7EB LD A,(HL)     ; Fetch the counter of the line.
 $A7EC CP $0E        ; {Jump to #R$A7F4 if the line is not complete.
 $A7EE JR NZ,$A7F4   ; }
 $A7F0 ADD HL,DE     ; Move on to the next line.
 $A7F1 DJNZ $A7EB    ; Loop back until every line has been checked.
 $A7F3 RET           ; Return.
; Find the position of the next letter of the line.
@label=TypeTelegram_StashLine
*$A7F4 PUSH HL       ; Stash the address of the line on the stack.
 $A7F5 PUSH AF       ; Stash the counter of the line on the stack.
 $A7F6 INC HL        ; Move on to the low byte of the screen address.
 $A7F7 LD E,(HL)     ; Fetch the low byte of the screen address.
 $A7F8 INC HL        ; Move on to the high byte.
 $A7F9 LD D,(HL)     ; Fetch the high byte of the screen address.
 $A7FA INC HL        ; Move on to the attribute.
 $A7FB EX DE,HL      ; Swap the screen address into #REGhl.
 $A7FC ADD A,C       ; Add the counter and the column of the panel to the
                     ; address.
 $A7FD CALL $D275    ; Point #REGhl at the position of the next letter.
 $A800 LD A,(DE)     ; Fetch the attribute.
 $A801 INC DE        ; Move on to the first letter.
 $A802 EX AF,AF'     ; Keep the attribute in the alternate accumulator.
 $A803 LD A,($A216)  ; Fetch the low byte of the frame counter.
 $A806 AND %00000001 ; Keep bit 0.
 $A808 JR Z,$A818    ; Jump to #R$A818 on even frames.
; On odd frames draw the cursor in the next position.
 $A80A ADD A,$5E     ; Convert the odd frame into the number of the cursor
                     ; character.
 $A80C CALL $D4EA    ; Convert the character to the number of its tile.
 $A80F LD BC,$8EA8   ; Point #REGbc at #R$8EA8.
 $A812 CALL $D639    ; Draw the cursor.
 $A815 POP AF        ; Retrieve the counter of the line.
 $A816 POP HL        ; Retrieve the address of the line.
 $A817 RET           ; Return.
; On even frames print the next letter and click.
@label=TypeTelegram_RestoreCounter
*$A818 POP AF        ; Retrieve the counter of the line.
 $A819 EX DE,HL      ; Swap the pointer to the letters into #REGhl.
 $A81A CALL $D275    ; Point #REGhl at the next letter of the line.
 $A81D EX DE,HL      ; Swap the pointer back into #REGde.
 $A81E LD A,(DE)     ; Fetch the letter.
 $A81F CALL $D4EA    ; Convert the letter to the number of its tile.
 $A822 PUSH AF       ; Stash the tile number on the stack.
 $A823 CALL $AF43    ; Play a click.
 $A826 POP AF        ; Retrieve the tile number.
 $A827 LD BC,$8EA8   ; Point #REGbc at #R$8EA8.
 $A82A CALL $D639    ; Draw the letter.
 $A82D POP HL        ; Retrieve the address of the line.
 $A82E INC (HL)      ; Increase the counter of the line.
 $A82F RET           ; Return.

; Telegram Lines
;
; The six lines of the telegram panel, each #N$12 bytes long. The first
; byte is the number of letters typed so far, which is #N$0E once the line is
; complete. Then come the screen address of the line, its attribute and fourteen
; characters. The score lines have room after the dollar sign for the digits.
; The #N$5C in the high score line is the full stop of the font.
@label=TelegramLines
g$A830 DEFB $0E           ; Letters typed so far.
 $A831 DEFW $502D         ; Screen address.
 $A833 DEFB $47           ; Attribute: #COLOUR(#PEEK(#PC)).
 $A834 DEFM "BULLETS "    ; "BULLETS ".
 $A83C DEFB $5E           ; Dollar sign.
@label=TelegramLines_BulletDigits
 $A83D DEFM "     "       ; "     ".
 $A842 DEFB $0E           ; Letters typed so far.
 $A843 DEFW $504D         ; Screen address.
 $A845 DEFB $47           ; Attribute: #COLOUR(#PEEK(#PC)).
 $A846 DEFM "HORSE   "    ; "HORSE   ".
 $A84E DEFB $5E           ; Dollar sign.
@label=TelegramLines_HorseDigits
 $A84F DEFM "     "       ; "     ".
 $A854 DEFB $0E           ; Letters typed so far.
 $A855 DEFW $506D         ; Screen address.
 $A857 DEFB $47           ; Attribute: #COLOUR(#PEEK(#PC)).
 $A858 DEFM "FINE    "    ; "FINE    ".
 $A860 DEFB $5E           ; Dollar sign.
@label=TelegramLines_FineDigits
 $A861 DEFM "     "       ; "     ".
 $A866 DEFB $0E           ; Letters typed so far.
 $A867 DEFW $50AD         ; Screen address.
 $A869 DEFB $46           ; Attribute: #COLOUR(#PEEK(#PC)).
 $A86A DEFM "HI"          ; "HI".
 $A86C DEFB $5C           ; Full stop.
 $A86D DEFM "SCR "        ; "SCR ".
 $A871 DEFB $5E           ; Dollar sign.
@label=TelegramLines_HighScoreDigits
 $A872 DEFM "      "      ; "      ".
@label=TelegramLines_FirstPlayerScore
 $A878 DEFB $0E           ; Letters typed so far.
 $A879 DEFW $50CD         ; Screen address.
 $A87B DEFB $46           ; Attribute: #COLOUR(#PEEK(#PC)).
 $A87C DEFM "P1 SCR ",$5E ; "P1 SCR ".
 $A884 DEFB $20           ; Dollar sign.
 $A885 DEFM "     "       ; "     ".
@label=TelegramLines_SecondPlayerScore
 $A88A DEFB $0E           ; Letters typed so far.
 $A88B DEFW $50CD         ; Screen address.
 $A88D DEFB $46           ; Attribute: #COLOUR(#PEEK(#PC)).
 $A88E DEFM "P2 SCR ",$5E ; "P2 SCR ".
 $A896 DEFB $20           ; Dollar sign.
 $A897 DEFM "     "       ; "     ".

; Create Tumbleweed
;
; Used by the routine at #R$B3BD.
; .
; Called every frame in town. From level eight onwards it puts a
; tumbleweed (an object of type #N$17) in the ninth object slot, next to the
; sheriff, if the slot is free.
;
; .
;
; From level eight onwards, use the ninth slot if it is free.
@label=CreateTumbleweed
c$A89C LD A,($A260)    ; Fetch the level.
 $A89F CP $08          ; Compare it with eight.
 $A8A1 RET C           ; Return if the level is below eight.
 $A8A2 LD DE,$A2FD     ; Point #REGde at #R$A2FD.
 $A8A5 LD A,(DE)       ; Fetch the type of the object in the slot.
 $A8A6 AND A           ; {Return if the slot is in use.
 $A8A7 RET NZ          ; }
; Copy the template and place the tumbleweed near the sheriff.
 $A8A8 PUSH DE         ; {Copy #REGde to #REGiy (using the stack).
 $A8A9 POP IY          ; }
 $A8AB LD HL,$A8C1     ; Point #REGhl at #R$A8C1.
 $A8AE LD BC,$0010     ; Set the size of an object slot in #REGbc.
 $A8B1 LDIR            ; Copy the template into the slot.
 $A8B3 LD B,$01        ; Set the distance from the sheriff to one cell.
 $A8B5 CALL $B6CD      ; Place the tumbleweed one cell away from the sheriff.
 $A8B8 RET NZ          ; Return if that cell is blocked.
 $A8B9 CALL $B6F8      ; Set the position of the tumbleweed within its cell.
 $A8BC LD (IY+$00),$17 ; Turn the slot into a tumbleweed.
 $A8C0 RET             ; Return.

; Tumbleweed Template
;
; The initial contents of a slot for a tumbleweed. The final two bytes
; point to the sprite list.
@label=TumbleweedTemplate
b$A8C1 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; {Type, position, speed, size and
 $A8C9 DEFB $10,$10,$00,$00,$00,$00         ; counters.}
 $A8CF DEFW $A8D1                           ; The sprite list of a tumbleweed.
 $A8D1 DEFB $F4,$00,$2B,$80                 ; The sprite list: sprite #N$2B at offset
                                            ; (#N($F4), #N$00), then the terminator.
                                            ; #SPRITE$2B(tumbleweed*).

; Handle Tumbleweed
;
; Type #N$17: a tumbleweed rolling about next to the sheriff. It follows
; one of two routes, stepping through the route one byte at a time; the high
; nibble of each byte is the vertical speed and the low nibble the horizontal
; speed, both signed. Bits 6 and 7 of byte #N$05 mirror the route, and they
; change every time a route ends, so the tumbleweed wanders in a different way
; each time. It spins by flipping its sprite every frame, and it hurts the
; sheriff if they touch. It goes away when the sheriff is two cells away.
;
; .
;
; Disappear if the sheriff is more than two cells away.
@label=HandleTumbleweed
c$A8D5 LD C,$02        ; Set the distance to two cells.
 $A8D7 CALL $B810      ; Check how close the sheriff is.
 $A8DA JP NC,$C7BB     ; Remove the tumbleweed if the sheriff has moved away.
; Fetch the next step of the route.
 $A8DD LD A,(IX+$0A)   ; Fetch the number of the route, zero or one.
 $A8E0 LD BC,$A94B     ; Point #REGbc at #R$A94B.
 $A8E3 CALL $C75C      ; Point #REGhl at the start of the route.
 $A8E6 LD A,(IX+$0B)   ; Fetch the position in the route.
 $A8E9 INC (IX+$0B)    ; Move on to the next step.
 $A8EC CALL $D275      ; Point #REGhl at the step.
 $A8EF LD A,(HL)       ; Fetch the step.
 $A8F0 CP $80          ; {Jump to #R$A935 if this is the end of the route.
 $A8F2 JR Z,$A935      ; }
; Work out the vertical speed from the high nibble.
 $A8F4 SRA A           ; {Shift the high nibble into the bottom of the byte,
 $A8F6 SRA A           ; keeping the sign.
 $A8F8 SRA A           ;
 $A8FA SRA A           ; }
 $A8FC BIT 6,(IX+$05)  ; {Jump to #R$A904 unless the route is mirrored
 $A900 JR Z,$A904      ; vertically.}
 $A902 NEG             ; Negate the speed to mirror the route.
@label=HandleTumbleweed_DoubleVertical
*$A904 SLA A           ; Double the speed.
 $A906 LD ($A215),A    ; Store it as the vertical speed.
; Work out the horizontal speed from the low nibble.
 $A909 LD A,(HL)       ; Fetch the step again.
 $A90A LD C,A          ; Keep the tumbleweed step in #REGc.
 $A90B AND %00001111   ; Keep the low nibble.
 $A90D BIT 3,C         ; {Jump to #R$A913 unless the nibble is negative.
 $A90F JR Z,$A913      ; }
 $A911 OR %11110000    ; Extend the sign of the nibble into the top half.
@label=HandleTumbleweed_TestHorizontal
*$A913 BIT 7,(IX+$05)  ; {Jump to #R$A91B unless the route is mirrored
 $A917 JR Z,$A91B      ; horizontally.}
 $A919 NEG             ; Negate the speed to mirror the route.
@label=HandleTumbleweed_DoubleHorizontal
*$A91B SLA A           ; Double the speed.
 $A91D LD ($A214),A    ; Store it as the horizontal speed.
; Move the tumbleweed.
 $A920 CALL $CD40      ; Set the direction the tumbleweed is facing from its
                       ; speed.
 $A923 CALL $CCE5      ; Move the tumbleweed.
 $A926 LD A,(IX+$07)   ; Fetch the flags of the object.
 $A929 XOR %01000000   ; Flip the sprite horizontally.
 $A92B LD (IX+$07),A   ; Store the flags.
 $A92E CALL $B631      ; Check whether the tumbleweed is touching the sheriff.
 $A931 JP C,$B754      ; Hurt the sheriff if it is.
 $A934 RET             ; Return.
; The route has ended, so choose the next one.
@label=HandleTumbleweed_RouteEnd
*$A935 LD A,($A218)    ; Fetch a random number.
 $A938 AND %00000001   ; Keep bit 0.
 $A93A LD (IX+$0A),A   ; Choose the route with it.
 $A93D LD (IX+$0B),$00 ; Write #N$00 to byte #N$0B to go back to the first
                       ; step.
 $A941 LD A,(IX+$05)   ; Fetch the mirror flags.
 $A944 ADD A,$40       ; Add #N$40 to change how the route is mirrored.
 $A946 LD (IX+$05),A   ; Store the flags.
 $A949 JR $A8D5        ; Start again with the new route.

; Tumbleweed Routes
;
; The table of the two routes followed by tumbleweeds, followed by the
; routes themselves. Each step of a route is a signed vertical speed in the high
; nibble and a signed horizontal speed in the low nibble. #N$80 ends a route.
@label=TumbleweedRoutes
g$A94B DEFW $A94F                           ; {The addresses of the two routes.
 $A94D DEFW $A968                           ; }
 $A94F DEFB $0C,$2C,$0C,$2C,$2C,$4E,$2C,$4E ; {The first route.
 $A957 DEFB $4E,$40,$4E,$40,$40,$42,$40,$42 ;
 $A95F DEFB $42,$24,$42,$24,$24,$24,$24,$20 ;
 $A967 DEFB $80                             ; }
 $A968 DEFB $C0,$C2,$C0,$C2,$C2,$E4,$C2,$E4 ; {The second route.
 $A970 DEFB $E4,$04,$E4,$04,$04,$24,$04,$24 ;
 $A978 DEFB $24,$42,$24,$42,$42,$42,$42,$02 ;
 $A980 DEFB $80                             ; }

; Create Horse
;
; Used by the routine at #R$B3BD.
; .
; Called every frame in town. While the sheriff is on foot it puts a horse
; (an object of type #N$14) in the eighth object slot, two cells from the
; sheriff, if the slot is free.
;
; .
;
; While the sheriff is on foot, use the eighth slot if it is free.
@label=CreateHorse
c$A981 LD A,($A27D)    ; Fetch the type of the object in the first slot.
 $A984 CP $01          ; Compare it with the type of a sheriff on foot.
 $A986 RET NZ          ; Return if the sheriff is not on foot.
 $A987 LD DE,$A2ED     ; Point #REGde at #R$A2ED.
 $A98A LD A,(DE)       ; Fetch the type of the object in the slot.
 $A98B AND A           ; {Return if the slot is in use.
 $A98C RET NZ          ; }
; Copy the template and place the horse near the sheriff.
 $A98D PUSH DE         ; {Copy #REGde to #REGiy (using the stack).
 $A98E POP IY          ; }
 $A990 LD HL,$A9A8     ; Point #REGhl at #R$A9A8.
 $A993 LD BC,$0010     ; Set the size of an object slot in #REGbc.
 $A996 LDIR            ; Copy the template into the slot.
 $A998 LD B,$02        ; Set the distance from the sheriff to two cells.
 $A99A CALL $B6CD      ; Place the horse two cells away from the sheriff.
 $A99D RET NZ          ; Return if that cell is blocked.
 $A99E LD (IY+$00),$14 ; Turn the slot into a horse.
 $A9A2 LD A,$40        ; {Set the riding time of the horse to #N$40.
 $A9A4 LD ($A209),A    ; }
 $A9A7 RET             ; Return.

; Horse Template
;
; The initial contents of a slot for a horse. The final two bytes point to
; the sprite list.
@label=HorseTemplate
b$A9A8 DEFB $00,$80,$00,$80,$00,$00,$00,$00 ; {Type, position, speed, size and
 $A9B0 DEFB $10,$10,$00,$00,$00,$00         ; counters.}
 $A9B6 DEFW $A9B8                           ; The sprite list of a horse.
 $A9B8 DEFB $EC,$00,$37                     ; {The sprite list: sprite #N$37 at offset
 $A9BB DEFB $FC,$01,$36                     ; (#N($EC), #N$00), sprite #N$36 at offset (#N($FC),
 $A9BE DEFB $80                             ; #N$01), then the terminator.
                                            ; #SPRITE$37(horse-head*) #SPRITE$36(horse-body*).
                                            ; }

; Handle Horse
;
; Type #N$14: a horse waiting in the street. It goes away if the sheriff
; is three cells away. If the sheriff touches it, the horse is removed, the
; sheriff turns into a mounted sheriff (type #N$15) who has a higher top speed,
; and the price of the horse is taken from the bounty.
;
; .
;
; Remove the horse if the sheriff has moved away.
@label=HandleHorse
c$A9BF LD C,$03        ; Set the distance to three cells.
 $A9C1 CALL $B810      ; Check how close the sheriff is.
 $A9C4 JP NC,$C7BB     ; Remove the horse if the sheriff has moved away.
; Mount the sheriff when he touches the horse.
 $A9C7 CALL $B631      ; Check whether the sheriff is touching the horse.
 $A9CA RET NC          ; Return if not.
 $A9CB LD A,$08        ; {Write #N$08 to #R$A23C so that the sound lasts eight
 $A9CD LD ($A23C),A    ; notes.}
 $A9D0 LD HL,$AEBF     ; {Point #R$A23D at the notes of the horse sound.
 $A9D3 LD ($A23D),HL   ; }
 $A9D6 LD (IX+$00),$00 ; Remove the horse.
 $A9DA LD A,$12        ; {Raise the top speed of the sheriff to #N$12.
 $A9DC LD ($A21F),A    ; }
 $A9DF LD (IY+$00),$15 ; Turn the sheriff into a mounted sheriff.
 $A9E3 LD BC,($A25C)   ; Fetch the price of a horse.
 $A9E7 CALL $D347      ; Take it from the bounty.
 $A9EA JP $D390        ; Jump to #R$D390.

; Create Cactus
;
; Used by the routine at #R$B3BD.
; .
; Called every frame in town. Cacti stand in eight fixed cells of the town
; (see #R$AA76). When the sheriff comes within two cells of one, and the seventh
; object slot is free, the routine puts a cactus (an object of type #N$13) in
; the slot.
;
; .
;
; Return if the seventh slot is in use.
@label=CreateCactus
c$A9ED LD A,($A2DD)  ; Fetch the type of the object in the seventh slot.
 $A9F0 AND A         ; {Return if the slot is in use.
 $A9F1 RET NZ        ; }
; Find a cactus that is within two cells of the sheriff.
 $A9F2 LD A,($A27F)  ; {Fetch the horizontal cell of the sheriff and keep it in
 $A9F5 LD E,A        ; #REGe.}
 $A9F6 LD A,($A281)  ; Fetch the vertical cell of the sheriff.
 $A9F9 RLCA          ; {Shift it into the high nibble.
 $A9FA RLCA          ;
 $A9FB RLCA          ;
 $A9FC RLCA          ; }
 $A9FD AND %11110000 ; Keep the high nibble.
 $A9FF LD D,A        ; Keep the vertical cell in the high nibble of #REGd.
 $AA00 LD HL,$AA76   ; Point #REGhl at #R$AA76.
 $AA03 LD B,(HL)     ; Fetch the number of cacti.
@label=CreateCactus_Next
 $AA04 INC HL        ; Move on to the next cactus.
@label=CreateCactus_Loop
*$AA05 LD A,(HL)     ; Fetch the position of the cactus.
 $AA06 AND %00001111 ; Keep the horizontal cell.
 $AA08 SUB E         ; Subtract the horizontal cell of the sheriff.
 $AA09 JR NC,$AA0D   ; Jump to #R$AA0D unless the difference is negative.
 $AA0B NEG           ; Make the difference positive.
@label=CreateCactus_CompareHorizontal
*$AA0D CP $02        ; {Jump to #R$AA5E if the cactus is two or more cells away
 $AA0F JR NC,$AA5E   ; horizontally.}
 $AA11 LD A,(HL)     ; Fetch the position of the cactus again.
 $AA12 AND %11110000 ; Keep the vertical cell.
 $AA14 SUB D         ; Subtract the vertical cell of the sheriff.
 $AA15 JR NC,$AA19   ; Jump to #R$AA19 unless the difference is negative.
 $AA17 NEG           ; Make the difference positive.
@label=CreateCactus_CompareVertical
*$AA19 CP $20        ; {Jump to #R$AA5E if the cactus is two or more cells away
 $AA1B JR NC,$AA5E   ; vertically.}
; The sheriff is close to this cactus, so make it.
@label=CreateCactusFound
 $AA1D LD A,(HL)     ; Fetch the position of the cactus.
 $AA1E PUSH AF       ; Stash it on the stack.
 $AA1F LD DE,$A2DD   ; Point #REGde at #R$A2DD.
 $AA22 PUSH DE       ; {Copy #REGde to #REGiy (using the stack).
 $AA23 POP IY        ; }
 $AA25 LD HL,$AA62   ; Point #REGhl at #R$AA62.
 $AA28 LD BC,$0010   ; Set the size of an object slot in #REGbc.
 $AA2B LDIR          ; Copy the template into the slot.
 $AA2D POP AF        ; Retrieve the position of the cactus.
 $AA2E LD C,A        ; Keep the cactus position in #REGc.
 $AA2F AND %00001111 ; Keep the horizontal cell.
 $AA31 LD (IY+$02),A ; Set the horizontal cell of the cactus.
 $AA34 LD A,C        ; Fetch the position again.
 $AA35 RRCA          ; {Shift the vertical cell into the bottom of the byte.
 $AA36 RRCA          ;
 $AA37 RRCA          ;
 $AA38 RRCA          ; }
 $AA39 AND %00001111 ; Keep the vertical cell.
 $AA3B LD (IY+$04),A ; Set the vertical cell of the cactus.
 $AA3E LD A,C        ; Fetch the position again.
 $AA3F RLCA          ; {Swap the two halves of the position.
 $AA40 RLCA          ;
 $AA41 RLCA          ;
 $AA42 RLCA          ; }
 $AA43 AND %01110000 ; Keep three bits which came from the horizontal cell.
 $AA45 ADD A,$40     ; Add #N$40 to give the horizontal position within the
                     ; cell.
 $AA47 LD (IY+$01),A ; Set the horizontal position of the cactus within its
                     ; cell.
 $AA4A LD A,C        ; Fetch the position again.
 $AA4B CPL           ; Invert it.
 $AA4C AND %01110000 ; Keep three bits which came from the vertical cell.
 $AA4E ADD A,$40     ; Add #N$40 to give the vertical position within the cell.
 $AA50 LD (IY+$03),A ; Set the vertical position of the cactus within its cell.
 $AA53 XOR (IY+$01)  ; Combine it with the horizontal position.
 $AA56 RLCA          ; {Rotate bit 4 up into bit 6.
 $AA57 RLCA          ; }
 $AA58 AND %01000000 ; Keep bit 6, which chooses whether the sprite is flipped.
 $AA5A LD (IY+$07),A ; Set the flags of the cactus.
 $AA5D RET           ; Return.
@label=CreateCactusSkip
*$AA5E INC HL        ; Move on to the next cactus.
 $AA5F DJNZ $AA05    ; Loop back until every cactus has been checked.
 $AA61 RET           ; Return.

; Cactus Template
;
; The initial contents of a slot for a cactus. The final two bytes point
; to the sprite list.
@label=CactusTemplate
b$AA62 DEFB $13,$00,$00,$00,$00,$00,$00,$00 ; {Type, position, speed, size and
 $AA6A DEFB $10,$10,$00,$00,$00,$00         ; counters.}
 $AA70 DEFW $AA72                           ; The sprite list of a cactus.
 $AA72 DEFB $F4,$00,$2A,$80                 ; The sprite list: sprite #N$2A at offset
                                            ; (#N($F4), #N$00), then the terminator.
                                            ; #SPRITE$2A(cactus*).

; Cactus Positions
;
; The number of cacti, followed by the position of each in the town. The
; high nibble of a position is the vertical cell and the low nibble is the
; horizontal cell. #R$A9ED also uses the same byte to choose where in its cell
; the cactus stands, so that the cacti do not all stand in the middle of their
; cells.
@label=CactusPositions
g$AA76 DEFB $08                             ; The number of cacti.
 $AA77 DEFB $33,$2D,$5E,$92,$B7,$BC,$D2,$DE ; The positions of the cacti.

; Handle Cactus
;
; Type #N$13: a cactus standing in the street. It goes away when the
; sheriff is more than two cells away. It hurts the sheriff if they touch, and
; it stops any bullet which hits it.
;
; .
;
; Remove the cactus if the sheriff has moved away.
@label=HandleCactus
c$AA7F LD C,$02        ; Set the distance to two cells.
 $AA81 CALL $B810      ; Check how close the sheriff is.
 $AA84 JP NC,$C7BB     ; Remove the cactus if the sheriff has moved away.
; Hurt the sheriff or stop a bullet which hits it.
 $AA87 CALL $B631      ; Check whether the cactus is touching the sheriff.
 $AA8A JP C,$B754      ; Hurt the sheriff if it is.
 $AA8D CALL $B614      ; Check whether a bullet has hit the cactus.
 $AA90 RET NC          ; Return if not.
 $AA91 LD (IY+$00),$07 ; Turn the bullet into a puff of smoke.
 $AA95 LD (IY+$0C),$02 ; Set the length of the puff to two frames.
 $AA99 RET             ; Return.

; Print Large Text
;
; Used by the routines at #R$A50A, #R$A6C9, #R$AB77, #R$B7A8, #R$BA8B, #R$BAB1
; and #R$BB3A.
; .
; Prints a message in letters twice as big as normal, so each letter takes
; four character cells. The message is an attribute byte followed by characters
; and ends with a zero byte.
; #PUSHS #UDGTABLE { #SIM(start=$D6DB,stop=$D6EA,clear=1,sp=$5E00)
; #SIM(start=$D6D3,stop=$D6EA,de=$47)
; #SIM(start=$ABDE,stop=$ABE7)
; #SCR$03,$06,$00,$14,$02(large-text) } UDGTABLE# #POPS
;
; DE The address of the message
; HL The screen address to print it at
;
; Fetch the attribute of the message.
@label=PrintLargeText
c$AA9A LD A,(DE)     ; Fetch the attribute.
 $AA9B INC DE        ; Move on to the first character.
 $AA9C EX AF,AF'     ; Keep the attribute in the alternate accumulator.
; Print each character until the terminator.
@label=PrintLargeText_Loop
*$AA9D LD A,(DE)     ; Fetch the next character.
 $AA9E AND A         ; Test whether it is the end of the message.
 $AA9F RET Z         ; Return if it is.
 $AAA0 INC DE        ; Move on to the next character.
 $AAA1 CALL $D4EA    ; Convert the character to the number of its tile.
; Find the pixels of the character.
 $AAA4 PUSH DE       ; Stash the address of the message on the stack.
 $AAA5 PUSH HL       ; Stash the screen address on the stack.
 $AAA6 EX DE,HL      ; Swap the screen address into #REGde.
 $AAA7 LD L,A        ; Copy the tile number into #REGl.
 $AAA8 LD H,$00      ; Clear #REGh.
 $AAAA ADD HL,HL     ; {Multiply it by eight.
 $AAAB ADD HL,HL     ;
 $AAAC ADD HL,HL     ; }
 $AAAD LD BC,$8EA8   ; Point #REGbc at #R$8EA8.
 $AAB0 ADD HL,BC     ; Add the offset to find the pixels of the character.
 $AAB1 EX DE,HL      ; Swap them, so that #REGde has the pixels and #REGhl the screen
                     ; address.
; Draw the four quarters of the character.
 $AAB2 CALL $AAC4    ; Draw the top left quarter of the character.
 $AAB5 CALL $AAE7    ; Draw the top right quarter of the character.
 $AAB8 CALL $AAC4    ; Draw the bottom left quarter of the character.
 $AABB CALL $AAE7    ; Draw the bottom right quarter of the character.
 $AABE POP HL        ; Retrieve the screen address.
 $AABF POP DE        ; Retrieve the address of the message.
 $AAC0 INC L         ; {Move across by two character cells.
 $AAC1 INC L         ; }
 $AAC2 JR $AA9D      ; Loop back for the next character.

; Print Left Half Of Character
;
; Used by the routine at #R$AA9A.
; .
; Draws the left half of four rows of a character in double size. The four
; bytes of pixels at #REGde each have their left four pixels widened to eight
; and written twice, so they fill the eight pixel rows of a character cell. The
; cell is coloured with the attribute and #REGhl moves to the cell on its right.
;
;   DE The address of the pixels of the character
;   HL The screen address
; O:HL The screen address of the cell to the right
;
; Swap the pixels and the screen address.
@label=PrintLeftHalfOfCharacter
c$AAC4 PUSH DE       ; Stash the address of the pixels on the stack.
 $AAC5 PUSH HL       ; Stash the screen address on the stack.
 $AAC6 EX DE,HL      ; Swap the pixels into #REGhl and the screen address into
                     ; #REGde.
 $AAC7 LD B,$04      ; Set the number of rows to four.
; Widen the left four pixels of each row.
@label=PrintLeftHalf_Loop
*$AAC9 LD A,(HL)     ; Fetch a row of pixels.
 $AACA INC HL        ; Move on to the next row.
 $AACB RRCA          ; {Move the left four pixels into the bottom of the byte.
 $AACC RRCA          ;
 $AACD RRCA          ;
 $AACE RRCA          ; }
 $AACF AND %00001111 ; Keep them.
 $AAD1 PUSH HL       ; Stash the address of the pixels on the stack.
 $AAD2 LD HL,$AB08   ; Point #REGhl at #R$AB08.
 $AAD5 CALL $D275    ; Point #REGhl at the entry for the four pixels.
 $AAD8 LD A,(HL)     ; Fetch the widened pixels.
 $AAD9 LD (DE),A     ; Write them to the screen.
 $AADA INC D         ; Move down a pixel row.
 $AADB LD (DE),A     ; Write them again.
 $AADC INC D         ; Move down a pixel row.
 $AADD POP HL        ; Retrieve the address of the pixels.
 $AADE DJNZ $AAC9    ; Loop back until four rows have been drawn.
; Colour the cell and move to the right.
 $AAE0 POP HL        ; Retrieve the screen address.
 $AAE1 POP DE        ; Retrieve the address of the pixels.
 $AAE2 CALL $D63C    ; Set the attribute of the cell.
 $AAE5 INC L         ; Move across to the next cell.
 $AAE6 RET           ; Return.

; Print Right Half Of Character
;
; Used by the routine at #R$AA9A.
; .
; Draws the right half of four rows of a character in double size, in the
; same way as #R$AAC4 does for the left half, and then moves down to the cell
; below on the left.
;
;   DE The address of the pixels of the character
;   HL The screen address
; O:DE The address of the pixels of the next four rows
; O:HL The screen address of the cell below on the left
;
; Swap the pixels and the screen address.
@label=PrintRightHalfOfCharacter
c$AAE7 PUSH HL       ; Stash the screen address on the stack.
 $AAE8 EX DE,HL      ; Swap the pixels into #REGhl and the screen address into
                     ; #REGde.
 $AAE9 LD B,$04      ; Set the number of rows to four.
; Widen the right four pixels of each row.
@label=PrintRightHalf_Loop
*$AAEB LD A,(HL)     ; Fetch a row of pixels.
 $AAEC INC HL        ; Move on to the next row.
 $AAED AND %00001111 ; Keep the right four pixels.
 $AAEF PUSH HL       ; Stash the address of the pixels on the stack.
 $AAF0 LD HL,$AB08   ; Point #REGhl at #R$AB08.
 $AAF3 CALL $D275    ; Point #REGhl at the entry for the four pixels.
 $AAF6 LD A,(HL)     ; Fetch the widened pixels.
 $AAF7 LD (DE),A     ; Write them to the screen.
 $AAF8 INC D         ; Move down a pixel row.
 $AAF9 LD (DE),A     ; Write them again.
 $AAFA INC D         ; Move down a pixel row.
 $AAFB POP HL        ; Retrieve the address of the pixels.
 $AAFC DJNZ $AAEB    ; Loop back until four rows have been drawn.
; Colour the cell and move down on the left.
 $AAFE EX DE,HL      ; Swap the screen address back into #REGhl and the pixels
                     ; into #REGde.
 $AAFF POP HL        ; Retrieve the screen address.
 $AB00 CALL $D63C    ; Set the attribute of the cell.
 $AB03 CALL $D64F    ; Move down to the next row of cells.
 $AB06 DEC L         ; Move back to the left.
 $AB07 RET           ; Return.

; Widened Pixels
;
; Sixteen bytes, one for each pattern of four pixels. Each pixel of the
; pattern is doubled in width to give eight pixels.
@label=WidenedPixels
g$AB08 DEFB $00,$03,$0C,$0F,$30,$33,$3C,$3F
 $AB10 DEFB $C0,$C3,$CC,$CF,$F0,$F3,$FC,$FF

; Draw Scenery
;
; Used by the routine at #R$A36D.
; .
; Called every frame. In the town stage it draws the scenery sprites
; listed at #R$AB6A, which are fixed in the town and scroll with the view.
; Sprites which would be off the edge of the screen are skipped.
;
; .
;
; Return unless this is the town stage.
@label=DrawScenery
c$AB18 LD A,($A267)  ; Fetch the stage number.
 $AB1B AND A         ; Test whether this is a stage outside the town, which is the duel or
                     ; the bonus stage.
 $AB1C RET Z         ; Return if it is, as it has no scenery.
; Set the origin from the sheriff's cell.
 $AB1D LD A,($A27F)  ; Fetch the horizontal cell of the sheriff.
 $AB20 AND %11111110 ; Make it an even number.
 $AB22 LD L,A        ; Keep the even horizontal cell in #REGl.
 $AB23 LD A,($A281)  ; Fetch the vertical cell of the sheriff.
 $AB26 AND %11111110 ; Make it an even number.
 $AB28 LD H,A        ; Keep the even vertical cell in #REGh.
 $AB29 LD ($A254),HL ; Store the cell as the origin for working out screen
                     ; positions.
 $AB2C CALL $C6DC    ; Work out where the origin is on the screen.
 $AB2F LD HL,$AB6A   ; Point #REGhl at #R$AB6A.
; Draw each scenery sprite that is on the screen.
@label=DrawScenery_Loop
*$AB32 LD A,(HL)     ; Fetch the number of the sprite and its flip flag.
 $AB33 AND A         ; Test whether this is the end of the list.
 $AB34 RET Z         ; Return if it is.
 $AB35 AND %01000000 ; Keep the flip flag.
 $AB37 LD ($A252),A  ; Store the flip flag for the sprite drawing routine.
 $AB3A LD A,(HL)     ; Fetch the number of the sprite again.
 $AB3B AND %00111111 ; Keep the number of the sprite.
 $AB3D INC HL        ; Move on to the horizontal offset.
 $AB3E EX AF,AF'     ; Keep the number of the sprite in the alternate
                     ; accumulator.
 $AB3F LD E,(HL)     ; Fetch the horizontal offset of the sprite.
 $AB40 INC HL        ; Move on to the vertical offset.
 $AB41 LD A,($A24E)  ; Fetch the horizontal position of the origin.
 $AB44 ADD A,E       ; Add the offset to find the horizontal position of the
                     ; sprite.
 $AB45 CP $D0        ; {Jump to #R$AB67 to skip the sprite if it is off the
 $AB47 JR NC,$AB67   ; right edge.}
 $AB49 CP $10        ; {Jump to #R$AB67 to skip the sprite if it is off the
 $AB4B JR C,$AB67    ; left edge.}
 $AB4D LD E,A        ; Copy the horizontal position into #REGe.
 $AB4E LD D,(HL)     ; Fetch the vertical offset of the sprite.
 $AB4F INC HL        ; Move on to the next sprite in the list.
 $AB50 LD A,($A250)  ; Fetch the vertical position of the origin.
 $AB53 ADD A,D       ; Add the offset to find the vertical position of the
                     ; sprite.
 $AB54 AND %01111111 ; Wrap it into the range #N$00 to #N$7F.
 $AB56 ADD A,$40     ; Move it down the screen.
 $AB58 LD D,A        ; Copy the vertical position into #REGd.
 $AB59 EX AF,AF'     ; Retrieve the number of the sprite.
 $AB5A PUSH HL       ; Stash the address in the list on the stack.
 $AB5B LD BC,$686E   ; Point #REGbc at #R$686E.
 $AB5E CALL $C75C    ; Point #REGhl at the sprite.
 $AB61 CALL $C4A7    ; Draw the sprite.
 $AB64 POP HL        ; Retrieve the address in the list.
 $AB65 JR $AB32      ; Go back for the next sprite in the list.
; Skip a sprite that is off the edge.
@label=DrawScenery_Skip
*$AB67 INC HL        ; Skip the vertical offset of the sprite.
 $AB68 JR $AB32      ; Go back for the next sprite in the list.

; Scenery List
;
; The scenery sprites in the town. Each has three bytes: the number of the
; sprite (with bit 6 set if it is flipped), the horizontal offset and the
; vertical offset from the origin. A zero byte ends the list.
@label=SceneryList
b$AB6A DEFB $01,$20,$20
 $AB6D DEFB $41,$90,$60
 $AB70 DEFB $01,$60,$20
 $AB73 DEFB $41,$C0,$30
 $AB76 DEFB $00         ; Terminator.

; Game Selection Menu
;
; Used by the routine at #R$A36D.
; .
; Shows the title screen, which has three revolvers on the left and the
; game name at the top. A bullet shoots out of each revolver and leaves a line
; of text behind it: the number of players, the controls, and "START GAME". Keys
; 1 and 2 change the first two and fire their bullet again, and key 3 starts the
; game. It returns when the bullet for key 3 has been fired.
; #PUSHS #UDGTABLE { #SIM(start=$D4FD,stop=$0000,clear=1,sp=$5E00)
; #SIM(start=$AB77,stop=$ABFB,sp=$5E00)
; #SCR$02(title-screen) } UDGTABLE# #POPS
;
; .
;
; Clear the screen.
@label=GameMenu
c$AB77 XOR A         ; {Write #N$00 to #R$A242 to allow the title tune to play.
 $AB78 LD ($A242),A  ; }
 $AB7B CALL $D6DB    ; Clear the screen.
 $AB7E LD E,$45      ; Set the attribute to #COLOUR$45.
 $AB80 CALL $D6D3    ; Set all the attributes.
 $AB83 LD HL,$8A70   ; Point #REGhl at #R$8A70.
 $AB86 LD ($A20F),HL ; Set the tiles to use.
; Draw the first revolver.
 $AB89 LD HL,$4062   ; Point #REGhl at #N$4062 (in the screen buffer).
 $AB8C LD A,$47      ; Set the attribute to #COLOUR$47.
 $AB8E CALL $ADE3    ; Draw the revolver.
 $AB91 LD BC,$8EB0   ; Point #REGbc at #R$8EB0.
; Draw its digit.
 $AB94 LD HL,$40C7   ; Point #REGhl at #N$40C7 (in the screen buffer).
 $AB97 LD A,$01      ; Set the digit to one.
 $AB99 CALL $D2C9    ; Draw the digit.
; Draw the second revolver.
 $AB9C LD HL,$4842   ; Point #REGhl at #N$4842 (in the screen buffer).
 $AB9F LD A,$46      ; Set the attribute to #COLOUR$46.
 $ABA1 CALL $ADE3    ; Draw the revolver.
 $ABA4 LD BC,$8EB0   ; Point #REGbc at #R$8EB0.
; Draw its digit.
 $ABA7 LD HL,$48A7   ; Point #REGhl at #N$48A7 (in the screen buffer).
 $ABAA LD A,$02      ; Set the digit to two.
 $ABAC CALL $D2C9    ; Draw the digit.
; Draw the third revolver.
 $ABAF LD HL,$5022   ; Point #REGhl at #N$5022 (in the screen buffer).
 $ABB2 LD A,$44      ; Set the attribute to #COLOUR$44.
 $ABB4 CALL $ADE3    ; Draw the revolver.
 $ABB7 LD BC,$8EB0   ; Point #REGbc at #R$8EB0.
; Draw its digit.
 $ABBA LD HL,$5087   ; Point #REGhl at #N$5087 (in the screen buffer).
 $ABBD LD A,$03      ; Set the digit to three.
 $ABBF CALL $D2C9    ; Draw the digit.
; Colour the first column black.
 $ABC2 LD C,$00      ; Set the attribute to #COLOUR$00.
 $ABC4 LD HL,$5800   ; Point #REGhl at #N$5800 (in the attribute buffer).
 $ABC7 CALL $AE8E    ; Colour the column.
; Colour the last column black.
 $ABCA LD HL,$581F   ; Point #REGhl at #N$581F (in the attribute buffer).
 $ABCD CALL $AE8E    ; Colour the column.
; Colour the tenth column red.
 $ABD0 LD C,$42      ; Set the attribute to #COLOUR$42.
 $ABD2 LD HL,$5809   ; Point #REGhl at #N$5809 (in the attribute buffer).
 $ABD5 CALL $AE8E    ; Colour the column.
; Colour the eleventh column red.
 $ABD8 LD HL,$580A   ; Point #REGhl at #N$580A (in the attribute buffer).
 $ABDB CALL $AE8E    ; Colour the column.
; Print the game name.
 $ABDE LD HL,$4006   ; Point #REGhl at #N$4006 (in the screen buffer).
 $ABE1 LD DE,$AC32   ; Point #REGde at #R$AC32.
 $ABE4 CALL $AA9A    ; Print the game name in large letters.
; Print the copyright message.
 $ABE7 LD HL,$50EA   ; Point #REGhl at #N$50EA (in the screen buffer).
 $ABEA LD DE,$AC23   ; Point #REGde at #R$AC23.
 $ABED CALL $D4D7    ; Print the copyright message.
; Set up the four menu entries.
 $ABF0 LD HL,$AC3E   ; Point #REGhl at #R$AC3E.
 $ABF3 LD DE,$AC4E   ; Point #REGde at #R$AC4E.
 $ABF6 LD BC,$0010   ; Set the number of bytes to copy.
 $ABF9 LDIR          ; Copy the entries.
; Run each of the menu entries once per frame.
@label=GameMenu_Loop
*$ABFB LD IX,$AC4E   ; Point #REGix at the first menu entry.
 $ABFF XOR A         ; {Write #N$00 to #R$A20E, the number of the menu entry.
 $AC00 LD ($A20E),A  ; }
@label=GameMenu_Entry
*$AC03 LD A,(IX+$00) ; Fetch the state of the entry.
 $AC06 LD BC,$AC5E   ; Point #REGbc at #R$AC5E.
 $AC09 CALL $C766    ; Run the handler for the state.
 $AC0C LD HL,$A20E   ; Point #REGhl at #R$A20E.
 $AC0F INC (HL)      ; Move on to the next entry.
 $AC10 LD BC,$0004   ; Set the size of an entry.
 $AC13 ADD IX,BC     ; Move on to the next entry.
 $AC15 PUSH IX       ; {Copy #REGix to #REGhl (using the stack).
 $AC17 POP HL        ; }
 $AC18 LD BC,$AC5E   ; Point #REGbc at the end of the entries.
 $AC1B AND A         ; {Subtract the address of the end of the entries.
 $AC1C SBC HL,BC     ; }
 $AC1E JR C,$AC03    ; Loop back until all four entries have been run.
 $AC20 JP $ABFB      ; Start the next frame.

; Messaging: Title Text
;
; The copyright message and the game name. Each is an attribute byte, the
; characters and a zero terminator. The #N$5B in the copyright message is the
; copyright symbol of the font, and the #N$5C bytes are full stops.
@label=TitleTexts
t$AC23 DEFB $47          ; Attribute: #COLOUR(#PEEK(#PC)).
 $AC24 DEFB $5B          ; Copyright symbol.
 $AC25 DEFM " 1985 "     ; " 1985 ".
 $AC2B DEFM "A"          ; "A".
 $AC2C DEFB $5C          ; Full stop.
 $AC2D DEFM "C"          ; "C".
 $AC2E DEFB $5C          ; Full stop.
 $AC2F DEFM "G"          ; "G".
 $AC30 DEFB $5C          ; Full stop.
 $AC31 DEFB $00          ; Terminator.
@label=TitleTexts_GameName
 $AC32 DEFB $45          ; Attribute: #COLOUR(#PEEK(#PC)).
 $AC33 DEFM "GUN FRIGHT" ; "GUN FRIGHT".
 $AC3D DEFB $00          ; Terminator.

; Initial Menu Entries
;
; The initial state of the four menu entries, which is copied to #R$AC4E.
; Each entry has four bytes: its state, the horizontal position of its bullet,
; the vertical position of its bullet and a counter. The first entry reads the
; keys, and the other three are the revolvers.
@label=InitialMenuEntries
b$AC3E DEFB $05,$00,$00,$00 ; Entry for the keys: state #N$05.
 $AC42 DEFB $00,$00,$98,$00 ; Entry for the first revolver.
 $AC46 DEFB $00,$00,$60,$00 ; Entry for the second revolver.
 $AC4A DEFB $00,$00,$28,$00 ; Entry for the third revolver.

; Menu Entries
;
; The state of the four menu entries. Each entry has four bytes: its
; state, the horizontal position of its bullet, the vertical position of its
; bullet and a counter. The states are #N$00 (the revolver has not yet fired),
; #N$01 (the text is complete), #N$02 and #N$03 (the revolver is firing), #N$04
; (the bullet is flying and the text is being typed) and #N$05 (the entry which
; reads the keys).
@label=MenuEntries
g$AC4E DEFB $00,$FC,$20,$1C ; Entry for the keys.
@label=MenuEntries_FirstRevolver
 $AC52 DEFB $08,$00,$00,$70 ; Entry for the first revolver.
@label=MenuEntries_SecondRevolver
 $AC56 DEFB $20,$0E,$04,$10 ; Entry for the second revolver.
@label=MenuEntries_ThirdRevolver
 $AC5A DEFB $00,$E0,$40,$0E ; Entry for the third revolver.

; Menu Handlers
;
; The routine for each state of a menu entry. States #N$00 and #N$01 do
; nothing, states #N$02 and #N$03 use #R$ACE2, state #N$04 uses #R$ACF6 and
; state #N$05 uses #R$AC6A.
@label=MenuHandlers
g$AC5E DEFW $A448
 $AC60 DEFW $A448
 $AC62 DEFW $ACE2
 $AC64 DEFW $ACE2
 $AC66 DEFW $ACF6
 $AC68 DEFW $AC6A

; Handle Menu Keys
;
; The routine for state #N$05 of a menu entry, which is the only entry
; that reads the keys. First it starts each revolver which has not yet fired.
; When all three have finished it plays the title tune and checks keys 1, 2 and
; 3. Key 1 swaps between one and two players and key 2 chooses the next type of
; controls, and both make their revolver fire again so that the new text is
; typed. Key 3 starts the game, and fires the third revolver.
;
; .
;
; Start the next revolver which has not yet fired.
@label=HandleMenuKeys
c$AC6A LD IY,$AC52     ; Point #REGiy at the entry for the first revolver.
 $AC6E LD DE,$0004     ; Set the size of an entry.
 $AC71 LD B,$03        ; Set the number of revolvers to three.
@label=HandleMenuKeys_Loop
*$AC73 LD A,(IY+$00)   ; Fetch the state of the revolver.
 $AC76 AND A           ; {Start the revolver if it has not fired yet.
 $AC77 JR Z,$ACD5      ; }
 $AC79 SUB $02         ; Subtract two from the state.
 $AC7B CP $03          ; {Return if the revolver is firing or its bullet is
 $AC7D RET C           ; flying.}
 $AC7E ADD IY,DE       ; Move on to the next entry.
 $AC80 DJNZ $AC73      ; Loop back until all three revolvers have been checked.
; Play the title tune and read keys 1 to 5.
 $AC82 LD DE,$B0D3     ; Point #REGde at #R$B0D3.
 $AC85 CALL $AF76      ; Play the tune, unless it has already been played or a key is
                       ; pressed.
 $AC88 LD DE,$A21C     ; Point #REGde at #R$A21C.
 $AC8B LD A,$F7        ; Select the keys 1 to 5.
 $AC8D CALL $D0DB      ; Read the keys.
 $AC90 LD C,A          ; Keep the keys in #REGc.
 $AC91 LD HL,$A20B     ; Point #REGhl at #R$A20B.
; Check key 1.
 $AC94 BIT 0,C         ; {Jump to #R$ACB5 if key 1 is pressed.
 $AC96 JR NZ,$ACB5     ; }
 $AC98 LD (HL),$00     ; Note that key 1 is not held down.
@label=HandleMenuKeysKey_2
*$AC9A INC HL          ; Point #REGhl at the flag for key 2 being held down.
; Check key 2.
 $AC9B BIT 1,C         ; {Jump to #R$ACC5 if key 2 is pressed.
 $AC9D JR NZ,$ACC5     ; }
 $AC9F LD (HL),$00     ; Note that key 2 is not held down.
@label=HandleMenuKeysKey_3
*$ACA1 INC HL          ; Move on to the next flag.
; Check key 3.
 $ACA2 BIT 2,C         ; {Return if key 3 is not pressed.
 $ACA4 RET Z           ; }
 $ACA5 LD HL,$A241     ; Point #REGhl at #R$A241.
 $ACA8 INC (HL)        ; Set the flag.
 $ACA9 LD DE,$B0C9     ; Point #REGde at #R$B0C9.
 $ACAC CALL $AF8F      ; Play the tune.
 $ACAF LD IY,$AC5A     ; Point #REGiy at #R$AC5A.
 $ACB3 JR $ACD5        ; Make the revolver fire.
; Key 1 is pressed, so swap between one and two players.
@label=HandleMenuKeys_Key1Pressed
*$ACB5 LD A,(HL)       ; Fetch the flag for key 1.
 $ACB6 AND A           ; Test whether the key was already held down.
 $ACB7 JR NZ,$AC9A     ; Jump to #R$AC9A if it was.
 $ACB9 LD (HL),$01     ; Note that key 1 is held down.
 $ACBB LD IY,$AC52     ; Point #REGiy at #R$AC52.
 $ACBF LD A,(DE)       ; Fetch the options.
 $ACC0 XOR %00000001   ; Flip bit 0 to choose the other number of players.
 $ACC2 LD (DE),A       ; Store the options.
 $ACC3 JR $ACD5        ; Make the revolver fire.
; Key 2 is pressed, so choose the next type of controls.
@label=HandleMenuKeys_Key2Pressed
*$ACC5 LD A,(HL)       ; Fetch the flag for key 2.
 $ACC6 AND A           ; Test whether the key was already held down.
 $ACC7 JR NZ,$ACA1     ; Jump to #R$ACA1 if it was.
 $ACC9 LD (HL),$01     ; Note that key 2 is held down.
 $ACCB LD IY,$AC56     ; Point #REGiy at #R$AC56.
 $ACCF LD A,(DE)       ; Fetch the options.
 $ACD0 ADD A,$02       ; Move on to the next type of controls.
 $ACD2 AND %00000111   ; Keep bits 1 and 2 as the type, and bit 0 as the number of
                       ; players.
 $ACD4 LD (DE),A       ; Store the options.
; Make the revolver fire.
@label=HandleMenuKeys_StartMenuRevolver
*$ACD5 LD (IY+$00),$02 ; Set the state of the revolver to firing.
 $ACD9 LD (IY+$01),$48 ; Set the horizontal position of the bullet.
 $ACDD LD (IY+$03),$00 ; Reset the counter.
 $ACE1 RET             ; Return.

; Handle Menu Revolver Firing
;
; The routine for states #N$02 and #N$03 of a menu entry: a revolver
; firing. It draws the revolver in the state of the entry for twelve frames, and
; then moves on to the next state.
;
; .
;
; Draw the revolver for twelve frames.
@label=HandleMenuRevolverFiring
c$ACE2 CALL $AE10      ; Draw the revolver.
 $ACE5 INC (IX+$03)    ; Add one to the counter.
 $ACE8 LD A,(IX+$03)   ; Fetch the counter.
 $ACEB CP $0C          ; Compare it with twelve.
 $ACED RET NZ          ; Return if the counter has not reached twelve.
; Move on to the next state.
 $ACEE INC (IX+$00)    ; Move on to the next state.
 $ACF1 LD (IX+$03),$00 ; Reset the counter.
 $ACF5 RET             ; Return.

; Handle Menu Bullet
;
; The routine for state #N$04 of a menu entry: a bullet flying across the
; screen. It moves the bullet right two pixels, draws it and makes a click.
; Every eight pixels once it is past the left of the text, it prints the next
; character of the line of text in the bullet's wake. When the bullet reaches
; the edge of the screen the entry goes back to state #N$01. If the game has
; been started, the title screen returns to the caller.
@label=HandleMenuBullet
c$ACF6 LD A,(IX+$01)   ; Fetch the horizontal position of the bullet.
 $ACF9 ADD A,$02       ; Move it two pixels to the right.
 $ACFB LD (IX+$01),A   ; Store the new horizontal position of the bullet.
 $ACFE CP $F8          ; {Jump to #R$AD6F to finish with the bullet if it has reached the
 $AD00 JP NC,$AD6F     ; edge.}
 $AD03 CALL $AE10      ; Draw the bullet.
 $AD06 CALL $AF57      ; Make a click.
 $AD09 LD A,($A20E)    ; Fetch the number of the entry.
 $AD0C DEC A           ; Subtract one.
 $AD0D JR Z,$AD1A      ; Jump to #R$AD1A if this is the first entry.
 $AD0F DEC A           ; Subtract one.
 $AD10 JR Z,$AD61      ; Jump to #R$AD61 if this is the second entry.
; This is the third entry, which always says "START GAME".
 $AD12 LD A,$47        ; Set the attribute to #COLOUR$47.
 $AD14 EX AF,AF'       ; Keep it in the alternate accumulator.
 $AD15 LD HL,$ADD9     ; Point #REGhl at #R$ADD9.
 $AD18 JR $AD28        ; Jump to #R$AD28.
; The first entry says "ONE PLAYER GAME" or "TWO PLAYER GAME".
@label=HandleMenuBullet_Players
*$AD1A LD A,$42        ; Set the attribute to #COLOUR$42.
 $AD1C EX AF,AF'       ; Keep it in the alternate accumulator.
 $AD1D LD A,($A21C)    ; Fetch the options.
 $AD20 AND %00000001   ; Keep the number of players.
 $AD22 LD BC,$AD7B     ; Point #REGbc at #R$AD7B.
@label=HandleMenuBullet_ChooseText
*$AD25 CALL $C75C      ; Point #REGhl at the text.
; Print the next character of the text when the bullet is at the right
; place.
@label=HandleMenuBullet_Print
*$AD28 LD A,(IX+$01)   ; Fetch the horizontal position of the bullet.
 $AD2B SUB $08         ; Move eight pixels to the left to find the position of
                       ; the character.
 $AD2D LD E,A          ; Keep the horizontal position of the character in
                       ; #REGe.
 $AD2E LD A,(IX+$02)   ; Fetch the vertical position of the bullet.
 $AD31 ADD A,$0F       ; Move it up to the top of the text.
 $AD33 LD D,A          ; Keep the vertical position of the text in #REGd.
 $AD34 BIT 7,(IX+$03)  ; Test whether the text is complete.
 $AD38 RET NZ          ; Return if it is.
 $AD39 LD A,E          ; Fetch the horizontal position of the character.
 $AD3A AND %00000110   ; Keep bits 1 and 2.
 $AD3C RET NZ          ; Return unless the character is on a character
                       ; boundary.
 $AD3D LD A,E          ; Fetch the horizontal position of the character.
 $AD3E SUB $58         ; Subtract the position of the start of the text.
 $AD40 RET C           ; Return if the bullet has not yet reached the start of
                       ; the text.
 $AD41 RRCA            ; {Divide the offset by eight.
 $AD42 RRCA            ;
 $AD43 RRCA            ; }
 $AD44 AND %00011111   ; Keep five bits.
 $AD46 CALL $D275      ; Point #REGhl at the character in the text.
 $AD49 EX DE,HL        ; Swap the position of the character into #REGhl and its address into
                       ; #REGde.
 $AD4A CALL $D24F      ; Work out the screen address.
 $AD4D LD A,(DE)       ; Fetch the character.
 $AD4E BIT 7,A         ; {Jump to #R$AD58 unless the character is the last one
 $AD50 JR Z,$AD58      ; of the text.}
 $AD52 AND %01111111   ; Remove the flag from the character.
 $AD54 SET 7,(IX+$03)  ; Note that the text is complete.
@label=HandleMenuBullet_DrawCharacter
*$AD58 CALL $D4EA      ; Convert the character to the number of its tile.
 $AD5B LD BC,$8EA8     ; Point #REGbc at #R$8EA8.
 $AD5E JP $D2C9        ; Jump to #R$D2C9.
; The second entry says which controls are used.
@label=HandleMenuBullet_Controls
*$AD61 LD A,$43        ; Set the attribute to #COLOUR$43.
 $AD63 EX AF,AF'       ; Keep it in the alternate accumulator.
 $AD64 LD A,($A21C)    ; Fetch the options.
 $AD67 RRCA            ; Move the type of controls into bits 0 and 1.
 $AD68 AND %00000011   ; Keep the type of controls.
 $AD6A LD BC,$AD9D     ; Point #REGbc at #R$AD9D.
 $AD6D JR $AD25        ; Choose the text.
; The bullet has reached the edge of the screen.
@label=HandleMenuBullet_Finished
*$AD6F LD (IX+$00),$01 ; Set the state of the entry to complete.
 $AD73 LD A,($A241)    ; Fetch the flag which starts the game.
 $AD76 AND A           ; {Return if the game has not been started.
 $AD77 RET Z           ; }
 $AD78 INC SP          ; {Drop the return address, so that the title screen returns to its
 $AD79 INC SP          ; caller.}
 $AD7A RET             ; Return.

; Number Of Players Texts
;
; The table of texts for the number of players, followed by the texts. Bit
; 7 of the last character of each text is set. The characters with bit 7 set are
; the final #N$45 ("E") of each text.
@label=NumberOfPlayersTexts
g$AD7B DEFW $AD7F                    ; {The addresses of the texts.
 $AD7D DEFW $AD8E                    ; }
 $AD7F DEFM "ONE PLAYER GAM","E"+$80 ; "#STR(#PC)".
 $AD8E DEFM "TWO PLAYER GAM","E"+$80 ; "#STR(#PC)".

; Controls Texts
;
; The table of texts for the type of controls, followed by the texts, and
; then the text of the last menu line. Bit 7 of the last character of each text
; is set.
@label=ControlsTexts
g$AD9D DEFW $ADA5                      ; {The addresses of the texts.
 $AD9F DEFW $ADAD                      ;
 $ADA1 DEFW $ADBE                      ;
 $ADA3 DEFW $ADCD                      ; }
 $ADA5 DEFM "KEYBOAR","D"+$80          ; "#STR(#PC)".
 $ADAD DEFM "KEMPSTON JOYSTIC","K"+$80 ; "#STR(#PC)".
 $ADBE DEFM "CURSOR JOYSTIC","K"+$80   ; "#STR(#PC)".
 $ADCD DEFM "INTERFACE I","I"+$80      ; "#STR(#PC)".
@label=ControlsTexts_StartGame
 $ADD9 DEFM "START GAM","E"+$80        ; "#STR(#PC)".

; Draw Revolver
;
; Used by the routine at #R$AB77.
; .
; Draws a revolver, which is a block of seven by five tiles.
; #PUSHS #UDGTABLE { #SIM(start=$D6DB,stop=$D6EA,clear=1,sp=$5E00)
; #SIM(start=$D6D3,stop=$D6EA,de=$47)
; #SIM(start=$AB83,stop=$AB91)
; #SCR$03,$02,$03,$07,$05(revolver) } UDGTABLE# #POPS
;
; HL The screen address
; A The attribute
@label=DrawRevolver
c$ADE3 EX AF,AF'     ; Keep the attribute in the alternate accumulator.
 $ADE4 LD DE,$ADED   ; Point #REGde at #R$ADED.
 $ADE7 LD BC,$0705   ; Set the width to seven and the height to five.
 $ADEA JP $D595      ; Draw the block of tiles.

; Revolver Tiles
;
; The numbers of the tiles which make up a revolver, in rows of seven. A
; zero is a blank tile.
@label=RevolverTiles
g$ADED DEFB $01,$02,$03,$04,$05,$06,$07
 $ADF4 DEFB $08,$09,$0A,$0B,$0C,$0D,$0E
 $ADFB DEFB $0F,$10,$11,$12,$13,$00,$00
 $AE02 DEFB $14,$15,$16,$17,$00,$00,$00
 $AE09 DEFB $18,$19,$1A,$00,$00,$00,$00

; Draw Menu Sprite
;
; Used by the routines at #R$ACE2 and #R$ACF6.
; .
; Draws the sprite for the state of a menu entry (the gun firing or the
; bullet flying) at the position of the entry. The sprites are sixteen pixels
; wide and are drawn upwards from the bottom row. Each row has two bytes. If the
; horizontal position is not a multiple of eight, the bytes are indexes into the
; shift tables, which are used to shift the sprite across by two, four or six
; pixels. The routine takes the data from the stack to make it faster.
;
; IX The address of the menu entry
;
; Find the sprite and the screen address.
@label=DrawMenuSprite
c$AE10 LD A,(IX+$00) ; Fetch the state of the entry.
 $AE13 LD BC,$6864   ; Point #REGbc at #R$6864.
 $AE16 CALL $C75C    ; Point #REGhl at the sprite.
 $AE19 LD A,(HL)     ; Fetch the number of rows.
 $AE1A INC HL        ; Move on to the data.
 $AE1B EX AF,AF'     ; Keep the number of rows in the alternate accumulator.
 $AE1C EX DE,HL      ; Swap the address of the data into #REGde.
 $AE1D LD A,(IX+$01) ; {Fetch the horizontal position and keep the horizontal position of
 $AE20 LD L,A        ; the sprite in #REGl.}
 $AE21 LD H,(IX+$02) ; Fetch the vertical position into #REGh.
 $AE24 CALL $D24F    ; Work out the screen address.
 $AE27 LD ($A21D),SP ; Save the stack pointer.
 $AE2B EX DE,HL      ; Swap the screen address into #REGde and the address of the data into
                     ; #REGhl.
 $AE2C LD SP,HL      ; Point the stack pointer at the data.
 $AE2D LD A,(IX+$01) ; Fetch the horizontal position.
 $AE30 AND %00000110 ; Keep the pixel offset within the byte.
 $AE32 JR Z,$AE65    ; Jump to #R$AE65 if the sprite is on a byte boundary.
; The sprite is not on a byte boundary, so shift it using the shift
; tables.
 $AE34 OR %11111000  ; Make the offset the high byte of the address of a shift
                     ; table.
 $AE36 LD H,A        ; Point #REGh at the shift table.
 $AE37 EX AF,AF'     ; Fetch the number of rows.
@label=DrawMenuSprite_ShiftedRow
*$AE38 EX AF,AF'     ; Keep the number of rows in the alternate accumulator.
 $AE39 POP BC        ; Fetch the indexes for a row.
 $AE3A LD L,C        ; Copy the first index into #REGl.
 $AE3B LD A,(HL)     ; Fetch the shifted first byte.
 $AE3C LD (DE),A     ; Write it to the screen.
 $AE3D INC E         ; Move to the next byte.
 $AE3E INC H         ; Point #REGh at the overflow table.
 $AE3F LD A,(HL)     ; Fetch the overflow of the first byte.
 $AE40 DEC H         ; Point #REGh back at the shift table.
 $AE41 LD L,B        ; Copy the second index into #REGl.
 $AE42 OR (HL)       ; Combine it with the shifted second byte.
 $AE43 LD (DE),A     ; Write the second byte to the screen.
 $AE44 INC E         ; Move to the next byte.
 $AE45 INC H         ; Point #REGh at the overflow table.
 $AE46 LD A,(HL)     ; Fetch the overflow of the second byte.
 $AE47 DEC H         ; Point #REGh back at the shift table.
 $AE48 LD (DE),A     ; Write it to the screen.
 $AE49 DEC E         ; {Move back to the first byte.
 $AE4A DEC E         ; }
 $AE4B DEC D         ; Move up a pixel row.
 $AE4C LD A,D        ; Fetch the pixel row.
 $AE4D INC A         ; Add one.
 $AE4E AND %00000111 ; Check whether the row is the last in a character cell.
 $AE50 JR NZ,$AE5C   ; Jump to #R$AE5C unless it is.
 $AE52 LD A,E        ; Fetch the low byte of the screen address.
 $AE53 SUB $20       ; Move up a character row.
 $AE55 LD E,A        ; Keep the low byte of the screen address.
 $AE56 JR C,$AE5C    ; Jump to #R$AE5C unless that moves up into the next third of the
                     ; screen.
 $AE58 LD A,D        ; Fetch the high byte of the screen address.
 $AE59 ADD A,$08     ; Move up to the previous third of the screen.
 $AE5B LD D,A        ; Keep the high byte of the screen address.
@label=DrawMenuSprite_ShiftedNext
*$AE5C EX AF,AF'     ; Fetch the number of rows.
 $AE5D DEC A         ; Count it down.
 $AE5E JR NZ,$AE38   ; Loop back until every row has been drawn.
@label=DrawMenuSprite_Done
*$AE60 LD SP,($A21D) ; Restore the stack pointer.
 $AE64 RET           ; Return.
; The sprite is on a byte boundary, so copy the bytes straight to the
; screen.
@label=DrawMenuSprite_Aligned
*$AE65 EX AF,AF'     ; Swap the number of rows into #REGa.
 $AE66 LD B,A        ; Keep the number of rows in #REGb.
 $AE67 EX DE,HL      ; Swap the screen address into #REGhl.
@label=DrawMenuSprite_AlignedRow
*$AE68 POP DE        ; Fetch two bytes.
 $AE69 LD (HL),E     ; Write the first byte to the screen.
 $AE6A INC L         ; Move to the next byte.
 $AE6B LD (HL),D     ; Write the second byte to the screen.
 $AE6C DEC L         ; Move back to the first byte.
 $AE6D DEC H         ; Move up a pixel row.
 $AE6E LD A,H        ; Fetch the pixel row.
 $AE6F INC A         ; Add one.
 $AE70 AND %00000111 ; Check whether the row is the last in a character cell.
 $AE72 JR NZ,$AE7E   ; Jump to #R$AE7E unless it is.
 $AE74 LD A,L        ; Fetch the low byte of the screen address.
 $AE75 SUB $20       ; Move up a character row.
 $AE77 LD L,A        ; Keep the low byte of the screen address.
 $AE78 JR C,$AE7E    ; Jump to #R$AE7E unless that moves up into the next third of the
                     ; screen.
 $AE7A LD A,H        ; Fetch the high byte of the screen address.
 $AE7B ADD A,$08     ; Move up to the previous third of the screen.
 $AE7D LD H,A        ; Keep the high byte of the screen address.
@label=DrawMenuSprite_AlignedNext
*$AE7E DJNZ $AE68    ; Loop back until every row has been drawn.
 $AE80 JR $AE60      ; Jump to #R$AE60.

; Wait For A While
;
; Used by the routines at #R$A50A, #R$A6C9 and #R$BB3A.
; .
; Waits by calling #R$AE88 several times. #REGhl is zero after the first
; call, so every call after the first counts down #N$10000 times.
;
; B The number of delays
; HL The length of the first delay
@label=WaitForAWhile
c$AE82 CALL $AE88    ; Count down.
 $AE85 DJNZ $AE82    ; Loop back until the delays are over.
 $AE87 RET           ; Return.

; Wait
;
; Used by the routines at #R$AE82 and #R$B7A8.
; .
; Waits by counting a register pair down to zero.
;
; HL The count
@label=Wait
c$AE88 DEC HL        ; Subtract one from the count.
 $AE89 LD A,H        ; {Jump to #R$AE88 if the count is not zero.
 $AE8A OR L          ;
 $AE8B JR NZ,$AE88   ; }
 $AE8D RET           ; Return.

; Fill Attribute Column
;
; Used by the routine at #R$AB77.
; .
; Sets the attributes of one column of the screen, which is twenty four
; cells.
;
; C The attribute
; HL The address of the attribute at the top of the column
@label=FillAttributeColumn
c$AE8E LD B,$18      ; Set the number of rows.
 $AE90 LD DE,$0020   ; Set the distance between rows.
@label=FillAttributeColumn_Loop
*$AE93 LD (HL),C     ; Set the attribute of the cell.
 $AE94 ADD HL,DE     ; Move down a row.
 $AE95 DJNZ $AE93    ; Loop back until every row has been done.
 $AE97 RET           ; Return.

; Play Static
;
; Used by the routine at #R$B990.
; .
; Plays a burst of noise by using the first #N$80 bytes of the ROM as the
; length of each pulse.
; .
; #HTML(#AUDIO0(static-sound.wav)(#INCLUDE(StaticSound)))
;
; .
;
; Use the first #N$80 bytes of the ROM as pulse lengths.
@label=PlayStatic
c$AE98 LD HL,$0000   ; Point #REGhl at the start of the ROM.
 $AE9B LD C,$80      ; Set the number of pulses.
; Play each pulse.
@label=PlayStatic_Loop
*$AE9D LD A,(HL)     ; Fetch a byte of the ROM.
 $AE9E INC HL        ; Move on to the next byte.
 $AE9F AND %00111111 ; Keep the bottom six bits.
 $AEA1 LD B,A        ; Use them as the length of the pulse.
 $AEA2 CALL $AF66    ; Play the pulse.
 $AEA5 DEC C         ; Count down the pulses.
 $AEA6 JR NZ,$AE9D   ; Loop back until all of the pulses have been played.
 $AEA8 RET           ; Return.

; Play Sound Effect
;
; Used by the routine at #R$A36D.
; .
; Called every frame. Plays the next note of the sound effect which is in
; progress, if there is one. The effects are started by setting #R$A23C to the
; number of notes and #R$A23D to the address one byte before the notes. The
; notes are played from the last to the first, and each is the length of a
; pulse, so a bigger number is a lower note.
; .
; The sound effects played by this routine are:
; #TABLE(default,centre,centre)
; { =h Effect | =h Sound }
; { Horse Sound |
; #HTML(#AUDIO0(horse-sound.wav)(#INCLUDE(HorseSound))) }
; { Money Bag Sound |
; #HTML(#AUDIO0(money-bag-sound.wav)(#INCLUDE(MoneyBagSound))) }
; { Bag Hit Sound |
; #HTML(#AUDIO0(bag-hit-sound.wav)(#INCLUDE(BagHitSound))) }
; TABLE#
;
; .
;
; Return if there are no notes left.
@label=PlaySoundEffect
c$AEA9 LD HL,$A23C   ; Point #REGhl at the number of notes left.
 $AEAC LD A,(HL)     ; Fetch the number of notes left.
 $AEAD AND A         ; Test whether the effect is over.
 $AEAE RET Z         ; Return if it is.
; Play the next note from the end of the list.
 $AEAF DEC (HL)      ; Count down the notes.
 $AEB0 INC HL        ; Move on to the address of the notes.
 $AEB1 LD E,(HL)     ; Fetch the low byte of the address.
 $AEB2 INC HL        ; Move on to the high byte.
 $AEB3 LD D,(HL)     ; Fetch the high byte of the address.
 $AEB4 EX DE,HL      ; Swap the address into #REGhl.
 $AEB5 CALL $D275    ; Point #REGhl at the note.
 $AEB8 LD A,(HL)     ; Fetch the note.
 $AEB9 LD B,A        ; Use it as the length of a pulse.
 $AEBA LD C,$0C      ; Set the number of pulses.
 $AEBC JP $AF5F      ; Play the note.

; Sound Effect Notes
;
; The notes of the sound effects. The notes of each effect are played from
; the end back to the start. The first byte is not used.
@label=SoundEffectNotes
b$AEBF DEFB $20                         ; Not used.
 $AEC0 DEFB $30,$40,$50,$60,$50,$40,$80 ; The first seven notes for #R$A9BF
                                        ; (the horse).
@label=SoundEffectNotes_BeforeMoneyBag
 $AEC7 DEFB $20                         ; The last note, which is played first.
 $AEC8 DEFB $A0,$30,$90,$40,$80,$50,$60 ; The first seven notes for #R$A4C9
                                        ; (the money bag).
@label=SoundEffectNotes_BeforeBag
 $AECF DEFB $2C                         ; The last note, which is played first.
 $AED0 DEFB $28,$24,$20                 ; The first three notes for #R$C8B8. The fourth note, which is
                                        ; played first, is the first byte of the next routine.

; Play Footstep Sound
;
; Used by the routines at #R$B3DA, #R$B719 and #R$CC97.
; .
; Plays a burst of noise when a walking figure puts a foot down, which is
; when bits 0 and 1 of the flags of the object have both just become set.
; .
; #HTML(#AUDIO0(footstep-sound.wav)(#INCLUDE(FootstepSound)))
;
; A The flags of the object before it was moved
; IX The address of the object
;
; Return unless both walk bits have just become set.
@label=PlayFootstepSound
c$AED3 BIT 0,A        ; Test bit 0 of the old flags.
 $AED5 RET NZ         ; Return if it was already set.
 $AED6 BIT 0,(IX+$07) ; {Return if bit 0 of the flags is not set now.
 $AEDA RET Z          ; }
 $AEDB BIT 1,(IX+$07) ; {Return if bit 1 of the flags is not set now.
 $AEDF RET Z          ; }
; Play a burst of pulses.
 $AEE0 LD C,$10       ; Set the number of pulses.
@label=PlayFootstepSound_Loop
*$AEE2 LD A,C         ; Fetch the number of the pulse.
 $AEE3 XOR %01110110  ; Change it to make a different length for each pulse.
 $AEE5 LD B,A         ; Use it as the length of the pulse.
 $AEE6 CALL $AF66     ; Play the pulse.
 $AEE9 DEC C          ; Count down the pulses.
 $AEEA JR NZ,$AEE2    ; Loop back until all of the pulses have been played.
 $AEEC RET            ; Return.

; Play Movement Sound
;
; Used by the routine at #R$CC97.
; .
; Plays a tone every few frames while a figure is moving, and alternates
; between a high and a low tone. A figure which is going slowly makes the sound
; every fourth frame, and a figure which is going fast every other frame.
; .
; The sounds played by this routine are:
; #TABLE(default,centre,centre)
; { =h Speed | =h Sound }
; { Slow Movement Sound |
; #HTML(#AUDIO0(slow-movement-sound.wav)(#INCLUDE(SlowMovementSound))) }
; { Fast Movement Sound |
; #HTML(#AUDIO0(fast-movement-sound.wav)(#INCLUDE(FastMovementSound))) }
; TABLE#
;
; IX The address of the object
@label=PlayMovementSound
c$AEED LD HL,$A207   ; Point #REGhl at the sound counter.
 $AEF0 INC (HL)      ; Add one to the counter.
 $AEF1 LD A,(IX+$05) ; Fetch the speed of the object.
 $AEF4 CP $0C        ; {Jump to #R$AF0D if the speed is #N$0C or more.
 $AEF6 JR NC,$AF0D   ; }
 $AEF8 LD A,(HL)     ; Fetch the counter.
 $AEF9 BIT 2,A       ; {Jump to #R$AF05 unless bit 2 of the counter is set.
 $AEFB JR Z,$AF05    ; }
 $AEFD AND %00000011 ; {Return unless this is every fourth frame.
 $AEFF RET NZ        ; }
 $AF00 LD BC,$4004   ; Choose the high tone.
 $AF03 JR $AF5F      ; Play it.
; Play the low tone of a slow movement.
@label=PlayMovementSound_Low
*$AF05 AND %00000011 ; {Return unless this is every fourth frame.
 $AF07 RET NZ        ; }
 $AF08 LD BC,$6004   ; Choose the low tone.
 $AF0B JR $AF5F      ; Play it.
; Play a tone every other frame when the object is going fast.
@label=PlayMovementSound_Fast
*$AF0D LD A,(HL)     ; Fetch the counter.
 $AF0E BIT 1,A       ; {Jump to #R$AF1A unless bit 1 of the counter is set.
 $AF10 JR Z,$AF1A    ; }
 $AF12 AND %00000001 ; {Return unless this is every other frame.
 $AF14 RET NZ        ; }
 $AF15 LD BC,$4004   ; Choose the high tone.
 $AF18 JR $AF5F      ; Play it.
; Play the low tone of a fast movement.
@label=PlayMovementSound_FastLow
*$AF1A AND %00000001 ; {Return unless this is every other frame.
 $AF1C RET NZ        ; }
 $AF1D LD BC,$6004   ; Choose the low tone.
 $AF20 JR $AF5F      ; Play it.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$C400 }
; LIST#

; Play Buzz
;
; Used by the routine at #R$C977.
; .
; Plays a short, rough buzz made of twelve pulses of different lengths.
; .
; #HTML(#AUDIO0(buzz-sound.wav)(#INCLUDE(BuzzSound)))
;
; .
;
; Play twelve pulses of different lengths.
@label=PlayBuzz
c$AF22 LD C,$0C      ; Set the number of pulses.
; Play the next pulse.
@label=PlayBuzz_Loop
*$AF24 LD A,C        ; Fetch the number of the pulse.
 $AF25 XOR %10100101 ; Change it.
 $AF27 ADD A,C       ; Add it to the number of the pulse.
 $AF28 LD B,A        ; Use it as the length of the pulse.
 $AF29 CALL $AF66    ; Play the pulse.
 $AF2C DEC C         ; Count down the pulses.
 $AF2D JR NZ,$AF24   ; Loop back until all of the pulses have been played.
 $AF2F RET           ; Return.
; View the equivalent code in;
; #LIST
; { #MARTIANOIDS$C04E }
; { #NIGHTSHADE$C3AA }
; { #PENTAGRAM$D5E4 }
; { #SABREWULF$BF2F }
; LIST#

; Play Rumble
;
; Used by the routine at #R$CA5D.
; .
; Plays sixteen short tones, using the first sixteen bytes of the ROM as
; the length of each.
; .
; #HTML(#AUDIO0(rumble-sound.wav)(#INCLUDE(RumbleSound)))
;
; .
;
; Use the first sixteen bytes of the ROM as tone lengths.
@label=PlayRumble
c$AF30 LD HL,$0000   ; Point #REGhl at the start of the ROM.
 $AF33 LD E,$10      ; Set the number of tones.
; Play each tone.
@label=PlayRumble_Loop
*$AF35 LD A,(HL)     ; Fetch a byte of the ROM.
 $AF36 INC HL        ; Move on to the next byte.
 $AF37 AND %01111111 ; Keep the bottom seven bits.
 $AF39 LD B,A        ; Use them as the length of a pulse.
 $AF3A LD C,$02      ; Set the number of pulses.
 $AF3C CALL $AF5F    ; Play the tone.
 $AF3F DEC E         ; Count down the tones.
 $AF40 JR NZ,$AF35   ; Loop back until all of the tones have been played.
 $AF42 RET           ; Return.

; Play Typing Sound
;
; Used by the routine at #R$A7DA.
; .
; Plays a short, medium tone.
; .
; #HTML(#AUDIO0(typing-sound.wav)(#INCLUDE(TypingSound)))
@label=PlayTypingSound
c$AF43 LD C,$08      ; Set the number of pulses.
 $AF45 LD B,$60      ; Set the length of a pulse.
 $AF47 JR $AF5F      ; Play the tone.

; Play Pause Sound
;
; Used by the routine at #R$D206.
; .
; Plays a longer, low tone.
; .
; #HTML(#AUDIO0(pause-sound.wav)(#INCLUDE(PauseSound)))
@label=PlayPauseSound
c$AF49 LD C,$10      ; Set the number of pulses.
 $AF4B LD B,$80      ; Set the length of a pulse.
 $AF4D JR $AF5F      ; Play the tone.

; Play Short Tone
;
; Used by the routines at #R$A452 and #R$C76C.
; .
; Plays a short tone. The higher the number, the higher the tone.
; .
; The sounds played by this routine are:
; #TABLE(default,centre,centre)
; { =h Effect | =h Sound }
; { Sheriff Entrance Sound |
; #HTML(#AUDIO0(sheriff-entrance-sound.wav)(#INCLUDE(SheriffEntranceSound))) }
; { Dying Sound |
; #HTML(#AUDIO0(dying-sound.wav)(#INCLUDE(DyingSound))) }
; TABLE#
;
; A The number
@label=PlayShortTone
c$AF4F ADD A,A       ; {Multiply the number by four.
 $AF50 ADD A,A       ; }
 $AF51 CPL           ; Invert it.
 $AF52 LD B,A        ; Use it as the length of a pulse.
 $AF53 LD C,$04      ; Set the number of pulses.
 $AF55 JR $AF5F      ; Play the tone.

; Play Bullet Sound
;
; Used by the routine at #R$ACF6.
; .
; Plays a short tone which gets lower as a menu bullet moves to the right.
; .
; #HTML(#AUDIO0(bullet-sound.wav)(#INCLUDE(BulletSound)))
;
; IX The address of the menu entry
@label=PlayBulletSound
c$AF57 LD A,(IX+$01) ; Fetch the horizontal position of the bullet.
 $AF5A SUB $40       ; Subtract #N$40.
 $AF5C LD B,A        ; Use it as the length of a pulse.
 $AF5D LD C,$04      ; Set the number of pulses.
; Continue on to #R$AF5F.

; Play Wave Sequence
;
; Used by the routines at #R$AEA9, #R$AEED, #R$AF30, #R$AF43, #R$AF49 and
; #R$AF4F.
; .
; Plays a tone.
;
; B The length of a pulse
; C The number of pulses
@label=PlayWaveSequence
c$AF5F CALL $AF66    ; Play a pulse.
 $AF62 DEC C         ; Count down the pulses.
 $AF63 JR NZ,$AF5F   ; Loop back until all of the pulses have been played.
 $AF65 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B6FB }
; { #KNIGHTLORE$B4E6 }
; { #MARTIANOIDS$C05B }
; { #PENTAGRAM$D67B }
; LIST#

; Play Square Wave
;
; Used by the routines at #R$AE98, #R$AED3, #R$AF22 and #R$AF5F.
; .
; Plays one pulse, which is a high and a low half of the same length, by
; toggling the speaker. #REGb is unchanged.
;
; B The length of the pulse
;
; Turn the speaker on for the length of the pulse.
@label=PlaySquareWave
c$AF66 LD A,$10      ; Set the speaker bit.
 $AF68 OUT ($FE),A   ; Turn the speaker on.
 $AF6A LD A,B        ; Keep the length of the pulse in #REGa.
@label=PlaySquareWave_FirstDelay
*$AF6B DJNZ $AF6B    ; Wait for the length of the pulse.
 $AF6D LD B,A        ; Restore the length of the pulse.
; Turn the speaker off for the same length.
 $AF6E XOR A         ; Clear the speaker bit.
 $AF6F OUT ($FE),A   ; Turn the speaker off.
 $AF71 LD A,B        ; Keep the length of the pulse in #REGa.
@label=PlaySquareWave_SecondDelay
*$AF72 DJNZ $AF72    ; Wait for the length of the pulse.
 $AF74 LD B,A        ; Restore the length of the pulse.
 $AF75 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B702 }
; { #BUBBLER$9E93 }
; { #CYBERUN$71E0 }
; { #KNIGHTLORE$B4ED }
; { #MARTIANOIDS$C062 }
; { #NIGHTSHADE$C471 }
; { #PENTAGRAM$D682 }
; LIST#

; Play Music Once
;
; Used by the routines at #R$AC6A and #R$B7A8.
; .
; Plays a tune once, and stops early if a key is pressed. After the tune
; has been played, nothing happens until #R$A242 is cleared.
; .
; The tunes played by this routine are:
; #TABLE(default,centre,centre)
; { =h Tune | =h Sound }
; { Title Tune |
; #HTML(#AUDIO0(title-tune.wav)(#INCLUDE(TitleTune))) }
; { Game Over Tune |
; #HTML(#AUDIO0(game-over-tune.wav)(#INCLUDE(GameOverTune))) }
; TABLE#
;
; DE The address of the tune
@label=PlayMusicOnce
c$AF76 LD HL,$A242   ; Point #REGhl at the flag which says whether the tune has been
                     ; played.
 $AF79 LD A,(HL)     ; Fetch the flag.
 $AF7A AND A         ; {Return if the tune has already been played.
 $AF7B RET NZ        ; }
 $AF7C SET 0,(HL)    ; Set the flag.
@label=PlayMusicOnce_Loop
*$AF7E XOR A         ; {Read every row of the keyboard.
 $AF7F CALL $D0DB    ; }
 $AF82 JR Z,$AF85    ; Jump to #R$AF85 if no key is pressed.
 $AF84 RET           ; Return.
; Play the next note.
@label=PlayMusicOnce_NextNote
*$AF85 LD A,(DE)     ; Fetch the next note.
 $AF86 CP $FF        ; {Jump to #R$AF99 if the terminator has been reached.
 $AF88 JR Z,$AF99    ; }
 $AF8A CALL $AF9A    ; Play the note.
 $AF8D JR $AF7E      ; Go back for the next note.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B4A1 }
; { #KNIGHTLORE$B2B6 }
; { #MARTIANOIDS$C0B6 }
; { #NIGHTSHADE$C63D }
; { #PENTAGRAM$D69C }
; LIST#

; Play Music
;
; Used by the routines at #R$A50A, #R$AC6A, #R$B2E9 and #R$BB3A.
; .
; Plays a tune, which is a list of notes ending with #N$FF.
; .
; The tunes played by this routine are:
; #TABLE(default,centre,centre)
; { =h Tune | =h Sound }
; { Start Game Tune |
; #HTML(#AUDIO0(start-game-tune.wav)(#INCLUDE(StartGameTune))) }
; { Reward Tune |
; #HTML(#AUDIO0(reward-tune.wav)(#INCLUDE(RewardTune))) }
; { Outlaw Shot Tune |
; #HTML(#AUDIO0(outlaw-shot-tune.wav)(#INCLUDE(OutlawShotTune))) }
; { Fanfare Tune |
; #HTML(#AUDIO0(fanfare-tune.wav)(#INCLUDE(FanfareTune))) }
; TABLE#
;
; DE The address of the tune
@label=PlayMusic
c$AF8F LD A,(DE)     ; Fetch the next note.
 $AF90 CP $FF        ; {Jump to #R$AF99 if the terminator has been reached.
 $AF92 JR Z,$AF99    ; }
 $AF94 CALL $AF9A    ; Play the note.
 $AF97 JR $AF8F      ; Go back for the next note.
; This entry point is used by the routine at #R$AF76.
@label=PlayMusic_Finish
*$AF99 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B4BA }
; { #BUBBLER$A1C1 }
; { #CYBERUN$9AA9 }
; { #KNIGHTLORE$B2CF }
; { #MARTIANOIDS$C0CF }
; { #NIGHTSHADE$C656 }
; { #PENTAGRAM$D6B5 }
; LIST#

; Play Note
;
; Used by the routines at #R$AF76 and #R$AF8F.
; .
; Plays a note of a tune, or a rest. Bits 0 to 5 of the byte are the
; number of the note (#N$00 is a rest), and bits 6 and 7 are one less than the
; length of the note in beats. The pitch of each note comes from the table at
; #R$AFF2, in which a note has three bytes: the low and high bytes of the length
; of each half of a pulse, and the number of pulses in a beat.
;
;   DE The address of the note
; O:DE The address of the next note
@label=PlayNote
c$AF9A AND %00111111 ; Keep the number of the note.
 $AF9C JR Z,$AFDC    ; Play a rest if there is no note.
; Look up the delays and the number of cycles in the table at #R$AFF2.
 $AF9E LD L,A        ; {Set #REGhl to the note number.
 $AF9F LD H,$00      ; }
 $AFA1 ADD HL,HL     ; Double the number.
 $AFA2 CALL $D275    ; Add the number again to treble it.
 $AFA5 LD BC,$AFF2   ; {Point #REGhl at the entry for the note.
 $AFA8 ADD HL,BC     ; }
 $AFA9 LD B,(HL)     ; Fetch the low byte of the half-period.
 $AFAA INC HL        ; Move on to the high byte.
 $AFAB LD C,(HL)     ; Fetch the high byte of the half-period.
 $AFAC INC HL        ; Move on to the number of pulses in a beat.
 $AFAD LD L,(HL)     ; Fetch the number of pulses in a beat.
 $AFAE LD H,$00      ; Clear #REGh.
; Bits 6 and 7 of the note are the length, less one.
 $AFB0 LD A,(DE)     ; Fetch the note again.
 $AFB1 RLCA          ; {Rotate the length bits into the bottom of the byte.
 $AFB2 RLCA          ; }
 $AFB3 AND %00000011 ; Keep them.
 $AFB5 INC A         ; Add one to get the length in beats.
 $AFB6 PUSH DE       ; Stash the address of the note on the stack.
 $AFB7 LD E,L        ; {Copy the number of pulses into #REGde.
 $AFB8 LD D,H        ; }
; Multiply the number of cycles by the length of the note.
@label=PlayNote_Multiply
*$AFB9 DEC A         ; Count down the beats.
 $AFBA JR Z,$AFBF    ; Finish multiplying when the beats are used up.
 $AFBC ADD HL,DE     ; Add the number of pulses for another beat.
 $AFBD JR $AFB9      ; Go back to count the next beat.
; The number of cycles now matches the length of the note.
@label=PlayNote_MultiplyDone
*$AFBF POP DE        ; Retrieve the address of the note.
; Each pass of this loop makes one cycle of the note, so the length of
; the note is the number of cycles.
@label=PlayNote_Cycle
*$AFC0 PUSH BC       ; Stash the half-period on the stack.
 $AFC1 XOR A         ; Clear the speaker bit.
 $AFC2 OUT ($FE),A   ; Turn the speaker off.
@label=PlayNote_OffDelay
*$AFC4 DJNZ $AFC4    ; Wait for the low half of the pulse.
 $AFC6 DEC C         ; Count down the high byte of the half-period.
 $AFC7 JR NZ,$AFC4   ; Loop back until the low half is over.
 $AFC9 POP BC        ; Retrieve the half-period.
 $AFCA PUSH BC       ; Stash the half-period on the stack again.
 $AFCB LD A,$10      ; Set the speaker bit.
 $AFCD OUT ($FE),A   ; Turn the speaker on.
@label=PlayNote_OnDelay
*$AFCF DJNZ $AFCF    ; Wait for the high half of the pulse.
 $AFD1 DEC C         ; Count down the high byte of the half-period.
 $AFD2 JR NZ,$AFCF   ; Loop back until the high half is over.
 $AFD4 POP BC        ; Retrieve the half-period.
 $AFD5 DEC HL        ; Count down the pulses.
 $AFD6 LD A,H        ; {Jump to #R$AFC0 if any pulses are left.
 $AFD7 OR L          ;
 $AFD8 JR NZ,$AFC0   ; }
 $AFDA INC DE        ; Move on to the next note.
 $AFDB RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B4C5 }
; { #BUBBLER$A1CC }
; { #CYBERUN$9AB4 }
; { #KNIGHTLORE$B2DA }
; { #MARTIANOIDS$C0DA }
; { #NIGHTSHADE$C661 }
; { #PENTAGRAM$D6C0 }
; LIST#

; Play Rest
;
; Used by the routine at #R$AF9A.
; .
; Waits for the length of a rest, which is one to four beats.
;
;   DE The address of the rest
; O:DE The address after the rest
;
; Work out the length of the rest in beats.
@label=PlayRest
c$AFDC LD A,(DE)     ; Fetch the rest.
 $AFDD INC DE        ; Move on to the next note.
 $AFDE RLCA          ; {Rotate the length bits into the bottom of the byte.
 $AFDF RLCA          ; }
 $AFE0 AND %00000011 ; Keep them.
 $AFE2 INC A         ; Add one to get the length in beats.
 $AFE3 LD L,A        ; Copy the length into #REGl.
 $AFE4 LD BC,$430B   ; Set the length of a beat.
; Wait for each beat.
@label=PlayRest_Beat
*$AFE7 PUSH BC       ; Stash the length of a beat on the stack.
@label=PlayRest_Wait
*$AFE8 DEC BC        ; Count down.
 $AFE9 LD A,B        ; {Jump to #R$AFE8 if the count is not zero.
 $AFEA OR C          ;
 $AFEB JR NZ,$AFE8   ; }
 $AFED POP BC        ; Retrieve the length of a beat.
 $AFEE DEC L         ; Count down the beats.
 $AFEF JR NZ,$AFE7   ; Loop back until the rest is over.
 $AFF1 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #BUBBLER$A20F }
; { #MARTIANOIDS$C11C }
; LIST#

