i$5B00

; Decrypt Game
;
; The stub which the tape loader runs once the game has been loaded at
; #N$6000. It decrypts the whole game, #N$8000 bytes, two bytes at a time, and
; then moves the game down by #N$0200 bytes to its real home at #R$5E00 before
; starting it.
; .
; The tape loader sets up this stub, and the game checks for the loader's
; signature in the frame counter (see #R$A36D).
;
; .
;
; Set up the first pair and the number of pairs to decrypt.
@label=DecryptGame
c$5B80 LD DE,$6000   ; Set #REGde to #N($6000), the address of the first byte of the pair
                     ; to decrypt.
 $5B83 LD HL,$6001   ; Set #REGhl to #N($6001), the address of the second byte
                     ; of the pair.
 $5B86 LD BC,$4000   ; Set #REGbc to #N($4000), the number of byte pairs to
                     ; decrypt.
; Start rotating each byte through #REGa to decrypt it.
@label=DecryptGame_Loop
*$5B89 LD A,(DE)     ; Fetch the first byte of the pair.
 $5B8A RLD           ; Rotate the nibbles of the two bytes through #REGa.
 $5B8C LD (DE),A     ; Write the decrypted byte back.
 $5B8D INC DE        ; {Move on to the first byte of the next pair.
 $5B8E INC DE        ; }
 $5B8F INC HL        ; {Move #REGhl onto the second byte of the next pair.
 $5B90 INC HL        ; }
 $5B91 DEC BC        ; Decrease the pair counter by one.
 $5B92 LD A,B        ; {Loop back to #R$5B89 until every pair has been
 $5B93 OR C          ; decrypted.
 $5B94 JR NZ,$5B89   ; }
; Move the decrypted game down to its real address and start it.
 $5B96 LD HL,$6000   ; {Copy #N$8000 bytes of the game from #N$6000 to #R$5E00.
 $5B99 LD DE,$5E00   ;
 $5B9C LD BC,$8000   ;
 $5B9F LDIR          ; }
 $5BA1 JP $5E00      ; Jump to #R$5E00 to start the game.
; View the equivalent code in;
; #LIST
; { #ATICATAC$5B80 }
; { #COOKIE$5B80 }
; { #JETPAC$5B80 }
; { #LUNARJETMAN$5B80 }
; { #NIGHTSHADE$5B80 }
; { #PSSST$5B80 }
; { #TRANZAM$5B80 }
; LIST#

; Unused bytes
u$5BA4 DEFB $00,$00,$00,$00

i$5BA8

; Indirect Jump
;
; Used by the routine at #R$C766.
; .
; Jumps to the address held in #REGhl.
;
; HL The address to jump to
@label=IndirectJump
c$5CB0 JP (HL)       ; Jump to the address held in #REGhl.
; View the equivalent code in;
; #LIST
; { #LUNARJETMAN$5CB0 }
; { #NIGHTSHADE$5CB0 }
; { #PSSST$5CB0 }
; { #SABREWULF$5CB0 }
; { #TRANZAM$5CB0 }
; LIST#

i$5CB1

; Start Game
;
; Used by the routine at #R$5B80.
; .
; The first instruction of the game once it has been moved down into place
; by #R$5B80. Interrupts are disabled for the whole game, which polls the
; keyboard and times everything by the speed of its own code.
@label=GameStart
c$5E00 DI            ; Disable interrupts.
 $5E01 JP $A36D      ; Jump to #R$A36D to start the game.

