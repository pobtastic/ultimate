;
; SkoolKit ref file for Gunfright
;
; To build the HTML disassembly, run these commands:
;   tap2sna.py @gunfright.t2s
;   sna2skool.py -H -c sources/gunfright/gunfright.ctl Gunfright.z80 \
;     > sources/gunfright/gunfright.skool
;   skool2html.py -H sources/gunfright/gunfright.skool -T dark -T wide -toOa

