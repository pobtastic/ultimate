; Control Method
;
; Selected by the menu at #R$BB74. Bits #N$01 and #N$02 hold the control
; method read by #R$BDF8:
; #TABLE(default,centre,centre)
; { =h Value | =h Control Method }
; { #N$00 | Keyboard }
; { #N$01 | Kempston Joystick }
; { #N$02 | Cursor Joystick }
; { #N$03 | Interface II }
; TABLE#
; Bit #N$03 is never set by the menu or by anything else, so the game never
; uses what it would do: it would make the menu flash the line that starts the
; game, make #R$BF66 read the action bit from one place lower, and make
; #R$C4C8 move the player by itself.
@label=ControlMethod
g$A709 DEFB $00

; Menu Pass Counter
;
; Incremented on every pass of the menu loop at #R$BB74.
@label=MenuPassCounter
g$A70A DEFB $00

; Unused
;
; Not referenced by the game.
g$A70B DEFB $00

; Previous Control Method
;
; Copy of #R$A709 taken before the menu keys are read, used to notice a
; change of selection.
@label=PreviousControlMethod
g$A70C DEFB $00

; Random Seed
;
; The game's random number source. It is stirred by every object handler
; and by the menu loop with the Z80 refresh register.
@label=RandomSeed
g$A70D DEFB $00

; Helper Active Flag
;
; Set to #N$01 while the helper creature (object type #N($5A), see
; #R$CFD2) exists, so that only one is created at a time.
@label=HelperActiveFlag
g$A70E DEFB $00

; Pentagram Revealed Flag
;
; Set to #N$01 by #R$D13A once all four of the quest objects have been
; collected (their entries in the object store then have the types #N$74 to
; #N$77); from then on the eight pentagram arcs (object types #N$80 to #N$87)
; are brought into the room by #R$B097.
@label=PentagramRevealedFlag
g$A70F DEFB $00

; Dirty Rectangle Count
;
; Number of screen rectangles queued on the stack by #R$B19E during the
; current redraw.
@label=WipedAreaCount
g$A710 DEFB $00

; Room Redraw Flag
;
; Set to #N$01 when a new room has been built, so that the main loop
; redraws the whole room.
@label=RoomRedrawFlag
g$A711 DEFB $00

; Draw List Pointer
;
; Address of the next entry of the redraw list at #R$B55A, used by
; #R$B19E.
@label=DrawingListPointer
g$A712 DEFW $0000

; Drawing Work Count
;
; Number of objects drawn by #R$B58A in the current frame, plus the
; number of rectangles that #R$B19E then copied to the screen. The main loop
; uses it to pad the frame time.
@label=DrawingWorkCount
g$A714 DEFB $00

; Frame Counter
;
; Counts frames. Bit #N$00 of it is used by the object handlers to
; animate and to alternate behaviour every other frame.
@label=FrameCounter
g$A715 DEFW $0000

; Saved Stack Pointer
;
; Holds the stack pointer while #R$B3D3 reads sprite data with
; #REGsp.
@label=SavedStackPointer
g$A717 DEFW $0000

; Sort Outer Pointer
;
; Position in the draw list of the object being compared by #R$B58A.
@label=FirstListPosition
g$A719 DEFW $0000

; Sort Inner Pointer
;
; Position in the draw list of the object it is being compared with.
@label=SecondListPosition
g$A71B DEFW $0000

; Room Limit X
;
; Distance from the room centre (#N$80) to the wall on the x axis.
@label=RoomSizeX
g$A71D DEFB $00

; Room Limit Y
;
; Distance from the room centre (#N$80) to the wall on the y axis.
@label=RoomSizeY
g$A71E DEFB $00

; Room Floor Height
;
; The height of the floor, below which objects cannot fall.
@label=FloorHeight
g$A71F DEFB $00

; Inventory Redraw Flag
;
; Set to #N$01 when the carried objects change, so that #R$BA34 redraws
; the inventory.
@label=ObjectsCarriedChangedFlag
g$A720 DEFB $00

; Lives
;
; Number of lives the player has left. It starts at #N($05), is lowered
; by #R$C2EC each time the player is sent back to the start and is raised by
; #R$CF68.
@label=Lives
g$A721 DEFB $00

; Inventory
;
; The objects the player is carrying: four entries of four bytes. Each
; holds the object type, the object flags and the address of the object's
; entry in the persistent object store at #R$D432. The first entry is only
; used while an object is being picked up or dropped, and is empty the rest of
; the time. The other three are the objects that are carried, and are the
; ones that #R$BA3D shows. A new object goes into the second entry; the older
; ones move along when it is picked up, and the one in the last entry is
; the one that #R$BF79 drops.
@label=ObjectsCarried
g$A722 DEFB $00,$00,$00,$00 ; The object that has just been picked up or
                            ; dropped.
@label=ObjectsCarried_Newest
 $A726 DEFB $00,$00,$00,$00 ; The object that has been carried for the least
                            ; time.
 $A72A DEFB $00,$00,$00     ; The first three bytes of the object that has been carried for a
                            ; time between the others.
@label=ObjectsCarried_MiddleEnd
 $A72D DEFB $00             ; The last byte of the object that has been carried for a time
                            ; between the others.
@label=ObjectsCarried_Oldest
 $A72E DEFB $00,$00,$00     ; The first three bytes of the object that has been carried for
                            ; the longest time.
@label=ObjectsCarried_OldestEnd
 $A731 DEFB $00             ; The last byte of the object that has been carried for the
                            ; longest time.

; Font Pointer
;
; Address of the glyph table used by #R$BAEA.
@label=FontPointer
g$A732 DEFW $0000

; Frame Drawn Flag
;
; Set to #N$01 once the frame around the menu or end screen has been
; drawn.
@label=BorderDrawnFlag
g$A734 DEFB $00

; Unused
;
; Loaded into #REGhl by #R$BBBF but otherwise not used.
@label=UnusedValue
g$A735 DEFB $00

; Text Colour
;
; The attribute used for text printed by #R$BC66 and #R$BC7A.
@label=TextAttribute
g$A736 DEFB $00

; Controls
;
; The state of the controls, written by #R$BDF8 and read by the player
; handlers.
; #TABLE(default,centre,centre)
; { =h Bit | =h Meaning }
; { #N$00 | Turn left }
; { #N$01 | Turn right }
; { #N$02 | Walk forward }
; { #N$03 | Jump }
; { #N$04 | Pick up or drop }
; { #N$06 | Fire }
; TABLE#
@label=ControlsPressed
g$A737 DEFB $00

; Room Colour
;
; The colour of the room: the ink colour from the room data with the
; bright bit set, set by #R$C92C.
@label=RoomAttribute
g$A738 DEFB $00

; Previous Vertical Speed
;
; The vertical speed of the player from the last frame; it tells
; #R$C61D if the player landed from a fall.
@label=PreviousVerticalSpeed
g$A739 DEFB $00

; Template Table Pointer
;
; Address of the table of template addresses that #R$C92C uses while it
; builds a room. It starts at #R$6CE5 and can be moved on to the second half
; of the table at #R$6D23 by a group in the room data, though none do.
@label=TemplateTablePointer
g$A73A DEFW $0000

; Cell Offset
;
; Offset that #R$C92C adds to the positions of the scenery objects as it
; builds a room: bit 0 adds #N$08 to x and bit 1 adds #N$08 to y, and the whole
; value is added to z. It is always zero.
@label=CellOffset
g$A73C DEFB $00

; Spawn Timer
;
; Countdown to the next random creature, see #R$CBAB.
@label=SpawnTimer
g$A73D DEFB $00

; Saved Stack Pointer Copy
;
; Written by #R$AFDD with the stack pointer but never read.
g$A73E DEFW $0000

; Action Key Held Flag
;
; Set while the pick up or drop key is being held, so that one press
; only does one thing.
@label=PickupDropPressedFlag
g$A740 DEFB $00

; No Room To Drop Flag
;
; Set when there is no free space above the player to drop an object.
@label=NoRoomToDropFlag
g$A741 DEFB $00

; Special Object Flag
;
; Set by #R$CB89 when the room holds an object of one of the types
; #N$70 to #N$78 or #N$80 to #N$87; #R$CBAB then makes no random creatures.
@label=SpecialObjectFlag
g$A742 DEFB $00

; Fire Key Held Flag
;
; Set while the fire key is being held, so that one press fires once.
@label=FireKeyHeldFlag
g$A743 DEFB $00

; Score
;
; The score as six binary coded decimal digits, most significant byte
; first.
@label=Score
g$A744 DEFB $00,$00  ; The four most significant digits.
@label=Score_LastByte
 $A746 DEFB $00      ; The two least significant digits.

; Menu Tune Flag
;
; Set when the tune of the menu has been started, so that it is played
; only once, see #R$D69C.
@label=TunePlayedFlag
g$A747 DEFB $00

; Footstep Counter
;
; Counts steps of the player to alternate the two footstep sounds.
@label=FootstepCounter
g$A748 DEFB $00

; Sound Effect Counter
;
; Number of frames left of the current sound effect, see #R$D5F2.
@label=SoundEffectCounter
g$A749 DEFB $00

; Sound Effect Type
;
; Selects the pitch sequence used by #R$D5F2.
@label=SoundEffectType
g$A74A DEFB $00

; Pentagram Stones Placed
;
; Number of the five pentagram stones that have reached their places on
; the pentagram. The game is won when it reaches #N$05.
@label=PentagramStonesPlaced
g$A74B DEFB $00

; Objects Collected
;
; Number of the four objects that have been collected, see #R$CF68.
@label=ObjectsCollected
g$A74C DEFB $00

; Quest Percentage
;
; The percentage of the quest completed as binary coded decimal, shown
; on the end screen by #R$C6EA.
@label=PercentComplete
g$A74D DEFW $0000

; Visited Rooms
;
; One bit for each of the #N$100 possible rooms, set by #R$C6CC when
; the player enters the room.
@label=RoomsVisitedBitmap
g$A74F DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $A757 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $A75F DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $A767 DEFB $00,$00,$00,$00,$00,$00,$00,$00

; Object Table
;
; The #N$36 object records of the game, each #N$20 bytes long. A record
; whose type byte is #N$00 is free. The first two records hold the two halves
; of the player (see #R$A76F and #R$A78F); the rest hold the scenery,
; creatures and items of the current room, which #R$C92C fills from the last
; record downwards. The fields of a record are:
; #TABLE(default,centre,centre)
; { =h Offset | =h Contents }
; { #N$00 | Object type; indexes the sprite table at #R$6DD7 and the handler
; table at #R$AE2F }
; { #N$01 | Position on the x axis (the centre of the object) }
; { #N$02 | Position on the y axis (the centre of the object) }
; { #N$03 | Height above the floor (the bottom of the object) }
; { #N$04 | Half the size on the x axis }
; { #N$05 | Half the size on the y axis }
; { #N$06 | Size on the z axis }
; { #N$07 | Flags, see below }
; { #N$08 | Room the object belongs to (or the room a door leads to) }
; { #N$09 | Speed on the x axis }
; { #N$0A | Speed on the y axis }
; { #N$0B | Speed on the z axis }
; { #N$0C | Collision flags: bit #N$00 is set when the object hit
; something on the x axis, bit #N$01 on the y axis and bit #N$02 on the z
; axis (it is on the ground); bit #N$03 is set while it is jumping; the upper
; four bits count down the frames after entering a room }
; { #N$0D | Collision state flags used by the handlers }
; { #N$0E | Push from other objects on the x axis }
; { #N$0F | Push from other objects on the y axis }
; { #N$10 | Low byte of the address of the entry in the object store at
; #R$D432, or handler workspace }
; { #N$11 | High byte of the address of the entry in the object store }
; { #N$12 | Offset on the x axis from the projected position to the sprite }
; { #N$13 | Offset on the y axis from the projected position to the sprite }
; { #N$14 to #N$16 | Handler workspace }
; { #N$17 | Handler flags }
; { #N$18 | Width in bytes of the sprite last drawn }
; { #N$19 | Height of the sprite last drawn }
; { #N$1A | Screen x position of the sprite last drawn }
; { #N$1B | Screen y position of the sprite last drawn, counted from the
; bottom of the screen }
; { #N$1C to #N$1F | Copy of #N$18 to #N$1B from the previous frame }
; TABLE#
; The flags in byte #N$07 are:
; #TABLE(default,centre,centre)
; { =h Bit | =h Meaning }
; { #N$00 | Ignore the walls of the room }
; { #N$01 | The object is being moved, so it is ignored by the collision
; tests }
; { #N$02 | The object can be pushed }
; { #N$03 | The object can open doors (the player) }
; { #N$04 | The object needs drawing }
; { #N$05 | The object has moved and its old area needs restoring }
; { #N$06 | Mirror the sprite from left to right }
; { #N$07 | Flip the sprite upside down }
; TABLE#
@label=ObjectsTable
g$A76F DEFB $00,$00,$00,$00,$00,$00,$00                                                                                                     ; The first
                                                                                                                                            ; seven
                                                                                                                                            ; bytes of
                                                                                                                                            ; the legs
                                                                                                                                            ; of the
                                                                                                                                            ; player.
@label=ObjectsTable_Flags
 $A776 DEFB $00                                                                                                                             ; The flags
                                                                                                                                            ; of the
