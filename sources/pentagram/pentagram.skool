i$5B00

; Game Entry Point
;
; The entry point of the game, called by the loader once the code has
; been loaded.
@label=GameEntry
c$5E00 DI            ; Disable interrupts.
 $5E01 LD SP,$5E00   ; Set the stack pointer to #R$5E00, so the stack grows downwards from
                     ; the start of the game code.
 $5E04 JP $AF87      ; Jump to #R$AF87.

; Room Sizes
;
; The three sizes that a room can have, which are picked by the room data
; (see #R$C92C). Each is the distance from the centre of the room to its walls
; along x, then along y, and then the height of the floor.
@label=RoomSizeTable
b$5E07 DEFB $40,$40,$80 ; Size #N$00: the walls are #N$40 from the centre along x and
                        ; #N$40 along y, and the floor is at #N$80.
 $5E0A DEFB $20,$40,$80 ; Size #N$01: the walls are #N$20 from the centre along x and
                        ; #N$40 along y, and the floor is at #N$80.
 $5E0D DEFB $40,$20,$80 ; Size #N$02: the walls are #N$40 from the centre along x and
                        ; #N$20 along y, and the floor is at #N$80.

; Room Data
;
; The records of the rooms of the game, which #R$C92C reads when it builds
; a room. A record has the number of the room, a length byte, a byte for the ink
; colour and size of the room, and then the features of the room, which are
; pairs of a feature number and a parameter, ended by #N$FF. Any groups of
; templates come after that, each a byte and the cells that follow it. A room
; can end before the #N($FF), when it has no groups of templates.
@label=Room_00
b$5E10 DEFB $00,$1E,$07                         ; Room #N($00), which has white ink and size #N($00), and is #N$1E
                                                ; bytes long.
 $5E13 DEFB $18,$93                             ; Feature #N($18), the raised stone door and its frame in the wall
                                                ; at the high end of y, which leads to #R$692C.
 $5E15 DEFB $1C,$00                             ; Feature #N($1C), the slabs outside the raised door at the high
                                                ; end of y.
 $5E17 DEFB $0C,$00                             ; Feature #N($0C), a stone wall
                                                ; along the low end of x.
 $5E19 DEFB $0D,$00                             ; Feature #N($0D), a stone wall
                                                ; along the high end of y.
 $5E1B DEFB $FF                                 ; The end of the features.
 $5E1C DEFB $01,$FD,$FE                         ; Template #N$00 (stone slab),
                                                ; in 2 cells.
 $5E1F DEFB $BD,$5A,$75,$B5,$F5,$35,$1A         ; Template #N$17 (cube), in 6
                                                ; cells.
 $5E26 DEFB $1D,$2E,$25,$1E,$1C,$15,$33         ; Template #N$03 (stalactites),
                                                ; in 6 cells.
