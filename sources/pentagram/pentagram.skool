; Object Handler Table
;
; One address for each of the #N$AC object types: the routine that
; #R$AF87 calls for every object of that type once a frame, with
; #REGix pointing at the object record. Each handler ends by returning to
; #R$B00C. The types are also the index into the table of sprites at
; #R$6DD7.
@label=ObjectHandlerTable
w$AE2F DEFW $C43F    ; Type #N$00: a free object, which does nothing, run by
                     ; #R$C43F.
 $AE31 DEFW $C43F    ; Type #N$01: a marker that something has to be erased, run by
                     ; #R$C43F.
 $AE33 DEFW $C43F    ; {Types #N$02 to #N$05: the pieces of the frame of the menu, which
 $AE35 DEFW $C43F    ; are never made into objects, run by #R$C43F.
 $AE37 DEFW $C43F    ;
 $AE39 DEFW $C43F    ; }
 $AE3B DEFW $C7AD    ; Type #N$06: a root door, run by #R$C7AD.
 $AE3D DEFW $C789    ; Type #N$07: a root door frame, run by #R$C789.
 $AE3F DEFW $C7AD    ; Type #N$08: a stone door, run by #R$C7AD.
 $AE41 DEFW $C789    ; Type #N$09: a stone door frame, run by #R$C789.
 $AE43 DEFW $CB4E    ; Type #N$0A: a round pedestal, run by #R$CB4E.
 $AE45 DEFW $CB4E    ; Type #N$0B: a stone slab, run by #R$CB4E.
 $AE47 DEFW $C784    ; {Types #N$0C to #N$0F: the pieces of a wall of roots, run by
 $AE49 DEFW $C784    ; #R$C784.
 $AE4B DEFW $C784    ;
 $AE4D DEFW $C784    ; }
 $AE4F DEFW $D1F5    ; {Types #N$10 to #N$11: a spark that flickers, run by
 $AE51 DEFW $D1F5    ; #R$D1F5.}
 $AE53 DEFW $C43F    ; {Types #N$12 to #N$16: pictures of the player, which are not made
 $AE55 DEFW $C43F    ; into objects, run by #R$C43F.
 $AE57 DEFW $C43F    ;
