;
; SkoolKit ref file for Pentagram
;
; To build the HTML disassembly, run these commands:
;   tap2sna.py @pentagram.t2s
;   sna2skool.py -H -c sources/pentagram/pentagram.ctl Pentagram.z80 \
;     > sources/pentagram/pentagram.skool
;   skool2html.py -H sources/pentagram/pentagram.skool -T dark -T wide -toOa

