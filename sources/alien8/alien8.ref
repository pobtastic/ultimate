;
; SkoolKit ref file for Alien 8
;
; To build the HTML disassembly, run these commands:
;   tap2sna.py @alien8.t2s
;   sna2skool.py -H -c sources/alien8/alien8.ctl Alien8.z80 \
;     > sources/alien8/alien8.skool
;   skool2html.py -H sources/alien8/alien8.skool -T dark -T wide -toOa

