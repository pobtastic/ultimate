; Random Seed 1
;
; The first random number seed. It is set from the low byte of
; #SKOOLKID$5C78(FRAMES) when the game is loaded, goes up by one every time
; the menu is redrawn, and is used to choose where the special objects are
; placed and where the player starts.
@label=RandomSeed1
g$5B00 DEFB $00

; Unused
;
; This byte is never used.
u$5B01 DEFB $00

; Frame Counter
;
; Counts the frames of the game, which also makes it an address that moves
; through the ROM, so that the byte found there is added into #R$5B05 to stir it
; up. The low byte times the animations and the sound effects and is used as a
; source of random numbers.
@label=FrameCounter
g$5B02 DEFW $0000

; Control Method
;
; The control method chosen in the menu.
; #TABLE(default,centre,left)
; { =h Bits | =h Meaning }
; { #N$01-#N$02 | #N$00 keyboard, #N$01 Kempston,
; #N$02 cursor, #N$03 Interface II }
; { #N$03 | Set when directional control is on }
; TABLE#
@label=ControlMethod
g$5B04 DEFB $00

; Random Seed 2
;
; The second random number seed, which is the one the game normally asks
; for when it needs a random number. It is stirred up once on every pass of the
; main loop.
@label=RandomSeed2
g$5B05 DEFB $00

; Previous Control Method
;
; The value of #R$5B04 when the menu was last scanned, used to make a
; sound when the selection changes.
@label=PreviousControlMethod
g$5B06 DEFB $00

; Unused
;
; This byte is never used.
u$5B07 DEFB $00

; Wiped Area Count
;
; The number of regions of the screen buffer which have been wiped by
; #R$CEAB and are waiting on the stack to be copied to the screen. This is the
; first of the variables which are cleared at the start of every game.
@label=WipedAreaCount
g$5B08 DEFB $00

; Saved Stack Pointer
;
; The stack pointer, saved while #R$D027 uses it to read the sprite data.
@label=SavedStackPointer
g$5B09 DEFW $0000

; Room Size X
;
; The distance from the middle of the current room to its east and west
; walls.
@label=RoomSize_X
g$5B0B DEFB $00

; Room Size Y
;
; The distance from the middle of the current room to its north and south
; walls.
@label=RoomSize_Y
g$5B0C DEFB $00

; Room Colour
;
; The colour of the current room (an ink colour from #N$00 to #N$07),
; which is used for the whole of the attribute file.
@label=RoomColour
g$5B0D DEFB $00

; Floor Height
;
; The level of the floor of the current room: an object which would sink
; below this height lands on the floor instead.
@label=FloorHeight
g$5B0E DEFB $00

; Unused
;
; These bytes are never used.
u$5B0F DEFB $00,$00,$00

; Room Flags
;
; Bit 0 is set on every pass of the main loop and is cleared again when
; the objects of the room have been saved to the special objects table by
; #R$AF05. It is clear at the start of a game so that nothing is saved before
; the first room has been built.
@label=RoomFlags
g$5B12 DEFB $00

; Pickup Drop Pressed Flag
;
; Set while the pick up and drop key is held down, so that an object is
; only picked up or dropped once for each press.
@label=PickupDropPressedFlag
g$5B13 DEFB $00

; Objects Carried Changed Flag
;
; Set when the player picks up or drops an object, to say that the carried
; objects shown in the panel have to be redrawn.
@label=ObjectsCarriedChangedFlag
g$5B14 DEFB $00

; Controls Pressed
;
; The directions and actions chosen by
; the player on this pass, as read by #R$C8FF.
; #TABLE(default,centre,left)
; { =h Bit | =h Control }
; { #N$00 | Left }
; { #N$01 | Right }
; { #N$02 | Forward }
; { #N$03 | Jump }
; { #N$04 | Pick up or drop }
; { #N$05 | Set by #R$C9EE }
; TABLE#
@label=ControlsPressed
g$5B15 DEFB $00

; Text Attribute
;
; The attribute used when printing text.
@label=TextAttribute
g$5B16 DEFB $00

; Redraw Panel Flag
;
; Set when a new room has been built, or an ending scene is being shown,
; to say that the status panel and the colours have to be redrawn on this pass
; of the main loop.
@label=RedrawPanelFlag
g$5B17 DEFB $00

; Border Drawn Flag
;
; Set by #R$BC31 once it has printed the border, so that the border is
; only drawn the first time that a list of text is displayed. It is cleared by
; the menu (#R$BA7E) and by the game completed scene (#R$B8A9).
@label=BorderDrawnFlag
g$5B18 DEFB $00

; Position Offset
;
; The offset applied to the positions of the objects as #R$CCA7 builds a
; room, set by the objects of type #N$00 in the data for the room (see #R$6469).
; Bit 0 moves the objects half a place along the x axis, bit 1 half a place
; along the y axis, and bits 2 to 7 up the z axis.
@label=PositionOffset
g$5B19 DEFB $00

; Lives
;
; The number of lives the player has left (as a BCD number).
@label=Lives
g$5B1A DEFB $00

; Saved Position
;
; A copy of the x, y and z coordinates of a block, which #R$B2D9 saves and
; #R$B2EB compares with the current position to find out whether the block has
; moved.
@label=SavedPosition
g$5B1B DEFB $00,$00,$00

; Objects Drawn
;
; The number of objects drawn on this pass of the main loop. It is used to
; slow the game down when there are only a few objects.
@label=ObjectsDrawn
g$5B1E DEFB $00

; Unused
;
; This byte is never used.
u$5B1F DEFB $00

; Object Type Table Address
;
; While a room is built by #R$CCA7 this word holds the address of the
; table of object types that is in use: #R$73C8 at first, and #R$7408 once an
; object of type #N$1F has been met in the data for the room. Its high byte is
; also used by #R$C296 to hold the vertical speed of the player before it was
; adjusted by the collision routines.
@label=ObjectTypeTableAddress
g$5B20 DEFB $00      ; The low byte of the address.
@label=PreviousVerticalSpeed
 $5B21 DEFB $00      ; The high byte of the address, or the previous vertical
                     ; speed.

; Unused
;
; This byte is never used.
u$5B22 DEFB $00

; Game Completed Flag
;
; Set when all of the cryogenic chambers have been activated.
@label=GameCompletedFlag
g$5B23 DEFB $00

; Game Over Flag
;
; Set when the scene for the end of the game is about to be shown (see
; #R$B761), and not cleared again until the game restarts. While it is set the
; pixel positions of the objects are left as the scene set them (#R$CFD2), no
; controls are read (#R$C8FF) and the main loop only refreshes the screen when
; the panel needs to be redrawn (#R$A6F7).
@label=GameOverFlag
g$5B24 DEFB $00

; Block Scratch
;
; The height (Z coordinate) up to which a block that is being moved by
; #R$B31F or #R$B33F rises after it has been pushed down. It is set from the
; block that is handled first while it is zero (#R$B31F adds #N$30 to the height
; of its block) and it is cleared when a room is built. The use of the height is
; inferred from #R$B38C, where the rising stops once a block is higher than it.
@label=BlockScratch
g$5B25 DEFB $00

; Unused
;
; This byte is never used.
u$5B26 DEFB $00

; Font Pointer
;
; The address of the font used by #R$BBEB when printing text.
@label=FontPointer
g$5B27 DEFW $0000

; Unused
;
; These bytes are never used.
u$5B29 DEFB $00,$00

; Drawing List Pointer
;
; The address of the next entry in the list of objects to draw, which
; #R$CEAB and #R$C78D step through.
@label=DrawingListPointer
g$5B2B DEFW $0000

; First List Position
;
; The address in the list at #R$C745 just after the entry of the first
; object of the pair that #R$C78D is comparing (the object at #REGix). When that
; object is drawn, #R$C8D5 uses this address to flag its entry as drawn.
@label=FirstListPosition
g$5B2D DEFW $0000

; Second List Position
;
; The address in the list at #R$C745 just after the entry of the other
; object of the pair that #R$C78D is comparing (the object at #REGiy). If that
; object has to be drawn first, #R$C86F copies this address to #R$5B2D.
@label=SecondListPosition
g$5B2F DEFW $0000

; Tune Played Flag
;
; Set to one when the menu tune has been played, so that it is only played
; once (see #R$B4A1).
@label=TunePlayedFlag
g$5B31 DEFB $00

; Directional Key Pressed Flag
;
; Bit 0 is set while the key for directional control is held down in the
; menu, so that the setting is only switched once for each press.
@label=DirectionalKeyPressedFlag
g$5B32 DEFB $00

; No Room To Drop Flag
;
; Set when the player is not allowed to drop an object where they are
; standing.
@label=NoRoomToDropFlag
g$5B33 DEFB $00

; Chamber Address
;
; The address, in the data for the rooms, of the chamber in the current
; room. When a chamber is activated #R$AF79 sets the three lowest bits of the
; byte at this address to show that the chamber has been used.
@label=ChamberAddress
g$5B34 DEFW $0000

; Light Years Remaining
;
; The four digits of the light years remaining counter. Each byte holds a
; digit in its upper four bits and in its lower three bits the stage of the
; rolling animation that is used when the digit changes (see #R$ADC9). The game
; is over when all four digits are zero.
@label=LightYearsRemaining
g$5B36 DEFB $00,$00  ; Upper two digits.
 $5B38 DEFB $00      ; Third digit.
@label=LightYearsRemaining_LastDigit
 $5B39 DEFB $00      ; Last digit.

; Egg Top Flag
;
; Set while an egg top (object #N$49) is falling, so that only one of them
; falls at a time.
@label=EggTopFlag
g$5B3A DEFB $00

; Egg Top Disabled Flag
;
; Set when a room is built if the room number is even, and cleared when
; the player picks up an object or an extra life. While it is set the egg top
; (object #N$49) does not move.
@label=EggTopDisabledFlag
g$5B3B DEFB $00

; Cryonauts Lost
;
; The number of cryonauts who will be lost, as a four digit BCD number.
; #R$AC6B counts the cryonauts in the chambers which have not been activated,
; for the game over display.
@label=CryonautsLost
g$5B3C DEFB $00      ; Upper two digits.
@label=CryonautsLost_LowerDigits
 $5B3D DEFB $00      ; Lower two digits.

; Chambers Found Activated
;
; The number of chambers found to be activated by #R$AC6B, as a BCD
; number.
@label=ChambersFoundActivated
g$5B3E DEFB $00

; Chambers Not Activated
;
; The number of chambers found not to be activated by #R$AC6B, as a BCD
; number.
@label=ChambersNotActivated
g$5B3F DEFB $00

; Chambers Activated
;
; The number of cryogenic chambers that the player has activated so far,
; as a BCD number. The game is completed when it reaches #N$24.
@label=ChambersActivated
g$5B40 DEFB $00

; Game Over Scene Stage
;
; Zero until the alarm in the game over scene has flashed #N$10 times (see
; #R$ABF5). Then it is set to #N($01), and is used by the objects which
; attack the robot: bit 7 is set while one of them is moving, and the
; lower bits count the attacks that have been made. The game restarts when
; the count reaches #N$10.
@label=GameOverSceneStage
g$5B41 DEFB $00

; Remote Control Command
;
; The command sent to the remote control robot by the pads in the room:
; #N$01 to stop, or #N$02 to #N$05 to go west, north, east or south. Bit 7 is
; set while a robot is listening for commands (see #R$A9C7).
@label=RemoteControlCommand
g$5B42 DEFB $00

; Land Mine Flag
;
; Set while one of the land mines is leaping, so that only one of them
; leaps at a time (see #R$A8F9).
@label=LandMineFlag
g$5B43 DEFB $00

; Unused
;
; These bytes are never used.
u$5B44 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5B4C DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5B54 DEFB $00,$00,$00,$00

; Rooms Visited Bitmap
;
; One bit for each of the #N$0100 rooms, set when the player has been into
; the room. They are counted for the game over display.
@label=RoomsVisitedBitmap
g$5B58 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5B60 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5B68 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5B70 DEFB $00,$00,$00,$00,$00,$00,$00,$00

; Objects Carried Header
;
; The record of the object that was picked up last, with the same layout
; as the entries that follow (see #R$5B7C). It is written by #R$BE76 from the
; object number, the flags and the two bytes at offsets #N$10 and #N$11 of the
; record of the object that has been picked up (the byte which they address is
; cleared), and it is cleared by #R$BE6B. Why the record is kept here is not yet
; known.
@label=ObjectsCarriedHeader
g$5B78 DEFB $00,$00,$00,$00

; Objects Carried
;
; The objects that the player is carrying. There is room for three, each
; using four bytes: the first byte of each is the number of the object (or zero
; for an empty space), the second is its flags and the other two are an address
; that was held in the record of the object. The status panel shows the objects
; by drawing their sprites.
@label=ObjectsCarried
g$5B7C DEFB $00,$00,$00,$00 ; The first object.
@label=ObjectsCarried_Second
 $5B80 DEFB $00,$00,$00     ; The second object.
@label=ObjectsCarried_SecondEnd
 $5B83 DEFB $00             ; The last byte of the second object.
@label=ObjectsCarried_Third
 $5B84 DEFB $00,$00,$00     ; The third object.
@label=ObjectsCarried_ThirdEnd
 $5B87 DEFB $00             ; The last byte of the third object.

; Player Bottom Object
;
; The object for the lower half of the robot. Every object in the game is
; held in a block of #N$20 bytes: byte #N$00 is the number of the sprite (zero
; if the slot is unused), #N$01 to #N$03 are the x, y and z coordinates, #N$04
; to #N$06 the width, depth and height, #N$07 the flags, #N$09 to #N$0B the
; speeds along each axis, #N$0C and #N$0D more flags, #N$10 and #N$11 are for
; use by the update routine of the object, #N$12 and #N$13 are the pixel offsets
; of the sprite and #N$18 to #N$1B are the size and position of the sprite on
; the screen.
@label=PlayerBottomObject
g$5B88 DEFB $00                             ; Number of the sprite.
@label=PlayerBottomObject_X
 $5B89 DEFB $00                             ; X coordinate.
 $5B8A DEFB $00,$00,$00,$00,$00             ; Y and Z coordinates, and the
                                            ; width, depth and height.
@label=PlayerBottomObject_Flags
 $5B8F DEFB $00                             ; Flags.
 $5B90 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; {The rest of the record of the
 $5B98 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; object.
 $5BA0 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; }

; Player Top Object
;
; The object for the upper half of the robot.
@label=PlayerTopObject
g$5BA8 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5BB0 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5BB8 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5BC0 DEFB $00,$00,$00,$00,$00,$00,$00,$00

; Special Object Slots
;
; The objects for the special objects (the valves and the extra lives)
; which are in the current room. They are copied from the table at #R$76E3 when
; the room is built by #R$AE99, and back again by #R$AF05.
@label=SpecialObjectSlots
g$5BC8 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5BD0 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5BD8 DEFB $00,$00,$00,$00,$00,$00,$00,$00
