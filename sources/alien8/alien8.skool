; Print Statistics
;
; Used by the routine at #R$B761.
; .
; Prints the statistics for the
; game which has ended, using #R$6308: three
; digits of #R$5B3C, and two digits each of
; #R$5B3E and #R$5B3F. They are counted by
; #R$AC6B.
;
; .
;
; Print the cryonauts that were lost.
@label=PrintStatistics
c$BA36 LD HL,$6308   ; {Set #R$5B27 to #R$6308.
 $BA39 LD ($5B27),HL ; }
 $BA3C LD DE,$5B3C   ; Point #REGde at #R$5B3C.
 $BA3F LD HL,$DBF6   ; Point #REGhl at #R$DBF6.
 $BA42 LD B,$02      ; Set the number of bytes to #N$02.
 $BA44 CALL $BA74    ; Call #R$BA74.
; Print the chambers that were found
; activated.
 $BA47 LD HL,$E1F7   ; Point #REGhl at #R$E1F7.
 $BA4A LD B,$01      ; Set the number of bytes to #N$01.
 $BA4C CALL $BA6A    ; Call #R$BA6A.
; Print the chambers that were not
; activated.
 $BA4F LD HL,$DDF7   ; Point #REGhl at #R$DDF7.
 $BA52 LD B,$01      ; Set the number of bytes to #N$01.
 $BA54 JP $BA6A      ; Jump to #R$BA6A.

; Print Lives
;
; Used by the routines at #R$A749 and #R$BEE0.
; .
; Prints the number of lives
; remaining in the panel.
;
; .
;
; Print #R$5B1A at the panel.
@label=PrintLives
c$BA57 LD DE,$5B1A   ; Point #REGde at #R$5B1A.
 $BA5A LD B,$01      ; Set the number of bytes to #N$01.
 $BA5C LD HL,$D2F0   ; Point #REGhl at #R$D2F0.
 $BA5F JP $BA62      ; Jump to #R$BA62.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$BCA3 }
; LIST#

; Print BCD Number
;
; Used by the routines at #R$A7A3 and #R$BA57.
; .
; Prints a number which is held in
; BCD, using the font with the digits.
;
; B Number of bytes
; DE Address of the number
; HL Address in the screen buffer
;
; Point at the digit font.
@label=PrintBCDNumber
c$BA62 PUSH HL       ; Stash the screen buffer address on
                     ; the stack.
 $BA63 LD HL,$6308   ; {Set #R$5B27 to #R$6308.
 $BA66 LD ($5B27),HL ; }
 $BA69 POP HL        ; Restore the screen buffer address from the stack.
; Continue on to #R$BA6A.
; .
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$BCAE }
; { #MARTIANOIDS$B5AF }
; { #NIGHTSHADE$C314 }
; { #PENTAGRAM$BB48 }
; LIST#

; Print BCD Bytes
;
; Used by the routines at #R$BA36 and #R$BA74.
; .
; Prints the digits of a number
; held in BCD, two to each byte.
;
; B Number of bytes
; DE Address of the number
; HL Address in the screen buffer
;
; Print the upper digit of the byte.
@label=PrintBCDBytes
c$BA6A LD A,(DE)     ; Fetch a byte of the number.
 $BA6B RRCA          ; {Move the upper digit to the lowest
 $BA6C RRCA          ; four bits.
 $BA6D RRCA          ;
 $BA6E RRCA          ; }
 $BA6F AND %00001111 ; Keep only bits 0 to 3.
 $BA71 CALL $BBEB    ; Call #R$BBEB.
; Continue on to #R$BA74.

; Print Low Digit
;
; Used by the routine at #R$BA36.
; .
; Prints the lower digit of a byte
; of a number held in BCD, and goes on to
; the next byte (see #R$BA6A).
;
; B Number of bytes
; DE Address of the number
; HL Address in the screen buffer
;
; Print the lower digit and move on.
@label=PrintLowDigit
c$BA74 LD A,(DE)     ; Fetch a byte of the number.
 $BA75 AND %00001111 ; Keep only bits 0 to 3.
 $BA77 CALL $BBEB    ; Call #R$BBEB.
 $BA7A INC DE        ; Move on to the next byte.
 $BA7B DJNZ $BA6A    ; Jump to #R$BA6A until all of the
                     ; bytes have been printed.
 $BA7D RET           ; Return.

; Game Selection Menu
;
; Used by the routine at #R$A650.
; .
; Displays the menu and waits for the
; control method to be chosen and the game to
; be started. The keys "1" to "4" choose the
; keyboard, the Kempston joystick, the cursor
; joystick and Interface II, "5" turns
; directional control on or off, and "0"
; starts the game. A low beep sounds when the
; choice changes. The menu tune is played
; once. The choice is held in #R$5B04.
; .
; #PUSHS #UDGTABLE
; { #SIM(start=$A631,stop=$A676,sp=$F100,r=$80,clear=1)
; #SIM(start=$BA7E,stop=$BA95)
; #SCR$02(game-selection-menu) } UDGTABLE# #POPS
;
; .
;
; Prepare the menu.
@label=GameMenu
c$BA7E XOR A         ; {Write #N$00 to #R$5B18.
 $BA7F LD ($5B18),A  ; }
 $BA82 LD HL,$BB14   ; Point #REGhl at #R$BB14.
 $BA85 LD B,$08      ; Set the number of lines to #N$08.
@label=GameMenu_StopFlashing
*$BA87 RES 7,(HL)    ; Stop the line flashing.
 $BA89 INC HL        ; Move on to the next line.
 $BA8A DJNZ $BA87    ; Jump to #R$BA87 until all of the lines are done.
 $BA8C CALL $CE7B    ; Call #R$CE7B.
 $BA8F CALL $BC25    ; Call #R$BC25.
 $BA92 CALL $BAFB    ; Call #R$BAFB.
; Read the keys that choose the control method.
@label=GameMenu_MenuLoop
*$BA95 CALL $BC25    ; Call #R$BC25.
; #HTML(#AUDIO0(main-tune.wav)(#INCLUDE(MainTune)))
 $BA98 LD DE,$B451   ; Point #REGde at #R$B451.
 $BA9B CALL $B4A1    ; Call #R$B4A1.
 $BA9E LD A,$F7      ; {Read from the keyboard;
 $BAA0 CALL $B759    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$F7 | 1 | 2 | 3 | 4 | 5 }
                     ; TABLE#}
 $BAA3 LD E,A        ; Keep the keys that are pressed in #REGe.
 $BAA4 LD A,($5B04)  ; Fetch #R$5B04.
 $BAA7 LD ($5B06),A  ; Set #R$5B06.
 $BAAA BIT 0,E       ; {Jump to #R$BAB0 if "1" is not pressed.
 $BAAC JR Z,$BAB0    ; }
 $BAAE AND %11111001 ; Choose the keyboard.
; Choose a joystick if one of those keys is pressed.
@label=GameMenu_TestKempston
*$BAB0 BIT 1,E       ; {Jump to #R$BAB8 if "2" is not pressed.
 $BAB2 JR Z,$BAB8    ; }
 $BAB4 AND %11111001 ; Clear bits 1 and 2.
 $BAB6 OR %00000010  ; Choose the Kempston joystick.
@label=GameMenu_TestCursor
*$BAB8 BIT 2,E       ; {Jump to #R$BAC0 if "3" is not pressed.
 $BABA JR Z,$BAC0    ; }
 $BABC AND %11111001 ; Clear bits 1 and 2.
 $BABE OR %00000100  ; Choose the cursor joystick.
@label=GameMenu_TestInterface
*$BAC0 BIT 3,E       ; {Jump to #R$BAC6 if "4" is not pressed.
 $BAC2 JR Z,$BAC6    ; }
 $BAC4 OR %00000110  ; Choose Interface II.
@label=GameMenu_SetMethod
*$BAC6 LD ($5B04),A  ; Set #R$5B04.
; Toggle directional control once for each press of "5".
 $BAC9 LD HL,$5B32   ; Point #REGhl at #R$5B32.
 $BACC BIT 4,E       ; {Jump to #R$BAF7 if "5" is not pressed.
 $BACE JR Z,$BAF7    ; }
 $BAD0 BIT 0,(HL)    ; {Jump to #R$BADE if "5" was pressed last time as well.
 $BAD2 JR NZ,$BADE   ; }
 $BAD4 SET 0,(HL)    ; Set bit 0 of #R$5B32.
 $BAD6 LD A,($5B04)  ; Fetch #R$5B04.
 $BAD9 XOR %00001000 ; Toggle directional control.
 $BADB LD ($5B04),A  ; Set #R$5B04.
; Start the game if "0" is pressed.
@label=GameMenu_TestStart
*$BADE LD HL,$5B06   ; Point #REGhl at #R$5B06.
 $BAE1 CP (HL)       ; {Call #R$B6B1 if the control method has changed.
 $BAE2 CALL NZ,$B6B1 ; }
 $BAE5 LD A,$EF      ; {Read from the keyboard;
 $BAE7 CALL $B759    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$EF | 0 | 9 | 8 | 7 | 6 }
                     ; TABLE#}
 $BAEA BIT 0,A       ; {Return if "0" is pressed.
 $BAEC RET NZ        ; }
 $BAED LD HL,$5B00   ; Point #REGhl at #R$5B00.
 $BAF0 INC (HL)      ; Increment #R$5B00.
 $BAF1 CALL $BAFB    ; Call #R$BAFB.
 $BAF4 JP $BA95      ; Jump to #R$BA95.
; "5" has been released.
@label=GameMenu_KeyReleased
*$BAF7 RES 0,(HL)    ; Reset bit 0 of #R$5B32.
 $BAF9 JR $BADE      ; Jump to #R$BADE.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$BD0C }
; { #MARTIANOIDS$BB12 }
; { #NIGHTSHADE$C8CA }
; { #PENTAGRAM$BB74 }
; LIST#

; Flash Menu Options
;
; Used by the routine at #R$BA7E.
; .
; Makes the line of the menu for
; the selected control method flash, and
; the line for directional control if that
; is on.
;
; .
;
; Flash the chosen control method.
@label=FlashMenuOptions
c$BAFB LD HL,$BB15   ; Point #REGhl at #R$BB15.
 $BAFE LD A,($5B04)  ; Fetch #R$5B04.
 $BB01 RRCA          ; Move the method to bits 0 and 1.
 $BB02 AND %00000011 ; Keep only bits 0 and 1.
 $BB04 LD B,$04      ; Set a counter of #N$04 lines.
 $BB06 CALL $BC15    ; Call #R$BC15.
; Flash directional control if it is
; on.
 $BB09 RES 7,(HL)    ; Reset bit 7 of the attribute.
 $BB0B LD A,($5B04)  ; Fetch #R$5B04.
 $BB0E AND %00001000 ; Keep only bit 3.
 $BB10 RET Z         ; Return if it is off.
 $BB11 SET 7,(HL)    ; Set bit 7 of the attribute.
 $BB13 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$BD89 }
; { #NIGHTSHADE$C949 }
; { #PENTAGRAM$BBD8 }
; LIST#

; Menu Colours
;
; The attributes of the lines of
; the menu.
@label=MenuColours
b$BB14 DEFB $43      ; #COLOUR(#PEEK(#PC)).
@label=MenuColours_FirstOption
 $BB15 DEFB $44      ; #COLOUR(#PEEK(#PC)).
 $BB16 DEFB $44      ; #COLOUR(#PEEK(#PC)).
 $BB17 DEFB $44      ; #COLOUR(#PEEK(#PC)).
 $BB18 DEFB $44      ; #COLOUR(#PEEK(#PC)).
 $BB19 DEFB $45      ; #COLOUR(#PEEK(#PC)).
 $BB1A DEFB $47      ; #COLOUR(#PEEK(#PC)).
 $BB1B DEFB $47      ; #COLOUR(#PEEK(#PC)).

; Menu Coordinates
;
; The pixel positions of the lines
; of the menu, as an x and a y coordinate.
@label=MenuCoordinates
b$BB1C DEFB $68      ; {Line 0: (#N($68), #N$9F).
 $BB1D DEFB $9F      ; }
 $BB1E DEFB $30      ; {Line 1: (#N($30), #N$8F).
 $BB1F DEFB $8F      ; }
 $BB20 DEFB $30      ; {Line 2: (#N($30), #N$7F).
 $BB21 DEFB $7F      ; }
 $BB22 DEFB $30      ; {Line 3: (#N($30), #N$6F).
 $BB23 DEFB $6F      ; }
 $BB24 DEFB $30      ; {Line 4: (#N($30), #N$5F).
 $BB25 DEFB $5F      ; }
 $BB26 DEFB $30      ; {Line 5: (#N($30), #N$4F).
 $BB27 DEFB $4F      ; }
 $BB28 DEFB $30      ; {Line 6: (#N($30), #N$3F).
 $BB29 DEFB $3F      ; }
 $BB2A DEFB $50      ; {Line 7: (#N($50), #N$27).
 $BB2B DEFB $27      ; }

; Messaging: Menu Text
;
; The lines of the menu. The last
; character of each line has bit 7 set.
@label=MenuText
t$BB2C DEFM "ALIEN ","8"+$80               ; "ALIEN 8"
 $BB33 DEFM "1 KEYBOAR","D"+$80            ; "1 KEYBOARD"
 $BB3D DEFM "2 KEMPSTON JOYSTIC","K"+$80   ; "2 KEMPSTON JOYSTICK"
 $BB50 DEFM "3 CURSOR JOYSTIC","K"+$80     ; "3 CURSOR JOYSTICK"
 $BB61 DEFM "4 INTERFACE I","I"+$80        ; "4 INTERFACE II"
 $BB6F DEFM "5 DIRECTIONAL CONTRO","L"+$80 ; "5 DIRECTIONAL CONTROL"
 $BB84 DEFM "0 START GAM","E"+$80          ; "0 START GAME"
 $BB90 DEFM "> 1985 A;C;G",";"+$80         ; "> 1985 A;C;G;"

; Print Text Single Colour
;
; Used by the routine at #R$BC31.
; .
; Prints a line of text in the
; colour held in #R$5B16, using the ASCII
; font at #N$6188. The last character of
; the text has bit 7 set. Each character
; cell has its attribute set as well.
;
; DE Address of the text
; HL Pixel position
;
; Point at the ASCII font and keep
; #R$5B16.
@label=PrintTextSingleColour
c$BB9D PUSH HL       ; Stash the pixel position on the
                     ; stack.
 $BB9E LD HL,$6188   ; Point #REGhl at #N$6188.
 $BBA1 LD ($5B27),HL ; Set #R$5B27.
 $BBA4 POP BC        ; {Copy the pixel position to #REGbc
 $BBA5 PUSH BC       ; (using the stack).}
 $BBA6 CALL $D120    ; Call #R$D120.
 $BBA9 LD L,C        ; {Copy it to #REGhl.
 $BBAA LD H,B        ; }
 $BBAB LD A,($5B16)  ; Fetch #R$5B16.
 $BBAE EX AF,AF'     ; Keep the colour in #REGaf'.
 $BBAF JR $BBC2      ; Jump to #R$BBC2.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$BE31 }
; { #PENTAGRAM$BC66 }
; LIST#

; Print Text Standard Font
;
; Used by the routines at #R$A749 and #R$B761.
; .
; Prints a line of text, which
; starts with its attribute, using the
; ASCII font at #N$6188. The last
; character of the text has bit 7 set.
; Each character cell has its attribute
; set as well.
;
; DE Address of the text
; HL Pixel position
;
; Point at the ASCII font and fetch
; the attribute from the text.
@label=PrintTextStandardFont
c$BBB1 PUSH HL       ; Stash the pixel position on the
                     ; stack.
 $BBB2 LD HL,$6188   ; Point #REGhl at #N$6188.
 $BBB5 LD ($5B27),HL ; Set #R$5B27.
 $BBB8 POP BC        ; {Copy the pixel position to #REGbc
 $BBB9 PUSH BC       ; (using the stack).}
 $BBBA CALL $D120    ; Call #R$D120.
 $BBBD LD L,C        ; {Copy it to #REGhl.
 $BBBE LD H,B        ; }
 $BBBF LD A,(DE)     ; Fetch the attribute of the text.
 $BBC0 EX AF,AF'     ; Keep the attribute in #REGaf'.
 $BBC1 INC DE        ; Move on to the first character.
; This entry point is used by the routine at #R$BB9D.
; .
; Find the attribute address.
@label=PrintTextStandardFont_PrintLine
*$BBC2 EXX           ; Switch to the shadow registers.
 $BBC3 POP HL        ; Fetch the pixel position.
 $BBC4 PUSH DE       ; Stash the address of the text on
                     ; the stack.
 $BBC5 CALL $D157    ; Call #R$D157.
 $BBC8 LD L,E        ; {Copy it to #REGhl.
 $BBC9 LD H,D        ; }
 $BBCA POP DE        ; Restore the address of the text from the stack.
; Print each character and set its
; attribute.
@label=PrintTextStandardFont_NextCharacter
*$BBCB EXX           ; Switch back to the main registers.
 $BBCC LD A,(DE)     ; Fetch a character of the text.
 $BBCD BIT 7,A       ; {Jump to #R$BBDE if it is the last.
 $BBCF JR NZ,$BBDE   ; }
 $BBD1 PUSH DE       ; Stash the address of the text on
                     ; the stack.
 $BBD2 CALL $BBEB    ; Call #R$BBEB.
 $BBD5 POP DE        ; Restore the address of the text from the stack.
 $BBD6 INC DE        ; Move on to the next character.
 $BBD7 EXX           ; Switch to the shadow registers.
 $BBD8 EX AF,AF'     ; Fetch the attribute.
 $BBD9 LD (HL),A     ; Set the attribute of the cell.
 $BBDA INC L         ; Move on to the next cell.
 $BBDB EX AF,AF'     ; Keep the attribute in #REGaf'.
 $BBDC JR $BBCB      ; Jump to #R$BBCB.
; Print the last character.
@label=PrintTextStandardFont_LastCharacter
*$BBDE AND %01111111 ; Keep only bits 0 to 6.
 $BBE0 PUSH DE       ; Stash the address of the text on
                     ; the stack.
 $BBE1 CALL $BBEB    ; Call #R$BBEB.
 $BBE4 POP DE        ; Restore the address of the text from the stack.
 $BBE5 INC DE        ; Move on past the text.
 $BBE6 EXX           ; Switch to the shadow registers.
 $BBE7 EX AF,AF'     ; Fetch the attribute.
 $BBE8 LD (HL),A     ; Set the attribute of the last
                     ; cell.
 $BBE9 EXX           ; Switch back to the main registers.
 $BBEA RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$BE45 }
; { #PENTAGRAM$BC7A }
; LIST#

; Print Character
;
; Used by the routines at #R$BA6A, #R$BA74 and #R$BBB1.
; .
; Prints a character in the screen
; buffer, using the font whose address is
; held in #R$5B27. A space is drawn as
; #N$3D, which is blank in this font. The
; eight rows are written going down the
; buffer (see #R$D200), #N$20 bytes apart,
; and the address is left at the top of
; the next character.
;
;   A The character
;   HL Address in the screen buffer of the top row
; O:HL Address of the top row of the next character
;
; Turn a space into the font space.
@label=PrintCharacter
c$BBEB CP $20        ; {Jump to #R$BBF1 if it is not a space.
 $BBED JR NZ,$BBF1   ; }
 $BBEF LD A,$3D      ; Use the font space (#N$3D).
; Find the glyph.
@label=PrintCharacter_Find
*$BBF1 PUSH BC       ; {Stash #REGbc, #REGde and the
 $BBF2 PUSH DE       ; screen buffer address on the stack.
 $BBF3 PUSH HL       ; }
 $BBF4 LD L,A        ; {Set #REGhl to the character.
 $BBF5 LD H,$00      ; }
 $BBF7 ADD HL,HL     ; {Multiply the character by eight.
 $BBF8 ADD HL,HL     ;
 $BBF9 ADD HL,HL     ; }
; This entry point is used by the routine at #R$ADB0.
; .
; Add the font address.
@label=PrintCharacter_Offset
*$BBFA LD DE,($5B27) ; Fetch #R$5B27.
 $BBFE ADD HL,DE     ; Add it to get the glyph address.
 $BBFF EX DE,HL      ; Point #REGde at the glyph.
 $BC00 POP HL        ; Restore the screen buffer address from the stack.
; Copy eight rows down the buffer.
 $BC01 LD B,$08      ; Set a counter of #N$08 rows.
@label=PrintCharacter_NextRow
*$BC03 LD A,(DE)     ; {Copy a row of the glyph to the buffer.
 $BC04 LD (HL),A     ; }
 $BC05 INC DE        ; Move on to the next row of the glyph.
 $BC06 PUSH BC       ; Stash the row counter on the stack.
 $BC07 LD BC,$FFE0   ; {Move #REGhl down a row.
 $BC0A ADD HL,BC     ; }
 $BC0B POP BC        ; Restore the row counter from the stack.
 $BC0C DJNZ $BC03    ; Jump to #R$BC03 until all eight
                     ; rows have been written.
; Move on to the next character, eight
; lines up and one byte to the right.
 $BC0E POP DE        ; Restore #REGde from the stack.
 $BC0F LD BC,$0101   ; {Move #REGhl on by #N($0101,$04,$04).
 $BC12 ADD HL,BC     ; }
 $BC13 POP BC        ; Restore #REGbc from the stack.
 $BC14 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$BE7F }
; { #PENTAGRAM$BAEA }
; LIST#

; Set Flashing Attribute
;
; Used by the routine at #R$BAFB.
; .
; Sets bit 7 of the attribute of
; one line of text in a list of lines, and
; resets it for the other lines.
;
; A The number of the line
; B Number of lines
; HL Address of the attributes
;
; Flash one line and steady the rest.
@label=SetFlashingAttribute
c$BC15 AND A         ; {Jump to #R$BC1F if the line is not
 $BC16 JR NZ,$BC1F   ; the first.}
@label=SetFlashingAttribute_Flash
*$BC18 SET 7,(HL)    ; Set bit 7 of the attribute.
 $BC1A JR $BC21      ; Jump to #R$BC21.
@label=SetFlashingAttribute_NextLine
*$BC1C DEC A         ; {Jump to #R$BC18 if this is the
 $BC1D JR Z,$BC18    ; line.}
@label=SetFlashingAttribute_Steady
*$BC1F RES 7,(HL)    ; Reset bit 7 of the attribute.
@label=SetFlashingAttribute_Next
*$BC21 INC HL        ; Move on to the next line.
 $BC22 DJNZ $BC1C    ; Jump to #R$BC1C until all of the
                     ; lines have been done.
 $BC24 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$BEA3 }
; { #MARTIANOIDS$BB73 }
; { #NIGHTSHADE$CA1B }
; { #PENTAGRAM$BB64 }
; LIST#

; Display Menu
;
; Used by the routine at #R$BA7E.
; .
; Displays the menu, which is a
; list of eight lines of text (see
; #R$BC31).
;
; .
;
; Point at the menu colours,
; positions and text.
@label=DisplayMenu
c$BC25 LD DE,$BB14   ; Point #REGde at #R$BB14.
 $BC28 EXX           ; Switch to the shadow registers.
 $BC29 LD HL,$BB1C   ; Point #REGhl at #R$BB1C.
 $BC2C LD DE,$BB2C   ; Point #REGde at #R$BB2C.
 $BC2F LD B,$08      ; Set the number of lines to #N$08.
; Continue on to #R$BC31.
; .
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$BEB3 }
; { #NIGHTSHADE$CA2B }
; { #PENTAGRAM$BCB4 }
; LIST#

; Display Text List
;
; Used by the routines at #R$B761 and #R$B8A9.
; .
; Prints a list of lines of text
; in the screen buffer, each in its own
; colour. #REGde' points at the attributes,
; #REGhl at pairs of pixel x and y
; positions, and #REGde at the text. After
; the lines have been printed the border
; is drawn and the buffer is copied to the
; screen, unless #R$5B18 is already set.
;
; B Number of lines
; DE Address of the text
; HL Address of the list of positions
; DE' Address of the list of attributes
;
; Print one line from the three lists.
@label=DisplayTextList
c$BC31 EXX           ; Switch to the shadow registers.
 $BC32 LD A,(DE)     ; Fetch the attribute of the line.
 $BC33 LD ($5B16),A  ; Set #R$5B16.
 $BC36 INC DE        ; Move on to the next attribute.
 $BC37 EXX           ; Switch back to the main registers.
 $BC38 PUSH BC       ; Stash the number of lines on the stack.
 $BC39 LD A,(HL)     ; Fetch the x position.
 $BC3A INC HL        ; {Move on to the next pair of positions.
 $BC3B INC HL        ; }
 $BC3C PUSH HL       ; Stash the address of the next pair on the stack.
 $BC3D DEC HL        ; Point #REGhl at the y position.
 $BC3E LD H,(HL)     ; Fetch the y position.
 $BC3F LD L,A        ; Set the x position.
 $BC40 CALL $BB9D    ; Call #R$BB9D.
 $BC43 POP HL        ; Restore the address of the next pair from the stack.
 $BC44 POP BC        ; Restore the number of lines from the stack.
 $BC45 DJNZ $BC31    ; Jump to #R$BC31 until all of the lines have been
                     ; printed.
; Draw the border the first time.
 $BC47 LD A,($5B18)  ; {Return if #R$5B18 is set.
 $BC4A AND A         ;
 $BC4B RET NZ        ; }
 $BC4C INC A         ; {Write #N$01 to *#R$5B18.
 $BC4D LD ($5B18),A  ; }
 $BC50 CALL $CB8A    ; Call #R$CB8A.
 $BC53 JP $CE85      ; Jump to #R$CE85.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$BEBF }
; LIST#

; Print Sprites
;
; Used by the routines at #R$CB0F and #R$CB8A.
; .
; Prints the sprite of an object a
; number of times, moving the pixel
; position of the object by a step each
; time, so that it makes a row of sprites.
; #REGbc, #REGde and #REGhl are preserved
; while each sprite is printed.
;
; B Number of times
; D Step along the y axis in pixels
; E Step along the x axis in pixels
; IX The address of the object
;
; Print one sprite and step the
; position.
@label=PrintSprites
c$BC56 PUSH BC       ; {Stash #REGbc, #REGde and #REGhl on the stack.
 $BC57 PUSH DE       ;
 $BC58 PUSH HL       ; }
 $BC59 CALL $D027    ; Call #R$D027.
 $BC5C POP HL        ; {Restore #REGhl, #REGde and #REGbc from the stack.
 $BC5D POP DE        ;
 $BC5E POP BC        ; }
 $BC5F LD A,(IX+$1A) ; Fetch the pixel x position of the
                     ; object.
 $BC62 ADD A,E       ; Add the step along the x axis.
 $BC63 LD (IX+$1A),A ; Set the pixel x position of the
                     ; object.
 $BC66 LD A,(IX+$1B) ; Fetch the pixel y position of the
                     ; object.
 $BC69 ADD A,D       ; Add the step along the y axis.
 $BC6A LD (IX+$1B),A ; Set the pixel y position of the
                     ; object.
 $BC6D DJNZ $BC56    ; Jump to #R$BC56 until all of the
                     ; sprites have been printed.
 $BC6F RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$BEE4 }
; { #PENTAGRAM$BDDE }
; LIST#

; Handle Player Appearing
;
; The handler for the sparkles in
; which the player appears at the start of
; a life (objects #N$38 to #N$3E). On every
; other frame it moves on to the next of
; the animation frames and plays a sound.
;
; IX The address of the object
;
; Advance the sparkle on every other
; frame.
@label=HandlePlayerAppearing
c$BC70 CALL $BF47    ; Call #R$BF47.
 $BC73 LD A,($5B02)  ; Fetch #R$5B02.
 $BC76 CPL           ; Invert it.
 $BC77 AND %00000001 ; Keep only bit 0.
 $BC79 RET NZ        ; Return on every other frame.
 $BC7A INC (IX+$00)  ; Move on to the next sprite number.
 $BC7D CALL $B604    ; Call #R$B604.
 $BC80 JP $BFAB      ; Jump to #R$BFAB.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$BEFE }
; LIST#

; Handle Last Appearing Sparkle
;
; The handler for the last of the
; sparkles in which the player appears
; (object #N$3F). The object stops moving
; and gets back the sprite number which
; was kept at offset #N$10 of its record,
; and the object is handled again straight
; away with that sprite number.
;
; IX The address of the object
;
; Stop the sparkle and restore the
; object.
@label=HandleLastAppearingSparkle
c$BC83 CALL $BF47     ; Call #R$BF47.
 $BC86 XOR A          ; {Set the x, y and z speeds to #N$00.
 $BC87 LD (IX+$09),A  ;
 $BC8A LD (IX+$0A),A  ;
 $BC8D LD (IX+$0B),A  ; }
 $BC90 RES 6,(IX+$0D) ; Reset bit 6 of the flags.
 $BC94 LD A,(IX+$10)  ; Fetch the sprite number which was
                      ; kept.
 $BC97 LD (IX+$00),A  ; Restore the sprite number of the
                      ; object.
 $BC9A JP $A6B1       ; Jump to #R$A6B1.

; Display Objects Carried
;
; Used by the routine at #R$CEAB.
; .
; Displays the objects which the
; player is carrying in the panel, if they
; have changed (see #R$5B14). Each of the
; three places takes three cells across
; and is #N$18 pixels apart from the next.
; The place is cleared, the sprite of the
; object is printed in the screen buffer
; and copied to the screen, and the cells
; are coloured according to the shape of
; the object (see #R$BD34). #R$BCAB
; displays the objects whether they have
; changed or not.
; .
; #PUSHS #UDGTABLE { =h After #R$BC9D }
; { #SIM(start=$A631,stop=$A676,sp=$F100,r=$80,clear=1)
; #SIM(start=$CE73,stop=$0000,sp=$EC00)
; #POKES$5B7C,$60;$5B80,$63;$5B84,$61;$5B14,$01
; #SIM(start=$BC9D,stop=$0000,sp=$EC00)
; #SCR$02,$00,$14,$10,$04(display-objects-carried) } UDGTABLE# #POPS
;
; .
;
; Return unless the objects have
; changed.
@label=DisplayObjectsCarried
c$BC9D LD A,($5B23)    ; {Return if #R$5B23 is set.
 $BCA0 AND A           ;
 $BCA1 RET NZ          ; }
 $BCA2 LD A,($5B14)    ; {Return if #R$5B14 is zero.
 $BCA5 AND A           ;
 $BCA6 RET Z           ; }
 $BCA7 XOR A           ; {Write #N$00 to *#R$5B14.
 $BCA8 LD ($5B14),A    ; }
; This entry point is used by the routine at #R$A749.
; .
; Draw the three places in the panel.
@label=DisplayObjectsCarried_Display
*$BCAB PUSH IX         ; Stash #REGix on the stack.
 $BCAD LD IX,$BD38     ; Point #REGix at #R$BD38.
 $BCB1 LD B,$03        ; Set a counter of #N$03 places.
 $BCB3 LD HL,$5B7C     ; Point #REGhl at #R$5B7C.
; Work out the pixel x of this place
; (#N$18 times the place, plus #N$08).
@label=DisplayObjectsCarried_NextPlace
*$BCB6 PUSH BC         ; Stash the counter on the stack.
 $BCB7 PUSH HL         ; Stash the address of the object on
                       ; the stack.
 $BCB8 LD A,B          ; Copy the counter to #REGa.
 $BCB9 NEG             ; Make it negative.
 $BCBB ADD A,$03       ; Add #N$03.
 $BCBD SLA A           ; {Multiply it by eight.
 $BCBF SLA A           ;
 $BCC1 SLA A           ; }
 $BCC3 LD C,A          ; Keep it in #REGc.
 $BCC4 SLA A           ; Double it.
 $BCC6 ADD A,C         ; Add the eight times.
 $BCC7 ADD A,$08       ; Add #N$08.
 $BCC9 LD (IX+$1A),A   ; Set the pixel x position of the
                       ; place.
 $BCCC LD (IX+$1B),$00 ; Set the pixel y position of the
                       ; place to #N$00.
; Clear the place and print the
; sprite.
 $BCD0 LD C,(IX+$1A)   ; Fetch the pixel x position into
                       ; #REGc.
 $BCD3 LD B,(IX+$1B)   ; Fetch the pixel y position into
                       ; #REGb.
 $BCD6 PUSH HL         ; Stash the address of the object on
                       ; the stack.
 $BCD7 CALL $D120      ; Call #R$D120.
 $BCDA LD L,C          ; {Copy it to #REGhl.
 $BCDB LD H,B          ; }
 $BCDC LD BC,$0318     ; Set #REGbc to #N$0318.
 $BCDF XOR A           ; Set #REGa to #N$00.
 $BCE0 CALL $BF83      ; Call #R$BF83.
 $BCE3 POP HL          ; Restore the address of the object from the stack.
 $BCE4 LD A,(HL)       ; Fetch the number of the object
                       ; carried.
 $BCE5 AND A           ; {Jump to #R$BCF2 if it is zero.
 $BCE6 JR Z,$BCF2      ; }
 $BCE8 RES 6,(IX+$07)  ; Reset bit 6 of the flags.
 $BCEC LD (IX+$00),A   ; Set the sprite number of the
                       ; object.
 $BCEF CALL $D027      ; Call #R$D027.
; Copy the place to the screen.
@label=DisplayObjectsCarried_CopyPlace
*$BCF2 LD C,(IX+$1A)   ; Fetch the pixel x position into
                       ; #REGc.
 $BCF5 LD B,(IX+$1B)   ; Fetch the pixel y position into
                       ; #REGb.
 $BCF8 CALL $D135      ; Call #R$D135.
 $BCFB CALL $D120      ; Call #R$D120.
 $BCFE LD L,C          ; {Copy it to #REGhl.
 $BCFF LD H,B          ; }
 $BD00 LD BC,$1803     ; Set #REGbc to #N$1803.
 $BD03 CALL $CF85      ; Call #R$CF85.
; Colour the cells from the shape.
 $BD06 POP HL          ; Restore the address of the object from the stack.
 $BD07 POP BC          ; {Keep the counter on the stack.
 $BD08 PUSH BC         ; }
 $BD09 PUSH HL         ; Stash the address of the object on
                       ; the stack.
 $BD0A LD A,(HL)       ; Fetch the number of the object
                       ; carried.
 $BD0B AND %00001111   ; Keep only bits 0 to 3.
 $BD0D LD E,A          ; {Copy the shape into #REGde.
 $BD0E LD D,$00        ; }
 $BD10 LD HL,$BD34     ; {Point #REGhl at the entry of #R$BD34 for the shape.
 $BD13 ADD HL,DE       ; }
 $BD14 LD C,(HL)       ; Fetch the colour into #REGc.
 $BD15 LD L,(IX+$1A)   ; Fetch the pixel x position of the
                       ; place into #REGl.
 $BD18 LD A,(IX+$1B)   ; Fetch the pixel y position of the
                       ; place.
 $BD1B ADD A,$17       ; Add #N$17.
 $BD1D LD H,A          ; Keep it in #REGh.
 $BD1E CALL $D157      ; Call #R$D157.
 $BD21 EX DE,HL        ; Swap it into #REGhl.
 $BD22 LD A,C          ; Fetch the colour.
 $BD23 LD BC,$0303     ; Set #REGbc to #N$0303.
 $BD26 CALL $BF83      ; Call #R$BF83.
 $BD29 POP HL          ; {Restore the address of the object and the counter
 $BD2A POP BC          ; from the stack.}
 $BD2B INC HL          ; {Move on to the next object
 $BD2C INC HL          ; carried.
 $BD2D INC HL          ;
 $BD2E INC HL          ; }
 $BD2F DJNZ $BCB6      ; Jump to #R$BCB6 until all three
                       ; places have been done.
 $BD31 POP IX          ; Restore #REGix from the stack.
 $BD33 RET             ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$BF45 }
; { #PENTAGRAM$BA3D }
; LIST#

; Carried Object Colours
;
; The attributes of the cells under
; the objects which are carried, for each
; of the four shapes of valve.
@label=CarriedObjectColours
b$BD34 DEFB $42      ; #COLOUR(#PEEK(#PC)).
 $BD35 DEFB $43      ; #COLOUR(#PEEK(#PC)).
 $BD36 DEFB $45      ; #COLOUR(#PEEK(#PC)).
 $BD37 DEFB $47      ; #COLOUR(#PEEK(#PC)).

; Sprite Object
;
; An object which is used for
; printing sprites in the panel and the
; border.
@label=SpriteObject
g$BD38 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $BD40 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $BD48 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $BD50 DEFB $00,$00,$00,$00,$00,$00,$00,$00

; Test Pickup Drop Key
;
; Used by the routine at #R$BD6B.
; .
; Tests whether the control for
; picking up or dropping an object is
; pressed. If a joystick is used with
; directional control then the other of
; the two bits for this is used.
;
; O:F Zero flag set if the control is not pressed
;
; Use the directional bit when a
; joystick has directional control.
@label=TestPickupDropKey
c$BD58 LD HL,$5B04   ; Point #REGhl at #R$5B04.
 $BD5B LD A,(HL)     ; Fetch it.
 $BD5C AND %00000110 ; Keep only bits 1 and 2.
 $BD5E LD A,($5B15)  ; Fetch #R$5B15.
 $BD61 JR Z,$BD68    ; Jump to #R$BD68 if the keyboard is
                     ; in use.
 $BD63 BIT 3,(HL)    ; {Jump to #R$BD68 if directional
 $BD65 JR Z,$BD68    ; control is off.}
 $BD67 RRCA          ; Move the bit for directional
                     ; control into place.
@label=TestPickupDropKey_Test
*$BD68 AND %00010000 ; Keep only bit 4.
 $BD6A RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$BFFB }
; { #PENTAGRAM$BF66 }
; LIST#

; Handle Pickup And Drop
;
; Used by the routine at #R$C0BE.
; .
; Picks up or drops an object when
; the player presses the control for it. A
; valve which is close enough is picked
; up. If the player is carrying three
; objects already then the one that has
; been carried longest is dropped where
; the new one was. Otherwise, if the
; player is carrying something and there
; is a free place for a special object in
; the room, the object that has been
; carried longest is dropped where the
; player stands, and the player is lifted
; up by #N$0C to stand on it.
; .
; The routine looks for objects by making
; the player a little wider, deeper and
; taller, which is put right when the
; routine ends.
; .
; The objects carried are four lots of
; four bytes from #R$5B78: the object
; number, the flags and the address of the
; entry in #R$76E3. The first is the place
; for a new object and the last is the one
; that has been carried longest.
;
; IX The address of the bottom half of the player
;
; Return unless this is a new press
; while the player is standing in the
; room.
@label=HandlePickupAndDrop
c$BD6B LD A,($5B13)    ; {Jump to #R$BDFD if #R$5B13 is set.
 $BD6E AND A           ;
 $BD6F JP NZ,$BDFD     ; }
 $BD72 CALL $BD58      ; Call #R$BD58.
 $BD75 RET Z           ; Return if the control is not pressed.
 $BD76 CALL $C117      ; Call #R$C117.
 $BD79 RET NC          ; Return if the player is not inside the room.
; Return if the player is jumping.
 $BD7A BIT 3,(IX+$0C)  ; {Return if the player is jumping.
 $BD7E RET NZ          ; }
; Return if the player is in the air.
 $BD7F BIT 2,(IX+$0C)  ; {Return if the player is in the air.
 $BD83 RET Z           ; }
; Test whether there is room to drop
; an object, by raising the player by
; #N$0C.
 $BD84 XOR A           ; {Write #N$00 to *#R$5B33.
 $BD85 LD ($5B33),A    ; }
 $BD88 LD A,(IX+$03)   ; Fetch the height of the player.
 $BD8B LD B,A          ; Keep it in #REGb.
 $BD8C ADD A,$0C       ; Add #N$0C.
 $BD8E LD (IX+$03),A   ; Set the new height of the player.
 $BD91 CALL $B712      ; Call #R$B712.
 $BD94 LD (IX+$03),B   ; Restore the height of the player.
 $BD97 JR NC,$BD9E     ; Jump to #R$BD9E if there is room.
 $BD99 LD A,$01        ; {Write #N$01 to *#R$5B33.
 $BD9B LD ($5B33),A    ; }
; Mark the press and enlarge the
; player.
@label=HandlePickupAndDrop_Pressed
*$BD9E CALL $B6B1      ; Call #R$B6B1.
 $BDA1 LD A,$01        ; {Write #N$01 to *#R$5B13 and
 $BDA3 LD ($5B13),A    ; *#R$5B14.
 $BDA6 LD ($5B14),A    ; }
 $BDA9 LD B,$02        ; Set a counter of #N$02 special
                       ; objects.
 $BDAB LD L,(IX+$04)   ; Fetch the width of the player.
 $BDAE LD A,L          ; Copy it into #REGa.
 $BDAF ADD A,$04       ; Add #N$04.
 $BDB1 LD (IX+$04),A   ; Set the new width.
 $BDB4 LD H,(IX+$05)   ; Fetch the depth of the player.
 $BDB7 LD A,H          ; Copy it into #REGa.
 $BDB8 ADD A,$04       ; Add #N$04.
 $BDBA LD (IX+$05),A   ; Set the new depth.
 $BDBD PUSH HL         ; Stash the old width and depth.
 $BDBE LD L,(IX+$06)   ; Fetch the height of the player.
 $BDC1 LD A,L          ; Copy it into #REGa.
 $BDC2 ADD A,$04       ; Add #N$04.
 $BDC4 LD (IX+$06),A   ; Set the new height.
 $BDC7 PUSH HL         ; Stash the old height.
 $BDC8 LD IY,$5BC8     ; Point #REGiy at #R$5BC8.
; Try to pick up a nearby valve.
@label=HandlePickupAndDrop_LookForObject
*$BDCC CALL $BEA7      ; Call #R$BEA7.
 $BDCF JP C,$BE76      ; Jump to #R$BE76 if it can be
                       ; picked up.
 $BDD2 LD DE,$0020     ; {Point #REGiy at the next special object.
 $BDD5 ADD IY,DE       ; }
 $BDD7 DJNZ $BDCC      ; Jump to #R$BDCC until both have
                       ; been tried.
; Look for a free slot to drop into.
 $BDD9 CALL $BD58      ; Call #R$BD58.
 $BDDC JR Z,$BDF1      ; Jump to #R$BDF1 if it is zero.
 $BDDE LD B,$02        ; Set a counter of #N$02 special
                       ; objects.
 $BDE0 LD IY,$5BC8     ; Point #REGiy at #R$5BC8.
 $BDE4 LD DE,$0020     ; Set #REGde to #N($0020,$04,$04).
@label=HandlePickupAndDrop_TestSlot
*$BDE7 LD A,(IY+$00)   ; Fetch the object number of the
                       ; special object.
 $BDEA AND A           ; {Jump to #R$BE06 if it is zero.
 $BDEB JR Z,$BE06      ; }
 $BDED ADD IY,DE       ; Point #REGiy at the next special
                       ; object.
 $BDEF DJNZ $BDE7      ; Jump to #R$BDE7 until all of them
                       ; have been tried.
; Put the size of the player back.
@label=HandlePickupAndDrop_Done
*$BDF1 POP HL          ; Restore the old height from the stack.
 $BDF2 LD (IX+$06),L   ; Set the height of the player.
 $BDF5 POP HL          ; Restore the old width and depth from the stack.
 $BDF6 LD (IX+$04),L   ; Set the width of the player.
 $BDF9 LD (IX+$05),H   ; Set the depth of the player.
 $BDFC RET             ; Return.
; Wait until the control is released.
@label=HandlePickupAndDrop_WaitForRelease
*$BDFD CALL $BD58      ; Call #R$BD58.
 $BE00 RET NZ          ; Return if it is not zero.
 $BE01 XOR A           ; {Write #N$00 to *#R$5B13.
 $BE02 LD ($5B13),A    ; }
 $BE05 RET             ; Return.
; Drop the object that has been
; carried longest.
@label=HandlePickupAndDrop_Drop
*$BE06 LD HL,$5B84     ; Point #REGhl at #R$5B84.
 $BE09 LD A,(HL)       ; Fetch its object number.
 $BE0A INC HL          ; Move on to the flags.
 $BE0B AND A           ; {Jump to #R$BE60 if it is zero.
 $BE0C JR Z,$BE60      ; }
 $BE0E LD A,($5B33)    ; Fetch #R$5B33.
 $BE11 AND A           ; {Jump to #R$BDF1 if it is not zero.
 $BE12 JR NZ,$BDF1     ; }
 $BE14 DEC HL          ; Point #REGhl at the object number.
 $BE15 LD A,(HL)       ; Fetch it.
 $BE16 INC HL          ; Move on to the flags.
 $BE17 LD (IY+$00),A   ; Set it as the object number of the
                       ; special object.
; Put the object where the player is,
; and lift the player on top of it.
@label=HandlePickupAndDrop_Place
 $BE1A PUSH HL         ; Stash the address of the flags of
                       ; the object carried.
 $BE1B LD BC,$0003     ; Set #REGbc to #N($0003,$04,$04).
 $BE1E PUSH IX         ; {Copy #REGix to #REGhl (using the
 $BE20 POP HL          ; stack).}
 $BE21 PUSH IY         ; {Copy #REGiy to #REGde (using the
 $BE23 POP DE          ; stack).}
 $BE24 INC DE          ; Point #REGde at the x position of
                       ; the object.
 $BE25 INC HL          ; Point #REGhl at the x position of
                       ; the player.
 $BE26 LDIR            ; Copy the position of the player to
                       ; the object.
 $BE28 LD A,(IX+$03)   ; Fetch the height of the player.
 $BE2B ADD A,$0C       ; Add #N$0C.
 $BE2D LD (IX+$03),A   ; Set the new height of the player.
 $BE30 LD A,(IX+$23)   ; Fetch the height of the top half
                       ; of the player.
 $BE33 ADD A,$0C       ; Add #N$0C.
 $BE35 LD (IX+$23),A   ; Set the new height of the top half
                       ; of the player.
 $BE38 CALL $AE8A      ; Call #R$AE8A.
; Set up the rest of the object.
@label=HandlePickupAndDrop_SetObject
*$BE3B LD (IY+$04),$05 ; Set the width of the object to
                       ; #N$05.
 $BE3F LD (IY+$05),$05 ; Set the depth of the object to
                       ; #N$05.
 $BE43 LD (IY+$06),$0C ; Set the height of the object to
                       ; #N$0C.
 $BE47 POP HL          ; Restore the address of the flags
                       ; of the object carried from the stack.
 $BE48 LD A,(HL)       ; Fetch the flags.
 $BE49 INC HL          ; Move on to the address of the
                       ; table entry.
 $BE4A LD (IY+$07),A   ; Set the flags of the object.
 $BE4D LD A,(IX+$08)   ; Fetch the room of the player.
 $BE50 LD (IY+$08),A   ; Set the room of the object.
 $BE53 LD A,(HL)       ; Fetch the low byte of the table
                       ; entry address.
 $BE54 INC HL          ; Move on to the high byte.
 $BE55 LD (IY+$10),A   ; Set the low byte of the table
                       ; entry address of the object.
 $BE58 LD A,(HL)       ; Fetch the high byte of the table
                       ; entry address.
 $BE59 LD (IY+$11),A   ; Set the high byte of the table
                       ; entry address of the object.
 $BE5C SET 0,(IY+$0D)  ; Set bit 0 of the object flags.
; Shift the carried list along and
; clear #R$5B78.
@label=HandlePickupAndDrop_Shift
*$BE60 LD HL,$5B83     ; Point #REGhl at #R$5B83.
 $BE63 LD DE,$5B87     ; Point #REGde at #R$5B87.
 $BE66 LD BC,$000C     ; Set #REGbc to #N($000C,$04,$04).
 $BE69 LDDR            ; Move the objects.
 $BE6B LD DE,$5B78     ; Point #REGde at #R$5B78.
 $BE6E LD B,$04        ; Set the number of bytes to clear
                       ; to #N$04.
 $BE70 CALL $CE1C      ; Call #R$CE1C.
 $BE73 JP $BDF1        ; Jump to #R$BDF1.
; Pick up the object that #REGiy
; points at.
@label=HandlePickupAndDrop_PickUp
*$BE76 LD HL,$5B78     ; Point #REGhl at #R$5B78.
 $BE79 XOR A           ; {Write #N$00 to *#R$5B3B.
 $BE7A LD ($5B3B),A    ; }
 $BE7D LD A,(IY+$00)   ; Fetch the object number of the
                       ; object.
 $BE80 LD (HL),A       ; Store it.
 $BE81 INC HL          ; Move on to the flags.
 $BE82 LD A,(IY+$07)   ; Fetch the flags of the object.
 $BE85 LD (HL),A       ; Store them.
 $BE86 INC HL          ; Move on to the address of the
                       ; table entry.
 $BE87 LD E,(IY+$10)   ; Fetch the low byte of the table
                       ; entry address of the object.
 $BE8A LD D,(IY+$11)   ; Fetch the high byte.
 $BE8D XOR A           ; {Write #N$00 to the table entry.
 $BE8E LD (DE),A       ; }
 $BE8F LD (HL),E       ; Store the low byte of the table
                       ; entry address.
 $BE90 INC HL          ; Move on to the high byte.
 $BE91 LD (HL),D       ; Store it.
 $BE92 CALL $ADF3      ; Call #R$ADF3.
 $BE95 LD (IY+$00),$01 ; Set the sprite number to #N$01.
 $BE99 LD HL,$5B84     ; Point #REGhl at #R$5B84.
 $BE9C LD A,(HL)       ; Fetch its object number.
 $BE9D INC HL          ; Move on to the flags.
 $BE9E AND A           ; {Jump to #R$BE60 if it is zero.
 $BE9F JR Z,$BE60      ; }
 $BEA1 LD (IY+$00),A   ; Set it as the object number of the
                       ; special object.
 $BEA4 PUSH HL         ; Stash the address of the flags.
 $BEA5 JR $BE3B        ; Jump to #R$BE3B.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$C00E }
; { #PENTAGRAM$BF79 }
; LIST#

; Test Object Can Be Picked Up
;
; Used by the routine at #R$BD6B.
; .
; Tests whether an object is one of
; the four valves (objects #N$60 to #N$63)
; that the player is on or close to.
;
;   IX The address of the player
;   IY The address of the object
; O:F Carry flag set if the object can be picked up
;
; Return unless the object is a
; valve.
@label=TestObjectCanBePickedUp
c$BEA7 LD A,(IY+$00) ; Fetch the object number of the
                     ; object.
 $BEAA SUB $60       ; Subtract #N$60.
 $BEAC CP $04        ; {Return if it is not a valve.
 $BEAE RET NC        ; }
; Continue on to #R$BEAF.
; .
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$C172 }
; { #PENTAGRAM$C0D4 }
; LIST#

; Test Near Object
;
; Used by the routine at #R$BEE0.
; .
; Tests whether the player is
; standing on, or next to, the object.
;
;   IX The address of the player
;   IY The address of the object
; O:F Carry flag set if the objects overlap
;
; Test x and y with no movement, then
; z with the player #N$04 lower.
@label=TestNearObject
c$BEAF PUSH BC       ; Stash #REGbc.
 $BEB0 LD BC,$0000   ; Set #REGbc to #N($0000,$04,$04).
 $BEB3 LD L,C        ; {Set the y and z speeds to #N$00.
 $BEB4 LD H,C        ; }
 $BEB5 CALL $C5A9    ; Call #R$C5A9.
 $BEB8 JR NC,$BED4   ; Jump to #R$BED4 if they do not
                     ; overlap along x.
 $BEBA CALL $C5BE    ; Call #R$C5BE.
 $BEBD JR NC,$BED4   ; Jump to #R$BED4 if they do not
                     ; overlap along y.
 $BEBF LD A,(IX+$03) ; Fetch the height of the player.
 $BEC2 SUB $04       ; Subtract #N$04.
 $BEC4 LD (IX+$03),A ; Set the new height.
 $BEC7 CALL $C5D3    ; Call #R$C5D3.
 $BECA PUSH AF       ; Stash the result.
 $BECB LD A,(IX+$03) ; Fetch the height of the player.
 $BECE ADD A,$04     ; Add #N$04.
 $BED0 LD (IX+$03),A ; Set the old height.
 $BED3 POP AF        ; Restore the result from the stack.
@label=TestNearObject_Done
*$BED4 POP BC        ; Restore #REGbc from the stack.
 $BED5 RET           ; Return.

; Test Object Moving
;
; Used by the routines at #R$A9C7, #R$AF79, #R$B2FF and #R$BEE0.
; .
; Tests whether the object is
; moving.
;
;   IX The address of the object
; O:F Zero flag set if the object is not moving
;
; Combine the three speeds.
@label=TestObjectMoving
c$BED6 LD A,(IX+$09) ; Fetch the speed along the x axis.
 $BED9 OR (IX+$0A)   ; Combine it with the speed along
                     ; the y axis.
 $BEDC OR (IX+$0B)   ; Combine it with the speed along
                     ; the z axis.
 $BEDF RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$C1A1 }
; LIST#

; Handle Extra Life
;
; The handler for an extra life
; (object #N$0C). When the player touches
; it the object turns into a sparkle, it
; is removed from the table of special
; objects, the egg tops are allowed to
; move again and a life is added and
; printed in the panel. An extra life
; which has not been touched is moved
; with gravity and makes a sound when it
; moves.
;
; IX The address of the object
;
; Test whether the player is near.
@label=HandleExtraLife
c$BEE0 CALL $BF7E      ; Call #R$BF7E.
 $BEE3 PUSH IX         ; {Copy #REGix to #REGiy (using the
 $BEE5 POP IY          ; stack).}
 $BEE7 LD IX,$5B88     ; Point #REGix at #R$5B88.
 $BEEB INC (IX+$04)    ; Make the player a little wider.
 $BEEE INC (IX+$05)    ; Make the player a little deeper.
 $BEF1 CALL $BEAF      ; Call #R$BEAF.
 $BEF4 DEC (IX+$04)    ; Put the width of the player back.
 $BEF7 DEC (IX+$05)    ; Put the depth of the player back.
 $BEFA PUSH IY         ; {Copy #REGiy to #REGix (using the
 $BEFC POP IX          ; stack).}
 $BEFE JR NC,$BF22     ; Jump to #R$BF22 if the player is
                       ; not near.
; Collect the extra life.
 $BF00 LD (IX+$00),$40 ; Set the sprite number to #N$40.
 $BF04 CALL $BF6A      ; Call #R$BF6A.
 $BF07 LD L,(IX+$10)   ; Fetch the low byte of the table
                       ; entry address.
 $BF0A LD H,(IX+$11)   ; Fetch the high byte.
 $BF0D XOR A           ; {Write #N$00 to the table entry and
 $BF0E LD (HL),A       ; to *#R$5B3B.
 $BF0F LD ($5B3B),A    ; }
 $BF12 LD HL,$5B1A     ; {Add one life to #R$5B1A.
 $BF15 INC (HL)        ; }
 $BF16 CALL $B6B1      ; Call #R$B6B1.
 $BF19 CALL $BA57      ; Call #R$BA57.
 $BF1C LD BC,$0080     ; {Copy the lives to the screen at (#N($80), #N$00).
 $BF1F CALL $BF2F      ; }
; Move the extra life if it was not
; collected.
@label=HandleExtraLife_Move
*$BF22 CALL $BFB6      ; Call #R$BFB6.
 $BF25 CALL $BED6      ; Call #R$BED6.
 $BF28 RET Z           ; Return if the object is not moving.
 $BF29 CALL $C2EE      ; Call #R$C2EE.
 $BF2C JP $B3BF        ; Jump to #R$B3BF.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$C1AB }
; LIST#

; Copy Area To Screen
;
; Used by the routines at #R$AF79 and #R$BEE0.
; .
; Copies an area of the screen
; buffer, two bytes wide and eight rows
; high, to the screen at a pixel position.
;
; BC Pixel position
;
; Find both addresses.
@label=CopyAreaToScreen
c$BF2F CALL $D135    ; Call #R$D135.
 $BF32 CALL $D120    ; Call #R$D120.
 $BF35 LD L,C        ; {Copy it to #REGhl.
 $BF36 LD H,B        ; }
 $BF37 LD BC,$0802   ; {Jump to #R$CF85 with #N$08 lines of #N$02 bytes.
 $BF3A JP $CF85      ; }
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$C432 }
; LIST#

; Set Pixel Adjustments
;
; Used by the routines at #R$A8F9, #R$A9C7, #R$AA4D, #R$AA63, #R$B224, #R$B267,
; #R$B28C, #R$B29F, #R$B2B6, #R$B2FF, #R$B31F and #R$B33F.
; .
; Sets how many pixels the sprite of
; an object is moved, in x and y, from the
; position that #R$CFD2 works out. The
; isometric formula finds a corner of the
; object; these offsets sit the graphic on
; that box. There is an entry point for
; each pair of offsets, and the one that
; is used depends on the sprite. #REGl is
; the offset in x and #REGh is the offset
; in y. A plain block (object #N$1E) and
; the wall parts (objects #N$0D to #N$0F)
; have no other work, so their update
; routine is one of these entries.
;
; IX The address of the object
;
; The adjustments of blocks,
; conveyors, land mines, deadly pyramids
; and the remote control objects: #N$F0
; in x and #N$F7 in y.
@label=SetPixelAdjustments
c$BF3D LD HL,$F7F0   ; Set the adjustments.
 $BF40 JR $BF77      ; Jump to #R$BF77.
; The adjustments of #N$F4 in x and
; #N$F7 in y.
@label=SetPixelAdjustments_F4F7
 $BF42 LD HL,$F7F4   ; Set the adjustments.
 $BF45 JR $BF77      ; Jump to #R$BF77.
; This entry point is used by the routines at #R$AD13, #R$BC70 and #R$BC83.
; .
; The adjustments of the top of a
; broken egg and of the sparkles while
; the player appears: #N$F4 in x and
; #N$F8 in y.
@label=SetPixelAdjustments_Appearing
*$BF47 LD HL,$F8F4   ; Set the adjustments.
 $BF4A JR $BF77      ; Jump to #R$BF77.
; This entry point is used by the routines at #R$AE68, #R$C0BE and #R$C1E2.
; .
; The adjustments of the legs of
; the player and of a socket: #N$F0 in x
; and #N$F9 in y.
@label=SetPixelAdjustments_Legs
*$BF4C LD HL,$F9F0   ; Set the adjustments.
 $BF4F JR $BF77      ; Jump to #R$BF77.
; The adjustments of wall object
; #N$0D: #N$F4 in x and #N$F9 in y.
@label=SetPixelAdjustments_Wall_0D
 $BF51 LD HL,$F9F4   ; Set the adjustments.
 $BF54 JR $BF77      ; Jump to #R$BF77.
; This entry point is used by the routine at #R$B31A.
; .
; The adjustments of a block which
; is fat at the top: #N$F0 in x and #N$FA
; in y.
@label=SetPixelAdjustments_FatTop
*$BF56 LD HL,$FAF0   ; Set the adjustments.
 $BF59 JR $BF77      ; Jump to #R$BF77.
; This entry point is used by the routines at #R$AAA1, #R$B055, #R$B06B and
; #R$B110.
; .
; The adjustments of a mouse:
; #N$F4 in x and #N$FA in y.
@label=SetPixelAdjustments_Mouse
*$BF5B LD HL,$FAF4   ; Set the adjustments.
 $BF5E JR $BF77      ; Jump to #R$BF77.
; This entry point is used by the routines at #R$AE17, #R$AE33, #R$AE5D and
; #R$AF79.
; .
; The adjustments of a valve and of
; its ghost: #N$F4 in x and #N$FB in y.
@label=SetPixelAdjustments_Valve
*$BF60 LD HL,$FBF4   ; Set the adjustments.
 $BF63 JR $BF77      ; Jump to #R$BF77.
; The adjustments of wall object
; #N$0F: #N$F8 in x and #N$FB in y.
@label=SetPixelAdjustments_Wall_0F
 $BF65 LD HL,$FBF8   ; Set the adjustments.
 $BF68 JR $BF77      ; Jump to #R$BF77.
; This entry point is used by the routines at #R$A9B1, #R$AA89, #R$AE96,
; #R$B19C, #R$B2A4, #R$B3A4, #R$B3B8 and #R$BEE0.
; .
; The adjustments of sparkles,
; domes, a broken egg and a cryonaut:
; #N$F4 in x and #N$FC in y.
@label=SetPixelAdjustments_Sparkle
*$BF6A LD HL,$FCF4   ; Set the adjustments.
 $BF6D JR $BF77      ; Jump to #R$BF77.
; This entry point is used by the routine at #R$C6E4.
; .
; The adjustments of the top half
; of the player: #N$F0 in x and #N$FD in
; y.
@label=SetPixelAdjustments_PlayerTop
*$BF6F LD HL,$FDF0   ; Set the adjustments.
 $BF72 JR $BF77      ; Jump to #R$BF77.
; The adjustments of wall object
; #N$0E: #N$FC in x and #N$FD in y.
@label=SetPixelAdjustments_Wall_0E
 $BF74 LD HL,$FDFC   ; Set the adjustments.
; This entry point is used by the routines at #R$BFD8 and #R$BFEA.
; .
; Store the adjustments in the object.
@label=SetPixelAdjustments_Store
*$BF77 LD (IX+$12),L ; {Set the pixel adjustments of the object.
 $BF7A LD (IX+$13),H ; }
 $BF7D RET           ; Return.
; This entry point is used by the routine at #R$BEE0.
; .
; The adjustments of an extra life:
; #N$F8 in x and #N$FE in y.
@label=SetPixelAdjustments_ExtraLife
*$BF7E LD HL,$FEF8   ; Set the adjustments.
 $BF81 JR $BF77      ; Jump to #R$BF77.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$C4D3 }
; LIST#

; Fill Window
;
; Used by the routines at #R$A749, #R$BC9D, #R$CBE3 and #R$CEAB.
; .
; Fills a rectangle of the screen
; buffer, or of the attribute buffer, with
; a byte. The rows of the rectangle are
; #N$20 bytes apart. The loop is unrolled
; into eight stores, and the code jumps
; into the middle of them to store only as
; many bytes as the width of the rectangle
; (which can be no more than eight): the
; number of stores to skip is worked out
; and written into the operand of the jump
; at #R$BF95.
;
; A Byte to fill the rectangle with
; B Width of the rectangle in bytes
; C Height of the rectangle in lines
; HL Address of the first byte
;
; Work out how many stores to skip.
@label=FillWindow
c$BF83 PUSH AF       ; Stash the byte on the stack.
 $BF84 LD A,B        ; Fetch the width.
 $BF85 NEG           ; Make it negative.
 $BF87 AND %00000111 ; Keep only bits 0 to 2.
 $BF89 ADD A,A       ; Multiply it by two.
 $BF8A LD ($BF96),A  ; Write the offset to
                     ; #R$BF95(#N$BF96).
 $BF8D LD A,$20      ; Set #REGa to #N$20.
 $BF8F SUB B         ; Subtract the width.
 $BF90 LD E,A        ; Keep it in #REGe.
 $BF91 LD D,$00      ; Set #REGd to #N$00.
 $BF93 LD B,C        ; Set #REGb to the height.
 $BF94 POP AF        ; Restore the byte from the stack.
; Fill one line, then step to the
; next.
@label=FillWindow_Line
*$BF95 JR $BF95      ; Jump into the stores.
 $BF97 LD (HL),A     ; Store the byte.
 $BF98 INC HL        ; Move on to the next byte.
 $BF99 LD (HL),A     ; Store the byte.
 $BF9A INC HL        ; Move on to the next byte.
 $BF9B LD (HL),A     ; Store the byte.
 $BF9C INC HL        ; Move on to the next byte.
 $BF9D LD (HL),A     ; Store the byte.
 $BF9E INC HL        ; Move on to the next byte.
 $BF9F LD (HL),A     ; Store the byte.
 $BFA0 INC HL        ; Move on to the next byte.
 $BFA1 LD (HL),A     ; Store the byte.
 $BFA2 INC HL        ; Move on to the next byte.
 $BFA3 LD (HL),A     ; Store the byte.
 $BFA4 INC HL        ; Move on to the next byte.
 $BFA5 LD (HL),A     ; Store the byte.
 $BFA6 INC HL        ; Move on to the next byte.
 $BFA7 ADD HL,DE     ; Move on to the start of the next
                     ; line.
 $BFA8 DJNZ $BF95    ; Jump to #R$BF95 until all of the
                     ; lines have been filled.
 $BFAA RET           ; Return.

; Set Wipe And Draw Flags
;
; Used by the routines at #R$A8F9, #R$A971, #R$A9C7, #R$AB61, #R$ABF5, #R$AD13,
; #R$ADF3, #R$AE17, #R$AE33, #R$AF79, #R$B055, #R$B224, #R$B2B0, #R$B2B6,
; #R$B2FF, #R$B33F, #R$B3A4, #R$B3BF, #R$BC70 and #R$C0BE.
; .
; Flags an object to be wiped and
; drawn again, and flags every other
; object that overlaps it to be drawn too.
;
; IX The address of the object
;
; Set the wipe and draw bits, then
; flag overlaps.
@label=SetWipeAndDrawFlags
c$BFAB LD A,(IX+$07) ; Fetch the flags of the object.
 $BFAE OR %00110000  ; Set bits 4 and 5.
 $BFB0 LD (IX+$07),A ; Store the flags.
 $BFB3 JP $C657      ; Jump to #R$C657.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$C692 }
; { #PENTAGRAM$CCDE }
; LIST#

; Apply Gravity And Move
;
; Used by the routines at #R$A8F9, #R$A9C7, #R$AA89, #R$AAA1, #R$AD13, #R$AF79,
; #R$B06B, #R$B110, #R$B19C, #R$B224, #R$B2B6, #R$B2FF, #R$B33F and #R$BEE0.
; .
; Makes an object fall faster, then
; moves it. #R$BFBC only moves the object.
;
; IX The address of the object
;
; Speed the fall, then stay clear of
; walls and other objects.
@label=ApplyGravityAndMove
c$BFB6 DEC (IX+$0B)   ; Take one off the z speed of the
                      ; object.
 $BFB9 CALL $C442     ; Call #R$C442.
; This entry point is used by the routine at #R$C296.
; .
; Add the speeds to the position.
@label=MoveObject
*$BFBC LD A,(IX+$01)  ; Fetch the x position of the
                      ; object.
 $BFBF ADD A,(IX+$09) ; Add the speed along the x axis.
 $BFC2 LD (IX+$01),A  ; Set the new x position.
 $BFC5 LD A,(IX+$02)  ; Fetch the y position of the
                      ; object.
 $BFC8 ADD A,(IX+$0A) ; Add the speed along the y axis.
 $BFCB LD (IX+$02),A  ; Set the new y position.
 $BFCE LD A,(IX+$03)  ; Fetch the z position of the
                      ; object.
 $BFD1 ADD A,(IX+$0B) ; Add the speed along the z axis.
 $BFD4 LD (IX+$03),A  ; Set the new z position.
 $BFD7 RET            ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$C700 }
; { #PENTAGRAM$B979 }
; LIST#

; Handle Far Arch
;
; The handler for the far side of
; an arch (object #N$03). It only needs to
; set the adjustments to the pixel
; position of the sprite, which are not
; the same when the sprite is flipped.
;
; IX The address of the object
;
; Choose the adjustments from the
; flip flag.
@label=HandleFarArch
c$BFD8 BIT 6,(IX+$07) ; {Jump to #R$BFE4 if the sprite is flipped.
 $BFDC JR NZ,$BFE4    ; }
 $BFDE LD HL,$FBF0    ; Set #REGhl to #N$FBF0.
 $BFE1 JP $BF77       ; Jump to #R$BF77.
@label=HandleFarArch_Flipped
*$BFE4 LD HL,$FCF8    ; Set #REGhl to #N$FCF8.
 $BFE7 JP $BF77       ; Jump to #R$BF77.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$C722 }
; LIST#

; Handle Near Arch
;
; The handler for the near side of
; an arch (object #N$02). As an arch does
; not move, its speeds are used to keep
; the position of the middle of the
; doorway: the middle is #N$0D further
; along the y axis than the arch, or #N$0D
; further back along the x axis if the
; sprite is flipped. The player is flagged
; if near the arch, and is nudged towards
; the middle of the doorway.
;
; IX The address of the object
;
; Unflipped: doorway #N$0D along y.
@label=HandleNearArch
c$BFEA BIT 6,(IX+$07) ; {Jump to #R$C013 if the sprite is flipped.
 $BFEE JR NZ,$C013    ; }
 $BFF0 LD HL,$F9FA    ; Set #REGhl to #N$F9FA.
 $BFF3 CALL $BF77     ; Call #R$BF77.
 $BFF6 LD A,(IX+$02)  ; Fetch the y position of the arch.
 $BFF9 ADD A,$0D      ; Add #N$0D.
 $BFFB LD (IX+$0A),A  ; Set it as the y of the doorway
                      ; middle.
 $BFFE LD A,(IX+$01)  ; Fetch the x position of the arch.
 $C001 LD (IX+$09),A  ; Set it as the x of the doorway
                      ; middle.
 $C004 LD HL,$060F    ; Set #REGhl to #N$060F.
; Keep z and flag or nudge the
; player.
@label=HandleNearArch_Near
*$C007 LD A,(IX+$03)  ; Fetch the z position of the arch.
 $C00A LD (IX+$0B),A  ; Set it as the z of the doorway
                      ; middle.
 $C00D CALL $C082     ; Call #R$C082.
 $C010 JP $C02C       ; Jump to #R$C02C.
; Flipped: doorway #N$0D back along
; x.
@label=HandleNearArch_Flipped
*$C013 LD HL,$FAF6    ; Set #REGhl to #N$FAF6.
 $C016 CALL $BF77     ; Call #R$BF77.
 $C019 LD A,(IX+$01)  ; Fetch the x position of the arch.
 $C01C SUB $0D        ; Subtract #N$0D.
 $C01E LD (IX+$09),A  ; Set it as the x of the doorway
                      ; middle.
 $C021 LD A,(IX+$02)  ; Fetch the y position of the arch.
 $C024 LD (IX+$0A),A  ; Set it as the y of the doorway
                      ; middle.
 $C027 LD HL,$0F06    ; Set #REGhl to #N$0F06.
 $C02A JR $C007       ; Jump to #R$C007.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$C73C }
; { #PENTAGRAM$C7AD }
; LIST#

; Nudge Player To Arch
;
; Used by the routine at #R$BFEA.
; .
; Nudges the player towards the
; middle of the doorway of an arch, if
; close to it, by jumping to the routine
; for the direction of the arch (see
; #R$C048).
;
; IX The address of the arch object
;
; Test that the player is flagged
; to be adjusted and is near the doorway.
@label=NudgePlayerToArch
c$C02C LD HL,$0F0F    ; Set #REGhl to #N$0F0F.
 $C02F LD IY,$5B88    ; Point #REGiy at #R$5B88.
 $C033 LD A,(IY+$00)  ; Fetch the sprite number of the
                      ; player.
 $C036 AND A          ; {Return if the slot is not used.
 $C037 RET Z          ; }
 $C038 BIT 3,(IY+$07) ; {Return if the player is not flagged
 $C03C RET Z          ; to be adjusted near arches.}
 $C03D CALL $C099     ; Call #R$C099.
 $C040 RET NC         ; Return if the player is not near.
; Jump by the direction of the
; arch.
 $C041 PUSH BC        ; Stash #REGbc on the stack.
 $C042 LD BC,$C048    ; Point #REGbc at #R$C048.
 $C045 JP $C312       ; Jump to #R$C312.
; View the equivalent code in;
; #LIST
; { #PENTAGRAM$C8D2 }
; LIST#

; Arch Direction Table
;
; The routines that nudge the
; player towards the middle of a doorway,
; by the direction of the arch (see
; #R$C319).
@label=ArchDirectionTable
w$C048 DEFW $C050    ; {Arch not flipped: #R$C050.
 $C04A DEFW $C050    ; }
 $C04C DEFW $C069    ; {Arch flipped: #R$C069.
 $C04E DEFW $C069    ; }

; Nudge Player East West
;
; Sets the adjustment to the speed
; of the player along the y axis, to bring
; the player a step closer to the middle
; line of an arch that goes east and west.
; Nothing is done if the sprite of the
; player is flipped.
;
; IX The address of the arch object
; IY The address of the player
;
; Skip if flipped or already in the
; middle.
@label=NudgePlayerEastWest
c$C050 BIT 6,(IY+$07) ; {Jump to #R$C080 if the player is flipped.
 $C054 JR NZ,$C080    ; }
 $C056 LD A,(IX+$0A)  ; Fetch the y of the doorway
                      ; middle.
 $C059 CP (IY+$02)    ; {Jump to #R$C080 if the player is
 $C05C JR Z,$C080     ; in the middle.}
; Step toward the middle along y.
 $C05E LD A,$01       ; Set #REGa to #N$01.
 $C060 JR NC,$C064    ; Jump to #R$C064 if carry is not
                      ; set.
 $C062 NEG            ; Negate #REGa.
@label=NudgePlayerEastWest_Set
*$C064 LD (IY+$0F),A  ; Set the y-speed adjustment of
                      ; the player.
 $C067 JR $C080       ; Jump to #R$C080.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$C7B1 }
; { #PENTAGRAM$C907 }
; LIST#

; Nudge Player North South
;
; Sets the adjustment to the speed
; of the player along the x axis, to bring
; the player a step closer to the middle
; line of an arch that goes north and
; south. Nothing is done unless the sprite
; of the player is flipped.
;
; IX The address of the arch object
; IY The address of the player
;
; Skip if not flipped or already in
; the middle.
@label=NudgePlayerNorthSouth
c$C069 BIT 6,(IY+$07) ; {Jump to #R$C080 if the player is not flipped.
 $C06D JR Z,$C080     ; }
 $C06F LD A,(IX+$09)  ; Fetch the x of the doorway
                      ; middle.
 $C072 CP (IY+$01)    ; {Jump to #R$C080 if the player is
 $C075 JR Z,$C080     ; in the middle.}
; Step toward the middle along x.
 $C077 LD A,$01       ; Set #REGa to #N$01.
 $C079 JR NC,$C07D    ; Jump to #R$C07D if carry is not
                      ; set.
 $C07B NEG            ; Negate #REGa.
@label=NudgePlayerNorthSouth_Set
*$C07D LD (IY+$0E),A  ; Set the x-speed adjustment of
                      ; the player.
; This entry point is used by the routine at #R$C050.
; .
; Finish the nudge.
@label=NudgePlayerNorthSouth_Done
*$C080 POP BC         ; Restore #REGbc from the stack.
 $C081 RET            ; Return.

; Flag Player Near Arch
;
; Used by the routine at #R$BFEA.
; .
; Flags the player as being near an
; arch (bit 0 of the flags), if close to
; the middle of the doorway.
;
; H Reach along the y axis
; L Reach along the x axis
; IX The address of the arch object
;
; Test that the player is flagged
; to be adjusted and is near the doorway.
@label=FlagPlayerNearArch
c$C082 LD IY,$5B88    ; Point #REGiy at #R$5B88.
 $C086 LD A,(IY+$00)  ; Fetch the sprite number of the
                      ; player.
 $C089 AND A          ; {Return if the slot is not used.
 $C08A RET Z          ; }
 $C08B BIT 3,(IY+$07) ; {Return if the player is not flagged
 $C08F RET Z          ; to be adjusted near arches.}
 $C090 CALL $C099     ; Call #R$C099.
 $C093 RET NC         ; Return if the player is not near.
 $C094 SET 0,(IY+$07) ; Flag the player as near an arch.
 $C098 RET            ; Return.

; Test Near To
;
; Used by the routines at #R$C02C and #R$C082.
; .
; Tests whether an object is close
; to the point that the arch keeps as the
; middle of its doorway: less than #REGl
; away along the x axis, less than #REGh
; away along the y axis and less than
; #N$04 away along the z axis.
;
;   H Reach along the y axis
;   L Reach along the x axis
;   IX The address of the arch object
;   IY The address of the object
; O:F Carry flag set if the object is near
;
; Compare along x.
@label=TestNearTo
c$C099 LD A,(IX+$09) ; Fetch the x of the doorway
                     ; middle.
 $C09C SUB (IY+$01)  ; Subtract the x of the object.
 $C09F JR NC,$C0A3   ; Jump to #R$C0A3 if carry is not
                     ; set.
 $C0A1 NEG           ; Negate #REGa.
@label=TestNearTo_Y
*$C0A3 CP L          ; {Return if the object is too far
 $C0A4 RET NC        ; along the x axis.}
; Compare along y.
 $C0A5 LD A,(IX+$0A) ; Fetch the y of the doorway
                     ; middle.
 $C0A8 SUB (IY+$02)  ; Subtract the y of the object.
 $C0AB JR NC,$C0AF   ; Jump to #R$C0AF if carry is not
                     ; set.
 $C0AD NEG           ; Negate #REGa.
@label=TestNearTo_Z
*$C0AF CP H          ; {Return if the object is too far
 $C0B0 RET NC        ; along the y axis.}
; Compare along z against #N$04.
 $C0B1 LD A,(IX+$0B) ; Fetch the z of the doorway
                     ; middle.
 $C0B4 SUB (IY+$03)  ; Subtract the z of the object.
 $C0B7 JR NC,$C0BB   ; Jump to #R$C0BB if carry is not
                     ; set.
 $C0B9 NEG           ; Negate #REGa.
@label=TestNearTo_Done
*$C0BB CP $04        ; Compare it with #N$04.
 $C0BD RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$C7FE }
; { #PENTAGRAM$C8AD }
; LIST#

; Handle Player Legs
;
; The handler for the lower half of
; the robot while it is walking (objects
; #N$10 to #N$17). The upper half of the
; player is only a copy of this one placed
; above it (see #R$C6E4), so this routine
; does all of the work for the player. If
; the player has been killed it is turned
; into a sparkle. Otherwise the input is
; read, the pickup and drop, turning,
; jumping and walking are dealt with, and
; the player is moved. While the player is
; outside the room (walking through an
; exit) it can fall but is not allowed to
; rise.
;
; IX The address of the object
;
; Turn into a sparkle if killed.
@label=HandlePlayerLegs
c$C0BE CALL $BF4C      ; Call #R$BF4C.
 $C0C1 BIT 6,(IX+$0D)  ; {Jump to #R$C0CE if the player has not been killed.
 $C0C5 JR Z,$C0CE      ; }
 $C0C7 SET 6,(IX+$2D)  ; Set bit 6 of the top half extra
                       ; flags.
 $C0CB JP $B39A        ; Jump to #R$B39A.
; Make the bottom half as tall as
; the whole player while it moves.
@label=HandlePlayerLegs_Alive
*$C0CE LD (IX+$06),$17 ; Set the height of the bottom
                       ; half to #N$17.
 $C0D2 LD (IX+$26),$00 ; Write #N$00 to the height of the
                       ; top half.
 $C0D6 CALL $C8FF      ; Call #R$C8FF.
 $C0D9 CALL $BD6B      ; Call #R$BD6B.
 $C0DC CALL $C13C      ; Call #R$C13C.
 $C0DF CALL $C23D      ; Call #R$C23D.
 $C0E2 CALL $C25E      ; Call #R$C25E.
 $C0E5 CALL $C117      ; {Jump to #R$C10A if the player is
 $C0E8 JR NC,$C10A     ; not inside the room.}
; Ignore the top half while the
; player moves.
@label=HandlePlayerLegs_Move
*$C0EA SET 1,(IX+$27)  ; Set bit 1 of the top half
                       ; flags.
 $C0EE CALL $C296      ; Call #R$C296.
 $C0F1 RES 1,(IX+$27)  ; Reset bit 1 of the top half
                       ; flags.
 $C0F5 LD A,(IX+$0C)   ; Fetch the collision flags.
 $C0F8 SUB $10         ; Subtract #N$10.
 $C0FA JR C,$C0FF      ; Jump to #R$C0FF if carry is set.
 $C0FC LD (IX+$0C),A   ; Store the collision flags.
; This entry point is used by the routine at #R$C1E2.
; .
; Restore the two heights and draw.
@label=HandlePlayerLegs_Draw
*$C0FF LD (IX+$06),$0C ; Set the height of the bottom
                       ; half to #N$0C.
 $C103 LD (IX+$26),$0B ; Set the height of the top half
                       ; to #N$0B.
 $C107 JP $BFAB        ; Jump to #R$BFAB.
; The player is outside the room.
@label=HandlePlayerLegs_Outside
*$C10A LD A,(IX+$0B)   ; Fetch the speed along the z
                       ; axis.
 $C10D AND A           ; {Jump to #R$C0EA if the player is
 $C10E JP M,$C0EA      ; falling.}
 $C111 XOR A           ; {Write #N$00 to the speed along
 $C112 LD (IX+$0B),A   ; the z axis.}
 $C115 JR $C0EA        ; Jump to #R$C0EA.
; View the equivalent code in;
; #LIST
; { #PENTAGRAM$C440 }
; LIST#

; Test Player In Room
;
; Used by the routines at #R$BD6B and #R$C0BE.
; .
; Tests whether the player is
; inside the room. The distance from the
; middle of the room (#N$80) has to be
; smaller than the distance to the wall,
; less the width of the player along x and
; less the depth of the player along y.
;
;   IX The address of the object
; O:F Carry flag set if the player is inside the room
;
; Limits from the wall distances.
@label=TestPlayerInRoom
c$C117 LD HL,($5B0B) ; Fetch #R$5B0B and #R$5B0C.
 $C11A LD A,L        ; Copy the distance along x to
                     ; #REGa.
 $C11B SUB (IX+$04)  ; Subtract the width of the
                     ; player.
 $C11E LD L,A        ; Store the limit along x in
                     ; #REGl.
 $C11F LD A,H        ; Copy the distance along y to
                     ; #REGa.
 $C120 SUB (IX+$05)  ; Subtract the depth of the
                     ; player.
 $C123 LD H,A        ; Store the limit along y in
                     ; #REGh.
; Compare the x distance from the
; middle.
 $C124 LD A,(IX+$01) ; Fetch the x position of the
                     ; player.
 $C127 SUB $80       ; Subtract #N$80.
 $C129 JP P,$C12E    ; Jump to #R$C12E if the sign flag
                     ; is clear.
 $C12C NEG           ; Negate #REGa.
@label=TestPlayerInRoom_LimitX
*$C12E CP L          ; {Return if the player is outside
 $C12F RET NC        ; along x.}
; Compare the y distance from the
; middle.
 $C130 LD A,(IX+$02) ; Fetch the y position of the
                     ; player.
 $C133 SUB $80       ; Subtract #N$80.
 $C135 JP P,$C13A    ; Jump to #R$C13A if the sign flag
                     ; is clear.
 $C138 NEG           ; Negate #REGa.
@label=TestPlayerInRoom_LimitY
*$C13A CP H          ; Compare it with the limit along
                     ; y.
 $C13B RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$C87A }
; { #PENTAGRAM$C4A3 }
; LIST#

; Handle Turning
;
; Used by the routine at #R$C0BE.
; .
; Turns the player to face the
; direction that was asked for. Where a
; joystick with directional control is in
; use the walk control is set when the
; player is already facing the direction
; that is pressed, and otherwise the
; player is turned. With the other methods
; of control the left and right controls
; turn the player. The routine returns
; early while the player is entering the
; room, jumping or not standing on
; something.
; .
; Turning starts by showing one of the
; sprites of objects #N$18 to #N$1B (see
; #R$C1D2 and #R$C1DA); #R$C1E2 finishes
; the turn.
;
;   C The controls
;   IX The address of the object
; O:C The controls, with the walk control changed
;
; Use rotational control unless a
; joystick is directional.
@label=HandleTurning
c$C13C LD HL,$5B04    ; Point #REGhl at #R$5B04.
 $C13F LD A,(HL)      ; Fetch it.
 $C140 AND %00000110  ; Keep only bits 1 and 2.
 $C142 JR Z,$C18F     ; Jump to #R$C18F if they are
                      ; zero.
 $C144 BIT 3,(HL)     ; {Jump to #R$C18F if directional
 $C146 JR Z,$C18F     ; control is off.}
; Directional control. The player
; cannot turn while entering the room, or
; while it is not standing on something.
 $C148 LD A,(IX+$0C)  ; Fetch the collision flags.
 $C14B AND %11110000  ; Keep only bits 4-7.
 $C14D RET NZ         ; Return if the player is entering the room.
 $C14E BIT 2,(IX+$0C) ; {Return if the player is in the air.
 $C152 RET Z          ; }
; Find the direction that is
; pressed. Left (west) is tried before up
; (north). Down is bit 4 of the controls.
 $C153 BIT 0,C        ; {Jump to #R$C15B if left is
 $C155 JR NZ,$C15B    ; pressed.}
 $C157 BIT 2,C        ; {Jump to #R$C16A if up is
 $C159 JR NZ,$C16A    ; pressed.}
@label=HandleTurning_Right
*$C15B BIT 1,C        ; {Jump to #R$C176 if right is
 $C15D JR NZ,$C176    ; pressed.}
 $C15F BIT 4,C        ; {Jump to #R$C17D if down is
 $C161 JR NZ,$C17D    ; pressed.}
 $C163 BIT 0,C        ; {Jump to #R$C186 if left is
 $C165 JR NZ,$C186    ; pressed.}
 $C167 RES 2,C        ; Clear the walk control, as no
                      ; direction is pressed.
 $C169 RET            ; Return.
; The facing of the player is #N$00
; west, #N$01 east, #N$02 north and #N$03
; south. If the player already faces the
; direction that is pressed, the walk
; control is set. Otherwise bit 0 of the
; direction (inverted for north and east)
; chooses which way to turn.
@label=HandleTurning_North
*$C16A CALL $C319     ; {Test whether the player is facing north.
 $C16D CP $02         ; }
@label=HandleTurning_Facing
*$C16F JR Z,$C18C     ; Jump to #R$C18C if it is.
 $C171 CPL            ; Invert the direction.
@label=HandleTurning_Turn
*$C172 AND %00000001  ; Keep bit 0, which decides
                      ; which way to turn.
 $C174 JR $C1A0       ; Jump to #R$C1A0.
@label=HandleTurning_East
*$C176 CALL $C319     ; {Test whether the player is facing east.
 $C179 CP $01         ; }
 $C17B JR $C16F       ; Jump to #R$C16F.
@label=HandleTurning_South
*$C17D CALL $C319     ; {Test whether the player is facing south.
 $C180 CP $03         ; }
@label=HandleTurning_TestFacing
*$C182 JR Z,$C18C     ; Jump to #R$C18C if it is.
 $C184 JR $C172       ; Jump to #R$C172.
@label=HandleTurning_West
*$C186 CALL $C319     ; {Test whether the player is facing west.
 $C189 AND A          ; }
 $C18A JR $C182       ; Jump to #R$C182.
@label=HandleTurning_Walk
*$C18C SET 2,C        ; Set the walk control, as the
                      ; player is facing the direction that is
                      ; pressed.
 $C18E RET            ; Return.
; Rotational control. The player
; cannot turn while entering the room or
; while jumping.
@label=HandleTurning_Rotate
*$C18F LD A,C         ; Copy #REGc to #REGa.
 $C190 AND %00000011  ; Keep only bits 0 and 1.
 $C192 RET Z          ; Return if they are zero.
 $C193 LD A,(IX+$0C)  ; Fetch the collision flags.
 $C196 AND %11110000  ; Keep only bits 4-7.
 $C198 RET NZ         ; Return if the player is entering the room.
 $C199 BIT 3,(IX+$0C) ; {Return if the player is jumping.
 $C19D RET NZ         ; }
 $C19E BIT 1,C        ; Test the right control.
@label=HandleTurning_Start
*$C1A0 JR NZ,$C1AB    ; Jump to #R$C1AB if the player is to turn right.
 $C1A2 RES 0,(IX+$0D) ; Reset bit 0 of the extra flags.
 $C1A6 LD HL,$C1DA    ; Point #REGhl at #R$C1DA.
 $C1A9 JR $C1B2       ; Jump to #R$C1B2.
@label=HandleTurning_TurnRight
*$C1AB SET 0,(IX+$0D) ; Set bit 0 of the extra flags.
 $C1AF LD HL,$C1D2    ; Point #REGhl at #R$C1D2.
@label=HandleTurning_SetSprite
*$C1B2 LD A,(IX+$0D)  ; Fetch the extra flags.
 $C1B5 OR %00000010   ; Set bit 1.
 $C1B7 LD (IX+$0D),A  ; Store the extra flags.
 $C1BA CALL $C319     ; Call #R$C319.
; Continue on to #R$C1BD.
; .
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$C89F }
; { #PENTAGRAM$C4C8 }
; LIST#

; Set Sprite From Table
;
; Used by the routine at #R$C1E2.
; .
; Sets the sprite of the player and
; its flip flag from a table of pairs of
; bytes. The entry is picked by the lowest
; two bits of #REGa.
;
; A The index into the table
; HL The address of the table
; IX The address of the object
;
; Pick the pair and set the sprite.
@label=SetSpriteFromTable
c$C1BD RLCA          ; Double the index.
 $C1BE AND %00000110 ; Keep only bits 1 and 2.
 $C1C0 CALL $CE06    ; Call #R$CE06.
 $C1C3 LD A,(HL)     ; Fetch the sprite number.
 $C1C4 INC HL        ; Move on to the flags.
 $C1C5 LD (IX+$00),A ; Set the sprite number.
 $C1C8 LD A,(IX+$07) ; Fetch the flags of the player.
 $C1CB AND %10111111 ; Clear bit 6.
 $C1CD OR (HL)       ; Merge the flags from the table.
 $C1CE LD (IX+$07),A ; Store the flags.
 $C1D1 RET           ; Return.

; Turning Right Sprite Table
;
; The sprite number and the flags
; of the player when it starts to turn
; right, picked by the direction that the
; player is facing (see #R$C319). The
; sprite is one of objects #N$18 to #N$1B.
@label=TurningRightSpriteTable
b$C1D2 DEFB $18,$00  ; Facing west: sprite #N($18),
                     ; not flipped.
 $C1D4 DEFB $19,$00  ; Facing east: sprite #N($19),
                     ; not flipped.
 $C1D6 DEFB $1A,$00  ; Facing north: sprite
                     ; #N($1A), not flipped.
 $C1D8 DEFB $1B,$40  ; Facing south: sprite
                     ; #N($1B), flipped.

; Turning Left Sprite Table
;
; The sprite number and the flags
; of the player when it starts to turn
; left, picked by the direction that the
; player is facing (see #R$C319). The
; sprite is one of objects #N$18 to #N$1B.
@label=TurningLeftSpriteTable
b$C1DA DEFB $1B,$40  ; Facing west: sprite #N($1B),
                     ; flipped.
 $C1DC DEFB $1A,$00  ; Facing east: sprite #N($1A),
                     ; not flipped.
 $C1DE DEFB $18,$00  ; Facing north: sprite
                     ; #N($18), not flipped.
 $C1E0 DEFB $19,$00  ; Facing south: sprite
                     ; #N($19), not flipped.

; Handle Turning Legs
;
; The handler for the lower half of
; the robot while it is turning (objects
; #N$18 to #N$1B). The turn takes two
; passes: the first counts the turn down
; while the player is moved, and the
; second sets the sprite that the player
; ends up with (see #R$C22D and #R$C235)
; and plays a footstep.
;
; C The controls
; IX The address of the object
;
; Count the turn down and move.
@label=HandleTurningLegs
c$C1E2 CALL $BF4C      ; Call #R$BF4C.
 $C1E5 LD (IX+$06),$17 ; Set the height of the bottom
                       ; half to #N$17.
 $C1E9 LD (IX+$26),$00 ; Write #N$00 to the height of the
                       ; top half.
 $C1ED CALL $C8FF      ; Call #R$C8FF.
 $C1F0 LD A,(IX+$0D)   ; Fetch the extra flags.
 $C1F3 AND %00000110   ; Keep only bits 1 and 2.
 $C1F5 JR Z,$C208      ; Jump to #R$C208 if they are
                       ; zero.
 $C1F7 LD A,(IX+$0D)   ; Fetch the extra flags.
 $C1FA SUB $02         ; Subtract #N$02.
 $C1FC LD (IX+$0D),A   ; Store the extra flags.
 $C1FF SET 1,(IX+$27)  ; Set bit 1 of the top half
                       ; flags.
 $C203 CALL $C2BC      ; Call #R$C2BC.
 $C206 JR $C221        ; Jump to #R$C221.
; Finish the turn with the new
; sprite.
@label=HandleTurningLegs_Finish
*$C208 BIT 0,(IX+$0D)  ; {Jump to #R$C228 if bit 0 of the
 $C20C JR Z,$C228      ; extra flags is clear.}
 $C20E LD HL,$C22D     ; Point #REGhl at #R$C22D.
@label=HandleTurningLegs_Set
*$C211 LD A,(IX+$00)   ; Fetch the sprite number of the
                       ; player.
 $C214 CALL $C1BD      ; Call #R$C1BD.
 $C217 CALL $B6D4      ; Call #R$B6D4.
 $C21A SET 1,(IX+$27)  ; Set bit 1 of the top half
                       ; flags.
 $C21E CALL $C2B3      ; Call #R$C2B3.
@label=HandleTurningLegs_Done
*$C221 RES 1,(IX+$27)  ; Reset bit 1 of the top half
                       ; flags.
 $C225 JP $C0FF        ; Jump to #R$C0FF.
@label=HandleTurningLegs_Left
*$C228 LD HL,$C235     ; Point #REGhl at #R$C235.
 $C22B JR $C211        ; Jump to #R$C211.

; Turned Right Sprite Table
;
; The sprite number and the flags
; of the player when it has finished
; turning right, picked by the sprite that
; it turned with (objects #N$18 to #N$1B).
@label=TurnedRightSpriteTable
b$C22D DEFB $11,$40  ; From #N$18: sprite #N($11),
                     ; flipped.
 $C22F DEFB $15,$40  ; From #N$19: sprite #N($15),
                     ; flipped.
 $C231 DEFB $15,$00  ; From #N$1A: sprite #N($15),
                     ; not flipped.
 $C233 DEFB $11,$00  ; From #N$1B: sprite #N($11),
                     ; not flipped.

; Turned Left Sprite Table
;
; The sprite number and the flags
; of the player when it has finished
; turning left, picked by the sprite that
; it turned with (objects #N$18 to #N$1B).
@label=TurnedLeftSpriteTable
b$C235 DEFB $11,$00  ; From #N$18: sprite #N($11),
                     ; not flipped.
 $C237 DEFB $15,$00  ; From #N$19: sprite #N($15),
                     ; not flipped.
 $C239 DEFB $11,$40  ; From #N$1A: sprite #N($11),
                     ; flipped.
 $C23B DEFB $15,$40  ; From #N$1B: sprite #N($15),
                     ; flipped.

; Handle Jump
;
; Used by the routine at #R$C0BE.
; .
; Makes the player jump if the jump
; control is pressed. The player cannot
; jump while entering a room, while
; already jumping, or while falling
; quickly.
;
; C The controls
; IX The address of the object
;
; Return unless a jump is allowed.
@label=HandleJump
c$C23D BIT 3,C         ; {Return if the jump control is not pressed.
 $C23F RET Z           ; }
 $C240 LD A,(IX+$0C)   ; Fetch the collision flags.
 $C243 AND %11110000   ; Keep only bits 4-7.
 $C245 RET NZ          ; Return if the player is entering the room.
 $C246 BIT 3,(IX+$0C)  ; {Return if the player is already jumping.
 $C24A RET NZ          ; }
 $C24B LD A,(IX+$0B)   ; Fetch the speed along the z
                       ; axis.
 $C24E INC A           ; Increment #REGa.
 $C24F RET M           ; Return if the sign flag is set.
; Start the jump.
 $C250 SET 3,(IX+$0C)  ; Flag the player as jumping.
 $C254 LD (IX+$0B),$08 ; Set the speed along the z axis
                       ; to #N$08.
 $C258 PUSH BC         ; Stash #REGbc on the stack.
 $C259 CALL $B62C      ; Call #R$B62C.
 $C25C POP BC          ; Restore #REGbc from the stack.
 $C25D RET             ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$C948 }
; LIST#

; Handle Walking
;
; Used by the routine at #R$C0BE.
; .
; Animates the legs of the player,
; with a footstep sound, while the player
; is walking, entering the room or
; jumping. The frame of the animation is
; in the lowest two bits of the sprite
; number. When the player stops walking
; the legs carry on until they reach frame
; #N($01), where the feet are together. The
; routine does nothing while the player is
; turning (objects #N$18 to #N$1B).
;
; C The controls
; IX The address of the object
;
; Return while turning.
@label=HandleWalking
c$C25E LD A,(IX+$00)  ; Fetch the sprite number of the
                      ; player.
 $C261 SUB $18        ; Subtract #N$18.
 $C263 CP $04         ; {Return if the player is turning.
 $C265 RET C          ; }
; Step while entering, jumping or
; walking.
 $C266 LD A,(IX+$0C)  ; Fetch the collision flags.
 $C269 AND %11110000  ; Keep only bits 4-7.
 $C26B JR NZ,$C277    ; Jump to #R$C277 if the player is
                      ; entering the room.
 $C26D BIT 3,(IX+$0C) ; {Jump to #R$C277 if the player is jumping.
 $C271 JR NZ,$C277    ; }
 $C273 BIT 2,C        ; {Jump to #R$C28C if bit 2 of
 $C275 JR Z,$C28C     ; #REGc is clear.}
@label=HandleWalking_Step
*$C277 PUSH BC        ; Stash #REGbc on the stack.
 $C278 CALL $B6CE     ; Call #R$B6CE.
 $C27B POP BC         ; Restore #REGbc from the stack.
; Go on to the next frame, which is
; #N$00 to #N$03.
@label=HandleWalking_Animate
*$C27C LD A,(IX+$00)  ; Fetch the sprite number of the
                      ; player.
 $C27F LD E,A         ; Copy it to #REGe.
 $C280 INC A          ; Increment #REGa.
 $C281 AND %00000011  ; Keep only bits 0 and 1.
 $C283 LD D,A         ; Copy the frame to #REGd.
 $C284 LD A,E         ; Copy #REGe to #REGa.
 $C285 AND %11111100  ; Keep only bits 2-7.
 $C287 OR D           ; Merge the new frame.
 $C288 LD (IX+$00),A  ; Set the sprite number of the
                      ; player.
 $C28B RET            ; Return.
@label=HandleWalking_Stop
*$C28C LD A,(IX+$00)  ; Fetch the sprite number of the
                      ; player.
 $C28F AND %00000011  ; Keep only bits 0 and 1.
 $C291 CP $01         ; {Return if it is #N$01.
 $C293 RET Z          ; }
 $C294 JR $C27C       ; Jump to #R$C27C.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$C969 }
; LIST#

; Move Player
;
; Used by the routine at #R$C0BE.
; .
; Moves the player by one frame.
; The speeds along x and y are only set up
; while the player walks, is jumping or is
; entering the room, and they are cleared
; again afterwards. The speed along z has
; gravity taken off it, which is more if
; the player is not rising with the jump
; control held down. If the player lands
; the jump is over.
;
; C The controls
; IX The address of the object
;
; Drop if the game is over.
@label=MovePlayer
c$C296 LD A,($5B24)    ; Fetch #R$5B24.
 $C299 AND A           ; {Jump to #R$C2A0 if the game is not over.
 $C29A JR Z,$C2A0      ; }
 $C29C LD (IX+$0B),$02 ; Set the speed along the z axis
                       ; to #N$02.
; Set the walk speeds unless the
; player is turning.
@label=MovePlayer_Speed
*$C2A0 BIT 3,(IX+$0C)  ; {Jump to #R$C2B7 if the player is jumping.
 $C2A4 JR NZ,$C2B7     ; }
 $C2A6 LD A,(IX+$0C)   ; Fetch the collision flags.
 $C2A9 AND %11110000   ; Keep only bits 4-7.
 $C2AB JR NZ,$C2B7     ; Jump to #R$C2B7 if the player is
                       ; entering the room.
 $C2AD BIT 3,(IX+$00)  ; {Jump to #R$C2BC if bit 3 of the
 $C2B1 JR NZ,$C2BC     ; sprite number is set.}
; This entry point is used by the routine at #R$C1E2.
@label=MovePlayer_WalkControl
*$C2B3 BIT 2,C         ; {Jump to #R$C2BC if bit 2 of
 $C2B5 JR Z,$C2BC      ; #REGc is clear.}
@label=MovePlayer_Forward
*$C2B7 PUSH BC         ; Stash #REGbc on the stack.
 $C2B8 CALL $C2F6      ; Call #R$C2F6.
 $C2BB POP BC          ; Restore #REGbc from the stack.
; This entry point is used by the routine at #R$C1E2.
; .
; Gravity takes one off the speed
; along z when the player is rising with
; the jump control held down, and two
; otherwise.
@label=MovePlayer_Gravity
*$C2BC LD A,(IX+$0B)   ; Fetch the speed along the z
                       ; axis.
 $C2BF AND A           ; {Jump to #R$C2C7 if the player is
 $C2C0 JP M,$C2C7      ; falling.}
 $C2C3 BIT 3,C         ; {Jump to #R$C2C8 if bit 3 of
 $C2C5 JR NZ,$C2C8     ; #REGc is set.}
@label=MovePlayer_Fall
*$C2C7 DEC A           ; Decrement #REGa.
@label=MovePlayer_Store
*$C2C8 DEC A           ; Decrement #REGa.
 $C2C9 LD (IX+$0B),A   ; Store the speed along the z
                       ; axis.
 $C2CC LD ($5B21),A    ; Set #R$5B21.
 $C2CF ADD A,$02       ; Add #N$02.
 $C2D1 CALL M,$B63C    ; Call #R$B63C if the sign flag is
                       ; set.
 $C2D4 CALL $C442      ; Call #R$C442.
 $C2D7 CALL $C36D      ; Call #R$C36D.
 $C2DA CALL $BFBC      ; Call #R$BFBC.
 $C2DD BIT 2,(IX+$0C)  ; {Jump to #R$C2EE if the player is in the air.
 $C2E1 JR Z,$C2EE      ; }
 $C2E3 LD A,($5B21)    ; Fetch #R$5B21.
 $C2E6 AND A           ; {Jump to #R$C2EE if the player
 $C2E7 JP P,$C2EE      ; was rising.}
 $C2EA RES 3,(IX+$0C)  ; Clear the jumping flag.
; Continue on to #R$C2EE.
; .
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$C9A1 }
; { #PENTAGRAM$C61D }
; LIST#

; Clear Speed
;
; Used by the routines at #R$AF79, #R$B2FF, #R$BEE0 and #R$C296.
; .
; Sets the speeds of the object
; along the x and y axes to zero.
;
; IX The address of the object
@label=ClearSpeed
c$C2EE XOR A         ; {Write #N$00 to the speeds along
 $C2EF LD (IX+$09),A ; x and y.
 $C2F2 LD (IX+$0A),A ; }
 $C2F5 RET           ; Return.

; Set Player Speed
;
; Used by the routine at #R$C296.
; .
; Sets the speeds along x and y of
; the player to walk forward. The
; adjustments of the speeds that arches
; make to nudge the player into doorways
; are added first, then the speed of #N$03
; in the direction that the player is
; facing.
;
; IX The address of the object
;
; Add the doorway nudges.
@label=SetPlayerSpeed
c$C2F6 LD A,(IX+$09)  ; Fetch the speed along the x
                      ; axis.
 $C2F9 ADD A,(IX+$0E) ; Add the adjustment along x.
 $C2FC LD (IX+$09),A  ; Store the speed along the x
                      ; axis.
 $C2FF LD A,(IX+$0A)  ; Fetch the speed along the y
                      ; axis.
 $C302 ADD A,(IX+$0F) ; Add the adjustment along y.
 $C305 LD (IX+$0A),A  ; Store the speed along the y
                      ; axis.
 $C308 XOR A          ; {Write #N$00 to the adjustments
 $C309 LD (IX+$0E),A  ; along x and y.
 $C30C LD (IX+$0F),A  ; }
; Jump by the facing direction.
 $C30F LD BC,$C32F    ; Point #REGbc at #R$C32F.
; This entry point is used by the routines at #R$C02C and #R$C36D.
@label=SetPlayerSpeed_Direction
*$C312 CALL $C319     ; Call #R$C319.
 $C315 LD L,A         ; Copy it to #REGl.
 $C316 JP $A6B7       ; Jump to #R$A6B7.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$C9FB }
; { #PENTAGRAM$C66A }
; LIST#

; Get Facing Direction
;
; Used by the routines at #R$C13C and #R$C2F6.
; .
; Works out the direction that an
; object is facing from the horizontal
; flip flag and bit 2 of the sprite
; number: bit 6 of the flags of the object
; is made into bit 1 of the direction, and
; bit 2 of the sprite number into bit 0.
; The direction is #N$00 west, #N$01 east,
; #N$02 north and #N$03 south.
;
;   IX The address of the object
; O:A The direction
;
; Bit 6 of the flags to bit 1.
@label=GetFacingDirection
c$C319 PUSH HL       ; Stash #REGhl on the stack.
 $C31A LD A,(IX+$07) ; Fetch the flags of the object.
 $C31D RRCA          ; {Rotate bit 6 into bit 3.
 $C31E RRCA          ;
 $C31F RRCA          ; }
 $C320 AND %00001000 ; Keep only bit 3.
 $C322 LD L,A        ; Copy it to #REGl.
; Bit 2 of the sprite to bit 0.
 $C323 LD A,(IX+$00) ; Fetch the sprite number of the
                     ; object.
 $C326 AND %00000100 ; Keep only bit 2.
 $C328 OR L          ; Merge #REGl.
 $C329 RRCA          ; {Rotate the two bits into place.
 $C32A RRCA          ; }
 $C32B AND %00000011 ; Keep only bits 0 and 1.
 $C32D POP HL        ; Restore #REGhl from the stack.
 $C32E RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$CA1E }
; { #PENTAGRAM$C5BD }
; LIST#

; Player Movement Table
;
; The routines that set the speed
; of the player, by the direction that the
; player is facing (see #R$C319).
@label=PlayerMovementTable
w$C32F DEFW $C337    ; Facing west: #R$C337.
 $C331 DEFW $C340    ; Facing east: #R$C340.
 $C333 DEFW $C347    ; Facing north: #R$C347.
 $C335 DEFW $C350    ; Facing south: #R$C350.

; Move Player West
;
; Takes #N$03 off the speed along
; the x axis of the object.
;
; IX The address of the object
@label=MovePlayerWest
c$C337 LD A,(IX+$09) ; Fetch the speed along the x
                     ; axis.
 $C33A ADD A,$FD     ; Add #N$FD.
; This entry point is used by the routine at #R$C340.
@label=MovePlayer_SetX
*$C33C LD (IX+$09),A ; Store the speed along the x
                     ; axis.
 $C33F RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$CA3A }
; { #PENTAGRAM$C695 }
; LIST#

; Move Player East
;
; Adds #N$03 to the speed along the
; x axis of the object.
;
; IX The address of the object
@label=MovePlayerEast
c$C340 LD A,(IX+$09) ; Fetch the speed along the x
                     ; axis.
 $C343 ADD A,$03     ; Add #N$03.
 $C345 JR $C33C      ; Jump to #R$C33C.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$CA43 }
; { #PENTAGRAM$C69E }
; LIST#

; Move Player North
;
; Adds #N$03 to the speed along the
; y axis of the object.
;
; IX The address of the object
@label=MovePlayerNorth
c$C347 LD A,(IX+$0A) ; Fetch the speed along the y
                     ; axis.
 $C34A ADD A,$03     ; Add #N$03.
; This entry point is used by the routine at #R$C350.
@label=MovePlayer_SetY
*$C34C LD (IX+$0A),A ; Store the speed along the y
                     ; axis.
 $C34F RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$CA4A }
; { #PENTAGRAM$C6A5 }
; LIST#

; Move Player South
;
; Takes #N$03 off the speed along
; the y axis of the object.
;
; IX The address of the object
@label=MovePlayerSouth
c$C350 LD A,(IX+$0A) ; Fetch the speed along the y
                     ; axis.
 $C353 ADD A,$FD     ; Add #N$FD.
 $C355 JR $C34C      ; Jump to #R$C34C.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$CA53 }
; { #PENTAGRAM$C6AE }
; LIST#

; Stop Object At Floor
;
; Used by the routine at #R$C442.
; .
; Stops an object from going
; through the floor. If the z position of
; the object after it has moved is below
; the floor of the room, the object is
; flagged as blocked along z, and its
; speed along z is brought closer to zero
; until the object no longer goes through
; the floor.
;
;   H Speed along the z axis
;   IX The address of the object
; O:H The new speed along the z axis
;
; Test the floor and slow z.
@label=StopObjectAtFloor
c$C357 LD A,($5B0E)   ; Fetch #R$5B0E.
 $C35A LD D,A         ; Copy it to #REGd.
@label=StopObjectAtFloor_Test
*$C35B LD A,(IX+$03)  ; Fetch the z position of the
                      ; object.
 $C35E ADD A,H        ; {Return if the object does not
 $C35F CP D           ; end up below the floor.
 $C360 RET NC         ; }
 $C361 SET 2,(IX+$0C) ; Set bit 2 of the collision
                      ; flags.
 $C365 LD A,H         ; Copy #REGh to #REGa.
 $C366 CALL $C386     ; Call #R$C386.
 $C369 LD H,A         ; Copy it to #REGh.
 $C36A JR NZ,$C35B    ; Jump to #R$C35B if it is not
                      ; zero.
 $C36C RET            ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$CA5A }
; { #PENTAGRAM$B963 }
; LIST#

; Handle Room Exit
;
; Used by the routine at #R$C296.
; .
; Sends the player to the next room
; if it has walked out through an arch.
; Only a player that is near an arch can
; leave the room, and not while it is
; still entering the room. The edge that
; counts is the one in the direction that
; the player is facing.
;
; IX The address of the object
;
; Return unless near an arch and
; not entering.
@label=HandleRoomExit
c$C36D LD A,(IX+$0C)  ; Fetch the collision flags.
 $C370 AND %11110000  ; Keep only bits 4-7.
 $C372 RET NZ         ; Return if the player is entering the room.
 $C373 BIT 0,(IX+$07) ; {Return if the player is not near an arch.
 $C377 RET Z          ; }
 $C378 RES 0,(IX+$07) ; Clear the near-an-arch flag.
 $C37C LD BC,$C38F    ; Point #REGbc at #R$C38F.
 $C37F LD HL,($5B0B)  ; Fetch #R$5B0B and #R$5B0C.
 $C382 PUSH HL        ; Stash #REGhl on the stack.
 $C383 JP $C312       ; Jump to #R$C312.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$CA70 }
; LIST#

; Bring Speed Closer To Zero
;
; Used by the routines at #R$C357, #R$C497, #R$C4E6, #R$C535, #R$C5E9 and
; #R$C613.
; .
; Takes one off the size of a
; speed.
;
;   A The speed
; O:A The new speed
; O:F Zero flag set if the speed is zero
@label=BringSpeedCloserToZero
c$C386 AND A         ; {Return if the speed is zero.
 $C387 RET Z         ; }
 $C388 JP P,$C38D    ; Jump to #R$C38D if the sign flag
                     ; is clear.
 $C38B INC A         ; {Add two to the negative speed.
 $C38C INC A         ; }
@label=BringSpeedCloserToZero_Step
*$C38D DEC A         ; Decrement #REGa.
 $C38E RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$CA89 }
; { #PENTAGRAM$B95A }
; LIST#

; Room Exit Table
;
; The routines that take the player
; to the next room, by the direction that
; the player is facing (see #R$C319).
@label=RoomExitTable
w$C38F DEFW $C397    ; Facing west: #R$C397.
 $C391 DEFW $C3F0    ; Facing east: #R$C3F0.
 $C393 DEFW $C40B    ; Facing north: #R$C40B.
 $C395 DEFW $C426    ; Facing south: #R$C426.

; Leave Room To The West
;
; Sends the player to the room to
; the west if it has gone past the west
; edge of the room. The x position is set
; to #N($00), which #R$CC01 takes as the
; sign that the player has come out of the
; west and puts it at the east side of the
; new room.
;
; HL Distances to the walls along x and y
; IX The address of the object
;
; Leave if past the west edge.
@label=LeaveRoomToWest
c$C397 POP HL          ; Restore #REGhl from the stack.
 $C398 LD A,$80        ; Set #REGa to #N$80.
 $C39A SUB L           ; Subtract #REGl.
 $C39B LD L,A          ; Copy it to #REGl.
 $C39C LD A,(IX+$01)   ; Fetch the x position of the
                       ; player.
 $C39F ADD A,(IX+$09)  ; Add the speed along the x axis.
 $C3A2 ADD A,(IX+$04)  ; Add the width of the player.
 $C3A5 CP L            ; {Return if the player is still in
 $C3A6 RET NC          ; the room.}
 $C3A7 LD (IX+$01),$00 ; Write #N$00 to the x position.
 $C3AB LD A,(IX+$08)   ; Fetch the room number.
 $C3AE LD L,A          ; Copy it to #REGl.
 $C3AF DEC A           ; Decrement #REGa.
; This entry point is used by the routine at #R$C3F0.
; .
; Change the column. The room
; number has the row in the high nibble
; and the column in the low nibble.
@label=ChangeRoomEastWest
*$C3B0 AND %00001111   ; Keep only bits 0-3.
 $C3B2 LD H,A          ; Copy it to #REGh.
 $C3B3 LD A,L          ; Copy #REGl to #REGa.
 $C3B4 AND %11110000   ; Keep only bits 4-7.
 $C3B6 OR H            ; Merge #REGh.
; This entry point is used by the routines at #R$C40B and #R$C426.
; .
; Change the room of the player.
; Bit 6 of the collision flags starts the
; entering-room counter at #N$04. If the
; object is the player then it is copied
; and replaced by sparkles, and the game
; loop is started again.
@label=ChangeRoom
*$C3B7 LD (IX+$08),A   ; Store the room number.
 $C3BA LD A,(IX+$0C)   ; Fetch the collision flags.
 $C3BD OR %01000000    ; Set bit 6.
 $C3BF LD (IX+$0C),A   ; Store the collision flags.
 $C3C2 LD A,(IX+$00)   ; Fetch the sprite number of the
                       ; object.
 $C3C5 SUB $10         ; Subtract #N$10.
 $C3C7 CP $40          ; {Return if it is not the player.
 $C3C9 RET NC          ; }
 $C3CA INC SP          ; {Drop two return addresses from
 $C3CB INC SP          ; the stack.
 $C3CC INC SP          ;
 $C3CD INC SP          ; }
 $C3CE PUSH IX         ; {Copy #REGix to #REGhl (using
 $C3D0 POP HL          ; the stack).}
 $C3D1 LD DE,$CA1D     ; Point #REGde at #R$CA1D.
 $C3D4 LD BC,$0040     ; Set #REGbc to #N($0040,$04,$04).
 $C3D7 LDIR            ; Copy the player.
; Remember the sprites, then turn
; the copy into sparkles.
 $C3D9 LD A,($CA1D)    ; Fetch the sprite of the bottom half.
 $C3DC LD ($CA2D),A    ; Keep it as the sprite that the bottom half will appear
                       ; as.
 $C3DF LD A,($CA3D)    ; Fetch the sprite of the top half.
 $C3E2 LD ($CA4D),A    ; Keep it as the sprite that the top half will appear
                       ; as.
 $C3E5 LD A,$38        ; {Write #N$38 to #R$CA1D and
 $C3E7 LD ($CA1D),A    ; #R$CA3D.
 $C3EA LD ($CA3D),A    ; }
 $C3ED JP $A68B        ; Jump to #R$A68B.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$CA9A }
; LIST#

; Leave Room To The East
;
; Sends the player to the room to
; the east if it has gone past the east
; edge of the room. The x position is set
; to #N($FF), which #R$CC01 takes as the
; sign that the player has come out of the
; east and puts it at the west side of the
; new room.
;
; HL Distances to the walls along x and y
; IX The address of the object
;
; Leave if past the east edge.
@label=LeaveRoomToEast
c$C3F0 POP HL          ; Restore #REGhl from the stack.
 $C3F1 LD A,L          ; Copy #REGl to #REGa.
 $C3F2 ADD A,$80       ; Add #N$80.
 $C3F4 LD L,A          ; Copy it to #REGl.
 $C3F5 LD A,(IX+$01)   ; Fetch the x position of the
                       ; player.
 $C3F8 ADD A,(IX+$09)  ; Add the speed along the x axis.
 $C3FB SUB (IX+$04)    ; Subtract the width of the
                       ; player.
 $C3FE CP L            ; {Return if the player is still in
 $C3FF RET C           ; the room.}
 $C400 LD (IX+$01),$FF ; Write #N$FF to the x position.
 $C404 LD A,(IX+$08)   ; Fetch the room number.
 $C407 LD L,A          ; Copy it to #REGl.
 $C408 INC A           ; Increment #REGa.
 $C409 JR $C3B0        ; Jump to #R$C3B0.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$CAF3 }
; LIST#

; Leave Room To The North
;
; Sends the player to the room to
; the north if it has gone past the north
; edge of the room. The y position is set
; to #N($FF), which #R$CC01 takes as the
; sign that the player has come out of the
; north and puts it at the south side of
; the new room.
;
; HL Distances to the walls along x and y
; IX The address of the object
;
; Leave if past the north edge.
@label=LeaveRoomToNorth
c$C40B POP HL          ; Restore #REGhl from the stack.
 $C40C LD A,H          ; Copy #REGh to #REGa.
 $C40D ADD A,$80       ; Add #N$80.
 $C40F LD H,A          ; Copy it to #REGh.
 $C410 LD A,(IX+$02)   ; Fetch the y position of the
                       ; player.
 $C413 ADD A,(IX+$0A)  ; Add the speed along the y axis.
 $C416 SUB (IX+$05)    ; Subtract the depth of the
                       ; player.
 $C419 CP H            ; {Return if the player is still in
 $C41A RET C           ; the room.}
 $C41B LD (IX+$02),$FF ; Write #N$FF to the y position.
 $C41F LD A,(IX+$08)   ; Fetch the room number.
 $C422 ADD A,$10       ; Add #N$10.
 $C424 JR $C3B7        ; Jump to #R$C3B7.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$CB0E }
; LIST#

; Leave Room To The South
;
; Sends the player to the room to
; the south if it has gone past the south
; edge of the room. The y position is set
; to #N($00), which #R$CC01 takes as the
; sign that the player has come out of the
; south and puts it at the north side of
; the new room.
;
; HL Distances to the walls along x and y
; IX The address of the object
;
; Leave if past the south edge.
@label=LeaveRoomToSouth
c$C426 POP HL          ; Restore #REGhl from the stack.
 $C427 LD A,$80        ; Set #REGa to #N$80.
 $C429 SUB H           ; Subtract #REGh.
 $C42A LD H,A          ; Copy it to #REGh.
 $C42B LD A,(IX+$02)   ; Fetch the y position of the
                       ; player.
 $C42E ADD A,(IX+$0A)  ; Add the speed along the y axis.
 $C431 ADD A,(IX+$05)  ; Add the depth of the player.
 $C434 CP H            ; {Return if the player is still in
 $C435 RET NC          ; the room.}
 $C436 LD (IX+$02),$00 ; Write #N$00 to the y position.
 $C43A LD A,(IX+$08)   ; Fetch the room number.
 $C43D SUB $10         ; Subtract #N$10.
 $C43F JP $C3B7        ; Jump to #R$C3B7.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$CB29 }
; LIST#

; Block Movement
;
; Used by the routines at #R$BFB6 and #R$C296.
; .
; Stops an object moving through
; the walls of the room or through other
; objects. The speeds along x, y and z of
; the object are each brought closer to
; zero until the object can move without
; hitting anything. Whichever direction is
; hit is flagged in the low bits of the
; collision flags: bit 0 for x, bit 1 for
; y and bit 2 for z. For z that means the
; object is standing on something. An
; object that is flagged to be ignored is
; not adjusted.
;
; IX The address of the object
;
; Ignore the object so that it does
; not hit itself, and clear the blocked
; flags.
@label=BlockMovement
c$C442 BIT 1,(IX+$07) ; {Return if the object is ignored.
 $C446 RET NZ         ; }
 $C447 SET 1,(IX+$07) ; Flag the object to be ignored, so that it does not hit
                      ; itself.
 $C44B LD A,(IX+$0C)  ; Fetch the collision flags.
 $C44E AND %11111000  ; Clear the blocked flags of x, y and z.
 $C450 LD (IX+$0C),A  ; Store the collision flags.
 $C453 LD L,$00       ; {Write #N$00 to the new speeds
 $C455 LD C,L         ; along x and y.}
; The new speeds are kept in #REGh
; for z, #REGc for x and #REGl for y. Test
; z against the floor, then other objects.
 $C456 LD A,(IX+$0B)  ; {Fetch the speed along z and test
 $C459 AND A          ; whether it is zero.}
 $C45A LD H,A         ; Copy it to #REGh.
 $C45B JR Z,$C467     ; Jump to #R$C467 if it is zero.
 $C45D CALL $C357     ; Stop the object going through the floor.
 $C460 LD A,H         ; {Jump to #R$C467 if the speed along z is now zero.
 $C461 AND A          ;
 $C462 JR Z,$C467     ; }
 $C464 CALL $C535     ; Stop the object going through other objects.
; Test x against the walls of the
; room, then other objects.
@label=BlockMovement_X
*$C467 LD A,(IX+$09)  ; {Fetch the speed along x and test
 $C46A AND A          ; whether it is zero.}
 $C46B LD C,A         ; Copy it to #REGc.
 $C46C JR Z,$C478     ; Jump to #R$C478 if it is zero.
 $C46E CALL $C5E9     ; Stop the object going through the walls of the room.
 $C471 LD A,C         ; {Jump to #R$C478 if the speed along x is now zero.
 $C472 AND A          ;
 $C473 JR Z,$C478     ; }
 $C475 CALL $C497     ; Stop the object going through other objects.
; Test y against the walls of the
; room, then other objects.
@label=BlockMovement_Y
*$C478 LD A,(IX+$0A)  ; {Fetch the speed along y and test
 $C47B AND A          ; whether it is zero.}
 $C47C LD L,A         ; Copy it to #REGl.
 $C47D JR Z,$C489     ; Jump to #R$C489 if it is zero.
 $C47F CALL $C613     ; Stop the object going through the walls of the room.
 $C482 LD A,L         ; {Jump to #R$C489 if the speed along y is now zero.
 $C483 AND A          ;
 $C484 JR Z,$C489     ; }
 $C486 CALL $C4E6     ; Stop the object going through other objects.
; Store the new speeds and stop
; ignoring the object.
@label=BlockMovement_Store
*$C489 LD (IX+$09),C  ; {Store the new speeds along x, y and z.
 $C48C LD (IX+$0A),L  ;
 $C48F LD (IX+$0B),H  ; }
 $C492 RES 1,(IX+$07) ; Stop ignoring the object.
 $C496 RET            ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$CB45 }
; { #PENTAGRAM$B6ED }
; LIST#

; Block Movement In X
;
; Used by the routine at #R$C442.
; .
; Brings the speed along x of an
; object closer to zero until it does not
; run into any other object. If the object
; does run into another, the objects may
; be killed: bit 7 of the extra flags
; means that it kills whatever it runs
; into, and bit 5 means that it kills
; whatever runs into it. Bit 6 is set to
; flag an object as killed. An object that
; is hit and can be moved takes on the
; speed along x of the object that hit it.
;
;   C Speed along x
;   L Speed along y
;   H Speed along z
;   IX The address of the object
; O:C The new speed along x
;
; Walk the object table.
@label=BlockMovementInX
c$C497 LD IY,$5B88    ; Point #REGiy at #R$5B88.
 $C49B LD B,$38       ; Set a counter of #N$38 objects.
; Skip unless the object is solid
; and already overlaps along y and z.
@label=BlockMovementInX_Next
*$C49D CALL $B74D     ; {Jump to #R$C4DE if the object is
 $C4A0 JR Z,$C4DE     ; not present or is ignored.}
 $C4A2 CALL $C5BE     ; {Jump to #R$C4DE if the objects
 $C4A5 JR NC,$C4DE    ; do not overlap along y.}
 $C4A7 CALL $C5D3     ; {Jump to #R$C4DE if the objects
 $C4AA JR NC,$C4DE    ; do not overlap along z.}
; Test whether they overlap along
; x after the move.
@label=BlockMovementInX_Test
*$C4AC CALL $C5A9     ; {Jump to #R$C4DE if the objects
 $C4AF JR NC,$C4DE    ; do not overlap along x after the move.}
; Flag the object as blocked along
; x, then apply the kill flags.
 $C4B1 SET 0,(IX+$0C) ; Flag the object as blocked along x.
 $C4B5 LD A,(IX+$0D)  ; {Fetch the extra flags and move
 $C4B8 RRCA           ; the bit that it kills what it hits into
                      ; bit 6.}
 $C4B9 AND %01000000  ; Keep the bit that flags the
                      ; other object as killed.
 $C4BB OR (IY+$0D)    ; {Set it in the extra flags of the
 $C4BE LD (IY+$0D),A  ; other object, if the object kills what
                      ; it runs into.}
 $C4C1 RLCA           ; Move the bit that the other
                      ; object kills what hits it into bit 6.
 $C4C2 AND %01000000  ; Keep the bit that flags the
                      ; object as killed.
 $C4C4 OR (IX+$0D)    ; {Set it in the extra flags of the
 $C4C7 LD (IX+$0D),A  ; object, if the other object kills what
                      ; runs into it.}
; Pass the speed along x to the
; other object if it can be moved.
 $C4CA BIT 2,(IY+$07) ; {Jump to #R$C4D6 if the other object cannot be moved.
 $C4CE JR Z,$C4D6     ; }
 $C4D0 LD A,(IX+$09)  ; {Give the speed along x to the other object.
 $C4D3 LD (IY+$09),A  ; }
; Slow the move along x and test
; this object again.
@label=BlockMovementInX_Slow
*$C4D6 LD A,C         ; Fetch the speed along x.
 $C4D7 CALL $C386     ; Bring it closer to zero.
 $C4DA LD C,A         ; Store it.
 $C4DB RET Z          ; Return if the speed is now zero.
 $C4DC JR $C4AC       ; Jump to #R$C4AC.
; Move on to the next object.
@label=BlockMovementInX_Advance
*$C4DE LD DE,$0020    ; {Point #REGiy at the next object.
 $C4E1 ADD IY,DE      ; }
 $C4E3 DJNZ $C49D     ; Jump to #R$C49D until all of the
                      ; objects have been tested.
 $C4E5 RET            ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$CB9A }
; { #PENTAGRAM$B742 }
; LIST#

; Block Movement In Y
;
; Used by the routine at #R$C442.
; .
; Brings the speed along y of an
; object closer to zero until it does not
; run into any other object. This works in
; the same way as #R$C497.
;
;   C Speed along x
;   L Speed along y
;   H Speed along z
;   IX The address of the object
; O:L The new speed along y
;
; Walk the object table.
@label=BlockMovementInY
c$C4E6 LD IY,$5B88    ; Point #REGiy at #R$5B88.
 $C4EA LD B,$38       ; Set a counter of #N$38 objects.
; Skip unless the object is solid
; and already overlaps along x and z.
@label=BlockMovementInY_Next
*$C4EC CALL $B74D     ; {Jump to #R$C52D if the object is
 $C4EF JR Z,$C52D     ; not present or is ignored.}
 $C4F1 CALL $C5A9     ; {Jump to #R$C52D if the objects
 $C4F4 JR NC,$C52D    ; do not overlap along x.}
 $C4F6 CALL $C5D3     ; {Jump to #R$C52D if the objects
 $C4F9 JR NC,$C52D    ; do not overlap along z.}
; Test whether they overlap along
; y after the move.
@label=BlockMovementInY_Test
*$C4FB CALL $C5BE     ; {Jump to #R$C52D if the objects
 $C4FE JR NC,$C52D    ; do not overlap along y after the move.}
; Flag the object as blocked along
; y, then apply the kill flags.
 $C500 SET 1,(IX+$0C) ; Flag the object as blocked along y.
 $C504 LD A,(IX+$0D)  ; {Fetch the extra flags and move
 $C507 RRCA           ; the bit that it kills what it hits into
                      ; bit 6.}
 $C508 AND %01000000  ; Keep the bit that flags the
                      ; other object as killed.
 $C50A OR (IY+$0D)    ; {Set it in the extra flags of the
 $C50D LD (IY+$0D),A  ; other object, if the object kills what
                      ; it runs into.}
 $C510 RLCA           ; Move the bit that the other
                      ; object kills what hits it into bit 6.
 $C511 AND %01000000  ; Keep the bit that flags the
                      ; object as killed.
 $C513 OR (IX+$0D)    ; {Set it in the extra flags of the
 $C516 LD (IX+$0D),A  ; object, if the other object kills what
                      ; runs into it.}
; Pass the speed along y to the
; other object if it can be moved.
 $C519 BIT 2,(IY+$07) ; {Jump to #R$C525 if the other object cannot be moved.
 $C51D JR Z,$C525     ; }
 $C51F LD A,(IX+$0A)  ; {Give the speed along y to the other object.
 $C522 LD (IY+$0A),A  ; }
; Slow the move along y and test
; this object again.
@label=BlockMovementInY_Slow
*$C525 LD A,L         ; Fetch the speed along y.
 $C526 CALL $C386     ; Bring it closer to zero.
 $C529 LD L,A         ; Store it.
 $C52A RET Z          ; Return if the speed is now zero.
 $C52B JR $C4FB       ; Jump to #R$C4FB.
; Move on to the next object.
@label=BlockMovementInY_Advance
*$C52D LD DE,$0020    ; {Point #REGiy at the next object.
 $C530 ADD IY,DE      ; }
 $C532 DJNZ $C4EC     ; Jump to #R$C4EC until all of the
                      ; objects have been tested.
 $C534 RET            ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$CBE9 }
; { #PENTAGRAM$B791 }
; LIST#

; Block Movement In Z
;
; Used by the routine at #R$C442.
; .
; Brings the speed along z of an
; object closer to zero until it does not
; run into any other object. This works in
; the same way as #R$C497, except that the
; object that is hit is flagged as touched
; (bit 3 of its extra flags) if the player
; is the object that hit it. An object
; which can be moved gives its speed along
; z to the other object, and takes on the
; speeds along x and y of the other object
; if it has none of its own.
;
;   C Speed along x
;   L Speed along y
;   H Speed along z
;   IX The address of the object
; O:H The new speed along z
;
; Walk the object table.
@label=BlockMovementInZ
c$C535 LD IY,$5B88    ; Point #REGiy at #R$5B88.
 $C539 LD B,$38       ; Set a counter of #N$38 objects.
; Skip unless the object is solid
; and already overlaps along x and y.
@label=BlockMovementInZ_Next
*$C53B CALL $B74D     ; {Jump to #R$C5A1 if the object is
 $C53E JR Z,$C5A1     ; not present or is ignored.}
 $C540 CALL $C5A9     ; {Jump to #R$C5A1 if the objects
 $C543 JR NC,$C5A1    ; do not overlap along x.}
 $C545 CALL $C5BE     ; {Jump to #R$C5A1 if the objects
 $C548 JR NC,$C5A1    ; do not overlap along y.}
; Test whether they overlap along
; z after the move.
@label=BlockMovementInZ_Test
*$C54A CALL $C5D3     ; {Jump to #R$C5A1 if the objects
 $C54D JR NC,$C5A1    ; do not overlap along z after the move.}
; Flag the object as blocked along
; z, then apply the kill flags.
 $C54F SET 2,(IX+$0C) ; Flag the object as blocked along z.
 $C553 LD A,(IX+$0D)  ; {Fetch the extra flags and move
 $C556 RRCA           ; the bit that it kills what it hits into
                      ; bit 6.}
 $C557 AND %01000000  ; Keep the bit that flags the
                      ; other object as killed.
 $C559 OR (IY+$0D)    ; {Set it in the extra flags of the
 $C55C LD (IY+$0D),A  ; other object, if the object kills what
                      ; it runs into.}
 $C55F RLCA           ; Move the bit that the other
                      ; object kills what hits it into bit 6.
 $C560 AND %01000000  ; Keep the bit that flags the
                      ; object as killed.
 $C562 OR (IX+$0D)    ; {Set it in the extra flags of the
 $C565 LD (IX+$0D),A  ; object, if the other object kills what
                      ; runs into it.}
; Pass speeds if this object can
; be moved. Flag the other object as
; touched if the player is standing on it.
 $C568 BIT 2,(IX+$07) ; {Jump to #R$C599 if the object cannot be moved.
 $C56C JR Z,$C599     ; }
 $C56E LD A,(IX+$00)  ; {Fetch the sprite number and
 $C571 SUB $10        ; subtract #N$10.}
 $C573 CP $20         ; {Jump to #R$C57B if it is not
 $C575 JR NC,$C57B    ; the player.}
 $C577 SET 3,(IY+$0D) ; Flag the other object as touched.
; Give the speed along z to the
; other object, and take its speeds along
; x and y if this object has none.
@label=BlockMovementInZ_Carry
*$C57B LD A,(IX+$0B)  ; {Give the speed along z to the other object.
 $C57E LD (IY+$0B),A  ; }
 $C581 LD A,(IX+$09)  ; {Fetch the speed along x and test it.
 $C584 AND A          ; }
 $C585 JR NZ,$C58D    ; Jump to #R$C58D if it has one.
 $C587 LD A,(IY+$09)  ; {Take the speed along x of the other object.
 $C58A LD (IX+$09),A  ; }
@label=BlockMovementInZ_Y
*$C58D LD A,(IX+$0A)  ; {Fetch the speed along y and test it.
 $C590 AND A          ; }
 $C591 JR NZ,$C599    ; Jump to #R$C599 if it has one.
 $C593 LD A,(IY+$0A)  ; {Take the speed along y of the other object.
 $C596 LD (IX+$0A),A  ; }
; Slow the move along z and test
; this object again.
@label=BlockMovementInZ_Slow
*$C599 LD A,H         ; Fetch the speed along z.
 $C59A CALL $C386     ; Bring it closer to zero.
 $C59D LD H,A         ; Store it.
 $C59E RET Z          ; Return if the speed is now zero.
 $C59F JR $C54A       ; Jump to #R$C54A.
; Move on to the next object.
@label=BlockMovementInZ_Advance
*$C5A1 LD DE,$0020    ; {Point #REGiy at the next object.
 $C5A4 ADD IY,DE      ; }
 $C5A6 DJNZ $C53B     ; Jump to #R$C53B until all of the
                      ; objects have been tested.
 $C5A8 RET            ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$CC38 }
; LIST#

; Test Overlap In X
;
; Used by the routines at #R$B712, #R$BEAF, #R$C497, #R$C4E6 and #R$C535.
; .
; Tests whether two objects overlap
; along x, once the first has moved by its
; new speed along x. They overlap when the
; distance between the x positions is
; smaller than the two widths added
; together.
;
;   C New speed along x of the first object
;   IX The address of the first object
;   IY The address of the second object
; O:F Carry flag set if the objects overlap
;
; Compare the x distance with the
; widths.
@label=TestOverlapInX
c$C5A9 LD A,(IX+$04)  ; Fetch the width of the first
                      ; object.
 $C5AC ADD A,(IY+$04) ; Add the width of the second
                      ; object.
 $C5AF LD D,A         ; Copy the total to #REGd.
 $C5B0 LD A,(IX+$01)  ; Fetch the x position of the
                      ; first object.
 $C5B3 ADD A,C        ; Add #REGc.
 $C5B4 SUB (IY+$01)   ; Subtract the x position of the
                      ; second object.
 $C5B7 JP P,$C5BC     ; Jump to #R$C5BC if the sign flag
                      ; is clear.
 $C5BA NEG            ; Negate #REGa.
@label=TestOverlapInX_Compare
*$C5BC SUB D          ; Subtract #REGd.
 $C5BD RET            ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$CC9D }
; { #PENTAGRAM$B8A2 }
; LIST#

; Test Overlap In Y
;
; Used by the routines at #R$B712, #R$BEAF, #R$C497, #R$C4E6 and #R$C535.
; .
; Tests whether two objects overlap
; along y, once the first has moved by its
; new speed along y. They overlap when the
; distance between the y positions is
; smaller than the two depths added
; together.
;
;   L New speed along y of the first object
;   IX The address of the first object
;   IY The address of the second object
; O:F Carry flag set if the objects overlap
;
; Compare the y distance with the
; depths.
@label=TestOverlapInY
c$C5BE LD A,(IX+$05)  ; Fetch the depth of the first
                      ; object.
 $C5C1 ADD A,(IY+$05) ; Add the depth of the second
                      ; object.
 $C5C4 LD D,A         ; Copy the total to #REGd.
 $C5C5 LD A,(IX+$02)  ; Fetch the y position of the
                      ; first object.
 $C5C8 ADD A,L        ; Add #REGl.
 $C5C9 SUB (IY+$02)   ; Subtract the y position of the
                      ; second object.
 $C5CC JP P,$C5D1     ; Jump to #R$C5D1 if the sign flag
                      ; is clear.
 $C5CF NEG            ; Negate #REGa.
@label=TestOverlapInY_Compare
*$C5D1 SUB D          ; Subtract #REGd.
 $C5D2 RET            ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$CCB2 }
; { #PENTAGRAM$B8B7 }
; LIST#

; Test Overlap In Z
;
; Used by the routines at #R$B712, #R$BEAF, #R$C497, #R$C4E6 and #R$C535.
; .
; Tests whether two objects overlap
; along z, once the first has moved by its
; new speed along z. They overlap when the
; distance between the z positions is
; smaller than the height of whichever of
; the objects is lower.
;
;   H New speed along z of the first object
;   IX The address of the first object
;   IY The address of the second object
; O:F Carry flag set if the objects overlap
;
; Use the height of the lower
; object.
@label=TestOverlapInZ
c$C5D3 LD A,(IX+$03) ; Fetch the z position of the
                     ; first object.
 $C5D6 ADD A,H       ; Add #REGh.
 $C5D7 SUB (IY+$03)  ; Subtract the z position of the
                     ; second object.
 $C5DA JP P,$C5E4    ; Jump to #R$C5E4 if the sign flag
                     ; is clear.
 $C5DD NEG           ; Negate #REGa.
 $C5DF LD D,(IX+$06) ; Fetch the height of the first
                     ; object.
@label=TestOverlapInZ_Compare
*$C5E2 SUB D         ; Subtract #REGd.
 $C5E3 RET           ; Return.
@label=TestOverlapInZ_Second
*$C5E4 LD D,(IY+$06) ; Fetch the height of the second
                     ; object.
 $C5E7 JR $C5E2      ; Jump to #R$C5E2.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$CCC7 }
; { #PENTAGRAM$B8CC }
; LIST#

; Keep Object In Room In X
;
; Used by the routine at #R$C442.
; .
; Brings the speed along x of an
; object closer to zero until the object
; stays within the walls of the room.
; Nothing is done while the object is
; entering the room, or while it is near
; an arch, as it can then go out through
; the wall.
;
;   C Speed along x
;   IX The address of the object
; O:C The new speed along x
;
; Return while entering or near an
; arch.
@label=KeepObjectInRoomInX
c$C5E9 LD A,(IX+$0C)  ; Fetch the collision flags.
 $C5EC AND %11110000  ; Keep only bits 4-7.
 $C5EE RET NZ         ; Return if the object is entering the room.
 $C5EF BIT 0,(IX+$07) ; {Return if the object is near an arch.
 $C5F3 RET NZ         ; }
 $C5F4 LD A,($5B0B)   ; Fetch #R$5B0B.
 $C5F7 LD B,A         ; Copy it to #REGb.
; Slow x until the object stays in
; the room.
@label=KeepObjectInRoomInX_Test
*$C5F8 LD A,(IX+$01)  ; Fetch the x position of the
                      ; object.
 $C5FB ADD A,C        ; Add #REGc.
 $C5FC SUB $80        ; Subtract #N$80.
 $C5FE JR NC,$C602    ; Jump to #R$C602 if carry is not
                      ; set.
 $C600 NEG            ; Negate #REGa.
@label=KeepObjectInRoomInX_Compare
*$C602 ADD A,(IX+$04) ; Add the width of the object.
 $C605 CP B           ; {Return if the object stays in
 $C606 RET C          ; the room.}
 $C607 SET 0,(IX+$0C) ; Set bit 0 of the collision
                      ; flags.
 $C60B LD A,C         ; Copy #REGc to #REGa.
 $C60C CALL $C386     ; Call #R$C386.
 $C60F LD C,A         ; Copy it to #REGc.
 $C610 JR NZ,$C5F8    ; Jump to #R$C5F8 if it is not
                      ; zero.
 $C612 RET            ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$CCDD }
; { #PENTAGRAM$B8E2 }
; LIST#

; Keep Object In Room In Y
;
; Used by the routine at #R$C442.
; .
; Brings the speed along y of an
; object closer to zero until the object
; stays within the walls of the room.
; Nothing is done while the object is
; entering the room, or while it is near
; an arch, as it can then go out through
; the wall.
;
;   L Speed along y
;   IX The address of the object
; O:L The new speed along y
;
; Return while entering or near an
; arch.
@label=KeepObjectInRoomInY
c$C613 LD A,(IX+$0C)  ; Fetch the collision flags.
 $C616 AND %11110000  ; Keep only bits 4-7.
 $C618 RET NZ         ; Return if the object is entering the room.
 $C619 BIT 0,(IX+$07) ; {Return if the object is near an arch.
 $C61D RET NZ         ; }
 $C61E LD A,($5B0C)   ; Fetch #R$5B0C.
 $C621 LD B,A         ; Copy it to #REGb.
; Slow y until the object stays in
; the room.
@label=KeepObjectInRoomInY_Test
*$C622 LD A,(IX+$02)  ; Fetch the y position of the
                      ; object.
 $C625 ADD A,L        ; Add #REGl.
 $C626 SUB $80        ; Subtract #N$80.
 $C628 JR NC,$C62C    ; Jump to #R$C62C if carry is not
                      ; set.
 $C62A NEG            ; Negate #REGa.
@label=KeepObjectInRoomInY_Compare
*$C62C ADD A,(IX+$05) ; Add the depth of the object.
 $C62F CP B           ; {Return if the object stays in
 $C630 RET C          ; the room.}
 $C631 SET 1,(IX+$0C) ; Set bit 1 of the collision
                      ; flags.
 $C635 LD A,L         ; Copy #REGl to #REGa.
 $C636 CALL $C386     ; Call #R$C386.
 $C639 LD L,A         ; Copy it to #REGl.
 $C63A JR NZ,$C622    ; Jump to #R$C622 if it is not
                      ; zero.
 $C63C RET            ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$CD08 }
; { #PENTAGRAM$B90D }
; LIST#

; Calculate Sprite Size
;
; Used by the routine at #R$C657.
; .
; Works out where an object is on
; the screen and how much of the screen
; its sprite covers. The width in bytes is
; one more than the width of the sprite if
; the sprite does not start on a byte
; boundary, because it has to be shifted
; across.
;
; IX The address of the object
;
; Widen the sprite if it is shifted.
@label=CalculateSpriteSize
c$C63D CALL $CFD2    ; Call #R$CFD2.
 $C640 CALL $CFFE    ; Call #R$CFFE.
 $C643 LD A,(IX+$1A) ; Fetch the pixel x position.
 $C646 AND %00000111 ; Keep only bits 0-2.
 $C648 LD A,(DE)     ; Fetch the width of the sprite
                     ; in bytes.
 $C649 INC DE        ; Move on to the height.
 $C64A JR Z,$C64D    ; Jump to #R$C64D if they were
                     ; zero.
 $C64C INC A         ; Increment #REGa.
@label=CalculateSpriteSize_Store
*$C64D AND %00001111 ; Keep only bits 0-3.
 $C64F LD (IX+$18),A ; Store the width in bytes.
 $C652 LD A,(DE)     ; Fetch the height of the sprite
                     ; in lines.
 $C653 LD (IX+$19),A ; Store the height in lines.
 $C656 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$CD33 }
; { #PENTAGRAM$B938 }
; LIST#

; Flag Overlapping Objects
;
; Used by the routines at #R$BFAB and #R$C6E4.
; .
; Flags every object that overlaps
; the area of the screen covered by an
; object to be drawn again. The area is
; the one that is covered by the old and
; the new position of the sprite of the
; object together, so that the whole of it
; is redrawn.
;
; IX The address of the object
;
; The left edge, in bytes, is the
; lower of the old and new positions. It
; is kept in #REGe.
@label=FlagOverlappingObjects
c$C657 LD IY,$5B88    ; Point #REGiy at #R$5B88.
 $C65B CALL $C63D     ; Call #R$C63D.
 $C65E LD B,$38       ; Set #REGb to #N$38.
 $C660 LD A,(IX+$1A)  ; Fetch the new pixel x position.
 $C663 RRCA           ; {Divide it by eight.
 $C664 RRCA           ;
 $C665 RRCA           ; }
 $C666 AND %00011111  ; Keep only bits 0-4.
 $C668 LD L,A         ; Copy it to #REGl.
 $C669 LD A,(IX+$1E)  ; Fetch the old pixel x position.
 $C66C RRCA           ; {Divide it by eight.
 $C66D RRCA           ;
 $C66E RRCA           ; }
 $C66F AND %00011111  ; Keep only bits 0-4.
 $C671 LD H,A         ; Copy it to #REGh.
 $C672 CP L           ; {Jump to #R$C676 if the old is
 $C673 JR C,$C676     ; lower.}
 $C675 LD A,L         ; Copy #REGl to #REGa.
@label=FlagOverlappingObjects_RightEdge
*$C676 LD E,A         ; Copy it to #REGe.
; The width is the higher right
; edge less the left edge. It is kept in
; #REGd.
 $C677 LD A,L         ; Copy #REGl to #REGa.
 $C678 ADD A,(IX+$18) ; Add the new width.
 $C67B LD L,A         ; Copy it to #REGl.
 $C67C LD A,H         ; Copy #REGh to #REGa.
 $C67D ADD A,(IX+$1C) ; Add the old width.
 $C680 CP L           ; {Jump to #R$C684 if it is
 $C681 JR NC,$C684    ; higher.}
 $C683 LD A,L         ; Copy #REGl to #REGa.
@label=FlagOverlappingObjects_AreaWidth
*$C684 SUB E          ; Subtract #REGe.
 $C685 LD D,A         ; Copy it to #REGd.
; The bottom edge is the lower of
; the old and new pixel y. It is kept in
; #REGl.
 $C686 LD A,(IX+$1B)  ; Fetch the new pixel y position.
 $C689 CP (IX+$1F)    ; Compare it with the old one.
 $C68C JR C,$C691     ; Jump to #R$C691 if the new one
                      ; is lower.
 $C68E LD A,(IX+$1F)  ; Fetch the old pixel y position.
@label=FlagOverlappingObjects_TopEdge
*$C691 LD L,A         ; Copy it to #REGl.
; The height is the higher top edge
; less the bottom edge. It is kept in
; #REGh.
 $C692 LD A,(IX+$1B)  ; Fetch the new pixel y position.
 $C695 ADD A,(IX+$19) ; Add the new height.
 $C698 LD H,A         ; Copy it to #REGh.
 $C699 LD A,(IX+$1F)  ; Fetch the old pixel y position.
 $C69C ADD A,(IX+$1D) ; Add the old height.
 $C69F CP H           ; {Jump to #R$C6A3 if it is
 $C6A0 JR NC,$C6A3    ; higher.}
 $C6A2 LD A,H         ; Copy #REGh to #REGa.
@label=FlagOverlappingObjects_AreaHeight
*$C6A3 SUB L          ; Subtract #REGl.
 $C6A4 LD H,A         ; Copy it to #REGh.
; Flag any object that overlaps the
; area.
@label=FlagOverlappingObjects_Next
*$C6A5 LD A,(IY+$00)  ; Fetch the sprite number of the
                      ; other object.
 $C6A8 AND A          ; {Jump to #R$C6CC if it is zero.
 $C6A9 JR Z,$C6CC     ; }
 $C6AB BIT 4,(IY+$07) ; {Jump to #R$C6CC if the object is already flagged to be
 $C6AF JR NZ,$C6CC    ; drawn.}
 $C6B1 LD A,(IY+$1A)  ; Fetch the pixel x position of
                      ; the other object.
 $C6B4 RRCA           ; {Divide it by eight.
 $C6B5 RRCA           ;
 $C6B6 RRCA           ; }
 $C6B7 AND %00011111  ; Keep only bits 0-4.
 $C6B9 SUB E          ; Subtract #REGe.
 $C6BA JR C,$C6D6     ; Jump to #R$C6D6 if carry is
                      ; set.
 $C6BC CP D           ; Compare it with #REGd.
@label=FlagOverlappingObjects_Right
*$C6BD JR NC,$C6CC    ; Jump to #R$C6CC if carry is not
                      ; set.
 $C6BF LD A,(IY+$1B)  ; Fetch the pixel y position of
                      ; the other object.
 $C6C2 SUB L          ; Subtract #REGl.
 $C6C3 JR C,$C6DD     ; Jump to #R$C6DD if carry is
                      ; set.
 $C6C5 CP H           ; Compare it with #REGh.
@label=FlagOverlappingObjects_Top
*$C6C6 JR NC,$C6CC    ; Jump to #R$C6CC if carry is not
                      ; set.
 $C6C8 SET 4,(IY+$07) ; Set bit 4 of the flags.
@label=FlagOverlappingObjects_Advance
*$C6CC EXX            ; Switch to the shadow registers.
 $C6CD LD DE,$0020    ; Set #REGde' to #N($0020,$04,$04).
 $C6D0 ADD IY,DE      ; Add #REGde' to #REGiy.
 $C6D2 EXX            ; Switch to the main registers.
 $C6D3 DJNZ $C6A5     ; Jump to #R$C6A5 until #REGb is
                      ; zero.
 $C6D5 RET            ; Return.
; The object starts to the left of
; the area, so it overlaps only if it is
; wide enough to reach the area.
@label=FlagOverlappingObjects_Left
*$C6D6 NEG            ; Negate #REGa.
 $C6D8 CP (IY+$18)    ; Compare it with the width of
                      ; the other object.
 $C6DB JR $C6BD       ; Jump to #R$C6BD.
; The object starts below the area,
; so it overlaps only if it is tall enough
; to reach the area.
@label=FlagOverlappingObjects_Below
*$C6DD NEG            ; Negate #REGa.
 $C6DF CP (IY+$19)    ; Compare it with the height of
                      ; the other object.
 $C6E2 JR $C6C6       ; Jump to #R$C6C6.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$CD4D }
; { #PENTAGRAM$B9A7 }
; LIST#

; Handle Player Top
;
; Does all of the work for the top
; half of the robot (objects #N$20 to
; #N$2B), which is a copy of the bottom
; half placed #N$0C above it. The top half
; is one unit shorter than the bottom
; half. If the top half has been flagged
; as killed this flags the bottom half as
; killed too and turns the player into a
; sparkle.
;
; IX The address of the object
;
; Turn into a sparkle if killed.
@label=HandlePlayerTop
c$C6E4 CALL $BF6F     ; Call #R$BF6F.
 $C6E7 BIT 6,(IX+$0D) ; {Jump to #R$C6F4 if the player has not been killed.
 $C6EB JR Z,$C6F4     ; }
 $C6ED SET 6,(IX-$13) ; Set bit 6 of the bottom half
                      ; extra flags.
 $C6F1 JP $B39A       ; Jump to #R$B39A.
; Copy the bottom half and raise it.
@label=HandlePlayerTop_Copy
*$C6F4 PUSH IX        ; {Copy #REGix to #REGde (using
 $C6F6 POP DE         ; the stack).}
 $C6F7 LD HL,$FFE0    ; {Point #REGhl at the bottom half.
 $C6FA ADD HL,DE      ; }
 $C6FB PUSH HL        ; {Copy #REGhl to #REGiy (using
 $C6FC POP IY         ; the stack).}
 $C6FE INC DE         ; Increment #REGde.
 $C6FF INC HL         ; Increment #REGhl.
 $C700 LD BC,$0007    ; Set #REGbc to #N($0007,$04,$04).
 $C703 LDIR           ; Copy the position, size and
                      ; flags.
 $C705 DEC (IX+$06)   ; Decrement the height of the top
                      ; half.
 $C708 LD A,(IY+$00)  ; Fetch the sprite number of the
                      ; bottom half.
 $C70B ADD A,$10      ; Add #N$10.
 $C70D LD (IX+$00),A  ; Set the sprite number of the
                      ; top half.
 $C710 LD A,(IY+$03)  ; Fetch the z position of the
                      ; bottom half.
 $C713 ADD A,$0C      ; Add #N$0C.
 $C715 LD (IX+$03),A  ; Set the z position of the top
                      ; half.
 $C718 CALL $C657     ; Call #R$C657.
 $C71B RET            ; Return.

; List Objects To Draw
;
; Used by the routine at #R$A68B.
; .
; Makes the list at #R$C745 of the
; objects that have to be drawn again.
; Each entry is the index of an object in
; the table of objects (#R$5B88), and the
; list ends with #N$FF. An object is in
; the list if it is present and flagged to
; be drawn.
;
; .
;
; Point at the first object and
; the start of the list.
@label=ListObjectsToDraw
c$C71C PUSH IX        ; Stash #REGix on the stack.
 $C71E LD B,$38       ; Set a counter of #N$38 objects.
 $C720 LD DE,$0020    ; Set #REGde to #N($0020,$04,$04).
 $C723 LD IX,$5B88    ; Point #REGix at #R$5B88.
 $C727 LD HL,$C745    ; Point #REGhl at #R$C745.
 $C72A LD C,$00       ; Set the index to #N$00.
; Add the object if it is present
; and flagged to be drawn.
@label=ListObjectsToDraw_Next
*$C72C LD A,(IX+$00)  ; {Fetch the sprite number and test
 $C72F AND A          ; whether the slot is used.}
 $C730 JR Z,$C73A     ; Jump to #R$C73A if it is not.
 $C732 BIT 4,(IX+$07) ; {Jump to #R$C73A if the object is not flagged to be
 $C736 JR Z,$C73A     ; drawn.}
 $C738 LD (HL),C      ; Add the index of the object to the list.
 $C739 INC HL         ; Move on to the next place in the list.
; Move on to the next object.
@label=ListObjectsToDraw_Advance
*$C73A INC C          ; Go to the next index.
 $C73B ADD IX,DE      ; Point #REGix at the next object.
 $C73D DJNZ $C72C     ; Jump to #R$C72C until all of the
                      ; objects have been tested.
; Mark the end of the list.
 $C73F LD A,$FF       ; {Store the end marker.
 $C741 LD (HL),A      ; }
 $C742 POP IX         ; Restore #REGix from the stack.
 $C744 RET            ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$CE62 }
; { #PENTAGRAM$B531 }
; LIST#

; List Of Objects To Draw
;
; The indexes of the objects that
; have to be drawn, made by #R$C71C and
; ending with #N$FF. As an object is drawn
; bit 7 of its entry is set.
@label=ObjectsToDrawList
b$C745 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $C74D DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $C755 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $C75D DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $C765 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $C76D DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $C775 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $C77D DEFB $00,$00,$00,$00,$00,$00,$00,$00

; Draw Objects In Order
;
; Used by the routine at #R$CEAB.
; .
; Draws the objects in the list at
; #R$C745 so that the objects at the back
; are drawn before the objects in front of
; them. It takes the first object in the
; list that has not been drawn yet and
; compares it with each of the other
; objects that are waiting. If another
; object has to be drawn first, that
; object takes the place of the first
; object and is compared with the others
; in its turn. This carries on until an
; object is found that does not have to
; wait for any other object, and that one
; is drawn. This is repeated until the
; list is empty. The objects drawn are
; counted in #R$5B1E.
;
; .
;
; Clear the count and find the
; first object that is still waiting.
@label=DrawObjectsInOrder
c$C785 XOR A          ; {Write #N$00 to #R$5B1E.
 $C786 LD ($5B1E),A   ; }
 $C789 PUSH IX        ; {Stash #REGix and #REGiy on the
 $C78B PUSH IY        ; stack.}
; This entry point is used by the routines at #R$C86F and #R$C8D5.
@label=DrawObjectsInOrder_First
*$C78D LD DE,$C745    ; Point #REGde at #R$C745.
; Skip entries that have already
; been drawn.
@label=DrawObjectsInOrder_FindFirst
*$C790 LD A,(DE)      ; Fetch an index from the list.
 $C791 INC DE         ; Move on to the next entry.
 $C792 CP $FF         ; {Jump to #R$C8EA if it is the end of the list.
 $C794 JP Z,$C8EA     ; }
 $C797 BIT 7,A        ; {Jump to #R$C790 if the object has been drawn.
 $C799 JR NZ,$C790    ; }
 $C79B CALL $CC96     ; Find the address of the object.
 $C79E LD ($5B2D),DE  ; Remember the place in the list.
 $C7A2 PUSH HL        ; {Point #REGix at the object.
 $C7A3 POP IX         ; }
; This entry point is used by the routines at #R$C869, #R$C86F and #R$C8AB.
; .
; Compare it with each later
; object that is still waiting.
@label=DrawObjectsInOrder_FindSecond
*$C7A5 LD A,(DE)      ; Fetch an index from the list.
 $C7A6 INC DE         ; Move on to the next entry.
 $C7A7 CP $FF         ; {Jump to #R$C8D5 if it is the
 $C7A9 JP Z,$C8D5     ; end of the list, as nothing has to be
                      ; drawn before the first object.}
 $C7AC BIT 7,A        ; {Jump to #R$C7A5 if the object has been drawn.
 $C7AE JR NZ,$C7A5    ; }
 $C7B0 CALL $CC96     ; Find the address of the object.
 $C7B3 LD ($5B2F),DE  ; Remember the place in the list.
 $C7B7 PUSH HL        ; {Point #REGiy at the other object.
 $C7B8 POP IY         ; }
 $C7BA PUSH IX        ; {Copy #REGix to #REGbc (using
 $C7BC POP BC         ; the stack).}
 $C7BD AND A          ; {Jump to #R$C7A5 if they are the same object.
 $C7BE SBC HL,BC      ;
 $C7C0 JR Z,$C7A5     ; }
; Each of the three directions
; gives a number. The number along z is
; #N$00 if the first object is above the
; other, #N$01 if the objects overlap
; along z and #N$02 if the first object is
; below. The number along y is #N$00 if
; the first object is to the north of the
; other, #N$03 if the objects overlap
; along y and #N$06 if the first object is
; to the south. The number along x is
; #N$00 if the first object is to the east
; of the other, #N$09 if the objects
; overlap along x and #N$12 if the first
; object is to the west. The three numbers
; are added together in #REGc.
 $C7C2 LD C,$00       ; Set the number to #N$00.
 $C7C4 LD A,(IY+$03)  ; {Work out where the top of the
 $C7C7 ADD A,(IY+$06) ; other object is.
 $C7CA LD L,A         ; }
 $C7CB LD A,(IX+$03)  ; {Take it off the z position of
 $C7CE SUB L          ; the first object.}
 $C7CF JR NC,$C7E0    ; Jump to #R$C7E0 if the first
                      ; object is above the other.
 $C7D1 LD A,(IX+$03)  ; {Work out where the top of the
 $C7D4 ADD A,(IX+$06) ; first object is.
 $C7D7 LD L,A         ; }
 $C7D8 LD A,(IY+$03)  ; {Take it off the z position of
 $C7DB SUB L          ; the other object.}
 $C7DC JR C,$C7DF     ; Jump to #R$C7DF if the objects
                      ; overlap along z.
 $C7DE INC C          ; Add one to the number along z.
@label=DrawObjectsInOrder_Overlap
*$C7DF INC C          ; Add one to the number along z.
; Add the number along y.
@label=DrawObjectsInOrder_Y
*$C7E0 LD A,(IY+$02)  ; {Work out where the north edge
 $C7E3 ADD A,(IY+$05) ; of the other object is.
 $C7E6 LD L,A         ; }
 $C7E7 LD A,(IX+$02)  ; {Work out where the south edge
 $C7EA SUB (IX+$05)   ; of the first object is, and take the
 $C7ED SUB L          ; north edge of the other object off it.}
 $C7EE JR NC,$C806    ; Jump to #R$C806 if the first
                      ; object is to the north of the other.
 $C7F0 LD A,(IX+$02)  ; {Work out where the north edge
 $C7F3 ADD A,(IX+$05) ; of the first object is.
 $C7F6 LD L,A         ; }
 $C7F7 LD A,(IY+$02)  ; {Work out where the south edge
 $C7FA SUB (IY+$05)   ; of the other object is, and take the
 $C7FD SUB L          ; north edge of the first object off it.}
 $C7FE LD A,C         ; Fetch the number so far.
 $C7FF JR C,$C803     ; Jump to #R$C803 if the objects
                      ; overlap along y.
 $C801 ADD A,$03      ; Add #N$03 to the number along y.
@label=DrawObjectsInOrder_OverlapY
*$C803 ADD A,$03      ; Add #N$03 to the number along y.
 $C805 LD C,A         ; Store the number.
; Add the number along x.
@label=DrawObjectsInOrder_X
*$C806 LD A,(IY+$01)  ; {Work out where the east edge
 $C809 ADD A,(IY+$04) ; of the other object is.
 $C80C LD L,A         ; }
 $C80D LD A,(IX+$01)  ; {Work out where the west edge
 $C810 SUB (IX+$04)   ; of the first object is, and take the
 $C813 SUB L          ; east edge of the other object off it.}
 $C814 JR NC,$C82C    ; Jump to #R$C82C if the first
                      ; object is to the east of the other.
 $C816 LD A,(IX+$01)  ; {Work out where the east edge
 $C819 ADD A,(IX+$04) ; of the first object is.
 $C81C LD L,A         ; }
 $C81D LD A,(IY+$01)  ; {Work out where the west edge
 $C820 SUB (IY+$04)   ; of the other object is, and take the
 $C823 SUB L          ; east edge of the first object off it.}
 $C824 LD A,C         ; Fetch the number so far.
 $C825 JR C,$C829     ; Jump to #R$C829 if the objects
                      ; overlap along x.
 $C827 ADD A,$09      ; Add #N$09 to the number along x.
@label=DrawObjectsInOrder_OverlapX
*$C829 ADD A,$09      ; Add #N$09 to the number along x.
 $C82B LD C,A         ; Store the number.
; Jump to the routine for the
; number.
@label=DrawObjectsInOrder_Jump
*$C82C LD L,C         ; Use the number as the index into the table.
 $C82D LD BC,$C833    ; Point #REGbc at #R$C833.
 $C830 JP $A6B7       ; Jump to #R$A6B7.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$CEBB }
; { #PENTAGRAM$B58A }
; LIST#

; Drawing Order Table
;
; The routines that decide what is
; done about a pair of objects, by the
; number made from the directions in
; #R$C7C2. The number is the number along
; z plus the number along y plus the
; number along x. Either the first object
; is not held up by the other, or the
; other object has to be drawn first, or
; the objects fill the same space.
@label=DrawingOrderTable
w$C833 DEFW $C869    ; {#N$00 to #N$02: the first object is not held up.
 $C835 DEFW $C869    ;
 $C837 DEFW $C869    ; }
 $C839 DEFW $C86F    ; {#N$03 and #N$04: the other object is drawn first.
 $C83B DEFW $C86F    ; }
 $C83D DEFW $C869    ; #N$05: the first object is not held up.
 $C83F DEFW $C86F    ; {#N$06 and #N$07: the other object is drawn first.
 $C841 DEFW $C86F    ; }
 $C843 DEFW $C869    ; {#N$08 and #N$09: the first object is not held up.
 $C845 DEFW $C869    ; }
 $C847 DEFW $C86C    ; {#N$0A and #N$0B: the first object is not held up.
 $C849 DEFW $C86C    ; }
 $C84B DEFW $C86F    ; #N$0C: the other object is drawn first.
 $C84D DEFW $C8AB    ; #N$0D: the objects fill the same space.
 $C84F DEFW $C86C    ; #N$0E: the first object is not held up.
 $C851 DEFW $C86F    ; {#N$0F and #N$10: the other object is drawn first.
 $C853 DEFW $C86F    ; }
 $C855 DEFW $C869    ; {#N$11 and #N$12: the first object is not held up.
 $C857 DEFW $C869    ; }
 $C859 DEFW $C86C    ; {#N$13 and #N$14: the first object is not held up.
 $C85B DEFW $C86C    ; }
 $C85D DEFW $C869    ; #N$15: the first object is not held up.
 $C85F DEFW $C86C    ; {#N$16 and #N$17: the first object is not held up.
 $C861 DEFW $C86C    ; }
 $C863 DEFW $C869    ; {#N$18 to #N$1A: the first object is not held up.
 $C865 DEFW $C869    ;
 $C867 DEFW $C869    ; }

; Continue Comparing Objects
;
; The first object is not held up
; by the other object, so go on to compare
; it with the next one. The table at
; #R$C833 has two entries that come here.
;
; .
;
; Compare the first object with the
; next one.
@label=ContinueComparingObjects
c$C869 JP $C7A5      ; Jump to #R$C7A5.
; The other table entry does the
; same.
@label=ContinueComparingObjects_Alternate
 $C86C JP $C7A5      ; Jump to #R$C7A5.

; Compare With Other Object
;
; Makes the other object the first
; object and starts the comparisons again
; from the beginning of the list.
;
; IY The address of the other object
;
; Fetch the index of the other
; object.
@label=CompareWithOtherObject
c$C86F LD HL,($5B2F) ; Fetch #R$5B2F.
 $C872 DEC HL        ; Point #REGhl at the entry of
                     ; the other object.
 $C873 LD C,(HL)     ; Fetch the index of the other
                     ; object.
 $C874 LD DE,$C8EF   ; Point #REGde at #R$C8EF.
; Look for it in #R$C8EF.
@label=CompareWithOtherObject_Find
*$C877 LD A,(DE)     ; Fetch an entry.
 $C878 CP $FF        ; {Jump to #R$C882 if it is the
 $C87A JR Z,$C882    ; end of the list.}
 $C87C CP C          ; {Jump to #R$C898 if it is the
 $C87D JR Z,$C898    ; other object.}
 $C87F INC DE        ; Move on to the next entry.
 $C880 JR $C877      ; Jump to #R$C877.
; Add it to the list.
@label=CompareWithOtherObject_Add
*$C882 LD A,C        ; Fetch the index of the other
                     ; object.
 $C883 LD (DE),A     ; Add it to the list.
 $C884 INC DE        ; Move on to the next entry.
 $C885 LD A,$FF      ; {Mark the end of the list.
 $C887 LD (DE),A     ; }
; Make it the first object and
; start the comparisons again.
 $C888 PUSH IY       ; {Copy #REGiy to #REGix (using
 $C88A POP IX        ; the stack).}
 $C88C LD HL,($5B2F) ; Fetch #R$5B2F.
 $C88F LD ($5B2D),HL ; Set #R$5B2D.
 $C892 LD DE,$C745   ; Point #REGde at #R$C745.
 $C895 JP $C7A5      ; Jump to #R$C7A5.
; The objects hold each other up,
; so draw the other object to break the
; loop.
@label=CompareWithOtherObject_Loop
*$C898 LD HL,$C745   ; Point #REGhl at #R$C745.
@label=CompareWithOtherObject_Search
*$C89B LD A,(HL)     ; Fetch an entry.
 $C89C INC HL        ; Move on to the next entry.
 $C89D CP $FF        ; {Jump to #R$C78D if it is the
 $C89F JP Z,$C78D    ; end of the list.}
 $C8A2 CP C          ; {Jump to #R$C89B if it is not
 $C8A3 JR NZ,$C89B   ; the other object.}
 $C8A5 PUSH IY       ; {Copy #REGiy to #REGix (using
 $C8A7 POP IX        ; the stack).}
 $C8A9 JR $C8D8      ; Jump to #R$C8D8.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$CFA5 }
; LIST#

; Replace Overlapping Special Object
;
; Handles two objects that fill
; the same space. If neither of them is
; ignored and one of them is a valve
; (objects #N$60 to #N$63) it is replaced
; by a sparkle.
;
; IX The address of the first object
; IY The address of the other object
;
; Skip if either object is
; ignored.
@label=ReplaceOverlappingSpecialObject
c$C8AB LD A,(IX+$07)   ; Fetch the flags of the first
                       ; object.
 $C8AE OR (IY+$07)     ; Merge the flags of the other
                       ; object.
 $C8B1 AND %00000010   ; Keep only bit 1.
 $C8B3 JP NZ,$C7A5     ; Jump to #R$C7A5 if either object is ignored.
; Replace a valve with a sparkle.
 $C8B6 LD A,(IX+$00)   ; Fetch the sprite number of the
                       ; first object.
 $C8B9 SUB $60         ; Take #N$60 off it, to get the
                       ; number of the valve.
 $C8BB CP $04          ; {Jump to #R$C8C5 if it is not a
 $C8BD JR NC,$C8C5     ; valve.}
 $C8BF LD (IX+$00),$40 ; Replace it with a sparkle.
 $C8C3 JR $C8D2        ; Jump to #R$C8D2.
; Try the other object.
@label=ReplaceOverlappingSpecialObject_Other
*$C8C5 LD A,(IY+$00)   ; Fetch the sprite number of the
                       ; other object.
 $C8C8 SUB $60         ; Take #N$60 off it, to get the
                       ; number of the valve.
 $C8CA CP $04          ; {Jump to #R$C8D2 if it is not a
 $C8CC JR NC,$C8D2     ; valve.}
 $C8CE LD (IY+$00),$40 ; Replace it with a sparkle.
; Compare the first object with the
; next one.
@label=ReplaceOverlappingSpecialObject_Next
*$C8D2 JP $C7A5        ; Jump to #R$C7A5.

; Draw Next Object
;
; Used by the routine at #R$C785.
; .
; Draws an object that does not
; have to wait for any other object, and
; flags it as drawn in the list.
;
; IX The address of the object
;
; Flag it drawn and print it.
@label=DrawNextObject
c$C8D5 LD HL,($5B2D) ; Fetch the place in the list after the first object.
; This entry point is used by the routine at #R$C86F.
@label=DrawNextObject_Flag
*$C8D8 DEC HL        ; Point #REGhl at the entry of the object.
 $C8D9 SET 7,(HL)    ; Flag the object as drawn.
 $C8DB LD A,$FF      ; {Mark the end of the list of
 $C8DD LD ($C8EF),A  ; objects that have taken the first place.}
 $C8E0 LD HL,$5B1E   ; Point #REGhl at #R$5B1E.
 $C8E3 INC (HL)      ; Add one to it.
 $C8E4 CALL $D013    ; Draw the object into the buffer.
 $C8E7 JP $C78D      ; Jump to #R$C78D to find the next object.
; This entry point is used by the routine at #R$C785.
; .
; There are no objects left to
; draw.
@label=DrawNextObject_Finish
*$C8EA POP IY        ; {Restore #REGiy and #REGix from
 $C8EC POP IX        ; the stack.}
 $C8EE RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$D000 }
; LIST#

; List Of Replaced Objects
;
; The indexes of the objects that
; have taken the place of the first object
; while the order of drawing is worked out
; (see #R$C86F), ending with #N$FF.
@label=ReplacedObjectsList
b$C8EF DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $C8F7 DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF

; Read Controls
;
; Used by the routines at #R$C0BE and #R$C1E2.
; .
; Reads the controls that the
; player is using and stores them in
; #R$5B15. The controls are made into a
; byte, with bit 0 for left, bit 1 for
; right, bit 2 for walking forward, bit 3
; for jumping and bit 4 for picking up
; and dropping an object. Bit 5 is set by
; #R$C9EE. No controls are read while the
; game over scene is shown or the game has
; been completed.
;
; O:C The controls
;
; Pick the reader from #R$5B04.
@label=ReadControls
c$C8FF LD A,($5B23)  ; Fetch #R$5B23.
 $C902 LD C,A        ; Copy it to #REGc.
 $C903 LD A,($5B24)  ; Fetch #R$5B24.
 $C906 OR C          ; Merge #REGc.
 $C907 LD C,$00      ; Set #REGc to #N$00.
 $C909 JP NZ,$C9EE   ; Jump to #R$C9EE if they are not
                     ; zero.
 $C90C LD A,($5B04)  ; Fetch #R$5B04.
 $C90F RRCA          ; Rotate bits 1 and 2 into bits
                     ; 0 and 1.
 $C910 AND %00000011 ; Keep only bits 0 and 1.
 $C912 JP Z,$C9A5    ; Jump to #R$C9A5 if they are
                     ; zero.
 $C915 DEC A         ; Decrement #REGa.
 $C916 JR Z,$C954    ; Jump to #R$C954 if it is zero.
 $C918 DEC A         ; Decrement #REGa.
 $C919 JR Z,$C979    ; Jump to #R$C979 if it is zero.
; Continue on to #R$C91B.
; .
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$D0E3 }
; { #KNIGHTLORE$D022 }
; { #NIGHTSHADE$E241 }
; { #PENTAGRAM$BDF8 }
; LIST#

; Read Interface 2 Joystick
;
; Reads the controls from the
; Interface 2 joysticks, which are the
; keys 1 to 5 for the first joystick and 6
; to 0 for the second joystick. The
; joysticks use the keys left, right,
; down, up and fire in that order, so the
; keys of the first joystick are reversed
; to put them in the same order as the
; keys of the second joystick.
;
; O:C The controls
;
; Reverse the keys 1 to 5.
@label=ReadInterface2Joystick
c$C91B LD A,$F7      ; {Read from the keyboard;
 $C91D CALL $B759    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$F7 | 1 | 2 | 3 | 4 | 5 }
                     ; TABLE#}
 $C920 PUSH BC       ; Stash #REGbc on the stack.
 $C921 LD B,$05      ; Set #REGb to #N$05.
@label=ReadInterface2Joystick_Reverse
*$C923 RRA           ; Rotate #REGa right.
 $C924 RL C          ; Rotate #REGc left.
 $C926 DJNZ $C923    ; Jump to #R$C923 until #REGb is
                     ; zero.
 $C928 LD A,C        ; Copy #REGc to #REGa.
 $C929 POP BC        ; Restore #REGbc from the stack.
 $C92A LD C,A        ; Copy it to #REGc.
; Merge the keys 6 to 0.
 $C92B LD A,$EF      ; {Read from the keyboard;
 $C92D CALL $B759    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$EF | 0 | 9 | 8 | 7 | 6 }
                     ; TABLE#}
 $C930 OR C          ; Merge #REGc.
 $C931 LD C,$00      ; Set #REGc to #N$00.
 $C933 BIT 0,A       ; {Set bit 3 of #REGc if bit 0 of
 $C935 JR Z,$C939    ; #REGa is set.
 $C937 SET 3,C       ; }
@label=ReadInterface2Joystick_TestUp
*$C939 BIT 1,A       ; {Set bit 2 of #REGc if bit 1 of
 $C93B JR Z,$C93F    ; #REGa is set.
 $C93D SET 2,C       ; }
@label=ReadInterface2Joystick_TestDown
*$C93F BIT 2,A       ; {Set bit 4 of #REGc if bit 2 of
 $C941 JR Z,$C945    ; #REGa is set.
 $C943 SET 4,C       ; }
@label=ReadInterface2Joystick_TestRight
*$C945 BIT 3,A       ; {Set bit 1 of #REGc if bit 3 of
 $C947 JR Z,$C94B    ; #REGa is set.
 $C949 SET 1,C       ; }
@label=ReadInterface2Joystick_TestLeft
*$C94B BIT 4,A       ; {Set bit 0 of #REGc if bit 4 of
 $C94D JR Z,$C951    ; #REGa is set.
 $C94F SET 0,C       ; }
@label=ReadInterface2Joystick_Finish
*$C951 JP $C9EE      ; Jump to #R$C9EE.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$D0F2 }
; { #KNIGHTLORE$D03E }
; { #NIGHTSHADE$E250 }
; LIST#

; Read Kempston Joystick
;
; Used by the routine at #R$C8FF.
; .
; Reads the controls from a
; Kempston joystick.
;
; O:C The controls
@label=ReadKempstonJoystick
c$C954 IN A,($1F)    ; Read port #N$1F.
 $C956 LD C,$00      ; Set #REGc to #N$00.
 $C958 BIT 0,A       ; {Set bit 1 of #REGc if bit 0 of
 $C95A JR Z,$C95E    ; #REGa is set.
 $C95C SET 1,C       ; }
@label=ReadKempstonJoystick_TestLeft
*$C95E BIT 1,A       ; {Set bit 0 of #REGc if bit 1 of
 $C960 JR Z,$C964    ; #REGa is set.
 $C962 SET 0,C       ; }
@label=ReadKempstonJoystick_TestDown
*$C964 BIT 2,A       ; {Set bit 4 of #REGc if bit 2 of
 $C966 JR Z,$C96A    ; #REGa is set.
 $C968 SET 4,C       ; }
@label=ReadKempstonJoystick_TestUp
*$C96A BIT 3,A       ; {Set bit 2 of #REGc if bit 3 of
 $C96C JR Z,$C970    ; #REGa is set.
 $C96E SET 2,C       ; }
@label=ReadKempstonJoystick_TestFire
*$C970 BIT 4,A       ; {Set bit 3 of #REGc if bit 4 of
 $C972 JR Z,$C976    ; #REGa is set.
 $C974 SET 3,C       ; }
@label=ReadKempstonJoystick_Finish
*$C976 JP $C9EE      ; Jump to #R$C9EE.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$D12B }
; { #KNIGHTLORE$D077 }
; { #NIGHTSHADE$E289 }
; LIST#

; Read Cursor Joystick
;
; Used by the routine at #R$C8FF.
; .
; Reads the controls from a cursor
; joystick, which uses the keys 5 for
; left, 8 for right, 7 for up, 6 for down
; and 0 for fire.
;
; O:C The controls
@label=ReadCursorJoystick
c$C979 LD C,$00      ; Set #REGc to #N$00.
 $C97B LD A,$F7      ; {Read from the keyboard;
 $C97D CALL $B759    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$F7 | 1 | 2 | 3 | 4 | 5 }
                     ; TABLE#}
 $C980 BIT 4,A       ; {Set bit 0 of #REGc if bit 4 of
 $C982 JR Z,$C986    ; #REGa is set.
 $C984 SET 0,C       ; }
@label=ReadCursorJoystick_SecondRow
*$C986 LD A,$EF      ; {Read from the keyboard;
 $C988 CALL $B759    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$EF | 0 | 9 | 8 | 7 | 6 }
                     ; TABLE#}
 $C98B BIT 0,A       ; {Set bit 3 of #REGc if bit 0 of
 $C98D JR Z,$C991    ; #REGa is set.
 $C98F SET 3,C       ; }
@label=ReadCursorJoystick_TestUp
*$C991 BIT 3,A       ; {Set bit 2 of #REGc if bit 3 of
 $C993 JR Z,$C997    ; #REGa is set.
 $C995 SET 2,C       ; }
@label=ReadCursorJoystick_TestRight
*$C997 BIT 2,A       ; {Set bit 1 of #REGc if bit 2 of
 $C999 JR Z,$C99D    ; #REGa is set.
 $C99B SET 1,C       ; }
@label=ReadCursorJoystick_TestDown
*$C99D BIT 4,A       ; {Jump to #R$C9EE if bit 4 of
 $C99F JR Z,$C9EE    ; #REGa is clear.}
 $C9A1 SET 4,C       ; Set bit 4 of #REGc.
 $C9A3 JR $C9EE      ; Jump to #R$C9EE.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$D150 }
; { #KNIGHTLORE$D09C }
; { #NIGHTSHADE$E2AE }
; LIST#

; Read Keyboard
;
; Used by the routine at #R$C8FF.
; .
; Reads the controls from the
; keyboard. Left is Z, C, M or B, right is
; X, V, symbol shift or N, walking
; forward is any key of the rows A to G
; and H to ENTER, jumping is any key of
; the rows Q to T and Y to P, and picking
; up and dropping an object is any key of
; the rows 1 to 5 and 6 to 0.
;
; O:C The controls
;
; Left and right from the bottom
; row.
@label=ReadKeyboard
c$C9A5 LD A,$FE      ; {Read from the keyboard;
 $C9A7 CALL $B759    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$FE | SHIFT | Z | X | C | V }
                     ; TABLE#}
 $C9AA RRCA          ; Rotate Z into bit 0.
 $C9AB LD C,A        ; Copy it to #REGc.
 $C9AC AND %00000011 ; Keep only bits 0 and 1.
 $C9AE SRL C         ; {Shift C and V into bits 0 and
 $C9B0 SRL C         ; 1.}
 $C9B2 OR C          ; Merge #REGc.
 $C9B3 AND %00000011 ; Keep only bits 0 and 1.
 $C9B5 LD C,A        ; Copy them to #REGc.
 $C9B6 LD A,$7F      ; {Read from the keyboard;
 $C9B8 CALL $B759    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$7F | SPACE | SYMBOL SHIFT | M | N | B }
                     ; TABLE#}
 $C9BB BIT 1,A       ; {Set bit 1 of #REGc if bit 1 of
 $C9BD JR Z,$C9C1    ; #REGa is set.
 $C9BF SET 1,C       ; }
@label=ReadKeyboard_TestM
*$C9C1 BIT 2,A       ; {Set bit 0 of #REGc if bit 2 of
 $C9C3 JR Z,$C9C7    ; #REGa is set.
 $C9C5 SET 0,C       ; }
@label=ReadKeyboard_TestN
*$C9C7 BIT 3,A       ; {Set bit 1 of #REGc if bit 3 of
 $C9C9 JR Z,$C9CD    ; #REGa is set.
 $C9CB SET 1,C       ; }
@label=ReadKeyboard_TestB
*$C9CD BIT 4,A       ; {Set bit 0 of #REGc if bit 4 of
 $C9CF JR Z,$C9D3    ; #REGa is set.
 $C9D1 SET 0,C       ; }
@label=ReadKeyboard_WalkKeys
*$C9D3 LD A,$BD      ; {Read from the keyboard;
 $C9D5 CALL $B759    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$BD | A / ENTER | S / L | D / K | F / J | G / H }
                     ; TABLE#}
 $C9D8 JR Z,$C9DC    ; {Set bit 2 of #REGc if a key is
 $C9DA SET 2,C       ; pressed.}
@label=ReadKeyboard_JumpKeys
*$C9DC LD A,$DB      ; {Read from the keyboard;
 $C9DE CALL $B759    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$DB | Q / P | W / O | E / I | R / U | T / Y }
                     ; TABLE#}
 $C9E1 JR Z,$C9E5    ; {Set bit 3 of #REGc if a key is
 $C9E3 SET 3,C       ; pressed.}
@label=ReadKeyboard_PickUpKeys
*$C9E5 LD A,$E7      ; {Read from the keyboard;
 $C9E7 CALL $B759    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$E7 | 1 / 0 | 2 / 9 | 3 / 8 | 4 / 7 | 5 / 6 }
                     ; TABLE#}
 $C9EA JR Z,$C9EE    ; {Set bit 4 of #REGc if a key is
 $C9EC SET 4,C       ; pressed.}
; This entry point is used by the routines at #R$C8FF, #R$C91B, #R$C954 and
; #R$C979.
; .
; Read the keys that pick up and
; drop an object when a joystick with
; directional control is in use. The keys
; that count are Z, X, C, V, A to G, H to
; ENTER, Q to T and Y to P.
@label=ReadControls_Finish
*$C9EE LD A,$7E      ; {Read from the keyboard;
 $C9F0 CALL $B759    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$7E | SHIFT / SPACE | Z / SYM | X / M | C / N | V / B }
                     ; TABLE#}
 $C9F3 AND %00011110 ; Keep only bits 1-4.
 $C9F5 PUSH BC       ; Stash #REGbc on the stack.
 $C9F6 LD B,A        ; Copy the keys to #REGb.
 $C9F7 LD A,$99      ; {Read the keys A to G, Q to T,
 $C9F9 CALL $B759    ; Y to P and H to ENTER.}
 $C9FC OR B          ; Merge #REGb.
 $C9FD POP BC        ; Restore #REGbc from the stack.
 $C9FE JR Z,$CA02    ; Jump to #R$CA02 if no key is
                     ; pressed.
 $CA00 SET 5,C       ; Set bit 5 of #REGc.
@label=ReadControls_Store
*$CA02 LD A,C        ; Copy #REGc to #REGa.
 $CA03 LD ($5B15),A  ; Set #R$5B15.
 $CA06 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$D0C8 }
; LIST#

; Lose Life
;
; Used by the routine at #R$A688.
; .
; Puts the player back as it was
; when it entered the room (see #R$CA1D),
; and takes a life off. If there are no
; lives left the game is over.
;
; .
;
; Restore the player and take a
; life.
@label=LoseLife
c$CA07 LD HL,$CA1D   ; Point #REGhl at #R$CA1D.
 $CA0A LD DE,$5B88   ; Point #REGde at #R$5B88.
 $CA0D PUSH DE       ; {Copy #REGde to #REGix (using
 $CA0E POP IX        ; the stack).}
 $CA10 LD BC,$0040   ; Set #REGbc to #N($0040,$04,$04).
 $CA13 LDIR          ; Copy the player back.
 $CA15 LD HL,$5B1A   ; Point #REGhl at #R$5B1A.
; See #POKE(infinite_lives,Infinite
; Lives).
 $CA18 DEC (HL)      ; Decrement it.
 $CA19 JP M,$B761    ; Jump to #R$B761 if the sign
                     ; flag is set.
 $CA1C RET           ; Return.
; View the equivalent code in;
; #LIST
; { #PENTAGRAM$C2EC }
; LIST#

; Copy Of Player
;
; A copy of the two objects of the
; player, as they were when the player
; entered the room (or as they are at the
; start of the game), which is put back by
; #R$CA07 when a life is lost. The first
; #N$20 bytes are the bottom half and the
; last #N$20 bytes are the top half. The
; byte at #R$CA1D(#N$CA25) is the room
; number of the bottom half, and the byte
; at #R$CA3D(#N$CA45) that of the top
; half. The byte at #R$CA1D(#N$CA2D) is
; the sprite that the bottom half will
; have when it appears, and the byte at
; #R$CA3D(#N$CA4D) is the sprite that the
; top half will have.
@label=PlayerCopy
g$CA1D DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; {The bottom half.
 $CA25 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
 $CA2D DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
 $CA35 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; }
@label=PlayerCopy_TopHalf
 $CA3D DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; {The top half.
 $CA45 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
 $CA4D DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
 $CA55 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; }

; Initial Player Data
;
; The first eight bytes of each
; object of the player at the start of the
; game: the sprite number, the x, y and z
; positions, the width, the depth, the
; height and the flags.
@label=InitialPlayerData
b$CA5D DEFB $38,$80,$80,$40,$07,$07,$0C,$1C ; The bottom half, which is
                                            ; a sparkle, at the middle of the room,
                                            ; with a height of #N$0C.
 $CA65 DEFB $38,$80,$80,$4C,$07,$07,$0B,$1C ; The top half, which is a
                                            ; sparkle too, #N$0C higher than the
                                            ; bottom half and with a height of #N$0B.

; Initialise Player
;
; Used by the routine at #R$A650.
; .
; Sets up the copy of the player
; at the start of the game. The player
; appears in a room that is picked at
; random from four rooms.
;
; .
;
; Copy the sparkle and pick a
; start room.
@label=InitialisePlayer
c$CA6D LD HL,$CA5D   ; Point #REGhl at #R$CA5D.
 $CA70 LD DE,$CA1D   ; Point #REGde at #R$CA1D.
 $CA73 LD BC,$0008   ; Set #REGbc to #N($0008,$04,$04).
 $CA76 LDIR          ; Copy the bottom half.
 $CA78 LD DE,$CA3D   ; Point #REGde at #R$CA3D.
 $CA7B LD BC,$0008   ; Set #REGbc to #N($0008,$04,$04).
 $CA7E LDIR          ; Copy the top half.
 $CA80 LD A,$16      ; {Write #N$16 to
 $CA82 LD ($CA2D),A  ; #R$CA1D(#N$CA2D).}
 $CA85 LD A,$26      ; {Write #N$26 to
 $CA87 LD ($CA4D),A  ; #R$CA3D(#N$CA4D).}
 $CA8A LD A,($5B00)  ; Fetch #R$5B00.
 $CA8D AND %00000011 ; Keep only bits 0 and 1.
 $CA8F LD L,A        ; Copy it to #REGl.
 $CA90 LD H,$00      ; Set #REGh to #N$00.
 $CA92 LD BC,$CA9E   ; Point #REGbc at #R$CA9E.
 $CA95 ADD HL,BC     ; Add #REGbc to #REGhl.
 $CA96 LD A,(HL)     ; Fetch the start room.
 $CA97 LD ($CA25),A  ; Set #R$CA1D(#N$CA25).
 $CA9A LD ($CA45),A  ; Set #R$CA3D(#N$CA45).
 $CA9D RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$D1B1 }
; LIST#

; Start Rooms
;
; The rooms that the player may
; start in.
@label=StartRooms
b$CA9E DEFB $13
 $CA9F DEFB $4E
 $CAA0 DEFB $88
 $CAA1 DEFB $D7

; Build Room Objects
;
; Used by the routine at #R$A68B.
; .
; Builds the objects of the room
; that the player is in, and sets the game
; up to start again in it.
;
; .
;
; Save the room that was left,
; unless this is the first.
@label=BuildRoomObjects
c$CAA2 LD A,($5B12)  ; Fetch #R$5B12.
 $CAA5 AND A         ; {Jump to #R$CAAB if it is zero.
 $CAA6 JR Z,$CAAB    ; }
 $CAA8 CALL $AF05    ; Call #R$AF05.
; Build the new room.
@label=BuildRoomObjects_Clear
*$CAAB CALL $CCA7    ; Call #R$CCA7.
 $CAAE CALL $CE7B    ; Call #R$CE7B.
 $CAB1 CALL $AE99    ; Call #R$AE99.
 $CAB4 CALL $CC01    ; Call #R$CC01.
 $CAB7 XOR A         ; {Write #N$00 to #R$5B3A, #R$5B42
 $CAB8 LD ($5B3A),A  ; and #R$5B43.
 $CABB LD ($5B42),A  ;
 $CABE LD ($5B43),A  ; }
 $CAC1 LD A,($5B90)  ; Fetch #R$5B88(#N$5B90).
 $CAC4 CPL           ; Invert #REGa.
 $CAC5 AND %00000001 ; Keep only bit 0.
 $CAC7 LD ($5B3B),A  ; Set #R$5B3B.
 $CACA LD A,$01      ; {Write #N$01 to #R$5B17.
 $CACC LD ($5B17),A  ; }
 $CACF JP $B863      ; Jump to #R$B863.

; Set Room Attributes
;
; Used by the routine at #R$A650.
; .
; Goes through the data for all of
; the rooms, which is held from #R$6469 to
; #R$73C8, and copies the second colour in
; the size and colours byte of each into
; the first so that both colours are the
; same.
;
; .
;
; Copy the second colour over the
; first.
@label=SetRoomAttributes
c$CAD2 LD HL,$6469   ; Point #REGhl at #R$6469.
 $CAD5 LD BC,$73C8   ; Point #REGbc at #R$73C8.
 $CAD8 INC HL        ; Increment #REGhl.
@label=SetRoomAttributes_Next
*$CAD9 LD E,(HL)     ; Fetch the length of the data.
 $CADA INC HL        ; Increment #REGhl.
 $CADB LD A,(HL)     ; Fetch the size and colours.
 $CADC RRCA          ; {Rotate the second colour into
 $CADD RRCA          ; bits 0-2.
 $CADE RRCA          ; }
 $CADF AND %00000111 ; Keep only bits 0-2.
 $CAE1 LD D,A        ; Copy it to #REGd.
 $CAE2 LD A,(HL)     ; Fetch the size and colours.
 $CAE3 AND %11111000 ; Keep only bits 3-7.
 $CAE5 OR D          ; Merge #REGd.
 $CAE6 LD (HL),A     ; Store the size and colours.
 $CAE7 LD D,$00      ; Set #REGd to #N$00.
 $CAE9 ADD HL,DE     ; Add #REGde to #REGhl.
 $CAEA AND A         ; {Return if the end of the room
 $CAEB SBC HL,BC     ; data has been reached.
 $CAED RET NC        ; }
 $CAEE ADD HL,BC     ; Add #REGbc to #REGhl.
 $CAEF JR $CAD9      ; Jump to #R$CAD9.

; Set Sprite Details
;
; Used by the routines at #R$CB06, #R$CB0F and #R$CB8A.
; .
; Sets the sprite number, the
; flags and the pixel position of an
; object from four bytes of data.
;
;   HL The address of the data
;   IX The address of the object
; O:HL The address of the byte after the data
@label=SetSpriteDetails
c$CAF1 LD A,(HL)     ; {Fetch the sprite number and
 $CAF2 INC HL        ; move on.}
 $CAF3 LD (IX+$00),A ; Set the sprite number.
 $CAF6 LD A,(HL)     ; {Fetch the flags and move on.
 $CAF7 INC HL        ; }
 $CAF8 LD (IX+$07),A ; Set the flags.
 $CAFB LD A,(HL)     ; {Fetch the pixel x and move on.
 $CAFC INC HL        ; }
 $CAFD LD (IX+$1A),A ; Set the pixel x position.
 $CB00 LD A,(HL)     ; {Fetch the pixel y and move on.
 $CB01 INC HL        ; }
 $CB02 LD (IX+$1B),A ; Set the pixel y position.
 $CB05 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$D237 }
; { #PENTAGRAM$BDC0 }
; LIST#

; Print Table Sprite
;
; Used by the routines at #R$CB0F and #R$CB8A.
; .
; Sets the details of an object
; from four bytes of data, and prints its
; sprite.
;
;   HL The address of the data
;   IX The address of the object
; O:HL The address of the byte after the data
@label=PrintTableSprite
c$CB06 CALL $CAF1    ; Call #R$CAF1.
 $CB09 PUSH HL       ; Stash #REGhl on the stack.
 $CB0A CALL $D027    ; Call #R$D027.
 $CB0D POP HL        ; Restore #REGhl from the stack.
 $CB0E RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$D24C }
; { #PENTAGRAM$BDD5 }
; LIST#

; Draw Panel
;
; Used by the routine at #R$A68B.
; .
; Draws the sprites of the panel
; at the bottom of the screen, using the
; table at #R$CB5A. On each side there is
; a run of five sprites that go up in
; steps, a column of six sprites and two
; more sprites, and the middle of the
; panel has the extra life that is the
; symbol for the lives and four more
; sprites. The right side is the left side
; flipped.
; .
; #PUSHS #UDGTABLE { =h After #R$CB0F and #R$CE85 }
; { #SIM(start=$A631,stop=$A676,sp=$F100,r=$80,clear=1)
; #SIM(start=$CE73,stop=$0000,sp=$EC00)
; #SIM(start=$CB0F,stop=$0000,sp=$EC00)
; #SIM(start=$CE85,stop=$0000,sp=$EC00)
; #SCR$02,$00,$10,$20,$08(draw-panel) } UDGTABLE# #POPS
;
; .
;
; Left side, then right, then the
; middle.
@label=DrawPanel
c$CB0F LD IX,$BD38   ; Point #REGix at #R$BD38.
 $CB13 LD HL,$CB5A   ; Point #REGhl at #R$CB5A.
 $CB16 CALL $CAF1    ; Call #R$CAF1.
 $CB19 LD DE,$F810   ; Set #REGde to #N$F810.
 $CB1C LD B,$05      ; Set #REGb to #N$05.
 $CB1E CALL $BC56    ; Call #R$BC56.
 $CB21 CALL $CAF1    ; Call #R$CAF1.
 $CB24 LD DE,$0800   ; Set #REGde to #N$0800.
 $CB27 LD B,$06      ; Set #REGb to #N$06.
 $CB29 CALL $BC56    ; Call #R$BC56.
 $CB2C CALL $CB06    ; Call #R$CB06.
 $CB2F CALL $CB06    ; Call #R$CB06.
 $CB32 CALL $CAF1    ; Call #R$CAF1.
 $CB35 LD DE,$F8F0   ; Set #REGde to #N$F8F0.
 $CB38 LD B,$05      ; Set #REGb to #N$05.
 $CB3A CALL $BC56    ; Call #R$BC56.
 $CB3D CALL $CAF1    ; Call #R$CAF1.
 $CB40 LD DE,$0800   ; Set #REGde to #N$0800.
 $CB43 LD B,$06      ; Set #REGb to #N$06.
 $CB45 CALL $BC56    ; Call #R$BC56.
 $CB48 CALL $CB06    ; Call #R$CB06.
 $CB4B CALL $CB06    ; Call #R$CB06.
 $CB4E CALL $CB06    ; Call #R$CB06.
 $CB51 CALL $CB06    ; Call #R$CB06.
 $CB54 CALL $CB06    ; Call #R$CB06.
 $CB57 JP $CB06      ; Jump to #R$CB06.

; Panel Sprites
;
; The sprites for the panel. Each
; has four bytes: the sprite number, the
; flags, and the pixel x and y
; coordinates.
@label=PanelSprites
b$CB5A DEFB $09      ; {Sprite #N($09), flags
 $CB5B DEFB $00      ; #N($00), at (#N($10), #N$30).
 $CB5C DEFB $10      ; #UDGTABLE { #SPRITE$09,attr=$47(panel-diagonal-01-colour*) }
 $CB5D DEFB $30      ; UDGTABLE#}
 $CB5E DEFB $0A      ; {Sprite #N($0A), flags
 $CB5F DEFB $00      ; #N($00), at (#N($00), #N$00).
 $CB60 DEFB $00      ; #UDGTABLE { #SPRITE$0A,attr=$47(panel-column-01-colour*) } UDGTABLE#
 $CB61 DEFB $00      ; }
 $CB62 DEFB $07      ; {Sprite #N($07), flags
 $CB63 DEFB $00      ; #N($00), at (#N($00), #N$30).
 $CB64 DEFB $00      ; #UDGTABLE
 $CB65 DEFB $30      ; { #SPRITE$07,attr=$47(panel-upper-edge-01-colour*) }
                     ; UDGTABLE#}
 $CB66 DEFB $08      ; {Sprite #N($08), flags
 $CB67 DEFB $00      ; #N($00), at (#N($60), #N$00).
 $CB68 DEFB $60      ; #UDGTABLE
 $CB69 DEFB $00      ; { #SPRITE$08,attr=$47(panel-lower-edge-01-colour*) }
                     ; UDGTABLE#}
 $CB6A DEFB $09      ; {Sprite #N($09), flags
 $CB6B DEFB $40      ; #N($40), at (#N($E0), #N$30).
 $CB6C DEFB $E0      ; #UDGTABLE { #SPRITE$09,attr=$47(panel-diagonal-01-colour*) }
 $CB6D DEFB $30      ; UDGTABLE#}
 $CB6E DEFB $0A      ; {Sprite #N($0A), flags
 $CB6F DEFB $40      ; #N($40), at (#N($F8), #N$00).
 $CB70 DEFB $F8      ; #UDGTABLE { #SPRITE$0A,attr=$47(panel-column-01-colour*) } UDGTABLE#
 $CB71 DEFB $00      ; }
 $CB72 DEFB $07      ; {Sprite #N($07), flags
 $CB73 DEFB $40      ; #N($40), at (#N($F0), #N$30).
 $CB74 DEFB $F0      ; #UDGTABLE
 $CB75 DEFB $30      ; { #SPRITE$07,attr=$47(panel-upper-edge-01-colour*) }
                     ; UDGTABLE#}
 $CB76 DEFB $08      ; {Sprite #N($08), flags
 $CB77 DEFB $40      ; #N($40), at (#N($90), #N$00).
 $CB78 DEFB $90      ; #UDGTABLE
 $CB79 DEFB $00      ; { #SPRITE$08,attr=$47(panel-lower-edge-01-colour*) }
                     ; UDGTABLE#}
 $CB7A DEFB $0C      ; {Sprite #N($0C), flags
 $CB7B DEFB $00      ; #N($00), at (#N($70), #N$00).
 $CB7C DEFB $70      ; #UDGTABLE { #SPRITE$0C,attr=$47(extra-life-01-colour*) } UDGTABLE#
 $CB7D DEFB $00      ; }
 $CB7E DEFB $54      ; {Sprite #N($54), flags
 $CB7F DEFB $00      ; #N($00), at (#N($E0), #N$09).
 $CB80 DEFB $E0      ; #UDGTABLE { #SPRITE$54,attr=$47(panel-bracket-01-colour*) } UDGTABLE#
 $CB81 DEFB $09      ; }
 $CB82 DEFB $54      ; {Sprite #N($54), flags
 $CB83 DEFB $40      ; #N($40), at (#N($C8), #N$09).
 $CB84 DEFB $C8      ; #UDGTABLE { #SPRITE$54,attr=$47(panel-bracket-01-colour*) } UDGTABLE#
 $CB85 DEFB $09      ; }
 $CB86 DEFB $83      ; {Sprite #N($83), flags
 $CB87 DEFB $00      ; #N($00), at (#N($08), #N$18).
 $CB88 DEFB $08      ; #UDGTABLE
 $CB89 DEFB $18      ; { #SPRITE$83,attr=$47(panel-decoration-01-colour*) }
                     ; UDGTABLE#}

; Print Border
;
; Used by the routines at #R$B761 and #R$BC31.
; .
; Draws the border around the
; playing area, using the sprites in the
; table at #R$CBC3. The four corners are
; drawn first, then the top and bottom
; edges, which are each made of #N$18
; sprites that are eight pixels wide, and
; the left and right edges, which are each
; made of #N$80 sprites that are one pixel
; high.
; .
; #PUSHS #UDGTABLE { =h After #R$CB8A and #R$CE85 }
; { #SIM(start=$A631,stop=$A676,sp=$F100,r=$80,clear=1)
; #SIM(start=$CE73,stop=$0000,sp=$EC00)
; #SIM(start=$CB8A,stop=$0000,sp=$EC00)
; #SIM(start=$CE85,stop=$0000,sp=$EC00)
; #SCR$02(print-border) } UDGTABLE# #POPS
;
; .
;
; Corners, then the four edges.
@label=PrintBorder
c$CB8A LD IX,$BD38   ; Point #REGix at #R$BD38.
 $CB8E LD HL,$CBC3   ; Point #REGhl at #R$CBC3.
 $CB91 CALL $CB06    ; Call #R$CB06.
 $CB94 CALL $CB06    ; Call #R$CB06.
 $CB97 CALL $CB06    ; Call #R$CB06.
 $CB9A CALL $CB06    ; Call #R$CB06.
 $CB9D CALL $CAF1    ; Call #R$CAF1.
 $CBA0 LD DE,$0008   ; Set #REGde to #N($0008,$04,$04).
 $CBA3 LD B,$18      ; Set #REGb to #N$18.
 $CBA5 CALL $BC56    ; Call #R$BC56.
 $CBA8 CALL $CAF1    ; Call #R$CAF1.
 $CBAB LD B,$18      ; Set #REGb to #N$18.
 $CBAD CALL $BC56    ; Call #R$BC56.
 $CBB0 CALL $CAF1    ; Call #R$CAF1.
 $CBB3 LD DE,$0100   ; Set #REGde to #N$0100.
 $CBB6 LD B,$80      ; Set #REGb to #N$80.
 $CBB8 CALL $BC56    ; Call #R$BC56.
 $CBBB CALL $CAF1    ; Call #R$CAF1.
 $CBBE LD B,$80      ; Set #REGb to #N$80.
 $CBC0 JP $BC56      ; Jump to #R$BC56.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$D296 }
; { #PENTAGRAM$BD59 }
; LIST#

; Border Sprites
;
; The sprites for the border. Each
; has four bytes: the sprite number, the
; flags, and the pixel x and y
; coordinates.
@label=BorderSprites
b$CBC3 DEFB $04      ; {Sprite #N($04), flags
 $CBC4 DEFB $00      ; #N($00), at (#N($00), #N$A0).
 $CBC5 DEFB $00      ; #UDGTABLE { #SPRITE$04,attr=$47(border-corner-01-colour*) } UDGTABLE#
 $CBC6 DEFB $A0      ; }
 $CBC7 DEFB $04      ; {Sprite #N($04), flags
 $CBC8 DEFB $40      ; #N($40), at (#N($E0), #N$A0).
 $CBC9 DEFB $E0      ; #UDGTABLE { #SPRITE$04,attr=$47(border-corner-01-colour*) } UDGTABLE#
 $CBCA DEFB $A0      ; }
 $CBCB DEFB $04      ; {Sprite #N($04), flags
 $CBCC DEFB $C0      ; #N($C0), at (#N($E0), #N$00).
 $CBCD DEFB $E0      ; #UDGTABLE { #SPRITE$04,attr=$47(border-corner-01-colour*) } UDGTABLE#
 $CBCE DEFB $00      ; }
 $CBCF DEFB $04      ; {Sprite #N($04), flags
 $CBD0 DEFB $80      ; #N($80), at (#N($00), #N$00).
 $CBD1 DEFB $00      ; #UDGTABLE { #SPRITE$04,attr=$47(border-corner-01-colour*) } UDGTABLE#
 $CBD2 DEFB $00      ; }
 $CBD3 DEFB $06      ; {Sprite #N($06), flags
 $CBD4 DEFB $00      ; #N($00), at (#N($20), #N$A8).
 $CBD5 DEFB $20      ; #UDGTABLE { #SPRITE$06,attr=$47(border-edge-01-colour*) } UDGTABLE#
 $CBD6 DEFB $A8      ; }
 $CBD7 DEFB $06      ; {Sprite #N($06), flags
 $CBD8 DEFB $80      ; #N($80), at (#N($20), #N$00).
 $CBD9 DEFB $20      ; #UDGTABLE { #SPRITE$06,attr=$47(border-edge-01-colour*) } UDGTABLE#
 $CBDA DEFB $00      ; }
 $CBDB DEFB $05      ; {Sprite #N($05), flags
 $CBDC DEFB $00      ; #N($00), at (#N($00), #N$20).
 $CBDD DEFB $00      ; #UDGTABLE { #SPRITE$05,attr=$47(border-side-01-colour*) } UDGTABLE#
 $CBDE DEFB $20      ; }
 $CBDF DEFB $05      ; {Sprite #N($05), flags
 $CBE0 DEFB $40      ; #N($40), at (#N($E8), #N$20).
 $CBE1 DEFB $E8      ; #UDGTABLE { #SPRITE$05,attr=$47(border-side-01-colour*) } UDGTABLE#
 $CBE2 DEFB $20      ; }

; Set Border Attributes
;
; Sets the colours of the panel at
; the bottom of the screen: black for the
; two columns at the sides of the window,
; and bright red for the window itself.
;
; .
;
; Colour the sides black, then the
; window bright red.
@label=SetBorderAttributes
c$CBE3 XOR A         ; Set #REGa to #N$00.
 $CBE4 LD HL,$5AB6   ; Point #REGhl at #N$5AB6 (in the attribute buffer).
 $CBE7 LD BC,$0103   ; Set #REGbc to #N$0103.
 $CBEA CALL $BF83    ; Call #R$BF83.
 $CBED LD HL,$5ABD   ; Point #REGhl at #N$5ABD (in the attribute buffer).
 $CBF0 LD BC,$0103   ; Set #REGbc to #N$0103.
 $CBF3 CALL $BF83    ; Call #R$BF83.
 $CBF6 LD A,$42      ; Set #REGa to #N$42.
 $CBF8 LD HL,$5A97   ; Point #REGhl at #N$5A97 (in the attribute buffer).
 $CBFB LD BC,$0604   ; Set #REGbc to #N$0604.
 $CBFE JP $BF83      ; Jump to #R$BF83.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$D2EF }
; LIST#

; Place Player At Door
;
; Used by the routine at #R$CAA2.
; .
; Puts the player in the right place
; when it has come into a room through an
; arch. The routine that moved the player
; out of the last room set one of its
; positions to #N$00 or #N($FF), which tells
; which way the player came. The player is
; put at the opposite edge of the room,
; just outside the wall, and at the height
; of the arch. If the positions are not
; one of these, as when the player starts
; the game or starts again after losing a
; life, nothing is changed.
;
; IX Address of the player
;
; Fetch the wall distances, then
; see which way the player came.
@label=PlacePlayerAtDoor
c$CC01 LD A,($5B0B)   ; Fetch #R$5B0B.
 $CC04 SUB $02        ; Subtract #N$02.
 $CC06 LD L,A         ; Copy it to #REGl.
 $CC07 LD A,($5B0C)   ; Fetch #R$5B0C.
 $CC0A SUB $02        ; Subtract #N$02.
 $CC0C LD H,A         ; Copy it to #REGh.
 $CC0D LD A,(IX+$01)  ; Fetch the x position of the
                      ; player.
 $CC10 AND A          ; {Jump to #R$CC60 if it is zero.
 $CC11 JR Z,$CC60     ; }
 $CC13 INC A          ; {Jump to #R$CC50 if it is #N$FF.
 $CC14 JR Z,$CC50     ; }
 $CC16 LD A,(IX+$02)  ; Fetch the y position of the
                      ; player.
 $CC19 AND A          ; {Jump to #R$CC43 if it is zero.
 $CC1A JR Z,$CC43     ; }
 $CC1C INC A          ; {Jump to #R$CC20 if it is #N$FF.
 $CC1D JR Z,$CC20     ; }
 $CC1F RET            ; Return.
; The player came from the north.
@label=PlacePlayerAtDoor_South
*$CC20 LD C,$C8       ; Set #REGc to #N$C8.
 $CC22 CALL $CC6D     ; Call #R$CC6D.
 $CC25 LD A,$80       ; Set #REGa to #N$80.
 $CC27 SUB H          ; Subtract #REGh.
 $CC28 SUB (IX+$05)   ; Subtract the depth of the
                      ; player.
@label=PlacePlayerAtDoor_SetY
*$CC2B LD (IX+$02),A  ; Set the y position of the
                      ; player.
@label=PlacePlayerAtDoor_Draw
*$CC2E SET 4,(IX+$07) ; Set bit 4 of the flags.
 $CC32 SET 4,(IX+$27) ; Set bit 4 of the flags of the
                      ; top half.
 $CC36 LD A,(IX+$01)  ; Fetch the x position of the
                      ; player.
 $CC39 LD (IX+$21),A  ; Set the x position of the top
                      ; half.
 $CC3C LD A,(IX+$02)  ; Fetch the y position of the
                      ; player.
 $CC3F LD (IX+$22),A  ; Set the y position of the top
                      ; half.
 $CC42 RET            ; Return.
; The player came from the south.
@label=PlacePlayerAtDoor_North
*$CC43 LD C,$52       ; Set #REGc to #N$52.
 $CC45 CALL $CC6D     ; Call #R$CC6D.
 $CC48 LD A,H         ; Fetch #REGh.
 $CC49 ADD A,$80      ; Add #N$80.
 $CC4B ADD A,(IX+$05) ; Add the depth of the player.
 $CC4E JR $CC2B       ; Jump to #R$CC2B.
; The player came from the east.
@label=PlacePlayerAtDoor_West
*$CC50 LD C,$AE       ; Set #REGc to #N$AE.
 $CC52 CALL $CC6D     ; Call #R$CC6D.
 $CC55 LD A,$80       ; Set #REGa to #N$80.
 $CC57 SUB L          ; Subtract #REGl.
 $CC58 SUB (IX+$04)   ; Subtract the width of the
                      ; player.
@label=PlacePlayerAtDoor_SetX
*$CC5B LD (IX+$01),A  ; Set the x position of the
                      ; player.
 $CC5E JR $CC2E       ; Jump to #R$CC2E.
; The player came from the west.
@label=PlacePlayerAtDoor_East
*$CC60 LD C,$38       ; Set #REGc to #N$38.
 $CC62 CALL $CC6D     ; Call #R$CC6D.
 $CC65 LD A,L         ; Fetch #REGl.
 $CC66 ADD A,$80      ; Add #N$80.
 $CC68 ADD A,(IX+$04) ; Add the width of the player.
 $CC6B JR $CC5B       ; Jump to #R$CC5B.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$D320 }
; { #PENTAGRAM$CA82 }
; LIST#

; Find Door Height
;
; Used by the routine at #R$CC01.
; .
; Looks through the first four pairs
; of objects of the room for an arch (a
; sprite number below #N$04) whose x and y
; positions add up to a given number. When
; it finds one it gives the player the
; height of the arch.
;
; C Sum of the x and y positions of the arch
; IX Address of the player
;
; Walk the first four pairs.
@label=FindDoorHeight
c$CC6D LD IY,$5C08    ; Point #REGiy at #R$5C08.
 $CC71 LD DE,$0040    ; Set #REGde to #N($0040,$04,$04).
 $CC74 LD B,$04       ; Set #REGb to #N$04.
@label=FindDoorHeight_Next
*$CC76 LD A,(IY+$00)  ; Fetch the sprite number of the
                      ; object.
 $CC79 CP $04         ; {Return if it is #N$04 or more.
 $CC7B RET NC         ; }
 $CC7C LD A,(IY+$01)  ; Fetch the x position of the
                      ; object.
 $CC7F ADD A,(IY+$02) ; Add the y position of the
                      ; object.
 $CC82 CP C           ; {Jump to #R$CC8A if it is equal
 $CC83 JR Z,$CC8A     ; to #REGc.}
 $CC85 ADD IY,DE      ; Add #REGde to #REGiy.
 $CC87 DJNZ $CC76     ; Jump to #R$CC76 until #REGb is
                      ; zero.
 $CC89 RET            ; Return.
; Give the player the height of the
; arch.
@label=FindDoorHeight_Found
*$CC8A LD A,(IY+$03)  ; Fetch the z position of the
                      ; arch.
 $CC8D LD (IX+$03),A  ; Set the z position of the
                      ; player.
 $CC90 ADD A,$0C      ; Add #N$0C.
 $CC92 LD (IX+$23),A  ; Set the z position of the top
                      ; half.
 $CC95 RET            ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$D38C }
; LIST#

; Find Object Address
;
; Used by the routines at #R$C785 and #R$CEAB.
; .
; Works out the address of an object
; from its index in the table of objects.
;
;   A Index of the object (bit 7 is ignored)
; O:HL Address of the object record
@label=FindObjectAddress
c$CC96 PUSH BC       ; Stash #REGbc on the stack.
 $CC97 AND %01111111 ; Keep bits 0 to 6.
 $CC99 LD L,A        ; Copy it to #REGl.
 $CC9A LD H,$00      ; Set #REGh to #N$00.
 $CC9C ADD HL,HL     ; {Multiply #REGhl by #N$20.
 $CC9D ADD HL,HL     ;
 $CC9E ADD HL,HL     ;
 $CC9F ADD HL,HL     ;
 $CCA0 ADD HL,HL     ; }
 $CCA1 LD BC,$5B88   ; Point #REGbc at #R$5B88.
 $CCA4 ADD HL,BC     ; Add #REGbc to #REGhl.
 $CCA5 POP BC        ; Restore #REGbc from the stack.
 $CCA6 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$D3B5 }
; { #PENTAGRAM$B520 }
; LIST#

; Retrieve Room
;
; Used by the routine at #R$CAA2.
; .
; Builds the objects of the room that
; the player is in from the room data. It
; looks for the room in the room data (see
; #R$6469), which has a variable length
; entry for each room. The objects are put
; in the objects table from #R$5C08, which
; is the first one after the player and
; the special objects. If the room is not
; in the data, none are made.
;
; IX Address of the player
;
; Point at the room data, then find
; the entry for this room.
@label=RetrieveRoom
c$CCA7 LD HL,$73C8   ; Point #REGhl at #R$73C8.
 $CCAA LD ($5B20),HL ; Set #R$5B20.
 $CCAD XOR A         ; {Write #N$00 to #R$5B19 and
 $CCAE LD ($5B19),A  ; #R$5B25.
 $CCB1 LD ($5B25),A  ; }
 $CCB4 LD DE,$5C08   ; Point #REGde at #R$5C08.
 $CCB7 LD BC,$73C8   ; Point #REGbc at #R$73C8.
 $CCBA LD HL,$6469   ; Point #REGhl at #R$6469.
@label=RetrieveRoom_Find
*$CCBD LD A,(HL)     ; {Fetch the room number and
 $CCBE INC HL        ; compare it with the player's room.
 $CCBF CP (IX+$08)   ; }
 $CCC2 JR Z,$CCDE    ; Jump to #R$CCDE if they match.
 $CCC4 LD A,(HL)     ; Fetch the length of the entry.
 $CCC5 CALL $CE06    ; Call #R$CE06.
 $CCC8 AND A         ; {Jump to #R$CCD0 if #REGhl has
 $CCC9 SBC HL,BC     ; reached #REGbc.
 $CCCB JR NC,$CCD0   ; }
 $CCCD ADD HL,BC     ; Add #REGbc to #REGhl.
 $CCCE JR $CCBD      ; Jump to #R$CCBD.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$D3C6 }
; { #PENTAGRAM$C92C }
; LIST#

; Clear Remaining Objects
;
; Used by the routines at #R$CCA7 and #R$CCDE.
; .
; Clears the objects in the objects
; table from a given place to the end of
; the table.
;
; DE Address of the first object to clear
@label=ClearRemainingObjects
c$CCD0 LD HL,$6288   ; Point #REGhl at #R$6288.
 $CCD3 AND A         ; {Return if #REGhl is equal to
 $CCD4 SBC HL,DE     ; #REGde.
 $CCD6 RET Z         ; }
 $CCD7 LD B,$20      ; Set #REGb to #N$20.
 $CCD9 CALL $CE1C    ; Call #R$CE1C.
 $CCDC JR $CCD0      ; Jump to #R$CCD0.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$D3E2 }
; LIST#

; Make Room Objects
;
; Used by the routine at #R$CCA7.
; .
; Makes the objects of a room from
; its entry in the room data. The colour
; of the room is the low three bits of the
; byte after the length, and the size of
; the room is the high two bits. The size
; gives the distance to the walls and the
; floor level, from the table at #R$6460.
; Each type of block is the number of an
; entry in the table at #R$7519, which
; holds the address of a template of one
; or more objects. These are copied into
; the objects table, along with the number
; of the room. The types of block end with
; a #N($FF), or at the end of the entry if
; there are no more objects. After the
; #N$FF come the groups of other objects,
; each with a type and a number of places
; (see #R$6469).
;
; DE Address of the first object to make
; HL Address of the length of the entry of the room
; IX Address of the player
;
; Set the colour, the size and the
; floor.
@label=MakeRoomObjects
c$CCDE LD B,(HL)       ; Fetch the length of the entry.
 $CCDF INC HL          ; Increment #REGhl.
 $CCE0 LD A,(HL)       ; Fetch the colour and size.
 $CCE1 AND %00000111   ; Keep bits 0 to 2.
 $CCE3 LD ($5B0D),A    ; Set #R$5B0D.
 $CCE6 LD ($5B34),HL   ; Set #R$5B34.
 $CCE9 PUSH DE         ; Stash #REGde on the stack.
 $CCEA EX DE,HL        ; Exchange #REGde and #REGhl.
 $CCEB LD A,(DE)       ; Fetch the colour and size.
 $CCEC INC DE          ; Increment #REGde.
 $CCED RLCA            ; {Rotate the size into the low
 $CCEE RLCA            ; two bits.}
 $CCEF AND %00000011   ; Keep bits 0 and 1.
 $CCF1 LD C,A          ; Copy it to #REGc.
 $CCF2 ADD A,A         ; {Multiply it by three.
 $CCF3 ADD A,C         ; }
 $CCF4 LD HL,$6460     ; Point #REGhl at #R$6460.
 $CCF7 CALL $CE06      ; Call #R$CE06.
 $CCFA LD A,(HL)       ; {Fetch the east and west
 $CCFB INC HL          ; distance and increment #REGhl.}
 $CCFC LD ($5B0B),A    ; Set #R$5B0B.
 $CCFF LD A,(HL)       ; {Fetch the north and south
 $CD00 INC HL          ; distance and increment #REGhl.}
 $CD01 LD ($5B0C),A    ; Set #R$5B0C.
 $CD04 LD A,(HL)       ; Fetch the floor level.
 $CD05 LD ($5B0E),A    ; Set #R$5B0E.
 $CD08 DEC B           ; {Subtract #N$02 from #REGb.
 $CD09 DEC B           ; }
 $CD0A EX DE,HL        ; Exchange #REGde and #REGhl.
 $CD0B POP DE          ; Restore #REGde from the stack.
; Copy each type of block from
; #R$7519.
@label=MakeRoomObjects_Background
*$CD0C LD A,(HL)       ; {Fetch the type and increment
 $CD0D INC HL          ; #REGhl.}
 $CD0E CP $FF          ; {Jump to #R$CD3A if it is #N$FF.
 $CD10 JR Z,$CD3A      ; }
 $CD12 PUSH BC         ; {Stash #REGbc and #REGhl on the
 $CD13 PUSH HL         ; stack.}
 $CD14 LD L,A          ; Copy it to #REGl.
 $CD15 LD H,$00        ; Set #REGh to #N$00.
 $CD17 ADD HL,HL       ; Double #REGhl.
 $CD18 LD BC,$7519     ; Point #REGbc at #R$7519.
 $CD1B ADD HL,BC       ; Add #REGbc to #REGhl.
 $CD1C LD A,(HL)       ; {Fetch the address of the
 $CD1D INC HL          ; template.
 $CD1E LD H,(HL)       ;
 $CD1F LD L,A          ; }
@label=MakeRoomObjects_BackgroundCopy
*$CD20 LD BC,$0008     ; Set #REGbc to #N($0008,$04,$04).
 $CD23 LDIR            ; Copy #N$08 bytes from #REGhl to
                       ; #REGde.
 $CD25 LD A,(IX+$08)   ; Fetch the room number of the
                       ; player.
 $CD28 LD (DE),A       ; Set the room number of the
                       ; object.
 $CD29 INC DE          ; Increment #REGde.
 $CD2A LD B,$17        ; Set #REGb to #N$17.
 $CD2C CALL $CE1C      ; Call #R$CE1C.
 $CD2F LD A,(HL)       ; {Jump to #R$CD20 if the next
 $CD30 AND A           ; byte is not zero.
 $CD31 JR NZ,$CD20     ; }
 $CD33 POP HL          ; {Restore #REGhl and #REGbc from
 $CD34 POP BC          ; the stack.}
 $CD35 DJNZ $CD0C      ; Jump to #R$CD0C until #REGb is
                       ; zero.
 $CD37 JP $CCD0        ; Jump to #R$CCD0.
; The other objects. #REGiy points
; at the object that is being made.
@label=MakeRoomObjects_Foreground
*$CD3A DEC B           ; Decrement #REGb.
 $CD3B PUSH IY         ; Stash #REGiy on the stack.
 $CD3D PUSH DE         ; {Copy #REGde to #REGiy (using
 $CD3E POP IY          ; the stack).}
@label=MakeRoomObjects_ForegroundObject
*$CD40 LD A,(HL)       ; Fetch the type and the number
                       ; of places.
 $CD41 AND %00000111   ; Keep bits 0 to 2.
 $CD43 INC A           ; Increment #REGa.
 $CD44 LD C,A          ; Copy it to #REGc.
 $CD45 LD A,(HL)       ; Fetch the type and the number
                       ; of places again.
 $CD46 INC HL          ; Increment #REGhl.
 $CD47 DEC B           ; Decrement #REGb.
 $CD48 LD D,(HL)       ; Fetch the first place.
 $CD49 INC HL          ; Increment #REGhl.
 $CD4A PUSH HL         ; Stash #REGhl on the stack.
 $CD4B RRCA            ; {Move the type into bits 1 to
 $CD4C RRCA            ; 5.}
 $CD4D AND %00111110   ; Keep bits 1 to 5.
 $CD4F JP Z,$CE00      ; Jump to #R$CE00 if it is zero.
 $CD52 CP $3E          ; {Jump to #R$CDF0 if it is #N$3E.
 $CD54 JP Z,$CDF0      ; }
 $CD57 LD HL,($5B20)   ; Fetch #R$5B20.
 $CD5A CALL $CE06      ; Call #R$CE06.
 $CD5D LD A,(HL)       ; {Fetch the address of the
 $CD5E INC HL          ; template.
 $CD5F LD H,(HL)       ;
 $CD60 LD L,A          ; }
@label=MakeRoomObjects_ForegroundPlace
*$CD61 PUSH HL         ; Stash #REGhl on the stack.
@label=MakeRoomObjects_ForegroundSprite
*$CD62 LD A,(HL)       ; {Fetch the sprite number and
 $CD63 INC HL          ; increment #REGhl.}
 $CD64 LD (IY+$00),A   ; Set the sprite number of the
                       ; object.
 $CD67 LD A,(HL)       ; {Fetch the width and increment
 $CD68 INC HL          ; #REGhl.}
 $CD69 LD (IY+$04),A   ; Set the width of the object.
 $CD6C LD A,(HL)       ; {Fetch the depth and increment
 $CD6D INC HL          ; #REGhl.}
 $CD6E LD (IY+$05),A   ; Set the depth of the object.
 $CD71 LD A,(HL)       ; {Fetch the height and increment
 $CD72 INC HL          ; #REGhl.}
 $CD73 LD (IY+$06),A   ; Set the height of the object.
 $CD76 LD A,(HL)       ; {Fetch the flags and increment
 $CD77 INC HL          ; #REGhl.}
 $CD78 LD (IY+$07),A   ; Set the flags of the object.
 $CD7B LD A,(IX+$08)   ; Fetch the room number of the
                       ; player.
 $CD7E LD (IY+$08),A   ; Set the room number of the
                       ; object.
; The offset has the half step along
; the x axis in bit 0, the half step along
; the y axis in bit 1, and the offset up
; the z axis in bits 2 to 7. The place has
; the x position in bits 0 to 2, the y
; position in bits 3 to 5 and the height
; in bits 6 and 7. The x position of the
; object is the x position times #N($10),
; plus #N$08 if the half step is set, plus
; #N$48.
 $CD81 LD A,($5B19)    ; Fetch #R$5B19.
 $CD84 RLCA            ; {Move the half step along x
 $CD85 RLCA            ; into bit 3.
 $CD86 RLCA            ; }
 $CD87 AND %00001000   ; Keep bit 3.
 $CD89 LD E,A          ; Copy it to #REGe.
 $CD8A LD A,D          ; Fetch the place.
 $CD8B RLCA            ; {Move the x position into bits
 $CD8C RLCA            ; 4 to 6.
 $CD8D RLCA            ;
 $CD8E RLCA            ; }
 $CD8F AND %01110000   ; Keep bits 4 to 6.
 $CD91 ADD A,E         ; Add #REGe.
 $CD92 ADD A,$48       ; Add #N$48.
 $CD94 LD (IY+$01),A   ; Set the x position of the
                       ; object.
; The y position is worked out in
; the same way from the y position and the
; half step along y.
 $CD97 LD A,($5B19)    ; Fetch #R$5B19.
 $CD9A RLCA            ; {Move the half step along y
 $CD9B RLCA            ; into bit 3.}
 $CD9C AND %00001000   ; Keep bit 3.
 $CD9E LD E,A          ; Copy it to #REGe.
 $CD9F LD A,D          ; Fetch the place.
 $CDA0 RLCA            ; Move the y position into bits
                       ; 4 to 6.
 $CDA1 AND %01110000   ; Keep bits 4 to 6.
 $CDA3 ADD A,E         ; Add #REGe.
 $CDA4 ADD A,$48       ; Add #N$48.
 $CDA6 LD (IY+$02),A   ; Set the y position of the
                       ; object.
; The z position is the height times
; #N($0C), plus the offset up the z axis,
; plus the floor.
 $CDA9 LD A,D          ; Fetch the place.
 $CDAA RLCA            ; {Move the height into the low
 $CDAB RLCA            ; two bits.}
 $CDAC AND %00000011   ; Keep bits 0 and 1.
 $CDAE ADD A,A         ; {Multiply it by four.
 $CDAF ADD A,A         ; }
 $CDB0 LD E,A          ; Copy it to #REGe.
 $CDB1 ADD A,A         ; Double it.
 $CDB2 ADD A,E         ; Add #REGe.
 $CDB3 LD E,A          ; Copy it to #REGe.
 $CDB4 LD A,($5B19)    ; Fetch #R$5B19.
 $CDB7 ADD A,E         ; Add #REGe.
 $CDB8 AND %11111100   ; Keep bits 2 to 7.
 $CDBA LD E,A          ; Copy it to #REGe.
 $CDBB LD A,($5B0E)    ; Fetch #R$5B0E.
 $CDBE ADD A,E         ; Add #REGe.
 $CDBF LD (IY+$03),A   ; Set the z position of the
                       ; object.
 $CDC2 PUSH BC         ; Stash #REGbc on the stack.
 $CDC3 LD BC,$0009     ; Set #REGbc to #N($0009,$04,$04).
 $CDC6 ADD IY,BC       ; Add #REGbc to #REGiy.
 $CDC8 LD B,$17        ; Set #REGb to #N$17.
@label=MakeRoomObjects_ForegroundClear
*$CDCA LD (IY+$00),$00 ; Write #N$00.
 $CDCE INC IY          ; Increment #REGiy.
 $CDD0 DJNZ $CDCA      ; Jump to #R$CDCA until #REGb is
                       ; zero.
 $CDD2 POP BC          ; Restore #REGbc from the stack.
 $CDD3 LD A,(HL)       ; {Jump to #R$CD62 if the next
 $CDD4 AND A           ; byte is not zero.
 $CDD5 JR NZ,$CD62     ; }
 $CDD7 POP DE          ; {Restore #REGde and #REGhl from
 $CDD8 POP HL          ; the stack.}
 $CDD9 DEC B           ; Decrement #REGb.
 $CDDA JR Z,$CDE8      ; Jump to #R$CDE8 if it is zero.
 $CDDC DEC C           ; {Jump to #R$CD40 if #REGc is
 $CDDD JP Z,$CD40      ; zero.}
 $CDE0 LD A,(HL)       ; {Fetch the next place and
 $CDE1 INC HL          ; increment #REGhl.}
 $CDE2 PUSH HL         ; Stash #REGhl on the stack.
 $CDE3 EX DE,HL        ; Exchange #REGde and #REGhl.
 $CDE4 LD D,A          ; Copy it to #REGd.
 $CDE5 JP $CD61        ; Jump to #R$CD61.
@label=MakeRoomObjects_Finish
*$CDE8 PUSH IY         ; {Copy #REGiy to #REGde (using
 $CDEA POP DE          ; the stack).}
 $CDEB POP IY          ; Restore #REGiy from the stack.
 $CDED JP $CCD0        ; Jump to #R$CCD0.
; Switch to the second table of
; object types.
@label=MakeRoomObjects_SwitchTable
*$CDF0 LD HL,($5B20)   ; Fetch #R$5B20.
 $CDF3 LD A,$40        ; Set #REGa to #N$40.
 $CDF5 CALL $CE06      ; Call #R$CE06.
 $CDF8 LD ($5B20),HL   ; Set #R$5B20.
@label=MakeRoomObjects_Next
*$CDFB DEC B           ; Decrement #REGb.
 $CDFC POP HL          ; Restore #REGhl from the stack.
 $CDFD JP $CD40        ; Jump to #R$CD40.
; Type #N$00 sets the position
; offset.
@label=MakeRoomObjects_SetOffset
*$CE00 LD A,D          ; Fetch #REGd.
 $CE01 LD ($5B19),A    ; Set #R$5B19.
 $CE04 JR $CDFB        ; Jump to #R$CDFB.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$D3F0 }
; LIST#

; Add A To HL
;
; Used by the routines at #R$A7AE, #R$A9C7, #R$AC6B, #R$ADB0, #R$B0E7, #R$B4C5,
; #R$B690, #R$C1BD, #R$CCA7, #R$CCDE and #R$D174.
; .
; Adds an unsigned number to
; #REGhl.
;
;   A The number
;   HL The address
; O:HL The new address
@label=AddAToHL
c$CE06 ADD A,L       ; Add #REGa to #REGl.
 $CE07 LD L,A        ; Copy it to #REGl.
 $CE08 LD A,H        ; Fetch #REGh.
 $CE09 ADC A,$00     ; Add #N$00 with carry.
 $CE0B LD H,A        ; Copy it to #REGh.
 $CE0C RET           ; Return.
; View the equivalent code in;
; #LIST
; { #CYBERUN$9BCF }
; { #GUNFRIGHT$D275 }
; { #KNIGHTLORE$D4F2 }
; { #NIGHTSHADE$E596 }
; { #PENTAGRAM$B519 }
; LIST#

; Multiply A By DE
;
; Used by the routine at #R$D174.
; .
; Multiplies #REGa by #REGde.
;
;   A The multiplier
;   DE The multiplicand
; O:HL The product
@label=MultiplyAByDE
c$CE0D PUSH BC       ; Stash #REGbc on the stack.
 $CE0E LD HL,$0000   ; Set #REGhl to #N($0000,$04,$04).
 $CE11 LD B,$08      ; Set #REGb to #N$08.
@label=MultiplyAByDE_Loop
*$CE13 ADD HL,HL     ; Double #REGhl.
 $CE14 RLCA          ; {Jump to #R$CE18 if the carry
 $CE15 JR NC,$CE18   ; flag is not set.}
 $CE17 ADD HL,DE     ; Add #REGde to #REGhl.
@label=MultiplyAByDE_Next
*$CE18 DJNZ $CE13    ; Jump to #R$CE13 until #REGb is
                     ; zero.
 $CE1A POP BC        ; Restore #REGbc from the stack.
 $CE1B RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9AAD }
; { #GUNFRIGHT$D03E }
; { #KNIGHTLORE$D4F9 }
; { #NIGHTSHADE$E0EE }
; { #TRANZAM$6F2F }
; { #UNDERWURLDE$AC68 }
; LIST#

; Clear Bytes
;
; Used by the routines at #R$AC6B, #R$AE99, #R$BD6B, #R$CCD0 and #R$CCDE.
; .
; Fills a number of bytes with
; zero. The entry point at #R$CE1D fills
; them with the byte in #REGa.
;
; B Number of bytes
; DE Address of the first byte
@label=ClearBytes
c$CE1C XOR A         ; Set #REGa to #N$00.
; This entry point is used by the routine at #R$A749.
@label=FillBytes
*$CE1D LD (DE),A     ; Write #REGa.
 $CE1E INC DE        ; Increment #REGde.
 $CE1F DJNZ $CE1D    ; Jump to #R$CE1D until #REGb is
                     ; zero.
 $CE21 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$D508 }
; { #PENTAGRAM$B513 }
; LIST#

; Pause Game
;
; Used by the routine at #R$A68B.
; .
; Pauses the game if CAPS SHIFT or
; SPACE is pressed on its own. The game
; waits for the key to be let go of, then
; for it to be pressed again and let go of
; again. There is a beep for the start and
; for the end of the pause.
;
; .
;
; Return unless CAPS SHIFT or SPACE
; is pressed on its own.
@label=PauseGame
c$CE22 LD A,$7E      ; {Read from the keyboard;
 $CE24 CALL $B759    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$7E | SHIFT / SPACE | Z / SYM | X / M | C / N | V / B }
                     ; TABLE#}
 $CE27 BIT 0,A       ; {Return if bit 0 is not set.
 $CE29 RET Z         ; }
 $CE2A AND %00011110 ; Keep bits 1 to 4.
 $CE2C RET NZ        ; Return if any of them is set.
; Wait for the key to be let go of,
; then pressed and let go of again.
@label=PauseGame_Release
*$CE2D LD A,$7E      ; {Read the keys.
 $CE2F CALL $B759    ; }
 $CE32 BIT 0,A       ; {Jump to #R$CE2D if bit 0 is
 $CE34 JR NZ,$CE2D   ; set.}
 $CE36 CALL $B6B6    ; Call #R$B6B6.
@label=PauseGame_Wait
*$CE39 LD A,$7E      ; {Read the keys.
 $CE3B CALL $B759    ; }
 $CE3E BIT 0,A       ; {Jump to #R$CE39 if bit 0 is
 $CE40 JR Z,$CE39    ; not set.}
@label=PauseGame_Finish
*$CE42 LD A,$7E      ; {Read the keys.
 $CE44 CALL $B759    ; }
 $CE47 BIT 0,A       ; {Jump to #R$CE42 if bit 0 is
 $CE49 JR NZ,$CE42   ; set.}
 $CE4B JP $B6B6      ; Jump to #R$B6B6.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$D206 }
; { #KNIGHTLORE$D50E }
; { #NIGHTSHADE$E32C }
; LIST#

; Clear Objects
;
; Used by the routine at #R$B761.
; .
; Clears the objects table, which
; includes the player.
@label=ClearObjects
c$CE4E LD HL,$5B88   ; Point #REGhl at #R$5B88.
 $CE51 LD BC,$0700   ; Set #REGbc to #N$0700.
 $CE54 JR $CE56      ; Jump to #R$CE56.
; View the equivalent code in;
; #LIST
; { #PENTAGRAM$CB54 }
; LIST#

; Fill Memory
;
; Used by the routines at #R$A631, #R$A647, #R$CE4E and #R$CE60.
; .
; Fills an area of memory with
; zero. The entry point at #R$CE58 fills
; it with the byte in #REGe.
;
; BC Number of bytes
; HL Address of the first byte
@label=FillMemory
c$CE56 LD E,$00      ; Set #REGe to #N$00.
; This entry point is used by the routines at #R$CE68 and #R$CE7B.
@label=FillMemory_WithValue
*$CE58 LD (HL),E     ; Write #REGe.
 $CE59 INC HL        ; Increment #REGhl.
 $CE5A DEC BC        ; Decrement #REGbc.
 $CE5B LD A,B        ; {Jump to #R$CE58 if #REGbc is
 $CE5C OR C          ; not zero.
 $CE5D JR NZ,$CE58   ; }
 $CE5F RET           ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$D6E1 }
; { #KNIGHTLORE$D53A }
; { #MARTIANOIDS$B1A3 }
; { #NIGHTSHADE$E5BA }
; { #PENTAGRAM$CB77 }
; { #UNDERWURLDE$9569 }
; LIST#

; Clear Screen Bitmap
;
; Used by the routine at #R$CE73.
; .
; Clears the bitmap of the screen.
@label=ClearScreenBitmap
c$CE60 LD HL,$4000   ; Point #REGhl at #N$4000 (in the screen buffer).
 $CE63 LD BC,$1800   ; Set #REGbc to #N$1800.
 $CE66 JR $CE56      ; Jump to #R$CE56.
; View the equivalent code in;
; #LIST
; { #ATICATAC$80B4 }
; { #COOKIE$74D4 }
; { #CYBERUN$9A7E }
; { #GUNFRIGHT$D6DB }
; { #JETPAC$71B8 }
; { #KNIGHTLORE$D544 }
; { #LUNARJETMAN$84AD }
; { #NIGHTSHADE$E5A8 }
; { #PSSST$7439 }
; { #SABREWULF$BB81 }
; { #TRANZAM$7211 }
; LIST#

; Clear Attributes
;
; Used by the routines at #R$B761 and #R$CE73.
; .
; Sets the attributes of the screen
; to bright red on black. The entry point
; at #R$CE6A sets them to the value in
; #REGa.
@label=ClearAttributes
c$CE68 LD A,$42      ; Set #REGa to #N$42.
; This entry point is used by the routine at #R$A749.
@label=FillAttributes
*$CE6A LD E,A        ; Copy it to #REGe.
 $CE6B LD HL,$5800   ; Point #REGhl at #N$5800 (in the attribute buffer).
 $CE6E LD BC,$0300   ; Set #REGbc to #N$0300.
 $CE71 JR $CE58      ; Jump to #R$CE58.

; Clear Screen
;
; Used by the routines at #R$A650, #R$B761 and #R$B8A9.
; .
; Clears the screen to bright red
; on black, with a black border.
; .
; #PUSHS #UDGTABLE { =h Before | =h After #R$CE73 }
; { #SIM(start=$A631,stop=$A676,sp=$F100,r=$80,clear=1)
; #SIM(start=$BA7E,stop=$BA95)
; #SCR$02(clear-screen-before)
; | #SIM(start=$CE73,stop=$0000,sp=$EC00)
; #SCR$02(clear-screen-after) } UDGTABLE# #POPS
@label=ClearScreen
c$CE73 XOR A         ; {Set the border to black.
 $CE74 OUT ($FE),A   ; }
 $CE76 CALL $CE68    ; Call #R$CE68.
 $CE79 JR $CE60      ; Jump to #R$CE60.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$D55F }
; LIST#

; Clear Screen Buffer
;
; Used by the routines at #R$B761, #R$B8A9, #R$BA7E and #R$CAA2.
; .
; Clears the buffer that the
; playing area is drawn in before it is
; copied to the screen.
@label=ClearScreenBuffer
c$CE7B LD BC,$1800   ; Set #REGbc to #N$1800.
 $CE7E LD HL,$D200   ; Point #REGhl at #R$D200.
 $CE81 LD E,$00      ; Set #REGe to #N$00.
 $CE83 JR $CE58      ; Jump to #R$CE58.

; Update Screen
;
; Used by the routines at #R$A68B, #R$B761 and #R$BC31.
; .
; Copies the screen buffer to the
; screen. The buffer holds the lines of
; the screen from the bottom up, #N$20
; bytes to a line, so the lines are copied
; from the bottom of the screen to the
; top.
; .
; #PUSHS #UDGTABLE { =h Before | =h After #R$CE85 }
; { #SIM(start=$A631,stop=$A676,sp=$F100,r=$80,clear=1)
; #SIM(start=$BA7E,stop=$BA95)
; #SCR$02(update-screen-before)
; | #SIM(start=$A67F,stop=$A6FE)
; #SIM(start=$A715,stop=$A72E)
; #SIM(start=$CE85,stop=$0000,sp=$EC00)
; #SCR$02(update-screen-after) } UDGTABLE# #POPS
;
; .
;
; Copy from #R$D200 to the last
; line of the bitmap.
@label=UpdateScreen
c$CE85 LD HL,$D200   ; Point #REGhl at #R$D200.
 $CE88 LD DE,$57E0   ; Point #REGde at #N$57E0 (in the screen buffer).
 $CE8B LD BC,$C020   ; Set #REGbc to #N$C020.
@label=UpdateScreen_Line
*$CE8E PUSH BC       ; {Stash #REGbc and #REGde on the
 $CE8F PUSH DE       ; stack.}
 $CE90 LD B,$00      ; Set #REGb to #N$00.
 $CE92 LDIR          ; Copy #REGc bytes from #REGhl
                     ; to #REGde.
 $CE94 POP DE        ; Restore #REGde from the stack.
 $CE95 DEC D         ; Decrement #REGd.
 $CE96 LD A,D        ; {Fetch #REGd and invert it.
 $CE97 CPL           ; }
 $CE98 AND %00000111 ; Keep bits 0 to 2.
 $CE9A JR NZ,$CEA6   ; Jump to #R$CEA6 if it is not
                     ; zero.
 $CE9C LD A,E        ; {Subtract #N$20 from #REGe.
 $CE9D SUB $20       ;
 $CE9F LD E,A        ; }
 $CEA0 JR C,$CEA6    ; Jump to #R$CEA6 if carry is
                     ; set.
 $CEA2 LD A,D        ; {Add #N$08 to #REGd.
 $CEA3 ADD A,$08     ;
 $CEA5 LD D,A        ; }
@label=UpdateScreen_Next
*$CEA6 POP BC        ; Restore #REGbc from the stack.
 $CEA7 DEC B         ; Decrement #REGb.
 $CEA8 JR NZ,$CE8E   ; Jump to #R$CE8E until #REGb is
                     ; zero.
 $CEAA RET           ; Return.
; View the equivalent code in;
; #LIST
; { #PENTAGRAM$B178 }
; LIST#

; Draw Changed Objects
;
; Used by the routine at #R$A68B.
; .
; Updates the playing area for the
; objects that have changed. First the
; sprites of the objects that moved are
; wiped out of the screen buffer: for each
; object in the list at #R$C745 that is
; flagged to be wiped, the area covered by
; the old and the new position of its
; sprite is cleared, and the area is kept
; on the stack. Then the objects are drawn
; in order and the objects that the player
; is carrying are shown. Last, each of the
; areas that were kept is copied from the
; buffer to the screen. When the panel is
; to be drawn again, the whole screen is
; going to be drawn, so none of the areas
; are wiped.
;
; .
;
; Wipe each flagged sprite, unless
; the panel is to be drawn again.
@label=DrawChangedObjects
c$CEAB XOR A          ; {Write #N$00 to #R$5B08.
 $CEAC LD ($5B08),A   ; }
 $CEAF PUSH IX        ; Stash #REGix on the stack.
 $CEB1 LD A,($5B17)   ; Fetch #R$5B17.
 $CEB4 AND A          ; {Jump to #R$CF5F if it is not
 $CEB5 JP NZ,$CF5F    ; zero.}
 $CEB8 LD HL,$C745    ; Point #REGhl at #R$C745.
 $CEBB LD ($5B2B),HL  ; Set #R$5B2B.
@label=DrawChangedObjects_Wipe
*$CEBE LD HL,($5B2B)  ; Fetch #R$5B2B.
 $CEC1 LD A,(HL)      ; Fetch the index of the object.
 $CEC2 INC HL         ; Increment #REGhl.
 $CEC3 LD ($5B2B),HL  ; Set #R$5B2B.
 $CEC6 CP $FF         ; {Jump to #R$CF5F if it is #N$FF.
 $CEC8 JP Z,$CF5F     ; }
 $CECB CALL $CC96     ; Call #R$CC96.
 $CECE PUSH HL        ; {Copy #REGhl to #REGix (using
 $CECF POP IX         ; the stack).}
 $CED1 BIT 5,(IX+$07) ; {Jump to #R$CEBE if the object is not flagged to be
 $CED5 JR Z,$CEBE     ; wiped.}
 $CED7 RES 5,(IX+$07) ; Reset bit 5 of the flags.
; The left edge of the area is the
; lower of the old and the new pixel x
; position. The width is worked out in
; bytes of the screen from there to the
; higher of the old and the new right
; edge.
 $CEDB LD A,(IX+$1A)  ; {Subtract the old pixel x from
 $CEDE SUB (IX+$1E)   ; the new.}
 $CEE1 JP C,$CF55     ; Jump to #R$CF55 if carry is
                      ; set.
 $CEE4 LD C,(IX+$1E)  ; Copy the old pixel x to #REGc.
@label=DrawChangedObjects_Width
*$CEE7 LD A,(IX+$1E)  ; Fetch the old pixel x
                      ; position.
 $CEEA RRCA           ; {Divide it by eight.
 $CEEB RRCA           ;
 $CEEC RRCA           ; }
 $CEED AND %00011111  ; Keep bits 0 to 4.
 $CEEF ADD A,(IX+$1C) ; Add the old width in bytes.
 $CEF2 LD E,A         ; Copy it to #REGe.
 $CEF3 LD A,(IX+$1A)  ; Fetch the new pixel x
                      ; position.
 $CEF6 RRCA           ; {Divide it by eight.
 $CEF7 RRCA           ;
 $CEF8 RRCA           ; }
 $CEF9 AND %00011111  ; Keep bits 0 to 4.
 $CEFB ADD A,(IX+$18) ; Add the new width in bytes.
 $CEFE CP E           ; {Jump to #R$CF02 if it is lower
 $CEFF JR C,$CF02     ; than #REGe.}
 $CF01 LD E,A         ; Copy it to #REGe.
@label=DrawChangedObjects_WidthFetchLeft
*$CF02 LD A,C         ; Fetch #REGc.
 $CF03 RRCA           ; {Divide it by eight.
 $CF04 RRCA           ;
 $CF05 RRCA           ; }
 $CF06 AND %00011111  ; Keep bits 0 to 4.
 $CF08 LD B,A         ; Copy it to #REGb.
 $CF09 LD A,E         ; Fetch #REGe.
 $CF0A SUB B          ; Subtract #REGb.
 $CF0B LD H,A         ; Copy it to #REGh.
; The bottom edge of the area is
; the lower of the old and the new pixel y
; position. The height is worked out from
; there to the higher of the old and the
; new top edge.
 $CF0C LD A,(IX+$1B)  ; Fetch the new pixel y
                      ; position.
 $CF0F SUB (IX+$1F)   ; Subtract the old pixel y.
 $CF12 JR C,$CF5A     ; Jump to #R$CF5A if carry is
                      ; set.
 $CF14 LD B,(IX+$1F)  ; Copy the old pixel y to #REGb.
@label=DrawChangedObjects_Height
*$CF17 LD A,(IX+$1F)  ; Fetch the old pixel y
                      ; position.
 $CF1A ADD A,(IX+$1D) ; Add the old height in lines.
 $CF1D LD E,A         ; Copy it to #REGe.
 $CF1E LD A,(IX+$1B)  ; Fetch the new pixel y
                      ; position.
 $CF21 ADD A,(IX+$19) ; Add the new height in lines.
 $CF24 CP E           ; Compare it with #REGe.
 $CF25 JR NC,$CF28    ; Jump to #R$CF28 if it is #REGe
                      ; or more.
 $CF27 LD A,E         ; Fetch #REGe.
@label=DrawChangedObjects_HeightTakeBottom
*$CF28 SUB B          ; Subtract #REGb.
 $CF29 LD L,A         ; Copy it to #REGl.
 $CF2A LD A,B         ; Fetch #REGb.
 $CF2B CP $C0         ; {Jump to #R$CEBE if it is #N$C0
 $CF2D JR NC,$CEBE    ; or more.}
 $CF2F ADD A,L        ; Add #REGl.
 $CF30 SUB $C0        ; Subtract #N$C0.
 $CF32 JR C,$CF38     ; Jump to #R$CF38 if carry is
                      ; set.
 $CF34 NEG            ; Negate #REGa.
 $CF36 ADD A,L        ; Add #REGl.
 $CF37 LD L,A         ; Copy it to #REGl.
; Wipe the area and keep it on the
; stack.
@label=DrawChangedObjects_Keep
*$CF38 CALL $D135     ; Call #R$D135.
 $CF3B CALL $D120     ; Call #R$D120.
 $CF3E LD A,L         ; {Exchange #REGl and #REGc.
 $CF3F LD L,C         ;
 $CF40 LD C,A         ; }
 $CF41 LD A,H         ; {Exchange #REGh and #REGb.
 $CF42 LD H,B         ;
 $CF43 LD B,A         ; }
 $CF44 LD A,($5B08)   ; Fetch #R$5B08.
 $CF47 INC A          ; Increment #REGa.
 $CF48 LD ($5B08),A   ; Set #R$5B08.
 $CF4B PUSH BC        ; {Stash #REGbc, #REGde and
 $CF4C PUSH DE        ; #REGhl on the stack.
 $CF4D PUSH HL        ; }
 $CF4E XOR A          ; Set #REGa to #N$00.
 $CF4F CALL $BF83     ; Call #R$BF83.
 $CF52 JP $CEBE       ; Jump to #R$CEBE.
@label=DrawChangedObjects_Left
*$CF55 LD C,(IX+$1A)  ; Copy the new pixel x to #REGc.
 $CF58 JR $CEE7       ; Jump to #R$CEE7.
@label=DrawChangedObjects_Bottom
*$CF5A LD B,(IX+$1B)  ; Copy the new pixel y to #REGb.
 $CF5D JR $CF17       ; Jump to #R$CF17.
; Draw the objects, then copy the
; wiped areas to the screen.
@label=DrawChangedObjects_Draw
*$CF5F CALL $C785     ; Call #R$C785.
 $CF62 CALL $BC9D     ; Call #R$BC9D.
 $CF65 LD HL,$5B08    ; Point #REGhl at #R$5B08.
 $CF68 LD A,($5B1E)   ; Fetch #R$5B1E.
 $CF6B ADD A,(HL)     ; Add #R$5B08.
 $CF6C LD ($5B1E),A   ; Set #R$5B1E.
@label=DrawChangedObjects_Copy
*$CF6F LD HL,$5B08    ; Point #REGhl at #R$5B08.
 $CF72 LD A,(HL)      ; {Jump to #R$CF82 if it is zero.
 $CF73 AND A          ;
 $CF74 JR Z,$CF82     ; }
 $CF76 DEC (HL)       ; Decrement #R$5B08.
 $CF77 POP HL         ; {Restore #REGhl, #REGde and
 $CF78 POP DE         ; #REGbc from the stack.
 $CF79 POP BC         ; }
 $CF7A LD A,B         ; {Exchange #REGb and #REGc.
 $CF7B LD B,C         ;
 $CF7C LD C,A         ; }
 $CF7D CALL $CF85     ; Call #R$CF85.
 $CF80 JR $CF6F       ; Jump to #R$CF6F.
@label=DrawChangedObjects_Finish
*$CF82 POP IX         ; Restore #REGix from the stack.
 $CF84 RET            ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$D59F }
; { #PENTAGRAM$B19E }
; LIST#

; Copy Block To Screen
;
; Used by the routines at #R$AD66, #R$BC9D, #R$BF2F and #R$CEAB.
; .
; Copies an area of the screen
; buffer to the screen, a line at a time.
;
; B Number of lines
; C Number of bytes in a line
; DE Address of the first line on the screen
; HL Address of the first line in the buffer
;
; Copy one line, then move up.
@label=CopyBlockToScreen
c$CF85 PUSH BC       ; {Stash #REGbc, #REGde and
 $CF86 PUSH DE       ; #REGhl on the stack.
 $CF87 PUSH HL       ; }
 $CF88 LD B,$00      ; Set #REGb to #N$00.
 $CF8A LDIR          ; Copy #REGc bytes from #REGhl
                     ; to #REGde.
 $CF8C POP HL        ; Restore #REGhl from the stack.
 $CF8D LD DE,$0020   ; {Move #REGhl up by #N($0020,$04,$04) bytes.
 $CF90 ADD HL,DE     ; }
 $CF91 POP DE        ; Restore #REGde from the stack.
 $CF92 DEC D         ; Decrement #REGd.
 $CF93 LD A,D        ; {Fetch #REGd and invert it.
 $CF94 CPL           ; }
 $CF95 AND %00000111 ; Keep bits 0 to 2.
 $CF97 JR NZ,$CFA3   ; Jump to #R$CFA3 if it is not
                     ; zero.
 $CF99 LD A,E        ; {Subtract #N$20 from #REGe.
 $CF9A SUB $20       ;
 $CF9C LD E,A        ; }
 $CF9D JR C,$CFA3    ; Jump to #R$CFA3 if carry is
                     ; set.
 $CF9F LD A,D        ; {Add #N$08 to #REGd.
 $CFA0 ADD A,$08     ;
 $CFA2 LD D,A        ; }
@label=CopyBlockToScreen_Next
*$CFA3 POP BC        ; Restore #REGbc from the stack.
 $CFA4 DJNZ $CF85    ; Jump to #R$CF85 until #REGb is
                     ; zero.
 $CFA6 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$D67C }
; { #PENTAGRAM$B278 }
; LIST#

; Build Lookup Tables
;
; Used by the routine at #R$A650.
; .
; Builds the two tables that the
; sprite routines use. The first is the
; set of tables of shifted bytes (#R$F200)
; in pages #N$F2 to #N$FF: for each shift
; of one to seven bits there is a page
; with the inverse of every byte shifted,
; and a page after it with the inverse of
; the bits that are pushed out into the
; next byte. The second is the table of
; every byte with its bits reversed
; (#R$F100).
;
; .
;
; Build the tables of shifted
; bytes.
@label=BuildLookupTables
c$CFA7 LD L,$00      ; Set #REGl to #N$00.
@label=BuildLookupTables_Shift
*$CFA9 LD D,$00      ; Set #REGd to #N$00.
 $CFAB LD E,L        ; Copy #REGl to #REGe.
 $CFAC LD H,$FF      ; Set #REGh to #N$FF.
 $CFAE LD B,$07      ; Set #REGb to #N$07.
@label=BuildLookupTables_ShiftStep
*$CFB0 SLA E         ; Shift #REGe left.
 $CFB2 RL D          ; Rotate #REGd left.
 $CFB4 LD A,E        ; Fetch #REGe.
 $CFB5 CPL           ; Invert it.
 $CFB6 LD (HL),A     ; Write it.
 $CFB7 DEC H         ; Decrement #REGh.
 $CFB8 LD A,D        ; Fetch #REGd.
 $CFB9 CPL           ; Invert it.
 $CFBA LD (HL),A     ; Write it.
 $CFBB DEC H         ; Decrement #REGh.
 $CFBC DJNZ $CFB0    ; Jump to #R$CFB0 until #REGb is
                     ; zero.
 $CFBE INC L         ; Increment #REGl.
 $CFBF JR NZ,$CFA9   ; Jump to #R$CFA9 if #REGl is
                     ; not zero.
; Build the table of reversed
; bytes.
 $CFC1 LD HL,$F100   ; Point #REGhl at #R$F100.
@label=BuildLookupTables_Reverse
*$CFC4 LD D,L        ; Copy #REGl to #REGd.
 $CFC5 LD B,$08      ; Set #REGb to #N$08.
@label=BuildLookupTables_ReverseBit
*$CFC7 SRL D         ; Shift #REGd right.
 $CFC9 RL E          ; Rotate #REGe left.
 $CFCB DJNZ $CFC7    ; Jump to #R$CFC7 until #REGb is
                     ; zero.
 $CFCD LD (HL),E     ; Write #REGe.
 $CFCE INC L         ; Increment #REGl.
 $CFCF JR NZ,$CFC4   ; Jump to #R$CFC4 if #REGl is
                     ; not zero.
 $CFD1 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$D69E }
; { #PENTAGRAM$B29A }
; LIST#

; Calculate Pixel Coordinates
;
; Used by the routines at #R$AE8A, #R$C63D and #R$D013.
; .
; Works out the pixel position of an
; object on the screen from its x, y and z
; positions. The pixel x position is x + y
; - #N$80 and the pixel y position (from
; the bottom of the screen) is half of y -
; x + #N($80), plus z, less #N($28), each with
; the adjustments of the object added.
; While #R$5B24 is set the pixel positions
; are left as the scene has set them.
;
;   IX The address of the object
; O:F The carry flag is set if the sprite is on the screen
;
; Return if the scene has set the
; positions.
@label=CalculatePixelCoordinates
c$CFD2 LD A,($5B24)   ; Fetch #R$5B24.
 $CFD5 AND A          ; {Return with the carry flag
 $CFD6 SCF            ; set if it is not zero.
 $CFD7 RET NZ         ; }
; Work out the pixel x position.
 $CFD8 LD A,(IX+$01)  ; Fetch the x position of the
                      ; object.
 $CFDB ADD A,(IX+$02) ; Add the y position.
 $CFDE SUB $80        ; Subtract #N$80.
 $CFE0 ADD A,(IX+$12) ; Add the pixel x adjustment.
 $CFE3 LD (IX+$1A),A  ; Set the pixel x position.
; Work out the pixel y position.
 $CFE6 LD A,(IX+$02)  ; Fetch the y position of the
                      ; object.
 $CFE9 SUB (IX+$01)   ; Subtract the x position.
 $CFEC ADD A,$80      ; Add #N$80.
 $CFEE SRL A          ; Halve it.
 $CFF0 ADD A,(IX+$03) ; Add the z position.
 $CFF3 SUB $28        ; Subtract #N$28.
 $CFF5 ADD A,(IX+$13) ; Add the pixel y adjustment.
 $CFF8 LD (IX+$1B),A  ; Set the pixel y position.
 $CFFB CP $C0         ; Compare it with #N$C0.
 $CFFD RET            ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$D6C9 }
; { #PENTAGRAM$B2C5 }
; LIST#

; Get Sprite Address
;
; Used by the routines at #R$C63D and #R$D027.
; .
; Fetches the sprite for the sprite
; number of an object from #R$7827. The
; data of the sprite is flipped, in place,
; if it is not the same way round as the
; flags of the object say. If there is no
; sprite for the sprite number, this
; returns to the routine that called the
; routine that called it.
;
;   IX The address of the object
; O:DE The address of the sprite
;
; Find the address of the sprite.
@label=GetSpriteAddress
c$CFFE LD L,(IX+$00) ; Fetch the sprite number.
 $D001 LD H,$00      ; Set #REGh to #N$00.
 $D003 ADD HL,HL     ; Double #REGhl.
 $D004 LD BC,$7827   ; Point #REGbc at #R$7827.
 $D007 ADD HL,BC     ; Add #REGbc to #REGhl.
 $D008 LD E,(HL)     ; {Fetch the address of the
 $D009 INC HL        ; sprite.
 $D00A LD D,(HL)     ; }
; Flip it if there is a sprite.
 $D00B LD A,(DE)     ; {Fetch the width and test it.
 $D00C AND A         ; }
 $D00D JP NZ,$D174   ; Jump to #R$D174 if it is not
                     ; zero.
 $D010 INC SP        ; {Drop the return address.
 $D011 INC SP        ; }
 $D012 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$D6EF }
; { #PENTAGRAM$B2EE }
; LIST#

; Draw Object
;
; Used by the routine at #R$C8D5.
; .
; Draws an object into #R$D200. An
; object that has the sprite number #N$01
; is removed instead, by making it null.
;
; IX The address of the object
;
; Remove the object if it is
; retired.
@label=DrawObject
c$D013 LD A,(IX+$00)   ; Fetch the sprite number.
 $D016 CP $01          ; {Jump to #R$D01F if it is not
 $D018 JR NZ,$D01F     ; #N$01.}
 $D01A LD (IX+$00),$00 ; Write #N$00 to the sprite
                       ; number.
 $D01E RET             ; Return.
; Find the position and draw the
; sprite.
@label=DrawObject_Draw
*$D01F RES 4,(IX+$07)  ; Reset bit 4 of the flags.
 $D023 CALL $CFD2      ; Call #R$CFD2.
 $D026 RET NC          ; Return if the sprite is not on the screen.
; Continue on to #R$D027.
; .
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$D704 }
; { #PENTAGRAM$B3D3 }
; LIST#

; Print Sprite
;
; Used by the routines at #R$BC56, #R$BC9D and #R$CB06.
; .
; Draws the sprite of an object
; into #R$D200, at the pixel position of
; the object. A sprite has a width byte
; (the vertical flip in bit 7, the
; horizontal flip in bit 6 and the width
; in columns in the low bits), a height
; byte, and then the data for each line
; from the top. Each column of a line is a
; pair of bytes: a mask byte, then a data
; byte. The mask clears the bits of the
; background and the data sets bits. A
; sprite that does not start on a byte
; boundary has each pair shifted across
; two bytes of the buffer, with the tables
; built by #R$CFA7. The routine copies the
; sprite with unrolled code, which it
; enters part of the way along, so that it
; does as many columns as the sprite has.
; To do this it changes the code, and it
; uses the stack pointer to read the data
; of the sprite.
;
; IX The address of the object
;
; Find the sprite and choose the
; draw path.
@label=PrintSprite
c$D027 CALL $CFFE     ; Call #R$CFFE.
 $D02A LD A,(IX+$1A)  ; Fetch the pixel x position.
 $D02D AND %00000111  ; Keep bits 0 to 2.
 $D02F JR Z,$D07E     ; Jump to #R$D07E if it is zero.
; Choose the page of the shift
; table.
 $D031 RLCA           ; Double it.
 $D032 AND %00001110  ; Keep bits 1 to 3.
 $D034 OR %11110000   ; Set bits 4 to 7.
 $D036 LD H,A         ; Copy it to #REGh.
 $D037 LD A,(DE)      ; Fetch the width byte of the
                      ; sprite.
 $D038 INC DE         ; Increment #REGde.
 $D039 AND %00000111  ; Keep bits 0 to 2.
 $D03B INC A          ; Increment #REGa.
 $D03C LD B,A         ; Copy it to #REGb.
 $D03D LD (IX+$18),A  ; Set the width in bytes of the
                      ; object.
 $D040 DEC A          ; Decrement #REGa.
 $D041 AND %00000111  ; Keep bits 0 to 2.
 $D043 ADD A,A        ; {Multiply it by sixteen.
 $D044 ADD A,A        ;
 $D045 ADD A,A        ;
 $D046 ADD A,A        ; }
 $D047 NEG            ; Negate it.
 $D049 ADD A,$50      ; Add #N$50.
; Change the jump and the step.
@label=PrintSprite_Patch
*$D04B LD ($D0BC),A   ; Write it to #R$D0BB(#N$D0BC).
 $D04E LD A,B         ; Fetch #REGb.
 $D04F CPL            ; Invert it.
 $D050 ADD A,$22      ; Add #N$22.
 $D052 LD ($D110),A   ; Write it to #R$D10F(#N$D110).
; Clip the sprite to the top of the
; screen.
 $D055 LD A,(DE)      ; Fetch the height of the
                      ; sprite.
 $D056 INC DE         ; Increment #REGde.
 $D057 LD (IX+$19),A  ; Set the height in lines of the
                      ; object.
 $D05A ADD A,(IX+$1B) ; Add the pixel y position.
 $D05D SUB $C0        ; Subtract #N$C0.
 $D05F JR C,$D069     ; Jump to #R$D069 if carry is
                      ; set.
 $D061 NEG            ; Negate #REGa.
 $D063 ADD A,(IX+$19) ; Add the height in lines.
 $D066 LD (IX+$19),A  ; Set the height in lines of the
                      ; object.
; Draw the rows that are on the
; screen.
@label=PrintSprite_Draw
*$D069 LD C,(IX+$1A)  ; Fetch the pixel x position.
 $D06C LD B,(IX+$1B)  ; Fetch the pixel y position.
 $D06F CALL $D120     ; Call #R$D120.
 $D072 LD ($5B09),SP  ; Set #R$5B09.
 $D076 EX DE,HL       ; {Point the stack at the sprite
 $D077 LD SP,HL       ; data.
 $D078 EX DE,HL       ; }
 $D079 LD A,(IX+$19)  ; Fetch the number of lines.
 $D07C JR $D0B9       ; Jump to #R$D0B9.
; The sprite is aligned, so the
; bytes do not need to be shifted.
@label=PrintSprite_Aligned
*$D07E LD A,(DE)      ; Fetch the width byte of the
                      ; sprite.
 $D07F INC DE         ; Increment #REGde.
 $D080 AND %00001111  ; Keep bits 0 to 3.
 $D082 LD (IX+$18),A  ; Set the width in bytes of the
                      ; object.
 $D085 LD B,A         ; Copy it to #REGb.
 $D086 ADD A,A        ; {Multiply it by eight.
 $D087 ADD A,A        ;
 $D088 ADD A,A        ; }
 $D089 NEG            ; Negate it.
 $D08B SUB $06        ; Subtract #N$06.
 $D08D JR $D04B       ; Jump to #R$D04B.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$D718 }
; LIST#

; Draw Aligned Columns
;
; Unrolled code that draws the
; columns of a sprite that is on a byte
; boundary. Each column of a line takes a
; pair of bytes off the stack, which are
; the mask and the data, clears the bits
; of the mask in the byte of the buffer
; and sets the bits of the data. The code
; is entered at the column that gives the
; number of columns that the sprite has,
; and the last column carries on at
; #R$D10E.
;
; .
;
; Draw the five unrolled columns.
@label=DrawAlignedColumns
c$D08F POP DE        ; {Draw the first column of a
 $D090 LD A,(BC)     ; sprite that has five.
 $D091 CPL           ;
 $D092 OR E          ;
 $D093 CPL           ;
 $D094 OR D          ;
 $D095 LD (BC),A     ;
 $D096 INC BC        ; }
 $D097 POP DE        ; {Draw the second column of a
 $D098 LD A,(BC)     ; sprite that has four or five.
 $D099 CPL           ;
 $D09A OR E          ;
 $D09B CPL           ;
 $D09C OR D          ;
 $D09D LD (BC),A     ;
 $D09E INC BC        ; }
 $D09F POP DE        ; {Draw the third column of a
 $D0A0 LD A,(BC)     ; sprite that has three or more.
 $D0A1 CPL           ;
 $D0A2 OR E          ;
 $D0A3 CPL           ;
 $D0A4 OR D          ;
 $D0A5 LD (BC),A     ;
 $D0A6 INC BC        ; }
 $D0A7 POP DE        ; {Draw the fourth column of a
 $D0A8 LD A,(BC)     ; sprite that has two or more.
 $D0A9 CPL           ;
 $D0AA OR E          ;
 $D0AB CPL           ;
 $D0AC OR D          ;
 $D0AD LD (BC),A     ;
 $D0AE INC BC        ; }
 $D0AF POP DE        ; {Draw the last column.
 $D0B0 LD A,(BC)     ;
 $D0B1 CPL           ;
 $D0B2 OR E          ;
 $D0B3 CPL           ;
 $D0B4 OR D          ;
 $D0B5 LD (BC),A     ; }
 $D0B6 JP $D10E      ; Jump to #R$D10E.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$BE5B }
; { #KNIGHTLORE$D780 }
; { #NIGHTSHADE$E49F }
; { #PENTAGRAM$B44F }
; LIST#

; Draw Lines
;
; Used by the routine at #R$D027.
; .
; Draws the lines of a sprite one
; after the other. For each line the code
; jumps into the unrolled code, at a place
; that depends on the width of the sprite,
; and that is set by the jump that is
; changed by #R$D027. The code for a
; sprite that is not on a byte boundary
; takes a pair of bytes off the stack,
; which are the mask and the data, shifts
; them across the two bytes of the buffer
; that they fall into with the table of
; shifted bytes in #REGh, and keeps what
; is left of the second byte to go with
; the next pair. A sprite on a byte
; boundary jumps into #R$D08F instead.
;
; .
;
; Jump into the unrolled columns.
@label=DrawLines
c$D0B9 EX AF,AF'     ; Copy #REGa to #REGa'.
 $D0BA LD A,(BC)     ; Fetch the first byte of the
                     ; buffer.
@label=DrawLines_Jump
*$D0BB JR $D0BB      ; Jump into the unrolled
                     ; columns.
; The patched jump at #R$D0BB lands
; here when the sprite is five columns
; wide.
@label=DrawLines_FirstPair
 $D0BD POP DE        ; {Draw the first pair of a
 $D0BE LD L,E        ; sprite that has five.
 $D0BF AND (HL)      ;
 $D0C0 LD L,D        ;
 $D0C1 XOR (HL)      ;
 $D0C2 CPL           ;
 $D0C3 LD (BC),A     ;
 $D0C4 INC BC        ;
 $D0C5 INC H         ;
 $D0C6 LD L,E        ;
 $D0C7 LD A,(BC)     ;
 $D0C8 AND (HL)      ;
 $D0C9 LD L,D        ;
 $D0CA XOR (HL)      ;
 $D0CB CPL           ;
 $D0CC DEC H         ; }
 $D0CD POP DE        ; {Draw the second pair of a
 $D0CE LD L,E        ; sprite that has four or five.
 $D0CF AND (HL)      ;
 $D0D0 LD L,D        ;
 $D0D1 XOR (HL)      ;
 $D0D2 CPL           ;
 $D0D3 LD (BC),A     ;
 $D0D4 INC BC        ;
 $D0D5 INC H         ;
 $D0D6 LD L,E        ;
 $D0D7 LD A,(BC)     ;
 $D0D8 AND (HL)      ;
 $D0D9 LD L,D        ;
 $D0DA XOR (HL)      ;
 $D0DB CPL           ;
 $D0DC DEC H         ; }
 $D0DD POP DE        ; {Draw the third pair of a
 $D0DE LD L,E        ; sprite that has three or more.
 $D0DF AND (HL)      ;
 $D0E0 LD L,D        ;
 $D0E1 XOR (HL)      ;
 $D0E2 CPL           ;
 $D0E3 LD (BC),A     ;
 $D0E4 INC BC        ;
 $D0E5 INC H         ;
 $D0E6 LD L,E        ;
 $D0E7 LD A,(BC)     ;
 $D0E8 AND (HL)      ;
 $D0E9 LD L,D        ;
 $D0EA XOR (HL)      ;
 $D0EB CPL           ;
 $D0EC DEC H         ; }
 $D0ED POP DE        ; {Draw the fourth pair of a
 $D0EE LD L,E        ; sprite that has two or more.
 $D0EF AND (HL)      ;
 $D0F0 LD L,D        ;
 $D0F1 XOR (HL)      ;
 $D0F2 CPL           ;
 $D0F3 LD (BC),A     ;
 $D0F4 INC BC        ;
 $D0F5 INC H         ;
 $D0F6 LD L,E        ;
 $D0F7 LD A,(BC)     ;
 $D0F8 AND (HL)      ;
 $D0F9 LD L,D        ;
 $D0FA XOR (HL)      ;
 $D0FB CPL           ;
 $D0FC DEC H         ; }
 $D0FD POP DE        ; {Draw the last pair.
 $D0FE LD L,E        ;
 $D0FF AND (HL)      ;
 $D100 LD L,D        ;
 $D101 XOR (HL)      ;
 $D102 CPL           ;
 $D103 LD (BC),A     ;
 $D104 INC BC        ;
 $D105 INC H         ;
 $D106 LD L,E        ;
 $D107 LD A,(BC)     ;
 $D108 AND (HL)      ;
 $D109 LD L,D        ;
 $D10A XOR (HL)      ;
 $D10B CPL           ;
 $D10C DEC H         ; }
 $D10D LD (BC),A     ; Write the last byte of the
                     ; line.
; This entry point is used by the routine at #R$D08F.
; .
; Step on to the next line. The
; aligned columns jump here after their
; last column.
@label=DrawLines_Next
*$D10E LD A,C        ; Fetch #REGc.
@label=DrawLines_Step
 $D10F ADD A,$00     ; Add the step, which is
                     ; changed for the width of the sprite.
 $D111 LD C,A        ; Copy it to #REGc.
 $D112 LD A,B        ; Fetch #REGb.
 $D113 ADC A,$00     ; Add #N$00 with carry.
 $D115 LD B,A        ; Copy it to #REGb.
 $D116 EX AF,AF'     ; Fetch #REGa'.
 $D117 DEC A         ; Decrement #REGa.
 $D118 JP NZ,$D0B9   ; Jump to #R$D0B9 if it is not
                     ; zero.
 $D11B LD SP,($5B09) ; {Fetch #R$5B09 and return.
 $D11F RET           ; }
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$D7AA }
; { #PENTAGRAM$B479 }
; LIST#

; Calculate Buffer Address
;
; Used by the routines at #R$AD66, #R$BB9D, #R$BBB1, #R$BC9D, #R$BF2F, #R$CEAB
; and #R$D027.
; .
; Finds the address in #R$D200 of
; the byte that holds a pixel. The buffer
; has the lines of the screen from the
; bottom, #N$20 bytes to a line.
;
;   B The pixel y position
;   C The pixel x position
; O:BC The address in the buffer
;
; Work out the byte from the
; position.
@label=CalculateBufferAddress
c$D120 PUSH HL       ; Stash #REGhl on the stack.
 $D121 SRL B         ; {Divide #REGbc by two.
 $D123 RR C          ; }
 $D125 SRL B         ; {Divide #REGbc by four.
 $D127 RR C          ; }
 $D129 SRL B         ; {Divide #REGbc by eight.
 $D12B RR C          ; }
 $D12D LD HL,$D200   ; Point #REGhl at #R$D200.
 $D130 ADD HL,BC     ; Add #REGbc to #REGhl.
 $D131 LD C,L        ; {Copy #REGhl to #REGbc.
 $D132 LD B,H        ; }
 $D133 POP HL        ; {Restore #REGhl from the stack
 $D134 RET           ; and return.}
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$D811 }
; { #PENTAGRAM$B37F }
; LIST#

; Calculate Screen Address
;
; Used by the routines at #R$AD66, #R$BC9D, #R$BF2F and #R$CEAB.
; .
; Finds the address on the screen of
; the byte that holds a pixel. The pixel y
; position is from the bottom of the
; screen.
;
;   B The pixel y position
;   C The pixel x position
; O:DE The address on the screen
;
; Work out the byte from the
; position.
@label=CalculateScreenAddress
c$D135 LD A,C        ; {Divide #REGc by eight.
 $D136 RRCA          ;
 $D137 RRCA          ;
 $D138 RRCA          ; }
 $D139 AND %00011111 ; Keep bits 0 to 4.
 $D13B LD E,A        ; Copy it to #REGe.
 $D13C LD A,B        ; {Fetch #REGb and invert it.
 $D13D CPL           ; }
 $D13E AND %00000111 ; Keep bits 0 to 2.
 $D140 EX AF,AF'     ; Copy it to #REGa'.
 $D141 LD A,B        ; {Fetch #REGb and invert it.
 $D142 CPL           ; }
 $D143 RLCA          ; {Move the character row into
 $D144 RLCA          ; bits 5 to 7.}
 $D145 AND %11100000 ; Keep bits 5 to 7.
 $D147 OR E          ; Merge #REGe.
 $D148 LD E,A        ; Copy it to #REGe.
 $D149 LD A,B        ; {Fetch #REGb and invert it.
 $D14A CPL           ; }
 $D14B RRCA          ; {Move the third into bits 3 and
 $D14C RRCA          ; 4.
 $D14D RRCA          ; }
 $D14E AND %00011000 ; Keep bits 3 and 4.
 $D150 LD D,A        ; Copy it to #REGd.
 $D151 EX AF,AF'     ; Fetch #REGa'.
 $D152 OR D          ; Merge #REGd.
 $D153 ADD A,$38     ; Add #N$38.
 $D155 LD D,A        ; Copy it to #REGd.
 $D156 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$D24F }
; { #KNIGHTLORE$D826 }
; { #NIGHTSHADE$E556 }
; { #PENTAGRAM$B394 }
; LIST#

; Calculate Attribute Address
;
; Used by the routines at #R$AC21, #R$BBB1 and #R$BC9D.
; .
; Finds the address in the
; attribute file of the character square
; that holds a pixel. The pixel y position
; is from the bottom of the screen.
;
;   H The pixel y position
;   L The pixel x position
; O:DE The address of the attribute
;
; Work out the square from the
; position.
@label=CalculateAttributeAddress
c$D157 PUSH HL       ; Stash #REGhl on the stack.
 $D158 LD A,H        ; {Fetch #REGh, invert it and
 $D159 CPL           ; copy it to #REGh.
 $D15A LD H,A        ; }
 $D15B SRL H         ; {Shift #REGh right four times.
 $D15D SRL H         ;
 $D15F SRL H         ;
 $D161 SRL H         ; }
 $D163 RR L          ; Rotate #REGl right.
 $D165 SRL H         ; {Shift the next bit into
 $D167 RR L          ; #REGl.}
 $D169 SRL H         ; {Shift the next bit into
 $D16B RR L          ; #REGl.}
 $D16D LD DE,$5700   ; Point #REGde at #N$5700.
 $D170 ADD HL,DE     ; Add #REGde to #REGhl.
 $D171 EX DE,HL      ; Exchange #REGde and #REGhl.
 $D172 POP HL        ; Restore #REGhl from the stack.
 $D173 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$D848 }
; { #PENTAGRAM$B3B6 }
; LIST#

; Flip Sprite
;
; Used by the routine at #R$CFFE.
; .
; Flips the data of a sprite in
; place, if its flags are not the same as
; the flags of the object that is going to
; be drawn. The width byte of a sprite has
; the vertical flip in bit 7 and the
; horizontal flip in bit 6. The sprite is
; flipped vertically by swapping its
; lines, and horizontally by reversing the
; bits of each byte and the order of the
; bytes of each line, with #R$F100.
;
;   DE The address of the sprite
;   IX The address of the object
; O:DE The address of the sprite
;
; Flip the sprite from top to
; bottom if needed.
@label=FlipSprite
c$D174 PUSH DE       ; Stash #REGde on the stack.
 $D175 LD A,(DE)     ; Fetch the width byte of the
                     ; sprite.
 $D176 XOR (IX+$07)  ; Merge the flags of the object.
 $D179 AND %10000000 ; Keep bit 7.
 $D17B JR Z,$D1AF    ; Jump to #R$D1AF if it is zero.
 $D17D LD A,(DE)     ; Fetch the width byte again.
 $D17E XOR %10000000 ; Toggle bit 7.
 $D180 LD (DE),A     ; Write the width byte.
 $D181 RLCA          ; Double it.
 $D182 AND %01111110 ; Keep bits 1 to 6.
 $D184 LD B,A        ; Copy it to #REGb.
 $D185 INC DE        ; Increment #REGde.
 $D186 LD A,(DE)     ; Fetch the height.
 $D187 LD C,A        ; Copy it to #REGc.
 $D188 INC DE        ; Increment #REGde.
 $D189 PUSH DE       ; Stash #REGde on the stack.
 $D18A LD E,B        ; {Set #REGde to the line length.
 $D18B LD D,$00      ; }
 $D18D CALL $CE0D    ; Call #R$CE0D.
 $D190 POP DE        ; Restore #REGde from the stack.
 $D191 ADD HL,DE     ; Add #REGde to #REGhl.
 $D192 EX DE,HL      ; Exchange #REGde and #REGhl.
 $D193 LD A,B        ; Fetch #REGb.
 $D194 CALL $CE06    ; Call #R$CE06.
 $D197 DEC DE        ; Decrement #REGde.
 $D198 DEC HL        ; Decrement #REGhl.
 $D199 SRL C         ; Halve #REGc.
@label=FlipSprite_Lines
*$D19B PUSH BC       ; Stash #REGbc on the stack.
@label=FlipSprite_Bytes
*$D19C LD A,(DE)     ; Fetch a byte of the last line.
 $D19D LD C,(HL)     ; Fetch a byte of the first
                     ; line.
 $D19E LD (HL),A     ; Write the last-line byte.
 $D19F LD A,C        ; Fetch the first-line byte.
 $D1A0 LD (DE),A     ; Write it to the last line.
 $D1A1 DEC HL        ; Decrement #REGhl.
 $D1A2 DEC DE        ; Decrement #REGde.
 $D1A3 DJNZ $D19C    ; Jump to #R$D19C until #REGb is
                     ; zero.
 $D1A5 POP BC        ; Restore #REGbc from the stack.
 $D1A6 LD A,B        ; Fetch #REGb.
 $D1A7 SLA A         ; Double it.
 $D1A9 CALL $CE06    ; Call #R$CE06.
 $D1AC DEC C         ; Decrement #REGc.
 $D1AD JR NZ,$D19B   ; Jump to #R$D19B if it is not
                     ; zero.
; Flip the sprite from left to
; right if needed.
@label=FlipSprite_Horizontal
*$D1AF POP DE        ; {Restore #REGde from the stack
 $D1B0 PUSH DE       ; and stash it again.}
 $D1B1 LD A,(DE)     ; Fetch the width byte of the
                     ; sprite.
 $D1B2 XOR (IX+$07)  ; Merge the flags of the object.
 $D1B5 AND %01000000 ; Keep bit 6.
 $D1B7 JR Z,$D1E9    ; Jump to #R$D1E9 if it is zero.
 $D1B9 LD A,(DE)     ; Fetch the width byte again.
 $D1BA XOR %01000000 ; Toggle bit 6.
 $D1BC LD (DE),A     ; Write the width byte.
 $D1BD AND %00001111 ; Keep bits 0 to 3.
 $D1BF LD B,A        ; Copy it to #REGb.
 $D1C0 LD C,A        ; Copy it to #REGc.
 $D1C1 INC DE        ; Increment #REGde.
 $D1C2 LD A,(DE)     ; Fetch the height.
 $D1C3 EX AF,AF'     ; Copy it to #REGa'.
 $D1C4 INC DE        ; Increment #REGde.
 $D1C5 EX DE,HL      ; Exchange #REGde and #REGhl.
 $D1C6 PUSH HL       ; Stash #REGhl on the stack.
 $D1C7 EXX           ; Switch to the shadow
                     ; registers.
 $D1C8 POP HL        ; Restore #REGhl' from the
                     ; stack.
 $D1C9 LD B,$F1      ; Set #REGb' to #N$F1.
 $D1CB EXX           ; Switch back to the main
                     ; registers.
@label=FlipSprite_Line
*$D1CC EXX           ; Switch to the shadow
                     ; registers.
 $D1CD LD C,(HL)     ; Fetch the mask byte.
 $D1CE LD A,(BC)     ; Fetch the reversed byte.
 $D1CF LD E,A        ; Copy it to #REGe.
 $D1D0 INC HL        ; Increment #REGhl.
 $D1D1 LD C,(HL)     ; Fetch the data byte.
 $D1D2 LD A,(BC)     ; Fetch the reversed byte.
 $D1D3 LD D,A        ; Copy it to #REGd.
 $D1D4 INC HL        ; Increment #REGhl.
 $D1D5 PUSH DE       ; Stash #REGde on the stack.
 $D1D6 EXX           ; Switch back to the main
                     ; registers.
 $D1D7 DJNZ $D1CC    ; Jump to #R$D1CC until #REGb is
                     ; zero.
 $D1D9 LD B,C        ; Copy #REGc to #REGb.
@label=FlipSprite_Column
*$D1DA POP DE        ; Restore #REGde from the stack.
 $D1DB LD (HL),E     ; Write #REGe.
 $D1DC INC HL        ; Increment #REGhl.
 $D1DD LD (HL),D     ; Write #REGd.
 $D1DE INC HL        ; Increment #REGhl.
 $D1DF DJNZ $D1DA    ; Jump to #R$D1DA until #REGb is
                     ; zero.
 $D1E1 EX AF,AF'     ; Fetch #REGa'.
 $D1E2 DEC A         ; Decrement #REGa.
 $D1E3 JR Z,$D1E9    ; Jump to #R$D1E9 if it is zero.
 $D1E5 EX AF,AF'     ; Copy it to #REGa'.
 $D1E6 LD B,C        ; Copy #REGc to #REGb.
 $D1E7 JR $D1CC      ; Jump to #R$D1CC.
@label=FlipSprite_Finish
*$D1E9 POP DE        ; Restore #REGde from the stack.
 $D1EA RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$D865 }
; { #NIGHTSHADE$E353 }
; LIST#

; Messaging: Copyright
;
; The copyright message, which is
; not used by the game.
@label=CopyrightMessage
t$D1EB DEFM "COPYRIGHT 1984 A.C.G." ; "COPYRIGHT 1984 A.C.G."

; Screen Buffer
;
; The buffer in which the screen is
; built (see #R$CE85), one byte for each
; eight pixels. The buffer is built from
; the bottom of the screen up.
