; Object Types
;
; The addresses of the templates
; for the types of object that can appear
; in the data for a room (see #R$6469),
; indexed by the type. Objects of type
; #N$1F switch to the second table at
; #R$7408 for the objects which follow in
; the room.
@label=ObjectTypes
w$73C8 DEFW $0000    ; Type #N$00: unused.
 $73CA DEFW $7418    ; Type #N$01: a block (#R$7418).
 $73CC DEFW $741E    ; Type #N$02: a block which is fat at the bottom
                     ; (#R$741E).
 $73CE DEFW $7424    ; Type #N$03: a block which is fat at the top (#R$7424).
 $73D0 DEFW $742A    ; Type #N$04: a block which moves up and down (#R$742A).
 $73D2 DEFW $7430    ; Type #N$05: a block which falls when touched (#R$7430).
 $73D4 DEFW $7436    ; Type #N$06: a block which collapses (#R$7436).
 $73D6 DEFW $743C    ; Type #N$07: a broken egg (#R$743C).
 $73D8 DEFW $7442    ; Type #N$08: a conveyor which carries objects north
                     ; (#R$7442).
 $73DA DEFW $7448    ; Type #N$09: a conveyor which carries objects east
                     ; (#R$7448).
 $73DC DEFW $744E    ; Type #N$0A: a conveyor which carries objects south
                     ; (#R$744E).
 $73DE DEFW $7454    ; Type #N$0B: a conveyor which carries objects west
                     ; (#R$7454).
 $73E0 DEFW $745A    ; Type #N$0C: a block which moves up and down while the player is on
                     ; it (#R$745A).
 $73E2 DEFW $7460    ; Type #N$0D: a block which moves east and west (#R$7460).
 $73E4 DEFW $7466    ; Type #N$0E: a block which moves north and south
                     ; (#R$7466).
 $73E6 DEFW $746C    ; Type #N$0F: a deadly pyramid (#R$746C).
 $73E8 DEFW $7472    ; Type #N$10: a sparkle (#R$7472).
 $73EA DEFW $748E    ; Type #N$11: a robot mouse which runs in a circuit
                     ; (#R$748E).
 $73EC DEFW $7478    ; Type #N$12: a robot mouse which runs east and west
                     ; (#R$7478).
 $73EE DEFW $7483    ; Type #N$13: a robot mouse which runs north and south
                     ; (#R$7483).
 $73F0 DEFW $7499    ; Type #N$14: the top of a broken egg (#R$7499).
 $73F2 DEFW $749F    ; Type #N$15: a cryonaut looking east (#R$749F).
 $73F4 DEFW $74A5    ; Type #N$16: a cryonaut looking south (#R$74A5).
 $73F6 DEFW $74AB    ; Type #N$17: deadly tubes (#R$74AB).
 $73F8 DEFW $74B1    ; Type #N$18: a socket for a cylinder (#R$74B1).
 $73FA DEFW $74BC    ; Type #N$19: a socket for a cube (#R$74BC).
 $73FC DEFW $74C7    ; Type #N$1A: a socket for a pyramid (#R$74C7).
 $73FE DEFW $74D2    ; Type #N$1B: a socket for a half sphere (#R$74D2).
 $7400 DEFW $74DD    ; Type #N$1C: a clockwork mouse (#R$74DD).
 $7402 DEFW $74E3    ; Type #N$1D: a chasing dome (#R$74E3).
 $7404 DEFW $74E9    ; Type #N$1E: the remote control robot (#R$74E9).
 $7406 DEFW $0000    ; Type #N$1F: the switch to the second table.

; Second Object Types
;
; The second table of types of
; object, which is used after an object of
; type #N$1F in the data for a room. It
; has room for #N$20 entries but only the
; first eight are used, since the
; templates start at #R$7418.
@label=SecondObjectTypes
w$7408 DEFW $0000    ; Type #N$00: unused.
 $740A DEFW $74EF    ; Type #N$01: a remote control arrow pointing west
                     ; (#R$74EF).
 $740C DEFW $74F5    ; Type #N$02: a remote control arrow pointing north
                     ; (#R$74F5).
 $740E DEFW $74FB    ; Type #N$03: a remote control arrow pointing east
                     ; (#R$74FB).
 $7410 DEFW $7501    ; Type #N$04: a remote control arrow pointing south
                     ; (#R$7501).
 $7412 DEFW $7507    ; Type #N$05: the remote control block (#R$7507).
 $7414 DEFW $750D    ; Type #N$06: the spiked dome (#R$750D).
 $7416 DEFW $7513    ; Type #N$07: the land mine (#R$7513).

; Object Templates
;
; The templates for the objects.
; Each is a list of one or more objects,
; each of five bytes: the sprite number,
; the width, the depth, the height and the
; flags which are copied into the object
; (see #R$5B88). A list ends with #N($00),
; and when there is more than one object
; in a list the later ones are attached to
; the first (a mouse for example has a
; second part which follows it around).
; Bit 6 of the flags flips the sprite
; left to right.
@label=ObjectTemplates
b$7418 DEFB $1E,$08,$08,$0C,$10,$00 ; Template for a block.
                                    ; #UDGTABLE { #SPRITE$1E,attr=$47(block-01-colour*) } UDGTABLE#
@label=ObjectTemplate_FatBottomBlock
 $741E DEFB $1C,$07,$07,$0C,$14,$00 ; Template for a block which is fat at the bottom.
                                    ; #UDGTABLE { #SPRITE$1C,attr=$47(block-fat-bottom-01-colour*) }
                                    ; UDGTABLE#
@label=ObjectTemplate_FatTopBlock
 $7424 DEFB $1D,$07,$07,$0C,$14,$00 ; Template for a block which is fat at the top.
                                    ; #UDGTABLE { #SPRITE$1D,attr=$47(block-fat-top-01-colour*) } UDGTABLE#
@label=ObjectTemplate_BlockMovingUpDown
 $742A DEFB $1F,$08,$08,$0C,$14,$00 ; Template for a block which moves up and down.
                                    ; #UDGTABLE { #SPRITE$1F,attr=$47(block-01-colour*) } UDGTABLE#
@label=ObjectTemplate_FallingBlock
 $7430 DEFB $2C,$08,$08,$0C,$10,$00 ; Template for a block which falls when touched.
                                    ; #UDGTABLE { #SPRITE$2C,attr=$47(block-01-colour*) } UDGTABLE#
@label=ObjectTemplate_CollapsingBlock
 $7436 DEFB $2D,$08,$08,$0C,$10,$00 ; Template for a block which collapses.
                                    ; #UDGTABLE { #SPRITE$2D,attr=$47(block-01-colour*) } UDGTABLE#
@label=ObjectTemplate_BrokenEgg
 $743C DEFB $2E,$08,$08,$0C,$10,$00 ; Template for a broken egg.
                                    ; #UDGTABLE { #SPRITE$2E,attr=$47(egg-bottom-01-colour*) } UDGTABLE#
@label=ObjectTemplate_ConveyorNorth
 $7442 DEFB $44,$08,$08,$0C,$10,$00 ; Template for a conveyor which carries objects north.
                                    ; #UDGTABLE { #SPRITE$44,attr=$47(block-01-colour*) } UDGTABLE#
@label=ObjectTemplate_ConveyorEast
 $7448 DEFB $45,$08,$08,$0C,$10,$00 ; Template for a conveyor which carries objects east.
