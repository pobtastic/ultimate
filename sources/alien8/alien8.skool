 $B8D4 DEFB $43      ; #COLOUR(#PEEK(#PC)).
 $B8D5 DEFB $42      ; #COLOUR(#PEEK(#PC)).
 $B8D6 DEFB $42      ; #COLOUR(#PEEK(#PC)).

