; Start Game
;
; Used by the routine at #R$6300.
; .
; Clears every game variable from #R$5B00
; up to #R$6288, keeps the low byte of
; #SKOOLKID$5C78(FRAMES) as #R$5B00, checks that
; the loader started the game, and then carries
; on into #R$A650.
;
; .
;
; Clear the variables and keep the seed.
@label=StartGame
c$A631 LD HL,$5B00   ; Point #REGhl at #R$5B00.
 $A634 LD BC,$0788   ; Set the number of bytes to #N$0788.
 $A637 LD A,($5C78)  ; Fetch the low byte of #SKOOLKID$5C78(FRAMES).
 $A63A PUSH AF       ; Stash the seed on the stack.
 $A63B CALL $CE56    ; Call #R$CE56.
 $A63E POP AF        ; Restore the seed from the stack.
 $A63F LD ($5B00),A  ; Set #R$5B00.
 $A642 CALL $A8F1    ; Call #R$A8F1.
 $A645 JR $A650      ; Jump to #R$A650.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$AF6C }
; LIST#

; Restart Game
;
; Used by the routines at #R$A971 and #R$AB61.
; .
; Clears the game variables from #R$5B08
; onwards, so #R$5B00, #R$5B02, #R$5B04 and
; #R$5B05 are kept.
;
; .
;
; Clear the variables of the last game.
@label=RestartGame
c$A647 LD HL,$5B08   ; Point #REGhl at #R$5B08.
 $A64A LD BC,$0780   ; Set the number of bytes to #N$0780.
 $A64D CALL $CE56    ; Call #R$CE56.
; Continue on to #R$A650.

; Initialise Game
;
; Used by the routine at #R$A631.
; .
; Prepares a new game: builds the lookup
; tables, gives the player five lives, shows
; the menu, plays the start tune, and places
; the player and the special objects.
;
; .
;
; Build the tables and set the starting state.
@label=InitialiseGame
c$A650 CALL $CFA7    ; Call #R$CFA7.
 $A653 XOR A         ; {Write #N$00 to #R$5B12.
 $A654 LD ($5B12),A  ; }
 $A657 LD ($CA29),A  ; Write #N$00 to #R$CA1D(#N$CA29).
 $A65A LD A,$05      ; {Set #R$5B1A to #N$05.
 $A65C LD ($5B1A),A  ; }
 $A65F LD HL,$0060   ; {Set #R$5B36 to #N($0060,$04,$04).
 $A662 LD ($5B36),HL ; }
 $A665 LD HL,$0000   ; {Write #N($0000,$04,$04) to #R$5B38.
 $A668 LD ($5B38),HL ; }
; Stir #R$5B00 with #R$5B02.
 $A66B LD HL,$5B00   ; Point #REGhl at #R$5B00.
 $A66E LD A,($5B02)  ; Fetch the low byte of #R$5B02.
 $A671 ADD A,(HL)    ; {Add it to #R$5B00.
 $A672 LD (HL),A     ; }
; Show the menu and wait for the player to start.
 $A673 CALL $CE73    ; Call #R$CE73.
 $A676 CALL $BA7E    ; Call #R$BA7E.
; #HTML(#AUDIO0(start-up-tune.wav)(#INCLUDE(StartUpTune)))
 $A679 LD DE,$B3C5   ; Point #REGde at #R$B3C5.
 $A67C CALL $B4BA    ; Call #R$B4BA.
; Place the player and set up the rooms.
 $A67F CALL $CA6D    ; Call #R$CA6D.
 $A682 CALL $AF3F    ; Call #R$AF3F.
 $A685 CALL $CAD2    ; Call #R$CAD2.
; Continue on to #R$A688.

; Start Life
;
; Used by the routine at #R$A68B.
; .
; Starts a new life: puts the player
; objects back at the start location and takes
; a life off. If the player has none left the
; game is over.
;
; .
;
; Restore the player and take a life.
@label=StartLife
c$A688 CALL $CA07    ; Call #R$CA07.
; Continue on to #R$A68B.
; .
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$AFB7 }
; LIST#

; Run Game
;
; Used by the routine at #R$C397.
; .
; The main game loop. The first call
; builds the objects of the room. Every pass
; through #R$A68E is one frame: each object is
; updated, the visible objects are sorted and
; drawn, the screen is refreshed and the panel
; is updated.
; .
; #PUSHS #UDGTABLE { =h After the first pass }
; { #SIM(start=$A631,stop=$A676,sp=$F100,r=$80,clear=1)
; #SIM(start=$BA7E,stop=$BA95)
; #SIM(start=$A67F,stop=$A6FE)
; #SIM(start=$A715,stop=$A72E)
; #SIM(start=$CE85,stop=$0000,sp=$EC00)
; #SCR$02(run-game) } UDGTABLE# #POPS
;
; .
;
; Build the objects of the room.
@label=RunGame
c$A68B CALL $CAA2    ; Call #R$CAA2.
; This entry point is used by the routine at #R$B761.
; .
; Give every object a chance to update itself.
@label=RunGame_Frame
*$A68E LD IX,$5B88   ; Point #REGix at #R$5B88.
@label=RunGame_NextObject
*$A692 LD SP,$F100   ; Set the stack pointer to #N$F100.
 $A695 LD HL,$A6C0   ; Point #REGhl at #R$A6C0.
 $A698 PUSH HL       ; Stash the return address on the stack.
 $A699 LD A,(IX+$18) ; Fetch the width of the sprite.
 $A69C LD (IX+$1C),A ; Store it as the previous width.
 $A69F LD A,(IX+$19) ; Fetch the height of the sprite.
 $A6A2 LD (IX+$1D),A ; Store it as the previous height.
 $A6A5 LD A,(IX+$1A) ; Fetch the pixel x position of the sprite.
 $A6A8 LD (IX+$1E),A ; Store it as the previous x position.
 $A6AB LD A,(IX+$1B) ; Fetch the pixel y position of the sprite.
 $A6AE LD (IX+$1F),A ; Store it as the previous y position.
; This entry point is used by the routine at #R$BC83.
; .
; Jump to the update routine for the sprite.
@label=RunGame_UpdateObject
*$A6B1 LD L,(IX+$00) ; Fetch the sprite number into #REGl.
 $A6B4 LD BC,$A7EA   ; Point #REGbc at #R$A7EA.
; This entry point is used by the routines at #R$C2F6 and #R$C785.
@label=RunGame_JumpToHandler
*$A6B7 LD H,$00      ; Clear the high byte of #REGhl.
 $A6B9 ADD HL,HL     ; Double the sprite number.
 $A6BA ADD HL,BC     ; Add the address of the table.
 $A6BB LD A,(HL)     ; Fetch the low byte of the routine.
 $A6BC INC HL        ; Move on to the high byte.
 $A6BD LD H,(HL)     ; Fetch the high byte of the routine.
 $A6BE LD L,A        ; Put the low byte in #REGl.
 $A6BF JP (HL)       ; Jump to the update routine.
; Stir #R$5B05 from the refresh register.
@label=RunGame_ObjectUpdated
 $A6C0 LD A,R        ; Fetch the refresh register.
 $A6C2 LD C,A        ; Copy it to #REGc.
 $A6C3 LD A,($5B05)  ; Fetch #R$5B05.
 $A6C6 ADD A,C       ; Add the refresh register to it.
 $A6C7 LD ($5B05),A  ; Set #R$5B05.
; Move on to the next object.
 $A6CA LD BC,$0020   ; {Move #REGix on by #N($0020,$04,$04) bytes.
 $A6CD ADD IX,BC     ; }
 $A6CF PUSH IX       ; {Copy #REGix to #REGhl (using the stack).
 $A6D1 POP HL        ; }
 $A6D2 LD BC,$6288   ; Point #REGbc at #R$6288.
 $A6D5 AND A         ; {Subtract #R$6288 from #REGhl.
 $A6D6 SBC HL,BC     ; }
 $A6D8 JR NC,$A6DC   ; Jump to #R$A6DC if there are no more objects.
 $A6DA JR $A692      ; Jump to #R$A692.
; Stir #R$5B05 from the ROM byte at #R$5B02.
@label=RunGame_FinishFrame
*$A6DC LD HL,($5B02) ; Fetch #R$5B02.
 $A6DF INC HL        ; Move on to the next address.
 $A6E0 LD ($5B02),HL ; Set #R$5B02.
 $A6E3 LD A,($5B05)  ; Fetch #R$5B05.
 $A6E6 ADD A,(HL)    ; Add the byte of ROM.
 $A6E7 ADD A,L       ; Add the low byte of the address.
 $A6E8 ADD A,H       ; Add the high byte of the address.
 $A6E9 LD ($5B05),A  ; Set #R$5B05.
 $A6EC LD HL,$5B12   ; Point #REGhl at #R$5B12.
 $A6EF SET 0,(HL)    ; Set bit 0 of #R$5B12.
; Draw the room into the screen buffer.
 $A6F1 CALL $C71C    ; Call #R$C71C.
 $A6F4 CALL $CEAB    ; Call #R$CEAB.
 $A6F7 LD A,($5B24)  ; Fetch #R$5B24.
 $A6FA AND A         ; {Jump to #R$A741 if it is set.
 $A6FB JP NZ,$A741   ; }
; Slow the game down when few objects are drawn.
 $A6FE LD A,($5B1E)  ; Fetch #R$5B1E.
 $A701 NEG           ; Negate it.
 $A703 ADD A,$06     ; Add #N$06.
 $A705 LD B,A        ; Keep the number of delay loops in #REGb.
 $A706 JP M,$A715    ; Jump to #R$A715 if there were more than #N$06 objects.
 $A709 JR Z,$A715    ; Jump to #R$A715 if there were exactly #N$06 objects.
@label=RunGame_Delay
*$A70B LD HL,$0300   ; Set the delay counter to #N$0300.
@label=RunGame_DelayLoop
*$A70E DEC HL        ; Decrease the delay counter.
 $A70F LD A,L        ; {Jump to #R$A70E until the delay counter is zero.
 $A710 OR H          ;
 $A711 JR NZ,$A70E   ; }
 $A713 DJNZ $A70B    ; Jump to #R$A70B until all of the delay loops are done.
; Update the status panel.
@label=RunGame_UpdateDisplay
*$A715 CALL $AD66    ; Call #R$AD66.
 $A718 LD A,($5B17)  ; Fetch #R$5B17.
 $A71B AND A         ; {Jump to #R$A72E if it is not set.
 $A71C JR Z,$A72E    ; }
 $A71E CALL $CB0F    ; Call #R$CB0F.
 $A721 CALL $A749    ; Call #R$A749.
@label=RunGame_RefreshScreen
*$A724 XOR A         ; {Write #N$00 to #R$5B17.
 $A725 LD ($5B17),A  ; }
 $A728 CALL $CE85    ; Call #R$CE85.
 $A72B CALL $A7DC    ; Call #R$A7DC.
; Check whether the game is paused and whether the player is alive.
@label=RunGame_Continue
*$A72E CALL $CE22    ; Call #R$CE22.
 $A731 LD IX,$5B88   ; Point #REGix at #R$5B88.
 $A735 LD A,(IX+$00) ; Fetch the sprite number of the player.
 $A738 OR (IX+$20)   ; Combine it with the sprite number of #R$5BA8.
 $A73B JP Z,$A688    ; Jump to #R$A688 if both are zero.
 $A73E JP $A68E      ; Jump to #R$A68E.
; Only refresh the screen if the panel needs to be redrawn.
@label=RunGame_GameOver
*$A741 LD A,($5B17)  ; Fetch #R$5B17.
 $A744 AND A         ; {Jump to #R$A72E if it is not set.
 $A745 JR Z,$A72E    ; }
 $A747 JR $A724      ; Jump to #R$A724.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$AFBA }
; LIST#

; Update Panel
;
; Used by the routines at #R$A68B and #R$AF79.
; .
; Colours the screen and the status
; panel after #R$CB0F has drawn it, then prints
; the carried objects, the "LIGHT YEARS"
; caption, the chambers activated and the
; lives. The colour of the room is made bright
; and used for the whole attribute file.
;
; .
;
; Fill the attribute file with the colour of the room.
@label=UpdatePanel
c$A749 LD A,($5B0D)  ; Fetch #R$5B0D.
 $A74C OR %01000000  ; Make it bright.
 $A74E CALL $CE6A    ; Call #R$CE6A.
; Colour the lives icon and the lives count.
 $A751 LD A,$47      ; Set the attribute to #COLOUR$47.
 $A753 LD DE,$5ACE   ; Point #REGde at #N$5ACE (in the attribute buffer).
 $A756 LD B,$02      ; Set the number of cells to #N$02.
 $A758 CALL $CE1D    ; Call #R$CE1D.
 $A75B LD DE,$5AEE   ; Point #REGde at #N$5AEE (in the attribute buffer).
 $A75E LD B,$04      ; Set the number of cells to #N$04.
 $A760 CALL $CE1D    ; Call #R$CE1D.
; Colour the light years box and draw the objects carried.
 $A763 CALL $A7AE    ; Call #R$A7AE.
 $A766 CALL $BCAB    ; Call #R$BCAB.
; Print the "LIGHT YEARS" caption.
 $A769 LD A,($5B0D)  ; Fetch #R$5B0D.
 $A76C CPL           ; Invert it.
 $A76D AND %00000111 ; Keep only the ink colour.
 $A76F ADD A,$42     ; Add #N$42.
 $A771 LD ($A797),A  ; Set #R$A797.
 $A774 LD DE,$A797   ; Point #REGde at #R$A797.
 $A777 LD HL,$07A0   ; Point #REGhl at the position of the caption.
 $A77A CALL $BBB1    ; Call #R$BBB1.
; Print the number of chambers activated.
 $A77D CALL $A7A3    ; Call #R$A7A3.
 $A780 LD HL,$5A84   ; Point #REGhl at #N$5A84 (in the attribute buffer).
 $A783 LD (HL),$47   ; Colour the first digit bright white.
 $A785 INC HL        ; Move on to the second digit.
 $A786 LD (HL),$47   ; Colour the second digit bright white.
; Colour the icon of the chamber.
 $A788 LD HL,$5A41   ; Point #REGhl at #N$5A41 (in the attribute buffer).
 $A78B LD BC,$0303   ; Set the width and the height to #N$03.
 $A78E LD A,($A797)  ; Fetch #R$A797.
 $A791 CALL $BF83    ; Call #R$BF83.
 $A794 JP $BA57      ; Jump to #R$BA57.

; Messaging: Light Years Caption
;
; The attribute and the text of the
; "LIGHT YEARS" caption. #R$A749 sets the
; attribute each time the panel is coloured.
; The last character has bit 7 set.
@label=LightYearsCaption
t$A797 DEFB $45                  ; #COLOUR(#PEEK(#PC)).
 $A798 DEFM "LIGHT YEAR","S"+$80 ; "LIGHT YEARS"

; Print Activated Chambers
;
; Used by the routines at #R$A749 and #R$AF79.
; .
; Prints #R$5B40 as two digits next to
; the chamber icon.
;
; .
;
; Print the number in the screen buffer.
@label=PrintActivatedChambers
c$A7A3 LD DE,$5B40   ; Point #REGde at #R$5B40.
 $A7A6 LD HL,$D5E4   ; Point #REGhl at #R$D5E4.
 $A7A9 LD B,$01      ; Set the number of bytes to #N$01.
 $A7AB JP $BA62      ; Jump to #R$BA62.

; Colour Counter Box
;
; Used by the routine at #R$A749.
; .
; Copies #R$A7CA to the attribute file.
; The box is six cells wide and three cells
; high.
;
; .
;
; Copy the attributes of the box.
@label=ColourCounterBox
c$A7AE LD HL,$5A99   ; Point #REGhl at #N$5A99 (in the attribute buffer).
 $A7B1 LD DE,$A7CA   ; Point #REGde at #R$A7CA.
 $A7B4 LD BC,$0603   ; Set the width to #N$06 and the height to #N$03.
@label=ColourCounterBox_Row
*$A7B7 PUSH BC       ; {Stash the size and the address of the row.
 $A7B8 PUSH HL       ; }
@label=ColourCounterBox_Cell
*$A7B9 LD A,(DE)     ; Fetch the attribute of the cell.
 $A7BA INC DE        ; Move on to the next attribute.
 $A7BB LD (HL),A     ; Write it to the attribute file.
 $A7BC INC HL        ; Move on to the next cell.
 $A7BD DJNZ $A7B9    ; Jump to #R$A7B9 until the row is done.
 $A7BF POP HL        ; Restore the address of the row from the stack.
 $A7C0 LD A,$20      ; Set #REGa to #N$20.
 $A7C2 CALL $CE06    ; Call #R$CE06.
 $A7C5 POP BC        ; Restore the size of the box from the stack.
 $A7C6 DEC C         ; {Jump to #R$A7B7 until all of the rows are done.
 $A7C7 JR NZ,$A7B7   ; }
 $A7C9 RET           ; Return.

; Counter Box Attributes
;
; The attributes for the box around the
; light years remaining counter, six cells
; wide and three high. The box is red with a
; white centre.
@label=CounterBoxAttributes
b$A7CA DEFB $42,$42,$42,$42,$42,$42
 $A7D0 DEFB $42,$47,$47,$47,$47,$42
 $A7D6 DEFB $42,$42,$42,$42,$42,$42

; Reset Wipe Flags
;
; Used by the routine at #R$A68B.
; .
; Clears bit 5 of the flags of every
; object, once the screen has been refreshed.
;
; .
;
; Clear the wipe flag of every object.
@label=ResetWipeFlags
c$A7DC LD B,$38      ; Set the number of objects to #N$38.
 $A7DE LD DE,$0020   ; Set #REGde to #N($0020,$04,$04).
 $A7E1 LD HL,$5B8F   ; Point #REGhl at #R$5B8F.
@label=ResetWipeFlags_Loop
*$A7E4 RES 5,(HL)    ; Reset bit 5 of the flags.
 $A7E6 ADD HL,DE     ; Move on to the next object.
 $A7E7 DJNZ $A7E4    ; Jump to #R$A7E4 until all of the objects are done.
 $A7E9 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$B088 }
; { #PENTAGRAM$BF0D }
; LIST#

; Object Update Routines
;
; The table of update routines, one
; entry for each sprite number from #N$00 to
; #N$82. #R$A68B calls the routine for each
; object, with #REGix pointing at it, and
; pushes #R$A6C0 as the return address.
@label=ObjectUpdateRoutines
w$A7EA DEFW $A8F0    ; {Objects #N$00 and #N$01: nothing to do (#R$A8F0). Slots which
 $A7EC DEFW $A8F0    ; are empty have sprite #N$00 and objects that have been retired have sprite
                     ; #N$01.}
 $A7EE DEFW $BFEA    ; Object #N($02), the near side of an arch (#R$BFEA).
 $A7F0 DEFW $BFD8    ; Object #N($03), the far side of an arch (#R$BFD8).
 $A7F2 DEFW $A8F0    ; {Objects #N$04 to #N$06: parts of the border of the screen, which
 $A7F4 DEFW $A8F0    ; are only drawn (#R$A8F0).
 $A7F6 DEFW $A8F0    ; }
 $A7F8 DEFW $A8F0    ; {Objects #N$07 to #N$0A: parts of the status panel, which are
 $A7FA DEFW $A8F0    ; only drawn (#R$A8F0).
 $A7FC DEFW $A8F0    ;
 $A7FE DEFW $A8F0    ; }
 $A800 DEFW $B055    ; Object #N($0B), the second part of a robot mouse, which follows the
                     ; object in front of it in the table (#R$B055).
 $A802 DEFW $BEE0    ; Object #N($0C), an extra life (#R$BEE0).
 $A804 DEFW $BF51    ; Object #N($0D), part of a wall (#R$BF51).
 $A806 DEFW $BF74    ; Object #N($0E), part of a wall (#R$BF74).
 $A808 DEFW $BF65    ; Object #N($0F), part of a wall (#R$BF65).
 $A80A DEFW $C0BE    ; {Objects #N$10 to #N$17: the lower half of the robot in each of
 $A80C DEFW $C0BE    ; its walking positions (#R$C0BE).
 $A80E DEFW $C0BE    ;
 $A810 DEFW $C0BE    ;
 $A812 DEFW $C0BE    ;
 $A814 DEFW $C0BE    ;
 $A816 DEFW $C0BE    ;
 $A818 DEFW $C0BE    ; }
 $A81A DEFW $C1E2    ; {Objects #N$18 to #N$1B: the lower half of the robot when it is
 $A81C DEFW $C1E2    ; standing still, facing the front and the side (#R$C1E2).
 $A81E DEFW $C1E2    ;
 $A820 DEFW $C1E2    ; }
 $A822 DEFW $B2FF    ; Object #N($1C), a block which is fat at the bottom
                     ; (#R$B2FF).
 $A824 DEFW $B31A    ; Object #N($1D), a block which is fat at the top
                     ; (#R$B31A).
 $A826 DEFW $BF3D    ; Object #N($1E), a block (#R$BF3D).
 $A828 DEFW $B33F    ; Object #N($1F), a block which moves up and down
                     ; (#R$B33F).
 $A82A DEFW $C6E4    ; {Objects #N$20 to #N$2B: the upper half of the robot in each of
 $A82C DEFW $C6E4    ; its positions (#R$C6E4).
 $A82E DEFW $C6E4    ;
 $A830 DEFW $C6E4    ;
 $A832 DEFW $C6E4    ;
 $A834 DEFW $C6E4    ;
 $A836 DEFW $C6E4    ;
 $A838 DEFW $C6E4    ;
 $A83A DEFW $C6E4    ;
 $A83C DEFW $C6E4    ;
 $A83E DEFW $C6E4    ;
 $A840 DEFW $C6E4    ; }
 $A842 DEFW $B2B6    ; Object #N($2C), a block which falls when something touches it
                     ; (#R$B2B6).
 $A844 DEFW $B28C    ; Object #N($2D), a block which collapses (#R$B28C).
 $A846 DEFW $B2A4    ; Object #N($2E), a broken egg, which is deadly to touch
                     ; (#R$B2A4).
 $A848 DEFW $B31F    ; Object #N($2F), a block which moves up and down while the player is
                     ; standing on it (#R$B31F).
 $A84A DEFW $B3A4    ; {Objects #N$30 to #N$36: sparkles (#R$B3A4).
 $A84C DEFW $B3A4    ;
 $A84E DEFW $B3A4    ;
 $A850 DEFW $B3A4    ;
 $A852 DEFW $B3A4    ;
 $A854 DEFW $B3A4    ;
 $A856 DEFW $B3A4    ; }
 $A858 DEFW $B3B8    ; Object #N$37: sparkles (#R$B3B8).
 $A85A DEFW $BC70    ; {Objects #N$38 to #N$3E: sparkles (#R$BC70).
 $A85C DEFW $BC70    ;
 $A85E DEFW $BC70    ;
 $A860 DEFW $BC70    ;
 $A862 DEFW $BC70    ;
 $A864 DEFW $BC70    ;
 $A866 DEFW $BC70    ; }
 $A868 DEFW $BC83    ; Object #N$3F: sparkles (#R$BC83).
 $A86A DEFW $B3A4    ; Object #N$40: sparkles (#R$B3A4).
 $A86C DEFW $B3B0    ; Object #N($41), which
                     ; clears the object it points to and
                     ; turns into a sparkle (#R$B3B0).
 $A86E DEFW $B224    ; Object #N($42), a block which moves east and west
                     ; (#R$B224).
 $A870 DEFW $B21C    ; Object #N($43), a block which moves north and south
                     ; (#R$B21C).
 $A872 DEFW $B267    ; Object #N($44), a conveyor which carries objects north
                     ; (#R$B267).
 $A874 DEFW $B27A    ; Object #N($45), a conveyor which carries objects east
                     ; (#R$B27A).
 $A876 DEFW $B280    ; Object #N($46), a conveyor which carries objects south
                     ; (#R$B280).
 $A878 DEFW $B286    ; Object #N($47), a conveyor which carries objects west
                     ; (#R$B286).
 $A87A DEFW $B29F    ; Object #N($48), a deadly pyramid (#R$B29F).
 $A87C DEFW $AD13    ; Object #N($49), the top of a broken egg, which is deadly to touch
                     ; (#R$AD13).
 $A87E DEFW $AE96    ; Object #N($4A), a cryonaut looking out of a chamber
                     ; (#R$AE96).
 $A880 DEFW $B29F    ; Object #N($4B), deadly tubes (#R$B29F).
 $A882 DEFW $B19C    ; {Objects #N$4C to #N$4F: sparkles which fly towards the player
 $A884 DEFW $B19C    ; (#R$B19C).
 $A886 DEFW $B19C    ;
 $A888 DEFW $B19C    ; }
 $A88A DEFW $ABF5    ; Object #N($50), the alarm in the game over scene
                     ; (#R$ABF5).
 $A88C DEFW $AB61    ; {Objects #N$51 to #N$53: the boxing glove, hammer and hook in the
 $A88E DEFW $AB61    ; game over scene (#R$AB61).
 $A890 DEFW $AB61    ; }
 $A892 DEFW $A8F0    ; Object #N($54), part of the status panel, which is only drawn
                     ; (#R$A8F0).
 $A894 DEFW $AC21    ; Object #N($55), the pot of oil in the game completed scene, which is
                     ; only coloured (#R$AC21).
 $A896 DEFW $B110    ; {Objects #N$56 and #N$57: a robot mouse (#R$B110).
 $A898 DEFW $B110    ; }
 $A89A DEFW $AC21    ; {Objects #N$58 to #N$5B: the sides, the bottom half and the top
 $A89C DEFW $AC21    ; half of the robot in the game over scene, which are only coloured (#R$AC21).
 $A89E DEFW $AC21    ;
 $A8A0 DEFW $AC21    ; }
 $A8A2 DEFW $A971    ; Object #N($5C), the bottom half of the robot in the game completed
                     ; scene (#R$A971).
 $A8A4 DEFW $A95A    ; Object #N($5D), the top half
                     ; of the robot in the game completed
                     ; scene (#R$A95A).
 $A8A6 DEFW $B06B    ; {Objects #N$5E and #N$5F: a robot mouse (#R$B06B).
 $A8A8 DEFW $B06B    ; }
 $A8AA DEFW $AF79    ; {Objects #N$60 to #N$63: a valve lying about in a room, in the
 $A8AC DEFW $AF79    ; shape of a cylinder, a cube, a pyramid or a half sphere (#R$AF79).
 $A8AE DEFW $AF79    ;
 $A8B0 DEFW $AF79    ; }
 $A8B2 DEFW $AE5D    ; {Objects #N$64 to #N$67: a valve in place on a socket
 $A8B4 DEFW $AE5D    ; (#R$AE5D).
 $A8B6 DEFW $AE5D    ;
 $A8B8 DEFW $AE5D    ; }
 $A8BA DEFW $AE17    ; {Objects #N$68 to #N$6B: the ghost of the valve which a socket
 $A8BC DEFW $AE17    ; needs (#R$AE17).
 $A8BE DEFW $AE17    ;
 $A8C0 DEFW $AE17    ; }
 $A8C2 DEFW $AE33    ; {Objects #N$6C to #N$6F: sparkles used while the ghost of a valve
 $A8C4 DEFW $AE33    ; appears (#R$AE33).
 $A8C6 DEFW $AE33    ;
 $A8C8 DEFW $AE33    ; }
 $A8CA DEFW $AE68    ; {Objects #N$70 to #N$73: a socket for a cylinder, cube, pyramid
 $A8CC DEFW $AE68    ; or half sphere (#R$AE68).
 $A8CE DEFW $AE68    ;
 $A8D0 DEFW $AE68    ; }
 $A8D2 DEFW $AAA1    ; {Objects #N$74 to #N$77: a clockwork mouse (#R$AAA1).
 $A8D4 DEFW $AAA1    ;
 $A8D6 DEFW $AAA1    ;
 $A8D8 DEFW $AAA1    ; }
 $A8DA DEFW $AA89    ; {Objects #N$78 and #N$79: a chasing dome (#R$AA89).
 $A8DC DEFW $AA89    ; }
 $A8DE DEFW $AA63    ; {Objects #N$7A and #N$7B: a remote control arrow
 $A8E0 DEFW $AA63    ; (#R$AA63).}
 $A8E2 DEFW $A9C7    ; {Objects #N$7C to #N$7F: the remote control robot
 $A8E4 DEFW $A9C7    ; (#R$A9C7).
 $A8E6 DEFW $A9C7    ;
 $A8E8 DEFW $A9C7    ; }
 $A8EA DEFW $AA4D    ; Object #N($80), the remote control block (#R$AA4D).
 $A8EC DEFW $A9B1    ; Object #N($81), the spiked dome, which is deadly to
                     ; touch (#R$A9B1).
 $A8EE DEFW $A8F9    ; Object #N($82), the land mine, which is deadly to touch
                     ; (#R$A8F9).

; Do Nothing
;
; The update routine for objects which
; have nothing to do on each pass, such as the
; walls, the backdrop of an arch and the
; panel.
@label=NoUpdate
c$A8F0 RET           ; Return.

; Check Protection
;
; Used by the routine at #R$A631.
; .
; Part of the tape protection. The Z80
; keeps bit 7 of #REGr as it was last written,
; and the tape loader leaves it set. If the
; game was started any other way then bit 7 is
; clear and the machine is reset.
;
; .
;
; Reset the machine if bit 7 of #REGr is clear.
@label=CheckProtection
c$A8F1 LD HL,$0000   ; Point #REGhl at #SKOOLKID$0000(START).
 $A8F4 LD A,R        ; Fetch #REGr.
 $A8F6 RLA           ; Move bit 7 into the carry flag.
 $A8F7 RET C         ; Return if the bit is set.
 $A8F8 JP (HL)       ; Jump to #SKOOLKID$0000(START).

; Handle Land Mine
;
; The update routine for the land mine
; (object #N$82). It sits on the floor and is
; deadly to touch. Every so often one mine in
; the room leaps and falls. Bit 0 of
; #REGix+#N$10 is set while it is leaping, bit
; 1 while it is falling. #REGix+#N$11 is the
; height at the top of the leap. #R$5B43 is
; set while any mine is leaping.
;
; IX The address of the object
;
; Start a leap if no other mine is leaping.
@label=HandleLandMine
c$A8F9 CALL $BF3D      ; Call #R$BF3D.
 $A8FC CALL $B2A7      ; Call #R$B2A7.
 $A8FF BIT 0,(IX+$10)  ; {Jump to #R$A921 if the mine is already leaping.
 $A903 JR NZ,$A921     ; }
 $A905 LD A,($5B43)    ; {Return if #R$5B43 is set.
 $A908 AND A           ;
 $A909 RET NZ          ; }
 $A90A LD A,($5B05)    ; Fetch #R$5B05.
 $A90D INC A           ; Add one to it.
 $A90E AND %00000011   ; Keep bits 0 and 1.
 $A910 RET NZ          ; Return if they are not zero.
 $A911 LD A,$01        ; Set #REGa to #N$01.
 $A913 LD ($5B43),A    ; Set #R$5B43.
 $A916 LD (IX+$10),A   ; Mark this mine as leaping.
 $A919 LD A,(IX+$03)   ; Fetch the height of the mine.
 $A91C ADD A,$30       ; Add #N$30.
 $A91E LD (IX+$11),A   ; Store the height at the top of the leap.
; Move the mine for this pass.
@label=HandleLandMine_MoveMine
*$A921 BIT 1,(IX+$10)  ; {Jump to #R$A93D if the mine is not falling.
 $A925 JR Z,$A93D      ; }
 $A927 CALL $BFB6      ; Call #R$BFB6.
 $A92A BIT 2,(IX+$0C)  ; {Jump to #R$A937 if the mine has not landed.
 $A92E JR Z,$A937      ; }
 $A930 XOR A           ; Write #N$00.
 $A931 LD (IX+$10),A   ; Clear the state of the mine.
 $A934 LD ($5B43),A    ; Write #N$00 to #R$5B43.
; Play a sound and redraw the mine.
@label=HandleLandMine_SoundAndRedraw
*$A937 CALL $B63C      ; Call #R$B63C.
 $A93A JP $BFAB        ; Jump to #R$BFAB.
; The mine is rising.
@label=HandleLandMine_Rising
*$A93D LD (IX+$0B),$03 ; Set the vertical speed to #N$03.
 $A941 CALL $BFB6      ; Call #R$BFB6.
 $A944 LD A,(IX+$03)   ; Fetch the height of the mine.
 $A947 CP (IX+$11)     ; {Jump to #R$A954 if it has reached the top.
 $A94A JR NC,$A954     ; }
 $A94C BIT 2,(IX+$0C)  ; {Jump to #R$A954 if it has hit something above.
 $A950 JR NZ,$A954     ; }
 $A952 JR $A937        ; Jump to #R$A937.
; The mine starts falling.
@label=HandleLandMine_StartFalling
*$A954 SET 1,(IX+$10)  ; Mark the mine as falling.
 $A958 JR $A937        ; Jump to #R$A937.

; Handle Ending Robot Top
;
; The update routine for the top half of
; the robot in the game completed scene
; (object #N$5D). The bottom half (object
; #N$5C) is the previous object, handled by
; #R$A971. This copies its pixel y position,
; colour and flags, #N$10 pixels higher.
;
; IX The address of the object
;
; Sit on top of the bottom half and colour the cells.
@label=HandleEndingRobotTop
c$A95A LD A,(IX-$05) ; Fetch the pixel y position of the previous object.
 $A95D ADD A,$10     ; Add #N$10.
 $A95F LD (IX+$1B),A ; Store it as the pixel y position.
 $A962 LD A,(IX-$10) ; Fetch the colour of the previous object.
 $A965 LD (IX+$10),A ; Use the same colour.
 $A968 LD A,(IX-$19) ; Fetch the flags of the previous object.
 $A96B LD (IX+$07),A ; Use the same flags.
 $A96E JP $AC21      ; Jump to #R$AC21.

; Handle Ending Robot Bottom
;
; The update routine for the bottom
; half of the robot in the game completed
; scene (object #N$5C). The counter in
; #REGix+#N$11 waits for #N$40 passes, then
; the robot goes down three pixels a pass
; into the pot of oil at row #N$28. After
; #N$80 it comes back up, bright white. At
; row #N$80 the end tune is played and a new
; game is started.
;
; IX The address of the object
;
; Wait, go down, or come back up.
@label=HandleEndingRobotBottom
c$A971 LD A,(IX+$11)   ; Fetch the counter.
 $A974 CP $40          ; {Jump to #R$A991 if it is less than #N$40.
 $A976 JR C,$A991      ; }
 $A978 CP $80          ; {Jump to #R$A996 if it is #N$80 or more.
 $A97A JR NC,$A996     ; }
; The robot is going down into the pot of oil.
 $A97C LD A,(IX+$1B)   ; Fetch the pixel y position.
 $A97F CP $28          ; {Jump to #R$A991 if it has reached row #N$28.
 $A981 JR C,$A991      ; }
 $A983 SUB $03         ; Take #N$03 off it.
 $A985 LD (IX+$1B),A   ; Store the pixel y position.
; Play a sound and redraw the robot.
@label=HandleEndingRobotBottom_SoundAndRedraw
*$A988 CALL $B63F      ; Call #R$B63F.
 $A98B CALL $BFAB      ; Call #R$BFAB.
@label=HandleEndingRobotBottom_ColourCells
*$A98E JP $AC21        ; Jump to #R$AC21.
; Count another pass.
@label=HandleEndingRobotBottom_CountPass
*$A991 INC (IX+$11)    ; Increment the counter.
 $A994 JR $A98E        ; Jump to #R$A98E.
; The robot is coming back up.
@label=HandleEndingRobotBottom_ComingUp
*$A996 LD A,(IX+$1B)   ; Fetch the pixel y position.
 $A999 CP $80          ; {Jump to #R$A9A8 if it has reached row #N$80.
 $A99B JR NC,$A9A8     ; }
 $A99D ADD A,$03       ; Add #N$03.
 $A99F LD (IX+$1B),A   ; Store the pixel y position.
 $A9A2 LD (IX+$10),$47 ; Set the colour to bright white.
 $A9A6 JR $A988        ; Jump to #R$A988.
; The robot has come out of the oil.
; .
; #HTML(#AUDIO0(robot-tune.wav)(#INCLUDE(RobotTune)))
@label=HandleEndingRobotBottom_Landed
*$A9A8 LD DE,$B3D7     ; Point #REGde at #R$B3D7.
 $A9AB CALL $B4BA      ; Call #R$B4BA.
 $A9AE JP $A647        ; Jump to #R$A647.

; Handle Spiked Dome
;
; The update routine for the spiked
; dome (object #N$81), which is deadly to
; touch and does not move. If it is ever set
; moving it is replaced with a sparkle
; (object #N$36).
;
; IX The address of the object
;
; Vanish if the dome is moving.
@label=HandleSpikedDome
c$A9B1 CALL $BF6A      ; Call #R$BF6A.
 $A9B4 LD A,(IX+$09)   ; {Combine the speeds in every direction.
 $A9B7 OR (IX+$0A)     ;
 $A9BA OR (IX+$0B)     ; }
 $A9BD JP Z,$B2A7      ; Jump to #R$B2A7 if it is not moving.
 $A9C0 LD (IX+$00),$36 ; Turn it into a sparkle.
 $A9C4 JP $B2B0        ; Jump to #R$B2B0.

; Handle Remote Control Robot
;
; The update routine for the remote
; control robot (objects #N$7C to #N$7F). The
; pads at #R$AA63 and #R$AA4D leave a command
; in #R$5B42: bit 7 says a robot is listening,
; and bits 0 to 5 hold the command. The first
; robot to be updated claims bit 7 of #R$5B42
; and bit 7 of #REGix+#N$10. When a command
; arrives it sets bit 6 instead and follows
; the pad until it is released.
;
; IX The address of the object
;
; See whether this robot is listening or following.
@label=HandleRemoteControlRobot
c$A9C7 CALL $BF3D     ; Call #R$BF3D.
 $A9CA LD HL,$5B42    ; Point #REGhl at #R$5B42.
 $A9CD LD A,(HL)      ; Fetch the command.
 $A9CE AND %10000000  ; Keep bit 7.
 $A9D0 JR Z,$A9FE     ; Jump to #R$A9FE if no robot is listening.
 $A9D2 LD A,(IX+$10)  ; Fetch the state of this robot.
 $A9D5 AND %11000000  ; Keep bits 6 and 7.
 $A9D7 JR Z,$A9F1     ; Jump to #R$A9F1 if this robot is neither.
 $A9D9 BIT 7,(IX+$10) ; {Jump to #R$AA06 if this robot is listening.
 $A9DD JR NZ,$AA06    ; }
; This robot is following the pad.
 $A9DF LD A,(HL)      ; Fetch the command.
 $A9E0 AND %00111111  ; Keep bits 0 to 5.
 $A9E2 JR NZ,$AA15    ; Jump to #R$AA15 if there is a command.
 $A9E4 RES 7,(HL)     ; Reset bit 7 of #R$5B42.
 $A9E6 RES 6,(IX+$10) ; Reset bit 6 of the state.
 $A9EA XOR A          ; Write #N$00.
 $A9EB LD (IX+$09),A  ; Stop the speed along the x axis.
 $A9EE LD (IX+$0A),A  ; Stop the speed along the y axis.
; Move the robot and redraw it if it is moving.
@label=HandleRemoteControlRobot_Move
*$A9F1 CALL $BFB6     ; Call #R$BFB6.
 $A9F4 CALL $BED6     ; {Return if the robot is not moving.
 $A9F7 RET Z          ; }
 $A9F8 CALL $B63C     ; Call #R$B63C.
 $A9FB JP $BFAB       ; Jump to #R$BFAB.
; Make this robot the listener.
@label=HandleRemoteControlRobot_BecomeListener
*$A9FE SET 7,(HL)     ; Set bit 7 of #R$5B42.
 $AA00 SET 7,(IX+$10) ; Set bit 7 of the state.
 $AA04 JR $A9F1       ; Jump to #R$A9F1.
; This robot is listening.
@label=HandleRemoteControlRobot_Listening
*$AA06 LD A,(HL)      ; Fetch the command.
 $AA07 AND %01111111  ; Keep bits 0 to 6.
 $AA09 JR Z,$A9F1     ; Jump to #R$A9F1 if there is no command.
 $AA0B LD A,(IX+$10)  ; Fetch the state of this robot.
 $AA0E AND %00111111  ; Keep bits 0 to 5.
 $AA10 OR %01000000   ; Set bit 6.
 $AA12 LD (IX+$10),A  ; Store the state.
; Carry out a command from #R$AA43.
@label=HandleRemoteControlRobot_CarryOutCommand
*$AA15 LD A,(HL)      ; Fetch the command.
 $AA16 LD (HL),$80    ; Set #R$5B42 to #N$80.
 $AA18 DEC A          ; Take one off the command.
 $AA19 RLCA           ; Double it.
 $AA1A AND %01111110  ; Keep bits 1 to 6.
 $AA1C LD HL,$AA43    ; Point #REGhl at #R$AA43.
 $AA1F CALL $CE06     ; Call #R$CE06.
 $AA22 LD A,(HL)      ; Fetch the speed along the x axis.
 $AA23 INC HL         ; Move on to the speed along the y axis.
 $AA24 LD (IX+$09),A  ; Set the speed along the x axis.
 $AA27 LD A,(HL)      ; Fetch the speed along the y axis.
 $AA28 DEC HL         ; Move #REGhl back.
 $AA29 LD (IX+$0A),A  ; Set the speed along the y axis.
 $AA2C CALL $B18C     ; Call #R$B18C.
 $AA2F LD A,(IX+$09)  ; {Jump to #R$AA3A if the robot is not moving.
 $AA32 OR (IX+$0A)    ;
 $AA35 JR Z,$AA3A     ; }
 $AA37 CALL $BFB6     ; Call #R$BFB6.
@label=HandleRemoteControlRobot_PlaySound
*$AA3A LD HL,$B6A9    ; Point #REGhl at #R$B6A9.
 $AA3D CALL $B690     ; Call #R$B690.
 $AA40 JP $BFAB       ; Jump to #R$BFAB.

; Remote Control Robot Speeds
;
; The speeds along the x and y axes
; given to the remote control robot for
; commands #N$01 to #N$05.
@label=RemoteControlRobotSpeeds
b$AA43 DEFB $00,$00  ; Command #N$01: stop
 $AA45 DEFB $FE,$00  ; Command #N$02: move west
 $AA47 DEFB $00,$02  ; Command #N$03: move north
 $AA49 DEFB $02,$00  ; Command #N$04: move east
 $AA4B DEFB $00,$FE  ; Command #N$05: move south

; Handle Remote Control Block
;
; The update routine for the remote
; control block (object #N$80), the pad which
; tells the robot to stop. It is pressed when
; its vertical speed is not zero. The command
; is #N$01; bit 7 of #R$5B42 is left as it
; was.
;
; IX The address of the object
;
; Send the stop command if something has landed.
@label=HandleRemoteControlBlock
c$AA4D CALL $BF3D    ; Call #R$BF3D.
 $AA50 LD A,(IX+$0B) ; Fetch the vertical speed.
 $AA53 AND A         ; {Return if nothing has landed.
 $AA54 RET Z         ; }
 $AA55 XOR A         ; {Write #N$00 to the vertical speed.
 $AA56 LD (IX+$0B),A ; }
 $AA59 LD HL,$5B42   ; Point #REGhl at #R$5B42.
 $AA5C LD A,(HL)     ; Fetch the command.
 $AA5D AND %10000000 ; Keep bit 7.
 $AA5F OR %00000001  ; Set the command to #N$01.
 $AA61 LD (HL),A     ; Set #R$5B42.
 $AA62 RET           ; Return.

; Handle Remote Control Arrow
;
; The update routine for the remote
; control arrows (objects #N$7A and #N$7B).
; Object #N$7A is west, or north when flipped;
; object #N$7B is east, or south when flipped,
; giving commands #N$02 to #N$05.
;
; IX The address of the object
;
; Send a direction if something has landed.
@label=HandleRemoteControlArrow
c$AA63 CALL $BF3D    ; Call #R$BF3D.
 $AA66 LD A,(IX+$0B) ; Fetch the vertical speed.
 $AA69 AND A         ; {Return if nothing has landed.
 $AA6A RET Z         ; }
 $AA6B XOR A         ; {Write #N$00 to the vertical speed.
 $AA6C LD (IX+$0B),A ; }
 $AA6F LD A,(IX+$07) ; Fetch the flags of the pad.
 $AA72 RLCA          ; Move the flip into bit 7.
 $AA73 AND %10000000 ; Keep bit 7.
 $AA75 LD C,A        ; Keep it in #REGc.
 $AA76 LD A,(IX+$00) ; Fetch the sprite number.
 $AA79 AND %00000001 ; Keep bit 0.
 $AA7B OR C          ; Combine it with the flip.
 $AA7C RLCA          ; Move the bits into a command.
 $AA7D ADD A,$02     ; Add #N$02.
 $AA7F LD C,A        ; Keep the command in #REGc.
 $AA80 LD HL,$5B42   ; Point #REGhl at #R$5B42.
 $AA83 LD A,(HL)     ; Fetch the command.
 $AA84 AND %10000000 ; Keep bit 7.
 $AA86 OR C          ; Combine it with the new command.
 $AA87 LD (HL),A     ; Set #R$5B42.
 $AA88 RET           ; Return.

; Handle Chasing Dome
;
; The update routine for the chasing
; dome (objects #N$78 and #N$79), which is
; deadly to touch. It moves towards the
; player at one unit per pass in each
; direction.
;
; IX The address of the object
;
; Head towards the player and redraw the dome.
@label=HandleChasingDome
c$AA89 CALL $BF6A    ; Call #R$BF6A.
 $AA8C LD BC,$0101   ; Set the speed along each axis to #N$01.
 $AA8F CALL $B165    ; Call #R$B165.
 $AA92 CALL $BFB6    ; Call #R$BFB6.
 $AA95 CALL $B185    ; Call #R$B185.
 $AA98 LD HL,$B6AD   ; Point #REGhl at #R$B6AD.
 $AA9B CALL $B690    ; Call #R$B690.
 $AA9E JP $B2B0      ; Jump to #R$B2B0.

; Handle Clockwork Mouse
;
; The update routine for the clockwork
; mouse (objects #N$74 to #N$77), which is
; deadly to touch. It runs along one axis for
; a random number of passes in #REGix+#N($10),
; or until it hits something. Then it chooses
; a new random speed and turns through a right
; angle, alternating between the x and y axes.
; The sprite number says which way it faces,
; and the flip flag says which axis it uses.
;
; IX The address of the object
;
; Move the mouse, or choose a new direction.
@label=HandleClockworkMouse
c$AAA1 CALL $BF5B      ; Call #R$BF5B.
 $AAA4 CALL $BFB6      ; Call #R$BFB6.
 $AAA7 LD A,(IX+$09)   ; {Jump to #R$AAC1 if the mouse is not moving.
 $AAAA OR (IX+$0A)     ;
 $AAAD JR Z,$AAC1      ; }
 $AAAF LD A,(IX+$0C)   ; Fetch the collision flags.
 $AAB2 AND %00000011   ; Keep bits 0 and 1.
 $AAB4 JR NZ,$AAC1     ; Jump to #R$AAC1 if the mouse has hit something.
 $AAB6 DEC (IX+$10)    ; Count down the remaining passes.
 $AAB9 JR Z,$AAC1      ; Jump to #R$AAC1 if they have run out.
; Animate the mouse and redraw it.
@label=HandleClockworkMouse_Animate
*$AABB CALL $B185      ; Call #R$B185.
 $AABE JP $B2B0        ; Jump to #R$B2B0.
; Choose a new direction.
@label=HandleClockworkMouse_ChooseDirection
*$AAC1 CALL $B6BB      ; Call #R$B6BB.
 $AAC4 LD A,($5B03)    ; Fetch #R$5B02(#N$5B03).
 $AAC7 LD C,A          ; Keep it in #REGc.
 $AAC8 LD A,($5B05)    ; Fetch #R$5B05.
 $AACB XOR C           ; Combine the two.
 $AACC AND %00001111   ; Keep bits 0 to 3.
 $AACE LD (IX+$10),A   ; Set the remaining passes.
 $AAD1 LD A,(IX+$07)   ; Fetch the flags of the mouse.
 $AAD4 XOR %01000000   ; Flip bit 6.
 $AAD6 LD (IX+$07),A   ; Store the flags.
 $AAD9 LD A,($5B05)    ; Fetch #R$5B05.
 $AADC AND %00000001   ; Keep bit 0.
 $AADE JR Z,$AB0C      ; Jump to #R$AB0C if it is zero.
 $AAE0 BIT 6,(IX+$07)  ; {Jump to #R$AAEE if the mouse is not flipped.
 $AAE4 JR Z,$AAEE      ; }
; Turn the mouse round.
@label=HandleClockworkMouse_TurnRound
*$AAE6 LD A,(IX+$00)   ; Fetch the sprite number.
 $AAE9 XOR %00000010   ; Flip bit 1.
 $AAEB LD (IX+$00),A   ; Store the sprite number.
; Choose a speed of #N$02 to #N$05.
@label=HandleClockworkMouse_ChooseSpeed
*$AAEE LD A,($5B02)    ; Fetch #R$5B02.
 $AAF1 AND %00000011   ; Keep bits 0 and 1.
 $AAF3 ADD A,$02       ; Add #N$02.
 $AAF5 BIT 1,(IX+$00)  ; {Jump to #R$AAFD if the mouse is facing forwards.
 $AAF9 JR NZ,$AAFD     ; }
 $AAFB NEG             ; Make the speed negative.
@label=HandleClockworkMouse_CheckFlipped
*$AAFD BIT 6,(IX+$07)  ; {Jump to #R$AB14 if the mouse is flipped.
 $AB01 JR NZ,$AB14     ; }
 $AB03 LD (IX+$09),A   ; Set the speed along the x axis.
 $AB06 LD (IX+$0A),$00 ; Write #N$00 as the speed along the y axis.
 $AB0A JR $AABB        ; Jump to #R$AABB.
@label=HandleClockworkMouse_CheckFlippedForward
*$AB0C BIT 6,(IX+$07)  ; {Jump to #R$AAE6 if the mouse is not flipped.
 $AB10 JR Z,$AAE6      ; }
 $AB12 JR $AAEE        ; Jump to #R$AAEE.
@label=HandleClockworkMouse_NegativeSpeed
*$AB14 NEG             ; Make the speed negative.
 $AB16 LD (IX+$0A),A   ; Set the speed along the y axis.
 $AB19 LD (IX+$09),$00 ; Write #N$00 as the speed along the x axis.
 $AB1D JR $AABB        ; Jump to #R$AABB.

; Face Direction Of Travel
;
; Turns an object to face the
; direction it is moving in. Nothing in the
; game calls this routine.
;
; IX The address of the object
;
; Compare the sizes of the two speeds.
@label=FaceDirectionOfTravel
c$AB1F LD A,(IX+$09)  ; Fetch the speed along the x axis.
 $AB22 AND A          ; {Jump to #R$AB28 if it is not negative.
 $AB23 JP P,$AB28     ; }
 $AB26 NEG            ; Make it positive.
@label=FaceDirectionOfTravel_SizeOfSpeedX
*$AB28 LD C,A         ; Keep the size of the x speed in #REGc.
 $AB29 LD A,(IX+$0A)  ; Fetch the speed along the y axis.
 $AB2C AND A          ; {Jump to #R$AB32 if it is not negative.
 $AB2D JP P,$AB32     ; }
 $AB30 NEG            ; Make it positive.
@label=FaceDirectionOfTravel_CompareSpeeds
*$AB32 CP C           ; Compare it with the size of the x speed.
 $AB33 JR C,$AB4B     ; Jump to #R$AB4B if the y speed is smaller.
; Face along the x axis.
 $AB35 LD A,(IX+$09)  ; Fetch the speed along the x axis.
 $AB38 AND A          ; {Jump to #R$AB45 if it is not negative.
 $AB39 JP P,$AB45     ; }
 $AB3C RES 1,(IX+$00) ; Reset bit 1 of the sprite number.
@label=FaceDirectionOfTravel_Unflip
*$AB40 RES 6,(IX+$07) ; Reset bit 6 of the flags.
 $AB44 RET            ; Return.
@label=FaceDirectionOfTravel_FaceForwards
*$AB45 SET 1,(IX+$00) ; Set bit 1 of the sprite number.
 $AB49 JR $AB40       ; Jump to #R$AB40.
; Face along the y axis.
@label=FaceDirectionOfTravel_CheckSpeedY
*$AB4B LD A,(IX+$0A)  ; Fetch the speed along the y axis.
 $AB4E AND A          ; {Jump to #R$AB5B if it is not negative.
 $AB4F JP P,$AB5B     ; }
 $AB52 SET 1,(IX+$00) ; Set bit 1 of the sprite number.
@label=FaceDirectionOfTravel_Flip
*$AB56 SET 6,(IX+$07) ; Set bit 6 of the flags.
 $AB5A RET            ; Return.
@label=FaceDirectionOfTravel_FaceBackwards
*$AB5B RES 1,(IX+$00) ; Reset bit 1 of the sprite number.
 $AB5F JR $AB56       ; Jump to #R$AB56.

; Handle Attacking Tool
;
; The handler for the boxing glove,
; hammer and hook (objects #N$51 to #N$53).
; In the game over scene they take it in
; turns to beat the robot, once the alarm has
; finished flashing (see #R$ABF5).
; .
; A tool swings towards the robot for six
; frames, makes a noise, and swings back for
; six frames. Bit 7 of the state holds the
; direction and bit 0 is set while it is
; attacking. The game restarts after #N$10
; attacks, or if a number key is pressed.
;
; IX The address of the object
;
; Start an attack, or keep one going.
@label=HandleAttackingTool
c$AB61 LD HL,$5B41     ; Point #REGhl at #R$5B41.
 $AB64 LD A,(HL)       ; {Jump to #R$ABDA if #R$5B41 is zero.
 $AB65 AND A           ;
 $AB66 JR Z,$ABDA      ; }
 $AB68 LD A,$E7        ; {Read from the keyboard;
 $AB6A CALL $B759      ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                       ; { =h,r2 Port Number | =h,c5 Bit }
                       ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                       ; { #N$E7 | 1 / 0 | 2 / 9 | 3 / 8 | 4 / 7 | 5 / 6 }
                       ; TABLE#}
 $AB6D JP NZ,$A647     ; Jump to #R$A647 if a key is pressed.
 $AB70 BIT 0,(IX+$11)  ; {Jump to #R$AB91 if this tool is already attacking.
 $AB74 JR NZ,$AB91     ; }
 $AB76 BIT 7,(HL)      ; {Jump to #R$ABDA if another tool is attacking.
 $AB78 JR NZ,$ABDA     ; }
 $AB7A LD A,($5B05)    ; Fetch #R$5B05.
 $AB7D CPL             ; Invert it.
 $AB7E AND %00000011   ; Keep bits 0 and 1.
 $AB80 JR NZ,$ABDA     ; Jump to #R$ABDA unless both bits were set.
 $AB82 PUSH HL         ; {Call #R$B619, preserving #REGhl.
 $AB83 CALL $B619      ;
 $AB86 POP HL          ; }
 $AB87 SET 0,(IX+$11)  ; Set bit 0 of the state.
 $AB8B SET 7,(HL)      ; Set bit 7 of #R$5B41.
 $AB8D LD (IX+$0F),$06 ; Write #N$06 to the frame counter.
; The boxing glove and the hook move
; along the x axis by #N$08; the hammer moves
; along the y axis by #N$04.
@label=HandleAttackingTool_Swing
*$AB91 LD A,(IX+$00)   ; Fetch the sprite number.
 $AB94 AND %00000001   ; Keep bit 0.
 $AB96 JR Z,$ABDD      ; Jump to #R$ABDD if the tool is the hammer.
 $AB98 LD A,(IX+$1A)   ; {Compare bit 7 of the pixel x with bit 7 of the
 $AB9B XOR (IX+$11)    ; direction.}
 $AB9E AND %10000000   ; Keep bit 7.
 $ABA0 LD A,$08        ; Set the step to #N$08.
 $ABA2 JR Z,$ABA6      ; Jump to #R$ABA6 if the step already points the right
                       ; way.
 $ABA4 NEG             ; Make the step negative.
@label=HandleAttackingTool_MoveAlongX
*$ABA6 ADD A,(IX+$1A)  ; {Add the step to the pixel x position.
 $ABA9 LD (IX+$1A),A   ; }
@label=HandleAttackingTool_CountFrame
*$ABAC DEC (IX+$0F)    ; {Jump to #R$ABD7 if this swing has not finished.
 $ABAF JR NZ,$ABD7     ; }
 $ABB1 LD (IX+$0F),$06 ; Write #N$06 to the frame counter.
 $ABB5 LD A,(IX+$11)   ; Fetch the state of the tool.
 $ABB8 XOR %10000000   ; Flip bit 7.
 $ABBA LD (IX+$11),A   ; Store the state.
 $ABBD AND %10000000   ; Keep bit 7.
 $ABBF JR Z,$ABC6      ; Jump to #R$ABC6 if the tool has finished swinging
                       ; back.
 $ABC1 CALL $B676      ; Call #R$B676.
 $ABC4 JR $ABD7        ; Jump to #R$ABD7.
; The swing back has finished.
@label=HandleAttackingTool_AttackFinished
*$ABC6 RES 0,(IX+$11)  ; Reset bit 0 of the state.
 $ABCA RES 7,(HL)      ; Reset bit 7 of #R$5B41.
 $ABCC INC (HL)        ; Increment #R$5B41.
 $ABCD LD A,(HL)       ; Fetch #R$5B41.
 $ABCE AND %01111111   ; Keep bits 0 to 6.
 $ABD0 CP $10          ; {Jump to #R$ABD7 unless #N$10 attacks have been made.
 $ABD2 JR NZ,$ABD7     ; }
 $ABD4 JP $A647        ; Jump to #R$A647.
@label=HandleAttackingTool_Redraw
*$ABD7 CALL $BFAB      ; Call #R$BFAB.
@label=HandleAttackingTool_ColourCells
*$ABDA JP $AC21        ; Jump to #R$AC21.
; Move the hammer along the y axis.
@label=HandleAttackingTool_MoveAlongY
*$ABDD LD A,(IX+$1B)   ; Fetch the pixel y position.
 $ABE0 ADD A,$20       ; Add #N$20.
 $ABE2 XOR (IX+$11)    ; Compare bit 7 with bit 7 of the direction.
 $ABE5 AND %10000000   ; Keep bit 7.
 $ABE7 LD A,$04        ; Set the step to #N$04.
 $ABE9 JR Z,$ABED      ; Jump to #R$ABED if the step already points the right
                       ; way.
 $ABEB NEG             ; Make the step negative.
@label=HandleAttackingTool_AddStepToY
*$ABED ADD A,(IX+$1B)  ; {Add the step to the pixel y position.
 $ABF0 LD (IX+$1B),A   ; }
 $ABF3 JR $ABAC        ; Jump to #R$ABAC.

; Handle Alarm
;
; The handler for the alarm (object
; #N$50) in the game over scene. Every eight
; frames it changes colour between black and
; bright yellow and beeps. After #N$10
; changes it retires itself and starts the
; attacks on the robot by setting #R$5B41.
;
; IX The address of the object
;
; Flash the alarm every eight frames.
@label=HandleAlarm
c$ABF5 LD A,($5B02)  ; Fetch #R$5B02.
 $ABF8 LD C,A        ; Keep it in #REGc.
 $ABF9 AND %00000111 ; Keep bits 0 to 2.
 $ABFB JR NZ,$AC21   ; Jump to #R$AC21 if this is not the eighth frame.
 $ABFD BIT 3,C       ; {Jump to #R$AC03 if bit 3 of the frame counter is clear.
 $ABFF JR Z,$AC03    ; }
 $AC01 ADD A,$46     ; Add #N$46.
@label=HandleAlarm_SetColour
*$AC03 LD (IX+$10),A ; Set the colour of the alarm.
 $AC06 CALL $B6B1    ; Call #R$B6B1.
 $AC09 INC (IX+$11)  ; Increment the colour-change count.
 $AC0C LD A,(IX+$11) ; {Jump to #R$AC21 unless there have been #N$10 changes.
 $AC0F CP $10        ;
 $AC11 JR NZ,$AC21   ; }
 $AC13 LD A,$01      ; {Write #N$01 to #R$5B41.
 $AC15 LD ($5B41),A  ; }
 $AC18 LD (IX+$00),A ; Set the sprite number to #N$01.
 $AC1B CALL $AC21    ; Call #R$AC21.
 $AC1E JP $BFAB      ; Jump to #R$BFAB.

; Colour Cells
;
; Used by the routines at #R$A95A, #R$A971, #R$AB61 and #R$ABF5.
; .
; Colours the attribute cells covered
; by an object, using the colour in the
; object record. Cells which already have the
; colour #N$44 are left alone.
;
; IX The address of the object
;
; Work out the cells covered by the sprite.
@label=ColourCells
c$AC21 LD A,(IX+$18) ; {Return if the sprite has no width and no height.
 $AC24 OR (IX+$19)   ;
 $AC27 RET Z         ; }
 $AC28 LD L,(IX+$1A) ; Fetch the pixel x position.
 $AC2B LD B,(IX+$18) ; Fetch the width in cells.
 $AC2E LD A,L        ; Copy the pixel x position to #REGa.
 $AC2F AND %00000111 ; Keep bits 0 to 2.
 $AC31 JR Z,$AC34    ; Jump to #R$AC34 if the sprite starts on a cell edge.
 $AC33 INC B         ; Increment the width.
@label=ColourCells_FindRows
*$AC34 LD H,(IX+$1B) ; Fetch the pixel y position.
 $AC37 LD A,H        ; {Divide the pixel y position by eight.
 $AC38 RRCA          ;
 $AC39 RRCA          ;
 $AC3A RRCA          ; }
 $AC3B AND %00011111 ; Keep bits 0 to 4.
 $AC3D LD C,A        ; Keep the first row in #REGc.
 $AC3E LD A,(IX+$19) ; {Find the pixel y of the other end.
 $AC41 DEC A         ;
 $AC42 ADD A,H       ; }
 $AC43 RRCA          ; {Divide it by eight.
 $AC44 RRCA          ;
 $AC45 RRCA          ; }
 $AC46 AND %00011111 ; Keep bits 0 to 4.
 $AC48 SUB C         ; {Work out the number of rows.
 $AC49 INC A         ;
 $AC4A LD C,A        ; }
 $AC4B CALL $D157    ; Call #R$D157.
 $AC4E EX DE,HL      ; Copy the address to #REGhl.
 $AC4F LD A,(IX+$10) ; Fetch the colour of the object.
 $AC52 LD DE,$0020   ; Set #REGde to #N($0020,$04,$04).
; Colour each row of cells.
@label=ColourCells_ColourRow
*$AC55 PUSH BC       ; {Stash the counters and the address on the stack.
 $AC56 PUSH HL       ; }
 $AC57 LD C,A        ; Keep the colour in #REGc.
@label=ColourCells_ColourCell
*$AC58 LD A,(HL)     ; {Jump to #R$AC5E if the cell is already #N$44.
 $AC59 CP $44        ;
 $AC5B JR Z,$AC5E    ; }
 $AC5D LD (HL),C     ; Colour the cell.
@label=ColourCells_NextCell
*$AC5E INC L         ; Move on to the next cell in the row.
 $AC5F DJNZ $AC58    ; Jump to #R$AC58 until the row is done.
 $AC61 LD A,C        ; Put the colour back in #REGa.
 $AC62 POP HL        ; {Restore the address and the counters from the stack.
 $AC63 POP BC        ; }
 $AC64 AND A         ; {Move to the next row, which is above this one.
 $AC65 SBC HL,DE     ; }
 $AC67 DEC C         ; {Jump to #R$AC55 until all of the rows are done.
 $AC68 JR NZ,$AC55   ; }
 $AC6A RET           ; Return.

; Count Statistics
;
; Used by the routine at #R$B761.
; .
; Goes through the data for all of the
; rooms and counts those whose first object is
; a cryonaut. If the room holds a placed valve
; (objects #N$64 to #N$67) it is counted in
; #R$5B3E; otherwise it is counted in #R$5B3F
; and its cryonauts are added to #R$5B3C. All
; of the totals are BCD. They are shown when
; the game is over.
;
; .
;
; Clear the totals and start at the first room.
@label=CountStatistics
c$AC6B LD DE,$5B3C   ; Point #REGde at #R$5B3C.
 $AC6E LD B,$04      ; Set a counter of four.
 $AC70 CALL $CE1C    ; Call #R$CE1C.
 $AC73 LD HL,$6469   ; Point #REGhl at #R$6469.
@label=CountStatistics_NextRoom
*$AC76 LD C,(HL)     ; Fetch the room number.
 $AC77 INC HL        ; Move on to the length.
 $AC78 LD B,(HL)     ; Fetch the length.
; Look for the #N$FF that ends the blocks.
@label=CountStatistics_ScanBlocks
*$AC79 LD A,(HL)     ; Fetch a byte of the data.
 $AC7A INC HL        ; Move on.
 $AC7B INC A         ; Add one so that #N$FF becomes zero.
 $AC7C JR Z,$AC8A    ; Jump to #R$AC8A if it was the end of the list.
 $AC7E DJNZ $AC79    ; Jump to #R$AC79 until the length runs out.
@label=CountStatistics_SkipRoom
*$AC80 LD BC,$73C8   ; Point #REGbc at #R$73C8.
 $AC83 AND A         ; {Subtract #R$73C8 from #REGhl.
 $AC84 SBC HL,BC     ; }
 $AC86 RET NC        ; Return if all of the rooms have been done.
 $AC87 ADD HL,BC     ; Restore the address.
 $AC88 JR $AC76      ; Jump to #R$AC76.
; The objects of the room follow. Only the first is looked at.
@label=CountStatistics_FirstObject
*$AC8A DEC B         ; Count the end of the list of blocks.
 $AC8B LD A,(HL)     ; Fetch the type of the first object.
 $AC8C AND %11111000 ; Keep bits 3 to 7.
 $AC8E CP $A8        ; {Jump to #R$AC9C if it is a cryonaut facing east.
 $AC90 JR Z,$AC9C    ; }
 $AC92 CP $B0        ; {Jump to #R$AC9C if it is a cryonaut facing south.
 $AC94 JR Z,$AC9C    ; }
@label=CountStatistics_NextRoomFromHere
*$AC96 LD A,B        ; Fetch the remaining length.
 $AC97 CALL $CE06    ; Call #R$CE06.
 $AC9A JR $AC80      ; Jump to #R$AC80.
; Search #R$76E3 for a valve placed in this room.
@label=CountStatistics_FindPlacedValve
*$AC9C LD IY,$76E3   ; Point #REGiy at #R$76E3.
@label=CountStatistics_TestSpecialObject
*$ACA0 LD A,(IY+$08) ; Fetch the room of the special object.
 $ACA3 CP C          ; {Jump to #R$ACC2 if it is this room.
 $ACA4 JR Z,$ACC2    ; }
@label=CountStatistics_NextSpecialObject
*$ACA6 LD DE,$0009   ; Set #REGde to #N($0009,$04,$04).
 $ACA9 ADD IY,DE     ; Move on to the next special object.
 $ACAB PUSH HL       ; Stash the room pointer on the stack.
 $ACAC PUSH IY       ; {Copy #REGiy to #REGhl (using the stack).
 $ACAE POP HL        ; }
 $ACAF LD DE,$7827   ; Point #REGde at #R$7827.
 $ACB2 AND A         ; {Subtract #R$7827 from #REGhl.
 $ACB3 SBC HL,DE     ; }
 $ACB5 PUSH HL       ; {Copy the result to #REGiy (using the stack).
 $ACB6 POP IY        ; }
 $ACB8 POP HL        ; Restore the room pointer from the stack.
 $ACB9 JR NC,$ACD6   ; Jump to #R$ACD6 if the table has been searched.
 $ACBB LD DE,$7827   ; Point #REGde at #R$7827.
 $ACBE ADD IY,DE     ; Add it back to #REGiy.
 $ACC0 JR $ACA0      ; Jump to #R$ACA0.
@label=CountStatistics_TestPlacedValve
*$ACC2 LD A,(IY+$00) ; Fetch the special object number.
 $ACC5 SUB $64       ; Subtract #N$64.
 $ACC7 CP $04        ; {Jump to #R$ACA6 unless it is one of the four placed
 $ACC9 JR NC,$ACA6   ; valves.}
 $ACCB LD A,($5B3E)  ; {Add one to #R$5B3E.
 $ACCE ADD A,$01     ;
 $ACD0 DAA           ;
 $ACD1 LD ($5B3E),A  ; }
 $ACD4 JR $AC96      ; Jump to #R$AC96.
; There is no valve in the room, so its cryonauts are lost.
@label=CountStatistics_CountCryonauts
*$ACD6 LD DE,$5B3D   ; {Point #REGhl at #R$5B3D and #REGde at the object.
 $ACD9 EX DE,HL      ; }
 $ACDA LD A,(DE)     ; Fetch the type and number of places.
 $ACDB AND %00000111 ; Keep bits 0 to 2.
 $ACDD INC A         ; Add one.
 $ACDE ADD A,(HL)    ; {Add it to the low two digits.
 $ACDF DAA           ;
 $ACE0 LD (HL),A     ; }
 $ACE1 DEC HL        ; {Fetch the high two digits.
 $ACE2 LD A,(HL)     ; }
 $ACE3 ADC A,$00     ; {Add the carry to them.
 $ACE5 DAA           ;
 $ACE6 LD (HL),A     ; }
 $ACE7 EX DE,HL      ; Put the object pointer back in #REGhl.
 $ACE8 LD A,(HL)     ; Fetch the type and number of places.
 $ACE9 AND %00000111 ; Keep bits 0 to 2.
 $ACEB ADD A,$02     ; Add #N$02.
 $ACED LD E,A        ; Keep the length in #REGe.
 $ACEE CALL $CE06    ; Call #R$CE06.
 $ACF1 LD A,E        ; Fetch the length.
 $ACF2 NEG           ; Make it negative.
 $ACF4 ADD A,B       ; {Subtract it from the bytes left.
 $ACF5 LD B,A        ; }
 $ACF6 JR Z,$AD07    ; Jump to #R$AD07 if nothing is left.
 $ACF8 LD A,(HL)     ; Fetch the type of the next object.
 $ACF9 AND %11111000 ; Keep bits 3 to 7.
 $ACFB CP $A8        ; {Jump to #R$ACD6 if it is another cryonaut facing east.
 $ACFD JR Z,$ACD6    ; }
 $ACFF CP $B0        ; {Jump to #R$ACD6 if it is another cryonaut facing south.
 $AD01 JR Z,$ACD6    ; }
 $AD03 LD A,B        ; {Skip the rest of the room.
 $AD04 CALL $CE06    ; }
@label=CountStatistics_CountChamberNotActivated
*$AD07 LD A,($5B3F)  ; {Add one to #R$5B3F.
 $AD0A ADD A,$01     ;
 $AD0C DAA           ;
 $AD0D LD ($5B3F),A  ; }
 $AD10 JP $AC80      ; Jump to #R$AC80.

; Handle Egg Top
;
; The handler for the top half of a
; broken egg (object #N$49), which is deadly
; to touch. Only one is active at a time
; (#R$5B3A is set), and none are while
; #R$5B3B is set. An inactive egg top becomes
; active with a chance of one in sixteen on
; each frame. While it is active it is moved
; with gravity and makes a sound when it
; lands. Until then it hangs in the air.
;
; IX The address of the object
;
; Hang in the air until this egg is chosen to drop.
@label=HandleEggTop
c$AD13 CALL $B2A7     ; Call #R$B2A7.
 $AD16 CALL $BF47     ; Call #R$BF47.
 $AD19 LD A,($5B3B)   ; {Return if #R$5B3B is set.
 $AD1C AND A          ;
 $AD1D RET NZ         ; }
 $AD1E BIT 2,(IX+$0D) ; {Jump to #R$AD37 if this egg top is already active.
 $AD22 JR NZ,$AD37    ; }
 $AD24 LD HL,$5B3A    ; Point #REGhl at #R$5B3A.
 $AD27 LD A,(HL)      ; {Return if #R$5B3A is set.
 $AD28 AND A          ;
 $AD29 RET NZ         ; }
 $AD2A LD A,($5B05)   ; Fetch #R$5B05.
 $AD2D CP $10         ; {Return unless it is less than #N$10.
 $AD2F RET NC         ; }
 $AD30 SET 2,(IX+$0D) ; Set bit 2 of the state.
 $AD34 LD (HL),$01    ; Write #N$01 to #R$5B3A.
 $AD36 RET            ; Return.
; The egg top is active, so let it fall.
@label=HandleEggTop_MoveActive
*$AD37 CALL $BFB6     ; Call #R$BFB6.
 $AD3A CALL $AD54     ; Call #R$AD54.
 $AD3D BIT 2,(IX+$0C) ; {Jump to #R$AD49 if it has landed.
 $AD41 JR NZ,$AD49    ; }
 $AD43 CALL $B63C     ; Call #R$B63C.
@label=HandleEggTop_Redraw
*$AD46 JP $BFAB       ; Jump to #R$BFAB.
; The egg top has landed, so another one may drop.
@label=HandleEggTop_Landed
*$AD49 RES 2,(IX+$0D) ; Reset bit 2 of the state.
 $AD4D LD HL,$5B3A    ; Point #REGhl at #R$5B3A.
 $AD50 LD (HL),$00    ; Write #N$00 to #R$5B3A.
 $AD52 JR $AD46       ; Jump to #R$AD46.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$B7A9 }
; LIST#

; Play Landing Sound Once
;
; Used by the routine at #R$AD13.
; .
; Plays a random noise when the
; object has just landed, which is when bit 2
; of its collision flags is set and was not
; set the last time. The last state is kept
; at offset #N$0F of the object.
;
; IX The address of the object
;
; Play a noise only on the first landed frame.
@label=PlayLandingSoundOnce
c$AD54 LD A,(IX+$0C) ; Fetch the collision flags.
 $AD57 AND %00000100 ; Keep bit 2.
 $AD59 LD C,A        ; Keep it in #REGc.
 $AD5A RET Z         ; Return if the object has not landed.
 $AD5B LD A,(IX+$0F) ; Fetch the state recorded last time.
 $AD5E CP C          ; Compare it with the current state.
 $AD5F LD (IX+$0F),C ; Record the current state.
 $AD62 CALL NZ,$B676 ; Call #R$B676 if the state has changed.
 $AD65 RET           ; Return.

; Update Light Years
;
; Used by the routine at #R$A68B.
; .
; Counts the light years down, prints
; the four digits in the counter box, inverts
; the last of them and copies the counter to
; the screen. When all of the digits and
; their animation steps are zero the game is
; over. The light years go down by one every
; eight frames.
;
; .
;
; Print the four digits into the buffer.
@label=UpdateLightYears
c$AD66 CALL $ADC9    ; Call #R$ADC9.
 $AD69 CALL $ADE5    ; Call #R$ADE5.
 $AD6C LD HL,$D4FA   ; Point #REGhl at #R$D4FA.
 $AD6F LD DE,$5B36   ; Point #REGde at #R$5B36.
 $AD72 LD B,$04      ; Set a counter of four digits.
 $AD74 PUSH HL       ; Stash the buffer address on the stack.
 $AD75 LD HL,$6308   ; Point #REGhl at #R$6308.
 $AD78 LD ($5B27),HL ; Set #R$5B27.
 $AD7B POP HL        ; Restore the buffer address from the stack.
@label=UpdateLightYears_PrintDigit
*$AD7C LD A,(DE)     ; Fetch the digit and its animation step.
 $AD7D INC DE        ; Move on to the next digit.
 $AD7E CALL $ADB0    ; Call #R$ADB0.
 $AD81 DJNZ $AD7C    ; Jump to #R$AD7C until all four digits have been printed.
; Invert the last digit and copy the counter to the screen.
 $AD83 LD HL,$D41D   ; Point #REGhl at #R$D41D.
 $AD86 LD B,$08      ; Set a counter of eight pixel rows.
 $AD88 LD DE,$0020   ; Set #REGde to #N($0020,$04,$04).
@label=UpdateLightYears_InvertRow
*$AD8B LD A,(HL)     ; Fetch a row of the last digit.
 $AD8C CPL           ; Invert it.
 $AD8D LD (HL),A     ; Store it.
 $AD8E ADD HL,DE     ; Move up to the next row.
 $AD8F DJNZ $AD8B    ; Jump to #R$AD8B until all eight rows have been inverted.
 $AD91 LD BC,$10D0   ; Set the pixel position to #N($D0), #N$10.
 $AD94 CALL $D135    ; Call #R$D135.
 $AD97 CALL $D120    ; Call #R$D120.
 $AD9A LD L,C        ; {Copy the buffer address to #REGhl.
 $AD9B LD H,B        ; }
 $AD9C LD BC,$0804   ; Set the size to eight rows of four bytes.
 $AD9F CALL $CF85    ; Call #R$CF85.
; End the game if every digit is zero.
 $ADA2 LD HL,$5B36   ; Point #REGhl at #R$5B36.
 $ADA5 LD B,$04      ; Set a counter of four digits.
 $ADA7 XOR A         ; Set #REGa to #N$00.
@label=UpdateLightYears_TestDigit
*$ADA8 OR (HL)       ; Combine the digit with the others.
 $ADA9 INC HL        ; Move on to the next digit.
 $ADAA DJNZ $ADA8    ; Jump to #R$ADA8 until all four have been combined.
 $ADAC JP Z,$B761    ; Jump to #R$B761 if all of the digits are zero.
 $ADAF RET           ; Return.

; Print Counter Digit
;
; Used by the routine at #R$AD66.
; .
; Prints one digit of the light years
; counter. The upper four bits of the byte
; hold the digit and the lower three bits are
; an animation step. The glyph is taken from
; the font that number of rows later than the
; start of the glyph, so that the digit
; scrolls up like an odometer as it changes.
;
;   A Digit and animation step
;   HL Address in the screen buffer
; O:HL Address of the next character
;
; Find the glyph and print it.
@label=PrintCounterDigit
c$ADB0 PUSH BC       ; {Stash the registers on the stack.
 $ADB1 PUSH DE       ;
 $ADB2 PUSH HL       ; }
 $ADB3 LD L,A        ; Copy the digit and step to #REGl.
 $ADB4 SRL L         ; {Divide it by sixteen.
 $ADB6 SRL L         ;
 $ADB8 SRL L         ;
 $ADBA SRL L         ; }
 $ADBC LD H,$00      ; Set #REGh to #N$00.
 $ADBE ADD HL,HL     ; {Multiply the digit by eight.
 $ADBF ADD HL,HL     ;
 $ADC0 ADD HL,HL     ; }
 $ADC1 AND %00001111 ; Keep bits 0 to 3.
 $ADC3 CALL $CE06    ; Call #R$CE06.
 $ADC6 JP $BBFA      ; Jump to #R$BBFA.

; Decrement Light Years
;
; Used by the routine at #R$AD66.
; .
; Subtracts one from #R$5B36 when the
; animation step of its last digit has
; reached zero. A digit which is already
; zero becomes nine, with the next digit up
; borrowed from.
;
; .
;
; See #POKE(infinite_light_years,Infinite Light Years).
@label=DecrementLightYears
c$ADC9 LD HL,$5B39   ; Point #REGhl at #R$5B39.
 $ADCC LD B,$04      ; Set a counter of four digits.
 $ADCE LD A,(HL)     ; Fetch the digit and its animation step.
 $ADCF AND %00000111 ; Keep bits 0 to 2.
 $ADD1 RET NZ        ; Return if the digit is still rolling.
@label=DecrementLightYears_SubtractFromDigit
*$ADD2 LD A,(HL)     ; Fetch the digit and its animation step.
 $ADD3 LD C,A        ; Keep it in #REGc.
 $ADD4 AND %11110000 ; Keep bits 4 to 7.
 $ADD6 JR Z,$ADDE    ; Jump to #R$ADDE if the digit is zero.
 $ADD8 SUB $10       ; Subtract #N$10.
 $ADDA OR %00000111  ; Set bits 0 to 2.
 $ADDC LD (HL),A     ; Store the digit and its step.
 $ADDD RET           ; Return.
@label=DecrementLightYears_Borrow
*$ADDE LD A,$97      ; Set the digit to #N$97.
 $ADE0 LD (HL),A     ; Store it.
 $ADE1 DEC HL        ; Move on to the next digit up.
 $ADE2 DJNZ $ADD2    ; Jump to #R$ADD2.
 $ADE4 RET           ; Return.

; Roll Counter Digits
;
; Used by the routine at #R$AD66.
; .
; Reduces the animation steps of the
; digits of #R$5B36 that are rolling,
; starting with the last digit. It stops at
; the first digit which is not rolling.
;
; .
;
; Roll from the last digit upwards.
@label=RollCounterDigits
c$ADE5 LD HL,$5B39   ; Point #REGhl at #R$5B39.
 $ADE8 LD B,$04      ; Set a counter of four digits.
@label=RollCounterDigits_RollDigit
*$ADEA LD A,(HL)     ; Fetch the digit and its animation step.
 $ADEB AND %00000111 ; Keep bits 0 to 2.
 $ADED RET Z         ; Return if the digit is not rolling.
 $ADEE DEC (HL)      ; Reduce the animation step.
 $ADEF DEC HL        ; Move on to the next digit up.
 $ADF0 DJNZ $ADEA    ; Jump to #R$ADEA until all four digits have been done.
 $ADF2 RET           ; Return.

; Set Wipe And Draw Flags For Object
;
; Used by the routine at #R$BD6B.
; .
; Marks the object at #REGiy to be
; wiped and redrawn, preserving #REGix and
; #REGiy.
;
; IY The address of the object
;
; Call #R$BFAB for the object at #REGiy.
@label=SetWipeAndDrawFlagsForObject
c$ADF3 PUSH IY       ; {Stash #REGiy and #REGix on the stack.
 $ADF5 PUSH IX       ; }
 $ADF7 PUSH IY       ; {Copy #REGiy to #REGix (using the stack).
 $ADF9 POP IX        ; }
 $ADFB CALL $BFAB    ; Call #R$BFAB.
 $ADFE POP IX        ; {Restore #REGix and #REGiy from the stack.
 $AE00 POP IY        ; }
 $AE02 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$C69D }
; { #PENTAGRAM$BF56 }
; LIST#

; Find Object
;
; Used by the routine at #R$AF79.
; .
; Searches the objects of the room
; for one whose sprite number is in a range.
;
;   H Number of sprite numbers in the range
;   L First sprite number in the range
; O:IY The address of the object, if one was found
; O:F Carry flag set if an object was found
;
; Test each room object.
@label=FindObject
c$AE03 LD IY,$5C08   ; Point #REGiy at #R$5C08.
 $AE07 LD DE,$0020   ; Set #REGde to #N($0020,$04,$04).
 $AE0A LD B,$34      ; Set a counter of #N$34.
@label=FindObject_TestObject
*$AE0C LD A,(IY+$00) ; Fetch the sprite number.
 $AE0F SUB L         ; Subtract the first sprite number in the range.
 $AE10 CP H          ; Compare it with the number of sprite numbers.
 $AE11 RET C         ; Return if the object is in the range.
 $AE12 ADD IY,DE     ; Move on to the next object.
 $AE14 DJNZ $AE0C    ; Jump to #R$AE0C until all of the objects have been
                     ; tested.
 $AE16 RET           ; Return.

; Handle Valve Ghost
;
; The handler for the ghost of a
; valve (objects #N$68 to #N$6B). It hovers
; over the socket which comes before it in
; the table of objects, and is created by
; #R$AE68. It retires itself if there are
; special objects in the room. It stays for a
; couple of frames in #REGix+#N($10), then
; changes into its sparkle form (see
; #R$AE33).
;
; IX The address of the object
;
; Hover over the socket, then become a sparkle.
@label=HandleValveGhost
c$AE17 CALL $BF60     ; Call #R$BF60.
 $AE1A CALL $AE81     ; Call #R$AE81.
 $AE1D JP NZ,$B3BB    ; Jump to #R$B3BB if there are special objects in the
                      ; room.
 $AE20 LD A,(IX-$1D)  ; Fetch the height of the socket.
 $AE23 ADD A,$0D      ; Add #N$0D.
 $AE25 LD (IX+$03),A  ; Set the height of the ghost.
 $AE28 DEC (IX+$10)   ; {Return if there are frames left.
 $AE2B RET NZ         ; }
 $AE2C SET 2,(IX+$00) ; Set bit 2 of the sprite number.
 $AE30 JP $BFAB       ; Jump to #R$BFAB.

; Handle Valve Ghost Sparkle
;
; The handler for the sparkles shown
; between appearances of the valve ghost
; (objects #N$6C to #N$6F). They hover over
; the socket in the same way as the ghost
; (see #R$AE17). The sparkle steps through
; the four shapes, and when it matches the
; socket it changes back into the ghost.
;
; IX The address of the object
;
; Hover over the socket and step the shape.
@label=HandleValveGhostSparkle
c$AE33 CALL $BF60      ; Call #R$BF60.
 $AE36 CALL $AE81      ; Call #R$AE81.
 $AE39 JP NZ,$B3BB     ; Jump to #R$B3BB if there are special objects in the
                       ; room.
 $AE3C LD A,(IX-$1D)   ; Fetch the height of the socket.
 $AE3F ADD A,$0D       ; Add #N$0D.
 $AE41 LD (IX+$03),A   ; Set the height of the sparkle.
 $AE44 CALL $B18C      ; Call #R$B18C.
 $AE47 AND %00000011   ; Keep bits 0 and 1.
 $AE49 LD C,A          ; Keep it in #REGc.
 $AE4A LD A,(IX-$20)   ; Fetch the sprite number of the socket.
 $AE4D AND %00000011   ; Keep bits 0 and 1.
 $AE4F CP C            ; {Jump to #R$AE5A if the shapes are different.
 $AE50 JR NZ,$AE5A     ; }
 $AE52 RES 2,(IX+$00)  ; Reset bit 2 of the sprite number.
 $AE56 LD (IX+$10),$02 ; Write #N$02 to the frame count.
@label=HandleValveGhostSparkle_Redraw
*$AE5A JP $BFAB        ; Jump to #R$BFAB.

; Handle Placed Valve
;
; The handler for a valve which has
; been placed on a socket (objects #N$64 to
; #N$67). It stays where it is.
;
; IX The address of the object
;
; Stop the valve moving.
@label=HandlePlacedValve
c$AE5D CALL $BF60    ; Call #R$BF60.
 $AE60 XOR A         ; Set #REGa to #N$00.
 $AE61 LD (IX+$09),A ; Stop the speed along the x axis.
 $AE64 LD (IX+$0A),A ; Stop the speed along the y axis.
 $AE67 RET           ; Return.

; Handle Socket
;
; The handler for the sockets
; (objects #N$70 to #N$73). When there are no
; special objects in the room and the next
; object slot is free, it creates the
; sparkle form of the ghost of the valve
; which fits the socket (see #R$AE33).
;
; IX The address of the object
;
; Create a sparkle in the next object slot.
@label=HandleSocket
c$AE68 CALL $BF4C    ; Call #R$BF4C.
 $AE6B CALL $AE81    ; {Return if there are special objects in the room.
 $AE6E RET NZ        ; }
 $AE6F LD A,(IX+$20) ; Fetch the sprite number of the next object.
 $AE72 AND A         ; {Return if the next object slot is in use.
 $AE73 RET NZ        ; }
 $AE74 LD A,(IX+$00) ; Fetch the sprite number of the socket.
 $AE77 AND %00000011 ; Keep bits 0 and 1.
 $AE79 OR %01101100  ; Make it a sparkle of that shape.
 $AE7B LD (IX+$20),A ; Set the sprite number of the next object.
 $AE7E JP $AE8A      ; Jump to #R$AE8A.

; Test Valves In Play
;
; Used by the routines at #R$AE17, #R$AE33 and #R$AE68.
; .
; Tests whether either of the two
; slots for special objects is in use. They
; hold the valves and extra lives which are
; in the room.
;
; O:F Zero flag set if both slots are empty
;
; Combine the two special object slots.
@label=TestValvesInPlay
c$AE81 LD A,($5BC8)  ; Fetch #R$5BC8.
 $AE84 LD C,A        ; Keep it in #REGc.
 $AE85 LD A,($5BE8)  ; Fetch #R$5BC8(#N$5BE8).
 $AE88 OR C          ; Combine it with the first.
 $AE89 RET           ; Return.

; Calculate Pixel Position Of Other Object
;
; Used by the routines at #R$AE68 and #R$BD6B.
; .
; Works out the pixel position of the
; object at #REGiy by calling #R$CFD2 with
; #REGix pointing at it. Neither #REGix nor
; #REGiy is changed.
;
; IY The address of the object
;
; Call #R$CFD2 for the object at #REGiy.
@label=CalculatePixelPositionOfOtherObject
c$AE8A PUSH IX       ; Stash #REGix on the stack.
 $AE8C PUSH IY       ; {Copy #REGiy to #REGix (using the stack).
 $AE8E POP IX        ; }
 $AE90 CALL $CFD2    ; Call #R$CFD2.
 $AE93 POP IX        ; Restore #REGix from the stack.
 $AE95 RET           ; Return.

; Handle Cryonaut
;
; The handler for a cryonaut looking
; out of a chamber (object #N$4A). It only
; sets the pixel offsets used to draw it.
;
; IX The address of the object
;
; Set the pixel offsets.
@label=HandleCryonaut
c$AE96 JP $BF6A      ; Jump to #R$BF6A.

; Place Special Objects In Room
;
; Used by the routine at #R$CAA2.
; .
; Copies each of the special objects
; at #R$76E3 which is in the room of the
; object at #REGix into the slots from
; #R$5BC8, then clears the slots which are
; left over (up to #R$5C08). The address of
; the entry is kept in the new object so that
; #R$AF05 can copy its position back. Each
; special object is given a width and depth
; of #N($05), a height of #N$0C and flags of
; #N$14.
;
; IX The address of the player
;
; Copy each special object that is in this room.
@label=PlaceSpecialObjectsInRoom
c$AE99 LD DE,$5BC8   ; Point #REGde at #R$5BC8.
 $AE9C EXX           ; Switch to the shadow registers.
 $AE9D LD IY,$76E3   ; Point #REGiy at #R$76E3.
 $AEA1 LD B,(IX+$08) ; Fetch the room number into the high byte of #REGbc'.
@label=PlaceSpecialObjectsInRoom_TestEntry
*$AEA4 LD A,(IY+$00) ; Fetch the special object number.
 $AEA7 AND A         ; {Jump to #R$AEE6 if the entry is not in use.
 $AEA8 JR Z,$AEE6    ; }
 $AEAA LD A,(IY+$08) ; Fetch the room of the special object.
 $AEAD CP B          ; {Jump to #R$AEE6 if it is not this room.
 $AEAE JR NZ,$AEE6   ; }
 $AEB0 PUSH IY       ; Stash the entry address on the stack.
 $AEB2 EXX           ; Switch back to the main registers.
 $AEB3 POP HL        ; Restore the entry address from the stack.
 $AEB4 PUSH HL       ; Stash it on the stack again.
 $AEB5 LD A,(HL)     ; {Copy the object number to the slot.
 $AEB6 INC HL        ;
 $AEB7 LD (DE),A     ;
 $AEB8 INC DE        ; }
 $AEB9 INC HL        ; {Skip to the current position.
 $AEBA INC HL        ;
 $AEBB INC HL        ;
 $AEBC INC HL        ; }
 $AEBD LD BC,$0003   ; Set #REGbc to #N($0003,$04,$04).
 $AEC0 LDIR          ; Copy the x, y and z coordinates to the slot.
 $AEC2 EX DE,HL      ; Point #REGhl at the slot and #REGde at the room.
 $AEC3 LD (HL),$05   ; {Write #N$05 as the width.
 $AEC5 INC HL        ; }
 $AEC6 LD (HL),$05   ; {Write #N$05 as the depth.
 $AEC8 INC HL        ; }
 $AEC9 LD (HL),$0C   ; {Write #N$0C as the height.
 $AECB INC HL        ; }
 $AECC LD (HL),$14   ; Write #N$14 as the flags.
 $AECE INC HL        ; Move on to the room.
 $AECF EX DE,HL      ; Point #REGhl at the entry and #REGde at the slot.
 $AED0 LD A,(HL)     ; {Copy the room to the slot.
 $AED1 INC HL        ;
 $AED2 LD (DE),A     ;
 $AED3 INC DE        ; }
 $AED4 LD B,$07      ; Set a counter of seven.
 $AED6 CALL $CE1C    ; Call #R$CE1C.
 $AED9 POP BC        ; Restore the entry address from the stack.
 $AEDA LD A,C        ; {Store the low byte of the address in the slot.
 $AEDB LD (DE),A     ;
 $AEDC INC DE        ; }
 $AEDD LD A,B        ; {Store the high byte of the address in the slot.
 $AEDE LD (DE),A     ;
 $AEDF INC DE        ; }
 $AEE0 LD B,$0E      ; Set a counter of #N$0E.
 $AEE2 CALL $CE1C    ; Call #R$CE1C.
 $AEE5 EXX           ; Switch to the shadow registers.
@label=PlaceSpecialObjectsInRoom_NextEntry
*$AEE6 LD DE,$0009   ; Set #REGde to #N($0009,$04,$04).
 $AEE9 ADD IY,DE     ; Move on to the next entry.
 $AEEB PUSH IY       ; {Copy #REGiy to #REGhl (using the stack).
 $AEED POP HL        ; }
 $AEEE LD DE,$7827   ; Point #REGde at #R$7827.
 $AEF1 AND A         ; {Subtract #R$7827 from #REGhl.
 $AEF2 SBC HL,DE     ; }
 $AEF4 JR C,$AEA4    ; Jump to #R$AEA4 if there are more entries.
 $AEF6 EXX           ; Switch back to the main registers.
; Clear any slots that were not filled.
@label=PlaceSpecialObjectsInRoom_ClearSlots
*$AEF7 LD HL,$5C08   ; Point #REGhl at #R$5C08.
 $AEFA AND A         ; {Subtract the next slot from #REGhl.
 $AEFB SBC HL,DE     ; }
 $AEFD RET Z         ; Return if all of the slots have been done.
 $AEFE LD B,$20      ; Set a counter of #N$20.
 $AF00 CALL $CE1C    ; Call #R$CE1C.
 $AF03 JR $AEF7      ; Jump to #R$AEF7.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$C525 }
; LIST#

; Update Special Objects
;
; Used by the routines at #R$B761 and #R$CAA2.
; .
; Copies the number, position and
; room of each valve in #R$5BC8 back to its
; entry in #R$76E3, so that they are
; remembered when the player leaves the room.
; Other special objects, such as extra lives,
; are not copied.
;
; .
;
; Copy each valve back to the table.
@label=UpdateSpecialObjects
c$AF05 LD IY,$5BC8   ; Point #REGiy at #R$5BC8.
@label=UpdateSpecialObjects_TestSlot
*$AF09 LD A,(IY+$00) ; Fetch the object number.
 $AF0C SUB $60       ; Subtract #N$60.
 $AF0E CP $08        ; {Jump to #R$AF2E unless the object is a valve.
 $AF10 JR NC,$AF2E   ; }
 $AF12 LD E,(IY+$10) ; Fetch the low byte of the entry address.
 $AF15 LD D,(IY+$11) ; Fetch the high byte of the entry address.
 $AF18 LD A,(IY+$00) ; Fetch the object number.
 $AF1B LD (DE),A     ; Store it in the entry.
 $AF1C INC DE        ; {Move on to the current x position.
 $AF1D INC DE        ;
 $AF1E INC DE        ;
 $AF1F INC DE        ;
 $AF20 INC DE        ; }
 $AF21 PUSH IY       ; {Copy #REGiy to #REGhl (using the stack).
 $AF23 POP HL        ; }
 $AF24 INC HL        ; Move on to the x position of the object.
 $AF25 LD BC,$0003   ; Set #REGbc to #N($0003,$04,$04).
 $AF28 LDIR          ; Copy the x, y and z coordinates to the entry.
 $AF2A LD A,(IY+$08) ; Fetch the room.
 $AF2D LD (DE),A     ; Store it in the entry.
@label=UpdateSpecialObjects_NextSlot
*$AF2E LD BC,$0020   ; Set #REGbc to #N($0020,$04,$04).
 $AF31 ADD IY,BC     ; Move on to the next slot.
 $AF33 PUSH IY       ; {Copy #REGiy to #REGhl (using the stack).
 $AF35 POP HL        ; }
 $AF36 LD BC,$5C08   ; Point #REGbc at #R$5C08.
 $AF39 AND A         ; {Subtract #R$5C08 from #REGhl.
 $AF3A SBC HL,BC     ; }
 $AF3C JR C,$AF09    ; Jump to #R$AF09 if there are more slots.
 $AF3E RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$C591 }
; LIST#

; Initialise Special Objects
;
; Used by the routine at #R$A650.
; .
; Chooses the objects in #R$76E3 at
; the start of a game. Each is given a random
; shape of valve (#N$60 to #N$63), except
; that every sixteenth entry, counting from a
; number taken from the random number seed,
; is an extra life (object #N$0C). The
; starting position of each entry is copied
; to the current position.
;
; .
;
; Stir the seeds and fill the table.
@label=InitialiseSpecialObjects
c$AF3F LD HL,$76E3   ; Point #REGhl at #R$76E3.
 $AF42 LD A,($5B00)  ; Fetch #R$5B00.
 $AF45 LD E,A        ; Keep it in #REGe.
 $AF46 LD A,R        ; Fetch the refresh register.
 $AF48 ADD A,E       ; Add the seed to it.
 $AF49 LD E,A        ; Keep the result in #REGe.
 $AF4A LD A,($5B05)  ; Fetch #R$5B05.
 $AF4D LD D,A        ; Keep it in #REGd.
@label=InitialiseSpecialObjects_NextEntry
*$AF4E DEC D         ; Count down.
 $AF4F LD A,D        ; Copy the counter to #REGa.
 $AF50 AND %00001111 ; Keep bits 0 to 3.
 $AF52 JR Z,$AF75    ; Jump to #R$AF75 if every sixteenth entry has been
                     ; reached.
 $AF54 LD A,E        ; Fetch the random number.
 $AF55 AND %00000011 ; Keep bits 0 and 1.
 $AF57 OR %01100000  ; Make it a valve.
@label=InitialiseSpecialObjects_StoreNumber
*$AF59 LD (HL),A     ; Store the object number.
 $AF5A INC HL        ; Move on to the starting position.
 $AF5B INC E         ; Change the random number.
 $AF5C PUSH DE       ; Stash the counter and the random number on the stack.
 $AF5D EX DE,HL      ; Swap the entry pointer into #REGde.
 $AF5E LD HL,$0004   ; Set #REGhl to #N($0004,$04,$04).
 $AF61 ADD HL,DE     ; Add it to the starting position.
 $AF62 EX DE,HL      ; Swap the pointers back.
 $AF63 LD BC,$0004   ; Set #REGbc to #N($0004,$04,$04).
 $AF66 LDIR          ; Copy the starting position and room.
 $AF68 EX DE,HL      ; Point #REGhl at the next entry.
 $AF69 PUSH HL       ; Stash the next entry on the stack.
 $AF6A LD BC,$7827   ; Point #REGbc at #R$7827.
 $AF6D AND A         ; {Subtract #R$7827 from #REGhl.
 $AF6E SBC HL,BC     ; }
 $AF70 POP HL        ; Restore the next entry from the stack.
 $AF71 POP DE        ; Restore the counter and the random number from the
                     ; stack.
 $AF72 JR C,$AF4E    ; Jump to #R$AF4E if there are more entries.
 $AF74 RET           ; Return.
@label=InitialiseSpecialObjects_ExtraLife
*$AF75 LD A,$0C      ; Set the object number to #N$0C.
 $AF77 JR $AF59      ; Jump to #R$AF59.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$C47E }
; LIST#

; Handle Valve
;
; The handler for a valve lying about
; in a room (objects #N$60 to #N$63). If the
; room has a socket of the same shape the
; valve moves towards it one step at a time
; along the x and y axes, and is pulled down
; by gravity. When it sits on the socket it
; is placed: the object number goes up by
; four (#N$64 to #N$67), the screen colours
; cycle sixteen times with a sparkle, the
; chamber ink is set to white, and one is
; added to #R$5B40. If that makes #N$24 the
; game is completed.
; .
; A valve which is not on its way to a
; socket is just moved with gravity, and
; stopped and redrawn if it has been dropped.
;
; IX The address of the object
;
; Look for a matching socket.
@label=HandleValve
c$AF79 CALL $BF60      ; Call #R$BF60.
 $AF7C LD HL,$0470     ; Set #REGhl to #N$0470.
 $AF7F CALL $AE03      ; Call #R$AE03.
 $AF82 JR NC,$AFD0     ; Jump to #R$AFD0 if there is no socket.
 $AF84 LD A,(IY+$00)   ; Fetch the sprite number of the socket.
 $AF87 AND %00000011   ; Keep bits 0 and 1.
 $AF89 LD C,A          ; Keep it in #REGc.
 $AF8A LD A,(IX+$00)   ; Fetch the object number of the valve.
 $AF8D AND %00000011   ; Keep bits 0 and 1.
 $AF8F CP C            ; {Jump to #R$AFD0 if the shapes are different.
 $AF90 JR NZ,$AFD0     ; }
; Set the speed towards the socket.
 $AF92 LD A,(IX+$01)   ; {Subtract the socket x from the valve x.
 $AF95 SUB (IY+$01)    ; }
 $AF98 JR Z,$AFA1      ; Jump to #R$AFA1 if they are the same.
 $AF9A LD A,$01        ; Set the speed to #N$01.
 $AF9C JP M,$AFA1      ; Jump to #R$AFA1 if the valve is west of the socket.
 $AF9F NEG             ; Make the speed negative.
@label=HandleValve_SetSpeedX
*$AFA1 LD (IX+$09),A   ; Set the speed along the x axis.
 $AFA4 LD A,(IX+$02)   ; {Subtract the socket y from the valve y.
 $AFA7 SUB (IY+$02)    ; }
 $AFAA JR Z,$AFB3      ; Jump to #R$AFB3 if they are the same.
 $AFAC LD A,$01        ; Set the speed to #N$01.
 $AFAE JP M,$AFB3      ; Jump to #R$AFB3 if the valve is south of the socket.
 $AFB1 NEG             ; Make the speed negative.
@label=HandleValve_SetSpeedY
*$AFB3 LD (IX+$0A),A   ; Set the speed along the y axis.
; Place the valve if it is on the socket.
 $AFB6 LD A,(IX+$01)   ; {Compare the x positions.
 $AFB9 CP (IY+$01)     ; }
 $AFBC JR NZ,$AFD0     ; Jump to #R$AFD0 if they differ.
 $AFBE LD A,(IX+$02)   ; {Compare the y positions.
 $AFC1 CP (IY+$02)     ; }
 $AFC4 JR NZ,$AFD0     ; Jump to #R$AFD0 if they differ.
 $AFC6 LD A,(IY+$03)   ; Fetch the height of the socket.
 $AFC9 ADD A,$0C       ; Add #N$0C.
 $AFCB CP (IX+$03)     ; Compare it with the height of the valve.
 $AFCE JR Z,$AFE7      ; Jump to #R$AFE7 if the valve is on the socket.
; Move the valve if it is not placed yet.
@label=HandleValve_Fall
*$AFD0 CALL $BFB6      ; Call #R$BFB6.
 $AFD3 BIT 0,(IX+$0D)  ; {Jump to #R$AFDD if the valve has been dropped.
 $AFD7 JR NZ,$AFDD     ; }
 $AFD9 CALL $BED6      ; {Return if the valve is not moving.
 $AFDC RET Z           ; }
@label=HandleValve_Dropped
*$AFDD RES 0,(IX+$0D)  ; Reset bit 0 of the state.
 $AFE1 CALL $C2EE      ; Call #R$C2EE.
 $AFE4 JP $B3BF        ; Jump to #R$B3BF.
; Place the valve on the socket.
@label=HandleValve_Arrived
*$AFE7 LD A,(IX+$00)   ; Fetch the object number of the valve.
 $AFEA XOR (IY+$00)    ; Combine it with that of the socket.
 $AFED AND %00000011   ; Keep bits 0 and 1.
 $AFEF JR Z,$AFF8      ; Jump to #R$AFF8 if the shapes are the same.
 $AFF1 LD (IX+$00),$40 ; Write #N$40 as the sprite number.
 $AFF5 JP $BFAB        ; Jump to #R$BFAB.
@label=HandleValve_PlaceValve
*$AFF8 LD A,(IX+$00)   ; Fetch the object number of the valve.
 $AFFB OR %00000100    ; Set bit 2.
 $AFFD LD (IX+$00),A   ; Store the object number.
 $B000 CALL $B3BF      ; Call #R$B3BF.
 $B003 LD D,$10        ; Set a counter of #N$10.
; Cycle the screen colours.
@label=HandleValve_CycleColours
*$B005 LD HL,$5800     ; Point #REGhl at #N$5800 (in the attribute buffer).
 $B008 LD BC,$0300     ; Set #REGbc to #N$0300.
@label=HandleValve_CycleAttribute
*$B00B LD A,(HL)       ; Fetch an attribute.
 $B00C AND %11111000   ; Keep bits 3 to 7.
 $B00E LD E,A          ; Keep it in #REGe.
 $B00F LD A,(HL)       ; {Fetch the attribute and add one.
 $B010 INC A           ; }
 $B011 AND %00000111   ; Keep bits 0 to 2.
 $B013 OR E            ; Combine it with the rest of the attribute.
 $B014 LD (HL),A       ; Store the new attribute.
 $B015 INC HL          ; Move on to the next attribute.
 $B016 DEC BC          ; Count down the attributes.
 $B017 LD A,B          ; {Jump to #R$B00B until all of them have been changed.
 $B018 OR C            ;
 $B019 JR NZ,$B00B     ; }
 $B01B CALL $B5EE      ; Call #R$B5EE.
 $B01E LD BC,$0200     ; Set #REGbc to #N$0200.
@label=HandleValve_Delay
*$B021 DEC BC          ; {Jump to #R$B021 until the delay is done.
 $B022 LD A,B          ;
 $B023 OR C            ;
 $B024 JR NZ,$B021     ; }
 $B026 DEC D           ; {Jump to #R$B005 until all of the colours have been
 $B027 JR NZ,$B005     ; cycled.}
 $B029 LD HL,($5B34)   ; Fetch #R$5B34.
 $B02C LD A,(HL)       ; Fetch the colour of the room.
 $B02D OR %00000111    ; Set bits 0 to 2.
 $B02F LD (HL),A       ; Store the colour of the chamber.
 $B030 AND %00000111   ; Keep bits 0 to 2.
 $B032 LD ($5B0D),A    ; Set #R$5B0D.
 $B035 CALL $A749      ; Call #R$A749.
 $B038 LD HL,$5B40     ; Point #REGhl at #R$5B40.
 $B03B LD A,(HL)       ; {Add one to #R$5B40.
 $B03C ADD A,$01       ;
 $B03E DAA             ;
 $B03F LD (HL),A       ; }
 $B040 CP $24          ; {Jump to #R$B04C unless it is #N$24.
 $B042 JR NZ,$B04C     ; }
 $B044 LD A,$01        ; {Write #N$01 to #R$5B23.
 $B046 LD ($5B23),A    ; }
 $B049 JP $B761        ; Jump to #R$B761.
@label=HandleValve_Finish
*$B04C CALL $A7A3      ; Call #R$A7A3.
 $B04F LD BC,$1820     ; Set the pixel position to #N($20), #N$18.
 $B052 JP $BF2F        ; Jump to #R$BF2F.

; Handle Mouse Second Part
;
; The handler for the second part of
; a robot mouse (object #N$0B). It takes its
; position from the first part, which comes
; before it in the table of objects, and sits
; #N$0C lower. When the first part is moving
; it makes a noise and is redrawn.
;
; IX The address of the object
;
; Follow the first part and redraw if it moves.
@label=HandleMouseSecondPart
c$B055 CALL $BF5B    ; Call #R$BF5B.
 $B058 CALL $B1E5    ; Call #R$B1E5.
 $B05B LD A,(IX-$17) ; {Return if the first part is not moving.
 $B05E OR (IX-$16)   ;
 $B061 OR (IX-$15)   ;
 $B064 RET Z         ; }
 $B065 CALL $B6C0    ; Call #R$B6C0.
 $B068 JP $BFAB      ; Jump to #R$BFAB.

; Handle Circuit Mouse
;
; The handler for the robot mice
; (objects #N$5E and #N$5F) which run in
; circuits. When a mouse is blocked, or is
; not moving, it makes a noise and turns a
; quarter turn one way or the other, chosen
; at random. Its speed is then set from the
; way it faces, and doubled.
;
; IX The address of the object
;
; Move, or turn if the mouse is blocked.
@label=HandleCircuitMouse
c$B06B CALL $BF5B    ; Call #R$BF5B.
 $B06E CALL $B1FA    ; Call #R$B1FA.
 $B071 LD A,(IX+$09) ; {Jump to #R$B08A if the mouse is not moving.
 $B074 OR (IX+$0A)   ;
 $B077 JR Z,$B08A    ; }
 $B079 CALL $BFB6    ; Call #R$BFB6.
 $B07C LD A,(IX+$0B) ; {Call #R$B63C if it is rising or falling.
 $B07F AND A         ;
 $B080 CALL NZ,$B63C ; }
 $B083 LD A,(IX+$0C) ; Fetch the collision flags.
 $B086 AND %00000011 ; Keep bits 0 and 1.
 $B088 JR Z,$B0A2    ; Jump to #R$B0A2 if the mouse has not been blocked.
@label=HandleCircuitMouse_Turn
*$B08A CALL $B619    ; Call #R$B619.
 $B08D LD A,($5B05)  ; Fetch #R$5B05.
 $B090 AND %00000001 ; Keep bit 0.
 $B092 JR Z,$B0A8    ; Jump to #R$B0A8 if it is zero.
 $B094 CALL $B0DD    ; Call #R$B0DD.
@label=HandleCircuitMouse_SetSpeed
*$B097 CALL $B0E7    ; Call #R$B0E7.
 $B09A SLA (IX+$09)  ; Double the speed along the x axis.
 $B09E SLA (IX+$0A)  ; Double the speed along the y axis.
@label=HandleCircuitMouse_Finish
*$B0A2 CALL $B20B    ; Call #R$B20B.
 $B0A5 JP $B2B0      ; Jump to #R$B2B0.
@label=HandleCircuitMouse_TurnOneWay
*$B0A8 CALL $B0AD    ; Call #R$B0AD.
 $B0AB JR $B097      ; Jump to #R$B097.

; Turn Mouse One Way
;
; Used by the routines at #R$B06B and #R$B0DD.
; .
; Turns a robot mouse a quarter turn.
; The way it faces is held in bit 0 of its
; sprite number and bit 6 of its flags. They
; go west, south, east, north: (bit 0, bit 6)
; = (#N($00), #N($00)), (#N($01), #N($01)),
; (#N($01), #N$00) and (#N($00), #N$01).
;
; IX The address of the object
;
; The mouse is facing west or north.
@label=TurnMouseOneWay
c$B0AD BIT 0,(IX+$00) ; {Jump to #R$B0C2 if bit 0 of the sprite number is set.
 $B0B1 JR NZ,$B0C2    ; }
 $B0B3 BIT 6,(IX+$07) ; {Jump to #R$B0CE if the sprite is flipped.
 $B0B7 JR NZ,$B0CE    ; }
 $B0B9 SET 0,(IX+$00) ; Set bit 0 of the sprite number.
@label=TurnMouseOneWay_Flip
*$B0BD SET 6,(IX+$07) ; Set bit 6 of the flags.
 $B0C1 RET            ; Return.
; The mouse is facing south or east.
@label=TurnMouseOneWay_BitSet
*$B0C2 BIT 6,(IX+$07) ; {Jump to #R$B0D7 if the sprite is flipped.
 $B0C6 JR NZ,$B0D7    ; }
 $B0C8 RES 0,(IX+$00) ; Reset bit 0 of the sprite number.
 $B0CC JR $B0BD       ; Jump to #R$B0BD.
; The mouse is facing north.
@label=TurnMouseOneWay_FlippedBitClear
*$B0CE RES 0,(IX+$00) ; Reset bit 0 of the sprite number.
@label=TurnMouseOneWay_Unflip
*$B0D2 RES 6,(IX+$07) ; Reset bit 6 of the flags.
 $B0D6 RET            ; Return.
; The mouse is facing south.
@label=TurnMouseOneWay_FlippedBitSet
*$B0D7 SET 0,(IX+$00) ; Set bit 0 of the sprite number.
 $B0DB JR $B0D2       ; Jump to #R$B0D2.

; Turn Mouse Other Way
;
; Used by the routine at #R$B06B.
; .
; Turns a robot mouse a quarter turn
; the other way round the cycle used by
; #R$B0AD.
;
; IX The address of the object
;
; Flip bit 0, then turn one way.
@label=TurnMouseOtherWay
c$B0DD LD A,(IX+$00) ; Fetch the sprite number.
 $B0E0 XOR %00000001 ; Flip bit 0.
 $B0E2 LD (IX+$00),A ; Store the sprite number.
 $B0E5 JR $B0AD      ; Jump to #R$B0AD.

; Set Mouse Speed
;
; Used by the routines at #R$B06B and #R$B110.
; .
; Sets the speed of a robot mouse
; along the x and y axes from the way it
; faces, using the table at #R$B108.
;
; IX The address of the object
;
; Build a direction index from the facing bits.
@label=SetMouseSpeed
c$B0E7 LD A,(IX+$07) ; Fetch the flags.
 $B0EA RLCA          ; {Move bit 6 to bit 1.
 $B0EB RLCA          ;
 $B0EC RLCA          ; }
 $B0ED AND %00000010 ; Keep bit 1.
 $B0EF LD B,A        ; Keep it in #REGb.
 $B0F0 LD A,(IX+$00) ; Fetch the sprite number.
 $B0F3 AND %00000001 ; Keep bit 0.
 $B0F5 OR B          ; Combine it with the flip flag.
 $B0F6 SLA A         ; Double it.
 $B0F8 LD HL,$B108   ; Point #REGhl at #R$B108.
 $B0FB CALL $CE06    ; Call #R$CE06.
 $B0FE LD A,(HL)     ; {Fetch the speed along the x axis.
 $B0FF INC HL        ; }
 $B100 LD (IX+$09),A ; Set the speed along the x axis.
 $B103 LD A,(HL)     ; Fetch the speed along the y axis.
 $B104 LD (IX+$0A),A ; Set the speed along the y axis.
 $B107 RET           ; Return.

; Mouse Speeds
;
; The speeds along the x and y axes
; given to a robot mouse for each of the
; directions it can face.
@label=MouseSpeeds
b$B108 DEFB $FF      ; {Facing west: dX=#N($FF), dY=#N$00
 $B109 DEFB $00      ; }
 $B10A DEFB $01      ; {Facing east: dX=#N($01), dY=#N$00
 $B10B DEFB $00      ; }
 $B10C DEFB $00      ; {Facing north: dX=#N($00), dY=#N$01
 $B10D DEFB $01      ; }
 $B10E DEFB $00      ; {Facing south: dX=#N($00), dY=#N$FF
 $B10F DEFB $FF      ; }

; Handle Bouncing Mouse
;
; The handler for the robot mice
; (objects #N$56 and #N$57) which run to and
; fro along one axis. A mouse which is not
; moving is given a speed from the way it
; faces, doubled. When it is blocked it
; reverses its speed, makes a noise and turns
; to face the other way.
;
; IX The address of the object
;
; Move along the x axis, and reverse if blocked.
@label=HandleBouncingMouse
c$B110 CALL $BF5B     ; Call #R$BF5B.
 $B113 CALL $B1FA     ; Call #R$B1FA.
@label=HandleBouncingMouse_Move
*$B116 LD A,(IX+$09)  ; Fetch the speed along the x axis.
 $B119 AND A          ; {Jump to #R$B13C if it is zero.
 $B11A JR Z,$B13C     ; }
 $B11C LD (IX+$10),A  ; Remember the speed.
 $B11F CALL $BFB6     ; Call #R$BFB6.
 $B122 BIT 0,(IX+$0C) ; {Jump to #R$B136 if the mouse has not been blocked
 $B126 JR Z,$B136     ; along the x axis.}
 $B128 LD A,(IX+$10)  ; Fetch the speed which was remembered.
 $B12B NEG            ; Make the speed negative.
 $B12D LD (IX+$09),A  ; Set the speed along the x axis.
@label=HandleBouncingMouse_Bounce
*$B130 CALL $B619     ; Call #R$B619.
 $B133 CALL $B1AE     ; Call #R$B1AE.
@label=HandleBouncingMouse_Finish
*$B136 CALL $B20B     ; Call #R$B20B.
 $B139 JP $B2B0       ; Jump to #R$B2B0.
; Move along the y axis, and reverse if blocked.
@label=HandleBouncingMouse_MoveAlongY
*$B13C LD A,(IX+$0A)  ; Fetch the speed along the y axis.
 $B13F AND A          ; {Jump to #R$B158 if it is zero.
 $B140 JR Z,$B158     ; }
 $B142 LD (IX+$10),A  ; Remember the speed.
 $B145 CALL $BFB6     ; Call #R$BFB6.
 $B148 BIT 1,(IX+$0C) ; {Jump to #R$B136 if the mouse has not been blocked
 $B14C JR Z,$B136     ; along the y axis.}
 $B14E LD A,(IX+$10)  ; Fetch the speed which was remembered.
 $B151 NEG            ; Make the speed negative.
 $B153 LD (IX+$0A),A  ; Set the speed along the y axis.
 $B156 JR $B130       ; Jump to #R$B130.
; The mouse is not moving.
@label=HandleBouncingMouse_StartMoving
*$B158 CALL $B0E7     ; Call #R$B0E7.
 $B15B SLA (IX+$09)   ; Double the speed along the x axis.
 $B15F SLA (IX+$0A)   ; Double the speed along the y axis.
 $B163 JR $B116       ; Jump to #R$B116.

; Set Speed Towards Player
;
; Used by the routines at #R$AA89 and #R$B19C.
; .
; Sets the speed of an object along
; the x and y axes so that it heads towards
; the player.
;
; B Speed along the y axis
; C Speed along the x axis
; IX The address of the object
;
; Head towards the player along each axis.
@label=SetSpeedTowardsPlayer
c$B165 LD HL,$5B89   ; Point #REGhl at #R$5B88(#N$5B89).
 $B168 LD A,(IX+$01) ; Fetch the x position of the object.
 $B16B SUB (HL)      ; Subtract the player's x position.
 $B16C INC HL        ; Move on to the y position.
 $B16D LD A,C        ; Fetch the speed along the x axis.
 $B16E JP M,$B173    ; Jump to #R$B173 if the object is west of the player.
 $B171 NEG           ; Make the speed negative.
@label=SetSpeedTowardsPlayer_SetX
*$B173 LD (IX+$09),A ; Set the speed along the x axis.
 $B176 LD A,(IX+$02) ; Fetch the y position of the object.
 $B179 SUB (HL)      ; Subtract the player's y position.
 $B17A INC HL        ; Move on.
 $B17B LD A,B        ; Fetch the speed along the y axis.
 $B17C JP M,$B181    ; Jump to #R$B181 if the object is south of the player.
 $B17F NEG           ; Make the speed negative.
@label=SetSpeedTowardsPlayer_SetY
*$B181 LD (IX+$0A),A ; Set the speed along the y axis.
 $B184 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$B965 }
; LIST#

; Toggle Sprite Number
;
; Used by the routines at #R$AA89 and #R$AAA1.
; .
; Flips the lowest bit of the sprite
; number of the object, to change the way it
; is facing or its animation frame.
;
; IX The address of the object
;
; Flip bit 0 and store the sprite number.
@label=ToggleSpriteNumber
c$B185 LD A,(IX+$00) ; Fetch the sprite number.
 $B188 XOR %00000001 ; Flip bit 0.
 $B18A JR $B198      ; Jump to #R$B198.

; Next Sprite Number
;
; Used by the routines at #R$A9C7, #R$AE33 and #R$B19C.
; .
; Steps on to the next of the four
; animation frames of the object, by adding
; one to the lowest two bits of its sprite
; number (wrapping from three to zero).
;
;   IX The address of the object
; O:A The new sprite number
;
; Keep the upper bits and step the frame.
@label=NextSpriteNumber
c$B18C LD A,(IX+$00) ; Fetch the sprite number.
 $B18F LD C,A        ; Keep it in #REGc.
 $B190 AND %11111100 ; Keep bits 2 to 7.
 $B192 LD B,A        ; Keep them in #REGb.
 $B193 LD A,C        ; {Fetch it again and add one.
 $B194 INC A         ; }
 $B195 AND %00000011 ; Keep bits 0 and 1.
 $B197 OR B          ; Combine them with the upper bits.
; This entry point is used by the routine at #R$B185.
@label=NextSpriteNumber_StoreSpriteNumber
*$B198 LD (IX+$00),A ; Store the sprite number.
 $B19B RET           ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$CCAE }
; { #KNIGHTLORE$B98C }
; { #NIGHTSHADE$CEF8 }
; LIST#

; Handle Homing Sparkle
;
; The handler for the sparkles which
; fly towards the player (objects #N$4C to
; #N$4F). They move at a speed of four along
; each axis and step through their four
; animation frames.
;
; IX The address of the object
;
; Head towards the player and redraw.
@label=HandleHomingSparkle
c$B19C CALL $BF6A    ; Call #R$BF6A.
 $B19F LD BC,$0404   ; Set the speed along each axis to #N$04.
 $B1A2 CALL $B165    ; Call #R$B165.
 $B1A5 CALL $BFB6    ; Call #R$BFB6.
 $B1A8 CALL $B18C    ; Call #R$B18C.
 $B1AB JP $B3BF      ; Jump to #R$B3BF.

; Face Direction Of Movement
;
; Used by the routine at #R$B110.
; .
; Sets the way a robot mouse faces to
; match the direction in which it is moving,
; if it is moving along one axis. The way it
; faces is held in bit 0 of its sprite number
; and bit 6 of its flags (see #R$B0AD).
;
; IX The address of the object
;
; Face along the axis with the larger speed.
@label=FaceDirectionOfMovement
c$B1AE LD A,(IX+$09)  ; {Return if the mouse is not moving.
 $B1B1 OR (IX+$0A)    ;
 $B1B4 RET Z          ; }
 $B1B5 LD A,(IX+$09)  ; Fetch the speed along the x axis.
 $B1B8 CP (IX+$0A)    ; {Jump to #R$B1D0 if the mouse is moving along the y
 $B1BB JR C,$B1D0     ; axis.}
 $B1BD BIT 7,A        ; {Jump to #R$B1CA if the mouse is moving west.
 $B1BF JR NZ,$B1CA    ; }
 $B1C1 SET 0,(IX+$00) ; Set bit 0 of the sprite number.
@label=FaceDirectionOfMovement_Unflip
*$B1C5 RES 6,(IX+$07) ; Reset bit 6 of the flags.
 $B1C9 RET            ; Return.
; The mouse is moving west.
@label=FaceDirectionOfMovement_West
*$B1CA RES 0,(IX+$00) ; Reset bit 0 of the sprite number.
 $B1CE JR $B1C5       ; Jump to #R$B1C5.
; The mouse is moving along the y axis.
@label=FaceDirectionOfMovement_MovingAlongY
*$B1D0 BIT 7,(IX+$0A) ; {Jump to #R$B1DF if the mouse is moving north.
 $B1D4 JR Z,$B1DF     ; }
 $B1D6 SET 0,(IX+$00) ; Set bit 0 of the sprite number.
@label=FaceDirectionOfMovement_Flip
*$B1DA SET 6,(IX+$07) ; Set bit 6 of the flags.
 $B1DE RET            ; Return.
; The mouse is moving north.
@label=FaceDirectionOfMovement_North
*$B1DF RES 0,(IX+$00) ; Reset bit 0 of the sprite number.
 $B1E3 JR $B1DA       ; Jump to #R$B1DA.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$B76C }
; LIST#

; Copy Previous Position
;
; Used by the routine at #R$B055.
; .
; Copies the position of the object
; before this one in the table to this
; object, with the height lowered by #N$0C.
;
; IX The address of the object
;
; Copy x, y and height from the previous object.
@label=CopyPreviousPosition
c$B1E5 LD A,(IX-$1F) ; Fetch the x position of the previous object.
 $B1E8 LD (IX+$01),A ; Set the x position of this object.
 $B1EB LD A,(IX-$1E) ; Fetch the y position of the previous object.
 $B1EE LD (IX+$02),A ; Set the y position of this object.
 $B1F1 LD A,(IX-$1D) ; Fetch the height of the previous object.
 $B1F4 SUB $0C       ; Subtract #N$0C.
 $B1F6 LD (IX+$03),A ; Set the height of this object.
 $B1F9 RET           ; Return.

; Extend Object Downwards
;
; Used by the routines at #R$B06B and #R$B110.
; .
; Lowers the object by #N$0C and
; doubles its height, so that it covers both
; parts of a robot mouse. It also sets bit 1
; of the flags of the next object, so that
; collision tests ignore it. #R$B20B undoes
; this.
;
; IX The address of the object
;
; Cover both parts of the mouse.
@label=ExtendObjectDownwards
c$B1FA LD A,(IX+$03)  ; Fetch the height of the object.
 $B1FD SUB $0C        ; Subtract #N$0C.
 $B1FF LD (IX+$03),A  ; Set the height of the object.
 $B202 SLA (IX+$06)   ; Double the height of the object.
 $B206 SET 1,(IX+$27) ; Set bit 1 of the next object's flags.
 $B20A RET            ; Return.

; Restore Object Height
;
; Used by the routines at #R$B06B and #R$B110.
; .
; Undoes #R$B1FA by raising the
; object by #N$0C and halving its height.
;
; IX The address of the object
;
; Restore the height and the next object's flags.
@label=RestoreObjectHeight
c$B20B LD A,(IX+$03)  ; Fetch the height of the object.
 $B20E ADD A,$0C      ; Add #N$0C.
 $B210 LD (IX+$03),A  ; Set the height of the object.
 $B213 SRL (IX+$06)   ; Halve the height of the object.
 $B217 RES 1,(IX+$27) ; Reset bit 1 of the next object's flags.
 $B21B RET            ; Return.

; Handle Block Moving North South
;
; The handler for a block which
; moves north and south (object #N$43). It
; chooses the y axis and joins #R$B224.
;
; IX The address of the object
;
; Choose the y axis.
@label=HandleBlockMovingNorthSouth
c$B21C CALL $B64F    ; Call #R$B64F.
 $B21F LD HL,$020A   ; Set #REGhl to #N$020A.
 $B222 JR $B22A      ; Jump to #R$B22A.

; Handle Block Moving East West
;
; The handler for a block which
; moves east and west (object #N$42), and the
; code shared with #R$B21C. The block follows
; a target that swings over #N$20 frames from
; #R$5B02. Neighbouring blocks are out of
; step because the low byte of the object
; address is added in. It moves by #N$01 each
; frame, with gravity cancelled out.
; .
; The axis is chosen by changing the
; operands of #R$B249 and #R$B25A.
;
; IX The address of the object
;
; Choose the x axis.
@label=HandleBlockMovingEastWest
c$B224 CALL $B64A      ; Call #R$B64A.
 $B227 LD HL,$0109     ; Set #REGhl to #N$0109.
; This entry point is used by the routine at #R$B21C.
; .
; Change the later instructions to use the chosen axis.
@label=HandleBlockMoving
*$B22A LD A,H          ; {Write #REGh to #R$B249(#N$B24B).
 $B22B LD ($B24B),A    ; }
 $B22E LD A,L          ; {Write #REGl to #R$B25A(#N$B25C).
 $B22F LD ($B25C),A    ; }
 $B232 CALL $BF3D      ; Call #R$BF3D.
; Work out a target from #N$00 to #N$0F.
 $B235 PUSH IX         ; {Copy #REGix to #REGbc (using the stack).
 $B237 POP BC          ; }
 $B238 LD A,C          ; {Fetch the low byte and move bit 5 to bit 4.
 $B239 RRCA            ; }
 $B23A AND %00010000   ; Keep bit 4.
 $B23C LD C,A          ; Keep it in #REGc.
 $B23D LD A,($5B02)    ; Fetch #R$5B02.
 $B240 ADD A,C         ; Add the difference between neighbouring objects.
 $B241 BIT 4,A         ; {Jump to #R$B246 if bit 4 is clear.
 $B243 JR Z,$B246      ; }
 $B245 CPL             ; Invert it.
@label=HandleBlockMoving_Target
*$B246 AND %00001111   ; Keep bits 0 to 3.
 $B248 LD C,A          ; Keep the target in #REGc.
; Set a speed of #N$01 towards the target.
@label=HandleBlockMoving_Compare
 $B249 LD A,(IX+$01)   ; Fetch the position along the chosen axis.
 $B24C ADD A,$08       ; Add #N$08.
 $B24E AND %00001111   ; Keep bits 0 to 3.
 $B250 CP C            ; {Jump to #R$BFAB if the block is at the target.
 $B251 JP Z,$BFAB      ; }
 $B254 LD A,$01        ; Set the speed to #N$01.
 $B256 JR C,$B25A      ; Jump to #R$B25A if the block is below the target.
 $B258 NEG             ; Make the speed negative.
; Set that speed, cancel gravity, and move the block.
@label=HandleBlockMoving_SetSpeed
*$B25A LD (IX+$09),A   ; Set the speed along the chosen axis.
 $B25D LD (IX+$0B),$01 ; Write #N$01 as the speed along the z axis.
 $B261 CALL $BFB6      ; Call #R$BFB6.
 $B264 JP $BFAB        ; Jump to #R$BFAB.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$B6B9 }
; LIST#

; Handle Conveyor North
;
; The handler for a conveyor which
; carries objects north (object #N$44). The
; conveyor does not move but is given a
; speed of #N$02 along the y axis, which is
; used for the objects which stand on it.
; The other conveyors set a different speed
; and continue from #R$B26B.
;
; IX The address of the object
;
; Set the northward speed.
@label=HandleConveyorNorth
c$B267 LD (IX+$0A),$02 ; Write #N$02 as the speed along the y axis.
; This entry point is used by the routines at #R$B27A, #R$B280 and #R$B286.
; .
; Draw the conveyor and stop it falling.
@label=HandleConveyor
*$B26B CALL $BF3D      ; Call #R$BF3D.
 $B26E LD A,(IX+$0B)   ; Fetch the speed along the z axis.
 $B271 AND A           ; {Call #R$B6BB if something has landed on it.
 $B272 CALL NZ,$B6BB   ; }
 $B275 XOR A           ; {Write #N$00 as the speed along the z axis.
 $B276 LD (IX+$0B),A   ; }
 $B279 RET             ; Return.

; Handle Conveyor East
;
; The handler for a conveyor which
; carries objects east (object #N$45).
;
; IX The address of the object
;
; Set the eastward speed.
@label=HandleConveyorEast
c$B27A LD (IX+$09),$02 ; Write #N$02 as the speed along the x axis.
 $B27E JR $B26B        ; Jump to #R$B26B.

; Handle Conveyor South
;
; The handler for a conveyor which
; carries objects south (object #N$46).
;
; IX The address of the object
;
; Set the southward speed.
@label=HandleConveyorSouth
c$B280 LD (IX+$0A),$FE ; Write #N$FE as the speed along the y axis.
 $B284 JR $B26B        ; Jump to #R$B26B.

; Handle Conveyor West
;
; The handler for a conveyor which
; carries objects west (object #N$47).
;
; IX The address of the object
;
; Set the westward speed.
@label=HandleConveyorWest
c$B286 LD (IX+$09),$FE ; Write #N$FE as the speed along the x axis.
 $B28A JR $B26B        ; Jump to #R$B26B.

; Handle Collapsing Block
;
; The handler for a block which
; collapses (object #N$2D). When something
; stands on it the block turns into a
; sparkle (object #N$40) and disappears.
;
; IX The address of the object
;
; Collapse if something is standing on the block.
@label=HandleCollapsingBlock
c$B28C CALL $BF3D      ; Call #R$BF3D.
 $B28F BIT 3,(IX+$0D)  ; Test bit 3 of the state.
 $B293 RES 3,(IX+$0D)  ; Reset bit 3 of the state.
 $B297 RET Z           ; Return if nothing was standing on the block.
 $B298 LD (IX+$00),$40 ; Write #N$40 as the sprite number.
 $B29C JP $B3A4        ; Jump to #R$B3A4.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$B6A2 }
; LIST#

; Handle Deadly Object
;
; The handler for the deadly pyramid
; and tubes (objects #N$48 and #N$4B). They
; are made deadly to touch (see #R$B2A7).
;
; IX The address of the object
;
; Set the pixel offsets and make the object deadly.
@label=HandleDeadlyObject
c$B29F CALL $BF3D    ; Call #R$BF3D.
 $B2A2 JR $B2A7      ; Jump to #R$B2A7.

; Handle Broken Egg
;
; The handler for a broken egg
; (object #N$2E), which is deadly to touch.
;
; IX The address of the object
;
; Set the pixel offsets.
@label=HandleBrokenEgg
c$B2A4 CALL $BF6A    ; Call #R$BF6A.
; Continue on to #R$B2A7.

; Set Deadly Flags
;
; Used by the routines at #R$A8F9, #R$A9B1, #R$AD13, #R$B29F and #R$B2B0.
; .
; Makes the object deadly to touch
; by setting bits 5 and 7 of its flags.
;
; IX The address of the object
;
; Set bits 5 and 7 of the flags.
@label=SetDeadlyFlags
c$B2A7 LD A,(IX+$0D) ; Fetch the flags.
 $B2AA OR %10100000  ; Set bits 5 and 7.
 $B2AC LD (IX+$0D),A ; Store the flags.
 $B2AF RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$B85C }
; { #PENTAGRAM$C291 }
; LIST#

; Set Deadly Flags And Draw
;
; Used by the routines at #R$A9B1, #R$AA89, #R$AAA1, #R$B06B and #R$B110.
; .
; Makes the object deadly to touch
; (see #R$B2A7) and marks it to be wiped and
; redrawn.
;
; IX The address of the object
;
; Make the object deadly and redraw it.
@label=SetDeadlyFlagsAndDraw
c$B2B0 CALL $B2A7    ; Call #R$B2A7.
 $B2B3 JP $BFAB      ; Jump to #R$BFAB.

; Handle Falling Block
;
; The handler for a block which
; falls when something stands on it (object
; #N$2C). It falls by one step on each frame
; that something is standing on it, and
; makes a sound unless it has landed.
;
; IX The address of the object
;
; Fall if something is standing on the block.
@label=HandleFallingBlock
c$B2B6 CALL $BF3D      ; Call #R$BF3D.
 $B2B9 BIT 3,(IX+$0D)  ; Test bit 3 of the state.
 $B2BD RES 3,(IX+$0D)  ; Reset bit 3 of the state.
 $B2C1 RET Z           ; Return if nothing was standing on the block.
 $B2C2 LD (IX+$0B),$00 ; Write #N$00 as the speed along the z axis.
 $B2C6 CALL $BFB6      ; Call #R$BFB6.
 $B2C9 LD (IX+$0B),$00 ; Write #N$00 as the speed along the z axis.
 $B2CD BIT 2,(IX+$0C)  ; {Jump to #R$B2D6 if the block has landed.
 $B2D1 JR NZ,$B2D6     ; }
 $B2D3 CALL $B63C      ; Call #R$B63C.
@label=HandleFallingBlock_Redraw
*$B2D6 JP $BFAB        ; Jump to #R$BFAB.

; Save Position
;
; Used by the routine at #R$B2FF.
; .
; Saves the position of the object
; in #R$5B1B.
;
; IX The address of the object
;
; Copy x, y and z to #R$5B1B.
@label=SavePosition
c$B2D9 LD HL,$5B1B   ; Point #REGhl at #R$5B1B.
 $B2DC LD A,(IX+$01) ; Fetch the x position.
 $B2DF LD (HL),A     ; Store it.
 $B2E0 INC HL        ; Move on.
 $B2E1 LD A,(IX+$02) ; Fetch the y position.
 $B2E4 LD (HL),A     ; Store it.
 $B2E5 INC HL        ; Move on.
 $B2E6 LD A,(IX+$03) ; Fetch the z position.
 $B2E9 LD (HL),A     ; Store it.
 $B2EA RET           ; Return.

; Compare Position
;
; Used by the routine at #R$B2FF.
; .
; Compares the position of the
; object with the one saved by #R$B2D9.
;
;   IX The address of the object
; O:F Zero flag set if the position is the same
;
; Compare x, y and z with #R$5B1B.
@label=ComparePosition
c$B2EB LD HL,$5B1B   ; Point #REGhl at #R$5B1B.
 $B2EE LD A,(IX+$01) ; Fetch the x position.
 $B2F1 CP (HL)       ; Compare it with the saved x position.
 $B2F2 RET NZ        ; Return if it is different.
 $B2F3 INC HL        ; Move on.
 $B2F4 LD A,(IX+$02) ; Fetch the y position.
 $B2F7 CP (HL)       ; Compare it with the saved y position.
 $B2F8 RET NZ        ; Return if it is different.
 $B2F9 INC HL        ; Move on.
 $B2FA LD A,(IX+$03) ; Fetch the z position.
 $B2FD CP (HL)       ; Compare it with the saved z position.
 $B2FE RET           ; Return.

; Handle Fat Bottom Block
;
; The handler for a block which is
; fat at the bottom (object #N$1C). The
; block is moved with gravity. If it is
; still moving its x and y speeds are
; cleared and it makes a sound. Otherwise it
; is only redrawn if it has been moved.
; #R$B31A joins this routine at #R$B302.
;
; IX The address of the object
;
; Move the block and redraw it if it has changed.
@label=HandleFatBottomBlock
c$B2FF CALL $BF3D    ; Call #R$BF3D.
; This entry point is used by the routine at #R$B31A.
@label=HandleFatBottomBlock_Move
*$B302 CALL $B2D9    ; Call #R$B2D9.
 $B305 CALL $BFB6    ; Call #R$BFB6.
 $B308 CALL $BED6    ; {Jump to #R$B314 if the block is moving.
 $B30B JR NZ,$B314   ; }
 $B30D CALL $B2EB    ; {Return if the position is the same.
 $B310 RET Z         ; }
 $B311 JP $BFAB      ; Jump to #R$BFAB.
; The block is still moving.
@label=HandleFatBottomBlock_Stop
*$B314 CALL $C2EE    ; Call #R$C2EE.
 $B317 JP $B3BF      ; Jump to #R$B3BF.

; Handle Fat Top Block
;
; The handler for a block which is
; fat at the top (object #N$1D). It is dealt
; with in the same way as #R$B2FF.
;
; IX The address of the object
;
; Set the pixel offsets and join #R$B302.
@label=HandleFatTopBlock
c$B31A CALL $BF56    ; Call #R$BF56.
 $B31D JR $B302      ; Jump to #R$B302.

; Handle Rising Block
;
; The handler for a block which
; moves up and down when the player is
; standing on it (object #N$2F). The highest
; point it reaches is #N$30 above its height
; when it was first handled, which is kept
; in #R$5B25. A block which has not been
; touched and has not landed is left alone.
;
; IX The address of the object
;
; Set #R$5B25 the first time this block is handled.
@label=HandleRisingBlock
c$B31F CALL $BF3D     ; Call #R$BF3D.
 $B322 LD A,($5B25)   ; Fetch #R$5B25.
 $B325 AND A          ; {Jump to #R$B330 if it is not zero.
 $B326 JR NZ,$B330    ; }
 $B328 LD A,(IX+$03)  ; Fetch the height of the block.
 $B32B ADD A,$30      ; Add #N$30.
 $B32D LD ($5B25),A   ; Set #R$5B25.
; Leave the block alone unless it has been touched or has landed.
@label=HandleRisingBlock_TestTouched
*$B330 BIT 3,(IX+$0D) ; Test bit 3 of the state.
 $B334 RES 3,(IX+$0D) ; Reset bit 3 of the state.
 $B338 JR NZ,$B34E    ; Jump to #R$B34E if something touched the block.
 $B33A BIT 2,(IX+$0C) ; {Return if the block has not landed.
 $B33E RET Z          ; }
; Continue on to #R$B33F.

; Handle Moving Block
;
; The handler for a block which
; moves up and down (object #N$1F), and the
; code which moves the block for #R$B31F. It
; falls with gravity until it lands, then
; rises at #N$03 until it is higher than
; #R$5B25, when it falls again. The first
; block sets #R$5B25 to its own height. Bit
; 2 of the state remembers whether it is
; rising.
;
; IX The address of the object
;
; Set #R$5B25 the first time a block is handled.
@label=HandleMovingBlock
c$B33F CALL $BF3D      ; Call #R$BF3D.
 $B342 LD A,($5B25)    ; Fetch #R$5B25.
 $B345 AND A           ; {Jump to #R$B34E if it is not zero.
 $B346 JR NZ,$B34E     ; }
 $B348 LD A,(IX+$03)   ; Fetch the height of the block.
 $B34B LD ($5B25),A    ; Set #R$5B25.
; This entry point is used by the routine at #R$B31F.
; .
; Fall with gravity until the block lands, then start rising.
@label=HandleMovingBlock_Move
*$B34E CALL $B63C      ; Call #R$B63C.
 $B351 XOR A           ; Set #REGa to #N$00.
 $B352 LD (IX+$09),A   ; Stop the speed along the x axis.
 $B355 LD (IX+$0A),A   ; Stop the speed along the y axis.
 $B358 BIT 2,(IX+$0D)  ; {Jump to #R$B371 if the block is rising.
 $B35C JR NZ,$B371     ; }
 $B35E LD (IX+$0B),A   ; Set the speed along the z axis to #N$00.
 $B361 CALL $BFB6      ; Call #R$BFB6.
 $B364 BIT 2,(IX+$0C)  ; {Jump to #R$B36E if the block has not landed.
 $B368 JR Z,$B36E      ; }
 $B36A SET 2,(IX+$0D)  ; Set bit 2 of the state.
@label=HandleMovingBlock_Redraw
*$B36E JP $BFAB        ; Jump to #R$BFAB.
; The block is rising.
@label=HandleMovingBlock_Rising
*$B371 LD (IX+$0B),$03 ; Write #N$03 as the speed along the z axis.
 $B375 CALL $BFB6      ; Call #R$BFB6.
 $B378 BIT 2,(IX+$0C)  ; {Jump to #R$B38C if the block is not blocked.
 $B37C JR Z,$B38C      ; }
 $B37E LD (IX+$0B),$04 ; Write #N$04 as the speed along the z axis.
 $B382 XOR A           ; Set #REGa to #N$00.
 $B383 LD (IX+$09),A   ; Stop the speed along the x axis.
 $B386 LD (IX+$0A),A   ; Stop the speed along the y axis.
 $B389 CALL $BFB6      ; Call #R$BFB6.
@label=HandleMovingBlock_TestHighestPoint
*$B38C LD A,($5B25)    ; Fetch #R$5B25.
 $B38F CP (IX+$03)     ; {Jump to #R$B36E if the block has not gone above it.
 $B392 JR NC,$B36E     ; }
 $B394 RES 2,(IX+$0D)  ; Reset bit 2 of the state.
 $B398 JR $B36E        ; Jump to #R$B36E.

; Turn Into Sparkle
;
; Used by the routines at #R$C0BE and #R$C6E4.
; .
; Changes the object into the first
; frame of a sparkle (object #N$30) and
; makes collision tests ignore it, then
; carries on to deal with the sparkle.
;
; IX The address of the object
;
; Become a sparkle and play the sound.
@label=TurnIntoSparkle
c$B39A LD (IX+$00),$30 ; Write #N$30 as the sprite number.
 $B39E SET 1,(IX+$07)  ; Set bit 1 of the flags.
 $B3A2 JR $B3AA        ; Jump to #R$B3AA.

; Handle Sparkle
;
; Used by the routine at #R$B28C.
; .
; The handler for the sparkles
; (objects #N$30 to #N$36 and #N$40). Each
; time it is called the sparkle moves on to
; the next of its animation frames and a
; sparkle sound is played.
;
; IX The address of the object
;
; Step the frame and play the sparkle.
@label=HandleSparkle
c$B3A4 CALL $BF6A    ; Call #R$BF6A.
 $B3A7 INC (IX+$00)  ; Increment the sprite number.
; This entry point is used by the routine at #R$B39A.
@label=HandleSparkle_PlaySound
*$B3AA CALL $B5EE    ; Call #R$B5EE.
 $B3AD JP $BFAB      ; Jump to #R$BFAB.

; Remove Object
;
; Clears the byte whose address is
; held at offset #N$10 of the object, which
; is the number of a special object in
; #R$76E3, so that the object does not come
; back.
;
; IX The address of the object
;
; Clear the special object entry.
@label=RemoveObject
c$B3B0 LD L,(IX+$10) ; Fetch the low byte of the address.
 $B3B3 LD H,(IX+$11) ; Fetch the high byte of the address.
 $B3B6 LD (HL),$00   ; Write #N$00.
; Continue on to #R$B3B8.

; Retire Object
;
; The handler for the last of the
; sparkles (object #N$37). It sets the pixel
; offsets and makes the object a retired
; object (object #N$01).
;
; IX The address of the object
;
; Become a retired object.
@label=RetireObject
c$B3B8 CALL $BF6A      ; Call #R$BF6A.
; This entry point is used by the routines at #R$AE17 and #R$AE33.
@label=RetireObject_Retire
*$B3BB LD (IX+$00),$01 ; Write #N$01 as the sprite number.
; Continue on to #R$B3BF.

; Play Sound And Redraw
;
; Used by the routines at #R$AF79, #R$B19C, #R$B2FF and #R$BEE0.
; .
; Plays a sound whose pitch depends
; on the position of the object, and marks
; it to be wiped and redrawn.
;
; IX The address of the object
;
; Play a sound and redraw the object.
@label=PlaySoundAndRedraw
c$B3BF CALL $B654    ; Call #R$B654.
 $B3C2 JP $BFAB      ; Jump to #R$BFAB.

; Start Game Tune
;
; The tune played when a game
; starts. Each byte is a note: bits 0 to 5
; are the note number (see #R$B51D) and bits
; 6 and 7 are the length less one. The tune
; ends with #N$FF.
; .
; #HTML(#AUDIO0(start-up-tune.wav)(#INCLUDE(StartUpTune)))
@label=StartGameTune
b$B3C5 DEFB $25,$28,$2C,$25,$2A,$2D,$2C,$2A
 $B3CD DEFB $28,$2C,$2A,$28,$27,$2A,$28,$27
 $B3D5 DEFB $65,$FF

; Robot Tune
;
; The tune played when the robot has
; come back up out of the pot of oil. Each
; byte is a note: bits 0 to 5 are the note
; number (see #R$B51D) and bits 6 and 7 are
; the length less one. The tune ends with
; #N$FF.
; .
; #HTML(#AUDIO0(robot-tune.wav)(#INCLUDE(RobotTune)))
@label=RobotTune
b$B3D7 DEFB $25,$28,$2C,$25,$2A,$2D,$2C,$2A
 $B3DF DEFB $28,$2C,$2A,$28,$27,$2A,$28,$27
 $B3E7 DEFB $25,$28,$2C,$25,$2A,$2D,$2C,$2A
 $B3EF DEFB $28,$25,$27,$2C,$28,$25,$65,$FF

; Game Over Tune
;
; The tune played when the game is
; over. Each byte is a note: bits 0 to 5 are
; the note number (see #R$B51D) and bits 6
; and 7 are the length less one. The tune
; ends with #N$FF.
; .
; #HTML(#AUDIO0(game-over-tune.wav)(#INCLUDE(GameOverTune)))
@label=GameOverTune
b$B3F7 DEFB $25,$29,$2C,$29,$24,$29,$2C,$29
 $B3FF DEFB $22,$27,$2A,$27,$21,$27,$2A,$27
 $B407 DEFB $20,$25,$29,$25,$1F,$25,$29,$25
 $B40F DEFB $1E,$24,$27,$24,$20,$24,$27,$24
 $B417 DEFB $25,$29,$2C,$29,$24,$29,$2C,$29
 $B41F DEFB $22,$27,$2A,$27,$21,$27,$2A,$27
 $B427 DEFB $20,$25,$29,$25,$1F,$25,$29,$25
 $B42F DEFB $1E,$24,$27,$24,$25,$29,$65,$FF

; Game Complete Tune
;
; The tune played when the game has
; been completed. Each byte is a note: bits
; 0 to 5 are the note number (see #R$B51D)
; and bits 6 and 7 are the length less one.
; The tune ends with #N$FF.
; .
; #HTML(#AUDIO0(game-complete-tune.wav)(#INCLUDE(GameCompleteTune)))
@label=GameCompleteTune
b$B437 DEFB $1B,$1D,$1E,$1B,$1D,$1E,$20,$1D
 $B43F DEFB $1E,$20,$22,$1E,$1D,$1E,$20,$1D
 $B447 DEFB $1B,$1D,$1E,$1B,$1A,$1B,$1D,$1A
 $B44F DEFB $9B,$FF

; Menu Tune
;
; The tune played while the menu is
; displayed. Each byte is a note: bits 0 to
; 5 are the note number (see #R$B51D) and
; bits 6 and 7 are the length less one. The
; tune ends with #N$FF.
; .
; #HTML(#AUDIO0(main-tune.wav)(#INCLUDE(MainTune)))
@label=MenuTune
b$B451 DEFB $19,$25,$19,$25,$19,$19,$25,$19
 $B459 DEFB $25,$19,$19,$25,$19,$25,$19,$1B
 $B461 DEFB $1C,$28,$1C,$28,$1C,$28,$1C,$28
 $B469 DEFB $1B,$27,$1B,$27,$17,$23,$17,$23
 $B471 DEFB $19,$25,$19,$25,$19,$19,$25,$19
 $B479 DEFB $25,$19,$19,$25,$19,$25,$19,$1B
 $B481 DEFB $1C,$2F,$1C,$2F,$1C,$2F,$1C,$2F
 $B489 DEFB $1B,$2A,$1B,$2A,$17,$2A,$17,$2A
 $B491 DEFB $19,$2C,$19,$2C,$19,$19,$2C,$19
 $B499 DEFB $2C,$19,$19,$2C,$19,$2C,$19,$FF

; Play Music Once
;
; Used by the routine at #R$BA7E.
; .
; Plays a tune, but only if this
; routine has not played one before. Bit 0
; of #R$5B31 is set the first time and
; nothing clears it. The tune stops when a
; key is pressed (see #R$B4A9).
;
; DE Address of the tune
;
; Play only if #R$5B31 is clear.
@label=PlayMusicOnce
c$B4A1 LD HL,$5B31   ; Point #REGhl at #R$5B31.
 $B4A4 LD A,(HL)     ; {Return if #R$5B31 is set.
 $B4A5 AND A         ;
 $B4A6 RET NZ        ; }
 $B4A7 SET 0,(HL)    ; Set bit 0 of #R$5B31.
; Continue on to #R$B4A9.
; .
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$AF76 }
; { #KNIGHTLORE$B2B6 }
; { #NIGHTSHADE$C63D }
; { #PENTAGRAM$D69C }
; LIST#

; Play Music Until Key Pressed
;
; Used by the routine at #R$B761.
; .
; Plays a tune, which stops when a
; key is pressed. A tune is a list of notes
; (see #R$B4C5) which ends with #N$FF.
;
; DE Address of the tune
;
; Stop if a key is pressed.
@label=PlayMusic_WaitKey
c$B4A9 XOR A         ; Select all of the keyboard rows.
 $B4AA CALL $B759    ; Call #R$B759.
 $B4AD JR Z,$B4B0    ; Jump to #R$B4B0 if no key is pressed.
 $B4AF RET           ; Return.
; Play the next note.
@label=PlayMusic_WaitKey_TestEnd
*$B4B0 LD A,(DE)     ; Fetch the next note.
 $B4B1 CP $FF        ; {Jump to #R$B4C4 if it is #N$FF.
 $B4B3 JR Z,$B4C4    ; }
 $B4B5 CALL $B4C5    ; Call #R$B4C5.
 $B4B8 JR $B4A9      ; Jump to #R$B4A9.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$B2BE }
; LIST#

; Play Music
;
; Used by the routines at #R$A650, #R$A971 and #R$B8A9.
; .
; Plays a tune, which cannot be
; stopped. A tune is a list of notes (see
; #R$B4C5) which ends with #N$FF.
; .
; The tunes played by this routine are:
; #TABLE(default,centre,centre)
; { =h Tune | =h Sound }
; { Start-up Tune |
; #HTML(#AUDIO0(start-up-tune.wav)(#INCLUDE(StartUpTune))) }
; { Robot Tune | #HTML(#AUDIO0(robot-tune.wav)(#INCLUDE(RobotTune))) }
; { Game Complete Tune |
; #HTML(#AUDIO0(game-complete-tune.wav)(#INCLUDE(GameCompleteTune))) }
; TABLE#
;
; DE Address of the tune
;
; Play each note until #N$FF.
@label=PlayMusic
c$B4BA LD A,(DE)     ; Fetch the next note.
 $B4BB CP $FF        ; {Jump to #R$B4C4 if it is #N$FF.
 $B4BD JR Z,$B4C4    ; }
 $B4BF CALL $B4C5    ; Call #R$B4C5.
 $B4C2 JR $B4BA      ; Jump to #R$B4BA.
; This entry point is used by the routine at #R$B4A9.
@label=PlayMusic_End
*$B4C4 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #CYBERUN$9AA9 }
; { #GUNFRIGHT$AF8F }
; { #KNIGHTLORE$B2CF }
; { #MARTIANOIDS$C0CF }
; { #NIGHTSHADE$C656 }
; { #PENTAGRAM$D6B5 }
; LIST#

; Play Note
;
; Used by the routines at #R$B4A9 and #R$B4BA.
; .
; Plays a note of a tune, or a rest
; if the note number is zero. Bits 0 to 5
; select the entry in #R$B51D that holds the
; two delays of a cycle and the number of
; cycles. Bits 6 and 7 are the length less
; one, which multiplies the number of
; cycles, so the note is one to four times
; as long.
;
;   A The note
;   DE Address of the note
; O:DE Address of the next note
;
; Look up the delays and the number of cycles.
@label=PlayNote
c$B4C5 AND %00111111 ; Keep bits 0 to 5.
 $B4C7 JR Z,$B507    ; Jump to #R$B507 if the note is a rest.
 $B4C9 LD L,A        ; Copy the note number to #REGl.
 $B4CA LD H,$00      ; Set #REGh to #N$00.
 $B4CC ADD HL,HL     ; Double the number.
 $B4CD CALL $CE06    ; Call #R$CE06.
 $B4D0 LD BC,$B51D   ; Point #REGbc at #R$B51D.
 $B4D3 ADD HL,BC     ; Find the entry for the note.
 $B4D4 LD B,(HL)     ; Fetch the first delay.
 $B4D5 INC HL        ; Move on.
 $B4D6 LD C,(HL)     ; Fetch the second delay.
 $B4D7 INC HL        ; Move on.
 $B4D8 LD L,(HL)     ; Fetch the number of cycles.
 $B4D9 LD H,$00      ; Set #REGh to #N$00.
; Bits 6 and 7 are the length, less one.
 $B4DB LD A,(DE)     ; Fetch the note again.
 $B4DC RLCA          ; {Move bits 6 and 7 to bits 0 and 1.
 $B4DD RLCA          ; }
 $B4DE AND %00000011 ; Keep bits 0 and 1.
 $B4E0 INC A         ; Add one.
 $B4E1 PUSH DE       ; Stash the note address on the stack.
 $B4E2 LD E,L        ; {Copy the number of cycles to #REGde.
 $B4E3 LD D,H        ; }
; Multiply the number of cycles by the length.
@label=PlayNote_MultiplyLength
*$B4E4 DEC A         ; Count down the length.
 $B4E5 JR Z,$B4EA    ; Jump to #R$B4EA if the length has been used up.
 $B4E7 ADD HL,DE     ; Add the number of cycles again.
 $B4E8 JR $B4E4      ; Jump to #R$B4E4.
@label=PlayNote_PlayCycle
*$B4EA POP DE        ; Restore the note address from the stack.
; Each pass makes one cycle of the note.
@label=PlayNote_Cycle
*$B4EB PUSH BC       ; Stash the delays on the stack.
 $B4EC XOR A         ; Set #REGa to #N$00.
 $B4ED OUT ($FE),A   ; Turn the speaker off.
@label=PlayNote_FirstDelay
*$B4EF DJNZ $B4EF    ; Wait for the first half of the cycle.
 $B4F1 DEC C         ; Count down the second delay.
 $B4F2 JR NZ,$B4EF   ; Jump to #R$B4EF until it has finished.
 $B4F4 POP BC        ; Restore the delays from the stack.
 $B4F5 PUSH BC       ; Stash the delays on the stack.
 $B4F6 LD A,$10      ; Set bit 4.
 $B4F8 OUT ($FE),A   ; Turn the speaker on.
@label=PlayNote_SecondDelay
*$B4FA DJNZ $B4FA    ; Wait for the second half of the cycle.
 $B4FC DEC C         ; Count down the second delay.
 $B4FD JR NZ,$B4FA   ; Jump to #R$B4FA until it has finished.
 $B4FF POP BC        ; Restore the delays from the stack.
 $B500 DEC HL        ; Count down the cycles.
 $B501 LD A,H        ; {Jump to #R$B4EB until all of the cycles have been
 $B502 OR L          ; played.
 $B503 JR NZ,$B4EB   ; }
 $B505 INC DE        ; Move on to the next note.
 $B506 RET           ; Return.
; A rest is a silent pause of one to four units.
@label=PlayNote_Rest
*$B507 LD A,(DE)     ; Fetch the length of the rest.
 $B508 INC DE        ; Move on to the next note.
 $B509 RLCA          ; {Move bits 6 and 7 to bits 0 and 1.
 $B50A RLCA          ; }
 $B50B AND %00000011 ; Keep bits 0 and 1.
 $B50D INC A         ; Add one.
 $B50E LD L,A        ; Keep it in #REGl.
 $B50F LD BC,$430B   ; Set #REGbc to #N$430B.
@label=PlayNote_RestUnit
*$B512 PUSH BC       ; Stash the pause length on the stack.
@label=PlayNote_Pause
*$B513 DEC BC        ; Count down the pause.
 $B514 LD A,B        ; {Jump to #R$B513 until it has finished.
 $B515 OR C          ;
 $B516 JR NZ,$B513   ; }
 $B518 POP BC        ; Restore the pause length from the stack.
 $B519 DEC L         ; Count down the units of the rest.
 $B51A JR NZ,$B512   ; Jump to #R$B512 until the rest has finished.
 $B51C RET           ; Return.
; View the equivalent code in;
; #LIST
; { #CYBERUN$9AB4 }
; { #GUNFRIGHT$AF9A }
; { #KNIGHTLORE$B2DA }
; { #MARTIANOIDS$C0DA }
; { #NIGHTSHADE$C661 }
; { #PENTAGRAM$D6C0 }
; LIST#

; Music Note Table
;
; The note table. Each entry has
; three bytes: two delays for the halves of
; a cycle (#REGb and #REGc) and one that is
; a multiple of the length. Note zero is
; not used.
@label=MusicNotes
b$B51D DEFB $00,$00,$00 ; Note #N$00.
 $B520 DEFB $F4,$0A,$08 ; Note #N$01.
 $B523 DEFB $65,$0A,$09 ; Note #N$02.
 $B526 DEFB $DE,$09,$09 ; Note #N$03.
 $B529 DEFB $5E,$09,$0A ; Note #N$04.
 $B52C DEFB $E7,$08,$0A ; Note #N$05.
 $B52F DEFB $75,$08,$0B ; Note #N$06.
 $B532 DEFB $0A,$08,$0C ; Note #N$07.
 $B535 DEFB $A5,$07,$0C ; Note #N$08.
 $B538 DEFB $45,$07,$0D ; Note #N$09.
 $B53B DEFB $EB,$06,$0E ; Note #N$0A.
 $B53E DEFB $96,$06,$0F ; Note #N$0B.
 $B541 DEFB $46,$06,$0F ; Note #N$0C.
 $B544 DEFB $FA,$05,$10 ; Note #N$0D.
 $B547 DEFB $B3,$05,$11 ; Note #N$0E.
 $B54A DEFB $6F,$05,$12 ; Note #N$0F.
 $B54D DEFB $2F,$05,$13 ; Note #N$10.
 $B550 DEFB $F3,$04,$15 ; Note #N$11.
 $B553 DEFB $F3,$04,$16 ; Note #N$12.
 $B556 DEFB $85,$04,$17 ; Note #N$13.
 $B559 DEFB $52,$04,$19 ; Note #N$14.
 $B55C DEFB $23,$04,$1A ; Note #N$15.
 $B55F DEFB $F6,$03,$1C ; Note #N$16.
 $B562 DEFB $CB,$03,$1D ; Note #N$17.
 $B565 DEFB $A3,$03,$1F ; Note #N$18.
 $B568 DEFB $7D,$03,$21 ; Note #N$19.
 $B56B DEFB $59,$03,$23 ; Note #N$1A.
 $B56E DEFB $38,$03,$25 ; Note #N$1B.
 $B571 DEFB $18,$03,$27 ; Note #N$1C.
 $B574 DEFB $FA,$02,$29 ; Note #N$1D.
 $B577 DEFB $DD,$02,$2C ; Note #N$1E.
 $B57A DEFB $C2,$02,$2E ; Note #N$1F.
 $B57D DEFB $A9,$02,$31 ; Note #N$20.
 $B580 DEFB $91,$02,$34 ; Note #N$21.
 $B583 DEFB $7B,$02,$37 ; Note #N$22.
 $B586 DEFB $66,$02,$3A ; Note #N$23.
 $B589 DEFB $51,$02,$3E ; Note #N$24.
 $B58C DEFB $3F,$02,$41 ; Note #N$25.
 $B58F DEFB $2D,$02,$45 ; Note #N$26.
 $B592 DEFB $1C,$02,$49 ; Note #N$27.
 $B595 DEFB $0C,$02,$4E ; Note #N$28.
 $B598 DEFB $FD,$01,$52 ; Note #N$29.
 $B59B DEFB $EF,$01,$57 ; Note #N$2A.
 $B59E DEFB $E2,$01,$5D ; Note #N$2B.
 $B5A1 DEFB $D5,$01,$62 ; Note #N$2C.
 $B5A4 DEFB $C9,$01,$68 ; Note #N$2D.
 $B5A7 DEFB $BD,$01,$6E ; Note #N$2E.
 $B5AA DEFB $B3,$01,$75 ; Note #N$2F.
 $B5AD DEFB $A9,$01,$7B ; Note #N$30.
 $B5B0 DEFB $9F,$01,$83 ; Note #N$31.
 $B5B3 DEFB $96,$01,$8B ; Note #N$32.
 $B5B6 DEFB $8E,$01,$93 ; Note #N$33.
 $B5B9 DEFB $86,$01,$9C ; Note #N$34.
 $B5BC DEFB $7E,$01,$A5 ; Note #N$35.
 $B5BF DEFB $77,$01,$AF ; Note #N$36.
 $B5C2 DEFB $71,$01,$B9 ; Note #N$37.
 $B5C5 DEFB $6A,$01,$C4 ; Note #N$38.
 $B5C8 DEFB $64,$01,$D0 ; Note #N$39.
 $B5CB DEFB $5F,$01,$DC ; Note #N$3A.
 $B5CE DEFB $59,$01,$E9 ; Note #N$3B.
 $B5D1 DEFB $54,$01,$F7 ; Note #N$3C.

; Play Pitch From Table
;
; Plays four beeps at a pitch taken
; from #R$B5E6, using bits 0 to 2 of
; #R$5B02. Nothing in the game uses this
; routine.
;
; .
;
; Choose a pitch from the table.
; .
; #HTML(#AUDIO0(block-sound.wav)(#INCLUDE(BlockSound)))
@label=PlayPitchFromTable
c$B5D4 LD A,($5B02)  ; Fetch #R$5B02.
 $B5D7 AND %00000111 ; Keep bits 0 to 2.
 $B5D9 LD L,A        ; {Set #REGhl to the entry number.
 $B5DA LD H,$00      ; }
 $B5DC LD BC,$B5E6   ; {Point #REGhl at the entry in #R$B5E6.
 $B5DF ADD HL,BC     ; }
 $B5E0 LD B,(HL)     ; Fetch the pitch.
 $B5E1 LD C,$04      ; Set the number of beeps to #N$04.
 $B5E3 JP $B6FB      ; Jump to #R$B6FB.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$B3E9 }
; LIST#

; Pitch Table
;
; The pitches used by #R$B5D4.
@label=PitchTable
b$B5E6 DEFB $A0,$B0,$C0,$90,$A0,$E0,$80,$60

; Play Sparkle Sound
;
; Used by the routines at #R$AF79 and #R$B3A4.
; .
; Plays a burst of noise for a
; sparkle, using bytes of the ROM from
; #N$1234 as the pitches of beeps. The
; number of beeps is taken from the sprite
; number, so it changes as the sparkle goes
; through its frames.
;
; IX The address of the object
;
; Play a beep for each remaining frame.
; .
; #HTML(#AUDIO0(sparkles-sound.wav)(#INCLUDE(SparklesSound)))
@label=PlaySparkleSound
c$B5EE LD A,(IX+$00) ; Fetch the sprite number.
 $B5F1 CPL           ; Invert it.
 $B5F2 AND %00011111 ; Keep bits 0 to 4.
 $B5F4 LD E,A        ; Keep the number of beeps in #REGe.
 $B5F5 LD HL,$1234   ; Point #REGhl at #N$1234.
@label=PlaySparkleSound_NextBeep
*$B5F8 LD A,(HL)     ; {Fetch a ROM byte as the pitch.
 $B5F9 INC HL        ;
 $B5FA LD B,A        ; }
 $B5FB LD C,$02      ; Set the number of beeps to #N$02.
 $B5FD CALL $B6FB    ; Call #R$B6FB.
 $B600 DEC E         ; {Jump to #R$B5F8 until all of the beeps have been
 $B601 JR NZ,$B5F8   ; played.}
 $B603 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$B403 }
; LIST#

; Play Appearing Sound
;
; Used by the routine at #R$BC70.
; .
; Plays a sound for the sparkles
; which appear around the player. The length
; and the pitches depend on the sprite
; number of the object.
;
; IX The address of the object
;
; Make a beep for each remaining frame.
; .
; #HTML(#AUDIO0(appearing-sound.wav)(#INCLUDE(AppearingSound)))
@label=PlayAppearingSound
c$B604 LD A,(IX+$00) ; Fetch the sprite number.
 $B607 RLCA          ; {Rotate it twice.
 $B608 RLCA          ; }
 $B609 AND %00011111 ; Keep bits 0 to 4.
 $B60B OR %00000011  ; Set bits 0 and 1.
 $B60D LD C,A        ; Keep the number of beeps in #REGc.
@label=PlayAppearingSound_NextBeep
*$B60E LD A,C        ; Copy the number of beeps to #REGa.
 $B60F RLCA          ; {Rotate it twice.
 $B610 RLCA          ; }
 $B611 LD B,A        ; Keep the pitch in #REGb.
 $B612 CALL $B702    ; Call #R$B702.
 $B615 DEC C         ; Count down the beeps.
 $B616 JR NZ,$B60E   ; Jump to #R$B60E until all of them have been played.
 $B618 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$B419 }
; LIST#

; Play Bump Sound
;
; Used by the routines at #R$AB61, #R$B06B and #R$B110.
; .
; Plays a burst of noise, using the
; bytes at #SKOOLKID$0000(START) as the
; pitches of beeps. It is the sound of one
; object bumping into another.
;
; .
;
; Play four bursts of three beeps.
; .
; #HTML(#AUDIO0(bounce-sound.wav)(#INCLUDE(BounceSound)))
@label=PlayBumpSound
c$B619 LD HL,$0000   ; Point #REGhl at #SKOOLKID$0000(START).
 $B61C LD E,$04      ; Set a counter of four bursts.
@label=PlayBumpSound_NextBurst
*$B61E LD C,$03      ; Set the number of beeps to #N$03.
 $B620 LD A,(HL)     ; Fetch a byte of the ROM.
 $B621 INC HL        ; Move on.
 $B622 OR %11000000  ; Set bits 6 and 7.
 $B624 LD B,A        ; Keep the pitch in #REGb.
 $B625 CALL $B6FB    ; Call #R$B6FB.
 $B628 DEC E         ; Count down the bursts.
 $B629 JR NZ,$B61E   ; Jump to #R$B61E until all of them have been played.
 $B62B RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$B42E }
; LIST#

; Play Jump Sound
;
; Used by the routine at #R$C23D.
; .
; Plays the sound of the player
; jumping, which goes through a series of
; pitches.
;
; .
;
; Play #N$20 beeps of falling pitch.
; .
; #HTML(#AUDIO0(jump-sound.wav)(#INCLUDE(JumpSound)))
@label=PlayJumpSound
c$B62C LD C,$20      ; Set the counter to #N$20.
@label=PlayJumpSound_NextBeep
*$B62E LD A,C        ; Copy the counter to #REGa.
 $B62F RRCA          ; {Rotate it five times.
 $B630 RRCA          ;
 $B631 RRCA          ;
 $B632 RRCA          ;
 $B633 RRCA          ; }
 $B634 LD B,A        ; Keep the pitch in #REGb.
 $B635 CALL $B702    ; Call #R$B702.
 $B638 DEC C         ; Count down.
 $B639 JR NZ,$B62E   ; Jump to #R$B62E until all of the beeps have been played.
 $B63B RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$B441 }
; LIST#

; Play Sound From Height
;
; Used by the routines at #R$A8F9, #R$A9C7, #R$AD13, #R$B06B, #R$B2B6, #R$B33F
; and #R$C296.
; .
; Plays a tone for an object that is
; falling or rising, with a pitch taken from
; the height of the object.
;
; IX The address of the object
;
; Use the height as the pitch source.
; .
; #HTML(#AUDIO0(falling-sound.wav)(#INCLUDE(FallingSound)))
@label=PlaySoundFromHeight
c$B63C LD A,(IX+$03) ; Fetch the height of the object.
; Continue on to #R$B63F.
; .
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$B451 }
; LIST#

; Play Sound From Value
;
; Used by the routines at #R$A971, #R$B64A, #R$B64F and #R$B654.
; .
; Plays six beeps of a tone whose
; pitch is worked out from the value in
; #REGa. #R$B63C uses the height, #R$B64A
; the x position, #R$B64F the y position and
; #R$B654 the sum of the three coordinates.
;
; A Value that the pitch is made from
;
; Turn the value into a pitch and play six beeps.
; .
; #HTML(#AUDIO0(rising-sound.wav)(#INCLUDE(RisingSound)))
@label=PlaySoundFromHeight_PlaySoundFromValue
c$B63F ADD A,$40     ; Add #N$40.
 $B641 CPL           ; Invert it.
 $B642 RLCA          ; {Rotate it twice.
 $B643 RLCA          ; }
 $B644 LD B,A        ; Keep the pitch in #REGb.
 $B645 LD C,$06      ; Set the number of beeps to #N$06.
 $B647 JP $B6FB      ; Jump to #R$B6FB.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$B454 }
; LIST#

; Play Sound From X Position
;
; Used by the routine at #R$B224.
; .
; Plays a short sound whose pitch
; depends on the x position of the object
; (see #R$B63F).
;
; IX The address of the object
;
; Use the x position as the pitch source.
; .
; #HTML(#AUDIO0(block-east-west-sound.wav)(#INCLUDE(BlockEastWestSound)))
@label=PlaySoundFromXPosition
c$B64A LD A,(IX+$01) ; Fetch the x position.
 $B64D JR $B63F      ; Jump to #R$B63F.

; Play Sound From Y Position
;
; Used by the routine at #R$B21C.
; .
; Plays a short sound whose pitch
; depends on the y position of the object
; (see #R$B63F).
;
; IX The address of the object
;
; Use the y position as the pitch source.
; .
; #HTML(#AUDIO0(block-north-south-sound.wav)(#INCLUDE(BlockNorthSouthSound)))
@label=PlaySoundFromYPosition
c$B64F LD A,(IX+$02) ; Fetch the y position.
 $B652 JR $B63F      ; Jump to #R$B63F.

; Play Sound From Position
;
; Used by the routine at #R$B3BF.
; .
; Plays a short sound whose pitch
; depends on the sum of the coordinates of
; the object (see #R$B63F).
;
; IX The address of the object
;
; Add x, y and z and play the sound.
; .
; #HTML(#AUDIO0(moving-sound.wav)(#INCLUDE(MovingSound)))
@label=PlaySoundFromPosition
c$B654 LD A,(IX+$01)  ; Fetch the x position.
 $B657 ADD A,(IX+$02) ; Add the y position.
 $B65A ADD A,(IX+$03) ; Add the z position.
 $B65D JR $B63F       ; Jump to #R$B63F.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$B467 }
; LIST#

; Play Sound From Object Number
;
; Plays a sound whose length and
; pitches depend on the sprite number of
; the object. Nothing in the game uses this
; routine.
;
; IX The address of the object
;
; Work out the number of beeps from the
; sprite number.
; .
; #HTML(#AUDIO0(transform-sound.wav)(#INCLUDE(TransformSound)))
@label=PlaySoundFromObjectNumber
c$B65F LD A,(IX+$00) ; Fetch the sprite number.
 $B662 RLCA          ; {Rotate it three times.
 $B663 RLCA          ;
 $B664 RLCA          ; }
 $B665 AND %00011000 ; Keep only bits 3 and 4.
 $B667 ADD A,$10     ; Add #N$10.
 $B669 LD C,A        ; Keep the number of beeps in #REGc.
; Play a beep of a pitch made from the
; remaining count.
@label=PlaySoundFromObjectNumber_NextBeep
*$B66A LD A,C        ; Copy the number of beeps to #REGa.
 $B66B XOR %01010101 ; Flip every other bit.
 $B66D ADD A,C       ; Add the number of beeps.
 $B66E LD B,A        ; Keep the pitch in #REGb.
 $B66F CALL $B702    ; Call #R$B702.
 $B672 DEC C         ; Count down the beeps.
 $B673 JR NZ,$B66A   ; Jump to #R$B66A until all of them have
                     ; been played.
 $B675 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$B472 }
; LIST#

; Play Random Noise
;
; Used by the routines at #R$AB61 and #R$AD54.
; .
; Plays a burst of noise, using #N$10
; bytes of the ROM as the pitches of beeps.
; The ROM address is taken from #R$5B05 and
; #R$5B02.
;
; .
;
; Point at a random stretch of the ROM.
; .
; #HTML(#AUDIO0(explosion.wav)(#INCLUDE(Explosion)))
@label=PlayRandomNoise
c$B676 LD A,($5B05)  ; Fetch #R$5B05.
 $B679 LD L,A        ; Use it as the low byte of a ROM
                     ; address.
 $B67A LD A,($5B02)  ; Fetch #R$5B02.
 $B67D AND %00011111 ; Keep only bits 0 to 4.
 $B67F LD H,A        ; Use them as the high byte of the
                     ; address.
 $B680 LD E,$10      ; Set a counter of #N$10 beeps.
; Play a beep from each ROM byte.
@label=PlayRandomNoise_NextBeep
*$B682 LD A,(HL)     ; Fetch a byte of the ROM.
 $B683 INC HL        ; Move on.
 $B684 AND %01111111 ; Keep only bits 0 to 6.
 $B686 LD B,A        ; Keep the pitch in #REGb.
 $B687 LD C,$02      ; Set the number of beeps to #N$02.
 $B689 CALL $B6FB    ; Call #R$B6FB.
 $B68C DEC E         ; Count down the beeps.
 $B68D JR NZ,$B682   ; Jump to #R$B682 until all of them have
                     ; been played.
 $B68F RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$B489 }
; LIST#

; Play Moving Sound
;
; Used by the routines at #R$A9C7 and #R$AA89.
; .
; Plays the sound of a moving robot.
; The length comes from a table of four
; values, using bits 0 and 1 of #R$5B02, and
; the pitch changes with the frame.
;
; HL Address of a table of four lengths
;
; Fetch a length from the table.
; .
; #HTML(#AUDIO0(robot-moving-sound.wav)(#INCLUDE(RobotMovingSound)))
@label=PlayMovingSound
c$B690 LD A,($5B02)  ; Fetch #R$5B02.
 $B693 AND %00000011 ; Keep only bits 0 and 1.
 $B695 CALL $CE06    ; Call #R$CE06.
 $B698 LD C,(HL)     ; Fetch the length of the sound.
; Play a beep of a pitch made from the
; frame and the length.
@label=PlayMovingSound_NextBeep
*$B699 LD A,($5B02)  ; Fetch #R$5B02.
 $B69C XOR C         ; Combine it with the length.
 $B69D AND %00011111 ; Keep only bits 0 to 4.
 $B69F OR %01000000  ; Set bit 6.
 $B6A1 LD B,A        ; Keep the pitch in #REGb.
 $B6A2 CALL $B702    ; Call #R$B702.
 $B6A5 DEC C         ; Count down.
 $B6A6 JR NZ,$B699   ; Jump to #R$B699 until all of the beeps
                     ; have been played.
 $B6A8 RET           ; Return.

; Moving Sound Lengths
;
; The lengths of the sound made by
; the remote control robot (see #R$A9C7)
; and by the chasing dome (see #R$AA89).
@label=MovingSoundLengths
b$B6A9 DEFB $08,$0C,$10,$14 ; Lengths for the remote control robot.
@label=MovingSoundLengths_ChasingDome
 $B6AD DEFB $18,$14,$10,$0C ; Lengths for the chasing dome.

; Play Low Beep
;
; Used by the routines at #R$ABF5, #R$BA7E, #R$BD6B and #R$BEE0.
; .
; Plays a low beep, which is #N$10
; beeps at a pitch of #N$80.
;
; .
;
; Set the pitch and the beep count.
; .
; #HTML(#AUDIO0(beep-sound.wav)(#INCLUDE(BeepSound)))
@label=PlayLowBeep
c$B6B1 LD BC,$8010   ; Set the pitch to #N$80 and the number
                     ; of beeps to #N$10.
 $B6B4 JR $B6FB      ; Jump to #R$B6FB.

; Play Middle Beep
;
; Used by the routine at #R$CE22.
; .
; Plays a middle beep, which is
; #N$18 beeps at a pitch of #N$50 (higher
; than the low beep at #R$B6B1). It is the
; sound of the game being paused and of it
; carrying on again.
;
; .
;
; Set the pitch and the beep count.
; .
; #HTML(#AUDIO0(pause-sound.wav)(#INCLUDE(PauseSound)))
@label=PlayMiddleBeep
c$B6B6 LD BC,$5018   ; Set the pitch to #N$50 and the number
                     ; of beeps to #N$18.
 $B6B9 JR $B6FB      ; Jump to #R$B6FB.

; Play High Beep
;
; Used by the routines at #R$AAA1 and #R$B267.
; .
; Plays a high beep, which is #N$20
; beeps at a pitch of #N$30 (higher than
; the middle beep at #R$B6B6).
;
; .
;
; Set the pitch and the beep count.
; .
; #HTML(#AUDIO0(high-beep-sound.wav)(#INCLUDE(HighBeepSound)))
@label=PlayHighBeep
c$B6BB LD BC,$3020   ; Set the pitch to #N$30 and the number
                     ; of beeps to #N$20.
 $B6BE JR $B6FB      ; Jump to #R$B6FB.

; Play Mouse Sound
;
; Used by the routine at #R$B055.
; .
; Plays the sound of a moving robot
; mouse, but only if the sprite number of
; the object is even.
;
; IX The address of the object
;
; Return unless this is an even sprite.
; .
; #HTML(#AUDIO0(mouse-footstep-sound.wav)(#INCLUDE(MouseFootstepSound)))
@label=PlayMouseSound
c$B6C0 LD A,(IX+$00) ; Fetch the sprite number.
 $B6C3 AND %00000001 ; Keep only bit 0.
 $B6C5 RET NZ        ; Return if the sprite number is odd.
; Set a fixed pitch and join the
; footstep player.
 $B6C6 LD B,$80      ; Set the pitch to #N$80.
 $B6C8 LD A,($5B02)  ; Fetch #R$5B02.
 $B6CB CPL           ; Invert it.
 $B6CC JR $B6D9      ; Jump to #R$B6D9.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$B4AD }
; LIST#

; Play Footsteps Sound
;
; Used by the routine at #R$C25E.
; .
; Plays the footsteps of the player
; walking, but only on every other frame of
; the walking animation, which is when the
; sprite number of the object is even.
;
; IX The address of the object
;
; Return unless this is an even sprite.
; .
; #HTML(#AUDIO0(footstep-sound.wav)(#INCLUDE(FootstepSound)))
@label=PlayFootstepsSound
c$B6CE LD A,(IX+$00) ; Fetch the sprite number.
 $B6D1 AND %00000001 ; Keep only bit 0.
 $B6D3 RET NZ        ; Return if the sprite number is odd.
; Continue on to #R$B6D4.
; .
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$B4BB }
; LIST#

; Play Footsteps Sound Every Frame
;
; Used by the routine at #R$C1E2.
; .
; Plays the footsteps of the player
; walking, on every frame of the walking
; animation. The pitch starts as #N$60.
; When bit 1 of #REGa is set it is made
; from the height of the object instead.
; The number of beeps depends on the
; position of the object on the screen.
;
; IX The address of the object
;
; Start with a fixed pitch.
@label=PlayFootstepsSound_EveryFrame
c$B6D4 LD B,$60      ; Set the pitch to #N$60.
 $B6D6 LD A,($5B02)  ; Fetch #R$5B02.
; This entry point is used by the routine at #R$B6C0.
; .
; Use the height when bit 1 is set.
@label=PlayFootstepsSound_EveryFrame_TestPitch
*$B6D9 BIT 1,A       ; {Jump to #R$B6E6 if bit 1 of the value
 $B6DB JR Z,$B6E6    ; is clear.}
 $B6DD LD A,(IX+$03) ; Fetch the height of the object.
 $B6E0 ADD A,$40     ; Add #N$40.
 $B6E2 CPL           ; Invert it.
 $B6E3 SRL A         ; Halve it.
 $B6E5 LD B,A        ; Use it as the pitch.
; Make the beep count from the
; on-screen position.
@label=PlayFootstepsSound_EveryFrame_CountBeeps
*$B6E6 LD A,(IX+$01) ; Fetch the x position of the object.
 $B6E9 SRL A         ; Halve it.
 $B6EB LD C,A        ; Keep it in #REGc.
 $B6EC LD A,(IX+$02) ; Fetch the y position of the object.
 $B6EF NEG           ; Make it negative.
 $B6F1 SRL A         ; Halve it.
 $B6F3 ADD A,C       ; Add the halved x position.
 $B6F4 RRCA          ; {Move the upper four bits to the
 $B6F5 RRCA          ; lowest four.
 $B6F6 RRCA          ;
 $B6F7 RRCA          ; }
 $B6F8 AND %00001111 ; Keep only bits 0 to 3.
 $B6FA LD C,A        ; Keep the number of beeps in #REGc.
; Continue on to #R$B6FB.

; Play Wave Sequence
;
; Used by the routines at #R$B5D4, #R$B5EE, #R$B619, #R$B63F, #R$B676, #R$B6B1,
; #R$B6B6 and #R$B6BB.
; .
; Plays a number of beeps of the
; same pitch.
;
; B Pitch
; C Number of beeps
;
; Play one beep per count.
@label=PlayWaveSequence
c$B6FB CALL $B702    ; Call #R$B702.
 $B6FE DEC C         ; {Jump to #R$B6FB until all of the
 $B6FF JR NZ,$B6FB   ; beeps have been played.}
 $B701 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$AF5F }
; { #KNIGHTLORE$B4E6 }
; { #PENTAGRAM$D67B }
; LIST#

; Play Square Wave
;
; Used by the routines at #R$B604, #R$B62C, #R$B65F, #R$B690 and #R$B6FB.
; .
; Plays a single beep by switching
; the speaker on, waiting, switching it off
; and waiting again. The bigger the pitch,
; the longer the beep.
;
; B Pitch
;
; Hold the speaker on, then off.
@label=PlaySquareWave
c$B702 LD A,$10      ; {Turn the speaker on.
 $B704 OUT ($FE),A   ; }
 $B706 LD A,B        ; Keep the pitch in #REGa.
@label=PlaySquareWave_FirstDelay
*$B707 DJNZ $B707    ; Wait for the first half of the beep.
 $B709 LD B,A        ; Restore the pitch.
 $B70A XOR A         ; {Turn the speaker off.
 $B70B OUT ($FE),A   ; }
 $B70D LD A,B        ; Keep the pitch in #REGa.
@label=PlaySquareWave_SecondDelay
*$B70E DJNZ $B70E    ; Wait for the second half of the beep.
 $B710 LD B,A        ; Restore the pitch.
 $B711 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #CYBERUN$71E0 }
; { #GUNFRIGHT$AF66 }
; { #KNIGHTLORE$B4ED }
; { #NIGHTSHADE$C471 }
; { #PENTAGRAM$D682 }
; LIST#

; Test Object Intersections
;
; Used by the routine at #R$BD6B.
; .
; Tests whether an object overlaps
; any other solid object in the table that
; starts at #R$5B88, without moving. The
; object itself is ignored while the table
; is searched.
;
;   IX The address of the object
; O:F Carry flag set if the object intersects another object
;
; Start at the first object with no
; movement.
@label=TestObjectIntersections
c$B712 PUSH BC        ; {Stash the registers on the stack.
 $B713 PUSH DE        ;
 $B714 PUSH HL        ;
 $B715 PUSH IY        ; }
 $B717 LD IY,$5B88    ; Point #REGiy at #R$5B88.
 $B71B LD B,$38       ; Set a counter of #N$38 objects.
 $B71D LD C,$00       ; Set the x speed to #N$00.
 $B71F LD L,C         ; {Set the y and z speeds to #N$00.
 $B720 LD H,C         ; }
 $B721 SET 1,(IX+$07) ; Set bit 1 of the object flags.
; Test whether this object overlaps on
; all three axes.
@label=TestObjectIntersections_TestObject
*$B725 CALL $B74D     ; Call #R$B74D.
 $B728 JR Z,$B743     ; Jump to #R$B743 if the object is not
                      ; used or is ignored.
 $B72A CALL $C5A9     ; Call #R$C5A9.
 $B72D JR NC,$B743    ; Jump to #R$B743 if they do not
                      ; overlap along x.
 $B72F CALL $C5BE     ; Call #R$C5BE.
 $B732 JR NC,$B743    ; Jump to #R$B743 if they do not
                      ; overlap along y.
 $B734 CALL $C5D3     ; Call #R$C5D3.
 $B737 JR NC,$B743    ; Jump to #R$B743 if they do not
                      ; overlap along z.
; The objects overlap on all three
; axes (and the carry flag is set), or
; there are none left to try (and it is
; not).
@label=TestObjectIntersections_Done
*$B739 POP IY         ; {Restore #REGiy, #REGhl, #REGde and #REGbc from the
 $B73B POP HL         ; stack.
 $B73C POP DE         ;
 $B73D POP BC         ; }
 $B73E RES 1,(IX+$07) ; Reset bit 1 of the object flags.
 $B742 RET            ; Return.
; Move on to the next object.
@label=TestObjectIntersections_NextObject
*$B743 LD DE,$0020    ; Set the size of an object record to
                      ; #N$20.
 $B746 ADD IY,DE      ; Move on to the next object.
 $B748 DJNZ $B725     ; Jump to #R$B725 until all of the
                      ; objects have been tested.
 $B74A AND A          ; Clear the carry flag.
 $B74B JR $B739       ; Jump to #R$B739.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$B4FD }
; { #PENTAGRAM$BF1B }
; LIST#

; Test Object Solid
;
; Used by the routines at #R$B712, #R$C497, #R$C4E6 and #R$C535.
; .
; Tests whether collision tests
; should take any notice of an object. The
; zero flag is set if the slot is unused or
; bit 1 of the flags is set.
;
;   IY The address of the object
; O:F Zero flag set if the slot is not used or the object is ignored
;
; Return if the slot is empty.
@label=TestObjectSolid
c$B74D LD A,(IY+$00) ; Fetch the sprite number of the
                     ; object.
 $B750 AND A         ; {Return if the slot is not used.
 $B751 RET Z         ; }
; After invert, bit 1 is set when the
; object is not ignored.
 $B752 LD A,(IY+$07) ; Fetch the flags of the object.
 $B755 CPL           ; Invert them.
 $B756 AND %00000010 ; Keep only bit 1.
 $B758 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$B538 }
; { #PENTAGRAM$B99B }
; LIST#

; Read Keyboard Port
;
; Used by the routines at #R$AB61, #R$B4A9, #R$B761, #R$B899, #R$BA7E, #R$C91B,
; #R$C979, #R$C9A5 and #R$CE22.
; .
; Reads some rows of the keyboard.
; The row selector is also written to port
; #N$FD (with the selector as the high byte
; of the address), which does nothing on a
; 48K Spectrum and is not part of any
; sound; the keyboard is read with the same
; selector straight afterwards.
;
;   A Row selector (a bit which is reset selects the row)
; O:A Keys pressed, in bits 0 to 4 (a bit is set when a key is pressed)
; O:F Zero flag set if no key is pressed
;
; Write the selector, then read the
; keys.
@label=ReadKeyboardPort
c$B759 OUT ($FD),A   ; Write the row selector to port
                     ; #N$FD.
 $B75B IN A,($FE)    ; Read the rows of the keyboard.
 $B75D CPL           ; Invert the bits, so that a bit is
                     ; set for a key which is pressed.
 $B75E AND %00011111 ; Keep only bits 0 to 4.
 $B760 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #CYBERUN$9BC3 }
; { #GUNFRIGHT$D0DB }
; { #KNIGHTLORE$B5F7 }
; { #NIGHTSHADE$E239 }
; { #PENTAGRAM$B952 }
; LIST#

; Game Over
;
; Used by the routines at #R$AD66, #R$AF79 and #R$CA07.
; .
; Ends the game. #R$AF05 is called,
; and then if #R$5B23 is set the completed
; message is shown first (see #R$B8A9). The
; game over screen shows "GAME OVER", a
; rating that depends on the rooms visited
; (#N$20 rooms to each of four ratings) and
; on #R$5B23, and the statistics. When a
; key has been pressed the screen is
; cleared and the objects of an ending
; scene are placed (see #R$B804). If the
; game was not completed this is the scene
; of the robot being beaten up, otherwise
; it is the scene of the robot ending its
; journey. The main loop is then entered
; at #R$A68E to run the scene.
; .
; #PUSHS #UDGTABLE { =h Game over screen }
; { #SIM(start=$A631,stop=$A676,sp=$F100,r=$80,clear=1)
; #SIM(start=$BA7E,stop=$BA95)
; #SIM(start=$A67F,stop=$A6FE)
; #SIM(start=$A715,stop=$A72E)
; #SIM(start=$B761,stop=$B7AE)
; #SCR$02(game-over) } UDGTABLE# #POPS
;
; .
;
; Update the valves and test whether
; the game is finished.
@label=GameOver
c$B761 CALL $AF05    ; Call #R$AF05.
 $B764 LD A,($5B23)  ; Fetch #R$5B23.
 $B767 AND A         ; {Jump to #R$B8A9 if it is not zero.
 $B768 JP NZ,$B8A9   ; }
; This entry point is used by the routine at #R$B8A9.
; .
; Show the game over screen.
@label=GameOver_ShowStatistics
*$B76B CALL $CE7B    ; Call #R$CE7B.
 $B76E CALL $CE73    ; Call #R$CE73.
 $B771 LD DE,$B94F   ; Point #REGde at #R$B94F.
 $B774 EXX           ; Switch to the shadow registers.
 $B775 LD HL,$B956   ; Point #REGhl at #R$B956.
 $B778 LD DE,$B964   ; Point #REGde at #R$B964.
 $B77B LD B,$07      ; Set the number of lines to #N$07.
 $B77D CALL $BC31    ; Call #R$BC31.
; Work out the rating from the rooms
; visited and from #R$5B23.
 $B780 CALL $B881    ; Call #R$B881.
 $B783 RLCA          ; Rotate the count.
 $B784 AND %11000000 ; Keep only bits 6 and 7.
 $B786 LD C,A        ; Keep it in #REGc.
 $B787 LD A,($5B23)  ; Fetch #R$5B23.
 $B78A AND %00000001 ; Keep only bit 0.
 $B78C OR C          ; Combine it with the room count.
 $B78D RLCA          ; {Rotate the result three times.
 $B78E RLCA          ;
 $B78F RLCA          ; }
 $B790 AND %00001110 ; Keep only bits 1 to 3.
 $B792 LD L,A        ; Keep it in #REGl.
 $B793 LD H,$00      ; Set #REGh to #N$00.
 $B795 LD BC,$B9DD   ; Point #REGbc at #R$B9DD.
 $B798 ADD HL,BC     ; Add the table address.
 $B799 LD E,(HL)     ; {Fetch the address of the message.
 $B79A INC HL        ;
 $B79B LD D,(HL)     ; }
 $B79C LD HL,$2758   ; Set the position of the message to
                     ; #N$2758.
 $B79F CALL $BBB1    ; Call #R$BBB1.
; Print the statistics.
 $B7A2 CALL $AC6B    ; Call #R$AC6B.
 $B7A5 CALL $BA36    ; Call #R$BA36.
 $B7A8 CALL $CB8A    ; Call #R$CB8A.
 $B7AB CALL $CE85    ; Call #R$CE85.
; Play the tune and wait for a key.
@label=GameOver_WaitForKeysReleased
*$B7AE XOR A         ; Select all of the keyboard rows.
 $B7AF CALL $B759    ; Call #R$B759.
 $B7B2 JR NZ,$B7AE   ; Jump to #R$B7AE if a key is pressed.
; #HTML(#AUDIO0(game-over-tune.wav)(#INCLUDE(GameOverTune)))
 $B7B4 LD DE,$B3F7   ; Point #REGde at #R$B3F7.
 $B7B7 CALL $B4A9    ; Call #R$B4A9.
 $B7BA LD B,$08      ; Set the length of the wait to #N$08.
 $B7BC CALL $B899    ; Call #R$B899.
; Start the ending scene.
 $B7BF LD A,$01      ; {Write #N$01 to *#R$5B24.
 $B7C1 LD ($5B24),A  ; }
 $B7C4 CALL $CE7B    ; Call #R$CE7B.
 $B7C7 CALL $CB8A    ; Call #R$CB8A.
 $B7CA CALL $CE85    ; Call #R$CE85.
 $B7CD CALL $CE4E    ; Call #R$CE4E.
 $B7D0 CALL $CE68    ; Call #R$CE68.
 $B7D3 LD A,($5B23)  ; Fetch #R$5B23.
 $B7D6 AND A         ; {Jump to #R$B7F0 if it is not zero.
 $B7D7 JR NZ,$B7F0   ; }
; The game was not completed.
 $B7D9 LD HL,$9F48   ; Set the position of the message to
                     ; #N$9F48.
 $B7DC LD DE,$B7F5   ; Point #REGde at #R$B7F5.
 $B7DF CALL $BBB1    ; Call #R$BBB1.
 $B7E2 LD DE,$B82A   ; Point #REGde at #R$B82A.
; Place the objects of the scene and
; run it.
@label=GameOver_StartScene
*$B7E5 CALL $B804    ; Call #R$B804.
 $B7E8 LD A,$01      ; {Write #N$01 to *#R$5B17.
 $B7EA LD ($5B17),A  ; }
 $B7ED JP $A68E      ; Jump to #R$A68E.
; The game was completed.
@label=GameOver_CompletedScene
*$B7F0 LD DE,$B853   ; Point #REGde at #R$B853.
 $B7F3 JR $B7E5      ; Jump to #R$B7E5.

; Messaging: Reprogramming
;
; The message that is shown while
; the thrusters are being reprogrammed,
; starting with its attribute. It is
; printed with #R$BBB1, and the last
; character has bit 7 set. In this font
; the character "<" is a hyphen.
@label=ReprogrammingMessage
t$B7F5 DEFB $C6                     ; #COLOUR(#PEEK(#PC)).
 $B7F6 DEFM "RE<PROGRAMMIN","G"+$80 ; "RE<PROGRAMMING"

; Place Scene Objects
;
; Used by the routine at #R$B761.
; .
; Places the objects of an ending
; scene in the table of objects, starting
; at #R$5B88. Each is described by five
; bytes: the sprite number, the flags, the
; colour, the pixel x position and the
; pixel y position. The list ends with a
; sprite number of zero.
;
; DE Address of the list of objects
;
; Start at the first object.
@label=PlaceSceneObjects
c$B804 LD IY,$5B88   ; Point #REGiy at #R$5B88.
 $B808 LD BC,$0020   ; Set the size of an object record to
                     ; #N$20.
; Copy the next object, or return at
; the terminator.
@label=PlaceSceneObjects_NextObject
*$B80B LD A,(DE)     ; Fetch the sprite number.
 $B80C INC DE        ; Move on.
 $B80D AND A         ; {Return if the list has ended.
 $B80E RET Z         ; }
 $B80F LD (IY+$00),A ; Set the sprite number of the object.
 $B812 LD A,(DE)     ; Fetch the flags.
 $B813 INC DE        ; Move on.
 $B814 LD (IY+$07),A ; Set the flags of the object.
 $B817 LD A,(DE)     ; Fetch the colour.
 $B818 INC DE        ; Move on.
 $B819 LD (IY+$10),A ; Set the colour of the object.
 $B81C LD A,(DE)     ; Fetch the pixel x position.
 $B81D INC DE        ; Move on.
 $B81E LD (IY+$1A),A ; Set the pixel x position of the
                     ; object.
 $B821 LD A,(DE)     ; Fetch the pixel y position.
 $B822 INC DE        ; Move on.
 $B823 LD (IY+$1B),A ; Set the pixel y position of the
                     ; object.
 $B826 ADD IY,BC     ; Move on to the next object.
 $B828 JR $B80B      ; Jump to #R$B80B.

; Game Over Scene
;
; The objects in the game over scene
; (see #R$B761). Each entry has five bytes:
; the sprite number, the flags, the colour,
; and the pixel x and y coordinates. The
; table ends with #N$00.
@label=GameOverScene
b$B82A DEFB $51,$10,$42,$B8,$50 ; Sprite #N($51), flags #N($10), colour
                                ; #COLOUR$42, at pixel position (#N($B8), #N$50).
                                ; #UDGTABLE { #SPRITE$51,attr=$42(boxing-glove-01-colour*) } UDGTABLE#
 $B82F DEFB $53,$10,$47,$20,$50 ; Sprite #N($53), flags #N($10), colour
                                ; #COLOUR$47, at pixel position (#N($20), #N$50).
                                ; #UDGTABLE { #SPRITE$53,attr=$47(hook-01-colour*) } UDGTABLE#
 $B834 DEFB $52,$10,$44,$78,$7C ; Sprite #N($52), flags #N($10), colour
                                ; #COLOUR$44, at pixel position (#N($78), #N$7C).
                                ; #UDGTABLE { #SPRITE$52,attr=$44(hammer-01-colour*) } UDGTABLE#
 $B839 DEFB $58,$10,$45,$68,$40 ; Sprite #N($58), flags #N($10), colour
                                ; #COLOUR$45, at pixel position (#N($68), #N$40).
                                ; #UDGTABLE { #SPRITE$58,attr=$45(robot-arm-left-01-colour*) } UDGTABLE#
 $B83E DEFB $59,$10,$45,$80,$40 ; Sprite #N($59), flags #N($10), colour
                                ; #COLOUR$45, at pixel position (#N($80), #N$40).
                                ; #UDGTABLE { #SPRITE$59,attr=$45(robot-arm-right-01-colour*) }
                                ; UDGTABLE#
 $B843 DEFB $5A,$10,$45,$70,$45 ; Sprite #N($5A), flags #N($10), colour
                                ; #COLOUR$45, at pixel position (#N($70), #N$45).
                                ; #UDGTABLE
                                ; { #SPRITE$5A,attr=$45(robot-bottom-turning-02-colour*) }
                                ; UDGTABLE#
 $B848 DEFB $5B,$10,$45,$70,$55 ; Sprite #N($5B), flags #N($10), colour
                                ; #COLOUR$45, at pixel position (#N($70), #N$55).
                                ; #UDGTABLE
                                ; { #SPRITE$5B,attr=$45(robot-top-turning-02-colour*) }
                                ; UDGTABLE#
 $B84D DEFB $50,$10,$46,$74,$68 ; Sprite #N($50), flags #N($10), colour
                                ; #COLOUR$46, at pixel position (#N($74), #N$68).
                                ; #UDGTABLE { #SPRITE$50,attr=$46(alarm-01-colour*) } UDGTABLE#
 $B852 DEFB $00                 ; Terminator.

; Game Completed Scene
;
; The objects in the game completed
; scene (see #R$B8A9). Each entry has five
; bytes: the sprite number, the flags, the
; colour, and the pixel x and y
; coordinates. The table ends with #N$00.
@label=GameCompletedScene
b$B853 DEFB $5C,$10,$07,$70,$80 ; Sprite #N($5C), flags #N($10), colour
                                ; #COLOUR$07, at pixel position (#N($70), #N$80).
                                ; #UDGTABLE
                                ; { #SPRITE$5C,attr=$07(robot-bottom-turning-02-completed*) }
                                ; UDGTABLE#
 $B858 DEFB $5D,$10,$07,$70,$90 ; Sprite #N($5D), flags #N($10), colour
                                ; #COLOUR$07, at pixel position (#N($70), #N$90).
                                ; #UDGTABLE
                                ; { #SPRITE$5D,attr=$07(robot-top-turning-02-completed*) }
                                ; UDGTABLE#
 $B85D DEFB $55,$10,$44,$6C,$20 ; Sprite #N($55), flags #N($10), colour
                                ; #COLOUR$44, at pixel position (#N($6C), #N$20).
                                ; #UDGTABLE { #SPRITE$55,attr=$44(pot-of-oil-01-colour*) } UDGTABLE#
 $B862 DEFB $00                 ; Terminator.

; Visit Room
;
; Used by the routine at #R$CAA2.
; .
; Sets the bit for the room that
; the player is in, in #R$5B58. The bit to
; set is chosen by changing the opcode of
; the instruction at #R$B87E.
;
; .
;
; #HTML(Work out the byte and the <code>SET n,(#REGhl)</code> opcode.)
@label=VisitRoom
c$B863 LD A,($5B90)  ; Fetch the room from
                     ; #R$5B88(#N$5B90).
 $B866 LD C,A        ; Keep it in #REGc.
 $B867 RRCA          ; {Divide the room by eight.
 $B868 RRCA          ;
 $B869 RRCA          ; }
 $B86A AND %00011111 ; Keep only bits 0 to 4.
 $B86C LD L,A        ; Keep it in #REGl.
 $B86D LD H,$00      ; Set #REGh to #N$00.
 $B86F LD A,C        ; Fetch the room again.
 $B870 RLCA          ; {Rotate the room three times.
 $B871 RLCA          ;
 $B872 RLCA          ; }
 $B873 AND %00111000 ; Keep only bits 3 to 5.
 $B875 OR %11000110  ; #HTML(Make it a <code>SET n,(#REGhl)</code> opcode.)
 $B877 LD ($B87F),A  ; Write the opcode to
                     ; #R$B87E(#N$B87F).
; Set the bit in the bitmap.
 $B87A LD BC,$5B58   ; {Point #REGhl at #R$5B58 plus the byte offset.
 $B87D ADD HL,BC     ; }
; #HTML(This <code>SET n,(#REGhl)</code> is self-modifying.)
@label=VisitRoom_Set
 $B87E SET 0,(HL)    ; Set the bit for the room.
 $B880 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$D219 }
; LIST#

; Count Rooms Visited
;
; Used by the routine at #R$B761.
; .
; Counts the bits which are set in
; #R$5B58.
;
; O:A The number of rooms visited, less one
;
; Count every set bit.
@label=CountRoomsVisited
c$B881 LD E,$00      ; Set the count to #N$00.
 $B883 LD BC,$0820   ; Set a counter of #N$08 bits and
                     ; #N$20 bytes.
 $B886 LD HL,$5B58   ; Point #REGhl at #R$5B58.
@label=CountRoomsVisited_NextByte
*$B889 PUSH BC       ; Stash the counters on the stack.
 $B88A LD A,(HL)     ; Fetch a byte of the table.
 $B88B INC HL        ; Move on.
@label=CountRoomsVisited_NextBit
*$B88C RRCA          ; Move a bit into the carry flag.
 $B88D JR NC,$B890   ; Jump to #R$B890 if the bit is not
                     ; set.
 $B88F INC E         ; Count the room.
@label=CountRoomsVisited_CountBits
*$B890 DJNZ $B88C    ; Jump to #R$B88C until all of the
                     ; bits have been done.
 $B892 POP BC        ; Restore the counters from the stack.
 $B893 DEC C         ; Count down the bytes.
 $B894 JR NZ,$B889   ; Jump to #R$B889 until all of the
                     ; bytes have been done.
 $B896 LD A,E        ; Copy the count to #REGa.
 $B897 DEC A         ; Subtract one from it.
 $B898 RET           ; Return.

; Wait For Key Press
;
; Used by the routines at #R$B761 and #R$B8A9.
; .
; Waits until a key is pressed or a
; time has passed. The time is #REGb counts
; of #REGhl from #N($0000,$04,$04) back to
; #N($0000,$04,$04).
;
; B Length of the wait
;
; Count down, reading the keyboard
; each time.
@label=WaitForKeyPress
c$B899 LD HL,$0000   ; Set #REGhl to #N($0000,$04,$04).
@label=WaitForKeyPress_Wait
*$B89C XOR A         ; Select all of the keyboard rows.
 $B89D CALL $B759    ; Call #R$B759.
 $B8A0 RET NZ        ; Return if a key is pressed.
 $B8A1 DEC HL        ; Count down.
 $B8A2 LD A,H        ; {Jump to #R$B89C if #REGhl is not
 $B8A3 OR L          ; zero.
 $B8A4 JR NZ,$B89C   ; }
 $B8A6 DJNZ $B89C    ; Jump to #R$B89C.
 $B8A8 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$BA9B }
; LIST#

; Game Completed
;
; Used by the routine at #R$B761.
; .
; Shows the message that the
; station has arrived, and plays the tune
; for the game being completed. It then
; carries on with the game over screen
; (see #R$B761(#N$B76B)).
; .
; #PUSHS #UDGTABLE { =h Game completed message }
; { #SIM(start=$A631,stop=$A676,sp=$F100,r=$80,clear=1)
; #SIM(start=$BA7E,stop=$BA95)
; #SIM(start=$B8A9,stop=$B8C2)
; #SCR$02(game-completed) } UDGTABLE# #POPS
;
; .
;
; Show the game completed message.
@label=GameCompleted
c$B8A9 CALL $CE7B    ; Call #R$CE7B.
 $B8AC CALL $CE73    ; Call #R$CE73.
 $B8AF LD DE,$B8D0   ; Point #REGde at #R$B8D0.
 $B8B2 EXX           ; Switch to the shadow registers.
 $B8B3 LD HL,$B8D7   ; Point #REGhl at #R$B8D7.
 $B8B6 LD DE,$B8E5   ; Point #REGde at #R$B8E5.
 $B8B9 LD B,$07      ; Set the number of lines to #N$07.
 $B8BB XOR A         ; {Write #N$00 to *#R$5B18.
 $B8BC LD ($5B18),A  ; }
 $B8BF CALL $BC31    ; Call #R$BC31.
; Play the tune and wait for a key.
; .
; #HTML(#AUDIO0(game-complete-tune.wav)(#INCLUDE(GameCompleteTune)))
 $B8C2 LD DE,$B437   ; Point #REGde at #R$B437.
 $B8C5 CALL $B4BA    ; Call #R$B4BA.
 $B8C8 LD B,$08      ; Set the length of the wait to #N$08.
 $B8CA CALL $B899    ; Call #R$B899.
 $B8CD JP $B76B      ; Jump to #R$B76B.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$BAAB }
; LIST#

