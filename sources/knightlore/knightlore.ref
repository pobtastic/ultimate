[Credits]
<div class="box box-1">
  This disassembly would have taken a lot longer to finish if it weren't for the
  research and documentation already done and made available by:
#LIST
  { <a href="https://mrcook.uk/">Michael R. Cook</a> }
  { tcdev, for the annotated disassembly of Knight Lore that Michael converted
    to SkoolKit }
LIST#
</div>

[Expand]
; A sprite of Knight Lore is a width byte (bits 0-3, with bits 6 and 7 that are
; changed as the sprite is drawn) and a height byte, followed by a mask byte and
; a data byte for every byte of every line, from the bottom line to the top.
; Only the data bytes are drawn here, which are at the odd offsets.
#DEF(#NOCROP(a,s,c)(f)
  #LET(e=$a+(((({height}+$07)/$08)*$08)*$s*$02)-$01)
  #LET(r=$s*$10)
  #UDGARRAY($s,$c,4,$s*$02,0,2)(($a)-({e})-$02-({r}))($f)
)

#DEF(#CROP(a,s,c)(f)
  #LET(e=$a+(((({height}+$07)/$08)*$08)*$s*$02)-$01)
  #LET(r=$s*$10)
  #LET(y=$04*($08-({height}%$08)))
  #LET(w=$04*$s*$08)
  #LET(h=$04*{height})
  #UDGARRAY($s,$c,4,$s*$02,0,2)(($a)-({e})-$02-({r})){$00,{y},{w},{h}}($f)
)

#DEF(#SPRITE(id,attr=$07)(fname)
  #LET(addr=#PEEK($7112+$id*$02)+#PEEK($7113+$id*$02)*$100)
  #LET(width=#PEEK({addr})&$0F)
  #LET(height=#PEEK({addr}+$01))
  #IF({height}%$08)(
    #CROP({addr}+$03,{width},$attr)($fname),
    #NOCROP({addr}+$03,{width},$attr)($fname)
  )
)

#DEF(#SPRITEDATA()(fname)
  #LET(width=#PEEK(#PC-$02)&$0F)
  #LET(height=#PEEK(#PC-$01))
  #IF({height}%$08)(
    #CROP(#PC+$01,{width},$07)($fname),
    #NOCROP(#PC+$01,{width},$07)($fname)
  )
)
