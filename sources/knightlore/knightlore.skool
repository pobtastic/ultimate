; Start Game
;
; Used by the routine at #R$6100.
; .
; Clears the whole game variables area (from #R$5BA0 up to the end of the
; objects table at #N$6108) and then carries on to set up a new game. The low
; byte of the system FRAMES counter is kept across the clear and used as the
; first random seed, so that every game plays differently.
@label=StartGame
c$AF6C LD HL,$5BA0   ; Set #REGhl to the start of the game variables.
 $AF6F LD BC,$0568   ; Set #REGbc to the number of bytes to clear.
 $AF72 LD A,($5C78)  ; Read the low byte of the FRAMES system variable.
 $AF75 PUSH AF       ; Stash it on the stack.
 $AF76 CALL $D53A    ; Clear the game variables.
 $AF79 POP AF        ; Restore the FRAMES value.
 $AF7A LD ($5BA0),A  ; Store it in #R$5BA0 as the first random seed.
 $AF7D JR $AF88      ; Jump to #R$AF88.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$A631 }
; LIST#

; Restart Game
;
; Used by the routine at #R$BA22.
; .
; Clears the variables that belong to a single game, leaving the random
; seeds and the chosen control method alone. This is used to go back to the
; game selection menu after a game has finished.
@label=RestartGame
c$AF7F LD HL,$5BA8   ; Set #REGhl to the first of the variables that are
                     ; cleared each game.
 $AF82 LD BC,$0560   ; Set #REGbc to the number of bytes to clear.
 $AF85 CALL $D53A    ; Clear the variables.
; Continue on to #R$AF88.

; Initialise Game
;
; Used by the routine at #R$AF6C.
; .
; Sets up everything needed to start a new game: builds the lookup tables,
; gives the player five lives, lets the player choose the control method on the
; menu, plays the start tune and then picks the random start location of the
; player and of the special objects.
; .
; #HTML(#AUDIO0(start-up-tune.wav)(#INCLUDE(StartUpTune)))
@label=InitialiseGame
c$AF88 CALL $D69E    ; Build the bit-reversal and bit-shifting lookup tables.
 $AF8B XOR A         ; {Write #N$00 to *#R$5BB2 (so the next room is drawn as the first
 $AF8C LD ($5BB2),A  ; one).}
 $AF8F LD ($D16D),A  ; Clear the counter and flags byte of the player's
                     ; scratchpad.
 $AF92 LD A,$05      ; {Set the number of lives to #N$05.
 $AF94 LD ($5BBA),A  ; }
 $AF97 LD HL,$5BA0   ; Point #REGhl at #R$5BA0.
 $AF9A LD A,($5BA2)  ; Fetch the low byte of the frame counter.
 $AF9D ADD A,(HL)    ; {Add it to the first random seed, to stir the seed up before the menu
 $AF9E LD (HL),A     ; is shown.}
 $AF9F CALL $D55F    ; Clear the screen to bright yellow on black.
 $AFA2 CALL $BD0C    ; Show the game selection menu and wait for the player's
                     ; choice.
 $AFA5 LD DE,$B20E   ; Point #REGde at #R$B20E.
 $AFA8 CALL $B2CF    ; Play the tune.
 $AFAB CALL $B544    ; Shuffle the order in which the special objects are asked
                     ; for.
 $AFAE CALL $D1B1    ; Pick a random starting location for the player.
 $AFB1 CALL $C46D    ; Initialise the sun and moon animation.
 $AFB4 CALL $C47E    ; Place the special objects at random locations.
; Continue on to #R$AFB7.

; Start Life
;
; Used by the routine at #R$AFBA.
; .
; Starts a new life: puts the player objects back into the objects table
; and takes a life off the total. If the player has none left the game is over.
@label=StartLife
c$AFB7 CALL $D12A    ; Restore the player objects, take a life off and choose the player's
                     ; graphics.
; Continue on to #R$AFBA.
; .
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$A688 }
; LIST#

; Run Game
;
; Used by the routine at #R$CA9A.
; .
; The main game loop. The first call builds the objects of the room the
; player is in. Then every pass of the loop visits each of the #N$28 objects in
; the objects table in turn, calling the routine for its graphic number from the
; jump table at #R$B096 to move and update it. Once every object has been dealt
; with the objects are sorted and drawn, the screen is brought up to date and
; the game waits a little (the more objects in view, the shorter the wait)
; before the next pass.
; .
; #PUSHS #UDGTABLE { =h After the first pass }
; { #SIM(start=$AF6C,stop=$AFA2,sp=$5BA0,clear=1)
; #SIM(start=$BD0C,stop=$BD23)
; #SIM(start=$AFAB,stop=$B02F,sp=$5BA0)
; #SIM(start=$B03F,stop=$B06E)
; #SIM(start=$D56F,stop=$0000,sp=$5B80)
; #SCR$02(run-game) } UDGTABLE# #POPS
@label=RunGame
c$AFBA CALL $D1E6    ; Build the objects for the room the player is in.
; Every pass of the main loop starts here. The random seed used by the
; fire is refreshed, then each object in the table is updated in turn.
@label=RunGame_Frame
*$AFBD LD A,($5BA2)  ; Fetch the frame counter.
 $AFC0 LD ($5BBC),A  ; Store it as the seed for the fire (it is stepped for
                     ; every object).
 $AFC3 LD IX,$5C08   ; Point #REGix at #R$5C08.
; Update the object that #REGix points at.
@label=RunGame_NextObject
*$AFC7 LD SP,$5BA0   ; Reset the stack pointer, as the update routines do not have to tidy
                     ; up the stack.
 $AFCA LD HL,$5BBC   ; Point #REGhl at #R$5BBC.
 $AFCD INC (HL)      ; Step the fire seed on.
 $AFCE LD HL,$AFE4   ; Point #REGhl at #R$AFE4.
 $AFD1 PUSH HL       ; Stash it on the stack, so that the update routine
                     ; returns there.
 $AFD2 CALL $CE49    ; Work out the screen position and size of the object, and keep a note
                     ; of its old ones.
; This entry point is used by the routine at #R$BF11.
@label=RunGame_UpdateObject
*$AFD5 LD L,(IX+$00) ; Fetch the graphic number of the object into #REGl.
 $AFD8 LD BC,$B096   ; Point #REGbc at #R$B096.
; This entry point is used by the routines at #R$B566, #R$B9CC, #R$C9FB and
; #R$CEBB.
; .
; Jump to the routine whose address is held in word #REGl of the table
; that #REGbc points at (#REGh is cleared first).
@label=RunGame_JumpToHandler
*$AFDB LD H,$00      ; Clear #REGh, so that #REGhl holds the graphic number.
 $AFDD ADD HL,HL     ; Double it to get the offset of a word in the table.
 $AFDE ADD HL,BC     ; Add the address of the table.
 $AFDF LD A,(HL)     ; Read the low byte of the routine address.
 $AFE0 INC HL        ; Move on to the high byte.
 $AFE1 LD H,(HL)     ; Read the high byte into #REGh.
 $AFE2 LD L,A        ; Put the low byte into #REGl.
 $AFE3 JP (HL)       ; Jump to the update routine.
; The update routine of each object returns here.
@label=RunGame_ObjectUpdated
 $AFE4 LD A,R        ; Read the refresh register, which is as good as random.
 $AFE6 LD C,A        ; Move it into #REGc.
 $AFE7 LD A,($5BA5)  ; Fetch the second random seed.
 $AFEA ADD A,C       ; Add the random value to it.
 $AFEB LD ($5BA5),A  ; Store it back as the new second seed.
 $AFEE LD BC,$0020   ; Set #REGbc to the size of an object.
 $AFF1 ADD IX,BC     ; Move #REGix on to the next object.
 $AFF3 PUSH IX       ; {Copy #REGix to #REGhl (using the stack).
 $AFF5 POP HL        ; }
 $AFF6 LD BC,$6108   ; Set #REGbc to the address just beyond the objects table.
 $AFF9 AND A         ; {Subtract it from #REGhl, to see if #REGix is past the end of the
 $AFFA SBC HL,BC     ; table.}
 $AFFC JR NC,$B000   ; Jump to #R$B000 if every object has been updated.
 $AFFE JR $AFC7      ; Jump back to #R$AFC7 for the next object.
; Every object has been updated; now finish the frame.
@label=RunGame_FinishFrame
*$B000 LD HL,($5BA2) ; Fetch the frame counter.
 $B003 INC HL        ; Increase it.
 $B004 LD ($5BA2),HL ; Store it again.
 $B007 LD A,($5BA5)  ; Fetch the second random seed.
 $B00A ADD A,(HL)    ; {Add the byte of the ROM that the frame counter points at, and the
 $B00B ADD A,L       ; frame counter itself, to it.
 $B00C ADD A,H       ; }
 $B00D LD ($5BA5),A  ; Store it as the new second seed.
 $B010 LD HL,$5BB2   ; Point #REGhl at #R$5BB2.
 $B013 SET 0,(HL)    ; Set bit 0, so that the special objects table gets updated the next
                     ; time round.
 $B015 CALL $D50E    ; Check for the pause key.
 $B018 CALL $B8A9    ; Create the bubbles of the cauldron if the player is in the cauldron
                     ; room.
 $B01B CALL $CE62    ; Make a list of the objects that need to be drawn.
 $B01E CALL $D59F    ; Draw the objects of the list into the screen buffer.
 $B021 LD A,($5BC5)  ; Fetch the rising blocks flag.
 $B024 AND A         ; Test it.
 $B025 CALL NZ,$B454 ; Play the sound of rising blocks if there are any.
; Slow the game down when few objects were drawn this frame: the delay is
; made up of as many short delay loops as the number of objects drawn is below
; #N$06.
 $B028 LD A,($5BBE)  ; Fetch the number of objects that were drawn.
 $B02B NEG           ; Negate it.
 $B02D ADD A,$06     ; Add #N$06 to it, to get the number of delay loops.
 $B02F LD B,A        ; Copy it into #REGb.
 $B030 JP M,$B03F    ; Jump to #R$B03F if it is negative (more than #N$06 objects were
                     ; drawn).
 $B033 JR Z,$B03F    ; Jump to #R$B03F if it is zero.
@label=RunGame_Delay
*$B035 LD HL,$0500   ; Set #REGhl to the number of times to count down for each
                     ; delay loop.
@label=RunGame_DelayLoop
*$B038 DEC HL        ; Decrement the counter.
 $B039 LD A,L        ; {Check whether the counter has reached zero.
 $B03A OR H          ; }
 $B03B JR NZ,$B038   ; Jump back to #R$B038 until the counter is zero.
 $B03D DJNZ $B035    ; Jump back to #R$B035 until all of the delay loops are
                     ; done.
; If a new room has just been entered, draw the panel and the scenery.
@label=RunGame_UpdateDisplay
*$B03F LD A,($5BB7)  ; Fetch the flag which says that the room has just been
                     ; drawn.
 $B042 AND A         ; {Jump to #R$B074 if it is zero.
 $B043 JR Z,$B074    ; }
 $B045 XOR A         ; {Reset the flag.
 $B046 LD ($5BB7),A  ; }
 $B049 LD A,($5BAD)  ; Fetch the attribute of the room.
 $B04C CALL $D556    ; Colour the whole screen with it.
 $B04F CALL $BF4E    ; Draw the objects the player is carrying.
 $B052 CALL $D2EF    ; Colour the panel.
 $B055 CALL $D30D    ; Colour the sun and moon window.
 $B058 CALL $D255    ; Draw the panel.
 $B05B LD IX,$C44D   ; Point #REGix at #R$C44D.
 $B05F CALL $C3A4    ; Draw the sun or moon.
 $B062 CALL $BCCA    ; Draw the day number.
 $B065 CALL $BC66    ; Draw the number of days.
 $B068 CALL $BC7A    ; Draw the lives graphics.
 $B06B CALL $BCA3    ; Print the number of lives.
 $B06E CALL $D56F    ; Copy the screen buffer to the display.
 $B071 CALL $B088    ; Reset the wipe flag of all of the objects.
; Start another frame, or lose a life if the player is gone.
@label=RunGame_Continue
*$B074 XOR A         ; {Write #N$00 to *#R$5BC5 (the rising blocks flag).
 $B075 LD ($5BC5),A  ; }
 $B078 LD IX,$5C08   ; Point #REGix at #R$5C08.
 $B07C LD A,(IX+$00) ; Fetch the graphic number of the bottom half of the
                     ; player.
 $B07F OR (IX+$20)   ; Combine it with the graphic number of the top half of
                     ; the player.
 $B082 JP Z,$AFB7    ; Jump to #R$AFB7 if neither half is present, as the player has been
                     ; killed.
 $B085 JP $AFBD      ; Jump back to #R$AFBD for another pass of the game loop.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$A68B }
; LIST#

; Reset Wipe Flags
;
; Used by the routine at #R$AFBA.
; .
; Clears the wipe flag (bit 5 of the flags byte) of every object in the
; objects table, now that the whole screen has been redrawn.
@label=ResetWipeFlags
c$B088 LD B,$28      ; Set #REGb to the number of objects in the table.
 $B08A LD DE,$0020   ; Set #REGde to the size of an object.
 $B08D LD HL,$5C0F   ; Point #REGhl at the flags byte of the first object.
@label=ResetWipeFlags_Loop
*$B090 RES 5,(HL)    ; Reset the wipe flag of the object.
 $B092 ADD HL,DE     ; Move on to the flags byte of the next object.
 $B093 DJNZ $B090    ; Decrease the object counter and loop back to #R$B090 until all of
                     ; the objects have been done.
 $B095 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$A7DC }
; { #PENTAGRAM$BF0D }
; LIST#

; Update Routine Table
;
; One routine address for each of the graphic numbers #N$00 to #N$BB that
; an object in the objects table can have. #R$AFDB jumps to the entry for the
; object being updated.
@label=UpdateRoutineTable
w$B096 DEFW $C2CB    ; {Graphic numbers #N$00 and #N$01 have nothing to update.
 $B098 DEFW $C2CB    ; }
 $B09A DEFW $C73C    ; Stone arch, near side.
 $B09C DEFW $C722    ; Stone arch, far side.
 $B09E DEFW $C73C    ; Tree arch, near side.
 $B0A0 DEFW $C722    ; Tree arch, far side.
 $B0A2 DEFW $C4E3    ; {Rock and block.
 $B0A4 DEFW $C4E3    ; }
 $B0A6 DEFW $C65E    ; Portcullis, stationary.
 $B0A8 DEFW $C6BD    ; Portcullis, moving.
 $B0AA DEFW $C4E8    ; Bricks.
 $B0AC DEFW $C4ED    ; More bricks.
 $B0AE DEFW $C4F2    ; {Even more bricks.
 $B0B0 DEFW $C4F2    ;
 $B0B2 DEFW $C4F2    ;
 $B0B4 DEFW $C4F2    ; }
 $B0B6 DEFW $C823    ; {Legs of the human form of the player.
 $B0B8 DEFW $C823    ;
 $B0BA DEFW $C823    ;
 $B0BC DEFW $C823    ;
 $B0BE DEFW $C823    ;
 $B0C0 DEFW $C823    ; }
 $B0C2 DEFW $B7A3    ; Gargoyle.
 $B0C4 DEFW $B7E7    ; Spikes.
 $B0C6 DEFW $C823    ; {More legs of the human form of the player.
 $B0C8 DEFW $C823    ;
 $B0CA DEFW $C823    ;
 $B0CC DEFW $C823    ;
 $B0CE DEFW $C823    ;
 $B0D0 DEFW $C823    ; }
 $B0D2 DEFW $B9A5    ; {Top half of a moving guard.
 $B0D4 DEFW $B9A5    ; }
 $B0D6 DEFW $CDDA    ; {Top half of the human form of the player.
 $B0D8 DEFW $CDDA    ;
 $B0DA DEFW $CDDA    ;
 $B0DC DEFW $CDDA    ;
 $B0DE DEFW $CDDA    ;
 $B0E0 DEFW $CDDA    ;
 $B0E2 DEFW $CDDA    ;
 $B0E4 DEFW $CDDA    ;
 $B0E6 DEFW $CDDA    ;
 $B0E8 DEFW $CDDA    ;
 $B0EA DEFW $CDDA    ;
 $B0EC DEFW $CDDA    ;
 $B0EE DEFW $CDDA    ;
 $B0F0 DEFW $CDDA    ;
 $B0F2 DEFW $CDDA    ;
 $B0F4 DEFW $CDDA    ; }
 $B0F6 DEFW $C828    ; {Legs of the wulf form of the player.
 $B0F8 DEFW $C828    ;
 $B0FA DEFW $C828    ;
 $B0FC DEFW $C828    ;
 $B0FE DEFW $C828    ;
 $B100 DEFW $C828    ; }
