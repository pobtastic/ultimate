i$5B00

; Random Seed 1
;
; The first seed that the game uses for random numbers. At the start of a
; game it is set to the low byte of the FRAMES system variable, and it counts up
; while the menu waits for the player to start. The game uses it to choose the
; room that the player starts in, the starting places of the special objects and
; the number of times that the objects that the player must collect are
; shuffled. This is the top of the stack, which grows down from here.
@label=RandomSeed1
g$5BA0 DEFB $00

; Unused
u$5BA1 DEFB $00

; Frame Counter
;
; Counts the frames of the game, which also makes it an address that moves
; through the ROM, so that the bytes that it finds there can be used as random
; numbers. The low bits of it time the animations of the game.
@label=FrameCounter
g$5BA2 DEFW $0000

; Control Method
;
; The way that the player chose to control the game on the menu.
; #TABLE(default,centre,left)
; { =h Bits | =h Meaning }
; { #N$03 | The controls are directional (a joystick that moves the player in
; the direction that it is pushed) }
; { #N$01-#N$02 | #N$00 is the keyboard, #N$01 is the Kempston joystick, #N$02
; is the Cursor joystick and #N$03 is the Interface II joystick }
; TABLE#
@label=ControlMethod
g$5BA4 DEFB $00

; Random Seed 2
;
; The second seed that the game uses for random numbers. It changes every
; time that the game updates an object, and every frame, by adding in the
; refresh register, the frame counter and the byte that the frame counter points
; at.
@label=RandomSeed2
g$5BA5 DEFB $00

; Previous Control Method
;
; The control method as it was before the keys of the menu were read, so
; that the menu can tell when a key has changed it and beep.
@label=PreviousControlMethod
g$5BA6 DEFB $00

; Unused
u$5BA7 DEFB $00

; Wiped Area Count
;
; The number of areas of the screen that the game has to copy to the
; screen at the end of this frame, because the objects in them moved. The
; variables from here onwards are cleared at the start of every game.
@label=WipedAreaCount
g$5BA8 DEFB $00

; Saved Stack Pointer
;
; The stack pointer, which is kept here while the sprite routine is using
; the stack pointer to read the data of a sprite.
@label=SavedStackPointer
g$5BA9 DEFW $0000

; Room Size X
;
; The distance in the X direction from the middle of the room (#N$80) to
; its walls, which comes from the table of room sizes at #R$6248.
@label=RoomSizeX
g$5BAB DEFB $00

; Room Size Y
;
; The distance in the Y direction from the middle of the room (#N$80) to
; its walls, which comes from the table of room sizes at #R$6248.
@label=RoomSizeY
g$5BAC DEFB $00

; Room Attribute
;
; The attribute that the room is coloured with, which is the bright colour
; that is stored in the room data.
@label=RoomAttribute
g$5BAD DEFB $00

; Floor Height
;
; The Z coordinate of the floor of the room, which comes from the table of
; room sizes at #R$6248. It is #N$80 in every room.
@label=FloorHeight
g$5BAE DEFB $00

; Portcullis Moving Flag
;
; Is non-zero while a portcullis is moving up or down.
@label=PortcullisMovingFlag
g$5BAF DEFB $00

; Portcullis Lower Count
;
; The number of times that the portcullis in the room has been lowered
; since the room was entered.
@label=PortcullisLowerCount
g$5BB0 DEFB $00

; Transform Flag
;
; Is zero when the player is not changing form. The sun and the moon set
; it to #N$01 when it is time for the player to change from a human to a wulf or
; back. Then, when the transformation starts, it is set to the graphic number of
; the legs of the player, which is used to give the player the right form again
; when it ends.
@label=TransformFlag
g$5BB1 DEFB $00

; Not First Room Flag
;
; Is zero until the first frame of the game has been run, and non-zero
; after that. The game uses it to avoid saving the special objects of a room
; that the player has not been in yet when it builds the first room.
@label=NotFirstRoomFlag
g$5BB2 DEFB $00

; Pickup Drop Pressed Flag
;
; Is non-zero while the control for picking up or dropping an object is
; held down, so that holding it does not pick up and drop an object on every
; frame.
@label=PickupDropPressedFlag
g$5BB3 DEFB $00

; Objects Carried Changed Flag
;
; Is non-zero when the objects that the player is carrying have changed,
; to tell the game that it has to show them in the panel again.
@label=ObjectsCarriedChangedFlag
g$5BB4 DEFB $00

; Controls Pressed
;
; The controls that are pressed, which are read by #R$D022 and tested by
; the routines that need them.
; #TABLE(default,centre,left)
; { =h Bit | =h Control }
; { #N$00 | Left }
; { #N$01 | Right }
; { #N$02 | Forward }
; { #N$03 | Jump }
; { #N$04 | Pick up or drop (or down, with the directional controls) }
; { #N$05 | Pick up or drop, with the directional controls }
; TABLE#
@label=ControlsPressed
g$5BB5 DEFB $00

; Text Attribute
;
; The attribute that the text that is being printed is coloured with.
@label=TextAttribute
g$5BB6 DEFB $00

; Redraw Panel Flag
;
; Is non-zero when the panel, the border, the sun or moon and the other
; information of the screen have to be drawn again, which is when a new room has
; been built. It is cleared when the game loop has drawn them.
@label=RedrawPanelFlag
g$5BB7 DEFB $00

; Border Drawn Flag
;
; Is non-zero when the border has been drawn around the message on the
; screen. It is cleared when the menu and the end of the game are started, so
; that they draw the border.
@label=BorderDrawnFlag
g$5BB8 DEFB $00

; Days
;
; The number of days that have passed, as two binary coded decimal digits.
@label=Days
g$5BB9 DEFB $00

; Lives
;
; The number of lives that the player has left. It is printed as two
; binary coded decimal digits, but #R$D13F and #R$C1DD change it with DEC and
; INC, so it is only right while it is below #N$0A.
@label=Lives
g$5BBA DEFB $00

; Charms
;
; The number of objects that have been put into the cauldron.
@label=Charms
g$5BBB DEFB $00

; Fire Seed
;
; A number that is set to the frame counter at the start of every frame
; and goes up by one for each object that is updated. A fire that stays where it
; is uses its lowest bit to decide whether to change its graphic.
@label=FireSeed
g$5BBC DEFB $00

; Ball Bounce Height
;
; The Z coordinate that a ball that bounces up and down reaches before it
; falls again. It is zero until the ball starts to bounce.
@label=BallBounceHeight
g$5BBD DEFB $00

; Objects Drawn
;
; The number of objects that were drawn on this frame, which the game uses
; to work out how long to wait before the next frame, so that every frame takes
; about the same time.
@label=ObjectsDrawn
g$5BBE DEFB $00

; Spiked Ball Dropping Flag
;
; Is non-zero while the spiked ball is falling.
@label=SpikedBallDroppingFlag
g$5BBF DEFB $00

; Spiked Ball Hold Flag
;
; Is non-zero when the spiked ball is not allowed to drop. It is set from
; the first bit of the room number when the room is built, and it is cleared
; when the player picks up an object.
@label=SpikedBallHoldFlag
g$5BC0 DEFB $00

; Player Fall Speed
;
; The speed of the player in the Z direction on the last frame, which is
; kept while the player moves, to find out if it has landed.
@label=PlayerFallSpeed
g$5BC1 DEFB $00

; Ball Fall Speed
;
; The speed of the ball that bounces in the Z direction on the last frame,
; which is kept while the ball moves, to find out if it has landed.
@label=BallFallSpeed
g$5BC2 DEFB $00

; Final Animation Flag
;
; Is non-zero when all of the objects have been put into the cauldron and
; the game is ending.
@label=FinalAnimationFlag
g$5BC3 DEFB $00

; Object In Cauldron Flag
;
; Is non-zero while an object that the player has dropped is falling into
; the cauldron.
@label=ObjectInCauldronFlag
g$5BC4 DEFB $00

; Sparkle Height
;
; The Z coordinate of a sparkle that has moved up on this frame, which the
; game loop uses to play the sound of rising sparkles. It is cleared on every
; frame.
@label=SparkleHeight
g$5BC5 DEFB $00

; Rooms Visited
;
; The number of rooms that the player has been in, not counting the first
; one, which is worked out by #R$BC10 for the results screen.
@label=RoomsVisited
g$5BC6 DEFB $00

; Font Pointer
;
; The address of the font that the text routines use, which is the font at
; #R$6108.
@label=FontPointer
g$5BC7 DEFW $0000

; Percent Complete
;
; The percentage of the game that has been completed. It is stored as four
; binary coded decimal digits, with the digits of hundreds at #N$5BC9 and the
; digits of tens and units at #N$5BCA.
@label=PercentComplete
g$5BC9 DEFB $00
 $5BCA DEFB $00

; Drawing List Pointer
;
; A pointer into the list of objects to draw, which the routine that wipes
; the sprites keeps while it works.
@label=DrawingListPointer
g$5BCB DEFW $0000

; First List Position
;
; The place in the list of objects that are drawn of the first of the two
; objects that the depth sort is comparing.
@label=FirstListPosition
g$5BCD DEFW $0000

; Second List Position
;
; The place in the list of objects that are drawn of the second of the two
; objects that the depth sort is comparing.
@label=SecondListPosition
g$5BCF DEFW $0000

; Tune Played Flag
;
; Is non-zero when the tune that was started with #R$B2B6 has been played
; once.
@label=TunePlayedFlag
g$5BD1 DEFB $00

; Directional Key Pressed Flag
;
; Bit 0 is set while the key that switches on the directional controls is
; held on the menu, so that holding it does not switch it on and off again.
@label=DirectionalKeyPressedFlag
g$5BD2 DEFB $00

; No Room To Drop Flag
;
; Is non-zero when there is not enough room to drop an object where the
; player stands.
@label=NoRoomToDropFlag
g$5BD3 DEFB $00

; Unused
u$5BD4 DEFB $00,$00,$00,$00

; Objects Carried
;
; The objects that the player is carrying. There is a place for four of
; them, each with four bytes, but the first is only used while an object is
; being picked up, so that the player can carry three. The last of the three is
; the one that has been carried for longest, and the one that is dropped first.
; #TABLE(default,centre,left)
; { =h Byte | =h Contents }
; { #N$00 | The graphic number of the object, or #N$00 if there is not one }
; { #N$01 | The flags of the object }
; { #N$02-#N$03 | The address of the object in the table of special objects }
; TABLE#
@label=ObjectsCarried
g$5BD8 DEFB $00,$00,$00,$00 ; The object that has just been picked up.
@label=ObjectsCarried_Newest
 $5BDC DEFB $00,$00,$00,$00 ; The object that has been carried for the least
                            ; time.
 $5BE0 DEFB $00,$00,$00,$00 ; The object that has been carried for a time
                            ; between the others.
@label=ObjectsCarried_Oldest
 $5BE4 DEFB $00,$00,$00,$00 ; The object that has been carried for the longest
                            ; time.

; Rooms Visited Bitmap
;
; A bit for each of the #N$100 rooms of the game, which is set when the
; player has been in the room. The room number is split in two, with the top
; five bits choosing the byte and the low three bits choosing the bit in the
; byte. The bits are counted by #R$BC10 for the results screen.
@label=RoomsVisitedBitmap
g$5BE8 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5BF0 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5BF8 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5C00 DEFB $00,$00,$00,$00,$00,$00,$00,$00

; Objects Table
;
; The table of the objects in the room, with #N$20 bytes for each of up to
; #N$28 objects. The last object in the table has its final eight bytes in the
; same place as the code of #R$6100, which is not needed once the game has
; started. The table is cleared at the start of the game, and the room objects
; are built by #R$D3C6. The first two objects are the two halves of the player,
; the next two are the objects that the player can pick up in the room, and
; after those are the objects that make up the room.
; The bytes of an object are:
; #TABLE(default,centre,left)
; { =h Byte | =h Contents }
; { #N$00 | The graphic number (#N$00 if there is no object) }
; { #N$01-#N$03 | The X, Y and Z coordinates }
; { #N$04-#N$06 | The width, depth and height }
; { #N$07 | The flags: bit 0 is set near an arch, bit 1 if the object is
; ignored, bit 2 if it can be moved, bit 4 to draw it, bit 5 to wipe it, bit 6
; to flip it from left to right and bit 7 to flip it upside down }
; { #N$08 | The number of the room }
; { #N$09-#N$0B | The speeds in the X, Y and Z directions }
; { #N$0C | Bits 0-2 are set if the object is blocked in the X, Y and Z
; directions, bit 3 if it is jumping, and bits 4-7 count while it is entering
; the room }
; { #N$0D | Bit 7 is set if the object destroys what it hits, bit 5 if it is
; destroyed by what hits it, bit 6 if it has been destroyed and bit 3 if
; something stands on it }
; { #N$0E-#N$0F | The speed of the object in the X and Y direction as changed by
; an arch }
; { #N$10-#N$11 | The graphic to use while the player appears, or the address of
; the object in the table of special objects }
; { #N$12-#N$13 | The adjustments to the pixel X and Y coordinates of the sprite
; }
; { #N$18-#N$19 | The width in bytes and the height in lines of the sprite }
; { #N$1A-#N$1B | The pixel X and Y coordinates of the sprite }
; { #N$1C-#N$1F | The width, height, pixel X and pixel Y coordinates that the
; sprite had when it was last drawn }
; TABLE#
@label=ObjectsTable
g$5C08 DEFS $20      ; The bottom half of the player.
 $5C28 DEFS $20      ; The top half of the player.
@label=ObjectsTable_FirstSpecial
 $5C48 DEFS $20      ; The first special object of the room.
@label=ObjectsTable_SecondSpecial
 $5C68 DEFS $20      ; The second special object of the room.
@label=ObjectsTable_RoomObjects
 $5C88 DEFS $20      ; {The objects of the room, which are built from the room
 $5CA8 DEFS $20      ; data.
 $5CC8 DEFS $20      ;
 $5CE8 DEFS $20      ;
 $5D08 DEFS $20      ;
 $5D28 DEFS $20      ;
 $5D48 DEFS $20      ;
 $5D68 DEFS $20      ;
 $5D88 DEFS $20      ;
 $5DA8 DEFS $20      ;
 $5DC8 DEFS $20      ;
 $5DE8 DEFS $20      ;
 $5E08 DEFS $20      ;
 $5E28 DEFS $20      ;
 $5E48 DEFS $20      ;
 $5E68 DEFS $20      ;
 $5E88 DEFS $20      ;
 $5EA8 DEFS $20      ;
 $5EC8 DEFS $20      ;
 $5EE8 DEFS $20      ;
 $5F08 DEFS $20      ;
 $5F28 DEFS $20      ;
 $5F48 DEFS $20      ;
 $5F68 DEFS $20      ;
 $5F88 DEFS $20      ;
 $5FA8 DEFS $20      ;
 $5FC8 DEFS $20      ;
 $5FE8 DEFS $20      ;
 $6008 DEFS $20      ;
 $6028 DEFS $20      ;
 $6048 DEFS $20      ;
 $6068 DEFS $20      ;
 $6088 DEFS $20      ;
 $60A8 DEFS $20      ;
 $60C8 DEFS $20      ; }
 $60E8 DEFS $18      ; The first part of the last object in the table.

; Game Entry Point
;
; The first instruction run by the tape loader once the game has been
; loaded. The game uses #N$5BA0 as the top of its stack, so the stack grows down
; into the printer buffer, and then it jumps to #R$AF6C to start a new game.
@label=GameEntry
c$6100 DI            ; Disable interrupts.
 $6101 LD SP,$5BA0   ; Set the stack pointer to #N$5BA0.
 $6104 NOP           ; No operation.
 $6105 JP $AF6C      ; Jump to #R$AF6C.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$6300 }
; LIST#

; Font
;
; The font that the game prints its text with, which has #N$28 characters
; of eight bytes each. A character in a message is its number in the font: #N$00
; to #N$09 are the digits, #N$0A to #N$23 are the letters A to Z, #N$24 is a
; full stop, #N$25 is the copyright symbol, #N$26 is a space and #N$27 is a
; percent sign.
@label=Font
