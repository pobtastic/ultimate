; Block Type Table
;
; The address of the list of objects that makes up each type of block that
; the rooms can have, which #R$D3F0 uses to build the foreground objects of a
; room.
@label=BlockTypeTable
w$6BD1 DEFW $6C0B    ; Type #N$00: Block.
 $6BD3 DEFW $6C3C    ; Type #N$01: Fire.
 $6BD5 DEFW $6C43    ; Type #N$02: Ball Offset Y.
 $6BD7 DEFW $6C66    ; Type #N$03: Rock.
 $6BD9 DEFW $6C6D    ; Type #N$04: Gargoyle.
 $6BDB DEFW $6C74    ; Type #N$05: Spikes.
 $6BDD DEFW $6C90    ; Type #N$06: Chest.
 $6BDF DEFW $6C97    ; Type #N$07: Table.
 $6BE1 DEFW $6C9E    ; Type #N$08: Guard East West.
 $6BE3 DEFW $6CB8    ; Type #N$09: Ghost.
 $6BE5 DEFW $6CBF    ; Type #N$0A: Fire North South.
 $6BE7 DEFW $6C12    ; Type #N$0B: High Block.
 $6BE9 DEFW $6C4A    ; Type #N$0C: Ball Offset XY.
 $6BEB DEFW $6CAB    ; Type #N$0D: Guard Square.
 $6BED DEFW $6C19    ; Type #N$0E: Block East West.
 $6BEF DEFW $6C20    ; Type #N$0F: Block North South.
 $6BF1 DEFW $6C27    ; Type #N$10: Moveable Block.
 $6BF3 DEFW $6C7B    ; Type #N$11: High Spikes.
 $6BF5 DEFW $6C82    ; Type #N$12: Spiked Ball.
 $6BF7 DEFW $6C89    ; Type #N$13: High Spiked Ball.
 $6BF9 DEFW $6CC6    ; Type #N$14: Fire East West.
 $6BFB DEFW $6C2E    ; Type #N$15: Dropping Block.
 $6BFD DEFW $6C35    ; Type #N$16: Collapsing Block.
 $6BFF DEFW $6C5F    ; Type #N$17: Bouncing Ball.
 $6C01 DEFW $6C51    ; Type #N$18: Ball.
 $6C03 DEFW $6CCD    ; Type #N$19: Repel Spell.
 $6C05 DEFW $6CD4    ; Type #N$1A: Portcullis Along X.
 $6C07 DEFW $6CDB    ; Type #N$1B: Portcullis Along Y.
 $6C09 DEFW $6C58    ; Type #N$1C: Ball Offset X.

; Block Types
;
; The objects that make up each type of block, which are in the table at
; #R$6BD1. A list has a group of six bytes for every object, which ends with a
; zero byte. The bytes of an object are described by this table.
; #TABLE(default,centre,left)
; { =h Byte | =h Contents }
; { #N$00 | The graphic number }
; { #N$01-#N$03 | The width, depth and height }
; { #N$04 | The flags }
; { #N$05 | The offsets of the position: bit 0 is half a step of X, bit 1 is
; half a step of Y, and bits 2-7 are added to the Z coordinate }
; TABLE#
;
; .
;
; Block.
@label=BlockTypes
@label=BlockType_Block
b$6C0B DEFB $07,$08,$08,$0C,$10,$00 ; Graphic #N$07 (block), #N$08 by #N$08 by
                                    ; #N$0C, flags: drawn.
 $6C11 DEFB $00                     ; Terminator.
; High Block.
@label=BlockType_High_Block
 $6C12 DEFB $07,$08,$08,$0C,$10,$30 ; Graphic #N$07 (block), #N$08 by #N$08 by #N$0C, flags: drawn,
                                    ; offsets #N$30.
 $6C18 DEFB $00                     ; Terminator.
; Block East West.
@label=BlockType_Block_East_West
 $6C19 DEFB $36,$08,$08,$0C,$10,$00 ; Graphic #N$36 (block), #N$08 by #N$08 by
                                    ; #N$0C, flags: drawn.
 $6C1F DEFB $00                     ; Terminator.
