i$F0F3

; Reversed Byte Table
;
; The table of every byte with its bits in the opposite order, which is
; built by #R$D69E. It is used to flip sprites from left to right.
@label=ReversedByteTable
g$F100 DEFS $20      ; {The reversed byte for each value from #N$00 to #N$FF.
 $F120 DEFS $20      ;
 $F140 DEFS $20      ;
 $F160 DEFS $20      ;
 $F180 DEFS $20      ;
 $F1A0 DEFS $20      ;
 $F1C0 DEFS $20      ;
 $F1E0 DEFS $20      ; }

; Shifted Byte Tables
;
; The tables of shifted bytes that are built by #R$D69E and used to draw a
; sprite that does not start on a byte boundary. There are two pages for each
; shift of one to seven bits to the right, with the first page of the pair at
; #N$F0 plus twice the shift, so the table for a shift of one bit starts at
; #N$F200 and the table for a shift of seven bits starts at #N$FE00. The first
; page of a pair has the inverse of the byte after it has been shifted to the
; right, and the second has the inverse of the bits that were pushed out of the
; byte, which go into the next byte of the line.
@label=ShiftedByteTables
g$F200 DEFS $0200    ; {Two pages for each of the seven shifts, from one bit to
 $F400 DEFS $0200    ; seven.
 $F600 DEFS $0200    ;
 $F800 DEFS $0200    ;
 $FA00 DEFS $0200    ;
 $FC00 DEFS $0200    ;
 $FE00 DEFS $0200    ; }
