; Start Game Tune
;
; The tune played just before a new game starts. Each byte holds a note in
; bits 0-5 (the index of a note in #R$B332, where #N$00 is a rest) and the
; length of the note in bits 6-7 (#N$00 to #N$03 for one to four times the basic
; length of the note). The tune ends with #N$FF. #R$B2CF plays it.
; .
; #HTML(#AUDIO0(start-up-tune.wav)(#INCLUDE(StartUpTune)))
@label=StartGameTune
b$B20E DEFB $59,$5C,$5B,$54,$19
 $B213 DEFB $17,$14,$17,$D9,$FF

; Game Over Tune
;
; The tune played when the game is over, in the same note format as
; #R$B20E.
; .
; #HTML(#AUDIO0(game-over-tune.wav)(#INCLUDE(GameOverTune)))
@label=GameOverTune
b$B218 DEFB $2E,$17,$27,$17,$2E,$17,$27,$17
 $B220 DEFB $2C,$19,$27,$19,$2C,$19,$27,$19
 $B228 DEFB $2A,$1B,$27,$1B,$2A,$1B,$27,$1B
 $B230 DEFB $2A,$1B,$27,$1B,$2A,$1B,$27,$1B
 $B238 DEFB $FF

; Game Complete Tune
;
; The tune played when the player has completed the game, in the same note
; format as #R$B20E.
; .
; #HTML(#AUDIO0(game-complete-tune.wav)(#INCLUDE(GameCompleteTune)))
@label=GameCompleteTune
b$B239 DEFB $1B,$1D,$1E,$1B,$1D,$1E,$20,$1D
 $B241 DEFB $1E,$20,$22,$1E,$1D,$1E,$20,$1D
 $B249 DEFB $1B,$1D,$1E,$1B,$1A,$1B,$1D,$1A
 $B251 DEFB $9B,$FF

