; #HTML(#AUDIO0(main-tune.wav)(#INCLUDE(MainTune)))
@label=MenuTune
b$B253 DEFB $1B,$27,$1B,$27,$1B,$2A,$2E,$1B
 $B25B DEFB $27,$1B,$27,$1B,$2A,$1B,$2E,$16
 $B263 DEFB $25,$16,$24,$16,$22,$16,$22,$16
 $B26B DEFB $25,$16,$24,$16,$22,$16,$22,$16
 $B273 DEFB $22,$1B,$27,$1B,$27,$1B,$2A,$2E
 $B27B DEFB $1B,$27,$1B,$27,$1B,$2A,$1B,$2E
 $B283 DEFB $16,$25,$16,$24,$16,$22,$16,$22
 $B28B DEFB $16,$25,$16,$24,$16,$22,$16,$22
 $B293 DEFB $16,$22,$17,$2E,$17,$2E,$17,$2E
 $B29B DEFB $17,$2E,$19,$2E,$19,$2E,$19,$2E
 $B2A3 DEFB $19,$2E,$1B,$2E,$1B,$2E,$1B,$2E
 $B2AB DEFB $1B,$2E,$1B,$2E,$1B,$2E,$1B,$2E
 $B2B3 DEFB $1B,$2E,$FF

; Play Music Once
;
; Used by the routine at #R$BD0C.
; .
; Plays the tune that #REGde points at, but only if no tune has been
; played since the flag was last cleared. The flag is set at the same time, so
; that the tune is only ever played once.
;
; DE Address of the tune
@label=PlayMusicOnce
c$B2B6 LD HL,$5BD1   ; Point #REGhl at the flag that says a tune has been
                     ; played.
 $B2B9 LD A,(HL)     ; {Return if the flag is already set.
 $B2BA AND A         ;
 $B2BB RET NZ        ; }
 $B2BC SET 0,(HL)    ; Set the flag and carry on to play the tune.
; Continue on to #R$B2BE.
; .
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B4A1 }
; { #GUNFRIGHT$AF76 }
; { #NIGHTSHADE$C63D }
; { #PENTAGRAM$D69C }
; LIST#

; Play Music Until Key Pressed
;
; Used by the routine at #R$BA22.
; .
; Plays the tune that #REGde points at, one note at a time, and stops as
; soon as any key is pressed. The keyboard is only checked between notes.
;
; DE Address of the tune
@label=PlayMusic_WaitKey
c$B2BE XOR A         ; Select every row of the keyboard.
 $B2BF CALL $B5F7    ; Read the keyboard.
 $B2C2 JR Z,$B2C5    ; Jump to #R$B2C5 if no key is being pressed.
 $B2C4 RET           ; Return, as a key has been pressed.
@label=PlayMusic_WaitKey_Process
*$B2C5 LD A,(DE)     ; Fetch the next note of the tune.
 $B2C6 CP $FF        ; {Jump to #R$B2D9 if it is the end marker.
 $B2C8 JR Z,$B2D9    ; }
 $B2CA CALL $B2DA    ; Play the note.
 $B2CD JR $B2BE      ; Jump back to #R$B2BE for the next note.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B4A9 }
; LIST#

; Play Music
;
; Used by the routines at #R$AF88 and #R$BAAB.
; .
; Plays the tune that #REGde points at, from beginning to end.
; .
; The tunes played by this routine are:
; #TABLE(default,centre,centre)
; { =h Tune | =h Sound }
; { Start-up Tune | #HTML(#AUDIO0(start-up-tune.wav)(#INCLUDE(StartUpTune))) }
; { Game Over Tune | #HTML(#AUDIO0(game-over-tune.wav)(#INCLUDE(GameOverTune)))
; }
; { Game Complete Tune |
; #HTML(#AUDIO0(game-complete-tune.wav)(#INCLUDE(GameCompleteTune))) }
; { Main Tune | #HTML(#AUDIO0(main-tune.wav)(#INCLUDE(MainTune))) }
; TABLE#
;
; DE Address of the tune
@label=PlayMusic
c$B2CF LD A,(DE)     ; Fetch the next note of the tune.
 $B2D0 CP $FF        ; {Jump to #R$B2D9 if it is the end marker.
 $B2D2 JR Z,$B2D9    ; }
 $B2D4 CALL $B2DA    ; Play the note.
 $B2D7 JR $B2CF      ; Jump back to #R$B2CF for the next note.
; This entry point is used by the routine at #R$B2BE.
@label=PlayMusic_Return
*$B2D9 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B4BA }
; { #CYBERUN$9AA9 }
; { #GUNFRIGHT$AF8F }
; { #NIGHTSHADE$C656 }
; { #PENTAGRAM$D6B5 }
; { #SABREWULF$BD6E }
; { #COOKIE$6568 }
; LIST#

; Play Note
;
; Used by the routines at #R$B2BE and #R$B2CF.
; .
; Plays one note of a tune, or pauses for the length of the note if it is
; a rest. The note is a square wave made by switching the speaker on and off, so
; the game is stopped while it plays. Bits 0-5 of the note are the number of the
; note (see #R$B332), and bits 6-7 are the length of the note, which is one to
; four times the basic length of the note.
;
;   A The note
;   DE Address of the note
; O:DE Address of the next note
@label=PlayNote
c$B2DA AND %00111111 ; Isolate the number of the note.
 $B2DC JR Z,$B31C    ; Jump to #R$B31C if it is a rest.
; Look up the delays and the number of cycles in the table at #R$B332.
 $B2DE LD L,A        ; {Multiply the number of the note by three.
 $B2DF LD H,$00      ;
 $B2E1 ADD HL,HL     ;
 $B2E2 CALL $D4F2    ; }
 $B2E5 LD BC,$B332   ; {Point #REGhl at the entry of the note in the table.
 $B2E8 ADD HL,BC     ; }
 $B2E9 LD B,(HL)     ; {Fetch the first byte of the delay between the clicks of
 $B2EA INC HL        ; the speaker.}
 $B2EB LD C,(HL)     ; {Fetch the second byte of the delay.
 $B2EC INC HL        ; }
 $B2ED LD L,(HL)     ; {Fetch the basic length of the note.
 $B2EE LD H,$00      ; }
; Bits 6 and 7 of the note are the length, less one.
 $B2F0 LD A,(DE)     ; {Fetch the note again and rotate bits 6-7 of it into the
 $B2F1 RLCA          ; low bits.
 $B2F2 RLCA          ; }
 $B2F3 AND %00000011 ; Isolate the length of the note.
 $B2F5 INC A         ; Make it one to four.
 $B2F6 PUSH DE       ; Save the address of the note.
 $B2F7 LD E,L        ; {Copy the basic length into #REGde.
 $B2F8 LD D,H        ; }
; Multiply the number of cycles by the length of the note.
@label=PlayNote_Multiply
*$B2F9 DEC A         ; {Jump to #R$B2FF when the basic length has been added
 $B2FA JR Z,$B2FF    ; enough times.}
 $B2FC ADD HL,DE     ; Add the basic length to the total.
 $B2FD JR $B2F9      ; Jump back to #R$B2F9.
@label=PlayNote_MultiplyDone
*$B2FF POP DE        ; Restore the address of the note.
; Each pass of this loop makes one cycle of the note, so the length of the
; note is the number of cycles.
@label=PlayNote_Cycle
*$B300 PUSH BC       ; Save the delay.
 $B301 XOR A         ; {Switch the speaker off.
 $B302 OUT ($FE),A   ; }
@label=PlayNote_OffDelay
*$B304 DJNZ $B304    ; Wait with the speaker off, using the first byte of the delay for the
                     ; first pass and #N$0100 for each pass after it.
 $B306 DEC C         ; {Decrease the second byte of the delay and jump back to #R$B304 until
 $B307 JR NZ,$B304   ; it is zero.}
 $B309 POP BC        ; {Restore the delay, and save it again.
 $B30A PUSH BC       ; }
 $B30B LD A,$10      ; {Switch the speaker on.
 $B30D OUT ($FE),A   ; }
@label=PlayNote_OnDelay
*$B30F DJNZ $B30F    ; Wait with the speaker on for the same length of time.
 $B311 DEC C         ; {Decrease the second byte of the delay and jump back to #R$B30F until
 $B312 JR NZ,$B30F   ; it is zero.}
 $B314 POP BC        ; Restore the delay.
 $B315 DEC HL        ; Decrease the number of cycles left to play.
 $B316 LD A,H        ; {Jump back to #R$B300 until there are none left.
 $B317 OR L          ;
 $B318 JR NZ,$B300   ; }
 $B31A INC DE        ; Point at the next note.
 $B31B RET           ; Return.
; A rest is a silent pause, which is made by waiting one to four times.
@label=PlayNote_Rest
*$B31C LD A,(DE)     ; Fetch the length of the rest.
 $B31D INC DE        ; Point at the next note.
 $B31E RLCA          ; {Rotate bits 6-7 of the note into the low bits.
 $B31F RLCA          ; }
 $B320 AND %00000011 ; Isolate the length of the rest.
 $B322 INC A         ; Make it one to four.
 $B323 LD L,A        ; Set the number of times to wait in #REGl.
 $B324 LD BC,$430B   ; Set the length of the wait.
@label=PlayNote_RestUnit
*$B327 PUSH BC       ; Save the length of the wait.
@label=PlayNote_RestDelay
*$B328 DEC BC        ; Decrease the length of the wait.
 $B329 LD A,B        ; {Jump back to #R$B328 until the length of the wait is
 $B32A OR C          ; zero.
 $B32B JR NZ,$B328   ; }
 $B32D POP BC        ; Restore the length of the wait.
 $B32E DEC L         ; Decrease the number of times to wait.
 $B32F JR NZ,$B327   ; Jump back to #R$B327 until it is zero.
 $B331 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B4C5 }
; { #CYBERUN$9AB4 }
; { #GUNFRIGHT$AF9A }
; { #NIGHTSHADE$C661 }
; { #PENTAGRAM$D6C0 }
; { #SABREWULF$BD7B }
; LIST#

; Music Note Table
;
; The three bytes for each of the notes, where the notes are numbered from
; #N$00. The first two bytes are the delay between the clicks of the speaker,
; which is shorter for the higher notes, and the third is the basic length of
; the note, which is the number of cycles of the note to play. #R$B2DA uses it.
@label=MusicNotes
b$B332 DEFB $00,$00,$00 ; The rest has no delay and no length, as the rest does not use
                        ; the table.
 $B335 DEFB $F4,$0A,$08 ; {The notes #N$01 to #N$3C.
 $B338 DEFB $65,$0A,$09 ;
 $B33B DEFB $DE,$09,$09 ;
 $B33E DEFB $5E,$09,$0A ;
 $B341 DEFB $E7,$08,$0A ;
 $B344 DEFB $75,$08,$0B ;
 $B347 DEFB $0A,$08,$0C ;
 $B34A DEFB $A5,$07,$0C ;
 $B34D DEFB $45,$07,$0D ;
 $B350 DEFB $EB,$06,$0E ;
 $B353 DEFB $96,$06,$0F ;
 $B356 DEFB $46,$06,$0F ;
 $B359 DEFB $FA,$05,$10 ;
 $B35C DEFB $B3,$05,$11 ;
 $B35F DEFB $6F,$05,$12 ;
 $B362 DEFB $2F,$05,$13 ;
 $B365 DEFB $F3,$04,$15 ;
 $B368 DEFB $F3,$04,$16 ;
 $B36B DEFB $85,$04,$17 ;
 $B36E DEFB $52,$04,$19 ;
 $B371 DEFB $23,$04,$1A ;
 $B374 DEFB $F6,$03,$1C ;
 $B377 DEFB $CB,$03,$1D ;
 $B37A DEFB $A3,$03,$1F ;
 $B37D DEFB $7D,$03,$21 ;
 $B380 DEFB $59,$03,$23 ;
 $B383 DEFB $38,$03,$25 ;
 $B386 DEFB $18,$03,$27 ;
 $B389 DEFB $FA,$02,$29 ;
 $B38C DEFB $DD,$02,$2C ;
 $B38F DEFB $C2,$02,$2E ;
 $B392 DEFB $A9,$02,$31 ;
 $B395 DEFB $91,$02,$34 ;
 $B398 DEFB $7B,$02,$37 ;
 $B39B DEFB $66,$02,$3A ;
 $B39E DEFB $51,$02,$3E ;
 $B3A1 DEFB $3F,$02,$41 ;
 $B3A4 DEFB $2D,$02,$45 ;
 $B3A7 DEFB $1C,$02,$49 ;
 $B3AA DEFB $0C,$02,$4E ;
 $B3AD DEFB $FD,$01,$52 ;
 $B3B0 DEFB $EF,$01,$57 ;
 $B3B3 DEFB $E2,$01,$5D ;
 $B3B6 DEFB $D5,$01,$62 ;
 $B3B9 DEFB $C9,$01,$68 ;
 $B3BC DEFB $BD,$01,$6E ;
 $B3BF DEFB $B3,$01,$75 ;
 $B3C2 DEFB $A9,$01,$7B ;
 $B3C5 DEFB $9F,$01,$83 ;
 $B3C8 DEFB $96,$01,$8B ;
 $B3CB DEFB $8E,$01,$93 ;
 $B3CE DEFB $86,$01,$9C ;
 $B3D1 DEFB $7E,$01,$A5 ;
 $B3D4 DEFB $77,$01,$AF ;
 $B3D7 DEFB $71,$01,$B9 ;
 $B3DA DEFB $6A,$01,$C4 ;
 $B3DD DEFB $64,$01,$D0 ;
 $B3E0 DEFB $5F,$01,$DC ;
 $B3E3 DEFB $59,$01,$E9 ;
 $B3E6 DEFB $54,$01,$F7 ; }

; Play Pitch From Table
;
; Used by the routine at #R$C4AA.
; .
; Plays four cycles of a tone whose pitch is taken from the eight values
; of #R$B3FB, which is chosen by the lowest three bits of the frame counter.
@label=PlayPitchFromTable
c$B3E9 LD A,($5BA2)  ; Fetch the frame counter.
 $B3EC AND %00000111 ; Keep the lowest three bits.
 $B3EE LD L,A        ; {Set #REGhl to the number of the entry in the table.
 $B3EF LD H,$00      ; }
 $B3F1 LD BC,$B3FB   ; Point #REGbc at #R$B3FB.
 $B3F4 ADD HL,BC     ; Add the entry number to the address of the table.
 $B3F5 LD B,(HL)     ; Fetch the pitch.
 $B3F6 LD C,$04      ; Set the number of cycles to play.
 $B3F8 JP $B4E6      ; Play the tone.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B5D4 }
; LIST#
; .
; #HTML(#AUDIO0(block-sound.wav)(#INCLUDE(BlockSound)))

; Pitch Table
;
; The eight pitches that #R$B3E9 picks from.
@label=PitchTable
b$B3FB DEFB $A0,$B0,$C0,$90,$A0,$E0,$80,$60

; Play Sparkle Sound
;
; Used by the routines at #R$BF2B and #R$C2A5.
; .
; Plays a burst of noise for the sparkles of a dying player. The pitch of
; each cycle comes from the bytes of the ROM, starting at #N$1234, and the
; number of cycles depends on the sprite number of the sparkle, so each stage of
; the sparkles sounds different.
;
; IX Address of the sparkle object
@label=PlaySparkleSound
c$B403 LD A,(IX+$00) ; Fetch the graphic number of the sparkle.
 $B406 CPL           ; Invert it.
 $B407 AND %00011111 ; Keep the lowest five bits to get the number of notes to
                     ; play.
 $B409 LD E,A        ; Set #REGe to the number of notes.
 $B40A LD HL,$1234   ; Point #REGhl at the ROM bytes that are used as noise.
@label=PlaySparkleSound_NextBeep
*$B40D LD A,(HL)     ; Fetch the next byte of noise.
 $B40E INC HL        ; Move on to the next one.
 $B40F LD B,A        ; Use it as the pitch.
 $B410 LD C,$02      ; Set the number of cycles to play.
 $B412 CALL $B4E6    ; Play the tone.
 $B415 DEC E         ; {Decrease the note counter and loop back to #R$B40D until all of the
 $B416 JR NZ,$B40D   ; notes have been played.}
 $B418 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B5EE }
; LIST#
; .
; #HTML(#AUDIO0(sparkles-sound.wav)(#INCLUDE(SparklesSound)))

; Play Appearing Sound
;
; Used by the routine at #R$BEFE.
; .
; Plays the rising sound of the sparkles that show the player appearing.
; The number of cycles depends on the sprite number of the sparkle.
;
; IX Address of the sparkle object
@label=PlayAppearingSound
c$B419 LD A,(IX+$00) ; Fetch the graphic number of the sparkle.
 $B41C RLCA          ; {Rotate it left twice.
 $B41D RLCA          ; }
 $B41E AND %00011111 ; Keep the lowest five bits.
 $B420 OR %00000011  ; Make sure that there are at least three cycles.
 $B422 LD C,A        ; Set #REGc to the number of cycles.
@label=PlayAppearingSound_NextBeep
*$B423 LD A,C        ; Fetch the cycle counter.
 $B424 RLCA          ; {Multiply it by four to get the pitch.
 $B425 RLCA          ; }
 $B426 LD B,A        ; Set #REGb to the pitch.
 $B427 CALL $B4ED    ; Play a single cycle of the tone.
 $B42A DEC C         ; {Decrease the cycle counter and loop back to #R$B423 until it is
 $B42B JR NZ,$B423   ; zero.}
 $B42D RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B604 }
; LIST#
; .
; #HTML(#AUDIO0(appearing-sound.wav)(#INCLUDE(AppearingSound)))

; Play Bump Sound
;
; Used by the routines at #R$B5FF, #R$B80F and #R$B865.
; .
; Plays four short bursts of a tone, whose pitches come from the first
; four bytes of the ROM, for a ball hitting the floor.
@label=PlayBumpSound
c$B42E LD HL,$0000   ; Point #REGhl at the start of the ROM.
 $B431 LD E,$04      ; Set the number of bursts to play.
@label=PlayBumpSound_NextBurst
*$B433 LD C,$03      ; Set the number of cycles of each burst.
 $B435 LD A,(HL)     ; Fetch the next byte of the ROM.
 $B436 INC HL        ; Move on to the next one.
 $B437 OR %11000000  ; Make it a high pitch by setting its top two bits.
 $B439 LD B,A        ; Set #REGb to the pitch.
 $B43A CALL $B4E6    ; Play the tone.
 $B43D DEC E         ; {Decrease the burst counter and loop back to #R$B433 until all of the
 $B43E JR NZ,$B433   ; bursts have been played.}
 $B440 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B619 }
; LIST#
; .
; #HTML(#AUDIO0(bounce-sound.wav)(#INCLUDE(BounceSound)))

; Play Jump Sound
;
; Used by the routine at #R$C948.
; .
; Plays a sweep of single cycles for the player jumping.
@label=PlayJumpSound
c$B441 LD C,$20      ; Set the number of cycles.
@label=PlayJumpSound_NextBeep
*$B443 LD A,C        ; Fetch the cycle counter.
 $B444 RRCA          ; {Rotate it to get the pitch.
 $B445 RRCA          ;
 $B446 RRCA          ;
 $B447 RRCA          ;
 $B448 RRCA          ; }
 $B449 LD B,A        ; Set #REGb to the pitch.
 $B44A CALL $B4ED    ; Play a single cycle of the tone.
 $B44D DEC C         ; {Decrease the cycle counter and loop back to #R$B443 until it is
 $B44E JR NZ,$B443   ; zero.}
 $B450 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B62C }
; LIST#
; .
; #HTML(#AUDIO0(jump-sound.wav)(#INCLUDE(JumpSound)))

; Play Sound From Height
;
; Used by the routines at #R$B683, #R$B7A9, #R$B865 and #R$C9A1.
; .
; Plays a tone for an object that is falling, with a pitch taken from the
; height of the object (its Z coordinate).
;
; IX Address of the object
@label=PlaySoundFromHeight
c$B451 LD A,(IX+$03) ; Fetch the Z coordinate of the object.
; Continue on to #R$B454.
; .
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B63C }
; LIST#
; .
; #HTML(#AUDIO0(falling-sound.wav)(#INCLUDE(FallingSound)))

; Play Sound From Value
;
; Used by the routines at #R$AFBA, #R$B45D, #R$B462 and #R$B467.
; .
; Plays six cycles of a tone whose pitch is worked out from the value in
; #REGa.
;
; A Value that the pitch is made from
@label=PlaySoundFromHeight_PlaySoundFromValue
c$B454 CPL           ; Invert the value.
 $B455 RLCA          ; {Multiply it by four to get the pitch.
 $B456 RLCA          ; }
 $B457 LD B,A        ; Set #REGb to the pitch.
 $B458 LD C,$06      ; Set the number of cycles.
 $B45A JP $B4E6      ; Play the tone.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B63F }
; LIST#
; .
; #HTML(#AUDIO0(rising-sound.wav)(#INCLUDE(RisingSound)))

; Play Sound From X Position
;
; Used by the routines at #R$B6B9 and #R$B7ED.
; .
; Plays the tone for an object that is moving east or west, with a pitch
; taken from its X coordinate.
; .
; #HTML(#AUDIO0(block-east-west-sound.wav)(#INCLUDE(BlockEastWestSound)))
;
; IX Address of the object
@label=PlaySoundFromXPosition
c$B45D LD A,(IX+$01) ; Fetch the X coordinate of the object.
 $B460 JR $B454      ; Jump to #R$B454.

; Play Sound From Y Position
;
; Used by the routines at #R$B6B1 and #R$B80F.
; .
; Plays the tone for an object that is moving north or south, with a pitch
; taken from its Y coordinate.
; .
; #HTML(#AUDIO0(block-north-south-sound.wav)(#INCLUDE(BlockNorthSouthSound)))
;
; IX Address of the object
@label=PlaySoundFromYPosition
c$B462 LD A,(IX+$02) ; Fetch the Y coordinate of the object.
 $B465 JR $B454      ; Jump to #R$B454.

; Play Sound From Position
;
; Used by the routines at #R$C232, #R$C5C8 and #R$C6BD.
; .
; Plays the tone for a special object, a ghost or a portcullis that is
; moving, with a pitch made from the sum of its three coordinates.
;
; IX Address of the object
@label=PlaySoundFromPosition
c$B467 LD A,(IX+$01)  ; Fetch the X coordinate of the object.
 $B46A ADD A,(IX+$02) ; Add the Y coordinate.
 $B46D ADD A,(IX+$03) ; Add the Z coordinate.
 $B470 JR $B454       ; Jump to #R$B454.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B654 }
; LIST#
; .
; #HTML(#AUDIO0(moving-sound.wav)(#INCLUDE(MovingSound)))

; Play Sound From Object Number
;
; Used by the routine at #R$C337.
; .
; Plays the warbling sound of the player turning into a wulf or back into
; a human. The number of cycles depends on the sprite number of the
; transformation.
;
; IX Address of the object
@label=PlaySoundFromObjectNumber
c$B472 LD A,(IX+$00) ; Fetch the graphic number of the object.
 $B475 RLCA          ; {Rotate it left three times.
 $B476 RLCA          ;
 $B477 RLCA          ; }
 $B478 AND %00011000 ; Keep bits 3 and 4.
 $B47A ADD A,$10     ; Add #N$10 to get the number of cycles.
 $B47C LD C,A        ; Set #REGc to the number of cycles.
@label=PlaySoundFromObjectNumber_NextBeep
*$B47D LD A,C        ; Fetch the cycle counter.
 $B47E XOR %01010101 ; Mix it up to get a wide range of pitches.
 $B480 ADD A,C       ; Add the cycle counter again.
 $B481 LD B,A        ; Set #REGb to the pitch.
 $B482 CALL $B4ED    ; Play a single cycle of the tone.
 $B485 DEC C         ; {Decrease the cycle counter and loop back to #R$B47D until it is
 $B486 JR NZ,$B47D   ; zero.}
 $B488 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B65F }
; LIST#
; .
; #HTML(#AUDIO0(transform-sound.wav)(#INCLUDE(TransformSound)))

; Play Random Noise
;
; Used by the routine at #R$C6BD.
; .
; Plays sixteen short bursts of a tone for the portcullis coming to rest.
; The pitches come from a random place in the first #N$2000 bytes of the ROM.
; .
; #HTML(#AUDIO0(explosion.wav)(#INCLUDE(Explosion)))
@label=PlayRandomNoise
c$B489 LD A,($5BA5)  ; Fetch the second random seed.
 $B48C LD L,A        ; Use it as the low byte of a ROM address.
 $B48D LD A,($5BA2)  ; Fetch the frame counter.
 $B490 AND %00011111 ; Keep the lowest five bits.
 $B492 LD H,A        ; Use it as the high byte of the ROM address.
 $B493 LD E,$10      ; Set the number of bursts to play.
@label=PlayRandomNoise_NextBeep
*$B495 LD A,(HL)     ; Fetch the next byte of the ROM.
 $B496 INC HL        ; Move on to the next one.
 $B497 AND %01111111 ; Keep the lowest seven bits.
 $B499 LD B,A        ; Use it as the pitch.
 $B49A LD C,$02      ; Set the number of cycles of each burst.
 $B49C CALL $B4E6    ; Play the tone.
 $B49F DEC E         ; {Decrease the burst counter and loop back to #R$B495 until all of the
 $B4A0 JR NZ,$B495   ; bursts have been played.}
 $B4A2 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B676 }
; { #SABREWULF$BEEE }
; LIST#

; Play Low Beep
;
; Used by the routines at #R$BD0C, #R$C00E and #R$C1AB.
; .
; Plays a low beep, which is sixteen cycles of a low tone. It tells the
; player that something has happened.
; .
; #HTML(#AUDIO0(beep-sound.wav)(#INCLUDE(BeepSound)))
@label=PlayLowBeep
c$B4A3 LD BC,$8010   ; Set the pitch and the number of cycles.
 $B4A6 JR $B4E6      ; Play the tone.

; Play Middle Beep
;
; Used by the routine at #R$D50E.
; .
; Plays a beep of twenty-four cycles, with a higher pitch than #R$B4A3. It
; is the sound of the game being paused and of it carrying on again.
; .
; #HTML(#AUDIO0(pause-sound.wav)(#INCLUDE(PauseSound)))
@label=PlayMiddleBeep
c$B4A8 LD BC,$5018   ; Set the pitch and the number of cycles.
 $B4AB JR $B4E6      ; Play the tone.

; Play Guard Footsteps Sound
;
; Used by the routine at #R$B6F9.
; .
; Plays the footsteps of a guard or the wizard, but only on every other
; frame of the walking animation. It carries on into #R$B4C6 with a fixed pitch.
;
; IX Address of the object
@label=PlayGuardFootstepsSound
c$B4AD LD A,(IX+$00) ; Fetch the graphic number of the object.
 $B4B0 AND %00000001 ; Test whether it is an odd frame of the animation.
 $B4B2 RET NZ        ; Return if it is.
 $B4B3 LD B,$80      ; Set the pitch.
 $B4B5 LD A,($5BA2)  ; Fetch the frame counter.
 $B4B8 CPL           ; Invert it.
 $B4B9 JR $B4C6      ; Jump to #R$B4C6.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B6C0 }
; LIST#
; .
; #HTML(#AUDIO0(guard-footstep-sound.wav)(#INCLUDE(GuardFootstepSound)))

; Play Footsteps Sound
;
; Used by the routine at #R$C969.
; .
; Plays the footsteps of the player walking, but only on every other frame
; of the walking animation. The number of cycles comes from the position of the
; player on the screen. The entry point at #R$B4C1 plays them on every frame.
;
; IX Address of the object
@label=PlayFootstepsSound
c$B4BB LD A,(IX+$00) ; Fetch the graphic number of the object.
 $B4BE AND %00000001 ; Test whether it is an odd frame of the animation.
 $B4C0 RET NZ        ; Return if it is.
; This entry point is used by the routine at #R$C89F.
@label=PlayFootstepsSound_EveryFrame
*$B4C1 LD B,$60      ; Set the pitch.
 $B4C3 LD A,($5BA2)  ; Fetch the frame counter.
; This entry point is used by the routine at #R$B4AD.
; .
; One time in two the pitch is made from the height of the object instead.
@label=PlayFootstepsSound_Position
*$B4C6 BIT 1,A       ; {Jump to #R$B4D1 if a random bit of the seed is not set.
 $B4C8 JR Z,$B4D1    ; }
 $B4CA LD A,(IX+$03) ; Fetch the Z coordinate of the object.
 $B4CD CPL           ; Invert it.
 $B4CE SRL A         ; Halve it.
 $B4D0 LD B,A        ; Use it as the pitch.
; The number of cycles is the high nibble of half of the X coordinate
; added to half of the negated Y coordinate, which is the horizontal position on
; the screen.
@label=PlayFootstepsSound_Cycles
*$B4D1 LD A,(IX+$01) ; Fetch the X coordinate of the object.
 $B4D4 SRL A         ; Halve it.
 $B4D6 LD C,A        ; Stash it in #REGc.
 $B4D7 LD A,(IX+$02) ; Fetch the Y coordinate of the object.
 $B4DA NEG           ; Negate it.
 $B4DC SRL A         ; Halve it.
 $B4DE ADD A,C       ; Add the halved X coordinate.
 $B4DF RRCA          ; {Move the high nibble into the low nibble.
 $B4E0 RRCA          ;
 $B4E1 RRCA          ;
 $B4E2 RRCA          ; }
 $B4E3 AND %00001111 ; Keep the low nibble.
 $B4E5 LD C,A        ; Use it as the number of cycles.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B6CE }
; LIST#
; .
; #HTML(#AUDIO0(footstep-sound.wav)(#INCLUDE(FootstepSound)))

; Play Wave Sequence
;
; Used by the routines at #R$B3E9, #R$B403, #R$B42E, #R$B454, #R$B489, #R$B4A3
; and #R$B4A8.
; .
; Plays a tone made of a number of cycles with the same pitch.
;
; B Pitch of the tone (smaller values are higher)
; C Number of cycles
@label=PlayWaveSequence
c$B4E6 CALL $B4ED    ; Play a single cycle of the tone.
 $B4E9 DEC C         ; {Decrease the cycle counter and loop back to #R$B4E6 until all of the
 $B4EA JR NZ,$B4E6   ; cycles have been played.}
 $B4EC RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B6FB }
; { #GUNFRIGHT$AF5F }
; { #PENTAGRAM$D67B }
; LIST#

; Play Square Wave
;
; Used by the routines at #R$B419, #R$B441, #R$B472 and #R$B4E6.
; .
; Plays one cycle of a tone by setting the speaker output high, waiting,
; setting it low and waiting again.
;
; B Pitch of the tone (smaller values are higher)
@label=PlaySquareWave
c$B4ED LD A,$10      ; {Set the speaker output high.
 $B4EF OUT ($FE),A   ; }
 $B4F1 LD A,B        ; Keep the pitch in #REGa.
@label=PlaySquareWave_FirstDelay
*$B4F2 DJNZ $B4F2    ; Wait for the high part of the cycle.
 $B4F4 LD B,A        ; Restore the pitch.
 $B4F5 XOR A         ; {Set the speaker output low.
 $B4F6 OUT ($FE),A   ; }
 $B4F8 LD A,B        ; Keep the pitch in #REGa.
@label=PlaySquareWave_SecondDelay
*$B4F9 DJNZ $B4F9    ; Wait for the low part of the cycle.
 $B4FB LD B,A        ; Restore the pitch.
 $B4FC RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B702 }
; { #CYBERUN$71E0 }
; { #GUNFRIGHT$AF66 }
; { #NIGHTSHADE$C471 }
; { #PENTAGRAM$D682 }
; { #SABREWULF$BF74 }
; LIST#

; Test Object Intersections
;
; Used by the routine at #R$C00E.
; .
; Tests whether the object that #REGix points at overlaps any other solid
; object in the objects table, without it moving. The object itself is flagged
; to be ignored while the table is searched. All registers are preserved.
;
;   IX Address of the object
; O:F Carry flag set if the object intersects another object
@label=TestObjectIntersections
c$B4FD PUSH BC        ; {Stash the registers on the stack.
 $B4FE PUSH DE        ;
 $B4FF PUSH HL        ;
 $B500 PUSH IY        ; }
 $B502 LD IY,$5C08    ; Point #REGiy at #R$5C08.
 $B506 LD B,$28       ; Set #REGb to the number of objects in the table.
 $B508 LD C,$00       ; Set the speed in X to test with to zero.
 $B50A LD L,C         ; Set the speed in Y to zero.
 $B50B LD H,C         ; Set the speed in Z to zero.
 $B50C SET 1,(IX+$07) ; Flag the object as ignored in the 3D calculations, so that it does
                      ; not intersect itself.
; Test whether this object overlaps on all three axes.
@label=TestObjectIntersections_TestObject
*$B510 CALL $B538     ; Test whether the object of the table is solid.
 $B513 JR Z,$B52E     ; Jump to #R$B52E if it is not.
 $B515 CALL $CC9D     ; Test whether the objects overlap in X.
 $B518 JR NC,$B52E    ; Jump to #R$B52E if they do not.
 $B51A CALL $CCB2     ; Test whether the objects overlap in Y.
 $B51D JR NC,$B52E    ; Jump to #R$B52E if they do not.
 $B51F CALL $CCC7     ; Test whether the objects overlap in Z.
 $B522 JR NC,$B52E    ; Jump to #R$B52E if they do not.
; The objects overlap on all three axes (and the carry flag is set), or
; there are none left to try (and it is not).
@label=TestObjectIntersections_Done
*$B524 POP IY         ; {Restore the registers from the stack.
 $B526 POP HL         ;
 $B527 POP DE         ;
 $B528 POP BC         ; }
 $B529 RES 1,(IX+$07) ; Stop the object being ignored in the 3D calculations.
 $B52D RET            ; Return.
; Move on to the next object.
@label=TestObjectIntersections_NextObject
*$B52E LD DE,$0020    ; Set #REGde to the size of an object.
 $B531 ADD IY,DE      ; Move on to the next object in the table.
 $B533 DJNZ $B510     ; Decrease the object counter and loop back to #R$B510 until all of
                      ; the objects have been tested.
 $B535 AND A          ; Clear the carry flag, as nothing intersects.
 $B536 JR $B524       ; Jump to #R$B524.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B712 }
; { #PENTAGRAM$BF1B }
; LIST#

; Test Object Solid
;
; Used by the routines at #R$B4FD, #R$CB9A, #R$CBE9 and #R$CC38.
; .
; Tests whether the object that #REGiy points at is present and is not
; flagged to be ignored in the 3D calculations.
;
;   IY Address of the object
; O:F Zero flag set if the object is empty or ignored
@label=TestObjectSolid
c$B538 LD A,(IY+$00) ; Fetch the graphic number of the object.
 $B53B AND A         ; Test it, as zero means that there is no object.
 $B53C RET Z         ; Return if there is no object.
 $B53D LD A,(IY+$07) ; Fetch the flags of the object.
 $B540 CPL           ; Invert them.
 $B541 AND %00000010 ; Keep the ignore flag, which is now clear if the object is
                     ; ignored.
 $B543 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B74D }
; { #PENTAGRAM$B99B }
; LIST#

; Shuffle Required Objects
;
; Used by the routine at #R$AF88.
; .
; Changes the order in which the special objects have to be taken to the
; cauldron. The list of #N$0E objects at #R$C27D is rotated by four to seven
; places, depending on the first random seed.
@label=ShuffleRequiredObjects
c$B544 LD A,($5BA0)  ; Fetch the first random seed.
 $B547 AND %00000011 ; Keep the lowest two bits.
 $B549 OR %00000100  ; Make it four to seven.
 $B54B LD C,A        ; Use it as the number of times to rotate the list.
@label=ShuffleRequiredObjects_Loop
*$B54C LD B,$0D      ; Set the number of objects to move.
 $B54E LD IY,$C27D   ; Point #REGiy at #R$C27D.
 $B552 LD E,(IY+$00) ; Keep the first object in #REGe.
@label=ShuffleRequiredObjects_Move
*$B555 LD A,(IY+$01) ; Fetch the next object in the list.
 $B558 LD (IY+$00),A ; Store it one place earlier.
 $B55B INC IY        ; Move on to the next object.
 $B55D DJNZ $B555    ; Decrease the object counter and loop back to #R$B555 until all of
                     ; them have moved.
 $B55F LD (IY+$00),E ; Put the first object at the end of the list.
 $B562 DEC C         ; {Decrease the rotation counter and loop back to #R$B54C until the
 $B563 JR NZ,$B54C   ; list has been rotated enough.}
 $B565 RET           ; Return.

; Handle Ending Sparkles
;
; Handles one of the sparkles that fly off the blocks when the cauldron
; room is shown at the end of the game. A sparkle rises until it is high enough,
; in one of four diagonal directions that depend on the part of the room it is
; in, and then flies at the player.
;
; IX Address of the sparkle object
@label=HandleEndingSparkles
c$B566 CALL $C4D8      ; Set the pixel adjustments for a sparkle.
 $B569 LD A,(IX+$03)   ; Fetch the height of the sparkle.
 $B56C CP $A4          ; {Jump to #R$B5C4 if it has reached the top.
 $B56E JR NC,$B5C4     ; }
 $B570 LD (IX+$0B),$03 ; Make the sparkle rise at a speed of #N$03.
 $B574 LD A,(IX+$01)   ; Fetch the X coordinate of the sparkle.
 $B577 RLCA            ; Rotate bit 7 into bit 0.
 $B578 AND %00000001   ; Keep only that bit.
 $B57A LD L,A          ; Stash it in #REGl.
 $B57B LD A,(IX+$02)   ; Fetch the Y coordinate of the sparkle.
 $B57E AND %10000000   ; Keep bit 7 of it.
 $B580 OR L            ; Add the bit from the X coordinate.
 $B581 RLCA            ; Rotate the two bits into bits 0 and 1.
 $B582 AND %00000011   ; Keep only those two bits.
 $B584 LD L,A          ; Use them as the number of the entry of the direction
                       ; table.
 $B585 LD BC,$B58B     ; Point #REGbc at #R$B58B.
 $B588 JP $AFDB        ; Jump to the routine for the direction.

; Sparkle Direction Table
;
; The routines that give a sparkle its speeds in X and Y, chosen by the
; part of the room that the sparkle is in (bit 7 of the X coordinate and bit 7
; of the Y coordinate).
@label=SparkleDirectionTable
w$B58B DEFW $B593    ; X below #N$80 and Y below #N$80: X speed #N$FC, Y speed
                     ; #N$04.
 $B58D DEFW $B5B5    ; X below #N$80 and Y at least #N$80: X speed #N$04, Y speed
                     ; #N$04.
 $B58F DEFW $B5BA    ; X at least #N$80 and Y below #N$80: X speed #N$FC, Y speed
                     ; #N$FC.
 $B591 DEFW $B5BF    ; X and Y both at least #N$80: X speed #N$04, Y speed
                     ; #N$FC.

; Set Sparkle Speed
;
; Gives a sparkle its speeds in X and Y and picks one of its sparkle
; graphics at random. There are four entry points, one for each combination of
; the speeds #N$04 and #N$FC. They load #REGl with the X speed and #REGh with
; the Y speed and carry on at #R$B596.
;
; IX Address of the sparkle object
@label=SetSparkleSpeed
c$B593 LD HL,$04FC   ; Set the X speed to #N$FC and the Y speed to #N$04.
; Store the speeds and pick the graphic.
@label=SetSparkleSpeed_Store
*$B596 LD (IX+$09),L ; Store the X speed in the object.
 $B599 LD (IX+$0A),H ; Store the Y speed in the object.
 $B59C LD A,($5BA5)  ; Fetch the second random seed.
 $B59F AND %00000011 ; Keep the lowest two bits to get a random number from #N$00 to
                     ; #N$03.
 $B5A1 JR NZ,$B5A4   ; Jump to #R$B5A4 if it is not zero.
 $B5A3 INC A         ; Make zero into one.
@label=SetSparkleSpeed_Graphic
*$B5A4 ADD A,$82     ; Add #N$82 to get one of the three sparkle graphic
                     ; numbers.
 $B5A6 LD (IX+$00),A ; Store it as the graphic number of the object.
; This entry point is used by the routine at #R$B5C4.
@label=SetSparkleSpeed_Move
*$B5A9 LD A,(IX+$03) ; Fetch the height of the sparkle.
 $B5AC LD ($5BC5),A  ; Store it, so that the sound of rising blocks can use it.
; This entry point is used by the routines at #R$B6B9 and #R$C4AA.
; .
; Move the object by its speeds, applying gravity, and flag it to be
; redrawn.
@label=MoveAndDrawObject
*$B5AF CALL $C700    ; Update the position of the object.
 $B5B2 JP $C692      ; Flag the object to be wiped and drawn again.
@label=SetSparkleSpeed_PositivePositive
 $B5B5 LD HL,$0404   ; Set the X speed to #N$04 and the Y speed to #N$04.
 $B5B8 JR $B596      ; Jump to #R$B596.
@label=SetSparkleSpeed_NegativeNegative
 $B5BA LD HL,$FCFC   ; Set the X speed to #N$FC and the Y speed to #N$FC.
 $B5BD JR $B596      ; Jump to #R$B596.
@label=SetSparkleSpeed_NegativePositive
 $B5BF LD HL,$FC04   ; Set the X speed to #N$04 and the Y speed to #N$FC.
 $B5C2 JR $B596      ; Jump to #R$B596.

; Send Sparkle At Player
;
; Used by the routine at #R$B566.
; .
; Handles a sparkle that has risen to the top. If the sparkle is close to
; the player the game ends, otherwise the sparkle is made deadly and set off
; towards the player.
;
; IX Address of the sparkle object
@label=SendSparkleAtPlayer
c$B5C4 LD A,($5C09)    ; Fetch the X coordinate of the player.
 $B5C7 SUB (IX+$01)    ; Subtract the X coordinate of the sparkle.
 $B5CA JP P,$B5CF      ; Jump to #R$B5CF if the result is positive.
 $B5CD NEG             ; Make it positive.
@label=SendSparkleAtPlayer_TestX
*$B5CF CP $06          ; {Jump to #R$B5E3 if the sparkle is #N$06 or more away from the player
 $B5D1 JR NC,$B5E3     ; in X.}
 $B5D3 LD A,($5C0A)    ; Fetch the Y coordinate of the player.
 $B5D6 SUB (IX+$02)    ; Subtract the Y coordinate of the sparkle.
 $B5D9 JP P,$B5DE      ; Jump to #R$B5DE if the result is positive.
 $B5DC NEG             ; Make it positive.
@label=SendSparkleAtPlayer_TestY
*$B5DE CP $06          ; {Jump to #R$BA22 if the sparkle is less than #N$06 away from the
 $B5E0 JP C,$BA22      ; player in Y too, as the sparkle has caught the player.
                       ; }
@label=SendSparkleAtPlayer_Fly
*$B5E3 SET 7,(IX+$0D)  ; Flag the sparkle as fatal if it hits the player.
 $B5E7 SET 1,(IX+$07)  ; Flag the sparkle as ignored in the 3D calculations.
 $B5EB LD (IX+$0B),$01 ; Make the sparkle drop at a speed of #N$01.
 $B5EF LD BC,$0404     ; Set the speed towards the player to #N$04 in X and in
                       ; Y.
 $B5F2 CALL $B965      ; Move the sparkle towards the player.
 $B5F5 JR $B5A9        ; Jump to #R$B5A9.

; Read Keyboard Port
;
; Used by the routines at #R$B2BE, #R$BA22, #R$BA9B, #R$BD0C, #R$D03E, #R$D09C,
; #R$D0C8 and #R$D50E.
; .
; Reads one half-row of the keyboard (or several of them together, if more
; than one bit of the selector is zero). The bits of the result are set for the
; keys that are pressed.
;
;   A High byte of the port address, which selects the half-rows
; O:A The keys of the half-rows (bits 0-4, set when pressed)
@label=ReadKeyboardPort
c$B5F7 OUT ($FD),A   ; Put the half-row selector on the high byte of the
                     ; address bus.
 $B5F9 IN A,($FE)    ; Read the keyboard.
 $B5FB CPL           ; Invert the bits so that the pressed keys are set.
 $B5FC AND %00011111 ; Keep only the five bits of the keys.
 $B5FE RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B759 }
; { #CYBERUN$9BC3 }
; { #GUNFRIGHT$D0DB }
; { #NIGHTSHADE$E239 }
; { #PENTAGRAM$B952 }
; LIST#

; Handle Bouncing Ball
;
; Handles a ball that bounces around the room. Every time the ball hits
; the floor it bounces up again and sets off at a speed of #N$02 along either
; the X axis or the Y axis, towards the player if the player is the wulf and
; away from the player if the player is the human. In rooms with an odd number
; the height of the bounce is random.
; .
; The test for which way to go is a self-modifying one: this routine
; changes the conditional jumps at #R$B65D and #R$B676 into JR NC when the
; player is the wulf and JR C when the player is the human.
;
; IX Address of the ball object
@label=HandleBouncingBall
c$B5FF CALL $C4F2      ; Set the pixel adjustments of the ball.
 $B602 LD L,(IX+$09)   ; Fetch the speed in X of the ball.
 $B605 LD H,(IX+$0A)   ; Fetch the speed in Y of the ball.
 $B608 PUSH HL         ; Stash the speeds on the stack.
 $B609 LD A,(IX+$0B)   ; Fetch the speed in Z of the ball.
 $B60C LD ($5BC2),A    ; Keep it, so that the bounce can be told from the ball
                       ; rising.
 $B60F CALL $C700      ; Apply gravity to the ball and move it.
 $B612 POP HL          ; Restore the speeds in X and Y.
 $B613 LD (IX+$09),L   ; Put the speed in X back.
 $B616 LD (IX+$0A),H   ; Put the speed in Y back.
; Work out which way the ball should go from the form the player is in.
 $B619 LD A,($5C08)    ; Fetch the graphic number of the player's legs.
 $B61C SUB $10         ; Take off the first graphic number of the legs.
 $B61E CP $20          ; Compare the result with #N$20, which is where the legs of the wulf
                       ; start. The carry flag is set if the player is a human.
 $B620 LD A,$30        ; Get the opcode of JR NC.
 $B622 JR NC,$B626     ; Jump to #R$B626 if the player is the wulf.
 $B624 ADD A,$08       ; Turn the opcode into the one of JR C.
@label=HandleBouncingBall_SetCondition
*$B626 LD ($B65D),A    ; Change the jump at #R$B65D.
 $B629 LD ($B676),A    ; Change the jump at #R$B676.
; Work out how fast the ball bounces up.
 $B62C LD A,($5C10)    ; Fetch the room that the player is in.
 $B62F AND %00000001   ; Test whether the number of the room is odd.
 $B631 LD A,$04        ; Set the speed to #N$04.
 $B633 JR Z,$B63C      ; Jump to #R$B63C if it is even.
 $B635 LD B,A          ; Stash the minimum speed in #REGb.
 $B636 LD A,($5BA5)    ; Fetch the second random seed.
 $B639 AND %00000011   ; Keep the lowest two bits.
 $B63B ADD A,B         ; Add them to the minimum speed.
@label=HandleBouncingBall_TestFloor
*$B63C BIT 2,(IX+$0C)  ; {Jump to #R$B668 if the ball has not hit the floor.
 $B640 JR Z,$B668      ; }
 $B642 LD (IX+$0B),A   ; Make the ball bounce up.
 $B645 LD A,($5BC2)    ; Fetch the old speed in Z of the ball.
 $B648 AND A           ; Test whether it was rising.
 $B649 JP P,$B64F      ; Jump to #R$B64F if it was.
 $B64C CALL $B42E      ; Play the sound of the ball bouncing.
; Choose the axis that the ball goes along at random.
@label=HandleBouncingBall_Direction
*$B64F LD A,R          ; Read the refresh register for a random number.
 $B651 AND %00000001   ; Keep the lowest bit.
 $B653 JR Z,$B66E      ; Jump to #R$B66E if it is zero, to go along the X axis.
 $B655 LD A,($5C0A)    ; Fetch the Y coordinate of the player.
 $B658 CP (IX+$02)     ; Compare it with the Y coordinate of the ball.
 $B65B LD A,$02        ; Set the speed to #N$02.
@label=HandleBouncingBall_ConditionY
 $B65D JR NC,$B661     ; Jump to #R$B661 if the ball is to go in the positive direction. This
                       ; is the instruction that is changed.
 $B65F NEG             ; Make the speed negative.
@label=HandleBouncingBall_SetSpeedY
*$B661 LD (IX+$0A),A   ; Set the speed in Y of the ball.
 $B664 LD (IX+$09),$00 ; Clear the speed in X of the ball.
@label=HandleBouncingBall_Draw
*$B668 CALL $B985      ; Toggle the graphic number of the ball between its two
                       ; frames.
 $B66B JP $B856        ; Make the ball deadly and flag it to be drawn.
@label=HandleBouncingBall_DirectionX
*$B66E LD A,($5C09)    ; Fetch the X coordinate of the player.
 $B671 CP (IX+$01)     ; Compare it with the X coordinate of the ball.
 $B674 LD A,$02        ; Set the speed to #N$02.
@label=HandleBouncingBall_ConditionX
 $B676 JR NC,$B67A     ; Jump to #R$B67A if the ball is to go in the positive direction. This
                       ; is the instruction that is changed.
 $B678 NEG             ; Make the speed negative.
@label=HandleBouncingBall_SetSpeedX
*$B67A LD (IX+$09),A   ; Set the speed in X of the ball.
 $B67D LD (IX+$0A),$00 ; Clear the speed in Y of the ball.
 $B681 JR $B668        ; Jump to #R$B668.

; Handle Dropping Block
;
; Handles a block that sinks while something is standing on it. The
; collision routines set the triggered flag of the block (bit 3 of its flags
; byte) for as long as something rests on it.
;
; IX Address of the block object
@label=HandleDroppingBlock
c$B683 CALL $C4E3      ; Set the pixel adjustments of a block.
; Sink while something is standing on the block.
 $B686 BIT 3,(IX+$0D)  ; Test whether something is standing on the block.
 $B68A RET Z           ; Return if nothing is.
 $B68B RES 3,(IX+$0D)  ; Reset the triggered flag.
 $B68F LD (IX+$0B),$00 ; Clear the speed in Z of the block.
 $B693 CALL $C700      ; Apply gravity to the block and move it.
 $B696 BIT 2,(IX+$0C)  ; {Jump to #R$B69F if the block has hit the floor.
 $B69A JR NZ,$B69F     ; }
 $B69C CALL $B451      ; Play the sound of a falling object.
@label=HandleDroppingBlock_Draw
*$B69F JP $C692        ; Flag the block to be drawn again.

; Handle Collapsing Block
;
; Handles a block that crumbles into sparkles when something stands on it.
;
; IX Address of the block object
@label=HandleCollapsingBlock
c$B6A2 CALL $C4E3      ; Set the pixel adjustments of a block.
 $B6A5 BIT 3,(IX+$0D)  ; Test whether something is standing on the block.
 $B6A9 RET Z           ; Return if nothing is.
 $B6AA LD (IX+$00),$B8 ; Change the block into a sparkle.
 $B6AE JP $BF2B        ; Carry on as the sparkles of a death.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B28C }
; LIST#

; Handle Block Moving North South
;
; Handles a block that slides to and fro along the Y axis. The block
; follows a triangle wave that is worked out from the frame counter, so that it
; keeps in step however long the room has been on the screen. The code of
; #R$B6BF is modified to use the Y coordinate and Y speed of the block.
;
; IX Address of the block object
@label=HandleBlockMovingNorthSouth
c$B6B1 CALL $B462    ; Play the sound of a block moving along the Y axis.
 $B6B4 LD HL,$020A   ; Set #REGh to the offset of the Y coordinate and #REGl to the offset
                     ; of the speed in Y.
 $B6B7 JR $B6BF      ; Jump to #R$B6BF.

; Handle Block Moving East West
;
; Handles a block that slides to and fro along the X axis. It works in the
; same way as #R$B6B1 but with the X coordinate and the speed in X.
;
; IX Address of the block object
@label=HandleBlockMovingEastWest
c$B6B9 CALL $B45D      ; Play the sound of a block moving along the X axis.
 $B6BC LD HL,$0109     ; Set #REGh to the offset of the X coordinate and #REGl to the offset
                       ; of the speed in X.
; This entry point is used by the routine at #R$B6B1.
; .
; Modify the instructions that fetch the coordinate and store the speed.
@label=HandleMovingBlock
*$B6BF LD A,H          ; Fetch the offset of the coordinate.
 $B6C0 LD ($B6E0),A    ; Change the instruction at #R$B6DE to use it.
 $B6C3 LD A,L          ; Fetch the offset of the speed.
 $B6C4 LD ($B6F1),A    ; Change the instruction at #R$B6EF to use it.
 $B6C7 CALL $C4E3      ; Set the pixel adjustments of a block.
; Work out where the block should be: a position from #N$00 to #N$0F that
; goes up and down with the frame counter. The two blocks of a room are half a
; cycle apart, depending on the address of the object.
 $B6CA PUSH IX         ; {Copy #REGix to #REGbc (using the stack).
 $B6CC POP BC          ; }
 $B6CD LD A,C          ; Fetch the low byte of the address of the object.
 $B6CE RRCA            ; Rotate it right.
 $B6CF AND %00010000   ; Keep the bit which is different for the neighbouring
                       ; objects.
 $B6D1 LD C,A          ; Stash it in #REGc.
 $B6D2 LD A,($5BA2)    ; Fetch the frame counter.
 $B6D5 ADD A,C         ; Add the offset of this block.
 $B6D6 BIT 4,A         ; {Jump to #R$B6DB if bit 4, which is the direction of the wave, is
 $B6D8 JR Z,$B6DB      ; clear.}
 $B6DA CPL             ; Invert the value, so that the wave goes down again.
@label=HandleMovingBlock_Target
*$B6DB AND %00001111   ; Keep the lowest four bits as the position to go to.
 $B6DD LD C,A          ; Stash it in #REGc.
; Compare the block with the target. Redraw it if it is already
; there, otherwise set a speed of #N$01 towards the target.
@label=HandleMovingBlock_Coordinate
 $B6DE LD A,(IX+$01)   ; Fetch the coordinate of the block. This is the instruction that is
                       ; modified.
 $B6E1 ADD A,$08       ; Add #N$08 to it.
 $B6E3 AND %00001111   ; Keep the position of the block within its #N$10 steps.
 $B6E5 CP C            ; Compare it with the position that it should go to.
 $B6E6 JP Z,$C692      ; Jump to #R$C692 if it is already there.
 $B6E9 LD A,$01        ; Set the speed to #N$01.
 $B6EB JR C,$B6EF      ; Jump to #R$B6EF if the block is below the position that it should go
                       ; to.
 $B6ED NEG             ; Make the speed negative.
; Set that speed, hold the block up, and move it.
@label=HandleMovingBlock_Speed
*$B6EF LD (IX+$09),A   ; Set the speed of the block. This is the instruction that is
                       ; modified.
 $B6F2 LD (IX+$0B),$01 ; Set the speed in Z to #N$01, so that the block does
                       ; not fall.
 $B6F6 JP $B5AF        ; Move the block and flag it to be drawn again.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B224 }
; LIST#

; Handle Guard Or Wizard Bottom Half
;
; Handles the bottom half of a guard that moves in any direction or of the
; wizard. The graphic of the bottom half follows the direction in which the
; guard is moving: the lowest bit of the graphic number says which of two frames
; of the walking animation is shown, bit 3 says whether the guard faces towards
; or away from the player, and the horizontal flip flag of the object is set for
; the directions that mirror the sprites.
;
; IX Address of the bottom half of the guard
@label=HandleGuardBottomHalf
c$B6F9 CALL $C4DD     ; Set the pixel adjustments of a guard.
 $B6FC LD A,(IX+$09)  ; Fetch the speed in X.
 $B6FF OR (IX+$0A)    ; Combine it with the speed in Y.
 $B702 RET Z          ; Return if the guard is not moving.
 $B703 CALL $B4AD     ; Play the sound of the guard's footsteps.
 $B706 LD A,(IX+$09)  ; Fetch the speed in X.
 $B709 CP (IX+$0A)    ; Compare it with the speed in Y.
 $B70C JR C,$B726     ; Jump to #R$B726 if it is smaller.
 $B70E BIT 7,A        ; {Jump to #R$B720 if the speed in X is negative.
 $B710 JR NZ,$B720    ; }
 $B712 SET 3,(IX+$00) ; Select the graphic of a guard facing in the positive X
                      ; direction.
@label=HandleGuardBottomHalf_ClearFlip
*$B716 RES 6,(IX+$07) ; Clear the horizontal flip flag.
@label=HandleGuardBottomHalf_Draw
*$B71A CALL $C97F     ; Set the direction of the legs.
 $B71D JP $C692       ; Flag the object to be drawn again.
@label=HandleGuardBottomHalf_NegativeX
*$B720 RES 3,(IX+$00) ; Select the graphic of a guard facing in the negative X
                      ; direction.
 $B724 JR $B716       ; Jump to #R$B716.
@label=HandleGuardBottomHalf_Y
*$B726 BIT 7,(IX+$0A) ; {Jump to #R$B736 if the speed in Y is not negative.
 $B72A JR Z,$B736     ; }
 $B72C SET 3,(IX+$00) ; Select the graphic of a guard facing in the negative Y
                      ; direction.
@label=HandleGuardBottomHalf_SetFlip
*$B730 SET 6,(IX+$07) ; Set the horizontal flip flag.
 $B734 JR $B71A       ; Jump to #R$B71A.
@label=HandleGuardBottomHalf_PositiveY
*$B736 RES 3,(IX+$00) ; Select the graphic of a guard facing in the positive Y
                      ; direction.
 $B73A JR $B730       ; Jump to #R$B730.

; Handle Guard Moving East West
;
; Handles the top half of a guard that patrols east and west. The guard
; walks at a speed of #N$02 and turns round when it hits something. The bottom
; half of the guard, which is the next object in the table, is kept in step.
;
; IX Address of the top half of the guard
@label=HandleGuardMovingEastWest
c$B73C CALL $C50B     ; Set the pixel adjustments of a guard.
 $B73F BIT 0,(IX+$0D) ; Test whether the guard is heading east.
 $B743 LD A,$02       ; Set the speed to #N$02.
 $B745 JR NZ,$B749    ; Jump to #R$B749 if the guard is heading east.
 $B747 NEG            ; Make the speed negative.
@label=HandleGuardMovingEastWest_Speed
*$B749 LD (IX+$09),A  ; Set the speed in X of the guard.
 $B74C LD (IX+$29),A  ; Set the speed in X of the bottom half of the guard too.
 $B74F CALL $B76C     ; Choose the graphic of the guard from its direction.
 $B752 CALL $C700     ; Apply gravity to the guard and move it.
 $B755 BIT 0,(IX+$0C) ; {Jump to #R$B763 if the guard has not hit something
 $B759 JR Z,$B763     ; along the X axis.}
 $B75B LD A,(IX+$0D)  ; Fetch the direction flags of the guard.
 $B75E XOR %00000001  ; Turn the guard round.
 $B760 LD (IX+$0D),A  ; Store them.
@label=HandleGuardMovingEastWest_BottomHalf
*$B763 LD A,(IX+$01)  ; Fetch the X coordinate of the guard.
 $B766 LD (IX+$21),A  ; Give it to the bottom half of the guard.
 $B769 JP $B856       ; Make the guard deadly and flag it to be drawn again.

; Face Direction Of Movement
;
; Used by the routines at #R$B73C and #R$B9A5.
; .
; Chooses the graphic of a guard or of the wizard from the direction that
; it is moving in. The lowest bit of the graphic number is changed to pick one
; of two graphics and the horizontal flip flag is set or cleared to mirror it.
;
; IX Address of the object
@label=FaceDirectionOfMovement
c$B76C LD A,(IX+$09)  ; Fetch the speed in X.
 $B76F OR (IX+$0A)    ; Combine it with the speed in Y.
 $B772 RET Z          ; Return if the guard is not moving.
 $B773 LD A,(IX+$09)  ; Fetch the speed in X.
 $B776 CP (IX+$0A)    ; Compare it with the speed in Y.
 $B779 JR C,$B78E     ; Jump to #R$B78E if it is smaller.
 $B77B BIT 7,A        ; {Jump to #R$B788 if the speed in X is negative.
 $B77D JR NZ,$B788    ; }
 $B77F SET 0,(IX+$00) ; Select the graphic that faces in the positive X
                      ; direction.
@label=FaceDirectionOfMovement_ClearFlip
*$B783 RES 6,(IX+$07) ; Clear the horizontal flip flag.
 $B787 RET            ; Return.
@label=FaceDirectionOfMovement_NegativeX
*$B788 RES 0,(IX+$00) ; Select the graphic that faces in the negative X
                      ; direction.
 $B78C JR $B783       ; Jump to #R$B783.
@label=FaceDirectionOfMovement_MovingAlongY
*$B78E BIT 7,(IX+$0A) ; {Jump to #R$B79D if the speed in Y is not negative.
 $B792 JR Z,$B79D     ; }
 $B794 SET 0,(IX+$00) ; Select the graphic that faces in the negative Y
                      ; direction.
@label=FaceDirectionOfMovement_SetFlip
*$B798 SET 6,(IX+$07) ; Set the horizontal flip flag.
 $B79C RET            ; Return.
@label=FaceDirectionOfMovement_PositiveY
*$B79D RES 0,(IX+$00) ; Select the graphic that faces in the positive Y
                      ; direction.
 $B7A1 JR $B798       ; Jump to #R$B798.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B1AE }
; LIST#

; Handle Gargoyle
;
; Handles a gargoyle, which does not move but is deadly.
;
; IX Address of the gargoyle object
@label=HandleGargoyle
c$B7A3 CALL $B85C    ; Make the gargoyle deadly.
 $B7A6 JP $C4FC      ; Set the pixel adjustments of a gargoyle.

; Handle Spiked Ball
;
; Handles a spiked ball. It hangs in the air until, one time in sixteen,
; it is chosen to drop (only one ball drops at a time), and then it falls to the
; floor and stays there. Nothing happens while the balls are not allowed to
; drop.
;
; IX Address of the spiked ball object
@label=HandleSpikedBall
c$B7A9 CALL $B85C     ; Make the spiked ball deadly.
 $B7AC CALL $C4E3     ; Set the pixel adjustments of a spiked ball.
; Hang in the air until this ball is chosen to drop.
 $B7AF LD A,($5BC0)   ; Fetch the flag that stops the balls from dropping.
 $B7B2 AND A          ; Test it.
 $B7B3 RET NZ         ; Return if the balls may not drop.
 $B7B4 BIT 2,(IX+$0D) ; {Jump to #R$B7CD if this ball is dropping.
 $B7B8 JR NZ,$B7CD    ; }
 $B7BA LD HL,$5BBF    ; Point #REGhl at #R$5BBF.
 $B7BD LD A,(HL)      ; Fetch it.
 $B7BE AND A          ; Test it.
 $B7BF RET NZ         ; Return if another ball is dropping.
 $B7C0 LD A,($5BA5)   ; Fetch the second random seed.
 $B7C3 CP $10         ; Compare it with #N$10 for a one in sixteen chance.
 $B7C5 RET NC         ; Return if it is not that time.
 $B7C6 SET 2,(IX+$0D) ; Flag this ball as dropping.
 $B7CA LD (HL),$01    ; Flag that a ball is dropping.
 $B7CC RET            ; Return.
; Make the ball fall.
@label=HandleSpikedBall_Drop
*$B7CD CALL $C700     ; Apply gravity to the ball and move it.
 $B7D0 BIT 2,(IX+$0C) ; {Jump to #R$B7DC if the ball has hit the floor.
 $B7D4 JR NZ,$B7DC    ; }
 $B7D6 CALL $B451     ; Play the sound of a falling object.
@label=HandleSpikedBall_Draw
*$B7D9 JP $C692       ; Flag the ball to be drawn again.
@label=HandleSpikedBall_Landed
*$B7DC RES 2,(IX+$0D) ; Flag this ball as no longer dropping.
 $B7E0 LD HL,$5BBF    ; Point #REGhl at #R$5BBF.
 $B7E3 LD (HL),$00    ; Flag that no ball is dropping.
 $B7E5 JR $B7D9       ; Jump to #R$B7D9.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$AD13 }
; LIST#

; Handle Spikes
;
; Handles a set of spikes, which do not move but are deadly.
;
; IX Address of the spikes object
@label=HandleSpikes
c$B7E7 CALL $B85C    ; Make the spikes deadly.
 $B7EA JP $C4E3      ; Set the pixel adjustments of a block.

; Handle Fire Moving East West
;
; Handles a fire that moves to and fro along the X axis at a speed of
; #N$02, turning round when it hits something.
;
; IX Address of the fire object
@label=HandleFireMovingEastWest
c$B7ED CALL $C4F2      ; Set the pixel adjustments of a ball.
 $B7F0 LD (IX+$0B),$01 ; Set the speed in Z to #N$01, so that the fire does not
                       ; fall.
 $B7F4 BIT 0,(IX+$0D)  ; Test whether the fire is heading east.
 $B7F8 LD A,$02        ; Set the speed to #N$02.
 $B7FA JR NZ,$B7FE     ; Jump to #R$B7FE if it is.
 $B7FC NEG             ; Make the speed negative.
@label=HandleFireMovingEastWest_Speed
*$B7FE LD (IX+$09),A   ; Set the speed in X of the fire.
 $B801 CALL $B45D      ; Play the sound of a block moving along the X axis.
 $B804 CALL $C700      ; Apply gravity to the fire and move it.
 $B807 BIT 0,(IX+$0C)  ; Test whether the fire has hit something along the X
                       ; axis.
 $B80B LD A,$01        ; Set the direction bit to flip to bit 0.
 $B80D JR $B82F        ; Jump to #R$B82F.

; Handle Fire Moving North South
;
; Handles a fire that moves to and fro along the Y axis at a speed of
; #N$02, turning round when it hits something.
;
; IX Address of the fire object
@label=HandleFireMovingNorthSouth
c$B80F CALL $C4F2      ; Set the pixel adjustments of a ball.
 $B812 LD (IX+$0B),$01 ; Set the speed in Z to #N$01, so that the fire does not
                       ; fall.
 $B816 BIT 1,(IX+$0D)  ; Test whether the fire is heading north.
 $B81A LD A,$02        ; Set the speed to #N$02.
 $B81C JR NZ,$B820     ; Jump to #R$B820 if it is.
 $B81E NEG             ; Make the speed negative.
@label=HandleFireMovingNorthSouth_Speed
*$B820 LD (IX+$0A),A   ; Set the speed in Y of the fire.
 $B823 CALL $B462      ; Play the sound of a block moving along the Y axis.
 $B826 CALL $C700      ; Apply gravity to the fire and move it.
 $B829 BIT 1,(IX+$0C)  ; Test whether the fire has hit something along the Y
                       ; axis.
 $B82D LD A,$02        ; Set the direction bit to flip to bit 1.
; This entry point is used by the routine at #R$B7ED.
; .
; Turn the fire round if it hit something.
@label=HandleFire_Turn
*$B82F JR Z,$B83A      ; Jump to #R$B83A if the fire did not hit anything.
 $B831 XOR (IX+$0D)    ; Flip the direction of the fire.
 $B834 LD (IX+$0D),A   ; Store the direction.
 $B837 CALL $B42E      ; Play the sound of a bounce.
@label=HandleFire_Draw
*$B83A CALL $B985      ; Toggle the graphic of the fire between its two frames.
 $B83D JR $B856        ; Jump to #R$B856.

; Handle Stationary Fire
;
; Handles a fire that stays where it is, flickering by changing frame and
; mirroring itself on every other pass. No fire like this appears in the game.
;
; IX Address of the fire object
@label=HandleStationaryFire
c$B83F CALL $C4F2    ; Set the pixel adjustments of a ball.
 $B842 LD A,($5BBC)  ; Fetch the fire seed.
 $B845 AND %00000001 ; Test the lowest bit.
 $B847 RET Z         ; Return on every other pass.
 $B848 LD A,($5BA5)  ; Fetch the second random seed.
 $B84B AND %01000000 ; Keep the bit that flips the sprite.
 $B84D XOR (IX+$07)  ; Combine it with the flags of the object.
 $B850 LD (IX+$07),A ; Store the flags, which makes the fire flip at random.
 $B853 CALL $B985    ; Toggle the graphic of the fire between its two frames.

; Set Deadly Flags And Draw
;
; Used by the routines at #R$B5FF, #R$B73C, #R$B80F, #R$B865, #R$B9A5 and
; #R$C5C8.
; .
; Makes the object deadly and flags it to be wiped and drawn again.
;
; IX Address of the object
@label=SetDeadlyFlagsAndDraw
c$B856 CALL $B85C    ; Make the object deadly.
 $B859 JP $C692      ; Flag the object to be drawn again.

; Set Deadly Flags
;
; Used by the routines at #R$B7A3, #R$B7A9, #R$B7E7 and #R$B856.
; .
; Makes an object deadly, so that the player dies if it touches the object
; or if the object touches the player.
;
; IX Address of the object
@label=SetDeadlyFlags
c$B85C LD A,(IX+$0D) ; Fetch the flags that go with the object.
 $B85F OR %10100000  ; Set the bits that make the object fatal for the player to hit
                     ; and for it to hit the player.
 $B861 LD (IX+$0D),A ; Store the flags.
 $B864 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B2A7 }
; { #PENTAGRAM$C291 }
; LIST#

; Handle Ball Up Down
;
; Handles a ball that bounces straight up and down. It falls until it hits
; the floor, then it rises at a speed of #N$03 until it reaches the top of its
; bounce, which is #N$20 above the height at which it was first seen, and starts
; to fall again.
;
; IX Address of the ball object
@label=HandleBallUpDown
c$B865 CALL $C4F2      ; Set the pixel adjustments of a ball.
 $B868 LD A,($5BBD)    ; Fetch the height of the bounce.
 $B86B AND A           ; Test whether it has been worked out.
 $B86C JR NZ,$B876     ; Jump to #R$B876 if it has.
 $B86E LD A,(IX+$03)   ; Fetch the height of the ball.
 $B871 ADD A,$20       ; Add #N$20 to get the height of the bounce.
 $B873 LD ($5BBD),A    ; Store it.
@label=HandleBallUpDown_Frame
*$B876 CALL $B985      ; Toggle the graphic of the ball between its two frames.
 $B879 CALL $B451      ; Play the sound of a falling object.
 $B87C BIT 2,(IX+$0D)  ; {Jump to #R$B894 if the ball is rising.
 $B880 JR NZ,$B894     ; }
 $B882 CALL $C700      ; Apply gravity to the ball and move it.
 $B885 BIT 2,(IX+$0C)  ; {Jump to #R$B892 if the ball has not hit the floor.
 $B889 JR Z,$B892      ; }
 $B88B SET 2,(IX+$0D)  ; Flag the ball as rising.
 $B88F CALL $B42E      ; Play the sound of a bounce.
@label=HandleBallUpDown_Draw
*$B892 JR $B856        ; Make the ball deadly and flag it to be drawn again.
@label=HandleBallUpDown_Rise
*$B894 LD (IX+$0B),$03 ; Set the speed in Z to #N$03.
 $B898 CALL $C700      ; Move the ball.
 $B89B LD A,($5BBD)    ; Fetch the height of the bounce.
 $B89E CP (IX+$03)     ; Compare it with the height of the ball.
 $B8A1 JR NC,$B892     ; Jump to #R$B892 if the ball is still below the top of
                       ; the bounce.
 $B8A3 RES 2,(IX+$0D)  ; Flag the ball as falling.
 $B8A7 JR $B892        ; Jump to #R$B892.

; Spawn Cauldron Bubbles
;
; Used by the routine at #R$AFBA.
; .
; Starts the bubbles that rise out of the cauldron. Nothing happens unless
; the player is in the cauldron room, the second slot for special objects is
; empty and the final animation is not under way. The bubbles are copied into
; the slot from #R$B8C8.
@label=SpawnCauldronBubbles
c$B8A9 LD A,($5C10)  ; Fetch the room that the player is in.
 $B8AC CP $88        ; Compare it with the number of the cauldron room.
 $B8AE RET NZ        ; Return if the player is in another room.
 $B8AF LD DE,$5C68   ; Point #REGde at #R$5C68.
 $B8B2 LD A,(DE)     ; Fetch the graphic number of the object.
 $B8B3 AND A         ; Test whether the slot is empty.
 $B8B4 RET NZ        ; Return if it is in use.
 $B8B5 LD A,($5BC3)  ; Fetch the flag that is set when the final animation
                     ; starts.
 $B8B8 AND A         ; Test it.
 $B8B9 RET NZ        ; Return if the final animation has started.
 $B8BA LD HL,$B8C8   ; Point #REGhl at #R$B8C8.
 $B8BD LD BC,$0012   ; Set the number of bytes to copy to #N$12.
 $B8C0 PUSH DE       ; {Copy #REGde to #REGix (using the stack).
 $B8C1 POP IX        ; }
 $B8C3 LDIR          ; Copy the bubbles into the slot.
 $B8C5 JP $C4D8      ; Set the pixel adjustments of a sparkle.

; Cauldron Bubbles
;
; The first #N$12 bytes of the object that is copied into the table of
; special objects by #R$B8A9.
@label=CauldronBubbles
b$B8C8 DEFB $A0             ; Graphic number.
 $B8C9 DEFB $80             ; X coordinate.
 $B8CA DEFB $80             ; Y coordinate.
 $B8CB DEFB $80             ; Z coordinate.
 $B8CC DEFB $05             ; Width.
 $B8CD DEFB $05             ; Depth.
 $B8CE DEFB $0C             ; Height.
 $B8CF DEFB $10             ; Flags.
 $B8D0 DEFB $B4             ; Room number.
 $B8D1 DEFB $00,$00,$00,$00 ; Speeds in X, Y and Z, and the counter.
 $B8D5 DEFB $A0             ; Flags that tell how deadly the object is.
 $B8D6 DEFB $00,$00,$00,$00 ; Adjustments to the speeds and the address of the table entry
                            ; (unused).

; Handle Cauldron Bubbles
;
; Handles the bubbles that rise from the cauldron. They are replaced by
; the object that is needed next, shown once in four frames, when they are at
; the top, unless the player is Wulf, when they turn into the spell that repels
; him. The bubbles vanish once a special object appears in the first slot.
;
; IX Address of the bubbles object
@label=HandleCauldronBubbles
c$B8DA CALL $C4D8      ; Set the pixel adjustments of a sparkle.
 $B8DD LD A,($5C48)    ; Fetch the graphic number of the first special object
                       ; of the room.
 $B8E0 AND A           ; Test whether the slot is empty.
 $B8E1 JP NZ,$B95E     ; Jump to #R$B95E if the slot is in use, to remove the
                       ; bubbles.
 $B8E4 SET 1,(IX+$07)  ; Flag the bubbles to be ignored in the 3D calculations.
 $B8E8 CALL $C700      ; Apply gravity to the bubbles and move them.
 $B8EB CALL $B98C      ; Change to the next graphic of the bubbles.
 $B8EE LD A,(IX+$03)   ; Fetch the Z coordinate of the bubbles.
 $B8F1 CP $A0          ; Compare it with #N$A0.
 $B8F3 LD (IX+$0B),$02 ; Set the speed in Z to #N$02.
 $B8F7 JR C,$B916      ; Jump to #R$B916 if the bubbles have not reached the
                       ; top.
 $B8F9 LD (IX+$0B),$01 ; Set the speed in Z to #N$01.
 $B8FD LD A,($5C08)    ; Fetch the graphic number of the legs of the player.
 $B900 SUB $30         ; Take off the first graphic number of Wulf.
 $B902 CP $10          ; {Jump to #R$B919 if the player is Wulf.
 $B904 JR C,$B919      ; }
 $B906 LD A,(IX+$00)   ; Fetch the graphic number of the bubbles.
 $B909 AND %00000011   ; Keep the frame of the animation.
 $B90B JR NZ,$B916     ; Jump to #R$B916 if it is not the first frame.
 $B90D CALL $C274      ; Find the next object that is needed.
 $B910 LD A,(HL)       ; Fetch its graphic number.
 $B911 OR %10101000    ; Make it the graphic number of the object that shows through the
                       ; bubbles.
 $B913 LD (IX+$00),A   ; Store the graphic number.
; This entry point is used by the routine at #R$B923.
@label=HandleCauldronBubbles_Draw
*$B916 JP $C692        ; Flag the bubbles to be drawn again.
@label=HandleCauldronBubbles_Repel
*$B919 SET 2,(IX+$00)  ; Turn the bubbles into the spell that repels Wulf.
 $B91D RES 1,(IX+$07)  ; Make the spell take part in the 3D calculations.
 $B921 JR $B916        ; Jump to #R$B916.

; Handle Special Object In Cauldron
;
; Handles the graphics #N$A8 to #N$AF, which show the object that is
; needed next above the cauldron. The object lasts for a single frame, as it is
; changed back to the bubbles.
;
; IX Address of the object
@label=HandleSpecialObjectInCauldron
c$B923 CALL $C4D8      ; Set the pixel adjustments of a sparkle.
 $B926 LD (IX+$00),$A0 ; Change the graphic of the object to the bubbles.
 $B92A JR $B916        ; Jump to #R$B916.

; Handle Repel Spell
;
; Handles the spell that chases Wulf in the cauldron room and repels him.
; It moves towards the player, and it moves slowly if the player is near an
; arch. In the cauldron room it vanishes when the graphic number of the legs of
; the player is not in the range #N$10 to #N$4F.
;
; IX Address of the spell object
@label=HandleRepelSpell
c$B92C CALL $C4D8      ; Set the pixel adjustments of a sparkle.
 $B92F LD A,(IX+$08)   ; Fetch the room that the spell is in.
 $B932 CP $88          ; {Jump to #R$B942 if the spell is in the cauldron room.
 $B934 JR Z,$B942      ; }
 $B936 LD A,($5C0F)    ; Fetch the flags of the player.
 $B939 BIT 0,A         ; {Jump to #R$B942 if the player is not.
 $B93B JR Z,$B942      ; }
 $B93D LD BC,$0101     ; Set the speeds in X and Y to #N$01.
 $B940 JR $B945        ; Jump to #R$B945.
@label=HandleRepelSpell_Fast
*$B942 LD BC,$0404     ; Set the speeds in X and Y to #N$04.
@label=HandleRepelSpell_Move
*$B945 CALL $B965      ; Set the speeds of the spell to take it towards the
                       ; player.
 $B948 CALL $C700      ; Apply gravity to the spell and move it.
 $B94B CALL $B98C      ; Change to the next graphic of the spell.
 $B94E LD A,(IX+$08)   ; Fetch the room that the spell is in.
 $B951 CP $88          ; {Jump to #R$B962 if the spell is not in the cauldron
 $B953 JR NZ,$B962     ; room.}
 $B955 LD A,($5C08)    ; Fetch the graphic number of the legs of the player.
 $B958 SUB $10         ; Take off #N$10.
 $B95A CP $40          ; {Jump to #R$B962 if the graphic number of the player
 $B95C JR C,$B962      ; is in the range.}
; This entry point is used by the routines at #R$B8DA, #R$BF37 and #R$C238.
; .
; Remove the object, by changing it to a graphic that is not shown.
@label=HandleRepelSpell_Vanish
*$B95E LD (IX+$00),$01 ; Change the graphic of the object to #N$01.
@label=HandleRepelSpell_Update
*$B962 JP $C232        ; Update the object.

; Set Speed Towards Player
;
; Used by the routines at #R$B5C4 and #R$B92C.
; .
; Sets the speeds of an object so that it moves towards the player.
;
; B Speed in Y
; C Speed in X
; IX Address of the object
@label=SetSpeedTowardsPlayer
c$B965 LD HL,$5C09   ; Point #REGhl at the X coordinate of the player.
 $B968 LD A,(IX+$01) ; Fetch the X coordinate of the object.
 $B96B SUB (HL)      ; Subtract the X coordinate of the player.
 $B96C INC HL        ; Point #REGhl at the Y coordinate of the player.
 $B96D LD A,C        ; Fetch the speed in X.
 $B96E JP M,$B973    ; Jump to #R$B973 if the object is on the west side of the
                     ; player.
 $B971 NEG           ; Make the speed negative.
@label=SetSpeedTowardsPlayer_SetX
*$B973 LD (IX+$09),A ; Set the speed in X of the object.
 $B976 LD A,(IX+$02) ; Fetch the Y coordinate of the object.
 $B979 SUB (HL)      ; Subtract the Y coordinate of the player.
 $B97A INC HL        ; Point #REGhl at the Z coordinate of the player.
 $B97B LD A,B        ; Fetch the speed in Y.
 $B97C JP M,$B981    ; Jump to #R$B981 if the object is on the south side of
                     ; the player.
 $B97F NEG           ; Make the speed negative.
@label=SetSpeedTowardsPlayer_SetY
*$B981 LD (IX+$0A),A ; Set the speed in Y of the object.
 $B984 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B165 }
; LIST#

; Toggle Graphic
;
; Used by the routines at #R$B5FF, #R$B80F, #R$B83F, #R$B865 and #R$C5C8.
; .
; Changes the graphic of an object between the two graphics of a pair, by
; flipping the lowest bit of the graphic number.
;
; IX Address of the object
@label=ToggleGraphic
c$B985 LD A,(IX+$00) ; Fetch the graphic number.
 $B988 XOR %00000001 ; Flip the lowest bit.
 $B98A JR $B998      ; Jump to #R$B998.

; Next Sprite Number
;
; Used by the routines at #R$B8DA and #R$B92C.
; .
; Changes the graphic of an object to the next of a group of four, by
; adding one to the lowest two bits of the graphic number and ignoring the
; carry.
;
; IX Address of the object
@label=NextSpriteNumber
c$B98C LD A,(IX+$00) ; Fetch the graphic number.
 $B98F LD C,A        ; Stash it in #REGc.
 $B990 AND %11111100 ; Keep the highest six bits.
 $B992 LD B,A        ; Stash them in #REGb.
 $B993 LD A,C        ; Fetch the graphic number.
 $B994 INC A         ; Add one.
 $B995 AND %00000011 ; Keep the lowest two bits.
 $B997 OR B          ; Combine them with the highest six bits.
; This entry point is used by the routine at #R$B985.
@label=SetGraphic
*$B998 LD (IX+$00),A ; Store the new graphic number.
 $B99B RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B18C }
; { #GUNFRIGHT$CCAE }
; { #NIGHTSHADE$CEF8 }
; LIST#

; Handle Cauldron Bottom
;
; Handles the bottom half of the cauldron.
;
; IX Address of the object
@label=HandleCauldronBottom
c$B99C JP $C506      ; Set the pixel adjustments of the cauldron and update it.

; Handle Cauldron Top
;
; Handles the top half of the cauldron, which is drawn #N$18 pixels to the
; left of and #N$0C pixels above where it is.
;
; IX Address of the object
@label=HandleCauldronTop
c$B99F LD HL,$0CE8   ; Set the pixel adjustments of #N$18 to the left and #N$0C
                     ; up.
 $B9A2 JP $C72B      ; Apply them and update the object.

; Handle Guard Or Wizard
;
; Handles the top half of a guard or of the wizard, who patrol round the
; room, following the walls. The bottom half is the next object in the table and
; it is moved with the top half.
;
; IX Address of the top half of the guard
@label=HandleGuardOrWizard
c$B9A5 CALL $C510    ; Set the pixel adjustments of a guard.
 $B9A8 CALL $C700    ; Apply gravity to the guard and move it.
 $B9AB CALL $B9CC    ; Work out the speeds of the guard from its direction.
 $B9AE LD (IX+$09),L ; Set the speed in X of the guard.
 $B9B1 LD (IX+$29),L ; Set the speed in X of the bottom half.
 $B9B4 LD (IX+$0A),H ; Set the speed in Y of the guard.
 $B9B7 LD (IX+$2A),H ; Set the speed in Y of the bottom half.
 $B9BA LD A,(IX+$01) ; Fetch the X coordinate of the guard.
 $B9BD LD (IX+$21),A ; Set the X coordinate of the bottom half.
 $B9C0 LD A,(IX+$02) ; Fetch the Y coordinate of the guard.
 $B9C3 LD (IX+$22),A ; Set the Y coordinate of the bottom half.
 $B9C6 CALL $B76C    ; Choose the graphic of the guard from its direction.
 $B9C9 JP $B856      ; Make the guard deadly and flag it to be drawn again.

; Get Guard Speeds
;
; Used by the routine at #R$B9A5.
; .
; Works out the speeds that make a guard follow the wall of the room,
; using the direction in the two lowest bits of its flags: #N$00 is west, #N$01
; is north, #N$02 is east and #N$03 is south.
;
;   IX Address of the guard
; O:H Speed in Y
; O:L Speed in X
@label=GetGuardSpeeds
c$B9CC LD BC,$B9D8   ; Point #REGbc at the table of routines.
 $B9CF LD A,(IX+$0D) ; Fetch the direction flags of the guard.
 $B9D2 AND %00000011 ; Keep the direction.
 $B9D4 LD L,A        ; Use it as the number of the routine.
 $B9D5 JP $AFDB      ; Jump to the routine.

; Guard Direction Table
;
; The routines that give the speeds of a guard heading in each direction.
@label=GuardDirectionTable
w$B9D8 DEFW $B9E0    ; West: #R$B9E0.
 $B9DA DEFW $B9FB    ; North: #R$B9FB.
 $B9DC DEFW $BA08    ; East: #R$BA08.
 $B9DE DEFW $BA15    ; South: #R$BA15.

; Guard Heading West
;
; Keeps a guard heading west, at a speed of #N$02, until it hits
; something. It then turns north.
;
;   IX Address of the guard
; O:H Speed in Y
; O:L Speed in X
@label=GuardHeadingWest
c$B9E0 LD HL,$00FE    ; Set the speed in X to #N$FE and the speed in Y to
                      ; #N$00.
 $B9E3 BIT 0,(IX+$0C) ; Test whether the guard has hit something along the X
                      ; axis.
 $B9E7 RET Z          ; Return if it has not.
 $B9E8 LD HL,$0200    ; Set the speed in X to #N$00 and the speed in Y to
                      ; #N$02.
; This entry point is used by the routines at #R$B9FB, #R$BA08 and #R$BA15.
; .
; Turn the guard, to follow the wall.
@label=TurnGuard
*$B9EB LD A,(IX+$0D)  ; Fetch the direction flags of the guard.
 $B9EE LD C,A         ; Stash them in #REGc.
 $B9EF INC A          ; Move to the next direction.
 $B9F0 AND %00000011  ; Keep the direction.
 $B9F2 LD B,A         ; Stash it in #REGb.
 $B9F3 LD A,C         ; Fetch the direction flags.
 $B9F4 AND %11111100  ; Keep the other flags.
 $B9F6 OR B           ; Combine them with the new direction.
 $B9F7 LD (IX+$0D),A  ; Store the flags.
 $B9FA RET            ; Return.

; Guard Heading North
;
; Keeps a guard heading north, at a speed of #N$02, until it hits
; something. It then turns east.
;
;   IX Address of the guard
; O:H Speed in Y
; O:L Speed in X
@label=GuardHeadingNorth
c$B9FB LD HL,$0200    ; Set the speed in X to #N$00 and the speed in Y to
                      ; #N$02.
 $B9FE BIT 1,(IX+$0C) ; Test whether the guard has hit something along the Y
                      ; axis.
 $BA02 RET Z          ; Return if it has not.
 $BA03 LD HL,$0002    ; Set the speed in X to #N$02 and the speed in Y to
                      ; #N$00.
 $BA06 JR $B9EB       ; Jump to #R$B9EB to turn the guard.

; Guard Heading East
;
; Keeps a guard heading east, at a speed of #N$02, until it hits
; something. It then turns south.
;
;   IX Address of the guard
; O:H Speed in Y
; O:L Speed in X
@label=GuardHeadingEast
c$BA08 LD HL,$0002    ; Set the speed in X to #N$02 and the speed in Y to
                      ; #N$00.
 $BA0B BIT 0,(IX+$0C) ; Test whether the guard has hit something along the X
                      ; axis.
 $BA0F RET Z          ; Return if it has not.
 $BA10 LD HL,$FE00    ; Set the speed in X to #N$00 and the speed in Y to
                      ; #N$FE.
 $BA13 JR $B9EB       ; Jump to #R$B9EB to turn the guard.

; Guard Heading South
;
; Keeps a guard heading south, at a speed of #N$02, until it hits
; something. It then turns west.
;
;   IX Address of the guard
; O:H Speed in Y
; O:L Speed in X
@label=GuardHeadingSouth
c$BA15 LD HL,$FE00    ; Set the speed in X to #N$00 and the speed in Y to
                      ; #N$FE.
 $BA18 BIT 1,(IX+$0C) ; Test whether the guard has hit something along the Y
                      ; axis.
 $BA1C RET Z          ; Return if it has not.
 $BA1D LD HL,$00FE    ; Set the speed in X to #N$FE and the speed in Y to
                      ; #N$00.
 $BA20 JR $B9EB       ; Jump to #R$B9EB to turn the guard.

; Game Over
;
; Used by the routines at #R$B5C4, #R$C3A4 and #R$D12A.
; .
; Ends the game, whether the player has run out of lives, the forty days
; have passed or the final sparkles have caught the player. If the game was
; completed, the message of the potion is shown first. The results screen shows
; the days that have passed, the percentage of the quest that was completed, the
; number of charms collected and a rating. The game then returns to the menu
; when a key is pressed.
; .
; #HTML(#AUDIO0(game-over-tune.wav)(#INCLUDE(GameOverTune)))
; .
; #PUSHS #UDGTABLE { =h Game over screen }
; { #SIM(start=$AF6C,stop=$AFA2,sp=$5BA0,clear=1)
; #SIM(start=$BD0C,stop=$BD23)
; #SIM(start=$AFAB,stop=$B02F,sp=$5BA0)
; #SIM(start=$B03F,stop=$B06E)
; #SIM(start=$BA22,stop=$BA87,sp=$5BA0)
; #SCR$02(game-over) } UDGTABLE# #POPS
@label=GameOver
c$BA22 LD A,($5BC3)  ; Fetch the flag that is set when the game has been
                     ; completed.
 $BA25 AND A         ; Test it.
 $BA26 JP NZ,$BAAB   ; Show the message of the potion first if the game has
                     ; been completed.
; This entry point is used by the routine at #R$BAAB.
; .
; Show the results screen.
@label=GameOver_ShowResults
*$BA29 CALL $D567    ; Clear the screen buffer.
 $BA2C CALL $D55F    ; Clear the screen and make the border black.
 $BA2F LD DE,$BB4C   ; Point #REGde at #R$BB4C.
 $BA32 EXX           ; Switch to the alternate registers to keep it there.
 $BA33 LD HL,$BB52   ; Point #REGhl at #R$BB52.
 $BA36 LD DE,$BB5E   ; Point #REGde at #R$BB5E.
 $BA39 LD B,$06      ; Set the number of lines of text to #N$06.
 $BA3B CALL $BEBF    ; Print the lines of text.
 $BA3E LD HL,$E8E2   ; Point #REGhl at #R$E8E2.
 $BA41 LD DE,$5BB9   ; Point #REGde at #R$5BB9.
 $BA44 LD B,$01      ; Set the number of bytes to print to #N$01.
 $BA46 CALL $BCAE    ; Print the number of days.
 $BA49 CALL $BC10    ; Print the percentage of the quest that was completed.
; Work out the rating from the number of rooms visited and from whether
; the game was completed.
 $BA4C LD A,($5BC6)  ; Fetch the number of rooms visited, less one.
 $BA4F RLCA          ; Rotate the highest bit round to the lowest.
 $BA50 AND %11000000 ; Keep the next two highest bits (the number of rooms divided by
                     ; #N$20).
 $BA52 LD C,A        ; Stash them in #REGc.
 $BA53 LD A,($5BC3)  ; Fetch the flag that is set when the game has been
                     ; completed.
 $BA56 AND %00000001 ; Keep only the lowest bit.
 $BA58 OR C          ; Combine it with the number of rooms.
 $BA59 RLCA          ; {Rotate the bits into place to make the number of a
 $BA5A RLCA          ; word.
 $BA5B RLCA          ; }
 $BA5C AND %00001110 ; Keep the bits of the number of the word.
 $BA5E LD L,A        ; {Set #REGhl to the number of bytes into the table of
 $BA5F LD H,$00      ; ratings.}
 $BA61 LD BC,$BBB7   ; Point #REGbc at #R$BBB7.
 $BA64 ADD HL,BC     ; Point #REGhl at the entry for the rating.
 $BA65 LD E,(HL)     ; Fetch the low byte of the address of the text of the
                     ; rating.
 $BA66 INC HL        ; Move on to the high byte.
 $BA67 LD D,(HL)     ; Fetch the high byte.
 $BA68 LD HL,$2758   ; Set #REGhl to the position of the rating.
 $BA6B CALL $BE45    ; Print the rating.
; Print the number of charms collected, which is the number of objects
; that were put into the cauldron.
 $BA6E LD DE,$5BBB   ; Point #REGde at #R$5BBB.
 $BA71 LD A,(DE)     ; Fetch the number of charms.
 $BA72 SUB $0A       ; Take off #N$0A to see if the number is in double digits.
 $BA74 JR C,$BA79    ; Jump to #R$BA79 if it is not.
 $BA76 OR %00010000  ; Convert it to a BCD number between #N$10 and #N$14.
 $BA78 LD (DE),A     ; Store the BCD number.
@label=GameOver_PrintCharms
*$BA79 LD HL,$E2EA   ; Point #REGhl at the position of the charms in the screen
                     ; buffer.
 $BA7C LD B,$01      ; Set the number of bytes to print to #N$01.
 $BA7E CALL $BCAE    ; Print the number of charms collected.
 $BA81 CALL $D296    ; Draw the border.
 $BA84 CALL $D56F    ; Copy the screen buffer to the display.
; Play the tune, wait for a key to be pressed and then go back to the
; menu.
@label=GameOver_WaitForKeyRelease
*$BA87 XOR A         ; Select all the half-rows of the keyboard.
 $BA88 CALL $B5F7    ; Read the keyboard.
 $BA8B JR NZ,$BA87   ; Jump back to #R$BA87 until all the keys are released.
 $BA8D LD DE,$B218   ; Point #REGde at #R$B218.
 $BA90 CALL $B2BE    ; Play the tune, until a key is pressed.
 $BA93 LD B,$08      ; Set the number of times to wait to #N$08.
 $BA95 CALL $BA9B    ; Wait for a key to be pressed, up to a limit.
 $BA98 JP $AF7F      ; Go back to the menu, to start another game.

; Wait For Key Press
;
; Used by the routines at #R$BA22 and #R$BAAB.
; .
; Waits until any key is pressed or until a time limit passes. The time is
; #REGb times the time that it takes to count #N$FFFF down to zero.
;
;   B Number of times to count down
; O:F Zero flag clear if a key was pressed
@label=WaitForKeyPress
c$BA9B LD HL,$0000   ; Set the counter to zero, to count #N$10000 times.
@label=WaitForKeyPress_Wait
*$BA9E XOR A         ; Select all the half-rows of the keyboard.
 $BA9F CALL $B5F7    ; Read the keyboard.
 $BAA2 RET NZ        ; Return if a key is pressed.
 $BAA3 DEC HL        ; Decrease the counter.
 $BAA4 LD A,H        ; {Check whether the counter has reached zero.
 $BAA5 OR L          ; }
 $BAA6 JR NZ,$BA9E   ; Jump back to #R$BA9E until the counter is zero.
 $BAA8 DJNZ $BA9E    ; Jump back to #R$BA9E until the time limit has passed.
 $BAAA RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B899 }
; LIST#

; Game Completed
;
; Used by the routine at #R$BA22.
; .
; Shows the message of the potion that is given when the player has
; completed the game, while the game complete tune plays, and then goes on to
; show the results.
;
; .
;
; Show the game completed message.
@label=GameCompleted
c$BAAB CALL $D567    ; Clear the screen buffer.
 $BAAE CALL $D55F    ; Clear the screen and make the border black.
 $BAB1 LD DE,$BAD2   ; Point #REGde at #R$BAD2.
 $BAB4 EXX           ; Switch to the alternate registers to keep it there.
 $BAB5 LD HL,$BAD8   ; Point #REGhl at #R$BAD8.
 $BAB8 LD DE,$BAE4   ; Point #REGde at #R$BAE4.
 $BABB LD B,$06      ; Set the number of lines of text to #N$06.
 $BABD XOR A         ; Clear #REGa.
 $BABE LD ($5BB8),A  ; Flag that the border has to be drawn.
 $BAC1 CALL $BEBF    ; Print the lines of text.
; Play the tune and wait for a key to be pressed.
 $BAC4 LD DE,$B239   ; Point #REGde at #R$B239.
 $BAC7 CALL $B2CF    ; Play the tune.
 $BACA LD B,$08      ; Set the number of times to wait to #N$08.
 $BACC CALL $BA9B    ; Wait for a key to be pressed, up to a limit.
 $BACF JP $BA29      ; Jump to #R$BA29 to show the results screen.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B8A9 }
; LIST#
; .
; #HTML(#AUDIO0(game-complete-tune.wav)(#INCLUDE(GameCompleteTune)))
; .
; #PUSHS #UDGTABLE { =h Game complete message }
; { #SIM(start=$AF6C,stop=$AFA2,sp=$5BA0,clear=1)
; #SIM(start=$BD0C,stop=$BD23)
; #SIM(start=$BAAB,stop=$BAC4,sp=$5BA0)
; #SCR$02(game-completed) } UDGTABLE# #POPS

; Game Complete Colours
;
; The attributes of the six lines of the message that is shown when the
; game has been completed.
@label=GameCompleteColours
b$BAD2 DEFB $47      ; #COLOUR(#PEEK(#PC)).
 $BAD3 DEFB $46      ; #COLOUR(#PEEK(#PC)).
 $BAD4 DEFB $45      ; #COLOUR(#PEEK(#PC)).
 $BAD5 DEFB $44      ; #COLOUR(#PEEK(#PC)).
 $BAD6 DEFB $43      ; #COLOUR(#PEEK(#PC)).
 $BAD7 DEFB $42      ; #COLOUR(#PEEK(#PC)).

; Game Complete Coordinates
;
; The X and Y coordinates of the six lines of the message that is shown
; when the game has been completed.
@label=GameCompleteCoordinates
b$BAD8 DEFB $40,$87  ; {One pair for each line.
 $BADA DEFB $40,$77  ;
 $BADC DEFB $30,$67  ;
 $BADE DEFB $30,$57  ;
 $BAE0 DEFB $50,$47  ;
 $BAE2 DEFB $30,$37  ; }

; Game Complete Text
;
; The six lines of the message that is shown when the game has been
; completed. Each character is stored as its number in the font at #R$6108:
; #N$00 to #N$09 are the digits, #N$0A to #N$23 are the letters, #N$26 is a
; space and #N$27 is a percent sign. Bit 7 of the last character of each line is
; set.
@label=GameCompleteText
b$BAE4 DEFB $1D,$11,$0E,$26,$19,$18,$1D,$12 ; {"THE POTION CASTS"
 $BAEC DEFB $18,$17,$26,$0C,$0A,$1C,$1D,$9C ; }
 $BAF4 DEFB $12,$1D,$1C,$26,$16,$0A,$10,$12 ; {"ITS MAGIC STRONG"
 $BAFC DEFB $0C,$26,$1C,$1D,$1B,$18,$17,$90 ; }
 $BB04 DEFB $0A,$15,$15,$26,$0E,$1F,$12,$15 ; {"ALL EVIL MUST BEWARE"
 $BB0C DEFB $26,$16,$1E,$1C,$1D,$26,$0B,$0E ;
 $BB14 DEFB $20,$0A,$1B,$8E                 ; }
 $BB18 DEFB $1D,$11,$0E,$26,$1C,$19,$0E,$15 ; {"THE SPELL HAS BROKEN"
 $BB20 DEFB $15,$26,$11,$0A,$1C,$26,$0B,$1B ;
 $BB28 DEFB $18,$14,$0E,$97                 ; }
 $BB2C DEFB $22,$18,$1E,$26,$0A,$1B,$0E,$26 ; {"YOU ARE FREE"
 $BB34 DEFB $0F,$1B,$0E,$8E                 ; }
 $BB38 DEFB $10,$18,$26,$0F,$18,$1B,$1D,$11 ; {"GO FORTH TO MIREMARE"
 $BB40 DEFB $26,$1D,$18,$26,$16,$12,$1B,$0E ;
 $BB48 DEFB $16,$0A,$1B,$8E                 ; }

; Game Over Colours
;
; The attributes of the six lines of the results screen.
@label=GameOverColours
b$BB4C DEFB $47      ; #COLOUR(#PEEK(#PC)).
 $BB4D DEFB $46      ; #COLOUR(#PEEK(#PC)).
 $BB4E DEFB $45      ; #COLOUR(#PEEK(#PC)).
 $BB4F DEFB $45      ; #COLOUR(#PEEK(#PC)).
 $BB50 DEFB $43      ; #COLOUR(#PEEK(#PC)).
 $BB51 DEFB $44      ; #COLOUR(#PEEK(#PC)).

; Game Over Coordinates
;
; The X and Y coordinates of the six lines of the results screen.
@label=GameOverCoordinates
b$BB52 DEFB $58,$9F  ; {One pair for each line.
 $BB54 DEFB $50,$7F  ;
 $BB56 DEFB $30,$6F  ;
 $BB58 DEFB $40,$5F  ;
 $BB5A DEFB $30,$4F  ;
 $BB5C DEFB $48,$37  ; }

; Game Over Text
;
; The six lines of the results screen, in the same format as #R$BAE4. The
; numbers of days, percent and charms that go with the lines are printed
; separately, by #R$BA22.
@label=GameOverText
b$BB5E DEFB $10,$0A,$16,$0E,$26,$26,$18,$1F ; {"GAME OVER"
 $BB66 DEFB $0E,$9B                         ; }
 $BB68 DEFB $1D,$12,$16,$0E,$26,$26,$26,$26 ; {"TIME DAYS"
 $BB70 DEFB $0D,$0A,$22,$9C                 ; }
 $BB74 DEFB $19,$0E,$1B,$0C,$0E,$17,$1D,$0A ; {"PERCENTAGE OF QUEST"
 $BB7C DEFB $10,$0E,$26,$18,$0F,$26,$1A,$1E ;
 $BB84 DEFB $0E,$1C,$9D                     ; }
 $BB87 DEFB $0C,$18,$16,$19,$15,$0E,$1D,$0E ; {"COMPLETED %"
 $BB8F DEFB $0D,$26,$26,$26,$26,$26,$A7     ; }
 $BB96 DEFB $0C,$11,$0A,$1B,$16,$1C,$26,$0C ; {"CHARMS COLLECTED "
 $BB9E DEFB $18,$15,$15,$0E,$0C,$1D,$0E,$0D ;
 $BBA6 DEFB $26,$26,$A6                     ; }
 $BBA9 DEFB $18,$1F,$0E,$1B,$0A,$15,$15,$26 ; {"OVERALL RATING"
 $BBB1 DEFB $1B,$0A,$1D,$12,$17,$90         ; }

; Rating Table
;
; The addresses of the eight ratings that can be given on the results
; screen. The rating is chosen by the number of rooms that have been visited (in
; steps of #N$20) and by whether the game was completed. A completed game always
; gets at least the fifth rating.
@label=RatingTable
w$BBB7 DEFW $BBC7    ; Fewer than #N$21 rooms visited: #R$BBC7.
 $BBB9 DEFW $BBCF    ; #N$21 to #N$40 rooms visited: #R$BBCF.
 $BBBB DEFW $BBD8    ; #N$41 to #N$60 rooms visited: #R$BBD8.
 $BBBD DEFW $BBE0    ; More than #N$60 rooms visited: #R$BBE0.
 $BBBF DEFW $BBE8    ; Game completed, with fewer than #N$21 rooms visited:
                     ; #R$BBE8.
 $BBC1 DEFW $BBF2    ; Game completed, with #N$21 to #N$40 rooms visited:
                     ; #R$BBF2.
 $BBC3 DEFW $BBFD    ; Game completed, with #N$41 to #N$60 rooms visited:
                     ; #R$BBFD.
 $BBC5 DEFW $BC05    ; Game completed, with more than #N$60 rooms visited:
                     ; #R$BC05.

; Rating Text
;
; The text of the eight ratings, in the same format as #R$BAE4, except
; that each one starts with an attribute (bright red) and is padded with spaces.
@label=RatingText
b$BBC7 DEFB $42,$26,$26,$26,$19,$18,$18,$9B             ; Bright red, " POOR"
@label=RatingText_Average
 $BBCF DEFB $42,$26,$0A,$1F,$0E,$1B,$0A,$10,$8E         ; Bright red, "
                                                        ; AVERAGE"
@label=RatingText_Fair
 $BBD8 DEFB $42,$26,$26,$26,$0F,$0A,$12,$9B             ; Bright red, " FAIR"
@label=RatingText_Good
 $BBE0 DEFB $42,$26,$26,$26,$10,$18,$18,$8D             ; Bright red, " GOOD"
@label=RatingText_Excellent
 $BBE8 DEFB $42,$0E,$21,$0C,$0E,$15,$15,$0E,$17,$9D     ; Bright red,
                                                        ; "EXCELLENT"
@label=RatingText_Marvellous
 $BBF2 DEFB $42,$16,$0A,$1B,$1F,$0E,$15,$15,$18,$1E,$9C ; Bright red,
                                                        ; "MARVELLOUS"
@label=RatingText_Hero
 $BBFD DEFB $42,$26,$26,$26,$11,$0E,$1B,$98             ; Bright red, " HERO"
@label=RatingText_Adventurer
 $BC05 DEFB $42,$0A,$0D,$1F,$0E,$17,$1D,$1E,$1B,$0E,$9B ; Bright red,
                                                        ; "ADVENTURER"

; Print Percentage Complete
;
; Used by the routine at #R$BA22.
; .
; Works out how much of the quest has been completed and prints the
; percentage in the screen buffer. Each room that has been visited counts for
; one point and each charm that has been put in the cauldron counts for two. The
; most that can be scored is #N$9C points (#N$80 rooms and #N$0E charms counted
; twice), so each point is worth about 0.64 percent. The percentage is worked
; out as a BCD number and is printed with the hundreds digit only if the quest
; has been completed in full.
@label=PrintPercentageComplete
c$BC10 LD E,$00      ; Set the count of rooms to zero.
 $BC12 LD BC,$0820   ; Set #REGb to the number of bits in a byte and #REGc to the number of
                     ; bytes of flags.
 $BC15 LD HL,$5BE8   ; Point #REGhl at the flags for the rooms that have been
                     ; visited.
@label=PrintPercentageComplete_CountByte
*$BC18 PUSH BC       ; Stash the counters.
 $BC19 LD A,(HL)     ; Fetch a byte of flags.
 $BC1A INC HL        ; Move on to the next byte.
@label=PrintPercentageComplete_CountBit
*$BC1B RRCA          ; Move a flag into the carry flag.
 $BC1C JR NC,$BC1F   ; Jump to #R$BC1F if the room has not been visited.
 $BC1E INC E         ; Count the room.
@label=PrintPercentageComplete_NextBit
*$BC1F DJNZ $BC1B    ; Jump back to #R$BC1B until the whole byte has been
                     ; counted.
 $BC21 POP BC        ; Restore the counters.
 $BC22 DEC C         ; Decrease the number of bytes left.
 $BC23 JR NZ,$BC18   ; Jump back to #R$BC18 until all of the bytes have been
                     ; counted.
; Keep the number of rooms visited for the rating, and work out the number
; of points.
 $BC25 LD A,E        ; Fetch the number of rooms visited.
 $BC26 DEC A         ; Take off one, so that the first room does not count towards the
                     ; rating.
 $BC27 LD ($5BC6),A  ; Store it for the rating.
 $BC2A LD A,($5BBB)  ; Fetch the number of charms collected.
 $BC2D SLA A         ; Double it.
 $BC2F ADD A,E       ; Add the number of rooms visited.
 $BC30 LD E,A        ; Stash the number of points in #REGe.
; Add up the percentage as a BCD number. The percentage that each point is
; worth is #N$A41A divided by #N$10000.
 $BC31 LD BC,$A41A   ; Set #REGbc to the percentage that each point is worth.
 $BC34 LD HL,$0000   ; Clear the fraction of the percentage.
 $BC37 XOR A         ; Clear the whole percentage.
@label=PrintPercentageComplete_AddPoint
*$BC38 ADD HL,BC     ; Add the percentage for a point to the fraction.
 $BC39 ADC A,$00     ; Carry into the whole percentage.
 $BC3B DAA           ; Keep the whole percentage as a BCD number.
 $BC3C DEC E         ; Decrease the number of points left.
 $BC3D JR NZ,$BC38   ; Jump back to #R$BC38 until every point has been added.
 $BC3F LD BC,$0028   ; Set #REGbc to the amount that makes up for the rounding. The total
                     ; for all of the points is #N$63FFD8, and this takes it up to #N$640000.
 $BC42 ADD HL,BC     ; Add it to the fraction.
 $BC43 ADC A,$00     ; Carry into the whole percentage.
 $BC45 DAA           ; Keep the whole percentage as a BCD number.
 $BC46 LD ($5BCA),A  ; Store the lowest two digits of the percentage.
 $BC49 LD A,$00      ; Clear #REGa without changing the carry flag.
 $BC4B ADC A,$00     ; Carry into the hundreds digit.
 $BC4D DAA           ; Keep the hundreds digit as a BCD number.
 $BC4E LD ($5BC9),A  ; Store the hundreds digit.
; Print the digits.
 $BC51 LD HL,$E4E6   ; Point #REGhl at #R$E4E6.
 $BC54 LD DE,$5BC9   ; Point #REGde at #R$5BC9.
 $BC57 LD B,$01      ; Set the number of bytes to print to #N$01.
 $BC59 LD A,(DE)     ; Fetch the hundreds digit.
 $BC5A AND A         ; Test whether it is zero.
 $BC5B JR Z,$BC61    ; Jump to #R$BC61 if the quest is not complete.
 $BC5D INC B         ; Set the number of bytes to print to #N$02.
 $BC5E JP $BCC0      ; Jump to #R$BCC0 to print the hundreds digit and then the
                     ; rest.
@label=PrintPercentageComplete_TwoDigits
*$BC61 INC HL        ; Move the position past the space for the hundreds digit.
 $BC62 INC DE        ; Move on to the lowest two digits.
 $BC63 JP $BCAE      ; Jump to #R$BCAE to print them.

; Print Days
;
; Used by the routines at #R$AFBA and #R$C3A4.
; .
; Prints the number of days that have passed on the panel, and makes the
; attributes there bright white.
@label=PrintDays
c$BC66 LD HL,$D9E2   ; Point #REGhl at the position of the days in the screen
                     ; buffer.
 $BC69 LD DE,$5BB9   ; Point #REGde at #R$5BB9.
 $BC6C LD B,$01      ; Set the number of bytes to print to #N$01.
 $BC6E CALL $BCAE    ; Print the number of days.
 $BC71 LD HL,$5AEF   ; Point #REGhl at the attributes of the days.
 $BC74 LD (HL),$47   ; Make the first one bright white.
 $BC76 INC L         ; Move on to the next one.
 $BC77 LD (HL),$47   ; Make it bright white as well.
 $BC79 RET           ; Return.

; Print Lives Graphic
;
; Used by the routine at #R$AFBA.
; .
; Draws the graphic that goes next to the number of lives on the panel,
; and makes the attributes there bright white.
@label=PrintLivesGraphic
c$BC7A LD IX,$BFDB     ; Point #REGix at the object that is used to draw the
                       ; panel.
 $BC7E LD (IX+$00),$8C ; Set the graphic number to #N$8C.
 $BC82 LD (IX+$07),$00 ; Clear the flags.
 $BC86 LD (IX+$1A),$10 ; Set the pixel X coordinate to #N$10.
 $BC8A LD (IX+$1B),$20 ; Set the pixel Y coordinate to #N$20.
 $BC8E CALL $D718      ; Draw the graphic.
 $BC91 LD A,$47        ; Set the attribute to bright white.
 $BC93 LD DE,$5A42     ; Point #REGde at the attributes of the first row.
 $BC96 LD B,$02        ; Set the number of attributes to #N$02.
 $BC98 CALL $D509      ; Fill the attributes.
 $BC9B LD DE,$5A62     ; Point #REGde at the attributes of the second row.
 $BC9E LD B,$04        ; Set the number of attributes to #N$04.
 $BCA0 JP $D509        ; Fill the attributes.

; Print Lives
;
; Used by the routines at #R$AFBA and #R$C1AB.
; .
; Prints the number of lives that the player has left on the panel.
@label=PrintLives
c$BCA3 LD DE,$5BBA   ; Point #REGde at the number of lives.
 $BCA6 LD B,$01      ; Set the number of bytes to print to #N$01.
 $BCA8 LD HL,$DDD7   ; Point #REGhl at #R$DDD7.
 $BCAB JP $BCAE      ; Print the number of lives.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$BA57 }
; LIST#

; Print BCD Number
;
; Used by the routines at #R$BA22, #R$BC10, #R$BC66 and #R$BCA3.
; .
; Prints a BCD number in the screen buffer, using the standard font. Every
; digit is printed, including leading zeroes.
;
; B Number of bytes (pairs of digits) to print
; DE Address of the number
; HL Address in the screen buffer to print at
@label=PrintBCDNumber
c$BCAE PUSH HL       ; Stash the address in the screen buffer.
 $BCAF LD HL,$6108   ; Point #REGhl at #R$6108.
 $BCB2 LD ($5BC7),HL ; Use it to print.
 $BCB5 POP HL        ; Restore the address in the screen buffer.
@label=PrintBCDNumber_NextByte
*$BCB6 LD A,(DE)     ; Fetch two digits.
 $BCB7 RRCA          ; {Move the first digit into the lowest four bits.
 $BCB8 RRCA          ;
 $BCB9 RRCA          ;
 $BCBA RRCA          ; }
 $BCBB AND %00001111 ; Keep only the first digit.
 $BCBD CALL $BE7F    ; Print the first digit.
; This entry point is used by the routine at #R$BC10.
@label=PrintBCDNumber_SecondDigit
*$BCC0 LD A,(DE)     ; Fetch two digits.
 $BCC1 AND %00001111 ; Keep only the second digit.
 $BCC3 CALL $BE7F    ; Print the second digit.
 $BCC6 INC DE        ; Move on to the next two digits.
 $BCC7 DJNZ $BCB6    ; Jump back to #R$BCB6 until all of the bytes have been
                     ; printed.
 $BCC9 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$BA62 }
; { #NIGHTSHADE$C314 }
; { #PENTAGRAM$BB48 }
; LIST#

; Print Day Caption
;
; Used by the routine at #R$AFBA.
; .
; Prints the caption "DAY" on the panel. The colour of the caption is made
; to stand out against the colour of the room.
@label=PrintDayCaption
c$BCCA LD A,($5BAD)  ; Fetch the attribute of the room.
 $BCCD CPL           ; Invert it.
 $BCCE ADD A,$02     ; Add #N$02 to it.
 $BCD0 AND %00000111 ; Keep the ink colour.
 $BCD2 OR %01000000  ; Make it bright.
 $BCD4 LD ($BCE7),A  ; Store it as the attribute of the caption.
 $BCD7 LD HL,$BCEC   ; Point #REGhl at #R$BCEC.
 $BCDA LD ($5BC7),HL ; Use it to print.
 $BCDD LD DE,$BCE7   ; Point #REGde at #R$BCE7.
 $BCE0 LD HL,$0F70   ; Set the X coordinate to #N$70 and the Y coordinate to
                     ; #N$0F.
 $BCE3 PUSH HL       ; Stash the coordinates, as #R$BE4C expects to find them
                     ; there.
 $BCE4 JP $BE4C      ; Print the caption.

; Day Caption
;
; The text that #R$BCCA prints.
@label=DayCaption
b$BCE7 DEFB $00             ; Attribute (set when the caption is printed).
 $BCE8 DEFB $00,$01,$02,$83 ; The four characters of the caption, from #R$BCEC.

; Day Caption Font
;
; The four characters that make up the caption "DAY".
; #UDGARRAY4,56,4($BCEC-$BD0B-8)(day)
@label=DayCaptionFont
b$BCEC DEFB $06,$07,$06,$06,$06,$06,$06,$0F
 $BCF4 DEFB $00,$01,$82,$C6,$64,$6C,$6D,$C6
 $BCFC DEFB $C8,$C6,$E1,$60,$60,$E0,$64,$63
 $BD04 DEFB $60,$60,$60,$E0,$60,$40,$C0,$80

; Game Selection Menu
;
; Used by the routine at #R$AF88.
; .
; Shows the menu on which the player chooses the keyboard or one of the
; joysticks, and waits until the player starts the game. Keys 1 to 4 choose the
; control method, key 5 turns the directional control on or off and key 0 starts
; the game. The menu tune plays while this is going on, and the choices that are
; in force are shown by flashing. The control method is kept in #R$5BA4 in these
; bits: bits 1 and 2 are #N$00 for the keyboard, #N$01 for the Kempston
; joystick, #N$02 for the Cursor joystick and #N$03 for the Interface 2
; joystick, and bit 3 is set if the directional control is on.
@label=GameMenu
c$BD0C XOR A         ; Get a zero.
 $BD0D LD ($5BB8),A  ; Flag that the border has to be drawn.
 $BD10 LD HL,$BDA2   ; Point #REGhl at #R$BDA2.
 $BD13 LD B,$08      ; Set the number of lines to #N$08.
@label=GameMenu_StopFlashing
*$BD15 RES 7,(HL)    ; Switch off the flashing of the line.
 $BD17 INC HL        ; Move on to the next line.
 $BD18 DJNZ $BD15    ; Jump back to #R$BD15 until all of the lines have been
                     ; done.
 $BD1A CALL $D567    ; Clear the screen buffer.
 $BD1D CALL $BEB3    ; Draw the menu.
 $BD20 CALL $BD89    ; Flash the options that have been chosen.
; Check which keys are pressed.
@label=GameMenu_MenuLoop
*$BD23 CALL $BEB3    ; Draw the menu again.
 $BD26 LD DE,$B253   ; Point #REGde at #R$B253.
 $BD29 CALL $B2B6    ; Play the tune if it has not been played yet.
 $BD2C LD A,$F7      ; Select the half-row of the keyboard with the keys 1 to
                     ; 5.
 $BD2E CALL $B5F7    ; Read the keyboard.
 $BD31 LD E,A        ; Stash the keys that are pressed in #REGe.
 $BD32 LD A,($5BA4)  ; Fetch the control method.
 $BD35 LD ($5BA6),A  ; Keep it, to see if it changes.
 $BD38 BIT 0,E       ; {Jump to #R$BD3E if key 1 is not pressed.
 $BD3A JR Z,$BD3E    ; }
 $BD3C AND %11111001 ; Choose the keyboard.
@label=GameMenu_TestKempston
*$BD3E BIT 1,E       ; {Jump to #R$BD46 if key 2 is not pressed.
 $BD40 JR Z,$BD46    ; }
 $BD42 AND %11111001 ; Clear the choice of control method.
 $BD44 OR %00000010  ; Choose the Kempston joystick.
@label=GameMenu_TestCursor
*$BD46 BIT 2,E       ; {Jump to #R$BD4E if key 3 is not pressed.
 $BD48 JR Z,$BD4E    ; }
 $BD4A AND %11111001 ; Clear the choice of control method.
 $BD4C OR %00000100  ; Choose the Cursor joystick.
@label=GameMenu_TestInterface
*$BD4E BIT 3,E       ; {Jump to #R$BD54 if key 4 is not pressed.
 $BD50 JR Z,$BD54    ; }
 $BD52 OR %00000110  ; Choose the Interface 2 joystick.
@label=GameMenu_SetMethod
*$BD54 LD ($5BA4),A  ; Store the control method.
 $BD57 LD HL,$5BD2   ; Point #REGhl at the flag that says key 5 was pressed
                     ; last time.
 $BD5A BIT 4,E       ; {Jump to #R$BD85 if key 5 is not pressed.
 $BD5C JR Z,$BD85    ; }
 $BD5E BIT 0,(HL)    ; {Jump to #R$BD6C if key 5 was pressed last time.
 $BD60 JR NZ,$BD6C   ; }
 $BD62 SET 0,(HL)    ; Flag that key 5 is pressed.
 $BD64 LD A,($5BA4)  ; Fetch the control method.
 $BD67 XOR %00001000 ; Turn the directional control on or off.
 $BD69 LD ($5BA4),A  ; Store the control method.
@label=GameMenu_TestStart
*$BD6C LD HL,$5BA6   ; Point #REGhl at the previous control method.
 $BD6F CP (HL)       ; Compare it with the control method.
 $BD70 CALL NZ,$B4A3 ; Play a beep if the control method has changed.
 $BD73 LD A,$EF      ; Select the half-row of the keyboard with the keys 6 to
                     ; 0.
 $BD75 CALL $B5F7    ; Read the keyboard.
 $BD78 BIT 0,A       ; Test whether key 0 is pressed.
 $BD7A RET NZ        ; Return if it is, to start the game.
 $BD7B LD HL,$5BA0   ; Point #REGhl at #R$5BA0.
 $BD7E INC (HL)      ; Change the seed.
 $BD7F CALL $BD89    ; Flash the options that have been chosen.
 $BD82 JP $BD23      ; Jump back to #R$BD23.
@label=GameMenu_ReleaseKey5
*$BD85 RES 0,(HL)    ; Flag that key 5 is not pressed.
 $BD87 JR $BD6C      ; Jump to #R$BD6C.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$BA7E }
; { #MARTIANOIDS$BB12 }
; { #NIGHTSHADE$C8CA }
; { #PENTAGRAM$BB74 }
; LIST#
; .
; #HTML(#AUDIO0(main-tune.wav)(#INCLUDE(MainTune)))
; .
; #PUSHS #UDGTABLE
; { #SIM(start=$AF6C,stop=$AFA2,sp=$5BA0,clear=1)
; #SIM(start=$BD0C,stop=$BD23)
; #SCR$02(game-selection-menu) } UDGTABLE# #POPS

; Flash Menu Options
;
; Used by the routine at #R$BD0C.
; .
; Makes the line for the chosen control method flash, and does the same to
; the line for the directional control if it is on. The flashing of all of the
; other lines is switched off.
@label=FlashMenuOptions
c$BD89 LD HL,$BDA3   ; Point #REGhl at the colour of the line for the keyboard.
 $BD8C LD A,($5BA4)  ; Fetch the control method.
 $BD8F RRCA          ; Move the choice of control method into the lowest two
                     ; bits.
 $BD90 AND %00000011 ; Keep only the choice.
 $BD92 LD B,$04      ; Set the number of control methods to #N$04.
 $BD94 CALL $BEA3    ; Make the chosen line flash and stop the rest from
                     ; flashing.
 $BD97 RES 7,(HL)    ; Stop the line for the directional control from flashing.
 $BD99 LD A,($5BA4)  ; Fetch the control method.
 $BD9C AND %00001000 ; Keep the bit for the directional control.
 $BD9E RET Z         ; Return if the directional control is off.
 $BD9F SET 7,(HL)    ; Make the line for the directional control flash.
 $BDA1 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$BAFB }
; { #NIGHTSHADE$C949 }
; { #PENTAGRAM$BBD8 }
; LIST#

; Menu Colours
;
; The attributes of the eight lines of the menu.
@label=MenuColours
b$BDA2 DEFB $43      ; The title: #COLOUR(#PEEK(#PC)).
@label=MenuColours_ControlMethods
 $BDA3 DEFB $44      ; The four control methods: #COLOUR(#PEEK(#PC)).
 $BDA4 DEFB $44      ; The four control methods: #COLOUR(#PEEK(#PC)).
 $BDA5 DEFB $44      ; The four control methods: #COLOUR(#PEEK(#PC)).
 $BDA6 DEFB $44      ; The four control methods: #COLOUR(#PEEK(#PC)).
 $BDA7 DEFB $45      ; Directional control: #COLOUR(#PEEK(#PC)).
 $BDA8 DEFB $47      ; Starting the game and the copyright message:
                     ; #COLOUR(#PEEK(#PC)).
 $BDA9 DEFB $47      ; Starting the game and the copyright message:
                     ; #COLOUR(#PEEK(#PC)).

; Menu Coordinates
;
; The X and Y coordinates of the eight lines of the menu.
@label=MenuCoordinates
b$BDAA DEFB $58,$9F  ; {One pair for each line.
 $BDAC DEFB $30,$8F  ;
 $BDAE DEFB $30,$7F  ;
 $BDB0 DEFB $30,$6F  ;
 $BDB2 DEFB $30,$5F  ;
 $BDB4 DEFB $30,$4F  ;
 $BDB6 DEFB $30,$3F  ;
 $BDB8 DEFB $50,$27  ; }

; Menu Text
;
; The eight lines of the menu, in the same format as #R$BAE4. Character
; #N$25 is the copyright symbol and #N$24 is a full stop.
@label=MenuText
b$BDBA DEFB $14,$17,$12,$10,$11,$1D,$26,$15 ; {"KNIGHT LORE"
 $BDC2 DEFB $18,$1B,$8E                     ; }
 $BDC5 DEFB $01,$26,$14,$0E,$22,$0B,$18,$0A ; {"1 KEYBOARD"
 $BDCD DEFB $1B,$8D                         ; }
 $BDCF DEFB $02,$26,$14,$0E,$16,$19,$1C,$1D ; {"2 KEMPSTON JOYSTICK"
 $BDD7 DEFB $18,$17,$26,$13,$18,$22,$1C,$1D ;
 $BDDF DEFB $12,$0C,$94                     ; }
 $BDE2 DEFB $03,$26,$0C,$1E,$1B,$1C,$18,$1B ; {"3 CURSOR JOYSTICK"
 $BDEA DEFB $26,$26,$26,$13,$18,$22,$1C,$1D ;
 $BDF2 DEFB $12,$0C,$94                     ; }
 $BDF5 DEFB $04,$26,$12,$17,$1D,$0E,$1B,$0F ; {"4 INTERFACE II"
 $BDFD DEFB $0A,$0C,$0E,$26,$12,$92         ; }
 $BE03 DEFB $05,$26,$0D,$12,$1B,$0E,$0C,$1D ; {"5 DIRECTIONAL CONTROL"
 $BE0B DEFB $12,$18,$17,$0A,$15,$26,$0C,$18 ;
 $BE13 DEFB $17,$1D,$1B,$18,$95             ; }
 $BE18 DEFB $00,$26,$1C,$1D,$0A,$1B,$1D,$26 ; {"0 START GAME"
 $BE20 DEFB $10,$0A,$16,$8E                 ; }
 $BE24 DEFB $25,$26,$01,$09,$08,$04,$26,$0A ; {"(c) 1984 A.C.G."
 $BE2C DEFB $24,$0C,$24,$10,$A4             ; }

; Print Text Single Colour
;
; Used by the routine at #R$BEBF.
; .
; Prints a line of text in the screen buffer, using the standard font and
; the attribute that is held in #R$5BB6 for every character. The text is in the
; format that is described at #R$BAE4.
;
; DE Address of the text
; H Y coordinate
; L X coordinate
@label=PrintTextSingleColour
c$BE31 PUSH HL       ; Stash the coordinates.
 $BE32 LD HL,$6108   ; Point #REGhl at #R$6108.
 $BE35 LD ($5BC7),HL ; Use it to print.
 $BE38 POP BC        ; Fetch the coordinates in #REGbc.
 $BE39 PUSH BC       ; Stash them again.
 $BE3A CALL $D811    ; Find the address in the screen buffer.
 $BE3D LD L,C        ; {Copy it to #REGhl.
 $BE3E LD H,B        ; }
 $BE3F LD A,($5BB6)  ; {Fetch the attribute and keep it in #REGaf'.
 $BE42 EX AF,AF'     ; }
 $BE43 JR $BE56      ; Jump to #R$BE56.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$BB9D }
; { #PENTAGRAM$BC66 }
; LIST#

; Print Text Standard Font
;
; Used by the routine at #R$BA22.
; .
; Prints a line of text in the screen buffer, using the standard font. The
; first byte of the text is the attribute of the line.
;
; DE Address of the text
; H Y coordinate
; L X coordinate
@label=PrintTextStandardFont
c$BE45 PUSH HL       ; Stash the coordinates.
 $BE46 LD HL,$6108   ; Point #REGhl at #R$6108.
 $BE49 LD ($5BC7),HL ; Use it to print.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$BBB1 }
; { #PENTAGRAM$BC7A }
; LIST#

; Print Text
;
; Used by the routine at #R$BCCA.
; .
; Prints a line of text in the screen buffer, using the font that is
; pointed to by #R$5BC7. The first byte of the text is the attribute of the
; line. The attribute of each character is set on the screen at once. The
; coordinates are the Y coordinate (in the high byte) and the X coordinate,
; which are expected to be on the stack. The Y coordinate is at the top of the
; character.
;
; DE Address of the text
@label=PrintText
c$BE4C POP BC        ; Fetch the coordinates.
 $BE4D PUSH BC       ; Stash them again.
 $BE4E CALL $D811    ; Find the address in the screen buffer.
 $BE51 LD L,C        ; {Copy it to #REGhl.
 $BE52 LD H,B        ; }
 $BE53 LD A,(DE)     ; Fetch the attribute.
 $BE54 EX AF,AF'     ; Keep it in #REGaf'.
 $BE55 INC DE        ; Point #REGde at the first character.
; This entry point is used by the routine at #R$BE31.
; .
; Work out the address in the attribute file, using the other registers.
@label=PrintText_Setup
*$BE56 EXX           ; Switch to the other registers.
 $BE57 POP HL        ; Fetch the coordinates.
 $BE58 PUSH DE       ; Stash the address of the text.
 $BE59 CALL $D848    ; Find the address in the attribute file.
 $BE5C LD L,E        ; {Copy it to #REGhl.
 $BE5D LD H,D        ; }
 $BE5E POP DE        ; Restore the address of the text.
@label=PrintText_NextCharacter
*$BE5F EXX           ; Switch to the registers that hold the address in the screen buffer
                     ; and the address of the text.
 $BE60 LD A,(DE)     ; Fetch the next character.
 $BE61 BIT 7,A       ; {Jump to #R$BE72 if it is the last one.
 $BE63 JR NZ,$BE72   ; }
 $BE65 PUSH DE       ; Stash the address of the text.
 $BE66 CALL $BE7F    ; Print the character.
 $BE69 POP DE        ; Restore the address of the text.
 $BE6A INC DE        ; Move on to the next character.
 $BE6B EXX           ; Switch to the registers that hold the address in the
                     ; attribute file.
 $BE6C EX AF,AF'     ; Fetch the attribute.
 $BE6D LD (HL),A     ; Set the attribute of the character.
 $BE6E INC L         ; Move on to the next attribute.
 $BE6F EX AF,AF'     ; Keep the attribute in #REGaf'.
 $BE70 JR $BE5F      ; Jump back to #R$BE5F.
@label=PrintText_LastCharacter
*$BE72 AND %01111111 ; Clear bit 7 of the last character.
 $BE74 PUSH DE       ; Stash the address of the text.
 $BE75 CALL $BE7F    ; Print the character.
 $BE78 POP DE        ; Restore the address of the text.
 $BE79 INC DE        ; Point #REGde at what follows the text.
 $BE7A EXX           ; Switch to the registers that hold the address in the
                     ; attribute file.
 $BE7B EX AF,AF'     ; Fetch the attribute.
 $BE7C LD (HL),A     ; Set the attribute of the character.
 $BE7D EXX           ; Switch back to the other registers.
 $BE7E RET           ; Return.

; Print Character
;
; Used by the routines at #R$BCAE and #R$BE4C.
; .
; Prints one character in the screen buffer. A character is eight bytes,
; one for each row from the top. The rows of the screen buffer run from the
; bottom up, so the rows are stored #N$20 bytes apart and going down. The font
; is the one that #R$5BC7 points to.
;
;   A Number of the character
;   HL Address in the screen buffer of the top row
; O:HL Address in the screen buffer of the top row of the next character
@label=PrintCharacter
c$BE7F PUSH BC       ; Stash #REGbc.
 $BE80 PUSH DE       ; Stash #REGde.
 $BE81 PUSH HL       ; Stash the address in the screen buffer.
 $BE82 LD L,A        ; Copy the number of the character into #REGl.
 $BE83 LD H,$00      ; Clear #REGh.
 $BE85 ADD HL,HL     ; {Multiply it by eight.
 $BE86 ADD HL,HL     ;
 $BE87 ADD HL,HL     ; }
 $BE88 LD DE,($5BC7) ; Fetch the address of the font.
 $BE8C ADD HL,DE     ; Find the data of the character.
 $BE8D EX DE,HL      ; Point #REGde at it.
 $BE8E POP HL        ; Restore the address in the screen buffer.
 $BE8F LD B,$08      ; Set the number of rows to #N$08.
@label=PrintCharacter_NextRow
*$BE91 LD A,(DE)     ; Fetch a row of the character.
 $BE92 LD (HL),A     ; Put it in the screen buffer.
 $BE93 INC DE        ; Move on to the next row of the character.
 $BE94 PUSH BC       ; Stash the counter.
 $BE95 LD BC,$FFE0   ; Set #REGbc to #N$FFE0, which is minus the length of a line of the
                     ; screen buffer.
 $BE98 ADD HL,BC     ; Move down a row in the screen buffer.
 $BE99 POP BC        ; Restore the counter.
 $BE9A DJNZ $BE91    ; Jump back to #R$BE91 until all of the rows have been
                     ; done.
 $BE9C POP DE        ; Restore #REGde.
 $BE9D LD BC,$0101   ; Set #REGbc to eight lines up and one byte along.
 $BEA0 ADD HL,BC     ; Move to the top row of the next character.
 $BEA1 POP BC        ; Restore #REGbc.
 $BEA2 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$BBEB }
; { #PENTAGRAM$BAEA }
; LIST#

; Set Flashing Attribute
;
; Used by the routine at #R$BD89.
; .
; Switches on the flashing (bit 7) of one in a list of attributes and
; switches it off for all of the others.
;
;   A Position in the list of the attribute that is to flash
;   B Number of attributes in the list
;   HL Address of the list
; O:HL Address just beyond the list
@label=SetFlashingAttribute
c$BEA3 AND A         ; Test the position.
 $BEA4 JR NZ,$BEAD   ; Jump to #R$BEAD if it is not the first.
@label=SetFlashingAttribute_Flash
*$BEA6 SET 7,(HL)    ; Switch on the flashing of the attribute.
 $BEA8 JR $BEAF      ; Jump to #R$BEAF.
@label=SetFlashingAttribute_NextLine
*$BEAA DEC A         ; Count down to the attribute that flashes.
 $BEAB JR Z,$BEA6    ; Jump to #R$BEA6 if this is it.
@label=SetFlashingAttribute_Steady
*$BEAD RES 7,(HL)    ; Switch off the flashing of the attribute.
@label=SetFlashingAttribute_Advance
*$BEAF INC HL        ; Move on to the next attribute.
 $BEB0 DJNZ $BEAA    ; Jump back to #R$BEAA until the whole list has been done.
 $BEB2 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$BC15 }
; { #PENTAGRAM$BB64 }
; LIST#

; Display Menu
;
; Used by the routine at #R$BD0C.
; .
; Prints the lines of the menu.
@label=DisplayMenu
c$BEB3 LD DE,$BDA2   ; Point #REGde at the colours of the lines.
 $BEB6 EXX           ; Switch to the other registers to keep it there.
 $BEB7 LD HL,$BDAA   ; Point #REGhl at #R$BDAA.
 $BEBA LD DE,$BDBA   ; Point #REGde at #R$BDBA.
 $BEBD LD B,$08      ; Set the number of lines to #N$08.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$BC25 }
; { #NIGHTSHADE$CA2B }
; { #PENTAGRAM$BCB4 }
; LIST#

; Display Text List
;
; Used by the routines at #R$BA22 and #R$BAAB.
; .
; Prints a list of lines of text in the screen buffer, each in its own
; colour. If the border has not been drawn yet, it is drawn and the screen
; buffer is copied to the display.
;
; B Number of lines
; DE Address of the text
; HL Address of the coordinates of the lines (X and Y for each line)
; DE' Address of the attributes of the lines
@label=DisplayTextList
c$BEBF EXX           ; Switch to the registers that hold the attributes.
 $BEC0 LD A,(DE)     ; Fetch the attribute of the line.
 $BEC1 LD ($5BB6),A  ; Store it as the attribute to print with.
 $BEC4 INC DE        ; Move on to the next attribute.
 $BEC5 EXX           ; Switch back.
 $BEC6 PUSH BC       ; Stash the number of lines.
 $BEC7 LD A,(HL)     ; Fetch the X coordinate.
 $BEC8 INC HL        ; {Move on to the next pair of coordinates.
 $BEC9 INC HL        ; }
 $BECA PUSH HL       ; Stash the address of the next pair.
 $BECB DEC HL        ; Point #REGhl at the Y coordinate.
 $BECC LD H,(HL)     ; Fetch the Y coordinate.
 $BECD LD L,A        ; Set the X coordinate.
 $BECE CALL $BE31    ; Print the line.
 $BED1 POP HL        ; Restore the address of the next pair.
 $BED2 POP BC        ; Restore the number of lines.
 $BED3 DJNZ $BEBF    ; Jump back to #R$BEBF until all of the lines have been
                     ; printed.
 $BED5 LD A,($5BB8)  ; Fetch the flag that says the border has been drawn.
 $BED8 AND A         ; Test it.
 $BED9 RET NZ        ; Return if it has.
 $BEDA INC A         ; Set the flag.
 $BEDB LD ($5BB8),A  ; Store it.
 $BEDE CALL $D296    ; Draw the border.
 $BEE1 JP $D56F      ; Copy the screen buffer to the display.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$BC31 }
; LIST#

; Print Sprites
;
; Used by the routines at #R$D255 and #R$D296.
; .
; Draws a sprite a number of times, moving it along by a fixed amount each
; time.
;
; B Number of times to draw the sprite
; D Amount to add to the pixel Y coordinate each time
; E Amount to add to the pixel X coordinate each time
; IX Address of the object that holds the sprite
@label=PrintSprites
c$BEE4 PUSH BC       ; {Stash the registers.
 $BEE5 PUSH DE       ;
 $BEE6 PUSH HL       ; }
 $BEE7 CALL $D718    ; Draw the sprite.
 $BEEA POP HL        ; {Restore the registers.
 $BEEB POP DE        ;
 $BEEC POP BC        ; }
 $BEED LD A,(IX+$1A) ; Fetch the pixel X coordinate.
 $BEF0 ADD A,E       ; Add the offset.
 $BEF1 LD (IX+$1A),A ; Store the new pixel X coordinate.
 $BEF4 LD A,(IX+$1B) ; Fetch the pixel Y coordinate.
 $BEF7 ADD A,D       ; Add the offset.
 $BEF8 LD (IX+$1B),A ; Store the new pixel Y coordinate.
 $BEFB DJNZ $BEE4    ; Jump back to #R$BEE4 until all of the sprites have been
                     ; drawn.
 $BEFD RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$BC56 }
; { #PENTAGRAM$BDDE }
; LIST#

; Handle Player Appearing
;
; Handles the sparkles that show the player appearing, which go through
; the graphic numbers #N$78 to #N$7E. The graphic changes on every other frame,
; and each change makes a sound. The last sparkle is handled by #R$BF11.
;
; IX Address of the sparkle object
@label=HandlePlayerAppearing
c$BEFE CALL $C4D8    ; Set the pixel adjustments of a sparkle.
 $BF01 LD A,($5BA2)  ; Fetch the frame counter.
 $BF04 CPL           ; Invert it.
 $BF05 AND %00000001 ; Keep the lowest bit.
 $BF07 RET NZ        ; Return on every other frame.
 $BF08 INC (IX+$00)  ; Change to the next graphic.
 $BF0B CALL $B419    ; Play the sound of the player appearing.
 $BF0E JP $C692      ; Flag the object to be drawn again.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$BC70 }
; LIST#

; Handle Last Appearing Sparkle
;
; Handles the last of the sparkles that show the player appearing. The
; object turns into the player, who is no longer dead, and is updated as the
; player right away.
;
; IX Address of the sparkle object
@label=HandleLastAppearingSparkle
c$BF11 CALL $C4D8     ; Set the pixel adjustments of a sparkle.
 $BF14 RES 6,(IX+$0D) ; Clear the flag that says the player is dead.
 $BF18 LD A,(IX+$10)  ; Fetch the graphic number of the player.
 $BF1B LD (IX+$00),A  ; Make it the graphic number of the object.
 $BF1E JP $AFD5       ; Update the object as the player.

; Start Death Sparkles
;
; Used by the routines at #R$C337, #R$C82B and #R$CDE2.
; .
; Turns the object into the first of the sparkles that show the player
; dying, which go through the graphic numbers #N$70 to #N$76.
;
; IX Address of the object
@label=StartDeathSparkles
c$BF21 LD (IX+$00),$70 ; Set the graphic number to #N$70.
 $BF25 SET 1,(IX+$07)  ; Flag the object to be ignored in the 3D calculations.
 $BF29 JR $BF31        ; Jump to #R$BF31.

; Handle Death Sparkles
;
; Used by the routine at #R$B6A2.
; .
; Handles the sparkles that show the player dying, which go through the
; graphic numbers #N$70 to #N$76 (and #N$B8). The graphic changes on every
; frame.
;
; IX Address of the sparkle object
@label=HandleDeathSparkles
c$BF2B CALL $C4D8    ; Set the pixel adjustments of a sparkle.
 $BF2E INC (IX+$00)  ; Change to the next graphic.
; This entry point is used by the routine at #R$BF21.
@label=HandleDeathSparkles_Draw
*$BF31 CALL $B403    ; Play the sound of the sparkles.
 $BF34 JP $C692      ; Flag the object to be drawn again.

; Handle Vanishing Object Sparkles
;
; Handles the graphic numbers #N$B9 to #N$BB, which are for sparkles of an
; object that is going away for good. The entry in the table that the object
; points to is cleared, and then the object is removed in the same way as the
; last of the death sparkles.
;
; IX Address of the sparkle object
@label=HandleVanishingObjectSparkles
c$BF37 LD L,(IX+$10) ; Fetch the low byte of the address of the table entry that the object
                     ; comes from.
 $BF3A LD H,(IX+$11) ; Fetch the high byte.
 $BF3D LD (HL),$00   ; Clear the graphic number of that entry.
; Remove the last of the death sparkles.
@label=HandleLastDeathSparkle
 $BF3F CALL $C4D8    ; Set the pixel adjustments of a sparkle.
 $BF42 JP $B95E      ; Remove the object.

; Display Objects Carried
;
; Used by the routine at #R$D59F.
; .
; Draws the objects that the player is carrying on the panel, but only if
; they have changed since they were last drawn. The panel has room for three
; objects, which are drawn from the left: the object that was picked up last
; comes first. Each object is drawn in a space of #N$18 by #N$18 pixels, with a
; colour that goes with it.
@label=DisplayObjectsCarried
c$BF45 LD A,($5BB4)    ; Fetch the flag that says the objects carried have
                       ; changed.
 $BF48 AND A           ; Test it.
 $BF49 RET Z           ; Return if they have not changed.
 $BF4A XOR A           ; Clear #REGa.
 $BF4B LD ($5BB4),A    ; Clear the flag.
; This entry point is used by the routine at #R$AFBA.
; .
; The objects are drawn using an object that is kept just for drawing the
; panel.
@label=DisplayObjects
*$BF4E PUSH IX         ; Stash #REGix.
 $BF50 LD IX,$BFDB     ; Point #REGix at #R$BFDB.
 $BF54 LD B,$03        ; Set the number of objects to #N$03.
 $BF56 LD HL,$5BDC     ; Point #REGhl at #R$5BDC.
@label=DisplayObjects_Next
*$BF59 PUSH BC         ; Stash the number of objects left.
 $BF5A PUSH HL         ; Stash the address of the object carried.
 $BF5B LD A,B          ; Copy the number of objects left into #REGa.
 $BF5C NEG             ; Negate it.
 $BF5E ADD A,$03       ; Add #N$03, to get the number of objects done.
 $BF60 SLA A           ; {Multiply it by eight.
 $BF62 SLA A           ;
 $BF64 SLA A           ; }
 $BF66 LD C,A          ; Stash it in #REGc.
 $BF67 SLA A           ; Multiply it by two.
 $BF69 ADD A,C         ; Add the number multiplied by eight, to get it
                       ; multiplied by #N$18.
 $BF6A ADD A,$10       ; Add #N$10 to get the pixel X coordinate.
 $BF6C LD (IX+$1A),A   ; Set the pixel X coordinate.
 $BF6F LD (IX+$1B),$00 ; Set the pixel Y coordinate to #N$00.
 $BF73 LD C,(IX+$1A)   ; Fetch the pixel X coordinate into #REGc.
 $BF76 LD B,(IX+$1B)   ; Fetch the pixel Y coordinate into #REGb.
 $BF79 PUSH HL         ; Stash the address of the object carried.
 $BF7A CALL $D811      ; Find the address in the screen buffer.
 $BF7D LD L,C          ; {Copy it to #REGhl.
 $BF7E LD H,B          ; }
 $BF7F LD BC,$0318     ; Set the width to #N$03 bytes and the height to #N$18
                       ; lines.
 $BF82 XOR A           ; Set the fill byte to #N$00.
 $BF83 CALL $C515      ; Clear the area.
 $BF86 POP HL          ; Restore the address of the object carried.
 $BF87 LD A,(HL)       ; Fetch the graphic number of the object.
 $BF88 AND A           ; Test it.
 $BF89 JR Z,$BF91      ; Jump to #R$BF91 if there is no object.
 $BF8B LD (IX+$00),A   ; Set the graphic number of the panel object.
 $BF8E CALL $D718      ; Draw the object.
; Copy the area from the screen buffer to the display.
@label=DisplayObjectsCarried_CopyPlace
*$BF91 LD C,(IX+$1A)   ; Fetch the pixel X coordinate into #REGc.
 $BF94 LD B,(IX+$1B)   ; Fetch the pixel Y coordinate into #REGb.
 $BF97 CALL $D826      ; Find the address in the display.
 $BF9A CALL $D811      ; Find the address in the screen buffer.
 $BF9D LD L,C          ; {Copy it to #REGhl.
 $BF9E LD H,B          ; }
 $BF9F LD BC,$1803     ; Set the number of lines to #N$18 and the number of
                       ; bytes to #N$03.
 $BFA2 CALL $D67C      ; Copy the area to the display.
; Colour the area.
 $BFA5 POP HL          ; Restore the address of the object carried.
 $BFA6 POP BC          ; Restore the number of objects left.
 $BFA7 PUSH BC         ; Stash the number of objects left.
 $BFA8 PUSH HL         ; Stash the address of the object carried.
 $BFA9 LD A,(HL)       ; Fetch the graphic number of the object.
 $BFAA AND %00001111   ; Keep the number of the object.
 $BFAC LD E,A          ; Copy it into #REGe.
 $BFAD LD D,$00        ; Clear #REGd.
 $BFAF LD HL,$BFD3     ; Point #REGhl at #R$BFD3.
 $BFB2 ADD HL,DE       ; Find the attribute of the object.
 $BFB3 LD C,(HL)       ; Fetch it into #REGc.
 $BFB4 LD L,(IX+$1A)   ; Set #REGl to the pixel X coordinate.
 $BFB7 LD A,(IX+$1B)   ; Fetch the pixel Y coordinate.
 $BFBA ADD A,$17       ; Add #N$17, to get the top of the area.
 $BFBC LD H,A          ; Use it as the Y coordinate of the position.
 $BFBD CALL $D848      ; Find the address in the attribute file.
 $BFC0 EX DE,HL        ; Copy it to #REGhl.
 $BFC1 LD A,C          ; Fetch the attribute.
 $BFC2 LD BC,$0303     ; Set the width to #N$03 and the height to #N$03.
 $BFC5 CALL $C515      ; Colour the area.
 $BFC8 POP HL          ; Restore the address of the object carried.
 $BFC9 POP BC          ; Restore the number of objects left.
 $BFCA INC HL          ; {Move on to the next object carried.
 $BFCB INC HL          ;
 $BFCC INC HL          ;
 $BFCD INC HL          ; }
 $BFCE DJNZ $BF59      ; Jump back to #R$BF59 until all of the objects have
                       ; been drawn.
 $BFD0 POP IX          ; Restore #REGix.
 $BFD2 RET             ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$BC9D }
; { #PENTAGRAM$BA3D }
; LIST#
; .
; #PUSHS #UDGTABLE { =h After #R$BF45 }
; { #SIM(start=$AF6C,stop=$AFA2,sp=$5BA0,clear=1)
; #SIM(start=$D55F,stop=$0000,sp=$5B80)
; #POKES$5BDC,$60;$5BE0,$63;$5BE4,$61;$5BB4,$01
; #SIM(start=$BF45,stop=$0000,sp=$5B80)
; #SCR$02,$00,$14,$10,$04(display-objects-carried) } UDGTABLE# #POPS

; Object Attributes
;
; The attributes that are used for the objects on the panel, in the order
; of the graphic numbers #N$60 to #N$67 (the last of which is the extra life).
@label=ObjectAttributes
b$BFD3 DEFB $42      ; #COLOUR(#PEEK(#PC)).
 $BFD4 DEFB $43      ; #COLOUR(#PEEK(#PC)).
 $BFD5 DEFB $44      ; #COLOUR(#PEEK(#PC)).
 $BFD6 DEFB $45      ; #COLOUR(#PEEK(#PC)).
 $BFD7 DEFB $46      ; #COLOUR(#PEEK(#PC)).
 $BFD8 DEFB $47      ; #COLOUR(#PEEK(#PC)).
 $BFD9 DEFB $42      ; #COLOUR(#PEEK(#PC)).
 $BFDA DEFB $47      ; #COLOUR(#PEEK(#PC)).

; Panel Object
;
; An object that is used for drawing the graphics of the panel (the
; objects that are carried and the lives). Only its graphic number, its flags
; and its pixel coordinates are used.
@label=PanelObject
g$BFDB DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $BFE3 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $BFEB DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $BFF3 DEFB $00,$00,$00,$00,$00,$00,$00,$00

; Test Pickup Drop Key
;
; Used by the routine at #R$C00E.
; .
; Tests whether the control for picking up or dropping an object is
; pressed. If the joystick is used with the directional control, the other of
; the two bits for this is used.
;
; O:F Zero flag set if the control is not pressed
@label=TestPickupDropKey
c$BFFB LD HL,$5BA4   ; Point #REGhl at the control method.
 $BFFE LD A,(HL)     ; Fetch it.
 $BFFF AND %00000110 ; Keep the choice of joystick.
 $C001 LD A,($5BB5)  ; Fetch the controls that are pressed.
 $C004 JR Z,$C00B    ; Jump to #R$C00B if the keyboard is in use.
 $C006 BIT 3,(HL)    ; {Jump to #R$C00B if the directional control is not on.
 $C008 JR Z,$C00B    ; }
 $C00A RRCA          ; Move the bit for the directional control into place.
@label=TestPickupDropKey_Test
*$C00B AND %00010000 ; Keep the bit for picking up and dropping.
 $C00D RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$BD58 }
; { #PENTAGRAM$BF66 }
; LIST#

; Handle Pickup And Drop
;
; Used by the routine at #R$C82B.
; .
; Picks up or drops an object when the player presses the control for it.
; A special object that is close enough is picked up. If the player carries
; three objects already, the one that has been carried longest is dropped in the
; place of the new one. Otherwise, if the player is carrying something and there
; is a free place for a special object in the room, the object that has been
; carried longest is dropped where the player stands, and the player is lifted
; up by #N$0C to stand on it. If the player is in the cauldron room and jumping
; above the cauldron, the object is dropped into the cauldron.
; .
; The routine looks for objects by making the player a little wider,
; deeper and taller, which is put right when the routine ends.
;
; IX Address of the bottom half of the player
@label=HandlePickupAndDrop
c$C00E LD A,($5BB3)    ; Fetch the flag that says the control has been pressed and not yet
                       ; released.
 $C011 AND A           ; Test it.
 $C012 JP NZ,$C0A9     ; Jump to #R$C0A9 if it was pressed on a frame before.
 $C015 CALL $BFFB      ; Test whether the control is pressed.
 $C018 RET Z           ; Return if it is not.
 $C019 CALL $C87A      ; Test whether the player is in the room.
 $C01C RET NC          ; Return if the player is out of bounds.
 $C01D BIT 3,(IX+$0C)  ; Test whether the player is jumping.
 $C021 RET NZ          ; Return if so.
 $C022 BIT 2,(IX+$0C)  ; Test whether the player has hit something below.
 $C026 RET Z           ; Return if the player is in the air.
; Find out whether there is room to drop an object, by raising the player
; by #N$0C to see if it hits anything.
 $C027 XOR A           ; Clear #REGa.
 $C028 LD ($5BD3),A    ; Flag that an object can be dropped.
 $C02B LD A,(IX+$03)   ; Fetch the Z coordinate of the player.
 $C02E LD B,A          ; Stash it in #REGb.
 $C02F ADD A,$0C       ; Add #N$0C to it.
 $C031 LD (IX+$03),A   ; Set it as the Z coordinate of the player.
 $C034 CALL $B4FD      ; Test whether the player intersects another object.
 $C037 LD (IX+$03),B   ; Restore the Z coordinate of the player.
 $C03A JR NC,$C041     ; Jump to #R$C041 if there is room.
 $C03C LD A,$01        ; Get the value that sets a flag.
 $C03E LD ($5BD3),A    ; Flag that no object can be dropped.
@label=HandlePickupAndDrop_Pressed
*$C041 CALL $B4A3      ; Play a beep.
 $C044 LD A,$01        ; Get the value that sets a flag.
 $C046 LD ($5BB3),A    ; Flag that the control has been pressed.
 $C049 LD ($5BB4),A    ; Flag that the objects carried have changed.
; Make the player wider, deeper and taller, to find an object to pick up.
 $C04C LD B,$02        ; Set the number of special objects in the room to
                       ; #N$02.
 $C04E LD L,(IX+$04)   ; Fetch the width of the player.
 $C051 LD A,L          ; Copy it into #REGa.
 $C052 ADD A,$04       ; Add #N$04 to it.
 $C054 LD (IX+$04),A   ; Set the new width.
 $C057 LD H,(IX+$05)   ; Fetch the depth of the player.
 $C05A LD A,H          ; Copy it into #REGa.
 $C05B ADD A,$04       ; Add #N$04 to it.
 $C05D LD (IX+$05),A   ; Set the new depth.
 $C060 PUSH HL         ; Stash the old width and depth.
 $C061 LD L,(IX+$06)   ; Fetch the height of the player.
 $C064 LD A,L          ; Copy it into #REGa.
 $C065 ADD A,$04       ; Add #N$04 to it.
 $C067 LD (IX+$06),A   ; Set the new height.
 $C06A PUSH HL         ; Stash the old height.
 $C06B LD IY,$5C48     ; Point #REGiy at #R$5C48.
@label=HandlePickupAndDrop_LookForObject
*$C06F CALL $C172      ; Test whether the object can be picked up.
 $C072 JP C,$C141      ; Pick it up if it can.
 $C075 LD DE,$0020     ; Set #REGde to the size of an object.
 $C078 ADD IY,DE       ; Point #REGiy at the next special object.
 $C07A DJNZ $C06F      ; Jump back to #R$C06F until both have been tried.
; There is nothing to pick up. Look for a free place to drop an object.
 $C07C CALL $BFFB      ; Test whether the control is still pressed.
 $C07F JR Z,$C09D      ; Finish if it is not.
 $C081 LD B,$02        ; Set the number of special objects to look at to #N$02.
 $C083 LD A,(IX+$08)   ; Fetch the room that the player is in.
 $C086 CP $88          ; {Jump to #R$C08C if it is another room.
 $C088 JR NZ,$C08C     ; }
 $C08A LD B,$01        ; Set the number of special objects to look at to #N$01.
@label=HandlePickupAndDrop_LookForSpace
*$C08C LD IY,$5C48     ; Point #REGiy at the first special object of the room.
 $C090 LD DE,$0020     ; Set #REGde to the size of an object.
@label=HandlePickupAndDrop_TestSlot
*$C093 LD A,(IY+$00)   ; Fetch the graphic number of the special object.
 $C096 AND A           ; Test whether it is zero.
 $C097 JR Z,$C0B2      ; Jump to #R$C0B2 if the place is free.
 $C099 ADD IY,DE       ; Point #REGiy at the next special object.
 $C09B DJNZ $C093      ; Jump back to #R$C093 until all of them have been
                       ; tried.
; Put the size of the player back.
@label=HandlePickupAndDrop_Done
*$C09D POP HL          ; Restore the old height.
 $C09E LD (IX+$06),L   ; Set the height of the player.
 $C0A1 POP HL          ; Restore the old width and depth.
 $C0A2 LD (IX+$04),L   ; Set the width of the player.
 $C0A5 LD (IX+$05),H   ; Set the depth of the player.
 $C0A8 RET             ; Return.
; The control was pressed on a frame before: wait until it is let go.
@label=HandlePickupAndDrop_WaitForRelease
*$C0A9 CALL $BFFB      ; Test whether the control is still pressed.
 $C0AC RET NZ          ; Return if it is.
 $C0AD XOR A           ; Clear #REGa.
 $C0AE LD ($5BB3),A    ; Flag that the control is not pressed.
 $C0B1 RET             ; Return.
; Drop the object that has been carried longest in the free place.
@label=HandlePickupAndDrop_Drop
*$C0B2 LD HL,$5BE4     ; Point #REGhl at the object that has been carried
                       ; longest.
 $C0B5 LD A,(HL)       ; Fetch its graphic number.
 $C0B6 INC HL          ; Move on to the flags.
 $C0B7 AND A           ; Test whether there is an object.
 $C0B8 JR Z,$C12B      ; Jump to #R$C12B if there is not.
 $C0BA LD A,($5BD3)    ; Fetch the flag that says no object can be dropped.
 $C0BD AND A           ; Test it.
 $C0BE JR NZ,$C09D     ; Finish if there is no room.
 $C0C0 DEC HL          ; Point #REGhl at the graphic number.
 $C0C1 LD A,(HL)       ; Fetch it.
 $C0C2 INC HL          ; Move on to the flags.
 $C0C3 LD (IY+$00),A   ; Set it as the graphic number of the special object.
 $C0C6 LD A,(IX+$08)   ; Fetch the room that the player is in.
 $C0C9 CP $88          ; {Jump to #R$C0DD if it is another room.
 $C0CB JR NZ,$C0DD     ; }
 $C0CD LD A,(IX+$03)   ; Fetch the Z coordinate of the player.
 $C0D0 CP $98          ; {Jump to #R$C0DD if the player is below that.
 $C0D2 JR C,$C0DD      ; }
 $C0D4 SET 3,(IY+$00)  ; Make the object drop into the cauldron.
 $C0D8 LD A,$01        ; Get the value that sets a flag.
 $C0DA LD ($5BC4),A    ; Flag that an object is being put into the cauldron.
; Put the object where the player is, and lift the player on top of it.
@label=HandlePickupAndDrop_Place
*$C0DD PUSH HL         ; Stash the address of the flags of the object carried.
 $C0DE LD BC,$0003     ; Set the number of bytes to copy to #N$03.
 $C0E1 PUSH IX         ; {Copy #REGix to #REGhl (using the stack).
 $C0E3 POP HL          ; }
 $C0E4 PUSH IY         ; {Copy #REGiy to #REGde (using the stack).
 $C0E6 POP DE          ; }
 $C0E7 INC DE          ; Point #REGde at the X coordinate of the object.
 $C0E8 INC HL          ; Point #REGhl at the X coordinate of the player.
 $C0E9 LDIR            ; Copy the coordinates of the player to the object.
 $C0EB LD A,(IX+$03)   ; Fetch the Z coordinate of the player.
 $C0EE ADD A,$0C       ; Add #N$0C to it.
 $C0F0 LD (IX+$03),A   ; Set the new Z coordinate of the player.
 $C0F3 LD A,(IX+$23)   ; Fetch the Z coordinate of the top half of the player.
 $C0F6 ADD A,$0C       ; Add #N$0C to it.
 $C0F8 LD (IX+$23),A   ; Set the new Z coordinate of the top half of the
                       ; player.
 $C0FB PUSH IX         ; Stash #REGix.
 $C0FD PUSH IY         ; {Copy #REGiy to #REGix (using the stack), to point at
 $C0FF POP IX          ; the object.}
 $C101 CALL $D6C9      ; Work out the pixel coordinates of the object.
 $C104 POP IX          ; Restore #REGix.
; Set up the rest of the object.
@label=HandlePickupAndDrop_SetObject
*$C106 LD (IY+$04),$05 ; Set the width of the object to #N$05.
 $C10A LD (IY+$05),$05 ; Set the depth of the object to #N$05.
 $C10E LD (IY+$06),$0C ; Set the height of the object to #N$0C.
 $C112 POP HL          ; Restore the address of the flags of the object
                       ; carried.
 $C113 LD A,(HL)       ; Fetch the flags.
 $C114 INC HL          ; Move on to the address of the table entry.
 $C115 LD (IY+$07),A   ; Set the flags of the object.
 $C118 LD A,(IX+$08)   ; Fetch the room that the player is in.
 $C11B LD (IY+$08),A   ; Set the room of the object.
 $C11E LD A,(HL)       ; Fetch the low byte of the address of the table entry.
 $C11F INC HL          ; Move on to the high byte.
 $C120 LD (IY+$10),A   ; Set the low byte of the address of the table entry of
                       ; the object.
 $C123 LD A,(HL)       ; Fetch the high byte of the address of the table entry.
 $C124 LD (IY+$11),A   ; Set the high byte of the address of the table entry of
                       ; the object.
 $C127 SET 0,(IY+$0D)  ; Flag that the object has just been dropped.
; Remove the object that was carried longest from the list, by moving the
; others along.
@label=HandlePickupAndDrop_Shift
*$C12B LD HL,$5BE3     ; Point #REGhl at the last byte of the next to last
                       ; object carried.
 $C12E LD DE,$5BE7     ; Point #REGde at the last byte of the last object
                       ; carried.
 $C131 LD BC,$000C     ; Set the number of bytes to move to #N$0C.
 $C134 LDDR            ; Move the objects.
 $C136 LD DE,$5BD8     ; Point #REGde at #R$5BD8.
 $C139 LD B,$04        ; Set the number of bytes to clear to #N$04.
 $C13B CALL $D508      ; Clear them.
 $C13E JP $C09D        ; Jump to #R$C09D to finish.
; Pick up the object that #REGiy points at.
@label=HandlePickupAndDrop_PickUp
*$C141 LD HL,$5BD8     ; Point #REGhl at the space for a new object carried.
 $C144 XOR A           ; Clear #REGa.
 $C145 LD ($5BC0),A    ; Allow the spiked balls to drop again.
 $C148 LD A,(IY+$00)   ; Fetch the graphic number of the object.
 $C14B LD (HL),A       ; Store it.
 $C14C INC HL          ; Move on to the flags.
 $C14D LD A,(IY+$07)   ; Fetch the flags of the object.
 $C150 LD (HL),A       ; Store them.
 $C151 INC HL          ; Move on to the address of the table entry.
 $C152 LD E,(IY+$10)   ; Fetch the low byte of the address of the table entry
                       ; of the object.
 $C155 LD D,(IY+$11)   ; Fetch the high byte.
 $C158 XOR A           ; Clear #REGa.
 $C159 LD (DE),A       ; Clear the graphic number of the table entry, so that the object is
                       ; not built again.
 $C15A LD (HL),E       ; Store the low byte of the address of the table entry.
 $C15B INC HL          ; Move on to the high byte.
 $C15C LD (HL),D       ; Store it.
 $C15D CALL $C69D      ; Flag the object to be wiped and drawn.
 $C160 LD (IY+$00),$01 ; Make the graphic of the object one that is not shown.
 $C164 LD HL,$5BE4     ; Point #REGhl at #R$5BE4.
 $C167 LD A,(HL)       ; Fetch its graphic number.
 $C168 INC HL          ; Move on to the flags.
 $C169 AND A           ; Test whether there is an object.
 $C16A JR Z,$C12B      ; Jump to #R$C12B if there is not.
 $C16C LD (IY+$00),A   ; Make it the graphic of the object that was picked up.
 $C16F PUSH HL         ; Stash the address of the flags.
 $C170 JR $C106        ; Jump to #R$C106 to drop it where the other object was.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$BD6B }
; { #PENTAGRAM$BF79 }
; LIST#

; Test Object Can Be Picked Up
;
; Used by the routine at #R$C00E.
; .
; Tests whether an object is a special object that the player is on or
; close to. The routine continues at #R$C17A.
;
;   IX Address of the player
;   IY Address of the object
; O:F Carry flag set if the object can be picked up
@label=TestObjectCanBePickedUp
c$C172 LD A,(IY+$00) ; Fetch the graphic number of the object.
 $C175 SUB $60       ; Take off the graphic number of the first special object.
 $C177 CP $07        ; Compare it with the number of special objects.
 $C179 RET NC        ; Return if the object is not a special object.
; This entry point is used by the routine at #R$C1AB.
; .
; Test whether the player is standing on, or next to, the object.
@label=TestNearObject
*$C17A PUSH BC       ; Stash #REGbc.
 $C17B LD BC,$0000   ; Set the offset in X to zero.
 $C17E LD L,C        ; {Set the offsets in Y and Z to zero.
 $C17F LD H,C        ; }
 $C180 CALL $CC9D    ; Test whether the objects overlap in X.
 $C183 JR NC,$C19F   ; Jump to #R$C19F if they do not.
 $C185 CALL $CCB2    ; Test whether the objects overlap in Y.
 $C188 JR NC,$C19F   ; Jump to #R$C19F if they do not.
 $C18A LD A,(IX+$03) ; Fetch the Z coordinate of the player.
 $C18D SUB $04       ; Take off #N$04.
 $C18F LD (IX+$03),A ; Set the new Z coordinate.
 $C192 CALL $CCC7    ; Test whether the objects overlap in Z.
 $C195 PUSH AF       ; Stash the result.
 $C196 LD A,(IX+$03) ; Fetch the Z coordinate of the player.
 $C199 ADD A,$04     ; Add #N$04 to it.
 $C19B LD (IX+$03),A ; Set the old Z coordinate.
 $C19E POP AF        ; Restore the result.
@label=TestNearObject_Done
*$C19F POP BC        ; Restore #REGbc.
 $C1A0 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$BEA7 }
; { #PENTAGRAM$C0D4 }
; LIST#

; Test Object Moving
;
; Used by the routines at #R$C28B, #R$C4B6 and #R$C4C3.
; .
; Tests whether an object is moving, which is when its speed in any of the
; three axes is not zero.
;
;   IX Address of the object
; O:F Zero flag set if the object is not moving
@label=TestObjectMoving
c$C1A1 LD A,(IX+$09) ; Fetch the speed in X.
 $C1A4 OR (IX+$0A)   ; Combine it with the speed in Y.
 $C1A7 OR (IX+$0B)   ; Combine it with the speed in Z.
 $C1AA RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$BED6 }
; LIST#

; Handle Extra Life
;
; Handles an extra life, which is an object that the player gets by
; touching it. When it is touched the object turns into the graphic that removes
; it, the table entry that it came from is cleared so that the object does not
; come back, and the player gets an extra life.
;
; IX Address of the extra life object
@label=HandleExtraLife
c$C1AB CALL $C4D3     ; Set the pixel adjustments of an extra life.
 $C1AE PUSH IX        ; {Copy #REGix to #REGiy (using the stack).
 $C1B0 POP IY         ; }
 $C1B2 LD IX,$5C08    ; Point #REGix at #R$5C08.
 $C1B6 INC (IX+$04)   ; Make the player wider by one.
 $C1B9 INC (IX+$05)   ; Make the player deeper by one.
 $C1BC CALL $C17A     ; Test whether the player is on or next to the extra
                      ; life.
 $C1BF DEC (IX+$04)   ; Put the width of the player right.
 $C1C2 DEC (IX+$05)   ; Put the depth of the player right.
 $C1C5 PUSH IY        ; {Copy #REGiy to #REGix (using the stack).
 $C1C7 POP IX         ; }
 $C1C9 JR NC,$C1EE    ; Jump to #R$C1EE if the player is not touching the extra
                      ; life.
 $C1CB SET 3,(IX+$00) ; Change the graphic of the object to the one that
                      ; removes it.
 $C1CF CALL $C4D8     ; Set the pixel adjustments of a sparkle.
 $C1D2 LD L,(IX+$10)  ; Fetch the low byte of the address of the table entry that the object
                      ; comes from.
 $C1D5 LD H,(IX+$11)  ; Fetch the high byte.
 $C1D8 LD (HL),$00    ; Clear the graphic number of the table entry.
 $C1DA LD HL,$5BBA    ; Point #REGhl at #R$5BBA.
 $C1DD INC (HL)       ; Give the player an extra life.
 $C1DE XOR A          ; Clear #REGa.
 $C1DF LD ($5BC0),A   ; Allow the spiked balls to drop again.
 $C1E2 CALL $B4A3     ; Play a beep.
 $C1E5 CALL $BCA3     ; Print the number of lives.
 $C1E8 LD BC,$2020    ; Set the position of the number of lives on the panel.
 $C1EB CALL $C432     ; Copy the number of lives from the screen buffer to the
                      ; display.
@label=HandleExtraLife_Update
*$C1EE JP $C4C6       ; Update the object, making it move if it has to.

; Handle Object Dropped In Cauldron
;
; Handles the graphic numbers #N$68 to #N$6E, which are the special
; objects once the player has dropped them above the cauldron. The object moves
; towards the centre of the room in X and Y at a speed of one. While it does so
; it is kept at a height of about #N$98: it is lifted if it is below that, and
; it hangs there if it is not. Once it is at the centre of the room, it falls
; into the cauldron.
;
; IX Address of the object
@label=HandleObjectDroppedInCauldron
c$C1F1 CALL $C4D8    ; Set the pixel adjustments of a sparkle.
 $C1F4 LD A,(IX+$01) ; Fetch the X coordinate of the object.
 $C1F7 SUB $80       ; Subtract the X coordinate of the centre of the room.
 $C1F9 JR Z,$C202    ; Jump to #R$C202 if the object is at the centre of the
                     ; room.
 $C1FB LD A,$01      ; Set the speed to #N$01.
 $C1FD JP M,$C202    ; Jump to #R$C202 if the object is on the west side of the
                     ; centre.
 $C200 NEG           ; Make the speed negative.
@label=HandleObjectDroppedInCauldron_SetX
*$C202 LD (IX+$09),A ; Set the speed in X, towards the centre of the room.
 $C205 LD A,(IX+$02) ; Fetch the Y coordinate of the object.
 $C208 SUB $80       ; Subtract the Y coordinate of the centre of the room.
 $C20A JR Z,$C213    ; Jump to #R$C213 if the object is at the centre of the
                     ; room.
 $C20C LD A,$01      ; Set the speed to #N$01.
 $C20E JP M,$C213    ; Jump to #R$C213 if the object is on the south side of
                     ; the centre.
 $C211 NEG           ; Make the speed negative.
@label=HandleObjectDroppedInCauldron_SetY
*$C213 LD (IX+$0A),A ; Set the speed in Y, towards the centre of the room.
 $C216 LD A,(IX+$01) ; Fetch the X coordinate of the object.
 $C219 CP $80        ; {Jump to #R$C222 if the object is not at the centre of
 $C21B JR NZ,$C222   ; the room in X.}
 $C21D XOR (IX+$02)  ; Combine the X coordinate of the object with the Y
                     ; coordinate.
 $C220 JR Z,$C238    ; Jump to #R$C238 if the object is at the centre of the
                     ; room in Y too.
@label=HandleObjectDroppedInCauldron_Lift
*$C222 LD A,(IX+$03) ; Fetch the Z coordinate of the object.
 $C225 CP $98        ; Compare it with #N$98.
 $C227 LD A,$01      ; Set the speed in Z to #N$01.
 $C229 JR NC,$C22C   ; Jump to #R$C22C if the object is as high as that.
 $C22B INC A         ; Set the speed in Z to #N$02.
@label=HandleObjectDroppedInCauldron_SetZ
*$C22C LD (IX+$0B),A ; Set the speed in Z.
; This entry point is used by the routine at #R$C238.
@label=HandleObjectDroppedInCauldron_Move
*$C22F CALL $C700    ; Apply gravity to the object and move it.

; Draw Moving Object
;
; Used by the routines at #R$B92C, #R$C28B, #R$C4B6 and #R$C4C3.
; .
; Plays the sound of an object that is moving, and flags it to be wiped
; and drawn again.
;
; IX Address of the object
@label=DrawMovingObject
c$C232 CALL $B467    ; Play the sound of a moving object.
 $C235 JP $C692      ; Flag the object to be drawn again.

; Handle Object At Centre Of Room
;
; Used by the routine at #R$C1F1.
; .
; Handles an object that has been dropped in the cauldron once it is at
; the centre of the room. If it is above the cauldron it is flagged to be
; ignored in the 3D calculations and left to fall. When it has dropped to the
; bottom the object is added to the cauldron.
;
; IX Address of the object
@label=HandleObjectAtCentreOfRoom
c$C238 LD A,$80        ; Set #REGa to the height of the bottom of the cauldron.
 $C23A CP (IX+$03)     ; Compare it with the Z coordinate of the object.
 $C23D JR NC,$C245     ; Jump to #R$C245 if the object is at the bottom of the
                       ; cauldron.
 $C23F SET 1,(IX+$07)  ; Flag the object to be ignored in the 3D calculations.
 $C243 JR $C22F        ; Jump to #R$C22F to let it fall.
; The object is in the cauldron. If it is the one that is needed next,
; count it and show that something happens.
@label=AddObjectToCauldron
*$C245 LD (IX+$03),$80 ; Set the Z coordinate of the object to the height of the bottom of
                       ; the cauldron.
 $C249 CALL $C274      ; Find the number of the object that is needed next.
 $C24C LD A,(IX+$00)   ; Fetch the graphic number of the object.
 $C24F AND %00000111   ; Convert it to the number of the object.
 $C251 CP (HL)         ; Compare it with the number that is needed.
 $C252 JR NZ,$C265     ; Jump to #R$C265 if it is not the one that is needed.
 $C254 LD HL,$5BBB     ; Point #REGhl at #R$5BBB.
 $C257 INC (HL)        ; Count one more.
 $C258 CALL $C2A5      ; Make the colours of the screen cycle.
 $C25B LD A,($5BBB)    ; Fetch the number of charms in the cauldron.
 $C25E CP $0E          ; {Jump to #R$C265 if there are more to come.
 $C260 JR NZ,$C265     ; }
 $C262 CALL $C2CC      ; Start the final animation.
; Remove the object.
@label=AddObjectToCauldron_Remove
*$C265 XOR A           ; Clear #REGa.
 $C266 LD ($5BC4),A    ; Flag that no object is being put into the cauldron.
 $C269 LD L,(IX+$10)   ; Fetch the low byte of the address of the table entry that the object
                       ; comes from.
 $C26C LD H,(IX+$11)   ; Fetch the high byte.
 $C26F LD (HL),$00     ; Clear the graphic number of the table entry.
 $C271 JP $B95E        ; Jump to #R$B95E to remove the object.

; Find Next Object Required
;
; Used by the routines at #R$B8DA and #R$C238.
; .
; Finds the number of the object that the player has to put into the
; cauldron next.
;
; O:HL Address of the number of the object in the list at #R$C27D
@label=FindNextObjectRequired
c$C274 LD A,($5BBB)  ; Fetch the number of charms in the cauldron.
 $C277 LD HL,$C27D   ; Point #REGhl at #R$C27D.
 $C27A JP $D4F2      ; Find the address of the object that is needed.

; Required Objects
;
; The order in which the objects have to be put into the cauldron. Each
; number is that of an object (the graphic number less #N$60). The order is
; changed at the start of each game by #R$B544.
@label=RequiredObjects
b$C27D DEFB $00,$01,$02,$03,$04,$05,$06
 $C284 DEFB $03,$05,$00,$06,$01,$02,$04

; Handle Special Object
;
; Handles the graphic numbers #N$60 to #N$66, which are the special
; objects that the player has to carry to the cauldron. An object that has just
; been dropped, or is moving, has its speed in X and Y cleared so that it falls
; straight down.
;
; IX Address of the object
@label=HandleSpecialObject
c$C28B CALL $C4D8     ; Set the pixel adjustments of a sparkle.
 $C28E CALL $C700     ; Apply gravity to the object and move it.
 $C291 BIT 0,(IX+$0D) ; {Jump to #R$C29B if the object has just been dropped.
 $C295 JR NZ,$C29B    ; }
 $C297 CALL $C1A1     ; Test whether the object is moving.
 $C29A RET Z          ; Return if it is not.
@label=HandleSpecialObject_Fall
*$C29B RES 0,(IX+$0D) ; Clear the flag that says the object has just been
                      ; dropped.
 $C29F CALL $C9F3     ; Clear the speeds in X and Y.
 $C2A2 JP $C232       ; Play the sound of a moving object and flag the object to be drawn
                      ; again.

; Cycle Colours With Sound
;
; Used by the routine at #R$C238.
; .
; Changes the ink colour of every attribute on the screen to the next
; colour, sixteen times, with a sound and a short delay each time.
@label=CycleColoursWithSound
c$C2A5 LD D,$10      ; Set the number of times to cycle to #N$10.
@label=CycleColoursWithSound_Cycle
*$C2A7 LD HL,$5800   ; Point #REGhl at the attribute file.
 $C2AA LD BC,$0300   ; Set the number of attributes to #N$0300.
@label=CycleColoursWithSound_Attribute
*$C2AD LD A,(HL)     ; Fetch the attribute.
 $C2AE AND %11111000 ; Keep the paper, brightness and flash.
 $C2B0 LD E,A        ; Stash them in #REGe.
 $C2B1 LD A,(HL)     ; Fetch the attribute again.
 $C2B2 INC A         ; Add one to the ink colour.
 $C2B3 AND %00000111 ; Keep the ink colour.
 $C2B5 OR E          ; Combine it with the rest of the attribute.
 $C2B6 LD (HL),A     ; Set the attribute.
 $C2B7 INC HL        ; Move on to the next attribute.
 $C2B8 DEC BC        ; Decrease the number of attributes left.
 $C2B9 LD A,B        ; {Check whether any attributes are left to change.
 $C2BA OR C          ; }
 $C2BB JR NZ,$C2AD   ; Jump back to #R$C2AD until all of the attributes have
                     ; been changed.
 $C2BD CALL $B403    ; Play the sound of sparkles.
 $C2C0 LD BC,$2000   ; Set the delay counter to #N$2000.
@label=CycleColoursWithSound_Delay
*$C2C3 DEC BC        ; Decrease the delay counter.
 $C2C4 LD A,B        ; {Check whether the delay counter has reached zero.
 $C2C5 OR C          ; }
 $C2C6 JR NZ,$C2C3   ; Jump back to #R$C2C3 until the delay is over.
 $C2C8 DEC D         ; Decrease the number of times left.
 $C2C9 JR NZ,$C2A7   ; Jump back to #R$C2A7 until all of the cycles are done.
@label=DoNothing
 $C2CB RET           ; Return.

; Prepare Final Animation
;
; Used by the routine at #R$C238.
; .
; Gets the cauldron room ready for the final animation, once the last of
; the charms has been put into the cauldron. The second special object of the
; room, the background objects and the foreground objects (eleven objects in
; all) are removed, and every block that is left in the objects table is changed
; into a sparkle.
@label=PrepareFinalAnimation
c$C2CC LD A,$01        ; Get the value that sets a flag.
 $C2CE LD ($5BC3),A    ; Flag that the final animation has started.
 $C2D1 PUSH IX         ; Stash #REGix.
 $C2D3 LD IX,$5C68     ; Point #REGix at #R$5C68.
 $C2D7 LD DE,$0020     ; Set #REGde to the size of an object.
 $C2DA LD B,$0B        ; Set the number of objects to #N$0B.
@label=PrepareFinalAnimation_Remove
*$C2DC PUSH BC         ; Stash the number of objects left.
 $C2DD PUSH DE         ; Stash the size of an object.
 $C2DE CALL $C692      ; Flag the object to be wiped and drawn.
 $C2E1 POP DE          ; Restore the size of an object.
 $C2E2 POP BC          ; Restore the number of objects left.
 $C2E3 LD (IX+$00),$01 ; Set the graphic number of the object to #N$01, so it
                       ; is not shown.
 $C2E7 ADD IX,DE       ; Move on to the next object.
 $C2E9 DJNZ $C2DC      ; Jump back to #R$C2DC until all of the objects have
                       ; been removed.
 $C2EB LD BC,$6108     ; Point #REGbc at the end of the objects table.
@label=PrepareFinalAnimation_Next
*$C2EE LD A,(IX+$00)   ; Fetch the graphic number of the object.
 $C2F1 CP $07          ; {Jump to #R$C2F9 if it is not a block.
 $C2F3 JR NZ,$C2F9     ; }
 $C2F5 LD (IX+$00),$83 ; Change the graphic of the block to the first of the
                       ; sparkles.
@label=PrepareFinalAnimation_Advance
*$C2F9 ADD IX,DE       ; Move on to the next object.
 $C2FB PUSH IX         ; {Copy #REGix to #REGhl (using the stack).
 $C2FD POP HL          ; }
 $C2FE AND A           ; {Subtract the address of the end of the table.
 $C2FF SBC HL,BC       ; }
 $C301 JR C,$C2EE      ; Jump back to #R$C2EE until every object has been
                       ; looked at.
 $C303 POP IX          ; Restore #REGix.
 $C305 RET             ; Return.

; Start Transformation
;
; Used by the routine at #R$C82B.
; .
; Starts the transformation of the player from human to wulf, or the other
; way round, when it is time to change (at the start of each day and each
; night). Nothing happens unless the change is due, and the player has been in
; the room for a while and is not jumping. Once the change starts the routine
; does not return to its caller, but to the one before, which skips the rest of
; the update of the player. The legs of the player are changed into the sparkles
; of #R$C337 and the top half is hidden.
;
; IX Address of the legs of the player
@label=StartTransformation
c$C306 LD A,($5BB1)    ; Fetch the flag that says the player has to transform.
 $C309 AND A           ; Test it.
 $C30A RET Z           ; Return if the player does not have to transform.
 $C30B LD A,(IX+$0C)   ; Fetch the counter and flags of the player.
 $C30E AND %11110000   ; Keep the counter that runs when the player enters the
                       ; room.
 $C310 RET NZ          ; Return if the player has only just entered the room.
 $C311 BIT 3,(IX+$0C)  ; Test whether the player is jumping.
 $C315 RET NZ          ; Return if so.
 $C316 INC SP          ; {Drop the return address from the stack.
 $C317 INC SP          ; }
 $C318 LD A,(IX+$00)   ; Fetch the graphic number of the player.
 $C31B LD ($5BB1),A    ; Keep it, as the flag that the player is transforming.
 $C31E LD (IX+$10),$08 ; Set the number of steps of the transformation to
                       ; #N$08.
 $C322 PUSH IX         ; Stash #REGix.
 $C324 LD DE,$0020     ; Set #REGde to the size of an object.
 $C327 ADD IX,DE       ; Point #REGix at the top half of the player.
 $C329 LD (IX+$00),$01 ; Change the graphic of the top half to one that is not
                       ; shown.
 $C32D CALL $C692      ; Flag the top half to be wiped and drawn.
 $C330 POP IX          ; Restore #REGix.
 $C332 CALL $C4ED      ; Set the pixel adjustments of a transforming player.
 $C335 JR $C357        ; Jump to #R$C357.

; Handle Transformation
;
; Handles the graphic numbers #N$5C to #N$5F, which are the legs of the
; player while the player transforms. Every fourth frame a different one of
; these graphics is chosen at random, and the sound of a transformation is
; played. When the number of steps has run out the player becomes human or wulf.
; If the player is killed during the transformation, the death sparkles start.
;
; IX Address of the legs of the player
@label=HandleTransformation
c$C337 CALL $C4ED     ; Set the pixel adjustments of a transforming player.
 $C33A BIT 6,(IX+$0D) ; {Jump to #R$C349 if not.
 $C33E JR Z,$C349     ; }
 $C340 LD A,($5BC3)   ; Fetch the flag that says the game has been completed.
 $C343 AND A          ; Test it.
 $C344 JR NZ,$C349    ; Jump to #R$C349 if it has been.
 $C346 JP $BF21       ; Start the death sparkles.
@label=HandleTransformation_Step
*$C349 LD A,($5BA2)   ; Fetch the frame counter.
 $C34C AND %00000011  ; Keep the lowest two bits.
 $C34E RET NZ         ; Return unless it is one frame in four.
 $C34F CALL $B472     ; Play the sound of a transformation.
 $C352 DEC (IX+$10)   ; Decrease the number of steps left.
 $C355 JR Z,$C377     ; Jump to #R$C377 when the transformation is done.
; This entry point is used by the routine at #R$C306.
; .
; Choose a graphic for the legs at random, and turn it round.
@label=HandleTransformation_Flicker
*$C357 LD A,R         ; Fetch a random number from the refresh register.
 $C359 LD C,A         ; Stash it in #REGc.
 $C35A LD A,($5BA5)   ; Fetch the second random seed.
 $C35D ADD A,C        ; Add the random number.
 $C35E AND %00000011  ; Keep the lowest two bits.
 $C360 OR %01011100   ; Make it one of the graphic numbers #N$5C to #N$5F.
 $C362 CP (IX+$00)    ; Compare it with the graphic of the legs.
 $C365 JR NZ,$C369    ; Jump to #R$C369 if it is different.
 $C367 XOR %00000001  ; Change to the other graphic of the pair.
@label=HandleTransformation_SetGraphic
*$C369 LD (IX+$00),A  ; Set the graphic number of the legs.
 $C36C LD A,(IX+$07)  ; Fetch the flags of the legs.
 $C36F XOR %01000000  ; Flip the sprite horizontally.
 $C371 LD (IX+$07),A  ; Store the flags.
 $C374 JP $C692       ; Flag the object to be wiped and drawn.
; The transformation is over. Change the player from human to wulf, or
; from wulf to human.
@label=HandleTransformation_Finish
*$C377 LD A,($5BB1)   ; Fetch the graphic number that the legs had before the
                      ; transformation.
 $C37A XOR %00100000  ; Change it from human to wulf, or back.
 $C37C LD (IX+$00),A  ; Set the graphic number of the legs.
 $C37F ADD A,$10      ; Work out the graphic number of the top half.
 $C381 LD (IX+$20),A  ; Set the graphic number of the top half.
 $C384 XOR A          ; Clear #REGa.
 $C385 LD ($5BB1),A   ; Flag that the player is not transforming.
 $C388 CALL $C4DD     ; Set the pixel adjustments of the legs.
 $C38B BIT 5,(IX+$00) ; {Jump to #R$C394 if not.
 $C38F JR Z,$C394     ; }
 $C391 DEC (IX+$13)   ; Lower the pixel adjustment in Y by one.
@label=HandleTransformation_Draw
*$C394 JP $C692       ; Flag the object to be wiped and drawn.

; Move Sun Moon
;
; Used by the routine at #R$D59F.
; .
; Moves the sun or moon along the arc in the window of the panel by one
; pixel, on one frame in eight, and shows it.
@label=MoveSunMoon
c$C397 LD A,($5BA2)  ; Fetch the frame counter.
 $C39A AND %00000111 ; Keep the lowest three bits.
 $C39C RET NZ        ; Return unless it is one frame in eight.
 $C39D LD IX,$C44D   ; Point #REGix at #R$C44D.
 $C3A1 INC (IX+$1A)  ; Move the sun/moon one pixel to the right.

; Display Sun Moon Frame
;
; Used by the routine at #R$AFBA.
; .
; Shows the window of the panel that holds the sun or the moon, and the
; sun or moon in it. The sun and the moon go along an arc from pixel X
; coordinate #N$B0 to #N$E0, which is the height from the table at #R$C440. When
; one of them gets to the end the other takes over, the player transforms, and
; each time the sun comes back a day is added and the day is shown on the panel.
; When #N$40 days have passed the game is over. Nothing is done when the final
; animation is under way.
;
; IX Address of the sun/moon object
@label=DisplaySunMoonFrame
c$C3A4 LD A,($5BC3)    ; Fetch the flag that says the final animation has
                       ; started.
 $C3A7 AND A           ; Test it.
 $C3A8 RET NZ          ; Return if the final animation has started.
 $C3A9 LD A,(IX+$1A)   ; Fetch the pixel X coordinate of the sun/moon.
 $C3AC CP $E1          ; {Jump to #R$C3FF if the sun/moon has got there.
 $C3AE JR Z,$C3FF      ; }
 $C3B0 LD A,(IX+$1A)   ; Fetch the pixel X coordinate.
 $C3B3 ADD A,$10       ; Add #N$10 to it.
 $C3B5 LD HL,$C440     ; Point #REGhl at #R$C440.
 $C3B8 RRCA            ; {Divide the number by four.
 $C3B9 RRCA            ; }
 $C3BA AND %00001111   ; Keep the lowest four bits.
 $C3BC CALL $D4F2      ; Find the address of the height.
 $C3BF LD A,(HL)       ; Fetch the height.
 $C3C0 LD (IX+$1B),A   ; Set the pixel Y coordinate of the sun/moon.
; Draw the window in the screen buffer, wiping what was there first.
@label=DisplaySunMoonFrame_Draw
*$C3C3 LD BC,$1F06     ; Set the number of lines to #N$1F and the number of
                       ; bytes to #N$06.
 $C3C6 LD HL,$D90A     ; Point #REGhl at #R$D90A.
 $C3C9 PUSH BC         ; Stash the size of the window.
 $C3CA PUSH HL         ; Stash the position of the window.
 $C3CB LD A,C          ; {Swap #REGb and #REGc, so that #REGb is the width and #REGc is the
 $C3CC LD C,B          ; height.
 $C3CD LD B,A          ; }
 $C3CE XOR A           ; Clear #REGa.
 $C3CF CALL $C515      ; Clear the window.
 $C3D2 CALL $D718      ; Draw the sun/moon.
 $C3D5 LD IX,$BFDB     ; Point #REGix at #R$BFDB.
 $C3D9 LD (IX+$07),$00 ; Clear the flags.
 $C3DD LD (IX+$00),$5A ; Set the graphic number to the left of the frame.
 $C3E1 LD (IX+$1A),$B8 ; Set the pixel X coordinate to #N$B8.
 $C3E5 LD (IX+$1B),$00 ; Set the pixel Y coordinate to #N$00.
 $C3E9 CALL $D718      ; Draw the left of the frame.
 $C3EC LD (IX+$1A),$D0 ; Set the pixel X coordinate to #N$D0.
 $C3F0 LD (IX+$00),$BA ; Set the graphic number to the right of the frame.
 $C3F4 CALL $D718      ; Draw the right of the frame.
 $C3F7 POP HL          ; Restore the position of the window.
 $C3F8 POP BC          ; Restore the size of the window.
 $C3F9 LD DE,$57F7     ; Point #REGde at the position of the window on the
                       ; display.
 $C3FC JP $D67C        ; Copy the window from the screen buffer to the display.
; The sun or the moon has gone round: change to the other one, which makes
; the player transform. Add a day when it is the sun that is coming back.
@label=DisplaySunMoonFrame_Toggle
*$C3FF LD A,(IX+$00)   ; Fetch the graphic number of the sun/moon.
 $C402 XOR %00000001   ; Change the sun to the moon, or the moon to the sun.
 $C404 LD (IX+$00),A   ; Set the graphic number of the sun/moon.
 $C407 CALL $D30D      ; Colour the sun/moon.
 $C40A LD (IX+$1A),$B0 ; Set the pixel X coordinate of the sun/moon back to the
                       ; start.
 $C40E LD A,$01        ; Get the value that sets a flag.
 $C410 LD ($5BB1),A    ; Flag that the player has to transform.
 $C413 LD A,($C44D)    ; Fetch the graphic number of the sun/moon.
 $C416 AND %00000001   ; Keep the lowest bit.
 $C418 RET NZ          ; Return if it is the moon.
@label=DisplaySunMoonFrame_AddDay
 $C419 LD HL,$5BB9     ; Point #REGhl at #R$5BB9.
 $C41C LD A,(HL)       ; Fetch it.
 $C41D ADD A,$01       ; Add one.
 $C41F DAA             ; Keep it as a BCD number.
 $C420 LD (HL),A       ; Store it.
 $C421 CP $40          ; {Jump to #R$BA22 if they have all gone.
 $C423 JP Z,$BA22      ; }
 $C426 CALL $BC66      ; Print the number of days.
 $C429 LD BC,$0078     ; Set the position of the days on the panel.
 $C42C CALL $C432      ; Copy the number of days from the screen buffer to the
                       ; display.
 $C42F JP $C3C3        ; Jump to #R$C3C3.

; Copy Area To Screen
;
; Used by the routines at #R$C1AB and #R$C3A4.
; .
; Copies a block of the screen buffer, which is two bytes wide and eight
; lines high, to the display.
;
; B Pixel Y coordinate
; C Pixel X coordinate
@label=CopyAreaToScreen
c$C432 CALL $D826    ; Find the address in the display.
 $C435 CALL $D811    ; Find the address in the screen buffer.
 $C438 LD L,C        ; {Copy it to #REGhl.
 $C439 LD H,B        ; }
 $C43A LD BC,$0802   ; Set the number of lines to #N$08 and the number of bytes
                     ; to #N$02.
 $C43D JP $D67C      ; Copy the block to the display.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$BF2F }
; LIST#

; Sun Moon Heights
;
; The pixel Y coordinates of the sun and moon as they move along the arc
; of the window, one for every four pixels.
@label=SunMoonHeights
b$C440 DEFB $05,$06,$07,$08,$09,$0A,$0A,$09,$08,$07,$06,$05,$05

; Sun Moon Object
;
; The object that is used to draw the sun and the moon.
@label=SunMoonObject
g$C44D DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $C455 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $C45D DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $C465 DEFB $00,$00,$00,$00,$00,$00,$00,$00

; Initialise Sun
;
; Used by the routine at #R$AF88.
; .
; Sets the sun/moon object to the sun at the start of the arc.
@label=InitialiseSun
c$C46D LD IX,$C44D     ; Point #REGix at the sun/moon object.
 $C471 LD (IX+$00),$58 ; Set the graphic number to #N$58, which is the sun.
 $C475 LD (IX+$1A),$B0 ; Set the pixel X coordinate to #N$B0.
 $C479 LD (IX+$1B),$09 ; Set the pixel Y coordinate to #N$09.
 $C47D RET             ; Return.

; Initialise Special Objects
;
; Used by the routine at #R$AF88.
; .
; Chooses which objects are placed where, at the start of each game. Every
; entry in the table of special objects gets a graphic number from #N$60 to
; #N$67, one after another from a number that comes from the first random seed
; and the refresh register, and the place that the object starts in is copied to
; the place that it is in now.
@label=InitialiseSpecialObjects
c$C47E LD HL,$6FF2   ; Point #REGhl at the first special object.
 $C481 LD A,($5BA0)  ; Fetch the first random seed.
 $C484 LD E,A        ; Stash it in #REGe.
 $C485 LD A,R        ; Fetch a random number from the refresh register.
 $C487 ADD A,E       ; Add the seed.
 $C488 LD E,A        ; Stash the result in #REGe.
@label=InitialiseSpecialObjects_Next
*$C489 LD A,E        ; Copy the number into #REGa.
 $C48A AND %00000111 ; Keep the lowest three bits.
 $C48C OR %01100000  ; Make it a graphic number from #N$60 to #N$67.
 $C48E LD (HL),A     ; Set the graphic number of the object.
 $C48F INC HL        ; Move on to the starting position.
 $C490 INC E         ; Change the number, for the next object.
 $C491 PUSH DE       ; Stash it.
 $C492 EX DE,HL      ; Point #REGde at the starting position.
 $C493 LD HL,$0004   ; Set #REGhl to the offset of the current position.
 $C496 ADD HL,DE     ; Point #REGhl at the current position.
 $C497 EX DE,HL      ; Point #REGde at the current position.
 $C498 LD BC,$0004   ; Set the number of bytes to copy to #N$04.
 $C49B LDIR          ; Copy the starting position to the current position.
 $C49D EX DE,HL      ; Point #REGhl at the next object.
 $C49E PUSH HL       ; Stash it.
 $C49F LD BC,$7112   ; Point #REGbc at the end of the table.
 $C4A2 AND A         ; {Subtract the address of the end of the table.
 $C4A3 SBC HL,BC     ; }
 $C4A5 POP HL        ; Restore the address of the next object.
 $C4A6 POP DE        ; Restore the number.
 $C4A7 JR C,$C489    ; Jump back to #R$C489 until every object has been done.
 $C4A9 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$AF3F }
; LIST#

; Handle Block
;
; Handles the graphic number #N$3E, which is a block that can fall. Its
; speeds in X and Y are cleared, so that it only falls, and the sound of a block
; is played.
;
; IX Address of the block object
@label=HandleBlock
c$C4AA CALL $C4E3    ; Set the pixel adjustments of a block.
 $C4AD CALL $C9F3    ; Clear the speeds in X and Y.
 $C4B0 CALL $B3E9    ; Play the sound of a block.
 $C4B3 JP $B5AF      ; Move the block and flag it to be drawn again.

; Handle Chest
;
; Handles a chest, which falls when there is nothing below it. It plays
; the sound of a moving object, and is drawn again, only when it is moving.
;
; IX Address of the chest object
@label=HandleChest
c$C4B6 CALL $C4E3    ; Set the pixel adjustments of a block.
 $C4B9 CALL $C700    ; Apply gravity to the chest and move it.
 $C4BC CALL $C1A1    ; Test whether the chest is moving.
 $C4BF RET Z         ; Return if it is not.
 $C4C0 JP $C232      ; Play the sound of a moving object and flag the chest to be drawn
                     ; again.

; Handle Table
;
; Handles a table, which falls when there is nothing below it. It plays
; the sound of a moving object, and is drawn again, only when it is moving, with
; its speeds in X and Y cleared.
;
; IX Address of the table object
@label=HandleTable
c$C4C3 CALL $C4E3    ; Set the pixel adjustments of a block.
; This entry point is used by the routine at #R$C1AB.
@label=HandleTable_Fall
*$C4C6 CALL $C700    ; Apply gravity to the object and move it.
 $C4C9 CALL $C1A1    ; Test whether the object is moving.
 $C4CC RET Z         ; Return if it is not.
 $C4CD CALL $C9F3    ; Clear the speeds in X and Y.
 $C4D0 JP $C232      ; Play the sound of a moving object and flag the object to be drawn
                     ; again.

; Set Pixel Adjustments
;
; Used by the routine at #R$C1AB.
; .
; Sets the number of pixels that the sprite of an object is moved by, in X
; and Y, from its position. There is an entry point for each of the sets of
; adjustments that are used, and the one that is used for an object depends on
; its sprite. The adjustment in X goes in #REGl and the adjustment in Y goes in
; #REGh.
;
; IX Address of the object
@label=SetPixelAdjustments
c$C4D3 LD HL,$FEF8   ; Set the adjustments of a tree wall, which are #N$F8 in X and #N$FE
                     ; in Y.
 $C4D6 JR $C4E0      ; Jump to #R$C4E0.
; This entry point is used by the routines at #R$B566, #R$B8A9, #R$B8DA,
; #R$B923, #R$B92C, #R$BEFE, #R$BF11, #R$BF2B, #R$BF37, #R$C1AB, #R$C1F1 and
; #R$C28B.
; .
; The adjustments of sparkles and special objects: #N$F4 in X and #N$FC in
; Y.
@label=SetPixelAdjustments_Sparkle
*$C4D8 LD HL,$FCF4   ; Set the adjustments.
 $C4DB JR $C4E0      ; Jump to #R$C4E0.
; This entry point is used by the routines at #R$B6F9, #R$C337, #R$C5C8,
; #R$C65E, #R$C6BD and #R$C823.
; .
; The adjustments of the bottom half of a guard or of a human: #N$F4 in X
; and #N$FA in Y.
@label=SetPixelAdjustments_Legs
*$C4DD LD HL,$FAF4   ; Set the adjustments.
@label=SetPixelAdjustments_Set
*$C4E0 JP $C72B      ; Set the adjustments of the object.
; This entry point is used by the routines at #R$B683, #R$B6A2, #R$B6B9,
; #R$B7A9, #R$B7E7, #R$C4AA, #R$C4B6 and #R$C4C3.
; .
; The adjustments of rocks and blocks: #N$F0 in X and #N$F8 in Y.
@label=SetPixelAdjustments_Block
*$C4E3 LD HL,$F8F0   ; Set the adjustments.
 $C4E6 JR $C4E0      ; Jump to #R$C4E0.
; The adjustments of the bricks of graphic number #N$0A: #N$EC in X and
; #N$FF in Y.
@label=SetPixelAdjustments_Bricks10
 $C4E8 LD HL,$FFEC   ; Set the adjustments.
 $C4EB JR $C4E0      ; Jump to #R$C4E0.
; This entry point is used by the routines at #R$C306 and #R$C337.
; .
; The adjustments of the bricks of graphic number #N$0B and of a
; transforming player: #N$F4 in X and #N$FE in Y.
@label=SetPixelAdjustments_Bricks11
*$C4ED LD HL,$FEF4   ; Set the adjustments.
 $C4F0 JR $C4E0      ; Jump to #R$C4E0.
; This entry point is used by the routines at #R$B5FF, #R$B7ED, #R$B80F,
; #R$B83F and #R$B865.
; .
; The adjustments of bricks of graphic numbers #N$0C to #N$0F, balls and
; fire: #N$F8 in X and #N$FC in Y.
@label=SetPixelAdjustments_Ball
*$C4F2 LD HL,$FCF8   ; Set the adjustments.
 $C4F5 JR $C4E0      ; Jump to #R$C4E0.
; This entry point is used by the routine at #R$CDDA.
; .
; The adjustments of #N$F4 in X and #N$F8 in Y.
@label=SetPixelAdjustments_Wide
*$C4F7 LD HL,$F8F4   ; Set the adjustments.
 $C4FA JR $C4E0      ; Jump to #R$C4E0.
; This entry point is used by the routines at #R$B7A3 and #R$C828.
; .
; The adjustments of the legs of the wulf and of a gargoyle: #N$F4 in X
; and #N$F9 in Y.
@label=SetPixelAdjustments_Wulf
*$C4FC LD HL,$F9F4   ; Set the adjustments.
 $C4FF JR $C4E0      ; Jump to #R$C4E0.
; This entry point is used by the routine at #R$CDDF.
; .
; The adjustments of #N$F4 in X and #N$F4 in Y.
@label=SetPixelAdjustments_Wider
*$C501 LD HL,$F4F4   ; Set the adjustments.
 $C504 JR $C4E0      ; Jump to #R$C4E0.
; This entry point is used by the routine at #R$B99C.
; .
; The adjustments of the bottom half of the cauldron: #N$F0 in X and #N$F4
; in Y.
@label=SetPixelAdjustments_Cauldron
*$C506 LD HL,$F4F0   ; Set the adjustments.
 $C509 JR $C4E0      ; Jump to #R$C4E0.
; This entry point is used by the routine at #R$B73C.
; .
; The adjustments of a guard that moves east and west: #N$F4 in X and
; #N$07 in Y.
@label=SetPixelAdjustments_Guard
*$C50B LD HL,$07F4   ; Set the adjustments.
 $C50E JR $C4E0      ; Jump to #R$C4E0.
; This entry point is used by the routine at #R$B9A5.
; .
; The adjustments of the top half of a guard: #N$F4 in X and #N$03 in Y.
@label=SetPixelAdjustments_GuardTop
*$C510 LD HL,$03F4   ; Set the adjustments.
 $C513 JR $C4E0      ; Jump to #R$C4E0.

; Fill Window
;
; Used by the routines at #R$BF45, #R$C3A4, #R$D2EF, #R$D30D and #R$D59F.
; .
; Fills a rectangle of the screen buffer, or of the attribute file, with
; one byte. The rows of the rectangle are #N$20 bytes apart.
;
; A Byte to fill the rectangle with
; B Width of the rectangle in bytes
; C Height of the rectangle in lines
; HL Address of the first byte
@label=FillWindow
c$C515 LD DE,$0020   ; Set #REGde to the length of a line.
@label=FillWindow_Line
*$C518 PUSH BC       ; Stash the width and height.
 $C519 PUSH HL       ; Stash the address of the start of the line.
@label=FillWindow_Byte
*$C51A LD (HL),A     ; Fill a byte.
 $C51B INC HL        ; Move on to the next byte.
 $C51C DJNZ $C51A    ; Jump back to #R$C51A until the line is filled.
 $C51E POP HL        ; Restore the address of the start of the line.
 $C51F ADD HL,DE     ; Move on to the next line.
 $C520 POP BC        ; Restore the width and height.
 $C521 DEC C         ; Decrease the number of lines left.
 $C522 JR NZ,$C518   ; Jump back to #R$C518 until all of the lines have been
                     ; filled.
 $C524 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #PENTAGRAM$B6DD }
; LIST#

; Place Special Objects In Room
;
; Used by the routine at #R$D1E6.
; .
; Makes the list of the special objects that are in the room that the
; player is in, ready to be updated like any other object. Every entry of the
; table of special objects at #R$6FF2 that is in the room is copied to the
; objects table (up to two of them), with the width and depth of #N$05, the
; height of #N$0C and the flags for drawing and for being able to move. The
; address of the entry is kept at #N$10 bytes into the object, so that it can be
; updated by #R$C591. The rest of the objects table for the special objects is
; cleared.
;
; IX Address of the player
@label=PlaceSpecialObjectsInRoom
c$C525 LD DE,$5C48   ; Point #REGde at the first special object of the room.
 $C528 EXX           ; Switch to the alternate registers to keep it there.
 $C529 LD IY,$6FF2   ; Point #REGiy at #R$6FF2.
 $C52D LD B,(IX+$08) ; Fetch the room that the player is in.
@label=PlaceSpecialObjectsInRoom_TestEntry
*$C530 LD A,(IY+$00) ; Fetch the graphic number of the entry.
 $C533 AND A         ; Test whether there is an object.
 $C534 JR Z,$C572    ; Jump to #R$C572 if there is not.
 $C536 LD A,(IY+$08) ; Fetch the room that the object is in.
 $C539 CP B          ; Compare it with the room that the player is in.
 $C53A JR NZ,$C572   ; Jump to #R$C572 if they are different.
 $C53C PUSH IY       ; Stash the address of the entry.
 $C53E EXX           ; Switch back to the registers that hold the address of the special
                     ; object of the room.
 $C53F POP HL        ; Restore the address of the entry.
 $C540 PUSH HL       ; Stash it again.
 $C541 LD A,(HL)     ; Fetch the graphic number.
 $C542 INC HL        ; Move on to the starting position.
 $C543 LD (DE),A     ; Set the graphic number of the special object of the
                     ; room.
 $C544 INC DE        ; Move on to the X coordinate.
 $C545 INC HL        ; {Point #REGhl at the current position of the object.
 $C546 INC HL        ;
 $C547 INC HL        ;
 $C548 INC HL        ; }
 $C549 LD BC,$0003   ; Set the number of bytes to copy to #N$03.
 $C54C LDIR          ; Copy the coordinates.
 $C54E EX DE,HL      ; Point #REGhl at the width of the special object of the
                     ; room.
 $C54F LD (HL),$05   ; Set the width to #N$05.
 $C551 INC HL        ; Move on to the depth.
 $C552 LD (HL),$05   ; Set the depth to #N$05.
 $C554 INC HL        ; Move on to the height.
 $C555 LD (HL),$0C   ; Set the height to #N$0C.
 $C557 INC HL        ; Move on to the flags.
 $C558 LD (HL),$14   ; Set the flags to draw and to be able to move.
 $C55A INC HL        ; Move on to the room.
 $C55B EX DE,HL      ; Point #REGhl at the room of the entry and #REGde at the room of the
                     ; special object of the room.
 $C55C LD A,(HL)     ; Fetch the room.
 $C55D INC HL        ; Move on to the next byte.
 $C55E LD (DE),A     ; Set the room.
 $C55F INC DE        ; Move on to the speeds.
 $C560 LD B,$07      ; Set the number of bytes to clear to #N$07.
 $C562 CALL $D508    ; Clear them.
 $C565 POP BC        ; Restore the address of the entry.
 $C566 LD A,C        ; Fetch the low byte.
 $C567 LD (DE),A     ; Store it.
 $C568 INC DE        ; Move on to the high byte.
 $C569 LD A,B        ; Fetch the high byte.
 $C56A LD (DE),A     ; Store it.
 $C56B INC DE        ; Move on.
 $C56C LD B,$0E      ; Set the number of bytes to clear to #N$0E.
 $C56E CALL $D508    ; Clear them.
 $C571 EXX           ; Switch to the alternate registers.
@label=PlaceSpecialObjectsInRoom_NextEntry
*$C572 LD DE,$0009   ; Set #REGde to the size of an entry.
 $C575 ADD IY,DE     ; Point #REGiy at the next entry.
 $C577 PUSH IY       ; {Copy #REGiy to #REGhl (using the stack).
 $C579 POP HL        ; }
 $C57A LD DE,$7112   ; Point #REGde at the end of the table.
 $C57D AND A         ; {Subtract the address of the end of the table.
 $C57E SBC HL,DE     ; }
 $C580 JR C,$C530    ; Jump back to #R$C530 until all of the entries have been
                     ; done.
 $C582 EXX           ; Switch to the registers that hold the address of the special object
                     ; of the room.
; Clear what is left of the special objects of the room.
@label=PlaceSpecialObjectsInRoom_ClearSlots
*$C583 LD HL,$5C88   ; Point #REGhl at the end of the special objects of the
                     ; room.
 $C586 AND A         ; {Subtract the address of the object that is next.
 $C587 SBC HL,DE     ; }
 $C589 RET Z         ; Return if there is no more room.
 $C58A LD B,$20      ; Set the number of bytes to clear to #N$20.
 $C58C CALL $D508    ; Clear them.
 $C58F JR $C583      ; Jump back to #R$C583.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$AE99 }
; LIST#

; Update Special Objects
;
; Used by the routine at #R$D1E6.
; .
; Copies the graphic number and the current position of each special
; object of the room back to the table of special objects, so that they are not
; lost when the player leaves the room.
@label=UpdateSpecialObjects
c$C591 LD IY,$5C48   ; Point #REGiy at the first special object of the room.
@label=UpdateSpecialObjects_Next
*$C595 LD A,(IY+$00) ; Fetch the graphic number of the object.
 $C598 AND A         ; Test whether there is an object.
 $C599 JR Z,$C5B7    ; Jump to #R$C5B7 if there is not.
 $C59B LD E,(IY+$10) ; Fetch the low byte of the address of the entry in the table of
                     ; special objects.
 $C59E LD D,(IY+$11) ; Fetch the high byte.
 $C5A1 LD A,(IY+$00) ; Fetch the graphic number of the object.
 $C5A4 LD (DE),A     ; Store it in the entry.
 $C5A5 INC DE        ; {Point #REGde at the current X coordinate of the entry.
 $C5A6 INC DE        ;
 $C5A7 INC DE        ;
 $C5A8 INC DE        ;
 $C5A9 INC DE        ; }
 $C5AA PUSH IY       ; {Copy #REGiy to #REGhl (using the stack).
 $C5AC POP HL        ; }
 $C5AD INC HL        ; Point #REGhl at the X coordinate of the object.
 $C5AE LD BC,$0003   ; Set the number of bytes to copy to #N$03.
 $C5B1 LDIR          ; Copy the position of the object to the entry.
 $C5B3 LD A,(IY+$08) ; Fetch the room of the object.
 $C5B6 LD (DE),A     ; Store it in the entry.
@label=UpdateSpecialObjects_NextSlot
*$C5B7 LD BC,$0020   ; Set #REGbc to the size of an object.
 $C5BA ADD IY,BC     ; Point #REGiy at the next object.
 $C5BC PUSH IY       ; {Copy #REGiy to #REGhl (using the stack).
 $C5BE POP HL        ; }
 $C5BF LD BC,$5C88   ; Point #REGbc at the end of the special objects of the
                     ; room.
 $C5C2 AND A         ; {Subtract the address of the end.
 $C5C3 SBC HL,BC     ; }
 $C5C5 JR C,$C595    ; Jump back to #R$C595 until both of the objects have been
                     ; done.
 $C5C7 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$AF05 }
; LIST#

; Handle Ghost
;
; Handles the graphic numbers #N$50 to #N$53, which are a ghost. The ghost
; moves in a straight line until it hits something, or does not move at all, and
; then it picks a new direction at random: its speed in X and in Y is #N$03 or
; #N$04, in either direction. The graphic of the ghost shows the way it moves,
; and is changed between its two frames each time. The ghost is deadly.
;
; IX Address of the ghost object
@label=HandleGhost
c$C5C8 CALL $C4DD    ; Set the pixel adjustments of the bottom half of a guard.
 $C5CB CALL $C700    ; Apply gravity to the ghost and move it.
 $C5CE LD A,(IX+$09) ; Fetch the speed in X.
 $C5D1 OR (IX+$0A)   ; Combine it with the speed in Y.
 $C5D4 JR Z,$C5DD    ; Jump to #R$C5DD if the ghost is not moving.
 $C5D6 LD A,(IX+$0C) ; Fetch the flags that say what the ghost has hit.
 $C5D9 AND %00000011 ; Keep the bits for X and Y.
 $C5DB JR Z,$C5FD    ; Jump to #R$C5FD if the ghost has not hit anything.
; Choose a new direction.
@label=HandleGhost_NewDirection
*$C5DD LD A,($5BA5)  ; Fetch the second random seed.
 $C5E0 AND %00000011 ; Keep the lowest two bits.
 $C5E2 ADD A,$04     ; Add #N$04, to get a number from #N$04 to #N$07.
 $C5E4 CALL $C645    ; Look up the speed.
 $C5E7 LD (IX+$09),A ; Set the speed in X.
 $C5EA LD A,($5BA2)  ; Fetch the frame counter.
 $C5ED AND %00000011 ; Keep the lowest two bits.
 $C5EF ADD A,$04     ; Add #N$04, to get a number from #N$04 to #N$07.
 $C5F1 CALL $C645    ; Look up the speed.
 $C5F4 LD (IX+$0A),A ; Set the speed in Y.
 $C5F7 CALL $C603    ; Choose the graphic of the ghost from its direction.
 $C5FA CALL $B467    ; Play the sound of a moving object.
@label=HandleGhost_Draw
*$C5FD CALL $B985    ; Toggle the graphic of the ghost between its two frames.
 $C600 JP $B856      ; Make the ghost deadly and flag it to be drawn again.

; Set Ghost Direction Graphic
;
; Used by the routine at #R$C5C8.
; .
; Chooses the graphic of the ghost from the direction in which it moves,
; by setting bit 1 of the graphic number and the flag that flips the sprite. Of
; the two speeds the larger decides it.
;
; IX Address of the ghost object
@label=SetGhostDirectionGraphic
c$C603 LD A,(IX+$09)  ; Fetch the speed in X.
 $C606 AND A          ; Test it.
 $C607 JP P,$C60C     ; Jump to #R$C60C if it is positive.
 $C60A NEG            ; Make it positive.
@label=SetGhostDirectionGraphic_Y
*$C60C LD C,A         ; Stash it in #REGc.
 $C60D LD A,(IX+$0A)  ; Fetch the speed in Y.
 $C610 AND A          ; Test it.
 $C611 JP P,$C616     ; Jump to #R$C616 if it is positive.
 $C614 NEG            ; Make it positive.
@label=SetGhostDirectionGraphic_Compare
*$C616 CP C           ; Compare the speed in X with the speed in Y.
 $C617 JR NC,$C62F    ; Jump to #R$C62F if the ghost moves more in Y than in X.
 $C619 LD A,(IX+$09)  ; Fetch the speed in X.
 $C61C AND A          ; Test it.
 $C61D JP M,$C629     ; Jump to #R$C629 if it is negative.
 $C620 RES 1,(IX+$00) ; Select the first pair of graphics.
@label=SetGhostDirectionGraphic_SetFlip
*$C624 SET 6,(IX+$07) ; Flip the sprite.
 $C628 RET            ; Return.
@label=SetGhostDirectionGraphic_SecondPair
*$C629 SET 1,(IX+$00) ; Select the second pair of graphics.
 $C62D JR $C624       ; Jump to #R$C624.
@label=SetGhostDirectionGraphic_MoreInY
*$C62F LD A,(IX+$0A)  ; Fetch the speed in Y.
 $C632 AND A          ; Test it.
 $C633 JP M,$C63F     ; Jump to #R$C63F if it is negative.
 $C636 SET 1,(IX+$00) ; Select the second pair of graphics.
@label=SetGhostDirectionGraphic_ClearFlip
*$C63A RES 6,(IX+$07) ; Stop the sprite from being flipped.
 $C63E RET            ; Return.
@label=SetGhostDirectionGraphic_FirstPair
*$C63F RES 1,(IX+$00) ; Select the first pair of graphics.
 $C643 JR $C63A       ; Jump to #R$C63A.

; Look Up Ghost Speed
;
; Used by the routine at #R$C5C8.
; .
; Looks up a speed from the table at #R$C64E.
;
;   A Number of the entry
; O:A Speed
@label=LookUpGhostSpeed
c$C645 LD BC,$C64E   ; Point #REGbc at the table of speeds.
 $C648 LD L,A        ; Use the number of the entry as the low byte of the
                     ; offset.
 $C649 LD H,$00      ; Clear the high byte of the offset.
 $C64B ADD HL,BC     ; Point #REGhl at the entry.
 $C64C LD A,(HL)     ; Fetch the speed.
 $C64D RET           ; Return.
; View the equivalent code in;
; #LIST
; { #SABREWULF$9E53 }
; LIST#

; Ghost Speeds
;
; The speeds that a ghost can be given, from #N$FF and #N$01 to #N$F8 and
; #N$08, in pairs. Only the entries #N$04 to #N$07 are used.
@label=GhostSpeeds
b$C64E DEFB $FF,$01,$FE,$02,$FD,$03,$FC,$04
 $C656 DEFB $FB,$05,$FA,$06,$F9,$07,$F8,$08

; Handle Portcullis
;
; Handles a portcullis that is not moving. Nothing happens while another
; portcullis in the room is moving. A portcullis that is on the floor of the
; room, or no more than #N$1F above it, starts to rise on one frame in
; thirty-two. One that is higher than that starts to come down: at once for the
; first four times that a portcullis comes down, and after that on one frame in
; thirty-two.
;
; IX Address of the portcullis object
@label=HandlePortcullis
c$C65E CALL $C4DD      ; Set the pixel adjustments of the bottom half of a
                       ; guard.
 $C661 LD HL,$5BAF     ; Point #REGhl at #R$5BAF.
 $C664 LD A,(HL)       ; Fetch it.
 $C665 AND A           ; Test it.
 $C666 RET NZ          ; Return if a portcullis is moving.
 $C667 LD A,($5BAE)    ; Fetch the Z coordinate of the floor of the room.
 $C66A CP (IX+$03)     ; Compare it with the Z coordinate of the portcullis.
 $C66D JR Z,$C6AD      ; Jump to #R$C6AD if the portcullis is on the floor.
 $C66F ADD A,$1F       ; Add #N$1F to the height.
 $C671 CP (IX+$03)     ; Compare it with the Z coordinate of the portcullis.
 $C674 JR NC,$C6AD     ; Jump to #R$C6AD if the portcullis is no more than #N$1F above the
                       ; floor of the room.
 $C676 LD A,($5BB0)    ; Fetch the number of times that a portcullis has come
                       ; down.
 $C679 CP $04          ; {Jump to #R$C685 if it is fewer, to set off at once.
 $C67B JR C,$C685      ; }
 $C67D LD A,($5BA5)    ; Fetch the second random seed.
 $C680 AND %00011111   ; Keep the lowest five bits.
 $C682 RET NZ          ; Return unless it is the time to set off.
 $C683 OR %10000000    ; Set #REGa to a large number, so that it stays above
                       ; four.
@label=HandlePortcullis_Lower
*$C685 INC A           ; Add one to the number of times that a portcullis has
                       ; come down.
 $C686 LD ($5BB0),A    ; Store it.
 $C689 SET 0,(IX+$00)  ; Change the graphic of the portcullis to the moving
                       ; one.
 $C68D LD (IX+$0B),$FF ; Set the speed in Z to move it down.
; This entry point is used by the routine at #R$C6AD.
@label=HandlePortcullis_Flag
*$C691 INC (HL)        ; Flag that a portcullis is moving.

; Set Wipe And Draw Flags
;
; Used by the routines at #R$B593, #R$B683, #R$B6B9, #R$B6F9, #R$B7A9, #R$B856,
; #R$B8DA, #R$BEFE, #R$BF2B, #R$C232, #R$C2CC, #R$C306, #R$C337, #R$C69D,
; #R$C6BD and #R$C82B.
; .
; Flags an object to be wiped and drawn again, and flags every other
; object that overlaps it to be drawn too.
;
; IX Address of the object
@label=SetWipeAndDrawFlags
c$C692 LD A,(IX+$07) ; Fetch the flags of the object.
 $C695 OR %00110000  ; Set the bits that flag the object to be wiped and drawn.
 $C697 LD (IX+$07),A ; Store the flags.
 $C69A JP $CD4D      ; Flag the objects that overlap it to be drawn.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$BFAB }
; { #PENTAGRAM$CCDE }
; LIST#

; Set Wipe And Draw Flags For Object
;
; Used by the routine at #R$C00E.
; .
; Flags the object that #REGiy points at to be wiped and drawn again, as
; #R$C692 does.
;
; IY Address of the object
@label=SetWipeAndDrawFlagsForObject
c$C69D PUSH IY       ; Stash #REGiy.
 $C69F PUSH IX       ; Stash #REGix.
 $C6A1 PUSH IY       ; {Copy #REGiy to #REGix (using the stack).
 $C6A3 POP IX        ; }
 $C6A5 CALL $C692    ; Flag the object to be wiped and drawn.
 $C6A8 POP IX        ; Restore #REGix.
 $C6AA POP IY        ; Restore #REGiy.
 $C6AC RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$ADF3 }
; { #PENTAGRAM$BF56 }
; LIST#

; Start Portcullis Rising
;
; Used by the routine at #R$C65E.
; .
; Starts a portcullis rising, on one frame in thirty-two.
;
; IX Address of the portcullis object
@label=StartPortcullisRising
c$C6AD LD A,($5BA5)    ; Fetch the second random seed.
 $C6B0 AND %00011111   ; Keep the lowest five bits.
 $C6B2 RET NZ          ; Return unless it is the time to set off.
 $C6B3 SET 0,(IX+$00)  ; Change the graphic of the portcullis to the moving
                       ; one.
 $C6B7 LD (IX+$0B),$01 ; Set the speed in Z to move it up.
 $C6BB JR $C691        ; Jump to #R$C691.

; Handle Moving Portcullis
;
; Handles a portcullis that is moving. A portcullis that is coming down is
; deadly. It speeds up as it falls until it hits the floor, and the sound of a
; portcullis is played. One that is going up moves at a speed of #N$02 until it
; is #N$1F above the floor of the room. When it is done the portcullis stops,
; and the next one is free to start.
;
; IX Address of the portcullis object
@label=HandleMovingPortcullis
c$C6BD CALL $C4DD      ; Set the pixel adjustments of the bottom half of a
                       ; guard.
 $C6C0 SET 7,(IX+$0D)  ; Make the portcullis deadly.
 $C6C4 LD A,($5C14)    ; Fetch the counter and flags of the player.
 $C6C7 AND %11110000   ; Keep the counter that runs when the player enters the
                       ; room.
 $C6C9 RET NZ          ; Return if the player has only just entered the room.
 $C6CA LD A,(IX+$0B)   ; Fetch the speed in Z.
 $C6CD AND A           ; Test it.
 $C6CE JP P,$C6EA      ; Jump to #R$C6EA if the portcullis is going up.
 $C6D1 DEC (IX+$0B)    ; Increase the speed of the fall.
 $C6D4 CALL $C700      ; Apply gravity to the portcullis and move it.
 $C6D7 BIT 2,(IX+$0C)  ; {Jump to #R$C692 if the portcullis has not hit the
 $C6DB JR Z,$C692      ; floor.}
 $C6DD CALL $B489      ; Play the sound of a portcullis.
@label=HandleMovingPortcullis_Stop
*$C6E0 XOR A           ; Clear #REGa.
 $C6E1 LD ($5BAF),A    ; Flag that no portcullis is moving.
 $C6E4 RES 0,(IX+$00)  ; Change the graphic of the portcullis to the stationary
                       ; one.
 $C6E8 JR $C692        ; Jump to #R$C692.
@label=HandleMovingPortcullis_Rise
*$C6EA LD (IX+$0B),$02 ; Set the speed in Z to #N$02.
 $C6EE CALL $B467      ; Play the sound of a moving object.
 $C6F1 CALL $C700      ; Apply gravity to the portcullis and move it.
 $C6F4 LD A,($5BAE)    ; Fetch the Z coordinate of the floor of the room.
 $C6F7 ADD A,$1F       ; Add #N$1F to it.
 $C6F9 CP (IX+$03)     ; Compare it with the Z coordinate of the portcullis.
 $C6FC JR NC,$C692     ; Jump to #R$C692 if the portcullis has not yet reached
                       ; the top.
 $C6FE JR $C6E0        ; Jump to #R$C6E0 to stop it.

; Apply Gravity And Move
;
; Used by the routines at #R$B593, #R$B5FF, #R$B683, #R$B73C, #R$B7A9, #R$B7ED,
; #R$B80F, #R$B865, #R$B8DA, #R$B92C, #R$B9A5, #R$C1F1, #R$C28B, #R$C4B6,
; #R$C4C3, #R$C5C8 and #R$C6BD.
; .
; Makes an object fall faster, then moves it. The entry point at #R$C706
; only moves the object.
;
; IX Address of the object
@label=ApplyGravityAndMove
c$C700 DEC (IX+$0B)   ; Take one off the speed in Z of the object.
 $C703 CALL $CB45     ; Stop the object moving through other objects and the walls of the
                      ; room.
; This entry point is used by the routine at #R$C9A1.
; .
; Adds the speeds in X, Y and Z of the object to its position.
@label=MoveObject
*$C706 LD A,(IX+$01)  ; {Add the speed in X to the X coordinate.
 $C709 ADD A,(IX+$09) ;
 $C70C LD (IX+$01),A  ; }
 $C70F LD A,(IX+$02)  ; {Add the speed in Y to the Y coordinate.
 $C712 ADD A,(IX+$0A) ;
 $C715 LD (IX+$02),A  ; }
 $C718 LD A,(IX+$03)  ; {Add the speed in Z to the Z coordinate.
 $C71B ADD A,(IX+$0B) ;
 $C71E LD (IX+$03),A  ; }
 $C721 RET            ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$BFB6 }
; { #PENTAGRAM$B979 }
; LIST#

; Handle Far Arch
;
; Handles the graphic numbers #N$03 and #N$05, which are the far side of
; an arch. They only need the pixel adjustments of the sprite, which are not the
; same when the sprite is flipped.
;
; IX Address of the arch object
@label=HandleFarArch
c$C722 BIT 6,(IX+$07) ; {Jump to #R$C732 if the arch is flipped horizontally.
 $C726 JR NZ,$C732    ; }
 $C728 LD HL,$FDF7    ; Set the adjustments of #N$F7 in X and #N$FD in Y.

; Store Pixel Adjustments
;
; Used by the routines at #R$B99F, #R$C4D3, #R$C732, #R$C73C and #R$C76C.
; .
; Sets the adjustments to the position of the sprite of an object.
;
; H Adjustment in Y
; L Adjustment in X
; IX Address of the object
@label=StorePixelAdjustments
c$C72B LD (IX+$12),L ; Set the adjustment in X.
 $C72E LD (IX+$13),H ; Set the adjustment in Y.
 $C731 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #PENTAGRAM$C76E }
; LIST#

; Adjust Flipped Far Arch
;
; Used by the routine at #R$C722.
; .
; Sets the adjustments for the far side of an arch whose sprite is
; flipped.
;
; IX Address of the arch object
@label=AdjustFlippedFarArch
c$C732 LD HL,$FEF9   ; Set #REGhl to the adjustments of #N$F9 in X and #N$FE in
                     ; Y.
 $C735 JR $C72B      ; Jump to #R$C72B.

; Adjust Tree Arch
;
; Used by the routine at #R$C73C.
; .
; Sets the adjustments for the near side of a tree arch, and carries on to
; find where the middle of the arch is.
;
; IX Address of the arch object
@label=AdjustTreeArch
c$C737 LD HL,$FD01   ; Set #REGhl to the adjustments of #N$01 in X and #N$FD in
                     ; Y.
 $C73A JR $C74C      ; Jump to #R$C74C.

; Handle Near Arch
;
; Handles the graphic numbers #N$02 and #N$04, which are the near side of
; an arch and of a tree arch. The speeds in X, Y and Z of the arch are not used
; to move it, so they are used to keep the position of the middle of the
; doorway. The player, and any special object, that gets close enough to the
; arch is flagged as near it, and is nudged towards the middle line of the
; doorway, so that it goes through the middle.
;
; IX Address of the arch object
@label=HandleNearArch
c$C73C BIT 6,(IX+$07) ; {Jump to #R$C76C if the arch is flipped horizontally.
 $C740 JR NZ,$C76C    ; }
 $C742 LD A,(IX+$00)  ; Fetch the graphic number of the arch.
 $C745 CP $04         ; {Jump to #R$C737 if it is a tree arch.
 $C747 JR Z,$C737     ; }
 $C749 LD HL,$FDF9    ; Set #REGhl to the adjustments of #N$F9 in X and #N$FD
                      ; in Y.
; This entry point is used by the routine at #R$C737.
; .
; The doorway is thirteen units further along the Y axis than the arch.
@label=HandleNearArch_Position
*$C74C CALL $C72B     ; Set the adjustments.
 $C74F LD A,(IX+$02)  ; Fetch the Y coordinate of the arch.
 $C752 ADD A,$0D      ; Add #N$0D to it.
 $C754 LD (IX+$0A),A  ; Keep it as the Y coordinate of the middle of the
                      ; doorway.
 $C757 LD A,(IX+$01)  ; Fetch the X coordinate of the arch.
 $C75A LD (IX+$09),A  ; Keep it as the X coordinate of the middle of the
                      ; doorway.
 $C75D LD HL,$060F    ; Set #REGh to the distance in Y that counts as near and #REGl to the
                      ; distance in X.
; This entry point is used by the routine at #R$C76C.
@label=HandleNearArch_Near
*$C760 LD A,(IX+$03)  ; Fetch the Z coordinate of the arch.
 $C763 LD (IX+$0B),A  ; Keep it as the Z coordinate of the middle of the
                      ; doorway.
 $C766 CALL $C7DB     ; Flag the objects that are near the arch.
 $C769 JP $C785       ; Jump to #R$C785.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$BFEA }
; { #PENTAGRAM$C7AD }
; LIST#

; Handle Flipped Near Arch
;
; Used by the routine at #R$C73C.
; .
; Sets up the near side of an arch whose sprite is flipped. The middle of
; the doorway is thirteen units back along the X axis.
;
; IX Address of the arch object
@label=HandleFlippedNearArch
c$C76C LD HL,$FEEF   ; Set #REGhl to the adjustments of #N$EF in X and #N$FE in
                     ; Y.
 $C76F CALL $C72B    ; Set the adjustments.
 $C772 LD A,(IX+$01) ; Fetch the X coordinate of the arch.
 $C775 SUB $0D       ; Take #N$0D off it.
 $C777 LD (IX+$09),A ; Keep it as the X coordinate of the middle of the
                     ; doorway.
 $C77A LD A,(IX+$02) ; Fetch the Y coordinate of the arch.
 $C77D LD (IX+$0A),A ; Keep it as the Y coordinate of the middle of the
                     ; doorway.
 $C780 LD HL,$0F06   ; Set #REGh to the distance in Y that counts as near and #REGl to the
                     ; distance in X.
 $C783 JR $C760      ; Jump to #R$C760.

; Nudge Objects To Arch
;
; Used by the routine at #R$C73C.
; .
; Nudges the player and the special objects towards the middle of a
; doorway, if they are close enough to the arch and are flagged to be adjusted.
; The way in which they are nudged is picked from the table at #R$C7A9, by the
; direction in which the arch faces.
;
; IX Address of the arch object
@label=NudgeObjectsToArch
c$C785 LD HL,$0F0F    ; Set the distances that count as near to #N$0F in X and
                      ; in Y.
 $C788 LD IY,$5C08    ; Point #REGiy at #R$5C08.
 $C78C LD DE,$0020    ; Set #REGde to the size of an object.
 $C78F LD B,$04       ; Set the number of objects to #N$04, which is the player and the
                      ; special objects.
; This entry point is used by the routine at #R$C7C4.
@label=NudgeObjectsToArch_Next
*$C791 LD A,(IY+$00)  ; Fetch the graphic number of the object.
 $C794 AND A          ; Test whether there is an object.
 $C795 JR Z,$C7D6     ; Jump to #R$C7D6 if there is not.
 $C797 BIT 3,(IY+$07) ; {Jump to #R$C7D6 if the object is not flagged to be adjusted near
 $C79B JR Z,$C7D6     ; arches.}
 $C79D CALL $C7FE     ; Test whether the object is near the arch.
 $C7A0 JR NC,$C7D6    ; Jump to #R$C7D6 if it is not.
 $C7A2 PUSH BC        ; Stash the number of objects left.
 $C7A3 LD BC,$C7A9    ; Point #REGbc at #R$C7A9.
 $C7A6 JP $CA17       ; Jump to the routine for the direction of the arch.

; Arch Direction Table
;
; The routines that nudge an object towards the middle of a doorway, by
; the direction of the arch: the lowest bit is bit 3 of the graphic number of
; the arch, and the next is whether the sprite is flipped.
@label=ArchDirectionTable
w$C7A9 DEFW $C7B1    ; {Not flipped: #R$C7B1.
 $C7AB DEFW $C7B1    ; }
 $C7AD DEFW $C7C4    ; {Flipped: #R$C7C4.
 $C7AF DEFW $C7C4    ; }

; Nudge Object East West
;
; Sets the adjustment of the speed in Y of an object, to bring it a step
; closer to the middle line of an arch that goes east and west.
;
; IX Address of the arch object
; IY Address of the object
@label=NudgeObjectEastWest
c$C7B1 LD A,(IX+$0A) ; Fetch the Y coordinate of the middle of the doorway.
 $C7B4 CP (IY+$02)   ; Compare it with the Y coordinate of the object.
 $C7B7 JR Z,$C7D5    ; Jump to #R$C7D5 if the object is in the middle.
 $C7B9 LD A,$01      ; Set the adjustment to #N$01.
 $C7BB JR NC,$C7BF   ; Jump to #R$C7BF if the object is south of the middle.
 $C7BD NEG           ; Make the adjustment negative.
@label=NudgeObjectEastWest_Set
*$C7BF LD (IY+$0F),A ; Set the adjustment of the speed in Y of the object.
 $C7C2 JR $C7D5      ; Jump to #R$C7D5.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C050 }
; { #PENTAGRAM$C907 }
; LIST#

; Nudge Object North South
;
; Sets the adjustment of the speed in X of an object, to bring it a step
; closer to the middle line of an arch that goes north and south.
;
; IX Address of the arch object
; IY Address of the object
@label=NudgeObjectNorthSouth
c$C7C4 LD A,(IX+$09) ; Fetch the X coordinate of the middle of the doorway.
 $C7C7 CP (IY+$01)   ; Compare it with the X coordinate of the object.
 $C7CA JR Z,$C7D5    ; Jump to #R$C7D5 if the object is in the middle.
 $C7CC LD A,$01      ; Set the adjustment to #N$01.
 $C7CE JR NC,$C7D2   ; Jump to #R$C7D2 if the object is west of the middle.
 $C7D0 NEG           ; Make the adjustment negative.
@label=NudgeObjectNorthSouth_Set
*$C7D2 LD (IY+$0E),A ; Set the adjustment of the speed in X of the object.
; This entry point is used by the routine at #R$C7B1.
@label=NudgeObjectsToArch_Restore
*$C7D5 POP BC        ; Restore the number of objects left.
; This entry point is used by the routine at #R$C785.
@label=NudgeObjectsToArch_Advance
*$C7D6 ADD IY,DE     ; Point #REGiy at the next object.
 $C7D8 DJNZ $C791    ; Jump back to #R$C791 until all of the objects have been
                     ; done.
 $C7DA RET           ; Return.

; Flag Objects Near Arch
;
; Used by the routine at #R$C73C.
; .
; Flags the player and the special objects that are close to an arch, and
; are flagged to be adjusted near arches, as being near an arch.
;
; H Distance in Y that counts as near
; L Distance in X that counts as near
; IX Address of the arch object
@label=FlagObjectsNearArch
c$C7DB LD IY,$5C08    ; Point #REGiy at the player.
 $C7DF LD DE,$0020    ; Set #REGde to the size of an object.
 $C7E2 LD B,$04       ; Set the number of objects to #N$04, which is the player and the
                      ; special objects.
@label=FlagObjectsNearArch_Next
*$C7E4 LD A,(IY+$00)  ; Fetch the graphic number of the object.
 $C7E7 AND A          ; Test whether there is an object.
 $C7E8 JR Z,$C7F9     ; Jump to #R$C7F9 if there is not.
 $C7EA BIT 3,(IY+$07) ; {Jump to #R$C7F9 if the object is not flagged to be adjusted near
 $C7EE JR Z,$C7F9     ; arches.}
 $C7F0 CALL $C7FE     ; Test whether the object is near the arch.
 $C7F3 JR NC,$C7F9    ; Jump to #R$C7F9 if it is not.
 $C7F5 SET 0,(IY+$07) ; Flag the object as being near an arch.
@label=FlagObjectsNearArch_Advance
*$C7F9 ADD IY,DE      ; Point #REGiy at the next object.
 $C7FB DJNZ $C7E4     ; Jump back to #R$C7E4 until all of the objects have been
                      ; done.
 $C7FD RET            ; Return.

; Test Near To
;
; Used by the routines at #R$C785 and #R$C7DB.
; .
; Tests whether an object is close to the point that the arch keeps as the
; middle of its doorway: less than #REGl away in X, less than #REGh away in Y
; and less than #N$04 away in Z.
;
;   H Distance in Y that counts as near
;   L Distance in X that counts as near
;   IX Address of the arch object
;   IY Address of the object
; O:F Carry flag set if the object is near
@label=TestNearTo
c$C7FE LD A,(IX+$09) ; Fetch the X coordinate of the middle of the doorway.
 $C801 SUB (IY+$01)  ; Subtract the X coordinate of the object.
 $C804 JR NC,$C808   ; Jump to #R$C808 if it is positive.
 $C806 NEG           ; Make it positive.
@label=TestNearTo_Y
*$C808 CP L          ; Compare it with the distance in X.
 $C809 RET NC        ; Return if it is too far.
 $C80A LD A,(IX+$0A) ; Fetch the Y coordinate of the middle of the doorway.
 $C80D SUB (IY+$02)  ; Subtract the Y coordinate of the object.
 $C810 JR NC,$C814   ; Jump to #R$C814 if it is positive.
 $C812 NEG           ; Make it positive.
@label=TestNearTo_Z
*$C814 CP H          ; Compare it with the distance in Y.
 $C815 RET NC        ; Return if it is too far.
 $C816 LD A,(IX+$0B) ; Fetch the Z coordinate of the middle of the doorway.
 $C819 SUB (IY+$03)  ; Subtract the Z coordinate of the object.
 $C81C JR NC,$C820   ; Jump to #R$C820 if it is positive.
 $C81E NEG           ; Make it positive.
@label=TestNearTo_Done
*$C820 CP $04        ; Compare it with #N$04.
 $C822 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C099 }
; { #PENTAGRAM$C8AD }
; LIST#

; Handle Human Legs
;
; Handles the bottom half of the player while it is in the form of a
; human, which is the graphic numbers #N$10 to #N$15 and #N$18 to #N$1D.
;
; IX Address of the object
@label=HandleHumanLegs
c$C823 CALL $C4DD    ; Set the pixel adjustments of the legs of a human.
 $C826 JR $C82B      ; Jump to #R$C82B.

; Handle Wulf Legs
;
; Handles the bottom half of the player while it is in the form of a wulf,
; which is the graphic numbers #N$30 to #N$35 and #N$38 to #N$3D.
;
; IX Address of the object
@label=HandleWulfLegs
c$C828 CALL $C4FC    ; Set the pixel adjustments of the legs of a wulf.

; Handle Player Legs
;
; Used by the routine at #R$C823.
; .
; Does all of the work for the player, as the top half of the player is
; only a copy of the bottom half placed above it (see #R$CDDA). If the player
; has been killed this starts the death sparkles. Otherwise it reads the
; controls, lets the player pick up or drop an object, turn, jump and walk, and
; then moves the player.
;
; IX Address of the object
@label=HandlePlayerLegs
c$C82B BIT 6,(IX+$0D) ; {Jump to #R$C83E if the player is alive.
 $C82F JR Z,$C83E     ; }
 $C831 LD A,($5BC3)   ; {Fetch the final animation flag.
 $C834 AND A          ; }
 $C835 JR NZ,$C83E    ; Jump to #R$C83E if it is set, as the player is not killed during the
                      ; final animation.
 $C837 SET 6,(IX+$2D) ; Flag the top half of the player as dead too.
 $C83B JP $BF21       ; Start the death sparkles.
; The player is alive. The controls are kept in #REGc while they are
; handled.
@label=HandlePlayerLegs_Alive
*$C83E CALL $C306     ; Start the transformation if it is due. If it does start, this does
                      ; not return here but to the routine that called this one.
 $C841 CALL $D022     ; Read the controls.
 $C844 CALL $C00E     ; Handle picking up and dropping an object.
 $C847 CALL $C89F     ; Handle turning.
 $C84A CALL $C948     ; Handle jumping.
 $C84D CALL $C969     ; Handle walking.
 $C850 CALL $C87A     ; Test whether the player is inside the room.
 $C853 JR NC,$C86D    ; Jump to #R$C86D if the player is not.
; This entry point is used by the routine at #R$C86D.
; .
; The top half of the player is flagged to be ignored in the 3D
; calculations while the player moves, so that the two halves do not get in each
; other's way.
@label=HandlePlayerLegs_Move
*$C855 SET 1,(IX+$27) ; Flag the top half of the player to be ignored.
 $C859 CALL $C9A1     ; Move the player.
 $C85C RES 1,(IX+$27) ; Stop ignoring the top half of the player.
 $C860 LD A,(IX+$0C)  ; Fetch the flags, which hold the counter of the player entering the
                      ; room in the high nibble.
 $C863 SUB $10        ; Take one off the counter.
 $C865 JR C,$C86A     ; Jump to #R$C86A if the counter was already zero.
 $C867 LD (IX+$0C),A  ; Store the new counter.
@label=HandlePlayerLegs_Draw
*$C86A JP $C692       ; Jump to #R$C692.

; Handle Player Outside Room
;
; Used by the routine at #R$C82B.
; .
; Handles the player being outside the room, which happens while the
; player walks through an arch. The player may fall, but is not allowed to rise.
;
; IX Address of the object
@label=HandlePlayerOutsideRoom
c$C86D LD A,(IX+$0B) ; Fetch the speed in Z of the player.
 $C870 AND A         ; Test whether it is negative.
 $C871 JP M,$C855    ; Jump to #R$C855 if it is, as the player is falling.
 $C874 XOR A         ; {Set the speed in Z to zero.
 $C875 LD (IX+$0B),A ; }
 $C878 JR $C855      ; Jump to #R$C855.

; Test Player In Room
;
; Used by the routines at #R$C00E and #R$C82B.
; .
; Tests whether the player is inside the room. The distance from the
; middle of the room (#N$80) has to be smaller than the size of the room, less
; the width of the player in X and less the depth of the player in Y.
;
;   IX Address of the object
; O:F The carry flag is set if the player is inside the room
@label=TestPlayerInRoom
c$C87A LD HL,($5BAB) ; Fetch the size of the room in X and Y.
 $C87D LD A,L        ; {Take the width of the player off the size in X.
 $C87E SUB (IX+$04)  ;
 $C881 LD L,A        ; }
 $C882 LD A,H        ; {Take the depth of the player off the size in Y.
 $C883 SUB (IX+$05)  ;
 $C886 LD H,A        ; }
 $C887 LD A,(IX+$01) ; {Fetch the X coordinate relative to the middle of the
 $C88A SUB $80       ; room.}
 $C88C JP P,$C891    ; Jump to #R$C891 if it is not negative.
 $C88F NEG           ; Make it positive.
@label=TestPlayerInRoom_LimitX
*$C891 CP L          ; Compare it with the limit in X.
 $C892 RET NC        ; Return with the carry flag reset if the player is
                     ; outside the room.
 $C893 LD A,(IX+$02) ; {Fetch the Y coordinate relative to the middle of the
 $C896 SUB $80       ; room.}
 $C898 JP P,$C89D    ; Jump to #R$C89D if it is not negative.
 $C89B NEG           ; Make it positive.
@label=TestPlayerInRoom_CompareY
*$C89D CP H          ; Compare it with the limit in Y, which sets the carry flag if the
                     ; player is inside.
 $C89E RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C117 }
; { #PENTAGRAM$C4A3 }
; LIST#

; Handle Turning
;
; Used by the routine at #R$C82B.
; .
; Turns the player, using the left and right controls or, if a joystick
; with directional control is in use, the direction that is pressed. The
; directional controls turn the player a quarter turn at a time towards the
; direction pressed along the shortest way, and flag the player to walk once it
; is facing that direction. The facing of the player is stored as the horizontal
; flip flag and bit 3 of the graphic number.
;
; C The controls
; IX Address of the object
; O:C The controls, with the walk control changed if directional control
; is in use
@label=HandleTurning
c$C89F LD HL,$5BA4    ; {Fetch the control method.
 $C8A2 LD A,(HL)      ; }
 $C8A3 AND %00000110  ; Keep the joystick bits.
 $C8A5 JR Z,$C8F2     ; Jump to #R$C8F2 if the keyboard is in use.
 $C8A7 BIT 3,(HL)     ; {Jump to #R$C8F2 if directional control is not in use.
 $C8A9 JR Z,$C8F2     ; }
; Directional control. The player cannot turn while entering the room, or
; while it is not standing on something.
 $C8AB LD A,(IX+$0C)  ; Fetch the flags of the player.
 $C8AE AND %11110000  ; Keep the counter of the player entering the room.
 $C8B0 RET NZ         ; Return if the player is entering the room.
 $C8B1 BIT 2,(IX+$0C) ; Test whether the player is standing on something.
 $C8B5 RET Z          ; Return if it is not.
; Find the direction that is pressed. Left takes priority over up.
 $C8B6 BIT 0,C        ; {Jump to #R$C8BE if it is pressed.
 $C8B8 JR NZ,$C8BE    ; }
 $C8BA BIT 2,C        ; {Jump to #R$C8CD if it is pressed.
 $C8BC JR NZ,$C8CD    ; }
@label=HandleTurning_Right
*$C8BE BIT 1,C        ; {Jump to #R$C8D9 if it is pressed.
 $C8C0 JR NZ,$C8D9    ; }
 $C8C2 BIT 4,C        ; {Jump to #R$C8E0 if it is pressed.
 $C8C4 JR NZ,$C8E0    ; }
 $C8C6 BIT 0,C        ; {Jump to #R$C8E9 if it is pressed.
 $C8C8 JR NZ,$C8E9    ; }
 $C8CA RES 2,C        ; Clear the walk control, as no direction is pressed.
 $C8CC RET            ; Return.
; The facing of the player is #N$00 for west, #N$01 for east, #N$02 for
; north and #N$03 for south.
@label=HandleTurning_North
*$C8CD CALL $CA1E     ; Fetch the direction the player is facing.
 $C8D0 CP $02         ; Test whether it is north.
@label=HandleTurning_North_Test
*$C8D2 JR Z,$C8EF     ; Jump to #R$C8EF if it is.
 $C8D4 CPL            ; Invert the direction.
@label=HandleTurning_North_Direction
*$C8D5 AND %00000001  ; Keep bit 0, which decides which way to turn.
 $C8D7 JR $C91F       ; Jump to #R$C91F.
@label=HandleTurning_East
*$C8D9 CALL $CA1E     ; Fetch the direction the player is facing.
 $C8DC CP $01         ; Test whether it is east.
 $C8DE JR $C8D2       ; Jump to #R$C8D2.
@label=HandleTurning_South
*$C8E0 CALL $CA1E     ; Fetch the direction the player is facing.
 $C8E3 CP $03         ; Test whether it is south.
@label=HandleTurning_South_Test
*$C8E5 JR Z,$C8EF     ; Jump to #R$C8EF if it is.
 $C8E7 JR $C8D5       ; Jump to #R$C8D5.
@label=HandleTurning_West
*$C8E9 CALL $CA1E     ; Fetch the direction the player is facing.
 $C8EC AND A          ; Test whether it is west.
 $C8ED JR $C8E5       ; Jump to #R$C8E5.
@label=HandleTurning_Walk
*$C8EF SET 2,C        ; Set the walk control, as the player is facing the direction that is
                      ; pressed.
 $C8F1 RET            ; Return.
; Rotational control. After each turn the player has to wait before it can
; turn again.
@label=HandleTurning_Rotate
*$C8F2 LD A,(IX+$0D)  ; Fetch the flags.
 $C8F5 AND %00000111  ; Keep the turning delay counter, which is in the low
                      ; three bits.
 $C8F7 JR Z,$C8FD     ; Jump to #R$C8FD if it has run out.
 $C8F9 DEC (IX+$0D)   ; Count it down.
 $C8FC RET            ; Return.
@label=HandleTurning_Rotate_ReadControls
*$C8FD LD A,C         ; Fetch the controls.
 $C8FE AND %00000011  ; Keep left and right.
 $C900 RET Z          ; Return if neither is pressed.
 $C901 LD A,(IX+$0C)  ; Fetch the flags of the player.
 $C904 AND %11110000  ; Keep the counter of the player entering the room.
 $C906 RET NZ         ; Return if the player is entering the room.
 $C907 BIT 3,(IX+$0C) ; Test whether the player is jumping.
 $C90B RET NZ         ; Return if it is.
 $C90C BIT 2,C        ; {Jump to #R$C915 if it is pressed.
 $C90E JR NZ,$C915    ; }
 $C910 PUSH BC        ; Stash the controls.
 $C911 CALL $B4C1     ; Play the sound of the footsteps.
 $C914 POP BC         ; Restore the controls.
@label=HandleTurning_Rotate_Reset
*$C915 LD A,(IX+$0D)  ; Fetch the flags.
 $C918 OR %00000010   ; Set the turning delay counter, which has run out, to
                      ; #N$02.
 $C91A LD (IX+$0D),A  ; Store it.
 $C91D BIT 1,C        ; Test the right control.
@label=HandleTurning_Turn
*$C91F JR NZ,$C940    ; Jump to #R$C940 if the player is to turn right.
 $C921 BIT 6,(IX+$07) ; {Jump to #R$C92F if the sprite is flipped horizontally.
 $C925 JR NZ,$C92F    ; }
@label=HandleTurning_ToggleGraphic
*$C927 LD A,(IX+$00)  ; Fetch the graphic number.
 $C92A XOR %00001000  ; Toggle bit 3 of it.
 $C92C LD (IX+$00),A  ; Store it.
@label=HandleTurning_ToggleFlip
*$C92F LD A,(IX+$07)  ; Fetch the flags.
 $C932 XOR %01000000  ; Toggle the horizontal flip flag.
 $C934 LD (IX+$07),A  ; Store the flags.
 $C937 LD A,(IX+$00)  ; {Fetch the graphic number, and add #N$10 to get the top
 $C93A ADD A,$10      ; half.}
 $C93C LD (IX+$20),A  ; Set the graphic number of the top half of the player.
 $C93F RET            ; Return.
@label=HandleTurning_ToggleFlip_Test
*$C940 BIT 6,(IX+$07) ; {Jump to #R$C927 if the sprite is flipped horizontally.
 $C944 JR NZ,$C927    ; }
 $C946 JR $C92F       ; Jump to #R$C92F.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C13C }
; { #PENTAGRAM$C4C8 }
; LIST#

; Handle Jump
;
; Used by the routine at #R$C82B.
; .
; Makes the player jump if the jump control is pressed. The player cannot
; jump while entering a room, while already jumping, or while falling quickly.
;
; C The controls
; IX Address of the object
@label=HandleJump
c$C948 BIT 3,C         ; Test the jump control.
 $C94A RET Z           ; Return if it is not pressed.
 $C94B LD A,(IX+$0C)   ; Fetch the flags of the player.
 $C94E AND %11110000   ; Keep the counter of the player entering the room.
 $C950 RET NZ          ; Return if the player is entering the room.
 $C951 BIT 3,(IX+$0C)  ; Test whether the player is already jumping.
 $C955 RET NZ          ; Return if it is.
 $C956 LD A,(IX+$0B)   ; {Fetch the speed in Z and add one to it.
 $C959 INC A           ; }
 $C95A RET M           ; Return if it was lower than #N$FF, as the player is
                       ; falling.
 $C95B SET 3,(IX+$0C)  ; Flag the player as jumping.
 $C95F LD (IX+$0B),$08 ; Set the speed in Z to #N$08.
 $C963 PUSH BC         ; Stash the controls.
 $C964 CALL $B441      ; Play the sound of a jump.
 $C967 POP BC          ; Restore the controls.
 $C968 RET             ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C23D }
; LIST#

; Handle Walking
;
; Used by the routine at #R$C82B.
; .
; Animates the legs of the player. The legs are only animated while the
; player is walking, entering the room or jumping. When the player stops, the
; legs carry on until they reach a frame in which the feet are together.
;
; C The controls
; IX Address of the object
@label=HandleWalking
c$C969 LD A,(IX+$0C)  ; Fetch the flags.
 $C96C AND %11110000  ; Keep the counter of the player entering the room.
 $C96E JR NZ,$C97A    ; Jump to #R$C97A if it is.
 $C970 BIT 3,(IX+$0C) ; {Jump to #R$C97A if the player is jumping.
 $C974 JR NZ,$C97A    ; }
 $C976 BIT 2,C        ; {Jump to #R$C994 if it is not pressed.
 $C978 JR Z,$C994     ; }
@label=HandleWalking_Step
*$C97A PUSH BC        ; Stash the controls.
 $C97B CALL $B4BB     ; Play the sound of the footsteps.
 $C97E POP BC         ; Restore the controls.
; This entry point is used by the routine at #R$B6F9.
; .
; The frame of the animation is in the low three bits of the graphic
; number and goes from #N$00 to #N$05.
@label=HandleWalking_Animate
*$C97F LD A,(IX+$00)  ; {Fetch the graphic number and stash it in #REGe.
 $C982 LD E,A         ; }
 $C983 INC A          ; Go to the next frame.
 $C984 AND %00000111  ; Keep the frame in the low three bits.
 $C986 CP $06         ; {Jump to #R$C98B if it has not.
 $C988 JR NZ,$C98B    ; }
 $C98A XOR A          ; Go back to the first frame.
@label=HandleWalking_Animate_StashFrame
*$C98B LD D,A         ; Stash the frame in #REGd.
 $C98C LD A,E         ; Fetch the graphic number.
 $C98D AND %11111000  ; Take the frame off it.
 $C98F OR D           ; Put the new frame back.
 $C990 LD (IX+$00),A  ; Update the graphic number.
 $C993 RET            ; Return.
@label=HandleWalking_Stop
*$C994 LD A,(IX+$00)  ; Fetch the graphic number.
 $C997 AND %00000111  ; Keep the frame of the animation.
 $C999 CP $02         ; Test whether it is frame #N$02.
 $C99B RET Z          ; Return if it is.
 $C99C CP $04         ; Test whether it is frame #N$04.
 $C99E RET Z          ; Return if it is.
 $C99F JR $C97F       ; Jump to #R$C97F to carry on animating the legs.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C25E }
; LIST#

; Move Player
;
; Used by the routine at #R$C82B.
; .
; Moves the player by one frame. The speeds in X and Y are only set up
; while the player walks or is jumping, and they are cleared again afterwards.
; The speed in Z has gravity taken off it, which is more if the player is
; falling or has let go of the jump control.
;
; C The controls
; IX Address of the object
@label=MovePlayer
c$C9A1 LD A,($5BC4)    ; {Fetch the flag that is set while an object is put
 $C9A4 AND A           ; into the cauldron.}
 $C9A5 JR Z,$C9AB      ; Jump to #R$C9AB if it is not set.
 $C9A7 LD (IX+$0B),$02 ; Set the speed in Z to #N$02.
@label=MovePlayer_Speed
*$C9AB BIT 3,(IX+$0C)  ; {Jump to #R$C9BC if the player is jumping.
 $C9AF JR NZ,$C9BC     ; }
 $C9B1 LD A,(IX+$0C)   ; Fetch the flags.
 $C9B4 AND %11110000   ; Keep the counter of the player entering the room.
 $C9B6 JR NZ,$C9BC     ; Jump to #R$C9BC if it is.
 $C9B8 BIT 2,C         ; {Jump to #R$C9C1 if it is not pressed.
 $C9BA JR Z,$C9C1      ; }
@label=MovePlayer_Forward
*$C9BC PUSH BC         ; Stash the controls.
 $C9BD CALL $C9FB      ; Set the speeds in X and Y from the direction of the
                       ; player.
 $C9C0 POP BC          ; Restore the controls.
; Gravity takes one off the speed in Z when the player is rising with the
; jump control held down, and two otherwise.
@label=MovePlayer_Gravity
*$C9C1 LD A,(IX+$0B)   ; {Fetch the speed in Z and test it.
 $C9C4 AND A           ; }
 $C9C5 JP M,$C9CC      ; Jump to #R$C9CC if it is negative.
 $C9C8 BIT 3,C         ; {Jump to #R$C9CD if it is pressed.
 $C9CA JR NZ,$C9CD     ; }
@label=MovePlayer_Fall
*$C9CC DEC A           ; Take one off the speed in Z.
@label=MovePlayer_Store
*$C9CD DEC A           ; Take one off the speed in Z.
 $C9CE LD (IX+$0B),A   ; Store the new speed in Z.
 $C9D1 LD ($5BC1),A    ; Store it as the last speed in Z of the player too.
 $C9D4 ADD A,$02       ; Add two to it.
 $C9D6 CALL M,$B451    ; Play the sound of falling if the player is falling
                       ; fast enough.
 $C9D9 CALL $CB45      ; Stop the player moving through other objects and the walls of the
                       ; room.
 $C9DC CALL $CA70      ; Change room if the player has gone through an arch.
 $C9DF CALL $C706      ; Add the speeds to the position of the player.
 $C9E2 BIT 2,(IX+$0C)  ; {Jump to #R$C9F3 if the player is not blocked in Z.
 $C9E6 JR Z,$C9F3      ; }
 $C9E8 LD A,($5BC1)    ; {Fetch the last speed in Z and test it.
 $C9EB AND A           ; }
 $C9EC JP P,$C9F3      ; Jump to #R$C9F3 if the player was rising.
 $C9EF RES 3,(IX+$0C)  ; Flag the player as no longer jumping, as it has
                       ; landed.
; This entry point is used by the routines at #R$C28B, #R$C4AA and #R$C4C3.
@label=MovePlayer_Stop
*$C9F3 XOR A           ; {Set the speeds in X and Y to zero.
 $C9F4 LD (IX+$09),A   ;
 $C9F7 LD (IX+$0A),A   ; }
 $C9FA RET             ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C296 }
; { #PENTAGRAM$C61D }
; LIST#

; Set Player Speed
;
; Used by the routine at #R$C9A1.
; .
; Sets the speeds in X and Y of the player to walk forward. The
; adjustments of the speeds that arches make to nudge the player into doorways
; are added first, then the speed of #N$03 in the direction the player is
; facing.
;
; IX Address of the object
@label=SetPlayerSpeed
c$C9FB LD A,(IX+$09)  ; {Add the adjustment of the speed in X to the speed in
 $C9FE ADD A,(IX+$0E) ; X.
 $CA01 LD (IX+$09),A  ; }
 $CA04 LD A,(IX+$0A)  ; {Add the adjustment of the speed in Y to the speed in
 $CA07 ADD A,(IX+$0F) ; Y.
 $CA0A LD (IX+$0A),A  ; }
 $CA0D XOR A          ; {Clear the adjustments of the speeds.
 $CA0E LD (IX+$0E),A  ;
 $CA11 LD (IX+$0F),A  ; }
 $CA14 LD BC,$CA32    ; Point #REGbc at #R$CA32.
; This entry point is used by the routines at #R$C785 and #R$CA70.
@label=SetPlayerSpeed_Direction
*$CA17 CALL $CA1E     ; Fetch the direction the player is facing.
 $CA1A LD L,A         ; Use it as the index into the table.
 $CA1B JP $AFDB       ; Jump to the routine for the direction.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C2F6 }
; { #PENTAGRAM$C66A }
; LIST#

; Get Facing Direction
;
; Used by the routines at #R$C89F and #R$C9FB.
; .
; Works out the direction an object is facing from the horizontal flip
; flag and bit 3 of the graphic number.
;
; IX Address of the object
; O:A The direction: #N$00 for west, #N$01 for east, #N$02 for north and
; #N$03 for south
@label=GetFacingDirection
c$CA1E LD A,(IX+$07) ; Fetch the flags of the object.
 $CA21 RRCA          ; {Move the horizontal flip flag to bit 4.
 $CA22 RRCA          ; }
 $CA23 AND %00010000 ; Keep it.
 $CA25 LD L,A        ; Stash it in #REGl.
 $CA26 LD A,(IX+$00) ; Fetch the graphic number.
 $CA29 AND %00001000 ; Keep bit 3.
 $CA2B OR L          ; Combine it with the flip flag.
 $CA2C RRCA          ; {Move the two bits into the low end.
 $CA2D RRCA          ;
 $CA2E RRCA          ; }
 $CA2F AND %00000011 ; Keep them.
 $CA31 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C319 }
; LIST#

; Player Movement Table
;
; The routines that set the speed of the player, by the direction the
; player is facing.
@label=PlayerMovementTable
w$CA32 DEFW $CA3A    ; Facing west: #R$CA3A.
 $CA34 DEFW $CA43    ; Facing east: #R$CA43.
 $CA36 DEFW $CA4A    ; Facing north: #R$CA4A.
 $CA38 DEFW $CA53    ; Facing south: #R$CA53.

; Move Player West
;
; Takes #N$03 off the speed in X of the object.
;
; IX Address of the object
@label=MovePlayerWest
c$CA3A LD A,(IX+$09) ; {Fetch the speed in X and take #N$03 off it.
 $CA3D ADD A,$FD     ; }
; This entry point is used by the routine at #R$CA43.
@label=MovePlayer_SetX
*$CA3F LD (IX+$09),A ; Store the speed in X.
 $CA42 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C337 }
; { #PENTAGRAM$C695 }
; LIST#

; Move Player East
;
; Adds #N$03 to the speed in X of the object.
;
; IX Address of the object
@label=MovePlayerEast
c$CA43 LD A,(IX+$09) ; {Fetch the speed in X and add #N$03 to it.
 $CA46 ADD A,$03     ; }
 $CA48 JR $CA3F      ; Jump to #R$CA3F.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C340 }
; { #PENTAGRAM$C69E }
; LIST#

; Move Player North
;
; Adds #N$03 to the speed in Y of the object.
;
; IX Address of the object
@label=MovePlayerNorth
c$CA4A LD A,(IX+$0A) ; {Fetch the speed in Y and add #N$03 to it.
 $CA4D ADD A,$03     ; }
; This entry point is used by the routine at #R$CA53.
@label=MovePlayer_SetY
*$CA4F LD (IX+$0A),A ; Store the speed in Y.
 $CA52 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C347 }
; { #PENTAGRAM$C6A5 }
; LIST#

; Move Player South
;
; Takes #N$03 off the speed in Y of the object.
;
; IX Address of the object
@label=MovePlayerSouth
c$CA53 LD A,(IX+$0A) ; {Fetch the speed in Y and take #N$03 off it.
 $CA56 ADD A,$FD     ; }
 $CA58 JR $CA4F      ; Jump to #R$CA4F.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C350 }
; { #PENTAGRAM$C6AE }
; LIST#

; Stop Object At Floor
;
; Used by the routine at #R$CB45.
; .
; Stops an object from going through the floor. If the Z coordinate of the
; object after it has moved is below the floor of the room, the object is
; flagged as blocked in Z, and its speed in Z is brought closer to zero until
; the object no longer goes through the floor.
;
;   H Speed in Z of the object
;   IX Address of the object
; O:H The new speed in Z of the object
@label=StopObjectAtFloor
c$CA5A LD A,($5BAE)   ; {Fetch the Z coordinate of the floor of the room and stash it in
 $CA5D LD D,A         ; #REGd.}
@label=StopObjectAtFloor_Test
*$CA5E LD A,(IX+$03)  ; {Test whether the object ends up below the floor.
 $CA61 ADD A,H        ;
 $CA62 CP D           ; }
 $CA63 RET NC         ; Return if it does not.
 $CA64 SET 2,(IX+$0C) ; Flag the object as blocked in Z.
 $CA68 LD A,H         ; Fetch the speed in Z.
 $CA69 CALL $CA89     ; Bring it closer to zero.
 $CA6C LD H,A         ; Store it.
 $CA6D JR NZ,$CA5E    ; Jump back to #R$CA5E if it is not yet zero.
 $CA6F RET            ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C357 }
; { #PENTAGRAM$B963 }
; LIST#

; Handle Room Exit
;
; Used by the routine at #R$C9A1.
; .
; Sends the player to the next room if it has walked out through an arch.
; Only a player that is near an arch can leave the room, and not while it is
; still entering the room. The edge that counts is the one in the direction that
; the player is facing.
;
; IX Address of the object
@label=HandleRoomExit
c$CA70 LD A,(IX+$0C)  ; Fetch the flags of the player.
 $CA73 AND %11110000  ; Keep the counter of the player entering the room.
 $CA75 RET NZ         ; Return if the player is entering the room.
 $CA76 BIT 0,(IX+$07) ; Test whether the player is near an arch.
 $CA7A RET Z          ; Return if it is not.
 $CA7B RES 0,(IX+$07) ; Clear the flag.
 $CA7F LD BC,$CA92    ; Point #REGbc at #R$CA92.
 $CA82 LD HL,($5BAB)  ; Fetch the size of the room in X and Y.
 $CA85 PUSH HL        ; Stack it for the routine to take off.
 $CA86 JP $CA17       ; Jump to the routine for the direction the player is
                      ; facing.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C36D }
; LIST#

; Bring Speed Closer To Zero
;
; Used by the routines at #R$CA5A, #R$CB9A, #R$CBE9, #R$CC38, #R$CCDD and
; #R$CD08.
; .
; Takes one off the size of a speed.
;
;   A The speed
; O:A The new speed
; O:F The zero flag is set if the new speed is zero
@label=BringSpeedCloserToZero
c$CA89 AND A         ; Test whether the speed is zero.
 $CA8A RET Z         ; Return if it is.
 $CA8B JP P,$CA90    ; Jump to #R$CA90 if it is positive.
 $CA8E INC A         ; {Add two to the negative speed.
 $CA8F INC A         ; }
@label=BringSpeedCloserToZero_Step
*$CA90 DEC A         ; Take one off the speed.
 $CA91 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C386 }
; { #PENTAGRAM$B95A }
; LIST#

; Room Exit Table
;
; The routines that take the player to the next room, by the direction the
; player is facing.
@label=RoomExitTable
w$CA92 DEFW $CA9A    ; Facing west: #R$CA9A.
 $CA94 DEFW $CAF3    ; Facing east: #R$CAF3.
 $CA96 DEFW $CB0E    ; Facing north: #R$CB0E.
 $CA98 DEFW $CB29    ; Facing south: #R$CB29.

; Leave Room To The West
;
; Sends the player to the room to the west if it has gone past the west
; edge of the room. The X coordinate is set to #N$00, which #R$D320 takes as the
; sign that the player has come out of the west, and so puts it at the east side
; of the new room.
;
; HL The size of the room in X and Y
; IX Address of the object
@label=LeaveRoomToWest
c$CA9A POP HL          ; Unstack the size of the room in X and Y.
 $CA9B LD A,$80        ; {Work out the coordinate of the west edge of the room.
 $CA9D SUB L           ;
 $CA9E LD L,A          ; }
 $CA9F LD A,(IX+$01)   ; {Add the speed in X and the width of the player to the
 $CAA2 ADD A,(IX+$09)  ; X coordinate.
 $CAA5 ADD A,(IX+$04)  ; }
 $CAA8 CP L            ; Compare it with the west edge.
 $CAA9 RET NC          ; Return if the player is still in the room.
 $CAAA LD (IX+$01),$00 ; Set the X coordinate to #N$00.
 $CAAE LD A,(IX+$08)   ; {Fetch the room number and stash it in #REGl.
 $CAB1 LD L,A          ; }
 $CAB2 DEC A           ; Go to the room to the west.
; This entry point is used by the routine at #R$CAF3.
; .
; Changes the column of the room number. The room number is the row in the
; high nibble and the column in the low nibble, and going past the last column
; wraps round to the first.
@label=ChangeRoomEastWest
*$CAB3 AND %00001111   ; Keep the column of the new room number.
 $CAB5 LD H,A          ; Stash it in #REGh.
 $CAB6 LD A,L          ; Fetch the old room number.
 $CAB7 AND %11110000   ; Keep the row.
 $CAB9 OR H            ; Combine the row with the new column.
; This entry point is used by the routines at #R$CB0E and #R$CB29.
; .
; Changes the room of the player. The player is flagged as entering the
; room, which gives the counter a start value of #N$03.
@label=ChangeRoom
*$CABA LD (IX+$08),A   ; Store the new room number.
 $CABD LD A,(IX+$0C)   ; Fetch the flags.
 $CAC0 OR %00110000    ; Set the counter of the player entering the room to
                       ; #N$03.
 $CAC2 LD (IX+$0C),A   ; Store the flags.
 $CAC5 LD A,(IX+$00)   ; {Fetch the graphic number and take #N$10 off it.
 $CAC8 SUB $10         ; }
 $CACA CP $40          ; Compare it with #N$40.
 $CACC RET NC          ; Return if it is not one of the graphics of the human
                       ; or the wulf.
 $CACD INC SP          ; {Drop the two return addresses on the stack, as the game loop starts
 $CACE INC SP          ; again.
 $CACF INC SP          ;
 $CAD0 INC SP          ; }
 $CAD1 PUSH IX         ; {Point #REGhl at the player.
 $CAD3 POP HL          ; }
 $CAD4 LD DE,$D161     ; Point #REGde at #R$D161.
 $CAD7 LD BC,$0040     ; Set the length to #N$40, for the two halves of the
                       ; player.
 $CADA LDIR            ; Copy the player.
 $CADC LD A,($D161)    ; {Copy the graphic number of the bottom half into the field that holds
 $CADF LD ($D171),A    ; the graphic the player has to have when it appears.}
 $CAE2 LD A,($D181)    ; {Copy the graphic number of the top half into the same field of the
 $CAE5 LD ($D191),A    ; top half.}
 $CAE8 LD A,$78        ; Fetch the graphic number of the first of the sparkles that show the
                       ; player appearing.
 $CAEA LD ($D161),A    ; Set the graphic number of the bottom half of the copy.
 $CAED LD ($D181),A    ; Set the graphic number of the top half of the copy.
 $CAF0 JP $AFBA        ; Start the game loop again, which builds the new room.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C397 }
; LIST#

; Leave Room To The East
;
; Sends the player to the room to the east if it has gone past the east
; edge of the room. The X coordinate is set to #N$FF, which #R$D320 takes as the
; sign that the player has come out of the east, and so puts it at the west side
; of the new room.
;
; HL The size of the room in X and Y
; IX Address of the object
@label=LeaveRoomToEast
c$CAF3 POP HL          ; Unstack the size of the room in X and Y.
 $CAF4 LD A,L          ; {Work out the coordinate of the east edge of the room.
 $CAF5 ADD A,$80       ;
 $CAF7 LD L,A          ; }
 $CAF8 LD A,(IX+$01)   ; {Add the speed in X to the X coordinate, and take the width of the
 $CAFB ADD A,(IX+$09)  ; player off it.
 $CAFE SUB (IX+$04)    ; }
 $CB01 CP L            ; Compare it with the east edge.
 $CB02 RET C           ; Return if the player is still in the room.
 $CB03 LD (IX+$01),$FF ; Set the X coordinate to #N$FF.
 $CB07 LD A,(IX+$08)   ; {Fetch the room number and stash it in #REGl.
 $CB0A LD L,A          ; }
 $CB0B INC A           ; Go to the room to the east.
 $CB0C JR $CAB3        ; Jump to #R$CAB3.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C3F0 }
; LIST#

; Leave Room To The North
;
; Sends the player to the room to the north if it has gone past the north
; edge of the room. The Y coordinate is set to #N$FF, which #R$D320 takes as the
; sign that the player has come out of the north, and so puts it at the south
; side of the new room.
;
; HL The size of the room in X and Y
; IX Address of the object
@label=LeaveRoomToNorth
c$CB0E POP HL          ; Unstack the size of the room in X and Y.
 $CB0F LD A,H          ; {Work out the coordinate of the north edge of the
 $CB10 ADD A,$80       ; room.
 $CB12 LD H,A          ; }
 $CB13 LD A,(IX+$02)   ; {Add the speed in Y to the Y coordinate, and take the depth of the
 $CB16 ADD A,(IX+$0A)  ; player off it.
 $CB19 SUB (IX+$05)    ; }
 $CB1C CP H            ; Compare it with the north edge.
 $CB1D RET C           ; Return if the player is still in the room.
 $CB1E LD (IX+$02),$FF ; Set the Y coordinate to #N$FF.
 $CB22 LD A,(IX+$08)   ; {Fetch the room number and add #N$10 to go to the room
 $CB25 ADD A,$10       ; to the north.}
 $CB27 JR $CABA        ; Jump to #R$CABA.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C40B }
; LIST#

; Leave Room To The South
;
; Sends the player to the room to the south if it has gone past the south
; edge of the room. The Y coordinate is set to #N$00, which #R$D320 takes as the
; sign that the player has come out of the south, and so puts it at the north
; side of the new room.
;
; HL The size of the room in X and Y
; IX Address of the object
@label=LeaveRoomToSouth
c$CB29 POP HL          ; Unstack the size of the room in X and Y.
 $CB2A LD A,$80        ; {Work out the coordinate of the south edge of the
 $CB2C SUB H           ; room.
 $CB2D LD H,A          ; }
 $CB2E LD A,(IX+$02)   ; {Add the speed in Y and the depth of the player to the
 $CB31 ADD A,(IX+$0A)  ; Y coordinate.
 $CB34 ADD A,(IX+$05)  ; }
 $CB37 CP H            ; Compare it with the south edge.
 $CB38 RET NC          ; Return if the player is still in the room.
 $CB39 LD (IX+$02),$00 ; Set the Y coordinate to #N$00.
 $CB3D LD A,(IX+$08)   ; {Fetch the room number and take #N$10 off it to go to the room to the
 $CB40 SUB $10         ; south.}
 $CB42 JP $CABA        ; Jump to #R$CABA.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C426 }
; LIST#

; Block Movement
;
; Used by the routines at #R$C700 and #R$C9A1.
; .
; Stops an object moving through the walls of the room or through other
; objects. The speeds in X, Y and Z of the object are each brought closer to
; zero until the object can move without hitting anything. Whichever direction
; is hit is flagged in the low bits of the flags in byte #N$0C of the object:
; bit 0 for X, bit 1 for Y and bit 2 for Z. For the Z direction that means that
; the object is standing on something. An object that is flagged to be ignored
; in the 3D calculations is not adjusted.
;
; IX Address of the object
@label=BlockMovement
c$CB45 BIT 1,(IX+$07) ; Test whether the object is flagged to be ignored.
 $CB49 RET NZ         ; Return if it is.
 $CB4A SET 1,(IX+$07) ; Flag the object to be ignored, so that it does not hit
                      ; itself.
 $CB4E LD A,(IX+$0C)  ; Fetch the flags.
 $CB51 AND %11111000  ; Clear the blocked flags of X, Y and Z.
 $CB53 LD (IX+$0C),A  ; Store the flags.
 $CB56 LD L,$00       ; Set the new speed in Y to zero.
 $CB58 LD C,L         ; Set the new speed in X to zero.
; The new speeds are kept in #REGh for Z, #REGc for X and #REGl for Y. The
; Z direction goes first, and the floor of the room is tried before the objects.
 $CB59 LD A,(IX+$0B)  ; Fetch the speed in Z.
 $CB5C AND A          ; Test whether it is zero.
 $CB5D LD H,A         ; Stash it in #REGh.
 $CB5E JR Z,$CB6A     ; Jump to #R$CB6A if it is zero.
 $CB60 CALL $CA5A     ; Stop the object going through the floor.
 $CB63 LD A,H         ; {Test whether the speed in Z is now zero.
 $CB64 AND A          ; }
 $CB65 JR Z,$CB6A     ; Jump to #R$CB6A if it is.
 $CB67 CALL $CC38     ; Stop the object going through other objects.
@label=BlockMovement_X
*$CB6A LD A,(IX+$09)  ; {Fetch the speed in X and test whether it is zero.
 $CB6D AND A          ; }
 $CB6E LD C,A         ; Stash it in #REGc.
 $CB6F JR Z,$CB7B     ; Jump to #R$CB7B if it is zero.
 $CB71 CALL $CCDD     ; Stop the object going through the walls of the room.
 $CB74 LD A,C         ; {Test whether the speed in X is now zero.
 $CB75 AND A          ; }
 $CB76 JR Z,$CB7B     ; Jump to #R$CB7B if it is.
 $CB78 CALL $CB9A     ; Stop the object going through other objects.
@label=BlockMovement_Y
*$CB7B LD A,(IX+$0A)  ; {Fetch the speed in Y and test whether it is zero.
 $CB7E AND A          ; }
 $CB7F LD L,A         ; Stash it in #REGl.
 $CB80 JR Z,$CB8C     ; Jump to #R$CB8C if it is zero.
 $CB82 CALL $CD08     ; Stop the object going through the walls of the room.
 $CB85 LD A,L         ; {Test whether the speed in Y is now zero.
 $CB86 AND A          ; }
 $CB87 JR Z,$CB8C     ; Jump to #R$CB8C if it is.
 $CB89 CALL $CBE9     ; Stop the object going through other objects.
@label=BlockMovement_Store
*$CB8C LD (IX+$09),C  ; Store the new speed in X.
 $CB8F LD (IX+$0A),L  ; Store the new speed in Y.
 $CB92 LD (IX+$0B),H  ; Store the new speed in Z.
 $CB95 RES 1,(IX+$07) ; Stop ignoring the object.
 $CB99 RET            ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C442 }
; { #PENTAGRAM$B6ED }
; LIST#

; Block Movement In X
;
; Used by the routine at #R$CB45.
; .
; Brings the speed in X of an object closer to zero until it does not run
; into any other object. If the object does run into another, the objects may
; destroy each other: bit 7 of the flags in byte #N$0D of an object means that
; it destroys whatever it runs into, bit 5 means that it destroys whatever runs
; into it, and bit 6 means that the object is destroyed. An object that can be
; moved is pushed along at the same speed in X.
;
;   C Speed in X
;   L Speed in Y
;   H Speed in Z
;   IX Address of the object
; O:C The new speed in X
@label=BlockMovementInX
c$CB9A LD IY,$5C08    ; Point #REGiy at the first object in the table.
 $CB9E LD B,$28       ; Set the number of objects to #N$28.
@label=BlockMovementInX_Next
*$CBA0 CALL $B538     ; Test whether the object is present and not ignored.
 $CBA3 JR Z,$CBE1     ; Jump to #R$CBE1 if it is not.
 $CBA5 CALL $CCB2     ; Test whether the objects overlap in Y.
 $CBA8 JR NC,$CBE1    ; Jump to #R$CBE1 if they do not.
 $CBAA CALL $CCC7     ; Test whether the objects overlap in Z.
 $CBAD JR NC,$CBE1    ; Jump to #R$CBE1 if they do not.
@label=BlockMovementInX_Test
*$CBAF CALL $CC9D     ; Test whether the objects overlap in X after the move.
 $CBB2 JR NC,$CBE1    ; Jump to #R$CBE1 if they do not.
 $CBB4 SET 0,(IX+$0C) ; Flag the object as blocked in X.
 $CBB8 LD A,(IX+$0D)  ; {Fetch the flags of the object and move the bit that it destroys what
 $CBBB RRCA           ; it hits into bit 6.}
 $CBBC AND %01000000  ; Keep the bit that flags the other object as destroyed.
 $CBBE OR (IY+$0D)    ; {Set it in the flags of the other object, if the object destroys what
 $CBC1 LD (IY+$0D),A  ; it runs into.}
 $CBC4 RLCA           ; Move the bit that the other object destroys what it
                      ; hits into bit 6.
 $CBC5 AND %01000000  ; Keep the bit that flags the object as destroyed.
 $CBC7 OR (IX+$0D)    ; {Set it in the flags of the object, if the other object destroys what
 $CBCA LD (IX+$0D),A  ; runs into it.}
 $CBCD BIT 2,(IY+$07) ; {Jump to #R$CBD9 if the other object cannot be moved.
 $CBD1 JR Z,$CBD9     ; }
 $CBD3 LD A,(IX+$09)  ; Fetch the speed in X of the object.
 $CBD6 LD (IY+$09),A  ; Give it to the other object.
@label=BlockMovementInX_Slow
*$CBD9 LD A,C         ; Fetch the speed in X.
 $CBDA CALL $CA89     ; Bring it closer to zero.
 $CBDD LD C,A         ; Store it.
 $CBDE RET Z          ; Return if it is zero.
 $CBDF JR $CBAF       ; Jump back to #R$CBAF to test it again.
@label=BlockMovementInX_Advance
*$CBE1 LD DE,$0020    ; Set #REGde to the size of an object.
 $CBE4 ADD IY,DE      ; Point #REGiy at the next object.
 $CBE6 DJNZ $CBA0     ; Jump back to #R$CBA0 until all of the objects have been
                      ; tested.
 $CBE8 RET            ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C497 }
; { #PENTAGRAM$B742 }
; LIST#

; Block Movement In Y
;
; Used by the routine at #R$CB45.
; .
; Brings the speed in Y of an object closer to zero until it does not run
; into any other object. This works in the same way as #R$CB9A.
;
;   C Speed in X
;   L Speed in Y
;   H Speed in Z
;   IX Address of the object
; O:L The new speed in Y
@label=BlockMovementInY
c$CBE9 LD IY,$5C08    ; Point #REGiy at the first object in the table.
 $CBED LD B,$28       ; Set the number of objects to #N$28.
@label=BlockMovementInY_Next
*$CBEF CALL $B538     ; Test whether the object is present and not ignored.
 $CBF2 JR Z,$CC30     ; Jump to #R$CC30 if it is not.
 $CBF4 CALL $CC9D     ; Test whether the objects overlap in X.
 $CBF7 JR NC,$CC30    ; Jump to #R$CC30 if they do not.
 $CBF9 CALL $CCC7     ; Test whether the objects overlap in Z.
 $CBFC JR NC,$CC30    ; Jump to #R$CC30 if they do not.
@label=BlockMovementInY_Test
*$CBFE CALL $CCB2     ; Test whether the objects overlap in Y after the move.
 $CC01 JR NC,$CC30    ; Jump to #R$CC30 if they do not.
 $CC03 SET 1,(IX+$0C) ; Flag the object as blocked in Y.
 $CC07 LD A,(IX+$0D)  ; {Fetch the flags of the object and move the bit that it destroys what
 $CC0A RRCA           ; it hits into bit 6.}
 $CC0B AND %01000000  ; Keep the bit that flags the other object as destroyed.
 $CC0D OR (IY+$0D)    ; {Set it in the flags of the other object, if the object destroys what
 $CC10 LD (IY+$0D),A  ; it runs into.}
 $CC13 RLCA           ; Move the bit that the other object destroys what it
                      ; hits into bit 6.
 $CC14 AND %01000000  ; Keep the bit that flags the object as destroyed.
 $CC16 OR (IX+$0D)    ; {Set it in the flags of the object, if the other object destroys what
 $CC19 LD (IX+$0D),A  ; runs into it.}
 $CC1C BIT 2,(IY+$07) ; {Jump to #R$CC28 if the other object cannot be moved.
 $CC20 JR Z,$CC28     ; }
 $CC22 LD A,(IX+$0A)  ; Fetch the speed in Y of the object.
 $CC25 LD (IY+$0A),A  ; Give it to the other object.
@label=BlockMovementInY_Slow
*$CC28 LD A,L         ; Fetch the speed in Y.
 $CC29 CALL $CA89     ; Bring it closer to zero.
 $CC2C LD L,A         ; Store it.
 $CC2D RET Z          ; Return if it is zero.
 $CC2E JR $CBFE       ; Jump back to #R$CBFE to test it again.
@label=BlockMovementInY_Advance
*$CC30 LD DE,$0020    ; Set #REGde to the size of an object.
 $CC33 ADD IY,DE      ; Point #REGiy at the next object.
 $CC35 DJNZ $CBEF     ; Jump back to #R$CBEF until all of the objects have been
                      ; tested.
 $CC37 RET            ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C4E6 }
; { #PENTAGRAM$B791 }
; LIST#

; Block Movement In Z
;
; Used by the routine at #R$CB45.
; .
; Brings the speed in Z of an object closer to zero until it does not run
; into any other object. This works in the same way as #R$CB9A, except that the
; object that is hit is flagged as triggered (bit 3 of its flags in byte #N$0D)
; as something is standing on it. An object that can be moved takes on the
; speeds in X and Y of the object that it stands on, if it has none of its own.
;
;   C Speed in X
;   L Speed in Y
;   H Speed in Z
;   IX Address of the object
; O:H The new speed in Z
@label=BlockMovementInZ
c$CC38 LD IY,$5C08    ; Point #REGiy at the first object in the table.
 $CC3C LD B,$28       ; Set the number of objects to #N$28.
@label=BlockMovementInZ_Next
*$CC3E CALL $B538     ; Test whether the object is present and not ignored.
 $CC41 JR Z,$CC95     ; Jump to #R$CC95 if it is not.
 $CC43 CALL $CC9D     ; Test whether the objects overlap in X.
 $CC46 JR NC,$CC95    ; Jump to #R$CC95 if they do not.
 $CC48 CALL $CCB2     ; Test whether the objects overlap in Y.
 $CC4B JR NC,$CC95    ; Jump to #R$CC95 if they do not.
@label=BlockMovementInZ_Test
*$CC4D CALL $CCC7     ; Test whether the objects overlap in Z after the move.
 $CC50 JR NC,$CC95    ; Jump to #R$CC95 if they do not.
 $CC52 SET 2,(IX+$0C) ; Flag the object as blocked in Z.
 $CC56 LD A,(IX+$0D)  ; {Fetch the flags of the object and move the bit that it destroys what
 $CC59 RRCA           ; it hits into bit 6.}
 $CC5A AND %01000000  ; Keep the bit that flags the other object as destroyed.
 $CC5C OR (IY+$0D)    ; {Set it in the flags of the other object, if the object destroys what
 $CC5F LD (IY+$0D),A  ; it runs into.}
 $CC62 RLCA           ; Move the bit that the other object destroys what it
                      ; hits into bit 6.
 $CC63 AND %01000000  ; Keep the bit that flags the object as destroyed.
 $CC65 OR (IX+$0D)    ; {Set it in the flags of the object, if the other object destroys what
 $CC68 LD (IX+$0D),A  ; runs into it.}
 $CC6B SET 3,(IY+$0D) ; Flag the other object as triggered.
 $CC6F BIT 2,(IX+$07) ; {Jump to #R$CC8D if the object cannot be moved.
 $CC73 JR Z,$CC8D     ; }
 $CC75 LD A,(IX+$09)  ; {Fetch the speed in X of the object and test it.
 $CC78 AND A          ; }
 $CC79 JR NZ,$CC81    ; Jump to #R$CC81 if it has one.
 $CC7B LD A,(IY+$09)  ; {Take the speed in X of the other object.
 $CC7E LD (IX+$09),A  ; }
@label=BlockMovementInZ_Y
*$CC81 LD A,(IX+$0A)  ; {Fetch the speed in Y of the object and test it.
 $CC84 AND A          ; }
 $CC85 JR NZ,$CC8D    ; Jump to #R$CC8D if it has one.
 $CC87 LD A,(IY+$0A)  ; {Take the speed in Y of the other object.
 $CC8A LD (IX+$0A),A  ; }
@label=BlockMovementInZ_Slow
*$CC8D LD A,H         ; Fetch the speed in Z.
 $CC8E CALL $CA89     ; Bring it closer to zero.
 $CC91 LD H,A         ; Store it.
 $CC92 RET Z          ; Return if it is zero.
 $CC93 JR $CC4D       ; Jump back to #R$CC4D to test it again.
@label=BlockMovementInZ_Advance
*$CC95 LD DE,$0020    ; Set #REGde to the size of an object.
 $CC98 ADD IY,DE      ; Point #REGiy at the next object.
 $CC9A DJNZ $CC3E     ; Jump back to #R$CC3E until all of the objects have been
                      ; tested.
 $CC9C RET            ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C535 }
; LIST#

; Test Overlap In X
;
; Used by the routines at #R$B4FD, #R$C172, #R$CB9A, #R$CBE9 and #R$CC38.
; .
; Tests whether two objects overlap in X, once the first has moved by its
; new speed in X. They overlap when the distance between the X coordinates is
; smaller than the two widths added together.
;
;   C New speed in X of the first object
;   IX Address of the first object
;   IY Address of the second object
; O:F The carry flag is set if the objects overlap
@label=TestOverlapInX
c$CC9D LD A,(IX+$04)  ; {Add the width of the first object to the width of the
 $CCA0 ADD A,(IY+$04) ; second object.}
 $CCA3 LD D,A         ; Stash the total in #REGd.
 $CCA4 LD A,(IX+$01)  ; {Take the X coordinate of the second object off the X coordinate of
 $CCA7 ADD A,C        ; the first object plus the new speed.
 $CCA8 SUB (IY+$01)   ; }
 $CCAB JP P,$CCB0     ; Jump to #R$CCB0 if it is not negative.
 $CCAE NEG            ; Make it positive.
@label=TestOverlapInX_TakeWidths
*$CCB0 SUB D          ; Take the total widths off it, which sets the carry flag if the
                      ; objects overlap.
 $CCB1 RET            ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C5A9 }
; { #PENTAGRAM$B8A2 }
; LIST#

; Test Overlap In Y
;
; Used by the routines at #R$B4FD, #R$C172, #R$CB9A, #R$CBE9 and #R$CC38.
; .
; Tests whether two objects overlap in Y, once the first has moved by its
; new speed in Y. They overlap when the distance between the Y coordinates is
; smaller than the two depths added together.
;
;   L New speed in Y of the first object
;   IX Address of the first object
;   IY Address of the second object
; O:F The carry flag is set if the objects overlap
@label=TestOverlapInY
c$CCB2 LD A,(IX+$05)  ; {Add the depth of the first object to the depth of the
 $CCB5 ADD A,(IY+$05) ; second object.}
 $CCB8 LD D,A         ; Stash the total in #REGd.
 $CCB9 LD A,(IX+$02)  ; {Take the Y coordinate of the second object off the Y coordinate of
 $CCBC ADD A,L        ; the first object plus the new speed.
 $CCBD SUB (IY+$02)   ; }
 $CCC0 JP P,$CCC5     ; Jump to #R$CCC5 if it is not negative.
 $CCC3 NEG            ; Make it positive.
@label=TestOverlapInY_TakeDepths
*$CCC5 SUB D          ; Take the total depths off it, which sets the carry flag if the
                      ; objects overlap.
 $CCC6 RET            ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C5BE }
; { #PENTAGRAM$B8B7 }
; LIST#

; Test Overlap In Z
;
; Used by the routines at #R$B4FD, #R$C172, #R$CB9A, #R$CBE9 and #R$CC38.
; .
; Tests whether two objects overlap in Z, once the first has moved by its
; new speed in Z. They overlap when the distance between the Z coordinates is
; smaller than the height of whichever of the objects is lower.
;
;   H New speed in Z of the first object
;   IX Address of the first object
;   IY Address of the second object
; O:F The carry flag is set if the objects overlap
@label=TestOverlapInZ
c$CCC7 LD A,(IX+$03) ; {Take the Z coordinate of the second object off the Z coordinate of
 $CCCA ADD A,H       ; the first object plus the new speed.
 $CCCB SUB (IY+$03)  ; }
 $CCCE JP P,$CCD8    ; Jump to #R$CCD8 if it is not negative.
 $CCD1 NEG           ; Make it positive.
 $CCD3 LD D,(IX+$06) ; Fetch the height of the first object, which is the
                     ; lower.
@label=TestOverlapInZ_Compare
*$CCD6 SUB D         ; Take the height off it, which sets the carry flag if the objects
                     ; overlap.
 $CCD7 RET           ; Return.
@label=TestOverlapInZ_Second
*$CCD8 LD D,(IY+$06) ; Fetch the height of the second object, which is the
                     ; lower.
 $CCDB JR $CCD6      ; Jump to #R$CCD6.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C5D3 }
; { #PENTAGRAM$B8CC }
; LIST#

; Keep Object In Room In X
;
; Used by the routine at #R$CB45.
; .
; Brings the speed in X of an object closer to zero until the object stays
; within the walls of the room. Nothing is done while the object is entering the
; room, or while it is near an arch, as it can then go out through the wall.
;
;   C Speed in X
;   IX Address of the object
; O:C The new speed in X
@label=KeepObjectInRoomInX
c$CCDD LD A,(IX+$0C)  ; Fetch the flags of the object.
 $CCE0 AND %11110000  ; Keep the counter of the object entering the room.
 $CCE2 RET NZ         ; Return if the object is entering the room.
 $CCE3 BIT 0,(IX+$07) ; Test whether the object is near an arch.
 $CCE7 RET NZ         ; Return if it is.
 $CCE8 LD A,($5BAB)   ; {Fetch the size of the room in X and stash it in #REGb.
 $CCEB LD B,A         ; }
@label=KeepObjectInRoomInX_Test
*$CCEC LD A,(IX+$01)  ; {Work out where the X coordinate would be, with the
 $CCEF ADD A,C        ; speed added.
 $CCF0 SUB $80        ; }
 $CCF2 JR NC,$CCF6    ; Jump to #R$CCF6 if it is not negative.
 $CCF4 NEG            ; Make it positive.
@label=KeepObjectInRoomInX_Test_AddWidth
*$CCF6 ADD A,(IX+$04) ; Add the width of the object.
 $CCF9 CP B           ; Compare it with the size of the room.
 $CCFA JR C,$CD07     ; Return if it is smaller, as the object stays in the
                      ; room.
 $CCFC SET 0,(IX+$0C) ; Flag the object as blocked in X.
 $CD00 LD A,C         ; Fetch the speed in X.
 $CD01 CALL $CA89     ; Bring it closer to zero.
 $CD04 LD C,A         ; Store it.
 $CD05 JR NZ,$CCEC    ; Jump back to #R$CCEC if it is not zero yet.
@label=KeepObjectInRoomInX_Test_Return
*$CD07 RET            ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C5E9 }
; { #PENTAGRAM$B8E2 }
; LIST#

; Keep Object In Room In Y
;
; Used by the routine at #R$CB45.
; .
; Brings the speed in Y of an object closer to zero until the object stays
; within the walls of the room. Nothing is done while the object is entering the
; room, or while it is near an arch, as it can then go out through the wall.
;
;   L Speed in Y
;   IX Address of the object
; O:L The new speed in Y
@label=KeepObjectInRoomInY
c$CD08 LD A,(IX+$0C)  ; Fetch the flags of the object.
 $CD0B AND %11110000  ; Keep the counter of the object entering the room.
 $CD0D RET NZ         ; Return if the object is entering the room.
 $CD0E BIT 0,(IX+$07) ; Test whether the object is near an arch.
 $CD12 RET NZ         ; Return if it is.
 $CD13 LD A,($5BAC)   ; {Fetch the size of the room in Y and stash it in #REGb.
 $CD16 LD B,A         ; }
@label=KeepObjectInRoomInY_Test
*$CD17 LD A,(IX+$02)  ; {Work out where the Y coordinate would be, with the
 $CD1A ADD A,L        ; speed added.
 $CD1B SUB $80        ; }
 $CD1D JR NC,$CD21    ; Jump to #R$CD21 if it is not negative.
 $CD1F NEG            ; Make it positive.
@label=KeepObjectInRoomInY_Test_AddDepth
*$CD21 ADD A,(IX+$05) ; Add the depth of the object.
 $CD24 CP B           ; Compare it with the size of the room.
 $CD25 JR C,$CD32     ; Return if it is smaller, as the object stays in the
                      ; room.
 $CD27 SET 1,(IX+$0C) ; Flag the object as blocked in Y.
 $CD2B LD A,L         ; Fetch the speed in Y.
 $CD2C CALL $CA89     ; Bring it closer to zero.
 $CD2F LD L,A         ; Store it.
 $CD30 JR NZ,$CD17    ; Jump back to #R$CD17 if it is not zero yet.
@label=KeepObjectInRoomInY_Test_Return
*$CD32 RET            ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C613 }
; { #PENTAGRAM$B90D }
; LIST#

; Calculate Sprite Size
;
; Used by the routine at #R$CD4D.
; .
; Works out where an object is on the screen and how much of the screen
; its sprite covers. The width in bytes is one more than the width of the sprite
; if the sprite does not start on a byte boundary, because it has to be shifted
; across.
;
; IX Address of the object
@label=CalculateSpriteSize
c$CD33 CALL $D6C9    ; Work out the pixel coordinates of the object.
 $CD36 CALL $D6EF    ; Find the sprite of the object, and flip it if it needs
                     ; it.
 $CD39 LD A,(IX+$1A) ; Fetch the pixel X coordinate.
 $CD3C AND %00000111 ; Keep the offset of the bit within the byte.
 $CD3E LD A,(DE)     ; Fetch the width of the sprite in bytes.
 $CD3F INC DE        ; Point #REGde at the height of the sprite.
 $CD40 JR Z,$CD43    ; Jump to #R$CD43 if the sprite starts on a byte boundary.
 $CD42 INC A         ; Add one byte to the width.
@label=CalculateSpriteSize_Store
*$CD43 AND %00001111 ; Keep the low nibble of the width.
 $CD45 LD (IX+$18),A ; Store the width in bytes.
 $CD48 LD A,(DE)     ; Fetch the height of the sprite in lines.
 $CD49 LD (IX+$19),A ; Store the height in lines.
 $CD4C RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C63D }
; { #PENTAGRAM$B938 }
; LIST#

; Flag Overlapping Objects
;
; Used by the routines at #R$C692 and #R$CDE2.
; .
; Flags every object that overlaps the area of the screen covered by an
; object to be drawn again. The area is the one that is covered by the old and
; the new position of the sprite of the object together, so that the whole of it
; is redrawn.
;
; IX Address of the object
@label=FlagOverlappingObjects
c$CD4D LD IY,$5C08    ; Point #REGiy at the first object in the table.
 $CD51 CALL $CD33     ; Work out where the object is on the screen, and how big
                      ; it is.
 $CD54 LD B,$28       ; Set the number of objects to #N$28.
; The left edge of the area, in bytes of the screen, is the lower of the
; byte of the old and of the new position. It is kept in #REGe.
 $CD56 LD A,(IX+$1A)  ; Fetch the new pixel X coordinate of the object.
 $CD59 RRCA           ; {Divide it by eight.
 $CD5A RRCA           ;
 $CD5B RRCA           ; }
 $CD5C AND %00011111  ; Keep the byte of the screen.
 $CD5E LD L,A         ; Stash it in #REGl.
 $CD5F LD A,(IX+$1E)  ; Fetch the old pixel X coordinate of the object.
 $CD62 RRCA           ; {Divide it by eight.
 $CD63 RRCA           ;
 $CD64 RRCA           ; }
 $CD65 AND %00011111  ; Keep the byte of the screen.
 $CD67 LD H,A         ; Stash it in #REGh.
 $CD68 CP L           ; Compare the old with the new.
 $CD69 JR C,$CD6C     ; Jump to #R$CD6C if the old is lower.
 $CD6B LD A,L         ; Take the new one instead.
@label=FlagOverlappingObjects_RightEdge
*$CD6C LD E,A         ; Stash the left edge in #REGe.
; The width of the area is the higher of the right edge of the old and of
; the new position, less the left edge. It is kept in #REGd.
 $CD6D LD A,L         ; Fetch the new byte of the screen.
 $CD6E ADD A,(IX+$18) ; Add the width of the new position.
 $CD71 LD L,A         ; Stash the right edge in #REGl.
 $CD72 LD A,H         ; Fetch the old byte of the screen.
 $CD73 ADD A,(IX+$1C) ; Add the width of the old position.
 $CD76 CP L           ; Compare it with the new right edge.
 $CD77 JR NC,$CD7A    ; Jump to #R$CD7A if it is higher.
 $CD79 LD A,L         ; Take the new one instead.
@label=FlagOverlappingObjects_AreaWidth
*$CD7A SUB E          ; Take the left edge off it.
 $CD7B LD D,A         ; Stash the width of the area in #REGd.
; The bottom edge of the area is the lower of the old and the new pixel Y
; coordinate. It is kept in #REGl.
 $CD7C LD A,(IX+$1B)  ; Fetch the new pixel Y coordinate.
 $CD7F CP (IX+$1F)    ; Compare it with the old one.
 $CD82 JR C,$CD87     ; Jump to #R$CD87 if the new one is lower.
 $CD84 LD A,(IX+$1F)  ; Take the old one instead.
@label=FlagOverlappingObjects_TopEdge
*$CD87 LD L,A         ; Stash the bottom edge in #REGl.
; The height of the area is the higher of the top edge of the old and of
; the new position, less the bottom edge. It is kept in #REGh.
 $CD88 LD A,(IX+$1B)  ; Fetch the new pixel Y coordinate.
 $CD8B ADD A,(IX+$19) ; Add the height of the new position.
 $CD8E LD H,A         ; Stash the top edge in #REGh.
 $CD8F LD A,(IX+$1F)  ; Fetch the old pixel Y coordinate.
 $CD92 ADD A,(IX+$1D) ; Add the height of the old position.
 $CD95 CP H           ; Compare it with the new top edge.
 $CD96 JR NC,$CD99    ; Jump to #R$CD99 if it is higher.
 $CD98 LD A,H         ; Take the new one instead.
@label=FlagOverlappingObjects_AreaHeight
*$CD99 SUB L          ; Take the bottom edge off it.
 $CD9A LD H,A         ; Stash the height of the area in #REGh.
@label=FlagOverlappingObjects_Next
*$CD9B LD A,(IY+$00)  ; Fetch the graphic number of the other object.
 $CD9E AND A          ; Test whether it is null.
 $CD9F JR Z,$CDC2     ; Jump to #R$CDC2 if it is.
 $CDA1 BIT 4,(IY+$07) ; {Jump to #R$CDC2 if the other object is already flagged
 $CDA5 JR NZ,$CDC2    ; to be drawn.}
 $CDA7 LD A,(IY+$1A)  ; Fetch the pixel X coordinate of the other object.
 $CDAA RRCA           ; {Divide it by eight.
 $CDAB RRCA           ;
 $CDAC RRCA           ; }
 $CDAD AND %00011111  ; Keep the byte of the screen.
 $CDAF SUB E          ; Take the left edge of the area off it.
 $CDB0 JR C,$CDCC     ; Jump to #R$CDCC if the object starts to the left of the
                      ; area.
@label=FlagOverlappingObjects_Right
 $CDB2 CP D           ; Compare it with the width of the area.
@label=FlagOverlappingObjects_Right_Test
*$CDB3 JR NC,$CDC2    ; Jump to #R$CDC2 if the object starts to the right of
                      ; the area.
 $CDB5 LD A,(IY+$1B)  ; Fetch the pixel Y coordinate of the other object.
 $CDB8 SUB L          ; Take the bottom edge of the area off it.
 $CDB9 JR C,$CDD3     ; Jump to #R$CDD3 if the object starts below the area.
@label=FlagOverlappingObjects_Top
 $CDBB CP H           ; Compare it with the height of the area.
@label=FlagOverlappingObjects_Top_Test
*$CDBC JR NC,$CDC2    ; Jump to #R$CDC2 if the object starts above the area.
 $CDBE SET 4,(IY+$07) ; Flag the other object to be drawn.
@label=FlagOverlappingObjects_Advance
*$CDC2 EXX            ; Switch to the alternate registers.
 $CDC3 LD DE,$0020    ; Set #REGde to the size of an object.
 $CDC6 ADD IY,DE      ; Point #REGiy at the next object.
 $CDC8 EXX            ; Switch back to the main registers.
 $CDC9 DJNZ $CD9B     ; Jump back to #R$CD9B until all of the objects have been
                      ; tested.
 $CDCB RET            ; Return.
; The object starts to the left of the area, so it overlaps only if it is
; wide enough to reach the area.
@label=FlagOverlappingObjects_Left
*$CDCC NEG            ; Make the distance positive.
 $CDCE CP (IY+$18)    ; Compare it with the width of the sprite of the other
                      ; object.
 $CDD1 JR $CDB3       ; Jump to #R$CDB3.
; The object starts below the area, so it overlaps only if it is tall
; enough to reach the area.
@label=FlagOverlappingObjects_Below
*$CDD3 NEG            ; Make the distance positive.
 $CDD5 CP (IY+$19)    ; Compare it with the height of the sprite of the other
                      ; object.
 $CDD8 JR $CDBC       ; Jump to #R$CDBC.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C657 }
; { #PENTAGRAM$B9A7 }
; LIST#

; Handle Human Top
;
; Handles the top half of the player while it is in the form of a human,
; which is the graphic numbers #N$20 to #N$2F.
;
; IX Address of the object
@label=HandleHumanTop
c$CDDA CALL $C4F7    ; Set the pixel adjustments of the top half of a human.
 $CDDD JR $CDE2      ; Jump to #R$CDE2.

; Handle Wulf Top
;
; Handles the top half of the player while it is in the form of a wulf,
; which is the graphic numbers #N$40 to #N$4F.
;
; IX Address of the object
@label=HandleWulfTop
c$CDDF CALL $C501    ; Set the pixel adjustments of the top half of a wulf.
; View the equivalent code in;
; #LIST
; { #PENTAGRAM$C5D3 }
; LIST#

; Handle Player Top
;
; Used by the routine at #R$CDDA.
; .
; Does all of the work for the top half of the player, which is a copy of
; the bottom half, placed #N$0C above it. The top half has no height, and is
; ignored in the 3D calculations. If it has been flagged as dead, this starts
; the death sparkles. Every so often the player looks to one side or the other:
; this picks a head that looks that way and keeps it for eight frames.
;
; IX Address of the object
@label=HandlePlayerTop
c$CDE2 LD A,($5BC3)    ; {Fetch the final animation flag.
 $CDE5 AND A           ; }
 $CDE6 JR NZ,$CDEF     ; Jump to #R$CDEF if it is set.
 $CDE8 BIT 6,(IX+$0D)  ; {Jump to #R$BF21 to start the death sparkles if the top half is
 $CDEC JP NZ,$BF21     ; flagged as dead.}
@label=HandlePlayerTop_Copy
*$CDEF PUSH IX         ; {Point #REGde at the top half.
 $CDF1 POP DE          ; }
 $CDF2 LD HL,$FFE0     ; {Point #REGhl at the bottom half, which is #N$20 bytes
 $CDF5 ADD HL,DE       ; before.}
 $CDF6 PUSH HL         ; {Point #REGiy at the bottom half.
 $CDF7 POP IY          ; }
 $CDF9 INC DE          ; Point #REGde at the X coordinate of the top half.
 $CDFA INC HL          ; Point #REGhl at the X coordinate of the bottom half.
 $CDFB LD BC,$0007     ; Set the number of bytes to #N$07.
 $CDFE LDIR            ; Copy the coordinates, the size and the flags.
 $CE00 LD (IX+$06),$00 ; Set the height of the top half to zero.
 $CE04 SET 1,(IX+$07)  ; Flag the top half to be ignored in the 3D
                       ; calculations.
 $CE08 LD A,(IX+$0D)   ; Fetch the flags.
 $CE0B AND %00001111   ; Keep the counter for looking to one side.
 $CE0D JR Z,$CE14      ; Jump to #R$CE14 if the counter has run out.
 $CE0F DEC (IX+$0D)    ; Count it down.
 $CE12 JR $CE27        ; Jump to #R$CE27.
@label=HandlePlayerTop_Look
*$CE14 LD A,($5BA5)    ; Fetch a random number.
 $CE17 CP $02          ; {Jump to #R$CE33 if it is less than #N$02.
 $CE19 JR C,$CE33      ; }
 $CE1B CP $FE          ; {Jump to #R$CE40 if it is at least #N$FE.
 $CE1D JR NC,$CE40     ; }
 $CE1F LD A,(IY+$00)   ; Fetch the graphic number of the bottom half.
@label=HandlePlayerTop_SetGraphic
*$CE22 ADD A,$10       ; Add #N$10 to it to get the graphic number of the top
                       ; half.
 $CE24 LD (IX+$00),A   ; Set the graphic number of the top half.
@label=HandlePlayerTop_SetZ
*$CE27 LD A,(IY+$03)   ; Fetch the Z coordinate of the bottom half.
 $CE2A ADD A,$0C       ; Add #N$0C to it.
 $CE2C LD (IX+$03),A   ; Set the Z coordinate of the top half.
 $CE2F CALL $CD4D      ; Flag the objects that overlap the player to be drawn.
 $CE32 RET             ; Return.
@label=HandlePlayerTop_LookOneWay
*$CE33 LD A,(IY+$00)   ; Fetch the graphic number of the bottom half.
 $CE36 AND %11111000   ; Keep the direction the player is facing.
 $CE38 OR %00000110    ; Choose the head that looks one way.
@label=HandlePlayerTop_SetCounter
*$CE3A LD (IX+$0D),$08 ; Make the player look that way for eight frames.
 $CE3E JR $CE22        ; Jump to #R$CE22.
@label=HandlePlayerTop_LookOtherWay
*$CE40 LD A,(IY+$00)   ; Fetch the graphic number of the bottom half.
 $CE43 AND %11111000   ; Keep the direction the player is facing.
 $CE45 OR %00000111    ; Choose the head that looks the other way.
 $CE47 JR $CE3A        ; Jump to #R$CE3A.

; Save Sprite Info
;
; Used by the routine at #R$AFBA.
; .
; Keeps the size and the pixel coordinates of the sprite of an object as
; its old values, so that the area that it covered can be redrawn when it moves.
;
; IX Address of the object
@label=SaveSpriteInfo
c$CE49 LD A,(IX+$18) ; {Save the width of the sprite in bytes.
 $CE4C LD (IX+$1C),A ; }
 $CE4F LD A,(IX+$19) ; {Save the height of the sprite in lines.
 $CE52 LD (IX+$1D),A ; }
 $CE55 LD A,(IX+$1A) ; {Save the pixel X coordinate.
 $CE58 LD (IX+$1E),A ; }
 $CE5B LD A,(IX+$1B) ; {Save the pixel Y coordinate.
 $CE5E LD (IX+$1F),A ; }
 $CE61 RET           ; Return.

; List Objects To Draw
;
; Used by the routine at #R$AFBA.
; .
; Makes the list at #R$CE8B of the objects that have to be drawn again.
; Each entry is the index of an object in the objects table, and the list ends
; with #N$FF. An object is in the list if it is present and flagged to be drawn.
@label=ListObjectsToDraw
c$CE62 PUSH IX        ; Stash #REGix.
 $CE64 LD B,$28       ; Set the number of objects to #N$28.
 $CE66 LD DE,$0020    ; Set #REGde to the size of an object.
 $CE69 LD IX,$5C08    ; Point #REGix at #R$5C08.
 $CE6D LD HL,$CE8B    ; Point #REGhl at #R$CE8B.
 $CE70 LD C,$00       ; Set the index of the object to zero.
@label=ListObjectsToDraw_Next
*$CE72 LD A,(IX+$00)  ; {Fetch the graphic number of the object and test
 $CE75 AND A          ; whether it is null.}
 $CE76 JR Z,$CE80     ; Jump to #R$CE80 if it is.
 $CE78 BIT 4,(IX+$07) ; {Jump to #R$CE80 if the object is not flagged to be
 $CE7C JR Z,$CE80     ; drawn.}
 $CE7E LD (HL),C      ; Add the index of the object to the list.
 $CE7F INC HL         ; Move on to the next place in the list.
@label=ListObjectsToDraw_Advance
*$CE80 INC C          ; Go to the next index.
 $CE81 ADD IX,DE      ; Point #REGix at the next object.
 $CE83 DJNZ $CE72     ; Jump back to #R$CE72 until all of the objects have been
                      ; tested.
 $CE85 LD A,$FF       ; Fetch the end marker.
 $CE87 LD (HL),A      ; Store it at the end of the list.
 $CE88 POP IX         ; Restore #REGix.
 $CE8A RET            ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C71C }
; { #PENTAGRAM$B531 }
; LIST#

; List Of Objects To Draw
;
; The indexes of the objects that have to be drawn, made by #R$CE62. As an
; object is drawn bit 7 of its entry is set.
@label=ObjectsToDrawList
b$CE8B DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $CE9B DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $CEAB DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00

; Draw Objects In Order
;
; Used by the routine at #R$D59F.
; .
; Draws the objects in the list at #R$CE8B so that the objects at the back
; are drawn before the objects in front of them. It takes the first object in
; the list that has not been drawn yet and compares it with each of the other
; objects that are waiting. If another object has to be drawn first, that object
; takes the place of the first object and is compared with the others in its
; turn. This carries on until an object is found that does not have to wait for
; any other object, and that one is drawn. This is repeated until the list is
; empty. The objects drawn are counted in #R$5BBE.
@label=DrawObjectsInOrder
c$CEBB XOR A          ; {Set the number of objects drawn to zero.
 $CEBC LD ($5BBE),A   ; }
 $CEBF PUSH IX        ; {Stash #REGix and #REGiy.
 $CEC1 PUSH IY        ; }
; This entry point is used by the routines at #R$CFA5 and #R$D000.
@label=DrawObjectsInOrder_First
*$CEC3 LD DE,$CE8B    ; Point #REGde at the list.
@label=DrawObjectsInOrder_FindFirst
*$CEC6 LD A,(DE)      ; Fetch the index of an object from the list.
 $CEC7 INC DE         ; Move on to the next entry.
 $CEC8 CP $FF         ; {Jump to #R$D015 if it is the end of the list.
 $CECA JP Z,$D015     ; }
 $CECD BIT 7,A        ; {Jump back to #R$CEC6 if the object has been drawn.
 $CECF JR NZ,$CEC6    ; }
 $CED1 CALL $D3B5     ; Find the address of the object.
 $CED4 LD ($5BCD),DE  ; Remember the place in the list.
 $CED8 PUSH HL        ; {Point #REGix at the object.
 $CED9 POP IX         ; }
; This entry point is used by the routines at #R$CF9F, #R$CFA5 and #R$CFE1.
@label=DrawObjectsInOrder_FindSecond
*$CEDB LD A,(DE)      ; Fetch the index of another object from the list.
 $CEDC INC DE         ; Move on to the next entry.
 $CEDD CP $FF         ; {Jump to #R$D000 if it is, as nothing has to be drawn before the
 $CEDF JP Z,$D000     ; first object.}
 $CEE2 BIT 7,A        ; {Jump back to #R$CEDB if the object has been drawn.
 $CEE4 JR NZ,$CEDB    ; }
 $CEE6 CALL $D3B5     ; Find the address of the object.
 $CEE9 LD ($5BCF),DE  ; Remember the place in the list.
 $CEED PUSH HL        ; {Point #REGiy at the other object.
 $CEEE POP IY         ; }
 $CEF0 PUSH IX        ; {Stash the address of the first object in #REGbc.
 $CEF2 POP BC         ; }
 $CEF3 AND A          ; Clear the carry flag.
 $CEF4 SBC HL,BC      ; Test whether the other object is the first object.
 $CEF6 JR Z,$CEDB     ; Jump back to #R$CEDB if it is.
; Each of the three directions gives a number. The number in Z is #N$00 if
; the first object is above the other, #N$01 if the objects overlap in Z and
; #N$02 if the first object is below. The number in Y is #N$00 if the first
; object is to the north of the other, #N$03 if the objects overlap in Y and
; #N$06 if the first object is to the south. The number in X is #N$00 if the
; first object is to the east of the other, #N$09 if the objects overlap in X
; and #N$12 if the first object is to the west. The three numbers are added
; together in #REGc.
 $CEF8 LD C,$00       ; Set the number to zero.
 $CEFA LD A,(IY+$03)  ; {Work out where the top of the other object is.
 $CEFD ADD A,(IY+$06) ;
 $CF00 LD L,A         ; }
 $CF01 LD A,(IX+$03)  ; {Take it off the Z coordinate of the first object.
 $CF04 SUB L          ; }
 $CF05 JR NC,$CF16    ; Jump to #R$CF16 if the first object is above the other.
 $CF07 LD A,(IX+$03)  ; {Work out where the top of the first object is.
 $CF0A ADD A,(IX+$06) ;
 $CF0D LD L,A         ; }
 $CF0E LD A,(IY+$03)  ; {Take it off the Z coordinate of the other object.
 $CF11 SUB L          ; }
 $CF12 JR C,$CF15     ; Jump to #R$CF15 if the objects overlap in Z.
 $CF14 INC C          ; Add one to the number in Z.
@label=DrawObjectsInOrder_Overlap
*$CF15 INC C          ; Add one to the number in Z.
@label=DrawObjectsInOrder_Y
*$CF16 LD A,(IY+$02)  ; {Work out where the north edge of the other object is.
 $CF19 ADD A,(IY+$05) ;
 $CF1C LD L,A         ; }
 $CF1D LD A,(IX+$02)  ; {Work out where the south edge of the first object is, and take the
 $CF20 SUB (IX+$05)   ; north edge of the other object off it.
 $CF23 SUB L          ; }
 $CF24 JR NC,$CF3C    ; Jump to #R$CF3C if the first object is to the north of
                      ; the other.
 $CF26 LD A,(IX+$02)  ; {Work out where the north edge of the first object is.
 $CF29 ADD A,(IX+$05) ;
 $CF2C LD L,A         ; }
 $CF2D LD A,(IY+$02)  ; {Work out where the south edge of the other object is, and take the
 $CF30 SUB (IY+$05)   ; north edge of the first object off it.
 $CF33 SUB L          ; }
 $CF34 LD A,C         ; Fetch the number so far.
 $CF35 JR C,$CF39     ; Jump to #R$CF39 if the objects overlap in Y.
 $CF37 ADD A,$03      ; Add #N$03 to the number in Y.
@label=DrawObjectsInOrder_OverlapY
*$CF39 ADD A,$03      ; Add #N$03 to the number in Y.
 $CF3B LD C,A         ; Store the number.
@label=DrawObjectsInOrder_X
*$CF3C LD A,(IY+$01)  ; {Work out where the east edge of the other object is.
 $CF3F ADD A,(IY+$04) ;
 $CF42 LD L,A         ; }
 $CF43 LD A,(IX+$01)  ; {Work out where the west edge of the first object is, and take the
 $CF46 SUB (IX+$04)   ; east edge of the other object off it.
 $CF49 SUB L          ; }
 $CF4A JR NC,$CF62    ; Jump to #R$CF62 if the first object is to the east of
                      ; the other.
 $CF4C LD A,(IX+$01)  ; {Work out where the east edge of the first object is.
 $CF4F ADD A,(IX+$04) ;
 $CF52 LD L,A         ; }
 $CF53 LD A,(IY+$01)  ; {Work out where the west edge of the other object is, and take the
 $CF56 SUB (IY+$04)   ; east edge of the first object off it.
 $CF59 SUB L          ; }
 $CF5A LD A,C         ; Fetch the number so far.
 $CF5B JR C,$CF5F     ; Jump to #R$CF5F if the objects overlap in X.
 $CF5D ADD A,$09      ; Add #N$09 to the number in X.
@label=DrawObjectsInOrder_OverlapX
*$CF5F ADD A,$09      ; Add #N$09 to the number in X.
 $CF61 LD C,A         ; Store the number.
@label=DrawObjectsInOrder_Jump
*$CF62 LD L,C         ; Use the number as the index into the table.
 $CF63 LD BC,$CF69    ; Point #REGbc at #R$CF69.
 $CF66 JP $AFDB       ; Jump to the routine for the number.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C785 }
; { #PENTAGRAM$B58A }
; LIST#

; Drawing Order Table
;
; The routines that decide what is done about a pair of objects, by the
; number made from the directions in #R$CEF8. The number is the number in Z plus
; the number in Y plus the number in X. Either the first object is not held up
; by the other, or the other object has to be drawn first, or the objects fill
; the same space.
@label=DrawingOrderTable
w$CF69 DEFW $CF9F    ; {#N$00 to #N$02: the first object is not held up.
 $CF6B DEFW $CF9F    ;
 $CF6D DEFW $CF9F    ; }
 $CF6F DEFW $CFA5    ; {#N$03 and #N$04: the other object is drawn first.
 $CF71 DEFW $CFA5    ; }
 $CF73 DEFW $CF9F    ; #N$05: the first object is not held up.
 $CF75 DEFW $CFA5    ; {#N$06 and #N$07: the other object is drawn first.
 $CF77 DEFW $CFA5    ; }
 $CF79 DEFW $CF9F    ; {#N$08 and #N$09: the first object is not held up.
 $CF7B DEFW $CF9F    ; }
 $CF7D DEFW $CFA2    ; {#N$0A and #N$0B: the first object is not held up.
 $CF7F DEFW $CFA2    ; }
 $CF81 DEFW $CFA5    ; #N$0C: the other object is drawn first.
 $CF83 DEFW $CFE1    ; #N$0D: the objects fill the same space.
 $CF85 DEFW $CFA2    ; #N$0E: the first object is not held up.
 $CF87 DEFW $CFA5    ; {#N$0F and #N$10: the other object is drawn first.
 $CF89 DEFW $CFA5    ; }
 $CF8B DEFW $CF9F    ; {#N$11 and #N$12: the first object is not held up.
 $CF8D DEFW $CF9F    ; }
 $CF8F DEFW $CFA2    ; {#N$13 and #N$14: the first object is not held up.
 $CF91 DEFW $CFA2    ; }
 $CF93 DEFW $CF9F    ; #N$15: the first object is not held up.
 $CF95 DEFW $CFA2    ; {#N$16 and #N$17: the first object is not held up.
 $CF97 DEFW $CFA2    ; }
 $CF99 DEFW $CF9F    ; {#N$18 to #N$1A: the first object is not held up.
 $CF9B DEFW $CF9F    ;
 $CF9D DEFW $CF9F    ; }

; Continue Comparing Objects
;
; The first object is not held up by the other object, so go on to compare
; it with the next one.
@label=ContinueComparingObjects
c$CF9F JP $CEDB      ; Jump to #R$CEDB.
@label=ContinueComparingObjects_Alternate
 $CFA2 JP $CEDB      ; Jump to #R$CEDB.

; Compare With Other Object
;
; Handles the other object having to be drawn first. It becomes the first
; object, and the comparisons start again from the beginning of the list. The
; objects that have taken the place of the first object are kept in the list at
; #R$D01A. If the other object is already there the objects hold each other up,
; and the other object is drawn to break the loop.
;
; IY Address of the other object
@label=CompareWithOtherObject
c$CFA5 LD HL,($5BCF) ; Fetch the place in the list after the other object.
 $CFA8 DEC HL        ; Point #REGhl at the entry of the other object.
 $CFA9 LD C,(HL)     ; Fetch the index of the other object.
 $CFAA LD DE,$D01A   ; Point #REGde at #R$D01A.
@label=CompareWithOtherObject_Find
*$CFAD LD A,(DE)     ; Fetch an entry.
 $CFAE CP $FF        ; {Jump to #R$CFB8 if it is the end of the list.
 $CFB0 JR Z,$CFB8    ; }
 $CFB2 CP C          ; Test whether it is the other object.
 $CFB3 JR Z,$CFCE    ; Jump to #R$CFCE if it is.
 $CFB5 INC DE        ; Move on to the next entry.
 $CFB6 JR $CFAD      ; Jump back to #R$CFAD.
@label=CompareWithOtherObject_Add
*$CFB8 LD A,C        ; Fetch the index of the other object.
 $CFB9 LD (DE),A     ; Add it to the list.
 $CFBA INC DE        ; Move on to the next entry.
 $CFBB LD A,$FF      ; {Mark the end of the list.
 $CFBD LD (DE),A     ; }
 $CFBE PUSH IY       ; {Make the other object the first object.
 $CFC0 POP IX        ; }
 $CFC2 LD HL,($5BCF) ; Fetch the place in the list after the other object.
 $CFC5 LD ($5BCD),HL ; Make it the place in the list after the first object.
 $CFC8 LD DE,$CE8B   ; Point #REGde at #R$CE8B.
 $CFCB JP $CEDB      ; Jump to #R$CEDB.
@label=CompareWithOtherObject_Loop
*$CFCE LD HL,$CE8B   ; Point #REGhl at the list of objects to draw.
@label=CompareWithOtherObject_Search
*$CFD1 LD A,(HL)     ; Fetch an entry.
 $CFD2 INC HL        ; Move on to the next entry.
 $CFD3 CP $FF        ; {Jump to #R$CEC3 if it is the end of the list.
 $CFD5 JP Z,$CEC3    ; }
 $CFD8 CP C          ; Test whether it is the other object.
 $CFD9 JR NZ,$CFD1   ; Jump back to #R$CFD1 if it is not.
 $CFDB PUSH IY       ; {Make the other object the first object.
 $CFDD POP IX        ; }
 $CFDF JR $D003      ; Jump to #R$D003 to draw it.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C86F }
; LIST#

; Replace Overlapping Special Object
;
; Handles two objects that fill the same space. If one of them is a
; special object, it is replaced by a twinkling sprite.
;
; IX Address of the first object
; IY Address of the other object
@label=ReplaceOverlappingSpecialObject
c$CFE1 LD A,(IX+$00)   ; Fetch the graphic number of the first object.
 $CFE4 SUB $60         ; Take #N$60 off it, to get the number of the special
                       ; object.
 $CFE6 CP $07          ; {Jump to #R$CFF0 if it is not a special object.
 $CFE8 JR NC,$CFF0     ; }
 $CFEA LD (IX+$00),$BB ; Replace it with the twinkling sprite.
 $CFEE JR $CFFD        ; Jump to #R$CFFD.
@label=ReplaceOverlappingSpecialObject_Other
*$CFF0 LD A,(IY+$00)   ; Fetch the graphic number of the other object.
 $CFF3 SUB $60         ; Take #N$60 off it, to get the number of the special
                       ; object.
 $CFF5 CP $07          ; {Jump to #R$CFFD if it is not a special object.
 $CFF7 JR NC,$CFFD     ; }
 $CFF9 LD (IY+$00),$BB ; Replace it with the twinkling sprite.
@label=ReplaceOverlappingSpecialObject_Next
*$CFFD JP $CEDB        ; Jump to #R$CEDB.

; Draw Next Object
;
; Used by the routine at #R$CEBB.
; .
; Draws an object that does not have to wait for any other object, and
; flags it as drawn in the list.
;
; IX Address of the object
@label=DrawNextObject
c$D000 LD HL,($5BCD) ; Fetch the place in the list after the first object.
; This entry point is used by the routine at #R$CFA5.
@label=DrawNextObject_Flag
*$D003 DEC HL        ; Point #REGhl at the entry of the object.
 $D004 SET 7,(HL)    ; Flag the object as drawn.
 $D006 LD A,$FF      ; {Mark the end of the list of objects that have taken the place of the
 $D008 LD ($D01A),A  ; first object.}
 $D00B LD HL,$5BBE   ; Point #REGhl at #R$5BBE.
 $D00E INC (HL)      ; Add one to it.
 $D00F CALL $D704    ; Draw the object into the buffer.
 $D012 JP $CEC3      ; Jump to #R$CEC3 to find the next object.
; This entry point is used by the routine at #R$CEBB.
; .
; There are no objects left to draw.
@label=DrawNextObject_Finish
*$D015 POP IY        ; {Restore #REGiy and #REGix.
 $D017 POP IX        ; }
 $D019 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C8D5 }
; LIST#

; Chain Of Objects
;
; The indexes of the objects that have been compared, used by #R$CFA5, and
; ending with #N$FF.
@label=ObjectChain
b$D01A DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF

; Read Controls
;
; Used by the routine at #R$C82B.
; .
; Reads the controls that the player is using. The controls are made into
; a byte in #REGc, with bit 0 for left, bit 1 for right, bit 2 for walking
; forward, bit 3 for jumping, bit 4 for picking up and dropping an object (or
; for down, if a joystick with directional control is in use) and bit 5 for
; picking up and dropping an object with directional control. The byte is stored
; at #R$5BB5. No control is read during the final animation or while an object
; is being put into the cauldron.
;
; O:C The controls
@label=ReadControls
c$D022 LD A,($5BC3)  ; Fetch the final animation flag.
 $D025 LD C,A        ; Stash it in #REGc.
 $D026 LD A,($5BC4)  ; Fetch the flag for an object being put into the
                     ; cauldron.
 $D029 OR C          ; Combine the two flags.
 $D02A LD C,$00      ; Set the controls to none.
 $D02C JP NZ,$D111   ; Jump to #R$D111 if either flag is set.
 $D02F LD A,($5BA4)  ; Fetch the control method.
 $D032 RRCA          ; Move the keyboard and joystick choice into bits 0 and 1.
 $D033 AND %00000011 ; Keep it.
 $D035 JP Z,$D0C8    ; Jump to #R$D0C8 if the keyboard is in use.
 $D038 DEC A         ; Test for the Kempston joystick.
 $D039 JR Z,$D077    ; Jump to #R$D077 if it is in use.
 $D03B DEC A         ; Test for the cursor joystick.
 $D03C JR Z,$D09C    ; Jump to #R$D09C if it is in use.
; Continue on to #R$D03E.
; .
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C8FF }
; { #GUNFRIGHT$D0E3 }
; { #NIGHTSHADE$E241 }
; LIST#

; Read Interface 2 Joystick
;
; Reads the controls from the Interface 2 joysticks, which are the keys 1
; to 5 for the first joystick and 6 to 0 for the second joystick. The joysticks
; use the keys left, right, down, up and fire in that order, so the keys of the
; first joystick are read in the reverse order and the two are combined.
;
; O:C The controls
@label=ReadInterface2Joystick
c$D03E LD A,$F7      ; Select the row of the keys 1 to 5.
 $D040 CALL $B5F7    ; Read the keys.
 $D043 PUSH BC       ; Stash #REGbc.
 $D044 LD B,$05      ; Set the number of keys to #N$05.
@label=ReadInterface2Joystick_Reverse
*$D046 RRA           ; {Reverse the order of the five keys into #REGc.
 $D047 RL C          ;
 $D049 DJNZ $D046    ; }
 $D04B LD A,C        ; {Take the reversed keys and restore #REGbc.
 $D04C POP BC        ;
 $D04D LD C,A        ; }
 $D04E LD A,$EF      ; Select the row of the keys 0 to 6.
 $D050 CALL $B5F7    ; Read the keys.
 $D053 OR C          ; Combine the keys of the two joysticks.
 $D054 LD C,$00      ; Set the controls to none.
 $D056 BIT 0,A       ; {Set the jump control if the fire key is pressed.
 $D058 JR Z,$D05C    ;
 $D05A SET 3,C       ; }
@label=ReadInterface2Joystick_TestUp
*$D05C BIT 1,A       ; {Set the walk control if the up key is pressed.
 $D05E JR Z,$D062    ;
 $D060 SET 2,C       ; }
@label=ReadInterface2Joystick_TestDown
*$D062 BIT 2,A       ; {Set the pick up control if the down key is pressed.
 $D064 JR Z,$D068    ;
 $D066 SET 4,C       ; }
@label=ReadInterface2Joystick_TestRight
*$D068 BIT 3,A       ; {Set the right control if the right key is pressed.
 $D06A JR Z,$D06E    ;
 $D06C SET 1,C       ; }
@label=ReadInterface2Joystick_TestLeft
*$D06E BIT 4,A       ; {Set the left control if the left key is pressed.
 $D070 JR Z,$D074    ;
 $D072 SET 0,C       ; }
@label=ReadInterface2Joystick_Done
*$D074 JP $D111      ; Jump to #R$D111.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C91B }
; { #GUNFRIGHT$D0F2 }
; { #NIGHTSHADE$E250 }
; LIST#

; Read Kempston Joystick
;
; Used by the routine at #R$D022.
; .
; Reads the controls from a Kempston joystick.
;
; O:C The controls
@label=ReadKempstonJoystick
c$D077 IN A,($1F)    ; Read the joystick.
 $D079 LD C,$00      ; Set the controls to none.
 $D07B BIT 0,A       ; {Set the right control if the joystick is pushed right.
 $D07D JR Z,$D081    ;
 $D07F SET 1,C       ; }
@label=ReadKempstonJoystick_TestLeft
*$D081 BIT 1,A       ; {Set the left control if the joystick is pushed left.
 $D083 JR Z,$D087    ;
 $D085 SET 0,C       ; }
@label=ReadKempstonJoystick_TestDown
*$D087 BIT 2,A       ; {Set the pick up control if the joystick is pushed down.
 $D089 JR Z,$D08D    ;
 $D08B SET 4,C       ; }
@label=ReadKempstonJoystick_TestUp
*$D08D BIT 3,A       ; {Set the walk control if the joystick is pushed up.
 $D08F JR Z,$D093    ;
 $D091 SET 2,C       ; }
@label=ReadKempstonJoystick_TestFire
*$D093 BIT 4,A       ; {Set the jump control if the fire button is pressed.
 $D095 JR Z,$D099    ;
 $D097 SET 3,C       ; }
@label=ReadKempstonJoystick_Done
*$D099 JP $D111      ; Jump to #R$D111.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C954 }
; { #GUNFRIGHT$D12B }
; { #NIGHTSHADE$E289 }
; LIST#

; Read Cursor Joystick
;
; Used by the routine at #R$D022.
; .
; Reads the controls from a cursor joystick, which uses the keys 5 for
; left, 8 for right, 7 for up, 6 for down and 0 for fire.
;
; O:C The controls
@label=ReadCursorJoystick
c$D09C LD C,$00      ; Set the controls to none.
 $D09E LD A,$F7      ; {Read the keys 1 to 5.
 $D0A0 CALL $B5F7    ; }
 $D0A3 BIT 4,A       ; {Set the left control if 5 is pressed.
 $D0A5 JR Z,$D0A9    ;
 $D0A7 SET 0,C       ; }
@label=ReadCursorJoystick_SecondRow
*$D0A9 LD A,$EF      ; {Read the keys 0 to 6.
 $D0AB CALL $B5F7    ; }
 $D0AE BIT 0,A       ; {Set the jump control if 0 is pressed.
 $D0B0 JR Z,$D0B4    ;
 $D0B2 SET 3,C       ; }
@label=ReadCursorJoystick_TestUp
*$D0B4 BIT 3,A       ; {Set the walk control if 7 is pressed.
 $D0B6 JR Z,$D0BA    ;
 $D0B8 SET 2,C       ; }
@label=ReadCursorJoystick_TestRight
*$D0BA BIT 2,A       ; {Set the right control if 8 is pressed.
 $D0BC JR Z,$D0C0    ;
 $D0BE SET 1,C       ; }
@label=ReadCursorJoystick_TestDown
*$D0C0 BIT 4,A       ; {Jump to #R$D111 if 6 is not pressed.
 $D0C2 JR Z,$D111    ; }
 $D0C4 SET 4,C       ; Set the pick up control.
 $D0C6 JR $D111      ; Jump to #R$D111.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C979 }
; { #GUNFRIGHT$D150 }
; { #NIGHTSHADE$E2AE }
; LIST#

; Read Keyboard
;
; Used by the routine at #R$D022.
; .
; Reads the controls from the keyboard. Left is Z, C, M or B, right is X,
; V, symbol shift or N, walking forward is any key of the rows A to G and H to
; ENTER, jumping is any key of the rows Q to T and Y to P, and picking up and
; dropping an object is any key of the rows 1 to 5 and 6 to 0.
;
; O:C The controls
@label=ReadKeyboard
c$D0C8 LD A,$FE      ; {Read the keys SHIFT, Z, X, C and V.
 $D0CA CALL $B5F7    ; }
 $D0CD RRCA          ; Move Z into bit 0.
 $D0CE LD C,A        ; Stash the keys in #REGc.
 $D0CF AND %00000011 ; Keep Z and X.
 $D0D1 SRL C         ; {Move C and V into bits 0 and 1.
 $D0D3 SRL C         ; }
 $D0D5 OR C          ; Combine them with Z and X.
 $D0D6 AND %00000011 ; Keep the left and right bits.
 $D0D8 LD C,A        ; Stash them in #REGc.
 $D0D9 LD A,$7F      ; {Read the keys SPACE, symbol shift, M, N and B.
 $D0DB CALL $B5F7    ; }
 $D0DE BIT 1,A       ; {Set the right control if symbol shift is pressed.
 $D0E0 JR Z,$D0E4    ;
 $D0E2 SET 1,C       ; }
@label=ReadKeyboard_TestM
*$D0E4 BIT 2,A       ; {Set the left control if M is pressed.
 $D0E6 JR Z,$D0EA    ;
 $D0E8 SET 0,C       ; }
@label=ReadKeyboard_TestN
*$D0EA BIT 3,A       ; {Set the right control if N is pressed.
 $D0EC JR Z,$D0F0    ;
 $D0EE SET 1,C       ; }
@label=ReadKeyboard_TestB
*$D0F0 BIT 4,A       ; {Set the left control if B is pressed.
 $D0F2 JR Z,$D0F6    ;
 $D0F4 SET 0,C       ; }
@label=ReadKeyboard_WalkKeys
*$D0F6 LD A,$BD      ; {Read the keys A to G and H to ENTER.
 $D0F8 CALL $B5F7    ; }
 $D0FB JR Z,$D0FF    ; {Set the walk control if any of them is pressed.
 $D0FD SET 2,C       ; }
@label=ReadKeyboard_JumpKeys
*$D0FF LD A,$DB      ; {Read the keys Q to T and Y to P.
 $D101 CALL $B5F7    ; }
 $D104 JR Z,$D108    ; {Set the jump control if any of them is pressed.
 $D106 SET 3,C       ; }
@label=ReadKeyboard_PickUpKeys
*$D108 LD A,$E7      ; {Read the keys 1 to 5 and 6 to 0.
 $D10A CALL $B5F7    ; }
 $D10D JR Z,$D111    ; {Set the pick up control if any of them is pressed.
 $D10F SET 4,C       ; }
; This entry point is used by the routines at #R$D022, #R$D03E, #R$D077 and
; #R$D09C.
; .
; Reads the keys that pick up and drop an object when a joystick with
; directional control is in use. The keys that count are SHIFT, Z, X, C, V, 1 to
; 5, 6 to 0, SPACE, symbol shift, M, N and B.
@label=ReadControls_Finish
*$D111 LD A,$7E      ; {Read the keys SHIFT to V and SPACE to B.
 $D113 CALL $B5F7    ; }
 $D116 AND %00011110 ; Keep the keys Z, X, C, V, symbol shift, M, N and B.
 $D118 PUSH BC       ; Stash #REGbc.
 $D119 LD B,A        ; Stash the keys in #REGb.
 $D11A LD A,$99      ; {Read the keys SHIFT to V, 1 to 5, 6 to 0 and SPACE to
 $D11C CALL $B5F7    ; B.}
 $D11F OR B          ; Combine the keys.
 $D120 POP BC        ; Restore #REGbc.
 $D121 JR Z,$D125    ; Jump to #R$D125 if no key is pressed.
 $D123 SET 5,C       ; Set the directional pick up control.
@label=ReadControls_Store
*$D125 LD A,C        ; Fetch the controls.
 $D126 LD ($5BB5),A  ; Store them.
 $D129 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C9A5 }
; LIST#

; Lose Life
;
; Used by the routine at #R$AFB7.
; .
; Puts the player back as it was when it entered the room, and takes a
; life off. If there are no lives left the game is over. The player is a human
; if the sun is out, or a wulf if the moon is out.
@label=LoseLife
c$D12A LD HL,$D161   ; Point #REGhl at the copy of the player.
 $D12D LD DE,$5C08   ; Point #REGde at #R$5C08.
 $D130 PUSH DE       ; {Point #REGix at the objects table.
 $D131 POP IX        ; }
 $D133 LD BC,$0040   ; Set the length to #N$40, for the two halves of the
                     ; player.
 $D136 LDIR          ; Copy the player back.
 $D138 XOR A         ; {Clear the flag that says the player has to transform.
 $D139 LD ($5BB1),A  ; }
; See #POKE(infinite_lives,Infinite Lives).
 $D13C LD HL,$5BBA   ; Point #REGhl at #R$5BBA.
 $D13F DEC (HL)      ; Take a life off.
 $D140 JP M,$BA22    ; Jump to #R$BA22 if there are none left.
 $D143 LD A,($C44D)  ; Fetch the graphic number of the sun/moon.
 $D146 RRCA          ; {Move bit 0 into bit 5.
 $D147 RRCA          ;
 $D148 RRCA          ; }
 $D149 AND %00100000 ; Keep it, which is #N$20 if the moon is out.
 $D14B LD C,A        ; Stash it in #REGc.
 $D14C LD A,(IX+$10) ; Fetch the graphic number that the legs of the player will have when
                     ; it appears.
 $D14F AND %00011111 ; Keep the number of the legs of a human.
 $D151 ADD A,C       ; Add #N$20 if the moon is out, to make the legs of a
                     ; wulf.
 $D152 LD (IX+$10),A ; Store it.
 $D155 LD A,(IX+$30) ; Fetch the graphic number that the top half of the player will have
                     ; when it appears.
 $D158 AND %00001111 ; Keep the number of the top half without the form.
 $D15A ADD A,C       ; Add #N$20 if the moon is out.
 $D15B ADD A,$20     ; Add #N$20 to make the top half of a human or of a wulf.
 $D15D LD (IX+$30),A ; Store it.
 $D160 RET           ; Return.

; Copy Of Player
;
; A copy of the two objects of the player, as they were when the player
; entered the room (or as they are at the start of the game), which is put back
; by #R$D12A when a life is lost. The first #N$20 bytes are the legs and the
; last #N$20 bytes are the top half. The byte at #R$D169 is the room number of
; the legs, and the byte at #R$D189 that of the top half.
@label=PlayerCopy
g$D161 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; The legs: the graphic number, the coordinates, the size and the
                                            ; flags.
@label=PlayerCopy_LegsRoom
 $D169 DEFB $00                             ; The room number of the legs.
 $D16A DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; {The rest of the legs.
 $D172 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
 $D17A DEFB $00,$00,$00,$00,$00,$00,$00     ; }
@label=PlayerCopy_TopHalf
 $D181 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; The top half: the graphic number, the coordinates, the size and
                                            ; the flags.
@label=PlayerCopy_TopHalfRoom
 $D189 DEFB $00                             ; The room number of the top half.
 $D18A DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; {The rest of the top half.
 $D192 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
 $D19A DEFB $00,$00,$00,$00,$00,$00,$00     ; }

; Initial Player Data
;
; The first eight bytes of each object of the player at the start of the
; game: the graphic number, the X, Y and Z coordinates, the width, the depth,
; the height and the flags.
@label=InitialPlayerData
b$D1A1 DEFB $78,$80,$80,$80,$05,$05,$17,$1C ; The legs, which are a sparkle, at the middle of the room, with a
                                            ; height of #N$17.
 $D1A9 DEFB $78,$80,$80,$8C,$05,$05,$00,$1E ; The top half, which is a sparkle too, #N$0C higher than the legs
                                            ; and with no height.

; Initialise Player
;
; Used by the routine at #R$AF88.
; .
; Sets up the copy of the player at the start of the game. The player
; appears in a room that is picked at random from four rooms.
@label=InitialisePlayer
c$D1B1 LD HL,$D1A1   ; Point #REGhl at the initial data of the player.
 $D1B4 LD DE,$D161   ; Point #REGde at #R$D161.
 $D1B7 LD BC,$0008   ; Set the number of bytes to #N$08.
 $D1BA LDIR          ; Copy the initial data of the legs.
 $D1BC LD DE,$D181   ; Point #REGde at #R$D181.
 $D1BF LD BC,$0008   ; Set the number of bytes to #N$08.
 $D1C2 LDIR          ; Copy the initial data of the top half.
 $D1C4 LD A,$12      ; Fetch the graphic number of the legs of a human.
 $D1C6 LD ($D171),A  ; Store it as the graphic that the legs have when the
                     ; player appears.
 $D1C9 LD A,$22      ; Fetch the graphic number of the top half of a human.
 $D1CB LD ($D191),A  ; Store it as the graphic that the top half has when the player
                     ; appears.
 $D1CE LD A,($5BA0)  ; Fetch the first random seed.
 $D1D1 AND %00000011 ; Keep two bits.
 $D1D3 LD L,A        ; {Make it an offset.
 $D1D4 LD H,$00      ; }
 $D1D6 LD BC,$D1E2   ; Point #REGbc at #R$D1E2.
 $D1D9 ADD HL,BC     ; Add the offset.
 $D1DA LD A,(HL)     ; Fetch the start room.
 $D1DB LD ($D169),A  ; Set the room of the legs.
 $D1DE LD ($D189),A  ; Set the room of the top half.
 $D1E1 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CA6D }
; LIST#

; Start Rooms
;
; The rooms that the player may start in.
@label=StartRooms
b$D1E2 DEFB $2F,$44,$B3,$8F

; Build Room Objects
;
; Used by the routine at #R$AFBA.
; .
; Builds the objects of the room that the player is in, and sets the game
; up to start again in it.
@label=BuildRoomObjects
c$D1E6 LD A,($5BB2)  ; {Fetch the flag that says it is not the first room of
 $D1E9 AND A         ; the game.}
 $D1EA JR Z,$D1EF    ; Jump to #R$D1EF if it is the first room.
 $D1EC CALL $C591    ; Store the special objects of the room that the player
                     ; has left.
@label=BuildRoomObjects_Clear
*$D1EF CALL $D567    ; Clear the objects of the room, apart from the player.
 $D1F2 CALL $D3C6    ; Make the objects of the room from the room data.
 $D1F5 CALL $C525    ; Find the special objects that are in the room.
 $D1F8 CALL $D320    ; Move the player to the right place for the way it came
                     ; in.
 $D1FB XOR A         ; Get a zero to clear the flags with.
 $D1FC LD ($5BAF),A  ; Clear the flag that says a portcullis is moving.
 $D1FF LD ($5BB0),A  ; Clear the number of times a portcullis has come down.
 $D202 LD ($5BBD),A  ; Clear the height of the bounce of a ball.
 $D205 LD ($5BBF),A  ; Clear the flag that says a spiked ball is dropping.
 $D208 LD A,$01      ; Get the value that sets a flag.
 $D20A LD ($5BB7),A  ; Flag the panel to be drawn again.
 $D20D LD A,($5C10)  ; Fetch the room number.
 $D210 AND %00000001 ; Keep bit 0.
 $D212 LD ($5BC0),A  ; Set the flag that stops the spiked balls from dropping.
 $D215 CALL $D219    ; Flag the room as visited.
 $D218 RET           ; Return.

; Visit Room
;
; Used by the routine at #R$D1E6.
; .
; Flags the room that the player is in as visited, in the bitmap of the
; rooms at #R$5BE8. The bit that is set is chosen by changing the instruction at
; #R$D234, which is a SET instruction, by changing the byte that follows it.
@label=VisitRoom
c$D219 LD A,($5C10)  ; Fetch the room number.
 $D21C LD C,A        ; Stash it in #REGc.
 $D21D RRCA          ; {Divide it by eight.
 $D21E RRCA          ;
 $D21F RRCA          ; }
 $D220 AND %00011111 ; Keep the offset of the byte.
 $D222 LD L,A        ; Stash it in #REGl.
 $D223 LD H,$00      ; Clear the high byte of the offset.
 $D225 LD A,C        ; Fetch the room number.
 $D226 RLCA          ; {Move the low three bits to bits 3 to 5.
 $D227 RLCA          ;
 $D228 RLCA          ; }
 $D229 AND %00111000 ; Keep them.
 $D22B OR %11000110  ; Make them into the second byte of an instruction to set that
                     ; bit.
 $D22D LD ($D235),A  ; Put the byte into the instruction at #R$D234.
 $D230 LD BC,$5BE8   ; Point #REGbc at #R$5BE8.
 $D233 ADD HL,BC     ; Add the offset of the byte.
@label=VisitRoom_Set
 $D234 SET 0,(HL)    ; Set the bit of the room.
 $D236 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B863 }
; { #SABREWULF$9D23 }
; LIST#

; Set Sprite Details
;
; Used by the routines at #R$D24C, #R$D255 and #R$D296.
; .
; Sets the graphic number, the flags and the pixel coordinates of an
; object from four bytes of data.
;
;   HL Address of the data
;   IX Address of the object
; O:HL Address of the byte after the data
@label=SetSpriteDetails
c$D237 LD A,(HL)     ; {Fetch the graphic number and move on.
 $D238 INC HL        ; }
 $D239 LD (IX+$00),A ; Set the graphic number of the object.
 $D23C LD A,(HL)     ; {Fetch the flags and move on.
 $D23D INC HL        ; }
 $D23E LD (IX+$07),A ; Set the flags of the object.
 $D241 LD A,(HL)     ; {Fetch the pixel X coordinate and move on.
 $D242 INC HL        ; }
 $D243 LD (IX+$1A),A ; Set the pixel X coordinate of the object.
 $D246 LD A,(HL)     ; {Fetch the pixel Y coordinate and move on.
 $D247 INC HL        ; }
 $D248 LD (IX+$1B),A ; Set the pixel Y coordinate of the object.
 $D24B RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CAF1 }
; { #PENTAGRAM$BDC0 }
; LIST#

; Print Table Sprite
;
; Used by the routines at #R$D255 and #R$D296.
; .
; Sets the details of an object from four bytes of data, and draws it.
;
;   HL Address of the data
;   IX Address of the object
; O:HL Address of the byte after the data
@label=PrintTableSprite
c$D24C CALL $D237    ; Set the details of the object.
 $D24F PUSH HL       ; Stash the address of the data.
 $D250 CALL $D718    ; Draw the sprite.
 $D253 POP HL        ; Restore the address of the data.
 $D254 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CB06 }
; { #PENTAGRAM$BDD5 }
; LIST#

; Draw Panel
;
; Used by the routine at #R$AFBA.
; .
; Draws the shapes of the panel at the bottom of the screen, using the
; sprites in the table at #R$D27E. On each side there is a run of five sprites
; that go up or down in steps, followed by two more sprites. The right side is
; the left side flipped.
; .
; #PUSHS #UDGTABLE { =h After #R$D255 and #R$D56F }
; { #SIM(start=$AF6C,stop=$AFA2,sp=$5BA0,clear=1)
; #SIM(start=$D55F,stop=$0000,sp=$5B80)
; #SIM(start=$D255,stop=$0000,sp=$5B80)
; #SIM(start=$D56F,stop=$0000,sp=$5B80)
; #SCR$02,$00,$10,$20,$08(draw-panel) } UDGTABLE# #POPS
@label=DrawPanel
c$D255 LD IX,$BFDB   ; Point #REGix at the object that holds the details of the sprites of
                     ; the panel.
 $D259 LD HL,$D27E   ; Point #REGhl at #R$D27E.
 $D25C CALL $D237    ; Set the details of the first sprite.
 $D25F LD DE,$F810   ; Set the offsets to #N$10 in X and #N$F8 in Y, which is
                     ; #N$08 down.
 $D262 LD B,$05      ; Set the number of sprites to #N$05.
 $D264 CALL $BEE4    ; Draw the run of sprites on the left.
 $D267 CALL $D24C    ; Draw the second sprite on the left.
 $D26A CALL $D24C    ; Draw the third sprite on the left.
 $D26D CALL $D237    ; Set the details of the first sprite on the right.
 $D270 LD DE,$0810   ; Set the offsets to #N$10 in X and #N$08 in Y, which is
                     ; #N$08 up.
 $D273 LD B,$05      ; Set the number of sprites to #N$05.
 $D275 CALL $BEE4    ; Draw the run of sprites on the right.
 $D278 CALL $D24C    ; Draw the second sprite on the right.
 $D27B JP $D24C      ; Jump to #R$D24C.

; Panel Sprites
;
; The sprites of the panel. Each entry is the graphic number, the flags,
; the pixel X coordinate and the pixel Y coordinate.
@label=PanelSprites
b$D27E DEFB $86,$00,$10,$34 ; Left side: the run of five.
 $D282 DEFB $87,$00,$F0,$00 ; Left side: the second sprite.
 $D286 DEFB $88,$00,$90,$04 ; Left side: the third sprite.
 $D28A DEFB $86,$40,$A0,$14 ; Right side, flipped horizontally: the run of
                            ; five.
 $D28E DEFB $87,$40,$00,$00 ; Right side, flipped horizontally: the second
                            ; sprite.
 $D292 DEFB $88,$40,$60,$04 ; Right side, flipped horizontally: the third
                            ; sprite.

; Print Border
;
; Used by the routines at #R$BA22 and #R$BEBF.
; .
; Draws the border around the playing area, using the sprites in the table
; at #R$D2CF. The four corners are drawn first, then the top and bottom edges,
; which are each made of #N$18 sprites that are eight pixels wide, and the left
; and right edges, which are each made of #N$80 sprites that are one pixel high.
@label=PrintBorder
c$D296 LD IX,$BFDB   ; Point #REGix at the object that holds the details of the sprites of
                     ; the panel.
 $D29A LD HL,$D2CF   ; Point #REGhl at #R$D2CF.
 $D29D CALL $D24C    ; Draw the top left corner.
 $D2A0 CALL $D24C    ; Draw the top right corner.
 $D2A3 CALL $D24C    ; Draw the bottom right corner.
 $D2A6 CALL $D24C    ; Draw the bottom left corner.
 $D2A9 CALL $D237    ; Set the details of the top edge.
 $D2AC LD DE,$0008   ; Set the offsets to #N$08 in X and #N$00 in Y.
 $D2AF LD B,$18      ; Set the number of sprites to #N$18.
 $D2B1 CALL $BEE4    ; Draw the top edge.
 $D2B4 CALL $D237    ; Set the details of the bottom edge.
 $D2B7 LD B,$18      ; Set the number of sprites to #N$18.
 $D2B9 CALL $BEE4    ; Draw the bottom edge.
 $D2BC CALL $D237    ; Set the details of the left edge.
 $D2BF LD DE,$0100   ; Set the offsets to #N$00 in X and #N$01 in Y.
 $D2C2 LD B,$80      ; Set the number of sprites to #N$80.
 $D2C4 CALL $BEE4    ; Draw the left edge.
 $D2C7 CALL $D237    ; Set the details of the right edge.
 $D2CA LD B,$80      ; Set the number of sprites to #N$80.
 $D2CC JP $BEE4      ; Jump to #R$BEE4.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CB8A }
; { #PENTAGRAM$BD59 }
; LIST#
; .
; #PUSHS #UDGTABLE { =h After #R$D296 and #R$D56F }
; { #SIM(start=$AF6C,stop=$AFA2,sp=$5BA0,clear=1)
; #SIM(start=$D55F,stop=$0000,sp=$5B80)
; #SIM(start=$D296,stop=$0000,sp=$5B80)
; #SIM(start=$D56F,stop=$0000,sp=$5B80)
; #SCR$02(print-border) } UDGTABLE# #POPS

; Border Sprites
;
; The sprites of the border. Each entry is the graphic number, the flags,
; the pixel X coordinate and the pixel Y coordinate.
@label=BorderSprites
b$D2CF DEFB $89,$00,$00,$A0 ; Top left corner.
 $D2D3 DEFB $89,$40,$E0,$A0 ; Top right corner, flipped horizontally.
 $D2D7 DEFB $89,$C0,$E0,$00 ; Bottom right corner, flipped horizontally and
                            ; vertically.
 $D2DB DEFB $89,$80,$00,$00 ; Bottom left corner, flipped vertically.
 $D2DF DEFB $8B,$00,$20,$A8 ; Top edge.
 $D2E3 DEFB $8B,$00,$20,$00 ; Bottom edge.
 $D2E7 DEFB $8A,$00,$00,$20 ; Left edge.
 $D2EB DEFB $8A,$00,$E8,$20 ; Right edge.

; Set Border Attributes
;
; Used by the routine at #R$AFBA.
; .
; Sets the colours of the panel at the bottom of the screen: black for the
; two columns at the sides of the window of the sun and moon, and bright red for
; the window itself.
@label=SetBorderAttributes
c$D2EF XOR A         ; Set #REGa to the attribute for black on black.
 $D2F0 LD HL,$5AB6   ; Point #REGhl at the attributes of the left side.
 $D2F3 LD BC,$0103   ; Set the width to #N$01 and the height to #N$03.
 $D2F6 CALL $C515    ; Colour the left side.
 $D2F9 LD HL,$5ABD   ; Point #REGhl at the attributes of the right side.
 $D2FC LD BC,$0103   ; Set the width to #N$01 and the height to #N$03.
 $D2FF CALL $C515    ; Colour the right side.
 $D302 LD A,$42      ; Set #REGa to the attribute for bright red on black.
 $D304 LD HL,$5A97   ; Point #REGhl at the attributes of the window.
 $D307 LD BC,$0604   ; Set the width to #N$06 and the height to #N$04.
 $D30A JP $C515      ; Jump to #R$C515.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CBE3 }
; LIST#

; Colour Sun Moon
;
; Used by the routines at #R$AFBA and #R$C3A4.
; .
; Sets the colour of the sun or the moon in its window: bright yellow for
; the sun, or bright white for the moon.
@label=ColourSunMoon
c$D30D LD A,($C44D)  ; Fetch the graphic number of the sun/moon.
 $D310 AND %00000001 ; Keep bit 0, which is set for the moon.
 $D312 LD A,$46      ; Set #REGa to the attribute for bright yellow on black.
 $D314 JR Z,$D317    ; Jump to #R$D317 if it is the sun.
 $D316 INC A         ; Change it to bright white on black.
@label=ColourSunMoon_Fill
*$D317 LD HL,$5AB8   ; Point #REGhl at the attributes of the sun/moon.
 $D31A LD BC,$0402   ; Set the width to #N$04 and the height to #N$02.
 $D31D JP $C515      ; Jump to #R$C515.

; Place Player At Door
;
; Used by the routine at #R$D1E6.
; .
; Puts the player in the right place when it has come into a room through
; an arch. The routine that moved the player out of the last room set one of its
; coordinates to #N$00 or #N$FF, which tells which way the player came. The
; player is put at the opposite edge of the room, just outside the wall, and at
; the height of the arch. If the coordinates are not one of these, as when the
; player starts the game or starts a new life, nothing is done.
;
; IX Address of the player
@label=PlacePlayerAtDoor
c$D320 LD A,($5BAB)   ; {Fetch the size of the room in X and take #N$02 off it.
 $D323 SUB $02        ;
 $D325 LD L,A         ; }
 $D326 LD A,($5BAC)   ; {Fetch the size of the room in Y and take #N$02 off it.
 $D329 SUB $02        ;
 $D32B LD H,A         ; }
 $D32C LD A,(IX+$01)  ; {Fetch the X coordinate and test whether it is zero.
 $D32F AND A          ; }
 $D330 JR Z,$D37F     ; Jump to #R$D37F if it is, as the player came out of the
                      ; west.
 $D332 INC A          ; Add one to it.
 $D333 JR Z,$D36F     ; Jump to #R$D36F if it was #N$FF, as the player came out
                      ; of the east.
 $D335 LD A,(IX+$02)  ; {Fetch the Y coordinate and test whether it is zero.
 $D338 AND A          ; }
 $D339 JR Z,$D362     ; Jump to #R$D362 if it is, as the player came out of the
                      ; south.
 $D33B INC A          ; Add one to it.
 $D33C JR Z,$D33F     ; Jump to #R$D33F if it was #N$FF, as the player came out of the
                      ; north.
 $D33E RET            ; Return.
; The player came out of the north, so it goes to the south side of the
; room.
@label=PlacePlayerAtDoor_South
*$D33F LD C,$C8       ; Set the sum of the coordinates of the arch to look for.
 $D341 CALL $D38C     ; Find the arch and set the height of the player to it.
 $D344 LD A,$80       ; Start with #N$80.
 $D346 SUB H          ; Take the size of the room in Y off it.
 $D347 SUB (IX+$05)   ; Take the depth of the player off it.
@label=PlacePlayerAtDoor_SetY
*$D34A LD (IX+$02),A  ; Set the Y coordinate of the player.
@label=PlacePlayerAtDoor_Draw
*$D34D SET 4,(IX+$07) ; Flag the legs of the player to be drawn.
 $D351 SET 4,(IX+$27) ; Flag the top half of the player to be drawn.
 $D355 LD A,(IX+$01)  ; {Give the top half the X coordinate of the legs.
 $D358 LD (IX+$21),A  ; }
 $D35B LD A,(IX+$02)  ; {Give the top half the Y coordinate of the legs.
 $D35E LD (IX+$22),A  ; }
 $D361 RET            ; Return.
; The player came out of the south, so it goes to the north side of the
; room.
@label=PlacePlayerAtDoor_North
*$D362 LD C,$51       ; Set the sum of the coordinates of the arch to look for.
 $D364 CALL $D38C     ; Find the arch and set the height of the player to it.
 $D367 LD A,H         ; Fetch the size of the room in Y.
 $D368 ADD A,$80      ; Add #N$80 to it.
 $D36A ADD A,(IX+$05) ; Add the depth of the player.
 $D36D JR $D34A       ; Jump to #R$D34A.
; The player came out of the east, so it goes to the west side of the
; room.
@label=PlacePlayerAtDoor_West
*$D36F LD C,$AE       ; Set the sum of the coordinates of the arch to look for.
 $D371 CALL $D38C     ; Find the arch and set the height of the player to it.
 $D374 LD A,$80       ; Start with #N$80.
 $D376 SUB L          ; Take the size of the room in X off it.
 $D377 SUB (IX+$04)   ; Take the width of the player off it.
@label=PlacePlayerAtDoor_SetX
*$D37A LD (IX+$01),A  ; Set the X coordinate of the player.
 $D37D JR $D34D       ; Jump to #R$D34D.
; The player came out of the west, so it goes to the east side of the
; room.
@label=PlacePlayerAtDoor_East
*$D37F LD C,$37       ; Set the sum of the coordinates of the arch to look for.
 $D381 CALL $D38C     ; Find the arch and set the height of the player to it.
 $D384 LD A,L         ; Fetch the size of the room in X.
 $D385 ADD A,$80      ; Add #N$80 to it.
 $D387 ADD A,(IX+$04) ; Add the width of the player.
 $D38A JR $D37A       ; Jump to #R$D37A.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CC01 }
; { #PENTAGRAM$CA82 }
; LIST#

; Find Door Height
;
; Used by the routine at #R$D320.
; .
; Looks through the first four pairs of objects of the room for an arch (a
; graphic number below #N$06) whose X and Y coordinates add up to a given
; number. When it finds one it gives the player the height of the arch.
;
; C Sum of the X and Y coordinates of the arch
; IX Address of the player
@label=FindDoorHeight
c$D38C LD IY,$5C88    ; Point #REGiy at the first object of the room.
 $D390 LD DE,$0040    ; Set the distance between pairs of objects to #N$40.
 $D393 LD B,$04       ; Set the number of pairs to #N$04.
@label=FindDoorHeight_Next
*$D395 LD A,(IY+$00)  ; Fetch the graphic number of the object.
 $D398 CP $06         ; Compare it with #N$06.
 $D39A RET NC         ; Return if it is not an arch.
 $D39B LD A,(IY+$01)  ; {Add the Y coordinate to the X coordinate.
 $D39E ADD A,(IY+$02) ; }
 $D3A1 CP C           ; Compare the sum with the one that is wanted.
 $D3A2 JR Z,$D3A9     ; Jump to #R$D3A9 if it matches.
 $D3A4 ADD IY,DE      ; Point #REGiy at the next pair.
 $D3A6 DJNZ $D395     ; Jump back to #R$D395 until all of the pairs have been
                      ; tried.
 $D3A8 RET            ; Return.
@label=FindDoorHeight_Found
*$D3A9 LD A,(IY+$03)  ; Fetch the Z coordinate of the arch.
 $D3AC LD (IX+$03),A  ; Set the Z coordinate of the legs of the player.
 $D3AF ADD A,$0C      ; Add #N$0C to it.
 $D3B1 LD (IX+$23),A  ; Set the Z coordinate of the top half of the player.
 $D3B4 RET            ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CC6D }
; LIST#

; Find Object Address
;
; Used by the routines at #R$CEBB and #R$D59F.
; .
; Finds the address of an object in the objects table from its index.
;
;   A Index of the object (bit 7 is ignored)
; O:HL Address of the object
@label=FindObjectAddress
c$D3B5 PUSH BC       ; Stash #REGbc.
 $D3B6 AND %01111111 ; Ignore bit 7.
 $D3B8 LD L,A        ; {Make the index into a 16-bit number.
 $D3B9 LD H,$00      ; }
 $D3BB ADD HL,HL     ; {Multiply it by #N$20.
 $D3BC ADD HL,HL     ;
 $D3BD ADD HL,HL     ;
 $D3BE ADD HL,HL     ;
 $D3BF ADD HL,HL     ; }
 $D3C0 LD BC,$5C08   ; Point #REGbc at #R$5C08.
 $D3C3 ADD HL,BC     ; Add the two to get the address.
 $D3C4 POP BC        ; Restore #REGbc.
 $D3C5 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CC96 }
; { #PENTAGRAM$B520 }
; LIST#

; Retrieve Room
;
; Used by the routine at #R$D1E6.
; .
; Builds the objects of the room that the player is in from the room data.
; It looks for the room in the table of rooms at #R$6251, which has a variable
; length entry for each room. The entry has the number of the room, the length
; of the rest of the entry, the colour and size of the room, the types of
; background object that it has (which end with a #N$FF if there are groups of
; foreground objects after them) and the groups of foreground objects. The
; objects are put in the objects table from the first one after the player and
; the special objects. If the room is not in the table, none are made.
;
; IX Address of the player
@label=RetrieveRoom
c$D3C6 LD DE,$5C88   ; Point #REGde at the first object of the room in the
                     ; objects table.
 $D3C9 LD BC,$6BD1   ; Point #REGbc at the end of the table of rooms.
 $D3CC LD HL,$6251   ; Point #REGhl at #R$6251.
@label=RetrieveRoom_Find
*$D3CF LD A,(HL)     ; {Test whether the entry is the room of the player.
 $D3D0 INC HL        ;
 $D3D1 CP (IX+$08)   ; }
 $D3D4 JR Z,$D3F0    ; Jump to #R$D3F0 if it is.
 $D3D6 LD A,(HL)     ; Fetch the length of the entry.
 $D3D7 CALL $D4F2    ; Move on to the next entry.
 $D3DA AND A         ; {Compare the address with the end of the table.
 $D3DB SBC HL,BC     ; }
 $D3DD JR NC,$D3E2   ; Jump to #R$D3E2 if the end has been reached.
 $D3DF ADD HL,BC     ; Restore the address.
 $D3E0 JR $D3CF      ; Jump back to #R$D3CF.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CCA7 }
; LIST#

; Clear Remaining Objects
;
; Used by the routines at #R$D3C6 and #R$D3F0.
; .
; Clears the objects in the objects table from a given place to the end of
; the table.
;
; DE Address of the first object to clear
@label=ClearRemainingObjects
c$D3E2 LD HL,$6108   ; Point #REGhl at the end of the objects table.
 $D3E5 AND A         ; {Compare it with the address.
 $D3E6 SBC HL,DE     ; }
 $D3E8 RET Z         ; Return if the end has been reached.
 $D3E9 LD B,$20      ; Set the number of bytes to the size of an object.
 $D3EB CALL $D508    ; Clear the object.
 $D3EE JR $D3E2      ; Jump back to #R$D3E2.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CCD0 }
; LIST#

; Make Room Objects
;
; Used by the routine at #R$D3C6.
; .
; Makes the objects of a room from its entry in the table of rooms. The
; colour of the room is the low three bits of the byte after the length, with
; bright added, and the size of the room is the high five bits. The size gives
; the size of the room in X, Y and Z, from the table at #R$6248. Each type of
; background object is the number of an entry in the table at #R$6CE2, which
; holds the address of a list of objects. Each of these is copied into the
; objects table, along with the number of the room. The background objects end
; at a #N$FF, or at the end of the entry if there are no foreground objects.
; Each group of foreground objects starts with a byte that has the number of a
; block in bits 3 to 7 and one less than the number of times it is used in bits
; 0 to 2, followed by that many positions. A block is a list of objects, from
; the table at #R$6BD1. A position has the X coordinate in bits 0 to 2, the Y
; coordinate in bits 3 to 5 and the Z coordinate in bits 6 and 7.
;
; DE Address of the first object to make
; HL Address of the entry of the room (the byte after the number of the
; room)
; IX Address of the player
@label=MakeRoomObjects
c$D3F0 LD B,(HL)       ; Fetch the length of the entry.
 $D3F1 INC HL          ; Point #REGhl at the colour and size.
 $D3F2 LD A,(HL)       ; Fetch it.
 $D3F3 AND %00000111   ; Keep the colour.
 $D3F5 OR %01000000    ; Make it bright.
 $D3F7 LD ($5BAD),A    ; Store it as the colour of the room.
 $D3FA PUSH DE         ; Stash the address of the object to make.
 $D3FB EX DE,HL        ; Point #REGde at the colour and size.
 $D3FC LD A,(DE)       ; Fetch it.
 $D3FD INC DE          ; Point #REGde at the types of background object.
 $D3FE RRCA            ; {Move the size into the low five bits.
 $D3FF RRCA            ;
 $D400 RRCA            ; }
 $D401 AND %00011111   ; Keep it.
 $D403 LD C,A          ; Stash it in #REGc.
 $D404 ADD A,A         ; {Multiply it by three.
 $D405 ADD A,C         ; }
 $D406 LD HL,$6248     ; Point #REGhl at #R$6248.
 $D409 CALL $D4F2      ; Add the offset to find the size.
 $D40C LD A,(HL)       ; Fetch the size of the room in X.
 $D40D INC HL          ; Move on.
 $D40E LD ($5BAB),A    ; Store it.
 $D411 LD A,(HL)       ; Fetch the size of the room in Y.
 $D412 INC HL          ; Move on.
 $D413 LD ($5BAC),A    ; Store it.
 $D416 LD A,(HL)       ; Fetch the size of the room in Z, which is the floor of
                       ; the room.
 $D417 LD ($5BAE),A    ; Store it.
 $D41A DEC B           ; {Take two off the length that is left.
 $D41B DEC B           ; }
 $D41C EX DE,HL        ; Point #REGhl at the types of background object.
 $D41D POP DE          ; Restore the address of the object to make.
@label=MakeRoomObjects_Background
*$D41E LD A,(HL)       ; Fetch the type of background object.
 $D41F INC HL          ; Move on.
 $D420 CP $FF          ; {Jump to #R$D44C if it is the end of the types.
 $D422 JR Z,$D44C      ; }
 $D424 PUSH BC         ; Stash the length that is left.
 $D425 PUSH HL         ; Stash the address of the next type.
 $D426 LD L,A          ; {Make the type into an offset.
 $D427 LD H,$00        ; }
 $D429 ADD HL,HL       ; Double it.
 $D42A LD BC,$6CE2     ; Point #REGbc at #R$6CE2.
 $D42D ADD HL,BC       ; Add the two.
 $D42E LD A,(HL)       ; {Fetch the address of the list of objects of the
 $D42F INC HL          ; background.}
 $D430 LD H,(HL)       ; {Make it the address.
 $D431 LD L,A          ; }
@label=MakeRoomObjects_Background_Copy
*$D432 LD BC,$0008     ; Set the number of bytes to copy to #N$08.
 $D435 LDIR            ; Copy the graphic number, the coordinates, the size and the flags of
                       ; the object.
 $D437 LD A,(IX+$08)   ; Fetch the room number of the player.
 $D43A LD (DE),A       ; Set the room number of the object.
 $D43B INC DE          ; Move on.
 $D43C LD B,$17        ; Set the number of bytes to #N$17.
 $D43E CALL $D508      ; Clear the rest of the object.
 $D441 LD A,(HL)       ; Fetch the first byte of the next object in the list.
 $D442 AND A           ; Test whether the list has ended.
 $D443 JR NZ,$D432     ; Jump back to #R$D432 if not.
 $D445 POP HL          ; Restore the address of the next type.
 $D446 POP BC          ; Restore the length that is left.
 $D447 DJNZ $D41E      ; Jump back to #R$D41E until all of the entry has been
                       ; used.
 $D449 JP $D3E2        ; Clear the rest of the objects table.
; The foreground objects. #REGiy points at the object that is being made.
@label=MakeRoomObjects_Foreground
*$D44C DEC B           ; Take one off the length that is left, for the end of
                       ; the types.
 $D44D PUSH IY         ; Stash #REGiy.
 $D44F PUSH DE         ; {Point #REGiy at the object to make.
 $D450 POP IY          ; }
@label=MakeRoomObjects_Block
*$D452 LD A,(HL)       ; Fetch the block and the count.
 $D453 AND %00000111   ; Keep the count.
 $D455 INC A           ; Add one to get the number of times.
 $D456 LD C,A          ; Stash it in #REGc.
 $D457 LD A,(HL)       ; Fetch the block and the count again.
 $D458 INC HL          ; Move on.
 $D459 DEC B           ; Take one off the length that is left.
 $D45A LD D,(HL)       ; Fetch the position of the first block.
 $D45B INC HL          ; Move on.
 $D45C PUSH HL         ; Stash the address of the next byte.
 $D45D RRCA            ; {Move the block into bits 1 to 5.
 $D45E RRCA            ; }
 $D45F AND %00111110   ; Keep it, to make it twice the number of the block.
 $D461 LD HL,$6BD1     ; Point #REGhl at #R$6BD1.
 $D464 CALL $D4F2      ; Add the offset.
 $D467 LD A,(HL)       ; {Fetch the address of the list of objects of the
 $D468 INC HL          ; block.}
 $D469 LD H,(HL)       ; {Make it the address.
 $D46A LD L,A          ; }
@label=MakeRoomObjects_Block_Object
*$D46B PUSH HL         ; Stash the address of the list of objects.
@label=MakeRoomObjects_Object
*$D46C LD A,(HL)       ; {Fetch the graphic number, and move on.
 $D46D INC HL          ; }
 $D46E LD (IY+$00),A   ; Set the graphic number of the object.
 $D471 LD A,(HL)       ; {Fetch the width, and move on.
 $D472 INC HL          ; }
 $D473 LD (IY+$04),A   ; Set the width of the object.
 $D476 LD A,(HL)       ; {Fetch the depth, and move on.
 $D477 INC HL          ; }
 $D478 LD (IY+$05),A   ; Set the depth of the object.
 $D47B LD A,(HL)       ; {Fetch the height, and move on.
 $D47C INC HL          ; }
 $D47D LD (IY+$06),A   ; Set the height of the object.
 $D480 LD A,(HL)       ; {Fetch the flags, and move on.
 $D481 INC HL          ; }
 $D482 LD (IY+$07),A   ; Set the flags of the object.
 $D485 LD A,(IX+$08)   ; Fetch the room number of the player.
 $D488 LD (IY+$08),A   ; Set the room number of the object.
; The byte of offsets has the half step in X in bit 0, the half step in Y
; in bit 1, and the offset in Z in bits 2 to 7. The X coordinate is the X
; position times #N$10, plus eight if the half step is set, plus #N$48.
 $D48B LD A,(HL)       ; Fetch the offsets.
 $D48C RLCA            ; {Move the half step in X into bit 3.
 $D48D RLCA            ;
 $D48E RLCA            ; }
 $D48F AND %00001000   ; Keep it.
 $D491 LD E,A          ; Stash it in #REGe.
 $D492 LD A,D          ; Fetch the position.
 $D493 RLCA            ; {Move the X position into bits 4 to 6.
 $D494 RLCA            ;
 $D495 RLCA            ;
 $D496 RLCA            ; }
 $D497 AND %01110000   ; Keep it.
 $D499 ADD A,E         ; Add the half step.
 $D49A ADD A,$48       ; Add #N$48.
 $D49C LD (IY+$01),A   ; Set the X coordinate of the object.
; The Y coordinate is worked out in the same way from the Y position and
; the half step in Y.
 $D49F LD A,(HL)       ; Fetch the offsets.
 $D4A0 RLCA            ; {Move the half step in Y into bit 3.
 $D4A1 RLCA            ; }
 $D4A2 AND %00001000   ; Keep it.
 $D4A4 LD E,A          ; Stash it in #REGe.
 $D4A5 LD A,D          ; Fetch the position.
 $D4A6 RLCA            ; Move the Y position into bits 4 to 6.
 $D4A7 AND %01110000   ; Keep it.
 $D4A9 ADD A,E         ; Add the half step.
 $D4AA ADD A,$48       ; Add #N$48.
 $D4AC LD (IY+$02),A   ; Set the Y coordinate of the object.
; The Z coordinate is the Z position times #N$0C, plus the offset in Z,
; plus the floor of the room.
 $D4AF LD A,D          ; Fetch the position.
 $D4B0 RLCA            ; {Move the Z position into the low two bits.
 $D4B1 RLCA            ; }
 $D4B2 AND %00000011   ; Keep it.
 $D4B4 ADD A,A         ; {Multiply it by four.
 $D4B5 ADD A,A         ; }
 $D4B6 LD E,A          ; Stash it in #REGe.
 $D4B7 ADD A,A         ; Multiply it by eight.
 $D4B8 ADD A,E         ; Add the four times to make twelve times.
 $D4B9 ADD A,(HL)      ; Add the offsets, which includes the offset in Z.
 $D4BA INC HL          ; Move on.
 $D4BB AND %11111100   ; Clear the two bits of the half steps.
 $D4BD LD E,A          ; Stash it in #REGe.
 $D4BE LD A,($5BAE)    ; Fetch the floor of the room.
 $D4C1 ADD A,E         ; Add it.
 $D4C2 LD (IY+$03),A   ; Set the Z coordinate of the object.
 $D4C5 PUSH BC         ; Stash the count.
 $D4C6 LD BC,$0009     ; Set the length of the part of the object that has been made to
                       ; #N$09.
 $D4C9 ADD IY,BC       ; Point #REGiy at the rest of the object.
 $D4CB LD B,$17        ; Set the number of bytes to clear to #N$17.
@label=MakeRoomObjects_Clear
*$D4CD LD (IY+$00),$00 ; Clear a byte.
 $D4D1 INC IY          ; Move on.
 $D4D3 DJNZ $D4CD      ; Jump back to #R$D4CD until the object is clear.
 $D4D5 POP BC          ; Restore the count.
 $D4D6 LD A,(HL)       ; Fetch the first byte of the next object in the block.
 $D4D7 AND A           ; Test whether the block has ended.
 $D4D8 JR NZ,$D46C     ; Jump back to #R$D46C if it has not.
 $D4DA POP DE          ; Restore the address of the block.
 $D4DB POP HL          ; Restore the address of the next byte.
 $D4DC DEC B           ; Take one off the length that is left.
 $D4DD JR Z,$D4EA      ; Jump to #R$D4EA if the entry has ended.
 $D4DF DEC C           ; Count down the number of times the block is used.
 $D4E0 JP Z,$D452      ; Jump to #R$D452 if it has all been used, to go on to
                       ; the next group.
 $D4E3 LD A,(HL)       ; {Fetch the position for the next use of the block, and
 $D4E4 INC HL          ; move on.}
 $D4E5 PUSH HL         ; Stash the address of the next byte.
 $D4E6 EX DE,HL        ; Point #REGhl at the list of objects of the block.
 $D4E7 LD D,A          ; Put the position in #REGd.
 $D4E8 JR $D46B        ; Jump to #R$D46B.
@label=MakeRoomObjects_Finish
*$D4EA PUSH IY         ; {Point #REGde at the next object to make.
 $D4EC POP DE          ; }
 $D4ED POP IY          ; Restore #REGiy.
 $D4EF JP $D3E2        ; Clear the rest of the objects table.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CCDE }
; LIST#

; Add A To HL
;
; Used by the routines at #R$B2DA, #R$C274, #R$C3A4, #R$D3C6, #R$D3F0 and
; #R$D865.
; .
; Adds an unsigned number to #REGhl.
;
;   A The number
;   HL The address
; O:HL The new address
@label=AddAToHL
c$D4F2 ADD A,L       ; Add the low byte.
 $D4F3 LD L,A        ; Store it.
 $D4F4 LD A,H        ; Fetch the high byte.
 $D4F5 ADC A,$00     ; Add the carry.
 $D4F7 LD H,A        ; Store it.
 $D4F8 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CE06 }
; { #CYBERUN$9BCF }
; { #NIGHTSHADE$E596 }
; { #PENTAGRAM$B519 }
; { #SABREWULF$9B37 }
; LIST#

; Multiply A By DE
;
; Used by the routine at #R$D865.
; .
; Multiplies #REGa by #REGde.
;
;   A The multiplier
;   DE The multiplicand
; O:HL The product
@label=MultiplyAByDE
c$D4F9 PUSH BC       ; Stash #REGbc.
 $D4FA LD HL,$0000   ; Set the product to zero.
 $D4FD LD B,$08      ; Set the number of bits to #N$08.
@label=MultiplyAByDE_Loop
*$D4FF ADD HL,HL     ; Double the product.
 $D500 RLCA          ; Move the next bit of the first number into the carry.
 $D501 JR NC,$D504   ; Jump to #R$D504 if it is not set.
 $D503 ADD HL,DE     ; Add the second number.
@label=MultiplyAByDE_Next
*$D504 DJNZ $D4FF    ; Jump back to #R$D4FF until all of the bits are done.
 $D506 POP BC        ; Restore #REGbc.
 $D507 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CE0D }
; { #ATICATAC$9AAD }
; { #GUNFRIGHT$D03E }
; { #NIGHTSHADE$E0EE }
; { #TRANZAM$6F2F }
; { #UNDERWURLDE$AC68 }
; LIST#

; Clear Bytes
;
; Used by the routines at #R$C00E, #R$C525, #R$D3E2 and #R$D3F0.
; .
; Fills a number of bytes with zero. The entry point at #R$D509 fills them
; with another byte.
;
; B Number of bytes
; DE Address of the first byte
@label=ClearBytes
c$D508 XOR A         ; Set the byte to zero.
; This entry point is used by the routine at #R$BC7A.
@label=FillBytes
*$D509 LD (DE),A     ; Fill a byte.
 $D50A INC DE        ; Move on.
 $D50B DJNZ $D509    ; Jump back to #R$D509 until all of the bytes are filled.
 $D50D RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CE1C }
; { #PENTAGRAM$B513 }
; LIST#

; Pause Game
;
; Used by the routine at #R$AFBA.
; .
; Pauses the game if the SPACE key is pressed on its own. The game waits
; for the key to be let go of, then for it to be pressed again and let go of
; again. There is a sound for the start and for the end of the pause.
@label=PauseGame
c$D50E LD A,$7E      ; {Read the keys SPACE, symbol shift, M, N and B.
 $D510 CALL $B5F7    ; }
 $D513 BIT 0,A       ; Test the SPACE key.
 $D515 RET Z         ; Return if it is not pressed.
 $D516 AND %00011110 ; Keep the other keys.
 $D518 RET NZ        ; Return if any of them is pressed.
@label=PauseGame_Release
*$D519 LD A,$7E      ; {Read the keys.
 $D51B CALL $B5F7    ; }
 $D51E BIT 0,A       ; {Jump back to #R$D519 while it is pressed.
 $D520 JR NZ,$D519   ; }
 $D522 CALL $B4A8    ; Play the sound of the pause.
@label=PauseGame_Wait
*$D525 LD A,$7E      ; {Read the keys.
 $D527 CALL $B5F7    ; }
 $D52A BIT 0,A       ; {Jump back to #R$D525 until it is pressed.
 $D52C JR Z,$D525    ; }
@label=PauseGame_Finish
*$D52E LD A,$7E      ; {Read the keys.
 $D530 CALL $B5F7    ; }
 $D533 BIT 0,A       ; {Jump back to #R$D52E while it is pressed.
 $D535 JR NZ,$D52E   ; }
 $D537 JP $B4A8      ; Jump to #R$B4A8.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CE22 }
; { #GUNFRIGHT$D206 }
; { #NIGHTSHADE$E32C }
; LIST#

; Fill Memory
;
; Used by the routines at #R$AF6C, #R$AF7F, #R$D544 and #R$D567.
; .
; Fills an area of memory with zero. The entry point at #R$D53C fills it
; with the byte in #REGe.
;
; BC Number of bytes
; HL Address of the first byte
@label=FillMemory
c$D53A LD E,$00      ; Set the byte to zero.
; This entry point is used by the routines at #R$D54C and #R$D556.
@label=FillMemory_WithValue
*$D53C LD (HL),E     ; Fill a byte.
 $D53D INC HL        ; Move on.
 $D53E DEC BC        ; Count down the number of bytes.
 $D53F LD A,B        ; {Test whether it is zero.
 $D540 OR C          ; }
 $D541 JR NZ,$D53C   ; Jump back to #R$D53C if not.
 $D543 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CE56 }
; { #GUNFRIGHT$D6E1 }
; { #MARTIANOIDS$B1A3 }
; { #NIGHTSHADE$E5BA }
; { #PENTAGRAM$CB77 }
; { #UNDERWURLDE$9569 }
; LIST#

; Clear Screen Bitmap
;
; Used by the routine at #R$D55F.
; .
; Clears the bitmap of the screen.
@label=ClearScreenBitmap
c$D544 LD HL,$4000   ; Point #REGhl at the bitmap of the screen.
 $D547 LD BC,$1800   ; Set the number of bytes to #N$1800.
 $D54A JR $D53A      ; Jump to #R$D53A.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CE60 }
; { #ATICATAC$80B4 }
; { #COOKIE$74D4 }
; { #CYBERUN$9A7E }
; { #GUNFRIGHT$D6DB }
; { #JETPAC$71B8 }
; { #LUNARJETMAN$84AD }
; { #NIGHTSHADE$E5A8 }
; { #PSSST$7439 }
; { #SABREWULF$BB81 }
; { #TRANZAM$7211 }
; LIST#

; Clear Attributes
;
; Used by the routine at #R$D55F.
; .
; Sets the attributes of the screen to bright yellow on black.
@label=ClearAttributes
c$D54C LD HL,$5800   ; Point #REGhl at the attributes of the screen.
 $D54F LD BC,$0300   ; Set the number of bytes to #N$0300.
 $D552 LD E,$46      ; Set the byte to the attribute for bright yellow on
                     ; black.
 $D554 JR $D53C      ; Jump to #R$D53C.

; Fill Attributes
;
; Used by the routine at #R$AFBA.
; .
; Sets the attributes of the whole screen to one value.
;
; A The attribute
@label=FillAttributes
c$D556 LD HL,$5800   ; Point #REGhl at the attributes of the screen.
 $D559 LD BC,$0300   ; Set the number of bytes to #N$0300.
 $D55C LD E,A        ; Set the byte to the attribute.
 $D55D JR $D53C      ; Jump to #R$D53C.

; Clear Screen
;
; Used by the routines at #R$AF88, #R$BA22 and #R$BAAB.
; .
; Clears the screen to bright yellow on black, with a black border.
@label=ClearScreen
c$D55F XOR A         ; {Make the border black.
 $D560 OUT ($FE),A   ; }
 $D562 CALL $D54C    ; Set the attributes of the screen to bright yellow on
                     ; black.
 $D565 JR $D544      ; Jump to #R$D544 to clear the bitmap of the screen.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CE73 }
; LIST#
; .
; #PUSHS #UDGTABLE { =h Before | =h After #R$D55F }
; { #SIM(start=$AF6C,stop=$AFA2,sp=$5BA0,clear=1)
; #SIM(start=$BD0C,stop=$BD23)
; #SCR$02(clear-screen-before)
; | #SIM(start=$D55F,stop=$0000,sp=$5B80)
; #SCR$02(clear-screen-after) } UDGTABLE# #POPS

; Clear Screen Buffer
;
; Used by the routines at #R$BA22, #R$BAAB, #R$BD0C and #R$D1E6.
; .
; Clears the buffer that the playing area is drawn in before it is copied
; to the screen.
@label=ClearScreenBuffer
c$D567 LD BC,$1800   ; Set the number of bytes to #N$1800.
 $D56A LD HL,$D8F3   ; Point #REGhl at #R$D8F3.
 $D56D JR $D53A      ; Jump to #R$D53A.
; View the equivalent code in;
; #LIST
; { #PENTAGRAM$CB81 }
; LIST#

; Update Screen
;
; Used by the routines at #R$AFBA, #R$BA22 and #R$BEBF.
; .
; Copies the screen buffer to the screen, and clears the buffer as it
; goes. The buffer holds the lines of the screen from the bottom up, #N$20 bytes
; to a line, so the lines are copied from the bottom of the screen to the top.
; .
; #PUSHS #UDGTABLE { =h Before | =h After #R$D56F }
; { #SIM(start=$AF6C,stop=$AFA2,sp=$5BA0,clear=1)
; #SIM(start=$BD0C,stop=$BD23)
; #SCR$02(update-screen-before)
; | #SIM(start=$AFAB,stop=$B02F,sp=$5BA0)
; #SIM(start=$B03F,stop=$B06E)
; #SIM(start=$D56F,stop=$0000,sp=$5B80)
; #SCR$02(update-screen-after) } UDGTABLE# #POPS
@label=UpdateScreen
c$D56F LD HL,$D8F3   ; Point #REGhl at the screen buffer.
 $D572 LD DE,$57E0   ; Point #REGde at the last line of the bitmap of the
                     ; screen.
 $D575 LD BC,$20C0   ; Set the width to #N$20 bytes and the number of lines to
                     ; #N$C0.
@label=UpdateScreen_Line
*$D578 PUSH BC       ; Stash the counters.
 $D579 PUSH DE       ; Stash the address of the line on the screen.
 $D57A PUSH HL       ; Stash the address of the line in the buffer.
@label=UpdateScreen_Byte
*$D57B LD A,(HL)     ; Fetch a byte from the buffer.
 $D57C LD (DE),A     ; Copy it to the screen.
 $D57D LD (HL),$00   ; Clear the byte in the buffer.
 $D57F INC HL        ; Move on in the buffer.
 $D580 INC E         ; Move on in the screen.
 $D581 DJNZ $D57B    ; Jump back to #R$D57B until the line is copied.
 $D583 POP HL        ; Restore the address of the line in the buffer.
 $D584 LD BC,$0020   ; Set #REGbc to the length of a line.
 $D587 ADD HL,BC     ; Move on to the next line in the buffer.
 $D588 POP DE        ; Restore the address of the line on the screen.
 $D589 DEC D         ; Go up one line on the screen.
 $D58A LD A,D        ; {Test whether that has gone into the character row
 $D58B CPL           ; above.}
 $D58C AND %00000111 ; Keep the bits of the line within the character row.
 $D58E JR NZ,$D59A   ; Jump to #R$D59A if it has not.
 $D590 LD A,E        ; {Go up one character row.
 $D591 SUB $20       ; }
 $D593 LD E,A        ; Store it.
 $D594 JR C,$D59A    ; Jump to #R$D59A if that has gone into the third of the
                     ; screen above.
 $D596 LD A,D        ; {Put the line at the bottom of the character row.
 $D597 ADD A,$08     ; }
 $D599 LD D,A        ; Store it.
@label=UpdateScreen_Next
*$D59A POP BC        ; Restore the counters.
 $D59B DEC C         ; Count down the lines.
 $D59C JR NZ,$D578   ; Jump back to #R$D578 until all of the lines are copied.
 $D59E RET           ; Return.

; Draw Changed Objects
;
; Used by the routine at #R$AFBA.
; .
; Updates the playing area for the objects that have changed. First the
; sprites of the objects that moved are wiped out of the screen buffer: for each
; object in the list at #R$CE8B that is flagged to be wiped, the area covered by
; the old and the new position of its sprite is cleared, and the area is kept on
; the stack. Then the objects are drawn in order, the sun or moon is moved, and
; the objects the player is carrying are shown. Last, each of the areas that
; were kept is copied from the buffer to the screen. When the whole room has to
; be drawn there is nothing to wipe, and the screen is updated by the game loop.
@label=DrawChangedObjects
c$D59F XOR A          ; Get a zero.
 $D5A0 LD ($5BA8),A   ; Set the number of areas wiped to zero.
 $D5A3 PUSH IX        ; Stash #REGix.
 $D5A5 LD A,($5BB7)   ; {Fetch the flag that says the whole screen is to be
 $D5A8 AND A          ; drawn.}
 $D5A9 JP NZ,$D653    ; Jump to #R$D653 if it is set.
 $D5AC LD HL,$CE8B    ; Point #REGhl at #R$CE8B.
 $D5AF LD ($5BCB),HL  ; Keep it as the place in the list.
@label=DrawChangedObjects_Wipe
*$D5B2 LD HL,($5BCB)  ; Fetch the place in the list.
 $D5B5 LD A,(HL)      ; Fetch the index of the object.
 $D5B6 INC HL         ; Move on.
 $D5B7 LD ($5BCB),HL  ; Store the place in the list.
 $D5BA CP $FF         ; {Jump to #R$D653 if it is the end of the list.
 $D5BC JP Z,$D653     ; }
 $D5BF CALL $D3B5     ; Find the address of the object.
 $D5C2 PUSH HL        ; {Point #REGix at the object.
 $D5C3 POP IX         ; }
 $D5C5 BIT 5,(IX+$07) ; {Jump back to #R$D5B2 if the object is not flagged to
 $D5C9 JR Z,$D5B2     ; be wiped.}
 $D5CB RES 5,(IX+$07) ; Clear the flag.
; The left edge of the area is the lower of the old and the new pixel X
; coordinate. The width is worked out in bytes of the screen from there to the
; higher of the old and the new right edge.
 $D5CF LD A,(IX+$1A)  ; {Take the old pixel X coordinate off the new one.
 $D5D2 SUB (IX+$1E)   ; }
 $D5D5 JP C,$D649     ; Jump to #R$D649 if the new one is lower.
 $D5D8 LD C,(IX+$1E)  ; Take the old pixel X coordinate as the left edge.
@label=DrawChangedObjects_Width
*$D5DB LD A,(IX+$1E)  ; Fetch the old pixel X coordinate.
 $D5DE RRCA           ; {Divide it by eight.
 $D5DF RRCA           ;
 $D5E0 RRCA           ; }
 $D5E1 AND %00011111  ; Keep the byte of the screen.
 $D5E3 ADD A,(IX+$1C) ; Add the old width in bytes.
 $D5E6 LD E,A         ; Stash the old right edge in #REGe.
 $D5E7 LD A,(IX+$1A)  ; Fetch the new pixel X coordinate.
 $D5EA RRCA           ; {Divide it by eight.
 $D5EB RRCA           ;
 $D5EC RRCA           ; }
 $D5ED AND %00011111  ; Keep the byte of the screen.
 $D5EF ADD A,(IX+$18) ; Add the new width in bytes.
 $D5F2 CP E           ; Compare it with the old right edge.
 $D5F3 JR C,$D5F6     ; Jump to #R$D5F6 if the new right edge is lower.
 $D5F5 LD E,A         ; Take the new right edge instead.
@label=DrawChangedObjects_Width_FetchLeft
*$D5F6 LD A,C         ; Fetch the left edge.
 $D5F7 RRCA           ; {Divide it by eight.
 $D5F8 RRCA           ;
 $D5F9 RRCA           ; }
 $D5FA AND %00011111  ; Keep the byte of the screen.
 $D5FC LD B,A         ; Stash it in #REGb.
 $D5FD LD A,E         ; Fetch the right edge.
 $D5FE SUB B          ; Take the left edge off it.
 $D5FF LD H,A         ; Stash the width in bytes in #REGh.
; The bottom edge of the area is the lower of the old and the new pixel Y
; coordinate. The height is worked out from there to the higher of the old and
; the new top edge.
 $D600 LD A,(IX+$1B)  ; Fetch the new pixel Y coordinate.
 $D603 SUB (IX+$1F)   ; Take the old pixel Y coordinate off it.
 $D606 JR C,$D64E     ; Jump to #R$D64E if the new one is lower.
 $D608 LD B,(IX+$1F)  ; Take the old pixel Y coordinate as the bottom edge.
@label=DrawChangedObjects_Height
*$D60B LD A,(IX+$1F)  ; Fetch the old pixel Y coordinate.
 $D60E ADD A,(IX+$1D) ; Add the old height in lines.
 $D611 LD E,A         ; Stash the old top edge in #REGe.
 $D612 LD A,(IX+$1B)  ; Fetch the new pixel Y coordinate.
 $D615 ADD A,(IX+$19) ; Add the new height in lines.
 $D618 CP E           ; Compare it with the old top edge.
 $D619 JR NC,$D61C    ; Jump to #R$D61C if the new top edge is higher.
 $D61B LD A,E         ; Take the old top edge instead.
@label=DrawChangedObjects_Height_TakeBottom
*$D61C SUB B          ; Take the bottom edge off it.
 $D61D LD L,A         ; Stash the height in lines in #REGl.
 $D61E LD A,B         ; Fetch the bottom edge.
 $D61F CP $C0         ; {Jump back to #R$D5B2 if it is off the screen.
 $D621 JR NC,$D5B2    ; }
 $D623 ADD A,L        ; Add the height to get the top edge.
 $D624 SUB $C0        ; Take the number of lines on the screen off it.
 $D626 JR C,$D62C     ; Jump to #R$D62C if the area does not go off the top of
                      ; the screen.
 $D628 NEG            ; Make the number of lines that are off the screen
                      ; positive.
 $D62A ADD A,L        ; Take it off the height.
 $D62B LD L,A         ; Stash the new height.
@label=DrawChangedObjects_Keep
*$D62C CALL $D826     ; Find the address of the area on the screen.
 $D62F CALL $D811     ; Find the address of the area in the buffer.
 $D632 LD A,L         ; {Swap the address of the area in the buffer with the size in #REGhl,
 $D633 LD L,C         ; so that #REGhl is the address and #REGbc is the width and height.
 $D634 LD C,A         ; }
 $D635 LD A,H         ; {Swap the rest.
 $D636 LD H,B         ;
 $D637 LD B,A         ; }
 $D638 LD A,($5BA8)   ; {Fetch the number of areas wiped and add one to it.
 $D63B INC A          ; }
 $D63C LD ($5BA8),A   ; Store it.
 $D63F PUSH BC        ; Stash the width and height.
 $D640 PUSH DE        ; Stash the address on the screen.
 $D641 PUSH HL        ; Stash the address in the buffer.
 $D642 XOR A          ; Get a zero to wipe the area with.
 $D643 CALL $C515     ; Wipe the area.
 $D646 JP $D5B2       ; Jump back to #R$D5B2 for the next object.
@label=DrawChangedObjects_Left
*$D649 LD C,(IX+$1A)  ; Take the new pixel X coordinate as the left edge.
 $D64C JR $D5DB       ; Jump to #R$D5DB.
@label=DrawChangedObjects_Bottom
*$D64E LD B,(IX+$1B)  ; Take the new pixel Y coordinate as the bottom edge.
 $D651 JR $D60B       ; Jump to #R$D60B.
; Draw the objects, and then copy the areas that were wiped to the screen.
@label=DrawChangedObjects_Draw
*$D653 CALL $CEBB     ; Draw the objects in order.
 $D656 CALL $C397     ; Move the sun or moon.
 $D659 CALL $BF45     ; Show the objects the player is carrying.
 $D65C LD HL,$5BA8    ; Point #REGhl at #R$5BA8.
 $D65F LD A,($5BBE)   ; Fetch the number of objects drawn.
 $D662 ADD A,(HL)     ; Add the number of areas wiped to it.
 $D663 LD ($5BBE),A   ; Store it.
@label=DrawChangedObjects_Copy
*$D666 LD HL,$5BA8    ; Point #REGhl at the number of areas wiped.
 $D669 LD A,(HL)      ; {Fetch it and test whether it is zero.
 $D66A AND A          ; }
 $D66B JR Z,$D679     ; Jump to #R$D679 if it is.
 $D66D DEC (HL)       ; Count it down.
 $D66E POP HL         ; Restore the address in the buffer.
 $D66F POP DE         ; Restore the address on the screen.
 $D670 POP BC         ; Restore the width and height.
 $D671 LD A,B         ; {Swap the width and the height.
 $D672 LD B,C         ;
 $D673 LD C,A         ; }
 $D674 CALL $D67C     ; Copy the area to the screen.
 $D677 JR $D666       ; Jump back to #R$D666.
@label=DrawChangedObjects_Copy_RestoreIX
*$D679 POP IX         ; Restore #REGix.
 $D67B RET            ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CEAB }
; { #PENTAGRAM$B19E }
; LIST#

; Copy Block To Screen
;
; Used by the routines at #R$BF45, #R$C3A4, #R$C432 and #R$D59F.
; .
; Copies an area of the screen buffer to the screen, a line at a time.
;
; B Number of lines
; C Number of bytes in a line
; DE Address of the first line on the screen
; HL Address of the first line in the buffer
@label=CopyBlockToScreen
c$D67C PUSH BC       ; Stash the number of lines and the number of bytes.
 $D67D PUSH DE       ; Stash the address on the screen.
 $D67E PUSH HL       ; Stash the address in the buffer.
 $D67F LD B,$00      ; Clear #REGb.
 $D681 LDIR          ; Copy the line.
 $D683 POP HL        ; Restore the address in the buffer.
 $D684 LD DE,$0020   ; Set #REGde to the length of a line.
 $D687 ADD HL,DE     ; Move on to the next line in the buffer.
 $D688 POP DE        ; Restore the address on the screen.
 $D689 DEC D         ; Go up one line on the screen.
 $D68A LD A,D        ; {Test whether that has gone into the character row
 $D68B CPL           ; above.}
 $D68C AND %00000111 ; Keep the bits of the line within the character row.
 $D68E JR NZ,$D69A   ; Jump to #R$D69A if it has not.
 $D690 LD A,E        ; {Go up one character row.
 $D691 SUB $20       ; }
 $D693 LD E,A        ; Store it.
 $D694 JR C,$D69A    ; Jump to #R$D69A if that has gone into the third of the
                     ; screen above.
 $D696 LD A,D        ; {Put the line at the bottom of the character row.
 $D697 ADD A,$08     ; }
 $D699 LD D,A        ; Store it.
@label=CopyBlockToScreen_Next
*$D69A POP BC        ; Restore the number of lines and the number of bytes.
 $D69B DJNZ $D67C    ; Jump back to #R$D67C until all of the lines are copied.
 $D69D RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CF85 }
; { #PENTAGRAM$B278 }
; LIST#

; Build Lookup Tables
;
; Used by the routine at #R$AF88.
; .
; Builds the two tables that the sprite routines use. The first is the set
; of tables of shifted bytes in pages #N$F2 to #N$FF: for each shift of one to
; seven bits to the right there is a page with the inverse of every byte
; shifted, and a page after it with the inverse of the bits that are pushed out
; into the next byte. The second is the table at #R$F100 of every byte with its
; bits reversed.
@label=BuildLookupTables
c$D69E LD L,$00      ; Start with the byte zero.
@label=BuildLookupTables_Shift
*$D6A0 LD D,$00      ; Clear the high byte of the shifted value.
 $D6A2 LD E,L        ; Set the low byte of the shifted value to the byte.
 $D6A3 LD H,$FF      ; Point #REGh at the last page of the table.
 $D6A5 LD B,$07      ; Set the number of shifts to #N$07.
@label=BuildLookupTables_Shift_Step
*$D6A7 SLA E         ; Shift the value left one bit.
 $D6A9 RL D          ; Shift the carry into the high byte.
 $D6AB LD A,E        ; Fetch the low byte.
 $D6AC CPL           ; Invert it.
 $D6AD LD (HL),A     ; Store it in the table.
 $D6AE DEC H         ; Go to the page before.
 $D6AF LD A,D        ; Fetch the high byte.
 $D6B0 CPL           ; Invert it.
 $D6B1 LD (HL),A     ; Store it in the table.
 $D6B2 DEC H         ; Go to the page before.
 $D6B3 DJNZ $D6A7    ; Jump back to #R$D6A7 until all of the shifts are done.
 $D6B5 INC L         ; Go on to the next byte.
 $D6B6 JR NZ,$D6A0   ; Jump back to #R$D6A0 until all of the bytes are done.
 $D6B8 LD HL,$F100   ; Point #REGhl at #R$F100.
@label=BuildLookupTables_Reverse
*$D6BB LD D,L        ; Take the byte that is to be reversed.
 $D6BC LD B,$08      ; Set the number of bits to #N$08.
@label=BuildLookupTables_Reverse_Bit
*$D6BE SRL D         ; Shift a bit out of the byte.
 $D6C0 RL E          ; Shift it into the reversed byte.
 $D6C2 DJNZ $D6BE    ; Jump back to #R$D6BE until all of the bits are done.
 $D6C4 LD (HL),E     ; Store the reversed byte in the table.
 $D6C5 INC L         ; Go on to the next byte.
 $D6C6 JR NZ,$D6BB   ; Jump back to #R$D6BB until all of the bytes are done.
 $D6C8 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CFA7 }
; { #PENTAGRAM$B29A }
; LIST#

; Calculate Pixel Coordinates
;
; Used by the routines at #R$C00E, #R$CD33 and #R$D704.
; .
; Works out the pixel coordinates of an object on the screen from its X, Y
; and Z coordinates. The pixel X coordinate is X + Y - #N$80 and the pixel Y
; coordinate (from the bottom of the screen) is half of Y - X + #N$80, plus Z,
; less #N$68, each with the adjustments of the object added.
;
; IX Address of the object
; O:F The carry flag is set if the sprite is on the screen, and reset if
; it is off the top
@label=CalculatePixelCoordinates
c$D6C9 LD A,(IX+$01)  ; {Add the Y coordinate to the X coordinate.
 $D6CC ADD A,(IX+$02) ; }
 $D6CF SUB $80        ; Take #N$80 off it.
 $D6D1 ADD A,(IX+$12) ; Add the adjustment of the pixel X coordinate.
 $D6D4 LD (IX+$1A),A  ; Set the pixel X coordinate.
 $D6D7 LD A,(IX+$02)  ; {Take the X coordinate off the Y coordinate.
 $D6DA SUB (IX+$01)   ; }
 $D6DD ADD A,$80      ; Add #N$80.
 $D6DF SRL A          ; Halve it.
 $D6E1 ADD A,(IX+$03) ; Add the Z coordinate.
 $D6E4 SUB $68        ; Take #N$68 off it.
 $D6E6 ADD A,(IX+$13) ; Add the adjustment of the pixel Y coordinate.
 $D6E9 LD (IX+$1B),A  ; Set the pixel Y coordinate.
 $D6EC CP $C0         ; Compare it with the number of lines of the screen.
 $D6EE RET            ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CFD2 }
; { #PENTAGRAM$B2C5 }
; LIST#

; Get Sprite Address
;
; Used by the routines at #R$CD33 and #R$D718.
; .
; Finds the sprite for the graphic number of an object. The data of the
; sprite is flipped, in place, if it is not the same way round as the flags of
; the object say. If there is no sprite for the graphic number, this returns to
; the routine that called the routine that called it.
;
;   IX Address of the object
; O:DE Address of the sprite
@label=GetSpriteAddress
c$D6EF LD L,(IX+$00) ; {Make the graphic number into a 16-bit number.
 $D6F2 LD H,$00      ; }
 $D6F4 ADD HL,HL     ; Double it.
 $D6F5 LD BC,$7112   ; Point #REGbc at #R$7112.
 $D6F8 ADD HL,BC     ; Add the two.
 $D6F9 LD E,(HL)     ; {Fetch the address of the sprite.
 $D6FA INC HL        ;
 $D6FB LD D,(HL)     ; }
 $D6FC LD A,(DE)     ; {Fetch the width of the sprite and test it.
 $D6FD AND A         ; }
 $D6FE JP NZ,$D865   ; Jump to #R$D865 if there is a sprite, to flip it if
                     ; needed.
 $D701 INC SP        ; {Drop the return address.
 $D702 INC SP        ; }
 $D703 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CFFE }
; { #PENTAGRAM$B2EE }
; LIST#

; Draw Object
;
; Used by the routine at #R$D000.
; .
; Draws an object into the screen buffer. An object that has the graphic
; number #N$01 is removed instead, by making it null.
;
; IX Address of the object
@label=DrawObject
c$D704 LD A,(IX+$00)   ; {Fetch the graphic number and test whether it is the one that removes
 $D707 CP $01          ; the object.}
 $D709 JR NZ,$D710     ; Jump to #R$D710 if it is not.
 $D70B LD (IX+$00),$00 ; Make the graphic number null.
 $D70F RET             ; Return.
@label=DrawNextObject_Draw
*$D710 RES 4,(IX+$07)  ; Flag the object as not to be drawn.
 $D714 CALL $D6C9      ; Work out the pixel coordinates.
 $D717 RET NC          ; Return if the sprite is off the top of the screen.
; Continue on to #R$D718.
; .
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$D013 }
; { #PENTAGRAM$B3D3 }
; LIST#

; Print Sprite
;
; Used by the routines at #R$BC7A, #R$BEE4, #R$BF45, #R$C3A4 and #R$D24C.
; .
; Draws the sprite of an object into the screen buffer, at the pixel
; coordinates of the object. The sprite is made of pairs of bytes, a mask byte
; and then a data byte, which are put on the buffer with the mask clearing the
; background. A sprite that does not start on a byte boundary has each pair
; shifted across two bytes, with the tables built by #R$D69E. The routine copies
; the sprite with unrolled code, which it enters part of the way along, so that
; it does as many columns as the sprite has. To do this it changes the code, and
; it uses the stack pointer to read the data of the sprite, so the interrupts
; have to be off.
;
; IX Address of the object
@label=PrintSprite
c$D718 CALL $D6EF     ; Find the sprite.
 $D71B LD A,(IX+$1A)  ; Fetch the pixel X coordinate.
 $D71E AND %00000111  ; Keep the bits of the position in the byte.
 $D720 JR Z,$D76F     ; Jump to #R$D76F if the sprite is on a byte boundary.
 $D722 RLCA           ; Double the number of bits.
 $D723 AND %00001110  ; Keep it.
 $D725 OR %11110000   ; Make it the page of the table of shifted bytes.
 $D727 LD H,A         ; Stash the page in #REGh.
 $D728 LD A,(DE)      ; {Fetch the width of the sprite, and move on to the
 $D729 INC DE         ; height.}
 $D72A AND %00000111  ; Keep the width.
 $D72C INC A          ; Add one for the byte that the shifted sprite spills
                      ; into.
 $D72D LD B,A         ; Stash it in #REGb.
 $D72E LD (IX+$18),A  ; Set the width in bytes of the object.
 $D731 DEC A          ; Take one off it to work out the number of pairs, less
                      ; one.
 $D732 AND %00000111  ; Keep it in the low three bits.
 $D734 ADD A,A        ; {Multiply it by sixteen, which is the size of the code
 $D735 ADD A,A        ; for a pair.
 $D736 ADD A,A        ;
 $D737 ADD A,A        ; }
 $D738 NEG            ; Negate it.
 $D73A ADD A,$50      ; Add #N$50 to get the offset from the end of the
                      ; unrolled code.
@label=PrintSprite_Patch
*$D73C LD ($D7AD),A   ; Change the offset of the jump into the unrolled code.
 $D73F LD A,B         ; Fetch the width in bytes.
 $D740 CPL            ; Invert it.
 $D741 ADD A,$22      ; Add #N$22 to get the step from the end of one line to the start of
                      ; the next.
 $D743 LD ($D801),A   ; Change the step in the code.
 $D746 LD A,(DE)      ; {Fetch the height of the sprite, and move on to the
 $D747 INC DE         ; data.}
 $D748 LD (IX+$19),A  ; Set the height in lines of the object.
 $D74B ADD A,(IX+$1B) ; Add the pixel Y coordinate.
 $D74E SUB $C0        ; Take the number of lines on the screen off it.
 $D750 JR C,$D75A     ; Jump to #R$D75A if the sprite does not go off the top
                      ; of the screen.
 $D752 NEG            ; Make the number of lines that are off the screen
                      ; positive.
 $D754 ADD A,(IX+$19) ; Take it off the height.
 $D757 LD (IX+$19),A  ; Set the height in lines of the object.
@label=PrintSprite_Draw
*$D75A LD C,(IX+$1A)  ; Fetch the pixel X coordinate.
 $D75D LD B,(IX+$1B)  ; Fetch the pixel Y coordinate.
 $D760 CALL $D811     ; Find the address in the screen buffer.
 $D763 LD ($5BA9),SP  ; Keep the stack pointer.
 $D767 EX DE,HL       ; {Point the stack pointer at the data of the sprite.
 $D768 LD SP,HL       ;
 $D769 EX DE,HL       ; }
 $D76A LD A,(IX+$19)  ; Fetch the number of lines.
 $D76D JR $D7AA       ; Jump to #R$D7AA.
; The sprite is on a byte boundary, so the bytes do not need to be
; shifted.
@label=PrintSprite_Aligned
*$D76F LD A,(DE)      ; {Fetch the width of the sprite, and move on to the
 $D770 INC DE         ; height.}
 $D771 AND %00001111  ; Keep the width.
 $D773 LD (IX+$18),A  ; Set the width in bytes of the object.
 $D776 LD B,A         ; Stash it in #REGb.
 $D777 ADD A,A        ; {Multiply it by eight, which is the size of the code
 $D778 ADD A,A        ; for a column.
 $D779 ADD A,A        ; }
 $D77A NEG            ; Negate it.
 $D77C SUB $06        ; Take #N$06 off it to get the offset from the end of the unrolled
                      ; code.
 $D77E JR $D73C       ; Jump to #R$D73C.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$D027 }
; LIST#

; Draw Aligned Columns
;
; Unrolled code that draws the columns of a sprite that is on a byte
; boundary. Each column of a line takes a pair of bytes off the stack, which are
; the mask and the data, clears the bits of the mask in the byte of the buffer
; and sets the bits of the data. The code is entered at the column that gives
; the number of columns that the sprite has, and the last column carries on at
; #R$D7FF.
;
; .
;
; The first column of a sprite that has five.
@label=DrawAlignedColumns
c$D780 POP DE        ; Take the mask and the data of the column off the stack.
 $D781 LD A,(BC)     ; Fetch the byte of the buffer.
 $D782 CPL           ; {Clear the bits of the mask and set the bits of the
 $D783 OR E          ; data.
 $D784 CPL           ;
 $D785 OR D          ; }
 $D786 LD (BC),A     ; {Store the byte and move on to the next one.
 $D787 INC BC        ; }
; The second column of a sprite that has four or five.
 $D788 POP DE        ; Take the mask and the data of the column off the stack.
 $D789 LD A,(BC)     ; Fetch the byte of the buffer.
 $D78A CPL           ; {Clear the bits of the mask and set the bits of the
 $D78B OR E          ; data.
 $D78C CPL           ;
 $D78D OR D          ; }
 $D78E LD (BC),A     ; {Store the byte and move on to the next one.
 $D78F INC BC        ; }
; The third column of a sprite that has three or more.
 $D790 POP DE        ; Take the mask and the data of the column off the stack.
 $D791 LD A,(BC)     ; Fetch the byte of the buffer.
 $D792 CPL           ; {Clear the bits of the mask and set the bits of the
 $D793 OR E          ; data.
 $D794 CPL           ;
 $D795 OR D          ; }
 $D796 LD (BC),A     ; {Store the byte and move on to the next one.
 $D797 INC BC        ; }
; The fourth column of a sprite that has two or more.
 $D798 POP DE        ; Take the mask and the data of the column off the stack.
 $D799 LD A,(BC)     ; Fetch the byte of the buffer.
 $D79A CPL           ; {Clear the bits of the mask and set the bits of the
 $D79B OR E          ; data.
 $D79C CPL           ;
 $D79D OR D          ; }
 $D79E LD (BC),A     ; {Store the byte and move on to the next one.
 $D79F INC BC        ; }
; The last column.
 $D7A0 POP DE        ; Take the mask and the data of the column off the stack.
 $D7A1 LD A,(BC)     ; Fetch the byte of the buffer.
 $D7A2 CPL           ; {Clear the bits of the mask and set the bits of the
 $D7A3 OR E          ; data.
 $D7A4 CPL           ;
 $D7A5 OR D          ; }
 $D7A6 LD (BC),A     ; Store the byte.
 $D7A7 JP $D7FF      ; Jump to #R$D7FF.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$D08F }
; { #GUNFRIGHT$BE5B }
; { #NIGHTSHADE$E49F }
; { #PENTAGRAM$B44F }
; LIST#

; Draw Lines
;
; Used by the routine at #R$D718.
; .
; Draws the lines of a sprite one after the other. For each line the code
; jumps into the unrolled code, at a place that depends on the width of the
; sprite, and that is set by the jump that is changed by #R$D718. The code for a
; sprite that is not on a byte boundary takes a pair of bytes off the stack,
; which are the mask and the data, shifts them across the two bytes of the
; buffer that they fall into with the table of shifted bytes in #REGh, and keeps
; what is left of the second byte to go with the next pair.
@label=DrawLines
c$D7AA EX AF,AF'     ; Stash the number of lines left.
 $D7AB LD A,(BC)     ; Fetch the first byte of the buffer.
@label=DrawLines_Jump
*$D7AC JR $D7AC      ; Jump into the unrolled code. The jump is changed to go to the right
                     ; place.
; The first pair of a sprite that has five.
 $D7AE POP DE        ; Take the mask and the data of the pair off the stack.
 $D7AF LD L,E        ; {Combine the byte that is carried with the first part of the shifted
 $D7B0 AND (HL)      ; mask and data.
 $D7B1 LD L,D        ;
 $D7B2 XOR (HL)      ;
 $D7B3 CPL           ; }
 $D7B4 LD (BC),A     ; {Store the byte in the buffer and move on to the next
 $D7B5 INC BC        ; one.}
 $D7B6 INC H         ; {Switch to the table of the part that spills over into
 $D7B7 LD L,E        ; the next byte.}
 $D7B8 LD A,(BC)     ; Fetch the next byte of the buffer.
 $D7B9 AND (HL)      ; {Combine it with the second part of the shifted mask and
 $D7BA LD L,D        ; data.
 $D7BB XOR (HL)      ;
 $D7BC CPL           ; }
 $D7BD DEC H         ; Switch back to the first table.
; The second pair of a sprite that has four or five.
 $D7BE POP DE        ; Take the mask and the data of the pair off the stack.
 $D7BF LD L,E        ; {Combine the byte that is carried with the first part of the shifted
 $D7C0 AND (HL)      ; mask and data.
 $D7C1 LD L,D        ;
 $D7C2 XOR (HL)      ;
 $D7C3 CPL           ; }
 $D7C4 LD (BC),A     ; {Store the byte in the buffer and move on to the next
 $D7C5 INC BC        ; one.}
 $D7C6 INC H         ; {Switch to the table of the part that spills over into
 $D7C7 LD L,E        ; the next byte.}
 $D7C8 LD A,(BC)     ; Fetch the next byte of the buffer.
 $D7C9 AND (HL)      ; {Combine it with the second part of the shifted mask and
 $D7CA LD L,D        ; data.
 $D7CB XOR (HL)      ;
 $D7CC CPL           ; }
 $D7CD DEC H         ; Switch back to the first table.
; The third pair of a sprite that has three or more.
 $D7CE POP DE        ; Take the mask and the data of the pair off the stack.
 $D7CF LD L,E        ; {Combine the byte that is carried with the first part of the shifted
 $D7D0 AND (HL)      ; mask and data.
 $D7D1 LD L,D        ;
 $D7D2 XOR (HL)      ;
 $D7D3 CPL           ; }
 $D7D4 LD (BC),A     ; {Store the byte in the buffer and move on to the next
 $D7D5 INC BC        ; one.}
 $D7D6 INC H         ; {Switch to the table of the part that spills over into
 $D7D7 LD L,E        ; the next byte.}
 $D7D8 LD A,(BC)     ; Fetch the next byte of the buffer.
 $D7D9 AND (HL)      ; {Combine it with the second part of the shifted mask and
 $D7DA LD L,D        ; data.
 $D7DB XOR (HL)      ;
 $D7DC CPL           ; }
 $D7DD DEC H         ; Switch back to the first table.
; The fourth pair of a sprite that has two or more.
 $D7DE POP DE        ; Take the mask and the data of the pair off the stack.
 $D7DF LD L,E        ; {Combine the byte that is carried with the first part of the shifted
 $D7E0 AND (HL)      ; mask and data.
 $D7E1 LD L,D        ;
 $D7E2 XOR (HL)      ;
 $D7E3 CPL           ; }
 $D7E4 LD (BC),A     ; {Store the byte in the buffer and move on to the next
 $D7E5 INC BC        ; one.}
 $D7E6 INC H         ; {Switch to the table of the part that spills over into
 $D7E7 LD L,E        ; the next byte.}
 $D7E8 LD A,(BC)     ; Fetch the next byte of the buffer.
 $D7E9 AND (HL)      ; {Combine it with the second part of the shifted mask and
 $D7EA LD L,D        ; data.
 $D7EB XOR (HL)      ;
 $D7EC CPL           ; }
 $D7ED DEC H         ; Switch back to the first table.
; The last pair.
 $D7EE POP DE        ; Take the mask and the data of the pair off the stack.
 $D7EF LD L,E        ; {Combine the byte that is carried with the first part of the shifted
 $D7F0 AND (HL)      ; mask and data.
 $D7F1 LD L,D        ;
 $D7F2 XOR (HL)      ;
 $D7F3 CPL           ; }
 $D7F4 LD (BC),A     ; {Store the byte in the buffer and move on to the next
 $D7F5 INC BC        ; one.}
 $D7F6 INC H         ; {Switch to the table of the part that spills over into
 $D7F7 LD L,E        ; the next byte.}
 $D7F8 LD A,(BC)     ; Fetch the next byte of the buffer.
 $D7F9 AND (HL)      ; {Combine it with the second part of the shifted mask and
 $D7FA LD L,D        ; data.
 $D7FB XOR (HL)      ;
 $D7FC CPL           ; }
 $D7FD DEC H         ; Switch back to the first table.
 $D7FE LD (BC),A     ; Store the last byte of the line.
; This entry point is used by the routine at #R$D780.
@label=DrawLines_Next
*$D7FF LD A,C        ; Fetch the low byte of the address in the buffer.
 $D800 ADD A,$00     ; Add the step to the start of the next line, which is changed for the
                     ; width of the sprite.
 $D802 LD C,A        ; Store it.
 $D803 LD A,B        ; Fetch the high byte of the address in the buffer.
 $D804 ADC A,$00     ; Add the carry, as the step is a single byte.
 $D806 LD B,A        ; Store it.
 $D807 EX AF,AF'     ; Restore the number of lines left.
 $D808 DEC A         ; Count down the lines.
 $D809 JP NZ,$D7AA   ; Jump back to #R$D7AA until all of the lines are drawn.
 $D80C LD SP,($5BA9) ; Restore the stack pointer.
 $D810 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$D0B9 }
; { #PENTAGRAM$B479 }
; LIST#

; Calculate Buffer Address
;
; Used by the routines at #R$BE31, #R$BE4C, #R$BF45, #R$C432, #R$D59F and
; #R$D718.
; .
; Finds the address in the screen buffer of the byte that holds a pixel.
; The buffer has the lines of the screen from the bottom, #N$20 bytes to a line.
;
;   B Pixel Y coordinate
;   C Pixel X coordinate
; O:BC Address in the buffer
@label=CalculateBufferAddress
c$D811 PUSH HL       ; Stash #REGhl.
 $D812 SRL B         ; {Divide #REGbc by two.
 $D814 RR C          ; }
 $D816 SRL B         ; {Divide #REGbc by four.
 $D818 RR C          ; }
 $D81A SRL B         ; {Divide #REGbc by eight, to make the number of the byte.
 $D81C RR C          ; }
 $D81E LD HL,$D8F3   ; Point #REGhl at #R$D8F3.
 $D821 ADD HL,BC     ; Add the two.
 $D822 LD C,L        ; {Put the address in #REGbc.
 $D823 LD B,H        ; }
 $D824 POP HL        ; Restore #REGhl.
 $D825 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$D120 }
; { #PENTAGRAM$B37F }
; LIST#

; Calculate Screen Address
;
; Used by the routines at #R$BF45, #R$C432 and #R$D59F.
; .
; Finds the address on the screen of the byte that holds a pixel.
;
;   B Pixel Y coordinate (from the bottom of the screen)
;   C Pixel X coordinate
; O:DE Address on the screen
@label=CalculateScreenAddress
c$D826 LD A,C        ; {Fetch the pixel X coordinate and move it right by three
 $D827 RRCA          ; bits.
 $D828 RRCA          ;
 $D829 RRCA          ; }
 $D82A AND %00011111 ; Keep the byte of the line.
 $D82C LD E,A        ; Stash it in #REGe.
 $D82D LD A,B        ; {Fetch the pixel Y coordinate, inverted to get the line
 $D82E CPL           ; from the top.}
 $D82F AND %00000111 ; Keep the line within the character row.
 $D831 EX AF,AF'     ; Stash it in the alternate #REGa.
 $D832 LD A,B        ; {Invert the pixel Y coordinate again and move it left by
 $D833 CPL           ; two bits.
 $D834 RLCA          ;
 $D835 RLCA          ; }
 $D836 AND %11100000 ; Keep the character row within the third, in the high
                     ; bits.
 $D838 OR E          ; Add the byte of the line.
 $D839 LD E,A        ; Store the low byte of the address in #REGe.
 $D83A LD A,B        ; {Invert the pixel Y coordinate again.
 $D83B CPL           ; }
 $D83C RRCA          ; {Move the third of the screen into bits 3 and 4.
 $D83D RRCA          ;
 $D83E RRCA          ; }
 $D83F AND %00011000 ; Keep it.
 $D841 LD D,A        ; Stash it in #REGd.
 $D842 EX AF,AF'     ; Fetch the line within the character row.
 $D843 OR D          ; Add the third of the screen.
 $D844 ADD A,$38     ; Add #N$38, to make the high byte of the address.
 $D846 LD D,A        ; Store the high byte of the address in #REGd.
 $D847 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$D135 }
; { #PENTAGRAM$B394 }
; LIST#

; Calculate Attribute Address
;
; Used by the routines at #R$BE4C and #R$BF45.
; .
; Finds the address in the attributes of the character square that holds a
; pixel.
;
;   H Pixel Y coordinate (from the bottom of the screen)
;   L Pixel X coordinate
; O:DE Address of the attribute
@label=CalculateAttributeAddress
c$D848 PUSH HL       ; Stash #REGhl.
 $D849 LD A,H        ; {Invert the pixel Y coordinate, to get the line from the
 $D84A CPL           ; top.
 $D84B LD H,A        ; }
 $D84C SRL H         ; {Move the line into the low bits of the high byte.
 $D84E SRL H         ;
 $D850 SRL H         ;
 $D852 SRL H         ; }
 $D854 RR L          ; Move the lowest bit of the line into the low byte.
 $D856 SRL H         ; {Move the next bit.
 $D858 RR L          ; }
 $D85A SRL H         ; {Move the next bit, so that #REGhl holds the number of
 $D85C RR L          ; the square.}
 $D85E LD DE,$5700   ; Point #REGde at the attributes of the screen, less one
                     ; page.
 $D861 ADD HL,DE     ; Add the two.
 $D862 EX DE,HL      ; Put the address in #REGde.
 $D863 POP HL        ; Restore #REGhl.
 $D864 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$D157 }
; { #PENTAGRAM$B3B6 }
; LIST#

; Flip Sprite
;
; Used by the routine at #R$D6EF.
; .
; Flips the data of a sprite in place, if its flags are not the same as
; the flags of the object that is going to be drawn. The width byte of a sprite
; has the vertical flip in bit 7 and the horizontal flip in bit 6. The sprite is
; flipped vertically by swapping its lines, and horizontally by reversing the
; bits of each byte and the order of the bytes of each line, with the table of
; reversed bytes.
;
;   DE Address of the sprite
;   IX Address of the object
; O:DE Address of the sprite
@label=FlipSprite
c$D865 PUSH DE       ; Stash the address of the sprite.
 $D866 LD A,(DE)     ; Fetch the width of the sprite.
 $D867 XOR (IX+$07)  ; Compare the vertical flip with the one of the object.
 $D86A AND %10000000 ; Keep it.
 $D86C JR Z,$D8A2    ; Jump to #R$D8A2 if they are the same.
 $D86E LD A,(DE)     ; Fetch the width byte of the sprite.
 $D86F XOR %10000000 ; Toggle the vertical flip.
 $D871 LD (DE),A     ; Store the width.
 $D872 RLCA          ; Double the width, for the mask and the data.
 $D873 AND %00011110 ; Keep the doubled width and drop the flags.
 $D875 LD B,A        ; Stash it in #REGb.
 $D876 INC DE        ; Point #REGde at the height of the sprite.
 $D877 LD A,(DE)     ; {Fetch the height and stash it in #REGc.
 $D878 LD C,A        ; }
 $D879 INC DE        ; Point #REGde at the data.
 $D87A PUSH DE       ; Stash the address of the data.
 $D87B LD E,B        ; {Set #REGde to the number of bytes in a line.
 $D87C LD D,$00      ; }
 $D87E CALL $D4F9    ; Multiply it by the height.
 $D881 POP DE        ; Restore the address of the data.
 $D882 ADD HL,DE     ; Add the number of bytes of data.
 $D883 EX DE,HL      ; Point #REGde at the end of the data, and #REGhl at the
                     ; start.
 $D884 LD A,B        ; {Add the number of bytes in a line to #REGhl.
 $D885 CALL $D4F2    ; }
 $D888 DEC DE        ; Point #REGde at the last byte of the last line.
 $D889 DEC HL        ; Point #REGhl at the last byte of the first line.
 $D88A SRL C         ; Halve the height to get the number of pairs of lines.
@label=FlipSprite_Lines
*$D88C PUSH BC       ; Stash the number of bytes in a line and the number of
                     ; pairs.
@label=FlipSprite_Bytes
*$D88D LD A,(DE)     ; Fetch a byte of the last line.
 $D88E LD C,(HL)     ; Fetch a byte of the first line.
 $D88F LD (HL),A     ; Store the byte of the last line in the first line.
 $D890 LD A,C        ; Fetch the byte of the first line.
 $D891 LD (DE),A     ; Store it in the last line.
 $D892 DEC HL        ; Go back a byte in the first line.
 $D893 DEC DE        ; Go back a byte in the last line.
 $D894 DJNZ $D88D    ; Jump back to #R$D88D until the lines are swapped.
 $D896 POP BC        ; Restore the number of bytes in a line and the number of
                     ; pairs.
 $D897 LD A,B        ; {Add the number of bytes in a line to the address in
 $D898 CALL $D4F2    ; #REGhl.}
 $D89B LD A,B        ; {Add it again, to go to the end of the next line.
 $D89C CALL $D4F2    ; }
 $D89F DEC C         ; Count down the pairs of lines.
 $D8A0 JR NZ,$D88C   ; Jump back to #R$D88C until all of the pairs are swapped.
@label=FlipSprite_Horizontal
*$D8A2 POP DE        ; {Fetch the address of the sprite and keep it on the
 $D8A3 PUSH DE       ; stack.}
 $D8A4 LD A,(DE)     ; Fetch the width of the sprite.
 $D8A5 XOR (IX+$07)  ; Compare the horizontal flip with the one of the object.
 $D8A8 AND %01000000 ; Keep it.
 $D8AA JR Z,$D8DC    ; Jump to #R$D8DC if they are the same.
 $D8AC LD A,(DE)     ; Fetch the width byte of the sprite.
 $D8AD XOR %01000000 ; Toggle the horizontal flip.
 $D8AF LD (DE),A     ; Store the width.
 $D8B0 AND %00001111 ; Keep the width.
 $D8B2 LD B,A        ; {Stash it in #REGb and #REGc.
 $D8B3 LD C,A        ; }
 $D8B4 INC DE        ; Point #REGde at the height of the sprite.
 $D8B5 LD A,(DE)     ; Fetch the height.
 $D8B6 EX AF,AF'     ; Stash it in the alternate #REGa.
 $D8B7 INC DE        ; Point #REGde at the data.
 $D8B8 EX DE,HL      ; Point #REGhl at the data.
 $D8B9 PUSH HL       ; Stash the address of the data.
 $D8BA EXX           ; Switch to the alternate registers.
 $D8BB POP HL        ; Restore the address of the data.
 $D8BC LD B,$F1      ; Point #REGbc at the table of reversed bytes.
 $D8BE EXX           ; Switch back to the main registers.
@label=FlipSprite_Line
*$D8BF EXX           ; Switch to the alternate registers.
 $D8C0 LD C,(HL)     ; Fetch the mask byte of a pair.
 $D8C1 LD A,(BC)     ; Find the reversed byte.
 $D8C2 LD E,A        ; Stash it in #REGe.
 $D8C3 INC HL        ; Move on.
 $D8C4 LD C,(HL)     ; Fetch the data byte of the pair.
 $D8C5 LD A,(BC)     ; Find the reversed byte.
 $D8C6 LD D,A        ; Stash it in #REGd.
 $D8C7 INC HL        ; Move on.
 $D8C8 PUSH DE       ; Stash the reversed pair on the stack.
 $D8C9 EXX           ; Switch back to the main registers.
 $D8CA DJNZ $D8BF    ; Jump back to #R$D8BF until all of the pairs of the line are on the
                     ; stack.
 $D8CC LD B,C        ; Set the number of pairs.
@label=FlipSprite_Store
*$D8CD POP DE        ; Restore a reversed pair, which comes off in the opposite
                     ; order.
 $D8CE LD (HL),E     ; {Store the mask byte, and move on.
 $D8CF INC HL        ; }
 $D8D0 LD (HL),D     ; {Store the data byte, and move on.
 $D8D1 INC HL        ; }
 $D8D2 DJNZ $D8CD    ; Jump back to #R$D8CD until the line is stored.
 $D8D4 EX AF,AF'     ; Fetch the number of lines left.
 $D8D5 DEC A         ; Count down the lines.
 $D8D6 JR Z,$D8DC    ; Jump to #R$D8DC if all of the lines are done.
 $D8D8 EX AF,AF'     ; Stash the number of lines left.
 $D8D9 LD B,C        ; Set the number of pairs.
 $D8DA JR $D8BF      ; Jump back to #R$D8BF.
@label=FlipSprite_Done
*$D8DC POP DE        ; Restore the address of the sprite.
 $D8DD RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$D174 }
; { #NIGHTSHADE$E353 }
; LIST#

; Copyright Message
;
; The copyright message of the programmers, which is never printed or used
; by the game. The text is stored as plain ASCII, unlike the text that the game
; does print, which is stored as numbers in the font.
@label=CopyrightMessage
t$D8DE DEFM "COPYRIGHT 1984 A.C.G." ; "COPYRIGHT 1984 A.C.G."

; Screen Buffer
;
; The buffer that the game draws into before it is copied to the screen by
; #R$D56F. It has a byte for every eight pixels of the screen, with #N$20 bytes
; to a line, and the lines are in the order from the bottom of the screen to the
; top, so the first byte is at the bottom left of the screen and a line above is
; #N$20 bytes further on. The pixels of the buffer are #N$00 for a pixel that is
; not set.
@label=ScreenBuffer
g$D8F3 DEFS $17      ; The start of the bottom line of the screen.
@label=ScreenBuffer_SunMoonWindow
 $D90A DEFS $20      ; {The position of the window of the sun and the moon.
 $D92A DEFS $20      ;
 $D94A DEFS $20      ;
 $D96A DEFS $20      ;
 $D98A DEFS $20      ;
 $D9AA DEFS $20      ;
 $D9CA DEFS $20      ; }
