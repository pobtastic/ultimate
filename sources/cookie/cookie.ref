;
; SkoolKit ref file for Cookie
;
; To build the HTML disassembly, run these commands:
;   tap2sna.py @cookie.t2s
;   sna2skool.py -H -c sources/cookie/cookie.ctl Cookie.z80 > sources/cookie/cookie.skool
;   skool2html.py -H sources/cookie/cookie.skool -T dark -T wide -toOa

[Config]
Expand=#INCLUDE(Expand)
RefFiles=../analytics.ref;../bases.ref;changelog.ref;data.ref;pokes.ref;cookieGraphics.ref;sounds.ref
HtmlWriterClass=sources:linking.UltimateHtmlWriter
GameDir=ultimate/cookie

[Game]
Game=Cookie
Logo=#SCR$01,$04,$00,$18,$08,$4000,$5800(/images/logo)
Copyright=&copy; 1983 Ashby Computers &amp; Graphics Ltd<br />&copy; Rare Ltd<br />&copy; 2026 ArcadeGeek LTD.
Repository=https://github.com/pobtastic/ultimate/tree/main/sources/cookie/
StyleSheet=skoolkit.css;skoolkit-dark.css;skoolkit-wide.css;cookie.css
LinkInternalOperands=1
AddressAnchor={address#IF({base}==16)(:04x)}

[PageHeaders]
GameIndex=The complete<>RAM disassembly (work in progress)

[Index]
MemoryMaps
Graphics
DataTables
Reference

[Index:Graphics:Graphics And Sounds]
Player
Ingredients
Nasties
Sound

[Index:Reference:Reference]
Changelog
Glossary
Facts
Bugs
