; 3-byte representation of the score.
@label=High_Score
g$5F09 DEFB $00      ; Byte #1.
@label=High_Score_2
 $5F0A DEFB $00      ; Byte #2.
@label=High_Score_3
 $5F0B DEFB $00      ; Byte #3.
; View the equivalent code in;
; #LIST
; { #JETPAC$5CF0 }
