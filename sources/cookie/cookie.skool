i$5B00

; Game Entry Point
;
; The address which the game is started from. It moves the main body of
; the game down by one byte, and then jumps to it.
@label=GameEntry
c$5B80 DI            ; Disable interrupts.
 $5B81 LD HL,$5F01   ; {Move #N$20FF bytes from #N$5F01 to #N$5F00.
 $5B84 LD DE,$5F00   ;
 $5B87 LD BC,$20FF   ;
 $5B8A LDIR          ; }
 $5B8C JP $5F00      ; Jump to #R$5F00.
; View the equivalent code in;
; #LIST
; { #JETPAC$5B80 }
; { #PSSST$5B80 }
; { #SABREWULF$6000 }
; { #TRANZAM$5B80 }
; { #UNDERWURLDE$67F2 }
; LIST#
; .
; Later Ultimate games use more advanced decryption mechanisms;
; #LIST
; { #ATICATAC$5B80 }
; { #LUNARJETMAN$5B80 }
; LIST#

i$5B8F

; Security Check
;
; Used by the routine at #R$5B80.
; .
; The game only starts when the second byte of #SKOOLKID$5C78(FRAMES) is
; #N$32. If it is any other value then this returns to the caller instead.
@label=SecurityCheck
c$5F00 LD A,($5C79)  ; Fetch the second byte of #SKOOLKID$5C78(FRAMES).
 $5F03 CP $32        ; {Return if the second byte of #SKOOLKID$5C78(FRAMES) is
 $5F05 RET NZ        ; not "2".}
 $5F06 JP $6298      ; Start the game by jumping to #R$6298.
; View the equivalent code in;
; #LIST
; { #ATICATAC$6000 }
; { #JETPAC$61E5 }
; { #LUNARJETMAN$8000 }
; { #PSSST$61C6 }
; { #SABREWULF$995A }
; { #TRANZAM$5F00 }
; LIST#

; High Score
