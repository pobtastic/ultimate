; { #N$2B | Batter | #R$655C }
; { #N$2C-#N$30 | Cake | #R$64F4 }
; TABLE#
@label=ActorHandlers
w$6486 DEFW $7152
 $6488 DEFW $7048
 $648A DEFW $7048
 $648C DEFW $6F78
 $648E DEFW $7281
 $6490 DEFW $7281
 $6492 DEFW $6D89
 $6494 DEFW $6D89
 $6496 DEFW $6CB7
 $6498 DEFW $6CB7
 $649A DEFW $6C31
 $649C DEFW $6C31
 $649E DEFW $7152
 $64A0 DEFW $6AA0
 $64A2 DEFW $6B8B
 $64A4 DEFW $6B18
 $64A6 DEFW $69D4
 $64A8 DEFW $69D4
 $64AA DEFW $6930
 $64AC DEFW $6930
 $64AE DEFW $669B
 $64B0 DEFW $669B
 $64B2 DEFW $689A
 $64B4 DEFW $7152
 $64B6 DEFW $6BAF
 $64B8 DEFW $6888
 $64BA DEFW $6765
 $64BC DEFW $6765
 $64BE DEFW $6765
 $64C0 DEFW $6765
 $64C2 DEFW $6996
 $64C4 DEFW $6996
 $64C6 DEFW $6996
 $64C8 DEFW $6996
 $64CA DEFW $6996
 $64CC DEFW $6996
 $64CE DEFW $6607
 $64D0 DEFW $6607
 $64D2 DEFW $65E8
 $64D4 DEFW $65E8
