; { #PSSST$5E00 }
; { #TRANZAM$5E49 }
; LIST#

; Game Options
;
; #TABLE(default,centre,centre)
; { =h Byte | =h Binary | =h Option }
; { #N$00 | #EVAL($00, 2, 8) | 1UP Game + Keyboard }
; { #N$01 | #EVAL($01, 2, 8) | 2UP Game + Keyboard }
; { #N$02 | #EVAL($02, 2, 8) | 1UP Game + Kempston Joystick }
; { #N$03 | #EVAL($03, 2, 8) | 2UP Game + Kempston Joystick }
; { #N$04 | #EVAL($04, 2, 8) | 1UP Game + Cursor Joystick }
; { #N$05 | #EVAL($05, 2, 8) | 2UP Game + Cursor Joystick }
; TABLE#
; .
; Bit 0 is set for a two player game. The number in bits 1-2 chooses the
; controls; #N$00 is the keyboard, #N$01 is the Kempston joystick and #N$02 is
; the cursor joystick.
@label=GameOptions
g$5F0C DEFB $00
; View the equivalent code in;
; #LIST
; { #JETPAC$5CF3 }
; { #PSSST$5E03 }
; { #UNDERWURLDE$8ED5 }
; LIST#

; Sound Mute Flag
;
; Zero when the sound is on. Any other value means the sound is muted, and
; the tunes which are played by #R$6568 are skipped. It is set by #R$6298 from
; a checksum of the #SKOOLKID$03B5(BEEPER) routine.
@label=Sound_Enable
g$5F0D DEFB $00

; 1UP Score
;
; 3-byte representation of the score.
@label=1UP_Score_1
g$5F0E DEFB $00      ; Byte #1.
@label=1UP_Score_2
 $5F0F DEFB $00      ; Byte #2.
@label=1UP_Score_3
 $5F10 DEFB $00      ; Byte #3.

; 2UP Score
;
; 3-byte representation of the score.
@label=2UP_Score_1
g$5F11 DEFB $00      ; Byte #1.
@label=2UP_Score_2
 $5F12 DEFB $00      ; Byte #2.
@label=2UP_Score_3
 $5F13 DEFB $00      ; Byte #3.

; Old Sprite
;
; The position and sprite ID of the actor, as recorded by #R$76D0 before
; the actor was moved. The sprite is erased from here by #R$75CC.
@label=OldSprite_X
g$5F14 DEFB $00      ; Horizontal co-ordinate.
@label=OldSprite_Y
 $5F15 DEFB $00      ; Vertical co-ordinate (the bottom edge of the sprite).
@label=OldSprite_ID
 $5F16 DEFB $00      ; Sprite ID.

; Actor Sprite Rows
;
; The number of rows of the actor sprite which are on the screen. This is
; used to work out how many rows of attribute cells to colour.
@label=ActorSprite_Rows
g$5F17 DEFB $00

; Actor Sprite Width
;
; The width of the actor sprite in character cells; #N$02 when it is
; aligned to a character cell, otherwise #N$03.
@label=ActorSprite_Width
g$5F18 DEFB $00

; Sprite Rows Remaining
;
; The number of rows of the old sprite which have not yet been drawn.
@label=OldSprite_RowsRemaining
g$5F19 DEFB $00
@label=ActorSprite_RowsRemaining
 $5F1A DEFB $00

; Actors In Play
;
; Set to zero at the start of each pass through the actors, and increased
; by one by the handlers of the actors which are in play.
@label=ActorsInPlay
g$5F1B DEFB $00
@label=ActorsInPlay_Last
 $5F1C DEFB $00

; Frame Counter
;
; Increased by one after each pass through the actors.
@label=FrameCounter
g$5F1D DEFW $0000

; Actor Sprite Position
;
; The position of the actor sprite, used by #R$74EE to find the first
; attribute cell to colour.
@label=ActorSprite_Position
g$5F1F DEFW $0000

; Active Player
;
; The currently active player. It is toggled with a CPL command by
; #R$6BAF when the turn changes, so it is either #N$00 or #N$FF.
; #TABLE(default,centre,centre)
; { =h Value | =h Player }
; { #N$00 | 1UP }
; { #N$FF | 2UP }
; TABLE#
@label=Flag_ActivePlayer
g$5F21 DEFB $00

; Last Frame
;
; The low byte of #SKOOLKID$5C78(FRAMES) at the last frame update. The
; main loop at #R$6463 runs #R$7160 whenever this is different from the current
; value (#SKOOLKID$5C78(FRAMES) is increased by every interrupt).
@label=LastFrame
g$5F22 DEFB $00

; Frame Updated
;
; Has the frame been updated? #N$00=No #N$01=Yes.
@label=FrameUpdated
g$5F23 DEFB $00

; Current menu item colour attribute
;
; Current menu item colour attribute.
@label=Current_MenuAttribute
g$5F24 DEFB $00

; Game Delay Timer
;
; At the beginning of each player turn there is a delay to allow the
; player to be ready for play. It is counted down by #R$7048, and no actors
; are created by #R$71D8 until it reaches zero.
; #TABLE(default,centre,centre)
; { =h Value | =h Game Mode }
; { #N$80 | 1UP }
; { #N$FF | 2UP }
; TABLE#
; The larger delay for a 2UP game is useful for swapping players controls.
@label=GameDelayTimer
g$5F25 DEFB $00

; Unused
;
; This byte is not used by the game.
@label=Unused_5F26
g$5F26 DEFB $00

; Pantry Shelf Colour
;
; The colour attribute of the ingredient for the shelf which is being
; drawn in the pantry. It is set by #R$6002, from the table at #R$6011.
@label=PantryShelfColour
g$5F27 DEFB $00

; Tile Block Width
;
; The number of tiles in each row of the block which is being drawn by
; #R$60E2 or coloured by #R$60A4.
@label=TileBlockWidth
g$5F28 DEFB $00

; Charlie Running Flag
;
; Used in the introduction to a level. It is set to zero by #R$6D38, and
; then to #N$01 by #R$6E11 when the ingredient has moved far enough to the left
; for Charlie to start running after it.
@label=CharlieRunningFlag
g$5F29 DEFB $00

; Pantry Highlight Mask
;
; Has one bit set to show which shelf of the pantry is highlighted, which
; is bit #N$05 for the top shelf down to bit #N$01 for the bottom shelf. It is
; made by #R$6017 by shifting #N$20 right by the level (modulo #N$08), so for
; the levels which have no ingredient no shelf is highlighted.
@label=PantryHighlightMask
g$5F2A DEFB $00

; Charlie Last Movement
;
; The last direction in which Charlie moved. The low byte is the
; horizontal speed and the high byte is the vertical speed. It is updated by
; #R$706B each time Charlie moves and is set to #N($0002, $04, $04) (moving
; right) by #R$7378. Flour shots are fired in this direction, at three times
; the speed.
@label=CharlieLastMovement
g$5F2B DEFW $0002

; Active Player Level
;
; The level of the active player. Bits 0-2 are the level within a set of
; five, and bits 3-5 are the set. It is #N$FF for a player who has not started
; yet, so that #R$6C3C (which adds one to the level) starts them on level
; #N$00. Swapped with #R$5F31 by #R$6416.
@label=ActivePlayer_Level
g$5F2D DEFB $00

; Active Player Lives
;
; The lives which the active player has left. Swapped with #R$5F32 by
; #R$6416.
;
; .
;
; See #POKE(lives,Lives).
@label=ActivePlayer_Lives
g$5F2E DEFB $00

; Active Player Ingredients Needed
;
; The number of ingredients which are still needed (in BCD). It is shown
; inside the mixing bowl. The level is finished when it reaches zero and there
; are no actors left in play. Swapped with #R$5F33 by #R$6416.
;
; .
;
; See #POKE(ingredients,Ingredients).
@label=ActivePlayer_IngredientsNeeded
g$5F2F DEFB $00

; Active Player Level Number
;
; The level number (in BCD) which is shown in the "LEV" box. Swapped with
; #R$5F34 by #R$6416.
@label=ActivePlayer_LevelNumber
g$5F30 DEFB $00

; Inactive Player Level
;
; The level of the player who is not active, in the same format as
; #R$5F2D.
@label=InactivePlayer_Level
g$5F31 DEFB $00

; Inactive Player Lives
;
; The lives which the inactive player has left.
@label=InactivePlayer_Lives
g$5F32 DEFB $00

; Inactive Player Ingredients Needed
;
; The number of ingredients which are still needed by the inactive
; player (in BCD).
@label=InactivePlayer_IngredientsNeeded
g$5F33 DEFB $00

; Inactive Player Level Number
;
; The level number (in BCD) of the inactive player.
@label=InactivePlayer_LevelNumber
g$5F34 DEFB $00

; Charlie
;
; The first of the ten actor slots (up to #R$5F85), which is always
; Charlie. Every actor has the same eight byte format, and is processed once
; for each pass through the game loop.
; #TABLE(default,centre,centre)
; { =h Offset | =h Contents }
; { #N$00 | ID (sprite ID and handler, see #R$6486) }
; { #N$01 | Horizontal co-ordinate }
; { #N$02 | Vertical co-ordinate }
; { #N$03 | Colour attribute }
; { #N$04-#N$07 | Used by the handler }
; TABLE#
@label=ActorCharlie
g$5F35 DEFB $00             ; ID.
@label=ActorCharlie_X
 $5F36 DEFB $00             ; Horizontal co-ordinate.
 $5F37 DEFB $00             ; Vertical co-ordinate.
 $5F38 DEFB $00             ; Colour attribute.
 $5F39 DEFB $00,$00,$00,$00 ; Used by the handler.

; Flour Shot Slots
;
; The two actor slots for flour shots, in the same format as the actor at
; #R$5F35. A shot is made in one of these by #R$706B when Charlie fires, and
; handled by #R$6F78.
@label=ActorFlourShots
g$5F3D DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5F45 DEFB $00,$00,$00,$00,$00,$00,$00,$00

; Sound Effect Actor
;
; The actor slot which is used to play sound effects (see #R$68C7).
@label=SoundEffectActor
g$5F4D DEFB $00,$00,$00,$00,$00,$00,$00,$00

; Spawn Slots
;
; The six actor slots which are used for the ingredients, the nasties and
; the other actors which are created while the game is played (the last one,
; #N$5F7D, is where the monster is made by #R$67E2). They are in the same
; format as the actor at #R$5F35. A slot is empty when its ID is zero.
@label=ActorSpawnSlots
g$5F55 DEFB $00,$00,$00,$00,$00,$00,$00,$00
@label=ActorSpawnSlot_2
 $5F5D DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5F65 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5F6D DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5F75 DEFB $00,$00,$00,$00,$00,$00,$00,$00
@label=ActorMonsterSlot
 $5F7D DEFB $00,$00,$00,$00,$00,$00,$00,$00

; Copyright Messaging
;
; The copyright messages. The second message is printed on the game menu
; by #R$6332; the first is not used by the game.
@label=Message_Copyright
t$5F85 DEFM "COPYRIGHT"                              ; "COPYRIGHT".
; #N(#PEEK(#PC)) is the text colour. #N(#PEEK(#PC + $01)) is the font code for
; the "©" symbol.
@label=Message_Rights
 $5F8E DEFM $47                                      ; {"© 1983 A.C.G. ALL
 $5F8F DEFM $7F                                      ; RIGHTS RESERVED".
 $5F90 DEFM "1983 A.C.G. ALL RIGHTS RESERVE","D"+$80 ; }
; View the equivalent code in;
; #LIST
; { #UNDERWURLDE$9174 }
; LIST#

; Charlie Template
;
; The data for Charlie at the start of each life, which #R$6FFD copies to
; #R$5F35. The ID is #N$01, the horizontal co-ordinate is #N$60, the vertical
; co-ordinate is #N$78 and the colour is #N$47 (white).
@label=CharlieTemplate
b$5FAF DEFB $01
 $5FB0 DEFB $60
 $5FB1 DEFB $78
 $5FB2 DEFB $47
 $5FB3 DEFB $00
 $5FB4 DEFB $00
 $5FB5 DEFB $00
 $5FB6 DEFB $00

; Create Game Window
;
; Used by the routines at #R$5FE1, #R$6298 and #R$6BE0.
; .
; Clears the screen and draws the top line of the game window: the 1UP,
; HI and 2UP labels, the colours for the lives icons, and the three scores.
; #PUSHS #UDGTABLE { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$6298,stop=$62B5,clear=1,sp=$5F00)
; #POKES$5F0D,$01
; #SIM(start=$62B5,stop=$62BC,sp=$5F00)
; #SCR$02(game-window) } UDGTABLE# #POPS
;
; .
;
; Blank the screen and write the banner.
@label=CreateWindow
c$5FB7 CALL $74E2    ; Blank the attribute buffer using #R$74E2.
 $5FBA CALL $74D4    ; Blank the screen buffer using #R$74D4.
 $5FBD CALL $74AE    ; Print the "1UP", "HI" and "2UP" labels using #R$74AE.
; Set the attributes for the 1UP lives graphic.
 $5FC0 LD HL,$5808   ; Set the attribute buffer address of the 1UP lives.
 $5FC3 LD A,$47      ; Set the colour of the lives to #COLOUR$47.
 $5FC5 LD (HL),A     ; Colour the 1UP lives digit.
 $5FC6 INC HL        ; Move onto the next column.
 $5FC7 LD (HL),A     ; Colour the 1UP lives icon.
; Set the attributes for the 2UP lives graphic.
 $5FC8 LD HL,$5816   ; Set the attribute buffer address of the 2UP lives.
 $5FCB LD (HL),A     ; Colour the 2UP lives digit.
 $5FCC INC HL        ; Move onto the next column.
 $5FCD LD (HL),A     ; Colour the 2UP lives icon.
; Set the attributes for the score line (the whole line is #COLOUR$45).
 $5FCE LD HL,$5820   ; Set the attribute buffer address of the score line.
 $5FD1 LD BC,$2045   ; Set the column counter to #N$20 (the width of the screen) and the
                     ; colour of the score line to #COLOUR$45.
@label=CreateWindow_Loop
*$5FD4 LD (HL),C     ; Colour a cell of the score line.
 $5FD5 INC L         ; Move onto the next column.
 $5FD6 DJNZ $5FD4    ; Decrease the column counter by one and loop back to #R$5FD4 until
                     ; the whole score line has been coloured.
; Write the 1UP, 2UP and HI scores.
 $5FD8 CALL $7438    ; Print the 1UP score using #R$7438.
 $5FDB CALL $7440    ; Print the 2UP score using #R$7440.
 $5FDE JP $7448      ; Jump to #R$7448 to print the high score.
; View the equivalent code in;
; #LIST
; { #JETPAC$608A }
; { #LUNARJETMAN$84D8 }
; LIST#

; Start Level
;
; Used by the routine at #R$6D89.
; .
; Redraws the playing area for the active player, shows the pantry and
; puts Charlie in his starting position.
;
; .
;
; #PUSHS #UDGTABLE { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$6298,stop=$62B5,clear=1,sp=$5F00)
; #POKES$5F0D,$01
; #SIM(start=$6428,stop=$6457,sp=$5F00)
; #SIM(start=$5FE1,stop=$6001,sp=$5F00)
; #SCR$02(new-level) }
; { #SCR$01,$00,$15,$04,$02(pillar-strip) } UDGTABLE# #POPS
; .
; #R$6FFD takes a life away, so the life it is about to remove is added
; back first.
@label=StartLevel
c$5FE1 LD HL,$5F2E   ; {Add one to the lives of the active player (#R$5F2E).
 $5FE4 INC (HL)      ; }
 $5FE5 CALL $6FFD    ; Take a life away from the active player using #R$6FFD.
; This entry point is used by the routine at #R$6BAF.
; .
; The level is #N$FF when there is no second player in a one player game,
; so there is nothing to start.
@label=StartLevel_TestLevel
*$5FE8 LD A,($5F2D)  ; Fetch the level of the active player.
 $5FEB INC A         ; Add one, so that a level of #N$FF becomes zero.
 $5FEC RET Z         ; Return if there is no player to start.
; Draw the window, then the pantry, then the remaining lives.
 $5FED CALL $5FB7    ; Draw the window using #R$5FB7.
 $5FF0 CALL $6017    ; Draw the pantry using #R$6017.
 $5FF3 CALL $7378    ; Show the lives of both players using #R$7378.
; #HTML(Self modifying code; this updates the command at #R$74EE(#N$7515) to
; <strong>"CP #N$1A"</strong>.)
 $5FF6 LD A,$1A      ; {Write #N$1A to #R$74EE(#N$7516).
 $5FF8 LD ($7516),A  ; }
 $5FFB LD A,($5C78)  ; {Record the current frame at #R$5F22, so that the frame update does
 $5FFE LD ($5F22),A  ; not run straight away.}
 $6001 RET           ; Return.

; Set Pantry Fill Colour
;
; Used by the routine at #R$6017.
; .
; Picks the attribute used for the blank tiles of one pantry shelf.
;
; B Shelf number
@label=PantryFillColour
c$6002 LD A,B        ; Fetch the shelf number.
 $6003 EXX           ; Switch to the shadow registers.
 $6004 LD C,A        ; {Use the shelf number as an offset into the table of
 $6005 LD B,$00      ; fill colours.}
 $6007 LD HL,$6011   ; {Find the fill colour for the shelf in #R$6011.
 $600A ADD HL,BC     ; }
 $600B LD A,(HL)     ; {Write the fill colour to #R$5F27.
 $600C LD ($5F27),A  ; }
 $600F EXX           ; Switch back to the normal registers.
 $6010 RET           ; Return.

; Pantry Fill Colours
;
; One attribute per shelf number (#N$00 is not used). The colours match
; the colours used to draw the ingredients.
@label=PantryFillColours
b$6011 DEFB $00      ; #COLOUR(#PEEK(#PC)).
 $6012 DEFB $43      ; #COLOUR(#PEEK(#PC)).
 $6013 DEFB $46      ; #COLOUR(#PEEK(#PC)).
 $6014 DEFB $42      ; #COLOUR(#PEEK(#PC)).
 $6015 DEFB $44      ; #COLOUR(#PEEK(#PC)).
 $6016 DEFB $46      ; #COLOUR(#PEEK(#PC)).

; Draw Pantry
;
; Used by the routine at #R$5FE1.
; .
; Draws the pantry down the right hand side of the screen, and the mixing
; bowl and pillars along the bottom. The scenery is built from the tiles at
; #R$7B4A, which are printed as if they were a font.
; .
; The pantry has five shelves, each with a drawer. The drawer for the current
; level's ingredient is drawn highlighted, and has the colour of the
; ingredient inside it. The level number is printed in the bottom right
; corner.
;
; .
;
; #PUSHS #UDGTABLE { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$6298,stop=$62B5,clear=1,sp=$5F00)
; #POKES$5F0D,$01
; #SIM(start=$6428,stop=$6457,sp=$5F00)
; #SIM(start=$5FB7,stop=$5FDE,sp=$5F00)
; #SIM(start=$6017,stop=$60A3,sp=$5F00)
; #SCR$02(pantry) } UDGTABLE# #POPS
; .
; The pantry is constructed like it is a font.
@label=DrawPantry
c$6017 LD HL,($5C36) ; {Stash the address of the character set (#SKOOLKID$5C36(CHARS)) on
 $601A PUSH HL       ; the stack.}
 $601B LD HL,$7B4A   ; {Use the pantry tiles as the character set by writing #R$7B4A to
 $601E LD ($5C36),HL ; #SKOOLKID$5C36(CHARS).}
; Make a mask which has a single bit set for the shelf that is
; highlighted. Shelf #N$05 is at the top and shelf #N$01 is at the bottom, so
; the mask is #N$20 shifted right by the level (modulo #N$08).
 $6021 LD A,($5F2D)  ; Fetch the level of the active player.
 $6024 AND %00000111 ; Keep only bits 0-2 (the level within the set of five).
 $6026 LD B,A        ; Use the level as the counter for moving the highlight
                     ; down.
 $6027 LD A,$20      ; Start with the mask for the top shelf.
 $6029 JR Z,$602F    ; Jump to #R$602F if the top shelf is highlighted.
@label=DrawPantry_Shift_Loop
*$602B SRL A         ; Move the highlight down by one shelf.
 $602D DJNZ $602B    ; Decrease the level counter by one and loop back to #R$602B until the
                     ; highlight is on the shelf for this level.
@label=DrawPantry_SetMask
*$602F LD ($5F2A),A  ; Write the mask of the highlighted shelf to #R$5F2A.
; Print the sign at the top of the pantry; it is in two rows.
 $6032 LD DE,$613B   ; Point #REGde at #R$613B.
 $6035 LD HL,$10D0   ; Set the position of the top row of the sign (#N($10D0,
                     ; $04, $04)).
 $6038 CALL $7488    ; Print the top row of the sign using #R$7488.
 $603B EXX           ; Switch back to the normal registers.
 $603C INC DE        ; Point #REGde at the bottom row of the "PANTRY" sign.
 $603D LD HL,$18D0   ; Set the position of the bottom row of the sign
                     ; (#N($18D0, $04, $04)).
 $6040 CALL $7488    ; Print the bottom row of the sign using #R$7488.
 $6043 EXX           ; Switch back to the normal registers.
; Draw the tiles for each of the five shelves, from the top.
 $6044 LD HL,$20D0   ; Set the position of the top shelf (#N($20D0, $04, $04)).
 $6047 INC DE        ; Point #REGde at the tiles for the shelves.
 $6048 LD B,$05      ; Set the shelf counter to #N$05, which is also the number of the top
                     ; shelf.
@label=DrawPantry_Shelves_Loop
*$604A CALL $60BD    ; Draw a shelf using #R$60BD.
 $604D DJNZ $604A    ; Decrease the shelf counter by one and loop back to #R$604A until all
                     ; five shelves have been drawn.
; Print the base of the pantry.
 $604F LD DE,$616D   ; Point #REGde at #R$616D.
 $6052 LD HL,$98D0   ; Set the position of the base of the pantry (#N($98D0,
                     ; $04, $04)).
 $6055 CALL $7488    ; Print the base of the pantry using #R$7488.
; Colour each of the five shelves, from the top.
 $6058 LD DE,$6174   ; Point #REGde at #R$6174.
 $605B LD HL,$20D0   ; Set the position of the top shelf (#N($20D0, $04, $04)).
 $605E LD B,$05      ; Set the shelf counter to #N$05, which is also the number of the top
                     ; shelf.
@label=DrawPantry_Colours_Loop
*$6060 CALL $6002    ; Set the fill colour for the shelf using #R$6002.
 $6063 CALL $60FD    ; Colour the shelf using #R$60FD.
 $6066 DJNZ $6060    ; Decrease the shelf counter by one and loop back to #R$6060 until all
                     ; five shelves have been coloured.
; Draw the mixing bowl and pillars along the bottom of the screen; this
; is #N$20 tiles wide and #N$04 tiles tall.
 $6068 LD HL,$A000   ; Set the position of the mixing bowl and pillars
                     ; (#N($A000, $04, $04)).
 $606B LD DE,$6198   ; Point #REGde at #R$6198.
 $606E LD C,$04      ; Set the number of rows to #N$04.
 $6070 LD A,$20      ; Set the width to #N$20 tiles.
 $6072 CALL $60E2    ; Print the mixing bowl and pillars using #R$60E2.
; Colour the mixing bowl and pillars.
 $6075 LD DE,$6218   ; Point #REGde at #R$6218.
 $6078 LD HL,$A000   ; Set the position of the mixing bowl and pillars
                     ; (#N($A000, $04, $04)).
 $607B LD C,$04      ; Set the number of rows to #N$04.
 $607D CALL $60A4    ; Colour the mixing bowl and pillars using #R$60A4.
 $6080 POP HL        ; Restore the address of the original character set from
                     ; the stack.
 $6081 LD ($5C36),HL ; Write it back to #SKOOLKID$5C36(CHARS).
; Print the number of ingredients which are needed inside the bowl.
 $6084 LD B,$00      ; Set the number of ingredients collected to #N$00.
 $6086 CALL $6C88    ; Print the number of ingredients needed inside the bowl using
                     ; #R$6C88.
; Print the level number, which is in BCD, in the bottom right corner of
; the screen.
 $6089 LD A,($5F30)  ; {Fetch the level number of the active player and keep a copy of the
 $608C LD C,A        ; level number in #REGc.}
 $608D RRA           ; {Shift the tens digit into the low four bits.
 $608E RRA           ;
 $608F RRA           ;
 $6090 RRA           ; }
 $6091 AND %00001111 ; Keep only the tens digit.
 $6093 ADD A,$30     ; Convert the digit to an ASCII character.
 $6095 LD HL,$50FC   ; Set the screen address of the first digit of the level
                     ; number.
 $6098 CALL $7468    ; Print the tens digit using #R$7468.
 $609B LD A,C        ; Fetch the level number again.
 $609C AND %00001111 ; Keep only the units digit.
 $609E ADD A,$30     ; Convert the digit to an ASCII character.
 $60A0 CALL $7468    ; Print the units digit using #R$7468.
 $60A3 RET           ; Return.

; Write Attribute Block
;
; Used by the routine at #R$6017.
; .
; Copies a block of colour attributes, which has the width in #R$5F28,
; into the attribute buffer.
;
;   C Number of rows
;   DE Address of the attributes
;   HL Position of the block
; O:DE Address of the attributes after the block
@label=WriteAttributeBlock
c$60A4 LD A,($5F28)  ; Fetch the width of the block.
 $60A7 LD B,A        ; Set the column counter to the width.
 $60A8 PUSH HL       ; Stash the position of the row on the stack.
 $60A9 PUSH BC       ; Stash the width on the stack.
 $60AA CALL $7534    ; Convert the position to an attribute address using
                     ; #R$7534.
 $60AD POP BC        ; Restore the column counter from the stack.
@label=WriteAttributeBlock_Loop
*$60AE LD A,(DE)     ; {Copy an attribute from #REGde to the attribute buffer.
 $60AF LD (HL),A     ; }
 $60B0 INC HL        ; Move onto the next column.
 $60B1 INC DE        ; Move onto the next attribute.
 $60B2 DJNZ $60AE    ; Decrease the column counter by one and loop back to #R$60AE until
                     ; the row has been copied.
 $60B4 POP HL        ; Restore the position of the row from the stack.
 $60B5 LD A,H        ; Fetch the vertical position of the row.
 $60B6 ADD A,$08     ; Add #N$08 to move down one row of tiles.
 $60B8 LD H,A        ; Update the vertical position of the row.
 $60B9 DEC C         ; Decrease the row counter by one.
 $60BA JR NZ,$60A4   ; Loop back to #R$60A4 until all of the rows have been
                     ; done.
 $60BC RET           ; Return.

; Draw Shelf
;
; Used by the routine at #R$6017.
; .
; Draws the tiles for one shelf of the pantry. A shelf is #N$06 tiles wide
; and #N$03 tiles tall. There are two graphics for a shelf; the normal one and
; the highlighted one, which is used when the shelf's bit is set in #R$5F2A.
; The example below is for the top shelf (shelf #N$05). Its colours are
; set first, so that the tiles can be seen.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$6298,stop=$62B5,clear=1,sp=$5F00)
; #POKES$5F0D,$01
; #SIM(start=$6428,stop=$6457,sp=$5F00)
; #SIM(start=$5FED,stop=$5FF0,sp=$5F00)
; #SIM(start=$6017,stop=$604A,sp=$5F00)
; #SIM(start=$6002,stop=$0000,bc=$0500,sp=$5E00)
; #SIM(start=$60FD,stop=$0000,bc=$0500,de=$6174,hl=$20D0,sp=$5E00)
; #SCR$04,$1A,$04,$06,$03(draw-shelf-before)
; | #SIM(start=$60BD,stop=$0000,bc=$0500,de=$6149,hl=$20D0,sp=$5E00)
; #SCR$04,$1A,$04,$06,$03(draw-shelf-after) } UDGTABLE# #POPS
;
;   B Shelf number
;   DE Address of the normal graphic
;   HL Position of the shelf
; O:HL Position of the shelf below
;
; Make the second byte of a BIT command from the shelf number.
@label=DrawShelf
c$60BD PUSH BC       ; Stash the shelf number and #REGc on the stack.
 $60BE PUSH DE       ; Stash the address of the normal graphic on the stack.
 $60BF LD A,B        ; Fetch the shelf number.
 $60C0 RLCA          ; {Multiply by #N$08, so that the shelf number is in bits
 $60C1 RLCA          ; 3-5.
 $60C2 RLCA          ; }
 $60C3 AND %00111000 ; Keep only bits 3-5.
 $60C5 OR %01000111  ; Set bits 0-2 and bit 6.
 $60C7 LD ($60CE),A  ; Write #REGa to #R$60CD(#N$60CE).
 $60CA LD A,($5F2A)  ; Fetch the mask of the highlighted shelf.
; #HTML(Self modifying code; the command which is here is made into
; <strong>BIT n,A</strong>, where n is the shelf number, by the instructions
; above. It is shown as <strong>RLC B</strong> as that is how it is stored.)
@label=DrawShelf_TestBit
 $60CD RLC B         ; Test the bit for the shelf in the mask.
 $60CF JR Z,$60D8    ; Jump to #R$60D8 if this shelf is not highlighted.
 $60D1 PUSH HL       ; {Move #REGde on to the highlighted graphic, which is #N$12 bytes
 $60D2 LD HL,$0012   ; further on (preserving #REGhl).
 $60D5 ADD HL,DE     ;
 $60D6 EX DE,HL      ;
 $60D7 POP HL        ; }
@label=DrawShelf_Print
*$60D8 LD C,$03      ; Set the number of rows to #N$03.
 $60DA LD A,$06      ; Set the width to #N$06 tiles.
 $60DC CALL $60E2    ; Print the tiles for the shelf using #R$60E2.
 $60DF POP DE        ; Restore the address of the normal graphic from the
                     ; stack.
 $60E0 POP BC        ; Restore the shelf number and #REGc from the stack.
 $60E1 RET           ; Return.

; Print Tile Block
;
; Used by the routines at #R$6017 and #R$60BD.
; .
; Prints a block of tiles (using the font set up by #R$6017).
;
;   A Width of the block in tiles
;   C Number of rows
;   DE Address of the tile numbers
;   HL Position of the block
; O:DE Address of the tile numbers after the block
; O:HL Position of the row below the block
@label=PrintTileBlock
c$60E2 LD ($5F28),A  ; Record the width of the block at #R$5F28.
@label=PrintTileBlock_Row
*$60E5 LD A,($5F28)  ; Fetch the width of the block.
 $60E8 LD B,A        ; Set the column counter to the width.
 $60E9 PUSH HL       ; Stash the position of the row on the stack.
 $60EA CALL $76E3    ; Convert the position to a screen address using #R$76E3.
@label=PrintTileBlock_Loop
*$60ED LD A,(DE)     ; Fetch the tile number.
 $60EE CALL $7468    ; Print the tile using #R$7468.
 $60F1 INC DE        ; Move onto the next tile.
 $60F2 DJNZ $60ED    ; Decrease the column counter by one and loop back to #R$60ED until
                     ; the row has been printed.
 $60F4 POP HL        ; Restore the position of the row from the stack.
 $60F5 LD A,H        ; Fetch the vertical position of the row.
 $60F6 ADD A,$08     ; Add #N$08 to move down one row of tiles.
 $60F8 LD H,A        ; Update the vertical position of the row.
 $60F9 DEC C         ; Decrease the row counter by one.
 $60FA JR NZ,$60E5   ; Loop back to #R$60E5 until all of the rows have been
                     ; done.
 $60FC RET           ; Return.

; Colour Shelf
;
; Used by the routine at #R$6017.
; .
; Colours the cells of one shelf of the pantry. The cells which have an
; attribute of #N$00 are given the colour of the ingredient for the shelf,
; which was fetched by #R$6002. As in #R$60BD there are two sets of attributes;
; the second is used when the shelf's bit is set in #R$5F2A.
;
;   B Shelf number
;   DE Address of the attributes for the normal graphic
;   HL Position of the shelf
; O:HL Position of the shelf below
;
; Make the second byte of a BIT command from the shelf number.
@label=ColourShelf
c$60FD PUSH BC       ; Stash the shelf number and #REGc on the stack.
 $60FE PUSH DE       ; Stash the address of the normal attributes on the stack.
 $60FF LD A,B        ; Fetch the shelf number.
 $6100 RLCA          ; {Multiply by #N$08, so that the shelf number is in bits
 $6101 RLCA          ; 3-5.
 $6102 RLCA          ; }
 $6103 AND %00111000 ; Keep only bits 3-5.
 $6105 OR %01000111  ; Set bits 0-2 and bit 6.
 $6107 LD ($610E),A  ; Write #REGa to #R$610D(#N$610E).
 $610A LD A,($5F2A)  ; Fetch the mask of the highlighted shelf.
; #HTML(Self modifying code; the command which is here is made into
; <strong>BIT n,A</strong>, where n is the shelf number, by the instructions
; above. It is stored as <strong>BIT 0,A</strong>.)
@label=ColourShelf_TestBit
 $610D BIT 0,A       ; {Jump to #R$6118 if this shelf is not highlighted.
 $610F JR Z,$6118    ; }
 $6111 PUSH HL       ; {Move #REGde on to the highlighted attributes, which are #N$12
 $6112 LD HL,$0012   ; bytes further on (preserving #REGhl).
 $6115 ADD HL,DE     ;
 $6116 EX DE,HL      ;
 $6117 POP HL        ; }
@label=ColourShelf_Rows
*$6118 LD C,$03      ; Set the number of rows to #N$03.
@label=ColourShelf_Row
*$611A LD B,$06      ; Set the column counter to #N$06 (the width of the
                     ; shelf).
 $611C PUSH HL       ; Stash the position of the row on the stack.
 $611D PUSH BC       ; Stash the counters on the stack.
 $611E CALL $7534    ; Convert the position to an attribute address using
                     ; #R$7534.
 $6121 POP BC        ; Restore the counters from the stack.
@label=ColourShelf_Loop
*$6122 LD A,(DE)     ; Fetch the attribute.
 $6123 AND A         ; Does the attribute need the colour of the ingredient (is
                     ; it zero)?
 $6124 CALL Z,$6137  ; Call #R$6137 if it is, to get the colour of the
                     ; ingredient.
 $6127 LD (HL),A     ; Write the attribute to the attribute buffer.
 $6128 INC DE        ; Move onto the next attribute.
 $6129 INC HL        ; Move onto the next column.
 $612A DJNZ $6122    ; Decrease the column counter by one and loop back to #R$6122 until
                     ; the row has been coloured.
 $612C POP HL        ; Restore the position of the row from the stack.
 $612D LD A,H        ; Fetch the vertical position of the row.
 $612E ADD A,$08     ; Add #N$08 to move down one row of tiles.
 $6130 LD H,A        ; Update the vertical position of the row.
 $6131 DEC C         ; Decrease the row counter by one.
 $6132 JR NZ,$611A   ; Loop back to #R$611A until all of the rows have been
                     ; done.
 $6134 POP DE        ; Restore the address of the normal attributes from the
                     ; stack.
 $6135 POP BC        ; Restore the shelf number and #REGc from the stack.
 $6136 RET           ; Return.

; Fetch Shelf Colour
;
; Used by the routine at #R$60FD.
; .
; Fetches the colour of the ingredient for the shelf which is being drawn.
;
; O:A Colour attribute
@label=FetchShelfColour
c$6137 LD A,($5F27)  ; Fetch the colour of the ingredient for the shelf.
 $613A RET           ; Return.

; Pantry Graphic
;
; The tiles and colour attributes which #R$6017 uses to draw the pantry.
; The tile numbers are for the font at #R$7B4A. The strings are printed by
; #R$7488, so they start with an attribute and the last tile has bit 7 set.
;
; .
;
; The top row of the "PANTRY" sign.
@label=CupboardData
b$613B DEFB $44                                                                                                                             ; Attribute
                                                                                                                                            ; =
                                                                                                                                            ; #COLOUR(#PEEK(#PC)).
 $613C DEFB $1F,$20,$21,$22,$23,$A4                                                                                                         ; Tile
                                                                                                                                            ; numbers.
; The bottom row of the "PANTRY" sign.
 $6142 DEFB $44                                                                                                                             ; Attribute
                                                                                                                                            ; =
                                                                                                                                            ; #COLOUR(#PEEK(#PC)).
 $6143 DEFB $25,$26,$27,$28,$29,$AA                                                                                                         ; Tile
                                                                                                                                            ; numbers.
; The tiles for a shelf, which is six tiles wide and three tiles tall.
; This is the normal graphic.
 $6149 DEFB $2B,$2C,$2D,$2E,$2F,$30
 $614F DEFB $2B,$31,$32,$33,$34,$30
 $6155 DEFB $2B,$01,$01,$01,$01,$30
; The tiles for the highlighted shelf.
 $615B DEFB $2B,$45,$46,$46,$47,$30
 $6161 DEFB $2B,$48,$49,$49,$4A,$30
 $6167 DEFB $2B,$01,$01,$01,$01,$30
; The base of the pantry.
@label=PantryBase
 $616D DEFB $44                                                                                                                             ; Attribute
                                                                                                                                            ; =
                                                                                                                                            ; #COLOUR(#PEEK(#PC)).
 $616E DEFB $35,$36,$36,$36,$36,$B7                                                                                                         ; Tile
                                                                                                                                            ; numbers.
; The attributes for the normal shelf. An attribute of #N$00 is replaced
; by the colour of the ingredient for the shelf.
@label=PantryAttributes
 $6174 DEFB $44,$4F,$4F,$4F,$4F,$44
 $617A DEFB $44,$4F,$4F,$4F,$4F,$44
 $6180 DEFB $44,$44,$44,$44,$44,$44
; The attributes for the highlighted shelf.
 $6186 DEFB $44,$00,$00,$00,$00,$44
 $618C DEFB $44,$00,$00,$00,$00,$44
 $6192 DEFB $44,$44,$44,$44,$44,$44
; The tiles for the mixing bowl and pillars along the bottom of the
; screen, which are #N$20 tiles wide and #N$04 tiles tall.
@label=BottomStrip_Tiles
 $6198 DEFB $02,$03,$04,$05,$02,$03,$04,$05,$12,$01,$01,$01,$01,$01,$01,$01,$01,$1D,$02,$03,$04,$05,$02,$03,$04,$05,$38,$39,$3A,$3A,$3B,$3C
 $61B8 DEFB $06,$07,$08,$09,$06,$07,$08,$09,$13,$01,$01,$01,$01,$01,$01,$01,$01,$1C,$06,$07,$08,$09,$06,$07,$08,$09,$3D,$3E,$00,$00,$3F,$40
 $61D8 DEFB $0A,$07,$08,$0D,$0A,$07,$08,$0D,$1E,$15,$01,$01,$01,$01,$01,$01,$19,$1A,$0A,$07,$08,$0D,$0A,$07,$08,$0D,$41,$42,$4B,$4C,$43,$44
 $61F8 DEFB $0E,$0F,$10,$11,$0E,$0F,$10,$11,$00,$1E,$16,$17,$17,$17,$17,$18,$1A,$00,$0E,$0F,$10,$11,$0E,$0F,$10,$11,$14,$1B,$00,$00,$0B,$0C
; The attributes for the mixing bowl and pillars.
@label=BottomStrip_Attributes
 $6218 DEFB $45,$45,$45,$45,$45,$45,$45,$45,$43,$43,$43,$43,$43,$43,$43,$43,$43,$43,$45,$45,$45,$45,$45,$45,$45,$45,$46,$46,$46,$46,$46,$46
 $6238 DEFB $45,$45,$45,$45,$45,$45,$45,$45,$47,$47,$47,$47,$78,$78,$47,$47,$47,$47,$45,$45,$45,$45,$45,$45,$45,$45,$46,$46,$00,$00,$46,$46
 $6258 DEFB $45,$45,$45,$45,$45,$45,$45,$45,$43,$43,$43,$43,$43,$43,$43,$43,$43,$43,$45,$45,$45,$45,$45,$45,$45,$45,$46,$46,$47,$47,$46,$46
 $6278 DEFB $45,$45,$45,$45,$45,$45,$45,$45,$00,$47,$47,$67,$67,$67,$67,$47,$47,$00,$45,$45,$45,$45,$45,$45,$45,$45,$46,$46,$45,$45,$46,$46

; Game Initialisation
;
; Used by the routine at #R$5F00.
; .
; Blanks the high score and the scores for both players, and works out
; whether the sound should be muted. It then runs the game selection menu,
; which is shown until "0" is pressed to start the game.
; .
; The game comes back to #R$62B5 to show the menu again when a game is over.
;
; .
;
; Blank the high score, the 1UP score and the 2UP score.
@label=GameInitialisation
c$6298 LD HL,$5F09   ; Point #REGhl at the high score.
 $629B LD BC,$0B00   ; Set the counter to #N$0B
                     ; (the high score, the game options, the sound flag and both scores) and the
                     ; byte to write to #N$00.
@label=GameInitialisation_Loop
*$629E LD (HL),C     ; Blank a byte.
 $629F INC HL        ; Move onto the next byte.
 $62A0 DJNZ $629E    ; Decrease the byte counter by one and loop back to #R$629E until
                     ; everything has been blanked.
; This calculates a "checksum" of the #SKOOLKID$03B5(BEEPER) routine. The
; expected value at the end is #N$00, and if #R$5F0D does not contain #N$00
; then the game is muted.
 $62A2 LD HL,$03B5   ; Point #REGhl at the start of the #SKOOLKID$03B5(BEEPER)
                     ; routine.
 $62A5 LD B,$43      ; Set the counter to #N$43 (the number of bytes to add).
 $62A7 XOR A         ; Clear the checksum.
@label=Mute_Loop
*$62A8 ADD A,(HL)    ; Add a byte of the routine to the checksum.
 $62A9 INC HL        ; Move onto the next byte.
 $62AA DJNZ $62A8    ; Decrease the byte counter by one and loop back to #R$62A8 until the
                     ; whole routine has been added.
 $62AC ADD A,$68     ; Add #N$68, which makes the checksum zero in the original
                     ; ROM.
 $62AE LD ($5F0D),A  ; Store the result as the sound mute flag at #R$5F0D.
 $62B1 XOR A         ; {Write #N$00 to #SKOOLKID$5C48(BORDCR).
 $62B2 LD ($5C48),A  ; }
; This entry point is used by the routine at #R$6C0A.
; .
; This is where the game restarts after a game is over.
@label=Game_Restart
*$62B5 DI            ; Disable interrupts.
 $62B6 LD SP,$5F00   ; Set the stack pointer to #R$5F00.
 $62B9 CALL $5FB7    ; Draw the window using #R$5FB7.
; This is the game selection loop. It draws the menu, reads the keys
; which change the options and then updates the flashing of the menu.
@label=GameSelect_Loop
*$62BC CALL $6332    ; Print the game selection menu using #R$6332.
 $62BF LD A,$F7      ; {Read from the keyboard;
 $62C1 OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $62C3 IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$F7 | 1 | 2 | 3 | 4 | 5 }
                     ; TABLE#}
 $62C5 CPL           ; Flip the bits, so that a pressed key is a set bit.
 $62C6 LD E,A        ; Keep the pressed keys in #REGe.
 $62C7 LD A,($5F0C)  ; Fetch the game options.
; Handle 1UP selection.
 $62CA BIT 0,E       ; {Jump to #R$62D0 if key "1" has not been pressed ("1
 $62CC JR Z,$62D0    ; PLAYER GAME").}
 $62CE RES 0,A       ; Select a one player game by resetting bit 0.
; Handle 2UP selection.
@label=GameSelect_CheckP2
*$62D0 BIT 1,E       ; {Jump to #R$62D6 if key "2" has not been pressed ("2
 $62D2 JR Z,$62D6    ; PLAYER GAME").}
 $62D4 SET 0,A       ; Set bit 0, which selects a two player game.
; Handle Keyboard selection.
@label=GameSelect_CheckKeyboard
*$62D6 BIT 2,E       ; {Jump to #R$62DC if key "3" has not been pressed
 $62D8 JR Z,$62DC    ; ("KEYBOARD").}
 $62DA AND %11111001 ; Keep only bits 0, 3-7, which selects the keyboard.
; Handle Kempston Joystick selection.
@label=GameSelect_CheckKempston
*$62DC BIT 3,E       ; {Jump to #R$62E4 if key "4" has not been pressed ("KEMPSTON
 $62DE JR Z,$62E4    ; JOYSTICK").}
 $62E0 AND %11111001 ; Keep only bits 0, 3-7.
 $62E2 OR %00000010  ; Set bit 1, which selects the Kempston joystick.
; Handle Cursor Joystick selection.
@label=GameSelect_CheckCursor
*$62E4 BIT 4,E       ; {Jump to #R$62EC if key "5" has not been pressed
 $62E6 JR Z,$62EC    ; ("CURSOR JOYSTICK").}
 $62E8 AND %11111001 ; Keep only bits 0, 3-7.
 $62EA OR %00000100  ; Set bit 2, which selects the cursor joystick.
@label=GameSelect_CheckStart
*$62EC LD ($5F0C),A  ; Update the game options at #R$5F0C.
; "0" for "Start Game" is on a different port.
 $62EF LD A,$EF      ; {Read from the keyboard;
 $62F1 OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $62F3 IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$EF | 0 | 9 | 8 | 7 | 6 }
                     ; TABLE#}
 $62F5 CPL           ; Flip the bits, so that a pressed key is a set bit.
; Handle starting a new game.
 $62F6 BIT 0,A       ; {Jump to #R$6428 if key "0" has been pressed ("START
 $62F8 JP NZ,$6428   ; GAME").}
; Handle flashing each selection. The first line of the menu is the
; title, so the attributes for the options start at #R$635E(#N$635F).
 $62FB LD HL,$635F   ; Point #REGhl at #R$635F.
 $62FE LD A,($5F0C)  ; {Fetch the game options and keep a copy of the options
 $6301 LD C,A        ; in #REGc.}
 $6302 BIT 0,C       ; {Jump to #R$631F if a two player game is selected.
 $6304 JR NZ,$631F   ; }
 $6306 CALL $6324    ; Flash the "1 PLAYER GAME" line, and stop the "2 PLAYER GAME" line
                     ; flashing, using #R$6324.
@label=MenuAttributeHandler
*$6309 LD B,$03      ; Set the control line counter to #N$03
                     ; (keyboard, Kempston joystick and cursor joystick).
 $630B LD A,C        ; Fetch the game options.
 $630C RRCA          ; Shift the control selection into bits 0-1.
@label=MenuAttributeHandler_Loop
*$630D AND %00000011 ; Keep only bits 0-1 (the selected control).
 $630F JR Z,$631A    ; Jump to #R$631A if this line is the selected control.
 $6311 CALL $6327    ; Stop this control line flashing using #R$6327.
@label=MenuAttributeHandler_Next
*$6314 DEC A         ; Move on to the next control.
 $6315 DJNZ $630D    ; Decrease the control line counter by one and loop back to #R$630D
                     ; until all three lines have been done.
 $6317 JP $62BC      ; Jump back to #R$62BC to print the menu again.
; Flash the line of the selected control.
@label=MenuAttributeFlashControl
*$631A CALL $632E    ; Flash the selected control line using #R$632E.
 $631D JR $6314      ; Jump back to #R$6314.
; A two player game is selected, so flash that line instead of the one
; player line.
@label=MenuAttributeFlashTwoPlayer
*$631F CALL $632B    ; Flash the "2 PLAYER GAME" line, and stop the "1 PLAYER GAME" line
                     ; flashing, using #R$632B.
 $6322 JR $6309      ; Jump back to #R$6309.
; Set FLASH on the first menu line, and clear it on the second.
@label=MenuAttributeSetUnset
*$6324 SET 7,(HL)    ; Set the FLASH attribute for the menu attribute.
 $6326 INC HL        ; Move onto the next menu attribute.
; Clear FLASH on a menu line.
@label=MenuAttributeUnSetFirst
*$6327 RES 7,(HL)    ; Unset the FLASH attribute for the menu attribute.
 $6329 INC HL        ; Move onto the next menu attribute.
 $632A RET           ; Return.
; Clear FLASH on the first menu line, and set it on the second.
@label=MenuAttributeUnsetSet
*$632B RES 7,(HL)    ; Unset the FLASH attribute for the menu attribute.
 $632D INC HL        ; Move onto the next menu attribute.
; Set FLASH on a menu line.
@label=MenuAttributeSetFirst
*$632E SET 7,(HL)    ; Set the FLASH attribute for the menu attribute.
 $6330 INC HL        ; Move onto the next menu attribute.
 $6331 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$7C19 }
; { #JETPAC$61EB }
; { #LUNARJETMAN$800A }
; { #PSSST$61CD }
; { #TRANZAM$5F07 }
; LIST#

; Game Selection Menu
;
; Used by the routine at #R$6298.
; .
; Prints the seven lines of the game selection menu, and then the
; copyright message at the bottom of the screen. Each line of the menu has an
; attribute (from #R$635E), a vertical position (from #R$6365) and some text
; (from #R$636C), and all of them are printed starting at column #N$07.
; #PUSHS #UDGTABLE { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$6298,stop=$62B5,clear=1,sp=$5F00)
; #POKES$5F0D,$01
; #SIM(start=$62B5,stop=$62BC,sp=$5F00)
; #SIM(start=$62BC,stop=$62BF,sp=$5F00)
; #SCR$02(game-menu) } UDGTABLE# #POPS
;
; .
;
; The attributes are fetched using #REGde, and the positions and the text
; use #REGhl' and #REGde'.
@label=GameMenu
c$6332 LD DE,$635E   ; Point #REGde at the table of menu line attributes.
 $6335 EXX           ; Switch to the shadow registers.
 $6336 LD HL,$6365   ; Point #REGhl' at #R$6365.
 $6339 LD DE,$636C   ; Point #REGde' at #R$636C.
; There are seven lines of text.
 $633C LD B,$07      ; Set the menu line counter to #N$07.
@label=GameMenu_Loop
*$633E EXX           ; Switch back to the normal registers.
 $633F LD A,(DE)     ; {Copy the attribute of this menu line to #R$5F24.
 $6340 LD ($5F24),A  ; }
 $6343 INC DE        ; Move onto the attribute for the next menu line.
 $6344 EXX           ; Switch to the shadow registers.
 $6345 PUSH BC       ; Stash the menu line counter on the stack.
 $6346 LD A,(HL)     ; Fetch the vertical position of this menu line.
 $6347 INC HL        ; Move onto the position for the next menu line.
 $6348 PUSH HL       ; Stash the position pointer on the stack.
 $6349 LD H,A        ; {Set the position of this menu line; the vertical position from the
 $634A LD L,$38      ; table and the horizontal position of #N$38.}
 $634C CALL $63E0    ; Print the menu line using #R$63E0.
 $634F EXX           ; Switch to the shadow registers.
 $6350 POP HL        ; {Restore the position pointer and the menu line counter from the
 $6351 POP BC        ; stack.}
 $6352 INC DE        ; Move onto the text of the next menu line.
 $6353 DJNZ $633E    ; Decrease the menu line counter by one and loop back to #R$633E until
                     ; all seven lines have been printed.
; Print the copyright message at the bottom of the screen.
 $6355 LD HL,$B800   ; Set the position of the copyright message (#N($B800,
                     ; $04, $04)).
 $6358 LD DE,$5F8E   ; Point #REGde at #R$5F8E.
 $635B JP $7488      ; Print the copyright message using #R$7488.
; View the equivalent code in;
; #LIST
; { #ATICATAC$7CAF }
; { #JETPAC$6260 }
; { #LUNARJETMAN$80D1 }
; { #PSSST$6250 }
; { #SABREWULF$B473 }
; { #TRANZAM$5F6C }
; { #UNDERWURLDE$90E4 }
; LIST#

; Game Select Attribute Table
;
; One attribute byte per menu line. The routines that flash the
; selected line set or clear FLASH in the byte for the line being
; updated. The first byte belongs to the title, so the flashing code
; starts at #R$635E(#N$635F).
@label=GameSelection_Attributes
b$635E DEFB $47      ; {#TABLE(default,centre)
@label=GameSelection_Attributes_Options
 $635F DEFB $47      ; { =h Byte(n) | =h Menu Item }
 $6360 DEFB $47      ; { #N$01 | Game Selection }
 $6361 DEFB $47      ; { #N$02 | 1 Player Game }
 $6362 DEFB $47      ; { #N$03 | 2 Player Game }
 $6363 DEFB $47      ; { #N$04 | Keyboard }
 $6364 DEFB $47      ; { #N$05 | Kempston Joystick }
                     ; { #N$06 | Cursor Joystick }
                     ; { #N$07 | Start Game }
                     ; TABLE#}
; View the equivalent code in;
; #LIST
; { #ATICATAC$7CEA }
; { #JETPAC$628D }
; { #LUNARJETMAN$810E }
; { #PSSST$627C }
; { #TRANZAM$5FA7 }
; { #UNDERWURLDE$9119 }
; LIST#

; Game Select Y Position Table
;
; The vertical position of each menu line, in pixels. Dividing it by
; #N$08 gives the row of the screen.
@label=GameSelection_Position
b$6365 DEFB $20      ; {#TABLE(default,centre,centre)
 $6366 DEFB $38      ; { =h Byte(n) | =h Position | =h Menu Item }
 $6367 DEFB $48      ; { #N$01 | #EVAL(#PEEK(#PC+$00) / $08) | Game Selection }
 $6368 DEFB $58      ; { #N$02 | #EVAL(#PEEK(#PC+$01) / $08) | 1 Player Game }
 $6369 DEFB $68      ; { #N$03 | #EVAL(#PEEK(#PC+$02) / $08) | 2 Player Game }
 $636A DEFB $78      ; { #N$04 | #EVAL(#PEEK(#PC+$03) / $08) | Keyboard }
 $636B DEFB $98      ; { #N$05 | #EVAL(#PEEK(#PC+$04) / $08) | Kempston Joystick }
                     ; { #N$06 | #EVAL(#PEEK(#PC+$05) / $08) | Cursor Joystick }
                     ; { #N$07 | #EVAL(#PEEK(#PC+$06) / $08) | Start Game }
                     ; TABLE#}
; View the equivalent code in;
; #LIST
; { #ATICATAC$7CF1 }
; { #JETPAC$6293 }
; { #LUNARJETMAN$8115 }
; { #PSSST$6282 }
; { #TRANZAM$5FAC }
; { #UNDERWURLDE$911F }
; LIST#

; Game Selection Screen Text
;
; The text for each line of the menu. The last character of each line has
; bit 7 set to show that it is the end of the string.
@label=GameSelection_Text
t$636C DEFM "GAME SELECTIO","N"+$80        ; "GAME SELECTION".
 $637A DEFM "1   1 PLAYER GAM","E"+$80     ; "1   1 PLAYER GAME".
 $638B DEFM "2   2 PLAYER GAM","E"+$80     ; "2   2 PLAYER GAME".
 $639C DEFM "3   KEYBOAR","D"+$80          ; "3   KEYBOARD".
 $63A8 DEFM "4   KEMPSTON JOYSTIC","K"+$80 ; "4   KEMPSTON JOYSTICK".
 $63BD DEFM "5   CURSOR   JOYSTIC","K"+$80 ; "5   CURSOR   JOYSTICK".
 $63D2 DEFM "0   START GAM","E"+$80        ; "0   START GAME".
; View the equivalent code in;
; #LIST
; { #ATICATAC$7CF8 }
; { #JETPAC$6299 }
; { #LUNARJETMAN$811C }
; { #PSSST$6288 }
; { #SABREWULF$B4B0 }
; { #TRANZAM$5FB1 }
; { #UNDERWURLDE$9125 }
; LIST#

; Write Menu Line
;
; Used by the routine at #R$6332.
; .
; Prints one line of the game selection menu. This works in the same way
; as #R$7488, except that the text is pointed to by #REGde' and the screen
; position is in #REGhl', and the attribute is not part of the string, it is
; taken from #R$5F24.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$6298,stop=$62B5,clear=1,sp=$5F00)
; #POKES$5F0D,$01
; #SIM(start=$62B5,stop=$62BC,sp=$5F00)
; #POKES$5F24,$47
; #SCR$02,$06,$06,$14,$03(menu-line-before)
; | #SIM(start=$63E0,stop=$0000,hl=$3838,de=$637A,sp=$5E00)
; #SCR$02,$06,$06,$14,$03(menu-line-after) } UDGTABLE# #POPS
;
; DE' Address of the text
; HL' Position of the line
@label=MenuWriteText
c$63E0 PUSH HL       ; Stash the position on the stack.
 $63E1 CALL $76E3    ; Convert the position to a screen address using #R$76E3.
 $63E4 LD A,($5F24)  ; Fetch the menu attribute byte from #R$5F24.
 $63E7 EX AF,AF'     ; Switch to the shadow #REGaf register.
 $63E8 EXX           ; Switch to the normal registers.
 $63E9 POP HL        ; Restore the position from the stack.
 $63EA CALL $7534    ; Convert the position to an attribute address using
                     ; #R$7534.
 $63ED JP $7494      ; Jump to #R$7494 to print the text.
; View the equivalent code in;
; #LIST
; { #ATICATAC$7D8A }
; { #JETPAC$62FF }
; { #LUNARJETMAN$81AB }
; { #PSSST$62E7 }
; { #SABREWULF$B52D }
; { #TRANZAM$5F97 }
; { #UNDERWURLDE$91B0 }
; LIST#

; Initialise New Game
;
; Used by the routine at #R$6428.
; .
; Sets up the data for both players at the start of a game. Both players
; start with level #N$00 and four lives. The data for the player who is not
; active is then changed; the level is set to #N$FF, so that when it is the
; turn of that player #R$6C3C (which adds one to the level) starts them on
; level #N$00, and the lives are made #N$05 for a two player game or #N$00 for
; a one player game.
;
; .
;
; Set the level and the lives for both players.
@label=NewGame
c$63F0 LD B,$02      ; Set the player counter to #N$02 (one for each player).
@label=NewGame_Loop
*$63F2 PUSH BC       ; Stash the player counter on the stack.
 $63F3 XOR A         ; {Write #N$00 to #R$5F2D.
 $63F4 LD ($5F2D),A  ; }
; Set both players starting lives.
 $63F7 LD A,$04      ; {Write #N$04 to #R$5F2E.
 $63F9 LD ($5F2E),A  ; }
 $63FC CALL $6416    ; Call #R$6416 to swap the player data between 1UP and 2UP
                     ; players.
 $63FF POP BC        ; Restore the player counter from the stack.
 $6400 DJNZ $63F2    ; Decrease the player counter by one and loop back to #R$63F2 until
                     ; both players have been set up.
; Note this is +#N$01 to #R$63F7 as you "spend a life", and 1UP goes first.
 $6402 LD A,$05      ; {Write #N$05 to #R$5F32.
 $6404 LD ($5F32),A  ; }
; The level for the other player starts at #N$FF.
 $6407 LD A,$FF      ; {Write #N$FF to #R$5F31.
 $6409 LD ($5F31),A  ; }
; Handle a one player game; the other player has no lives.
 $640C LD A,($5F0C)  ; Fetch the game options.
 $640F AND %00000001 ; Keep only bit 0 (set for a two player game).
 $6411 RET NZ        ; Return if this is a two player game.
 $6412 LD ($5F32),A  ; Write #N$00 to the lives of the inactive player
                     ; (#R$5F32).
 $6415 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #LUNARJETMAN$A84C }
; { #TRANZAM$6391 }
; LIST#

; 1UP/ 2UP Swapper
;
; Used by the routines at #R$63F0 and #R$6BAF.
; .
; Swaps the data for the active player (#R$5F2D) with the data for the
; other player (#R$5F31).
;
; .
;
; This routine "swaps" the data between #REGde and #REGhl.
@label=ChangePlayer
c$6416 LD HL,$5F2D   ; Point #REGhl at the data for the active player.
 $6419 LD DE,$5F31   ; Point #REGde at #R$5F31.
 $641C LD B,$04      ; Set the counter to #N$04
                     ; (the level, lives, ingredients needed and level number).
; This looks complicated but it's just grabbing the data from #REGde,
; grabbing the data from #REGhl, and writing the others data to each one.
@label=ChangePlayer_States
*$641E LD A,(DE)     ; Fetch a byte of the data for the inactive player.
 $641F LD C,(HL)     ; Fetch the matching byte of the data for the active
                     ; player.
 $6420 LD (HL),A     ; Give the active player the byte from the inactive
                     ; player.
 $6421 LD A,C        ; {Give the inactive player the byte from the active
 $6422 LD (DE),A     ; player.}
 $6423 INC HL        ; {Move onto the next byte of data for both players.
 $6424 INC DE        ; }
 $6425 DJNZ $641E    ; Decrease the counter by one and loop back to #R$641E until all four
                     ; bytes have been swapped.
 $6427 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #JETPAC$616A }
; { #LUNARJETMAN$A880 }
; { #PSSST$613B }
; { #SABREWULF$B235 }
; LIST#

; Start Game
;
; Used by the routine at #R$6298.
; .
; Starts a new game when "0" is pressed on the game selection menu. The
; screen is blanked, the opening tune is played (unless the sound is muted)
; and the data for the game is reset. Then the first level is set up, and the
; game carries on in the main loop.
@label=StartGame
c$6428 CALL $74E2    ; Blank the attribute buffer using #R$74E2.
 $642B CALL $74D4    ; Blank the screen buffer using #R$74D4.
; Play the opening tune, unless the sound is muted.
 $642E LD A,($5F0D)  ; {Jump to #R$643A if #R$5F0D is not zero.
 $6431 AND A         ;
 $6432 JR NZ,$643A   ; }
 $6434 LD DE,$65C8   ; Point #REGde at #R$65C8.
 $6437 CALL $6568    ; Play the tune using #R$6568.
; Reset both of the level numbers which are shown on the screen.
@label=SkipMusic
*$643A XOR A         ; {Write #N$00 to; #LIST { #R$5F30 } { #R$5F34 } LIST#
 $643B LD ($5F30),A  ;
 $643E LD ($5F34),A  ; }
; Blank everything from the 1UP score to the end of the last actor slot,
; which resets the scores, the sprite data and all of the actors.
 $6441 LD HL,$5F0E   ; {Write #N$00 to every byte from #R$5F0E to #N$5F84
 $6444 LD (HL),$00   ; (#N$0077 bytes).
 $6446 LD D,H        ;
 $6447 LD E,L        ;
 $6448 INC DE        ;
 $6449 LD BC,$0076   ;
 $644C LDIR          ; }
 $644E CALL $63F0    ; Set up the data for both players using #R$63F0.
 $6451 CALL $7186    ; Reset the self modifying code using #R$7186.
 $6454 CALL $6C58    ; Set up the first level using #R$6C58.
; Continue on to #R$6457.
; .
; View the equivalent code in;
; #LIST
; { #ATICATAC$7D9A }
; { #JETPAC$6333 }
; { #LUNARJETMAN$81BB }
; { #PSSST$632D }
; { #TRANZAM$5FEF }
; LIST#

; Run Main Loop
;
; Used by the routine at #R$71D8.
; .
; The main loop of the game. Each pass through the loop runs the handler
; for one actor. The handler is chosen by the actor ID, using the table at
; #R$6486. The address of #R$71A3 is put on the stack first, so that when
; the handler returns, the game moves on to the next actor.
; .
; A pass is started at #R$6457 with the first of the six actors which start at
; #R$5F55. Whenever the frame counter has changed, #R$7160 runs an extra pass
; over the first four actors (which are Charlie and the sound effect actor).
;
; IX Actor
@label=MainLoop_NewPass
c$6457 LD SP,$5F00   ; Set the stack pointer to #R$5F00.
 $645A EI            ; Enable interrupts.
 $645B LD IX,$5F55   ; Start with the first of the six spawn slots (#R$5F55).
 $645F XOR A         ; {Write #N$00 to #R$5F1B to reset the current nasties.
 $6460 LD ($5F1B),A  ; }
; This entry point is used by the routines at #R$7160 and #R$71A3.
; .
; Run the frame update if the frame counter has changed.
@label=MainLoop
*$6463 LD A,($5C78)  ; {Compare #SKOOLKID$5C78(FRAMES) and #R$5F22.
 $6466 LD C,A        ;
 $6467 LD A,($5F22)  ; }
; If interrupts are enabled, then #R$7160 will be called and DI executed.
 $646A CP C          ; {If they are not equal call #R$7160.
 $646B CALL NZ,$7160 ; }
; Make the handler return to #R$71A3, then find the handler.
 $646E LD HL,$71A3   ; Point #REGhl at #R$71A3 (the routine for the next
                     ; actor).
 $6471 PUSH HL       ; Stash it on the stack, so that the handler returns to
                     ; it.
 $6472 LD HL,$6486   ; Point #REGhl at #R$6486.
 $6475 LD A,(IX+$00) ; Fetch the actor ID.
; This entry point is used by the routine at #R$6607.
@label=MainLoop_Dispatch
*$6478 RLCA          ; Double the ID, as there are two bytes for each handler.
 $6479 AND %01111110 ; Keep only bits 1-6 (bits 0-5 of the ID, doubled).
 $647B LD C,A        ; {Use the result as an offset into the table of handlers.
 $647C LD B,$00      ; }
 $647E ADD HL,BC     ; Find the entry for the handler of this actor.
 $647F LD A,(HL)     ; Fetch the low byte of the handler address.
 $6480 INC HL        ; Move onto the high byte.
 $6481 LD H,(HL)     ; Fetch the high byte of the handler address.
 $6482 LD L,A        ; Put the low byte in #REGl, so that #REGhl is the address of the
                     ; handler.
 $6483 JP $5CB0      ; Jump to #SKOOLKID$5CB0(NMIADD) which should just jump to
                     ; the address in #REGhl.

; Actor Handler Table
;
; The code which handles an actor is chosen by bits 0-5 of its ID (byte
; #N$00 of the actor). The ID is also used to choose the sprite (see #R$7702).
; #TABLE(default,centre,centre,centre)
; { =h IDs | =h Actor | =h Handler }
; { #N$00, #N$0C, #N$17 | Empty slot (#N$0C is hatless Charlie) | #R$7152 }
; { #N$01-#N$02 | Charlie | #R$7048 }
; { #N$03 | Flour shot | #R$6F78 }
; { #N$04-#N$05 | Custard | #R$7281 }
; { #N$06-#N$07 | Level introduction | #R$6D89 }
; { #N$08-#N$09 | Sugar | #R$6CB7 }
; { #N$0A-#N$0B | Level timer | #R$6C31 }
; { #N$0D | Charlie's hat | #R$6AA0 }
; { #N$0E | Falling Charlie | #R$6B8B }
; { #N$0F | Cleared actor | #R$6B18 }
; { #N$10-#N$11 | Chocolate | #R$69D4 }
; { #N$12-#N$13 | Cheese | #R$6930 }
; { #N$14-#N$15 | Peel | #R$669B }
; { #N$16 | Sound effect (notes) | #R$689A }
; { #N$18 | End of life | #R$6BAF }
; { #N$19 | Sound effect (sweep) | #R$6888 }
; { #N$1A-#N$1D | Pike and tin can | #R$6765 }
; { #N$1E-#N$23 | Tack, washer and bolt | #R$6996 }
; { #N$24-#N$25 | Monster | #R$6607 }
; { #N$26-#N$27 | Explosion | #R$65E8 }
