; Calculate Screen Address
;
; Used by the routines at #R$60E2, #R$63E0, #R$7378, #R$7488, #R$7557 and
; #R$7584.
; .
; Converts the pixel co-ordinates to the address in the screen buffer of
; the byte which contains that pixel.
;
;   HL Pixel co-ordinates (horizontal in #REGl, vertical in #REGh)
; O:HL Screen address
@label=ScreenAddress
c$76E3 LD A,L        ; Fetch the horizontal co-ordinate.
 $76E4 RRCA          ; {Divide by #N$08 (to get the column).
 $76E5 RRCA          ;
 $76E6 RRCA          ; }
 $76E7 AND %00011111 ; Keep only bits 0-4.
 $76E9 LD L,A        ; Store the column in #REGl.
 $76EA LD A,H        ; Fetch the vertical co-ordinate.
 $76EB RLCA          ; {#REGa=#REGa * #N$04.
 $76EC RLCA          ; }
 $76ED AND %11100000 ; Keep only bits 5-7.
 $76EF OR L          ; Combine with the column in #REGl.
 $76F0 LD L,A        ; Store the result in #REGl.
 $76F1 LD A,H        ; Fetch the vertical co-ordinate.
 $76F2 AND %00000111 ; Keep only bits 0-2 (the pixel row within the character
                     ; cell).
 $76F4 EX AF,AF'     ; Switch to the shadow #REGaf register to hold the pixel
                     ; row.
 $76F5 LD A,H        ; Fetch the vertical co-ordinate.
 $76F6 RRCA          ; {Divide by #N$08 (to get the third of the screen).
 $76F7 RRCA          ;
 $76F8 RRCA          ; }
 $76F9 AND %00011000 ; Keep only bits 3-4.
 $76FB OR %01000000  ; Set bit 6.
 $76FD LD H,A        ; Store the result in #REGh.
 $76FE EX AF,AF'     ; Switch to the shadow #REGaf register to fetch the pixel
                     ; row.
 $76FF OR H          ; Combine with #REGh.
 $7700 LD H,A        ; Store the result in #REGh.
 $7701 RET           ; Return.
