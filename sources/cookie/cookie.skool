 $64E6 DEFW $64F4

; Start Cake
;
; Used by the routine at #R$6C3C.
; .
; Copies the templates for the five pieces of the cake into the actor
; slots which start at #R$5F55. This happens when the fifth level of a set of
; five has been completed (see #R$6C3C).
@label=StartCake
c$64E8 LD HL,$6524   ; Point #REGhl at the templates for the five pieces of the
                     ; cake.
 $64EB LD DE,$5F55   ; Point #REGde at #R$5F55.
 $64EE LD BC,$0028   ; Set the number of bytes to copy to #N$0028
                     ; (five actors of eight bytes).
 $64F1 LDIR          ; Copy the templates to the actor slots.
 $64F3 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #UNDERWURLDE$A3DD }
; LIST#

; Handle Cake
;
; The handler for the five pieces of the cake (IDs #N$2C to #N$30). Each
; piece rises until its vertical co-ordinate is #N$A0. Then the music is played
; (unless the sound is off), and the next level is set up.
;
; IX Actor
@label=HandleCake
c$64F4 CALL $76D0    ; Record the position of the sprite using #R$76D0.
 $64F7 LD HL,$5F1B   ; {Increase the number of actors in play (#R$5F1B) by one.
 $64FA INC (HL)      ; }
 $64FB LD A,(IX+$02) ; Fetch the vertical co-ordinate of the piece of cake.
 $64FE CP $A0        ; {Jump to #R$650B if the piece has risen as far as it
 $6500 JR Z,$650B    ; goes.}
 $6502 DEC (IX+$02)  ; Raise the piece of cake by decreasing the vertical co-ordinate by
                     ; one.
 $6505 CALL $75CC    ; Erase the sprite and draw it in its new position using
                     ; #R$75CC.
 $6508 JP $74EE      ; Jump to #R$74EE to colour the sprite.
; All of the pieces of the cake stop at the same height, so the first one
; to be handled does the following; it plays the tune for a level finishing and
; then goes on to the next level.
@label=HandleCake_Finished
*$650B LD A,($5F0D)  ; Fetch the sound mute flag.
 $650E AND A         ; Is the sound switched off?
 $650F JR NZ,$651D   ; Jump to #R$651D if it is.
 $6511 LD DE,$65DA   ; Point #REGde at #R$65DA.
 $6514 CALL $6568    ; Play the tune using #R$6568.
; Remove all of the actors, and then set up the next level.
@label=HandleCake_NextLevel
*$6517 CALL $713D    ; Remove all of the actors using #R$713D.
 $651A JP $6C58      ; Jump to #R$6C58.
; If the sound is switched off, pause instead of playing the tune.
@label=HandleCake_Pause
*$651D LD B,$08      ; Set the number of times to count down for the pause to
                     ; #N$08.
 $651F CALL $6BF3    ; Pause using #R$6BF3.
 $6522 JR $6517      ; Jump to #R$6517.

; Cake Template
;
; The five pieces of the cake. Each is an actor, with the ID, horizontal
; co-ordinate, vertical co-ordinate and colour (bright yellow), followed by four
; bytes which the handler does not use.
@label=CakeTemplate
b$6524 DEFB $2C,$40,$B0,$46,$00,$00,$00,$00
 $652C DEFB $2D,$50,$B0,$46,$00,$00,$00,$00
 $6534 DEFB $2E,$60,$B0,$46,$00,$00,$00,$00
 $653C DEFB $2F,$70,$B0,$46,$00,$00,$00,$00
 $6544 DEFB $30,$80,$B0,$46,$00,$00,$00,$00

; Handle Batter
;
; The handler for the first three frames of the batter (IDs #N$28 to
; #N$2A). Each time it is called, the actor moves on to the next frame.
;
; IX Actor
@label=HandleBatter
c$654C CALL $76D0    ; Record the position of the sprite using #R$76D0.
 $654F LD HL,$5F1B   ; {Increase the number of actors in play (#R$5F1B) by one.
 $6552 INC (HL)      ; }
 $6553 INC (IX+$00)  ; Increase the actor ID by one, which chooses the next
                     ; frame.
 $6556 CALL $75CC    ; Erase the sprite and draw the next frame using #R$75CC.
 $6559 JP $74EE      ; Jump to #R$74EE to colour the sprite.

; Handle Final Batter
;
; The handler for the last frame of the batter (ID #N$2B), which removes
; the batter from the screen and then the actor.
;
; IX Actor
@label=HandleBatter_Final
c$655C CALL $7617      ; Erase the sprite using #R$7617.
 $655F LD HL,$5F1B     ; {Increase the number of actors in play (#R$5F1B) by
 $6562 INC (HL)        ; one.}
 $6563 LD (IX+$00),$00 ; Write #N$00 to the actor ID.
 $6567 RET             ; Return.

; Play Music
;
; Used by the routines at #R$6428, #R$64F4 and #R$6B8B.
; .
; Plays a tune using the #SKOOLKID$03B5(BEEPER) routine. Each byte of
; the tune is a note number, in bits 0-4, which chooses the pitch and length of
; the note from the table at #R$6594. The tune ends at the byte #N$FF.
;
; DE Address of the tune
@label=PlayMusic
c$6568 LD A,(DE)     ; Fetch the next note of the tune.
 $6569 CP $FF        ; {Return if the end of the tune (#N$FF) has been reached.
 $656B RET Z         ; }
 $656C AND %00011111 ; Keep only bits 0-4 (the note number).
 $656E DEC A         ; Decrease the note number by one (note numbers start from
                     ; #N$01).
 $656F SLA A         ; Double the note number, as there are two bytes for each
                     ; note.
 $6571 LD C,A        ; {Use the result as an offset into the table of notes.
 $6572 LD B,$00      ; }
 $6574 LD HL,$6594   ; {Find the entry for the note in #R$6594.
 $6577 ADD HL,BC     ; }
 $6578 PUSH DE       ; Stash the pointer to the tune on the stack.
 $6579 LD A,(HL)     ; Fetch the pitch of the note.
 $657A INC HL        ; Increment #REGhl by one.
 $657B LD E,(HL)     ; Fetch the length of the note into #REGe.
 $657C LD D,$00      ; Set the high byte of the length to #N$00.
 $657E LD L,A        ; Put the pitch in #REGl.
 $657F LD H,$00      ; Set the high byte of the pitch to #N$00.
 $6581 SLA L         ; {Multiply the pitch by #N$04, for the
 $6583 RL H          ; #SKOOLKID$03B5(BEEPER) routine.
 $6585 SLA L         ;
 $6587 RL H          ; }
 $6589 PUSH IX       ; Stash #REGix on the stack.
 $658B CALL $03B5    ; Play the note using #SKOOLKID$03B5(BEEPER).
 $658E POP IX        ; Restore #REGix from the stack.
 $6590 POP DE        ; Restore the pointer to the tune from the stack.
 $6591 INC DE        ; Move on to the next note of the tune.
 $6592 JR $6568      ; Jump back to #R$6568 to play the next note (the tune only ends when
                     ; the terminator is reached).
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$B2CF }
; { #SABREWULF$BD6E }
; LIST#

; Music Note Table
;
; The pitch and the length of each note which can be played by #R$6568.
; The first byte is multiplied by #N$04 to give the pitch for the ROM routine,
; and the second byte is the length.
;
; .
;
; Notes #N$01 to #N$0D.
@label=MusicNotes
b$6594 DEFB $A7,$82
 $6596 DEFB $9E,$8A
 $6598 DEFB $95,$92
 $659A DEFB $8D,$9A
 $659C DEFB $85,$A4
 $659E DEFB $7D,$AE
 $65A0 DEFB $76,$B8
 $65A2 DEFB $70,$C4
 $65A4 DEFB $69,$D0
 $65A6 DEFB $64,$DC
 $65A8 DEFB $5E,$EA
 $65AA DEFB $59,$F6
 $65AC DEFB $54,$FF
; Notes #N$0E to #N$1A.
 $65AE DEFB $A7,$41
 $65B0 DEFB $9E,$45
 $65B2 DEFB $95,$49
 $65B4 DEFB $8D,$4D
 $65B6 DEFB $85,$52
 $65B8 DEFB $7D,$57
 $65BA DEFB $76,$5C
 $65BC DEFB $70,$62
 $65BE DEFB $69,$68
 $65C0 DEFB $64,$6E
 $65C2 DEFB $5E,$75
 $65C4 DEFB $59,$7B
 $65C6 DEFB $54,$83
; View the equivalent code in;
; #LIST
; { #SABREWULF$BDD2 }
; LIST#
; .
; Notes #N$01 to #N$0D have a full length, and notes #N$0E to #N$1A are the
; same pitches but are about half the length.

; Music Data
;
; Three tunes. Each is a list of note numbers, ended by #N$FF. The first
; is played when a game starts, the second when Charlie loses a life and the
; third when a level is finished.
;
; .
;
; The tune which is played when a game starts.
; #HTML(#AUDIO0(start-up-tune.wav)(#INCLUDE(StartUpTune)))
@label=MusicData
b$65C8 DEFB $0E,$01,$0E,$03,$04,$05,$05,$01
 $65D0 DEFB $FF
; The tune which is played when Charlie loses a life.
; #HTML(#AUDIO0(lose-life-tune.wav)(#INCLUDE(LoseLifeTune)))
@label=MusicData_LoseLife
 $65D1 DEFB $0E,$01,$0E,$03,$05,$06,$01,$06
 $65D9 DEFB $FF
; The tune which is played when a level is finished.
; #HTML(#AUDIO0(level-finished-tune.wav)(#INCLUDE(LevelFinishedTune)))
@label=MusicData_LevelFinished
 $65DA DEFB $0D,$05,$06,$07,$08,$06,$05,$03
 $65E2 DEFB $01,$05,$08,$05,$01,$FF

; Handle Explosion
;
; The handler for the explosion (IDs #N$26 and #N$27) which is shown when
; a flour shot ends. The sprite is chosen by the lowest bit of a counter in byte
; #N$07 of the actor, which starts at #N$03 and counts down to zero.
; .
; The sprite is drawn each time without the previous one being erased. As the
; sprites are drawn using exclusive OR, drawing the two frames in turn leaves
; the screen blank after the fourth time, so the explosion is removed when the
; counter reaches zero.
;
; IX Actor
@label=HandleExplosion
c$65E8 LD A,(IX+$07)   ; Fetch the explosion counter.
 $65EB AND %00000001   ; Keep only bit 0
                       ; (which of the two frames of the explosion to show).
 $65ED ADD A,$26       ; Add #N$26 to get the ID of the frame.
 $65EF LD (IX+$00),A   ; Set the actor ID to the ID of the frame.
 $65F2 CALL $7617      ; Draw the explosion using #R$7617.
 $65F5 CALL $74EE      ; Colour the sprite using #R$74EE.
 $65F8 LD A,(IX+$07)   ; Fetch the explosion counter.
 $65FB AND A           ; Has the explosion finished (is the counter zero)?
 $65FC JR Z,$6602      ; Jump to #R$6602 if it has.
 $65FE DEC (IX+$07)    ; Decrease the explosion counter by one.
 $6601 RET             ; Return.
@label=HandleExplosion_Remove
*$6602 LD (IX+$00),$00 ; Remove the explosion by writing #N$00 to the actor ID.
 $6606 RET             ; Return.

; Handle Monster
;
; The handler for the monster (IDs #N$24 and #N$25), which pops up out of
; one of the dustbins at the bottom of the screen (it is created by #R$67E2).
; Byte #N$06 of the actor is its state, which chooses which code at #R$6639 is
; run using the table at #R$6631. If a flour shot hits the monster it is
; coloured white (see #R$7317), the points are added to the score, and it goes
; straight to the state in which it drops back into the dustbin.
;
; IX Actor
@label=HandleMonster
c$6607 LD HL,$5F1B     ; Point #REGhl at the number of actors in play
                       ; (#R$5F1B).
 $660A INC (HL)        ; Increase it by one.
 $660B CALL $76D0      ; Record the position of the sprite using #R$76D0.
 $660E LD A,(IX+$03)   ; Fetch the colour of the monster.
 $6611 CP $47          ; {Jump to #R$6628 if it has been hit already.
 $6613 JR Z,$6628      ; }
 $6615 CALL $7317      ; Test whether a flour shot has hit the actor using
                       ; #R$7317.
 $6618 BIT 7,(IX+$00)  ; {Jump to #R$6628 if the monster has not been hit by the flour shot
 $661C JR Z,$6628      ; (is bit 7 of the actor ID set).}
 $661E LD (IX+$06),$02 ; Write #N$02 to the state of the monster, so that it drops back into
                       ; the dustbin.
 $6622 LD BC,$0125     ; Set the points for hitting the monster (#N$0125 in
                       ; BCD).
 $6625 CALL $7415      ; Add the points to the score using #R$7415.
@label=HandleMonster_State
*$6628 LD HL,$6631     ; Point #REGhl at the table of monster states.
 $662B LD A,(IX+$06)   ; Fetch the state of the monster.
 $662E JP $6478        ; Jump to #R$6478 to run the code for the state.

; Monster State Table
;
; The code for each state of the monster.
; #TABLE(default,centre,centre)
; { =h State | =h Handler }
; { #N$00 | #R$6639 }
; { #N$01 | #R$6653 }
; { #N$02 | #R$6669 }
; { #N$03 | #R$6681 }
; TABLE#
@label=MonsterStates
w$6631 DEFW $6639
 $6633 DEFW $6653
 $6635 DEFW $6669
 $6637 DEFW $6681

; Handle Monster Rising
;
; State #N$00 of the monster; it moves up one pixel at a time until it
; has come out of the dustbin.
;
; IX Actor
@label=HandleMonster_Rising
c$6639 LD A,(IX+$02)   ; Fetch the vertical co-ordinate.
 $663C DEC A           ; Raise the monster by one pixel.
 $663D CP $A0          ; {Jump to #R$664A if the monster has come out of the
 $663F JR C,$664A      ; dustbin.}
; This entry point is used by the routine at #R$6669.
@label=HandleMonster_Move
*$6641 LD (IX+$02),A   ; Update the vertical co-ordinate.
; This entry point is used by the routine at #R$6653.
@label=HandleMonster_Draw
*$6644 CALL $75CC      ; Erase the sprite and draw it in its new position using
                       ; #R$75CC.
 $6647 JP $74EE        ; Jump to #R$74EE to colour the sprite.
; Start the pause while the monster is out of the dustbin.
@label=HandleMonster_StartWait
*$664A LD (IX+$07),$10 ; Write #N$10 to byte #N$07 of the actor (the timer).
; This entry point is used by the routine at #R$6653.
@label=HandleMonster_NextState
*$664E INC (IX+$06)    ; Increase the actor state by one.
 $6651 JR $6644        ; Jump to #R$6644.

; Handle Monster Waiting
;
; State #N$01 of the monster; it stays where it is for a short time,
; changing between its two frames every #N$08 frames.
;
; IX Actor
;
; See #POKE(infinite_lives,Infinite Lives).
@label=HandleMonster_Waiting
c$6653 DEC (IX+$07)  ; Decrease the timer in byte #N$07 of the actor by one.
 $6656 JR Z,$664E    ; Jump to #R$664E if the timer is zero.
 $6658 LD A,($5F1D)  ; Fetch the frame counter.
 $665B AND %00000111 ; Keep only bits 0-2.
 $665D JR NZ,$6644   ; Jump to #R$6644 unless the frame counter is a multiple
                     ; of #N$08.
 $665F LD A,(IX+$00) ; Fetch the actor ID.
 $6662 XOR %00000001 ; Flip bit 0, which chooses the other frame of the
                     ; monster.
 $6664 LD (IX+$00),A ; Update the actor ID with the other frame of the monster.
 $6667 JR $6644      ; Jump to #R$6644.

; Handle Monster Falling
;
; State #N$02 of the monster; it moves down four pixels at a time until
; it is back inside the dustbin. A random delay (#N$01 to #N$0F frames) is then
; set, and the monster moves on to the next state.
;
; IX Actor
@label=HandleMonster_Falling
c$6669 LD A,(IX+$02) ; Fetch the vertical co-ordinate.
 $666C ADD A,$04     ; Lower the monster by #N$04 pixels.
 $666E CP $B8        ; {Jump to #R$6674 if the monster is back inside the
 $6670 JR NC,$6674   ; dustbin.}
 $6672 JR $6641      ; Jump to #R$6641 to move the monster.
@label=HandleMonster_StartDelay
*$6674 LD A,R        ; Fetch a random number.
 $6676 AND %00001111 ; Keep only bits 0-3.
 $6678 OR %00000001  ; Set bit 0, so that the timer is never zero.
 $667A LD (IX+$07),A ; Write the random number to the timer (byte #N$07 of the
                     ; actor).
 $667D INC (IX+$06)  ; Increase the actor state by one.
 $6680 RET           ; Return.

; Handle Monster Throwing
;
; State #N$03 of the monster; it waits for the timer to run out and then
; turns into something else. If the monster has been hit by a flour shot (and
; so is white) it is removed. Otherwise it becomes the pike (ID #N$1A) or the
; tin can (ID #N$1C), depending on bit 1 of the number of ingredients needed,
; and a sound is started.
;
; IX Actor
@label=HandleMonster_Throwing
c$6681 DEC (IX+$07)  ; Decrease the timer in byte #N$07 of the actor by one.
 $6684 RET NZ        ; Return if the timer is not zero.
 $6685 LD A,(IX+$03) ; Fetch the colour of the monster.
 $6688 CP $47        ; Is the monster white (#COLOUR$47), which means it has
                     ; been hit?
 $668A LD A,$00      ; Set the actor ID to #N$00 (the actor will be removed).
 $668C JR Z,$6695    ; Jump to #R$6695 if the monster has been hit.
 $668E LD A,($5F2F)  ; Fetch the number of ingredients needed.
 $6691 AND %00000010 ; Keep only bit 1.
 $6693 ADD A,$1A     ; Add #N$1A, to choose between the pike and the tin can.
@label=HandleMonster_SetID
*$6695 LD (IX+$00),A ; Set the actor ID to the new nasty.
 $6698 JP $6915      ; Jump to #R$6915.

; Handle Peel
;
; The handler for the orange peel (IDs #N$14 and #N$15). It wanders about
; in a wavy path. Byte #N$06 of the actor holds the direction (bit 0 is set for
; right, bit 1 is set for down) and which byte of each pair in the table at
; #R$6745 is used for which direction (bit 2). Byte #N$07 is a counter, which
; chooses the speeds to use from the table, and changes the sprite frame.
; .
; While the peel is entering from the right of the screen (a horizontal
; co-ordinate of #N$C4 or more) it can't hit Charlie or be hit.
;
; IX Actor
@label=HandlePeel
c$669B CALL $76D0      ; Record the position of the sprite using #R$76D0.
 $669E LD HL,$5F1B     ; {Increase #R$5F1B by one.
 $66A1 INC (HL)        ; }
 $66A2 LD A,(IX+$01)   ; Fetch the horizontal co-ordinate.
 $66A5 CP $C4          ; {Jump to #R$66ED if the peel is still entering from
 $66A7 JR NC,$66ED     ; the right.}
 $66A9 CALL $6A46      ; Test whether the peel has hit Charlie using #R$6A46.
 $66AC DEC E           ; Has the peel hit Charlie (is #REGe now zero)?
 $66AD JP Z,$6A73      ; Jump to #R$6A73 if Charlie has been hit.
 $66B0 CALL $7317      ; Test whether a flour shot has hit the peel using
                       ; #R$7317.
 $66B3 BIT 7,(IX+$00)  ; {Jump to #R$730D if the peel has been hit.
 $66B7 JP NZ,$730D     ; }
; Every #N$10 frames pick a new random direction.
 $66BA LD A,(IX+$07)   ; Fetch the direction counter.
 $66BD INC A           ; Increase the direction counter by one.
 $66BE AND %00001111   ; Keep only bits 0-3.
 $66C0 LD (IX+$07),A   ; Update the direction counter.
 $66C3 JR NZ,$66CC     ; Jump to #R$66CC if the counter is not zero.
 $66C5 LD A,R          ; Fetch a random number.
 $66C7 AND %00000111   ; Keep only bits 0-2.
 $66C9 LD (IX+$06),A   ; Write the random number to the direction of the peel
                       ; (byte #N$06 of the actor).
; Move vertically.
@label=HandlePeel_Vertical
*$66CC CALL $6735      ; Find the speeds for the counter using #R$6735.
 $66CF LD (IX+$03),$43 ; Set the colour to #N$43.
 $66D3 JR NZ,$66D6     ; Jump to #R$66D6 if bit 2 of the actor state is set.
 $66D5 INC HL          ; Use the second byte of the pair.
@label=HandlePeel_VerticalSpeed
*$66D6 LD A,(HL)       ; Fetch the speed.
 $66D7 BIT 1,(IX+$06)  ; {Jump to #R$66DF if the peel is moving down.
 $66DB JR NZ,$66DF     ; }
 $66DD NEG             ; Make the speed negative.
@label=HandlePeel_VerticalMove
*$66DF ADD A,(IX+$02)  ; Add the speed to the vertical co-ordinate.
 $66E2 CP $A0          ; {Jump to #R$6719 if the peel has reached the bottom.
 $66E4 JR NC,$6719     ; }
 $66E6 CP $20          ; {Jump to #R$6723 if the peel has reached the top.
 $66E8 JR C,$6723      ; }
 $66EA LD (IX+$02),A   ; Update the vertical co-ordinate.
; Move horizontally.
@label=HandlePeel_Horizontal
*$66ED CALL $6735      ; Find the speeds for the counter using #R$6735.
 $66F0 JR Z,$66F3      ; Jump to #R$66F3 if bit 2 of the actor state is not
                       ; set.
 $66F2 INC HL          ; Use the second byte of the pair.
@label=HandlePeel_HorizontalSpeed
*$66F3 LD A,(HL)       ; Fetch the speed.
 $66F4 BIT 0,(IX+$06)  ; {Jump to #R$66FC if the peel is moving right.
 $66F8 JR NZ,$66FC     ; }
 $66FA NEG             ; Make the speed negative.
@label=HandlePeel_HorizontalMove
*$66FC ADD A,(IX+$01)  ; Add the speed to the horizontal co-ordinate.
 $66FF CP $04          ; {Jump to #R$6729 if the peel has reached the left
 $6701 JR C,$6729      ; edge.}
 $6703 CP $C0          ; {Jump to #R$672F if the peel has reached the right
 $6705 JR NC,$672F     ; edge.}
@label=HandlePeel_Animate
*$6707 LD (IX+$01),A   ; Update the horizontal co-ordinate.
 $670A LD A,(IX+$07)   ; Fetch the direction counter.
 $670D RRA             ; Shift the counter right by one.
 $670E AND %00000001   ; Keep only bit 0.
 $6710 XOR (IX+$00)    ; Flip the bit 0 of the actor ID, when bit 1 of the
                       ; counter is set.
 $6713 LD (IX+$00),A   ; Update the actor ID.
 $6716 JP $72D4        ; Jump to #R$72D4 to move and colour the sprite.
; The peel has reached the bottom, so move it up.
@label=HandlePeel_Bottom
*$6719 LD (IX+$02),$A0 ; Write #N$A0 to the vertical co-ordinate.
 $671D RES 1,(IX+$06)  ; Reset bit 1 of the actor state.
 $6721 JR $66ED        ; Jump to #R$66ED.
; The peel has reached the top, so move it down.
@label=HandlePeel_Top
*$6723 SET 1,(IX+$06)  ; Set bit 1 of the actor state.
 $6727 JR $66ED        ; Jump to #R$66ED.
; The peel has reached the left edge, so move it right.
@label=HandlePeel_LeftEdge
*$6729 SET 0,(IX+$06)  ; Set bit 0 of the actor state.
 $672D JR $6707        ; Jump to #R$6707.
; The peel has reached the right edge, so move it left.
@label=HandlePeel_RightEdge
*$672F RES 0,(IX+$06)  ; Reset bit 0 of the actor state.
 $6733 JR $6707        ; Jump to #R$6707.

; Find Wander Speeds
;
; Used by the routine at #R$669B.
; .
; Finds the pair of speeds in the table at #R$6745 which are used for the
; current value of the counter in byte #N$07 of the actor.
;
;   IX Actor
; O:HL Address of the pair of speeds
; O:F The Z flag is set when bit 2 of the actor state is not set
@label=FindWanderSpeeds
c$6735 LD C,(IX+$07)  ; Fetch the counter (byte #N$07 of the actor).
 $6738 SLA C          ; Multiply by #N$02, as there are two bytes for each
                      ; speed.
 $673A LD B,$00       ; Set the high byte of the offset to #N$00.
 $673C LD HL,$6745    ; Point #REGhl at #R$6745.
 $673F ADD HL,BC      ; Find the pair of speeds for the counter.
 $6740 BIT 2,(IX+$06) ; Test bit 2 of the actor state.
 $6744 RET            ; Return.

; Wander Speeds
;
; Pairs of speeds, in pixels, for the peel; one pair for each value of the
; counter (#N$00 to #N$0F). Bit 2 of the actor state chooses which of the two
; speeds is used for the vertical movement, and which is used for the
; horizontal movement.
@label=WanderSpeeds
b$6745 DEFB $03,$00
 $6747 DEFB $03,$00
 $6749 DEFB $03,$01
 $674B DEFB $03,$01
 $674D DEFB $03,$01
 $674F DEFB $02,$02
 $6751 DEFB $02,$02
 $6753 DEFB $02,$02
 $6755 DEFB $02,$02
 $6757 DEFB $02,$02
 $6759 DEFB $02,$02
 $675B DEFB $01,$03
 $675D DEFB $01,$03
 $675F DEFB $01,$03
 $6761 DEFB $00,$03
 $6763 DEFB $00,$03

; Handle Pike And Tin Can
;
; The handler for the pike and the tin can (IDs #N$1A to #N$1D), which are
; thrown out of a dustbin by the monster (see #R$6681). They fly in an arc;
; byte #N$04 of the actor is the horizontal speed, and byte #N$05 is the
; vertical speed, which is increased by one every #N$08 frames to make them
; fall. They bounce off the sides and the top of the play area, and are removed
; when they drop below the bottom of the screen. When they reach the floor they
; are handled in the same way as an actor which has been hit (see #R$6E25).
;
; IX Actor
@label=HandlePikeAndTinCan
c$6765 CALL $76D0      ; Record the position of the sprite using #R$76D0.
 $6768 LD HL,$5F1B     ; {Increase the number of actors in play (#R$5F1B) by
 $676B INC (HL)        ; one.}
 $676C CALL $6A46      ; Test whether the actor has hit Charlie using #R$6A46.
 $676F DEC E           ; Has the actor hit Charlie (is #REGe now zero)?
 $6770 JP Z,$6A73      ; Jump to #R$6A73 if Charlie has been hit.
 $6773 CALL $7317      ; Test whether a flour shot has hit the actor using
                       ; #R$7317.
 $6776 BIT 7,(IX+$00)  ; {Jump to #R$730D if the actor has been hit.
 $677A JP NZ,$730D     ; }
 $677D LD A,$44        ; Set the colour to #N$44.
 $677F LD (IX+$03),A   ; Update the colour of the actor.
 $6782 LD A,(IX+$02)   ; Fetch the vertical co-ordinate.
 $6785 CP $A0          ; {Jump to #R$730D if the actor has reached the floor.
 $6787 JP NC,$730D     ; }
; Every #N$08 frames, increase the vertical speed.
 $678A LD A,($5F1D)    ; Fetch the frame counter.
 $678D AND %00000111   ; Keep only bits 0-2.
 $678F JR NZ,$6794     ; Jump to #R$6794 if the frame counter is not a multiple
                       ; of #N$08.
 $6791 INC (IX+$05)    ; Increase the vertical speed by one.
; Move vertically.
@label=HandlePikeAndTinCan_Vertical
*$6794 LD A,(IX+$05)   ; Fetch the vertical speed.
 $6797 ADD A,(IX+$02)  ; Add the vertical co-ordinate to get the new position.
 $679A CP $B8          ; {Jump to #R$67CB if the actor has dropped below the bottom of the
 $679C JR NC,$67CB     ; screen.}
 $679E LD (IX+$02),A   ; Update the vertical co-ordinate.
 $67A1 CP $24          ; Compare with #N$24 (the top of the play area).
 $67A3 CALL C,$67D9    ; Call #R$67D9 if the actor has reached the top of the
                       ; play area.
; Move horizontally.
 $67A6 LD A,(IX+$04)   ; Fetch the horizontal speed.
 $67A9 AND A           ; Is the actor moving left (is the speed negative)?
 $67AA JP M,$67BE      ; Jump to #R$67BE if the actor is moving left.
 $67AD ADD A,(IX+$01)  ; Add the horizontal co-ordinate to get the new
                       ; position.
 $67B0 LD (IX+$01),A   ; Update the horizontal co-ordinate.
 $67B3 CP $BC          ; Compare with #N$BC (the right edge of the play area).
 $67B5 CALL NC,$67D0   ; Call #R$67D0 if the actor has reached the right edge.
@label=HandlePikeAndTinCan_Draw
*$67B8 CALL $75CC      ; Erase the sprite and draw it in its new position using
                       ; #R$75CC.
 $67BB JP $74EE        ; Jump to #R$74EE to colour the sprite.
@label=HandlePikeAndTinCan_Left
*$67BE ADD A,(IX+$01)  ; Add the horizontal co-ordinate to get the new
                       ; position.
 $67C1 LD (IX+$01),A   ; Update the horizontal co-ordinate.
 $67C4 CP $04          ; Compare with #N$04 (the left edge of the play area).
 $67C6 CALL C,$67D0    ; Call #R$67D0 if the actor has reached the left edge.
 $67C9 JR $67B8        ; Jump to #R$67B8.
; The actor has dropped below the bottom of the screen.
@label=HandlePikeAndTinCan_Remove
*$67CB LD (IX+$00),$00 ; Write #N$00 to the actor ID.
 $67CF RET             ; Return.

; Reverse Horizontal Speed
;
; Used by the routine at #R$6765.
; .
; Makes the actor move the other way horizontally.
;
; IX Actor
@label=ReverseHorizontalSpeed
c$67D0 LD A,(IX+$04) ; Fetch the horizontal speed.
 $67D3 NEG           ; Reverse the direction by negating the speed.
 $67D5 LD (IX+$04),A ; Update the horizontal speed.
 $67D8 RET           ; Return.

; Reverse Vertical Speed
;
; Used by the routine at #R$6765.
; .
; Makes the actor move the other way vertically.
;
; IX Actor
@label=ReverseVerticalSpeed
c$67D9 LD A,(IX+$05) ; Fetch the vertical speed.
 $67DC NEG           ; Reverse the direction by negating the speed.
 $67DE LD (IX+$05),A ; Update the vertical speed.
 $67E1 RET           ; Return.

; Create Monster
;
; Used by the routine at #R$71D8.
; .
; Creates the monster in the last of the six actor slots (#N$5F7D), unless
; that slot is already in use. The ID is #N$24 or #N$25, depending on bit 0 of
; the number of ingredients that are needed. The monster is put at the bottom
; of one of the four dustbins, which is chosen at random from the table at
; #R$6821, and is coloured green. Bytes #N$04 and #N$05 are the speeds which
; are used when the monster throws something (see #R$6681); they are made from
; the frame counter and a random number. A warble sound is then started.
@label=CreateMonster
c$67E2 LD DE,$5F7D   ; Point #REGde at the monster slot (#R$5F7D).
 $67E5 LD A,(DE)     ; Fetch the actor ID.
 $67E6 AND A         ; Is the slot in use?
 $67E7 RET NZ        ; Return if it is.
 $67E8 LD A,($5F2F)  ; Fetch the number of ingredients needed.
 $67EB AND %00000001 ; Keep only bit 0 (which frame the monster starts on).
 $67ED ADD A,$24     ; Add #N$24 to get the ID of the monster.
 $67EF LD (DE),A     ; Set the actor ID.
 $67F0 INC DE        ; Move on to the horizontal co-ordinate.
 $67F1 LD A,R        ; Fetch a random number.
 $67F3 AND %00000011 ; Keep only bits 0-1 (to choose one of the four dustbins).
 $67F5 LD C,A        ; Use the result as an offset into the dustbin positions.
 $67F6 LD B,$00      ; Set the high byte of the offset to #N$00.
 $67F8 LD HL,$6821   ; Point #REGhl at #R$6821.
 $67FB ADD HL,BC     ; Find the dustbin.
 $67FC LD A,(HL)     ; Fetch the horizontal co-ordinate of the dustbin.
 $67FD LD (DE),A     ; Set the horizontal co-ordinate of the monster.
 $67FE INC DE        ; Move on to the vertical co-ordinate.
 $67FF LD A,$B8      ; Fetch the vertical co-ordinate of the bottom of the
                     ; dustbin.
 $6801 LD (DE),A     ; Set the vertical co-ordinate of the monster.
 $6802 INC DE        ; Move on to the colour.
 $6803 LD A,$44      ; Fetch the colour of the monster (#COLOUR$44).
 $6805 LD (DE),A     ; Set the colour of the monster.
 $6806 INC DE        ; Move on to the horizontal speed.
 $6807 LD A,($5F1D)  ; Fetch the frame counter.
 $680A AND %00000011 ; Keep only bits 0-1.
 $680C NEG           ; Negate the result, so that the monster is thrown to the
                     ; left.
 $680E LD (DE),A     ; Set the horizontal speed.
 $680F INC DE        ; Move on to the vertical speed.
 $6810 LD B,A        ; Keep the horizontal speed in #REGb.
 $6811 LD A,R        ; Fetch a random number.
 $6813 ADD A,B       ; Add the horizontal speed.
 $6814 AND %00000011 ; Keep only bits 0-1.
 $6816 ADD A,$04     ; Add #N$04, so that the monster is always thrown upwards
                     ; quickly.
 $6818 NEG           ; Negate the result, so that it is an upward speed.
 $681A LD (DE),A     ; Set the vertical speed.
 $681B INC DE        ; Move on to the state.
 $681C XOR A         ; Set the state to #N$00 (rising out of the dustbin).
 $681D LD (DE),A     ; Set the state of the monster.
 $681E JP $68FA      ; Jump to #R$68FA.

; Dustbin Positions
;
; The horizontal co-ordinate of each of the four dustbins at the bottom of
; the screen.
@label=DustbinPositions
b$6821 DEFB $08
 $6822 DEFB $28
 $6823 DEFB $98
 $6824 DEFB $B8

; Play Chirp
;
; Used by the routine at #R$706B.
; .
; Plays a short chirp of seven square wave cycles. The period of each
; cycle depends on a counter, and on the value of #R$5F1D.
; #HTML(#AUDIO0(chirp.wav)(#INCLUDE(Chirp)))
@label=PlayChirp
c$6825 LD C,$07      ; Set the cycle counter to #N$07.
@label=PlayChirp_Loop
*$6827 LD A,C        ; Fetch the cycle counter.
 $6828 DAA           ; Decimal adjust the counter, to vary the period of the
                     ; cycle.
 $6829 XOR %11110000 ; Flip bits 4-7.
 $682B RLCA          ; Rotate #REGa left.
 $682C LD D,A        ; Put the result in #REGd (the period).
 $682D LD A,($5F1D)  ; Fetch the frame counter.
 $6830 RRCA          ; {Divide by #N$08 (rotating the bits).
 $6831 RRCA          ;
 $6832 RRCA          ; }
 $6833 AND %01100000 ; Keep only bits 5-6.
 $6835 XOR D         ; Combine with the period.
 $6836 LD D,A        ; Update the period.
 $6837 CALL $68B1    ; Play a cycle using #R$68B1.
 $683A DEC C         ; Decrease the cycle counter by one.
 $683B JR NZ,$6827   ; Loop back to #R$6827 until the cycle counter is zero.
 $683D RET           ; Return.

; Play Rising Tone
;
; Used by the routine at #R$7317.
; .
; Plays a tone which rises in pitch. The more actors there are in play
; (#R$5F1B), the longer the tone. The audio is for #N$04 actors in play.
; #HTML(#AUDIO0(rising-tone.wav)(#INCLUDE(RisingTone)))
@label=PlayRisingTone
c$683E LD A,($5F1B)  ; Fetch the number of actors in play.
 $6841 RLCA          ; {Multiply by #N$08 (rotating the bits).
 $6842 RLCA          ;
 $6843 RLCA          ; }
 $6844 OR %00000111  ; Set bits 0-2.
 $6846 LD C,A        ; Set the cycle counter; the more actors in play, the
                     ; longer the tone.
@label=PlayRisingTone_Loop
*$6847 LD A,C        ; Fetch the cycle counter.
 $6848 XOR %01000000 ; Flip bit 6.
 $684A LD D,A        ; Use the result as the period.
 $684B CALL $68B1    ; Play a cycle using #R$68B1.
 $684E DEC C         ; Decrease the cycle counter by one.
 $684F RET Z         ; Return if all of the cycles have been played.
 $6850 DEC C         ; Decrease the cycle counter by one.
 $6851 RET Z         ; Return if all of the cycles have been played.
 $6852 JR $6847      ; Jump back to #R$6847 to play the next cycle.

; Play Level Tone
;
; Used by the routine at #R$6D89.
; .
; Plays eight cycles of a square wave. The period of the wave is taken
; from the table at #R$686A, using byte #N$06 of the actor as the index, which
; is then increased by one ready for the next call. This is used by the actor
; for the level introduction parade (see #R$6D87). The audio is three calls,
; which are eight frames apart.
; #HTML(#AUDIO0(level-tone.wav)(#INCLUDE(LevelTone)))
;
; IX Actor
@label=LevelStartJingle
c$6854 LD C,(IX+$06) ; Fetch the index (byte #N$06 of the actor).
 $6857 INC (IX+$06)  ; Increase the index by one, ready for the next call.
 $685A LD B,$00      ; {Find the period in the table at #R$686A using the
 $685C LD HL,$686A   ; index.
 $685F ADD HL,BC     ; }
 $6860 LD D,(HL)     ; Fetch the period of the wave.
 $6861 LD C,$08      ; Set the cycle counter to #N$08.
; This entry point is used by the routine at #R$6882.
@label=LevelStartJingle_Loop
*$6863 CALL $68B1    ; Play a cycle using #R$68B1.
 $6866 DEC C         ; Decrease the cycle counter by one.
 $6867 JR NZ,$6863   ; Loop back to #R$6863 until the cycle counter is zero.
 $6869 RET           ; Return.

; Level Tone Periods
;
; The period of the wave for each call of #R$6854. Every entry is #N$80,
; so the tone does not change in pitch.
@label=LevelTonePeriods
b$686A DEFB $80
 $686B DEFB $80
 $686C DEFB $80
 $686D DEFB $80
 $686E DEFB $80
 $686F DEFB $80
 $6870 DEFB $80
 $6871 DEFB $80
 $6872 DEFB $80
 $6873 DEFB $80
 $6874 DEFB $80
 $6875 DEFB $80
 $6876 DEFB $80
 $6877 DEFB $80
 $6878 DEFB $80
 $6879 DEFB $80
 $687A DEFB $80
 $687B DEFB $80
 $687C DEFB $80
 $687D DEFB $80
 $687E DEFB $80
 $687F DEFB $80
 $6880 DEFB $80
 $6881 DEFB $80

; Play Game Start Tone
;
; Used by the routine at #R$7048.
; .
; Plays a beep of #N$40 cycles.
; #HTML(#AUDIO0(game-start-beep.wav)(#INCLUDE(GameStartBeep)))
@label=GameStartJingle
c$6882 LD D,$30      ; Set the period to #N$30.
 $6884 LD C,$40      ; Set the cycle counter to #N$40.
 $6886 JR $6863      ; Jump to #R$6863.

; Handle Rising Sweep
;
; The handler for sound effect actors with the ID #N$19. Each time it is
; called it plays a number of cycles (#REGix+#N$02), and then makes the period
; (#REGix+#N$03) shorter, which raises the pitch. The actor is removed when the
; period reaches zero.
;
; IX Sound actor
@label=Handler_RisingSweep
c$6888 DEC (IX+$03)  ; Decrease the period by one, which raises the pitch.
 $688B JR Z,$68BF    ; Jump to #R$68BF if the period is zero.
 $688D LD D,(IX+$03) ; Fetch the period.
 $6890 LD C,(IX+$02) ; Fetch the number of cycles.
; This entry point is used by the routine at #R$689A.
@label=Handler_PlayCycles
*$6893 CALL $68B1    ; Play a cycle using #R$68B1.
 $6896 DEC C         ; Decrease the cycle counter by one.
 $6897 JR NZ,$6893   ; Loop back to #R$6893 until all of the cycles have been
                     ; played.
 $6899 RET           ; Return.

; Handle Notes
;
; The handler for sound effect actors with the ID #N$16. Each time it is
; called it plays the next note from a table of periods. The table address is
; held in the actor (#REGix+#N$02 and #REGix+#N$03), and the notes are played
; from the end of the table towards the start. The number of cycles in each
; note is held in #REGix+#N$04. The actor is removed after the first entry of
; the table.
;
; IX Sound actor
@label=Handler_Notes
c$689A DEC (IX+$01)  ; Decrease the note counter by one.
 $689D JR Z,$68BF    ; Jump to #R$68BF if there are no more notes to play.
 $689F LD C,(IX+$01) ; Fetch the note counter.
 $68A2 LD B,$00      ; Set the high byte of the offset to #N$00.
 $68A4 LD L,(IX+$02) ; Fetch the low byte of the address of the table of
                     ; periods.
 $68A7 LD H,(IX+$03) ; Fetch the high byte of the address of the table of
                     ; periods.
 $68AA ADD HL,BC     ; Find the note in the table using the note counter.
 $68AB LD D,(HL)     ; Fetch the period of the note.
 $68AC LD C,(IX+$04) ; Fetch the number of cycles in each note.
 $68AF JR $6893      ; Jump to #R$6893.

; Play Square Wave
;
; Used by the routines at #R$6825, #R$683E, #R$6854 and #R$6888.
; .
; Plays one cycle of a square wave; the speaker is switched on for a
; period of time and then switched off for the same amount of time.
;
; D Duration of wave
@label=PlaySquareWave
c$68B1 LD A,$10      ; {Play square wave sound.
 $68B3 OUT ($FE),A   ;
 $68B5 LD B,D        ;
@label=PlaySquareWave_Loop
*$68B6 DJNZ $68B6    ; }
 $68B8 XOR A         ; {Play "silence".
 $68B9 OUT ($FE),A   ;
 $68BB LD B,D        ;
@label=Silence_Loop
*$68BC DJNZ $68BC    ; }
 $68BE RET           ; Return.
; View the equivalent code in;
; #LIST
; { #JETPAC$680D }
; { #LUNARJETMAN$B8DA }
; { #PSSST$64AA }
; LIST#

; Remove Actor
;
; Used by the routines at #R$6888 and #R$689A.
; .
; Removes an actor by setting its ID to zero, which frees the slot.
;
; IX Actor
@label=RemoveActor
c$68BF LD (IX+$00),$00 ; Write #N$00 to the actor ID.
 $68C3 RET             ; Return.

; Start Rising Sweep
;
; Used by the routine at #R$6A46.
; .
; The sound effects are played by an actor which lives in the slot at
; #R$5F4D. This copies the template for the effect into the slot, and the
; handler then plays it a bit at a time. Eight bytes are always copied, so the
; bytes of a template which are beyond the ones used are really the code which
; follows it.
; #HTML(#AUDIO0(rising-sweep.wav)(#INCLUDE(RisingSweep)))
@label=StartRisingSweep
c$68C4 LD HL,$68D0   ; Point #REGhl at the template for the rising sweep.
; This entry point is used by the routines at #R$68D4, #R$68E7, #R$68FA and
; #R$6915.
@label=StartSoundEffect
*$68C7 LD DE,$5F4D   ; Point #REGde at the sound effect actor (#R$5F4D).
 $68CA LD BC,$0008   ; Set the number of bytes to copy to #N$0008.
 $68CD LDIR          ; Copy the template to the sound effect actor.
 $68CF RET           ; Return.

; Template: Rising Sweep
;
; Handled by #R$6888.
@label=Template_RisingSweep
b$68D0 DEFB $19      ; Actor ID.
 $68D1 DEFB $20      ; Not used.
 $68D2 DEFB $20      ; Number of cycles.
 $68D3 DEFB $20      ; Period of the first cycle.

; Start Falling Notes
;
; Used by the routines at #R$6CA7 and #R$6F16.
; .
; #HTML(#AUDIO0(falling-notes.wav)(#INCLUDE(FallingNotes)))
@label=StartFallingNotes
c$68D4 LD HL,$68D9   ; Point #REGhl at the template for the falling notes.
 $68D7 JR $68C7      ; Jump to #R$68C7.

; Template: Falling Notes
;
; Handled by #R$689A.
@label=Template_FallingNotes
b$68D9 DEFB $16                             ; Actor ID.
 $68DA DEFB $08                             ; Note counter.
 $68DB DEFB $DE,$68                         ; Address of the table of periods.
 $68DD DEFB $10                             ; Number of cycles in each note.
@label=Notes_FallingNotes
 $68DE DEFB $00,$78,$70,$68,$60,$58,$50,$48
 $68E6 DEFB $40

; Start Rising Notes
;
; Used by the routines at #R$6C7A and #R$6F16.
; .
; #HTML(#AUDIO0(rising-notes.wav)(#INCLUDE(RisingNotes)))
@label=StartRisingNotes
c$68E7 LD HL,$68EC   ; Point #REGhl at the template for the rising notes.
 $68EA JR $68C7      ; Jump to #R$68C7.

; Template: Rising Notes
;
; Handled by #R$689A.
@label=Template_RisingNotes
b$68EC DEFB $16                             ; Actor ID.
 $68ED DEFB $08                             ; Note counter.
 $68EE DEFB $F1,$68                         ; Address of the table of periods.
 $68F0 DEFB $10                             ; Number of cycles in each note.
@label=Notes_RisingNotes
 $68F1 DEFB $00,$40,$48,$50,$58,$60,$68,$70
 $68F9 DEFB $78

; Start Warble
;
; Used by the routine at #R$67E2.
; .
; #HTML(#AUDIO0(warble.wav)(#INCLUDE(Warble)))
@label=StartWarble
c$68FA LD HL,$68FF   ; Point #REGhl at the template for the warble.
 $68FD JR $68C7      ; Jump to #R$68C7.

; Template: Warble
;
; Handled by #R$689A.
@label=Template_Warble
b$68FF DEFB $16                             ; Actor ID.
 $6900 DEFB $10                             ; Note counter.
 $6901 DEFB $04,$69                         ; Address of the table of periods.
 $6903 DEFB $06                             ; Number of cycles in each note.
@label=Notes_Warble
 $6904 DEFB $00,$40,$40,$40,$40,$50,$50,$50
 $690C DEFB $50,$40,$40,$40,$40,$50,$50,$50
 $6914 DEFB $50

; Start Falling Slide
;
; Used by the routine at #R$6681.
; .
; #HTML(#AUDIO0(falling-slide.wav)(#INCLUDE(FallingSlide)))
@label=StartFallingSlide
c$6915 LD HL,$691A   ; Point #REGhl at the template for the falling slide.
 $6918 JR $68C7      ; Jump to #R$68C7.

; Template: Falling Slide
;
; Handled by #R$689A.
@label=Template_FallingSlide
b$691A DEFB $16                             ; Actor ID.
 $691B DEFB $10                             ; Note counter.
 $691C DEFB $1F,$69                         ; Address of the table of periods.
 $691E DEFB $06                             ; Number of cycles in each note.
@label=Notes_FallingSlide
 $691F DEFB $00,$50,$4E,$4C,$4A,$48,$46,$44
 $6927 DEFB $42,$40,$3E,$3C,$3A,$38,$36,$34
 $692F DEFB $32

; Handle Cheese
;
; The handler for the cheese (IDs #N$12 and #N$13), which bounces up and
; down the screen like a ball. Byte #N$05 of the actor is the vertical speed;
; it is increased by one every eight frames (up to a maximum of #N$08), and half
; of it is added to the vertical co-ordinate. When the cheese reaches the top
; of the play area its vertical speed is reversed, and when it reaches the
; bottom it is thrown back up with a random speed, and a random horizontal
; speed. The horizontal movement is done by #R$72B4.
; .
; While the cheese is still entering from the right of the screen (a horizontal
; co-ordinate of #N$C4 or more) it only moves horizontally.
;
; IX Actor
@label=HandleCheese
c$6930 CALL $76D0      ; Record the position of the sprite using #R$76D0.
 $6933 LD HL,$5F1B     ; Point #REGhl at #R$5F1B.
 $6936 INC (HL)        ; Increase the number of actors in play by one.
 $6937 LD A,(IX+$01)   ; Fetch the horizontal co-ordinate.
 $693A CP $C4          ; {Jump to #R$6977 if the cheese is still entering from
 $693C JR NC,$6977     ; the right.}
 $693E CALL $6A46      ; Test whether the cheese has hit Charlie using #R$6A46.
 $6941 DEC E           ; Has Charlie been hit (is #REGe now zero)?
 $6942 JP Z,$6A73      ; Jump to #R$6A73 if Charlie has been hit.
 $6945 CALL $7317      ; Test whether a flour shot has hit the cheese using
                       ; #R$7317.
 $6948 BIT 7,(IX+$00)  ; {Jump to #R$730D if the cheese has been hit.
 $694C JP NZ,$730D     ; }
; Every eight frames, increase the vertical speed (up to a maximum of
; #N$08).
 $694F LD A,(IX+$07)   ; Fetch the frame counter (byte #N$07 of the actor).
 $6952 AND %00000111   ; Keep only bits 0-2.
 $6954 JR NZ,$6960     ; Jump to #R$6960 if the counter is not a multiple of
                       ; #N$08.
 $6956 LD A,(IX+$05)   ; Fetch the vertical speed.
 $6959 CP $08          ; {Jump to #R$6960 if the vertical speed is already at
 $695B JR Z,$6960      ; the maximum.}
 $695D INC (IX+$05)    ; Increase the vertical speed by one.
@label=HandleCheese_Vertical
*$6960 LD A,(IX+$05)   ; Fetch the vertical speed.
 $6963 LD (IX+$03),$46 ; Set the actor colour to #N$46 (yellow).
 $6967 SRA A           ; Halve the vertical speed.
 $6969 ADD A,(IX+$02)  ; Add the vertical co-ordinate.
 $696C CP $20          ; {Jump to #R$697A if the cheese has reached the top.
 $696E JR C,$697A      ; }
 $6970 CP $A0          ; {Jump to #R$6988 if the cheese has reached the bottom.
 $6972 JR NC,$6988     ; }
 $6974 LD (IX+$02),A   ; Update the vertical co-ordinate.
@label=HandleCheese_Horizontal
*$6977 JP $72B4        ; Move the actor horizontally using #R$72B4.
; The cheese has reached the top, so reverse the vertical speed.
@label=HandleCheese_Top
*$697A LD (IX+$02),$20 ; Put the cheese at the top of the play area (#N$20).
 $697E LD A,(IX+$05)   ; Fetch the vertical speed.
 $6981 NEG             ; Reverse the direction by negating the vertical speed.
@label=HandleCheese_SetSpeed
*$6983 LD (IX+$05),A   ; Update the vertical speed.
 $6986 JR $6977        ; Jump to #R$6977.
; The cheese has reached the bottom, so throw it back up.
@label=HandleCheese_Bottom
*$6988 LD (IX+$02),$A0 ; Put the cheese on the floor (#N$A0).
 $698C CALL $6EAC      ; Set random horizontal and vertical speeds using
                       ; #R$6EAC.
 $698F LD A,R          ; Fetch a random number.
 $6991 AND %00000111   ; Keep only bits 0-2.
 $6993 CPL             ; Invert #REGa, so it is in the range #N$F8 to #N$FF (-8
                       ; to -1).
 $6994 JR $6983        ; Jump to #R$6983.

; Handle Tack, Washer And Bolt
;
; The handler for the tack, the washer and the bolt (IDs #N$1E to #N$23),
; which chase Charlie. Every #N$10 frames the actor works out which way Charlie
; is from it, and stores this in byte #N$06 of the actor (bit 0 is set when
; Charlie is below the actor, bit 1 is set when Charlie is to the right). The
; horizontal and vertical speeds are then changed by one every other frame
; towards that direction, up to a maximum speed of #N$02 in either direction.
;
; IX Actor
@label=HandleTackWasherBolt
c$6996 CALL $76D0      ; Record the position of the sprite using #R$76D0.
 $6999 LD HL,$5F1B     ; Point #REGhl at #R$5F1B.
 $699C INC (HL)        ; Increase the number of actors in play by one.
 $699D CALL $6A46      ; Test whether the actor has hit Charlie using #R$6A46.
 $69A0 DEC E           ; Has Charlie been hit (is #REGe now zero)?
 $69A1 JP Z,$6A73      ; Jump to #R$6A73 if Charlie has been hit.
 $69A4 CALL $7317      ; Test whether a flour shot has hit the actor using
                       ; #R$7317.
 $69A7 BIT 7,(IX+$00)  ; {Jump to #R$730D if the actor has been hit.
 $69AB JP NZ,$730D     ; }
 $69AE LD (IX+$03),$45 ; Set the actor colour to #N$45 (cyan).
 $69B2 LD A,(IX+$07)   ; Fetch the frame counter (byte #N$07 of the actor).
 $69B5 AND %00001111   ; Keep only bits 0-3.
 $69B7 JR NZ,$6A05     ; Jump to #R$6A05 if the counter is not a multiple of
                       ; #N$10.
; Work out which direction Charlie is in.
 $69B9 LD C,$00        ; Set the direction to #N$00 (left and up).
 $69BB LD HL,$5F36     ; Point #REGhl at #R$5F36.
 $69BE LD A,(IX+$01)   ; Fetch the horizontal co-ordinate.
 $69C1 SUB (HL)        ; Subtract Charlie's horizontal co-ordinate.
 $69C2 JR NC,$69C6     ; Jump to #R$69C6 if the actor is to the right of
                       ; Charlie.
 $69C4 LD C,$02        ; The actor is left of Charlie, so set the direction to
                       ; #N$02 (right).
@label=HandleTackWasherBolt_Vertical
*$69C6 INC HL          ; Move on to Charlie's vertical co-ordinate.
 $69C7 LD A,(IX+$02)   ; Fetch the vertical co-ordinate.
 $69CA SUB (HL)        ; Subtract Charlie's vertical co-ordinate.
 $69CB JR NC,$69CF     ; Jump to #R$69CF if the actor is below Charlie.
 $69CD SET 0,C         ; The actor is above Charlie, so set bit 0 of the direction
                       ; (down).
@label=HandleTackWasherBolt_SetDirection
*$69CF LD (IX+$06),C   ; Set the direction of the actor (byte #N$06 of the
                       ; actor).
 $69D2 JR $6A05        ; Jump to #R$6A05.

; Handle Chocolate
;
; The handler for the chocolate (IDs #N$10 and #N$11), which drifts about
; in random directions. Every #N$10 frames a new random direction is picked
; and stored in byte #N$06 of the actor (bit 0 is set for down, and bit 1 is
; set for right). The speeds are changed by one every other frame towards that
; direction, up to a maximum speed of #N$02 in either direction.
; .
; While the chocolate is still entering from the right of the screen (a
; horizontal co-ordinate of #N$C4 or more) it is only moved.
;
; IX Actor
@label=HandleChocolate
c$69D4 CALL $76D0      ; Record the position of the sprite using #R$76D0.
 $69D7 LD HL,$5F1B     ; Point #REGhl at #R$5F1B.
 $69DA INC (HL)        ; Increase the number of actors in play by one.
 $69DB LD A,(IX+$01)   ; Fetch the horizontal co-ordinate.
 $69DE CP $C4          ; {Jump to #R$6A2B if the chocolate is still entering
 $69E0 JR NC,$6A2B     ; from the right.}
 $69E2 CALL $6A46      ; Test whether the actor has hit Charlie using #R$6A46.
 $69E5 DEC E           ; Has Charlie been hit (is #REGe now zero)?
 $69E6 JP Z,$6A73      ; Jump to #R$6A73 if Charlie has been hit.
 $69E9 CALL $7317      ; Test whether a flour shot has hit the actor using
                       ; #R$7317.
 $69EC BIT 7,(IX+$00)  ; {Jump to #R$730D if the actor has been hit.
 $69F0 JP NZ,$730D     ; }
 $69F3 LD (IX+$03),$42 ; Set the actor colour to #N$42 (red).
 $69F7 LD A,(IX+$07)   ; Fetch the frame counter (byte #N$07 of the actor).
 $69FA AND %00001111   ; Keep only bits 0-3.
 $69FC JR NZ,$6A05     ; Jump to #R$6A05 if the counter is not a multiple of
                       ; #N$10.
 $69FE LD A,R          ; Fetch a random number.
 $6A00 AND %00000011   ; Keep only bits 0-1.
 $6A02 LD (IX+$06),A   ; Set a random direction (byte #N$06 of the actor).

; Change Actor Speeds
;
; Used by the routines at #R$6996 and #R$69D4.
; .
; Changes the speeds of the actor by one towards the direction in byte
; #N$06 of the actor (bit 0 is set for down, and bit 1 is set for right), but
; only every other frame. The speeds are limited to #N$02 in either direction.
; The actor is then moved by #R$72A3.
;
; IX Actor
@label=ChangeActorSpeeds
c$6A05 BIT 0,(IX+$07) ; {Jump to #R$6A2B if bit 0 of the frame counter is set.
 $6A09 JR NZ,$6A2B    ; }
 $6A0B BIT 0,(IX+$06) ; {Jump to #R$6A2E if the actor is not moving down.
 $6A0F JR Z,$6A2E     ; }
 $6A11 LD A,(IX+$05)  ; Fetch the vertical speed.
 $6A14 CP $02         ; {Jump to #R$6A1B if it is already at the limit.
 $6A16 JR Z,$6A1B     ; }
 $6A18 INC (IX+$05)   ; Increase the vertical speed by one.
@label=ChangeActorSpeeds_Horizontal
*$6A1B BIT 1,(IX+$06) ; {Jump to #R$6A3A if the actor is not moving right.
 $6A1F JR Z,$6A3A     ; }
 $6A21 LD A,(IX+$04)  ; Fetch the horizontal speed.
 $6A24 CP $02         ; {Jump to #R$6A2B if it is already at the limit.
 $6A26 JR Z,$6A2B     ; }
 $6A28 INC (IX+$04)   ; Increase the horizontal speed by one.
; This entry point is used by the routine at #R$69D4.
@label=ChangeActorSpeeds_Move
*$6A2B JP $72A3       ; Move the actor using #R$72A3.
@label=ChangeActorSpeeds_Up
*$6A2E LD A,(IX+$05)  ; Fetch the vertical speed.
 $6A31 CP $FE         ; {Jump to #R$6A1B if it is already at the limit.
 $6A33 JR Z,$6A1B     ; }
 $6A35 DEC (IX+$05)   ; Decrease the vertical speed by one.
 $6A38 JR $6A1B       ; Jump to #R$6A1B.
@label=ChangeActorSpeeds_Left
*$6A3A LD A,(IX+$04)  ; Fetch the horizontal speed.
 $6A3D CP $FE         ; {Jump to #R$6A2B if it is already at the limit.
 $6A3F JR Z,$6A2B     ; }
 $6A41 DEC (IX+$04)   ; Decrease the horizontal speed by one.
 $6A44 JR $6A2B       ; Jump to #R$6A2B.

; Test Charlie Collision
;
; Used by the routines at #R$669B, #R$6765, #R$6930, #R$6996, #R$69D4, #R$6CB7
; and #R$7281.
; .
; Tests whether the actor is within #N$0C pixels of Charlie, both
; horizontally and vertically. Charlie can only be hit while he has his hat on
; (his ID is #N$01 or #N$02). If he has been hit then the rising sweep sound is
; started.
;
;   IX Actor
; O:E #N$01 if the actor has collided with Charlie, otherwise #N$00
;
; See #POKE(immunity,Immunity).
@label=TestCharlieCollision
c$6A46 LD HL,$5F35   ; Point #REGhl at Charlie's actor ID.
 $6A49 LD E,$00      ; Assume that there is no collision (#REGe=#N$00).
 $6A4B LD A,(HL)     ; Fetch Charlie's ID.
 $6A4C AND %00111111 ; Keep only bits 0-5.
 $6A4E DEC A         ; Is Charlie's ID #N$01?
 $6A4F JR Z,$6A53    ; Jump to #R$6A53 if Charlie's ID is #N$01.
 $6A51 DEC A         ; Is Charlie's ID #N$02?
 $6A52 RET NZ        ; Return if Charlie's ID is not #N$02.
@label=TestCharlieCollision_Horizontal
*$6A53 INC HL        ; Move on to Charlie's horizontal co-ordinate.
 $6A54 LD A,(HL)     ; Fetch Charlie's horizontal co-ordinate.
 $6A55 SUB (IX+$01)  ; Subtract the horizontal co-ordinate of the actor.
 $6A58 JP P,$6A5D    ; Jump to #R$6A5D if the result is positive.
 $6A5B NEG           ; Make the result positive.
@label=TestCharlieCollision_HorizontalDistance
*$6A5D CP $0C        ; Compare with #N$0C (the width of the collision area).
 $6A5F RET NC        ; Return if the actor is too far away.
 $6A60 INC HL        ; Move on to Charlie's vertical co-ordinate.
 $6A61 LD A,(HL)     ; Fetch Charlie's vertical co-ordinate.
 $6A62 SUB (IX+$02)  ; Subtract the vertical co-ordinate of the actor.
 $6A65 JP P,$6A6A    ; Jump to #R$6A6A if the result is positive.
 $6A68 NEG           ; Make the result positive.
@label=TestCharlieCollision_VerticalDistance
*$6A6A CP $0C        ; Compare with #N$0C (the height of the collision area).
 $6A6C RET NC        ; Return if the actor is too far away.
 $6A6D CALL $68C4    ; Start the rising sweep sound using #R$68C4.
 $6A70 LD E,$01      ; Flag that Charlie has been hit (#REGe=#N$01).
 $6A72 RET           ; Return.

; Lose Hat
;
; Used by the routines at #R$669B, #R$6765, #R$6930, #R$6996, #R$69D4, #R$6CB7
; and #R$7281.
; .
; Called when an actor has hit Charlie. Charlie is replaced with Charlie
; without his hat (ID #N$0C), and the hat (ID #N$0D) is put #N$10 pixels above
; him. Charlie's co-ordinates are saved in bytes #N$04 and #N$05 of the actor.
; The hat is then handled by #R$6AA0, and all of the other actors are cleared
; away by #R$6AFC.
@label=LoseHat
c$6A73 PUSH IX         ; Save the pointer to the current actor on the stack.
 $6A75 LD IX,$5F35     ; Point #REGix at #R$5F35.
 $6A79 CALL $7617      ; Erase Charlie using #R$7617.
 $6A7C LD (IX+$00),$0C ; Change Charlie's ID to #N$0C (Charlie without his
                       ; hat).
 $6A80 CALL $7617      ; Draw Charlie without his hat using #R$7617.
 $6A83 LD (IX+$00),$0D ; Change the ID to #N$0D (the hat).
 $6A87 LD A,(IX+$01)   ; Fetch the horizontal co-ordinate.
 $6A8A LD (IX+$04),A   ; Save Charlie's horizontal co-ordinate in byte #N$04 of
                       ; the actor.
 $6A8D LD A,(IX+$02)   ; Fetch the vertical co-ordinate.
 $6A90 LD (IX+$05),A   ; Save Charlie's vertical co-ordinate in byte #N$05 of
                       ; the actor.
 $6A93 SUB $10         ; Subtract #N$10, to put the hat above Charlie's head.
 $6A95 LD (IX+$02),A   ; Update the vertical co-ordinate.
 $6A98 CALL $7617      ; Draw the hat using #R$7617.
 $6A9B POP IX          ; Restore the pointer to the current actor from the
                       ; stack.
 $6A9D JP $6AFC        ; Jump to #R$6AFC.

; Handle Hat
;
; The handler for Charlie's hat (ID #N$0D), which is in Charlie's actor
; slot. Charlie's co-ordinates were saved in bytes #N$04 and #N$05 of the
; actor by #R$6A73. Each pass the hat moves up two pixels, and Charlie is
; redrawn without his hat. When the hat reaches the top of the screen it is
; erased, and Charlie is replaced with falling Charlie (ID #N$0E), who is
; handled by #R$6B8B.
;
; IX Actor
@label=HandleHat
c$6AA0 CALL $76D0      ; Record the position of the sprite using #R$76D0.
 $6AA3 LD A,(IX+$02)   ; Fetch the vertical co-ordinate.
 $6AA6 SUB $02         ; Subtract #N$02 to move the hat up the screen.
 $6AA8 JR C,$6ADF      ; Jump to #R$6ADF if the hat has reached the top of the
                       ; screen.
 $6AAA LD (IX+$02),A   ; Update the vertical co-ordinate.
 $6AAD CALL $75CC      ; Erase the sprite and draw it in its new position using
                       ; #R$75CC.
 $6AB0 CALL $74EE      ; Colour the sprite using #R$74EE.
; Redraw Charlie without his hat, and then put the position of the hat
; back.
 $6AB3 LD L,(IX+$01)   ; Fetch the horizontal co-ordinate of the hat.
 $6AB6 LD H,(IX+$02)   ; Fetch the vertical co-ordinate of the hat.
 $6AB9 PUSH HL         ; Stash the position of the hat on the stack.
 $6ABA LD A,(IX+$04)   ; Fetch Charlie's horizontal co-ordinate (byte #N$04 of
                       ; the actor).
 $6ABD LD (IX+$01),A   ; Update the horizontal co-ordinate.
 $6AC0 LD A,(IX+$05)   ; Fetch Charlie's vertical co-ordinate (byte #N$05 of
                       ; the actor).
 $6AC3 LD (IX+$02),A   ; Update the vertical co-ordinate.
 $6AC6 LD (IX+$00),$0C ; Change the ID to #N$0C (Charlie without his hat).
 $6ACA CALL $76D0      ; Record the position of the sprite using #R$76D0.
 $6ACD CALL $75CC      ; Erase the sprite and draw it in its new position using
                       ; #R$75CC.
 $6AD0 CALL $74EE      ; Colour the sprite using #R$74EE.
 $6AD3 POP HL          ; Restore the position of the hat from the stack.
 $6AD4 LD (IX+$01),L   ; Put the hat back at its horizontal co-ordinate.
 $6AD7 LD (IX+$02),H   ; Put the hat back at its vertical co-ordinate.
 $6ADA LD (IX+$00),$0D ; Change the ID back to #N$0D (the hat).
 $6ADE RET             ; Return.
; The hat has reached the top of the screen, so erase it and replace
; Charlie with falling Charlie.
@label=HandleHat_Finished
*$6ADF CALL $7617      ; Erase the hat using #R$7617.
 $6AE2 LD A,(IX+$04)   ; Fetch Charlie's horizontal co-ordinate (byte #N$04 of
                       ; the actor).
 $6AE5 LD (IX+$01),A   ; Update the horizontal co-ordinate.
 $6AE8 LD A,(IX+$05)   ; Fetch Charlie's vertical co-ordinate (byte #N$05 of
                       ; the actor).
 $6AEB LD (IX+$02),A   ; Update the vertical co-ordinate.
 $6AEE LD (IX+$00),$0C ; Change the ID to #N$0C (Charlie without his hat).
 $6AF2 CALL $7617      ; Erase Charlie without his hat using #R$7617.
 $6AF5 LD (IX+$00),$0E ; Change the ID to #N$0E (falling Charlie).
 $6AF9 JP $7617        ; Draw falling Charlie using #R$7617.

; Convert Actors
;
; Used by the routines at #R$6A73 and #R$6C88.
; .
; Changes every actor in the six slots from #R$5F55 into ID #N$0F, so
; they can be cleared away by #R$6B18. The original ID is kept in byte #N$04
; of the actor, and byte #N$05 is set to #N$01.
@label=ConvertActors
c$6AFC LD HL,$5F55   ; Point #REGhl at the first spawned actor.
 $6AFF LD DE,$0004   ; Set the offset to byte #N$04 of an actor.
 $6B02 LD B,$06      ; Set the actor counter to #N$06.
@label=ConvertActors_Loop
*$6B04 LD A,(HL)     ; Fetch the actor ID.
 $6B05 AND A         ; Is the slot empty?
 $6B06 JR Z,$6B13    ; Jump to #R$6B13 if it is.
 $6B08 LD C,A        ; Keep the actor ID in #REGc.
 $6B09 LD (HL),$0F   ; Change the ID to #N$0F (the cleared actor).
 $6B0B ADD HL,DE     ; Move on to byte #N$04 of the actor.
 $6B0C LD (HL),C     ; Write the original ID to byte #N$04 of the actor.
 $6B0D INC HL        ; Move on to byte #N$05 of the actor.
 $6B0E LD (HL),$01   ; Write #N$01 to byte #N$05 of the actor.
 $6B10 DEC HL        ; Move back to byte #N$04 of the actor.
 $6B11 JR $6B14      ; Jump to #R$6B14.
@label=ConvertActors_Empty
*$6B13 ADD HL,DE     ; Move on to byte #N$04 of the actor.
@label=ConvertActors_Next
*$6B14 ADD HL,DE     ; Move on to the next actor.
 $6B15 DJNZ $6B04    ; Decrease the actor counter by one and loop back to #R$6B04 until
                     ; all six actors have been done.
 $6B17 RET           ; Return.

; Handle Cleared Actor
;
; The handler for an actor which has been cleared away (ID #N$0F) after
; Charlie has lost his hat (see #R$6AFC). The original ID of the actor is in
; byte #N$04, and is used to draw the actor; bit 0 of it is flipped every
; four frames. While byte #N$05 is not zero the actor moves sideways away from
; the middle of the screen four pixels at a time, until it reaches a side (and,
; if it is on the floor, it stops moving sideways at once). Then it drops four
; pixels at a time, and is removed when it reaches the bottom of the screen.
;
; IX Actor
@label=HandleClearedActor
c$6B18 LD HL,$5F1B     ; Point #REGhl at the number of actors in play.
 $6B1B INC (HL)        ; Increase the number of actors in play by one.
 $6B1C LD A,(IX+$00)   ; Fetch the actor ID.
 $6B1F PUSH AF         ; Stash the actor ID on the stack.
 $6B20 LD A,(IX+$04)   ; Fetch the original ID (byte #N$04 of the actor).
 $6B23 LD (IX+$00),A   ; Update the actor ID.
 $6B26 CALL $76D0      ; Record the position of the sprite using #R$76D0.
 $6B29 LD A,(IX+$05)   ; Fetch the movement of the actor (byte #N$05 of the
                       ; actor).
 $6B2C AND A           ; Is the actor moving sideways?
 $6B2D JR Z,$6B4E      ; Jump to #R$6B4E if it is not.
 $6B2F LD A,(IX+$02)   ; Fetch the vertical co-ordinate.
 $6B32 CP $A0          ; {Jump to #R$6B3A if the actor is above the floor.
 $6B34 JR C,$6B3A      ; }
 $6B36 LD (IX+$05),$00 ; Write #N$00 to byte #N$05 of the actor.
@label=HandleClearedActor_Sideways
*$6B3A LD A,(IX+$01)   ; Fetch the horizontal co-ordinate.
 $6B3D CP $68          ; {Jump to #R$6B7D if the actor is in the right half of
 $6B3F JR NC,$6B7D     ; the screen.}
 $6B41 SUB $04         ; Subtract #N$04, to move the actor to the left.
 $6B43 JR NC,$6B49     ; Jump to #R$6B49 if the actor has not reached the left
                       ; side.
 $6B45 XOR A           ; Set #REGa to #N$00 (the left edge).
 $6B46 LD (IX+$05),A   ; Stop the actor moving sideways (byte #N$05 of the
                       ; actor).
@label=HandleClearedActor_SetPosition
*$6B49 LD (IX+$01),A   ; Update the horizontal co-ordinate.
 $6B4C JR $6B5A        ; Jump to #R$6B5A.
; The actor is dropping.
@label=HandleClearedActor_Drop
*$6B4E LD A,(IX+$02)   ; Fetch the vertical co-ordinate.
 $6B51 ADD A,$04       ; Add #N$04, to drop the actor.
 $6B53 CP $B8          ; {Jump to #R$6B77 if the actor has reached the bottom
 $6B55 JR NC,$6B77     ; of the screen.}
 $6B57 LD (IX+$02),A   ; Update the vertical co-ordinate.
@label=HandleClearedActor_Flip
*$6B5A LD A,($5F1D)    ; Fetch the frame counter.
 $6B5D AND %00000011   ; Keep only bits 0-1.
 $6B5F LD A,(IX+$04)   ; Fetch the sprite ID (byte #N$04 of the actor).
 $6B62 JR NZ,$6B69     ; Jump to #R$6B69 if the frame counter is not a multiple
                       ; of #N$04.
 $6B64 XOR %00000001   ; Flip bit 0.
 $6B66 LD (IX+$04),A   ; Update the sprite ID (byte #N$04 of the actor).
@label=HandleClearedActor_Draw
*$6B69 LD (IX+$00),A   ; Update the actor ID.
 $6B6C CALL $75CC      ; Erase the sprite and draw it in its new position using
                       ; #R$75CC.
 $6B6F CALL $74EE      ; Colour the sprite using #R$74EE.
 $6B72 POP AF          ; Restore the actor ID from the stack.
 $6B73 LD (IX+$00),A   ; Update the actor ID.
 $6B76 RET             ; Return.
; The actor has dropped off the bottom of the screen.
@label=HandleClearedActor_Remove
*$6B77 LD (IX+$00),$00 ; Write #N$00 to the actor ID.
 $6B7B POP AF          ; Discard the saved actor ID from the stack.
 $6B7C RET             ; Return.
; The actor is in the right half of the screen.
@label=HandleClearedActor_Right
*$6B7D ADD A,$04       ; Add #N$04, to move the actor to the right.
 $6B7F CP $C0          ; {Jump to #R$6B49 if the actor has not reached the
 $6B81 JR C,$6B49      ; right side.}
 $6B83 XOR A           ; Set #REGa to #N$00.
 $6B84 LD (IX+$05),A   ; Stop the actor moving sideways (byte #N$05 of the
                       ; actor).
 $6B87 LD A,$C0        ; Set #REGa to #N$C0 (the right edge).
 $6B89 JR $6B49        ; Jump to #R$6B49.

; Handle Falling Charlie
;
; The handler for Charlie as he falls (ID #N$0E), after his hat has gone
; (see #R$6AA0). Charlie falls one pixel at a time until his vertical
; co-ordinate reaches #N$B4. Then the actor ID is changed to #N$18, which is
; handled by #R$6BAF, and the tune for losing a life is played (unless the tunes
; are muted).
;
; IX Actor
@label=HandleFallingCharlie
c$6B8B CALL $76D0      ; Record the position of the sprite using #R$76D0.
 $6B8E LD A,(IX+$02)   ; Fetch the vertical co-ordinate.
 $6B91 ADD A,$01       ; Add #N$01, to make Charlie fall by one pixel.
 $6B93 CP $B4          ; {Jump to #R$6BA0 if Charlie has fallen far enough.
 $6B95 JR NC,$6BA0     ; }
 $6B97 LD (IX+$02),A   ; Update the vertical co-ordinate.
 $6B9A CALL $75CC      ; Erase the sprite and draw it in its new position using
                       ; #R$75CC.
 $6B9D JP $74EE        ; Jump to #R$74EE to colour the sprite.
@label=HandleFallingCharlie_Finished
*$6BA0 LD (IX+$00),$18 ; Write #N$18 to the actor ID.
 $6BA4 LD A,($5F0D)    ; Fetch the sound mute flag.
 $6BA7 AND A           ; Are the tunes muted?
 $6BA8 RET NZ          ; Return if they are.
 $6BA9 LD DE,$65D1     ; Point #REGde at the tune for losing a life (#R$65D1).
 $6BAC JP $6568        ; Jump to #R$6568 to play the tune.

; Handle End Of Life
;
; The handler for Charlie's actor slot once he has fallen to the bottom
; of the screen (ID #N$18). Nothing happens until all of the other actors have
; gone. Then, if the game is for one player, or the other player has no lives
; left, the game goes on with #R$6FFD if the active player has a life left, and
; is over (see #R$6C0A) if not. In a two player game, when both players have
; lives left, the players swap. If the active player has just lost the last
; life then "GAME OVER PLAYER n" is shown for that player first.
;
; IX Actor
@label=HandleEndOfLife
c$6BAF LD A,($5F1C)  ; Fetch the number of actors which were in play on the
                     ; last pass.
 $6BB2 AND A         ; Were there any actors in play on the last pass?
 $6BB3 RET NZ        ; Return if there were.
 $6BB4 LD A,($5F0C)  ; Fetch the game options.
 $6BB7 AND A         ; Are the game options zero (a 1UP game with the
                     ; keyboard)?
 $6BB8 JR NZ,$6BC3   ; Jump to #R$6BC3 if the options are not zero.
@label=HandleEndOfLife_OnePlayer
*$6BBA LD A,($5F2E)  ; Fetch the lives of the active player.
 $6BBD AND A         ; Has the active player run out of lives?
 $6BBE JR Z,$6C0A    ; Jump to #R$6C0A if so.
 $6BC0 JP $6FFD      ; Jump to #R$6FFD to start the next life.
@label=HandleEndOfLife_TwoPlayer
*$6BC3 LD A,($5F32)  ; Fetch the lives of the inactive player.
 $6BC6 AND A         ; Has the other player run out of lives?
 $6BC7 JR Z,$6BBA    ; Jump to #R$6BBA if so.
 $6BC9 LD A,($5F2E)  ; Fetch the lives of the active player.
 $6BCC AND A         ; Has the active player run out of lives?
 $6BCD CALL Z,$6C02  ; Call #R$6C02 if so, to show the "GAME OVER" message.
 $6BD0 CALL $6416    ; Swap the data for the two players using #R$6416.
 $6BD3 LD A,($5F21)  ; Fetch the active player (#N$00 for 1UP, #N$FF for 2UP).
 $6BD6 CPL           ; Invert #REGa, so the other player is active.
 $6BD7 LD ($5F21),A  ; Update the active player (#R$5F21).
 $6BDA CALL $5FE8    ; Draw the window, the pantry and the lives using #R$5FE8.
 $6BDD JP $6FFD      ; Jump to #R$6FFD to start the next life.

; Game Over
;
; Used by the routines at #R$6C02 and #R$6C0A.
; .
; Shows "GAME OVER PLAYER 1" in the play area, and waits for a while.
; The example below stops before the pause.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$6298,stop=$62B5,clear=1,sp=$5F00)
; #POKES$5F0D,$01
; #SIM(start=$6428,stop=$6457,sp=$5F00)
; #SIM(start=$5FE1,stop=$6001,sp=$5F00)
; #SCR$01(game-over-before)
; | #SIM(start=$6BE0,stop=$6BF1,sp=$5F00)
; #SCR$01(game-over-1up) } UDGTABLE# #POPS
@label=GameOver_1UP_Messaging
c$6BE0 LD A,"1"+$80  ; Fetch the player number "1", with bit 7 set to end the
                     ; message.
; This entry point is used by the routine at #R$6BFE.
; .
; Print the messaging and pause to show it for a period of time.
@label=GameOver_Write
*$6BE2 LD ($6C30),A  ; Write the player number into the message at
                     ; #R$6C1E(#N$6C30).
 $6BE5 CALL $5FB7    ; Clear the screen and draw the game window using #R$5FB7.
 $6BE8 LD DE,$6C1E   ; Point #REGde at #R$6C1E.
 $6BEB LD HL,$7038   ; #REGhl=#N$7038.
 $6BEE CALL $7488    ; Print the message using #R$7488.
; Introduce a pause by counting down from #N$10000 four times.
 $6BF1 LD B,$04      ; Set the repeat counter to #N$04.
; This entry point is used by the routine at #R$64F4.
@label=PauseForCount
*$6BF3 LD HL,$0000   ; Set the delay counter to #N$0000, so that it counts down from
                     ; #N$10000.
@label=GameOver_Pause
*$6BF6 DEC HL        ; Decrease the delay counter by one.
 $6BF7 LD A,H        ; {Loop back to #R$6BF6 until the delay counter is zero.
 $6BF8 OR L          ;
 $6BF9 JR NZ,$6BF6   ; }
 $6BFB DJNZ $6BF6    ; Decrease the repeat counter by one and loop back to #R$6BF6 until
                     ; the delay has been done four times.
 $6BFD RET           ; Return.
; View the equivalent code in;
; #LIST
; { #LUNARJETMAN$A8E3 }
; { #TRANZAM$6353 }
; LIST#

; Show Game Over 2UP
;
; Used by the routines at #R$6C02 and #R$6C0A.
; .
; Shows "GAME OVER PLAYER 2" in the play area, and waits for a while.
; The example below stops before the pause.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$6298,stop=$62B5,clear=1,sp=$5F00)
; #POKES$5F0D,$01
; #SIM(start=$6428,stop=$6457,sp=$5F00)
; #SIM(start=$5FE1,stop=$6001,sp=$5F00)
; #SCR$01(game-over-before)
; | #SIM(start=$6BFE,stop=$6BF1,sp=$5F00)
; #SCR$01(game-over-2up) } UDGTABLE# #POPS
@label=GameOver_2UP
c$6BFE LD A,"2"+$80  ; Fetch the player number "2", with bit 7 set to end the
                     ; message.
 $6C00 JR $6BE2      ; Jump to #R$6BE2.

; Show Current Game Over
;
; Used by the routine at #R$6BAF.
; .
; Shows the "GAME OVER" message for the active player, using #R$5F21 to
; choose between 1UP and 2UP.
@label=GameOver_Controller
c$6C02 LD A,($5F21)  ; {If #R$5F21 is zero, jump to #R$6BE0.
 $6C05 AND A         ;
 $6C06 JR Z,$6BE0    ; }
 $6C08 JR $6BFE      ; Else, jump to #R$6BFE.

; End Game
;
; Used by the routine at #R$6BAF.
; .
; Called when the last life has been lost in a one player game, or by the
; last player of a two player game. Checks the high score, shows the "GAME OVER"
; message for the active player, and then goes back to the game selection
; screen using #R$62B5.
@label=GameOver_ControllerRestart
c$6C0A CALL $73D3    ; Check for a new high score using #R$73D3.
 $6C0D LD A,($5F21)  ; {If #R$5F21 is not zero, jump to #R$6C19.
 $6C10 AND A         ;
 $6C11 JR NZ,$6C19   ; }
 $6C13 CALL $6BE0    ; Show the 1UP game over message using #R$6BE0.
@label=GameOver_Restart
*$6C16 JP $62B5      ; Jump to #R$62B5.
@label=GameOver_Restart2UP
*$6C19 CALL $6BFE    ; Show the 2UP game over message using #R$6BFE.
 $6C1C JR $6C16      ; Jump to #R$6C16.

; Game Over Message
;
; The message for #R$6BE0 and #R$6BFE. The first byte is the text colour
; and the last byte is the player number (changed to #N$B1 or #N$B2 by #R$6BE0
; or #R$6BFE).
@label=GameOver_Text
t$6C1E DEFM $47                         ; {#HTML("GAME OVER PLAYER <em>X</em>"
 $6C1F DEFM "GAME OVER PLAYER ","1"+$80 ; (#COLOUR(#PEEK(#PC)) is the
                                        ; attribute).)}

; Handle Level Timer
;
; The handler for the actor which is created by #R$6C58 at the start of a
; level (IDs #N$0A and #N$0B). It is not drawn; its horizontal co-ordinate is
; used as a timer, which is decreased by one each pass. When it reaches zero the
; introduction to the level is started by #R$6D38.
;
; IX Actor
@label=HandleLevelTimer
c$6C31 LD A,(IX+$01) ; Fetch the timer (held in the horizontal co-ordinate).
 $6C34 DEC A         ; Decrease the timer by one.
 $6C35 LD (IX+$01),A ; Update the timer.
 $6C38 CALL Z,$6D38  ; Call #R$6D38 if the timer is zero.
 $6C3B RET           ; Return.

; Next Level
;
; Used by the routine at #R$71A3.
; .
; Moves on to the next level, when all of the ingredients for a level have
; been collected. Bits 0-2 of the level (#R$5F2D) are the level within a set of
; five, and bits 3-5 are the set. After the fifth level of a set the cake is
; made; the level is moved on to the start of the next set, the player gets an
; extra life and #N$2500 (BCD) points, and the cake is started by #R$64E8.
; Otherwise the level is set up by #R$6C58.
@label=NextLevel
c$6C3C LD HL,$5F2D   ; Point #REGhl at the level (#R$5F2D).
 $6C3F INC (HL)      ; Increase the level by one.
 $6C40 LD A,(HL)     ; Fetch the level.
 $6C41 AND %00000111 ; Keep only bits 0-2.
 $6C43 CP $05        ; {Jump to #R$6C58 if the set has not been finished.
 $6C45 JR C,$6C58    ; }
 $6C47 LD A,(HL)     ; Fetch the level.
 $6C48 ADD A,$03     ; Add #N$03, to get to the start of the next set.
 $6C4A LD (HL),A     ; Update the level.
 $6C4B LD HL,$5F2E   ; Point #REGhl at the lives of the active player
                     ; (#R$5F2E).
 $6C4E INC (HL)      ; Increase the number of lives by one.
 $6C4F LD BC,$2500   ; Set the bonus points for finishing a set to #N$2500 (in
                     ; BCD).
 $6C52 CALL $7415    ; Add the points to the score using #R$7415.
 $6C55 JP $64E8      ; Jump to #R$64E8 to start the cake.

; Set Up Level
;
; Used by the routines at #R$6428, #R$64F4 and #R$6C3C.
; .
; Sets up the active player for the level in #R$5F2D. The number of
; ingredients needed (in BCD) is #N$10 for the first set of five levels, #N$20
; for the second set, and so on. An actor with ID #N$0A is created in the first
; of the six slots, with a horizontal co-ordinate of #N$20; it is the timer
; which is handled by #R$6C31. The level number which is shown on the screen
; (in BCD, up to a maximum of #N$99) is also increased.
@label=SetUpLevel
c$6C58 LD A,($5F2D)  ; Fetch the level.
 $6C5B RLCA          ; Rotate #REGa left.
 $6C5C AND %01110000 ; Keep only bits 4-6, which is the set (from bits 3-5 of the
                     ; level) multiplied by #N$10.
 $6C5E ADD A,$10     ; Add #N$10.
 $6C60 LD ($5F2F),A  ; Set the number of ingredients needed (#R$5F2F).
 $6C63 LD HL,$5F55   ; {Write #N$0A to the actor ID of #R$5F55.
 $6C66 LD (HL),$0A   ; }
 $6C68 INC HL        ; {Write #N$20 to the horizontal co-ordinate of the actor.
 $6C69 LD (HL),$20   ; }
; The level number (in BCD) maxes out at #N$99.
 $6C6B LD HL,$5F30   ; Point #REGhl at the level number (#R$5F30).
 $6C6E LD A,(HL)     ; Fetch the level number.
 $6C6F ADD A,$01     ; Add #N$01 to the level number.
 $6C71 DAA           ; Adjust #REGa to BCD.
 $6C72 CP $99        ; {Jump to #R$6C78 if the level number is less than #N$99.
 $6C74 JR C,$6C78    ; }
 $6C76 LD A,$99      ; Set the level number to the maximum, #N$99.
@label=SetUpLevel_Return
*$6C78 LD (HL),A     ; Update the level number.
 $6C79 RET           ; Return.

; Catch Actor
;
; Used by the routine at #R$6EF5.
; .
; Called when an actor has fallen into the mixing bowl (see #R$6E25). If
; it is one of the ingredients (an ID below #N$18) the rising notes are started
; and one ingredient is taken away from the number which is needed. Otherwise
; it is one of the nasties, so the falling notes are started and five is added
; to the number of ingredients which is needed (up to a maximum of #N$99).
;
; IX Actor
@label=CatchActor
c$6C7A LD A,(IX+$00) ; Fetch the actor ID.
 $6C7D AND %00111111 ; Keep only bits 0-5.
 $6C7F CP $18        ; {Jump to #R$6CA7 if the actor is not an ingredient.
 $6C81 JR NC,$6CA7   ; }
 $6C83 CALL $68E7    ; Start the rising notes using #R$68E7.
 $6C86 LD B,$01      ; Take one ingredient (#REGb=#N$01).

; Take Ingredients
;
; Used by the routine at #R$6017.
; .
; Takes some away from the number of ingredients which are needed, and
; shows the new number in the mixing bowl. The number is never less than zero.
; When it reaches zero the actors which are left are cleared away (see
; #R$6AFC).
;
; B Number of ingredients to take away
@label=TakeIngredients
c$6C88 LD A,($5F2F)  ; Fetch the number of ingredients which the active player
                     ; needs.
 $6C8B SUB B         ; Subtract the number of ingredients taken.
 $6C8C JR C,$6CA1    ; Jump to #R$6CA1 if more are being taken away than are
                     ; needed.
 $6C8E DAA           ; Adjust #REGa to BCD.
 $6C8F LD ($5F2F),A  ; Update the number of ingredients needed (#R$5F2F).
 $6C92 AND A         ; Are there any more ingredients needed?
 $6C93 CALL Z,$6AFC  ; Call #R$6AFC if there are not, to clear away the actors.
@label=TakeIngredients_Print
*$6C96 LD HL,$50AC   ; Point #REGhl at the screen address in the mixing bowl.
 $6C99 LD DE,$5F2F   ; Point #REGde at #R$5F2F.
 $6C9C LD B,$01      ; Set the number of bytes to print to #N$01.
 $6C9E JP $7450      ; Print the number using #R$7450.
@label=TakeIngredients_None
*$6CA1 XOR A         ; Set the number of ingredients needed to #N$00.
; This entry point is used by the routine at #R$6CA7.
@label=TakeIngredients_Store
*$6CA2 LD ($5F2F),A  ; Update the number of ingredients needed (#R$5F2F).
 $6CA5 JR $6C96      ; Jump to #R$6C96.

; Catch Nasty
;
; Used by the routine at #R$6C7A.
; .
; Part of #R$6C7A, used when the actor which has fallen into the mixing
; bowl is one of the nasties. The falling notes are started and five more
; ingredients are needed, up to a maximum of #N$99.
@label=CatchNasty
c$6CA7 CALL $68D4    ; Start the falling notes using #R$68D4.
 $6CAA LD B,$05      ; Set the penalty to #N$05 ingredients.
 $6CAC LD A,($5F2F)  ; Fetch the number of ingredients which the active player
                     ; needs.
 $6CAF ADD A,B       ; Add the penalty to the number of ingredients needed.
 $6CB0 DAA           ; Adjust #REGa to BCD.
 $6CB1 JR NC,$6CA2   ; Jump to #R$6CA2 if the number has not gone above #N$99.
 $6CB3 LD A,$99      ; Set the number of ingredients needed to the maximum,
                     ; #N$99.
 $6CB5 JR $6CA2      ; Jump to #R$6CA2.

; Handle Sugar
;
; The handler for the sugar (IDs #N$08 and #N$09), which drifts about
; the screen. Byte #N$04 of the actor is the horizontal speed, and byte #N$05
; is the vertical speed. Every #N$20 frames new random speeds are chosen (see
; #R$6EAC); they are both either #N$02 or #N$FE (-2). The sugar bounces off
; the sides and the top and bottom of the play area, and as it goes it also
; moves up and down in a wave, which is made from the frame counter in byte
; #N$07 of the actor.
; .
; While the sugar is still entering from the right of the screen (a horizontal
; co-ordinate of #N$C4 or more) it can't hit Charlie or be hit.
;
; IX Actor
@label=HandleSugar
c$6CB7 CALL $76D0      ; Record the position of the sprite using #R$76D0.
 $6CBA LD HL,$5F1B     ; Point #REGhl at #R$5F1B.
 $6CBD INC (HL)        ; Increase the number of actors in play by one.
 $6CBE LD A,(IX+$01)   ; Fetch the horizontal co-ordinate.
 $6CC1 CP $C4          ; {Jump to #R$6CD6 if the sugar is still entering from
 $6CC3 JR NC,$6CD6     ; the right.}
 $6CC5 CALL $6A46      ; Test whether the sugar has hit Charlie using #R$6A46.
 $6CC8 DEC E           ; Has Charlie been hit (is #REGe now zero)?
 $6CC9 JP Z,$6A73      ; Jump to #R$6A73 if Charlie has been hit.
 $6CCC CALL $7317      ; Test whether a flour shot has hit the sugar using
                       ; #R$7317.
 $6CCF BIT 7,(IX+$00)  ; {Jump to #R$730D if the sugar has been hit.
 $6CD3 JP NZ,$730D     ; }
@label=HandleSugar_Move
*$6CD6 INC (IX+$07)    ; Increase the frame counter in byte #N$07 of the actor
                       ; by one.
 $6CD9 LD (IX+$03),$44 ; Set the actor colour to #N$44 (green).
 $6CDD LD A,(IX+$07)   ; Fetch the frame counter.
 $6CE0 AND %00011111   ; Keep only bits 0-4.
 $6CE2 JR Z,$6D33      ; Jump to #R$6D33 if the counter is a multiple of #N$20, to change
                       ; speed.
 $6CE4 LD A,(IX+$01)   ; Fetch the horizontal co-ordinate.
 $6CE7 ADD A,(IX+$04)  ; Add the horizontal speed.
 $6CEA LD (IX+$01),A   ; Update the horizontal co-ordinate.
 $6CED CP $C0          ; {Jump to #R$6D1B if the sugar has reached the right
 $6CEF JR NC,$6D1B     ; edge.}
 $6CF1 CP $04          ; {Jump to #R$6D21 if the sugar has reached the left
 $6CF3 JR C,$6D21      ; edge.}
; Make the offset for the wave from the frame counter. For each of the
; eight values of bits 0-2 of the counter it is #N$03, #N$FC, #N$FD, #N$FE,
; #N$00, #N$01, #N$02 and #N$03.
@label=HandleSugar_Wave
*$6CF5 LD A,(IX+$07)   ; Fetch the frame counter.
 $6CF8 AND %00000011   ; Keep only bits 0-1.
 $6CFA BIT 2,(IX+$07)  ; {Jump to #R$6D04 if bit 2 of the frame counter is set.
 $6CFE JR NZ,$6D04     ; }
 $6D00 NEG             ; Negate #REGa.
 $6D02 XOR %00000011   ; Flip bits 0-1.
@label=HandleSugar_Vertical
*$6D04 ADD A,(IX+$05)  ; Add the vertical speed.
 $6D07 ADD A,(IX+$02)  ; Add the vertical co-ordinate.
 $6D0A CP $20          ; {Jump to #R$6D27 if the sugar has reached the top.
 $6D0C JR C,$6D27      ; }
 $6D0E CP $A0          ; {Jump to #R$6D2D if the sugar has reached the bottom.
 $6D10 JR NC,$6D2D     ; }
 $6D12 LD (IX+$02),A   ; Update the vertical co-ordinate.
@label=HandleSugar_Draw
*$6D15 CALL $75CC      ; Erase the sprite and draw it in its new position using
                       ; #R$75CC.
 $6D18 JP $74EE        ; Jump to #R$74EE to colour the sprite.
; The sugar has reached the right edge, so move it left.
@label=HandleSugar_RightEdge
*$6D1B LD (IX+$04),$FE ; Set the horizontal speed to #N$FE (-2, moving left).
 $6D1F JR $6CF5        ; Jump to #R$6CF5.
; The sugar has reached the left edge, so move it right.
@label=HandleSugar_LeftEdge
*$6D21 LD (IX+$04),$02 ; Write #N$02 to the horizontal speed.
 $6D25 JR $6CF5        ; Jump to #R$6CF5.
; The sugar has reached the top, so move it down.
@label=HandleSugar_Top
*$6D27 LD (IX+$05),$02 ; Write #N$02 to the vertical speed.
 $6D2B JR $6D15        ; Jump to #R$6D15.
; The sugar has reached the bottom, so move it up.
@label=HandleSugar_Bottom
*$6D2D LD (IX+$05),$FE ; Write #N$FE to the vertical speed.
 $6D31 JR $6D15        ; Jump to #R$6D15.
; Choose new speeds. #REGa is the new vertical speed, so it is added to
; the vertical co-ordinate twice.
@label=HandleSugar_NewSpeeds
*$6D33 CALL $6EAC      ; Set random horizontal and vertical speeds using
                       ; #R$6EAC.
 $6D36 JR $6D04        ; Jump to #R$6D04.

; Start Level Introduction
;
; Used by the routine at #R$6C31.
; .
; Starts the introduction to a level, which is when the level timer has
; run out (see #R$6C31). The screen is cleared, and then the ingredient which
; is needed for the level runs across the screen from right to left, followed
; by Charlie. When Charlie has left the screen the level is started (see
; #R$5FE1). The actors for the ingredient and for Charlie are handled by
; #R$6D89.
@label=StartLevelIntroduction
c$6D38 CALL $6D45    ; Clear the screen and create the actor for the ingredient using
                     ; #R$6D45.
 $6D3B LD HL,$5F35   ; Point #REGhl at #R$5F35.
 $6D3E LD DE,$6D87   ; Point #REGde at #R$6D87.
 $6D41 LD C,$07      ; #REGc=#N$07 (the ID for Charlie).
 $6D43 JR $6D67      ; Jump to #R$6D67 to create the actor for Charlie.

; Create Introduction Ingredient
;
; Used by the routine at #R$6D38.
; .
; Clears the screen and the attributes, and creates the actor for the
; ingredient which is needed for the level in the first of the six actor slots,
; using the data at #R$6D7D for the level (bits 0-2 of #R$5F2D). The actor
; is created by #R$6D67.
@label=CreateIntroductionIngredient
c$6D45 XOR A         ; {Clear the flag which says whether Charlie is running
 $6D46 LD ($5F29),A  ; (#R$5F29).}
; #HTML(Self modifying code; this updates the command at
; #R$74EE(#N$7515) to <strong>"CP #N$1E"</strong>, so the colouring can go
; further to the right.)
 $6D49 LD A,$1E      ; {Write #N$1E to #R$74EE(#N$7516).
 $6D4B LD ($7516),A  ; }
 $6D4E CALL $74E2    ; Reset the attribute buffer using #R$74E2.
 $6D51 CALL $74D4    ; Reset the screen buffer using #R$74D4.
 $6D54 LD HL,$6D7D   ; Point #REGhl at #R$6D7D.
 $6D57 LD A,($5F2D)  ; Fetch the level of the active player.
 $6D5A LD C,$06      ; #REGc=#N$06 (the ID for the ingredient).
 $6D5C RLCA          ; Multiply the level by two, as there are two bytes of data for each
                     ; level.
 $6D5D AND %00001111 ; Keep only bits 0-3.
 $6D5F LD E,A        ; {Use the result as the offset into the table.
 $6D60 LD D,$00      ; }
 $6D62 ADD HL,DE     ; Find the data for the level.
 $6D63 EX DE,HL      ; #REGde=the address of the data for the level.
 $6D64 LD HL,$5F55   ; Point #REGhl at the first spawned actor slot (#R$5F55).

; Create Introduction Actor
;
; Used by the routines at #R$6D38 and #R$6E11.
; .
; Creates an actor for the level introduction, at the right of the screen
; (horizontal co-ordinate #N$F0, vertical co-ordinate #N$68). Bytes #N$05 and
; #N$06 of the actor are cleared.
;
; C ID of the actor
; DE Address of the sprite ID and the colour
; HL Address of the actor
@label=CreateIntroductionActor
c$6D67 LD (HL),C     ; Write the ID to the actor.
 $6D68 INC HL        ; Move on to the horizontal co-ordinate.
 $6D69 LD (HL),$F0   ; Set the horizontal co-ordinate to #N$F0
                     ; (off the right of the screen).
 $6D6B INC HL        ; Move on to the vertical co-ordinate.
 $6D6C LD (HL),$68   ; Write #N$68 to the vertical co-ordinate.
 $6D6E INC HL        ; Move on to the colour.
 $6D6F LD A,(DE)     ; Fetch the sprite ID.
 $6D70 LD C,A        ; Keep the sprite ID in #REGc.
 $6D71 INC DE        ; Move on to the colour in the data.
 $6D72 LD A,(DE)     ; Fetch the colour.
 $6D73 LD (HL),A     ; Update the actor colour.
 $6D74 INC HL        ; Move on to byte #N$04 of the actor.
 $6D75 LD (HL),C     ; Write the sprite ID to byte #N$04 of the actor.
 $6D76 INC HL        ; Move on to byte #N$05 of the actor.
 $6D77 LD (HL),$00   ; Write #N$00 to byte #N$05 of the actor.
 $6D79 INC HL        ; Move on to byte #N$06 of the actor.
 $6D7A LD (HL),$00   ; Write #N$00 to byte #N$06 of the actor.
 $6D7C RET           ; Return.

; Introduction Ingredients
;
; The sprite ID and the colour of the ingredient which runs across the
; screen in the introduction to each of the five levels in a set.
@label=IntroductionIngredients
b$6D7D DEFB $04      ; {Level #N$00: custard (yellow).
 $6D7E DEFB $46      ; }
 $6D7F DEFB $08      ; {Level #N$01: sugar (green).
 $6D80 DEFB $44      ; }
 $6D81 DEFB $10      ; {Level #N$02: chocolate (red).
 $6D82 DEFB $42      ; }
 $6D83 DEFB $12      ; {Level #N$03: cheese (yellow).
 $6D84 DEFB $46      ; }
 $6D85 DEFB $14      ; {Level #N$04: orange peel (magenta).
 $6D86 DEFB $43      ; }

; Introduction Charlie
;
; The sprite ID and the colour of Charlie in the introduction to a level.
@label=IntroductionCharlie
b$6D87 DEFB $01
 $6D88 DEFB $47

; Handle Level Introduction
;
; The handler for the actors in the introduction to a level; the
; ingredient (ID #N$06) and Charlie (ID #N$07). While they are handled the ID
; is changed to the sprite which is in byte #N$04 of the actor. Byte #N$05 of
; the actor is zero until it has been drawn for the first time. The actors move
; left two pixels each pass, and change to their other frame every four passes.
; .
; Charlie waits (and is not drawn) until the ingredient has gone past the point
; at which #R$5F29 is set by #R$6E11. When an actor goes off the left side of
; the screen it is removed; and if it was Charlie then the level is started.
; A tone is played by #R$6854 every eight frames for Charlie.
;
; IX Actor
@label=HandleLevelIntroduction
c$6D89 LD A,(IX+$00)   ; Fetch the actor ID.
 $6D8C PUSH AF         ; Stash the actor ID on the stack.
 $6D8D CP $07          ; {Jump to #R$6D97 if this is the ingredient.
 $6D8F JR NZ,$6D97     ; }
 $6D91 LD A,($5F29)    ; Fetch the flag which says whether Charlie is running.
 $6D94 AND A           ; Has Charlie started to run yet?
 $6D95 JR Z,$6DF0      ; Jump to #R$6DF0 if he has not.
@label=HandleLevelIntroduction_Draw
*$6D97 LD A,(IX+$05)   ; Fetch the flag which says whether the actor has been
                       ; drawn.
 $6D9A AND A           ; Has the actor been drawn?
 $6D9B JR NZ,$6DB6     ; Jump to #R$6DB6 if it has.
 $6D9D INC (IX+$05)    ; Flag that the actor has been drawn.
 $6DA0 LD A,(IX+$04)   ; Fetch the sprite ID (byte #N$04 of the actor).
 $6DA3 LD (IX+$00),A   ; Update the actor ID.
 $6DA6 CALL $7617      ; Draw the sprite using #R$7617.
 $6DA9 POP AF          ; Restore the actor ID from the stack.
 $6DAA LD (IX+$00),A   ; Update the actor ID.
 $6DAD RET             ; Return.
; Charlie changes to his second frame.
@label=HandleLevelIntroduction_SecondFrame
*$6DAE LD A,$02        ; Set the sprite ID for Charlie's second frame, #N$02.
 $6DB0 JR $6DD3        ; Jump to #R$6DD3.
; Charlie changes to his first frame.
@label=HandleLevelIntroduction_FirstFrame
*$6DB2 LD A,$01        ; Set the sprite ID for Charlie's first frame, #N$01.
 $6DB4 JR $6DD3        ; Jump to #R$6DD3.
; The actor has been drawn already.
@label=HandleLevelIntroduction_Animate
*$6DB6 LD A,(IX+$04)   ; Fetch the sprite ID (byte #N$04 of the actor).
 $6DB9 LD (IX+$00),A   ; Update the actor ID.
 $6DBC CALL $76D0      ; Record the position of the sprite using #R$76D0.
 $6DBF LD A,($5F1D)    ; Fetch the frame counter.
 $6DC2 AND %00000011   ; Keep only bits 0-1.
 $6DC4 JR NZ,$6DD9     ; Jump to #R$6DD9 if the frame counter is not a multiple
                       ; of #N$04.
 $6DC6 LD A,(IX+$04)   ; Fetch the sprite ID (byte #N$04 of the actor).
 $6DC9 CP $01          ; {Jump to #R$6DAE if the sprite is Charlie's first
 $6DCB JR Z,$6DAE      ; frame.}
 $6DCD CP $02          ; {Jump to #R$6DB2 if the sprite is Charlie's second
 $6DCF JR Z,$6DB2      ; frame.}
 $6DD1 XOR %00000001   ; Flip bit 0, to change to the other frame of the
                       ; ingredient.
@label=HandleLevelIntroduction_SetFrame
*$6DD3 LD (IX+$04),A   ; Update the sprite ID (byte #N$04 of the actor).
 $6DD6 LD (IX+$00),A   ; Update the actor ID.
@label=HandleLevelIntroduction_Move
*$6DD9 LD A,(IX+$01)   ; Fetch the horizontal co-ordinate.
 $6DDC SUB $02         ; Subtract #N$02, to move the actor to the left.
 $6DDE LD (IX+$01),A   ; Update the horizontal co-ordinate.
 $6DE1 CP $90          ; Compare with #N$90 (the point at which Charlie starts
                       ; to run).
 $6DE3 CALL C,$6E11    ; Call #R$6E11 if the actor is to the left of #N$90.
 $6DE6 CP $F8          ; {Jump to #R$6E03 if the actor has gone off the left of
 $6DE8 JR NC,$6E03     ; the screen.}
 $6DEA CALL $75CC      ; Erase the sprite and draw it in its new position using
                       ; #R$75CC.
 $6DED CALL $74EE      ; Colour the sprite using #R$74EE.
; Put the actor ID back, and play the tone if this is Charlie.
@label=HandleLevelIntroduction_Finish
*$6DF0 POP AF          ; Restore the actor ID from the stack.
 $6DF1 LD (IX+$00),A   ; Update the actor ID.
 $6DF4 LD A,($5C78)    ; Fetch the first byte of #SKOOLKID$5C78(FRAMES).
 $6DF7 AND %00000111   ; Keep only bits 0-2.
 $6DF9 RET NZ          ; Return if the frame counter is not a multiple of
                       ; #N$08.
 $6DFA LD A,(IX+$03)   ; Fetch the actor colour.
 $6DFD CP $47          ; Compare with #N$47 (white, the colour of Charlie).
 $6DFF RET NZ          ; Return if this is not Charlie.
 $6E00 JP $6854        ; Jump to #R$6854 to play the tone.
; The actor has gone off the left of the screen.
@label=HandleLevelIntroduction_Remove
*$6E03 CALL $7607      ; Erase the sprite using #R$7607.
 $6E06 LD (IX+$00),$00 ; Write #N$00 to the actor ID.
 $6E0A POP AF          ; Restore the original actor ID from the stack.
 $6E0B CP $07          ; {Jump to #R$5FE1 to start the level if this was
 $6E0D JP Z,$5FE1      ; Charlie.}
 $6E10 RET             ; Return.

; Start Charlie Running
;
; Used by the routine at #R$6D89.
; .
; Called when the ingredient in the introduction to a level has moved
; left of #N$90. The first time this happens #R$5F29 is set, so Charlie starts
; to run, and the actor for Charlie is created again.
@label=StartCharlieRunning
c$6E11 LD A,($5F29)  ; Fetch the flag which says whether Charlie is running.
 $6E14 AND A         ; Has Charlie started to run?
 $6E15 RET NZ        ; Return if he has.
 $6E16 INC A         ; #REGa=#N$01.
 $6E17 LD ($5F29),A  ; Flag that Charlie is running (#R$5F29).
 $6E1A LD HL,$5F35   ; Point #REGhl at #R$5F35.
 $6E1D LD DE,$6D87   ; Point #REGde at #R$6D87.
 $6E20 LD C,$07      ; #REGc=#N$07 (the ID for Charlie).
 $6E22 JP $6D67      ; Jump to #R$6D67 to create the actor for Charlie.

; Move Hit Actor
;
; Used by the routine at #R$730D.
; .
; Moves an actor which has been hit by a flour shot (see #R$7317). The
; actor moves by the speeds in bytes #N$04 and #N$05, which were taken from the
; flour shot. Byte #N$07 of the actor is a counter which was set to #N$40; each
; time this is called it is decreased, and when it reaches zero the actor
; recovers (see #R$6EA8). The speed is changed to #N$04 (or #N$FC) when the
; actor reaches the left (or right) edge of the play area or the top of it, and
; if the other speed is zero it is changed to a random one. When the actor
; reaches the bottom of the play area then #R$6EC0 deals with it.
; .
; Two bits of byte #N$06 of the actor are changed; bit 1 is set if the actor is
; less than #N$34 pixels from the middle of the screen (#N$68), and bit 7 is
; set if the actor is moving towards the middle of the screen (which is when it
; is in the left half and moving right, or in the right half and moving left).
;
; IX Actor
@label=MoveHitActor
c$6E25 DEC (IX+$07)    ; Decrease the counter in byte #N$07 of the actor by
                       ; one.
 $6E28 JR Z,$6EA8      ; Jump to #R$6EA8 if the counter is zero.
 $6E2A LD A,(IX+$01)   ; Fetch the horizontal co-ordinate.
 $6E2D ADD A,(IX+$04)  ; Add the horizontal speed.
 $6E30 CP $04          ; {Jump to #R$6E7A if the actor has reached the left
 $6E32 JR C,$6E7A      ; edge.}
 $6E34 CP $C4          ; {Jump to #R$6E8F if the actor has reached the right
 $6E36 JR NC,$6E8F     ; edge.}
 $6E38 LD (IX+$01),A   ; Update the horizontal co-ordinate.
@label=MoveHitActor_Vertical
*$6E3B LD A,(IX+$02)   ; Fetch the vertical co-ordinate.
 $6E3E ADD A,(IX+$05)  ; Add the vertical speed.
 $6E41 CP $20          ; {Jump to #R$6E95 if the actor has reached the top.
 $6E43 JR C,$6E95      ; }
 $6E45 CP $A0          ; {Jump to #R$6EC0 if the actor has reached the bottom.
 $6E47 JR NC,$6EC0     ; }
 $6E49 LD (IX+$02),A   ; Update the vertical co-ordinate.
; Work out which half of the screen the actor is in, and how far it is
; from the middle.
 $6E4C LD A,(IX+$01)   ; Fetch the horizontal co-ordinate.
 $6E4F SUB $68         ; Subtract #N$68 (the middle of the screen).
 $6E51 JP P,$6E5C      ; Jump to #R$6E5C if the actor is in the right half.
 $6E54 SET 7,(IX+$06)  ; Set bit 7 of byte #N$06 of the actor.
 $6E58 NEG             ; Make the distance positive.
 $6E5A JR $6E60        ; Jump to #R$6E60.
@label=MoveHitActor_RightHalf
*$6E5C RES 7,(IX+$06)  ; Reset bit 7 of byte #N$06 of the actor.
@label=MoveHitActor_Distance
*$6E60 CP $34          ; {Jump to #R$6E6A if the actor is #N$34 pixels or more from the
 $6E62 JR NC,$6E6A     ; middle.}
 $6E64 SET 1,(IX+$06)  ; Set bit 1 of byte #N$06 of the actor.
 $6E68 JR $6E6E        ; Jump to #R$6E6E.
@label=MoveHitActor_Far
*$6E6A RES 1,(IX+$06)  ; Reset bit 1 of byte #N$06 of the actor.
; Make bit 7 of byte #N$06 of the actor show whether the actor is moving
; towards the middle, by combining it with the direction of the horizontal
; speed.
@label=MoveHitActor_Direction
*$6E6E LD A,(IX+$04)   ; Fetch the horizontal speed.
 $6E71 AND %10000000   ; Keep only bit 7.
 $6E73 XOR (IX+$06)    ; Combine with byte #N$06 of the actor.
 $6E76 LD (IX+$06),A   ; Update byte #N$06 of the actor with the result.
 $6E79 RET             ; Return.
; The actor has reached the left edge, so make it move to the right.
@label=MoveHitActor_LeftEdge
*$6E7A LD (IX+$04),$04 ; Set the horizontal speed to #N$04 (moving right).
@label=MoveHitActor_TestVerticalSpeed
*$6E7E LD A,(IX+$05)   ; Fetch the vertical speed.
 $6E81 AND A           ; Is the vertical speed zero?
 $6E82 JR NZ,$6E3B     ; Jump to #R$6E3B if it is not.
 $6E84 LD A,R          ; Fetch a random number.
 $6E86 AND %00000100   ; Keep only bit 2.
 $6E88 SUB $02         ; Subtract #N$02, so that the speed is #N$FE or #N$02.
 $6E8A LD (IX+$05),A   ; Update the vertical speed.
 $6E8D JR $6E3B        ; Jump to #R$6E3B.
; The actor has reached the right edge, so make it move to the left.
@label=MoveHitActor_RightEdge
*$6E8F LD (IX+$04),$FC ; Set the horizontal speed to #N$FC (moving left).
 $6E93 JR $6E7E        ; Jump to #R$6E7E.
; The actor has reached the top, so make it move down.
@label=MoveHitActor_Top
*$6E95 LD (IX+$05),$04 ; Set the vertical speed to #N$04 (moving down).
; This entry point is used by the routine at #R$6EC0.
@label=MoveHitActor_TestHorizontalSpeed
*$6E99 LD A,(IX+$04)   ; Fetch the horizontal speed.
 $6E9C AND A           ; Is the horizontal speed zero?
 $6E9D RET NZ          ; Return if it is not.
 $6E9E LD A,R          ; Fetch a random number.
 $6EA0 AND %00000100   ; Keep only bit 2.
 $6EA2 SUB $02         ; Subtract #N$02, so that the speed is #N$FE or #N$02.
 $6EA4 LD (IX+$04),A   ; Update the horizontal speed.
 $6EA7 RET             ; Return.

; Recover Hit Actor
;
; Used by the routine at #R$6E25.
; .
; Called when the counter for an actor which has been hit has run out.
; Bit 7 of the actor ID is reset, so the actor is handled normally again, and
; it is given new random speeds by #R$6EAC.
;
; IX Actor
@label=RecoverHitActor
c$6EA8 RES 7,(IX+$00) ; Reset bit 7 of the actor ID, so that the actor is no
                      ; longer hit.

; Set Random Speeds
;
; Used by the routines at #R$6930 and #R$6CB7.
; .
; Sets the horizontal speed and the vertical speed of an actor to either
; #N$02 or #N$FE (-2), at random. The new vertical speed is also left in
; #REGa.
;
;   IX Actor
; O:A The new vertical speed
@label=SetRandomSpeeds
c$6EAC LD A,R        ; Fetch a random number.
 $6EAE AND %00000100 ; Keep only bit 2.
 $6EB0 SUB $02       ; Subtract #N$02, so that the speed is #N$FE or #N$02.
 $6EB2 LD (IX+$04),A ; Update the horizontal speed.
 $6EB5 LD A,R        ; Fetch a random number.
 $6EB7 RRA           ; Shift the random number right.
 $6EB8 AND %00000100 ; Keep only bit 2.
 $6EBA SUB $02       ; Subtract #N$02, so that the speed is #N$FE or #N$02.
 $6EBC LD (IX+$05),A ; Update the vertical speed.
 $6EBF RET           ; Return.

; Land Hit Actor
;
; Used by the routine at #R$6E25.
; .
; Part of #R$6E25, used when the actor has reached the bottom of the play
; area (a vertical co-ordinate of #N$A0 or more). The mixing bowl and the four
; dustbins are along the bottom of the screen, and the actor is tested against
; them with #R$6F57. This depends on the vertical co-ordinate of the actor:
; #TABLE(default,centre,centre)
; { =h Vertical co-ordinate | =h What happens }
; { #N$A0 to #N$B7 | Nothing, if the actor is over the bowl or a dustbin;
; otherwise it bounces off the gap (see #R$6ED2) }
; { #N$B8 to #N$BF | The actor is over the bowl (see #R$6EF5), over a dustbin
; (see #R$6F1E), or bounces off the gap (see #R$6ED2) }
; { #N$C0 or more | See #R$6F39 }
; TABLE#
;
; A The new vertical co-ordinate
; IX Actor
@label=LandHitActor
c$6EC0 LD (IX+$02),A   ; Update the vertical co-ordinate.
 $6EC3 INC (IX+$07)    ; Increase the counter in byte #N$07 of the actor by one, to make up
                       ; for it being decreased.
 $6EC6 CP $C0          ; {Jump to #R$6F39 if the actor has gone as far as the
 $6EC8 JR NC,$6F39     ; bottom.}
 $6ECA CP $B8          ; {Jump to #R$6EEC if the actor is on the bottom row.
 $6ECC JR NC,$6EEC     ; }
 $6ECE CALL $6F57      ; Test the position of the actor using #R$6F57.
 $6ED1 RET NC          ; Return if the actor is over the bowl or a dustbin.
; The actor is over a gap, so make it bounce.
@label=LandHitActor_Bounce
*$6ED2 LD A,(IX+$02)   ; Fetch the vertical co-ordinate.
 $6ED5 CP $A8          ; {Jump to #R$6EDF if the actor is #N$A8 or lower.
 $6ED7 JR NC,$6EDF     ; }
 $6ED9 LD (IX+$05),$FC ; Set the vertical speed to #N$FC (-4, to bounce the
                       ; actor upwards).
 $6EDD JR $6E99        ; Jump to #R$6E99.
; The actor is low down in the gap, so make it move the other way.
@label=LandHitActor_Rebound
*$6EDF LD A,(IX+$04)   ; Fetch the horizontal speed.
 $6EE2 NEG             ; Reverse the direction by negating the horizontal
                       ; speed.
 $6EE4 LD (IX+$04),A   ; Update the horizontal speed.
 $6EE7 LD (IX+$05),$04 ; Set the vertical speed to #N$04 (moving down).
 $6EEB RET             ; Return.
; The actor is on the bottom row.
@label=LandHitActor_BottomRow
*$6EEC CALL $6F57      ; Test the position of the actor using #R$6F57.
 $6EEF JR C,$6ED2      ; Jump to #R$6ED2 if the actor is over a gap.
 $6EF1 LD A,B          ; Fetch the result of the landing test (zero for the
                       ; bowl).
 $6EF2 AND A           ; Is the actor over the bowl?
 $6EF3 JR NZ,$6F1E     ; Jump to #R$6F1E if it is over a dustbin.

; Catch Hit Actor
;
; Used by the routine at #R$6F39.
; .
; The actor which was hit has landed in the mixing bowl. #R$6C7A deals
; with the number of ingredients which are needed, and the points for catching
; it are added to the score using the table at #R$6F47 (the nasties are worth
; nothing). The actor then becomes the batter (ID #N$28) at the bottom of the
; bowl, which is handled by #R$654C.
;
; IX Actor
@label=CatchHitActor
c$6EF5 CALL $6C7A      ; Take away or add ingredients using #R$6C7A.
 $6EF8 LD A,(IX+$00)   ; Fetch the actor ID.
 $6EFB RRCA            ; Rotate the actor ID right, to halve it.
 $6EFC AND %00001111   ; Keep only bits 0-3.
 $6EFE LD C,A          ; Use the result as the offset into the table of points.
 $6EFF LD B,$00        ; Set the high byte of the offset to #N$00.
 $6F01 LD HL,$6F47     ; Point #REGhl at #R$6F47.
 $6F04 ADD HL,BC       ; Find the points for the ingredient.
 $6F05 LD C,(HL)       ; Fetch the points.
 $6F06 CALL $7415      ; Add the points to the score using #R$7415.
 $6F09 LD (IX+$00),$28 ; Write #N$28 to the actor ID.
 $6F0D LD (IX+$02),$A0 ; Set the vertical co-ordinate to #N$A0 (the floor).
 $6F11 LD (IX+$03),$46 ; Set the actor colour to #N$46 (yellow).
 $6F15 RET             ; Return.

; Remove Fallen Actor
;
; Removes an actor which has hit the bottom of the play area, somewhere
; other than the mixing bowl. An ingredient makes the falling notes sound. A
; nasty which has been hit (it is white) is worth #N$0150 points, and makes the
; rising notes sound.
;
; IX Actor
@label=RemoveFallenActor
c$6F16 CALL $68D4      ; Start the falling notes using #R$68D4.
@label=RemoveFallenActor_Remove
*$6F19 LD (IX+$00),$00 ; Make the actor ID #N$00, which removes the actor.
 $6F1D RET             ; Return.
; This entry point is used by the routines at #R$6EC0 and #R$6F39.
; .
; An actor which is over a dustbin comes here.
@label=RemoveFallenActor_Pillar
*$6F1E LD A,(IX+$00)   ; Fetch the actor ID.
 $6F21 AND %00111111   ; Keep only bits 0-5.
 $6F23 CP $18          ; {Jump to #R$6F16 if the actor is an ingredient.
 $6F25 JR C,$6F16      ; }
 $6F27 LD A,(IX+$03)   ; Fetch the actor colour.
 $6F2A CP $47          ; {Jump to #R$6F34 if the nasty has not been hit.
 $6F2C JR NZ,$6F34     ; }
 $6F2E LD BC,$0150     ; Set the points for a nasty which has been hit to
                       ; #N$0150 (in BCD).
 $6F31 CALL $7415      ; Add the points to the score using #R$7415.
@label=RemoveFallenActor_Notes
*$6F34 CALL $68E7      ; Start the rising notes using #R$68E7.
 $6F37 JR $6F19        ; Jump to #R$6F19.

; Test Fallen Actor
;
; Used by the routine at #R$6EC0.
; .
; Part of #R$6E25, used when the actor has gone as far as the bottom of
; the screen. If the actor is near the middle of the screen (bit 1 of byte
; #N$06 is set) and is not moving towards the middle (bit 7 is not set) then it
; is caught by the mixing bowl (see #R$6EF5). Otherwise it is removed (see
; #R$6F1E).
;
; IX Actor
@label=TestFallenActor
c$6F39 BIT 1,(IX+$06) ; {Jump to #R$6F1E if the actor is not near the middle.
 $6F3D JR Z,$6F1E     ; }
 $6F3F BIT 7,(IX+$06) ; {Jump to #R$6EF5 if the actor is not moving towards the
 $6F43 JR Z,$6EF5     ; middle.}
 $6F45 JR $6F1E       ; Jump to #R$6F1E.

; Bowl Points
;
; The points (in BCD) for catching an actor in the mixing bowl, chosen by
; bits 1-4 of the actor ID. Only the ingredients are worth anything.
; #TABLE(default,centre,centre)
; { =h Actor | =h Points }
; { Custard | #N$55 }
; { Sugar | #N$65 }
; { Chocolate | #N$75 }
; { Cheese | #N$85 }
; { Orange peel | #N$95 }
; TABLE#
@label=BowlPoints
b$6F47 DEFB $00
 $6F48 DEFB $00
 $6F49 DEFB $55
 $6F4A DEFB $00
 $6F4B DEFB $65
 $6F4C DEFB $00
 $6F4D DEFB $00
 $6F4E DEFB $00
 $6F4F DEFB $75
 $6F50 DEFB $85
 $6F51 DEFB $95
 $6F52 DEFB $00
 $6F53 DEFB $00
 $6F54 DEFB $00
 $6F55 DEFB $00
 $6F56 DEFB $00

; Test Landing Position
;
; Used by the routine at #R$6EC0.
; .
; Tests whether the horizontal co-ordinate of an actor is over the mixing
; bowl, over one of the four dustbins or over one of the gaps between them.
; The screen is the same on both sides, so a co-ordinate in the right half is
; changed to the equivalent one in the left half first.
; #TABLE(default,centre,centre,centre)
; { =h Horizontal co-ordinate | =h Over | =h Carry flag }
; { #N$00 to #N$11, #N$AF to #N$BF | Outer dustbin | Reset }
; { #N$20 to #N$31, #N$8F to #N$A0 | Inner dustbin | Reset }
; { #N$41 to #N$7F | Mixing bowl | Reset }
; { Everywhere else | Gap | Set }
; TABLE#
;
;   IX Actor
; O:B Zero if the actor is over the mixing bowl
; O:F The carry flag is set if the actor is over a gap
@label=TestLandingPosition
c$6F57 LD B,$03      ; Set the position counter to #N$03.
 $6F59 LD A,(IX+$01) ; Fetch the horizontal co-ordinate.
 $6F5C CP $C0        ; {Jump to #R$6F76 if the actor is off to the right.
 $6F5E JR NC,$6F76   ; }
 $6F60 AND A         ; Test the horizontal co-ordinate.
 $6F61 JP P,$6F6A    ; Jump to #R$6F6A if the actor is in the left half.
 $6F64 NEG           ; Negate #REGa.
 $6F66 SUB $40       ; Subtract #N$40.
 $6F68 AND %01111111 ; Keep only bits 0-6.
@label=TestLandingPosition_Loop
*$6F6A DEC B         ; Decrease the position counter by one.
 $6F6B JR Z,$6F71    ; Jump to #R$6F71 if the position counter is zero.
 $6F6D SUB $20       ; Subtract #N$20.
 $6F6F JR NC,$6F6A   ; Jump to #R$6F6A if there was no carry.
@label=TestLandingPosition_Finish
*$6F71 NEG           ; Negate #REGa.
 $6F73 CP $0F        ; Compare with #N$0F.
 $6F75 RET           ; Return.
@label=TestLandingPosition_Gap
*$6F76 SCF           ; Set the carry flag.
 $6F77 RET           ; Return.

; Handle Flour Shot
;
; The handler for the flour shot (ID #N$03), which is fired by Charlie
; (see #R$710D). Byte #N$04 of the actor is the horizontal speed and byte #N$05
; is the vertical speed. The shot moves until it reaches the right, left,
; bottom or top of the play area, and then it explodes (see #R$6FA4).
;
; IX Actor
@label=HandleFlourShot
c$6F78 CALL $76D0     ; Record the position of the sprite using #R$76D0.
 $6F7B LD A,(IX+$01)  ; Fetch the horizontal co-ordinate.
 $6F7E ADD A,(IX+$04) ; Add the horizontal speed.
 $6F81 CP $C4         ; {Jump to #R$6FA4 if the shot has reached the right
 $6F83 JR NC,$6FA4    ; edge.}
 $6F85 CP $01         ; {Jump to #R$6FA4 if the shot has reached the left edge.
 $6F87 JR C,$6FA4     ; }
 $6F89 LD C,A         ; Keep the new horizontal co-ordinate in #REGc.
 $6F8A LD A,(IX+$02)  ; Fetch the vertical co-ordinate.
 $6F8D ADD A,(IX+$05) ; Add the vertical speed.
 $6F90 CP $A8         ; {Jump to #R$6FA4 if the shot has reached the bottom.
 $6F92 JR NC,$6FA4    ; }
 $6F94 CP $20         ; {Jump to #R$6FA4 if the shot has reached the top.
 $6F96 JR C,$6FA4     ; }
 $6F98 LD (IX+$02),A  ; Update the vertical co-ordinate.
 $6F9B LD (IX+$01),C  ; Update the horizontal co-ordinate.
 $6F9E CALL $75CC     ; Erase the sprite and draw it in its new position using
                      ; #R$75CC.
 $6FA1 JP $74EE       ; Jump to #R$74EE to colour the sprite.

; Explode Flour Shot
;
; Used by the routines at #R$6F78 and #R$7317.
; .
; Erases the flour shot, and changes it into an explosion (ID #N$26) which
; is handled by #R$65E8.
;
; IX Flour shot
@label=ExplodeFlourShot
c$6FA4 CALL $7617      ; Erase the sprite using #R$7617.
 $6FA7 LD (IX+$00),$26 ; Change the actor ID to #N$26 (an exploding flour
                       ; shot).
 $6FAB LD (IX+$07),$03 ; Write #N$03 to byte #N$07 of the actor (the explosion
                       ; counter).
 $6FAF RET             ; Return.

; Controls: Kempston Joystick
;
; Used by the routine at #R$6FB4.
; .
; Reads the Kempston joystick. The bits are flipped so that they are the
; same as those which are returned by #R$6FB4.
;
; O:A The controls (see #R$6FB4)
@label=ReadKempstonJoystick
c$6FB0 IN A,($1F)    ; Fetch the state of the Kempston joystick.
 $6FB2 CPL           ; Flip the bits, to match the keyboard (a zero bit means
                     ; pressed).
 $6FB3 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #JETPAC$733A }
; { #SABREWULF$B0D9 }
; LIST#

; Read Controls
;
; Used by the routine at #R$706B.
; .
; Reads the controls which have been chosen in #R$5F0C; the keyboard, the
; Kempston joystick or the cursor joystick. The bits of the result are reset
; for the directions (and fire) which are being pressed.
; #TABLE(default,centre,centre,centre)
; { =h Bit | =h Control | =h Keyboard }
; { #N$00 | Right | W }
; { #N$01 | Left | Q }
; { #N$02 | Down | E }
; { #N$03 | Up | R }
; { #N$04 | Fire | T }
; TABLE#
;
; O:A The controls
@label=ReadControls
c$6FB4 LD A,($5F0C)  ; Fetch the game options.
 $6FB7 AND %00000110 ; Keep only bits 1-2 (the choice of controls).
 $6FB9 CP $02        ; {Jump to #R$6FB0 if the Kempston joystick is being used.
 $6FBB JR Z,$6FB0    ; }
 $6FBD CP $04        ; {Jump to #R$6FD7 if the cursor joystick is being used.
 $6FBF JR Z,$6FD7    ; }
 $6FC1 LD A,$FB      ; {Read from the keyboard;
 $6FC3 OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $6FC5 IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$FB | Q | W | E | R | T }
                     ; TABLE#}
 $6FC7 LD C,A        ; Keep the key states in #REGc.
 $6FC8 RRA           ; Move the "W" key into bit 0.
 $6FC9 AND %00000001 ; Keep only bit 0.
 $6FCB LD E,A        ; Keep the result in #REGe.
 $6FCC LD A,C        ; Fetch the key states.
 $6FCD RLA           ; Move the "Q" key into bit 1.
 $6FCE AND %00000010 ; Keep only bit 1.
 $6FD0 OR E          ; Combine with #REGe.
 $6FD1 LD E,A        ; Keep the result in #REGe.
 $6FD2 LD A,C        ; Fetch the key states.
 $6FD3 AND %00011100 ; Keep only bits 2-4 ("E", "R" and "T").
 $6FD5 OR E          ; Combine with #REGe.
 $6FD6 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$93BE }
; { #UNDERWURLDE$AE17 }
; LIST#

; Controls: Cursor Joystick
;
; Used by the routine at #R$6FB4.
; .
; Reads the cursor joystick, which uses the keys "5" (left), "6" (down),
; "7" (up), "8" (right) and "0" (fire). The bits of the result are the same as
; those which are returned by #R$6FB4.
;
; O:A The controls (see #R$6FB4)
@label=ReadCursorJoystick
c$6FD7 LD A,$EF      ; {Read from the keyboard;
 $6FD9 OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $6FDB IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$EF | 0 | 9 | 8 | 7 | 6 }
                     ; TABLE#}
 $6FDD LD C,A        ; Keep the key states in #REGc.
 $6FDE AND %00001000 ; Keep only bit 3 ("7", up).
 $6FE0 LD E,A        ; Keep the result in #REGe.
 $6FE1 LD A,C        ; Fetch the key states.
 $6FE2 RRCA          ; {Rotate #REGa right twice.
 $6FE3 RRCA          ; }
 $6FE4 AND %01000101 ; Keep only bit 0 ("8", right), bit 2 ("6", down) and bit 6
                     ; ("0", fire).
 $6FE6 OR E          ; Combine with #REGe.
 $6FE7 LD E,A        ; Keep the result in #REGe.
 $6FE8 RRCA          ; {Rotate #REGa right twice, which moves the fire bit to
 $6FE9 RRCA          ; bit 4.}
 $6FEA AND %00010000 ; Keep only bit 4.
 $6FEC OR E          ; Combine with #REGe.
 $6FED AND %00011111 ; Keep only bits 0-4.
 $6FEF LD E,A        ; Keep the result in #REGe.
 $6FF0 LD A,$F7      ; {Read from the keyboard;
 $6FF2 OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $6FF4 IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$F7 | 1 | 2 | 3 | 4 | 5 }
                     ; TABLE#}
 $6FF6 RRA           ; {Move the "5" key (left) into bit 1.
 $6FF7 RRA           ;
 $6FF8 RRA           ; }
 $6FF9 AND %00000010 ; Keep only bit 1.
 $6FFB OR E          ; Combine with #REGe.
 $6FFC RET           ; Return.
; View the equivalent code in;
; #LIST
; { #SABREWULF$B103 }
; LIST#

; Start Life
;
; Used by the routines at #R$5FE1 and #R$6BAF.
; .
; Puts Charlie in his starting position, and takes a life away from the
; active player. Charlie will not appear until a delay has run out (see
; #R$7048); it is shorter for a one player game than a two player game, so
; that the players have time to swap controls.
@label=StartLife
c$6FFD LD HL,$5FAF   ; Point #REGhl at the data for Charlie at the start of a life
                     ; (#R$5FAF).
 $7000 LD DE,$5F35   ; Point #REGde at #R$5F35.
 $7003 LD BC,$0008   ; Set the number of bytes to copy to #N$0008.
 $7006 LDIR          ; Copy the data for Charlie into the first actor slot.
 $7008 LD A,$80      ; Set the delay for a one player game to #N$80.
 $700A LD HL,$5F0C   ; Point #REGhl at #R$5F0C.
 $700D BIT 0,(HL)    ; {Jump to #R$7013 if this is a one player game.
 $700F JR Z,$7013    ; }
 $7011 ADD A,$7F     ; Add #N$7F, so the delay is #N$FF for a two player game.
@label=StartLife_SetDelay
*$7013 LD ($5F25),A  ; Set the game delay timer (#R$5F25).
 $7016 LD A,($5F2E)  ; {Take a life away from the active player (#R$5F2E).
 $7019 DEC A         ;
 $701A LD ($5F2E),A  ; }
 $701D JP $7378      ; Jump to #R$7378 to show the lives.

; Flash Score Label
;
; Used by the routine at #R$7048.
; .
; Makes the score label of the active player ("1UP" or "2UP") flash. This
; is done while the delay before Charlie appears is running (see #R$7048).
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$6298,stop=$62B5,clear=1,sp=$5F00)
; #POKES$5F0D,$01
; #SIM(start=$6428,stop=$6457,sp=$5F00)
; #SIM(start=$5FE1,stop=$6001,sp=$5F00)
; #SCR$04,$00,$00,$0A,$02(flash-score-before)
; | #SIM(start=$7020,stop=$0000,sp=$5E00)
; #SCR$04,$00,$00,$0A,$02(flash-score-after) } UDGTABLE# #POPS
@label=ScoreLabelFlash
c$7020 LD A,($5F21)  ; Fetch the active player (#N$00 for 1UP, #N$FF for 2UP).
 $7023 AND A         ; {If the current player is 2UP then jump to #R$7043.
 $7024 JR NZ,$7043   ; }
; Flash 1UP score label.
 $7026 LD HL,$0018   ; #REGhl=#N($00,$02,$03),#N($18,$02,$03) (position of the
                     ; 1UP score label).
; Set flash state for the 3-attributes of the score label.
@label=FlashText
*$7029 CALL $7534    ; Calculate the attribute buffer address using #R$7534.
 $702C LD B,$03      ; Set the letter counter to #N$03
                     ; (the three letters in a score label).
@label=FlashText_Loop
*$702E LD A,(HL)     ; Fetch the attribute byte.
 $702F OR %10000000  ; Ensure bit 7 is set (the flash bit).
 $7031 LD (HL),A     ; Write the attribute byte back.
 $7032 INC HL        ; Move on to the next attribute.
 $7033 DJNZ $702E    ; Decrease the letter counter by one and loop back to #R$702E until
                     ; all three letters have been done.
 $7035 RET           ; Return.
; This entry point is used by the routine at #R$7048.
; .
; Unset flash state for the 3-attributes of the score label.
@label=UnsetFlashText
*$7036 CALL $7534    ; Calculate the attribute buffer address using #R$7534.
 $7039 LD B,$03      ; Set the letter counter to #N$03
                     ; (the three letters in a score label).
@label=UnsetFlashText_Loop
*$703B LD A,(HL)     ; Fetch the attribute byte.
 $703C AND %01111111 ; Keep only bits 0-6 (i.e. everything except the flash
                     ; bit).
 $703E LD (HL),A     ; Write the attribute byte back.
 $703F INC HL        ; Increase the attribute pointer by one.
 $7040 DJNZ $703B    ; Decrease the letter counter by one and loop back to #R$703B until
                     ; all three letters have been done.
 $7042 RET           ; Return.
; Flash 2UP score label.
@label=FlashScoreLabel2UP
*$7043 LD HL,$00D8   ; #REGhl=#N($00,$02,$03),#N($D8,$02,$03) (position of the
                     ; 2UP score label).
 $7046 JR $7029      ; Jump to #R$7029.
; View the equivalent code in;
; #LIST
; { #LUNARJETMAN$8C3E }
; { #SABREWULF$AEA1 }
; LIST#

; Game Play Entry
;
; The handler for Charlie (IDs #N$01 and #N$02). At the start of each life
; there is a delay (#R$5F25) before Charlie appears, and while it runs the
; score label of the active player flashes (see #R$7020). When it has run out
; the label stops flashing, Charlie is drawn and a tone is played (see
; #R$6882). After that Charlie is moved by #R$706B.
@label=GamePlayEntry
c$7048 LD HL,$5F25   ; {If #R$5F25 is zero, jump to #R$706B.
 $704B LD A,(HL)     ;
 $704C AND A         ;
 $704D JR Z,$706B    ; }
 $704F DEC (HL)      ; Decrease the game delay timer by one.
 $7050 JR NZ,$7020   ; Jump to #R$7020 if the delay timer is still active.
 $7052 LD A,($5F21)  ; {If #R$5F21 says this is a 2UP game, jump to #R$7066.
 $7055 AND A         ;
 $7056 JR NZ,$7066   ; }
; Handle turning off flash for 1UP score label.
 $7058 LD HL,$0018   ; #REGhl=#N($00,$02,$03),#N($18,$02,$03) (position of the
                     ; 1UP score label).
@label=Game_UnsetFlash
*$705B CALL $7036    ; Turn off the flash using #R$7036.
 $705E CALL $7617    ; Draw Charlie using #R$7617.
 $7061 CALL $6882    ; Play the game start tone using #R$6882.
 $7064 JR $706B      ; Jump to #R$706B.
; Handle turning off flash for 2UP score label.
@label=Game2UP_UnsetFlash
*$7066 LD HL,$00D8   ; #REGhl=#N($00,$02,$03),#N($D8,$02,$03) (position of the
                     ; 2UP score label).
 $7069 JR $705B      ; Jump to #R$705B.
; View the equivalent code in;
; #LIST
; { #PSSST$6DBA }
; { #SABREWULF$AECF }
; LIST#

; Game Play Start
;
; Used by the routine at #R$7048.
; .
; Moves Charlie, using the controls which are read by #R$6FB4. Byte #N$04
; of the actor is the horizontal speed and byte #N$05 is the vertical speed;
; each is #N$02 (or #N$FE) while the control is pressed, and zero otherwise.
; Charlie can't move past the edges of the play area. While he is moving his
; ID changes between #N$01 and #N$02 every four frames, which animates him. The
; last direction in which he moved is kept in #R$5F2B.
; .
; While fire is being held down, a flour shot is fired every eight frames, if
; there is one of the two slots for the shots free. The shot goes in the last
; direction in which Charlie moved, at three times his speed.
;
; IX Actor
@label=GamePlay_Start
c$706B CALL $76D0      ; Record the position of the sprite using #R$76D0.
 $706E CALL $6FB4      ; Read the controls using #R$6FB4.
 $7071 BIT 4,A         ; {Jump to #R$70EF if fire is being pressed.
 $7073 JR Z,$70EF      ; }
 $7075 LD (IX+$06),$00 ; Write #N$00 to byte #N$06 of the actor (the fire
                       ; counter).
@label=ControlCharlie_Movement
*$7079 BIT 0,A         ; Test bit 0 (right).
 $707B LD DE,$0000     ; Clear Charlie's movement (#REGde=#N$0000).
 $707E JR Z,$70D9      ; Jump to #R$70D9 if right is being pressed.
 $7080 BIT 1,A         ; {Jump to #R$70E0 if left is being pressed.
 $7082 JR Z,$70E0      ; }
 $7084 LD (IX+$04),$00 ; Write #N$00 to the horizontal speed.
@label=ControlCharlie_Vertical
*$7088 BIT 3,A         ; {Jump to #R$70E4 if up is being pressed.
 $708A JR Z,$70E4      ; }
 $708C BIT 2,A         ; {Jump to #R$70EB if down is being pressed.
 $708E JR Z,$70EB      ; }
 $7090 LD (IX+$05),$00 ; Write #N$00 to the vertical speed.
; Move Charlie horizontally. #REGe is the speed if he has moved, and
; zero if he has not.
@label=ControlCharlie_MoveHorizontal
*$7094 LD A,(IX+$01)   ; Fetch the horizontal co-ordinate.
 $7097 ADD A,(IX+$04)  ; Add the horizontal speed.
 $709A LD E,$00        ; Assume that Charlie has not moved horizontally
                       ; (#REGe=#N$00).
 $709C CP $01          ; {Jump to #R$70AA if Charlie has reached the left edge.
 $709E JR C,$70AA      ; }
 $70A0 CP $C4          ; {Jump to #R$70AA if Charlie has reached the right
 $70A2 JR NC,$70AA     ; edge.}
 $70A4 LD (IX+$01),A   ; Update the horizontal co-ordinate.
 $70A7 LD E,(IX+$04)   ; Set the horizontal movement to the horizontal speed.
; Move Charlie vertically. #REGd is the speed if he has moved, and zero if
; he has not.
@label=ControlCharlie_MoveVertical
*$70AA LD A,(IX+$02)   ; Fetch the vertical co-ordinate.
 $70AD ADD A,(IX+$05)  ; Add the vertical speed.
 $70B0 LD D,$00        ; Assume that Charlie has not moved vertically
                       ; (#REGd=#N$00).
 $70B2 CP $28          ; {Jump to #R$70C0 if Charlie has reached the top.
 $70B4 JR C,$70C0      ; }
 $70B6 CP $A0          ; {Jump to #R$70C0 if Charlie has reached the bottom.
 $70B8 JR NC,$70C0     ; }
 $70BA LD (IX+$02),A   ; Update the vertical co-ordinate.
 $70BD LD D,(IX+$05)   ; Set the vertical movement to the vertical speed.
@label=ControlCharlie_Animate
*$70C0 LD A,E          ; Fetch the horizontal movement.
 $70C1 OR D            ; Combine with the vertical movement.
 $70C2 JR Z,$70D3      ; Jump to #R$70D3 if Charlie has not moved.
 $70C4 LD ($5F2B),DE   ; Save the movement in #R$5F2B, which sets the direction of flour
                       ; shots.
 $70C8 LD A,($5C78)    ; Fetch the first byte of #SKOOLKID$5C78(FRAMES).
 $70CB RRA             ; {Shift #REGa right twice.
 $70CC RRA             ; }
 $70CD AND %00000001   ; Keep only bit 0.
 $70CF INC A           ; Add #N$01, to get Charlie's running frame (#N$01 or
                       ; #N$02).
 $70D0 LD (IX+$00),A   ; Update the actor ID.
@label=ControlCharlie_Draw
*$70D3 CALL $75CC      ; Erase the sprite and draw it in its new position using
                       ; #R$75CC.
 $70D6 JP $74EE        ; Jump to #R$74EE to colour the sprite.
; Right is being pressed.
@label=ControlCharlie_Right
*$70D9 LD E,$02        ; Set the speed to #N$02 (moving right).
@label=ControlCharlie_SetHorizontalSpeed
*$70DB LD (IX+$04),E   ; Set the horizontal speed.
 $70DE JR $7088        ; Jump to #R$7088.
; Left is being pressed.
@label=ControlCharlie_Left
*$70E0 LD E,$FE        ; Set the speed to #N$FE (moving left).
 $70E2 JR $70DB        ; Jump to #R$70DB.
; Up is being pressed.
@label=ControlCharlie_Up
*$70E4 LD D,$FE        ; Set the speed to #N$FE (moving up).
@label=ControlCharlie_SetVerticalSpeed
*$70E6 LD (IX+$05),D   ; Set the vertical speed.
 $70E9 JR $7094        ; Jump to #R$7094.
; Down is being pressed.
@label=ControlCharlie_Down
*$70EB LD D,$02        ; Set the speed to #N$02 (moving down).
 $70ED JR $70E6        ; Jump to #R$70E6.
; Fire is being pressed. A shot is fired when the fire counter in byte
; #N$06 of the actor is a multiple of #N$08, so the first one is fired at once.
@label=ControlCharlie_Fire
*$70EF PUSH AF         ; Save the controls on the stack.
 $70F0 LD A,(IX+$06)   ; Fetch the fire counter (byte #N$06 of the actor).
 $70F3 INC (IX+$06)    ; Increase the fire counter by one.
 $70F6 AND %00000111   ; Keep only bits 0-2.
 $70F8 JR NZ,$7109     ; Jump to #R$7109 if the fire counter was not a multiple
                       ; of #N$08.
 $70FA LD HL,$5F3D     ; Point #REGhl at #R$5F3D.
 $70FD LD B,$02        ; Set the slot counter to #N$02 (the number of slots for
                       ; flour shots).
 $70FF LD DE,$0008     ; Set the size of an actor to #N$0008.
@label=ControlCharlie_FindSlot
*$7102 LD A,(HL)       ; Fetch the actor ID.
 $7103 AND A           ; Is the slot empty?
 $7104 JR Z,$710D      ; Jump to #R$710D if it is.
 $7106 ADD HL,DE       ; Move on to the next slot.
 $7107 DJNZ $7102      ; Decrease the slot counter by one and loop back to #R$7102 until
                       ; both slots have been tried.
@label=ControlCharlie_FireFinished
*$7109 POP AF          ; Restore the controls from the stack.
 $710A JP $7079        ; Jump to #R$7079.
; Create the flour shot, which starts at Charlie's position.
@label=ControlCharlie_CreateShot
*$710D LD (HL),$03     ; Set the actor ID to #N$03 (a flour shot).
 $710F PUSH HL         ; Save the address of the flour shot on the stack.
 $7110 INC HL          ; Move on to the horizontal co-ordinate.
 $7111 LD A,(IX+$01)   ; Fetch Charlie's horizontal co-ordinate.
 $7114 LD (HL),A       ; Update the horizontal co-ordinate of the flour shot.
 $7115 INC HL          ; Move on to the vertical co-ordinate.
 $7116 LD A,(IX+$02)   ; Fetch Charlie's vertical co-ordinate.
 $7119 LD (HL),A       ; Update the vertical co-ordinate of the flour shot.
 $711A INC HL          ; Move on to the colour.
 $711B LD (HL),$47     ; Set the colour of the flour shot to #N$47 (white).
 $711D INC HL          ; Move on to the horizontal speed.
 $711E LD DE,($5F2B)   ; Fetch Charlie's last movement (#R$5F2B).
 $7122 LD A,E          ; Fetch the horizontal movement.
 $7123 SLA A           ; Multiply #REGa by two.
 $7125 ADD A,E         ; Add #REGe, to multiply it by three.
 $7126 LD (HL),A       ; Update the horizontal speed of the flour shot.
 $7127 INC HL          ; Move on to the vertical speed.
 $7128 LD A,D          ; Fetch the vertical movement.
 $7129 SLA A           ; Multiply #REGa by two.
 $712B ADD A,D         ; Add #REGd, to multiply it by three.
 $712C LD (HL),A       ; Update the vertical speed of the flour shot.
 $712D POP HL          ; Restore the address of the flour shot from the stack.
 $712E PUSH IX         ; Save the pointer to the current actor on the stack.
 $7130 PUSH HL         ; Save the address of the flour shot on the stack.
 $7131 POP IX          ; Restore #REGix from the stack (this is now the flour
                       ; shot).
 $7133 CALL $7617      ; Draw the flour shot using #R$7617.
 $7136 POP IX          ; Restore the pointer to the current actor from the
                       ; stack.
 $7138 CALL $6825      ; Play the chirp using #R$6825.
 $713B JR $7109        ; Jump to #R$7109.

; Remove All Actors
;
; Used by the routines at #R$64F4 and #R$71A3.
; .
; Removes all ten of the actors, by writing zero to each of the IDs.
@label=RemoveAllActors
c$713D LD HL,$5F35   ; Point #REGhl at the first actor (Charlie's slot).
 $7140 LD B,$0A      ; Set the actor counter to #N$0A (the number of actors).
 $7142 JR $7149      ; Jump to #R$7149.

; Unused Remove Actors
;
; Not used by the game. It would remove nine actors, starting at #N$5F5D,
; by using #R$7149.
@label=Unused_RemoveActors
u$7144 LD HL,$5F5D   ; #REGhl=#N$5F5D.
 $7147 LD B,$09      ; #REGb=#N$09 (the number of actors).

; Remove Actors
;
; Used by the routine at #R$713D.
; .
; Removes a number of actors, by writing zero to each of the IDs.
;
; B Number of actors
; HL Address of the first actor
@label=RemoveActors
c$7149 LD DE,$0008   ; Set the size of an actor to #N$0008.
@label=RemoveActors_Loop
*$714C LD (HL),$00   ; Write #N$00 to the actor ID.
 $714E ADD HL,DE     ; Move on to the next actor.
 $714F DJNZ $714C    ; Decrease the actor counter by one and loop back to #R$714C until
                     ; all of the actors have been done.
 $7151 RET           ; Return.

; Limit Frame Rate
;
; The handler for empty actor slots (IDs #N$00, #N$0C and #N$17). It adds
; a short pause, which slows the game down when there are few actors. The pause
; is skipped while the frame update (#R$7160) is running.
@label=LimitFrameRate
c$7152 LD A,($5F23)  ; {Return if #R$5F23 is set (the frame update is running).
 $7155 AND A         ;
 $7156 RET NZ        ; }
 $7157 LD HL,$0100   ; Set the pause counter to #N$0100.
@label=LimitFrameRate_Loop
*$715A DEC HL        ; Decrease the pause counter by one.
 $715B LD A,L        ; {Keep jumping back to #R$715A until the counter is zero.
 $715C OR H          ;
 $715D JR NZ,$715A   ; }
 $715F RET           ; Return.
; View the equivalent code in;
; #LIST
; { #JETPAC$691B }
; { #LUNARJETMAN$824A }
; { #PSSST$70DF }
; LIST#

; Frame Update
;
; Used by the routine at #R$6457.
; .
; Called by #R$6463 when the frame counter has changed since the last
; frame update. Runs an extra pass over only the first four actor slots, which
; include Charlie and the sound effect actor, before carrying on with the pass
; which was in progress.
@label=FrameUpdate
c$7160 DI            ; Disable interrupts.
 $7161 LD A,($5C78)  ; {Store #SKOOLKID$5C78(FRAMES) at #R$5F22.
 $7164 LD ($5F22),A  ; }
 $7167 LD A,$01      ; {Set #R$5F23 to #N$01 (frame has updated).
 $7169 LD ($5F23),A  ; }
 $716C PUSH IX       ; Save the pointer to the current actor on the stack.
 $716E LD HL,$5F55   ; {Write #R$5F55 to #N$71AC.
 $7171 LD ($71AC),HL ; }
; #HTML(Self modifying code; this changes the command at #R$71A3(#N$71BE)
; to <strong>JP #R$7198</strong>, so that the extra pass ends there.)
 $7174 LD A,$C3      ; {#HTML(Write #N$C3 to #R$71A3(#N$71BE) and #R$7198 to
 $7176 LD ($71BE),A  ; #R$71A3(#N$71BF), i.e. <strong>JP #R$7198</strong>).
 $7179 LD HL,$7198   ;
 $717C LD ($71BF),HL ; }
 $717F LD IX,$5F35   ; Point #REGix at #R$5F35.
 $7183 JP $6463      ; Jump to #R$6463.
; View the equivalent code in;
; #LIST
; { #JETPAC$6965 }
; { #LUNARJETMAN$8209 }
; { #PSSST$70ED }
; LIST#

; Reset Modified Code
;
; Used by the routines at #R$6428 and #R$7198.
; .
; Puts back the two changes which #R$7160 makes to #R$71A3, so that
; the passes through the actors are normal again.
;
; .
;
; Self modifying code; this updates the address for #REGbc (at
; #R$71A3(#N$71AB)).
@label=ResetModifiedCode
c$7186 LD HL,$5F85   ; {Write #R$5F85 to #R$71A3(#N$71AC).
 $7189 LD ($71AC),HL ; }
; Self modifying code; this updates the command at #R$71A3(#N$71BE) to
; "LD HL, (xx)".
 $718C LD A,$2A      ; {Write #N$2A to #R$71A3(#N$71BE).
 $718E LD ($71BE),A  ; }
; Self modifying code; this updates the address for #REGhl (at
; #R$71A3(#N$71BE)).
 $7191 LD HL,$5F1D   ; {Write #R$5F1D to #R$71A3(#N$71BF).
 $7194 LD ($71BF),HL ; }
 $7197 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #LUNARJETMAN$822F }
; { #PSSST$7113 }
; LIST#

; End Frame Update
;
; Ends the extra pass which was started by #R$7160, putting back the
; changes which were made to the code.
@label=FrameUpdateEnd
c$7198 CALL $7186    ; Reset the self-modifying code using #R$7186.
 $719B POP IX        ; Restore the pointer to the current actor from the stack.
 $719D XOR A         ; {Write #N$00 to #R$5F23.
 $719E LD ($5F23),A  ; }
 $71A1 EI            ; Enable interrupts.
 $71A2 RET           ; Return.

; Next Actor
;
; Every actor handler returns here. Moves on to the next actor, and
; goes back to #R$6463 until the last one has been done. After the last actor
; the game is paused while "SHIFT" is held down, the frame counter at #R$5F1D is
; increased, and the number of actors which were in play is saved in #R$5F1C.
; If there are no actors in play and no ingredients are needed then the level is
; finished. Otherwise the actors are created by #R$71D8.
@label=NextActor
c$71A3 LD DE,$0008   ; {Move on to the next actor by adding #N$0008 to #REGix.
 $71A6 ADD IX,DE     ; }
 $71A8 PUSH IX       ; {Copy the pointer to the actor into #REGhl, using the
 $71AA POP HL        ; stack.}
; #HTML(Self modifying code; the operand of this command is written
; as #N$5F55 by #R$7160 (for the extra pass over the first four actors) and
; as #N$5F85 by #R$7186 (the end of the last actor).)
 $71AB LD BC,$5F85   ; Fetch the address of the end of the actors (#N$5F85).
 $71AE AND A         ; {Subtract the end of the actors from the pointer.
 $71AF SBC HL,BC     ; }
 $71B1 JP C,$6463    ; Jump to #R$6463 if the last actor has not been done yet.
; Holding "SHIFT" pauses the game.
@label=NextActor_Pause
*$71B4 LD A,$FE      ; {Read from the keyboard;
 $71B6 OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $71B8 IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$FE | SHIFT | Z | X | C | V }
                     ; TABLE#}
 $71BA BIT 0,A       ; {Jump to #R$71B4 if key "SHIFT" has been pressed.
 $71BC JR Z,$71B4    ; }
; #HTML(Self modifying code; this command is changed to <strong>JP
; #R$7198</strong> by #R$7160, to end the extra pass over the first four actors,
; and is put back by #R$7186.)
@label=NextActor_FrameCounter
 $71BE LD HL,($5F1D) ; Fetch the frame counter.
 $71C1 INC HL        ; Increase the frame counter by one.
 $71C2 LD ($5F1D),HL ; Update the frame counter.
 $71C5 LD A,($5F1B)  ; Fetch the number of actors in play.
 $71C8 LD ($5F1C),A  ; Remember the number of actors in play for the next pass
                     ; (#R$5F1C).
 $71CB LD B,A        ; Keep the number of actors in play in #REGb.
 $71CC LD A,($5F2F)  ; Fetch the number of ingredients which the active player
                     ; needs.
 $71CF OR B          ; Combine with the number of actors in play.
 $71D0 JR NZ,$71D8   ; Jump to #R$71D8 if there are still actors in play, or ingredients
                     ; needed.
; The level has been finished, so remove all of the actors, and move on to
; the next level.
 $71D2 CALL $713D    ; Remove all of the actors using #R$713D.
 $71D5 CALL $6C3C    ; Set up the next level using #R$6C3C.

; Create Actor
;
; Used by the routine at #R$71A3.
; .
; Creates a new actor from the pantry, if the conditions are right. It is
; not done if six or more actors are in play, if the delay at the start of a
; life is running, if no more ingredients are needed, or if Charlie is not in
; his normal form (ID #N$01 or #N$02). It is also done on average only one pass
; in every #N$20, which is decided with the frame counter and a random number.
; The new actor is made from the template at #R$7279, in the first of the six
; slots from #R$5F55 which is empty. It starts at the right, at the height of
; the shelf in the pantry for the level (#N$2F, #N$47, #N$5F, #N$77 or #N$8F).
; .
; Usually it is the ingredient for the level (see #R$6D7D), but it is one of the
; nasties (the tack, the washer or the bolt) if the number of slots which are
; left (including this one) is not more than the set the level is in (up to a
; maximum of #N$04) plus one. So there are more nasties in the later sets of
; levels. The monster is also created by #R$67E2, if it is not already.
@label=CreateActor
c$71D8 LD A,($5F1B)    ; Fetch the number of actors in play.
 $71DB CP $06          ; {Jump to #R$7211 if there are six actors in play.
 $71DD JR NC,$7211     ; }
 $71DF LD A,($5F1D)    ; {Fetch the frame counter and keep it in #REGb.
 $71E2 LD B,A          ; }
 $71E3 LD A,R          ; Fetch a random number.
 $71E5 ADD A,B         ; Add the frame counter.
 $71E6 AND %00011111   ; Keep only bits 0-4.
 $71E8 JR NZ,$7211     ; Jump to #R$7211 if the result is not zero.
 $71EA LD A,($5F25)    ; Fetch the game delay timer.
 $71ED AND A           ; Is the delay at the start of a life still running?
 $71EE JR NZ,$7211     ; Jump to #R$7211 if it is.
 $71F0 LD A,($5F2F)    ; Fetch the number of ingredients which the active
                       ; player needs.
 $71F3 AND A           ; Are any more ingredients needed?
 $71F4 JR Z,$7211      ; Jump to #R$7211 if not.
 $71F6 LD A,($5F35)    ; Fetch Charlie's ID.
 $71F9 AND %00111111   ; Keep only bits 0-5.
 $71FB DEC A           ; Is Charlie's ID #N$01?
 $71FC JR Z,$7201      ; Jump to #R$7201 if Charlie's ID is #N$01.
 $71FE DEC A           ; Is Charlie's ID #N$02?
 $71FF JR NZ,$7211     ; Jump to #R$7211 if Charlie's ID is not #N$02.
; Find the first empty slot out of the six.
@label=CreateActor_FindSlot
*$7201 LD HL,$5F55     ; Point #REGhl at the first slot for spawned actors.
 $7204 LD B,$06        ; Set the slot counter to #N$06 (the number of slots).
 $7206 LD DE,$0008     ; Set the size of an actor to #N$0008.
@label=CreateActor_FindSlotLoop
*$7209 LD A,(HL)       ; Fetch the actor ID.
 $720A AND A           ; Is the slot empty?
 $720B JP Z,$7214      ; Jump to #R$7214 if it is.
 $720E ADD HL,DE       ; Move on to the next slot.
 $720F DJNZ $7209      ; Decrease the slot counter by one and loop back to #R$7209 until all
                       ; of the slots have been tried.
@label=CreateActor_Finished
*$7211 JP $6457        ; Jump to #R$6457.
; Make the new actor from the template.
@label=CreateActor_Create
*$7214 EX DE,HL        ; Point #REGde at the empty slot.
 $7215 LD HL,$7279     ; Point #REGhl at #R$7279.
 $7218 PUSH BC         ; Save the slot counter on the stack.
 $7219 LD BC,$0008     ; Set the number of bytes to copy to #N$0008.
 $721C PUSH DE         ; Save the address of the slot on the stack.
 $721D LDIR            ; Copy the template into the slot.
 $721F POP IX          ; Point #REGix at the new actor.
 $7221 LD A,$08        ; #REGa=#N$08.
 $7223 LD (IX+$00),A   ; Update the actor ID.
; Work out the height of the shelf in the pantry for the level; it is
; #N$2F + ((#N$18 * the level within the set) AND #N$78).
 $7226 LD A,($5F2D)    ; Fetch the level of the active player.
 $7229 AND %00000111   ; Keep only bits 0-2.
 $722B LD C,A          ; Keep the level within the set in #REGc.
 $722C SLA A           ; Multiply the level within the set by two.
 $722E ADD A,C         ; Add the level within the set, to multiply it by three.
 $722F RLA             ; {Rotate left three times, to multiply it by eight.
 $7230 RLA             ;
 $7231 RLA             ; }
 $7232 AND %01111000   ; Keep only bits 3-6.
 $7234 ADD A,$2F       ; Add #N$2F, to get the height of the shelf.
 $7236 LD (IX+$02),A   ; Set the vertical co-ordinate to the height of the
                       ; shelf.
; Use the ID and the colour of the ingredient for the level.
 $7239 LD HL,$6D7D     ; Point #REGhl at #R$6D7D.
 $723C SLA C           ; Multiply the level within the set by two.
 $723E LD B,$00        ; Set the high byte of the offset to #N$00.
 $7240 ADD HL,BC       ; Find the ingredient for the level.
 $7241 LD A,(HL)       ; Fetch the sprite ID of the ingredient.
 $7242 LD (IX+$00),A   ; Update the actor ID.
 $7245 INC HL          ; Move on to the colour.
 $7246 LD A,(HL)       ; Fetch the colour of the ingredient.
 $7247 LD (IX+$03),A   ; Update the actor colour.
; Decide whether to make it one of the nasties.
 $724A LD A,($5F2D)    ; Fetch the level of the active player.
 $724D SRL A           ; {Divide the level by eight, to get the set of levels.
 $724F SRL A           ;
 $7251 SRL A           ; }
 $7253 POP BC          ; Restore the slot counter from the stack.
 $7254 CP $04          ; {Jump to #R$725A if the set is less than #N$04.
 $7256 JR C,$725A      ; }
 $7258 LD A,$04        ; Limit the set to #N$04.
@label=CreateActor_TestNasty
*$725A INC A           ; Add #N$01.
 $725B SUB B           ; Subtract the slot counter.
 $725C JP M,$7271      ; Jump to #R$7271 if this is an ingredient.
 $725F LD A,R          ; Fetch a random number.
 $7261 AND %00000011   ; Keep only bits 0-1.
 $7263 JR NZ,$7266     ; Jump to #R$7266 if the result is not zero.
 $7265 INC A           ; Increase #REGa by one, so it is in the range #N$01 to
                       ; #N$03.
@label=CreateActor_Nasty
*$7266 SLA A           ; Multiply the result by two.
 $7268 ADD A,$1C       ; Add #N$1C, to get the ID of the tack (#N$1E), the washer (#N$20) or
                       ; the bolt (#N$22).
 $726A LD (IX+$00),A   ; Update the actor ID.
 $726D LD (IX+$03),$45 ; Set the actor colour to #N$45 (cyan).
@label=CreateActor_Draw
*$7271 CALL $7617      ; Draw the actor using #R$7617.
 $7274 CALL $67E2      ; Create the monster using #R$67E2.
 $7277 JR $7211        ; Jump to #R$7211.

; Actor Template
;
; The template for a new actor, which is copied into one of the six slots
; from #R$5F55 by #R$71D8. The ID, the vertical co-ordinate and the colour are
; replaced.
@label=Template_NewActor
b$7279 DEFB $04      ; Actor ID.
 $727A DEFB $DA      ; Horizontal co-ordinate.
 $727B DEFB $2F      ; Vertical co-ordinate (replaced).
 $727C DEFB $46      ; Colour.
 $727D DEFB $FE      ; Horizontal speed (-2).
 $727E DEFB $02      ; Vertical speed.
 $727F DEFB $00      ; Not used.
 $7280 DEFB $00      ; Not used.

; Handle Custard
;
; The handler for the custard (IDs #N$04 and #N$05), which bounces around
; the play area diagonally. It is moved by #R$72A3. While the custard is still
; entering from the right of the screen (a horizontal co-ordinate of #N$C8 or
; more) it can't hit Charlie or be hit, and it is given a random vertical
; speed.
;
; IX Actor
@label=HandleCustard
c$7281 CALL $76D0      ; Record the position of the sprite using #R$76D0.
 $7284 LD HL,$5F1B     ; Point #REGhl at #R$5F1B.
 $7287 INC (HL)        ; Increase the number of actors in play by one.
 $7288 LD A,(IX+$01)   ; Fetch the horizontal co-ordinate.
 $728B CP $C8          ; {Jump to #R$7302 if the custard is still entering from
 $728D JR NC,$7302     ; the right.}
 $728F CALL $6A46      ; Test whether the custard has hit Charlie using
                       ; #R$6A46.
 $7292 DEC E           ; Has Charlie been hit (is #REGe now zero)?
 $7293 JP Z,$6A73      ; Jump to #R$6A73 if Charlie has been hit.
 $7296 CALL $7317      ; Test whether a flour shot has hit the custard using
                       ; #R$7317.
 $7299 BIT 7,(IX+$00)  ; {Jump to #R$730D if the custard has been hit.
 $729D JR NZ,$730D     ; }
 $729F LD (IX+$03),$46 ; Set the actor colour to #N$46 (yellow).

; Move Bouncing Actor
;
; Used by the routine at #R$6A05.
; .
; Moves the actor by the speeds in bytes #N$04 and #N$05 of the actor,
; changing them to #N$02 or #N$FE (-2) when the actor reaches the edge of the
; play area. Bit 0 of byte #N$06 is set while the actor is moving down, and
; bit 1 is set while it is moving right. The ID of the actor is changed
; between its two frames, and the sprite is then drawn in its new position.
;
; IX Actor
@label=MoveBouncingActor
c$72A3 LD A,(IX+$02)   ; Fetch the vertical co-ordinate.
 $72A6 ADD A,(IX+$05)  ; Add the vertical speed.
 $72A9 CP $21          ; {Jump to #R$72DA if the actor has reached the top.
 $72AB JR C,$72DA      ; }
 $72AD CP $A0          ; {Jump to #R$72EE if the actor has reached the bottom.
 $72AF JR NC,$72EE     ; }
 $72B1 LD (IX+$02),A   ; Update the vertical co-ordinate.
; This entry point is used by the routines at #R$6930 and #R$7302.
@label=MoveBouncingActor_Horizontal
*$72B4 LD A,(IX+$01)   ; Fetch the horizontal co-ordinate.
 $72B7 ADD A,(IX+$04)  ; Add the horizontal speed.
 $72BA LD (IX+$01),A   ; Update the horizontal co-ordinate.
 $72BD CP $04          ; {Jump to #R$72E4 if the actor has reached the left
 $72BF JR C,$72E4      ; edge.}
 $72C1 CP $C0          ; {Jump to #R$72F8 if the actor has reached the right
 $72C3 JR NC,$72F8     ; edge.}
@label=MoveBouncingActor_Animate
*$72C5 INC (IX+$07)    ; Increase the frame counter (byte #N$07 of the actor)
                       ; by one.
 $72C8 LD A,(IX+$07)   ; Fetch the frame counter.
 $72CB RRA             ; Shift #REGa right.
 $72CC AND %00000001   ; Keep only bit 0.
 $72CE XOR (IX+$00)    ; Flip bit 0 of the actor ID if bit 1 of the frame
                       ; counter is set.
 $72D1 LD (IX+$00),A   ; Update the actor ID.
; This entry point is used by the routines at #R$669B and #R$730D.
@label=MoveBouncingActor_Draw
*$72D4 CALL $75CC      ; Erase the sprite and draw it in its new position using
                       ; #R$75CC.
 $72D7 JP $74EE        ; Jump to #R$74EE to colour the sprite.
; The actor has reached the top, so make it move down.
@label=MoveBouncingActor_Top
*$72DA LD (IX+$05),$02 ; Set the vertical speed to #N$02 (moving down).
 $72DE SET 0,(IX+$06)  ; Set bit 0 of byte #N$06 of the actor.
 $72E2 JR $72B4        ; Jump to #R$72B4.
; The actor has reached the left edge, so make it move right.
@label=MoveBouncingActor_LeftEdge
*$72E4 LD (IX+$04),$02 ; Set the horizontal speed to #N$02 (moving right).
 $72E8 SET 1,(IX+$06)  ; Set bit 1 of byte #N$06 of the actor.
 $72EC JR $72C5        ; Jump to #R$72C5.
; The actor has reached the bottom, so make it move up.
@label=MoveBouncingActor_Bottom
*$72EE LD (IX+$05),$FE ; Set the vertical speed to #N$FE (moving up).
 $72F2 RES 0,(IX+$06)  ; Reset bit 0 of byte #N$06 of the actor.
 $72F6 JR $72B4        ; Jump to #R$72B4.
; The actor has reached the right edge, so make it move left.
@label=MoveBouncingActor_RightEdge
*$72F8 LD (IX+$04),$FE ; Set the horizontal speed to #N$FE (moving left).
 $72FC RES 1,(IX+$06)  ; Reset bit 1 of byte #N$06 of the actor.
 $7300 JR $72C5        ; Jump to #R$72C5.

; Set Custard Vertical Speed
;
; Used by the routine at #R$7281.
; .
; Part of #R$7281, used while the custard is still entering from the
; right of the screen. Gives the actor a random vertical speed (#N$02 or #N$FE),
; and then only moves it horizontally.
;
; IX Actor
@label=SetCustardVerticalSpeed
c$7302 LD A,R        ; Fetch a random number.
 $7304 AND %00000100 ; Keep only bit 2.
 $7306 SUB $02       ; Subtract #N$02, so that the speed is #N$FE or #N$02.
 $7308 LD (IX+$05),A ; Update the vertical speed.
 $730B JR $72B4      ; Jump to #R$72B4.

; Handle Hit Actor
;
; Used by the routines at #R$669B, #R$6765, #R$6930, #R$6996, #R$69D4, #R$6CB7
; and #R$7281.
; .
; Moves an actor which has been hit by a flour shot using #R$6E25. If the
; actor has not been removed then it is drawn in its new position.
;
; IX Actor
@label=HandleHitActor
c$730D CALL $6E25    ; Move the actor using #R$6E25.
 $7310 LD A,(IX+$00) ; Fetch the actor ID.
 $7313 AND A         ; Has the actor been removed?
 $7314 RET Z         ; Return if it has.
 $7315 JR $72D4      ; Jump to #R$72D4.

; Test Flour Collision
;
; Used by the routines at #R$6607, #R$669B, #R$6765, #R$6930, #R$6996, #R$69D4,
; #R$6CB7 and #R$7281.
; .
; Tests whether the actor has been hit by a flour shot (they are in the
; two actor slots after Charlie). A shot is within range if it is between #N$0A
; pixels to the left and #N$12 pixels to the right of the actor, and between
; #N$12 pixels above and #N$0A pixels below it. If it is then the actor is
; coloured white, bit 7 of its ID is set and the counter in byte #N$07 is set
; to #N$40. The speeds of the shot are copied to the actor, the shot is made to
; explode, and the rising tone is played.
;
; IX Actor
@label=TestFlourCollision
c$7317 LD DE,$0008     ; Set the size of an actor to #N$0008.
 $731A LD HL,$5F3D     ; Point #REGhl at #R$5F3D.
 $731D LD B,$02        ; Set the slot counter to #N$02 (the number of slots for
                       ; flour shots).
@label=TestFlourCollision_Loop
*$731F PUSH HL         ; Stash the address of the slot on the stack.
 $7320 LD A,(HL)       ; Fetch the actor ID of the slot.
 $7321 AND A           ; Is the slot empty?
 $7322 JR Z,$734E      ; Jump to #R$734E if it is.
 $7324 CP $26          ; {Jump to #R$734E if the shot has exploded.
 $7326 JR NC,$734E     ; }
 $7328 INC HL          ; Move on to the horizontal co-ordinate of the shot.
 $7329 LD A,(HL)       ; Fetch the horizontal co-ordinate of the shot.
 $732A SUB (IX+$01)    ; Subtract the horizontal co-ordinate of the actor.
 $732D JP P,$7336      ; Jump to #R$7336 if the shot is to the right of the
                       ; actor.
 $7330 NEG             ; Make the distance positive.
 $7332 LD C,$0A        ; Set the distance which is allowed to the left to
                       ; #N$0A.
 $7334 JR $7338        ; Jump to #R$7338.
@label=TestFlourCollision_Right
*$7336 LD C,$12        ; Set the distance which is allowed to the right to
                       ; #N$12.
@label=TestFlourCollision_Horizontal
*$7338 CP C            ; Compare the distance with the distance which is
                       ; allowed.
 $7339 JR NC,$734E     ; Jump to #R$734E if the shot is too far away.
 $733B INC HL          ; Move on to the vertical co-ordinate of the shot.
 $733C LD A,(HL)       ; Fetch the vertical co-ordinate of the shot.
 $733D SUB (IX+$02)    ; Subtract the vertical co-ordinate of the actor.
 $7340 JP P,$7349      ; Jump to #R$7349 if the shot is below the actor.
 $7343 NEG             ; Make the distance positive.
 $7345 LD C,$12        ; Set the distance which is allowed above to #N$12.
 $7347 JR $734B        ; Jump to #R$734B.
@label=TestFlourCollision_Below
*$7349 LD C,$0A        ; Set the distance which is allowed below to #N$0A.
@label=TestFlourCollision_Vertical
*$734B CP C            ; Compare the distance with the distance which is
                       ; allowed.
 $734C JR C,$7353      ; Jump to #R$7353 if the shot has hit the actor.
@label=TestFlourCollision_Next
*$734E POP HL          ; Restore the address of the slot from the stack.
 $734F ADD HL,DE       ; Move on to the next slot.
 $7350 DJNZ $731F      ; Decrease the slot counter by one and loop back to #R$731F until
                       ; both slots have been tried.
 $7352 RET             ; Return.
; The shot has hit the actor.
@label=TestFlourCollision_Hit
*$7353 LD (IX+$03),$47 ; Set the actor colour to #N$47 (white).
 $7357 SET 7,(IX+$00)  ; Set bit 7 of the actor ID.
 $735B LD (IX+$07),$40 ; Set the hit counter (byte #N$07 of the actor) to
                       ; #N$40.
 $735F INC HL          ; {Move on to the horizontal speed of the shot.
 $7360 INC HL          ; }
 $7361 LD A,(HL)       ; Fetch the horizontal speed of the shot.
 $7362 LD (IX+$04),A   ; Update the horizontal speed of the actor.
 $7365 INC HL          ; Move on to the vertical speed of the shot.
 $7366 LD A,(HL)       ; Fetch the vertical speed of the shot.
 $7367 LD (IX+$05),A   ; Update the vertical speed of the actor.
 $736A POP HL          ; Restore the address of the shot from the stack.
 $736B PUSH IX         ; Save the pointer to the current actor on the stack.
 $736D PUSH HL         ; Save the address of the shot on the stack.
 $736E POP IX          ; Point #REGix at the shot.
 $7370 CALL $6FA4      ; Make the shot explode using #R$6FA4.
 $7373 POP IX          ; Restore the pointer to the current actor from the
                       ; stack.
 $7375 JP $683E        ; Jump to #R$683E to play the rising tone.

; Display Lives
;
; Used by the routines at #R$5FE1 and #R$6FFD.
; .
; Shows the number of lives which each of the players has, at the top of
; the screen; the number is followed by the icon for a life. If a player has no
; lives then their space is blanked. Charlie's last movement (#R$5F2B) is also
; reset to be #N$02 pixels to the right.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$6298,stop=$62B5,clear=1,sp=$5F00)
; #POKES$5F0D,$01
; #SIM(start=$6428,stop=$6457,sp=$5F00)
; #SIM(start=$5FED,stop=$5FF0,sp=$5F00)
; #SCR$04,$00,$00,$0C,$02(display-lives-before)
; | #SIM(start=$7378,stop=$0000,sp=$5E00)
; #SCR$04,$00,$00,$0C,$02(display-lives-after) } UDGTABLE# #POPS
@label=DisplayPlayerLives
c$7378 LD HL,$0002   ; {Write #N($0002, $04, $04) to #R$5F2B (Charlie's last
 $737B LD ($5F2B),HL ; movement).}
; Controller for 1UP lives.
@label=DisplayPlayerLives_1UP
 $737E LD HL,$0040   ; {Call #R$76E3 with #N($0040, $04, $04) (the pixel co-ordinates for
 $7381 CALL $76E3    ; the 1UP lives) to get the screen address.}
 $7384 CALL $73BD    ; Fetch the lives of 1UP using #R$73BD.
 $7387 AND A         ; {If 1UP lives are zero, jump to #R$73A6.
 $7388 JR Z,$73A6    ; }
 $738A CALL $7399    ; Else, there are lives to display so call #R$7399.
; Controller for 2UP lives.
@label=Controller2UPLives
*$738D LD HL,$00B0   ; {Call #R$76E3 with #N($00B0, $04, $04) (the pixel co-ordinates for
 $7390 CALL $76E3    ; the 2UP lives) to get the screen address.}
 $7393 CALL $73CB    ; Fetch the lives of 2UP using #R$73CB.
 $7396 AND A         ; {If 2UP lives are zero, jump to #R$73AB.
 $7397 JR Z,$73AB    ; }
; Handles displaying the lives count and UDG character.
@label=HandlerDisplayLives
*$7399 ADD A,$30     ; Add #N$30 to convert to an ASCII character (starting at
                     ; "0").
 $739B CALL $7468    ; Print the digit using #R$7468.
 $739E LD DE,$73B5   ; Point #REGde at the lives icon (#R$73B5).
 $73A1 PUSH BC       ; {Stash #REGbc and #REGde on the stack.
 $73A2 PUSH DE       ; }
 $73A3 JP $7478      ; Jump to #R$7478 to print the icon.
; 1UP has no lives.
@label=Handler1UPNoLives
*$73A6 CALL $73AB    ; Print two spaces using #R$73AB.
 $73A9 JR $738D      ; Jump to #R$738D.
; 2UP has no lives.
@label=Handler2UPNoLives
*$73AB LD A,$20      ; Fetch a space.
 $73AD CALL $7468    ; Print the space using #R$7468.
 $73B0 LD A,$20      ; Fetch a space.
 $73B2 JP $7468      ; Print a second space using #R$7468.
; View the equivalent code in;
; #LIST
; { #JETPAC$70A4 }
; { #LUNARJETMAN$894F }
; { #PSSST$7325 }
; { #SABREWULF$B7CD }
; { #TRANZAM$687B }
; LIST#

; The UDG for the lives icon
;
; The icon for a life, which is printed after the number of lives.
@label=UDG_Life
b$73B5 DEFB %00011000 ; {#UDGTABLE(default,centre) { #UDG#(#PC),attr=$07 }
 $73B6 DEFB %00100100 ; UDGTABLE#
 $73B7 DEFB %00111100 ;
 $73B8 DEFB %01111110 ;
 $73B9 DEFB %01011010 ;
 $73BA DEFB %00111100 ;
 $73BB DEFB %00111100 ;
 $73BC DEFB %01100110 ; }

; Fetch 1UP Lives
;
; Used by the routine at #R$7378.
; .
; Returns the number of lives which the 1UP player has.
;
; O:A Lives
@label=FetchLives_1UP
c$73BD LD A,($5F21)  ; {If #R$5F21 is not zero then jump to #R$73C7.
 $73C0 AND A         ;
 $73C1 JR NZ,$73C7   ; }
; This entry point is used by the routine at #R$73CB.
; .
; Return currently active players lives left.
@label=ActivePlayerLives
*$73C3 LD A,($5F2E)  ; Fetch the lives of the active player.
 $73C6 RET           ; Return.
; This entry point is used by the routine at #R$73CB.
; .
; Return inactive players lives left.
@label=InactivePlayerLives
*$73C7 LD A,($5F32)  ; Fetch the lives of the inactive player.
 $73CA RET           ; Return.

; Fetch 2UP Lives
;
; Used by the routine at #R$7378.
; .
; Returns the number of lives which the 2UP player has.
;
; O:A Lives
@label=FetchLives_2UP
c$73CB LD A,($5F21)  ; {If #R$5F21 is zero then jump to #R$73C7.
 $73CE AND A         ;
 $73CF JR Z,$73C7    ; }
 $73D1 JR $73C3      ; Jump to #R$73C3.

; Check High Score
;
; Used by the routine at #R$6C0A.
; .
; Finds which of the 1UP score and the 2UP score is higher, and if it is
; higher than the high score (#R$5F09) then it becomes the new high score.
@label=CheckHighScore
c$73D3 LD HL,($5F0E) ; Fetch the first two bytes of the 1UP score.
 $73D6 LD DE,($5F11) ; Fetch the first two bytes of the 2UP score.
 $73DA LD A,L        ; {Swap the bytes of #REGhl and #REGde, so the most significant byte of
 $73DB LD L,H        ; each is first.
 $73DC LD H,A        ;
 $73DD LD A,E        ;
 $73DE LD E,D        ;
 $73DF LD D,A        ; }
 $73E0 AND A         ; {Subtract the 2UP score from the 1UP score.
 $73E1 SBC HL,DE     ; }
 $73E3 JR C,$73F1    ; Jump to #R$73F1 if the 2UP score is higher.
 $73E5 JR NZ,$7410   ; Jump to #R$7410 if the 1UP score is higher.
 $73E7 LD A,($5F10)  ; {Compare #R$5F10 against #R$5F13.
 $73EA LD E,A        ;
 $73EB LD A,($5F13)  ;
 $73EE CP E          ; }
 $73EF JR C,$7410    ; Jump to #R$7410 if the 1UP score is higher.
@label=CheckHighScore_2UP
*$73F1 LD HL,$5F11   ; Point #REGhl at the 2UP score.
@label=CheckHighScore_Compare
*$73F4 PUSH HL       ; Stash the address of the score on the stack.
 $73F5 LD DE,$5F09   ; Point #REGde at #R$5F09.
 $73F8 LD B,$03      ; Set the byte counter to #N$03 (scores are held in three
                     ; bytes).
@label=CheckHighScore_Loop
*$73FA LD A,(DE)     ; Fetch a byte of the high score.
 $73FB CP (HL)       ; Compare with the same byte of the score.
 $73FC JR C,$7406    ; Jump to #R$7406 if the high score is lower.
 $73FE JR NZ,$7404   ; Jump to #R$7404 if the high score is higher.
 $7400 INC HL        ; Move on to the next byte of the score.
 $7401 INC DE        ; Move on to the next byte of the high score.
 $7402 DJNZ $73FA    ; Decrease the byte counter by one and loop back to #R$73FA until all
                     ; of the bytes have been compared.
@label=CheckHighScore_Finish
*$7404 POP HL        ; Restore the address of the score from the stack.
 $7405 RET           ; Return.
; The high score has been beaten.
@label=CheckHighScore_New
*$7406 POP HL        ; Restore the address of the score from the stack.
 $7407 LD DE,$5F09   ; Point #REGde at #R$5F09.
 $740A LD BC,$0003   ; Set the number of bytes to copy to #N$0003.
 $740D LDIR          ; Copy the score to the high score.
 $740F RET           ; Return.
@label=CheckHighScore_1UP
*$7410 LD HL,$5F0E   ; Point #REGhl at the 1UP score.
 $7413 JR $73F4      ; Jump to #R$73F4.
; View the equivalent code in;
; #LIST
; { #JETPAC$6398 }
; { #TRANZAM$605B }
; LIST#

; Add Points To Score
;
; Used by the routines at #R$6607, #R$6C3C, #R$6EF5 and #R$6F16.
; .
; Adds points to the score of the active player, and then prints that
; score.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After #N$0250 points }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$6298,stop=$62B5,clear=1,sp=$5F00)
; #POKES$5F0D,$01
; #SIM(start=$62B5,stop=$62BC,sp=$5F00)
; #SCR$04,$00,$00,$0A,$02(add-points-before)
; | #SIM(start=$7415,stop=$0000,bc=$0250,sp=$5E00)
; #SCR$04,$00,$00,$0A,$02(add-points-after) } UDGTABLE# #POPS
;
; BC Points to add to score (in BCD)
;
; Check the active player.
@label=AddPointsToScore
c$7415 LD A,($5F21)  ; {If #R$5F21 is not zero, jump to #R$7420.
 $7418 AND A         ;
 $7419 JR NZ,$7420   ; }
; Set the score address for 1UP.
 $741B LD HL,$5F10   ; Point #REGhl at the last byte of the 1UP score.
 $741E JR $7423      ; Jump to #R$7423.
; Set the score address for 2UP.
@label=AddPointsToScore_2UP
*$7420 LD HL,$5F13   ; Point #REGhl at the last byte of the 2UP score.
; Process adding the points to the appropriate score.
@label=AddPointsToScore_Start
*$7423 LD A,(HL)     ; Fetch the last byte of the score.
 $7424 ADD A,C       ; {Add the points in #REGc (in BCD).
 $7425 DAA           ; }
 $7426 LD (HL),A     ; Update the last byte of the score.
 $7427 DEC HL        ; Move on to the middle byte of the score.
 $7428 LD A,(HL)     ; Fetch the middle byte of the score.
 $7429 ADC A,B       ; {Add the points in #REGb (in BCD), with the carry.
 $742A DAA           ; }
 $742B LD (HL),A     ; Update the middle byte of the score.
 $742C DEC HL        ; Move on to the first byte of the score.
 $742D LD A,(HL)     ; Fetch the first byte of the score.
 $742E ADC A,$00     ; {Add the carry (in BCD).
 $7430 DAA           ; }
 $7431 LD (HL),A     ; Update the first byte of the score.
; Check the active player.
 $7432 LD A,($5F21)  ; {If #R$5F21 is not zero, jump to #R$7440.
 $7435 AND A         ;
 $7436 JR NZ,$7440   ; }
; View the equivalent code in;
; #LIST
; { #ATICATAC$A19C }
; { #JETPAC$70F9 }
; { #LUNARJETMAN$899C }
; { #PSSST$737A }
; { #SABREWULF$B5A9 }
; { #TRANZAM$6046 }
; { #UNDERWURLDE$A045 }
; LIST#

; Print Scores
;
; Used by the routine at #R$5FB7.
; .
; Prints a score, as six digits, on the screen. This routine is entered
; at #R$7438 to print the 1UP score, at #R$7440 to print the 2UP score and at
; #R$7448 to print the high score.
; #PUSHS #UDGTABLE(default,centre)
; { =h Before }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$6298,stop=$62B5,clear=1,sp=$5F00)
; #POKES$5F0D,$01
; #SIM(start=$62B5,stop=$62BC,sp=$5F00)
; #SCR$02,$00,$00,$20,$02(print-scores-before) }
; { =h After }
; { #POKES$5F0F,$12;$5F10,$50;$5F0A,$99;$5F0B,$50;$5F12,$08
; #SIM(start=$7438,stop=$0000,sp=$5E00)
; #SIM(start=$7440,stop=$0000,sp=$5E00)
; #SIM(start=$7448,stop=$0000,sp=$5E00)
; #SCR$02,$00,$00,$20,$02(print-scores-after) } UDGTABLE# #POPS
;
; .
;
; Sets up the 1UP score.
@label=Score_1UP
c$7438 LD HL,$4021   ; Set the screen buffer address for the 1UP score
                     ; (#N$4021).
 $743B LD DE,$5F0E   ; Point #REGde at #R$5F0E.
 $743E JR $744E      ; Jump to #R$744E.
; This entry point is used by the routines at #R$5FB7 and #R$7415.
; .
; Sets up the 2UP score.
@label=Score_2UP
*$7440 LD HL,$4039   ; Set the screen buffer address for the 2UP score
                     ; (#N$4039).
 $7443 LD DE,$5F11   ; Point #REGde at #R$5F11.
 $7446 JR $744E      ; Jump to #R$744E.
; This entry point is used by the routine at #R$5FB7.
; .
; Sets up the HI score.
@label=Score_HI
*$7448 LD HL,$402D   ; Set the screen buffer address for the HI score
                     ; (#N$402D).
 $744B LD DE,$5F09   ; Point #REGde at #R$5F09.
; Prints the score.
@label=PrintScore
*$744E LD B,$03      ; Set the byte counter to #N$03.
; This entry point is used by the routine at #R$6C88.
@label=PrintScore_Loop
*$7450 LD A,(DE)     ; Fetch a byte of the score.
 $7451 RRCA          ; {Shift the tens digit down (divide by #N$10).
 $7452 RRCA          ;
 $7453 RRCA          ;
 $7454 RRCA          ; }
 $7455 AND %00001111 ; Keep only bits 0-3.
 $7457 ADD A,$30     ; Convert the digit to ASCII (add #N$30, which is "0").
 $7459 CALL $7468    ; Print the digit using #R$7468.
 $745C LD A,(DE)     ; Fetch the byte of the score again.
 $745D AND %00001111 ; Keep only bits 0-3.
 $745F ADD A,$30     ; Convert the digit to ASCII (add #N$30, which is "0").
 $7461 CALL $7468    ; Print the digit using #R$7468.
 $7464 INC DE        ; Move on to the next byte of the score.
 $7465 DJNZ $7450    ; Decrease the byte counter by one and loop back to #R$7450 until all
                     ; three bytes have been printed.
 $7467 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$A1AE }
; { #JETPAC$711C }
; { #LUNARJETMAN$89BF }
; { #PSSST$739D }
; { #SABREWULF$B5CC }
; { #TRANZAM$6CB6 }
; LIST#

; Print Character
;
; Used by the routines at #R$6017, #R$60E2, #R$7378, #R$7438 and #R$7488.
; .
; Prints a character on the screen, using the character set at #N$5C36
; (CHARS), as eight rows of pixels. The screen address is then moved on by one
; column, ready to print the next character.
;
;   A ASCII value to print
;   HL Screen address
; O:HL Screen address of the next character
@label=PrintScreen
c$7468 PUSH BC       ; {Save the registers on the stack.
 $7469 PUSH DE       ;
 $746A PUSH HL       ; }
 $746B LD L,A        ; {Create an offset in #REGhl.
 $746C LD H,$00      ; }
 $746E ADD HL,HL     ; {Multiply by #N$08, as there are eight bytes for each
 $746F ADD HL,HL     ; character.
 $7470 ADD HL,HL     ; }
 $7471 LD DE,($5C36) ; Fetch the address of the font (#SKOOLKID$5C36(CHARS)).
 $7475 ADD HL,DE     ; {#REGde=#REGhl + #N$3C00. For examples of usage;
 $7476 EX DE,HL      ; #TABLE(default,centre,centre,centre,centre,centre)
                     ; { =h Letter | =h ASCII Value | =h * 8 (offset) | =h CHARS + offset }
                     ; #FOREACH($55,$4C,$54,$49,$4D,$41,$54,$45)(value,
                     ; { #LET(result=$3C00 + value * $08) "#CHR(value)" | #N(value) | #N(value * 8) | #SKOOLKID($3D00,{result})(#N({result})) }
                     ; )
                     ; TABLE#}
; Print the character to the screen.
 $7477 POP HL        ; Restore #REGhl, containing the screen buffer location,
                     ; from the stack.
; This entry point is used by the routine at #R$7378.
@label=PrintCharacter_Draw
*$7478 LD B,$08      ; Set the pixel row counter to #N$08 (#N$08 rows of
                     ; pixels).
@label=PrintScreen_Loop
*$747A LD A,(DE)     ; {Copy a byte from the font data to the screen buffer.
 $747B LD (HL),A     ; }
 $747C INC DE        ; Move on to the next byte of the font data.
 $747D INC H         ; Move onto the next pixel line.
 $747E DJNZ $747A    ; Decrease the pixel row counter by one and loop back to #R$747A until
                     ; all eight rows have been copied.
 $7480 POP DE        ; {Restore the registers from the stack.
 $7481 POP BC        ; }
; Reset #REGhl and move to the next column, ready to print the next character.
 $7482 LD A,H        ; {Move back to the top pixel row of the character cell
 $7483 SUB $08       ; (subtract #N$08 from #REGh).
 $7485 LD H,A        ; }
 $7486 INC L         ; Increment screen column by one.
 $7487 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$A1D3 }
; { #JETPAC$714C }
; { #LUNARJETMAN$89EF }
; { #MARTIANOIDS$B5CB }
; { #NIGHTSHADE$CB19 }
; { #PSSST$73CD }
; { #SABREWULF$B589 }
; { #TRANZAM$6C96 }
; { #UNDERWURLDE$98DF }
; LIST#

; Print Colour String
;
; Used by the routines at #R$6017, #R$6332, #R$6BE0 and #R$74AE.
; .
; Prints a string of text, in colour, at the given position. The first
; byte of the string is the colour attribute, followed by the characters of the
; text. The last character of the string has bit 7 set.
;
; DE Pointer to string data
; HL Pixel co-ordinates (horizontal in #REGl, vertical in #REGh)
@label=PrintStringColour
c$7488 PUSH HL       ; Save the position of the string on the stack.
 $7489 CALL $76E3    ; Convert the pixel co-ordinates into a screen buffer address using
                     ; #R$76E3.
 $748C LD A,(DE)     ; Fetch the attribute byte.
 $748D EX AF,AF'     ; Switch to the shadow #REGaf register.
 $748E INC DE        ; Move on to the text of the string.
 $748F EXX           ; Switch to the shadow registers.
 $7490 POP HL        ; Restore the position of the string from the stack.
 $7491 CALL $7534    ; Calculate the attribute buffer address using #R$7534.
; This entry point is used by the routine at #R$63E0.
@label=PrintString_Loop
*$7494 EXX           ; Switch back to the normal registers.
 $7495 LD A,(DE)     ; Fetch the character to print.
 $7496 BIT 7,A       ; {If bit 7 is set (which signifies the end of the
 $7498 JR NZ,$74A5   ; string), jump to #R$74A5.}
 $749A CALL $7468    ; Print the character using #R$7468.
 $749D INC DE        ; Move on to the next character of the string.
 $749E EXX           ; Switch to the shadow registers.
 $749F EX AF,AF'     ; Switch to the shadow #REGaf register.
 $74A0 LD (HL),A     ; Write the colour to the attribute buffer.
 $74A1 INC L         ; Move on to the next attribute cell.
 $74A2 EX AF,AF'     ; Switch to the shadow #REGaf register.
 $74A3 JR $7494      ; Jump to #R$7494.
; Because the last character contains the terminator, it needs to be handled
; separately.
@label=PrintString_LastCharacter
*$74A5 AND %01111111 ; Keep only bits 0-6 (i.e. strip the bit 7 terminator).
 $74A7 CALL $7468    ; Print the last character using #R$7468.
 $74AA EXX           ; Switch to the shadow registers.
 $74AB EX AF,AF'     ; Switch to the shadow #REGaf register.
 $74AC LD (HL),A     ; Write the colour to the attribute buffer.
 $74AD RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$A1F3 }
; { #JETPAC$716C }
; { #LUNARJETMAN$8A11 }
; { #PSSST$73ED }
; { #SABREWULF$B53D }
; { #TRANZAM$6518 }
; { #UNDERWURLDE$9C3C }
; LIST#

; Print Banner
;
; Used by the routine at #R$5FB7.
; .
; Prints the "1UP", "HI" and "2UP" labels at the top of the screen.
; #PUSHS #UDGTABLE(default,centre)
; { =h Before }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$6298,stop=$62B5,clear=1,sp=$5F00)
; #POKES$5F0D,$01
; #SIM(start=$5FB7,stop=$5FBD,sp=$5F00)
; #SCR$02,$00,$00,$20,$01(print-banner-before) }
; { =h After }
; { #SIM(start=$74AE,stop=$0000,sp=$5E00)
; #SCR$02,$00,$00,$20,$01(print-banner-after) } UDGTABLE# #POPS
;
; .
;
; Prints "1UP".
@label=PrintBanner
c$74AE LD HL,$0018   ; Set the position of the "1UP" label to #N($0018, 4, 4).
 $74B1 LD DE,$74C9   ; Point #REGde at #R$74C9.
 $74B4 CALL $7488    ; Print the "1UP" label using #R$7488.
; Prints "HI".
 $74B7 LD HL,$0078   ; Set the position of the "HI" label to #N($0078, 4, 4).
 $74BA LD DE,$74D1   ; Point #REGde at #R$74D1.
 $74BD CALL $7488    ; Print the "HI" label using #R$7488.
; Prints "2UP".
 $74C0 LD HL,$00D8   ; Set the position of the "2UP" label to #N($00D8, 4, 4).
 $74C3 LD DE,$74CD   ; Point #REGde at #R$74CD.
 $74C6 JP $7488      ; Print the "2UP" label using #R$7488.
; View the equivalent code in;
; #LIST
; { #JETPAC$7192 }
; { #LUNARJETMAN$8A37 }
; { #PSSST$7413 }
; { #SABREWULF$B563 }
; LIST#

; Banner Text
;
; The text of the labels printed by #R$74AE. Each string starts with its
; colour attribute, and the last character has bit 7 set.
@label=1UP_Text
t$74C9 DEFM $47          ; {"1UP" (#COLOUR(#PEEK(#PC)) is the attribute).
 $74CA DEFM "1U","P"+$80 ; }
@label=2UP_Text
 $74CD DEFM $47          ; {"2UP" (#COLOUR(#PEEK(#PC)) is the attribute).
 $74CE DEFM "2U","P"+$80 ; }
@label=HI_Text
 $74D1 DEFM $78          ; {"HI" (#COLOUR(#PEEK(#PC)) is the attribute).
 $74D2 DEFM "H","I"+$80  ; }

; Reset Screen Buffer
;
; Used by the routines at #R$5FB7, #R$6428 and #R$6D45.
; .
; Clears the screen buffer by filling it with zero.
@label=ResetScreen
c$74D4 LD HL,$4000   ; Point #REGhl at the start of the screen buffer.
 $74D7 LD B,$58      ; Set the end of the screen buffer
                     ; (#N$58, the start of the attributes).
@label=ResetScreen_Fill
 $74D9 LD C,$00      ; Set the byte to write to #N$00 (blank).
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CE60 }
; { #ATICATAC$80B4 }
; { #CYBERUN$9A7E }
; { #GUNFRIGHT$D6DB }
; { #JETPAC$71B8 }
; { #KNIGHTLORE$D544 }
; { #LUNARJETMAN$84AD }
; { #NIGHTSHADE$E5A8 }
; { #PSSST$7439 }
; { #SABREWULF$BB81 }
; { #TRANZAM$7211 }
; LIST#
; .
; Continue on to #R$74DB to blank the screen buffer.

; Fill Memory
;
; Used by the routine at #R$74E2.
; .
; Writes the same byte to every address from the target address up to
; the end address.
;
; HL Target address
; B Single byte representing the MSB of the end address (will always end on LSB
; . #N$00)
; C Value to write
@label=ResetCopier
c$74DB LD (HL),C     ; Write the byte to the buffer.
 $74DC INC HL        ; Move on to the next address.
 $74DD LD A,H        ; {Are we finished yet? Check the MSB of the target vs.
 $74DE CP B          ; #REGb.}
 $74DF JR C,$74DB    ; Keep looping back to #R$74DB until there is no
                     ; carry-over.
 $74E1 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$80BB }
; { #JETPAC$71BF }
; { #LUNARJETMAN$84B4 }
; { #PSSST$7440 }
; { #SABREWULF$BB88 }
; { #TRANZAM$7218 }
; LIST#

; Reset Attribute Buffer
;
; Used by the routines at #R$5FB7, #R$6428 and #R$6D45.
; .
; Sets the border to black, and clears the attribute buffer by filling it
; with zero (black ink on a black paper).
@label=ResetAttributes
c$74E2 XOR A         ; {Set the border to #INK$00.
 $74E3 OUT ($FE),A   ; }
 $74E5 LD HL,$5800   ; Point #REGhl at the start of the attribute buffer.
 $74E8 LD B,$5B      ; Set the end of the attribute buffer (#N$5B).
 $74EA LD C,$00      ; Set the byte to write to #N$00 (black).
 $74EC JR $74DB      ; Jump to #R$74DB.
; View the equivalent code in;
; #LIST
; { #ATICATAC$80C2 }
; { #JETPAC$71C6 }
; { #LUNARJETMAN$84BB }
; { #PSSST$7447 }
; { #TRANZAM$7200 }
; LIST#

; Colour Sprite
;
; Used by the routines at #R$64F4, #R$654C, #R$65E8, #R$6639, #R$6765, #R$6AA0,
; #R$6B18, #R$6B8B, #R$6CB7, #R$6D89, #R$6F78, #R$706B and #R$72A3.
; .
; Colours the character cells covered by the actor sprite prepared by
; #R$7584, using the colour in byte #N$03 of the actor. Cells outside of the
; attribute buffer, or to the right of the play area, are left alone.
;
; IX Actor
;
; Fetch the address of the first attribute cell, and the size of the
; area to colour.
@label=ColourSprite
c$74EE EXX           ; Switch to the shadow registers.
 $74EF LD HL,($5F1F) ; Fetch the position of the actor sprite (#R$5F1F).
 $74F2 CALL $7534    ; Calculate the attribute buffer address using #R$7534.
 $74F5 LD A,($5F18)  ; Fetch the width of the actor sprite (#R$5F18).
 $74F8 LD B,A        ;
 $74F9 LD A,($5F17)  ; Fetch the number of rows of the actor sprite (#R$5F17).
 $74FC RRCA          ; {Divide by #N$04 (rotating the bits).
 $74FD RRCA          ; }
 $74FE INC A         ; Increment #REGa by one.
 $74FF RRCA          ; Divide by #N$02 (rotating the bits).
 $7500 AND %00011111 ; Keep only bits 0-4.
 $7502 INC A         ; Increment #REGa by one.
 $7503 LD C,A        ; Store the number of attribute rows to colour in #REGc.
 $7504 LD D,(IX+$03) ; Fetch the actor colour.
 $7507 LD E,B        ; Store the number of columns in #REGe.
@label=ColourSprite_Row
*$7508 PUSH HL       ; Stash the address of the start of the row on the stack.
@label=ColourSprite_Column
*$7509 LD A,H        ; Fetch the high byte of the attribute address.
 $750A CP $5B        ; Jump to #R$7526 if the address is beyond the end of the attribute
                     ; buffer (#N$5B or higher).
 $750C JR NC,$7526   ;
 $750E CP $58        ; Jump to #R$7526 if the address is before the start of the attribute
                     ; buffer.
 $7510 JR C,$7526    ;
 $7512 LD A,L        ; Fetch the low byte of the attribute address.
 $7513 AND %00011111 ; Keep only bits 0-4.
; #HTML(Self modifying code; the operand of this command is written by
; #R$5FE1(#N$5FF6) and #R$6D38(#N$6D49), and sets the column which the colouring
; stops at.)
 $7515 CP $1A        ; {Jump to #R$7526 if the column is beyond the right edge.
 $7517 JR NC,$7526   ; }
 $7519 LD (HL),D     ; Write the colour to the attribute cell.
 $751A INC L         ; Move onto the next column.
 $751B LD A,L        ; Fetch the low byte of the attribute address.
 $751C AND %00011111 ; Keep only bits 0-4.
 $751E JR NZ,$7524   ; Jump to #R$7524 if the row has not wrapped.
 $7520 LD A,L        ; {Move back to the start of the row so it doesn't wrap onto the next
 $7521 SUB $20       ; one.
 $7523 LD L,A        ; }
@label=ColourSprite_NextColumn
*$7524 DJNZ $7509    ; Decrease the column counter by one and loop back to #R$7509 until
                     ; all of the columns have been done.
@label=ColourSprite_NextRow
*$7526 POP HL        ; Retrieve the address of the start of the row.
 $7527 PUSH BC       ; Stash the row counter on the stack.
 $7528 AND A         ; Clear the carry flag.
 $7529 LD BC,$0020   ; Set the size of a row of attributes to #N$0020.
 $752C SBC HL,BC     ; Move up one row.
 $752E POP BC        ; Restore the row counter.
 $752F LD B,E        ; Restore the column counter.
 $7530 DEC C         ; Decrease the row counter by one.
 $7531 JR NZ,$7508   ; Loop back to #R$7508 until all of the rows have been
                     ; done.
 $7533 RET           ; Return.

; Calculate Attribute Address
;
; Used by the routines at #R$60A4, #R$60FD, #R$63E0, #R$7020, #R$7488 and
; #R$74EE.
; .
; Converts the pixel co-ordinates to the address of the attribute buffer
; byte for the character cell containing them.
;
;   HL Pixel address co-ordinates
; O:HL Attribute buffer address
@label=AttributeAddress
c$7534 LD A,L        ; Fetch the horizontal co-ordinate.
 $7535 RRCA          ; {Divide by #N$08 (to get the column).
 $7536 RRCA          ;
 $7537 RRCA          ; }
 $7538 AND %00011111 ; Keep only bits 0-4 (#N$00-#N$1F, the range of the
                     ; columns).
 $753A LD L,A        ; Store this back in #REGl.
 $753B LD A,H        ; Fetch the vertical co-ordinate.
 $753C RLCA          ; {Multiply by #N$04 (the row is the vertical co-ordinate divided by
 $753D RLCA          ; #N$08, and there are #N$20 columns in each row).}
 $753E LD C,A        ; Store this in #REGc temporarily.
 $753F AND %11100000 ; Keep only bits 5-7.
 $7541 OR L          ; Combine with the column in #REGl.
 $7542 LD L,A        ; Store this back in #REGl.
 $7543 LD A,C        ; Fetch the stored value from #REGc.
 $7544 AND %00000011 ; Keep only bits 0-1.
 $7546 OR %01011000  ; Set the MSB of the attribute buffer address (#N$58). This
                     ; ensures that the address is at least #N$5800.
 $7548 LD H,A        ; Store this in #REGh.
 $7549 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9BD2 }
; { #JETPAC$720E }
; { #LUNARJETMAN$8506 }
; { #PSSST$748F }
; { #SABREWULF$B8DD }
; { #TRANZAM$7097 }
; { #UNDERWURLDE$ADE0 }
; LIST#

; Clip Sprite
;
; Used by the routines at #R$7557 and #R$7584.
; .
; The vertical co-ordinate is the bottom edge of a sprite. This stops
; sprites being drawn below the play area, which ends at #N$9F.
;
;   H Vertical co-ordinate
; O:C The number of pixel rows which are below the play area
; O:H The vertical co-ordinate (limited to #N$9F)
@label=ClipSprite
c$754A LD A,H        ; Fetch the vertical co-ordinate.
 $754B SUB $9F       ; Subtract #N$9F (the bottom of the play area).
 $754D JP M,$7554    ; Jump to #R$7554 if the sprite is above the bottom of the
                     ; play area.
 $7550 LD H,$9F      ; Limit the vertical co-ordinate to #N$9F.
 $7552 LD C,A        ; Keep the number of rows to clip in #REGc.
 $7553 RET           ; Return.
@label=ClipSprite_Visible
*$7554 LD C,$00      ; Flag that no rows need to be clipped (#REGc=#N$00).
 $7556 RET           ; Return.

; Prepare Old Sprite
;
; Used by the routines at #R$75CC and #R$7607.
; .
; Gets everything ready to draw (or erase) the sprite at the position
; which was last recorded by #R$76D0. Sprites are drawn using the exclusive OR
; operation, so drawing a sprite for a second time erases it.
;
; O:C #N$00
; O:DE Address of the first row of sprite data to draw
; O:HL Screen address of the bottom row of the sprite
@label=PrepareOldSprite
c$7557 CALL $7623    ; Fetch the address of the recorded sprite using #R$7623.
@label=PrepareOldSprite_Position
 $755A LD HL,($5F14) ; Fetch the recorded position (#R$5F14).
 $755D LD A,L        ; Fetch the horizontal co-ordinate.
 $755E DEC A         ; Decrease #REGa by one.
 $755F RLCA          ; Multiply by #N$02.
 $7560 AND %00001110 ; Keep only bits 1-3.
 $7562 CP $0E        ; {Jump to #R$7568 if this is not the maximum offset.
 $7564 JR NZ,$7568   ; }
 $7566 LD A,$F1      ; Use the offset which jumps to the code for sprites which are aligned
                     ; to a character cell.
; Self modifying code; this updates the operand of the JR command at
; #R$766D(#N$767A).
@label=PrepareOldSprite_Shift
*$7568 LD ($767B),A  ; Write the offset to #R$766D(#N$767B).
 $756B CALL $754A    ; Clip the sprite using #R$754A.
 $756E CALL $76E3    ; Convert the position into a screen address using
                     ; #R$76E3.
 $7571 LD A,(DE)     ; Fetch the height of the sprite.
 $7572 SUB C         ; Subtract the number of rows which are not visible.
 $7573 JR NC,$7576   ; Jump to #R$7576 if there are any rows to draw.
 $7575 XOR A         ; There are no rows to draw.
@label=PrepareOldSprite_Rows
*$7576 LD ($5F19),A  ; Set the number of rows of the old sprite to draw
                     ; (#R$5F19).
 $7579 SLA C         ; Multiply the number of hidden rows by #N$02 (as there are two bytes
                     ; in each row).
 $757B LD B,$00      ; #REGb=#N$00.
 $757D EX DE,HL      ; {Skip the hidden rows in the sprite data.
 $757E ADD HL,BC     ;
 $757F EX DE,HL      ; }
; This entry point is used by the routine at #R$7584.
@label=PrepareSprite_Finish
*$7580 LD C,$00      ; #REGc=#N$00.
 $7582 INC DE        ; Move past the height byte.
 $7583 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #TRANZAM$70B2 }
; LIST#
; .
; The number of rows which can be drawn is written to #R$5F19. The shifting
; routine at #R$7671 is set up to move the sprite right by the horizontal
; co-ordinate MOD #N$08 pixels.

; Prepare Actor Sprite
;
; Used by the routines at #R$75CC and #R$7617.
; .
; Does the same as #R$7557 for the sprite of the actor in #REGix. As well
; as the screen address, it records the address of the first attribute cell in
; #R$5F1F, the width in character cells in #R$5F18 and the number of rows to
; draw in #R$5F1A and #R$5F17. This is set up for the shifting routine at
; #R$76AF.
;
;   IX Actor
; O:C #N$00
; O:DE Address of the first row of sprite data to draw
; O:HL Screen address of the bottom row of the sprite
@label=PrepareActorSprite
c$7584 CALL $7635    ; Fetch the address of the actor sprite using #R$7635.
@label=PrepareActorSprite_Position
 $7587 LD L,(IX+$01) ; Fetch the horizontal co-ordinate of the actor.
 $758A LD H,(IX+$02) ; Fetch the vertical co-ordinate of the actor.
 $758D LD A,L        ; Fetch the horizontal co-ordinate.
 $758E DEC A         ; Decrease #REGa by one.
 $758F RLCA          ; Multiply by #N$02.
 $7590 AND %00001110 ; Keep only bits 1-3.
 $7592 CP $0E        ; {Jump to #R$7598 if this is not the maximum offset.
 $7594 JR NZ,$7598   ; }
 $7596 LD A,$F1      ; Use the offset which jumps to the code for sprites which are aligned
                     ; to a character cell.
; Self modifying code; this updates the operand of the JR command at
; #R$76AB(#N$76B8).
@label=PrepareActorSprite_Shift
*$7598 LD ($76B9),A  ; Write the offset to the JR command at #R$76AB(#N$76B9).
; A sprite which is aligned to a character cell is two cells wide,
; otherwise it is three cells wide.
 $759B LD A,$02      ; Set the width to #N$02.
 $759D JR Z,$75A0    ; Jump to #R$75A0 if the sprite is aligned to a character
                     ; cell.
 $759F INC A         ; Set the width to #N$03.
@label=PrepareActorSprite_Width
*$75A0 LD ($5F18),A  ; Write the width to the actor sprite width (#R$5F18).
 $75A3 CALL $754A    ; Clip the sprite using #R$754A.
 $75A6 LD ($5F1F),HL ; Save the position of the actor sprite (#R$5F1F).
 $75A9 CALL $76E3    ; Convert the position into a screen address using
                     ; #R$76E3.
 $75AC LD A,(DE)     ; Fetch the height of the sprite.
 $75AD SUB C         ; Subtract the number of rows which are not visible.
 $75AE JR NC,$75B1   ; Jump to #R$75B1 if there are any rows to draw.
 $75B0 XOR A         ; There are no rows to draw.
@label=PrepareActorSprite_Rows
*$75B1 LD ($5F1A),A  ; Set the number of rows of the actor sprite to draw
                     ; (#R$5F1A).
 $75B4 LD ($5F17),A  ; Set the number of rows of the actor sprite on the screen
                     ; (#R$5F17).
 $75B7 LD B,$00      ; Set the high byte of the offset to #N$00.
 $75B9 SLA C         ; Multiply the number of hidden rows by #N$02.
 $75BB EX DE,HL      ; {Skip the hidden rows in the sprite data.
 $75BC ADD HL,BC     ;
 $75BD EX DE,HL      ; }
 $75BE JR $7580      ; Jump to #R$7580 to finish.
; View the equivalent code in;
; #LIST
; { #TRANZAM$70D2 }
; LIST#

; Unused Move Sprite Without Fetch
;
; Not used by the game. It is like #R$75CC, but skips the code which
; finds the data for the sprites (#R$7623 and #R$7635), by entering the
; routines which prepare the sprites after that code. It then carries on at
; #R$75D3.
@label=Unused_MoveSprite_NoFetch
u$75C0 PUSH DE       ; Stash #REGde on the stack.
 $75C1 CALL $755A    ; Call #R$755A (part of #R$7557).
 $75C4 EXX           ; Switch to the shadow registers.
 $75C5 POP DE        ; Restore #REGde from the stack.
 $75C6 CALL $7587    ; Call #R$7587 (part of #R$7584).
 $75C9 EXX           ; Switch to the normal registers.
 $75CA JR $75D3      ; Jump to #R$75D3.

; Display Entity
;
; Used by the routines at #R$64F4, #R$654C, #R$6639, #R$6765, #R$6AA0, #R$6B18,
; #R$6B8B, #R$6CB7, #R$6D89, #R$6F78, #R$706B and #R$72A3.
; .
; Erases the sprite from the position recorded by #R$76D0 and draws it at
; the new position held by the actor. The old and the new sprite are processed
; together so that the screen lines which they share are updated in step.
;
; IX Actor
;
; #PUSHS #UDGTABLE { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$6298,stop=$62B5,clear=1,sp=$5F00)
; #POKES$5F0D,$01
; #SIM(start=$6428,stop=$6457,sp=$5F00)
; #SIM(start=$5FE1,stop=$6001,sp=$5F00)
; #SIM(start=$7617,stop=$0000,ix=$5F35,sp=$5E00)
; #SIM(start=$74EE,stop=$0000,ix=$5F35,sp=$5E00)
; #SCR$04,$08,$0A,$0A,$08(sprite-move-before) |
; #SIM(start=$76D0,stop=$0000,ix=$5F35,sp=$5E00)
; #POKES$5F36,$70
; #SIM(start=$75CC,stop=$0000,ix=$5F35,sp=$5E00)
; #SIM(start=$74EE,stop=$0000,ix=$5F35,sp=$5E00)
; #SCR$04,$08,$0A,$0A,$08(sprite-move-after) } UDGTABLE# #POPS
@label=DisplayEntity
c$75CC CALL $7584    ; Prepare the actor sprite using #R$7584.
 $75CF EXX           ; Switch to the shadow registers.
 $75D0 CALL $7557    ; Prepare the old sprite using #R$7557.
; Compare the vertical position of the old sprite with the new one.
@label=DisplayEntity_Compare
 $75D3 LD A,($5F15)  ; Fetch the vertical co-ordinate of the old sprite
                     ; (#R$5F15).
 $75D6 SUB (IX+$02)  ; Subtract the new vertical co-ordinate.
 $75D9 JP Z,$7654    ; Jump to #R$7654 if they are the same.
 $75DC JP M,$75EE    ; Jump to #R$75EE if the new sprite is lower down the
                     ; screen.
; The old sprite is lower down. Draw the rows of it which the new sprite
; does not cover first.
 $75DF LD C,A        ; Keep the number of rows in #REGc.
 $75E0 LD A,($5F19)  ; Fetch the sprite rows remaining.
 $75E3 CP C          ; Compare with the number of rows.
 $75E4 JP C,$7654    ; Jump to #R$7654 if the sprites do not overlap.
 $75E7 SUB C         ; Subtract the rows which are about to be drawn.
 $75E8 LD ($5F19),A  ; Update the number of rows remaining for the old sprite
                     ; (#R$5F19).
 $75EB JP $763A      ; Jump to #R$763A.
; The new sprite is lower down. Draw the rows of it which the old sprite
; does not cover first.
@label=DisplayEntity_NewLower
*$75EE EXX           ; Switch to the shadow registers.
 $75EF NEG           ; Make the number of rows positive.
 $75F1 LD C,A        ; Keep the number of rows in #REGc.
 $75F2 LD A,($5F1A)  ; Fetch the number of rows remaining for the actor sprite
                     ; (#R$5F1A).
 $75F5 CP C          ; Compare with the number of rows.
 $75F6 JP C,$7653    ; Jump to #R$7653 if the sprites do not overlap.
 $75F9 SUB C         ; Subtract the rows which are about to be drawn.
 $75FA JP $7667      ; Jump to #R$7667.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9FCA }
; { #JETPAC$726A }
; { #PSSST$74EB }
; { #SABREWULF$B9A9 }
; { #TRANZAM$7101 }
; { #TRANZAM$7108 }
; { #UNDERWURLDE$96F7 }
; LIST#

; Unused Sprite Entry Points
;
; Not used by the game. These are versions of #R$7617 and #R$7607 which
; skip the code that finds the data for the sprite, for use when #REGde already
; holds the address of the sprite data.
;
; .
;
; Draws the sprite of the actor, without fetching the sprite data.
@label=Unused_SpriteEntryPoints
u$75FD CALL $7587    ; Call #R$7587 (part of #R$7584).
 $7600 JR $761A      ; Jump to #R$761A.
; Erases the sprite at the recorded position, without fetching the sprite
; data.
 $7602 CALL $755A    ; Call #R$755A (part of #R$7557).
 $7605 JR $760A      ; Jump to #R$760A.

; Remove Entity
;
; Used by the routine at #R$6D89.
; .
; Erases the sprite at the position recorded by #R$76D0.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$6298,stop=$62B5,clear=1,sp=$5F00)
; #POKES$5F0D,$01
; #SIM(start=$6428,stop=$6457,sp=$5F00)
; #SIM(start=$5FE1,stop=$6001,sp=$5F00)
; #SIM(start=$7617,stop=$0000,ix=$5F35,sp=$5E00)
; #SIM(start=$74EE,stop=$0000,ix=$5F35,sp=$5E00)
; #SIM(start=$76D0,stop=$0000,ix=$5F35,sp=$5E00)
; #SCR$04,$08,$0A,$0A,$08(remove-entity-before)
; | #SIM(start=$7607,stop=$0000,ix=$5F35,sp=$5E00)
; #SCR$04,$08,$0A,$0A,$08(remove-entity-after) } UDGTABLE# #POPS
@label=RemoveEntity
c$7607 CALL $7557    ; Prepare the recorded sprite using #R$7557.
@label=RemoveEntity_Fetched
 $760A EXX           ; Switch to the shadow registers.
 $760B XOR A         ; #REGa=#N$00.
 $760C LD C,A        ; #REGc=#N$00.
 $760D LD ($5F1A),A  ; Write #N$00 to #R$5F1A.
 $7610 LD ($5F17),A  ; Write #N$00 to #R$5F17.
 $7613 EXX           ; Switch to the normal registers.
 $7614 JP $763A      ; Jump to #R$763A.
; View the equivalent code in;
; #LIST
; { #JETPAC$72A5 }
; { #PSSST$7526 }
; { #SABREWULF$B8F5 }
; { #TRANZAM$7139 }
; { #UNDERWURLDE$9636 }
; LIST#

; Draw Entity
;
; Used by the routines at #R$655C, #R$65E8, #R$6A73, #R$6AA0, #R$6D89, #R$6FA4,
; #R$7048, #R$706B and #R$71D8.
; .
; Draws the sprite of the actor in #REGix at its current position.
;
; IX Actor
;
; #PUSHS #UDGTABLE { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$6298,stop=$62B5,clear=1,sp=$5F00)
; #POKES$5F0D,$01
; #SIM(start=$6428,stop=$6457,sp=$5F00)
; #SIM(start=$5FE1,stop=$6001,sp=$5F00)
; #SCR$04,$08,$0A,$0A,$08(sprite-draw-before) |
; #SIM(start=$7617,stop=$0000,ix=$5F35,sp=$5E00)
; #SIM(start=$74EE,stop=$0000,ix=$5F35,sp=$5E00)
; #SCR$04,$08,$0A,$0A,$08(sprite-draw-after) } UDGTABLE# #POPS
@label=DrawEntity
c$7617 CALL $7584    ; Prepare the actor sprite using #R$7584.
@label=DrawEntity_Fetched
 $761A EXX           ; Switch to the shadow registers.
 $761B XOR A         ; #REGa=#N$00.
 $761C LD ($5F19),A  ; Write #N$00 to #R$5F19.
 $761F LD C,A        ; #REGc=#N$00.
 $7620 JP $763A      ; Jump to #R$763A.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9F4A }
; { #JETPAC$72B5 }
; { #SABREWULF$B919 }
; { #TRANZAM$7149 }
; { #UNDERWURLDE$962A }
; LIST#

; Fetch Sprite
;
; Used by the routine at #R$7557.
; .
; Looks up the address of a sprite graphic in the table at #R$7702. This
; entry point uses the sprite ID which was last recorded by #R$76D0.
;
; O:DE The sprite memory address
@label=FetchSprite
c$7623 LD A,($5F16)  ; Fetch the sprite ID of the recorded sprite (#R$5F16).
@label=GetSprite
*$7626 DEC A         ; Decrease the sprite ID by one, as the table starts at ID
                     ; #N$01.
 $7627 RLCA          ; Multiply by 2 as the table contains addresses.
 $7628 AND %01111110 ; Keep only bits 1-6.
 $762A LD HL,$7702   ; Point #REGhl at the sprite table (#R$7702).
 $762D LD C,A        ; {Calculate the lookup address (#REGhl + offset).
 $762E LD B,$00      ;
 $7630 ADD HL,BC     ; }
 $7631 LD E,(HL)     ; {#REGde=fetch sprite address pointed to by #REGhl.
 $7632 INC HL        ;
 $7633 LD D,(HL)     ; }
 $7634 RET           ; Return.
; This entry point is used by the routine at #R$7584.
; .
; Fetch the sprite for the actor, rather than the recorded sprite.
@label=FetchActorSprite
*$7635 LD A,(IX+$00) ; Load the sprite ID from the currently active actor.
 $7638 JR $7626      ; Jump to #R$7626.
; View the equivalent code in;
; #LIST
; { #LUNARJETMAN$8568 }
; { #TRANZAM$7155 }
; { #UNDERWURLDE$9646 }
; LIST#

; XOR Sprite Loop
;
; Used by the routines at #R$75CC, #R$7607 and #R$7617.
; .
; Draws the old sprite and the new sprite one row at a time, using the
; row counters in #REGc and #REGc' (in the normal and the shadow register sets).
; When the counters are used up, any rows remaining in #R$5F19 and #R$5F1A
; are drawn.
@label=XORSpriteLoop
c$763A LD A,C        ; Fetch the row counter.
 $763B AND A         ; Is it zero?
 $763C JR Z,$764E    ; Jump to #R$764E if there are no rows to draw.
 $763E DEC C         ; Decrease the row counter by one.
 $763F CALL $7671    ; Draw a row of the old sprite using #R$7671.
 $7642 EXX           ; Switch to the shadow registers.
 $7643 LD A,C        ; Fetch the row counter.
 $7644 AND A         ; Is it zero?
 $7645 JR Z,$764B    ; Jump to #R$764B if there are no rows to draw.
@label=XORSpriteLoop_Actor
*$7647 DEC C         ; Decrease the row counter by one.
 $7648 CALL $76AF    ; Draw a row of the actor sprite using #R$76AF.
@label=XORSpriteLoop_Next
*$764B EXX           ; Switch to the normal registers.
 $764C JR $763A      ; Jump to #R$763A.
@label=XORSpriteLoop_Swap
*$764E EXX           ; Switch to the shadow registers.
 $764F LD A,C        ; Fetch the row counter.
 $7650 AND A         ; Is it zero?
 $7651 JR NZ,$7647   ; Jump to #R$7647 if there are more rows to draw.
; This entry point is used by the routine at #R$75CC.
@label=XORSpriteLoop_Restore
*$7653 EXX           ; Switch to the normal registers.
; This entry point is used by the routine at #R$75CC.
; .
; Fetch the number of rows left over from the old sprite and the new
; sprite. If there are none then the drawing is finished.
@label=XORSpriteLoop_Remaining
*$7654 LD A,($5F19)  ; {Fetch the sprite rows remaining and keep the old sprite rows
 $7657 LD C,A        ; remaining in #REGc.}
 $7658 LD A,($5F1A)  ; Fetch the actor sprite rows remaining (#R$5F1A).
 $765B OR C          ; Combine the counters.
 $765C RET Z         ; Return if there are no rows left to draw.
 $765D XOR A         ; Set #REGa to #N$00.
 $765E LD ($5F19),A  ; Update the old sprite rows remaining (#R$5F19).
 $7661 EXX           ; Switch to the shadow registers.
 $7662 LD A,($5F1A)  ; {Fetch the actor sprite rows remaining (#R$5F1A) and keep it in
 $7665 LD C,A        ; #REGc.}
 $7666 XOR A         ; Set #REGa to #N$00.
; This entry point is used by the routine at #R$75CC.
@label=XORSpriteLoop_Continue
*$7667 LD ($5F1A),A  ; Update the actor sprite rows remaining (#R$5F1A).
 $766A EXX           ; Switch to the normal registers.
 $766B JR $763A      ; Jump to #R$763A.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9E9B }
; { #LUNARJETMAN$858E }
; { #SABREWULF$B9DA }
; { #UNDERWURLDE$9728 }
; LIST#

; Draw Old Sprite Row
;
; Draws one row of the sprite prepared by #R$7557 by exclusive ORing it
; onto the screen, then moves on to the row above.
;
;   DE Address of the sprite data
;   HL Screen address
; O:DE Address of the next row of sprite data
; O:HL Screen address of the row above
;
; The entry point for a sprite which is aligned to a character cell.
@label=DrawOldSpriteRow_Aligned
c$766D EX DE,HL      ; #REGde=the row of sprite data, and #REGhl=the address of the next
                     ; row.
 $766E EX (SP),HL    ; #REGhl=the screen address, and the address of the next row of sprite
                     ; data is stored on the stack.
 $766F JR $768F      ; Jump to #R$768F.
; This entry point is used by the routine at #R$763A.
; .
; The entry point for a sprite which is not aligned to a character cell.
@label=DrawOldSpriteRow
*$7671 PUSH HL       ; Stash the screen address on the stack.
 $7672 EX DE,HL      ; #REGhl=the address of the sprite data, and #REGde=the screen
                     ; address.
 $7673 PUSH DE       ; Stash the screen address on the stack again.
 $7674 LD D,(HL)     ; #REGd=the first byte of the row.
 $7675 INC HL        ; Move to the next byte of sprite data.
 $7676 LD E,(HL)     ; #REGe=the second byte of the row.
 $7677 INC HL        ; Move on to the next row of sprite data.
 $7678 EX DE,HL      ; #REGhl=the row of sprite data, and #REGde=the address of the next
                     ; row.
 $7679 XOR A         ; #REGa=#N$00.
; #HTML(Self modifying code; the operand of this command is written by
; #R$7557(#N$7568). It jumps into the sequence of shifts below, so that the row
; is moved right by the right number of pixels.)
@label=DrawOldSpriteRow_Shift
*$767A JR $767A      ; Jump to the first shift to do.
; Shift the row left by up to seven bits; the bits which are shifted out
; of the row end up in #REGa.
 $767C ADD HL,HL     ; {Shift #REGhl left by one, moving the bit shifted out
 $767D ADC A,A       ; into #REGa.}
; Shift the row left by up to seven bits; the bits which are shifted out
; of the row end up in #REGa.
 $767E ADD HL,HL     ; {Shift #REGhl left by one, moving the bit shifted out
 $767F ADC A,A       ; into #REGa.}
; Shift the row left by up to seven bits; the bits which are shifted out
; of the row end up in #REGa.
 $7680 ADD HL,HL     ; {Shift #REGhl left by one, moving the bit shifted out
 $7681 ADC A,A       ; into #REGa.}
; Shift the row left by up to seven bits; the bits which are shifted out
; of the row end up in #REGa.
 $7682 ADD HL,HL     ; {Shift #REGhl left by one, moving the bit shifted out
 $7683 ADC A,A       ; into #REGa.}
; Shift the row left by up to seven bits; the bits which are shifted out
; of the row end up in #REGa.
 $7684 ADD HL,HL     ; {Shift #REGhl left by one, moving the bit shifted out
 $7685 ADC A,A       ; into #REGa.}
; Shift the row left by up to seven bits; the bits which are shifted out
; of the row end up in #REGa.
 $7686 ADD HL,HL     ; {Shift #REGhl left by one, moving the bit shifted out
 $7687 ADC A,A       ; into #REGa.}
; Shift the row left by up to seven bits; the bits which are shifted out
; of the row end up in #REGa.
 $7688 ADD HL,HL     ; {Shift #REGhl left by one, moving the bit shifted out
 $7689 ADC A,A       ; into #REGa.}
 $768A EX DE,HL      ; #REGde=the shifted row, and #REGhl=the address of the next row of
                     ; sprite data.
 $768B EX (SP),HL    ; #REGhl=the screen address, and the address of the next row of sprite
                     ; data is stored on the stack.
 $768C XOR (HL)      ; Exclusive OR the first byte (in #REGa) onto the screen.
 $768D LD (HL),A     ; Write the result to the screen.
 $768E INC L         ; Move to the next byte on the screen.
; This entry point is used by the routine at #R$76AB.
@label=DrawSpriteRow_Write
*$768F LD A,D        ; Fetch the second byte.
 $7690 XOR (HL)      ; Exclusive OR it onto the screen.
 $7691 LD (HL),A     ; Write the result to the screen.
 $7692 INC L         ; Move to the next byte on the screen.
 $7693 LD A,E        ; Fetch the third byte.
 $7694 XOR (HL)      ; Exclusive OR it onto the screen.
 $7695 LD (HL),A     ; Write the result to the screen.
 $7696 POP DE        ; #REGde=the address of the next row of sprite data.
 $7697 POP HL        ; #REGhl=the screen address of the row which was just
                     ; drawn.
; Move up one pixel row on the screen.
 $7698 DEC H         ; Move up one pixel row on the screen (decrease #REGh by
                     ; one).
 $7699 LD A,H        ; Fetch the high byte of the screen address.
 $769A CPL           ; Flip the bits.
 $769B AND %00000111 ; Keep only bits 0-2.
 $769D RET NZ        ; Return if still inside the same character row.
 $769E LD A,L        ; Fetch the low byte of the screen address.
 $769F SUB $20       ; Subtract #N$20 to move up a character row.
 $76A1 LD L,A        ; Update the low byte of the screen address.
 $76A2 CPL           ; Flip the bits.
 $76A3 AND %11100000 ; Keep only bits 5-7.
 $76A5 RET Z         ; Return if still inside the same third of the screen.
 $76A6 LD A,H        ; Fetch the high byte of the screen address.
 $76A7 ADD A,$08     ; Add #N$08.
 $76A9 LD H,A        ; Update the high byte of the screen address.
 $76AA RET           ; Return.

; Draw Actor Sprite Row
;
; Does the same as #R$766D, but for the sprite prepared by #R$7584.
;
;   DE Address of the sprite data
;   HL Screen address
; O:DE Address of the next row of sprite data
; O:HL Screen address of the row above
;
; The entry point for a sprite which is aligned to a character cell.
@label=DrawActorSpriteRow_Aligned
c$76AB EX DE,HL      ; #REGde=the row of sprite data, and #REGhl=the address of the next
                     ; row.
 $76AC EX (SP),HL    ; #REGhl=the screen address, and the address of the next row of sprite
                     ; data is stored on the stack.
 $76AD JR $768F      ; Jump to #R$768F.
; This entry point is used by the routine at #R$763A.
; .
; The entry point for a sprite which is not aligned to a character cell.
@label=DrawActorSpriteRow
*$76AF PUSH HL       ; Stash the screen address on the stack.
 $76B0 EX DE,HL      ; #REGhl=the address of the sprite data, and #REGde=the screen
                     ; address.
 $76B1 PUSH DE       ; Stash the screen address on the stack again.
 $76B2 LD D,(HL)     ; #REGd=the first byte of the row.
 $76B3 INC HL        ; Move to the next byte of sprite data.
 $76B4 LD E,(HL)     ; #REGe=the second byte of the row.
 $76B5 INC HL        ; Move on to the next row of sprite data.
 $76B6 EX DE,HL      ; #REGhl=the row of sprite data, and #REGde=the address of the next
                     ; row.
 $76B7 XOR A         ; #REGa=#N$00.
; Self modifying code; the operand of this command is written by
; #R$7584(#N$7598). It jumps into the sequence of shifts below, so that the row
; is moved right by the right number of pixels.
@label=DrawActorSpriteRow_Shift
*$76B8 JR $76B8      ; Jump to the first shift to do.
; Shift the row left by up to seven bits; the bits which are shifted out
; of the row end up in #REGa. The fourth shift is done with a longer command,
; but the jumps still land on the start of a shift.
 $76BA ADD HL,HL     ; {Shift #REGhl left by one, moving the bit shifted out
 $76BB ADC A,A       ; into #REGa.}
; Shift the row left by up to seven bits; the bits which are shifted out
; of the row end up in #REGa. The fourth shift is done with a longer command,
; but the jumps still land on the start of a shift.
 $76BC ADD HL,HL     ; {Shift #REGhl left by one, moving the bit shifted out
 $76BD ADC A,A       ; into #REGa.}
; Shift the row left by up to seven bits; the bits which are shifted out
; of the row end up in #REGa. The fourth shift is done with a longer command,
; but the jumps still land on the start of a shift.
 $76BE ADD HL,HL     ; {Shift #REGhl left by one, moving the bit shifted out
 $76BF ADC A,A       ; into #REGa.}
 $76C0 ADC HL,HL     ; {Shift #REGhl left by one, moving the bit shifted out
 $76C2 ADC A,A       ; into #REGa.}
 $76C3 ADD HL,HL     ; {Shift #REGhl left by one, moving the bit shifted out
 $76C4 ADC A,A       ; into #REGa.}
 $76C5 ADD HL,HL     ; {Shift #REGhl left by one, moving the bit shifted out
 $76C6 ADC A,A       ; into #REGa.}
 $76C7 ADD HL,HL     ; {Shift #REGhl left by one, moving the bit shifted out
 $76C8 ADC A,A       ; into #REGa.}
 $76C9 EX DE,HL      ; #REGde=the shifted row, and #REGhl=the address of the next row of
                     ; sprite data.
 $76CA EX (SP),HL    ; #REGhl=the screen address, and the address of the next row of sprite
                     ; data is stored on the stack.
 $76CB XOR (HL)      ; Exclusive OR the first byte (in #REGa) onto the screen.
 $76CC LD (HL),A     ; Write the result to the screen.
 $76CD INC L         ; Move to the next byte on the screen.
 $76CE JR $768F      ; Jump to #R$768F.

; Store Entity
;
; Used by the routines at #R$64F4, #R$654C, #R$6607, #R$669B, #R$6765, #R$6930,
; #R$6996, #R$69D4, #R$6AA0, #R$6B18, #R$6B8B, #R$6CB7, #R$6D89, #R$6F78,
; #R$706B and #R$7281.
; .
; Copies the sprite ID and position of the actor into #R$5F14, so that
; when the actor is moved, #R$7557 knows where the old sprite has to be erased
; from.
;
; IX Actor
@label=StoreEntity
c$76D0 LD A,(IX+$01) ; {Copy the horizontal co-ordinate to #R$5F14.
 $76D3 LD ($5F14),A  ; }
 $76D6 LD A,(IX+$02) ; {Copy the vertical co-ordinate to #R$5F15.
 $76D9 LD ($5F15),A  ; }
 $76DC LD A,(IX+$00) ; {Copy the sprite ID to #R$5F16.
 $76DF LD ($5F16),A  ; }
 $76E2 RET           ; Return.
