; Game Entry
;
; Used by the routine at #R$6000.
; .
; The game starts here, as the first instruction at #N$6000 jumps to this
; address. Interrupts stay disabled for the whole game, apart from the short
; windows used to wait for the next frame (see #R$9F4D).
@label=GameEntry
c$9601 DI            ; Disable interrupts.
 $9602 LD SP,$6000   ; Move the stack pointer to the top of the area below the game code,
                     ; as the stack grows downwards from #N$6000.
 $9605 IM 1          ; Select interrupt mode 1.
 $9607 CALL $9C20    ; Convert all of the sprites to the form used by #R$B2BC, using
                     ; #R$9C20.
 $960A LD HL,$C23C   ; Point #REGhl at the font used by the game. Characters start at #N$20
                     ; so this is #N$0100 below the start of the font data.
 $960D LD ($5C36),HL ; Use it as the current character set.
 $9610 JP $98D0      ; Jump to #R$98D0 to set up the game.

; Saved IY Register
;
; The value of #REGiy from when the game was started, which the ROM
; interrupt routine needs. It is put back every time the game waits for an
; interrupt.
@label=SavedIY
g$9613 DEFW $0000

; Frame Counter
;
; Counts the frames. It goes up by one in every frame, and is used for
; timing things.
@label=FrameCounter
g$9615 DEFW $0000

; Random Number
;
; The random number. It is changed in every frame by adding the high byte
; of the frame counter and the memory refresh register to it, and by some of the
; routines that use it.
@label=RandomNumber
g$9617 DEFB $00

; Character Set Address
;
; The address of the character set that is used for printing text, which
; is the address of character #N$00. The font for the game starts with character
; #N($20), so for that it is #N$0100 bytes before the start of the data.
@label=CharacterSetAddress
g$9618 DEFW $0000

; Control Method
;
; The method of control that has been chosen in the menu, which is in bits
; 1 and 2: #N$00 is the keyboard, #N$01 is the Kempston joystick, #N$02 is the
; cursor keys and #N$03 is Sinclair interface 2.
@label=ControlMethod
g$961A DEFB $00

; Scores
;
; The scores of the two players, which are each three bytes of binary
; coded decimal with the most significant byte first.
@label=Scores
g$961B DEFB $00,$00     ; Player 1, the first two bytes.
@label=Scores_Player1_LastByte
 $961D DEFB $00         ; Player 1, the last byte.
@label=Scores_Player2
 $961E DEFB $00,$00,$00 ; Player 2.

; Sprite Row Width
;
; The number of bytes that are written to the buffer for each row of a
; sprite that is being drawn.
@label=SpriteRowWidth
g$9621 DEFB $00

; Sprite Rows Left
;
; The number of rows of the sprite that is being drawn that are still to
; be drawn.
@label=SpriteRowsLeft
g$9622 DEFB $00

; Saved Stack Pointer
;
; Holds the stack pointer while a routine is using it for other things:
; the routines that draw sprites and that clear and copy the buffer.
@label=SavedStackPointer
g$9623 DEFW $0000

; Controls
;
; The controls that have been read but not used yet. A bit stays set until
; the robot has used it: bit 0 turns right, bit 1 turns left, bit 2 moves
; forward, bit 3 uses the action key, bit 4 fires the second weapon and bit 5
; fires the first.
@label=Controls
g$9625 DEFB $00

; Fraction Difference
;
; The difference between the fractions of the horizontal and vertical
; positions of the robot, in sixteenths of a cell. It is used when the cells of
; the map are projected onto the screen.
@label=FractionDifference
g$9626 DEFB $00

; Fraction Sum
;
; The sum of the fractions of the horizontal and vertical positions of the
; robot, in sixteenths of a cell.
@label=FractionSum
g$9627 DEFB $00

; Text Attribute
;
; The attribute that is used for the text that is printed using #R$BD82.
@label=TextAttribute
g$9628 DEFB $00

; Light Turned Flag
;
; Set when a light that goes round the frame of the screen has been turned
; round, so that it is only turned once.
@label=LightTurnedFlag
g$9629 DEFB $00

; Draw List Pointer
;
; The address of the next free entry of the draw list.
@label=DrawListPointer
g$962A DEFW $0000

; Cell Position
;
; The column (the first byte) and the row (the second byte) of the map
; cell that was last looked at.
@label=CellPosition
g$962C DEFB $00
 $962D DEFB $00

; Cell Address
;
; The address in the map of the cell that was last looked at.
@label=CellAddress
g$962E DEFW $0000

; Idle Timer
;
; Counts down while the menu is being shown. When it reaches zero the hall
; of fame is shown.
@label=IdleTimer
g$9630 DEFW $0000

; Last Control Method
;
; The method of control that was selected the last time that the menu was
; drawn, which is used to tell if it has changed.
@label=LastControlMethod
g$9632 DEFB $00

; Name Entered Flag
;
; Set when a score has been put in the hall of fame, so that the hall of
; fame is shown.
@label=NameEnteredFlag
g$9633 DEFB $00

; Places Higher
;
; The number of places in the hall of fame that a new score is higher
; than.
@label=PlacesHigher
g$9634 DEFB $00

; Unused Stack Pointer
;
; The stack pointer is stored here by the main loop, but it is never used.
@label=UnusedStackPointer
g$9635 DEFW $0000

; Tune Played Flag
;
; Set when the tune on the menu has been played, so that it is only played
; once.
@label=TunePlayedFlag
g$9637 DEFB $00

; Enemy Hit Address
;
; The address of the enemy that has been hit by a shot.
@label=EnemyHitAddress
g$9638 DEFW $0000

; Battery Energy
;
; The energy that is left in the battery, as a 16-bit number. The high
; byte is the level that is shown on the battery bar, from #N$00 to #N$74.
@label=BatteryEnergy
g$963A DEFW $0000

; Displayed Battery Level
;
; The level of the battery that is shown on the battery bar at the moment,
; which moves one pixel column at a time towards the level in the high byte of
; the battery energy.
@label=DisplayedBatteryLevel
g$963C DEFB $00

; Cell To Check
;
; The column (the low byte) and the row (the high byte) of the map cell
; that is checked in the next frame.
@label=CellToCheck
g$963D DEFW $0000

; Shot Cost
;
; The amount of energy that is used by the shot that is being fired.
@label=ShotCost
g$963F DEFW $0000

; Program Queue
;
; The queue of programs that the robot has picked up. The first four are
; shown as icons in the panel and the last is the one that is used next when the
; action key is pressed.
@label=ProgramQueue
g$9641 DEFB $00,$00,$00
@label=ProgramQueue_Fourth
 $9644 DEFB $00
@label=ProgramQueue_Last
 $9645 DEFB $00

; Attack Timer
;
; The number of frames until the next sector is attacked.
@label=AttackTimer
g$9646 DEFB $00

; Attacked Sector
;
; The code of the sector that is under attack. The row is in bits 6 and 7,
; and the column is in bits 1 and 2, and a value of #N$03 for either means that
; no sector is attacked.
@label=AttackedSector
g$9647 DEFB $00

; Robot Marker Position
;
; The horizontal position (the first word) and the vertical position (the
; second word) of the robot when its marker on the map of the sectors was last
; drawn. The fraction is the low byte of each and the cell is the high byte.
@label=RobotMarkerPosition
g$9648 DEFW $0000
 $964A DEFW $0000

; Packet Marker
;
; The cell where the marker for the program packet was last drawn on the
; map of the sectors: the column, the row, and a flag that is set if there is a
; marker.
@label=PacketMarker
g$964C DEFB $00
 $964D DEFB $00
 $964E DEFB $00

; Scroll Flag
;
; Set when the message area has to be scrolled up before the next message
; is printed.
@label=ScrollFlag
g$964F DEFB $00

; Battery Low Flag
;
; Set when the message "BATTERY LOW" has been queued, so that it is only
; queued once.
@label=BatteryLowFlag
g$9650 DEFB $00

; Unused Variable
;
; This byte is not used.
@label=UnusedVariable3
g$9651 DEFS $01

; Action Key Used Flag
;
; Set when the action key has been used, so that holding it down does not
; use it again.
@label=ActionKeyUsedFlag
g$9652 DEFB $00

; Previous Position
;
; The horizontal position (the first word) and the vertical position (the
; second word) that an entity had before it was moved, so that the move can be
; undone.
@label=PreviousPosition
g$9653 DEFW $0000
 $9655 DEFW $0000

; Scroll Counter
;
; The number of pixel rows that the message area still has to be scrolled
; up.
@label=ScrollCounter
g$9657 DEFB $00

; Sectors Activated
;
; The number of sectors that have been activated.
@label=SectorsActivated
g$9658 DEFB $00

; Sectors Destroyed
;
; The number of sectors that have been destroyed.
@label=SectorsDestroyed
g$9659 DEFB $00

; Sectors Dealt With
;
; The number of sectors that have been activated or destroyed.
@label=SectorsDealtWith
g$965A DEFB $00

; Sector Flags
;
; One flag for each of the nine sectors, which is set (#N$FF) when the
; sector has been activated.
@label=SectorFlags
g$965B DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00

; Unused Variables
;
; These bytes are not used.
@label=UnusedVariables1
g$9664 DEFS $07

; Characters Printed
;
; The number of characters of the current message that have been printed.
@label=CharactersPrinted
g$966B DEFB $00

; Message Queue
;
; The queue of the messages that are to be shown in the message area.
; There are eight entries of two bytes each: the number of the message (zero if
; the entry is free) and its argument. The values that are in the snapshot are
; left over from before the game was started.
@label=MessageQueue
g$966C DEFB $01,$00
@label=MessageQueue_Second
 $966E DEFB $02,$00
 $9670 DEFB $03,$00
 $9672 DEFB $04,$00
 $9674 DEFB $05,$00
 $9676 DEFB $06,$00
 $9678 DEFB $07,$00
 $967A DEFB $08,$00

; Unused Variables
;
; These bytes are not used.
@label=UnusedVariables2
g$967C DEFS $02

; Sector States
;
; The state of each of the nine sectors. Bit 0 is set if the sector has
; been destroyed, bit 1 is set if it has been activated and bit 2 is set if it
; is under attack.
@label=SectorStates
g$967E DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00

; Unused Variable
;
; This byte is not used.
@label=UnusedVariable
g$9687 DEFS $01

; Sound Effect
;
; The sound effect #R$BFDA is playing. The first byte is the number of
; tones still to play, or zero when nothing is playing. The second byte is the
; effect number (#N$00 to #N$03). #R$BFDA counts the first byte down and does
; not read the effect number.
@label=SoundEffect
g$9688 DEFB $00
 $9689 DEFB $00

; Player Number
;
; The number of the player, which is cleared when a game is started and is
; not used.
@label=PlayerNumber
g$968A DEFB $00

; Lives
;
; The number of lives that the player has left.
@label=Lives
g$968B DEFB $00

; Unused Variable
;
; This variable is set to #N$80 when a game is started, and is never used.
@label=UnusedVariable2
g$968C DEFB $00

; Unused Bytes
;
; These bytes are not used.
@label=UnusedBytes
g$968D DEFS $03

; Entities
;
; The entities, which are the robot, the shots, the enemies, the program
; packet and the clouds. Each is #N$10 bytes long. The entity is not in use if
; its type is zero.
; #TABLE(default,centre)
; { =h Byte | =h What it holds }
; { #N$00 | Sprite type. Bit 7 flips it. Bits 0 and 1 pick the frame. }
; { #N$01 | Fraction of the horizontal position. }
; { #N$02 | Horizontal cell. }
; { #N$03 | Fraction of the vertical position. }
; { #N$04 | Vertical cell. }
; { #N$05 | Type it becomes after materialising. }
; { #N$06 | Robot wait timer, or the robot's speed. }
; { #N$07 | Direction in the low two bits, or a shot's range. }
; { #N$08 | Item an enemy is carrying. }
; { #N$09 | Time a destroyer has left. }
; { #N$0A-#N$0D | Left unused by the handlers. }
; { #N$0E | Program packet state: low four bits count, bit 7 destroyed. }
; { #N$0F | Bit 0 set while the entity is visible. }
; TABLE#
; Entity #N$00 is the robot, entities #N$01 to #N$03 are the shots,
; entities #N$04 to #N$09 are the enemies, entities #N$0A to #N$0D are the
; destroyers, entity #N$0E is the program packet and entities #N$0F to #N$12 are
; not used. The templates for the cells of the map come after them, and the last
; two entities are the clouds.
@label=Entities
g$9690 DEFS $10
@label=ShotEntities
 $96A0 DEFS $10
 $96B0 DEFS $10
 $96C0 DEFS $10
@label=EnemyEntities
 $96D0 DEFS $10
 $96E0 DEFS $10
 $96F0 DEFS $10
 $9700 DEFS $10
 $9710 DEFS $10
 $9720 DEFS $10
@label=DestroyerEntities
 $9730 DEFS $10
 $9740 DEFS $10
 $9750 DEFS $10
 $9760 DEFS $10
@label=ProgramPacketEntity
 $9770 DEFS $10
 $9780 DEFS $10
 $9790 DEFS $10
 $97A0 DEFS $10
 $97B0 DEFS $10

; Cell Templates
;
; The templates for the cells of the map, which are used to draw them in
; the same way as entities. Each is #N$10 bytes long, and they are for the cell
; types #N$01 to #N$0F. The first byte of each is the sprite type, and bytes
; #N$01 and #N$03 are offsets for its position, which are all zero. The handler
; for that sprite type runs on the template, which is how a program and an
; activated terminal animate.
; #TABLE(default,centre)
; { =h Cell | =h Sprite | =h Drawn as }
; { #N$01 | #N$4C | Hazard }
; { #N$02 | #N$74 | Installed program }
; { #N$03 | #N$06 | Battery }
; { #N$04 | #N$5D | Sector wall along Y }
; { #N$05 | #N$5C | Sector wall along X }
; { #N$06 | #N$5E | Dropped program }
; { #N$07 | #N$4D | Hazard }
; { #N$08 | #N$4E | Transmitter }
; { #N$09 | #N$68 | Terminal }
; { #N$0A | #N$5B | Wall along Y }
; { #N$0B | #N$5A | Wall along X }
; { #N$0C | #N$6B | Wall corner }
; { #N$0D | #N$6A | Wall post }
; { #N$0E | #N$70 | Activated terminal }
; { #N$0F | #N$69 | Socket }
; TABLE#
@label=CellTemplates
g$97C0 DEFB $4C,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $97D0 DEFB $74,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $97E0 DEFB $06,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $97F0 DEFB $5D,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $9800 DEFB $5C,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $9810 DEFB $5E,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $9820 DEFB $4D,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $9830 DEFB $4E,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $9840 DEFB $68,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $9850 DEFB $5B,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $9860 DEFB $5A,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $9870 DEFB $6B,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $9880 DEFB $6A,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $9890 DEFB $70,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $98A0 DEFB $69,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00

; Cloud Entities
;
; The two entities that are used for the clouds of smoke.
@label=CloudEntities
g$98B0 DEFS $10
 $98C0 DEFS $10

; Initialise Game
;
; Used by the routine at #R$9601.
; .
; Sets up the screen and the tables used by the game and then shows the
; title screen. This routine never returns.
@label=InitialiseGame
c$98D0 LD HL,$9613   ; Point #REGhl at the first of the game variables.
 $98D3 LD BC,$01AD   ; There are #N$01AD bytes to clear, which covers the variables and the
                     ; first #N$13 entries of the entity table.
 $98D6 CALL $B1A3    ; Zero them using #R$B1A3.
 $98D9 LD ($9613),IY ; Save #REGiy, as it is restored every time the game waits for an
                     ; interrupt.
 $98DD XOR A         ; {Set the border to black.
 $98DE OUT ($FE),A   ; }
 $98E0 LD DE,$3FFF   ; Point #REGde at an address in ROM, so that the screen is not
                     ; touched.
 $98E3 CALL $B21F    ; Initialise the off-screen buffer using #R$B21F.
 $98E6 CALL $B294    ; Build the tables that are used to shift sprites using
                     ; #R$B294.
 $98E9 CALL $B1AD    ; Clear the screen using #R$B1AD.
 $98EC CALL $B5EB    ; Draw the border around the screen using #R$B5EB.
; This entry point is used by the routine at #R$B6FD.
; .
; The game comes back here when it has ended.
@label=TitleScreen
*$98EF CALL $B4B9    ; Draw the panel using #R$B4B9.
 $98F2 CALL $B585    ; Print the score using #R$B585.
 $98F5 CALL $B56B    ; Print the hi-score using #R$B56B.
 $98F8 LD HL,$961B   ; Point #REGhl at #R$961B.
 $98FB LD BC,$01A5   ; There are #N$01A5 bytes to clear, which covers the scores, the
                     ; variables and the first #N$13 entries of the entity table.
 $98FE CALL $B1A3    ; Zero them using #R$B1A3.
 $9901 CALL $B20A    ; Clear the large window using #R$B20A.
 $9904 CALL $BB12    ; Show the menu using #R$BB12, which returns when the player has
                     ; chosen to start the game.
 $9907 CALL $B72B    ; Start the game using #R$B72B.

; Start Round
;
; Used by the routine at #R$9A4B.
; .
; Sets up everything needed to start (or restart) the play area, and then
; falls through into the main loop. The game also comes back here when a new
; round starts after all of the sectors have been activated.
@label=StartRound
c$990A LD HL,$5018   ; Point #REGhl at the bottom part of the panel, which is in character
                     ; column #N$18 of row #N$10.
 $990D LD BC,$0840   ; The block to clear is #N$08 bytes wide (#REGb) and #N$40 pixel rows
                     ; tall (#REGc).
 $9910 CALL $B1F2    ; Clear it using #R$B1F2.
 $9913 LD HL,$1800   ; Put the camera at the corner of cell #N$18 in both
                     ; directions.
 $9916 LD ($9691),HL ; Set the X position of the camera.
 $9919 LD ($9693),HL ; Set the Y position of the camera.
 $991C CALL $9BCE    ; Count the programs that are installed in each sector
                     ; using #R$9BCE.
 $991F LD A,$47      ; Use bright white on black as the attribute.
 $9921 CALL $B1C2    ; Colour the play window using #R$B1C2.
 $9924 LD A,($9617)  ; Take the random number...
 $9927 AND $3F       ; ...limited to #N$00-#N$3F...
 $9929 LD L,A        ; ...as the column of the map cell that is checked next.
 $992A LD A,R        ; Take a number from the memory refresh register...
 $992C AND $3F       ; ...limited to #N$00-#N$3F...
 $992E LD H,A        ; ...as the row of the map cell that is checked next.
 $992F LD ($963D),HL ; Store the position of the first map cell to check.
 $9932 LD A,$01      ; {Set the flag that says the next message is to be scrolled into the
 $9934 LD ($964F),A  ; message area.}
 $9937 LD A,$80      ; {Set a delay of #N$80 frames before the first attack on
 $9939 LD ($9646),A  ; a sector.}
; Continue on to #R$993C.

; Main Loop
;
; Runs once per frame. It checks whether the round is over, runs the
; handler of every entity, checks one cell of the map, draws the world and then
; updates the battery, the messages and the attacks on the sectors.
;
; .
;
; Check whether the program packet is still on its way, and whether the
; round has ended.
@label=MainLoop
c$993C LD A,($9770)  ; Fetch the type of the program packet (entity #N$0E).
 $993F AND A         ; {Jump if there is no program packet.
 $9940 JR Z,$9949    ; }
 $9942 LD A,($977E)  ; Fetch the state of the program packet.
 $9945 AND $0F       ; {Skip the end of round checks while the state is not
 $9947 JR NZ,$9963   ; zero.}
@label=MainLoop_CheckRoundEnd
*$9949 LD A,($9659)  ; Fetch the number of sectors that have been destroyed.
 $994C CP $09        ; {Jump if all nine sectors have been destroyed, as the
 $994E JP Z,$9A22    ; game is lost.}
 $9951 LD L,A        ; Keep the number of destroyed sectors.
 $9952 LD A,($9658)  ; Fetch the number of sectors that have been activated.
 $9955 CP $09        ; {Jump if all nine have been activated, as the round has
 $9957 JP Z,$9A4B    ; been won.}
 $995A ADD A,L       ; Add the number of destroyed sectors.
 $995B CP $09        ; {Jump if all nine sectors have been dealt with, one way or the other,
 $995D JP Z,$9AA5    ; to see how well the player has done.}
 $9960 CALL $AE2D    ; Update the markers on the sector map using #R$AE2D.
; Run the handler of each entity, starting with the robot.
@label=MainLoop_Entities
*$9963 LD IX,$9690   ; Point #REGix at the first entity (the robot).
 $9967 LD HL,$D355   ; Point #REGhl at #R$D355.
 $996A LD ($962A),HL ; Save it as the current position in the draw list.
 $996D CALL $B075    ; Read the controls using #R$B075.
; This entry point is used by the routine at #R$A8A4.
@label=MainLoop_Dispatch
*$9970 LD HL,$9985   ; {Push the address of #R$9985, which is where the handler
 $9973 PUSH HL       ; returns to.}
 $9974 LD L,(IX+$00) ; Fetch the type of the entity.
 $9977 LD BC,$9F5B   ; Point #REGbc at #R$9F5B.
; This entry point is used by the routine at #R$AF25.
; .
; This entry point jumps to the routine in the table at #REGbc that is
; selected by #REGl.
@label=MainLoop_Dispatch_Table
*$997A LD H,$00      ; Clear the high byte of the index.
 $997C ADD HL,HL     ; Double the index.
 $997D LD H,$00      ; Clear the high byte again, which discards the flip flag that was in
                     ; bit 7 of the type.
 $997F ADD HL,BC     ; Add the address of the table.
 $9980 LD A,(HL)     ; Fetch the low byte of the handler address...
 $9981 INC HL        ; ...and then the high byte...
 $9982 LD H,(HL)     ; ...into #REGhl.
 $9983 LD L,A        ; Assemble the low byte of the handler address.
 $9984 JP (HL)       ; Run the handler.
; Each handler returns here.
@label=MainLoop_NextEntity
 $9985 LD A,($9615)  ; Fetch the frame counter.
 $9988 LD C,A        ; Keep the frame counter.
 $9989 LD A,($9617)  ; Fetch the random number.
 $998C ADD A,C       ; Add the frame counter to it...
 $998D LD ($9617),A  ; ...and store the result as the new random number.
 $9990 LD BC,$0010   ; Each entity is #N$10 bytes long.
 $9993 ADD IX,BC     ; Move on to the next entity.
 $9995 PUSH IX       ; {Copy the address of the entity into #REGhl.
 $9997 POP HL        ; }
 $9998 LD BC,$98D0   ; Point #REGbc at the end of the entity table.
 $999B AND A         ; {Subtract the address of the end of the entity table.
 $999C SBC HL,BC     ; }
 $999E JR NC,$99A2   ; Jump if every entity has been handled.
 $99A0 JR $9970      ; Otherwise run the handler of the next entity.
; Check one cell of the map, and then draw the frame.
@label=MainLoop_EndOfFrame
*$99A2 LD HL,($9615) ; Fetch the frame counter.
 $99A5 INC HL        ; Increment it...
 $99A6 LD ($9615),HL ; ...and store it.
 $99A9 LD A,R        ; Fetch a number from the memory refresh register.
 $99AB LD L,A        ; Keep the refresh value.
 $99AC LD A,($9617)  ; Fetch the random number.
 $99AF ADD A,H       ; Add the high byte of the frame counter to it...
 $99B0 ADD A,L       ; ...and then the number from the memory refresh
                     ; register...
 $99B1 LD ($9617),A  ; ...and store the result as the new random number.
 $99B4 LD HL,($963D) ; Fetch the position of the map cell that is checked next.
 $99B7 INC L         ; Move to the next column.
 $99B8 LD A,L        ; {Limit the column to #N$00-#N$3F.
 $99B9 AND $3F       ;
 $99BB LD L,A        ; }
 $99BC CP $30        ; {Jump if the column is inside the #N$30 columns of the
 $99BE JR C,$99CD    ; map.}
 $99C0 LD L,$00      ; Otherwise go back to column #N$00...
 $99C2 INC H         ; ...and move on to the next row.
 $99C3 LD A,H        ; {Limit the row to #N$00-#N$3F.
 $99C4 AND $3F       ;
 $99C6 LD H,A        ; }
 $99C7 CP $30        ; {Jump if the row is inside the #N$30 rows of the map.
 $99C9 JR C,$99CD    ; }
 $99CB LD H,$00      ; Otherwise go back to row #N$00.
@label=MainLoop_StoreCell
*$99CD LD ($963D),HL ; Store the position of the cell to check.
 $99D0 EX DE,HL      ; Put the position in #REGde.
 $99D1 CALL $BF9D    ; Find the address of the cell in the map using #R$BF9D.
 $99D4 LD HL,($962E) ; Fetch the address of the cell.
 $99D7 LD A,(HL)     ; Fetch the contents of the cell.
 $99D8 CP $88        ; {Is this a program transmitter (current and initial types both
 $99DA CALL Z,$9DFE  ; #N$08)? If so, send a program packet using #R$9DFE.}
 $99DD AND $F0       ; Keep the initial type of the cell.
 $99DF CP $30        ; {Compare it with #N$30 (the result is never used), and jump over the
 $99E1 JR $99EF      ; code that is never run.}
; This code is never run.
@label=MainLoop_Unused
 $99E3 JR NZ,$99EF   ; Skip the rest if the initial type is not #N$30.
 $99E5 LD A,(HL)     ; Fetch the contents of the cell.
 $99E6 AND $F0       ; Keep the initial type...
 $99E8 LD B,A        ; ...in #REGb.
 $99E9 RRA           ; {Move the initial type into the low nibble.
 $99EA RRA           ;
 $99EB RRA           ;
 $99EC RRA           ; }
 $99ED OR B          ; Combine it with the initial type...
 $99EE LD (HL),A     ; ...and write it back, so that the cell goes back to its initial
                     ; type.
; Draw the world, then deal with the battery, the messages and the attacks
; on the sectors.
@label=MainLoop_Draw
*$99EF CALL $BF22    ; Sort the draw list using #R$BF22.
 $99F2 CALL $BE5F    ; Add the cells of the map to the draw list using #R$BE5F.
 $99F5 CALL $BF22    ; Sort the draw list again.
 $99F8 CALL $BF6A    ; Draw everything in the draw list into the off-screen buffer using
                     ; #R$BF6A.
 $99FB CALL $B21C    ; Copy the off-screen buffer to the screen using #R$B21C.
 $99FE CALL $A739    ; Try to start a new enemy using #R$A739.
 $9A01 LD ($9635),SP ; Save the stack pointer (this is never used).
 $9A05 CALL $9F09    ; Check for the pause key using #R$9F09.
 $9A08 LD HL,$0001   ; Set up a delay that is only one iteration long.
@label=MainLoop_Delay
*$9A0B DEC HL        ; Count down.
 $9A0C LD A,L        ; {Loop back until the delay has finished.
 $9A0D OR H          ;
 $9A0E JR NZ,$9A0B   ; }
 $9A10 CALL $BFDA    ; Play the next part of the current sound effect using
                     ; #R$BFDA.
 $9A13 CALL $9E5C    ; Update the battery bar using #R$9E5C.
 $9A16 CALL $9EC6    ; Flash the battery if it is low using #R$9EC6.
 $9A19 CALL $9DA7    ; Count down to the next attack on a sector using #R$9DA7.
 $9A1C CALL $9C88    ; Print the next character of the current message using
                     ; #R$9C88.
 $9A1F JP $993C      ; Go round again.

; Lose Game
;
; Used by the routine at #R$993C.
; .
; Shows the message that is used when every sector has been destroyed,
; plays the defeat tune and then ends the game.
@label=LoseGame
c$9A22 LD A,$47      ; Use bright white on black as the attribute.
 $9A24 CALL $B217    ; Clear the play window using #R$B217.
 $9A27 LD DE,$9B26   ; Point #REGde' at the attributes of the four lines of text (see
                     ; #R$9B26).
 $9A2A EXX           ; Switch to the shadow registers, as #R$B8CE expects the attributes
                     ; there.
 $9A2B LD HL,$9B2A   ; Point #REGhl at #R$9B2A.
 $9A2E LD DE,$9B32   ; Point #REGde at #R$9B32.
 $9A31 LD B,$04      ; There are four lines to print.
 $9A33 CALL $B8CE    ; Print them using #R$B8CE.
 $9A36 LD DE,$C2E9   ; Point #REGde at #R$C2E9.
 $9A39 CALL $C0CF    ; Play it using #R$C0CF.
; This entry point is used by the routine at #R$9AA5.
; .
; This entry point waits for a while and then ends the game.
@label=LoseGame_Wait
*$9A3C LD HL,$0000   ; Set up a delay of #N$010000 iterations of the outer
                     ; loop...
 $9A3F LD B,$00      ; ...using #REGb as the second counter.
@label=LoseGame_Delay
*$9A41 DEC H         ; Count down.
 $9A42 LD A,L        ; {Loop back until the high byte has counted down to zero.
 $9A43 OR H          ;
 $9A44 JR NZ,$9A41   ; }
 $9A46 DJNZ $9A41    ; Loop back until #REGb has counted down to zero too.
 $9A48 JP $B6FD      ; End the game using #R$B6FD.

; Win Round
;
; Used by the routine at #R$993C.
; .
; Shows the message that is used when every sector has been activated and
; plays the victory tune. The robot then starts a new round on a fresh map with
; two more lives, up to a maximum of nine.
@label=WinRound
c$9A4B LD A,$47      ; Use bright white on black as the attribute.
 $9A4D CALL $B217    ; Clear the play window using #R$B217.
 $9A50 LD DE,$9B70   ; Point #REGde' at the attributes of the five lines of text (see
                     ; #R$9B70).
 $9A53 EXX           ; Switch to the shadow registers, as #R$B8CE expects the attributes
                     ; there.
 $9A54 LD HL,$9B75   ; Point #REGhl at #R$9B75.
 $9A57 LD DE,$9B7F   ; Point #REGde at #R$9B7F.
 $9A5A LD B,$05      ; There are five lines to print.
 $9A5C CALL $B8CE    ; Print them using #R$B8CE.
; This entry point is used by the routine at #R$9AA5.
; .
; The game comes here when the player has activated eight sectors and
; destroyed the last one.
@label=WinRound_Tune
*$9A5F LD DE,$C2A7   ; Point #REGde at the tune that is played when the round
                     ; is won.
 $9A62 CALL $C0CF    ; Play it using #R$C0CF.
 $9A65 CALL $BBAA    ; Reset the map and the screen for a new round using
                     ; #R$BBAA.
 $9A68 LD HL,$968B   ; Point #REGhl at #R$968B.
 $9A6B LD A,(HL)     ; Fetch the number of lives.
 $9A6C ADD A,$02     ; Add two lives.
 $9A6E CP $09        ; {Jump if the total is below #N$09.
 $9A70 JR C,$9A74    ; }
 $9A72 LD A,$09      ; Otherwise limit it to nine lives.
@label=WinRound_StoreLives
*$9A74 LD (HL),A     ; Store the number of lives.
 $9A75 LD HL,$9621   ; Point #REGhl at the variables that describe the state of the
                     ; previous round.
 $9A78 LD BC,$0069   ; There are #N$69 bytes to clear.
 $9A7B CALL $B1A3    ; Zero them using #R$B1A3.
 $9A7E LD HL,$9690   ; Point #REGhl at #R$9690.
 $9A81 LD BC,$0130   ; The first #N$13 entities are cleared. The rest are templates for the
                     ; map.
 $9A84 CALL $B1A3    ; Zero them using #R$B1A3.
 $9A87 LD A,$47      ; Use bright white on black as the attribute.
 $9A89 CALL $B217    ; Clear the play window using #R$B217.
 $9A8C CALL $A127    ; Set the number of the sprite shown when the robot is starting using
                     ; #R$A127.
 $9A8F CALL $A99F    ; Put the robot back at the start using #R$A99F.
 $9A92 XOR A         ; {Set the displayed battery level to zero, so that the bar fills up
 $9A93 LD ($963C),A  ; from the left.}
 $9A96 CALL $ADEA    ; Colour the cells of the sector map using #R$ADEA.
 $9A99 CALL $B4B9    ; Draw the panel using #R$B4B9.
 $9A9C CALL $B585    ; Print the score using #R$B585.
 $9A9F CALL $B56B    ; Print the hi-score using #R$B56B.
 $9AA2 JP $990A      ; Start the round using #R$990A.

; End Round
;
; Used by the routines at #R$993C and #R$B6BC.
; .
; Used when every sector has either been destroyed or activated. It shows
; how many of each there are. If at least eight sectors have been activated then
; the player goes on to the next round, and otherwise the game is lost.
@label=EndRound
c$9AA5 LD A,($9659)  ; Fetch the number of sectors that have been destroyed.
 $9AA8 ADD A,$30     ; Convert it into a digit...
 $9AAA LD ($9B00),A  ; ...and write it into the text of the message that shows it (see
                     ; #R$9B00).
 $9AAD LD A,($9658)  ; Fetch the number of sectors that have been activated.
 $9AB0 ADD A,$30     ; Convert it into a digit...
 $9AB2 LD ($9B13),A  ; ...and write it into the text of the message that shows it (see
                     ; #R$9B13).
 $9AB5 LD A,$47      ; Use bright white on black as the attribute.
 $9AB7 CALL $B217    ; Clear the play window using #R$B217.
 $9ABA LD DE,$9AFA   ; Point #REGde' at the attributes of the two lines of text (see
                     ; #R$9AFA).
 $9ABD EXX           ; Switch to the shadow registers, as #R$B8CE expects the attributes
                     ; there.
 $9ABE LD HL,$9AFC   ; Point #REGhl at #R$9AFC.
 $9AC1 LD DE,$9B00   ; Point #REGde at #R$9B00.
 $9AC4 LD B,$02      ; There are two lines to print.
 $9AC6 CALL $B8CE    ; Print them using #R$B8CE.
 $9AC9 LD A,($9658)  ; Fetch the number of sectors that have been activated.
 $9ACC CP $08        ; {Jump if at least eight sectors have been activated.
 $9ACE JR NC,$9AE8   ; }
 $9AD0 LD DE,$9B28   ; Point #REGde' at the attributes of the last two lines of the defeat
                     ; message.
 $9AD3 EXX           ; Switch to the shadow registers.
 $9AD4 LD HL,$9B2E   ; Point #REGhl at #R$9B2E.
 $9AD7 LD DE,$9B51   ; Point #REGde at #R$9B51.
 $9ADA LD B,$02      ; There are two lines to print.
 $9ADC CALL $B8CE    ; Print them using #R$B8CE.
 $9ADF LD DE,$C2E9   ; Point #REGde at #R$C2E9.
 $9AE2 CALL $C0CF    ; Play it using #R$C0CF.
 $9AE5 JP $9A3C      ; Wait for a while and end the game using #R$9A3C.
; The player has activated at least eight sectors.
@label=EndRound_Continue
*$9AE8 LD DE,$9B73   ; Point #REGde' at the attributes of the last two lines of the victory
                     ; message.
 $9AEB EXX           ; Switch to the shadow registers.
 $9AEC LD HL,$9B7B   ; Point #REGhl at #R$9B7B.
 $9AEF LD DE,$9BAC   ; Point #REGde at #R$9BAC.
 $9AF2 LD B,$02      ; There are two lines to print.
 $9AF4 CALL $B8CE    ; Print them using #R$B8CE.
 $9AF7 JP $9A5F      ; Play the victory tune and start the next round using
                     ; #R$9A5F.

; Messaging: Round Result Text
;
; The attributes, coordinates and text that are used by the screens shown
; at the end of a round. The attributes and coordinates are passed to #R$B8CE,
; which takes the coordinates as pairs of an X position and a Y position in
; pixels. Every string has bit 7 of its last character set.
@label=RoundResult_Attributes
t$9AFA DEFB $44                          ; {Attributes: #COLOUR(#PEEK(#PC)) and
 $9AFB DEFB $43                          ; #COLOUR(#PEEK(#PC+1)).}
@label=RoundResult_Coordinates
 $9AFC DEFB $18,$28                      ; {Coordinates of the two lines of
 $9AFE DEFB $18,$38                      ; text.}
@label=Message_SectorsDestroyed
 $9B00 DEFM "1 SECTORS DESTROYE","D"+$80 ; The number of sectors destroyed is written into the first
                                         ; character. "1 SECTORS DESTROYED".
@label=Message_SectorsActivated
 $9B13 DEFM "1 SECTORS ACTIVATE","D"+$80 ; The number of sectors activated is written into the first
                                         ; character. "1 SECTORS ACTIVATED".
@label=DefeatMessage_Attributes
 $9B26 DEFB $46                          ; {Attributes: #COLOUR(#PEEK(#PC)) for each of the four lines of
 $9B27 DEFB $46                          ; text.
@label=DefeatMessage_Attributes_LastLines
 $9B28 DEFB $46                          ;
 $9B29 DEFB $46                          ; }
@label=DefeatMessage_Coordinates
 $9B2A DEFB $20,$28                      ; {Coordinates of the four lines of
 $9B2C DEFB $28,$38                      ; text.
@label=DefeatMessage_Coordinates_LastLines
 $9B2E DEFB $28,$48                      ;
 $9B30 DEFB $28,$58                      ; }
@label=DefeatMessage_Text
 $9B32 DEFM "ALL SECTORS HAV","E"+$80    ; "ALL SECTORS HAVE".
 $9B42 DEFM "BEEN DESTROYED","."+$80     ; "BEEN DESTROYED.".
@label=DefeatMessage_TextFailed
 $9B51 DEFM "YOU HAVE FAILE","D"+$80     ; "YOU HAVE FAILED".
 $9B60 DEFM "IN YOUR MISSION","."+$80    ; "IN YOUR MISSION.".
@label=VictoryMessage_Attributes
 $9B70 DEFB $46                          ; {Attributes: #COLOUR(#PEEK(#PC)) for each of the five lines of
 $9B71 DEFB $46                          ; text.
 $9B72 DEFB $46                          ;
@label=VictoryMessage_Attributes_LastLines
 $9B73 DEFB $46                          ;
 $9B74 DEFB $46                          ; }
@label=VictoryMessage_Coordinates
 $9B75 DEFB $20,$20                      ; {Coordinates of the five lines of
 $9B77 DEFB $18,$30                      ; text.
 $9B79 DEFB $30,$40                      ;
@label=VictoryMessage_Coordinates_LastLines
 $9B7B DEFB $20,$50                      ;
 $9B7D DEFB $18,$60                      ; }
@label=VictoryMessage_Text
 $9B7F DEFM "CONGRATULATION","S"+$80     ; "CONGRATULATIONS".
 $9B8E DEFM "YOU HAVE ACTIVATE","D"+$80  ; "YOU HAVE ACTIVATED".
 $9BA0 DEFM "ALL SECTORS","."+$80        ; "ALL SECTORS.".
@label=VictoryMessage_TextContinue
 $9BAC DEFM "YOU MAY CONTINU","E"+$80    ; "YOU MAY CONTINUE".
 $9BBC DEFM "WITH YOUR MISSION","."+$80  ; "WITH YOUR MISSION.".

; Count Sector Programs
;
; Used by the routine at #R$990A.
; .
; Counts the installed programs (map cells with both their current and
; initial type equal to #N$02) in each of the nine sectors. The result is the
; amount of energy that each sector starts with.
@label=CountSectorPrograms
c$9BCE LD B,$09      ; There are nine sectors, which are counted from the last to the
                     ; first.
@label=CountSectorPrograms_NextSector
*$9BD0 LD A,B        ; Fetch the sector number...
 $9BD1 DEC A         ; ...which is one below the counter.
 $9BD2 LD HL,$A361   ; Point #REGhl at #R$A361.
 $9BD5 CALL $BF92    ; Add the sector number, using #R$BF92, to find the entry for this
                     ; sector.
 $9BD8 LD (HL),$00   ; Start the count for the sector at zero.
 $9BDA LD A,B        ; Fetch the sector number again.
 $9BDB DEC A         ; The sector number is one below the counter.
 $9BDC EXX           ; Switch to the shadow registers, so that the counter in #REGhl' is
                     ; the address of the entry for this sector.
 $9BDD ADD A,A       ; Double the sector number...
 $9BDE LD E,A        ; ...to make an index into the table of offsets of the sectors in the
                     ; map.
 $9BDF LD D,$00      ; Clear the high byte of the index.
 $9BE1 LD HL,$9C0E   ; Point #REGhl at #R$9C0E.
 $9BE4 ADD HL,DE     ; Add the index.
 $9BE5 LD E,(HL)     ; Fetch the low byte of the offset of the sector...
 $9BE6 INC HL        ; ...and then the high byte...
 $9BE7 LD D,(HL)     ; ...into #REGde.
 $9BE8 LD HL,$C515   ; Point #REGhl at #R$C515.
 $9BEB ADD HL,DE     ; Add the offset to find the first cell of the sector.
 $9BEC CALL $9BF3    ; Count the programs in the sector using #R$9BF3.
 $9BEF EXX           ; Switch back to the main registers.
 $9BF0 DJNZ $9BD0    ; Loop back until every sector has been counted.
 $9BF2 RET           ; Return.

; Count Programs In Sector
;
; Used by the routine at #R$9BCE.
; .
; Counts the installed programs in a sector of #N$10 by #N$10 cells and
; adds each one to the energy of the sector.
;
; HL Address of the first cell of the sector in the map
; HL' Address of the energy of the sector
@label=CountSectorPrograms_Sector
c$9BF3 LD DE,$0040   ; Each row of the map is #N$40 bytes long.
 $9BF6 LD C,$10      ; There are #N$10 rows in the sector.
@label=CountSectorPrograms_Row
*$9BF8 LD B,$10      ; There are #N$10 cells in each row.
 $9BFA PUSH HL       ; Save the address of the start of the row.
@label=CountSectorPrograms_Cell
*$9BFB LD A,(HL)     ; Fetch the cell.
 $9BFC CP $22        ; {Jump if it is an installed program, which is a cell with a current
 $9BFE JR Z,$9C09    ; and an initial type of #N$02.}
@label=CountSectorPrograms_Next
*$9C00 INC HL        ; Move on to the next cell.
 $9C01 DJNZ $9BFB    ; Loop back until the whole row has been checked.
 $9C03 POP HL        ; Restore the address of the start of the row.
 $9C04 ADD HL,DE     ; Move down to the next row of the map.
 $9C05 DEC C         ; Count down the rows.
 $9C06 JR NZ,$9BF8   ; Loop back until the whole sector has been checked.
 $9C08 RET           ; Return.
@label=CountSectorPrograms_Installed
*$9C09 EXX           ; Switch to the shadow registers.
 $9C0A INC (HL)      ; Add one to the energy of the sector.
 $9C0B EXX           ; Switch back to the main registers.
 $9C0C JR $9C00      ; Jump back to carry on with the row.

; Sector Offsets
;
; The offset into the map of the first cell of each sector. Sector #N$00
; is the top left, sector #N$01 is the one to the right of it, and sector #N$08
; is the bottom right. As the map starts with the bottom row of sectors, the
; offsets of the top row of sectors are the largest.
@label=SectorOffsets
w$9C0E DEFW $0800
 $9C10 DEFW $0810
 $9C12 DEFW $0820
 $9C14 DEFW $0400
 $9C16 DEFW $0410
 $9C18 DEFW $0420
 $9C1A DEFW $0000
 $9C1C DEFW $0010
 $9C1E DEFW $0020

; Decode Sprites
;
; Used by the routine at #R$9601.
; .
; Converts every sprite from the form in which it is stored, a mask byte
; and then a pixel byte for each pair of bytes, into the form used by #R$B2BC,
; which is a mask byte followed by the XOR of the mask and the pixels. Sprites
; that are already marked as decoded (bit 6 of the first byte of the header) are
; left alone.
@label=DecodeSprites
c$9C20 LD HL,$6193   ; Point #REGhl at the end of the table of sprite addresses (which is
                     ; the address of the blank sprite).
 $9C23 LD DE,$60A3   ; Point #REGde at #R$60A3.
 $9C26 AND A         ; {Subtract the start of the table to find its size in
 $9C27 SBC HL,DE     ; bytes.}
 $9C29 SRL L         ; Halve it to find the number of sprites...
 $9C2B LD B,L        ; ...and use that as the counter.
@label=DecodeSprites_NextSprite
*$9C2C PUSH BC       ; Save the counter.
 $9C2D DEC B         ; The sprite number is one below the counter.
 $9C2E LD L,B        ; Use the sprite number as the low byte of the index...
 $9C2F LD H,$00      ; ...and clear #REGh.
 $9C31 ADD HL,HL     ; Double it to make an index into the table.
 $9C32 LD DE,$60A3   ; Point #REGde at #R$60A3.
 $9C35 ADD HL,DE     ; Add the index.
 $9C36 LD E,(HL)     ; Fetch the address of the sprite...
 $9C37 INC HL        ; ...from the table...
 $9C38 LD D,(HL)     ; ...into #REGde.
 $9C39 LD A,(DE)     ; Fetch the first byte of the header (the width, and
                     ; flags).
 $9C3A BIT 6,A       ; {Jump if the sprite has been decoded already.
 $9C3C JR NZ,$9C5A   ; }
 $9C3E OR $40        ; Mark the sprite as decoded...
 $9C40 LD (DE),A     ; ...and store the byte.
 $9C41 AND $0F       ; {Extract the width in bytes, and jump if the sprite is
 $9C43 JR Z,$9C5A    ; blank.}
 $9C45 LD B,A        ; Use the width as a counter.
 $9C46 INC DE        ; Move on to the height.
 $9C47 LD A,(DE)     ; Fetch it...
 $9C48 LD C,A        ; ...and keep it in #REGc.
 $9C49 AND A         ; {Jump if the sprite is blank.
 $9C4A JR Z,$9C5A    ; }
 $9C4C XOR A         ; Multiply the height by the width, by adding it up that many times,
                     ; to find the number of pairs of bytes.
@label=DecodeSprites_AddHeight
*$9C4D ADD A,C       ; Add the height.
 $9C4E DJNZ $9C4D    ; Loop back until done.
 $9C50 EX DE,HL      ; Point #REGhl at the sprite data.
 $9C51 INC HL        ; Move on to the first pair of bytes.
 $9C52 LD B,A        ; Use the number of pairs as a counter.
@label=DecodeSprites_Pair
*$9C53 LD A,(HL)     ; Fetch the mask.
 $9C54 INC HL        ; Move on to the pixels.
 $9C55 XOR (HL)      ; Combine the mask with the pixels...
 $9C56 LD (HL),A     ; ...and store the result.
 $9C57 INC HL        ; Move on to the next pair.
 $9C58 DJNZ $9C53    ; Loop back until every pair has been converted.
@label=DecodeSprites_Next
*$9C5A POP BC        ; Restore the sprite counter.
 $9C5B DJNZ $9C2C    ; Loop back until every sprite has been decoded.
 $9C5D RET           ; Return.

; Find Sector
;
; Used by the routines at #R$9DFE, #R$A144, #R$A2B5, #R$A320, #R$A36C and
; #R$AC64.
; .
; Finds the sector that an entity is in. The nine sectors are numbered
; from #N$00 for the top left to #N$08 for the bottom right.
;
;   IX Entity
; O:D Sector number
@label=FindSector
c$9C5E LD A,(IX+$02) ; Fetch the X cell of the entity.
 $9C61 AND $30       ; Keep the sector column, which is a multiple of #N$10...
 $9C63 LD E,A        ; ...in #REGe.
 $9C64 LD A,(IX+$04) ; Fetch the Y cell of the entity.
 $9C67 AND $30       ; Keep the sector row...
 $9C69 XOR $30       ; ...and turn it round, as the first row of sectors is at the bottom
                     ; of the map...
 $9C6B SUB $10       ; ...and make it a multiple of #N$10 from #N$00 to #N($20), from the
                     ; top.
 $9C6D LD D,A        ; Keep the sector row.
 $9C6E ADD A,E       ; Add the column.
 $9C6F RRCA          ; Halve it...
 $9C70 ADD A,D       ; ...and add the row, so that the result is three times the row plus
                     ; the column, multiplied by #N$08.
 $9C71 RRCA          ; {Shift down by three...
 $9C72 RRCA          ;
 $9C73 RRCA          ; }
 $9C74 LD D,A        ; ...to give the sector number.
 $9C75 RET           ; Return.

; Queue Message
;
; Used by the routines at #R$9DA7, #R$9DFE, #R$9EC6, #R$A32B and #R$A36C.
; .
; Adds a message to the queue of messages that are shown in the message
; area. The queue holds eight messages, and if it is full then the message is
; lost.
;
; E Message number (#N$01 to #N($08), see #R$9D34)
; D Argument (the sector number for message #N$01)
@label=QueueMessage
c$9C76 LD HL,$966C   ; Point #REGhl at the queue.
 $9C79 LD B,$08      ; There are eight places in the queue.
@label=QueueMessage_Search
*$9C7B LD A,(HL)     ; Fetch the message number of the entry.
 $9C7C AND A         ; {Jump if the entry is free.
 $9C7D JR Z,$9C84    ; }
 $9C7F INC HL        ; Move on to the next entry...
 $9C80 INC HL        ; ...which is two bytes further on.
 $9C81 DJNZ $9C7B    ; Loop back until every entry has been checked.
 $9C83 RET           ; Return, as the queue is full.
@label=QueueMessage_Store
*$9C84 LD (HL),E     ; Store the message number.
 $9C85 INC HL        ; Move on to the argument.
 $9C86 LD (HL),D     ; Store the argument.
 $9C87 RET           ; Return.

; Print Message
;
; Used by the routine at #R$993C.
; .
; Called every frame. When the message area is being scrolled this does
; the scrolling. Otherwise it prints one more character of the first message in
; the queue, and when that is complete removes the message from the queue.
@label=PrintMessage
c$9C88 LD A,($9657)  ; Fetch the number of lines that are still to be scrolled.
 $9C8B AND A         ; {Jump to scroll the message area up by one pixel row if the number is
 $9C8C JR NZ,$9D07   ; not zero.}
 $9C8E LD A,($966B)  ; Fetch the number of characters that have been printed of the current
                     ; message.
 $9C91 AND A         ; Test whether it is zero.
 $9C92 LD A,($966C)  ; Fetch the number of the first message in the queue.
 $9C95 JR NZ,$9CB9   ; Jump if a message is being printed.
 $9C97 AND A         ; {Return if the queue is empty.
 $9C98 RET Z         ; }
 $9C99 LD A,($964F)  ; Fetch the flag that is set when the previous message has been
                     ; completed.
 $9C9C AND A         ; {Jump if the area has been scrolled for this message
 $9C9D JR Z,$9CB6    ; already.}
 $9C9F XOR A         ; {Clear the flag.
 $9CA0 LD ($964F),A  ; }
 $9CA3 LD A,$08      ; Scroll the message area by eight lines before the message is
                     ; printed...
 $9CA5 LD ($9657),A  ; ...by setting the counter.
 $9CA8 LD HL,$966C   ; Point #REGhl at #R$966C.
 $9CAB LD A,(HL)     ; Fetch its number.
 $9CAC DEC A         ; {Return if it is not message number one, which is
 $9CAD RET NZ        ; "SECTOR n".}
 $9CAE INC HL        ; Move on to the argument, which is the sector number.
 $9CAF LD A,(HL)     ; Fetch it.
 $9CB0 ADD A,$B1     ; Convert it into the digit that is the last character of the message
                     ; (the number of the first sector is zero, but it is shown as #N($31), and bit 7
                     ; is set as it is the last character).
 $9CB2 LD ($9D4D),A  ; Write it into the message.
 $9CB5 RET           ; Return.
@label=PrintMessage_Start
*$9CB6 LD A,($966C)  ; Fetch the number of the message.
@label=PrintMessage_Character
*$9CB9 ADD A,A       ; Double it to make an index into the table of messages.
 $9CBA LD HL,$9D34   ; Point #REGhl at #R$9D34.
 $9CBD ADD A,L       ; Add the index to the address.
 $9CBE LD L,A        ; Keep the low byte of the message address.
 $9CBF JR NC,$9CC2   ; Jump if there was no carry into the high byte.
 $9CC1 INC H         ; Otherwise carry into the high byte.
@label=PrintMessage_NoCarry
*$9CC2 LD E,(HL)     ; Fetch the address of the message...
 $9CC3 INC HL        ; ...from the table...
 $9CC4 LD D,(HL)     ; ...into #REGde.
 $9CC5 LD H,$00      ; Clear the high byte of the index.
 $9CC7 LD A,($966B)  ; Fetch the number of characters that have been printed.
 $9CCA LD L,A        ; Use it as the low byte of the index.
 $9CCB INC A         ; Add one...
 $9CCC LD ($966B),A  ; ...and store it as the new number of characters printed.
 $9CCF EX DE,HL      ; Swap the index and the address of the message.
 $9CD0 ADD HL,DE     ; Find the address of the next character.
 $9CD1 LD A,(HL)     ; Fetch it...
 $9CD2 LD C,A        ; ...and keep it in #REGc.
 $9CD3 LD HL,($5C36) ; Fetch the character set that the game uses...
 $9CD6 LD ($9618),HL ; ...and use it to print text.
 $9CD9 LD HL,$B028   ; Point #REGhl at the position of the first character, with an X
                     ; position of #N$28 and a Y position of #N$B0.
 $9CDC CALL $BD4B    ; Convert it to a screen address using #R$BD4B.
 $9CDF ADD HL,DE     ; Add the index of the character, so that each character is one column
                     ; further to the right.
 $9CE0 LD A,C        ; Fetch the character...
 $9CE1 AND $7F       ; ...without the flag for the last character.
 $9CE3 CALL $B5CB    ; Print it using #R$B5CB.
 $9CE6 LD A,C        ; Fetch the character again.
 $9CE7 AND $80       ; {Jump to #R$C072 if this is not the last character.
 $9CE9 JP Z,$C072    ; }
 $9CEC CALL $C072    ; Make the click for the character.
 $9CEF LD DE,$966C   ; Point #REGde at #R$966C.
 $9CF2 LD HL,$966E   ; Point #REGhl at #R$966E.
 $9CF5 LD BC,$0010   ; Remove the entry that has been shown by moving the
                     ; others down...
 $9CF8 LDIR          ; ...by one.
 $9CFA XOR A         ; {Clear the last entry.
 $9CFB LD (DE),A     ; }
 $9CFC INC DE        ; Move on to the second byte of the last entry.
 $9CFD LD (DE),A     ; Clear that too.
 $9CFE LD ($966B),A  ; Start the next message at its first character.
 $9D01 LD A,$01      ; Set the flag that says that the area has to be scrolled before the
                     ; next message is shown...
 $9D03 LD ($964F),A  ; ...and store it.
 $9D06 RET           ; Return.

; Scroll Message Area
;
; Used by the routine at #R$9C88.
; .
; Scrolls the pixels of the message area (#N$12 characters wide and #N$10
; pixel rows tall) up by one pixel row.
;
; A Number of lines still to scroll
@label=ScrollMessageArea
c$9D07 LD HL,$A828   ; Point #REGhl at the position of the message area, with an X position
                     ; of #N$28 and a Y position of #N$A8.
 $9D0A DEC A         ; One less line has to be scrolled.
 $9D0B LD ($9657),A  ; Store the new count.
 $9D0E CALL $BD4B    ; Convert the position into a screen address using
                     ; #R$BD4B.
 $9D11 LD C,$12      ; Scroll #N$12 columns, from left to right.
@label=ScrollMessageArea_Column
*$9D13 PUSH HL       ; Save the address of the top of the column.
 $9D14 LD B,$10      ; Each column is #N$10 pixels tall.
@label=ScrollMessageArea_Row
*$9D16 LD E,L        ; {Copy the address into #REGde, as the destination.
 $9D17 LD D,H        ; }
 $9D18 LD A,H        ; Fetch the high byte of the address.
 $9D19 INC H         ; Move #REGhl down by one pixel row.
 $9D1A CPL           ; {Jump if the pixel row is in the same character row.
 $9D1B AND $07       ;
 $9D1D JR NZ,$9D2A   ; }
 $9D1F LD A,H        ; {Otherwise go back to the first pixel row of the
 $9D20 SUB $08       ; character row...
 $9D22 LD H,A        ; }
 $9D23 LD A,L        ; Fetch the low byte of the address.
 $9D24 ADD A,$20     ; Add #N$20 (this result is not used).
 $9D26 LD A,L        ; {...and move down to the next character row.
 $9D27 ADD A,$20     ;
 $9D29 LD L,A        ; }
@label=ScrollMessageArea_Copy
*$9D2A LD A,(HL)     ; Fetch the byte from the pixel row below...
 $9D2B LD (DE),A     ; ...and copy it to the pixel row above.
 $9D2C DJNZ $9D16    ; Loop back until the column has been scrolled.
 $9D2E POP HL        ; Restore the address of the top of the column.
 $9D2F INC L         ; Move on to the next column.
 $9D30 DEC C         ; Count down the columns.
 $9D31 JR NZ,$9D13   ; Loop back until every column has been scrolled.
 $9D33 RET           ; Return.

; Message Table
;
; The addresses of the messages, which are numbered from #N$01. Message
; #N$00 does not exist. Each message has bit 7 of its last character set.
@label=MessageTable
w$9D34 DEFW $0000
 $9D36 DEFW $9D46
 $9D38 DEFW $9D4E
 $9D3A DEFW $9D5F
 $9D3C DEFW $9D6F
 $9D3E DEFW $9D78
 $9D40 DEFW $9D83
 $9D42 DEFW $9D8F
 $9D44 DEFW $9D97

; Messaging: Message Text
@label=Message_Sector
t$9D46 DEFM "SECTOR "," "+$80          ; Message number #N$01. The sector number is written into the
                                       ; last character, which is a space until a message with a sector number is
                                       ; printed. "SECTOR n".
@label=Message_ProgramSentFrom
 $9D4E DEFM "PROGRAM SENT FRO","M"+$80 ; Message number #N$02. "PROGRAM SENT
                                       ; FROM".
@label=Message_ProgramHasBeen
 $9D5F DEFM "PROGRAM HAS BEE","N"+$80  ; Message number #N$03. "PROGRAM HAS
                                       ; BEEN".
@label=Message_Destroyed
 $9D6F DEFM "DESTROYE","D"+$80         ; Message number #N$04. "DESTROYED".
@label=Message_BatteryLow
 $9D78 DEFM "BATTERY LO","W"+$80       ; Message number #N$05. "BATTERY LOW".
@label=Message_UnderAttack
 $9D83 DEFM "UNDER ATTAC","K"+$80      ; Message number #N$06. "UNDER ATTACK".
@label=Message_Critical
 $9D8F DEFM "CRITICA","L"+$80          ; Message number #N$07. "CRITICAL".
@label=Message_ProgramReceived
 $9D97 DEFM "PROGRAM RECIEVE","D"+$80  ; Message number #N$08. The game spells this "PROGRAM
                                       ; RECIEVED".

; Attack Sector
;
; Used by the routine at #R$993C.
; .
; Called every frame. It counts down to the next attack on one of the nine
; sectors. When the count reaches zero a sector is picked at random. If it still
; has some energy then it comes under attack, and the messages "SECTOR n" and
; "UNDER ATTACK" are queued. The attack lasts until the next sector is attacked.
@label=AttackSector
c$9DA7 LD A,($9646)  ; Fetch the number of frames until the next attack.
 $9DAA DEC A         ; Count down.
 $9DAB LD ($9646),A  ; Store it.
 $9DAE RET NZ        ; Return if it has not reached zero.
 $9DAF LD A,$50      ; Set the time until the next attack to #N$50 frames.
 $9DB1 LD ($9646),A  ; Store it.
 $9DB4 LD A,($9617)  ; Fetch the random number.
 $9DB7 AND $C6       ; Keep the bits that choose the sector (bits 1 and 2 give the column,
                     ; bits 6 and 7 the row).
 $9DB9 LD C,A        ; Keep the sector bits.
 $9DBA AND $C0       ; Test the row.
 $9DBC CP $C0        ; {Jump if it is #N($03), as there is no such row.
 $9DBE JR Z,$9DF2    ; }
 $9DC0 LD A,C        ; Fetch the number again.
 $9DC1 AND $06       ; Test the column.
 $9DC3 CP $06        ; {Jump if it is #N($03), as there is no such column.
 $9DC5 JR Z,$9DF2    ; }
 $9DC7 RRCA          ; Move the column into bits 0 and 1...
 $9DC8 LD D,A        ; ...and keep it in #REGd.
 $9DC9 LD A,C        ; Fetch the number again.
 $9DCA RLCA          ; {Move the row into bits 0 and 1...
 $9DCB RLCA          ; }
 $9DCC AND $03       ; ...clear the other bits...
 $9DCE LD E,A        ; ...and keep the row in #REGe.
 $9DCF RLCA          ; Double the row...
 $9DD0 ADD A,E       ; ...add the row to make three times the row...
 $9DD1 ADD A,D       ; ...and add the column to find the sector number.
 $9DD2 LD E,A        ; Keep the sector number...
 $9DD3 LD D,$00      ; ...and clear #REGd.
 $9DD5 LD HL,$A361   ; Point #REGhl at #R$A361.
 $9DD8 ADD HL,DE     ; Add the sector number.
 $9DD9 LD A,(HL)     ; Fetch the energy of the sector.
 $9DDA AND A         ; {Jump if the sector has no energy left, as it cannot be
 $9DDB JR Z,$9DFA    ; attacked.}
 $9DDD LD HL,$967E   ; Point #REGhl at #R$967E.
 $9DE0 ADD HL,DE     ; Add the sector number.
 $9DE1 SET 2,(HL)    ; Mark the sector as under attack.
 $9DE3 LD D,E        ; Use the sector number as the argument of the message...
 $9DE4 LD E,$01      ; ...for message #N($01), "SECTOR n".
 $9DE6 CALL $9C76    ; Queue the message using #R$9C76.
 $9DE9 LD DE,$0006   ; Queue message #N($06), "UNDER ATTACK"...
 $9DEC CALL $9C76    ; ...as well.
 $9DEF JP $ADC3      ; Mark the sector as the one under attack and colour the sector map
                     ; using #R$ADC3.
; The time until the next attack is shortened if there was no sector that
; could be attacked.
@label=AttackSector_Retry
*$9DF2 LD A,$20      ; Set the time until the next attack to #N$20 frames.
@label=AttackSector_Store
*$9DF4 LD ($9646),A  ; Store it.
 $9DF7 JP $ADC3      ; Mark the sector as the one under attack and colour the sector map
                     ; using #R$ADC3.
@label=AttackSector_NoEnergy
*$9DFA LD A,$01      ; Set the time until the next attack to one frame.
 $9DFC JR $9DF4      ; Jump back to store it.

; Send Program Packet
;
; Used by the routine at #R$993C.
; .
; Starts a program packet flying from a program transmitter, unless one is
; already on its way. It queues the messages "PROGRAM SENT FROM" and "SECTOR n".
;
; HL Address of the program transmitter in the map
@label=SendProgramPacket
c$9DFE LD A,($9770)    ; Fetch the type of the program packet (entity #N$0E).
 $9E01 AND A           ; {Return if it is already in use.
 $9E02 RET NZ          ; }
 $9E03 PUSH HL         ; Save the address of the transmitter...
 $9E04 PUSH HL         ; ...twice.
 $9E05 LD HL,$9770     ; Point #REGhl at #R$9770.
 $9E08 LD B,$10        ; Clear all #N$10 bytes of the entity.
@label=SendProgramPacket_ClearEntity
*$9E0A LD (HL),$00     ; Zero a byte.
 $9E0C INC HL          ; Move on to the next byte.
 $9E0D DJNZ $9E0A      ; Loop back until the entity has been cleared.
 $9E0F POP HL          ; Restore the address of the transmitter.
 $9E10 LD IX,$9770     ; Point #REGix at #R$9770.
 $9E14 LD (IX+$00),$6E ; Set the type of the entity to #N($6E), the first sprite of the
                       ; program packet.
 $9E18 LD DE,$C515     ; Point #REGde at #R$C515.
 $9E1B SBC HL,DE       ; Subtract it to find the offset of the transmitter.
 $9E1D LD A,L          ; Fetch the low byte of the offset.
 $9E1E AND $3F         ; The column is in the low six bits.
 $9E20 ADD HL,HL       ; {Multiply the offset by four...
 $9E21 ADD HL,HL       ; }
 $9E22 LD L,A          ; ...and keep the column in #REGl.
 $9E23 LD A,H          ; The row is in the high byte, in the low six bits.
 $9E24 AND $3F         ; Limit the row to #N$00-#N$3F...
 $9E26 LD H,A          ; ...and keep it in #REGh.
 $9E27 LD A,($9617)    ; Fetch the random number...
 $9E2A AND $3F         ; ...limited to #N$00-#N$3F...
 $9E2C LD (IX+$07),A   ; ...as a timer for the program packet.
 $9E2F LD (IX+$02),L   ; Set the X cell of the packet to that of the
                       ; transmitter.
 $9E32 LD (IX+$04),H   ; Set the Y cell of the packet to that of the
                       ; transmitter.
 $9E35 PUSH DE         ; Save the registers.
 $9E36 PUSH BC         ; Save the registers.
 $9E37 LD DE,$0002     ; Queue message #N($02), "PROGRAM SENT FROM"...
 $9E3A CALL $9C76      ; ...using #R$9C76.
 $9E3D CALL $9C5E      ; Find the sector that the packet is in using #R$9C5E.
 $9E40 LD E,$01        ; Queue message #N($01), "SECTOR n"...
 $9E42 CALL $9C76      ; ...using #R$9C76.
 $9E45 LD HL,$0105     ; Start effect #N$01 (five tones).
 $9E48 LD ($9688),HL   ; Store the length and the effect number for #R$BFDA.
 $9E4B POP BC          ; Restore the registers.
 $9E4C POP DE          ; Restore the registers.
 $9E4D POP HL          ; Restore the address of the transmitter.
 $9E4E RET             ; Return.

; Remove Entity
;
; Removes an entity. This routine is not used.
;
; IX Entity
@label=RemoveEntity
c$9E4F LD (IX+$00),$00 ; Set the type of the entity to zero.
 $9E53 POP HL          ; Discard the return address.
 $9E54 RET             ; Return to the caller of the routine that called this
                       ; one.

; Update Battery Bar
;
; Moves the displayed level of the battery bar by one pixel column towards
; the actual level, which is a number from #N$00 to #N$74. The bar is drawn by
; toggling the pixels of one column, so it is added to or taken away from the
; end of the bar. This is called every frame.
@label=UpdateBatteryBar_Increase
c$9E55 INC A         ; Add one to the displayed level.
 $9E56 LD B,A        ; Keep the displayed level.
 $9E57 LD HL,$943F   ; Point #REGhl at the position of the column before the first one
                     ; (which has an X position of #N$3F), so that when the level is added the column
                     ; that is drawn is the first one that is not yet lit.
 $9E5A JR $9E6C      ; Jump to draw the column.
; This entry point is used by the routine at #R$993C.
@label=UpdateBatteryBar
*$9E5C LD A,($963B)  ; Fetch the actual level of the battery.
 $9E5F LD B,A        ; Keep the actual level.
 $9E60 LD A,($963C)  ; Fetch the displayed level of the battery.
 $9E63 CP B          ; {Return if the two are the same.
 $9E64 RET Z         ; }
 $9E65 JR C,$9E55    ; Jump if the displayed level is lower than the actual
                     ; level.
 $9E67 LD B,A        ; Keep the displayed level.
 $9E68 DEC A         ; Take one pixel column off the displayed level.
 $9E69 LD HL,$9440   ; Point #REGhl at the position of the first column, which has an X
                     ; position of #N$40 and a Y position of #N$94.
@label=UpdateBatteryBar_Draw
*$9E6C LD ($963C),A  ; Store the new displayed level.
 $9E6F ADD A,L       ; Add the X position to find the X position of the column that is to
                     ; be drawn...
 $9E70 LD L,A        ; ...and put it in the position.
 $9E71 LD C,A        ; Keep the X position.
 $9E72 CALL $BD4B    ; Convert the position into a screen address using
                     ; #R$BD4B.
 $9E75 LD A,B        ; Fetch the level.
 $9E76 EX AF,AF'     ; Keep the level.
 $9E77 EXX           ; Switch to the shadow registers.
 $9E78 LD HL,$9EB9   ; Point #REGhl' at #R$9EB9.
 $9E7B EXX           ; Switch back to the main registers.
 $9E7C LD A,C        ; Fetch the X position.
 $9E7D CPL           ; Find the number of the bit that the column is in, as a number of
                     ; pixels from the right...
 $9E7E AND $07       ; ...limited to a character.
 $9E80 LD B,A        ; Keep the column within the character.
 $9E81 LD C,$08      ; The column has #N$08 rows.
 $9E83 INC B         ; Add one, as it will be used to shift the pattern.
 $9E84 EX AF,AF'     ; Fetch the level.
 $9E85 CP $05        ; {Jump if the level is at least five, as the column is then not part
 $9E87 JR NC,$9E9C   ; of the rounded end of the bar.}
 $9E89 LD D,B        ; Save the shift.
 $9E8A PUSH HL       ; Save the screen address.
 $9E8B LD HL,$9EC1   ; Point #REGhl at the table of the number of rows to skip at the top
                     ; and the bottom of the column.
 $9E8E CALL $BF92    ; Add the level, using #R$BF92.
 $9E91 LD B,(HL)     ; Fetch the number of rows to skip.
 $9E92 POP HL        ; Restore the screen address.
@label=UpdateBatteryBar_SkipRows
*$9E93 DEC C         ; Take off two rows from the end of the column...
 $9E94 DEC C         ; ...for each row that is skipped at the top...
 $9E95 INC H         ; ...and move down one pixel row.
 $9E96 EXX           ; Switch to the shadow registers...
 $9E97 INC HL        ; ...and skip a byte of the pattern...
 $9E98 EXX           ; ...and switch back.
 $9E99 DJNZ $9E93    ; Loop back until the rows have been skipped.
 $9E9B LD B,D        ; Restore the shift.
@label=UpdateBatteryBar_Row
*$9E9C EXX           ; Switch to the shadow registers.
 $9E9D LD A,(HL)     ; Fetch the next byte of the pattern.
 $9E9E INC HL        ; Move on to the next byte of the pattern.
 $9E9F EXX           ; Switch back to the main registers.
 $9EA0 EX DE,HL      ; Keep the screen address.
 $9EA1 LD L,A        ; Put the byte of the pattern in #REGhl...
 $9EA2 LD H,$00      ; ...as a two byte number.
 $9EA4 LD A,B        ; Fetch the level...
@label=UpdateBatteryBar_ShiftPattern
*$9EA5 ADD HL,HL     ; ...and shift the pattern left by the number of pixels needed to put
                     ; the pixel in the right place.
 $9EA6 DJNZ $9EA5    ; Restore the shift.
 $9EA8 LD B,A        ; Keep the level.
 $9EA9 EX DE,HL      ; Restore the screen address and the shifted pattern.
 $9EAA LD A,D        ; Fetch the first byte of the shifted pattern...
 $9EAB XOR (HL)      ; ...toggle it on the screen...
 $9EAC LD (HL),A     ; ...and store it.
 $9EAD INC L         ; Move on to the next byte of the screen.
 $9EAE LD A,E        ; Fetch the second byte of the shifted pattern...
 $9EAF XOR (HL)      ; ...toggle it on the screen...
 $9EB0 LD (HL),A     ; ...and store it.
 $9EB1 DEC L         ; Move back to the first byte.
 $9EB2 CALL $B558    ; Move down to the next pixel row using #R$B558.
 $9EB5 DEC C         ; Count down the rows.
 $9EB6 JR NZ,$9E9C   ; Loop back until the whole column has been drawn.
 $9EB8 RET           ; Return.

; Battery Bar Data
;
; The pattern of the pixels of a column of the battery bar, one byte per
; pixel row, followed by the number of rows that are skipped at the top and
; bottom of each of the first five columns, so that the bar has rounded ends.
@label=BatteryBarPattern
b$9EB9 DEFB $80,$40,$40,$20,$20,$40,$40,$80 ; The pattern of a column.
@label=BatteryBarRoundedEnd
 $9EC1 DEFB $03,$03,$03,$01,$01             ; The number of rows to skip for
                                            ; each of the first five columns.

; Check Battery Low
;
; Used by the routine at #R$993C.
; .
; Called every frame. If the battery is almost empty then the message
; "BATTERY LOW" is queued, once, and the battery bar flashes red and yellow.
;
; C Attribute
@label=CheckBatteryLow
c$9EC6 LD A,($963B)  ; Fetch the level of the battery.
 $9EC9 CP $18        ; {Jump if it is at least #N$18.
 $9ECB JR NC,$9F04   ; }
 $9ECD LD A,($9650)  ; Fetch the flag that says the message has been queued.
 $9ED0 AND A         ; {Jump if it has.
 $9ED1 JR NZ,$9EDD   ; }
 $9ED3 INC A         ; Set the flag...
 $9ED4 LD ($9650),A  ; ...and store it.
 $9ED7 LD DE,$0005   ; Queue message #N($05), "BATTERY LOW"...
 $9EDA CALL $9C76    ; ...using #R$9C76.
@label=CheckBatteryLow_Flash
*$9EDD LD A,($9615)  ; Fetch the frame counter.
 $9EE0 BIT 0,A       ; {Return on every other frame.
 $9EE2 RET NZ        ; }
 $9EE3 LD C,$42      ; Use red on black as the attribute.
 $9EE5 AND $02       ; {Test bit 1 of the frame counter, and jump to use red on black if it
 $9EE7 JR Z,$9EEB    ; is not set.}
 $9EE9 LD C,$46      ; Otherwise use yellow on black.
; This entry point is used by the routines at #R$A091 and #R$AC30.
; .
; This entry point sets the attribute of the battery bar.
@label=SetBatteryAttributes
*$9EEB LD HL,$9040   ; Point #REGhl at the position of the bar, with an X position of #N$40
                     ; and a Y position of #N$90.
 $9EEE CALL $BD6A    ; Convert it into an address in the attribute file using
                     ; #R$BD6A.
 $9EF1 LD E,$02      ; There are two rows of attributes.
@label=CheckBatteryLow_Row
*$9EF3 LD B,$0F      ; Each row is #N$0F characters wide.
 $9EF5 PUSH HL       ; Save the address of the start of the row.
@label=CheckBatteryLow_Column
*$9EF6 LD (HL),C     ; Set the attribute of a character.
 $9EF7 INC L         ; Move on to the next character.
 $9EF8 DJNZ $9EF6    ; Loop back until the row is done.
 $9EFA POP HL        ; Restore the address of the start of the row.
 $9EFB LD A,$20      ; Move down to the next row...
 $9EFD CALL $BF92    ; ...using #R$BF92.
 $9F00 DEC E         ; Count down the rows.
 $9F01 JR NZ,$9EF3   ; Loop back until both rows have been done.
 $9F03 RET           ; Return.
; The battery is not low, so the message can be queued again the next time
; it is.
@label=CheckBatteryLow_Ok
*$9F04 XOR A         ; Clear the flag...
 $9F05 LD ($9650),A  ; ...that says the message has been queued.
 $9F08 RET           ; Return.

; Check Pause
;
; Used by the routine at #R$993C.
; .
; Called every frame. Pressing SPACE on its own pauses the game, while the
; lights run round the border. Pressing it again resumes the game.
@label=CheckPause
c$9F09 LD A,$7E      ; Read the half-row of the keyboard that contains SPACE...
 $9F0B CALL $C0AB    ; ...using #R$C0AB.
 $9F0E BIT 0,A       ; {Return if SPACE is not being pressed.
 $9F10 RET Z         ; }
 $9F11 AND $1E       ; {Return if any of the other keys in the row are pressed.
 $9F13 RET NZ        ; }
 $9F14 CALL $C048    ; Make a beep using #R$C048.
@label=CheckPause_Release
*$9F17 LD A,$7E      ; Read the half-row of the keyboard that contains SPACE...
 $9F19 CALL $C0AB    ; ...using #R$C0AB.
 $9F1C BIT 0,A       ; {Loop back until SPACE has been released.
 $9F1E JR NZ,$9F17   ; }
 $9F20 LD HL,$0001   ; Set up a delay...
@label=CheckPause_Wait
*$9F23 LD C,$01      ; Tell #R$9F4D to start another light running round the
                     ; border...
 $9F25 CALL $9F4D    ; ...and wait for the next frame.
 $9F28 LD A,$7E      ; Read the half-row of the keyboard that contains SPACE...
 $9F2A CALL $C0AB    ; ...using #R$C0AB.
 $9F2D BIT 0,A       ; {Loop back until SPACE is pressed again.
 $9F2F JR Z,$9F23    ; }
@label=CheckPause_Resume
*$9F31 LD C,$01      ; Tell #R$9F4D to start another light running round the
                     ; border...
 $9F33 CALL $9F4D    ; ...and wait for the next frame.
 $9F36 LD A,$7E      ; Read the half-row of the keyboard that contains SPACE...
 $9F38 CALL $C0AB    ; ...using #R$C0AB.
 $9F3B BIT 0,A       ; {Loop back until SPACE has been released.
 $9F3D JR NZ,$9F31   ; }
 $9F3F LD HL,$0001   ; Set up a delay...
 $9F42 CALL $C027    ; ...and make a click using #R$C027.
@label=CheckPause_Finish
*$9F45 LD C,$00      ; Tell #R$9F4D not to start any more lights...
 $9F47 CALL $9F4D    ; ...and wait for the next frame.
 $9F4A JR NZ,$9F45   ; Loop back until the lights have all finished.
 $9F4C RET           ; Return.

; Wait For Frame
;
; Used by the routine at #R$9F09.
; .
; Waits for the next frame interrupt and then moves the lights that run
; round the border.
;
;   C #N$01 to start a new light, or #N$00 to leave the lights as they are
; O:F The zero flag is set if there are no lights left
@label=WaitForFrame
c$9F4D PUSH BC       ; Save the register.
 $9F4E LD IY,($9613) ; Restore #REGiy, which the ROM interrupt routine needs.
 $9F52 EI            ; Enable interrupts.
 $9F53 HALT          ; Wait for the next interrupt.
 $9F54 DI            ; Disable interrupts again.
 $9F55 POP BC        ; Restore the register.
 $9F56 LD A,C        ; Fetch the flag.
 $9F57 CALL $AF25    ; Move the lights using #R$AF25.
 $9F5A RET           ; Return.

; Entity Handler Table
;
; The routine that runs each frame for an entity of each type. The type is
; the first byte of the entity, and bit 7 (which flips the sprite) is ignored.
; The numbers are also the numbers of the sprites that are drawn for the entity.
; The handlers are shown in the order they appear in the table.
; #TABLE(default,centre)
; { =h Types | =h Handler }
; { #N($00), #N$4C-#N($4D), #N$59-#N$5F and #N$68-#N$6D | #R$A625 (returns) }
; { #N$01 | #R$B059 (does nothing) }
; { #N$02-#N$07 | #R$B05A }
; { #N$08-#N$0B | #R$A826 }
; { #N$0C-#N$0F | #R$A833 }
; { #N$10-#N$13 and #N$18-#N$1B | #R$AB03 }
; { #N$14-#N$17 and #N$1C-#N$1F | #R$AAFD }
; { #N$20-#N$2F | #R$A8A4 }
; { #N$30-#N$37 | #R$A6E0 }
; { #N$38-#N$3A | #R$A70A }
; { #N$3B | #R$A713 }
; { #N$3C-#N$3F | #R$A144 }
; { #N$40-#N$4A | #R$A932 }
; { #N$4B | #R$A98B }
; { #N$4E-#N$4F | #R$A082 }
; { #N$50-#N$53 | #R$A218 }
; { #N$54-#N$56 | #R$A20D }
; { #N$57 | #R$A213 }
; { #N$58 | #R$A04B }
; { #N$60-#N$63 | #R$A4EC }
; { #N$64-#N$67 | #R$A2B5 }
; { #N$6E-#N$6F | #R$A36C }
; { #N$70-#N$73 | #R$B063 }
; { #N$74-#N$77 | #R$A4DC }
; TABLE#
@label=EntityHandlers
w$9F5B DEFW $A625,$B059,$B05A,$B05A,$B05A,$B05A,$B05A,$B05A
 $9F6B DEFW $A826,$A826,$A826,$A826,$A833,$A833,$A833,$A833
 $9F7B DEFW $AB03,$AB03,$AB03,$AB03,$AAFD,$AAFD,$AAFD,$AAFD
 $9F8B DEFW $AB03,$AB03,$AB03,$AB03,$AAFD,$AAFD,$AAFD,$AAFD
 $9F9B DEFW $A8A4,$A8A4,$A8A4,$A8A4,$A8A4,$A8A4,$A8A4,$A8A4
 $9FAB DEFW $A8A4,$A8A4,$A8A4,$A8A4,$A8A4,$A8A4,$A8A4,$A8A4
 $9FBB DEFW $A6E0,$A6E0,$A6E0,$A6E0,$A6E0,$A6E0,$A6E0,$A6E0
 $9FCB DEFW $A70A,$A70A,$A70A,$A713,$A144,$A144,$A144,$A144
 $9FDB DEFW $A932,$A932,$A932,$A932,$A932,$A932,$A932,$A932
 $9FEB DEFW $A932,$A932,$A932,$A98B,$A625,$A625,$A082,$A082
 $9FFB DEFW $A218,$A218,$A218,$A218,$A20D,$A20D,$A20D,$A213
 $A00B DEFW $A04B,$A625,$A625,$A625,$A625,$A625,$A625,$A625
 $A01B DEFW $A4EC,$A4EC,$A4EC,$A4EC,$A2B5,$A2B5,$A2B5,$A2B5
 $A02B DEFW $A625,$A625,$A625,$A625,$A625,$A625,$A36C,$A36C
 $A03B DEFW $B063,$B063,$B063,$B063,$A4DC,$A4DC,$A4DC,$A4DC

; Start Robot Life
;
; The handler for entity type #N($58), which is the robot at the start of
; a life. A block of the panel flashes while a counter counts down, and then the
; robot starts to materialise (type #N$40).
;
; IX Entity
@label=StartRobotLife
c$A04B DEC (IX+$06)    ; {Count down the timer of the entity, and jump to start the robot
 $A04E JR Z,$A07D      ; materialising when it reaches zero.}
 $A050 LD A,(IX+$06)   ; Fetch the timer.
 $A053 AND $03         ; Use the low two bits...
 $A055 PUSH AF         ; ...to make a beep using #R$C027 on every fourth
                       ; frame...
 $A056 CALL Z,$C027    ; ...by saving them...
 $A059 POP AF          ; ...and restoring them.
 $A05A AND $02         ; {Use bright black as the attribute, unless bit 1 of the timer is
 $A05C LD A,$40        ; set...
 $A05E JR Z,$A062      ; }
 $A060 OR $10          ; ...in which case add red paper.
@label=StartRobotLife_KeepAttribute
*$A062 LD E,A          ; Keep the attribute.
 $A063 LD HL,$5859     ; Point #REGhl at the attributes of a block of the
                       ; panel...
 $A066 LD BC,$0602     ; ...which is six characters wide (#REGb) and two characters tall
                       ; (#REGc).
@label=StartRobotLife_Row
*$A069 PUSH BC         ; Save the dimensions...
 $A06A PUSH HL         ; ...and the address of the start of the row.
@label=StartRobotLife_Column
*$A06B LD A,(HL)       ; Fetch an attribute...
 $A06C AND $07         ; {...keep the ink and combine it with the new
 $A06E OR E            ; attribute...}
 $A06F LD (HL),A       ; ...and store it.
 $A070 INC L           ; Move on to the next attribute.
 $A071 DJNZ $A06B      ; Loop back until the row is done.
 $A073 POP HL          ; Restore the address of the start of the row...
 $A074 LD BC,$0020     ; {...and move down to the next row.
 $A077 ADD HL,BC       ; }
 $A078 POP BC          ; Restore the dimensions.
 $A079 DEC C           ; Count down the rows.
 $A07A JR NZ,$A069     ; Loop back until both rows have been done.
 $A07C RET             ; Return.
@label=StartRobotLife_Materialise
*$A07D LD (IX+$00),$40 ; Start the robot materialising by setting its type to
                       ; #N$40.
 $A081 RET             ; Return.

; Flicker Transmitter
;
; The handler for entity types #N$4E and #N($4F), which are the program
; transmitters. A transmitter flickers between its two sprites.
;
; IX Entity
@label=FlickerTransmitter
c$A082 LD A,($9617)   ; Fetch the random number...
 $A085 AND $03        ; ...limited to #N$00-#N$03.
 $A087 RES 0,(IX+$00) ; Show the first sprite.
 $A08B RET NZ         ; Return unless the random number was zero.
 $A08C SET 0,(IX+$00) ; Otherwise show the second sprite.
 $A090 RET            ; Return.

; Recharge Battery
;
; Used by the routines at #R$A99F and #R$B6BC.
; .
; Recharges the battery fully and shows the number of lives that are left,
; using a small picture of the robot followed by the number.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$98E0,stop=$98EC,clear=1,sp=$5E00)
; #SIM(start=$98EC,stop=$98EF)
; #SIM(start=$98EF,stop=$98F2)
; #SIM(start=$98F2,stop=$98F5)
; #SIM(start=$98F5,stop=$98F8)
; #POKES$5C36,$00;$5C37,$3C;$968B,$05
; #SIM(start=$9A65,stop=$9A68)
; #SCR$02(recharge-battery-before)
; | #SIM(start=$B6CA,stop=$B6CD)
; #SCR$02(recharge-battery-after) } UDGTABLE# #POPS
@label=RechargeBattery
c$A091 LD A,$74      ; Set the level of the battery to the maximum of #N$74...
 $A093 LD ($963B),A  ; ...as the target level.
 $A096 LD C,$46      ; Use bright yellow as the attribute...
 $A098 CALL $9EEB    ; ...and set the attributes of the battery bar using
                     ; #R$9EEB.
 $A09B LD A,($968C)  ; This fetch has no effect, as #REGa is replaced
                     ; immediately.
 $A09E LD HL,$60E7   ; Point #REGhl at the address of the sprite that is the picture of the
                     ; robot...
 $A0A1 LD E,(HL)     ; {...and fetch it into #REGde.
 $A0A2 INC HL        ;
 $A0A3 LD D,(HL)     ; }
 $A0A4 LD HL,$57E0   ; Point #REGhl at the position in the display file where the picture
                     ; of the robot is drawn.
 $A0A7 LD A,($968B)  ; Fetch the number of lives.
 $A0AA AND A         ; {Skip the picture if there are none left.
 $A0AB JR Z,$A0B2    ; }
 $A0AD LD C,A        ; Keep the number.
 $A0AE INC DE        ; Move on to the height byte of the sprite.
 $A0AF CALL $A0CB    ; Draw the picture using #R$A0CB.
@label=RechargeBattery_ShowLives
*$A0B2 LD A,($968B)  ; Fetch the number of lives.
 $A0B5 ADD A,$B0     ; Convert it into a digit with bit 7 set...
 $A0B7 LD ($A0CA),A  ; ...and write it into the text.
 $A0BA LD HL,($5C36) ; Fetch the character set that the game uses...
 $A0BD LD ($9618),HL ; ...and use it to print text.
 $A0C0 LD HL,$A818   ; Point #REGhl at the position of the number of lives.
 $A0C3 LD DE,$A0C9   ; Point #REGde at #R$A0C9.
 $A0C6 JP $B52E      ; Print the number in double height characters using
                     ; #R$B52E.

; Messaging: Lives Text
;
; The attribute and the digit of the number of lives that are left.
@label=Text_Lives
t$A0C9 DEFM $46,$00  ; Attribute: #COLOUR(#PEEK(#PC)) + the number of lives.

; Draw Icon
;
; Used by the routines at #R$A091 and #R$AD34.
; .
; Draws the pixels of a sprite that is three bytes wide, without its mask.
; The sprite is drawn from the bottom upwards, leaving out its first two rows
; (at the bottom) and its last row (at the top). This is used to draw the
; picture that shows the lives that are left.
;
;   DE Address of the height byte of the sprite
;   HL Screen address of the bottom left of the icon
; O:HL Screen address four characters to the right of the icon
@label=DrawIcon
c$A0CB PUSH HL       ; Save the screen address...
 $A0CC PUSH DE       ; ...and the sprite address.
 $A0CD LD A,(DE)     ; Fetch the height of the sprite...
 $A0CE SUB $03       ; ...and take three rows off it, as that is the number
                     ; that are drawn.
 $A0D0 LD B,A        ; Use that as the counter.
 $A0D1 LD A,E        ; {Skip the height byte and the first two rows of the
 $A0D2 ADD A,$0D     ; sprite.
 $A0D4 LD E,A        ;
 $A0D5 LD A,D        ;
 $A0D6 ADC A,$00     ;
 $A0D8 LD D,A        ; }
 $A0D9 EX DE,HL      ; Point #REGhl at the sprite data and #REGde at the
                     ; screen.
; Each row of the sprite has three pairs of bytes. The mask byte and the
; other byte are combined to find the pixels.
@label=DrawIcon_Row
*$A0DA LD A,(HL)     ; Fetch the first mask byte...
 $A0DB INC HL        ; ...and move on to the other byte.
 $A0DC XOR (HL)      ; Combine the two...
 $A0DD LD (DE),A     ; ...and write the pixels to the screen.
 $A0DE INC E         ; Move on to the next byte of the screen.
 $A0DF INC HL        ; Move on to the next pair.
 $A0E0 LD A,(HL)     ; Fetch the second mask byte...
 $A0E1 INC HL        ; ...and move on to the other byte.
 $A0E2 XOR (HL)      ; Combine the two...
 $A0E3 LD (DE),A     ; ...and write the pixels to the screen.
 $A0E4 INC E         ; Move on to the next byte of the screen.
 $A0E5 INC HL        ; Move on to the next pair.
 $A0E6 LD A,(HL)     ; Fetch the third mask byte...
 $A0E7 INC HL        ; ...and move on to the other byte.
 $A0E8 XOR (HL)      ; Combine the two...
 $A0E9 LD (DE),A     ; ...and write the pixels to the screen.
 $A0EA INC HL        ; Move on to the next row of the sprite.
 $A0EB DEC E         ; {Move back to the start of the row on the screen.
 $A0EC DEC E         ; }
 $A0ED LD A,D        ; {Move up one pixel row on the screen.
 $A0EE DEC D         ; }
 $A0EF AND $07       ; {Jump if that is still inside the same character row.
 $A0F1 JR NZ,$A0FB   ; }
 $A0F3 LD A,D        ; {Otherwise go back to the bottom pixel row of the
 $A0F4 ADD A,$08     ; character row...
 $A0F6 LD D,A        ; }
 $A0F7 LD A,E        ; {...and move up to the next character row.
 $A0F8 SUB $20       ;
 $A0FA LD E,A        ; }
@label=DrawIcon_NextRow
*$A0FB DJNZ $A0DA    ; Loop back until every row has been drawn.
 $A0FD POP DE        ; Restore the sprite address...
 $A0FE POP HL        ; ...and the screen address.
 $A0FF LD A,L        ; {Move four characters to the right.
 $A100 ADD A,$04     ;
 $A102 LD L,A        ; }
 $A103 RET           ; Return.

; Remove Distant Entity
;
; Used by the routines at #R$A218, #R$A4EC, #R$A826 and #R$A833.
; .
; Removes an entity that is twelve cells or more from the camera in either
; direction. When the entity is removed the handler that called this routine is
; finished too.
;
; IX Entity
@label=RemoveDistantEntity
c$A104 LD A,($9692)    ; Fetch the X cell of the camera.
 $A107 SUB (IX+$02)    ; Subtract the X cell of the entity.
 $A10A JP P,$A10F      ; {Make the difference positive.
 $A10D NEG             ; }
@label=RemoveDistantEntity_TestX
*$A10F CP $0C          ; {Jump to remove the entity if it is twelve or more
 $A111 JR NC,$A121     ; cells away.}
 $A113 LD A,($9694)    ; Fetch the Y cell of the camera.
 $A116 SUB (IX+$04)    ; Subtract the Y cell of the entity.
 $A119 JP P,$A11E      ; {Make the difference positive.
 $A11C NEG             ; }
@label=RemoveDistantEntity_TestY
*$A11E CP $0C          ; {Return if the entity is less than twelve cells away.
 $A120 RET C           ; }
@label=RemoveDistantEntity_Remove
*$A121 LD (IX+$00),$00 ; Remove the entity by setting its type to zero.
 $A125 POP HL          ; Discard the return address, so that the handler stops
                       ; here.
 $A126 RET             ; Return.

; Set Robot Facing
;
; Used by the routines at #R$9A4B and #R$B74D.
; .
; Sets the type that the robot takes on when it has finished
; materialising, which is the first of the sprites of the robot walking.
@label=SetRobotFacing
c$A127 LD A,$10      ; Use type #N$10...
 $A129 LD ($9695),A  ; ...as the type that the robot takes on after the sequence of sprites
                     ; that shows it materialising.
 $A12C RET           ; Return.

; Try Move
;
; Used by the routines at #R$A144, #R$A218, #R$A36C, #R$A4EC, #R$A6E0 and
; #R$A833.
; .
; Moves an entity in the direction that it is heading, using #R$A9C3, and
; then tests whether it has been blocked. An entity that is blocked by a cell of
; type #N$0F is allowed to carry on.
;
;   B Number of steps that can still be taken
;   DE X position
;   HL Y position
; O:A The type of the cell that is blocking the entity
; O:F The zero flag is set if the entity can carry on
@label=TryMove
c$A12D CALL $A9C3    ; {Move using #R$A9C3, and return if the entity can carry
 $A130 RET Z         ; on.}
 $A131 PUSH HL       ; Save the Y position.
 $A132 LD HL,($962E) ; Fetch the address of the cell that blocked the entity...
 $A135 LD A,(HL)     ; ...and fetch its type.
 $A136 AND $0F       ; Keep the current type of the cell.
 $A138 POP HL        ; Restore the Y position.
 $A139 CP $0F        ; {Return if the cell is not type #N$0F.
 $A13B RET NZ        ; }
 $A13C LD HL,($9655) ; Otherwise restore the Y position that the entity had before the
                     ; move...
 $A13F LD DE,($9653) ; ...and the X position.
 $A143 RET           ; Return with the zero flag set.

; Move Spark
;
; The handler for entity types #N$3C to #N($3F), which are the shots that
; the robot fires using the first weapon. A shot moves across the map until it
; hits something or has run out of range. The shot destroys the contents of the
; cell that it hits, apart from the cells that are solid.
;
; IX Entity
@label=MoveSpark
c$A144 CALL $B063      ; Move on to the next sprite using #R$B063.
 $A147 CALL $AED3      ; Fetch the position of the shot.
 $A14A LD B,$60        ; The shot can take up to #N$60 steps in this frame.
@label=MoveSpark_Step
*$A14C CALL $A12D      ; Take a step using #R$A12D.
 $A14F JR NZ,$A190     ; Jump if the shot has hit something.
 $A151 LD A,E          ; {Jump if the shot is not at the start of a cell.
 $A152 OR L            ;
 $A153 JR NZ,$A165     ; }
 $A155 LD A,(IX+$07)   ; Fetch the range of the shot...
 $A158 SUB $10         ; ...take away one cell...
 $A15A LD (IX+$07),A   ; ...and store it.
 $A15D AND $F0         ; {Jump to explode the shot if it has run out of range.
 $A15F JR Z,$A18A      ; }
 $A161 LD A,B          ; {Loop back to take another step if there are steps
 $A162 AND A           ; left.
 $A163 JR NZ,$A14C     ; }
; This entry point is used by the routine at #R$A6E0.
@label=MoveSpark_Store
*$A165 CALL $AEE0      ; Store the new position of the shot.
 $A168 CALL $A5A7      ; Check whether it has hit an enemy using #R$A5A7.
 $A16B LD A,(IX+$00)   ; {Fetch the type of the shot, and draw it using #R$BDCD unless it has
 $A16E CP $38          ; become smoke.
 $A170 JP NZ,$BDCD     ; }
 $A173 LD A,(IY+$08)   ; {Fetch the item that the enemy was carrying, and draw the shot if it
 $A176 AND A           ; was not carrying any.
 $A177 JP Z,$BDCD      ; }
 $A17A LD C,A          ; Keep the item.
 $A17B LD HL,($962E)   ; Fetch the address of the cell that the shot was in.
 $A17E LD A,(HL)       ; Fetch the contents of the cell.
 $A17F AND $F0         ; {Keep the initial type of the cell and use the item as the current
 $A181 OR C            ; type, so that the enemy drops it.}
 $A182 LD (HL),A       ; Store the new contents of the cell.
 $A183 XOR A           ; Clear the item that the enemy was carrying...
 $A184 LD (IY+$08),A   ; ...and store it.
 $A187 JP $BDCD        ; Draw the shot using #R$BDCD.
@label=MoveSpark_Explode
*$A18A LD (IX+$00),$38 ; Turn the shot into smoke by changing its type to
                       ; #N$38.
 $A18E JR $A165        ; Store the position.
; The shot has hit something.
@label=MoveSpark_Hit
*$A190 PUSH DE         ; Save the X position.
 $A191 LD DE,$0010     ; Each entity is #N$10 bytes long.
 $A194 LD B,$02        ; There are two entities that are used for puffs of
                       ; smoke.
 $A196 LD IY,$98B0     ; Point #REGiy at #R$98B0.
@label=MoveSpark_FindPuff
*$A19A LD A,(IY+$00)   ; {Fetch its type, and jump if it is not being used.
 $A19D AND A           ;
 $A19E JR Z,$A1A7      ; }
 $A1A0 ADD IY,DE       ; Move on to the next one.
 $A1A2 DJNZ $A19A      ; Loop back until both have been tried.
 $A1A4 POP DE          ; Restore the X position.
 $A1A5 JR $A18A        ; Make the shot explode without hitting the cell, as there is no puff
                       ; to use.
@label=MoveSpark_Unused
*$A1A7 POP DE          ; Restore the X position.
 $A1A8 PUSH HL         ; Save the Y position.
 $A1A9 LD HL,($962E)   ; Fetch the address of the cell that was hit.
 $A1AC LD A,(HL)       ; Fetch its contents.
 $A1AD AND $0F         ; Keep the current type of the cell.
 $A1AF CP $05          ; {Jump to explode the shot if the type is #N$05.
 $A1B1 JR Z,$A1E2      ; }
 $A1B3 CP $04          ; {Jump to explode the shot if the type is #N$04.
 $A1B5 JR Z,$A1E2      ; }
 $A1B7 CP $01          ; {Jump to explode the shot if the type is #N$01.
 $A1B9 JR Z,$A1E2      ; }
 $A1BB CP $07          ; {Jump to explode the shot if the type is #N$07.
 $A1BD JR Z,$A1E2      ; }
 $A1BF CP $08          ; {Jump to explode the shot if the type is #N$08.
 $A1C1 JR Z,$A1E2      ; }
 $A1C3 CP $09          ; {Jump to explode the shot if the type is #N$09.
 $A1C5 JR Z,$A1E2      ; }
 $A1C7 CP $0C          ; {Jump to explode the shot if the type is #N$0C.
 $A1C9 JR Z,$A1E2      ; }
 $A1CB CP $0E          ; {Jump to explode the shot if the type is #N$0E.
 $A1CD JR Z,$A1E2      ; }
 $A1CF LD A,(HL)       ; Fetch the contents of the cell again...
 $A1D0 AND $F0         ; {...and keep the initial type, so that the cell is
 $A1D2 JR $A1E5        ; emptied.}
@label=MoveSpark_Replace
*$A1D4 LD (HL),A       ; Store the new contents of the cell.
 $A1D5 LD (IY+$00),$54 ; Start a puff of smoke...
 $A1D9 LD HL,($962C)   ; ...at the position of the cell.
 $A1DC LD (IY+$02),L   ; Set the X cell of the puff...
 $A1DF LD (IY+$04),H   ; ...and then its Y cell.
@label=MoveSpark_Restore
*$A1E2 POP HL          ; Restore the Y position.
 $A1E3 JR $A18A        ; Make the shot explode.
@label=MoveSpark_Destroy
*$A1E5 LD C,A          ; Keep the initial type of the cell.
 $A1E6 LD A,(HL)       ; Fetch the contents of the cell...
 $A1E7 AND $0F         ; ...and keep its current type.
 $A1E9 CP $02          ; {Jump to empty the cell if it is not type #N$02 (an installed
 $A1EB LD A,C          ; program).
 $A1EC JR NZ,$A1D4     ; }
 $A1EE PUSH AF         ; Save the contents...
 $A1EF PUSH DE         ; ...and the X position...
 $A1F0 PUSH HL         ; ...and the Y position.
 $A1F1 CALL $9C5E      ; Find the sector that the cell is in using #R$9C5E.
 $A1F4 LD E,D          ; {Use the sector number as an index.
 $A1F5 LD D,$00        ; }
 $A1F7 LD HL,$965B     ; Point #REGhl at #R$965B.
 $A1FA ADD HL,DE       ; Add the index.
 $A1FB LD A,(HL)       ; {Fetch the flag, and jump if the sector has been activated (as its
 $A1FC AND A           ; programs are safe).
 $A1FD JR NZ,$A207     ; }
 $A1FF CALL $A32B      ; Otherwise take one unit of energy off the sector using
                       ; #R$A32B.
 $A202 POP HL          ; Restore the Y position...
 $A203 POP DE          ; ...and the X position...
 $A204 POP AF          ; ...and the contents.
 $A205 JR $A1D4        ; Jump back to empty the cell.
@label=MoveSpark_Safe
*$A207 POP HL          ; Restore the Y position...
 $A208 POP DE          ; ...and the X position...
 $A209 POP AF          ; ...and the contents.
 $A20A LD A,(HL)       ; Fetch the contents of the cell, which are left as they
                       ; are.
 $A20B JR $A1D4        ; Jump back to start the puff of smoke.

; Animate Cloud
;
; The handler for entity types #N$54 to #N($56), which are the sprites of
; a cloud of smoke. It moves on to the next sprite and draws it. The last sprite
; of the cloud is handled by #R$A213.
;
; IX Entity
@label=AnimateCloud
c$A20D INC (IX+$00)  ; Move on to the next sprite.
 $A210 JP $BDCD      ; Draw the cloud using #R$BDCD.

; Remove Cloud
;
; The handler for entity type #N($57), which is the last sprite of a cloud
; of smoke. It removes the cloud.
;
; IX Entity
@label=RemoveCloud
c$A213 LD (IX+$00),$00 ; Remove the entity by setting its type to zero.
 $A217 RET             ; Return.

; Move Thief
;
; The handler for entity types #N$50 to #N($53), the enemies that go after
; the programs. The enemy heads for the robot, and picks up any program (map
; cell type #N$06) that is in the way. If the enemy is shot then it drops the
; program.
;
; IX Entity
@label=MoveThief
c$A218 CALL $B063    ; Move on to the next sprite using #R$B063.
 $A21B CALL $A104    ; Remove the enemy if it is far away from the camera using
                     ; #R$A104.
 $A21E CALL $AED3    ; Fetch the position of the enemy.
 $A221 LD B,$40      ; The enemy can take up to #N$40 steps in this frame.
@label=MoveThief_Step
*$A223 CALL $A12D    ; Take a step using #R$A12D.
 $A226 JR NZ,$A241   ; Jump if the enemy has been blocked by a cell.
 $A228 CALL $A576    ; Check whether another enemy is in the way using #R$A576.
 $A22B JR C,$A278    ; Jump if there is.
 $A22D LD A,E        ; {Jump if the enemy is not at the start of a cell.
 $A22E OR L          ;
 $A22F JR NZ,$A23B   ; }
 $A231 CALL $A282    ; Choose a new direction using #R$A282...
 $A234 LD (IX+$07),A ; ...and store it.
 $A237 LD A,B        ; {Loop back to take another step if there are steps left.
 $A238 AND A         ;
 $A239 JR NZ,$A223   ; }
@label=MoveThief_Store
*$A23B CALL $AEE0    ; Store the new position of the enemy.
 $A23E JP $BDCD      ; Draw the enemy using #R$BDCD.
; The enemy has been blocked by a cell.
@label=MoveThief_Blocked
*$A241 PUSH HL       ; Save the Y position.
 $A242 LD HL,($962E) ; Fetch the address of the cell that blocked the enemy...
 $A245 LD A,(HL)     ; ...and its type.
 $A246 AND $0F       ; {Jump unless it is a program (type #N$06).
 $A248 CP $06        ;
 $A24A JR NZ,$A259   ; }
 $A24C LD B,A        ; Keep the type.
 $A24D LD A,(IX+$08) ; Fetch the item that the enemy is carrying.
 $A250 AND A         ; {Jump if it is carrying one already.
 $A251 JR NZ,$A259   ; }
 $A253 CALL $A2AD    ; Remove the program from the cell using #R$A2AD...
 $A256 POP HL        ; ...after restoring the Y position...
 $A257 JR $A23B      ; ...and carry on. (The enemy has picked up the program, and takes it
                     ; away.)
@label=MoveThief_Skip
*$A259 POP HL        ; Restore the Y position.
 $A25A LD A,($9615)  ; Fetch the frame counter.
 $A25D AND $01       ; {Test the lowest bit of the frame counter, and jump on every other
 $A25F JR Z,$A273    ; frame to choose a direction towards the robot.}
 $A261 LD A,($9617)  ; Otherwise fetch the random number...
 $A264 AND $03       ; ...limited to #N$00-#N$03...
 $A266 CP (IX+$07)   ; {...and jump unless it is the direction that the enemy is already
 $A269 JR NZ,$A26E   ; heading in.}
 $A26B INC A         ; {Otherwise use the next direction.
 $A26C AND $03       ; }
@label=MoveThief_Direction
*$A26E LD (IX+$07),A ; Store the new direction.
 $A271 JR $A23B      ; Carry on.
@label=MoveThief_Towards
*$A273 CALL $A282    ; Choose a direction towards the robot using #R$A282.
 $A276 JR $A26E      ; Carry on.
; The enemy is in the way of another enemy.
@label=MoveThief_Reverse
*$A278 CALL $A891    ; Turn the enemy round using #R$A891.
 $A27B CALL $BDCD    ; Draw the enemy using #R$BDCD.
 $A27E RET NC        ; Return if it was not drawn.
 $A27F JP $C048      ; Otherwise make a sound using #R$C048.

; Find Direction To Robot
;
; Used by the routines at #R$A218 and #R$A4EC.
; .
; Chooses a direction for an enemy, at random, that heads towards the
; robot in either the X direction or the Y direction.
;
;   IX Entity
; O:A Direction (#N$00 to #N$03)
@label=FindDirectionToRobot
c$A282 LD A,($9617)  ; Fetch the random number.
 $A285 CP $80        ; {Jump to use the Y direction if the number is below
 $A287 JR C,$A29B    ; #N$80.}
 $A289 LD A,($9692)  ; Fetch the X cell of the camera...
 $A28C SUB (IX+$02)  ; ...and subtract the X cell of the entity.
 $A28F AND $3F       ; Limit the difference to #N$00-#N$3F.
 $A291 CP $20        ; {Jump if the robot is less than #N$20 cells ahead.
 $A293 JR C,$A298    ; }
 $A295 LD A,$00      ; Otherwise use direction zero...
 $A297 RET           ; ...and return.
@label=FindDirectionToRobot_DirectionTwo
*$A298 LD A,$02      ; Use direction two...
 $A29A RET           ; ...and return.
@label=FindDirectionToRobot_Y
*$A29B LD A,($9694)  ; Fetch the Y cell of the camera...
 $A29E SUB (IX+$04)  ; ...and subtract the Y cell of the entity.
 $A2A1 AND $3F       ; Limit the difference to #N$00-#N$3F.
 $A2A3 CP $20        ; {Jump if the robot is less than #N$20 cells ahead.
 $A2A5 JR C,$A2AA    ; }
 $A2A7 LD A,$03      ; Otherwise use direction three...
 $A2A9 RET           ; ...and return.
@label=FindDirectionToRobot_DirectionOne
*$A2AA LD A,$01      ; Use direction one...
 $A2AC RET           ; ...and return.

; Empty Cell
;
; Used by the routines at #R$A218 and #R$A4EC.
; .
; Sets the current type of the cell that last blocked an entity to zero,
; leaving its initial type as it was.
@label=EmptyCell
c$A2AD LD HL,($962E) ; Fetch the address of the cell.
 $A2B0 LD A,(HL)     ; Fetch its contents.
 $A2B1 AND $F0       ; Keep the initial type.
 $A2B3 LD (HL),A     ; Store it.
 $A2B4 RET           ; Return.

; Move Destroyer
;
; The handler for entity types #N$64 to #N($67), the enemies that destroy
; the programs that have been installed. They fly in a straight line until their
; time runs out. When one of them hits an installed program in a sector that has
; not been activated, the program is removed and the sector loses a unit of
; energy.
;
; IX Entity
@label=MoveDestroyer
c$A2B5 CALL $B063      ; Move on to the next sprite using #R$B063.
 $A2B8 CALL $AED3      ; Fetch the position of the enemy.
 $A2BB LD B,$80        ; The enemy can take up to #N$80 steps in this frame.
@label=MoveDestroyer_Step
 $A2BD CALL $A9C3      ; Take a step using #R$A9C3.
 $A2C0 JR NZ,$A2D2     ; Jump if the enemy has hit a cell.
@label=MoveDestroyer_Store
*$A2C2 CALL $AEE0      ; Store the new position of the enemy.
 $A2C5 DEC (IX+$09)    ; {Count down the time that the enemy has left, and draw it using
 $A2C8 JP NZ,$BDCD     ; #R$BDCD if there is any.}
 $A2CB LD (IX+$00),$38 ; Otherwise turn it into smoke by changing its type to
                       ; #N$38...
 $A2CF JP $BDCD        ; ...and draw it.
@label=MoveDestroyer_HitCell
*$A2D2 PUSH HL         ; Save the Y position.
 $A2D3 LD HL,($962E)   ; Fetch the address of the cell that the enemy hit...
 $A2D6 LD A,(HL)       ; ...and its type.
 $A2D7 AND $0F         ; Keep the current type of the cell.
 $A2D9 CP $02          ; {Jump unless the cell holds an installed program (type
 $A2DB JR NZ,$A302     ; #N$02).}
 $A2DD PUSH DE         ; Save the X position.
 $A2DE CALL $9C5E      ; Find the sector that the cell is in using #R$9C5E.
 $A2E1 LD E,D          ; {Use the sector number as an index.
 $A2E2 LD D,$00        ; }
 $A2E4 PUSH HL         ; Save the address of the cell.
 $A2E5 LD HL,$965B     ; Point #REGhl at #R$965B.
 $A2E8 ADD HL,DE       ; Add the index.
 $A2E9 LD A,(HL)       ; Fetch the flag.
 $A2EA POP HL          ; Restore the address of the cell.
 $A2EB POP DE          ; Restore the X position.
 $A2EC AND A           ; {Jump if the sector has been activated, as its
 $A2ED JR NZ,$A316     ; programs are safe.}
 $A2EF LD A,(HL)       ; Fetch the contents of the cell...
 $A2F0 AND $F0         ; {...and keep its initial type in #REGb.
 $A2F2 LD B,A          ; }
 $A2F3 LD A,(HL)       ; Fetch the contents of the cell again...
 $A2F4 ADD A,$0D       ; {...and change the current type from #N$02 to #N$0F.
 $A2F6 AND $0F         ; }
 $A2F8 OR B            ; Combine it with the initial type...
 $A2F9 LD (HL),A       ; ...and store it.
 $A2FA PUSH DE         ; Save the X position.
 $A2FB CALL $A32B      ; Take one unit of energy off the sector using #R$A32B.
 $A2FE POP DE          ; Restore the X position.
 $A2FF POP HL          ; Restore the Y position.
 $A300 JR $A2C2        ; Carry on.
@label=MoveDestroyer_NotProgram
*$A302 POP HL          ; Restore the Y position.
 $A303 CP $04          ; {Jump to turn the enemy into smoke if the cell is type
 $A305 JR Z,$A30F      ; #N$04.}
 $A307 CP $05          ; {Jump to turn the enemy into smoke if the cell is type
 $A309 JR Z,$A30F      ; #N$05.}
 $A30B CP $0C          ; {Jump if the cell is not type #N($0C), to carry on.
 $A30D JR NZ,$A317     ; }
@label=MoveDestroyer_Smoke
*$A30F LD (IX+$00),$38 ; Turn the enemy into smoke by changing its type to
                       ; #N$38...
 $A313 JP $BDCD        ; ...and draw it.
@label=MoveDestroyer_Safe
*$A316 POP HL          ; Restore the Y position.
@label=MoveDestroyer_Undo
*$A317 LD DE,($9653)   ; Restore the position that the enemy had before the
                       ; step...
 $A31B LD HL,($9655)   ; {...and carry on.
 $A31E JR $A2C2        ; }

; Find Sector Energy
;
; Used by the routines at #R$A32B and #R$ADB2.
; .
; Finds the entry for the sector that an entity is in, in the table of
; sector energies.
;
;   IX Entity
; O:DE Sector number
; O:HL Address of the energy of the sector
@label=FindSectorEnergy
c$A320 CALL $9C5E    ; Find the sector using #R$9C5E.
 $A323 LD E,A        ; Put the sector number in #REGe...
 $A324 LD D,$00      ; ...and clear #REGd.
 $A326 LD HL,$A361   ; Point #REGhl at #R$A361.
 $A329 ADD HL,DE     ; Add the sector number.
 $A32A RET           ; Return.

; Reduce Sector Energy
;
; Used by the routines at #R$A144 and #R$A2B5.
; .
; Takes one unit of energy off the sector that an entity is in. If the
; energy is down to five or fewer units then the player is told, and when it
; reaches zero the sector has been destroyed.
;
; IX Entity
@label=ReduceSectorEnergy
c$A32B CALL $A320    ; Find the energy of the sector using #R$A320.
 $A32E DEC (HL)      ; Take one unit of energy off.
 $A32F LD A,(HL)     ; Fetch the energy that is left.
 $A330 CP $06        ; {Return if there are at least six units.
 $A332 RET NC        ; }
 $A333 LD C,A        ; Keep the energy.
 $A334 AND A         ; {Jump if there is some energy left.
 $A335 JR NZ,$A34A   ; }
 $A337 LD HL,$9659   ; Point #REGhl at the number of sectors that have been
                     ; destroyed.
 $A33A INC (HL)      ; Add one.
 $A33B LD HL,$967E   ; Point #REGhl at #R$967E.
 $A33E ADD HL,DE     ; Add the sector number.
 $A33F LD A,(HL)     ; Fetch the state of the sector.
 $A340 AND $FC       ; {Change it to destroyed (bit 0 set and bit 1 clear), clearing the
 $A342 OR $01        ; flag that says it is under attack.}
 $A344 LD (HL),A     ; Store the new state.
 $A345 PUSH DE       ; Save the sector number.
 $A346 CALL $ADEA    ; Colour the sector map using #R$ADEA.
 $A349 POP DE        ; Restore the sector number.
@label=ReduceSectorEnergy_Message
*$A34A LD A,E        ; Fetch the sector number...
 $A34B ADD A,$B1     ; ...and convert it into the last character of the message "SECTOR
                     ; n"...
 $A34D LD ($9D4D),A  ; ...by writing it into the message.
 $A350 LD D,E        ; Use the sector number as the argument of the message...
 $A351 LD E,$01      ; ...for message #N$01.
 $A353 CALL $9C76    ; Queue it using #R$9C76.
 $A356 LD E,$04      ; Use message #N($04), "DESTROYED"...
 $A358 LD A,C        ; ...but use message #N($07), "CRITICAL", instead...
 $A359 AND A         ; {...unless the sector has no energy left, in which case jump to use
 $A35A JR Z,$A35E    ; "DESTROYED".}
 $A35C LD E,$07      ; Use message #N($07), "CRITICAL".
@label=ReduceSectorEnergy_QueueMessage
*$A35E JP $9C76      ; Jump to #R$9C76.

; Sector Energy
;
; The number of programs that are installed in each sector, which is its
; energy. The energy of a sector goes down by one when one of its programs is
; destroyed and up by one when the robot installs a program. A sector with no
; energy is destroyed. The last two bytes are not used.
@label=SectorEnergy
g$A361 DEFB $0F      ; {Sectors #N$00 to #N$08.
 $A362 DEFB $0F      ;
 $A363 DEFB $0F      ;
 $A364 DEFB $0F      ;
 $A365 DEFB $0F      ;
 $A366 DEFB $0F      ;
 $A367 DEFB $0F      ;
 $A368 DEFB $0F      ;
 $A369 DEFB $0F      ; }
 $A36A DEFB $0F      ; {Unused.
 $A36B DEFB $0F      ; }

; Move Program Packet
;
; The handler for entity types #N$6E and #N($6F), which is the program
; packet that is sent from a transmitter to a sector. It follows the open cells
; of the map. If it reaches a receiving terminal (a cell of type #N$09) in a
; sector that has some energy then the sector is activated, and if it runs into
; a hazard (a cell of type #N$01 or #N$07) then the program is destroyed.
;
; IX Entity
@label=MoveProgramPacket
c$A36C CALL $AED3      ; Fetch the position of the packet.
 $A36F LD A,(IX+$00)   ; Fetch the type of the packet...
 $A372 XOR $01         ; {...and switch to the other sprite.
 $A374 LD (IX+$00),A   ; }
 $A377 LD A,E          ; {Jump if the packet is not at the start of a cell.
 $A378 OR L            ;
 $A379 JR NZ,$A3D8     ; }
 $A37B LD A,(IX+$07)   ; Fetch the direction that the packet is heading in...
 $A37E AND $03         ; ...limited to #N$00-#N$03.
 $A380 CALL $A4C3      ; Choose a direction that is not blocked using #R$A4C3.
 $A383 JR Z,$A38C      ; Jump if there is one.
 $A385 LD (IX+$00),$38 ; Otherwise turn the packet into smoke...
 $A389 JP $BDCD        ; ...and draw it.
@label=MoveProgramPacket_CheckCell
*$A38C CP $09          ; {Jump if the packet has reached a receiving terminal (a cell of type
 $A38E JR Z,$A3AF      ; #N$09).}
 $A390 AND A           ; {Jump to carry on if the cell is open (type #N$00).
 $A391 JR Z,$A3CF      ; }
 $A393 LD B,$84        ; Use the state that says that the packet has been
                       ; destroyed...
 $A395 CP $01          ; {...and jump to set it if the cell is a hazard of type
 $A397 JR Z,$A3CC      ; #N$01...}
 $A399 CP $07          ; {...or of type #N$07.
 $A39B JR Z,$A3CC      ; }
 $A39D CP $0F          ; {Jump to carry on if the cell is type #N$0F.
 $A39F JR Z,$A3CF      ; }
; The packet has been destroyed or has arrived, and is removed.
@label=MoveProgramPacket_Remove
*$A3A1 XOR A           ; Remove the packet by setting its type to zero.
 $A3A2 LD (IX+$00),A   ; Store it.
 $A3A5 RET             ; Return.
; The terminal has no energy, so the packet turns round.
@label=MoveProgramPacket_TurnRound
*$A3A6 POP HL          ; Restore the Y position.
 $A3A7 LD A,C          ; Fetch the direction that the packet is heading in...
 $A3A8 ADD A,$02       ; {...and reverse it.
 $A3AA AND $03         ; }
 $A3AC LD C,A          ; Keep the reversed direction.
 $A3AD JR $A3CF        ; Carry on.
@label=MoveProgramPacket_Terminal
*$A3AF PUSH HL         ; Save the Y position...
 $A3B0 PUSH DE         ; ...and the X position.
 $A3B1 CALL $9C5E      ; Find the sector that the terminal is in using #R$9C5E.
 $A3B4 LD E,D          ; {Use the sector number as an index.
 $A3B5 LD D,$00        ; }
 $A3B7 LD HL,$A361     ; Point #REGhl at #R$A361.
 $A3BA ADD HL,DE       ; Add the index.
 $A3BB POP DE          ; Restore the X position.
 $A3BC LD A,(HL)       ; Fetch the energy of the sector.
 $A3BD AND A           ; {Jump to turn the packet round if the sector has no
 $A3BE JR Z,$A3A6      ; energy.}
 $A3C0 LD HL,($962E)   ; Fetch the address of the terminal.
 $A3C3 LD A,(HL)       ; Fetch its contents.
 $A3C4 AND $F0         ; Keep the initial type...
 $A3C6 OR $0E          ; ...change the current type to #N($0E), the activated
                       ; terminal...
 $A3C8 LD (HL),A       ; ...and store the new contents.
 $A3C9 LD B,$04        ; Set the state of the packet to four...
 $A3CB POP HL          ; ...after restoring the Y position.
@label=MoveProgramPacket_State
*$A3CC LD (IX+$0E),B   ; Store the state of the packet.
@label=MoveProgramPacket_Continue
*$A3CF LD A,(IX+$07)   ; Fetch the direction of the packet...
 $A3D2 AND $FC         ; ...clear the old direction...
 $A3D4 OR C            ; ...add the new direction...
 $A3D5 LD (IX+$07),A   ; ...and store it.
@label=MoveProgramPacket_UpdateState
*$A3D8 LD A,(IX+$0E)   ; Fetch the state of the packet...
 $A3DB AND $0F         ; {...limited to the low four bits, and jump to carry on
 $A3DD JR Z,$A453      ; if it is zero.}
 $A3DF DEC A           ; {Count down the state, and jump to store it if it has not reached
 $A3E0 JR NZ,$A449     ; zero.}
 $A3E2 BIT 7,(IX+$0E)  ; {Test the flag that says that the packet has been destroyed, and jump
 $A3E6 JR Z,$A3FC      ; if it is not set.}
 $A3E8 LD DE,$0003     ; Queue message #N($03), "PROGRAM HAS BEEN"...
 $A3EB CALL $9C76      ; ...using #R$9C76.
 $A3EE LD DE,$0004     ; Queue message #N($04), "DESTROYED"...
 $A3F1 CALL $9C76      ; ...using #R$9C76.
 $A3F4 LD HL,$0304     ; Start effect #N$03 (four tones)...
 $A3F7 LD ($9688),HL   ; ...by storing the length and the effect number for
                       ; #R$BFDA.
 $A3FA JR $A3A1        ; Remove the packet.
; The packet has arrived at a terminal in a sector that has energy.
@label=MoveProgramPacket_Arrived
*$A3FC LD DE,$0008     ; Queue message #N($08), "PROGRAM RECIEVED"...
 $A3FF CALL $9C76      ; ...using #R$9C76.
 $A402 CALL $9C5E      ; Find the sector that the packet is in using #R$9C5E.
 $A405 LD E,$01        ; Queue message #N($01), "SECTOR n"...
 $A407 CALL $9C76      ; ...using #R$9C76.
 $A40A LD HL,$965B     ; Point #REGhl at #R$965B.
 $A40D LD E,D          ; {Use the sector number as an index.
 $A40E LD D,$00        ; }
 $A410 ADD HL,DE       ; Add the index.
 $A411 LD (HL),$FF     ; Set the flag that says that the sector has been
                       ; activated.
 $A413 LD HL,$9658     ; Point #REGhl at the number of sectors that have been
                       ; activated.
 $A416 INC (HL)        ; Add one.
 $A417 LD HL,$967E     ; Point #REGhl at #R$967E.
 $A41A ADD HL,DE       ; Add the sector number.
 $A41B LD A,(HL)       ; Fetch the state of the sector.
 $A41C AND $FC         ; {Change it to activated (bit 1 set and bit 0 clear), clearing the
 $A41E OR $02          ; flag that says it is under attack.}
 $A420 LD (HL),A       ; Store the new state.
 $A421 LD HL,$A361     ; Point #REGhl at #R$A361.
 $A424 ADD HL,DE       ; Add the sector number.
 $A425 LD B,(HL)       ; Use the energy of the sector as a counter...
 $A426 XOR A           ; ...to count up in decimal.
@label=MoveProgramPacket_CountEnergy
*$A427 ADD A,$01       ; Add one.
 $A429 DAA             ; Convert it to decimal.
 $A42A DJNZ $A427      ; Loop back until the count is the energy.
 $A42C RRCA            ; {Swap the digits.
 $A42D RRCA            ;
 $A42E RRCA            ;
 $A42F RRCA            ; }
 $A430 LD C,A          ; Keep the result.
 $A431 AND $0F         ; {Keep the digit that was the first.
 $A433 LD B,A          ; }
 $A434 CALL $B573      ; Add the bonus to the score using #R$B573.
 $A437 CALL $ADEA      ; Colour the sector map using #R$ADEA.
 $A43A LD BC,$5000     ; Add #N$5000 points...
 $A43D CALL $B573      ; ...to the score using #R$B573.
 $A440 LD HL,$0207     ; Start effect #N$02 (seven tones)...
 $A443 LD ($9688),HL   ; ...by storing the length and the effect number for
                       ; #R$BFDA.
 $A446 JP $A3A1        ; Remove the packet.
@label=MoveProgramPacket_StoreCount
*$A449 LD B,A          ; Keep the new count.
 $A44A LD A,(IX+$0E)   ; Fetch the state of the packet...
 $A44D AND $F0         ; ...keep the bits that are not the count...
 $A44F OR B            ; ...and combine them with the new count...
 $A450 LD (IX+$0E),A   ; ...and store it.
; The packet moves on.
@label=MoveProgramPacket_Move
*$A453 LD B,$30        ; The packet can take up to #N$30 steps in this frame.
 $A455 CALL $A12D      ; Take a step using #R$A12D.
 $A458 JR Z,$A46D      ; Jump if the packet could carry on.
 $A45A CP $01          ; {Jump to carry on if the cell that blocked the packet
 $A45C JR Z,$A466      ; is type #N$01.}
 $A45E CP $07          ; {Jump to carry on if the cell that blocked the packet
 $A460 JR Z,$A466      ; is type #N$07.}
 $A462 CP $0E          ; {Jump if the cell that blocked the packet is not type
 $A464 JR NZ,$A46D     ; #N$0E.}
@label=MoveProgramPacket_Restore
*$A466 LD DE,($9653)   ; Restore the position that the packet had before the
                       ; step...
 $A46A LD HL,($9655)   ; ...and the other coordinate.
@label=MoveProgramPacket_CheckEntities
*$A46D CALL $A56D      ; Check whether any entity is in the way using #R$A56D.
 $A470 JR NC,$A483     ; Jump if there is none.
 $A472 LD A,(IX+$07)   ; Fetch the direction of the packet...
 $A475 ADD A,$02       ; {...and reverse it...
 $A477 AND $03         ; }
 $A479 LD C,A          ; ...and keep it in #REGc.
 $A47A LD A,(IX+$07)   ; Fetch the byte again...
 $A47D AND $FC         ; {...and combine the other bits of the byte with the
 $A47F OR C            ; new direction...}
 $A480 LD (IX+$07),A   ; ...and store it.
@label=MoveProgramPacket_Store
*$A483 CALL $AEE0      ; Store the position of the packet.
 $A486 RES 7,(IX+$00)  ; Do not flip the sprite of the packet...
 $A48A BIT 0,(IX+$07)  ; ...if the lowest bit of the direction is clear...
 $A48E JP Z,$BDCD      ; ...and draw the packet using #R$BDCD.
 $A491 SET 7,(IX+$00)  ; Otherwise flip the sprite...
 $A495 JP $BDCD        ; ...and draw the packet using #R$BDCD.

; Test Cell In Direction
;
; Used by the routine at #R$A4C3.
; .
; Finds the type of the cell next to an entity in a direction, and tests
; whether a program packet could go there. The directions are #N$00 for the
; lower X cell, #N$01 for the higher Y cell, #N$02 for the higher X cell and
; #N$03 for the lower Y cell.
;
;   A Direction
;   F The zero flag is set if the direction is zero
;   DE X position
;   HL Y position
; O:IY Address of the cell
; O:F The zero flag is set if the packet could go to the cell
; O:A The type of the cell
@label=TestCellInDirection
c$A498 LD C,A        ; Keep the direction.
 $A499 PUSH DE       ; {Save the position.
 $A49A PUSH HL       ; }
 $A49B JR Z,$A4BA    ; Jump if the direction is zero.
 $A49D DEC A         ; {Jump if the direction is one.
 $A49E JR Z,$A4BD    ; }
 $A4A0 DEC A         ; {Jump if the direction is two.
 $A4A1 JR Z,$A4C0    ; }
 $A4A3 DEC H         ; Otherwise use the lower Y cell.
@label=TestCellInDirection_Cell
*$A4A4 CALL $BF97    ; Find the cell using #R$BF97.
 $A4A7 PUSH HL       ; {Copy its address into #REGiy.
 $A4A8 POP IY        ; }
 $A4AA POP HL        ; {Restore the position.
 $A4AB POP DE        ; }
 $A4AC AND A         ; {Return with the zero flag set if the cell is empty
 $A4AD RET Z         ; (type #N$00).}
 $A4AE CP $0F        ; {Return with the zero flag set if the type is #N$0F.
 $A4B0 RET Z         ; }
 $A4B1 CP $01        ; {Return with the zero flag set if the type is #N$01.
 $A4B3 RET Z         ; }
 $A4B4 CP $07        ; {Return with the zero flag set if the type is #N$07.
 $A4B6 RET Z         ; }
 $A4B7 CP $09        ; {Compare the type with #N($09), and return.
 $A4B9 RET           ; }
@label=TestCellInDirection_X1
*$A4BA DEC D         ; {Use the lower X cell, and jump back.
 $A4BB JR $A4A4      ; }
@label=TestCellInDirection_Y1
*$A4BD INC H         ; {Use the higher Y cell, and jump back.
 $A4BE JR $A4A4      ; }
@label=TestCellInDirection_X2
*$A4C0 INC D         ; {Use the higher X cell, and jump back.
 $A4C1 JR $A4A4      ; }

; Choose Direction
;
; Used by the routine at #R$A36C.
; .
; Finds a direction for a program packet to go in, which is the one that
; it is heading in if that is possible, and otherwise the one to the side, the
; opposite one, and the other side.
;
;   A Direction of the packet
;   DE X position
;   HL Y position
; O:A The type of the cell, if the zero flag is set
; O:C The direction that has been chosen
; O:F The zero flag is set if the packet can go on
@label=ChooseDirection
c$A4C3 CALL $A498    ; {Try the direction that the packet is heading in, and return if it
 $A4C6 RET Z         ; can go there.}
 $A4C7 LD A,C        ; {Try the direction before it...
 $A4C8 DEC A         ;
 $A4C9 AND $03       ; }
 $A4CB CALL $A498    ; {...and return if the packet can go there.
 $A4CE RET Z         ; }
 $A4CF LD A,C        ; {Try the opposite direction...
 $A4D0 XOR $02       ; }
 $A4D2 CALL $A498    ; {...and return if the packet can go there.
 $A4D5 RET Z         ; }
 $A4D6 LD A,C        ; {Try the direction after the original one...
 $A4D7 INC A         ;
 $A4D8 AND $03       ; }
 $A4DA JR $A498      ; Jump to #R$A498.

; Animate Program
;
; The handler for entity types #N$74 to #N($77), which are the sprites of
; an installed program in the map. The stripe moves on to the next frame.
; sprites in turn.
;
; IX Entity
@label=AnimateProgram
c$A4DC LD A,(IX+$00) ; Fetch the type of the entity.
 $A4DF LD E,A        ; Keep the type.
 $A4E0 DEC A         ; {Take one off and limit it to the four sprites...
 $A4E1 AND $03       ; }
 $A4E3 LD D,A        ; ...and keep that in #REGd.
 $A4E4 LD A,E        ; Fetch the type again.
 $A4E5 AND $FC       ; {Replace the sprite with the new one...
 $A4E7 OR D          ; }
 $A4E8 LD (IX+$00),A ; ...and store the type.
 $A4EB RET           ; Return.

; Move Hunter
;
; The handler for entity types #N$60 to #N($63), which are enemies that
; hunt for the robot. The enemy heads for the robot, and chooses a new
; direction when it is blocked.
;
; IX Entity
@label=MoveHunter
c$A4EC CALL $B05A    ; Move on to the next sprite using #R$B05A.
 $A4EF CALL $A104    ; Remove the enemy if it is far away from the camera using
                     ; #R$A104.
 $A4F2 CALL $AED3    ; Fetch the position of the enemy.
 $A4F5 LD B,$40      ; The enemy can take up to #N$40 steps in this frame.
@label=MoveHunter_Step
*$A4F7 CALL $A12D    ; Take a step using #R$A12D.
 $A4FA JR NZ,$A518   ; Jump if the enemy has been blocked by a cell.
 $A4FC CALL $A576    ; Check whether another enemy is in the way using #R$A576.
 $A4FF JR C,$A543    ; Jump if there is.
 $A501 LD A,E        ; {Jump if the enemy is not at the start of a cell.
 $A502 OR L          ;
 $A503 JR NZ,$A50F   ; }
 $A505 CALL $A282    ; Choose a direction towards the robot using #R$A282...
 $A508 LD (IX+$07),A ; ...and store it.
 $A50B LD A,B        ; {Loop back to take another step if there are steps left.
 $A50C AND A         ;
 $A50D JR NZ,$A4F7   ; }
@label=MoveHunter_Store
*$A50F CALL $AEE0    ; Store the new position of the enemy.
 $A512 CALL $A550    ; Face the enemy in the direction that it is heading using
                     ; #R$A550.
 $A515 JP $BDCD      ; Draw the enemy using #R$BDCD.
@label=MoveHunter_Blocked
*$A518 PUSH HL       ; Save the Y position.
 $A519 LD HL,($962E) ; Fetch the address of the cell that blocked the enemy...
 $A51C LD A,(HL)     ; ...and its type.
 $A51D AND $0F       ; Keep the current type of the cell.
 $A51F JR $A539      ; Jump to choose a direction.
; This code is never run. It would have let the enemy pick up programs,
; like #R$A218.
@label=MoveHunter_Unused
 $A521 CP $06        ; {Jump to pick up the item if the cell is type #N$06...
 $A523 JR Z,$A529    ; }
 $A525 CP $07        ; {...or type #N$07.
 $A527 JR NZ,$A539   ; }
@label=MoveHunter_Unused_Pick
*$A529 LD B,A        ; Keep the type.
 $A52A LD A,(IX+$08) ; Fetch the item that the enemy is carrying.
 $A52D AND A         ; {Jump if it is carrying one already.
 $A52E JR NZ,$A539   ; }
 $A530 LD (IX+$08),B ; Store the item that it has picked up.
 $A533 CALL $A2AD    ; Remove it from the cell using #R$A2AD.
 $A536 POP HL        ; Restore the Y position.
 $A537 JR $A50F      ; Carry on.
@label=MoveHunter_Turn
*$A539 POP HL        ; Restore the Y position.
 $A53A CALL $A282    ; Choose a direction towards the robot using #R$A282...
 $A53D LD (IX+$07),A ; ...and store it.
 $A540 JP $BDCD      ; Draw the enemy using #R$BDCD.
; The enemy is in the way of another enemy.
@label=MoveHunter_Reverse
*$A543 CALL $A891    ; Turn the enemy round using #R$A891.
 $A546 CALL $A550    ; Face the enemy in the direction that it is heading using
                     ; #R$A550.
 $A549 CALL $BDCD    ; Draw the enemy using #R$BDCD.
 $A54C RET NC        ; Return if it was not drawn.
 $A54D JP $C048      ; Otherwise make a sound using #R$C048.

; Face Enemy
;
; Used by the routine at #R$A4EC.
; .
; Sets the flags of the type of an enemy, which select how its sprite is
; flipped, according to the direction that it is heading in.
;
; IX Entity
@label=FaceEnemy
c$A550 RES 7,(IX+$00) ; Do not flip the sprite...
 $A554 RES 1,(IX+$00) ; ...and use the first pair of sprites...
 $A558 LD A,(IX+$07)  ; ...and fetch the direction.
 $A55B BIT 0,A        ; {Jump if the lowest bit of the direction is set.
 $A55D JR NZ,$A563    ; }
 $A55F SET 7,(IX+$00) ; Otherwise flip the sprite.
@label=FaceEnemy_Sprite
*$A563 CPL            ; {Invert the direction...
 $A564 DEC A          ; }
 $A565 BIT 1,A        ; {...and return if bit 1 of the result is set.
 $A567 RET NZ         ; }
 $A568 SET 1,(IX+$00) ; Otherwise use the second pair of sprites.
 $A56C RET            ; Return.

; Check Entity Overlap
;
; Used by the routine at #R$A36C.
; .
; Checks whether the entity overlaps any of the first fourteen entities,
; which are the robot, the shots, the enemies and the program packet.
;
;   IX Entity
;   DE X position
;   HL Y position
; O:IY The entity that has been hit
; O:F The carry flag is set if there is one
@label=CheckEntityOverlap
c$A56D PUSH BC       ; Save the registers.
 $A56E LD B,$0E      ; There are #N$0E entities to check.
 $A570 LD IY,$9690   ; Point #REGiy at #R$9690.
 $A574 JR $A57D      ; Jump to check them.

; Check Enemy Overlap
;
; Used by the routines at #R$A218, #R$A4EC, #R$A739 and #R$A833.
; .
; Checks whether the entity overlaps any of the ten entities that are
; enemies (entities #N$04 to #N$0D), apart from itself.
;
;   IX Entity
;   DE X position
;   HL Y position
; O:IY The entity that has been hit
; O:F The carry flag is set if there is one
@label=CheckEnemyOverlap
c$A576 PUSH BC       ; Save the register.
 $A577 LD B,$0A      ; There are ten enemies to check.
 $A579 LD IY,$96D0   ; Point #REGiy at #R$96D0.
; This entry point is used by the routine at #R$A56D.
@label=CheckEnemyOverlap_Next
*$A57D PUSH BC       ; Save the counter.
 $A57E LD A,(IY+$00) ; Fetch the type of the entity.
 $A581 AND A         ; {Jump if the entity is not in use.
 $A582 JR Z,$A599    ; }
 $A584 PUSH HL       ; Save the Y position.
 $A585 PUSH IX       ; {Copy the address of the entity being moved into
 $A587 POP HL        ; #REGhl...}
 $A588 PUSH IY       ; {...and the address of the entity that is being checked
 $A58A POP BC        ; into #REGbc.}
 $A58B AND A         ; {Subtract one from the other...
 $A58C SBC HL,BC     ; }
 $A58E POP HL        ; ...restoring the Y position...
 $A58F JR Z,$A599    ; ...and jump if they are the same entity.
 $A591 LD BC,$F0F0   ; Use #N$F0 as the distance in both directions.
 $A594 CALL $A5EA    ; Compare the positions using #R$A5EA.
 $A597 JR C,$A5A4    ; Jump if they overlap.
@label=CheckEnemyOverlap_Skip
*$A599 LD BC,$0010   ; Each entity is #N$10 bytes long.
 $A59C ADD IY,BC     ; Move on to the next one.
 $A59E POP BC        ; Restore the counter.
 $A59F DJNZ $A57D    ; Loop back until every entity has been checked.
 $A5A1 AND A         ; Clear the carry flag...
 $A5A2 POP BC        ; ...restore the register...
 $A5A3 RET           ; ...and return.
@label=CheckEnemyOverlap_Hit
*$A5A4 POP BC        ; Discard the counter...
 $A5A5 POP BC        ; ...and restore the register.
 $A5A6 RET           ; Return with the carry flag set.

; Check Shot Hit
;
; Used by the routines at #R$A144, #R$A8A4 and #R$AB03.
; .
; Checks whether an entity (a shot, or the robot) has run into an enemy.
; If it has, then both are turned into smoke and the player is awarded some
; points.
;
;   IX Entity
; O:IY The enemy that has been hit
@label=CheckShotHit
c$A5A7 LD B,$0A      ; There are ten enemies to check.
 $A5A9 LD IY,$96D0   ; Point #REGiy at #R$96D0.
@label=CheckShotHit_Next
*$A5AD PUSH BC       ; Save the counter.
 $A5AE LD A,(IY+$00) ; Fetch the type of the enemy.
 $A5B1 AND A         ; {Jump if the entity is not in use.
 $A5B2 JR Z,$A5C2    ; }
 $A5B4 SUB $38       ; {Jump if it is smoke or a sprite of a materialising enemy (types
 $A5B6 CP $18        ; #N$38 to #N$4F).
 $A5B8 JR C,$A5C2    ; }
 $A5BA LD BC,$C0C0   ; Use #N$C0 as the distance in both directions.
 $A5BD CALL $A5EA    ; Compare the positions using #R$A5EA.
 $A5C0 JR C,$A5CB    ; Jump if they overlap.
@label=CheckShotHit_Skip
*$A5C2 LD BC,$0010   ; Each entity is #N$10 bytes long.
 $A5C5 ADD IY,BC     ; Move on to the next one.
 $A5C7 POP BC        ; Restore the counter.
 $A5C8 DJNZ $A5AD    ; Loop back until every enemy has been checked.
 $A5CA RET           ; Return.
@label=CheckShotHit_Hit
*$A5CB POP BC        ; Discard the counter.
 $A5CC LD A,(IX+$00) ; Fetch the type of the entity that has hit the enemy...
 $A5CF LD (IX+$05),A ; ...and keep it.
 $A5D2 LD ($9638),IY ; Keep the address of the enemy that was hit.
 $A5D6 LD A,(IY+$00) ; Fetch the type of the enemy...
 $A5D9 LD (IY+$05),A ; ...and keep it.
 $A5DC LD A,$38      ; {Turn the shot into smoke...
 $A5DE LD (IX+$00),A ; }
 $A5E1 LD (IY+$00),A ; ...and the enemy too.
 $A5E4 LD BC,$0123   ; Add #N$0123 points...
 $A5E7 JP $B573      ; Jump to #R$B573.

; Compare Positions
;
; Used by the routines at #R$A576 and #R$A5A7.
; .
; Compares the position of an entity with the position of another one, in
; both directions.
;
;   IY Entity to compare with
;   DE X position
;   HL Y position
;   B Maximum difference in the Y direction
;   C Maximum difference in the X direction
; O:F The carry flag is set if both differences are small enough
@label=ComparePositions
c$A5EA PUSH HL       ; Save the Y position...
 $A5EB PUSH DE       ; ...and the X position.
 $A5EC LD E,(IY+$03) ; {Fetch the Y position of the other entity.
 $A5EF LD D,(IY+$04) ; }
 $A5F2 AND A         ; {Subtract it from the Y position, and jump if the result
 $A5F3 SBC HL,DE     ; is positive.
 $A5F5 JR NC,$A5FE   ; }
 $A5F7 EX DE,HL      ; {Otherwise negate it.
 $A5F8 AND A         ;
 $A5F9 LD HL,$0000   ;
 $A5FC SBC HL,DE     ; }
@label=ComparePositions_TestY
*$A5FE LD A,H        ; {Jump if the difference is more than the size of the
 $A5FF AND $3F       ; world.
 $A601 JR NZ,$A622   ; }
 $A603 LD A,L        ; {Jump if the difference is not less than the maximum.
 $A604 CP B          ;
 $A605 JR NC,$A622   ; }
 $A607 POP HL        ; {Restore the X position into #REGhl and save it again.
 $A608 PUSH HL       ; }
 $A609 LD E,(IY+$01) ; {Fetch the X position of the other entity.
 $A60C LD D,(IY+$02) ; }
 $A60F AND A         ; {Subtract it from the X position, and jump if the result
 $A610 SBC HL,DE     ; is positive.
 $A612 JR NC,$A61B   ; }
 $A614 EX DE,HL      ; {Otherwise negate it.
 $A615 AND A         ;
 $A616 LD HL,$0000   ;
 $A619 SBC HL,DE     ; }
@label=ComparePositions_TestX
*$A61B LD A,H        ; {Jump if the difference is more than the size of the
 $A61C AND $3F       ; world.
 $A61E JR NZ,$A622   ; }
 $A620 LD A,L        ; {Compare the difference with the maximum, which sets the carry flag
 $A621 CP C          ; if it is less.}
@label=ComparePositions_Done
*$A622 POP DE        ; Restore the X position...
 $A623 POP HL        ; ...and the Y position.
 $A624 RET           ; Return.

; Do Nothing
;
; The handler for entity types that do nothing.
@label=DoNothing
c$A625 RET           ; Return.

; Fire Weapon A
;
; Used by the routine at #R$AB03.
; .
; Fires a spark, which is the first weapon of the robot. It costs eight
; units of energy and needs the battery to have at least #N$10 units.
;
; A Controls that are being pressed
; IX Robot
@label=FireWeaponA
c$A626 RES 4,A       ; Clear the flag that says that the first weapon has been
                     ; fired...
 $A628 LD ($9625),A  ; ...and store the controls.
 $A62B LD HL,$96A0   ; Point #REGhl at the first of the three entities that are used for
                     ; shots.
 $A62E LD DE,$0010   ; Each entity is #N$10 bytes long.
 $A631 LD B,$03      ; There are three entities to check.
@label=FireWeaponA_Check
*$A633 LD A,(HL)     ; Fetch the type of the entity.
 $A634 SUB $58       ; {Return if it is one of the sprites #N$58 to #N$5B (the shots never
 $A636 CP $04        ; use these types, so this never stops the weapon).
 $A638 RET C         ; }
 $A639 ADD HL,DE     ; Move on to the next entity.
 $A63A DJNZ $A633    ; Loop back until all three have been checked.
 $A63C LD BC,$0800   ; Set the cost of the shot to #N$0800...
 $A63F LD ($963F),BC ; ...and store it.
 $A643 LD HL,$96A0   ; Point #REGhl at the first of the entities for shots
                     ; again.
 $A646 LD BC,$033C   ; Use three entities, and use type #N$3C for the sprite.
 $A649 LD A,$03      ; Use the lowest two bits of the type of the robot...
 $A64B LD ($A68A),A  ; ...to choose the sprite of the shot (this changes the mask used by
                     ; the instruction at #R$A689).
 $A64E LD A,($963B)  ; Fetch the level of the battery.
 $A651 CP $10        ; {Return if it is below #N$10.
 $A653 RET C         ; }
 $A654 JR $A670      ; Jump to fire the shot.

; Fire Weapon B
;
; Used by the routine at #R$AB03.
; .
; Fires a pellet, which is the second weapon of the robot. It is cheaper
; than a spark, as it only costs half a unit of energy.
;
; A Controls that are being pressed
; IX Robot
@label=FireWeaponB
c$A656 RES 3,A       ; Clear the flag that says that the second weapon has been
                     ; fired...
 $A658 LD ($9625),A  ; ...and store the controls.
 $A65B LD HL,$96A0   ; Point #REGhl at the first of the three entities that are used for
                     ; shots.
 $A65E LD DE,$0010   ; Each entity is #N$10 bytes long.
 $A661 LD BC,$0080   ; Set the cost of the shot to #N$0080...
 $A664 LD ($963F),BC ; ...and store it.
 $A668 LD BC,$0330   ; Use three entities, and use type #N$30 for the sprite.
 $A66B LD A,$07      ; Use the lowest three bits of the type of the robot...
 $A66D LD ($A68A),A  ; ...to choose the sprite of the shot (this changes the mask used by
                     ; the instruction at #R$A689).
; This entry point is used by the routine at #R$A626.
; .
; This entry point finds an entity that is not in use and starts a shot
; there.
@label=FireWeapon_Find
*$A670 LD A,(HL)     ; Fetch the type of the entity.
 $A671 AND A         ; {Jump if it is not in use.
 $A672 JR Z,$A678    ; }
 $A674 ADD HL,DE     ; Move on to the next entity.
 $A675 DJNZ $A670    ; Loop back until all of them have been tried.
 $A677 RET           ; Return, as all are in use.
@label=FireWeapon_Start
*$A678 PUSH HL       ; Save the address of the entity...
 $A679 PUSH DE       ; ...and the size of an entity.
 $A67A LD DE,($963F) ; Fetch the cost of the shot.
 $A67E CALL $A6AE    ; Take it off the energy of the battery using #R$A6AE.
 $A681 POP DE        ; Restore the size of an entity...
 $A682 POP HL        ; ...and the address of the entity.
 $A683 RET C         ; Return if there was not enough energy.
 $A684 LD A,(IX+$00) ; Fetch the type of the robot...
 $A687 RRCA          ; ...divide it by two...
 $A688 LD B,A        ; ...and keep it in #REGb.
 $A689 AND $07       ; Keep the bits that choose the sprite (the mask is changed by the
                     ; code above, from #N$07 to #N$03 for the first weapon)...
 $A68B OR C          ; ...and use them with the first sprite of the shot...
 $A68C LD (HL),A     ; ...as the type of the shot.
 $A68D INC HL        ; Move on to the X fraction of the shot.
 $A68E LD A,(IX+$01) ; {Copy the X fraction of the robot to the shot.
 $A691 LD (HL),A     ; }
 $A692 INC HL        ; Move on to the X cell of the shot.
 $A693 LD A,(IX+$02) ; {Copy the X cell of the robot to the shot.
 $A696 LD (HL),A     ; }
 $A697 INC HL        ; Move on to the Y fraction of the shot.
 $A698 LD A,(IX+$03) ; {Copy the Y fraction of the robot to the shot.
 $A69B LD (HL),A     ; }
 $A69C INC HL        ; Move on to the Y cell of the shot.
 $A69D LD A,(IX+$04) ; {Copy the Y cell of the robot to the shot.
 $A6A0 LD (HL),A     ; }
 $A6A1 INC HL        ; {Move on to the byte that holds the direction and the
 $A6A2 INC HL        ; range.
 $A6A3 INC HL        ; }
 $A6A4 LD A,B        ; Fetch the type of the robot, divided by two.
 $A6A5 RRCA          ; Divide it by two again...
 $A6A6 AND $03       ; ...and keep the direction...
 $A6A8 OR $60        ; ...together with the range of six cells.
 $A6AA LD (HL),A     ; Store them.
 $A6AB JP $C04E      ; Jump to #R$C04E.

; Use Energy
;
; Used by the routines at #R$A656 and #R$A8E4.
; .
; Takes an amount of energy out of the battery. If there is not enough
; then the battery is empty and the robot is destroyed, along with all of the
; enemies. The energy is free once every sector has been either activated or
; destroyed.
;
;   DE Energy to use
; O:F The carry flag is set if there was not enough energy
@label=UseEnergy
c$A6AE LD A,($9658)  ; Fetch the number of sectors that have been activated.
 $A6B1 LD L,A        ; Keep the number of activated sectors.
 $A6B2 LD A,($9659)  ; Fetch the number of sectors that have been destroyed.
 $A6B5 ADD A,L       ; Add the number that have been activated...
 $A6B6 LD ($965A),A  ; ...and store the number of sectors that have been dealt
                     ; with.
 $A6B9 CP $09        ; {Jump if some sectors have not been dealt with.
 $A6BB JR NZ,$A6BF   ; }
 $A6BD AND A         ; {Otherwise clear the carry flag and return, as the
 $A6BE RET           ; energy is free.}
@label=UseEnergy_Take
*$A6BF LD HL,($963A) ; Fetch the energy of the battery.
; See #POKE(infinite_energy,Infinite Energy).
 $A6C2 AND A         ; {Subtract the energy that is to be used.
 $A6C3 SBC HL,DE     ; }
 $A6C5 JR C,$A6CB    ; Jump if there is not enough energy.
 $A6C7 LD ($963A),HL ; Otherwise store the new energy...
 $A6CA RET           ; ...and return.
@label=UseEnergy_Empty
*$A6CB LD HL,$0000   ; The battery is empty.
 $A6CE LD ($963A),HL ; Store that.
 $A6D1 PUSH AF       ; Save the carry flag.
 $A6D2 LD A,$38      ; Turn the robot into smoke...
 $A6D4 LD ($9690),A  ; ...by setting its type to #N$38.
 $A6D7 XOR A         ; Clear the controls...
 $A6D8 LD ($9625),A  ; ...so that nothing is fired.
 $A6DB CALL $A727    ; Turn all of the enemies into smoke using #R$A727.
 $A6DE POP AF        ; Restore the carry flag...
 $A6DF RET           ; ...and return.

; Move Pellet
;
; The handler for entity types #N$30 to #N($37), which are the shots that
; the robot fires using the second weapon. A pellet moves across the map until
; it hits something or has run out of range.
;
; IX Entity
@label=MovePellet
c$A6E0 CALL $B05A      ; Move on to the next sprite using #R$B05A.
 $A6E3 CALL $AED3      ; Fetch the position of the pellet.
 $A6E6 LD B,$C0        ; The pellet can take up to #N$C0 steps in this frame.
@label=MovePellet_Step
*$A6E8 CALL $A12D      ; Take a step using #R$A12D.
 $A6EB JR NZ,$A704     ; Jump if the pellet has hit something.
 $A6ED LD A,E          ; {Jump if the pellet is not at the start of a cell.
 $A6EE OR L            ;
 $A6EF JR NZ,$A701     ; }
 $A6F1 LD A,(IX+$07)   ; Fetch the range of the pellet...
 $A6F4 SUB $10         ; ...take away one cell...
 $A6F6 LD (IX+$07),A   ; ...and store it.
 $A6F9 AND $F0         ; {Jump to turn the pellet into smoke if it has run out
 $A6FB JR Z,$A704      ; of range.}
 $A6FD LD A,B          ; {Loop back to take another step if there are steps
 $A6FE AND A           ; left.
 $A6FF JR NZ,$A6E8     ; }
@label=MovePellet_Store
*$A701 JP $A165        ; Store the position of the pellet, check whether it has hit an enemy
                       ; and draw it using #R$A165.
@label=MovePellet_Explode
*$A704 LD (IX+$00),$38 ; Turn the pellet into smoke by changing its type to
                       ; #N$38.
 $A708 JR $A701        ; Jump back to store the position.

; Animate Smoke
;
; The handler for entity types #N$38 to #N($3A), which are the sprites of
; smoke. It moves on to the next sprite, makes a sound and draws the smoke. The
; last sprite of the smoke is handled by #R$A713.
;
; IX Entity
@label=AnimateSmoke
c$A70A INC (IX+$00)  ; Move on to the next sprite.
 $A70D CALL $C08D    ; Make the sound of an explosion using #R$C08D.
 $A710 JP $BDCD      ; Draw the smoke using #R$BDCD.

; End Smoke
;
; The handler for entity type #N($3B), which is the last sprite of the
; smoke. If the robot has exploded then it loses a life, and otherwise the
; entity is removed.
;
; IX Entity
@label=EndSmoke
c$A713 CALL $C08D      ; Make the sound of an explosion using #R$C08D.
 $A716 PUSH IX         ; {Copy the address of the entity into #REGhl.
 $A718 POP HL          ; }
 $A719 LD DE,$9690     ; Point #REGde at #R$9690.
 $A71C AND A           ; {Subtract the address of the robot, and lose a life using #R$B6BC if
 $A71D SBC HL,DE       ; the entity is the robot.
 $A71F JP Z,$B6BC      ; }
 $A722 LD (IX+$00),$00 ; Otherwise remove the entity by setting its type to
                       ; zero.
 $A726 RET             ; Return.

; Explode Enemies
;
; Used by the routines at #R$A6AE and #R$AB03.
; .
; Turns every enemy that is in use into smoke.
@label=ExplodeEnemies
c$A727 LD HL,$96D0   ; Point #REGhl at the first enemy.
 $A72A LD DE,$0010   ; Each entity is #N$10 bytes long.
 $A72D LD B,$0A      ; There are ten enemies.
@label=ExplodeEnemies_Next
*$A72F LD A,(HL)     ; Fetch the type of the enemy.
 $A730 AND A         ; {Jump if the enemy is not in use.
 $A731 JR Z,$A735    ; }
 $A733 LD (HL),$38   ; Otherwise turn it into smoke.
@label=ExplodeEnemies_Skip
*$A735 ADD HL,DE     ; Move on to the next enemy.
 $A736 DJNZ $A72F    ; Loop back until every enemy has been dealt with.
 $A738 RET           ; Return.

; Spawn Enemies
;
; Used by the routine at #R$993C.
; .
; Called every frame while the robot is alive. It tries to start a new
; enemy at a random position in the sector that the robot is in, and tries to
; start a new destroyer in the sector that is under attack. A new enemy starts
; as the sprites that show it materialising. The enemy is only started if there
; is a free entity, and if the cell that is chosen at random is empty.
@label=SpawnEnemies
c$A739 LD A,($9690)    ; Fetch the type of the robot.
 $A73C CP $10          ; {Return if it is below #N$10.
 $A73E RET C           ; }
 $A73F CP $30          ; {Return if it is #N$30 or above, as the robot is not in a walking
 $A741 RET NC          ; state.}
 $A742 LD HL,$96D0     ; Point #REGhl at the first of the six entities that are used for
                       ; enemies.
 $A745 LD DE,$0010     ; Each entity is #N$10 bytes long.
 $A748 LD B,$06        ; There are six entities to check.
@label=SpawnEnemies_Find
*$A74A LD A,(HL)       ; Fetch the type of the entity.
 $A74B AND A           ; {Jump if it is not in use.
 $A74C JR Z,$A753      ; }
 $A74E ADD HL,DE       ; Move on to the next entity.
 $A74F DJNZ $A74A      ; Loop back until all of them have been tried.
 $A751 JR $A7B9        ; Jump to try to start a destroyer.
@label=SpawnEnemies_UseFirstEntity
*$A753 PUSH HL         ; Copy the address of the entity into #REGix...
 $A754 POP IX          ; Pop it into #REGix.
 $A756 LD B,$10        ; There are #N$10 bytes to clear.
@label=SpawnEnemies_Clear
*$A758 LD (HL),$00     ; Clear a byte of the entity.
 $A75A INC HL          ; Move on to the next byte.
 $A75B DJNZ $A758      ; Loop back until the entity has been cleared.
 $A75D LD A,($9692)    ; Fetch the X cell of the camera...
 $A760 AND $30         ; ...and keep the sector (a multiple of #N$10).
 $A762 LD E,A          ; Keep the sector column of the camera.
 $A763 LD A,($9617)    ; Fetch the random number...
 $A766 AND $0F         ; ...limited to #N$00-#N$0F...
 $A768 OR E            ; ...and combine it with the sector to choose the X
                       ; cell.
 $A769 CP $2F          ; {Jump if it is outside the map, which is #N$30 cells
 $A76B JR NC,$A7B9     ; wide.}
 $A76D LD D,A          ; Keep the X cell...
 $A76E LD E,$00        ; ...and use zero for the fraction.
 $A770 LD A,($9694)    ; Fetch the Y cell of the camera...
 $A773 AND $30         ; ...and keep the sector.
 $A775 LD L,A          ; Keep the sector row of the camera.
 $A776 LD A,($9615)    ; Fetch the frame counter...
 $A779 AND $0F         ; ...limited to #N$00-#N$0F...
 $A77B OR L            ; ...and combine it with the sector to choose the Y
                       ; cell.
 $A77C CP $2F          ; {Jump if it is outside the map, which is #N$30 cells
 $A77E JR NC,$A7B9     ; high.}
 $A780 LD H,A          ; Keep the Y cell...
 $A781 LD L,$00        ; ...and use zero for the fraction.
 $A783 CALL $BF97      ; Find the cell using #R$BF97.
 $A786 JR NZ,$A7B9     ; Jump if it is not empty.
 $A788 LD (IX+$00),$40 ; Start the enemy with the first sprite of the sequence that shows it
                       ; materialising.
 $A78C CALL $AEE0      ; Store its position.
 $A78F CALL $A576      ; Check whether another enemy is in the way using
                       ; #R$A576.
 $A792 JR NC,$A79A     ; Jump if there is not.
 $A794 LD (IX+$00),$00 ; Otherwise cancel the new enemy...
 $A798 JR $A7B9        ; ...and jump to try to start a destroyer.
@label=SpawnEnemies_Random
*$A79A LD A,R          ; Fetch a number from the memory refresh register...
 $A79C AND $F3         ; ...limit it to a time and a direction...
 $A79E LD (IX+$07),A   ; ...and store it.
 $A7A1 LD A,($9658)    ; Fetch the number of sectors that have been activated.
 $A7A4 AND A           ; Test whether there are any.
 $A7A5 LD A,($9617)    ; Fetch the random number.
 $A7A8 JR NZ,$A7AC     ; Jump if some sectors have been activated, to use any of the kinds of
                       ; enemy.
 $A7AA AND $05         ; Otherwise limit the choice to the first two kinds of
                       ; enemy...
@label=SpawnEnemies_AnyKind
*$A7AC AND $07         ; ...and limit the choice to the eight entries of the
                       ; table.
 $A7AE LD L,A          ; {Use it as an index...
 $A7AF LD H,$00        ; }
 $A7B1 LD BC,$A81E     ; Point #REGbc at #R$A81E.
 $A7B4 ADD HL,BC       ; Add the index.
 $A7B5 LD A,(HL)       ; Fetch the type that the enemy is going to have...
 $A7B6 LD (IX+$05),A   ; ...and store it.
; Now try to start a destroyer. Destroyers are only started while a sector
; is under attack.
@label=SpawnEnemies_Destroyer
*$A7B9 LD HL,$9730     ; Point #REGhl at the first of the four entities that are used for
                       ; destroyers.
 $A7BC LD DE,$0010     ; Each entity is #N$10 bytes long.
 $A7BF LD B,$04        ; There are four entities to check.
@label=SpawnEnemies_FindDestroyer
*$A7C1 LD A,(HL)       ; Fetch the type of the entity.
 $A7C2 AND A           ; {Jump if it is not in use.
 $A7C3 JR Z,$A7C9      ; }
 $A7C5 ADD HL,DE       ; Move on to the next entity.
 $A7C6 DJNZ $A7C1      ; Loop back until all of them have been tried.
 $A7C8 RET             ; Return.
@label=SpawnEnemies_UseSecondEntity
*$A7C9 PUSH HL         ; Copy the address of the entity into #REGix...
 $A7CA POP IX          ; Pop it into #REGix.
 $A7CC LD B,$10        ; There are #N$10 bytes to clear.
@label=SpawnEnemies_ClearDestroyer
*$A7CE LD (HL),$00     ; Clear a byte of the entity.
 $A7D0 INC HL          ; Move on to the next byte.
 $A7D1 DJNZ $A7CE      ; Loop back until the entity has been cleared.
 $A7D3 LD A,($9647)    ; Fetch the code of the sector that is under attack...
 $A7D6 LD C,A          ; ...and keep it in #REGc.
 $A7D7 RRA             ; Move the bits for the row into place...
 $A7D8 RRA             ; Shift the row one more place.
 $A7D9 AND $30         ; ...and keep them.
 $A7DB CP $30          ; {Return if there is no sector under attack.
 $A7DD RET Z           ; }
 $A7DE XOR $30         ; Turn the row upside down...
 $A7E0 SUB $10         ; ...and use it to find the Y cell of the sector.
 $A7E2 LD H,A          ; Keep the Y cell.
 $A7E3 LD A,($9617)    ; Fetch the random number...
 $A7E6 AND $0F         ; ...limited to #N$00-#N$0F...
 $A7E8 OR H            ; ...and combine it with the sector to choose the Y
                       ; cell...
 $A7E9 LD H,A          ; ...and keep it in #REGh.
 $A7EA LD A,C          ; Fetch the code of the sector again.
 $A7EB RLA             ; {Move the bits for the column into place...
 $A7EC RLA             ;
 $A7ED RLA             ; }
 $A7EE AND $30         ; ...and keep them.
 $A7F0 CP $30          ; {Return if there is no sector under attack.
 $A7F2 RET Z           ; }
 $A7F3 LD D,A          ; Keep the sector.
 $A7F4 LD A,R          ; Fetch a number from the memory refresh register...
 $A7F6 AND $0F         ; ...limited to #N$00-#N$0F...
 $A7F8 OR D            ; ...combine it with the sector to choose the X cell...
 $A7F9 LD D,A          ; ...and keep it in #REGd.
 $A7FA LD L,$00        ; Use zero for the fraction of the Y position...
 $A7FC LD E,L          ; ...and of the X position.
 $A7FD CALL $BF97      ; Find the cell using #R$BF97.
 $A800 RET NZ          ; Return if it is not empty.
 $A801 LD (IX+$00),$40 ; Start the destroyer with the first sprite of the sequence that shows
                       ; it materialising.
 $A805 CALL $AEE0      ; Store its position.
 $A808 CALL $A576      ; Check whether another enemy is in the way using
                       ; #R$A576.
 $A80B JR NC,$A812     ; Jump if there is not.
 $A80D LD (IX+$00),$00 ; Otherwise cancel the new destroyer...
 $A811 RET             ; ...and return.
@label=SpawnEnemies_SetType
*$A812 LD (IX+$05),$64 ; Set the type that the destroyer will have when it has
                       ; materialised.
 $A816 LD A,R          ; {Choose a random direction and time...
 $A818 AND $F3         ; }
 $A81A LD (IX+$07),A   ; ...and store it.
 $A81D RET             ; Return.

; Enemy Types
;
; The types of enemy that are started, selected at random. Until the first
; sector has been activated only the first two types (#N$08 and #N$0C) are used.
@label=EnemyTypes
b$A81E DEFB $08,$0C,$50,$60 ; {Types #N$08 and #N($0C), then #N$50 and #N$60.
 $A822 DEFB $08,$0C,$50,$60 ; }

; Move Saucer
;
; The handler for entity types #N$08 to #N($0B), which are the saucers. A
; saucer is the faster of the two types of enemy that wander about at random; it
; can take up to #N$60 steps in a frame. A saucer that hits the robot explodes.
;
; IX Entity
@label=MoveSaucer
c$A826 CALL $B063    ; Move on to the next sprite using #R$B063.
 $A829 CALL $A104    ; Remove the entity if it is far from the camera using
                     ; #R$A104.
 $A82C CALL $AED3    ; Fetch the position of the entity.
 $A82F LD B,$60      ; The saucer can take up to #N$60 steps in this frame.
 $A831 JR $A83E      ; Jump to take the first step.

; Move Dome
;
; The handler for entity types #N$0C to #N($0F), which are the domes.
; A dome is the slower of the two types of enemy that wander about at
; random; it can take up to #N$20 steps in a frame.
;
; IX Entity
@label=MoveDome
c$A833 CALL $B063    ; Move on to the next sprite using #R$B063.
 $A836 CALL $A104    ; Remove the entity if it is far from the camera using
                     ; #R$A104.
 $A839 CALL $AED3    ; Fetch the position of the entity.
 $A83C LD B,$20      ; The dome can take up to #N$20 steps in this frame.
; This entry point is used by the routine at #R$A826.
; .
; This entry point is shared by both kinds of enemy.
@label=MoveEnemy_Step
*$A83E CALL $A12D    ; Take a step using #R$A12D.
 $A841 JR NZ,$A862   ; Jump if the enemy has been blocked.
 $A843 CALL $A576    ; Check whether the enemy has run into another entity
                     ; using #R$A576.
 $A846 JR C,$A887    ; Jump if it has, to turn it round.
 $A848 LD A,E        ; {Jump if the enemy is not at the start of a cell.
 $A849 OR L          ;
 $A84A JR NZ,$A85C   ; }
 $A84C LD A,(IX+$07) ; Fetch the time and direction of the enemy...
 $A84F SUB $10       ; ...take away one cell...
 $A851 LD (IX+$07),A ; ...and store it.
 $A854 AND $F0       ; {Jump to choose a new direction if the time has run out.
 $A856 JR Z,$A862    ; }
 $A858 LD A,B        ; {Loop back to take another step if there are steps left.
 $A859 AND A         ;
 $A85A JR NZ,$A83E   ; }
@label=MoveEnemy_Store
*$A85C CALL $AEE0    ; Store the position of the enemy using #R$AEE0.
 $A85F JP $BDCD      ; Jump to #R$BDCD.
@label=MoveEnemy_Turn
*$A862 LD A,(IX+$07) ; Fetch the time and direction of the enemy...
 $A865 AND $0F       ; ...keep the direction only...
 $A867 LD (IX+$07),A ; ...and store it.
 $A86A LD A,($9615)  ; Fetch the frame counter...
 $A86D AND $03       ; ...and use it as a random direction.
 $A86F CP (IX+$07)   ; Compare it with the current direction.
 $A872 JR NZ,$A877   ; Jump if they are different.
 $A874 INC A         ; Otherwise turn a quarter of a turn.
 $A875 AND $03       ; Keep the direction within four.
@label=MoveDome_NewDirection
*$A877 LD C,A        ; Keep the new direction.
 $A878 LD A,($9617)  ; Fetch the random number...
 $A87B AND $F0       ; {...and use the upper bits as the time to keep going in this
 $A87D JR NZ,$A881   ; direction.}
 $A87F OR $10        ; Use a time of one cell if that is zero.
@label=MoveDome_SetTime
*$A881 OR C          ; Combine the time with the new direction...
 $A882 LD (IX+$07),A ; ...and store them.
 $A885 JR $A85C      ; Jump back to store the position.
@label=MoveEnemy_Collide
*$A887 CALL $A891    ; Turn the enemy round using #R$A891.
 $A88A CALL $BDCD    ; Draw it using #R$BDCD.
 $A88D RET NC        ; Return if it is off the screen.
 $A88E JP $C048      ; Make the sound of a bump using #R$C048.

; Reverse Direction
;
; Used by the routines at #R$A218, #R$A4EC and #R$A833.
; .
; Turns an enemy round, so that it faces the opposite direction.
;
; IX Entity
@label=ReverseDirection
c$A891 PUSH BC       ; Save #REGbc.
 $A892 LD A,(IX+$07) ; Fetch the time and direction of the enemy...
 $A895 LD C,A        ; ...and keep them in #REGc.
 $A896 ADD A,$02     ; Add two to the direction...
 $A898 AND $03       ; ...and keep just the direction...
 $A89A LD B,A        ; ...in #REGb.
 $A89B LD A,C        ; Fetch the time and direction again...
 $A89C AND $FC       ; ...clear the old direction...
 $A89E OR B          ; ...and use the new one.
 $A89F LD (IX+$07),A ; Store them.
 $A8A2 POP BC        ; Restore #REGbc.
 $A8A3 RET           ; Return.

; Finish Robot Turn
;
; The handler for entity types #N$20 to #N($2F), which are the sprites
; that the robot has while it is turning. The turn is finished at once;
; the entity gets one of the types for walking (#N$10 to #N$1F) and the robot
; is checked
; for a collision with an enemy. If the robot has hit an enemy it loses some
; energy, and it is destroyed if it has none left. This routine then handles the
; entity again as its new type, without drawing it.
;
; IX Entity
@label=FinishRobotTurn
c$A8A4 LD A,($9625)  ; Fetch the controls...
 $A8A7 AND $FC       ; ...clear the left and right bits...
 $A8A9 LD ($9625),A  ; ...and store them.
 $A8AC LD B,(IX+$06) ; Fetch the speed of the robot into #REGb.
 $A8AF LD C,$00      ; Clear the low byte of the step count.
 $A8B1 LD A,(IX+$00) ; Fetch the type of the robot...
 $A8B4 AND $8F       ; {...change it into the matching type for walking...
 $A8B6 OR $10        ; }
 $A8B8 LD (IX+$00),A ; ...and store it.
 $A8BB LD A,(IX+$00) ; Fetch the new type...
 $A8BE EX AF,AF'     ; ...and keep it in #REGa'.
 $A8BF CALL $A5A7    ; Check whether the robot has hit an enemy using #R$A5A7.
 $A8C2 LD A,(IX+$00) ; Fetch the type of the robot again.
 $A8C5 CP $38        ; {Jump if it has not been turned into smoke.
 $A8C7 JR NZ,$A8E0   ; }
 $A8C9 LD A,($965A)  ; Fetch the number of sectors that have been dealt with.
 $A8CC ADD A,$1A     ; Add #N$1A to get the energy that the collision costs...
 $A8CE LD B,A        ; ...and keep it in #REGb.
 $A8CF LD A,($963B)  ; Fetch the energy of the battery.
 $A8D2 SUB B         ; Take off the cost.
 $A8D3 JR C,$A8DC    ; Jump if there is not enough energy.
 $A8D5 EX AF,AF'     ; Otherwise get the type that the robot had...
 $A8D6 LD (IX+$00),A ; ...and restore it, so that it is not destroyed...
 $A8D9 EX AF,AF'     ; Switch back to the energy.
 $A8DA JR $A8DD      ; ...and jump to store the energy.
@label=FinishRobotTurn_NoEnergy
*$A8DC XOR A         ; The battery is empty.
@label=FinishRobotTurn_Store
*$A8DD LD ($963B),A  ; Store the energy of the battery.
@label=FinishRobotTurn_Discard
*$A8E0 POP HL        ; Discard the return address...
 $A8E1 JP $9970      ; ...and handle the entity again as its new type using
                     ; #R$9970.

; Get Robot Speed
;
; Used by the routine at #R$AB03.
; .
; Works out how far the robot moves in this frame. When the robot is told
; to speed up it uses some energy and accelerates, up to a limit of #N$40. When
; it is not it slows down: the speed is the distance to the next cell, in the
; direction that it is heading, so the robot always stops at the start of a
; cell.
;
;   IX Robot
; O:B The distance to move
@label=GetRobotSpeed
c$A8E4 LD A,($9625)  ; Fetch the controls.
 $A8E7 BIT 2,A       ; {Jump if the key to speed up is being pressed.
 $A8E9 JR NZ,$A91C   ; }
 $A8EB LD A,(IX+$00) ; Fetch the type of the robot...
 $A8EE RRCA          ; {...and turn it into the direction that it is heading
 $A8EF RRCA          ; in.}
 $A8F0 AND $03       ; {Jump if the robot is heading in direction zero (X
 $A8F2 JR Z,$A90B    ; decreasing).}
 $A8F4 DEC A         ; Count down the direction.
 $A8F5 JR Z,$A904    ; Jump if the robot is heading in direction one (Y
                     ; increasing).
 $A8F7 DEC A         ; Count down the direction.
 $A8F8 JR Z,$A8FF    ; Jump if the robot is heading in direction two (X
                     ; increasing).
 $A8FA LD A,(IX+$03) ; The robot is heading in direction three (Y decreasing), so fetch the
                     ; fraction of the Y position...
 $A8FD JR $A90E      ; ...and jump to limit the distance.
@label=GetRobotSpeed_XIncreasing
*$A8FF LD A,(IX+$01) ; Fetch the fraction of the X position of the robot...
 $A902 JR $A907      ; ...and jump to turn it round.
@label=GetRobotSpeed_YIncreasing
*$A904 LD A,(IX+$03) ; Fetch the fraction of the Y position of the robot.
@label=GetRobotSpeed_Negate
*$A907 NEG           ; Subtract it from zero, to get the distance to the next
                     ; cell.
 $A909 JR $A90E      ; Jump to limit the distance.
@label=GetRobotSpeed_XDecreasing
*$A90B LD A,(IX+$01) ; Fetch the fraction of the X position of the robot.
@label=GetRobotSpeed_Limit
*$A90E CP $40        ; {Jump if the distance is below #N$40...
 $A910 JR C,$A914    ; }
@label=GetRobotSpeed_UseDefault
*$A912 LD A,$40      ; ...otherwise use #N$40.
@label=GetRobotSpeed_Store
*$A914 LD (IX+$06),A ; Store the speed of the robot...
 $A917 LD A,(IX+$06) ; ...and fetch it...
 $A91A LD B,A        ; ...into #REGb.
 $A91B RET           ; Return.
@label=GetRobotSpeed_Accelerate
*$A91C RES 2,A       ; Clear the bit for speeding up...
 $A91E LD ($9625),A  ; ...and store the controls.
 $A921 LD DE,$0008   ; Using this costs eight units of energy.
 $A924 CALL $A6AE    ; Take them out of the battery using #R$A6AE.
 $A927 LD A,(IX+$06) ; Fetch the speed of the robot...
 $A92A ADD A,$10     ; ...and add #N$10.
 $A92C CP $40        ; {Jump to store it if the new speed is below #N$40.
 $A92E JR C,$A914    ; }
 $A930 JR $A912      ; Otherwise jump to use #N$40.

; Materialise Entity
;
; The handler for entity types #N$40 to #N($4A), which are the sprites
; that show an enemy, or the robot, materialising. When the entity is
; going to be the robot it is drawn twice, once at a slight offset, which makes
; the picture look
; like it is shimmering. Each sprite is shown for a frame, and the next one is
; chosen by changing the type.
;
; IX Entity
@label=MaterialiseEntity
c$A932 LD A,(IX+$05) ; Fetch the type that the entity will have when it has finished
                     ; materialising.
 $A935 SUB $10       ; {Jump if that is a type for the robot (#N$10 to #N$2F).
 $A937 CP $20        ;
 $A939 JR C,$A947    ; }
 $A93B CALL $BDCD    ; Draw the entity using #R$BDCD.
 $A93E JR NC,$A943   ; Jump if it is not on the screen.
 $A940 CALL $C01A    ; Make the sound of materialising using #R$C01A.
@label=MaterialiseEntity_Next
*$A943 INC (IX+$00)  ; Move on to the next sprite.
 $A946 RET           ; Return.
@label=MaterialiseEntity_Robot
*$A947 PUSH IX       ; Save the address of the entity...
 $A949 POP HL        ; ...and copy it into #REGhl.
 $A94A PUSH HL       ; Save it again.
 $A94B LD IX,$A96C   ; Use a temporary entity at #R$A96C...
 $A94F LD DE,$A96C   ; ...as the destination...
 $A952 LD BC,$0008   ; ...and copy the first eight bytes...
 $A955 LDIR          ; ...of the entity into it.
 $A957 LD L,(IX+$01) ; Fetch the X position of the entity...
 $A95A LD H,(IX+$02) ; ...and the Y position.
 $A95D LD DE,$0040   ; Use an offset of #N$0040 in the X direction.
 $A960 CALL $A974    ; Draw the entity at the offset using #R$A974.
 $A963 JR NC,$A968   ; Jump if it is not on the screen.
 $A965 CALL $C01A    ; Make the sound of materialising using #R$C01A.
@label=MaterialiseEntity_OffScreen
*$A968 POP IX        ; Restore the entity.
 $A96A JR $A943      ; Jump to move on to the next sprite.

; Temporary Entity
;
; A copy of the first eight bytes of an entity, which is used while a
; robot is drawn at an offset.
@label=TemporaryEntity
b$A96C DEFB $00,$00,$00,$00,$00,$00,$00,$00

; Draw Shifted Entity
;
; Used by the routine at #R$A932.
; .
; Draws an entity at an offset in the X direction, and then puts its
; position back.
;
; IX Entity
; HL X position
; DE Offset
@label=DrawShiftedEntity
c$A974 PUSH HL       ; Save the X position.
 $A975 ADD HL,DE     ; Add the offset...
 $A976 LD A,H        ; {...and keep the X cell within the map.
 $A977 AND $3F       ;
 $A979 LD H,A        ; }
 $A97A LD (IX+$01),L ; Store the X position of the entity...
 $A97D LD (IX+$02),H ; Store the X cell.
 $A980 CALL $BDCD    ; Draw the entity using #R$BDCD.
 $A983 POP HL        ; Restore the X position...
 $A984 LD (IX+$01),L ; ...and store it again.
 $A987 LD (IX+$02),H ; Store the X cell again.
 $A98A RET           ; Return.

; Finish Materialising
;
; The handler for entity type #N($4B), which is the last sprite that shows
; an entity materialising. The entity is drawn, and then given the type that it
; is going to keep. If it is the robot then the controls are cleared.
;
; IX Entity
@label=FinishMaterialising
c$A98B CALL $BDCD    ; Draw the entity using #R$BDCD.
 $A98E LD A,(IX+$05) ; Fetch the type that the entity is going to have...
 $A991 LD (IX+$00),A ; ...and set it.
 $A994 CP $10        ; {Return if it is below #N$10.
 $A996 RET C         ; }
 $A997 CP $30        ; {Return if it is #N$30 or above, as it is not the robot.
 $A999 RET NC        ; }
 $A99A XOR A         ; Clear the controls...
 $A99B LD ($9625),A  ; Store the controls.
 $A99E RET           ; Return.

; Start Robot
;
; Used by the routines at #R$9A4B and #R$B72B.
; .
; Starts a new life. The robot is given the type that makes it wait, the
; number of lives goes down by one, the battery is filled up and the robot is
; shown on the map of the sectors.
@label=StartRobot
c$A99F LD A,$58      ; {Set the type of the robot to #N($58), which makes it
 $A9A1 LD ($9690),A  ; wait.}
 $A9A4 LD A,$20      ; {Set its timer to #N$20 frames.
 $A9A6 LD ($9696),A  ; }
; See #POKE(infinite_lives,Infinite Lives).
 $A9A9 LD HL,$968B   ; Point #REGhl at #R$968B.
 $A9AC DEC (HL)      ; ...and take one off.
 $A9AD XOR A         ; {Clear the controls.
 $A9AE LD ($9625),A  ; }
 $A9B1 LD A,$74      ; {Fill up the battery.
 $A9B3 LD ($963B),A  ; }
 $A9B6 LD DE,($9691) ; Fetch the X position of the robot...
 $A9BA LD HL,($9693) ; ...and the Y position.
 $A9BD CALL $AE67    ; Draw the robot on the map of the sectors using #R$AE67.
 $A9C0 JP $A091      ; Flash the panel using #R$A091.

; Move Entity
;
; Used by the routines at #R$A12D and #R$A2B5.
; .
; Moves an entity in the direction that it is heading, by up to the number
; of steps that is given. The entity stops at the start of a cell if the next
; cell is not empty. The routine keeps a copy of the position, so that a move
; can be undone.
;
;   B Number of steps to take
;   DE X position
;   HL Y position
;   IX Entity
; O:A #N$01 if the entity has been blocked
; O:B Number of steps that are left
; O:DE New X position
; O:HL New Y position
; O:F The zero flag is reset if the entity has been blocked
@label=MoveEntity
c$A9C3 LD ($9653),DE ; Keep the X position...
 $A9C7 LD ($9655),HL ; ...and the Y position, so that the move can be undone.
 $A9CA LD A,(IX+$07) ; Fetch the direction of the entity...
 $A9CD AND $03       ; {...and jump to move in direction zero (X decreasing)...
 $A9CF JP Z,$A9DD    ; }
 $A9D2 DEC A         ; {...or direction one (Y increasing)...
 $A9D3 JP Z,$AA1A    ; }
 $A9D6 DEC A         ; {...or direction two (X increasing)...
 $A9D7 JP Z,$AA58    ; }
 $A9DA JP $AA97      ; ...or otherwise direction three (Y decreasing).

; Move Left
;
; Used by the routines at #R$A9C3 and #R$AB57.
; .
; Moves an entity in direction zero, which decreases the X position. See
; #R$A9C3 for how the move works.
;
;   B Number of steps to take
;   DE X position
;   HL Y position
; O:A #N$01 if the entity has been blocked
; O:B Number of steps that are left
; O:DE New X position
; O:F The zero flag is reset if the entity has been blocked
@label=MoveLeft
c$A9DD LD A,B        ; {Return if there are no steps left.
 $A9DE AND A         ;
 $A9DF RET Z         ; }
 $A9E0 LD A,E        ; {Jump if the entity is at the start of a cell.
 $A9E1 AND A         ;
 $A9E2 JR Z,$A9F1    ; }
 $A9E4 SUB B         ; {Take the steps off the fraction, and jump if that goes back into the
 $A9E5 JR C,$A9EB    ; previous cell.}
 $A9E7 LD E,A        ; Store the new fraction.
@label=MoveLeft_Finish
*$A9E8 XOR A         ; {Clear the number of steps that are left, and return with the zero
 $A9E9 LD B,A        ; flag set.
 $A9EA RET           ; }
@label=MoveLeft_NextCell
*$A9EB NEG           ; Work out how many steps are left over...
 $A9ED LD B,A        ; ...and keep them in #REGb.
 $A9EE XOR A         ; {Move to the start of the cell, and return with the zero
 $A9EF LD E,A        ; flag set.}
 $A9F0 RET           ; Return.
@label=MoveLeft_CellStart
*$A9F1 PUSH DE       ; Save the X position.
 $A9F2 SUB B         ; Take the steps off the fraction, which goes back into the previous
                     ; cell...
 $A9F3 LD E,A        ; ...and keep it.
 $A9F4 LD A,D        ; Fetch the X cell...
 $A9F5 SBC A,$00     ; ...and take one off...
 $A9F7 AND $3F       ; {...making sure that the cell is within the map.
 $A9F9 LD D,A        ; }
 $A9FA LD ($9653),DE ; Keep this position.
 $A9FE CALL $BF97    ; Find the cell using #R$BF97.
 $AA01 JR Z,$AA11    ; Jump if the cell is empty.
 $AA03 PUSH HL       ; Save the Y position.
 $AA04 LD HL,($962E) ; Fetch the address of the cell...
 $AA07 LD A,(HL)     ; ...and its contents...
 $AA08 POP HL        ; ...and restore the Y position.
 $AA09 AND $0F       ; {Jump if the cell has no type.
 $AA0B JR Z,$AA11    ; }
 $AA0D CP $0F        ; {Jump if the cell is not type #N($0F), which is an
 $AA0F JR NZ,$AA15   ; obstacle.}
@label=MoveLeft_Clear
*$AA11 INC SP        ; {Discard the old X position...
 $AA12 INC SP        ; }
 $AA13 JR $A9E8      ; ...and jump to finish the move.
@label=MoveLeft_Blocked
*$AA15 POP DE        ; The entity is blocked, so restore the old X position.
 $AA16 XOR A         ; {Clear the number of steps that are left...
 $AA17 LD B,A        ; }
 $AA18 INC A         ; ...and set #REGa to #N$01.
 $AA19 RET           ; Return.

; Move Up
;
; Used by the routines at #R$A9C3 and #R$AB57.
; .
; Moves an entity in direction one, which increases the Y position. See
; #R$A9C3 for how the move works.
;
;   B Number of steps to take
;   DE X position
;   HL Y position
; O:A #N$01 if the entity has been blocked
; O:B Number of steps that are left
; O:HL New Y position
; O:F The zero flag is reset if the entity has been blocked
@label=MoveUp
c$AA1A LD A,B        ; {Return if there are no steps left.
 $AA1B AND A         ;
 $AA1C RET Z         ; }
 $AA1D LD A,L        ; {Jump if the entity is at the start of a cell.
 $AA1E AND A         ;
 $AA1F JR Z,$AA31    ; }
 $AA21 ADD A,B       ; {Add the steps to the fraction, and jump if that goes into the next
 $AA22 JR C,$AA28    ; cell.}
 $AA24 LD L,A        ; Store the new fraction.
@label=MoveUp_Finish
*$AA25 XOR A         ; {Clear the number of steps that are left, and return with the zero
 $AA26 LD B,A        ; flag set.
 $AA27 RET           ; }
@label=MoveUp_NextCell
*$AA28 LD B,A        ; Keep the steps that are left over.
 $AA29 LD A,H        ; Fetch the Y cell...
 $AA2A INC A         ; ...and add one...
 $AA2B AND $3F       ; {...making sure that the cell is within the map.
 $AA2D LD H,A        ; }
 $AA2E XOR A         ; {Move to the start of the cell, and return with the zero
 $AA2F LD L,A        ; flag set.}
 $AA30 RET           ; Return.
@label=MoveUp_CellStart
*$AA31 ADD A,B       ; Add the steps to the fraction...
 $AA32 LD L,A        ; ...and keep it.
 $AA33 LD ($9655),HL ; Keep this position.
 $AA36 PUSH HL       ; Save the Y position.
 $AA37 LD A,H        ; Fetch the Y cell...
 $AA38 INC A         ; ...and add one...
 $AA39 AND $3F       ; {...making sure that the cell is within the map.
 $AA3B LD H,A        ; }
 $AA3C CALL $BF97    ; Find the cell using #R$BF97.
 $AA3F JR Z,$AA4F    ; Jump if the cell is empty.
 $AA41 PUSH HL       ; Save the Y position.
 $AA42 LD HL,($962E) ; Fetch the address of the cell...
 $AA45 LD A,(HL)     ; ...and its contents...
 $AA46 POP HL        ; ...and restore the Y position.
 $AA47 AND $0F       ; {Jump if the cell has no type.
 $AA49 JR Z,$AA4F    ; }
 $AA4B CP $0F        ; {Jump if the cell is not type #N($0F), which is an
 $AA4D JR NZ,$AA52   ; obstacle.}
@label=MoveUp_Clear
*$AA4F POP HL        ; Restore the Y position...
 $AA50 JR $AA25      ; ...and jump to finish the move.
@label=MoveUp_Blocked
*$AA52 POP HL        ; The entity is blocked, so restore the old Y position.
 $AA53 XOR A         ; {Clear the number of steps that are left...
 $AA54 LD B,A        ; }
 $AA55 LD L,A        ; ...and the fraction...
 $AA56 INC A         ; ...and set #REGa to #N$01.
 $AA57 RET           ; Return.

; Move Right
;
; Used by the routines at #R$A9C3 and #R$AB57.
; .
; Moves an entity in direction two, which increases the X position. See
; #R$A9C3 for how the move works.
;
;   B Number of steps to take
;   DE X position
;   HL Y position
; O:A #N$01 if the entity has been blocked
; O:B Number of steps that are left
; O:DE New X position
; O:F The zero flag is reset if the entity has been blocked
@label=MoveRight
c$AA58 LD A,B        ; {Return if there are no steps left.
 $AA59 AND A         ;
 $AA5A RET Z         ; }
 $AA5B LD A,E        ; {Jump if the entity is at the start of a cell.
 $AA5C AND A         ;
 $AA5D JR Z,$AA6F    ; }
 $AA5F ADD A,B       ; {Add the steps to the fraction, and jump if that goes into the next
 $AA60 JR C,$AA66    ; cell.}
 $AA62 LD E,A        ; Store the new fraction.
@label=MoveRight_Finish
*$AA63 XOR A         ; {Clear the number of steps that are left, and return with the zero
 $AA64 LD B,A        ; flag set.
 $AA65 RET           ; }
@label=MoveRight_NextCell
*$AA66 LD B,A        ; Keep the steps that are left over.
 $AA67 LD A,D        ; Fetch the X cell...
 $AA68 INC A         ; ...and add one...
 $AA69 AND $3F       ; {...making sure that the cell is within the map.
 $AA6B LD D,A        ; }
 $AA6C XOR A         ; {Move to the start of the cell, and return with the zero
 $AA6D LD E,A        ; flag set.}
 $AA6E RET           ; Return.
@label=MoveRight_CellStart
*$AA6F ADD A,B       ; Add the steps to the fraction...
 $AA70 LD E,A        ; ...and keep it.
 $AA71 LD ($9653),DE ; Keep this position.
 $AA75 PUSH DE       ; Save the X position.
 $AA76 LD A,D        ; Fetch the X cell...
 $AA77 INC A         ; ...and add one...
 $AA78 AND $3F       ; {...making sure that the cell is within the map.
 $AA7A LD D,A        ; }
 $AA7B CALL $BF97    ; Find the cell using #R$BF97.
 $AA7E JR Z,$AA8E    ; Jump if the cell is empty.
 $AA80 PUSH HL       ; Save the Y position.
 $AA81 LD HL,($962E) ; Fetch the address of the cell...
 $AA84 LD A,(HL)     ; ...and its contents...
 $AA85 POP HL        ; ...and restore the Y position.
 $AA86 AND $0F       ; {Jump if the cell has no type.
 $AA88 JR Z,$AA8E    ; }
 $AA8A CP $0F        ; {Jump if the cell is not type #N($0F), which is an
 $AA8C JR NZ,$AA91   ; obstacle.}
@label=MoveRight_Clear
*$AA8E POP DE        ; Restore the X position...
 $AA8F JR $AA63      ; ...and jump to finish the move.
@label=MoveRight_Blocked
*$AA91 POP DE        ; The entity is blocked, so restore the old X position.
 $AA92 XOR A         ; {Clear the number of steps that are left...
 $AA93 LD B,A        ; }
 $AA94 LD E,A        ; ...and the fraction...
 $AA95 INC A         ; ...and set #REGa to #N$01.
 $AA96 RET           ; Return.

; Move Down
;
; Used by the routines at #R$A9C3 and #R$AB57.
; .
; Moves an entity in direction three, which decreases the Y position. See
; #R$A9C3 for how the move works.
;
;   B Number of steps to take
;   DE X position
;   HL Y position
; O:A #N$01 if the entity has been blocked
; O:B Number of steps that are left
; O:HL New Y position
; O:F The zero flag is reset if the entity has been blocked
@label=MoveDown
c$AA97 LD A,B        ; {Return if there are no steps left.
 $AA98 AND A         ;
 $AA99 RET Z         ; }
 $AA9A LD A,L        ; {Jump if the entity is at the start of a cell.
 $AA9B AND A         ;
 $AA9C JR Z,$AAAB    ; }
 $AA9E SUB B         ; {Take the steps off the fraction, and jump if that goes back into the
 $AA9F JR C,$AAA5    ; previous cell.}
 $AAA1 LD L,A        ; Store the new fraction.
@label=MoveDown_Finish
*$AAA2 XOR A         ; {Clear the number of steps that are left, and return with the zero
 $AAA3 LD B,A        ; flag set.
 $AAA4 RET           ; }
@label=MoveDown_NextCell
*$AAA5 NEG           ; Work out how many steps are left over...
 $AAA7 LD B,A        ; ...and keep them in #REGb.
 $AAA8 XOR A         ; {Move to the start of the cell, and return with the zero
 $AAA9 LD L,A        ; flag set.}
 $AAAA RET           ; Return.
@label=MoveDown_CellStart
*$AAAB PUSH HL       ; Save the Y position.
 $AAAC SUB B         ; Take the steps off the fraction, which goes back into the previous
                     ; cell...
 $AAAD LD L,A        ; ...and keep it.
 $AAAE LD A,H        ; Fetch the Y cell...
 $AAAF SBC A,$00     ; ...and take one off...
 $AAB1 AND $3F       ; {...making sure that the cell is within the map.
 $AAB3 LD H,A        ; }
 $AAB4 LD ($9655),HL ; Keep this position.
 $AAB7 CALL $BF97    ; Find the cell using #R$BF97.
 $AABA JR Z,$AACA    ; Jump if the cell is empty.
 $AABC PUSH HL       ; Save the Y position.
 $AABD LD HL,($962E) ; Fetch the address of the cell...
 $AAC0 LD A,(HL)     ; ...and its contents...
 $AAC1 POP HL        ; ...and restore the Y position.
 $AAC2 AND $0F       ; {Jump if the cell has no type.
 $AAC4 JR Z,$AACA    ; }
 $AAC6 CP $0F        ; {Jump if the cell is not type #N($0F), which is an
 $AAC8 JR NZ,$AACE   ; obstacle.}
@label=MoveDown_Clear
*$AACA INC SP        ; {Discard the old Y position...
 $AACB INC SP        ; }
 $AACC JR $AAA2      ; ...and jump to finish the move.
@label=MoveDown_Blocked
*$AACE POP HL        ; The entity is blocked, so restore the old Y position.
 $AACF XOR A         ; {Clear the number of steps that are left...
 $AAD0 LD B,A        ; }
 $AAD1 INC A         ; ...and set #REGa to #N$01.
 $AAD2 RET           ; Return.

; Turn Robot Left
;
; Used by the routine at #R$AB57.
; .
; Turns the robot a quarter of a turn, so that its direction goes down by
; one. The robot is moved to the start of the cell, and it gets one of the types
; for turning (#N$20 to #N$2F).
;
; A Controls
; IX Robot
@label=TurnRobotLeft
c$AAD3 RES 1,A         ; Clear the bit of the controls for turning left...
 $AAD5 LD ($9625),A    ; ...and store them.
 $AAD8 LD A,(IX+$00)   ; Fetch the type of the robot.
 $AADB SUB $04         ; {Go back by one direction...
 $AADD AND $0D         ; }
 $AADF OR $20          ; ...keep the bits that are used for the sprite and mark it as
                       ; turning.
; This entry point is used by the routine at #R$AAED.
@label=TurnRobot_Store
*$AAE1 LD (IX+$00),A   ; Store the type of the robot.
 $AAE4 LD (IX+$01),$00 ; Move the robot to the start of the cell in the X
                       ; direction...
 $AAE8 LD (IX+$03),$00 ; ...and in the Y direction.
 $AAEC RET             ; Return.

; Turn Robot Right
;
; Used by the routine at #R$AB57.
; .
; Turns the robot a quarter of a turn, so that its direction goes up by
; one. The robot is moved to the start of the cell, and it gets one of the types
; for turning (#N$20 to #N$2F).
;
; A Controls
; IX Robot
@label=TurnRobotRight
c$AAED RES 0,A       ; Clear the bit of the controls for turning right...
 $AAEF LD ($9625),A  ; ...and store them.
 $AAF2 LD A,(IX+$00) ; Fetch the type of the robot.
 $AAF5 ADD A,$04     ; {Go forward by one direction...
 $AAF7 AND $0F       ; }
 $AAF9 OR $22        ; ...keep the bits that are used for the sprite and mark it as
                     ; turning.
 $AAFB JR $AAE1      ; Jump to store the type and finish.

; Move Robot Vertically
;
; The handler for entity types #N$14 to #N$17 and #N$1C to #N($1F), which
; are the robot when it is heading in direction one or three (up and down the
; map).
;
; IX Robot
@label=MoveRobotVertically
c$AAFD RES 7,(IX+$00) ; Show the sprite without flipping it.
 $AB01 JR $AB07       ; Jump to move the robot.

; Move Robot Horizontally
;
; The handler for entity types #N$10 to #N$13 and #N$18 to #N($1B), which
; are the robot when it is heading in direction zero or two (across the map).
;
; IX Robot
@label=MoveRobotHorizontally
c$AB03 SET 7,(IX+$00) ; Show the sprite flipped.
; This entry point is used by the routine at #R$AAFD.
; .
; This entry point is shared by both handlers. It does all of the work for
; the robot in a frame: it looks at the action key, shows the robot on the map,
; works out how far to move, moves the robot, checks whether it has hit an enemy
; and fires the weapons.
@label=UpdateRobot
*$AB07 CALL $AC7E     ; Deal with the action key using #R$AC7E.
 $AB0A CALL $AE67     ; Update the position of the robot on the map of the sectors using
                      ; #R$AE67.
 $AB0D CALL $A8E4     ; Find how far the robot can move using #R$A8E4.
 $AB10 LD A,(IX+$06)  ; Fetch the speed of the robot...
 $AB13 AND $F0        ; {...and move on to the next sprite using #R$B063 if the robot is
 $AB15 CALL NZ,$B063  ; moving fast enough.}
 $AB18 CALL $AB57     ; Move the robot using #R$AB57.
 $AB1B LD A,(IX+$00)  ; Fetch the type of the robot...
 $AB1E EX AF,AF'      ; ...and keep it in #REGa'.
 $AB1F CALL $A5A7     ; Check whether the robot has hit an enemy using #R$A5A7.
 $AB22 LD A,(IX+$00)  ; Fetch the type of the robot again.
 $AB25 CP $38         ; {Jump if it has not been turned into smoke.
 $AB27 JR NZ,$AB43    ; }
 $AB29 LD A,($965A)   ; Fetch the number of sectors that have been dealt with.
 $AB2C ADD A,$1A      ; Add #N$1A to get the energy that the collision costs...
 $AB2E LD B,A         ; ...and keep it in #REGb.
 $AB2F LD A,($963B)   ; Fetch the energy of the battery.
 $AB32 SUB B          ; Take off the cost.
 $AB33 JR C,$AB3C     ; Jump if there is not enough energy.
 $AB35 EX AF,AF'      ; Otherwise get the type that the robot had...
 $AB36 LD (IX+$00),A  ; ...and restore it, so that it is not destroyed...
 $AB39 EX AF,AF'      ; Switch back to the energy.
 $AB3A JR $AB40       ; ...and jump to store the energy.
@label=MoveRobotHorizontally_NoEnergy
*$AB3C CALL $A727     ; The battery is empty, so turn all of the enemies into smoke using
                      ; #R$A727.
 $AB3F XOR A          ; Set the energy to zero.
@label=UpdateRobot_Store
*$AB40 LD ($963B),A   ; Store the energy of the battery.
@label=MoveRobotHorizontally_ReadControls
*$AB43 LD A,($9625)   ; Fetch the controls.
 $AB46 BIT 3,A        ; {Jump if the second weapon is not being fired.
 $AB48 JR Z,$AB4F     ; }
 $AB4A CALL $A656     ; Fire the second weapon using #R$A656.
 $AB4D JR $AB54       ; Jump to draw the robot.
@label=MoveRobotHorizontally_FirstWeapon
*$AB4F BIT 4,A        ; {Fire the first weapon using #R$A626 if it is being
 $AB51 CALL NZ,$A626  ; fired.}
@label=UpdateRobot_Draw
*$AB54 JP $BDCD       ; Draw the robot using #R$BDCD.

; Move Robot
;
; Used by the routine at #R$AB03.
; .
; Moves the robot in the direction that it is heading, by the number of
; steps that is in #REGb. The robot can only turn when it is at the start of a
; cell: if a turn key is being pressed then the robot turns and carries on in
; the new direction. When the robot is blocked by something in the map then
; #R$AC30 deals with it.
;
; B Number of steps to take
; IX Robot
@label=MoveRobot
c$AB57 CALL $AED3     ; Fetch the position of the robot.
 $AB5A LD ($9653),DE  ; Keep the X position...
 $AB5E LD ($9655),HL  ; ...and the Y position, so that the move can be undone.
 $AB61 LD A,(IX+$00)  ; Fetch the type of the robot...
 $AB64 RRCA           ; {...and turn it into the direction that it is heading
 $AB65 RRCA           ; in.}
 $AB66 AND $03        ; {Jump to move in direction zero (X decreasing)...
 $AB68 JP Z,$AC01     ; }
 $AB6B DEC A          ; {...or direction one (Y increasing)...
 $AB6C JP Z,$ABD3     ; }
 $AB6F DEC A          ; {...or direction two (X increasing)...
 $AB70 JP Z,$ABA1     ; }
; Direction three (Y decreasing). The four sections that follow all work
; in the same way. When the robot is at the start of a cell, and a key to turn
; is being pressed, the robot is turned and the routine carries on with the
; section for the new direction. Otherwise the robot moves, and if it was
; blocked then #R$AC30 is called to deal with the obstacle. This is repeated
; until there are no more steps.
@label=MoveRobot_Down
*$AB73 LD A,L         ; {Jump if the robot is not at the start of a cell.
 $AB74 AND A          ;
 $AB75 JR NZ,$AB82    ; }
 $AB77 LD A,($9625)   ; Fetch the controls.
 $AB7A BIT 1,A        ; {Jump if the key to turn left is pressed.
 $AB7C JR NZ,$AB8F    ; }
 $AB7E BIT 0,A        ; {Jump if the key to turn right is pressed.
 $AB80 JR NZ,$AB98    ; }
@label=MoveRobot_DownStep
*$AB82 CALL $AA97     ; Move the robot down using #R$AA97.
 $AB85 CALL NZ,$AC30  ; Deal with the obstacle using #R$AC30 if it was blocked.
 $AB88 LD A,B         ; {Loop back if there are steps left.
 $AB89 AND A          ;
 $AB8A JR NZ,$AB73    ; }
 $AB8C JP $AC1A       ; Jump to #R$AC1A.
@label=MoveRobot_Down_TurnLeft
*$AB8F CALL $AAD3     ; Turn the robot left using #R$AAD3...
 $AB92 RES 7,(IX+$00) ; ...and show the sprite without flipping it.
 $AB96 JR $ABA1       ; Jump to carry on heading right.
@label=MoveRobot_Down_TurnRight
*$AB98 CALL $AAED     ; Turn the robot right using #R$AAED...
 $AB9B SET 7,(IX+$00) ; ...and show the sprite flipped.
 $AB9F JR $AC01       ; Jump to carry on heading left.
@label=MoveRobot_Right
*$ABA1 LD A,E         ; {Jump if the robot is not at the start of a cell.
 $ABA2 AND A          ;
 $ABA3 JR NZ,$ABB0    ; }
 $ABA5 LD A,($9625)   ; Fetch the controls.
 $ABA8 BIT 1,A        ; {Jump if the key to turn left is pressed.
 $ABAA JR NZ,$ABC1    ; }
 $ABAC BIT 0,A        ; {Jump if the key to turn right is pressed.
 $ABAE JR NZ,$ABCA    ; }
@label=MoveRobot_RightStep
*$ABB0 CALL $AA58     ; Move the robot right using #R$AA58.
 $ABB3 CALL NZ,$AC30  ; Deal with the obstacle using #R$AC30 if it was blocked.
 $ABB6 LD A,B         ; {Loop back if there are steps left.
 $ABB7 AND A          ;
 $ABB8 JR NZ,$ABA1    ; }
 $ABBA SET 7,(IX+$00) ; Show the sprite flipped.
 $ABBE JP $AC1A       ; Jump to #R$AC1A.
@label=MoveRobot_Right_TurnLeft
*$ABC1 CALL $AAD3     ; Turn the robot left using #R$AAD3...
 $ABC4 SET 7,(IX+$00) ; ...and show the sprite flipped.
 $ABC8 JR $ABD3       ; Jump to carry on heading up.
@label=MoveRobot_Right_TurnRight
*$ABCA CALL $AAED     ; Turn the robot right using #R$AAED...
 $ABCD SET 7,(IX+$00) ; ...and show the sprite flipped.
 $ABD1 JR $AB73       ; Jump to carry on heading down.
@label=MoveRobot_Up
*$ABD3 LD A,L         ; {Jump if the robot is not at the start of a cell.
 $ABD4 AND A          ;
 $ABD5 JR NZ,$ABE2    ; }
 $ABD7 LD A,($9625)   ; Fetch the controls.
 $ABDA BIT 1,A        ; {Jump if the key to turn left is pressed.
 $ABDC JR NZ,$ABEF    ; }
 $ABDE BIT 0,A        ; {Jump if the key to turn right is pressed.
 $ABE0 JR NZ,$ABF8    ; }
@label=MoveRobot_UpStep
*$ABE2 CALL $AA1A     ; Move the robot up using #R$AA1A.
 $ABE5 CALL NZ,$AC30  ; Deal with the obstacle using #R$AC30 if it was blocked.
 $ABE8 LD A,B         ; {Loop back if there are steps left.
 $ABE9 AND A          ;
 $ABEA JR NZ,$ABD3    ; }
 $ABEC JP $AC1A       ; Jump to #R$AC1A.
@label=MoveRobot_Up_TurnLeft
*$ABEF CALL $AAD3     ; Turn the robot left using #R$AAD3...
 $ABF2 RES 7,(IX+$00) ; ...and show the sprite without flipping it.
 $ABF6 JR $AC01       ; Jump to carry on heading left.
@label=MoveRobot_Up_TurnRight
*$ABF8 CALL $AAED     ; Turn the robot right using #R$AAED...
 $ABFB SET 7,(IX+$00) ; ...and show the sprite flipped.
 $ABFF JR $ABA1       ; Jump to carry on heading right.
@label=MoveRobot_Left
*$AC01 LD A,E         ; {Jump if the robot is not at the start of a cell.
 $AC02 AND A          ;
 $AC03 JR NZ,$AC10    ; }
 $AC05 LD A,($9625)   ; Fetch the controls.
 $AC08 BIT 1,A        ; {Jump if the key to turn left is pressed.
 $AC0A JR NZ,$AC1D    ; }
 $AC0C BIT 0,A        ; {Jump if the key to turn right is pressed.
 $AC0E JR NZ,$AC27    ; }
@label=MoveRobot_LeftStep
*$AC10 CALL $A9DD     ; Move the robot left using #R$A9DD.
 $AC13 CALL NZ,$AC30  ; Deal with the obstacle using #R$AC30 if it was blocked.
 $AC16 LD A,B         ; {Loop back if there are steps left.
 $AC17 AND A          ;
 $AC18 JR NZ,$AC01    ; }
@label=MoveRobot_Store
*$AC1A JP $AEE0       ; Jump to #R$AEE0.
@label=MoveRobot_Left_TurnLeft
*$AC1D CALL $AAD3     ; Turn the robot left using #R$AAD3...
 $AC20 RES 7,(IX+$00) ; ...and show the sprite without flipping it.
 $AC24 JP $AB73       ; Jump to carry on heading down.
@label=MoveRobot_Left_TurnRight
*$AC27 CALL $AAED     ; Turn the robot right using #R$AAED...
 $AC2A RES 7,(IX+$00) ; ...and show the sprite without flipping it.
 $AC2E JR $ABD3       ; Jump to carry on heading up.

; Handle Obstacle
;
; Used by the routine at #R$AB57.
; .
; Deals with the cell that has blocked the robot. If it is a battery then
; the cell is emptied and the battery is refilled; otherwise a beep is made.
;
; IX Robot
@label=HandleObstacle
c$AC30 PUSH HL       ; Save the Y position.
 $AC31 LD HL,($962E) ; Fetch the address of the cell...
 $AC34 LD A,(HL)     ; ...and its contents...
 $AC35 AND $0F       ; ...and keep the type.
 $AC37 CP $03        ; {Jump if the cell is not a battery (type #N$03).
 $AC39 JR NZ,$AC52   ; }
 $AC3B LD A,(HL)     ; Fetch the contents of the cell...
 $AC3C AND $F0       ; {...and clear the type, so that the battery is gone...
 $AC3E LD (HL),A     ; }
 $AC3F CALL $C048    ; Make a sound using #R$C048.
 $AC42 LD A,$74      ; {Fill up the battery.
 $AC44 LD ($963B),A  ; }
 $AC47 PUSH BC       ; Save #REGbc...
 $AC48 PUSH DE       ; ...and #REGde.
 $AC49 LD C,$46      ; {Flash the panel in bright yellow using #R$9EEB.
 $AC4B CALL $9EEB    ; }
 $AC4E POP DE        ; Restore #REGde...
 $AC4F POP BC        ; ...and #REGbc.
@label=HandleObstacle_Return
*$AC50 POP HL        ; Restore the Y position.
 $AC51 RET           ; Return.
@label=HandleObstacle_NotBattery
*$AC52 CP $0F        ; {Jump if the cell is type #N($0F), to undo the move.
 $AC54 JR Z,$AC5B    ; }
 $AC56 CALL $C027    ; Make a beep using #R$C027.
 $AC59 JR $AC50      ; Jump to return.
@label=HandleObstacle_Undo
*$AC5B POP HL        ; Discard the saved Y position.
 $AC5C LD HL,($9655) ; Restore the Y position...
 $AC5F LD DE,($9653) ; ...and the X position from before the move.
 $AC63 RET           ; Return.

; Use Action Key
;
; Handles the action key, which picks up a program from the cell that is
; in front of the robot, drops a program into it, or installs a program in a
; socket (a cell of type #N$0F). It only works when the robot is at the start of
; a cell, and the key has to be released between presses. The programs that the
; robot carries are kept in a queue, which is handled by #R$AD34.
;
; .
;
; The first part of the code works out the position of the cell in front
; of the robot. These entry points are used when the robot is heading up, right
; and left.
@label=UseActionKey_Up
c$AC64 LD A,H          ; {Move up one cell, keeping the Y cell within the map.
 $AC65 INC A           ;
 $AC66 AND $3F         ;
 $AC68 LD H,A          ; }
 $AC69 JR $ACB1        ; Jump to use the cell.
@label=UseActionKey_Right
*$AC6B LD A,D          ; {Move right one cell, keeping the X cell within the
 $AC6C INC A           ; map.
 $AC6D AND $3F         ;
 $AC6F LD D,A          ; }
 $AC70 JR $ACB1        ; Jump to use the cell.
@label=UseActionKey_Left
*$AC72 LD A,D          ; {Move left one cell, keeping the X cell within the
 $AC73 DEC A           ; map.
 $AC74 AND $3F         ;
 $AC76 LD D,A          ; }
 $AC77 JR $ACB1        ; Jump to use the cell.
@label=UseActionKey_Release
*$AC79 XOR A           ; {Clear the flag that says that the action key has been
 $AC7A LD ($9652),A    ; used.}
 $AC7D RET             ; Return.
; This entry point is used by the routine at #R$AB03.
; .
; This is the entry point of the routine.
@label=UseActionKey
*$AC7E CALL $AED3      ; Fetch the position of the robot.
 $AC81 LD A,L          ; {Return if the robot is not at the start of a cell.
 $AC82 OR E            ;
 $AC83 RET NZ          ; }
 $AC84 LD A,($9625)    ; {Jump to clear the flag if the action key is not being
 $AC87 AND $40         ; pressed.
 $AC89 JR Z,$AC79      ; }
 $AC8B LD A,($9652)    ; {Return if the action key has been used already.
 $AC8E AND A           ;
 $AC8F RET NZ          ; }
 $AC90 LD A,$01        ; {Set the flag that says that the action key has been
 $AC92 LD ($9652),A    ; used.}
 $AC95 EXX             ; {Start effect #N$00 (four tones) for #R$BFDA.
 $AC96 LD HL,$0004     ;
 $AC99 LD ($9688),HL   ;
 $AC9C EXX             ; }
 $AC9D LD A,(IX+$00)   ; Fetch the type of the robot...
 $ACA0 RRA             ; {...and turn it into the direction that it is heading
 $ACA1 RRA             ; in.}
 $ACA2 AND $03         ; {Jump if the robot is heading in direction zero (X
 $ACA4 JR Z,$AC72      ; decreasing).}
 $ACA6 DEC A           ; {Jump if the robot is heading in direction one (Y
 $ACA7 JR Z,$AC64      ; increasing).}
 $ACA9 DEC A           ; {Jump if the robot is heading in direction two (X
 $ACAA JR Z,$AC6B      ; increasing).}
 $ACAC LD A,H          ; {Otherwise move down one cell, keeping the Y cell
 $ACAD DEC A           ; within the map.
 $ACAE AND $3F         ;
 $ACB0 LD H,A          ; }
@label=UseActionKey_Cell
*$ACB1 LD ($ADBF),DE   ; Keep the X position of the cell...
 $ACB5 LD ($ADC1),HL   ; ...and the Y position.
 $ACB8 CALL $BF97      ; Find the cell using #R$BF97.
 $ACBB LD HL,($962E)   ; Fetch the address of the cell.
 $ACBE JR Z,$ACCB      ; Jump if the cell is empty.
 $ACC0 LD A,(HL)       ; Fetch the contents of the cell...
 $ACC1 AND $0F         ; ...and keep the type.
 $ACC3 CP $06          ; {Jump if the cell is a program (type #N$06).
 $ACC5 JR Z,$ACCB      ; }
 $ACC7 CP $0F          ; {Return if the cell is not a socket (type #N$0F).
 $ACC9 RET NZ          ; }
 $ACCA XOR A           ; Use zero, as there is no program to pick up.
@label=UseActionKey_Queue
*$ACCB CALL $AD34      ; Add the program, or zero, to the queue using #R$AD34.
 $ACCE AND A           ; {Jump if a program was pushed out of the queue.
 $ACCF JR NZ,$ACDD     ; }
 $ACD1 LD A,(HL)       ; Fetch the contents of the cell...
 $ACD2 LD C,A          ; ...and keep them.
 $ACD3 AND $0F         ; Keep the type.
 $ACD5 CP $0F          ; {Return if the cell is a socket.
 $ACD7 RET Z           ; }
 $ACD8 LD A,C          ; Fetch the contents of the cell...
 $ACD9 AND $F0         ; ...clear the type, so that the program has gone...
 $ACDB LD (HL),A       ; ...and store it.
 $ACDC RET             ; Return.
@label=UseActionKey_Drop
*$ACDD LD A,(HL)       ; Fetch the contents of the cell.
 $ACDE AND $0F         ; Keep the type.
 $ACE0 CP $0F          ; Test whether it is a socket.
 $ACE2 LD A,$06        ; Use type #N($06), so that the program is dropped on
                       ; the floor...
 $ACE4 JR NZ,$AD2D     ; ...unless the cell is a socket.
 $ACE6 PUSH HL         ; Save the address of the cell.
 $ACE7 CALL $9C5E      ; Find the sector that the robot is in using #R$9C5E.
 $ACEA LD E,D          ; Put the sector number in #REGe...
 $ACEB LD D,$00        ; ...and clear #REGd.
 $ACED LD HL,$A361     ; Point #REGhl at #R$A361.
 $ACF0 ADD HL,DE       ; Add the sector number.
 $ACF1 LD A,(HL)       ; Fetch the energy of the sector.
 $ACF2 AND A           ; {Jump if there is none.
 $ACF3 JR Z,$ACFD      ; }
 $ACF5 LD HL,$965B     ; Point #REGhl at #R$965B.
 $ACF8 ADD HL,DE       ; Add the sector number.
 $ACF9 LD A,(HL)       ; Fetch the flag of the sector.
 $ACFA AND A           ; {Jump to install the program if the sector has not
 $ACFB JR Z,$AD23      ; been activated.}
@label=UseActionKey_Refuse
*$ACFD POP HL          ; Restore the address of the cell.
 $ACFE LD IY,$98B0     ; Point #REGiy at the first of the two entities that are used for
                       ; clouds.
 $AD02 LD DE,$0010     ; Each entity is #N$10 bytes long.
 $AD05 LD A,(IY+$00)   ; Fetch the type of the entity.
 $AD08 AND A           ; {Jump if it is not in use.
 $AD09 JR Z,$AD12      ; }
 $AD0B ADD IY,DE       ; Move on to the second entity.
 $AD0D LD A,(IY+$00)   ; Fetch the type of the entity.
 $AD10 AND A           ; {Return if it is in use as well.
 $AD11 RET NZ          ; }
@label=UseActionKey_Up_StartSmoke
*$AD12 LD (IY+$00),$54 ; Start a cloud of smoke in the entity (type #N$54).
 $AD16 LD A,($ADC0)    ; Fetch the X cell where the program was refused...
 $AD19 LD (IY+$02),A   ; ...and use it for the cloud.
 $AD1C LD A,($ADC2)    ; Fetch the Y cell...
 $AD1F LD (IY+$04),A   ; ...and use it for the cloud.
 $AD22 RET             ; Return.
@label=UseActionKey_Install
*$AD23 POP HL          ; Restore the address of the cell...
 $AD24 PUSH HL         ; ...and save it again.
 $AD25 PUSH DE         ; Save the sector number.
 $AD26 CALL $ADB2      ; Add the program to the sector using #R$ADB2.
 $AD29 POP DE          ; Restore the sector number...
 $AD2A POP HL          ; ...and the address of the cell.
 $AD2B LD A,$02        ; Use type #N($02), which is an installed program.
@label=UseActionKey_Store
*$AD2D LD C,A          ; Keep the new type of the cell.
 $AD2E LD A,(HL)       ; Fetch the contents of the cell...
 $AD2F AND $F0         ; ...keep the initial type...
 $AD31 OR C            ; ...and combine it with the new type.
 $AD32 LD (HL),A       ; Store the contents of the cell.
 $AD33 RET             ; Return.

; Queue Program
;
; Used by the routine at #R$AC64.
; .
; Adds a program to the queue of programs that the robot is carrying (or
; adds a blank, if the robot is not picking one up), and then draws the four
; icons of the queue in the panel. The queue holds five entries, and the oldest
; one is pushed out of the end.
;
;   A Program to add (#N$06), or #N$00 for a blank
; O:A The entry that was pushed out of the queue (#N$00 if it was blank)
@label=QueueProgram
c$AD34 PUSH HL       ; {Save the registers.
 $AD35 PUSH DE       ;
 $AD36 PUSH BC       ; }
 $AD37 LD DE,$9645   ; Point #REGde at the end of the queue...
 $AD3A LD HL,$9644   ; ...and #REGhl at the entry before it.
 $AD3D LD BC,$0004   ; There are four entries to move along.
 $AD40 LDDR          ; Move the entries along.
 $AD42 INC HL        ; {Put the new entry at the start of the queue.
 $AD43 LD (HL),A     ; }
 $AD44 LD HL,$5778   ; Point #REGhl at the screen address of the first icon.
 $AD47 LD DE,$9641   ; Point #REGde at #R$9641.
 $AD4A LD C,$02      ; There are two rows of icons...
@label=QueueProgram_Row
*$AD4C LD B,$02      ; ...with two icons in each.
@label=QueueProgram_Icon
*$AD4E CALL $AD87    ; Clear the area of the screen for the icon using #R$AD87.
 $AD51 LD A,(DE)     ; Fetch the entry of the queue.
 $AD52 AND A         ; {Jump if it is blank.
 $AD53 JR Z,$ADAC    ; }
 $AD55 PUSH DE       ; Save the address in the queue...
 $AD56 PUSH HL       ; ...and the screen address.
 $AD57 DEC A         ; Take one off the type...
 $AD58 AND $0F       ; ...and keep it within the range of cell types.
 $AD5A ADD A,A       ; {Multiply it by sixteen, which is the size of an entry in the table
 $AD5B ADD A,A       ; of cell templates.
 $AD5C ADD A,A       ;
 $AD5D ADD A,A       ; }
 $AD5E LD HL,$97C0   ; Point #REGhl at #R$97C0.
 $AD61 CALL $BF92    ; Add the offset of the entry.
 $AD64 LD A,(HL)     ; Fetch the number of the sprite for the cell.
 $AD65 LD HL,$60A3   ; Point #REGhl at #R$60A3.
 $AD68 ADD A,A       ; Double the number of the sprite...
 $AD69 CALL $BF92    ; ...and add it to find the address of the sprite.
 $AD6C LD E,(HL)     ; Fetch the low byte of the address of the sprite...
 $AD6D INC HL        ; ...move on...
 $AD6E LD D,(HL)     ; ...and fetch the high byte.
 $AD6F INC DE        ; Move on to the byte after the height of the sprite.
 $AD70 POP HL        ; Restore the screen address.
 $AD71 PUSH BC       ; Save the counters.
 $AD72 CALL $A0CB    ; Draw the icon using #R$A0CB.
 $AD75 POP BC        ; Restore the counters.
 $AD76 POP DE        ; Restore the address in the queue.
; This entry point is used by the routine at #R$ADAC.
@label=QueueProgram_Next
*$AD77 INC DE        ; Move on to the next entry.
 $AD78 DJNZ $AD4E    ; Loop back until both icons of the row have been drawn.
 $AD7A LD HL,$57F8   ; Point #REGhl at the screen address of the second row.
 $AD7D DEC C         ; {Loop back until both rows have been drawn.
 $AD7E JR NZ,$AD4C   ; }
 $AD80 POP BC        ; {Restore the registers.
 $AD81 POP DE        ;
 $AD82 POP HL        ; }
 $AD83 LD A,($9645)  ; Return the entry that was pushed out of the queue.
 $AD86 RET           ; Return.

; Clear Icon Area
;
; Used by the routine at #R$AD34.
; .
; Clears an area of the screen that is four characters wide and thirty-two
; lines high, working upwards from the address that is given.
;
; HL Screen address of the bottom left
@label=ClearIconArea
c$AD87 PUSH BC       ; {Save the registers.
 $AD88 PUSH DE       ;
 $AD89 PUSH HL       ; }
 $AD8A LD C,$20      ; There are #N$20 lines to clear.
@label=ClearIconArea_Line
*$AD8C LD B,$04      ; There are four bytes in a line.
 $AD8E XOR A         ; Clear a byte...
@label=ClearIconArea_Byte
*$AD8F LD (HL),A     ; ...on the screen.
 $AD90 INC L         ; Move on to the next byte.
 $AD91 DJNZ $AD8F    ; Loop back until the line has been cleared.
 $AD93 DEC L         ; {Go back to the start of the line.
 $AD94 DEC L         ;
 $AD95 DEC L         ;
 $AD96 DEC L         ; }
 $AD97 LD A,H        ; Fetch the high byte of the address...
 $AD98 DEC H         ; ...and move up one line.
 $AD99 AND $07       ; {Jump if that has not moved into the character above.
 $AD9B JR NZ,$ADA5   ; }
 $AD9D LD A,H        ; Otherwise fetch the high byte again, as it has moved up a row of
                     ; characters...
 $AD9E ADD A,$08     ; ...add eight to it...
 $ADA0 LD H,A        ; ...and store it.
 $ADA1 LD A,L        ; Fetch the low byte...
 $ADA2 SUB $20       ; ...take one row of characters off it...
 $ADA4 LD L,A        ; ...and store it.
@label=ClearIconArea_Next
*$ADA5 DEC C         ; {Loop back until all of the lines have been cleared.
 $ADA6 JR NZ,$AD8C   ; }
 $ADA8 POP HL        ; {Restore the registers.
 $ADA9 POP DE        ;
 $ADAA POP BC        ; }
 $ADAB RET           ; Return.

; Skip Blank Icon
;
; Used by the routine at #R$AD34.
; .
; Moves on to the screen address of the next icon when an entry of the
; queue is blank. This is part of #R$AD34, which it rejoins.
;
;   HL Screen address of the icon
; O:HL Screen address of the next icon
@label=SkipBlankIcon
c$ADAC LD A,L        ; Fetch the low byte of the screen address...
 $ADAD ADD A,$04     ; ...add four to it, to move four characters to the
                     ; right...
 $ADAF LD L,A        ; ...and store it.
 $ADB0 JR $AD77      ; Jump to move on to the next entry of the queue.

; Install Program
;
; Used by the routine at #R$AC64.
; .
; Adds a program to the sector that the robot is in, which gives the
; sector one more unit of energy, and awards #N$0100 points to the score.
;
; IX Robot
@label=InstallProgram
c$ADB2 CALL $A320    ; Find the energy of the sector using #R$A320.
 $ADB5 INC (HL)      ; Add one to it.
 $ADB6 PUSH BC       ; Save #REGbc.
 $ADB7 LD BC,$0100   ; Use #N$0100 as the number of points...
 $ADBA CALL $B573    ; ...and add them to the score using #R$B573.
 $ADBD POP BC        ; Restore #REGbc.
 $ADBE RET           ; Return.

; Action Cell Position
;
; The position of the cell that the action key was used on. The first word
; is the X position and the second is the Y position, each as a fraction byte
; followed by a cell number.
@label=ActionCellPosition
g$ADBF DEFW $0000
 $ADC1 DEFW $0000

; Set Attacked Sector
;
; Used by the routine at #R$9DA7.
; .
; Changes the sector that is shown as being under attack, and then draws
; the map of the sectors. The code of a sector has the row in bits 6 and 7 and
; the column in bits 1 and 2; a row or column of #N$03 means that there is no
; sector. The flag that says the old sector is under attack is cleared.
;
; C Code of the sector that is now under attack
@label=SetAttackedSector
c$ADC3 LD HL,$9647   ; Point #REGhl at the code of the sector that is under
                     ; attack.
 $ADC6 LD A,(HL)     ; Fetch the old code...
 $ADC7 LD (HL),C     ; ...and store the new one.
 $ADC8 CP C          ; {Jump to draw the map if the code has not changed.
 $ADC9 JR Z,$ADEA    ; }
 $ADCB LD C,A        ; Keep the old code.
 $ADCC AND $06       ; Keep the column of the old sector...
 $ADCE CP $06        ; {Jump to draw the map if the old code was not a sector.
 $ADD0 JR Z,$ADEA    ; }
 $ADD2 RRCA          ; Halve the column...
 $ADD3 LD D,A        ; ...and keep it in #REGd.
 $ADD4 LD A,C        ; Fetch the old code again...
 $ADD5 RLCA          ; {...and move the row into the low bits.
 $ADD6 RLCA          ; }
 $ADD7 AND $03       ; Keep the row.
 $ADD9 CP $03        ; {Jump to draw the map if the old code was not a sector.
 $ADDB JR Z,$ADEA    ; }
 $ADDD LD E,A        ; Keep the row.
 $ADDE RLCA          ; Double the row...
 $ADDF ADD A,E       ; ...add the row again, to multiply it by three...
 $ADE0 ADD A,D       ; ...add the column...
 $ADE1 LD E,A        ; ...and keep the number of the old sector in #REGe.
 $ADE2 LD D,$00      ; Clear the high byte of the sector number.
 $ADE4 LD HL,$967E   ; Point #REGhl at #R$967E.
 $ADE7 ADD HL,DE     ; Add the number of the sector.
 $ADE8 RES 2,(HL)    ; Clear the flag that says that the sector is under
                     ; attack.

; Draw Sector Map
;
; Used by the routines at #R$9A4B, #R$A32B, #R$A36C and #R$ADC3.
; .
; Colours the map of the sectors that is shown in the panel. Each of the
; nine sectors is a block of two by two attributes, and its colour depends on
; the state of the sector.
@label=DrawSectorMap
c$ADEA LD HL,$967E   ; Point #REGhl at the table of sector states.
 $ADED LD B,$09      ; There are nine sectors.
@label=DrawSectorMap_Next
*$ADEF LD E,(HL)     ; Fetch the state of the sector...
 $ADF0 LD D,$00      ; ...and clear #REGd.
 $ADF2 PUSH HL       ; Save the address of the state.
 $ADF3 LD HL,$AE25   ; Point #REGhl at #R$AE25.
 $ADF6 ADD HL,DE     ; Add the state.
 $ADF7 LD A,(HL)     ; Fetch the attribute.
 $ADF8 PUSH BC       ; Save the counter.
 $ADF9 LD C,B        ; Fetch the counter into #REGc...
 $ADFA DEC C         ; ...and take one off.
 $ADFB LD B,$00      ; Clear the high byte of the counter.
 $ADFD LD HL,$AE1C   ; Point #REGhl at #R$AE1C.
 $AE00 ADD HL,BC     ; Add the number of the sector.
 $AE01 LD C,(HL)     ; Fetch the offset into #REGc.
 $AE02 LD B,$01      ; Use #N$0100 as the high byte of the offset.
 $AE04 CALL $AE0D    ; Colour the sector using #R$AE0D.
 $AE07 POP BC        ; Restore the counter...
 $AE08 POP HL        ; ...and the address of the state.
 $AE09 INC HL        ; Move on to the next state.
 $AE0A DJNZ $ADEF    ; Loop back until all nine sectors have been drawn.
 $AE0C RET           ; Return.

; Colour Sector Square
;
; Used by the routine at #R$ADEA.
; .
; Sets the attributes of a block of two by two characters.
;
; A Attribute
; BC Offset from #N$5800
@label=ColourSectorSquare
c$AE0D LD HL,$5800   ; Point #REGhl at the attribute file...
 $AE10 ADD HL,BC     ; ...and add the offset.
 $AE11 LD (HL),A     ; Colour the top left character...
 $AE12 INC L         ; ...move to the right...
 $AE13 LD (HL),A     ; ...and colour the top right character.
 $AE14 LD DE,$001F   ; Use an offset of #N$001F...
 $AE17 ADD HL,DE     ; ...to move to the character on the left of the next row.
 $AE18 LD (HL),A     ; Colour the bottom left character...
 $AE19 INC L         ; ...move to the right...
 $AE1A LD (HL),A     ; ...and colour the bottom right character.
 $AE1B RET           ; Return.

; Sector Map Offsets
;
; The offsets from #N$5900 of the attributes of the top left character of
; each of the nine sectors on the map, in the order of the sector numbers.
@label=SectorMapOffsets
b$AE1C DEFB $BC,$BA,$B8
 $AE1F DEFB $7C,$7A,$78
 $AE22 DEFB $3C,$3A,$38

; Sector State Attributes
;
; The attributes that are used to show a sector, indexed by its state. The
; states with bit 2 set are flashing, which shows that the sector is under
; attack.
@label=SectorStateAttributes
b$AE25 DEFB $47      ; #COLOUR(#PEEK(#PC)).
 $AE26 DEFB $56      ; #COLOUR(#PEEK(#PC)).
 $AE27 DEFB $78      ; #COLOUR(#PEEK(#PC)).
 $AE28 DEFB $47      ; #COLOUR(#PEEK(#PC)).
 $AE29 DEFB $D6      ; #COLOUR(#PEEK(#PC)).
 $AE2A DEFB $D6      ; #COLOUR(#PEEK(#PC)).
 $AE2B DEFB $D6      ; #COLOUR(#PEEK(#PC)).
 $AE2C DEFB $D6      ; #COLOUR(#PEEK(#PC)).

; Update Packet Marker
;
; Used by the routine at #R$993C.
; .
; Shows the position of the program packet on the map of the sectors. The
; marker is drawn with XOR, so the old marker is removed by drawing it again.
; Nothing is done if the packet has not moved.
@label=UpdatePacketMarker
c$AE2D LD A,($964C)  ; Fetch the X cell where the marker was drawn last...
 $AE30 LD D,A        ; ...and keep it in #REGd.
 $AE31 LD A,($964D)  ; Fetch the Y cell...
 $AE34 LD H,A        ; ...and keep it in #REGh.
 $AE35 LD A,($964E)  ; Fetch the flag that says whether there was a marker.
 $AE38 AND A         ; {Jump if there was not.
 $AE39 JR Z,$AE4F    ; }
 $AE3B LD A,($9770)  ; Fetch the type of the packet.
 $AE3E AND A         ; {Jump to remove the old marker if there is no packet
 $AE3F JR Z,$AE4C    ; now.}
 $AE41 LD A,($9772)  ; Fetch the X cell of the packet.
 $AE44 CP D          ; {Jump to remove the old marker if the packet has moved in the X
 $AE45 JR NZ,$AE4C   ; direction.}
 $AE47 LD A,($9774)  ; Fetch the Y cell of the packet.
 $AE4A CP H          ; {Return if the packet has not moved.
 $AE4B RET Z         ; }
@label=UpdatePacketMarker_Remove
*$AE4C CALL $AE93    ; Remove the old marker using #R$AE93.
@label=UpdatePacketMarker_Draw
*$AE4F LD A,($9772)  ; Fetch the X cell of the packet...
 $AE52 LD ($964C),A  ; ...and store it...
 $AE55 LD D,A        ; ...and keep it in #REGd.
 $AE56 LD A,($9774)  ; Fetch the Y cell of the packet...
 $AE59 LD ($964D),A  ; ...and store it...
 $AE5C LD H,A        ; ...and keep it in #REGh.
 $AE5D LD A,($9770)  ; Fetch the type of the packet.
 $AE60 AND A         ; {Store the flag that says whether there is a marker...
 $AE61 LD ($964E),A  ; }
 $AE64 RET Z         ; ...and return if there is not.
 $AE65 JR $AE93      ; Jump to #R$AE93.

; Update Robot Marker
;
; Used by the routines at #R$A99F and #R$AB03.
; .
; Shows the position of the robot on the map of the sectors. The marker is
; drawn with XOR, so the old marker is removed by drawing it again. Nothing is
; done if the robot has not moved to a different cell.
; .
; Draws a marker of three pixels by three on the map of the sectors, using
; XOR. Each cell of the map is one pixel on the screen.
;
; D X cell
; H Y cell
@label=UpdateRobotMarker
c$AE67 LD DE,($9691) ; Fetch the X position of the robot...
 $AE6B LD HL,($9693) ; ...and the Y position.
 $AE6E LD A,($9649)  ; Fetch the X cell where the marker was drawn last.
 $AE71 CP D          ; {Jump if the robot is in a different X cell.
 $AE72 JR NZ,$AE79   ; }
 $AE74 LD A,($964B)  ; Fetch the Y cell where the marker was drawn last.
 $AE77 CP H          ; {Return if the robot has not moved to a different cell.
 $AE78 RET Z         ; }
@label=UpdateRobotMarker_NewCell
*$AE79 PUSH DE       ; Save the X position...
 $AE7A PUSH HL       ; ...and the Y position.
 $AE7B CALL $AE93    ; Draw the marker at the new position using #R$AE93.
 $AE7E POP HL        ; Restore the Y position.
 $AE7F LD DE,($964A) ; Fetch the old Y position...
 $AE83 LD ($964A),HL ; ...and store the new one.
 $AE86 EX DE,HL      ; Put the old one in #REGhl.
 $AE87 POP BC        ; Restore the new X position...
 $AE88 LD DE,($9648) ; ...fetch the old one...
 $AE8C LD ($9648),BC ; ...and store the new one.
 $AE90 LD A,D        ; Combine the cells of the old position...
 $AE91 OR H          ; {...and return if there was no marker.
 $AE92 RET Z         ; }
; This entry point is used by the routine at #R$AE2D.
; .
; This entry point draws, or removes, a marker.
@label=ToggleMarker
*$AE93 LD A,D        ; Fetch the X cell...
 $AE94 OR $C0        ; {...and find the X coordinate of the marker, which is #N$BE plus the
 $AE96 SUB $02       ; cell.}
 $AE98 LD L,A        ; Keep the X coordinate of the marker.
 $AE99 AND $07       ; Use the lowest three bits...
 $AE9B ADD A,A       ; ...to find the pre-shifted data...
 $AE9C OR $E0        ; ...in the table of shifted bytes.
 $AE9E LD B,A        ; Keep the shifted graphic.
 $AE9F LD A,H        ; Fetch the Y cell...
 $AEA0 XOR $3F       ; Turn the Y cell upside down...
 $AEA2 ADD A,$39     ; ...and find the Y coordinate of the marker.
 $AEA4 LD H,A        ; Keep the Y coordinate of the marker.
 $AEA5 CALL $BD4B    ; Find the screen address using #R$BD4B.
 $AEA8 LD A,$03      ; There are three rows to draw.
 $AEAA LD DE,$AED0   ; Point #REGde at #R$AED0.
@label=ToggleMarker_Row
*$AEAD EX AF,AF'     ; Save the counter.
 $AEAE LD A,(DE)     ; Fetch the pattern for the row...
 $AEAF LD C,A        ; ...to use as the offset into the shifted data.
 $AEB0 LD A,(BC)     ; Fetch the shifted byte...
 $AEB1 XOR (HL)      ; ...combine it with the screen...
 $AEB2 LD (HL),A     ; ...and write it back.
 $AEB3 INC L         ; Move on to the next byte of the screen.
 $AEB4 INC B         ; Move on to the second table of shifted bytes.
 $AEB5 LD A,(BC)     ; Fetch the byte that has spilled over...
 $AEB6 XOR (HL)      ; ...combine it with the screen...
 $AEB7 LD (HL),A     ; ...and write it back.
 $AEB8 DEC B         ; Go back to the first table...
 $AEB9 DEC L         ; ...and the first byte of the screen.
 $AEBA LD A,H        ; Fetch the high byte of the screen address...
 $AEBB DEC H         ; ...and move up one line.
 $AEBC AND $07       ; {Jump if that has not moved into the character above.
 $AEBE JR NZ,$AECA   ; }
 $AEC0 LD A,L        ; Fetch the low byte of the screen address...
 $AEC1 SUB $20       ; ...take one row of characters off it...
 $AEC3 LD L,A        ; ...and store it.
 $AEC4 JR C,$AECA    ; Jump if there is no row of characters above, in this third of the
                     ; screen...
 $AEC6 LD A,H        ; Otherwise fetch the high byte...
 $AEC7 ADD A,$08     ; ...add eight to it...
 $AEC9 LD H,A        ; ...and store it.
@label=ToggleMarker_Next
*$AECA EX AF,AF'     ; Restore the counter.
 $AECB INC DE        ; Move on to the next pattern.
 $AECC DEC A         ; Count down the rows.
 $AECD JR NZ,$AEAD   ; Loop back until all three rows have been drawn.
 $AECF RET           ; Return.

; Marker Pattern
;
; The three rows of the marker, which is a plus shape. They are used as
; offsets into the pre-shifted data.
@label=MarkerPattern
b$AED0 DEFB $40,$E0,$40

; Get Position
;
; Used by the routines at #R$A144, #R$A218, #R$A2B5, #R$A36C, #R$A4EC, #R$A6E0,
; #R$A826, #R$A833, #R$AB57 and #R$AC64.
; .
; Fetches the position of an entity.
;
;   IX Entity
; O:DE X position (the fraction in #REGe and the cell in #REGd)
; O:HL Y position (the fraction in #REGl and the cell in #REGh)
@label=GetPosition
c$AED3 LD E,(IX+$01) ; Fetch the X fraction...
 $AED6 LD D,(IX+$02) ; ...and the X cell.
 $AED9 LD L,(IX+$03) ; Fetch the Y fraction...
 $AEDC LD H,(IX+$04) ; ...and the Y cell.
 $AEDF RET           ; Return.

; Set Position
;
; Used by the routines at #R$A144, #R$A218, #R$A2B5, #R$A36C, #R$A4EC, #R$A739,
; #R$A833 and #R$AB57.
; .
; Stores the position of an entity.
;
; DE X position
; HL Y position
; IX Entity
@label=SetPosition
c$AEE0 LD (IX+$01),E ; Store the X fraction...
 $AEE3 LD (IX+$02),D ; ...and the X cell.
 $AEE6 LD (IX+$03),L ; Store the Y fraction...
 $AEE9 LD (IX+$04),H ; ...and the Y cell.
 $AEEC RET           ; Return.

; Start Light
;
; Used by the routine at #R$AF25.
; .
; Starts a new light, in a slot that is not in use. The light is given a
; random colour and direction, and a random delay. It starts at the top left of
; the frame of the screen, which is made of attributes of the value #N$48. The
; lights then move along the frame, one cell a frame.
;
; HL Address of the slot of the light
@label=StartLight
c$AEED PUSH HL         ; Copy the address of the slot into #REGix...
 $AEEE POP IX          ; Pop it into #REGix.
 $AEF0 LD A,($9617)    ; Fetch the random number...
 $AEF3 LD E,A          ; ...and keep it in #REGe.
 $AEF4 AND $03         ; {Keep the low two bits...
 $AEF6 LD L,A          ; }
 $AEF7 LD H,$00        ; ...and clear #REGh.
 $AEF9 LD BC,$AF19     ; Point #REGbc at #R$AF19.
 $AEFC ADD HL,BC       ; Add the offset.
 $AEFD LD D,(HL)       ; Fetch the colour...
 $AEFE LD A,E          ; ...and fetch the random number again.
 $AEFF AND $18         ; {Keep the bits that choose the direction, and add the
 $AF01 OR D            ; colour.}
 $AF02 LD (IX+$00),A   ; Store the type of the light.
 $AF05 LD A,($9617)    ; Fetch the random number again...
 $AF08 AND $3F         ; {...keep a number between #N$00 and #N($3F), and add
 $AF0A OR $20          ; #N$20 to it...}
 $AF0C LD (IX+$01),A   ; ...to find the time before the light can finish.
 $AF0F LD (IX+$02),$21 ; Store the low byte of the address of the attribute,
                       ; #N$21...
 $AF13 LD (IX+$03),$58 ; ...and the high byte, #N$58.
 $AF17 JR $AF37        ; Jump to move the lights.

; Light Colours
;
; The colours of the lights: red, magenta, yellow and yellow.
@label=LightColours
b$AF19 DEFB $02      ; #COLOUR(#PEEK(#PC)).
 $AF1A DEFB $03      ; #COLOUR(#PEEK(#PC)).
 $AF1B DEFB $06      ; #COLOUR(#PEEK(#PC)).
 $AF1C DEFB $06      ; #COLOUR(#PEEK(#PC)).

; Check Lights
;
; Used by the routine at #R$AF25.
; .
; Checks whether any of the lights are in use.
;
;   B Number of lights
;   HL Address of the first light
;   DE Size of a light
; O:F The zero flag is set if no lights are in use
@label=CheckLights
c$AF1D XOR A         ; Start the count of lights at zero.
@label=CheckLights_Next
*$AF1E OR (HL)       ; Combine the type of the light with the others...
 $AF1F ADD HL,DE     ; ...and move on to the next light.
 $AF20 DJNZ $AF1E    ; Loop back until all the lights have been checked.
 $AF22 RET Z         ; Return if no lights are in use.
 $AF23 JR $AF37      ; Jump to move the lights.

; Move Lights
;
; Used by the routines at #R$9F4D and #R$BB86.
; .
; Moves the lights that travel around the frame of the screen, and starts
; a new one when it is asked to. This is done every frame. There are eight
; lights, each of which is a type, a delay, and the address of the attribute
; that it is in. The lights follow the cells of the frame, which have an
; attribute of #N($48), and a light finishes when it gets back to the top
; left of the frame.
;
;   A #N$01 to start a new light, or #N$00 to leave the lights as they are
; O:F The zero flag is set if no lights are in use
@label=MoveLights
c$AF25 LD B,$08      ; There are eight lights.
 $AF27 LD HL,$AF8E   ; Point #REGhl at #R$AF8E.
 $AF2A LD DE,$0004   ; Each light is four bytes long.
 $AF2D AND A         ; {Jump to check whether any lights are in use if a new light is not
 $AF2E JR Z,$AF1D    ; wanted.}
@label=MoveLights_FindFree
*$AF30 LD A,(HL)     ; Fetch the type of the light.
 $AF31 AND A         ; {Jump to start a new light if the slot is not in use.
 $AF32 JR Z,$AEED    ; }
 $AF34 ADD HL,DE     ; Move on to the next light.
 $AF35 DJNZ $AF30    ; Loop back until all of the lights have been tried.
; This entry point is used by the routines at #R$AEED and #R$AF1D.
@label=MoveLights_Update
*$AF37 LD IX,$AF8E   ; Point #REGix at the first light.
; This entry point is used by the routine at #R$AF7A.
@label=MoveLights_Light
*$AF3B LD A,($9617)  ; Fetch the random number...
 $AF3E LD C,A        ; ...and keep it in #REGc.
 $AF3F LD A,R        ; {Add a number from the memory refresh register...
 $AF41 ADD A,C       ; }
 $AF42 LD ($9617),A  ; ...and store the new random number.
 $AF45 LD A,(IX+$00) ; Fetch the type of the light.
 $AF48 AND A         ; {Jump to the next light if it is not in use.
 $AF49 JR Z,$AF7A    ; }
 $AF4B LD A,(IX+$01) ; Fetch the delay of the light.
 $AF4E AND A         ; {Jump if it has run out.
 $AF4F JR Z,$AF55    ; }
 $AF51 DEC A         ; Take one off the delay...
 $AF52 LD (IX+$01),A ; ...and store it.
@label=MoveLights_NextLight
*$AF55 LD E,(IX+$02) ; Fetch the address of the attribute of the light...
 $AF58 LD D,(IX+$03) ; ...into #REGde.
 $AF5B XOR A         ; {Clear the flag that says that the light has turned.
 $AF5C LD ($9629),A  ; }
 $AF5F LD HL,$AF7A   ; Point #REGhl at #R$AF7A...
 $AF62 PUSH HL       ; ...and make the routine return there when it has
                     ; finished.
 $AF63 LD A,(IX+$00) ; Fetch the type of the light...
 $AF66 RRCA          ; {...and turn it into the direction that it is heading
 $AF67 RRCA          ; in.
 $AF68 RRCA          ; }
 $AF69 AND $03       ; Keep the direction...
 $AF6B LD L,A        ; ...and use it as the index into the table.
 $AF6C LD BC,$AF72   ; Point #REGbc at #R$AF72.
 $AF6F JP $997A      ; ...and jump to the routine for the direction, using
                     ; #R$997A.

; Light Handlers
;
; The routines that move a light, for each of the four directions.
@label=LightHandlers
w$AF72 DEFW $AFAE
 $AF74 DEFW $AFDC
 $AF76 DEFW $AFE1
 $AF78 DEFW $AFEE

; Next Light
;
; Used by the routine at #R$AF25.
; .
; Moves on to the next light, and when all of them have been moved makes
; the routine return.
;
;   IX Light
; O:A #N$01
; O:F The zero flag is reset
@label=NextLight
c$AF7A LD DE,$0004   ; Each light is four bytes long.
 $AF7D ADD IX,DE     ; Move on to the next light.
 $AF7F PUSH IX       ; Copy the address into #REGhl...
 $AF81 POP HL        ; Pop it into #REGhl.
 $AF82 LD DE,$AFAE   ; Point #REGde at the end of the lights.
 $AF85 AND A         ; {Compare the address with it.
 $AF86 SBC HL,DE     ; }
 $AF88 JR C,$AF3B    ; Loop back if there are more lights.
 $AF8A LD A,$01      ; {Set #REGa to #N$01 and clear the zero flag.
 $AF8C AND A         ; }
 $AF8D RET           ; Return.

; Lights
;
; The eight lights. Each light is four bytes long: the type (zero if the
; slot is not in use; bits 0-2 are the colour and bits 3-4 are the direction), a
; delay before the light can finish, and the address of the attribute that the
; light is in.
@label=Lights
g$AF8E DEFB $00,$00,$00,$00
 $AF92 DEFB $00,$00,$00,$00
 $AF96 DEFB $00,$00,$00,$00
 $AF9A DEFB $00,$00,$00,$00
 $AF9E DEFB $00,$00,$00,$00
 $AFA2 DEFB $00,$00,$00,$00
 $AFA6 DEFB $00,$00,$00,$00
 $AFAA DEFB $00,$00,$00,$00

; Move Light Left
;
; Moves a light one cell to the left, along the frame of the screen, if
; the cell on the left is part of the frame. If it is not then the light turns.
; A light that gets back to the top left of the frame after its delay has run
; out is finished.
;
; DE Address of the attribute that the light is in
; IX Light
@label=MoveLightLeft
c$AFAE LD L,E          ; {Point #REGhl at the cell on the left.
 $AFAF LD H,D          ;
 $AFB0 DEC L           ; }
; This entry point is used by the routine at #R$AFDC.
@label=MoveLightLeft_Move
*$AFB1 LD A,(HL)       ; Fetch the attribute of the cell.
 $AFB2 CP $48          ; {Jump to turn the light if it is not part of the
 $AFB4 JR NZ,$AFF6     ; frame.}
; This entry point is used by the routines at #R$AFE1 and #R$B03F.
@label=MoveLight_Move
*$AFB6 LD A,$48        ; {Restore the attribute of the frame in the cell that the light is
 $AFB8 LD (DE),A       ; leaving.}
 $AFB9 EX DE,HL        ; Put the address of the new cell in #REGde.
 $AFBA LD A,(IX+$01)   ; Fetch the delay of the light.
 $AFBD AND A           ; {Jump to show the light if the delay has not run out.
 $AFBE JR NZ,$AFCD     ; }
 $AFC0 LD HL,$5821     ; Point #REGhl at the top left of the frame.
 $AFC3 AND A           ; {Jump to show the light if it has not got there.
 $AFC4 SBC HL,DE       ;
 $AFC6 JR NZ,$AFCD     ; }
 $AFC8 LD (IX+$00),$00 ; Otherwise the light has finished, so free its slot...
 $AFCC RET             ; ...and return.
@label=MoveLight_Show
*$AFCD LD A,(IX+$00)   ; Fetch the type of the light.
 $AFD0 AND $07         ; Keep the colour...
 $AFD2 OR $48          ; ...and add the attribute of the frame.
 $AFD4 LD (DE),A       ; Show the light in the new cell.
 $AFD5 LD (IX+$02),E   ; Store the address of the cell...
 $AFD8 LD (IX+$03),D   ; ...in the light.
 $AFDB RET             ; Return.

; Move Light Right
;
; Moves a light one cell to the right. See #R$AFAE.
;
; DE Address of the attribute that the light is in
; IX Light
@label=MoveLightRight
c$AFDC LD L,E        ; {Point #REGhl at the cell on the right.
 $AFDD LD H,D        ;
 $AFDE INC L         ; }
 $AFDF JR $AFB1      ; Jump to move the light.

; Move Light Up
;
; Is meant to move a light one cell up. However, the instruction that
; should take one row off the address is missing, so the cell that is tested is
; the cell that the light is already in. That cell never has the attribute of
; the frame, and so the light always turns instead.
;
; DE Address of the attribute that the light is in
; IX Light
@label=MoveLightUp
c$AFE1 LD L,E        ; {Point #REGhl at the cell that the light is in.
 $AFE2 LD H,D        ; }
 $AFE3 LD BC,$0020   ; Use a row of #N$20 characters.
 $AFE6 AND A         ; Clear the carry flag.
; This entry point is used by the routine at #R$AFEE.
@label=MoveLight_Test
*$AFE7 LD A,(HL)     ; Fetch the attribute of the cell.
 $AFE8 CP $48        ; {Jump to turn the light sideways if it is not part of
 $AFEA JR NZ,$B01C   ; the frame.}
 $AFEC JR $AFB6      ; Jump to move the light.

; Move Light Down
;
; Moves a light one cell down. See #R$AFAE.
;
; DE Address of the attribute that the light is in
; IX Light
@label=MoveLightDown
c$AFEE LD L,E        ; {Point #REGhl at the cell that the light is in.
 $AFEF LD H,D        ; }
 $AFF0 LD BC,$0020   ; Use a row of #N$20 characters...
 $AFF3 ADD HL,BC     ; ...and move down to the cell below.
 $AFF4 JR $AFE7      ; Jump to test the cell.

; Turn Light Vertically
;
; Used by the routines at #R$AFAE and #R$B01C.
; .
; Tries to turn a light so that it goes up or down. If neither of the
; cells is part of the frame then the light is turned round, and the routine
; tries again, but only once.
;
; DE Address of the attribute that the light is in
; IX Light
@label=TurnLightVertically
c$AFF6 LD L,E        ; {Point #REGhl at the cell that the light is in.
 $AFF7 LD H,D        ; }
 $AFF8 LD BC,$0020   ; Use a row of #N$20 characters.
 $AFFB AND A         ; {Take it off to find the cell above.
 $AFFC SBC HL,BC     ; }
 $AFFE LD A,(HL)     ; Fetch the attribute of the cell.
 $AFFF CP $48        ; {Jump to turn up if it is part of the frame.
 $B001 JR Z,$B03F    ; }
 $B003 ADD HL,BC     ; {Move down to the cell below.
 $B004 ADD HL,BC     ; }
 $B005 LD A,(HL)     ; Fetch the attribute of the cell.
 $B006 CP $48        ; {Jump to turn down if it is part of the frame.
 $B008 JR Z,$B04D    ; }
 $B00A LD A,($9629)  ; Fetch the flag that says that the light has turned.
 $B00D AND A         ; {Return if it has.
 $B00E RET NZ        ; }
 $B00F OR $01        ; Set the flag...
 $B011 LD ($9629),A  ; ...and store it.
 $B014 LD A,(IX+$00) ; Fetch the type of the light.
 $B017 XOR $08       ; {Turn the light round, and store it.
 $B019 LD (IX+$00),A ; }

; Turn Light Horizontally
;
; Used by the routine at #R$AFE1.
; .
; Tries to turn a light so that it goes left or right. If neither of the
; cells is part of the frame then the light is turned round, and the routine
; tries to turn it vertically instead, but only once.
;
; DE Address of the attribute that the light is in
; IX Light
@label=TurnLightHorizontally
c$B01C LD L,E        ; {Point #REGhl at the cell on the left.
 $B01D LD H,D        ;
 $B01E DEC L         ; }
 $B01F LD A,(HL)     ; Fetch the attribute of the cell.
 $B020 CP $48        ; {Jump to turn left if it is part of the frame.
 $B022 JR Z,$B051    ; }
 $B024 INC L         ; {Move to the cell on the right.
 $B025 INC L         ; }
 $B026 LD A,(HL)     ; Fetch the attribute of the cell.
 $B027 CP $48        ; {Jump to turn right if it is part of the frame.
 $B029 JR Z,$B055    ; }
 $B02B LD A,($9629)  ; Fetch the flag that says that the light has turned.
 $B02E AND A         ; {Return if it has.
 $B02F RET NZ        ; }
 $B030 OR $01        ; Set the flag...
 $B032 LD ($9629),A  ; ...and store it.
 $B035 LD A,(IX+$00) ; Fetch the type of the light.
 $B038 XOR $08       ; {Turn the light round, and store it.
 $B03A LD (IX+$00),A ; }
 $B03D JR $AFF6      ; Jump to try to turn the light vertically.

; Set Light Direction
;
; Used by the routine at #R$AFF6.
; .
; Gives a light a new direction and moves it. The entry points are for
; turning up, down, left and right.
;
; HL Address of the attribute that the light is going to
; IX Light
@label=SetLightUp
c$B03F LD C,$10      ; Use the code for up.
@label=SetLight_Direction
*$B041 LD A,(IX+$00) ; Fetch the type of the light.
 $B044 AND $07       ; Keep the colour...
 $B046 OR C          ; ...and add the new direction.
 $B047 LD (IX+$00),A ; Store the type of the light.
 $B04A JP $AFB6      ; Jump to move the light.
; This entry point is used by the routine at #R$AFF6.
@label=SetLightDown
*$B04D LD C,$18      ; Use the code for down.
 $B04F JR $B041      ; Jump to set the direction.
; This entry point is used by the routine at #R$B01C.
@label=SetLightLeft
*$B051 LD C,$00      ; Use the code for left.
 $B053 JR $B041      ; Jump to set the direction.
; This entry point is used by the routine at #R$B01C.
@label=SetLightRight
*$B055 LD C,$08      ; Use the code for right.
 $B057 JR $B041      ; Jump to set the direction.

; Do Nothing Cell
;
; The handler for entity type #N($01), which does nothing.
@label=DoNothingCell
c$B059 RET           ; Return.

; Toggle Sprite
;
; Used by the routines at #R$A4EC and #R$A6E0.
; .
; Flips the lowest bit of an entity's type, which switches it between two
; sprites. This is the handler for entity types #N$02 to #N$07. Types #N$06 and
; #N$07 are the battery and share one picture. Nothing sets types #N$02 to
; #N$05.
;
; IX Entity
@label=ToggleSprite
c$B05A LD A,(IX+$00) ; Fetch the type of the entity...
 $B05D XOR $01       ; ...flip the lowest bit...
 $B05F LD (IX+$00),A ; ...and store it.
 $B062 RET           ; Return.

; Next Sprite Number
;
; Used by the routines at #R$A144, #R$A218, #R$A2B5, #R$A826, #R$A833 and
; #R$AB03.
; .
; Adds one to the lowest two bits of an entity's type, so a four-frame
; sprite moves on to the next frame. This is the handler for entity types #N$70
; to #N($73), the activated terminal.
;
; IX Entity
@label=NextSpriteNumber
c$B063 PUSH BC       ; Save #REGbc.
 $B064 LD A,(IX+$00) ; Fetch the type of the entity...
 $B067 LD C,A        ; ...and keep it in #REGc.
 $B068 INC A         ; Add one...
 $B069 AND $03       ; {...keep the lowest two bits, and put them in #REGb.
 $B06B LD B,A        ; }
 $B06C LD A,C        ; Fetch the type again...
 $B06D AND $FC       ; {...replace the lowest two bits with the new ones.
 $B06F OR B          ; }
 $B070 LD (IX+$00),A ; Store the type of the entity.
 $B073 POP BC        ; Restore #REGbc.
 $B074 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$CCAE }
; { #NIGHTSHADE$CEF8 }
; LIST#

; Read Controls
;
; Used by the routines at #R$993C and #R$BA19.
; .
; Reads the controls, using the method that has been chosen in the menu:
; keyboard, Kempston joystick, cursor keys or Sinclair interface 2. The controls
; are kept as bits that stay set until the robot has used them.
; #TABLE(default,centre,centre)
; { =h Bit | =h Meaning }
; { #N$00 | Turn right }
; { #N$01 | Turn left }
; { #N$02 | Move forward }
; { #N$03 | Fire the second weapon }
; { #N$04 | Fire the first weapon }
; { #N$06 | Use the action key }
; TABLE#
;
; O:A The controls
; O:C The controls
@label=ReadControls
c$B075 PUSH BC       ; Save #REGbc.
 $B076 LD A,($961A)  ; Fetch the method of control...
 $B079 RRCA          ; ...and keep the bits that choose it.
 $B07A AND $03       ; {Jump to read the keyboard if the method is zero.
 $B07C JP Z,$B11C    ; }
 $B07F DEC A         ; {Jump to read the Kempston joystick if it is one.
 $B080 JR Z,$B0B4    ; }
 $B082 DEC A         ; {Jump to read the cursor keys if it is two.
 $B083 JR Z,$B0D9    ; }

; Read Interface 2
;
; Reads the Sinclair interface 2 joysticks. The keys #N$06 to #N$00 are
; one joystick and the keys #N$01 to #N$05 are the other; both are used at once.
@label=ReadInterface2
c$B085 LD A,$EF      ; {Read from the keyboard;
 $B087 CALL $C0AB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$EF | 0 | 9 | 8 | 7 | 6 }
                     ; TABLE#}
 $B08A LD C,A        ; Keep the keys in #REGc.
 $B08B LD A,$F7      ; {Read from the keyboard;
 $B08D CALL $C0AB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$F7 | 1 | 2 | 3 | 4 | 5 }
                     ; TABLE#}
 $B090 OR C          ; Combine the keys of both.
 $B091 LD C,$00      ; Clear the controls.
 $B093 BIT 0,A       ; {Jump if the first key is not pressed (#N$00 or #N$01).
 $B095 JR Z,$B099    ; }
 $B097 SET 3,C       ; Set the bit for firing the second weapon.
@label=ReadInterface2_Key2
*$B099 BIT 1,A       ; {Jump if the second key is not pressed (#N$09 or #N$02).
 $B09B JR Z,$B09F    ; }
 $B09D SET 2,C       ; Set the bit for moving forward.
@label=ReadInterface2_Key3
*$B09F BIT 2,A       ; {Jump if the third key is not pressed (#N$08 or #N$03).
 $B0A1 JR Z,$B0A5    ; }
 $B0A3 SET 6,C       ; Set the bit for the action key.
@label=ReadInterface2_Key4
*$B0A5 BIT 3,A       ; {Jump if the fourth key is not pressed (#N$07 or #N$04).
 $B0A7 JR Z,$B0AB    ; }
 $B0A9 SET 0,C       ; Set the bit for turning right.
@label=ReadInterface2_Key5
*$B0AB BIT 4,A       ; {Jump if the fifth key is not pressed (#N$06 or #N$05).
 $B0AD JR Z,$B0B1    ; }
 $B0AF SET 1,C       ; Set the bit for turning left.
@label=ReadInterface2_Finish
*$B0B1 JP $B103      ; Jump to finish.

; Controls: Kempston Joystick
;
; Used by the routine at #R$B075.
; .
; Reads the Kempston joystick.
@label=ReadKempstonJoystick
c$B0B4 IN A,($1F)    ; Read the joystick.
 $B0B6 LD C,$00      ; Clear the controls.
 $B0B8 BIT 0,A       ; {Jump if the joystick is not pushed right.
 $B0BA JR Z,$B0BE    ; }
 $B0BC SET 0,C       ; Set the bit for turning right.
@label=ReadKempstonJoystick_Left
*$B0BE BIT 1,A       ; {Jump if the joystick is not pushed left.
 $B0C0 JR Z,$B0C4    ; }
 $B0C2 SET 1,C       ; Set the bit for turning left.
@label=ReadKempstonJoystick_Down
*$B0C4 BIT 2,A       ; {Jump if the joystick is not pushed down.
 $B0C6 JR Z,$B0CA    ; }
 $B0C8 SET 6,C       ; Set the bit for the action key.
@label=ReadKempstonJoystick_Up
*$B0CA BIT 3,A       ; {Jump if the joystick is not pushed up.
 $B0CC JR Z,$B0D0    ; }
 $B0CE SET 2,C       ; Set the bit for moving forward.
@label=ReadKempstonJoystick_Fire
*$B0D0 AND $10       ; {Jump to finish if the fire button is not pressed.
 $B0D2 JR Z,$B103    ; }
 $B0D4 SET 3,C       ; Set the bit for firing the second weapon.
 $B0D6 JP $B103      ; Jump to finish.
; View the equivalent code in;
; #LIST
; { #SABREWULF$B0D9 }
; LIST#

; Read Cursor Keys
;
; Used by the routine at #R$B075.
; .
; Reads the cursor keys, which are the keys #N$05 (left), #N$06 (down),
; #N$07 (up), #N$08 (right) and #N$00. The code does not work properly: for up,
; right and #N$00 the test is the wrong way round, so the bits are set when the
; keys are not being pressed.
@label=ReadCursorKeys
c$B0D9 LD C,$00      ; Clear the controls.
 $B0DB LD A,$F7      ; {Read from the keyboard;
 $B0DD CALL $C0AB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$F7 | 1 | 2 | 3 | 4 | 5 }
                     ; TABLE#}
 $B0E0 BIT 4,A       ; {Jump if the key #N$05 (left) is not pressed.
 $B0E2 JR Z,$B0E6    ; }
 $B0E4 SET 1,C       ; Set the bit for turning left.
@label=ReadCursorKeys_Digits
*$B0E6 LD A,$EF      ; {Read from the keyboard;
 $B0E8 CALL $C0AB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$EF | 0 | 9 | 8 | 7 | 6 }
                     ; TABLE#}
 $B0EB BIT 4,A       ; {Jump if the key #N$06 (down) is not pressed.
 $B0ED JR Z,$B0F1    ; }
 $B0EF SET 6,C       ; Set the bit for the action key.
@label=ReadCursorKeys_CheckUp
*$B0F1 BIT 3,A       ; {Jump if the key #N$07 (up) is pressed.
 $B0F3 JR NZ,$B0F7   ; }
 $B0F5 SET 2,C       ; Set the bit for moving forward.
@label=ReadCursorKeys_CheckRight
*$B0F7 BIT 2,A       ; {Jump if the key #N$08 (right) is pressed.
 $B0F9 JR NZ,$B0FD   ; }
 $B0FB SET 0,C       ; Set the bit for turning right.
@label=ReadCursorKeys_CheckFire
*$B0FD BIT 0,A       ; {Jump if the key #N$00 is pressed.
 $B0FF JR NZ,$B103   ; }
 $B101 SET 3,C       ; Set the bit for firing the second weapon.

; Finish Joystick Controls
;
; Used by the routines at #R$B085, #R$B0B4 and #R$B0D9.
; .
; Adds the keys that work with every method of control, and stores the
; controls. Any of the keys Z, X, C, V, Symbol Shift, M, N and B fires the first
; weapon.
;
; C Controls that were read
@label=FinishJoystickControls
c$B103 LD A,($9625)  ; Fetch the controls that have not been used yet...
 $B106 AND $BF       ; ...clear the bit for the action key...
 $B108 OR C          ; ...and add the controls that were read.
 $B109 LD C,A        ; Keep the controls.
 $B10A LD A,$7E      ; {Read from the keyboard;
 $B10C CALL $C0AB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$7E | SHIFT / SPACE | Z / SYM | X / M | C / N | V / B }
                     ; TABLE#}
 $B10F AND $1E       ; {Jump if none of the keys Z, X, C, V, Symbol Shift, M, N and B is
 $B111 JR Z,$B115    ; pressed.}
 $B113 SET 4,C       ; Set the bit for firing the first weapon.
@label=FinishJoystickControls_Store
*$B115 LD A,C        ; Fetch the controls...
 $B116 LD ($9625),A  ; ...and store them.
 $B119 POP BC        ; Restore #REGbc.
 $B11A LD C,A        ; Return the controls in #REGc as well.
 $B11B RET           ; Return.

; Read Keyboard
;
; Used by the routine at #R$B075.
; .
; Reads the keyboard. The keys C, M and B turn right, and X, V and N turn
; left. Any of A, S, D, F, G, Enter, L, K, J and H moves forward. The keys O, U,
; Q, E and T fire the second weapon, and P, I, Y, W and R fire the first one. Z,
; Symbol Shift and all of the number keys use the action key.
;
; O:A The controls
; O:C The controls
@label=ReadKeyboard
c$B11C LD A,$FE      ; {Read from the keyboard;
 $B11E CALL $C0AB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$FE | SHIFT | Z | X | C | V }
                     ; TABLE#}
 $B121 PUSH BC       ; Save #REGbc.
 $B122 RRCA          ; Move the keys Z, X, C and V into the lowest bits...
 $B123 AND $0E       ; ...and keep X, C and V.
 $B125 LD C,A        ; Keep the keys X, C and V.
 $B126 AND $03       ; Keep X, which turns left...
 $B128 SRL C         ; ...and move C and V down by two bits.
 $B12A SRL C         ; Shift C into the right-turn bit and V into the left-turn
                     ; bit.
 $B12C OR C          ; Combine them, so that C turns right and X or V turn
                     ; left...
 $B12D AND $03       ; {...and keep just the bits for turning.
 $B12F LD C,A        ; }
 $B130 LD A,$7F      ; {Read from the keyboard;
 $B132 CALL $C0AB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$7F | SPACE | SYMBOL SHIFT | M | N | B }
                     ; TABLE#}
 $B135 RRA           ; Move the keys Symbol Shift, M, N and B into the lowest
                     ; bits...
 $B136 AND $0E       ; ...and keep M, N and B.
 $B138 LD B,A        ; Keep the keys M, N and B.
 $B139 RR B          ; Rotate the keys round, so that N turns left and M turns
                     ; right...
 $B13B RLA           ; Shift the next key in.
 $B13C RR B          ; Rotate the keys that are left.
 $B13E RLA           ; Shift the next key in.
 $B13F AND $03       ; {...keep just the bits for turning and combine them with
 $B141 OR C          ; the others.}
 $B142 LD C,A        ; Keep the turning bits.
 $B143 RR B          ; Do the same for the last of the keys, so that B turns
                     ; right...
 $B145 RLA           ; Shift the last key in.
 $B146 RR B          ; Rotate the keys that are left.
 $B148 RLA           ; Shift the last key in.
 $B149 AND $03       ; {...keep just the bits for turning and combine them with
 $B14B OR C          ; the others.}
 $B14C POP BC        ; Restore #REGbc.
 $B14D LD C,A        ; Keep the bits for turning.
 $B14E LD A,$BD      ; {Read from the keyboard;
 $B150 CALL $C0AB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$BD | A / ENTER | S / L | D / K | F / J | G / H }
                     ; TABLE#}
 $B153 AND $1F       ; {Jump if none of them is pressed.
 $B155 JR Z,$B159    ; }
 $B157 SET 2,C       ; Set the bit for moving forward.
@label=ReadKeyboard_ReadPToY
*$B159 LD A,$DF      ; {Read from the keyboard;
 $B15B CALL $C0AB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$DF | P | O | I | U | Y }
                     ; TABLE#}
 $B15E LD B,A        ; Keep the keys P to Y.
 $B15F AND $0A       ; {Jump if neither O nor U is pressed.
 $B161 JR Z,$B165    ; }
 $B163 SET 3,C       ; Set the bit for firing the second weapon.
@label=ReadKeyboard_CheckPIY
*$B165 LD A,B        ; Fetch the keys again.
 $B166 AND $15       ; {Jump if none of P, I and Y is pressed.
 $B168 JR Z,$B16C    ; }
 $B16A SET 4,C       ; Set the bit for firing the first weapon.
@label=ReadKeyboard_ReadQToT
*$B16C LD A,$FB      ; {Read from the keyboard;
 $B16E CALL $C0AB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$FB | Q | W | E | R | T }
                     ; TABLE#}
 $B171 LD B,A        ; Keep the keys Q to T.
 $B172 AND $15       ; {Jump if none of Q, E and T is pressed.
 $B174 JR Z,$B178    ; }
 $B176 SET 3,C       ; Set the bit for firing the second weapon.
@label=ReadKeyboard_CheckQET
*$B178 LD A,B        ; Fetch the keys again.
 $B179 AND $0A       ; {Jump if neither W nor R is pressed.
 $B17B JR Z,$B17F    ; }
 $B17D SET 4,C       ; Set the bit for firing the first weapon.
@label=ReadKeyboard_Controls
*$B17F LD A,($9625)  ; Fetch the controls that have not been used yet...
 $B182 OR C          ; ...and add the new ones.
 $B183 LD C,A        ; Keep the controls.
 $B184 RES 6,C       ; Clear the bit for the action key.
 $B186 LD A,$7E      ; {Read from the keyboard;
 $B188 CALL $C0AB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$7E | SHIFT / SPACE | Z / SYM | X / M | C / N | V / B }
                     ; TABLE#}
 $B18B AND $02       ; {Jump if neither Z nor Symbol Shift is pressed.
 $B18D JR Z,$B191    ; }
 $B18F SET 6,C       ; Set the bit for the action key.
@label=ReadKeyboard_ReadNumbers
*$B191 LD A,$E7      ; {Read from the keyboard;
 $B193 CALL $C0AB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$E7 | 1 / 0 | 2 / 9 | 3 / 8 | 4 / 7 | 5 / 6 }
                     ; TABLE#}
 $B196 AND $1F       ; {Jump if none of the number keys is pressed.
 $B198 JR Z,$B19C    ; }
 $B19A SET 6,C       ; Set the bit for the action key.
@label=ReadKeyboard_Store
*$B19C LD A,C        ; Fetch the controls...
 $B19D LD ($9625),A  ; ...and store them.
 $B1A0 POP BC        ; Restore #REGbc.
 $B1A1 LD C,A        ; Return the controls in #REGc as well.
 $B1A2 RET           ; Return.

; Fill Memory
;
; Used by the routines at #R$98D0, #R$9A4B and #R$B1AD.
; .
; Fills an area of memory with zero. The entry point at #R$B1A5 fills it
; with the byte in #REGe.
;
; BC Number of bytes
; HL Address of the first byte
@label=FillMemory
c$B1A3 LD E,$00      ; Set #REGe to #N$00.
; This entry point is used by the routine at #R$B1B8.
@label=FillMemory_WithValue
*$B1A5 LD (HL),E     ; Write #REGe.
 $B1A6 INC HL        ; Increment #REGhl.
 $B1A7 DEC BC        ; Decrement #REGbc.
 $B1A8 LD A,B        ; {Loop back until the byte counter is zero.
 $B1A9 OR C          ;
 $B1AA JR NZ,$B1A5   ; }
 $B1AC RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CE56 }
; { #GUNFRIGHT$D6E1 }
; { #KNIGHTLORE$D53A }
; { #NIGHTSHADE$E5BA }
; { #PENTAGRAM$CB77 }
; { #UNDERWURLDE$9569 }
; LIST#

; Clear Screen
;
; Used by the routine at #R$98D0.
; .
; Resets the whole display: the attributes are set to bright white on
; black and the pixels are cleared.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SCR$02(clear-screen-before)
; | #SIM(start=$98E9,stop=$98EC,clear=1,sp=$5E00)
; #SCR$02(clear-screen-after) } UDGTABLE# #POPS
@label=ClearScreen
c$B1AD CALL $B1B8    ; Set every attribute using #R$B1B8.
 $B1B0 LD HL,$4000   ; Point #REGhl at the start of the display file.
 $B1B3 LD BC,$1800   ; There are #N$1800 bytes of pixels to clear.
 $B1B6 JR $B1A3      ; Clear them using #R$B1A3.

; Reset Attributes
;
; Used by the routine at #R$B1AD.
; .
; Sets all #N$0300 attribute bytes to #N$47 (bright white ink on black
; paper).
@label=ResetAttributes
c$B1B8 LD E,$47      ; Use the attribute #N$47.
 $B1BA LD HL,$5800   ; Point #REGhl at the start of the attribute file.
 $B1BD LD BC,$0300   ; There are #N$0300 attributes.
 $B1C0 JR $B1A5      ; Fill them using #R$B1A5.

; Fill Play Window Attributes
;
; Used by the routines at #R$990A, #R$B217 and #R$B6D2.
; .
; Fills the attributes of the play window, which is #N$14 characters wide
; and #N$0E characters tall and starts at column #N$02 of row #N($02), with a
; single attribute.
;
; A Attribute
@label=FillPlayWindowAttributes
c$B1C2 LD HL,$5842   ; Point #REGhl at the top left attribute of the play
                     ; window.
 $B1C5 LD DE,$000C   ; There are #N$0C attributes between the end of one window row and the
                     ; start of the next.
 $B1C8 LD BC,$140E   ; The window is #N$14 columns wide (#REGb) and #N$0E rows tall
                     ; (#REGc).
; This entry point is used by the routines at #R$B1D6 and #R$B1E1.
@label=FillAttributes_Row
*$B1CB PUSH BC       ; Save the dimensions.
@label=FillAttributes_Column
*$B1CC LD (HL),A     ; Write the attribute to the current cell.
 $B1CD INC L         ; Move on to the next column.
 $B1CE DJNZ $B1CC    ; Loop back until the row is complete.
 $B1D0 ADD HL,DE     ; Move on to the start of the next row.
 $B1D1 POP BC        ; Restore the dimensions.
 $B1D2 DEC C         ; Decrease the row counter by one.
 $B1D3 JR NZ,$B1CB   ; Loop back until every row has been filled.
 $B1D5 RET           ; Return.

; Fill Large Window Attributes
;
; Used by the routine at #R$B212.
; .
; Fills the attributes of the large window, which is #N$14 characters wide
; and #N$14 characters tall and starts at column #N$02 of row #N($02), with a
; single attribute. This is the play window plus the rows below it.
;
; A Attribute
@label=FillLargeWindowAttributes
c$B1D6 LD HL,$5842   ; Point #REGhl at the top left attribute of the window.
 $B1D9 LD DE,$000C   ; There are #N$0C attributes between the end of one window row and the
                     ; start of the next.
 $B1DC LD BC,$1414   ; The window is #N$14 columns wide (#REGb) and #N$14 rows tall
                     ; (#REGc).
 $B1DF JR $B1CB      ; Fill the window using #R$B1CB.

; Fill Message Attributes
;
; Used by the routine at #R$BBAA.
; .
; Fills the attributes of the message area at the bottom of the screen,
; which is #N$18 characters wide and #N$06 characters tall and starts at column
; #N$00 of row #N($12), with a single attribute.
;
; A Attribute
@label=FillMessageAttributes
c$B1E1 LD HL,$5A40   ; Point #REGhl at the first attribute of row #N$12.
 $B1E4 LD DE,$0008   ; There are #N$08 attributes between the end of one row and the start
                     ; of the next.
 $B1E7 LD BC,$1806   ; The area is #N$18 columns wide (#REGb) and #N$06 rows
                     ; tall (#REGc).
 $B1EA JR $B1CB      ; Fill the area using #R$B1CB.

; Blank Play Area
;
; Used by the routine at #R$B217.
; .
; Clears the pixels of the play window: #N$14 bytes wide and #N$70 pixel
; rows tall, starting at column #N$02 of the first pixel row.
@label=BlankPlayArea
c$B1EC LD HL,$4042   ; Point #REGhl at the top left of the play window.
 $B1EF LD BC,$1470   ; The window is #N$14 bytes wide (#REGb) and #N$70 pixel rows tall
                     ; (#REGc).
; Continue on to #R$B1F2.
; .
; View the equivalent code in;
; #LIST
; { #LUNARJETMAN$8BA5 }
; LIST#

; Clear Pixel Block
;
; Used by the routines at #R$990A, #R$B202 and #R$B20A.
; .
; Clears a rectangle of the display file.
;
; HL Screen address of the top left byte
; B Width in bytes
; C Height in pixel rows
@label=ClearPixelBlock
c$B1F2 PUSH BC       ; Save the dimensions.
 $B1F3 PUSH HL       ; Save the screen address of the start of the row.
@label=ClearPixelBlock_Byte
*$B1F4 LD (HL),$00   ; Clear the current byte of the row.
 $B1F6 INC L         ; Move on to the next byte.
 $B1F7 DJNZ $B1F4    ; Loop back until the whole row has been cleared.
 $B1F9 POP HL        ; Restore the screen address of the start of the row.
 $B1FA CALL $BD3A    ; Move down to the next pixel row using #R$BD3A.
 $B1FD POP BC        ; Restore the dimensions.
 $B1FE DEC C         ; Decrease the pixel row counter by one.
 $B1FF JR NZ,$B1F2   ; Loop back until every row has been cleared.
 $B201 RET           ; Return.

; Clear Message Area
;
; Used by the routine at #R$BBAA.
; .
; Clears the pixels of the message area at the bottom of the screen: #N$18
; bytes wide and #N$30 pixel rows tall, starting at row #N$12.
@label=ClearMessageArea
c$B202 LD HL,$5040   ; Point #REGhl at the first pixel row of row #N$12.
 $B205 LD BC,$1830   ; The area is #N$18 bytes wide (#REGb) and #N$30 pixel rows tall
                     ; (#REGc).
 $B208 JR $B1F2      ; Clear it using #R$B1F2.

; Clear Large Window
;
; Used by the routines at #R$98D0 and #R$B212.
; .
; Clears the pixels of the large window: #N$14 bytes wide and #N$A0 pixel
; rows tall, starting at column #N$02 of the first pixel row.
@label=ClearLargeWindow
c$B20A LD HL,$4042   ; Point #REGhl at the top left of the window.
 $B20D LD BC,$14A0   ; The window is #N$14 bytes wide (#REGb) and #N$A0 pixel rows tall
                     ; (#REGc).
 $B210 JR $B1F2      ; Clear it using #R$B1F2.

; Clear Large Window With Attributes
;
; Used by the routines at #R$B6FD, #R$B76C, #R$B78C, #R$B970 and #R$BB12.
; .
; Fills the large window with an attribute and then clears its pixels.
;
; A Attribute
@label=ClearLargeWindowWithAttributes
c$B212 CALL $B1D6    ; Fill the attributes using #R$B1D6.
 $B215 JR $B20A      ; Clear the pixels using #R$B20A.

; Clear Play Window With Attributes
;
; Used by the routines at #R$9A22, #R$9A4B, #R$9AA5, #R$B6D2 and #R$B72B.
; .
; Fills the play window with an attribute and then clears its pixels.
;
; A Attribute
@label=ClearPlayWindowWithAttributes
c$B217 CALL $B1C2    ; Fill the attributes using #R$B1C2.
 $B21A JR $B1EC      ; Clear the pixels using #R$B1EC.

; Draw Play Window
;
; Used by the routine at #R$993C.
; .
; Copies the off-screen play window buffer to the display, and at the same
; time resets the buffer to the dithered grey background of the play window
; (alternate lines of #N$55 and #N$AA). The buffer occupies #N$F580 to #N$FFFF:
; #N$70 lines of #N$18 bytes. Only the middle #N$14 bytes of each line are shown
; on screen, as the #N$02 bytes at each end are margins that let sprites
; overhang the edges of the window. The lines are copied from the bottom of the
; window to the top, working backwards through the buffer. The stack pointer is
; pointed at the display and each pair of bytes taken from the buffer is written
; using a PUSH instruction, which is much faster than storing the bytes one at a
; time.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$98E0,stop=$98EC,clear=1,sp=$5E00)
; #SIM(start=$98EC,stop=$98EF)
; #SIM(start=$98EF,stop=$98F2)
; #SIM(start=$98F2,stop=$98F5)
; #SIM(start=$98F5,stop=$98F8)
; #POKES$D355,$10;$D356,$50;$D357,$50
; #POKES$D358,$08;$D359,$78;$D35A,$70
; #POKES$D35B,$60;$D35C,$A0;$D35D,$50
; #POKES$D35E,$68;$D35F,$50;$D360,$88
; #POKES$D361,$50;$D362,$B0;$D363,$88
; #POKES$D364,$00
; #SIM(start=$99F8,stop=$99FB)
; #SCR$02(draw-play-window-before)
; | #SIM(start=$99FB,stop=$99FE)
; #SCR$02(draw-play-window-after) } UDGTABLE# #POPS
@label=DrawPlayWindow
c$B21C LD DE,$4FF6   ; Point #REGde at the screen address just after the bottom right byte
                     ; of the play window.
; This entry point is used by the routine at #R$98D0.
; .
; Entered from #R$98E3 with #REGde pointing at the ROM, to fill the buffer
; with the dithered background without drawing anything. #REGde holds the screen
; address just after the bottom right byte of the window.
@label=DrawPlayWindow_Entry
*$B21F LD ($9623),SP ; Save the stack pointer.
 $B223 LD HL,$FFFD   ; Point #REGhl at the last visible byte of the buffer, which is the
                     ; bottom right of the window.
 $B226 LD BC,$7055   ; Set the line counter to #N$70 (the height of the play window in
                     ; pixels) and the background pattern for the bottom line to #N$55.
 $B229 EX DE,HL      ; Put the screen address in #REGhl, so that it can be used as the
                     ; stack pointer.
@label=DrawPlayWindow_Screen
*$B22A LD SP,HL      ; {Point the stack pointer at the screen address, and swap the buffer
 $B22B EX DE,HL      ; pointer back into #REGhl.}
; Copy a line of the buffer, two bytes at a time, and replace each byte
; with the background pattern.
@label=DrawPlayWindow_Line
 $B22C LD D,(HL)     ; {Copy two bytes from the buffer to the screen and replace them with
 $B22D LD (HL),C     ; the pattern.
 $B22E DEC L         ;
 $B22F LD E,(HL)     ;
 $B230 LD (HL),C     ;
 $B231 DEC L         ;
 $B232 PUSH DE       ; }
 $B233 LD D,(HL)     ; {Copy the next two bytes.
 $B234 LD (HL),C     ;
 $B235 DEC L         ;
 $B236 LD E,(HL)     ;
 $B237 LD (HL),C     ;
 $B238 DEC L         ;
 $B239 PUSH DE       ; }
 $B23A LD D,(HL)     ; {Copy the next two bytes.
 $B23B LD (HL),C     ;
 $B23C DEC L         ;
 $B23D LD E,(HL)     ;
 $B23E LD (HL),C     ;
 $B23F DEC HL        ;
 $B240 PUSH DE       ; }
 $B241 LD D,(HL)     ; {Copy the next two bytes.
 $B242 LD (HL),C     ;
 $B243 DEC HL        ;
 $B244 LD E,(HL)     ;
 $B245 LD (HL),C     ;
 $B246 DEC L         ;
 $B247 PUSH DE       ; }
 $B248 LD D,(HL)     ; {Copy the next two bytes.
 $B249 LD (HL),C     ;
 $B24A DEC L         ;
 $B24B LD E,(HL)     ;
 $B24C LD (HL),C     ;
 $B24D DEC L         ;
 $B24E PUSH DE       ; }
 $B24F LD D,(HL)     ; {Copy the next two bytes.
 $B250 LD (HL),C     ;
 $B251 DEC L         ;
 $B252 LD E,(HL)     ;
 $B253 LD (HL),C     ;
 $B254 DEC L         ;
 $B255 PUSH DE       ; }
 $B256 LD D,(HL)     ; {Copy the next two bytes.
 $B257 LD (HL),C     ;
 $B258 DEC L         ;
 $B259 LD E,(HL)     ;
 $B25A LD (HL),C     ;
 $B25B DEC HL        ;
 $B25C PUSH DE       ; }
 $B25D LD D,(HL)     ; {Copy the next two bytes.
 $B25E LD (HL),C     ;
 $B25F DEC HL        ;
 $B260 LD E,(HL)     ;
 $B261 LD (HL),C     ;
 $B262 DEC L         ;
 $B263 PUSH DE       ; }
 $B264 LD D,(HL)     ; {Copy the next two bytes.
 $B265 LD (HL),C     ;
 $B266 DEC L         ;
 $B267 LD E,(HL)     ;
 $B268 LD (HL),C     ;
 $B269 DEC L         ;
 $B26A PUSH DE       ; }
 $B26B LD D,(HL)     ; {Copy the last two bytes of the line (#N$14 bytes have now been
 $B26C LD (HL),C     ; copied).
 $B26D DEC L         ;
 $B26E LD E,(HL)     ;
 $B26F LD (HL),C     ;
 $B270 DEC L         ;
 $B271 PUSH DE       ; }
 $B272 DEC L         ; {Skip the margin bytes: the two on the left of this line and the two
 $B273 DEC HL        ; on the right of the line above.
 $B274 DEC HL        ;
 $B275 DEC L         ; }
 $B276 RRC C         ; Swap the background pattern between #N$55 and #N$AA for the next
                     ; line.
 $B278 EX DE,HL      ; Keep the buffer pointer.
; Work out the screen address of the end of the pixel line above.
 $B279 LD HL,$FF14   ; {Add #N($FF14, $04, $04) (-#N$EC) to the stack pointer, which has
 $B27C ADD HL,SP     ; moved back #N$14 bytes along the line, to give the address one pixel line up.
                     ; }
 $B27D LD A,H        ; {Test whether the new address is the bottom pixel line of the
 $B27E CPL           ; character row above.
 $B27F AND $07       ; }
 $B281 JR NZ,$B28D   ; Jump if it is not, as the address is correct.
 $B283 LD A,L        ; {Move up a character row by subtracting #N$20 from the
 $B284 SUB $20       ; low byte.
 $B286 LD L,A        ; }
 $B287 JR C,$B28D    ; Jump if that crossed a third of the display.
 $B289 LD A,H        ; {Otherwise move to the bottom pixel line of the row.
 $B28A ADD A,$08     ;
 $B28C LD H,A        ; }
@label=DrawPlayWindow_NextLine
*$B28D DJNZ $B22A    ; Loop back until all #N$70 lines have been copied.
 $B28F LD SP,($9623) ; Restore the stack pointer.
 $B293 RET           ; Return.
; Continue on to #R$B21F.

; Build Shift Tables
;
; Used by the routine at #R$98D0.
; .
; Builds the lookup tables used to shift sprite bytes right by any number
; of pixels, and the table used to reverse the bits of a byte. The shift tables
; occupy #N$E000 to #N$EFFF. For each byte value #N$00 to #N$FF and each shift
; of #N$00 to #N$07 bits to the left, the byte is stored as a #N$10 bit number.
; The low byte of the number is stored in page #N$EF for a shift of #N($00),
; page #N$ED for a shift of #N($01), and so on in steps of two pages. The high
; byte is
; stored in the page below it. Both are stored at the offset given by the
; original value. The table at #N$F000 gives the value of each byte with its
; bits reversed, and is used to flip sprites.
@label=BuildShiftTables
c$B294 LD L,$00      ; Start with the byte value #N$00.
@label=BuildShiftTables_NextValue
*$B296 LD D,$00      ; Clear the high byte of the shifted value.
 $B298 LD E,L        ; Copy the byte value into the low byte of the shifted
                     ; value.
 $B299 LD H,$EF      ; Point #REGh at the first table page, #N$EF.
 $B29B LD B,$08      ; There are #N$08 shifts to tabulate.
@label=BuildShiftTables_Shift
*$B29D LD A,E        ; {Store the low byte of the shifted value.
 $B29E LD (HL),A     ; }
 $B29F DEC H         ; Move to the page below.
 $B2A0 LD A,D        ; {Store the high byte of the shifted value.
 $B2A1 LD (HL),A     ; }
 $B2A2 DEC H         ; Move to the next page below.
 $B2A3 SLA E         ; {Shift the #N$10 bit value left by one bit.
 $B2A5 RL D          ; }
 $B2A7 DJNZ $B29D    ; Loop back until all shifts have been stored.
 $B2A9 INC L         ; {Move on to the next byte value, and loop back until all #N$0100 have
 $B2AA JR NZ,$B296   ; been done.}
 $B2AC LD HL,$F000   ; Point #REGhl at #R$F000.
@label=BuildShiftTables_ReverseByte
*$B2AF LD A,L        ; Take the byte value to reverse.
 $B2B0 LD B,$08      ; There are #N$08 bits to move.
@label=BuildShiftTables_ReverseBit
*$B2B2 RRA           ; Move the lowest bit out into the carry flag.
 $B2B3 RL E          ; Move the carry flag in at the bottom of #REGe, so the bits end up
                     ; reversed.
 $B2B5 DJNZ $B2B2    ; Loop back until all #N$08 bits have been moved.
 $B2B7 LD (HL),E     ; Store the reversed byte.
 $B2B8 INC L         ; {Move on to the next byte value, and loop back until all #N$0100 have
 $B2B9 JR NZ,$B2AF   ; been done.}
 $B2BB RET           ; Return.

; Draw Sprite
;
; Used by the routine at #R$BF6A.
; .
; Draws one sprite into the off-screen play window buffer. The sprite is
; found using the type in the draw list entry, as an index into the table of
; sprite pointers at #R$60A3. A sprite has a two byte header (the width in bytes
; plus flags, then the height in pixel rows) followed by its pixel rows, each
; made of pairs of bytes, one pair for each byte of width. The first byte of
; each pair is ORed onto the buffer and the second is then XORed onto the
; result. The rows are stored from the bottom of the sprite to the top. A sprite
; whose width and height are both zero is blank and is not drawn. Bit 7 of the
; type in the draw list entry means the sprite is drawn facing the other way.
; The flag in bit 7 of the sprite's own header records which way its data is
; currently stored, and if the two differ then the sprite's data is flipped in
; place first, using #R$B453. The x position is a pixel position in the buffer,
; where #N$10 is the left edge of the play window. The y position is the height
; of the bottom of the sprite above the bottom of the buffer, so it increases up
; the screen: #N$30 is the bottom of the play window and #N$A0 is the top.
; Sprites that overlap the top or bottom are clipped, and #N$10 pixels either
; side are available for sprites that overhang the left or right edge. If the
; sprite is not on a byte boundary then each pair of bytes is shifted right by
; the number of pixels using the tables built by #R$B294, and an extra byte is
; written for each row. The drawing is done by unrolled loops at #R$B36B
; (shifted) and #R$B42E (byte aligned), which are entered part way along
; according to the width of the sprite so that exactly the right number of bytes
; are drawn on each row. The sprite data is read by pointing the stack pointer
; at it and using POP.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$98E0,stop=$98EC,clear=1,sp=$5E00)
; #SIM(start=$98EC,stop=$98EF)
; #SIM(start=$98EF,stop=$98F2)
; #SIM(start=$98F2,stop=$98F5)
; #SIM(start=$98F5,stop=$98F8)
; #SCR$02(draw-sprite-before)
; | #POKES$D355,$10;$D356,$50;$D357,$50
; #POKES$D358,$00
; #SIM(start=$BF6A,stop=$BF76)
; #SIM(start=$99FB,stop=$99FE)
; #SCR$02(draw-sprite-after) } UDGTABLE# #POPS
;
; IX Draw list entry: type, x position, y position
;
; Find the sprite for this entry.
@label=DrawSprite
c$B2BC LD A,(IX+$00) ; Fetch the type.
 $B2BF ADD A,A       ; Double it, discarding the "face the other way" bit, to give the
                     ; offset into the table of pointers.
 $B2C0 LD L,A        ; {Add the offset to the address of the table of sprite pointers at
 $B2C1 LD H,$00      ; #R$60A3.
 $B2C3 LD BC,$60A3   ;
 $B2C6 ADD HL,BC     ; }
 $B2C7 LD E,(HL)     ; {Fetch the address of the sprite into #REGde.
 $B2C8 INC HL        ;
 $B2C9 LD D,(HL)     ; }
 $B2CA LD A,(DE)     ; {Fetch the width byte of the header into #REGc.
 $B2CB LD C,A        ; }
 $B2CC INC DE        ; {Fetch the height from the header.
 $B2CD LD A,(DE)     ; }
 $B2CE OR C          ; {Combine them and keep bits 0-5.
 $B2CF AND $3F       ; }
 $B2D1 RET Z         ; Return if both the width and the height are zero, as the sprite is
                     ; blank.
 $B2D2 DEC DE        ; Point #REGde at the start of the header again.
 $B2D3 CALL $B453    ; Flip the sprite data if it is stored facing the wrong way, using
                     ; #R$B453.
; Find which page of the shift tables to use, which depends on the x
; position within a byte.
 $B2D6 LD A,(IX+$01) ; Fetch the x position.
 $B2D9 DEC A         ; {Take one off, shift the result left by one (multiplying by two) and
 $B2DA RLCA          ; keep only the three bits of the shift, so that this is the shift amount
 $B2DB AND $0E       ; multiplied by two.}
 $B2DD OR $E0        ; {Add the base of the shift tables to give the page
 $B2DF LD H,A        ; number, in #REGh.}
 $B2E0 LD A,(IX+$01) ; Fetch the x position again.
 $B2E3 AND $07       ; Test whether it is a multiple of #N$08.
 $B2E5 LD A,(DE)     ; Fetch the width byte of the header.
 $B2E6 JP Z,$B3B3    ; Jump to #R$B3B3 to draw the sprite without shifting if the x
                     ; position is exactly on a byte boundary.
; The sprite needs shifting, so it will cover one more byte on each row
; than its width.
 $B2E9 INC A         ; {Add one to the width in bytes.
 $B2EA AND $0F       ; }
 $B2EC LD ($9621),A  ; Store it as the number of bytes written to the buffer
                     ; for each row.
 $B2EF LD C,A        ; Take a copy of it.
 $B2F0 ADD A,$17     ; Add #N$17 to give the amount to subtract to get from the end of one
                     ; row of the buffer to the start of the row above, since each row is #N$18 bytes
                     ; long.
 $B2F2 LD ($B3A5),A  ; Write that as the number to subtract in the SUB instruction at
                     ; #R$B3A4.
 $B2F5 LD A,C        ; Fetch the width back, plus one.
 $B2F6 DEC A         ; Take one off to get the width.
 $B2F7 INC DE        ; Point #REGde at the height.
 $B2F8 NEG           ; {Negate the width and keep the bottom two bits, so that this is the
 $B2FA AND $03       ; number of unused copies of the unrolled loop out of the four available.
                     ; }
 $B2FC ADD A,A       ; {Multiply by #N($0E), the length of one copy of the
 $B2FD LD B,A        ; unrolled loop.
 $B2FE ADD A,A       ;
 $B2FF ADD A,B       ;
 $B300 ADD A,A       ;
 $B301 ADD A,B       ; }
 $B302 LD B,H        ; Hold the shift table page in #REGb.
 $B303 LD HL,$B36B   ; Point #REGhl at #R$B36B.
 $B306 CALL $BF92    ; Add the offset using #R$BF92, to skip the copies that are not
                     ; needed.
 $B309 LD ($B369),HL ; Write the address into the jump at #R$B368, so that it enters the
                     ; loop at the right place.
 $B30C LD A,(DE)     ; Fetch the height of the sprite.
 $B30D LD ($9622),A  ; Store it as the number of rows still to draw.
 $B310 LD H,B        ; Put the page number back into #REGh.
 $B311 LD C,(IX+$01) ; Fetch the x position into #REGc.
 $B314 LD B,(IX+$02) ; Fetch the y position into #REGb.
; Clip the bottom of the sprite, if it is below the bottom of the play
; window.
 $B317 LD A,B        ; {Is the bottom of the sprite on or above the bottom of the play
 $B318 CP $30        ; window (#N$30)?}
 $B31A JR NC,$B33E   ; Jump to #R$B33E if so.
 $B31C LD L,A        ; Keep the y position.
 $B31D LD A,(DE)     ; Fetch the height of the sprite.
 $B31E ADD A,L       ; Add the y position to get the top of the sprite.
 $B31F CP $30        ; Is the top of the sprite below the bottom of the play
                     ; window?
 $B321 RET C         ; Return if it is, as the sprite is not visible at all.
 $B322 LD A,$30      ; Work out how many rows of the sprite are below the play
                     ; window.
 $B324 SUB L         ; Subtract the y position from the bottom of the play
                     ; window.
 $B325 LD L,A        ; Keep that number of rows.
 $B326 LD A,(DE)     ; Fetch the height of the sprite.
 $B327 SUB L         ; Take away the number of rows that are cut off.
 $B328 RET Z         ; Return if nothing is left.
 $B329 LD ($9622),A  ; Store the number of rows that are left to be drawn.
 $B32C PUSH HL       ; Save the number of rows that are cut off.
 $B32D LD A,($9621)  ; Fetch the number of bytes written for each row.
 $B330 DEC A         ; Take one off to get the width in bytes.
 $B331 LD B,A        ; Use it as a counter.
 $B332 XOR A         ; {Start the total at zero, and clear the high byte of
 $B333 LD H,A        ; #REGhl.}
@label=DrawSprite_Shifted_Multiply
*$B334 ADD A,L       ; {Add the number of rows that were cut off to the total, once for each
 $B335 DJNZ $B334    ; byte of the width, to multiply them.}
 $B337 LD L,A        ; Keep the size of the hidden rows.
 $B338 ADD HL,HL     ; Double it, as each byte of the width has a pair of bytes
                     ; of data.
 $B339 ADD HL,DE     ; Add the address of the sprite to give the address of the first
                     ; visible row of data.
 $B33A EX DE,HL      ; Keep the address of the first visible row.
 $B33B POP HL        ; Restore #REGhl.
 $B33C LD B,$30      ; Start drawing from the bottom of the play window.
; Find the address in the buffer and point the stack pointer at the sprite
; data.
@label=DrawSprite_Shifted_Address
*$B33E CALL $B48E    ; Find the address in the buffer of the first byte to draw, using
                     ; #R$B48E.
 $B341 LD ($9623),SP ; Save the stack pointer.
 $B345 EX DE,HL      ; {Point the stack pointer at the sprite, so that POP
 $B346 LD SP,HL      ; fetches the data.
 $B347 EX DE,HL      ; }
 $B348 INC SP        ; Take it past the height byte, to the first pair of data
                     ; bytes.
; Clip the top of the sprite, if it is above the top of the play window.
 $B349 LD A,(IX+$02) ; Fetch the y position.
 $B34C CP $A0        ; {Jump to #R$B3AE to finish if it is, as the sprite is
 $B34E JP NC,$B3AE   ; not visible.}
 $B351 LD L,A        ; Keep the y position.
 $B352 LD A,($9622)  ; Fetch the number of rows to draw.
 $B355 ADD A,L       ; Add the y position to get the top of the sprite.
 $B356 SUB $A0       ; Subtract the top of the play window.
 $B358 JR C,$B360    ; Jump if the sprite does not reach above the top of the
                     ; play window.
 $B35A LD L,A        ; Keep the number of rows that are cut off.
 $B35B LD A,(DE)     ; {Take the cut off rows away from the number of rows to
 $B35C SUB L         ; draw.
 $B35D LD ($9622),A  ; }
@label=DrawSprite_Shifted_Rows
*$B360 LD A,($9622)  ; Fetch the number of rows to be drawn.
 $B363 EXX           ; {Switch to the shadow registers, and keep the number of rows to draw
 $B364 LD B,A        ; in #REGb'.}
@label=DrawSprite_Shifted_Row
*$B365 EXX           ; Switch back to the main registers.
 $B366 POP DE        ; Fetch the first pair of data bytes into #REGde.
 $B367 LD A,(BC)     ; Fetch the first byte of the buffer to be changed.
@label=DrawSprite_Shifted_Jump
*$B368 JP $B368      ; Jump into the unrolled loop.
; The unrolled loop that draws one row of a sprite that is not on a byte
; boundary. #REGbc points at the buffer, #REGde holds the current pair of data
; bytes (OR byte in #REGe and XOR byte in #REGd) and #REGh holds the shift table
; page. Each pair of bytes is split by the shift table into a left part that is
; merged into the buffer byte already in #REGa and a right part that is merged
; into the next buffer byte.
@label=DrawSprite_Shifted
 $B36B LD L,E        ; {Merge the left part of the shifted pair into the buffer byte already
 $B36C OR (HL)       ; in #REGa: OR on the shifted OR byte and XOR on the shifted XOR byte. Store the
 $B36D LD L,D        ; result and move on to the next buffer byte, and the right half of the shift
 $B36E XOR (HL)      ; table.
 $B36F LD (BC),A     ;
 $B370 INC BC        ;
 $B371 INC H         ; }
 $B372 LD L,E        ; {Merge the right part of the shifted pair into the next buffer byte
 $B373 LD A,(BC)     ; and leave it in #REGa, as the next pair also overlaps it. Go back to the left
 $B374 OR (HL)       ; half of the table and fetch the next pair of data bytes.
 $B375 LD L,D        ;
 $B376 XOR (HL)      ;
 $B377 DEC H         ;
 $B378 POP DE        ; }
 $B379 LD L,E        ; {Merge the left part of the second pair and store it.
 $B37A OR (HL)       ;
 $B37B LD L,D        ;
 $B37C XOR (HL)      ;
 $B37D LD (BC),A     ;
 $B37E INC BC        ;
 $B37F INC H         ; }
 $B380 LD L,E        ; {Merge the right part of the second pair and fetch the
 $B381 LD A,(BC)     ; third.
 $B382 OR (HL)       ;
 $B383 LD L,D        ;
 $B384 XOR (HL)      ;
 $B385 DEC H         ;
 $B386 POP DE        ; }
 $B387 LD L,E        ; {Merge the left part of the third pair and store it.
 $B388 OR (HL)       ;
 $B389 LD L,D        ;
 $B38A XOR (HL)      ;
 $B38B LD (BC),A     ;
 $B38C INC BC        ;
 $B38D INC H         ; }
 $B38E LD L,E        ; {Merge the right part of the third pair and fetch the
 $B38F LD A,(BC)     ; fourth.
 $B390 OR (HL)       ;
 $B391 LD L,D        ;
 $B392 XOR (HL)      ;
 $B393 DEC H         ;
 $B394 POP DE        ; }
 $B395 LD L,E        ; {Merge the left part of the fourth pair and store it.
 $B396 OR (HL)       ;
 $B397 LD L,D        ;
 $B398 XOR (HL)      ;
 $B399 LD (BC),A     ;
 $B39A INC BC        ;
 $B39B INC H         ; }
 $B39C LD L,E        ; {Merge the right part of the fourth pair.
 $B39D LD A,(BC)     ;
 $B39E OR (HL)       ;
 $B39F LD L,D        ;
 $B3A0 XOR (HL)      ;
 $B3A1 DEC H         ; }
 $B3A2 LD (BC),A     ; Store the last buffer byte of the row.
; Move up to the start of the previous row of the buffer. The number to
; subtract is written by #R$B2F2 for each sprite.
 $B3A3 LD A,C        ; {Subtract the number of bytes to step back (the operand of this
 $B3A4 SUB $00       ; instruction is modified) from the low byte of the buffer address.
 $B3A6 LD C,A        ; }
 $B3A7 JP NC,$B3AB   ; {Take a carry from the high byte if there was a borrow.
 $B3AA DEC B         ; }
@label=DrawSprite_Shifted_Next
*$B3AB EXX           ; Switch to the shadow registers, where #REGb' holds the number of
                     ; rows left to draw.
 $B3AC DJNZ $B365    ; Loop back until every row of the sprite has been drawn.
@label=DrawSprite_Done
*$B3AE LD SP,($9623) ; Restore the stack pointer.
 $B3B2 RET           ; Return.
; The sprite is on a byte boundary, so no shifting is needed and each pair
; of bytes is combined with just one byte of the buffer.
@label=DrawSprite_Aligned
*$B3B3 AND $0F       ; Keep the width of the sprite in bytes.
 $B3B5 LD ($9621),A  ; Store it as the number of bytes written to the buffer
                     ; for each row.
 $B3B8 LD C,A        ; Take a copy of it.
 $B3B9 ADD A,$17     ; Add #N$17 to give the amount to subtract to get back to the start of
                     ; the row above, once the last byte of a row has been written.
 $B3BB LD ($B447),A  ; Write that as the number to subtract in the SUB instruction at
                     ; #R$B446.
 $B3BE LD A,C        ; Fetch the width back.
 $B3BF INC DE        ; Point #REGde at the height.
 $B3C0 NEG           ; {Negate the width and keep the bottom two bits, so that this is the
 $B3C2 AND $03       ; number of unused copies of the unrolled loop out of the four available.
                     ; }
 $B3C4 LD C,A        ; Keep the number of unused copies of the loop.
 $B3C5 ADD A,A       ; {Multiply by #N($06), the length of one copy of the
 $B3C6 ADD A,C       ; unrolled loop.
 $B3C7 ADD A,A       ; }
 $B3C8 LD HL,$B42E   ; Point #REGhl at #R$B42E.
 $B3CB CALL $BF92    ; Add the offset using #R$BF92, to skip the copies that are not
                     ; needed.
 $B3CE LD ($B42C),HL ; Write the address into the jump at #R$B42B, so that it enters the
                     ; loop at the right place.
 $B3D1 LD A,(DE)     ; Fetch the height of the sprite.
 $B3D2 LD ($9622),A  ; Store it as the number of rows still to draw.
 $B3D5 LD C,(IX+$01) ; Fetch the x position into #REGc.
 $B3D8 LD B,(IX+$02) ; Fetch the y position into #REGb.
; Clip the bottom of the sprite, as in #R$B317.
 $B3DB LD A,B        ; {Is the bottom of the sprite on or above the bottom of the play
 $B3DC CP $30        ; window (#N$30)?}
 $B3DE JR NC,$B401   ; Jump to #R$B401 if so.
 $B3E0 LD L,A        ; Keep the y position.
 $B3E1 LD A,(DE)     ; Fetch the height of the sprite.
 $B3E2 ADD A,L       ; Add the y position to get the top of the sprite.
 $B3E3 CP $30        ; Is the top of the sprite below the bottom of the play
                     ; window?
 $B3E5 RET C         ; Return if it is, as the sprite is not visible at all.
 $B3E6 LD A,$30      ; Work out how many rows of the sprite are below the play
                     ; window.
 $B3E8 SUB L         ; Subtract the y position from the bottom of the play
                     ; window.
 $B3E9 LD L,A        ; Keep that number of rows.
 $B3EA LD A,(DE)     ; Fetch the height of the sprite.
 $B3EB SUB L         ; Take away the number of rows that are cut off.
 $B3EC RET Z         ; Return if nothing is left.
 $B3ED LD ($9622),A  ; Store the number of rows that are left to be drawn.
 $B3F0 PUSH HL       ; Save the number of rows that are cut off.
 $B3F1 LD A,($9621)  ; Fetch the width of the sprite in bytes.
 $B3F4 LD B,A        ; Use it as a counter.
 $B3F5 XOR A         ; {Start the total at zero, and clear the high byte of
 $B3F6 LD H,A        ; #REGhl.}
@label=DrawSprite_Aligned_Multiply
*$B3F7 ADD A,L       ; {Add the number of rows that were cut off to the total, once for each
 $B3F8 DJNZ $B3F7    ; byte of the width, to multiply them.}
 $B3FA LD L,A        ; Keep the size of the hidden rows.
 $B3FB ADD HL,HL     ; Double it, as each byte of the width has a pair of bytes
                     ; of data.
 $B3FC ADD HL,DE     ; Add the address of the sprite to give the address of the first
                     ; visible row of data.
 $B3FD EX DE,HL      ; Keep the address of the first visible row.
 $B3FE POP HL        ; Restore #REGhl.
 $B3FF LD B,$30      ; Start drawing from the bottom of the play window.
@label=DrawSprite_Aligned_Clip
*$B401 CALL $B48E    ; Find the address in the buffer of the first byte to draw, using
                     ; #R$B48E.
 $B404 LD ($9623),SP ; Save the stack pointer.
 $B408 EX DE,HL      ; {Point the stack pointer at the sprite, so that POP
 $B409 LD SP,HL      ; fetches the data.
 $B40A EX DE,HL      ; }
 $B40B INC SP        ; Take it past the height byte, to the first pair of data
                     ; bytes.
; Clip the top of the sprite, as in #R$B349.
 $B40C LD A,(IX+$02) ; Fetch the y position.
 $B40F CP $A0        ; {Jump to #R$B3AE to finish if it is, as the sprite is
 $B411 JP NC,$B3AE   ; not visible.}
 $B414 LD L,A        ; Keep the y position.
 $B415 LD A,($9622)  ; Fetch the number of rows to draw.
 $B418 ADD A,L       ; Add the y position to get the top of the sprite.
 $B419 SUB $A0       ; Subtract the top of the play window.
 $B41B JR C,$B423    ; Jump if the sprite does not reach above the top of the
                     ; play window.
 $B41D LD L,A        ; Keep the number of rows that are cut off.
 $B41E LD A,(DE)     ; Fetch the height of the sprite.
 $B41F SUB L         ; Take the cut off rows away from the number of rows to
                     ; draw.
 $B420 LD ($9622),A  ; Store the number of rows to be drawn.
@label=DrawSprite_Aligned_Rows
*$B423 LD A,($9622)  ; Fetch the number of rows to be drawn.
 $B426 LD H,B        ; {Move the buffer address into #REGhl.
 $B427 LD L,C        ; }
 $B428 EXX           ; {Switch to the shadow registers, and keep the number of rows to draw
 $B429 LD B,A        ; in #REGb'.}
@label=DrawSprite_Aligned_Row
*$B42A EXX           ; Switch back to the main registers.
@label=DrawSprite_Aligned_Jump
*$B42B JP $B42B      ; Jump into the unrolled loop.
; The unrolled loop that draws one row of a sprite on a byte boundary.
; #REGhl points at the buffer and each pair of data bytes is fetched into
; #REGde: the OR byte (#REGe) is ORed onto the buffer byte and the XOR byte
; (#REGd) is XORed onto the result.
@label=DrawSprite_Unrolled
 $B42E POP DE        ; {Merge the first pair of data bytes with the buffer byte
 $B42F LD A,E        ; and move on.
 $B430 OR (HL)       ;
 $B431 XOR D         ;
 $B432 LD (HL),A     ;
 $B433 INC HL        ; }
 $B434 POP DE        ; {Merge the second pair of data bytes with the buffer byte and move
 $B435 LD A,E        ; on.
 $B436 OR (HL)       ;
 $B437 XOR D         ;
 $B438 LD (HL),A     ;
 $B439 INC HL        ; }
 $B43A POP DE        ; {Merge the third pair of data bytes with the buffer byte
 $B43B LD A,E        ; and move on.
 $B43C OR (HL)       ;
 $B43D XOR D         ;
 $B43E LD (HL),A     ;
 $B43F INC HL        ; }
 $B440 POP DE        ; {Merge the fourth pair of data bytes with the buffer
 $B441 LD A,E        ; byte.
 $B442 OR (HL)       ;
 $B443 XOR D         ;
 $B444 LD (HL),A     ; }
; Move up to the start of the previous row of the buffer.
 $B445 LD A,L        ; {Subtract the number of bytes to step back (the operand of this
 $B446 SUB $00       ; instruction is modified) from the low byte of the buffer address.
                     ; }
 $B448 LD L,A        ; Keep the result.
 $B449 JP NC,$B44D   ; {Take a carry from the high byte if there was a borrow.
 $B44C DEC H         ; }
@label=DrawSprite_Aligned_Next
*$B44D EXX           ; Switch to the shadow registers, where #REGb' holds the number of
                     ; rows left to draw.
 $B44E DJNZ $B42A    ; Loop back until every row of the sprite has been drawn.
 $B450 JP $B3AE      ; Jump to #R$B3AE.

; Flip Sprite
;
; Used by the routine at #R$B2BC.
; .
; Flips a sprite in place, so that it is stored facing the other way, if
; the way it is stored does not match the direction of the entity being drawn.
; Each row of the sprite has its pairs of bytes put in the opposite order and
; each byte is reversed using the table at #R$F000.
;
; DE Address of the sprite header
; IX Draw list entry
@label=FlipSprite
c$B453 PUSH DE       ; Save the address of the sprite.
 $B454 LD A,(DE)     ; Fetch the header flags of the sprite.
 $B455 XOR (IX+$00)  ; Compare bit 7 with bit 7 of the type of the sprite being
                     ; drawn.
 $B458 AND $80       ; Keep only bit 7.
 $B45A JR Z,$B48C    ; Jump to #R$B48C if the sprite is already facing the
                     ; right way.
 $B45C LD A,(DE)     ; Fetch the width byte of the header.
 $B45D XOR $80       ; Toggle bit 7, as the sprite is being flipped.
 $B45F LD (DE),A     ; Store it.
 $B460 AND $0F       ; Keep the width in bytes.
 $B462 LD B,A        ; {Use it as the counter for the pairs in a row, and keep a copy in
 $B463 LD C,A        ; #REGc.}
 $B464 INC DE        ; Point #REGde at the height.
 $B465 LD A,(DE)     ; Fetch the height.
 $B466 EX AF,AF'     ; Keep the height, to count the rows.
 $B467 INC DE        ; Point #REGde at the first row of data.
 $B468 EX DE,HL      ; Point #REGhl at it.
 $B469 PUSH HL       ; Take a copy of the address.
 $B46A EXX           ; {Switch to the shadow registers and make #REGhl' the
 $B46B POP HL        ; source pointer.}
 $B46C LD B,$F0      ; Set #REGb' to the page of the table of reversed bytes.
 $B46E EXX           ; Switch back.
@label=FlipSprite_Row
*$B46F EXX           ; Switch to the shadow registers.
 $B470 LD C,(HL)     ; Fetch the OR byte of the pair.
 $B471 LD A,(BC)     ; Look up the byte with its bits reversed.
 $B472 LD E,A        ; Keep the reversed OR byte.
 $B473 INC HL        ; Move on to the XOR byte.
 $B474 LD C,(HL)     ; Fetch the XOR byte of the pair.
 $B475 LD A,(BC)     ; Look up the byte with its bits reversed.
 $B476 LD D,A        ; Keep the reversed XOR byte.
 $B477 INC HL        ; Move on to the next pair.
 $B478 PUSH DE       ; Save the reversed pair on the stack.
 $B479 EXX           ; Switch back to the main registers.
 $B47A DJNZ $B46F    ; Loop back until every pair in the row has been saved.
 $B47C LD B,C        ; Set the counter to the number of pairs in a row.
@label=FlipSprite_Write
*$B47D POP DE        ; Take a pair off the stack, so that the last pair of the row comes
                     ; first.
 $B47E LD (HL),E     ; Write the reversed OR byte.
 $B47F INC HL        ; Move on.
 $B480 LD (HL),D     ; Write the reversed XOR byte.
 $B481 INC HL        ; Move on to the next pair.
 $B482 DJNZ $B47D    ; Loop back until the row has been written back.
 $B484 EX AF,AF'     ; Fetch the row counter.
 $B485 DEC A         ; Decrease it by one.
 $B486 JR Z,$B48C    ; Jump to #R$B48C if every row has been flipped.
 $B488 EX AF,AF'     ; Store the row counter again.
 $B489 LD B,C        ; Set the counter to the number of pairs in a row.
 $B48A JR $B46F      ; Jump back to flip the next row.
@label=FlipSprite_Done
*$B48C POP DE        ; Restore the address of the sprite.
 $B48D RET           ; Return.

; Get Buffer Address
;
; Used by the routine at #R$B2BC.
; .
; Finds the address in the play window buffer of the byte that holds a
; given pixel position. The address is #N$F400 plus #N$18 times (#N$AF minus the
; y position) plus the x position divided by #N$08.
;
;   B y position
;   C x position
; O:BC Address in the buffer
@label=GetBufferAddress
c$B48E PUSH HL       ; Save #REGhl.
 $B48F PUSH BC       ; Save the x position.
 $B490 LD A,B        ; {Take the y position, subtract #N$20 and flip the bits (which is the
 $B491 SUB $20       ; same as taking it away from #N$11F), then add #N$90 to give #N$AF minus the y
 $B493 CPL           ; position.
 $B494 ADD A,$90     ; }
 $B496 LD L,A        ; {Put the result in #REGhl.
 $B497 XOR A         ;
 $B498 LD H,A        ; }
 $B499 LD B,H        ; {Copy it into #REGbc.
 $B49A LD C,L        ; }
 $B49B ADD HL,HL     ; {Multiply by #N$18: double it, add the original, then double three
 $B49C ADD HL,BC     ; times.
 $B49D ADD HL,HL     ;
 $B49E ADD HL,HL     ;
 $B49F ADD HL,HL     ; }
 $B4A0 POP BC        ; Restore the x position into #REGc.
 $B4A1 LD B,A        ; Clear the high byte of the x position.
 $B4A2 SRL C         ; {Divide the x position by #N$08.
 $B4A4 SRL C         ;
 $B4A6 SRL C         ; }
 $B4A8 ADD HL,BC     ; Add it to the offset.
 $B4A9 LD BC,$F400   ; {Add the base of the buffer.
 $B4AC ADD HL,BC     ; }
 $B4AD LD C,L        ; {Put the address into #REGbc.
 $B4AE LD B,H        ; }
 $B4AF POP HL        ; Restore #REGhl.
 $B4B0 RET           ; Return.

; Negate HL
;
; Negates #REGhl. This routine is not used.
;
;   HL The word
; O:HL The negative of the word
;
; Invert both bytes, then add one.
@label=NegateHL
c$B4B1 LD A,L        ; {Invert the low byte.
 $B4B2 CPL           ;
 $B4B3 LD L,A        ; }
 $B4B4 LD A,H        ; {Invert the high byte.
 $B4B5 CPL           ;
 $B4B6 LD H,A        ; }
 $B4B7 INC HL        ; Add one.
 $B4B8 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$D01B }
; { #NIGHTSHADE$E0DD }
; { #TRANZAM$6BF6 }
; { #LUNARJETMAN$8947 }
; LIST#

; Draw Panel
;
; Used by the routines at #R$98D0 and #R$9A4B.
; .
; Draws the panel on the right of the screen, which holds the score, the
; hi-score and the sector map. It is #N$08 characters wide and #N$0F characters
; tall, and is built from the characters at #R$9511 using the graphics at
; #R$9421, and coloured using the attributes at #R$9589.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$98E0,stop=$98EC,clear=1,sp=$5E00)
; #SIM(start=$98EC,stop=$98EF)
; #SCR$02(draw-panel-before)
; | #SIM(start=$98EF,stop=$98F2)
; #SCR$02(draw-panel-after) } UDGTABLE# #POPS
@label=DrawPanel
c$B4B9 LD HL,$9421   ; Point #REGhl at the user interface graphics.
 $B4BC LD ($9618),HL ; Use them as the current character set.
 $B4BF LD DE,$9511   ; Point #REGde at #R$9511.
 $B4C2 LD BC,$080F   ; The panel is #N$08 characters wide (#REGb) and #N$0F rows tall
                     ; (#REGc).
 $B4C5 LD HL,$4018   ; Point #REGhl at the top left of the panel, in column #N$18 of the
                     ; display file.
 $B4C8 CALL $B4E6    ; Print the characters of the panel using #R$B4E6.
 $B4CB LD BC,$080F   ; The panel is #N$08 characters wide (#REGb) and #N$0F rows tall
                     ; (#REGc).
 $B4CE LD HL,$5818   ; Point #REGhl at the top left of the panel, in column #N$18 of the
                     ; attribute file.
 $B4D1 LD DE,$9589   ; Point #REGde at #R$9589.
@label=DrawPanel_Row
*$B4D4 PUSH BC       ; Save the dimensions.
 $B4D5 PUSH HL       ; Save the address of the start of the row.
@label=DrawPanel_Attribute
*$B4D6 LD A,(DE)     ; {Copy an attribute into the attribute file and move on to the next
 $B4D7 INC DE        ; column, until the row is done.
 $B4D8 LD (HL),A     ;
 $B4D9 INC L         ;
 $B4DA DJNZ $B4D6    ; }
 $B4DC POP HL        ; Restore the address of the start of the row.
 $B4DD LD BC,$0020   ; {Move down to the next row of attributes.
 $B4E0 ADD HL,BC     ; }
 $B4E1 POP BC        ; Restore the dimensions.
 $B4E2 DEC C         ; Decrease the row counter by one.
 $B4E3 JR NZ,$B4D4   ; Loop back until every row of the panel has been
                     ; coloured.
 $B4E5 RET           ; Return.

; Print Character Block
;
; Used by the routine at #R$B4B9.
; .
; Prints a rectangle of characters.
;
; DE Address of the character codes
; HL Screen address of the top left
; B Width in characters
; C Height in characters
@label=PrintCharacterBlock
c$B4E6 PUSH BC       ; Save the dimensions.
 $B4E7 PUSH HL       ; Save the screen address of the start of the row.
@label=PrintCharacterBlock_Character
*$B4E8 LD A,(DE)     ; {Fetch the next character code.
 $B4E9 INC DE        ; }
 $B4EA CALL $B5CB    ; Print it using #R$B5CB.
 $B4ED DJNZ $B4E8    ; Loop back until a row of characters has been printed.
 $B4EF POP HL        ; Restore the screen address of the start of the row.
 $B4F0 CALL $B6B2    ; Move down to the next character row using #R$B6B2.
 $B4F3 POP BC        ; Restore the dimensions.
 $B4F4 DEC C         ; Decrease the row counter by one.
 $B4F5 JR NZ,$B4E6   ; Loop back until every row has been printed.
 $B4F7 RET           ; Return.

; Print Big Digit
;
; Used by the routines at #R$B5AF and #R$BBAA.
; .
; Prints a digit that is two characters tall, using the digit graphics at
; #R$6003.
;
;   A Digit (#N$00 to #N$09)
;   HL Screen address
; O:HL Screen address of the next column
@label=PrintBigDigit
c$B4F8 PUSH HL       ; Save the screen address.
 $B4F9 ADD A,A       ; Double the digit, to give the number of the top half of
                     ; the digit.
 $B4FA PUSH AF       ; Save the number.
 $B4FB CALL $B5CB    ; Print the top half of the digit using #R$B5CB.
 $B4FE DEC L         ; Move back to the column of the digit.
 $B4FF CALL $B6B2    ; Move down to the next character row using #R$B6B2.
 $B502 POP AF        ; Restore the number of the top half.
 $B503 INC A         ; Move on to the bottom half of the digit.
 $B504 CALL $B5CB    ; Print the bottom half of the digit.
 $B507 POP HL        ; Restore the original screen address.
 $B508 INC L         ; Move on to the next column.
 $B509 RET           ; Return.

; Print Double Height Character
;
; Used by the routine at #R$B52E.
; .
; Prints a character with every pixel row drawn twice, so that it is two
; characters tall.
;
;   A Character code (bit 7 is ignored)
;   HL Screen address
;   DE Pointer to the next character of the text
; O:DE Pointer to the following character of the text
; O:HL Screen address of the next column
@label=PrintDoubleHeightCharacter
c$B50A PUSH DE       ; Save the pointer into the text.
 $B50B PUSH HL       ; Save the screen address.
 $B50C LD DE,($9618) ; Fetch the address of the current character set.
 $B510 ADD A,A       ; {Multiply the character code by #N$08 (by doubling it and then
 $B511 LD L,A        ; multiplying it by four), ignoring bit 7.
 $B512 LD H,$00      ;
 $B514 ADD HL,HL     ;
 $B515 ADD HL,HL     ; }
 $B516 ADD HL,DE     ; Add the address of the character set.
 $B517 EX DE,HL      ; Point #REGde at the graphics of the character.
 $B518 POP HL        ; Restore the screen address.
 $B519 PUSH HL       ; Save it again.
 $B51A LD B,$08      ; There are #N$08 pixel rows in a character.
@label=PrintDoubleHeightCharacter_Row
*$B51C LD A,(DE)     ; Fetch a pixel row of the character.
 $B51D LD (HL),A     ; Write it to the screen.
 $B51E LD C,A        ; Keep a copy.
 $B51F CALL $B558    ; Move down to the next pixel row using #R$B558.
 $B522 LD (HL),C     ; Write the pixel row again.
 $B523 CALL $B558    ; Move down to the next pixel row.
 $B526 INC DE        ; Move on to the next pixel row of the character.
 $B527 DJNZ $B51C    ; Loop back until the whole character has been printed.
 $B529 POP HL        ; Restore the screen address.
 $B52A POP DE        ; Restore the pointer into the text.
 $B52B INC DE        ; Move on to the next character of the text.
 $B52C INC L         ; Move on to the next column.
 $B52D RET           ; Return.

; Print Double Height Text
;
; Used by the routines at #R$A091, #R$B8B3 and #R$BBAA.
; .
; Prints a string of text that is two characters tall. The string starts
; with an attribute byte, and its last character has bit 7 set.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$98E0,stop=$98EC,clear=1,sp=$5E00)
; #SIM(start=$98EC,stop=$98EF)
; #SIM(start=$98EF,stop=$98F2)
; #SIM(start=$98F2,stop=$98F5)
; #SIM(start=$98F5,stop=$98F8)
; #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$9901,stop=$9904)
; #SCR$02(print-double-height-before)
; | #SIM(start=$B8B3,stop=$B8C2)
; #SCR$02(print-double-height-after) } UDGTABLE# #POPS
;
; HL Position (#REGh is y, #REGl is x, in pixels)
; DE Address of the string
@label=PrintDoubleHeightText
c$B52E PUSH HL       ; Save the position.
 $B52F CALL $BD6A    ; Find the address of the attributes at that position
                     ; using #R$BD6A.
 $B532 LD A,(DE)     ; Fetch the attribute from the start of the string.
 $B533 INC DE        ; Move on to the first character.
 $B534 LD C,A        ; Keep the attribute.
 $B535 LD B,$02      ; The text is two characters tall.
@label=PrintDoubleHeightText_Attributes
*$B537 PUSH DE       ; Save the pointer to the text.
 $B538 PUSH HL       ; Save the attribute address.
@label=PrintDoubleHeightText_Attribute
*$B539 LD (HL),C     ; Colour the current cell.
 $B53A LD A,(DE)     ; Fetch the next character code.
 $B53B INC DE        ; Move on.
 $B53C INC L         ; Move on to the next column.
 $B53D BIT 7,A       ; Test whether it was the last character of the text.
 $B53F JR Z,$B539    ; Loop back until the whole row has been coloured.
 $B541 POP HL        ; Restore the attribute address.
 $B542 LD DE,$0020   ; {Move down to the next row.
 $B545 ADD HL,DE     ; }
 $B546 POP DE        ; Restore the pointer to the text.
 $B547 DJNZ $B537    ; Loop back to colour the second row.
 $B549 POP HL        ; Restore the position.
 $B54A CALL $BD4B    ; Find the screen address using #R$BD4B.
@label=PrintDoubleHeightText_Character
*$B54D LD A,(DE)     ; Fetch the next character code.
 $B54E BIT 7,A       ; {Jump to #R$B50A to print the last character.
 $B550 JP NZ,$B50A   ; }
 $B553 CALL $B50A    ; Print the character using #R$B50A.
 $B556 JR $B54D      ; Jump back to print the next character.

; Next Pixel Row
;
; Used by the routines at #R$9E55 and #R$B50A.
; .
; Moves down by one pixel row in the display file.
;
;   HL Screen address
; O:HL Screen address one pixel row down
@label=NextPixelRow
c$B558 INC H         ; Move down one pixel row within the character.
 $B559 LD A,H        ; {Test whether that has moved into the next character
 $B55A AND $07       ; row.}
 $B55C RET NZ        ; Return if it has not.
 $B55D LD A,H        ; {Move back to the top pixel row of the character.
 $B55E SUB $08       ;
 $B560 LD H,A        ; }
 $B561 LD A,L        ; {Move down by one character row.
 $B562 ADD A,$20     ;
 $B564 LD L,A        ; }
 $B565 RET NC        ; Return if that did not move into the next third of the
                     ; display.
 $B566 LD A,H        ; {Otherwise move on to the next third.
 $B567 ADD A,$08     ;
 $B569 LD H,A        ; }
 $B56A RET           ; Return.

; Print Hi-Score
;
; Used by the routines at #R$98D0, #R$9A4B and #R$B970.
; .
; Prints the hi-score in big digits, in the panel on the right of the
; screen. The hi-score is the first entry in the table of high scores at
; #R$B7C6.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$98E0,stop=$98EC,clear=1,sp=$5E00)
; #SIM(start=$98EC,stop=$98EF)
; #SIM(start=$98EF,stop=$98F2)
; #SIM(start=$98F2,stop=$98F5)
; #SCR$02(print-hiscore-before)
; | #SIM(start=$98F5,stop=$98F8)
; #SCR$02(print-hiscore-after) } UDGTABLE# #POPS
@label=PrintHiScore
c$B56B LD HL,$40D9   ; Point #REGhl at the display file position of the
                     ; hi-score.
 $B56E LD DE,$B7C6   ; Point #REGde at #R$B7C6.
 $B571 JR $B58B      ; Print it using #R$B58B.

; Add Points To Score
;
; Used by the routines at #R$A36C, #R$A5A7 and #R$ADB2.
; .
; Adds points to the score of the player and then prints the new score.
; The score is stored as six decimal digits in three bytes.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$98E0,stop=$98EC,clear=1,sp=$5E00)
; #SIM(start=$98EC,stop=$98EF)
; #SIM(start=$98EF,stop=$98F2)
; #SIM(start=$98F2,stop=$98F5)
; #SIM(start=$98F5,stop=$98F8)
; #SCR$02(add-points-before)
; | #SIM(start=$B573,stop=$B5CA,bc=$0550)
; #SCR$02(add-points-after) } UDGTABLE# #POPS
;
; B Points to add (the hundreds and thousands digits)
; C Points to add (the units and tens digits)
@label=AddPointsToScore
c$B573 LD HL,$961D   ; Point #REGhl at the least significant byte of the score.
 $B576 LD A,(HL)     ; {Add the units and tens.
 $B577 ADD A,C       ;
 $B578 DAA           ; }
 $B579 LD (HL),A     ; Store the result.
 $B57A DEC HL        ; Move on to the middle byte of the score.
 $B57B LD A,(HL)     ; {Add the hundreds and thousands, plus the carry.
 $B57C ADC A,B       ;
 $B57D DAA           ; }
 $B57E LD (HL),A     ; Store the result.
 $B57F DEC HL        ; Move on to the most significant byte of the score.
 $B580 LD A,(HL)     ; {Add the carry.
 $B581 ADC A,$00     ;
 $B583 DAA           ; }
 $B584 LD (HL),A     ; Store the result.
; View the equivalent code in;
; #LIST
; { #TRANZAM$6046 }
; LIST#
; .
; Continue on to #R$B585.

; Print Score
;
; Used by the routines at #R$98D0, #R$9A4B and #R$B72B.
; .
; Prints the score of the player in big digits, in the panel on the right
; of the screen.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$98E0,stop=$98EC,clear=1,sp=$5E00)
; #SIM(start=$98EC,stop=$98EF)
; #SIM(start=$98EF,stop=$98F2)
; #SCR$02(print-score-before)
; | #SIM(start=$98F2,stop=$98F5)
; #SCR$02(print-score-after) } UDGTABLE# #POPS
@label=PrintScore
c$B585 LD HL,$4059   ; Point #REGhl at the display file position of the score.
 $B588 LD DE,$961B   ; Point #REGde at #R$961B.
; This entry point is used by the routine at #R$B56B.
@label=PrintScore_Digits
*$B58B LD B,$03      ; There are #N$03 bytes of the number to print, which makes six
                     ; digits.
 $B58D JR $B5AF      ; Print the number using #R$B5AF.

; Print Small Number
;
; Used by the routine at #R$B78C.
; .
; Prints a number stored as three BCD bytes using the normal character
; set, which is used in the hall of fame.
;
;   DE Address of the number
;   HL Screen address
; O:DE Address after the number
; O:HL Screen address after the number
@label=PrintSmallNumber
c$B58F PUSH HL       ; Save the screen address.
 $B590 LD HL,($5C36) ; Fetch the address of the character set.
 $B593 LD ($9618),HL ; Use it as the current character set.
 $B596 POP HL        ; Restore the screen address.
@label=PrintSmallNumber_Byte
*$B597 LD A,(DE)     ; Fetch a byte of the number.
 $B598 RRCA          ; {Move the tens digit down into the bottom four bits.
 $B599 RRCA          ;
 $B59A RRCA          ;
 $B59B RRCA          ; }
 $B59C AND $0F       ; Keep only that digit.
 $B59E ADD A,$30     ; Convert it to the character code of the digit.
 $B5A0 CALL $B5CB    ; Print it using #R$B5CB.
 $B5A3 LD A,(DE)     ; Fetch the byte again.
 $B5A4 AND $0F       ; Keep only the units digit.
 $B5A6 ADD A,$30     ; Convert it to the character code of the digit.
 $B5A8 CALL $B5CB    ; Print it.
 $B5AB INC DE        ; Move on to the next byte of the number.
 $B5AC DJNZ $B597    ; Loop back until all of the bytes have been printed.
 $B5AE RET           ; Return.

; Print Big Number
;
; Used by the routine at #R$B585.
; .
; Prints a number stored as BCD bytes using big digits, which are two
; characters tall.
;
;   B Number of bytes of the number
;   DE Address of the number
;   HL Screen address
; O:DE Address after the number
@label=PrintBigNumber
c$B5AF PUSH HL       ; Save the screen address.
 $B5B0 LD HL,$6003   ; Point #REGhl at #R$6003.
 $B5B3 LD ($9618),HL ; Use them as the current character set.
 $B5B6 POP HL        ; Restore the screen address.
@label=PrintBigNumber_Byte
*$B5B7 LD A,(DE)     ; Fetch a byte of the number.
 $B5B8 RRCA          ; {Move the upper digit down into the bottom four bits.
 $B5B9 RRCA          ;
 $B5BA RRCA          ;
 $B5BB RRCA          ; }
 $B5BC AND $0F       ; Keep only that digit.
 $B5BE CALL $B4F8    ; Print it using #R$B4F8.
 $B5C1 LD A,(DE)     ; Fetch the byte again.
 $B5C2 AND $0F       ; Keep only the lower digit.
 $B5C4 CALL $B4F8    ; Print it.
 $B5C7 INC DE        ; Move on to the next byte of the number.
 $B5C8 DJNZ $B5B7    ; Loop back until every byte has been printed.
 $B5CA RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$BA62 }
; { #NIGHTSHADE$C314 }
; { #PENTAGRAM$BB48 }
; LIST#

; Print Character
;
; Used by the routines at #R$9C88, #R$B4E6, #R$B4F8, #R$B58F, #R$B696, #R$B6A6,
; #R$B78C, #R$BA19 and #R$BD99.
; .
; Prints a single character to the display file, at a character position.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$98E0,stop=$98EC,clear=1,sp=$5E00)
; #SIM(start=$98EC,stop=$98EF)
; #SIM(start=$98EF,stop=$98F2)
; #SIM(start=$98F2,stop=$98F5)
; #SIM(start=$98F5,stop=$98F8)
; #POKES$5C36,$00;$5C37,$3C;$9618,$00
; #POKES$9619,$3C
; #SIM(start=$9901,stop=$9904)
; #SCR$02(print-character-before)
; | #SIM(start=$B5CB,stop=$B5EA,a=$004D,hl=$480E)
; #SCR$02(print-character-after) } UDGTABLE# #POPS
;
;   A Character code
;   HL Screen address
; O:HL Screen address of the next column
@label=PrintScreen
c$B5CB PUSH BC       ; {Save the registers.
 $B5CC PUSH DE       ;
 $B5CD PUSH HL       ; }
 $B5CE LD L,A        ; {Multiply the character code by #N($08), using doubling.
 $B5CF LD H,$00      ;
 $B5D1 ADD HL,HL     ;
 $B5D2 ADD HL,HL     ;
 $B5D3 ADD HL,HL     ; }
 $B5D4 LD DE,($9618) ; {Add the address of the current character set.
 $B5D8 ADD HL,DE     ; }
 $B5D9 EX DE,HL      ; Point #REGde at the graphics of the character.
 $B5DA POP HL        ; Restore the screen address.
 $B5DB LD B,$08      ; There are #N$08 pixel rows in a character.
@label=PrintScreen_Row
*$B5DD LD A,(DE)     ; Fetch a pixel row of the character.
 $B5DE LD (HL),A     ; Write it to the screen.
 $B5DF INC DE        ; Move on to the next pixel row of the character.
 $B5E0 INC H         ; Move down to the next pixel row on the screen.
 $B5E1 DJNZ $B5DD    ; Loop back until the whole character has been printed.
 $B5E3 POP DE        ; {Restore the registers.
 $B5E4 POP BC        ; }
 $B5E5 LD A,H        ; {Move back up to the top of the character.
 $B5E6 SUB $08       ;
 $B5E8 LD H,A        ; }
 $B5E9 INC L         ; Move on to the next column.
 $B5EA RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$A1D3 }
; { #COOKIE$7468 }
; { #JETPAC$714C }
; { #LUNARJETMAN$89EF }
; { #NIGHTSHADE$CB19 }
; { #PSSST$73CD }
; { #SABREWULF$B589 }
; { #TRANZAM$6C96 }
; { #UNDERWURLDE$98DF }
; LIST#

; Draw Border
;
; Used by the routines at #R$98D0 and #R$B6FD.
; .
; Draws the decorative frame that surrounds the play window and the screen
; text: two rings of beads, one inside the other, each made of two characters
; that alternate. The frame is #N$18 characters wide and #N$18 characters tall,
; and the attributes are bright blue.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$98E0,stop=$98EC,clear=1,sp=$5E00)
; #SCR$02(draw-border-before)
; | #SIM(start=$98EC,stop=$98EF)
; #SCR$02(draw-border-after) } UDGTABLE# #POPS
@label=DrawBorder
c$B5EB LD HL,$9401   ; Point #REGhl at the border graphics.
 $B5EE LD ($9618),HL ; Use them as the current character set.
; Draw the outer ring of beads, which uses characters #N$00 and #N$01.
 $B5F1 LD HL,$4000   ; Point #REGhl at the top left of the display file.
 $B5F4 LD BC,$1800   ; The top row is #N$18 characters wide (#REGb) and starts with
                     ; character #N$01 (#REGc).
 $B5F7 CALL $B6A6    ; Draw the top row using #R$B6A6.
 $B5FA LD HL,$50E0   ; Point #REGhl at the start of the bottom row, in the last character
                     ; row.
 $B5FD LD BC,$1801   ; The bottom row is #N$18 characters wide (#REGb) and starts with
                     ; character #N$00 (#REGc).
 $B600 CALL $B6A6    ; Draw the bottom row.
 $B603 LD HL,$4020   ; Point #REGhl at the left column, on the second character
                     ; row.
 $B606 LD BC,$1601   ; The column is #N$16 characters tall (#REGb) and starts with
                     ; character #N$00 (#REGc).
 $B609 CALL $B696    ; Draw the left column using #R$B696.
 $B60C LD HL,$4037   ; Point #REGhl at the right column, on the second
                     ; character row.
 $B60F LD BC,$1600   ; The column is #N$16 characters tall (#REGb) and starts with
                     ; character #N$01 (#REGc).
 $B612 CALL $B696    ; Draw the right column.
; Draw the inner ring of beads, which uses characters #N$02 and #N$03.
 $B615 LD HL,$4021   ; Point #REGhl at the start of the second character row, one column
                     ; in.
 $B618 LD BC,$1602   ; The row is #N$16 characters long (#REGb) and starts with character
                     ; #N$03 (#REGc).
 $B61B CALL $B6A6    ; Draw the second row.
 $B61E LD HL,$50C1   ; Point #REGhl at the start of the last but one character row, one
                     ; column in.
 $B621 LD B,$16      ; The row is #N$16 characters long.
 $B623 CALL $B6A6    ; Draw it.
 $B626 LD HL,$4041   ; Point #REGhl at the second column, on the third
                     ; character row.
 $B629 LD B,$14      ; The column is #N$14 characters tall.
 $B62B CALL $B696    ; Draw it using #R$B696.
 $B62E LD HL,$4056   ; Point #REGhl at the second to last column, on the third character
                     ; row.
 $B631 LD B,$14      ; The column is #N$14 characters tall.
 $B633 CALL $B696    ; Draw it.
; Colour the frame.
 $B636 LD A,$48      ; Use #N$48 (bright, black ink on blue paper) for the top left and
                     ; bottom left corners.
 $B638 LD ($5800),A  ; Write the attribute to the top left corner.
 $B63B LD ($5AE0),A  ; Write the attribute to the bottom left corner.
 $B63E LD A,$41      ; Use #N$41 (bright, blue ink on black paper) for the top right and
                     ; bottom right corners.
 $B640 LD ($5817),A  ; Write the attribute to the top right corner.
 $B643 LD ($5AF7),A  ; Write the attribute to the bottom right corner.
 $B646 LD HL,$5801   ; Point #REGhl at the top row, after the corner.
 $B649 LD BC,$1649   ; The row is #N$16 attributes long (#REGb) and the attribute is #N$49
                     ; (bright, blue ink on blue paper) (#REGc).
 $B64C CALL $B689    ; Colour the top row using #R$B689.
 $B64F LD HL,$5AE1   ; Point #REGhl at the bottom row, after the corner.
 $B652 LD B,$16      ; The row is #N$16 attributes long.
 $B654 CALL $B689    ; Colour the bottom row.
 $B657 LD HL,$5820   ; Point #REGhl at the left column, below the corner.
 $B65A LD B,$16      ; The column is #N$16 attributes tall.
 $B65C CALL $B68E    ; Colour the left column using #R$B68E.
 $B65F LD HL,$5837   ; Point #REGhl at the right column, below the corner.
 $B662 LD B,$16      ; The column is #N$16 attributes tall.
 $B664 CALL $B68E    ; Colour the right column.
 $B667 LD HL,$5821   ; Point #REGhl at the second row, one column in.
 $B66A LD BC,$1648   ; The row is #N$16 attributes long (#REGb) and the attribute is #N$48
                     ; (#REGc).
 $B66D CALL $B689    ; Colour the second row.
 $B670 LD HL,$5AC1   ; Point #REGhl at the last but one row, one column in.
 $B673 LD B,$16      ; The row is #N$16 attributes long.
 $B675 CALL $B689    ; Colour it.
 $B678 LD HL,$5841   ; Point #REGhl at the second column, on the third row.
 $B67B LD B,$14      ; The column is #N$14 attributes tall.
 $B67D CALL $B68E    ; Colour it.
 $B680 LD HL,$5856   ; Point #REGhl at the second to last column, on the third
                     ; row.
 $B683 LD B,$14      ; The column is #N$14 attributes tall.
 $B685 CALL $B68E    ; Colour it.
 $B688 RET           ; Return.

; Fill Attribute Row
;
; Used by the routines at #R$B5EB and #R$BBAA.
; .
; Writes an attribute to a run of cells along a row of the attribute file.
;
; HL Address of the first cell
; B Number of cells
; C Attribute
@label=FillAttributeRow
c$B689 LD (HL),C     ; Write the attribute.
 $B68A INC HL        ; Move on to the next cell.
 $B68B DJNZ $B689    ; Loop back until all of the cells have been filled.
 $B68D RET           ; Return.

; Fill Attribute Column
;
; Used by the routine at #R$B5EB.
; .
; Writes an attribute to a run of cells down a column of the attribute
; file.
;
; HL Address of the first cell
; B Number of cells
; C Attribute
@label=FillAttributeColumn
c$B68E LD DE,$0020   ; Set the distance to the next row to #N$20.
@label=FillAttributeColumn_Loop
*$B691 LD (HL),C     ; Write the attribute.
 $B692 ADD HL,DE     ; Move down to the next row.
 $B693 DJNZ $B691    ; Loop back until all of the cells have been filled.
 $B695 RET           ; Return.

; Print Border Column
;
; Used by the routine at #R$B5EB.
; .
; Prints a column of border characters, alternating between two
; characters.
;
; HL Screen address of the top
; B Number of characters
; C Character code (bit 0 is flipped each time)
@label=PrintBorderColumn
c$B696 LD A,C        ; Fetch the character code.
 $B697 XOR $01       ; Switch to the other character of the pair.
 $B699 LD C,A        ; Keep it.
 $B69A PUSH BC       ; Save the counters.
 $B69B CALL $B5CB    ; Print the character using #R$B5CB.
 $B69E DEC L         ; Move back to the column of the character.
 $B69F CALL $B6B2    ; Move down to the next character row using #R$B6B2.
 $B6A2 POP BC        ; Restore the counters.
 $B6A3 DJNZ $B696    ; Loop back until the whole column has been printed.
 $B6A5 RET           ; Return.

; Print Border Row
;
; Used by the routines at #R$B5EB and #R$BBAA.
; .
; Prints a row of border characters, alternating between two characters.
;
; HL Screen address of the left end
; B Number of characters
; C Character code (bit 0 is flipped each time)
@label=PrintBorderRow
c$B6A6 LD A,C        ; Fetch the character code.
 $B6A7 XOR $01       ; Switch to the other character of the pair.
 $B6A9 LD C,A        ; Keep it.
 $B6AA PUSH BC       ; Save the counters.
 $B6AB CALL $B5CB    ; Print the character using #R$B5CB.
 $B6AE POP BC        ; Restore the counters.
 $B6AF DJNZ $B6A6    ; Loop back until the whole row has been printed.
 $B6B1 RET           ; Return.

; Move Down Row
;
; Used by the routines at #R$B4E6, #R$B4F8 and #R$B696.
; .
; Moves down by one character row in the display file.
;
;   HL Screen address
; O:HL Screen address one character row down
@label=MoveDownRow
c$B6B2 LD A,L        ; {Add #N$20 to the low byte of the address.
 $B6B3 ADD A,$20     ;
 $B6B5 LD L,A        ; }
 $B6B6 RET NC        ; Return if that did not move into the next third of the
                     ; display.
 $B6B7 LD A,H        ; {Otherwise move on to the next third.
 $B6B8 ADD A,$08     ;
 $B6BA LD H,A        ; }
 $B6BB RET           ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$D64F }
; { #NIGHTSHADE$CB71 }
; { #UNDERWURLDE$98D5 }
; LIST#

; Lose Life
;
; Used by the routine at #R$A713.
; .
; Called when the robot has been destroyed. If there are no lives left
; then the game is over. Otherwise a life is taken away, the battery is
; recharged and the robot starts to materialise again.
;
; IX Pointer to the robot (entity #N$00)
@label=LoseLife
c$B6BC LD A,($961A)    ; This load has no effect, as #REGa is replaced
                       ; immediately.
 $B6BF LD A,($968B)    ; Fetch the number of lives left.
 $B6C2 AND A           ; Test whether there are any.
 $B6C3 JP Z,$9AA5      ; Jump to #R$9AA5 if there are none, as the game is
                       ; over.
; See #POKE(infinite_lives,Infinite Lives).
 $B6C6 LD HL,$968B     ; Point #REGhl at #R$968B.
 $B6C9 DEC (HL)        ; Take away a life.
 $B6CA CALL $A091      ; Recharge the battery and show the number of lives left using
                       ; #R$A091.
 $B6CD LD (IX+$00),$40 ; Set the type of the robot to #N($40), the start of the sequence of
                       ; sprites that shows it materialising.
 $B6D1 RET             ; Return.

; Show Game Over
;
; Used by the routine at #R$B6FD.
; .
; Clears the play window and shows "GAME  OVER" followed by the number of
; the player, then waits for a while.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$98E0,stop=$98EC,clear=1,sp=$5E00)
; #SIM(start=$98EC,stop=$98EF)
; #SIM(start=$98EF,stop=$98F2)
; #SIM(start=$98F2,stop=$98F5)
; #SIM(start=$98F5,stop=$98F8)
; #POKES$5C36,$00;$5C37,$3C
; #SCR$02(game-over-before)
; | #SIM(start=$B6D2,stop=$B6EA)
; #SCR$02(game-over-after) } UDGTABLE# #POPS
@label=ShowGameOver
c$B6D2 LD A,$B1      ; Use the "1" of "PLAYER 1" as the last character of the
                     ; text.
@label=ShowGameOver_Player
*$B6D4 LD ($B72A),A  ; Write it as the last character of the second text
                     ; message.
 $B6D7 XOR A         ; Use black as the attribute.
 $B6D8 CALL $B217    ; Clear the play window to black using #R$B217.
 $B6DB LD DE,$B717   ; Point #REGde at #R$B717.
 $B6DE LD HL,$4038   ; Point #REGhl at the position of the message (x position #N($38), y
                     ; position #N$40).
 $B6E1 CALL $BD99    ; Print it using #R$BD99.
 $B6E4 LD HL,$5040   ; Point #REGhl at the position of the second message (x position
                     ; #N($40), y position #N$50).
 $B6E7 CALL $BD99    ; Print "PLAYER 1" using #R$BD99.
 $B6EA LD B,$08      ; {Delay for #N$08 times #N$010000 iterations.
 $B6EC LD HL,$0000   ; }
 $B6EF CALL $BD32    ; Delay using #R$BD32.
 $B6F2 LD A,$47      ; Use bright white on black as the attribute.
 $B6F4 JP $B1C2      ; Jump to #R$B1C2.
; This entry point is not used. It shows "PLAYER 2" instead.
@label=ShowGameOver_Player2
 $B6F7 LD A,$B2      ; Use the "2" of "PLAYER 2" as the last character of the
                     ; text.
 $B6F9 JR $B6D4      ; Jump to #R$B6D4.
; This entry point is not used.
@label=ShowGameOver_Unused
 $B6FB JR $B6D2      ; Jump to #R$B6D2.
; The entry point at #R$B6F7 would show "PLAYER 2". It is not used, and
; nor is #R$B6FB, as the game only has a single player.

; Game Over
;
; Used by the routine at #R$9A22.
; .
; Ends the game. The game over message is shown and then the high score
; table is updated. If the player has earned a place in the table the hall of
; fame is shown, and then the game restarts from the title screen.
;
; .
;
; Show the game over message.
@label=GameOver
c$B6FD CALL $B6D2    ; Show the game over message using #R$B6D2.
 $B700 CALL $B5EB    ; Draw the border around the screen using #R$B5EB.
 $B703 LD A,$47      ; Use bright white on black as the attribute.
 $B705 CALL $B212    ; Clear the large window using #R$B212.
; Update the high score table.
 $B708 CALL $B958    ; Insert the score into the high score table, if it is high enough,
                     ; using #R$B958.
 $B70B LD A,($9633)  ; Fetch the flag that is set if a name was entered in the
                     ; table.
 $B70E AND A         ; Test whether it is set.
 $B70F JR Z,$B714    ; Jump to #R$B714 if not.
 $B711 CALL $B76C    ; Show the hall of fame using #R$B76C.
; Go back to the title screen.
@label=GameOver_Title
*$B714 JP $98EF      ; Jump to #R$98EF to go back to the title screen.

; Messaging: Game Over
;
; The text of the game over message. Each message starts with an attribute
; byte and its last character has bit 7 set. The number of the player in the
; second message is modified by #R$B6D4.
@label=Message_GameOver
t$B717 DEFM $47                 ; {Attribute: #COLOUR(#PEEK(#PC)) + "GAME
 $B718 DEFM "GAME  OVE","R"+$80 ; OVER".}
@label=Message_Player
 $B722 DEFM $47                 ; {Attribute: #COLOUR(#PEEK(#PC)) + "PLAYER " and the
 $B723 DEFM "PLAYER ","1"+$80   ; number of the player.}

; Start Game
;
; Used by the routine at #R$98D0.
; .
; Starts a new game. The lives are set, the play window is cleared, the
; robot starts its first life and both scores are cleared.
@label=StartGame
c$B72B CALL $B74D    ; Set the number of lives using #R$B74D.
 $B72E LD A,$80      ; {Set a variable that is never used to #N$80.
 $B730 LD ($968C),A  ; }
 $B733 LD A,$46      ; {Clear the play window to bright cyan on black using
 $B735 CALL $B217    ; #R$B217.}
 $B738 CALL $A99F    ; Start the first life using #R$A99F.
 $B73B LD HL,$961B   ; Point #REGhl at #R$961B.
 $B73E LD B,$06      ; There are six bytes to clear.
@label=StartGame_Clear
*$B740 LD (HL),$00   ; Clear a byte of the scores.
 $B742 INC HL        ; Move on to the next byte.
 $B743 DJNZ $B740    ; Loop back until both scores have been cleared.
 $B745 CALL $B585    ; Print the score using #R$B585.
 $B748 XOR A         ; Clear the displayed battery level...
 $B749 LD ($963C),A  ; ...so that the battery bar is redrawn from the start.
 $B74C RET           ; Return.

; Reset Lives
;
; Used by the routine at #R$B72B.
; .
; Gives the player five lives, and sets the robot to face its starting
; direction.
@label=ResetLives
c$B74D LD A,$05      ; {Set the number of lives to five.
 $B74F LD ($968B),A  ; }
 $B752 XOR A         ; {Clear the number of the player.
 $B753 LD ($968A),A  ; }
 $B756 JP $A127      ; Jump to #R$A127.

; Reset Idle Timer
;
; Used by the routines at #R$B760 and #R$B76C.
; .
; Sets the timer that is used to show the hall of fame while the menu is
; being shown.
@label=ResetIdleTimer
c$B759 LD HL,$0300   ; Use a timer of #N$0300 frames...
 $B75C LD ($9630),HL ; ...and store it.
 $B75F RET           ; Return.

; Update Idle Timer
;
; Used by the routine at #R$BB12.
; .
; Counts down the idle timer. If it reaches zero then the hall of fame is
; shown, until a key is pressed. The timer is reset if the zero flag is not set
; when this routine is called.
;
; F The zero flag is reset to reset the timer
@label=UpdateIdleTimer
c$B760 JR NZ,$B759   ; Jump to reset the timer if the zero flag is not set.
 $B762 LD HL,($9630) ; Fetch the timer...
 $B765 DEC HL        ; ...take one off...
 $B766 LD ($9630),HL ; ...and store it.
 $B769 LD A,H        ; {Return if the timer has not reached zero.
 $B76A OR L          ;
 $B76B RET NZ        ; }
; Continue on to #R$B76C.
; .
; View the equivalent code in;
; #LIST
; { #SABREWULF$B272 }
; LIST#

; Handler: Hall Of Fame
;
; Used by the routine at #R$B6FD.
; .
; Shows the hall of fame, and waits for a key to be pressed or for a delay
; to run out. Then the menu is drawn again.
@label=HandlerHallOfFame
c$B76C CALL $B78C    ; Draw the hall of fame using #R$B78C.
 $B76F LD B,$0C      ; Wait for up to twelve times #N$010000 iterations...
 $B771 LD HL,$0000   ; Start the inner count at #N$0000.
@label=HandlerHallOfFame_Wait
*$B774 XOR A         ; Read every row of keys...
 $B775 CALL $C0AB    ; Read the keyboard.
 $B778 AND $1F       ; {...and jump to finish if any key is pressed.
 $B77A JR NZ,$B783   ; }
 $B77C DEC HL        ; Count down the delay.
 $B77D LD A,H        ; {Loop back until the count has run out...
 $B77E OR L          ;
 $B77F JR NZ,$B774   ; }
 $B781 DJNZ $B774    ; ...and the outer count too.
@label=HandlerHallOfFame_Finish
*$B783 XOR A         ; Clear the large window to black using #R$B212.
 $B784 CALL $B212    ; Clear the large window.
 $B787 CALL $B8B3    ; Draw the menu using #R$B8B3.
 $B78A JR $B759      ; Jump to reset the idle timer.
; View the equivalent code in;
; #LIST
; { #SABREWULF$B272 }
; LIST#

; Show Hall Of Fame
;
; Used by the routine at #R$B76C.
; .
; Draws the hall of fame: the heading, the eight places of the table, and
; the score and the three letters of the name for each of them.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$98E0,stop=$98EC,clear=1,sp=$5E00)
; #SIM(start=$98EC,stop=$98EF)
; #SIM(start=$98EF,stop=$98F2)
; #SIM(start=$98F2,stop=$98F5)
; #SIM(start=$98F5,stop=$98F8)
; #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$9901,stop=$9904)
; #SCR$02(hall-of-fame-before)
; | #SIM(start=$B76C,stop=$B76F)
; #SCR$02(hall-of-fame-after) } UDGTABLE# #POPS
@label=HallOfFame
c$B78C XOR A         ; Clear the large window to black using #R$B212.
 $B78D CALL $B212    ; Clear the large window.
 $B790 LD DE,$B7FC   ; Point #REGde' at #R$B7FC.
 $B793 EXX           ; Switch that address into #REGde'.
 $B794 LD HL,$B805   ; Point #REGhl at #R$B805.
 $B797 LD DE,$B817   ; Point #REGde at #R$B817.
 $B79A LD B,$09      ; There are nine lines of text.
 $B79C CALL $B8CE    ; Print the heading and the places using #R$B8CE.
 $B79F LD BC,$0308   ; There are eight rows of scores...
 $B7A2 LD DE,$B7C6   ; ...in the table of the high scores.
 $B7A5 LD HL,$3048   ; Point #REGhl at the coordinates of the first row.
@label=HallOfFame_Loop
*$B7A8 PUSH BC       ; Save the counter...
 $B7A9 PUSH HL       ; ...and the coordinates.
 $B7AA CALL $BD4B    ; Find the screen address using #R$BD4B.
 $B7AD CALL $B58F    ; Print the score using #R$B58F.
 $B7B0 LD B,$03      ; There are three letters in a name.
 $B7B2 INC L         ; {Move on three characters to the right.
 $B7B3 INC L         ;
 $B7B4 INC L         ; }
@label=HallOfFame_Initials
*$B7B5 LD A,(DE)     ; Fetch a letter of the name...
 $B7B6 INC DE        ; ...and move on to the next one.
 $B7B7 CALL $B5CB    ; Print it using #R$B5CB.
 $B7BA DJNZ $B7B5    ; Loop back until all three letters have been printed.
 $B7BC POP HL        ; Restore the coordinates.
 $B7BD LD A,H        ; Fetch the Y coordinate...
 $B7BE ADD A,$10     ; ...move down by #N$10 pixels...
 $B7C0 LD H,A        ; ...and keep it.
 $B7C1 POP BC        ; Restore the counter.
 $B7C2 DEC C         ; Count down the rows.
 $B7C3 JR NZ,$B7A8   ; Loop back until all eight rows have been printed.
 $B7C5 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #SABREWULF$B29F }
; LIST#

; Hall Of Fame Table
;
; The eight places of the hall of fame. Each place is the score, which is
; three bytes of binary coded decimal, followed by the three letters of the
; name. The first entry is also the hi-score that is shown in the panel. The
; last six bytes are the work area that is used by #R$B958.
@label=HallOfFameTable
g$B7C6 DEFB $10,$22,$75,$55,$4C,$54 ; {Score and name.
 $B7CC DEFB $05,$51,$50,$41,$43,$47 ;
 $B7D2 DEFB $03,$78,$95,$20,$20,$20 ;
 $B7D8 DEFB $02,$43,$20,$20,$20,$20 ;
 $B7DE DEFB $01,$27,$75,$20,$20,$20 ;
 $B7E4 DEFB $00,$82,$50,$20,$20,$20 ;
 $B7EA DEFB $00,$00,$00,$20,$20,$20 ;
@label=HallOfFameTable_LastPlace
 $B7F0 DEFB $00,$00,$00,$20,$20,$20 ; }
@label=HallOfFameWork
 $B7F6 DEFB $00,$00,$00,$20,$20,$20 ; Work area.

; Messaging: Hall Of Fame Text
;
; The attributes, coordinates and text of the hall of fame, for #R$B8CE.
@label=HallOfFame_Attributes
t$B7FC DEFB $47                         ; #COLOUR(#PEEK(#PC)).
 $B7FD DEFB $47                         ; #COLOUR(#PEEK(#PC)).
 $B7FE DEFB $47                         ; #COLOUR(#PEEK(#PC)).
 $B7FF DEFB $46                         ; #COLOUR(#PEEK(#PC)).
 $B800 DEFB $46                         ; #COLOUR(#PEEK(#PC)).
 $B801 DEFB $45                         ; #COLOUR(#PEEK(#PC)).
 $B802 DEFB $45                         ; #COLOUR(#PEEK(#PC)).
 $B803 DEFB $43                         ; #COLOUR(#PEEK(#PC)).
 $B804 DEFB $43                         ; #COLOUR(#PEEK(#PC)).
@label=HallOfFame_Coordinates
 $B805 DEFB $30,$18                     ; {Coordinates of the nine lines of
 $B807 DEFB $18,$30                     ; text.
 $B809 DEFB $18,$40                     ;
 $B80B DEFB $18,$50                     ;
 $B80D DEFB $18,$60                     ;
 $B80F DEFB $18,$70                     ;
 $B811 DEFB $18,$80                     ;
 $B813 DEFB $18,$90                     ;
 $B815 DEFB $18,$A0                     ; }
@label=HallOfFame_Heading
 $B817 DEFM "HALL OF FAM","E"+$80       ; "HALL OF FAME".
@label=HallOfFame_Places
 $B823 DEFM "1ST              "," "+$80 ; "1ST" and spaces, where the name will
                                        ; be shown.
 $B835 DEFM "2ND              "," "+$80 ; "2ND" and spaces.
 $B847 DEFM "3RD              "," "+$80 ; "3RD" and spaces.
 $B859 DEFM "4TH              "," "+$80 ; "4TH" and spaces.
 $B86B DEFM "5TH              "," "+$80 ; "5TH" and spaces.
 $B87D DEFM "6TH              "," "+$80 ; "6TH" and spaces.
 $B88F DEFM "7TH              "," "+$80 ; "7TH" and spaces.
 $B8A1 DEFM "8TH              "," "+$80 ; "8TH" and spaces.

; Display Menu
;
; Used by the routines at #R$B76C, #R$BB12 and #R$BB86.
; .
; Draws the title and the menu, which shows the keys that choose the
; method of control and the key that starts the game. It also keeps a copy of
; the pointer to the character set.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$98E0,stop=$98EC,clear=1,sp=$5E00)
; #SIM(start=$98EC,stop=$98EF)
; #SIM(start=$98EF,stop=$98F2)
; #SIM(start=$98F2,stop=$98F5)
; #SIM(start=$98F5,stop=$98F8)
; #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$9901,stop=$9904)
; #SCR$02(game-menu-before)
; | #SIM(start=$B8B3,stop=$B8E4)
; #SCR$02(game-menu-after) } UDGTABLE#
; #HTML(<div hidden>)
; #SCR$02,$00,$00,$18,$18(screen-frame)
; #HTML(</div>)
; #POPS
@label=DisplayMenu
c$B8B3 LD HL,($5C36) ; Fetch the address of the character set...
 $B8B6 LD ($9618),HL ; ...and keep it.
 $B8B9 LD HL,$1830   ; Point #REGhl at the coordinates of the title.
 $B8BC LD DE,$B8F7   ; Point #REGde at #R$B8F7.
 $B8BF CALL $B52E    ; Print it using #R$B52E.
 $B8C2 LD DE,$B8E5   ; Point #REGde' at #R$B8E5.
 $B8C5 EXX           ; Switch that address into #REGde'.
 $B8C6 LD HL,$B8EB   ; Point #REGhl at #R$B8EB.
 $B8C9 LD DE,$B903   ; ...and #REGde at the lines of text.
 $B8CC LD B,$06      ; There are six lines of text.
; View the equivalent code in;
; #LIST
; { #SABREWULF$B473 }
; LIST#

; Print Text List
;
; Used by the routines at #R$9A22, #R$9A4B, #R$9AA5, #R$B78C and #R$B970.
; .
; Prints a list of lines of text, each with its own attribute and
; coordinates.
;
; B Number of lines
; DE' Address of the attributes
; HL Address of the coordinates (X and Y in pixels, for each line)
; DE Address of the text
@label=PrintTextList
c$B8CE EXX           ; Switch to the attributes.
 $B8CF LD A,(DE)     ; Fetch the attribute...
 $B8D0 LD ($9628),A  ; ...and set it as the colour of the text.
 $B8D3 INC DE        ; Move on to the next attribute.
 $B8D4 EXX           ; Switch back to the text.
 $B8D5 PUSH BC       ; Save the counter.
 $B8D6 LD A,(HL)     ; Fetch the X coordinate.
 $B8D7 INC HL        ; {Move on to the next coordinates.
 $B8D8 INC HL        ; }
 $B8D9 PUSH HL       ; Save the address of the coordinates.
 $B8DA DEC HL        ; Go back to the Y coordinate...
 $B8DB LD H,(HL)     ; ...and fetch it.
 $B8DC LD L,A        ; Put the X coordinate in #REGl.
 $B8DD CALL $BD82    ; Print the text using #R$BD82.
 $B8E0 POP HL        ; Restore the address of the coordinates.
 $B8E1 POP BC        ; Restore the counter.
 $B8E2 DJNZ $B8CE    ; Loop back until all of the lines have been printed.
 $B8E4 RET           ; Return.

; Messaging: Menu Text
;
; The attributes, coordinates and text of the menu.
@label=Menu_Attributes
t$B8E5 DEFB $C5                       ; #COLOUR(#PEEK(#PC)).
 $B8E6 DEFB $45                       ; #COLOUR(#PEEK(#PC)).
 $B8E7 DEFB $45                       ; #COLOUR(#PEEK(#PC)).
 $B8E8 DEFB $45                       ; #COLOUR(#PEEK(#PC)).
 $B8E9 DEFB $47                       ; #COLOUR(#PEEK(#PC)).
 $B8EA DEFB $47                       ; #COLOUR(#PEEK(#PC)).
@label=Menu_Coordinates
 $B8EB DEFB $20,$38                   ; {Coordinates of the six lines of text.
 $B8ED DEFB $20,$48                   ;
 $B8EF DEFB $20,$58                   ;
 $B8F1 DEFB $20,$68                   ;
 $B8F3 DEFB $20,$80                   ;
 $B8F5 DEFB $30,$A0                   ; }
@label=Message_Title
 $B8F7 DEFM $47                       ; {Attribute: #COLOUR(#PEEK(#PC)) +
 $B8F8 DEFM "MARTIANOID","S"+$80      ; "MARTIANOIDS".}
@label=Menu_Text
 $B903 DEFM "1  KEYBOAR","D"+$80      ; "1  KEYBOARD".
 $B90E DEFM "2  KEMPSTON UNI","T"+$80 ; "2  KEMPSTON UNIT".
 $B91E DEFM "3  CURSOR   UNI","T"+$80 ; "3  CURSOR   UNIT".
 $B92E DEFM "4  INTERFACE I","I"+$80  ; "4  INTERFACE II".
 $B93D DEFM "0  START GAM","E"+$80    ; "0  START GAME".
 $B94A DEFM "@ 1987  A.C.G","."+$80   ; "@ 1987  A.C.G.".

; New High Score
;
; Used by the routine at #R$B6FD.
; .
; Puts the scores of the two players into the hall of fame, if they are
; high enough, starting with the higher of the two. If a score gets a place then
; the player is asked for their initials.
@label=NewHighScore
c$B958 LD HL,$961B   ; Point #REGhl at the score of player 1.
 $B95B LD DE,$961E   ; Point #REGde at #R$961E.
 $B95E CALL $B9EE    ; Compare the scores using #R$B9EE.
 $B961 LD A,$00      ; {Clear the flag that says that a name has been entered.
 $B963 LD ($9633),A  ; }
 $B966 JR Z,$B96C    ; Jump to insert player 1 first if the scores are the
                     ; same...
 $B968 JR C,$B96C    ; ...or if player 1 has the higher score.
 $B96A CPL           ; Otherwise swap the scores, so that the higher one is
                     ; first.
 $B96B EX DE,HL      ; Swap the two scores.
@label=NewHighScore_Process
*$B96C CALL $B970    ; Insert the first score using #R$B970.
 $B96F EX DE,HL      ; Swap the scores back, and insert the other one.
; View the equivalent code in;
; #LIST
; { #SABREWULF$B5FC }
; LIST#

; Enter High Score
;
; Used by the routine at #R$B958.
; .
; Inserts a score into the hall of fame. The scores of the places that are
; lower than the new score are moved down one place; then the new score is
; shown, and the player is asked for their initials.
;
; HL Address of the score
@label=NewHighScore_Enter
c$B970 PUSH DE       ; Save the address of the other score...
 $B971 PUSH HL       ; ...and the address of this score.
 $B972 LD B,$08      ; There are eight places in the table.
 $B974 LD DE,$B7F0   ; Start with the last place.
@label=NewHighScore_Enter_Compare
*$B977 CALL $B9EE    ; Compare the score of the place with the new score using
                     ; #R$B9EE.
 $B97A JR NC,$B981   ; Jump if the place has a score that is as high, or
                     ; higher.
 $B97C CALL $B9E7    ; Move up to the previous place using #R$B9E7.
 $B97F DJNZ $B977    ; Loop back until all of the places have been tried.
@label=NewHighScore_CountPlaces
*$B981 LD A,B        ; Fetch the number of places that the score is not as high
                     ; as.
 $B982 CP $08        ; {Jump to finish if it is not higher than the last place.
 $B984 JR Z,$B9E4    ; }
 $B986 LD HL,$B7F0   ; Point #REGhl at the last place.
 $B989 LD DE,$B7F6   ; Point #REGde at #R$B7F6.
 $B98C LD A,B        ; {Work out how many places the new score is higher
 $B98D NEG           ; than...
 $B98F ADD A,$08     ; }
 $B991 LD ($9634),A  ; ...and keep it.
@label=NewHighScore_Enter_Shift
*$B994 LD BC,$0006   ; Each place is six bytes.
 $B997 PUSH HL       ; Save the address of the place.
 $B998 LDIR          ; Copy the place down one place.
 $B99A POP DE        ; Restore the address of the place...
 $B99B LD L,E        ; {...and move it into #REGhl.
 $B99C LD H,D        ; }
 $B99D CALL $B9E7    ; Move #REGde up to the previous place using #R$B9E7.
 $B9A0 EX DE,HL      ; Swap the places, so that #REGhl is the previous place and #REGde is
                     ; the one to copy it to.
 $B9A1 DEC A         ; Count down the places.
 $B9A2 JR NZ,$B994   ; Loop back until the places have been moved.
 $B9A4 POP HL        ; Fetch the address of the new score...
 $B9A5 PUSH HL       ; ...and save it again.
 $B9A6 LD BC,$0003   ; The score is three bytes...
 $B9A9 LDIR          ; ...so copy it into the place.
 $B9AB PUSH DE       ; Save the address of the name.
 $B9AC CALL $B56B    ; Show the new hi-score using #R$B56B.
 $B9AF LD A,$01      ; {Set the flag that says that a name has been entered.
 $B9B1 LD ($9633),A  ; }
 $B9B4 XOR A         ; {Clear the large window to black using #R$B212.
 $B9B5 CALL $B212    ; }
 $B9B8 LD A,($9634)  ; Fetch the number of places that the score is higher
                     ; than...
 $B9BB LD B,A        ; ...and keep it in #REGb.
 $B9BC LD A,$FD      ; Start with an offset of minus three...
@label=NewHighScore_MultiplyPlaces
*$B9BE ADD A,$03     ; ...and add three for each place that the score is higher
                     ; than...
 $B9C0 DJNZ $B9BE    ; Count down the places.
 $B9C2 LD C,A        ; Keep the offset.
 $B9C3 LD B,$00      ; Clear the high byte of the offset.
 $B9C5 LD HL,$BA01   ; Point #REGhl at #R$BA01.
 $B9C8 ADD HL,BC     ; Add the offset.
 $B9C9 LD DE,$BAE1   ; Point #REGde at #R$BAE1.
 $B9CC LD BC,$0003   ; The name is three characters.
 $B9CF LDIR          ; Copy it into the message.
 $B9D1 LD DE,$BAA5   ; Point #REGde' at #R$BAA5.
 $B9D4 EXX           ; Switch that address into #REGde'.
 $B9D5 LD HL,$BAAC   ; Point #REGhl at #R$BAAC.
 $B9D8 LD DE,$BABA   ; Point #REGde at #R$BABA.
 $B9DB LD B,$07      ; There are seven lines.
 $B9DD CALL $B8CE    ; Print the message using #R$B8CE.
 $B9E0 POP DE        ; Restore the address of the name.
 $B9E1 CALL $BA19    ; Ask for the initials using #R$BA19.
@label=NewHighScore_Enter_Finish
*$B9E4 POP HL        ; Restore the address of the score.
 $B9E5 POP DE        ; Restore the address of the other score.
 $B9E6 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #SABREWULF$B61E }
; LIST#

; Previous High Score
;
; Used by the routine at #R$B970.
; .
; Moves an address back by one place of the hall of fame.
;
;   DE Address of a place
; O:DE Address of the previous place
@label=NewHighScore_Next
c$B9E7 DEC DE        ; {Take six bytes off the address.
 $B9E8 DEC DE        ;
 $B9E9 DEC DE        ;
 $B9EA DEC DE        ;
 $B9EB DEC DE        ;
 $B9EC DEC DE        ; }
 $B9ED RET           ; Return.
; View the equivalent code in;
; #LIST
; { #SABREWULF$B6AB }
; LIST#

; Compare Scores
;
; Used by the routines at #R$B958 and #R$B970.
; .
; Compares two scores, which are three bytes of binary coded decimal,
; starting with the most significant byte.
;
;   DE Address of the first score
;   HL Address of the second score
; O:F Carry set if the first is lower, zero set if they are equal
@label=NewHighScore_Compare
c$B9EE PUSH BC       ; {Save the registers.
 $B9EF PUSH DE       ;
 $B9F0 PUSH HL       ; }
 $B9F1 LD B,$03      ; There are three bytes to compare.
@label=NewHighScore_Compare_Loop
*$B9F3 LD A,(DE)     ; Fetch a byte of the first score.
 $B9F4 CP (HL)       ; {Jump if it is lower than the byte of the second score.
 $B9F5 JR C,$B9FD    ; }
 $B9F7 JR NZ,$B9FD   ; Jump if it is higher.
 $B9F9 INC HL        ; Move on to the next byte of the second score...
 $B9FA INC DE        ; ...and the first.
 $B9FB DJNZ $B9F3    ; Loop back until all of the bytes have been compared.
@label=NewHighScore_Compare_Return
*$B9FD POP HL        ; {Restore the registers.
 $B9FE POP DE        ;
 $B9FF POP BC        ; }
 $BA00 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #SABREWULF$B6B2 }
; LIST#

; Messaging: Place Names
;
; The names of the places of the hall of fame, starting with the lowest.
; The name of the highest place is blank.
@label=PlaceNames
t$BA01 DEFM "8TH"    ; {"8TH", "7TH", "6TH", "5TH", "4TH", "3RD", "2ND" and "
 $BA04 DEFM "7TH"    ; ".
 $BA07 DEFM "6TH"    ;
 $BA0A DEFM "5TH"    ;
 $BA0D DEFM "4TH"    ;
 $BA10 DEFM "3RD"    ;
 $BA13 DEFM "2ND"    ;
 $BA16 DEFM "   "    ; }

; Enter Initials
;
; Used by the routine at #R$B970.
; .
; Asks the player for three initials. The turning controls change the
; letter, which cycles through the space and the letters A to Z, and the fire
; control for the first weapon accepts it.
;
; DE Address of the name
@label=EnterInitials
c$BA19 LD B,$03      ; There are three letters.
 $BA1B XOR A         ; {Clear the controls.
 $BA1C LD ($9625),A  ; }
 $BA1F LD HL,$5069   ; Point #REGhl at the screen address of the first letter.
@label=EnterInitials_Letter
*$BA22 LD A,$20      ; Start with a space.
@label=EnterInitials_Read
*$BA24 PUSH AF       ; Save the letter.
 $BA25 CALL $B075    ; Read the controls using #R$B075.
 $BA28 XOR A         ; {Clear the controls.
 $BA29 LD ($9625),A  ; }
 $BA2C POP AF        ; Restore the letter.
 $BA2D BIT 4,C       ; {Jump to accept the letter if the fire control is being
 $BA2F JR NZ,$BA65   ; used.}
 $BA31 BIT 1,C       ; {Jump to go back a letter if the control to turn left is
 $BA33 JR NZ,$BA3B   ; being used.}
 $BA35 BIT 0,C       ; {Jump to go on a letter if the control to turn right is
 $BA37 JR NZ,$BA53   ; being used.}
 $BA39 JR $BA24      ; Jump to read the controls again.
@label=EnterInitials_PreviousLetter
*$BA3B CALL $BA93    ; Make a sound using #R$BA93.
 $BA3E DEC A         ; Go back a letter.
 $BA3F CP $40        ; {Jump if that is not the character before #N$41 ("A").
 $BA41 JR NZ,$BA45   ; }
 $BA43 LD A,$20      ; Use a space.
@label=EnterInitials_CheckSpace
*$BA45 CP $1F        ; {Jump if that is not the character before a space.
 $BA47 JR NZ,$BA4B   ; }
 $BA49 LD A,$5A      ; Use "Z".
@label=EnterInitials_Show
*$BA4B PUSH AF       ; Save the letter.
 $BA4C CALL $B5CB    ; Print the letter using #R$B5CB.
 $BA4F POP AF        ; Restore the letter.
 $BA50 DEC L         ; Go back to the screen address of the letter.
 $BA51 JR $BA24      ; Jump to read the controls again.
@label=EnterInitials_NextLetter
*$BA53 CALL $BA93    ; Make a sound using #R$BA93.
 $BA56 INC A         ; Go on a letter.
 $BA57 CP $5B        ; {Jump if that is not the character after "Z".
 $BA59 JR NZ,$BA5D   ; }
 $BA5B LD A,$20      ; Use a space.
@label=EnterInitials_CheckAfterZ
*$BA5D CP $21        ; {Jump if that is not the character after a space.
 $BA5F JR NZ,$BA4B   ; }
 $BA61 LD A,$41      ; Use "A".
 $BA63 JR $BA4B      ; Jump to show the letter.
@label=EnterInitials_Fire
*$BA65 PUSH AF       ; Save the letter.
 $BA66 CALL $B075    ; Read the controls using #R$B075.
 $BA69 XOR A         ; {Clear the controls.
 $BA6A LD ($9625),A  ; }
 $BA6D POP AF        ; Restore the letter.
 $BA6E BIT 4,C       ; {Jump back until the fire control is released.
 $BA70 JR NZ,$BA65   ; }
 $BA72 LD (DE),A     ; Store the letter in the name.
 $BA73 INC DE        ; Move on to the next letter of the name.
 $BA74 PUSH AF       ; Save the letter...
 $BA75 PUSH BC       ; ...and the counter.
 $BA76 CALL $B5CB    ; Print the letter using #R$B5CB.
 $BA79 INC L         ; Leave a gap before the next letter.
 $BA7A LD C,$00      ; {Make a sound using #R$C050.
 $BA7C CALL $C050    ; }
 $BA7F LD BC,$0000   ; Wait for #N$010000 iterations.
@label=EnterInitials_Delay
*$BA82 DEC BC        ; Count down the delay.
 $BA83 LD A,B        ; {Loop back until the count reaches zero.
 $BA84 OR C          ;
 $BA85 JR NZ,$BA82   ; }
 $BA87 POP BC        ; Restore the counter...
 $BA88 POP AF        ; ...and the letter.
 $BA89 DJNZ $BA22    ; Loop back until all three letters have been entered.
 $BA8B LD B,$01      ; Use one pass of the delay...
 $BA8D LD HL,$0000   ; ...with a count of #N$0000...
 $BA90 JP $BD32      ; ...and wait using #R$BD32.
; View the equivalent code in;
; #LIST
; { #SABREWULF$B6D7 }
; LIST#

; Delay And Beep
;
; Used by the routine at #R$BA19.
; .
; Makes a short beep and a pause, which is used when the letter is
; changed.
@label=NewHighScore_Return
c$BA93 PUSH AF       ; Save the letter...
 $BA94 PUSH BC       ; ...the counter...
 $BA95 PUSH HL       ; ...and the screen address.
 $BA96 LD B,$01      ; Use a count of one...
 $BA98 LD HL,$8000   ; ...and #N$8000 iterations...
 $BA9B CALL $BD32    ; ...for the delay using #R$BD32.
 $BA9E CALL $C027    ; Make a beep using #R$C027.
 $BAA1 POP HL        ; Restore the screen address...
 $BAA2 POP BC        ; ...the counter...
 $BAA3 POP AF        ; ...and the letter.
 $BAA4 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #SABREWULF$B743 }
; LIST#

; Messaging: Initials
;
; The attributes, coordinates and text of the message that asks for the
; initials. The three characters of the third line, after "TODAYS", are replaced
; with the name of the place.
@label=InitialsMessage_Attributes
t$BAA5 DEFB $45                        ; #COLOUR(#PEEK(#PC)).
 $BAA6 DEFB $45                        ; #COLOUR(#PEEK(#PC)).
 $BAA7 DEFB $45                        ; #COLOUR(#PEEK(#PC)).
 $BAA8 DEFB $45                        ; #COLOUR(#PEEK(#PC)).
 $BAA9 DEFB $43                        ; #COLOUR(#PEEK(#PC)).
 $BAAA DEFB $43                        ; #COLOUR(#PEEK(#PC)).
 $BAAB DEFB $47                        ; #COLOUR(#PEEK(#PC)).
@label=InitialsMessage_Coordinates
 $BAAC DEFB $20,$38                    ; {Coordinates of the seven lines of
 $BAAE DEFB $18,$48                    ; text.
 $BAB0 DEFB $18,$58                    ;
 $BAB2 DEFB $48,$68                    ;
 $BAB4 DEFB $20,$78                    ;
 $BAB6 DEFB $28,$88                    ;
 $BAB8 DEFB $48,$98                    ; }
@label=InitialsMessage_Text
 $BABA DEFM "CONGRATULATION","S"+$80   ; "CONGRATULATIONS".
 $BAC9 DEFM "YOU HAVE ACHIEVE","D"+$80 ; "YOU HAVE ACHIEVED".
 $BADA DEFM "TODAYS "                  ; "TODAYS" and a space.
@label=InitialsMessage_PlaceName
 $BAE1 DEFM "    HIGHES","T"+$80       ; The name of the place is written over the spaces, then
                                       ; "HIGHEST".
 $BAEC DEFM "SCOR","E"+$80             ; "SCORE".
 $BAF1 DEFM "PLEASE REGISTE","R"+$80   ; "PLEASE REGISTER".
 $BB00 DEFM "YOUR INITIAL","S"+$80     ; "YOUR INITIALS".
 $BB0D DEFM "- - ","-"+$80             ; "- - -".

; Game Selection Menu
;
; Used by the routines at #R$98D0 and #R$BB83.
; .
; Displays the menu and waits for the control method to be chosen and the
; game to be started. The keys "1" to "4" choose the keyboard, the Kempston
; joystick, the cursor joystick and Interface II, and "0" starts the game. The
; menu tune is played once. The choice is held in #R$961A. If nothing is done
; for a while then the hall of fame is shown.
@label=GameMenu
c$BB12 LD A,$FF      ; {Set the last method of control that was seen to an
 $BB14 LD ($9632),A  ; impossible value.}
 $BB17 XOR A         ; Clear the attribute.
 $BB18 CALL $B212    ; Call #R$B212.
; Read the keys that choose the control method.
@label=GameMenu_Loop
*$BB1B CALL $B8B3    ; Draw the menu using #R$B8B3.
; #HTML(#AUDIO0(title-tune.wav)(#INCLUDE(TitleTune)))
 $BB1E LD DE,$C1E9   ; Point #REGde at #R$C1E9.
 $BB21 CALL $C0B6    ; Play it using #R$C0B6, if it has not been played yet.
 $BB24 LD A,$F7      ; {Read from the keyboard;
 $BB26 CALL $C0AB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$F7 | 1 | 2 | 3 | 4 | 5 }
                     ; TABLE#}
 $BB29 LD E,A        ; Keep the keys that are pressed in #REGe.
 $BB2A LD A,($961A)  ; Fetch the method of control.
 $BB2D BIT 0,E       ; {Jump if the key #N$01 is not pressed.
 $BB2F JR Z,$BB33    ; }
 $BB31 AND %11111001 ; Use method zero (keyboard).
; Choose a joystick if one of those keys is pressed.
@label=GameMenu_CheckKey2
*$BB33 BIT 1,E       ; {Jump if the key #N$02 is not pressed.
 $BB35 JR Z,$BB3B    ; }
 $BB37 AND %11111001 ; Use method one (Kempston joystick)...
 $BB39 OR %00000010  ; Set the method to the Kempston joystick.
@label=GameMenu_CheckKey3
*$BB3B BIT 2,E       ; {Jump if the key #N$03 is not pressed.
 $BB3D JR Z,$BB43    ; }
 $BB3F AND %11111001 ; Use method two (cursor keys)...
 $BB41 OR %00000100  ; Set the method to the cursor keys.
@label=GameMenu_CheckKey4
*$BB43 BIT 3,E       ; {Jump if the key #N$04 is not pressed.
 $BB45 JR Z,$BB49    ; }
 $BB47 OR %00000110  ; Choose Interface II.
@label=GameMenu_StoreControl
*$BB49 LD ($961A),A  ; Store the method of control.
; Start the game if "0" is pressed.
 $BB4C LD A,$EF      ; {Read from the keyboard;
 $BB4E CALL $C0AB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$EF | 0 | 9 | 8 | 7 | 6 }
                     ; TABLE#}
 $BB51 AND %00000001 ; ...and keep the key #N$00.
 $BB53 JR NZ,$BB86   ; Jump to start the game if it is pressed.
 $BB55 LD HL,$9632   ; Point #REGhl at the last method of control that was
                     ; seen.
 $BB58 LD A,($961A)  ; Fetch the method of control...
 $BB5B CP (HL)       ; Compare it with the last method.
 $BB5C LD ($9632),A  ; Set #R$9632.
 $BB5F CALL $B760    ; Reset the idle timer if the method has changed, or count it down,
                     ; using #R$B760.
; Flash the chosen control method.
 $BB62 LD HL,$B8E5   ; Point #REGhl at #R$B8E5.
 $BB65 LD A,($961A)  ; Fetch the method of control...
 $BB68 RRCA          ; Move the method to bits 0 and 1.
 $BB69 AND %00000011 ; Keep only bits 0 and 1.
 $BB6B LD B,$04      ; There are four lines for the methods of control.
 $BB6D CALL $BB73    ; Make the line for the method flash using #R$BB73.
 $BB70 JP $BB1B      ; Jump back to draw the menu again.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$BA7E }
; { #KNIGHTLORE$BD0C }
; { #NIGHTSHADE$C8CA }
; { #PENTAGRAM$BB74 }
; LIST#

; Set Flashing Attribute
;
; Used by the routine at #R$BB12.
; .
; Makes the line of the menu that is selected flash, by setting bit 7 of
; its attribute. The other lines have it cleared.
;
; A Number of the line to highlight
; B Number of lines
; HL Address of the attributes of the lines
@label=SetFlashingAttribute
c$BB73 AND A         ; {Jump to make the line flash if it is the first one.
 $BB74 JR NZ,$BB7D   ; }
@label=HighlightMenuItem_Flash
*$BB76 SET 7,(HL)    ; Make the line flash...
 $BB78 JR $BB7F      ; ...and jump to move on to the next line.
@label=HighlightMenuItem_Next
*$BB7A DEC A         ; Count down the lines.
 $BB7B JR Z,$BB76    ; Jump to make the line flash if it is the one that is
                     ; selected.
@label=HighlightMenuItem_Steady
*$BB7D RES 7,(HL)    ; Make the line steady.
@label=HighlightMenuItem_NextLine
*$BB7F INC HL        ; Move on to the next attribute.
 $BB80 DJNZ $BB7A    ; Loop back until all of the lines have been done.
 $BB82 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$BC15 }
; { #PENTAGRAM$BB64 }
; LIST#

; Unused Jump
;
; This jump to #R$BB12 is not used.
@label=GameMenu_Unused
c$BB83 JP $BB12      ; Jump to show the menu.

; Start Game Sequence
;
; Used by the routine at #R$BB12.
; .
; Runs when the key to start the game is pressed. Lights are started
; around the frame of the screen, and when they have all finished the tune that
; starts the game is played and the game screen is drawn.
@label=StartGameSequence
c$BB86 LD B,$08      ; There are eight lights to start.
@label=StartGameSequence_Light
*$BB88 PUSH BC       ; Save the counter.
 $BB89 CALL $B8B3    ; Draw the menu using #R$B8B3.
 $BB8C LD A,$01      ; {Start a new light using #R$AF25.
 $BB8E CALL $AF25    ; }
 $BB91 POP BC        ; Restore the counter.
 $BB92 DJNZ $BB88    ; Loop back until all eight lights have been started.
 $BB94 CALL $B8B3    ; Draw the menu using #R$B8B3.
@label=StartGameSequence_Wait
*$BB97 LD IY,($9613) ; Restore #REGiy, which the ROM interrupt routine needs.
 $BB9B EI            ; Enable interrupts...
 $BB9C HALT          ; ...and wait for the next one.
 $BB9D DI            ; Disable interrupts again.
 $BB9E XOR A         ; {Move the lights without starting a new one, using
 $BB9F CALL $AF25    ; #R$AF25.}
 $BBA2 JR NZ,$BB97   ; Loop back until all of the lights have finished.
 $BBA4 LD DE,$C289   ; Point #REGde at #R$C289.
 $BBA7 CALL $C0CF    ; Play it using #R$C0CF.

; Draw Game Screen
;
; Used by the routine at #R$9A4B.
; .
; Resets the map and draws the parts of the game screen that are not the
; play window: the rows of beads above the message area, the message area itself
; with its rounded box, and the box for the battery meter with its title. It is
; used when a game is started, and when a round has been completed.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$98E0,stop=$98EC,clear=1,sp=$5E00)
; #SIM(start=$98EC,stop=$98EF)
; #SIM(start=$98EF,stop=$98F2)
; #SIM(start=$98F2,stop=$98F5)
; #SIM(start=$98F5,stop=$98F8)
; #POKES$5C36,$00;$5C37,$3C
; #SCR$02(draw-game-screen-before)
; | #SIM(start=$9A65,stop=$9A68)
; #SCR$02(draw-game-screen-after) } UDGTABLE# #POPS
@label=DrawGameScreen
c$BBAA CALL $BD13    ; Reset the map using #R$BD13.
 $BBAD LD HL,$9401   ; Point #REGhl at #R$9401.
 $BBB0 LD ($9618),HL ; ...and use them as the current character set.
; Draw the two rows of beads that divide the play window from the message
; area.
 $BBB3 LD HL,$5020   ; Point #REGhl at the start of the row on character row
                     ; #N$11.
 $BBB6 LD BC,$1801   ; The row is #N$18 characters wide (#REGb) and starts with character
                     ; #N$01 (#REGc).
 $BBB9 CALL $B6A6    ; Draw the row using #R$B6A6.
 $BBBC LD BC,$1602   ; The row is #N$16 characters wide and starts with
                     ; character #N$02.
 $BBBF LD HL,$5001   ; Point #REGhl at the start of the row on character row #N($10), one
                     ; column in.
 $BBC2 CALL $B6A6    ; Draw the row.
 $BBC5 LD HL,$5A20   ; Point #REGhl at the attributes of the lower row.
 $BBC8 LD (HL),$48   ; Set the first attribute, blue paper with black ink.
 $BBCA INC HL        ; Move on to the second cell.
 $BBCB LD BC,$1649   ; There are #N$16 cells, and the attribute is blue paper with blue
                     ; ink.
 $BBCE CALL $B689    ; Set the attributes using #R$B689.
 $BBD1 LD (HL),$41   ; Set the last attribute, blue ink on a black paper.
 $BBD3 LD HL,$5A01   ; Point #REGhl at the attributes of the upper row.
 $BBD6 LD BC,$1648   ; There are #N$16 cells, and the attribute is blue paper with black
                     ; ink.
 $BBD9 CALL $B689    ; Set the attributes.
 $BBDC CALL $B202    ; Clear the message area using #R$B202.
 $BBDF LD A,$47      ; {Fill the attributes of the message area with bright white using
 $BBE1 CALL $B1E1    ; #R$B1E1.}
 $BBE4 LD HL,($5C36) ; Fetch the address of the ROM character set...
 $BBE7 LD ($9618),HL ; ...and use it as the current character set.
 $BBEA LD HL,$9008   ; Point #REGhl at the position of the title of the battery
                     ; meter.
 $BBED LD DE,$BCCB   ; Point #REGde at #R$BCCB.
 $BBF0 CALL $B52E    ; Print it using #R$B52E.
; Draw the rounded box of the message area, which is made of four rows of
; characters.
 $BBF3 LD HL,$BC54   ; Point #REGhl at #R$BC54.
 $BBF6 LD ($9618),HL ; ...and use them as the current character set.
 $BBF9 LD DE,$BC8C   ; Point #REGde at #R$BC8C.
 $BBFC LD HL,$A020   ; Point #REGhl at the position of the top row.
 $BBFF CALL $BDA1    ; Print it using #R$BDA1.
 $BC02 LD DE,$BCA1   ; Point #REGde at #R$BCA1.
 $BC05 LD HL,$A820   ; Point #REGhl at the position of the second row.
 $BC08 CALL $BDA1    ; Print it.
 $BC0B LD DE,$BCA1   ; Point #REGde at the middle row of the box again.
 $BC0E LD HL,$B020   ; Point #REGhl at the position of the third row.
 $BC11 CALL $BDA1    ; Print it.
 $BC14 LD DE,$BCB6   ; Point #REGde at #R$BCB6.
 $BC17 LD HL,$B820   ; Point #REGhl at the position of the bottom row.
 $BC1A CALL $BDA1    ; Print it.
; Draw the box for the battery meter.
 $BC1D LD HL,$BCE3   ; Point #REGhl at #R$BCE3.
 $BC20 LD ($9618),HL ; ...and use them as the current character set.
 $BC23 LD HL,$9040   ; Point #REGhl at the position of the box.
 $BC26 LD DE,$BCD3   ; Point #REGde at #R$BCD3.
@label=DrawGameScreen_Attributes
 $BC29 PUSH HL       ; Save the position.
 $BC2A CALL $BD6A    ; Find the address of the attributes using #R$BD6A.
 $BC2D LD A,(DE)     ; Fetch the attribute...
 $BC2E INC DE        ; ...and move on to the first character.
 $BC2F LD C,A        ; Keep the attribute.
 $BC30 LD B,$02      ; There are two rows of characters.
@label=DrawGameScreen_Row
*$BC32 PUSH DE       ; Save the address of the characters...
 $BC33 PUSH HL       ; ...and the address of the attributes.
@label=DrawGameScreen_Cell
*$BC34 LD (HL),C     ; Set an attribute.
 $BC35 LD A,(DE)     ; Fetch a character...
 $BC36 INC DE        ; ...and move on to the next one.
 $BC37 INC L         ; Move on to the next attribute.
 $BC38 BIT 7,A       ; {Loop back until the last character has been reached.
 $BC3A JR Z,$BC34    ; }
 $BC3C POP HL        ; Restore the address of the attributes...
 $BC3D LD DE,$0020   ; ...and move down to the next row...
 $BC40 ADD HL,DE     ; ...of the attributes.
 $BC41 POP DE        ; Restore the address of the characters.
 $BC42 DJNZ $BC32    ; Loop back until both rows have been done.
 $BC44 POP HL        ; Restore the position of the box.
 $BC45 CALL $BD4B    ; Find the screen address using #R$BD4B.
@label=DrawGameScreen_Character
*$BC48 LD A,(DE)     ; Fetch a character.
 $BC49 INC DE        ; Move on to the next one.
 $BC4A BIT 7,A       ; {Jump to #R$B4F8 to print the last character of the box.
 $BC4C JP NZ,$B4F8   ; }
 $BC4F CALL $B4F8    ; Print a character using #R$B4F8.
 $BC52 JR $BC48      ; Loop back until the whole box has been printed.

; Message Box Graphics
;
; The graphics of the rounded box that goes round the message area. They
; are the top left corner, the top and bottom edges, the top right corner, the
; sides, the bottom left corner, the bottom right corner and a blank.
@label=MessageBoxGraphics
b$BC54 DEFB $00,$00,$07,$0F,$1F,$3F,$3E,$3C
 $BC5C DEFB $00,$00,$FF,$FF,$FF,$FF,$00,$00
 $BC64 DEFB $00,$00,$E0,$F0,$F8,$FC,$7C,$3C
 $BC6C DEFB $3C,$3C,$3C,$3C,$3C,$3C,$3C,$3C
 $BC74 DEFB $3C,$3E,$3F,$1F,$0F,$07,$00,$00
 $BC7C DEFB $3C,$7C,$FC,$F8,$F0,$E0,$00,$00
 $BC84 DEFB $00,$00,$00,$00,$00,$00,$00,$00

; Message Box Text
;
; The rows of the message box. Each one starts with an attribute (bright
; cyan) and ends with a character that has bit 7 set.
@label=MessageBox_Top
b$BC8C DEFB $45                                                                     ; Attribute.
 $BC8D DEFB $00                                                                     ; The top
                                                                                    ; left
                                                                                    ; corner.
 $BC8E DEFB $01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01 ; The top
                                                                                    ; edge.
 $BCA0 DEFB $82                                                                     ; The top
                                                                                    ; right
                                                                                    ; corner.
@label=MessageBox_Middle
 $BCA1 DEFB $45                                                                     ; Attribute.
 $BCA2 DEFB $03                                                                     ; The left
                                                                                    ; side.
 $BCA3 DEFB $06,$06,$06,$06,$06,$06,$06,$06,$06,$06,$06,$06,$06,$06,$06,$06,$06,$06 ; The blank
                                                                                    ; middle.
 $BCB5 DEFB $83                                                                     ; The right
                                                                                    ; side.
@label=MessageBox_Bottom
 $BCB6 DEFB $45                                                                     ; Attribute.
 $BCB7 DEFB $04                                                                     ; The bottom
                                                                                    ; left
                                                                                    ; corner.
 $BCB8 DEFB $01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01 ; The bottom
                                                                                    ; edge.
 $BCCA DEFB $85                                                                     ; The bottom
                                                                                    ; right
                                                                                    ; corner.

; Battery Meter Data
;
; The title of the battery meter. It starts with an attribute (bright
; yellow).
; .
; The box for the battery meter. It starts with an attribute (bright
; yellow on black) and ends with a character that has bit 7 set. The characters
; are each two rows tall.
@label=Message_Battery
b$BCCB DEFB $46                                                 ; Attribute.
 $BCCC DEFM "BATTER","Y"+$80                                    ; "BATTERY".
@label=BatteryMeterBox
 $BCD3 DEFB $46                                                 ; Attribute.
 $BCD4 DEFB $00                                                 ; The left end.
 $BCD5 DEFB $01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01 ; The middle.
 $BCE2 DEFB $82                                                 ; The right
                                                                ; end.

; Battery Meter Box Graphics
;
; The graphics of the box for the battery meter, which is two rows tall.
; They are the left end, the middle (the top line and the bottom line) and the
; right end, each of which is made of an upper and a lower graphic.
@label=BatteryMeterBoxGraphics
b$BCE3 DEFB $00,$00,$0F,$30,$60,$40,$80,$80
 $BCEB DEFB $80,$80,$40,$60,$30,$0F,$00,$00
 $BCF3 DEFB $00,$00,$FF,$00,$00,$00,$00,$00
 $BCFB DEFB $00,$00,$00,$00,$00,$FF,$00,$00
 $BD03 DEFB $00,$00,$F0,$0C,$06,$02,$01,$01
 $BD0B DEFB $01,$01,$02,$06,$0C,$F0,$00,$00

; Reset Map
;
; Used by the routine at #R$BBAA.
; .
; Puts every cell of the map back to its initial type, by copying the
; upper four bits of each cell into the lower four bits.
@label=ResetMap
c$BD13 LD HL,$D355   ; Point #REGhl at the end of the map.
 $BD16 LD BC,$C515   ; Point #REGbc at #R$C515.
 $BD19 AND A         ; {Find the size of the map...
 $BD1A SBC HL,BC     ; }
 $BD1C LD B,H        ; {...and keep it in #REGbc.
 $BD1D LD C,L        ; }
 $BD1E LD HL,$C515   ; Point #REGhl at #R$C515.
@label=ResetMap_Cell
*$BD21 LD A,(HL)     ; Fetch a cell.
 $BD22 AND $F0       ; {Keep the initial type.
 $BD24 LD D,A        ; }
 $BD25 RRA           ; {Move it into the lower four bits...
 $BD26 RRA           ;
 $BD27 RRA           ;
 $BD28 RRA           ; }
 $BD29 OR D          ; ...and combine it with the original.
 $BD2A LD (HL),A     ; Store the cell.
 $BD2B INC HL        ; Move on to the next cell.
 $BD2C DEC BC        ; Count down the size.
 $BD2D LD A,C        ; {Loop back until every cell has been reset.
 $BD2E OR B          ;
 $BD2F JR NZ,$BD21   ; }
 $BD31 RET           ; Return.

; Delay
;
; Used by the routines at #R$B6D2, #R$BA19 and #R$BA93.
; .
; Waits for a while. The time is about #REGb times the number of times
; that #REGhl can be counted down to zero, which is #N$10000 if it starts as
; zero.
;
; B Number of times to repeat the wait
; HL Length of each wait
@label=Delay
c$BD32 DEC HL        ; {Count down #REGhl until it reaches zero.
 $BD33 LD A,L        ;
 $BD34 OR H          ;
 $BD35 JR NZ,$BD32   ; }
 $BD37 DJNZ $BD32    ; Loop back until the wait has been repeated #REGb times.
 $BD39 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #SABREWULF$A1FF }
; { #TRANZAM$6386 }
; LIST#

; Screen Address One Pixel Below
;
; Used by the routine at #R$B1F2.
; .
; Moves down by one pixel line in the display file.
;
;   HL Screen address
; O:HL Screen address one pixel line down
@label=ScreenPosition1PixelBelow
c$BD3A INC H         ; Move down to the next pixel line in the character row.
 $BD3B LD A,H        ; {Return if that is still inside the character row.
 $BD3C AND $07       ;
 $BD3E RET NZ        ; }
 $BD3F LD A,L        ; {Otherwise move on to the next character row in the
 $BD40 ADD A,$20     ; third...
 $BD42 LD L,A        ; }
 $BD43 AND $E0       ; {...and return if that is still inside the third of the
 $BD45 RET Z         ; display.}
 $BD46 LD A,H        ; {Otherwise move on to the next third.
 $BD47 SUB $08       ;
 $BD49 LD H,A        ; }
 $BD4A RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9BC1 }
; { #SABREWULF$B8CC }
; { #UNDERWURLDE$9C2B }
; LIST#

; Calculate Screen Address
;
; Used by the routines at #R$9C88, #R$9D07, #R$9E55, #R$AE67, #R$B52E, #R$B78C,
; #R$BBAA, #R$BD82 and #R$BD99.
; .
; Finds the address in the display file of a pixel position.
;
;   L Horizontal position in pixels (the address is of the byte it is in)
;   H Vertical position in pixels, from the top
; O:HL Screen address
@label=ScreenAddress
c$BD4B LD A,L        ; {Divide the horizontal position by eight...
 $BD4C RRCA          ;
 $BD4D RRCA          ;
 $BD4E RRCA          ; }
 $BD4F AND $1F       ; {...to find the column.
 $BD51 LD L,A        ; }
 $BD52 LD A,H        ; {Find the bits of the character row that are within a third of the
 $BD53 RLCA          ; display, and shift them up...
 $BD54 RLCA          ; }
 $BD55 AND $E0       ; {...combine them with the column and store them in
 $BD57 OR L          ; #REGl.
 $BD58 LD L,A        ; }
 $BD59 LD A,H        ; {Keep the pixel line within the character row.
 $BD5A AND $07       ;
 $BD5C EX AF,AF'     ; }
 $BD5D LD A,H        ; {Find the third of the display and add the base address of the
 $BD5E RRCA          ; display file.
 $BD5F RRCA          ;
 $BD60 RRCA          ;
 $BD61 AND $18       ;
 $BD63 OR $40        ; }
 $BD65 LD H,A        ; Store it in #REGh.
 $BD66 EX AF,AF'     ; {Add the pixel line within the character row.
 $BD67 OR H          ;
 $BD68 LD H,A        ; }
 $BD69 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #LUNARJETMAN$851E }
; { #PSSST$759A }
; { #SABREWULF$B8AD }
; { #TRANZAM$6F10 }
; LIST#

; Calculate Attribute Address
;
; Used by the routines at #R$9EC6, #R$B52E, #R$BBAA, #R$BD82 and #R$BD99.
; .
; Finds the address in the attribute file of a pixel position.
;
;   L Horizontal position in pixels
;   H Vertical position in pixels, from the top
; O:HL Attribute address
@label=AttributeAddress
c$BD6A PUSH BC       ; Save #REGbc.
 $BD6B LD A,L        ; {Divide the horizontal position by eight...
 $BD6C RRCA          ;
 $BD6D RRCA          ;
 $BD6E RRCA          ; }
 $BD6F AND $1F       ; {...to find the column.
 $BD71 LD L,A        ; }
 $BD72 LD A,H        ; {Multiply the vertical position by four, keeping it in
 $BD73 RLCA          ; #REGc.
 $BD74 RLCA          ;
 $BD75 LD C,A        ; }
 $BD76 AND $E0       ; {Combine the bits of the character row with the column and store them
 $BD78 OR L          ; in #REGl.
 $BD79 LD L,A        ; }
 $BD7A LD A,C        ; {Find the third of the attribute file and add its base
 $BD7B AND $03       ; address.
 $BD7D OR $58        ;
 $BD7F LD H,A        ; }
 $BD80 POP BC        ; Restore #REGbc.
 $BD81 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9BD2 }
; { #LUNARJETMAN$8506 }
; { #SABREWULF$B8DD }
; { #UNDERWURLDE$ADE0 }
; LIST#

; Print Text
;
; Used by the routine at #R$B8CE.
; .
; Prints a string using the ROM character set. The colour of the text is
; taken from the variable that holds the attribute.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$98E0,stop=$98EC,clear=1,sp=$5E00)
; #SIM(start=$98EC,stop=$98EF)
; #SIM(start=$98EF,stop=$98F2)
; #SIM(start=$98F2,stop=$98F5)
; #SIM(start=$98F5,stop=$98F8)
; #POKES$5C36,$00;$5C37,$3C;$9628,$47
; #SIM(start=$9901,stop=$9904)
; #SCR$02(print-text-before)
; | #SIM(start=$BD82,stop=$BDCC,de=$B718,hl=$5040)
; #SCR$02(print-text-after) } UDGTABLE# #POPS
;
; DE Address of the string, which ends with a character that has bit 7 set
; HL Pixel position of the start of the text (#REGl is x and #REGh is y)
@label=PrintText
c$BD82 PUSH HL       ; {Use the ROM character set.
 $BD83 LD HL,($5C36) ;
 $BD86 LD ($9618),HL ;
 $BD89 POP HL        ; }
@label=PrintText_Position
 $BD8A PUSH HL       ; {Find the address of the display file using #R$BD4B.
 $BD8B CALL $BD4B    ; }
 $BD8E LD A,($9628)  ; {Fetch the attribute and keep it in #REGa'.
 $BD91 EX AF,AF'     ; }
 $BD92 EXX           ; {Switch to the alternate registers and find the address of the
 $BD93 POP HL        ; attributes using #R$BD6A.
 $BD94 CALL $BD6A    ; }
 $BD97 JR $BDAD      ; Jump to print the text.

; Print Colour String
;
; Used by the routine at #R$B6D2.
; .
; Prints a string using the ROM character set. The first byte of the
; string is the attribute of the text.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$98E0,stop=$98EC,clear=1,sp=$5E00)
; #SIM(start=$98EC,stop=$98EF)
; #SIM(start=$98EF,stop=$98F2)
; #SIM(start=$98F2,stop=$98F5)
; #SIM(start=$98F5,stop=$98F8)
; #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$9901,stop=$9904)
; #SCR$02(print-colour-string-before)
; | #SIM(start=$BD99,stop=$BDCC,de=$B717,hl=$4038)
; #SCR$02(print-colour-string-after) } UDGTABLE# #POPS
;
; DE Address of the string, which starts with an attribute
; HL Pixel position of the start of the text (#REGl is x and #REGh is y)
@label=PrintStringColour
c$BD99 PUSH HL       ; {Use the ROM character set.
 $BD9A LD HL,($5C36) ;
 $BD9D LD ($9618),HL ;
 $BDA0 POP HL        ; }
; This entry point is used by the routine at #R$BBAA.
; .
; This entry point uses the current character set.
@label=PrintStringColour_CustomFont
*$BDA1 PUSH HL       ; {Find the address of the display file using #R$BD4B.
 $BDA2 CALL $BD4B    ; }
 $BDA5 LD A,(DE)     ; {Fetch the attribute from the string and keep it in
 $BDA6 EX AF,AF'     ; #REGa'...}
 $BDA7 INC DE        ; ...and move on to the first character.
 $BDA8 EXX           ; {Switch to the alternate registers and find the address of the
 $BDA9 POP HL        ; attributes using #R$BD6A.
 $BDAA CALL $BD6A    ; }
; This entry point is used by the routine at #R$BD82.
@label=PrintStringColour_Loop
*$BDAD EXX           ; Switch back to the main registers.
 $BDAE LD A,(DE)     ; Fetch a character.
 $BDAF BIT 7,A       ; {Jump if it is the last one.
 $BDB1 JR NZ,$BDC0   ; }
 $BDB3 PUSH DE       ; Save the address of the string.
 $BDB4 CALL $B5CB    ; Print the character using #R$B5CB.
 $BDB7 POP DE        ; Restore the address of the string...
 $BDB8 INC DE        ; ...and move on to the next character.
 $BDB9 EXX           ; Switch to the alternate registers.
 $BDBA EX AF,AF'     ; Fetch the attribute...
 $BDBB LD (HL),A     ; ...and set it...
 $BDBC INC L         ; ...and move on to the next cell...
 $BDBD EX AF,AF'     ; ...keeping the attribute.
 $BDBE JR $BDAD      ; Loop back to print the next character.
@label=PrintStringColour_Last
*$BDC0 AND $7F       ; Clear bit 7 of the last character.
 $BDC2 PUSH DE       ; Save the address of the string.
 $BDC3 CALL $B5CB    ; Print the character.
 $BDC6 POP DE        ; Restore the address of the string.
 $BDC7 INC DE        ; Move on to the next character.
 $BDC8 EXX           ; Switch to the alternate registers.
 $BDC9 EX AF,AF'     ; Fetch the attribute...
 $BDCA LD (HL),A     ; ...and set it for the last cell.
 $BDCB EXX           ; Switch back to the main registers.
 $BDCC RET           ; Return.
; View the equivalent code in;
; #LIST
; { #LUNARJETMAN$8A11 }
; { #PSSST$73ED }
; { #SABREWULF$B53D }
; { #TRANZAM$6518 }
; LIST#

; Add Entity
;
; Used by the routines at #R$A144, #R$A20D, #R$A218, #R$A2B5, #R$A36C, #R$A4EC,
; #R$A70A, #R$A833, #R$A932, #R$A974, #R$A98B and #R$AB03.
; .
; Adds an entity to the draw list, if it can be seen. The view is centred
; on the robot (the first entity), and an entity can only be seen if it is
; within about #N$10 cells of it. The distances between the entity and the robot
; in the two directions are projected onto the screen: the sum of them gives the
; height of the entity above the bottom of the buffer and the difference gives
; its horizontal position, both in units of one sixteenth of a cell. If it is
; added then bit 0 of (#REGix+#N$0F) is set. The draw list entry that is added
; is made of the type of the entity, the horizontal position and the height.
;
;   IX Entity
; O:F Carry set if the entity was added
@label=AddEntity
c$BDCD LD BC,$0540     ; Set the offset that puts the robot five and a quarter cells from the
                       ; start of the view.
 $BDD0 RES 0,(IX+$0F)  ; Mark the entity as not visible.
 $BDD4 LD L,(IX+$01)   ; {Fetch the horizontal position of the entity.
 $BDD7 LD H,(IX+$02)   ; }
 $BDDA LD DE,($9691)   ; Fetch the horizontal position of the robot.
 $BDDE AND A           ; {Find the distance from the robot...
 $BDDF SBC HL,DE       ; }
 $BDE1 ADD HL,BC       ; ...and add the offset.
 $BDE2 LD A,H          ; {Keep it within the width of the map (#N$40 cells).
 $BDE3 AND $3F         ; }
 $BDE5 CP $10          ; {Return, as the entity cannot be seen, if it is further than #N$0F
 $BDE7 RET NC          ; cells from the start of the view.}
 $BDE8 LD H,A          ; Keep the cell number.
 $BDE9 PUSH HL         ; Save the horizontal distance.
 $BDEA LD L,(IX+$03)   ; {Fetch the vertical position of the entity.
 $BDED LD H,(IX+$04)   ; }
 $BDF0 LD DE,($9693)   ; Fetch the vertical position of the robot.
 $BDF4 AND A           ; {Find the distance from the robot.
 $BDF5 SBC HL,DE       ; }
 $BDF7 LD A,H          ; {Keep it within the height of the map (#N$40 cells).
 $BDF8 AND $3F         ;
 $BDFA LD H,A          ; }
 $BDFB EX DE,HL        ; Move the vertical distance into #REGde.
 $BDFC POP HL          ; {Restore the horizontal distance, keeping a copy of it
 $BDFD PUSH HL         ; too.}
 $BDFE ADD HL,DE       ; Add the vertical distance.
 $BDFF CALL $BE4E      ; Divide it by sixteen using #R$BE4E, to find the
                       ; height.
 $BE02 LD A,H          ; {Jump to throw the entity away if the height does not
 $BE03 AND $03         ; fit in a byte.
 $BE05 JR NZ,$BE4B     ; }
 $BE07 LD A,L          ; {Jump to throw the entity away if the height is more
 $BE08 CP $A8          ; than #N$A7.
 $BE0A JR NC,$BE4B     ; }
 $BE0C LD IY,($962A)   ; Fetch the address of the next free entry of the draw
                       ; list.
 $BE10 LD (IY+$02),A   ; Store the height in it.
 $BE13 POP HL          ; Restore the horizontal distance.
 $BE14 AND A           ; {Subtract the vertical distance...
 $BE15 SBC HL,DE       ; }
 $BE17 CALL $BE4E      ; ...and divide it by sixteen, to find the horizontal
                       ; position.
 $BE1A LD A,L          ; {Add eight to it...
 $BE1B ADD A,$08       ;
 $BE1D LD L,A          ; }
 $BE1E LD A,H          ; {...carrying on into the high byte.
 $BE1F ADC A,$00       ; }
 $BE21 AND $03         ; {Return, as the entity cannot be seen, if it is out of
 $BE23 RET NZ          ; range.}
 $BE24 LD A,L          ; {Return, as the entity cannot be seen, if it is further right than
 $BE25 CP $B8          ; #N$B7.
 $BE27 RET NC          ; }
 $BE28 SUB $08         ; {Take the eight off again. If that goes below zero then subtract
 $BE2A JR NC,$BE2E     ; #N$40.
 $BE2C SUB $40         ; }
@label=AddEntity_StoreX
*$BE2E LD (IY+$01),A   ; Store the horizontal position in the entry.
 $BE31 LD A,(IX+$00)   ; {Copy the type of the entity into the entry.
 $BE34 LD (IY+$00),A   ; }
 $BE37 INC IY          ; {Move on to the next entry.
 $BE39 INC IY          ;
 $BE3B INC IY          ; }
 $BE3D LD (IY+$00),$00 ; End the list after it.
 $BE41 LD ($962A),IY   ; Store the address of the next free entry.
 $BE45 SET 0,(IX+$0F)  ; Mark the entity as visible.
 $BE49 SCF             ; {Set the carry flag to show that the entity was added,
 $BE4A RET             ; and return.}
@label=AddEntity_Hidden
*$BE4B POP HL          ; Throw away the horizontal distance.
 $BE4C AND A           ; {Clear the carry flag, and return.
 $BE4D RET             ; }

; Divide By Sixteen
;
; Used by the routine at #R$BDCD.
; .
; Shifts a 16-bit number right by four bits.
;
;   HL Number to divide
; O:HL Number divided by sixteen
@label=DivideBySixteen
c$BE4E SRL H         ; {Shift #REGhl right four times.
 $BE50 RR L          ;
 $BE52 SRL H         ;
 $BE54 RR L          ;
 $BE56 SRL H         ;
 $BE58 RR L          ;
 $BE5A SRL H         ;
 $BE5C RR L          ; }
 $BE5E RET           ; Return.

; Add Map Cells
;
; Used by the routine at #R$993C.
; .
; Adds the cells of the map that can be seen to the end of the draw list.
; They are the cells in a diamond shape around the robot: twelve rows along the
; map, which run from six rows further on than the robot to five rows behind it.
; The rows have #N($01), #N($03), #N($05), #N($07), #N($09), #N($0B), #N($0D),
; #N($0B), #N($09), #N($07), #N$05 and #N$03 cells in them. Each empty cell is
; skipped. The position
; of each of the others on the screen is found from its place in the diamond,
; the position of the robot inside its own cell and the offsets in the template
; for the type of the cell, which are the same projection as #R$BDCD uses. Cells
; that are outside of the play window are not added.
@label=AddMapCells
c$BE5F LD IX,($962A)   ; Fetch the address of the next free entry of the draw
                       ; list.
 $BE63 LD A,($9691)    ; {Fetch the fraction of the horizontal position of the robot, in
 $BE66 RRCA            ; sixteenths of a cell, in #REGe.
 $BE67 RRCA            ;
 $BE68 RRCA            ;
 $BE69 RRCA            ;
 $BE6A AND $0F         ;
 $BE6C LD E,A          ; }
 $BE6D LD A,($9693)    ; {Fetch the fraction of the vertical position of the robot, in
 $BE70 RRCA            ; sixteenths of a cell, in #REGl.
 $BE71 RRCA            ;
 $BE72 RRCA            ;
 $BE73 RRCA            ;
 $BE74 AND $0F         ;
 $BE76 LD L,A          ; }
 $BE77 LD A,E          ; {Store the sum of them.
 $BE78 ADD A,L         ;
 $BE79 LD ($9627),A    ; }
 $BE7C LD A,E          ; {Store the difference between them.
 $BE7D SUB L           ;
 $BE7E LD ($9626),A    ; }
 $BE81 LD A,($9692)    ; {Fetch the map column of the robot into #REGe.
 $BE84 LD E,A          ; }
 $BE85 LD A,($9694)    ; {Fetch the map row of the robot, add six to it and keep it within the
 $BE88 ADD A,$06       ; map, in #REGd.
 $BE8A AND $3F         ;
 $BE8C LD D,A          ; }
 $BE8D LD C,$0C        ; There are twelve rows of cells.
@label=AddMapCells_Row
*$BE8F LD HL,$BFCD     ; Point #REGhl at the table of half widths of the rows.
 $BE92 LD B,$00        ; {Fetch the half width of this row into #REGl.
 $BE94 ADD HL,BC       ;
 $BE95 LD L,(HL)       ; }
 $BE96 PUSH DE         ; Save the position.
 $BE97 LD A,L          ; {Find the number of the cell at the start of the row, which is six
 $BE98 ADD A,$06       ; more than the half width...
 $BE9A LD B,A          ; }
 $BE9B SUB L           ; {...and the number of the cell after the end of the row, which is six
 $BE9C SUB L           ; less, in #REGh.
 $BE9D LD H,A          ; }
 $BE9E LD A,E          ; {Move to the right hand end of the row.
 $BE9F ADD A,L         ;
 $BEA0 AND $3F         ;
 $BEA2 LD E,A          ; }
@label=AddMapCells_Cell
*$BEA3 CALL $BF9D      ; Find the cell using #R$BF9D.
 $BEA6 JR Z,$BF07      ; Jump to move on to the next cell if it is empty.
 $BEA8 EXX             ; Switch to the alternate registers.
 $BEA9 DEC A           ; {Find the number of the template for the type of
 $BEAA AND $0F         ; cell...}
 $BEAC ADD A,A         ; {...multiply it by sixteen...
 $BEAD ADD A,A         ;
 $BEAE ADD A,A         ;
 $BEAF ADD A,A         ; }
 $BEB0 LD E,A          ; {...and put it in #REGde.
 $BEB1 LD D,$00        ; }
 $BEB3 LD IY,$97C0     ; {Point #REGiy at the template.
 $BEB7 ADD IY,DE       ; }
 $BEB9 EXX             ; Switch back to the main registers.
 $BEBA LD A,B          ; {Find the number of the column in the diamond...
 $BEBB SUB C           ;
 $BEBC ADD A,$06       ; }
 $BEBE ADD A,A         ; {...and multiply it by sixteen.
 $BEBF ADD A,A         ;
 $BEC0 ADD A,A         ;
 $BEC1 ADD A,A         ; }
 $BEC2 PUSH DE         ; Save the position.
 $BEC3 LD DE,($9626)   ; Fetch the sum and difference of the fractions of the position of the
                       ; robot.
 $BEC7 SUB E           ; Subtract the difference, to give the horizontal
                       ; position.
 $BEC8 ADD A,(IY+$01)  ; Add the first offset from the template...
 $BECB SUB (IY+$03)    ; ...and subtract the second one.
 $BECE SUB $03         ; Subtract three.
 $BED0 CP $B8          ; {Jump to throw the cell away if it is further right
 $BED2 JR NC,$BEF5     ; than #N$B7.}
 $BED4 SUB $08         ; {Take eight off. If that goes below zero then subtract
 $BED6 JR NC,$BEDA     ; #N$40.
 $BED8 SUB $40         ; }
@label=AddMapCells_StoreX
*$BEDA LD (IX+$01),A   ; Store the horizontal position in the entry.
 $BEDD LD A,B          ; {Find the number of the row in the diamond...
 $BEDE ADD A,C         ;
 $BEDF SUB $06         ; }
 $BEE1 ADD A,A         ; {...and multiply it by sixteen.
 $BEE2 ADD A,A         ;
 $BEE3 ADD A,A         ;
 $BEE4 ADD A,A         ; }
 $BEE5 SUB D           ; Subtract the sum of the fractions, to give the height.
 $BEE6 ADD A,(IY+$01)  ; Add the first offset from the template...
 $BEE9 ADD A,(IY+$03)  ; ...and also the second one.
 $BEEC SUB $0B         ; Subtract #N$0B.
 $BEEE CP $10          ; {Jump to throw the cell away if the height is less
 $BEF0 CCF             ; than #N$10.
 $BEF1 JR NC,$BEF5     ; }
 $BEF3 CP $A0          ; The carry flag is set if the height is less than
                       ; #N$A0.
@label=AddMapCells_Discard
*$BEF5 POP DE          ; Restore the position.
 $BEF6 JR NC,$BF07     ; Jump to move on to the next cell if it is out of the
                       ; window.
 $BEF8 LD (IX+$02),A   ; Store the height in the entry.
 $BEFB LD A,(IY+$00)   ; {Copy the sprite type from the template into the
 $BEFE LD (IX+$00),A   ; entry.}
 $BF01 INC IX          ; {Move on to the next entry.
 $BF03 INC IX          ;
 $BF05 INC IX          ; }
@label=AddMapCells_Next
*$BF07 LD A,B          ; {Jump if that was the last cell of the row.
 $BF08 CP H            ;
 $BF09 JR Z,$BF13      ; }
 $BF0B DEC B           ; Move on to the next cell...
 $BF0C LD A,E          ; {...which is one column to the left.
 $BF0D DEC A           ;
 $BF0E AND $3F         ;
 $BF10 LD E,A          ; }
 $BF11 JR $BEA3        ; Loop back to deal with it.
@label=AddMapCells_NextRow
*$BF13 POP DE          ; Restore the position.
 $BF14 LD A,D          ; {Move back one row.
 $BF15 DEC A           ;
 $BF16 AND $3F         ;
 $BF18 LD D,A          ; }
 $BF19 DEC C           ; {Loop back until all twelve rows have been done.
 $BF1A JP NZ,$BE8F     ; }
 $BF1D LD (IX+$00),$00 ; End the list.
 $BF21 RET             ; Return.

; Sort Draw List
;
; Used by the routine at #R$993C.
; .
; Sorts the draw list, so that the sprites that are highest up the screen
; are drawn first. Sprites at the same height are drawn from left to right. It
; is a bubble sort, which is repeated until there is a pass without any swaps.
@label=SortDrawList
c$BF22 LD A,($D358)  ; {Return if there are fewer than two entries in the list.
 $BF25 AND A         ;
 $BF26 RET Z         ; }
@label=SortDrawList_Pass
*$BF27 LD DE,$D357   ; Point #REGde at the height of the first entry.
 $BF2A LD HL,$D35A   ; Point #REGhl at #R$D35A.
 $BF2D XOR A         ; {Clear the flag that records that a swap was made.
 $BF2E EX AF,AF'     ; }
@label=SortDrawList_Compare
*$BF2F LD A,(DE)     ; Fetch the height of the first entry...
 $BF30 CP (HL)       ; ...and compare it with the height of the second.
 $BF31 DEC HL        ; {Point at the horizontal positions.
 $BF32 DEC DE        ; }
 $BF33 JR C,$BF3D    ; Jump to swap them if the first is lower.
 $BF35 JR NZ,$BF66   ; Jump if the first is higher, as they are in order.
 $BF37 LD A,(DE)     ; {Otherwise fetch the horizontal position of the first
 $BF38 LD C,A        ; entry.}
 $BF39 LD A,(HL)     ; {Compare it with the horizontal position of the second.
 $BF3A CP C          ; }
 $BF3B JR NC,$BF66   ; Jump if they are in order.
@label=SortDrawList_Swap
*$BF3D EX AF,AF'     ; {Record that a swap has been made.
 $BF3E OR $01        ;
 $BF40 EX AF,AF'     ; }
 $BF41 DEC HL        ; {Point at the types.
 $BF42 DEC DE        ; }
 $BF43 LD A,(DE)     ; {Swap the types.
 $BF44 LD C,(HL)     ;
 $BF45 LD (HL),A     ;
 $BF46 LD A,C        ;
 $BF47 LD (DE),A     ; }
 $BF48 INC DE        ; {Point at the horizontal positions.
 $BF49 INC HL        ; }
 $BF4A LD A,(DE)     ; {Swap the horizontal positions.
 $BF4B LD C,(HL)     ;
 $BF4C LD (HL),A     ;
 $BF4D LD A,C        ;
 $BF4E LD (DE),A     ; }
 $BF4F INC DE        ; {Point at the heights.
 $BF50 INC HL        ; }
 $BF51 LD A,(DE)     ; {Swap the heights.
 $BF52 LD C,(HL)     ;
 $BF53 LD (HL),A     ;
 $BF54 LD A,C        ;
 $BF55 LD (DE),A     ; }
@label=SortDrawList_Advance
*$BF56 INC DE        ; {Point at the type of the next entry.
 $BF57 INC HL        ; }
 $BF58 LD A,(HL)     ; {Jump if there are no more entries.
 $BF59 AND A         ;
 $BF5A JR Z,$BF62    ; }
 $BF5C INC DE        ; {Point at the heights of the entries.
 $BF5D INC HL        ;
 $BF5E INC DE        ;
 $BF5F INC HL        ; }
 $BF60 JR $BF2F      ; Loop back to compare them.
@label=SortDrawList_Finish
*$BF62 EX AF,AF'     ; {Go round again if any swap was made.
 $BF63 JR NZ,$BF27   ; }
 $BF65 RET           ; Return.
@label=SortDrawList_InOrder
*$BF66 INC DE        ; {Point at the heights and jump.
 $BF67 INC HL        ;
 $BF68 JR $BF56      ; }

; Draw List
;
; Used by the routine at #R$993C.
; .
; Draws every sprite in the draw list into the off-screen buffer, in
; order.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$98E0,stop=$98EC,clear=1,sp=$5E00)
; #SIM(start=$98EC,stop=$98EF)
; #SIM(start=$98EF,stop=$98F2)
; #SIM(start=$98F2,stop=$98F5)
; #SIM(start=$98F5,stop=$98F8)
; #SCR$02(draw-list-before)
; | #POKES$D355,$10;$D356,$50;$D357,$50
; #POKES$D358,$08;$D359,$78;$D35A,$70
; #POKES$D35B,$60;$D35C,$A0;$D35D,$50
; #POKES$D35E,$68;$D35F,$50;$D360,$88
; #POKES$D361,$50;$D362,$B0;$D363,$88
; #POKES$D364,$00
; #SIM(start=$99F8,stop=$99FB)
; #SIM(start=$99FB,stop=$99FE)
; #SCR$02(draw-list-after) } UDGTABLE# #POPS
@label=DrawList
c$BF6A LD IX,$D355   ; Point #REGix at the start of the draw list.
@label=DrawList_Loop
*$BF6E LD A,(IX+$00) ; {Return if the type is zero, which is the end of the
 $BF71 AND A         ; list.
 $BF72 RET Z         ; }
 $BF73 CALL $B2BC    ; Draw the sprite using #R$B2BC.
 $BF76 INC IX        ; {Move on to the next entry.
 $BF78 INC IX        ;
 $BF7A INC IX        ; }
 $BF7C JR $BF6E      ; Loop back.

; Get Entity Address
;
; Finds the address of an entity from its number. The entities are #N$10
; bytes long and this uses #N($08), so it does not work. It is not used.
;
;   A Entity number
; O:IY Address
@label=GetEntityAddress
c$BF7E PUSH BC       ; Save #REGbc.
 $BF7F LD C,A        ; {Put the entity number in #REGbc.
 $BF80 LD B,$00      ; }
 $BF82 PUSH BC       ; {Move it into #REGiy.
 $BF83 POP IY        ; }
 $BF85 ADD IY,IY     ; {Multiply it by eight.
 $BF87 ADD IY,IY     ;
 $BF89 ADD IY,IY     ; }
 $BF8B LD BC,$9690   ; {Add the address of the first entity.
 $BF8E ADD IY,BC     ; }
 $BF90 POP BC        ; Restore #REGbc.
 $BF91 RET           ; Return.

; Add A To HL
;
; Used by the routines at #R$9BCE, #R$9E55, #R$9EC6, #R$AD34, #R$B2BC and
; #R$C0DA.
; .
; Adds an 8-bit number to a 16-bit number.
;
;   A Number to add
;   HL Number to add it to
; O:HL Result
@label=AddAToHL
c$BF92 ADD A,L       ; {Add #REGa to #REGl and return if that did not carry.
 $BF93 LD L,A        ;
 $BF94 RET NC        ; }
 $BF95 INC H         ; Carry on into the high byte.
 $BF96 RET           ; Return.

; Find Map Cell
;
; Used by the routines at #R$A498, #R$A739, #R$A9DD, #R$AA1A, #R$AA58, #R$AA97
; and #R$AC64.
; .
; Finds a cell of the map from its column and row, and tests whether it is
; empty. The address of the cell is also stored. The routine returns with all of
; the registers kept, apart from #REGa and the flags.
;
;   D Column
;   H Row
; O:A Type of the cell, which is zero if it is empty
; O:F Zero flag set if the cell is empty
@label=FindMapCell
c$BF97 PUSH DE       ; {Save #REGde and #REGhl.
 $BF98 PUSH HL       ; }
 $BF99 LD E,D        ; {Move the column into #REGe and the row into #REGd.
 $BF9A LD D,H        ; }
 $BF9B JR $BF9F      ; Jump to find the cell.
; This entry point is used by the routines at #R$993C and #R$BE5F.
; .
; This entry point takes the column in #REGe and the row in #REGd.
@label=FindMapCell_ColumnRow
*$BF9D PUSH DE       ; {Save #REGde and #REGhl.
 $BF9E PUSH HL       ; }
@label=FindMapCell_Find
*$BF9F LD ($962C),DE ; Store the column and the row.
 $BFA3 XOR A         ; Clear the high part of the cell offset.
 $BFA4 SRL D         ; {Divide the row by four, keeping the bits that come out in the top of
 $BFA6 RRA           ; #REGa.
 $BFA7 SRL D         ;
 $BFA9 RRA           ; }
 $BFAA OR E          ; {Combine them with the column, to give the low byte of the offset of
 $BFAB LD E,A        ; the cell, as there are #N$40 cells in each row.}
 $BFAC LD HL,$C515   ; {Add the offset to the address of the map.
 $BFAF ADD HL,DE     ; }
 $BFB0 LD ($962E),HL ; Store the address of the cell.
 $BFB3 LD A,(HL)     ; {Fetch the type of the cell, which is in the lower four bits, and
 $BFB4 AND $0F       ; jump if it is zero.
 $BFB6 JR Z,$BFBB    ; }
@label=FindMapCell_Return
*$BFB8 POP HL        ; {Restore #REGhl and #REGde.
 $BFB9 POP DE        ; }
 $BFBA RET           ; Return.
@label=FindMapCell_Empty
*$BFBB XOR A         ; {Mark the cell as empty and jump.
 $BFBC JR $BFB8      ; }

; Unused Map Address
;
; Part of a way to find the address of a map cell that is not used. It
; does not clear #REGa first, so it would not work properly.
;
;   D Row
;   E Column
; O:HL Address of the cell
@label=MapAddress_Unused
c$BFBE SRL D         ; {Divide the row by four, keeping the bits that come out in the top of
 $BFC0 RRA           ; #REGa.
 $BFC1 SRL D         ;
 $BFC3 RRA           ; }
 $BFC4 AND $C0       ; {Combine them with the column.
 $BFC6 OR E          ;
 $BFC7 LD E,A        ; }
 $BFC8 LD HL,$C515   ; {Add the offset to the address of the map.
 $BFCB ADD HL,DE     ; }
 $BFCC RET           ; Return.

; Row Half Widths
;
; The half widths of the rows of the diamond of cells that is drawn by
; #R$BE5F, which is read from the end.
@label=RowHalfWidths
b$BFCD DEFB $00,$01,$02,$03,$04,$05,$06,$05,$04,$03,$02,$01,$00

; Play Sound Effect Step
;
; Used by the routine at #R$993C.
; .
; Called once a frame. If a sound effect is playing, one tone of it is
; made and the counter is counted down. An effect is started by storing a
; length and an effect number at #R$9688.
; #TABLE(default,centre,centre)
; { =h Effect | =h Tones | =h Started when }
; { #N$00 | #N$04 | The action key is used (#R$AC96). }
; { #N$01 | #N$05 | A program packet is sent (#R$9E45). }
; { #N$02 | #N$07 | A sector is activated (#R$A440). }
; { #N$03 | #N$04 | A program is destroyed (#R$A3F4). }
; TABLE#
; The effect number is stored and never loaded. #R$C010 takes its index from
; #REGa', which is whatever the frame left there. The lists at #R$BFF4 are used
; only when #REGa' is #N($00), #N($01), #N($02) or #N$03. At the start of play
; #REGa' is #N($50), so the first tone is read from outside those lists. The
; samples are the four effects as they sound then, one tone a frame. Effects
; #N$00 and #N$03 both ask for four tones, so they sound the same.
; #HTML(#AUDIO0(action-sound.wav)(#INCLUDE(ActionSound)))
; #HTML(#AUDIO0(program-sent-sound.wav)(#INCLUDE(ProgramSentSound)))
; #HTML(#AUDIO0(sector-activated-sound.wav)(#INCLUDE(SectorActivatedSound)))
; #HTML(#AUDIO0(program-destroyed-sound.wav)(#INCLUDE(ProgramDestroyedSound)))
@label=PlaySoundStep
c$BFDA LD HL,$9688   ; Point at the tone counter.
 $BFDD LD A,(HL)     ; {Return if no sound effect is playing.
 $BFDE AND A         ;
 $BFDF RET Z         ; }
 $BFE0 DEC (HL)      ; Count it down.
 $BFE1 EX AF,AF'     ; Keep the old counter in #REGa'.
 $BFE2 INC HL        ; Point at the effect number, which is not loaded.
 $BFE3 LD BC,$BFF4   ; Point at the table of pitch lists.
 $BFE6 CALL $C010    ; Choose a pitch list with #R$C010, using #REGa' as the
                     ; index.
 $BFE9 EX AF,AF'     ; Fetch the old counter.
 $BFEA LD C,A        ; {Use the old counter as the offset...
 $BFEB LD B,$00      ; }
 $BFED ADD HL,BC     ; ...and add it to the address.
 $BFEE LD B,(HL)     ; Fetch the pitch.
 $BFEF LD C,$0C      ; The tone is made of #N$0C cycles.
 $BFF1 JP $C05B      ; Make the tone using #R$C05B.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$C3BD }
; { #PENTAGRAM$D5F2 }
; LIST#

; Sound Effect Table
;
; The addresses of the four pitch lists. #R$BFDA uses a list only when
; #REGa' is that list's number.
@label=SoundEffectTable
w$BFF4 DEFW $BFFC
 $BFF6 DEFW $C000
 $BFF8 DEFW $C005
 $BFFA DEFW $C00C

; Sound Effect Pitches
;
; The pitches of the four sound effects, one list for each effect number.
; #R$BFDA reads a list from the end, because it adds the tone counter to the
; address of the list. It only reaches these bytes when #REGa' is #N($00),
; #N($01), #N($02) or #N$03.
@label=SoundEffectPitches
b$BFFC DEFB $40,$70,$40,$70
 $C000 DEFB $50,$70,$60,$50,$40
 $C005 DEFB $40,$50,$60,$70,$80,$80,$80
 $C00C DEFB $30,$60,$30,$60

; Get Table Entry
;
; Used by the routine at #R$BFDA.
; .
; Reads a word from a table of words.
;
;   A Index into the table
;   BC Address of the table
; O:HL The word
@label=GetTableEntry
c$C010 LD L,A        ; {Put the index in #REGhl.
 $C011 LD H,$00      ; }
 $C013 ADD HL,HL     ; Multiply it by two.
 $C014 ADD HL,BC     ; Add the address of the table.
 $C015 LD A,(HL)     ; Fetch the low byte of the word.
 $C016 INC HL        ; Point at the high byte.
 $C017 LD H,(HL)     ; Fetch it into #REGh.
 $C018 LD L,A        ; Assemble the low byte of the word.
 $C019 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$C75C }
; { #NIGHTSHADE$D589 }
; { #PENTAGRAM$D692 }
; LIST#

; Make Random Beep
;
; Used by the routine at #R$A932.
; .
; Makes a short tone of random pitch.
; #HTML(#AUDIO0(appearing-sound.wav)(#INCLUDE(AppearingSound)))
@label=MakeRandomBeep
c$C01A LD A,($9617)  ; Fetch the random number.
 $C01D AND $3F       ; {Keep it between #N$20 and #N$3F...
 $C01F OR $20        ; }
 $C021 LD B,A        ; ...to use as the pitch.
 $C022 LD C,$0C      ; The tone is made of #N$0C cycles.
 $C024 JP $C05B      ; Make the tone using #R$C05B.

; Make Beep
;
; Used by the routines at #R$9F09, #R$A04B, #R$AC30 and #R$BA93.
; .
; Makes a short beep.
; #HTML(#AUDIO0(short-beep.wav)(#INCLUDE(ShortBeep)))
@label=MakeBeep
c$C027 PUSH BC       ; Save #REGbc.
 $C028 LD BC,$8020   ; Set the pitch to #N$80 and the number of cycles to
                     ; #N$20.
 $C02B CALL $C05B    ; Make the tone using #R$C05B.
 $C02E POP BC        ; Restore #REGbc.
 $C02F RET           ; Return.

; Play Melody
;
; Plays a short melody from a list of pitches. It is not used.
@label=PlayMelody
c$C030 LD HL,$C03F   ; Point #REGhl at the melody.
@label=PlayMelody_Loop
*$C033 LD A,(HL)     ; Fetch a pitch.
 $C034 INC HL        ; Move on to the next one.
 $C035 AND A         ; {Return if it is zero, which is the end of the melody.
 $C036 RET Z         ; }
 $C037 LD B,A        ; Use it as the pitch.
 $C038 LD C,$08      ; Each tone is made of #N$08 cycles.
 $C03A CALL $C05B    ; Make the tone using #R$C05B.
 $C03D JR $C033      ; Loop back for the next one.

; Melody Data
;
; The pitches of the melody that is played by #R$C030, ended by zero.
@label=MelodyData
b$C03F DEFB $20,$40,$10,$20,$30,$40,$10,$20,$00

; Make Bump Sound
;
; Used by the routines at #R$9F09, #R$A218, #R$A4EC, #R$A833 and #R$AC30.
; .
; Makes a short, low tone.
; #HTML(#AUDIO0(low-tone.wav)(#INCLUDE(LowTone)))
@label=MakeBumpSound
c$C048 LD BC,$4030   ; Set the pitch to #N$40 and the number of cycles to
                     ; #N$30.
 $C04B JP $C05B      ; Make the tone using #R$C05B.

; Play Noise Sound
;
; Used by the routine at #R$A656.
; .
; Makes the sound of a shot. Plays #N$28 tones, each with a pitch worked
; out from a counter that counts down, so the sound falls in pitch.
; .
; #HTML(#AUDIO0(shot-sound.wav)(#INCLUDE(ShotSound)))
;
; .
;
; Play #N$28 pulses of different lengths.
@label=PlayNoiseSound
c$C04E LD C,$28      ; Use #N$28 cycles.
; This entry point is used by the routine at #R$BA19.
; .
; This entry point takes the number of pulses in #REGc.
; .
; Play the next pulse.
@label=PlayNoiseSound_Counter
*$C050 LD A,C        ; Fetch the number of the pulse.
 $C051 XOR %00111111 ; Change it.
 $C053 LD B,A        ; Use it as the length of the pulse.
 $C054 CALL $C062    ; Make a single cycle using #R$C062.
; Loop back until all of the cycles have been made.
 $C057 DEC C         ; Count down the pulses.
 $C058 JR NZ,$C050   ; Loop back until all of the pulses have been played.
 $C05A RET           ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$AF22 }
; { #NIGHTSHADE$C3AA }
; { #PENTAGRAM$D5E4 }
; { #SABREWULF$BF2F }
; LIST#

; Play Wave Sequence
;
; Used by the routines at #R$BFDA, #R$C01A, #R$C027, #R$C030, #R$C048, #R$C072
; and #R$C08D.
; .
; Makes a tone, which is made of a number of cycles.
;
; B Pitch (the higher it is, the lower the note)
; C Number of cycles
@label=PlayWaveSequence
c$C05B CALL $C062    ; Make a single cycle using #R$C062.
 $C05E DEC C         ; {Loop back until all of the cycles have been made.
 $C05F JR NZ,$C05B   ; }
 $C061 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$AF5F }
; { #PENTAGRAM$D67B }
; LIST#

; Play Square Wave
;
; Used by the routines at #R$C04E and #R$C05B.
; .
; Plays a single beep by switching the speaker on, waiting, switching it
; off and waiting again. The bigger the pitch, the longer the beep. The border
; is set to black.
;
; B Pitch
;
; Hold the speaker on, then off.
@label=PlaySquareWave
c$C062 LD A,$10      ; {Switch the speaker on.
 $C064 OUT ($FE),A   ; }
 $C066 LD A,B        ; Keep the pitch in #REGa.
@label=PlaySquareWave_FirstWait
*$C067 DJNZ $C067    ; Wait for a time that depends on the pitch.
 $C069 LD B,A        ; Restore the pitch.
 $C06A XOR A         ; {Switch the speaker off.
 $C06B OUT ($FE),A   ; }
 $C06D LD A,B        ; Keep the pitch in #REGa.
@label=PlaySquareWave_SecondWait
*$C06E DJNZ $C06E    ; Wait for the second half of the beep.
 $C070 LD B,A        ; Restore the pitch.
 $C071 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #CYBERUN$71E0 }
; { #GUNFRIGHT$AF66 }
; { #NIGHTSHADE$C471 }
; { #PENTAGRAM$D682 }
; { #PSSST$64AA }
; { #SABREWULF$BF74 }
; LIST#

; Make Explosion Sound
;
; Used by the routine at #R$9C88.
; .
; Makes a burst of noise, made of four short tones with pitches that come
; from bytes of the ROM picked at random.
; #HTML(#AUDIO0(explosion.wav)(#INCLUDE(Explosion)))
@label=MakeExplosionSound
c$C072 LD A,R        ; {Pick a random page of the ROM...
 $C074 AND $1F       ;
 $C076 LD H,A        ; }
 $C077 LD A,($9617)  ; {...and a random place in it.
 $C07A LD L,A        ; }
 $C07B LD E,$04      ; There are four tones.
@label=MakeExplosionSound_Loop
*$C07D LD A,(HL)     ; {Fetch a byte of the ROM, and move on to the next one.
 $C07E INC HL        ; }
 $C07F AND $7F       ; Keep the lower seven bits of it.
 $C081 OR $8F        ; Make sure that the pitch is at least #N$8F.
 $C083 LD B,A        ; Use it as the pitch.
 $C084 LD C,$01      ; Each tone is made of one cycle.
 $C086 CALL $C05B    ; Make the tone using #R$C05B.
 $C089 DEC E         ; {Loop back until all four tones have been made.
 $C08A JR NZ,$C07D   ; }
 $C08C RET           ; Return.

; Make Noise If Visible
;
; Used by the routines at #R$A70A and #R$A713.
; .
; Makes a burst of noise, if the entity is visible. It is made of sixteen
; short tones with pitches that come from bytes of the ROM picked at random.
; #HTML(#AUDIO0(random-noise.wav)(#INCLUDE(RandomNoise)))
;
; IX Entity
@label=MakeNoiseIfVisible
c$C08D BIT 0,(IX+$0F) ; {Return if the entity cannot be seen.
 $C091 RET Z          ; }
 $C092 LD A,R         ; {Pick a random page of the ROM...
 $C094 AND $1F        ;
 $C096 LD H,A         ; }
 $C097 LD A,($9617)   ; {...and a random place in it.
 $C09A LD L,A         ; }
 $C09B LD E,$10       ; There are sixteen tones.
@label=MakeNoiseIfVisible_Loop
*$C09D LD A,(HL)      ; {Fetch a byte of the ROM, and move on to the next one.
 $C09E INC HL         ; }
 $C09F AND $7F        ; Keep the lower seven bits of it.
 $C0A1 LD B,A         ; Use it as the pitch.
 $C0A2 LD C,$01       ; Each tone is made of one cycle.
 $C0A4 CALL $C05B     ; Make the tone using #R$C05B.
 $C0A7 DEC E          ; {Loop back until all sixteen tones have been made.
 $C0A8 JR NZ,$C09D    ; }
 $C0AA RET            ; Return.

; Read Keys
;
; Used by the routines at #R$9F09, #R$B085, #R$B0D9, #R$B103, #R$B11C, #R$B76C,
; #R$BB12 and #R$C0B6.
; .
; Reads the keyboard.
;
;   A High byte of the port (zero reads every half row)
; O:A The keys that are pressed, in bits 0 to 4
; O:F Zero flag set if no keys are pressed
@label=ReadKeys
c$C0AB PUSH BC       ; Save #REGbc.
 $C0AC LD C,$FE      ; {Set up the port.
 $C0AE LD B,A        ; }
 $C0AF IN A,(C)      ; Read the keys.
 $C0B1 POP BC        ; Restore #REGbc.
 $C0B2 CPL           ; Make a set bit mean that a key is pressed...
 $C0B3 AND $1F       ; ...and keep only the bits of the five keys.
 $C0B5 RET           ; Return.

; Play Music Until Key Pressed
;
; Used by the routine at #R$BB12.
; .
; Plays a tune, but only the first time that it is used, and stops if a
; key is pressed. The tune is a list of notes that ends with #N$FF. See #R$C0DA
; for what the notes are. After the tune has been played, nothing happens until
; #R$9637 is cleared.
; .
; The tunes played by this routine are:
; #TABLE(default,centre,centre)
; { =h Tune | =h Sound }
; { Title Tune |
; #HTML(#AUDIO0(title-tune.wav)(#INCLUDE(TitleTune))) }
; TABLE#
;
; DE The address of the tune
@label=PlayMusic_WaitKey
c$C0B6 LD HL,$9637   ; Point #REGhl at the flag that records that a tune has
                     ; been played.
 $C0B9 LD A,(HL)     ; Fetch the flag.
 $C0BA AND A         ; {Return if the tune has already been played.
 $C0BB RET NZ        ; }
 $C0BC SET 0,(HL)    ; Set the flag.
; Select every half row of the keyboard.
@label=PlayMusic_WaitKey_Loop
*$C0BE XOR A         ; {Read every row of the keyboard.
 $C0BF CALL $C0AB    ; }
 $C0C2 JR Z,$C0C5    ; Jump to #R$C0C5 if no key is pressed.
 $C0C4 RET           ; Return as a key has been pressed.
; Play the next note.
@label=PlayMusic_WaitKey_Next
*$C0C5 LD A,(DE)     ; Fetch the next note.
 $C0C6 CP $FF        ; {Jump to #R$C0D9 if the terminator has been reached.
 $C0C8 JR Z,$C0D9    ; }
 $C0CA CALL $C0DA    ; Play the note using #R$C0DA.
 $C0CD JR $C0BE      ; Loop back for the next note.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$AF76 }
; { #NIGHTSHADE$C63D }
; { #PENTAGRAM$D69C }
; LIST#

; Play Music
;
; Used by the routines at #R$9A22, #R$9A4B, #R$9AA5 and #R$BB86.
; .
; Plays a tune, which cannot be stopped. A tune is a list of notes (see
; #R$C0DA) which ends with #N$FF.
; .
; The tunes played by this routine are:
; #TABLE(default,centre,centre)
; { =h Tune | =h Sound }
; { Start Tune |
; #HTML(#AUDIO0(start-tune.wav)(#INCLUDE(StartTune))) }
; { Level Complete Tune |
; #HTML(#AUDIO0(level-complete-tune.wav)(#INCLUDE(LevelCompleteTune))) }
; { Game Over Tune |
; #HTML(#AUDIO0(game-over-tune.wav)(#INCLUDE(GameOverTune))) }
; TABLE#
;
; DE Address of the tune
;
; Play each note until #N$FF.
@label=PlayMusic
c$C0CF LD A,(DE)     ; Fetch the next note.
 $C0D0 CP $FF        ; {Jump to #R$C0D9 if it is #N$FF.
 $C0D2 JR Z,$C0D9    ; }
 $C0D4 CALL $C0DA    ; Play the note using #R$C0DA.
 $C0D7 JR $C0CF      ; Loop back for the next note.
; This entry point is used by the routine at #R$C0B6.
@label=PlayMusic_Return
*$C0D9 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B4BA }
; { #CYBERUN$9AA9 }
; { #GUNFRIGHT$AF8F }
; { #NIGHTSHADE$C656 }
; { #PENTAGRAM$D6B5 }
; { #SABREWULF$BD6E }
; LIST#

; Play Note
;
; Used by the routines at #R$C0B6 and #R$C0CF.
; .
; Plays a note of a tune, or a rest if the note number is zero.
; Bits 0 to 5 select the entry in #R$C132 that holds the two delays of a cycle
; and the number of cycles. Bits 6 and 7 are the length less one, which
; multiplies the number of cycles, so the note is one to four times as long.
;
;   A The note
;   DE Address of the note
; O:DE Address of the next note
@label=PlayNote
c$C0DA AND %00111111 ; Keep the note number.
 $C0DC JR Z,$C11C    ; Jump to make a rest if the note number is zero.
; Look up the delays and the number of cycles.
 $C0DE LD L,A        ; {Set #REGhl to the note number.
 $C0DF LD H,$00      ; }
 $C0E1 ADD HL,HL     ; Double the number.
 $C0E2 CALL $BF92    ; ...and add the note number to give three times it, using
                     ; #R$BF92.
 $C0E5 LD BC,$C132   ; {Add the address of the table of notes.
 $C0E8 ADD HL,BC     ; }
 $C0E9 LD B,(HL)     ; Fetch the first delay.
 $C0EA INC HL        ; Move on.
 $C0EB LD C,(HL)     ; Fetch the second delay.
 $C0EC INC HL        ; Move on.
 $C0ED LD L,(HL)     ; Fetch the number of cycles of the shortest note.
 $C0EE LD H,$00      ; Set #REGh to #N$00.
; Bits 6 and 7 are the length, less one.
 $C0F0 LD A,(DE)     ; Fetch the note again.
 $C0F1 RLCA          ; {Move bits 6 and 7 to bits 0 and 1.
 $C0F2 RLCA          ; }
 $C0F3 AND %00000011 ; Keep bits 0 and 1.
 $C0F5 INC A         ; Add one.
 $C0F6 PUSH DE       ; Save the address of the note.
 $C0F7 LD E,L        ; {Copy the number of cycles of the shortest note into
 $C0F8 LD D,H        ; #REGde.}
; Multiply the number of cycles by the length.
@label=PlayMusic_Process_Multiply
*$C0F9 DEC A         ; Count down the length.
 $C0FA JR Z,$C0FF    ; Jump to #R$C0FF if the length has been used up.
 $C0FC ADD HL,DE     ; Otherwise add on the number of cycles of the shortest
                     ; note again...
 $C0FD JR $C0F9      ; Jump to #R$C0F9.
@label=PlayMusic_Process_Finished
*$C0FF POP DE        ; Restore the note address from the stack.
; Each pass makes one cycle of the note.
@label=PlayMusic_Process_Cycle
*$C100 PUSH BC       ; Stash the delays on the stack.
 $C101 XOR A         ; Set #REGa to #N$00.
 $C102 OUT ($FE),A   ; Turn the speaker off.
@label=PlayMusic_Process_LowWait
*$C104 DJNZ $C104    ; Wait for the time of the low half of a cycle...
; Count down the rest of the delay.
 $C106 DEC C         ; Count down the second delay.
 $C107 JR NZ,$C104   ; Jump to #R$C104 until it has finished.
 $C109 POP BC        ; Restore the delays from the stack.
 $C10A PUSH BC       ; Stash the delays on the stack.
 $C10B LD A,$10      ; Set bit 4.
 $C10D OUT ($FE),A   ; Turn the speaker on.
@label=PlayMusic_Process_HighWait
*$C10F DJNZ $C10F    ; Wait for the time of the high half of a cycle...
; Count down the rest of the delay.
 $C111 DEC C         ; Count down the second delay.
 $C112 JR NZ,$C10F   ; Jump to #R$C10F until it has finished.
 $C114 POP BC        ; Restore the delays from the stack.
; Count down the number of cycles, and loop back until it reaches zero.
 $C115 DEC HL        ; Count down the cycles.
 $C116 LD A,H        ; {Jump to #R$C100 until all of the cycles have been
 $C117 OR L          ; played.
 $C118 JR NZ,$C100   ; }
 $C11A INC DE        ; Move on to the next note.
 $C11B RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B4C5 }
; { #CYBERUN$9AB4 }
; { #GUNFRIGHT$AF9A }
; { #NIGHTSHADE$C661 }
; { #PENTAGRAM$D6C0 }
; { #SABREWULF$BD7B }
; LIST#

; Play Rest
;
; Used by the routine at #R$C0DA.
; .
; Waits for the length of a rest, which is one to four times as long as
; the shortest. It is used by #R$C0DA.
;
;   DE The address of the rest
; O:DE The address after the rest
;
; Work out the length of the rest in beats.
@label=PlayRest
c$C11C LD A,(DE)     ; Fetch the rest.
 $C11D INC DE        ; Move on to the next note.
 $C11E RLCA          ; {Rotate the length bits into the bottom of the byte.
 $C11F RLCA          ; }
 $C120 AND %00000011 ; Keep them.
 $C122 INC A         ; Add one to get the length in beats.
 $C123 LD L,A        ; Copy the length into #REGl.
 $C124 LD BC,$430B   ; Set the length of a beat.
; Wait for each beat.
@label=PlayRest_Loop
*$C127 PUSH BC       ; Stash the length of a beat on the stack.
@label=PlayRest_Wait
*$C128 DEC BC        ; Count down.
 $C129 LD A,B        ; {Jump to #R$C128 if the count is not zero.
 $C12A OR C          ;
 $C12B JR NZ,$C128   ; }
 $C12D POP BC        ; Retrieve the length of a beat.
; Loop back until the length has been counted down.
 $C12E DEC L         ; Count down the beats.
 $C12F JR NZ,$C127   ; Loop back until the rest is over.
 $C131 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$AFDC }
; LIST#

