 $DFFA DEFB $00,$00,$00,$00,$00,$00

; Shift Tables
;
; The tables that are used to shift the bytes of a sprite to the right by
; one to seven pixels, which are built by #R$B294. There are two pages for each
; shift, which hold the low bytes and the high bytes of each byte of the sprite
; when it is shifted. The page for the low bytes starts at #N$EF00 for no shift,
; and moves down by two pages for each pixel of shift. The page below it is for
; the high bytes.
@label=ShiftTables
g$E000 DEFS $0100
 $E100 DEFS $0100
 $E200 DEFS $0100
 $E300 DEFS $0100
 $E400 DEFS $0100
 $E500 DEFS $0100
 $E600 DEFS $0100
 $E700 DEFS $0100
 $E800 DEFS $0100
 $E900 DEFS $0100
 $EA00 DEFS $0100
 $EB00 DEFS $0100
 $EC00 DEFS $0100
 $ED00 DEFS $0100
 $EE00 DEFS $0100
 $EF00 DEFS $0100

; Reversed Bytes
;
; The table that gives each byte with its bits in the opposite order,
; which is built by #R$B294 and used to flip a sprite.
@label=ReversedBytes
g$F000 DEFS $0100

; Unused Memory
;
; This area is not used.
@label=UnusedMemory
g$F100 DEFS $0480

; Play Window Buffer
;
; The off-screen buffer that the play window is drawn into, which is
; copied to the screen by #R$B21C. It is #N$70 lines of #N$18 bytes, and the
; first line is at the bottom of the window. Only the middle #N$14 bytes of each
; line are shown, as there are margins of two bytes at each end. The snapshot
; has some left over contents.
@label=PlayWindowBuffer
