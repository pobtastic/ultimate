[Graphics:Font]
The characters that are used for the text (see #R$C33C).
#UDGTABLE
  { #UDGARRAY16,attr=$47,scale=4($C33C-$C3B4-$08)(font-symbols) }
  { #UDGARRAY10,attr=$47,scale=4($C3BC-$C404-$08)(font-digits) }
  { #UDGARRAY26,attr=$47,scale=4($C444-$C50C-$08)(font-letters) }
UDGTABLE#

[Graphics:Unused Figure]
Nothing gives an entity type #N$02 or #N$03. No map cell uses them.
#UDGTABLE(default,centre,centre,centre,centre)
  { =h,c2 Type #N$02 | =h,c2 Type #N$03 }
  { #SPRITE$02(unused-figure-01*) | #SPRITE$03(unused-figure-02*) }
UDGTABLE#

[Graphics:Battery]
Map cells of type #N$03. Entity types #N$06 and #N$07 both use this picture.
#UDGTABLE(default,centre)
  { #SPRITE$06(battery*) }
UDGTABLE#

