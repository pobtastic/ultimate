;
; SkoolKit ref file for Martianoids
;
; To build the HTML disassembly, run these commands:
;   tap2sna.py @martianoids.t2s
;   sna2skool.py -H -c sources/martianoids/martianoids.ctl Martianoids.z80 \
;     > sources/martianoids/martianoids.skool
;   skool2html.py -H sources/martianoids/martianoids.skool -T dark -T wide -toOa

