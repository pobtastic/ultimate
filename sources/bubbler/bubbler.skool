 $59E0 DEFB $46,$4E,$4E,$4E,$4E,$66,$66,$6E,$46,$6E,$6E,$46,$46,$46,$46,$46,$46,$46,$46,$46,$46,$4E,$4E,$4E,$4E,$4E,$4E,$46,$46,$46,$46,$46 ;
 $5A00 DEFB $46,$4E,$4E,$4E,$4E,$66,$66,$46,$46,$46,$46,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$46,$46,$46,$46,$4E,$4E,$46,$46,$46,$46,$46 ;
 $5A20 DEFB $46,$4E,$4E,$4E,$4E,$46,$46,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$46,$46,$46,$46,$46,$46,$46 ;
