 $5A80 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00 ;
 $5AA0 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00 ;
 $5AC0 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00 ;
 $5AE0 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00 ; }

i$5B00

; Title Animation Frame
;
; The frame of the highlight animation of the title menu, which is set to
; #N$00 by #R$60FE(#N$6148) and used by #R$60FE(#N$61D3).
@label=TitleAnimationFrame
g$5CB8 DEFB $A8

; Cell Position
;
; In the game, this is the position of the cell of the level whose objects
; are being drawn, which is set by #R$BB0F and used by #R$BB3C. On the title
; menu, the first byte is the low byte of the address of the attribute that is
; highlighted (see #R$60FE(#N$6150)) and the second byte is the last value of
; FRAMES that was seen (see #R$61BD).
@label=CellPosition
g$5CB9 DEFB $10
 $5CBA DEFB $4B

; Strip Address
;
; The address in the view buffer of the strip that is being built by
; #R$AA5B, which is used when the blocks are drawn and is changed by the
; routines that scroll the view.
@label=StripAddress
g$5CBB DEFW $09F4

i$5CBD

; Scratch Value
;
; A value that is used for several purposes. The heading of the player is
; kept here, which is shown by #R$A724. The stack pointer is saved here by
; #R$A8D1 and #R$A8E1. Purpose of the other uses is not yet known.
@label=ScratchValue
g$5CD8 DEFW $5E00

; Saved Stack Pointer
;
; The stack pointer is kept here while the drawing routines use it to read
; data, for example #R$B43C and #R$C59A(#N$C5E5).
@label=SavedStackPointer
g$5CDA DEFW $3A00

; Drawing Position
;
; A word that is used for several purposes, including the details of the
; record that is added by #R$B1FF and the position of the tip of the needle of
; the direction gauge (see #R$A724). Purpose of the other uses is not yet
; known.
@label=DrawingPosition
g$5CDC DEFW $30DA

; Game Variable
;
; A byte that is stored by #R$AB0F(#N$AB21) and used by #R$5F9E(#N$5FA9)
; and #R$CDF8. Purpose not yet known.
@label=GameVariable
g$5CDE DEFB $0E

i$5CDF

; View Position
;
; The position of the view, as two words. It is set by #R$86F9 when a
; level is started and is changed when the view is moved (see #R$B8F9). The
; high bytes at #N$5CE3 and #N$5CE5 are used by #R$BB0F as the position of the
; player.
@label=ViewPosition
g$5CE2 DEFW $0000
 $5CE4 DEFW $E73A

; View Flags
;
; The flags that record which way the view is scrolling. They are set by
; the scroll routines and tested by #R$CC71. Bits 0-1 scroll left, bits 2-3
; scroll right, bits 4-5 scroll down and bits 6-7 scroll up. #N$01 in a pair is
; one pixel a frame and #N$02 is two pixels.
@label=ViewFlags
g$5CE6 DEFB $30

; View Origin Sum
;
; The sum of the two values of the position of the view plus #N$80, which
; is worked out by #R$AA5B. It is used with #R$5CEE as the origin of the view
; on the screen when the position of an entity is worked out by #R$AE0D.
@label=ViewOriginSum
g$5CE7 DEFW $000E

; Scroll Value
;
; A byte that is used by the routines that scroll the view (see #R$C7E8
; and #R$C873) and by #R$E461(#N$E463). Purpose not yet known.
@label=ScrollValue
g$5CE9 DEFB $00

; Entity Speed
;
; The speed of the entity that is being moved. Its high byte is multiplied
; by the direction by #R$CF5B.
@label=EntitySpeed
g$5CEA DEFW $0000

; Player Screen Position
;
; The previous value of the screen position of the player, which is kept
; by #R$ADF9, followed by the change in the value.
@label=PlayerScreenPosition
g$5CEC DEFB $00
 $5CED DEFB $3A

; View Origin Difference
;
; The difference of the halves of the two values of the position of the
; view, which is worked out by #R$AA5B. It is used with #R$5CE7 as the origin
; of the view on the screen.
@label=ViewOriginDifference
g$5CEE DEFW $37D9

; Drawing Flags
;
; The flags that are used when blocks are drawn. If bits 1 and 2 are zero
; then #R$C76D draws the bytes of a row plain, and otherwise it shifts them.
; Purpose of the other bits is not yet known.
@label=DrawingFlags
g$5CF0 DEFB $0E

; Saved IY
;
; The value of #REGiy that is saved by #R$5E00(#N$5E04), because the ROM
; interrupt routine needs it to point at the system variables. It is restored
; whenever the ROM is used.
@label=SavedIY
g$5CF1 DEFW $0000

; Record Details
;
; Details of the record that is being added by #R$B1FF and of the object
; that is being drawn, which include the sizes that are used by #R$B9F3.
; Purpose of the individual bytes is not yet known.
@label=RecordDetails
g$5CF3 DEFB $07
 $5CF4 DEFB $00
 $5CF5 DEFB $00

; Turning Rate
;
; The rate of turning of the player, which builds up while a turn control
; is held (see #R$AB0F).
@label=TurningRate
g$5CF6 DEFW $FB3A

i$5CF8

; Level Header Address
;
; The address of the header of the data of the current level, which is set
; by #R$86F9 and used to find the map and the path entries (see #R$87D3).
@label=LevelHeaderAddress
g$5CFE DEFW $0000

; Jump Counter
;
; The counter that is used for the player jumping and for the death of the
; player (see #R$CD11). Purpose of its values is not yet known.
@label=JumpCounter
g$5D00 DEFB $0A

i$5D01

; Game Entry
;
; The entry point of the game, started by the loader. It moves the title
; sequence code and graphics out of the way, runs the title sequence and then
; builds three lookup tables for the sprite routines before handing over to the
; game proper at #R$DFF0.
; .
; The title sequence (the code at #N$F512) does not return by itself: when a key
; is pressed it leaves through #R$E42F, which ends by returning to the
; instruction after the call at #N$5E27.
;
; .
;
; Set up the machine.
@label=GameEntry
c$5E00 DI            ; Disable interrupts.
 $5E01 LD SP,$5B70   ; Put the stack just below the game variables.
 $5E04 LD ($5CF1),IY ; Remember #REGiy in #R$5CF1, as the ROM interrupt routine needs it to
                     ; point at the system variables.
 $5E08 XOR A         ; {Set the border colour to black.
 $5E09 OUT ($FE),A   ; }
; Move the title sequence out of the game data.
 $5E0B LD DE,$F500   ; #REGde is #N$F500 (the destination).
 $5E0E LD HL,$E5BB   ; Set #REGhl to #R$E5BB (the source).
 $5E11 LD BC,$0200   ; #REGbc is #N$0200 (the number of bytes to copy).
 $5E14 LDIR          ; Copy the title sequence code.
 $5E16 LD DE,$F700   ; #REGde is #N$F700 (the destination).
 $5E19 LD HL,$E696   ; Set #REGhl to #R$E5BB(#N$E696) (the source).
 $5E1C LD BC,$0800   ; #REGbc is #N$0800 (the number of bytes to copy).
 $5E1F LDIR          ; Copy the title sequence graphics.
; Run the title sequence.
 $5E21 CALL $A8E1    ; Call #R$A8E1 to clear the pixels of the screen.
 $5E24 CALL $A8D1    ; Call #R$A8D1 to set the attributes of the lower two thirds of the
                     ; screen to bright white on black.
 $5E27 CALL $F512    ; Call the title sequence.
; Build the bit reversal table at #N$F900.
 $5E2A LD HL,$F900   ; #REGhl is #N$F900 (the start of the table).
 $5E2D LD C,$00      ; Set the table index in #REGc to #N$00.
@label=GameEntry_BuildReverseTable
*$5E2F LD B,$08      ; Set the bit counter in #REGb to #N$08.
 $5E31 LD D,C        ; Copy the table index into #REGd.
 $5E32 XOR A         ; Clear the reversed value in #REGa.
@label=GameEntry_ReverseBits
*$5E33 SLA D         ; Shift the top bit of #REGd out into the carry flag.
 $5E35 RR A          ; Rotate the carry flag into the top of the reversed
                     ; value.
 $5E37 DJNZ $5E33    ; Decrease the bit counter by one and loop back to #R$5E33 until all
                     ; eight bits have been reversed.
 $5E39 LD (HL),A     ; Store the reversed value in the table.
 $5E3A INC HL        ; Move onto the next table entry.
 $5E3B INC C         ; Move onto the next table index.
 $5E3C JR NZ,$5E2F   ; Jump back to #R$5E2F until all #N$0100 entries have been
                     ; written.
; Build the three pairs of shift tables at #N$FA00, #N$FC00 and #N$FE00.
; For every byte value, the first table of a pair holds the byte shifted right
; and inverted, and the second table holds the inverted bits which were shifted
; out. The shifts are two, four and six pixels.
 $5E3E LD B,$02      ; Start with a shift of two pixels.
@label=GameEntry_BuildShiftTables
*$5E40 LD C,$00      ; Start with the byte value #N$00.
@label=GameEntry_BuildShiftEntry
*$5E42 LD D,C        ; Copy the byte value into #REGd.
 $5E43 LD E,B        ; Copy the shift count into #REGe.
 $5E44 XOR A         ; Clear the bits which are shifted out, in #REGa.
@label=GameEntry_ShiftByte
*$5E45 SRL D         ; Shift #REGd right by one pixel.
 $5E47 RR A          ; Rotate the bit which fell off into the top of #REGa.
 $5E49 DEC E         ; {Decrease the shift count by one and loop back to #R$5E45 until the
 $5E4A JR NZ,$5E45   ; byte has been shifted.}
 $5E4C INC H         ; Move onto the second table of the pair.
 $5E4D CPL           ; Invert the bits which were shifted out.
 $5E4E LD (HL),A     ; Store them in the second table.
 $5E4F DEC H         ; Go back to the first table of the pair.
 $5E50 LD A,D        ; Fetch the shifted byte.
 $5E51 CPL           ; Invert it.
 $5E52 LD (HL),A     ; Store it in the first table.
 $5E53 INC HL        ; Move onto the next table entry.
 $5E54 INC C         ; Move onto the next byte value.
 $5E55 JR NZ,$5E42   ; Jump back to #R$5E42 until all #N$0100 byte values have
                     ; been done.
 $5E57 INC H         ; Move past the second table of the pair.
 $5E58 INC B         ; {Increase the shift by two pixels.
 $5E59 INC B         ; }
 $5E5A LD A,B        ; Fetch the shift.
 $5E5B CP $08        ; {Jump back to #R$5E40 until the shifts of two, four and six pixels
 $5E5D JR NZ,$5E40   ; have all been done.}
 $5E5F JP $DFF0      ; Start the game.

; Ending Window Fill
;
; A rectangle description for #R$AAE8 which blanks the attributes of the
; game window.
@label=EndingWindow_Fill
b$5E62 DEFB $14      ; Width of the window in characters.
 $5E63 DEFB $0E      ; Height of the window in characters.
 $5E64 DEFB $00      ; Attribute: #COLOUR(#PEEK(#PC)).

; Show Ending
;
; Used by the routine at #R$DFF0.
; .
; Used when all five levels have been completed. It prints the
; congratulation message over the game window, saves the window and clears it,
; and then scrolls the saved picture back in underneath the message. After a
; long pause the message flashes, with a clicking sound which rises in pitch,
; and the window is scrolled away by #R$E42F.
;
; .
;
; Reset the level number and print the message.
@label=ShowEnding
c$5E65 XOR A         ; Clear #REGa.
 $5E66 LD ($DEDF),A  ; Write #N$00 to #R$DEDF, to make the next game start on the first
                     ; level.
 $5E69 LD DE,$5E62   ; Point #REGde at the rectangle description at #R$5E62.
 $5E6C LD HL,$7730   ; Set #REGhl to the position of the bottom left of the
                     ; game window.
 $5E6F CALL $AAE8    ; Call #R$AAE8 to blank the attributes of the game window, so the
                     ; message cannot be seen yet.
 $5E72 LD DE,$5F0F   ; Point #REGde at the message at #R$5F0C(#N$5F0F).
 $5E75 LD B,$07      ; Set the number of lines in the message in #REGb to
                     ; #N$07.
 $5E77 CALL $E1BD    ; Call #R$E1BD to print the message.
; Save the picture in the game window into the view buffer, clearing the
; window as it goes.
 $5E7A LD HL,$0810   ; Set #REGhl to the position of the top left of the game window in the
                     ; view buffer.
 $5E7D CALL $E59E    ; Call #R$E59E to find the address in the view buffer.
 $5E80 EX DE,HL      ; Move it into #REGde.
 $5E81 LD HL,$4026   ; Point #REGhl at the top left of the game window on the
                     ; screen.
 $5E84 LD C,$70      ; Set the scanline counter in #REGc to #N$70.
@label=ShowEnding_SaveLine
*$5E86 LD B,$14      ; Set the line length in #REGb to #N$14 bytes.
 $5E88 PUSH HL       ; Stash the screen address on the stack.
@label=ShowEnding_SaveByte
*$5E89 LD A,(HL)     ; Fetch a byte of the screen.
 $5E8A LD (DE),A     ; Store it in the view buffer.
 $5E8B LD (HL),$00   ; Clear the byte of the screen.
 $5E8D INC HL        ; Move onto the next byte of the screen.
 $5E8E INC DE        ; Move onto the next byte of the view buffer.
 $5E8F DJNZ $5E89    ; Decrease the line length by one and loop back to #R$5E89 until the
                     ; whole line has been saved.
 $5E91 INC DE        ; {Skip the four unused bytes at the end of the line in the view
 $5E92 INC DE        ; buffer.
 $5E93 INC DE        ;
 $5E94 INC DE        ; }
 $5E95 POP HL        ; Restore the screen address.
 $5E96 INC H         ; Move down a scanline.
 $5E97 LD A,H        ; {Jump to #R$5EA6 unless the new scanline is the start of a new
 $5E98 AND $07       ; character row.
 $5E9A JR NZ,$5EA6   ; }
 $5E9C LD A,L        ; {Move onto the next character row.
 $5E9D ADD A,$20     ;
 $5E9F LD L,A        ; }
 $5EA0 JR C,$5EA6    ; Jump to #R$5EA6 if the row is still in the same third of
                     ; the screen.
 $5EA2 LD A,H        ; {Move into the next third of the screen.
 $5EA3 SUB $08       ;
 $5EA5 LD H,A        ; }
@label=ShowEnding_NextLine
*$5EA6 DEC C         ; {Decrease the scanline counter by one and jump back to #R$5E86 until
 $5EA7 JR NZ,$5E86   ; all #N$70 scanlines have been saved.}
; Make the message visible and scroll the saved picture back in.
 $5EA9 LD DE,$5F0C   ; Point #REGde at the rectangle description at #R$5F0C.
 $5EAC LD HL,$7730   ; Set #REGhl to the position of the bottom left of the
                     ; game window.
 $5EAF CALL $AAE8    ; Call #R$AAE8 to make the attributes of the game window
                     ; bright white.
 $5EB2 CALL $E461    ; Call #R$E461 to scroll the saved picture into the
                     ; window.
; Wait while checking for the pause keys.
 $5EB5 LD B,$02      ; Set the number of long waits in #REGb to #N$02.
@label=ShowEnding_Wait
*$5EB7 PUSH BC       ; Stash the long wait counter on the stack.
 $5EB8 LD DE,$0000   ; Start the short wait counter in #REGde at #N$0000.
@label=ShowEnding_WaitLoop
*$5EBB PUSH DE       ; Stash the short wait counter on the stack.
 $5EBC CALL $A837    ; Call #R$A837 to check for the pause keys.
 $5EBF POP DE        ; Restore the short wait counter from the stack.
 $5EC0 DEC DE        ; Decrease the short wait counter by one.
 $5EC1 LD A,D        ; {Jump back to #R$5EBB until the high byte of the counter
 $5EC2 OR D          ; is zero.
 $5EC3 JR NZ,$5EBB   ; }
 $5EC5 POP BC        ; Restore the long wait counter from the stack.
 $5EC6 DJNZ $5EB7    ; Decrease the long wait counter by one and jump back to #R$5EB7 until
                     ; both long waits are over.
; Flash the message.
 $5EC8 LD B,$18      ; Set the flash counter in #REGb to #N$18.
 $5ECA LD IY,($5CF1) ; Bring back #REGiy from #R$5CF1.
@label=ShowEnding_Flash
*$5ECE PUSH BC       ; Stash the flash counter on the stack.
 $5ECF LD A,B        ; Copy the flash counter into #REGa.
 $5ED0 ADD A,A       ; {Multiply it by four...
 $5ED1 ADD A,A       ; }
 $5ED2 LD ($5EE9),A  ; ...and store it in the operand of the instruction at
                     ; #R$5E65(#N$5EE8).
 $5ED5 LD ($5EFF),A  ; Store it in the operand of the instruction at
                     ; #R$5E65(#N$5EFE) too.
 $5ED8 XOR A         ; {Write #N$00 to the attribute of the rectangle description at
 $5ED9 LD ($5F0E),A  ; #R$5F0C.}
; Hide the message and click.
 $5EDC EI            ; Enable interrupts.
 $5EDD HALT          ; Wait for the next frame.
 $5EDE DI            ; Disable interrupts.
 $5EDF LD HL,$7730   ; Set #REGhl to the position of the bottom left of the
                     ; game window.
 $5EE2 LD DE,$5F0C   ; Point #REGde at the rectangle description at #R$5F0C.
 $5EE5 CALL $AAE8    ; Call #R$AAE8 to make the attributes of the game window
                     ; black.
 $5EE8 LD B,$00      ; Set the length of the click.
 $5EEA CALL $9E93    ; Call #R$9E93 to click the speaker.
; Show the message and click.
 $5EED EI            ; Enable interrupts.
 $5EEE HALT          ; Wait for the next frame.
 $5EEF DI            ; Disable interrupts.
 $5EF0 LD A,$47      ; {Write #N$47 to the attribute of the rectangle description at
 $5EF2 LD ($5F0E),A  ; #R$5F0C.}
 $5EF5 LD HL,$7730   ; Set #REGhl to the position of the bottom left of the
                     ; game window.
 $5EF8 LD DE,$5F0C   ; Point #REGde at the rectangle description at #R$5F0C.
 $5EFB CALL $AAE8    ; Call #R$AAE8 to make the attributes of the game window
                     ; bright white.
 $5EFE LD B,$00      ; Set the length of the click.
 $5F00 CALL $9E93    ; Call #R$9E93 to click the speaker.
 $5F03 CALL $A837    ; Call #R$A837 to check for the pause keys.
 $5F06 POP BC        ; Restore the flash counter from the stack.
 $5F07 DJNZ $5ECE    ; Decrease the flash counter by one and jump back to #R$5ECE until the
                     ; message has flashed #N$18 times.
 $5F09 JP $E42F      ; Jump to #R$E42F to scroll the window away.

; Ending Message
;
; The message shown when the game has been completed.
;
; .
;
; The rectangle description for #R$AAE8, which makes the attributes of the
; game window bright white.
@label=EndingMessage
b$5F0C DEFB $14                             ; Width of the window in
                                            ; characters.
 $5F0D DEFB $0E                             ; Height of the window in
                                            ; characters.
 $5F0E DEFB $47                             ; Attribute: #COLOUR(#PEEK(#PC)).
; The seven lines of the message, as text records for #R$E1BD.
@label=EndingMessage_Lines
 $5F0F DEFB $40,$17                         ; Position: x=#N$40, y=#N$17.
 $5F11 DEFB $00                             ; Attribute: #COLOUR(#PEEK(#PC)).
 $5F12 DEFB $8F                             ; Length #N$0F, double height.
 $5F13 DEFB $0C,$18,$17,$10,$1B,$0A,$1D,$1E ; {"CONGRATULATIONS"
 $5F1B DEFB $15,$0A,$1D,$12,$18,$17,$1C     ; }
 $5F22 DEFB $40,$27                         ; Position: x=#N$40, y=#N$27.
 $5F24 DEFB $00                             ; Attribute: #COLOUR(#PEEK(#PC)).
 $5F25 DEFB $10                             ; Length #N$10.
 $5F26 DEFB $22,$18,$1E,$27,$11,$0A,$1F,$0E ; {"YOU HAVE ESCAPED"
 $5F2E DEFB $27,$0E,$1C,$0C,$0A,$19,$0E,$0D ; }
 $5F36 DEFB $38,$37                         ; Position: x=#N$38, y=#N$37.
 $5F38 DEFB $00                             ; Attribute: #COLOUR(#PEEK(#PC)).
 $5F39 DEFB $12                             ; Length #N$12.
 $5F3A DEFB $0F,$1B,$18,$16,$27,$1F,$0A,$0D ; {"FROM VADRAS PRISON"
 $5F42 DEFB $1B,$0A,$1C,$27,$19,$1B,$12,$1C ;
 $5F4A DEFB $18,$17                         ; }
 $5F4C DEFB $38,$45                         ; Position: x=#N$38, y=#N$45.
 $5F4E DEFB $00                             ; Attribute: #COLOUR(#PEEK(#PC)).
 $5F4F DEFB $11                             ; Length #N$11.
 $5F50 DEFB $22,$18,$1E,$1B,$27,$17,$0E,$21 ; {"YOUR NEXT MISSION"
 $5F58 DEFB $1D,$27,$16,$12,$1C,$1C,$12,$18 ;
 $5F60 DEFB $17                             ; }
 $5F61 DEFB $40,$55                         ; Position: x=#N$40, y=#N$55.
 $5F63 DEFB $00                             ; Attribute: #COLOUR(#PEEK(#PC)).
 $5F64 DEFB $0F                             ; Length #N$0F.
 $5F65 DEFB $12,$1C,$27,$1D,$18,$27,$18,$1F ; {"IS TO OVERTHROW"
 $5F6D DEFB $0E,$1B,$1D,$11,$1B,$18,$20     ; }
 $5F74 DEFB $38,$65                         ; Position: x=#N$38, y=#N$65.
 $5F76 DEFB $00                             ; Attribute: #COLOUR(#PEEK(#PC)).
 $5F77 DEFB $12                             ; Length #N$12.
 $5F78 DEFB $1F,$0A,$0D,$1B,$0A,$27,$0A,$17 ; {"VADRA AND FREE THE"
 $5F80 DEFB $0D,$27,$0F,$1B,$0E,$0E,$27,$1D ;
 $5F88 DEFB $11,$0E                         ; }
 $5F8A DEFB $50,$75                         ; Position: x=#N$50, y=#N$75.
 $5F8C DEFB $00                             ; Attribute: #COLOUR(#PEEK(#PC)).
 $5F8D DEFB $0C                             ; Length #N$0C.
 $5F8E DEFB $12,$1B,$14,$18,$17,$27,$19,$0E ; {"IRKON PEOPLE"
 $5F96 DEFB $18,$19,$15,$0E                 ; }

; Random Number State
;
; The state of the random number generator at #R$5F9E.
@label=RandomNumber_Seed
g$5F9A DEFW $8E17    ; The seed, which changes every time a number is made.
 $5F9C DEFW $8000    ; The address of the next byte of game memory to mix into
                     ; the seed.

; Get Random Number
;
; Used by the routines at #R$97AE, #R$99FD, #R$9A0A and #R$E4CC.
; .
; Makes a pseudo-random number by mixing the byte at a moving address in
; the game memory into a seed. The address moves on by one byte each time and
; wraps within #N$8000-#N$9FFF.
;
; O:A The high byte of the new seed
; O:DE The new seed
@label=GetRandomNumber
c$5F9E LD DE,($5F9A) ; Fetch the seed.
 $5FA2 LD HL,($5F9C) ; Fetch the address of the byte of game memory to mix in.
; Make the new low byte.
 $5FA5 LD A,(HL)     ; Fetch the byte of game memory.
 $5FA6 ADD A,$05     ; Add #N$05 to it.
 $5FA8 LD B,A        ; Store the result in #REGb.
 $5FA9 LD A,($5CDE)  ; Fetch the game variable at #R$5CDE.
 $5FAC ADD A,B       ; Add the byte from game memory.
 $5FAD ADD A,E       ; Add the low byte of the seed.
 $5FAE LD E,A        ; Make it the new low byte of the seed.
; Make the new high byte.
 $5FAF LD A,(HL)     ; Fetch the byte of game memory again.
 $5FB0 CPL           ; Invert it.
 $5FB1 ADD A,$16     ; Add #N$16.
 $5FB3 ADD A,D       ; Add the high byte of the seed.
 $5FB4 ADD A,L       ; Add the low byte of the address.
 $5FB5 LD D,A        ; Make it the new high byte of the seed.
 $5FB6 LD ($5F9A),DE ; Store the new seed.
; Move the address on.
 $5FBA INC HL        ; Move onto the next byte of game memory.
 $5FBB LD A,H        ; Fetch the high byte of the address.
 $5FBC AND %10011111 ; Keep the address within #N$8000-#N$9FFF.
 $5FBE LD H,A        ; Put the high byte back.
 $5FBF LD ($5F9C),HL ; Store the address.
 $5FC2 RET           ; Return.

; Title Tune
;
; The tune which plays while the title menu is shown, for #R$A1B2. Each
; byte is a note number for the table at #R$A226, with #N$00 being a rest. The
; top two bits of each byte are not used. The tune is ended by #N$FF.
@label=TitleTune
b$5FC3 DEFB $14,$16,$22,$25,$22,$29,$22,$25,$18,$19,$20,$25,$20,$29,$20,$25
 $5FD3 DEFB $13,$14,$20,$24,$20,$27,$20,$24,$1A,$1B,$1F,$22,$1F,$27,$1F,$22
 $5FE3 DEFB $14,$16,$22,$25,$22,$29,$22,$25,$18,$19,$20,$25,$20,$29,$20,$25
 $5FF3 DEFB $13,$14,$20,$24,$20,$27,$20,$24,$1A,$1B,$2B,$29,$27,$25,$2B,$22
 $6003 DEFB $1F,$20,$14,$16,$22,$25,$22,$29,$22,$25,$18,$19,$20,$25,$20,$29
 $6013 DEFB $20,$25,$13,$14,$20,$24,$20,$27,$20,$24,$1A,$1B,$1F,$22,$1F,$27
 $6023 DEFB $1F,$22,$14,$16,$22,$25,$22,$29,$22,$25,$18,$19,$20,$25,$20,$29
 $6033 DEFB $20,$25,$13,$14,$20,$24,$20,$27,$20,$24,$1A,$1B,$2B,$29,$27,$25
 $6043 DEFB $2B,$22,$1F,$20
 $6047 DEFB $FF                                                             ; End of the
                                                                            ; tune.

; Start Tune
;
; The short tune which plays when the game is started from the title menu,
; for #R$A1C1. It uses the same format as the title tune (see #R$5FC3).
@label=StartTune
b$6048 DEFB $25,$20,$1D,$25,$22,$1E,$25,$1E,$1B,$25,$20,$1D,$25,$24,$25,$20
 $6058 DEFB $1D,$25,$22,$1E,$25,$1E,$1B,$25,$20,$1D,$25,$24,$25
 $6065 DEFB $FF                                                             ; End of the
                                                                            ; tune.

; Title Logo
;
; The BUBBLER logo of the title menu, for #R$AAC4. The rows are stored
; from the bottom of the picture up.
@label=TitleLogo
b$6066 DEFB $08                             ; Width of the picture in bytes.
 $6067 DEFB $10                             ; Height of the picture in rows.
 $6068 DEFB $0F,$83,$E7,$E7,$F7,$FB,$F6,$0C ; {#PICTUREDATA(title-logo*)
 $6070 DEFB $3F,$E7,$F7,$FB,$FB,$FD,$F7,$1E ;
 $6078 DEFB $7F,$F7,$FB,$FD,$FD,$FD,$F7,$1E ;
 $6080 DEFB $7F,$F7,$FB,$FD,$FD,$F3,$EF,$3E ;
 $6088 DEFB $78,$F7,$FD,$3D,$1D,$8E,$0F,$3C ;
 $6090 DEFB $78,$F7,$7D,$3D,$1D,$9E,$0F,$FC ;
 $6098 DEFB $7F,$F6,$3D,$FB,$FB,$9F,$CF,$F8 ;
 $60A0 DEFB $7F,$EE,$3D,$FB,$FB,$9F,$EF,$F0 ;
 $60A8 DEFB $7F,$DE,$3D,$F7,$F7,$9F,$EF,$F8 ;
 $60B0 DEFB $7F,$9E,$3D,$EF,$EF,$9F,$CF,$3C ;
 $60B8 DEFB $7F,$DE,$3D,$F7,$F7,$9E,$0E,$1C ;
 $60C0 DEFB $79,$EE,$3D,$7B,$3B,$9E,$0F,$3C ;
 $60C8 DEFB $79,$F6,$3D,$7D,$3D,$9F,$EF,$FC ;
 $60D0 DEFB $3F,$F6,$3D,$FD,$FD,$9F,$F7,$F8 ;
 $60D8 DEFB $1F,$EE,$3D,$FB,$FB,$8F,$F7,$F0 ;
 $60E0 DEFB $0F,$CC,$1B,$F7,$F7,$03,$E3,$C0 ; }

; Leave Title Menu
;
; Used by the routine at #R$60FE.
; .
; Used when the title menu is finished. It records which control methods
; were chosen and plays the start tune. The tune routine returns to the caller
; of #R$60FE.
; .
; #HTML(#AUDIO0(start-tune.wav)(#INCLUDE(StartTune)))
@label=LeaveTitleMenu
c$60E8 DI            ; Disable interrupts.
 $60E9 LD A,($6281)  ; Fetch the control method chosen for player 1 from
                     ; #R$627F(#N$6281).
 $60EC LD ($60FB),A  ; Store it in #R$60FB.
 $60EF LD A,($6284)  ; Fetch the control method chosen for player 2 from
                     ; #R$627F(#N$6284).
 $60F2 LD ($60FC),A  ; Store it in #R$60FC.
 $60F5 LD DE,$6048   ; Point #REGde at #R$6048.
 $60F8 JP $A1C1      ; Jump to #R$A1C1 to play the tune.

; Player 1 Control Method
;
; The control method chosen for player 1 in the title menu: #N$00 for the
; keyboard, #N$01 for a Kempston joystick, #N$02 for a Cursor joystick and #N$03
; for an Interface II joystick.
@label=Player1ControlMethod
g$60FB DEFB $00

; Player 2 Control Method
;
; The control method chosen for player 2 in the title menu, which uses the
; same values as #R$60FB.
@label=Player2ControlMethod
g$60FC DEFB $00

; Two Player Flag
;
; Set to #N$01 when the two player game is chosen in the title menu, or
; #N$00 for the one player game.
@label=TwoPlayerFlag
g$60FD DEFB $00

; Show Title Menu
;
; Used by the routine at #R$DFF0.
; .
; Draws the title menu and runs it until the player presses "0" to start
; the game. While it waits it plays the title tune, highlights the chosen
; player option and scrolls a message along the bottom of the screen.
; .
; #HTML(#AUDIO0(title-tune.wav)(#INCLUDE(TitleTune)))
; .
; Pressing "A" or "B" chooses a one or two player game. Pressing "1" or "2"
; steps player 1 or player 2 onto the next control method, which moves the
; marker of that player down the list of options.
; .
; #PUSHS #UDGTABLE { #BLANKSCREEN(0)
; #SIM(start=$876B,stop=$0000,sp=$5B60)
; #SIM(start=$60FE,stop=$6170,sp=$5B60)
; #SCR$02(show-title-menu) } UDGTABLE# #POPS
; #PUSHS
; #HTML(<div hidden>)
; #BLANKSCREEN(0)
; #SIM(start=$E2E9,stop=$0000,ix=$6318,sp=$5B60)
; #SCR$02(screen-frame)
; #HTML(</div>)
; #POPS
@label=ShowTitleMenu
c$60FE LD HL,$1960   ; Set #REGhl to the position for the logo.
 $6101 LD DE,$6066   ; Point #REGde at #R$6066.
 $6104 CALL $AAC4    ; Call #R$AAC4 to draw it.
 $6107 LD HL,$FF0E   ; #REGhl is #N$FF0E, to write #N$0E to #R$A921 (the scroll counter)
                     ; and #N$FF to #R$A921(#N$A922) (the index of the next character of the
                     ; scrolling message).
 $610A LD ($A921),HL ; Write them.
; Copy the scores of the two players into the score boxes of the menu.
 $610D LD DE,$642F   ; Point #REGde at the digits of the score of player 1 in the text
                     ; record at #R$63AF(#N$642B).
 $6110 LD HL,$E132   ; Point #REGhl at the score of player 1 at #R$E132.
 $6113 LD BC,$0005   ; Set the number of digits in #REGbc to #N$05.
 $6116 LDIR          ; Copy the digits.
 $6118 LD DE,$6438   ; Point #REGde at the digits of the score of player 2 in the text
                     ; record at #R$63AF(#N$6434).
 $611B LD HL,$E144   ; Point #REGhl at the score of player 2 at #R$E144.
 $611E LD BC,$0005   ; Set the number of digits in #REGbc to #N$05.
 $6121 LDIR          ; Copy the digits.
; Print the text of the menu and draw the frames and decorations.
 $6123 LD B,$0D      ; Set the number of text records in #REGb to #N$0D.
 $6125 LD DE,$63AF   ; Point #REGde at the first text record at #R$63AF.
 $6128 CALL $E1BD    ; Call #R$E1BD to print the text records.
 $612B LD IX,$6318   ; Point #REGix at the two frame records at #R$6318.
 $612F CALL $E2E9    ; Call #R$E2E9 to draw the first frame (the list of
                     ; options).
 $6132 CALL $E2E9    ; Call #R$E2E9 to draw the second frame (the scrolling
                     ; message).
 $6135 LD HL,$AD20   ; Set #REGhl to the position of the left decoration.
 $6138 LD DE,$6307   ; Point #REGde at the decoration graphic at #R$6307.
 $613B CALL $AAC4    ; Call #R$AAC4 to draw it.
 $613E LD HL,$ADD8   ; Set #REGhl to the position of the right decoration.
 $6141 LD DE,$630D   ; Point #REGde at the decoration graphic at #R$630D.
 $6144 CALL $AAC4    ; Call #R$AAC4 to draw it.
; Draw the two markers and set up the highlight of the player option.
 $6147 XOR A         ; Clear #REGa.
 $6148 LD ($5CB8),A  ; Write #N$00 to #R$5CB8 (the frame of the highlight
                     ; animation).
 $614B LD ($5ADC),A  ; Write #N$00 to the attribute at #N$5ADC.
 $614E LD A,$AE      ; #REGa is #N$AE, the low byte of the attribute address of the one
                     ; player option.
 $6150 LD ($5CB9),A  ; Write it to #R$5CB9.
 $6153 LD HL,($627F) ; Fetch the position of the marker of player 1 from
                     ; #R$627F.
 $6156 LD DE,$6285   ; Point #REGde at #R$6285.
 $6159 CALL $AAC4    ; Call #R$AAC4 to draw it.
 $615C LD HL,($6282) ; Fetch the position of the marker of player 2 from
                     ; #R$627F(#N$6282).
 $615F LD DE,$62C6   ; Point #REGde at #R$62C6.
 $6162 CALL $AAC4    ; Call #R$AAC4 to draw it.
 $6165 LD A,($60FD)  ; Fetch the number of players chosen.
 $6168 AND A         ; {Jump to #R$6170 if one player is chosen.
 $6169 JR Z,$6170    ; }
 $616B LD A,$EE      ; #REGa is #N$EE, the low byte of the attribute address of the two
                     ; player option.
 $616D LD ($5CB9),A  ; Write it to #R$5CB9.
@label=ShowTitleMenu_Play
*$6170 LD IY,($5CF1) ; Bring back #REGiy from #R$5CF1.
 $6174 LD DE,$5FC3   ; Point #REGde at #R$5FC3.
 $6177 CALL $A1B2    ; Call #R$A1B2 to play it until a key is pressed.
; The main loop of the menu.
@label=ShowTitleMenu_Loop
*$617A EI            ; Enable interrupts.
 $617B LD A,($5CB9)  ; Fetch the low byte of the attribute address of the highlighted
                     ; option.
 $617E LD L,A        ; Copy it into #REGl.
 $617F CP $AE        ; {Jump to #R$6190 if the two player option is
 $6181 JR NZ,$6190   ; highlighted.}
 $6183 LD A,$7F      ; {Read from the keyboard;
 $6185 CALL $A8CB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$7F | SPACE | SYMBOL SHIFT | M | N | B }
                     ; TABLE#}
 $6188 AND %00010000 ; Test the bit for "B".
 $618A JR Z,$61AB    ; Jump to #R$61AB if "B" is not being pressed.
 $618C LD A,$01      ; Set the two player flag to #N$01.
 $618E JR $6199      ; Jump to #R$6199.
@label=ShowTitleMenu_TestOnePlayer
*$6190 LD A,$FD      ; {Read from the keyboard;
 $6192 CALL $A8CB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$FD | A | S | D | F | G }
                     ; TABLE#}
 $6195 RRA           ; Test the bit for "A".
 $6196 JR NC,$61AB   ; Jump to #R$61AB if "A" is not being pressed.
 $6198 XOR A         ; Set the one player flag to #N$00.
@label=ShowTitleMenu_SetPlayers
*$6199 LD ($60FD),A  ; Store the number of players.
 $619C LD A,L        ; Fetch the low byte of the old attribute address.
 $619D XOR %01000000 ; Swap between the two options.
 $619F LD ($5CB9),A  ; Store the new highlighted option.
 $61A2 LD H,$58      ; Point #REGh at the attribute rows.
 $61A4 LD B,$09      ; Set the width of the highlight in #REGb to #N$09.
@label=ShowTitleMenu_ResetHighlight
*$61A6 LD (HL),$42   ; Set the attribute of the option which is no longer highlighted to
                     ; the normal colour.
 $61A8 INC L         ; Move onto the next attribute.
 $61A9 DJNZ $61A6    ; Decrease the width counter by one and jump back to #R$61A6 until the
                     ; whole option has been reset.
; Move the markers, if needed.
@label=ShowTitleMenu_MoveMarkers
*$61AB EI            ; Enable interrupts.
 $61AC LD IX,$627F   ; Point #REGix at the record of the marker of player 1 at
                     ; #R$627F.
 $61B0 LD E,$01      ; #REGe is #N$01, the bit of the "1" key.
 $61B2 CALL $623F    ; Call #R$623F to move the marker of player 1.
 $61B5 LD IX,$6282   ; Point #REGix at the record of the marker of player 2 at
                     ; #R$627F(#N$6282).
 $61B9 INC E         ; #REGe is #N$02, the bit of the "2" key.
 $61BA CALL $623F    ; Call #R$623F to move the marker of player 2.
; Wait for the next frame.
@label=ShowTitleMenu_WaitFrame
*$61BD LD A,($5CBA)  ; Fetch the last value of FRAMES that was seen from
                     ; #R$5CB9(#N$5CBA).
 $61C0 LD B,A        ; Copy it into #REGb.
 $61C1 LD A,($5C78)  ; Fetch the low byte of FRAMES.
 $61C4 CP B          ; Compare it with the last value.
 $61C5 JR Z,$61BD    ; Jump back to #R$61BD until it has changed.
 $61C7 LD ($5CBA),A  ; Store the new value in #R$5CB9(#N$5CBA).
 $61CA DI            ; Disable interrupts.
; Cycle the colours of the highlighted option.
 $61CB LD B,$09      ; Set the width of the highlight in #REGb to #N$09.
 $61CD LD A,($5CB9)  ; Fetch the low byte of the attribute address of the highlighted
                     ; option.
 $61D0 LD L,A        ; Copy it into #REGl.
 $61D1 LD H,$58      ; Point #REGh at the attribute rows.
 $61D3 LD A,($5CB8)  ; Fetch the animation frame from #R$5CB8.
 $61D6 DEC A         ; Decrease it by one.
 $61D7 AND %00000111 ; Keep only bits 0-2.
 $61D9 LD ($5CB8),A  ; Store it.
@label=ShowTitleMenu_Highlight
*$61DC OR %01000000  ; Make the attribute bright with the ink from #REGa.
 $61DE LD (HL),A     ; Store it.
 $61DF INC L         ; Move onto the next attribute.
 $61E0 INC A         ; Move onto the next ink colour.
 $61E1 AND %00000111 ; Keep the ink colour in the range #N$00-#N$07.
 $61E3 DJNZ $61DC    ; Decrease the width counter by one and jump back to #R$61DC until the
                     ; whole option has been done.
; Redraw the markers.
 $61E5 LD DE,$6285   ; Point #REGde at #R$6285.
 $61E8 LD HL,($627F) ; Fetch the position of the marker of player 1 from
                     ; #R$627F.
 $61EB CALL $AAC4    ; Call #R$AAC4 to draw it.
 $61EE LD DE,$62C6   ; Point #REGde at #R$62C6.
 $61F1 LD HL,($6282) ; Fetch the position of the marker of player 2 from
                     ; #R$627F(#N$6282).
 $61F4 CALL $AAC4    ; Call #R$AAC4 to draw it.
 $61F7 LD A,$EF      ; {Read from the keyboard;
 $61F9 CALL $A8CB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$EF | 0 | 9 | 8 | 7 | 6 }
                     ; TABLE#}
 $61FC RRA           ; Rotate the bit for "0" into the carry flag.
 $61FD JP C,$60E8    ; Jump to #R$60E8 if "0" is being pressed, to start the
                     ; game.
; Scroll the message along the bottom of the screen.
 $6200 LD HL,$B7E8   ; Set #REGhl to the position of the right of the new
                     ; character area.
 $6203 LD BC,$0207   ; Set the width in #REGb to #N$02 bytes and the height in #REGc to
                     ; #N$07 rows.
 $6206 CALL $A902    ; Call #R$A902 to scroll the new character area left by
                     ; one pixel.
 $6209 LD HL,$51DC   ; #REGhl is #N$51DC, the screen address of the left of the new
                     ; character area.
 $620C LD D,H        ; #REGh moves into #REGd.
 $620D LD E,$DA      ; #REGe is #N$DA, to make the screen address of the right of the
                     ; message frame.
 $620F CALL $A588    ; Call #R$A588 to copy the pixels of the leftmost byte
                     ; across.
 $6212 LD HL,$B7D0   ; Set #REGhl to the position of the right of the message
                     ; frame.
 $6215 LD BC,$1607   ; Set the width in #REGb to #N$16 bytes and the height in #REGc to
                     ; #N$07 rows.
 $6218 CALL $A902    ; Call #R$A902 to scroll the message frame left by one
                     ; pixel.
 $621B AND %00001111 ; Keep only bits 0-3 of the scroll counter.
 $621D JP NZ,$617A   ; Jump back to #R$617A unless the scroll counter is a multiple of
                     ; #N$10.
; Add the next character of the message.
 $6220 LD A,($A922)  ; Fetch the index of the next character of the message from
                     ; #R$A921(#N$A922).
 $6223 INC A         ; Move onto the next character.
 $6224 CP $8D        ; {Jump to #R$6229 if the end of the message has not been
 $6226 JR NZ,$6229   ; reached.}
 $6228 XOR A         ; Go back to the start of the message.
@label=ShowTitleMenu_StoreIndex
*$6229 LD ($A922),A  ; Store the index.
 $622C LD HL,$6322   ; Point #REGhl at the scrolling message at #R$6322.
 $622F CALL $AA3C    ; Add the index to find the address of the character.
 $6232 LD A,(HL)     ; Fetch the character.
 $6233 LD ($6317),A  ; Store it in the text record at #R$6313.
 $6236 LD DE,$6313   ; Point #REGde at #R$6313.
 $6239 CALL $A923    ; Call #R$A923 to print the character.
 $623C JP $617A      ; Jump back to #R$617A.

; Move Marker
;
; Used by the routine at #R$60FE.
; .
; Moves the marker of one player, in the title menu, towards the control
; method option that is chosen. When the marker has reached the option, the key
; of the player ("1" or "2") chooses the next option. The marker moves down by
; one pixel at a time and up by four pixels at a time.
;
; IX The record of the marker (see #R$627F)
; E The bit of the key of the player: #N$01 for "1" and #N$02 for "2"
@label=MoveMarker
c$623F LD A,(IX+$02) ; {Fetch the number of the chosen option from the record of the marker
 $6242 LD B,A        ; and keep it in #REGb.}
 $6243 LD HL,$627B   ; Point #REGhl at the table of the vertical positions of the options
                     ; at #R$627B.
 $6246 CALL $AA3C    ; Add the number of the option to find its position.
 $6249 LD C,(HL)     ; Fetch the position of the option into #REGc.
 $624A LD A,C        ; Copy it into #REGa.
 $624B SUB (IX+$01)  ; Subtract the current position of the marker.
 $624E JR NZ,$6266   ; Jump to #R$6266 if the marker has not reached the
                     ; option.
 $6250 LD A,$F7      ; {Read from the keyboard;
 $6252 CALL $A8CB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$F7 | 1 | 2 | 3 | 4 | 5 }
                     ; TABLE#}
 $6255 AND E         ; Test the bit of the key of the player.
 $6256 JR Z,$6266    ; Jump to #R$6266 if the key is not being pressed.
 $6258 LD A,B        ; Fetch the number of the chosen option again.
 $6259 INC A         ; Move onto the next option.
 $625A AND %00000011 ; Keep the number in the range #N$00-#N$03.
 $625C LD (IX+$02),A ; Store the new number of the option in the record of the
                     ; marker.
 $625F LD HL,$627B   ; Point #REGhl at #R$627B.
 $6262 CALL $AA3C    ; Add the number of the option to find its position.
 $6265 LD C,(HL)     ; Fetch the position of the new option into #REGc.
@label=MoveMarker_Step
*$6266 LD A,C        ; Copy the position of the option into #REGa.
 $6267 SUB (IX+$01)  ; Subtract the current position of the marker.
 $626A RET Z         ; Return if the marker is at the option.
 $626B RLA           ; Rotate the sign of the difference into the carry flag.
 $626C JR C,$6272    ; Jump to #R$6272 if the option is above the marker.
 $626E INC (IX+$01)  ; Move the marker down by one pixel.
 $6271 RET           ; Return.

; Move Marker Up
;
; Used by the routine at #R$623F.
; .
; Moves the marker of one player up by four pixels.
;
; IX The record of the marker (see #R$627F)
@label=MoveMarkerUp
c$6272 LD A,(IX+$01) ; Fetch the vertical position of the marker.
 $6275 SUB $04       ; Subtract #N$04 from it.
 $6277 LD (IX+$01),A ; Store the new position.
 $627A RET           ; Return.

; Option Positions
;
; The vertical positions of the markers beside the four control method
; options of the title menu: the keyboard, a Kempston joystick, a Cursor
; joystick and an Interface II joystick.
