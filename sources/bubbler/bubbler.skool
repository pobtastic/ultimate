 $5920 DEFB $00,$46,$46,$4E,$4E,$66,$66,$6E,$46,$6E,$6E,$66,$66,$66,$4E,$4E,$4E,$4E,$4E,$4E,$4E,$4E,$4E,$4E,$4E,$4E,$4E,$46,$46,$46,$46,$00 ;
 $5940 DEFB $46,$4E,$4E,$4E,$4E,$66,$66,$6E,$46,$6E,$6E,$66,$66,$66,$4E,$4E,$4E,$4E,$4E,$4E,$4E,$4E,$4E,$4E,$4E,$4E,$4E,$46,$46,$46,$46,$46 ;
 $5960 DEFB $46,$4E,$4E,$4E,$4E,$66,$66,$6E,$46,$6E,$6E,$66,$66,$66,$4E,$4E,$4E,$4E,$4E,$4E,$4E,$4E,$4E,$4E,$4E,$4E,$4E,$46,$46,$46,$46,$46 ;
