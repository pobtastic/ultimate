 $87B5 DEFW $7987
 $87B7 DEFW $7A10
 $87B9 DEFW $7FE6
; Level #N$02.
 $87BB DEFB $47
 $87BC DEFB $0C
 $87BD DEFW $7987
 $87BF DEFW $7875
 $87C1 DEFW $7FE6
; Level #N$03.
 $87C3 DEFB $44
 $87C4 DEFB $0C
 $87C5 DEFW $78FE
 $87C7 DEFW $7A10
 $87C9 DEFW $7F85
