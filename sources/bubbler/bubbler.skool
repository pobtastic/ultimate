@label=CopiedRecords
g$BDBB DEFB $00,$00,$00,$00,$00,$00,$00
 $BDC2 DEFB $00,$00,$00,$00,$00,$00,$00
 $BDC9 DEFB $00,$00,$00,$00,$00,$00,$00
 $BDD0 DEFB $00,$00,$00,$00,$00,$00,$00
 $BDD7 DEFB $00,$00,$00,$00,$00,$00,$00
 $BDDE DEFB $00,$00,$00,$00,$00,$00,$00
 $BDE5 DEFB $00,$00,$00,$00,$00,$00,$00
 $BDEC DEFB $00,$00,$00,$00,$00,$00,$00
