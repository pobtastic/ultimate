; Level Table
;
; The addresses of the data of each level, which are found by #R$86F9.
; There are four bytes for each level. The first address is the header of the
; level, which is used with the map and the path entries that are described at
; #R$87D3. The second address is not used by the game and its purpose is not yet
; known.
@label=LevelTable
w$86E5 DEFW $87F8,$8D1A
 $86E9 DEFW $8868,$8E16
 $86ED DEFW $89A0,$928B
 $86F1 DEFW $8976,$8EAE
 $86F5 DEFW $8A2A,$9653

; Start Level
;
; Used by the routine at #R$A39B.
; .
; Finds the data of the current level and, when it is entered at #R$86F9,
; places the player at the start of the level (or at the position where the
; player last restarted) and sets the view to match.
;
; C #N$01 to place the player, otherwise only find the level data
@label=StartLevel
c$86F9 LD C,$01      ; Set the placement flag in #REGc to #N$01.
; This entry point is used by the routines at #R$A30D and #R$A3FE.
@label=StartLevel_FindData
*$86FB LD A,($DEDF)  ; Fetch the number of the current level from #R$DEDF.
 $86FE ADD A,A       ; {Multiply it by four, as there are four bytes for each level in the
 $86FF ADD A,A       ; table at #R$86E5.}
 $8700 LD E,A        ; Move it into #REGe.
 $8701 LD D,$00      ; Clear #REGd.
 $8703 LD HL,$86E5   ; Point #REGhl at #R$86E5.
 $8706 ADD HL,DE     ; Add the offset of the level to find its entry.
 $8707 LD E,(HL)     ; Fetch the low byte of the address of the data of the
                     ; level.
 $8708 INC HL        ; Move onto the high byte.
 $8709 LD D,(HL)     ; Fetch the high byte of the address of the data of the
                     ; level.
 $870A LD ($5CFE),DE ; Store the address in #R$5CFE.
 $870E DEC C         ; Decrease the placement flag by one.
 $870F RET NZ        ; Return unless the player is to be placed.
; Place the player at the start position of the level, or at the position
; of the last restart.
 $8710 PUSH DE       ; {Copy the address of the start position of the level into #REGix
 $8711 POP IX        ; (using the stack).}
 $8713 PUSH DE       ; Stash the address of the start position of the level on
                     ; the stack.
 $8714 LD A,($DEF7)  ; Fetch the restart flag from #R$DEF5(#N$DEF7).
 $8717 AND A         ; Test it.
 $8718 JR Z,$871E    ; Jump to #R$871E if the player has not restarted.
 $871A LD IX,$DEF5   ; Point #REGix at the position of the last restart at
                     ; #R$DEF5 instead.
@label=StartLevel_Place
*$871E LD A,(IX+$00) ; Fetch the first byte of the start position.
 $8721 AND %11110000 ; Keep the upper four bits.
 $8723 LD H,A        ; Copy them into #REGh.
 $8724 LD L,$01      ; #REGl is #N$01.
 $8726 LD C,H        ; Copy the upper four bits into #REGc.
 $8727 LD B,$00      ; Clear #REGb.
 $8729 LD ($B548),HL ; Write #REGhl in the player entity at #R$B540(#N$B548).
 $872C LD A,(IX+$00) ; Fetch the first byte of the start position again.
 $872F AND %00001111 ; Keep the lower four bits.
 $8731 ADD A,$20     ; Add #N$20.
 $8733 LD L,A        ; Copy the result into #REGl.
 $8734 LD H,(IX+$01) ; Fetch the second byte of the start position into #REGh.
 $8737 LD ($B542),HL ; Write #REGhl in the player entity at #R$B540(#N$B542).
 $873A LD A,L        ; #REGl moves into #REGa.
 $873B LD L,H        ; #REGh moves into #REGl.
 $873C LD H,A        ; #REGa moves into #REGh.
 $873D LD DE,$FF98   ; #REGde is #N$FF98 (minus #N$68).
 $8740 ADD HL,DE     ; Subtract #N$68 from the swapped position.
 $8741 AND A         ; {Subtract the upper four bits of the first byte of the start
 $8742 SBC HL,BC     ; position.}
 $8744 LD ($5CE2),HL ; Store the result in #R$5CE2.
 $8747 LD L,(IX+$02) ; Fetch the third byte of the start position into #REGl.
 $874A LD H,(IX+$03) ; Fetch the fourth byte of the start position into #REGh.
 $874D LD ($B545),HL ; Write #REGhl in the player entity at #R$B540(#N$B545).
 $8750 LD A,L        ; #REGl moves into #REGa.
 $8751 LD L,H        ; #REGh moves into #REGl.
 $8752 LD H,A        ; #REGa moves into #REGh.
 $8753 ADD HL,DE     ; Subtract #N$68 from the swapped position.
 $8754 ADD HL,BC     ; Add the upper four bits of the first byte of the start
                     ; position.
 $8755 LD ($5CE4),HL ; Store the result in #R$5CE2(#N$5CE4).
 $8758 LD A,($B546)  ; Fetch the byte of the player entity at #R$B540(#N$B546).
 $875B ADD A,$04     ; Add #N$04 to it.
 $875D LD ($B546),A  ; Store it again.
 $8760 LD A,($B543)  ; Fetch the byte of the player entity at #R$B540(#N$B543).
 $8763 ADD A,$02     ; Add #N$02 to it.
 $8765 LD ($B543),A  ; Store it again.
 $8768 POP IX        ; Bring back #REGix from the stack.
 $876A RET           ; Return.

; Set Level Graphics
;
; Used by the routines at #R$A30D and #R$DFF0.
; .
; Sets up the level which is being played using the table of levels at
; #R$87AB, which has eight bytes for each level. The colour for the level and
; the number of bottles to collect are stored, and four of the addresses in the
; table at #R$666E are replaced for the level.
@label=SetLevelGraphics
c$876B LD HL,$87AB   ; Point #REGhl at the table of levels.
 $876E LD A,($DEDF)  ; Fetch the number of the current level from #R$DEDF.
 $8771 ADD A,A       ; {Multiply it by eight.
 $8772 ADD A,A       ;
 $8773 ADD A,A       ; }
 $8774 CALL $AA3C    ; Add it to #REGhl to find the entry of the level.
 $8777 LD A,(HL)     ; Fetch the colour of the level.
 $8778 LD ($E11E),A  ; Store it in the attribute of the rectangle at
                     ; #R$E11C(#N$E11E).
 $877B INC HL        ; Move onto the next byte of the entry.
 $877C LD A,(HL)     ; Fetch the number of bottles to collect.
 $877D LD ($DEE0),A  ; Store it in #R$DEE0.
 $8780 INC HL        ; Move onto the next byte of the entry.
 $8781 LD E,(HL)     ; Fetch the low byte of the first address.
 $8782 INC HL        ; Move onto the high byte.
 $8783 LD D,(HL)     ; Fetch the high byte.
 $8784 INC HL        ; Move onto the next word of the entry.
 $8785 LD ($666E),DE ; Store it in the first entry of the table at #R$666E.
 $8789 LD E,(HL)     ; Fetch the low byte of the second address.
 $878A INC HL        ; Move onto the high byte.
 $878B LD D,(HL)     ; Fetch the high byte.
 $878C INC HL        ; Move onto the next word of the entry.
 $878D LD ($669C),DE ; Store it in the last entry of the table at
                     ; #R$666E(#N$669C).
 $8791 LD E,(HL)     ; Fetch the low byte of the third address.
 $8792 INC HL        ; Move onto the high byte.
 $8793 LD D,(HL)     ; Fetch the high byte.
 $8794 LD ($6670),DE ; Store it in the third entry of the table at
                     ; #R$666E(#N$6670).
 $8798 LD HL,$7F85   ; #REGhl is #N$7F85.
 $879B AND A         ; Clear the carry flag.
 $879C SBC HL,DE     ; Compare the third address with #N$7F85.
 $879E LD DE,$8047   ; #REGde is #N$8047, the fourth address when the third address is
                     ; #N$7F85.
 $87A1 JR Z,$87A6    ; Jump to #R$87A6 if it is #N$7F85.
 $87A3 LD DE,$80A8   ; #REGde is #N$80A8, the fourth address otherwise.
@label=SetLevelGraphics_Store
*$87A6 LD ($6672),DE ; Store it in the fourth entry of the table at
                     ; #R$666E(#N$6672).
 $87AA RET           ; Return.

; Level Settings
;
; The settings of each level, which are used by #R$876B. There are eight
; bytes for each level. The first is the attribute of the game area, which is
; stored at #N$E11E, and the second is the number of bottles that are to be
; collected. The three words that follow are the tiles that #R$876B sets for the
; entries at #N$666E, #N$669C and #N$6670 of the table at #R$666E. The entry at
; #N$6672 is chosen from the third of them.
;
; .
;
; Level #N$00.
@label=LevelSettings
b$87AB DEFB $46
 $87AC DEFB $05
 $87AD DEFW $78FE
 $87AF DEFW $7875
 $87B1 DEFW $7F85
; Level #N$01.
 $87B3 DEFB $44
