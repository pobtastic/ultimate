@label=ObjectRecords
g$BD74 DEFB $00,$00,$00,$00,$00,$00,$00
 $BD7B DEFB $00,$00,$00,$00,$00,$00,$00
 $BD82 DEFB $00,$00,$00,$00,$00,$00,$00
 $BD89 DEFB $00,$00,$00,$00,$00,$00,$00
 $BD90 DEFB $00,$00,$00,$00,$00,$00,$00
 $BD97 DEFB $00,$00,$00,$00,$00,$00,$00
 $BD9E DEFB $00,$00,$00,$00,$00,$00,$00
 $BDA5 DEFB $00,$00,$00,$00,$00,$00,$00
 $BDAC DEFB $00,$00,$00,$00,$00,$00,$00
