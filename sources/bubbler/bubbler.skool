; Add Score
;
; Used by the routines at #R$A3FE, #R$A5F4, #R$D202, #R$D47A and #R$D5DF.
; .
; Adds points to the score of the current player, which is kept as six
; digits in three bytes of binary coded decimal, and awards an extra life each
; time the score passes a multiple of 5000 points (see #R$D5DF(#N$D619)). It
; then prints the new score.
; .
; #PUSHS #UDGTABLE { #NEWGAME(0)
; #SCR$02,$00,$00,$06,$06(add-score-before)
; | #SIM(start=$9662,stop=$0000,bc=$1250,sp=$5B60)
; #SCR$02,$00,$00,$06,$06(add-score-after) } UDGTABLE# #POPS
;
; B The highest two digits of the points, in binary coded decimal
; C The lowest two digits of the points, in binary coded decimal
@label=AddScore
c$9662 LD A,($DEFB)  ; {Fetch the highest two digits of the score and keep them
 $9665 LD D,A        ; in #REGd.}
 $9666 LD A,($DEFA)  ; Fetch the middle two digits of the score.
 $9669 LD E,$00      ; Clear the flag in #REGe, which will show whether the score was
                     ; already past the 5000 point mark.
 $966B CP $50        ; {Jump to #R$9670 if they are below #N$50.
 $966D JR C,$9670    ; }
 $966F INC E         ; Set the flag.
@label=AddScore_Add
*$9670 LD HL,$DEF9   ; Point #REGhl at the score.
 $9673 LD A,C        ; Fetch the lowest two digits of the points.
 $9674 ADD A,(HL)    ; Add the lowest two digits of the score.
 $9675 DAA           ; Adjust the result to binary coded decimal.
 $9676 LD (HL),A     ; Store the new lowest two digits.
 $9677 INC HL        ; Move onto the middle two digits.
 $9678 LD A,B        ; Fetch the middle two digits of the points.
 $9679 ADC A,(HL)    ; Add the middle two digits of the score, with the carry.
 $967A DAA           ; Adjust the result to binary coded decimal.
 $967B LD (HL),A     ; Store the new middle two digits.
 $967C INC HL        ; Move onto the highest two digits.
 $967D LD A,$00      ; #REGa is #N$00.
 $967F ADC A,(HL)    ; Add the highest two digits of the score, with the carry.
 $9680 DAA           ; Adjust the result to binary coded decimal.
 $9681 LD (HL),A     ; Store the new highest two digits.
 $9682 LD A,E        ; Fetch the flag.
 $9683 AND A         ; Test it.
 $9684 JR NZ,$9690   ; Jump to #R$9690 if the score was already past the 5000
                     ; point mark.
 $9686 LD A,($DEFA)  ; Fetch the middle two digits of the score.
 $9689 CP $50        ; Compare them with #N$50.
 $968B CALL NC,$D619 ; Call #R$D5DF(#N$D619) to award an extra life if the score has now
                     ; passed the #N$5000 mark.
 $968E JR $9697      ; Jump to #R$9697 to print the score.
; View the equivalent code in;
; #LIST
; { #ATICATAC$A19C }
; { #COOKIE$7415 }
; { #CYBERUN$925E }
; { #JETPAC$70F9 }
; { #LUNARJETMAN$899C }
; { #MARTIANOIDS$B573 }
; { #NIGHTSHADE$C2ED }
; { #PENTAGRAM$BB29 }
; { #PSSST$737A }
; { #SABREWULF$B5A9 }
; { #TRANZAM$6046 }
; { #UNDERWURLDE$A045 }
; LIST#

; Print Score
;
; Used by the routine at #R$9662.
; .
; Prints the score of the current player in the score panel. When it is
; entered at #R$9690, an extra life is awarded if the highest two digits of the
; score have changed.
;
; D The highest two digits of the score before the points were added
@label=PrintScore
c$9690 LD A,($DEFB)  ; Fetch the highest two digits of the score.
 $9693 CP D          ; Compare them with the old highest two digits.
 $9694 CALL NZ,$D619 ; Call #R$D5DF(#N$D619) to award an extra life if they
                     ; have changed.
; This entry point is used by the routine at #R$9662.
@label=PrintScore_Digits
*$9697 LD HL,$DEFB   ; Point #REGhl at the highest two digits of the score.
 $969A LD DE,$E131   ; Point #REGde at the digits of the score in the text record at
                     ; #R$E11F(#N$E131).
 $969D LD B,$03      ; Set the byte counter in #REGb to #N$03.
@label=PrintScore_Convert
*$969F LD A,(HL)     ; Fetch two digits of the score.
 $96A0 RRA           ; {Move the upper digit into the lower four bits...
 $96A1 RRA           ;
 $96A2 RRA           ;
 $96A3 RRA           ; }
 $96A4 AND %00001111 ; ...and keep only that digit.
 $96A6 LD (DE),A     ; Store it in the text record.
 $96A7 INC DE        ; Move onto the next character of the text record.
 $96A8 LD A,(HL)     ; Fetch the two digits again.
 $96A9 AND %00001111 ; Keep the lower digit.
 $96AB LD (DE),A     ; Store it in the text record.
 $96AC INC DE        ; Move onto the next character of the text record.
 $96AD DEC HL        ; Move onto the next two digits of the score.
 $96AE DJNZ $969F    ; Decrease the byte counter by one and jump back to #R$969F until all
                     ; six digits have been converted.
 $96B0 LD A,$85      ; #REGa is #N$85, the length of the text with the flags for the double
                     ; height.
 $96B2 LD ($E131),A  ; Store it as the first character of the text record.
 $96B5 LD DE,$E12E   ; Point #REGde at #R$E12E.
 $96B8 JP $A923      ; Jump to #R$A923 to print the score.

; Create Pickup
;
; Used by the routine at #R$9748.
; .
; Tries to create a pickup in one of the two entity slots starting at
; #R$B540(#N$B5B2). The pickup is placed beside the view, on the side chosen by
; the low bits of a random number, at a position relative to the player, and it
; is given the type #N$0F.
@label=CreatePickup
c$96BB LD IX,$B5B2   ; Point #REGix at the first of the two entity slots.
 $96BF LD B,$02      ; Set the number of slots to look at in #REGb to #N$02.
 $96C1 CALL $979F    ; Call #R$979F to find a free slot.
 $96C4 RET NZ        ; Return if there is no free slot.
 $96C5 CALL $98AE    ; Call #R$98AE to clear the slot.
 $96C8 LD A,($5F9B)  ; Fetch the random number from #R$5F9A(#N$5F9B).
 $96CB AND %00000011 ; Keep only bits 0-1, to choose the side.
 $96CD JR NZ,$96D6   ; Jump to #R$96D6 unless the first side is chosen.
 $96CF LD DE,$0040   ; #REGde is #N$0040, the offset for the first side.
 $96D2 LD C,E        ; #REGe moves into #REGc.
 $96D3 LD B,D        ; #REGd moves into #REGb, so the offset is also #REGbc.
 $96D4 JR $96F7      ; Jump to #R$96F7.

; Choose Second Side
;
; Used by the routine at #R$96BB.
@label=CreatePickup_SecondSide
c$96D6 DEC A         ; Decrease the chosen side by one.
 $96D7 JR NZ,$96E2   ; Jump to #R$96E2 unless the second side is chosen.
 $96D9 LD DE,$00A0   ; #REGde is #N$00A0, the offset for the second side.
 $96DC LD C,E        ; #REGe moves into #REGc.
 $96DD LD B,D        ; #REGd moves into #REGb, so the offset is also #REGbc.
 $96DE LD A,$20      ; #REGa is #N$20, the direction for the second side.
 $96E0 JR $96F7      ; Jump to #R$96F7.

; Choose Third Side
;
; Used by the routine at #R$96D6.
@label=CreatePickup_ThirdSide
c$96E2 DEC A         ; Decrease the chosen side by one.
 $96E3 JR NZ,$96EF   ; Jump to #R$96EF unless the third side is chosen.
 $96E5 LD BC,$00B0   ; #REGbc is #N$00B0, the first offset for the third side.
 $96E8 LD DE,$0030   ; #REGde is #N$0030, the second offset for the third side.
 $96EB LD A,$30      ; #REGa is #N$30, the direction for the third side.
 $96ED JR $96F7      ; Jump to #R$96F7.

; Choose Fourth Side
;
; Used by the routine at #R$96E2.
@label=CreatePickup_FourthSide
c$96EF LD BC,$0030     ; #REGbc is #N$0030, the first offset for the fourth
                       ; side.
 $96F2 LD DE,$00B0     ; #REGde is #N$00B0, the second offset for the fourth
                       ; side.
 $96F5 LD A,$10        ; #REGa is #N$10, the direction for the fourth side.
; This entry point is used by the routines at #R$96BB, #R$96D6 and #R$96E2.
@label=CreatePickup_Place
*$96F7 LD L,A          ; Copy the direction into #REGl.
 $96F8 LD A,($5F9B)    ; Fetch the random number.
 $96FB RRA             ; {Shift it right twice...
 $96FC RRA             ; }
 $96FD AND %00001111   ; ...and keep bits 2-5.
 $96FF OR L            ; Add the direction.
 $9700 OR %10000000    ; Set bit 7.
 $9702 LD (IX+$11),A   ; Store it in field #N$11 of the pickup.
 $9705 LD HL,($5CE4)   ; Fetch the view position from #R$5CE2(#N$5CE4).
 $9708 ADD HL,BC       ; Add the first offset.
 $9709 LD A,($B548)    ; Fetch the first coordinate of the player from
                       ; #R$B540(#N$B548).
 $970C LD (IX+$08),A   ; Store it in field #N$08 of the pickup.
 $970F DEC A           ; Decrease it by one.
 $9710 LD B,A          ; Keep it in #REGb.
 $9711 LD A,($B549)    ; Fetch the second coordinate of the player from
                       ; #R$B540(#N$B549).
 $9714 LD (IX+$09),A   ; Store it in field #N$09 of the pickup.
 $9717 LD C,A          ; Keep it in #REGc.
 $9718 AND A           ; {Subtract the coordinate of the player from the
 $9719 SBC HL,BC       ; position.}
 $971B LD (IX+$05),H   ; Store the high byte in field #N$05 of the pickup.
 $971E LD (IX+$06),L   ; Store the low byte in field #N$06 of the pickup.
 $9721 LD HL,($5CE2)   ; Fetch the view position from #R$5CE2.
 $9724 ADD HL,DE       ; Add the second offset.
 $9725 AND A           ; {Add the coordinate of the player.
 $9726 ADD HL,BC       ; }
 $9727 LD (IX+$02),H   ; Store the high byte in field #N$02 of the pickup.
 $972A LD (IX+$03),L   ; Store the low byte in field #N$03 of the pickup.
 $972D LD (IX+$00),$0F ; Set the type of the pickup to #N$0F.
 $9731 CALL $986C      ; Call #R$986C to set up the rest of the pickup.
 $9734 LD (IX+$10),$22 ; Set field #N$10 of the pickup to #N$22.
 $9738 LD (IX+$1D),$10 ; Set field #N$1D of the pickup to #N$10.
 $973C LD A,$08        ; #REGa is #N$08.
 $973E LD (IX+$0B),A   ; Set field #N$0B of the pickup to #N$08.
 $9741 LD (IX+$0C),A   ; Set field #N$0C of the pickup to #N$08.
 $9744 LD (IX+$0D),A   ; Set field #N$0D of the pickup to #N$08.
 $9747 RET             ; Return.

; Update Spawn Points
;
; Used by the routine at #R$CD11.
; .
; Called every frame. Once in every #N$40 frames, on average, it creates
; a pickup (see #R$96BB). It then goes through the spawn points of the level,
; which have seven bytes each, counting down the delay of each one and, when the
; delay has run out, trying to create the entity the spawn point makes.
@label=UpdateSpawnPoints
c$9748 LD A,($5F9A)  ; Fetch the low byte of the random seed from #R$5F9A.
 $974B AND %00111111 ; Keep only bits 0-5.
 $974D CALL Z,$96BB  ; Call #R$96BB to create a pickup if they are all zero.
 $9750 LD A,($BD73)  ; Fetch the number of spawn points from #R$BD73.
 $9753 AND A         ; Test it.
 $9754 RET Z         ; Return if there are none.
 $9755 LD B,A        ; Set the spawn point counter in #REGb.
 $9756 LD IY,$BD74   ; Point #REGiy at the first spawn point at
                     ; #R$BD73(#N$BD74).
@label=UpdateSpawnPoints_Loop
*$975A PUSH BC       ; Stash the spawn point counter on the stack.
 $975B PUSH IY       ; Stash the address of the spawn point on the stack.
 $975D LD A,(IY+$05) ; Fetch the delay of the spawn point.
 $9760 AND A         ; Test it.
 $9761 JR Z,$9769    ; Jump to #R$9769 if it has run out.
 $9763 DEC A         ; Decrease the delay by one.
 $9764 LD (IY+$05),A ; Store it.
 $9767 JR $9790      ; Jump to #R$9790 to go on to the next spawn point.
@label=UpdateSpawnPoints_Create
*$9769 LD E,(IY+$06) ; Fetch the kind of the spawn point.
 $976C LD A,E        ; Copy it into #REGa.
 $976D CP $03        ; {Jump to #R$9790 if it is #N($03), which makes nothing.
 $976F JR Z,$9790    ; }
 $9771 ADD A,A       ; {Multiply it by seven...
 $9772 ADD A,A       ;
 $9773 ADD A,A       ; }
 $9774 SUB E         ; ...by multiplying by eight and subtracting the kind.
 $9775 LD E,A        ; Move it into #REGe.
 $9776 LD D,$00      ; Clear #REGd.
 $9778 LD IY,$988B   ; Point #REGiy at #R$988B.
 $977C ADD IY,DE     ; Add the offset of the kind to find its entry.
 $977E LD L,(IY+$00) ; Fetch the low byte of the address of the first entity slot of the
                     ; kind.
 $9781 LD H,(IY+$01) ; Fetch the high byte of the address of the first entity slot of the
                     ; kind.
 $9784 PUSH HL       ; {Copy it into #REGix (using the stack).
 $9785 POP IX        ; }
 $9787 LD B,(IY+$02) ; Fetch the number of entity slots of the kind into #REGb.
 $978A CALL $979F    ; Call #R$979F to find a free slot.
 $978D JP Z,$97AE    ; Jump to #R$97AE if there is one, to create the entity.
; This entry point is used by the routine at #R$97AE.
@label=UpdateSpawnPoints_Next
*$9790 POP IY        ; Restore the address of the spawn point from the stack.
; This entry point is used by the routines at #R$97AE, #R$9820, #R$984C and
; #R$9856.
@label=UpdateSpawnPoints_Advance
*$9792 LD BC,$0007   ; #REGbc is #N$0007, the size of a spawn point.
 $9795 ADD IY,BC     ; Move onto the next spawn point.
 $9797 POP BC        ; Restore the spawn point counter from the stack.
 $9798 DJNZ $975A    ; Decrease the spawn point counter by one and jump back to #R$975A
                     ; until all of the spawn points have been done.
 $979A RET           ; Return.

; Unused
;
; Purpose not yet known. These bytes are not used by the game.
@label=Unused_979B
b$979B DEFB $D3,$FE,$18,$FC

; Find Free Entity
;
; Used by the routines at #R$96BB, #R$9748 and #R$9CBA.
; .
; Looks for an unused entity (one with the type #N$00) in a run of
; entities.
;
;   IX The first entity
;   B The number of entities to look at
; O:IX The unused entity, if one was found
; O:F Zero flag set if an unused entity was found
@label=FindFreeEntity
c$979F LD DE,$0026   ; #REGde is #N$0026, the size of an entity.
@label=FindFreeEntity_Loop
*$97A2 LD A,(IX+$00) ; Fetch the type of the entity.
 $97A5 AND A         ; Test it.
 $97A6 RET Z         ; Return with the zero flag set if the entity is unused.
 $97A7 ADD IX,DE     ; Move onto the next entity.
 $97A9 DJNZ $97A2    ; Decrease the entity counter by one and jump back to #R$97A2 until
                     ; all of the entities have been looked at.
 $97AB OR %00000001  ; Reset the zero flag, as no unused entity was found.
 $97AD RET           ; Return.

; Create Spawned Entity
;
; Used by the routine at #R$9748.
; .
; Makes an entity from a spawn point, provided that the random number is
; odd. When it is created the spawn point is made to wait for #N$07 frames
; before it may create another entity. The entity which is made depends on its
; type: the code for types #N$00, #N$08 and #N$0E is different.
;
; IX The free entity
; IY The entry of the table of kinds (see #R$988B)
@label=CreateSpawnedEntity
c$97AE CALL $5F9E      ; Call #R$5F9E to get a random number.
 $97B1 LD A,($5F9A)    ; Fetch the low byte of the seed.
 $97B4 AND %00000001   ; Keep only bit 0.
 $97B6 JP Z,$9790      ; Jump to #R$9790 if it is zero, to leave this spawn
                       ; point for now.
 $97B9 CALL $98AE      ; Call #R$98AE to clear the entity.
 $97BC LD A,(IY+$03)   ; Fetch the type from the kind.
 $97BF LD (IX+$00),A   ; Set the type of the entity.
 $97C2 LD A,(IY+$04)   ; Fetch the first size from the kind.
 $97C5 LD (IX+$0B),A   ; Set the x extent.
 $97C8 LD A,(IY+$05)   ; Fetch the second size from the kind.
 $97CB LD (IX+$0C),A   ; Set the y extent.
 $97CE LD A,(IY+$06)   ; Fetch the third size from the kind.
 $97D1 LD (IX+$0D),A   ; Set the z extent.
 $97D4 POP IY          ; Restore the address of the spawn point from the stack.
 $97D6 LD (IY+$05),$07 ; Set the delay of the spawn point to #N$07.
 $97DA LD A,(IY+$00)   ; Fetch the first byte of the position from the spawn
                       ; point.
 $97DD LD (IX+$03),A   ; Set the low byte of the x coordinate.
 $97E0 LD A,(IY+$01)   ; Fetch the second byte of the position from the spawn
                       ; point.
 $97E3 LD (IX+$02),A   ; Set the high byte of the x coordinate.
 $97E6 LD A,(IY+$02)   ; Fetch the third byte of the position from the spawn
                       ; point.
 $97E9 LD (IX+$06),A   ; Set the low byte of the y coordinate.
 $97EC LD A,(IY+$03)   ; Fetch the fourth byte of the position from the spawn
                       ; point.
 $97EF LD (IX+$05),A   ; Set the high byte of the y coordinate.
 $97F2 LD A,(IY+$04)   ; Fetch the fifth byte of the position from the spawn
                       ; point.
 $97F5 LD (IX+$09),A   ; Set the middle byte of the z coordinate.
 $97F8 LD (IX+$08),$01 ; Set the top byte of the z coordinate to #N$01.
 $97FC LD A,(IX+$00)   ; Fetch the type of the entity.
 $97FF AND A           ; Test it.
 $9800 JR Z,$984C      ; Jump to #R$984C if the type is #N$00.
 $9802 CP $08          ; {Jump to #R$9856 if the type is #N$08.
 $9804 JR Z,$9856      ; }
 $9806 CP $0E          ; {Jump to #R$9820 if the type is #N$0E.
 $9808 JR Z,$9820      ; }
 $980A LD (IX+$23),$00 ; Set field #N$23 of the entity to #N$00.
 $980E LD (IX+$1C),$04 ; Set field #N$1C of the entity to #N$04.
 $9812 LD (IX+$1D),$10 ; Set field #N$1D of the entity to #N$10.
 $9816 CALL $AF21      ; Call #R$AF21 to set the sprite of the entity.
 $9819 SET 4,(IX+$16)  ; Set bit 4 of field #N$16 of the entity.
 $981D JP $9792        ; Jump to #R$9792 to go on to the next spawn point.

; Create Shot
;
; Used by the routine at #R$97AE.
; .
; Makes a shot at the spawn point. The shot is nudged on by three along
; both axes, given a random heading in the low four bits, and sent off with
; the moving flag set.
;
; IX The shot
@label=CreateShot
c$9820 CALL $9F68    ; Play the brief buzz.
 $9823 LD A,($5F9B)  ; Fetch a random number.
 $9826 AND %00001111 ; Keep a heading from 0 to 15.
 $9828 LD (IX+$20),A ; Keep that heading aside.
 $982B LD A,(IX+$03) ; {Nudge the low byte of the x coordinate on by three.
 $982E ADD A,$03     ;
 $9830 LD (IX+$03),A ; }
 $9833 LD A,(IX+$06) ; {Nudge the low byte of the y coordinate on by three.
 $9836 ADD A,$03     ;
 $9838 LD (IX+$06),A ; }
 $983B CALL $9CA3    ; Set up the shot sprite.
 $983E CALL $98D3    ; Face the shot towards the player.
 $9841 LD A,(IX+$20) ; Fetch the heading that was kept aside.
 $9844 OR %10000000  ; Mark the shot as moving.
 $9846 LD (IX+$11),A ; Use that value as the heading.
 $9849 JP $9792      ; Go on to the next spawn point.

; Create Spawned Creature
;
; Used by the routine at #R$97AE.
@label=CreateSpawnedEntity_Creature
c$984C SET 4,(IX+$16) ; Set bit 4 of field #N$16 of the entity.
 $9850 CALL $99FD     ; Call #R$99FD.
 $9853 JP $9792       ; Jump to #R$9792 to go on to the next spawn point.

; Create Spawned Growing Bubble
;
; Used by the routine at #R$97AE.
@label=CreateSpawnedEntity_GrowingBubble
c$9856 LD A,(IX+$03) ; Fetch the low byte of the x coordinate.
 $9859 ADD A,$03     ; Add #N$03.
 $985B LD (IX+$03),A ; Store it again.
 $985E LD A,(IX+$06) ; Fetch the low byte of the y coordinate.
 $9861 ADD A,$06     ; Add #N$06.
 $9863 LD (IX+$06),A ; Store it again.
 $9866 CALL $986C    ; Call #R$986C to set up the rest of the entity.
 $9869 JP $9792      ; Jump to #R$9792 to go on to the next spawn point.

; Set Entity Defaults
;
; Used by the routines at #R$96EF and #R$9856.
; .
; Sets the acceleration, the speed and the animation which an entity made
; by #R$96BB or #R$97AE has in common, and then measures its sprite.
;
; IX The entity
@label=SetEntityDefaults
c$986C LD (IX+$14),$FF ; Set the high byte of the acceleration to #N$FF.
 $9870 LD (IX+$15),$B0 ; Set the low byte of the acceleration to #N$B0.
 $9874 LD (IX+$1B),$10 ; Set the rate of change of the speed to #N$10.
 $9878 LD (IX+$1C),$51 ; Set the animation counter to #N$51.
 $987C LD (IX+$1D),$76 ; Set the frame range to #N$76, so the frames run from 6
                       ; to 7.
 $9880 LD (IX+$10),$10 ; Set the speed to #N$10.
 $9884 LD (IX+$01),$20 ; Set the frame byte to #N$20.
 $9888 JP $AF21        ; Measure the sprite.

; Spawn Kinds
;
; The kinds of entity which a spawn point can make, for #R$9748. Each kind
; is described by seven bytes: the address of the first of its entity slots, the
; number of slots, the type of entity and the three sizes of the entity. The
; kind #N$03 is not used.
@label=SpawnKinds
b$988B DEFW $B64A                       ; The address of the first entity slot
                                        ; of kind #N$00.
 $988D DEFB $01                         ; The number of entity slots of kind
                                        ; #N$00.
 $988E DEFB $06                         ; The type of entity of kind #N$00.
 $988F DEFB $10,$10,$03                 ; The three sizes of entity of kind
                                        ; #N$00.
 $9892 DEFW $B566                       ; The address of the first entity slot
                                        ; of kind #N$01.
 $9894 DEFB $02                         ; The number of entity slots of kind
                                        ; #N$01.
 $9895 DEFB $08                         ; The type of entity of kind #N$01.
 $9896 DEFB $08,$08,$08                 ; The three sizes of entity of kind
                                        ; #N$01.
 $9899 DEFW $B566                       ; The address of the first entity slot
                                        ; of kind #N$02.
 $989B DEFB $02                         ; The number of entity slots of kind
                                        ; #N$02.
 $989C DEFB $00                         ; The type of entity of kind #N$02.
 $989D DEFB $08,$08,$08                 ; The three sizes of entity of kind
                                        ; #N$02.
 $98A0 DEFB $00,$00,$00,$00,$00,$00,$00 ; Kind #N$03, which is not used.
 $98A7 DEFW $B5B2                       ; The address of the first entity slot
                                        ; of kind #N$04.
 $98A9 DEFB $02                         ; The number of entity slots of kind
                                        ; #N$04.
 $98AA DEFB $0E                         ; The type of entity of kind #N$04.
 $98AB DEFB $04,$04,$04                 ; The three sizes of entity of kind
                                        ; #N$04.

; Clear Entity
;
; Used by the routines at #R$96BB, #R$97AE and #R$9CBA.
; .
; Sets all of the bytes of an entity to zero, using the stack.
;
; IX The entity
@label=ClearEntity
c$98AE PUSH IX       ; {Copy the address of the entity into #REGhl (using the
 $98B0 POP HL        ; stack).}
 $98B1 LD DE,$0026   ; #REGde is #N$0026, the size of an entity.
 $98B4 ADD HL,DE     ; Point #REGhl at the end of the entity.
 $98B5 LD ($98D0),SP ; Save the stack pointer in the operand of the instruction at
                     ; #R$98AE(#N$98CF).
 $98B9 LD SP,HL      ; Point the stack at the end of the entity.
 $98BA LD E,$00      ; #REGde is #N$0000.
 $98BC PUSH DE       ; {Write #N$00 to the #N$26 bytes of the entity, #N$02
 $98BD PUSH DE       ; bytes at a time.
 $98BE PUSH DE       ;
 $98BF PUSH DE       ;
 $98C0 PUSH DE       ;
 $98C1 PUSH DE       ;
 $98C2 PUSH DE       ;
 $98C3 PUSH DE       ;
 $98C4 PUSH DE       ;
 $98C5 PUSH DE       ;
 $98C6 PUSH DE       ;
 $98C7 PUSH DE       ;
 $98C8 PUSH DE       ;
 $98C9 PUSH DE       ;
 $98CA PUSH DE       ;
 $98CB PUSH DE       ;
 $98CC PUSH DE       ;
 $98CD PUSH DE       ;
 $98CE PUSH DE       ; }
 $98CF LD SP,$0000   ; Restore the stack pointer.
 $98D2 RET           ; Return.

; Face Player
;
; Used by the routines at #R$9820, #R$9A0A, #R$9B89, #R$9BB9, #R$9C1A and
; #R$9CBA.
; .
; Chooses the direction in which an entity should head to move towards the
; player. If the direction (bits 4 and 5 of field #N$20 of the entity) is
; already the right one it is left alone, otherwise the new direction is set
; along with a random value in bits 1-3.
;
; IX The entity
@label=FacePlayer
c$98D3 LD B,$00      ; Clear the direction bits in #REGb.
 $98D5 LD A,($B542)  ; Fetch the first byte of the first coordinate of the player from
                     ; #R$B540(#N$B542).
 $98D8 SUB (IX+$02)  ; Subtract the first byte of the first coordinate of the
                     ; entity.
 $98DB JR NZ,$98E3   ; Jump to #R$98E3 if they are different.
 $98DD LD A,($B543)  ; Fetch the second byte of the first coordinate of the player from
                     ; #R$B540(#N$B543).
 $98E0 SUB (IX+$03)  ; Subtract the second byte of the first coordinate of the
                     ; entity.
@label=FacePlayer_FirstDone
*$98E3 JR NC,$98E7   ; Jump to #R$98E7 if the player is not before the entity on the first
                     ; coordinate.
 $98E5 LD B,$10      ; Set bit 4 of the direction.
@label=FacePlayer_Second
*$98E7 LD A,($B545)  ; Fetch the first byte of the second coordinate of the player from
                     ; #R$B540(#N$B545).
 $98EA SUB (IX+$05)  ; Subtract the first byte of the second coordinate of the
                     ; entity.
 $98ED JR NZ,$98F5   ; Jump to #R$98F5 if they are different.
 $98EF LD A,($B546)  ; Fetch the second byte of the second coordinate of the player from
                     ; #R$B540(#N$B546).
 $98F2 SUB (IX+$06)  ; Subtract the second byte of the second coordinate of the
                     ; entity.
@label=FacePlayer_SecondDone
*$98F5 LD A,B        ; Fetch the direction.
 $98F6 JR NC,$98FA   ; Jump to #R$98FA if the player is not before the entity on the second
                     ; coordinate.
 $98F8 XOR %00110000 ; Flip bits 4 and 5 of the direction.
@label=FacePlayer_Compare
*$98FA LD B,A        ; Keep the direction in #REGb.
 $98FB LD A,(IX+$20) ; Read field #N$20 of the entity.
 $98FE AND %00110000 ; Use bits 4 and 5.
 $9900 XOR B         ; Compare them with the new direction.
 $9901 RET Z         ; Return if the entity is already heading that way.
 $9902 LD A,($5F9A)  ; Fetch the low byte of the random seed from #R$5F9A.
 $9905 AND %00001110 ; Use bits 1-3.
 $9907 OR B          ; Add the new direction.
 $9908 LD (IX+$20),A ; Store it in field #N$20 of the entity.
 $990B RET           ; Return.

; Turn Entity
;
; Used by the routines at #R$9B89 and #R$9CBA.
; .
; Turns an entity by a step towards the heading in field #N$20, by
; changing bits 1-5 of the current heading in field #N$11.
;
; B The size of the step
; IX The entity
@label=TurnEntity
c$990C LD A,(IX+$11) ; Fetch the current heading of the entity.
 $990F AND %00111110 ; Use bits 1-5.
 $9911 LD L,A        ; Copy it into #REGl.
 $9912 SUB (IX+$20)  ; Subtract the wanted heading of the entity.
 $9915 RET Z         ; Return if the entity is already heading that way.
 $9916 BIT 5,A       ; Test bit 5 of the difference.
 $9918 LD A,B        ; Fetch the size of the step.
 $9919 JR NZ,$991D   ; Jump to #R$991D if the step is to be added.
 $991B NEG           ; Negate the step.
@label=TurnEntity_Apply
*$991D ADD A,L       ; Add the step to the current heading.
 $991E AND %00111110 ; Use bits 1-5.
 $9920 LD (IX+$11),A ; Store the new heading of the entity.
 $9923 RET           ; Return.

; Start Burst
;
; Used by the routines at #R$9A0A, #R$B7CE, #R$CD11, #R$D47A, #R$D5AD and
; #R$D5DF.
; .
; Changes an entity into one of type #N$07, which is set up using #R$9F06.
;
; IX The entity
@label=StartBurst
c$9924 LD (IX+$01),$00 ; Set field #N$01 of the entity to #N$00.
 $9928 LD (IX+$00),$07 ; Set the type of the entity to #N$07.
 $992C CALL $AF21      ; Call #R$AF21 to set the sprite of the entity.
 $992F LD (IX+$1C),$04 ; Set field #N$1C of the entity to #N$04.
 $9933 LD (IX+$1D),$88 ; Set field #N$1D of the entity to #N$88.
 $9937 CALL $9F06      ; Call #R$9F06.
 $993A JP $AE0D        ; Jump to #R$AE0D.

; Entity Handlers
;
; The routines which update each type of entity, for #R$CEE2. The routine
; is found by adding twice the type of the entity to #N$993B, so there is no
; entry for the type #N$00.
@label=EntityHandlers
b$993D DEFW $9B63
 $993F DEFW $9B63
 $9941 DEFW $9B63
 $9943 DEFW $9C78
 $9945 DEFW $9E17
 $9947 DEFW $9E6D
 $9949 DEFW $9D67
 $994B DEFW $9AD9
 $994D DEFW $9CBA
 $994F DEFW $9B89
 $9951 DEFW $9C1A
 $9953 DEFW $9D9D
 $9955 DEFW $9DC0
 $9957 DEFW $9E46
 $9959 DEFW $9A0A
 $995B DEFW $9D8D
 $995D DEFW $9BB9

; Set Up Creature
;
; Used by the routine at #R$99FD.
; .
; Sets up an entity as one of four kinds of creature, using the templates
; at #R$99C7. The first level has only two kinds of creature and the second
; level has no kind #N$03.
;
; A The kind of creature (#N$00-#N$03)
; C The mask for the random heading
; IX The entity
@label=SetUpCreature
c$995F LD B,A          ; Copy the kind of creature into #REGb.
 $9960 LD A,($DEDF)    ; Fetch the number of the level from #R$DEDF.
 $9963 AND A           ; Test it.
 $9964 JR NZ,$9968     ; Jump to #R$9968 unless this is the first level.
 $9966 RES 1,B         ; Reset bit 1 of the kind, so that only the kinds #N$00 and #N$01 are
                       ; used.
@label=SetUpCreature_Level
*$9968 DEC A           ; Decrease the level by one.
 $9969 JR NZ,$9972     ; Jump to #R$9972 unless this is the second level.
 $996B LD A,B          ; Fetch the kind of creature.
 $996C CP $03          ; {Jump to #R$9972 unless it is #N$03.
 $996E JR NZ,$9972     ; }
 $9970 LD B,$02        ; Use the kind #N$02 instead.
@label=SetUpCreature_Template
*$9972 LD A,B          ; Fetch the kind of creature.
 $9973 ADD A,A         ; {Multiply it by four...
 $9974 ADD A,A         ; }
 $9975 LD B,A          ; ...and keep it in #REGb.
 $9976 ADD A,A         ; Multiply it by eight...
 $9977 ADD A,B         ; ...and add the four times to make twelve times the kind, the size of
                       ; a template.
 $9978 LD HL,$99C7     ; Point #REGhl at #R$99C7.
 $997B CALL $AA3C      ; Add the offset of the kind to find its template.
 $997E LD A,(HL)       ; Fetch the type of the creature.
 $997F LD (IX+$00),A   ; Set the type of the entity.
 $9982 INC HL          ; Move onto the next byte of the template.
 $9983 LD A,(HL)       ; Fetch the frame of the creature.
 $9984 LD (IX+$01),A   ; Set field #N$01 of the entity.
 $9987 INC HL          ; Move onto the next byte of the template.
 $9988 LD A,(HL)       ; Fetch the third byte of the template.
 $9989 LD (IX+$10),A   ; Set the speed.
 $998C INC HL          ; Move onto the next byte of the template.
 $998D LD A,(HL)       ; Fetch the fourth byte of the template.
 $998E LD (IX+$14),A   ; Set field #N$14 of the entity.
 $9991 INC HL          ; Move onto the next byte of the template.
 $9992 LD A,(HL)       ; Fetch the fifth byte of the template.
 $9993 LD (IX+$15),A   ; Set field #N$15 of the entity.
 $9996 INC HL          ; Move onto the next byte of the template.
 $9997 LD A,(HL)       ; Fetch the sixth byte of the template.
 $9998 LD (IX+$1C),A   ; Set field #N$1C of the entity.
 $999B INC HL          ; Move onto the next byte of the template.
 $999C LD A,(HL)       ; Fetch the seventh byte of the template.
 $999D LD (IX+$1D),A   ; Set field #N$1D of the entity.
 $99A0 INC HL          ; Move onto the next byte of the template.
 $99A1 LD A,(HL)       ; Fetch the eighth byte of the template.
 $99A2 LD (IX+$23),A   ; Set field #N$23 of the entity.
 $99A5 INC HL          ; Move onto the next byte of the template.
 $99A6 LD A,(HL)       ; Fetch the ninth byte of the template.
 $99A7 LD (IX+$0B),A   ; Set the x extent.
 $99AA INC HL          ; Move onto the next byte of the template.
 $99AB LD A,(HL)       ; Fetch the tenth byte of the template.
 $99AC LD (IX+$0C),A   ; Set the y extent.
 $99AF INC HL          ; Move onto the next byte of the template.
 $99B0 LD A,(HL)       ; Fetch the eleventh byte of the template.
 $99B1 LD (IX+$0D),A   ; Set the z extent.
 $99B4 INC HL          ; Move onto the next byte of the template.
 $99B5 LD A,(HL)       ; Fetch the twelfth byte of the template.
 $99B6 LD (IX+$1B),A   ; Set field #N$1B of the entity.
 $99B9 LD (IX+$13),$00 ; Set field #N$13 of the entity to #N$00.
 $99BD LD A,($5F9B)    ; Fetch the random number from #R$5F9A(#N$5F9B).
 $99C0 AND C           ; Mask it with the heading mask.
 $99C1 LD (IX+$11),A   ; Set the heading.
 $99C4 JP $AF21        ; Jump to #R$AF21 to set the sprite of the entity.

; Creature Templates
;
; The four kinds of creature, for #R$995F. Each template has twelve bytes,
; which are copied into the fields #N$00, #N$01, #N$10, #N$14, #N$15, #N$1C,
; #N$1D, #N$23, #N$0B, #N$0C, #N$0D and #N$1B of the entity.
@label=CreatureTemplates
b$99C7 DEFB $0A,$00,$30,$FF,$B0,$04,$40,$80 ; {Kind #N$00.
 $99CF DEFB $0C,$0C,$08,$10                 ; }
 $99D3 DEFB $0B,$00,$00,$FF,$B0,$56,$00,$8C ; {Kind #N$01.
 $99DB DEFB $10,$10,$08,$10                 ; }
 $99DF DEFB $11,$00,$40,$FF,$80,$05,$30,$90 ; {Kind #N$02.
 $99E7 DEFB $0A,$0A,$0C,$40                 ; }
 $99EB DEFB $09,$20,$20,$FF,$B0,$F4,$00,$80 ; {Kind #N$03.
 $99F3 DEFB $0C,$0C,$08,$10                 ; }

; Make Creature
;
; Used by the routine at #R$9AD9.
; .
; Sets up an entity as a random creature (see #R$99FD) and then carries on
; with the update of the entity at #R$CF3A.
@label=MakeCreature
c$99F7 CALL $99FD    ; Call #R$99FD to set up a random creature.
 $99FA JP $CF3A      ; Jump to #R$CF3A.

; Create Random Creature
;
; Used by the routines at #R$984C and #R$99F7.
; .
; Sets up an entity as a creature of a random kind, using #R$995F.
;
; IX The entity
@label=CreateRandomCreature
c$99FD CALL $5F9E    ; Call #R$5F9E to get a random number.
 $9A00 LD A,($5F9A)  ; Fetch the low byte of the seed.
 $9A03 AND %00000011 ; Use bits 0-1 to make the kind of the creature.
 $9A05 LD C,$3F      ; Set the mask for the random heading to #N$3F.
 $9A07 JP $995F      ; Jump to #R$995F.

; Update Pickup Entity
;
; Updates an entity of the type #N$0F, which is made by #R$96BB. While the
; frame of the entity is #N$00 or #N$01 it moves up or down on its third
; coordinate to line up with the player, and in one frame in every #N$80, on
; average, it changes into frame #N$02. Frame #N$03 is set up from a random
; choice of the table at #R$9AB6, and later frames count down in field #N$20
; until the entity is turned into one of type #N$07.
;
; IX The entity
@label=UpdatePickupEntity
c$9A0A LD A,(IX+$01)   ; Fetch the frame of the entity.
 $9A0D AND %00011111   ; Keep the number of the frame.
 $9A0F CP $02          ; {Jump to #R$9A55 if it is #N$02 or more.
 $9A11 JR NC,$9A55     ; }
 $9A13 LD A,($B548)    ; Fetch the first byte of the third coordinate of the player from
                       ; #R$B540(#N$B548).
 $9A16 LD H,A          ; Copy it into #REGh.
 $9A17 LD A,($B549)    ; Fetch the second byte of the third coordinate of the player from
                       ; #R$B540(#N$B549).
 $9A1A LD L,A          ; Copy it into #REGl.
 $9A1B LD BC,$0030     ; #REGbc is #N$0030.
 $9A1E ADD HL,BC       ; Add it to the third coordinate of the player.
 $9A1F LD D,(IX+$08)   ; Fetch the first byte of the third coordinate of the
                       ; entity.
 $9A22 LD E,(IX+$09)   ; Fetch the second byte of the third coordinate of the
                       ; entity.
 $9A25 SBC HL,DE       ; Subtract it from the third coordinate of the player.
 $9A27 LD HL,$0040     ; Set the speed to #N$0040, to move up.
 $9A2A JR NC,$9A2F     ; Jump to #R$9A2F if the entity is below the player.
 $9A2C LD HL,$FFC0     ; Set the speed to #N$FFC0, to move down.
@label=UpdatePickupEntity_SetSpeed
*$9A2F LD (IX+$14),H   ; Store the first byte of the speed in field #N$14 of
                       ; the entity.
 $9A32 LD (IX+$15),L   ; Store the second byte of the speed in field #N$15 of
                       ; the entity.
 $9A35 CALL $5F9E      ; Call #R$5F9E to get a random number.
 $9A38 LD A,($5F9A)    ; Fetch the low byte of the seed.
 $9A3B AND %01111111   ; Use bits 0-6.
 $9A3D JP NZ,$CF3A     ; Jump to #R$CF3A to carry on updating the entity unless they are all
                       ; zero.
 $9A40 LD (IX+$01),$02 ; Set the frame of the entity to #N$02.
 $9A44 LD (IX+$1C),$51 ; Set field #N$1C of the entity to #N$51.
 $9A48 LD (IX+$1D),$33 ; Set field #N$1D of the entity to #N$33.
 $9A4C CALL $AF21      ; Call #R$AF21 to set the sprite of the entity.
 $9A4F CALL $9F55      ; Call #R$9F55.
 $9A52 JP $CF3A        ; Jump to #R$CF3A to carry on updating the entity.
@label=UpdatePickupEntity_LaterFrames
*$9A55 CP $02          ; {Jump to #R$CF3A to carry on updating the entity if it
 $9A57 JP Z,$CF3A      ; is #N$02.}
 $9A5A CP $03          ; {Jump to #R$9A8C unless it is #N$03.
 $9A5C JR NZ,$9A8C     ; }
 $9A5E LD A,($5F9A)    ; Fetch the low byte of the seed.
 $9A61 AND %00000110   ; Use bits 1-2.
 $9A63 LD HL,$9AB6     ; Point #REGhl at #R$9AB6.
 $9A66 CALL $AA3C      ; Add the offset to find the entry.
 $9A69 LD A,(HL)       ; Fetch the frame from the entry.
 $9A6A LD (IX+$01),A   ; Set the frame of the entity.
 $9A6D INC HL          ; Move onto the next byte of the entry.
 $9A6E LD A,(HL)       ; Fetch the value from the entry.
 $9A6F LD (IX+$1D),A   ; Set field #N$1D of the entity.
 $9A72 LD (IX+$20),$40 ; Set field #N$20 of the entity to #N$40.
 $9A76 LD (IX+$1C),$03 ; Set field #N$1C of the entity to #N$03.
 $9A7A LD (IX+$14),$FF ; Set field #N$14 of the entity to #N$FF.
 $9A7E LD (IX+$15),$A0 ; Set field #N$15 of the entity to #N$A0.
 $9A82 CALL $AF21      ; Call #R$AF21 to set the sprite of the entity.
 $9A85 RES 7,(IX+$11)  ; Reset bit 7 of the heading.
 $9A89 JP $CF3A        ; Jump to #R$CF3A to carry on updating the entity.
@label=UpdatePickupEntity_Countdown
*$9A8C LD A,(IX+$1D)   ; Read field #N$1D of the entity.
 $9A8F CP $54          ; {Jump to #R$9AA7 unless it is #N$54.
 $9A91 JR NZ,$9AA7     ; }
 $9A93 CALL $98D3      ; Call #R$98D3 to choose the direction towards the
                       ; player.
 $9A96 LD A,(IX+$20)   ; Read field #N$20 of the entity.
 $9A99 OR %10000000    ; Set bit 7.
 $9A9B LD (IX+$11),A   ; Set the heading.
 $9A9E LD A,(IX+$1F)   ; Read field #N$1F of the entity.
 $9AA1 AND A           ; Test it.
 $9AA2 JP NZ,$CF3A     ; Jump to #R$CF3A to carry on updating the entity if it
                       ; is not zero.
 $9AA5 JR $9AB0        ; Jump to #R$9AB0 to finish with the entity.
@label=UpdatePickupEntity_Move
*$9AA7 CALL $9DDE      ; Call #R$9DDE.
 $9AAA DEC (IX+$20)    ; Decrease field #N$20 of the entity by one.
 $9AAD JP NZ,$CF3A     ; Jump to #R$CF3A to carry on updating the entity unless
                       ; it is zero.
@label=UpdatePickupEntity_Finish
*$9AB0 CALL $9924      ; Call #R$9924 to turn the entity into one of type
                       ; #N$07.
 $9AB3 JP $CF3A        ; Jump to #R$CF3A to carry on updating the entity.

; Pickup Frames
;
; The frames and values of field #N$1D which #R$9A0A chooses between at
; random when an entity changes into frame #N$03.
@label=PickupFrames
b$9AB6 DEFB $24,$54
 $9AB8 DEFB $26,$66
 $9ABA DEFB $27,$77
 $9ABC DEFB $28,$88

; Make Entity Sound
;
; Used by the routine at #R$9AD9.
; .
; Plays four short tones, with a pitch which depends on field #N$20 of the
; entity, and carries on with the update of the entity.
; .
; #HTML(#AUDIO0(entity-sound.wav)(#INCLUDE(EntitySound)))
;
; IX The entity
@label=MakeEntitySound
c$9ABE LD A,(IX+$20) ; Read field #N$20 of the entity.
 $9AC1 XOR %00011111 ; Flip bits 0-4.
 $9AC3 LD B,A        ; Keep it in #REGb.
 $9AC4 ADD A,A       ; {Multiply it by four...
 $9AC5 ADD A,A       ; }
 $9AC6 ADD A,B       ; ...and add it to make five times the value.
 $9AC7 ADD A,$10     ; Add #N$10 to make the length of the tones.
 $9AC9 LD B,A        ; Set the length of the tones in #REGb.
 $9ACA CALL $9E93    ; Call #R$9E93 to play a tone.
 $9ACD CALL $9E93    ; Call #R$9E93 to play a tone.
 $9AD0 CALL $9E93    ; Call #R$9E93 to play a tone.
 $9AD3 CALL $9E93    ; Call #R$9E93 to play a tone.
 $9AD6 JP $CF3D      ; Jump to #R$CF3D to carry on updating the entity.

; Update Growing Bubble Entity
;
; Updates an entity of the type #N$08. Field #N$20 counts the frames and
; field #N$23 holds the state of the entity. The entity moves up or down on its
; third coordinate depending on field #N$1F.
;
; IX The entity
@label=UpdateGrowingBubbleEntity
c$9AD9 INC (IX+$20)    ; Increase field #N$20 of the entity by one.
 $9ADC LD A,(IX+$01)   ; Fetch the frame of the entity.
 $9ADF AND %00011111   ; Keep the number of the frame.
 $9AE1 CP $06          ; {Jump to #R$9AEC unless it is #N$06.
 $9AE3 JR NZ,$9AEC     ; }
 $9AE5 BIT 1,(IX+$23)  ; {Jump to #R$99F7 if bit 1 of field #N$23 of the entity
 $9AE9 JP NZ,$99F7     ; is set.}
@label=UpdateGrowingBubbleEntity_Speed
*$9AEC LD A,(IX+$1F)   ; Read field #N$1F of the entity.
 $9AEF INC A           ; Add one.
 $9AF0 LD HL,$0028     ; Set the speed to #N$0028, to move up.
 $9AF3 CP $24          ; {Jump to #R$9AFA if it is below #N$24.
 $9AF5 JR C,$9AFA      ; }
 $9AF7 LD HL,$FFD8     ; Set the speed to #N$FFD8, to move down.
@label=UpdateGrowingBubbleEntity_SetSpeed
*$9AFA LD (IX+$14),H   ; Store the first byte of the speed in field #N$14 of
                       ; the entity.
 $9AFD LD (IX+$15),L   ; Store the second byte of the speed in field #N$15 of
                       ; the entity.
 $9B00 LD L,(IX+$23)   ; Read field #N$23 of the entity.
 $9B03 BIT 0,L         ; {Jump to #R$9B49 if bit 0 is set.
 $9B05 JR NZ,$9B49     ; }
 $9B07 LD A,(IX+$01)   ; Fetch the frame of the entity.
 $9B0A AND %00011111   ; Keep the number of the frame.
 $9B0C CP $05          ; {Jump to #R$9ABE if it is below #N$05.
 $9B0E JP C,$9ABE      ; }
 $9B11 JR NZ,$9B36     ; Jump to #R$9B36 if it is above #N$05.
 $9B13 LD A,($5F9A)    ; {Fetch the low byte of the seed from #R$5F9A and keep
 $9B16 LD B,A          ; it in #REGb.}
 $9B17 AND %11000000   ; Use bits 6-7.
 $9B19 JR Z,$9B49      ; Jump to #R$9B49 if they are zero.
 $9B1B LD A,B          ; Fetch the random number.
 $9B1C AND %00111111   ; Use bits 0-5.
 $9B1E OR %10000000    ; Set bit 7.
 $9B20 LD (IX+$11),A   ; Set the heading.
 $9B23 LD A,($5F9B)    ; Fetch the random number from #R$5F9A(#N$5F9B).
 $9B26 AND %10111100   ; Use bits 2-5 and 7.
 $9B28 ADD A,$40       ; Add #N$40.
 $9B2A LD (IX+$23),A   ; Store it in field #N$23 of the entity.
 $9B2D INC (IX+$01)    ; Move onto the next frame.
 $9B30 CALL $AF21      ; Call #R$AF21 to set the sprite of the entity.
 $9B33 JP $CF3A        ; Jump to #R$CF3A to carry on updating the entity.
@label=UpdateGrowingBubbleEntity_Countdown
*$9B36 LD A,($A2DD)    ; Fetch the low byte of the frame counter from #R$A2DD.
 $9B39 RRA             ; Rotate bit 0 into the carry flag.
 $9B3A JR C,$9B46      ; Jump to #R$9B46 if it is set.
 $9B3C LD A,L          ; Read field #N$23 of the entity.
 $9B3D SUB $04         ; Subtract #N$04.
 $9B3F JR NC,$9B43     ; Jump to #R$9B43 if there was no carry.
 $9B41 LD A,$01        ; Set the value to #N$01.
@label=UpdateGrowingBubbleEntity_Store
*$9B43 LD (IX+$23),A   ; Store it in field #N$23 of the entity.
@label=UpdateGrowingBubbleEntity_Done
*$9B46 JP $CF3A        ; Jump to #R$CF3A to carry on updating the entity.
@label=UpdateGrowingBubbleEntity_Change
*$9B49 CALL $9F55      ; Call #R$9F55.
 $9B4C LD A,(IX+$01)   ; Fetch the frame of the entity.
 $9B4F AND %11100000   ; Use bits 5-7.
 $9B51 OR %00001000    ; Set the number of the frame to #N$08.
 $9B53 LD (IX+$01),A   ; Store it.
 $9B56 CALL $AF21      ; Call #R$AF21 to set the sprite of the entity.
 $9B59 LD (IX+$1C),$51 ; Set field #N$1C of the entity to #N$51.
 $9B5D LD (IX+$23),$82 ; Set field #N$23 of the entity to #N$82.
 $9B61 JR $9B46        ; Jump to #R$9B46.

; Update Basic Entity
;
; Updates an entity of the type #N$01, #N$02 or #N$03, by passing it
; straight on to #R$CF30.
;
; IX The entity
@label=UpdateBasicEntity
c$9B63 JP $CF30      ; Jump to #R$CF30 to carry on updating the entity.

; Reset Entity Movement
;
; Used by the routines at #R$9B89, #R$9BB9 and #R$9C1A.
; .
; Resets bit 7 of the heading of an entity. If field #N$1F of the entity
; is not zero then this routine does not return to its caller, but jumps to
; #R$CF3A to carry on updating the entity. Otherwise bit 7 of field #N$23 is
; reset too.
;
; IX The entity
@label=ResetEntityMovement
c$9B66 RES 7,(IX+$11) ; Reset bit 7 of the heading.
 $9B6A LD A,(IX+$1F)  ; Read field #N$1F of the entity.
 $9B6D INC A          ; Add one.
 $9B6E CP $02         ; Compare it with #N$02.
 $9B70 POP HL         ; Drop the return address into #REGhl.
 $9B71 JP NC,$CF3A    ; Jump to #R$CF3A to carry on updating the entity if the value was
                      ; #N$02 or more.
 $9B74 RES 7,(IX+$23) ; Reset bit 7 of field #N$23 of the entity.
 $9B78 JP (HL)        ; Return to the caller.

; Test Entity Removal
;
; Used by the routines at #R$9B89 and #R$9C1A.
; .
; Calls #R$AEB0 with #REGbc set to #N$0020 and, if that returns with the
; zero flag set, frees the entity and hides its sprite.
;
; IX The entity
@label=TestEntityRemoval
c$9B79 LD BC,$0020     ; Set the value to test to #N$0020.
 $9B7C CALL $AEB0      ; Call #R$AEB0.
 $9B7F RET NZ          ; Return if the zero flag is not set.
 $9B80 LD (IX+$00),$00 ; Set the type of the entity to #N$00, to free it.
 $9B84 SET 7,(IX+$01)  ; Set bit 7 of the frame of the entity, to hide it.
 $9B88 RET             ; Return.

; Update Foam Entity
;
; Updates an entity of the type #N$0A, which is made from the first kind
; of creature at #R$99C7. Roughly once in every #N$20 frames it flips bits of
; field #N$1D, and once in every #N$40 frames it chooses a new direction towards
; the player.
;
; IX The entity
@label=UpdateFoamEntity
c$9B89 LD A,($5F9B)   ; Fetch the random number from #R$5F9A(#N$5F9B).
 $9B8C AND %00011111  ; Use bits 0-4.
 $9B8E JR NZ,$9B98    ; Jump to #R$9B98 unless they are all zero.
 $9B90 LD A,(IX+$1D)  ; Read field #N$1D of the entity.
 $9B93 XOR %11000100  ; Flip bits 2, 6 and 7.
 $9B95 LD (IX+$1D),A  ; Store it in field #N$1D of the entity.
@label=UpdateFoamEntity_Test
*$9B98 CALL $9B79     ; Call #R$9B79 to test whether the entity should be
                      ; removed.
 $9B9B CALL $9DF8     ; Call #R$9DF8.
 $9B9E BIT 7,(IX+$23) ; Test bit 7 of field #N$23 of the entity.
 $9BA2 CALL NZ,$9B66  ; Call #R$9B66 if it is set.
 $9BA5 LD A,($5F9A)   ; Fetch the low byte of the seed from #R$5F9A.
 $9BA8 AND %00111111  ; Use bits 0-5.
 $9BAA CALL Z,$98D3   ; Call #R$98D3 to choose the direction towards the player if they are
                      ; all zero.
 $9BAD LD B,$01       ; Set the size of the step to #N$01.
 $9BAF CALL $990C     ; Call #R$990C to turn the entity towards the wanted
                      ; heading.
 $9BB2 SET 7,(IX+$11) ; Set bit 7 of the heading of the entity.
 $9BB6 JP $CF3A       ; Jump to #R$CF3A to carry on updating the entity.

; Update Whirler Entity
;
; Updates an entity of the type #N$11, which is made from the third kind
; of creature at #R$99C7. Field #N$23 counts down the frames between random
; changes of its speed and its direction.
;
; IX The entity
@label=UpdateWhirlerEntity
c$9BB9 CALL $9DF8      ; Call #R$9DF8.
 $9BBC BIT 7,(IX+$23)  ; Test bit 7 of field #N$23 of the entity.
 $9BC0 CALL NZ,$9B66   ; Call #R$9B66 if it is set.
 $9BC3 DEC (IX+$23)    ; Decrease field #N$23 of the entity by one.
 $9BC6 JP NZ,$CF3A     ; Jump to #R$CF3A to carry on updating the entity unless
                       ; it is zero.
 $9BC9 LD A,($5F9B)    ; Fetch the random number from #R$5F9A(#N$5F9B).
 $9BCC LD (IX+$1D),$30 ; Set field #N$1D of the entity to #N$30.
 $9BD0 RLA             ; Rotate bit 7 of the random number into the carry flag.
 $9BD1 JR C,$9BD7      ; Jump to #R$9BD7 if it is set.
 $9BD3 LD (IX+$1D),$63 ; Set field #N$1D of the entity to #N$63.
@label=UpdateWhirlerEntity_Speed
*$9BD7 AND %11100000   ; Use bits 5-7 of the rotated value.
 $9BD9 JR NZ,$9BDF     ; Jump to #R$9BDF unless they are all zero.
 $9BDB LD (IX+$12),$03 ; Set field #N$12 of the entity to #N$03.
@label=UpdateWhirlerEntity_Delay
*$9BDF LD A,($5F9A)    ; {Fetch the low byte of the seed from #R$5F9A and keep
 $9BE2 LD B,A          ; it in #REGb.}
 $9BE3 AND %00111111   ; Use bits 0-5.
 $9BE5 LD (IX+$23),A   ; Store it as the new delay in field #N$23 of the
                       ; entity.
 $9BE8 LD A,B          ; Fetch the random number.
 $9BE9 AND %11000000   ; Use bits 6-7.
 $9BEB JR NZ,$9BF4     ; Jump to #R$9BF4 unless they are both zero.
 $9BED LD (IX+$10),$00 ; Set the speed to #N$00.
 $9BF1 JP $CF3A        ; Jump to #R$CF3A to carry on updating the entity.
@label=UpdateWhirlerEntity_Direction
*$9BF4 RRA             ; Shift bits 6-7 of the random number...
 $9BF5 RRA             ; ...down to bits 4-5.
 $9BF6 AND %00110000   ; Use bits 4-5.
 $9BF8 ADD A,$10       ; Add #N$10.
 $9BFA LD B,A          ; Keep the new value in #REGb.
 $9BFB LD A,(IX+$10)   ; Fetch the speed.
 $9BFE AND %00001111   ; Use bits 0-3.
 $9C00 OR B            ; Combine them with the new value.
 $9C01 LD (IX+$10),A   ; Set the speed.
 $9C04 LD A,($5F9B)    ; Fetch the random number from #R$5F9A(#N$5F9B).
 $9C07 AND %00001111   ; Use bits 0-3.
 $9C09 LD (IX+$20),A   ; Set field #N$20 of the entity, the wanted heading.
 $9C0C CALL $98D3      ; Call #R$98D3 to choose the direction towards the
                       ; player.
 $9C0F LD A,(IX+$20)   ; Read field #N$20 of the entity.
 $9C12 OR %10000000    ; Set bit 7.
 $9C14 LD (IX+$11),A   ; Set the heading.
 $9C17 JP $CF3A        ; Jump to #R$CF3A to carry on updating the entity.

; Update Bat Entity
;
; Updates an entity of the type #N$0B, which is made from the second kind
; of creature at #R$99C7. Field #N$23 is a countdown which is set from the
; random number when the entity is stopped.
;
; IX The entity
@label=UpdateBatEntity
c$9C1A CALL $9B79      ; Call #R$9B79 to test whether the entity should be
                       ; removed.
 $9C1D CALL $9DF8      ; Call #R$9DF8.
 $9C20 BIT 7,(IX+$23)  ; Test bit 7 of field #N$23 of the entity.
 $9C24 CALL NZ,$9B66   ; Call #R$9B66 if it is set.
 $9C27 BIT 7,(IX+$1E)  ; {Jump to #R$CF3A to carry on updating the entity if bit 7 of the
 $9C2B JP Z,$CF3A      ; flags is not set.}
 $9C2E LD (IX+$01),$01 ; Set the frame of the entity to #N$01.
 $9C32 LD (IX+$10),$00 ; Set the speed to #N$00.
 $9C36 LD (IX+$11),$00 ; Set the heading of the entity to #N$00.
 $9C3A LD A,(IX+$23)   ; Read field #N$23 of the entity.
 $9C3D AND A           ; Test it.
 $9C3E JR Z,$9C6C      ; Jump to #R$9C6C if it is zero.
 $9C40 DEC A           ; Decrease the countdown by one.
 $9C41 LD (IX+$23),A   ; Store it in field #N$23 of the entity.
 $9C44 JP NZ,$CF3A     ; Jump to #R$CF3A to carry on updating the entity unless
                       ; it is zero.
 $9C47 CALL $98D3      ; Call #R$98D3 to choose the direction towards the
                       ; player.
 $9C4A LD A,(IX+$20)   ; Read field #N$20 of the entity.
 $9C4D OR %10000000    ; Set bit 7.
 $9C4F LD (IX+$11),A   ; Set the heading.
 $9C52 LD A,($5F9B)    ; {Fetch the random number from #R$5F9A(#N$5F9B) and
 $9C55 LD B,A          ; keep it in #REGb.}
 $9C56 AND %00010000   ; Keep bit 4.
 $9C58 ADD A,$10       ; Add #N$10.
 $9C5A LD (IX+$10),A   ; Set the speed.
 $9C5D LD A,B          ; Fetch the random number.
 $9C5E AND %00000011   ; Use bits 0-1.
 $9C60 ADD A,$03       ; Add #N$03.
 $9C62 LD (IX+$12),A   ; Store it in field #N$12 of the entity.
 $9C65 LD (IX+$13),$00 ; Set field #N$13 of the entity to #N$00.
 $9C69 JP $CF3A        ; Jump to #R$CF3A to carry on updating the entity.
@label=UpdateBatEntity_Delay
*$9C6C LD A,($5F9B)    ; Fetch the random number from #R$5F9A(#N$5F9B).
 $9C6F AND %00011110   ; Use bits 1-4.
 $9C71 INC A           ; Add one.
 $9C72 LD (IX+$23),A   ; Store it as the countdown in field #N$23 of the
                       ; entity.
 $9C75 JP $CF3A        ; Jump to #R$CF3A to carry on updating the entity.

; Update Drop Entity
;
; Updates an entity of the type #N$04. Every other frame it calls #R$9DF8.
;
; IX The entity
@label=UpdateDropEntity
c$9C78 LD A,($A2DD)   ; Fetch the low byte of the frame counter from #R$A2DD.
 $9C7B AND %00000001  ; Keep bit 0.
 $9C7D CALL Z,$9DF8   ; Call #R$9DF8 on every other frame.
 $9C80 SET 7,(IX+$11) ; Set bit 7 of the heading of the entity.
 $9C84 BIT 7,(IX+$23) ; {Jump to #R$CF3A to carry on updating the entity if bit 7 of field
 $9C88 JP Z,$CF3A     ; #N$23 of the entity is not set.}
 $9C8B LD A,(IX+$1F)  ; Read field #N$1F of the entity.
 $9C8E INC A          ; Add one.
 $9C8F CP $02         ; Compare it with #N$02.
 $9C91 RES 7,(IX+$23) ; Reset bit 7 of field #N$23 of the entity.
 $9C95 JP C,$CF3A     ; Jump to #R$CF3A to carry on updating the entity if it was below
                      ; #N$02.
 $9C98 SET 7,(IX+$23) ; Set bit 7 of field #N$23 of the entity.
 $9C9C RES 7,(IX+$11) ; Reset bit 7 of the heading of the entity.
 $9CA0 JP $CF3A       ; Jump to #R$CF3A to carry on updating the entity.

; Set Up Shot Sprite
;
; Used by the routines at #R$9820 and #R$9CBA.
; .
; Sets the speed and sprite fields of an entity of the type #N$0E, which
; is made by #R$9CBA, and then sets its sprite.
;
; IX The entity
@label=SetUpShotSprite
c$9CA3 LD (IX+$10),$44 ; Set the speed to #N$44.
 $9CA7 LD (IX+$14),$FF ; Set field #N$14 of the entity to #N$FF.
 $9CAB LD (IX+$15),$C8 ; Set field #N$15 of the entity to #N$C8.
 $9CAF LD (IX+$1C),$04 ; Set field #N$1C of the entity to #N$04.
 $9CB3 LD (IX+$1D),$30 ; Set field #N$1D of the entity to #N$30.
 $9CB7 JP $AF21        ; Jump to #R$AF21 to set the sprite of the entity.

; Update Saucer Entity
;
; Updates an entity of the type #N$09, which is made from the fourth kind
; of creature at #R$99C7. On odd frames it turns towards the player, and on
; average once in every #N$20 frames it fires a new entity of the type #N$0E
; from the position of this one, if there is a free entity to use.
;
; IX The entity
@label=UpdateSaucerEntity
c$9CBA CALL $9DF8      ; Call #R$9DF8.
 $9CBD LD A,($A2DD)    ; Fetch the low byte of the frame counter from #R$A2DD.
 $9CC0 RRA             ; Rotate bit 0 into the carry flag.
 $9CC1 CALL C,$98D3    ; Call #R$98D3 on odd frames to choose the direction towards the
                       ; player.
 $9CC4 LD B,$02        ; Set the size of the step to #N$02.
 $9CC6 CALL $990C      ; Call #R$990C to turn the entity towards the wanted
                       ; heading.
 $9CC9 LD A,($5F9A)    ; Fetch the low byte of the seed from #R$5F9A.
 $9CCC AND %00011111   ; Use bits 0-4.
 $9CCE JR NZ,$9D3E     ; Jump to #R$9D3E unless they are all zero.
 $9CD0 PUSH IX         ; {Copy the address of the entity into #REGiy (using the
 $9CD2 POP IY          ; stack).}
 $9CD4 LD IX,$B5B2     ; Point #REGix at #R$B5B2.
 $9CD8 LD B,$02        ; Look at #N$02 entities.
 $9CDA CALL $979F      ; Call #R$979F to find a free entity.
 $9CDD JR NZ,$9D3E     ; Jump to #R$9D3E if there is not one.
 $9CDF CALL $9F6F      ; Call #R$9F6F.
 $9CE2 CALL $98AE      ; Call #R$98AE to clear the new entity.
 $9CE5 LD (IX+$00),$0E ; Set the type of the new entity to #N$0E.
 $9CE9 LD (IX+$01),$20 ; Set the frame of the new entity to #N$20.
 $9CED LD BC,$0008     ; #REGbc is #N$0008.
 $9CF0 LD H,(IY+$02)   ; Fetch the first byte of the first coordinate of this
                       ; entity.
 $9CF3 LD L,(IY+$03)   ; Fetch the second byte of the first coordinate of this
                       ; entity.
 $9CF6 ADD HL,BC       ; Add #N$0008.
 $9CF7 LD (IX+$02),H   ; Store the first byte of the first coordinate of the
                       ; new entity.
 $9CFA LD (IX+$03),L   ; Store the second byte of the first coordinate of the
                       ; new entity.
 $9CFD LD H,(IY+$05)   ; Fetch the first byte of the second coordinate of this
                       ; entity.
 $9D00 LD L,(IY+$06)   ; Fetch the second byte of the second coordinate of this
                       ; entity.
 $9D03 ADD HL,BC       ; Add #N$0008.
 $9D04 LD (IX+$05),H   ; Store the first byte of the second coordinate of the
                       ; new entity.
 $9D07 LD (IX+$06),L   ; Store the second byte of the second coordinate of the
                       ; new entity.
 $9D0A LD C,$03        ; #REGc is #N$03.
 $9D0C LD H,(IY+$08)   ; Fetch the first byte of the third coordinate of this
                       ; entity.
 $9D0F LD L,(IY+$09)   ; Fetch the second byte of the third coordinate of this
                       ; entity.
 $9D12 LD (IX+$08),H   ; Store the first byte of the third coordinate of the
                       ; new entity.
 $9D15 LD (IX+$09),L   ; Store the second byte of the third coordinate of the
                       ; new entity.
 $9D18 LD (IX+$0B),$04 ; Set the first size of the new entity to #N$04.
 $9D1C LD (IX+$0C),$04 ; Set the second size of the new entity to #N$04.
 $9D20 LD (IX+$0D),$04 ; Set the third size of the new entity to #N$04.
 $9D24 CALL $9CA3      ; Call #R$9CA3 to set up the sprite of the new entity.
 $9D27 LD A,($5F9A)    ; Fetch the low byte of the seed from #R$5F9A.
 $9D2A AND %00001111   ; Use bits 0-3.
 $9D2C LD (IX+$20),A   ; Set field #N$20 of the new entity, the wanted heading.
 $9D2F CALL $98D3      ; Call #R$98D3 to choose the direction towards the
                       ; player.
 $9D32 LD A,(IX+$20)   ; Read field #N$20 of the new entity.
 $9D35 OR %10000000    ; Set bit 7.
 $9D37 LD (IX+$11),A   ; Store it in field #N$11 of the new entity, the
                       ; heading.
 $9D3A PUSH IY         ; {Copy the address of this entity back into #REGix
 $9D3C POP IX          ; (using the stack).}
@label=UpdateSaucerEntity_Speed
*$9D3E LD A,(IX+$12)   ; Read field #N$12 of the entity.
 $9D41 AND A           ; Test it.
 $9D42 JR NZ,$9D5C     ; Jump to #R$9D5C if it is not zero.
 $9D44 LD A,(IX+$1F)   ; Read field #N$1F of the entity.
 $9D47 INC A           ; Add one.
 $9D48 CP $09          ; Compare it with #N$09.
 $9D4A LD A,$00        ; Set the speed to #N$00.
 $9D4C LD (IX+$14),A   ; Store the first byte of the speed in field #N$14 of
                       ; the entity.
 $9D4F LD (IX+$15),A   ; Store the second byte of the speed in field #N$15 of
                       ; the entity.
 $9D52 JR Z,$9D59      ; Jump to #R$9D59 if field #N$1F was #N$08.
 $9D54 INC A           ; Set the value to #N$01.
 $9D55 JR C,$9D59      ; Jump to #R$9D59 if field #N$1F was below #N$08.
 $9D57 NEG             ; Set the value to #N$FF.
@label=UpdateSaucerEntity_SetStep
*$9D59 LD (IX+$12),A   ; Store it in field #N$12 of the entity.
@label=UpdateSaucerEntity_Done
*$9D5C LD (IX+$13),$00 ; Set field #N$13 of the entity to #N$00.
 $9D60 SET 7,(IX+$11)  ; Set bit 7 of the heading of the entity.
 $9D64 JP $CF3A        ; Jump to #R$CF3A to carry on updating the entity.

; Update Burst Entity
;
; Updates an entity of the type #N$07, which is made by #R$9924. It plays
; two clicks, and when it reaches frame #N$07 it hides itself and frees its
; slot.
;
; IX The entity
@label=UpdateBurstEntity
c$9D67 LD A,($5F9A)    ; Fetch the low byte of the seed from #R$5F9A.
 $9D6A AND %00011111   ; Use bits 0-4.
 $9D6C ADD A,$50       ; Add #N$50 to make the length of the clicks.
 $9D6E LD B,A          ; Set the length of the clicks in #REGb.
 $9D6F CALL $9E93      ; Call #R$9E93 to play a click.
 $9D72 CALL $9E93      ; Call #R$9E93 to play a click.
 $9D75 LD A,(IX+$01)   ; Fetch the frame of the entity.
 $9D78 AND %00011111   ; Keep the number of the frame.
 $9D7A CP $07          ; {Jump to #R$CF3D to carry on updating the entity
 $9D7C JP NZ,$CF3D     ; unless it is #N$07.}
 $9D7F LD (IX+$01),$80 ; Set the frame of the entity to #N$80, to hide it.
 $9D83 CALL $AF21      ; Call #R$AF21 to set the sprite of the entity.
 $9D86 LD (IX+$00),$00 ; Set the type of the entity to #N$00, to free it.
 $9D8A JP $CF44        ; Jump to #R$CF44.

; Update Spider Entity
;
; Updates an entity of the type #N$10. If the player touches it then it is
; drawn as normal, otherwise it is freed (see #R$9DAB).
;
; IX The entity
@label=UpdateSpiderEntity
c$9D8D LD BC,$0020   ; Set the value to test to #N$0020.
 $9D90 CALL $AEB0    ; Call #R$AEB0.
 $9D93 JR Z,$9D9B    ; Jump to #R$9D9B if the zero flag is set.
 $9D95 CALL $AE0D    ; Call #R$AE0D.
 $9D98 JP $CF44      ; Jump to #R$CF44.
@label=UpdateSpiderEntity_Free
*$9D9B JR $9DAB      ; Jump to #R$9DAB to free the entity.

; Update Disc Entity
;
; Updates an entity of the type #N$0C, in the same way as #R$9D8D but with
; a different value to test.
;
; IX The entity
@label=UpdateDiscEntity
c$9D9D LD BC,$0018     ; Set the value to test to #N$0018.
 $9DA0 CALL $AEB0      ; Call #R$AEB0.
 $9DA3 JR Z,$9DAB      ; Jump to #R$9DAB if the zero flag is set.
 $9DA5 CALL $AE0D      ; Call #R$AE0D.
 $9DA8 JP $CF44        ; Jump to #R$CF44.
; This entry point is used by the routine at #R$9D8D.
; .
; Frees an entity, and resets bit 7 of the third byte of the record that
; field #N$1A of the entity points to.
@label=FreeLinkedEntity
*$9DAB LD (IX+$00),$00 ; Set the type of the entity to #N$00, to free it.
 $9DAF LD H,(IX+$1A)   ; Fetch the first byte of the address of the record from
                       ; field #N$1A.
 $9DB2 LD L,(IX+$1B)   ; Fetch the second byte of the address of the record
                       ; from field #N$1B.
 $9DB5 INC HL          ; Move onto the second byte of the record.
 $9DB6 INC HL          ; Move onto the third byte of the record.
 $9DB7 RES 7,(HL)      ; Reset bit 7 of the third byte of the record.
 $9DB9 LD (IX+$01),$80 ; Set the frame of the entity to #N$80, to hide it.
 $9DBD JP $CF44        ; Jump to #R$CF44.

; Update Sparkle Entity
;
; Updates an entity of the type #N$0D. Field #N$23 counts down the number
; of frames that the entity lasts for. It plays a buzz on every frame and flips
; bit 0 of its frame.
;
; IX The entity
@label=UpdateSparkleEntity
c$9DC0 CALL $9EEA      ; Call #R$9EEA to play a buzz.
 $9DC3 DEC (IX+$23)    ; Decrease field #N$23 of the entity by one.
 $9DC6 JR NZ,$9DD3     ; Jump to #R$9DD3 if it is not zero.
 $9DC8 LD (IX+$00),$00 ; Set the type of the entity to #N$00, to free it.
 $9DCC SET 7,(IX+$01)  ; Set bit 7 of the frame of the entity, to hide it.
 $9DD0 JP $CF44        ; Jump to #R$CF44.
@label=UpdateSparkleEntity_Flip
*$9DD3 LD A,(IX+$01)   ; Fetch the frame of the entity.
 $9DD6 XOR %00000001   ; Flip bit 0.
 $9DD8 LD (IX+$01),A   ; Store it.
 $9DDB JP $CF3D        ; Jump to #R$CF3D to carry on updating the entity.

; Decrease Entity Counter
;
; Used by the routines at #R$9A0A and #R$9E46.
; .
; Decreases the counter in the high nibble of field #N$16 of an entity by
; one. When the counter reaches zero the entity is freed and hidden.
;
; IX The entity
@label=DecreaseEntityCounter
c$9DDE LD A,(IX+$16)   ; Read field #N$16 of the entity.
 $9DE1 AND %11110000   ; Keep the counter.
 $9DE3 RET Z           ; Return if it is zero.
 $9DE4 LD A,(IX+$16)   ; Read field #N$16 of the entity.
 $9DE7 SUB $10         ; Subtract one from the counter.
 $9DE9 LD (IX+$16),A   ; Store it.
 $9DEC AND %11110000   ; Keep the counter.
 $9DEE RET NZ          ; Return if it is not zero.
 $9DEF LD (IX+$00),$00 ; Set the type of the entity to #N$00, to free it.
 $9DF3 SET 7,(IX+$01)  ; Set bit 7 of the frame of the entity, to hide it.
 $9DF7 RET             ; Return.

; Increase Entity Counter
;
; Used by the routines at #R$9B89, #R$9BB9, #R$9C1A, #R$9C78, #R$9CBA and
; #R$9E6D.
; .
; Increases the counter in the high nibble of field #N$16 of an entity by
; one, if it is not zero, and wraps it to zero after #N$08. Then plays a click
; of a random length.
;
; IX The entity
@label=IncreaseEntityCounter
c$9DF8 LD A,(IX+$16) ; Read field #N$16 of the entity.
 $9DFB LD B,A        ; Keep it in #REGb.
 $9DFC AND %11110000 ; Keep the counter.
 $9DFE RET Z         ; Return if it is zero.
 $9DFF ADD A,$10     ; Add one to the counter.
 $9E01 CP $90        ; {Jump to #R$9E06 if it is below #N$90.
 $9E03 JR C,$9E06    ; }
 $9E05 XOR A         ; Set the counter to zero.
@label=IncreaseEntityCounter_Store
*$9E06 LD C,A        ; Keep the new counter in #REGc.
 $9E07 LD A,B        ; Fetch the old value of field #N$16.
 $9E08 AND %00001111 ; Keep the low nibble.
 $9E0A OR C          ; Combine it with the new counter.
 $9E0B LD (IX+$16),A ; Store it in field #N$16 of the entity.
 $9E0E LD A,($5F9A)  ; Fetch the low byte of the seed from #R$5F9A.
 $9E11 AND %00111111 ; Use bits 0-5.
 $9E13 INC A         ; Add one.
 $9E14 JP $9E93      ; Jump to #R$9E93 to play a click.

; Update Puff Entity
;
; Updates an entity of the type #N$05. When it is in frame #N$01 the low
; nibble of field #N$23 counts down, and when that runs out the entity is freed.
;
; IX The entity
@label=UpdatePuffEntity
c$9E17 LD A,(IX+$01)   ; Fetch the frame of the entity.
 $9E1A AND %00001111   ; Use bits 0-3.
 $9E1C DEC A           ; Subtract one.
 $9E1D JR NZ,$9E34     ; Jump to #R$9E34 unless it is frame #N$01.
 $9E1F LD (IX+$10),A   ; Set the speed to #N$00.
 $9E22 LD A,(IX+$23)   ; Read field #N$23 of the entity.
 $9E25 LD B,A          ; Keep it in #REGb.
 $9E26 AND %00001111   ; Keep the low nibble.
 $9E28 SUB $01         ; Subtract one.
 $9E2A JR C,$9E3B      ; Jump to #R$9E3B if it was zero.
 $9E2C LD C,A          ; Keep the new count in #REGc.
 $9E2D LD A,B          ; Read field #N$23 of the entity.
 $9E2E AND %11110000   ; Keep the high nibble.
 $9E30 OR C            ; Combine it with the new count.
 $9E31 LD (IX+$23),A   ; Store it in field #N$23 of the entity.
; This entry point is used by the routine at #R$9E46.
@label=UpdatePuffEntity_Test
*$9E34 BIT 7,(IX+$01)  ; {Jump to #R$CF30 if bit 7 of the frame of the entity
 $9E38 JP Z,$CF30      ; is not set.}
; This entry point is used by the routine at #R$9E6D.
@label=FreeEntity
*$9E3B LD (IX+$00),$00 ; Set the type of the entity to #N$00, to free it.
 $9E3F SET 7,(IX+$01)  ; Set bit 7 of the frame of the entity, to hide it.
 $9E43 JP $CF44        ; Jump to #R$CF44.

; Update Shot Entity
;
; Updates an entity of the type #N$0E, which is made by #R$9CBA. The
; entity falls until its third coordinate reaches #N$0103.
;
; IX The entity
@label=UpdateShotEntity
c$9E46 LD A,(IX+$16)   ; Read field #N$16 of the entity.
 $9E49 AND %11110000   ; Keep the counter.
 $9E4B JR Z,$9E53      ; Jump to #R$9E53 if it is zero.
 $9E4D CALL $9DDE      ; Call #R$9DDE to count down.
 $9E50 JP $CF3D        ; Jump to #R$CF3D to carry on updating the entity.
@label=UpdateShotEntity_Fall
*$9E53 LD A,(IX+$08)   ; Fetch the first byte of the third coordinate of the
                       ; entity.
 $9E56 DEC A           ; Subtract one.
 $9E57 JR NZ,$9E34     ; Jump to #R$9E34 unless it was #N$01.
 $9E59 LD A,(IX+$09)   ; Fetch the second byte of the third coordinate of the
                       ; entity.
 $9E5C CP $03          ; {Jump to #R$9E34 if it is #N$03 or more.
 $9E5E JR NC,$9E34     ; }
 $9E60 LD (IX+$09),$03 ; Set the second byte of the third coordinate to #N$03.
 $9E64 XOR A           ; Set #REGa to zero.
 $9E65 LD (IX+$12),A   ; Set field #N$12 of the entity to zero.
 $9E68 LD (IX+$13),A   ; Set field #N$13 of the entity to zero.
 $9E6B JR $9E34        ; Jump to #R$9E34.

; Update Dome Entity
;
; Updates an entity of the type #N$06, which rises by one unit of its
; third coordinate on every frame until the countdown in field #N$23 reaches
; zero, when it is freed.
;
; IX The entity
@label=UpdateDomeEntity
c$9E6D CALL $9DF8    ; Call #R$9DF8.
 $9E70 DEC (IX+$23)  ; Decrease field #N$23 of the entity by one.
 $9E73 JP Z,$9E3B    ; Jump to #R$9E3B to free the entity if it is zero.
 $9E76 LD H,(IX+$08) ; Fetch the first byte of the third coordinate of the
                     ; entity.
 $9E79 LD L,(IX+$09) ; Fetch the second byte of the third coordinate of the
                     ; entity.
 $9E7C INC HL        ; Add one.
 $9E7D LD (IX+$08),H ; Store the first byte of the third coordinate of the
                     ; entity.
 $9E80 LD (IX+$09),L ; Store the second byte of the third coordinate of the
                     ; entity.
 $9E83 JP $CF3D      ; Jump to #R$CF3D to carry on updating the entity.

; Play Pulse
;
; Used by the routines at #R$9ED1 and #R$9F06.
; .
; Plays one cycle of a tone, by setting the speaker bit for a time and
; then clearing it for a time. This is the basis of the sound effects.
;
; B The length of the pulse
; D The length of the gap
@label=PlayPulse
c$9E86 LD A,$10      ; Set the speaker bit.
 $9E88 OUT ($FE),A   ; Write to the port.
@label=PlayPulse_Pulse
*$9E8A DJNZ $9E8A    ; Wait for the length of the pulse.
 $9E8C XOR A         ; Clear the speaker bit.
 $9E8D OUT ($FE),A   ; Write to the port.
 $9E8F LD B,D        ; Copy the length of the gap into #REGb.
@label=PlayPulse_Gap
*$9E90 DJNZ $9E90    ; Wait for the length of the gap.
 $9E92 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #CYBERUN$71D3 }
; LIST#

; Play Click
;
; Used by the routines at #R$5E65, #R$9ABE, #R$9D67, #R$9DF8, #R$9EA3, #R$9EB7,
; #R$9F31, #R$9F40, #R$9F55, #R$9F6F and #R$A5F4.
; .
; Plays one cycle of a tone in which the pulse and the gap are equally
; long.
;
; B The length of the pulse and the gap
@label=PlayClick
c$9E93 LD A,$10      ; Set the speaker bit.
 $9E95 OUT ($FE),A   ; Write to the port.
 $9E97 LD A,B        ; Save the length in #REGa.
@label=PlayClick_Pulse
*$9E98 DJNZ $9E98    ; Wait for the length of the pulse.
 $9E9A LD B,A        ; Restore the length in #REGb.
 $9E9B XOR A         ; Clear the speaker bit.
 $9E9C OUT ($FE),A   ; Write to the port.
 $9E9E LD A,B        ; Save the length in #REGa.
@label=PlayClick_Gap
*$9E9F DJNZ $9E9F    ; Wait for the length of the gap.
 $9EA1 LD B,A        ; Restore the length in #REGb.
 $9EA2 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #CYBERUN$71E0 }
; { #GUNFRIGHT$AF66 }
; { #NIGHTSHADE$C471 }
; { #PENTAGRAM$D682 }
; LIST#

; Play Fanfare
;
; Used by the routine at #R$DFF0.
; .
; Plays three rising sweeps of clicks and then the tune at #R$9EBF.
; .
; #HTML(#AUDIO0(fanfare.wav)(#INCLUDE(Fanfare)))
@label=PlayFanfare
c$9EA3 LD C,$03      ; Set the number of sweeps in #REGc to #N$03.
@label=PlayFanfare_Sweep
*$9EA5 LD B,$FF      ; Start the sweep with a length of #N$FF.
@label=PlayFanfare_Click
*$9EA7 CALL $9E93    ; Play a click.
 $9EAA DJNZ $9EA7    ; Shorten the length and jump back until the sweep has
                     ; finished.
@label=PlayFanfare_Pause
*$9EAC DJNZ $9EAC    ; Pause for a moment.
 $9EAE DEC C         ; Decrease the number of sweeps by one.
 $9EAF JR NZ,$9EA5   ; Jump back until all of the sweeps have been played.
 $9EB1 LD DE,$9EBF   ; Point #REGde at #R$9EBF.
 $9EB4 JP $A1C1      ; Jump to #R$A1C1 to play the tune.

; Play Rising Sweep
;
; Used by the routine at #R$D5DF.
; .
; Plays a sweep of clicks which get shorter, so the pitch rises.
; .
; #HTML(#AUDIO0(rising-sweep.wav)(#INCLUDE(RisingSweep)))
@label=PlayRisingSweep
c$9EB7 LD B,$FF      ; Start the sweep with a length of #N$FF.
@label=PlayRisingSweep_Click
*$9EB9 CALL $9E93    ; Play a click.
 $9EBC DJNZ $9EB9    ; Shorten the length and jump back until the sweep has
                     ; finished.
 $9EBE RET           ; Return.

; Fanfare Tune
;
; The tune for #R$9EA3, in the format used by #R$A1C1.
@label=FanfareTune
b$9EBF DEFB $0D,$19,$0D,$0F,$10,$1C,$10,$11
 $9EC7 DEFB $12,$1E,$12,$13,$14,$20,$17,$23,$0D,$FF

; Play Default Buzz
;
; Plays a buzz, using a pattern of pulses which is based on the number of
; the pulse and a seed. This entry point uses #N$1C pulses and a seed of #N$27.
; .
; #HTML(#AUDIO0(buzz.wav)(#INCLUDE(Buzz)))
@label=PlayDefaultBuzz
c$9ED1 LD C,$1C      ; Set the number of pulses to #N$1C.
 $9ED3 LD E,$27      ; Set the seed to #N$27.
; This entry point is used by the routines at #R$9EE3, #R$9EEA, #R$9EF1,
; #R$9F2A, #R$9F4E and #R$9F68.
; .
; This entry point takes the number of pulses in #REGc and the seed in
; #REGe.
@label=PlayBuzz
*$9ED5 LD A,C        ; Fetch the number of the pulse.
 $9ED6 XOR E         ; Combine it with the seed.
 $9ED7 ADD A,A       ; Double it.
 $9ED8 LD B,A        ; Use it as the length of the pulse.
 $9ED9 AND %00011111 ; Use bits 0-4.
 $9EDB LD D,A        ; Use it as the length of the gap.
 $9EDC CALL $9E86    ; Play a pulse.
 $9EDF DEC C         ; Decrease the number of pulses by one.
 $9EE0 JR NZ,$9ED5   ; Jump back until they have all been played.
 $9EE2 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #CYBERUN$7293 }
; LIST#

; Play Short Buzz
;
; Used by the routine at #R$A630.
; .
; Plays a buzz of #N$0D pulses with a seed of #N$14.
; .
; #HTML(#AUDIO0(short-buzz.wav)(#INCLUDE(ShortBuzz)))
@label=PlayShortBuzz
c$9EE3 LD C,$0D      ; Set the number of pulses to #N$0D.
 $9EE5 LD E,$14      ; Set the seed to #N$14.
 $9EE7 JP $9ED5      ; Jump to #R$9ED1(#N$9ED5) to play the buzz.

; Play Tiny Buzz
;
; Used by the routine at #R$9DC0.
; .
; Plays a buzz of #N$04 pulses with a seed of #N$03.
; .
; #HTML(#AUDIO0(tiny-buzz.wav)(#INCLUDE(TinyBuzz)))
@label=PlayTinyBuzz
c$9EEA LD C,$04      ; Set the number of pulses to #N$04.
 $9EEC LD E,$03      ; Set the seed to #N$03.
 $9EEE JP $9ED5      ; Jump to #R$9ED1(#N$9ED5) to play the buzz.

; Play Buzz Sweep
;
; Used by the routine at #R$A3FE.
; .
; Plays three buzzes, each with a lower number of pulses and a higher seed
; than the one before.
; .
; #HTML(#AUDIO0(buzz-sweep.wav)(#INCLUDE(BuzzSweep)))
@label=PlayBuzzSweep
c$9EF1 LD BC,$0330   ; Set the number of pulses to #N$30 and the number of
                     ; buzzes to #N$03.
@label=PlayBuzzSweep_Buzz
*$9EF4 PUSH BC       ; Save the counters.
 $9EF5 LD A,B        ; Fetch the number of buzzes.
 $9EF6 ADD A,A       ; Multiply it by two...
 $9EF7 ADD A,A       ; ...four...
 $9EF8 ADD A,A       ; ...and eight.
 $9EF9 ADD A,C       ; Add the number of pulses to make the seed.
 $9EFA LD E,A        ; Set the seed.
 $9EFB CALL $9ED5    ; Play the buzz.
 $9EFE POP BC        ; Restore the counters.
 $9EFF LD A,C        ; Fetch the number of pulses.
 $9F00 SUB $0C       ; Subtract #N$0C.
 $9F02 LD C,A        ; Store it.
 $9F03 DJNZ $9EF4    ; Jump back until all of the buzzes have been played.
 $9F05 RET           ; Return.

; Play Random Noise
;
; Used by the routine at #R$9924.
; .
; Plays a series of pulses of rising length, using the random number
; generator to set the length of the series and the speed of the rise.
; .
; #HTML(#AUDIO0(random-noise.wav)(#INCLUDE(RandomNoise)))
@label=PlayRandomNoise
c$9F06 LD A,($5F9A)  ; Fetch the low byte of the seed from #R$5F9A.
 $9F09 AND %00011111 ; Use bits 0-4.
 $9F0B ADD A,$07     ; Add #N$07 to make the first pulse length.
 $9F0D LD B,A        ; Use it as the length of the pulse.
 $9F0E ADD A,$14     ; Add #N$14 to make the first gap length.
 $9F10 LD D,A        ; Use it as the length of the gap.
 $9F11 LD A,($5F9B)  ; Fetch the random number from #R$5F9A(#N$5F9B).
 $9F14 AND %00001111 ; Use bits 0-3.
 $9F16 ADD A,$10     ; Add #N$10 to make the number of pulses.
 $9F18 LD C,A        ; Set the number of pulses.
@label=PlayRandomNoise_Pulse
*$9F19 PUSH BC       ; Save the counters.
 $9F1A CALL $9E86    ; Play a pulse.
 $9F1D POP BC        ; Restore the counters.
 $9F1E LD A,B        ; Fetch the length of the pulse.
 $9F1F ADD A,$08     ; Add #N$08.
 $9F21 LD B,A        ; Store it.
 $9F22 LD A,D        ; Fetch the length of the gap.
 $9F23 ADD A,$07     ; Add #N$07.
 $9F25 LD D,A        ; Store it.
 $9F26 DEC C         ; Decrease the number of pulses by one.
 $9F27 JR NZ,$9F19   ; Jump back until they have all been played.
 $9F29 RET           ; Return.

; Play Long Buzz
;
; Used by the routine at #R$D202.
; .
; Plays a buzz of #N$38 pulses with a seed of #N$7F.
; .
; #HTML(#AUDIO0(long-buzz.wav)(#INCLUDE(LongBuzz)))
@label=PlayLongBuzz
c$9F2A LD C,$38      ; Set the number of pulses to #N$38.
 $9F2C LD E,$7F      ; Set the seed to #N$7F.
 $9F2E JP $9ED5      ; Jump to #R$9ED1(#N$9ED5) to play the buzz.

; Play Falling Sweep
;
; Used by the routine at #R$D202.
; .
; Plays a sweep of #N$3F clicks which get longer, so the pitch falls.
; .
; #HTML(#AUDIO0(falling-sweep.wav)(#INCLUDE(FallingSweep)))
@label=PlayFallingSweep
c$9F31 LD C,$3F      ; Set the number of clicks to #N$3F.
@label=PlayFallingSweep_Click
*$9F33 LD A,C        ; Fetch the number of clicks left.
 $9F34 XOR %00111111 ; Flip bits 0-5, to count upwards.
 $9F36 ADD A,$10     ; Add #N$10.
 $9F38 LD B,A        ; Use it as the length of the click.
 $9F39 CALL $9E93    ; Play a click.
 $9F3C DEC C         ; Decrease the number of clicks by one.
 $9F3D JR NZ,$9F33   ; Jump back until they have all been played.
 $9F3F RET           ; Return.

; Play Short Rising Sweep
;
; Used by the routine at #R$CD11.
; .
; Plays a sweep of #N$09 clicks which get shorter, so the pitch rises.
; .
; #HTML(#AUDIO0(short-rising-sweep.wav)(#INCLUDE(ShortRisingSweep)))
@label=PlayShortRisingSweep
c$9F40 LD BC,$8009   ; Set the length of the first click to #N$80 and the number of clicks
                     ; to #N$09.
@label=PlayShortRisingSweep_Click
*$9F43 CALL $9E93    ; Play a click.
 $9F46 LD A,B        ; Fetch the length.
 $9F47 SUB $06       ; Subtract #N$06.
 $9F49 LD B,A        ; Store it.
 $9F4A DEC C         ; Decrease the number of clicks by one.
 $9F4B JR NZ,$9F43   ; Jump back until they have all been played.
 $9F4D RET           ; Return.

; Play Medium Buzz
;
; Used by the routine at #R$B7CE.
; .
; Plays a buzz of #N$0F pulses with a seed of #N$0F.
; .
; #HTML(#AUDIO0(medium-buzz.wav)(#INCLUDE(MediumBuzz)))
@label=PlayMediumBuzz
c$9F4E LD C,$0F      ; Set the number of pulses to #N$0F.
 $9F50 LD E,$0F      ; Set the seed to #N$0F.
 $9F52 JP $9ED5      ; Jump to #R$9ED1(#N$9ED5) to play the buzz.

; Play Slow Fall
;
; Used by the routines at #R$9A0A and #R$9AD9.
; .
; Plays a series of #N$12 clicks whose lengths slowly increase.
; .
; #HTML(#AUDIO0(slow-fall.wav)(#INCLUDE(SlowFall)))
@label=PlaySlowFall
c$9F55 LD C,$12      ; Set the number of clicks to #N$12.
 $9F57 LD D,$60      ; Set the base length to #N$60.
@label=PlaySlowFall_Click
*$9F59 LD A,C        ; Fetch the number of clicks left.
 $9F5A ADD A,A       ; Double it.
 $9F5B ADD A,D       ; Add the base length.
 $9F5C LD B,A        ; Use it as the length of the click.
 $9F5D CALL $9E93    ; Play a click.
 $9F60 LD A,D        ; Fetch the base length.
 $9F61 ADD A,$03     ; Add #N$03.
 $9F63 LD D,A        ; Store it.
 $9F64 DEC C         ; Decrease the number of clicks by one.
 $9F65 JR NZ,$9F59   ; Jump back until they have all been played.
 $9F67 RET           ; Return.

; Play Brief Buzz
;
; Used by the routine at #R$9820.
; .
; Plays a buzz of #N$0A pulses with a seed of #N$26.
; .
; #HTML(#AUDIO0(brief-buzz.wav)(#INCLUDE(BriefBuzz)))
@label=PlayBriefBuzz
c$9F68 LD C,$0A      ; Set the number of pulses to #N$0A.
 $9F6A LD E,$26      ; Set the seed to #N$26.
 $9F6C JP $9ED5      ; Jump to #R$9ED1(#N$9ED5) to play the buzz.

; Play Shot Sound
;
; Used by the routine at #R$9CBA.
; .
; Plays six clicks, each of length #N$80.
; .
; #HTML(#AUDIO0(shot-sound.wav)(#INCLUDE(ShotSound)))
@label=PlayShotSound
c$9F6F LD BC,$8006   ; Set the length of the clicks to #N$80 and the number of clicks to
                     ; #N$06.
@label=PlayShotSound_Click
*$9F72 CALL $9E93    ; Play a click.
 $9F75 DEC C         ; Decrease the number of clicks by one.
 $9F76 JR NZ,$9F72   ; Jump back until they have all been played.
 $9F78 RET           ; Return.

; Scratch Items
;
; Two buffers, each holding a copy of an item from the draw list that has
; been expanded into the same layout as an entity, for #R$9F99. The positions
; are copied in at offsets #N$02, #N$05 and #N$08, and the sizes at offsets
; #N$0B, #N$0C and #N$0D are always #N$06, #N$06 and #N$01.
@label=ScratchItems
g$9F79 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00 ; {Scratch item #N$00.
 $9F84 DEFB $06,$06,$01                                 ;
 $9F87 DEFB $00,$00                                     ; }
@label=ScratchItems_Second
 $9F89 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00 ; {Scratch item #N$01.
 $9F94 DEFB $06,$06,$01                                 ;
 $9F97 DEFB $00,$00                                     ; }

; Sort Draw List
;
; Used by the routines at #R$CD11 and #R$DFF0.
; .
; Sorts the draw list at #R$AFFB into the order in which the items must be
; drawn, and builds the sorted list at #R$AF8F. This is a painter's algorithm:
; an item can only be drawn after every item which is behind it. Each item in
; the lists has three bytes: flags, and the address of its record. Bit 0 of the
; flags is set if the record is an entity, and reset if it is a compact record
; with the three coordinates at offsets #N$02, #N$04 and #N$06, which is given
; the size #N$06, #N$06, #N$01. Bit 7 is set once the item has been moved to the
; sorted list. . The routine takes the first item which has not been moved, and
; compares it with each of the other items which have not been moved. The result
; for each pair is a number in the range #N$00-#N$1A, made from the relation
; along the first, second and third coordinates (#N$00 for 'the other item is
; before this one', #N$01 for 'they overlap' and #N$02 for 'the other item is
; after this one'). The number selects a routine from the table at #R$A0BE. If
; the other item has to be drawn first then it becomes the item under
; consideration (unless it has been tried already, which would be a loop). When
; an item has no other item that has to be drawn before it, it is moved to the
; sorted list and the whole process starts again.
@label=SortDrawList
c$9F99 LD HL,$AF8F   ; Point #REGhl at the sorted list.
 $9F9C LD ($A17A),HL ; Store it as the address of the next free place in the
                     ; sorted list.
; This entry point is used by the routine at #R$A179.
@label=SortDrawList_Next
*$9F9F LD DE,$AFFB   ; Point #REGde at the start of the draw list.
@label=SortDrawList_FirstLoop
*$9FA2 LD A,(DE)     ; Fetch the flags of the next item.
 $9FA3 INC DE        ; Move onto the address of the record.
 $9FA4 AND A         ; Test the flags.
 $9FA5 JP Z,$A198    ; Jump to #R$A198 if this is the end of the list.
 $9FA8 BIT 7,A       ; Test whether the item has been moved already.
 $9FAA LD L,A        ; Keep the flags in #REGl.
 $9FAB LD A,(DE)     ; Fetch the first byte of the address of the record.
 $9FAC LD C,A        ; Keep it in #REGc.
 $9FAD INC DE        ; Move onto the second byte of the address.
 $9FAE LD A,(DE)     ; Fetch it.
 $9FAF LD B,A        ; Keep it in #REGb.
 $9FB0 INC DE        ; Move onto the next item.
 $9FB1 JR NZ,$9FA2   ; Jump back to look at the next item if this one has been moved
                     ; already.
 $9FB3 LD ($A1AE),DE ; Store the address of the next item as that of the item under
                     ; consideration.
 $9FB7 PUSH BC       ; {Copy the address of the record into #REGix (using the
 $9FB8 POP IX        ; stack).}
 $9FBA RR L          ; Rotate bit 0 of the flags into the carry flag.
 $9FBC JR C,$9FDD    ; Jump to #R$9FDD if the record is an entity.
 $9FBE LD L,(IX+$02) ; Fetch the first byte of the first coordinate of the
                     ; record.
 $9FC1 LD H,(IX+$03) ; Fetch the second byte of the first coordinate of the
                     ; record.
 $9FC4 LD ($9F7B),HL ; Store the first coordinate in the first scratch item.
 $9FC7 LD L,(IX+$04) ; Fetch the first byte of the second coordinate of the
                     ; record.
 $9FCA LD H,(IX+$05) ; Fetch the second byte of the second coordinate of the
                     ; record.
 $9FCD LD ($9F7E),HL ; Store the second coordinate in the first scratch item.
 $9FD0 LD L,(IX+$06) ; Fetch the first byte of the third coordinate of the
                     ; record.
 $9FD3 LD H,(IX+$07) ; Fetch the second byte of the third coordinate of the
                     ; record.
 $9FD6 LD ($9F81),HL ; Store the third coordinate in the first scratch item.
 $9FD9 LD IX,$9F79   ; Point #REGix at #R$9F79.
; This entry point is used by the routines at #R$A0F4, #R$A0F7, #R$A0FA and
; #R$A15E.
@label=SortDrawList_SecondLoop
*$9FDD LD A,(DE)     ; Fetch the flags of the next item to compare.
 $9FDE INC DE        ; Move onto the address of the record.
 $9FDF AND A         ; Test the flags.
 $9FE0 JP Z,$A179    ; Jump to #R$A179 if the end of the list has been reached, as no other
                     ; item has to go first.
 $9FE3 BIT 7,A       ; Test whether the item has been moved already.
 $9FE5 LD L,A        ; Keep the flags in #REGl.
 $9FE6 LD A,(DE)     ; Fetch the first byte of the address of the record.
 $9FE7 LD C,A        ; Keep it in #REGc.
 $9FE8 INC DE        ; Move onto the second byte of the address.
 $9FE9 LD A,(DE)     ; Fetch it.
 $9FEA LD B,A        ; Keep it in #REGb.
 $9FEB INC DE        ; Move onto the next item.
 $9FEC JR NZ,$9FDD   ; Jump back to look at the next item if this one has been moved
                     ; already.
 $9FEE LD ($A1B0),DE ; Store the address of the next item as that of the other
                     ; item.
 $9FF2 PUSH BC       ; {Copy the address of the record into #REGiy (using the
 $9FF3 POP IY        ; stack).}
 $9FF5 RR L          ; Rotate bit 0 of the flags into the carry flag.
 $9FF7 JR C,$A01B    ; Jump to #R$A01B if the record is an entity.
 $9FF9 LD L,(IY+$02) ; Fetch the first byte of the first coordinate of the
                     ; record.
 $9FFC LD H,(IY+$03) ; Fetch the second byte of the first coordinate of the
                     ; record.
 $9FFF LD ($9F8B),HL ; Store the first coordinate in the second scratch item.
 $A002 LD L,(IY+$04) ; Fetch the first byte of the second coordinate of the
                     ; record.
 $A005 LD H,(IY+$05) ; Fetch the second byte of the second coordinate of the
                     ; record.
 $A008 LD ($9F8E),HL ; Store the second coordinate in the second scratch item.
 $A00B LD L,(IY+$06) ; Fetch the first byte of the third coordinate of the
                     ; record.
 $A00E LD H,(IY+$07) ; Fetch the second byte of the third coordinate of the
                     ; record.
 $A011 LD ($9F91),HL ; Store the third coordinate in the second scratch item.
 $A014 LD IY,$9F89   ; Point #REGiy at #R$9F89.
 $A018 LD BC,$9F89   ; Use it as the address to compare against.
; Skip the pair if both are the same item.
@label=SortDrawList_Compare
*$A01B PUSH IX       ; {Copy the address of the item under consideration into #REGhl (using
 $A01D POP HL        ; the stack).}
 $A01E AND A         ; {Compare it with the address of the other item.
 $A01F SBC HL,BC     ; }
 $A021 JR Z,$9FDD    ; Jump to #R$9FDD if they are the same item.
; Compare the third coordinate of the two items, and put the result in
; #REGc: #N$00 if the other item is entirely before this one, #N$01 if they
; overlap, and #N$02 if the other item is entirely after this one.
 $A023 EXX           ; Switch to the alternate registers.
 $A024 LD C,$00      ; Clear the result.
 $A026 LD H,(IY+$08) ; Fetch the first byte of the third coordinate of the
                     ; other item.
 $A029 LD L,(IY+$09) ; Fetch the second byte of the third coordinate of the
                     ; other item.
 $A02C LD D,$00      ; Clear #REGd.
 $A02E LD E,(IY+$0D) ; Fetch the third size of the other item.
 $A031 DEC E         ; Subtract one to make the last position it covers.
 $A032 ADD HL,DE     ; Find the last position that the other item covers.
 $A033 LD D,(IX+$08) ; Fetch the first byte of the third coordinate of this
                     ; item.
 $A036 LD E,(IX+$09) ; Fetch the second byte of the third coordinate of this
                     ; item.
 $A039 SBC HL,DE     ; Subtract the position of this item.
 $A03B JR C,$A051    ; Jump to #R$A051 if the other item ends before this one
                     ; begins.
 $A03D LD L,(IX+$0D) ; Fetch the third size of this item.
 $A040 LD H,$00      ; Clear #REGh.
 $A042 ADD HL,DE     ; Find the position just beyond this item.
 $A043 EX DE,HL      ; Keep it in #REGde.
 $A044 LD H,(IY+$08) ; Fetch the first byte of the third coordinate of the
                     ; other item.
 $A047 LD L,(IY+$09) ; Fetch the second byte of the third coordinate of the
                     ; other item.
 $A04A AND A         ; {Subtract the position beyond this item.
 $A04B SBC HL,DE     ; }
 $A04D JR C,$A050    ; Jump to #R$A050 if the other item starts before the end
                     ; of this one.
 $A04F INC C         ; Add one to the result.
@label=SortDrawList_ThirdAdd
*$A050 INC C         ; Add one to the result.
; Do the same for the second coordinate, adding #N$03 to the result for an
; overlap and #N$06 for the other item being entirely after this one.
@label=SortDrawList_Second
*$A051 LD H,(IY+$05) ; Fetch the first byte of the second coordinate of the
                     ; other item.
 $A054 LD L,(IY+$06) ; Fetch the second byte of the second coordinate of the
                     ; other item.
 $A057 LD D,$00      ; Clear #REGd.
 $A059 LD E,(IY+$0C) ; Fetch the second size of the other item.
 $A05C DEC E         ; Subtract one to make the last position it covers.
 $A05D ADD HL,DE     ; Find the last position that the other item covers.
 $A05E LD D,(IX+$05) ; Fetch the first byte of the second coordinate of this
                     ; item.
 $A061 LD E,(IX+$06) ; Fetch the second byte of the second coordinate of this
                     ; item.
 $A064 SBC HL,DE     ; Subtract the position of this item.
 $A066 JR C,$A080    ; Jump to #R$A080 if the other item ends before this one
                     ; begins.
 $A068 LD L,(IX+$0C) ; Fetch the second size of this item.
 $A06B LD H,$00      ; Clear #REGh.
 $A06D ADD HL,DE     ; Find the position just beyond this item.
 $A06E EX DE,HL      ; Keep it in #REGde.
 $A06F LD H,(IY+$05) ; Fetch the first byte of the second coordinate of the
                     ; other item.
 $A072 LD L,(IY+$06) ; Fetch the second byte of the second coordinate of the
                     ; other item.
 $A075 AND A         ; {Subtract the position beyond this item.
 $A076 SBC HL,DE     ; }
 $A078 LD A,C        ; Fetch the result so far.
 $A079 JR C,$A07D    ; Jump to #R$A07D if the other item starts before the end
                     ; of this one.
 $A07B ADD A,$03     ; Add #N$03 to the result.
@label=SortDrawList_SecondAdd
*$A07D ADD A,$03     ; Add #N$03 to the result.
 $A07F LD C,A        ; Store the result.
; Do the same for the first coordinate, adding #N$09 to the result for an
; overlap and #N$12 for the other item being entirely after this one.
@label=SortDrawList_First
*$A080 LD H,(IY+$02) ; Fetch the first byte of the first coordinate of the
                     ; other item.
 $A083 LD L,(IY+$03) ; Fetch the second byte of the first coordinate of the
                     ; other item.
 $A086 LD D,$00      ; Clear #REGd.
 $A088 LD E,(IY+$0B) ; Fetch the first size of the other item.
 $A08B DEC E         ; Subtract one to make the last position it covers.
 $A08C ADD HL,DE     ; Find the last position that the other item covers.
 $A08D LD D,(IX+$02) ; Fetch the first byte of the first coordinate of this
                     ; item.
 $A090 LD E,(IX+$03) ; Fetch the second byte of the first coordinate of this
                     ; item.
 $A093 SBC HL,DE     ; Subtract the position of this item.
 $A095 JR C,$A0AF    ; Jump to #R$A0AF if the other item ends before this one
                     ; begins.
 $A097 LD L,(IX+$0B) ; Fetch the first size of this item.
 $A09A LD H,$00      ; Clear #REGh.
 $A09C ADD HL,DE     ; Find the position just beyond this item.
 $A09D EX DE,HL      ; Keep it in #REGde.
 $A09E LD H,(IY+$02) ; Fetch the first byte of the first coordinate of the
                     ; other item.
 $A0A1 LD L,(IY+$03) ; Fetch the second byte of the first coordinate of the
                     ; other item.
 $A0A4 AND A         ; {Subtract the position beyond this item.
 $A0A5 SBC HL,DE     ; }
 $A0A7 LD A,C        ; Fetch the result so far.
 $A0A8 JR C,$A0AC    ; Jump to #R$A0AC if the other item starts before the end
                     ; of this one.
 $A0AA ADD A,$09     ; Add #N$09 to the result.
@label=SortDrawList_FirstAdd
*$A0AC ADD A,$09     ; Add #N$09 to the result.
 $A0AE LD C,A        ; Store the result.
; Use the result to jump to the routine in the table at #R$A0BE.
@label=SortDrawList_Dispatch
*$A0AF LD A,C        ; Fetch the result.
 $A0B0 ADD A,A       ; Double it to make the offset into the table.
 $A0B1 EXX           ; Switch back to the normal registers.
 $A0B2 LD HL,$A0BE   ; Point #REGhl at #R$A0BE.
 $A0B5 LD C,A        ; Copy the offset into #REGc.
 $A0B6 LD B,$00      ; Clear #REGb.
 $A0B8 ADD HL,BC     ; Add the offset to find the entry.
 $A0B9 LD A,(HL)     ; Fetch the first byte of the address.
 $A0BA INC HL        ; Move onto the second byte.
 $A0BB LD H,(HL)     ; Fetch it.
 $A0BC LD L,A        ; Combine them into #REGhl.
 $A0BD JP (HL)       ; Jump to the routine.

; Draw Order Table
;
; The routines for each result of the comparison in #R$9F99. The result is
; #N$09 times the relation along the first coordinate plus #N$03 times the
; relation along the second plus the relation along the third, where the
; relation is #N$00 if the other item is before this one, #N$01 for an overlap
; and #N$02 if it is after.
@label=DrawOrderTable
w$A0BE DEFW $A0F4
 $A0C0 DEFW $A0F4
 $A0C2 DEFW $A0F4
 $A0C4 DEFW $A0FA
 $A0C6 DEFW $A0FA
 $A0C8 DEFW $A0F4
 $A0CA DEFW $A0FA
 $A0CC DEFW $A0FA
 $A0CE DEFW $A0F4
 $A0D0 DEFW $A0F4
 $A0D2 DEFW $A0F7
 $A0D4 DEFW $A0F7
 $A0D6 DEFW $A0FA
 $A0D8 DEFW $A15E
 $A0DA DEFW $A0F7
 $A0DC DEFW $A0FA
 $A0DE DEFW $A0FA
 $A0E0 DEFW $A0F4
 $A0E2 DEFW $A0F4
 $A0E4 DEFW $A0F7
 $A0E6 DEFW $A0F7
 $A0E8 DEFW $A0F4
 $A0EA DEFW $A0F7
 $A0EC DEFW $A0F7
 $A0EE DEFW $A0F4
 $A0F0 DEFW $A0F4
 $A0F2 DEFW $A0F4

; Ignore Item
;
; The other item does not have to be drawn before this one, so carry on
; with the next other item.
@label=IgnoreItem
c$A0F4 JP $9FDD      ; Jump to #R$9FDD.

; Ignore Overlap
;
; The other item does not have to be drawn before this one (the same as
; #R$A0F4), so carry on with the next other item.
@label=IgnoreOverlap
c$A0F7 JP $9FDD      ; Jump to #R$9FDD.

; Draw Other Item First
;
; Used by the routine at #R$A15E.
; .
; The other item must be drawn before this one, so it becomes the item
; under consideration. The addresses of the entries in the draw list which have
; been tried are kept in a list at #R$A19E, and if the other item is already in
; that list then there is a loop and the other item is moved to the sorted list
; now.
@label=DrawOtherItemFirst
c$A0FA LD HL,($A1B0) ; Fetch the address of the entry after the other item.
 $A0FD DEC HL        ; Move back to the start of the item...
 $A0FE DEC HL        ; ...in the draw list...
 $A0FF DEC HL        ; ...which is three bytes.
 $A100 LD DE,$A19E   ; Point #REGde at #R$A19E.
@label=DrawOtherItemFirst_Search
*$A103 LD A,(DE)     ; Fetch the first byte of the next address in the list.
 $A104 CP $FF        ; {Jump to #R$A114 if this is the end of the list.
 $A106 JR Z,$A114    ; }
 $A108 CP H          ; Compare it with the first byte of the address of the
                     ; other item.
 $A109 INC DE        ; Move onto the second byte.
 $A10A JR NZ,$A110   ; Jump to #R$A110 if they are different.
 $A10C LD A,(DE)     ; Fetch the second byte.
 $A10D CP L          ; Compare it with the second byte of the address of the
                     ; other item.
 $A10E JR Z,$A156    ; Jump to #R$A156 if the item is in the list.
@label=DrawOtherItemFirst_Different
*$A110 INC DE        ; Move onto the next address in the list.
 $A111 JR $A103      ; Jump back to compare it.
 $A113 DEC DE        ; This instruction is never executed.
@label=DrawOtherItemFirst_Add
*$A114 LD A,H        ; Store the first byte of the address of the other item at the end of
                     ; the list.
 $A115 LD (DE),A     ; {Move onto the second byte.
 $A116 INC DE        ; }
 $A117 LD A,L        ; Fetch the second byte of the address of the other item.
 $A118 LD (DE),A     ; Store it in the list.
 $A119 INC DE        ; Move onto the end marker.
 $A11A LD A,$FF      ; Set the end marker to #N$FF.
 $A11C LD (DE),A     ; Store it.
 $A11D PUSH IY       ; {Copy the address of the other record into #REGix (using
 $A11F POP IX        ; the stack).}
 $A121 LD HL,($A1B0) ; Fetch the address of the item after the other item.
 $A124 LD ($A1AE),HL ; Make it the item under consideration.
 $A127 LD DE,$AFFB   ; Point #REGde at #R$AFFB.
 $A12A DEC HL        ; Move back to the start of the item...
 $A12B DEC HL        ; ...in the draw list...
 $A12C DEC HL        ; ...which is three bytes.
 $A12D BIT 0,(HL)    ; {Jump to #R$9FDD if the record is an entity.
 $A12F JP NZ,$9FDD   ; }
 $A132 PUSH IY       ; {Copy the address of the second scratch item into #REGhl (using the
 $A134 POP HL        ; stack).}
 $A135 LD DE,$9F79   ; Point #REGde at #R$9F79.
 $A138 LDI           ; Copy the first byte of the second scratch item to the first scratch
                     ; item.
 $A13A LDI           ; Copy the second byte.
 $A13C LDI           ; Copy the third byte.
 $A13E LDI           ; Copy the fourth byte.
 $A140 LDI           ; Copy the fifth byte.
 $A142 LDI           ; Copy the sixth byte.
 $A144 LDI           ; Copy the seventh byte.
 $A146 LDI           ; Copy the eighth byte.
 $A148 LDI           ; Copy the ninth byte.
 $A14A LDI           ; Copy the tenth byte.
 $A14C LD IX,$9F79   ; Point #REGix at #R$9F79.
 $A150 LD DE,$AFFB   ; Point #REGde at #R$AFFB.
 $A153 JP $9FDD      ; Jump to #R$9FDD.
; There is a loop, so move the other item to the sorted list now.
@label=DrawOtherItemFirst_Loop
*$A156 LD HL,($A1B0) ; Fetch the address of the item after the other item.
 $A159 LD ($A1AE),HL ; Make it the item under consideration.
 $A15C JR $A179      ; Jump to #R$A179 to move it to the sorted list.

; Resolve Full Overlap
;
; Chooses what to do when two items overlap along all three coordinates.
; An item with the flags #N$03 is drawn before the other item.
@label=ResolveFullOverlap
c$A15E LD HL,($A1AE) ; Fetch the address of the entry after the item under
                     ; consideration.
 $A161 DEC HL        ; Move back to the start of the entry...
 $A162 DEC HL        ; ...in the draw list...
 $A163 DEC HL        ; ...which is three bytes.
 $A164 LD A,(HL)     ; Fetch the flags of the item under consideration.
 $A165 CP $03        ; {Jump to #R$9FDD to carry on with the next other item if they are
 $A167 JP Z,$9FDD    ; the same.}
 $A16A LD HL,($A1B0) ; Fetch the address of the entry after the other item.
 $A16D DEC HL        ; Move back to the start of the entry...
 $A16E DEC HL        ; ...in the draw list...
 $A16F DEC HL        ; ...which is three bytes.
 $A170 LD A,(HL)     ; Fetch the flags of the other item.
 $A171 CP $03        ; {Jump to #R$A0FA if they are the same, to draw the other
 $A173 JP Z,$A0FA    ; item first.}
 $A176 JP $9FDD      ; Jump to #R$9FDD to carry on with the next other item.

; Move Item To Sorted List
;
; Used by the routines at #R$9F99 and #R$A0FA.
; .
; Moves the item under consideration to the sorted list, marks it as moved
; in the draw list, and starts again with the first item that has not been
; moved.
@label=MoveItemToSortedList
c$A179 LD DE,$0000   ; Point #REGde at the next free place in the sorted list (the address
                     ; is stored in the operand of this instruction, #R$A179(#N$A17A)).
 $A17C LD HL,($A1AE) ; Fetch the address of the entry after the item under
                     ; consideration.
 $A17F DEC HL        ; Move back to the start of the entry...
 $A180 DEC HL        ; ...in the draw list...
 $A181 DEC HL        ; ...which is three bytes.
 $A182 LD A,(HL)     ; Fetch the flags of the item.
 $A183 SET 7,(HL)    ; Mark it as moved in the draw list.
 $A185 LD (DE),A     ; Store the flags in the sorted list.
 $A186 INC HL        ; Move onto the address of the record.
 $A187 INC DE        ; Move onto the next place in the sorted list.
 $A188 LDI           ; Copy the first byte of the address of the record.
 $A18A LDI           ; Copy the second byte.
 $A18C LD ($A17A),DE ; Store the address of the next free place in the sorted
                     ; list.
 $A190 LD A,$FF      ; Set the end marker of the list of items which have been
                     ; tried.
 $A192 LD ($A19E),A  ; Store it at the start of the list.
 $A195 JP $9F9F      ; Jump to #R$9F99(#N$9F9F) to find the next item.

; End Sorted List
;
; Used by the routine at #R$9F99.
; .
; Ends the sorted list, once all of the items have been moved to it.
@label=EndSortedList
c$A198 LD HL,($A17A) ; Fetch the address of the next free place in the sorted
                     ; list.
 $A19B LD (HL),$00   ; Write the end marker.
 $A19D RET           ; Return.

; Tried Entries
;
; The addresses of the entries in the draw list that #R$A0FA has tried
; while it looks for an item to move to the sorted list, each stored as two
; bytes and ended by #N$FF.
@label=TriedEntries
g$A19E DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
 $A1A6 DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF

; Draw List Pointers
;
; The addresses used by #R$9F99 to track its progress.
@label=ItemUnderConsideration
g$A1AE DEFW $0000    ; The address of the entry after the item under
                     ; consideration.
 $A1B0 DEFW $0000    ; The address of the entry after the other item.

; Play Music Until Key Pressed
;
; Used by the routine at #R$60FE.
; .
; Plays a piece of music, until it ends or a key is pressed.
;
; DE The address of the music
@label=PlayMusic_WaitKey
c$A1B2 XOR A         ; Select all of the keyboard rows.
 $A1B3 CALL $A8CB    ; Read the keyboard.
 $A1B6 RET NZ        ; Return if a key is being pressed.
 $A1B7 LD A,(DE)     ; Fetch the next byte of the music.
 $A1B8 CP $FF        ; {Jump to #R$A1CB if the music has ended.
 $A1BA JR Z,$A1CB    ; }
 $A1BC CALL $A1CC    ; Play the note.
 $A1BF JR $A1B2      ; Jump back for the next note.
; View the equivalent code in;
; #LIST
; { #CYBERUN$9A9A }
; LIST#

; Play Music
;
; Used by the routines at #R$60E8, #R$9EA3 and #R$DE9D.
; .
; Plays a piece of music. Each byte of the music is a note, or #N$FF at
; the end. Bits 0-5 of a note are its number in the table at #R$A226 (#N$00 for
; a rest). Bits 6-7 are not used.
; .
; The tunes played by this routine are:
; #TABLE(default,centre,centre)
; { =h Tune | =h Sound }
; { Title Tune |
; #HTML(#AUDIO0(title-tune.wav)(#INCLUDE(TitleTune))) }
; { Start Tune |
; #HTML(#AUDIO0(start-tune.wav)(#INCLUDE(StartTune))) }
; { Fanfare |
; #HTML(#AUDIO0(fanfare.wav)(#INCLUDE(Fanfare))) }
; { Game Over Tune |
; #HTML(#AUDIO0(game-over-tune.wav)(#INCLUDE(GameOverTune))) }
; TABLE#
;
; DE The address of the music
@label=PlayMusic
c$A1C1 LD A,(DE)     ; Fetch the next byte of the music.
 $A1C2 CP $FF        ; {Jump to #R$A1CB if the music has ended.
 $A1C4 JR Z,$A1CB    ; }
 $A1C6 CALL $A1CC    ; Play the note.
 $A1C9 JR $A1C1      ; Jump back for the next note.
; This entry point is used by the routine at #R$A1B2.
@label=PlayMusic_Return
*$A1CB RET           ; Return.
; View the equivalent code in;
; #LIST
; { #CYBERUN$9AA9 }
; { #GUNFRIGHT$AF8F }
; { #NIGHTSHADE$C656 }
; { #PENTAGRAM$D6B5 }
; LIST#

; Play Note
;
; Used by the routines at #R$A1B2 and #R$A1C1.
; .
; Plays a note of a piece of music, using the table at #R$A226. Each entry
; in the table has three bytes: the lengths of the inner and outer delay loops,
; which set the pitch, and the number of cycles.
;
;   A The next byte of the music
;   DE The address of the byte of the music
; O:DE The address of the next byte of the music
@label=PlayNote
c$A1CC AND %00111111 ; Use bits 0-5, the number of the note.
 $A1CE JR Z,$A20F    ; Jump to #R$A20F if it is a rest.
; Look up the delays and the number of cycles in the table at #R$A226.
 $A1D0 LD L,A        ; {Set #REGhl to the note number.
 $A1D1 LD H,$00      ; }
 $A1D3 ADD HL,HL     ; Double it.
 $A1D4 CALL $AA3C    ; Add the note number to make three times the number.
 $A1D7 LD BC,$A226   ; Point #REGbc at #R$A226.
 $A1DA ADD HL,BC     ; Find the entry of the note.
 $A1DB LD B,(HL)     ; Fetch the length of the inner delay loop.
 $A1DC INC HL        ; Move onto the next byte.
 $A1DD LD C,(HL)     ; Fetch the length of the outer delay loop.
 $A1DE INC HL        ; Move onto the next byte.
 $A1DF LD L,(HL)     ; Fetch the number of cycles.
 $A1E0 LD H,$00      ; Clear #REGh.
; Bits 6 and 7 of the note are the length, less one.
 $A1E2 LD A,(DE)     ; Fetch the byte of the music again.
 $A1E3 RLCA          ; Rotate bits 6 and 7 of the note down...
 $A1E4 RLCA          ; ...to bits 0 and 1.
 $A1E5 AND %00000011 ; Keep them, but the result is not used.
 $A1E7 XOR A         ; Set the multiplier to zero...
 $A1E8 INC A         ; ...and then to one.
; Multiply the number of cycles by the length of the note.
@label=PlayNote_Multiply
 $A1E9 PUSH DE       ; Save the address of the music.
 $A1EA LD E,L        ; Copy the low byte of the number of cycles into #REGe.
 $A1EB LD D,H        ; Copy the high byte into #REGd.
@label=PlayNote_MultiplyLoop
*$A1EC DEC A         ; Decrease the multiplier by one.
 $A1ED JR Z,$A1F2    ; Jump to #R$A1F2 if it is zero.
 $A1EF ADD HL,DE     ; Add the number of cycles again.
 $A1F0 JR $A1EC      ; Jump back to count the multiplier down.
@label=PlayNote_Multiplied
*$A1F2 POP DE        ; Restore the address of the music.
; Each pass of this loop makes one cycle of the note, so the length of
; the note is the number of cycles.
@label=PlayNote_Cycle
*$A1F3 PUSH BC       ; Save the lengths of the delay loops.
 $A1F4 XOR A         ; Clear the speaker bit.
 $A1F5 OUT ($FE),A   ; Write to the port.
@label=PlayNote_LowDelay
*$A1F7 DJNZ $A1F7    ; Wait for the inner delay loop.
 $A1F9 DEC C         ; Decrease the outer loop count by one.
 $A1FA JR NZ,$A1F7   ; Jump back until the outer delay loop has finished.
 $A1FC POP BC        ; Restore the lengths of the delay loops.
 $A1FD PUSH BC       ; Save them again.
 $A1FE LD A,$10      ; Set the speaker bit.
 $A200 OUT ($FE),A   ; Write to the port.
@label=PlayNote_HighDelay
*$A202 DJNZ $A202    ; Wait for the inner delay loop.
 $A204 DEC C         ; Decrease the outer loop count by one.
 $A205 JR NZ,$A202   ; Jump back until the outer delay loop has finished.
 $A207 POP BC        ; Restore the lengths of the delay loops.
 $A208 DEC HL        ; Decrease the number of cycles by one.
 $A209 LD A,H        ; Fetch the high byte of the number of cycles left.
 $A20A OR L          ; Combine it with the low byte, to test whether it is
                     ; zero.
 $A20B JR NZ,$A1F3   ; Jump back for the next cycle until the note has
                     ; finished.
 $A20D INC DE        ; Move onto the next byte of the music.
 $A20E RET           ; Return.
; View the equivalent code in;
; #LIST
; { #CYBERUN$9AB4 }
; { #GUNFRIGHT$AF9A }
; { #NIGHTSHADE$C661 }
; { #PENTAGRAM$D6C0 }
; LIST#

; Play Rest
;
; Used by the routine at #R$A1CC.
; .
; Plays a rest, which is a fixed length of silence, in a piece of music.
;
;   DE The address of the byte of the music
; O:DE The address of the next byte of the music
@label=PlayRest
c$A20F LD A,(DE)     ; Fetch the byte of the music again.
 $A210 INC DE        ; Move onto the next byte of the music.
 $A211 RLCA          ; Rotate bits 6 and 7 of the note down...
 $A212 RLCA          ; ...to bits 0 and 1.
 $A213 AND %00000011 ; Keep them, but the result is not used.
 $A215 XOR A         ; Set the multiplier to zero...
 $A216 INC A         ; ...and then to one.
 $A217 LD L,A        ; Store it in #REGl.
 $A218 LD BC,$430B   ; Set the length of the delay.
@label=PlayRest_Loop
*$A21B PUSH BC       ; Save the length of the delay.
@label=PlayRest_Delay
*$A21C DEC BC        ; Count the delay down.
 $A21D LD A,B        ; Combine the two bytes...
 $A21E OR C          ; ...to test whether it is zero.
 $A21F JR NZ,$A21C   ; Jump back until the delay has finished.
 $A221 POP BC        ; Restore the length of the delay.
 $A222 DEC L         ; Decrease the multiplier by one.
 $A223 JR NZ,$A21B   ; Jump back until none remain.
 $A225 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$AFDC }
; LIST#

; Note Table
;
; The notes of the music, for #R$A1CC. Each note has three bytes: the
; length of the inner delay loop, the length of the outer delay loop, and the
; number of cycles. The first note (number #N$00) is a rest and is not used.
@label=NoteTable
b$A226 DEFB $00,$00,$00
 $A229 DEFB $F4,$0A,$08
 $A22C DEFB $65,$0A,$09
 $A22F DEFB $DE,$09,$09
 $A232 DEFB $5E,$09,$0A
 $A235 DEFB $E7,$08,$0A
 $A238 DEFB $75,$08,$0B
 $A23B DEFB $0A,$08,$0C
 $A23E DEFB $A5,$07,$0C
 $A241 DEFB $45,$07,$0D
 $A244 DEFB $EB,$06,$0E
 $A247 DEFB $96,$06,$0F
 $A24A DEFB $46,$06,$0F
 $A24D DEFB $FA,$05,$10
 $A250 DEFB $B3,$05,$11
 $A253 DEFB $6F,$05,$12
 $A256 DEFB $2F,$05,$13
 $A259 DEFB $F3,$04,$15
 $A25C DEFB $F3,$04,$16
 $A25F DEFB $85,$04,$17
 $A262 DEFB $52,$04,$19
 $A265 DEFB $23,$04,$1A
 $A268 DEFB $F6,$03,$1C
 $A26B DEFB $CB,$03,$1D
 $A26E DEFB $A3,$03,$1F
 $A271 DEFB $7D,$03,$21
 $A274 DEFB $59,$03,$23
 $A277 DEFB $38,$03,$25
 $A27A DEFB $18,$03,$27
 $A27D DEFB $FA,$02,$29
 $A280 DEFB $DD,$02,$2C
 $A283 DEFB $C2,$02,$2E
 $A286 DEFB $A9,$02,$31
 $A289 DEFB $91,$02,$34
 $A28C DEFB $7B,$02,$37
 $A28F DEFB $66,$02,$3A
 $A292 DEFB $51,$02,$3E
 $A295 DEFB $3F,$02,$41
 $A298 DEFB $2D,$02,$45
 $A29B DEFB $1C,$02,$49
 $A29E DEFB $0C,$02,$4E
 $A2A1 DEFB $FD,$01,$52
 $A2A4 DEFB $EF,$01,$57
 $A2A7 DEFB $E2,$01,$5D
 $A2AA DEFB $D5,$01,$62
 $A2AD DEFB $C9,$01,$68
 $A2B0 DEFB $BD,$01,$6E
 $A2B3 DEFB $B3,$01,$75
 $A2B6 DEFB $A9,$01,$7B
 $A2B9 DEFB $9F,$01,$83
 $A2BC DEFB $96,$01,$8B
 $A2BF DEFB $8E,$01,$93
 $A2C2 DEFB $86,$01,$9C
 $A2C5 DEFB $7E,$01,$A5
 $A2C8 DEFB $77,$01,$AF
 $A2CB DEFB $71,$01,$B9
 $A2CE DEFB $6A,$01,$C4
 $A2D1 DEFB $64,$01,$D0
 $A2D4 DEFB $5F,$01,$DC
 $A2D7 DEFB $59,$01,$E9
 $A2DA DEFB $54,$01,$F7

; Frame Counter
;
; A counter that is increased once every frame.
@label=FrameCounter
g$A2DD DEFW $0000

; Countdown Timer
;
; A timer which is set to #N$28 and is then counted down to zero once
; every frame.
@label=CountdownTimer
g$A2DF DEFB $00

; Clear Bytes
;
; Used by the routines at #R$DF1F, #R$DFF0 and #R$E42F.
; .
; Sets a number of bytes to zero.
;
; B The number of bytes
; HL The address of the first byte
@label=ClearBytes
c$A2E0 LD (HL),$00   ; Write zero to the byte.
 $A2E2 INC HL        ; Move onto the next byte.
 $A2E3 DJNZ $A2E0    ; Jump back until all of the bytes have been cleared.
 $A2E5 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #CYBERUN$F30B }
; LIST#

; Swap Bytes
;
; Used by the routine at #R$A30D.
; .
; Swaps the contents of two runs of bytes.
;
; B The number of bytes
; DE The address of the first run
; HL The address of the second run
@label=SwapBytes
c$A2E6 LD C,(HL)     ; Fetch a byte of the second run.
 $A2E7 LD A,(DE)     ; Fetch a byte of the first run.
 $A2E8 LD (HL),A     ; Store it in the second run.
 $A2E9 LD A,C        ; Fetch the byte of the second run.
 $A2EA LD (DE),A     ; Store it in the first run.
 $A2EB INC HL        ; Move onto the next byte of the second run.
 $A2EC INC DE        ; Move onto the next byte of the first run.
 $A2ED DJNZ $A2E6    ; Jump back until all of the bytes have been swapped.
 $A2EF RET           ; Return.
; View the equivalent code in;
; #LIST
; { #CYBERUN$F5C4 }
; LIST#

; Update High Score
;
; Used by the routine at #R$DFF0.
; .
; Compares the five digits of the score at #R$E132 with the five digits of
; the high score at #R$E1A0 and, if the score is higher, copies it over the high
; score.
@label=UpdateHighScore
c$A2F0 LD HL,$E1A0   ; Point #REGhl at the digits of the high score.
 $A2F3 LD DE,$E132   ; Point #REGde at #R$E132.
 $A2F6 LD B,$05      ; Set a counter of five digits.
@label=UpdateHighScore_Compare
*$A2F8 LD A,(DE)     ; Fetch a digit of the score.
 $A2F9 CP (HL)       ; Compare it with the same digit of the high score.
 $A2FA RET C         ; Return if the score is lower.
 $A2FB JR NZ,$A301   ; Jump to #R$A301 if the score is higher.
 $A2FD INC DE        ; Move onto the next digit of the score.
 $A2FE INC HL        ; Move onto the next digit of the high score.
 $A2FF JR $A2F8      ; Jump back to compare the next digit.
@label=UpdateHighScore_Copy
*$A301 LD DE,$E1A0   ; Point #REGde at the digits of the high score.
 $A304 LD HL,$E132   ; Point #REGhl at #R$E132.
 $A307 LD BC,$0005   ; Set the number of digits.
 $A30A LDIR          ; Copy the score over the high score.
 $A30C RET           ; Return.

; Switch Player
;
; Used by the routine at #R$DFF0.
; .
; Switches to the other player in a two-player game, by swapping the saved
; game state of the two players, and sets up the level for the new player.
@label=SwitchPlayer
c$A30D LD A,($DEFD)  ; Fetch the number of lives of the second player from
                     ; #R$DEFD.
 $A310 AND A         ; Test it.
 $A311 RET Z         ; Return if there is no second player.
; This entry point is used by the routine at #R$DFF0.
@label=SwitchPlayer_Flip
*$A312 LD A,($A414)  ; Fetch the low byte of the operand of the instruction at
                     ; #N$A413.
 $A315 XOR %11100000 ; Flip bits 5-7.
 $A317 LD ($A414),A  ; Store it.
 $A31A LD ($D2FA),A  ; Store it in the operand byte at #N$D2FA.
 $A31D LD HL,$DEDE   ; Point #REGhl at #R$DEDE.
 $A320 LD DE,$DEFD   ; Point #REGde at #R$DEFD.
 $A323 LD B,$1F      ; Set the number of bytes to #N$1F.
 $A325 CALL $A2E6    ; Swap the two game states.
 $A328 LD HL,$E12E   ; Point #REGhl at #R$E12E.
 $A32B LD DE,$E140   ; Point #REGde at #R$E140.
 $A32E LD B,$09      ; Set the number of bytes to #N$09.
 $A330 CALL $A2E6    ; Swap them.
 $A333 LD HL,$E1A5   ; Point #REGhl at #R$E1A5.
 $A336 LD DE,$E1AB   ; Point #REGde at #R$E1AB.
 $A339 LD B,$06      ; Set the number of bytes to #N$06.
 $A33B CALL $A2E6    ; Swap them.
 $A33E LD HL,$E1B1   ; Point #REGhl at #R$E1B1.
 $A341 LD DE,$E1B7   ; Point #REGde at #R$E1B7.
 $A344 LD B,$06      ; Set the number of bytes to #N$06.
 $A346 CALL $A2E6    ; Swap them.
 $A349 LD DE,$A59D   ; Point #REGde at #R$A59D.
 $A34C LD HL,$A5A1   ; Point #REGhl at #R$A5A1.
 $A34F LD B,$04      ; Set the number of bytes to #N$04.
 $A351 CALL $A2E6    ; Swap them.
 $A354 LD A,($60FB)  ; {Fetch the control method of the first player from #R$60FB and keep
 $A357 LD B,A        ; it in #REGb.}
 $A358 LD A,($60FC)  ; Fetch the control method of the second player from
                     ; #R$60FC.
 $A35B LD ($60FB),A  ; Make it the control method of the first player.
 $A35E LD A,B        ; Fetch the old control method of the first player.
 $A35F LD ($60FC),A  ; Make it the control method of the second player.
 $A362 LD A,($DEDE)  ; Fetch the number of lives of the new player from
                     ; #R$DEDE.
 $A365 AND A         ; Test it.
 $A366 RET Z         ; Return if the new player has no lives.
 $A367 XOR A         ; Set #REGa to zero.
 $A368 LD ($A59D),A  ; Clear the first of the saved values at #R$A59D.
 $A36B LD ($A5A1),A  ; Clear the second of the saved values at
                     ; #R$A59D(#N$A5A1).
 $A36E LD A,($DEDD)  ; Fetch the number of the current player from #R$DEDD.
 $A371 XOR %00000001 ; Flip bit 0.
 $A373 LD ($DEDD),A  ; Store it.
 $A376 CALL $DE9D    ; Call #R$DE9D.
 $A379 CALL $A8D1    ; Call #R$A8D1.
 $A37C CALL $A8E1    ; Call #R$A8E1.
 $A37F CALL $E229    ; Call #R$E229.
 $A382 LD C,$00      ; #REGc is #N$00, so that the player is not placed.
 $A384 CALL $86FB    ; Call #R$86F9(#N$86FB) to find the data of the level.
 $A387 LD A,($DEE0)  ; Fetch the number of bottles left from #R$DEE0.
 $A38A PUSH AF       ; Save it.
 $A38B CALL $876B    ; Call #R$876B to set the graphics of the level.
 $A38E POP AF        ; Restore the number of bottles left.
 $A38F LD ($DEE0),A  ; Store it.
 $A392 LD HL,$7730   ; Set the position of the panel attributes.
 $A395 LD DE,$E11C   ; Point #REGde at #R$E11C.
 $A398 JP $AAE8      ; Jump to #R$AAE8 to fill the attributes.

; Restore Bottles
;
; Used by the routine at #R$DFF0.
; .
; Copies the saved state of each bottle in the level (see #R$DEE1) back
; into the objects of the level. Each entry in the list of the level selects a
; group of objects, and the objects with the type #N$01 or #N$02 in bits 0-3
; (and bit 7 set) are the bottles.
@label=RestoreBottles
c$A39B CALL $86F9    ; Call #R$86F9 to find the data of the level and place the
                     ; player.
 $A39E LD IY,$DEE1   ; Point #REGiy at #R$DEE1.
 $A3A2 LD B,(IX-$01) ; Fetch the number of entries in the list of the level.
@label=RestoreBottles_NextEntry
*$A3A5 PUSH BC       ; Save the count of entries.
 $A3A6 PUSH IX       ; Save the address of the entry.
 $A3A8 CALL $A3DB    ; Call #R$A3DB to find the objects in the group of the
                     ; entry.
 $A3AB LD A,B        ; Fetch the number of objects.
 $A3AC AND A         ; Test it.
 $A3AD JR Z,$A3D1    ; Jump to #R$A3D1 if there are no objects.
@label=RestoreBottles_NextObject
*$A3AF LD A,(IX+$01) ; Fetch the type of the next object.
 $A3B2 AND %10001111 ; Keep bit 7 and bits 0-3.
 $A3B4 CP $81        ; {Jump to #R$A3BC if it is a bottle of type #N$01.
 $A3B6 JR Z,$A3BC    ; }
 $A3B8 CP $82        ; {Jump to #R$A3C9 unless it is a bottle of type #N$02.
 $A3BA JR NZ,$A3C9   ; }
@label=RestoreBottles_Restore
*$A3BC LD A,(IX+$01) ; Fetch the type of the object again.
 $A3BF AND %01110000 ; Use bits 4-6.
 $A3C1 OR (IY+$00)   ; Combine them with the saved state of the bottle.
 $A3C4 LD (IX+$01),A ; Store the new type of the object.
 $A3C7 INC IY        ; Move onto the saved state of the next bottle.
@label=RestoreBottles_Skip
*$A3C9 INC IX        ; Move onto the next object...
 $A3CB INC IX        ; ...which is three bytes...
 $A3CD INC IX        ; ...along.
 $A3CF DJNZ $A3AF    ; Jump back until all of the objects have been looked at.
@label=RestoreBottles_NextGroup
*$A3D1 POP IX        ; Restore the address of the entry.
 $A3D3 INC IX        ; Move onto the next entry...
 $A3D5 INC IX        ; ...which is two bytes along.
 $A3D7 POP BC        ; Restore the count of entries.
 $A3D8 DJNZ $A3A5    ; Jump back until all of the entries have been looked at.
 $A3DA RET           ; Return.

; Find Group Objects
;
; Used by the routines at #R$A39B and #R$A3FE.
; .
; Finds the objects of the group which an entry in the list of a level
; refers to. The group is found in the table at #R$8BB1 from the byte at offset
; #N$08 from the entry, and its first byte holds the number of objects in the
; low five bits.
;
;   IX The address of the entry in the list of the level
; O:B The number of objects
; O:IX The address of the first object (which is three bytes long)
@label=FindGroupObjects
c$A3DB LD C,(IX+$08) ; Fetch the number of the group.
 $A3DE SLA C         ; Double it to make the offset into the table.
 $A3E0 LD B,$00      ; Clear #REGb.
 $A3E2 LD HL,$8BB1   ; Point #REGhl at #R$8BB1.
 $A3E5 ADD HL,BC     ; Add the offset to find the entry in the table.
 $A3E6 LD E,(HL)     ; Fetch the low byte of the address of the group.
 $A3E7 INC HL        ; Move onto the high byte.
 $A3E8 LD D,(HL)     ; Fetch the high byte.
 $A3E9 PUSH DE       ; {Copy the address of the group into #REGix (using the
 $A3EA POP IX        ; stack).}
 $A3EC LD A,(IX+$00) ; Fetch the first byte of the group.
 $A3EF AND %00011111 ; Keep the number of objects.
 $A3F1 LD B,A        ; Copy it into #REGb.
 $A3F2 INC IX        ; Skip the first byte of the group.
 $A3F4 INC IX        ; Skip the second byte.
 $A3F6 INC IX        ; Skip the third byte.
 $A3F8 AND %01110000 ; Use bits 4-6.
 $A3FA RET Z         ; Return if they are all zero.
 $A3FB INC IX        ; Skip a fourth byte.
 $A3FD RET           ; Return.

; Collect Bottle
;
; Used by the routine at #R$D8E4.
; .
; Handles the player collecting a bottle, if the flag at #R$DEFC is set.
; The score is increased, the bottle is shown as an empty cup, and the number of
; bottles left is decreased. If there are none left then the exit is opened.
@label=CollectBottle
c$A3FE LD A,($DEFC)    ; Fetch the flag from #R$DEFC.
 $A401 AND A           ; Test it.
 $A402 RET Z           ; Return if it is not set.
 $A403 XOR A           ; Clear the flag...
 $A404 LD ($DEFC),A    ; ...and store it.
 $A407 LD BC,$0200     ; Set the amount to add to the score.
 $A40A CALL $9662      ; Call #R$9662 to add it to the score.
 $A40D LD HL,$6000     ; Set the value of #N$6000.
 $A410 LD ($A59F),HL   ; Store it in #R$A59D(#N$A59F), which sets the target of the first
                       ; gauge.
 $A413 LD HL,$6808     ; Set the position of the picture.
 $A416 LD DE,$64BC     ; Point #REGde at #R$64BC.
 $A419 CALL $AAC4      ; Call #R$AAC4 to draw the picture.
 $A41C LD A,$04        ; Set the value #N$04...
 $A41E LD ($AB7D),A    ; ...in #R$AB0F(#N$AB7D).
 $A421 LD A,($B55C)    ; Fetch the byte of the player entity at
                       ; #R$B540(#N$B55C).
 $A424 AND %11110000   ; Keep the upper four bits.
 $A426 OR %00000100    ; Add the value #N$04.
 $A428 LD ($B55C),A    ; Store it again.
 $A42B LD A,($DEE0)    ; Fetch the number of bottles left from #R$DEE0.
 $A42E DEC A           ; Decrease it by one.
 $A42F LD ($DEE0),A    ; Store it.
 $A432 JR NZ,$A440     ; Jump to #R$A440 if there are some left.
 $A434 LD ($E1B6),A    ; Set the units digit of the count on the panel to zero.
 $A437 LD C,A          ; Set #REGc to zero, so that the player is not placed.
 $A438 CALL $86FB      ; Call #R$86F9(#N$86FB) to find the data of the level.
 $A43B CALL $A898      ; Call #R$A898 to show that the exit is open.
 $A43E JR $A457        ; Jump to #R$A457.
@label=CollectBottle_Count
*$A440 LD B,A          ; Copy the number of bottles left into #REGb.
 $A441 XOR A           ; Set #REGa to zero.
@label=CollectBottle_Convert
*$A442 ADD A,$01       ; Add one.
 $A444 DAA             ; Convert it to binary coded decimal.
 $A445 DJNZ $A442      ; Jump back until the number has been converted.
 $A447 LD B,A          ; Keep the result in #REGb.
 $A448 AND %00001111   ; Keep the units.
 $A44A LD ($E1B6),A    ; Store it as the units digit of the count on the panel.
 $A44D LD A,B          ; Fetch the result.
 $A44E RRA             ; Move the tens digit...
 $A44F RRA             ; ...down...
 $A450 RRA             ; ...to the lower...
 $A451 RRA             ; ...four bits.
 $A452 AND %00001111   ; Keep the tens.
 $A454 LD ($E1B5),A    ; Store it as the tens digit of the count on the panel.
@label=CollectBottle_Print
*$A457 LD DE,$E1B1     ; Point #REGde at the text of the count on the panel.
 $A45A CALL $A923      ; Call #R$A923 to print it.
 $A45D RES 0,(IX+$01)  ; Reset bit 0 of the type of the object in #REGix.
 $A461 SET 1,(IX+$01)  ; Set bit 1 of the type of the object in #REGix.
 $A465 LD ($C13C),IX   ; Store the address of the object at #N$C13C.
 $A469 LD ($A495),IX   ; Store the address of the object at #N$A495, the operand of the
                       ; instruction at #N$A494.
 $A46D LD IY,$DEE1     ; Point #REGiy at #R$DEE1.
 $A471 LD IX,($5CFE)   ; Fetch the address of the level data from #R$5CFE.
 $A475 LD B,(IX-$01)   ; Fetch the number of entries in the list of the level.
@label=CollectBottle_NextEntry
*$A478 PUSH BC         ; Save the count of entries.
 $A479 PUSH IX         ; Save the address of the entry.
 $A47B CALL $A3DB      ; Call #R$A3DB to find the objects in the group of the
                       ; entry.
 $A47E LD A,B          ; Fetch the number of objects.
 $A47F AND A           ; Test it.
 $A480 JR Z,$A4AD      ; Jump to #R$A4AD if there are no objects.
@label=CollectBottle_NextObject
*$A482 LD A,(IX+$01)   ; Fetch the type of the next object.
 $A485 AND %10001111   ; Keep bit 7 and bits 0-3.
 $A487 CP $81          ; {Jump to #R$A48F if it is a bottle of type #N$01.
 $A489 JR Z,$A48F      ; }
 $A48B CP $82          ; {Jump to #R$A4A5 unless it is a bottle of type #N$02.
 $A48D JR NZ,$A4A5     ; }
@label=CollectBottle_Match
*$A48F INC IY          ; Move onto the saved state of the next bottle.
 $A491 PUSH IX         ; {Copy the address of the object into #REGde (using the
 $A493 POP DE          ; stack).}
 $A494 LD HL,$0000     ; Set #REGhl to the address of the bottle that was
                       ; collected.
 $A497 AND A           ; Clear the carry flag.
 $A498 SBC HL,DE       ; Compare the two addresses.
 $A49A JR NZ,$A4A5     ; Jump to #R$A4A5 if this is not the bottle that was
                       ; collected.
 $A49C LD (IY-$01),$82 ; Set the saved state of the bottle to #N$82.
 $A4A0 POP IX          ; Discard the address of the entry.
 $A4A2 POP BC          ; Discard the count of entries.
 $A4A3 JR $A4B6        ; Jump to #R$A4B6.
@label=CollectBottle_Skip
*$A4A5 INC IX          ; Move onto the next object...
 $A4A7 INC IX          ; ...which is three bytes...
 $A4A9 INC IX          ; ...along.
 $A4AB DJNZ $A482      ; Jump back until all of the objects have been looked
                       ; at.
@label=CollectBottle_NextGroup
*$A4AD POP IX          ; Restore the address of the entry.
 $A4AF INC IX          ; Move onto the next entry...
 $A4B1 INC IX          ; ...which is two bytes along.
 $A4B3 POP BC          ; Restore the count of entries.
 $A4B4 DJNZ $A478      ; Jump back until all of the entries have been looked
                       ; at.
@label=CollectBottle_Finish
*$A4B6 LD A,$01        ; #REGa is #N$01.
 $A4B8 LD ($B1B2),A    ; Store it in the byte at #N$B1B2.
 $A4BB LD ($C653),A    ; Store it in the byte at #N$C653.
 $A4BE LD A,($5CF0)    ; Fetch the value from #R$5CF0.
 $A4C1 AND %00000111   ; Use bits 0-2.
 $A4C3 LD ($C65D),A    ; Store it in the byte at #N$C65D.
 $A4C6 LD HL,$7F10     ; Set the value #N$7F10.
 $A4C9 LD ($B1B3),HL   ; Store it at #N$B1B3.
 $A4CC LD HL,$80A0     ; Set the value #N$80A0.
 $A4CF LD ($B1B5),HL   ; Store it at #N$B1B5.
 $A4D2 LD DE,$C646     ; Point #REGde at #R$C646.
 $A4D5 LD HL,$C13B     ; Point #REGhl at #R$C13B.
 $A4D8 CALL $BA78      ; Call #R$BA78.
 $A4DB LD A,$08        ; #REGa is #N$08.
 $A4DD LD ($C794),A    ; Store it in the byte at #N$C794.
 $A4E0 LD ($C7A6),A    ; Store it in the byte at #N$C7A6.
 $A4E3 CALL $9EF1      ; Call #R$9EF1 to play a sound.
 $A4E6 RET             ; Return.

; Scroll Stage Message
;
; Used by the routine at #R$DFF0.
; .
; Scrolls the message 'STAGE' and the number of the stage across the
; window, one frame at a time, while the gauges are updated.
@label=ScrollStageMessage
c$A4E7 LD A,$07      ; Set the length of the message to #N$07...
 $A4E9 LD ($A572),A  ; ...in the operand of the instruction at #N$A571.
 $A4EC LD A,($DEDF)  ; Fetch the number of the current level from #R$DEDF.
 $A4EF INC A         ; Add one to make the number of the stage.
 $A4F0 LD ($A597),A  ; Store it as the last character of the message at
                     ; #R$A591(#N$A597).
 $A4F3 LD HL,$FF0E   ; Set the scroll counter to #N$0E and the character index
                     ; to #N$FF.
 $A4F6 LD ($A921),HL ; Store them in #R$A921 and #R$A921(#N$A922).
@label=ScrollStageMessage_Loop
*$A4F9 LD IY,($5CF1) ; Bring back #REGiy from #R$5CF1.
 $A4FD EI            ; Enable interrupts...
 $A4FE HALT          ; ...and wait for the next frame.
 $A4FF DI            ; Disable interrupts.
 $A500 LD IX,$A59D   ; Point #REGix at #R$A59D.
 $A504 CALL $A5A5    ; Update the gauge.
 $A507 LD IX,$A5A1   ; Point #REGix at #R$A5A1.
 $A50B CALL $A5A5    ; Update the gauge.
 $A50E LD HL,$A591   ; Point #REGhl at #R$A591.
 $A511 CALL $A544    ; Scroll the message by one step.
 $A514 LD A,($A922)  ; Fetch the character index from #R$A921(#N$A922).
 $A517 CP $0F        ; Compare it with #N$0F.
 $A519 RET Z         ; Return if the message has gone.
 $A51A JR $A4F9      ; Jump back to scroll the message another step.

; Scroll Time Out Message
;
; Used by the routine at #R$CD11.
; .
; Scrolls the message 'TIME OUT' across the window, one frame at a time.
@label=ScrollTimeOutMessage
c$A51C LD HL,$FF0E   ; Set the scroll counter to #N$0E and the character index
                     ; to #N$FF.
 $A51F LD ($A921),HL ; Store them in #R$A921 and #R$A921(#N$A922).
 $A522 LD A,$08      ; Set the length of the message to #N$08...
 $A524 LD ($A572),A  ; ...in the operand of the instruction at #N$A571.
@label=ScrollTimeOutMessage_Loop
*$A527 LD IY,($5CF1) ; Bring back #REGiy from #R$5CF1.
 $A52B EI            ; Enable interrupts...
 $A52C HALT          ; ...and wait for the next frame.
 $A52D DI            ; Disable interrupts.
 $A52E LD HL,$A53C   ; Point #REGhl at #R$A53C.
 $A531 CALL $A544    ; Scroll the message by one step.
 $A534 LD A,($A922)  ; Fetch the character index from #R$A921(#N$A922).
 $A537 CP $11        ; Compare it with #N$11.
 $A539 RET Z         ; Return if the message has gone.
 $A53A JR $A527      ; Jump back to scroll the message another step.

; Time Out Message
;
; The characters of the message 'TIME OUT', for #R$A51C.
@label=TimeOutMessage
b$A53C DEFB $1D,$12,$16,$0E,$27,$18,$1E,$1D ; TIME OUT

; Scroll Message
;
; Used by the routines at #R$A4E7, #R$A51C and #R$A837.
; .
; Scrolls the message in the window by one pixel and, every sixteen
; pixels, adds the next character of the message on the right.
;
; HL The address of the message
@label=ScrollMessage
c$A544 PUSH HL       ; Save the address of the message.
 $A545 LD HL,$BEA0   ; Point #REGhl at the top half of the area to scroll.
 $A548 LD BC,$020E   ; Set the width of the area to #N$02 bytes and the height
                     ; to #N$0E.
 $A54B CALL $A902    ; Scroll the area to the left by one pixel.
 $A54E LD HL,$5113   ; Point #REGhl at the first screen address to copy.
 $A551 CALL $A581    ; Copy the column of pixels.
 $A554 LD HL,$5033   ; Point #REGhl at the second screen address to copy.
 $A557 CALL $A581    ; Copy the column of pixels.
 $A55A LD HL,$8F98   ; Point #REGhl at the lower half of the area to scroll.
 $A55D LD BC,$080F   ; Set the width of the area to #N$08 bytes and the height
                     ; to #N$0F.
 $A560 CALL $A902    ; Scroll the area to the left by one pixel.
 $A563 POP HL        ; Restore the address of the message.
 $A564 AND %00001111 ; Keep the low four bits of the scroll counter.
 $A566 RET NZ        ; Return unless a new character is due.
 $A567 LD ($A921),A  ; Reset the scroll counter to zero.
 $A56A LD A,($A922)  ; Fetch the character index from #R$A921(#N$A922).
 $A56D INC A         ; Add one.
 $A56E LD ($A922),A  ; Store it.
 $A571 CP $07        ; Compare it with the length of the message.
 $A573 RET NC        ; Return if the message has been completely printed.
 $A574 CALL $AA3C    ; Add the index to the address of the message.
 $A577 LD A,(HL)     ; Fetch the character.
 $A578 LD ($A59C),A  ; Store it in the character record.
 $A57B LD DE,$A598   ; Point #REGde at #R$A598.
 $A57E JP $A923      ; Jump to #R$A923 to print the character.

; Copy Column
;
; Used by the routine at #R$A544.
; .
; Copies a column of seven pixel lines, one byte wide, from the address
; #N$C0 bytes after the destination address to the destination address.
;
; HL The destination address
@label=CopyColumn
c$A581 LD E,L        ; Copy the low byte of the destination address into #REGe.
 $A582 LD D,H        ; Copy the high byte into #REGd.
 $A583 LD A,$C0      ; Set the offset to #N$C0.
 $A585 CALL $AA3C    ; Add the offset to the source address.
; This entry point is used by the routine at #R$60FE.
@label=CopyColumn_Copy
*$A588 LD B,$07      ; Set the number of lines to #N$07.
@label=CopyColumn_Loop
*$A58A LD A,(HL)     ; Fetch a byte of the source.
 $A58B LD (DE),A     ; Store it at the destination.
 $A58C INC H         ; Move down a pixel line in the source.
 $A58D INC D         ; Move down a pixel line in the destination.
 $A58E DJNZ $A58A    ; Jump back until all of the lines have been copied.
 $A590 RET           ; Return.

; Stage Message
;
; The characters of the message 'STAGE' and the number of the stage, for
; #R$A4E7. The last character is set by #R$A4E7.
@label=StageMessage
b$A591 DEFB $1C,$1D,$0A,$10,$0E,$27,$01 ; STAGE 1

; Message Character
;
; A text record, in the format used by #R$A923, for the character that
; #R$A544 adds on the right of a message that is scrolling.
@label=MessageCharacter
g$A598 DEFB $A0,$BE,$00,$81 ; The position, colour and flags.
 $A59C DEFB $00             ; The character.

; Gauges
;
; Two gauges which are drawn as horizontal bars, for #R$A5A5. Each has
; four bytes: the current length of the bar in pixels, the column of the left
; end of the bar, and a word whose high byte is the target length. The word of
; the first gauge is counted down as time passes (see #R$A59D(#N$A59F)).
@label=Gauges
g$A59D DEFB $00      ; The current length of the first gauge.
 $A59E DEFB $00      ; The column of the left end of the first gauge.
 $A59F DEFW $6000    ; The target of the first gauge.
@label=Gauges_Second
 $A5A1 DEFB $00      ; The current length of the second gauge.
 $A5A2 DEFB $15      ; The column of the left end of the second gauge.
 $A5A3 DEFW $6000    ; The target of the second gauge.

; Update Gauge
;
; Used by the routines at #R$A4E7, #R$A5F4 and #R$CD11.
; .
; Moves the length of a gauge by one pixel towards its target, and draws
; or erases the end of the bar.
;
; IX The address of the gauge
@label=UpdateGauge
c$A5A5 LD A,(IX+$00)  ; Fetch the current length of the bar.
 $A5A8 CP (IX+$03)    ; Compare it with the target length.
 $A5AB RET Z          ; Return if it is already at the target.
 $A5AC JR NC,$A5B4    ; Jump to #R$A5B4 if the target is lower.
 $A5AE INC A          ; Add one to the length.
 $A5AF CP $55         ; Compare it with #N$55, the longest length.
 $A5B1 RET NC         ; Return if the length is too long.
 $A5B2 JR $A5BB       ; Jump to #R$A5BB.
@label=UpdateGauge_Shrink
*$A5B4 AND A          ; Test the length.
 $A5B5 RET Z          ; Return if the length is zero.
 $A5B6 DEC (IX+$00)   ; Decrease the length by one.
 $A5B9 JR $A5C0       ; Jump to #R$A5C0.
@label=UpdateGauge_Grow
*$A5BB LD (IX+$00),A  ; Store the new length.
 $A5BE AND A          ; Test it.
 $A5BF RET Z          ; Return if it is zero.
@label=UpdateGauge_Draw
*$A5C0 LD C,A         ; Keep the length in #REGc.
 $A5C1 RRA            ; Divide it by eight...
 $A5C2 RRA            ; ...to find the number of whole bytes...
 $A5C3 RRA            ; ...in the bar.
 $A5C4 AND %00011111  ; Keep the number of bytes.
 $A5C6 ADD A,(IX+$01) ; Add the column of the left end of the bar.
 $A5C9 LD L,A         ; Set the low byte of the screen address.
 $A5CA LD H,$55       ; Set the high byte of the screen address for the bottom
                      ; pixel line.
 $A5CC LD A,C         ; Fetch the length again.
 $A5CD AND %00000111  ; Keep the number of pixels in the last byte.
 $A5CF INC A          ; Add one.
 $A5D0 LD B,A         ; Use it as a counter.
 $A5D1 XOR A          ; Clear #REGa.
 $A5D2 SCF            ; Set the carry flag.
@label=UpdateGauge_Mask
*$A5D3 RRA            ; Rotate the set bit into position.
 $A5D4 DJNZ $A5D3     ; Jump back until it is in the right place.
 $A5D6 LD E,A         ; Keep the mask in #REGe.
 $A5D7 LD A,C         ; Fetch the length again.
 $A5D8 CP $03         ; {Jump to #R$A5E6 if the length is short.
 $A5DA JR C,$A5E6     ; }
 $A5DC PUSH HL        ; Save the screen address.
 $A5DD LD A,(HL)      ; Fetch the byte of the bottom pixel line.
 $A5DE XOR E          ; Flip the pixel of the end of the bar.
 $A5DF LD (HL),A      ; Store it.
 $A5E0 LD H,$52       ; Move to the top pixel line.
 $A5E2 LD A,(HL)      ; Fetch the byte of the top pixel line.
 $A5E3 XOR E          ; Flip the pixel of the end of the bar.
 $A5E4 LD (HL),A      ; Store it.
 $A5E5 POP HL         ; Restore the screen address.
@label=UpdateGauge_Pixel
*$A5E6 DEC H          ; Move up a pixel line.
 $A5E7 RRC E          ; Move the mask one pixel to the right.
 $A5E9 JR NC,$A5EC    ; Jump to #R$A5EC unless the mask moved to the next byte.
 $A5EB INC L          ; Move onto the next byte.
@label=UpdateGauge_Rest
*$A5EC LD A,E         ; Fetch the mask.
 $A5ED XOR (HL)       ; Flip the pixel of the end of the bar.
 $A5EE LD (HL),A      ; Store it.
 $A5EF DEC H          ; Move up a pixel line.
 $A5F0 LD A,E         ; Fetch the mask.
 $A5F1 XOR (HL)       ; Flip the pixel of the end of the bar.
 $A5F2 LD (HL),A      ; Store it.
 $A5F3 RET            ; Return.

; Count Down Time
;
; Used by the routine at #R$DFF0.
; .
; Counts the target of the first gauge down to zero, adding to the score
; and clicking as it goes, one frame at a time.
@label=CountDownTime
c$A5F4 LD IY,($5CF1) ; Bring back #REGiy from #R$5CF1.
 $A5F8 LD IX,$A59D   ; Point #REGix at #R$A59D.
@label=CountDownTime_Loop
*$A5FC EI            ; Enable interrupts...
 $A5FD HALT          ; ...and wait for the next frame.
 $A5FE DI            ; Disable interrupts.
 $A5FF LD A,(IX+$03) ; Fetch the target length of the gauge.
 $A602 AND A         ; Test it.
 $A603 JR Z,$A617    ; Jump to #R$A617 if it is zero.
 $A605 LD BC,$0030   ; Set the amount to add to the score.
 $A608 CALL $9662    ; Add it to the score.
 $A60B DEC (IX+$03)  ; Decrease the target length of the gauge.
 $A60E LD A,(IX+$03) ; Fetch the target length again.
 $A611 INC A         ; Add one.
 $A612 ADD A,A       ; Double it.
 $A613 LD B,A        ; Use it as the length of the click.
 $A614 CALL $9E93    ; Play a click.
@label=CountDownTime_Update
*$A617 CALL $A5A5    ; Update the gauge.
 $A61A LD A,(IX+$00) ; Fetch the length of the bar.
 $A61D OR (IX+$03)   ; Combine it with the target length.
 $A620 JR NZ,$A5FC   ; Jump back unless both are zero.
 $A622 RET           ; Return.

; Find Hidden Entity
;
; Used by the routine at #R$A630.
; .
; Looks for an entity whose frame has bit 7 set (a hidden entity).
;
;   B The number of entities to look at
;   IY The first entity
; O:IY The hidden entity, if one was found
; O:F Zero flag reset if a hidden entity was found
@label=FindHiddenEntity
c$A623 LD DE,$0026    ; Set the size of an entity.
@label=FindHiddenEntity_Loop
*$A626 BIT 7,(IY+$01) ; Test bit 7 of the frame of the entity.
 $A62A RET NZ         ; Return if it is hidden.
 $A62B ADD IY,DE      ; Move onto the next entity.
 $A62D DJNZ $A626     ; Jump back until all of the entities have been tested.
 $A62F RET            ; Return.

; Create Puff
;
; Used by the routine at #R$CD11.
; .
; Makes an entity of the type #N$05 (see #R$9E17) at the position of
; another entity, using one of the two hidden entities from #R$B540(#N$B5FE),
; and plays a buzz. Does nothing if both entities are in use.
;
; IX The other entity
@label=CreatePuff
c$A630 LD IY,$B5FE     ; Point #REGiy at the first of the two entities which
                       ; can be used.
 $A634 LD B,$02        ; Look at #N$02 entities.
 $A636 CALL $A623      ; Call #R$A623 to find a hidden entity.
 $A639 RET Z           ; Return if there is not one.
 $A63A LD (IY+$01),$00 ; Set the frame of the new entity to #N$00.
 $A63E LD (IY+$00),$05 ; Set the type of the new entity to #N$05.
 $A642 LD H,(IX+$02)   ; Fetch the first byte of the first coordinate of the
                       ; other entity.
 $A645 LD L,(IX+$03)   ; Fetch the second byte of the first coordinate of the
                       ; other entity.
 $A648 LD E,(IX+$0B)   ; Fetch the first size of the other entity.
 $A64B LD D,$00        ; Clear #REGd.
 $A64D SRL E           ; Halve the size.
 $A64F DEC E           ; Subtract one.
 $A650 ADD HL,DE       ; Add it to the first coordinate, to find the middle.
 $A651 LD (IY+$02),H   ; Store the first byte of the first coordinate of the
                       ; new entity.
 $A654 LD (IY+$03),L   ; Store the second byte of the first coordinate of the
                       ; new entity.
 $A657 LD H,(IX+$05)   ; Fetch the first byte of the second coordinate of the
                       ; other entity.
 $A65A LD L,(IX+$06)   ; Fetch the second byte of the second coordinate of the
                       ; other entity.
 $A65D LD E,(IX+$0C)   ; Fetch the second size of the other entity.
 $A660 SRL E           ; Halve the size.
 $A662 DEC E           ; Subtract one.
 $A663 ADD HL,DE       ; Add it to the second coordinate, to find the middle.
 $A664 LD (IY+$05),H   ; Store the first byte of the second coordinate of the
                       ; new entity.
 $A667 LD (IY+$06),L   ; Store the second byte of the second coordinate of the
                       ; new entity.
 $A66A LD H,(IX+$08)   ; Fetch the first byte of the third coordinate of the
                       ; other entity.
 $A66D LD L,(IX+$09)   ; Fetch the second byte of the third coordinate of the
                       ; other entity.
 $A670 LD E,(IX+$0D)   ; Fetch the third size of the other entity (which is not
                       ; used).
 $A673 LD E,$00        ; Set the offset to #N$00.
 $A675 ADD HL,DE       ; Add it to the third coordinate.
 $A676 INC HL          ; Add one.
 $A677 LD (IY+$08),H   ; Store the first byte of the third coordinate of the
                       ; new entity.
 $A67A LD (IY+$09),L   ; Store the second byte of the third coordinate of the
                       ; new entity.
 $A67D LD A,(IX+$11)   ; Fetch the heading of the other entity.
 $A680 LD (IY+$11),A   ; Copy it to the new entity.
 $A683 LD (IY+$10),$88 ; Set field #N$10 of the new entity to #N$88.
 $A687 LD (IY+$1B),$40 ; Set field #N$1B of the new entity to #N$40.
 $A68B LD (IY+$17),$06 ; Set field #N$17 of the new entity to #N$06.
 $A68F JP $9EE3        ; Jump to #R$9EE3 to play a buzz.

; Draw Needle Tip
;
; Used by the routine at #R$A724.
; .
; Draws the ball at the tip of the needle of a direction gauge into the
; buffer at #N$F517, using self-modifying versions of the sprite drawing code at
; #R$B4E8. The ball is drawn from six pairs of mask and picture values at
; #R$A6D3 (or the shifted version at #R$A6D3(#N$A6DF)), which are taken from the
; stack. The value of #R$5CDC selects the version by bit 0, and the table of
; shifts to use by bits 1-2.
;
; HL The address in the buffer
@label=DrawNeedleTip
c$A692 LD ($5CDA),SP ; Save the stack pointer.
 $A696 LD A,($5CDC)  ; Fetch the position of the tip of the needle from
                     ; #R$5CDC.
 $A699 LD SP,$A6D3   ; Point the stack at the shape of the ball.
 $A69C BIT 0,A       ; {Jump to #R$A6A3 if bit 0 of the position is reset.
 $A69E JR Z,$A6A3    ; }
 $A6A0 LD SP,$A6DF   ; Point the stack at the shifted shape of the ball.
@label=DrawNeedleTip_Shift
*$A6A3 AND %00000110 ; Use bits 1-2, the shift in pixels.
 $A6A5 JR Z,$A6C2    ; Jump to #R$A6C2 if the ball is not to be shifted.
 $A6A7 EX DE,HL      ; Exchange #REGde and #REGhl, so that #REGde is the address in the
                     ; buffer.
 $A6A8 ADD A,$F8     ; Add #N$F8 to make the high byte of the address of the
                     ; shift table.
 $A6AA LD H,A        ; Set the high byte of #REGhl to select the shift table.
 $A6AB LD A,$08      ; Set the number of bytes to step back to the next row to
                     ; #N$08...
 $A6AD LD ($B530),A  ; ...in the operand of the instruction at #N$B52F.
 $A6B0 LD A,$06      ; Set the counter of rows to #N$06...
 $A6B2 EX AF,AF'     ; ...and store it in the alternate #REGa.
 $A6B3 LD BC,$B518   ; Set #REGbc to the address of the code at
                     ; #R$B4E8(#N$B518).
 $A6B6 LD ($B534),BC ; Patch the jump at #N$B533 to go there.
 $A6BA LD ($B539),BC ; Patch the jump at #N$B538 to go there.
 $A6BE LD A,(DE)     ; Fetch the byte of the buffer.
 $A6BF JP $B518      ; Jump to #R$B4E8(#N$B518) to draw the ball.
@label=DrawNeedleTip_Unshifted
*$A6C2 LD A,$F9      ; Set the low byte of the operand of the instruction at #N$B4DB to
                     ; #N$F9...
 $A6C4 LD ($B4DC),A  ; ...to make the offset to the next row #N$FFF9.
 $A6C7 LD B,$06      ; Set the counter of rows to #N$06.
 $A6C9 LD DE,$B4D5   ; Point #REGde at the code at #R$B4E8(#N$B4D5).
 $A6CC LD ($B4E1),DE ; Patch the jump at #N$B4E0 to go there.
 $A6D0 JP $B4D5      ; Jump to #R$B4E8(#N$B4D5) to draw the ball.

; Needle Tip Shapes
;
; The ball at the tip of the needle in a direction gauge, for #R$A692.
; Each of the two shapes has six rows with two bytes per row: the mask and the
; picture. The second shape is the first shifted by one pixel.
@label=NeedleTipShapes
b$A6D3 DEFB $38,$00  ; {The ball.
 $A6D5 DEFB $7C,$38  ;
 $A6D7 DEFB $FE,$6C  ;
 $A6D9 DEFB $FE,$5C  ;
 $A6DB DEFB $7C,$38  ;
 $A6DD DEFB $38,$00  ; }
@label=NeedleTipShapes_Shifted
 $A6DF DEFB $1C,$00  ; {The ball shifted by one pixel.
 $A6E1 DEFB $3E,$1C  ;
 $A6E3 DEFB $7F,$36  ;
 $A6E5 DEFB $7F,$2E  ;
 $A6E7 DEFB $3E,$1C  ;
 $A6E9 DEFB $1C,$00  ; }

; Get Direction Vector
;
; Used by the routine at #R$D037.
; .
; Finds the sine and cosine of a heading in units of #N$01/#N$40 of a
; turn, using the table at #R$A7C0. Bits 0-3 of the heading are the angle within
; a quadrant, and bits 4-5 are the quadrant. This entry point takes the heading
; from the entity.
;
;   A The heading (when entered at #R$A6F1)
;   IX The entity (when entered at #R$A6EB)
; O:BC The first component (a signed number)
; O:HL The second component (a signed number)
@label=GetDirectionVector
c$A6EB LD A,(IX+$11) ; Fetch the heading of the entity.
 $A6EE LD ($5CD8),A  ; Store it in #R$5CD8.
; This entry point is used by the routine at #R$A724.
@label=GetDirectionVector_Heading
*$A6F1 LD HL,$A7C0   ; Point #REGhl at the table of values.
 $A6F4 AND %00001111 ; Keep the angle within the quadrant.
 $A6F6 LD B,A        ; Keep it in #REGb.
 $A6F7 CALL $AA3C    ; Add the angle to the address.
 $A6FA LD C,(HL)     ; Fetch the first value.
 $A6FB LD A,B        ; Fetch the angle.
 $A6FC XOR %00001111 ; Subtract it from #N$0F...
 $A6FE INC A         ; ...and add one.
 $A6FF LD HL,$A7C0   ; Point #REGhl at #R$A7C0.
 $A702 CALL $AA3C    ; Add the new angle to the address.
 $A705 LD L,(HL)     ; Fetch the second value.
 $A706 LD H,$00      ; Clear #REGh.
 $A708 LD B,H        ; Clear #REGb.
 $A709 LD A,($5CD8)  ; Fetch the heading.
 $A70C AND %00110000 ; Keep the quadrant.
 $A70E RET Z         ; Return if it is zero.
 $A70F CP $10        ; {Jump to #R$A718 unless it is #N$10.
 $A711 JR NZ,$A718   ; }
 $A713 LD A,L        ; Fetch the second value.
 $A714 LD L,C        ; Swap the values...
 $A715 LD C,A        ; ...in #REGl and #REGc.
 $A716 DEC B         ; #REGb is #N$FF to make the first value negative.
 $A717 RET           ; Return.
@label=GetDirectionVector_Quadrant2
*$A718 CP $20        ; {Jump to #R$A71F unless it is #N$20.
 $A71A JR NZ,$A71F   ; }
 $A71C DEC H         ; #REGh is #N$FF to make the second value negative.
 $A71D DEC B         ; #REGb is #N$FF to make the first value negative.
 $A71E RET           ; Return.
@label=GetDirectionVector_Quadrant3
*$A71F LD A,C        ; Fetch the first value.
 $A720 LD C,L        ; Swap the values...
 $A721 LD L,A        ; ...in #REGl and #REGc.
 $A722 DEC H         ; #REGh is #N$FF to make the second value negative.
 $A723 RET           ; Return.

; Draw Direction Gauge
;
; Used by the routines at #R$CCC5, #R$DF1F and #R$E229.
; .
; Draws a direction gauge, which shows the heading in #R$5CD8 by a needle
; with a ball at its tip. The picture of the dial is copied into the buffer at
; #N$F517, the needle is drawn into it, and the buffer is then copied to the
; screen. The picture is seven bytes wide and #N$1C pixel lines high.
@label=DrawDirectionGauge
c$A724 LD DE,$F517   ; Point #REGde at the buffer.
 $A727 LD HL,$822D   ; Point #REGhl at #R$822D.
 $A72A LD BC,$00C4   ; Set the number of bytes to #N$00C4.
 $A72D LDIR          ; Copy the picture into the buffer.
 $A72F LD A,($5CD8)  ; Fetch the heading.
 $A732 CALL $A6F1    ; Call #R$A6EB(#N$A6F1) to find the components of the
                     ; heading.
 $A735 PUSH HL       ; Save the second component.
 $A736 PUSH BC       ; Save the first component.
 $A737 POP HL        ; Retrieve the first component in #REGhl...
 $A738 POP BC        ; ...and the second in #REGbc.
 $A739 PUSH HL       ; Save the first component.
 $A73A PUSH BC       ; Save the second component.
 $A73B PUSH HL       ; Save the first component again.
 $A73C LD L,C        ; Copy the low byte of the second component into #REGl...
 $A73D LD H,B        ; ...and the high byte into #REGh.
 $A73E EXX           ; Switch to the alternate registers.
 $A73F POP DE        ; Retrieve the first component in #REGde.
 $A740 LD B,$18      ; Set the length of the needle to #N$18.
 $A742 CALL $A7D1    ; Call #R$A7D1 to draw the needle.
 $A745 POP HL        ; Retrieve the second component.
 $A746 LD A,H        ; Fetch the sign byte of the component.
 $A747 LD H,$00      ; Clear #REGh.
 $A749 ADD HL,HL     ; Multiply the component by two...
 $A74A ADD HL,HL     ; ...four...
 $A74B ADD HL,HL     ; ...and eight.
 $A74C LD C,L        ; {Copy it into #REGbc.
 $A74D LD B,H        ; }
 $A74E ADD HL,HL     ; Multiply it by sixteen...
 $A74F ADD HL,BC     ; ...and add the eight times value to make twenty-four
                     ; times.
 $A750 AND A         ; Test the sign byte.
 $A751 LD A,H        ; Fetch the high byte of the result, which is the offset
                     ; in pixels.
 $A752 JR Z,$A756    ; Jump to #R$A756 if the component was positive.
 $A754 NEG           ; Make the offset negative.
@label=DrawDirectionGauge_Offset
*$A756 INC A         ; Add one.
 $A757 LD ($5CDC),A  ; Store the offset in #R$5CDC.
 $A75A SRA A         ; Divide the offset by two...
 $A75C SRA A         ; ...four...
 $A75E SRA A         ; ...and eight to find the byte.
 $A760 ADD A,$8A     ; Add the offset of the needle in the buffer.
 $A762 LD E,A        ; Keep the column in #REGe.
 $A763 POP HL        ; Retrieve the first component.
 $A764 LD A,H        ; Fetch the sign byte of the component.
 $A765 LD H,$00      ; Clear #REGh.
 $A767 ADD HL,HL     ; Multiply the component by two...
 $A768 ADD HL,HL     ; ...and four.
 $A769 LD C,L        ; {Copy it into #REGbc.
 $A76A LD B,H        ; }
 $A76B ADD HL,HL     ; Multiply it by eight...
 $A76C ADD HL,BC     ; ...and add the four times value to make twelve times.
 $A76D AND A         ; Test the sign byte.
 $A76E LD A,H        ; Fetch the high byte of the result, which is the offset in pixel
                     ; lines.
 $A76F JR NZ,$A773   ; Jump to #R$A773 if the component was negative.
 $A771 NEG           ; Make the offset negative.
@label=DrawDirectionGauge_Row
*$A773 LD B,A        ; Keep the offset in #REGb.
 $A774 ADD A,A       ; Multiply it by two...
 $A775 ADD A,A       ; ...four...
 $A776 ADD A,A       ; ...and eight.
 $A777 SUB B         ; Subtract the offset to make seven times the offset.
 $A778 ADD A,E       ; Add the column.
 $A779 LD L,A        ; Set the low byte of the address in the buffer.
 $A77A LD H,$F5      ; Set the high byte of the address in the buffer.
 $A77C CALL $A692    ; Call #R$A692 to draw the ball at the tip of the needle.
; Copy the buffer to the screen.
 $A77F LD ($5CDA),SP ; Save the stack pointer.
 $A783 LD SP,$F517   ; Point the stack at the buffer.
 $A786 LD HL,$55A2   ; Point #REGhl at the bottom left of the position on the
                     ; screen.
 $A789 LD A,$00      ; Load the offset of the gauge on the screen (this is set
                     ; at #N$A78A).
 $A78B ADD A,L       ; Add it to the address.
 $A78C LD L,A        ; Set the low byte of the address.
 $A78D LD B,$1C      ; Set the number of pixel lines to #N$1C.
@label=DrawDirectionGauge_Line
*$A78F LD C,L        ; Remember the start of the line.
 $A790 POP DE        ; Fetch the first two bytes of the line.
 $A791 LD (HL),E     ; Store the first byte.
 $A792 INC L         ; Move onto the next byte of the line.
 $A793 LD (HL),D     ; Store the second byte.
 $A794 INC L         ; Move onto the next byte of the line.
 $A795 POP DE        ; Fetch the third and fourth bytes of the line.
 $A796 LD (HL),E     ; Store the third byte.
 $A797 INC L         ; Move onto the next byte of the line.
 $A798 LD (HL),D     ; Store the fourth byte.
 $A799 INC L         ; Move onto the next byte of the line.
 $A79A POP DE        ; Fetch the fifth and sixth bytes of the line.
 $A79B LD (HL),E     ; Store the fifth byte.
 $A79C INC L         ; Move onto the next byte of the line.
 $A79D LD (HL),D     ; Store the sixth byte.
 $A79E INC L         ; Move onto the next byte of the line.
 $A79F POP DE        ; Fetch the seventh byte and the first byte of the next
                     ; line.
 $A7A0 DEC SP        ; Step back over the byte of the next line.
 $A7A1 LD (HL),E     ; Store the seventh byte.
 $A7A2 DEC B         ; Decrease the number of lines by one.
 $A7A3 JR Z,$A7BB    ; Jump to #R$A7BB if all of the lines have been copied.
 $A7A5 LD L,C        ; Go back to the start of the line.
 $A7A6 LD A,H        ; Fetch the high byte of the address.
 $A7A7 DEC H         ; Move up a pixel line.
 $A7A8 AND %00000111 ; Keep the number of the pixel line which the line was in.
 $A7AA JP NZ,$A78F   ; Jump back to copy the next line unless that was the top pixel line
                     ; of a character row.
 $A7AD LD A,L        ; Fetch the low byte of the address.
 $A7AE SUB $20       ; Move up a character row.
 $A7B0 LD L,A        ; Store it.
 $A7B1 JP C,$A78F    ; Jump back to copy the next line if the row was at the top of a
                     ; screen section.
 $A7B4 LD A,H        ; Fetch the high byte of the address.
 $A7B5 ADD A,$08     ; Move to the bottom pixel line of the character row.
 $A7B7 LD H,A        ; Store it.
 $A7B8 JP $A78F      ; Jump back to copy the next line.
@label=DrawDirectionGauge_Done
*$A7BB LD SP,($5CDA) ; Restore the stack pointer.
 $A7BF RET           ; Return.

; Direction Table
;
; The cosine of an angle from #N$00 to #N$10 sixteenths of a quarter turn,
; scaled so that #N$FF is one, for #R$A6EB.
@label=DirectionTable
b$A7C0 DEFB $FF,$FD,$FA,$F4,$E6,$E0,$D4,$C5
 $A7C8 DEFB $B4,$A1,$8D,$78,$61,$4A,$31,$18,$00

; Draw Line
;
; Used by the routine at #R$A724.
; .
; Draws a line into the buffer at #N$F517, starting from the centre of the
; dial. The line is two pixels wide, and it is plotted by adding the components
; of the direction to two running totals; each carry moves the line by a pixel
; line (using the first component) or by a pixel along a line (using the
; second). The code is patched according to the signs of the components.
;
; B The number of pixels to plot
; DE The first component, which moves the line up or down
; HL' The second component, which moves the line left or right
@label=DrawLine
c$A7D1 INC D         ; Test the sign byte of the first component.
 $A7D2 LD A,$F9      ; Set the step to #N$F9 (minus seven bytes), to move up a
                     ; pixel line.
 $A7D4 JR NZ,$A7D8   ; Jump to #R$A7D8 if the component is positive.
 $A7D6 LD A,$07      ; Set the step to #N$07, to move down a pixel line.
@label=DrawLine_Step
*$A7D8 LD ($A81A),A  ; Store the step in the operand of the instruction at
                     ; #N$A819.
 $A7DB SRL E         ; Halve the first component.
 $A7DD LD D,$00      ; Clear the running total in #REGd.
 $A7DF EXX           ; Switch to the alternate registers.
 $A7E0 INC H         ; Test the sign byte of the second component.
 $A7E1 LD BC,$09C0   ; Set the instructions for moving to the right.
 $A7E4 LD A,$2C      ; Set the opcode of INC L.
 $A7E6 JR NZ,$A7ED   ; Jump to #R$A7ED if the component is positive.
 $A7E8 LD BC,$0181   ; Set the instructions for moving to the left.
 $A7EB LD A,$2D      ; Set the opcode of DEC L.
@label=DrawLine_Direction
*$A7ED LD ($A82D),A  ; Patch the instruction at #N$A82D.
 $A7F0 LD A,B        ; Fetch the second byte of the instruction for rotating
                     ; the pixel.
 $A7F1 LD ($A826),A  ; Patch the instruction at #N$A825.
 $A7F4 LD A,C        ; Fetch the pixel pattern at which to move onto the next
                     ; byte.
 $A7F5 LD ($A829),A  ; Patch the operand of the instruction at #N$A828.
 $A7F8 LD H,$00      ; Clear the high byte of the second running total.
 $A7FA EXX           ; Switch back to the normal registers.
 $A7FB LD C,$18      ; Set the pixel pattern to #N$18.
 $A7FD LD HL,$F575   ; Point #REGhl at the centre of the dial in the buffer.
@label=DrawLine_Plot
*$A800 LD A,C        ; Fetch the pixel pattern.
 $A801 CP $81        ; {Jump to #R$A80F if it does not.
 $A803 JP NZ,$A80F   ; }
 $A806 SET 0,(HL)    ; Set the pixel at the right of the byte.
 $A808 INC L         ; Move onto the next byte.
 $A809 SET 7,(HL)    ; Set the pixel at the left of the byte.
 $A80B DEC L         ; Move back to the first byte.
 $A80C JP $A811      ; Jump to #R$A811.
@label=DrawLine_Pixels
*$A80F OR (HL)       ; Combine the pixel pattern with the byte.
 $A810 LD (HL),A     ; Store it.
@label=DrawLine_Count
*$A811 DEC B         ; Decrease the number of pixels by one.
 $A812 RET Z         ; Return if all of the pixels have been plotted.
 $A813 LD A,D        ; Fetch the running total of the first component.
 $A814 ADD A,E       ; Add the first component.
 $A815 LD D,A        ; Store it.
 $A816 JP NC,$A81D   ; Jump to #R$A81D if there was no carry.
 $A819 LD A,$00      ; Set the step (this is patched at #N$A81A).
 $A81B ADD A,L       ; Add it to the address, to move up or down a pixel line.
 $A81C LD L,A        ; Store it.
@label=DrawLine_Second
*$A81D EXX           ; Switch to the alternate registers.
 $A81E LD A,H        ; Fetch the running total of the second component.
 $A81F ADD A,L       ; Add the second component.
 $A820 LD H,A        ; Store it.
 $A821 EXX           ; Switch back to the normal registers.
 $A822 JP NC,$A800   ; Jump to #R$A800 to plot the next pixel if there was no
                     ; carry.
 $A825 RRC C         ; Rotate the pixel pattern (this is patched at #N$A826).
 $A827 LD A,C        ; Fetch the pattern.
 $A828 CP $00        ; {Jump to #R$A800 if the pattern is not there yet.
 $A82A JP NZ,$A800   ; }
 $A82D INC L         ; Move onto the next byte (this is patched at #N$A82D).
 $A82E JP $A800      ; Jump to #R$A800.

; Pause Message
;
; The characters of the message 'PAUSED', for #R$A837.
@label=PauseMessage
b$A831 DEFB $19,$0A,$1E,$1C,$0E,$0D ; PAUSED

; Pause Game
;
; Used by the routines at #R$5E65 and #R$CD11.
; .
; Pauses the game, if SPACE or CAPS SHIFT is being pressed, until one of
; them is pressed again. The message 'PAUSED' scrolls in and out across the
; window.
@label=PauseGame
c$A837 LD IY,($5CF1) ; Bring back #REGiy from #R$5CF1.
 $A83B CALL $A8BB    ; Test whether SPACE or CAPS SHIFT is being pressed.
 $A83E RET Z         ; Return if not.
@label=PauseGame_Release
*$A83F CALL $A8BB    ; Test whether SPACE or CAPS SHIFT is being pressed.
 $A842 JR NZ,$A83F   ; Jump back until the keys have been released.
 $A844 LD HL,$FF0C   ; Set the scroll counter to #N$0C and the character index
                     ; to #N$FF.
 $A847 LD ($A921),HL ; Store them in #R$A921 and #R$A921(#N$A922).
 $A84A LD A,$06      ; Set the length of the message to #N$06...
 $A84C LD ($A572),A  ; ...in the operand of the instruction at #N$A571.
@label=PauseGame_ScrollIn
*$A84F EI            ; Enable interrupts...
 $A850 HALT          ; ...and wait for the next frame.
 $A851 DI            ; Disable interrupts.
 $A852 LD HL,$A831   ; Point #REGhl at #R$A831.
 $A855 CALL $A544    ; Scroll the message by one step.
 $A858 LD HL,$A831   ; Point #REGhl at #R$A831.
 $A85B CALL $A544    ; Scroll the message by another step.
 $A85E LD HL,($A921) ; Fetch the scroll counter and the character index.
 $A861 LD DE,$060C   ; Set the values at which the message is completely in.
 $A864 AND A         ; Clear the carry flag.
 $A865 SBC HL,DE     ; Compare them.
 $A867 JR NZ,$A84F   ; Jump back to scroll the message until it is completely
                     ; in.
@label=PauseGame_Wait
*$A869 CALL $A8B6    ; Wait for a short time.
 $A86C CALL $A8BB    ; Test whether SPACE or CAPS SHIFT is being pressed.
 $A86F JR Z,$A869    ; Jump back until one of them is pressed.
@label=PauseGame_Release2
*$A871 CALL $A8BB    ; Test whether SPACE or CAPS SHIFT is being pressed.
 $A874 JR NZ,$A871   ; Jump back until the keys have been released.
@label=PauseGame_ScrollOut
*$A876 EI            ; Enable interrupts...
 $A877 HALT          ; ...and wait for the next frame.
 $A878 DI            ; Disable interrupts.
 $A879 LD HL,$A831   ; Point #REGhl at #R$A831.
 $A87C CALL $A544    ; Scroll the message by one step.
 $A87F LD HL,$A831   ; Point #REGhl at #R$A831.
 $A882 CALL $A544    ; Scroll the message by one step.
 $A885 LD HL,$A831   ; Point #REGhl at #R$A831.
 $A888 CALL $A544    ; Scroll the message by one step.
 $A88B LD HL,$A831   ; Point #REGhl at #R$A831.
 $A88E CALL $A544    ; Scroll the message by one step.
 $A891 LD A,($A922)  ; Fetch the character index.
 $A894 CP $0F        ; {Jump back to #R$A876 to scroll the message until it has
 $A896 JR NZ,$A876   ; gone.}

; Show Exit Message
;
; Used by the routines at #R$A3FE and #R$DFF0.
; .
; Prints the message 'EXIT OPEN' on the window if all of the bottles have
; been collected.
@label=ShowExitMessage
c$A898 LD A,($DEE0)  ; Fetch the number of bottles left from #R$DEE0.
 $A89B AND A         ; Test it.
 $A89C RET NZ        ; Return if there are some left.
 $A89D LD DE,$A8A6   ; Point #REGde at #R$A8A6.
 $A8A0 CALL $A923    ; Print the first part of the message.
 $A8A3 JP $A923      ; Print the second part of the message.

; Exit Message
;
; The two text records of the message 'EXIT OPEN', for #R$A898.
@label=ExitMessage
b$A8A6 DEFB $70,$87         ; Position: x=#N$70, y=#N$87.
 $A8A8 DEFB $47             ; Attribute: #COLOUR(#PEEK(#PC)).
 $A8A9 DEFB $04             ; Length #N$04.
 $A8AA DEFB $0E,$21,$12,$1D ; "EXIT"
 $A8AE DEFB $70,$8F         ; Position: x=#N$70, y=#N$8F.
 $A8B0 DEFB $47             ; Attribute: #COLOUR(#PEEK(#PC)).
 $A8B1 DEFB $04             ; Length #N$04.
 $A8B2 DEFB $18,$19,$0E,$17 ; "OPEN"

; Wait
;
; Used by the routine at #R$A837.
; .
; Waits for a short time.
@label=Wait
c$A8B6 LD D,$40      ; Set the length of the wait to #N$40.
 $A8B8 JP $A8F9      ; Jump to #R$A8F9 to wait.

; Test Pause Keys
;
; Used by the routine at #R$A837.
; .
; Tests whether SPACE or CAPS SHIFT is being pressed.
;
; O:F Zero flag reset if one of them is being pressed
@label=TestPauseKeys
c$A8BB LD A,$7F      ; {Read from the keyboard;
 $A8BD CALL $A8CB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$7F | SPACE | SYMBOL SHIFT | M | N | B }
                     ; TABLE#}
 $A8C0 AND %00000001 ; Keep the bit for SPACE.
 $A8C2 RET NZ        ; Return if SPACE is being pressed.
 $A8C3 LD A,$FE      ; {Read from the keyboard;
 $A8C5 CALL $A8CB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$FE | CAPS SHIFT | Z | X | C | V }
                     ; TABLE#}
 $A8C8 AND %00000001 ; Keep the bit for CAPS SHIFT.
 $A8CA RET           ; Return.

; Read Keyboard
;
; Used by the routines at #R$60FE, #R$623F, #R$A1B2, #R$A8BB and #R$AB8F.
; .
; Reads the rows of the keyboard which are selected by the high byte of
; the port address.
;
;   A The high byte of the port address (#N$00 selects all of the rows)
; O:A The keys which are being pressed (bit set for pressed)
@label=ReadKeyboard
c$A8CB IN A,($FE)    ; Read the keyboard.
 $A8CD CPL           ; Invert the bits.
 $A8CE AND %00011111 ; Keep the bits for the five keys.
 $A8D0 RET           ; Return.

; Reset Attributes
;
; Used by the routines at #R$5E00, #R$A30D, #R$DE9D and #R$DFF0.
; .
; Sets the attributes of the lower two thirds of the screen to bright
; white on black, using the stack. The same code clears the screen when entered
; at #R$A8E1.
@label=ResetAttributes
c$A8D1 LD ($5CD8),SP ; Save the stack pointer.
 $A8D5 LD SP,$5B00   ; Point the stack at the end of the attribute file.
 $A8D8 LD BC,$8002   ; Set the number of pushes to #N$0100.
 $A8DB LD DE,$4747   ; Set the value to #N$47 (bright white ink on black
                     ; paper).
 $A8DE JP $A8EE      ; Jump to #R$A8EE.

; Clear Screen
;
; Used by the routines at #R$5E00, #R$A30D, #R$DE9D and #R$DFF0.
; .
; Sets the pixels of the whole screen to zero, using the stack.
@label=ClearScreen
c$A8E1 LD ($5CD8),SP ; Save the stack pointer.
 $A8E5 LD SP,$5800   ; Point the stack at the end of the pixel file.
 $A8E8 LD BC,$000C   ; Set the number of pushes to #N$0C00.
 $A8EB LD DE,$0000   ; Set the value to #N$00.
; This entry point is used by the routine at #R$A8D1.
@label=ClearScreen_Fill
*$A8EE PUSH DE       ; Write two bytes.
 $A8EF DJNZ $A8EE    ; Jump back until a block of pushes has been done.
 $A8F1 DEC C         ; Decrease the number of blocks by one.
 $A8F2 JR NZ,$A8EE   ; Jump back until all of the blocks have been done.
 $A8F4 LD SP,($5CD8) ; Restore the stack pointer.
 $A8F8 RET           ; Return.

; Delay
;
; Used by the routines at #R$A8B6 and #R$DE9D.
; .
; Waits for a time which depends on the value in #REGd.
;
; D The length of the delay
@label=Delay
c$A8F9 LD E,$FF      ; Set the inner counter to #N$FF.
@label=Delay_Inner
*$A8FB DEC E         ; Decrease the inner counter by one.
 $A8FC JR NZ,$A8FB   ; Jump back until none remain.
 $A8FE DEC D         ; Decrease the outer counter by one.
 $A8FF JR NZ,$A8F9   ; Jump back until none remain.
 $A901 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #CYBERUN$A802 }
; LIST#

; Scroll Area Left
;
; Used by the routines at #R$60FE and #R$A544.
; .
; Scrolls a rectangular area of the screen one pixel to the left, and
; increases the scroll counter at #R$A921.
;
; B The width of the area in bytes
; C The height of the area in pixel lines
; HL The pixel position of the right end of the bottom line of the area
@label=ScrollAreaLeft
c$A902 CALL $A9FE    ; Convert the pixel position into a screen address.
 $A905 LD A,B        ; Fetch the width.
 $A906 LD ($A90C),A  ; Store it in the operand of the instruction at #N$A90B.
@label=ScrollAreaLeft_Line
*$A909 PUSH HL       ; Save the address of the right end of the line.
 $A90A XOR A         ; Clear the carry flag.
 $A90B LD B,$00      ; Set the number of bytes in the line (this is patched at
                     ; #N$A90C).
@label=ScrollAreaLeft_Byte
*$A90D RL (HL)       ; Rotate the byte left through the carry flag.
 $A90F DEC L         ; Move onto the next byte to the left.
 $A910 DJNZ $A90D    ; Jump back until the line has been done.
 $A912 POP HL        ; Restore the address of the right end of the line.
 $A913 CALL $AA4B    ; Move up a pixel line.
 $A916 DEC C         ; Decrease the number of lines by one.
 $A917 JR NZ,$A909   ; Jump back until all of the lines have been done.
 $A919 LD A,($A921)  ; Fetch the scroll counter.
 $A91C INC A         ; Add one.
 $A91D LD ($A921),A  ; Store it.
 $A920 RET           ; Return.

; Scroll Counters
;
; The counters used when a message is scrolled by #R$A544.
@label=ScrollCounter
g$A921 DEFB $00      ; The number of pixels that the message has scrolled.
 $A922 DEFB $00      ; The index of the last character of the message to be
                     ; printed.

; Print Text
;
; Used by the routines at #R$60FE, #R$9690, #R$A3FE, #R$A544, #R$A898, #R$CD11,
; #R$D5DF, #R$DE9D, #R$DFF0 and #R$E1BD.
; .
; Prints a text record. A text record has four bytes followed by the
; characters: the x position in pixels, the y position in pixels of the bottom
; line of the text, the attribute and the number of characters in bits 0-5. Bit
; 7 of the number of characters selects double height, and bits 6 and 7 together
; select double height and double width.
; .
; #PUSHS #UDGTABLE { #BLANKSCREEN(0)
; #SIM(start=$A923,stop=$0000,de=$E125,sp=$5B60)
; #SCR$02,$00,$00,$08,$04(print-text) } UDGTABLE# #POPS
;
;   DE The address of the text record
; O:DE The address after the text record
@label=PrintText
c$A923 EX DE,HL      ; Exchange #REGde and #REGhl, so that #REGhl is the address of the
                     ; record.
 $A924 LD E,(HL)     ; Fetch the x position.
 $A925 INC HL        ; Move onto the y position.
 $A926 LD D,(HL)     ; Fetch it.
 $A927 INC HL        ; Move onto the attribute.
 $A928 LD A,(HL)     ; Fetch it.
 $A929 LD ($AAE4),A  ; Store it in the attribute of the rectangle at
                     ; #R$AAE2(#N$AAE4).
 $A92C INC HL        ; Move onto the number of characters and the flags.
 $A92D LD B,(HL)     ; Fetch them.
 $A92E INC HL        ; Move onto the first character.
 $A92F XOR A         ; #REGa is #N$00.
 $A930 LD ($A992),A  ; Store it in the operand of the jump at #N$A992, to select the normal
                     ; size.
 $A933 INC A         ; #REGa is #N$01.
 $A934 LD ($AAE3),A  ; Store it as the height of the rectangle at
                     ; #R$AAE2(#N$AAE3).
 $A937 LD A,B        ; Fetch the number of characters.
 $A938 AND %00111111 ; Keep the number of characters.
 $A93A LD ($AAE2),A  ; Store it as the width of the rectangle at #R$AAE2.
 $A93D BIT 7,B       ; {Jump to #R$A962 if bit 7, the flag for double height,
 $A93F JR Z,$A962    ; is reset.}
 $A941 BIT 6,B       ; {Jump to #R$A951 if bit 6, the flag for double width, is
 $A943 JR NZ,$A951   ; set.}
 $A945 LD A,$0C      ; Set the distance to jump to #N$0C...
 $A947 LD ($A992),A  ; ...to select double height.
 $A94A LD A,$02      ; Set the height of the rectangle to #N$02.
 $A94C LD ($AAE3),A  ; Store it.
 $A94F JR $A962      ; Jump to #R$A962.
@label=PrintText_Double
*$A951 LD A,$1E      ; Set the distance to jump to #N$1E...
 $A953 LD ($A992),A  ; ...to select double height and width.
 $A956 LD A,$02      ; Set the height of the rectangle to #N$02.
 $A958 LD ($AAE3),A  ; Store it.
 $A95B LD A,($AAE2)  ; Fetch the width of the rectangle.
 $A95E ADD A,A       ; Double it.
 $A95F LD ($AAE2),A  ; Store it.
@label=PrintText_Attributes
*$A962 EX DE,HL      ; Exchange #REGde and #REGhl, so that #REGde is the address of the
                     ; first character and #REGhl is the position.
 $A963 PUSH BC       ; Save the number of characters.
 $A964 PUSH DE       ; Save the address of the first character.
 $A965 CALL $AAE5    ; Call #R$AAE5 to set the attributes.
 $A968 POP DE        ; Restore the address of the first character.
 $A969 POP BC        ; Restore the number of characters.
 $A96A CALL $A9FE    ; Convert the pixel position into a screen address.
 $A96D LD A,B        ; Fetch the number of characters.
 $A96E AND %00111111 ; Keep the number of characters.
 $A970 LD B,A        ; Store it in #REGb.
@label=PrintText_Character
*$A971 PUSH BC       ; Save the number of characters.
 $A972 CALL $A97A    ; Print a character.
 $A975 POP BC        ; Restore the number of characters.
 $A976 INC DE        ; Move onto the next character.
 $A977 DJNZ $A971    ; Jump back until all of the characters have been printed.
 $A979 RET           ; Return.

; Print Character
;
; Used by the routine at #R$A923.
; .
; Prints a character of a text record. The shapes of the characters are in
; the font at #R$64E0, and each is seven bytes with the bottom line first.
;
;   DE The address of the character
;   HL The screen address of the bottom line of the character
; O:HL The screen address of the bottom line of the next character
@label=PrintCharacter
c$A97A PUSH DE       ; Save the address of the character.
 $A97B LD A,(DE)     ; Fetch the character.
 $A97C EX DE,HL      ; Exchange #REGde and #REGhl.
 $A97D PUSH DE       ; Save the screen address.
 $A97E LD L,A        ; Copy the character into #REGl.
 $A97F LD H,$00      ; Clear #REGh.
 $A981 LD D,H        ; Clear #REGd.
 $A982 ADD HL,HL     ; Multiply the character by two...
 $A983 ADD HL,HL     ; ...four...
 $A984 ADD HL,HL     ; ...and eight.
 $A985 LD E,A        ; Copy the character into #REGe.
 $A986 SBC HL,DE     ; Subtract it, to make seven times the character.
 $A988 LD DE,$64E0   ; Point #REGde at #R$64E0.
 $A98B ADD HL,DE     ; Add the offset to find the shape of the character.
 $A98C POP DE        ; Restore the screen address into #REGde.
 $A98D EX DE,HL      ; Exchange #REGde and #REGhl, so that #REGde is the shape and #REGhl
                     ; is the screen address.
 $A98E PUSH HL       ; Save the screen address.
 $A98F LD B,$07      ; Set the number of lines to #N$07.
@label=PrintCharacter_Patched
*$A991 JR $A991      ; Jump to the routine for the size of text (this is patched at
                     ; #N$A992).
@label=PrintCharacter_Normal
*$A993 LD A,(DE)     ; Fetch a line of the shape.
 $A994 LD (HL),A     ; Write it to the screen.
 $A995 INC DE        ; Move onto the next line of the shape.
 $A996 CALL $AA4B    ; Move up a pixel line on the screen.
 $A999 DJNZ $A993    ; Jump back until all of the lines have been written.
 $A99B POP HL        ; Restore the screen address.
 $A99C INC L         ; Move onto the next character cell.
 $A99D POP DE        ; Restore the address of the character.
 $A99E RET           ; Return.
@label=PrintCharacter_DoubleHeight
*$A99F LD A,(DE)     ; Fetch a line of the shape.
 $A9A0 LD (HL),A     ; Write it to the screen.
 $A9A1 PUSH AF       ; Save it.
 $A9A2 CALL $AA4B    ; Move up a pixel line on the screen.
 $A9A5 POP AF        ; Restore it.
 $A9A6 LD (HL),A     ; Write it to the screen again.
 $A9A7 CALL $AA4B    ; Move up a pixel line on the screen.
 $A9AA INC DE        ; Move onto the next line of the shape.
 $A9AB DJNZ $A99F    ; Jump back until all of the lines have been written.
 $A9AD POP HL        ; Restore the screen address.
 $A9AE INC L         ; Move onto the next character cell.
 $A9AF POP DE        ; Restore the address of the character.
 $A9B0 RET           ; Return.
@label=PrintCharacter_DoubleBoth
 $A9B1 LD A,B        ; Fetch the number of lines.
@label=PrintCharacter_DoubleBothLine
*$A9B2 EX AF,AF'     ; Save the number of lines in the alternate #REGa.
 $A9B3 LD BC,$A9EE   ; Point #REGbc at #R$A9EE.
 $A9B6 LD A,(DE)     ; Fetch a line of the shape.
 $A9B7 RRA           ; Move the upper four bits...
 $A9B8 RRA           ; ...down...
 $A9B9 RRA           ; ...to the lower...
 $A9BA RRA           ; ...four bits.
 $A9BB AND %00001111 ; Keep the upper nibble.
 $A9BD ADD A,C       ; Add it to the address of the table.
 $A9BE LD C,A        ; Store the low byte.
 $A9BF LD A,B        ; Fetch the high byte.
 $A9C0 ADC A,$00     ; Add the carry.
 $A9C2 LD B,A        ; Store the high byte.
 $A9C3 LD A,(BC)     ; Fetch the doubled bits.
 $A9C4 LD (HL),A     ; Write them to the left cell.
 $A9C5 LD C,A        ; Keep them in #REGc.
 $A9C6 PUSH HL       ; Save the screen address.
 $A9C7 CALL $AA4B    ; Move up a pixel line on the screen.
 $A9CA LD (HL),C     ; Write the doubled bits again.
 $A9CB POP HL        ; Restore the screen address.
 $A9CC INC L         ; Move onto the right cell.
 $A9CD LD BC,$A9EE   ; Point #REGbc at #R$A9EE.
 $A9D0 LD A,(DE)     ; Fetch the line of the shape.
 $A9D1 AND %00001111 ; Keep the lower nibble.
 $A9D3 ADD A,C       ; Add it to the address of the table.
 $A9D4 LD C,A        ; Store the low byte.
 $A9D5 LD A,B        ; Fetch the high byte.
 $A9D6 ADC A,$00     ; Add the carry.
 $A9D8 LD B,A        ; Store the high byte.
 $A9D9 LD A,(BC)     ; Fetch the doubled bits.
 $A9DA LD (HL),A     ; Write them to the right cell.
 $A9DB LD C,A        ; Keep them in #REGc.
 $A9DC CALL $AA4B    ; Move up a pixel line on the screen.
 $A9DF LD (HL),C     ; Write the doubled bits again.
 $A9E0 DEC L         ; Move back to the left cell.
 $A9E1 CALL $AA4B    ; Move up a pixel line on the screen.
 $A9E4 INC DE        ; Move onto the next line of the shape.
 $A9E5 EX AF,AF'     ; Fetch the number of lines.
 $A9E6 DEC A         ; Decrease it by one.
 $A9E7 JR NZ,$A9B2   ; Jump back until all of the lines have been written.
 $A9E9 POP HL        ; Restore the screen address.
 $A9EA INC L         ; Move onto the next cell...
 $A9EB INC L         ; ...which is two cells further on.
 $A9EC POP DE        ; Restore the address of the character.
 $A9ED RET           ; Return.
; View the equivalent code in;
; #LIST
; { #CYBERUN$A0B1 }
; LIST#

; Doubled Nibbles
;
; The value to use for each four bits of a line of a character when it is
; printed at double width: each bit is repeated twice.
@label=DoubledNibbles
b$A9EE DEFB $00,$03,$0C,$0F,$30,$33,$3C,$3F
 $A9F6 DEFB $C0,$C3,$CC,$CF,$F0,$F3,$FC,$FF

; Get Screen Address
;
; Used by the routines at #R$A902, #R$A923, #R$AAC4, #R$E3AC and #R$E3BD.
; .
; Finds the address in the display file of a position in pixels.
;
;   H The y position in pixels from the top of the screen
;   L The x position in pixels from the left of the screen
; O:HL The screen address
@label=GetScreenAddress
c$A9FE LD A,L        ; Fetch the x position.
 $A9FF RRC A         ; Divide it by two...
 $AA01 RRC A         ; ...four...
 $AA03 RRC A         ; ...and eight to find the column.
 $AA05 AND %00011111 ; Keep the column.
 $AA07 LD L,A        ; Store it in #REGl.
 $AA08 LD A,H        ; Fetch the y position.
 $AA09 RLC A         ; Move bits 3-5, the character row within the section,
                     ; up...
 $AA0B RLC A         ; ...to bits 5-7.
 $AA0D AND %11100000 ; Keep them.
 $AA0F OR L          ; Add the column.
 $AA10 LD L,A        ; Store it in #REGl.
 $AA11 LD A,H        ; Fetch the y position.
 $AA12 AND %00000111 ; Use bits 0-2, the pixel line within the character row.
 $AA14 EX AF,AF'     ; Save it in the alternate #REGa.
 $AA15 LD A,H        ; Fetch the y position.
 $AA16 RRC A         ; Move bits 6-7, the section of the screen, down...
 $AA18 RRC A         ; ...to...
 $AA1A RRC A         ; ...bits 3-4.
 $AA1C AND %00011000 ; Keep them.
 $AA1E OR %01000000  ; Add the address of the display file.
 $AA20 LD H,A        ; Store it in #REGh.
 $AA21 EX AF,AF'     ; Retrieve the pixel line.
 $AA22 OR H          ; Add it.
 $AA23 LD H,A        ; Store it in #REGh.
 $AA24 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #CYBERUN$A149 }
; LIST#

; Get Attribute Address
;
; Used by the routine at #R$AAE5.
; .
; Finds the address in the attribute file of a position in pixels.
;
;   H The y position in pixels from the top of the screen
;   L The x position in pixels from the left of the screen
; O:HL The attribute address
@label=GetAttributeAddress
c$AA25 SRL H         ; Divide the y position by two...
 $AA27 SRL H         ; ...four...
 $AA29 SRL H         ; ...and eight, to make the character row.
 $AA2B SRL H         ; Halve the row, moving its lowest bit into the carry
                     ; flag.
 $AA2D RR L          ; Move that bit into the top of #REGl, halving the x
                     ; position.
 $AA2F SRL H         ; Halve the row again, moving its next bit into the carry
                     ; flag.
 $AA31 RR L          ; Move that bit into #REGl.
 $AA33 SRL H         ; Halve the row again, moving its top bit into the carry
                     ; flag.
 $AA35 RR L          ; Move that bit into #REGl, which is now the offset within the
                     ; section.
 $AA37 LD A,H        ; Fetch the section of the screen.
 $AA38 ADD A,$58     ; Add the address of the attribute file.
 $AA3A LD H,A        ; Store it in #REGh.
 $AA3B RET           ; Return.

; Add To Address
;
; Used by the routines at #R$60FE, #R$623F, #R$876B, #R$995F, #R$9A0A, #R$A1CC,
; #R$A544, #R$A581, #R$A6EB, #R$B3CB, #R$B43C, #R$D202, #R$D47A, #R$D8E4 and
; #R$E4CC.
; .
; Adds a value to an address.
;
;   A The value
;   HL The address
; O:HL The address plus the value
@label=AddToAddress
c$AA3C ADD A,L       ; Add the value to the low byte of the address.
 $AA3D LD L,A        ; Store it.
 $AA3E RET NC        ; Return if there was no carry.
 $AA3F INC H         ; Increase the high byte of the address.
 $AA40 RET           ; Return.

; Jump Via Table
;
; Jumps to the routine in a table of addresses.
;
; A The number of the entry in the table
; HL The address of the table
@label=JumpViaTable
c$AA41 LD E,A        ; Copy the number of the entry into #REGe.
; This entry point is used by the routines at #R$C8E8 and #R$C93D.
@label=JumpViaTable_Index
*$AA42 LD D,$00      ; Clear #REGd.
 $AA44 ADD HL,DE     ; Add the number of the entry to the address of the
                     ; table...
 $AA45 ADD HL,DE     ; ...twice, to find the entry.
 $AA46 LD A,(HL)     ; Fetch the low byte of the address of the routine.
 $AA47 INC HL        ; Move onto the high byte.
 $AA48 LD H,(HL)     ; Fetch it.
 $AA49 LD L,A        ; Set the low byte of the address.
 $AA4A JP (HL)       ; Jump to the routine.

; Move Up A Line
;
; Used by the routines at #R$A902, #R$A97A, #R$AAC4 and #R$E3AC.
; .
; Moves a screen address up by one pixel line.
;
;   HL The screen address
; O:HL The screen address of the pixel line above
@label=MoveUpALine
c$AA4B LD A,H        ; Fetch the high byte of the address.
 $AA4C DEC H         ; Move up a pixel line.
 $AA4D AND %00000111 ; Keep the number of the pixel line which it was in.
 $AA4F RET NZ        ; Return unless that was the top pixel line of a character
                     ; row.
 $AA50 LD A,L        ; Fetch the low byte of the address.
 $AA51 SUB $20       ; Move up a character row.
 $AA53 LD L,A        ; Store it.
 $AA54 RET C         ; Return if the row was at the top of a section of the
                     ; screen.
 $AA55 LD A,H        ; Fetch the high byte of the address.
 $AA56 ADD A,$08     ; Move to the bottom pixel line of the character row.
 $AA58 LD H,A        ; Store it.
 $AA59 RET           ; Return.

; Render Flag
;
; A byte which #R$AA5B sets to zero and which is used by the code that
; draws the view.
@label=RenderFlag
g$AA5A DEFB $00

; Build View
;
; Used by the routine at #R$DFF0.
; .
; Builds the view buffer at #R$E5BB from the position of the view in
; #R$5CE2 and #R$5CE2(#N$5CE4), one strip at a time in twelve passes.
; .
; #PUSHS #UDGTABLE { #NEWGAME(0)
; #SIM(start=$AA5B,stop=$0000,sp=$5B60)
; #SIM(start=$E4CC,stop=$0000,sp=$5B60)
; #SCR$02(build-view) } UDGTABLE# #POPS
@label=BuildView
c$AA5B LD HL,$0000   ; #REGhl is #N$0000.
 $AA5E LD ($5CF6),HL ; Store it in #R$5CF6.
 $AA61 LD HL,($5CE2) ; Fetch the first value from #R$5CE2.
 $AA64 LD DE,($5CE4) ; Fetch the second value from #R$5CE2(#N$5CE4).
 $AA68 PUSH HL       ; Save the first value.
 $AA69 ADD HL,DE     ; Add the second value.
 $AA6A LD BC,$0080   ; #REGbc is #N$0080.
 $AA6D ADD HL,BC     ; Add it.
 $AA6E LD ($5CE7),HL ; Store the result in #R$5CE7.
 $AA71 POP HL        ; Retrieve the first value.
 $AA72 SRL D         ; Halve the second value...
 $AA74 RR E          ; ...with the carry going into #REGe.
 $AA76 SRL H         ; Halve the first value...
 $AA78 RR L          ; ...with the carry going into #REGl.
 $AA7A AND A         ; {Subtract the second halved value from the first.
 $AA7B SBC HL,DE     ; }
 $AA7D LD ($5CEE),HL ; Store the result in #R$5CEE.
 $AA80 LD DE,$FFA8   ; #REGde is #N$FFA8.
 $AA83 CALL $C9A0    ; Call #R$C9A0.
 $AA86 LD HL,$E5D1   ; Point #REGhl at the first strip of the view buffer.
 $AA89 LD ($5CBB),HL ; Store it in #R$5CBB.
 $AA8C LD B,$0C      ; Set the number of passes to #N$0C.
@label=BuildView_Pass
*$AA8E PUSH BC       ; Save the number of passes.
 $AA8F LD HL,$E5D1   ; Point #REGhl at the first strip of the view buffer.
 $AA92 LD DE,$0017   ; Set the size of a row to #N$0017.
 $AA95 LD B,$80      ; Set the number of rows to #N$80.
 $AA97 XOR A         ; Set #REGa to zero.
 $AA98 LD ($5CF0),A  ; Store it in #R$5CF0.
 $AA9B LD ($AA5A),A  ; Store it in #R$AA5A.
@label=BuildView_Clear
*$AA9E LD (HL),A     ; Clear a byte of the strip.
 $AA9F INC HL        ; Move onto the next byte.
 $AAA0 LD (HL),A     ; Clear that byte.
 $AAA1 ADD HL,DE     ; Move onto the next row.
 $AAA2 DJNZ $AA9E    ; Jump back until all of the rows have been cleared.
 $AAA4 LD HL,$C0E1   ; #REGhl is #N$C0E1.
 $AAA7 CALL $BA70    ; Call #R$BA70.
 $AAAA POP BC        ; Restore the number of passes.
 $AAAB DEC B         ; Decrease it by one.
 $AAAC RET Z         ; Return if all of the passes have been done.
 $AAAD EXX           ; Switch to the alternate registers.
 $AAAE CALL $DFAB    ; Call #R$DFAB.
 $AAB1 LD DE,$E5BB   ; Point #REGde at #R$E5BB.
 $AAB4 LD HL,$E5BD   ; Point #REGhl at the second column of the view buffer.
 $AAB7 LD BC,$0BFE   ; Set the number of bytes to #N$0BFE.
 $AABA LDIR          ; Move the contents of the view buffer along by two bytes.
 $AABC LD E,$08      ; #REGe is #N$08.
 $AABE CALL $C99E    ; Call #R$C99E.
 $AAC1 EXX           ; Switch back to the normal registers.
 $AAC2 JR $AA8E      ; Jump back for the next pass.

; Draw Picture
;
; Used by the routines at #R$60FE, #R$A3FE, #R$D202, #R$DFF0, #R$E229, #R$E376
; and #R$E3D7.
; .
; Draws a picture on the screen. A picture starts with its width in bytes
; and its height in pixel lines, and is followed by the bytes of each line with
; the bottom line first.
; .
; #PUSHS #UDGTABLE { #BLANKSCREEN(0)
; #SIM(start=$AAC4,stop=$0000,de=$6066,hl=$1960,sp=$5B60)
; #SCR$02,$00,$00,$20,$08(draw-picture) } UDGTABLE# #POPS
;
; DE The address of the picture
; HL The pixel position of the bottom left (H is y, L is x)
@label=DrawPicture
c$AAC4 PUSH HL       ; Save the position.
 $AAC5 CALL $A9FE    ; Convert the position into a screen address.
 $AAC8 LD A,(DE)     ; Fetch the width of the picture.
 $AAC9 LD ($AAD2),A  ; Store it in the operand of the instruction at #N$AAD1.
 $AACC INC DE        ; Move onto the height.
 $AACD LD A,(DE)     ; Fetch it.
 $AACE INC DE        ; Move onto the first byte of the picture.
 $AACF LD C,A        ; Keep the height in #REGc.
@label=DrawPicture_Line
*$AAD0 PUSH HL       ; Save the screen address of the start of the line.
 $AAD1 LD B,$00      ; Set the width in bytes (this is patched at #N$AAD2).
@label=DrawPicture_Byte
*$AAD3 LD A,(DE)     ; Fetch a byte of the picture.
 $AAD4 LD (HL),A     ; Write it to the screen.
 $AAD5 INC DE        ; Move onto the next byte of the picture.
 $AAD6 INC L         ; Move onto the next byte of the screen.
 $AAD7 DJNZ $AAD3    ; Jump back until the line has been drawn.
 $AAD9 POP HL        ; Restore the screen address of the start of the line.
 $AADA CALL $AA4B    ; Move up a pixel line.
 $AADD DEC C         ; Decrease the height by one.
 $AADE JR NZ,$AAD0   ; Jump back until all of the lines have been drawn.
 $AAE0 POP HL        ; Restore the position.
 $AAE1 RET           ; Return.

; Attribute Rectangle
;
; A rectangle of attributes for #R$AAE5, which has three bytes.
@label=AttributeRectangle
g$AAE2 DEFB $00      ; The width in character cells.
 $AAE3 DEFB $00      ; The height in character cells.
 $AAE4 DEFB $00      ; The attribute.

; Fill Scratch Rectangle
;
; Used by the routines at #R$A923 and #R$E2E9.
; .
; Fills a rectangle of the attribute file using the rectangle at #R$AAE2.
;
; HL The pixel position of the bottom left of the rectangle
@label=FillScratchRectangle
c$AAE5 LD DE,$AAE2   ; Point #REGde at the rectangle.
; This entry point is used by the routines at #R$5E65, #R$A30D, #R$DF1F,
; #R$DFF0, #R$E229 and #R$E3D7.
; .
; This entry point takes the address of the rectangle in #REGde.
@label=FillRectangle
*$AAE8 PUSH HL       ; Save the position.
 $AAE9 CALL $AA25    ; Convert the position into an attribute address.
 $AAEC LD A,(DE)     ; Fetch the width of the rectangle.
 $AAED LD ($AAFF),A  ; Store it in the operand of the instruction at #N$AAFE.
 $AAF0 ADD A,$1E     ; Add #N$1E to it.
 $AAF2 CPL           ; Invert it, to make minus the width less #N$1F.
 $AAF3 LD ($AB07),A  ; Store it in the operand of the instruction at #N$AB06.
 $AAF6 INC DE        ; Move onto the height.
 $AAF7 LD A,(DE)     ; Fetch it.
 $AAF8 LD C,A        ; Keep the height in #REGc.
 $AAF9 INC DE        ; Move onto the attribute.
 $AAFA LD A,(DE)     ; Fetch it.
 $AAFB LD ($AB01),A  ; Store it in the operand of the instruction at #N$AB00.
@label=FillRectangle_Row
*$AAFE LD B,$00      ; Set the width of the row (this is patched at #N$AAFF).
@label=FillRectangle_Cell
*$AB00 LD (HL),$00   ; Set the attribute of a cell (this is patched at
                     ; #N$AB01).
 $AB02 INC L         ; Move onto the next cell.
 $AB03 DJNZ $AB00    ; Jump back until the row has been filled.
 $AB05 DEC L         ; Move back to the last cell of the row.
 $AB06 LD DE,$FF00   ; Set the offset to the start of the row above (this is patched at
                     ; #N$AB07).
 $AB09 ADD HL,DE     ; Add it to the address.
 $AB0A DEC C         ; Decrease the height by one.
 $AB0B JR NZ,$AAFE   ; Jump back until all of the rows have been filled.
 $AB0D POP HL        ; Restore the position.
 $AB0E RET           ; Return.

; Control Player
;
; Used by the routine at #R$CD11.
; .
; Reads the controls and makes the player entity turn, jump and move
; forward. The controls are a byte with one bit for each direction, as read by
; #R$AB8F: bit 0 and bit 1 turn the player, bit 2 makes the player jump if it is
; on the ground, and bit 3 makes the player move forward. While the player is
; held (fields #N$24 and #N$25 are not both zero) bits 2-4 are ignored. The rate
; of turning builds up while a turn control is held, and is kept in #R$5CF6.
;
; IX The player entity
@label=ControlPlayer
c$AB0F CALL $AB8F      ; Read the controls.
 $AB12 LD A,(IX+$24)   ; Read field #N$24 of the entity.
 $AB15 OR (IX+$25)     ; Combine it with field #N$25.
 $AB18 JR Z,$AB20      ; Jump to #R$AB20 if both are zero.
 $AB1A RES 2,C         ; Ignore bit 2 of the controls.
 $AB1C RES 3,C         ; Ignore bit 3 of the controls.
 $AB1E RES 4,C         ; Ignore bit 4 of the controls.
@label=ControlPlayer_Store
*$AB20 LD A,C          ; Fetch the controls.
 $AB21 LD ($5CDE),A    ; Store them in #R$5CDE.
 $AB24 LD HL,($5CF6)   ; Fetch the rate of turning from #R$5CF6.
 $AB27 LD DE,$0080     ; Set the amount by which the rate builds up.
 $AB2A RR C            ; Move bit 0 into the carry flag.
 $AB2C JR NC,$AB36     ; Jump to #R$AB36 if it is reset.
 $AB2E RR C            ; Move bit 1 into the carry flag.
 $AB30 JR C,$AB59      ; Jump to #R$AB59 if both are set.
 $AB32 LD B,$FF        ; Set the direction of the turn to #N$FF.
 $AB34 JR $AB3C        ; Jump to #R$AB3C.
@label=ControlPlayer_TestLeft
*$AB36 RR C            ; Move bit 1 into the carry flag.
 $AB38 JR NC,$AB59     ; Jump to #R$AB59 if neither bit is set.
 $AB3A LD B,$00        ; Set the direction of the turn to #N$00.
@label=ControlPlayer_Turn
*$AB3C ADD HL,DE       ; Increase the rate of turning.
 $AB3D LD A,H          ; Fetch the whole part of the rate.
 $AB3E CP $03          ; {Jump to #R$AB43 if it is less.
 $AB40 JR C,$AB43      ; }
 $AB42 DEC H           ; Limit the rate to below #N$03.
@label=ControlPlayer_StoreRate
*$AB43 LD ($5CF6),HL   ; Store the rate of turning.
 $AB46 LD A,H          ; Fetch the whole part of the rate.
 $AB47 BIT 7,B         ; {Jump to #R$AB4D if the turn is in the positive
 $AB49 JR Z,$AB4D      ; direction.}
 $AB4B NEG             ; Make the turn negative.
@label=ControlPlayer_Heading
*$AB4D LD B,A          ; Keep the turn in #REGb.
 $AB4E LD A,(IX+$11)   ; Fetch the heading of the player.
 $AB51 ADD A,B         ; Add the turn.
 $AB52 AND %00111111   ; Use bits 0-5.
 $AB54 LD (IX+$11),A   ; Store the new heading.
 $AB57 JR $AB6A        ; Jump to #R$AB6A.
@label=ControlPlayer_NoTurn
*$AB59 RES 7,(IX+$11)  ; Reset bit 7 of the heading of the player, so that it is not moving
                       ; forward.
 $AB5D LD E,$40        ; Set the amount by which the rate of turning falls.
 $AB5F AND A           ; Clear the carry flag.
 $AB60 SBC HL,DE       ; Reduce the rate of turning.
 $AB62 JR NC,$AB67     ; Jump to #R$AB67 if it is still positive.
 $AB64 LD HL,$0000     ; Set the rate of turning to zero.
@label=ControlPlayer_StoreRate2
*$AB67 LD ($5CF6),HL   ; Store the rate of turning.
@label=ControlPlayer_Jump
*$AB6A RR C            ; Move bit 2 into the carry flag.
 $AB6C JR NC,$AB87     ; Jump to #R$AB87 if it is reset.
 $AB6E BIT 7,(IX+$1E)  ; {Jump to #R$AB87 if bit 7 of field #N$1E of the player
 $AB72 JR Z,$AB87      ; is reset.}
 $AB74 LD A,($5D00)    ; Fetch the jump flag from #R$5D00.
 $AB77 AND A           ; Test it.
 $AB78 JR NZ,$AB87     ; Jump to #R$AB87 if the player is already jumping.
 $AB7A LD (IX+$12),$04 ; Set the vertical speed of the player (field #N$12) to
                       ; #N$04...
 $AB7E LD (IX+$13),$00 ; ...and field #N$13 to #N$00.
 $AB82 LD A,$01        ; Set the jump flag to #N$01...
 $AB84 LD ($5D00),A    ; ...and store it.
@label=ControlPlayer_Forward
*$AB87 RR C            ; Move bit 3 into the carry flag.
 $AB89 RET NC          ; Return if it is reset.
 $AB8A SET 7,(IX+$11)  ; Set bit 7 of the heading of the player, so that it
                       ; moves forward.
 $AB8E RET             ; Return.

; Read Controls
;
; Used by the routine at #R$AB0F.
; .
; Reads the controls of the current player, using the control method which
; is selected in #R$60FB (#N$00 for the keyboard, #N$01 for a Kempston joystick,
; #N$02 for a Cursor joystick, otherwise an Interface II joystick). The result
; has one bit for each control: bit 0 is right, bit 1 is left, bit 2 is down,
; bit 3 is up and bit 4 is fire.
;
; O:C The controls which are being used
@label=ReadControls
c$AB8F LD A,($60FB)  ; Fetch the control method of the current player.
 $AB92 AND A         ; Test it.
 $AB93 JP Z,$ABE2    ; Jump to #R$ABE2 if it is the keyboard.
 $AB96 DEC A         ; Decrease it by one.
 $AB97 JR Z,$ABB6    ; Jump to #R$ABB6 if it is a Kempston joystick.
 $AB99 DEC A         ; Decrease it by one.
 $AB9A JR Z,$ABBC    ; Jump to #R$ABBC if it is a Cursor joystick.
 $AB9C LD A,$EF      ; {Read from the keyboard;
 $AB9E IN A,($FE)    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$EF | 0 | 9 | 8 | 7 | 6 }
                     ; TABLE#}
 $ABA0 LD B,$FF      ; Start with all of the bits set.
 $ABA2 RRA           ; Move the bit for "0" into the carry flag.
 $ABA3 RL B          ; Move it into #REGb.
 $ABA5 RRA           ; Move the bit for "9" into the carry flag.
 $ABA6 RL B          ; Move it into #REGb.
 $ABA8 RRA           ; Move the bit for "8" into the carry flag.
 $ABA9 RL B          ; Move it into #REGb.
 $ABAB RRA           ; Move the bit for "7" into the carry flag...
 $ABAC RRA           ; ...and then the bit for "6".
 $ABAD RL B          ; Move it into #REGb.
 $ABAF RLA           ; Rotate the bit for "7" back into the carry flag...
 $ABB0 RL B          ; ...and move it into #REGb.
 $ABB2 LD A,B        ; Fetch the result.
 $ABB3 CPL           ; Invert the bits, so that a set bit is a control being
                     ; used.
 $ABB4 LD C,A        ; Store it in #REGc.
 $ABB5 RET           ; Return.
@label=ReadControls_Kempston
*$ABB6 IN A,($1F)    ; Read the Kempston joystick.
 $ABB8 AND %00011111 ; Keep the five bits.
 $ABBA LD C,A        ; Store them in #REGc.
 $ABBB RET           ; Return.
@label=ReadControls_Cursor
*$ABBC LD A,$EF      ; {Read from the keyboard;
 $ABBE IN A,($FE)    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$EF | 0 | 9 | 8 | 7 | 6 }
                     ; TABLE#}
 $ABC0 OR %11100000  ; Set the unused bits.
 $ABC2 LD B,A        ; Keep the bits in #REGb.
 $ABC3 AND %00001000 ; Keep the bit for "7", up.
 $ABC5 LD C,A        ; Store it in #REGc.
 $ABC6 LD A,B        ; Fetch the bits.
 $ABC7 RRCA          ; Rotate bit 2, for "8" (right), into bit 0...
 $ABC8 RRCA          ; ...and bit 4, for "6" (down), into bit 2.
 $ABC9 LD B,A        ; Keep the bits in #REGb.
 $ABCA AND %00000101 ; Keep the bits for right and down.
 $ABCC OR C          ; Add the bit for up.
 $ABCD LD C,A        ; Store them in #REGc.
 $ABCE LD A,B        ; Fetch the bits.
 $ABCF RRA           ; Rotate the bit for "0" (fire)...
 $ABD0 RRA           ; ...into bit 4.
 $ABD1 AND %00010000 ; Keep the bit for fire.
 $ABD3 OR C          ; Add the other bits.
 $ABD4 LD C,A        ; Store them in #REGc.
 $ABD5 LD A,$F7      ; {Read from the keyboard;
 $ABD7 IN A,($FE)    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$F7 | 1 | 2 | 3 | 4 | 5 }
                     ; TABLE#}
 $ABD9 RRA           ; Rotate the bit for "5" (left)...
 $ABDA RRA           ; ...into...
 $ABDB RRA           ; ...bit 1.
 $ABDC AND %00000010 ; Keep the bit for left.
 $ABDE OR C          ; Add the other bits.
 $ABDF CPL           ; Invert the bits, so that a set bit is a control being
                     ; used.
 $ABE0 LD C,A        ; Store them in #REGc.
 $ABE1 RET           ; Return.
@label=ReadControls_Keyboard
*$ABE2 LD C,$00      ; Clear the controls.
 $ABE4 LD A,$FE      ; {Read from the keyboard;
 $ABE6 CALL $A8CB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$FE | CAPS SHIFT | Z | X | C | V }
                     ; TABLE#}
 $ABE9 AND %00010100 ; Keep the bits for "X" and "V".
 $ABEB JR NZ,$ABF6   ; Jump to #R$ABF6 if either of them is being pressed.
 $ABED LD A,$7F      ; {Read from the keyboard;
 $ABEF CALL $A8CB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$7F | SPACE | SYMBOL SHIFT | M | N | B }
                     ; TABLE#}
 $ABF2 AND %00001010 ; Keep the bits for "SYMBOL SHIFT" and "N".
 $ABF4 JR Z,$ABF8    ; Jump to #R$ABF8 if neither of them is being pressed.
@label=ReadControls_Right
*$ABF6 SET 0,C       ; Set bit 0, right.
@label=ReadControls_TestLeft
*$ABF8 LD A,$FE      ; {Read from the keyboard;
 $ABFA CALL $A8CB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$FE | CAPS SHIFT | Z | X | C | V }
                     ; TABLE#}
 $ABFD AND %00001010 ; Keep the bits for "Z" and "C".
 $ABFF JR NZ,$AC0A   ; Jump to #R$AC0A if either of them is being pressed.
 $AC01 LD A,$7F      ; {Read from the keyboard;
 $AC03 CALL $A8CB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$7F | SPACE | SYMBOL SHIFT | M | N | B }
                     ; TABLE#}
 $AC06 AND %00010100 ; Keep the bits for "M" and "B".
 $AC08 JR Z,$AC0C    ; Jump to #R$AC0C if neither of them is being pressed.
@label=ReadControls_Left
*$AC0A SET 1,C       ; Set bit 1, left.
@label=ReadControls_TestUp
*$AC0C LD A,$FD      ; {Read from the keyboard;
 $AC0E CALL $A8CB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$FD | A | S | D | F | G }
                     ; TABLE#}
 $AC11 JR NZ,$AC1A   ; Jump to #R$AC1A if any of the keys is being pressed.
 $AC13 LD A,$BF      ; {Read from the keyboard;
 $AC15 CALL $A8CB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$BF | ENTER | L | K | J | H }
                     ; TABLE#}
 $AC18 JR Z,$AC1C    ; Jump to #R$AC1C if none of the keys is being pressed.
@label=ReadControls_Up
*$AC1A SET 3,C       ; Set bit 3, up.
@label=ReadControls_TestDown
*$AC1C LD A,$FB      ; {Read from the keyboard;
 $AC1E CALL $A8CB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$FB | Q | W | E | R | T }
                     ; TABLE#}
 $AC21 LD E,A        ; Keep the bits in #REGe.
 $AC22 LD A,$DF      ; {Read from the keyboard;
 $AC24 CALL $A8CB    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$DF | P | O | I | U | Y }
                     ; TABLE#}
 $AC27 LD D,A        ; Keep the bits in #REGd.
 $AC28 LD A,E        ; Fetch the bits for "Q", "W", "E", "R" and "T".
 $AC29 AND %00010101 ; Keep the bits for "Q", "E" and "T".
 $AC2B LD L,A        ; Store them in #REGl.
 $AC2C LD A,D        ; Fetch the bits for "P", "O", "I", "U" and "Y".
 $AC2D AND %00001010 ; Keep the bits for "O" and "U".
 $AC2F OR L          ; Combine them with the bits for "Q", "E" and "T".
 $AC30 JR Z,$AC34    ; Jump to #R$AC34 if none of them is being pressed.
 $AC32 SET 2,C       ; Set bit 2, down.
@label=ReadControls_TestFire
*$AC34 LD A,E        ; Fetch the bits for "Q", "W", "E", "R" and "T".
 $AC35 AND %00001010 ; Keep the bits for "W" and "R".
 $AC37 LD L,A        ; Store them in #REGl.
 $AC38 LD A,D        ; Fetch the bits for "P", "O", "I", "U" and "Y".
 $AC39 AND %00010101 ; Keep the bits for "P", "I" and "Y".
 $AC3B OR L          ; Combine them with the bits for "W" and "R".
 $AC3C RET Z         ; Return if none of them is being pressed.
 $AC3D SET 4,C       ; Set bit 4, fire.
 $AC3F RET           ; Return.

; Build Draw List
;
; Used by the routines at #R$CD11 and #R$DFF0.
; .
; Builds the list of items to be drawn for the current frame, at #R$AFFB.
; Each item is three bytes: a flag byte followed by the address of the record to
; draw. The flag is #N$01 for an entity (see #R$B540), #N$02 for one of the
; #N$0C extra records at #R$B708 and #N$03 for one of the #N$14-byte records at
; #R$BBF7. The list ends with a zero byte, and #R$B06C holds the address of
; the next free item.
; .
; Every entity that is in use and not hidden is prepared with #R$AD07. The
; matching extra record is then prepared as well, if it has been flagged as
; visible.
;
; .
;
; Start with an empty list and with no table records, and go through the
; #N$0C entities and their extra records.
@label=BuildDrawList
c$AC40 LD HL,$AFFB     ; {Make the next free item of the draw list the start of
 $AC43 LD ($B06C),HL   ; the list.}
 $AC46 XOR A           ; {Clear the count of table records that have been
 $AC47 LD ($F500),A    ; prepared.}
 $AC4A LD IX,$B540     ; Point #REGix at #R$B540.
 $AC4E LD IY,$B708     ; Point #REGiy at #R$B708.
 $AC52 LD HL,$F501     ; Point #REGhl at the start of the table of records.
 $AC55 LD B,$0C        ; Set a counter in #REGb for the #N$0C entities.
@label=BuildDrawList_Loop
*$AC57 PUSH BC         ; Stash the counter on the stack.
 $AC58 LD A,(IX+$00)   ; Fetch the type of the entity.
 $AC5B AND A           ; Test it.
 $AC5C JR Z,$ACB9      ; Jump to #R$ACB9 if the entity is not in use.
; Add the entity to the draw list, unless it is hidden.
 $AC5E BIT 7,(IX+$01)  ; Test bit 7 of field #N$01 of the entity, which is set if it is
                       ; hidden.
 $AC62 CALL Z,$AD07    ; Add the entity to the draw list if it is not hidden.
 $AC65 BIT 7,(IY+$09)  ; {Jump to #R$ACB9 if the extra record is not in use.
 $AC69 JR Z,$ACB9      ; }
; Build the temporary entity from the extra record, so that the extra
; record can be drawn in the same way as an entity.
 $AC6B PUSH IX         ; Stash the entity and the table pointer on the stack.
 $AC6D PUSH HL         ; Stash the table pointer on the stack.
 $AC6E LD L,(IY+$00)   ; {Copy the screen position of the extra record into the temporary
 $AC71 LD H,(IY+$01)   ; entity.
 $AC74 LD ($B7B2),HL   ; }
 $AC77 LD L,(IY+$02)   ; {Copy the x coordinate of the extra record into the
 $AC7A LD H,(IY+$03)   ; temporary entity.
 $AC7D LD ($B7A6),HL   ; }
 $AC80 LD L,(IY+$04)   ; {Copy the y coordinate of the extra record into the
 $AC83 LD H,(IY+$05)   ; temporary entity.
 $AC86 LD ($B7A9),HL   ; }
 $AC89 LD L,(IY+$06)   ; {Copy the z coordinate of the extra record into the
 $AC8C LD H,(IY+$07)   ; temporary entity.
 $AC8F LD ($B7AC),HL   ; }
 $AC92 LD A,(IY+$0B)   ; {Copy the width of the extra record into the temporary
 $AC95 AND $0F         ; entity.
 $AC97 LD ($B7BA),A    ; }
 $AC9A LD A,(IY+$0C)   ; {Copy the height of the extra record into the
 $AC9D AND $3F         ; temporary entity.
 $AC9F LD ($B7BB),A    ; }
 $ACA2 LD IX,$B7A4     ; Point #REGix at #R$B7A4.
 $ACA6 LD (IX+$00),$02 ; Make it an entity of type #N$02.
 $ACAA CALL $B8E2      ; Find its address in the screen buffer.
 $ACAD LD (IY+$08),L   ; {Store the address in the extra record.
 $ACB0 LD (IY+$09),H   ; }
 $ACB3 POP HL          ; Restore the table pointer.
 $ACB4 CALL $AD17      ; Add the temporary entity to the draw list.
 $ACB7 POP IX          ; Restore the entity.
; Move on to the next entity and the next extra record.
@label=BuildDrawList_Next
*$ACB9 LD DE,$0026     ; {Move #REGix on to the next entity.
 $ACBC ADD IX,DE       ; }
 $ACBE LD E,$0D        ; {Move #REGiy on to the next extra record.
 $ACC0 ADD IY,DE       ; }
 $ACC2 POP BC          ; Restore the counter.
 $ACC3 DJNZ $AC57      ; Decrease the counter and loop back to #R$AC57 until all #N$0C
                       ; entities have been done.
; Add the records of the objects of the level that are in view to the draw
; list.
@label=BuildDrawList_Records
 $ACC5 LD HL,($B06C)   ; Fetch the next free item of the draw list.
 $ACC8 LD A,($BBF6)    ; Fetch the number of records.
 $ACCB AND A           ; Test it.
 $ACCC JR Z,$ACEE      ; Jump to #R$ACEE if there are none.
 $ACCE LD IY,$BBF7     ; Point #REGiy at #R$BBF7.
 $ACD2 LD BC,$0014     ; Set the length of a record, #N$0014.
@label=BuildDrawList_RecordLoop
*$ACD5 BIT 7,(IY+$0A)  ; {Jump to #R$ACE9 if the record is not to be drawn.
 $ACD9 JR Z,$ACE9      ; }
 $ACDB RES 7,(IY+$0A)  ; Reset the bit so that the record is only drawn once.
 $ACDF LD (HL),$03     ; Mark the item as a record.
 $ACE1 PUSH IY         ; {Copy the address of the record into #REGde.
 $ACE3 POP DE          ; }
 $ACE4 INC HL          ; {Store the address of the record in the item.
 $ACE5 LD (HL),E       ;
 $ACE6 INC HL          ;
 $ACE7 LD (HL),D       ; }
 $ACE8 INC HL          ; Move on to the next item.
@label=BuildDrawList_RecordNext
*$ACE9 ADD IY,BC       ; Move #REGiy on to the next record.
 $ACEB DEC A           ; Decrease the number of records by one.
 $ACEC JR NZ,$ACD5     ; Loop back to #R$ACD5 until all of the records have
                       ; been done.
@label=BuildDrawList_End
*$ACEE LD (HL),$00     ; Mark the end of the draw list.
 $ACF0 LD ($B06C),HL   ; Store the new end of the list.
 $ACF3 RET             ; Return.

; Append Entity Item
;
; Used by the routine at #R$AD07.
; .
; Adds an entity to the draw list without preparing a table record for it.
; Used for entity types #N$0C and #N$10.
;
; IX The entity
@label=AppendEntityItem
c$ACF4 EXX           ; Keep the other registers aside.
 $ACF5 LD HL,($B06C) ; The next free entry of the draw list.
 $ACF8 LD (HL),$01   ; {Mark the entry as an entity and move on.
 $ACFA INC HL        ; }
 $ACFB PUSH IX       ; {Write this entity's address into the entry.
 $ACFD POP DE        ;
 $ACFE LD (HL),E     ;
 $ACFF INC HL        ;
 $AD00 LD (HL),D     ;
 $AD01 INC HL        ; }
 $AD02 LD ($B06C),HL ; The list continues after this entry.
 $AD05 EXX           ; Bring the other registers back.
 $AD06 RET           ; Return.

; Prepare Entity Item
;
; Used by the routine at #R$AC40.
; .
; Converts the position of the entity with #R$B8E2 and adds it to the
; draw list. Entity types #N$0C and #N$10 are only appended with #R$ACF4. Any
; other type is also given a record in the table of item records, which holds a
; copy of the rows of the screen buffer (which are #N$18 bytes wide) that lie
; under the entity, so that #R$AD9E can put them back after the entity has been
; drawn.
;
;   IX The entity
;   HL Pointer to the next free byte in the table of item records
; O:HL Updated pointer
@label=PrepareEntityItem
c$AD07 PUSH HL       ; Save the item record pointer.
 $AD08 CALL $B8E2    ; Convert the position of the entity.
 $AD0B POP HL        ; Restore the item record pointer.
 $AD0C LD A,(IX+$00) ; Fetch the type of the entity.
 $AD0F CP $0C        ; {Jump to #R$ACF4 if it is type #N$0C.
 $AD11 JR Z,$ACF4    ; }
 $AD13 CP $10        ; {Jump to #R$ACF4 if it is type #N$10.
 $AD15 JR Z,$ACF4    ; }
; This entry point is used by the routine at #R$AC40.
; .
; Entry point used for the extra records, which are passed in #REGiy.
; .
; Count the item.
@label=PrepareEntityItem_Table
*$AD17 LD A,($F500)  ; Fetch the number of prepared items.
 $AD1A INC A         ; Add one.
 $AD1B LD ($F500),A  ; Store it again.
 $AD1E PUSH HL       ; Save the item record pointer.
 $AD1F CALL $B2CC    ; Check the #N$14-byte records for any that overlap the
                     ; entity.
; Check the #N$14-byte records for any that overlap the entity.
 $AD22 LD HL,($B06C) ; Fetch the next free item address.
; Fetch the type.
 $AD25 LD A,(IX+$00) ; Fetch the type of the entity.
 $AD28 CP $02        ; {Jump to #R$AD36 if it is not type #N$02.
 $AD2A JR NZ,$AD36   ; }
 $AD2C LD (HL),A     ; Use the type as the flag for the item.
 $AD2D PUSH IY       ; #REGiy moves into #REGde.
 $AD2F POP DE        ; (via the stack).
 $AD30 INC HL        ; Move to the address bytes.
 $AD31 LD (HL),E     ; Store the low byte of the record address.
 $AD32 INC HL        ; Move on.
 $AD33 LD (HL),D     ; Store the high byte of the record address.
 $AD34 JR $AD3F      ; Jump to #R$AD3F.
; Add an entity item (flag #N$01) to the draw list.
@label=PrepareEntityItem_Entity
*$AD36 LD (HL),$01   ; Set the flag of the item to #N$01.
 $AD38 INC HL        ; Move to the address bytes.
 $AD39 PUSH IX       ; #REGix moves into #REGde.
 $AD3B POP DE        ; (via the stack).
 $AD3C LD (HL),E     ; Store the low byte of the entity address.
 $AD3D INC HL        ; Move on.
 $AD3E LD (HL),D     ; Store the high byte of the entity address.
@label=PrepareEntityItem_Header
*$AD3F INC HL        ; Move to the next free item.
 $AD40 LD ($B06C),HL ; Store it.
 $AD43 POP HL        ; Restore the item record pointer.
; Fetch the address in the screen buffer.
 $AD44 LD E,(IX+$18) ; Fetch the low byte of the address in the screen buffer.
 $AD47 LD D,(IX+$19) ; Fetch the high byte of the address in the screen buffer.
; Work out how many bytes wide the record is, from field #N$16 and field
; #N$0E.
 $AD4A LD A,(IX+$16) ; Read field #N$16.
 $AD4D AND %00001111 ; Keep the low nibble.
 $AD4F LD C,A        ; Copy it into #REGc.
 $AD50 LD A,(IX+$0E) ; Read field #N$0E.
 $AD53 AND %00000111 ; Use bits 0-2.
 $AD55 JR Z,$AD58    ; Jump to #R$AD58 if they are all zero.
 $AD57 INC C         ; Otherwise add one to the width.
; Patch the operand of the #REGbc load at #R$AD07(#N$AD96) and write the
; record header: the first byte is the width plus #N$18, then the address in the
; screen buffer.
@label=PrepareEntityItem_Width
*$AD58 LD A,$E8      ; Start from #N$E8.
 $AD5A SUB C         ; Subtract the width.
 $AD5B LD ($AD96),A  ; Patch the operand of the #REGbc load at #N$AD94 with it.
 $AD5E NEG           ; Negate it to give the width plus #N$18.
 $AD60 LD (HL),A     ; Write it as the first byte of the record.
 $AD61 INC HL        ; Move on.
 $AD62 LD (HL),E     ; Write the low byte of the address in the screen buffer.
 $AD63 INC HL        ; Move on.
 $AD64 LD (HL),D     ; Write the high byte of the address in the screen buffer.
 $AD65 INC HL        ; Move on.
; Patch the jump back into the unrolled copy so that only #REGc bytes of
; each row are copied.
 $AD66 SLA C         ; Double the width.
 $AD68 LD A,$F8      ; Start from #N$F8.
 $AD6A SUB C         ; Subtract twice the width.
 $AD6B LD ($AD9B),A  ; Patch the displacement of the DJNZ at #R$AD9A with it (the
                     ; displacement is the byte at #N$AD9B).
 $AD6E SUB $02       ; Subtract #N$02.
 $AD70 LD (HL),A     ; Write it as the fourth byte of the record.
 $AD71 INC HL        ; Move on.
; Work out the number of rows from fields #N$17 and #N$0F and write it to
; the header.
 $AD72 LD A,(IX+$17) ; Read field #N$17.
 $AD75 AND %00111111 ; Use bits 0-5.
 $AD77 INC A         ; Add one.
 $AD78 LD B,A        ; Copy it into #REGb.
 $AD79 LD A,(IX+$0F) ; Read field #N$0F.
 $AD7C CP B          ; Compare it with the value in #REGb.
 $AD7D JR NC,$AD82   ; Jump to #R$AD07(#N$AD82) if it is not less.
 $AD7F ADD A,$02     ; Otherwise use field #N$0F plus #N$02.
 $AD81 LD B,A        ; Copy it into #REGb.
@label=PrepareEntityItem_Skip
*$AD82 LD (HL),B     ; Write the number of rows as the fifth byte of the
                     ; record.
 $AD83 INC HL        ; Move on.
; Swap, ready to copy the rows from the data into the table.
 $AD84 EX DE,HL      ; Swap the screen buffer address into #REGhl and the table pointer
                     ; into #REGde.
 $AD85 JP $AD9A      ; Jump into the copy loop.
@label=PrepareEntityItem_Copy
 $AD88 LDI           ; Copy a byte and move on.
 $AD8A LDI           ; Copy a byte and move on.
 $AD8C LDI           ; Copy a byte and move on.
 $AD8E LDI           ; Copy a byte and move on.
 $AD90 LDI           ; Copy a byte and move on.
 $AD92 LDI           ; Copy a byte and move on.
 $AD94 LD A,B        ; Save the row counter.
 $AD95 LD BC,$FF00   ; Set up the step back to the start of the next row (the low byte is
                     ; patched at #N$AD96).
 $AD98 ADD HL,BC     ; Move #REGhl back to the start of the next row of the
                     ; screen buffer.
 $AD99 LD B,A        ; Restore the row counter.
@label=PrepareEntityItem_Loop
*$AD9A DJNZ $AD9A    ; Decrease the row counter and jump back into the copy chain (the
                     ; displacement is patched at #R$AD07(#N$AD9B)) until all rows are copied.
 $AD9C EX DE,HL      ; Swap the pointer to the next free byte back into #REGhl.
 $AD9D RET           ; Return.

; Restore Item Rows
;
; Used by the routines at #R$CD11 and #R$DFF0.
; .
; Replays the table of item records built by #R$AC40 and #R$AD07. For
; each record, the rows of the screen buffer saved in the record are copied back
; to the address in the record header, working upwards one row at a time.
@label=RestoreItemRows
c$AD9E LD A,($F500)  ; Read how many item records there are.
 $ADA1 AND A         ; {Return when there are none.
 $ADA2 RET Z         ; }
; The alternate accumulator counts the records. The first byte of a
; header is the step back to the previous row.
 $ADA3 LD HL,$F501   ; Start at the first record.
@label=RestoreItemRows_Loop
*$ADA6 EX AF,AF'     ; Remember how many records remain.
 $ADA7 LD A,(HL)     ; {Patch the step back to the previous row.
 $ADA8 LD ($ADDE),A  ; }
 $ADAB INC HL        ; Move on to the screen address.
 $ADAC LD E,(HL)     ; {Read the screen address from the header.
 $ADAD INC HL        ;
 $ADAE LD D,(HL)     ;
 $ADAF INC HL        ; }
 $ADB0 LD A,(HL)     ; {Patch the row loop with the width.
 $ADB1 LD ($ADE5),A  ; }
 $ADB4 INC HL        ; Move on to the row count.
 $ADB5 LD B,(HL)     ; {Read how many rows.
 $ADB6 INC HL        ; }
 $ADB7 LD C,$FF      ; Keep the byte count from carrying into the row count.
 $ADB9 JP $ADE4      ; Join the row loop.
@label=RestoreItemRows_Next
*$ADBC EX AF,AF'     ; {Repeat for the remaining records.
 $ADBD DEC A         ;
 $ADBE JP NZ,$ADA6   ; }
 $ADC1 RET           ; Return.
; Copy three words from the stack. The patched jump cannot reach this for
; a width of up to six bytes, so it is not used.
@label=RestoreItemRows_Words
 $ADC2 POP DE        ; {Copy three words from the stack.
 $ADC3 LD (HL),E     ;
 $ADC4 INC HL        ;
 $ADC5 LD (HL),D     ;
 $ADC6 INC HL        ;
 $ADC7 POP DE        ;
 $ADC8 LD (HL),E     ;
 $ADC9 INC HL        ;
 $ADCA LD (HL),D     ;
 $ADCB INC HL        ;
 $ADCC POP DE        ;
 $ADCD LD (HL),E     ;
 $ADCE INC HL        ;
 $ADCF LD (HL),D     ; }
; Copy one byte of the row for each of these that the patched jump
; reaches. A wider row starts further up the list.
@label=RestoreItemRows_Copy
 $ADD0 LDI           ; Copy a byte and move on.
 $ADD2 LDI           ; Copy a byte and move on.
 $ADD4 LDI           ; Copy a byte and move on.
 $ADD6 LDI           ; Copy a byte and move on.
 $ADD8 LDI           ; Copy a byte and move on.
 $ADDA LDI           ; Copy a byte and move on.
; Move back one row. The distance subtracted below is patched from the
; record header.
@label=RestoreItemRows_Step
 $ADDC LD A,E        ; {Step back to the previous row.
 $ADDD SUB $00       ;
 $ADDF LD E,A        ; }
 $ADE0 JP NC,$ADE4   ; Stay on this page if the step did not borrow.
 $ADE3 DEC D         ; Move to the previous page.
@label=RestoreItemRows_Rows
*$ADE4 DJNZ $ADE4    ; Repeat for the remaining rows. The displacement is
                     ; patched.
 $ADE6 JP $ADBC      ; Go on to the next record.

; Row Routine Table
;
; The addresses of the routines that draw the rows of a sprite, used by
; #R$B43C. The first four draw sprites that are byte aligned and are for widths
; of one to four bytes, and the last four are for shifted sprites.
@label=RowRoutineTable
w$ADE9 DEFW $B4D5
 $ADEB DEFW $B4CE
 $ADED DEFW $B4C7
 $ADEF DEFW $B4C0
 $ADF1 DEFW $B518
 $ADF3 DEFW $B508
 $ADF5 DEFW $B4F8
 $ADF7 DEFW $B4E8

; Project Player Entity
;
; Used by the routines at #R$CD11 and #R$DFF0.
; .
; Projects the player entity with #R$AE0D, then works out how far the
; entity has moved on the screen since the last frame. The previous value is
; kept in #R$5CEC and the change in #R$5CEC(#N$5CED).
;
; IX The player entity
@label=ProjectPlayerEntity
c$ADF9 CALL $AE0D    ; Call #R$AE0D.
 $ADFC LD A,($5CEC)  ; Read the byte at #R$5CEC.
 $ADFF LD B,A        ; #REGa moves into #REGb.
 $AE00 LD A,(IX+$0F) ; Fetch the row.
 $AE03 LD C,A        ; #REGa moves into #REGc.
 $AE04 SUB B         ; Subtract #REGb.
 $AE05 LD ($5CED),A  ; Write #REGa at #R$5CEC(#N$5CED).
 $AE08 LD A,C        ; #REGc moves into #REGa.
 $AE09 LD ($5CEC),A  ; Write #REGa at #R$5CEC.
 $AE0C RET           ; Return.

; Project Entity
;
; Used by the routines at #R$9924, #R$9D8D, #R$9D9D, #R$ADF9, #R$BE01, #R$CE84
; and #R$CF30.
; .
; Works out the screen position of an entity from its coordinates,
; relative to the view origin held in #R$5CE7 and #R$5CEE. The results are
; stored in fields #N$0E and #N$0F of the entity. If any part of the entity is
; out of view then it is hidden by setting bit 7 of field #N$01, and when it is
; visible the hidden bit is only set if the entity is waiting to appear (see the
; wanted heading in fields #N$24 and #N$25). Purpose of the individual tests is
; not yet known.
;
; IX The entity
;
; Find the screen column of the entity. This is the sum of its x and y
; coordinates, less the horizontal origin of the view.
@label=ProjectEntity
c$AE0D LD H,(IX+$02)  ; {Fetch the x coordinate of the entity into #REGhl.
 $AE10 LD L,(IX+$03)  ; }
 $AE13 LD D,(IX+$05)  ; {Fetch the y coordinate of the entity into #REGde.
 $AE16 LD E,(IX+$06)  ; }
 $AE19 ADD HL,DE      ; Add them together.
 $AE1A LD DE,($5CE7)  ; Fetch the horizontal origin of the view.
 $AE1E XOR A          ; Clear #REGa.
 $AE1F SBC HL,DE      ; Subtract the origin from the sum.
 $AE21 OR H           ; Combine #REGa with #REGh.
 $AE22 JP NZ,$AEAB    ; Jump to #R$AEAB if the column is more than one byte, so that the
                      ; entity is hidden.
 $AE25 LD A,L         ; Copy the column into #REGa.
 $AE26 CP $B0         ; {Jump to #R$AEAB if the entity starts beyond the right edge of the
 $AE28 JP NC,$AEAB    ; view.}
 $AE2B LD (IX+$0E),A  ; Set the column.
; Check that the right edge of the entity is not off the left or right
; edge of the view.
 $AE2E LD A,(IX+$16)  ; Read field #N$16 of the entity.
 $AE31 AND %00001111  ; Keep the width of the sprite in bytes, which is held in bits
                      ; 0-3.
 $AE33 ADD A,A        ; {Multiply the width by eight to find it in pixels.
 $AE34 ADD A,A        ;
 $AE35 ADD A,A        ; }
 $AE36 ADD A,L        ; Add the column to find the right edge of the entity.
 $AE37 CP $C1         ; {Jump to #R$AEAB if the right edge is beyond the right
 $AE39 JP NC,$AEAB    ; of the view.}
 $AE3C CP $11         ; {Jump to #R$AEAB if the right edge is before the left
 $AE3E JP C,$AEAB     ; of the view.}
; Find the screen row of the entity. This is half of the difference
; between its x and y coordinates, less its height (z coordinate), plus an
; offset for its size, less the vertical origin of the view.
 $AE41 LD H,(IX+$02)  ; {Fetch the x coordinate of the entity into #REGhl.
 $AE44 LD L,(IX+$03)  ; }
 $AE47 SRL H          ; {Halve the x coordinate.
 $AE49 RR L           ; }
 $AE4B LD D,(IX+$05)  ; {Fetch the y coordinate of the entity into #REGde.
 $AE4E LD E,(IX+$06)  ; }
 $AE51 SRL D          ; {Halve the y coordinate.
 $AE53 RR E           ; }
 $AE55 XOR A          ; Clear #REGa.
 $AE56 SBC HL,DE      ; Subtract half of the y coordinate from half of the x
                      ; coordinate.
 $AE58 LD D,(IX+$08)  ; {Fetch the high byte of the z coordinate, less one,
 $AE5B DEC D          ; into #REGd.}
 $AE5C LD E,(IX+$09)  ; Fetch the low byte of the z coordinate into #REGe.
 $AE5F AND A          ; {Subtract the z coordinate, so that a higher entity is drawn higher
 $AE60 SBC HL,DE      ; up.}
 $AE62 LD BC,$0040    ; Fetch the offset #N$0040.
 $AE65 ADD HL,BC      ; Add the offset.
 $AE66 LD C,(IX+$0B)  ; Fetch the x extent, which is its size.
 $AE69 SRL C          ; Halve it.
 $AE6B ADD HL,BC      ; Add it, so that the row is that of the bottom of the
                      ; entity.
 $AE6C XOR A          ; Clear #REGa.
 $AE6D LD BC,($5CEE)  ; Fetch the vertical origin of the view.
 $AE71 SBC HL,BC      ; Subtract the origin.
 $AE73 OR H           ; Combine #REGa with #REGh.
 $AE74 JR NZ,$AEAB    ; Jump to #R$AEAB if the row is more than one byte, so that the entity
                      ; is hidden.
 $AE76 LD (IX+$0F),L  ; Set the row.
; Decide whether the entity is shown yet. An entity that is turning
; towards its wanted heading is hidden until it has faced the right way.
 $AE79 LD A,(IX+$24)  ; Read field #N$24 of the entity.
 $AE7C AND %11000000  ; Use bits 6-7.
 $AE7E JR Z,$AE84     ; Jump to #R$AE84 if both are reset.
 $AE80 CP $40         ; {Jump to #R$AE9B if they are not set to that value, to show the
 $AE82 JR NZ,$AE9B    ; entity.}
@label=ProjectEntity_Delay
*$AE84 LD A,(IX+$25)  ; Read field #N$25 of the entity.
 $AE87 AND A          ; Test it.
 $AE88 JR Z,$AE9B     ; Jump to #R$AE9B if it is zero, to show the entity.
 $AE8A AND %00000111  ; Use bits 0-2.
 $AE8C JR NZ,$AE95    ; Jump to #R$AE95 if any of them is set, to hide the
                      ; entity.
 $AE8E LD A,(IX+$25)  ; Read field #N$25 of the entity.
 $AE91 CP $38         ; {Jump to #R$AE9B if it is #N$38 or more, to show the
 $AE93 JR NC,$AE9B    ; entity.}
@label=ProjectEntity_Hide
*$AE95 SET 7,(IX+$01) ; Set bit 7 of field #N$01 of the entity, to hide it.
 $AE99 JR $AE9F       ; Jump to #R$AE9F.
@label=ProjectEntity_Show
*$AE9B RES 7,(IX+$01) ; Reset bit 7 of field #N$01 of the entity, to show it.
; Hide the entity if the top of it is off the bottom of the view.
@label=ProjectEntity_Size
*$AE9F LD A,(IX+$17)  ; Read field #N$17 of the entity.
 $AEA2 AND %00111111  ; Keep the height of the sprite in bits 0-5.
 $AEA4 LD B,A         ; Copy it into #REGb.
 $AEA5 LD A,L         ; Copy the row into #REGa.
 $AEA6 SUB B          ; Subtract the height of the sprite to find the top row.
 $AEA7 RET C          ; Return if the top row is above the view, as the entity is partly in
                      ; view.
 $AEA8 INC A          ; {Move onto the row below and shift it into the carry
 $AEA9 RLA            ; flag.}
 $AEAA RET NC         ; Return if the entity is within the first half of the
                      ; view.
@label=ProjectEntity_Hidden
*$AEAB SET 7,(IX+$01) ; Set bit 7 of field #N$01 of the entity, to hide it.
 $AEAF RET            ; Return.

; Test Entity Visible
;
; Used by the routines at #R$9B79, #R$9D8D, #R$9D9D, #R$BE01 and #R$CEE2.
; .
; Tests whether the entity is within the view in both directions, allowing
; for a margin of #REGbc.
;
;   IX The entity
;   BC The margin
; O:A Zero if the entity is out of view, otherwise non-zero
;
; Test the column, which is the x coordinate plus the y coordinate, less
; the horizontal origin of the view. The entity is out of view if the column
; is further left than the margin, or further right than #N$C0 plus the margin.
@label=TestEntityVisible
c$AEB0 LD H,(IX+$02) ; {Fetch the x coordinate.
 $AEB3 LD L,(IX+$03) ; }
 $AEB6 LD D,(IX+$05) ; {Fetch the y coordinate.
 $AEB9 LD E,(IX+$06) ; }
 $AEBC ADD HL,DE     ; Add them to get the column before the origin.
 $AEBD LD DE,($5CE7) ; Fetch the horizontal origin of the view.
 $AEC1 SBC HL,DE     ; Subtract the origin.
 $AEC3 BIT 7,H       ; {Jump to #R$AECE if the column is not left of the
 $AEC5 JR Z,$AECE    ; origin.}
 $AEC7 ADD HL,BC     ; Add the margin.
 $AEC8 RL H          ; Test whether the column is still negative.
 $AECA JR NC,$AEDB   ; Go on to the row if the margin brings the column back.
 $AECC XOR A         ; {Report that the entity is out of view.
 $AECD RET           ; }
@label=TestEntityVisible_Second
*$AECE LD DE,$00C0   ; Set the right edge of the test to #N$C0.
 $AED1 SBC HL,DE     ; Subtract it from the column.
 $AED3 SBC HL,BC     ; Subtract the margin as well.
 $AED5 RL H          ; Test whether the column is now negative.
 $AED7 JR C,$AEDB    ; Go on to the row if the column is inside the right edge.
 $AED9 XOR A         ; {Report that the entity is out of view.
 $AEDA RET           ; }
; Test the row, using the same sum as #R$AE0D: half of the x coordinate
; less half of the y coordinate, less the z coordinate, plus #N$40, less the
; vertical origin of the view.
@label=TestEntityVisible_Vertical
*$AEDB LD H,(IX+$02) ; {Fetch the x coordinate.
 $AEDE LD L,(IX+$03) ; }
 $AEE1 SRL H         ; {Halve the x coordinate.
 $AEE3 RR L          ; }
 $AEE5 LD D,(IX+$05) ; {Fetch the y coordinate.
 $AEE8 LD E,(IX+$06) ; }
 $AEEB SRL D         ; {Halve the y coordinate.
 $AEED RR E          ; }
 $AEEF AND A         ; {Subtract half of the y coordinate from half of the x
 $AEF0 SBC HL,DE     ; coordinate.}
 $AEF2 LD D,(IX+$08) ; {Fetch the high byte of the z coordinate, less one.
 $AEF5 DEC D         ; }
 $AEF6 LD E,(IX+$09) ; Fetch the low byte of the z coordinate.
 $AEF9 AND A         ; {Subtract the z coordinate.
 $AEFA SBC HL,DE     ; }
 $AEFC LD DE,$0040   ; Set the offset to #N$0040.
 $AEFF ADD HL,DE     ; Add the offset.
 $AF00 LD DE,($5CEE) ; Fetch the vertical origin of the view.
 $AF04 SBC HL,DE     ; Subtract the origin.
 $AF06 BIT 7,H       ; {Jump to #R$AF11 if the row is not above the origin.
 $AF08 JR Z,$AF11    ; }
 $AF0A ADD HL,BC     ; Add the margin.
 $AF0B RL H          ; Test whether the row is still negative.
 $AF0D JR NC,$AF1E   ; Accept the entity if the margin brings the row back.
 $AF0F XOR A         ; {Report that the entity is out of view.
 $AF10 RET           ; }
@label=TestEntityVisible_Far
*$AF11 LD DE,$0080   ; Set the bottom of the test to #N$80.
 $AF14 SBC HL,DE     ; Subtract it from the row.
 $AF16 SBC HL,BC     ; Subtract the margin as well.
 $AF18 RL H          ; Test whether the row is now negative.
 $AF1A JR C,$AF1E    ; Accept the entity if the row is inside the bottom edge.
 $AF1C XOR A         ; {Report that the entity is out of view.
 $AF1D RET           ; }
@label=TestEntityVisible_Yes
*$AF1E OR %00010000  ; Set a non-zero result.
 $AF20 RET           ; Return.

; Set Entity Size
;
; Used by the routines at #R$97AE, #R$986C, #R$9924, #R$995F, #R$9A0A, #R$9AD9,
; #R$9CA3, #R$9D67, #R$AF48, #R$B7CE, #R$BE01, #R$CD11, #R$DC6A and #R$DE25.
; .
; Fetches the sprite for the entity with #R$6653 and copies the width and
; the height of the sprite to fields #N$16 and #N$17. If either is too big, the
; game crashes with #R$AF43.
;
; IX The entity
@label=SetEntitySize
c$AF21 CALL $6653    ; Find the sprite of the entity.
 $AF24 EX DE,HL      ; Point #REGhl at the sprite.
 $AF25 LD A,(HL)     ; Fetch the width of the sprite.
 $AF26 CP $05        ; {Jump to #R$AF43 to crash if the width is #N$05 bytes or
 $AF28 JR NC,$AF43   ; more.}
 $AF2A LD A,(IX+$16) ; Fetch the width byte of the entity.
 $AF2D AND %11110000 ; Keep the flags in bits 4-7.
 $AF2F OR (HL)       ; Combine them with the width of the sprite.
 $AF30 LD (IX+$16),A ; Store the width of the entity.
 $AF33 INC HL        ; Move on to the height of the sprite.
 $AF34 LD A,(HL)     ; Fetch the height of the sprite.
 $AF35 CP $28        ; {Jump to #R$AF43 to crash if the height is #N$28 or
 $AF37 JR NC,$AF43   ; more.}
 $AF39 LD A,(IX+$17) ; Fetch the height byte of the entity.
 $AF3C AND %11000000 ; Keep the flags in bits 6-7.
 $AF3E OR (HL)       ; Combine them with the height of the sprite.
 $AF3F LD (IX+$17),A ; Store the height of the entity.
 $AF42 RET           ; Return.

; Flash Border
;
; Used by the routine at #R$AF21.
; .
; Cycles the border colour for ever. Entered when the sprite data of an
; entity is out of range.
@label=FlashBorder
c$AF43 OUT ($FE),A   ; Write #REGa to the port.
 $AF45 INC A         ; Advance #REGa.
 $AF46 JR $AF43      ; Jump to #R$AF43.

; Animate Entity
;
; Used by the routines at #R$CD11 and #R$CEE2.
; .
; Moves the entity on to the next frame of its animation every other
; frame. The counter in field #N$1C controls the speed, and field #N$1D holds
; the first and last frame numbers.
;
; IX The entity
@label=AnimateEntity
c$AF48 LD A,($A2DD)  ; Fetch the frame counter.
 $AF4B RRA           ; Move its low bit into the carry flag.
 $AF4C RET NC        ; Return on every other frame.
 $AF4D LD A,(IX+$1C) ; {Fetch the animation counter and keep it in #REGb.
 $AF50 LD B,A        ; }
 $AF51 SUB $40       ; Count it down by #N$40.
 $AF53 JR NC,$AF83   ; Jump to #R$AF83 if it had not yet reached the next
                     ; frame.
 $AF55 LD A,(IX+$01) ; Fetch the frame of the entity.
 $AF58 AND %00001111 ; Keep the frame number.
 $AF5A INC A         ; Move on to the next frame.
 $AF5B LD E,A        ; Keep the next frame in #REGe.
 $AF5C LD A,(IX+$1D) ; {Fetch the first and last frame numbers and keep them in
 $AF5F LD D,A        ; #REGd.}
 $AF60 RRCA          ; {Move the last frame number down to bits 0-3.
 $AF61 RRCA          ;
 $AF62 RRCA          ;
 $AF63 RRCA          ; }
 $AF64 AND %00001111 ; Keep the last frame number.
 $AF66 CP E          ; Compare it with the next frame.
 $AF67 JR NC,$AF6D   ; Jump to #R$AF6D if the next frame is still within the
                     ; animation.
 $AF69 LD A,D        ; Fetch the first and last frame numbers again.
 $AF6A AND %00001111 ; Keep the first frame number.
 $AF6C LD E,A        ; Use the first frame, so that the animation repeats.
@label=AnimateEntity_Frame
*$AF6D LD A,(IX+$01) ; Fetch the frame of the entity.
 $AF70 AND %11110000 ; Keep the flags in bits 4-7.
 $AF72 OR E          ; Combine them with the new frame number.
 $AF73 LD (IX+$01),A ; Store the new frame.
 $AF76 LD A,B        ; {Move bits 4-5 of the animation counter up to bits 6-7.
 $AF77 ADD A,A       ;
 $AF78 ADD A,A       ; }
 $AF79 AND %11000000 ; Keep those bits.
 $AF7B OR (IX+$1C)   ; Combine them with the animation counter.
 $AF7E EX AF,AF'     ; Save it.
 $AF7F CALL $AF21    ; Set the sprite size for the new frame.
 $AF82 EX AF,AF'     ; Restore the animation counter.
@label=AnimateEntity_Store
*$AF83 LD (IX+$1C),A ; Store the animation counter.
 $AF86 RET           ; Return.

; Draw List Buffers
;
; Guard bytes before the sorted draw list.
@label=DrawListBuffers
b$AF87 DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF

; Sorted Draw List
;
; The draw list after it has been sorted into drawing order by #R$9F99.
; It has the same format as the list at #R$AFFB.
@label=SortedDrawList
g$AF8F DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $AF97 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $AF9F DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $AFA7 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $AFAF DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $AFB7 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $AFBF DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $AFC7 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $AFCF DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $AFD7 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $AFDF DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $AFE7 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $AFEF DEFB $00,$00,$00,$00

; Draw List Guard
@label=DrawListGuard
b$AFF3 DEFB $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF

; Draw List
;
; The list of items to draw, built by #R$AC40. Each item is three bytes:
; a flag and the address of a record.
@label=DrawList
g$AFFB DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $B003 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $B00B DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $B013 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $B01B DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $B023 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $B02B DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $B033 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $B03B DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $B043 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $B04B DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $B053 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $B05B DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $B063 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $B06B DEFB $00

; Draw List Pointer
;
; The address of the next free item in the draw list.
@label=DrawListPointer
g$B06C DEFW $0000

; Draw Items
;
; Used by the routines at #R$CD11 and #R$DFF0.
; .
; Draws every item in the sorted draw list at #R$AF8F, in order. The flag
; in each item selects what is drawn: #N$01 is an entity, #N$02 is one of the
; extra records (which is first copied into the temporary entity at #R$B7A4)
; and #N$03 is one of the #N$14-byte records.
; .
; For a #N$14-byte record, the items drawn before it that overlap it are
; collected into the table at #R$B1B2(#N$B1B3) and then the record is drawn
; with #R$C15E. An extra record is drawn with #R$B436 after its column, row,
; frame, width and height have been copied into the temporary entity.
@label=DrawItems
c$B06E LD HL,$AF8F    ; Take the sorted draw list.
@label=DrawItems_Next
*$B071 LD A,(HL)      ; Read the kind of the next item.
 $B072 AND %01111111  ; Keep the kind of the item.
 $B074 RET Z          ; Return at the end of the list.
 $B075 INC HL         ; {Read the address of the record and step to the next
 $B076 LD E,(HL)      ; item.
 $B077 INC HL         ;
 $B078 LD D,(HL)      ;
 $B079 INC HL         ; }
 $B07A PUSH DE        ; {Take that record.
 $B07B POP IX         ; }
 $B07D PUSH HL        ; Remember the next item.
 $B07E DEC A          ; {Draw an entity with #R$B436.
 $B07F JP Z,$B436     ; }
 $B082 CP $02         ; {Draw a #N$14-byte record at #R$B0C4.
 $B084 JP Z,$B0C4     ; }
@label=DrawItems_Extra
 $B087 BIT 7,(IX+$09) ; {Jump to #R$B0C1 to skip an extra record that is not in
 $B08B JR Z,$B0C1     ; use.}
 $B08D LD L,(IX+$00)  ; {Copy the column and the row into the temporary entity.
 $B090 LD H,(IX+$01)  ;
 $B093 LD ($B7B2),HL  ; }
 $B096 LD L,(IX+$08)  ; {Copy fields #N$08 and #N$09 of the extra record into the screen
 $B099 LD H,(IX+$09)  ; address
 $B09C LD ($B7BC),HL  ; of the temporary entity.}
 $B09F LD A,(IX+$0B)  ; {Fetch the frame and the width.
 $B0A2 LD B,A         ; }
 $B0A3 AND %00001111  ; Keep the width.
 $B0A5 LD ($B7BA),A   ; Store the width in the temporary entity.
 $B0A8 LD A,(IX+$0C)  ; Fetch the height byte.
 $B0AB AND %00111111  ; Keep the height.
 $B0AD LD ($B7BB),A   ; Store the height in the temporary entity.
 $B0B0 LD A,B         ; {Move the frame down from the high nibble.
 $B0B1 RRA            ;
 $B0B2 RRA            ;
 $B0B3 RRA            ;
 $B0B4 RRA            ; }
 $B0B5 AND %00001111  ; Keep the frame.
 $B0B7 LD ($B7A5),A   ; Store the frame in the temporary entity.
 $B0BA LD IX,$B7A4    ; Use the temporary entity.
 $B0BE JP $B436       ; Draw it.
; This entry point is used by the routine at #R$B436.
@label=DrawItems_NextItem
*$B0C1 POP HL         ; Restore the next item.
 $B0C2 JR $B071       ; Take the next item.
; Look back through the items drawn before this #N$14-byte record. The
; alternate #REGc counts the ones that overlap it, and the alternate #REGhl
; walks the overlap table.
@label=DrawItems_Record
*$B0C4 EXX            ; Switch to the alternate registers.
 $B0C5 LD C,$00       ; Clear the overlap count.
 $B0C7 LD HL,$B1B3    ; Use the overlap table.
 $B0CA EXX            ; Switch back.
 $B0CB PUSH IX        ; {Keep this record aside.
 $B0CD POP IY         ; }
 $B0CF DEC HL         ; {Step back to this item.
 $B0D0 DEC HL         ;
 $B0D1 DEC HL         ; }
@label=DrawItems_Previous
*$B0D2 DEC HL         ; {Read the previous item.
 $B0D3 LD D,(HL)      ;
 $B0D4 DEC HL         ;
 $B0D5 LD E,(HL)      ;
 $B0D6 DEC HL         ;
 $B0D7 LD A,(HL)      ; }
 $B0D8 CP $FF         ; {Stop at the start of the list.
 $B0DA JR Z,$B130     ; }
 $B0DC CP $03         ; {Skip another #N$14-byte record.
 $B0DE JR Z,$B12E     ; }
 $B0E0 PUSH DE        ; {Take the previous item.
 $B0E1 POP IX         ; }
 $B0E3 PUSH HL        ; Remember the place in the list.
 $B0E4 DEC A          ; {Test an entity now.
 $B0E5 JR Z,$B11F     ; }
 $B0E7 LD L,(IX+$00)  ; {Copy the column and the row of the extra record into the temporary
 $B0EA LD H,(IX+$01)  ; entity.
 $B0ED LD ($B7B2),HL  ; }
 $B0F0 LD L,(IX+$02)  ; {Copy the adjusted x coordinate into the temporary
 $B0F3 LD H,(IX+$03)  ; entity.
 $B0F6 LD ($B7A6),HL  ; }
 $B0F9 LD L,(IX+$04)  ; {Copy the adjusted y coordinate into the temporary
 $B0FC LD H,(IX+$05)  ; entity.
 $B0FF LD ($B7A9),HL  ; }
 $B102 LD L,(IX+$06)  ; {Copy the adjusted z coordinate into the temporary
 $B105 LD H,(IX+$07)  ; entity.
 $B108 LD ($B7AC),HL  ; }
 $B10B LD A,(IX+$0B)  ; Fetch the frame and the width.
 $B10E AND %00001111  ; Keep the width.
 $B110 LD ($B7BA),A   ; Store the width in the temporary entity.
 $B113 LD A,(IX+$0C)  ; Fetch the height byte.
 $B116 AND %00111111  ; Keep the height.
 $B118 LD ($B7BB),A   ; Store the height in the temporary entity.
 $B11B LD IX,$B7A4    ; Use the temporary entity.
@label=DrawItems_Test
*$B11F CALL $B2EB     ; Test this item against the record.
 $B122 BIT 7,(IY+$0A) ; Test whether the record still has to collect this item.
 $B126 RES 7,(IY+$0A) ; Mark the record as having been tested against this
                      ; item.
 $B12A CALL NZ,$B399  ; Collect the item when it overlaps the record.
 $B12D POP HL         ; Restore the place in the list.
@label=DrawItems_Continue
*$B12E JR $B0D2       ; Look at the previous item.
; Patch the drawing routines with this record, then draw the block. A
; record whose byte #N$0A is #N$11 or #N$12 keeps the default details #N$1010.
@label=DrawItems_Collected
*$B130 EXX            ; Switch to the alternate registers.
 $B131 LD A,C         ; {Test the overlap count.
 $B132 AND A          ; }
 $B133 JP Z,$B0C1     ; Leave a record that nothing overlaps.
 $B136 LD ($B1B2),A   ; Remember how many items overlap the record.
 $B139 LD ($C653),A   ; Give that count to the overlapped-block routine.
 $B13C LD A,($5CF0)   ; Fetch the drawing flags.
 $B13F AND %00000111  ; Keep the low three drawing flags.
 $B141 LD ($C65D),A   ; Give the drawing flags to the overlapped-block routine.
 $B144 LD A,(IY+$0A)  ; Fetch byte #N$0A of the record.
 $B147 LD ($C1FE),A   ; Give that byte to the block routine.
 $B14A LD H,A         ; {Build an instruction that loads three times that byte.
 $B14B LD L,$3E       ;
 $B14D ADD A,A        ;
 $B14E ADD A,A        ;
 $B14F SUB H          ;
 $B150 LD H,A         ; }
 $B151 LD ($C1A0),HL  ; Patch that instruction into #R$C15E(#N$C1A0).
 $B154 LD A,$C3       ; Take the opcode of a jump.
 $B156 LD ($C75D),A   ; Patch it into #R$C72E(#N$C75D).
 $B159 LD HL,$C7AC    ; Take #R$C7AC.
 $B15C LD ($C75E),HL  ; Patch the jump so that it enters #R$C7AC.
 $B15F LD DE,($5CE7)  ; Fetch the view origin.
 $B163 LD B,(IY+$00)  ; {Fetch the first two bytes of the record.
 $B166 LD C,(IY+$01)  ; }
 $B169 LD HL,$0000    ; Start from zero.
 $B16C XOR A          ; {Subtract the view origin and add the first two bytes
 $B16D SBC HL,DE      ; of the record.
 $B16F ADD HL,BC      ; }
 $B170 LD ($BB9F),HL  ; Store the result in the drawing variables.
 $B173 LD H,(IY+$0E)  ; {Fetch the screen position saved in the record.
 $B176 LD L,(IY+$0F)  ; }
 $B179 LD ($BBA1),HL  ; Store it in the drawing variables.
 $B17C LD HL,$1010    ; Take the default record details.
 $B17F LD A,(IY+$0A)  ; Fetch byte #N$0A of the record.
 $B182 CP $11         ; {Keep the default details when the byte is #N$11.
 $B184 JR Z,$B190     ; }
 $B186 CP $12         ; {Keep the default details when the byte is #N$12.
 $B188 JR Z,$B190     ; }
 $B18A LD H,(IY+$0C)  ; {Take fields #N$0B and #N$0C of the record as the
 $B18D LD L,(IY+$0B)  ; details.}
@label=DrawItems_Details
*$B190 LD ($5CF3),HL  ; Store the details.
 $B193 LD A,(IY+$0D)  ; Fetch byte #N$0D of the record.
 $B196 LD ($5CF5),A   ; Store the third detail byte.
 $B199 LD HL,$C646    ; Take the overlapped-block routine.
 $B19C LD ($C3D8),HL  ; Patch #R$C381 so that it uses #R$C646.
 $B19F LD A,$1A       ; Take the value #N$1A.
 $B1A1 LD ($B530),A   ; Patch it into #R$B4E8(#N$B530).
 $B1A4 CALL $C15E     ; Draw the block.
 $B1A7 LD A,$08       ; Take the row step #N$08.
 $B1A9 LD ($C794),A   ; Restore it in #R$C76D(#N$C794).
 $B1AC LD ($C7A6),A   ; Restore it in #R$C76D(#N$C7A6).
 $B1AF JP $B0C1       ; Take the next item.

; Draw Items Work Area
;
; The first byte is the number of overlapping items collected by #R$B06E.
; The table of overlapping items that follows is filled by #R$B399, each entry
; being four bytes. Purpose of the rest is not yet known.
@label=DrawItemsWorkArea
g$B1B2 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $B1BA DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $B1C2 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $B1CA DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $B1D2 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $B1DA DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $B1E2 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $B1EA DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $B1F2 DEFB $00,$00,$00,$00,$00,$00,$80,$00
 $B1FA DEFB $80,$00,$00,$00,$00

; Add Item Record
;
; Used by the routine at #R$BFA5.
; .
; Adds a #N$14-byte record to the table at #R$BBF7, from the entity in
; #REGix and the details held at #R$5CB9, #R$5CDC, #R$5CF3 and #R$5CF3(#N$5CF5).
; The operand of the first instruction is the address of the next free record,
; and is updated each time. The number of records is kept in #R$BBF6. Kinds
; #N$11 and #N$12 set both sizes to #N$08 and set bit 2 of bytes 3 and 6.
;
; IX The entity
;
; #REGiy is the new record. Its bytes are filled from the entity and from
; the cell, the drawing position and the three sizes.
@label=AddItemRecord
c$B1FF LD IY,$0000     ; Use the next free record.
 $B203 LD A,($BBF6)    ; {Count one more record.
 $B206 INC A           ;
 $B207 LD ($BBF6),A    ; }
 $B20A LD DE,($5CB9)   ; Fetch the cell position.
 $B20E LD A,(IX+$00)   ; Read the entity's type.
 $B211 LD B,A          ; Keep the type aside.
 $B212 AND %11110000   ; Use the high nibble of the type.
 $B214 LD (IY+$03),A   ; Keep it as byte 3 of the record.
 $B217 LD A,B          ; {Shift the type up by four and keep it as byte 6.
 $B218 ADD A,A         ;
 $B219 ADD A,A         ;
 $B21A ADD A,A         ;
 $B21B ADD A,A         ;
 $B21C LD (IY+$06),A   ; }
 $B21F LD (IY+$02),E   ; {Keep the cell position in bytes 2 and 5.
 $B222 LD (IY+$05),D   ; }
 $B225 LD A,(IX+$01)   ; Read the frame.
 $B228 LD H,A          ; Keep the frame aside.
 $B229 AND %00001111   ; Use the frame number.
 $B22B LD L,A          ; Keep the frame number aside.
 $B22C LD A,H          ; {Bring bit 4 of the frame down beside it.
 $B22D RRA             ;
 $B22E RRA             ;
 $B22F RRA             ; }
 $B230 AND %00010000   ; Use that bit.
 $B232 OR L            ; {Combine it with the frame number and keep it as byte
 $B233 LD (IY+$0A),A   ; #N$0A.}
 $B236 LD HL,($5CF3)   ; {Copy the first two sizes into bytes #N$0B and #N$0C.
 $B239 LD (IY+$0B),L   ;
 $B23C LD (IY+$0C),H   ; }
 $B23F LD A,($5CF5)    ; {Copy the third size into byte #N$0D.
 $B242 LD (IY+$0D),A   ; }
 $B245 ADD A,$0A       ; {Make bytes 4 and 7 from that size, the details and
 $B247 LD B,A          ; #N$10.
 $B248 ADD A,H         ;
 $B249 ADD A,$10       ;
 $B24B LD (IY+$07),A   ;
 $B24E LD A,B          ;
 $B24F ADD A,L         ;
 $B250 ADD A,$10       ;
 $B252 LD (IY+$04),A   ; }
 $B255 LD DE,($5CDC)   ; Fetch the drawing position.
 $B259 LD A,(IX+$01)   ; Read the frame again.
 $B25C AND %01110000   ; Use bits 4-6 of the frame.
 $B25E ADD A,E         ; {Add them to the position and advance its high byte.
 $B25F LD E,A          ;
 $B260 INC D           ; }
 $B261 LD (IY+$08),D   ; {Keep that position in bytes 8 and 9.
 $B264 LD (IY+$09),E   ; }
 $B267 LD H,(IY+$05)   ; {Make the address kept in bytes #N$12 and #N$13.
 $B26A LD L,(IY+$06)   ;
 $B26D ADD HL,DE       ;
 $B26E LD A,B          ;
 $B26F LD BC,$FFF0     ;
 $B272 ADD HL,BC       ;
 $B273 LD B,A          ;
 $B274 LD (IY+$12),H   ;
 $B277 LD (IY+$13),L   ; }
 $B27A LD A,B          ; {Add the size to the low byte of the drawing position.
 $B27B ADD A,E         ;
 $B27C LD E,A          ;
 $B27D JR NC,$B280     ; }
 $B27F INC D           ; Count the carry in the high byte.
@label=AddItemRecord_Address
*$B280 LD H,(IY+$02)   ; {Fetch bytes 2 and 3 of the record.
 $B283 LD L,(IY+$03)   ; }
 $B286 AND A           ; {Subtract the drawing position.
 $B287 SBC HL,DE       ; }
 $B289 LD (IY+$10),H   ; {Keep that address in bytes #N$10 and #N$11.
 $B28C LD (IY+$11),L   ; }
 $B28F LD HL,($BB9F)   ; Fetch the origin.
 $B292 LD A,($5CF0)    ; Read the drawing flags.
 $B295 AND %00000111   ; Use bits 0-2 of the drawing flags.
 $B297 OR L            ; Combine them with the low byte of the origin.
 $B298 LD (IY+$00),H   ; {Keep the origin in bytes 0 and 1.
 $B29B LD (IY+$01),A   ; }
 $B29E LD HL,($BBA1)   ; {Copy the screen position into bytes #N$0E and #N$0F.
 $B2A1 LD (IY+$0E),H   ;
 $B2A4 LD (IY+$0F),L   ; }
 $B2A7 LD A,(IY+$0A)   ; {Kinds #N$11 and #N$12 use fixed sizes.
 $B2AA CP $11          ;
 $B2AC JR Z,$B2B2      ;
 $B2AE CP $12          ;
 $B2B0 JR NZ,$B2C2     ; }
@label=AddItemRecord_Fixed
*$B2B2 SET 2,(IY+$03)  ; {Set bit 2 of bytes 3 and 6.
 $B2B6 SET 2,(IY+$06)  ; }
 $B2BA LD (IY+$0B),$08 ; {Set both sizes to #N$08.
 $B2BE LD (IY+$0C),$08 ; }
@label=AddItemRecord_Next
*$B2C2 LD DE,$0014     ; {Advance to the next free record.
 $B2C5 ADD IY,DE       ;
 $B2C7 LD ($B201),IY   ; }
 $B2CB RET             ; Return.

; Test Records Against Entity
;
; Used by the routine at #R$AD07.
; .
; Tests the entity in #REGix against each of the #N$14-byte records in the
; table at #R$BBF7 that has not already been marked, using #R$B2EB.
;
; IX The entity
@label=TestRecordsAgainstEntity
c$B2CC LD A,($BBF6)   ; Read how many records there are.
 $B2CF AND A          ; {Return when there are none.
 $B2D0 RET Z          ; }
 $B2D1 PUSH IY        ; Remember the record that was in use.
 $B2D3 LD IY,$BBF7    ; Start at the first record.
@label=TestRecordsAgainstEntity_Loop
*$B2D7 PUSH AF        ; Remember how many records remain.
 $B2D8 BIT 7,(IY+$0A) ; {Test the overlap when bit 7 of byte #N$0A is clear.
 $B2DC CALL Z,$B2EB   ; }
 $B2DF LD DE,$0014    ; {Step on to the next record.
 $B2E2 ADD IY,DE      ; }
 $B2E4 POP AF         ; {Repeat for the remaining records.
 $B2E5 DEC A          ;
 $B2E6 JR NZ,$B2D7    ; }
 $B2E8 POP IY         ; Restore the record that was in use.
 $B2EA RET            ; Return.

; Test Record Overlap
;
; Used by the routines at #R$B06E and #R$B2CC.
; .
; Tests whether the entity in #REGix overlaps the #N$14-byte record in
; #REGiy. If it does then bit 7 of field #N$0A of the record is set.
;
; IX The entity
; IY The #N$14-byte record
;
; The record's drawing position, plus its third size, has to meet the
; entity on z. The addresses in bytes #N$10 and #N$12 then have to meet it
; on x and y.
@label=TestRecordOverlap
c$B2EB LD B,$00       ; Start with no high byte.
 $B2ED LD H,(IY+$08)  ; {Read the record's drawing position.
 $B2F0 LD L,(IY+$09)  ; }
 $B2F3 LD C,(IY+$0D)  ; {Add the third size and step back one.
 $B2F6 ADD HL,BC      ;
 $B2F7 DEC HL         ; }
 $B2F8 LD D,(IX+$08)  ; {Subtract the entity's z.
 $B2FB LD E,(IX+$09)  ; }
 $B2FE XOR A          ; {No overlap when the record is below the entity on z.
 $B2FF SBC HL,DE      ;
 $B301 RET C          ; }
 $B302 LD A,(IX+$0D)  ; {Add the z extent to that z.
 $B305 ADD A,E        ;
 $B306 LD E,A         ; }
 $B307 JR NC,$B30A    ; {Count the carry in the high byte.
 $B309 INC D          ; }
@label=TestRecordOverlap_X
*$B30A LD H,(IX+$02)  ; {Subtract it from the entity's x.
 $B30D LD L,(IX+$03)  ;
 $B310 AND A          ;
 $B311 SBC HL,DE      ; }
 $B313 LD D,(IY+$10)  ; {Subtract the address in bytes #N$10 and #N$11.
 $B316 LD E,(IY+$11)  ; }
 $B319 XOR A          ; {The entity is on the far side of that address.
 $B31A SBC HL,DE      ;
 $B31C JR C,$B327     ; }
 $B31E OR H           ; {No overlap when it is a byte or more past the address.
 $B31F RET NZ         ; }
 $B320 LD A,L         ; {No overlap when the gap is at least byte 4 of the
 $B321 SUB (IY+$04)   ; record.
 $B324 RET NC         ; }
 $B325 JR $B333       ; Join the y test.
@label=TestRecordOverlap_MissX
*$B327 INC H          ; {No overlap when the miss is a byte or more the other
 $B328 RET NZ         ; way.}
 $B329 LD A,L         ; {The x extent reaches the address.
 $B32A ADD A,(IX+$0B) ;
 $B32D JR C,$B333     ; }
 $B32F ADD A,(IX+$0D) ; The z extent reaches it too.
 $B332 RET NC         ; No overlap when it still falls short.
@label=TestRecordOverlap_Y
*$B333 LD D,(IX+$08)  ; {Add the entity's z to its y.
 $B336 LD E,(IX+$09)  ;
 $B339 LD H,(IX+$05)  ;
 $B33C LD L,(IX+$06)  ;
 $B33F ADD HL,DE      ; }
 $B340 LD D,(IY+$12)  ; {Subtract the address in bytes #N$12 and #N$13.
 $B343 LD E,(IY+$13)  ;
 $B346 XOR A          ;
 $B347 SBC HL,DE      ; }
 $B349 JR C,$B354     ; The entity is on the far side of that address.
 $B34B OR H           ; {No overlap when it is a byte or more past the address.
 $B34C RET NZ         ; }
 $B34D LD A,L         ; {No overlap when the gap is at least byte 7 of the
 $B34E SUB (IY+$07)   ; record.
 $B351 RET NC         ; }
 $B352 JR $B360       ; Join the column test.
@label=TestRecordOverlap_MissY
*$B354 INC H          ; {No overlap when the miss is a byte or more the other
 $B355 RET NZ         ; way.}
 $B356 LD A,L         ; {The y extent reaches the address.
 $B357 ADD A,(IX+$0C) ;
 $B35A JR C,$B360     ; }
 $B35C ADD A,(IX+$0D) ; The z extent reaches it too.
 $B35F RET NC         ; No overlap when it still falls short.
; The column is tested against the record's origin, shifted by how far
; the view origin has moved. The width is the sprite width in bytes times
; eight, and the range is the two sizes or #N$20, whichever is larger.
@label=TestRecordOverlap_Range
*$B360 LD B,(IY+$00)  ; {Read the record's origin.
 $B363 LD C,(IY+$01)  ; }
 $B366 LD DE,($5CE7)  ; Fetch the view origin.
 $B36A LD HL,($B16A)  ; Fetch the origin kept for the items.
 $B36D XOR A          ; {Subtract the kept origin.
 $B36E SBC HL,DE      ; }
 $B370 ADD HL,BC      ; Add the record's origin.
 $B371 LD D,$80       ; {Measure the column from page #N$80.
 $B373 LD E,(IX+$0E)  ; }
 $B376 LD A,(IX+$16)  ; Read the sprite width.
 $B379 AND %00001111  ; Use the low nibble.
 $B37B ADD A,A        ; {Turn the width into pixels, eight per byte.
 $B37C ADD A,A        ;
 $B37D ADD A,A        ;
 $B37E LD B,A         ; }
 $B37F LD A,(IY+$0B)  ; {Add the two sizes.
 $B382 ADD A,(IY+$0C) ;
 $B385 JR NC,$B389    ; }
 $B387 LD A,$FF       ; Use #N$FF when the sizes overflow.
@label=TestRecordOverlap_Minimum
*$B389 CP $20         ; {Use at least #N$20.
 $B38B JR NC,$B38F    ; }
 $B38D LD A,$20       ; The minimum size is #N$20.
@label=TestRecordOverlap_Column
*$B38F LD C,A         ; {Test the column against that range.
 $B390 CALL $B3B9     ; }
 $B393 RET NZ         ; Return when the column is outside it.
 $B394 SET 7,(IY+$0A) ; Mark the record as overlapping.
 $B398 RET            ; Return.

; Collect Overlapping Item
;
; Used by the routine at #R$B06E.
; .
; Adds the entity in #REGix to the table of overlapping items that is
; being built by #R$B06E. Four bytes are stored: the screen position from
; fields #N$0E and #N$0F, the width from field #N$16 (times eight) and the
; height from field #N$17.
;
;   IX The entity
;   HL' Pointer to the next free entry in the table
;   C' The number of entries
; O:HL' Updated pointer
@label=CollectOverlappingItem
c$B399 EXX           ; Keep the table pointer aside.
 $B39A LD E,(IX+$0E) ; {The column and the row.
 $B39D LD D,(IX+$0F) ; }
 $B3A0 LD A,(IX+$16) ; {The width, times eight.
 $B3A3 LD B,(IX+$17) ;
 $B3A6 AND $0F       ;
 $B3A8 ADD A,A       ;
 $B3A9 ADD A,A       ;
 $B3AA ADD A,A       ; }
 $B3AB LD (HL),E     ; {Write the column, the row and the width.
 $B3AC INC HL        ;
 $B3AD LD (HL),D     ;
 $B3AE INC HL        ;
 $B3AF LD (HL),A     ;
 $B3B0 INC HL        ; }
 $B3B1 LD A,B        ; {The height, without the shape flags.
 $B3B2 AND $3F       ;
 $B3B4 LD (HL),A     ;
 $B3B5 INC HL        ; }
 $B3B6 INC C         ; Count this item.
 $B3B7 EXX           ; Bring the table pointer back.
 $B3B8 RET           ; Return.

; Test Range
;
; Used by the routine at #R$B2EB.
; .
; Tests whether a position falls within a range. The zero flag is set
; when it does.
;
;   HL The position
;   DE The column address
;   B The width
;   C The size
; O:F The zero flag is set when the position is inside the range
;
; #REGhl is the position and #REGde the column address. #REGb is the width
; and #REGc the size. The zero flag is set when the position is inside.
@label=TestRange
c$B3B9 SBC HL,DE     ; Subtract the column address from the position.
 $B3BB JR C,$B3C5    ; The position is below the column address.
 $B3BD LD C,B        ; {Test the width on this side.
 $B3BE LD B,$00      ; }
 $B3C0 SBC HL,BC     ; Subtract the width.
 $B3C2 RET NC        ; Outside the range when the position is past the width.
 $B3C3 XOR A         ; Inside the range.
 $B3C4 RET           ; Return.
@label=TestRange_Low
*$B3C5 LD B,$00      ; The size is a single byte.
 $B3C7 ADD HL,BC     ; Add the size to the shortfall.
 $B3C8 RET NC        ; Outside the range when the size falls short.
 $B3C9 XOR A         ; Inside the range.
 $B3CA RET           ; Return.

; Build Patterned Sprite
;
; Used by the routine at #R$B43C.
; .
; Builds a copy of a sprite in the buffer at #N$5B70 for an entity whose
; sprite has a pattern. The pattern is chosen by the entity and by the frame
; counter at #R$A2DD, taken from the table at #R$B416, and each pair of bytes
; of the sprite is combined with a rotating mask from the table.
;
;   A Bits 4-7 of field #N$16 of the entity, shifted
;   DE The address of the sprite
; O:DE The address of the buffer
;
; The countdown nibble, already shifted down, selects the pattern. The
; low bits of the frame counter choose which mask, and which way it rotates.
@label=BuildPatternedSprite
c$B3CB RRA           ; {The pattern index is the countdown nibble, less four.
 $B3CC RRA           ;
 $B3CD SUB $04       ; }
 $B3CF LD B,A        ; Keep the index.
 $B3D0 LD A,($A2DD)  ; Read the frame counter.
 $B3D3 AND %00000011 ; Use its low two bits.
 $B3D5 OR B          ; Combine them with the index.
 $B3D6 LD HL,$B416   ; {Look the mask up in the pattern table.
 $B3D9 CALL $AA3C    ; }
 $B3DC LD C,(HL)     ; Read the mask.
 $B3DD EX DE,HL      ; The sprite is the source.
 $B3DE LD A,($A2DD)  ; Read the frame counter again.
 $B3E1 AND %00000001 ; Use its low bit.
 $B3E3 ADD A,A       ; {Turn that bit into a rotate one way or the other.
 $B3E4 ADD A,A       ;
 $B3E5 ADD A,A       ;
 $B3E6 INC A         ; }
 $B3E7 LD ($B40B),A  ; Patch the rotate below with it.
 $B3EA LD B,(HL)     ; {Remember the sprite's width and height at the front of
 $B3EB INC HL        ; the buffer.
 $B3EC LD E,(HL)     ;
 $B3ED LD A,B        ;
 $B3EE LD ($5B70),A  ;
 $B3F1 LD A,E        ;
 $B3F2 LD ($5B71),A  ; }
 $B3F5 XOR A         ; {Move on to the sprite data and clear the total.
 $B3F6 INC HL        ; }
@label=BuildPatternedSprite_Width
*$B3F7 ADD A,E       ; {Add the width once for every row.
 $B3F8 DJNZ $B3F7    ; }
 $B3FA LD B,A        ; The total is the number of byte pairs.
 $B3FB LD ($5CDA),SP ; {Remember the stack and read the sprite through it.
 $B3FF LD SP,HL      ; }
 $B400 LD HL,$5B72   ; The masked copy is built just after the width and
                     ; height.
@label=BuildPatternedSprite_Pairs
*$B403 POP DE        ; {Copy one byte and mask its partner.
 $B404 LD (HL),E     ;
 $B405 INC HL        ;
 $B406 LD A,D        ;
 $B407 AND C         ;
 $B408 LD (HL),A     ; }
 $B409 INC HL        ; Move on to the next pair.
 $B40A RRC C         ; {Rotate the mask and repeat for the remaining pairs.
 $B40C DJNZ $B403    ; }
 $B40E LD SP,($5CDA) ; Restore the stack pointer.
 $B412 LD DE,$5B70   ; Return the buffer, width and height included.
 $B415 RET           ; Return.

; Pattern Table
;
; The first #N$10 bytes are masks for #R$B3CB. Purpose of the other bytes
; is not yet known.
@label=PatternTable
b$B416 DEFB $00,$01,$00,$10,$08,$40,$10,$02
 $B41E DEFB $09,$A0,$12,$44,$89,$25,$62,$58
 $B426 DEFB $4D,$D2,$35,$6A,$AD,$73,$5B,$B6
 $B42E DEFB $AF,$ED,$77,$BE,$EF,$FD,$BE,$F7

; Draw Entity Item
;
; Used by the routine at #R$B06E.
; .
; Draws an item from the draw list that is an entity, and then moves on to
; the next item.
;
; IX The entity
@label=DrawEntityItem
c$B436 CALL $B43C    ; Call #R$B43C.
 $B439 JP $B0C1      ; Jump to #R$B0C1.

; Draw Sprite
;
; Used by the routine at #R$B436.
; .
; Draws the sprite of an entity into the screen buffer, which is #N$18
; bytes wide. The sprite data is read by using the stack pointer, and the sprite
; is drawn by one of the row routines in the table at #R$ADE9, which is chosen
; using the width of the sprite and whether it is shifted by the low bits of
; the column. The addresses of the row routine and the step to
; the previous row are written into the drawing code before it is entered. If
; the sprite goes beyond the top of the screen buffer, the rows that are not
; needed are skipped.
;
; IX The entity
@label=DrawSprite
c$B43C CALL $6653    ; Find the sprite.
 $B43F LD A,(IX+$16) ; Read the width byte.
 $B442 AND %11110000 ; Use the countdown nibble.
 $B444 CALL NZ,$B3CB ; Build a patterned copy when that nibble is set.
 $B447 LD ($5CDA),SP ; Remember the stack pointer.
 $B44B LD HL,$ADE7   ; Use the row-routine table.
 $B44E LD A,(IX+$0E) ; Read the column.
 $B451 AND %00000110 ; Use bits 1-2 as the shift.
 $B453 LD C,A        ; Keep the shift.
 $B454 LD A,(DE)     ; Read the sprite's width.
 $B455 LD ($B4A7),A  ; Give the width to the skip loop.
 $B458 LD B,A        ; Keep the width.
 $B459 JR Z,$B45E    ; {A shifted sprite uses the next routine and one more
 $B45B ADD A,$04     ; byte.
 $B45D INC B         ; }
@label=DrawSprite_Index
*$B45E ADD A,A       ; Double the width to make a table index.
 $B45F CALL $AA3C    ; Look the row routine up.
 $B462 LD A,(HL)     ; {Read the routine's address.
 $B463 INC HL        ;
 $B464 LD H,(HL)     ;
 $B465 LD L,A        ; }
 $B466 LD ($B4BA),HL ; {Give the routine and the row step to the drawers.
 $B469 LD ($B4BE),HL ;
 $B46C LD ($B4E1),HL ;
 $B46F LD ($B534),HL ;
 $B472 LD ($B539),HL ; }
 $B475 INC DE        ; Move on to the sprite data.
 $B476 LD A,B        ; {The step back across a row is the width plus #N$17.
 $B477 ADD A,$17     ;
 $B479 LD ($B530),A  ; }
 $B47C NEG           ; {The other step is the opposite of that width.
 $B47E LD ($B4DC),A  ; }
 $B481 LD L,(IX+$18) ; {Fetch the screen address.
 $B484 LD H,(IX+$19) ; }
 $B487 EX DE,HL      ; Keep the sprite address aside.
 $B488 LD A,(HL)     ; {Read how many rows the sprite has.
 $B489 LD B,A        ; }
 $B48A EX AF,AF'     ; Remember that count.
 $B48B LD A,(IX+$0F) ; {The first row to draw is one past the entity's row.
 $B48E INC A         ; }
 $B48F INC HL        ; {Read the sprite through the stack.
 $B490 LD SP,HL      ; }
 $B491 CP B          ; {Clip the sprite when its rows end above the view.
 $B492 JP NC,$B49A   ; }
 $B495 LD B,A        ; The row count is that first row.
 $B496 EX AF,AF'     ; Bring the sprite's row count back.
 $B497 JP $B4B1      ; Draw the sprite.
@label=DrawSprite_Clip
*$B49A SUB $80       ; {A count below #N$80 is drawn whole.
 $B49C JP C,$B4B1    ; }
 $B49F JP Z,$B4B1    ; A count of exactly #N$80 is drawn whole.
 $B4A2 LD B,A        ; The rows above the view are the excess.
 $B4A3 EX AF,AF'     ; Bring the sprite's row count back.
 $B4A4 SUB B         ; {Drop the rows that are off the view.
 $B4A5 EX AF,AF'     ; }
*$B4A6 LD B,$00      ; Skip one row of the sprite.
*$B4A8 POP HL        ; {Skip the bytes of that row.
 $B4A9 DJNZ $B4A8    ; }
 $B4AB DEC A         ; {Repeat for the remaining rows above the view.
 $B4AC JR NZ,$B4A6   ; }
 $B4AE EX AF,AF'     ; Bring the rows that are in view back.
 $B4AF LD B,A        ; {Use that as the row count.
 $B4B0 EX AF,AF'     ; }
*$B4B1 LD A,C        ; Read the shift.
 $B4B2 AND A         ; {An unshifted sprite is drawn directly.
 $B4B3 JR Z,$B4BC    ; }
 $B4B5 ADD A,$F8     ; {A shifted sprite uses the page selected by the shift.
 $B4B7 LD H,A        ;
 $B4B8 LD A,(DE)     ; }
*$B4B9 JP $B4B9      ; Draw the shifted rows. The target is patched.
*$B4BC EX DE,HL      ; Put the screen address in #REGhl.
*$B4BD JP $B4BD      ; Draw the unshifted rows. The target is patched.

; Draw Unshifted Rows
;
; Draws the rows of a sprite that is not shifted, using the stack pointer
; to read the sprite data. Each pair of sprite bytes is a mask byte and a
; picture byte, and these are combined with the screen buffer. There are four
; entry points, which are for widths of four, three, two and one bytes. The
; address in the table at #R$ADE9 is the entry point for the width.
;
; HL The address in the screen buffer
; B The number of rows
; SP The sprite data
@label=DrawUnshiftedRows
c$B4C0 POP DE        ; {Draw one byte of the sprite.
 $B4C1 LD A,E        ;
 $B4C2 CPL           ;
 $B4C3 AND (HL)      ;
 $B4C4 OR D          ;
 $B4C5 LD (HL),A     ;
 $B4C6 INC HL        ; }
@label=DrawUnshiftedRows_Three
 $B4C7 POP DE        ; {Draw one byte of the sprite.
 $B4C8 LD A,E        ;
 $B4C9 CPL           ;
 $B4CA AND (HL)      ;
 $B4CB OR D          ;
 $B4CC LD (HL),A     ;
 $B4CD INC HL        ; }
@label=DrawUnshiftedRows_Two
 $B4CE POP DE        ; {Draw one byte of the sprite.
 $B4CF LD A,E        ;
 $B4D0 CPL           ;
 $B4D1 AND (HL)      ;
 $B4D2 OR D          ;
 $B4D3 LD (HL),A     ;
 $B4D4 INC HL        ; }
; This entry point is used by the routine at #R$A692.
@label=DrawUnshiftedRows_One
*$B4D5 POP DE        ; {Draw the last byte of the sprite.
 $B4D6 LD A,E        ;
 $B4D7 CPL           ;
 $B4D8 AND (HL)      ;
 $B4D9 OR D          ;
 $B4DA LD (HL),A     ; }
@label=DrawUnshiftedRows_Next
*$B4DB LD DE,$FF00   ; {Move to the next row of the screen buffer.
 $B4DE ADD HL,DE     ; }
 $B4DF DEC B         ; {Repeat for the remaining rows.
 $B4E0 JP NZ,$B4DB   ; }
 $B4E3 LD SP,($5CDA) ; Restore the stack pointer.
 $B4E7 RET           ; Return.

; Draw Shifted Rows
;
; Draws the rows of a sprite that is shifted by one to three pixels, using
; the stack pointer to read the sprite data. The shifted bytes are found in the
; tables that start at the page in #REGh, and one more byte than the width is
; drawn. There are four entry points, which are for widths of four, three, two
; and one bytes. The address in the table at #R$ADE9 is the entry point for the
; width.
;
; DE The address in the screen buffer
; H The page of the table for the shift
; B The number of rows
; SP The sprite data
@label=DrawShiftedRows
c$B4E8 POP BC        ; {Draw one byte of the shifted sprite.
 $B4E9 LD L,C        ;
 $B4EA AND (HL)      ;
 $B4EB LD L,B        ;
 $B4EC XOR (HL)      ;
 $B4ED CPL           ;
 $B4EE LD (DE),A     ;
 $B4EF INC DE        ;
 $B4F0 INC H         ;
 $B4F1 LD L,C        ;
 $B4F2 LD A,(DE)     ;
 $B4F3 AND (HL)      ;
 $B4F4 LD L,B        ;
 $B4F5 XOR (HL)      ;
 $B4F6 CPL           ;
 $B4F7 DEC H         ; }
@label=DrawShiftedRows_Three
 $B4F8 POP BC        ; {Draw one byte of the shifted sprite.
 $B4F9 LD L,C        ;
 $B4FA AND (HL)      ;
 $B4FB LD L,B        ;
 $B4FC XOR (HL)      ;
 $B4FD CPL           ;
 $B4FE LD (DE),A     ;
 $B4FF INC DE        ;
 $B500 INC H         ;
 $B501 LD L,C        ;
 $B502 LD A,(DE)     ;
 $B503 AND (HL)      ;
 $B504 LD L,B        ;
 $B505 XOR (HL)      ;
 $B506 CPL           ;
 $B507 DEC H         ; }
; This entry point is used by the routine at #R$C76D.
@label=DrawShiftedRows_Two
*$B508 POP BC        ; {Draw one byte of the shifted sprite.
 $B509 LD L,C        ;
 $B50A AND (HL)      ;
 $B50B LD L,B        ;
 $B50C XOR (HL)      ;
 $B50D CPL           ;
 $B50E LD (DE),A     ;
 $B50F INC DE        ;
 $B510 INC H         ;
 $B511 LD L,C        ;
 $B512 LD A,(DE)     ;
 $B513 AND (HL)      ;
 $B514 LD L,B        ;
 $B515 XOR (HL)      ;
 $B516 CPL           ;
 $B517 DEC H         ; }
; This entry point is used by the routine at #R$A692.
@label=DrawShiftedRows_One
*$B518 POP BC        ; {Draw one byte of the shifted sprite.
 $B519 LD L,C        ;
 $B51A AND (HL)      ;
 $B51B LD L,B        ;
 $B51C XOR (HL)      ;
 $B51D CPL           ;
 $B51E LD (DE),A     ;
 $B51F INC DE        ;
 $B520 INC H         ;
 $B521 LD L,C        ;
 $B522 LD A,(DE)     ;
 $B523 AND (HL)      ;
 $B524 LD L,B        ;
 $B525 XOR (HL)      ;
 $B526 CPL           ;
 $B527 DEC H         ; }
; The row count is held in the alternate accumulator. The width subtracted
; below, and the two jumps, are patched before the routine is entered.
@label=DrawShiftedRows_Store
 $B528 LD (DE),A     ; Write the prepared byte.
 $B529 EX AF,AF'     ; {Count a row, and finish when none remain.
 $B52A DEC A         ;
 $B52B JR Z,$B53B    ; }
 $B52D EX AF,AF'     ; Bring the sprite byte back.
 $B52E LD A,E        ; {Step back by the patched width.
 $B52F SUB $00       ;
 $B531 LD E,A        ; }
 $B532 LD A,(DE)     ; Read the first byte of the next row.
@label=DrawShiftedRows_Step
*$B533 JP NC,$B533   ; Stay on this page if the step did not borrow.
 $B536 DEC D         ; {Move to the previous page and read its byte.
 $B537 LD A,(DE)     ; }
@label=DrawShiftedRows_Patched
*$B538 JP $B538      ; Draw the next row. The target is patched.
@label=DrawShiftedRows_Return
*$B53B LD SP,($5CDA) ; Restore the stack pointer.
 $B53F RET           ; Return.

; Entities
;
; The entities. There are #N$0C of them, each of #N$26 bytes, and the
; first is the player. Field #N$00 is the type, which is zero when the entity
; is not in use. Field #N$01 is the frame, and its bit 7 hides the entity.
; Fields #N$02 and #N$03 are the x coordinate, #N$05 and #N$06 the y coordinate
; and #N$08 to #N$0A the z coordinate. Field #N$0B is the extent on the x axis,
; #N$0C the extent on the y axis and #N$0D the extent on the z axis. Field
; #N$0E is the column on the screen, #N$0F the row and #N$11 the heading.
; Field #N$10 is the speed, with the current speed in bits 0-3 and the maximum
; in bits 4-7. Field #N$1E holds the flags. Bit 7 is set when the entity is
; moving fast. Bit 6 selects the higher frame when #R$B7CE builds the extra
; record, and is tested again by #R$D7E4. Purpose of bit 6 is not yet known.
@label=Entities
g$B540 DEFB $01,$20,$20,$70,$00,$20,$70,$00,$01,$00,$00,$0C,$0C,$05,$00,$00,$30,$00,$00,$00,$FF,$B0,$03,$0E,$00,$00,$00,$40,$04,$10,$00,$00,$00,$00,$00,$00,$00,$00
@label=EntitiesEntity_01
 $B566 DEFB $00,$80,$21,$80,$00,$20,$B0,$00,$01,$00,$00,$08,$08,$08,$00,$00,$20,$00,$00,$00,$FF,$B0,$02,$14,$00,$00,$00,$10,$04,$00,$00,$00,$00,$00,$00,$0F,$00,$00
 $B58C DEFB $00,$80,$21,$80,$00,$20,$B0,$00,$01,$00,$00,$08,$08,$08,$00,$00,$20,$00,$00,$00,$FF,$B0,$02,$14,$00,$00,$00,$10,$04,$00,$00,$00,$00,$00,$00,$0F,$00,$00
@label=EntitiesEntity_03
 $B5B2 DEFB $00,$80,$21,$80,$00,$20,$B0,$00,$01,$00,$00,$08,$08,$08,$00,$00,$20,$00,$00,$00,$FF,$B0,$02,$14,$00,$00,$00,$10,$04,$00,$00,$00,$00,$00,$00,$0F,$00,$00
 $B5D8 DEFB $00,$80,$21,$80,$00,$20,$B0,$00,$01,$00,$00,$08,$08,$08,$00,$00,$20,$00,$00,$00,$FF,$B0,$02,$14,$00,$00,$00,$10,$04,$00,$00,$00,$00,$00,$00,$0F,$00,$00
@label=EntitiesEntity_05
 $B5FE DEFB $00,$A0,$00,$00,$00,$00,$00,$00,$00,$00,$00,$02,$02,$02,$00,$00,$00,$00,$00,$00,$00,$00,$01,$06,$00,$00,$00,$00,$F4,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $B624 DEFB $00,$A0,$00,$00,$00,$00,$00,$00,$00,$00,$00,$02,$02,$02,$00,$00,$00,$00,$00,$00,$00,$00,$01,$06,$00,$00,$00,$00,$F4,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $B64A DEFB $00,$A0,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
@label=EntitiesEntity_08
 $B670 DEFB $00,$80,$00,$00,$00,$00,$00,$00,$01,$00,$00,$10,$10,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $B696 DEFB $00,$80,$00,$00,$00,$00,$00,$00,$01,$00,$00,$10,$10,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $B6BC DEFB $00,$80,$00,$00,$00,$00,$00,$00,$01,$00,$00,$10,$10,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $B6E2 DEFB $00,$80,$00,$00,$00,$00,$00,$00,$01,$00,$00,$10,$10,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00

; Extra Records
;
; One extra record of #N$0D bytes for each of the entities. Bit 7 of field
; #N$09 is set while the record is in use. Fields #N$00 and #N$01 are the
; column and the row. #R$B7CE writes the adjusted x coordinate to fields #N$02
; and #N$03, the adjusted y coordinate to fields #N$04 and #N$05, and the
; adjusted z coordinate to fields #N$06 and #N$07. Field #N$0B holds the width
; in bits 0-3 and the frame in bits 4-7. Field #N$0C holds the height in bits
; 0-5, and its bit 7 copies bit 6 of the entity flags.
@label=ExtraRecords
g$B708 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $B715 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $B722 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $B72F DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $B73C DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $B749 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $B756 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $B763 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $B770 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $B77D DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $B78A DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $B797 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00

; Temporary Entity
;
; A temporary entity that is built from an extra record or a #N$14-byte
; record so that it can be drawn like an entity.
@label=TemporaryEntity
g$B7A4 DEFB $02,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$03,$03,$01,$00,$00,$00,$00,$00,$00,$00,$00,$02,$08,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $B7CA DEFB $00,$00,$00,$00

; Update Extra Record
;
; Used by the routine at #R$CE84.
; .
; Builds the extra record for an entity, and fills the temporary entity at
; #R$B7A4 so that #R$AF21 can measure its sprite. Field #N$1F chooses the size
; class: below #N$17 is class 0, below #N$25 is class 1, and any higher value
; is class 2. A size index of zero or #N$FF leaves the record unset.
; .
; Bit 6 of the flags in field #N$1E selects the higher frame. The frame
; written for the temporary entity is the class when the bit is clear, and the
; class plus three when it is set. The same bit is copied into bit 7 of byte
; #N$0C of the extra record. Purpose of the flag beyond that choice is not yet
; known. The instructions at #R$B7F8 would step the shape bits of the height
; and then start a burst, but they are not reached: the class is only 0, 1 or
; 2, so the jump at #R$B7F6 is always taken. The saved zero flag then makes the
; height adjustment subtract field #N$1F rather than add the z extent.
; .
; The adjusted x coordinate is the entity's x plus half of field #N$0B,
; its x extent, and the adjusted y coordinate is the entity's y plus half of
; field #N$0C, its y extent. Both are reduced by a margin taken from the class.
; The z coordinate is the entity's z less field #N$1F, or #N$0100 when that
; would leave the high byte zero. Bytes #N$02 and #N$03 of the extra record
; receive the adjusted x, bytes #N$04 and #N$05 the adjusted y, and bytes
; #N$06 and #N$07 the adjusted z. Byte #N$0B holds the width in bits 0-3 and
; the frame in bits 4-7. Byte #N$0C holds the height in bits 0-5.
;
;   IX The entity
;   IY The extra record
; O:A Zero if the record was set up, otherwise non-zero
;
; Leave the record unset when the size index is zero or #N$FF.
@label=UpdateExtraRecord
c$B7CE LD A,(IX+$1F)   ; Fetch the size index.
 $B7D1 AND A           ; {Jump to #R$B7D7 if the size index is not zero.
 $B7D2 JR NZ,$B7D7     ; }
@label=UpdateExtraRecord_Return
*$B7D4 OR %00000001    ; Report that the record was not set up.
 $B7D6 RET             ; Return.
@label=UpdateExtraRecord_Start
*$B7D7 INC A           ; Advance the size index.
 $B7D8 JR Z,$B7D4      ; Leave the record unset if the size index was #N$FF.
 $B7DA LD D,$00        ; Take class 0.
 $B7DC CP $18          ; {Use class 0 when the size index is below #N$17.
 $B7DE JR C,$B7E6      ; }
 $B7E0 INC D           ; Take the next class.
 $B7E1 CP $26          ; {Use class 1 when the size index is below #N$25.
 $B7E3 JR C,$B7E6      ; }
 $B7E5 INC D           ; Take class 2.
; Remember a clear zero flag, so the height adjustment later subtracts the
; size index. Then choose the higher frame when bit 6 of the flags is set.
@label=UpdateExtraRecord_Class
*$B7E6 XOR A           ; Clear the alternate flags.
 $B7E7 EX AF,AF'       ; Save the alternate flags.
 $B7E8 LD A,D          ; Take the class as the frame.
 $B7E9 BIT 6,(IX+$1E)  ; {Jump to #R$B838 to keep this frame if bit 6 is clear.
 $B7ED JR Z,$B838      ; }
 $B7EF LD A,(IX+$1F)   ; Fetch the size index again.
 $B7F2 CP $05          ; Compare the size index with #N$05. The result is not
                       ; used.
 $B7F4 LD A,D          ; Take the class again.
 $B7F5 INC A           ; Advance to the higher frame.
@label=UpdateExtraRecord_HigherFrame
 $B7F6 JR NC,$B834     ; Use the higher frame. This jump is always taken.
; These instructions are not reached. They would cycle bits 6-7 of the
; height, play the medium buzz the first time, and start a burst when the
; cycle wraps, clearing bit 6 of the flags.
@label=UpdateExtraRecord_Unused
 $B7F8 EX AF,AF'       ; Restore the alternate flags.
 $B7F9 LD A,(IX+$17)   ; Fetch the height byte.
 $B7FC AND %11000000   ; Keep the shape bits of the height.
 $B7FE JR NZ,$B809     ; Step the shape if it has already started.
 $B800 SET 6,(IX+$17)  ; Set the first shape bit of the height.
 $B804 CALL $9F4E      ; Play the medium buzz.
 $B807 JR $B82B        ; Join the shape calculation.
@label=UpdateExtraRecord_Frame
*$B809 LD A,($A2DD)    ; Fetch the frame counter.
 $B80C AND %00000011   ; Act on every fourth frame.
 $B80E JR NZ,$B82B     ; Leave the shape as it is on the other frames.
 $B810 LD A,(IX+$17)   ; Fetch the height byte.
 $B813 ADD A,$40       ; Step the shape bits.
 $B815 JR NC,$B828     ; Store the new shape if it has not wrapped.
 $B817 CALL $9924      ; Start a burst.
 $B81A RES 6,(IX+$1E)  ; Clear bit 6 of the flags.
 $B81E RES 7,(IX+$17)  ; Clear the upper shape bit of the height.
 $B822 RES 6,(IX+$17)  ; Clear the lower shape bit of the height.
 $B826 JR $B7D4        ; Leave the record unset.
@label=UpdateExtraRecord_Store
*$B828 LD (IX+$17),A   ; Store the stepped height byte.
@label=UpdateExtraRecord_Shape
*$B82B LD A,(IX+$17)   ; Fetch the height byte.
 $B82E RLCA            ; {Move the shape bits down.
 $B82F RLCA            ; }
 $B830 NEG             ; Make the shape number negative.
 $B832 AND %00000011   ; Keep the two shape bits.
@label=UpdateExtraRecord_Size
*$B834 ADD A,$02       ; Move up by two frames from the shape, or from the
                       ; higher frame.
 $B836 LD D,$02        ; Use a fixed margin for the higher frame.
; Write the frame, then the x extent of the temporary entity, which is
; four times the complement of the class margin.
@label=UpdateExtraRecord_Position
*$B838 LD ($B7A5),A    ; Store the frame in the temporary entity.
 $B83B LD A,D          ; Take the class, or the fixed margin of the higher
                       ; frame.
 $B83C ADD A,$FC       ; Subtract four.
 $B83E CPL             ; Complement the margin.
 $B83F ADD A,A         ; Double the margin.
 $B840 LD D,A          ; Keep the doubled margin.
 $B841 ADD A,A         ; Double it again.
 $B842 LD ($B7AF),A    ; Store the x extent of the temporary entity.
; Move the x coordinate by half of the x extent, less the margin.
 $B845 LD H,(IX+$02)   ; Fetch the high byte of the x coordinate.
 $B848 LD L,(IX+$03)   ; Fetch the low byte of the x coordinate.
 $B84B LD A,(IX+$0B)   ; Fetch the x extent.
 $B84E SRL A           ; Halve the x extent.
 $B850 DEC A           ; Reduce it by one.
 $B851 SUB D           ; Subtract the margin.
 $B852 LD C,A          ; Keep the adjustment.
 $B853 LD B,$00        ; Take a positive adjustment.
 $B855 JR NC,$B859     ; Keep the positive adjustment.
 $B857 LD B,$FF        ; Take a negative adjustment.
@label=UpdateExtraRecord_AddX
*$B859 ADD HL,BC       ; Add the adjustment to the x coordinate.
 $B85A LD A,L          ; {Swap the bytes of the x coordinate.
 $B85B LD L,H          ;
 $B85C LD H,A          ; }
 $B85D LD ($B7A6),HL   ; Store the adjusted x coordinate in the temporary
                       ; entity.
 $B860 LD (IY+$02),L   ; Store the high byte of the adjusted x coordinate in the extra
                       ; record.
 $B863 LD (IY+$03),H   ; Store the low byte of the adjusted x coordinate in the
                       ; extra record.
; Move the y coordinate by half of the y extent, less the same margin.
 $B866 LD H,(IX+$05)   ; Fetch the high byte of the y coordinate.
 $B869 LD L,(IX+$06)   ; Fetch the low byte of the y coordinate.
 $B86C LD A,(IX+$0C)   ; Fetch the y extent.
 $B86F SRL A           ; Halve the y extent.
 $B871 DEC A           ; Reduce it by one.
 $B872 SUB D           ; Subtract the margin.
 $B873 LD B,$00        ; Take a positive adjustment.
 $B875 JR NC,$B879     ; Keep the positive adjustment.
 $B877 LD B,$FF        ; Take a negative adjustment.
@label=UpdateExtraRecord_AddY
*$B879 ADD HL,BC       ; Add the adjustment to the y coordinate.
 $B87A LD A,L          ; {Swap the bytes of the y coordinate.
 $B87B LD L,H          ;
 $B87C LD H,A          ; }
 $B87D LD ($B7A9),HL   ; Store the adjusted y coordinate in the temporary
                       ; entity.
 $B880 LD (IY+$04),L   ; Store the high byte of the adjusted y coordinate in the extra
                       ; record.
 $B883 LD (IY+$05),H   ; Store the low byte of the adjusted y coordinate in the
                       ; extra record.
; Lower the z coordinate by the size index. The saved zero flag makes
; this the path that is taken. The other path would add the z extent.
 $B886 LD H,(IX+$08)   ; Fetch the top byte of the z coordinate.
 $B889 LD L,(IX+$09)   ; Fetch the middle byte of the z coordinate.
 $B88C LD D,$00        ; Clear the high byte of the subtraction.
 $B88E EX AF,AF'       ; Restore the saved zero flag.
 $B88F JR Z,$B897      ; Subtract the size index. This jump is always taken.
 $B891 LD E,(IX+$0D)   ; Fetch the z extent.
 $B894 ADD HL,DE       ; Add the z extent. This path is not taken.
 $B895 JR $B8A3        ; Join the stored height.
@label=UpdateExtraRecord_Height
*$B897 LD E,(IX+$1F)   ; Fetch the size index.
 $B89A XOR A           ; Clear the carry.
 $B89B SBC HL,DE       ; Subtract the size index from the z coordinate.
 $B89D OR H            ; Test the high byte of the result.
 $B89E JR NZ,$B8A3     ; Keep the result when the high byte is not zero.
 $B8A0 LD HL,$0100     ; Use a height of #N$0100 when the result is zero.
@label=UpdateExtraRecord_Finish
*$B8A3 LD (IY+$06),H   ; Store the high byte of the adjusted z coordinate in the extra
                       ; record.
 $B8A6 LD (IY+$07),L   ; Store the low byte of the adjusted z coordinate in the
                       ; extra record.
 $B8A9 LD A,L          ; {Swap the bytes of the z coordinate.
 $B8AA LD L,H          ;
 $B8AB LD H,A          ; }
 $B8AC LD ($B7AC),HL   ; Store the adjusted z coordinate in the temporary
                       ; entity.
 $B8AF LD IX,$B7A4     ; Use the temporary entity.
 $B8B3 LD (IX+$17),$00 ; Clear the height byte of the temporary entity.
 $B8B7 CALL $AF21      ; Measure the sprite.
 $B8BA LD A,(IX+$01)   ; Fetch the frame of the temporary entity.
 $B8BD ADD A,A         ; {Move the frame into the high nibble.
 $B8BE ADD A,A         ;
 $B8BF ADD A,A         ;
 $B8C0 ADD A,A         ;
 $B8C1 LD B,A          ; }
 $B8C2 LD A,(IX+$16)   ; Fetch the width of the temporary entity.
 $B8C5 AND %00001111   ; Keep the width.
 $B8C7 OR B            ; Combine the frame with the width.
 $B8C8 LD (IY+$0B),A   ; Store the frame and the width in the extra record.
 $B8CB LD A,(IX+$17)   ; Fetch the height of the temporary entity.
 $B8CE AND %00111111   ; Keep the height.
 $B8D0 LD B,A          ; Keep the height aside.
 $B8D1 LD A,(IX+$1E)   ; Fetch the flags.
 $B8D4 ADD A,A         ; Move bit 6 of the flags up to bit 7.
 $B8D5 AND %10000000   ; Keep that bit.
 $B8D7 OR B            ; Combine it with the height.
 $B8D8 LD (IY+$0C),A   ; Store the height in the extra record.
 $B8DB XOR A           ; Report that the record was set up.
 $B8DC RET             ; Return.

; Add To High Byte
;
; Adds a value to the high byte of an address, carrying into the low byte.
;
;   A The value
;   HL The address
; O:HL The new address
@label=AddToHighByte
c$B8DD ADD A,H       ; Plus #REGh.
 $B8DE LD H,A        ; #REGa moves into #REGh.
 $B8DF RET NC        ; Return if the carry flag is reset.
 $B8E0 INC L         ; Advance #REGl.
 $B8E1 RET           ; Return.

; Convert Entity Position
;
; Used by the routines at #R$AC40 and #R$AD07.
; .
; Converts the screen position in fields #N$0E and #N$0F of an entity,
; which is limited to #N$7F in the high byte, to an address in the screen buffer
; with #R$E59E, and stores the address in fields #N$18 and #N$19.
;
; IX The entity
@label=ConvertEntityPosition
c$B8E2 LD H,(IX+$0F) ; Fetch the row into #REGh.
 $B8E5 LD L,(IX+$0E) ; Fetch the column into #REGl.
 $B8E8 LD A,H        ; #REGh moves into #REGa.
 $B8E9 CP $80        ; {Jump to #R$B8E2(#N$B8EF) if it is below #N$80.
 $B8EB JR C,$B8EF    ; }
 $B8ED LD H,$7F      ; #REGh is #N$7F.
@label=ConvertEntityPosition_Skip
*$B8EF CALL $E59E    ; Call #R$E59E.
 $B8F2 LD (IX+$18),L ; Write #REGl in field #N$18 of the entity.
 $B8F5 LD (IX+$19),H ; Write #REGh in field #N$19 of the entity.
 $B8F8 RET           ; Return.

; Move View
;
; Used by the routines at #R$C7E8 and #R$C873.
; .
; Moves the view by adding a value to #R$5CE2(#N$5CE4) and subtracting it
; from #R$5CEE and #R$5CE2.
;
; DE The amount
@label=MoveView
c$B8F9 LD HL,($5CE4) ; Fetch the word at #R$5CE2(#N$5CE4) into #REGhl.
 $B8FC ADD HL,DE     ; #REGhl takes #REGde.
 $B8FD LD ($5CE4),HL ; Write #REGhl at #R$5CE2(#N$5CE4).
 $B900 LD HL,($5CEE) ; Fetch the word at #R$5CEE into #REGhl.
 $B903 AND A         ; See whether #REGa is zero.
 $B904 SBC HL,DE     ; Subtract #REGde from #REGhl. (with the carry)
 $B906 LD ($5CEE),HL ; Write #REGhl at #R$5CEE.
 $B909 LD HL,($5CE2) ; Fetch the word at #R$5CE2 into #REGhl.
 $B90C AND A         ; See whether #REGa is zero.
 $B90D SBC HL,DE     ; Subtract #REGde from #REGhl. (with the carry)
 $B90F LD ($5CE2),HL ; Write #REGhl at #R$5CE2.
 $B912 RET           ; Return.

; Block Shape Table
;
; Purpose not yet known. The first bytes are used by #R$C15E(#N$C2FA),
; which uses the low seven bits of the byte for an entry to patch the drawing
; code, and bit 7 to patch the code as well.
@label=BlockShapeTable
b$B913 DEFB $00,$02,$04,$06,$86,$08,$88,$0A,$8A,$10,$12,$10,$12,$12,$10,$12
 $B923 DEFB $10,$1C,$0C,$8C,$22,$A2,$26,$28,$30,$2C,$2E,$A8,$08,$10,$F8,$10
 $B933 DEFB $08,$20,$11,$00,$00,$F0,$10,$F8,$10,$18,$08,$00,$F0,$10,$08,$10
 $B943 DEFB $18,$08,$10,$F0,$10,$08,$20,$19,$00,$F0,$F0,$10,$F8,$20,$19,$08
 $B953 DEFB $10,$E8,$10,$08,$20,$21,$00,$F0,$E8,$10,$F8,$20,$21,$00,$10,$F8
 $B963 DEFB $10,$00,$20,$09,$08,$10,$00,$10,$08,$20,$09,$00,$00,$F0,$F0,$08
 $B973 DEFB $10,$18,$08,$00,$F0,$10,$08,$10,$18,$00,$00,$F0,$F0,$08,$10,$18
 $B983 DEFB $08,$00,$F0,$10,$08,$10,$18,$08,$00,$F0,$F0,$F8,$10,$18,$00,$00
 $B993 DEFB $F0,$10,$F8,$10,$18,$08,$00,$F0,$F0,$F8,$10,$18,$00,$00,$F0,$10
 $B9A3 DEFB $F8,$10,$18,$00,$00,$F0,$00,$00,$20,$18,$18,$00,$10,$00,$00,$10
 $B9B3 DEFB $18,$18,$00,$10,$00,$00,$10,$18,$18,$00,$10,$00,$00,$10,$18,$18
 $B9C3 DEFB $00,$10,$00,$00,$10,$18,$08,$10,$F8,$10,$08,$20,$10,$08,$00,$F0
 $B9D3 DEFB $10,$08,$10,$18,$08,$10,$F8,$10,$08,$20,$10,$08,$10,$F8,$10,$08
 $B9E3 DEFB $20,$11,$08,$10,$F8,$10,$08,$20,$11,$00,$00,$F0,$10,$08,$10,$18

; Add Record Sizes
;
; Used by the routine at #R$C0E1.
; .
; Adds the size values at #R$5CF3 and #R$5CF3(#N$5CF4) to a value.
;
;   HL The value
; O:HL The value plus the sizes
@label=AddRecordSizes
c$B9F3 LD DE,($5CF3) ; {Add the low byte of the first size.
 $B9F7 LD D,$00      ;
 $B9F9 ADD HL,DE     ; }
 $B9FA LD A,($5CF4)  ; {Add the second size.
 $B9FD LD E,A        ;
 $B9FE ADD HL,DE     ; }
 $B9FF RET           ; Return.

; Get Size Offset
;
; Used by the routine at #R$C108.
; .
; Subtracts half of the second size at #R$5CF3(#N$5CF4), plus the third
; size at #R$5CF3(#N$5CF5), from the screen position at #R$BB9F(#N$BBA1).
;
; O:HL The result
@label=GetSizeOffset
c$BA00 LD HL,($BBA1) ; The screen position.
 $BA03 LD A,($5CF4)  ; {Half of the second size.
 $BA06 SRL A         ;
 $BA08 LD E,A        ; }
 $BA09 LD A,($5CF5)  ; {Add the third size.
 $BA0C ADD A,E       ;
 $BA0D LD E,A        ; }
 $BA0E LD D,$00      ; {Subtract that from the screen position.
 $BA10 AND A         ;
 $BA11 SBC HL,DE     ; }
 $BA13 RET           ; Return.

; Set Carry And Return
;
; Used by the routine at #R$BA16.
; .
; Sets the carry flag.
@label=SetCarryAndReturn
c$BA14 SCF           ; Set the carry flag.
 $BA15 RET           ; Return.

; Find Group
;
; Used by the routines at #R$BA70 and #R$D8E4.
; .
; Finds the group of objects at a position of the level, using the level
; map at the address in #R$5CFE and the table of groups at #R$8BB1.
;
;   H The vertical position, which starts at #N$20
;   L The horizontal position, which starts at #N$20
; O:IY The address of the group
; O:F Carry set if there is no group, or it has no objects
;
; Check that the position is inside the map, and find the cell of the map.
@label=FindGroup
c$BA16 LD IY,($5CFE) ; Fetch the address of the header of the level into
                     ; #REGiy.
 $BA1A LD A,L        ; Copy the horizontal position into #REGa.
 $BA1B SUB $20       ; Take away the border of #N$20 to make it a column of the
                     ; map.
 $BA1D RET C         ; Return if the position is left of the map.
 $BA1E LD C,A        ; Keep the column in #REGc.
 $BA1F CP (IY+$05)   ; Compare the column with the width of the map.
 $BA22 JR NC,$BA14   ; Return with no group if the position is right of the
                     ; map.
 $BA24 LD A,H        ; Copy the vertical position into #REGh.
 $BA25 SUB $20       ; Take away the border of #N$20 to make it a row of the
                     ; map.
 $BA27 RET C         ; Return if the position is above the map.
 $BA28 LD B,A        ; Keep the row in #REGb.
 $BA29 JR Z,$BA38    ; Jump to #R$BA38 if it is the first row.
 $BA2B CP (IY+$06)   ; Compare the row with the height of the map.
 $BA2E JR NC,$BA14   ; Return with no group if the position is below the map.
; Find the number of the cell by adding the width of the map once for each
; row, and then add that number of cells to the start of the map.
 $BA30 LD A,C        ; Start with the column.
 $BA31 LD D,(IY+$05) ; Fetch the width of the map.
@label=FindGroup_Loop
*$BA34 ADD A,D       ; Add the width of the map.
 $BA35 DJNZ $BA34    ; Decrease the row counter and loop back to #R$BA34 until all the rows
                     ; have been added.
 $BA37 LD C,A        ; Keep the number of the cell in #REGc.
@label=FindGroup_Row
*$BA38 SLA C         ; Double it, as there are two bytes for each cell.
 $BA3A ADD IY,BC     ; Add it to the address of the header, to reach the cell.
; Read the cell. Its first byte is returned as an offset, and its second
; is the number of the group.
 $BA3C LD E,B        ; Clear #REGe.
 $BA3D LD A,(IY+$07) ; Fetch the first byte of the cell, which starts #N$07 bytes after the
                     ; header.
 $BA40 LD D,A        ; Keep it in #REGd.
 $BA41 ADD A,$02     ; Add #N$02, which sets the carry flag if the byte is
                     ; #N$FE or #N$FF.
 $BA43 RET C         ; Return with no group if the cell has none.
 $BA44 LD C,(IY+$08) ; Fetch the number of the group from the second byte of
                     ; the cell.
 $BA47 SLA C         ; Double it, as the table has two bytes for each group.
 $BA49 LD HL,$8BB1   ; Point #REGhl at #R$8BB1.
 $BA4C ADD HL,BC     ; Add the offset to find the entry for the group.
 $BA4D LD C,(HL)     ; Fetch the low byte of the address of the group.
 $BA4E INC HL        ; Move onto the high byte.
 $BA4F LD B,(HL)     ; Fetch the high byte of the address of the group.
 $BA50 PUSH BC       ; Put the address of the group in #REGbc onto the stack...
 $BA51 POP IY        ; ...and take it off into #REGiy.
 $BA53 SRL D         ; Multiply the first byte of the cell by #N$80 by shifting
                     ; it...
 $BA55 RR E          ; ...across #REGde, ready to return it as an offset.
 $BA57 LD A,(IY+$00) ; Fetch the first byte of the group.
 $BA5A AND A         ; Test it.
 $BA5B RET NZ        ; Return with the carry flag reset if the group has
                     ; objects.
 $BA5C SCF           ; Set the carry flag as the group is empty.
 $BA5D RET           ; Return.

; Cell Offsets
;
; Nine pairs of offsets, which are used to find the cells around the
; player that are to be drawn.
@label=CellOffsets
b$BA5E DEFB $00,$01
 $BA60 DEFB $00,$00
 $BA62 DEFB $01,$01
 $BA64 DEFB $00,$FF
 $BA66 DEFB $01,$00
 $BA68 DEFB $02,$01
 $BA6A DEFB $01,$FF
 $BA6C DEFB $02,$00
 $BA6E DEFB $02,$FF

; Draw Level Objects
;
; Used by the routines at #R$AA5B, #R$C8E8 and #R$C93D.
; .
; Draws the objects of the level that are near the player. The nine cells
; around the position of the player are tried in turn, and the objects of the
; group in each cell are drawn with #R$BB3C. There are two entry points, which
; choose between two versions of the drawing code that is patched at #N$C3D8.
@label=DrawLevelObjects
c$BA70 LD DE,$C59A   ; {Draw each row with #R$C59A.
 $BA73 JR $BA78      ; }
; This entry point is used by the routines at #R$C7E8 and #R$C873.
@label=DrawLevelObjects_Second
*$BA75 LD DE,$C717   ; Test each row with #R$C717 instead.
; This entry point is used by the routine at #R$A3FE.
@label=DrawLevelObjects_Start
*$BA78 LD ($C3D8),DE ; Give that routine to the shape drawer.
 $BA7C LD ($C0DF),HL ; Remember where #R$BFA5 should return.
; Records at #R$BD74 whose fifth byte is set are copied, seven bytes
; each, into the table at #R$BDBB.
 $BA7F LD A,($BD73)  ; {There is nothing to copy when the count is zero.
 $BA82 AND A         ;
 $BA83 JR Z,$BAB1    ; }
 $BA85 LD B,A        ; {Start with none kept.
 $BA86 LD C,$00      ; }
 $BA88 LD IY,$BD74   ; Start at the first record.
 $BA8C LD DE,$BDBB   ; The copies go into #R$BDBB.
@label=DrawLevelObjects_Loop
*$BA8F PUSH BC       ; Remember how many records remain.
 $BA90 LD A,(IY+$05) ; {Copy a record whose fifth byte is set.
 $BA93 AND A         ;
 $BA94 JR Z,$BAA5    ; }
 $BA96 PUSH IY       ; {Take the seven bytes.
 $BA98 POP HL        ;
 $BA99 LD BC,$0007   ; }
 $BA9C LDIR          ; Copy them.
 $BA9E PUSH HL       ; {Move on to the next source record.
 $BA9F POP IY        ; }
 $BAA1 POP BC        ; {Count the copy.
 $BAA2 INC C         ;
 $BAA3 JR $BAAB      ; }
@label=DrawLevelObjects_Empty
*$BAA5 LD BC,$0007   ; {Skip an empty record.
 $BAA8 ADD IY,BC     ; }
 $BAAA POP BC        ; Bring the counts back.
@label=DrawLevelObjects_Copied
*$BAAB DJNZ $BA8F    ; Repeat for the remaining records.
 $BAAD LD A,C        ; {Remember how many records were copied.
 $BAAE LD ($BDBA),A  ; }
*$BAB1 LD HL,($5CE7) ; {Remember the horizontal view origin.
 $BAB4 LD ($B16A),HL ; }
 $BAB7 LD HL,$BBF7   ; {The next item record is the first one.
 $BABA LD ($B201),HL ; }
 $BABD LD HL,$BD74   ; {The object records start at #R$BD74.
 $BAC0 LD ($BF42),HL ; }
 $BAC3 LD A,$CD      ; {Draw the block bytes with a call.
 $BAC5 LD ($C75D),A  ; }
 $BAC8 LD HL,$C76D   ; {The call draws the block bytes.
 $BACB LD ($C75E),HL ; }
 $BACE LD HL,$FFE6   ; {Restore the shape index so that it masks nothing.
 $BAD1 LD ($C1A0),HL ; }
 $BAD4 LD A,$1A      ; {The row step-back is #N$1A.
 $BAD6 LD ($B530),A  ; }
 $BAD9 XOR A         ; {Clear the item count and the record count.
 $BADA LD ($BBF6),A  ;
 $BADD LD ($BD73),A  ; }
 $BAE0 PUSH IX       ; Remember the entity.
 $BAE2 LD C,$00      ; Start at the first cell.
*$BAE4 PUSH BC       ; Remember the cell number.
 $BAE5 CALL $BB0F    ; Find the cell around the player.
 $BAE8 CALL $BB25    ; Accept the cell.
 $BAEB JR NC,$BB04   ; Leave the cell when it is not accepted.
 $BAED LD HL,($5CB9) ; {Find the cell position for the group.
 $BAF0 CALL $BB3A    ; }
 $BAF3 JR C,$BB04    ; Leave the cell when it is rejected.
 $BAF5 LD HL,($5CB9) ; {Find the group at that cell.
 $BAF8 CALL $BA16    ; }
 $BAFB JR C,$BB04    ; Leave the cell when there is no group.
 $BAFD LD ($5CDC),DE ; Remember the group.
 $BB01 CALL $BB3C    ; Draw the objects of the group.
@label=DrawLevelObjects_Next
*$BB04 POP BC        ; Bring the cell number back.
 $BB05 INC C         ; {Step on by two cells.
 $BB06 INC C         ; }
 $BB07 LD A,C        ; {Repeat for the nine cells.
 $BB08 CP $12        ;
 $BB0A JR NZ,$BAE4   ; }
 $BB0C POP IX        ; Restore the entity.
 $BB0E RET           ; Return.

; Get Cell Position
;
; Used by the routine at #R$BA70.
; .
; Finds the position of a cell around the player by adding an offset from
; the table at #R$BA5E to the position of the player in #R$5CE2(#N$5CE3) and
; #R$5CE2(#N$5CE5), and stores the result in #R$5CB9.
;
; C The offset in the table, #N$00-#N$10 in twos
@label=GetCellPosition
c$BB0F LD HL,$BA5E   ; Point #REGhl at #R$BA5E.
 $BB12 LD B,$00      ; #REGb is #N$00.
 $BB14 ADD HL,BC     ; #REGhl takes #REGbc.
 $BB15 LD A,($5CE3)  ; Read the byte at #R$5CE2(#N$5CE3).
 $BB18 ADD A,(HL)    ; Add the byte at the address in #REGhl.
 $BB19 LD E,A        ; #REGa moves into #REGe.
 $BB1A INC HL        ; Advance #REGhl.
 $BB1B LD A,($5CE5)  ; Read the byte at #R$5CE2(#N$5CE5).
 $BB1E ADD A,(HL)    ; Add the byte at the address in #REGhl.
 $BB1F LD D,A        ; #REGa moves into #REGd.
 $BB20 EX DE,HL      ; Exchange #REGde and #REGhl.
 $BB21 LD ($5CB9),HL ; Write #REGhl at #R$5CB9.
 $BB24 RET           ; Return.

; Set Carry
;
; Used by the routine at #R$BA70.
; .
; Sets the carry flag. Used by #R$BA70 to accept a cell.
@label=SetCarry
c$BB25 SCF           ; Set the carry flag.
 $BB26 RET           ; Return.
 $BB27 LD A,H        ; #REGh moves into #REGa.
 $BB28 ADD A,L       ; Plus #REGl.
 $BB29 LD E,A        ; #REGa moves into #REGe.
 $BB2A LD A,($5CE8)  ; Read the byte at #R$5CE7(#N$5CE8).
 $BB2D CP E          ; Compare #REGa with #REGe.
 $BB2E JR NC,$BB36   ; Jump to #R$BB25(#N$BB36) if the carry flag is reset.
 $BB30 LD A,($5CE7)  ; Read the byte at #R$5CE7.
 $BB33 ADD A,$C0     ; Add #N$C0.
 $BB35 RET           ; Return.
@label=SetCarry_Unused
*$BB36 INC E         ; Advance #REGe.
 $BB37 INC E         ; Advance #REGe.
 $BB38 CP E          ; Compare #REGa with #REGe.
 $BB39 RET           ; Return.

; Clear Carry
;
; Used by the routine at #R$BA70.
; .
; Clears the carry flag. Used by #R$BA70 to accept a group.
@label=ClearCarry
c$BB3A XOR A         ; Set #REGa to zero.
 $BB3B RET           ; Return.

; Draw Group Objects
;
; Used by the routine at #R$BA70.
; .
; Draws each of the objects of a group of a cell, using #R$BFA5. The group
; is at #REGiy and the cell is at #R$5CB9. The first byte of a group has the
; number of objects in bits 0-4, and if bit 4 of it is set there is an extra
; byte, as described for #R$8BB1. The next two bytes and the extra byte make up
; a row of flags that is shifted left by one bit after each object, so that each
; object has a flag of its own.
;
; IY The address of the group
@label=DrawGroupObjects
c$BB3C LD HL,($5CB9) ; Fetch the position of the cell.
 $BB3F LD A,L        ; {Add the column of the cell to its row.
 $BB40 ADD A,H       ; }
 $BB41 LD ($BFA6),A  ; Patch it into #R$BFA5(#N$BFA6) as the depth of the
                     ; objects.
; Work out where the view starts, relative to the cell, and patch it into
; the drawing code.
 $BB44 LD HL,$8000   ; #REGhl is #N$8000.
 $BB47 LD DE,($5CE7) ; Fetch the vertical origin of the view.
 $BB4B AND A         ; Clear the carry flag.
 $BB4C SBC HL,DE     ; Take the origin away.
 $BB4E LD ($BFBA),HL ; Patch the result into #R$BFA5(#N$BFBA).
 $BB51 LD HL,$803F   ; #REGhl is #N$803F.
 $BB54 LD DE,($5CEE) ; Fetch the horizontal origin of the view.
 $BB58 AND A         ; Clear the carry flag.
 $BB59 SBC HL,DE     ; Take the origin away.
 $BB5B LD ($C061),HL ; Patch the result into #R$BFA5(#N$C061).
; Read the header of the group.
 $BB5E PUSH IY       ; Put the address of the group onto the stack...
 $BB60 POP IX        ; ...and take it off into #REGix.
 $BB62 LD A,(IX+$00) ; Fetch the first byte of the group.
 $BB65 AND %00011111 ; Keep the number of objects.
 $BB67 LD B,A        ; Keep it in #REGb.
 $BB68 LD H,(IX+$01) ; Fetch the first byte of the flags.
 $BB6B LD L,(IX+$02) ; Fetch the second byte of the flags.
 $BB6E INC IX        ; Move past the first byte of the group...
 $BB70 INC IX        ; ...and the first byte of the flags.
 $BB72 AND %00010000 ; Test whether the group has an extra byte of flags.
@label=DrawGroupObjects_Header
 $BB74 JR Z,$BB7B    ; Jump to #R$BB7B if there is no extra byte, with #REGa as
                     ; zero.
 $BB76 LD A,(IX+$01) ; Fetch the extra byte of flags.
 $BB79 INC IX        ; Move past the extra byte.
@label=DrawGroupObjects_Objects
*$BB7B LD ($BB8E),HL ; Patch the flags into the instructions that load them after each
                     ; object...
 $BB7E LD ($BB8C),A  ; ...including the extra byte.
; Draw each object, and then move the row of flags along by one.
@label=DrawGroupObjects_Loop
*$BB81 INC IX        ; Move onto the first byte of the object.
 $BB83 PUSH BC       ; Save the number of objects left.
 $BB84 CALL $BFA5    ; Draw the object.
 $BB87 INC IX        ; Move past the second byte of the object...
 $BB89 INC IX        ; ...and the third.
 $BB8B LD A,$00      ; Fetch the extra byte of flags, which is patched in.
 $BB8D LD HL,$0000   ; Fetch the other two bytes of flags, which are patched
                     ; in.
 $BB90 RLA           ; Shift the extra byte left...
 $BB91 RL L          ; ...then the second byte...
 $BB93 RL H          ; ...and then the first byte.
 $BB95 LD ($BB8C),A  ; Patch the extra byte back in.
 $BB98 LD ($BB8E),HL ; Patch the other two bytes back in.
 $BB9B POP BC        ; Restore the number of objects left.
 $BB9C DJNZ $BB81    ; Decrease the number of objects and loop back to #R$BB81 until all of
                     ; them have been drawn.
 $BB9E RET           ; Return.

; Drawing Variables
