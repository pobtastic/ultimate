; Add Object Entity
;
; Used by the routine at #R$BFA5.
; .
; Called by #R$BFA5 for an object that can be an entity. Checks that the
; object is in view and, if it is of kind #N$02, #N$03 or #N$04, makes an entity
; for it in the pool of four entities at #R$B540(#N$B670). The entity is of type
; #N$0C for kind #N$02 and type #N$10 for the other two. Any object that is in
; view is also recorded with #R$BF41.
;
; IX The object, which is three bytes
; HL The screen column of the object
;
; Check that the object is not off the left or right edge of the view.
@label=AddObjectEntity
c$BE01 BIT 7,H         ; {Jump to #R$BE0E if bit 7 of the high byte of the screen column is
 $BE03 JR NZ,$BE0E     ; set.}
 $BE05 LD BC,$0028     ; #REGbc is #N$0028, the margin on the left of the view.
 $BE08 ADD HL,BC       ; Add the margin to the screen column.
 $BE09 RL H            ; Rotate bit 7 of the high byte into the carry flag.
 $BE0B RET NC          ; Return if the object is off the left edge of the view.
 $BE0C JR $BE14        ; Jump to #R$BE14.
@label=AddObjectEntity_RightEdge
*$BE0E LD BC,$80E0     ; #REGbc is #N$80E0, the right edge of the view.
 $BE11 SBC HL,BC       ; Subtract it from the screen column.
 $BE13 RET NC          ; Return if the object is off the right edge of the
                       ; view.
; Work out the coordinates of the object. The x coordinate is the column
; of the cell and the upper four bits of the first byte of the object. The y
; coordinate is the row of the cell and the lower four bits, multiplied by
; sixteen. They are kept on the stack for the entity.
@label=AddObjectEntity_Position
*$BE14 LD A,($5CBA)    ; {Fetch the row of the cell and keep it in #REGd.
 $BE17 LD D,A          ; }
 $BE18 LD A,(IX+$00)   ; Fetch the first byte of the object.
 $BE1B ADD A,A         ; {Multiply it by sixteen, to move the lower four bits
 $BE1C ADD A,A         ; to the top...
 $BE1D ADD A,A         ;
 $BE1E ADD A,A         ; }
 $BE1F LD E,A          ; ...and keep the result in #REGe, as the low byte of the y
                       ; coordinate.
 $BE20 LD HL,($5CB8)   ; Fetch the column of the cell into #REGh.
 $BE23 LD A,(IX+$00)   ; Fetch the first byte of the object.
 $BE26 AND %11110000   ; Keep the upper four bits.
 $BE28 LD L,A          ; Keep them in #REGl, as the low byte of the x
                       ; coordinate.
 $BE29 PUSH DE         ; Save the y coordinate.
 $BE2A PUSH HL         ; Save the x coordinate.
; Work out the screen row of the object. This is half of the difference
; between its x and y coordinates, plus the offset to the view, less the height
; of the object.
 $BE2B SRL D           ; {Halve the y coordinate.
 $BE2D RR E            ; }
 $BE2F SRL H           ; {Halve the x coordinate.
 $BE31 RR L            ; }
 $BE33 SBC HL,DE       ; Subtract half of the y coordinate from half of the x
                       ; coordinate.
 $BE35 LD DE,($C061)   ; Fetch the offset to the view from the drawing code.
 $BE39 ADD HL,DE       ; Add the offset.
 $BE3A LD A,(IX+$01)   ; Fetch the second byte of the object.
 $BE3D AND %01110000   ; Keep the height in bits 4-6.
 $BE3F LD E,A          ; Keep it in #REGe.
 $BE40 LD A,(IX+$02)   ; Fetch the third byte of the object.
 $BE43 ADD A,A         ; Move bit 6, the top bit of the height, to bit 7...
 $BE44 AND %10000000   ; ...and keep it.
 $BE46 ADD A,E         ; Add the other bits of the height to find the height of
                       ; the object.
 $BE47 LD E,A          ; Keep the low byte of the height in #REGe.
 $BE48 LD D,$00        ; Clear #REGd.
 $BE4A SBC HL,DE       ; Subtract the height from the screen row.
; Check that the object is not above or below the view.
 $BE4C BIT 7,H         ; {Jump to #R$BE5A if bit 7 of the high byte of the screen row is not
 $BE4E JR Z,$BE5A      ; set.}
 $BE50 LD DE,$80A4     ; #REGde is #N$80A4, the bottom of the view.
 $BE53 SBC HL,DE       ; Subtract it from the screen row.
 $BE55 POP BC          ; Restore the x coordinate.
 $BE56 POP DE          ; Restore the y coordinate.
 $BE57 RET NC          ; Return if the object is below the view.
 $BE58 JR $BE63        ; Jump to #R$BE63.
@label=AddObjectEntity_TopMargin
*$BE5A LD DE,$0028     ; #REGde is #N$0028, the margin at the top of the view.
 $BE5D ADD HL,DE       ; Add the margin to the screen row.
 $BE5E RL H            ; Rotate bit 7 of the high byte into the carry flag.
 $BE60 POP BC          ; Restore the x coordinate.
 $BE61 POP DE          ; Restore the y coordinate.
 $BE62 RET NC          ; Return if the object is above the view.
; Only objects of kind #N$02, #N$03 and #N$04 that are not hidden have an
; entity. Record all of the others.
@label=AddObjectEntity_Pool
*$BE63 LD IY,$B670     ; Point #REGiy at the pool of four entities for objects.
 $BE67 LD A,(IX+$02)   ; Fetch the third byte of the object.
 $BE6A BIT 7,A         ; {Jump to #R$BF41 to record the object if it has one.
 $BE6C JP NZ,$BF41     ; }
 $BE6F AND %00011111   ; Keep the kind of the object.
 $BE71 CP $03          ; {Jump to #R$BE7E if it is kind #N$03.
 $BE73 JR Z,$BE7E      ; }
 $BE75 CP $04          ; {Jump to #R$BE7E if it is kind #N$04.
 $BE77 JR Z,$BE7E      ; }
 $BE79 CP $02          ; {Jump to #R$BF41 to record the object if it is not
 $BE7B JP NZ,$BF41     ; kind #N$02.}
; Search the pool for an entity that is not in use.
@label=AddObjectEntity_Search
*$BE7E LD A,$04        ; Set the number of entities left to try to #N$04.
 $BE80 EX DE,HL        ; Put the y coordinate into #REGhl.
 $BE81 LD DE,$0026     ; Set the size of an entity, #N$0026.
@label=AddObjectEntity_Next
*$BE84 EX AF,AF'       ; Save the number of entities left.
 $BE85 LD A,(IY+$00)   ; Fetch the type of the entity.
 $BE88 AND A           ; Test it.
 $BE89 JP NZ,$BF39     ; Jump to #R$BF39 if the entity is in use.
; Make the entity. It starts as type #N$0C, which is kind #N$02.
 $BE8C LD (IY+$02),B   ; Store the high byte of the x coordinate in field #N$02 of the
                       ; entity.
 $BE8F LD (IY+$03),C   ; Store the low byte of the x coordinate in field #N$03.
 $BE92 LD (IY+$05),H   ; Store the high byte of the y coordinate in field
                       ; #N$05.
 $BE95 LD A,L          ; Fetch the low byte of the y coordinate.
 $BE96 ADD A,$04       ; Add #N$04 to put the entity in the middle of the cell.
 $BE98 LD L,A          ; Keep it in #REGl.
 $BE99 LD (IY+$06),L   ; Store it in field #N$06.
 $BE9C LD (IY+$1C),$00 ; Set the animation counter in field #N$1C to #N$00.
 $BEA0 LD (IY+$1D),$20 ; Set the first and last frames in field #N$1D to #N$20.
 $BEA4 LD (IY+$00),$0C ; Set the type of the entity to #N$0C.
 $BEA8 LD (IY+$0B),$0C ; Set the size in field #N$0B to #N$0C.
 $BEAC LD (IY+$0C),$0C ; Set the size in field #N$0C to #N$0C.
 $BEB0 LD (IY+$0D),$01 ; Set field #N$0D to #N$01.
 $BEB4 LD A,(IX+$02)   ; Fetch the third byte of the object.
 $BEB7 AND %00011111   ; Keep the kind of the object.
 $BEB9 CP $02          ; {Jump to #R$BED5 if it is kind #N$02.
 $BEBB JR Z,$BED5      ; }
 $BEBD LD (IY+$00),$10 ; Change the type of the entity to #N$10.
 $BEC1 LD (IY+$1D),$00 ; Set the first and last frames in field #N$1D to #N$00.
 $BEC5 LD (IY+$0D),$0A ; Set field #N$0D to #N$0A.
 $BEC9 CP $03          ; {Jump to #R$BED5 if it is kind #N$03.
 $BECB JR Z,$BED5      ; }
 $BECD LD (IY+$1D),$11 ; Set the first and last frames in field #N$1D to #N$11, for kind
                       ; #N$04.
 $BED1 LD (IY+$0D),$10 ; Set field #N$0D to #N$10.
; Work out the z coordinate of the entity from the height of the object,
; less one.
@label=AddObjectEntity_Fields
*$BED5 LD A,(IX+$01)   ; Fetch the second byte of the object.
 $BED8 AND %01110000   ; Keep the height in bits 4-6.
 $BEDA LD E,A          ; Keep it in #REGe.
 $BEDB LD (IY+$08),$01 ; Set the high byte of the z coordinate in field #N$08
                       ; to #N$01.
 $BEDF LD A,(IX+$02)   ; Fetch the third byte of the object.
 $BEE2 ADD A,A         ; Move bit 6, the top bit of the height, to bit 7...
 $BEE3 AND %10000000   ; ...and keep it.
 $BEE5 ADD A,E         ; Add the other bits of the height.
 $BEE6 SUB $01         ; Take away one.
 $BEE8 LD (IY+$09),A   ; Store it in field #N$09, as the low byte of the z
                       ; coordinate.
 $BEEB JR NC,$BEF0     ; Jump to #R$BEF0 if it did not go below zero.
 $BEED DEC (IY+$08)    ; Decrease the high byte of the z coordinate by one.
@label=AddObjectEntity_SetFrame
*$BEF0 LD A,(IY+$1D)   ; Fetch the first frame of the entity from field #N$1D.
 $BEF3 AND %00001111   ; Keep the frame.
 $BEF5 OR %10000000    ; Set bit 7 to hide the entity until it is known to be
                       ; in view.
 $BEF7 LD (IY+$01),A   ; Store it as the frame of the entity in field #N$01.
; Remember the address of the object in fields #N$1A and #N$1B of the
; entity.
 $BEFA PUSH IX         ; {Put the address of the object into #REGde, via the
 $BEFC POP DE          ; stack.}
 $BEFD LD (IY+$1A),D   ; Store the high byte in field #N$1A.
 $BF00 LD (IY+$1B),E   ; Store the low byte in field #N$1B.
; Check that the new entity is in view, and free it again if it is not.
 $BF03 EXX             ; Switch to the alternate registers, to keep the
                       ; coordinates.
 $BF04 PUSH IX         ; Save the address of the object.
 $BF06 PUSH IY         ; {Put the address of the new entity into #REGix, via
 $BF08 POP IX          ; the stack.}
 $BF0A LD (IX+$16),$00 ; Set the width of the sprite in field #N$16 to #N$00.
 $BF0E LD (IX+$17),$18 ; Set the height of the sprite in field #N$17 to #N$18.
 $BF12 LD BC,$0010     ; Set the margin to #N$0010.
 $BF15 CALL $AEB0      ; Test whether the entity is in view.
 $BF18 JR NZ,$BF26     ; Jump to #R$BF26 if it is.
 $BF1A LD (IX+$00),$00 ; Set the type of the entity to #N$00, to free it.
 $BF1E LD (IX+$01),$80 ; Set the frame of the entity to #N$80, so that it is
                       ; hidden.
 $BF22 POP IX          ; Restore the address of the object.
 $BF24 JR $BF36        ; Jump to #R$BF36.
; The entity is in view. Work out where it is on the screen and which
; sprite it has, and mark the object as having an entity so that it is not made
; again.
@label=AddObjectEntity_Visible
*$BF26 CALL $AE0D      ; Work out the screen position of the entity.
 $BF29 CALL $AF21      ; Fetch the sprite of the entity.
 $BF2C POP IX          ; Restore the address of the object.
 $BF2E POP HL          ; Take the return address off the stack.
 $BF2F POP DE          ; Take the screen column of the object off the stack.
 $BF30 POP BC          ; Take the second and third bytes of the object off the
                       ; stack.
 $BF31 SET 7,B         ; Set bit 7 of the third byte, to show that the object
                       ; has an entity.
 $BF33 PUSH BC         ; Put the bytes of the object back on the stack...
 $BF34 PUSH DE         ; ...then the screen column...
 $BF35 PUSH HL         ; ...and then the return address.
@label=AddObjectEntity_Done
*$BF36 EXX             ; Switch back to the main registers.
 $BF37 JR $BF40        ; Jump to #R$BF40 to record the object.
@label=AddObjectEntity_NextEntity
*$BF39 ADD IY,DE       ; Move on to the next entity of the pool.
 $BF3B EX AF,AF'       ; Restore the number of entities left.
 $BF3C DEC A           ; Decrease the number of entities left.
 $BF3D JP NZ,$BE84     ; Jump back to #R$BE84 until all four have been tried.
@label=AddObjectEntity_Record
*$BF40 EX DE,HL        ; Put the y coordinate back into #REGde, and carry on into #R$BF41 to
                       ; record the object.
; Continue on to #R$BF41.

; Record Object
;
; Used by the routine at #R$BE01.
; .
; Records an object in the table of objects at #R$BD74. If the object is
; already in the copy of the table at #R$BDBB, the copy of the record is used.
; Otherwise a new record is made, with the position and kind of the object. The
; operand of the first instruction is the address of the next free record, and
; is updated each time.
;
; IX The object
; BC The position of the object
; DE The position of the object
;
; Fetch the address of the next free record, which is patched in, and
; check whether there are any records in the copy of the table.
@label=RecordObject
c$BF41 LD HL,$0000   ; Set #REGhl to the address of the next free record.
 $BF44 LD A,($BDBA)  ; Fetch the number of records in the copy of the table.
 $BF47 AND A         ; Test it.
 $BF48 JR Z,$BF79    ; Jump to #R$BF79 to make a new record if there are none.
; Look for a record in the copy of the table that has the same position as
; the object.
 $BF4A PUSH DE       ; Save the y coordinate.
 $BF4B PUSH BC       ; Save the x coordinate.
 $BF4C LD D,C        ; Copy the low byte of the x coordinate into #REGd.
 $BF4D LD IY,$BDBB   ; Point #REGiy at #R$BDBB.
@label=RecordObject_Find
*$BF51 EX AF,AF'     ; Keep the number of records left.
 $BF52 LD A,D        ; Fetch the low byte of the x coordinate.
 $BF53 XOR (IY+$00)  ; Compare it with the one in the record.
 $BF56 JR NZ,$BF6C   ; Jump to #R$BF6C if it is different.
 $BF58 LD A,E        ; Fetch the low byte of the y coordinate.
 $BF59 XOR (IY+$02)  ; Compare it with the one in the record.
 $BF5C JR NZ,$BF6C   ; Jump to #R$BF6C if it is different.
; Found it, so copy the record to the next free record.
 $BF5E PUSH IY       ; Put the address of the record into #REGde, via the
                     ; stack...
 $BF60 POP DE        ; {...then swap it with the address of the next free
 $BF61 EX DE,HL      ; record.}
 $BF62 LD BC,$0007   ; Set the size of a record, #N$0007.
 $BF65 LDIR          ; Copy the record.
 $BF67 EX DE,HL      ; Put the address of the next free record in #REGhl again.
 $BF68 POP BC        ; Restore the x coordinate.
 $BF69 POP DE        ; Restore the y coordinate.
 $BF6A JR $BF9A      ; Jump to #R$BF9A.
@label=RecordObject_Next
*$BF6C LD A,B        ; Keep #REGb in #REGa.
 $BF6D LD BC,$0007   ; Set the size of a record, #N$0007.
 $BF70 ADD IY,BC     ; Move on to the next record in the copy of the table.
 $BF72 LD B,A        ; Bring back #REGb.
 $BF73 EX AF,AF'     ; Fetch the number of records left.
 $BF74 DEC A         ; Decrease it.
 $BF75 JR NZ,$BF51   ; Jump back to #R$BF51 until all of the records have been
                     ; tried.
 $BF77 POP BC        ; Restore the x coordinate.
 $BF78 POP DE        ; Restore the y coordinate.
; Make a new record from the object, with the coordinates, the height and
; the kind.
@label=RecordObject_New
*$BF79 LD (HL),C     ; {Store the low byte of the x coordinate.
 $BF7A INC HL        ; }
 $BF7B LD (HL),B     ; {Store the high byte of the x coordinate.
 $BF7C INC HL        ; }
 $BF7D LD (HL),E     ; {Store the low byte of the y coordinate.
 $BF7E INC HL        ; }
 $BF7F LD (HL),D     ; {Store the high byte of the y coordinate.
 $BF80 INC HL        ; }
 $BF81 LD A,(IX+$01) ; Fetch the second byte of the object.
 $BF84 AND %01110000 ; Keep the height in bits 4-6.
 $BF86 LD E,A        ; Keep it in #REGe.
 $BF87 LD A,(IX+$02) ; Fetch the third byte of the object.
 $BF8A ADD A,A       ; Move bit 6, the top bit of the height, to bit 7...
 $BF8B AND %10000000 ; ...and keep it.
 $BF8D ADD A,E       ; Add the other bits of the height.
 $BF8E LD (HL),A     ; {Store the height in the record.
 $BF8F INC HL        ; }
 $BF90 LD (HL),$00   ; {Set the next byte of the record to #N$00.
 $BF92 INC HL        ; }
 $BF93 LD A,(IX+$02) ; Fetch the third byte of the object.
 $BF96 AND %00011111 ; Keep the kind of the object.
 $BF98 LD (HL),A     ; Store it in the record.
 $BF99 INC HL        ; Move on past the record.
; Store the address of the next free record, and count the record.
@label=RecordObject_Store
*$BF9A LD ($BF42),HL ; Patch the address of the next free record into the first
                     ; instruction.
 $BF9D LD A,($BD73)  ; Fetch the number of records.
 $BFA0 INC A         ; Add one.
 $BFA1 LD ($BD73),A  ; Store the number of records.
 $BFA4 RET           ; Return.

; Draw Object
;
; Used by the routine at #R$BB3C.
; .
; Prepares an object of a group for drawing, and then passes it to the
; routine whose address is the operand of the JP at #N$C0DE, which is set by
; #R$BA70. It works out the screen column and row of the object, and returns
; without doing anything if the object is not in view. Objects that can be
; entities are passed to #R$BE01 first, and an object that has the flag for it
; in the row of flags of the group is also given an item record with #R$B1FF.
;
; IX The object, which is three bytes
;
; Work out the screen column of the object. This is the depth of the cell
; plus the sum of the two halves of the first byte of the object, which are its
; offsets along the x and y axes, less the origin of the view.
@label=DrawObject
c$BFA5 LD H,$00        ; Set #REGh to the depth of the cell, which is patched
                       ; in.
 $BFA7 LD A,(IX+$00)   ; Fetch the first byte of the object.
 $BFAA ADD A,A         ; {Multiply it by sixteen, to move the offset along the y axis to the
 $BFAB ADD A,A         ; top four bits...
 $BFAC ADD A,A         ;
 $BFAD ADD A,A         ; }
 $BFAE LD E,A          ; ...and keep it in #REGe.
 $BFAF LD A,(IX+$00)   ; Fetch the first byte of the object again.
 $BFB2 AND %11110000   ; Keep the offset along the x axis in the top four bits.
 $BFB4 ADD A,E         ; Add the two offsets to find the low byte of the screen
                       ; column.
 $BFB5 JR NC,$BFB8     ; Jump to #R$BFB8 if there was no carry.
 $BFB7 INC H           ; Increase the high byte of the screen column.
@label=DrawObject_SetColumn
*$BFB8 LD L,A          ; Put the low byte of the screen column in #REGl.
 $BFB9 LD BC,$0000     ; Set #REGbc to the origin of the view, which is patched
                       ; in.
 $BFBC ADD HL,BC       ; Add the origin to the screen column.
; Find out whether the object can be an entity. Objects of kind #N$81 and
; #N$8F are passed to #R$BE01, and any other kind is drawn straight away.
 $BFBD LD A,(IX+$01)   ; Fetch the second byte of the object.
 $BFC0 AND %10001111   ; Keep bit 7 and the kind in bits 0-3.
 $BFC2 CP $81          ; {Jump to #R$BFD1 if it is kind #N$81.
 $BFC4 JR Z,$BFD1      ; }
 $BFC6 BIT 7,A         ; {Jump to #R$C018 if bit 7 is not set.
 $BFC8 JP Z,$C018      ; }
 $BFCB INC A           ; Add one to the kind.
 $BFCC AND %00001111   ; Keep the kind.
 $BFCE JP NZ,$C018     ; Jump to #R$C018 unless the kind was #N$8F.
@label=DrawObject_Entity
*$BFD1 LD B,(IX+$02)   ; Fetch the third byte of the object into #REGb...
 $BFD4 LD C,(IX+$01)   ; ...and the second byte into #REGc.
 $BFD7 PUSH BC         ; Save them.
 $BFD8 PUSH HL         ; Save the screen column.
 $BFD9 LD A,C          ; Copy the second byte into #REGa.
 $BFDA AND %10001111   ; Keep bit 7 and the kind.
 $BFDC CP $8F          ; {Jump to #R$BFFF if it is kind #N($8F), so that the bytes are used
 $BFDE JR Z,$BFFF      ; as they are.}
; Change an object of kind #N$81 into an object of kind #N$8F that has the
; size of the object in its third byte, so that it is recorded with that size.
 $BFE0 LD A,B          ; Fetch the third byte of the object.
 $BFE1 RRA             ; {Shift the size in bits 4-5 to bits 2-3...
 $BFE2 RRA             ; }
 $BFE3 AND %00110000   ; ...and keep it.
 $BFE5 ADD A,$10       ; Add #N$10.
 $BFE7 LD B,A          ; Keep it in #REGb.
 $BFE8 LD A,C          ; Fetch the second byte of the object.
 $BFE9 AND %01110000   ; Keep the height in bits 4-6.
 $BFEB ADD A,B         ; Add the size to the height.
 $BFEC LD (IX+$02),$01 ; Set the third byte of the object to #N$01.
 $BFF0 CP $80          ; {Jump to #R$BFFA if it is below #N$80.
 $BFF2 JR C,$BFFA      ; }
 $BFF4 SUB $80         ; Take away #N$80.
 $BFF6 SET 6,(IX+$02)  ; Set bit 6 of the third byte of the object.
@label=DrawObject_SetKind
*$BFFA OR %10001111    ; Set bits 0-3 and bit 7, to make it kind #N$8F.
 $BFFC LD (IX+$01),A   ; Store it as the second byte of the object.
@label=DrawObject_Add
*$BFFF CALL $BE01      ; Add an entity for the object, if it has one, and
                       ; record it.
 $C002 POP HL          ; Restore the screen column.
 $C003 POP BC          ; Restore the second and third bytes of the object...
 $C004 LD (IX+$01),C   ; ...and put them back.
 $C007 LD (IX+$02),B   ; Put the third byte back.
 $C00A LD A,C          ; Fetch the second byte of the object.
 $C00B AND %10001111   ; Keep bit 7 and the kind.
 $C00D CP $8F          ; Compare it with #N$8F.
 $C00F RET Z           ; Return if it is kind #N$8F, as it is an entity and is not drawn as a
                       ; block.
 $C010 LD A,(IX+$00)   ; Fetch the first byte of the object.
 $C013 ADD A,A         ; {Multiply it by sixteen, to move the offset along the y axis to the
 $C014 ADD A,A         ; top four bits...
 $C015 ADD A,A         ;
 $C016 ADD A,A         ; }
 $C017 LD E,A          ; ...and keep it in #REGe.
; Check that the object is not off the left of the view, or off the right
; of it, using the width of the object.
@label=DrawObject_Position
*$C018 LD A,L          ; Fetch the low byte of the screen column.
 $C019 AND %11111000   ; Round it down to a multiple of eight.
 $C01B LD L,A          ; Put it back.
 $C01C PUSH HL         ; Save the screen column.
 $C01D BIT 7,H         ; {Jump to #R$C03E if bit 7 of the high byte of the screen column is
 $C01F JR NZ,$C03E     ; set.}
 $C021 LD B,$00        ; Clear #REGb.
 $C023 LD C,(IX+$02)   ; Fetch the third byte of the object into #REGc.
 $C026 SLA C           ; Double it.
 $C028 LD A,C          ; Copy it into #REGa.
 $C029 AND %01110000   ; Keep the width in bits 4-6.
 $C02B LD D,A          ; Keep it in #REGd.
 $C02C LD A,C          ; Fetch the doubled byte again.
 $C02D ADD A,A         ; {Shift it left three times, to move the depth to bits
 $C02E ADD A,A         ; 4-6...
 $C02F ADD A,A         ; }
 $C030 AND %01110000   ; ...and keep it.
 $C032 ADD A,D         ; Add the width.
 $C033 ADD A,$1F       ; Add #N$1F to make the distance to the left of the
                       ; object.
 $C035 LD C,A          ; Put it in #REGc.
 $C036 ADD HL,BC       ; Add it to the screen column.
 $C037 INC HL          ; Move on by one more.
 $C038 RL H            ; Rotate bit 7 of the high byte into the carry flag.
 $C03A POP HL          ; Restore the screen column.
 $C03B RET NC          ; Return if the object is off the left of the view.
 $C03C JR $C045        ; Jump to #R$C045.
@label=DrawObject_Far
*$C03E LD BC,$80C0     ; #REGbc is #N$80C0, the right edge of the view.
 $C041 SBC HL,BC       ; Subtract it from the screen column.
 $C043 POP HL          ; Restore the screen column.
 $C044 RET NC          ; Return if the object is off the right of the view.
; Work out the screen row of the object. This is half of the difference
; between its x and y coordinates, plus the offset to the view, less the height
; of the object.
@label=DrawObject_Visible
*$C045 LD ($BB9F),HL   ; Store the screen column, as the one to draw at.
 $C048 LD A,($5CBA)    ; Fetch the row of the cell into #REGd.
 $C04B LD D,A          ; Keep the y coordinate of the cell...
 $C04C LD HL,($5CB8)   ; Fetch the column of the cell into #REGh.
 $C04F LD A,(IX+$00)   ; Fetch the first byte of the object.
 $C052 AND %11110000   ; Keep the offset along the x axis.
 $C054 LD L,A          ; Make it the low byte of the x coordinate.
 $C055 SRL D           ; {Halve the y coordinate...
 $C057 RR E            ; }
 $C059 SRL H           ; {...and halve the x coordinate.
 $C05B RR L            ; }
 $C05D AND A           ; {Subtract half of the y coordinate from half of the x
 $C05E SBC HL,DE       ; coordinate.}
 $C060 LD DE,$0000     ; Set #REGde to the offset to the view, which is patched
                       ; in.
 $C063 ADD HL,DE       ; Add the offset.
 $C064 LD A,(IX+$01)   ; Fetch the second byte of the object.
 $C067 AND %01110000   ; Keep the height in bits 4-6.
 $C069 LD E,A          ; Keep it in #REGe.
 $C06A LD A,(IX+$01)   ; Fetch the second byte of the object again.
 $C06D AND %10001111   ; Keep bit 7 and the kind.
 $C06F CP $83          ; {Jump to #R$C077 if it is kind #N$83.
 $C071 JR Z,$C077      ; }
 $C073 CP $85          ; {Jump to #R$C07B unless it is kind #N$85.
 $C075 JR NZ,$C07B     ; }
@label=DrawObject_AddHeight
*$C077 LD A,$10        ; #REGa is #N$10, which is added to the height of these
                       ; kinds.
 $C079 ADD A,E         ; Add the height.
 $C07A LD E,A          ; Keep it in #REGe.
@label=DrawObject_SubtractHeight
*$C07B LD D,$00        ; Clear #REGd.
 $C07D AND A           ; {Subtract the height from the screen row.
 $C07E SBC HL,DE       ; }
 $C080 PUSH HL         ; Save the screen row.
; Check that the object is not above the view.
 $C081 LD A,(IX+$02)   ; Fetch the third byte of the object.
 $C084 ADD A,A         ; {Shift it left three times, to move the depth to bits
 $C085 ADD A,A         ; 3-5...
 $C086 ADD A,A         ; }
 $C087 AND %00111000   ; ...and keep it.
 $C089 ADD A,$08       ; Add #N$08.
 $C08B LD E,A          ; Keep it in #REGe.
 $C08C ADD HL,DE       ; Add it to the screen row.
 $C08D RL H            ; Rotate bit 7 of the high byte into the carry flag.
 $C08F POP HL          ; Restore the screen row.
 $C090 RET NC          ; Return if the object is above the view.
; Check that the object is not below the view, and work out the height of
; the object.
 $C091 PUSH HL         ; Save the screen row.
 $C092 LD A,(IX+$02)   ; {Fetch the third byte of the object and keep it in
 $C095 LD B,A          ; #REGb.}
 $C096 AND %00111000   ; Keep the depth in bits 3-5.
 $C098 ADD A,$08       ; Add #N$08.
 $C09A LD E,A          ; Keep it in #REGe.
 $C09B LD A,(IX+$01)   ; Fetch the second byte of the object.
 $C09E BIT 7,A         ; {Jump to #R$C0A8 if bit 7 is set.
 $C0A0 JR NZ,$C0A8     ; }
 $C0A2 AND %00001111   ; Keep the kind.
 $C0A4 SUB $02         ; Take away #N$02.
 $C0A6 JR Z,$C0AF      ; Jump to #R$C0AF if it is kind #N$02, with zero as the
                       ; size.
@label=DrawObject_SizeFromByte
*$C0A8 LD A,B          ; Fetch the third byte of the object.
 $C0A9 RRA             ; {Shift the size in bits 4-5 to bits 2-3...
 $C0AA RRA             ; }
 $C0AB AND %00110000   ; ...and keep it.
 $C0AD ADD A,$10       ; Add #N$10.
@label=DrawObject_StoreHeight
*$C0AF LD ($5CF5),A    ; Store it as the height of the object, in
                       ; #R$5CF3(#N$5CF5).
 $C0B2 ADD A,E         ; Add the depth.
 $C0B3 LD E,A          ; Keep it in #REGe.
 $C0B4 SBC HL,DE       ; Subtract it from the screen row.
 $C0B6 LD DE,$8080     ; #REGde is #N$8080, the bottom of the view.
 $C0B9 SBC HL,DE       ; Subtract it from the screen row.
 $C0BB POP HL          ; Restore the screen row.
 $C0BC RET NC          ; Return if the object is below the view.
 $C0BD LD ($BBA1),HL   ; Store the screen row, as the one to draw at.
; Work out the depth and the width of the object, and store them.
 $C0C0 LD A,(IX+$02)   ; Fetch the third byte of the object.
 $C0C3 ADD A,A         ; Double it...
 $C0C4 LD B,A          ; ...and keep it in #REGb.
 $C0C5 AND %01110000   ; Keep the size in bits 4-6.
 $C0C7 ADD A,$10       ; Add #N$10.
 $C0C9 LD ($5CF4),A    ; Store it as the depth of the object, in
                       ; #R$5CF3(#N$5CF4).
 $C0CC LD A,B          ; Fetch the doubled byte again.
 $C0CD ADD A,A         ; {Shift it left three times, to move the other size to
 $C0CE ADD A,A         ; bits 4-6...
 $C0CF ADD A,A         ; }
 $C0D0 AND %01110000   ; ...and keep it.
 $C0D2 ADD A,$10       ; Add #N$10.
 $C0D4 LD ($5CF3),A    ; Store it as the width of the object, in #R$5CF3.
; Give the object an item record if its flag in the row of flags of the
; group is set, and then pass it to the routine that handles it.
 $C0D7 LD A,($BB8F)    ; Fetch the first byte of the row of flags of the group.
 $C0DA RLA             ; Rotate its top bit into the carry flag.
@label=DrawObject_Record
 $C0DB CALL C,$B1FF    ; Add an item record for the object if the flag is set.
@label=DrawObject_Handle
*$C0DE JP $C0DE        ; Jump to the routine that handles the object, which is
                       ; patched in.

; Draw Right Strip
;
; Handles an object for #R$BFA5 when the view is scrolling to the left, so
; that only the objects in the strip that has just come into view on the right
; are drawn.
@label=DrawRightStrip
c$C0E1 LD HL,($BB9F) ; Fetch the position of the object in the view.
 $C0E4 CALL $B9F3    ; Add the sizes of the object, to find its far edge.
 $C0E7 LD DE,$80B0   ; Set the position of the start of the strip on the right.
 $C0EA AND A         ; {Subtract the start of the strip.
 $C0EB SBC HL,DE     ; }
 $C0ED RET C         ; Return if the object is not as far across as the strip.
 $C0EE JR $C15E      ; Draw the block of the object.

; Draw Left Strip
;
; Handles an object for #R$BFA5 when the view is scrolling to the right,
; so that only the objects in the strip that has just come into view on the left
; are drawn. The position of the object is moved across by the width of the
; view, #N$00B0, by the entry point at #R$C0FF.
@label=DrawLeftStrip
c$C0F0 LD HL,($BB9F) ; Fetch the position of the object in the view.
 $C0F3 LD DE,$00B0   ; Set the distance to move the object across, #N$00B0.
 $C0F6 LD A,H        ; Copy the high byte of the position into #REGa.
 $C0F7 CP $80        ; {Jump to #R$C0FF if the position is below #N$8000.
 $C0F9 JR C,$C0FF    ; }
 $C0FB LD A,L        ; Copy the low byte of the position into #REGa.
 $C0FC CP $10        ; Compare it with #N$10.
 $C0FE RET NC        ; Return if the object is not in the strip.
; This entry point is used by the routines at #R$C108 and #R$C119.
@label=DrawLeftStrip_AddOffset
*$C0FF LD HL,($BB9F) ; Fetch the position of the object in the view.
 $C102 ADD HL,DE     ; Add the distance to move across.
 $C103 LD ($BB9F),HL ; Store the new position.
 $C106 JR $C15E      ; Draw the block of the object.

; Draw Top Strip
;
; Handles an object for #R$BFA5 when the view is scrolling down, so that
; only the objects in the strip that has just come into view at the top are
; drawn.
@label=DrawTopStrip
c$C108 CALL $BA00    ; Find the position of the object in the view, with its
                     ; size offset.
 $C10B LD A,H        ; Copy the high byte of the position into #REGa.
 $C10C CP $80        ; Compare it with #N$80.
 $C10E LD DE,$0010   ; Set the distance to move the object down, #N$0010.
 $C111 JR NZ,$C0FF   ; Draw the object, after moving it, if the high byte is
                     ; not #N$80.
 $C113 LD A,L        ; Copy the low byte of the position into #REGa.
 $C114 CP $08        ; Compare it with #N$08.
 $C116 RET NC        ; Return if the object is not in the strip.
 $C117 JR $C0FF      ; Draw the object, after moving it.

; Draw Bottom Strip
;
; Handles an object for #R$BFA5 when the view is scrolling up, so that
; only the objects in the strip that has just come into view at the bottom are
; drawn.
@label=DrawBottomStrip
c$C119 LD HL,($BBA1) ; Fetch the vertical position of the object in the view.
 $C11C LD A,($5CF3)  ; Fetch the size of the object.
 $C11F SRL A         ; Halve it.
 $C121 LD E,A        ; Copy it into #REGe.
 $C122 LD D,$00      ; Clear #REGd.
 $C124 ADD HL,DE     ; Add half of the size to the position.
 $C125 LD DE,$8078   ; Set the position of the start of the strip at the
                     ; bottom.
 $C128 AND A         ; {Subtract the start of the strip.
 $C129 SBC HL,DE     ; }
 $C12B RET C         ; Return if the object is not as far down as the strip.
 $C12C LD HL,($BBA1) ; Fetch the vertical position of the object in the view.
 $C12F LD DE,$FF88   ; Set the distance to move the object up, #N$FF88.
 $C132 ADD HL,DE     ; Add it.
 $C133 LD ($BBA1),HL ; Store the new position.
 $C136 LD DE,$0010   ; Set the distance to move the object down, #N$0010.
 $C139 JR $C0FF      ; Draw the object, after moving it.

; Draw Chosen Object
;
; Handles an object for #R$BFA5 when only one object is to be drawn, which
; is the object whose address is the operand of the first instruction. Every
; other object is skipped. The block of the object is drawn with the code that
; is patched to draw a block section instead of a block row.
@label=DrawChosenObject
c$C13B LD HL,$0000   ; Set #REGhl to the address of the chosen object, which is
                     ; patched in.
 $C13E PUSH IX       ; {Copy the address of the current object into #REGde.
 $C140 POP DE        ; }
 $C141 AND A         ; {Subtract the address of the current object.
 $C142 SBC HL,DE     ; }
 $C144 RET NZ        ; Return if it is not the chosen object.
 $C145 LD A,(IX+$01) ; Fetch the kind of the object.
 $C148 AND %10001111 ; Use bits 0-3 and bit 7.
 $C14A CP $82        ; Compare it with #N$82.
 $C14C RET NZ        ; Return if it is not an object of that kind.
 $C14D LD A,$C3      ; Set #REGa to the opcode of a JP instruction, #N$C3.
 $C14F LD ($C75D),A  ; Patch it into the drawing code at #R$C72E(#N$C75D).
 $C152 LD HL,$C7AC   ; Point #REGhl at #R$C7AC.
 $C155 LD ($C75E),HL ; Patch it in as the destination of the jump.
 $C158 LD HL,$00F6   ; #REGhl is #N$00F6.
 $C15B LD ($C1A0),HL ; Patch it in as the amount that is used by #R$C15E at
                     ; #N$C1A0.
; Continue on to #R$C15E.

; Draw Block
;
; Used by the routines at #R$B06E, #R$C0E1 and #R$C0F0.
; .
; Draws a block from the drawing variables at #R$BB9F. The three sizes at
; #R$5CF3 supply the column and row sizes, from the high nibble of each byte.
; The shape index comes from the object's frame, unless a record has patched
; #R$C1A0 so that it loads the record's own index. The shape byte is looked up
; from that index, and one section is drawn for each #N$40 in the byte.
; .
; The flags at #R$D7B3, indexed by the shape kind, choose the layout. Bit
; 7 clear draws the block as it is. Bits 5-6 clear mirror it, #N$20 draws it
; as it is, #N$40 raises it, and any other value moves the origin back by
; #N$10. Kinds #N$11 and #N$12 use a column size of one and lower the screen
; position by the third size. Each section is drawn by #R$C381.
;
; IX The object
;
; Copy the high nibbles of the three sizes into the drawing variables, and
; make the shape index.
@label=DrawBlock
c$C15E PUSH IX       ; Remember the object.
 $C160 LD IY,$BB9F   ; Use the drawing variables.
 $C164 PUSH IY       ; Remember the drawing variables.
 $C166 LD A,($5CF3)  ; {Take the high nibble of the first size.
 $C169 SRL A         ;
 $C16B RRA           ;
 $C16C RRA           ;
 $C16D RRA           ; }
 $C16E LD ($BBA5),A  ; {Keep it as both copies of the column size.
 $C171 LD ($BBB3),A  ; }
 $C174 LD A,($5CF4)  ; {Take the high nibble of the second size.
 $C177 RRA           ;
 $C178 RRA           ;
 $C179 RRA           ;
 $C17A RRA           ; }
 $C17B LD ($BBA4),A  ; {Keep it as the row size.
 $C17E LD ($BBAC),A  ;
 $C181 LD ($BBB2),A  ; }
 $C184 LD A,($C1A0)  ; {Use the patched shape index when this instruction loads
 $C187 CP $3E        ; one.
 $C189 JR Z,$C1A0    ; }
 $C18B LD A,(IX+$01) ; {Read the object's frame.
 $C18E LD E,A        ; }
 $C18F AND %00001111 ; Keep the frame number.
 $C191 LD D,A        ; {Bring bit 4 of the frame down beside the frame number.
 $C192 LD A,E        ;
 $C193 RRA           ;
 $C194 RRA           ;
 $C195 RRA           ; }
 $C196 AND %00010000 ; Keep that bit.
 $C198 OR D          ; {Remember the shape index made from the frame.
 $C199 LD E,A        ;
 $C19A LD ($C1FE),A  ; }
 $C19D ADD A,A       ; {Triple the shape index.
 $C19E ADD A,A       ;
 $C19F SUB E         ; }
; Look the shape byte up. Below #N$40 there is one section, below #N$80
; there are two, and a larger byte has a third. The bytes of the further
; sections follow the first shape byte.
@label=DrawBlock_Index
*$C1A0 AND %11111111 ; Keep the shape index. A record replaces this so that it loads
                     ; its index.
 $C1A2 LD HL,$BBB1   ; {Look the shape byte up.
 $C1A5 LD E,A        ;
 $C1A6 LD D,$00      ;
 $C1A8 ADD HL,DE     ;
 $C1A9 LD A,(HL)     ;
 $C1AA LD B,A        ; }
 $C1AB PUSH AF       ; Remember the shape byte for the later sections.
 $C1AC AND %00111111 ; Keep the shape number.
 $C1AE LD ($BBA3),A  ; Store the shape number in the drawing variables.
 $C1B1 LD A,B        ; {One section is enough when the shape byte is below
 $C1B2 SUB $40       ; #N$40.
 $C1B4 JR C,$C1FD    ; }
 $C1B6 INC HL        ; {Read the second shape byte.
 $C1B7 LD A,(HL)     ;
 $C1B8 LD ($BBAA),A  ; }
 $C1BB INC HL        ; {Read the third shape byte.
 $C1BC LD A,(HL)     ;
 $C1BD LD ($BBB1),A  ; }
 $C1C0 LD A,($5CF5)  ; {Take the high nibble of the third size.
 $C1C3 SRL A         ;
 $C1C5 RRA           ;
 $C1C6 RRA           ;
 $C1C7 RRA           ; }
 $C1C8 LD ($BBA4),A  ; {Use it as the row size of the further sections.
 $C1CB LD ($BBAB),A  ; }
 $C1CE LD HL,($BB9F) ; Fetch the origin.
 $C1D1 LD DE,($5CF3) ; Fetch the first two sizes.
 $C1D5 LD D,$00      ; {Add the first size to the origin.
 $C1D7 ADD HL,DE     ;
 $C1D8 LD ($BBA6),HL ; }
 $C1DB LD HL,($BBA1) ; Fetch the screen position.
 $C1DE SRL E         ; {Add half of the first size to the screen position.
 $C1E0 ADD HL,DE     ;
 $C1E1 LD ($BBA8),HL ; }
 $C1E4 LD A,B        ; {Two sections are enough when the shape byte is below
 $C1E5 SUB $80       ; #N$80.
 $C1E7 JR C,$C1FD    ; }
 $C1E9 LD HL,($BB9F) ; {Keep the origin for a third section.
 $C1EC LD ($BBAD),HL ; }
 $C1EF LD HL,($BBA1) ; Fetch the screen position again.
 $C1F2 LD DE,($5CF5) ; {Subtract the third size from the screen position.
 $C1F6 LD D,$00      ;
 $C1F8 SBC HL,DE     ;
 $C1FA LD ($BBAF),HL ; }
; Kinds #N$11 and #N$12 are the special blocks. The byte loaded here is
; patched with the record's kind.
@label=DrawBlock_Details
*$C1FD LD E,$00      ; Take the shape kind.
 $C1FF LD A,E        ; {Use the special sizes for kind #N$12.
 $C200 CP $12        ;
 $C202 JR Z,$C208    ; }
 $C204 CP $11        ; {Use the special sizes for kind #N$11 too.
 $C206 JR NZ,$C222   ; }
@label=DrawBlock_Special
*$C208 LD HL,($BBA1) ; {Lower the screen position by the third size.
 $C20B LD A,($5CF5)  ;
 $C20E LD C,A        ;
 $C20F LD B,$00      ;
 $C211 AND A         ;
 $C212 SBC HL,BC     ;
 $C214 LD ($BBA1),HL ;
 $C217 LD ($BBA8),HL ; }
 $C21A LD A,$01      ; {Use a column size of one.
 $C21C LD ($BBA5),A  ;
 $C21F LD ($BBAC),A  ; }
; The object's flags choose a mirrored block, a raised block, or a block
; shifted back by #N$10.
@label=DrawBlock_Flags
*$C222 LD D,$00      ; {Look up the flags for this kind of object.
 $C224 LD HL,$D7B3   ;
 $C227 ADD HL,DE     ; }
 $C228 BIT 7,(HL)    ; {Draw the block as it is when the top flag is clear.
 $C22A JP Z,$C2DF    ; }
 $C22D LD A,(HL)     ; Read the flags.
 $C22E AND %01100000 ; Keep the layout in bits 5-6.
 $C230 JR Z,$C254    ; Mirror the block when those bits are clear.
 $C232 CP $20        ; {Draw the block as it is when the layout is #N$20.
 $C234 JP Z,$C2DF    ; }
 $C237 CP $40        ; {Raise the block when the layout is #N$40.
 $C239 JP Z,$C2BD    ; }
 $C23C LD A,($5CF3)  ; {Take the high nibble of the first size.
 $C23F SRL A         ;
 $C241 RRA           ;
 $C242 RRA           ;
 $C243 RRA           ; }
 $C244 LD ($BBAB),A  ; Use it as the extra row size.
 $C247 LD HL,($BBA6) ; {Move the adjusted origin back by #N$10.
 $C24A LD DE,$FFF0   ;
 $C24D ADD HL,DE     ;
 $C24E LD ($BBA6),HL ; }
 $C251 JP $C2DF      ; Draw the shape.
@label=DrawBlock_Mirror
*$C254 LD HL,($BB9F) ; {Swap the origin with the adjusted origin.
 $C257 LD DE,($BBA6) ;
 $C25B LD ($BBA6),HL ;
 $C25E LD ($BB9F),DE ; }
 $C262 LD HL,($BBA1) ; {Swap the screen position with its adjusted copy.
 $C265 LD DE,($BBA8) ;
 $C269 LD ($BBA8),HL ;
 $C26C LD ($BBA1),DE ; }
 $C270 LD HL,($BBA3) ; {Swap the shape bytes with the extra shape bytes.
 $C273 LD DE,($BBAA) ;
 $C277 LD ($BBAA),HL ;
 $C27A LD ($BBA3),DE ; }
 $C27E LD A,($BBA5)  ; {Swap the two column sizes.
 $C281 LD E,A        ;
 $C282 LD A,($BBAC)  ;
 $C285 LD ($BBA5),A  ;
 $C288 LD A,E        ;
 $C289 LD ($BBAC),A  ; }
 $C28C LD A,($5CF4)  ; {Take the high nibble of the second size.
 $C28F SRL A         ;
 $C291 RRA           ;
 $C292 RRA           ;
 $C293 RRA           ; }
 $C294 LD ($BBAB),A  ; Use it as the extra row size.
 $C297 LD A,($5CF3)  ; {Take the high nibble of the first size.
 $C29A SRL A         ;
 $C29C RRA           ;
 $C29D RRA           ;
 $C29E RRA           ; }
 $C29F LD ($BBAC),A  ; Use it as the other column size.
 $C2A2 LD A,($5CF4)  ; {Move the origin on by the second size less #N$10.
 $C2A5 SUB $10       ;
 $C2A7 LD E,A        ;
 $C2A8 LD HL,($BB9F) ;
 $C2AB LD D,$00      ;
 $C2AD ADD HL,DE     ;
 $C2AE LD ($BB9F),HL ; }
 $C2B1 SRL E         ; {Move the screen position back by half of that step.
 $C2B3 LD HL,($BBA1) ;
 $C2B6 SBC HL,DE     ;
 $C2B8 LD ($BBA1),HL ; }
 $C2BB JR $C2DF      ; Draw the shape.
@label=DrawBlock_Raised
*$C2BD LD A,($5CF3)  ; {Move the origin on by the first size less #N$10.
 $C2C0 SUB $10       ;
 $C2C2 LD E,A        ;
 $C2C3 LD HL,($BB9F) ;
 $C2C6 LD D,$00      ;
 $C2C8 ADD HL,DE     ;
 $C2C9 LD ($BB9F),HL ; }
 $C2CC SRL E         ; {Move the screen position on by half of that, and keep
 $C2CE LD HL,($BBA1) ; the old one.
 $C2D1 PUSH HL       ;
 $C2D2 ADD HL,DE     ;
 $C2D3 LD ($BBA1),HL ;
 $C2D6 POP HL        ;
 $C2D7 LD ($BBAF),HL ; }
 $C2DA JR $C2DF      ; Draw the shape.
@label=DrawBlock_Next
*$C2DC PUSH IY       ; Remember the drawing variables.
 $C2DE PUSH AF       ; Remember the shape byte.
; Patch the draw routines from the block shape table, then draw the
; section. A shape number of #N$11 takes its row size from the third size.
@label=DrawBlock_Shape
*$C2DF LD A,(IY+$04) ; {Read the shape number.
 $C2E2 LD E,A        ; }
 $C2E3 CP $11        ; {Replace the sizes when the shape number is #N$11.
 $C2E5 JR NZ,$C2F7   ; }
 $C2E7 LD A,($5CF5)  ; {Take the high nibble of the third size.
 $C2EA SRL A         ;
 $C2EC RRA           ;
 $C2ED RRA           ;
 $C2EE RRA           ; }
 $C2EF LD ($BBA4),A  ; Use it as the row size.
 $C2F2 LD A,$01      ; {Use a column size of one.
 $C2F4 LD ($BBA5),A  ; }
@label=DrawBlock_Count
*$C2F7 LD D,$00      ; {Look the shape up in the block shape table.
 $C2F9 LD C,E        ;
 $C2FA LD HL,$B913   ;
 $C2FD ADD HL,DE     ;
 $C2FE LD A,(HL)     ; }
 $C2FF AND %01111111 ; Keep the row count.
 $C301 LD ($C5E9),A  ; {Give the row count to the row routines.
 $C304 LD ($C739),A  ; }
 $C307 LD A,(HL)     ; Read the same table byte again.
 $C308 AND %10000000 ; Keep its top bit.
 $C30A LD ($C5F3),A  ; {Give that bit to the row routines.
 $C30D LD ($C742),A  ; }
 $C310 LD L,(IY+$00) ; {Fetch the origin and the screen position.
 $C313 LD H,(IY+$01) ;
 $C316 LD E,(IY+$02) ;
 $C319 LD D,(IY+$03) ; }
 $C31C LD A,(IY+$05) ; {Give the row size to the shape routine.
 $C31F LD ($C3D5),A  ; }
 $C322 LD B,(IY+$06) ; Fetch the column size.
 $C325 LD A,C        ; {Give the shape number to the shape routine.
 $C326 LD ($C3BE),A  ; }
 $C329 ADD A,A       ; {Multiply the shape number by seven.
 $C32A ADD A,A       ;
 $C32B ADD A,A       ;
 $C32C SUB C         ; }
 $C32D EXX           ; {Find this shape's seven-byte record.
 $C32E LD E,A        ;
 $C32F LD D,$00      ;
 $C331 LD IY,$B92F   ;
 $C335 ADD IY,DE     ;
 $C337 EXX           ; }
 $C338 LD A,($C1A0)  ; {Skip the edge bytes when the shape index was not
 $C33B CP $E6        ; patched.
 $C33D JR Z,$C352    ; }
 $C33F LD A,(IY+$05) ; {Give the shape's first edge, less one, to the overlap
 $C342 DEC A         ; test.
 $C343 LD ($C67C),A  ; }
 $C346 LD A,(IY+$06) ; {Give the shape's other edge to the overlap test.
 $C349 LD ($C688),A  ;
 $C34C LD ($C69A),A  ;
 $C34F LD ($C6B5),A  ; }
@label=DrawBlock_Edges
*$C352 LD A,(IY+$06) ; {Give the row offset to the row test.
 $C355 ADD A,$06     ;
 $C357 LD ($C72A),A  ; }
 $C35A LD A,(IY+$00) ; Read the shape's position byte.
 $C35D BIT 7,A       ; {Add the offset when that byte is positive.
 $C35F JR Z,$C367    ; }
 $C361 ADD A,E       ; {Keep a negative position that overflowed.
 $C362 JR C,$C36C    ; }
 $C364 DEC D         ; {Sign-extend that negative position.
 $C365 JR $C36C      ; }
@label=DrawBlock_Offset
*$C367 ADD A,E       ; {Add the offset to a positive position.
 $C368 LD E,A        ;
 $C369 JR NC,$C36C   ; }
 $C36B INC D         ; Count the carry in the high byte.
@label=DrawBlock_Section
*$C36C CALL $C381    ; Draw this section of the block.
 $C36F POP AF        ; {Finish when the shape byte has no further section.
 $C370 POP IY        ;
 $C372 SUB $40       ;
 $C374 JR C,$C37E    ; }
 $C376 LD DE,$0007   ; {Step on seven bytes and draw the next section.
 $C379 ADD IY,DE     ;
 $C37B JP $C2DC      ; }
@label=DrawBlock_Return
*$C37E POP IX        ; Restore the object.
 $C380 RET           ; Return.

; Draw Block Shape
;
; Used by the routine at #R$C15E.
; .
; Copies the four step bytes of the shape into this routine and
; sign-extends each one, then draws the block. A shape below #N$09, and shape
; #N$11, is drawn here a row at a time. Shapes #N$09 to #N$10 are drawn by
; #R$C418 and shapes #N$12 to #N$15 by #R$C3F7. #R$C15E patches in the shape
; number and the row count.
;
; IY The shape
;
; Each step byte of the shape is sign-extended into a word that the row
; loops add to the screen address and the sprite address.
@label=DrawBlockShape
c$C381 LD A,(IY+$01) ; Read the shape's first step.
 $C384 LD ($C3DC),A  ; Keep it as the low byte of a row step.
 $C387 RLA           ; {Sign-extend it when its top bit is set.
 $C388 LD A,$00      ;
 $C38A JR NC,$C38D   ; }
 $C38C DEC A         ; The high byte is #N$FF.
@label=DrawBlockShape_High
*$C38D LD ($C3DD),A  ; Keep the high byte of the row step.
 $C390 LD A,(IY+$02) ; Read the shape's second step.
 $C393 LD ($C3E1),A  ; Keep it as the low byte of the other row step.
 $C396 RLA           ; {Sign-extend it when its top bit is set.
 $C397 LD A,$00      ;
 $C399 JR NC,$C39C   ; }
 $C39B DEC A         ; The high byte is #N$FF.
@label=DrawBlockShape_High2
*$C39C LD ($C3E2),A  ; Keep that high byte.
 $C39F LD A,(IY+$04) ; Read the shape's fourth byte.
 $C3A2 LD ($C3EA),A  ; Keep it as the low byte of a column step.
 $C3A5 RLA           ; {Sign-extend it when its top bit is set.
 $C3A6 LD A,$00      ;
 $C3A8 JR NC,$C3AB   ; }
 $C3AA DEC A         ; The high byte is #N$FF.
@label=DrawBlockShape_High3
*$C3AB LD ($C3EB),A  ; Keep that high byte.
 $C3AE LD A,(IY+$03) ; Read the shape's third byte.
 $C3B1 LD ($C3F0),A  ; Keep it as the low byte of the other column step.
 $C3B4 RLA           ; {Sign-extend it when its top bit is set.
 $C3B5 LD A,$00      ;
 $C3B7 JR NC,$C3BA   ; }
 $C3B9 DEC A         ; The high byte is #N$FF.
@label=DrawBlockShape_High4
*$C3BA LD ($C3F1),A  ; Keep that high byte.
 $C3BD LD A,$00      ; Read the shape number. The byte is patched.
 $C3BF CP $09        ; {A shape below #N$09 is drawn here.
 $C3C1 JR C,$C3C8    ; }
 $C3C3 CP $11        ; {Shapes #N$09 to #N$10 use the third shape.
 $C3C5 JP C,$C418    ; }
@label=DrawBlockShape_Second
*$C3C8 CP $12        ; {Shape #N$11 is drawn here.
 $C3CA JR C,$C3D1    ; }
 $C3CC CP $16        ; {Shapes #N$12 to #N$15 use the second shape.
 $C3CE JP C,$C3F7    ; }
@label=DrawBlockShape_Rows
*$C3D1 PUSH BC       ; {Remember the column count and both addresses.
 $C3D2 PUSH HL       ;
 $C3D3 PUSH DE       ; }
 $C3D4 LD B,$00      ; Take the patched row count.
@label=DrawBlockShape_Loop
*$C3D6 PUSH BC       ; Remember how many rows remain.
 $C3D7 CALL $C59A    ; Draw this row.
; This entry point is used by the routine at #R$C3F7.
@label=DrawBlockShape_Resume
*$C3DA EXX           ; {Step both addresses on by the row steps.
 $C3DB LD BC,$0000   ;
 $C3DE ADD HL,BC     ;
 $C3DF EX DE,HL      ;
 $C3E0 LD BC,$0000   ;
 $C3E3 ADD HL,BC     ;
 $C3E4 EX DE,HL      ; }
 $C3E5 POP BC        ; Bring the row count back.
 $C3E6 DJNZ $C3D6    ; Repeat for the remaining rows.
 $C3E8 POP HL        ; Restore the screen address.
 $C3E9 LD BC,$0000   ; {Step on by the column step.
 $C3EC ADD HL,BC     ; }
 $C3ED EX DE,HL      ; Switch the addresses.
 $C3EE POP HL        ; Restore the sprite address.
 $C3EF LD BC,$0000   ; {Step it on by the other column step.
 $C3F2 ADD HL,BC     ; }
 $C3F3 POP BC        ; Bring the column count back.
 $C3F4 DJNZ $C3D1    ; Repeat for the remaining columns.
 $C3F6 RET           ; Return.

; Draw Block Shape Two
;
; Used by the routine at #R$C381.
; .
; Draws one part of a block whose shape is #N$12 to #N$15, lengthens both
; row counts by two, then jumps into #R$C381 to finish.
@label=DrawBlockShapeTwo
c$C3F7 PUSH BC       ; {Remember the counts and the position.
 $C3F8 PUSH HL       ;
 $C3F9 PUSH DE       ; }
 $C3FA LD BC,($C3D8) ; {Use the row routine chosen for this view.
 $C3FE LD ($C408),BC ; }
 $C402 LD A,($C3D5)  ; {Draw this part.
 $C405 LD B,A        ;
 $C406 PUSH BC       ;
 $C407 CALL $C59A    ; }
 $C40A LD A,($C5E9)  ; {Lengthen both row counts by two.
 $C40D ADD A,$02     ;
 $C40F LD ($C5E9),A  ;
 $C412 LD ($C739),A  ; }
 $C415 JP $C3DA      ; Continue with the rest of the shape.

; Draw Block Shape Three
;
; Used by the routine at #R$C381.
; .
; Draws a block whose shape number is #N$09 to #N$10. #R$C381 has already
; copied the shape's steps into this routine. The shape number chooses the
; edges: shapes below #N$0B use one edge, #N$0B and #N$0C leave the edges
; alone, #N$0D and #N$0E use two, and #N$0F and #N$10 lengthen the row count
; by #N$0E as well. Each column is drawn a row at a time by #R$C59A.
;
; .
;
; The shape number is in #REGa. It chooses how many edge steps this column
; adds, and which edges are written before a single-row column.
@label=DrawBlockShapeThree
c$C418 PUSH HL         ; Remember the screen address.
 $C419 LD L,$01        ; {One edge step for a shape below #N$0B.
 $C41B LD H,L          ;
 $C41C CP $0B          ;
 $C41E JR C,$C431      ; }
 $C420 INC H           ; {Two edge steps for shape #N$0D or #N$0E.
 $C421 CP $0D          ;
 $C423 JR Z,$C431      ;
 $C425 CP $0E          ;
 $C427 JR Z,$C431      ; }
 $C429 INC L           ; {None for shape #N$0B or #N$0C, and three for a higher
 $C42A INC H           ; shape.
 $C42B CP $0E          ;
 $C42D JR NC,$C431     ;
 $C42F LD H,$00        ; }
@label=DrawBlockShapeThree_Steps
*$C431 LD A,L          ; {Remember how many steps this column adds.
 $C432 LD ($C504),A    ; }
 $C435 LD A,H          ; {Remember the edge choice.
 $C436 LD ($C46F),A    ;
 $C439 LD ($C4F1),A    ; }
 $C43C XOR A           ; {Clear the running total of steps.
 $C43D LD ($C502),A    ; }
 $C440 LD A,($C3D5)    ; {Copy the row count into the row loop.
 $C443 LD ($C469),A    ; }
 $C446 LD HL,($C3D8)   ; {Copy the row routine and the four steps from the
 $C449 LD ($C4CB),HL   ; shape.
 $C44C LD HL,($C3DC)   ;
 $C44F LD ($C4CF),HL   ;
 $C452 LD HL,($C3E1)   ;
 $C455 LD ($C4D4),HL   ;
 $C458 LD HL,($C3EA)   ;
 $C45B LD ($C513),HL   ;
 $C45E LD HL,($C3F0)   ;
 $C461 LD ($C519),HL   ; }
 $C464 POP HL          ; Restore the screen address.
@label=DrawBlockShapeThree_Rows
*$C465 PUSH BC         ; {Remember the column count and both addresses.
 $C466 PUSH HL         ;
 $C467 PUSH DE         ; }
 $C468 LD B,$00        ; Take the row count.
; The edges are changed only when a single row remains, and only for an
; edge choice other than zero.
@label=DrawBlockShapeThree_Columns
*$C46A PUSH BC         ; Remember the row count.
 $C46B DEC B           ; {Change the edges only when a single row remains.
 $C46C JR NZ,$C4CA     ; }
 $C46E LD A,$00        ; Read the edge choice.
 $C470 AND A           ; {Leave the edges as they are when the choice is zero.
 $C471 JR Z,$C4CA      ; }
 $C473 RRA             ; {The low bit of the choice selects the wide edges.
 $C474 JR C,$C492      ; }
 $C476 LD A,($C502)    ; Read the running total of steps.
 $C479 RRA             ; {Use the narrow edges only when that total is odd.
 $C47A JR NC,$C4CA     ; }
 $C47C LD (IY+$06),$08 ; {Set the edges to #N$08.
 $C480 LD A,$08        ;
 $C482 LD ($C688),A    ;
 $C485 LD ($C69A),A    ;
 $C488 LD ($C6B5),A    ;
 $C48B ADD A,$06       ;
 $C48D LD ($C72A),A    ;
 $C490 JR $C4CA        ; }
@label=DrawBlockShapeThree_Wide
*$C492 LD (IY+$06),$18 ; {Set the edges to #N$18.
 $C496 LD B,A          ;
 $C497 LD A,$18        ;
 $C499 LD ($C688),A    ;
 $C49C LD ($C69A),A    ;
 $C49F LD ($C6B5),A    ;
 $C4A2 ADD A,$06       ;
 $C4A4 LD ($C72A),A    ; }
 $C4A7 RR B            ; {A choice of three also sets the edges to #N$10 and lengthens the
 $C4A9 JR NC,$C4CA     ; rows.
 $C4AB LD (IY+$06),$10 ;
 $C4AF LD A,$10        ;
 $C4B1 LD ($C688),A    ;
 $C4B4 LD ($C69A),A    ;
 $C4B7 LD ($C6B5),A    ;
 $C4BA ADD A,$06       ;
 $C4BC LD ($C72A),A    ;
 $C4BF LD A,($C5E9)    ;
 $C4C2 ADD A,$0E       ;
 $C4C4 LD ($C5E9),A    ;
 $C4C7 LD ($C739),A    ; }
@label=DrawBlockShapeThree_Draw
*$C4CA CALL $C59A      ; Draw this row. The routine is patched.
 $C4CD EXX             ; {Step both addresses on by the shape's row steps.
 $C4CE LD BC,$0000     ;
 $C4D1 ADD HL,BC       ;
 $C4D2 EX DE,HL        ;
 $C4D3 LD BC,$0000     ;
 $C4D6 ADD HL,BC       ;
 $C4D7 EX DE,HL        ; }
 $C4D8 POP BC          ; {Repeat for the remaining rows.
 $C4D9 DJNZ $C46A      ; }
 $C4DB POP HL          ; Restore the screen address.
 $C4DC LD (IY+$06),$18 ; {Put the edges back to #N$18.
 $C4E0 LD A,$18        ;
 $C4E2 LD ($C6B5),A    ;
 $C4E5 LD ($C688),A    ;
 $C4E8 LD ($C69A),A    ;
 $C4EB ADD A,$06       ;
 $C4ED LD ($C72A),A    ; }
 $C4F0 LD A,$00        ; {A choice of three shortens the row count again.
 $C4F2 CP $03          ;
 $C4F4 JR NZ,$C501     ;
 $C4F6 LD A,($C5E9)    ;
 $C4F9 SUB $0E         ;
 $C4FB LD ($C5E9),A    ;
 $C4FE LD ($C739),A    ; }
*$C501 LD A,$00        ; {Add this column's steps to the running total.
 $C503 ADD A,$00       ;
 $C505 LD ($C502),A    ; }
 $C508 RRA             ; {Shorten the remaining rows when the total overflows.
 $C509 JR C,$C512      ;
 $C50B LD A,($C469)    ;
 $C50E DEC A           ;
 $C50F LD ($C469),A    ; }
*$C512 LD BC,$0000     ; {Step the screen address on by the column step.
 $C515 ADD HL,BC       ;
 $C516 EX DE,HL        ; }
 $C517 POP HL          ; {Restore the sprite address and step it on too.
 $C518 LD BC,$0000     ;
 $C51B ADD HL,BC       ; }
 $C51C POP BC          ; {Repeat for the remaining columns.
 $C51D DEC B           ;
 $C51E JP NZ,$C465     ; }
 $C521 RET             ; Return.

; Flip Block Data
;
; Used by the routines at #R$C59A and #R$C72E.
; .
; Flips the data of a block horizontally, by reversing the bits of each
; byte with the table at #N$F900 and swapping the bytes. The flag in bit 7 of
; the first byte is changed to record the flip. This version is for blocks that
; are #N$10 pixels wide.
;
; HL The address of the data of the block
; IY The shape
;
; The first byte of the tile is a flag. A row size other than #N$10 is
; flipped by #R$C556 instead. The mirror of each byte is on page #N$F9.
@label=FlipBlockData
c$C522 LD A,(HL)     ; Read the tile's flag.
 $C523 XOR %10000000 ; Toggle its top bit.
 $C525 LD (HL),A     ; Write the flag back.
 $C526 PUSH HL       ; {Remember the tile and move past the flag.
 $C527 INC HL        ; }
 $C528 PUSH DE       ; {Remember the addresses.
 $C529 PUSH BC       ; }
 $C52A LD A,(IY+$05) ; Read the row size.
 $C52D CP $10        ; The narrow flip is for a row size of #N$10.
 $C52F LD ($C550),SP ; Remember the stack pointer.
 $C533 JP NZ,$C556   ; Flip a wide tile when the row size differs.
 $C536 LD A,(IY+$06) ; {Read the tile through the stack. The count is the
 $C539 LD SP,HL      ; position byte.}
 $C53A LD H,$F9      ; Use the mirror table on page #N$F9.
@label=FlipBlockData_Loop
*$C53C EX AF,AF'     ; Remember how many rows remain.
 $C53D POP DE        ; {Mirror four bytes of the tile.
 $C53E POP BC        ;
 $C53F LD L,E        ;
 $C540 LD E,(HL)     ;
 $C541 LD L,D        ;
 $C542 LD D,(HL)     ;
 $C543 LD L,C        ;
 $C544 LD C,(HL)     ;
 $C545 LD L,B        ;
 $C546 LD B,(HL)     ;
 $C547 PUSH DE       ;
 $C548 PUSH BC       ;
 $C549 POP DE        ;
 $C54A POP DE        ; }
 $C54B EX AF,AF'     ; Bring the count back.
 $C54C DEC A         ; {Repeat for the remaining rows.
 $C54D JR NZ,$C53C   ; }
; This entry point is used by the routine at #R$C556.
@label=FlipBlockData_Exit
*$C54F LD SP,$0000   ; Restore the stack pointer.
 $C552 POP BC        ; {Restore the saved registers.
 $C553 POP DE        ;
 $C554 POP HL        ; }
 $C555 RET           ; Return.

; Flip Wide Block Data
;
; Used by the routine at #R$C522.
; .
; Flips the data of a block horizontally, as #R$C522 does, for blocks
; that are wider than #N$10 pixels.
;
; IY The shape
;
; The mirror of each byte is taken from the table on page #N$F9. The
; count is the shape's position byte.
@label=FlipWideBlockData
c$C556 LD SP,HL      ; Read the tile through the stack.
 $C557 LD A,(IY+$06) ; {Step four bytes on for each unit of the position byte.
 $C55A LD E,A        ;
 $C55B SLA E         ;
 $C55D SLA E         ;
 $C55F LD D,$00      ;
 $C561 ADD HL,DE     ; }
 $C562 EX DE,HL      ; Keep the far end of the row.
 $C563 LD H,$F9      ; Use the mirror table on page #N$F9.
@label=FlipWideBlockData_Loop
*$C565 EX AF,AF'     ; Remember how many rows remain.
 $C566 INC DE        ; {Flip four bytes of the tile.
 $C567 INC DE        ;
 $C568 POP BC        ;
 $C569 LD L,C        ;
 $C56A LD C,(HL)     ;
 $C56B LD A,(DE)     ;
 $C56C LD L,A        ;
 $C56D LD A,C        ;
 $C56E LD (DE),A     ;
 $C56F LD C,(HL)     ;
 $C570 INC DE        ;
 $C571 LD L,B        ;
 $C572 LD B,(HL)     ;
 $C573 LD A,(DE)     ;
 $C574 LD L,A        ;
 $C575 LD A,B        ;
 $C576 LD (DE),A     ;
 $C577 LD B,(HL)     ;
 $C578 PUSH BC       ;
 $C579 POP BC        ;
 $C57A DEC DE        ;
 $C57B DEC DE        ;
 $C57C DEC DE        ;
 $C57D POP BC        ;
 $C57E LD L,C        ;
 $C57F LD C,(HL)     ;
 $C580 LD A,(DE)     ;
 $C581 LD L,A        ;
 $C582 LD A,C        ;
 $C583 LD (DE),A     ;
 $C584 LD C,(HL)     ;
 $C585 INC DE        ;
 $C586 LD L,B        ;
 $C587 LD B,(HL)     ;
 $C588 LD A,(DE)     ;
 $C589 LD L,A        ;
 $C58A LD A,B        ;
 $C58B LD (DE),A     ;
 $C58C LD B,(HL)     ;
 $C58D PUSH BC       ;
 $C58E POP BC        ;
 $C58F INC DE        ;
 $C590 INC DE        ;
 $C591 INC DE        ; }
 $C592 EX AF,AF'     ; Bring the count back.
 $C593 DEC A         ; {Repeat for the remaining rows.
 $C594 JP NZ,$C565   ; }
 $C597 JP $C54F      ; Join the end of the narrow flip.

; Draw Block Row
;
; Used by the routines at #R$C381, #R$C3F7 and #R$C418.
; .
; Draws one row of a block into the screen buffer. A row outside the view
; is left undrawn. The tile is the word at #N$666E indexed by the patched row
; count, and #R$C522 flips it when its top bit differs. Two masked bytes are
; drawn, then the routine steps up one screen row, for the height of the row.
;
; HL The first coordinate of the position
; DE The second coordinate of the position
;
; The position arrives in the alternate registers. A row whose page,
; column or size is outside the view is left undrawn.
@label=DrawBlockRow
c$C59A PUSH HL        ; {Take the position from the alternate registers.
 $C59B PUSH DE        ;
 $C59C EXX            ;
 $C59D POP DE         ;
 $C59E POP HL         ; }
 $C59F LD A,H         ; {Return unless the row is on the drawable page.
 $C5A0 CP $80         ;
 $C5A2 RET NZ         ; }
 $C5A3 LD A,L         ; {Return when the column is past the view.
 $C5A4 CP $B1         ;
 $C5A6 RET NC         ; }
 $C5A7 ADD A,(IY+$05) ; {Return when the row size does not reach the view.
 $C5AA CP $C0         ;
 $C5AC RET C          ; }
 $C5AD LD A,D         ; {Return unless the other address is on the same page.
 $C5AE CP $80         ;
 $C5B0 RET NZ         ; }
 $C5B1 LD H,E         ; Keep the row.
 $C5B2 LD B,(IY+$06)  ; Take the shape's position byte as the height.
 $C5B5 LD A,E         ; {Start with no column offset.
 $C5B6 LD C,$00       ; }
 $C5B8 SUB B          ; {The row starts above the view when it is below that
 $C5B9 JR C,$C5D0     ; position.}
 $C5BB CP $78         ; {A row at #N$78 or beyond is off the view.
 $C5BD RET NC         ; }
 $C5BE LD A,H         ; {Shorten a row that starts above the drawable page.
 $C5BF SUB $7F        ;
 $C5C1 JR C,$C5D2     ; }
 $C5C3 LD C,A         ; {Shorten the height by four times that overflow.
 $C5C4 SLA C          ;
 $C5C6 SLA C          ;
 $C5C8 NEG            ;
 $C5CA ADD A,B        ;
 $C5CB LD B,A         ; }
 $C5CC LD H,$7F       ; {Start the row at #N$7F.
 $C5CE JR $C5D2       ; }
@label=DrawBlockRow_Above
*$C5D0 LD B,H         ; {Use the whole height when the row starts above the
 $C5D1 INC B          ; position.}
@label=DrawBlockRow_Tile
*$C5D2 LD A,L         ; {A column of #N$B0 needs no extra offset.
 $C5D3 CP $B0         ;
 $C5D5 JR Z,$C5E4     ; }
 $C5D7 LD A,(IY+$05)  ; {A row size of #N$10 is not drawn.
 $C5DA CP $10         ;
 $C5DC RET Z          ; }
 $C5DD LD A,(IY+$06)  ; {The offset is four times the position byte.
 $C5E0 ADD A,A        ;
 $C5E1 ADD A,A        ;
 $C5E2 ADD A,C        ;
 $C5E3 LD C,A         ; }
@label=DrawBlockRow_Draw
*$C5E4 LD A,H         ; Keep the row number.
 $C5E5 LD HL,$666E    ; {Look the tile up. The index and its high byte are
 $C5E8 LD E,$00       ; patched.
 $C5EA LD D,$00       ; }
 $C5EC ADD HL,DE      ; Add the index.
 $C5ED LD E,A         ; Keep the row number.
 $C5EE LD A,(HL)      ; {Read the tile address.
 $C5EF INC HL         ;
 $C5F0 LD H,(HL)      ;
 $C5F1 LD L,A         ; }
 $C5F2 LD A,$00       ; {Compare the tile with the patched top bit.
 $C5F4 XOR (HL)       ; }
 $C5F5 CALL NZ,$C522  ; Flip the tile when they differ.
 $C5F8 LD A,L         ; {Add the column offset to the tile address.
 $C5F9 ADD A,C        ;
 $C5FA LD L,A         ;
 $C5FB JR NC,$C5FE    ; }
 $C5FD INC H          ; Count the carry in the high byte.
@label=DrawBlockRow_Offset
*$C5FE INC HL         ; {Remember the stack and read the tile through it.
 $C5FF LD ($5CDA),SP  ;
 $C603 LD SP,HL       ; }
 $C604 EX DE,HL       ; {Turn the row number into a screen address, #N$18 bytes
 $C605 ADD HL,HL      ; per row.
 $C606 ADD HL,HL      ;
 $C607 ADD HL,HL      ;
 $C608 LD E,L         ;
 $C609 LD D,H         ;
 $C60A ADD HL,HL      ;
 $C60B ADD HL,DE      ; }
 $C60C LD DE,($5CBB)  ; {Add the strip address.
 $C610 ADD HL,DE      ; }
; This entry point is used by the routine at #R$C76D.
@label=DrawBlockRow_Loop
*$C611 POP DE         ; {Draw one byte of the row.
 $C612 LD A,E         ;
 $C613 CPL            ;
 $C614 AND (HL)       ;
 $C615 OR D           ;
 $C616 LD (HL),A      ;
 $C617 INC HL         ; }
 $C618 POP DE         ; {Draw the other byte of the row.
 $C619 LD A,E         ;
 $C61A CPL            ;
 $C61B AND (HL)       ;
 $C61C OR D           ;
 $C61D LD (HL),A      ; }
 $C61E LD DE,$FFE7    ; {Step up to the next row of the screen.
 $C621 ADD HL,DE      ; }
 $C622 DJNZ $C611     ; Repeat for the remaining rows.
 $C624 LD SP,($5CDA)  ; Restore the stack pointer.
 $C628 RET            ; Return.

; Clip Span
;
; Works out how much of a span is in view. Purpose not yet known.
@label=ClipSpan
c$C629 LD H,$00      ; #REGh is #N$00.
 $C62B LD A,L        ; #REGl moves into #REGa.
 $C62C SUB E         ; Subtract #REGe.
 $C62D JR C,$C63B    ; Jump to #R$C629(#N$C63B) if the carry flag is set.
 $C62F LD H,A        ; #REGa moves into #REGh.
 $C630 SUB B         ; Subtract #REGb.
 $C631 RET NC        ; Return if the carry flag is reset.
 $C632 LD L,E        ; #REGe moves into #REGl.
 $C633 NEG           ; Negate #REGa.
 $C635 LD B,A        ; #REGa moves into #REGb.
 $C636 CP C          ; Compare #REGa with #REGc.
 $C637 RET C         ; Return if the carry flag is set.
 $C638 LD B,C        ; #REGc moves into #REGb.
@label=ClipSpan_Loop
*$C639 SCF           ; Set the carry flag.
 $C63A RET           ; Return.
@label=ClipSpan_Skip
*$C63B ADD A,C       ; Plus #REGc.
 $C63C RET NC        ; Return if the carry flag is reset.
 $C63D JR Z,$C644    ; Jump to #R$C629(#N$C644) if the zero flag is set.
 $C63F CP B          ; Compare #REGa with #REGb.
 $C640 JR NC,$C639   ; Jump to #R$C629(#N$C639) if the carry flag is reset.
 $C642 LD B,A        ; #REGa moves into #REGb.
 $C643 RET           ; Return.
@label=ClipSpan_Skip2
*$C644 XOR A         ; Set #REGa to zero.
 $C645 RET           ; Return.

; Draw Overlapped Block
;
; Draws a block in the parts left uncovered by entities drawn earlier.
; Those entities are in the table at #R$B1B2(#N$B1B3), four bytes each, and the
; count is patched into this routine. Each item that covers the row leaves a
; span, which #R$C6C5 draws.
;
; .
;
; The two limits of the row are remembered, and the count of overlapping
; items is patched into the loop.
@label=DrawOverlappedBlock
c$C646 LD ($C657),HL  ; Remember the first limit.
 $C649 LD ($C680),DE  ; Remember the second limit.
 $C64D EXX            ; Use the limits' register set.
 $C64E LD IX,$B1B3    ; Start at the first overlapping item.
 $C652 LD B,$00       ; The number of items is patched.
 $C654 AND A          ; Clear the carry for the comparison.
@label=DrawOverlappedBlock_Loop
*$C655 PUSH BC        ; Remember how many items remain.
 $C656 LD HL,$0000    ; Read the patched first limit.
 $C659 LD A,L         ; Take its low byte.
 $C65A AND %11111000  ; Use the patched mask.
 $C65C OR %00000000   ; Apply the patched bits.
 $C65E LD L,A         ; {Remember the masked limit.
 $C65F LD ($C7AD),A   ; }
 $C662 LD D,$80       ; {Take the item's first byte, with the patched high
 $C664 LD E,(IX+$00)  ; byte.}
 $C667 SBC HL,DE      ; Subtract it from the limit.
 $C669 JR C,$C677     ; The item starts above the row.
 $C66B LD A,H         ; {The item is a whole byte or more past the row.
 $C66C AND A          ;
 $C66D JR NZ,$C6BC    ; }
 $C66F LD A,L         ; {The gap is at least the item's next byte.
 $C670 SUB (IX+$02)   ;
 $C673 JR NC,$C6BC    ; }
 $C675 JR $C67F       ; Join the second limit.
@label=DrawOverlappedBlock_Above
*$C677 INC H          ; {The other side is a whole byte or more away.
 $C678 JR NZ,$C6BC    ; }
 $C67A LD A,L         ; {The item's extra size does not reach the row.
 $C67B ADD A,$00      ;
 $C67D JR NC,$C6BC    ; }
@label=DrawOverlappedBlock_Second
*$C67F LD HL,$0000    ; Read the patched second limit.
 $C682 SLA H          ; {The high byte has to be clear.
 $C684 JR NZ,$C6BC    ; }
 $C686 LD A,L         ; {The low byte has to reach the patched edge.
 $C687 SUB $00        ;
 $C689 JR C,$C68F     ; }
 $C68B INC A          ; {Shift that distance up.
 $C68C RLA            ; }
 $C68D JR C,$C6BC     ; A distance that overflowed does not cover the row.
@label=DrawOverlappedBlock_Height
*$C68F LD B,(IY+$06)  ; Read the shape's position byte.
 $C692 LD A,L         ; {Subtract the item's byte from the distance.
 $C693 SUB (IX+$01)   ; }
 $C696 JR C,$C6AD     ; The item covers the far side of the row.
 $C698 LD H,A         ; The remainder is the height so far.
 $C699 SUB $00        ; {A remainder past the patched edge does not cover the
 $C69B JR NC,$C6BC    ; row.}
 $C69D LD L,(IX+$01)  ; {The height is the item's byte, negated.
 $C6A0 NEG            ;
 $C6A2 LD B,A         ; }
 $C6A3 CP (IX+$03)    ; {Use the smaller of that height and the item's other
 $C6A6 JR C,$C6B9     ; byte.}
 $C6A8 LD B,(IX+$03)  ; {Use the item's byte when it is the smaller.
 $C6AB JR $C6B9       ; }
@label=DrawOverlappedBlock_Far
*$C6AD ADD A,(IX+$03) ; Add the item's byte to the distance.
 $C6B0 JR NC,$C6BC    ; {The sum has to reach past zero.
 $C6B2 JR Z,$C6BC     ; }
 $C6B4 CP $00         ; {Use the patched edge when the sum is below it.
 $C6B6 JR NC,$C6B9    ; }
 $C6B8 LD B,A         ; The height is that sum.
@label=DrawOverlappedBlock_Draw
*$C6B9 CALL $C6C5     ; Draw the span that this item leaves.
@label=DrawOverlappedBlock_Next
*$C6BC LD BC,$0004    ; {Move on to the next item.
 $C6BF ADD IX,BC      ; }
 $C6C1 POP BC         ; Bring the count back.
 $C6C2 DJNZ $C655     ; Repeat for the remaining items.
 $C6C4 RET            ; Return.

; Draw Block Span
;
; Used by the routine at #R$C646.
; .
; Draws the part of a block that falls inside the view, then draws its
; tile with #R$C72E(#N$C735). A span that reaches #N$7F is shortened. The
; height is given to both row counts, and the row becomes a strip address.
@label=DrawBlockSpan
c$C6C5 LD A,L        ; {The span starts above the position byte.
 $C6C6 SUB B         ;
 $C6C7 JR NC,$C6CD   ; }
 $C6C9 LD B,L        ; {Use the whole span when it does.
 $C6CA INC B         ;
 $C6CB JR $C6DD      ; }
@label=DrawBlockSpan_Upper
*$C6CD LD A,L        ; {Shorten a span that starts at #N$7F or beyond.
 $C6CE SUB $7F       ;
 $C6D0 JR C,$C6DD    ; }
 $C6D2 LD C,A        ; {Shorten the height by that overflow.
 $C6D3 ADD A,H       ;
 $C6D4 LD H,A        ;
 $C6D5 LD A,C        ;
 $C6D6 NEG           ;
 $C6D8 ADD A,B       ; }
 $C6D9 RET Z         ; Nothing to draw when the height falls to zero.
 $C6DA LD B,A        ; {The height is what remains, and the row starts at
 $C6DB LD L,$7F      ; #N$7F.}
@label=DrawBlockSpan_Draw
*$C6DD LD A,B        ; {Give the height to both row counts.
 $C6DE LD ($C794),A  ;
 $C6E1 LD ($C7A6),A  ; }
 $C6E4 LD C,H        ; {The column offset is four times the row's high byte.
 $C6E5 SLA C         ;
 $C6E7 SLA C         ; }
 $C6E9 LD H,$00      ; {Turn the row into a screen address, #N$18 bytes per
 $C6EB ADD HL,HL     ; row.
 $C6EC ADD HL,HL     ;
 $C6ED ADD HL,HL     ;
 $C6EE LD E,L        ;
 $C6EF LD D,H        ;
 $C6F0 ADD HL,HL     ;
 $C6F1 ADD HL,DE     ; }
 $C6F2 LD DE,$E5B9   ; {Add the base just before the screen buffer.
 $C6F5 ADD HL,DE     ; }
 $C6F6 LD ($5CBB),HL ; Keep that as the strip address.
 $C6F9 LD A,($C657)  ; Read the column limit.
 $C6FC AND %11111000 ; Use its top five bits.
 $C6FE ADD A,$10     ; {Add #N$10 to make the limit passed to the tile.
 $C700 LD B,A        ; }
 $C701 JP $C735      ; Draw the tile.

; Draw Short Row
;
; Used by the routine at #R$C717.
; .
; Gives both row counts the height in #REGa plus one, draws the row with
; #R$C72E, and puts both counts back to #N$08.
@label=DrawShortRow
c$C704 INC A         ; The drawn height is one more than the value passed in.
 $C705 LD ($C794),A  ; {Give that height to both row counts.
 $C708 LD ($C7A6),A  ; }
 $C70B CALL $C72E    ; Draw the row.
 $C70E LD A,$08      ; {Put both row counts back to #N$08.
 $C710 LD ($C794),A  ;
 $C713 LD ($C7A6),A  ; }
 $C716 RET           ; Return.

; Test Block Row
;
; Tests a row against the view, using the position in the alternate
; registers. A row on the drawable page, with its column below #N$C1, is
; drawn by #R$C72E when it is before the patched row, or by #R$C704 when it
; is on that row. A row past it is left undrawn.
;
; HL The first coordinate of the position
; DE The second coordinate of the position
@label=TestBlockRow
c$C717 PUSH HL       ; {Take the position from the alternate registers.
 $C718 PUSH DE       ;
 $C719 EXX           ;
 $C71A POP DE        ;
 $C71B POP HL        ; }
 $C71C LD A,H        ; {Return unless the row is on the drawable page.
 $C71D CP $80        ;
 $C71F RET NZ        ; }
 $C720 LD A,L        ; {Return when the column is past #N$C0.
 $C721 CP $C1        ;
 $C723 RET NC        ; }
 $C724 LD A,D        ; {Return unless the other address is on the same page.
 $C725 CP $80        ;
 $C727 RET NZ        ; }
 $C728 LD A,E        ; {A row on the patched position is the short row.
 $C729 SUB $00       ;
 $C72B JR Z,$C704    ; }
 $C72D RET NC        ; A row past that position is left undrawn.
; Continue on to #R$C72E.

; Draw Block Row Data
;
; Used by the routine at #R$C704.
; .
; Finds the tile for a row in the table at #N$666E, flips it with #R$C522
; when its top bit differs, and draws it with #R$C76D. A row size of #N$10 is
; drawn at once. Any other size is given a limit of the column plus #N$10.
;
; .
;
; The column offset is four times the row, less #N$07. The tile index and
; its top bit are patched, as they are for #R$C59A.
@label=DrawBlockRowData
@label=TestBlockRow_Draw
c$C72E LD A,E        ; {The column offset is four times the row, less #N$07.
 $C72F SUB $07       ;
 $C731 ADD A,A       ;
 $C732 ADD A,A       ;
 $C733 LD C,A        ; }
 $C734 LD B,L        ; Keep the column.
; This entry point is used by the routine at #R$C6C5.
@label=DrawBlockRowData_Tile
*$C735 LD HL,$666E   ; {Look the tile up. The index is patched.
 $C738 LD E,$00      ;
 $C73A LD D,$00      ; }
 $C73C ADD HL,DE     ; Add the index.
 $C73D LD A,(HL)     ; {Read the tile address.
 $C73E INC HL        ;
 $C73F LD H,(HL)     ;
 $C740 LD L,A        ; }
 $C741 LD A,$00      ; {Compare the tile with the patched top bit.
 $C743 XOR (HL)      ; }
 $C744 CALL NZ,$C522 ; Flip the tile when they differ.
 $C747 LD A,L        ; {Add the column offset to the tile address.
 $C748 ADD A,C       ;
 $C749 LD L,A        ;
 $C74A JR NC,$C74D   ; }
 $C74C INC H         ; Count the carry in the high byte.
@label=DrawBlockRowData_Draw
*$C74D INC HL        ; Move past the tile's flag.
 $C74E LD A,(IY+$05) ; {A row size of #N$10 is drawn as it stands.
 $C751 CP $10        ; }
 $C753 LD A,B        ; Bring the column back.
 $C754 JR Z,$C76D    ; Draw it now when the row size is #N$10.
 $C756 PUSH HL       ; Remember the tile.
 $C757 ADD A,$10     ; {The limit passed to the drawer is the column plus
 $C759 LD ($C76C),A  ; #N$10.}
 $C75C LD A,B        ; Bring the column back.
 $C75D CALL $C76D    ; Draw the bytes.
 $C760 POP HL        ; Restore the tile.
 $C761 LD C,(IY+$06) ; {Step on by four times the position byte.
 $C764 SLA C         ;
 $C766 SLA C         ; }
 $C768 LD B,$00      ; {Add that step.
 $C76A ADD HL,BC     ; }
; This entry point is used by the routine at #R$C7AC.
@label=DrawBlockRowData_Limit
*$C76B LD A,$00      ; Use the patched limit. Drawing continues in #R$C76D.
; Continue on to #R$C76D.

; Draw Block Bytes
;
; Used by the routines at #R$C72E and #R$C7AC.
; .
; Draws the bytes of a row of a block into the screen buffer. A column
; below #N$10 is off the view, and a column of #N$C0 is drawn only when bits
; 1-2 of #R$5CF0 are clear. The tile is read through the stack. Those bits
; clear draw the bytes plain, with #R$C59A(#N$C611); otherwise #R$B508 shifts
; them.
;
; A The column
; HL The address of the data
@label=DrawBlockBytes
c$C76D CP $10        ; {A column below #N$10 is off the view.
 $C76F RET C         ; }
 $C770 LD C,A        ; Keep the column.
 $C771 CP $C0        ; {A column of #N$C0 needs the drawing flags.
 $C773 JR NZ,$C77C   ; }
 $C775 LD A,($5CF0)  ; Read the drawing flags.
 $C778 AND %00000110 ; Use bits 1-2 of the drawing flags.
 $C77A JR Z,$C77D    ; Draw when those bits are clear.
@label=DrawBlockBytes_Return
*$C77C RET NC        ; Leave a shifted column of #N$C0 undrawn.
@label=DrawBlockBytes_Offset
*$C77D SRL C         ; {The byte offset is the column divided by eight.
 $C77F SRL C         ;
 $C781 SRL C         ; }
 $C783 LD ($5CDA),SP ; Remember the stack pointer.
 $C787 LD SP,HL      ; Read the tile through the stack.
 $C788 LD HL,($5CBB) ; Fetch the strip address.
 $C78B LD B,$00      ; {Add the byte offset to the strip.
 $C78D ADD HL,BC     ; }
 $C78E LD A,($5CF0)  ; Read the drawing flags again.
 $C791 AND %00000110 ; Use bits 1-2 of the drawing flags.
 $C793 LD B,$08      ; {Draw the plain bytes when those bits are clear.
 $C795 JP Z,$C611    ; }
 $C798 EX DE,HL      ; Keep the strip address aside.
 $C799 ADD A,$F8     ; The shift selects the page of the shifted rows.
 $C79B LD HL,$B508   ; Use the two-byte shifted rows.
 $C79E LD ($B534),HL ; {Give that routine to the shifted drawer.
 $C7A1 LD ($B539),HL ; }
 $C7A4 LD H,A        ; Keep the page.
 $C7A5 LD A,$08      ; {The shifted row count is #N$08.
 $C7A7 EX AF,AF'     ; }
 $C7A8 LD A,(DE)     ; Read the first screen byte.
 $C7A9 JP $B508      ; Draw the shifted rows.

; Draw Block Section
;
; Draws a section of a block, once for each of the entities that overlap
; it. Purpose not yet known.
;
; IX The overlapping item
@label=DrawBlockSection
c$C7AC LD A,$00       ; #REGa is #N$00.
 $C7AE SUB (IX+$00)   ; Subtract field #N$00 of the entity.
 $C7B1 JR NC,$C7B7    ; Jump to #R$C7AC(#N$C7B7) if the carry flag is reset.
 $C7B3 CP $F1         ; {Jump to #R$C7CA if it is below #N$F1.
 $C7B5 JR C,$C7CA     ; }
@label=DrawBlockSection_Skip
*$C7B7 LD A,B         ; #REGb moves into #REGa.
 $C7B8 CALL $C76D     ; Call #R$C76D.
 $C7BB LD A,($C7AD)   ; Read the byte at #R$C7AC(#N$C7AD).
 $C7BE LD B,A         ; #REGa moves into #REGb.
 $C7BF LD A,(IX+$00)  ; Read field #N$00 of the entity.
 $C7C2 ADD A,(IX+$02) ; Add the high byte of the x coordinate.
 $C7C5 SUB B          ; Subtract #REGb.
 $C7C6 SUB $11        ; Subtract #N$11.
 $C7C8 JR C,$C7DE     ; Jump to #R$C7DE if the carry flag is set.
@label=DrawBlockSection_Next
*$C7CA POP HL         ; Bring back #REGhl.
 $C7CB LD C,(IY+$06)  ; Read field #N$06 of the other entity into #REGc.
 $C7CE SLA C          ; Shift #REGc left.
 $C7D0 SLA C          ; Shift #REGc left.
 $C7D2 LD B,$00       ; #REGb is #N$00.
 $C7D4 ADD HL,BC      ; #REGhl takes #REGbc.
 $C7D5 JP $C76B       ; Jump to #R$C72E(#N$C76B).
 $C7D8 CP $10         ; {Jump to #R$C7CA if it is #N$10 or more.
 $C7DA JR NC,$C7CA    ; }
 $C7DC JR $C7B7       ; Jump to #R$C7AC(#N$C7B7).
@label=DrawBlockSection_Return
*$C7DE POP HL         ; Bring back #REGhl.
 $C7DF RET            ; Return.

; Update View Flags
;
; Used by the routines at #R$C7E8, #R$C873, #R$C8E8 and #R$C93D.
; .
; Clears bits of the view flags at #R$5CE6 that are not set in #REGl.
;
; L The bits to keep
@label=UpdateViewFlags
c$C7E0 LD A,($5CE6)  ; Read the byte at #R$5CE6.
 $C7E3 AND L         ; Keep only the bits of #REGa that are set in #REGl.
 $C7E4 LD ($5CE6),A  ; Write #REGa at #R$5CE6.
 $C7E7 RET           ; Return.

; Scroll View Down
;
; Used by the routine at #R$CC71.
; .
; Scrolls the view down by eight rows when the player has moved towards
; the top of the view. The rows of the screen buffer are moved down with
; #R$C857, the new rows at the top are cleared with #R$C861, the view is moved
; with #R$B8F9 and the objects that have come into view are drawn using
; #R$C108.
;
; IX The player entity
;
; Check whether the player is near enough to the top of the view for the
; view to scroll down. If it is not, and the view is not part way through a
; scroll, stop scrolling.
@label=ScrollViewDown
c$C7E8 LD A,($5CE9)  ; {Fetch the scroll position, which is #N$10 when the view is at rest
 $C7EB LD C,A        ; and keep it in #REGc.}
 $C7EC LD A,(IX+$0F) ; {Fetch the row of the player on the screen and keep it
 $C7EF LD D,A        ; in #REGd.}
 $C7F0 CP $2E        ; {Jump to #R$C7FC if the player is near the top of the
 $C7F2 JR C,$C7FC    ; view.}
 $C7F4 LD A,C        ; Fetch the scroll position.
 $C7F5 LD L,$CF      ; Set the bits of the view flags to keep, to clear the
                     ; scroll bits.
 $C7F7 CP $10        ; {Jump to #R$C7E0 to clear the scroll bits of the view flags if the
 $C7F9 JP Z,$C7E0    ; view is at rest.}
; Work out how fast to scroll from the change in the row of the player on
; the screen. If the player is moving up then the view scrolls down faster.
@label=ScrollViewDown_Speed
*$C7FC LD A,($5CE6)  ; Fetch the view flags.
 $C7FF AND %11001111 ; Clear bits 4-5.
 $C801 LD L,A        ; Keep them in #REGl.
 $C802 LD A,($5CED)  ; Fetch the change in the row of the player.
 $C805 ADD A,A       ; Double it.
 $C806 JR NC,$C80F   ; Jump to #R$C80F if the player is not moving up.
 $C808 LD E,A        ; Use the doubled change as the amount to scroll.
 $C809 LD A,L        ; {Set bits 4-5 of the flags.
 $C80A OR $30        ;
 $C80C LD L,A        ; }
 $C80D JR $C815      ; Jump to #R$C815.
@label=ScrollViewDown_Slowest
*$C80F LD E,$FE      ; Scroll by the slowest amount, #N$FE.
 $C811 LD A,L        ; {Set bit 4 of the flags.
 $C812 OR $10        ;
 $C814 LD L,A        ; }
@label=ScrollViewDown_SetFlags
*$C815 LD A,L        ; {Store the view flags.
 $C816 LD ($5CE6),A  ; }
 $C819 LD A,E        ; {Add the amount to scroll to the scroll position.
 $C81A ADD A,C       ;
 $C81B LD ($5CE9),A  ; }
 $C81E JR NZ,$C824   ; Jump to #R$C824 unless the scroll position is zero.
 $C820 LD A,$10      ; Set the scroll position back to #N$10.
 $C822 JR $C829      ; Jump to #R$C829.
@label=ScrollViewDown_CheckWrap
*$C824 BIT 7,A       ; Test bit 7 of the scroll position.
 $C826 RET Z         ; Return if it has not gone below zero, as the view is not ready to
                     ; move by a whole row of the buffer.
 $C827 AND %00001111 ; Keep the low four bits as the new scroll position.
@label=ScrollViewDown_MoveRows
*$C829 LD ($5CE9),A  ; Store the scroll position.
; Move the view down by eight rows. The player moves down the screen by
; eight rows, the buffer is moved down, and the eight rows at the top are
; cleared and drawn again.
 $C82C LD A,(IX+$0F) ; Fetch the row of the player on the screen.
 $C82F ADD A,$08     ; Add #N$08.
 $C831 LD (IX+$0F),A ; Store it.
 $C834 LD ($5CEC),A  ; Store it as the last row of the player.
 $C837 LD HL,$F0FA   ; Point #REGhl at the end of the rows to be moved in the
                     ; buffer.
 $C83A LD B,$78      ; Set the number of rows to #N$78.
 $C83C CALL $C857    ; Move the rows of the buffer down.
 $C83F LD HL,$E67B   ; Point #REGhl at #R$E67B.
 $C842 CALL $C861    ; Clear the eight rows.
 $C845 LD DE,$0008   ; Set the distance to move the view origin, #N$0008.
 $C848 CALL $B8F9    ; Move the view origin.
 $C84B LD HL,$E661   ; Point #REGhl at the first rows of the buffer.
 $C84E LD ($5CBB),HL ; Store it as the place to draw to.
 $C851 LD HL,$C108   ; Point #REGhl at #R$C108.
 $C854 JP $BA75      ; Draw the objects of the level in the strip.

; Move Rows Down
;
; Used by the routine at #R$C7E8.
; .
; Copies #N$78 rows of the screen buffer downwards, by jumping into the
; code at #R$CB23.
;
; HL The address of the end of the rows to copy
; B The number of rows
@label=MoveRowsDown
c$C857 LD ($5CDA),SP ; Write #REGsp at #R$5CDA.
 $C85B LD SP,$F1BB   ; #REGsp is #N$F1BB.
 $C85E JP $CB2E      ; Jump to #R$CB2E.

; Clear Rows
;
; Used by the routines at #R$C7E8 and #R$C873.
; .
; Clears #N$C0 bytes, which are eight rows of the screen buffer, by
; pushing zeroes on the stack.
;
; HL The address of the end of the bytes to clear
@label=ClearRows
c$C861 LD ($5CDA),SP ; Write #REGsp at #R$5CDA.
 $C865 LD SP,HL      ; #REGhl moves into #REGsp.
 $C866 LD B,$60      ; #REGb is #N$60.
 $C868 LD DE,$0000   ; #REGde is #N$0000.
@label=ClearRows_Loop
*$C86B PUSH DE       ; Remember #REGde.
 $C86C DJNZ $C86B    ; Repeat from #R$C861(#N$C86B) while #REGb still counts.
 $C86E LD SP,($5CDA) ; Fetch the word at #R$5CDA into #REGsp.
 $C872 RET           ; Return.

; Scroll View Up
;
; Used by the routine at #R$CC71.
; .
; Scrolls the view up by eight rows when the player has moved towards the
; bottom of the view. The rows of the screen buffer are moved up with #R$C8D9,
; the new rows at the bottom are cleared with #R$C861, the view is moved with
; #R$B8F9 and the objects that have come into view are drawn using #R$C119.
;
; IX The player entity
;
; Check whether the player is near enough to the bottom of the view for
; the view to scroll up. If it is not, and the view is not part way through a
; scroll, stop scrolling.
@label=ScrollViewUp
c$C873 LD A,($5CE9)  ; {Fetch the scroll position, which is #N$10 when the view is at rest
 $C876 LD C,A        ; and keep it in #REGc.}
 $C877 LD A,(IX+$0F) ; {Fetch the row of the player on the screen and keep it
 $C87A LD D,A        ; in #REGd.}
 $C87B CP $61        ; {Jump to #R$C887 if the player is near the bottom of the
 $C87D JR NC,$C887   ; view.}
 $C87F LD A,C        ; Fetch the scroll position.
 $C880 LD L,$3F      ; Set the bits of the view flags to keep, to clear the
                     ; scroll bits.
 $C882 CP $10        ; {Jump to #R$C7E0 to clear the scroll bits of the view flags if the
 $C884 JP Z,$C7E0    ; view is at rest.}
; Work out how fast to scroll from the change in the row of the player on
; the screen. If the player is moving down then the view scrolls up faster.
@label=ScrollViewUp_Speed
*$C887 LD A,($5CE6)  ; Fetch the view flags.
 $C88A AND %00111111 ; Clear bits 6-7.
 $C88C LD L,A        ; Keep them in #REGl.
 $C88D LD A,($5CED)  ; Fetch the change in the row of the player.
 $C890 ADD A,A       ; Double it.
 $C891 JR Z,$C89C    ; Jump to #R$C89C if the player is not moving.
 $C893 JR C,$C89C    ; Jump to #R$C89C if the player is moving up.
 $C895 LD E,A        ; Use the doubled change as the amount to scroll.
 $C896 LD A,L        ; {Set bits 6-7 of the flags.
 $C897 OR $C0        ;
 $C899 LD L,A        ; }
 $C89A JR $C8A2      ; Jump to #R$C8A2.
@label=ScrollViewUp_Slowest
*$C89C LD E,$02      ; Scroll by the slowest amount, #N$02.
 $C89E LD A,L        ; {Set bit 6 of the flags.
 $C89F OR $40        ;
 $C8A1 LD L,A        ; }
@label=ScrollViewUp_SetFlags
*$C8A2 LD A,L        ; {Store the view flags.
 $C8A3 LD ($5CE6),A  ; }
 $C8A6 LD A,E        ; {Add the amount to scroll to the scroll position.
 $C8A7 ADD A,C       ; }
 $C8A8 LD ($5CE9),A  ; Store the scroll position.
 $C8AB BIT 5,A       ; Test bit 5 of the scroll position.
 $C8AD RET Z         ; Return if it has not gone past #N$20, as the view is not ready to
                     ; move by a whole row of the buffer.
 $C8AE SUB $10       ; Take away #N$10 from the scroll position.
 $C8B0 LD ($5CE9),A  ; Store it.
; Move the view up by eight rows. The player moves up the screen by eight
; rows, the buffer is moved up, and the eight rows at the bottom are cleared and
; drawn again.
 $C8B3 LD A,(IX+$0F) ; Fetch the row of the player on the screen.
 $C8B6 SUB $08       ; Take away #N$08.
 $C8B8 LD (IX+$0F),A ; Store it.
 $C8BB LD ($5CEC),A  ; Store it as the last row of the player.
 $C8BE LD DE,$FFF8   ; Set the distance to move the view origin, #N$FFF8.
 $C8C1 CALL $B8F9    ; Move the view origin.
 $C8C4 CALL $C8D9    ; Move the rows of the buffer up.
 $C8C7 LD HL,$F1BB   ; Point #REGhl at the last rows of the buffer.
 $C8CA CALL $C861    ; Clear the eight rows.
 $C8CD LD HL,$F1A1   ; Point #REGhl at the last rows of the buffer.
 $C8D0 LD ($5CBB),HL ; Store it as the place to draw to.
 $C8D3 LD HL,$C119   ; Point #REGhl at the routine that draws the objects in the bottom
                     ; strip.
 $C8D6 JP $BA75      ; Draw the objects of the level in the strip.

; Move Rows Up
;
; Used by the routine at #R$C873.
; .
; Copies #N$78 rows of the screen buffer upwards, by jumping into the code
; at #R$C9C9.
@label=MoveRowsUp
c$C8D9 LD ($5CDA),SP ; Write #REGsp at #R$5CDA.
 $C8DD LD B,$78      ; #REGb is #N$78.
 $C8DF LD SP,$E67B   ; Set #REGsp to #R$E5BB(#N$E67B).
 $C8E2 LD HL,$E5BB   ; Point #REGhl at #R$E5BB.
 $C8E5 JP $C9D4      ; Jump to #R$C9D4.

; Scroll View Left
;
; Used by the routine at #R$CC71.
; .
; Scrolls the view to the left when the player has moved towards the right
; of the view. The buffer is shifted with one of the routines in the table at
; #R$C9C3, the view is moved with #R$C99E and the objects that have come into
; view are drawn using #R$C0E1.
;
; IX The player entity
;
; Check whether the player is near enough to the right of the view for the
; view to scroll to the left. If it is not, stop scrolling.
@label=ScrollViewLeft
c$C8E8 LD A,($5CF0)  ; {Fetch the scroll position along the view and keep it in
 $C8EB LD C,A        ; #REGc.}
 $C8EC LD A,(IX+$0E) ; {Fetch the column of the player on the screen and keep
 $C8EF LD D,A        ; it in #REGd.}
 $C8F0 CP $68        ; Compare it with #N$68.
 $C8F2 LD L,$FC      ; Set the bits of the view flags to keep, to clear the
                     ; scroll bits.
 $C8F4 JP C,$C7E0    ; Jump to #R$C7E0 if the player is not near the right of
                     ; the view.
; Choose the speed to scroll at, which is two pixels a frame when the
; player is near the edge of the view and one pixel a frame otherwise.
 $C8F7 LD E,$02      ; Set the speed to two pixels.
 $C8F9 LD A,($5CE6)  ; Fetch the view flags.
 $C8FC AND %00000011 ; Keep the scroll left bits.
 $C8FE CP $02        ; {Jump to #R$C909 if the view is not already scrolling at two
 $C900 JR NZ,$C909   ; pixels.}
 $C902 LD A,D        ; Fetch the column of the player.
 $C903 CP $74        ; {Jump to #R$C913 to slow down to one pixel if the player is not as
 $C905 JR C,$C913    ; far across as that.}
 $C907 JR $C914      ; Keep the speed at two pixels.
@label=ScrollViewLeft_CheckPhase
*$C909 LD A,C        ; Fetch the scroll position.
 $C90A AND %00000011 ; Keep the low two bits.
 $C90C JR NZ,$C913   ; Slow down to one pixel if it is part way through a pixel
                     ; step.
 $C90E LD A,D        ; Fetch the column of the player.
 $C90F CP $80        ; {Jump to #R$C914 to keep the speed at two pixels if the player is
 $C911 JR NC,$C914   ; that far across.}
@label=ScrollViewLeft_OnePixel
*$C913 DEC E         ; Slow down to one pixel.
@label=ScrollViewLeft_Scroll
*$C914 PUSH DE       ; Save the speed.
; When the view has scrolled by another sixteen pixels, draw the objects
; that have come into view along the right edge of the buffer.
 $C915 LD HL,$E5D1   ; Point #REGhl at the right of the first row of the
                     ; buffer.
 $C918 LD ($5CBB),HL ; Store it as the place to draw to.
 $C91B LD HL,$C0E1   ; Point #REGhl at the routine that draws the objects in the right
                     ; strip.
 $C91E LD A,C        ; Fetch the scroll position.
 $C91F AND %00001111 ; Keep the low four bits.
 $C921 CALL Z,$BA70  ; Draw the objects of the level in the strip if it is a multiple of
                     ; sixteen.
 $C924 POP DE        ; Restore the speed.
; Move the view along by the speed and note it in the view flags.
 $C925 CALL $C99E    ; Move the origin of the view.
 $C928 LD A,E        ; Fetch the speed.
 $C929 SRL A         ; Halve it.
 $C92B LD E,A        ; Keep it in #REGe.
 $C92C INC A         ; Add one, to make the scroll left value of the flags.
 $C92D LD B,A        ; Copy it into #REGb.
 $C92E LD A,($5CE6)  ; Fetch the view flags.
 $C931 AND %11111100 ; Clear the scroll left bits.
 $C933 OR B          ; Set the new scroll left value.
 $C934 LD ($5CE6),A  ; Store the view flags.
 $C937 LD HL,$C9C3   ; Point #REGhl at the table of routines that shift the buffer to the
                     ; left.
 $C93A JP $AA42      ; Shift the buffer.

; Scroll View Right
;
; Used by the routine at #R$CC71.
; .
; Scrolls the view to the right when the player has moved towards the left
; of the view. The buffer is shifted with one of the routines in the table at
; #R$C998, the view is moved with #R$C9A0 and the objects that have come into
; view are drawn using #R$C0F0.
;
; IX The player entity
;
; Check whether the player is near enough to the left of the view for the
; view to scroll to the right. If it is not, stop scrolling.
@label=ScrollViewRight
c$C93D LD A,($5CF0)  ; {Fetch the scroll position along the view and keep it in
 $C940 LD C,A        ; #REGc.}
 $C941 LD A,(IX+$0E) ; {Fetch the column of the player on the screen and keep
 $C944 LD D,A        ; it in #REGd.}
 $C945 CP $40        ; Compare it with #N$40.
 $C947 LD L,$F3      ; Set the bits of the view flags to keep, to clear the
                     ; scroll bits.
 $C949 JP NC,$C7E0   ; Jump to #R$C7E0 if the player is not near the left of
                     ; the view.
; Choose the speed to scroll at, which is two pixels a frame when the
; player is near the edge of the view and one pixel a frame otherwise.
 $C94C LD E,$FE      ; Set the speed to two pixels, negative as the view moves the other
                     ; way.
 $C94E LD A,($5CE6)  ; Fetch the view flags.
 $C951 AND %00001100 ; Keep the scroll right bits.
 $C953 CP $08        ; {Jump to #R$C95E if the view is not already scrolling at two
 $C955 JR NZ,$C95E   ; pixels.}
 $C957 LD A,D        ; Fetch the column of the player.
 $C958 CP $34        ; {Jump to #R$C968 to slow down to one pixel if the player is further
 $C95A JR NC,$C968   ; across than that.}
 $C95C JR $C969      ; Keep the speed at two pixels.
@label=ScrollViewRight_CheckPhase
*$C95E LD A,C        ; Fetch the scroll position.
 $C95F AND %00000011 ; Keep the low two bits.
 $C961 JR NZ,$C968   ; Slow down to one pixel if it is part way through a pixel
                     ; step.
 $C963 LD A,D        ; Fetch the column of the player.
 $C964 CP $29        ; {Jump to #R$C969 to keep the speed at two pixels if the player is
 $C966 JR C,$C969    ; that far across.}
@label=ScrollViewRight_OnePixel
*$C968 INC E         ; Slow down to one pixel.
@label=ScrollViewRight_Scroll
*$C969 PUSH DE       ; Save the speed.
; When the view has scrolled by another sixteen pixels, draw the objects
; that have come into view along the left edge of the buffer.
 $C96A LD HL,$E5BB   ; Point #REGhl at the left of the first row of the buffer.
 $C96D LD ($5CBB),HL ; Store it as the place to draw to.
 $C970 LD HL,$C0F0   ; Point #REGhl at the routine that draws the objects in the left
                     ; strip.
 $C973 LD A,C        ; Fetch the scroll position.
 $C974 AND %00001111 ; Keep the low four bits.
 $C976 CALL Z,$BA70  ; Draw the objects of the level in the strip if it is a multiple of
                     ; sixteen.
 $C979 POP DE        ; Restore the speed.
; Move the view along by the speed and note it in the view flags.
 $C97A LD D,$FF      ; Make the amount to move the origin of the view negative.
 $C97C CALL $C9A0    ; Move the origin of the view.
 $C97F LD A,E        ; Fetch the speed.
 $C980 NEG           ; Make it positive.
 $C982 SRL A         ; Halve it.
 $C984 LD E,A        ; Keep it in #REGe.
 $C985 INC A         ; Add one.
 $C986 ADD A,A       ; {Shift it left twice, to make the scroll right value of
 $C987 ADD A,A       ; the flags.}
 $C988 LD B,A        ; Copy it into #REGb.
 $C989 LD A,($5CE6)  ; Fetch the view flags.
 $C98C AND %11110011 ; Clear the scroll right bits.
 $C98E OR B          ; Set the new scroll right value.
 $C98F LD ($5CE6),A  ; Store the view flags.
 $C992 LD HL,$C998   ; Point #REGhl at the table of routines that shift the buffer to the
                     ; right.
 $C995 JP $AA42      ; Shift the buffer.

; Shift Right Table
;
; The addresses of the routines that shift the screen buffer to the right,
; which are used by #R$C93D. They shift by a nibble, a byte and a pair of
; pixels.
@label=ShiftRightTable
w$C998 DEFW $CBC2,$CB71,$CB23

; Adjust View Origin
;
; Used by the routines at #R$AA5B and #R$C8E8.
; .
; Adds an amount to the origin of the view, which is held in #R$5CE2,
; #R$5CE2(#N$5CE4) and #R$5CE7, and changes the scroll position at #R$5CF0 to
; suit.
;
; E The amount
; D The high byte of the amount, which is cleared by this entry point
@label=AdjustViewOrigin
c$C99E LD D,$00      ; The amount is a single byte.
; This entry point is used by the routines at #R$AA5B and #R$C93D.
@label=AdjustViewOrigin_Signed
*$C9A0 LD HL,($5CE2) ; {Add the amount to the first origin.
 $C9A3 ADD HL,DE     ;
 $C9A4 LD ($5CE2),HL ; }
 $C9A7 LD HL,($5CE4) ; {Add the amount to the second origin.
 $C9AA ADD HL,DE     ;
 $C9AB LD ($5CE4),HL ; }
 $C9AE LD HL,($5CE7) ; {Add the amount twice to the view origin.
 $C9B1 ADD HL,DE     ;
 $C9B2 ADD HL,DE     ;
 $C9B3 LD ($5CE7),HL ; }
 $C9B6 LD A,($5CF0)  ; {The scroll flags move the other way, by twice the
 $C9B9 LD B,A        ; amount.
 $C9BA LD A,E        ;
 $C9BB NEG           ;
 $C9BD ADD A,A       ;
 $C9BE ADD A,B       ;
 $C9BF LD ($5CF0),A  ; }
 $C9C2 RET           ; Return.

; Shift Left Table
;
; The addresses of the routines that shift the screen buffer to the left,
; which are used by #R$C8E8.
@label=ShiftLeftTable
w$C9C3 DEFW $CA69,$CA17,$C9C9

; Shift View Left Byte
;
; Shifts the screen buffer to the left by one byte, by using the stack
; pointer to copy it. The part from #R$C9D4 is also used to move rows up by
; #R$C8D9.
@label=ShiftViewLeftByte
c$C9C9 LD HL,$E5BC   ; Point #REGhl at the second byte of the screen buffer.
 $C9CC LD ($5CDA),SP ; Save the stack pointer.
 $C9D0 LD SP,HL      ; Point the stack at that byte.
 $C9D1 DEC HL        ; Point #REGhl at the byte to its left.
 $C9D2 LD B,$80      ; Set the row count to #N$80.
; This entry point is used by the routine at #R$C8D9.
@label=ShiftViewLeftByte_Copy
*$C9D4 POP DE        ; {Copy the twenty-four bytes of the next row from the
 $C9D5 LD (HL),E     ; stack.
 $C9D6 INC HL        ;
 $C9D7 LD (HL),D     ;
 $C9D8 INC HL        ;
 $C9D9 POP DE        ;
 $C9DA LD (HL),E     ;
 $C9DB INC HL        ;
 $C9DC LD (HL),D     ;
 $C9DD INC HL        ;
 $C9DE POP DE        ;
 $C9DF LD (HL),E     ;
 $C9E0 INC HL        ;
 $C9E1 LD (HL),D     ;
 $C9E2 INC HL        ;
 $C9E3 POP DE        ;
 $C9E4 LD (HL),E     ;
 $C9E5 INC HL        ;
 $C9E6 LD (HL),D     ;
 $C9E7 INC HL        ;
 $C9E8 POP DE        ;
 $C9E9 LD (HL),E     ;
 $C9EA INC HL        ;
 $C9EB LD (HL),D     ;
 $C9EC INC HL        ;
 $C9ED POP DE        ;
 $C9EE LD (HL),E     ;
 $C9EF INC HL        ;
 $C9F0 LD (HL),D     ;
 $C9F1 INC HL        ;
 $C9F2 POP DE        ;
 $C9F3 LD (HL),E     ;
 $C9F4 INC HL        ;
 $C9F5 LD (HL),D     ;
 $C9F6 INC HL        ;
 $C9F7 POP DE        ;
 $C9F8 LD (HL),E     ;
 $C9F9 INC HL        ;
 $C9FA LD (HL),D     ;
 $C9FB INC HL        ;
 $C9FC POP DE        ;
 $C9FD LD (HL),E     ;
 $C9FE INC HL        ;
 $C9FF LD (HL),D     ;
 $CA00 INC HL        ;
 $CA01 POP DE        ;
 $CA02 LD (HL),E     ;
 $CA03 INC HL        ;
 $CA04 LD (HL),D     ;
 $CA05 INC HL        ;
 $CA06 POP DE        ;
 $CA07 LD (HL),E     ;
 $CA08 INC HL        ;
 $CA09 LD (HL),D     ;
 $CA0A INC HL        ;
 $CA0B POP DE        ;
 $CA0C LD (HL),E     ;
 $CA0D INC HL        ;
 $CA0E LD (HL),D     ;
 $CA0F INC HL        ; }
 $CA10 DJNZ $C9D4    ; Decrease the row count and jump back until every row has been
                     ; copied.
 $CA12 LD SP,($5CDA) ; Restore the stack pointer.
 $CA16 RET           ; Return.

; Shift View Left Nibble
;
; Shifts the screen buffer to the left by four pixels, by rotating the
; nibbles of each row.
@label=ShiftViewLeftNibble
c$CA17 LD B,$80      ; Set the row count to #N$80.
 $CA19 LD HL,$F1BA   ; Point #REGhl at the last byte of the screen buffer.
 $CA1C XOR A         ; Clear the nibble shifted in from the right.
@label=ShiftViewLeftNibble_Loop
*$CA1D RLD           ; {Shift the row four pixels to the left.
 $CA1F DEC HL        ;
 $CA20 RLD           ;
 $CA22 DEC HL        ;
 $CA23 RLD           ;
 $CA25 DEC HL        ;
 $CA26 RLD           ;
 $CA28 DEC HL        ;
 $CA29 RLD           ;
 $CA2B DEC HL        ;
 $CA2C RLD           ;
 $CA2E DEC HL        ;
 $CA2F RLD           ;
 $CA31 DEC HL        ;
 $CA32 RLD           ;
 $CA34 DEC HL        ;
 $CA35 RLD           ;
 $CA37 DEC HL        ;
 $CA38 RLD           ;
 $CA3A DEC HL        ;
 $CA3B RLD           ;
 $CA3D DEC HL        ;
 $CA3E RLD           ;
 $CA40 DEC HL        ;
 $CA41 RLD           ;
 $CA43 DEC HL        ;
 $CA44 RLD           ;
 $CA46 DEC HL        ;
 $CA47 RLD           ;
 $CA49 DEC HL        ;
 $CA4A RLD           ;
 $CA4C DEC HL        ;
 $CA4D RLD           ;
 $CA4F DEC HL        ;
 $CA50 RLD           ;
 $CA52 DEC HL        ;
 $CA53 RLD           ;
 $CA55 DEC HL        ;
 $CA56 RLD           ;
 $CA58 DEC HL        ;
 $CA59 RLD           ;
 $CA5B DEC HL        ;
 $CA5C RLD           ;
 $CA5E DEC HL        ;
 $CA5F RLD           ;
 $CA61 DEC HL        ;
 $CA62 RLD           ;
 $CA64 DEC HL        ; }
 $CA65 XOR A         ; Discard the nibble that fell off the left of the row.
 $CA66 DJNZ $CA1D    ; Decrease the row count and jump back until every row of the buffer
                     ; has been shifted.
 $CA68 RET           ; Return.

; Shift View Left Pixels
;
; Shifts the screen buffer to the left by two pixels, by rotating the bits
; of each row through the stack.
@label=ShiftViewLeftPixels
c$CA69 LD ($5CDA),SP ; Save the stack pointer.
 $CA6D LD B,$80      ; Set the row count to #N$80.
 $CA6F LD SP,$F1B9   ; Point the stack at the last two bytes of the screen
                     ; buffer.
@label=ShiftViewLeftPixels_Loop
*$CA72 XOR A         ; {Shift the rightmost two bytes of the row two pixels to the left,
 $CA73 POP HL        ; filling the gap with blank pixels.
 $CA74 SLA H         ;
 $CA76 RL L          ;
 $CA78 RRA           ;
 $CA79 RL H          ;
 $CA7B RL L          ;
 $CA7D RLA           ;
 $CA7E PUSH HL       ;
 $CA7F DEC SP        ;
 $CA80 DEC SP        ; }
 $CA81 POP HL        ; {Shift the middle twenty bytes of the row two pixels to
 $CA82 RL H          ; the left.
 $CA84 RL L          ;
 $CA86 RRA           ;
 $CA87 RL H          ;
 $CA89 RL L          ;
 $CA8B RLA           ;
 $CA8C PUSH HL       ;
 $CA8D DEC SP        ;
 $CA8E DEC SP        ;
 $CA8F POP HL        ;
 $CA90 RL H          ;
 $CA92 RL L          ;
 $CA94 RRA           ;
 $CA95 RL H          ;
 $CA97 RL L          ;
 $CA99 RLA           ;
 $CA9A PUSH HL       ;
 $CA9B DEC SP        ;
 $CA9C DEC SP        ;
 $CA9D POP HL        ;
 $CA9E RL H          ;
 $CAA0 RL L          ;
 $CAA2 RRA           ;
 $CAA3 RL H          ;
 $CAA5 RL L          ;
 $CAA7 RLA           ;
 $CAA8 PUSH HL       ;
 $CAA9 DEC SP        ;
 $CAAA DEC SP        ;
 $CAAB POP HL        ;
 $CAAC RL H          ;
 $CAAE RL L          ;
 $CAB0 RRA           ;
 $CAB1 RL H          ;
 $CAB3 RL L          ;
 $CAB5 RLA           ;
 $CAB6 PUSH HL       ;
 $CAB7 DEC SP        ;
 $CAB8 DEC SP        ;
 $CAB9 POP HL        ;
 $CABA RL H          ;
 $CABC RL L          ;
 $CABE RRA           ;
 $CABF RL H          ;
 $CAC1 RL L          ;
 $CAC3 RLA           ;
 $CAC4 PUSH HL       ;
 $CAC5 DEC SP        ;
 $CAC6 DEC SP        ;
 $CAC7 POP HL        ;
 $CAC8 RL H          ;
 $CACA RL L          ;
 $CACC RRA           ;
 $CACD RL H          ;
 $CACF RL L          ;
 $CAD1 RLA           ;
 $CAD2 PUSH HL       ;
 $CAD3 DEC SP        ;
 $CAD4 DEC SP        ;
 $CAD5 POP HL        ;
 $CAD6 RL H          ;
 $CAD8 RL L          ;
 $CADA RRA           ;
 $CADB RL H          ;
 $CADD RL L          ;
 $CADF RLA           ;
 $CAE0 PUSH HL       ;
 $CAE1 DEC SP        ;
 $CAE2 DEC SP        ;
 $CAE3 POP HL        ;
 $CAE4 RL H          ;
 $CAE6 RL L          ;
 $CAE8 RRA           ;
 $CAE9 RL H          ;
 $CAEB RL L          ;
 $CAED RLA           ;
 $CAEE PUSH HL       ;
 $CAEF DEC SP        ;
 $CAF0 DEC SP        ;
 $CAF1 POP HL        ;
 $CAF2 RL H          ;
 $CAF4 RL L          ;
 $CAF6 RRA           ;
 $CAF7 RL H          ;
 $CAF9 RL L          ;
 $CAFB RLA           ;
 $CAFC PUSH HL       ;
 $CAFD DEC SP        ;
 $CAFE DEC SP        ;
 $CAFF POP HL        ;
 $CB00 RL H          ;
 $CB02 RL L          ;
 $CB04 RRA           ;
 $CB05 RL H          ;
 $CB07 RL L          ;
 $CB09 RLA           ;
 $CB0A PUSH HL       ;
 $CB0B DEC SP        ;
 $CB0C DEC SP        ; }
 $CB0D POP HL        ; {Shift the leftmost two bytes two pixels to the left and step onto
 $CB0E RL H          ; the next row.
 $CB10 RL L          ;
 $CB12 RRA           ;
 $CB13 RL H          ;
 $CB15 RL L          ;
 $CB17 PUSH HL       ;
 $CB18 DEC SP        ;
 $CB19 DEC SP        ; }
 $CB1A DEC B         ; {Decrease the row count and jump back until every row of the buffer
 $CB1B JP NZ,$CA72   ; has been shifted.}
 $CB1E LD SP,($5CDA) ; Restore the stack pointer.
 $CB22 RET           ; Return.

; Shift View Right Byte
;
; Shifts the screen buffer to the right by one byte, by using the stack
; pointer to copy it. The part from #R$CB2E is also used to move rows down by
; #R$C857.
@label=ShiftViewRightByte
c$CB23 LD ($5CDA),SP ; Save the stack pointer.
 $CB27 LD HL,$F1B9   ; Point #REGhl at the last two bytes of the screen buffer.
 $CB2A LD SP,HL      ; Point the stack at them.
 $CB2B POP DE        ; Skip those two bytes, which the shift overwrites.
 $CB2C LD B,$80      ; Set the row count to #N$80.
; This entry point is used by the routine at #R$C857.
@label=ShiftViewRightByte_Copy
*$CB2E LD D,(HL)     ; {Copy the twenty-four bytes of the next row onto the stack, walking
 $CB2F DEC HL        ; backwards.
 $CB30 LD E,(HL)     ;
 $CB31 DEC HL        ;
 $CB32 PUSH DE       ;
 $CB33 LD D,(HL)     ;
 $CB34 DEC HL        ;
 $CB35 LD E,(HL)     ;
 $CB36 DEC HL        ;
 $CB37 PUSH DE       ;
 $CB38 LD D,(HL)     ;
 $CB39 DEC HL        ;
 $CB3A LD E,(HL)     ;
 $CB3B DEC HL        ;
 $CB3C PUSH DE       ;
 $CB3D LD D,(HL)     ;
 $CB3E DEC HL        ;
 $CB3F LD E,(HL)     ;
 $CB40 DEC HL        ;
 $CB41 PUSH DE       ;
 $CB42 LD D,(HL)     ;
 $CB43 DEC HL        ;
 $CB44 LD E,(HL)     ;
 $CB45 DEC HL        ;
 $CB46 PUSH DE       ;
 $CB47 LD D,(HL)     ;
 $CB48 DEC HL        ;
 $CB49 LD E,(HL)     ;
 $CB4A DEC HL        ;
 $CB4B PUSH DE       ;
 $CB4C LD D,(HL)     ;
 $CB4D DEC HL        ;
 $CB4E LD E,(HL)     ;
 $CB4F DEC HL        ;
 $CB50 PUSH DE       ;
 $CB51 LD D,(HL)     ;
 $CB52 DEC HL        ;
 $CB53 LD E,(HL)     ;
 $CB54 DEC HL        ;
 $CB55 PUSH DE       ;
 $CB56 LD D,(HL)     ;
 $CB57 DEC HL        ;
 $CB58 LD E,(HL)     ;
 $CB59 DEC HL        ;
 $CB5A PUSH DE       ;
 $CB5B LD D,(HL)     ;
 $CB5C DEC HL        ;
 $CB5D LD E,(HL)     ;
 $CB5E DEC HL        ;
 $CB5F PUSH DE       ;
 $CB60 LD D,(HL)     ;
 $CB61 DEC HL        ;
 $CB62 LD E,(HL)     ;
 $CB63 DEC HL        ;
 $CB64 PUSH DE       ;
 $CB65 LD D,(HL)     ;
 $CB66 DEC HL        ;
 $CB67 LD E,(HL)     ;
 $CB68 DEC HL        ;
 $CB69 PUSH DE       ; }
 $CB6A DJNZ $CB2E    ; Decrease the row count and jump back until every row has been
                     ; copied.
 $CB6C LD SP,($5CDA) ; Restore the stack pointer.
 $CB70 RET           ; Return.

; Shift View Right Nibble
;
; Shifts the screen buffer to the right by four pixels, by rotating the
; nibbles of each row.
@label=ShiftViewRightNibble
c$CB71 LD B,$80      ; Set the row count to #N$80.
 $CB73 LD HL,$E5BB   ; Point #REGhl at #R$E5BB.
@label=ShiftViewRightNibble_Loop
*$CB76 XOR A         ; {Clear the nibble shifted in from the left and shift the row four
 $CB77 RRD           ; pixels to the right.
 $CB79 INC HL        ;
 $CB7A RRD           ;
 $CB7C INC HL        ;
 $CB7D RRD           ;
 $CB7F INC HL        ;
 $CB80 RRD           ;
 $CB82 INC HL        ;
 $CB83 RRD           ;
 $CB85 INC HL        ;
 $CB86 RRD           ;
 $CB88 INC HL        ;
 $CB89 RRD           ;
 $CB8B INC HL        ;
 $CB8C RRD           ;
 $CB8E INC HL        ;
 $CB8F RRD           ;
 $CB91 INC HL        ;
 $CB92 RRD           ;
 $CB94 INC HL        ;
 $CB95 RRD           ;
 $CB97 INC HL        ;
 $CB98 RRD           ;
 $CB9A INC HL        ;
 $CB9B RRD           ;
 $CB9D INC HL        ;
 $CB9E RRD           ;
 $CBA0 INC HL        ;
 $CBA1 RRD           ;
 $CBA3 INC HL        ;
 $CBA4 RRD           ;
 $CBA6 INC HL        ;
 $CBA7 RRD           ;
 $CBA9 INC HL        ;
 $CBAA RRD           ;
 $CBAC INC HL        ;
 $CBAD RRD           ;
 $CBAF INC HL        ;
 $CBB0 RRD           ;
 $CBB2 INC HL        ;
 $CBB3 RRD           ;
 $CBB5 INC HL        ;
 $CBB6 RRD           ;
 $CBB8 INC HL        ;
 $CBB9 RRD           ;
 $CBBB INC HL        ;
 $CBBC RRD           ;
 $CBBE INC HL        ; }
 $CBBF DJNZ $CB76    ; Decrease the row count and jump back until every row of the buffer
                     ; has been shifted.
 $CBC1 RET           ; Return.

; Shift View Right Pixels
;
; Shifts the screen buffer to the right by two pixels, by rotating the
; bits of each row through the stack.
@label=ShiftViewRightPixels
c$CBC2 LD ($5CDA),SP ; Save the stack pointer.
 $CBC6 LD SP,$E5BB   ; Point the stack at the first byte of the screen buffer.
 $CBC9 LD B,$80      ; Set the row count to #N$80.
@label=ShiftViewRightPixels_Loop
*$CBCB XOR A         ; Clear the pixels shifted in from the left of the row.
 $CBCC POP DE        ; {Shift the leftmost two bytes of the row two pixels to
 $CBCD SRL E         ; the right.
 $CBCF RR D          ;
 $CBD1 RRA           ;
 $CBD2 RR E          ;
 $CBD4 RR D          ;
 $CBD6 RLA           ;
 $CBD7 PUSH DE       ;
 $CBD8 POP DE        ; }
 $CBD9 POP DE        ; {Shift the other twenty-two bytes two pixels to the right and step
 $CBDA RR E          ; onto the next row.
 $CBDC RR D          ;
 $CBDE RRA           ;
 $CBDF RR E          ;
 $CBE1 RR D          ;
 $CBE3 RLA           ;
 $CBE4 PUSH DE       ;
 $CBE5 POP DE        ;
 $CBE6 POP DE        ;
 $CBE7 RR E          ;
 $CBE9 RR D          ;
 $CBEB RRA           ;
 $CBEC RR E          ;
 $CBEE RR D          ;
 $CBF0 RLA           ;
 $CBF1 PUSH DE       ;
 $CBF2 POP DE        ;
 $CBF3 POP DE        ;
 $CBF4 RR E          ;
 $CBF6 RR D          ;
 $CBF8 RRA           ;
 $CBF9 RR E          ;
 $CBFB RR D          ;
 $CBFD RLA           ;
 $CBFE PUSH DE       ;
 $CBFF POP DE        ;
 $CC00 POP DE        ;
 $CC01 RR E          ;
 $CC03 RR D          ;
 $CC05 RRA           ;
 $CC06 RR E          ;
 $CC08 RR D          ;
 $CC0A RLA           ;
 $CC0B PUSH DE       ;
 $CC0C POP DE        ;
 $CC0D POP DE        ;
 $CC0E RR E          ;
 $CC10 RR D          ;
 $CC12 RRA           ;
 $CC13 RR E          ;
 $CC15 RR D          ;
 $CC17 RLA           ;
 $CC18 PUSH DE       ;
 $CC19 POP DE        ;
 $CC1A POP DE        ;
 $CC1B RR E          ;
 $CC1D RR D          ;
 $CC1F RRA           ;
 $CC20 RR E          ;
 $CC22 RR D          ;
 $CC24 RLA           ;
 $CC25 PUSH DE       ;
 $CC26 POP DE        ;
 $CC27 POP DE        ;
 $CC28 RR E          ;
 $CC2A RR D          ;
 $CC2C RRA           ;
 $CC2D RR E          ;
 $CC2F RR D          ;
 $CC31 RLA           ;
 $CC32 PUSH DE       ;
 $CC33 POP DE        ;
 $CC34 POP DE        ;
 $CC35 RR E          ;
 $CC37 RR D          ;
 $CC39 RRA           ;
 $CC3A RR E          ;
 $CC3C RR D          ;
 $CC3E RLA           ;
 $CC3F PUSH DE       ;
 $CC40 POP DE        ;
 $CC41 POP DE        ;
 $CC42 RR E          ;
 $CC44 RR D          ;
 $CC46 RRA           ;
 $CC47 RR E          ;
 $CC49 RR D          ;
 $CC4B RLA           ;
 $CC4C PUSH DE       ;
 $CC4D POP DE        ;
 $CC4E POP DE        ;
 $CC4F RR E          ;
 $CC51 RR D          ;
 $CC53 RRA           ;
 $CC54 RR E          ;
 $CC56 RR D          ;
 $CC58 RLA           ;
 $CC59 PUSH DE       ;
 $CC5A POP DE        ;
 $CC5B POP DE        ;
 $CC5C RR E          ;
 $CC5E RR D          ;
 $CC60 RRA           ;
 $CC61 RR E          ;
 $CC63 RR D          ;
 $CC65 RLA           ;
 $CC66 PUSH DE       ;
 $CC67 POP DE        ; }
 $CC68 DEC B         ; {Decrease the row count and jump back until every row of the buffer
 $CC69 JP NZ,$CBCB   ; has been shifted.}
 $CC6C LD SP,($5CDA) ; Restore the stack pointer.
 $CC70 RET           ; Return.

; Scroll View
;
; Used by the routine at #R$CD11.
; .
; Scrolls the view if the player has moved too close to one of its edges.
; The view is scrolled to the left or right first, with #R$C8E8 or #R$C93D,
; and then up or down, with #R$C7E8 or #R$C873.
;
; IX The player entity
@label=ScrollView
c$CC71 LD A,($5CE6)  ; {Fetch the view flags and keep them in #REGc.
 $CC74 LD C,A        ; }
 $CC75 AND %00000011 ; Keep the scroll left bits.
 $CC77 JR NZ,$CC89   ; Jump to #R$CC89 if the view is already scrolling left.
 $CC79 LD A,(IX+$0E) ; Fetch the column of the player on the screen.
 $CC7C CP $73        ; {Jump to #R$CC8E if the player is not that far to the
 $CC7E JR C,$CC8E    ; right.}
 $CC80 LD A,($5CE6)  ; Fetch the view flags.
 $CC83 AND %11111100 ; Clear the scroll left bits.
 $CC85 INC A         ; Set them to one pixel a frame.
 $CC86 LD ($5CE6),A  ; Store the view flags.
@label=ScrollView_Left
*$CC89 CALL $C8E8    ; Scroll the view to the left.
 $CC8C JR $CCA5      ; Jump to the vertical scroll.
@label=ScrollView_Right
*$CC8E LD A,C        ; Fetch the view flags kept in #REGc.
 $CC8F AND %00001100 ; Keep the scroll right bits.
 $CC91 JR NZ,$CCA2   ; Jump to #R$CCA2 if the view is already scrolling right.
 $CC93 LD A,(IX+$0E) ; Fetch the column of the player on the screen.
 $CC96 CP $32        ; {Jump to #R$CCA5 if the player is not that far to the
 $CC98 JR NC,$CCA5   ; left.}
 $CC9A LD A,C        ; Fetch the view flags kept in #REGc.
 $CC9B AND %11110011 ; Clear the scroll right bits.
 $CC9D ADD A,$04     ; Set them to one pixel a frame.
 $CC9F LD ($5CE6),A  ; Store the view flags.
@label=ScrollView_ScrollRight
*$CCA2 CALL $C93D    ; Scroll the view to the right.
@label=ScrollView_Vertical
*$CCA5 LD A,($5CE6)  ; {Fetch the view flags and keep them in #REGc.
 $CCA8 LD C,A        ; }
 $CCA9 AND %00110000 ; Keep the scroll down bits.
 $CCAB JP NZ,$C7E8   ; Scroll the view down if it is already scrolling down.
 $CCAE LD A,(IX+$0F) ; Fetch the row of the player on the screen.
 $CCB1 CP $2F        ; {Jump to #R$C7E8 to scroll the view down if the player is near the
 $CCB3 JP C,$C7E8    ; top of the view.}
 $CCB6 LD A,C        ; Fetch the view flags kept in #REGc.
 $CCB7 AND %11000000 ; Keep the scroll up bits.
 $CCB9 JP NZ,$C873   ; Scroll the view up if it is already scrolling up.
 $CCBC LD A,(IX+$0F) ; Fetch the row of the player on the screen.
 $CCBF CP $61        ; Compare it with #N$61.
 $CCC1 RET C         ; Return if the player is not near the bottom of the view.
 $CCC2 JP $C873      ; Scroll the view up.

; Update Direction Gauge
;
; Used by the routine at #R$CD11.
; .
; Sets the heading shown by the direction gauge, which is the heading of
; the player plus #N$08, and redraws the gauge with #R$A724.
;
; IX The player entity
@label=UpdateDirectionGauge
c$CCC5 LD A,(IX+$11) ; Fetch the heading.
 $CCC8 ADD A,$08     ; Add #N$08.
 $CCCA AND %00111111 ; Use bits 0-5.
 $CCCC LD ($5CD8),A  ; Write #REGa at #R$5CD8.
 $CCCF JP $A724      ; Jump to #R$A724.

; Settle Player
;
; Used by the routine at #R$CD11.
; .
; Updates the player entity with #R$D037, with its speed set to zero and
; its heading flag cleared, and then restores the speed. The entry point at
; #R$CCD2 goes on to set the player to frame #N$03 at #R$CDE3, the entry point
; at #R$CD0B goes on to the end of the player update at #R$CDF8 and the entry
; point at #R$CCD8 returns.
;
; IX The player entity
@label=SettlePlayer
c$CCD2 CALL $CCD8     ; {Settle the player, then set its frame.
 $CCD5 JP $CDE3       ; }
@label=SettlePlayer_Update
*$CCD8 LD HL,($B552)  ; {Remember the vertical speed.
 $CCDB PUSH HL        ; }
 $CCDC LD E,(IX+$10)  ; {Remember the speed and the speed fraction.
 $CCDF LD D,(IX+$1A)  ;
 $CCE2 PUSH DE        ; }
 $CCE3 LD HL,($B560)  ; {Remember the drift.
 $CCE6 PUSH HL        ; }
 $CCE7 XOR A          ; {Clear the speed, the drift and the vertical speed, and
 $CCE8 LD ($B550),A   ; stop moving.
 $CCEB LD HL,$0000    ;
 $CCEE LD ($B560),HL  ;
 $CCF1 LD ($B552),HL  ;
 $CCF4 RES 7,(IX+$11) ; }
 $CCF8 CALL $D037     ; Move the player.
 $CCFB POP HL         ; {Put the drift back.
 $CCFC LD ($B560),HL  ; }
 $CCFF POP DE         ; {Put the speed and the speed fraction back.
 $CD00 LD (IX+$10),E  ;
 $CD03 LD (IX+$1A),D  ; }
 $CD06 POP HL         ; {Put the vertical speed back.
 $CD07 LD ($B552),HL  ; }
 $CD0A RET            ; Return.
; This entry point is used by the routine at #R$CD11.
@label=SettlePlayer_Continue
*$CD0B CALL $CCD8     ; {Settle the player, then finish the update.
 $CD0E JP $CDF8       ; }

; Run Frame
;
; Used by the routine at #R$DFF0.
; .
; Runs one frame of the game. First the timers are updated and then the
; player is controlled, updated and projected. The view is scrolled, the other
; entities are updated, and then the draw list is built, sorted and drawn.
; Finally the messages are updated.
; .
; The counter in #R$5D00 is used for the player jumping and for the death
; of the player. Purpose of its values is not yet known.
;
; .
;
; Count down the timer, if it is running.
@label=RunFrame
c$CD11 LD A,($A2DF)   ; Fetch the countdown timer.
 $CD14 AND A          ; Test it.
 $CD15 JR Z,$CD1B     ; Jump to #R$CD1B if it has stopped.
 $CD17 DEC A          ; {Decrease the timer by one and store it.
 $CD18 LD ($A2DF),A   ; }
; Drain the first gauge by #N$10 and redraw it. If it has run out then the
; player bursts, provided that it is still the player.
@label=RunFrame_Gauge
*$CD1B LD HL,($A59F)  ; Fetch the target of the first gauge.
 $CD1E LD DE,$0010    ; Set the amount to drain, #N$0010.
 $CD21 AND A          ; {Take the amount away.
 $CD22 SBC HL,DE      ; }
 $CD24 JR C,$CD32     ; Jump to #R$CD32 if the gauge has run out.
 $CD26 LD ($A59F),HL  ; Store the new target of the gauge.
 $CD29 LD IX,$A59D    ; Point #REGix at #R$A59D.
 $CD2D CALL $A5A5     ; Move the bar of the gauge one step towards its target.
 $CD30 JR $CD3F       ; Jump to #R$CD3F.
@label=RunFrame_Burst
*$CD32 LD A,($B540)   ; Fetch the type of the player entity.
 $CD35 DEC A          ; Decrease it by one.
 $CD36 JR NZ,$CD3F    ; Jump to #R$CD3F if it is not of type #N$01.
 $CD38 LD IX,$B540    ; Point #REGix at #R$B540.
 $CD3C CALL $9924     ; Burst the player.
; Update the points where creatures appear, on every fourth frame.
@label=RunFrame_Spawn
*$CD3F LD A,($A2DD)   ; Fetch the frame counter.
 $CD42 AND %00000011  ; Use bits 0-1.
 $CD44 CALL Z,$9748   ; Update the spawn points if this is a fourth frame.
; Control the player, if it is still an entity of type #N$01. Animate it,
; and update the direction gauge if the heading has changed.
@label=RunFrame_Player
 $CD47 LD IX,$B540    ; Point #REGix at #R$B540.
 $CD4B LD A,(IX+$00)  ; Fetch the type of the player entity.
 $CD4E DEC A          ; Decrease it by one.
 $CD4F JP NZ,$CE00    ; Jump to #R$CE00 if the player is not of type #N$01.
 $CD52 CALL $AB0F     ; Read the controls and turn or speed up the player.
 $CD55 CALL $AF48     ; Animate the player.
 $CD58 LD A,(IX+$11)  ; Fetch the heading of the player.
 $CD5B XOR (IX+$22)   ; Find which bits of it have changed since the heading that is shown
                      ; on the gauge.
 $CD5E AND %00111111  ; Keep the bits that give the direction.
 $CD60 CALL NZ,$CCC5  ; Update the direction gauge if the heading has changed.
; Count the frames of the counter at #R$5D00, if it is running. Purpose of
; its values from #N$01 to #N$05 is not yet known; the player is held still for
; them, and the values from #N$F0 on are the player landing.
@label=RunFrame_Counter
 $CD63 LD A,($5D00)   ; Fetch the counter.
 $CD66 AND A          ; Test it.
 $CD67 JR Z,$CD82     ; Jump to #R$CD82 if it is not running.
 $CD69 INC A          ; Add one to the counter.
 $CD6A LD ($5D00),A   ; Store it.
 $CD6D CP $F0         ; {Jump to #R$CDCC if the player is landing.
 $CD6F JR NC,$CDCC    ; }
 $CD71 CP $02         ; {Jump to #R$CCD2 to settle the player and set the landing frame if
 $CD73 JP Z,$CCD2     ; it is #N$02.}
 $CD76 SUB $05        ; Take away #N$05.
 $CD78 JR NZ,$CD0B    ; Settle the player if the counter is not at #N$05.
 $CD7A LD ($5D00),A   ; Stop the counter.
 $CD7D CALL $9F40     ; Play the short rising sweep.
 $CD80 JR $CD8D       ; Jump to #R$CD8D.
; Move the player. If it is on the ground then it is not animated.
@label=RunFrame_Ground
*$CD82 BIT 7,(IX+$1E) ; {Jump to #R$CD8D if it is not on the ground.
 $CD86 JR Z,$CD8D     ; }
 $CD88 CALL $D037     ; Move the player.
 $CD8B JR $CDF8       ; Jump to #R$CDF8.
@label=RunFrame_Update
*$CD8D LD E,(IX+$1F)  ; Fetch the height of the player above the ground before
                      ; it moves.
 $CD90 PUSH DE        ; Stash it on the stack.
 $CD91 CALL $D037     ; Move the player.
 $CD94 POP DE         ; Restore the old height.
 $CD95 LD A,(IX+$1E)  ; Read field #N$1E of the player.
 $CD98 AND %00111111  ; Use bits 0-5.
 $CD9A JR NZ,$CDF8    ; Jump to #R$CDF8 if any of them are set.
 $CD9C LD A,(IX+$1F)  ; Fetch the new height of the player above the ground.
 $CD9F AND A          ; Test it.
 $CDA0 JR Z,$CDC2     ; Jump to #R$CDC2 if the player is on the ground.
; Choose the frame of the player from its height above the ground.
 $CDA2 LD B,$02       ; Use frame #N$02 if the player is lower than it was.
 $CDA4 CP E           ; Compare the new height with the old height.
 $CDA5 JR C,$CDE5     ; Jump to #R$CDE5 if it is lower.
 $CDA7 LD B,$03       ; Use frame #N$03 if the height is less than #N$04.
 $CDA9 CP $04         ; {Jump to #R$CDE5 if the height is below #N$04.
 $CDAB JR C,$CDE5     ; }
 $CDAD LD B,$01       ; Use frame #N$01 if the height is less than #N$0C.
 $CDAF CP $0C         ; {Jump to #R$CDE5 if the height is below #N$0C.
 $CDB1 JR C,$CDE5     ; }
 $CDB3 INC B          ; Use frame #N$02 if the height is less than #N$10.
 $CDB4 CP $10         ; {Jump to #R$CDE5 if the height is below #N$10.
 $CDB6 JR C,$CDE5     ; }
 $CDB8 LD B,$04       ; Use frame #N$04 if the height is less than #N$16.
 $CDBA CP $16         ; {Jump to #R$CDE5 if the height is below #N$16.
 $CDBC JR C,$CDE5     ; }
 $CDBE LD B,$02       ; Otherwise use frame #N$02.
 $CDC0 JR $CDE5       ; Jump to #R$CDE5.
; The player is on the ground. If it was in the air a moment ago it has
; just landed, so start the counter at #N$F0.
@label=RunFrame_Still
*$CDC2 OR E           ; Combine the old height with the new height.
 $CDC3 JR Z,$CDF8     ; Jump to #R$CDF8 if the player was already on the
                      ; ground.
 $CDC5 LD A,$F0       ; Start the counter for the player landing.
 $CDC7 LD ($5D00),A   ; Store it.
 $CDCA JR $CDCF       ; Jump to #R$CDCF.
@label=RunFrame_Fall
*$CDCC CALL $D037     ; Move the player.
; Choose the frame of the player from the counter of the landing, which is
; frame #N$01 until the counter reaches #N$F2 and then frame #N$03. The counter
; is stopped after #N$F3.
@label=RunFrame_Frame
*$CDCF LD B,$01       ; Use frame #N$01.
 $CDD1 LD A,($5D00)   ; Fetch the counter.
 $CDD4 CP $F2         ; {Jump to #R$CDE5 if it is lower.
 $CDD6 JR C,$CDE5     ; }
 $CDD8 LD B,$03       ; Use frame #N$03.
 $CDDA SUB $F3        ; Take away #N$F3.
 $CDDC JR NZ,$CDE5    ; Jump to #R$CDE5 if the landing has not finished.
 $CDDE LD ($5D00),A   ; Stop the counter.
 $CDE1 JR $CDE5       ; Jump to #R$CDE5.
; This entry point is used by the routine at #R$CCD2.
@label=RunFrame_Land
*$CDE3 LD B,$03       ; Use frame #N$03.
; Show the frame of the player, and set the size of its sprite, if it has
; changed.
@label=RunFrame_SetFrame
*$CDE5 LD A,(IX+$01)  ; Read field #N$01 of the player.
 $CDE8 LD C,A         ; Keep it in #REGc.
 $CDE9 AND %00011111  ; Keep the number of the frame.
 $CDEB CP B           ; Compare it with the new frame.
 $CDEC JR Z,$CDF8     ; Jump to #R$CDF8 if it has not changed.
 $CDEE LD A,C         ; Fetch the flags in field #N$01.
 $CDEF AND %11100000  ; Keep the flags in bits 5-7.
 $CDF1 OR B           ; Combine them with the new frame.
 $CDF2 LD (IX+$01),A  ; Store them.
 $CDF5 CALL $AF21     ; Set the size of the sprite.
; This entry point is used by the routine at #R$CCD2.
@label=RunFrame_Entities
*$CDF8 LD A,($5CDE)   ; Read the byte at #R$5CDE.
 $CDFB AND %00010000  ; Keep bit 4.
 $CDFD CALL NZ,$A630  ; Create an entity of type #N$05 if the bit is set.
; Work out where the player is on the screen and scroll the view to follow
; it. Then update the entities and the extra records, build and sort the draw
; list, and draw it. If SPACE or CAPS SHIFT is pressed the game is paused here.
@label=RunFrame_Draw
*$CE00 CALL $ADF9     ; Project the player on to the screen.
 $CE03 LD IX,$B540    ; Point #REGix at #R$B540.
 $CE07 CALL $CC71     ; Scroll the view to follow the player.
 $CE0A CALL $CEE2     ; Update the other entities.
 $CE0D CALL $CE84     ; Update the extra records.
 $CE10 CALL $AC40     ; Build the draw list.
 $CE13 CALL $9F99     ; Sort the draw list.
 $CE16 CALL $B06E     ; Draw the items of the draw list.
 $CE19 CALL $A837     ; Pause the game if a key is pressed.
; Print the message that is scrolling in or out, if there is one. It is
; printed in two parts, one of which is chosen by the state of the message.
 $CE1C LD A,($CE59)   ; Fetch the state of the message.
 $CE1F AND A          ; Test it.
 $CE20 JR Z,$CE39     ; Jump to #R$CE39 if there is no message.
 $CE22 LD DE,$CE5A    ; Point #REGde at #R$CE5A.
 $CE25 DEC A          ; Decrease the state by one.
 $CE26 JR Z,$CE2B     ; Jump to #R$CE2B if it is the first message.
 $CE28 LD DE,$CE72    ; Point #REGde at #R$CE72.
@label=RunFrame_Skip
*$CE2B CALL $A923     ; Print the first part of the message.
 $CE2E CALL $A923     ; Print the second part of the message.
 $CE31 LD A,($CE59)   ; Fetch the state of the message.
 $CE34 SRL A          ; Halve it.
 $CE36 LD ($CE59),A   ; Store it.
@label=RunFrame_Message
*$CE39 CALL $E4CC     ; Copy the screen buffer to the screen.
; Check what has happened to the player.
 $CE3C LD A,($B540)   ; Fetch the type of the player entity.
 $CE3F AND A          ; Test it.
 $CE40 JR NZ,$CE4E    ; Jump to #R$CE4E if the player is still there.
 $CE42 INC A          ; The player has gone, so set #REGa to #N$01.
 $CE43 LD ($AA5A),A   ; Store it to show that a life has been lost.
 $CE46 LD A,($A5A0)   ; Fetch the high byte of the target of the first gauge.
 $CE49 AND A          ; Test it.
 $CE4A CALL Z,$A51C   ; Show the time out message if the gauge is empty.
 $CE4D RET            ; Return.
@label=RunFrame_Dead
*$CE4E LD A,($B542)   ; Fetch the high byte of the x coordinate of the player.
 $CE51 AND A          ; Test it.
 $CE52 RET Z          ; Return if it is zero, which is when the player has left
                      ; the level.
 $CE53 CALL $AD9E     ; Put the rows of the screen buffer back.
 $CE56 JP $CD11       ; Run the next frame.

; Exit Message Flag
;
; Controls the "EXIT CLOSED" message. When it is #N$02 the message is
; printed, and when it is #N$01 the message is blanked out. It is zero when
; there is no message.
@label=ExitMessageFlag
g$CE59 DEFB $00

; Exit Closed Messages
;
; The text that is printed by #R$CD11. The first two are blanks, to
; remove the message.
@label=ExitClosedMessages
b$CE5A DEFB $60,$87                         ; Position: x=#N$60, y=#N$87.
 $CE5C DEFB $47                             ; Attribute: #COLOUR(#PEEK(#PC)).
 $CE5D DEFB $08                             ; Length #N$08.
 $CE5E DEFB $27,$27,$27,$27,$27,$27,$27,$27 ; "        "
 $CE66 DEFB $60,$8F                         ; Position: x=#N$60, y=#N$8F.
 $CE68 DEFB $47                             ; Attribute: #COLOUR(#PEEK(#PC)).
 $CE69 DEFB $08                             ; Length #N$08.
 $CE6A DEFB $27,$27,$27,$27,$27,$27,$27,$27 ; "        "
@label=ExitClosedMessages_Second
 $CE72 DEFB $70,$87                         ; Position: x=#N$70, y=#N$87.
 $CE74 DEFB $47                             ; Attribute: #COLOUR(#PEEK(#PC)).
 $CE75 DEFB $04                             ; Length #N$04.
 $CE76 DEFB $0E,$21,$12,$1D                 ; "EXIT"
 $CE7A DEFB $68,$8F                         ; Position: x=#N$68, y=#N$8F.
 $CE7C DEFB $47                             ; Attribute: #COLOUR(#PEEK(#PC)).
 $CE7D DEFB $06                             ; Length #N$06.
 $CE7E DEFB $0C,$15,$18,$1C,$0E,$0D         ; "CLOSED"

; Update Extra Records
;
; Used by the routine at #R$CD11.
; .
; Updates the extra record of each of the entities, with #R$B7CE. If the
; entity is in use, is not of type #N$05, #N$0D or #N$0E, and is in view, its
; screen position is stored in the first two bytes of its extra record, and bit
; 7 of field #N$09 of the extra record is set to show that it is visible.
@label=UpdateExtraRecords
c$CE84 LD IY,$B708     ; Point #REGiy at the first extra record.
 $CE88 LD IX,$B540     ; Point #REGix at #R$B540.
 $CE8C LD B,$0C        ; Set the number of entities to #N$0C.
@label=UpdateExtraRecords_Loop
*$CE8E LD (IY+$09),$00 ; Mark the extra record as not in use.
 $CE92 PUSH BC         ; Save the entity count.
 $CE93 PUSH IX         ; Save the entity.
 $CE95 LD A,(IX+$00)   ; Fetch the type of the entity.
 $CE98 AND A           ; Test it.
 $CE99 JR Z,$CED3      ; Jump to #R$CED3 if the entity is not in use.
 $CE9B CP $05          ; {Jump to #R$CED3 if the entity is a puff.
 $CE9D JR Z,$CED3      ; }
 $CE9F CP $0D          ; {Jump to #R$CED3 if the entity is a sparkle.
 $CEA1 JR Z,$CED3      ; }
 $CEA3 CP $0E          ; {Jump to #R$CED3 if the entity is a shot.
 $CEA5 JR Z,$CED3      ; }
 $CEA7 CP $0F          ; {Jump to #R$CEB5 unless the entity is a pickup.
 $CEA9 JR NZ,$CEB5     ; }
 $CEAB RES 6,(IX+$1E)  ; Reset bit 6 of field #N$1E of the pickup.
 $CEAF LD A,(IX+$09)   ; Fetch the low byte of the z coordinate.
 $CEB2 AND A           ; Test it.
 $CEB3 JR Z,$CED3      ; Jump to #R$CED3 if it is zero.
@label=UpdateExtraRecords_Skip
*$CEB5 CALL $B7CE      ; Set up the extra record from the entity.
 $CEB8 JR NZ,$CED3     ; Jump to #R$CED3 if the record was not set up.
 $CEBA CALL $AE0D      ; Work out the screen position of the entity.
 $CEBD BIT 7,(IX+$01)  ; {Jump to #R$CED3 if the entity is hidden.
 $CEC1 JR NZ,$CED3     ; }
 $CEC3 LD A,(IX+$0E)   ; Fetch the column of the entity on the screen.
 $CEC6 LD (IY+$00),A   ; Store it in the first byte of the extra record.
 $CEC9 LD A,(IX+$0F)   ; Fetch the row of the entity on the screen.
 $CECC LD (IY+$01),A   ; Store it in the second byte of the extra record.
 $CECF LD (IY+$09),$80 ; Mark the extra record as in use.
@label=UpdateExtraRecords_Next
*$CED3 POP IX          ; Restore the entity.
 $CED5 LD BC,$0026     ; Set the size of an entity to #N$26.
 $CED8 ADD IX,BC       ; Move on to the next entity.
 $CEDA LD C,$0D        ; Set the size of an extra record to #N$0D.
 $CEDC ADD IY,BC       ; Move on to the next extra record.
 $CEDE POP BC          ; Restore the entity count.
 $CEDF DJNZ $CE8E      ; Decrease it and jump back until every entity has been
                       ; updated.
 $CEE1 RET             ; Return.

; Update Entities
;
; Used by the routines at #R$CD11 and #R$DFF0.
; .
; Updates each of the entities that are not the player, or all of them if
; the player is not of type #N$01. An entity that is of type #N$0C or #N$10 is
; always kept. Any other entity is checked every eighth frame and is removed if
; it is a long way out of view. The entity is animated with #R$AF48 and then
; the routine for its type is run, using the table at #R$993D.
@label=UpdateEntities
c$CEE2 LD IX,$B566     ; Point #REGix at the entity after the player.
 $CEE6 LD B,$0B        ; Set the number of entities to #N$0B, leaving out the
                       ; player.
 $CEE8 LD A,($B540)    ; Fetch the type of the player.
 $CEEB DEC A           ; Compare it with the player type, #N$01.
 $CEEC JR Z,$CEF3      ; Jump to #R$CEF3 if the player is still a player.
 $CEEE LD IX,$B540     ; Point #REGix at #R$B540.
 $CEF2 INC B           ; Include the player in the count.
; This entry point is used by the routine at #R$CF46.
@label=UpdateEntities_Loop
*$CEF3 PUSH BC         ; Save the entity count.
 $CEF4 LD A,(IX+$00)   ; Fetch the type of the entity.
 $CEF7 AND A           ; Test it.
 $CEF8 JR Z,$CF46      ; Jump to #R$CF46 if the entity is not in use.
 $CEFA PUSH AF         ; Save the type.
 $CEFB CP $0C          ; {Jump to #R$CF1D if the entity is a disc.
 $CEFD JR Z,$CF1D      ; }
 $CEFF CP $10          ; {Jump to #R$CF1D if the entity is a spider.
 $CF01 JR Z,$CF1D      ; }
 $CF03 LD A,($A2DD)    ; Fetch the frame counter.
 $CF06 AND %00000111   ; Keep the low three bits.
 $CF08 JR NZ,$CF1D     ; Jump to #R$CF1D unless this is every eighth frame.
 $CF0A LD BC,$0020     ; Set the margin to #N$20.
 $CF0D CALL $AEB0      ; Test whether the entity is within the view.
 $CF10 JR NZ,$CF1D     ; Jump to #R$CF1D if it is within the view.
 $CF12 SET 7,(IX+$01)  ; Hide the entity.
 $CF16 LD (IX+$00),$00 ; Remove the entity.
 $CF1A POP AF          ; Restore the type.
 $CF1B JR $CF46        ; Jump to the next entity.
@label=UpdateEntities_Animate
*$CF1D CALL $AF48      ; Animate the entity.
 $CF20 POP AF          ; {Jump to the update routine for the type of the
 $CF21 PUSH IX         ; entity.
 $CF23 ADD A,A         ;
 $CF24 LD C,A          ;
 $CF25 LD B,$00        ;
 $CF27 LD HL,$993B     ;
 $CF2A ADD HL,BC       ;
 $CF2B LD A,(HL)       ;
 $CF2C INC HL          ;
 $CF2D LD H,(HL)       ;
 $CF2E LD L,A          ;
 $CF2F JP (HL)         ; }

; Update Entity
;
; Used by the routines at #R$9B63 and #R$9E17.
; .
; The routine for the types #N$01, #N$02 and #N$03 of entity, which is
; also jumped to by the routines for other types. Moves the entity with
; #R$D037, with the entity flagged as moving, and then projects it with
; #R$AE0D if it is still in use.
;
; IX The entity
@label=UpdateEntity
c$CF30 LD A,(IX+$00)  ; Fetch the type of the entity.
 $CF33 AND A          ; Test it.
 $CF34 JR Z,$CF44     ; Jump to #R$CF44 if the entity is not in use.
 $CF36 SET 7,(IX+$11) ; Flag the entity as moving.
; This entry point is used by the routines at #R$99F7, #R$9A0A, #R$9AD9,
; #R$9B66, #R$9B89, #R$9BB9, #R$9C1A, #R$9C78 and #R$9CBA.
@label=UpdateEntity_Move
*$CF3A CALL $D037     ; Move the entity.
; This entry point is used by the routines at #R$9ABE, #R$9D67, #R$9DC0,
; #R$9E46 and #R$9E6D.
@label=UpdateEntity_Project
*$CF3D LD A,(IX+$00)  ; Fetch the type of the entity.
 $CF40 AND A          ; Test it.
 $CF41 CALL NZ,$AE0D  ; Work out the screen position if the entity is still in
                      ; use.
; This entry point is used by the routines at #R$9D67, #R$9D8D, #R$9D9D,
; #R$9DC0 and #R$9E17.
@label=UpdateEntity_Done
*$CF44 POP IX         ; Restore the entity.
; Continue on to #R$CF46.

; Update Next Entity
;
; Used by the routine at #R$CEE2.
; .
; Moves on to the next entity in #R$CEE2.
@label=UpdateNextEntity
c$CF46 LD BC,$0026   ; Set the size of an entity to #N$26.
 $CF49 ADD IX,BC     ; Move on to the next entity.
 $CF4B POP BC        ; Restore the entity count.
 $CF4C DJNZ $CEF3    ; Decrease it and jump back until every entity has been
                     ; updated.
 $CF4E RET           ; Return.

; Add Displacement
;
; Used by the routine at #R$D037.
; .
; Adds a signed displacement to a position that is held in three bytes.
;
;   HL The displacement
;   C The top byte of the position
;   DE The bottom two bytes of the position
; O:C The new top byte
; O:HL The new bottom two bytes
@label=AddDisplacement
c$CF4F BIT 7,H       ; {Jump to #R$CF4F(#N$CF57) if the zero flag is reset.
 $CF51 JR NZ,$CF57   ; }
 $CF53 ADD HL,DE     ; #REGhl takes #REGde.
 $CF54 RET NC        ; Return if the carry flag is reset.
 $CF55 INC C         ; Advance #REGc.
 $CF56 RET           ; Return.
@label=AddDisplacement_Skip
*$CF57 ADD HL,DE     ; #REGhl takes #REGde.
 $CF58 RET C         ; Return if the carry flag is set.
 $CF59 DEC C         ; Step #REGc back.
 $CF5A RET           ; Return.

; Scale Displacement
;
; Used by the routine at #R$D037.
; .
; Works out the displacement of an entity along an axis. The high byte of
; the speed word at #R$5CEA is multiplied by the value in #REGbc, which is part
; of a direction vector, and divided by #N$10. The sign is taken from #REGb.
;
;   BC The part of the direction vector
; O:HL The displacement
@label=ScaleDisplacement
c$CF5B LD HL,($5CEA) ; Fetch the word at #R$5CEA into #REGhl.
 $CF5E PUSH BC       ; Remember #REGbc.
 $CF5F LD D,H        ; #REGh moves into #REGd.
 $CF60 CALL $CF7E    ; Call #R$CF7E.
 $CF63 SRL H         ; Shift #REGh right.
 $CF65 RR L          ; Rotate #REGl right through the carry flag.
 $CF67 SRL H         ; Shift #REGh right.
 $CF69 RR L          ; Rotate #REGl right through the carry flag.
 $CF6B SRL H         ; Shift #REGh right.
 $CF6D RR L          ; Rotate #REGl right through the carry flag.
 $CF6F SRL H         ; Shift #REGh right.
 $CF71 RR L          ; Rotate #REGl right through the carry flag.
 $CF73 POP BC        ; Bring back #REGbc.
 $CF74 INC B         ; Advance #REGb.
 $CF75 RET NZ        ; Return if the zero flag is reset.
 $CF76 LD A,L        ; #REGl moves into #REGa.
 $CF77 CPL           ; Invert the bits of #REGa.
 $CF78 LD L,A        ; #REGa moves into #REGl.
 $CF79 LD A,H        ; #REGh moves into #REGa.
 $CF7A CPL           ; Invert the bits of #REGa.
 $CF7B LD H,A        ; #REGa moves into #REGh.
 $CF7C INC HL        ; Advance #REGhl.
 $CF7D RET           ; Return.

; Multiply
;
; Used by the routine at #R$CF5B.
; .
; Multiplies the byte in #REGd by the byte in #REGc.
;
;   D One byte
;   C The other byte
; O:HL The product
;
; The byte in #REGd is multiplied by the byte in #REGc. Eight bits are
; tested, and each bit that is set adds the shifted byte into the product.
@label=Multiply
c$CF7E LD H,$00      ; {The product starts at zero, with eight bits to test.
 $CF80 LD B,H        ;
 $CF81 LD L,H        ;
 $CF82 LD E,D        ;
 $CF83 LD A,$08      ; }
 $CF85 JR $CF8D      ; Test the first bit.
@label=Multiply_Loop
*$CF87 DEC A         ; One fewer bit remains.
 $CF88 RET Z         ; The product is ready.
 $CF89 SLA C         ; {Shift the other byte up.
 $CF8B RL B          ; }
@label=Multiply_Bit
*$CF8D RR D          ; The next bit of the byte.
 $CF8F JR NC,$CF87   ; This bit adds nothing.
 $CF91 ADD HL,BC     ; Add the shifted byte into the product.
 $CF92 JP $CF87      ; The next bit.

; Limit Displacement
;
; Used by the routine at #R$D037.
; .
; Limits the displacement of the player to less than #N$09C0, if the
; player is in a certain range of positions. Purpose not yet known.
;
;   HL The displacement
;   IX The entity
; O:HL The limited displacement
@label=LimitDisplacement
c$CF95 LD A,(IX+$0E) ; Fetch the column.
 $CF98 CP $84        ; {Jump to #R$CF95(#N$CF9F) if it is #N$84 or more.
 $CF9A JR NC,$CF9F   ; }
 $CF9C CP $25        ; Compare #REGa with #N$25.
 $CF9E RET NC        ; Return if the carry flag is reset.
@label=LimitDisplacement_Skip
*$CF9F LD DE,$09C0   ; #REGde is #N$09C0.
 $CFA2 SBC HL,DE     ; Subtract #REGde from #REGhl. (with the carry)
 $CFA4 RET NC        ; Return if the carry flag is reset.
 $CFA5 ADD HL,DE     ; #REGhl takes #REGde.
 $CFA6 RET           ; Return.

; Update Drift
;
; Used by the routine at #R$D037.
; .
; Adds the amount in #REGa to the drift in field #N$20. Bits 0-1 are the
; amount and bit 2 makes it negative. A zero amount is handled by #R$D014.
; An eighth of the resulting drift is added to the displacement in #REGhl,
; which is then clamped to the limit in the high nibble of #REGb.
;
;   A The amount, in bits 0-1, with bit 2 for the direction
;   HL The displacement
;   IX The entity
; O:HL The limited displacement
@label=UpdateDrift
c$CFA7 LD C,A         ; Keep the amount aside.
 $CFA8 AND %00000011  ; Use bits 0-1 as the amount.
 $CFAA JP Z,$D014     ; A zero amount is handled by the decay.
 $CFAD ADD A,A        ; Double the amount.
 $CFAE BIT 2,C        ; {Bit 2 of the original amount makes it negative.
 $CFB0 JR Z,$CFB4     ; }
 $CFB2 NEG            ; Negate the amount.
; This entry point is used by the routine at #R$D014.
@label=UpdateDrift_Apply
*$CFB4 LD C,A         ; Keep the amount.
 $CFB5 LD A,(IX+$20)  ; Read the drift.
 $CFB8 AND $7F        ; {Use bits 0-6 of the drift.
 $CFBA LD E,A         ; }
 $CFBB AND %00011111  ; Use the low five bits as its magnitude.
 $CFBD BIT 7,(IX+$20) ; {The top bit makes that magnitude negative.
 $CFC1 JR Z,$CFC5     ; }
 $CFC3 NEG            ; Negate the magnitude.
@label=UpdateDrift_Add
*$CFC5 ADD A,C        ; Add the amount to the drift.
 $CFC6 BIT 7,A        ; {A negative result flips the sign.
 $CFC8 JR Z,$CFCE     ; }
 $CFCA NEG            ; {Negate it and set the sign.
 $CFCC SET 7,E        ; }
@label=UpdateDrift_Cap
*$CFCE AND %00011111  ; Use the low five bits as the new magnitude.
 $CFD0 LD D,A         ; Keep the new magnitude.
 $CFD1 LD A,E         ; {Shift the old limit down.
 $CFD2 RRA            ;
 $CFD3 RRA            ; }
 $CFD4 AND %00011000  ; Use bits 3-4 as that limit.
 $CFD6 CP D           ; {Keep the new magnitude when it is within the limit.
 $CFD7 JR NC,$CFDA    ;
 $CFD9 LD D,A         ; }
@label=UpdateDrift_Store
*$CFDA LD A,E         ; {Use the sign and the old limit bits.
 $CFDB AND $E0        ; }
 $CFDD OR D           ; {Combine them with the magnitude and keep the drift.
 $CFDE LD (IX+$20),A  ; }
 $CFE1 RLA            ; {A negative drift is subtracted from the displacement.
 $CFE2 JR NC,$CFE8    ; }
 $CFE4 LD A,D         ; {Negate the magnitude.
 $CFE5 NEG            ;
 $CFE7 LD D,A         ; }
@label=UpdateDrift_Shift
*$CFE8 LD E,$00       ; {Add an eighth of the drift to the displacement.
 $CFEA SRA D          ;
 $CFEC RR E           ;
 $CFEE SRA D          ;
 $CFF0 RR E           ;
 $CFF2 SRA D          ;
 $CFF4 RR E           ;
 $CFF6 ADD HL,DE      ; }
 $CFF7 LD A,B         ; {Shift the limit in #REGb down by four.
 $CFF8 RRA            ;
 $CFF9 RRA            ;
 $CFFA RRA            ;
 $CFFB RRA            ; }
 $CFFC AND %00001111  ; Use the low four bits as the limit.
 $CFFE LD B,A         ; {Keep the limit.
 $CFFF LD A,H         ; }
 $D000 BIT 7,A        ; {A negative displacement is clamped to it.
 $D002 LD A,B         ;
 $D003 JR Z,$D00D     ; }
 $D005 NEG            ; {Compare the displacement with the negative limit.
 $D007 CP H           ; }
 $D008 RET C          ; Leave it when it is inside the limit.
 $D009 LD H,A         ; {Clamp the displacement to that limit.
 $D00A LD L,$00       ;
 $D00C RET            ; }
@label=UpdateDrift_Positive
*$D00D DEC A          ; {A positive displacement is cleared only when the limit
 $D00E RET NC         ; is zero.}
 $D00F INC A          ; {Clear the displacement.
 $D010 LD H,A         ;
 $D011 LD L,$00       ;
 $D013 RET            ; }

; Decay Drift
;
; Used by the routine at #R$CFA7.
; .
; Moves the drift of an entity, which is held in field #N$20, one step
; towards zero.
;
; HL The displacement
; IX The entity
@label=DecayDrift
c$D014 LD A,(IX+$20)   ; Read the drift.
 $D017 AND %00011111   ; Use the magnitude in the low five bits.
 $D019 RET Z           ; The drift is already zero.
 $D01A PUSH HL         ; Remember the displacement.
 $D01B LD A,$01        ; The nudge is one.
 $D01D BIT 7,(IX+$20)  ; {A negative drift is nudged the other way.
 $D021 JR NZ,$D025     ; }
 $D023 NEG             ; The nudge is minus one.
@label=DecayDrift_Nudge
*$D025 CALL $CFB4      ; Nudge the drift.
 $D028 LD A,D          ; {The nudge crossed zero when the signs differ.
 $D029 XOR (IX+$20)    ;
 $D02C RLA             ;
 $D02D JR NC,$D035     ; }
 $D02F LD (IX+$20),$00 ; {Clear the drift and restore the displacement.
 $D033 POP HL          ; }
 $D034 RET             ; Return.
@label=DecayDrift_Keep
*$D035 POP DE          ; Keep the updated displacement.
 $D036 RET             ; Return.

; Move Entity
;
; Used by the routines at #R$CCD2, #R$CD11 and #R$CF30.
; .
; Moves an entity for one frame, which is used for all of the types of
; entity that move. The entity is moved along its heading by the speed in fields
; #N$12-#N$15, changed by its direction vector from #R$A6EB, and the vertical
; speed in fields #N$12 and #N$13 is applied to the height. Purpose of the
; individual steps is not yet known.
;
; IX The entity
;
; Return if the entity is not in use, and hand over to #R$D202 if it is
; following a path.
@label=MoveEntity
c$D037 LD A,(IX+$00)   ; Fetch the type of the entity.
 $D03A AND A           ; Test it.
 $D03B RET Z           ; Return if the entity is not in use.
 $D03C LD A,(IX+$24)   ; Fetch the first byte of the path of the entity.
 $D03F OR (IX+$25)     ; Combine it with the second byte.
 $D042 JP NZ,$D202     ; Jump to #R$D202 to follow the path if the entity has
                       ; one.
; Return if the sprite of the entity has not been set up, and note whether
; the entity is fast.
 $D045 LD A,(IX+$16)   ; Fetch the width of the sprite.
 $D048 AND %11110000   ; Use bits 4-7.
 $D04A RET NZ          ; Return if any of them are set.
 $D04B LD A,(IX+$17)   ; Fetch the height of the sprite.
 $D04E AND %11000000   ; Use bits 6-7.
 $D050 RET NZ          ; Return if any of them are set.
 $D051 LD A,(IX+$10)   ; Fetch the speed of the entity.
 $D054 SUB $50         ; Subtract #N$50.
 $D056 JR NC,$D05E     ; Jump to #R$D05E if the speed is at least #N$50.
 $D058 RES 7,(IX+$1E)  ; Clear bit 7 of the flags of the entity.
 $D05C JR $D062        ; Jump to #R$D062.
@label=MoveEntity_Fast
*$D05E SET 7,(IX+$1E)  ; Set bit 7 of the flags of the entity.
; Copy the position of the entity into the code that tests its collisions
; and the code at the end of this routine, which use it as the position that the
; entity started the frame at.
@label=MoveEntity_Position
*$D062 LD H,(IX+$02)   ; {Fetch the x coordinate of the entity.
 $D065 LD L,(IX+$03)   ; }
 $D068 LD ($D457),HL   ; Store it in the collision code.
 $D06B LD H,(IX+$05)   ; {Fetch the y coordinate of the entity.
 $D06E LD L,(IX+$06)   ; }
 $D071 LD ($D466),HL   ; Store it in the collision code.
 $D074 LD H,(IX+$08)   ; {Fetch the z coordinate of the entity.
 $D077 LD L,(IX+$09)   ; }
 $D07A LD ($D1F5),HL   ; Store it in the instruction at #R$D037(#N$D1F4), as the height that
                       ; the entity started the frame at.
; Change the speed of the entity. If the entity is not moving then the
; speed falls, and if it is moving then the speed rises, one step at a time, to
; the maximum.
 $D07D BIT 7,(IX+$11)  ; Test bit 7 of the heading of the entity.
 $D081 LD A,(IX+$1A)   ; Fetch the fraction of the speed.
 $D084 JR NZ,$D0AE     ; Jump to #R$D0AE if the entity is moving.
 $D086 SUB (IX+$1B)    ; Subtract the rate of change from the fraction.
 $D089 LD (IX+$1A),A   ; Store the fraction.
 $D08C JP NC,$D0DD     ; Jump to #R$D0DD if there was no step down.
 $D08F LD A,(IX+$10)   ; {Fetch the speed of the entity and keep it in #REGb.
 $D092 LD B,A          ; }
 $D093 AND %11110000   ; Keep the maximum speed in bits 4-7.
 $D095 LD E,A          ; Keep it in #REGe.
 $D096 LD A,B          ; Fetch the speed again.
 $D097 AND %00001111   ; Keep the current speed in bits 0-3.
 $D099 SUB $01         ; Take one away.
 $D09B JR C,$D0A4      ; Jump to #R$D0A4 if the speed was zero already.
 $D09D OR E            ; Add the maximum speed.
 $D09E LD (IX+$10),A   ; Store the new speed.
 $D0A1 JP $D0DD        ; Jump to #R$D0DD.
@label=MoveEntity_ZeroSpeed
*$D0A4 LD (IX+$10),E   ; Store the maximum speed as the speed, with the current
                       ; speed zero.
 $D0A7 LD (IX+$1A),$00 ; Set the fraction of the speed to #N$00.
 $D0AB JP $D0DD        ; Jump to #R$D0DD.
@label=MoveEntity_Moving
*$D0AE ADD A,(IX+$1B)  ; Add the rate of change to the fraction.
 $D0B1 LD (IX+$1A),A   ; Store the fraction.
 $D0B4 LD B,(IX+$10)   ; Fetch the speed of the entity.
 $D0B7 JR C,$D0C8      ; Jump to #R$D0C8 if there was a step up.
 $D0B9 LD A,B          ; Fetch the speed again.
 $D0BA RRCA            ; {Move the maximum speed down to bits 0-3.
 $D0BB RRCA            ;
 $D0BC RRCA            ;
 $D0BD RRCA            ; }
 $D0BE XOR B           ; Compare it with the current speed.
 $D0BF AND %00001111   ; Use bits 0-3.
 $D0C1 JR NZ,$D0DD     ; Jump to #R$D0DD if the current speed has not reached
                       ; the maximum.
 $D0C3 LD (IX+$1A),A   ; Set the fraction of the speed to zero.
 $D0C6 JR $D0DD        ; Jump to #R$D0DD.
@label=MoveEntity_StepUp
*$D0C8 LD A,B          ; Fetch the speed.
 $D0C9 AND %11110000   ; Keep the maximum speed in bits 4-7.
 $D0CB LD E,A          ; Keep it in #REGe.
 $D0CC RRCA            ; {Move the maximum speed down to bits 0-3...
 $D0CD RRCA            ;
 $D0CE RRCA            ;
 $D0CF RRCA            ; }
 $D0D0 LD C,A          ; ...and keep it in #REGc.
 $D0D1 LD A,B          ; Fetch the speed again.
 $D0D2 AND %00001111   ; Keep the current speed in bits 0-3.
 $D0D4 INC A           ; Add one.
 $D0D5 CP C            ; Compare it with the maximum speed.
 $D0D6 JR C,$D0D9      ; Jump to #R$D0D9 if it is below the maximum.
 $D0D8 LD A,C          ; Limit it to the maximum.
@label=MoveEntity_StoreSpeed
*$D0D9 OR E            ; Add the maximum speed in bits 4-7.
 $D0DA LD (IX+$10),A   ; Store the new speed.
; Change the vertical speed of the entity by its acceleration, limit it,
; and move the entity up or down by it.
@label=MoveEntity_Speed
*$D0DD LD H,(IX+$12)   ; {Fetch the vertical speed of the entity.
 $D0E0 LD L,(IX+$13)   ; }
 $D0E3 LD D,(IX+$14)   ; {Fetch the acceleration of the entity.
 $D0E6 LD E,(IX+$15)   ; }
 $D0E9 LD A,H          ; {Combine the four bytes.
 $D0EA OR L            ;
 $D0EB OR D            ;
 $D0EC OR E            ; }
 $D0ED JP Z,$D12C      ; Jump to #R$D12C if the entity is neither moving vertically nor
                       ; accelerating.
 $D0F0 ADD HL,DE       ; Add the acceleration to the vertical speed.
 $D0F1 BIT 7,H         ; {Jump to #R$D104 if the entity is moving down.
 $D0F3 JR NZ,$D104     ; }
 $D0F5 LD A,(IX+$1C)   ; Fetch the limit of the vertical speed from field
                       ; #N$1C.
 $D0F8 AND %00001111   ; Use bits 0-3.
 $D0FA DEC A           ; Take one away.
 $D0FB CP H            ; Compare it with the high byte of the vertical speed.
 $D0FC JR NC,$D111     ; Jump to #R$D111 if the speed is within the limit.
 $D0FE INC A           ; Add one back.
 $D0FF LD H,A          ; Limit the vertical speed to the limit...
 $D100 LD L,$00        ; ...with no fraction.
 $D102 JR $D111        ; Jump to #R$D111.
@label=MoveEntity_Falling
*$D104 LD A,(IX+$1C)   ; Fetch the limit of the vertical speed from field
                       ; #N$1C.
 $D107 AND %00001111   ; Use bits 0-3.
 $D109 CPL             ; Make it negative, for moving down.
 $D10A CP H            ; Compare it with the high byte of the vertical speed.
 $D10B JR C,$D111      ; Jump to #R$D111 if the speed is within the limit.
 $D10D INC A           ; Add one back.
 $D10E LD H,A          ; Limit the vertical speed to the limit...
 $D10F LD L,$00        ; ...with no fraction.
@label=MoveEntity_Height
*$D111 LD (IX+$12),H   ; {Store the vertical speed.
 $D114 LD (IX+$13),L   ; }
 $D117 LD D,(IX+$09)   ; {Fetch the z coordinate of the entity.
 $D11A LD E,(IX+$0A)   ;
 $D11D LD C,(IX+$08)   ; }
 $D120 CALL $CF4F      ; Add the vertical speed to the z coordinate.
 $D123 LD (IX+$09),H   ; {Store the new z coordinate.
 $D126 LD (IX+$0A),L   ;
 $D129 LD (IX+$08),C   ; }
; Set the entity going in the direction that it is heading. If the heading
; has changed, centre the entity within its cell on each axis.
@label=MoveEntity_Heading
*$D12C LD A,(IX+$22)   ; Fetch the heading that the entity had.
 $D12F AND %00111111   ; Use bits 0-5.
 $D131 LD B,A          ; Keep it in #REGb.
 $D132 LD A,(IX+$11)   ; Fetch the heading of the entity.
 $D135 AND %00111111   ; Use bits 0-5.
 $D137 CP B            ; Compare it with the old heading.
 $D138 JR Z,$D142      ; Jump to #R$D142 if it has not changed.
 $D13A LD (IX+$04),$7F ; Set the fraction of the x coordinate to #N$7F.
 $D13E LD (IX+$07),$7F ; Set the fraction of the y coordinate to #N$7F.
@label=MoveEntity_StoreHeading
*$D142 LD B,A          ; Keep the heading in #REGb.
 $D143 LD A,(IX+$22)   ; Fetch the old heading, with its flag.
 $D146 AND %01000000   ; Keep bit 6.
 $D148 OR B            ; Combine it with the heading.
 $D149 LD (IX+$22),A   ; Store it as the heading that the entity has.
; Work out the distance to move, from the speed, and the amount of it
; along each axis from the direction vector of the heading.
 $D14C LD H,(IX+$10)   ; Fetch the speed of the entity into #REGh...
 $D14F LD L,(IX+$1A)   ; ...and the fraction of the speed into #REGl.
 $D152 ADD HL,HL       ; {Multiply the speed by sixteen.
 $D153 ADD HL,HL       ;
 $D154 ADD HL,HL       ;
 $D155 ADD HL,HL       ; }
 $D156 LD A,(IX+$00)   ; Fetch the type of the entity.
 $D159 DEC A           ; Take one away.
 $D15A CALL Z,$CF95    ; Limit the distance if the entity is the player.
 $D15D LD ($5CEA),HL   ; Store the distance.
 $D160 LD A,(IX+$11)   ; Fetch the heading of the entity.
 $D163 CALL $A6EB      ; Get the direction vector of the heading.
 $D166 PUSH BC         ; Keep the first part of the vector.
 $D167 EXX             ; Switch to the alternate registers.
 $D168 POP BC          ; Take the first part of the vector off the stack.
 $D169 CALL $CF5B      ; Work out the displacement along the x axis.
 $D16C LD A,(IX+$00)   ; Fetch the type of the entity.
 $D16F DEC A           ; Take one away.
 $D170 JR NZ,$D17B     ; Jump to #R$D17B unless the entity is the player.
 $D172 LD B,(IX+$10)   ; Fetch the speed of the player.
 $D175 LD A,(IX+$1E)   ; Fetch the flags of the player, which hold the change
                       ; of the drift.
 $D178 CALL $CFA7      ; Change the drift, and limit the displacement.
@label=MoveEntity_First
*$D17B LD D,(IX+$03)   ; {Fetch the x coordinate of the entity.
 $D17E LD E,(IX+$04)   ;
 $D181 LD C,(IX+$02)   ; }
 $D184 CALL $CF4F      ; Add the displacement to the x coordinate.
 $D187 LD (IX+$02),C   ; {Store the new x coordinate.
 $D18A LD (IX+$04),L   ;
 $D18D LD (IX+$03),H   ; }
 $D190 EXX             ; Switch to the alternate registers.
 $D191 PUSH HL         ; Save the displacement along the y axis.
 $D192 EXX             ; Switch to the alternate registers.
 $D193 POP BC          ; Restore it into #REGbc.
 $D194 CALL $CF5B      ; Work out the displacement along the y axis.
 $D197 LD A,(IX+$00)   ; Fetch the type of the entity.
 $D19A DEC A           ; Take one away.
 $D19B JR NZ,$D1AD     ; Jump to #R$D1AD unless the entity is the player.
 $D19D LD B,(IX+$10)   ; Fetch the speed of the player.
 $D1A0 LD A,(IX+$1E)   ; Fetch the flags of the player, which hold the change
                       ; of the drift.
 $D1A3 RRA             ; {Shift the part that is for the y axis down to bits
 $D1A4 RRA             ; 0-2.
 $D1A5 RRA             ; }
 $D1A6 INC IX          ; Use the next field of the entity.
 $D1A8 CALL $CFA7      ; Change the drift, and limit the displacement.
 $D1AB DEC IX          ; Use the first field of the entity again.
@label=MoveEntity_Second
*$D1AD LD D,(IX+$06)   ; {Fetch the y coordinate of the entity.
 $D1B0 LD E,(IX+$07)   ;
 $D1B3 LD C,(IX+$05)   ; }
 $D1B6 CALL $CF4F      ; Add the displacement to the y coordinate.
 $D1B9 LD (IX+$05),C   ; {Store the new y coordinate.
 $D1BC LD (IX+$07),L   ;
 $D1BF LD (IX+$06),H   ; }
; Note that the entity has moved, and check what it has collided with.
 $D1C2 LD A,(IX+$1E)   ; Fetch the flags of the entity.
 $D1C5 AND %11000000   ; Use bits 6-7.
 $D1C7 OR %01000000    ; Set bit 6, to show that it has moved.
 $D1C9 LD (IX+$1E),A   ; Store the flags.
 $D1CC LD (IX+$1F),$FF ; Set field #N$1F of the entity to #N$FF.
 $D1D0 BIT 6,(IX+$01)  ; Test bit 6 of the frame of the entity.
 $D1D4 RET NZ          ; Return if it is set.
 $D1D5 LD A,(IX+$00)   ; Fetch the type of the entity.
 $D1D8 CP $09          ; {Jump to #R$D1E0 unless it is a shot.
 $D1DA JR NZ,$D1E0     ; }
 $D1DC XOR A           ; {Set the vertical speed of the shot to zero.
 $D1DD LD (IX+$12),A   ; }
@label=MoveEntity_TestCollisions
*$D1E0 CALL $D3EB      ; Test the collisions of the entity.
 $D1E3 LD A,(IX+$00)   ; Fetch the type of the entity.
 $D1E6 AND A           ; Test it.
 $D1E7 RET Z           ; Return if the entity has been removed.
 $D1E8 CP $05          ; Compare the type with #N$05.
 $D1EA LD A,$FF        ; Set the height to test to #N$FF.
 $D1EC JR Z,$D1FB      ; Jump to #R$D1FB if the type is #N$05.
 $D1EE LD H,(IX+$08)   ; {Fetch the z coordinate of the entity.
 $D1F1 LD L,(IX+$09)   ; }
 $D1F4 LD DE,$0000     ; Set #REGde to the height that the entity started at, which is
                       ; patched in.
 $D1F7 SBC HL,DE       ; Subtract it to find how far the entity has risen.
 $D1F9 DEC HL          ; Take one away.
 $D1FA LD A,L          ; Keep the low byte.
@label=MoveEntity_TestCells
*$D1FB LD ($DAB2),A    ; Store it in the code that tests the cells.
 $D1FE CALL $D7E4      ; Test the cells that the entity is in.
 $D201 RET             ; Return.

; Follow Path
;
; Used by the routine at #R$D037.
; .
; Moves an entity that is following a path from the level data, which is
; the case when fields #N$24 and #N$25 are not both zero. Bits 0-2 of field
; #N$25 choose a three-byte step from a table. Bits 6-7 of field #N$24 can
; replace that step: #N$40 lowers the entity and can play the long buzz,
; #N$80 moves it back along y, and #N$C0 moves it on along x. The three bytes
; of a looked-up step are added to x, y and z. A step above #N$08 finishes
; the path. The player can be scored and shown the filled cup, and a path
; position is then copied into the entity before the falling sweep plays.
;
; IX The entity
@label=FollowPath
c$D202 RES 7,(IX+$11)  ; Clear the moving flag.
 $D206 RES 7,(IX+$1E)  ; Clear the fast flag.
 $D20A CALL $D389      ; Find the path entry.
 $D20D PUSH HL         ; Remember the entry.
 $D20E LD A,(IX+$25)   ; Read the low byte of the path.
 $D211 AND %00000111   ; Keep the step number in bits 0-2.
 $D213 JR NZ,$D219     ; Look the step up when a number is set.
 $D215 DEC HL          ; {Use the two bytes just before the entry.
 $D216 DEC HL          ; }
 $D217 JR $D224        ; Join the stored step.
@label=FollowPath_Lookup
*$D219 DEC A           ; {Turn the step number into a table offset.
 $D21A ADD A,A         ;
 $D21B ADD A,A         ; }
 $D21C CALL $AA3C      ; Look the offset up.
 $D21F LD C,(HL)       ; {Read the x step, the y step and the z step.
 $D220 INC HL          ;
 $D221 LD B,(HL)       ;
 $D222 INC HL          ;
 $D223 LD E,(HL)       ; }
@label=FollowPath_Step
*$D224 LD ($D376),HL   ; Remember where the path continues.
 $D227 LD A,(IX+$24)   ; Read the high byte of the path.
 $D22A AND %11000000   ; Keep the nudge in bits 6-7.
 $D22C JR Z,$D24D      ; Use the looked-up step when there is no nudge.
 $D22E CP $40          ; {Lower the entity when the nudge is #N$40.
 $D230 JR NZ,$D241     ; }
 $D232 LD A,(IX+$25)   ; Read the low byte of the path again.
 $D235 CP $40          ; {Play the long buzz when that byte is #N$40 as well.
 $D237 CALL Z,$9F2A    ; }
 $D23A LD BC,$0000     ; Clear the x step and the y step.
 $D23D LD E,$FE        ; Lower the entity by two.
 $D23F JR $D24D        ; Add the step.
@label=FollowPath_Nudge
*$D241 LD B,$FE        ; {Move the entity back along y, and clear the other
 $D243 LD C,$00        ; steps.
 $D245 LD E,C          ; }
 $D246 CP $80          ; {Keep that nudge when the bits are #N$80.
 $D248 JR Z,$D24D      ; }
 $D24A LD C,$02        ; {Move the entity on along x instead.
 $D24C LD B,E          ; }
@label=FollowPath_Z
*$D24D LD H,(IX+$08)   ; {Fetch the z coordinate.
 $D250 LD L,(IX+$09)   ; }
 $D253 LD D,$00        ; {Sign-extend the z step.
 $D255 BIT 7,E         ;
 $D257 JR Z,$D25A      ;
 $D259 DEC D           ; }
@label=FollowPath_AddZ
*$D25A ADD HL,DE       ; {Add the z step to the z coordinate.
 $D25B LD (IX+$08),H   ;
 $D25E LD (IX+$09),L   ; }
 $D261 LD E,C          ; {Sign-extend the x step.
 $D262 BIT 7,E         ;
 $D264 LD D,$00        ;
 $D266 JR Z,$D269      ;
 $D268 DEC D           ; }
@label=FollowPath_X
*$D269 LD H,(IX+$02)   ; {Fetch the x coordinate.
 $D26C LD L,(IX+$03)   ; }
 $D26F ADD HL,DE       ; {Add the x step to the x coordinate.
 $D270 LD (IX+$02),H   ;
 $D273 LD (IX+$03),L   ; }
 $D276 LD E,B          ; {Sign-extend the y step.
 $D277 BIT 7,E         ;
 $D279 LD D,$00        ;
 $D27B JR Z,$D27E      ;
 $D27D DEC D           ; }
@label=FollowPath_Y
*$D27E LD H,(IX+$05)   ; {Fetch the y coordinate.
 $D281 LD L,(IX+$06)   ; }
 $D284 ADD HL,DE       ; {Add the y step to the y coordinate.
 $D285 LD (IX+$05),H   ;
 $D288 LD (IX+$06),L   ; }
; A step above #N$08 finishes the path. A step of exactly #N$08, or a
; step number that no longer matches the entry, reads the next path byte.
 $D28B POP HL          ; Restore the path entry.
 $D28C LD A,(IX+$25)   ; {A step of #N$08 reads the next path byte.
 $D28F SUB $08         ;
 $D291 JP Z,$D375      ; }
 $D294 JR NC,$D2C6     ; A larger step finishes the path.
 $D296 LD A,(IX+$25)   ; Read field #N$25 again.
 $D299 AND %00000111   ; Use the step number.
 $D29B DEC HL          ; {Compare it with the byte before the entry.
 $D29C CP (HL)         ; }
 $D29D JP NZ,$D375     ; Read the next path byte when they differ.
 $D2A0 LD A,(IX+$24)   ; Read field #N$24.
 $D2A3 AND %11000000   ; Use bits 6-7 of the path.
 $D2A5 JR Z,$D2CA      ; Copy the path position when those bits are clear.
 $D2A7 LD A,(IX+$00)   ; {Only the player finishes the path here.
 $D2AA DEC A           ;
 $D2AB JR NZ,$D2C2     ; }
 $D2AD LD HL,$0000     ; {Set the player's vertical speed to #N$2200.
 $D2B0 LD ($B552),HL   ; }
 $D2B3 LD ($5D00),A    ; Clear the jump counter.
 $D2B6 LD A,(IX+$10)   ; Read the width byte.
 $D2B9 AND %11110000   ; Use the countdown nibble.
 $D2BB LD (IX+$10),A   ; Clear the sprite width.
 $D2BE LD (IX+$1A),$00 ; Clear the fraction of the speed.
@label=FollowPath_Clear
*$D2C2 XOR A           ; {Clear field #N$24.
 $D2C3 LD (IX+$24),A   ; }
@label=FollowPath_Finish
*$D2C6 LD (IX+$25),A   ; {Clear field #N$25 and return.
 $D2C9 RET             ; }
; The byte stored by #R$D389 chooses the player's reward. Zero scores
; #N$0500. Any other byte, the first time, scores #N$0060 and draws the cup.
@label=FollowPath_Reward
*$D2CA LD A,(IX+$00)   ; {Only the player is rewarded.
 $D2CD DEC A           ;
 $D2CE JR NZ,$D308     ; }
 $D2D0 EXX             ; Switch to the reward byte.
 $D2D1 LD A,$00        ; {Score #N$0500 when the path byte is zero.
 $D2D3 AND A           ;
 $D2D4 JR NZ,$D2DE     ; }
 $D2D6 LD BC,$0500     ; {Add a score of #N$0500.
 $D2D9 CALL $9662      ; }
 $D2DC JR $D307        ; Skip the cup.
@label=FollowPath_Cup
*$D2DE LD A,($DEFC)    ; {The cup is shown only once.
 $D2E1 AND A           ;
 $D2E2 JR NZ,$D307     ; }
 $D2E4 LD A,($B55C)    ; Read the player's animation counter.
 $D2E7 AND %11110000   ; Use the high nibble of the animation.
 $D2E9 OR %00000101    ; Set the low nibble to #N$05.
 $D2EB LD ($B55C),A    ; Keep that animation.
 $D2EE LD A,$05        ; {Set the control byte to #N$05.
 $D2F0 LD ($AB7D),A    ; }
 $D2F3 LD BC,$0060     ; {Add a score of #N$0060.
 $D2F6 CALL $9662      ; }
 $D2F9 LD HL,$6808     ; {Draw the filled cup.
 $D2FC LD DE,$6498     ;
 $D2FF CALL $AAC4      ; }
 $D302 LD A,$01        ; {Remember that the cup has been shown.
 $D304 LD ($DEFC),A    ; }
*$D307 EXX             ; Switch back.
*$D308 DEC HL          ; Step back to the path's position.
 $D309 LD A,(IX+$24)   ; Read field #N$24.
 $D30C AND %00111111   ; Use bits 0-5 of the path.
 $D30E OR (HL)         ; {Combine them with the path byte and keep them.
 $D30F LD B,A          ;
 $D310 LD (IX+$24),A   ; }
 $D313 LD A,(IX+$25)   ; Read field #N$25.
 $D316 AND %00000111   ; Use the step number.
 $D318 OR %00100000    ; Mark the step with bit 5.
 $D31A LD (IX+$25),A   ; Keep the marked step.
 $D31D DEC HL          ; {Copy the path's coordinates into the entity.
 $D31E LD A,(HL)       ;
 $D31F LD (IX+$09),A   ;
 $D322 DEC HL          ;
 $D323 LD A,(HL)       ;
 $D324 LD (IX+$08),A   ;
 $D327 DEC HL          ;
 $D328 LD A,(HL)       ;
 $D329 LD (IX+$06),A   ;
 $D32C DEC HL          ;
 $D32D LD A,(HL)       ;
 $D32E LD (IX+$05),A   ;
 $D331 DEC HL          ;
 $D332 LD A,(HL)       ;
 $D333 LD (IX+$03),A   ;
 $D336 DEC HL          ;
 $D337 LD A,(HL)       ;
 $D338 LD (IX+$02),A   ; }
 $D33B LD A,B          ; Bring the new path flags back.
 $D33C AND %11000000   ; Use bits 6-7 of those flags.
 $D33E CP $90          ; {Place the entity on y unless the flags are #N$C0.
 $D340 JR NC,$D35B     ; }
 $D342 LD A,(IX+$06)   ; Read the low byte of y.
 $D345 AND %11110000   ; Use the high nibble of y.
 $D347 OR %00001000    ; Force the low nibble to #N$08.
 $D349 LD (IX+$06),A   ; Keep that y position.
 $D34C LD A,$10        ; {Shift x by half of #N$10 less the x extent.
 $D34E SUB (IX+$0B)    ;
 $D351 SRL A           ;
 $D353 ADD A,(IX+$03)  ;
 $D356 LD (IX+$03),A   ; }
 $D359 JR $D372        ; Join the falling sweep.
@label=FollowPath_PlaceX
*$D35B LD A,(IX+$03)   ; Read the low byte of x.
 $D35E AND %11110000   ; Use the high nibble of x.
 $D360 OR %00001000    ; Force the low nibble to #N$08.
 $D362 LD (IX+$03),A   ; Keep that x position.
 $D365 LD A,$10        ; {Shift y by half of #N$10 less the y extent.
 $D367 SUB (IX+$0C)    ;
 $D36A SRL A           ;
 $D36C ADD A,(IX+$06)  ;
 $D36F LD (IX+$06),A   ; }
*$D372 JP $9F31        ; Play the falling sweep.
@label=FollowPath_Next
*$D375 LD HL,$0000     ; {Read the next byte of the path table.
 $D378 LD DE,$0005     ;
 $D37B ADD HL,DE       ; }
 $D37C LD A,(HL)       ; {Use it as field #N$25.
 $D37D LD (IX+$25),A   ; }
 $D380 LD A,(IX+$24)   ; Read field #N$24.
 $D383 AND %00111111   ; Use bits 0-5 of the path.
 $D385 LD (IX+$24),A   ; Clear bits 6-7 of the path.
 $D388 RET             ; Return.

; Find Path Entry
;
; Used by the routine at #R$D202.
; .
; Finds the entry of the level data for the path of an entity. The entries
; are in a list that is found just before the level header at #R$5CFE.
;
;   IX The entity
; O:HL The address in the entry
@label=FindPathEntry
c$D389 LD HL,($5CFE) ; {The list sits just before the level header.
 $D38C DEC HL        ; }
 $D38D LD A,(IX+$24) ; {Twice bits 0-5 of field #N$24 select the entry.
 $D390 AND $3F       ;
 $D392 ADD A,A       ;
 $D393 LD E,A        ;
 $D394 LD D,$00      ; }
 $D396 AND A         ; {Step back that far in the list.
 $D397 SBC HL,DE     ; }
 $D399 LD E,(HL)     ; {The entry's address.
 $D39A INC HL        ;
 $D39B LD D,(HL)     ; }
 $D39C LD HL,$0004   ; {Four bytes into the entry.
 $D39F ADD HL,DE     ; }
 $D3A0 LD A,(HL)     ; {The reward byte, remembered for #R$D202.
 $D3A1 LD ($D2D2),A  ; }
 $D3A4 LD DE,$0008   ; {Eight bytes further on is returned.
 $D3A7 ADD HL,DE     ; }
 $D3A8 RET           ; Return.

; Find Path At Position
;
; Used by the routine at #R$D8E4.
; .
; Looks through the entries of the level data, which are found just before
; the level header at #R$5CFE, for one whose position matches the position of
; the entity. If one is found the entity is set to follow it by setting fields
; #N$24 and #N$25.
;
; IX The entity
;
; The list is walked backwards from just before the level header. Each
; entry is a pointer to four position bytes. A match stores the index in
; field #N$24 and #N$48 in field #N$25.
@label=FindPathAtPosition
c$D3A9 LD HL,($5CFE)   ; {The path list sits just before the level header.
 $D3AC DEC HL          ;
 $D3AD DEC HL          ;
 $D3AE DEC HL          ; }
 $D3AF LD C,$41        ; The first index is #N$41.
@label=FindPathAtPosition_Loop
*$D3B1 PUSH HL         ; Remember this point in the list.
 $D3B2 LD E,(HL)       ; {Read the pointer to the entry's position.
 $D3B3 INC HL          ;
 $D3B4 LD D,(HL)       ; }
 $D3B5 PUSH DE         ; {Use that position.
 $D3B6 POP IY          ; }
 $D3B8 LD A,(IX+$02)   ; {The high byte of x has to match.
 $D3BB CP (IY+$00)     ;
 $D3BE JR NZ,$D3E5     ; }
 $D3C0 LD A,(IX+$03)   ; Read the low byte of x.
 $D3C3 AND %11110000   ; Use its high nibble.
 $D3C5 CP (IY+$01)     ; {That nibble has to match the entry.
 $D3C8 JR NZ,$D3E5     ; }
 $D3CA LD A,(IX+$05)   ; {The high byte of y has to match.
 $D3CD CP (IY+$02)     ;
 $D3D0 JR NZ,$D3E5     ; }
 $D3D2 LD A,(IX+$06)   ; Read the low byte of y.
 $D3D5 AND %11110000   ; Use its high nibble.
 $D3D7 CP (IY+$03)     ; {That nibble has to match the entry.
 $D3DA JR NZ,$D3E5     ; }
 $D3DC LD (IX+$24),C   ; The index becomes field #N$24.
 $D3DF LD (IX+$25),$48 ; Field #N$25 becomes #N$48.
 $D3E3 POP HL          ; {Restore the list and return.
 $D3E4 RET             ; }
@label=FindPathAtPosition_Next
*$D3E5 POP HL          ; {Step back to the previous entry and take the next
 $D3E6 DEC HL          ; index.
 $D3E7 DEC HL          ;
 $D3E8 INC C           ; }
 $D3E9 JR $D3B1        ; Try that entry.

; Test Entity Collisions
;
; Used by the routine at #R$D037.
; .
; Tests the entity against each of the other entities with #R$D47A.
; A puff and a shot are not tested. A player skips puffs and sparkles, and a
; saucer skips shots. A disc, a free slot and a hidden entity are skipped.
; The direction bytes are #N$20 during the tests. Afterwards the low bytes of
; x and y, relative to the patched origins, replace them for #R$D7E4. The
; step in #R$DDD5 is removed for the tests and then put back.
;
; IX The entity
;
; The direction bytes start at #N$20 so a hit during the tests has a
; neutral component. The type of this entity is patched into the skip below.
@label=TestEntityCollisions
c$D3EB LD A,$04        ; {Mark the entity as only touching.
 $D3ED LD ($DD4C),A    ; }
 $D3F0 LD A,(IX+$00)   ; {Remember this entity's type for the skips below.
 $D3F3 LD ($D41F),A    ; }
 $D3F6 CP $05          ; {A puff is not tested against the others.
 $D3F8 JR Z,$D456      ; }
 $D3FA CP $0E          ; {A shot is not tested against the others.
 $D3FC JR Z,$D456      ; }
 $D3FE LD (IX+$18),$20 ; {Set both direction bytes to #N$20.
 $D402 LD (IX+$19),$20 ; }
 $D406 XOR A           ; {Clear the object flags and remove the move-back step.
 $D407 LD ($DDE4),A    ;
 $D40A LD ($5CD8),A    ; }
 $D40D LD B,$0C        ; There are #N$0C entities.
 $D40F LD IY,$B540     ; Start at the first entity.
@label=TestEntityCollisions_Loop
*$D413 PUSH BC         ; Remember how many entities remain.
 $D414 LD A,(IY+$00)   ; {Skip an entity that is free.
 $D417 AND A           ;
 $D418 JR Z,$D44E      ; }
 $D41A CP $0C          ; {Skip a disc.
 $D41C JR Z,$D44E      ; }
 $D41E LD A,$00        ; {The type patched above selects the next skips.
 $D420 LD L,A          ;
 $D421 DEC A           ; }
 $D422 JR NZ,$D42F     ; {A player does not test a puff or a sparkle.
 $D424 LD A,(IY+$00)   ;
 $D427 CP $05          ;
 $D429 JR Z,$D44E      ;
 $D42B CP $0D          ;
 $D42D JR Z,$D44E      ; }
@label=TestEntityCollisions_Saucer
*$D42F LD A,L          ; {A saucer does not test a shot.
 $D430 CP $09          ;
 $D432 JR NZ,$D43B     ; }
 $D434 LD A,(IY+$00)   ; {Skip the shot.
 $D437 CP $0E          ;
 $D439 JR Z,$D44E      ; }
@label=TestEntityCollisions_Frame
*$D43B LD A,(IY+$01)   ; Read the other entity's frame.
 $D43E AND %11000000   ; Use bits 6 and 7 of the frame.
 $D440 JR NZ,$D44E     ; Skip an entity with either bit set.
 $D442 PUSH IY         ; {It is not tested against itself.
 $D444 POP HL          ;
 $D445 PUSH IX         ;
 $D447 POP DE          ; }
 $D448 AND A           ; {Test the pair when the two entities differ.
 $D449 SBC HL,DE       ;
 $D44B CALL NZ,$D47A   ; }
@label=TestEntityCollisions_Next
*$D44E LD BC,$0026     ; {Move on to the next entity.
 $D451 ADD IY,BC       ; }
 $D453 POP BC          ; Bring the count back.
 $D454 DJNZ $D413      ; Repeat for the remaining entities.
@label=TestEntityCollisions_Finish
*$D456 LD DE,$0000     ; {Keep the low byte of x relative to the patched
 $D459 LD H,(IX+$02)   ; origin.
 $D45C LD L,(IX+$03)   ;
 $D45F AND A           ;
 $D460 SBC HL,DE       ;
 $D462 LD (IX+$18),L   ; }
 $D465 LD DE,$0000     ; {Keep the low byte of y relative to the patched
 $D468 LD H,(IX+$05)   ; origin.
 $D46B LD L,(IX+$06)   ;
 $D46E AND A           ;
 $D46F SBC HL,DE       ;
 $D471 LD (IX+$19),L   ; }
 $D474 LD A,$2D        ; {Put the step back into the move-back routine.
 $D476 LD ($DDE4),A    ; }
 $D479 RET             ; Return.

; Test Entity Pair
;
; Used by the routine at #R$D3EB.
; .
; Tests whether two entities overlap on x, then y, then z, using #R$D647.
; The three extents are fields #N$0B, #N$0C and #N$0D. The y test and the z
; test move #REGix so that those extents sit at the displacement the test
; reads. An overlap is stored at #R$DDCF for x, #R$DDCF(#N$DDD1) for y and
; #R$DDCF(#N$DDD3) for z. A puff with no width flags then scores, from the
; table at #R$D5BD, and becomes a sparkle. A whirler meeting the player, a
; spider and a shot all burst. A shot is then removed. A pickup is collected
; with #R$D5DF, and the player is moved clear with #R$DC75.
;
; IX The entity that is being moved
; IY The other entity
@label=TestEntityPair
c$D47A LD H,(IY+$02)   ; {Fetch the other entity's x coordinate.
 $D47D LD L,(IY+$03)   ; }
 $D480 LD D,(IX+$02)   ; {Fetch this entity's x coordinate.
 $D483 LD E,(IX+$03)   ; }
 $D486 LD C,(IY+$0B)   ; Fetch the other entity's x extent.
 $D489 LD B,(IX+$0B)   ; Fetch this entity's x extent.
 $D48C CALL $D647      ; Test the two x ranges.
 $D48F RET NC          ; Return if the x ranges do not overlap.
 $D490 INC L           ; {Remember the x overlap.
 $D491 LD ($DDCF),HL   ; }
 $D494 LD H,(IY+$05)   ; {Fetch the other entity's y coordinate.
 $D497 LD L,(IY+$06)   ; }
 $D49A LD D,(IX+$05)   ; {Fetch this entity's y coordinate.
 $D49D LD E,(IX+$06)   ; }
 $D4A0 LD C,(IY+$0C)   ; Fetch the other entity's y extent.
 $D4A3 LD B,(IX+$0C)   ; Fetch this entity's y extent.
 $D4A6 INC IX          ; Aim the test at the y extent.
 $D4A8 CALL $D647      ; Test the two y ranges.
 $D4AB DEC IX          ; Restore the entity address.
 $D4AD RET NC          ; Return if the y ranges do not overlap.
 $D4AE INC L           ; {Remember the y overlap.
 $D4AF LD ($DDD1),HL   ; }
 $D4B2 LD H,(IY+$08)   ; {Fetch the other entity's z coordinate.
 $D4B5 LD L,(IY+$09)   ; }
 $D4B8 LD D,(IX+$08)   ; {Fetch this entity's z coordinate.
 $D4BB LD E,(IX+$09)   ; }
 $D4BE PUSH IX         ; {Aim the test at the z extent.
 $D4C0 LD BC,$FFFA     ;
 $D4C3 ADD IX,BC       ; }
 $D4C5 LD C,(IY+$0D)   ; Fetch the other entity's z extent.
 $D4C8 LD B,(IX+$13)   ; Fetch this entity's z extent.
 $D4CB CALL $D647      ; Test the two z ranges.
 $D4CE POP IX          ; Restore the entity address.
 $D4D0 RET NC          ; Return if the z ranges do not overlap.
 $D4D1 INC L           ; {Remember the z overlap.
 $D4D2 LD ($DDD3),HL   ; }
; A puff whose width flags are clear scores and becomes a sparkle.
 $D4D5 LD A,(IY+$16)   ; {Leave this reward unless the width flags are clear.
 $D4D8 AND $F0         ;
 $D4DA JR NZ,$D506     ; }
 $D4DC LD A,(IY+$00)   ; {Score only when the other entity is a puff.
 $D4DF CP $05          ;
 $D4E1 JR NZ,$D506     ; }
 $D4E3 LD A,(IX+$00)   ; {Use this entity's type as an index into the score
 $D4E6 ADD A,A         ; table.}
 $D4E7 LD HL,$D5BB     ; Take the score table.
 $D4EA CALL $AA3C      ; Look the score up.
 $D4ED LD B,(HL)       ; {Read the score.
 $D4EE INC HL          ;
 $D4EF LD C,(HL)       ; }
 $D4F0 CALL $9662      ; Add the score.
 $D4F3 CALL $9924      ; Start a burst.
 $D4F6 LD (IY+$00),$0D ; Turn the puff into a sparkle.
 $D4FA LD (IY+$01),$00 ; Clear the sparkle's frame.
 $D4FE LD (IY+$17),$08 ; Set the sparkle's height to #N$08.
 $D502 LD (IY+$23),$04 ; Set the sparkle's countdown to #N$04.
; Nothing else happens while the countdown timer is running. The other
; entity is in #REGiy.
*$D506 LD A,($A2DF)    ; {Return while the countdown timer is running.
 $D509 AND A           ;
 $D50A RET NZ          ; }
 $D50B LD A,(IY+$16)   ; Read the other entity's width byte.
 $D50E AND %11110000   ; Use the countdown nibble.
 $D510 JR NZ,$D531     ; Skip the whirler test when that nibble is set.
 $D512 LD A,(IY+$00)   ; Read the other entity's type.
 $D515 DEC A           ; {The other entity is the player.
 $D516 JR NZ,$D521     ; }
 $D518 LD A,(IX+$00)   ; {A whirler bursts the player.
 $D51B CP $11          ;
 $D51D JR NZ,$D531     ; }
 $D51F JR $D52B        ; Burst them.
@label=TestEntityPair_Whirler
*$D521 CP $10          ; {The other entity is a whirler.
 $D523 JR NZ,$D531     ; }
 $D525 LD A,(IX+$00)   ; {This entity is the player.
 $D528 DEC A           ; }
 $D529 JR NZ,$D531     ; Leave the pair when it is not.
@label=TestEntityPair_Burst
*$D52B CALL $9924      ; Burst the other entity.
 $D52E CALL $D5AD      ; Finish bursting it.
@label=TestEntityPair_Spider
*$D531 LD A,(IY+$00)   ; {A spider bursts.
 $D534 CP $10          ;
 $D536 CALL Z,$9924    ; }
 $D539 LD A,(IY+$00)   ; {A shot bursts and is removed.
 $D53C CP $0E          ;
 $D53E JR NZ,$D54B     ; }
 $D540 CALL $9924      ; Burst the shot.
 $D543 LD (IY+$00),$00 ; Remove the shot.
 $D547 LD (IY+$01),$80 ; Hide what remains of it.
@label=TestEntityPair_Pickup
*$D54B LD A,(IY+$00)   ; {A pickup is collected.
 $D54E CP $0F          ;
 $D550 CALL Z,$D5DF    ; }
 $D553 LD A,(IX+$00)   ; {The player is moved clear of the overlap.
 $D556 DEC A           ;
 $D557 JP Z,$DC75      ; }
 $D55A CP $0E          ; {A shot is collected from the other side.
 $D55C JR NZ,$D571     ; }
 $D55E PUSH IY         ; {Swap the two entities.
 $D560 PUSH IX         ;
 $D562 POP IY          ;
 $D564 POP IX          ; }
 $D566 CALL $D5DF      ; Collect the item.
 $D569 PUSH IY         ; {Swap the two entities back.
 $D56B PUSH IX         ;
 $D56D POP IY          ;
 $D56F POP IX          ; }
@label=TestEntityPair_Clear
*$D571 XOR A           ; {Clear the handled flag.
 $D572 LD ($D5A4),A    ; }
 $D575 LD HL,($DDD3)   ; {Reduce the z overlap by one.
 $D578 DEC L           ;
 $D579 LD ($DDD3),HL   ; }
 $D57C LD HL,($DDCF)   ; {Reduce the x overlap by two.
 $D57F DEC L           ;
 $D580 DEC L           ;
 $D581 LD ($DDCF),HL   ; }
 $D584 LD HL,($DDD1)   ; {Reduce the y overlap by two.
 $D587 DEC L           ;
 $D588 DEC L           ;
 $D589 LD ($DDD1),HL   ; }
 $D58C LD C,(IX+$1F)   ; {Remember the flags and field #N$1F.
 $D58F LD B,(IX+$1E)   ;
 $D592 PUSH BC         ; }
 $D593 CALL $DC75      ; Move the entity clear of the overlap.
 $D596 POP BC          ; Bring the saved values back.
 $D597 LD (IX+$1F),C   ; Restore field #N$1F.
 $D59A LD A,B          ; {Use bit 6 of the saved flags.
 $D59B AND $40         ; }
 $D59D OR (IX+$1E)     ; {Keep that bit in the flags.
 $D5A0 LD (IX+$1E),A   ; }
 $D5A3 LD A,$00        ; {Return unless the patched kind is #N$0B.
 $D5A5 CP $0B          ;
 $D5A7 RET NZ          ; }
 $D5A8 LD A,(IY+$00)   ; {Return unless the other entity is the player.
 $D5AB DEC A           ;
 $D5AC RET NZ          ; }
; Continue on to #R$D5AD.

; Burst Other Entity
;
; Used by the routine at #R$D47A.
; .
; Bursts the other entity, by calling #R$9924 with #REGiy in place of
; #REGix.
;
; IX The entity that is being moved
; IY The other entity
@label=BurstOtherEntity
c$D5AD PUSH IX       ; Remember #REGix.
 $D5AF PUSH IY       ; Remember #REGiy.
 $D5B1 POP IX        ; Bring back #REGix.
 $D5B3 CALL $9924    ; Call #R$9924.
 $D5B6 PUSH IX       ; Remember #REGix.
 $D5B8 POP IY        ; Bring back #REGiy.
 $D5BA POP IX        ; Bring back #REGix.
 $D5BC RET           ; Return.

; Score Table
;
; The points that are scored when the player hits an entity, in binary
; coded decimal and indexed by the type of the entity, which is doubled and
; added to #N$D5BB. The values are the highest two digits and the lowest two
; digits, as for #R$9662.
@label=ScoreTable
b$D5BD DEFB $00,$05
 $D5BF DEFB $00,$00
 $D5C1 DEFB $00,$00
 $D5C3 DEFB $00,$00
 $D5C5 DEFB $00,$00
 $D5C7 DEFB $00,$00
 $D5C9 DEFB $00,$00
 $D5CB DEFB $00,$05
 $D5CD DEFB $00,$50
 $D5CF DEFB $00,$15
 $D5D1 DEFB $00,$25
 $D5D3 DEFB $00,$00
 $D5D5 DEFB $00,$00
 $D5D7 DEFB $00,$00
 $D5D9 DEFB $00,$40
 $D5DB DEFB $00,$00
 $D5DD DEFB $00,$30

; Collect Item
;
; Used by the routine at #R$D47A.
; .
; Deals with an entity touching an entity of the type #N$0F. Nothing
; happens while the counter in the high nibble of field #N$16 of the other
; entity is running, or while its frame (the low five bits of field #N$01) is
; below #N$04. Frames #N$04 and #N$05 burst the touching entity (see #R$9924)
; and free the other entity. Frames of #N$06 or more are collected if the
; touching entity is the player: #N$0100 points are added to the score and the
; other entity starts to disappear. Frame #N$07 also gives an extra life, which
; is printed, and plays the rising sweep. Frame #N$08 gives #N$0900 more points,
; and the other frames give #N$0150 more points and fill the first gauge.
; Purpose of the individual frames is not yet known.
;
; IX The entity that is moved
; IY The entity of type #N$0F
@label=CollectItem
c$D5DF LD A,(IY+$16)   ; Read field #N$16 of the other entity.
 $D5E2 AND %11110000   ; Keep the counter in bits 4-7.
 $D5E4 RET NZ          ; Return if the counter is running.
 $D5E5 LD A,(IY+$01)   ; Fetch the frame of the other entity.
 $D5E8 AND %00011111   ; Keep the number of the frame.
 $D5EA CP $04          ; Compare it with #N$04.
 $D5EC RET C           ; Return if the frame is lower.
 $D5ED CP $06          ; {Jump to #R$D5FD if the frame is #N$06 or more.
 $D5EF JR NC,$D5FD     ; }
 $D5F1 CALL $9924      ; Burst the touching entity.
 $D5F4 LD (IY+$00),$00 ; Free the other entity...
 $D5F8 LD (IY+$01),$80 ; ...and hide it.
 $D5FC RET             ; Return.
@label=CollectItem_Collect
*$D5FD LD A,(IX+$00)   ; Fetch the type of the touching entity.
 $D600 DEC A           ; Decrease it by one.
 $D601 RET NZ          ; Return if it is not the player.
 $D602 LD BC,$0100     ; Set the points to #N$0100.
 $D605 CALL $9662      ; Add them to the score.
 $D608 SET 7,(IY+$16)  ; Start the counter in field #N$16 of the other entity.
 $D60C LD (IY+$20),$0F ; Set field #N$20 of the other entity to #N$0F.
 $D610 LD A,(IY+$01)   ; Fetch the frame of the other entity.
 $D613 AND %00011111   ; Keep the number of the frame.
 $D615 CP $07          ; {Jump to #R$D630 if it is not the frame that gives an
 $D617 JR NZ,$D630     ; extra life.}
; This entry point is used by the routines at #R$9662 and #R$9690.
@label=CollectItem_ExtraLife
*$D619 LD A,($DEDE)    ; Fetch the number of lives.
 $D61C INC A           ; Add one.
 $D61D LD ($DEDE),A    ; Store it.
 $D620 DEC A           ; Take away one to find the number of lives that are to
                       ; be shown.
 $D621 CALL $E1E9      ; Convert it into digits.
 $D624 LD ($E1A9),HL   ; Store them in the text record of the lives.
 $D627 LD DE,$E1A5     ; Point #REGde at #R$E1A5.
 $D62A CALL $A923      ; Print it.
 $D62D JP $9EB7        ; Jump to #R$9EB7.
@label=CollectItem_Frame
*$D630 CP $08          ; {Jump to #R$D63A if it is not that frame.
 $D632 JR NZ,$D63A     ; }
 $D634 LD BC,$0900     ; Set the points to #N$0900.
 $D637 JP $9662        ; Jump to #R$9662.
@label=CollectItem_Other
*$D63A LD BC,$0150     ; Set the points to #N$0150.
 $D63D CALL $9662      ; Add them to the score.
 $D640 LD HL,$6000     ; #REGhl is #N$6000, a full gauge.
 $D643 LD ($A59F),HL   ; Fill the first gauge.
 $D646 RET             ; Return.

; Test Overlap
;
; Used by the routine at #R$D47A.
; .
; Tests whether two ranges overlap. The carry is set when they do, and
; #REGl is the amount of the overlap. No overlap leaves the carry clear.
;
;   HL The start of the first range
;   DE The start of the second range
;   B The size of the first range
;   C The size of the second range
; O:F The carry flag is set if they overlap
; O:L The amount of the overlap
;
; #REGb is the size of the first range and #REGc the size of the second.
; The result is the smaller amount by which they cross.
@label=TestOverlap
c$D647 XOR A         ; {Subtract the second start from the first.
 $D648 SBC HL,DE     ; }
 $D64A JR C,$D664    ; The second range starts first.
 $D64C OR H          ; {No overlap when the starts are a byte or more apart.
 $D64D RET NZ        ; }
 $D64E LD A,L        ; {No overlap when the gap is at least the first size.
 $D64F SUB B         ;
 $D650 RET NC        ; }
 $D651 NEG           ; {The overlap is the first size less that gap.
 $D653 ADD HL,DE     ;
 $D654 LD B,$00      ;
 $D656 ADD HL,BC     ;
 $D657 SBC HL,DE     ;
 $D659 LD H,$00      ; }
 $D65B CP L          ; {Keep the smaller of the two amounts.
 $D65C JR NC,$D660   ; }
 $D65E LD L,A        ; {Return that overlap.
 $D65F RET           ; }
@label=TestOverlap_Overlap
*$D660 LD H,$FF      ; {Return the overlap that reached the other size.
 $D662 SCF           ;
 $D663 RET           ; }
@label=TestOverlap_Before
*$D664 LD A,B        ; {Take the first size and clear the carry.
 $D665 LD B,$00      ;
 $D667 AND A         ; }
 $D668 PUSH HL       ; Remember where the ranges stood.
 $D669 ADC HL,BC     ; {Add the second size to the first start.
 $D66B LD C,A        ;
 $D66C LD A,L        ;
 $D66D POP HL        ; }
 $D66E RET NC        ; No overlap when the second size falls short.
 $D66F JP Z,$DE0F    ; The ranges meet on an edge.
 $D672 ADD HL,DE     ; {Measure how far the first range reaches back.
 $D673 EX DE,HL      ;
 $D674 ADD HL,BC     ;
 $D675 SBC HL,DE     ;
 $D677 LD H,$FF      ; }
 $D679 CP L          ; {Keep the smaller of the two amounts.
 $D67A JR NC,$D67E   ; }
 $D67C LD L,A        ; {Return that overlap.
 $D67D RET           ; }
@label=TestOverlap_Inside
*$D67E LD H,$00      ; {Return the overlap that reached the other size.
 $D680 SCF           ;
 $D681 RET           ; }

; Test Wide Overlap
;
; Used by the routine at #R$D8E4.
; .
; Tests the entity against a block with #R$D6DC after widening the x and y
; edges by half the matching extent, less four. For the test, the edge path
; takes its size from #REGa, and a miss on z returns the distance instead of
; setting the flags to #N$FF. The edges and those two patches are put back.
;
; IX The entity
@label=TestWideOverlap
c$D682 PUSH BC       ; Remember the caller's count.
 $D683 LD A,$4F      ; {Make the edge path take its size from #REGa.
 $D685 LD ($D716),A  ; }
 $D688 LD HL,($D6E7) ; {Widen the x edge by half the x extent, less four.
 $D68B LD B,$00      ;
 $D68D PUSH HL       ;
 $D68E LD C,(IX+$0B) ;
 $D691 SRL C         ;
 $D693 ADD HL,BC     ;
 $D694 LD C,$04      ;
 $D696 SBC HL,BC     ;
 $D698 LD ($D6E7),HL ; }
 $D69B LD HL,($D6F8) ; {Widen the y edge by half the y extent, less four.
 $D69E PUSH HL       ;
 $D69F LD C,(IX+$0C) ;
 $D6A2 SRL C         ;
 $D6A4 ADD HL,BC     ;
 $D6A5 LD C,$04      ;
 $D6A7 SBC HL,BC     ;
 $D6A9 LD ($D6F8),HL ; }
 $D6AC LD HL,($D73A) ; {A miss on z returns the distance instead of failing.
 $D6AF PUSH HL       ;
 $D6B0 LD A,$6F      ;
 $D6B2 LD H,A        ;
 $D6B3 LD L,$18      ;
 $D6B5 LD ($D73A),HL ; }
 $D6B8 CALL $D6DC    ; Test the widened block.
 $D6BB POP HL        ; {Put the edges and that branch back.
 $D6BC LD ($D73A),HL ;
 $D6BF POP HL        ;
 $D6C0 LD ($D6F8),HL ;
 $D6C3 POP HL        ;
 $D6C4 LD ($D6E7),HL ; }
 $D6C7 LD A,$48      ; {Put the edge path back to taking its size from #REGb.
 $D6C9 LD ($D716),A  ; }
 $D6CC POP BC        ; Restore the caller's count.
 $D6CD RET           ; Return.

; Test Edge Overlap
;
; Used by the routine at #R$D8E4.
; .
; Compares a patched position with a patched edge that has been moved
; back by four. The carry is set when the position is below that edge. #R$D8E4
; patches both operands before the call.
;
; .
;
; Both operands are patched before the call. The edge is moved back by
; four and the position is compared with it.
@label=TestEdgeOverlap
c$D6CE LD DE,$0000   ; {Move the patched edge back by four.
 $D6D1 DEC DE        ;
 $D6D2 DEC E         ;
 $D6D3 DEC E         ;
 $D6D4 DEC E         ; }
 $D6D5 LD HL,$0000   ; {Subtract that edge from the patched position.
 $D6D8 AND A         ;
 $D6D9 SBC HL,DE     ; }
 $D6DB RET C         ; Return when the position is below the edge.
; Continue on to #R$D6DC.

; Test Block Overlap
;
; Used by the routine at #R$D682.
; .
; Tests the entity against one axis of a block. #R$D8E4 patches the two
; edges in first. Bit 6 of the object's flags selects the x edges and the x
; extent; otherwise the y edges and the y extent are used. The overlap is
; stored for that axis, and for the player the side is mixed into the flags.
; No overlap on z sets the flags to #N$FF.
;
; IX The entity
; IY The object
;
; Bit 6 of the object's flags selects the axis. The two edges loaded
; below are patched by #R$D8E4.
@label=TestBlockOverlap
c$D6DC LD A,($5CD8)  ; Read the object's flags.
 $D6DF AND %01000000 ; Use bit 6 of the flags.
 $D6E1 JR Z,$D6F4    ; Test the y edges when bit 6 is clear.
 $D6E3 LD DE,$0000   ; {Take the patched x edges.
 $D6E6 LD HL,$0000   ; }
 $D6E9 LD A,(IY+$02) ; {Scale the object's byte and use the x extent.
 $D6EC ADD A,A       ;
 $D6ED ADD A,A       ;
 $D6EE ADD A,A       ;
 $D6EF LD B,(IX+$0B) ;
 $D6F2 JR $D700      ; }
@label=TestBlockOverlap_YAxis
*$D6F4 LD DE,$0000   ; {Take the patched y edges.
 $D6F7 LD HL,$0000   ; }
 $D6FA LD B,(IX+$0C) ; Use the y extent.
 $D6FD LD A,(IY+$02) ; Read the object's byte.
@label=TestBlockOverlap_Size
*$D700 ADD A,A       ; Double that byte.
 $D701 AND %01110000 ; Use bits 4-6.
 $D703 ADD A,$10     ; {Add #N$10 to make the size.
 $D705 LD C,A        ; }
 $D706 LD A,($5CD8)  ; Read the flags again.
 $D709 AND %00100000 ; Use bit 5 of the flags.
 $D70B JR Z,$D716    ; Measure from the far edge when bit 5 is set.
 $D70D EX DE,HL      ; {Subtract the near edge from the far edge plus the size.
 $D70E LD B,$00      ;
 $D710 ADD HL,BC     ;
 $D711 SBC HL,DE     ;
 $D713 XOR A         ; }
 $D714 JR $D71E      ; The marker for that side is zero.
@label=TestBlockOverlap_Edge
*$D716 LD C,B        ; {Subtract the near edge from the far edge plus the
 $D717 LD B,$00      ; extent.
 $D719 ADD HL,BC     ;
 $D71A SBC HL,DE     ; }
 $D71C LD A,$04      ; The marker for that side is #N$04.
@label=TestBlockOverlap_Mark
*$D71E LD ($D789),A  ; Remember the marker.
 $D721 LD B,$02      ; Start with a count of two.
 $D723 LD A,($5CD8)  ; Read the flags.
 $D726 AND %00010000 ; Use bit 4 of the flags.
 $D728 JR NZ,$D72F   ; Halve the overlap when bit 4 is clear.
 $D72A DEC B         ; {Halve the overlap and count one.
 $D72B SRL H         ;
 $D72D RR L          ; }
@label=TestBlockOverlap_Compare
*$D72F LD DE,($D6CF) ; {Add the edge address.
 $D733 ADD HL,DE     ; }
 $D734 LD DE,($D6D6) ; Subtract the z coordinate.
 $D738 SBC HL,DE     ; {No overlap on z sets the flags to #N$FF.
 $D73A JR C,$D7A5    ; }
 $D73C LD A,($DDD3)  ; {The overlap has to reach the stored z overlap.
 $D73F SUB L         ;
 $D740 JR C,$D77B    ; }
 $D742 SUB $02       ; {An overlap below two clears the flags.
 $D744 JR C,$D77B    ; }
 $D746 LD H,$FF      ; {Remember an overlap of #N$FF.
 $D748 LD ($DDD3),HL ; }
 $D74B LD A,($5CD8)  ; Read the flags.
 $D74E AND %01000000 ; Use bit 6 of the flags.
 $D750 LD A,H        ; {The x test records the overlap on x.
 $D751 JR NZ,$D780   ; }
 $D753 LD ($DDD1),A  ; Record the overlap on y.
 $D756 LD A,(IX+$00) ; {Only the player records the side.
 $D759 DEC A         ;
 $D75A RET NZ        ; }
 $D75B LD A,($D789)  ; {Combine the marker with the count.
 $D75E OR B          ; }
 $D75F ADD A,A       ; {Shift that side up by three.
 $D760 ADD A,A       ;
 $D761 ADD A,A       ; }
 $D762 LD B,A        ; Keep it for the flags.
 $D763 ADD A,A       ; {Shift it up by two more.
 $D764 ADD A,A       ; }
 $D765 AND %01100000 ; Use bits 5-6.
 $D767 LD C,A        ; Keep them for field #N$21.
 $D768 LD A,(IX+$1E) ; Read the flags.
 $D76B AND %11000111 ; Use the flag bits other than 3-5.
 $D76D OR B          ; {Mix the side into the flags.
 $D76E LD (IX+$1E),A ; }
 $D771 LD A,(IX+$21) ; Read field #N$21.
 $D774 AND %10011111 ; Use the bits other than 5-6.
 $D776 OR C          ; {Mix the side into field #N$21.
 $D777 LD (IX+$21),A ; }
 $D77A RET           ; Return.
*$D77B XOR A         ; {Clear the flags when the overlap is too small.
 $D77C LD ($5CD8),A  ;
 $D77F RET           ; }
*$D780 LD ($DDCF),A  ; Record the overlap on x.
 $D783 LD A,(IX+$00) ; {Only the player records the side.
 $D786 DEC A         ;
 $D787 RET NZ        ; }
 $D788 LD A,$00      ; {Combine the marker with the count.
 $D78A OR B          ; }
 $D78B LD B,A        ; Keep it.
 $D78C RRCA          ; {Shift the side down by three.
 $D78D RRCA          ;
 $D78E RRCA          ; }
 $D78F AND %01100000 ; Use bits 5-6.
 $D791 LD C,A        ; Keep them.
 $D792 LD A,(IX+$20) ; Read field #N$20.
 $D795 AND %10011111 ; Use the bits other than 5-6.
 $D797 OR C          ; {Mix the side into field #N$20.
 $D798 LD (IX+$20),A ; }
 $D79B LD A,(IX+$1E) ; Read the flags.
 $D79E AND %11111000 ; Use the top five bits of the flags.
 $D7A0 OR B          ; {Mix the count into the low bits of the flags.
 $D7A1 LD (IX+$1E),A ; }
 $D7A4 RET           ; Return.

; Flag Overlap
;
; Used by the routine at #R$D6DC.
; .
; Sets the flag at #R$5CD8 to #N$FF, to show that there is an overlap.
@label=FlagOverlap
c$D7A5 LD A,$FF      ; #REGa is #N$FF.
 $D7A7 LD ($5CD8),A  ; Write #REGa at #R$5CD8.
 $D7AA RET           ; Return.

; Get Overlap Distance
;
; Works out the distance that is needed to move out of an overlap. Purpose
; not yet known.
;
;   L The amount of the overlap
;   F The carry flag is set if there is an overlap
; O:E The distance
@label=GetOverlapDistance
c$D7AB LD E,$FF      ; #REGe is #N$FF.
 $D7AD RET NC        ; Return if the carry flag is reset.
 $D7AE LD A,L        ; #REGl moves into #REGa.
 $D7AF NEG           ; Negate #REGa.
 $D7B1 LD E,A        ; #REGa moves into #REGe.
 $D7B2 RET           ; Return.

; Object Flags Table
;
; A table of flags for each kind of object, which is used by #R$D8E4 and
; #R$C15E. #R$C15E indexes it with the shape kind. Bit 7 clear draws the block
; as it is. Bits 5-6 clear mirror it, #N$20 draws it as it is, #N$40 raises
; it, and any other value moves the origin back by #N$10. The index used by
; #R$D8E4 is made from the object's type byte. Purpose of the other bits is
; not yet known.
@label=ObjectFlagsTable
b$D7B3 DEFB $80,$90,$00,$00,$E0,$F0,$00,$80,$A0,$B0,$00,$00,$C0,$D0,$00,$00
 $D7C3 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $D7D3 DEFB $00,$10,$10,$10,$10,$10,$10,$10,$10,$10,$10,$10,$10,$10,$10,$10
 $D7E3 DEFB $10

; Test Entity Cells
;
; Used by the routine at #R$D037.
; .
; Tests each cell of the level that the entity's box covers, by calling
; #R$D8E4, and retests a cell when a collision moves the entity. When bit 6 of
; the flags is set, a z within one page of #N$FF is stored in field #N$1F,
; after a zero top byte has been snapped up by one unit. A hit planted by
; #R$DC6A then turns the heading away from it. Purpose of bit 6 is not yet
; known.
;
; IX The entity
;
; The cell is the high byte of x and the high byte of y. A collision can
; move those bytes, and the extent can make the entity cover the next cell.
@label=TestEntityCells
c$D7E4 LD L,(IX+$02)  ; {Take the cell from the high bytes of x and y.
 $D7E7 LD H,(IX+$05)  ; }
 $D7EA PUSH HL        ; {Test that cell.
 $D7EB CALL $D8E4     ; }
 $D7EE POP HL         ; Restore the cell.
 $D7EF LD A,(IX+$02)  ; {Retest the previous column when the high byte of x
 $D7F2 CP L           ; moved.
 $D7F3 JR Z,$D7F9     ; }
 $D7F5 DEC A          ; {Use the column below the new x.
 $D7F6 LD L,A         ;
 $D7F7 JR $D801       ; }
@label=TestEntityCells_SpanX
*$D7F9 LD A,(IX+$03)  ; {The entity covers the next column when the x extent
 $D7FC ADD A,(IX+$0B) ; carries.
 $D7FF JR NC,$D827    ; }
@label=TestEntityCells_Second
*$D801 PUSH HL        ; {Test the next column.
 $D802 INC L          ;
 $D803 CALL $D8E4     ; }
 $D806 POP HL         ; Restore the cell.
 $D807 LD A,(IX+$05)  ; {Retest this row when the high byte of y moved.
 $D80A CP H           ;
 $D80B JR Z,$D816     ; }
 $D80D LD H,A         ; {Test the entity's row, then the row above.
 $D80E PUSH HL        ;
 $D80F CALL $D8E4     ;
 $D812 POP HL         ;
 $D813 INC H          ;
 $D814 JR $D824       ; }
@label=TestEntityCells_SpanY
*$D816 LD A,(IX+$06)  ; {The entity covers the next row when the y extent
 $D819 ADD A,(IX+$0C) ; carries.
 $D81C JR NC,$D83C    ; }
 $D81E INC H          ; {Test the next row.
 $D81F PUSH HL        ;
 $D820 CALL $D8E4     ;
 $D823 POP HL         ; }
@label=TestEntityCells_Next
*$D824 INC L          ; {Test the diagonal cell too.
 $D825 JR $D839       ; }
@label=TestEntityCells_Moved
*$D827 LD A,(IX+$05)  ; {Use the entity's row when y has moved.
 $D82A CP H           ;
 $D82B JR Z,$D830     ; }
 $D82D LD H,A         ; {Use that row.
 $D82E JR $D839       ; }
@label=TestEntityCells_SpanRow
*$D830 LD A,(IX+$06)  ; {Cover the next row when the y extent carries.
 $D833 ADD A,(IX+$0C) ;
 $D836 JR NC,$D83C    ; }
 $D838 INC H          ; Use the next row.
@label=TestEntityCells_Cell
*$D839 CALL $D8E4     ; Test this cell.
; Bit 6 of the flags stores a z that is within one page of #N$FF into
; field #N$1F. A zero top byte is snapped up by one unit first. A pickup
; stores zero instead.
@label=TestEntityCells_Snap
*$D83C LD C,$00       ; Start with no hit. #R$DC6A plants one in this byte.
 $D83E BIT 6,(IX+$1E) ; {Snap z when bit 6 of the flags is set.
 $D842 JR Z,$D86B     ; }
 $D844 LD L,(IX+$09)  ; {A zero top byte of z is snapped up by one unit.
 $D847 LD A,(IX+$08)  ;
 $D84A AND A          ;
 $D84B JR NZ,$D85E    ; }
 $D84D LD L,A         ; {Write that snap back into z.
 $D84E LD (IX+$09),A  ;
 $D851 INC A          ;
 $D852 LD (IX+$08),A  ; }
 $D855 LD A,(IX+$00)  ; {A pickup stores zero in field #N$1F.
 $D858 CP $0F         ;
 $D85A JR Z,$D868     ; }
 $D85C LD A,L         ; {Otherwise measure from one.
 $D85D INC A          ; }
@label=TestEntityCells_Distance
*$D85E LD H,A         ; {Store the distance when z is within one page of #N$FF.
 $D85F XOR A          ;
 $D860 LD DE,$00FF    ;
 $D863 SBC HL,DE      ;
 $D865 OR H           ;
 $D866 JR NZ,$D86B    ; }
@label=TestEntityCells_Store
*$D868 LD (IX+$1F),L  ; Remember that distance in field #N$1F.
; A hit turns the heading. Fields #N$18 and #N$19 supply the two
; components, and the low bits of the hit choose which axis is turned.
@label=TestEntityCells_Hit
*$D86B LD A,C         ; {Return when nothing was hit.
 $D86C AND A          ;
 $D86D RET Z          ; }
 $D86E LD B,A         ; {Remember the hit and clear it.
 $D86F XOR A          ;
 $D870 LD ($D83D),A   ; }
 $D873 BIT 5,(IX+$01) ; {Return when bit 5 of the frame is set.
 $D877 RET NZ         ; }
 $D878 LD A,(IX+$18)  ; {Return when fields #N$18 and #N$19 are both zero.
 $D87B OR (IX+$19)    ;
 $D87E RET Z          ; }
 $D87F LD A,B         ; {Return when the hit was #N$FF.
 $D880 CP $FF         ;
 $D882 RET Z          ; }
 $D883 LD A,(IX+$18)  ; {Use field #N$18 as one component.
 $D886 AND A          ;
 $D887 JR NZ,$D896    ; }
 $D889 LD A,(IX+$11)  ; Read the heading.
 $D88C ADD A,$10      ; Add #N$10 to the heading.
 $D88E AND %00111111  ; Use the low six bits of the heading.
 $D890 CP $20         ; {Use #N$FE when those bits are #N$20 or more.
 $D892 JR C,$D896     ; }
 $D894 LD A,$FE       ; Use #N$FE for that component.
@label=TestEntityCells_Component
*$D896 LD L,A         ; Keep the first component.
 $D897 LD A,(IX+$19)  ; {Use field #N$19 as the other component.
 $D89A AND A          ;
 $D89B JR NZ,$D8A8    ; }
 $D89D LD A,(IX+$11)  ; Read the heading.
 $D8A0 AND %00111111  ; Use the low six bits of the heading.
 $D8A2 CP $20         ; {Use #N$FE when those bits are #N$20 or more.
 $D8A4 JR C,$D8A8     ; }
 $D8A6 LD A,$FE       ; Use #N$FE for that component.
@label=TestEntityCells_Other
*$D8A8 LD H,A         ; Keep the second component.
 $D8A9 LD A,B         ; {Use the low two bits of the hit.
 $D8AA AND $03        ; }
 $D8AC JR Z,$D8B2     ; {Swap the components when the hit was on x.
 $D8AE LD B,H         ;
 $D8AF LD C,L         ;
 $D8B0 JR $D8BB       ; }
@label=TestEntityCells_Swap
*$D8B2 LD A,H         ; {Turn the second component to face the other way.
 $D8B3 NEG            ;
 $D8B5 LD C,A         ;
 $D8B6 LD A,B         ;
 $D8B7 RRA            ;
 $D8B8 RRA            ;
 $D8B9 RRA            ; }
 $D8BA LD B,L         ; Keep the first component.
@label=TestEntityCells_Heading
*$D8BB RRCA           ; {Face the patched step away from the first component.
 $D8BC LD E,A         ;
 $D8BD XOR B          ;
 $D8BE RLA            ;
 $D8BF LD B,$FE       ;
 $D8C1 JR C,$D8C7     ; }
 $D8C3 LD A,B         ; {Face the other way when the signs differ.
 $D8C4 NEG            ;
 $D8C6 LD B,A         ; }
@label=TestEntityCells_Signs
*$D8C7 LD A,E         ; {Compare the signs of the two components.
 $D8C8 XOR C          ;
 $D8C9 RLA            ; }
 $D8CA JR NC,$D8D4    ; Keep the turn when the signs agree.
 $D8CC BIT 7,B        ; {A positive turn is #N$01.
 $D8CE LD B,$01       ;
 $D8D0 JR Z,$D8D4     ; }
 $D8D2 LD B,$FF       ; A negative turn is #N$FF.
@label=TestEntityCells_Apply
*$D8D4 LD A,(IX+$11)  ; Read the heading.
 $D8D7 LD C,A         ; Keep the old heading aside.
 $D8D8 ADD A,B        ; Add the turn to the heading.
 $D8D9 AND %00111111  ; Use the low six bits of the new heading.
 $D8DB LD B,A         ; Keep the new heading aside.
 $D8DC LD A,C         ; {Use bits 6-7 of the old heading.
 $D8DD AND $C0        ; }
 $D8DF OR B           ; {Combine them with the new heading.
 $D8E0 LD (IX+$11),A  ; }
 $D8E3 RET            ; Return.

; Test Group Objects
;
; Used by the routine at #R$D7E4.
; .
; Finds the group of objects at a cell of the level with #R$BA16 and then
; tests the entity against each of the objects, which are three bytes each.
; The low five bits of the group header are the number of objects. Objects of
; type #N$84, #N$86 and #N$06 are skipped. A solid block stops the entity.
; Type #N$81 is a bottle and is collected with #R$A3FE. Type #N$85 sets bit 1
; of #R$CE59, the exit-closed message, while #R$DEE0 is not zero. A type
; #N$83, and a type #N$85 once no bottles are left, is solid: the entity is
; pushed back to the edge and #R$D3A9 looks for a path there. Other objects are
; matched with #R$DC3F. The smaller gap is kept in field #N$1F and bit 6 of
; the flags is cleared. Purpose of that gap is not yet known.
;
; HL The position of the cell
; IX The entity
@label=TestGroupObjects
c$D8E4 LD ($5CB9),HL   ; Remember the cell position.
 $D8E7 CALL $BA16      ; Find the group of objects.
 $D8EA RET C           ; Return if this cell has no group.
 $D8EB LD ($5CDC),DE   ; Remember the cell offset.
 $D8EF INC D           ; Advance the high byte of the cell offset.
 $D8F0 LD A,(IY+$00)   ; Read the group header.
 $D8F3 AND %00011111   ; Keep the object count.
 $D8F5 LD B,A          ; Keep the object count aside.
 $D8F6 INC IY          ; {Step on to the first object.
 $D8F8 INC IY          ; }
 $D8FA AND %00010000   ; Test bit 4, which the count mask has already cleared.
 $D8FC JR Z,$D900      ; Skip the extra step. This jump is always taken.
 $D8FE INC IY          ; Step on another byte. This is not reached.
@label=TestGroupObjects_Loop
*$D900 INC IY          ; Advance to the type byte of the object.
 $D902 PUSH BC         ; Remember the object count.
 $D903 LD A,(IY+$01)   ; Read the type byte.
 $D906 AND %10001111   ; Keep the type bits.
 $D908 CP $84          ; {Skip an object of type #N$84.
 $D90A JP Z,$DC35      ; }
 $D90D CP $86          ; {Skip an object of type #N$86.
 $D90F JP Z,$DC35      ; }
 $D912 CP $06          ; {Skip an object of type #N$06.
 $D914 JP Z,$DC35      ; }
 $D917 RLA             ; Move bit 7 of the type into the carry flag.
 $D918 JR NC,$D921     ; Test the object when that bit is clear.
 $D91A AND %00011110   ; Keep the shifted type bits.
 $D91C CP $1E          ; {Skip an object whose shifted type is #N$1E.
 $D91E JP Z,$DC35      ; }
@label=TestGroupObjects_Player
*$D921 LD A,(IX+$00)   ; {On any other frame, or for any entity but the player, test the
 $D924 DEC A           ; block below.
 $D925 JP NZ,$D93C     ; }
 $D928 LD A,($A2DD)    ; Read the frame counter.
 $D92B AND %00000111   ; Act on every eighth frame.
 $D92D JP NZ,$D93C     ; Leave this path on the other frames.
 $D930 LD A,(IY+$01)   ; Read the type byte again.
 $D933 ADD A,$03       ; Add three to the type.
 $D935 AND %10000100   ; Use bits 2 and 7 of the adjusted type.
 $D937 CP $84          ; {Match the object when the result is #N$84.
 $D939 CALL Z,$DC3F    ; }
; Build the object's x range from its first and third bytes, then test
; it against the x coordinate. A type of #N$82 uses a fixed size of #N$08.
@label=TestGroupObjects_Block
*$D93C LD HL,($5CB8)   ; Fetch the word at #R$5CB8.
 $D93F LD A,(IY+$00)   ; Read the first byte of the object.
 $D942 AND %11110000   ; Keep the high nibble as the low byte of the range.
 $D944 LD L,A          ; Keep that nibble as the low byte of the range.
 $D945 LD A,(IY+$02)   ; Read the third byte of the object.
 $D948 ADD A,A         ; {Shift that byte up by four bits.
 $D949 ADD A,A         ;
 $D94A ADD A,A         ;
 $D94B ADD A,A         ; }
 $D94C AND %01110000   ; Use bits 4-6 as the size.
 $D94E ADD A,$10       ; Add the base size of #N$10.
 $D950 LD C,A          ; Keep the size.
 $D951 LD D,(IX+$02)   ; {Fetch the x coordinate.
 $D954 LD E,(IX+$03)   ; }
 $D957 LD A,(IY+$01)   ; Read the type byte.
 $D95A INC A           ; Advance the type.
 $D95B AND %10000110   ; Use bits 1, 2 and 7.
 $D95D CP $82          ; {Keep this size unless the type is #N$82.
 $D95F JR NZ,$D965     ; }
 $D961 SET 2,L         ; Mark the fixed-size object.
 $D963 LD C,$08        ; Use a size of #N$08.
@label=TestGroupObjects_XRange
*$D965 LD ($D6E7),DE   ; Pass the x coordinate to the overlap test.
 $D969 LD ($D6E4),HL   ; Pass the object's x range to the overlap test.
 $D96C LD B,(IX+$0B)   ; Fetch the x extent.
 $D96F CALL $DDF3      ; Test the two x ranges.
 $D972 JP NC,$DC35     ; Skip the object when the x ranges do not overlap.
 $D975 LD ($DDCF),HL   ; Remember the x overlap.
 $D978 INC IX          ; Point the entity one byte on, so the y fields line up.
; Build the object's y range in the same way, and test it against the
; y coordinate. #REGix still addresses the byte after the type, so a
; displacement reads the following field.
 $D97A LD HL,($5CB9)   ; Fetch the cell position again.
 $D97D LD A,(IY+$00)   ; Read the first byte of the object.
 $D980 ADD A,A         ; {Shift it up by four bits.
 $D981 ADD A,A         ;
 $D982 ADD A,A         ;
 $D983 ADD A,A         ; }
 $D984 LD L,A          ; Keep it as the low byte of the range.
 $D985 LD A,(IY+$02)   ; Read the third byte of the object.
 $D988 ADD A,A         ; Double it.
 $D989 AND %01110000   ; Use bits 4-6 as the size.
 $D98B ADD A,$10       ; Add the base size of #N$10.
 $D98D LD C,A          ; Keep the size.
 $D98E LD D,(IX+$04)   ; {Fetch the y coordinate.
 $D991 LD E,(IX+$05)   ; }
 $D994 LD B,(IX+$0B)   ; Fetch the y extent.
 $D997 LD A,(IY+$01)   ; Read the type byte.
 $D99A INC A           ; Advance the type.
 $D99B AND %10000110   ; Use bits 1, 2 and 7.
 $D99D CP $82          ; {Keep this size unless the type is #N$82.
 $D99F JR NZ,$D9A5     ; }
 $D9A1 SET 2,L         ; Mark the fixed-size object.
 $D9A3 LD C,$08        ; Use a size of #N$08.
@label=TestGroupObjects_YRange
*$D9A5 LD ($D6F8),DE   ; Pass the y coordinate to the overlap test.
 $D9A9 LD ($D6F5),HL   ; Pass the object's y range to the overlap test.
 $D9AC CALL $DDF3      ; Test the two y ranges.
 $D9AF DEC IX          ; Restore the entity address.
 $D9B1 JP NC,$DC35     ; Skip the object when the y ranges do not overlap.
 $D9B4 LD ($DDD1),HL   ; Remember the y overlap.
; Compare the z coordinate with the object, and remember the smaller gap
; in
; field #N$1F.
 $D9B7 LD H,(IX+$08)   ; {Fetch the z coordinate.
 $D9BA LD L,(IX+$09)   ; }
 $D9BD LD ($D6D6),HL   ; Pass the z coordinate to the edge test.
 $D9C0 LD A,(IY+$01)   ; Read the object's type.
 $D9C3 LD C,A          ; Keep the type aside.
 $D9C4 AND %00001111   ; Use the low nibble of the type.
 $D9C6 LD L,A          ; Keep it as the low byte of the index.
 $D9C7 LD A,C          ; {Bring bit 4 of the type down beside it.
 $D9C8 RRA             ;
 $D9C9 RRA             ;
 $D9CA RRA             ; }
 $D9CB AND %00010000   ; Use that bit.
 $D9CD OR L            ; {Combine it with the low nibble.
 $D9CE LD E,A          ; }
 $D9CF LD HL,$D7B3     ; {Look this kind up in the object flags.
 $D9D2 CALL $AA3C      ; }
 $D9D5 LD A,(HL)       ; Read the flag byte.
 $D9D6 LD ($5CD8),A    ; Remember the object's flags.
 $D9D9 LD HL,($5CDC)   ; Fetch the cell offset.
 $D9DC INC H           ; Advance its high byte.
 $D9DD LD A,C          ; Take the type again.
 $D9DE AND %01110000   ; Use bits 4-6 as a row within the group.
 $D9E0 ADD A,L         ; {Add that row to the cell offset.
 $D9E1 LD L,A          ; }
 $D9E2 LD ($D6CF),HL   ; Pass the address to the edge test.
@label=TestGroupObjects_Heights
 $D9E5 LD C,$00        ; Start with no extra height.
 $D9E7 LD A,E          ; {A kind of #N$02 has no extra height.
 $D9E8 CP $02          ;
 $D9EA JR Z,$DA0C      ; }
 $D9EC LD A,(IY+$02)   ; Read the third byte of the object.
 $D9EF RRA             ; {Shift it down by two.
 $D9F0 RRA             ; }
 $D9F1 AND %00110000   ; Use bits 4-5 of that byte.
 $D9F3 JR NZ,$DA09     ; Use the looked-up height when those bits are set.
 $D9F5 BIT 7,(IY+$01)  ; {Jump to #R$DA09 to use the looked-up height when the top bit is
 $D9F9 JR Z,$DA09      ; clear.}
 $D9FB PUSH HL         ; {Look up a height for this kind.
 $D9FC LD HL,$D7D4     ;
 $D9FF LD A,E          ; }
 $DA00 AND %00001111   ; Use the low nibble of the kind.
 $DA02 CALL $AA3C      ; Look the height up.
 $DA05 LD A,(HL)       ; Read the height.
 $DA06 POP HL          ; {Restore the address and use that height.
 $DA07 JR $DA0B        ; }
@label=TestGroupObjects_AddHeight
*$DA09 ADD A,$10       ; Add #N$10 to the height.
@label=TestGroupObjects_Height
*$DA0B LD C,A          ; Keep the height.
; The entity is only touching the block when half of either extent, less
; two, still covers the overlap. A deeper overlap on both axes means the
; entity is inside the block.
@label=TestGroupObjects_Overlap
*$DA0C LD A,$04        ; {Mark the entity as only touching the block.
 $DA0E LD ($DD4C),A    ; }
 $DA11 LD A,($DDCF)    ; Fetch the x overlap.
 $DA14 LD B,A          ; Keep it.
 $DA15 LD A,(IX+$0B)   ; {Compare half the x extent, less two, with the
 $DA18 SRL A           ; overlap.
 $DA1A SUB $02         ;
 $DA1C CP B            ;
 $DA1D JP NC,$DAA1     ; }
 $DA20 LD A,($DDD1)    ; {Compare half the y extent, less two, with the
 $DA23 LD B,A          ; overlap.
 $DA24 LD A,(IX+$0C)   ;
 $DA27 SRL A           ;
 $DA29 SUB $02         ;
 $DA2B CP B            ;
 $DA2C JP NC,$DAA1     ; }
 $DA2F XOR A           ; {The entity is inside the block, so clear the touching
 $DA30 LD ($DD4C),A    ; flag.}
 $DA33 PUSH HL         ; Remember the edge address.
 $DA34 LD A,($5CD8)    ; Read the object's flags.
 $DA37 RLA             ; {Compare the z coordinate directly when the top flag
 $DA38 JR C,$DA4F      ; is clear.}
 $DA3A LD B,$00        ; {Add the overlap to the edge address.
 $DA3C ADD HL,BC       ;
 $DA3D EX DE,HL        ; }
 $DA3E LD H,(IX+$08)   ; {Fetch the z coordinate.
 $DA41 LD L,(IX+$09)   ; }
 $DA44 XOR A           ; {Subtract the edge.
 $DA45 SBC HL,DE       ; }
 $DA47 JR C,$DAA0      ; Leave this object if the entity is below the edge.
 $DA49 OR H            ; {Leave this object unless the result is within one
 $DA4A JR NZ,$DAA0     ; page.}
 $DA4C LD E,L          ; {The low byte is the gap.
 $DA4D JR $DA93        ; }
@label=TestGroupObjects_Raised
*$DA4F EX DE,HL        ; {Compare the z coordinate with the z extent instead.
 $DA50 LD H,(IX+$08)   ;
 $DA53 LD L,(IX+$09)   ;
 $DA56 PUSH BC         ;
 $DA57 LD B,$00        ;
 $DA59 LD A,(IX+$0D)   ;
 $DA5C ADD A,$06       ;
 $DA5E LD C,A          ;
 $DA5F ADD HL,BC       ;
 $DA60 SBC HL,DE       ;
 $DA62 POP BC          ;
 $DA63 JR C,$DAA0      ; }
 $DA65 CALL $D682      ; Test a wide block.
 $DA68 LD A,($5CD8)    ; Read the object's flags.
 $DA6B AND %01100000   ; Use the layout in bits 5-6.
 $DA6D JR Z,$DA73      ; No further height test when the layout is clear.
 $DA6F CP $40          ; {A layout of #N$40 ends the height test.
 $DA71 JR NZ,$DA93     ; }
@label=TestGroupObjects_Gap
*$DA73 LD A,E          ; {Reduce the gap by four, and ignore a gap below four.
 $DA74 SUB $04         ;
 $DA76 LD E,$00        ;
 $DA78 JR C,$DA93      ; }
 $DA7A LD E,A          ; Keep the reduced gap.
 $DA7B POP HL          ; {Keep the smaller of the gap and the room above the
 $DA7C PUSH HL         ; entity.
 $DA7D PUSH DE         ;
 $DA7E LD B,$00        ;
 $DA80 ADD HL,BC       ;
 $DA81 EX DE,HL        ;
 $DA82 XOR A           ;
 $DA83 LD H,(IX+$08)   ;
 $DA86 LD L,(IX+$09)   ;
 $DA89 SBC HL,DE       ;
 $DA8B POP DE          ;
 $DA8C JR C,$DA93      ;
 $DA8E LD A,L          ;
 $DA8F CP E            ;
 $DA90 JR C,$DA93      ;
 $DA92 LD E,L          ; }
@label=TestGroupObjects_SaveGap
*$DA93 LD A,(IX+$1F)   ; Fetch the gap already stored for this entity.
 $DA96 CP E            ; {Keep the stored gap when it is the smaller one.
 $DA97 JR C,$DAA0      ; }
 $DA99 LD (IX+$1F),E   ; Remember this smaller gap.
 $DA9C RES 6,(IX+$1E)  ; Clear bit 6 of the flags.
; Test the z range. The vertical speed is put back afterwards, and a
; stand-in value of #N$18 is used for the test.
@label=TestGroupObjects_Vertical
*$DAA0 POP HL          ; Restore the edge address.
@label=TestGroupObjects_ZRange
*$DAA1 LD B,(IX+$12)   ; Fetch the vertical speed.
 $DAA4 PUSH BC         ; Remember it.
 $DAA5 LD B,(IX+$0D)   ; Fetch the z extent.
 $DAA8 PUSH IX         ; Remember the entity.
 $DAAA LD DE,$FFFA     ; {Move back to the byte the test reads.
 $DAAD ADD IX,DE       ; }
 $DAAF LD (IX+$18),$00 ; Plant #N$18 for the test.
 $DAB3 LD DE,($D6D6)   ; Fetch the z coordinate passed to the test.
 $DAB7 CALL $DDF3      ; Test the z range.
 $DABA POP IX          ; Restore the entity.
 $DABC POP BC          ; Bring the vertical speed back.
 $DABD LD (IX+$12),B   ; Restore the vertical speed.
 $DAC0 JP NC,$DC35     ; Leave this object when the z ranges do not overlap.
 $DAC3 BIT 7,(IX+$1E)  ; Test whether the entity is moving fast.
 $DAC7 JR Z,$DAD1      ; The overlap is ordinary when the entity is not fast.
 $DAC9 BIT 7,H         ; Test the sign of the result.
 $DACB JR NZ,$DAD7     ; A negative result keeps the low byte.
 $DACD LD L,$FF        ; Force the low byte to #N$FF.
 $DACF JR $DAD7        ; Join the stored overlap.
@label=TestGroupObjects_Positive
*$DAD1 BIT 7,H         ; Test the sign of the result.
 $DAD3 JR NZ,$DAD7     ; A negative result is stored as it is.
 $DAD5 INC L           ; {Raise a positive overlap by two.
 $DAD6 INC L           ; }
@label=TestGroupObjects_ZOverlap
*$DAD7 DEC L           ; Reduce the overlap by one.
 $DAD8 LD ($DDD3),HL   ; Remember the z overlap.
 $DADB LD A,(IY+$01)   ; Read the object's type.
 $DADE AND %10001111   ; Use the type bits that select a solid block.
 $DAE0 CP $83          ; {A type #N$83 is solid.
 $DAE2 JP Z,$DB68      ; }
 $DAE5 CP $85          ; {A type other than #N$85 is handled below.
 $DAE7 JR NZ,$DAF0     ; }
 $DAE9 LD A,($DEE0)    ; Read how many bottles are left.
 $DAEC AND A           ; {A type #N$85 is solid once no bottles are left.
 $DAED JP Z,$DB68      ; }
@label=TestGroupObjects_Handle
*$DAF0 LD A,($5CD8)    ; Read the object's flags.
 $DAF3 RLA             ; {Test the edge when the top flag is set.
 $DAF4 CALL C,$D6CE    ; }
 $DAF7 XOR A           ; {Clear the handled flag.
 $DAF8 LD ($D5A4),A    ; }
 $DAFB LD A,($5CD8)    ; Read the flags again.
 $DAFE INC A           ; {Handle the overlap unless the flags were #N$FF.
 $DAFF CALL NZ,$DC6A   ; }
 $DB02 LD A,(IX+$00)   ; {Only the player is placed against the block.
 $DB05 DEC A           ;
 $DB06 JP NZ,$DBEF     ; }
 $DB09 LD A,($A2DD)    ; Read the frame counter.
 $DB0C AND $07         ; {Only on every eighth frame.
 $DB0E JP NZ,$DBEF     ; }
 $DB11 LD A,(IY+$01)   ; Read the object's type.
 $DB14 AND %10001110   ; Use bits 1, 2, 3 and 7 of the type.
 $DB16 CP $02          ; {Only a type whose remaining bits are #N$02 places the
 $DB18 JP NZ,$DBEF     ; player.}
 $DB1B LD A,($D5A4)    ; Read the handled flag.
 $DB1E AND A           ; {Leave the placement when the flag is clear.
 $DB1F JP Z,$DBEF      ; }
 $DB22 LD A,(IX+$1F)   ; Read the stored gap.
 $DB25 AND A           ; {Leave the placement when a gap is already stored.
 $DB26 JP NZ,$DBEF     ; }
 $DB29 LD DE,($D6E7)   ; Fetch the x edge passed to the overlap test.
 $DB2D DEC DE          ; {Step that edge back by two.
 $DB2E DEC DE          ; }
 $DB2F LD HL,($D6E4)   ; Fetch the other x edge.
 $DB32 AND A           ; {Keep the first edge when it is the nearer.
 $DB33 SBC HL,DE       ;
 $DB35 JR C,$DB3B      ; }
 $DB37 LD DE,($D6E4)   ; Otherwise use the other edge.
@label=TestGroupObjects_XEdge
*$DB3B LD A,E          ; {Keep the column of that edge.
 $DB3C AND $F0         ;
 $DB3E LD E,A          ; }
 $DB3F LD ($E4C6),DE   ; Remember it as the position to match.
 $DB43 LD DE,($D6F8)   ; Fetch the y edge passed to the overlap test.
 $DB47 DEC DE          ; {Step that edge back by two.
 $DB48 DEC DE          ; }
 $DB49 LD HL,($D6F5)   ; Fetch the other y edge.
 $DB4C AND A           ; {Keep the first edge when it is the nearer.
 $DB4D SBC HL,DE       ;
 $DB4F JR C,$DB55      ; }
 $DB51 LD DE,($D6F5)   ; Otherwise use the other edge.
@label=TestGroupObjects_YEdge
*$DB55 LD A,E          ; {Keep the column of that edge.
 $DB56 AND $F0         ;
 $DB58 LD E,A          ; }
 $DB59 LD ($E4C8),DE   ; Remember it as the other position to match.
 $DB5D LD DE,($B548)   ; {Remember the player's height for the match.
 $DB61 LD ($E4CA),DE   ; }
 $DB65 JP $DBEF        ; Go on to the bottle and the exit.
; A solid block matches the object, raises the entity by one, and pushes
; it back to the edge. If it is still inside, the position is set from both
; edges and #R$D3A9 looks for a path there.
@label=TestGroupObjects_Solid
*$DB68 CALL $DC3F      ; Match the object.
 $DB6B LD H,(IX+$08)   ; {Fetch the z coordinate.
 $DB6E LD L,(IX+$09)   ; }
 $DB71 INC HL          ; {Raise the entity by one.
 $DB72 LD (IX+$08),H   ;
 $DB75 LD (IX+$09),L   ; }
 $DB78 LD A,($DD4C)    ; Read the touching flag.
 $DB7B AND A           ; {Leave this object when the entity was only touching.
 $DB7C JR NZ,$DBEF     ; }
 $DB7E LD DE,($D6E4)   ; Fetch an x edge.
 $DB82 INC E           ; {Step that edge on by three.
 $DB83 INC E           ;
 $DB84 INC E           ; }
 $DB85 LD HL,($D6E7)   ; Fetch the other x edge.
 $DB88 PUSH HL         ; {Turn that edge into a coordinate.
 $DB89 POP BC          ; }
 $DB8A AND A           ; {Subtract the stepped edge.
 $DB8B SBC HL,DE       ; }
 $DB8D BIT 7,H         ; {Jump to #R$DB9F to push the entity the other way when the
 $DB8F JR NZ,$DB9F     ; difference is negative.}
 $DB91 DEC BC          ; Step the edge back.
 $DB92 LD (IX+$02),B   ; {Move the x coordinate back to that edge.
 $DB95 LD (IX+$03),C   ; }
 $DB98 LD BC,$0005     ; {Step the difference back by five.
 $DB9B SBC HL,BC       ;
 $DB9D JR $DBAA        ; }
@label=TestGroupObjects_PushX
*$DB9F INC BC          ; Step the edge on.
 $DBA0 LD (IX+$02),B   ; {Move the x coordinate on to that edge.
 $DBA3 LD (IX+$03),C   ; }
 $DBA6 LD BC,$0004     ; {Step the difference on by four.
 $DBA9 ADD HL,BC       ; }
@label=TestGroupObjects_TryY
*$DBAA JR NC,$DBEF     ; Leave this object when the x push was enough.
 $DBAC PUSH DE         ; Remember the y edge.
 $DBAD LD DE,($D6F5)   ; Fetch a y edge.
 $DBB1 INC E           ; {Step that edge on by three.
 $DBB2 INC E           ;
 $DBB3 INC E           ; }
 $DBB4 LD HL,($D6F8)   ; Fetch the other y edge.
 $DBB7 PUSH HL         ; {Turn that edge into a coordinate.
 $DBB8 POP BC          ; }
 $DBB9 AND A           ; {Subtract the stepped edge.
 $DBBA SBC HL,DE       ; }
 $DBBC BIT 7,H         ; {Jump to #R$DBCE to push the entity the other way when the
 $DBBE JR NZ,$DBCE     ; difference is negative.}
 $DBC0 DEC BC          ; Step the edge back.
 $DBC1 LD (IX+$05),B   ; {Move the y coordinate back to that edge.
 $DBC4 LD (IX+$06),C   ; }
 $DBC7 LD BC,$0005     ; {Step the difference back by five.
 $DBCA SBC HL,BC       ;
 $DBCC JR $DBD9        ; }
@label=TestGroupObjects_PushY
*$DBCE INC BC          ; Step the edge on.
 $DBCF LD (IX+$05),B   ; {Move the y coordinate on to that edge.
 $DBD2 LD (IX+$06),C   ; }
 $DBD5 LD BC,$0004     ; {Step the difference on by four.
 $DBD8 ADD HL,BC       ; }
@label=TestGroupObjects_Place
*$DBD9 POP BC          ; Restore the saved edge.
 $DBDA JR NC,$DBEF     ; Leave this object when the y push was enough.
 $DBDC LD (IX+$02),B   ; {Place the entity on both saved edges.
 $DBDF LD (IX+$03),C   ;
 $DBE2 LD (IX+$05),D   ;
 $DBE5 LD (IX+$06),E   ; }
 $DBE8 PUSH IY         ; Remember the object.
 $DBEA CALL $D3A9      ; Find the path at this position.
 $DBED POP IY          ; Restore the object.
; A type #N$85 object shows the exit-closed message for the player while
; bottles remain. A type #N$81 object is a bottle.
@label=TestGroupObjects_Special
*$DBEF LD A,(IY+$01)   ; Read the type byte.
 $DBF2 AND %10001111   ; Keep the type bits.
 $DBF4 CP $85          ; {Try a bottle unless the type is #N$85.
 $DBF6 JR NZ,$DC10     ; }
 $DBF8 LD A,($DEE0)    ; Read how many bottles are left.
 $DBFB AND A           ; {Leave the message alone when no bottles are left.
 $DBFC JR Z,$DC35      ; }
 $DBFE LD A,(IX+$00)   ; {Show the message for the player only.
 $DC01 DEC A           ;
 $DC02 JP NZ,$DC35     ; }
 $DC05 LD A,($CE59)    ; Read the exit message flag.
 $DC08 OR %00000010    ; Set the exit-closed bit.
 $DC0A LD ($CE59),A    ; Update the exit message flag.
 $DC0D JP $DC35        ; Go on to the next object.
@label=TestGroupObjects_Bottle
*$DC10 CP $81          ; {Leave any object that is not a bottle.
 $DC12 JR NZ,$DC35     ; }
 $DC14 LD A,(IX+$00)   ; {Collect a bottle for the player only.
 $DC17 DEC A           ;
 $DC18 JR NZ,$DC35     ; }
 $DC1A LD A,($DD4C)    ; {Leave the bottle if the flag at #R$DC6A(#N$DD4C) is
 $DC1D AND A           ; clear.
 $DC1E JR NZ,$DC35     ; }
 $DC20 LD A,($D5A4)    ; {Leave the bottle if the flag at #R$D47A(#N$D5A4) is
 $DC23 AND A           ; set.
 $DC24 JR Z,$DC35      ; }
 $DC26 PUSH IX         ; {Collect the bottle, keeping the entity and the
 $DC28 PUSH IY         ; object.
 $DC2A PUSH IY         ;
 $DC2C POP IX          ;
 $DC2E CALL $A3FE      ;
 $DC31 POP IY          ;
 $DC33 POP IX          ; }
@label=TestGroupObjects_Next
*$DC35 INC IY          ; {Advance to the next object.
 $DC37 INC IY          ; }
 $DC39 POP BC          ; Restore the object count.
 $DC3A DEC B           ; {Take the next object until every object has been
 $DC3B JP NZ,$D900     ; tested.}
 $DC3E RET             ; Return.

; Test Object Match
;
; Used by the routine at #R$D8E4.
; .
; Tests whether an object is at the position that is stored at #R$E4C6 and
; #R$E4C6(#N$E4C8), and if it is then clears the flag at #R$E4C6(#N$E4C7).
;
; IY The object
@label=TestObjectMatch
c$DC3F LD HL,($5CB8) ; {The high nibble of the object's first byte, beside the word at
 $DC42 LD A,(IY+$00) ; #R$5CB8.
 $DC45 AND $F0       ;
 $DC47 LD L,A        ; }
 $DC48 LD DE,($E4C6) ; {It matches the stored position at #R$E4C6.
 $DC4C AND A         ;
 $DC4D SBC HL,DE     ;
 $DC4F JR NZ,$DC69   ; }
 $DC51 LD HL,($5CB9) ; {The same byte shifted up by four, beside the cell
 $DC54 LD A,(IY+$00) ; position.
 $DC57 ADD A,A       ;
 $DC58 ADD A,A       ;
 $DC59 ADD A,A       ;
 $DC5A ADD A,A       ;
 $DC5B LD L,A        ; }
 $DC5C LD DE,($E4C8) ; {It matches the stored position at #R$E4C6(#N$E4C8).
 $DC60 AND A         ;
 $DC61 SBC HL,DE     ;
 $DC63 JR NZ,$DC69   ; }
 $DC65 XOR A         ; {Clear the flag at #R$E4C6(#N$E4C7).
 $DC66 LD ($E4C7),A  ; }
@label=TestObjectMatch_Skip
*$DC69 RET           ; Return.

; Handle Overlap
;
; Used by the routine at #R$D8E4.
; .
; Moves an entity off the overlap whose axis is the smallest of the three
; held at #R$DDCF. The x axis is handled by #R$DD61 and the y axis by #R$DD93.
; On z, a player under a flagged block changes frame, the difference is planted
; for #R$D7E4, and the vertical speed pushes the entity clear. A saucer sets
; the high byte of its vertical speed to #N$02 first.
;
; IX The entity
; IY The other entity or object
;
; The smallest overlap chooses the axis. A saucer is pushed up before
; the choice is made.
@label=HandleOverlap
c$DC6A LD A,(IX+$00)   ; {A saucer sets its vertical speed.
 $DC6D CP $09          ;
 $DC6F JR NZ,$DC75     ; }
 $DC71 LD (IX+$12),$02 ; Set the high byte of the vertical speed to #N$02.
; This entry point is used by the routine at #R$D47A.
@label=HandleOverlap_Compare
*$DC75 LD A,($DDCF)    ; {Read the x overlap.
 $DC78 LD B,A          ; }
 $DC79 LD A,($DDD1)    ; {Compare it with the y overlap.
 $DC7C CP B            ; }
 $DC7D JP NC,$DD61     ; Handle x when it is the smaller overlap.
 $DC80 LD B,A          ; Keep the y overlap.
 $DC81 LD A,($DDD3)    ; {Compare it with the z overlap.
 $DC84 CP B            ; }
 $DC85 JP NC,$DD93     ; Handle y when it is the smaller overlap.
; This entry point is used by the routine at #R$DD61.
; .
; The z overlap is the smallest. A player whose block has the top flag
; set takes frame #N$02, and the sides of the block choose the push.
@label=HandleOverlap_Vertical
*$DC88 LD A,(IX+$00)   ; {Remember the type.
 $DC8B LD ($D5A4),A    ; }
 $DC8E DEC A           ; {Only the player changes frame.
 $DC8F JR NZ,$DCA4     ; }
 $DC91 LD A,($5CD8)    ; Read the object's flags.
 $DC94 RLA             ; {Change the frame when the top flag is set.
 $DC95 JR NC,$DCA4     ; }
 $DC97 LD A,(IX+$01)   ; {Use the top three bits of the frame.
 $DC9A AND $E0         ; }
 $DC9C OR %00000010    ; Set the frame number to #N$02.
 $DC9E LD (IX+$01),A   ; Keep that frame.
 $DCA1 CALL $AF21      ; Measure the sprite.
@label=HandleOverlap_Frame
*$DCA4 BIT 5,(IX+$01)  ; {Move straight on when bit 5 of the frame is set.
 $DCA8 JP NZ,$DD0C     ; }
 $DCAB LD D,(IX+$02)   ; {Fetch the x coordinate.
 $DCAE LD E,(IX+$03)   ; }
 $DCB1 LD HL,($D6E4)   ; Fetch the near x edge.
 $DCB4 XOR A           ; {Subtract the entity's x from the edge.
 $DCB5 INC A           ;
 $DCB6 SBC HL,DE       ; }
 $DCB8 JR Z,$DCBC      ; The entity is on the edge.
 $DCBA JR NC,$DCF5     ; Push back when the entity is past the edge.
@label=HandleOverlap_SizeX
*$DCBC LD A,(IY+$02)   ; {Scale the object's byte up to a size along x.
 $DCBF ADD A,A         ;
 $DCC0 ADD A,A         ;
 $DCC1 ADD A,A         ;
 $DCC2 ADD A,A         ; }
 $DCC3 AND %01110000   ; Use bits 4-6 of that byte.
 $DCC5 ADD A,$10       ; {Add #N$10 to make the size.
 $DCC7 LD C,A          ;
 $DCC8 LD B,$00        ; }
 $DCCA ADD HL,BC       ; Add the size to the difference.
 $DCCB LD A,L          ; {The push stays small when x is still inside the
 $DCCC CP (IX+$0B)     ; extent.}
 $DCCF LD A,$02        ; The small push is #N$02.
 $DCD1 JR C,$DCF5      ; Double the push and test y when x is clear.
 $DCD3 ADD A,A         ; Double the push.
 $DCD4 LD D,(IX+$05)   ; {Fetch the y coordinate.
 $DCD7 LD E,(IX+$06)   ; }
 $DCDA LD HL,($D6F5)   ; {Subtract the entity's y from the near edge.
 $DCDD SBC HL,DE       ; }
 $DCDF JR Z,$DCE3      ; The entity is on the edge.
 $DCE1 JR NC,$DCF5     ; Push back when the entity is past the edge.
@label=HandleOverlap_SizeY
*$DCE3 LD A,(IY+$02)   ; Read the object's byte.
 $DCE6 ADD A,A         ; Double that byte.
 $DCE7 AND %01110000   ; Use bits 4-6.
 $DCE9 ADD A,$10       ; {Add #N$10 to make the size.
 $DCEB LD C,A          ; }
 $DCEC ADD HL,BC       ; Add the size to the difference.
 $DCED LD A,L          ; {The push stays #N$08 when y is still inside the
 $DCEE CP (IX+$0C)     ; extent.}
 $DCF1 LD A,$08        ; The push is #N$08.
 $DCF3 JR NC,$DD0C     ; Move the entity when y is clear.
@label=HandleOverlap_Push
*$DCF5 LD B,A          ; Keep the push.
 $DCF6 LD A,L          ; Read the low byte of the difference.
 $DCF7 BIT 7,A         ; {Jump to #R$DCFD to keep a negative difference.
 $DCF9 JR NZ,$DCFD     ; }
 $DCFB NEG             ; Force the difference negative.
@label=HandleOverlap_Step
*$DCFD LD ($D8C0),A    ; Give that step to the turn.
 $DD00 LD A,($D83D)    ; Read the hit already planted.
 $DD03 AND A           ; {A second hit becomes #N$FF.
 $DD04 JR Z,$DD08      ; }
 $DD06 LD B,$FF        ; A second hit is #N$FF.
@label=HandleOverlap_Hit
*$DD08 LD A,B          ; {Plant the hit for #R$D7E4.
 $DD09 LD ($D83D),A    ; }
; A positive z overlap clears the vertical speed. A negative one sets
; it, and a saucer is left alone. The byte at #R$DC6A(#N$DD4C) is patched by
; #R$D8E4: zero clears the low byte of the speed, and #N$04 skips that clear.
@label=HandleOverlap_Move
*$DD0C LD HL,($DDD3)   ; Fetch the z overlap.
 $DD0F PUSH IX         ; Remember the entity.
 $DD11 LD DE,$0006     ; {Move on to the vertical speed.
 $DD14 ADD IX,DE       ; }
 $DD16 XOR A           ; {Clear the fraction of x.
 $DD17 LD (IX+$04),A   ; }
 $DD1A BIT 7,H         ; {A negative overlap pushes the entity up.
 $DD1C JR NZ,$DD29     ; }
 $DD1E LD (IX+$0C),A   ; {Clear the vertical speed.
 $DD21 LD (IX+$0D),A   ; }
 $DD24 CALL $DDD5      ; Move the entity back.
 $DD27 JR $DD51        ; Join the restore.
*$DD29 LD A,(IX-$06)   ; {A saucer is not pushed up.
 $DD2C CP $09          ;
 $DD2E JR Z,$DD40      ; }
 $DD30 LD A,($5CD8)    ; Read the object's flags.
 $DD33 RLA             ; {The push is #N$FD when the top flag is set.
 $DD34 LD A,$FD        ;
 $DD36 JR C,$DD3A      ; }
 $DD38 INC A           ; {Otherwise the push is #N$FF.
 $DD39 INC A           ; }
*$DD3A LD (IX+$0C),A   ; {Use that as the vertical speed.
 $DD3D LD (IX+$0D),A   ; }
*$DD40 SET 7,(IX+$18)  ; {Set bit 7 of the vertical speed and clear bit 6.
 $DD44 RES 6,(IX+$18)  ; }
 $DD48 CALL $DDD5      ; Move the entity back.
*$DD4B JR $DD4B        ; Clear the low byte of the speed when the entity is
                       ; inside.
 $DD4D LD (IX+$19),$00 ; Clear the low byte of the vertical speed.
*$DD51 POP IX          ; Restore the entity.
 $DD53 LD A,(IX+$08)   ; {Snap z up when its top byte is zero.
 $DD56 AND A           ;
 $DD57 RET NZ          ; }
 $DD58 LD (IX+$08),$01 ; Set the top of z to one.
 $DD5C LD (IX+$09),$00 ; Clear the middle byte of z.
 $DD60 RET             ; Return.

; Handle Overlap First
;
; Used by the routine at #R$DC6A.
; .
; Moves the entity clear of the overlap in the first direction. Entities
; of type #N$05 are changed to type #N$0D.
;
; IX The entity
@label=HandleOverlapFirst
c$DD61 LD A,($DDD3)    ; {The z overlap is smaller, so this axis is left alone.
 $DD64 CP B            ;
 $DD65 JP C,$DC88      ; }
 $DD68 LD A,(IX+$00)   ; {A puff becomes a sparkle.
 $DD6B SUB $05         ;
 $DD6D JR NZ,$DD7E     ; }
 $DD6F LD (IX+$23),$04 ; {The sparkle's countdown is #N$04, its frame is #N$00, its type is
 $DD73 LD (IX+$01),A   ; #N$0D
 $DD76 LD (IX+$00),$0D ; and its height is #N$08.
 $DD7A LD (IX+$17),$08 ; }
@label=HandleOverlapFirst_Shot
*$DD7E LD A,(IX+$00)   ; {When the type is a shot.
 $DD81 AND $1F         ;
 $DD83 CP $0E          ;
 $DD85 JR NZ,$DD8B     ; }
 $DD87 SET 7,(IX+$16)  ; Set bit 7 of the width byte.
@label=HandleOverlapFirst_Move
*$DD8B LD HL,($DDCF)   ; {Move back by the x overlap and finish.
 $DD8E CALL $DDD5      ;
 $DD91 JR $DDC6        ; }

; Handle Overlap Second
;
; Used by the routine at #R$DC6A.
; .
; Moves the entity clear of the overlap in the second direction. Entities
; of type #N$05 are changed to type #N$0D.
;
; IX The entity
@label=HandleOverlapSecond
c$DD93 LD A,(IX+$00)   ; {A puff becomes a sparkle.
 $DD96 SUB $05         ;
 $DD98 JR NZ,$DDA9     ; }
 $DD9A LD (IX+$23),$04 ; {The sparkle's countdown is #N$04, its frame is #N$00, its type is
 $DD9E LD (IX+$01),A   ; #N$0D
 $DDA1 LD (IX+$00),$0D ; and its height is #N$08.
 $DDA5 LD (IX+$17),$08 ; }
@label=HandleOverlapSecond_Shot
*$DDA9 LD A,(IX+$00)   ; {When the type is a shot.
 $DDAC AND $1F         ;
 $DDAE CP $0E          ;
 $DDB0 JR NZ,$DDB6     ; }
 $DDB2 SET 7,(IX+$16)  ; Set bit 7 of the width byte.
@label=HandleOverlapSecond_Move
*$DDB6 PUSH IX         ; {Move the y coordinate back by the y overlap.
 $DDB8 INC IX          ;
 $DDBA INC IX          ;
 $DDBC INC IX          ;
 $DDBE LD HL,($DDD1)   ;
 $DDC1 CALL $DDD5      ;
 $DDC4 POP IX          ; }
; This entry point is used by the routine at #R$DD61.
@label=HandleOverlapSecond_Clear
*$DDC6 LD A,(IX+$1E)   ; {Leave bits 6 and 7 of the flags.
 $DDC9 AND $C0         ;
 $DDCB LD (IX+$1E),A   ; }
 $DDCE RET             ; Return.

; Overlap Distances
;
; The overlap in the first, second and third directions, as found by
; #R$D47A. Each is a word.
@label=OverlapDistances
g$DDCF DEFW $0000
 $DDD1 DEFW $0000
 $DDD3 DEFW $0000

; Move Entity Back
;
; Used by the routines at #R$DC6A, #R$DD61 and #R$DD93.
; .
; Moves an entity back along one of its coordinates by an amount.
;
; HL The amount, with the direction in bit 7 of #REGh
; IX The entity, with the coordinate in fields #N$02 and #N$03
@label=MoveEntityBack
c$DDD5 LD D,(IX+$02)   ; Fetch the high byte of the x coordinate into #REGd.
 $DDD8 LD E,(IX+$03)   ; Fetch the low byte of the x coordinate into #REGe.
 $DDDB RL H            ; Rotate #REGh left through the carry flag.
 $DDDD LD H,$00        ; #REGh is #N$00.
 $DDDF JR NC,$DDE4     ; Jump to #R$DDD5(#N$DDE4) if the carry flag is reset.
 $DDE1 ADD HL,DE       ; #REGhl takes #REGde.
 $DDE2 JR $DDEC        ; Jump to #R$DDD5(#N$DDEC).
@label=MoveEntityBack_Skip
*$DDE4 DEC L           ; Step #REGl back.
 $DDE5 LD (IX+$04),$FF ; Set field #N$04 of the entity to #N$FF.
 $DDE9 EX DE,HL        ; Exchange #REGde and #REGhl.
 $DDEA SBC HL,DE       ; Subtract #REGde from #REGhl. (with the carry)
@label=MoveEntityBack_Skip2
*$DDEC LD (IX+$02),H   ; Set the high byte of the x coordinate.
 $DDEF LD (IX+$03),L   ; Set the low byte of the x coordinate.
 $DDF2 RET             ; Return.

; Test Range Overlap
;
; Used by the routine at #R$D8E4.
; .
; Tests whether a range overlaps another, taking into account whether the
; entity is on the ground. Purpose of the individual steps is not yet known.
;
;   HL The start of the first range
;   DE The start of the second range
;   B The size of the range
; O:F The carry flag is set if the ranges overlap
@label=TestRangeOverlap
c$DDF3 XOR A          ; Set #REGa to zero.
 $DDF4 SBC HL,DE      ; Subtract #REGde from #REGhl. (with the carry)
 $DDF6 JR C,$DE11     ; Jump to #R$DE11 if the carry flag is set.
 $DDF8 OR H           ; Combine #REGa with #REGh.
 $DDF9 RET NZ         ; Return if the zero flag is reset.
 $DDFA LD A,L         ; #REGl moves into #REGa.
 $DDFB SUB B          ; Subtract #REGb.
 $DDFC RET NC         ; Return if the carry flag is reset.
 $DDFD ADD HL,DE      ; #REGhl takes #REGde.
 $DDFE BIT 7,(IX+$18) ; {Jump to #R$DE21 if the zero flag is set.
 $DE02 JR Z,$DE21     ; }
@label=TestRangeOverlap_Loop
*$DE04 LD B,$00       ; #REGb is #N$00.
 $DE06 ADD HL,BC      ; #REGhl takes #REGbc.
 $DE07 SBC HL,DE      ; Subtract #REGde from #REGhl. (with the carry)
@label=TestRangeOverlap_Loop2
*$DE09 LD H,(IX+$18)  ; Read field #N$18 of the entity into #REGh.
 $DE0C INC L          ; Advance #REGl.
 $DE0D SCF            ; Set the carry flag.
 $DE0E RET            ; Return.
; This entry point is used by the routine at #R$D647.
@label=TestRangeOverlap_Reset
*$DE0F AND A          ; See whether #REGa is zero.
 $DE10 RET            ; Return.
@label=TestRangeOverlap_Second
*$DE11 LD A,B         ; #REGb moves into #REGa.
 $DE12 LD B,$00       ; #REGb is #N$00.
 $DE14 ADD HL,BC      ; #REGhl takes #REGbc.
 $DE15 RET NC         ; Return if the carry flag is reset.
 $DE16 BIT 7,(IX+$18) ; {Jump to #R$DDF3(#N$DE09) if the zero flag is reset.
 $DE1A JR NZ,$DE09    ; }
 $DE1C AND A          ; See whether #REGa is zero.
 $DE1D SBC HL,BC      ; Subtract #REGbc from #REGhl. (with the carry)
 $DE1F LD B,A         ; #REGa moves into #REGb.
 $DE20 ADD HL,DE      ; #REGhl takes #REGde.
@label=TestRangeOverlap_Swap
*$DE21 EX DE,HL       ; Exchange #REGde and #REGhl.
 $DE22 LD C,B         ; #REGb moves into #REGc.
 $DE23 JR $DE04       ; Jump to #R$DDF3(#N$DE04).

; Reset Entities
;
; Used by the routine at #R$DFF0.
; .
; Clears the entities other than the player, and marks every extra record
; free. The player is copied from the template at #R$DE77 and the jump counter
; is cleared. If #R$DEFC is set, the player's animation low nibble and the
; control byte are set to #N$05. #R$AF21 then measures the sprite.
@label=ResetEntities
c$DE25 LD IX,$B566     ; Start at the first entity after the player.
 $DE29 LD B,$0B        ; There are #N$0B entities besides the player.
 $DE2B LD DE,$0026     ; Each entity is #N$26 bytes.
@label=ResetEntities_Pool
*$DE2E LD (IX+$00),$00 ; Free the entity.
 $DE32 SET 7,(IX+$01)  ; Hide the entity.
 $DE36 ADD IX,DE       ; Move on to the next entity.
 $DE38 DJNZ $DE2E      ; Repeat for the remaining entities.
 $DE3A LD IX,$B708     ; Start at the first extra record.
 $DE3E LD B,$0C        ; There are #N$0C extra records.
 $DE40 LD DE,$000D     ; Each record is #N$0D bytes.
@label=ResetEntities_Records
*$DE43 LD (IX+$09),$00 ; Mark the extra record as free.
 $DE47 ADD IX,DE       ; Move on to the next record.
 $DE49 DJNZ $DE43      ; Repeat for the remaining records.
 $DE4B LD DE,$B540     ; The player is the destination.
 $DE4E LD BC,$0026     ; The template is #N$26 bytes.
 $DE51 LD HL,$DE77     ; The template is the source.
 $DE54 LDIR            ; Copy the template over the player.
 $DE56 XOR A           ; {Clear the jump counter.
 $DE57 LD ($5D00),A    ; }
@label=ResetEntities_Player
 $DE5A LD IX,$B540     ; Use the player.
 $DE5E LD A,($DEFC)    ; Read the bottle flag.
 $DE61 AND A           ; {Measure the sprite when the flag is clear.
 $DE62 JP Z,$AF21      ; }
 $DE65 LD A,($B55C)    ; Read the player's animation counter.
 $DE68 AND %11110000   ; Use the high nibble of the animation.
 $DE6A OR %00000101    ; Set the low nibble to #N$05.
 $DE6C LD ($B55C),A    ; Keep that animation.
 $DE6F LD A,$05        ; {Set the control byte to #N$05.
 $DE71 LD ($AB7D),A    ; }
 $DE74 JP $AF21        ; Measure the sprite.

; Player Template
;
; The initial values for the player entity, which is copied to #R$B540.
@label=PlayerTemplate
b$DE77 DEFB $01,$20,$20,$70,$00,$20,$70,$00,$01,$00,$00,$0C,$0C,$05,$00,$00,$30,$00,$00,$00,$FF,$B0,$03,$0E,$00,$00,$00,$40,$04,$10,$00,$00,$00,$00,$00,$00,$00,$00

; Show Player Number
;
; Used by the routines at #R$A30D and #R$DFF0.
; .
; Clears the screen and prints the number of the player, which is the text
; at #R$DEC4, and if the player has no lives left plays the tune at #R$DFD1.
; Then waits for a short time.
; .
; #HTML(#AUDIO0(game-over-tune.wav)(#INCLUDE(GameOverTune)))
; .
; #PUSHS #UDGTABLE { #SIM(start=$876B,stop=$0000,clear=1,sp=$5B60)
; #SIM(start=$DF1F,stop=$0000,sp=$5B60)
; #SIM(start=$DE9D,stop=$DEB0,sp=$5B60)
; #SCR$02(show-player-number) } UDGTABLE# #POPS
@label=ShowPlayerNumber
c$DE9D CALL $A8E1    ; Call #R$A8E1.
 $DEA0 CALL $A8D1    ; Call #R$A8D1.
; This entry point is used by the routine at #R$DFF0.
@label=ShowPlayerNumber_Print
*$DEA3 LD A,($DEDD)  ; Read the byte at #R$DEDD.
 $DEA6 INC A         ; Advance #REGa.
 $DEA7 LD ($DECF),A  ; Write #REGa at #R$DEC4(#N$DECF).
 $DEAA LD DE,$DEC4   ; Point #REGde at #R$DEC4.
 $DEAD CALL $A923    ; Call #R$A923.
 $DEB0 LD DE,$DFD1   ; Point #REGde at #R$DFD1.
 $DEB3 LD A,($DEDE)  ; Read the byte at #R$DEDE.
 $DEB6 AND A         ; See whether #REGa is zero.
 $DEB7 CALL Z,$A1C1  ; Call #R$A1C1 if the zero flag is set.
 $DEBA LD B,$08      ; #REGb is #N$08.
@label=ShowPlayerNumber_Loop
*$DEBC LD D,$00      ; #REGd is #N$00.
 $DEBE CALL $A8F9    ; Call #R$A8F9.
 $DEC1 DJNZ $DEBC    ; Repeat from #R$DE9D(#N$DEBC) while #REGb still counts.
 $DEC3 RET           ; Return.

; Player Number Text
;
; The text record for the message 'PLAYER 1', which is printed by
; #R$DE9D. The number is changed to suit the player.
@label=PlayerNumberText
b$DEC4 DEFB $40,$5F                         ; Position: x=#N$40, y=#N$5F.
 $DEC6 DEFB $47                             ; Attribute: #COLOUR(#PEEK(#PC)).
 $DEC7 DEFB $C8                             ; Length #N$08, quadruple size.
 $DEC8 DEFB $19,$15,$0A,$22,$0E,$1B,$27,$01 ; "PLAYER 1"

; Game Over Text
;
; The text record for the message 'GAME OVER', which is printed by
; #R$DFF0(#N$E0C0).
@label=GameOverText
b$DED0 DEFB $38,$3F                         ; Position: x=#N$38, y=#N$3F.
 $DED2 DEFB $46                             ; Attribute: #COLOUR(#PEEK(#PC)).
 $DED3 DEFB $C9                             ; Length #N$09, quadruple size.
 $DED4 DEFB $10,$0A,$16,$0E,$27,$18,$1F,$0E ; {"GAME OVER"
 $DEDC DEFB $1B                             ; }

; Current Player
;
; The player who is playing, which is #N$00 for player 1 and #N$01 for
; player 2.
@label=CurrentPlayer
g$DEDD DEFB $00

; Lives
;
; The number of lives that the current player has. The details of the
; player that is not playing are held at #R$DEFD, and the two are swapped by
; #R$A30D. This byte is the first of a block of #N$1F bytes that are swapped.
@label=Lives
g$DEDE DEFB $03

; Level Number
;
; The number of the level that the player is on, which is a number from
; #N$00 to #N$04.
@label=LevelNumber
g$DEDF DEFB $00

; Bottles Left
;
; The number of bottles that the player has still to collect. The exit
; opens when it reaches zero.
@label=BottlesLeft
g$DEE0 DEFB $0F

; Bottle States
;
; The state of each of the #N$14 bottles of the level, which is set by
; #R$DFF0(#N$E0EB) and kept by #R$A39B and #R$A3FE.
@label=BottleStates
g$DEE1 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00

; Restart Position
;
; The position at which the player restarts, which is used by #R$876B if
; the flag in the third byte of it is set. The routine at #R$E461 sets it.
@label=RestartPosition
g$DEF5 DEFB $00,$00,$00,$00

; Score
;
; The score of the current player, as six digits in binary coded decimal
; in three bytes.
@label=Score
g$DEF9 DEFB $00,$00,$00

; Bottle Flag
;
; A flag that is set when the player is on a bottle, so that #R$A3FE
; collects it.
@label=BottleFlag
g$DEFC DEFB $00

; Other Player State
;
; The details of the player who is not playing, in the same format as the
; #N$1F bytes from #R$DEDE. The first byte is the number of lives and the third
; is the number of bottles left.
@label=OtherPlayerState
g$DEFD DEFB $01,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00

; Panel Fill Rectangle
;
; The rectangle that is used by #R$DF1F to clear the area of the screen
; of the game.
@label=PanelFillRectangle
b$DF1C DEFB $20,$18,$00

; Start Game
;
; Used by the routine at #R$DFF0.
; .
; Sets up everything for a new game: the lives, the scores, the gauges,
; the bottles and the details of the second player if there is one. The entry
; point at #R$DF81 is also used to start each life, and resets the player
; state.
;
; .
;
; Colour the area at the bottom of the screen.
@label=StartGame
c$DF1F LD HL,$BF00   ; {Colour the area that is described by the rectangle at #R$DF1C,
 $DF22 LD DE,$DF1C   ; starting at the position #N$BF00.
 $DF25 CALL $AAE8    ; }
; Give the first player five lives.
 $DF28 LD A,$05      ; {Set the number of lives to #N$05.
 $DF2A LD ($DEDE),A  ; }
; Clear the score of the first player and the digits of the scores of both
; players.
 $DF2D LD HL,$DEF9   ; {Clear the three bytes of the score of the first player.
 $DF30 LD B,$03      ;
 $DF32 CALL $A2E0    ; }
 $DF35 LD HL,$E132   ; {Clear the five digits of the score of the first player in the panel
 $DF38 LD B,$05      ; text.
 $DF3A CALL $A2E0    ; }
 $DF3D LD HL,$E144   ; {Clear the five digits of the score of the second player in the panel
 $DF40 LD B,$05      ; text.
 $DF42 CALL $A2E0    ; }
; Set up the two gauges.
 $DF45 LD DE,$A59D   ; {Copy the starting values of the gauges, which empty the bars and set
 $DF48 LD HL,$DFA3   ; the targets to full.
 $DF4B LD BC,$0008   ;
 $DF4E LDIR          ; }
; Mark all of the bottles of the level as not yet collected.
 $DF50 LD HL,$DEE1   ; Point #REGhl at #R$DEE1.
 $DF53 LD A,$81      ; Set the state of an uncollected bottle.
 $DF55 LD B,$14      ; Set the number of bottles to #N$14.
@label=StartGame_Loop
*$DF57 LD (HL),A     ; Set the state of a bottle.
 $DF58 INC HL        ; Move on to the next bottle.
 $DF59 DJNZ $DF57    ; Loop back to #R$DF57 until all of the bottles have been
                     ; done.
; Clear the restart position, the current player and the bottle flag, and
; go to the first level.
 $DF5B XOR A         ; {Clear the restart position.
 $DF5C LD ($DEF7),A  ; }
 $DF5F LD ($DEDD),A  ; Make the first player the current player.
 $DF62 LD ($DEFC),A  ; Clear the bottle flag of the player.
 $DF65 LD A,$00      ; {Set the number of the level to zero.
 $DF67 LD ($DEDF),A  ; }
; Copy the details of the first player to the second player.
 $DF6A LD HL,$DEDE   ; {Copy the details of the first player, which are #N$1F bytes, to
 $DF6D LD DE,$DEFD   ; those of the second player.
 $DF70 LD BC,$001F   ;
 $DF73 LDIR          ; }
; Take the lives and the bottles away from the second player if there is
; only one player.
 $DF75 LD A,($60FD)  ; Fetch the number of players.
 $DF78 AND A         ; Test it.
 $DF79 JR NZ,$DF81   ; Jump to #R$DF81 if there are two players.
 $DF7B LD ($DEFD),A  ; Clear the lives of the second player.
 $DF7E LD ($DEFF),A  ; Clear the bottles of the second player.
; This entry point is used by the routine at #R$DFF0.
; .
; Start a life. Reset the heading of the player, the message, the counter
; of the player and the countdown timer.
@label=StartGame_Life
*$DF81 XOR A         ; {Clear the heading of the player.
 $DF82 LD ($B551),A  ; }
 $DF85 LD ($CE59),A  ; Clear the state of the message.
 $DF88 LD ($5D00),A  ; Clear the counter of the player.
 $DF8B LD A,$28      ; {Start the countdown timer at #N$28.
 $DF8D LD ($A2DF),A  ; }
 $DF90 LD A,$04      ; {Set the byte that is patched into the controls at #R$AB0F(#N$AB7D)
 $DF92 LD ($AB7D),A  ; to #N$04.}
; Fill the first gauge, and draw the direction gauge with the needle at
; its start.
 $DF95 LD HL,$6000   ; {Set the first gauge to full.
 $DF98 LD ($A59F),HL ; }
 $DF9B LD A,$08      ; {Set the heading of the needle to #N$08.
 $DF9D LD ($5CD8),A  ; }
 $DFA0 JP $A724      ; Draw the direction gauge.

; Gauge Defaults
;
; The initial values of the two gauges, which are copied to #R$A59D.
@label=GaugeDefaults
b$DFA3 DEFB $00,$00,$00,$60
 $DFA7 DEFB $00,$15,$00,$60

; Remove Object Entities
;
; Used by the routines at #R$AA5B and #R$DFF0.
; .
; Removes each of the four entities that were made for objects of the
; level by #R$BE01, and clears the flag of each of the objects.
@label=RemoveObjectEntities
c$DFAB LD IX,$B670     ; Point #REGix at #R$B540(#N$B670).
 $DFAF LD B,$04        ; #REGb is #N$04.
 $DFB1 LD DE,$0026     ; #REGde is #N$0026.
@label=RemoveObjectEntities_Loop
*$DFB4 LD A,(IX+$00)   ; Read field #N$00 of the entity.
 $DFB7 AND A           ; See whether #REGa is zero.
 $DFB8 JR Z,$DFCC      ; Jump to #R$DFCC if the zero flag is set.
 $DFBA LD H,(IX+$1A)   ; Read field #N$1A of the entity into #REGh.
 $DFBD LD L,(IX+$1B)   ; Read field #N$1B of the entity into #REGl.
 $DFC0 INC HL          ; Advance #REGhl.
 $DFC1 INC HL          ; Advance #REGhl.
 $DFC2 RES 7,(HL)      ; Reset bit 7 of the byte at the address in #REGhl.
 $DFC4 LD (IX+$00),$00 ; Set field #N$00 of the entity to #N$00.
 $DFC8 LD (IX+$01),$80 ; Set field #N$01 of the entity to #N$80.
@label=RemoveObjectEntities_Next
*$DFCC ADD IX,DE       ; #REGix takes #REGde.
 $DFCE DJNZ $DFB4      ; Repeat from #R$DFB4 while #REGb still counts.
 $DFD0 RET             ; Return.

; Game Over Tune
;
; The notes of the tune that is played by #R$A1C1 when the game is over,
; ending with #N$FF.
@label=GameOverTune
b$DFD1 DEFB $0D,$14,$19,$1B,$1C,$14,$19,$1B
 $DFD9 DEFB $18,$12,$19,$1B,$1C,$1B,$19,$0B
 $DFE1 DEFB $0D,$14,$19,$1B,$1C,$14,$19,$1B
 $DFE9 DEFB $18,$12,$1C,$1B,$19,$19,$FF

; Run Game
;
; Used by the routine at #R$5E00.
; .
; The main loop of the game. A game starts with the title menu, and then
; each life is played in the loop from #R$E027. When the player loses a life
; the next player is switched to if there is a second player. When the last life
; is lost the high score is checked and the game starts again.
;
; .
;
; Clear the bytes at #R$5CD8 that the game uses as variables.
@label=RunGame
c$DFF0 LD HL,$5CD8   ; {Clear #N$30 bytes starting at #R$5CD8.
 $DFF3 LD B,$30      ;
 $DFF5 CALL $A2E0    ; }
; Start a new game from the title menu. Make player 1 the player on the
; left of the panel, and go to the first level.
@label=RunGame_Loop
*$DFF8 LD A,($E12E)  ; Fetch the flag that shows the scores are swapped.
 $DFFB AND A         ; Test it.
 $DFFC CALL NZ,$A312 ; Swap the players back if they were swapped.
 $DFFF XOR A         ; {Set the level number to zero.
 $E000 LD ($DEDF),A  ; }
 $E003 CALL $876B    ; Set the colours and the shape of the level.
 $E006 CALL $A8D1    ; Reset the attributes of the screen.
 $E009 CALL $A8E1    ; Clear the screen.
 $E00C CALL $60FE    ; Show the title menu and wait for the game to be started.
 $E00F CALL $DF1F    ; Set up the lives, the scores, the gauges and the bottles for a new
                     ; game.
 $E012 CALL $DE9D    ; Show the number of the player.
 $E015 CALL $A8D1    ; Reset the attributes of the screen.
 $E018 CALL $A8E1    ; Clear the screen.
 $E01B CALL $E229    ; Draw the panel.
; Colour the window of the game for the level.
@label=RunGame_Loop2
*$E01E LD HL,$7730   ; Set #REGhl to the position #N$7730 of the game window.
 $E021 LD DE,$E11C   ; Point #REGde at #R$E11C.
 $E024 CALL $AAE8    ; Colour the window.
; Start a life. Draw the icon of each player that shows whether the player
; has the bottle flag set, putting the icon of the current player on the left.
@label=RunGame_Life
*$E027 LD A,($DEFC)  ; {Fetch the bottle flag of the first player and keep it
 $E02A LD C,A        ; in #REGc.}
 $E02B LD A,($DF1B)  ; {Fetch the bottle flag of the second player and keep it
 $E02E LD B,A        ; in #REGb.}
 $E02F LD A,($DEDD)  ; Fetch the number of the current player.
 $E032 AND A         ; Test it.
 $E033 JR Z,$E038    ; Jump to #R$E038 if it is the first player.
 $E035 LD A,C        ; {Swap the flags of the players, so that the flag of the current
 $E036 LD C,B        ; player is in #REGc.
 $E037 LD B,A        ; }
@label=RunGame_Pictures
*$E038 PUSH BC       ; Stash the flags on the stack.
 $E039 LD HL,$6808   ; Set #REGhl to the position #N$6808 of the icon on the left of the
                     ; panel.
 $E03C LD DE,$64BC   ; Point #REGde at #R$64BC.
 $E03F LD A,C        ; Fetch the flag for the icon.
 $E040 AND A         ; Test it.
 $E041 JR Z,$E046    ; Jump to #R$E046 if the flag is not set.
 $E043 LD DE,$6498   ; Point #REGde at #R$6498.
@label=RunGame_LeftIcon
*$E046 CALL $AAC4    ; Draw the icon on the left.
 $E049 LD L,$E8      ; Move across to the icon on the right of the panel.
 $E04B LD DE,$64BC   ; Point #REGde at #R$64BC.
 $E04E POP BC        ; Restore the flags.
 $E04F LD A,B        ; Fetch the flag for the icon on the right.
 $E050 AND A         ; Test it.
 $E051 JR Z,$E056    ; Jump to #R$E056 if the flag is not set.
 $E053 LD DE,$6498   ; Point #REGde at #R$6498.
@label=RunGame_RightIcon
*$E056 CALL $AAC4    ; Draw the icon on the right.
; Update the panel, reset the state of the player and print the digits of
; the lives and the bottles.
 $E059 CALL $E200    ; Update the digits of the lives and the bottles.
 $E05C CALL $DF81    ; Reset the state of the player, the countdown timer and
                     ; the gauges.
 $E05F LD DE,$E1A5   ; Point #REGde at #R$E1A5.
 $E062 LD B,$04      ; Set the number of text records to #N$04.
 $E064 CALL $E1BD    ; Print the digits of the lives and the bottles of both
                     ; players.
; Put the entities and the bottles of the level in place, build the view
; and print the messages.
 $E067 CALL $DE25    ; Reset the entities.
 $E06A CALL $A39B    ; Restore the bottles that the player has not yet
                     ; collected.
 $E06D CALL $AA5B    ; Build the view of the level.
 $E070 CALL $A4E7    ; Scroll in the message for the stage.
 $E073 CALL $A898    ; Show the exit message, if all of the bottles have been
                     ; collected.
; Draw the first frame, and wipe it on to the screen.
@label=RunGame_Frame
 $E076 LD IX,$B540   ; Point #REGix at #R$B540.
 $E07A CALL $ADF9    ; Project the player on to the screen.
 $E07D CALL $CEE2    ; Update the entities.
 $E080 CALL $AC40    ; Build the draw list.
 $E083 CALL $9F99    ; Sort the draw list.
 $E086 CALL $B06E    ; Draw the items of the draw list.
 $E089 CALL $E461    ; Wipe the view on to the screen.
 $E08C CALL $AD9E    ; Put the rows of the screen buffer back.
; Run the frames of the game until the player loses a life or leaves the
; level. Then remove the entities that were made from the objects of the level,
; and clear the message.
 $E08F CALL $CD11    ; Run the frames of the game.
 $E092 CALL $DFAB    ; Remove the entities that were made from the objects of
                     ; the level.
 $E095 LD DE,$CE5A   ; Point #REGde at #R$CE5A.
 $E098 CALL $A923    ; Clear the first part of the message.
 $E09B CALL $A923    ; Clear the second part of the message.
 $E09E LD A,($AA5A)  ; Fetch the flag that shows a life has been lost.
 $E0A1 AND A         ; Test it.
 $E0A2 JR Z,$E0E0    ; Jump to #R$E0E0 if the player has left the level.
; The player lost a life. Wipe the view off the screen and take away a
; life.
@label=RunGame_Lost
 $E0A4 CALL $E42F    ; Wipe the view off the screen.
 $E0A7 LD A,($DEDE)  ; Fetch the number of lives.
 $E0AA DEC A         ; Take away a life.
@label=RunGame_Loop3
*$E0AB LD ($DEDE),A  ; Store the number of lives.
 $E0AE JR Z,$E0BA    ; Jump to #R$E0BA if the player has no lives left.
; Hand over to the other player in a game with two players, and carry on
; from the start of a life.
 $E0B0 LD A,($60FD)  ; Fetch the number of players.
 $E0B3 AND A         ; Test it.
 $E0B4 CALL NZ,$A30D ; Swap the details of the two players if there are two
                     ; players.
 $E0B7 JP $E027      ; Start the next life.
; The player has no lives left. Show the message 'GAME OVER' and the
; number of the player, and check the high score.
@label=RunGame_Over
*$E0BA CALL $A8D1    ; Reset the attributes of the screen.
 $E0BD CALL $A8E1    ; Clear the screen.
 $E0C0 LD DE,$DED0   ; Point #REGde at #R$DED0.
 $E0C3 CALL $A923    ; Print it.
 $E0C6 CALL $DEA3    ; Print the number of the player and play the game over
                     ; tune.
 $E0C9 CALL $A2F0    ; Check whether the score is a new high score.
 $E0CC LD A,($60FD)  ; Fetch the number of players.
 $E0CF AND A         ; Test it.
 $E0D0 JP Z,$DFF8    ; Go back to the title menu if there is only one player.
 $E0D3 LD A,($DEFD)  ; Fetch the number of lives of the other player.
 $E0D6 AND A         ; Test it.
 $E0D7 JP Z,$DFF8    ; Go back to the title menu if the other player has no lives left
                     ; either.
 $E0DA CALL $A30D    ; Swap the details of the two players.
 $E0DD JP $E027      ; Start a life for the other player.
; The player has left the level. Go on to the next level, put all of the
; bottles back and give the bonus for the time that is left.
@label=RunGame_Complete
*$E0E0 XOR A         ; Clear the bottle flag of the player.
 $E0E1 LD ($DEFC),A  ; Store it.
 $E0E4 LD A,($DEDF)  ; Fetch the number of the level.
 $E0E7 INC A         ; Go on to the next level.
 $E0E8 LD ($DEDF),A  ; Store it.
 $E0EB LD HL,$DEE1   ; Point #REGhl at #R$DEE1.
 $E0EE LD A,$81      ; Set the state of an uncollected bottle.
 $E0F0 LD B,$14      ; Set the number of bottles to #N$14.
@label=RunGame_Loop4
*$E0F2 LD (HL),A     ; Set the state of a bottle.
 $E0F3 INC HL        ; Move on to the next bottle.
 $E0F4 DJNZ $E0F2    ; Loop back to #R$E0F2 until all of the bottles have been
                     ; done.
 $E0F6 LD HL,$0000   ; Clear the wanted heading of the player.
 $E0F9 LD ($B564),HL ; Store it.
 $E0FC CALL $9EA3    ; Play the fanfare.
 $E0FF CALL $A5F4    ; Count down the time that is left and add it to the
                     ; score.
 $E102 CALL $E42F    ; Wipe the view off the screen.
 $E105 XOR A         ; Clear the restart position.
 $E106 LD ($DEF7),A  ; Store it.
; After the last level, show the ending and finish the game.
 $E109 LD A,($DEDF)  ; Fetch the number of the level.
 $E10C SUB $05       ; Take away the number of levels.
 $E10E JR NZ,$E116   ; Jump to #R$E116 if the last level has not been finished.
 $E110 CALL $5E65    ; Show the ending.
 $E113 XOR A         ; Set the number of lives to zero.
 $E114 JR $E0AB      ; Jump to #R$E0AB to finish the game.
@label=RunGame_Next
*$E116 CALL $876B    ; Set the colours and the shape of the next level.
 $E119 JP $E01E      ; Start the level.

; Panel Rectangle
;
; The rectangle that is used by #R$DFF0 to set the attributes of the game
; area. The attribute is set to suit the level by #R$876B.
@label=PanelRectangle
b$E11C DEFB $14,$0E,$46

; Panel Text
;
; The text records for the panel, which are printed by #R$DFF0 and
; updated by #R$E200. The digits of the two scores are at #R$E132 and
; #R$E144, the high score is at #R$E1A0, and there are two digits for the
; lives and two for the bottles of each player.
@label=PanelText
b$E11F DEFB $98,$BE                         ; Position: x=#N$98, y=#N$BE.
 $E121 DEFB $00                             ; Attribute: #COLOUR(#PEEK(#PC)).
 $E122 DEFB $82                             ; Length #N$02, double height.
 $E123 DEFB $27,$27                         ; "  "
 $E125 DEFB $00,$0F                         ; Position: x=#N$00, y=#N$0F.
 $E127 DEFB $46                             ; Attribute: #COLOUR(#PEEK(#PC)).
 $E128 DEFB $85                             ; Length #N$05, double height.
 $E129 DEFB $1C,$0C,$18,$1B,$0E             ; "SCORE"
@label=ScoreTextPlayerOne_Record
 $E12E DEFB $00,$1F                         ; Position: x=#N$00, y=#N$1F.
 $E130 DEFB $47                             ; Attribute: #COLOUR(#PEEK(#PC)).
@label=ScoreTextPlayerOne_Length
 $E131 DEFB $85                             ; Length #N$05, double height.
@label=ScoreText_PlayerOne
 $E132 DEFB $00,$00,$00,$00,$00             ; "00000"
 $E137 DEFB $D8,$0F                         ; Position: x=#N$D8, y=#N$0F.
 $E139 DEFB $46                             ; Attribute: #COLOUR(#PEEK(#PC)).
 $E13A DEFB $85                             ; Length #N$05, double height.
 $E13B DEFB $1C,$0C,$18,$1B,$0E             ; "SCORE"
@label=ScoreTextPlayerTwo_Record
 $E140 DEFB $D8,$1F                         ; Position: x=#N$D8, y=#N$1F.
 $E142 DEFB $47                             ; Attribute: #COLOUR(#PEEK(#PC)).
 $E143 DEFB $85                             ; Length #N$05, double height.
@label=ScoreText_PlayerTwo
 $E144 DEFB $00,$00,$00,$00,$00             ; "00000"
 $E149 DEFB $00,$7D                         ; Position: x=#N$00, y=#N$7D.
 $E14B DEFB $43                             ; Attribute: #COLOUR(#PEEK(#PC)).
 $E14C DEFB $84                             ; Length #N$04, double height.
 $E14D DEFB $1D,$12,$16,$0E                 ; "TIME"
 $E151 DEFB $E0,$7D                         ; Position: x=#N$E0, y=#N$7D.
 $E153 DEFB $43                             ; Attribute: #COLOUR(#PEEK(#PC)).
 $E154 DEFB $84                             ; Length #N$04, double height.
 $E155 DEFB $1D,$12,$16,$0E                 ; "TIME"
 $E159 DEFB $08,$8F                         ; Position: x=#N$08, y=#N$8F.
 $E15B DEFB $46                             ; Attribute: #COLOUR(#PEEK(#PC)).
 $E15C DEFB $09                             ; Length #N$09.
 $E15D DEFB $28,$29,$2A,$2B,$2C,$2D,$29,$2E ; {"<28><29><2A><2B><2C><2D><29><2E><2F>"
 $E165 DEFB $2F                             ; }
 $E166 DEFB $18,$BF                         ; Position: x=#N$18, y=#N$BF.
 $E168 DEFB $46                             ; Attribute: #COLOUR(#PEEK(#PC)).
 $E169 DEFB $05                             ; Length #N$05.
 $E16A DEFB $30,$31,$32,$30,$2B             ; "<30><31><32><30><2B>"
 $E16F DEFB $B0,$8F                         ; Position: x=#N$B0, y=#N$8F.
 $E171 DEFB $46                             ; Attribute: #COLOUR(#PEEK(#PC)).
 $E172 DEFB $09                             ; Length #N$09.
 $E173 DEFB $28,$29,$2A,$2B,$2C,$2D,$29,$2E ; {"<28><29><2A><2B><2C><2D><29><2E><2F>"
 $E17B DEFB $2F                             ; }
 $E17C DEFB $C0,$BF                         ; Position: x=#N$C0, y=#N$BF.
 $E17E DEFB $46                             ; Attribute: #COLOUR(#PEEK(#PC)).
 $E17F DEFB $05                             ; Length #N$05.
 $E180 DEFB $30,$31,$32,$30,$2B             ; "<30><31><32><30><2B>"
 $E185 DEFB $68,$9F                         ; Position: x=#N$68, y=#N$9F.
 $E187 DEFB $42                             ; Attribute: #COLOUR(#PEEK(#PC)).
 $E188 DEFB $05                             ; Length #N$05.
 $E189 DEFB $27,$27,$27,$27,$27             ; "     "
 $E18E DEFB $68,$AB                         ; Position: x=#N$68, y=#N$AB.
 $E190 DEFB $42                             ; Attribute: #COLOUR(#PEEK(#PC)).
 $E191 DEFB $85                             ; Length #N$05, double height.
 $E192 DEFB $11,$12,$24,$1C,$0C             ; "HI-SC"
 $E197 DEFB $78,$AB                         ; Position: x=#N$78, y=#N$AB.
 $E199 DEFB $43                             ; Attribute: #COLOUR(#PEEK(#PC)).
 $E19A DEFB $81                             ; Length #N$01, double height.
 $E19B DEFB $24                             ; "-"
 $E19C DEFB $70,$BF                         ; Position: x=#N$70, y=#N$BF.
 $E19E DEFB $45                             ; Attribute: #COLOUR(#PEEK(#PC)).
 $E19F DEFB $85                             ; Length #N$05, double height.
@label=HighScoreText
 $E1A0 DEFB $01,$00,$06,$04,$05             ; "10645"
@label=LivesTextPlayerOne_Record
 $E1A5 DEFB $18,$2B                         ; Position: x=#N$18, y=#N$2B.
 $E1A7 DEFB $47                             ; Attribute: #COLOUR(#PEEK(#PC)).
 $E1A8 DEFB $02                             ; Length #N$02.
@label=LivesText_PlayerOne
 $E1A9 DEFB $00,$00                         ; "00"
@label=LivesTextPlayerTwo_Record
 $E1AB DEFB $D8,$2B                         ; Position: x=#N$D8, y=#N$2B.
 $E1AD DEFB $47                             ; Attribute: #COLOUR(#PEEK(#PC)).
 $E1AE DEFB $02                             ; Length #N$02.
@label=LivesText_PlayerTwo
 $E1AF DEFB $00,$00                         ; "00"
@label=BottlesTextPlayerOne_Record
 $E1B1 DEFB $18,$47                         ; Position: x=#N$18, y=#N$47.
 $E1B3 DEFB $47                             ; Attribute: #COLOUR(#PEEK(#PC)).
 $E1B4 DEFB $02                             ; Length #N$02.
@label=BottlesText_PlayerOne
 $E1B5 DEFB $00,$00                         ; "00"
@label=BottlesTextPlayerTwo_Record
 $E1B7 DEFB $D8,$47                         ; Position: x=#N$D8, y=#N$47.
 $E1B9 DEFB $47                             ; Attribute: #COLOUR(#PEEK(#PC)).
 $E1BA DEFB $02                             ; Length #N$02.
@label=BottlesText_PlayerTwo
 $E1BB DEFB $00,$00                         ; "00"

; Print Text Records
;
; Used by the routines at #R$5E65, #R$60FE, #R$DFF0 and #R$E229.
; .
; Prints a number of text records, one after the other, with #R$A923.
; .
; #PUSHS #UDGTABLE { #BLANKSCREEN(0)
; #SIM(start=$E1BD,stop=$0000,de=$E11F,bc=$1300,sp=$5B60)
; #SCR$02(print-text-records) } UDGTABLE# #POPS
;
; DE The address of the first text record
; B The number of text records
@label=PrintTextRecords
c$E1BD PUSH BC       ; Remember #REGbc.
 $E1BE CALL $A923    ; Call #R$A923.
 $E1C1 POP BC        ; Bring back #REGbc.
 $E1C2 DJNZ $E1BD    ; Repeat from #R$E1BD while #REGb still counts.
 $E1C4 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #CYBERUN$83CE }
; LIST#

; Copy Rectangle Rows
;
; Used by the routine at #R$E229.
; .
; Copies rows of bytes into the table at #N$F502. The first byte is the
; width of each row, remembered at #N$F500, and the second is the number of
; rows, remembered at #N$F501. Each copied byte is two source bytes on from
; the last.
;
; DE The address of the data
@label=CopyRectangleRows
c$E1C5 LD A,(DE)     ; {The width of each row, remembered at #N$F500.
 $E1C6 LD C,A        ;
 $E1C7 LD ($F500),A  ;
 $E1CA INC DE        ; }
 $E1CB LD A,(DE)     ; {The number of rows, remembered at #N$F501.
 $E1CC LD ($F501),A  ; }
 $E1CF LD HL,$F502   ; The copy starts at #N$F502.
@label=CopyRectangleRows_Row
*$E1D2 EX AF,AF'     ; One row.
 $E1D3 LD B,C        ; The width is the count for this row.
@label=CopyRectangleRows_Byte
*$E1D4 INC DE        ; {Copy the next byte, two source bytes on.
 $E1D5 INC DE        ;
 $E1D6 LD A,(DE)     ;
 $E1D7 LD (HL),A     ;
 $E1D8 INC HL        ; }
 $E1D9 DJNZ $E1D4    ; The rest of the row.
 $E1DB EX AF,AF'     ; The next row.
 $E1DC DEC A         ; One fewer row remains.
 $E1DD JR NZ,$E1D2   ; Another row.
 $E1DF RET           ; Return.

; Panel Rectangles
;
; The three rectangles that are used by #R$E229 to set the attributes of
; the panel.
@label=PanelRectangles
b$E1E0 DEFB $03,$02,$46
@label=PanelRectangles_Second
 $E1E3 DEFB $03,$04,$44
@label=PanelRectangles_Third
 $E1E6 DEFB $02,$03,$06

; Get Digits
;
; Used by the routines at #R$D5DF and #R$E200.
; .
; Converts a number to two digits, ready to be printed as text.
;
;   A The number, which is #N$00 to #N$63
; O:H The units digit
; O:L The tens digit
@label=GetDigits
c$E1E9 AND A         ; See whether #REGa is zero.
 $E1EA JR Z,$E1F3    ; Jump to #R$E1E9(#N$E1F3) if the zero flag is set.
 $E1EC LD B,A        ; #REGa moves into #REGb.
@label=GetDigits_Convert
 $E1ED XOR A         ; Set #REGa to zero.
@label=GetDigits_Loop
*$E1EE ADD A,$01     ; Add #N$01.
 $E1F0 DAA           ; Adjust #REGa for binary coded decimal.
 $E1F1 DJNZ $E1EE    ; Repeat from #R$E1E9(#N$E1EE) while #REGb still counts.
@label=GetDigits_Skip
*$E1F3 LD B,A        ; #REGa moves into #REGb.
 $E1F4 RRA           ; Rotate #REGa right through the carry flag.
 $E1F5 RRA           ; Rotate #REGa right through the carry flag.
 $E1F6 RRA           ; Rotate #REGa right through the carry flag.
 $E1F7 RRA           ; Rotate #REGa right through the carry flag.
 $E1F8 AND %00001111 ; Use bits 0-3.
 $E1FA LD L,A        ; #REGa moves into #REGl.
 $E1FB LD A,B        ; #REGb moves into #REGa.
 $E1FC AND %00001111 ; Use bits 0-3.
 $E1FE LD H,A        ; #REGa moves into #REGh.
 $E1FF RET           ; Return.

; Update Panel Digits
;
; Used by the routines at #R$DFF0 and #R$E229.
; .
; Sets the digits on the panel of the lives and the bottles of each of the
; players, using #R$E1E9. The number of lives that is shown is one less than
; the number the current player has.
@label=UpdatePanelDigits
c$E200 LD A,($DEDE)  ; Read the byte at #R$DEDE.
 $E203 AND A         ; See whether #REGa is zero.
 $E204 JR Z,$E207    ; Jump to #R$E200(#N$E207) if the zero flag is set.
 $E206 DEC A         ; Step #REGa back.
@label=UpdatePanelDigits_Skip
*$E207 CALL $E1E9    ; Call #R$E1E9.
 $E20A LD ($E1A9),HL ; Write #REGhl at #R$E1A9.
 $E20D LD A,($DEFD)  ; Read the byte at #R$DEFD.
 $E210 CALL $E1E9    ; Call #R$E1E9.
 $E213 LD ($E1AF),HL ; Write #REGhl at #R$E1AF.
 $E216 LD A,($DEE0)  ; Read the byte at #R$DEE0.
 $E219 CALL $E1E9    ; Call #R$E1E9.
 $E21C LD ($E1B5),HL ; Write #REGhl at #R$E1B5.
 $E21F LD A,($DEFF)  ; Read the byte at #R$DEFD(#N$DEFF).
 $E222 CALL $E1E9    ; Call #R$E1E9.
 $E225 LD ($E1BB),HL ; Write #REGhl at #R$E1BB.
 $E228 RET           ; Return.

; Draw Panel
;
; Used by the routines at #R$A30D and #R$DFF0.
; .
; Draws the panel at the edges of the screen. This is made of four frames,
; which are drawn with #R$E2E9 using the table at #R$E41B, the pictures and
; the text of the panel, and the attributes of the rectangles at #R$E1E0. The
; direction gauges are also drawn.
; .
; #PUSHS #UDGTABLE { #BLANKSCREEN(0)
; #SIM(start=$E229,stop=$0000,sp=$5B60)
; #SCR$02(draw-panel) } UDGTABLE# #POPS
@label=DrawPanel
c$E229 CALL $E200    ; Refresh the digits of the lives and bottles in the panel
                     ; text.
; Draw the four frames of the panel: the message box, the game window and
; the frames of the two direction gauges.
 $E22C LD IX,$E41B   ; Point #REGix at the first frame in the table at #R$E41B.
 $E230 CALL $E2E9    ; Draw the message box.
 $E233 CALL $E2E9    ; Draw the game window.
 $E236 CALL $E2E9    ; Draw the frame of the left direction gauge.
 $E239 CALL $E2E9    ; Draw the frame of the right direction gauge.
; Draw the corner pieces beside the message box and the empty dial of each
; direction gauge.
 $E23C LD HL,$7D58   ; Set the position of the left corner piece.
 $E23F LD DE,$6307   ; Point #REGde at #R$6307.
 $E242 CALL $AAC4    ; Draw it.
 $E245 LD HL,$7DA0   ; Set the position of the right corner piece.
 $E248 LD DE,$630D   ; Point #REGde at #R$630D.
 $E24B CALL $AAC4    ; Draw it.
 $E24E LD HL,$B7B8   ; Set the position of the empty dial of the right gauge.
 $E251 LD DE,$81E5   ; Point #REGde at #R$81E5.
 $E254 CALL $AAC4    ; Draw it.
 $E257 LD HL,$B710   ; Set the position of the empty dial of the left gauge.
 $E25A LD DE,$81E5   ; Point #REGde at #R$81E5.
 $E25D CALL $AAC4    ; Draw it.
; Draw the dial and needle of each direction gauge.
 $E260 LD A,$08      ; Set the heading of the needle to #N$08.
 $E262 LD ($5CD8),A  ; Store it as the heading to draw.
 $E265 LD A,($A5A2)  ; Fetch the column of the second gauge.
 $E268 LD ($A78A),A  ; Patch it into the drawing routine as the column to draw
                     ; at.
 $E26B CALL $A724    ; Draw the dial of the second gauge.
 $E26E LD A,($A59E)  ; Fetch the column of the first gauge.
 $E271 LD ($A78A),A  ; Patch it into the drawing routine as the column to draw
                     ; at.
 $E274 LD A,$08      ; Set the heading of the needle to #N$08 again.
 $E276 LD ($5CD8),A  ; Store it as the heading to draw.
 $E279 CALL $A724    ; Draw the dial of the first gauge.
; Print the #N$13 text records of the panel: the headings of the scores,
; the digits, the lives and bottles, and the high score.
 $E27C LD DE,$E11F   ; Point #REGde at #R$E11F.
 $E27F LD B,$13      ; Set the number of records to #N$13.
 $E281 CALL $E1BD    ; Print them.
; Colour the icons on both sides of the panel.
 $E284 LD HL,$2F00   ; Set the position of the left lives icon.
 $E287 LD DE,$E1E0   ; Point #REGde at #R$E1E0.
 $E28A CALL $AAE8    ; Colour it.
 $E28D LD L,$E8      ; Move across to the right side.
 $E28F LD DE,$E1E0   ; Point #REGde at #R$E1E0.
 $E292 CALL $AAE8    ; Colour it.
 $E295 LD H,$50      ; Move down to the bottle icons.
 $E297 LD DE,$E1E3   ; Point #REGde at #R$E1E3.
 $E29A CALL $AAE8    ; Colour the right bottle icon.
 $E29D LD L,$00      ; Move across to the left side.
 $E29F LD DE,$E1E3   ; Point #REGde at #R$E1E3.
 $E2A2 CALL $AAE8    ; Colour the left bottle icon.
 $E2A5 LD HL,$6808   ; Set the position of the left spare icon.
 $E2A8 LD DE,$E1E6   ; Point #REGde at #R$E1E6.
 $E2AB CALL $AAE8    ; Colour it.
 $E2AE LD L,$E8      ; Move across to the right side.
 $E2B0 LD DE,$E1E6   ; Point #REGde at #R$E1E6.
 $E2B3 CALL $AAE8    ; Colour it.
; Draw the bubbles that show the lives and the bottles of each player.
 $E2B6 LD DE,$7601   ; Point #REGde at #R$7601.
 $E2B9 CALL $E1C5    ; Copy it into the picture buffer at #N$F500.
 $E2BC LD HL,$5000   ; Set the position of the left bottle.
 $E2BF LD DE,$644B   ; Point #REGde at #R$644B.
 $E2C2 CALL $AAC4    ; Draw it.
 $E2C5 LD L,$E8      ; Move across to the right side.
 $E2C7 LD DE,$644B   ; Point #REGde at #R$644B.
 $E2CA CALL $AAC4    ; Draw it.
 $E2CD LD HL,$2F00   ; Set the position of the left bubble.
 $E2D0 LD DE,$F500   ; Point #REGde at the buffered bubble picture.
 $E2D3 CALL $AAC4    ; Draw it.
 $E2D6 LD L,$E8      ; Move across to the right side.
 $E2D8 LD DE,$F500   ; Point #REGde at the buffered bubble picture.
 $E2DB CALL $AAC4    ; Draw it.
; Draw the empty bars of the two gauges.
 $E2DE LD HL,$8700   ; Set the position of the bar of the first gauge.
 $E2E1 CALL $E3D7    ; Draw it.
 $E2E4 LD L,$A8      ; Set the position of the bar of the second gauge.
 $E2E6 JP $E3D7      ; Jump to #R$E3D7.

; Draw Frame
;
; Used by the routines at #R$60FE and #R$E229.
; .
; Draws a frame, from an entry of #N$05 bytes in the table at #R$E41B,
; and moves on to the next entry. The edges of the frame are made with #R$E3AC,
; #R$E3B0 and #R$E3BD, and the corners with #R$E376.
; .
; #PUSHS #UDGTABLE { #BLANKSCREEN(0)
; #SIM(start=$E2E9,stop=$0000,ix=$E41B,sp=$5B60)
; #SCR$02(draw-frame) } UDGTABLE# #POPS
;
;   IX The entry of the frame
; O:IX The next entry
@label=DrawFrame
c$E2E9 LD A,(IX+$04)  ; Fetch the attribute of the frame.
 $E2EC LD ($AAE4),A   ; Store it in the colour rectangle at #R$AAE2(#N$AAE4).
 $E2EF LD L,(IX+$00)  ; Fetch the x position of the frame into #REGl.
 $E2F2 LD H,(IX+$01)  ; Fetch the y position of the frame into #REGh.
 $E2F5 PUSH HL        ; Save the position.
 $E2F6 PUSH HL        ; Save it again.
 $E2F7 INC H          ; Move down a pixel line, to the row below the frame.
 $E2F8 LD C,(IX+$02)  ; Fetch the width of the frame.
 $E2FB LD B,$01       ; Set the height of the rectangle to one row.
 $E2FD LD ($AAE2),BC  ; Store the width and the height in the rectangle.
 $E301 CALL $AAE5     ; Colour the row below the frame.
 $E304 POP HL         ; Restore the position.
 $E305 LD B,(IX+$03)  ; Fetch the height of the frame in pixel lines.
 $E308 LD A,H         ; Copy the y position into #REGa.
 $E309 SUB B          ; Subtract the height of the frame.
 $E30A LD H,A         ; Copy it into #REGh, to find the row above the frame.
 $E30B CALL $AAE5     ; Colour the row above the frame.
 $E30E POP HL         ; Restore the position.
 $E30F DEC L          ; Move one pixel to the left, beside the frame.
 $E310 INC H          ; Move down a pixel line.
 $E311 PUSH HL        ; Save the position.
 $E312 LD C,$01       ; Set the width of the rectangle to one cell.
 $E314 LD A,(IX+$03)  ; Fetch the height of the frame.
 $E317 ADD A,$17      ; Round it up to a whole number of rows.
 $E319 SRL A          ; Halve it.
 $E31B SRL A          ; Halve it again.
 $E31D SRL A          ; Halve it a third time, to find the height in rows.
 $E31F LD B,A         ; Copy it into #REGb.
 $E320 LD ($AAE2),BC  ; Store the width and the height in the rectangle.
 $E324 CALL $AAE5     ; Colour the column on the left of the frame.
 $E327 POP HL         ; Restore the position.
 $E328 LD A,(IX+$02)  ; Fetch the width of the frame.
 $E32B ADD A,A        ; Double it.
 $E32C ADD A,A        ; Double it again.
 $E32D ADD A,A        ; Double it a third time, to find the width in pixels.
 $E32E ADD A,L        ; Add the x position.
 $E32F INC A          ; Add one to find the column on the right of the frame.
 $E330 LD L,A         ; Copy it into #REGl.
 $E331 CALL $AAE5     ; Colour the column on the right of the frame.
 $E334 LD L,(IX+$00)  ; Fetch the x position of the frame into #REGl.
 $E337 LD H,(IX+$01)  ; Fetch the y position of the frame into #REGh.
 $E33A CALL $E3AC     ; Draw the left edge of the frame.
 $E33D LD A,L         ; Fetch the x position of the left edge.
 $E33E ADD A,(IX+$02) ; Add the width of the frame.
 $E341 INC A          ; Add one.
 $E342 LD L,A         ; Copy the position of the right edge into #REGl.
 $E343 CALL $E3B0     ; Draw the right edge of the frame.
 $E346 LD A,(IX+$01)  ; Fetch the y position of the frame.
 $E349 ADD A,$06      ; Add #N$06 to find the y position of the bottom bar.
 $E34B LD H,A         ; Copy it into #REGh.
 $E34C SUB (IX+$03)   ; Subtract the height of the frame.
 $E34F SUB $08        ; Subtract eight to find the y position of the top bar.
 $E351 LD ($E358),A   ; Patch it into the instruction at #N$E358.
 $E354 CALL $E3BD     ; Draw the bottom bar of the frame.
 $E357 LD H,$00       ; Set #REGh to the y position of the top bar (this is patched at
                      ; #N$E358).
 $E359 CALL $E3BD     ; Draw the top bar of the frame.
 $E35C LD DE,$E38C    ; Point #REGde at #R$E38C.
 $E35F LD A,(IX+$01)  ; Fetch the y position of the frame.
 $E362 ADD A,$06      ; Add #N$06 to find the y position of the bottom bar.
 $E364 CALL $E376     ; Draw the corners of the bottom bar.
 $E367 LD A,(IX+$01)  ; Fetch the y position of the frame.
 $E36A SUB (IX+$03)   ; Subtract the height of the frame.
 $E36D CALL $E376     ; Draw the corners of the top bar.
 $E370 LD DE,$0005    ; Set the length of an entry of the frame table.
 $E373 ADD IX,DE      ; Move #REGix on to the next entry.
 $E375 RET            ; Return.

; Draw Frame Corners
;
; Used by the routine at #R$E2E9.
; .
; Draws the pictures for the corners of a frame at the left and the right
; of one of its edges.
;
; A The vertical position
; IX The entry of the frame
@label=DrawFrameCorners
c$E376 LD H,A        ; Copy the y position into #REGh.
 $E377 LD A,(IX+$00) ; Fetch the x position of the frame.
 $E37A SUB $08       ; Subtract #N$08 to put the corner beside the left end of
                     ; the bar.
 $E37C LD L,A        ; Copy it into #REGl.
 $E37D CALL $AAC4    ; Draw the left corner.
 $E380 LD A,(IX+$02) ; Fetch the width of the frame.
 $E383 INC A         ; Add one.
 $E384 ADD A,A       ; Double it.
 $E385 ADD A,A       ; Double it again.
 $E386 ADD A,A       ; Double it a third time, to find the width in pixels.
 $E387 ADD A,L       ; Add the x position of the left corner.
 $E388 LD L,A        ; Copy it into #REGl.
 $E389 JP $AAC4      ; Jump to #R$AAC4.

; Frame Corner Pictures
;
; The pictures that are used for the corners of the frames by #R$E376.
@label=FrameCornerPictures
b$E38C DEFB $01,$06,$03,$0F,$1F,$1F,$3E,$3C
 $E394 DEFB $01,$06,$C0,$F0,$F8,$F8,$7C,$3C
 $E39C DEFB $01,$06,$3C,$3E,$1F,$1F,$0F,$03
 $E3A4 DEFB $01,$06,$3C,$7C,$F8,$F8,$F0,$C0

; Draw Frame Left
;
; Used by the routine at #R$E2E9.
; .
; Draws a vertical line of the frame, by setting the bytes of the screen
; to #N$3C. The entry point at #R$E3B0 draws it from an address that is already
; in #REGhl.
;
; HL The position of the line
; IX The entry of the frame
@label=DrawFrameLeft
c$E3AC CALL $A9FE    ; Convert the position into a screen address.
@label=DrawFrameLeft_Move
 $E3AF DEC L         ; Move one byte to the left, beside the frame.
; This entry point is used by the routine at #R$E2E9.
@label=DrawFrameLeft_Draw
*$E3B0 LD B,(IX+$03) ; Fetch the height of the frame in pixel lines.
 $E3B3 PUSH HL       ; Save the screen address.
@label=DrawFrameLeft_Loop
*$E3B4 LD (HL),$3C   ; Draw a pixel line of the edge.
 $E3B6 CALL $AA4B    ; Move up a pixel line.
 $E3B9 DJNZ $E3B4    ; Repeat until the whole edge is drawn.
 $E3BB POP HL        ; Restore the screen address.
 $E3BC RET           ; Return.

; Draw Frame Bar
;
; Used by the routine at #R$E2E9.
; .
; Draws a horizontal bar of four rows for the frame, with each row as wide
; as the frame.
;
; H The vertical position
; IX The entry of the frame
@label=DrawFrameBar
c$E3BD LD L,(IX+$00) ; Fetch the x position of the frame into #REGl.
 $E3C0 LD C,$04      ; Set the number of pixel lines in the bar to #N$04.
 $E3C2 CALL $A9FE    ; Convert the position into a screen address.
@label=DrawFrameBar_Loop
*$E3C5 LD B,(IX+$02) ; Fetch the width of the frame in bytes.
@label=DrawFrameBar_Loop2
*$E3C8 LD (HL),$FF   ; Draw a byte of the bar.
 $E3CA INC L         ; Move onto the next byte.
 $E3CB DJNZ $E3C8    ; Repeat until the line is drawn.
 $E3CD LD A,L        ; Copy the screen address into #REGa.
 $E3CE SUB (IX+$02)  ; Subtract the width of the frame.
 $E3D1 LD L,A        ; Copy it back into #REGl, to return to the start of the
                     ; line.
 $E3D2 DEC H         ; Move up a pixel line.
 $E3D3 DEC C         ; Decrease the number of pixel lines by one.
 $E3D4 JR NZ,$E3C5   ; Repeat until the bar is drawn.
 $E3D6 RET           ; Return.

; Draw Gauge Bar
;
; Used by the routine at #R$E229.
; .
; Draws the empty bar of one of the two gauges, which is made of a picture
; of the left end, nine copies of a picture of the middle and a picture of the
; right end. The bar is then filled by #R$A5A5.
;
; HL The position of the left end
@label=DrawGaugeBar
c$E3D7 LD DE,$E3FA   ; Point #REGde at the colour rectangle.
 $E3DA CALL $AAE8    ; Colour the bar.
 $E3DD LD DE,$E3FD   ; Point #REGde at the picture of the left end.
 $E3E0 CALL $AAC4    ; Draw it.
 $E3E3 LD A,$08      ; Set the distance to the next piece to #N$08.
 $E3E5 ADD A,L       ; Add the x position.
 $E3E6 LD L,A        ; Move across to the next piece.
 $E3E7 LD B,$09      ; Set the number of middle pieces to #N$09.
@label=DrawGaugeBar_Loop
*$E3E9 PUSH BC       ; Save the counter.
 $E3EA LD DE,$E407   ; Point #REGde at the picture of the middle piece.
 $E3ED CALL $AAC4    ; Draw it.
 $E3F0 LD A,$08      ; Set the distance to the next piece to #N$08.
 $E3F2 ADD A,L       ; Add the x position.
 $E3F3 LD L,A        ; Move across to the next piece.
 $E3F4 POP BC        ; Restore the counter.
 $E3F5 DJNZ $E3E9    ; Repeat until all of the middle pieces are drawn.
 $E3F7 JP $AAC4      ; Jump to #R$AAC4.

; Gauge Bar Data
;
; The rectangle and the pictures that are used by #R$E3D7.
@label=GaugeBarData
b$E3FA DEFB $0B,$01,$47,$01,$08,$3F,$60,$C0
 $E402 DEFB $80,$80,$C0,$60,$3F,$01,$08,$FF
 $E40A DEFB $00,$00,$00,$00,$00,$00,$FF,$01
 $E412 DEFB $08,$FC,$06,$03,$01,$01,$03,$06
 $E41A DEFB $FC

; Frame Table
;
; The four frames that are drawn by #R$E229. Each is #N$05 bytes: the
; position, the width, the height and the attribute.
@label=FrameTable
b$E41B DEFB $60,$8F,$08,$10,$4D
 $E420 DEFB $30,$77,$14,$70,$4D
 $E425 DEFB $08,$B7,$09,$28,$44
 $E42A DEFB $B0,$B7,$09,$28,$44

; Wipe View Out
;
; Used by the routines at #R$5E65 and #R$DFF0.
; .
; Clears the bytes at #N$4FC6 and at #N$F0CD, and then wipes the picture
; away from the screen by calling #R$E487 once for each step of the wipe, which
; goes up from #N$07 to #N$77 in twos.
; .
; #PUSHS #UDGTABLE { #NEWGAME(0)
; #SIM(start=$AA5B,stop=$0000,sp=$5B60)
; #SIM(start=$E076,stop=$E089,sp=$5B60)
; #SIM(start=$E461,stop=$0000,sp=$5B60)
; #SCR$02(wipe-view-out-before)
; | #SIM(start=$E42F,stop=$0000,sp=$5B60)
; #SCR$02(wipe-view-out-after) } UDGTABLE# #POPS
@label=WipeViewOut
c$E42F LD HL,$4FC6   ; #REGhl is #N$4FC6.
 $E432 LD B,$14      ; #REGb is #N$14.
 $E434 CALL $A2E0    ; Call #R$A2E0.
 $E437 LD HL,$F0CD   ; Point #REGhl at #N$F0CD.
 $E43A LD B,$2C      ; #REGb is #N$2C.
 $E43C CALL $A2E0    ; Call #R$A2E0.
 $E43F LD A,$07      ; #REGa is #N$07.
 $E441 LD ($5CD8),A  ; Write #REGa at #R$5CD8.
 $E444 LD IY,($5CF1) ; Fetch the word at #R$5CF1 into #REGiy.
 $E448 EI            ; Enable interrupts.
 $E449 HALT          ; Wait for the next frame.
@label=WipeViewOut_Loop
*$E44A LD A,($5CD8)  ; Read the byte at #R$5CD8.
 $E44D CP $77        ; Compare #REGa with #N$77.
 $E44F DI            ; Disable interrupts.
 $E450 RET Z         ; Return if the zero flag is set.
 $E451 LD IY,($5CF1) ; Fetch the word at #R$5CF1 into #REGiy.
 $E455 EI            ; Enable interrupts.
 $E456 INC A         ; Advance #REGa.
 $E457 INC A         ; Advance #REGa.
 $E458 LD ($5CD8),A  ; Write #REGa at #R$5CD8.
 $E45B CALL $E487    ; Call #R$E487.
 $E45E JP $E44A      ; Jump to #R$E42F(#N$E44A).

; Wipe View In
;
; Used by the routines at #R$5E65 and #R$DFF0.
; .
; Wipes the picture on to the screen by calling #R$E487 once for each
; step of the wipe, which goes down from #N$78 to #N$08 in twos.
; .
; #PUSHS #UDGTABLE { #NEWGAME(0)
; #SIM(start=$AA5B,stop=$0000,sp=$5B60)
; #SIM(start=$E076,stop=$E089,sp=$5B60)
; #SCR$02(wipe-view-in-before)
; | #SIM(start=$E461,stop=$0000,sp=$5B60)
; #SCR$02(wipe-view-in-after) } UDGTABLE# #POPS
@label=WipeViewIn
c$E461 LD A,$10      ; #REGa is #N$10.
 $E463 LD ($5CE9),A  ; Write #REGa at #R$5CE9.
 $E466 LD A,$78      ; #REGa is #N$78.
 $E468 LD ($5CD8),A  ; Write #REGa at #R$5CD8.
 $E46B LD IY,($5CF1) ; Fetch the word at #R$5CF1 into #REGiy.
 $E46F EI            ; Enable interrupts.
@label=WipeViewIn_Loop
*$E470 LD A,($5CD8)  ; Read the byte at #R$5CD8.
 $E473 DI            ; Disable interrupts.
 $E474 CP $08        ; Compare #REGa with #N$08.
 $E476 RET Z         ; Return if the zero flag is set.
 $E477 LD IY,($5CF1) ; Fetch the word at #R$5CF1 into #REGiy.
 $E47B EI            ; Enable interrupts.
 $E47C DEC A         ; Step #REGa back.
 $E47D DEC A         ; Step #REGa back.
 $E47E LD ($5CD8),A  ; Write #REGa at #R$5CD8.
 $E481 CALL $E487    ; Call #R$E487.
 $E484 JP $E470      ; Jump to #R$E461(#N$E470).

; Draw Wipe Step
;
; Used by the routines at #R$E42F and #R$E461.
; .
; Draws one step of the wipe, by finding the address in the screen buffer
; with #R$E59E and then waiting for the next frame and copying the picture to
; the screen.
;
; A The step
@label=DrawWipeStep
c$E487 LD H,A        ; #REGa moves into #REGh.
 $E488 LD L,$10      ; #REGl is #N$10.
 $E48A LD ($5CDA),SP ; Write #REGsp at #R$5CDA.
 $E48E CALL $E59E    ; Call #R$E59E.
 $E491 HALT          ; Wait for the next frame.
 $E492 DI            ; Disable interrupts.
 $E493 LD SP,HL      ; #REGhl moves into #REGsp.
 $E494 LD DE,$0248   ; #REGde is #N$0248.
@label=DrawWipeStep_Loop
*$E497 DEC DE        ; Step #REGde back.
 $E498 LD A,D        ; #REGd moves into #REGa.
 $E499 OR E          ; Combine #REGa with #REGe.
 $E49A JR NZ,$E497   ; Jump to #R$E487(#N$E497) if the zero flag is reset.
 $E49C LD A,($5CD8)  ; Read the byte at #R$5CD8.
 $E49F ADD A,$87     ; Add #N$87.
 $E4A1 CPL           ; Invert the bits of #REGa.
 $E4A2 LD B,A        ; #REGa moves into #REGb.
 $E4A3 JP $E52B      ; Jump to #R$E52B.

; Buffer Row Table
;
; The addresses of the sixteen rows in the screen buffer, which are #N$18
; bytes apart and are used by #R$E4CC.
@label=BufferRowTable
w$E4A6 DEFW $E5BD
 $E4A8 DEFW $E5D5
 $E4AA DEFW $E5ED
 $E4AC DEFW $E605
 $E4AE DEFW $E61D
 $E4B0 DEFW $E635
 $E4B2 DEFW $E64D
 $E4B4 DEFW $E665
 $E4B6 DEFW $E67D
 $E4B8 DEFW $E695
 $E4BA DEFW $E6AD
 $E4BC DEFW $E6C5
 $E4BE DEFW $E6DD
 $E4C0 DEFW $E6F5
 $E4C2 DEFW $E70D
 $E4C4 DEFW $E725

; Restart Candidate
;
; The position that the player will restart from, which is set by #R$D8E4
; and is copied to #R$DEF5 by #R$E4CC when the player has been on it for long
; enough. Purpose of the individual bytes is not yet known.
@label=RestartCandidate
g$E4C6 DEFB $00,$00,$00,$00,$00,$00

; Update Screen
;
; Used by the routine at #R$CD11.
; .
; Called every frame. Every eighth frame the restart position is updated
; if the player has been standing on a place where it can restart. The frame
; counter is increased and the screen buffer is copied to the screen, starting
; with the rows that are chosen by #R$5CE9. The copy of the buffer to the
; screen is done by using the stack pointer.
; .
; #PUSHS #UDGTABLE { #NEWGAME(0)
; #SIM(start=$AA5B,stop=$0000,sp=$5B60)
; #SIM(start=$E076,stop=$E089,sp=$5B60)
; #SCR$02(update-screen-before)
; | #SIM(start=$E4CC,stop=$0000,sp=$5B60)
; #SCR$02(update-screen-after) } UDGTABLE# #POPS
;
; .
;
; Every eighth frame, remember where the player is standing so that a new
; life can start from there.
@label=UpdateScreen
c$E4CC LD A,($A2DD)  ; Fetch the frame counter.
 $E4CF AND %00000111 ; Use bits 0-2.
 $E4D1 JR NZ,$E50D   ; Jump to #R$E50D unless this is an eighth frame.
 $E4D3 LD A,($B55E)  ; Read field #N$1E of the player entity.
 $E4D6 AND %10000000 ; Keep bit 7, which is set if the player is on the ground.
 $E4D8 JR Z,$E50A    ; Jump to #R$E50A if the player is not on the ground, to forget the
                     ; place that was found.
 $E4DA LD A,($E4C7)  ; Read the byte at #R$E4C6(#N$E4C7), which is not zero if a place to
                     ; restart from has been found.
 $E4DD AND A         ; Test it.
 $E4DE JR Z,$E50D    ; Jump to #R$E50D if no place has been found.
 $E4E0 LD A,($B540)  ; Fetch the type of the player entity.
 $E4E3 DEC A         ; Decrease it by one.
 $E4E4 LD A,$00      ; #REGa is #N$00, ready to forget the place.
 $E4E6 JR NZ,$E50A   ; Jump to #R$E50A if the player is not of type #N$01, to forget the
                     ; place that was found.
; Copy the place that was found to the restart position of the level.
 $E4E8 LD A,($E4C6)  ; Read the byte at #R$E4C6.
 $E4EB LD ($DEF6),A  ; Store it at #R$DEF5(#N$DEF6).
 $E4EE LD A,($E4C7)  ; {Read the byte at #R$E4C6(#N$E4C7) and take away #N$20.
 $E4F1 SUB $20       ; }
 $E4F3 LD B,A        ; Keep it in #REGb.
 $E4F4 LD A,($E4CB)  ; Read the byte at #R$E4C6(#N$E4CB).
 $E4F7 AND %11110000 ; Use bits 4-7.
 $E4F9 OR B          ; Combine them with the byte in #REGb.
 $E4FA LD ($DEF5),A  ; Store them at #R$DEF5.
 $E4FD LD A,($E4C9)  ; Read the byte at #R$E4C6(#N$E4C9).
 $E500 LD ($DEF7),A  ; Store it at #R$DEF5(#N$DEF7).
 $E503 LD A,($E4C8)  ; Read the byte at #R$E4C6(#N$E4C8).
 $E506 LD ($DEF8),A  ; Store it at #R$DEF5(#N$DEF8).
 $E509 XOR A         ; #REGa is #N$00.
@label=UpdateScreen_Store
*$E50A LD ($E4C7),A  ; Forget the place that was found.
; Count the frame, and make the random numbers move on.
@label=UpdateScreen_Count
*$E50D LD HL,($A2DD) ; Fetch the frame counter into #REGhl.
 $E510 INC HL        ; Add one to it.
 $E511 LD ($A2DD),HL ; Store it.
 $E514 CALL $5F9E    ; Update the random number.
; Copy the screen buffer to the game window, one pixel line at a time,
; starting from the line that is chosen by #R$5CE9. The stack pointer is used to
; read the buffer, which saves time.
 $E517 LD ($5CDA),SP ; Store the stack pointer, which is restored at the end.
 $E51B LD A,($5CE9)  ; Fetch the number that selects the first line.
 $E51E LD HL,$E4A6   ; Point #REGhl at the table of line addresses at #R$E4A6.
 $E521 CALL $AA3C    ; Find the entry in the table.
 $E524 LD E,(HL)     ; {Fetch the address of the first line of the buffer into
 $E525 INC HL        ; #REGde.
 $E526 LD D,(HL)     ; }
 $E527 LD B,$70      ; Set the number of pixel lines to copy to #N$70.
 $E529 EX DE,HL      ; {Point the stack pointer at the first line of the
 $E52A LD SP,HL      ; buffer.}
; This entry point is used by the routine at #R$E487.
@label=UpdateScreen_Copy
*$E52B LD HL,$4026   ; Set #REGhl to the screen address of the first pixel line of the game
                     ; window, #N$4026.
 $E52E JP $E544      ; Jump to #R$E544 to copy the first line.
; Move down by one pixel line on the screen.
@label=UpdateScreen_Row
*$E531 LD L,C        ; Go back to the first column of the window.
 $E532 INC H         ; Move down a pixel line.
 $E533 LD A,H        ; Fetch the screen address into #REGa.
 $E534 AND %00000111 ; Use bits 0-2, which are zero at the start of a character
                     ; row.
 $E536 JP NZ,$E544   ; Jump to #R$E544 if the line is in the same character
                     ; row.
 $E539 LD A,L        ; {Move on to the next character row...
 $E53A ADD A,$20     ; }
 $E53C LD L,A        ; ...by adding #N$20.
 $E53D JP C,$E544    ; Jump to #R$E544 if that stays in the same third of the
                     ; screen.
 $E540 LD A,H        ; {Move on to the next third of the screen.
 $E541 SUB $08       ;
 $E543 LD H,A        ; }
; Copy twenty bytes of the buffer to the screen, and skip the last four
; bytes of the line in the buffer.
@label=UpdateScreen_Bytes
*$E544 LD C,L        ; Keep the first column of the line in #REGc.
 $E545 POP DE        ; {Copy the first two bytes of the line.
 $E546 LD (HL),E     ;
 $E547 INC L         ;
 $E548 LD (HL),D     ;
 $E549 INC L         ; }
 $E54A POP DE        ; {Copy the next two bytes of the line.
 $E54B LD (HL),E     ;
 $E54C INC L         ;
 $E54D LD (HL),D     ;
 $E54E INC L         ; }
 $E54F POP DE        ; {Copy the next two bytes of the line.
 $E550 LD (HL),E     ;
 $E551 INC L         ;
 $E552 LD (HL),D     ;
 $E553 INC L         ; }
 $E554 POP DE        ; {Copy the next two bytes of the line.
 $E555 LD (HL),E     ;
 $E556 INC L         ;
 $E557 LD (HL),D     ;
 $E558 INC L         ; }
 $E559 POP DE        ; {Copy the next two bytes of the line.
 $E55A LD (HL),E     ;
 $E55B INC L         ;
 $E55C LD (HL),D     ;
 $E55D INC L         ; }
 $E55E POP DE        ; {Copy the next two bytes of the line.
 $E55F LD (HL),E     ;
 $E560 INC L         ;
 $E561 LD (HL),D     ;
 $E562 INC L         ; }
 $E563 POP DE        ; {Copy the next two bytes of the line.
 $E564 LD (HL),E     ;
 $E565 INC L         ;
 $E566 LD (HL),D     ;
 $E567 INC L         ; }
 $E568 POP DE        ; {Copy the next two bytes of the line.
 $E569 LD (HL),E     ;
 $E56A INC L         ;
 $E56B LD (HL),D     ;
 $E56C INC L         ; }
 $E56D POP DE        ; {Copy the next two bytes of the line.
 $E56E LD (HL),E     ;
 $E56F INC L         ;
 $E570 LD (HL),D     ;
 $E571 INC L         ; }
 $E572 POP DE        ; {Copy the last two bytes of the line.
 $E573 LD (HL),E     ;
 $E574 INC L         ;
 $E575 LD (HL),D     ; }
 $E576 POP DE        ; {Skip the four bytes at the end of the line in the
 $E577 POP DE        ; buffer.}
 $E578 DJNZ $E531    ; Decrease the line counter and loop back to #R$E531 until all #N$70
                     ; lines have been copied.
@label=UpdateScreen_Return
 $E57A LD SP,($5CDA) ; Restore the stack pointer.
 $E57E RET           ; Return.

; Clear Buffer
;
; Clears the screen buffer, by pushing zeroes on the stack.
@label=ClearBuffer
c$E57F LD ($5CDA),SP ; Remember the stack pointer.
 $E583 LD SP,$F1BB   ; The stack starts just past the screen buffer.
 $E586 LD B,$80      ; There are #N$80 rows.
 $E588 LD DE,$0000   ; The fill value is zero.
@label=ClearBuffer_Row
*$E58B PUSH DE       ; {Fill one row with zero.
 $E58C PUSH DE       ;
 $E58D PUSH DE       ;
 $E58E PUSH DE       ;
 $E58F PUSH DE       ;
 $E590 PUSH DE       ;
 $E591 PUSH DE       ;
 $E592 PUSH DE       ;
 $E593 PUSH DE       ;
 $E594 PUSH DE       ;
 $E595 PUSH DE       ;
 $E596 PUSH DE       ; }
 $E597 DJNZ $E58B    ; The next row.
 $E599 LD SP,($5CDA) ; Bring the stack pointer back.
 $E59D RET           ; Return.

; Get Buffer Address
;
; Used by the routines at #R$5E65, #R$B8E2 and #R$E487.
; .
; Finds the address in the screen buffer of a position, which is the
; buffer address plus the row times #N$18 plus the column.
;
;   H The row
;   L The pixel column
; O:HL The address
@label=GetBufferAddress
c$E59E PUSH DE       ; Remember the registers in #REGde.
 $E59F LD A,L        ; {Shift the pixel column down by three.
 $E5A0 RRA           ;
 $E5A1 RRA           ;
 $E5A2 RRA           ; }
 $E5A3 AND %00011111 ; Use the low five bits as the byte column.
 $E5A5 PUSH AF       ; Remember the byte column.
 $E5A6 LD L,H        ; {The row is the high byte, in a word of its own.
 $E5A7 LD H,$00      ; }
 $E5A9 ADD HL,HL     ; {Multiply the row by #N$18.
 $E5AA ADD HL,HL     ;
 $E5AB ADD HL,HL     ;
 $E5AC LD E,L        ;
 $E5AD LD D,H        ;
 $E5AE ADD HL,HL     ;
 $E5AF ADD HL,DE     ; }
 $E5B0 POP AF        ; {Add the byte column.
 $E5B1 LD E,A        ;
 $E5B2 LD D,$00      ;
 $E5B4 ADD HL,DE     ; }
 $E5B5 LD DE,$E5BB   ; {Add the screen buffer base.
 $E5B8 ADD HL,DE     ; }
 $E5B9 POP DE        ; Restore the registers.
 $E5BA RET           ; Return.

; Screen Buffer
;
; The start of the screen buffer, which has #N$80 rows of #N$18 bytes and
; ends at #N$F1BA, after the end of the data of the file. The picture of the
; view is built here before it is copied to the screen. The bytes here when the
; game is saved are whatever was last drawn.
@label=ScreenBuffer
