 $59A0 DEFB $46,$4E,$4E,$4E,$4E,$66,$66,$6E,$46,$6E,$6E,$66,$66,$66,$4E,$4E,$4E,$4E,$4E,$4E,$4E,$4E,$4E,$4E,$4E,$4E,$46,$46,$46,$46,$46,$46 ;
