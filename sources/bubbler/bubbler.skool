@label=DrawingVariables
g$BB9F DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $BBA7 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $BBAF DEFB $00,$00,$43,$09,$00,$45,$0B,$00
 $BBB7 DEFB $00,$00,$00,$82,$01,$1A,$4A,$04
 $BBBF DEFB $00,$4C,$06,$00,$19,$00,$00,$43
 $BBC7 DEFB $09,$00,$82,$0E,$08,$42,$10,$00
 $BBCF DEFB $00,$00,$00,$00,$00,$00,$8D,$01
 $BBD7 DEFB $07,$4F,$01,$00,$00,$00,$00,$00
 $BBDF DEFB $00,$00,$11,$00,$00,$52,$13,$00
 $BBE7 DEFB $54,$15,$00,$16,$00,$00,$17,$00
 $BBEF DEFB $00,$18,$00,$00,$1B,$00,$00

