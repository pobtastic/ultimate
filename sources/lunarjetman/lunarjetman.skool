; #HTML(#AUDIO0(short-beep.wav)(#INCLUDE(ShortBeep)))
@label=SoundsShortBeep
c$B8D4 LD D,$10      ; #REGd=#N$10 (duration).
 $B8D6 LD C,$60      ; #REGc=#N$60 (pitch).
 $B8D8 JR $B8CD      ; Jump to #R$B8CD.

; Play Square Wave
;
; Used by the routines at #R$B52E, #R$B8A8, #R$B8B4, #R$B8C9, #R$B8E8, #R$B8F2,
; #R$B8FF, #R$B918 and #R$B92D.
; .
; Plays one cycle of a square wave through the speaker, with
; #REGc setting the length of each half of the cycle.
;
; C Pitch (length of each half of the wave)
@label=PlaySquareWave
c$B8DA LD B,C        ; {Copy the pitch into #REGb, then decrease it by one and jump back to
@label=Silence_Loop
*$B8DB DJNZ $B8DB    ; #R$B8DB until it is zero.}
 $B8DD LD A,$10      ; {Write #N$10 to port #N$FE to turn the speaker on (bit
 $B8DF OUT ($FE),A   ; 4).}
 $B8E1 LD B,C        ; {Copy the pitch into #REGb, then decrease it by one and jump back to
@label=PlaySquareWave_Loop
*$B8E2 DJNZ $B8E2    ; #R$B8E2 until it is zero.}
 $B8E4 XOR A         ; {Write #N$00 to port #N$FE to turn the speaker off.
 $B8E5 OUT ($FE),A   ; }
 $B8E7 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #COOKIE$68B1 }
; { #JETPAC$680D }
; { #PSSST$64AA }
; { #SABREWULF$BF74 }
; { #TRANZAM$614B }
; LIST#

; Play Repeated Tone
;
; Used by the routine at #R$B3A3.
; .
; Call #R$B8DA, using #REGb as the repeat count.
;
; B Repeat count
; C Pitch
;
; Play #R$B8DA using #REGb as the repeat count.
@label=PlayRepeatedTone
c$B8E8 LD D,B        ; Copy #REGb into the repeat count.
 $B8E9 PUSH BC       ; Stash #REGbc on the stack.
@label=PlayRepeatedTone_Loop
*$B8EA CALL $B8DA    ; Call #R$B8DA.
 $B8ED DEC D         ; Decrease the repeat count by one.
 $B8EE JR NZ,$B8EA   ; Jump back to #R$B8EA until it is zero.
 $B8F0 POP BC        ; Restore #REGbc from the stack.
 $B8F1 RET           ; Return.

; Sounds: Debris
;
; Used by the routines at #R$A272 and #R$AB48.
; .
; Three clicks pitched from #R$5E7B.
; .
; #HTML(#AUDIO0(debris.wav)(#INCLUDE(Debris)))
@label=SoundsDebris
c$B8F2 LD A,($5E7B)  ; Fetch #R$5E7B.
 $B8F5 LD C,A        ; Copy it into the pitch.
 $B8F6 LD D,$03      ; #REGd=#N$03.
@label=SoundsDebris_Loop
*$B8F8 CALL $B8DA    ; Call #R$B8DA.
 $B8FB DEC D         ; Decrease the repeat count by one.
 $B8FC JR NZ,$B8F8   ; Jump back to #R$B8F8 until it is zero.
 $B8FE RET           ; Return.

; Sounds: Explosion
;
; Used by the routine at #R$A742.
; .
; Falling pitch played when an explosion animation ends.
; .
; #HTML(#AUDIO0(explosion.wav)(#INCLUDE(Explosion)))
;
; .
;
; Play a falling-pitch explosion, stepping #REGd down from #N$07.
@label=SoundsExplosion
c$B8FF LD D,$07      ; #REGd=#N$07.
@label=SoundsExplosion_Loop
*$B901 LD A,D        ; Copy the step into #REGa.
 $B902 DAA           ; Convert it to packed BCD.
 $B903 XOR %11110000 ; Flip bits 4-7.
 $B905 RLCA          ; Rotate it left.
 $B906 LD C,A        ; Copy it into the pitch.
; Mix two bits of #R$5E42 into the pitch to add noise.
 $B907 LD A,($5E42)  ; Fetch #R$5E42.
 $B90A RRCA          ; {Rotate it right three times.
 $B90B RRCA          ;
 $B90C RRCA          ; }
 $B90D AND %01100000 ; Keep only bits 5-6.
 $B90F XOR C         ; Flip the bits from the pitch.
 $B910 LD C,A        ; Write the mixed pitch.
; Play the note, then repeat for the next step.
 $B911 CALL $B8DA    ; Call #R$B8DA.
 $B914 DEC D         ; Decrease the step by one.
 $B915 JR NZ,$B901   ; Jump back to #R$B901 until it is zero.
 $B917 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #JETPAC$685F }
; LIST#

; Play Inverted Tone
;
; Used by the routine at #R$9EDC.
; .
; Play #R$B8DA, invert the pitch, and repeat #REGd times.
;
; C Pitch
; D Number of times to repeat
;
; Play #R$B8DA, invert the pitch, and repeat #REGd times.
@label=PlayInvertedTone
c$B918 CALL $B8DA    ; Call #R$B8DA.
 $B91B LD A,C        ; #REGa=#REGc.
 $B91C CPL           ; Flip the bits.
 $B91D LD C,A        ; #REGc=#REGa.
 $B91E DEC D         ; Decrease #REGd by one.
 $B91F JR NZ,$B918   ; Jump to #R$B918 until #REGd is zero.
 $B921 RET           ; Return.

; Tick Wave Duration
;
; Decrease the current wave's pitch and finish the effect
; when it reaches zero.
;
; IX Sound slot
;
; Decrease the current wave pitch and finish if it is zero.
@label=TickWaveDuration
c$B922 DEC (IX+$03)  ; Decrease *#REGix+#N$03 by one.
 $B925 JR Z,$B94B    ; Jump to #R$B94B if zero.
 $B927 LD C,(IX+$03) ; #REGc=*#REGix+#N$03 (pitch).
 $B92A LD D,(IX+$02) ; #REGd=*#REGix+#N$02 (repeat count).
; Continue on to #R$B92D.

; Play Wave Sequence
;
; Used by the routine at #R$B934.
; .
; Plays the square wave from #R$B8DA, repeating it #REGd times.
;
; C Pitch
; D Number of times to repeat
@label=PlayWaveSequence
c$B92D CALL $B8DA    ; Call #R$B8DA.
 $B930 DEC D         ; Decrease #REGd by one.
 $B931 JR NZ,$B92D   ; Jump to #R$B92D until #REGd is zero.
 $B933 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #SABREWULF$BF6D }
; LIST#

; Tick Wave Table
;
; Actor handler for type #N$A1. Plays one note of a sound whose pitches
; are held in a table, so the sound moves on by one note each time the main
; loop reaches the slot.
; .
; The slot is filled by #R$B953 from a template such as #R$B965, and holds:
; #TABLE(default,centre,centre)
; { =h Byte | =h Holds }
; { *#REGix+#N$00 | The actor type, #N$A1. }
; { *#REGix+#N$01 | Counter. Starts at the number of notes plus one. }
; { *#REGix+#N$02 | Address of the pitch table minus one (low byte). }
; { *#REGix+#N$03 | Address of the pitch table minus one (high byte). }
; { *#REGix+#N$04 | Repeat count, i.e. how many times each note is played. }
; TABLE#
; .
; The counter is also the index into the pitch table, and it counts down, so
; the table is played backwards: the last pitch is the first one heard. The
; pitch is the half-wave delay used by #R$B8DA, so the larger the value the
; lower the note. When the counter reaches zero the sound ends and the slot
; is freed by #R$B94B.
;
; IX Explosion slot (#R$6060)
;
; Count down, and end the sound when the table has been played.
@label=TickWaveTable
c$B934 DEC (IX+$01)  ; Decrease the counter in *#REGix+#N$01 by one.
 $B937 JR Z,$B94B    ; Jump to #R$B94B if the counter is now zero.
; Use the counter as an index into the pitch table to find this
; note. The table address is stored minus one, so that an index of #N$01 picks
; the first byte.
; #TABLE(default,centre,centre,centre,centre)
; { =h Call | =h Counter | =h Address | =h Pitch }
; { #N$01 | #N$07 | #N$B971 | #N$48 }
; { #N$02 | #N$06 | #N$B970 | #N$50 }
; { #N$03 | #N$05 | #N$B96F | #N$58 }
; { #N$04 | #N$04 | #N$B96E | #N$60 }
; { #N$05 | #N$03 | #N$B96D | #N$68 }
; { #N$06 | #N$02 | #N$B96C | #N$70 }
; { #N$07 | #N$01 | #N$B96B | #N$78 }
; { #N$08 | #N$00 | - | The sound ends. }
; TABLE#
; The example above is the template at #R$B965, which starts with a counter
; of #N$08 and a table address of #N$B96A.
 $B939 LD C,(IX+$01) ; {Set #REGbc to the counter, to use as the index.
 $B93C LD B,$00      ; }
 $B93E LD L,(IX+$02) ; {Fetch the pitch table address from *#REGix+#N$02 into
 $B941 LD H,(IX+$03) ; #REGhl.}
 $B944 ADD HL,BC     ; Add the index to find the pitch for this note.
 $B945 LD C,(HL)     ; Fetch the pitch into #REGc.
; Play the note, repeated for the number of times held in the slot.
 $B946 LD D,(IX+$04) ; Fetch the repeat count from *#REGix+#N$04 into #REGd.
 $B949 JR $B92D      ; Jump to #R$B92D to play the note #REGd times.

; End Sound
;
; Used by the routines at #R$B922 and #R$B934.
; .
; Ends the sound by clearing the type in the sound slot, which
; frees the slot.
;
; IX Sound slot
@label=EndSound
c$B94B LD (IX+$00),$00 ; Write #N$00 to *#REGix+#N$00.
 $B94F RET             ; Return.
; View the equivalent code in;
; #LIST
; { #JETPAC$6870 }
; LIST#

; Initialise Explosion
;
; Copy an 8-byte explosion template into #R$6060, which starts a sound.
; The entry point at #R$B953 takes the template address in #REGhl.
; .
; There are five templates. The first is read by #R$B922 (type #N$A5) and the
; other four by #R$B934 (type #N$A1).
@label=InitialiseExplosion
c$B950 LD HL,$B95C                          ; #REGhl=#R$B95C.
@label=InitialiseExplosion_Copy
*$B953 LD DE,$6060                          ; #REGde=#R$6060.
 $B956 LD BC,$0008                          ; {Copy #N$08 bytes from #REGhl to
 $B959 LDIR                                 ; #REGde.}
 $B95B RET                                  ; Return.
; Template for #R$B922. It plays one note on each pass, starting from
; the pitch below and counting down to #N$01, so the sound rises over #N$27
; notes. Nothing calls #R$B950, so this one is never used.
; The copy at #R$B953 takes four more bytes than this, which are the first
; instructions at #R$B960, but #R$B922 never reads them.
@label=Explosion_Template_1
 $B95C DEFB $A5                             ; Actor type, handled by #R$B922.
 $B95D DEFB $20                             ; Not read by #R$B922.
 $B95E DEFB $08                             ; Repeat count: each note is played
                                            ; #N$08 times.
 $B95F DEFB $28                             ; Starting pitch.
; This entry point is used by the routines at #R$A579 and #R$B16F.
@label=Copy_Explosion_Template
*$B960 LD HL,$B965                          ; #REGhl=#R$B965.
 $B963 JR $B953                             ; Jump to #R$B953.
; Template for #R$B934: seven notes of falling pitch, each played
; #N$08 times.
; .
; #HTML(#AUDIO0(falling-tone.wav)(#INCLUDE(FallingTone)))
@label=Explosion_Template_2
 $B965 DEFB $A1                             ; Actor type, handled by #R$B934.
 $B966 DEFB $08                             ; Counter: a value of #N$08 gives
                                            ; seven notes.
 $B967 DEFW $B96A                           ; Address of the pitch table minus
                                            ; one.
 $B969 DEFB $08                             ; Repeat count: each note is played
                                            ; #N$08 times.
 $B96A DEFB $00                             ; Index #N$00 of the pitch table,
                                            ; which is never read.
 $B96B DEFB $78,$70,$68,$60,$58,$50,$48     ; Pitch table, played from the last
                                            ; byte back to the first.
 $B972 DEFB $40                             ; Never played, as the counter
                                            ; reaches zero first.
; This entry point is used by the routine at #R$A75D.
; .
@label=InitialiseExplosion_2
*$B973 LD HL,$B978                          ; #REGhl=#R$B978.
 $B976 JR $B953                             ; Jump to #R$B953.
; Template for #R$B934: seven notes of rising pitch, each played
; #N$10 times.
; .
; #HTML(#AUDIO0(rising-tone.wav)(#INCLUDE(RisingTone)))
@label=Explosion_Template_Burst
 $B978 DEFB $A1                             ; Actor type, handled by #R$B934.
 $B979 DEFB $08                             ; Counter: a value of #N$08 gives
                                            ; seven notes.
 $B97A DEFW $B97D                           ; Address of the pitch table minus
                                            ; one.
 $B97C DEFB $10                             ; Repeat count: each note is played
                                            ; #N$10 times.
 $B97D DEFB $00                             ; Index #N$00 of the pitch table,
                                            ; which is never read.
 $B97E DEFB $40,$48,$50,$58,$60,$60,$68     ; Pitch table, played from the last
                                            ; byte back to the first.
 $B985 DEFB $70                             ; Never played, as the counter
                                            ; reaches zero first.
; This entry point is used by the routine at #R$B4C2.
; .
@label=InitialiseExplosion_3
*$B986 LD HL,$B98B                          ; #REGhl=#R$B98B.
 $B989 JR $B953                             ; Jump to #R$B953.
; Template for #R$B934: fifteen notes that swap between two pitches in
; runs of up to four, each note played #N$06 times.
; .
; #HTML(#AUDIO0(warble.wav)(#INCLUDE(Warble)))
@label=Explosion_Template_3
 $B98B DEFB $A1                             ; Actor type, handled by #R$B934.
 $B98C DEFB $10                             ; Counter: a value of #N$10 gives
                                            ; fifteen notes.
 $B98D DEFW $B990                           ; Address of the pitch table minus
                                            ; one.
 $B98F DEFB $06                             ; Repeat count: each note is played
                                            ; #N$06 times.
 $B990 DEFB $00                             ; Index #N$00 of the pitch table,
                                            ; which is never read.
 $B991 DEFB $40,$40,$40,$40,$50,$50,$50,$50 ; {Pitch table, played from the
 $B999 DEFB $40,$40,$40,$40,$50,$50,$50     ; last byte back to the first.}
 $B9A0 DEFB $50                             ; Never played, as the counter
                                            ; reaches zero first.
; This entry point is used by the routine at #R$A766.
; .
@label=InitialiseExplosion_4
*$B9A1 LD HL,$B9A6                          ; #REGhl=#R$B9A6.
 $B9A4 JR $B953                             ; Jump to #R$B953.
; Template for #R$B934: fifteen notes of falling pitch, each played
; #N$06 times.
; .
; #HTML(#AUDIO0(falling-slide.wav)(#INCLUDE(FallingSlide)))
@label=Explosion_Template_4
 $B9A6 DEFB $A1                             ; Actor type, handled by #R$B934.
 $B9A7 DEFB $10                             ; Counter: a value of #N$10 gives
                                            ; fifteen notes.
 $B9A8 DEFW $B9AB                           ; Address of the pitch table minus
                                            ; one.
 $B9AA DEFB $06                             ; Repeat count: each note is played
                                            ; #N$06 times.
 $B9AB DEFB $00                             ; Index #N$00 of the pitch table,
                                            ; which is never read.
 $B9AC DEFB $50,$4E,$4C,$4A,$48,$46,$44,$42 ; {Pitch table, played from the
 $B9B4 DEFB $40,$3E,$3C,$3A,$38,$36,$34     ; last byte back to the first.}
 $B9BB DEFB $32                             ; Never played, as the counter
                                            ; reaches zero first.

; Queue Tune
;
; Used by the routines at #R$800A, #R$802C, #R$80FD, #R$81BB, #R$8D06, #R$91E2,
; #R$9F70, #R$A299, #R$A8E3, #R$AF1C, #R$B2D7 and #R$B52E.
; .
; Copy a bit-7-terminated tune from #REGde into the sound
; buffer, working downwards from #R$FF51.
;
; DE Tune data
;
; Copy a bit-7-terminated tune from #REGde into the buffer.
@label=QueueTune
c$B9BC DI            ; Disable interrupts.
 $B9BD LD HL,$FF51   ; #REGhl=#R$FF51.
; Copy bytes until bit 7 marks the terminator.
@label=QueueTune_Copy
*$B9C0 LD A,(DE)     ; #REGa=*#REGde.
 $B9C1 INC DE        ; Increment #REGde by one.
 $B9C2 BIT 7,A       ; {Jump to #R$B9CA if bit 7 of #REGa is set.
 $B9C4 JR NZ,$B9CA   ; }
 $B9C6 LD (HL),A     ; Write #REGa to *#REGhl.
 $B9C7 DEC HL        ; Decrease #REGhl by one.
 $B9C8 JR $B9C0      ; Jump to #R$B9C0.
; Store the terminator byte with bit 7 cleared.
@label=QueueTune_Terminator
*$B9CA AND %01111111 ; Keep only bits 0-6.
 $B9CC LD (HL),A     ; Write #REGa to *#REGhl.
; Save the buffer pointer and enable interrupts.
 $B9CD LD ($FF54),HL ; Write #REGhl to #R$FF54.
 $B9D0 EI            ; Enable interrupts.
 $B9D1 RET           ; Return.

