; The larger delay for a 2UP game is useful for swapping players controls.
@label=GameDelayTimer
g$5E67 DEFB $00

; Teleport Restore
;
; Set to #N$01 once a teleport has been set up. #R$81D6 then
; calls #R$A2CF to finish it with a debris burst, clearing the flag.
@label=TeleportRestore
g$5E68 DEFB $00

; Debris Count
;
; Number of explosion particles still moving. The debris
; handlers loop until this returns to #N$00.
@label=DebrisCount
g$5E69 DEFB $00

; Debris Y
;
; Working Y used when filling explosion particles.
@label=Debris_Y
g$5E6A DEFB $00
 $5E6B DEFB $00

; Player Inactive
;
; Non-zero while Jetman is dying, teleporting or otherwise not
