; Active Player
;
; Which player is currently active.
; #TABLE(default,centre,centre) { =h Value | =h Player }
; { #N$00 | 1UP }
; { #N$FF | 2UP }
; TABLE#
@label=Flag_ActivePlayer
g$5E65 DEFB $00

; Current menu item colour attribute
;
; Attribute of the menu line currently being printed. #R$81AB
; fetches it when printing a line.
@label=Current_MenuAttribute
g$5E66 DEFB $00

; Game Delay Timer
;
; At the beginning of each player turn there is a delay
; to allow the player to be ready for play.
; #TABLE(default,centre,centre)
; { =h Value | =h Game Mode }
; { #N$40 | 1UP }
; { #N$7F | 2UP }
