g$5E6D DEFB $00,$00

; Hall Of Fame Index
;
; Current character position while entering a name.
@label=HallOfFame_Index
g$5E6F DEFB $00

; Hall Of Fame Fire Lock
;
; Set after fire accepts a letter so the same press cannot
; advance again.
@label=HallOfFame_FireLock
g$5E70 DEFB $00

; High Score Player
;
; Which player's score is being ranked: #N$01 for 1UP, #N$02 for
