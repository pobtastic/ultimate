; Graphic: Moon Rover Attributes
;
; Colour block painted over the moon rover by #R$890A. A width and
; height in attribute cells, then one colour byte per cell, row by row.
; The three lamp colours at #R$BCA9 are rewritten by #R$B87E.
@label=Graphic_Moon_Rover_Attributes
b$BC9E DEFB $07                             ; Width = #N(#PEEK(#PC)) columns.
 $BC9F DEFB $04                             ; Height = #N(#PEEK(#PC)) rows.
 $BCA0 DEFB $47,$47,$47,$47,$47,$47,$47
 $BCA7 DEFB $47,$47
@label=Rover_Lamp_Attributes
 $BCA9 DEFB $47,$47,$47,$47,$47,$45,$45,$45
 $BCB1 DEFB $45,$45,$45,$45,$45,$45,$45,$45
 $BCB9 DEFB $45,$45,$45

; Sprite: None
@label=Sprite_None
b$BCBC DEFB $00      ; Width = #N(#PEEK(#PC)) bytes.
 $BCBD DEFB $00      ; Height = #N(#PEEK(#PC)) pixels.

