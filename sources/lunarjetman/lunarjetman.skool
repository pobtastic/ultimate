; #HTML(#AUDIO0(drop-item.wav)(#INCLUDE(DropItem)))
@label=SoundsDropItem
c$B8C3 LD D,$30      ; #REGd=#N$30 (duration).
 $B8C5 LD C,$40      ; #REGc=#N$40 (pitch).
 $B8C7 JR $B8CD      ; Jump to #R$B8CD.
; View the equivalent code in;
