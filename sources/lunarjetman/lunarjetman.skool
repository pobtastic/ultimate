; Jetman Tune Table
;
; Eight tune pointers. #R$8D06 and #R$91E2 pick one using bits
; 1-3 of #R$5E42 to queue a jingle on some frames. The first and last
; entries both point to #R$BA88.
@label=Jetman_Tune_Table
w$9DB0 DEFW $BA88
 $9DB2 DEFW $BA3E
 $9DB4 DEFW $BA53
 $9DB6 DEFW $BA5E
 $9DB8 DEFW $BA6F
 $9DBA DEFW $BA7A
 $9DBC DEFW $BA83
 $9DBE DEFW $BA88

; Handler: Laser Beam
;
; Used by the routine at #R$8D06.
; .
; On even frames, find a free slot at #R$6000 and copy
; Jetman's column and Y into a new beam.
;
; .
;
; Only fire on even values of #R$5E42.
@label=Handler_LaserBeam
c$9DC0 LD A,($5E42)  ; Fetch #R$5E42.
 $9DC3 AND %00000001 ; Keep only bit 0.
 $9DC5 RET NZ        ; Return if this is an odd frame.
; Search for a free laser beam slot.
@label=Handler_LaserBeam_FindSlot
 $9DC6 LD HL,$6000   ; #REGhl=#R$6000.
 $9DC9 LD DE,$0018   ; #REGde=#N($0018,$04,$04).
 $9DCC LD B,$04      ; Set a slot counter in #REGb for #N$04 loops.
@label=LaserBeam_Slot
*$9DCE LD A,(HL)     ; {Jump to #R$9DDE if this slot is free.
 $9DCF AND A         ;
 $9DD0 JR Z,$9DDE    ; }
 $9DD2 ADD HL,DE     ; Move onto the next slot.
 $9DD3 DJNZ $9DCE    ; Decrease the slot counter by one and loop back
                     ; to #R$9DCE until every slot has been tried.
; All four laser beam slots are in use.
 $9DD5 RET           ; Return.
; When firing to the right, step the column on by #N$10.
@label=Handler_LaserBeam_Loop
*$9DD6 ADD A,$10     ; Add #N$10 to the screen column.
 $9DD8 OR %00000100  ; Set bit 2.
 $9DDA AND %11111110 ; Keep only bits 1-7.
 $9DDC JR $9DFA      ; Jump to #R$9DFA.
; Initialise a new laser beam from Jetman.
@label=Initialise_LaserBeam
*$9DDE LD (HL),$11   ; Write type #N$11 to mark the slot in use.
 $9DE0 INC HL        ; Move onto the beam Y.
 $9DE1 LD DE,$6078   ; #REGde=#R$6078.
 $9DE4 LD B,$0D      ; #REGb=#N$0D.
 $9DE6 LD A,(DE)     ; Fetch Jetman's type.
 $9DE7 INC DE        ; Move onto Jetman's screen column.
; The actor type is a 1-based sprite ID. Decrease
; it to work on the 0-based index: bit 3 is set when
; walking and reset when flying, bit 2 is facing.
 $9DE8 DEC A         ; Decrease it to a 0-based sprite index.
 $9DE9 BIT 3,A       ; {Jump to #R$9DEF if Jetman is flying.
 $9DEB JR Z,$9DEF    ; }
 $9DED DEC B         ; {Decrease the Y offset by two.
 $9DEE DEC B         ; }
@label=Handler_LaserBeam_TestFacing
*$9DEF AND %00000100 ; Keep only bit 2.
 $9DF1 LD A,(DE)     ; Fetch Jetman's screen column.
 $9DF2 JR NZ,$9DD6   ; Jump to #R$9DD6 if Jetman is facing right.
 $9DF4 SUB $08       ; Subtract #N$08 from the screen column.
 $9DF6 AND %11111000 ; Keep only bits 3-7.
 $9DF8 OR %00000101  ; Set bits 0 and 2.
; Write the beam Y and the X of each of the four pulses.
@label=Handler_LaserBeam_StoreColumn
*$9DFA LD C,A        ; Stash the beam column in #REGc.
 $9DFB INC DE        ; {Move onto Jetman's Y.
 $9DFC INC DE        ;
 $9DFD INC DE        ; }
 $9DFE LD A,(DE)     ; Fetch Jetman's Y.
 $9DFF SUB B         ; Subtract the Y offset.
 $9E00 LD (HL),A     ; Write it as the beam Y.
 $9E01 INC HL        ; Move onto the first pulse X.
; Write the beam column into the four pulses, clearing bit 2 in all but
; the first.
 $9E02 LD B,$03      ; Set a pulse counter in #REGb for #N$03 loops.
 $9E04 LD (HL),C     ; Write the beam column as pulse #N$01.
 $9E05 LD A,C        ; Copy it into #REGa.
 $9E06 AND %11111011 ; Reset bit 2.
@label=Handler_LaserBeam_WritePulse
*$9E08 INC HL        ; Move onto the next pulse X.
 $9E09 LD (HL),A     ; Write the column without bit 2.
 $9E0A DJNZ $9E08    ; Decrease the pulse counter by one and loop back
                     ; to #R$9E08 until pulses #N$02-#N$04 are written.
; Set the beam timer, pick the beam colour and play the laser
; sound.
 $9E0C INC HL        ; Move onto the beam timer.
 $9E0D LD A,($5E40)  ; Fetch #R$5E40.
 $9E10 AND %00011000 ; Keep only bits 3-4.
 $9E12 ADD A,$60     ; Add #N$60.
 $9E14 LD (HL),A     ; Write it as the beam timer.
; Pick the beam colour from the table at #R$9E28 using bits 0-1 of
; #R$5E40.
 $9E15 INC HL        ; Move onto the beam colour.
 $9E16 EX DE,HL      ; Switch the slot pointer into #REGde.
 $9E17 LD HL,$9E28   ; #REGhl=#R$9E28.
 $9E1A LD A,($5E40)  ; Fetch #R$5E40.
 $9E1D AND %00000011 ; Keep only bits 0-1.
 $9E1F LD C,A        ; {Create an offset in #REGbc.
 $9E20 LD B,$00      ; }
 $9E22 ADD HL,BC     ; Point #REGhl at that colour.
 $9E23 LD A,(HL)     ; Fetch the colour.
 $9E24 LD (DE),A     ; Write it to the beam colour.
 $9E25 JP $B8A8      ; Jump to #R$B8A8.
; The four colours a laser beam can be.
@label=Attributes_LaserBeam
 $9E28 DEFB $47      ; #COLOUR(#PEEK(#PC)).
; The four colours a laser beam can be.
 $9E29 DEFB $43      ; #COLOUR(#PEEK(#PC)).
; The four colours a laser beam can be.
 $9E2A DEFB $43      ; #COLOUR(#PEEK(#PC)).
; The four colours a laser beam can be.
 $9E2B DEFB $45      ; #COLOUR(#PEEK(#PC)).
; View the equivalent code in;
; #LIST
; { #JETPAC$6F91 }
; LIST#

; Animate: Laser Beam
;
; XOR the four beam pulses onto the screen and drop the
; slot when they have all expired.
;
; IX Actor slot
@label=LaserBeam_Animate
c$9E2C CALL $A796      ; Call #R$A796.
 $9E2F LD D,(IX+$01)   ; Fetch the beam Y.
 $9E32 LD A,(IX+$02)   ; Fetch pulse #N$01.
 $9E35 BIT 2,A         ; {Jump to #R$9E68 if bit 2 is reset.
 $9E37 JR Z,$9E68      ; }
; Move pulse #N$01 on and invert the screen byte there.
 $9E39 LD L,A          ; Copy the pulse X into #REGl.
 $9E3A LD A,$08        ; #REGa=#N$08.
 $9E3C BIT 0,L         ; {Jump to #R$9E42 if bit 0 of the pulse X is reset.
 $9E3E JR Z,$9E42      ; }
 $9E40 NEG             ; Negate the step.
; Add the step to pulse #N$01 and find the screen byte there.
@label=LaserBeam_Animate_StepX
*$9E42 ADD A,L         ; Add the step to the pulse X.
 $9E43 LD E,A          ; Copy the new X into #REGe.
 $9E44 LD H,D          ; Copy the beam Y into #REGh.
 $9E45 PUSH HL         ; Stash the beam position on the stack.
 $9E46 CALL $851E      ; Call #R$851E.
 $9E49 LD (IX+$02),E   ; Write the new X back as pulse #N$01.
; Invert the screen byte, then find the attribute square.
 $9E4C LD A,$FF        ; #REGa=#N$FF.
 $9E4E XOR (HL)        ; Invert the screen byte.
 $9E4F LD (HL),A       ; Write it back.
 $9E50 POP HL          ; Restore the beam position from the stack.
 $9E51 CALL $8506      ; Call #R$8506.
; Colour the attribute square, then count the beam timer down.
 $9E54 LD A,(IX+$07)   ; Fetch the beam colour.
 $9E57 LD (HL),A       ; Write it to the attribute square.
 $9E58 LD A,(IX+$06)   ; Fetch the beam timer.
 $9E5B SUB $08         ; Subtract #N$08.
 $9E5D LD (IX+$06),A   ; Write it back.
 $9E60 AND %11111000   ; Keep only bits 3-7.
 $9E62 JR NZ,$9E68     ; Jump to #R$9E68 if any of those bits remain.
 $9E64 RES 2,(IX+$02)  ; Reset bit 2 of pulse #N$01.
; Set up the pixel masks in the shadow registers, then walk
; pulses #N$02-#N$04.
@label=LaserBeam_Animate_WalkPulses
*$9E68 EXX             ; Switch to the shadow registers.
 $9E69 LD BC,$031C     ; #REGbc'=#N$031C.
 $9E6C LD E,$E0        ; #REGe'=#N$E0.
 $9E6E EXX             ; Switch back to the main registers.
 $9E6F LD E,$03        ; #REGe=#N$03.
 $9E71 PUSH IX         ; {Copy the slot pointer into #REGbc (using the
 $9E73 POP BC          ; stack).}
 $9E74 INC BC          ; {Move #REGbc onto pulse #N$02.
 $9E75 INC BC          ;
 $9E76 INC BC          ; }
; Walk the pulses, skipping any on pulse #N$01's character column.
@label=LaserBeam_Animate_Loop
*$9E77 LD A,(BC)       ; Fetch this pulse X.
 $9E78 XOR (IX+$02)    ; Compare it against pulse #N$01.
 $9E7B AND %11111000   ; Keep only bits 3-7.
 $9E7D JR NZ,$9E8D     ; Jump to #R$9E8D if the pulses are not on the
                       ; same character column.
 $9E7F EXX             ; Switch to the shadow registers.
 $9E80 LD A,B          ; {Rotate the mask bytes.
 $9E81 LD B,C          ;
 $9E82 LD C,E          ; }
 $9E83 EXX             ; Switch back to the main registers.
 $9E84 INC BC          ; Move onto the next pulse.
 $9E85 DEC E           ; Decrease the pulse counter by one.
 $9E86 JR NZ,$9E77     ; Jump back to #R$9E77 if any pulses remain.
; Free the actor slot once every pulse has been skipped.
 $9E88 LD (IX+$00),$00 ; Write #N$00 to the slot type.
 $9E8C RET             ; Return.
; If this pulse is not moving yet, wait on the beam timer and
; then start it.
@label=LaserBeam_Animate_TestBit
*$9E8D LD A,(BC)       ; Fetch this pulse X.
 $9E8E BIT 2,A         ; {Jump to #R$9EAD if bit 2 is set.
 $9E90 JR NZ,$9EAD     ; }
; Count the beam timer down and return until its low bits reach zero.
 $9E92 DEC (IX+$06)    ; Decrease the beam timer by one.
 $9E95 LD A,(IX+$06)   ; Fetch the beam timer.
 $9E98 AND %00000111   ; Keep only bits 0-2.
 $9E9A RET NZ          ; Return if the timer is still running.
; Fold bits 0-1 of #R$5E40 into the beam timer and start this pulse
; moving.
 $9E9B LD A,($5E40)    ; Fetch #R$5E40.
 $9E9E AND %00000011   ; Keep only bits 0-1.
 $9EA0 OR %00000100    ; Set bit 2.
 $9EA2 OR (IX+$06)     ; Merge in the beam timer.
 $9EA5 LD (IX+$06),A   ; Write it back.
 $9EA8 LD A,(BC)       ; Fetch this pulse X.
 $9EA9 OR %00000100    ; Set bit 2.
 $9EAB LD (BC),A       ; Write it back.
 $9EAC RET             ; Return.
; Move this pulse on and XOR its mask onto the screen.
@label=LaserBeam_Animate_DrawPulse
*$9EAD LD A,(BC)       ; Fetch this pulse X.
 $9EAE LD L,A          ; Copy it into #REGl.
 $9EAF LD A,$08        ; #REGa=#N$08.
 $9EB1 BIT 0,L         ; {Jump to #R$9EB7 if bit 0 of the pulse X is reset.
 $9EB3 JR Z,$9EB7      ; }
 $9EB5 NEG             ; Negate the step.
@label=LaserBeam_Animate_AdvancePulse
*$9EB7 ADD A,L         ; Add the step to the pulse X.
 $9EB8 LD (BC),A       ; Write the new X back.
; Draw this pulse by XORing its mask onto the screen byte.
 $9EB9 LD H,D          ; Copy the beam Y into #REGh.
 $9EBA CALL $851E      ; Call #R$851E.
 $9EBD EXX             ; Switch to the shadow registers.
 $9EBE LD A,B          ; {Rotate the mask bytes.
 $9EBF LD B,C          ;
 $9EC0 LD C,E          ; }
 $9EC1 EXX             ; Switch back to the main registers.
 $9EC2 XOR (HL)        ; Flip the screen pixels that are set in the mask in #REGa, so the
                       ; pulse is drawn, or erased if it is already there.
 $9EC3 LD (HL),A       ; Write it back.
 $9EC4 INC BC          ; Move onto the next pulse.
 $9EC5 DEC E           ; Decrease the pulse counter by one.
 $9EC6 JP NZ,$9E77     ; Jump back to #R$9E77 if any pulses remain.
 $9EC9 RET             ; Return.
; View the equivalent code in;
; #LIST
; { #JETPAC$6FFC }
; LIST#

; Animate From Scroll
;
; Use the low bits of #R$607A minus the actor world X as the
; animation frame.
;
; IX Actor slot
@label=AnimateFromScroll
c$9ECA LD A,($607A)  ; Fetch #R$607A.
 $9ECD SUB (IX+$02)  ; Subtract the actor world X.
 $9ED0 AND %00000111 ; Keep only bits 0-2.
; Sprite IDs begin at #R$C782(#N$1A) (#SPRITENAME$1A).
 $9ED2 ADD A,$1A     ; Add #N$1A for the sprite IDs.
 $9ED4 LD (IX+$00),A ; Write it to the actor type.
 $9ED7 CALL $8787    ; Call #R$8787.
 $9EDA JR $9EEE      ; Jump to #R$9EEE.

; Handler: Rover Frames
;
; Advance the moon rover animation from #R$607A, then
; colour the cab and flash the HUD tile chosen by #R$AD36.
;
; IX Actor slot
@label=Handler_RoverFrames
c$9EDC LD A,($607A)  ; Fetch #R$607A.
 $9EDF SUB (IX+$02)  ; Subtract the rover world X.
 $9EE2 NEG           ; Negate the difference.
; The rover has eight frames of animation.
 $9EE4 AND %00000111 ; Keep only bits 0-2.
; Sprite IDs begin at #R$BE90(#N$22)
; (#SPRITENAME$22).
 $9EE6 ADD A,$22     ; Add #N$22 for the rover frames.
 $9EE8 LD (IX+$00),A ; Write it to the actor type.
 $9EEB CALL $8787    ; Call #R$8787.
; This entry point is used by the routine at #R$9ECA.
; .
; While #R$5E6C is set, count it up and tint the rover from it.
@label=Handler_RoverFrames_TestInactive
*$9EEE LD A,($5E6C)  ; Fetch #R$5E6C.
 $9EF1 AND A         ; {Jump to #R$9EFA if it is zero.
 $9EF2 JR Z,$9EFA    ; }
 $9EF4 INC A         ; Increase #R$5E6C by one.
 $9EF5 LD ($5E6C),A  ; Write it back.
 $9EF8 JR $9F3F      ; Jump to #R$9F3F.
; Fill attribute cells at the rover's position when #R$5E57 is
; not zero.
@label=Handler_RoverFrames_Address
*$9EFA LD L,(IX+$01) ; Fetch the rover screen column.
 $9EFD LD H,(IX+$04) ; Fetch the rover Y.
 $9F00 CALL $8506    ; Call #R$8506.
 $9F03 LD A,($5E57)  ; Fetch #R$5E57.
 $9F06 AND A         ; {Jump to #R$9F18 if it is zero.
 $9F07 JR Z,$9F18    ; }
; Fill two rows of the rover's attribute cells with #COLOUR$47, then the
; two rows above them with #COLOUR$45. Cells that are empty are left alone.
 $9F09 LD B,A        ; Set the number of columns to fill in #REGb from #R$5E57.
 $9F0A LD C,$02      ; Set the number of rows to fill in #REGc to #N$02.
 $9F0C LD D,$47      ; Set the fill attribute in #REGd to #COLOUR$47.
 $9F0E CALL $8931    ; Call #R$8931 to fill the first two rows.
; #R$8931 leaves #REGhl one row above the last row it filled, so the
; next call carries on from there.
 $9F11 LD D,$45      ; Set the fill attribute in #REGd to #COLOUR$45.
 $9F13 LD C,$02      ; Set the number of rows to fill in #REGc to #N$02.
 $9F15 CALL $8931    ; Call #R$8931 to fill the next two rows up.
; Flash one of the two HUD tiles, chosen by #R$AD36.
@label=Handler_RoverFrames_MissileBanner
*$9F18 CALL $AD36    ; Call #R$AD36.
 $9F1B JR NC,$9F2E   ; Jump to #R$9F2E if #R$AD36 returned no carry.
; The carry is set, so flash the first tile (#N$5861) and set the
; second tile (#N$5863) to a steady colour.
 $9F1D CALL $AD0B    ; Call #R$AD0B to fetch the flashing attribute.
 $9F20 LD HL,$5861   ; Point #REGhl at the first HUD tile (#N$5861).
 $9F23 CALL $AD00    ; Call #R$AD00 to colour the tile with #REGa.
 $9F26 LD HL,$5863   ; Point #REGhl at the second HUD tile (#N$5863).
 $9F29 LD A,$42      ; Set the steady attribute in #REGa to #COLOUR$42.
 $9F2B JP $AD00      ; Jump to #R$AD00 to colour the tile with #REGa.
; There is no carry, so flash the second tile (#N$5863) and set the
; first tile (#N$5861) to a steady colour.
@label=Handler_RoverFrames_ClearBanner
*$9F2E CALL $AD0B    ; Call #R$AD0B to fetch the flashing attribute.
 $9F31 LD HL,$5863   ; Point #REGhl at the second HUD tile (#N$5863).
 $9F34 CALL $AD00    ; Call #R$AD00 to colour the tile with #REGa.
 $9F37 LD HL,$5861   ; Point #REGhl at the first HUD tile (#N$5861).
 $9F3A LD A,$42      ; Set the steady attribute in #REGa to #COLOUR$42.
 $9F3C JP $AD00      ; Jump to #R$AD00 to colour the tile with #REGa.
; This entry point is used by the routine at #R$91E2.
; .
; Tint the rover from the frame value in #REGa.
@label=Handler_RoverFrames_Tint
*$9F3F CP $30        ; {Jump to #R$B03B if it is at least #N$30.
 $9F41 JP NC,$B03B   ; }
; Use bits 1-3 of the value as the INK colour, stepping through the
; colours as it counts up.
 $9F44 RRCA          ; Rotate it right once.
 $9F45 AND %00000111 ; Keep only bits 0-2.
 $9F47 JR NZ,$9F4A   ; Jump to #R$9F4A if the result is not zero.
; The PAPER is black, so INK #N$00 would make the rover black on black and
; invisible. Use INK #N$01 (blue) as the lowest colour instead.
 $9F49 INC A         ; Increase it to #N$01.
@label=Handler_RoverFrames_WriteColour
*$9F4A OR %01000000  ; Set bit 6.
 $9F4C LD (IX+$07),A ; Write it to the rover colour.
 $9F4F CALL $8733    ; Call #R$8733.
; Play a tone derived from the rover colour.
 $9F52 LD A,(IX+$07) ; Fetch the rover colour.
 $9F55 CPL           ; Invert the bits.
 $9F56 AND %01111111 ; Keep only bits 0-6.
 $9F58 LD C,A        ; Copy the tone into #REGc.
 $9F59 LD D,$20      ; #REGd=#N$20.
 $9F5B JP $B918      ; Jump to #R$B918.

; Initialise Objects
;
; Used by the routine at #R$A84C.
; .
; Copy the #N$60-byte object table from #R$A008 into the
; in-play slots at #R$6090.
@label=InitialiseObjects
c$9F5E LD HL,$A008   ; {Copy #N$60 bytes from #R$A008 to #R$6090.
 $9F61 LD DE,$6090   ;
 $9F64 LD BC,$0060   ;
 $9F67 LDIR          ; }
 $9F69 RET           ; Return.

; Step Pickup Candidate
;
; Used by the routine at #R$9F70.
; .
; Step the high byte of the candidate pickup world X on by #N$10, then
; test it again at #R$9F87.
;
; HL Candidate world X
@label=StepPickupCandidate
c$9F6A LD A,H        ; Fetch the high byte.
 $9F6B ADD A,$10     ; Add #N$10.
 $9F6D LD H,A        ; Write it back.
 $9F6E JR $9F87      ; Jump to #R$9F87.

; Handler: Pickups
;
; Used by the routine at #R$8259.
; .
; Keep the collectible objects in the world. When the pickup slots are
; empty, refill them, choose a world X away from Jetman and the rover, place
; the pickups from it and then advance the level.
;
; .
;
; Refill #R$6108 from #R$A068 when those slots are empty.
@label=Handler_Pickups
c$9F70 CALL $B1E2    ; Call #R$B1E2.
 $9F73 RET NZ        ; Return if any pickup slot is still in use.
 $9F74 LD HL,$A068   ; {Copy the #N$90 bytes of pickup templates from #R$A068 into the
 $9F77 LD DE,$6108   ; pickup slots at #R$6108.
 $9F7A LD BC,$0090   ;
 $9F7D LDIR          ; }
; Seed the candidate world X in #REGhl from #R$5E42 and #R$5E40.
 $9F7F LD A,($5E42)  ; Fetch #R$5E42.
 $9F82 LD H,A        ; Stash it in #REGh.
 $9F83 LD A,($5E40)  ; Fetch #R$5E40.
 $9F86 LD L,A        ; Stash it in #REGl.
; This entry point is used by the routine at #R$9F6A.
; .
; Keep the new world X at least #N$10 away from
; #R$607A and #R$6092.
@label=Handler_Pickups_AwayFromJetman
*$9F87 LD A,($607B)  ; Fetch the high byte of #R$607A.
 $9F8A ADD A,A       ; {Multiply it by #N$08.
 $9F8B ADD A,A       ;
 $9F8C ADD A,A       ; }
 $9F8D SUB H         ; Subtract the candidate high byte.
 $9F8E JP P,$9F93    ; Jump to #R$9F93 if the result is positive.
 $9F91 NEG           ; Negate the difference.
@label=Handler_Pickups_TestJetmanX
*$9F93 CP $10        ; {Jump to #R$9F6A if it is closer than that.
 $9F95 JR C,$9F6A    ; }
; Retry unless the candidate is also at least #N$10 from #R$6092.
 $9F97 LD A,($6093)  ; Fetch the high byte of #R$6092.
 $9F9A ADD A,A       ; {Multiply it by #N$08.
 $9F9B ADD A,A       ;
 $9F9C ADD A,A       ; }
 $9F9D SUB H         ; Subtract the candidate high byte.
 $9F9E JP P,$9FA3    ; Jump to #R$9FA3 if the result is positive.
 $9FA1 NEG           ; Negate the difference.
@label=Handler_Pickups_TestRoverX
*$9FA3 CP $10        ; {Jump to #R$9F6A if it is closer than that.
 $9FA5 JR C,$9F6A    ; }
; Write the new pickup positions into the pickup slots.
 $9FA7 SRL H         ; {Divide the candidate high byte by #N$08.
 $9FA9 SRL H         ;
 $9FAB SRL H         ; }
 $9FAD LD ($610A),HL ; Write it to #R$6108(#N$610A).
; Derive the other pickup world X values by adding offsets and wrapping.
; #R$A002 hands the wrapped result back in #REGhl, so each offset is added to
; the world X written just before it.
 $9FB0 LD BC,$0040   ; Set the offset in #REGbc to #N($0040,$04,$04) to place the next
                     ; pickup that far on from the first.
 $9FB3 CALL $A002    ; Call #R$A002 to add the offset and wrap the world X.
 $9FB6 LD ($616A),HL ; Write it to #R$6168(#N$616A).
; Place the next pickup a smaller step further on.
 $9FB9 LD BC,$0008   ; Set the offset in #REGbc to #N($0008,$04,$04).
 $9FBC CALL $A002    ; Call #R$A002 to add the offset and wrap the world X.
 $9FBF LD ($6182),HL ; Write it to #R$6182.
; Finally step on by #N$40 again for the last pickup.
 $9FC2 LD BC,$0040   ; Set the offset in #REGbc to #N($0040,$04,$04).
 $9FC5 CALL $A002    ; Call #R$A002 to add the offset and wrap the world X.
 $9FC8 LD ($613A),HL ; Write it to #R$613A.
; Advance the level, and award an extra life every
; fourth level.
 $9FCB LD A,($5EA0)  ; Fetch #R$5EA0.
 $9FCE CP $63        ; {Jump to #R$9FD3 if it is already #N$63.
 $9FD0 JR Z,$9FD3    ; }
 $9FD2 INC A         ; Increase the level by one.
@label=Handler_Pickups_WriteLevel
*$9FD3 LD ($5EA0),A  ; Write it back to #R$5EA0.
 $9FD6 AND A         ; {Jump to #R$9FEA if the new level is zero.
 $9FD7 JR Z,$9FEA    ; }
 $9FD9 AND %00000011 ; Keep only bits 0-1.
 $9FDB JR NZ,$9FEA   ; Jump to #R$9FEA if this is not a fourth level.
; Award an extra life and queue a jingle, then redraw the lives.
 $9FDD LD HL,$5EA1   ; #REGhl=#R$5EA1.
 $9FE0 INC (HL)      ; Increase #R$5EA1 by one.
 $9FE1 LD DE,$BAB4   ; Point #REGde at the tune at #R$BAB4.
 $9FE4 CALL $B9BC    ; Call #R$B9BC.
 $9FE7 CALL $894F    ; Call #R$894F.
; Turn the level into the missile launcher countdown at #R$617F (the
; higher the level, the shorter it is), then jump to #R$F5EC.
; Rotating left twice multiplies the level by #N$04. Inverting and masking
; that to bits 2-5 gives #N$3C minus #N$04 for each level, so adding #N$51
; leaves a countdown that falls by #N$04 per level, from #N$8D to #N$51.
; #TABLE(default,centre,centre,centre,centre,centre)
; { =h Level | =h Rotate x2 | =h Invert | =h Keep bits 2-5 | =h Add #N$51 }
; { #N$00 | #N$00 | #N$FF | #N$3C | #N$8D }
; { #N$01 | #N$04 | #N$FB | #N$38 | #N$89 }
; { #N$02 | #N$08 | #N$F7 | #N$34 | #N$85 }
; { #N$07 | #N$1C | #N$E3 | #N$20 | #N$71 }
; { #N$0F | #N$3C | #N$C3 | #N$00 | #N$51 }
; { #N$10 and up | #N$FF | #N$00 | #N$00 | #N$51 }
; TABLE#
@label=Handler_Pickups_TestLevel10
*$9FEA LD A,($5EA0)  ; Fetch #R$5EA0.
 $9FED CP $10        ; Compare it against #N$10.
 $9FEF CALL NC,$9FFF ; Call #R$9FFF if the level is at least #N$10.
 $9FF2 RLCA          ; {Rotate the level left twice.
 $9FF3 RLCA          ; }
 $9FF4 CPL           ; Invert the bits.
 $9FF5 AND %00111100 ; Keep only bits 2-5.
 $9FF7 ADD A,$51     ; Add #N$51.
 $9FF9 LD ($617F),A  ; Write it to #R$617F.
 $9FFC JP $F5EC      ; Jump to #R$F5EC.
; Levels of #N$10 and above use #N$FF in place of the level, so they all
; get the shortest countdown (#N$51). The rotate would otherwise wrap the
; high bits of the level round into the result.
@label=Handler_Pickups_ForceMaximumLevel
*$9FFF LD A,$FF      ; #REGa=#N$FF.
 $A001 RET           ; Return.

; Wrap World X
;
; Used by the routines at #R$9020, #R$9F70, #R$AD59, #R$B3E8, #R$B6AE and
; #R$B731.
; .
; Add #REGbc to a world X and keep bits 0-4 of
; the high byte.
;
;   HL World X
;   BC Offset
; O:HL Wrapped world X
;
; Add the offset and wrap the high byte to bits 0-4.
@label=MaskWorldX
c$A002 ADD HL,BC     ; Add the offset.
 $A003 LD A,H        ; Fetch the high byte.
 $A004 AND %00011111 ; Keep only bits 0-4.
 $A006 LD H,A        ; Write it back.
 $A007 RET           ; Return.

; Object Defaults
;
; Four #N$18-byte actor templates. #R$9F5E copies
; this table to #R$6090.
@label=Object_Defaults
b$A008 DEFB $1A,$00,$00,$00,$AF,$00,$00,$47,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $A020 DEFB $2A,$00,$00,$01,$AF,$00,$00,$46,$00,$00,$00,$00,$00,$00,$00,$00,$00,$06,$06,$00,$00,$00,$00,$00
 $A038 DEFB $2A,$00,$00,$04,$AF,$00,$00,$46,$00,$00,$00,$00,$00,$00,$00,$00,$00,$06,$06,$00,$00,$00,$00,$00
 $A050 DEFB $30,$00,$00,$02,$AF,$00,$00,$45,$00,$00,$00,$00,$00,$00,$00,$00,$00,$06,$06,$00,$00,$00,$00,$00

; Pickup Defaults
;
; Six #N$18-byte templates. #R$9F70 copies
; this table to #R$6108 when the pickup list is empty.
@label=Pickup_Defaults
b$A068 DEFB $90,$00,$00,$00,$AF,$00,$00,$45,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $A080 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $A098 DEFB $90,$00,$00,$00,$AF,$00,$00,$45,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $A0B0 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $A0C8 DEFB $70,$00,$00,$00,$9F,$00,$00,$46,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$90
 $A0E0 DEFB $68,$00,$00,$00,$AF,$00,$00,$47,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00

; Handler: Pickup Action
;
; Used by the routine at #R$A1AA.
; .
; Test the action key and drop or collect the current object.
;
; IX Actor slot
@label=Handler_PickupAction
c$A0F8 CALL $945C      ; {Jump to #R$A101 if the action key is pressed.
 $A0FB JR NZ,$A101     ; }
 $A0FD RES 1,(IX+$08)  ; Reset bit 1 of the actor flags.
@label=Handler_PickupAction_TestRover
*$A101 LD A,($6090)    ; Fetch #R$6090.
 $A104 SUB $1A         ; Subtract #N$1A.
 $A106 CP $10          ; {Jump to #R$A10F if that is not a rover frame.
 $A108 JR NC,$A10F     ; }
 $A10A CALL $A431      ; Call #R$A431.
 $A10D JR $A126        ; Jump to #R$A126.
; Type #N$16 and above is seated facing right;
; hang the object on the left.
@label=Handler_PickupAction_PickOffset
*$A10F LD A,($6078)    ; Fetch #R$6078.
 $A112 CP $16          ; {Jump to #R$A121 if Jetman's type is less than
 $A114 JR C,$A121      ; #N$16.}
 $A116 LD BC,$FFF4     ; Set the offset in #REGbc to #N$FFF4 (-#N$0C).
; Place the object at Jetman's X plus the offset, then go to collect it.
@label=Handler_PickupAction_Loop
*$A119 LD HL,($607A)   ; Fetch #R$607A.
 $A11C CALL $A43E      ; Call #R$A43E.
 $A11F JR $A12C        ; Jump to #R$A12C.
@label=Handler_PickupAction_OnFootOffset
*$A121 LD BC,$0012     ; Set the offset in #REGbc to #N($0012,$04,$04).
 $A124 JR $A119        ; Jump to #R$A119.
; Skip the collect test unless the action key is pressed.
@label=Handler_PickupAction_TestAction
*$A126 CALL $945C      ; Call #R$945C.
 $A129 JP Z,$A212      ; Jump to #R$A212 if the action key is not pressed.
; This entry point is used by the routine at #R$A1AA.
; .
; Collect this object if Jetman is free and in range.
@label=Handler_PickupAction_Collect
*$A12C LD A,($6080)    ; Fetch #R$6080.
 $A12F AND %00000001   ; Keep only bit 0.
 $A131 JP NZ,$A212     ; Jump to #R$A212 if Jetman is already carrying.
 $A134 LD A,(IX+$08)   ; Fetch the actor flags.
 $A137 AND %01110111   ; Keep only bits 0-2 and 4-6.
 $A139 JP NZ,$A212     ; Jump to #R$A212 if any of those bits are set.
; Check the object is in range of Jetman.
 $A13C CALL $A4FC      ; Call #R$A4FC.
 $A13F JP NC,$A212     ; Jump to #R$A212 if the object is out of range.
; Free the rover if this object was attached to it.
 $A142 BIT 3,(IX+$08)  ; {Jump to #R$A14C if bit 3 of the actor flags is
 $A146 JR Z,$A14C      ; reset.}
 $A148 XOR A           ; {Write #N$00 to #R$5EA3.
 $A149 LD ($5EA3),A    ; }
; Mark Jetman as carrying the object and play the pickup sound.
@label=Handler_PickupAction_SetCarrying
*$A14C LD A,($6080)    ; Fetch #R$6080.
 $A14F OR %00000001    ; Set bit 0.
 $A151 LD ($6080),A    ; Write it back.
 $A154 LD (IX+$08),$06 ; Write #N$06 to the actor flags.
 $A158 JP $B8BD        ; Jump to #R$B8BD.
; This entry point is used by the routine at #R$A1AA.
; .
; Snap the object onto Jetman.
@label=Handler_PickupAction_SnapToJetman
*$A15B LD HL,($607A)   ; Fetch #R$607A.
 $A15E LD (IX+$02),L   ; Write the low byte as the object world X.
 $A161 LD (IX+$03),H   ; Write the high byte.
 $A164 LD A,($607C)    ; Fetch #R$607C.
 $A167 ADD A,$12       ; Add #N$12.
 $A169 CP $AF          ; {Jump to #R$A16F if that is still above the
 $A16B JR C,$A16F      ; ground line.}
; #N$AF is the ground line.
 $A16D LD A,$AF        ; #REGa=#N$AF.
@label=Handler_PickupAction_WriteY
*$A16F LD (IX+$04),A   ; Write it as the object Y.
 $A172 CALL $945C      ; {Jump to #R$A17C if the action key is pressed.
 $A175 JR NZ,$A17C     ; }
 $A177 RES 1,(IX+$08)  ; Reset bit 1 of the actor flags.
 $A17B RET             ; Return.
; Throw the object on a second action press.
@label=Handler_PickupAction_Throw
*$A17C BIT 1,(IX+$08)  ; {Return if bit 1 of the actor flags is set.
 $A180 RET NZ          ; }
 $A181 RES 2,(IX+$08)  ; Reset bit 2 of the actor flags.
 $A185 LD A,($6080)    ; Fetch #R$6080.
 $A188 AND %11111110   ; Reset bit 0.
 $A18A LD ($6080),A    ; Write it back.
 $A18D SET 1,(IX+$08)  ; Set bit 1 of the actor flags.
 $A191 SET 7,(IX+$08)  ; Set bit 7 of the actor flags.
; Give the object Jetman's speed and play the drop sound.
 $A195 LD A,($607D)    ; Fetch #R$607D.
 $A198 SRA A           ; {Divide it by #N$10.
 $A19A SRA A           ;
 $A19C SRA A           ;
 $A19E SRA A           ; }
 $A1A0 LD (IX+$05),A   ; Write it as the object speed.
 $A1A3 LD (IX+$06),$01 ; Write #N$01 to the object thrust.
 $A1A7 JP $B8C3        ; Jump to #R$B8C3.

; Handler: Pickup
;
; Animate a collectible, attach it to the rover when #R$5EA3 is
; clear, and teleport Jetman from #R$A212 when SPACE is pressed
; beside it.
;
; IX Actor slot
;
; Cycle the sprite ID and colour from #R$5E42.
@label=Handler_Pickup
c$A1AA LD A,($5E42)   ; Fetch #R$5E42.
 $A1AD RRCA           ; Rotate it right once.
 $A1AE LD C,A         ; Stash it in #REGc.
 $A1AF AND %00000011  ; Keep only bits 0-1.
; Sprite IDs begin at #R$D074(#N$2A) (#SPRITENAME$2A).
 $A1B1 ADD A,$2A      ; Add #N$2A for the pickup frames.
 $A1B3 LD (IX+$00),A  ; Write it to the actor type.
 $A1B6 LD B,$00       ; Clear #REGb.
 $A1B8 LD HL,$A313    ; #REGhl=#R$A313.
; Pick the actor colour from the next two bits of the timer.
 $A1BB LD A,C         ; Copy the rotated timer into #REGa.
 $A1BC RRCA           ; {Rotate it right twice.
 $A1BD RRCA           ; }
 $A1BE AND %00000011  ; Keep only bits 0-1.
 $A1C0 LD C,A         ; Copy the colour index into #REGc.
 $A1C1 ADD HL,BC      ; Point #REGhl at that colour.
 $A1C2 LD A,(HL)      ; Fetch the colour.
 $A1C3 LD (IX+$07),A  ; Write it to the actor colour.
 $A1C6 BIT 3,(IX+$08) ; {Jump to #R$A0F8 if bit 3 of the actor flags is
 $A1CA JP NZ,$A0F8    ; set.}
; Drop the object to the ground while bit 7 of the actor
; flags is set.
 $A1CD BIT 7,(IX+$08) ; {Jump to #R$A1F8 if bit 7 of the actor flags is
 $A1D1 JR Z,$A1F8     ; reset.}
 $A1D3 CALL $A522     ; Call #R$A522.
 $A1D6 JR C,$A1E0     ; Jump to #R$A1E0 if the object has not landed.
 $A1D8 LD A,(IX+$08)  ; Fetch the actor flags.
 $A1DB AND %00000010  ; Keep only bit 1.
 $A1DD LD (IX+$08),A  ; Write it back.
; Attach the pickup to the rover if the rover is not
; carrying and the pickup is in range.
@label=Handler_Pickup_TestCarrying
*$A1E0 LD A,($5EA3)   ; Fetch #R$5EA3.
 $A1E3 AND A          ; {Jump to #R$A1F8 if the rover is already carrying.
 $A1E4 JR NZ,$A1F8    ; }
 $A1E6 CALL $A4BA     ; Call #R$A4BA.
 $A1E9 JR NC,$A1F8    ; Jump to #R$A1F8 if the object is out of range.
 $A1EB LD A,$01       ; {Write #N$01 to #R$5EA3.
 $A1ED LD ($5EA3),A   ; }
 $A1F0 SET 3,(IX+$08) ; Set bit 3 of the actor flags.
 $A1F4 RES 2,(IX+$08) ; Reset bit 2 of the actor flags.
@label=Handler_Pickup_Draw
*$A1F8 CALL $ABB4     ; Call #R$ABB4.
; Type #N$11 and above means Jetman is not on
; foot.
 $A1FB LD A,($6078)   ; Fetch #R$6078.
 $A1FE CP $11         ; {Return if Jetman's type is at least #N$11.
 $A200 RET NC         ; }
 $A201 BIT 2,(IX+$08) ; {Jump to #R$A15B if bit 2 of the actor flags is
 $A205 JP NZ,$A15B    ; set.}
 $A208 CALL $945C     ; Call #R$945C.
 $A20B JP NZ,$A12C    ; Jump to #R$A12C if the action key is pressed.
 $A20E RES 1,(IX+$08) ; Reset bit 1 of the actor flags.
; This entry point is used by the routine at #R$A0F8.
; .
; Teleport Jetman when SPACE is pressed beside this pickup.
@label=Handler_Pickup_Teleport
*$A212 LD A,($6078)   ; Fetch #R$6078.
 $A215 CP $11         ; {Return if Jetman's type is at least #N$11.
 $A217 RET NC         ; }
; Return unless Jetman is in range and SPACE is pressed.
 $A218 CALL $A4FC     ; Call #R$A4FC.
 $A21B RET NC         ; Return if the object is out of range.
 $A21C CALL $933E     ; Call #R$933E.
 $A21F RET Z          ; Return if SPACE is not pressed.
; Find the object to teleport to: the position at #R$60AA, unless this
; is the object at #R$60A8.
 $A220 PUSH IX        ; {Copy the slot pointer into #REGhl (using the
 $A222 POP HL         ; stack).}
 $A223 LD BC,$60A8    ; Set #REGbc to the slot-1 address #R$60A8.
 $A226 AND A          ; {Subtract the slot-1 address.
 $A227 SBC HL,BC      ; }
 $A229 JP Z,$A30A     ; Jump to #R$A30A if this is slot 1.
 $A22C LD A,($60AC)   ; Fetch #R$60AC.
 $A22F LD HL,($60AA)  ; Fetch #R$60AA.
; This entry point is used by the routine at #R$A30A.
; .
; Move Jetman onto the destination object's position and
; start the teleport.
@label=Handler_Pickup_Attach
*$A232 LD DE,($607C)  ; Fetch #R$607C into #REGde.
 $A236 LD ($607C),A   ; Write the destination Y over #R$607C.
 $A239 LD A,L         ; Fetch the low byte of the destination world X.
 $A23A AND %11111000  ; Keep only bits 3-7.
 $A23C LD L,A         ; Write it back.
 $A23D LD ($607A),HL  ; Write the pair to #R$607A.
; Record a Y near Jetman's old position for the debris burst.
 $A240 LD A,E         ; Fetch Jetman's old Y.
 $A241 SUB $0C        ; Subtract #N$0C.
 $A243 LD ($5E6A),A   ; Write it to #R$5E6A.
 $A246 LD A,($6078)   ; Fetch #R$6078.
; The actor type is a 1-based sprite ID. Decrease
; it to work on the 0-based index, reset bit 3 to
; switch from the walking frames to the flying
; frames, then write the 1-based ID back.
 $A249 DEC A          ; Decrease it to a 0-based sprite index.
 $A24A AND %11110111  ; Reset bit 3.
 $A24C INC A          ; Increase it by one.
 $A24D LD ($6078),A   ; Write it back.
 $A250 JP $A299       ; Jump to #R$A299.

; Fill Pickup Debris
;
; Used by the routines at #R$A299 and #R$A2CF.
; .
; Fill the #N$10 debris particles at #R$AA4B from the template at
; #R$AA13(#N$AA1B), using #R$5E6A as the starting Y of the burst.
@label=FillPickupDebris
c$A253 LD DE,$AA1B   ; #REGde=#R$AA13(#N$AA1B).
 $A256 LD HL,$AA4B   ; #REGhl=#R$AA4B.
 $A259 LD B,$10      ; Set a particle counter in #REGb for #N$10 loops.
; Fill each debris particle with a flag, the burst Y and template bytes.
@label=FillPickupDebris_Loop
*$A25B LD (HL),$80   ; Write #N$80 as the particle flag.
 $A25D INC HL        ; Move onto the particle Y.
 $A25E LD A,($5E6A)  ; Fetch #R$5E6A.
 $A261 LD (HL),A     ; Write it.
 $A262 INC HL        ; Move onto the next field.
 $A263 LD A,(DE)     ; {Copy the next template byte.
 $A264 INC DE        ; }
 $A265 LD (HL),A     ; {Write it and move on.
 $A266 INC HL        ; }
 $A267 LD A,(DE)     ; {Copy the next template byte.
 $A268 INC DE        ; }
 $A269 LD (HL),A     ; {Write it and move on.
 $A26A INC HL        ; }
 $A26B LD A,(DE)     ; {Copy the next template byte.
 $A26C INC DE        ; }
 $A26D LD (HL),A     ; {Write it and move on.
 $A26E INC HL        ; }
 $A26F DJNZ $A25B    ; Decrease the particle counter by one and loop
                     ; back to #R$A25B until all #N$10 are filled.
 $A271 RET           ; Return.

; Animate Pickup Debris
;
; Used by the routine at #R$A299.
; .
; Step the #N$10 debris particles at #R$AA4B, repeating until none of
; them is still moving (#R$5E69 is zero).
@label=AnimatePickupDebris
c$A272 XOR A         ; {Write #N$00 to #R$5E69.
 $A273 LD ($5E69),A  ; }
 $A276 LD A,($5E7B)  ; Fetch #R$5E7B.
 $A279 DEC A         ; Decrease it by one.
 $A27A LD ($5E7B),A  ; Write it back.
 $A27D CALL $B8F2    ; Call #R$B8F2.
; Step each of the #N$10 debris particles in turn.
 $A280 LD IX,$AA4B   ; #REGix=#R$AA4B.
 $A284 LD B,$10      ; Set a particle counter in #REGb for #N$10 loops.
@label=AnimatePickupDebris_CallParticle
*$A286 PUSH BC       ; Stash the particle counter on the stack.
 $A287 CALL $A993    ; Call #R$A993.
 $A28A LD BC,$0005   ; Set the step to the next particle in #REGbc to
                     ; #N($0005,$04,$04).
 $A28D ADD IX,BC     ; Move onto the next particle.
 $A28F POP BC        ; Restore the particle counter from the stack.
 $A290 DJNZ $A286    ; Decrease the particle counter by one and loop
                     ; back to #R$A286 until all #N$10 have moved.
; Go round again while particles are still moving, else return.
 $A292 LD A,($5E69)  ; Fetch #R$5E69.
 $A295 AND A         ; {Jump back to #R$A272 if any particles remain.
 $A296 JR NZ,$A272   ; }
 $A298 RET           ; Return.

; Start Teleport
;
; Used by the routine at #R$A1AA.
; .
; Play the briefing tune and burst debris around Jetman, then rebuild
; the play area at the new position and rejoin the actor loop at #R$81E1.
; This sets #R$5E68, so that #R$A2CF finishes the teleport.
@label=StartTeleport
c$A299 DI            ; Disable interrupts.
 $A29A LD DE,$BA2A   ; #REGde=#R$BA2A.
 $A29D CALL $B9BC    ; Call #R$B9BC.
 $A2A0 RST $38       ; Call the ROM interrupt routine at
                     ; #SKOOLKID$0038(MASK-INT).
; Run the first debris burst.
 $A2A1 XOR A         ; {Write #N$00 to #R$5E7B.
 $A2A2 LD ($5E7B),A  ; }
 $A2A5 CALL $A253    ; Call #R$A253.
 $A2A8 CALL $A272    ; Call #R$A272.
; Redraw Jetman's sprite, then run another debris burst.
 $A2AB LD IX,$6078   ; #REGix=#R$6078.
 $A2AF CALL $8640    ; Call #R$8640.
 $A2B2 CALL $A253    ; Call #R$A253.
 $A2B5 CALL $A272    ; Call #R$A272.
; Reset the laser beam slots and sprite caches, redraw the play area and
; rejoin the actor loop.
 $A2B8 CALL $A317    ; Call #R$A317.
 $A2BB LD A,$01      ; {Write #N$01 to #R$5E68.
 $A2BD LD ($5E68),A  ; }
 $A2C0 CALL $A2F5    ; Call #R$A2F5.
 $A2C3 CALL $B3A3    ; Call #R$B3A3.
 $A2C6 CALL $8BA5    ; Call #R$8BA5.
 $A2C9 CALL $9356    ; Call #R$9356.
 $A2CC JP $81E1      ; Jump to #R$81E1.

; Finish Teleport
;
; Used by the routine at #R$81BB.
; .
; Finish the teleport by bursting debris at Jetman's new position and
; clearing #R$5E68.
@label=FinishTeleport
c$A2CF LD A,($607C)  ; Fetch #R$607C.
 $A2D2 SUB $0C       ; Subtract #N$0C.
 $A2D4 LD ($5E6A),A  ; Write it to #R$5E6A.
 $A2D7 CALL $A253    ; Call #R$A253.
; Animate the burst, then save the particle positions to the template.
 $A2DA CALL $AA9B    ; Call #R$AA9B.
 $A2DD CALL $AB2F    ; Call #R$AB2F.
; Restore the template over the particles and animate it twice more.
 $A2E0 XOR A         ; {Write #N$00 to #R$5E7B.
 $A2E1 LD ($5E7B),A  ; }
 $A2E4 CALL $AB9D    ; Call #R$AB9D.
 $A2E7 CALL $AB48    ; Call #R$AB48.
 $A2EA CALL $AB9D    ; Call #R$AB9D.
 $A2ED CALL $AB48    ; Call #R$AB48.
 $A2F0 XOR A         ; {Write #N$00 to #R$5E68.
 $A2F1 LD ($5E68),A  ; }
 $A2F4 RET           ; Return.

; Clear Sprite Caches
;
; Used by the routines at #R$A299, #R$A826 and #R$B52E.
; .
; Write #N$00 over the cached sprite bytes (*#REGix+#N$09 to
; *#REGix+#N$0F) of each of the #N$18 actor slots, so that every actor is
; redrawn from scratch and no stale image is XORed off the redrawn screen.
; Bytes #N$00-#N$08 are the actor itself and bytes #N$10-#N$17 are state
; specific to its type, so they are left alone.
;
; .
;
; Start at byte #N$09 of the first slot, #R$6000(#N$6009).
@label=ClearSpriteCaches
c$A2F5 LD HL,$6009   ; #REGhl=#R$6000(#N$6009).
 $A2F8 LD BC,$0718   ; Set #REGb to #N$07 cache bytes per slot and #REGc to
                     ; #N$18 slots.
 $A2FB LD DE,$0011   ; #REGde=#N($0011,$04,$04).
; Clear the seven cache bytes of each slot in turn.
@label=ClearSpriteCaches_Loop
*$A2FE PUSH BC       ; Stash #REGbc on the stack.
@label=ClearSpriteCaches_WriteByte
*$A2FF LD (HL),$00   ; Write #N$00 to the current cache byte.
 $A301 INC HL        ; Move onto the next cache byte.
 $A302 DJNZ $A2FF    ; Decrease the inner counter by one and loop back
                     ; to #R$A2FF until this slot is clear.
 $A304 ADD HL,DE     ; Skip the rest of the slot.
 $A305 POP BC        ; Restore #REGbc from the stack.
 $A306 DEC C         ; Decrease #REGc by one.
 $A307 JR NZ,$A2FE   ; Jump back to #R$A2FE until #REGc is zero.
 $A309 RET           ; Return.

; Resume Pickup
;
; Used by the routine at #R$A1AA.
; .
; Rejoin the teleport at #R$A232 using world slot 2's position.
;
; .
;
; Teleport using world slot 2's position.
@label=ResumePickup
c$A30A LD HL,($60C2) ; Fetch #R$60C2.
 $A30D LD A,($60C4)  ; Fetch #R$60C4.
 $A310 JP $A232      ; Jump to #R$A232.

; Pickup Colours
;
; Four colour bytes. #R$A1AA writes one to the
; actor attribute each frame.
@label=Pickup_Colours
b$A313 DEFB $47      ; #COLOUR(#PEEK(#PC)).
 $A314 DEFB $44      ; #COLOUR(#PEEK(#PC)).
 $A315 DEFB $45      ; #COLOUR(#PEEK(#PC)).
 $A316 DEFB $46      ; #COLOUR(#PEEK(#PC)).

; Handler: Reset Laser Beam Slots
;
; Used by the routines at #R$A299, #R$A826 and #R$B52E.
; .
; Clears the four laser beam slots from #R$6000 by writing #N$00
; to the first byte of each #N$18-byte slot.
;
; .
;
; See #R$9DC6 for the handler which actions "searching" for a free slot.
@label=Handler_ResetLaserBeamSlots
c$A317 LD HL,$6000   ; #REGhl=#R$6000.
 $A31A LD DE,$0018   ; #REGde=#N($0018,$04,$04).
 $A31D LD B,$04      ; Set a slot counter in #REGb for #N$04 loops.
@label=ResetLaserBeamSlots_Loop
*$A31F LD (HL),$00   ; Write #N$00 to *#REGhl.
 $A321 ADD HL,DE     ; #REGhl=#REGhl+#REGde.
 $A322 DJNZ $A31F    ; Decrease the counter by one and jump back to
                     ; #R$A31F until it is zero.
 $A324 RET           ; Return.

; Handler: World Object
;
; Route a fuel pod, bomb or pickup through collect, drop and
; action-key tests.
;
; IX Actor slot
;
; Reset the drop bit unless the action key is held.
@label=Handler_WorldObject
c$A325 CALL $945C     ; {Jump to #R$A32E if the action key is pressed.
 $A328 JR NZ,$A32E    ; }
 $A32A RES 1,(IX+$08) ; Reset bit 1 of the actor flags.
; Dispatch on carried, attached or free-in-world.
@label=Handler_WorldObject_DispatchFlags
*$A32E BIT 2,(IX+$08) ; {Jump to #R$A3FF if bit 2 of the actor flags is
 $A332 JP NZ,$A3FF    ; set.}
 $A335 BIT 0,(IX+$08) ; {Jump to #R$A3C1 if bit 0 of the actor flags is
 $A339 JP NZ,$A3C1    ; set.}
; Settle the object on the ground, then attach it if the
; rover is free and in range.
 $A33C CALL $A522     ; Call #R$A522.
 $A33F LD A,($5EA3)   ; Fetch #R$5EA3.
 $A342 AND A          ; {Jump to #R$A34A if the rover is already carrying.
 $A343 JR NZ,$A34A    ; }
 $A345 CALL $A4BA     ; Call #R$A4BA.
 $A348 JR C,$A39C     ; Jump to #R$A39C if the object is in range.
; On action, attach this object if Jetman can collect it.
@label=Handler_WorldObject_TestAction
*$A34A BIT 1,(IX+$08) ; {Jump to #R$A375 if bit 1 of the actor flags is
 $A34E JR NZ,$A375    ; set.}
 $A350 CALL $945C     ; Call #R$945C.
 $A353 JR Z,$A375     ; Jump to #R$A375 if the action key is not pressed.
 $A355 LD A,($6078)   ; Fetch #R$6078.
; Type #N$11 and above means Jetman is not on
; foot.
 $A358 CP $11         ; {Jump to #R$A375 if Jetman's type is at least
 $A35A JR NC,$A375    ; #N$11.}
 $A35C CALL $A4FC     ; Call #R$A4FC.
 $A35F JR NC,$A375    ; Jump to #R$A375 if the object is out of range.
; Mark Jetman as carrying and flag the object as held.
 $A361 LD HL,$6080    ; #REGhl=#R$6080.
 $A364 BIT 0,(HL)     ; {Jump to #R$A375 if bit 0 is set.
 $A366 JR NZ,$A375    ; }
 $A368 SET 0,(HL)     ; Set bit 0 of #R$6080.
 $A36A SET 0,(IX+$08) ; Set bit 0 of the actor flags.
 $A36E SET 1,(IX+$08) ; Set bit 1 of the actor flags.
 $A372 CALL $B8BD     ; Call #R$B8BD.
; This entry point is used by the routines at #R$A378, #R$A39C and #R$A3C1.
@label=Handler_WorldObject_Loop
*$A375 JP $ABB4       ; Jump to #R$ABB4.

; Release Carried Item
;
; Used by the routine at #R$A3C1.
; .
; Clear the carried-item bits, store the throw speed and play
; #R$B8C3.
;
; IX Actor slot
;
; Clear the carried-item bits and store the throw speed.
@label=ReleaseCarriedItem
c$A378 RES 0,(IX+$08)  ; Reset bit 0 of *#REGix+#N$08.
 $A37C SET 1,(IX+$08)  ; Set bit 1 of *#REGix+#N$08.
 $A380 LD HL,$6080     ; #REGhl=#R$6080.
 $A383 RES 0,(HL)      ; Reset bit 0 of *#REGhl.
; Set the throw speed from Jetman's speed, then play the drop sound.
 $A385 LD A,($607D)    ; Fetch #R$607D.
 $A388 SRA A           ; {Divide #REGa by #N$10.
 $A38A SRA A           ;
 $A38C SRA A           ;
 $A38E SRA A           ; }
 $A390 LD (IX+$05),A   ; Write #REGa to *#REGix+#N$05.
 $A393 LD (IX+$06),$01 ; Write #N$01 to *#REGix+#N$06.
 $A397 CALL $B8C3      ; Call #R$B8C3.
 $A39A JR $A375        ; Jump to #R$A375.

; Attach Carried Item
;
; Used by the routine at #R$A325.
; .
; Mark the object as carried and set #R$5EA3.
;
; IX Actor slot
;
; Mark the object as carried and set #R$5EA3.
@label=AttachCarriedItem
c$A39C SET 2,(IX+$08) ; Set bit 2 of the actor flags.
 $A3A0 LD A,$01       ; {Write #N$01 to #R$5EA3.
 $A3A2 LD ($5EA3),A   ; }
; Record in the actor flags which way the rover faces.
 $A3A5 LD A,($6090)   ; Fetch #R$6090.
 $A3A8 CP $22         ; Compare it against #N$22.
 $A3AA LD A,$00       ; #REGa=#N$00.
 $A3AC JR C,$A3B0     ; Jump to #R$A3B0 if the rover type is below
                      ; #N$22.
 $A3AE ADD A,$08      ; Add #N$08.
; Keep the facing bit from the actor type and merge it into the flags.
@label=AttachCarriedItem_KeepBit3
*$A3B0 XOR (IX+$00)   ; XOR it with the actor type.
 $A3B3 AND %00001000  ; Keep only bit 3.
 $A3B5 LD C,A         ; Stash that bit in #REGc.
 $A3B6 LD A,(IX+$08)  ; Fetch the actor flags.
 $A3B9 AND %11110111  ; Reset bit 3.
 $A3BB OR C           ; Merge the rover-facing bit back in.
 $A3BC LD (IX+$08),A  ; Write the flags back.
 $A3BF JR $A375       ; Jump to #R$A375.

; Place Carried Item
;
; Used by the routine at #R$A325.
; .
; On action, snap the object to the ground using the terrain
; under Jetman.
;
; IX Actor slot
;
; On action, snap the object to the ground under Jetman.
@label=PlaceCarriedItem
c$A3C1 CALL $945C     ; Call #R$945C.
 $A3C4 JR Z,$A3D3     ; Jump to #R$A3D3 if the action key is not pressed.
 $A3C6 BIT 1,(IX+$08) ; {Jump to #R$A3D3 if bit 1 of the actor flags is
 $A3CA JR NZ,$A3D3    ; set.}
 $A3CC CALL $91BB     ; Call #R$91BB.
 $A3CF LD A,D         ; Fetch the first terrain byte under the object.
 $A3D0 AND A          ; {Jump to #R$A378 if that cell is not empty.
 $A3D1 JR NZ,$A378    ; }
; Bit 2 of Jetman's 0-based sprite index is
; facing. Copy that into bit 3 of this object.
@label=PlaceCarriedItem_Facing
*$A3D3 LD A,($6078)   ; Fetch #R$6078.
 $A3D6 DEC A          ; Decrease it to a 0-based sprite index.
 $A3D7 AND %00000100  ; Keep only the facing bit.
 $A3D9 JR NZ,$A3F9    ; Jump to #R$A3F9 if Jetman is facing right.
 $A3DB RES 3,(IX+$00) ; Reset bit 3 of the actor type.
; Place the object at Jetman's X, just below his Y.
@label=PlaceCarriedItem_Loop
*$A3DF LD HL,($607A)  ; Fetch #R$607A.
 $A3E2 LD (IX+$02),L  ; Write the low byte as the object world X.
 $A3E5 LD (IX+$03),H  ; Write the high byte.
 $A3E8 LD A,($607C)   ; Fetch #R$607C.
 $A3EB ADD A,$08      ; Add #N$08.
 $A3ED CP $AF         ; {Jump to #R$A3F3 if that is still above the
 $A3EF JR C,$A3F3     ; ground line.}
; #N$AF is the ground line.
 $A3F1 LD A,$AF       ; #REGa=#N$AF.
@label=PlaceCarriedItem_WriteY
*$A3F3 LD (IX+$04),A  ; Write it as the object Y.
 $A3F6 JP $A375       ; Jump to #R$A375.
@label=PlaceCarriedItem_SetBit3
*$A3F9 SET 3,(IX+$00) ; Set bit 3 of the actor type.
 $A3FD JR $A3DF       ; Jump to #R$A3DF.

; Handler: Held Object
;
; Used by the routine at #R$A325.
; .
; While #R$6090 is a rover frame, test action to let Jetman
; take this object off the rover and clear #R$5EA3.
;
; IX Actor slot
@label=Handler_HeldObject
c$A3FF LD A,($6090)   ; Fetch #R$6090.
 $A402 SUB $1A        ; Subtract #N$1A.
 $A404 CP $10         ; {Jump to #R$A45A if that is not a rover frame.
 $A406 JR NC,$A45A    ; }
; Let Jetman take the object off the rover when the action
; key is pressed beside it.
 $A408 BIT 1,(IX+$08) ; {Jump to #R$A431 if bit 1 of the actor flags is
 $A40C JR NZ,$A431    ; set.}
 $A40E CALL $945C     ; Call #R$945C.
 $A411 JR Z,$A431     ; Jump to #R$A431 if the action key is not pressed.
 $A413 CALL $A4FC     ; Call #R$A4FC.
 $A416 JR NC,$A431    ; Jump to #R$A431 if the object is out of range.
; Take the object: clear #R$5EA3 and mark Jetman as carrying.
 $A418 XOR A          ; {Write #N$00 to #R$5EA3.
 $A419 LD ($5EA3),A   ; }
 $A41C LD A,($6080)   ; Fetch #R$6080.
 $A41F OR %00000001   ; Set bit 0.
 $A421 LD ($6080),A   ; Write it back.
; Mark the object as held by Jetman and play the pickup sound.
 $A424 LD A,(IX+$08)  ; Fetch the actor flags.
 $A427 AND %11110000  ; Keep only bits 4-7.
 $A429 OR %00000011   ; Set bits 0-1.
 $A42B LD (IX+$08),A  ; Write the flags back.
 $A42E CALL $B8BD     ; Call #R$B8BD.
; This entry point is used by the routines at #R$A0F8 and #R$B6EC.
; .
; Hang the object off the rover.
@label=Handler_HeldObject_Loop
*$A431 LD A,($6090)   ; Fetch #R$6090.
 $A434 CP $22         ; {Jump to #R$A450 if the rover type is below
 $A436 JR C,$A450     ; #N$22.}
 $A438 LD BC,$FFF4    ; Set the offset in #REGbc to #N$FFF4 (-#N$0C).
@label=Handler_HeldObject_FetchRoverX
*$A43B LD HL,($6092)  ; Fetch #R$6092.
; This entry point is used by the routines at #R$A0F8 and #R$B6EC.
; .
; Place the object at the base X plus the offset, above the rover Y, and
; draw it.
@label=Handler_HeldObject_WriteX
*$A43E ADD HL,BC      ; Add the offset.
 $A43F LD (IX+$02),L  ; Write the low byte as the object world X.
 $A442 LD (IX+$03),H  ; Write the high byte.
 $A445 LD A,($6094)   ; Fetch the rover Y.
 $A448 SUB $16        ; Subtract #N$16.
 $A44A LD (IX+$04),A  ; Write it as the object Y.
 $A44D JP $ABB4       ; Jump to #R$ABB4.
@label=Handler_HeldObject_OnFootOffset
*$A450 LD BC,$0012    ; Set the offset in #REGbc to #N($0012,$04,$04).
 $A453 JR $A43B       ; Jump to #R$A43B.
@label=Handler_HeldObject_AdvanceFrame
*$A455 CALL $A48D     ; Call #R$A48D.
 $A458 JR $A46F       ; Jump to #R$A46F.
; Cycle the held-object frame from UP.
@label=Handler_HeldObject_CycleFromUp
*$A45A CALL $A579     ; Call #R$A579.
 $A45D LD A,($5E42)   ; Fetch #R$5E42.
 $A460 AND %00000001  ; Keep only bit 0.
 $A462 JR NZ,$A46F    ; Jump to #R$A46F if this is an odd frame.
 $A464 CALL $8F90     ; Call #R$8F90.
 $A467 LD D,A         ; Stash the controls in #REGd.
 $A468 BIT 3,D        ; {Jump to #R$A455 if UP is pressed.
 $A46A JR Z,$A455     ; }
 $A46C CALL $A4A0     ; Call #R$A4A0.
; Type #N$16 and above is seated facing right;
; hang the object on the left.
@label=Handler_HeldObject_PickOffset
*$A46F LD A,($6078)   ; Fetch #R$6078.
 $A472 CP $16         ; {Jump to #R$A483 if Jetman's type is less than
 $A474 JR C,$A483     ; #N$16.}
 $A476 LD A,$08       ; #REGa=#N$08.
 $A478 CALL $A4AA     ; Call #R$A4AA.
 $A47B LD BC,$FFF4    ; Set the offset in #REGbc to #N$FFF4 (-#N$0C).
@label=Handler_HeldObject_FetchJetmanX
*$A47E LD HL,($607A)  ; Fetch #R$607A.
 $A481 JR $A43E       ; Jump to #R$A43E.
; Hang the object on the right when the type is below #N$16.
@label=Handler_HeldObject_ClearBit3
*$A483 LD A,$00       ; #REGa=#N$00.
 $A485 CALL $A4AA     ; Call #R$A4AA.
 $A488 LD BC,$0012    ; Set the offset in #REGbc to #N($0012,$04,$04).
 $A48B JR $A47E       ; Jump to #R$A47E.
; Advance the low three bits of the actor type.
@label=Handler_HeldObject_NextFrame
*$A48D LD A,(IX+$00)  ; Fetch the actor type.
 $A490 LD C,A         ; Stash it in #REGc.
 $A491 AND %00000111  ; Keep only bits 0-2.
 $A493 CP $07         ; {Return if those bits are already #N$07.
 $A495 RET Z          ; }
 $A496 INC A          ; Increase the frame by one.
; Write the new frame back into the low three bits of the type.
@label=Handler_HeldObject_MergeType
*$A497 LD B,A         ; Stash the new frame in #REGb.
 $A498 LD A,C         ; Copy the original type into #REGa.
 $A499 AND %11111000  ; Keep only bits 3-7.
 $A49B OR B           ; Merge the new frame back in.
 $A49C LD (IX+$00),A  ; Write it to the actor type.
 $A49F RET            ; Return.
; Step the low three bits of the actor type back.
@label=Handler_HeldObject_PreviousFrame
*$A4A0 LD A,(IX+$00)  ; Fetch the actor type.
 $A4A3 LD C,A         ; Stash it in #REGc.
 $A4A4 AND %00000111  ; Keep only bits 0-2.
 $A4A6 RET Z          ; Return if the frame is already zero.
 $A4A7 DEC A          ; Decrease the frame by one.
 $A4A8 JR $A497       ; Jump to #R$A497.
; XOR #REGa with the actor flags and write bit 3 of the
; result to bit 3 of the actor type.
@label=Handler_HeldObject_CopyFlagBit
*$A4AA XOR (IX+$08)   ; XOR #REGa with the actor flags.
 $A4AD AND %00001000  ; Keep only bit 3.
 $A4AF LD C,A         ; Stash that bit in #REGc.
 $A4B0 LD A,(IX+$00)  ; Fetch the actor type.
 $A4B3 AND %11110111  ; Reset bit 3.
 $A4B5 OR C           ; Merge the flag bit back in.
 $A4B6 LD (IX+$00),A  ; Write it to the actor type.
 $A4B9 RET            ; Return.

; Compare Actor Distance
;
; Used by the routines at #R$A1AA, #R$A325 and #R$B810.
; .
; Return carry if this actor is close enough to the rover
; to collect.
;
;   IX Actor slot
; O:F Carry if this actor is in range
;
; Return carry if this actor is close enough to the rover.
@label=CompareActorDistance
c$A4BA LD L,(IX+$02) ; Fetch the actor world X.
 $A4BD LD H,(IX+$03) ; Fetch the high byte.
 $A4C0 ADD HL,HL     ; {Multiply it by #N$08.
 $A4C1 ADD HL,HL     ;
 $A4C2 ADD HL,HL     ; }
 $A4C3 LD C,L        ; {Copy it into #REGbc.
 $A4C4 LD B,H        ; }
; Work out the horizontal distance between the rover and
; the actor.
 $A4C5 LD HL,($6092) ; Fetch #R$6092.
 $A4C8 ADD HL,HL     ; {Multiply it by #N$08.
 $A4C9 ADD HL,HL     ;
 $A4CA ADD HL,HL     ; }
 $A4CB AND A         ; {Subtract the actor world X.
 $A4CC SBC HL,BC     ; }
; Make the difference positive.
 $A4CE LD A,H        ; Fetch the high byte of the difference.
 $A4CF AND A         ; {Jump to #R$A4D6 if the result is positive.
 $A4D0 JP P,$A4D6    ; }
 $A4D3 CALL $8947    ; Call #R$8947.
; Return if the actor is outside the collect range.
@label=CompareActorDistance_TestRange
*$A4D6 LD BC,$00C0   ; Set the collect range in #REGbc to #N($00C0,$04,$04).
 $A4D9 AND A         ; {Subtract the collect range.
 $A4DA SBC HL,BC     ; }
 $A4DC RET NC        ; Return if the actor is too far away.
; Compare the rover's height against the actor's Y.
 $A4DD LD A,($6094)  ; Fetch the rover Y.
 $A4E0 DEC A         ; Decrease it by one.
 $A4E1 SUB (IX+$04)  ; Subtract the actor Y.
 $A4E4 CP $16        ; Compare it against #N$16.
 $A4E6 RET           ; Return.

; Test Jetman Action
;
; Used by the routines at #R$B6EC and #R$B785.
; .
; Return whether Jetman can collect, using his type and the
; action key.
;
; IX Actor slot
;
; Return unless Jetman can collect and action is pressed.
; Type #N$11 and above means Jetman is not on foot.
@label=TestJetmanAction
c$A4E7 LD A,($6078)   ; Fetch #R$6078.
 $A4EA CP $11         ; {Return if Jetman's type is at least #N$11.
 $A4EC RET NC         ; }
 $A4ED CALL $945C     ; Call #R$945C.
 $A4F0 RET Z          ; Return if the action key is not pressed.
 $A4F1 LD A,($6080)   ; Fetch #R$6080.
 $A4F4 AND %00000001  ; Keep only bit 0.
 $A4F6 RET NZ         ; Return if Jetman is already carrying.
 $A4F7 BIT 7,(IX+$08) ; {Return if bit 7 of the actor flags is set.
 $A4FB RET NZ         ; }
; This entry point is used by the routines at #R$A0F8, #R$A1AA, #R$A325 and
; #R$A3FF.
; .
; Compare this actor against #R$607A and #R$607C.
@label=TestJetmanAction_ComparePosition
*$A4FC LD L,(IX+$02)  ; Fetch the actor world X.
 $A4FF LD H,(IX+$03)  ; Fetch the high byte.
 $A502 LD BC,$0008    ; {Add an #N$08 offset.
 $A505 ADD HL,BC      ; }
; Return unless Jetman is horizontally close to the actor.
 $A506 LD BC,($607A)  ; Fetch #R$607A.
 $A50A AND A          ; {Subtract Jetman's world X.
 $A50B SBC HL,BC      ; }
 $A50D LD A,H         ; Fetch the high byte of the difference.
 $A50E AND %00011111  ; Keep only bits 0-4.
 $A510 RET NZ         ; Return if the actor is on a different screen.
 $A511 LD A,L         ; Fetch the low byte.
 $A512 CP $10         ; {Return if it is at least #N$10.
 $A514 RET NC         ; }
; Test whether Jetman is vertically within reach of the actor.
 $A515 LD A,($607C)   ; Fetch #R$607C.
 $A518 SUB $08        ; Subtract #N$08.
 $A51A SUB (IX+$04)   ; Subtract the actor Y.
 $A51D NEG            ; Negate the difference.
 $A51F CP $18         ; Compare it against #N$18.
 $A521 RET            ; Return.

; Clamp Object To Ground
;
; Used by the routines at #R$A1AA and #R$A325.
; .
; Tick the object timer and stop it at Y=#N$AF.
;
; IX Actor slot
;
; Tick the object timer and clamp Y to the ground line.
@label=ClampObjectToGround
c$A522 CALL $B89A      ; Call #R$B89A.
 $A525 CALL $B6AE      ; Call #R$B6AE.
 $A528 CP $AF          ; {Jump to #R$A536 if the object is still above the
 $A52A JR C,$A536      ; ground line.}
 $A52C LD (IX+$06),$00 ; {Write #N$00 to the thrust and the speed.
 $A530 LD (IX+$05),$00 ; }
 $A534 LD A,$AF        ; #REGa=#N$AF.
@label=ClampObjectToGround_WriteY
*$A536 LD (IX+$04),A   ; Write it as the object Y.
 $A539 RET             ; Return.

; Spawn Linked Object
;
; Used by the routine at #R$B128.
; .
; If the next actor slot is free, write type #N$C8 into it
; and copy a speed and thrust pair from #R$A68B.
;
; IX Actor slot
;
; Write type #N$C8 into the next slot if it is free.
@label=SpawnLinkedObject
c$A53A PUSH IX       ; {Copy the slot pointer into #REGhl (using the
 $A53C POP HL        ; stack).}
 $A53D LD DE,$0018   ; #REGde=#N($0018,$04,$04).
 $A540 ADD HL,DE     ; Move onto the next slot.
 $A541 LD A,(HL)     ; {Return if that slot is already in use.
 $A542 AND A         ;
 $A543 RET NZ        ; }
 $A544 LD (HL),$C8   ; Write type #N$C8.
 $A546 INC HL        ; {Move onto the new world X.
 $A547 INC HL        ; }
 $A548 EX DE,HL      ; Switch the destination into #REGde.
; Select a speed and thrust pair from #R$A68B for the new slot.
 $A549 LD A,($5E42)  ; Fetch #R$5E42.
 $A54C LD C,A        ; Stash it in #REGc.
 $A54D LD A,($5E40)  ; Fetch #R$5E40.
 $A550 ADD A,C       ; Add the timer.
 $A551 LD ($5E40),A  ; Write it back to #R$5E40.
; Use bits 2-5 of the timer to index the table.
 $A554 LD A,($5E40)  ; Fetch #R$5E40.
 $A557 AND %00111100 ; Keep only bits 2-5.
 $A559 LD C,A        ; {Create an offset in #REGbc.
 $A55A LD B,$00      ; }
 $A55C LD HL,$A68B   ; #REGhl=#R$A68B.
 $A55F ADD HL,BC     ; Add the offset.
 $A560 INC HL        ; {Skip the X and Y offsets to reach the speed in the
 $A561 INC HL        ; table.}
; Place the new object beside and above this one.
 $A562 LD A,(IX+$02) ; Fetch the actor world X.
 $A565 ADD A,$08     ; Add #N$08.
 $A567 LD (DE),A     ; Write it as the new world X.
; Carry the addition into the high byte of the new world X.
 $A568 INC DE        ; Move onto the high byte.
 $A569 LD A,(IX+$03) ; Fetch the actor world X high byte.
 $A56C ADC A,$00     ; Add the carry.
 $A56E AND %00011111 ; Keep only bits 0-4.
 $A570 LD (DE),A     ; Write the high byte.
; Put the new Y #N$10 above the actor Y.
 $A571 INC DE        ; Move onto the new Y.
 $A572 LD A,(IX+$04) ; Fetch the actor Y.
 $A575 SUB $10       ; Subtract #N$10.
 $A577 JR $A5C8      ; Jump to #R$A5C8.

; Handler: Player Shot
;
; Used by the routine at #R$A3FF.
; .
; On a 1-in-4 frame, spawn a shot into a free laser slot
; when FIRE is held, then fly any live shots.
;
; IX Actor slot
@label=Handler_PlayerShot
c$A579 LD A,($5E42)                         ; Fetch #R$5E42.
 $A57C AND %00000011                        ; Keep only bits 0-1.
 $A57E RET NZ                               ; Return if this is not a 4th
                                            ; frame.
 $A57F CALL $8F90                           ; Call #R$8F90.
 $A582 BIT 4,A                              ; {Return if FIRE is not pressed.
 $A584 RET NZ                               ; }
; Look for a free laser slot.
 $A585 LD HL,$6000                          ; #REGhl=#R$6000.
 $A588 LD DE,$0018                          ; #REGde=#N($0018,$04,$04).
 $A58B LD B,$02                             ; Set a slot counter in #REGb for
                                            ; #N$02 loops.
@label=Handler_PlayerShot_Loop
*$A58D LD A,(HL)                            ; {Jump to #R$A595 if this slot is
 $A58E AND A                                ; free.
 $A58F JR Z,$A595                           ; }
 $A591 ADD HL,DE                            ; Move onto the next slot.
 $A592 DJNZ $A58D                           ; Decrease the slot counter by one and loop back
                                            ; to #R$A58D until both slots have been tried.
 $A594 RET                                  ; Return.
; Initialise a new shot from the current actor.
@label=Handler_PlayerShot_Initialise
*$A595 PUSH HL                              ; Stash the free slot on the stack.
 $A596 CALL $B960                           ; Call #R$B960.
 $A599 POP HL                               ; Restore the free slot from the
                                            ; stack.
 $A59A LD (HL),$58                          ; Write type #N$58.
 $A59C INC HL                               ; {Move onto the new world X.
 $A59D INC HL                               ; }
 $A59E EX DE,HL                             ; Switch the destination into
                                            ; #REGde.
; Look up this actor's entry in the shot table at #R$A68B.
 $A59F LD A,(IX+$00)                        ; Fetch the actor type.
 $A5A2 RLCA                                 ; {Rotate it left twice.
 $A5A3 RLCA                                 ; }
 $A5A4 AND %00111100                        ; Keep only bits 2-5.
 $A5A6 LD C,A                               ; {Create an offset in #REGbc.
 $A5A7 LD B,$00                             ; }
 $A5A9 LD HL,$A68B                          ; #REGhl=#R$A68B.
 $A5AC ADD HL,BC                            ; Add the offset.
; Add the table X offset to the actor world X.
 $A5AD LD A,(HL)                            ; Fetch the X offset.
 $A5AE LD B,$00                             ; Clear #REGb.
 $A5B0 AND A                                ; {Jump to #R$A5B5 if the offset is
 $A5B1 JP P,$A5B5                           ; positive.}
 $A5B4 DEC B                                ; Sign-extend into #REGb.
@label=Handler_PlayerShot_AddWorldX
*$A5B5 ADD A,(IX+$02)                       ; Add the actor world X.
 $A5B8 INC HL                               ; Move onto the next table byte.
 $A5B9 LD (DE),A                            ; Write the new world X.
 $A5BA INC DE                               ; Move onto the high byte.
; Work out the high byte of the new world X and the new Y.
 $A5BB LD A,(IX+$03)                        ; Fetch the actor world X high
                                            ; byte.
 $A5BE ADC A,B                              ; Add the sign.
 $A5BF AND %00011111                        ; Keep only bits 0-4.
 $A5C1 LD (DE),A                            ; Write the high byte.
 $A5C2 INC DE                               ; Move onto the new Y.
 $A5C3 LD A,(IX+$04)                        ; Fetch the actor Y.
 $A5C6 ADD A,(HL)                           ; Add the table Y offset.
 $A5C7 INC HL                               ; Move onto the next table byte.
; This entry point is used by the routine at #R$A53A.
; .
; Write the remaining shot fields and clear the rest
; of the slot.
@label=Handler_PlayerShot_WriteFields
*$A5C8 LD (DE),A                            ; Write the new Y.
 $A5C9 INC DE                               ; Move onto the speed.
 $A5CA LD A,(HL)                            ; {Copy the next table byte.
 $A5CB INC HL                               ; }
 $A5CC LD (DE),A                            ; {Write it and move on.
 $A5CD INC DE                               ; }
 $A5CE LD A,(HL)                            ; {Copy the next table byte.
 $A5CF INC HL                               ; }
 $A5D0 LD (DE),A                            ; {Write it and move on.
 $A5D1 INC DE                               ; }
; Pick the shot colour from the timer at #R$5E40.
 $A5D2 LD A,($5E40)                         ; Fetch #R$5E40.
 $A5D5 AND %00000011                        ; Keep only bits 0-1.
 $A5D7 LD BC,$A5EF                          ; Point #REGbc at the shot colour
                                            ; table at #R$A5EF.
 $A5DA ADD A,C                              ; Add the colour index.
 $A5DB LD C,A                               ; Copy the low byte into #REGc.
 $A5DC LD A,B                               ; Fetch the high byte.
 $A5DD ADC A,$00                            ; Add the carry.
 $A5DF LD B,A                               ; Write it back to #REGb.
 $A5E0 LD A,(BC)                            ; Fetch the colour.
 $A5E1 LD (DE),A                            ; Write it to the shot colour.
 $A5E2 INC DE                               ; Move onto the next field.
 $A5E3 LD A,$20                             ; #REGa=#N$20.
 $A5E5 LD (DE),A                            ; Write it.
 $A5E6 INC DE                               ; Move on.
; Clear the remaining #N$0F bytes of the slot.
 $A5E7 LD B,$0F                             ; Set a byte counter in #REGb for
                                            ; #N$0F loops.
 $A5E9 XOR A                                ; Clear #REGa.
@label=Handler_PlayerShot_ClearTail
*$A5EA LD (DE),A                            ; Write #N$00.
 $A5EB INC DE                               ; Move onto the next byte.
 $A5EC DJNZ $A5EA                           ; Decrease the byte counter by one and loop back
                                            ; to #R$A5EA until the slot tail is clear.
 $A5EE RET                                  ; Return.
; The four colours a player shot can be.
@label=Handler_PlayerShot_Colours
 $A5EF DEFB $44                             ; #COLOUR(#PEEK(#PC)).
; The four colours a player shot can be.
 $A5F0 DEFB $45                             ; #COLOUR(#PEEK(#PC)).
; The four colours a player shot can be.
 $A5F1 DEFB $46                             ; #COLOUR(#PEEK(#PC)).
; The four colours a player shot can be.
 $A5F2 DEFB $47                             ; #COLOUR(#PEEK(#PC)).
; Advance the shot world X from the packed nibble
; at *#REGix+#N$10.
@label=Handler_PlayerShot_AdvanceX
*$A5F3 ADD A,(IX+$10)                       ; Add the X nibble.
 $A5F6 LD C,A                               ; Stash the sum in #REGc.
 $A5F7 AND %00001111                        ; Keep only bits 0-3.
 $A5F9 LD (IX+$10),A                        ; Write it back as the X nibble.
 $A5FC LD A,C                               ; Copy the sum into #REGa.
 $A5FD RRCA                                 ; {Rotate the high nibble down into
 $A5FE RRCA                                 ; bits 0-3.
 $A5FF RRCA                                 ;
 $A600 RRCA                                 ; }
 $A601 AND %00001111                        ; Keep only bits 0-3.
 $A603 LD B,$00                             ; Clear #REGb.
 $A605 JR $A63E                             ; Jump to #R$A63E.
; Advance the shot Y from the packed nibble at
; *#REGix+#N$11.
@label=Handler_PlayerShot_AdvanceY
*$A607 ADD A,(IX+$11)                       ; Add the Y nibble.
 $A60A LD C,A                               ; Stash the sum in #REGc.
 $A60B AND %00001111                        ; Keep only bits 0-3.
 $A60D LD (IX+$11),A                        ; Write it back as the Y nibble.
 $A610 LD A,C                               ; Copy the sum into #REGa.
 $A611 RRCA                                 ; {Rotate the high nibble down into
 $A612 RRCA                                 ; bits 0-3.
 $A613 RRCA                                 ;
 $A614 RRCA                                 ; }
 $A615 AND %00001111                        ; Keep only bits 0-3.
 $A617 JR $A66A                             ; Jump to #R$A66A.
; Count down the shot timer and work out the X step from
; the shot speed.
@label=Handler_PlayerShot_Fly
 $A619 DEC (IX+$08)                         ; Decrease the shot timer by one.
 $A61C JP Z,$A73C                           ; Jump to #R$A73C if it has
                                            ; expired.
 $A61F LD A,(IX+$05)                        ; Fetch the shot speed.
 $A622 AND A                                ; {Jump to #R$A5F3 if the speed is
 $A623 JP P,$A5F3                           ; positive.}
; Work out a negative X step when the speed is negative.
 $A626 ADD A,(IX+$10)                       ; Add the X nibble.
 $A629 LD C,A                               ; Stash the sum in #REGc.
 $A62A AND %00001111                        ; Keep only bits 0-3.
 $A62C NEG                                  ; Negate it.
 $A62E LD (IX+$10),A                        ; Write it back as the X nibble.
 $A631 LD A,C                               ; Copy the sum into #REGa.
 $A632 NEG                                  ; Negate it.
 $A634 RRCA                                 ; {Rotate the high nibble down into
 $A635 RRCA                                 ; bits 0-3.
 $A636 RRCA                                 ;
 $A637 RRCA                                 ; }
 $A638 AND %00001111                        ; Keep only bits 0-3.
 $A63A NEG                                  ; Negate it.
 $A63C LD B,$FF                             ; #REGb=#N$FF.
; Add the X step to the shot's world X.
@label=Handler_PlayerShot_WriteX
*$A63E ADD A,(IX+$02)                       ; Add the step to the world X.
 $A641 LD (IX+$02),A                        ; Write it back.
 $A644 LD A,(IX+$03)                        ; Fetch the high byte.
 $A647 ADC A,B                              ; Add the sign.
 $A648 AND %00011111                        ; Keep only bits 0-4.
 $A64A LD (IX+$03),A                        ; Write the high byte back.
; Work out the Y step from the shot thrust.
 $A64D LD A,(IX+$06)                        ; Fetch the shot thrust.
 $A650 AND A                                ; {Jump to #R$A607 if the thrust is
 $A651 JP P,$A607                           ; positive.}
; Work out a negative Y step when the thrust is negative.
 $A654 ADD A,(IX+$11)                       ; Add the Y nibble.
 $A657 LD C,A                               ; Stash the sum in #REGc.
 $A658 AND %00001111                        ; Keep only bits 0-3.
 $A65A NEG                                  ; Negate it.
 $A65C LD (IX+$11),A                        ; Write it back as the Y nibble.
 $A65F LD A,C                               ; Copy the sum into #REGa.
 $A660 NEG                                  ; Negate it.
 $A662 RRCA                                 ; {Rotate the high nibble down into
 $A663 RRCA                                 ; bits 0-3.
 $A664 RRCA                                 ;
 $A665 RRCA                                 ; }
 $A666 AND %00001111                        ; Keep only bits 0-3.
 $A668 NEG                                  ; Negate it.
@label=Handler_PlayerShot_WriteY
*$A66A ADD A,(IX+$04)                       ; Add the step to the shot Y.
; Destroy the shot if it hits the ground or leaves the
; play area.
 $A66D CP $AF                               ; {Jump to #R$A73C if the shot is
 $A66F JP NC,$A73C                          ; on the ground.}
 $A672 CP $30                               ; {Jump to #R$A73C if the shot is
 $A674 JP C,$A73C                           ; above the play area.}
; Store the new Y, flip the shot frame and draw the shot.
 $A677 LD (IX+$04),A                        ; Write the new Y.
 $A67A LD A,(IX+$00)                        ; Fetch the shot type.
 $A67D XOR %00000001                        ; Flip bit 0.
 $A67F LD (IX+$00),A                        ; Write it back.
 $A682 CALL $8B73                           ; Call #R$8B73.
 $A685 CALL $8733                           ; Call #R$8733.
 $A688 JP $A6CB                             ; Jump to #R$A6CB.
@label=Handler_PlayerShot_Table
 $A68B DEFB $F8,$FC,$C0,$00,$F8,$F9,$C4,$FA ; {Shot table. Each #N$04-byte entry holds an X offset, a Y
 $A693 DEFB $F9,$F6,$C7,$E3,$F9,$F4,$CA,$DE ; offset, a speed and a thrust.
 $A69B DEFB $FC,$F2,$D3,$D3,$FF,$F0,$DB,$CC ;
 $A6A3 DEFB $01,$F0,$E3,$C7,$03,$EE,$EA,$C4 ;
 $A6AB DEFB $10,$FC,$40,$00,$10,$F9,$3C,$FA ;
 $A6B3 DEFB $10,$F5,$39,$E3,$0F,$F3,$36,$DE ;
 $A6BB DEFB $0C,$F2,$2D,$D3,$09,$F0,$25,$CC ;
 $A6C3 DEFB $08,$EF,$1D,$C7,$05,$ED,$16,$C4 ; }
; Test the shot against the alien and object slots.
@label=Handler_PlayerShot_TestSlots
*$A6CB LD A,$18                             ; #REGa=#N$18.
 $A6CD LD ($A726),A                         ; Write it over the hit-height compare at
                                            ; #R$A701(#N$A726).
 $A6D0 LD HL,$61B0                          ; #REGhl=#R$61B0.
 $A6D3 LD DE,$0018                          ; #REGde=#N($0018,$04,$04).
 $A6D6 LD B,$06                             ; Set a slot counter in #REGb for
                                            ; #N$06 loops.
 $A6D8 CALL $A6F2                           ; Call #R$A6F2.
; Test the object slot at #R$6108 with a hit height of #N$0C.
 $A6DB LD A,$0C                             ; #REGa=#N$0C.
 $A6DD LD ($A726),A                         ; Write it over the hit-height compare at
                                            ; #R$A701(#N$A726).
 $A6E0 LD HL,$6108                          ; #REGhl=#R$6108.
 $A6E3 LD B,$01                             ; Set a slot counter in #REGb for
                                            ; #N$01 loop.
 $A6E5 CALL $A6F2                           ; Call #R$A6F2.
; Test the object slot at #R$6138 with a hit height of #N$18.
 $A6E8 LD A,$18                             ; #REGa=#N$18.
 $A6EA LD ($A726),A                         ; Write it over the hit-height compare at
                                            ; #R$A701(#N$A726).
 $A6ED LD HL,$6138                          ; #REGhl=#R$6138.
 $A6F0 LD B,$01                             ; Set a slot counter in #REGb for
                                            ; #N$01 loop.
; Test every slot in this group that is in use.
@label=Handler_PlayerShot_ScanSlot
*$A6F2 LD A,(HL)                            ; Fetch the slot type.
 $A6F3 AND A                                ; Test it.
 $A6F4 PUSH BC                              ; {Stash #REGbc, #REGde and #REGhl
 $A6F5 PUSH DE                              ; on the stack.
 $A6F6 PUSH HL                              ; }
 $A6F7 CALL NZ,$A701                        ; Call #R$A701 if the slot is in
                                            ; use.
 $A6FA POP HL                               ; {Restore #REGhl, #REGde and #REGbc from the
 $A6FB POP DE                               ; stack.
 $A6FC POP BC                               ; }
 $A6FD ADD HL,DE                            ; Move onto the next slot.
 $A6FE DJNZ $A6F2                           ; Decrease the slot counter by one and loop back
                                            ; to #R$A6F2 until every slot has been tested.
 $A700 RET                                  ; Return.
; Compare this slot's box against the shot.
@label=Handler_PlayerShot_CompareBox
*$A701 INC HL                               ; {Move onto the slot world X.
 $A702 INC HL                               ; }
 $A703 EX DE,HL                             ; Switch the slot pointer into
                                            ; #REGde.
 $A704 LD A,(DE)                            ; Fetch the world X.
 $A705 INC DE                               ; Move onto the high byte.
 $A706 LD C,A                               ; Copy the low byte into #REGc.
 $A707 LD A,(DE)                            ; Fetch the high byte.
 $A708 INC DE                               ; Move onto the Y.
 $A709 LD B,A                               ; Copy the high byte into #REGb.
 $A70A LD HL,$0008                          ; #REGhl=#N($0008,$04,$04).
 $A70D ADD HL,BC                            ; Add the box offset.
; Check the shot is horizontally within reach of the slot.
 $A70E LD C,(IX+$02)                        ; Fetch the shot world X.
 $A711 LD B,(IX+$03)                        ; Fetch the shot world X high byte.
 $A714 AND A                                ; {Subtract the shot world X.
 $A715 SBC HL,BC                            ; }
 $A717 LD A,H                               ; Fetch the high byte of the
                                            ; difference.
 $A718 AND %00011111                        ; Keep only bits 0-4.
 $A71A RET NZ                               ; Return if they are on different
                                            ; screens.
 $A71B LD A,L                               ; Fetch the low byte.
 $A71C CP $10                               ; {Return if it is at least #N$10.
 $A71E RET NC                               ; }
; Check the shot is vertically within reach of the slot.
 $A71F LD A,(DE)                            ; Fetch the slot Y.
 $A720 ADD A,$04                            ; Add #N$04.
 $A722 SUB (IX+$04)                         ; Subtract the shot Y.
 $A725 CP $18                               ; Compare it against the current
                                            ; hit height.
 $A727 RET NC                               ; Return if the shot missed.
; Set the slot's explode flag, clear the shot and stop
; testing.
 $A728 EX DE,HL                             ; Switch the slot pointer into
                                            ; #REGhl.
 $A729 LD BC,$000C                          ; {Point #REGhl at the explode
 $A72C ADD HL,BC                            ; flag.}
 $A72D SET 0,(HL)                           ; Set bit 0 of the explode flag.
 $A72F CALL $8AE8                           ; Call #R$8AE8.
 $A732 LD (IX+$00),$00                      ; Write #N$00 to the shot type.
 $A736 POP HL                               ; {Discard the stacked return
 $A737 POP HL                               ; addresses and saved registers.
 $A738 POP HL                               ;
 $A739 POP HL                               ;
 $A73A POP HL                               ; }
 $A73B RET                                  ; Return.

; Start Small Explosion
;
; Used by the routines at #R$9BBB, #R$A579, #R$B20F and #R$B218.
; .
; Turn the actor into the first frame of a small explosion (type
; #N$64) and pick its colour. #R$A742 animates it from there.
;
; IX Actor slot
;
; "#SPRITENAME$64".
@label=StartSmallExplosion
c$A73C LD (IX+$00),$64 ; Write #N$64 to *#REGix+#N$00.
 $A740 JR $A772        ; Jump to #R$A772.
; View the equivalent code in;
; #LIST
; { #JETPAC$68B1 }
; { #PSSST$65F7 }
; LIST#

; Handler: Small Explosion
;
; Step a small explosion through its frames (types #N$64 to #N$66),
; then clear the slot once it reaches type #N$67.
;
; IX Actor slot
;
; Draw the current explosion frame and step the type.
@label=Handler_SmallExplosion
c$A742 CALL $8B73      ; Call #R$8B73.
 $A745 CALL $8733      ; Call #R$8733.
 $A748 INC (IX+$00)    ; Increment the actor type by one.
 $A74B RET             ; Return.
; Play the explosion sound, then clear the slot.
@label=Handler_SmallExplosion_PlaySound
 $A74C LD A,(IX+$0A)   ; Fetch *#REGix+#N$0A.
 $A74F AND A           ; {Jump to #R$A755 if it is zero.
 $A750 JR Z,$A755      ; }
 $A752 CALL $B8FF      ; Call #R$B8FF.
@label=Handler_SmallExplosion_ClearType
*$A755 CALL $8AE8      ; Call #R$8AE8.
 $A758 LD (IX+$00),$00 ; Write #N$00 to the actor type.
 $A75C RET             ; Return.

; Start Crater
;
; Used by the routine at #R$B37B.
; .
; Set up the explosion burst, then turn the actor into the first
; crater frame (type #N$C0) and pick its colour.
;
; IX Actor slot
@label=StartCrater
c$A75D CALL $B973      ; Call #R$B973.
; "#SPRITENAME$C0".
 $A760 LD (IX+$00),$C0 ; Write #N$C0 to *#REGix+#N$00.
 $A764 JR $A772        ; Jump to #R$A772.

; Start Explosion
;
; Used by the routine at #R$9531.
; .
; If the actor's explode flag is set, switch to sprite #N$5C
; and pick a fragment colour.
;
; IX Actor slot
;
; Switch to sprite #N$5C when the explode flag is set.
@label=StartExplosion
c$A766 BIT 0,(IX+$10)  ; {Return if bit 0 of *#REGix+#N$10 is not set.
 $A76A RET Z           ; }
; This entry point is used by the routines at #R$9531, #R$ADAB and #R$AF1C.
; .
; "#SPRITENAME$5C".
@label=StartExplosion_SetSprite
*$A76B LD (IX+$00),$5C ; *#REGix+#N$00=#N$5C.
 $A76F CALL $B9A1      ; Call #R$B9A1.
; This entry point is used by the routines at #R$A73C and #R$A75D.
; .
; Pick a fragment colour from #R$5E40.
@label=StartExplosion_PickOffset
*$A772 LD A,($5E40)    ; Fetch #R$5E40.
 $A775 AND %00000011   ; Keep only bits 0-1.
 $A777 LD C,A          ; {Create an offset in #REGbc.
 $A778 LD B,$00        ; }
 $A77A LD HL,$A792     ; {#REGhl=#R$A792+offset.
 $A77D ADD HL,BC       ; }
 $A77E LD A,(HL)       ; Fetch the colour.
 $A77F LD (IX+$07),A   ; Write it to the actor colour.
 $A782 RET             ; Return.
; View the equivalent code in;
; #LIST
; { #JETPAC$689F }
; LIST#

; Handler: Sparkle Burst
;
; Step a sparkle burst through its frames (types #N$5C to #N$62), drawing
; each one, then clear the slot once it reaches type #N$63.
;
; IX Actor slot
;
; Draw the actor and step its type.
@label=Handler_SparkleBurst
c$A783 CALL $ABB4      ; Call #R$ABB4.
 $A786 INC (IX+$00)    ; Increment the actor type by one.
 $A789 RET             ; Return.
; Clear the actor's sprite and free its slot.
@label=Handler_SparkleBurst_Clear
 $A78A CALL $8640      ; Call #R$8640.
 $A78D LD (IX+$00),$00 ; Write #N$00 to the actor type.
 $A791 RET             ; Return.

; Fragment Colours
;
; The four attributes #R$A772 picks from, using bits 0-1 of #R$5E40,
; to colour explosion fragments.
@label=FragmentColours
b$A792 DEFB $45      ; #COLOUR(#PEEK(#PC)).
 $A793 DEFB $46      ; #COLOUR(#PEEK(#PC)).
 $A794 DEFB $47      ; #COLOUR(#PEEK(#PC)).
 $A795 DEFB $46      ; #COLOUR(#PEEK(#PC)).

; Test Laser Hits
;
; Used by the routine at #R$9E2C.
; .
; Walk the alien and object slots and test each one for a
; laser hit.
;
; .
;
; Test the six alien slots, then object slots #N$01 and #N$03.
@label=TestLaserHits
c$A796 LD HL,$61B0    ; #REGhl=#R$61B0.
 $A799 LD DE,$0018    ; #REGde=#N($0018,$04,$04).
 $A79C LD B,$06       ; Set a slot counter in #REGb for #N$06 loops.
 $A79E CALL $A7CB     ; Call #R$A7CB.
; Test object slots #N$01 and #N$03 in turn.
 $A7A1 LD HL,$6108    ; #REGhl=#R$6108.
 $A7A4 LD B,$01       ; Set a slot counter in #REGb for #N$01 loop.
 $A7A6 CALL $A7CB     ; Call #R$A7CB.
 $A7A9 LD HL,$6138    ; #REGhl=#R$6138.
 $A7AC LD B,$01       ; Set a slot counter in #REGb for #N$01 loop.
 $A7AE CALL $A7CB     ; Call #R$A7CB.
; Test slots #N$02 and #N$04 when their type is #N$C8-#N$CB.
 $A7B1 LD HL,$6120    ; #REGhl=#R$6120.
 $A7B4 LD A,(HL)      ; Fetch the slot type.
 $A7B5 SUB $C8        ; Subtract #N$C8.
 $A7B7 CP $04         ; {Jump to #R$A7C0 if that is at least #N$04.
 $A7B9 JR NC,$A7C0    ; }
 $A7BB LD B,$01       ; Set a slot counter in #REGb for #N$01 loop.
 $A7BD CALL $A7CB     ; Call #R$A7CB.
; Test object slot #N$04 the same way.
@label=TestLaserHits_Slot4
*$A7C0 LD HL,$6150    ; #REGhl=#R$6150.
 $A7C3 LD A,(HL)      ; Fetch the slot type.
 $A7C4 SUB $C8        ; Subtract #N$C8.
 $A7C6 CP $04         ; {Return if that is at least #N$04.
 $A7C8 RET NC         ; }
 $A7C9 LD B,$01       ; Set a slot counter in #REGb for #N$01 loop.
; Compare this slot against the current laser pulse.
@label=TestLaserHits_Loop
*$A7CB LD A,(HL)      ; Fetch the slot type.
 $A7CC AND A          ; {Jump to #R$A7DE if the slot is free.
 $A7CD JR Z,$A7DE     ; }
 $A7CF BIT 2,(IX+$02) ; {Jump to #R$A7DE if bit 2 of pulse #N$01 is
 $A7D3 JR Z,$A7DE     ; reset.}
 $A7D5 PUSH BC        ; {Stash #REGbc, #REGde and #REGhl on the stack.
 $A7D6 PUSH DE        ;
 $A7D7 PUSH HL        ; }
 $A7D8 CALL $A7E2     ; Call #R$A7E2.
 $A7DB POP HL         ; {Restore #REGhl, #REGde and #REGbc from the stack.
 $A7DC POP DE         ;
 $A7DD POP BC         ; }
@label=TestLaserHits_NextSlot
*$A7DE ADD HL,DE      ; #REGhl+=#REGde.
 $A7DF DJNZ $A7CB     ; Decrease the counter by one and jump back to
                      ; #R$A7CB until it is zero.
 $A7E1 RET            ; Return.

; Test One Hit
;
; Used by the routine at #R$A796.
; .
; Compare one actor's box against the current laser pulse.
;
; HL Actor slot
;
; Build the actor hit-box from its world X and Y.
@label=TestOneHit
c$A7E2 INC HL         ; {Move onto the actor world X.
 $A7E3 INC HL         ; }
 $A7E4 EX DE,HL       ; Switch the actor pointer into #REGde.
 $A7E5 LD A,(DE)      ; Fetch the world X.
 $A7E6 INC DE         ; Move onto the high byte.
 $A7E7 LD C,A         ; Copy the low byte into #REGc.
 $A7E8 LD A,(DE)      ; Fetch the high byte.
 $A7E9 INC DE         ; Move onto the Y.
 $A7EA LD B,A         ; Copy the high byte into #REGb.
 $A7EB LD HL,$0090    ; #REGhl=#N($0090,$04,$04).
 $A7EE ADD HL,BC      ; Add the box offset.
; Compare that box against the current laser pulse.
 $A7EF LD BC,($607A)  ; Fetch #R$607A.
 $A7F3 LD A,C         ; Copy the low byte into #REGa.
 $A7F4 ADD A,(IX+$02) ; Add pulse #N$01.
 $A7F7 LD C,A         ; Copy the sum into #REGc.
 $A7F8 LD A,B         ; Copy the high byte into #REGa.
 $A7F9 ADC A,$00      ; Add the carry.
 $A7FB LD B,A         ; Copy it into #REGb.
 $A7FC AND A          ; {Subtract the pulse world X.
 $A7FD SBC HL,BC      ; }
; Return if the pulse is outside the hit-box
; horizontally.
 $A7FF LD A,H         ; Fetch the high byte of the difference.
 $A800 AND %00011111  ; Keep only bits 0-4.
 $A802 RET NZ         ; Return if they are on different screens.
 $A803 LD A,L         ; Fetch the low byte.
 $A804 CP $20         ; {Return if it is at least #N$20.
 $A806 RET NC         ; }
; Return if the pulse misses the actor vertically.
 $A807 LD A,(DE)      ; Fetch the actor Y.
 $A808 ADD A,$04      ; Add #N$04.
 $A80A SUB (IX+$01)   ; Subtract the beam Y.
 $A80D CP $18         ; {Return if the pulse missed.
 $A80F RET NC         ; }
; Mark the actor as exploding and consume the pulse.
 $A810 EX DE,HL       ; Switch the actor pointer into #REGhl.
 $A811 LD BC,$000C    ; {Point #REGhl at the explode flag.
 $A814 ADD HL,BC      ; }
 $A815 SET 0,(HL)     ; Set bit 0 of the explode flag.
 $A817 RES 2,(IX+$02) ; Reset bit 2 of pulse #N$01.
 $A81B RET            ; Return.

; Handler: Player Shot Launch
;
; Draw a newly fired shot for its first two frames (types #N$58 and
; #N$59), stepping the type on each time. At type #N$5A the shot is
; handled by #R$A619, which flies it.
;
; IX Actor slot
@label=Handler_PlayerShotLaunch
c$A81C CALL $8B73    ; Call #R$8B73.
 $A81F CALL $8733    ; Call #R$8733.
 $A822 INC (IX+$00)  ; Increment the actor type by one.
 $A825 RET           ; Return.

; Initialise New Level
;
; Used by the routine at #R$81BB.
; .
; Awards an extra life, then rebuilds the level by resetting the
; aliens, Jetman, the window and the sprite caches.
;
; .
;
; #PUSHS #UDGTABLE { #SIM(start=$800A,stop=$8024,sp=$5E00)
; #SIM(start=$81BB,stop=$81D6,sp=$5E00)
; #SCR$02(new-level) }
; { #SCR$01,$01,$16,$1E,$02(terrain-strip) } UDGTABLE# #POPS
; .
; Award an extra life, then rebuild the level.
@label=LevelNew
c$A826 LD HL,$5EA1   ; {Increase the lives counter #R$5EA1 by one.
 $A829 INC (HL)      ; }
; This entry point is used by the routine at #R$A8B5.
; .
; Reset aliens, Jetman, the window and the sprite caches.
@label=LevelInitialisation
*$A82A CALL $B385    ; Call #R$B385.
 $A82D CALL $9020    ; Call #R$9020.
 $A830 CALL $84D8    ; Call #R$84D8.
; Clear the sprite caches and the laser beam slots.
 $A833 CALL $A2F5    ; Call #R$A2F5.
 $A836 CALL $A317    ; Call #R$A317.
; Redraw the lives, terrain and HUD panel, then drop the world
; objects.
 $A839 CALL $894F    ; Call #R$894F.
 $A83C CALL $9356    ; Call #R$9356.
 $A83F CALL $8BBB    ; Call #R$8BBB.
 $A842 CALL $B2F9    ; Call #R$B2F9.
; Store the current frame counter as the last frame.
 $A845 LD A,($5C78)  ; #REGa=#SKOOLKID$5C78(FRAMES).
 $A848 LD ($5E53),A  ; Write #REGa to #R$5E53.
 $A84B RET           ; Return.
; View the equivalent code in;
; #LIST
; { #JETPAC$60A9 }
; { #PSSST$5F80 }
; LIST#

; Initialise New Game
;
; Used by the routine at #R$81BB.
; .
; Sets the starting level and lives for both players. The loop
; runs twice, clearing the level parity and carrying flag, initialising
; the terrain and then swapping the player states using #R$A880. The
; 2UP starting lives and level are written afterwards.
;
; .
;
; Write the starting level and lives for both players.
@label=NewGame
c$A84C LD B,$02      ; Set a player counter in #REGb for #N$02 loops.
@label=NewGame_Loop
*$A84E PUSH BC       ; Stash the counter in #REGbc on the stack.
; Handle setting up 1UP player.
 $A84F LD A,$FF      ; {Write 1UP starting level to #R$5EA0.
 $A851 LD ($5EA0),A  ; }
; See #POKE(255_lives,255 Lives).
 $A854 LD A,$04      ; {Write 1UP starting lives to #R$5EA1.
 $A856 LD ($5EA1),A  ; }
 $A859 XOR A         ; {Write #N$00 to; #LIST { #R$5EA2 } { #R$5EA3 } LIST#
 $A85A LD ($5EA2),A  ;
 $A85D LD ($5EA3),A  ; }
 $A860 CALL $B3DC    ; Call #R$B3DC.
 $A863 CALL $9F5E    ; Call #R$9F5E.
 $A866 CALL $A880    ; Call #R$A880.
 $A869 POP BC        ; Restore #REGbc from the stack.
 $A86A DJNZ $A84E    ; Decrease the counter by one and jump back to
                     ; #R$A84E until it is zero.
; Handle setting up 2UP player.
; .
; See #POKE(255_lives,255 Lives).
 $A86C LD A,$05      ; {Write 2UP starting lives to #R$5EA5.
 $A86E LD ($5EA5),A  ; }
 $A871 LD A,$FF      ; {Write 2UP starting level to #R$5EA4.
 $A873 LD ($5EA4),A  ; }
 $A876 LD A,($5E00)  ; #REGa=*#R$5E00.
 $A879 AND %00000001 ; Keep only bit 0.
 $A87B RET NZ        ; Return if #R$5E00 indicates this is a 2UP game.
 $A87C LD ($5EA5),A  ; Write #N$00 to #R$5EA5 as there is no 2UP player.
 $A87F RET           ; Return.
; View the equivalent code in;
; #LIST
; { #COOKIE$63F0 }
; { #TRANZAM$6391 }
; LIST#

; 1UP/ 2UP Swapper
;
; Used by the routines at #R$A84C and #R$A8B5.
; .
; Swaps the active and inactive player data. Exchanges the four
; player-state bytes at #R$5EA0 and #R$5EA4, #N$0400 bytes of terrain
; between #R$7000 and #R$7400, and #N$0120 bytes of actor slots between
; #R$6090 and #R$6240.
;
; .
;
; This routine "swaps" the data between #REGde and #REGhl.
; .
; These are all the player states.
@label=ChangePlayer
c$A880 LD HL,$5EA0   ; #REGhl=#R$5EA0.
 $A883 LD DE,$5EA4   ; #REGde=#R$5EA4.
 $A886 LD B,$04      ; Set a byte counter in #REGb for #N$04 loops.
; Exchange the four player-state bytes at #R$5EA0
; with the inactive copy at #R$5EA4.
@label=ChangePlayer_States
*$A888 LD A,(DE)     ; #REGa=*#REGde.
 $A889 LD C,(HL)     ; #REGc=*#REGhl.
 $A88A LD (HL),A     ; {Swap the bytes at *#REGhl and *#REGde.
 $A88B LD A,C        ;
 $A88C LD (DE),A     ; }
 $A88D INC HL        ; Increment #REGhl by one.
 $A88E INC DE        ; Increment #REGde by one.
 $A88F DJNZ $A888    ; Decrease the counter by one and jump back to
                     ; #R$A888 until it is zero.
; This is the current terrain buffer data.
 $A891 LD HL,$7000   ; #REGhl=#R$7000.
 $A894 LD DE,$7400   ; #REGde=#R$7400.
 $A897 LD BC,$0400   ; Set the byte count in #REGbc to #N$0400.
 $A89A CALL $A8A6    ; Call #R$A8A6.
; And this is the active sprites.
 $A89D LD HL,$6090   ; #REGhl=#R$6090.
 $A8A0 LD DE,$6240   ; #REGde=#R$6240.
 $A8A3 LD BC,$0120   ; Set the byte count in #REGbc to #N$0120.
; Exchange the bytes at #REGhl and #REGde for
; #REGbc counts.
@label=ChangePlayer_Loop
*$A8A6 PUSH BC       ; Stash #REGbc on the stack.
 $A8A7 LD A,(DE)     ; #REGa=*#REGde.
 $A8A8 LD C,(HL)     ; #REGc=*#REGhl.
 $A8A9 LD (HL),A     ; {Swap the bytes at *#REGhl and *#REGde.
 $A8AA LD A,C        ;
 $A8AB LD (DE),A     ; }
 $A8AC INC HL        ; Increment #REGhl by one.
 $A8AD INC DE        ; Increment #REGde by one.
 $A8AE POP BC        ; Restore #REGbc from the stack.
 $A8AF DEC BC        ; Decrease #REGbc by one.
 $A8B0 LD A,B        ; {Jump back to #R$A8A6 until #REGbc is zero.
 $A8B1 OR C          ;
 $A8B2 JR NZ,$A8A6   ; }
 $A8B4 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #COOKIE$6416 }
; { #JETPAC$616A }
; { #PSSST$613B }
; { #SABREWULF$B235 }
; LIST#

; Lose Life
;
; Used by the routine at #R$B390.
; .
; Spend a life for the active player. In a 2UP game, swap to
; the other player when they still have lives left.
;
; .
;
; 1UP path.
@label=LoseLife
c$A8B5 LD A,($5E00)  ; #REGa=*#R$5E00.
 $A8B8 AND %00000001 ; Keep only bit 0.
 $A8BA JR NZ,$A8C5   ; Jump to #R$A8C5 if this is a 2UP game.
@label=LoseLife_Loop
*$A8BC LD A,($5EA1)  ; {Jump to #R$A939 if #R$5EA1 is zero.
 $A8BF AND A         ;
 $A8C0 JR Z,$A939    ; }
 $A8C2 JP $A82A      ; Jump to #R$A82A.
; 2UP path.
@label=LoseLife_2UP
*$A8C5 LD A,($5EA5)  ; {Jump to #R$A8BC if #R$5EA5 is zero.
 $A8C8 AND A         ;
 $A8C9 JR Z,$A8BC    ; }
 $A8CB LD A,($5EA1)  ; {Call #R$A931 if #R$5EA1 is zero.
 $A8CE AND A         ;
 $A8CF CALL Z,$A931  ; }
 $A8D2 CALL $A880    ; Call #R$A880.
 $A8D5 XOR A         ; {Write #N$00 to #R$5E6C.
 $A8D6 LD ($5E6C),A  ; }
 $A8D9 LD A,($5E65)  ; {Flip #R$5E65 to the other player.
 $A8DC CPL           ;
 $A8DD LD ($5E65),A  ; }
 $A8E0 JP $A82A      ; Jump to #R$A82A.

; Game Over
;
; Prints the "GAME OVER PLAYER X" message for the player who has
; lost their last life. If the lunar rover was destroyed, it also prints
; "YOUR LUNAR ROVER HAS BEEN DESTROYED." and "ALL IS LOST." before
; pausing.
;
; .
;
; #HTML(Set up altering the "#FONTaddr=$D347,attr=$47,chars=0(GAME OVER PLAYER
; 0)(game-over-0up)" message for 1UP.)
@label=GameOver_1UP_Messaging
c$A8E3 LD A,"1"+$80  ; #REGa="1" + #N$80 (bit 7 marks the last character).
; Print the altered messaging and pause to show it for a period of time.
@label=GameOver_Write
*$A8E5 LD ($A95D),A  ; Write ASCII player number to #R$A94B(#N$A95D).
 $A8E8 CALL $84D8    ; Call #R$84D8.
; Handle printing "#FONTaddr=$D347,attr=$47,chars=0(GAME OVER PLAYER
; X)(game-over)" messaging.
 $A8EB LD DE,$A94B   ; #REGde=#R$A94B.
 $A8EE LD HL,$7038   ; #REGhl=#N$7038 (screen location).
 $A8F1 CALL $8A11    ; Call #R$8A11.
 $A8F4 LD DE,$B9D2   ; #REGde=#R$B9D2.
 $A8F7 CALL $B9BC    ; Call #R$B9BC.
; Set a lower delay period for the following test.
 $A8FA LD B,$04      ; Set a delay counter in #REGb for #N$04 loops.
 $A8FC LD A,($6090)  ; {#REGa=*#R$6090-#N$1A.
 $A8FF SUB $1A       ; }
 $A901 CP $10        ; {If the lunar rover was not destroyed, jump straight to
 $A903 JR C,$A922    ; #R$A922.}
; Handle printing "#FONTaddr=$D347,attr=$45,chars=0(YOUR LUNAR ROVER HAS
; BEEN)(lunar-rover)" messaging.
 $A905 LD DE,$A95E   ; #REGde=#R$A95E.
 $A908 LD HL,$3818   ; #REGhl=#N$3818 (screen location).
 $A90B CALL $8A11    ; Call #R$8A11.
; Handle printing "#FONTaddr=$D347,attr=$45,chars=0(DESTROYED.)(destroyed)"
; messaging.
 $A90E LD DE,$A979   ; #REGde=#R$A979.
 $A911 LD HL,$4858   ; #REGhl=#N$4858 (screen location).
 $A914 CALL $8A11    ; Call #R$8A11.
; Handle printing "#FONTaddr=$D347,attr=$45,chars=0(ALL IS LOST.)(all-lost)"
; messaging.
 $A917 LD DE,$A985   ; #REGde=#R$A985.
 $A91A LD HL,$5850   ; #REGhl=#N$5850 (screen location).
 $A91D CALL $8A11    ; Call #R$8A11.
; Provide a pause for us to reflect that the game has now ended.
 $A920 LD B,$08      ; Set a delay counter in #REGb for #N$08 loops.
@label=GameOverDelay
*$A922 LD HL,$0000   ; #REGhl=#N($0000,$04,$04).
; Decrementing #N($0000,$04,$04) by one gives
; #N($FFFF), so the inner loop runs a full 16-bit
; count.
@label=GameOverDelay_Loop
*$A925 DEC HL        ; Decrease #REGhl by one.
 $A926 LD A,H        ; {Jump back to #R$A925 until #REGhl is zero.
 $A927 OR L          ;
 $A928 JR NZ,$A925   ; }
 $A92A DJNZ $A925    ; Decrease the counter by one and jump back to
                     ; #R$A925 until it is zero.
 $A92C RET           ; Return.
; #HTML(Set up altering the "#FONTaddr=$D347,attr=$47,chars=0(GAME OVER PLAYER
; 0)(game-over-0up)" message for 2UP.)
@label=GameOver_2UP_Messaging
*$A92D LD A,"2"+$80  ; #REGa="2" + #N$80 (bit 7 marks the last character).
 $A92F JR $A8E5      ; Jump to #R$A8E5.
; This entry point is used by the routine at #R$A8B5.
; .
; Handles checking if this is a 1UP or 2UP game.
@label=GameOver_Check_Player_1UP
*$A931 LD A,($5E65)  ; {If #R$5E65 is zero, jump to #R$A8E3.
 $A934 AND A         ;
 $A935 JR Z,$A8E3    ; }
 $A937 JR $A92D      ; Jump to #R$A92D.
; This entry point is used by the routine at #R$A8B5.
; .
; Handles checking if this is a 2UP or 1UP game.
@label=GameOver_Check_Player_2UP
*$A939 LD A,($5E65)  ; {If #R$5E65 is not zero, jump to #R$A945.
 $A93C AND A         ;
 $A93D JR NZ,$A945   ; }
 $A93F CALL $A8E3    ; Call #R$A8E3.
 $A942 JP $F56E      ; Jump to #R$F56E.
; Handle 2UP, and then check if this is a new high score.
@label=GameOver_2UP
*$A945 CALL $A92D    ; Call #R$A92D.
 $A948 JP $F56E      ; Jump to #R$F56E.
; View the equivalent code in;
; #LIST
; { #ATICATAC$8C35 }
; { #COOKIE$6BE0 }
; { #PSSST$60FD }
; { #SABREWULF$AA6A }
; { #TRANZAM$6353 }
; LIST#

; Messaging: Game Over
;
; .
;
; .
;
; #FONTaddr=$D347,attr=$47,chars=0(GAME OVER PLAYER X)(game-over)
@label=String_GameOver
t$A94B DEFM $47                                 ; {Attribute:
 $A94C DEFM "GAME OVER PLAYER ","0"+$80         ; #COLOUR(#PEEK(#PC)) + "GAME
                                                ; OVER PLAYER X".}
; #FONTaddr=$D347,attr=$45,chars=0(YOUR LUNAR ROVER HAS BEEN)(lunar-rover)
@label=String_Lunar_Rover
 $A95E DEFM $45                                 ; {Attribute:
 $A95F DEFM "YOUR LUNAR ROVER HAS BEEN"," "+$80 ; #COLOUR(#PEEK(#PC)) + "YOUR
                                                ; LUNAR ROVER HAS BEEN".}
; #FONTaddr=$D347,attr=$45,chars=0(DESTROYED.)(destroyed)
@label=String_Destroyed
 $A979 DEFM $45                                 ; {Attribute:
 $A97A DEFM "DESTROYED."," "+$80                ; #COLOUR(#PEEK(#PC)) +
                                                ; "DESTROYED.".}
; #FONTaddr=$D347,attr=$45,chars=0(ALL IS LOST.)(all-lost)
@label=String_All_Lost
 $A985 DEFM $45                                 ; {Attribute:
 $A986 DEFM "ALL IS LOST."," "+$80              ; #COLOUR(#PEEK(#PC)) + "ALL IS
                                                ; LOST.".}

; Move Debris Particle
;
; Used by the routine at #R$A272.
; .
; Add the particle velocity and discard it if it leaves the
; play area.
;
; IX Particle
;
; Add the particle velocity to its X/Y position.
@label=MoveDebrisParticle
c$A993 LD A,(IX+$00)                        ; Fetch the particle X.
 $A996 ADD A,(IX+$02)                       ; Add the X velocity.
 $A999 LD L,A                               ; Copy the new X into #REGl.
 $A99A LD A,(IX+$01)                        ; Fetch the particle Y.
 $A99D ADD A,(IX+$03)                       ; Add the Y velocity.
 $A9A0 LD H,A                               ; Copy the new Y into #REGh.
; This entry point is used by the routine at #R$AB48.
; .
; Discard the particle if it has left the play area.
@label=MoveDebrisParticle_TestX
*$A9A1 LD A,L                               ; Fetch the new X.
 $A9A2 CP $08                               ; {Return if it is less than #N$08.
 $A9A4 RET C                                ; }
 $A9A5 CP $F8                               ; {Return if it is at least #N$F8.
 $A9A7 RET NC                               ; }
 $A9A8 LD A,H                               ; Fetch the new Y.
 $A9A9 CP $30                               ; {Return if it is less than #N$30.
 $A9AB RET C                                ; }
 $A9AC CP $A8                               ; {Return if it is at least #N$A8.
 $A9AE RET NC                               ; }
; Write the new position and count a live particle.
 $A9AF LD (IX+$00),L                        ; Write the new X.
 $A9B2 LD (IX+$01),H                        ; Write the new Y.
 $A9B5 LD A,($5E69)                         ; Fetch #R$5E69.
 $A9B8 INC A                                ; Increase it by one.
 $A9B9 LD ($5E69),A                         ; Write it back.
; Colour the attribute square under the particle.
 $A9BC LD BC,$0202                          ; #REGbc=#N$0202.
 $A9BF PUSH HL                              ; Stash the particle position on
                                            ; the stack.
 $A9C0 EXX                                  ; Switch to the shadow registers.
 $A9C1 POP DE                               ; Restore the particle position
                                            ; from the stack.
 $A9C2 LD L,E                               ; {Copy it into #REGhl'.
 $A9C3 LD H,D                               ; }
 $A9C4 CALL $8506                           ; Call #R$8506.
; Colour the square with the particle colour unless its attribute
; is zero.
 $A9C7 LD A,(HL)                            ; Fetch the attribute byte.
 $A9C8 AND A                                ; {Jump to #R$A9CF if it is already
 $A9C9 JR Z,$A9CF                           ; zero.}
 $A9CB LD A,(IX+$04)                        ; Fetch the particle colour.
 $A9CE LD (HL),A                            ; Write it to the attribute square.
; XOR the particle pixels onto the screen.
@label=MoveDebrisParticle_ScreenAddress
*$A9CF EXX                                  ; Switch back to the main
                                            ; registers.
 $A9D0 CALL $851E                           ; Call #R$851E.
@label=MoveDebrisParticle_Loop
*$A9D3 PUSH BC                              ; {Stash the counters and the screen address on the
 $A9D4 PUSH HL                              ; stack.}
 $A9D5 LD A,(IX+$00)                        ; Fetch the particle X.
@label=MoveDebrisParticle_PixelIndex
*$A9D8 AND %00000111                        ; Keep only bits 0-2.
 $A9DA LD E,A                               ; Copy the pixel index into #REGe.
; Look up the pixel mask for this column and XOR it
; onto the screen.
 $A9DB EX AF,AF'                            ; Stash #REGa in #REGaf'.
 $A9DC LD A,E                               ; Copy the pixel index into #REGa.
 $A9DD LD DE,$AA13                          ; #REGde=#R$AA13.
 $A9E0 ADD A,E                              ; Add the pixel index.
 $A9E1 LD E,A                               ; Copy the low byte into #REGe.
 $A9E2 LD A,D                               ; Fetch the high byte.
 $A9E3 ADC A,$00                            ; Add the carry.
 $A9E5 LD D,A                               ; Write it back to #REGd.
 $A9E6 LD A,(DE)                            ; Fetch the pixel mask.
 $A9E7 XOR (HL)                             ; Invert the screen byte.
 $A9E8 LD (HL),A                            ; Write it back.
 $A9E9 EX AF,AF'                            ; Restore #REGa from #REGaf'.
; Advance the pixel index, moving to the next screen
; and attribute column at a byte boundary.
 $A9EA INC A                                ; Increase the pixel index by one.
 $A9EB AND %00000111                        ; Keep only bits 0-2.
 $A9ED JR NZ,$AA10                          ; Jump to #R$AA10 if the byte boundary was not
                                            ; crossed.
 $A9EF INC L                                ; Move onto the next screen column.
 $A9F0 EXX                                  ; Switch to the shadow registers.
 $A9F1 INC E                                ; Increase the attribute column by
                                            ; one.
; Colour this column's attribute square the same way.
@label=MoveDebrisParticle_Attribute
*$A9F2 LD L,E                               ; {Copy the attribute address into
 $A9F3 LD H,D                               ; #REGhl'.}
 $A9F4 EX AF,AF'                            ; Stash #REGa in #REGaf'.
 $A9F5 CALL $8506                           ; Call #R$8506.
 $A9F8 LD A,(HL)                            ; Fetch the attribute byte.
 $A9F9 AND A                                ; {Jump to #R$AA00 if it is already
 $A9FA JR Z,$AA00                           ; zero.}
 $A9FC LD A,(IX+$04)                        ; Fetch the particle colour.
 $A9FF LD (HL),A                            ; Write it to the attribute square.
; Step to the next column or up one pixel row.
@label=MoveDebrisParticle_NextColumn
*$AA00 EXX                                  ; Switch back to the main
                                            ; registers.
 $AA01 EX AF,AF'                            ; Restore #REGa from #REGaf'.
 $AA02 DJNZ $A9D8                           ; Decrease the column counter by one and loop
                                            ; back to #R$A9D8 until the pair is drawn.
; Move up one pixel row and repeat until every row is drawn.
 $AA04 POP HL                               ; Restore the screen address from
                                            ; the stack.
 $AA05 CALL $85F6                           ; Call #R$85F6.
 $AA08 EXX                                  ; Switch to the shadow registers.
 $AA09 DEC D                                ; Move the shadow copy of the
                                            ; particle Y up by one pixel.
 $AA0A EXX                                  ; Switch back to the main
                                            ; registers.
 $AA0B POP BC                               ; Restore the counters from the
                                            ; stack.
 $AA0C DEC C                                ; Decrease the row counter by one.
 $AA0D JR NZ,$A9D3                          ; Jump back to #R$A9D3 if any rows
                                            ; remain.
 $AA0F RET                                  ; Return.
@label=MoveDebrisParticle_NextRow
*$AA10 EXX                                  ; Switch to the shadow registers.
 $AA11 JR $A9F2                             ; Jump to #R$A9F2.
@label=MoveDebrisParticle_Masks
 $AA13 DEFB $80,$40,$20,$10,$08,$04,$02,$01 ; {Pixel masks, then debris
 $AA1B DEFB $00,$FE,$41,$01,$FE,$42,$02,$FE ; velocity and colour triples.
 $AA23 DEFB $43,$02,$FF,$44,$02,$00,$45,$02 ;
 $AA2B DEFB $01,$46,$02,$02,$47,$01,$02,$46 ;
 $AA33 DEFB $00,$02,$45,$FF,$02,$44,$FE,$02 ;
 $AA3B DEFB $43,$FE,$01,$42,$FE,$00,$41,$FE ;
 $AA43 DEFB $FF,$42,$FE,$FE,$43,$FF,$FE,$44 ; }

; Debris Particles
;
; Sixteen 5-byte particle records used by #R$AA9B.
@label=Debris_Particles
g$AA4B DEFB $00,$00,$00,$00,$00
 $AA50 DEFB $00,$00,$00,$00,$00
 $AA55 DEFB $00,$00,$00,$00,$00
 $AA5A DEFB $00,$00,$00,$00,$00
 $AA5F DEFB $00,$00,$00,$00,$00
 $AA64 DEFB $00,$00,$00,$00,$00
 $AA69 DEFB $00,$00,$00,$00,$00
 $AA6E DEFB $00,$00,$00,$00,$00
 $AA73 DEFB $00,$00,$00,$00,$00
 $AA78 DEFB $00,$00,$00,$00,$00
 $AA7D DEFB $00,$00,$00,$00,$00
 $AA82 DEFB $00,$00,$00,$00,$00
 $AA87 DEFB $00,$00,$00,$00,$00
 $AA8C DEFB $00,$00,$00,$00,$00
 $AA91 DEFB $00,$00,$00,$00,$00
 $AA96 DEFB $00,$00,$00,$00,$00

; Animate Debris
;
; Used by the routine at #R$A2CF.
; .
; Move the #N$10 explosion particles at #R$AA4B until
; #R$5E69 returns to zero.
;
; .
;
; Walk all #N$10 debris particles until none remain.
@label=AnimateDebris
c$AA9B XOR A          ; {Write #N$00 to #R$5E69.
 $AA9C LD ($5E69),A   ; }
 $AA9F LD IX,$AA4B    ; #REGix=#R$AA4B.
 $AAA3 LD B,$10       ; Set a particle counter in #REGb for #N$10 loops.
; Move each particle in turn.
@label=AnimateDebris_Loop
*$AAA5 PUSH BC        ; Stash the particle counter on the stack.
 $AAA6 CALL $AAB8     ; Call #R$AAB8.
 $AAA9 LD BC,$0005    ; Set the step to the next particle in #REGbc to
                      ; #N($0005,$04,$04).
 $AAAC ADD IX,BC      ; Move onto the next particle.
 $AAAE POP BC         ; Restore the particle counter from the stack.
 $AAAF DJNZ $AAA5     ; Decrease the particle counter by one and loop
                      ; back to #R$AAA5 until all #N$10 have moved.
; Repeat the pass until no particles remain on screen.
 $AAB1 LD A,($5E69)   ; Fetch #R$5E69.
 $AAB4 AND A          ; {Jump back to #R$AA9B if any particles remain.
 $AAB5 JR NZ,$AA9B    ; }
 $AAB7 RET            ; Return.
; Add this particle's velocity and keep it on-screen.
@label=AnimateDebris_AddVelocity
*$AAB8 LD A,(IX+$00)  ; Fetch the particle X.
 $AABB ADD A,(IX+$02) ; Add the X velocity.
 $AABE LD L,A         ; Copy the new X into #REGl.
 $AABF LD A,(IX+$01)  ; Fetch the particle Y.
 $AAC2 ADD A,(IX+$03) ; Add the Y velocity.
 $AAC5 LD H,A         ; Copy the new Y into #REGh.
; Return unless the new position is inside the play area.
 $AAC6 LD A,L         ; Fetch the new X.
 $AAC7 CP $08         ; {Return if it is less than #N$08.
 $AAC9 RET C          ; }
 $AACA CP $F8         ; {Return if it is at least #N$F8.
 $AACC RET NC         ; }
 $AACD LD A,H         ; Fetch the new Y.
 $AACE CP $30         ; {Return if it is less than #N$30.
 $AAD0 RET C          ; }
 $AAD1 CP $A8         ; {Return if it is at least #N$A8.
 $AAD3 RET NC         ; }
; Keep the new position and count this particle as still moving.
 $AAD4 LD (IX+$00),L  ; Write the new X.
 $AAD7 LD (IX+$01),H  ; Write the new Y.
 $AADA LD HL,$5E69    ; #REGhl=#R$5E69.
 $AADD INC (HL)       ; Increase #R$5E69 by one.
 $AADE RET            ; Return.

; Debris Defaults
;
; Template copied to #R$AA4B by #R$AB9D. #R$AB2F saves the
; particle X and Y positions here.
@label=Debris_Defaults
b$AADF DEFB $00,$00,$00,$02,$47
 $AAE4 DEFB $00,$00,$FF,$02,$42
 $AAE9 DEFB $00,$00,$FE,$02,$44
 $AAEE DEFB $00,$00,$FE,$01,$43
 $AAF3 DEFB $00,$00,$FE,$00,$45
 $AAF8 DEFB $00,$00,$FE,$FF,$43
 $AAFD DEFB $00,$00,$FE,$FE,$44
 $AB02 DEFB $00,$00,$FF,$FE,$42
 $AB07 DEFB $00,$00,$00,$FE,$47
 $AB0C DEFB $00,$00,$01,$FE,$42
 $AB11 DEFB $00,$00,$02,$FE,$44
 $AB16 DEFB $00,$00,$02,$FF,$43
 $AB1B DEFB $00,$00,$02,$00,$45
 $AB20 DEFB $00,$00,$02,$01,$43
 $AB25 DEFB $00,$00,$02,$02,$44
 $AB2A DEFB $00,$00,$01,$02,$42

; Initialise Debris
;
; Used by the routine at #R$A2CF.
; .
; Save the X and Y of the #N$10 debris particles at #R$AA4B
; into the template at #R$AADF.
;
; .
;
; Copy the X and Y of each particle into the template.
@label=InitialiseDebris
c$AB2F LD HL,$AA4B   ; #REGhl=#R$AA4B.
 $AB32 LD DE,$AADF   ; #REGde=#R$AADF.
 $AB35 LD B,$10      ; Set a particle counter in #REGb for #N$10 loops.
@label=InitialiseDebris_Loop
*$AB37 LD A,(HL)     ; {Copy the particle X.
 $AB38 INC HL        ; }
 $AB39 LD (DE),A     ; {Write it and move on.
 $AB3A INC DE        ; }
 $AB3B LD A,(HL)     ; {Copy the particle Y.
 $AB3C INC HL        ; }
 $AB3D LD (DE),A     ; {Write it and move on.
 $AB3E INC DE        ; }
; Skip the velocity and colour bytes of both records.
 $AB3F INC HL        ; {Skip the rest of this particle record.
 $AB40 INC HL        ;
 $AB41 INC HL        ; }
 $AB42 INC DE        ; {Skip the rest of this template record.
 $AB43 INC DE        ;
 $AB44 INC DE        ; }
 $AB45 DJNZ $AB37    ; Decrease the particle counter by one and loop
                     ; back to #R$AB37 until all #N$10 are copied.
 $AB47 RET           ; Return.

; Animate Debris Burst
;
; Used by the routine at #R$A2CF.
; .
; Play the explosion tick and move the #N$10 debris particles.
;
; .
;
; Tick the explosion pitch and walk the debris particles.
@label=AnimateDebrisBurst
c$AB48 XOR A          ; {Write #N$00 to #R$5E69.
 $AB49 LD ($5E69),A   ; }
 $AB4C LD A,($5E7B)   ; Fetch #R$5E7B.
 $AB4F INC A          ; Increase it by one.
 $AB50 LD ($5E7B),A   ; Write it back.
 $AB53 CALL $B8F2     ; Call #R$B8F2.
 $AB56 LD IX,$AA4B    ; #REGix=#R$AA4B.
 $AB5A LD B,$10       ; Set a particle counter in #REGb for #N$10 loops.
; Move one particle, then loop until all #N$10 have moved.
@label=AnimateDebrisBurst_Loop
*$AB5C PUSH BC        ; Stash the particle counter on the stack.
 $AB5D CALL $AB78     ; Call #R$AB78.
 $AB60 LD BC,$0005    ; Set the step to the next particle in #REGbc to
                      ; #N($0005,$04,$04).
 $AB63 ADD IX,BC      ; Move onto the next particle.
 $AB65 POP BC         ; Restore the particle counter from the stack.
 $AB66 DJNZ $AB5C     ; Decrease the particle counter by one and loop
                      ; back to #R$AB5C until all #N$10 have moved.
; Repeat the whole pass while any particle is still moving.
 $AB68 LD A,($5E69)   ; Fetch #R$5E69.
 $AB6B AND A          ; {Jump back to #R$AB48 if any particles remain.
 $AB6C JR NZ,$AB48    ; }
 $AB6E RET            ; Return.
; Return if this parked particle's Y matches #R$5E6A.
; Otherwise move it.
@label=AnimateDebrisBurst_CompareY
*$AB6F LD A,($5E6A)   ; Fetch #R$5E6A.
 $AB72 CP (IX+$01)    ; {Return if it matches this particle Y.
 $AB75 RET Z          ; }
 $AB76 JR $AB7F       ; Jump to #R$AB7F.
@label=AnimateDebrisBurst_TestParkedX
*$AB78 LD A,(IX+$00)  ; Fetch the particle X.
 $AB7B CP $80         ; {Jump to #R$AB6F if it is #N$80.
 $AB7D JR Z,$AB6F     ; }
; Add the velocity to the particle position.
@label=AnimateDebrisBurst_AddX
*$AB7F LD A,(IX+$00)  ; Fetch the particle X.
 $AB82 ADD A,(IX+$02) ; Add the X velocity.
 $AB85 LD L,A         ; Copy the new X into #REGl.
 $AB86 LD A,(IX+$01)  ; Fetch the particle Y.
 $AB89 ADD A,(IX+$03) ; Add the Y velocity.
 $AB8C LD H,A         ; Copy the new Y into #REGh.
; Return if the new X is #N$80 and the new Y matches #R$5E6A.
; Otherwise jump to #R$A9A1.
 $AB8D LD A,L         ; Fetch the new X.
 $AB8E CP $80         ; {Jump to #R$AB95 if it is #N$80.
 $AB90 JR Z,$AB95     ; }
 $AB92 JP $A9A1       ; Jump to #R$A9A1.
@label=AnimateDebrisBurst_CompareNewY
*$AB95 LD A,($5E6A)   ; Fetch #R$5E6A.
 $AB98 CP H           ; {Return if it matches the new Y.
 $AB99 RET Z          ; }
 $AB9A JP $A9A1       ; Jump to #R$A9A1.

; Copy Debris Template
;
; Used by the routine at #R$A2CF.
; .
; Copy #N$50 bytes from #R$AADF into #R$AA4B.
@label=CopyDebrisTemplate
c$AB9D LD HL,$AADF   ; {Copy #N$50 bytes from #R$AADF to #R$AA4B.
 $ABA0 LD DE,$AA4B   ;
 $ABA3 LD BC,$0050   ;
 $ABA6 LDIR          ; }
 $ABA8 RET           ; Return.

; Draw Current Actor
;
; Used by the routines at #R$ABBA and #R$AC39.
; .
; Step the actor type through frames #N$70-#N$7F and draw it
; through #R$8701.
;
; IX Actor slot
;
; Step the actor type through frames #N$70-#N($7F), then draw.
@label=DrawCurrentActor
c$ABA9 LD A,(IX+$00) ; Fetch the actor type.
 $ABAC INC A         ; Increase it by one.
 $ABAD AND %00001111 ; Keep only bits 0-3.
; Sprite IDs begin at #R$D987(#N$70) (#SPRITENAME$70).
 $ABAF ADD A,$70     ; Add #N$70.
 $ABB1 LD (IX+$00),A ; Write it back.
; This entry point is used by the routines at #R$A1AA, #R$A325, #R$A3FF,
; #R$A783, #R$AC39, #R$ADAB, #R$ADEA, #R$AE37, #R$AF1C, #R$B065, #R$B1A4,
; #R$B33D, #R$B37B, #R$B460, #R$B785 and #R$B810.
@label=DrawCurrentActor_Draw
*$ABB4 CALL $8701    ; Call #R$8701.
 $ABB7 JP $8733      ; Jump to #R$8733.

; Handler: Missile Launcher
;
; Handle the missile launcher (types #N$70 to #N$7F). Kill Jetman if
; he is in range, then while *#REGix+#N$17 is set step the frame, count it
; down, draw its gauge and flash the base or alien banner. Otherwise
; continue at #R$AC3E.
;
; IX Actor slot
;
; Test range, then draw the missile banner when
; *#REGix+#N$17 is set.
@label=Handler_MissileLauncher
c$ABBA LD E,$18            ; #REGe=#N$18.
 $ABBC CALL $B2A4          ; Call #R$B2A4.
 $ABBF CALL C,$B2D7        ; Call #R$B2D7 if this actor is close enough.
 $ABC2 LD A,(IX+$17)       ; {Jump to #R$AC3E if *#REGix+#N$17 is zero.
 $ABC5 AND A               ;
 $ABC6 JR Z,$AC3E          ; }
 $ABC8 CALL $ABA9          ; Call #R$ABA9.
; Count down *#REGix+#N$17 every sixteenth frame,
; unless the countdown is suspended.
 $ABCB LD A,($5E42)        ; Fetch #R$5E42.
 $ABCE CPL                 ; Invert the bits.
 $ABCF AND %00001111       ; Keep only bits 0-3.
 $ABD1 RET NZ              ; Return if the result is not zero.
 $ABD2 LD A,($5E67)        ; {Jump to #R$ABE5 if #R$5E67 is not zero.
 $ABD5 AND A               ;
 $ABD6 JR NZ,$ABE5         ; }
 $ABD8 LD A,($6078)        ; Fetch #R$6078.
 $ABDB CP $81              ; Compare it against #N$81.
; See #POKE(infinite_time,Infinite Time).
@label=Handler_MissileLauncher_TestType
 $ABDD JR Z,$ABE5          ; Jump to #R$ABE5 if Jetman's type is #N$81.
 $ABDF DEC (IX+$17)        ; Decrease *#REGix+#N$17 by one.
 $ABE2 CALL Z,$B16F        ; Call #R$B16F if it is now zero.
; Draw the gauge for *#REGix+#N$17.
@label=Handler_MissileLauncher_Gauge
*$ABE5 LD A,(IX+$17)       ; Fetch *#REGix+#N$17.
 $ABE8 LD HL,$2040         ; #REGhl=#N$2040.
 $ABEB CALL $8C01          ; Call #R$8C01.
; Flash one of the banner tiles, chosen by which side
; of Jetman the actor is on.
 $ABEE CALL $AD36          ; Call #R$AD36.
 $ABF1 JR NC,$AC29         ; Jump to #R$AC29 if the actor is not to the left of
                           ; Jetman.
; The actor is to the left, so flash the first tile (#N$587B) and set
; the second tile (#N$587D) to a steady colour.
 $ABF3 CALL $AD0B          ; Call #R$AD0B to fetch the flashing attribute.
 $ABF6 LD HL,$587B         ; Point #REGhl at the first banner tile (#N$587B).
 $ABF9 CALL $AD00          ; Call #R$AD00 to colour the tile with #REGa.
 $ABFC LD HL,$587D         ; Point #REGhl at the second banner tile (#N$587D).
 $ABFF LD A,$42            ; Set the steady attribute in #REGa to #COLOUR$42.
@label=Handler_MissileLauncher_Loop
*$AC01 CALL $AD00          ; Call #R$AD00 to colour the tile with #REGa.
; Print the base or alien banner message at fixed
; points in the timer, otherwise return.
 $AC04 LD A,($5E42)        ; Fetch #R$5E42.
 $AC07 AND %00111111       ; Keep only bits 0-5.
 $AC09 CP $0F              ; {Jump to #R$AC1A if it is #N$0F.
 $AC0B JR Z,$AC1A          ; }
 $AC0D CP $2F              ; {Return if it is not #N$2F.
 $AC0F RET NZ              ; }
; Handle printing the "#FONTaddr=$D347,attr=$45,chars=0(ghij)(alien)"
; messaging.
 $AC10 LD DE,$AC24         ; #REGde=#R$AC24.
@label=BannerMessaging_Print
*$AC13 LD HL,$10D8         ; #REGhl=#N$10D8 (screen location).
 $AC16 CALL $8A11          ; Call #R$8A11.
 $AC19 RET                 ; Return.
; Handle printing the "#FONTaddr=$D347,attr=$45,chars=0(cdef)(base)" messaging.
@label=Handler_MissileLauncher_PrintBase
*$AC1A LD DE,$AC1F         ; #REGde=#R$AC1F.
 $AC1D JR $AC13            ; Jump to #R$AC13.
@label=BannerMessaging_Base
 $AC1F DEFM "Ecde","f"+$80 ; Attribute: #COLOUR(#PEEK(#PC)) +
                           ; "#FONTaddr=$D347,attr=$45,chars=0(cdef)(base)".
@label=BannerMessaging_Alien
 $AC24 DEFM "Eghi","j"+$80 ; Attribute: #COLOUR(#PEEK(#PC)) +
                           ; "#FONTaddr=$D347,attr=$45,chars=0(ghij)(alien)".
; The actor is not to the left, so flash the second tile (#N$587D) and
; set the first tile (#N$587B) to a steady colour.
@label=Handler_MissileLauncher_FlashBanner
*$AC29 CALL $AD0B          ; Call #R$AD0B to fetch the flashing attribute.
 $AC2C LD HL,$587D         ; Point #REGhl at the second banner tile (#N$587D).
 $AC2F CALL $AD00          ; Call #R$AD00 to colour the tile with #REGa.
 $AC32 LD HL,$587B         ; Point #REGhl at the first banner tile (#N$587B).
 $AC35 LD A,$42            ; Set the steady attribute in #REGa to #COLOUR$42.
 $AC37 JR $AC01            ; Jump to #R$AC01 to colour the tile with #REGa.

; Align To Rover
;
; Use the rover position when the rover is in play, otherwise
; Jetman's, then convert types #N$70 and #N$78 into the linked slots
; at #R$6138.
;
; IX Actor slot
;
; Start from the scroll X.
@label=AlignToRover
c$AC39 LD HL,($607A)                        ; #REGhl=*#R$607A.
 $AC3C JR $AC4A                             ; Jump to #R$AC4A.
; This entry point is used by the routine at #R$ABBA.
; .
; Prefer the rover X when its type is in the
; #N$10 rover frames #N$1A-#N$29.
@label=AlignToRover_TestRoverY
*$AC3E LD A,($6090)                         ; #REGa=*#R$6090.
 $AC41 SUB $1A                              ; Subtract #N$1A.
 $AC43 CP $10                               ; {Jump to #R$AC39 if that is not a
 $AC45 JR NC,$AC39                          ; rover frame.}
 $AC47 LD HL,($6092)                        ; #REGhl=*#R$6092.
; Test whether this actor is in range of that X, then its type.
@label=AlignToRover_TestType
*$AC4A CALL $AD39                           ; Call #R$AD39.
 $AC4D LD A,(IX+$00)                        ; #REGa=*#REGix+#N$00.
 $AC50 JR C,$AC59                           ; Jump to #R$AC59 if carry is set.
 $AC52 CP $78                               ; {Jump to #R$AC60 if it is #N$78.
 $AC54 JR Z,$AC60                           ; }
 $AC56 JP $ABA9                             ; Jump to #R$ABA9.
; Type #N$70 copies #R$ACA0.
@label=AlignToRover_Type70
*$AC59 CP $70                               ; {Jump to #R$AC6F if it is #N$70.
 $AC5B JR Z,$AC6F                           ; }
 $AC5D JP $ABA9                             ; Jump to #R$ABA9.
; Type #N$78 copies #R$ACD0 and becomes #N$98.
@label=AlignToRover_Type78
*$AC60 CALL $ABB4                           ; Call #R$ABB4.
 $AC63 CALL $B1D3                           ; Call #R$B1D3.
 $AC66 RET NZ                               ; Return if any object slot is in
                                            ; use.
 $AC67 CALL $AC7E                           ; Call #R$AC7E.
 $AC6A LD (IX+$00),$98                      ; Write #N$98 to *#REGix+#N$00.
 $AC6E RET                                  ; Return.
; Type #N$70 becomes #N$9C.
@label=AlignToRover_ConvertLauncher
*$AC6F CALL $ABB4                           ; Call #R$ABB4.
 $AC72 CALL $B1D3                           ; Call #R$B1D3.
 $AC75 RET NZ                               ; Return if any object slot is in
                                            ; use.
 $AC76 CALL $AC83                           ; Call #R$AC83.
 $AC79 LD (IX+$00),$9C                      ; Write #N$9C to *#REGix+#N$00.
 $AC7D RET                                  ; Return.
; Copy #N$30 bytes into #R$6138.
@label=AlignToRover_CopyTarget2
*$AC7E LD HL,$ACD0                          ; #REGhl=#R$ACD0.
 $AC81 JR $AC86                             ; Jump to #R$AC86.
@label=AlignToRover_CopyTarget
*$AC83 LD HL,$ACA0                          ; #REGhl=#R$ACA0.
@label=AlignToRover_CopyToSlot
*$AC86 LD DE,$6138                          ; #REGde=#R$6138.
 $AC89 LD BC,$0030                          ; {Copy #N$30 bytes from #REGhl to
 $AC8C LDIR                                 ; #REGde.}
; Place the slot at this actor's world X and #N$10 above its Y.
 $AC8E LD L,(IX+$02)                        ; #REGl=*#REGix+#N$02.
 $AC91 LD H,(IX+$03)                        ; #REGh=*#REGix+#N$03.
 $AC94 LD ($613A),HL                        ; Write #REGhl to #R$613A.
 $AC97 LD A,(IX+$04)                        ; #REGa=*#REGix+#N$04.
 $AC9A SUB $10                              ; #REGa-=#N$10.
 $AC9C LD ($613C),A                         ; Write #REGa to #R$613C.
 $AC9F RET                                  ; Return.
@label=AlignToRover_Target
 $ACA0 DEFB $84,$00,$00,$00,$00,$01,$FF,$46 ;
 $ACA8 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
 $ACB0 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
 $ACB8 DEFB $86,$00,$00,$00,$00,$00,$00,$42 ;
 $ACC0 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
 $ACC8 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
@label=AlignToRover_Target_2
 $ACD0 DEFB $80,$00,$00,$00,$00,$FF,$FF,$46 ;
 $ACD8 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
 $ACE0 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
 $ACE8 DEFB $82,$00,$00,$00,$00,$00,$00,$42 ;
 $ACF0 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
 $ACF8 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;

; Handler: Colourise 2x2
;
; Used by the routines at #R$9EDC, #R$ABBA, #R$AD22 and #R$AF1C.
; .
; Write an attribute value to four attribute buffer
; locations.
;
; A The attribute value to write
; HL The address in the attribute buffer to begin writing to
@label=Handler_Colour2x2
c$AD00 LD (HL),A     ; Write #REGa to *#REGhl.
; Move one byte to the right.
 $AD01 INC L         ; Increment #REGl by one.
 $AD02 LD (HL),A     ; Write #REGa to *#REGhl.
; Move down one attribute row, less one byte, so the
; write sits under the first location.
 $AD03 LD BC,$001F   ; {#REGhl=#REGhl+#N($001F,$04,$04).
 $AD06 ADD HL,BC     ; }
 $AD07 LD (HL),A     ; Write #REGa to *#REGhl.
; Move one byte to the right.
 $AD08 INC L         ; Increment #REGl by one.
 $AD09 LD (HL),A     ; Write #REGa to *#REGhl.
 $AD0A RET           ; Return.

; Flash Attribute
;
; Used by the routines at #R$9EDC, #R$ABBA and #R$AD22.
; .
; Return attribute #COLOUR$42 or #COLOUR$72 according to bit
; #N$04 of #R$5E42.
;
; O:A Attribute value
;
; Return attribute #COLOUR$42 or #COLOUR$72 from the timer.
@label=FlashAttribute
c$AD0B LD A,($5E42)  ; Fetch #R$5E42.
 $AD0E AND %00010000 ; Keep only bit 4.
 $AD10 JR Z,$AD14    ; Jump to #R$AD14 if that bit is reset.
 $AD12 LD A,$30      ; #REGa=#N$30.
; This entry point is used by the routine at #R$AD17.
@label=FlashAttribute_Loop
*$AD14 OR %01000010  ; Set bits 1 and 6.
 $AD16 RET           ; Return.

; Flash Attribute Alternative
;
; Used by the routine at #R$AF1C.
; .
; Return attribute #COLOUR$42 or #COLOUR$7A according to bit #N$04 of
; #R$5E42.
;
; O:A Attribute value
@label=FlashAttributeAlternative
c$AD17 LD A,($5E42)  ; Fetch #R$5E42.
 $AD1A AND %00010000 ; Keep only bit 4.
 $AD1C JR Z,$AD14    ; Jump to #R$AD14 if that bit is reset.
 $AD1E LD A,$38      ; #REGa=#N$38.
 $AD20 JR $AD14      ; Jump to #R$AD14.

; Colourise Banner
;
; Used by the routine at #R$91E2.
; .
; Flash the rover HUD tiles at #N$5861 and #N$5863.
;
; .
;
; Flash the rover HUD tiles at #N$5861 and #N$5863.
@label=ColouriseBanner
c$AD22 CALL $AD0B    ; Call #R$AD0B.
; This entry point is used by the routine at #R$AD33.
@label=ColouriseBanner_Loop
*$AD25 LD HL,$5861   ; Point #REGhl at the first HUD tile (#N$5861).
 $AD28 PUSH AF       ; Stash #REGaf on the stack.
 $AD29 CALL $AD00    ; Call #R$AD00 to colour the tile with #REGa.
 $AD2C POP AF        ; Restore #REGaf from the stack.
 $AD2D LD HL,$5863   ; Point #REGhl at the second HUD tile (#N$5863).
 $AD30 JP $AD00      ; Jump to #R$AD00 to colour the tile with #REGa.

; Clear Banner Colour
;
; Used by the routine at #R$91E2.
; .
; Write attribute #COLOUR$00 into the rover banner attributes.
@label=ClearBannerColour
c$AD33 XOR A         ; #REGa=#N$00.
 $AD34 JR $AD25      ; Jump to #R$AD25.

; Test Actor Side
;
; Used by the routines at #R$9EDC, #R$ABBA and #R$AF1C.
; .
; Test whether this actor is to the left of Jetman. The world wraps
; at #N$2000 so carry is set when Jetman's world X (#R$607A) is less than
; #N$1000 ahead of the actor.
;
; IX Actor slot
@label=Handler_Missile
c$AD36 LD HL,($607A) ; Fetch #R$607A.
; This entry point is used by the routine at #R$AC39.
@label=Handler_Missile_FetchActorX
*$AD39 LD C,(IX+$02) ; Fetch the actor world X.
 $AD3C LD B,(IX+$03) ; Fetch the high byte.
; This entry point is used by the routines at #R$9020 and #R$B731.
; .
; Return carry if #REGhl is ahead of #REGbc (to its right) by
; less than #N$1000 (allowing for the wrap at #N$2000).
@label=Handler_Missile_CompareWorldX
*$AD3F AND A         ; {Subtract the second world X.
 $AD40 SBC HL,BC     ; }
 $AD42 LD A,H        ; Fetch the high byte of the difference.
 $AD43 AND A         ; {Jump to #R$AD4E if the result is negative.
 $AD44 JP M,$AD4E    ; }
; Test a positive difference against the range and return carry.
 $AD47 LD BC,$1000   ; Set the range in #REGbc to #N$1000.
 $AD4A AND A         ; {Subtract the range.
 $AD4B SBC HL,BC     ; }
 $AD4D RET           ; Return.
; Call #R$8947 on a negative difference, then test it against the
; range and invert the carry.
@label=Handler_Missile_NegateThenRange
*$AD4E CALL $8947    ; Call #R$8947.
 $AD51 LD BC,$1000   ; Set the range in #REGbc to #N$1000.
 $AD54 AND A         ; {Subtract the range.
 $AD55 SBC HL,BC     ; }
 $AD57 CCF           ; Invert the carry flag.
 $AD58 RET           ; Return.

; Handler: Alien Base
;
; Draw the alien base, then turn it and its launcher into craters
; once #R$5E6C is set or the destroyed flag at #R$6195 is set.
;
; IX Actor slot
;
; Draw the base using the frame that matches its pixel offset.
@label=Handler_AlienBase
c$AD59 LD E,$14      ; #REGe=#N$14.
 $AD5B CALL $B2A4    ; Call #R$B2A4.
 $AD5E CALL C,$B2D7  ; Call #R$B2D7 if this actor is close enough.
; Pick the frame for the base's pixel offset and write it as the
; actor type.
 $AD61 LD A,($607A)  ; Fetch #R$607A.
 $AD64 SUB (IX+$02)  ; Subtract the actor world X.
 $AD67 NEG           ; Negate the difference.
 $AD69 AND %00000111 ; Keep only bits 0-2.
; Sprite IDs begin at #R$DF13(#N$68) (#SPRITENAME$68).
 $AD6B ADD A,$68     ; Add #N$68 for the alien base frames.
 $AD6D LD (IX+$00),A ; Write it to the actor type.
; Draw the base and colour its attribute tiles.
 $AD70 CALL $8787    ; Call #R$8787.
 $AD73 LD A,($5E58)  ; Fetch #R$5E58.
 $AD76 SUB $08       ; Subtract #N$08.
 $AD78 LD ($5E58),A  ; Write it back.
 $AD7B CALL $8733    ; Call #R$8733.
; Return unless the base has been destroyed or
; #R$5E6C is set.
 $AD7E LD A,($5E6C)  ; Fetch #R$5E6C.
 $AD81 AND A         ; {Jump to #R$AD89 if it is not zero.
 $AD82 JR NZ,$AD89   ; }
 $AD84 LD A,(IX+$15) ; Fetch the destroyed flag at *#REGix+#N$15.
 $AD87 AND A         ; {Return if it is zero.
 $AD88 RET Z         ; }
; Erase the base, turn #R$6168 and #R$6180 into craters (type
; #N$C0), move the base #N$08 left and clear #R$6180(#N$6188).
@label=Handler_Missile_HideSlots
*$AD89 CALL $864F    ; Call #R$864F.
 $AD8C LD A,$C0      ; #REGa=#N$C0.
 $AD8E LD ($6168),A  ; Write it to #R$6168.
 $AD91 LD ($6180),A  ; Write it to #R$6180.
; Move the world X at #R$6182 left by #N$08.
 $AD94 LD HL,($6182) ; Fetch #R$6182.
 $AD97 LD BC,$FFF8   ; Set the offset in #REGbc to #N$FFF8 (-#N$08).
 $AD9A CALL $A002    ; Call #R$A002.
 $AD9D LD ($6182),HL ; Write it back.
; Clear #N$08 bytes of that slot from #R$6180(#N$6188).
 $ADA0 LD HL,$6188   ; #REGhl=#R$6180(#N$6188).
 $ADA3 LD B,$08      ; Set a byte counter in #REGb for #N$08 loops.
@label=Handler_Missile_Loop
*$ADA5 LD (HL),$00   ; Write #N$00 to the current byte.
 $ADA7 INC HL        ; Move onto the next byte.
 $ADA8 DJNZ $ADA5    ; Decrease the byte counter by one and loop back
                     ; to #R$ADA5 until the tail is clear.
 $ADAA RET           ; Return.

; Handler: Upward Missile
;
; Fly an upward missile (types #N$80 and #N$84) by its speed and
; thrust. It explodes when it touches Jetman or is shot, or once its Y is
; less than #N$3C.
;
; IX Actor slot
;
; Fly the missile, or explode it on a hit.
@label=Handler_UpwardMissile
c$ADAB CALL $B2A2     ; Call #R$B2A2.
 $ADAE JR C,$ADDE     ; Jump to #R$ADDE if Jetman is in range.
 $ADB0 BIT 0,(IX+$10) ; {Jump to #R$ADE1 if bit 0 of the explode flag is
 $ADB4 JR NZ,$ADE1    ; set.}
; Move the missile along by its speed and thrust.
 $ADB6 LD L,(IX+$02)  ; Fetch the actor world X.
 $ADB9 LD H,(IX+$03)  ; Fetch the high byte.
 $ADBC LD B,$00       ; Clear #REGb.
 $ADBE LD A,(IX+$05)  ; Fetch the actor speed.
 $ADC1 LD C,A         ; Copy it into #REGc.
 $ADC2 AND A          ; {Jump to #R$ADC7 if the speed is positive.
 $ADC3 JP P,$ADC7     ; }
 $ADC6 DEC B          ; Sign-extend into #REGb.
@label=Handler_Missile_AddSpeed
*$ADC7 ADD HL,BC      ; Add the speed to the world X.
 $ADC8 LD (IX+$02),L  ; Write the low byte back.
 $ADCB LD (IX+$03),H  ; Write the high byte back.
; Move the missile along its Y by the thrust.
 $ADCE LD A,(IX+$04)  ; Fetch the actor Y.
 $ADD1 ADD A,(IX+$06) ; Add the thrust.
 $ADD4 LD (IX+$04),A  ; Write it back.
; Explode the missile once it has flown above Y
; #N($3C), otherwise draw it.
 $ADD7 CP $3C         ; {Jump to #R$ADE7 if the Y is less than #N$3C.
 $ADD9 JR C,$ADE7     ; }
 $ADDB JP $ABB4       ; Jump to #R$ABB4.
@label=Handler_Missile_HitJetman
*$ADDE CALL $B2D7     ; Call #R$B2D7.
; Destroying the missile adds #N$0500 points.
@label=Handler_Missile_AwardPoints
*$ADE1 LD BC,$0500    ; Set the points to award in #REGbc to #N$0500.
 $ADE4 CALL $899C     ; Call #R$899C.
@label=Handler_Missile_Explode
*$ADE7 JP $A76B       ; Jump to #R$A76B.

; Handler: Upward Missile Flame
;
; Keep the flame (types #N$82/#N$83 or #N$86/#N$87 via
; #R$AE1D) attached to the missile held in the slot at #R$6138. The
; flame is cleared if that slot no longer holds the missile.
;
; IX Actor slot
;
; Hang this actor off the #N$80 slot at #R$6138.
@label=Handler_UpwardMissileFlame
c$ADEA LD A,($6138)    ; Fetch #R$6138.
 $ADED CP $80          ; {Jump to #R$AE2F if the type is not #N$80.
 $ADEF JR NZ,$AE2F     ; }
 $ADF1 LD HL,($613A)   ; Fetch #R$613A.
 $ADF4 LD BC,$0014     ; {Add a #N$14 offset.
 $ADF7 ADD HL,BC       ; }
; Place this actor at the missile's position, offset
; for the flame.
@label=Handler_Missile_MaskWorldX
*$ADF8 LD A,H          ; Fetch the high byte.
 $ADF9 AND %00011111   ; Keep only bits 0-4.
 $ADFB LD H,A          ; Write it back.
 $ADFC LD (IX+$02),L   ; Write the low byte as the actor world X.
 $ADFF LD (IX+$03),H   ; Write the high byte.
 $AE02 LD A,($613C)    ; Fetch #R$613C.
 $AE05 ADD A,$10       ; Add #N$10.
 $AE07 LD (IX+$04),A   ; Write it as the actor Y.
; Alternate the flame frame and colour.
 $AE0A LD A,(IX+$00)   ; Fetch the actor type.
 $AE0D XOR %00000001   ; Flip bit 0.
 $AE0F LD (IX+$00),A   ; Write it back.
 $AE12 LD A,(IX+$07)   ; Fetch the actor colour.
 $AE15 XOR %00000100   ; Flip bit 2.
 $AE17 LD (IX+$07),A   ; Write it back.
 $AE1A JP $ABB4        ; Jump to #R$ABB4.
; The same hang, offset left, for type #N$84.
@label=Handler_UpwardMissileFlame_HangLeft
 $AE1D LD A,($6138)    ; Fetch #R$6138.
 $AE20 CP $84          ; {Jump to #R$AE2F if the type is not #N$84.
 $AE22 JR NZ,$AE2F     ; }
 $AE24 LD HL,($613A)   ; Fetch #R$613A.
 $AE27 LD BC,$0010     ; Set the offset in #REGbc to #N($0010,$04,$04).
 $AE2A AND A           ; {Subtract the offset.
 $AE2B SBC HL,BC       ; }
 $AE2D JR $ADF8        ; Jump to #R$ADF8.
@label=Handler_Missile_ClearType
*$AE2F CALL $8640      ; Call #R$8640.
 $AE32 LD (IX+$00),$00 ; Write #N$00 to the actor type.
 $AE36 RET             ; Return.

; Handler: Missile Spawner
;
; Draw the actor and step its type through #N$98-#N$9B (every 8th
; frame) or #N$9C-#N$9F (every 4th frame). On reaching #N$9B or #N$9F it
; spawns a sideways missile. Types #N$9B and #N$9F only draw.
;
; IX Actor slot
@label=Handler_MissileSpawner
c$AE37 JP $ABB4      ; Jump to #R$ABB4.
; Animate types #N$98-#N$9B every 8th frame, spawning the left
; missile when the type reaches #N$9B.
@label=Handler_MissileSpawner_AnimateLeft
 $AE3A LD E,$18      ; #REGe=#N$18.
 $AE3C CALL $B2A4    ; Call #R$B2A4.
 $AE3F CALL C,$B2D7  ; Call #R$B2D7 if this actor is close enough.
 $AE42 CALL $ABB4    ; Call #R$ABB4.
; Return unless this is every eighth frame.
 $AE45 LD A,($5E42)  ; Fetch #R$5E42.
 $AE48 AND %00000111 ; Keep only bits 0-2.
 $AE4A RET NZ        ; Return if the result is not zero.
; Step the type, then spawn a missile once it reaches #N$9B.
 $AE4B INC (IX+$00)  ; Increase the actor type by one.
 $AE4E LD A,(IX+$00) ; Fetch the actor type.
 $AE51 AND %00000011 ; Keep only bits 0-1.
 $AE53 CP $03        ; {Call #R$AE78 if those bits are #N$03.
 $AE55 CALL Z,$AE78  ; }
 $AE58 RET           ; Return.
; Animate types #N$9C-#N$9F every 4th frame, spawning the right
; missile when the type reaches #N$9F.
@label=Handler_MissileSpawner_AnimateRight
 $AE59 LD E,$18      ; #REGe=#N$18.
 $AE5B CALL $B2A4    ; Call #R$B2A4.
 $AE5E CALL C,$B2D7  ; Call #R$B2D7 if this actor is close enough.
 $AE61 CALL $ABB4    ; Call #R$ABB4.
; Return unless this is every fourth frame.
 $AE64 LD A,($5E42)  ; Fetch #R$5E42.
 $AE67 AND %00000011 ; Keep only bits 0-1.
 $AE69 RET NZ        ; Return if the result is not zero.
; Step the type, then spawn a missile once it reaches #N$9F.
 $AE6A INC (IX+$00)  ; Increase the actor type by one.
 $AE6D LD A,(IX+$00) ; Fetch the actor type.
 $AE70 AND %00000011 ; Keep only bits 0-1.
 $AE72 CP $03        ; {Call #R$AEB7 if those bits are #N$03.
 $AE74 CALL Z,$AEB7  ; }
 $AE77 RET           ; Return.

; Spawn Missile
;
; Used by the routine at #R$AE37.
; .
; Copy the left-facing missile and flame templates at #R$AEBC (or the
; right-facing pair at #R$AEEC, entered at #R$AEB7) into #R$6108 and place
; them at this actor. The hit count is the level plus #N$08 (up to #N$63).
; Then jump to #R$B52E to show the laser estimate, unless #R$6168(#N$6172) is
; non-zero or Jetman's type is #N$2A or above with no lives left.
;
; IX Actor slot
;
; Copy the #N$A0 template into #R$6108.
@label=Handler_Missile_CopyTemplate
c$AE78 LD HL,$AEBC                          ; #REGhl=#R$AEBC.
@label=Handler_Missile_FillObjectSlots
*$AE7B LD DE,$6108                          ; #REGde=#R$6108.
 $AE7E LD BC,$0030                          ; {Copy the #N$30-byte template
 $AE81 LDIR                                 ; into the object slots.}
; Place the missile at this actor's X, and #N$0C above its Y.
 $AE83 LD L,(IX+$02)                        ; Fetch the actor world X.
 $AE86 LD H,(IX+$03)                        ; Fetch the high byte.
 $AE89 LD ($610A),HL                        ; Write it to #R$6108(#N$610A).
 $AE8C LD A,(IX+$04)                        ; Fetch the actor Y.
 $AE8F SUB $0C                              ; Subtract #N$0C.
 $AE91 LD ($610C),A                         ; Write it to #R$6108(#N$610C).
; Set the hit count to the level plus #N($08), up to #N$63.
 $AE94 LD A,($5EA0)                         ; Fetch #R$5EA0.
 $AE97 ADD A,$08                            ; Add #N$08.
 $AE99 CP $63                               ; {Jump to #R$AE9F if that is less
 $AE9B JR C,$AE9F                           ; than #N$63.}
 $AE9D LD A,$63                             ; #REGa=#N$63.
@label=Handler_Missile_WriteHitCount
*$AE9F LD ($611E),A                         ; Write it to #R$6108(#N$611E).
; Decide whether to show the laser estimate at #R$B52E.
 $AEA2 LD A,($6172)                         ; Fetch #R$6168(#N$6172).
 $AEA5 AND A                                ; {Return if it is not zero.
 $AEA6 RET NZ                               ; }
 $AEA7 LD A,($5EA1)                         ; Fetch #R$5EA1.
 $AEAA AND A                                ; {Jump to #R$B52E if any lives
 $AEAB JP NZ,$B52E                          ; remain.}
 $AEAE LD A,($6078)                         ; Fetch #R$6078.
 $AEB1 CP $2A                               ; {Return if Jetman's type is at
 $AEB3 RET NC                               ; least #N$2A.}
 $AEB4 JP $B52E                             ; Jump to #R$B52E.
; This entry point is used by the routine at #R$AE37.
@label=Handler_Missile_CopyTemplate2
*$AEB7 LD HL,$AEEC                          ; #REGhl=#R$AEEC.
 $AEBA JR $AE7B                             ; Jump to #R$AE7B.
@label=Missile_Object_Template
 $AEBC DEFB $A0,$00,$00,$00,$00,$FD,$00,$46 ;
 $AEC4 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
 $AECC DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
 $AED4 DEFB $A2,$00,$00,$00,$00,$00,$00,$42 ;
 $AEDC DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
 $AEE4 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
@label=Missile_Object_Template_2
 $AEEC DEFB $A4,$00,$00,$00,$00,$03,$00,$46 ;
 $AEF4 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
 $AEFC DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
 $AF04 DEFB $A6,$00,$00,$00,$00,$00,$00,$42 ;
 $AF0C DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
 $AF14 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;

; Handler: Sideways Missile
;
; Fly a sideways missile (types #N$A0 and #N$A4). Flash the left or
; right warning marker, take laser hits off its hit count, step its X by its
; speed and steer its Y by its distance from the target. It explodes at
; #R$AFE9 on reaching Jetman or the rover.
;
; IX Actor slot
;
; Colour the missile banner and apply hits.
@label=Handler_SidewaysMissile
c$AF1C CALL $B2A2      ; Call #R$B2A2.
 $AF1F JP C,$AFAE      ; Jump to #R$AFAE if Jetman is in range.
; Flash the banner tile on the side where the missile is.
 $AF22 CALL $AD36      ; Call #R$AD36.
 $AF25 JR NC,$AF35     ; Jump to #R$AF35 if the missile is not to the left of
                       ; Jetman.
; The missile is to the left, so flash the first tile (#N$587B) and set
; the second tile (#N$587D) to a steady colour.
 $AF27 CALL $AD17      ; Call #R$AD17 to fetch the flashing attribute.
 $AF2A LD HL,$587B     ; Point #REGhl at the first banner tile (#N$587B).
 $AF2D CALL $AD00      ; Call #R$AD00 to colour the tile with #REGa.
 $AF30 LD HL,$587D     ; Point #REGhl at the second banner tile (#N$587D).
 $AF33 JR $AF41        ; Jump to #R$AF41 to set the other tile to a steady
                       ; colour.
; The missile is not to the left, so flash the second tile (#N$587D) and
; set the first tile (#N$587B) to a steady colour.
@label=Handler_Missile_FlashBanner
*$AF35 CALL $AD17      ; Call #R$AD17 to fetch the flashing attribute.
 $AF38 LD HL,$587D     ; Point #REGhl at the second banner tile (#N$587D).
 $AF3B CALL $AD00      ; Call #R$AD00 to colour the tile with #REGa.
 $AF3E LD HL,$587B     ; Point #REGhl at the first banner tile (#N$587B).
; Set the other banner tile to #COLOUR$42.
@label=Handler_Missile_BannerColour
*$AF41 LD A,$42        ; Set the steady attribute in #REGa to #COLOUR$42.
 $AF43 CALL $AD00      ; Call #R$AD00 to colour the tile with #REGa.
; Cycle the missile colour on even frames.
 $AF46 LD A,($5E42)    ; Fetch #R$5E42.
 $AF49 AND %00000001   ; Keep only bit 0.
 $AF4B JR NZ,$AF61     ; Jump to #R$AF61 if this is an odd frame.
 $AF4D LD A,(IX+$07)   ; Fetch the actor colour.
 $AF50 CP $46          ; {Jump to #R$AF61 if it is already #COLOUR$46.
 $AF52 JR Z,$AF61      ; }
 $AF54 LD A,($5E40)    ; Fetch #R$5E40.
 $AF57 AND %00000111   ; Keep only bits 0-2.
 $AF59 JR NZ,$AF5C     ; {Jump to #R$AF5C if the result is not zero,
 $AF5B INC A           ; else force #N$01.}
@label=Handler_Missile_WriteBright
*$AF5C OR %01000000    ; Set bit 6.
 $AF5E LD (IX+$07),A   ; Write it to the actor colour.
; Skip to the movement unless the missile has been hit.
@label=Handler_Missile_TakeHit
*$AF61 BIT 0,(IX+$10)  ; {Jump to #R$AF7D if bit 0 of the explode flag is
 $AF65 JR Z,$AF7D      ; reset.}
; Take one hit off the missile hit count.
 $AF67 DEC (IX+$16)    ; Decrease *#REGix+#N$16 by one.
; See #POKE(destroy_missile_with_one_shot,Destroy
; Missile With One Shot).
@label=Handler_Missile_Target
 $AF6A JR Z,$AFB1      ; Jump to #R$AFB1 if the missile has been destroyed.
 $AF6C CALL $B8B4      ; Call #R$B8B4.
; Each missile hit adds #N$0100 points.
 $AF6F LD BC,$0100     ; Set the points to award in #REGbc to #N$0100.
 $AF72 CALL $899C      ; Call #R$899C.
 $AF75 LD (IX+$07),$42 ; Write #COLOUR$42 to the actor colour.
 $AF79 LD (IX+$10),$00 ; Write #N$00 to the explode flag.
; Step the missile world X from its speed.
@label=Handler_Missile_StepX
*$AF7D LD L,(IX+$02)   ; Fetch the actor world X.
 $AF80 LD H,(IX+$03)   ; Fetch the high byte.
 $AF83 LD C,(IX+$05)   ; Fetch the actor speed.
 $AF86 LD B,$00        ; Clear #REGb.
 $AF88 LD A,C          ; Copy the speed into #REGa.
 $AF89 AND A           ; {Jump to #R$AF8E if the speed is positive.
 $AF8A JP P,$AF8E      ; }
 $AF8D DEC B           ; Sign-extend into #REGb.
@label=Handler_Missile_WriteSteppedX
*$AF8E ADD HL,BC       ; Add the speed to the world X.
 $AF8F LD A,H          ; Fetch the high byte.
 $AF90 AND %00011111   ; Keep only bits 0-4.
 $AF92 LD H,A          ; Write it back.
 $AF93 LD (IX+$02),L   ; Write the low byte.
 $AF96 LD (IX+$03),H   ; Write the high byte.
; Test the target range, then steer the Y from the distance.
 $AF99 CALL $B0D1      ; Call #R$B0D1.
 $AF9C JR C,$AFE9      ; Jump to #R$AFE9 if the missile has reached its target.
; Pick the Y steering band from the distance left, or just draw.
 $AF9E LD A,H          ; Fetch the high byte of the distance left in #REGhl.
 $AF9F CP $02          ; {Jump to #R$AFDD if it is less than #N$02.
 $AFA1 JR C,$AFDD      ; }
 $AFA3 CP $10          ; {Jump to #R$AFD6 if it is less than #N$10.
 $AFA5 JR C,$AFD6      ; }
 $AFA7 CP $20          ; {Jump to #R$AFC5 if it is less than #N$20.
 $AFA9 JR C,$AFC5      ; }
@label=Handler_Missile_Draw
*$AFAB JP $ABB4        ; Jump to #R$ABB4.
; Kill Jetman if he is in range, then destroy the missile.
@label=Handler_Missile_InRange
*$AFAE CALL $B2D7      ; Call #R$B2D7.
@label=Handler_Missile_Destroyed
*$AFB1 LD A,$01        ; {Write #N$01 to #R$6195.
 $AFB3 LD ($6195),A    ; }
; Destroying the missile adds #N$0500 points.
 $AFB6 LD BC,$0500     ; Set the points to award in #REGbc to #N$0500.
 $AFB9 CALL $899C      ; Call #R$899C.
 $AFBC LD DE,$BAA8     ; Point #REGde at the tune at #R$BAA8.
 $AFBF CALL $B9BC      ; Call #R$B9BC.
 $AFC2 JP $A76B        ; Jump to #R$A76B.
; Steer the missile Y toward a band from the high byte.
@label=Handler_Missile_SteerY
*$AFC5 LD A,(IX+$04)   ; Fetch the actor Y.
 $AFC8 CP $50          ; Compare it against #N$50.
; Draw the missile once the Y matches its band, otherwise nudge it.
@label=Handler_Missile_YReached
*$AFCA JR Z,$AFAB      ; Jump to #R$AFAB if they are equal.
 $AFCC JR NC,$AFD0     ; Jump to #R$AFD0 if the Y is already past the
                       ; band.
 $AFCE INC A           ; {Increase the Y by two.
 $AFCF INC A           ; }
@label=Handler_Missile_DecreaseY
*$AFD0 DEC A           ; Decrease the Y by one.
 $AFD1 LD (IX+$04),A   ; Write it back.
 $AFD4 JR $AFAB        ; Jump to #R$AFAB.
; In the middle band, steer the Y toward #N$80.
@label=Handler_Missile_MidBand
*$AFD6 LD A,(IX+$04)   ; Fetch the actor Y.
 $AFD9 CP $80          ; Compare it against #N$80.
 $AFDB JR $AFCA        ; Jump to #R$AFCA.
; In the low band, steer the Y toward #N$A7.
@label=Handler_Missile_LowBand
*$AFDD LD A,(IX+$04)   ; Fetch the actor Y.
 $AFE0 CP $A7          ; {Jump to #R$AFAB if it is #N$A7.
 $AFE2 JR Z,$AFAB      ; }
 $AFE4 INC A           ; Increase the Y by one.
 $AFE5 CP $A7          ; Compare it against #N$A7.
 $AFE7 JR $AFCA        ; Jump to #R$AFCA.
; This entry point is used by the routine at #R$B11D.
; .
; The missile has reached Jetman or the rover: set #R$5E6C, then
; turn the world slots, the bomb and the aliens into craters and
; explosions.
@label=Handler_Missile_FreezeWorld
*$AFE9 LD A,$01        ; {Write #N$01 to #R$5E6C.
 $AFEB LD ($5E6C),A    ; }
 $AFEE LD A,$C0        ; #REGa=#N$C0.
 $AFF0 LD ($60D8),A    ; Write it to #R$60D8.
 $AFF3 LD ($60A8),A    ; Write it to #R$60A8.
 $AFF6 LD ($60C0),A    ; Write it to #R$60C0.
; Turn world slot 4 into an explosion if it is in use.
 $AFF9 LD A,($60F0)    ; Fetch #R$60F0.
 $AFFC AND A           ; {Jump to #R$B004 if it is free.
 $AFFD JR Z,$B004      ; }
 $AFFF LD A,$5C        ; {Write #N$5C to #R$60F0.
 $B001 LD ($60F0),A    ; }
; Turn the bomb into a crater if it is in use.
@label=Handler_Missile_HideBomb
*$B004 LD A,($6198)    ; Fetch #R$6198.
 $B007 AND A           ; {Jump to #R$B00F if it is free.
 $B008 JR Z,$B00F      ; }
 $B00A LD A,$C0        ; {Write #N$C0 to #R$6198.
 $B00C LD ($6198),A    ; }
; Turn every active alien into an explosion.
@label=Handler_Missile_ScanAliens
*$B00F LD HL,$61B0     ; #REGhl=#R$61B0.
 $B012 LD DE,$0018     ; #REGde=#N($0018,$04,$04).
 $B015 LD B,$06        ; Set an alien slot counter in #REGb for #N$06 loops.
@label=Handler_Missile_TestAlienSlot
*$B017 LD A,(HL)       ; Fetch the slot type.
 $B018 AND A           ; {Jump to #R$B031 if the slot is free.
 $B019 JR Z,$B031      ; }
; Work out from the slot type how to convert it.
 $B01B AND %11111110   ; Reset bit 0.
 $B01D CP $5A          ; {Jump to #R$B037 if the type is #N$5A.
 $B01F JR Z,$B037      ; }
 $B021 CP $B6          ; {Jump to #R$B037 if the type is #N$B6.
 $B023 JR Z,$B037      ; }
 $B025 AND %11111100   ; Keep only bits 2-7.
 $B027 CP $64          ; {Jump to #R$B031 if the type is #N$64.
 $B029 JR Z,$B031      ; }
 $B02B CP $C8          ; {Jump to #R$B037 if the type is #N$C8.
 $B02D JR Z,$B037      ; }
 $B02F LD (HL),$5C     ; Write #N$5C to the slot.
; Move onto the next slot, looping until every alien is done.
@label=Handler_Missile_NextAlienSlot
*$B031 ADD HL,DE       ; Move onto the next slot.
 $B032 DJNZ $B017      ; Decrease the slot counter by one and loop back
                       ; to #R$B017 until every alien is processed.
 $B034 JP $A76B        ; Jump to #R$A76B.
@label=Handler_Missile_ConvertAlien
*$B037 LD (HL),$64     ; Write #N$64 to the slot.
 $B039 JR $B031        ; Jump to #R$B031.

; Convert To Debris
;
; Used by the routine at #R$9EDC.
; .
; Turn Jetman, if he is riding the rover, or else the parked rover
; into falling debris (type #N$E0).
;
; .
;
; Convert Jetman or the rover into falling debris.
@label=Handler_Missile_FallingDebris
c$B03B LD A,($6078)  ; Fetch #R$6078.
 $B03E SUB $12       ; Subtract #N$12.
 $B040 CP $08        ; Compare it against #N$08.
 $B042 LD BC,$E004   ; Set #REGb to the falling debris type #N$E0 and #REGc to #N$04.
                     ; Loading #REGbc keeps the flags from the compare.
 $B045 JR C,$B056    ; Jump to #R$B056 if Jetman is riding the rover.
; When the rover is parked, turn it into falling debris.
 $B047 LD A,B        ; Copy #N$E0 into #REGa.
 $B048 LD ($6090),A  ; Write it to #R$6090.
 $B04B LD A,C        ; Copy #N$04 into #REGa.
 $B04C LD ($6098),A  ; Write it to #R$6090(#N$6098).
 $B04F LD DE,$6092   ; #REGde=#R$6092.
 $B052 CALL $B4C2    ; Call #R$B4C2.
 $B055 RET           ; Return.
; When Jetman is on the rover, turn Jetman into falling debris.
@label=Handler_Missile_JetmanDebris
*$B056 LD A,B        ; Copy #N$E0 into #REGa.
 $B057 LD ($6078),A  ; Write it to #R$6078.
 $B05A LD A,C        ; Copy #N$04 into #REGa.
 $B05B LD ($6080),A  ; Write it to #R$6080.
 $B05E LD DE,$607A   ; #REGde=#R$607A.
 $B061 CALL $B4C2    ; Call #R$B4C2.
 $B064 RET           ; Return.

; Handler: Sideways Missile Flame
;
; Keep the flame (types #N$A6/#N$A7 here, #N$A2/#N$A3 via
; #R$B098) attached to the missile held in the slot at #R$6108. The
; flame is cleared if that slot no longer holds the missile.
;
; IX Actor slot
;
; Hang this actor off the #N$A4 slot at #R$6108.
@label=Handler_SidewaysMissileFlame
c$B065 LD A,($6108)    ; Fetch #R$6108.
 $B068 CP $A4          ; {Jump to #R$B0C9 if the type is not #N$A4.
 $B06A JR NZ,$B0C9     ; }
; Alternate the flame frame and colour.
 $B06C LD A,(IX+$00)   ; Fetch the actor type.
 $B06F XOR %00000001   ; Flip bit 0.
 $B071 LD (IX+$00),A   ; Write it back.
 $B074 LD A,(IX+$07)   ; Fetch the actor colour.
 $B077 XOR %00000100   ; Flip bit 2.
 $B079 LD (IX+$07),A   ; Write it back.
; Match the flame Y to the missile Y.
 $B07C LD A,($610C)    ; Fetch #R$6108(#N$610C).
 $B07F LD (IX+$04),A   ; Write it as the actor Y.
; Place the flame to the left of the missile's world X.
 $B082 LD HL,($610A)   ; Fetch #R$6108(#N$610A).
 $B085 LD BC,$0018     ; Set the offset in #REGbc to #N($0018,$04,$04).
 $B088 AND A           ; {Subtract the offset.
 $B089 SBC HL,BC       ; }
 $B08B LD A,H          ; Fetch the high byte.
 $B08C AND %00011111   ; Keep only bits 0-4.
 $B08E LD H,A          ; Write it back.
 $B08F LD (IX+$02),L   ; Write the low byte as the actor world X.
 $B092 LD (IX+$03),H   ; Write the high byte.
 $B095 JP $ABB4        ; Jump to #R$ABB4.
; The same hang, offset right, for type #N$A0.
@label=Handler_SidewaysMissileFlame_HangRight
 $B098 LD A,($6108)    ; Fetch #R$6108.
 $B09B CP $A0          ; {Jump to #R$B0C9 if the type is not #N$A0.
 $B09D JR NZ,$B0C9     ; }
; Alternate the flame frame and colour.
 $B09F LD A,(IX+$00)   ; Fetch the actor type.
 $B0A2 XOR %00000001   ; Flip bit 0.
 $B0A4 LD (IX+$00),A   ; Write it back.
 $B0A7 LD A,(IX+$07)   ; Fetch the actor colour.
 $B0AA XOR %00000100   ; Flip bit 2.
 $B0AC LD (IX+$07),A   ; Write it back.
; Match the flame Y to the missile Y.
 $B0AF LD A,($610C)    ; Fetch #R$6108(#N$610C).
 $B0B2 LD (IX+$04),A   ; Write it as the actor Y.
; Place the flame to the right of the missile's world X.
 $B0B5 LD HL,($610A)   ; Fetch #R$6108(#N$610A).
 $B0B8 LD BC,$0014     ; {Add a #N$14 offset.
 $B0BB ADD HL,BC       ; }
 $B0BC LD A,H          ; Fetch the high byte.
 $B0BD AND %00011111   ; Keep only bits 0-4.
 $B0BF LD H,A          ; Write it back.
 $B0C0 LD (IX+$02),L   ; Write the low byte as the actor world X.
 $B0C3 LD (IX+$03),H   ; Write the high byte.
 $B0C6 JP $ABB4        ; Jump to #R$ABB4.
; Free this flame's slot because the missile is gone.
@label=Handler_Missile_HideActor
*$B0C9 CALL $8640      ; Call #R$8640.
 $B0CC LD (IX+$00),$00 ; Write #N$00 to the actor type.
 $B0D0 RET             ; Return.

; Test Target Range
;
; Used by the routines at #R$AF1C and #R$B128.
; .
; Return carry if this actor is close enough to its target: Jetman
; when he is riding the rover, otherwise the parked rover. The world X
; difference is scaled by #N$08 and must be less than #N($00C0,$04,$04) and
; the target must be #N$00-#N$1F below the actor.
;
; IX Actor slot
@label=Handler_Missile_TestJetmanRange
c$B0D1 LD A,($6078)  ; Fetch #R$6078.
; Types #N$12-#N$19 are Jetman seated on the rover;
; use his slot. Otherwise use the rover slot when its
; type is in #N$1A-#N$29.
 $B0D4 SUB $12       ; Subtract #N$12.
 $B0D6 CP $08        ; {Jump to #R$B112 if Jetman is seated.
 $B0D8 JR C,$B112    ; }
 $B0DA LD A,($6090)  ; Fetch #R$6090.
 $B0DD SUB $1A       ; Subtract #N$1A.
 $B0DF CP $10        ; {Jump to #R$B11B if that is not a rover frame.
 $B0E1 JR NC,$B11B   ; }
 $B0E3 LD HL,($6092) ; Fetch #R$6092.
 $B0E6 LD A,($6094)  ; Fetch the rover Y.
 $B0E9 LD C,A        ; Stash it in #REGc.
; Scale both world X values and test the horizontal range.
@label=Handler_Missile_ScaleTargetX
*$B0EA ADD HL,HL     ; {Multiply the target world X by #N$08.
 $B0EB ADD HL,HL     ;
 $B0EC ADD HL,HL     ; }
 $B0ED LD E,(IX+$02) ; Fetch the actor world X.
 $B0F0 LD D,(IX+$03) ; Fetch the high byte.
 $B0F3 EX DE,HL      ; Switch the pairs.
 $B0F4 ADD HL,HL     ; {Multiply the actor world X by #N$08.
 $B0F5 ADD HL,HL     ;
 $B0F6 ADD HL,HL     ; }
; Take the absolute horizontal distance between the two scaled
; X values.
 $B0F7 AND A         ; {Subtract the target world X.
 $B0F8 SBC HL,DE     ; }
 $B0FA LD A,H        ; Fetch the high byte of the difference.
 $B0FB AND A         ; {Jump to #R$B102 if the result is positive.
 $B0FC JP P,$B102    ; }
 $B0FF CALL $8947    ; Call #R$8947.
; Return unless the actor is within the horizontal range.
@label=Handler_Missile_SubtractRange
*$B102 LD DE,$00C0   ; #REGde=#N($00C0,$04,$04).
 $B105 AND A         ; {Subtract the range.
 $B106 SBC HL,DE     ; }
 $B108 RET NC        ; Return if the actor is too far away.
; Test the vertical distance to the target.
 $B109 LD A,(IX+$04) ; Fetch the actor Y.
 $B10C SUB C         ; Subtract the target Y.
 $B10D NEG           ; Negate the difference.
 $B10F CP $20        ; Compare it against #N$20.
 $B111 RET           ; Return.
; Use Jetman's position as the target when he is seated.
@label=Handler_Missile_FetchJetman
*$B112 LD HL,($607A) ; Fetch #R$607A.
 $B115 LD A,($607C)  ; Fetch #R$607C.
 $B118 LD C,A        ; Stash it in #REGc.
 $B119 JR $B0EA      ; Jump to #R$B0EA.
@label=Handler_Missile_OutOfRange
*$B11B AND A         ; {Return with the carry flag clear.
 $B11C RET           ; }

; Explode Object Slots
;
; Used by the routine at #R$B128.
; .
; Turn the object slots at #R$6108 and #R$6138 into explosions (type
; #N$5C), then jump to #R$AFE9.
@label=Handler_Missile_ExplodeObjects
c$B11D LD A,$5C      ; #REGa=#N$5C.
 $B11F LD ($6108),A  ; Write it to #R$6108.
 $B122 LD ($6138),A  ; Write it to #R$6138.
 $B125 JP $AFE9      ; Jump to #R$AFE9.

; Handler: Alien Base Plasma
;
; Handle the alien base plasma (types #N$90-#N$97). Jump to #R$B11D
; when it is close enough to its target (#R$B0D1). Otherwise kill Jetman if he
; is close (#R$B2D7), try to spawn a linked #N$C8 object (#R$A53A), step the
; frame through #N$90-#N$97 and colour the sprite.
;
; IX Actor slot
@label=Handler_AlienBasePlasma
c$B128 CALL $B0D1    ; Call #R$B0D1.
 $B12B JP C,$B11D    ; Jump to #R$B11D if this actor is in range.
 $B12E CALL $B2A2    ; Call #R$B2A2.
 $B131 CALL C,$B2D7  ; Call #R$B2D7 if Jetman is close enough.
 $B134 CALL $A53A    ; Call #R$A53A.
; Step the actor type through #N$90-#N$97.
 $B137 LD A,(IX+$00) ; Fetch the actor type.
 $B13A INC A         ; Increase it by one.
 $B13B AND %00000111 ; Keep only bits 0-2.
; Sprite IDs begin at #R$E533(#N$90) (#SPRITENAME$90).
 $B13D ADD A,$90     ; Add #N$90.
 $B13F LD (IX+$00),A ; Write it back.
 $B142 CALL $8701    ; Call #R$8701.
; Colour the sprite with the actor colour.
 $B145 LD L,(IX+$01) ; Fetch the actor screen column.
 $B148 LD H,(IX+$04) ; Fetch the actor Y.
 $B14B CALL $8506    ; Call #R$8506.
 $B14E LD D,(IX+$07) ; Fetch the actor colour.
 $B151 LD C,$02      ; #REGc=#N$02.
 $B153 LD A,($5E57)  ; Fetch #R$5E57.
 $B156 AND A         ; {Return if it is zero.
 $B157 RET Z         ; }
 $B158 LD B,A        ; Copy it into the column counter.
 $B159 CALL $8750    ; Call #R$8750.
; Colour one more row with a cycling bright INK.
 $B15C LD A,($5E42)  ; Fetch #R$5E42.
 $B15F RRCA          ; {Rotate it right three times.
 $B160 RRCA          ;
 $B161 RRCA          ; }
 $B162 AND %00000111 ; Keep only bits 0-2.
 $B164 JR NZ,$B167   ; {Jump to #R$B167 if the result is not zero,
 $B166 INC A         ; else force #N$01.}
@label=Handler_Missile_SetBrightColour
*$B167 OR %01000000  ; Set bit 6.
 $B169 LD D,A        ; Copy the colour into #REGd.
 $B16A LD C,$01      ; #REGc=#N$01.
 $B16C JP $8750      ; Jump to #R$8750.

; Convert Object Slots
;
; Used by the routines at #R$ABBA and #R$B810.
; .
; Turn the object slots at #R$6108 and #R$6138 into craters (type
; #N$C0) if they are in use. Turn #R$6120 and #R$6150 into small explosions
; (type #N$64) if their type is #N$C8-#N$CB. Then jump to #R$B960.
@label=Handler_Missile_ConvertExploding
c$B16F LD A,($6108)  ; Fetch #R$6108.
 $B172 AND A         ; {Jump to #R$B17A if it is free.
 $B173 JR Z,$B17A    ; }
 $B175 LD A,$C0      ; {Write #N$C0 to #R$6108.
 $B177 LD ($6108),A  ; }
@label=Handler_Missile_ClearSlot3
*$B17A LD A,($6138)  ; Fetch #R$6138.
 $B17D AND A         ; {Jump to #R$B185 if it is free.
 $B17E JR Z,$B185    ; }
 $B180 LD A,$C0      ; {Write #N$C0 to #R$6138.
 $B182 LD ($6138),A  ; }
; Turn the #N$C8-#N$CB slots into small explosions.
@label=Handler_Missile_TestSlot2
*$B185 LD A,($6120)  ; Fetch #R$6120.
 $B188 SUB $C8       ; Subtract #N$C8.
 $B18A CP $04        ; {Jump to #R$B193 if that is at least #N$04.
 $B18C JR NC,$B193   ; }
 $B18E LD A,$64      ; {Write #N$64 to #R$6120.
 $B190 LD ($6120),A  ; }
@label=Handler_Missile_TestSlot4
*$B193 LD A,($6150)  ; Fetch #R$6150.
 $B196 SUB $C8       ; Subtract #N$C8.
 $B198 CP $04        ; {Jump to #R$B1A1 if that is at least #N$04.
 $B19A JR NC,$B1A1   ; }
 $B19C LD A,$64      ; {Write #N$64 to #R$6150.
 $B19E LD ($6150),A  ; }
@label=Handler_Missile_CopyExplosion
*$B1A1 JP $B960      ; Jump to #R$B960.

; Animate Crater
;
; Step a crater sprite, then stamp terrain when the frame
; reaches #N$C8.
;
; IX Actor slot
;
; Step the crater frame on even frames, then stamp the terrain when
; it reaches #N$C8.
@label=AnimateCrater
c$B1A4 CALL $ABB4      ; Call #R$ABB4.
 $B1A7 LD A,($5E42)    ; Fetch #R$5E42.
 $B1AA AND %00000001   ; Keep only bit 0.
 $B1AC RET NZ          ; Return if this is an odd frame.
 $B1AD INC (IX+$00)    ; Increase the actor type by one.
 $B1B0 LD A,(IX+$00)   ; Fetch the actor type.
 $B1B3 CP $C8          ; {Return if it is not #N$C8.
 $B1B5 RET NZ          ; }
; Stamp the crater into the terrain and change the actor type.
 $B1B6 CALL $95B6      ; Call #R$95B6.
 $B1B9 LD (IX+$00),$63 ; Write #N$63 to the actor type.
; Return unless this actor is in Jetman's slot.
 $B1BD PUSH IX         ; {Copy the slot pointer into #REGhl (using the
 $B1BF POP HL          ; stack).}
 $B1C0 LD BC,$6078     ; Set #REGbc to Jetman's slot address #R$6078.
 $B1C3 AND A           ; {Subtract Jetman's slot address.
 $B1C4 SBC HL,BC       ; }
 $B1C6 RET NZ          ; Return if this is not Jetman.
 $B1C7 CALL $8640      ; Call #R$8640.
 $B1CA LD (IX+$00),$81 ; Write #N$81 to the actor type.
 $B1CE LD (IX+$05),$40 ; Write #N$40 to the actor speed.
 $B1D2 RET             ; Return.

; Scan Object Slots
;
; Used by the routine at #R$AC39.
; .
; OR together the types of the #N$18-byte object slots from #R$6108
; (four, or six from #R$B1E2). Return with the zero flag set if all are free.
;
; .
;
; OR together the object-slot types starting at #R$6108.
@label=ScanObjectSlots
c$B1D3 LD HL,$6108   ; #REGhl=#R$6108.
 $B1D6 LD B,$04      ; Set a slot counter in #REGb for #N$04 loops.
; Merge the types of the slots, stepping over each slot in turn.
@label=ScanObjectSlots_Loop
*$B1D8 LD DE,$0018   ; #REGde=#N($0018,$04,$04).
 $B1DB XOR A         ; Clear #REGa.
@label=ScanObjectSlots_MergeType
*$B1DC OR (HL)       ; Merge in the current slot type.
 $B1DD ADD HL,DE     ; Move onto the next slot.
 $B1DE DJNZ $B1DC    ; Decrease the slot counter by one and loop back
                     ; to #R$B1DC until every slot is tested.
 $B1E0 OR A          ; Test the merged types.
 $B1E1 RET           ; Return.
; This entry point is used by the routine at #R$9F70.
; .
; Scan six slots instead of four.
@label=ScanObjectSlots_Test
*$B1E2 LD HL,$6108   ; #REGhl=#R$6108.
 $B1E5 LD B,$06      ; #REGb=#N$06.
 $B1E7 JR $B1D8      ; Jump to #R$B1D8.

; Advance Position
;
; Used by the routine at #R$B218.
; .
; Add the horizontal speed to the fractional X accumulator in
; *#REGix+#N$10 (bits 1-3 only) and add the carried step to the world X at
; #R$B246. #R$B1FD does the same for the vertical thrust, using
; *#REGix+#N$11 and continues at #R$B272.
;
; A Horizontal speed
; IX Actor slot
;
; Add the speed to the fraction and keep the carry as the step.
@label=AdvanceAnimation
c$B1E9 ADD A,(IX+$10) ; #REGa+=*#REGix+#N$10.
 $B1EC LD C,A         ; #REGc=#REGa.
 $B1ED AND %00001110  ; Keep only bits 1-3.
 $B1EF LD (IX+$10),A  ; Write #REGa to *#REGix+#N$10.
; Rotate the carry bits of the sum down to make the whole step.
 $B1F2 LD A,C         ; Copy the sum into #REGa.
 $B1F3 RRCA           ; {Rotate the high nibble down into bits 0-3.
 $B1F4 RRCA           ;
 $B1F5 RRCA           ;
 $B1F6 RRCA           ; }
 $B1F7 AND %00001111  ; Keep only bits 0-3.
 $B1F9 LD B,$00       ; Clear #REGb.
 $B1FB JR $B246       ; Jump to #R$B246.
; This entry point is used by the routine at #R$B218.
; .
; Add the vertical thrust to the Y fraction in the same way.
@label=AdvanceAnimation_AddYNibble
*$B1FD ADD A,(IX+$11) ; Add the Y nibble.
 $B200 LD C,A         ; Stash the sum in #REGc.
 $B201 AND %00001111  ; Keep only bits 0-3.
 $B203 LD (IX+$11),A  ; Write it back as the Y nibble.
 $B206 LD A,C         ; Copy the sum into #REGa.
 $B207 RRCA           ; {Rotate the high nibble down into bits 0-3.
 $B208 RRCA           ;
 $B209 RRCA           ;
 $B20A RRCA           ; }
 $B20B AND %00001111  ; Keep only bits 0-3.
 $B20D JR $B272       ; Jump to #R$B272.

; Score Small Hit
;
; Used by the routine at #R$B218.
; .
; Add #N$25 points and start the explosion at #R$A73C.
;
; IX Actor slot
;
; Add #N$25 points and start the explosion at #R$A73C.
@label=ScoreSmallHit
c$B20F LD BC,$0025   ; Set the points to award in #REGbc to #N($0025,$04,$04).
 $B212 CALL $899C    ; Call #R$899C.
 $B215 JP $A73C      ; Jump to #R$A73C.

; Tick Then Explode
;
; Move the actor by its fractional speed and thrust and cycle its
; frame. Start #R$A73C when the timer at *#REGix+#N$08 reaches zero, when the
; actor reaches the ground or leaves the top of the play area, or when it
; touches Jetman.
;
; IX Actor slot
;
; Decrease the actor timer and explode when it reaches zero.
@label=TickThenExplode
c$B218 BIT 0,(IX+$10) ; {Jump to #R$B20F if bit 0 of the explode flag is
 $B21C JP NZ,$B20F    ; set.}
 $B21F DEC (IX+$08)   ; Decrease the actor timer by one.
 $B222 JP Z,$A73C     ; Jump to #R$A73C if it is now zero.
; Work out the horizontal step from the actor speed.
 $B225 LD A,(IX+$05)  ; Fetch the actor speed.
 $B228 AND A          ; {Jump to #R$B1E9 if the speed is positive.
 $B229 JP P,$B1E9     ; }
; Add a negative speed to the X fraction and make the step
; negative.
 $B22C ADD A,(IX+$10) ; Add the X nibble.
 $B22F LD C,A         ; Stash the sum in #REGc.
 $B230 AND %00001111  ; Keep only bits 0-3.
 $B232 NEG            ; Negate it.
 $B234 AND %11111110  ; Reset bit 0.
 $B236 LD (IX+$10),A  ; Write it back as the X nibble.
; Turn the carried bits of the sum into the negative step.
 $B239 LD A,C         ; Copy the sum into #REGa.
 $B23A NEG            ; Negate it.
 $B23C RRCA           ; {Rotate the high nibble down into bits 0-3.
 $B23D RRCA           ;
 $B23E RRCA           ;
 $B23F RRCA           ; }
 $B240 AND %00001111  ; Keep only bits 0-3.
 $B242 NEG            ; Negate it.
 $B244 LD B,$FF       ; #REGb=#N$FF.
; This entry point is used by the routine at #R$B1E9.
; .
; Move the world X by the step and wrap it.
@label=TickThenExplode_AddX
*$B246 ADD A,(IX+$02) ; Add the step to the world X.
 $B249 LD (IX+$02),A  ; Write it back.
 $B24C LD A,(IX+$03)  ; Fetch the high byte.
 $B24F ADC A,B        ; Add the sign.
 $B250 AND %00011111  ; Keep only bits 0-4.
 $B252 LD (IX+$03),A  ; Write the high byte back.
; Work out the vertical step from the actor thrust.
 $B255 LD A,(IX+$06)  ; Fetch the actor thrust.
 $B258 AND A          ; {Jump to #R$B1FD if the thrust is positive.
 $B259 JP P,$B1FD     ; }
; Add a negative thrust to the Y fraction and make the step
; negative.
 $B25C ADD A,(IX+$11) ; Add the Y nibble.
 $B25F LD C,A         ; Stash the sum in #REGc.
 $B260 AND %00001111  ; Keep only bits 0-3.
 $B262 NEG            ; Negate it.
 $B264 LD (IX+$11),A  ; Write it back as the Y nibble.
; Turn the carried bits of the sum into the negative step.
 $B267 LD A,C         ; Copy the sum into #REGa.
 $B268 NEG            ; Negate it.
 $B26A RRCA           ; {Rotate the high nibble down into bits 0-3.
 $B26B RRCA           ;
 $B26C RRCA           ;
 $B26D RRCA           ; }
 $B26E AND %00001111  ; Keep only bits 0-3.
 $B270 NEG            ; Negate it.
; This entry point is used by the routine at #R$B1E9.
; .
; Move the actor Y, exploding on the ground or above the
; play area.
@label=TickThenExplode_AddY
*$B272 ADD A,(IX+$04) ; Add the step to the actor Y.
 $B275 CP $AF         ; {Jump to #R$A73C if the actor is on the ground.
 $B277 JP NC,$A73C    ; }
 $B27A CP $30         ; {Jump to #R$A73C if the actor is above the play area.
 $B27C JP C,$A73C     ; }
 $B27F LD (IX+$04),A  ; Write the new Y.
; Advance the frame within the actor's type family.
 $B282 LD A,(IX+$00)  ; Fetch the actor type.
 $B285 AND %11111100  ; Keep only bits 2-7.
 $B287 LD C,A         ; Stash the family in #REGc.
 $B288 LD A,(IX+$00)  ; Fetch the actor type.
 $B28B INC A          ; Increase it by one.
 $B28C AND %00000011  ; Keep only bits 0-1.
 $B28E OR C           ; Merge the family back in.
 $B28F LD (IX+$00),A  ; Write it to the actor type.
; Draw the sprite and write its attributes.
 $B292 CALL $8B73     ; Call #R$8B73.
 $B295 CALL $8733     ; Call #R$8733.
; Explode the actor if it is touching Jetman.
 $B298 CALL $B2A2     ; Call #R$B2A2.
 $B29B RET NC         ; Return if Jetman is out of range.
 $B29C CALL $B2D7     ; Call #R$B2D7.
 $B29F JP $A73C       ; Jump to #R$A73C.

; Test Jetman Range
;
; Used by the routines at #R$9531, #R$9BBB, #R$ADAB, #R$AF1C, #R$B128 and
; #R$B218.
; .
; Return carry if this actor is touching Jetman. This entry uses a
; vertical range of #N$0E; #R$B2A4 takes the range in #REGe. Carry is clear
; while the delay timer at #R$5E67 is running or Jetman's type is #N$11 or
; above.
;
; IX Actor slot
@label=TickThenExplode_CloseRange
c$B2A2 LD E,$0E      ; #REGe=#N$0E.
; This entry point is used by the routines at #R$ABBA, #R$AD59 and #R$AE37.
; .
; Return carry if this actor is close enough to Jetman.
; Type #N$11 and above means Jetman is not on foot.
@label=TickThenExplode_TestJetman
*$B2A4 LD A,($5E67)  ; Fetch #R$5E67.
 $B2A7 AND A         ; {Return if the delay timer is still running.
 $B2A8 RET NZ        ; }
 $B2A9 LD A,($6078)  ; Fetch #R$6078.
 $B2AC CP $11        ; {Return if Jetman's type is at least #N$11.
 $B2AE RET NC        ; }
; Test the horizontal distance to Jetman.
 $B2AF LD L,(IX+$02) ; Fetch the actor world X.
 $B2B2 LD H,(IX+$03) ; Fetch the high byte.
 $B2B5 LD BC,$0008   ; {Add an #N$08 box offset.
 $B2B8 ADD HL,BC     ; }
 $B2B9 LD BC,($607A) ; Fetch #R$607A.
 $B2BD AND A         ; {Subtract Jetman's world X.
 $B2BE SBC HL,BC     ; }
 $B2C0 LD A,H        ; Fetch the high byte of the difference.
 $B2C1 AND %00011111 ; Keep only bits 0-4.
 $B2C3 RET NZ        ; Return if they are on different screens.
 $B2C4 LD A,L        ; Fetch the low byte.
 $B2C5 CP $10        ; {Return if it is at least #N$10.
 $B2C7 RET NC        ; }
; Work out the vertical gap to Jetman.
 $B2C8 LD A,($607C)  ; Fetch #R$607C.
 $B2CB SUB $04       ; Subtract #N$04.
 $B2CD SUB (IX+$04)  ; Subtract the actor Y.
; #REGa is (Jetman's Y minus #N$04) minus this actor's Y. Keep
; that gap as a positive distance, then compare it with #REGe.
; .
; See #POKE(immunity,Immunity).
@label=TickThenExplode_TestHeight
 $B2D0 JP P,$B2D5    ; Jump to #R$B2D5 if Jetman is at or below this actor.
 $B2D3 NEG           ; Else make the vertical gap positive.
; See #POKE(immunity,Immunity).
@label=TickThenExplode_Compare
*$B2D5 CP E          ; {Return. Carry is set when the gap is smaller
 $B2D6 RET           ; than #REGe.}

; Kill Jetman
;
; Used by the routines at #R$9531, #R$9BBB, #R$ABBA, #R$AD59, #R$ADAB, #R$AE37,
; #R$AF1C, #R$B128 and #R$B218.
; .
; Turn Jetman into the dying type (#N$DC) and bounce him away, then
; continue into #R$B2F9.
;
; IX Actor slot
@label=TickThenExplode_KillJetman
c$B2D7 LD DE,$B9E7   ; #REGde=#R$B9DA(#N$B9E7).
 $B2DA CALL $B9BC    ; Call #R$B9BC.
 $B2DD LD HL,$6078   ; #REGhl=#R$6078.
 $B2E0 LD (HL),$DC   ; Write #N$DC as Jetman's type.
; Pick the bounce direction from the actor screen column.
 $B2E2 LD HL,$607D   ; #REGhl=#R$607D.
 $B2E5 LD A,(IX+$01) ; Fetch the actor screen column.
 $B2E8 CP $78        ; {Jump to #R$B339 if it is less than #N$78.
 $B2EA JR C,$B339    ; }
 $B2EC LD (HL),$C0   ; Write #N$C0 as Jetman's speed.
; This entry point is used by the routine at #R$B339.
; .
; Set Jetman's thrust, then write #N$06 into two bytes of his
; slot.
@label=TickThenExplode_Loop
*$B2EE INC HL        ; Move onto Jetman's thrust.
 $B2EF LD (HL),$01   ; Write #N$01 as Jetman's thrust.
 $B2F1 LD HL,$608A   ; #REGhl=#R$6080(#N$608A).
 $B2F4 LD (HL),$06   ; Write #N$06.
 $B2F6 INC HL        ; Move onto the next byte.
 $B2F7 LD (HL),$06   ; Write #N$06.

; Drop World Objects
;
; Used by the routine at #R$A826.
; .
; Set bit 7 (falling) on world slots 1 and 2 unless they are carried,
; clear the low flag bits of slot 3, update the bomb flags and turn an
; occupied slot 4 into a platform.
;
; .
;
; Set bit 7 (falling) on world slot 1 unless bit 3 (carried) is set.
@label=HideDistantObjects
c$B2F9 LD A,($60B0)  ; Fetch #R$60B0.
 $B2FC BIT 3,A       ; {Jump to #R$B305 if bit 3 is set.
 $B2FE JR NZ,$B305   ; }
 $B300 OR %10000000  ; Set bit 7.
 $B302 LD ($60B0),A  ; Write it back.
; Do the same for world slot 2.
@label=HideDistantObjects_Slot2Flags
*$B305 LD A,($60C8)  ; Fetch #R$60C8.
 $B308 BIT 3,A       ; {Jump to #R$B311 if bit 3 is set.
 $B30A JR NZ,$B311   ; }
 $B30C OR %10000000  ; Set bit 7.
 $B30E LD ($60C8),A  ; Write it back.
; Clear bits 0-1 of the flags of world slot 3.
@label=HideDistantObjects_Slot3Flags
*$B311 LD A,($60E0)  ; Fetch #R$60E0.
 $B314 AND %11111100 ; Keep only bits 2-7.
 $B316 LD ($60E0),A  ; Write it back.
; Update the bomb flag when it is not on the ground.
 $B319 LD A,($61A0)  ; Fetch #R$6198(#N$61A0).
 $B31C BIT 2,A       ; {Jump to #R$B32B if bit 2 is set.
 $B31E JR NZ,$B32B   ; }
 $B320 LD A,($619C)  ; Fetch #R$6198(#N$619C).
 $B323 CP $AF        ; Compare it against #N$AF.
 $B325 LD A,$00      ; #REGa=#N$00.
 $B327 JR Z,$B32B    ; Jump to #R$B32B if they are equal.
 $B329 OR %00000010  ; Set bit 1.
@label=HideDistantObjects_WriteBomb
*$B32B LD ($61A0),A  ; Write it to #R$6198(#N$61A0).
; Turn world slot 4 into a platform if it is occupied.
 $B32E LD A,($60F0)  ; Fetch #R$60F0.
 $B331 AND A         ; {Return if it is free.
 $B332 RET Z         ; }
 $B333 LD A,$2F      ; {Write #N$2F to #R$60F0.
 $B335 LD ($60F0),A  ; }
 $B338 RET           ; Return.

; Bounce Jetman Right
;
; Used by the routine at #R$B2D7.
; .
; Write #N$40 as Jetman's horizontal speed so he bounces away to the
; right, then rejoin #R$B2EE.
;
; HL #R$607D (Jetman's horizontal speed)
@label=BounceJetmanRight
c$B339 LD (HL),$40   ; Write #N$40 to *#REGhl.
 $B33B JR $B2EE      ; Jump to #R$B2EE.

; Tick Actor Frame
;
; Decrease *#REGix+#N($12), apply speed, and redraw the actor.
;
; IX Actor slot
;
; Reload the frame timer, or apply speed and redraw.
@label=TickActorFrame
c$B33D DEC (IX+$12)   ; {Jump to #R$B357 if the frame timer is not zero.
 $B340 JR NZ,$B357    ; }
 $B342 LD A,(IX+$13)  ; Fetch *#REGix+#N$13.
 $B345 LD (IX+$12),A  ; Reload the frame timer.
 $B348 INC (IX+$06)   ; Increase the actor thrust by one.
 $B34B LD A,(IX+$05)  ; Fetch the actor speed.
 $B34E AND A          ; {Jump to #R$B357 if the speed is zero.
 $B34F JR Z,$B357     ; }
 $B351 JP P,$B356     ; Jump to #R$B356 if the speed is positive.
 $B354 INC A          ; {Increase the speed by two.
 $B355 INC A          ; }
@label=TickActorFrame_DecreaseSpeed
*$B356 DEC A          ; Decrease the speed by one.
; Apply the speed, then drop the actor by its thrust.
@label=TickActorFrame_ApplyMotion
*$B357 CALL $907B     ; Call #R$907B.
 $B35A LD A,(IX+$04)  ; Fetch the actor Y.
 $B35D ADD A,(IX+$06) ; Add the thrust.
 $B360 CP $AF         ; {Jump to #R$B37B if the actor has reached the
 $B362 JR NC,$B37B    ; ground line.}
 $B364 LD (IX+$04),A  ; Write the new Y.
 $B367 LD C,A         ; Stash it in #REGc.
 $B368 LD D,$03       ; #REGd=#N$03.
 $B36A CALL $B8CD     ; Call #R$B8CD.
; Pick the dying frame from the frame counter and redraw.
 $B36D LD A,($5E42)   ; Fetch #R$5E42.
 $B370 RRCA           ; Rotate it right once.
 $B371 AND %00000011  ; Keep only bits 0-1.
; Sprite IDs begin at #R$E910(#N$DC) (#SPRITENAME$DC).
 $B373 ADD A,$DC      ; Add #N$DC for the dying frames.
 $B375 LD (IX+$00),A  ; Write it to the actor type.
 $B378 JP $ABB4       ; Jump to #R$ABB4.

; Explode At Ground
;
; Used by the routine at #R$B33D.
; .
; Place the actor on the ground and start #R$A75D.
;
; IX Actor slot
;
; Place the actor on the ground line at Y=#N$AF
; and start #R$A75D.
@label=ExplodeAtGround
c$B37B LD (IX+$04),$AF ; Write #N$AF to the actor Y.
 $B37F CALL $A75D      ; Call #R$A75D.
 $B382 JP $ABB4        ; Jump to #R$ABB4.

; Reset Alien States
;
; Used by the routines at #R$A826 and #R$B52E.
; .
; Writes #N$00 to every alien state to clear it.
@label=ResetAlienStates
c$B385 LD HL,$61B0   ; #REGhl=#R$61B0.
; There are six alien slots, each is #N$18 bytes long.
 $B388 LD B,$90      ; Set a byte counter in #REGb for #N$90 loops.
@label=ResetAlienStates_Loop
*$B38A LD (HL),$00   ; Write #N$00 to *#REGhl.
 $B38C INC HL        ; Increment #REGhl by one.
 $B38D DJNZ $B38A    ; Decrease the counter by one and jump back to
                     ; #R$B38A until it is zero.
 $B38F RET           ; Return.

; Count Death Timer
;
; Tick the actor's death countdown and lose a life when it
; reaches zero.
;
; IX Actor slot
;
; Tick the death countdown and lose a life when it expires.
@label=CountDeathTimer
c$B390 LD A,($5E6C)  ; {Return if #R$5E6C is not zero.
 $B393 AND A         ;
 $B394 RET NZ        ; }
 $B395 DEC (IX+$05)  ; Decrease *#REGix+#N$05 by one.
 $B398 RET NZ        ; Return if the result is above zero.
 $B399 JP $A8B5      ; Jump to #R$A8B5.
; Same death countdown for type #N($85), without the #R$5E6C test.
@label=CountDeathTimer_Unconditional
 $B39C DEC (IX+$05)  ; Decrease *#REGix+#N$05 by one.
 $B39F RET NZ        ; Return if the result is above zero.
 $B3A0 JP $A8B5      ; Jump to #R$A8B5.

; Message: Teleporting
;
; Used by the routine at #R$A299.
; .
; Blanks the play area, then prints the "TELEPORTING" message
; repeatedly while cycling its INK colour, playing a tone on each pass.
;
; .
;
; Blank the play area and start the TELEPORTING cycle.
@label=MessageTeleporting
c$B3A3 DI            ; Disable interrupts.
 $B3A4 CALL $8BA5    ; Call #R$8BA5.
 $B3A7 LD B,$10      ; Set a colour cycle counter in #REGb for #N$10 loops.
@label=MessageTeleporting_Loop
*$B3A9 PUSH BC       ; Stash #REGbc (the colour cycling counter) on the stack.
; Handle printing "#FONTaddr=$D347,attr=$41,chars=0(TELEPORTING)(teleporting)"
; messaging.
 $B3AA LD HL,$7058   ; #REGhl=#N$7058 (screen location).
 $B3AD LD DE,$B3D0   ; #REGde=#R$B3D0.
 $B3B0 CALL $8A11    ; Call #R$8A11.
; Pause so the player can read the message. This
; inner loop runs once per INK change, so the wait is
; #N($2000,$04,$04)*#N$10.
 $B3B3 LD HL,$2000   ; #REGhl=#N($2000, $04, $04) (counter).
@label=Teleporting_Pause
*$B3B6 DEC HL        ; Decrease #REGhl by one.
 $B3B7 LD A,L        ; {Jump back to #R$B3B6 until #REGhl is zero.
 $B3B8 OR H          ;
 $B3B9 JR NZ,$B3B6   ; }
; Handle cycling the text INK colour.
 $B3BB LD A,($B3D0)  ; #REGa=the attribute byte of #R$B3D0.
 $B3BE INC A         ; Increment #REGa by one.
 $B3BF AND %00000111 ; Keep only bits 0-2 (INK).
 $B3C1 JR NZ,$B3C4   ; Jump to #R$B3C4 if #REGa was not zero.
 $B3C3 INC A         ; Increment #REGa by one.
@label=MessageTeleporting_SetBright
*$B3C4 OR %01000000  ; Set bit 6 (BRIGHT).
 $B3C6 LD ($B3D0),A  ; Store #REGa at #R$B3D0 to overwrite the attribute byte.
; Restore the counter, play the repeated tone and loop until
; the counter is zero.
 $B3C9 POP BC        ; Restore #REGbc (the colour cycling counter) from the
                     ; stack.
 $B3CA CALL $B8E8    ; Call #R$B8E8.
 $B3CD DJNZ $B3A9    ; Decrease the counter by one and jump back to
                     ; #R$B3A9 until it is zero.
 $B3CF RET           ; Return.

; Messaging: Teleporting
;
; .
;
; .
;
; #FONTaddr=$D347,attr=$41,chars=0(TELEPORTING)(teleporting)
@label=String_Teleporting
t$B3D0 DEFM $41                  ; {Attribute: #COLOUR(#PEEK(#PC)) +
 $B3D1 DEFM "TELEPORTIN","G"+$80 ; "TELEPORTING".}

; Initialise Terrain
;
; Used by the routine at #R$A84C.
; .
; Copy the default terrain data into #R$7000.
@label=Terrain_Initialise
c$B3DC LD HL,$F6CE   ; {Copy the #N$0400 bytes of default terrain data from #R$F6CE to
 $B3DF LD DE,$7000   ; #R$7000.
 $B3E2 LD BC,$0400   ;
 $B3E5 LDIR          ; }
 $B3E7 RET           ; Return.

; Handler: Jetman Death
;
; Flash the dying actor from the frame timer, then convert
; the slot to type #N$85.
;
; IX Actor slot
;
; Flash the dying actor from the frame timer.
@label=Handler_JetmanDeath
c$B3E8 LD A,($5E42)                         ; Fetch #R$5E42.
 $B3EB CPL                                  ; Invert the bits.
 $B3EC AND %00000001                        ; Keep only bit 0.
 $B3EE JR Z,$B3F5                           ; Jump to #R$B3F5 if this is an odd
                                            ; frame.
 $B3F0 DEC (IX+$08)                         ; {Jump to #R$B441 if the death
 $B3F3 JR Z,$B441                           ; timer is now zero.}
; Pick a death-frame triplet and apply its X/Y offsets.
@label=Handler_JetmanDeath_TripleTimer
*$B3F5 LD A,(IX+$08)                        ; Fetch the death timer.
 $B3F8 LD C,A                               ; Stash it in #REGc.
 $B3F9 ADD A,A                              ; Double it.
 $B3FA ADD A,C                              ; Add the original.
 $B3FB LD L,A                               ; {Create an offset in #REGhl.
 $B3FC LD H,$00                             ; }
 $B3FE LD BC,$B451                          ; {Point #REGhl at that triplet,
 $B401 ADD HL,BC                            ; offset from #R$B451.}
; Fetch the frame byte and write it as the actor type.
 $B402 EX DE,HL                             ; Switch the table pointer into
                                            ; #REGde.
 $B403 LD A,(DE)                            ; {Copy the next table byte.
 $B404 INC DE                               ; }
; Sprite IDs begin at #R$EA8D(#N$E0) (#SPRITENAME$E0).
 $B405 ADD A,$E0                            ; Add #N$E0 for the dying frames.
 $B407 LD (IX+$00),A                        ; Write it to the actor type.
; Offset the actor world X by the table value.
 $B40A LD L,(IX+$02)                        ; Fetch the actor world X.
 $B40D LD H,(IX+$03)                        ; Fetch the high byte.
 $B410 PUSH HL                              ; Stash the world X on the stack.
; Fetch the X offset and sign-extend it.
 $B411 LD A,(DE)                            ; {Copy the next table byte.
 $B412 INC DE                               ; }
 $B413 LD C,A                               ; Copy the X offset into #REGc.
 $B414 LD B,$00                             ; Clear #REGb.
 $B416 AND A                                ; {Jump to #R$B41B if the offset is
 $B417 JP P,$B41B                           ; positive.}
 $B41A DEC B                                ; Sign-extend into #REGb.
@label=Handler_JetmanDeath_WriteX
*$B41B CALL $A002                           ; Call #R$A002.
 $B41E LD (IX+$02),L                        ; Write the low byte as the actor
                                            ; world X.
 $B421 LD (IX+$03),H                        ; Write the high byte.
; Offset the actor Y by the table value.
 $B424 LD A,(IX+$04)                        ; Fetch the actor Y.
 $B427 PUSH AF                              ; Stash it on the stack.
 $B428 LD A,(DE)                            ; Fetch the Y offset.
 $B429 ADD A,(IX+$04)                       ; Add the actor Y.
 $B42C LD (IX+$04),A                        ; Write it back.
; Draw the dying frame, then restore the stored position.
 $B42F CALL $8787                           ; Call #R$8787.
 $B432 CALL $8733                           ; Call #R$8733.
 $B435 POP AF                               ; Restore the actor Y from the
                                            ; stack.
 $B436 LD (IX+$04),A                        ; Write it back.
 $B439 POP HL                               ; Restore the world X from the
                                            ; stack.
 $B43A LD (IX+$02),L                        ; Write the low byte back.
 $B43D LD (IX+$03),H                        ; Write the high byte back.
 $B440 RET                                  ; Return.
; Clear the lives count and become type #N$85.
@label=Handler_JetmanDeath_NoLives
*$B441 CALL $864F                           ; Call #R$864F.
 $B444 XOR A                                ; {Write #N$00 to #R$5EA1.
 $B445 LD ($5EA1),A                         ; }
 $B448 LD (IX+$00),$85                      ; Write #N$85 to the actor type.
 $B44C LD (IX+$05),$40                      ; Write #N$40 to the actor speed.
 $B450 RET                                  ; Return.
@label=Handler_JetmanDeath_Offsets
 $B451 DEFB $00,$00,$00,$00,$18,$FC,$01,$10 ; {Death-frame offsets.
 $B459 DEFB $FA,$02,$08,$FE,$03,$00,$00     ; }

; Handler: Falling Sprite
;
; Tick the sprite delay, move the debris and, once the thrust reaches
; #N($01), play #R$B8CD and become type #N$E7.
;
; IX Actor slot
;
; Reload the delay from *#REGix+#N$11 when it expires.
@label=Handler_FallingSprite
c$B460 DEC (IX+$10)    ; Decrease *#REGix+#N$10 by one.
 $B463 JR NZ,$B475     ; Jump to #R$B475 if it is not zero.
 $B465 LD A,(IX+$11)   ; #REGa=*#REGix+#N$11.
 $B468 LD (IX+$10),A   ; Write #REGa to *#REGix+#N$10.
; Increase the thrust and land once it reaches #N$01.
 $B46B INC (IX+$06)    ; Increment *#REGix+#N$06 by one.
 $B46E LD A,(IX+$06)   ; #REGa=*#REGix+#N$06.
 $B471 CP $01          ; {Jump to #R$B48B if it is #N$01.
 $B473 JR Z,$B48B      ; }
; Step the type (#N$E6 becomes #N($E7), else reset to #N$E4), then move.
@label=Handler_FallingSprite_CycleType
*$B475 LD A,(IX+$00)   ; #REGa=*#REGix+#N$00.
 $B478 INC A           ; Increment #REGa by one.
 $B479 CP $E7          ; {Jump to #R$B47F if #REGa is #N$E7 or higher.
 $B47B JR NC,$B47F     ; }
; "#SPRITENAME$E4".
 $B47D LD A,$E4        ; #REGa=#N$E4.
@label=Handler_FallingSprite_MoveDown
*$B47F LD (IX+$00),A   ; Write #REGa to *#REGix+#N$00.
 $B482 CALL $B6AE      ; Call #R$B6AE.
 $B485 LD (IX+$04),A   ; Write #REGa to *#REGix+#N$04.
 $B488 JP $ABB4        ; Jump to #R$ABB4.
; Play #R$B8CD and become type #N$E7.
@label=Handler_FallingSprite_Land
*$B48B LD C,(IX+$04)   ; #REGc=*#REGix+#N$04.
 $B48E LD D,$04        ; #REGd=#N$04.
 $B490 CALL $B8CD      ; Call #R$B8CD.
; "#SPRITENAME$E7".
 $B493 LD (IX+$00),$E7 ; Write #N$E7 to *#REGix+#N$00.
 $B497 JP $ABB4        ; Jump to #R$ABB4.
; Step the type on and redraw.
@label=Handler_FallingSprite_StepType
 $B49A INC (IX+$00)    ; Increase the actor type by one.
 $B49D JP $ABB4        ; Jump to #R$ABB4.
; Flip the type every eighth frame, then drop.
@label=Handler_FallingSprite_FlipType
 $B4A0 LD A,($5E42)    ; Fetch #R$5E42.
 $B4A3 AND %00000111   ; Keep only bits 0-2.
 $B4A5 JR NZ,$B4AF     ; Jump to #R$B4AF if the result is not zero.
 $B4A7 LD A,(IX+$00)   ; Fetch the actor type.
 $B4AA XOR %00000001   ; Flip bit 0.
 $B4AC LD (IX+$00),A   ; Write it back.
@label=Handler_FallingSprite_IncreaseY
*$B4AF INC (IX+$04)    ; Increase the actor Y by one.
; Remove the sprite once it reaches the ground line.
 $B4B2 LD A,(IX+$04)   ; Fetch the actor Y.
 $B4B5 CP $AF          ; {Jump to #R$ABB4 if it is still above the ground
 $B4B7 JP C,$ABB4      ; line.}
 $B4BA CALL $8640      ; Call #R$8640.
 $B4BD LD (IX+$00),$00 ; Write #N$00 to the actor type.
 $B4C1 RET             ; Return.

; Fill Debris Slots
;
; Used by the routine at #R$B03B.
; .
; Write #N$11 type-#N$E4 slots from #R$60A8 using the
; actor X/Y at #REGde and ROM bytes addressed by #R$5E40.
;
; DE Address of the actor world X and Y
;
; Point #REGhl at the first world slot.
@label=FillDebrisSlots
c$B4C2 LD HL,$60A8   ; #REGhl=#R$60A8.
 $B4C5 LD BC,$0711   ; Set #REGb to #N$07 bytes to clear and #REGc to #N$11
                     ; slots.
; Point #REGhl' at ROM using #R$5E40 as the low byte.
 $B4C8 EXX           ; Switch to the shadow registers.
 $B4C9 LD A,($5E40)  ; Fetch #R$5E40.
 $B4CC LD L,A        ; Copy it into the low byte of #REGhl'.
 $B4CD LD H,$00      ; Clear the high byte of #REGhl'.
 $B4CF EXX           ; Switch back.
; Write type #N$E4 and copy the three-byte X/Y seed.
@label=FillDebrisSlots_Loop
*$B4D0 PUSH BC       ; Stash the slot counters on the stack.
 $B4D1 LD (HL),$E4   ; Write type #N$E4.
 $B4D3 INC HL        ; {Skip the screen-column byte.
 $B4D4 INC HL        ; }
 $B4D5 LD A,(DE)     ; Fetch the low world X.
 $B4D6 LD (HL),A     ; Write it.
 $B4D7 INC DE        ; Advance the seed pointer.
 $B4D8 INC HL        ; Advance the slot pointer.
 $B4D9 LD A,(DE)     ; Fetch the high world X.
 $B4DA LD (HL),A     ; Write it.
 $B4DB INC HL        ; Advance the slot pointer.
 $B4DC INC DE        ; Advance the seed pointer.
 $B4DD LD A,(DE)     ; Fetch the Y.
 $B4DE LD (HL),A     ; Write it.
 $B4DF DEC DE        ; {Rewind the seed pointer by two bytes.
 $B4E0 DEC DE        ; }
 $B4E1 INC HL        ; Advance to the speed byte.
; Take the next ROM byte as the speed.
 $B4E2 EXX           ; Switch to the shadow registers.
 $B4E3 LD A,(HL)     ; Fetch the next ROM byte from *#REGhl'.
 $B4E4 INC HL        ; Advance #REGhl'.
 $B4E5 AND A         ; {Jump to #R$B529 if it is positive.
 $B4E6 JP P,$B529    ; }
 $B4E9 OR %11111100  ; Set bits 2-7.
@label=FillDebrisSlots_WriteSpeed
*$B4EB EXX           ; Switch back.
 $B4EC LD (HL),A     ; Write the speed.
 $B4ED INC HL        ; Advance to the thrust byte.
; Force the thrust into the range #N$FB-#N$FE.
 $B4EE EXX           ; Switch to the shadow registers.
 $B4EF LD A,(HL)     ; Fetch the next ROM byte from *#REGhl'.
 $B4F0 INC HL        ; Advance #REGhl'.
 $B4F1 AND %00000011 ; Keep only bits 0-1.
 $B4F3 OR %11111100  ; Set bits 2-7.
 $B4F5 SUB $01       ; Subtract #N$01.
 $B4F7 EXX           ; Switch back.
 $B4F8 LD (HL),A     ; Write the thrust.
 $B4F9 INC HL        ; Advance to the colour byte.
; Colour is bits 0-2 of the next ROM byte (#N$00 and #N$01 become
; #INK$07), plus BRIGHT.
 $B4FA EXX           ; Switch to the shadow registers.
 $B4FB LD A,(HL)     ; Fetch the next ROM byte from *#REGhl'.
 $B4FC INC HL        ; Advance #REGhl'.
 $B4FD AND %00000111 ; Keep only bits 0-2.
 $B4FF CP $02        ; {Jump to #R$B505 if it is at least #N$02.
 $B501 JR NC,$B505   ; }
 $B503 LD A,$07      ; #REGa=#INK$07.
@label=FillDebrisSlots_SetBright
*$B505 OR %01000000  ; Set bit 6.
 $B507 EXX           ; Switch back.
 $B508 LD (HL),A     ; Write the colour.
 $B509 INC HL        ; {Skip the flags byte.
 $B50A INC HL        ; }
; Clear the next #N$07 bytes.
@label=FillDebrisSlots_ClearBytes
*$B50B LD (HL),$00   ; Write #N$00.
 $B50D INC HL        ; Advance the slot pointer.
 $B50E DJNZ $B50B    ; Decrease the counter by one and jump back to
                     ; #R$B50B until it is zero.
; Write the sprite delay and its reload value, then step to the
; next slot.
 $B510 EXX           ; Switch to the shadow registers.
 $B511 LD A,(HL)     ; Fetch the next ROM byte from *#REGhl'.
 $B512 INC HL        ; Advance #REGhl'.
 $B513 AND %00000111 ; Keep only bits 0-2.
 $B515 INC A         ; Increase it by one.
 $B516 EXX           ; Switch back.
 $B517 LD (HL),A     ; Write the sprite delay.
 $B518 INC HL        ; Advance the slot pointer.
 $B519 LD (HL),A     ; Write the same value as the delay reload.
 $B51A LD A,L        ; {Advance #REGhl by #N$07 to the next slot.
 $B51B ADD A,$07     ;
 $B51D LD L,A        ;
 $B51E LD A,H        ;
 $B51F ADC A,$00     ;
 $B521 LD H,A        ; }
; Loop until every slot has been written, then
; initialise the explosion.
 $B522 POP BC        ; Restore the slot counters from the stack.
 $B523 DEC C         ; Decrease the remaining slot count by one.
 $B524 JR NZ,$B4D0   ; Jump back to #R$B4D0 if there are slots left.
 $B526 JP $B986      ; Jump to #R$B986.
; Positive ROM speeds become #N$01-#N$04.
@label=FillDebrisSlots_PositiveSpeed
*$B529 AND %00000011 ; Keep only bits 0-1.
 $B52B INC A         ; Increase it by one.
 $B52C JR $B4EB      ; Jump to #R$B4EB.

; Show Laser Estimate
;
; Used by the routine at #R$AE78.
; .
; Queue the briefing tune, write the hit count into the
; banner, then flash the warning while beeping.
;
; .
;
; Queue the briefing tune and write the hit-count digit.
@label=ShowLaserEstimate
c$B52E DI            ; Disable interrupts.
 $B52F LD DE,$BA2A   ; #REGde=#R$BA2A.
 $B532 CALL $B9BC    ; Call #R$B9BC.
 $B535 RST $38       ; Call the ROM interrupt routine at
                     ; #SKOOLKID$0038(MASK-INT).
 $B536 LD A,($611E)  ; Fetch the hit count from #R$6108(#N$611E).
 $B539 CALL $B699    ; Call #R$B699.
; Here we alter "#FONTaddr=$D347,attr=$47,chars=0(IT IS ESTIMATED THAT XX
; LASER)(hits)" to update with the number of hits.
 $B53C LD HL,$B660   ; #REGhl=#R$B64A(#N$B660).
; Write the tens digit, or a space when it is zero.
 $B53F LD C,A        ; Stash the converted count in #REGc.
 $B540 RRCA          ; {Rotate the tens digit into the low nibble.
 $B541 RRCA          ;
 $B542 RRCA          ;
 $B543 RRCA          ; }
 $B544 AND %00001111 ; Keep only bits 0-3.
 $B546 JR NZ,$B54A   ; Jump to #R$B54A if the tens digit is not zero.
 $B548 LD A,$F0      ; #REGa=#N$F0 (becomes a space after +#N$30).
@label=ShowLaserEstimate_WriteDigit
*$B54A ADD A,$30     ; Add #N$30 to make an ASCII digit.
 $B54C LD (HL),A     ; Write the tens character.
 $B54D INC HL        ; Advance to the units position.
; Write the units digit.
 $B54E LD A,C        ; Copy the converted count into #REGa.
 $B54F AND %00001111 ; Keep only bits 0-3.
 $B551 ADD A,$30     ; Add #N$30 to make an ASCII digit.
 $B553 LD (HL),A     ; Write the units character.
; Flash the warning twelve times, beeping each time.
 $B554 CALL $8BA5    ; Call #R$8BA5.
 $B557 LD B,$0C      ; Set a flash counter in #REGb for #N$0C loops.
@label=ShowLaserEstimate_Loop
*$B559 PUSH BC       ; Stash #REGbc on the stack.
 $B55A CALL $8298    ; Call #R$8298.
 $B55D CALL $B594    ; Call #R$B594.
; #HTML(#AUDIO0(laser-estimate.wav)(#INCLUDE(LaserEstimate)))
 $B560 LD C,$80      ; #REGc=#N$80 (pitch).
 $B562 LD D,$80      ; #REGd=#N$80 (duration).
@label=ShowLaserEstimate_Beep
*$B564 CALL $B8DA    ; Call #R$B8DA.
 $B567 DEC D         ; Decrease the duration by one.
 $B568 JR NZ,$B564   ; Jump back to #R$B564 until it is zero.
; Show the warning in the alternate colour, restore
; the original colour and pause.
 $B56A LD A,$42      ; #REGa=#COLOUR$42.
 $B56C LD ($B5DC),A  ; Write it to #R$B5DC.
 $B56F CALL $B594    ; Call #R$B594.
 $B572 LD A,$56      ; #REGa=#COLOUR$56.
 $B574 LD ($B5DC),A  ; Write it to #R$B5DC.
; Pause before the next flash.
 $B577 LD HL,$8000   ; #REGhl=#N$8000.
@label=ShowLaserEstimate_Delay
*$B57A DEC HL        ; Decrease #REGhl by one.
 $B57B LD A,L        ; {Jump back to #R$B57A if #REGhl is not zero.
 $B57C OR H          ;
 $B57D JR NZ,$B57A   ; }
 $B57F POP BC        ; Restore #REGbc from the stack.
 $B580 DJNZ $B559    ; Decrease the flash count by one and jump back to
                     ; #R$B559 until it is zero.
; Queue a jingle, blank the play area and reset the laser beam
; slots and alien states before clearing the sprite caches.
 $B582 LD DE,$B9DA   ; #REGde=#R$B9DA.
 $B585 CALL $B9BC    ; Call #R$B9BC.
 $B588 CALL $8BA5    ; Call #R$8BA5.
 $B58B CALL $A317    ; Call #R$A317.
 $B58E CALL $B385    ; Call #R$B385.
 $B591 JP $A2F5      ; Jump to #R$A2F5.

; Messaging: Missile Launch
;
; Used by the routine at #R$B52E.
; .
; Prints the missile launch warning message one line at a time,
; each at its own screen location.
;
; .
;
; Handle displaying "WARNING" messaging.
@label=Message_MissileLaunch
c$B594 LD DE,$B5DC   ; #REGde=#R$B5DC.
 $B597 LD HL,$2860   ; #REGhl=#N($2860, $04, $04) (screen location).
 $B59A CALL $8A11    ; Call #R$8A11.
; Handle displaying "A MISSILE HAS BEEN LAUNCHED" messaging.
 $B59D LD DE,$B5E4   ; #REGde=#R$B5E4.
 $B5A0 LD HL,$3808   ; #REGhl=#N($3808, $04, $04) (screen location).
 $B5A3 CALL $8A11    ; Call #R$8A11.
; Handle displaying "FROM THE ENEMY BASE." messaging.
 $B5A6 LD DE,$B601   ; #REGde=#R$B601.
 $B5A9 LD HL,$4808   ; #REGhl=#N($4808, $04, $04) (screen location).
 $B5AC CALL $8A11    ; Call #R$8A11.
; Handle displaying "YOUR LUNAR ROVER IS IN DANGER" messaging.
 $B5AF LD DE,$B617   ; #REGde=#R$B617.
 $B5B2 LD HL,$5808   ; #REGhl=#N($5808, $04, $04) (screen location).
 $B5B5 CALL $8A11    ; Call #R$8A11.
; Handle displaying "OF BEING DESTROYED" messaging.
 $B5B8 LD DE,$B636   ; #REGde=#R$B636.
 $B5BB LD HL,$6808   ; #REGhl=#N($6808, $04, $04) (screen location).
 $B5BE CALL $8A11    ; Call #R$8A11.
; Handle displaying "IT IS ESTIMATED THAT    LASER" messaging.
 $B5C1 LD DE,$B64A   ; #REGde=#R$B64A.
 $B5C4 LD HL,$8008   ; #REGhl=#N($8008, $04, $04) (screen location).
 $B5C7 CALL $8A11    ; Call #R$8A11.
; Handle displaying "HITS WILL BE REQUIRED TO" messaging.
 $B5CA LD DE,$B669   ; #REGde=#R$B669.
 $B5CD LD HL,$9008   ; #REGhl=#N($9008, $04, $04) (screen location).
 $B5D0 CALL $8A11    ; Call #R$8A11.
; Handle displaying "DESTROY THE MISSILE." messaging.
 $B5D3 LD DE,$B683   ; #REGde=#R$B683.
 $B5D6 LD HL,$A008   ; #REGhl=#N($A008, $04, $04) (screen location).
 $B5D9 JP $8A11      ; Jump to #R$8A11.

; Messaging: Missile Launch
;
; .
;
