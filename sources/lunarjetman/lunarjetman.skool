 $9CC2 DEFB $00,$00,$20,$FC,$FC,$F4,$20,$00 ; }
@label=Alien_Saturn
 $9CCA DEFB $CC,$00,$00,$00,$38,$30,$20,$41 ; {#SPRITENAME(#PEEK(#PC)).
 $9CD2 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
 $9CDA DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; }
