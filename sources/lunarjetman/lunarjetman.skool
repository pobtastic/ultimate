;
; Used by the routine at #R$AF1C.
; .
; #HTML(#AUDIO0(laser-missile-hit.wav)(#INCLUDE(LaserMissileHit)))
@label=SoundsLaserMissileHit
c$B8B4 LD C,$38      ; #REGc=#N$38 (pitch).
@label=SoundsLaserMissileHit_Loop
*$B8B6 CALL $B8DA    ; Call #R$B8DA.
 $B8B9 DEC C         ; {Decrease the pitch by one and jump back to
 $B8BA JR NZ,$B8B6   ; #R$B8B6 until it is zero.}
 $B8BC RET           ; Return.

; Sounds: Take Object
;
; Used by the routines at #R$8D06, #R$930C, #R$A0F8, #R$A325, #R$A3FF, #R$B6EC,
; #R$B785 and #R$F295.
; .
; Short tone played when Jetman takes hold of something, such as
; boarding the rover or picking up a platform or a bomb.
; .
; #HTML(#AUDIO0(board-rover.wav)(#INCLUDE(BoardRover)))
@label=SoundsTakeObject
c$B8BD LD D,$20      ; #REGd=#N$20 (duration).
 $B8BF LD C,$50      ; #REGc=#N$50 (pitch).
 $B8C1 JR $B8CD      ; Jump to #R$B8CD.

; Sounds: Drop Item
;
; Used by the routines at #R$91E2, #R$93A6, #R$A0F8, #R$A378, #R$B7BC and
; #R$F295.
