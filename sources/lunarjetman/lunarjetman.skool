; Laser Beam Parameters
;
; Four #N$18-byte actor slots for the laser beams, in the same
; field order as #R$6078. They are the first of the #N$18 actor slots, which
; run up to #R$6240. Every slot is laid out the same way:
; #TABLE(default,centre,left)
; { =h Offset | =h Contents }
; { #N$00 | Type (the sprite ID) }
; { #N$01 | Screen column }
; { #N$02-#N$03 | World X }
; { #N$04 | Y }
; { #N$05 | Horizontal speed }
; { #N$06 | Vertical thrust }
; { #N$07 | Colour }
; { #N$08 | Flags }
; { #N$09-#N$0F | Sprite cache, cleared by #R$A2F5 }
; { #N$10-#N$17 | State specific to the actor type }
; TABLE#
@label=Laser_Parameter_1
g$6000 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; {Laser Beam #1.
 $6008 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
 $6010 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; }
@label=Laser_Parameter_2
 $6018 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; {Laser Beam #2.
 $6020 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
 $6028 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; }
@label=Laser_Parameter_3
 $6030 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; {Laser Beam #3.
 $6038 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
 $6040 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; }
@label=Laser_Parameter_4
 $6048 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; {Laser Beam #4.
 $6050 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
 $6058 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; }
; View the equivalent code in;
; #LIST
; { #JETPAC$5D08 }
; LIST#

