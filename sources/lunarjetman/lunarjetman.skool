i$7800

; Security Check
;
; Used by the routine at #R$5B80.
; .
; A short copy-protection test on the FRAMES timer. The
; game starts when the check passes.
@label=SecurityCheck
c$8000 DI            ; Disable interrupts.
 $8001 LD SP,$5E00   ; Set the stack pointer to #R$5E00.
 $8004 LD A,($5C79)  ; #REGa=#SKOOLKID$5C78(FRAMES)+#N$01.
 $8007 CP $83        ; {Return if the timer is not #N$83.
 $8009 RET NZ        ; }
; Continue on to #R$800A.
; .
; View the equivalent code in;
; #LIST
; { #ATICATAC$6000 }
; { #COOKIE$5F00 }
; { #JETPAC$61E5 }
; { #PSSST$61C6 }
; { #SABREWULF$995A }
; { #TRANZAM$5F00 }
; LIST#

; Game Initialisation
;
; Clears game RAM, installs the font, writes the default
; scores and queues the briefing tune before entering the menu
; loop.
;
; .
;
; Clear every game variable.
@label=GameInitialisation
c$800A LD HL,$5E00   ; {Write #N$00 to #N$2200 bytes starting from #R$5E00.
 $800D LD BC,$2200   ;
@label=GameInitialisation_Loop
*$8010 LD (HL),$00   ;
 $8012 INC HL        ;
 $8013 DEC BC        ;
 $8014 LD A,C        ;
 $8015 OR B          ;
 $8016 JR NZ,$8010   ; }
; Use the custom font.
 $8018 LD HL,$D347   ; {Write #R$D347 to #R$5E04.
 $801B LD ($5E04),HL ; }
; Set the default scores and draw the menu window.
 $801E CALL $9C23    ; Call #R$9C23.
 $8021 CALL $84D8    ; Call #R$84D8.
; Queue the briefing tune and enter the menu loop.
 $8024 LD DE,$BA2A   ; Set the tune pointer to #R$BA2A.
 $8027 CALL $B9BC    ; Queue the briefing tune.
 $802A JR $8035      ; Jump to #R$8035.
; View the equivalent code in;
; #LIST
; { #ATICATAC$7C19 }
; { #COOKIE$6298 }
; { #JETPAC$61EB }
; { #PSSST$61CD }
; { #SABREWULF$9960 }
; { #TRANZAM$5F07 }
; LIST#

; Game Restart
;
; Used by the routine at #R$F33E.
; .
; Rebuilds the menu window, shows the hall of fame, then
; loops on the game selection keys until "6" starts a game.
@label=Game_Restart
c$802C CALL $84D8    ; Call #R$84D8.
 $802F CALL $F410    ; Call #R$F410.
 $8032 CALL $84D8    ; Call #R$84D8.
; This entry point is used by the routine at #R$800A.
; .
; Draw the menu, then read keys "1"-"5".
@label=GameSelect_Loop
*$8035 CALL $80D1    ; Call #R$80D1.
 $8038 LD A,$F7      ; {Read from the keyboard;
 $803A OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $803C IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$F7 | 1 | 2 | 3 | 4 | 5 }
                     ; TABLE#}
 $803E CPL           ; Flip the bits.
 $803F LD E,A        ; Store the key bits for the tests below.
 $8040 LD A,($5E00)  ; {Copy #R$5E00 to #R$5E7C.
 $8043 LD ($5E7C),A  ; }
; Handle 1UP selection.
@label=GameSelect_CheckP1
 $8046 BIT 0,E       ; {Jump to #R$804C if "1" was not pressed.
 $8048 JR Z,$804C    ; }
 $804A RES 0,A       ; Set a 1UP game.
; Handle 2UP selection.
@label=GameSelect_CheckP2
*$804C BIT 1,E       ; {Jump to #R$8052 if "2" was not pressed.
 $804E JR Z,$8052    ; }
 $8050 SET 0,A       ; Set a 2UP game.
; Handle Keyboard selection.
@label=GameSelect_CheckKeyboard
*$8052 BIT 2,E       ; {Jump to #R$8058 if "3" was not pressed.
 $8054 JR Z,$8058    ; }
 $8056 AND %11111001 ; Set the control method to keyboard.
; Handle Kempston Joystick selection.
@label=GameSelect_CheckKempston
*$8058 BIT 3,E       ; {Jump to #R$8060 if "4" was not pressed.
 $805A JR Z,$8060    ; }
 $805C AND %11111001 ; Clear the control method bits.
 $805E OR %00000010  ; Set the control method to Kempston.
; Handle Cursor Joystick selection.
@label=GameSelect_CheckCursor
*$8060 BIT 4,E       ; {Jump to #R$8068 if "5" was not pressed.
 $8062 JR Z,$8068    ; }
 $8064 AND %11111001 ; Clear the control method bits.
 $8066 OR %00000100  ; Set the control method to cursor.
; Write the options back, then test "6" to start.
@label=GameSelect_StartGame
*$8068 LD ($5E00),A  ; Write the updated options to #R$5E00.
 $806B LD A,$EF      ; {Read from the keyboard;
 $806D OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $806F IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$EF | 0 | 9 | 8 | 7 | 6 }
                     ; TABLE#}
 $8071 CPL           ; Flip the bits.
 $8072 BIT 4,A       ; {Jump to #R$81BB if "6" was pressed.
 $8074 JP NZ,$81BB   ; }
; Queue a jingle if the player count or control method
; changed since the last pass.
 $8077 LD A,($5E00)  ; {Copy the current game options into #REGc.
 $807A LD C,A        ; }
 $807B LD A,($5E7C)  ; {Compare them with #R$5E7C.
 $807E XOR C         ; }
 $807F PUSH AF       ; Stash the changed-option flags on the stack.
 $8080 BIT 0,A       ; {Call #R$80FD if the player count has changed.
 $8082 CALL NZ,$80FD ; }
 $8085 POP AF        ; Restore the changed-option flags from the stack.
 $8086 AND %00000110 ; Keep only the control method bits.
 $8088 JR Z,$809A    ; Jump to #R$809A if the control method is unchanged.
; Queue the jingle for the newly selected control method.
 $808A LD DE,$BA9E   ; Set the tune table pointer to #R$BA9E.
 $808D LD A,C        ; Fetch the current game options.
 $808E AND %00000110 ; Keep only the control method bits.
 $8090 LD L,A        ; {Create an offset in #REGhl.
 $8091 LD H,$00      ; }
 $8093 ADD HL,DE     ; Point #REGhl at the matching entry in #R$BA9E.
 $8094 LD E,(HL)     ; {Fetch the control-method jingle address.
 $8095 INC HL        ;
 $8096 LD D,(HL)     ; }
 $8097 CALL $B9BC    ; Queue the control-method jingle.
; Flash the selected 1UP/ 2UP and control-method lines.
@label=Game_Restart_FlashSelection
*$809A LD HL,$810F   ; #REGhl=#R$810F (the first selectable line, skipping the
                     ; title).
 $809D LD A,($5E00)  ; {Copy the current game options into #REGc.
 $80A0 LD C,A        ; }
 $80A1 BIT 0,C       ; {Jump to #R$80BE if this is a 2UP game.
 $80A3 JR NZ,$80BE   ; }
 $80A5 CALL $80C3    ; Call #R$80C3.
; Flash the line for the selected control method and clear the
; other two.
@label=MenuAttributeHandler
*$80A8 LD B,$03      ; Set a control method counter in #REGb for #N$03 loops.
 $80AA LD A,C        ; {Fetch the options and move the control bits into
 $80AB RRCA          ; bits 0-1.}
@label=MenuAttributeHandler_Loop
*$80AC AND %00000011 ; Keep only bits 0-1.
 $80AE JR Z,$80B9    ; Jump to #R$80B9 if this control method is selected.
 $80B0 CALL $80C6    ; Call #R$80C6.
@label=GameSelect_ReadOptions
*$80B3 DEC A         ; {Decrease the method bits and loop back to #R$80AC
 $80B4 DJNZ $80AC    ; until all three lines are updated.}
 $80B6 JP $8035      ; Jump to #R$8035.
; Flash the selected control-method line.
@label=Game_Restart_FlashControlMethod
*$80B9 CALL $80CD    ; Call #R$80CD.
 $80BC JR $80B3      ; Jump to #R$80B3.
; Flash the 2UP line, then handle the control methods.
@label=Game_Restart_Flash2UP
*$80BE CALL $80CA    ; Call #R$80CA.
 $80C1 JR $80A8      ; Jump to #R$80A8.
; Flash this menu line and clear FLASH on the next.
@label=MenuAttributeSetUnset
*$80C3 SET 7,(HL)    ; Set the FLASH attribute for this menu line.
 $80C5 INC HL        ; Move onto the next menu attribute.
@label=MenuAttributeUnSetFirst
*$80C6 RES 7,(HL)    ; Clear the FLASH attribute for this menu line.
 $80C8 INC HL        ; Move onto the next menu attribute.
 $80C9 RET           ; Return.
; Clear FLASH on this menu line and set it on the next.
@label=MenuAttributeUnsetSet
*$80CA RES 7,(HL)    ; Clear the FLASH attribute for this menu line.
 $80CC INC HL        ; Move onto the next menu attribute.
@label=MenuAttributeSetFirst
*$80CD SET 7,(HL)    ; Set the FLASH attribute for this menu line.
 $80CF INC HL        ; Move onto the next menu attribute.
 $80D0 RET           ; Return.

; Game Selection Menu
;
; Used by the routine at #R$802C.
; .
; Draws the seven menu lines and the copyright message.
;
; .
;
; #PUSHS #UDGTABLE { #SIM(start=$800A,stop=$8024,sp=$5E00)
; #SIM(start=$80D1,stop=$80F4,sp=$5E00)
; #SIM(start=$80F4,stop=$8A36,sp=$5E00)
; #SCR$02(main-menu) } UDGTABLE# #POPS
@label=GameMenu
c$80D1 LD DE,$810E   ; Set the attribute table pointer to #R$810E.
 $80D4 EXX           ; Switch to the shadow registers.
 $80D5 LD HL,$8115   ; Set the Y position table pointer to #R$8115.
 $80D8 LD DE,$811C   ; Set the message pointer to #R$811C.
; There are seven lines of text.
 $80DB LD B,$07      ; Set a line counter in #REGb' for #N$07 loops.
@label=GameMenu_Loop
*$80DD EXX           ; Switch back to the normal registers.
 $80DE LD A,(DE)     ; {Copy the line attribute to #R$5E66.
 $80DF LD ($5E66),A  ; }
 $80E2 INC DE        ; Move the attribute table pointer on by one.
; Fetch the line Y position and print the line.
 $80E3 EXX           ; Switch to the shadow registers.
 $80E4 PUSH BC       ; Stash the line counter on the stack.
 $80E5 LD A,(HL)     ; Fetch the line Y position.
 $80E6 INC HL        ; Move the Y position table pointer on by one.
 $80E7 PUSH HL       ; Stash the Y position table pointer on the stack.
 $80E8 LD H,A        ; {Set the print co-ordinate from the Y position and
 $80E9 LD L,$38      ; X position #N$38.}
 $80EB CALL $81AB    ; Call #R$81AB.
; Move on to the next line of text until all seven are printed.
 $80EE EXX           ; Switch to the shadow registers.
 $80EF POP HL        ; {Restore the Y position table pointer and line
 $80F0 POP BC        ; counter from the stack.}
 $80F1 INC DE        ; Move the message pointer on to the next string.
 $80F2 DJNZ $80DD    ; Decrease the line counter by one and loop back to
                     ; #R$80DD until every line is printed.
; Print the copyright line.
 $80F4 LD HL,$B800   ; Set the screen position to #N($B800,$04,$04).
 $80F7 LD DE,$818A   ; Set the message pointer to #R$818A.
 $80FA JP $8A11      ; Jump to #R$8A11.
; View the equivalent code in;
; #LIST
; { #ATICATAC$7CAF }
; { #COOKIE$6332 }
; { #JETPAC$6260 }
; { #PSSST$6250 }
; { #SABREWULF$B473 }
; { #TRANZAM$5F6C }
; { #UNDERWURLDE$90E4 }
; LIST#

; Queue Menu Tune
;
; Used by the routine at #R$802C.
; .
; Picks the 1UP or 2UP jingle from #R$BAA4 and queues it.
;
; C Game options from #R$5E00
;
; Pick the 1UP or 2UP jingle and queue it.
@label=QueueMenuTune
c$80FD LD DE,$BAA4   ; Set the tune table pointer to #R$BAA4.
 $8100 LD A,C        ; Fetch the game options.
 $8101 RLCA          ; Move the player-count bit into bit 1.
 $8102 AND %00000010 ; Keep only bit 1.
 $8104 LD L,A        ; {Create an offset using the player-count bit.
 $8105 LD H,$00      ; }
 $8107 ADD HL,DE     ; Point #REGhl at the matching entry in #R$BAA4.
 $8108 LD E,(HL)     ; {Fetch the 1UP or 2UP jingle address.
 $8109 INC HL        ;
 $810A LD D,(HL)     ; }
 $810B JP $B9BC      ; Jump to #R$B9BC.

; Game Select Attribute Table
;
; One attribute byte per menu line, all starting as #COLOUR$47. The
; routines at #R$80C3 set or clear FLASH in the byte for the line being
; updated. The first byte belongs to the title, so the flashing code starts
; at #R$810F.
@label=GameSelection_Attributes
b$810E DEFB $47      ; {#TABLE(default,centre)
@label=GameSelection_Attributes_Options
 $810F DEFB $47      ; { =h Byte(n) | =h Menu Item }
 $8110 DEFB $47      ; { #N$01 | Game Selection }
 $8111 DEFB $47      ; { #N$02 | 1 Player Game }
 $8112 DEFB $47      ; { #N$03 | 2 Player Game }
 $8113 DEFB $47      ; { #N$04 | 3 Keyboard }
 $8114 DEFB $47      ; { #N$05 | 4 Kempston Joystick }
                     ; { #N$06 | 5 Cursor Joystick }
                     ; { #N$07 | 6 Start Game }
                     ; TABLE#}
; View the equivalent code in;
; #LIST
; { #ATICATAC$7CEA }
; { #COOKIE$635E }
; { #JETPAC$628D }
; { #PSSST$627C }
; { #SABREWULF$B498 }
; { #TRANZAM$5FA7 }
; { #UNDERWURLDE$9119 }
; LIST#

; Game Select Y Position Table
@label=GameSelection_Position
b$8115 DEFB $20      ; {#TABLE(default,centre,centre)
 $8116 DEFB $38      ; { =h Byte(n) | =h Position | =h Menu Item }
 $8117 DEFB $48      ; { #N$01 | #EVAL(#PEEK(#PC+$00) / $08) | Game Selection }
 $8118 DEFB $58      ; { #N$02 | #EVAL(#PEEK(#PC+$01) / $08) | 1 Player Game }
 $8119 DEFB $68      ; { #N$03 | #EVAL(#PEEK(#PC+$02) / $08) | 2 Player Game }
 $811A DEFB $78      ; { #N$04 | #EVAL(#PEEK(#PC+$03) / $08) | 3 Keyboard }
 $811B DEFB $98      ; { #N$05 | #EVAL(#PEEK(#PC+$04) / $08) | 4 Kempston Joystick }
                     ; { #N$06 | #EVAL(#PEEK(#PC+$05) / $08) | 5 Cursor Joystick }
                     ; { #N$07 | #EVAL(#PEEK(#PC+$06) / $08) | 6 Start Game }
                     ; TABLE#}
