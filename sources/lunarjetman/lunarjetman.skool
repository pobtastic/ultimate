; { #COOKIE$7488 }
; { #JETPAC$716C }
; { #MARTIANOIDS$BD99 }
; { #PSSST$73ED }
; { #SABREWULF$B53D }
; { #TRANZAM$6518 }
; { #UNDERWURLDE$9C3C }
; LIST#

; Print Banner
;
; Used by the routine at #R$84D8.
; .
; Print the 1UP, HI and 2UP labels along the top of the
; screen.
;
; .
;
; Handle printing "#FONTaddr=$D347,attr=$47,chars=0(1UP)(1up)" messaging.
@label=PrintBanner
c$8A37 LD HL,$0018   ; #REGhl=#N($0018,$04,$04).
 $8A3A LD DE,$8A51   ; #REGde=#R$8A51.
 $8A3D CALL $8A11    ; Call #R$8A11.
; Handle printing "#FONTaddr=$D347,attr=$45,chars=0(HI)(hi)" messaging.
 $8A40 LD HL,$0078   ; #REGhl=#N($0078,$04,$04).
 $8A43 LD DE,$8A59   ; #REGde=#R$8A59.
 $8A46 CALL $8A11    ; Call #R$8A11.
; Handle printing "#FONTaddr=$D347,attr=$47,chars=0(2UP)(2up)" messaging.
 $8A49 LD HL,$00D8   ; #REGhl=#N($00D8,$04,$04).
 $8A4C LD DE,$8A55   ; #REGde=#R$8A55.
 $8A4F JR $8A11      ; Jump to #R$8A11.
; View the equivalent code in;
; #LIST
; { #COOKIE$74AE }
; { #JETPAC$7192 }
; { #PSSST$7413 }
; { #SABREWULF$B563 }
; LIST#

; Messaging: Banner Text
;
; .
;
; .
;
; #FONTaddr=$D347,attr=$47,chars=0(1UP)(1up)
@label=String_1UP
t$8A51 DEFM $47          ; {"1UP" (#COLOUR(#PEEK(#PC)) is the attribute).
 $8A52 DEFM "1U","P"+$80 ; }
; #FONTaddr=$D347,attr=$47,chars=0(2UP)(2up)
@label=String_2UP
 $8A55 DEFM $47          ; {"2UP" (#COLOUR(#PEEK(#PC)) is the attribute).
 $8A56 DEFM "2U","P"+$80 ; }
; #FONTaddr=$D347,attr=$45,chars=0(HI)(hi)
@label=String_HI
 $8A59 DEFM $45          ; {"HI" (#COLOUR(#PEEK(#PC)) is the attribute).
 $8A5A DEFM "H","I"+$80  ; }

; Mask Sprite
;
; Used by the routines at #R$8AE8 and #R$8B73.
; .
; XOR the old (cached) image of a masked sprite off the screen
; and its new image on, row by row, using the remaining row counts in
; #R$5E5A (old image) and #R$5E59 (new image).
;
; HL Screen address
; DE Graphic pointer
;
; Draw remaining rows from the current masked pair.
@label=MaskSprite
c$8A5C LD A,C        ; {Jump to #R$8A70 if the row counter is zero.
 $8A5D AND A         ;
 $8A5E JR Z,$8A70    ; }
 $8A60 DEC C         ; {Decrease the row counter and draw the next row of the
 $8A61 CALL $8A93    ; old image.}
 $8A64 EXX           ; Switch to the shadow registers.
 $8A65 LD A,C        ; {Jump to #R$8A6D if the shadow row counter is zero.
 $8A66 AND A         ;
 $8A67 JR Z,$8A6D    ; }
@label=MaskSprite_Loop
*$8A69 DEC C         ; {Decrease the shadow row counter and draw the next row of
 $8A6A CALL $8AC8    ; the new image.}
@label=MaskSprite_NextSide
*$8A6D EXX           ; {Switch back and loop to #R$8A5C.
 $8A6E JR $8A5C      ; }
@label=MaskSprite_TryShadow
*$8A70 EXX           ; Switch to the shadow registers.
 $8A71 LD A,C        ; {Jump to #R$8A69 if the shadow row counter is still
 $8A72 AND A         ; live.
 $8A73 JR NZ,$8A69   ; }
; This entry point is used by the routine at #R$8B73.
; .
; Finish the sprite if any rows remain to be erased or drawn.
@label=MaskSprite_FinishSprite
*$8A75 EXX           ; Switch back to the normal registers.
; This entry point is used by the routine at #R$8B73.
@label=MaskSprite_TestRemaining
*$8A76 LD A,($5E5A)  ; {Return if both #R$5E5A and #R$5E59 are zero.
 $8A79 LD C,A        ;
 $8A7A LD A,($5E59)  ;
 $8A7D OR C          ;
 $8A7E RET Z         ; }
 $8A7F XOR A         ; {Write #N$00 to #R$5E5A and switch register sets.
 $8A80 LD ($5E5A),A  ;
 $8A83 EXX           ; }
 $8A84 LD A,($5E59)  ; {Load the remaining row count and clear #REGa.
 $8A87 LD C,A        ;
 $8A88 XOR A         ; }
; This entry point is used by the routine at #R$8B73.
@label=MaskSprite_StoreRowCount
*$8A89 LD ($5E59),A  ; Write the remaining row count to #R$5E59.
 $8A8C EXX           ; {Switch back and loop to #R$8A5C.
 $8A8D JR $8A5C      ; }
; Reached by the self-modified shift (operand #N$F2) when the mask
; is byte-aligned: only one screen byte is XORed.
 $8A8F EX DE,HL      ; {Switch the pair and jump to #R$8AAF.
 $8A90 EX (SP),HL    ;
 $8A91 JR $8AAF      ; }
; Load and shift the next mask byte for a row of the
; old image.
@label=MaskSprite_LoadMask
*$8A93 PUSH HL       ; {Load the next mask byte from #REGde.
 $8A94 EX DE,HL      ;
 $8A95 PUSH DE       ;
 $8A96 LD D,$00      ;
 $8A98 LD E,(HL)     ;
 $8A99 INC HL        ;
 $8A9A EX DE,HL      ; }
@label=MaskSprite_ShiftMask
*$8A9B JR $8A9B      ; Self-modifying shift. The operand is written by
                     ; #R$8B5E.
 $8A9D ADD HL,HL     ; {Shift the mask left into pixel alignment.
 $8A9E ADD HL,HL     ;
 $8A9F ADD HL,HL     ;
 $8AA0 ADD HL,HL     ;
 $8AA1 ADD HL,HL     ;
 $8AA2 ADD HL,HL     ;
 $8AA3 ADD HL,HL     ;
 $8AA4 EX DE,HL      ; }
@label=MaskSprite_XORFirst
*$8AA5 EX (SP),HL    ; {XOR the first mask byte onto the screen.
 $8AA6 LD A,D        ;
 $8AA7 XOR (HL)      ;
 $8AA8 LD (HL),A     ;
 $8AA9 INC L         ; }
 $8AAA LD A,L        ; Fetch the new column.
 $8AAB AND %00011111 ; Keep only bits 0-4.
 $8AAD JR Z,$8AB2    ; Jump to #R$8AB2 if the row wrapped.
@label=MaskSprite_XORSecond
*$8AAF LD A,E        ; {XOR the second mask byte onto the screen.
 $8AB0 XOR (HL)      ;
 $8AB1 LD (HL),A     ; }
; Step the screen address up one pixel line.
@label=MaskSprite_MoveUp
*$8AB2 POP DE        ; {Restore the graphic pointer and screen address.
 $8AB3 POP HL        ; }
 $8AB4 DEC H         ; {Move up one pixel.
 $8AB5 LD A,H        ;
 $8AB6 CPL           ; }
 $8AB7 AND %00000111 ; Keep only bits 0-2.
 $8AB9 RET NZ        ; Return if a character-row boundary was not crossed.
 $8ABA LD A,L        ; {Subtract #N$20 from the column address.
 $8ABB SUB $20       ;
 $8ABD LD L,A        ; }
 $8ABE RET C         ; Return if that wrapped into the previous third.
 $8ABF LD A,H        ; {Add #N$08 to the line byte.
 $8AC0 ADD A,$08     ;
 $8AC2 LD H,A        ; }
 $8AC3 RET           ; Return.
; Reached by the self-modified shift (operand #N$F2) when the mask
; is byte-aligned: only one screen byte is XORed.
 $8AC4 EX DE,HL      ; {Switch the pair and jump to #R$8AAF.
 $8AC5 EX (SP),HL    ;
 $8AC6 JR $8AAF      ; }
; Load and shift the next mask byte for a row of the
; new image.
@label=MaskSprite_LoadMaskAgain
*$8AC8 PUSH HL       ; {Load the next mask byte from #REGde.
 $8AC9 EX DE,HL      ;
 $8ACA PUSH DE       ;
 $8ACB LD D,$00      ;
 $8ACD LD E,(HL)     ;
 $8ACE INC HL        ;
 $8ACF EX DE,HL      ; }
@label=MaskSprite_ShiftAndPlace
*$8AD0 JR $8AD0      ; Self-modifying shift. The operand is written by
                     ; #R$8B24.
 $8AD2 ADD HL,HL     ; {Shift the mask left into pixel alignment and jump to
 $8AD3 ADD HL,HL     ; #R$8AA5.
 $8AD4 ADD HL,HL     ;
 $8AD5 ADD HL,HL     ;
 $8AD6 ADD HL,HL     ;
 $8AD7 ADD HL,HL     ;
 $8AD8 ADD HL,HL     ;
 $8AD9 EX DE,HL      ;
 $8ADA JR $8AA5      ; }
 $8ADC CALL $86A1    ; {Call #R$86A1, clear #R$5E5A and jump to #R$8A5C.
 $8ADF EXX           ;
 $8AE0 XOR A         ;
 $8AE1 LD ($5E5A),A  ;
 $8AE4 LD C,A        ;
 $8AE5 JP $8A5C      ; }
; View the equivalent code in;
; #LIST
; { #JETPAC$773A }
; { #TRANZAM$7170 }
; LIST#

; Clear Mask Scratch
;
; Used by the routines at #R$A579 and #R$A742.
; .
; Zero #R$5E59 and #R$5E58, reload the actor's cached mask sprite with
; #R$8B52 and carry on drawing at #R$8A5C.
;
; IX Actor slot
@label=ClearMaskScratch
c$8AE8 XOR A         ; {Write #N$00 to #R$5E59, #R$5E58 and the row
 $8AE9 LD ($5E59),A  ; counter.
 $8AEC LD ($5E58),A  ;
 $8AEF LD C,A        ; }
 $8AF0 EXX           ; {Switch register sets, reload the cached sprite and
 $8AF1 CALL $8B52    ; jump to #R$8A5C.
 $8AF4 JP $8A5C      ; }

; Position Mask Sprite
;
; Used by the routine at #R$8B73.
; .
; Convert the actor's world position into a screen column. If it is on
; screen, work out the pixel shift, the screen address and the sprite size,
; and cache them on the actor.
;
; IX Actor slot
@label=PositionMaskSprite
c$8AF7 LD L,(IX+$02) ; {Fetch the actor's world X position.
 $8AFA LD H,(IX+$03) ; }
 $8AFD LD BC,($607A) ; {Subtract the scroll position at #R$607A.
 $8B01 AND A         ;
 $8B02 SBC HL,BC     ; }
 $8B04 LD BC,$0078   ; {Add the #N($0078,$04,$04) draw offset.
 $8B07 ADD HL,BC     ; }
 $8B08 LD A,H        ; Fetch the high byte of the screen column.
 $8B09 AND %00011111 ; Keep only bits 0-4.
 $8B0B JP NZ,$867F   ; Jump to #R$867F if the actor is off-screen.
 $8B0E LD (IX+$01),L ; Store the screen column in *#REGix+#N$01.
; Look up the sprite graphic and work out the pixel
; shift from the screen column.
 $8B11 CALL $857F    ; Call #R$857F.
 $8B14 LD L,(IX+$01) ; {Fetch the screen column and actor Y.
 $8B17 LD H,(IX+$04) ; }
 $8B1A LD A,L        ; {Build a pixel-shift index from the column.
 $8B1B DEC A         ; }
 $8B1C AND %00000111 ; Keep only bits 0-2.
 $8B1E CP $07        ; {Jump to #R$8B24 if the shift is not #N$07.
 $8B20 JR NZ,$8B24   ; }
 $8B22 LD A,$F2      ; Set the shift operand to #N$F2.
@label=PositionMaskSprite_StoreShift
*$8B24 LD ($8AD1),A  ; {Write the shift to #R$8AD0(#N$8AD1) and
 $8B27 LD (IX+$09),A ; *#REGix+#N$09.}
; Choose the scratch width for the shift.
 $8B2A LD A,$01      ; Set the scratch width to #N$01.
 $8B2C JR Z,$8B2F    ; Jump to #R$8B2F if the shift was #N$07.
 $8B2E INC A         ; Widen the scratch width to #N$02.
@label=PositionMaskSprite_StoreWidth
*$8B2F LD ($5E57),A  ; {Write the scratch width and cache the actor Y.
 $8B32 LD (IX+$0B),H ; }
; Work out the screen address, then cache the sprite
; size and pointers on the actor.
 $8B35 CALL $851E    ; Call #R$851E.
 $8B38 LD A,(DE)     ; {Copy the sprite height into #R$5E59, #R$5E58 and
 $8B39 INC DE        ; *#REGix+#N$0A.
 $8B3A LD ($5E59),A  ;
 $8B3D LD ($5E58),A  ;
 $8B40 LD (IX+$0A),A ; }
 $8B43 LD (IX+$0C),E ; {Cache the graphic pointer and screen address on the
 $8B46 LD (IX+$0D),D ; actor.
 $8B49 LD (IX+$0E),L ;
 $8B4C LD (IX+$0F),H ; }
 $8B4F LD C,$00      ; Clear the row counter.
 $8B51 RET           ; Return.

; Reload Mask Cache
;
; Used by the routines at #R$8AE8 and #R$8B73.
; .
; Reload the cached graphic pointer, screen address, shift, row count
; and Y position from the actor into the draw workspace.
;
; IX Actor slot
@label=ReloadMaskCache
c$8B52 LD E,(IX+$0C) ; {Fetch the cached graphic pointer.
 $8B55 LD D,(IX+$0D) ; }
 $8B58 LD L,(IX+$0E) ; {Fetch the cached screen address.
 $8B5B LD H,(IX+$0F) ; }
 $8B5E LD A,(IX+$09) ; {Write the cached shift to #R$8A9B(#N$8A9C).
 $8B61 LD ($8A9C),A  ; }
 $8B64 LD A,(IX+$0A) ; {Write the cached row count to #R$5E5A.
 $8B67 LD ($5E5A),A  ; }
 $8B6A LD A,(IX+$0B) ; {Write the cached Y position to #R$5E56.
 $8B6D LD ($5E56),A  ; }
 $8B70 LD C,$00      ; Clear the row counter.
 $8B72 RET           ; Return.

; Draw Object Sprite
;
; Used by the routines at #R$9BBB, #R$A579, #R$A742, #R$A81C and #R$B218.
; .
; Position an alien or pickup sprite and draw it through
; #R$8A5C.
;
; IX Actor slot
;
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After #R$8B73 | =h After #R$8733 }
; { #SIM(start=$800A,stop=$8024,sp=$5E00)
; #SIM(start=$81BB,stop=$81D6,sp=$5E00)
; #POKES$60D8,$59;$60DA,$58;$60DB,$00;$60DC,$90;$60DD,$00;$60DF,$47
; #SCR$04,$10,$10,$06,$04(shot-before)
; | #SIM(start=$A81C,stop=$A81F,ix=$60D8,sp=$5E00)
; #SCR$04,$10,$10,$06,$04(shot-drawn)
; | #SIM(start=$A81F,stop=$A822,ix=$60D8,sp=$5E00)
; #SCR$04,$10,$10,$06,$04(shot-coloured) } UDGTABLE# #POPS
; .
; Position an alien or pickup sprite and draw it.
@label=DrawObjectSprite
c$8B73 CALL $8B52    ; Call #R$8B52.
 $8B76 EXX           ; Switch to the shadow registers.
 $8B77 CALL $8AF7    ; Call #R$8AF7.
 $8B7A EXX           ; Switch back to the normal registers.
; Compare the cached Y position with the actor Y.
 $8B7B LD A,($5E56)  ; {Subtract the actor Y from #R$5E56.
 $8B7E SUB (IX+$04)  ; }
 $8B81 JP Z,$8A76    ; Jump to #R$8A76 if they match.
 $8B84 JP M,$8B96    ; Jump to #R$8B96 if the actor is below the cached
                     ; position.
 $8B87 LD C,A        ; Store the Y difference in the row counter.
 $8B88 LD A,($5E5A)  ; {Jump to #R$8A76 if the Y difference
 $8B8B CP C          ; is greater than #R$5E5A.
 $8B8C JP C,$8A76    ; }
 $8B8F SUB C         ; {Subtract it from #R$5E5A and jump to #R$8A5C.
 $8B90 LD ($5E5A),A  ;
 $8B93 JP $8A5C      ; }
@label=DrawObjectSprite_ClipHeight
*$8B96 EXX           ; {Switch register sets and negate the Y difference.
 $8B97 NEG           ;
 $8B99 LD C,A        ; }
 $8B9A LD A,($5E59)  ; {Jump to #R$8A75 if the Y difference
 $8B9D CP C          ; is greater than #R$5E59.
 $8B9E JP C,$8A75    ; }
 $8BA1 SUB C         ; {Subtract it from the row count and jump to
 $8BA2 JP $8A89      ; #R$8A89.}

; Blank Play Area
;
; Used by the routines at #R$A299, #R$B3A3 and #R$B52E.
; .
; Clear the playfield pixels upward from #N($57BF), one scan
; line at a time.
;
; .
;
; Clear the playfield pixels upward from #N$57BF.
@label=BlankPlayArea
c$8BA5 LD HL,$57BF   ; Set the start address to #N$57BF.
 $8BA8 LD BC,$2088   ; Set the line width to #N$20 and the line count to
                     ; #N$88.
@label=BlankPlayArea_Loop
*$8BAB PUSH BC       ; {Stash the counters and screen address.
 $8BAC PUSH HL       ; }
@label=BlankPlayArea_WriteByte
*$8BAD LD (HL),$00   ; Write #N$00 to the current byte.
 $8BAF DEC HL        ; Move left one byte.
 $8BB0 DJNZ $8BAD    ; Decrease the column counter and loop back to
                     ; #R$8BAD until the line is clear.
; Move up one scan line and repeat until every line is clear.
 $8BB2 POP HL        ; Restore the screen address from the stack.
 $8BB3 CALL $85F6    ; Call #R$85F6.
 $8BB6 POP BC        ; Restore the counters from the stack.
 $8BB7 DEC C         ; Decrease the line count.
 $8BB8 JR NZ,$8BAB   ; Jump back to #R$8BAB until every line is clear.
 $8BBA RET           ; Return.
; View the equivalent code in;
; #LIST
; { #MARTIANOIDS$B1EC }
; LIST#

; Draw HUD Panel
;
; Used by the routine at #R$A826.
; .
; Print the dashboard graphic as a #N$1E by #N$03 font
; block, then write its attributes.
;
; .
;
; Print the dashboard graphic as a #N$1E by #N$03 font.
@label=DrawHUDPanel
c$8BBB LD HL,($5E04) ; {Stash the current font pointer.
 $8BBE PUSH HL       ; }
 $8BBF LD HL,$DD97   ; {Write #R$DD97 to #R$5E04.
 $8BC2 LD ($5E04),HL ; }
; The panel is printed like a font.
 $8BC5 LD BC,$1E03   ; Set the size to #N$1E columns and #N$03 rows.
 $8BC8 LD DE,$DE5F   ; Set the pixel-data pointer to #R$DE5F.
 $8BCB LD HL,$4041   ; Set the screen position to #N$4041.
@label=DrawHUDPanel_Pixel_Row
*$8BCE PUSH BC       ; {Stash the counters and screen address.
 $8BCF PUSH HL       ; }
@label=DrawHUDPanel_Pixel_Column
*$8BD0 LD A,(DE)     ; {Print the next panel character and loop back to
 $8BD1 INC DE        ; #R$8BD0 until the row is done.
 $8BD2 ADD A,$20     ;
 $8BD4 CALL $89EF    ;
 $8BD7 DJNZ $8BD0    ; }
 $8BD9 POP HL        ; {Restore this row, step down one character row and
 $8BDA LD BC,$0020   ; loop back to #R$8BCE until every row is printed.
 $8BDD ADD HL,BC     ;
 $8BDE POP BC        ;
 $8BDF DEC C         ;
 $8BE0 JR NZ,$8BCE   ; }
; Now write the attribute bytes.
 $8BE2 LD DE,$DEB9   ; Set the attribute-data pointer to #R$DEB9.
 $8BE5 LD HL,$5841   ; Set the attribute position to #N$5841.
 $8BE8 LD BC,$1E03   ; Set the size to #N$1E columns and #N$03 rows.
@label=DrawHUDPanel_Attribute_Row
*$8BEB PUSH BC       ; {Stash the counters and attribute address.
 $8BEC PUSH HL       ; }
@label=DrawHUDPanel_Attribute_Column
*$8BED LD A,(DE)     ; {Write the next attribute byte and loop back to
 $8BEE INC DE        ; #R$8BED until the row is done.
 $8BEF LD (HL),A     ;
 $8BF0 INC L         ;
 $8BF1 DJNZ $8BED    ; }
 $8BF3 POP HL        ; {Restore this row, step down one attribute row and
 $8BF4 LD BC,$0020   ; loop back to #R$8BEB until every row is painted.
 $8BF7 ADD HL,BC     ;
 $8BF8 POP BC        ;
 $8BF9 DEC C         ;
 $8BFA JR NZ,$8BEB   ; }
; Restore the old font pointer.
 $8BFC POP HL        ; {Restore the previous font pointer to #R$5E04.
 $8BFD LD ($5E04),HL ; }
 $8C00 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #COOKIE$5FE1 }
; { #TRANZAM$69BC }
; LIST#

; Draw Gauge
;
; Used by the routines at #R$8C71, #R$8D06, #R$91E2 and #R$ABBA.
; .
; Draw a fuel/level bar at the given screen position, using
; the gauge value as both length and gradient.
;
; A Gauge value (bits 3-7 whole cells, bits 0-2 gradient)
; HL Screen location
;
; Stash the gauge value for later.
@label=DrawGauge
c$8C01 LD C,A        ; Stash the gauge byte.
; Stash the screen location for later, as we'll need
; it to gain the screen buffer address.
 $8C02 PUSH HL       ; Stash #REGhl on the stack.
 $8C03 CALL $8506    ; Call #R$8506.
; Restore the gauge value.
 $8C06 LD A,C        ; #REGa=#REGc.
; Divide by #N$08 to leave the number of whole cells.
 $8C07 RRCA          ; {Rotate the bits right three times (including the
 $8C08 RRCA          ; carry).
 $8C09 RRCA          ; }
 $8C0A AND %00011111 ; Keep only bits 0-4.
 $8C0C JR Z,$8C1A    ; Jump to #R$8C1A if there are no whole cells to fill.
 $8C0E LD B,A        ; #REGb=#REGa.
; Copy the INK bits into PAPER as the bar is filled.
@label=DrawGauge_Find
*$8C0F LD A,(HL)     ; Fetch the current attribute byte.
 $8C10 RLCA          ; {Rotate the bits left three times (including the carry).
 $8C11 RLCA          ;
 $8C12 RLCA          ; }
 $8C13 AND %00111000 ; Keep only bits 3-5 (the INK bits, now in the PAPER
                     ; position).
 $8C15 OR (HL)       ; {Merge them back into the attribute byte.
 $8C16 LD (HL),A     ; }
 $8C17 INC HL        ; Increment #REGhl by one.
 $8C18 DJNZ $8C0F    ; Decrease the counter by one and jump back to
                     ; #R$8C0F until it is zero.
; Fetch the attribute byte for where the gauge ends.
@label=DrawGauge_Draw
*$8C1A LD A,(HL)     ; #REGa=*#REGhl.
; Remove the PAPER bits.
 $8C1B AND %11000111 ; Keep only bits 0-2, 6-7.
 $8C1D LD (HL),A     ; Write #REGa back to *#REGhl.
; Store the attribute buffer address in #REGde.
 $8C1E EX DE,HL      ; Switch the #REGde and #REGhl registers.
; Restore the screen location for the screen buffer address call.
 $8C1F POP HL        ; Restore #REGhl from the stack.
 $8C20 CALL $851E    ; Call #R$851E.
 $8C23 LD A,E        ; #REGa=#REGe.
 $8C24 AND %00011111 ; Keep only bits 0-4.
 $8C26 LD E,A        ; #REGe=#REGa.
 $8C27 LD A,L        ; #REGa=#REGl.
 $8C28 AND %11100000 ; Keep only bits 5-7.
 $8C2A OR E          ; {Merge in the column bits.
 $8C2B LD L,A        ; }
; Restore the gauge value.
 $8C2C LD A,C        ; #REGa=#REGc.
; The gradient lines are stored in the font at: #R$D51F.
; #UDGTABLE(default,centre,centre)
; { #N$00 | #FONTaddr=$D347,attr=$47,chars=0([)(gradient-0) }
; { #N$01 | #FONTaddr=$D347,attr=$47,chars=0(\)(gradient-1) }
; { #N$02 | #FONTaddr=$D347,attr=$47,chars=0(])(gradient-2) }
; { #N$03 | #FONTaddr=$D347,attr=$47,chars=0(^)(gradient-3) }
; { #N$04 | #FONTaddr=$D347,attr=$47,chars=0(_)(gradient-4) }
; { #N$05 | #FONTaddr=$D347,attr=$47,chars=0(`)(gradient-5) }
; { #N$06 | #FONTaddr=$D347,attr=$47,chars=0(a)(gradient-6) }
; { #N$07 | #FONTaddr=$D347,attr=$47,chars=0(b)(gradient-7) }
; UDGTABLE#
; .
; There are 8 gradient line images, so keep the
; index between #N$00 and #N$07.
 $8C2D AND %00000111 ; Keep only bits 0-2.
; The first value is #N$5B which corresponds to
; "#FONTaddr=$D347,attr=$47,chars=0([)(gradient-0)" (the smallest gradient).
 $8C2F ADD A,$5B     ; #REGa=#REGa+#N$5B.
 $8C31 CALL $89EF    ; Call #R$89EF.
; Restore the gauge value.
 $8C34 LD A,C        ; #REGa=#REGc.
 $8C35 CPL           ; Flip the bits.
 $8C36 AND %00000111 ; Keep only bits 0-2.
 $8C38 RET NZ        ; Return if the result is not zero.
 $8C39 LD A,$20      ; #REGa=#N$20.
 $8C3B JP $89EF      ; Jump to #R$89EF.

; Flash Score Label
;
; Used by the routine at #R$8C71.
; .
; Flash the active player's 1UP or 2UP banner label, or
; clear the actor if #R$5E6C is set.
;
; IX Actor slot
;
; Flash the active player's 1UP or 2UP banner label.
@label=ScoreLabelFlash
c$8C3E LD A,($5E6C)    ; {If #R$5E6C is zero, jump to #R$8C49.
 $8C41 AND A           ;
 $8C42 JR Z,$8C49      ; }
 $8C44 LD (IX+$00),$00 ; Write #N$00 to *#REGix+#N$00.
 $8C48 RET             ; Return.
; Controller for handling whether to action 1UP or 2UP score label.
@label=ScoreLabelFlash_Choose
*$8C49 LD A,($5E65)    ; {If #R$5E65 is not zero, jump to #R$8C6C.
 $8C4C AND A           ;
 $8C4D JR NZ,$8C6C     ; }
; Flash 1UP score label.
 $8C4F LD HL,$0018     ; #REGhl=#N($0018,$04,$04) (position of the 1UP score
                       ; label).
; This entry point is used by the routine at #R$8C6C.
; .
; Set flash state for the 3-attributes of the score label.
@label=FlashText
*$8C52 CALL $8506      ; Call #R$8506.
 $8C55 LD B,$03        ; Set a letter counter in #REGb for #N$03 loops.
@label=FlashText_Loop
*$8C57 LD A,(HL)       ; Fetch the attribute byte.
 $8C58 OR %10000000    ; Ensure bit 7 is set (the flash bit).
 $8C5A LD (HL),A       ; Write the attribute byte back to *#REGhl.
 $8C5B INC HL          ; Increment the attribute address pointer by one.
 $8C5C DJNZ $8C57      ; Decrease the counter by one and jump back to
                       ; #R$8C57 until it is zero.
 $8C5E RET             ; Return.
; View the equivalent code in;
; #LIST
; { #COOKIE$7020 }
; { #SABREWULF$AEA1 }
; LIST#

; Unset Flash Text
;
; Used by the routine at #R$8C71.
; .
; Clear the FLASH bit of the three score label attributes at the
; screen position in #REGhl.
;
; HL Pixel address co-ordinates
@label=UnsetFlashText
c$8C5F CALL $8506    ; Call #R$8506.
 $8C62 LD B,$03      ; Set a letter counter in #REGb for #N$03 loops.
@label=UnsetFlashText_Loop
*$8C64 LD A,(HL)     ; Fetch the attribute byte.
 $8C65 AND %01111111 ; Keep only bits 0-6 (i.e. everything except the flash
                     ; bit).
 $8C67 LD (HL),A     ; Write the attribute byte back to *#REGhl.
 $8C68 INC HL        ; Increment the attribute address pointer by one.
 $8C69 DJNZ $8C64    ; Decrease the counter by one and jump back to
                     ; #R$8C64 until it is zero.
 $8C6B RET           ; Return.

; Flash 2UP Score Label
;
; Used by the routine at #R$8C3E.
; .
; Point #REGhl at the 2UP score label, then flash it at #R$8C52.
@label=FlashScoreLabel2UP
c$8C6C LD HL,$00D8   ; #REGhl=#N($00D8,$04,$04) (position of the 2UP score
                     ; label).
 $8C6F JR $8C52      ; Jump to #R$8C52.

; Handler: Jetman
;
; Handler for Jetman while he is walking on the ground. Counts down
; #R$5E67 at the start of a turn, then draws the fuel gauge and reads the
; controls.
;
; IX Actor slot
;
; Count down #R$5E67, or skip straight to play.
@label=Handler_Jetman
c$8C71 LD HL,$5E67   ; {If #R$5E67 is zero, jump to #R$8C99.
 $8C74 LD A,(HL)     ;
 $8C75 AND A         ;
 $8C76 JR Z,$8C99    ; }
 $8C78 DEC (HL)      ; Decrement #R$5E67 by one.
 $8C79 JR NZ,$8C3E   ; Jump to #R$8C3E if the delay timer is still active.
; Play the pickup tone and unflash the score label.
 $8C7B CALL $B8C9    ; Call #R$B8C9.
 $8C7E LD A,($5EA0)  ; #REGa=*#R$5EA0.
 $8C81 AND %00000001 ; Keep only bit 0.
 $8C83 LD ($5EA2),A  ; Write the result to #R$5EA2.
; Pick the score label of the active player to
; unflash.
 $8C86 LD A,($5E65)  ; {Jump to #R$8C94 if #R$5E65 is not zero.
 $8C89 AND A         ;
 $8C8A JR NZ,$8C94   ; }
 $8C8C LD HL,$0018   ; #REGhl=#N($0018,$04,$04).
@label=Handler_Jetman_AfterLevel
*$8C8F CALL $8C5F    ; Call #R$8C5F.
 $8C92 JR $8C99      ; Jump to #R$8C99.
@label=Handler_Jetman_Draw
*$8C94 LD HL,$00D8   ; #REGhl=#N($00D8,$04,$04).
 $8C97 JR $8C8F      ; Jump to #R$8C8F.
; Draw the fuel gauge and read the controls.
@label=Handler_Jetman_Play
*$8C99 LD HL,$1040   ; #REGhl=#N($1040,$04,$04).
 $8C9C LD A,($608F)  ; Fetch the high fuel byte from #R$608F.
 $8C9F CALL $8C01    ; Call #R$8C01.
; Read the controls and walk left or right, or take
; off if UP is pressed.
 $8CA2 CALL $8F90    ; Call #R$8F90.
 $8CA5 BIT 1,A       ; {Jump to #R$8CE2 if LEFT is pressed.
 $8CA7 JP Z,$8CE2    ; }
 $8CAA BIT 0,A       ; {Jump to #R$8CF4 if RIGHT is pressed.
 $8CAC JP Z,$8CF4    ; }
 $8CAF BIT 3,A       ; Test whether UP is pressed.
 $8CB1 LD A,$00      ; {Clear the horizontal speed.
 $8CB3 LD (IX+$05),A ; }
 $8CB6 JP Z,$9005    ; Jump to #R$9005 if UP is pressed.
 $8CB9 JP $8CDF      ; Jump to #R$8CDF.

; Handler: Jetman Walk
;
; Jetman is walking on the ground. Keep him walking while there is
; ground beneath him, or launch him if UP is pressed or the ground ends.
;
; IX Actor slot
;
; Set the vertical thrust first. #N$F0
; is a signed -#N$10 upward thrust.
@label=Handler_JetmanWalk
c$8CBC LD (IX+$06),$F0 ; Write #N$F0 to *#REGix+#N$06.
 $8CC0 CALL $8F90      ; Call #R$8F90.
 $8CC3 BIT 3,A         ; {Jump to #R$9005 if UP is pressed.
 $8CC5 JP Z,$9005      ; }
; Keep walking if there is ground under Jetman, otherwise launch.
 $8CC8 CALL $91BB      ; Call #R$91BB.
 $8CCB LD A,D          ; {Jump to #R$9005 if there is no terrain under
 $8CCC AND A           ; Jetman.
 $8CCD JP Z,$9005      ; }
 $8CD0 LD A,E          ; {Jump to #R$9005 if the cell beside Jetman is empty.
 $8CD1 AND A           ;
 $8CD2 JP Z,$9005      ; }
 $8CD5 LD A,E          ; {Jump to #R$9005 if bit 3 of the second terrain byte is
 $8CD6 OR E            ; set (a crater tile).
 $8CD7 BIT 3,A         ;
 $8CD9 JP NZ,$9005     ; }
 $8CDC JP $8DC5        ; Jump to #R$8DC5 to move and animate Jetman.
; This entry point is used by the routine at #R$8C71.
@label=Handler_JetmanWalk_Face
*$8CDF JP $8DD9        ; Jump to #R$8DD9.
; This entry point is used by the routine at #R$8C71.
; .
; Face Jetman left and keep walking. #N$F0 is a
; signed -#N$10 leftward speed.
@label=Handler_JetmanWalk_FaceLeft
*$8CE2 LD A,$F0        ; {Write #N$F0 to *#REGix+#N$05.
 $8CE4 LD (IX+$05),A   ; }
; Bit 2 of the 0-based sprite index is the facing: reset means left and
; set means right.
 $8CE7 LD A,(IX+$00)   ; #REGa=*#REGix+#N$00.
 $8CEA DEC A           ; Decrease it to a 0-based sprite index.
 $8CEB RES 2,A         ; Reset the facing bit.
 $8CED INC A           ; Restore the 1-based sprite ID.
 $8CEE LD (IX+$00),A   ; Write #REGa back to *#REGix+#N$00.
 $8CF1 JP $8CBC        ; Jump to #R$8CBC.
; This entry point is used by the routine at #R$8C71.
; .
; Face Jetman right and keep walking. #N$10 is a
; signed +#N$10 rightward speed.
@label=Handler_JetmanWalk_FaceRight
*$8CF4 LD A,$10        ; {Write #N$10 to *#REGix+#N$05.
 $8CF6 LD (IX+$05),A   ; }
; Same 0-based facing bit as #R$8CE7, but set it for
; right.
 $8CF9 LD A,(IX+$00)   ; #REGa=*#REGix+#N$00.
 $8CFC DEC A           ; Decrease it to a 0-based sprite index.
 $8CFD SET 2,A         ; Set the facing bit.
 $8CFF INC A           ; Restore the 1-based sprite ID.
 $8D00 LD (IX+$00),A   ; Write #REGa back to *#REGix+#N$00.
 $8D03 JP $8CBC        ; Jump to #R$8CBC.

; Handler: Jetman Movement
;
; Read the controls, spend fuel when flying, and update
; Jetman's facing and animation.
;
; IX Actor slot
;
; Face Jetman from LEFT/ RIGHT, or coast the current
; horizontal speed toward a rest.
@label=Handler_JetmanMovement
c$8D06 CALL $8F90      ; Call #R$8F90.
 $8D09 BIT 1,A         ; {Jump to #R$8EC5 if LEFT is pressed.
 $8D0B JP Z,$8EC5      ; }
 $8D0E BIT 0,A         ; {Jump to #R$8E5A if RIGHT is pressed.
 $8D10 JP Z,$8E5A      ; }
 $8D13 LD A,(IX+$05)   ; {Jump to #R$8D3A if the horizontal speed is zero.
 $8D16 AND A           ;
 $8D17 JR Z,$8D3A      ; }
 $8D19 JP P,$8D2A      ; Jump to #R$8D2A if Jetman is moving right.
; Coast a leftward speed back toward rest.
 $8D1C ADD A,$02       ; Add #N$02 to the speed.
 $8D1E CP $D0          ; {Jump to #R$8D37 if it is now less than #N$D0.
 $8D20 JR C,$8D37      ; }
 $8D22 CP $E0          ; {Jump to #R$8D37 if it is at least #N$E0.
 $8D24 JR NC,$8D37     ; }
 $8D26 ADD A,$10       ; Add a further #N$10 to leave the mid-band.
 $8D28 JR $8D37        ; Jump to #R$8D37.
; Coast a rightward speed back toward rest.
@label=Handler_JetmanMovement_CoastRight
*$8D2A ADD A,$FE       ; Decrease the speed by #N$02.
 $8D2C CP $40          ; {Jump to #R$8D37 if it is now at least #N$40.
 $8D2E JR NC,$8D37     ; }
 $8D30 CP $30          ; {Jump to #R$8D37 if it is less than #N$30.
 $8D32 JP C,$8D37      ; }
 $8D35 SUB $10         ; Subtract a further #N$10 to leave the mid-band.
; This entry point is used by the routines at #R$8E5A and #R$8EC5.
@label=Handler_JetmanMovement_Grounded
*$8D37 LD (IX+$05),A   ; Write the speed to *#REGix+#N$05.
; This entry point is used by the routines at #R$8E5A and #R$8EC5.
; .
; Read the thrust keys while any fuel remains.
@label=Handler_JetmanMovement_Read
*$8D3A CALL $8F90      ; Call #R$8F90.
 $8D3D LD B,A          ; Stash the controls in #REGb.
 $8D3E LD A,($608F)    ; {Jump to #R$8D4E if #R$608F is zero.
 $8D41 AND A           ;
 $8D42 JR Z,$8D4E      ; }
 $8D44 BIT 3,B         ; {Jump to #R$8F34 if UP is pressed.
 $8D46 JP Z,$8F34      ; }
 $8D49 BIT 2,B         ; {Jump to #R$8F61 if DOWN is pressed.
 $8D4B JP Z,$8F61      ; }
; Apply gravity when Jetman is not thrusting.
@label=Handler_JetmanMovement_Gravity
*$8D4E LD B,$00        ; Clear the fuel-spend base.
 $8D50 LD A,(IX+$06)   ; {Jump to #R$8D5B if the vertical thrust is negative.
 $8D53 AND A           ;
 $8D54 JP M,$8D5B      ; }
 $8D57 CP $40          ; {Jump to #R$8D61 if the downward thrust is already
 $8D59 JR NC,$8D61     ; at least #N$40.}
; The gravity step is #N$08 (signed +#N$08).
; Upward thrust uses the opposite #N$F8.
@label=Handler_JetmanMovement_ThrustStep
*$8D5B LD C,$08        ; Set the downward step to #N$08.
; This entry point is used by the routine at #R$8F34.
@label=Handler_JetmanMovement_AddThrust
*$8D5D ADD A,C         ; {Add the step to the vertical thrust.
 $8D5E LD (IX+$06),A   ; }
; This entry point is used by the routine at #R$8F34.
; .
; Convert the thrust into a Y offset and test for the
; ground or a crater.
@label=Handler_JetmanMovement_Loop
*$8D61 LD A,(IX+$06)   ; Fetch the vertical thrust.
 $8D64 SRA A           ; {Divide it by #N$10.
 $8D66 SRA A           ;
 $8D68 SRA A           ;
 $8D6A SRA A           ; }
 $8D6C ADD A,(IX+$04)  ; Add it to Jetman's Y position.
 $8D6F CP $40          ; {Jump to #R$8F61 if Jetman is above the play area.
 $8D71 JP C,$8F61      ; }
 $8D74 CP $B0          ; {Jump to #R$8D90 if Jetman is still above the
 $8D76 JR C,$8D90      ; ground line.}
; Check the terrain beneath Jetman's new position.
 $8D78 CALL $91BB      ; Call #R$91BB.
 $8D7B LD A,D          ; {Jump to #R$8D8A if the first terrain cell is empty.
 $8D7C AND A           ;
 $8D7D JR Z,$8D8A      ; }
 $8D7F LD A,E          ; {Jump to #R$8D8A if the second terrain cell is empty.
 $8D80 AND A           ;
 $8D81 JR Z,$8D8A      ; }
 $8D83 LD A,E          ; {Jump to #R$8FF4 if neither cell has bit 3 set (a
 $8D84 OR D            ; crater).
 $8D85 BIT 3,A         ;
 $8D87 JP Z,$8FF4      ; }
; When the cell is empty or a crater, snap to the ground line at Y=#N$AF
; and give a small upward thrust of #N$E0 (signed -#N$20).
@label=Handler_JetmanMovement_ClampThrust
*$8D8A LD (IX+$06),$E0 ; Write #N$E0 to the vertical thrust.
 $8D8E LD A,$AF        ; #REGa=#N$AF.
@label=Handler_JetmanMovement_WriteY
*$8D90 LD (IX+$04),A   ; Write the Y position to *#REGix+#N$04.
; This entry point is used by the routine at #R$8F61.
; .
; Spend fuel from the horizontal speed, then redraw the
; gauge.
@label=Handler_JetmanMovement_FuelFromSpeed
*$8D93 LD A,(IX+$05)   ; {Jump to #R$8D9C if the horizontal speed is positive.
 $8D96 AND A           ;
 $8D97 JP P,$8D9C      ; }
 $8D9A NEG             ; Negate it so the spend uses the magnitude.
@label=Handler_JetmanMovement_HalveSpeed
*$8D9C SRA A           ; Halve the speed.
 $8D9E ADD A,B         ; Add the fuel-spend base.
 $8D9F SLA A           ; Double the result.
 $8DA1 LD C,A          ; {Store the spend in #REGbc.
 $8DA2 LD B,$00        ; }
 $8DA4 LD HL,($608E)   ; Fetch the current fuel from #R$608E.
 $8DA7 LD A,H          ; {Jump to #R$8DBB if the fuel has already run out.
 $8DA8 OR L            ;
 $8DA9 JR Z,$8DBB      ; }
 $8DAB AND A           ; Reset the carry flag.
; Subtract the fuel expenditure from the current fuel level.
; .
; See #POKE(infinite_fuel,Infinite Fuel).
@label=Handler_JetmanMovement_SpendFuel
 $8DAC SBC HL,BC       ; Subtract the spend from the fuel.
 $8DAE LD A,H          ; {Jump to #R$8DBB if the high fuel byte is not zero.
 $8DAF AND A           ;
 $8DB0 JR NZ,$8DBB     ; }
; Queue a tune and empty the tank when the fuel is
; used up.
 $8DB2 LD DE,$BA2D     ; #REGde=#R$BA2D.
 $8DB5 CALL $B9BC      ; Call #R$B9BC.
 $8DB8 LD HL,$0000     ; #REGhl=#N($0000,$04,$04).
; Store the remaining fuel and redraw the gauge.
@label=Handler_JetmanMovement_AfterFuel
*$8DBB LD ($608E),HL   ; Write the remaining fuel to #R$608E.
 $8DBE LD A,H          ; Fetch the high fuel byte.
 $8DBF LD HL,$1040     ; #REGhl=#N($1040,$04,$04) (gauge position).
 $8DC2 CALL $8C01      ; Call #R$8C01.
; This entry point is used by the routine at #R$8CBC.
; .
; Walk the 0-based sprite index: keep bits 2-7
; (facing and flying/ walking) and merge bits 0-1
; from the frame timer.
@label=Handler_JetmanMovement_Animate
*$8DC5 CALL $907B      ; Call #R$907B.
 $8DC8 LD A,($5E42)    ; Fetch #R$5E42.
 $8DCB AND %00000011   ; Keep only bits 0-1.
 $8DCD LD C,A          ; Stash the frame bits.
 $8DCE LD A,(IX+$00)   ; Fetch the actor type.
 $8DD1 DEC A           ; Decrease it to a 0-based sprite index.
 $8DD2 AND %11111100   ; Keep only bits 2-7.
 $8DD4 OR C            ; Merge in the frame bits.
 $8DD5 INC A           ; Restore the 1-based sprite ID.
 $8DD6 LD (IX+$00),A   ; Write it back to *#REGix+#N$00.
; This entry point is used by the routines at #R$8CBC, #R$8FF4 and #R$9005.
; .
; Draw Jetman and fire the laser when FIRE is held.
@label=Handler_JetmanMovement_Draw
*$8DD9 CALL $8701      ; Call #R$8701.
 $8DDC CALL $8733      ; Call #R$8733.
 $8DDF CALL $8F90      ; Call #R$8F90.
 $8DE2 BIT 4,A         ; {Call #R$9DC0 if FIRE is pressed.
 $8DE4 CALL Z,$9DC0    ; }
; Queue a flying jingle on some frames.
 $8DE7 LD A,($FF54)    ; {Jump to #R$8E07 if #R$FF54 is not
 $8DEA CP $51          ; #R$FF51.
 $8DEC JR NZ,$8E07     ; }
 $8DEE LD A,($5E40)    ; Fetch #R$5E40.
 $8DF1 AND %01111111   ; Keep only bits 0-6.
 $8DF3 JR NZ,$8E07     ; Jump to #R$8E07 if the result is not zero.
; Pick a jingle from the table using the game timer and
; queue it.
 $8DF5 LD A,($5E42)    ; Fetch #R$5E42.
 $8DF8 AND %00001110   ; Keep only bits 1-3.
 $8DFA LD C,A          ; {Convert that index into #REGbc.
 $8DFB LD B,$00        ; }
 $8DFD LD HL,$9DB0     ; {Point #REGhl at the matching entry in #R$9DB0.
 $8E00 ADD HL,BC       ; }
 $8E01 LD E,(HL)       ; {Fetch the tune pointer.
 $8E02 INC HL          ;
 $8E03 LD D,(HL)       ; }
 $8E04 CALL $B9BC      ; Call #R$B9BC.
; Refill the tank when Jetman is beside the rover, then
; take a platform (action key) or board (SPACE).
@label=Handler_JetmanMovement_RefillFromRover
*$8E07 LD A,(IX+$04)   ; Fetch Jetman's Y position.
 $8E0A CP $A8          ; {Return if it is less than #N$A8.
 $8E0C RET C           ; }
; Return unless the rover is on this screen and within reach.
 $8E0D LD HL,($607A)   ; Fetch #R$607A.
 $8E10 LD DE,($6092)   ; Fetch #R$6092.
 $8E14 AND A           ; {Subtract the rover position from Jetman's.
 $8E15 SBC HL,DE       ; }
 $8E17 LD DE,$000C     ; {Add a #N$0C tolerance.
 $8E1A ADD HL,DE       ; }
 $8E1B LD A,H          ; Fetch the high byte of the gap.
 $8E1C AND %00011111   ; Keep only bits 0-4.
 $8E1E RET NZ          ; Return if the rover is not on this screen.
 $8E1F LD A,L          ; {Return if the low byte is at least #N$18.
 $8E20 CP $18          ;
 $8E22 RET NC          ; }
; Refill the fuel tank.
 $8E23 LD HL,$9000     ; {Write #N$9000 to #R$608E.
 $8E26 LD ($608E),HL   ; }
; Bit 0 of Jetman's flags is set while he is
; carrying an item.
 $8E29 BIT 0,(IX+$08)  ; {Return if Jetman is already carrying an item.
 $8E2D RET NZ          ; }
 $8E2E CALL $945C      ; {Jump to #R$8E4F if the action key is not pressed.
 $8E31 JR Z,$8E4F      ; }
 $8E33 LD HL,$60F0     ; #REGhl=#R$60F0.
 $8E36 LD A,(HL)       ; {Return if world slot 4 is already in use.
 $8E37 AND A           ;
 $8E38 RET NZ          ; }
; Type #N$2E is the platform Jetman now carries.
 $8E39 LD (HL),$2E     ; Write type #N$2E to the slot.
 $8E3B LD DE,$0007     ; {Move to the colour byte.
 $8E3E ADD HL,DE       ; }
 $8E3F LD (HL),$43     ; Write #COLOUR$43 to the colour.
 $8E41 INC HL          ; {Set bit 0 of the slot flags.
 $8E42 SET 0,(HL)      ; }
 $8E44 INC HL          ; {Write #N$00 to *#REGhl+#N$02.
 $8E45 INC HL          ;
 $8E46 LD (HL),$00     ; }
 $8E48 SET 0,(IX+$08)  ; Set bit 0 of Jetman's flags.
 $8E4C JP $B8BD        ; Jump to #R$B8BD.
; Board the rover if SPACE is pressed.
@label=Handler_JetmanMovement_TestSpace
*$8E4F CALL $933E      ; {Return if SPACE is not pressed.
 $8E52 RET Z           ; }
 $8E53 CALL $8634      ; Call #R$8634.
 $8E56 CALL $930C      ; Call #R$930C.
 $8E59 RET             ; Return.

; Face Jetman Right
;
; Used by the routine at #R$8D06.
; .
; Set bit #N$02 of the actor type so Jetman faces right,
; then accelerate or cap the horizontal speed.
;
; IX Actor slot
;
; Decrease to the 0-based sprite index, set bit 2
; to face right, then write the 1-based ID back.
@label=FaceJetmanRight
c$8E5A LD A,(IX+$00)  ; Fetch the actor type.
 $8E5D DEC A          ; Decrease it to a 0-based sprite index.
 $8E5E SET 2,A        ; Set the facing bit.
 $8E60 INC A          ; Restore the 1-based sprite ID.
 $8E61 LD (IX+$00),A  ; Write it back to *#REGix+#N$00.
; Push the speed right while any fuel remains. Bit 0
; of the actor flags is set while Jetman is carrying an
; item, which slows him down.
 $8E64 BIT 0,(IX+$08) ; {Jump to #R$8E97 if Jetman is carrying an item.
 $8E68 JR NZ,$8E97    ; }
 $8E6A LD A,(IX+$05)  ; {Jump to #R$8E89 if the horizontal speed is negative.
 $8E6D AND A          ;
 $8E6E JP M,$8E89     ; }
; Settle on the slow speed if the fuel has run out.
 $8E71 EX AF,AF'      ; Stash the speed in #REGaf'.
 $8E72 LD A,($608F)   ; {Jump to #R$8E93 if #R$608F is zero.
 $8E75 AND A          ;
 $8E76 JR Z,$8E93     ; }
; Speed up to the right unless the speed is already at the cap.
 $8E78 EX AF,AF'      ; Restore the speed.
 $8E79 CP $40         ; {Jump to #R$8D3A if the speed is already at least
 $8E7B JP NC,$8D3A    ; #N$40.}
 $8E7E ADD A,$08      ; Add #N$08 to the speed.
 $8E80 CP $30         ; {Jump to #R$8E86 if it is still less than #N$30.
 $8E82 JR C,$8E86     ; }
 $8E84 ADD A,$10      ; Add a further #N$10 to leave the mid-band.
; This entry point is used by the routine at #R$8EC5.
@label=FaceJetmanRight_Loop
*$8E86 JP $8D37       ; Jump to #R$8D37.
; Reverse a leftward speed toward the right.
@label=FaceJetmanRight_ReverseLeft
*$8E89 CP $D0         ; {Jump to #R$8E8F if the speed is at least #N$D0.
 $8E8B JR NC,$8E8F    ; }
 $8E8D ADD A,$10      ; Add #N$10 to the speed.
@label=FaceJetmanRight_AddStep
*$8E8F ADD A,$08      ; Add #N$08 to the speed.
 $8E91 JR $8E86       ; Jump to #R$8E86.
; With no fuel, settle on a slow rightward speed of #N$10 (signed +#N$10).
@label=FaceJetmanRight_NoFuel
*$8E93 LD A,$10       ; Set a slow rightward speed of #N$10.
 $8E95 JR $8E86       ; Jump to #R$8E86.
; While carrying an item, use a slower rightward cap.
@label=FaceJetmanRight_Carrying
*$8E97 LD A,(IX+$05)  ; {Jump to #R$8EB0 if the horizontal speed is negative.
 $8E9A AND A          ;
 $8E9B JP M,$8EB0     ; }
; Settle on the slow speed if the fuel has run out.
 $8E9E EX AF,AF'      ; Stash the speed in #REGaf'.
 $8E9F LD A,($608F)   ; {Jump to #R$8EBB if #R$608F is zero.
 $8EA2 AND A          ;
 $8EA3 JR Z,$8EBB     ; }
; Speed up to the right unless the speed is already at the cap.
 $8EA5 EX AF,AF'      ; Restore the speed.
 $8EA6 CP $20         ; {Jump to #R$8EC0 if the speed is already at least
 $8EA8 JP NC,$8EC0    ; #N$20.}
 $8EAB ADD A,$04      ; Add #N$04 to the speed.
 $8EAD JP $8D37       ; Jump to #R$8D37.
; Reverse a leftward speed toward the right.
@label=FaceJetmanRight_CarryingClamp
*$8EB0 CP $D0         ; {Jump to #R$8EB6 if the speed is at least #N$D0.
 $8EB2 JR NC,$8EB6    ; }
 $8EB4 ADD A,$10      ; Add #N$10 to the speed.
@label=FaceJetmanRight_CarryingStep
*$8EB6 ADD A,$08      ; Add #N$08 to the speed.
 $8EB8 JP $8D37       ; Jump to #R$8D37.
; With no fuel while carrying an item, settle on #N$10 (signed +#N$10).
@label=FaceJetmanRight_CarryingSlow
*$8EBB LD A,$10       ; Set a slow rightward speed of #N$10.
 $8EBD JP $8D37       ; Jump to #R$8D37.
; Cap the rightward speed at #N$20 while carrying an item.
@label=FaceJetmanRight_CarryingFast
*$8EC0 LD A,$20       ; Set a rightward cap of #N$20.
 $8EC2 JP $8D37       ; Jump to #R$8D37.

; Face Jetman Left
;
; Used by the routine at #R$8D06.
; .
; Reset bit #N$02 of the actor type so Jetman faces left,
; then accelerate or cap the horizontal speed.
;
; IX Actor slot
;
; Decrease to the 0-based sprite index, reset bit
; 2 to face left, then write the 1-based ID back.
@label=FaceJetmanLeft
c$8EC5 LD A,(IX+$00)  ; Fetch the actor type.
 $8EC8 DEC A          ; Decrease it to a 0-based sprite index.
 $8EC9 RES 2,A        ; Reset the facing bit.
 $8ECB INC A          ; Restore the 1-based sprite ID.
 $8ECC LD (IX+$00),A  ; Write it back to *#REGix+#N$00.
; Push the speed left while any fuel remains. Bit 0
; of the actor flags is set while Jetman is carrying an
; item, which slows him down.
 $8ECF BIT 0,(IX+$08) ; {Jump to #R$8F03 if Jetman is carrying an item.
 $8ED3 JR NZ,$8F03    ; }
 $8ED5 LD A,(IX+$05)  ; {Jump to #R$8EF3 if the horizontal speed is positive.
 $8ED8 AND A          ;
 $8ED9 JP P,$8EF3     ; }
; Settle on the slow speed if the fuel has run out.
 $8EDC EX AF,AF'      ; Stash the speed in #REGaf'.
 $8EDD LD A,($608F)   ; {Jump to #R$8EFF if #R$608F is zero.
 $8EE0 AND A          ;
 $8EE1 JR Z,$8EFF     ; }
; Speed up to the left unless the speed is already at the cap.
 $8EE3 EX AF,AF'      ; Restore the speed.
 $8EE4 CP $D0         ; {Jump to #R$8D3A if the speed is already below
 $8EE6 JP C,$8D3A     ; #N$D0.}
 $8EE9 SUB $08        ; Subtract #N$08 from the speed.
 $8EEB CP $E0         ; {Jump to #R$8E86 if it is still at least #N$E0.
 $8EED JR NC,$8E86    ; }
 $8EEF SUB $10        ; Subtract a further #N$10 to leave the mid-band.
 $8EF1 JR $8E86       ; Jump to #R$8E86.
; Reverse a rightward speed toward the left.
@label=FaceJetmanLeft_ReverseRight
*$8EF3 CP $30         ; {Jump to #R$8EFB if the speed is less than #N$30.
 $8EF5 JR C,$8EFB     ; }
 $8EF7 SUB $10        ; Subtract #N$10 from the speed.
 $8EF9 JR $8E86       ; Jump to #R$8E86.
@label=FaceJetmanLeft_SubtractStep
*$8EFB SUB $08        ; Subtract #N$08 from the speed.
 $8EFD JR $8E86       ; Jump to #R$8E86.
; With no fuel, settle on a slow leftward speed of #N$F0 (signed -#N$10).
@label=FaceJetmanLeft_NoFuel
*$8EFF LD A,$F0       ; Set a slow leftward speed of #N$F0.
 $8F01 JR $8E86       ; Jump to #R$8E86.
; While carrying an item, use a slower leftward cap.
@label=FaceJetmanLeft_Carrying
*$8F03 LD A,(IX+$05)  ; {Jump to #R$8F1C if the horizontal speed is positive.
 $8F06 AND A          ;
 $8F07 JP P,$8F1C     ; }
; Settle on the slow speed if the fuel has run out.
 $8F0A EX AF,AF'      ; Stash the speed in #REGaf'.
 $8F0B LD A,($608F)   ; {Jump to #R$8F2A if #R$608F is zero.
 $8F0E AND A          ;
 $8F0F JR Z,$8F2A     ; }
; Speed up to the left unless the speed is already at the cap.
 $8F11 EX AF,AF'      ; Restore the speed.
 $8F12 CP $F0         ; {Jump to #R$8F2F if the speed is already below
 $8F14 JP C,$8F2F     ; #N$F0.}
 $8F17 SUB $04        ; Subtract #N$04 from the speed.
 $8F19 JP $8D37       ; Jump to #R$8D37.
; Reverse a rightward speed toward the left.
@label=FaceJetmanLeft_CarryingClamp
*$8F1C CP $30         ; {Jump to #R$8F25 if the speed is less than #N$30.
 $8F1E JR C,$8F25     ; }
 $8F20 SUB $10        ; Subtract #N$10 from the speed.
 $8F22 JP $8D37       ; Jump to #R$8D37.
@label=FaceJetmanLeft_CarryingStep
*$8F25 SUB $08        ; Subtract #N$08 from the speed.
 $8F27 JP $8D37       ; Jump to #R$8D37.
; With no fuel while carrying an item, settle on #N$F0 (signed -#N$10).
@label=FaceJetmanLeft_CarryingSlow
*$8F2A LD A,$F0       ; Set a slow leftward speed of #N$F0.
 $8F2C JP $8D37       ; Jump to #R$8D37.
; Cap the leftward speed at #N$E0 (signed -#N$20)
; while carrying an item.
@label=FaceJetmanLeft_CarryingFast
*$8F2F LD A,$E0       ; Set a leftward cap of #N$E0.
 $8F31 JP $8D37       ; Jump to #R$8D37.

; Apply Upward Thrust
;
; Used by the routine at #R$8D06.
; .
; Strengthen the upward thrust in *#REGix+#N$06 while
; UP is held, then continue the movement handler.
;
; IX Actor slot
;
; Strengthen the upward thrust while fuel remains.
@label=ApplyJetmanUpwardThrust
c$8F34 LD A,(IX+$06)   ; {Fetch the vertical thrust.
 $8F37 AND A           ; }
 $8F38 LD B,A          ; {Jump to #R$8F4C if it is already positive.
 $8F39 JP P,$8F4C      ; }
 $8F3C NEG             ; {Store the absolute thrust in #REGb.
 $8F3E LD B,A          ;
 $8F3F NEG             ; }
; Bit 0 of the actor flags is set while Jetman is
; carrying an item.
 $8F41 BIT 0,(IX+$08)  ; {Jump to #R$8F51 if Jetman is carrying an item.
 $8F45 JR NZ,$8F51     ; }
 $8F47 CP $C0          ; {Jump to #R$8D61 if the thrust is already below
 $8F49 JP C,$8D61      ; #N$C0.}
; The normal upward step is #N$F8 (signed
; -#N$08). Gravity uses the opposite step of #N$08.
@label=ApplyJetmanUpwardThrust_Normal
*$8F4C LD C,$F8        ; Set the normal upward step to #N$F8.
 $8F4E JP $8D5D        ; Jump to #R$8D5D.
; While Jetman is carrying an item, use a weaker
; upward step of #N$FC (signed -#N$04).
@label=ApplyJetmanUpwardThrust_Carrying
*$8F51 CP $E0          ; Compare the thrust with #N$E0.
 $8F53 LD C,$FC        ; Set the upward step to #N$FC.
 $8F55 JP NC,$8D5D     ; Jump to #R$8D5D if the thrust is at least #N$E0.
; Cap Jetman's upward thrust at #N$E0 and spend
; extra fuel: #REGb=#N$40 is the base added at
; #R$8D93.
 $8F58 LD (IX+$06),$E0 ; Write #N$E0 to the vertical thrust.
 $8F5C LD B,$40        ; Set the fuel-spend base to #N$40.
 $8F5E JP $8D61        ; Jump to #R$8D61.

; Clear Jetman Thrust
;
; Used by the routine at #R$8D06.
; .
; Stop vertical thrust, leave Jetman's Y position unchanged and
; go on to spend fuel.
;
; IX Actor slot
;
; Stop vertical thrust and skip the Y position update.
@label=ClearJetmanThrust
c$8F61 LD (IX+$06),$00 ; Clear the vertical thrust.
; #REGb is the fuel-spend base added at #R$8D93.
; #N$10 spends extra fuel; the gravity path uses
; #N$00.
 $8F65 LD B,$10        ; Set the fuel-spend base to #N$10.
 $8F67 JP $8D93        ; Jump to #R$8D93.

; Controls: Cursor Joystick
;
; Used by the routine at #R$8F90.
; .
; Read the cursor keys and remap them onto the Kempston
; bit order.
;
; O:A Controls
@label=ReadCursorJoystick
c$8F6A LD A,$EF      ; {Read from the keyboard;
 $8F6C OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $8F6E IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$EF | 0 | 9 | 8 | 7 | 6 }
                     ; TABLE#}
 $8F70 LD C,A        ; Store this value in #REGc temporarily.
; Handle "up".
 $8F71 AND %00001000 ; Keep only bit 3 ("7").
 $8F73 LD E,A        ; Store this value in #REGe.
 $8F74 LD A,C        ; {Retrieve #REGc and rotate the bits right twice.
 $8F75 RRCA          ;
 $8F76 RRCA          ; }
; Handle "down", "right" and "fire".
 $8F77 AND %01000101 ; Keep only bits 0 ("8"), 2 ("6") and 6 ("0").
 $8F79 OR E          ; Set the bits from #REGe.
 $8F7A LD E,A        ; Store this value back in #REGe.
; Handle relocating the "fire" bit.
 $8F7B RRCA          ; {Rotate the bits right twice.
 $8F7C RRCA          ; }
 $8F7D AND %00010000 ; Keep only bit 4 ("0").
 $8F7F OR E          ; Set the bits from #REGe.
; Filter out the unused bits.
 $8F80 AND %00011111 ; Keep only bits 0-4.
 $8F82 LD E,A        ; Store this value back in #REGe.
; Handle reading "left" from a different port.
 $8F83 LD A,$F7      ; {Read from the keyboard;
 $8F85 OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $8F87 IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$F7 | 1 | 2 | 3 | 4 | 5 }
                     ; TABLE#}
; Handle relocating the "left" bit.
 $8F89 RRA           ; {Rotate the bits right three times.
 $8F8A RRA           ;
 $8F8B RRA           ; }
 $8F8C AND %00000010 ; Keep only bit 1 ("5").
 $8F8E OR E          ; Set the bits from #REGe resulting in;
                     ; #TABLE(default,centre,centre,centre)
                     ; { =h Key | =h Direction | =h Bit }
                     ; { "8" | Right | 0 }
                     ; { "5" | Left | 1 }
                     ; { "6" | Down | 2 }
                     ; { "7" | Up | 3 }
                     ; { "0" | Fire | 4 }
                     ; TABLE#
                     ; This matches the Kempston Joystick inputs.
 $8F8F RET           ; Return.
; View the equivalent code in;
; #LIST
; { #SABREWULF$B103 }
; LIST#

; Handler: Controls
;
; Used by the routines at #R$8C71, #R$8CBC, #R$8D06, #R$91E2, #R$A3FF, #R$A579
; and #R$F295.
; .
; Dispatch to the keyboard, cursor or Kempston reader
; chosen in #R$5E00.
;
; O:A Controls
;
; Dispatch to the keyboard, cursor or Kempston reader.
@label=HandlerControls
c$8F90 LD A,($5E00)  ; {Jump to #R$8F9F if #R$5E00 is set for keyboard
 $8F93 AND %00000110 ; controls.
 $8F95 JR Z,$8F9F    ; }
 $8F97 CP $04        ; {Jump to #R$8F6A if #R$5E00 is set for cursor
 $8F99 JR Z,$8F6A    ; joystick controls.}
; Continue on to #R$8F9B.
; .
; View the equivalent code in;
; #LIST
; { #SABREWULF$B0A3 }
; LIST#

; Controls: Kempston Joystick
;
; Read the Kempston port and invert the bits so they
; match the keyboard decoder.
;
; O:A Controls
@label=ReadKempstonJoystick
c$8F9B IN A,($1F)    ; #REGa=controls.
 $8F9D CPL           ; Flip the bits.
 $8F9E RET           ; Return.
; View the equivalent code in;
; #LIST
; { #JETPAC$733A }
; { #PSSST$75CC }
; { #SABREWULF$B0D9 }
; { #TRANZAM$6188 }
; LIST#

; Controls: Keyboard
;
; Used by the routine at #R$8F90.
; .
; Read the movement and fire rows into the same bit
; order as the Kempston joystick.
;
; O:A Controls
;
; Start with every control bit released, then read 0-9.
@label=ReadKeyboard
c$8F9F LD C,$FF      ; Start with every control bit released.
 $8FA1 LD A,$E7      ; {Read from the keyboard;
 $8FA3 OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $8FA5 IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$E7 | 1 / 0 | 2 / 9 | 3 / 8 | 4 / 7 | 5 / 6 }
                     ; TABLE#}
 $8FA7 CPL           ; Flip the bits.
 $8FA8 AND %00011111 ; Keep only bits 0-4.
 $8FAA JR Z,$8FAE    ; Jump to #R$8FAE if no number key is pressed.
 $8FAC RES 2,C       ; Reset the DOWN bit.
; Read the top letter row; any key pressed in it
; counts as UP.
@label=ReadKeyboard_Letters
*$8FAE LD A,$DB      ; {Read from the keyboard;
 $8FB0 OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $8FB2 IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$DB | Q / P | W / O | E / I | R / U | T / Y }
                     ; TABLE#}
 $8FB4 CPL           ; Flip the bits.
 $8FB5 AND %00011111 ; Keep only bits 0-4.
 $8FB7 JR Z,$8FBB    ; Jump to #R$8FBB if no letter in this row is
                     ; pressed.
 $8FB9 RES 3,C       ; Reset the UP bit.
; Read the home row; any key pressed in it counts
; as FIRE.
@label=ReadKeyboard_HomeRow
*$8FBB LD A,$BD      ; {Read from the keyboard;
 $8FBD OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $8FBF IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$BD | A / ENTER | S / L | D / K | F / J | G / H }
                     ; TABLE#}
 $8FC1 CPL           ; Flip the bits.
 $8FC2 AND %00011111 ; Keep only bits 0-4.
 $8FC4 JR Z,$8FC8    ; Jump to #R$8FC8 if no letter in this row is
                     ; pressed.
 $8FC6 RES 4,C       ; Reset the FIRE bit.
; Read the bottom-left row; X and V count as LEFT
; and C counts as RIGHT.
@label=ReadKeyboard_ZXCV
*$8FC8 LD A,$FE      ; {Read from the keyboard;
 $8FCA OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $8FCC IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$FE | SHIFT | Z | X | C | V }
                     ; TABLE#}
 $8FCE CPL           ; Flip the bits.
 $8FCF LD B,A        ; Stash the row in #REGb.
 $8FD0 AND %00010100 ; Keep only bits 2 and 4.
 $8FD2 JR Z,$8FD6    ; Jump to #R$8FD6 if neither key is pressed.
 $8FD4 RES 1,C       ; Reset the LEFT bit.
; Reset the RIGHT bit if C is pressed.
@label=ReadKeyboard_TestC
*$8FD6 LD A,B        ; Fetch the stored row.
 $8FD7 AND %00001000 ; Keep only bit 3.
 $8FD9 JR Z,$8FDD    ; Jump to #R$8FDD if "C" is not pressed.
 $8FDB RES 0,C       ; Reset the RIGHT bit.
; Read the bottom-right row; N counts as LEFT and
; M or B counts as RIGHT.
@label=ReadKeyboard_BNM
*$8FDD LD A,$7F      ; {Read from the keyboard;
 $8FDF OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $8FE1 IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$7F | SPACE | FULL-STOP | M | N | B }
                     ; TABLE#}
 $8FE3 CPL           ; Flip the bits.
 $8FE4 LD B,A        ; Stash the row in #REGb.
 $8FE5 AND %00001000 ; Keep only bit 3.
 $8FE7 JR Z,$8FEB    ; Jump to #R$8FEB if "N" is not pressed.
 $8FE9 RES 1,C       ; Reset the LEFT bit.
; Reset the RIGHT bit if M or B is pressed.
@label=ReadKeyboard_TestFullStop
*$8FEB LD A,B        ; Fetch the stored row.
 $8FEC AND %00010100 ; Keep only bits 2 and 4.
 $8FEE JR Z,$8FF2    ; Jump to #R$8FF2 if neither key is pressed.
 $8FF0 RES 0,C       ; Reset the RIGHT bit.
@label=ReadKeyboard_ReturnControls
*$8FF2 LD A,C        ; #REGa=the collected controls.
 $8FF3 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #SABREWULF$B0FA }
; LIST#

; Land Jetman
;
; Used by the routine at #R$8D06.
; .
; Switch Jetman to the walking sprite, snap him to
; the ground line and redraw.
;
; IX Actor slot
;
; The actor type is a 1-based sprite ID. Decrease it
; to work on the 0-based index, set bit 3 to switch
; from the flying frames to the walking frames, then
; write the 1-based ID back.
@label=LandJetman
c$8FF4 LD A,(IX+$00)   ; Fetch the actor type.
 $8FF7 DEC A           ; Decrease it to a 0-based sprite index.
 $8FF8 SET 3,A         ; Set the walking-frame bit.
 $8FFA INC A           ; Restore the 1-based sprite ID.
 $8FFB LD (IX+$00),A   ; Write it back to *#REGix+#N$00.
; Snap Jetman to the ground line at Y=#N$AF.
 $8FFE LD (IX+$04),$AF ; Write #N$AF to Jetman's Y position.
; Draw the standing sprite and continue the
; movement handler.
 $9002 JP $8DD9        ; Jump to #R$8DD9.

; Launch Jetman
;
; Used by the routines at #R$8C71 and #R$8CBC.
; .
; Switch to the flying frames, apply upward thrust and lift Jetman
; three pixels.
;
; IX Actor slot
;
; Decrease to the 0-based sprite index, reset
; bit 3 to switch from walking to flying frames,
; then write the 1-based ID back.
@label=LaunchJetman
c$9005 LD A,(IX+$00) ; Fetch the actor type.
 $9008 DEC A         ; Decrease it to a 0-based sprite index.
 $9009 RES 3,A       ; Reset the walking-frame bit.
 $900B INC A         ; Restore the 1-based sprite ID.
 $900C LD (IX+$00),A ; Write it back to *#REGix+#N$00.
; #N$F0 is a signed -#N$10 upward thrust. Lift
; Jetman three pixels off the ground line.
 $900F LD A,$F0      ; {Write #N$F0 to the vertical thrust.
 $9011 LD (IX+$06),A ; }
 $9014 DEC (IX+$04)  ; {Decrease Jetman's Y position by three.
 $9017 DEC (IX+$04)  ;
 $901A DEC (IX+$04)  ; }
; Draw the flying sprite and continue the
; movement handler.
 $901D JP $8DD9      ; Jump to #R$8DD9.

; Initialise Jetman
;
; Used by the routine at #R$A826.
; .
; Respawn Jetman beside the parked rover: copy the default actor
; into #R$6078, set the start delay, take a life and refill the
; tank, unless #R$5E6C is already set.
;
; .
;
; Copy the default actor into #R$6078 if the rover is parked.
@label=InitialiseJetman
c$9020 LD A,($5E6C)  ; {Return if #R$5E6C is already set.
 $9023 AND A         ;
 $9024 RET NZ        ; }
 $9025 LD A,($6090)  ; Fetch the rover type from #R$6090.
; Rover sprite IDs begin at #N$1A. Continue only
; when the type is in the #N$10 rover frames
; #N$1A-#N$29.
 $9028 SUB $1A       ; Subtract #N$1A.
 $902A CP $10        ; {Return if that is not a rover frame.
 $902C RET NC        ; }
; Copy the default Jetman actor into the live slot.
 $902D LD HL,$9D5A   ; {Copy the default #N$18-byte Jetman data from #R$9D5A to the
 $9030 LD DE,$6078   ; Jetman slot at #R$6078.
 $9033 LD BC,$0018   ;
 $9036 LDIR          ; }
 $9038 LD HL,($6092) ; Fetch #R$6092.
 $903B LD BC,($6182) ; Fetch #R$6182.
 $903F CALL $AD3F    ; Call #R$AD3F.
 $9042 LD HL,($6092) ; Fetch #R$6092 again.
 $9045 JR NC,$9076   ; Jump to #R$9076 if the rover is outside the
                     ; #N$1000 range of #R$6182.
; Offset Jetman #N$40 to the right of the rover.
; The left-hand path at #R$9076 uses #N$FFC0.
 $9047 LD BC,$0040   ; Set the offset in #REGbc to #N($0040,$04,$04).
; Set the terrain scroll position from the offset
; world X.
@label=InitialiseJetman_Scroll
*$904A CALL $A002    ; Call #R$A002.
 $904D LD A,L        ; Fetch the low byte of the masked position.
 $904E AND %11111000 ; Keep only bits 3-7.
 $9050 LD L,A        ; Write it back to #REGl.
 $9051 LD ($607A),HL ; Write the position to #R$607A.
; Hold a longer start delay in a 2UP game.
 $9054 LD A,$40      ; #REGa=#N$40.
 $9056 LD HL,$5E00   ; #REGhl=#R$5E00.
 $9059 BIT 0,(HL)    ; {Jump to #R$905F if this is a 1UP game.
 $905B JR Z,$905F    ; }
 $905D ADD A,$3F     ; Add #N$3F to the delay.
@label=InitialiseJetman_WriteDelay
*$905F LD ($5E67),A  ; Write the delay to #R$5E67.
@label=InitialiseJetman_ReadLives
 $9062 LD A,($5EA1)  ; Fetch #R$5EA1.
; See #POKE(infinite_lives,Infinite Lives).
@label=InitialiseJetman_DecreaseLives
 $9065 DEC A         ; Decrease the lives counter by one.
@label=InitialiseJetman_WriteLives
 $9066 LD ($5EA1),A  ; Write it back to #R$5EA1.
; #N$9000 is a full tank.
 $9069 LD HL,$9000   ; {Fill #R$608E.
 $906C LD ($608E),HL ; }
; Clear #R$5E6C so Jetman is in play.
 $906F XOR A         ; {Write #N$00 to #R$5E6C.
 $9070 LD ($5E6C),A  ; }
 $9073 JP $894F      ; Jump to #R$894F.
; Offset Jetman #N$40 to the left of the rover.
@label=InitialiseJetman_OffsetLeft
*$9076 LD BC,$FFC0   ; Set the offset in #REGbc to #N$FFC0 (-#N$40).
 $9079 JR $904A      ; Jump to #R$904A.

; Apply Jetman Speed
;
; Used by the routines at #R$8D06, #R$91E2 and #R$B33D.
; .
; Use the horizontal speed in *#REGix+#N$05 to update
; Jetman's world position.
;
; IX Actor slot
@label=ApplyJetmanSpeed
c$907B LD A,(IX+$05) ; Fetch the horizontal speed.
 $907E SRA A         ; {Divide it by #N$10.
 $9080 SRA A         ;
 $9082 SRA A         ;
 $9084 SRA A         ; }
 $9086 LD E,A        ; Store the pixel step in #REGe.
 $9087 LD D,$00      ; Clear #REGd for a positive step.
 $9089 JP P,$908E    ; Jump to #R$908E if the step is positive.
 $908C LD D,$FF      ; Set #REGd=#N$FF for a negative step.
; Add the step to the world X and wrap it to the
; planet width.
@label=ApplyJetmanSpeed_AddWorldX
*$908E LD H,(IX+$03) ; Fetch the high byte of the world X.
 $9091 LD L,(IX+$02) ; Fetch the low byte of the world X.
 $9094 LD A,L        ; Fetch the fine X.
 $9095 AND %00000111 ; Keep only bits 0-2.
; Draw a new terrain column on a cell boundary, then
; scroll the terrain bitmap by the step.
 $9097 PUSH HL       ; {Stash the world X and the step on the stack.
 $9098 PUSH DE       ; }
 $9099 CALL Z,$915C  ; Call #R$915C if Jetman is on a cell boundary.
 $909C POP DE        ; Restore the step from the stack.
 $909D CALL $90AC    ; Call #R$90AC.
; Add the step to the world X and write it back.
 $90A0 POP HL        ; Restore the world X from the stack.
 $90A1 ADD HL,DE     ; Add the step to the world X.
 $90A2 LD A,H        ; Fetch the high byte.
 $90A3 AND %00011111 ; Keep only bits 0-4.
 $90A5 LD (IX+$03),A ; Write the high byte back to *#REGix+#N$03.
 $90A8 LD (IX+$02),L ; Write the low byte back to *#REGix+#N$02.
 $90AB RET           ; Return.
; Scroll the terrain bitmap left or right by the pixel
; step.
@label=ApplyJetmanSpeed_ScrollLeft
*$90AC LD HL,$50C0   ; #REGhl=#N$50C0.
 $90AF LD C,$08      ; Set a pixel row counter in #REGc for #N$08 loops.
 $90B1 LD A,E        ; {Return if there is no horizontal movement.
 $90B2 AND A         ;
 $90B3 RET Z         ; }
 $90B4 JP P,$9109    ; Jump to #R$9109 if Jetman is moving right.
; When Jetman is moving left, shift the terrain bitmap right.
 $90B7 NEG           ; Negate the leftward step.
 $90B9 DEC A         ; {Jump to #R$90D8 if the step is #N$01.
 $90BA JR Z,$90D8    ; }
 $90BC DEC A         ; {Jump to #R$90EA if the step is #N$02.
 $90BD JR Z,$90EA    ; }
 $90BF LD A,(IX+$02) ; Fetch the low byte of the world X.
 $90C2 AND %00000011 ; Keep only bits 0-1.
 $90C4 JR NZ,$90EA   ; Jump to #R$90EA if Jetman is not on a 4-pixel
                     ; boundary.
; Rotate each pixel row right by four bits.
@label=ApplyJetmanSpeed_Loop
*$90C6 XOR A         ; Clear the accumulator.
 $90C7 LD B,$20      ; Set a column counter in #REGb for #N$20 loops.
 $90C9 PUSH HL       ; Stash the row start on the stack.
@label=ApplyJetmanSpeed_RotateNibbleRight
*$90CA RRD           ; Rotate the nibble through the current byte.
 $90CC INC HL        ; Move onto the next column.
 $90CD DJNZ $90CA    ; Decrease the column counter by one and loop back
                     ; to #R$90CA until the row is done.
 $90CF POP HL        ; Restore the row start from the stack.
 $90D0 INC H         ; Move down one pixel row.
 $90D1 DEC C         ; {Decrease the row counter by one and loop back to
 $90D2 JR NZ,$90C6   ; #R$90C6 until all eight rows are done.}
; Return the step actually scrolled (-#N$04) in #REGde.
 $90D4 LD DE,$FFFC   ; #REGde=#N$FFFC.
 $90D7 RET           ; Return.
; Rotate each pixel row right by one bit.
@label=ApplyJetmanSpeed_RotateRowRight
*$90D8 XOR A         ; Clear the accumulator.
 $90D9 LD B,$20      ; Set a column counter in #REGb for #N$20 loops.
 $90DB PUSH HL       ; Stash the row start on the stack.
@label=ApplyJetmanSpeed_RotateByteRight
*$90DC RR (HL)       ; Rotate the current byte right.
 $90DE INC HL        ; Move onto the next column.
 $90DF DJNZ $90DC    ; Decrease the column counter by one and loop back
                     ; to #R$90DC until the row is done.
 $90E1 POP HL        ; Restore the row start from the stack.
 $90E2 INC H         ; Move down one pixel row.
 $90E3 DEC C         ; {Decrease the row counter by one and loop back to
 $90E4 JR NZ,$90D8   ; #R$90D8 until all eight rows are done.}
; Return the step actually scrolled (-#N$01) in #REGde.
 $90E6 LD DE,$FFFF   ; #REGde=#N$FFFF.
 $90E9 RET           ; Return.
; Use a one-bit rotate if Jetman is on an odd pixel, otherwise
; fall through to a two-bit rotate.
@label=ApplyJetmanSpeed_TestOddPixel
*$90EA LD A,(IX+$02) ; Fetch the low byte of the world X.
 $90ED AND %00000001 ; Keep only bit 0.
 $90EF JR NZ,$90D8   ; Jump to #R$90D8 if Jetman is on an odd pixel.
; Rotate each pixel row right by two bits.
@label=ApplyJetmanSpeed_RotateRowRight2
*$90F1 XOR A         ; {Clear both accumulators.
 $90F2 EX AF,AF'     ;
 $90F3 XOR A         ; }
 $90F4 PUSH HL       ; Stash the row start on the stack.
 $90F5 LD B,$20      ; Set a column counter in #REGb for #N$20 loops.
@label=ApplyJetmanSpeed_RotateByteRight2
*$90F7 RR (HL)       ; {Rotate the current byte right twice.
 $90F9 EX AF,AF'     ;
 $90FA RR (HL)       ;
 $90FC EX AF,AF'     ; }
 $90FD INC L         ; Move onto the next column.
 $90FE DJNZ $90F7    ; Decrease the column counter by one and loop back
                     ; to #R$90F7 until the row is done.
 $9100 POP HL        ; Restore the row start from the stack.
 $9101 INC H         ; Move down one pixel row.
 $9102 DEC C         ; {Decrease the row counter by one and loop back to
 $9103 JR NZ,$90F1   ; #R$90F1 until all eight rows are done.}
; Return the step actually scrolled (-#N$02) in #REGde.
 $9105 LD DE,$FFFE   ; #REGde=#N$FFFE.
 $9108 RET           ; Return.
; When Jetman is moving right, shift the terrain bitmap left.
@label=ApplyJetmanSpeed_ScrollRight
*$9109 LD HL,$50DF   ; #REGhl=#N$50DF.
 $910C DEC A         ; {Jump to #R$912B if the step is #N$01.
 $910D JR Z,$912B    ; }
 $910F DEC A         ; {Jump to #R$913D if the step is #N$02.
 $9110 JR Z,$913D    ; }
 $9112 LD A,(IX+$02) ; Fetch the low byte of the world X.
 $9115 AND %00000011 ; Keep only bits 0-1.
 $9117 JR NZ,$913D   ; Jump to #R$913D if Jetman is not on a 4-pixel
                     ; boundary.
; Rotate each pixel row left by four bits.
@label=ApplyJetmanSpeed_RotateRowLeft4
*$9119 XOR A         ; Clear the accumulator.
 $911A LD B,$20      ; Set a column counter in #REGb for #N$20 loops.
 $911C PUSH HL       ; Stash the row start on the stack.
@label=ApplyJetmanSpeed_RotateNibbleLeft
*$911D RLD           ; Rotate the nibble through the current byte.
 $911F DEC L         ; Move onto the previous column.
 $9120 DJNZ $911D    ; Decrease the column counter by one and loop back
                     ; to #R$911D until the row is done.
 $9122 POP HL        ; Restore the row start from the stack.
 $9123 INC H         ; Move down one pixel row.
 $9124 DEC C         ; {Decrease the row counter by one and loop back to
 $9125 JR NZ,$9119   ; #R$9119 until all eight rows are done.}
 $9127 LD DE,$0004   ; #REGde=#N($0004,$04,$04).
 $912A RET           ; Return.
; Rotate each pixel row left by one bit.
@label=ApplyJetmanSpeed_RotateRowLeft
*$912B XOR A         ; Clear the accumulator.
 $912C LD B,$20      ; Set a column counter in #REGb for #N$20 loops.
 $912E PUSH HL       ; Stash the row start on the stack.
@label=ApplyJetmanSpeed_RotateByteLeft
*$912F RL (HL)       ; Rotate the current byte left.
 $9131 DEC L         ; Move onto the previous column.
 $9132 DJNZ $912F    ; Decrease the column counter by one and loop back
                     ; to #R$912F until the row is done.
 $9134 POP HL        ; Restore the row start from the stack.
 $9135 INC H         ; Move down one pixel row.
 $9136 DEC C         ; {Decrease the row counter by one and loop back to
 $9137 JR NZ,$912B   ; #R$912B until all eight rows are done.}
 $9139 LD DE,$0001   ; #REGde=#N($0001,$04,$04).
 $913C RET           ; Return.
; Rotate by one bit if Jetman is on an odd pixel, else by two.
@label=ApplyJetmanSpeed_TestOddPixelRight
*$913D LD A,(IX+$02) ; Fetch the low byte of the world X.
 $9140 AND %00000001 ; Keep only bit 0.
 $9142 JR NZ,$912B   ; Jump to #R$912B if Jetman is on an odd pixel.
; Rotate each pixel row left by two bits.
@label=ApplyJetmanSpeed_RotateRowLeft2
*$9144 XOR A         ; {Clear both accumulators.
 $9145 EX AF,AF'     ;
 $9146 XOR A         ; }
 $9147 PUSH HL       ; Stash the row start on the stack.
 $9148 LD B,$20      ; Set a column counter in #REGb for #N$20 loops.
@label=ApplyJetmanSpeed_RotateByteLeft2
*$914A RL (HL)       ; {Rotate the current byte left twice.
 $914C EX AF,AF'     ;
 $914D RL (HL)       ;
 $914F EX AF,AF'     ; }
 $9150 DEC L         ; Move onto the previous column.
 $9151 DJNZ $914A    ; Decrease the column counter by one and loop back
                     ; to #R$914A until the row is done.
 $9153 POP HL        ; Restore the row start from the stack.
 $9154 INC H         ; Move down one pixel row.
 $9155 DEC C         ; {Decrease the row counter by one and loop back to
 $9156 JR NZ,$9144   ; #R$9144 until all eight rows are done.}
 $9158 LD DE,$0002   ; #REGde=#N($0002,$04,$04).
 $915B RET           ; Return.

; Draw New Column
;
; Used by the routine at #R$907B.
; .
; When Jetman crosses a cell boundary, point
; #REGhl at the new terrain cell and #REGde at the
; screen column that has scrolled into view.
;
;   HL World X
;   DE Pixel step
; O:HL Pointer to the cell after the drawn one
; O:DE Screen address one character row below the column
;
; Draw the new terrain column that has scrolled into
; view.
@label=DrawNewColumn
c$915C LD A,E        ; {Jump to #R$919E if Jetman is moving left.
 $915D AND A         ;
 $915E JP M,$919E    ; }
 $9161 LD DE,$0080   ; {Add #N$80 to the world X.
 $9164 ADD HL,DE     ; }
 $9165 LD A,H        ; Fetch the high byte.
 $9166 AND %00011111 ; Keep only bits 0-4.
 $9168 LD H,A        ; Write it back to #REGh.
 $9169 LD DE,$7000   ; #REGde=#R$7000.
 $916C SRA H         ; {Divide the world position by #N$08.
 $916E RR L          ;
 $9170 SRA H         ;
 $9172 RR L          ;
 $9174 SRA H         ;
 $9176 RR L          ; }
 $9178 ADD HL,DE     ; #REGhl+=#REGde.
 $9179 LD DE,$50DF   ; #REGde=#N$50DF.
; Continue on to #R$917C.

; Draw Terrain Column
;
; Used by the routines at #R$919E and #R$9356.
; .
; Copy eight bytes of terrain graphic from #R$F66E into
; the screen column in #REGde.
;
; HL Terrain cell pointer
; DE Screen address
;
; Copy eight bytes of terrain graphic into the screen column.
@label=DrawTerrainColumn
c$917C PUSH HL       ; {Stash the cell pointer and the screen address on
 $917D PUSH DE       ; the stack.}
; Work out the address of the graphic for the terrain cell.
 $917E LD L,(HL)     ; Fetch the terrain cell.
 $917F LD H,$00      ; #REGh=#N$00.
 $9181 ADD HL,HL     ; {Multiply the cell index by #N$08.
 $9182 ADD HL,HL     ;
 $9183 ADD HL,HL     ; }
 $9184 LD DE,$F66E   ; #REGde=#R$F66E.
 $9187 ADD HL,DE     ; Point #REGhl at that graphic.
 $9188 LD B,$08      ; Set a pixel row counter in #REGb for #N$08 loops.
 $918A POP DE        ; {Restore the screen address from the stack, but
 $918B PUSH DE       ; stash a copy of it on the stack again.}
@label=DrawTerrainColumn_Loop
*$918C LD A,(HL)     ; {Copy the graphic byte to the screen.
 $918D LD (DE),A     ; }
 $918E INC HL        ; Move onto the next graphic byte.
 $918F INC D         ; Move down one pixel row.
 $9190 DJNZ $918C    ; Decrease the row counter by one and loop back to
                     ; #R$918C until the column is drawn.
; Advance to the next screen row and the next terrain cell.
 $9192 POP DE        ; Restore the screen column from the stack.
 $9193 LD A,E        ; {Advance the screen pointer by one character row.
 $9194 ADD A,$20     ;
 $9196 LD E,A        ; }
 $9197 LD A,D        ; {Add the carry into the high byte.
 $9198 ADC A,$00     ;
 $919A LD D,A        ; }
 $919B POP HL        ; Restore the cell pointer from the stack.
 $919C INC HL        ; Move onto the next cell.
 $919D RET           ; Return.

; Locate Terrain Cell
;
; Used by the routine at #R$915C.
; .
; Map a world position onto #R$7000 and draw that column.
;
; HL World position
;
; Map the world position onto #R$7000 and draw that column.
@label=LocateTerrainCell
c$919E LD DE,$FF88   ; #REGde=#N$FF88.
 $91A1 ADD HL,DE     ; #REGhl+=#REGde.
 $91A2 LD A,H        ; #REGa=#REGh.
 $91A3 AND %00011111 ; Keep only bits 0-4.
 $91A5 LD H,A        ; #REGh=#REGa.
; Convert the position into a terrain cell pointer.
 $91A6 LD DE,$7000   ; #REGde=#R$7000.
 $91A9 SRA H         ; {Divide the world position by #N$08.
 $91AB RR L          ;
 $91AD SRA H         ;
 $91AF RR L          ;
 $91B1 SRA H         ;
 $91B3 RR L          ; }
 $91B5 ADD HL,DE     ; #REGhl+=#REGde.
; Aim at the leftmost screen column and draw it.
 $91B6 LD DE,$50C0   ; #REGde=#N$50C0.
 $91B9 JR $917C      ; Jump to #R$917C.

; Read Terrain Cell
;
; Used by the routines at #R$8CBC, #R$8D06, #R$93E8, #R$95B6, #R$970E and
; #R$A3C1.
; .
; Return the two terrain bytes under the current actor.
;
;   IX Actor slot
; O:D First terrain byte
; O:E Second terrain byte
; O:HL Terrain cell index
;
; Return the two terrain bytes under the current actor.
@label=ReadTerrainCell
c$91BB LD H,(IX+$03) ; Fetch the high byte of the world X.
 $91BE LD L,(IX+$02) ; Fetch the low byte of the world X.
 $91C1 LD A,H        ; Fetch the high byte.
 $91C2 AND %00011111 ; Keep only bits 0-4.
 $91C4 LD H,A        ; Write it back to #REGh.
 $91C5 SRA H         ; {Divide the world position by #N$08.
 $91C7 RR L          ;
 $91C9 SRA H         ;
 $91CB RR L          ;
 $91CD SRA H         ;
 $91CF RR L          ; }
; Read the first terrain byte from the cell.
 $91D1 PUSH HL       ; Stash the cell index on the stack.
 $91D2 LD BC,$7000   ; {Point #REGhl at that terrain cell, offset from #R$7000.
 $91D5 ADD HL,BC     ; }
 $91D6 LD D,(HL)     ; Fetch the first terrain byte.
 $91D7 POP HL        ; {Restore the cell index from the stack, but stash
 $91D8 PUSH HL       ; a copy of it on the stack again.}
; Step to the next cell, wrapping the index, and read
; the second terrain byte.
 $91D9 INC HL        ; Move onto the next cell.
 $91DA LD A,H        ; Fetch the high byte.
 $91DB AND %00000011 ; Keep only bits 0-1.
 $91DD LD H,A        ; Write it back to #REGh.
 $91DE ADD HL,BC     ; Point #REGhl at that terrain cell.
 $91DF LD E,(HL)     ; Fetch the second terrain byte.
 $91E0 POP HL        ; Restore the cell index from the stack.
 $91E1 RET           ; Return.

; Handler: Moon Rover
;
; Drive the rover: refill the fuel gauge, read the controls and
; stop the rover at craters in the terrain ahead.
;
; IX Actor slot
;
; Refill the tank, then steer from the controls.
@label=Handler_MoonRover
c$91E2 LD A,($5E6C)    ; {Jump to #R$9267 if #R$5E6C is set.
 $91E5 AND A           ;
 $91E6 JR NZ,$9267     ; }
 $91E8 LD HL,$9000     ; {Write #N$9000 to #R$608E.
 $91EB LD ($608E),HL   ; }
 $91EE LD A,H          ; Fetch the high fuel byte.
 $91EF LD HL,$1040     ; #REGhl=#N($1040,$04,$04) (gauge position).
 $91F2 CALL $8C01      ; Call #R$8C01.
; Read the controls and speed the rover up if LEFT
; or RIGHT is held.
 $91F5 CALL $8F90      ; Call #R$8F90.
 $91F8 BIT 0,A         ; {Jump to #R$92CB if RIGHT is pressed.
 $91FA JP Z,$92CB      ; }
 $91FD BIT 1,A         ; {Jump to #R$92BA if LEFT is pressed.
 $91FF JP Z,$92BA      ; }
; Neither direction is held, so ease the speed back
; towards zero.
 $9202 LD A,(IX+$05)   ; {Jump to #R$9211 if the horizontal speed is zero.
 $9205 AND A           ;
 $9206 JR Z,$9211      ; }
 $9208 JP P,$920F      ; Jump to #R$920F if the rover is moving right.
 $920B ADD A,$01       ; Add #N$01 to the speed.
 $920D JR $9211        ; Jump to #R$9211.
@label=Handler_MoonRover_Decelerate
*$920F SUB $01         ; Subtract #N$01 from the speed.
@label=Handler_MoonRover_Loop
*$9211 LD (IX+$05),A   ; Write the speed to *#REGix+#N$05.
; Look ahead under the wheels for blocking terrain.
 $9214 LD HL,($607A)   ; Fetch #R$607A.
 $9217 BIT 7,(IX+$05)  ; {Jump to #R$92B4 if the rover is moving left.
 $921B JP NZ,$92B4     ; }
 $921E LD DE,$FFF8     ; #REGde=#N$FFF8.
@label=Handler_MoonRover_LookAhead
*$9221 ADD HL,DE       ; Add the look-ahead offset.
 $9222 SRA H           ; {Divide the world position by #N$08.
 $9224 RR L            ;
 $9226 SRA H           ;
 $9228 RR L            ;
 $922A SRA H           ;
 $922C RR L            ; }
 $922E LD A,H          ; Fetch the high byte.
 $922F AND %00000011   ; Keep only bits 0-1.
 $9231 LD H,A          ; Write it back to #REGh.
; Scan the cells ahead of the rover and stop it at an
; empty cell or a crater.
 $9232 LD B,$06        ; Set a cell counter in #REGb for #N$06 loops.
 $9234 EX DE,HL        ; Switch the index into #REGde.
@label=Handler_MoonRover_TestTerrain
*$9235 LD HL,$7000     ; #REGhl=#R$7000.
 $9238 ADD HL,DE       ; Point #REGhl at that terrain cell.
 $9239 LD A,(HL)       ; {Jump to #R$924A if the cell is empty.
 $923A AND A           ;
 $923B JR Z,$924A      ; }
 $923D AND %00001000   ; Keep only bit 3.
 $923F JR NZ,$924A     ; Jump to #R$924A if it is a crater.
; Step on to the next cell, wrapping the index.
 $9241 INC DE          ; Move onto the next cell.
 $9242 LD A,D          ; Fetch the high byte.
 $9243 AND %00000011   ; Keep only bits 0-1.
 $9245 LD D,A          ; Write it back to #REGd.
 $9246 DJNZ $9235      ; Decrease the cell counter by one and loop back
                       ; to #R$9235 until the scan is done.
 $9248 JR $9250        ; Jump to #R$9250.
; Stop the rover: it has reached an empty cell or a crater.
@label=Handler_MoonRover_Stop
*$924A LD (IX+$05),$00 ; Write #N$00 to the horizontal speed.
 $924E JR $9264        ; Jump to #R$9264.
; Pick a facing frame from the fine X.
@label=Handler_MoonRover_PickFrame
*$9250 LD A,(IX+$05)   ; {Jump to #R$9264 if the horizontal speed is zero.
 $9253 AND A           ;
 $9254 JR Z,$9264      ; }
 $9256 JP M,$92A7      ; Jump to #R$92A7 if the rover is moving left.
 $9259 LD A,(IX+$02)   ; Fetch the low byte of the world X.
 $925C RRA             ; Rotate it right.
 $925D AND %00000011   ; Keep only bits 0-1.
; Sprite IDs begin at #R$BE90(#N$16) (#SPRITENAME$16).
 $925F ADD A,$16       ; Add #N$16 for the right-facing frames.
 $9261 LD (IX+$00),A   ; Write it to the actor type.
; Move the rover along the planet and draw its sprite.
@label=Handler_MoonRover_ApplySpeed
*$9264 CALL $907B      ; Call #R$907B.
@label=Handler_MoonRover_DrawSprite
*$9267 CALL $877C      ; Call #R$877C.
; While Jetman is inactive, step the inactive counter
; and hand over to #R$9F3F.
 $926A LD A,($5E6C)    ; {Jump to #R$9277 if #R$5E6C is zero.
 $926D AND A           ;
 $926E JR Z,$9277      ; }
 $9270 INC A           ; {Increment #R$5E6C by one.
 $9271 LD ($5E6C),A    ; }
 $9274 JP $9F3F        ; Jump to #R$9F3F.
; Colour the rover lights, body and banner.
@label=Handler_MoonRover_ColourLights
*$9277 CALL $B87E      ; Call #R$B87E.
 $927A LD DE,$BC9E     ; #REGde=#R$BC9E.
 $927D CALL $890A      ; Call #R$890A.
 $9280 CALL $AD22      ; Call #R$AD22.
; Leave the rover if SPACE has just been pressed.
 $9283 CALL $933E      ; Call #R$933E.
 $9286 CALL NZ,$92DC   ; Call #R$92DC if SPACE is pressed.
; Queue a jingle only when the tune buffer has
; finished and the random number allows it.
 $9289 LD A,($FF54)    ; {Return if #R$FF54 is not #R$FF51.
 $928C CP $51          ;
 $928E RET NZ          ; }
 $928F LD A,($5E40)    ; Fetch #R$5E40.
 $9292 AND %01111111   ; Keep only bits 0-6.
 $9294 RET NZ          ; Return if the result is not zero.
; Choose a tune from the table using the game timer
; and queue it.
 $9295 LD A,($5E42)    ; Fetch #R$5E42.
 $9298 AND %00001110   ; Keep only bits 1-3.
 $929A LD C,A          ; {Convert that index into #REGbc.
 $929B LD B,$00        ; }
 $929D LD HL,$9DB0     ; {Point #REGhl at the matching entry in #R$9DB0.
 $92A0 ADD HL,BC       ; }
 $92A1 LD E,(HL)       ; {Fetch the tune pointer.
 $92A2 INC HL          ;
 $92A3 LD D,(HL)       ; }
 $92A4 JP $B9BC        ; Jump to #R$B9BC.
; Pick a left-facing frame from the fine X.
@label=Handler_MoonRover_FineX
*$92A7 LD A,(IX+$02)   ; Fetch the low byte of the world X.
 $92AA RRA             ; Rotate it right.
 $92AB AND %00000011   ; Keep only bits 0-1.
; Sprite IDs begin at #R$C9BF(#N$12) (#SPRITENAME$12).
 $92AD ADD A,$12       ; Add #N$12 for the left-facing frames.
 $92AF LD (IX+$00),A   ; Write it to the actor type.
 $92B2 JR $9264        ; Jump to #R$9264.
; Look further ahead when the rover is moving left.
@label=Handler_MoonRover_LookLeft
*$92B4 LD DE,$FFF0     ; #REGde=#N$FFF0.
 $92B7 JP $9221        ; Jump to #R$9221.
; Accelerate left, but cap the speed at #N$E8.
@label=Handler_MoonRover_AccelerateLeft
*$92BA LD A,(IX+$05)   ; {Jump to #R$92C6 if the horizontal speed is
 $92BD AND A           ; positive.
 $92BE JP P,$92C6      ; }
 $92C1 CP $E8          ; {Jump to #R$9211 if the speed is already below
 $92C3 JP C,$9211      ; #N$E8.}
@label=Handler_MoonRover_SubtractSpeed
*$92C6 SUB $02         ; Subtract #N$02 from the speed.
 $92C8 JP $9211        ; Jump to #R$9211.
; Accelerate right, but cap the speed at #N$28.
@label=Handler_MoonRover_AccelerateRight
*$92CB LD A,(IX+$05)   ; {Jump to #R$92D7 if the horizontal speed is
 $92CE AND A           ; negative.
 $92CF JP M,$92D7      ; }
 $92D2 CP $28          ; {Jump to #R$9211 if the speed is already at least
 $92D4 JP NC,$9211     ; #N$28.}
@label=Handler_MoonRover_AddSpeed
*$92D7 ADD A,$02       ; Add #N$02 to the speed.
 $92D9 JP $9211        ; Jump to #R$9211.
; Leave the rover and restore Jetman on foot.
@label=Handler_MoonRover_Leave
*$92DC CALL $B8C3      ; Call #R$B8C3.
 $92DF LD HL,$607A     ; {Copy the #N$0E bytes of rover state from #R$607A back out of the
 $92E2 LD DE,$6092     ; Jetman slot to #R$6092.
 $92E5 LD BC,$000E     ;
 $92E8 LDIR            ; }
; Screen column #N$78 is standing beside the rover.
; Type #N$16 and above is facing right: walking
; frames #N$09 (left) and #N$0D (right), parked
; rover frames #N$1A and #N$22.
 $92EA LD (IX+$01),$78 ; Write #N$78 to *#REGix+#N$01.
 $92EE LD A,(IX+$00)   ; {Jump to #R$9304 if the actor type is at least
 $92F1 CP $16          ; #N$16.
 $92F3 JR NC,$9304     ; }
; When facing left, walk with type #N$09 and park the rover as type #N$1A.
 $92F5 LD (IX+$00),$09 ; Write #N$09 to the actor type.
 $92F9 LD A,$1A        ; #REGa=#N$1A.
; Write the parked rover's type and finish by clearing the banner colour.
@label=Handler_MoonRover_WriteType
*$92FB LD ($6090),A    ; Write #REGa to #R$6090.
 $92FE CALL $8634      ; Call #R$8634.
 $9301 JP $AD33        ; Jump to #R$AD33.
; When facing right, walk with type #N$0D and park the rover as type
; #N$22.
@label=Handler_MoonRover_StandingFrame
*$9304 LD (IX+$00),$0D ; Write #N$0D to the actor type.
 $9308 LD A,$22        ; #REGa=#N$22.
 $930A JR $92FB        ; Jump to #R$92FB.

; Board Moon Rover
;
; Used by the routine at #R$8D06.
; .
; Copy the rover state over Jetman, snap him to the seat and
; play #R$B8BD.
;
; IX Actor slot
;
; Copy the rover state over Jetman and snap him to the seat.
@label=BoardMoonRover
c$930C LD HL,$6097     ; {Copy the #N$09 bytes of rover state from #R$6097 over Jetman at
 $930F LD DE,$607F     ; #R$607F.
 $9312 LD BC,$0009     ;
 $9315 LDIR            ; }
; Screen column #N$68 is the rover seat. Y=#N$AF
; is the ground line.
 $9317 LD (IX+$01),$68 ; Write #N$68 to *#REGix+#N$01.
 $931B LD (IX+$04),$AF ; Write #N$AF to Jetman's Y position.
; Bit 2 of the 0-based sprite index is facing.
; Type #N$12 is seated left, #N$16 is seated right.
 $931F LD A,(IX+$00)   ; Fetch the actor type.
 $9322 DEC A           ; Decrease it to a 0-based sprite index.
 $9323 AND %00000100   ; Keep only the facing bit.
 $9325 JR NZ,$9338     ; Jump to #R$9338 if Jetman is facing right.
; "#SPRITENAME$12".
 $9327 LD (IX+$00),$12 ; Write #N$12 to the actor type.
; Clear the parked rover, stop Jetman and play the take-object sound.
@label=BoardMoonRover_Loop
*$932B XOR A           ; {Write #N$00 to #R$6090.
 $932C LD ($6090),A    ; }
 $932F LD (IX+$05),A   ; {Write #N$00 to the speed and the thrust.
 $9332 LD (IX+$06),A   ; }
 $9335 JP $B8BD        ; Jump to #R$B8BD.
; When Jetman faces right, seat him as type #N$16 and finish as above.
@label=BoardMoonRover_WriteType
*$9338 LD (IX+$00),$16 ; Write #N$16 to the actor type.
 $933C JR $932B        ; Jump to #R$932B.

; Test Space Key
;
; Used by the routines at #R$8D06, #R$91E2 and #R$A1AA.
; .
; Return non-zero only on the call when SPACE (or SHIFT) goes
; down. #R$5E5D latches the key as held until it is released.
;
; O:A Zero unless SPACE has just been pressed
;
; Return non-zero when SPACE is first pressed.
@label=TestSpaceKey
c$933E LD A,$7E      ; {Read from the keyboard;
 $9340 OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $9342 IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { =r2 #N$7E | SPACE | FULL-STOP | M | N | B }
                     ; { Shift | Z | X | C | V }
                     ; TABLE#}
; Test SPACE and clear the latch if it is up.
 $9344 CPL           ; Flip the bits.
 $9345 AND %00000001 ; Keep only bit 0.
 $9347 JR Z,$9350    ; If the result is zero jump to #R$9350.
; Report a new press only if the latch was not already set.
 $9349 LD A,($5E5D)  ; #REGa=*#R$5E5D.
 $934C AND A         ; {If #REGa is not zero then jump to #R$9354.
 $934D JR NZ,$9354   ; }
 $934F INC A         ; Increment #REGa by one.
@label=TestSpaceKey_StoreLatch
*$9350 LD ($5E5D),A  ; Write #REGa to #R$5E5D.
 $9353 RET           ; Return.
@label=TestSpaceKey_Clear
*$9354 XOR A         ; #REGa=#N$00.
 $9355 RET           ; Return.

; Draw Terrain
;
; Used by the routines at #R$A299 and #R$A826.
; .
; Redraw the whole strip of moon surface along the bottom of the
; screen for the current scroll position, then colour the row of ground
; beneath it.
; .
; Jetman always stands at pixel column #N$78, so the left-hand edge of the
; screen is #N$78 pixels behind his world X in #R$607A. That is divided by
; #N$08 to find the terrain cell at the left edge, as the world is
; #N$2000 pixels wide and #R$7000 holds one cell for every #N$08 of them
; (#N$400 cells), wrapping round at the far end. The #N$20 cells from there
; are drawn side by side along character row #N$16.
;
; .
;
; Work out which terrain cell sits at the left-hand edge of the screen.
@label=DrawTerrain
c$9356 LD HL,($607A) ; Fetch Jetman's world X from #R$607A.
@label=DrawTerrain_Target
 $9359 LD DE,$FF88   ; #REGde=#N$FF88 (minus #N$78).
 $935C ADD HL,DE     ; Subtract #N$78 to find the world X of the left-hand edge of the
                     ; screen.
; The world is #N$2000 pixels wide, so wrap anything left of its start
; back round to the far end.
 $935D LD A,H        ; #REGa=#REGh.
 $935E AND %00011111 ; Keep only bits 0-4 so the position wraps round the
                     ; world.
 $9360 LD H,A        ; #REGh=#REGa.
 $9361 SRA H         ; {Divide the world X by #N$08 to give the terrain cell
 $9363 RR L          ; index.
 $9365 SRA H         ;
 $9367 RR L          ;
 $9369 SRA H         ;
 $936B RR L          ; }
; Start at the left-hand end of the terrain row on the screen.
 $936D LD DE,$50C0   ; Set the screen address to #N$50C0 (the start of character row
                     ; #N$16).
 $9370 LD BC,$7000   ; Set the terrain base in #REGbc to #R$7000.
 $9373 LD A,$20      ; Set a column counter in #REGa for #N$20 loops.
; Draw the graphic for one terrain cell.
@label=DrawTerrain_Loop
*$9375 PUSH AF       ; {Stash the counter and the cell index on the stack.
 $9376 PUSH HL       ; }
 $9377 ADD HL,BC     ; Add the terrain base to get the address of the cell.
 $9378 PUSH BC       ; {Stash the terrain base and the screen address on the
 $9379 PUSH DE       ; stack.}
 $937A CALL $917C    ; Call #R$917C to copy the cell graphic onto the screen.
 $937D POP DE        ; Restore the screen address from the stack.
 $937E INC E         ; Move along to the next screen column.
 $937F POP BC        ; {Restore the terrain base and the cell index from the
 $9380 POP HL        ; stack.}
; Step on to the next terrain cell, wrapping round at the end of the
; world, and loop until every column is drawn.
 $9381 INC HL        ; Move onto the next cell index.
 $9382 LD A,H        ; #REGa=#REGh.
 $9383 AND %00000011 ; Keep only bits 0-1 so the index wraps round after #N$400
                     ; cells.
 $9385 LD H,A        ; #REGh=#REGa.
 $9386 POP AF        ; Restore the counter from the stack.
 $9387 DEC A         ; Decrease the column counter by one.
 $9388 JR NZ,$9375   ; Jump back to #R$9375 until all #N$20 columns are drawn.
; Colour the ground beneath the terrain; the black border columns at
; either edge of the window are left alone.
 $938A LD HL,$5AE1   ; Set the attribute pointer to #N$5AE1 (the second column of the
                     ; bottom row).
 $938D LD BC,$1E5B   ; Set a column counter in #REGb for #N$1E loops and the ground
                     ; colour in #REGc to #COLOUR$5B.
@label=DrawTerrain_WriteByte
*$9390 LD (HL),C     ; Write the ground colour to the attribute buffer.
 $9391 INC HL        ; Move onto the next column.
 $9392 DJNZ $9390    ; Decrease the column counter by one and loop back to #R$9390
                     ; until the ground is coloured.
 $9394 RET           ; Return.

; Find Unused Alien Slot
;
; Used by the routines at #R$9466 and #R$9AE2.
; .
; Scan the six alien slots at #R$61B0 and return the
; first unused one.
;
; O:F Z: slot available
; O:F NZ: no available slots
; O:HL The alien slot address
;
; Scan the six alien slots and return the first free one.
@label=FindSlotAlien
c$9395 LD HL,$61B0   ; #REGhl=#R$61B0.
; There are a maximum of 6 aliens on screen at a time.
 $9398 LD B,$06      ; Set an alien slot counter in #REGb for #N$06 loops.
 $939A LD DE,$0018   ; #REGde=#N($0018,$04,$04) (the length of each slot).
@label=FindSlotAlien_Loop
*$939D LD A,(HL)     ; {Jump to #R$93A5 if this slot is unused.
 $939E AND A         ;
 $939F JR Z,$93A5    ; }
 $93A1 ADD HL,DE     ; Move onto the next slot.
 $93A2 DJNZ $939D    ; Decrease the alien counter by one and loop back
                     ; to #R$939D until every slot has been checked.
 $93A4 AND A         ; Leave the Z flag unset as no free slot was found.
@label=FindSlotAlien_Return
*$93A5 RET           ; Return.

; Place Actor At Scroll
;
; Copy #R$607A into the actor's world position and draw it.
; On action, turn it into type #N$2F, handled by #R$93E8, and play
; #R$B8C3.
;
; IX Actor slot
;
; Place the actor at Jetman's scroll position.
@label=PlaceActorAtScroll
c$93A6 LD HL,($607A)   ; Fetch #R$607A.
 $93A9 LD (IX+$03),H   ; Write the high byte to the actor's world X.
 $93AC LD (IX+$02),L   ; Write the low byte to the actor's world X.
 $93AF LD A,($607C)    ; Fetch #R$607C.
 $93B2 ADD A,$08       ; Add #N$08 to the Y position.
 $93B4 CP $AF          ; {Jump to #R$93BA if it is still above the ground
 $93B6 JR C,$93BA      ; line.}
; #N$AF is the ground line.
 $93B8 LD A,$AF        ; #REGa=#N$AF.
; Redraw the actor and test the action key.
@label=PlaceActorAtScroll_Draw
*$93BA LD (IX+$04),A   ; Write the Y position to *#REGix+#N$04.
 $93BD CALL $8701      ; Call #R$8701.
 $93C0 CALL $8733      ; Call #R$8733.
 $93C3 CALL $945C      ; Call #R$945C.
 $93C6 JR Z,$93E3      ; Jump to #R$93E3 if the action key is not pressed.
 $93C8 BIT 0,(IX+$08)  ; {Return if bit 0 of the actor flags is already set.
 $93CC RET NZ          ; }
; Turn the actor into type #N$2F and give it Jetman's speed.
 $93CD LD (IX+$00),$2F ; Write type #N$2F to the actor.
 $93D1 LD HL,$6080     ; #REGhl=#R$6080.
 $93D4 RES 0,(HL)      ; Reset bit 0 of Jetman's flags.
 $93D6 LD A,($607D)    ; Fetch #R$607D.
 $93D9 LD (IX+$05),A   ; Copy that speed to the actor.
; #N$10 is a signed +#N$10 downward throw.
 $93DC LD (IX+$06),$10 ; Write #N$10 to the vertical thrust.
 $93E0 JP $B8C3        ; Jump to #R$B8C3.
@label=PlaceActorAtScroll_ClearAttached
*$93E3 RES 0,(IX+$08)  ; Reset bit 0 of the actor flags.
 $93E7 RET             ; Return.

; Handler: Falling Platform
;
; Drop a thrown platform (type #N$2F): speed it up under gravity and
; move it along. When it reaches the ground line, stamp it into the
; terrain and free the slot.
;
; IX Actor slot
;
; Increase the downward thrust by two, up to a cap of #N$30.
@label=Handler_FallingPlatform
c$93E8 LD A,(IX+$06)   ; Fetch the vertical thrust.
 $93EB CP $30          ; {Jump to #R$93F5 if it is already at least #N$30.
 $93ED JR NC,$93F5     ; }
 $93EF INC (IX+$06)    ; {Increase the thrust by two.
 $93F2 INC (IX+$06)    ; }
; Turn the thrust into a Y movement and test for the ground.
@label=Handler_FallingPlatform_ApplyGravity
*$93F5 SRA A           ; {Divide the thrust by #N$10.
 $93F7 SRA A           ;
 $93F9 SRA A           ;
 $93FB SRA A           ; }
 $93FD ADD A,(IX+$04)  ; Add it to the actor's Y position.
 $9400 LD (IX+$04),A   ; Write the Y position back.
 $9403 CP $B0          ; {Jump to #R$9435 if the actor is still above the
 $9405 JR C,$9435      ; ground line.}
; When the actor has hit the ground, stamp tile #N$03 into two terrain
; cells.
 $9407 CALL $91BB      ; Call #R$91BB.
; Snap the actor to the ground line.
 $940A LD A,$B7        ; {Write #N$B7 to the actor's Y position.
 $940C LD (IX+$04),A   ; }
 $940F LD DE,$7000     ; #REGde=#R$7000.
 $9412 EX DE,HL        ; {Point #REGhl at the terrain cell.
 $9413 ADD HL,DE       ; }
 $9414 LD (HL),$03     ; Write tile #N$03 into that cell.
; Step to the next cell, wrapping the index, and stamp it too.
 $9416 INC DE          ; Move onto the next cell.
 $9417 LD A,D          ; Fetch the high byte.
 $9418 AND %00000011   ; Keep only bits 0-1.
 $941A LD D,A          ; Write it back to #REGd.
 $941B LD HL,$7000     ; {Point #REGhl at that terrain cell.
 $941E ADD HL,DE       ; }
 $941F LD (HL),$03     ; Write tile #N$03 into that cell.
; Align the actor to a character column, clear the terrain
; pixels beneath it and free the slot.
 $9421 LD A,(IX+$02)   ; Fetch the low byte of the world X.
 $9424 AND %11111000   ; Keep only bits 3-7.
 $9426 LD L,A          ; {Align the world X to a character column.
 $9427 LD (IX+$02),L   ; }
 $942A CALL $98AE      ; Call #R$98AE.
 $942D CALL $8701      ; Call #R$8701.
 $9430 LD (IX+$00),$00 ; Write #N$00 to the actor type.
 $9434 RET             ; Return.
; Add the horizontal speed and redraw the actor.
@label=Handler_FallingPlatform_AddSpeed
*$9435 LD A,(IX+$05)   ; Fetch the horizontal speed.
 $9438 SRA A           ; {Divide it by #N$10.
 $943A SRA A           ;
 $943C SRA A           ;
 $943E SRA A           ; }
 $9440 LD C,A          ; {Copy the step into #REGc and clear #REGb.
 $9441 LD B,$00        ; }
 $9443 JP P,$9448      ; Jump to #R$9448 if the step is positive.
 $9446 LD B,$FF        ; Set #REGb=#N$FF for a negative step.
; Add the step to the world X and redraw the actor.
@label=Handler_FallingPlatform_WriteWorldX
*$9448 LD L,(IX+$02)   ; Fetch the low byte of the world X.
 $944B LD H,(IX+$03)   ; Fetch the high byte of the world X.
 $944E ADD HL,BC       ; Add the step to the world X.
 $944F LD (IX+$03),H   ; Write the high byte back.
 $9452 LD (IX+$02),L   ; Write the low byte back.
 $9455 CALL $8701      ; Call #R$8701.
 $9458 CALL $8733      ; Call #R$8733.
 $945B RET             ; Return.

; Test Action Key
;
; Used by the routines at #R$8D06, #R$93A6, #R$A0F8, #R$A1AA, #R$A325, #R$A3C1,
; #R$A3FF, #R$A4E7, #R$B6EC, #R$B785 and #R$B7BC.
; .
; Return non-zero when FULL-STOP or Z (action) is held.
;
; O:A Zero if the action key is not pressed
@label=TestActionKey
c$945C LD A,$7E      ; {Read from the keyboard;
 $945E OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $9460 IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { =r2 #N$7E | SPACE | FULL-STOP | M | N | B }
                     ; { Shift | Z | X | C | V }
                     ; TABLE#}
 $9462 CPL           ; Flip the bits.
 $9463 AND %00000010 ; Keep only bit 1.
 $9465 RET           ; Return.

; Spawn Alien
;
; Used by the routine at #R$8259.
; .
; Roll a 1-in-4 chance, then copy a level-appropriate alien
; into a free slot.
@label=SpawnAlien
c$9466 LD A,R        ; #REGa=random number.
 $9468 AND %00000011 ; Keep only bits 0-1.
 $946A RET NZ        ; Return if the value is not zero.
 $946B LD A,($5E67)  ; {Fetch #R$5E67.
 $946E AND A         ; }
; See #POKE(no_enemies,No Enemies).
@label=SpawnAlien_TestDelay
 $946F RET NZ        ; Return if the delay is still running.
 $9470 CALL $9395    ; Call #R$9395.
 $9473 RET NZ        ; Return if there were no available alien slots.
 $9474 PUSH HL       ; Stash the free alien slot on the stack.
 $9475 EX DE,HL      ; Switch the #REGde and #REGhl registers.
 $9476 LD A,($5E40)  ; Fetch #R$5E40.
 $9479 RLA           ; Rotate it left once.
 $947A AND %00001110 ; Keep only bits 1-3.
 $947C LD C,A        ; {Create an even offset in #REGbc.
 $947D LD B,$00      ; }
; Pick the alien table for this level (cap at level #N$0C).
 $947F LD A,($5EA0)  ; Fetch #R$5EA0.
 $9482 CP $0C        ; {Jump to #R$9488 if the current level is less than
 $9484 JR C,$9488    ; #N$0C.}
 $9486 LD A,$0C      ; #REGa=#N$0C.
@label=SpawnAlien_PickOffset
*$9488 AND %00001110 ; Keep only bits 1-3.
 $948A LD L,A        ; {Create an offset in #REGhl - number can be:
 $948B LD H,$00      ; #LIST
                     ; { #N($0000,$04,$04) }
                     ; { #N($0002,$04,$04) }
                     ; { #N($0004,$04,$04) }
                     ; { #N($0006,$04,$04) }
                     ; { #N($0008,$04,$04) }
                     ; { #N($000A,$04,$04) }
                     ; { #N($000C,$04,$04) }
                     ; LIST#}
; Look up the template for the alien to spawn.
 $948D LD DE,$9D72   ; {Point #REGhl into #R$9D72.
 $9490 ADD HL,DE     ; }
 $9491 LD A,(HL)     ; {Fetch the alien table for this level.
 $9492 INC HL        ;
 $9493 LD H,(HL)     ;
 $9494 LD L,A        ; }
 $9495 ADD HL,BC     ; Add the random offset.
 $9496 LD A,(HL)     ; {Fetch that alien's template.
 $9497 INC HL        ;
 $9498 LD H,(HL)     ;
 $9499 LD L,A        ; }
 $949A LD BC,$0018   ; Set the byte count in #REGbc to #N$18 for one actor
                     ; slot.
 $949D POP DE        ; {Restore the free slot from the stack, but stash a
 $949E PUSH DE       ; copy of it on the stack again.}
 $949F LDIR          ; Copy the alien data into the free slot.
 $94A1 POP HL        ; #REGhl=the free alien slot.
; Place the alien relative to #R$607A, with special
; paths for types #N$88 and #N$B8.
 $94A2 LD A,(HL)     ; Fetch the alien type.
 $94A3 INC HL        ; {Move #REGhl onto the world X.
 $94A4 INC HL        ; }
 $94A5 PUSH HL       ; Stash it on the stack.
 $94A6 LD HL,($607A) ; Fetch #R$607A.
 $94A9 CP $88        ; {Jump to #R$94DB if the type is #N$88.
 $94AB JR Z,$94DB    ; }
 $94AD CP $B8        ; {Jump to #R$9506 if the type is #N$B8.
 $94AF JP Z,$9506    ; }
; Place any other alien a random distance either side of the
; scroll position.
 $94B2 LD A,($5E40)  ; Fetch #R$5E40.
 $94B5 LD C,A        ; {Store it as an 8-bit offset in #REGbc.
 $94B6 LD B,$00      ; }
; Place the alien left of the scroll position if bit 1 of the random
; number is set, else right.
 $94B8 LD DE,$0080   ; #REGde=#N($0080,$04,$04).
 $94BB AND %00000010 ; Keep only bit 1.
 $94BD JR Z,$94C5    ; Jump to #R$94C5 if that bit is reset.
 $94BF SBC HL,BC     ; {Subtract the offset from the scroll position.
 $94C1 SBC HL,DE     ; }
 $94C3 JR $94C7      ; Jump to #R$94C7.
@label=SpawnAlien_AddScroll
*$94C5 ADD HL,BC     ; {Add the offset to the scroll position.
 $94C6 ADD HL,DE     ; }
; Wrap the position into the world.
@label=SpawnAlien_MaskWorldX
*$94C7 LD A,H        ; Fetch the high byte.
 $94C8 AND %00011111 ; Keep only bits 0-4.
 $94CA LD H,A        ; Write it back to #REGh.
 $94CB EX DE,HL      ; Copy that position into #REGde.
; Store the world X and randomly reverse the horizontal speed.
 $94CC POP HL        ; Restore the slot pointer from the stack.
 $94CD LD (HL),E     ; {Write the world X into the slot.
 $94CE INC HL        ;
 $94CF LD (HL),D     ; }
 $94D0 INC HL        ; {Move onto the horizontal speed.
 $94D1 INC HL        ; }
 $94D2 LD A,C        ; Fetch the random byte.
 $94D3 AND %10000000 ; Keep only bit 7.
 $94D5 RET Z         ; Return if that bit is reset.
 $94D6 LD A,(HL)     ; {Negate the horizontal speed.
 $94D7 NEG           ;
 $94D9 LD (HL),A     ; }
 $94DA RET           ; Return.
; Type #N$88: spawn off the left or right edge.
@label=SpawnAlien_Type88
*$94DB LD A,($5E40)  ; Fetch #R$5E40.
 $94DE LD B,A        ; Stash it in #REGb.
 $94DF AND %10000000 ; Keep only bit 7.
 $94E1 SUB $40       ; Subtract #N$40 to make the speed.
 $94E3 LD C,A        ; Copy the speed into #REGc.
; Pick the edge: a positive speed spawns off the left, otherwise off the
; right.
 $94E4 JP P,$94EC    ; Jump to #R$94EC if the result is positive.
 $94E7 LD DE,$0090   ; #REGde=#N($0090,$04,$04).
 $94EA JR $94EF      ; Jump to #R$94EF.
@label=SpawnAlien_LeftEdge
*$94EC LD DE,$FF70   ; #REGde=#N$FF70.
; Apply the edge offset to the scroll position and wrap it.
@label=SpawnAlien_ApplyEdge
*$94EF ADD HL,DE     ; Add the edge offset to the scroll position.
 $94F0 LD A,H        ; Fetch the high byte.
 $94F1 AND %00011111 ; Keep only bits 0-4.
 $94F3 LD H,A        ; Write it back to #REGh.
 $94F4 EX DE,HL      ; Copy that position into #REGde.
; Store the world X, then set a random Y position and the
; speed.
 $94F5 POP HL        ; Restore the slot pointer from the stack.
 $94F6 LD (HL),E     ; {Write the world X into the slot.
 $94F7 INC HL        ;
 $94F8 LD (HL),D     ; }
 $94F9 INC HL        ; Move onto the Y position.
; Choose a random Y position.
 $94FA LD A,B        ; Fetch the random byte.
 $94FB AND %01111000 ; Keep only bits 3-6.
 $94FD JR NZ,$9500   ; {Jump to #R$9500 if those bits are not zero,
 $94FF INC A         ; else force #N$01.}
@label=SpawnAlien_WriteY
*$9500 ADD A,$37     ; Add #N$37 to make a Y position.
 $9502 LD (HL),A     ; Write the Y position.
 $9503 INC HL        ; Move onto the speed.
 $9504 LD (HL),C     ; Write the speed.
 $9505 RET           ; Return.
; Type #N$B8: the same edge spawn as type #N$88.
@label=SpawnAlien_TypeB8
*$9506 LD A,($5E40)  ; Fetch #R$5E40.
 $9509 LD B,A        ; Stash it in #REGb.
 $950A AND %10000000 ; Keep only bit 7.
 $950C SUB $40       ; Subtract #N$40 to make the speed.
 $950E LD C,A        ; Copy the speed into #REGc.
; Pick the edge: a positive speed spawns off the left, otherwise off the
; right.
 $950F JP P,$9517    ; Jump to #R$9517 if the result is positive.
 $9512 LD DE,$0090   ; #REGde=#N($0090,$04,$04).
 $9515 JR $951A      ; Jump to #R$951A.
@label=SpawnAlien_TypeB8_LeftEdge
*$9517 LD DE,$FF70   ; #REGde=#N$FF70.
; Apply the edge offset to the scroll position and wrap it.
@label=SpawnAlien_TypeB8_ApplyEdge
*$951A ADD HL,DE     ; Add the edge offset to the scroll position.
 $951B LD A,H        ; Fetch the high byte.
 $951C AND %00011111 ; Keep only bits 0-4.
 $951E LD H,A        ; Write it back to #REGh.
 $951F EX DE,HL      ; Copy that position into #REGde.
; Store the world X, then set a random Y position and the
; speed.
 $9520 POP HL        ; Restore the slot pointer from the stack.
 $9521 LD (HL),E     ; {Write the world X into the slot.
 $9522 INC HL        ;
 $9523 LD (HL),D     ; }
 $9524 INC HL        ; Move onto the Y position.
; Choose a random Y position.
 $9525 LD A,B        ; Fetch the random byte.
 $9526 AND %01111000 ; Keep only bits 3-6.
 $9528 JR NZ,$952B   ; {Jump to #R$952B if those bits are not zero,
 $952A INC A         ; else force #N$01.}
@label=SpawnAlien_TypeB8_WriteY
*$952B ADD A,$37     ; Add #N$37 to make a Y position.
 $952D LD (HL),A     ; Write the Y position.
 $952E INC HL        ; Move onto the speed.
 $952F LD (HL),C     ; Write the speed.
 $9530 RET           ; Return.

; Handler: Meteor
;
; Count the meteor and drop it two pixels, exploding it at the
; ground line. Award points if its explode flag is set.
;
; IX Actor slot
@label=PlaceSpawnedAlien
c$9531 LD HL,$5E5E     ; #REGhl=#R$5E5E.
 $9534 INC (HL)        ; Increase #R$5E5E by one.
 $9535 LD A,(IX+$04)   ; Fetch the actor's Y position.
 $9538 ADD A,$02       ; Add #N$02 to it.
 $953A CP $B0          ; {Jump to #R$95B3 if it has reached the ground line.
 $953C JR NC,$95B3     ; }
 $953E LD (IX+$04),A   ; Write the Y position back.
; Set the actor type to one of the animation frames.
 $9541 LD A,($5E42)    ; Fetch #R$5E42.
 $9544 AND %00000111   ; Keep only bits 0-2.
; Sprite IDs begin at #R$D697(#N$50) (#SPRITENAME$50).
 $9546 ADD A,$50       ; Add #N$50 for the animation frames.
 $9548 LD (IX+$00),A   ; Write it to the actor type.
; This entry point is used by the routines at #R$9654, #R$970E, #R$9906,
; #R$993C, #R$9994, #R$9A2F and #R$9AE2.
; .
; Age the alien, then apply its horizontal speed.
@label=PlaceSpawnedAlien_Age
*$954B LD A,(IX+$0A)   ; {Jump to #R$955F if *#REGix+#N$0A is not zero.
 $954E AND A           ;
 $954F JR NZ,$955F     ; }
 $9551 BIT 0,(IX+$08)  ; {Jump to #R$955F if bit 0 of the actor flags is set.
 $9555 JR NZ,$955F     ; }
 $9557 INC (IX+$17)    ; {Jump to #R$9563 if the age byte has not wrapped.
 $955A JR NZ,$9563     ; }
 $955C JP $9937        ; Jump to #R$9937.
@label=PlaceSpawnedAlien_ClearAge
*$955F LD (IX+$17),$00 ; Write #N$00 to the age byte.
; Move the alien horizontally by its speed and redraw it.
@label=PlaceSpawnedAlien_ApplySpeed
*$9563 LD H,(IX+$03)   ; Fetch the high byte of the world X.
 $9566 LD L,(IX+$02)   ; Fetch the low byte of the world X.
; Turn the horizontal speed into a signed pixel step.
 $9569 LD A,(IX+$05)   ; Fetch the horizontal speed.
 $956C LD D,$00        ; Clear #REGd for a positive step.
 $956E SRA A           ; {Divide it by #N$10.
 $9570 SRA A           ;
 $9572 SRA A           ;
 $9574 SRA A           ; }
 $9576 JP P,$957B      ; Jump to #R$957B if the step is positive.
 $9579 LD D,$FF        ; Set #REGd=#N$FF for a negative step.
; Add the step to the world X and wrap it.
@label=PlaceSpawnedAlien_AddStep
*$957B LD E,A          ; Store the pixel step in #REGe.
 $957C ADD HL,DE       ; Add the step to the world X.
 $957D LD A,H          ; Fetch the high byte.
 $957E AND %00011111   ; Keep only bits 0-4.
 $9580 LD (IX+$03),A   ; Write the high byte back.
 $9583 LD (IX+$02),L   ; Write the low byte back.
; Redraw the alien and its colours.
 $9586 CALL $8701      ; Call #R$8701.
 $9589 CALL $8733      ; Call #R$8733.
; Award a score if the explode flag is set.
 $958C BIT 0,(IX+$10)  ; {Jump to #R$95A9 if bit 0 of *#REGix+#N$10 is
 $9590 JR Z,$95A9      ; reset.}
; Work out the points for this alien from its type.
 $9592 LD A,(IX+$00)   ; Fetch the actor type.
 $9595 RRA             ; {Rotate it right three times.
 $9596 RRA             ;
 $9597 RRA             ; }
 $9598 AND %00011111   ; Keep only bits 0-4.
 $959A ADD A,$01       ; Add #N$01.
 $959C DAA             ; Convert that value to decimal.
 $959D LD L,A          ; {Store it in #REGhl.
 $959E LD H,$00        ; }
 $95A0 ADD HL,HL       ; {Multiply it by #N$10.
 $95A1 ADD HL,HL       ;
 $95A2 ADD HL,HL       ;
 $95A3 ADD HL,HL       ; }
 $95A4 LD B,H          ; {Copy the points into #REGbc.
 $95A5 LD C,L          ; }
 $95A6 CALL $899C      ; Call #R$899C.
@label=PlaceSpawnedAlien_TestHit
*$95A9 CALL $A766      ; Call #R$A766.
; Kill Jetman and explode the alien if they are touching.
 $95AC CALL $B2A2      ; {Return if #R$B2A2 does not set carry.
 $95AF RET NC          ; }
 $95B0 CALL $B2D7      ; Call #R$B2D7.
@label=PlaceSpawnedAlien_Explode
*$95B3 JP $A76B        ; Jump to #R$A76B.

; Stamp Terrain Tile
;
; Used by the routine at #R$B1A4.
; .
; Write crater tiles into #R$7000 under the current actor and
; redraw them on the screen.
;
; IX Actor slot
@label=StampTerrainTile
c$95B6 CALL $91BB    ; Call #R$91BB.
 $95B9 PUSH HL       ; Stash the cell index on the stack.
 $95BA LD DE,$7000   ; #REGde=#R$7000.
 $95BD EX DE,HL      ; Switch the #REGde and #REGhl registers.
 $95BE ADD HL,DE     ; Point #REGhl at that terrain cell.
 $95BF BIT 3,(HL)    ; {Jump to #R$95C7 if bit 3 of the tile is reset.
 $95C1 JR Z,$95C7    ; }
 $95C3 LD (HL),$0A   ; Write #N$0A to the cell. #UDG($F66E+$0A*$08,attr=$43)
 $95C5 JR $95C9      ; Jump to #R$95C9.
@label=StampTerrainTile_WriteFirstCell
*$95C7 LD (HL),$08   ; Write #N$08 to the cell. #UDG($F66E+$08*$08,attr=$43)
; Stamp the neighbouring cell.
@label=StampTerrainTile_Neighbour
*$95C9 INC DE        ; Move onto the next cell.
 $95CA LD A,D        ; Fetch the high byte.
 $95CB AND %00000011 ; Keep only bits 0-1.
 $95CD LD D,A        ; Write it back to #REGd.
 $95CE LD HL,$7000   ; #REGhl=#R$7000.
 $95D1 ADD HL,DE     ; Point #REGhl at that terrain cell.
; Pick the tile for the neighbouring cell: #N$0A if bit 3 is set, else
; #N$09.
 $95D2 BIT 3,(HL)    ; {Jump to #R$95DA if bit 3 of the tile is reset.
 $95D4 JR Z,$95DA    ; }
 $95D6 LD (HL),$0A   ; Write #N$0A to the cell. #UDG($F66E+$0A*$08,attr=$43)
 $95D8 JR $95DC      ; Jump to #R$95DC.
@label=StampTerrainTile_WriteSecondCell
*$95DA LD (HL),$09   ; Write #N$09 to the cell. #UDG($F66E+$09*$08,attr=$43)
; Redraw the stamped columns onto the play area.
@label=StampTerrainTile_Redraw
*$95DC CALL $98AE    ; {Jump to #R$9652 if #R$98AE returns non-zero.
 $95DF JP NZ,$9652   ; }
 $95E2 LD A,H        ; {Subtract #N$08 from the high byte.
 $95E3 SUB $08       ; }
 $95E5 LD H,A        ; Write it back to #REGh.
; Wrap the cell index and point #REGde at its terrain cell.
 $95E6 EX (SP),HL    ; Exchange the cell index with the stacked pointer.
 $95E7 LD A,H        ; Fetch the high byte.
 $95E8 AND %00011111 ; Keep only bits 0-4.
 $95EA LD H,A        ; Write it back to #REGh.
 $95EB LD DE,$7000   ; #REGde=#R$7000.
 $95EE EX DE,HL      ; {Point #REGde at that terrain cell.
 $95EF ADD HL,DE     ;
 $95F0 EX DE,HL      ; }
 $95F1 EX (SP),HL    ; Exchange the cell index with the stacked pointer.
; Move onto the next screen column if the scroll is on a character
; boundary.
 $95F2 LD A,($607A)  ; Fetch #R$607A.
 $95F5 AND %00000111 ; Keep only bits 0-2.
 $95F7 JR NZ,$95FA   ; {Jump to #R$95FA if the scroll is not on a
 $95F9 INC HL        ; character boundary, else move onto the next screen column.
                     ; }
; OR the first graphic column onto the screen.
@label=StampTerrainTile_XORColumn
*$95FA PUSH HL       ; Stash the screen pointer on the stack.
 $95FB LD A,(DE)     ; {Fetch the tile index from *#REGde into #REGhl.
 $95FC LD L,A        ;
 $95FD LD H,$00      ; }
 $95FF LD DE,$F66E   ; #REGde=#R$F66E.
 $9602 ADD HL,HL     ; {Multiply the tile index by #N$08 and add the
 $9603 ADD HL,HL     ; graphic base.
 $9604 ADD HL,HL     ;
 $9605 ADD HL,DE     ; }
 $9606 EX DE,HL      ; Point #REGde at that graphic.
; Work out the pixel shift from the scroll position.
 $9607 EXX           ; Switch to the shadow registers.
 $9608 LD A,($607A)  ; Fetch #R$607A.
 $960B NEG           ; Negate the low byte.
 $960D AND %00000111 ; Keep only bits 0-2.
 $960F LD C,A        ; Store the pixel shift in #REGc.
 $9610 EXX           ; Switch back to the main registers.
 $9611 POP HL        ; {Restore the screen pointer from the stack, but
 $9612 PUSH HL       ; stash a copy of it on the stack again.}
 $9613 LD B,$08      ; Set a pixel row counter in #REGb for #N$08 loops.
 $9615 CALL $9632    ; Call #R$9632.
; Fetch the next terrain cell's graphic and draw it in the
; next screen column.
 $9618 POP HL        ; Restore the screen pointer from the stack.
 $9619 EX (SP),HL    ; Exchange it with the stacked cell index.
 $961A INC HL        ; Move onto the next cell.
 $961B LD A,H        ; Fetch the high byte.
 $961C AND %00000011 ; Keep only bits 0-1.
 $961E LD H,A        ; Write it back to #REGh.
; Look up the graphic for that cell.
 $961F LD DE,$7000   ; #REGde=#R$7000.
 $9622 ADD HL,DE     ; Point #REGhl at that terrain cell.
 $9623 LD L,(HL)     ; {Fetch the tile index from *#REGhl into #REGhl.
 $9624 LD H,$00      ; }
 $9626 ADD HL,HL     ; {Multiply the tile index by #N$08.
 $9627 ADD HL,HL     ;
 $9628 ADD HL,HL     ; }
 $9629 LD DE,$F66E   ; #REGde=#R$F66E.
 $962C ADD HL,DE     ; {Point #REGde at that graphic.
 $962D EX DE,HL      ; }
; Aim at the next screen column and reset the row counter.
 $962E POP HL        ; Restore the screen pointer from the stack.
 $962F INC L         ; Move onto the next screen column.
 $9630 LD B,$08      ; Set a pixel row counter in #REGb for #N$08 loops.
; Shift a graphic byte by the scroll and OR it onto
; two neighbouring screen bytes.
@label=StampTerrainTile_Loop
*$9632 LD A,(DE)     ; Fetch the graphic byte.
 $9633 EXX           ; Switch to the shadow registers.
 $9634 LD H,A        ; {Store it in #REGh and clear #REGl.
 $9635 LD L,$00      ; }
 $9637 LD B,C        ; #REGb=the pixel shift.
 $9638 LD A,C        ; {Jump to #R$9642 if there is no shift.
 $9639 AND A         ;
 $963A JR Z,$9642    ; }
@label=StampTerrainTile_ShiftPixel
*$963C SRL H         ; {Shift the graphic right by one pixel.
 $963E RR L          ; }
 $9640 DJNZ $963C    ; Decrease the shift counter by one and loop back
                     ; to #R$963C until the shift is done.
; OR the shifted graphic onto the two screen bytes.
@label=StampTerrainTile_MergeBytes
*$9642 LD A,L        ; {Stash the low byte and fetch the high byte.
 $9643 EX AF,AF'     ;
 $9644 LD A,H        ; }
 $9645 EXX           ; Switch back to the main registers.
 $9646 OR (HL)       ; {Merge the high byte onto the current screen byte.
 $9647 LD (HL),A     ;
 $9648 INC L         ; }
 $9649 EX AF,AF'     ; Fetch the stashed low byte.
 $964A OR (HL)       ; {Merge the low byte onto the next screen byte.
 $964B LD (HL),A     ; }
 $964C INC DE        ; Move onto the next graphic byte.
 $964D DEC L         ; {Step back and down one pixel row.
 $964E INC H         ; }
 $964F DJNZ $9632    ; Decrease the row counter by one and loop back to
                     ; #R$9632 until the column is drawn.
 $9651 RET           ; Return.
@label=StampTerrainTile_Restore
*$9652 POP HL        ; Restore the cell index from the stack.
 $9653 RET           ; Return.

; Handler: Drifting Alien
;
; Count the alien, then drift it relative to the scroll in
; #R$607A.
;
; IX Actor slot
@label=Handler_DriftingAlien
c$9654 LD HL,$5E5E    ; #REGhl=#R$5E5E.
 $9657 INC (HL)       ; Increase #R$5E5E by one.
; Compare the alien with #R$607A and pick a drift
; direction.
 $9658 LD H,(IX+$03)  ; Fetch the high byte of the world X.
 $965B LD L,(IX+$02)  ; Fetch the low byte of the world X.
 $965E LD DE,($607A)  ; Fetch #R$607A.
 $9662 AND A          ; {Subtract the scroll position.
 $9663 SBC HL,DE      ; }
 $9665 BIT 4,H        ; {Jump to #R$96D7 if the alien is left of the
 $9667 JP NZ,$96D7    ; scroll.}
; Speed the alien up towards the left, up to a limit.
 $966A LD C,$00       ; Clear the reverse-animation flag.
 $966C LD A,(IX+$05)  ; {Jump to #R$9677 if the horizontal speed is
 $966F AND A          ; positive.
 $9670 JP P,$9677     ; }
 $9673 CP $D1         ; {Jump to #R$9679 if the speed is already below
 $9675 JR C,$9679     ; #N$D1.}
@label=Handler_DriftingAlien_Decelerate
*$9677 SUB $02        ; Subtract #N$02 from the speed.
@label=Handler_DriftingAlien_Loop
*$9679 LD (IX+$05),A  ; Write the speed back.
; Aim the vertical thrust at Jetman, or at mid-screen
; when Jetman is in the rover.
 $967C LD A,($6078)   ; Fetch the Jetman type from #R$6078.
 $967F CP $11         ; {Jump to #R$9687 if Jetman is on foot.
 $9681 JR C,$9687     ; }
 $9683 LD A,$68       ; #REGa=#N$68.
 $9685 JR $968A       ; Jump to #R$968A.
@label=Handler_DriftingAlien_FetchJetmanY
*$9687 LD A,($607C)   ; Fetch #R$607C.
; Compare with the alien's Y position and, if the alien is above the
; target, increase the downward thrust, up to a limit.
@label=Handler_DriftingAlien_CompareY
*$968A SUB (IX+$04)   ; Subtract the alien's Y position.
 $968D JP M,$96E8     ; Jump to #R$96E8 if the alien is below the target.
 $9690 LD A,(IX+$06)  ; {Jump to #R$969B if the vertical thrust is
 $9693 AND A          ; negative.
 $9694 JP M,$969B     ; }
 $9697 CP $30         ; {Jump to #R$969D if the thrust is already at least
 $9699 JR NC,$969D    ; #N$30.}
@label=Handler_DriftingAlien_AddThrust
*$969B ADD A,$02      ; Add #N$02 to the thrust.
; Apply the thrust to the alien's Y position, bouncing at the
; top and bottom.
@label=Handler_DriftingAlien_ApplyThrust
*$969D LD (IX+$06),A  ; Write the thrust back.
 $96A0 SRA A          ; {Divide it by #N$10.
 $96A2 SRA A          ;
 $96A4 SRA A          ;
 $96A6 SRA A          ; }
 $96A8 ADD A,(IX+$04) ; Add it to the alien's Y position.
 $96AB CP $38         ; {Jump to #R$96F7 if the alien is above the play
 $96AD JR C,$96F7     ; area.}
 $96AF CP $B0         ; {Jump to #R$9705 if the alien has hit the ground
 $96B1 JR NC,$9705    ; line.}
 $96B3 LD (IX+$04),A  ; Write the Y position back.
; Animate the frame and colour, then continue at
; #R$954B.
@label=Handler_DriftingAlien_Animate
*$96B6 INC (IX+$11)   ; Increase the animation timer.
 $96B9 LD A,(IX+$11)  ; Fetch the animation timer.
 $96BC AND %00000111  ; Keep only bits 0-2.
 $96BE BIT 7,C        ; {Jump to #R$96C4 if the reverse-animation flag is
 $96C0 JR NZ,$96C4    ; set.}
 $96C2 XOR %00000111  ; Flip bits 0-2.
; Sprite IDs begin at #R$D59F(#N$48) (#SPRITENAME$48).
@label=Handler_DriftingAlien_WriteFrame
*$96C4 ADD A,$48      ; Add #N$48 for the drifting frames.
 $96C6 LD (IX+$00),A  ; Write it to the actor type.
; Alternate the colour using bit 0 of #R$5E42.
 $96C9 LD A,($5E42)   ; Fetch #R$5E42.
 $96CC RLA            ; Rotate it left once.
 $96CD AND %00000010  ; Keep only bit 1.
 $96CF ADD A,$44      ; Add #N$44 for the colour.
 $96D1 LD (IX+$07),A  ; Write it to the actor colour.
 $96D4 JP $954B       ; Jump to #R$954B.
; When the alien is left of the scroll, drift right.
@label=Handler_DriftingAlien_DriftRight
*$96D7 LD C,$80       ; Set the reverse-animation flag.
 $96D9 LD A,(IX+$05)  ; {Jump to #R$96E4 if the horizontal speed is
 $96DC AND A          ; negative.
 $96DD JP M,$96E4     ; }
 $96E0 CP $30         ; {Jump to #R$9679 if the speed is already at least
 $96E2 JR NC,$9679    ; #N$30.}
@label=Handler_DriftingAlien_AddSpeed
*$96E4 ADD A,$02      ; Add #N$02 to the speed.
 $96E6 JR $9679       ; Jump to #R$9679.
; When the alien is below the target, apply upward thrust.
@label=Handler_DriftingAlien_ThrustUp
*$96E8 LD A,(IX+$06)  ; {Jump to #R$96F3 if the vertical thrust is
 $96EB AND A          ; positive.
 $96EC JP P,$96F3     ; }
 $96EF CP $D1         ; {Jump to #R$969D if the thrust is already below
 $96F1 JR C,$969D     ; #N$D1.}
@label=Handler_DriftingAlien_SubtractThrust
*$96F3 SUB $02        ; Subtract #N$02 from the thrust.
 $96F5 JR $969D       ; Jump to #R$969D.
; Bounce off the top of the play area.
@label=Handler_DriftingAlien_BounceTop
*$96F7 LD A,(IX+$06)  ; {Jump to #R$96B6 if the vertical thrust is
 $96FA AND A          ; positive.
 $96FB JP P,$96B6     ; }
@label=Handler_DriftingAlien_NegateThrust
*$96FE NEG            ; Negate the thrust.
 $9700 LD (IX+$06),A  ; Write it back.
 $9703 JR $96B6       ; Jump to #R$96B6.
; Bounce off the ground line.
@label=Handler_DriftingAlien_BounceGround
*$9705 LD A,(IX+$06)  ; {Jump to #R$96B6 if the vertical thrust is
 $9708 AND A          ; negative.
 $9709 JP M,$96B6     ; }
 $970C JR $96FE       ; Jump to #R$96FE.

; Handler: Mr Magnetic Brella
;
; Count the alien and steer it toward the scroll position at
; #R$607A. When it is close to the object at #R$60AA, it picks
; that object up and carries it.
;
; IX Actor slot
@label=Handler_MrMagneticBrella
c$970E LD HL,$5E5E     ; #REGhl=#R$5E5E.
 $9711 INC (HL)        ; Increase #R$5E5E by one.
 $9712 BIT 0,(IX+$08)  ; {Jump to #R$97F4 if the alien is already attached.
 $9716 JP NZ,$97F4     ; }
; Attach when the alien is close to #R$60AA.
 $9719 LD A,($60B0)    ; {Jump to #R$974C if #R$60B0 is already set.
 $971C AND A           ;
 $971D JR NZ,$974C     ; }
; Test whether the alien is horizontally close to the object.
 $971F LD H,(IX+$03)   ; Fetch the high byte of the world X.
 $9722 LD L,(IX+$02)   ; Fetch the low byte of the world X.
 $9725 LD DE,($60AA)   ; Fetch #R$60AA.
 $9729 LD BC,$0008     ; {Add an #N$08 tolerance.
 $972C ADD HL,BC       ; }
 $972D SBC HL,DE       ; Subtract the target position.
 $972F LD A,H          ; Fetch the high byte of the gap.
 $9730 AND %00011111   ; Keep only bits 0-4.
 $9732 JR NZ,$974C     ; Jump to #R$974C if they are not on the same
                       ; screen.
 $9734 LD A,L          ; Fetch the low byte of the gap.
 $9735 CP $10          ; {Jump to #R$974C if it is at least #N$10.
 $9737 JR NC,$974C     ; }
; Test whether the alien is vertically close to the object.
 $9739 LD A,($60AC)    ; Fetch #R$60AC.
 $973C SUB (IX+$04)    ; Subtract the alien's Y position.
 $973F CP $10          ; {Jump to #R$974C if the Y gap is at least #N$10.
 $9741 JR NC,$974C     ; }
; Flag both the alien and the object as attached.
 $9743 SET 0,(IX+$08)  ; Set bit 0 of the actor flags.
 $9747 LD HL,$60B0     ; #REGhl=#R$60B0.
 $974A SET 0,(HL)      ; Set bit 0 of the target flags.
; Copy the position at #R$60AA to the alien if it is beside
; #R$60C2.
@label=Handler_MrMagneticBrella_CopyBeside
*$974C CALL $9884      ; {Jump to #R$9761 if the alien is not beside
 $974F JR NZ,$9761     ; #R$60C2.}
 $9751 LD DE,($60AA)   ; Fetch #R$60AA.
 $9755 LD (IX+$03),D   ; {Copy that position into the alien's world X.
 $9758 LD (IX+$02),E   ; }
 $975B LD A,($60AC)    ; Fetch #R$60AC.
 $975E LD (IX+$04),A   ; Copy it to the alien's Y position.
; Apply downward thrust and update the Y position.
@label=Handler_MrMagneticBrella_ApplyDownThrust
*$9761 LD A,(IX+$06)   ; {Jump to #R$976C if the vertical thrust is
 $9764 AND A           ; negative.
 $9765 JP M,$976C      ; }
 $9768 CP $30          ; {Jump to #R$9771 if the thrust is already at least
 $976A JR NC,$9771     ; #N$30.}
@label=Handler_MrMagneticBrella_AddThrust
*$976C ADD A,$02       ; Add #N$02 to the thrust.
 $976E LD (IX+$06),A   ; Write the thrust back.
@label=Handler_MrMagneticBrella_AddThrustToY
*$9771 SRA A           ; {Divide the thrust by #N$10.
 $9773 SRA A           ;
 $9775 SRA A           ;
 $9777 SRA A           ; }
 $9779 ADD A,(IX+$04)  ; Add it to the alien's Y position.
 $977C CP $B0          ; {Jump to #R$97E6 if the alien has hit the ground
 $977E JR NC,$97E6     ; line.}
@label=Handler_MrMagneticBrella_WriteY
*$9780 LD (IX+$04),A   ; Write the Y position back.
; Steer toward the scroll, then animate.
@label=Handler_MrMagneticBrella_Loop
*$9783 LD H,(IX+$03)   ; Fetch the high byte of the world X.
 $9786 LD L,(IX+$02)   ; Fetch the low byte of the world X.
 $9789 PUSH HL         ; Stash the world X on the stack.
 $978A LD DE,($607A)   ; Fetch #R$607A.
 $978E SBC HL,DE       ; Subtract the scroll position.
 $9790 LD C,$00        ; #REGc=#N$00.
; Leave the speed unchanged if the alien is on this screen or just off
; its left edge.
 $9792 LD A,H          ; Fetch the high byte of the gap.
 $9793 AND %00011111   ; Keep only bits 0-4.
 $9795 JR Z,$97A8      ; Jump to #R$97A8 if the alien is on this screen.
 $9797 OR %11100000    ; Set bits 5-7.
 $9799 CPL             ; Flip the bits.
 $979A AND A           ; {Jump to #R$97A8 if the result is zero.
 $979B JR Z,$97A8      ; }
 $979D BIT 4,H         ; Test bit 4 of the gap.
; #N$30 is a signed +#N$30 rightward speed; #N$D0
; is signed -#N$30 leftward.
 $979F LD A,$30        ; #REGa=#N$30.
 $97A1 JR NZ,$97A5     ; Jump to #R$97A5 if the alien is left of the
                       ; scroll.
 $97A3 LD A,$D0        ; #REGa=#N$D0.
@label=Handler_MrMagneticBrella_WriteSpeed
*$97A5 LD (IX+$05),A   ; Write the speed to *#REGix+#N$05.
; Move the carried object with the alien if it is attached.
@label=Handler_MrMagneticBrella_RestoreX
*$97A8 POP HL          ; Restore the world X from the stack.
 $97A9 BIT 0,(IX+$08)  ; {Jump to #R$97C1 if the alien is not attached.
 $97AD JP Z,$97C1      ; }
 $97B0 LD ($60AA),HL   ; Write the world X back to #R$60AA.
 $97B3 LD A,(IX+$04)   ; Fetch the alien's Y position.
 $97B6 ADD A,$1A       ; Add #N$1A.
 $97B8 CP $B0          ; {Jump to #R$97BE if it is still above the ground
 $97BA JR C,$97BE      ; line.}
; #N$AF is the ground line.
 $97BC LD A,$AF        ; #REGa=#N$AF.
@label=Handler_MrMagneticBrella_WriteLinkedY
*$97BE LD ($60AC),A    ; Write it to #R$60AC.
; Animate the alien and set its colour.
@label=Handler_MrMagneticBrella_TickAnimation
*$97C1 INC (IX+$11)    ; Increase the animation timer.
 $97C4 LD A,(IX+$11)   ; Fetch the animation timer.
 $97C7 AND %00000111   ; Keep only bits 0-2.
; Sprite IDs begin at #R$D894(#N$40) (#SPRITENAME$40).
 $97C9 ADD A,$40       ; Add #N$40 for the seeking frames.
 $97CB LD (IX+$00),A   ; Write it to the actor type.
 $97CE BIT 0,(IX+$10)  ; {Jump to #R$97DF if bit 0 of *#REGix+#N$10 is
 $97D2 JR Z,$97DF      ; reset.}
 $97D4 BIT 0,(IX+$08)  ; {Jump to #R$97DF if the alien is not attached.
 $97D8 JR Z,$97DF      ; }
 $97DA LD A,$80        ; {Write #N$80 to #R$60B0.
 $97DC LD ($60B0),A    ; }
@label=Handler_MrMagneticBrella_SetColour
*$97DF LD (IX+$07),$45 ; Write #COLOUR$45 to the actor colour.
 $97E3 JP $954B        ; Jump to #R$954B.
; Bounce off the ground line.
@label=Handler_MrMagneticBrella_BounceGround
*$97E6 LD A,(IX+$06)   ; {Jump to #R$9780 if the vertical thrust is
 $97E9 AND A           ; negative.
 $97EA JP M,$9780      ; }
 $97ED NEG             ; Negate the thrust.
 $97EF LD (IX+$06),A   ; Write it back.
 $97F2 JR $9783        ; Jump to #R$9783.
; When attached, keep flying and copy the new position back to #R$60AA.
@label=Handler_MrMagneticBrella_AttachedFly
*$97F4 INC (IX+$11)    ; Increase the animation timer.
 $97F7 LD A,(IX+$04)   ; Fetch the alien's Y position.
 $97FA CP $70          ; Compare it with #N$70.
 $97FC LD A,(IX+$06)   ; Fetch the vertical thrust.
 $97FF JR NC,$985A     ; Jump to #R$985A if the alien is at or below
                       ; mid-screen.
; When above mid-screen, increase the downward thrust, up to a limit.
 $9801 AND A           ; {Jump to #R$9809 if the thrust is negative.
 $9802 JP M,$9809      ; }
 $9805 CP $30          ; {Jump to #R$980B if the thrust is already at least
 $9807 JR NC,$980B     ; #N$30.}
@label=Handler_MrMagneticBrella_AttachedAddThrust
*$9809 ADD A,$02       ; Add #N$02 to the thrust.
; Apply the thrust to the alien's Y position, stopping at the ground
; line.
@label=Handler_MrMagneticBrella_AttachedApplyThrust
*$980B LD (IX+$06),A   ; Write the thrust back.
 $980E SRA A           ; {Divide it by #N$10.
 $9810 SRA A           ;
 $9812 SRA A           ;
 $9814 SRA A           ; }
 $9816 ADD A,(IX+$04)  ; Add it to the alien's Y position.
 $9819 CP $B0          ; {Jump to #R$981F if it is still above the ground
 $981B JR C,$981F      ; line.}
; #N$AF is the ground line.
 $981D LD A,$AF        ; #REGa=#N$AF.
@label=Handler_MrMagneticBrella_AttachedWriteY
*$981F LD (IX+$04),A   ; Write the Y position back.
; Occasionally pick a new horizontal direction using
; #R$5E40.
 $9822 LD A,($5E40)    ; {Jump to #R$9872 if #R$5E40 is zero.
 $9825 LD C,A          ;
 $9826 AND A           ;
 $9827 JR Z,$9872      ; }
 $9829 AND %01111111   ; Keep only bits 0-6.
 $982B JR NZ,$983A     ; Jump to #R$983A if the result is not zero.
 $982D LD A,C          ; Fetch the stored random byte.
 $982E AND %10000000   ; Keep only bit 7.
 $9830 LD C,A          ; Stash that sign bit.
 $9831 LD A,(IX+$08)   ; Fetch the actor flags.
 $9834 AND %01111111   ; Keep only bits 0-6.
 $9836 OR C            ; {Merge in the sign bit and write the flags back.
 $9837 LD (IX+$08),A   ; }
; Accelerate left or right from bit 7 of the flags.
@label=Handler_MrMagneticBrella_AccelerateFromFlag
*$983A BIT 7,(IX+$08)  ; Test bit 7 of the actor flags.
 $983E LD A,(IX+$05)   ; Fetch the horizontal speed.
 $9841 JR NZ,$9866     ; Jump to #R$9866 if bit 7 is set.
; When bit 7 is reset, speed up towards the right, up to a limit.
 $9843 AND A           ; {Jump to #R$984B if the speed is negative.
 $9844 JP M,$984B      ; }
 $9847 CP $30          ; {Jump to #R$984D if the speed is already at least
 $9849 JR NC,$984D     ; #N$30.}
@label=Handler_MrMagneticBrella_AddSpeed
*$984B ADD A,$02       ; Add #N$02 to the speed.
@label=Handler_MrMagneticBrella_WriteSpeedBack
*$984D LD (IX+$05),A   ; Write the speed back.
; Stash the world X and rejoin the shared code at #R$97A8.
@label=Handler_MrMagneticBrella_StashWorldX
*$9850 LD H,(IX+$03)   ; Fetch the high byte of the world X.
 $9853 LD L,(IX+$02)   ; Fetch the low byte of the world X.
 $9856 PUSH HL         ; Stash the world X on the stack.
 $9857 JP $97A8        ; Jump to #R$97A8.
; When below mid-screen, apply upward thrust.
@label=Handler_MrMagneticBrella_ThrustUp
*$985A AND A           ; {Jump to #R$9862 if the thrust is positive.
 $985B JP P,$9862      ; }
 $985E CP $D1          ; {Jump to #R$980B if the thrust is already below
 $9860 JR C,$980B      ; #N$D1.}
@label=Handler_MrMagneticBrella_SubtractThrust
*$9862 SUB $02         ; Subtract #N$02 from the thrust.
 $9864 JR $980B        ; Jump to #R$980B.
@label=Handler_MrMagneticBrella_CapSpeed
*$9866 AND A           ; {Jump to #R$986E if the speed is positive.
 $9867 JP P,$986E      ; }
 $986A CP $D1          ; {Jump to #R$984D if the speed is already below
 $986C JR C,$984D      ; #N$D1.}
@label=Handler_MrMagneticBrella_SubtractSpeed
*$986E SUB $02         ; Subtract #N$02 from the speed.
 $9870 JR $984D        ; Jump to #R$984D.
; When #R$5E40 is zero, check for terrain under the alien. If there
; is some, detach the alien; otherwise carry on accelerating.
@label=Handler_MrMagneticBrella_DetachIfTerrain
*$9872 CALL $91BB      ; Call #R$91BB.
 $9875 LD A,D          ; {Jump to #R$983A if the first terrain cell is
 $9876 AND A           ; empty.
 $9877 JR Z,$983A      ; }
 $9879 LD A,$80        ; {Write #N$80 to #R$60B0.
 $987B LD ($60B0),A    ; }
 $987E LD (IX+$08),$00 ; Write #N$00 to the actor flags.
 $9882 JR $9850        ; Jump to #R$9850.

; Test Alien Beside Slot
;
; Used by the routine at #R$970E.
; .
; Return with the Z flag set if the alien is beside the object in
; #R$60C2, otherwise with the Z flag unset.
;
; IX Actor slot
@label=TestAlienBesideSlot
c$9884 LD H,(IX+$03) ; Fetch the high byte of the world X.
 $9887 LD L,(IX+$02) ; Fetch the low byte of the world X.
 $988A LD DE,($60C2) ; Fetch #R$60C2.
 $988E LD BC,$0008   ; {Add an #N$08 tolerance.
 $9891 ADD HL,BC     ; }
 $9892 SBC HL,DE     ; Subtract the slot-2 position.
 $9894 LD A,H        ; Fetch the high byte of the gap.
 $9895 AND %00011111 ; Keep only bits 0-4.
 $9897 JR NZ,$98AA   ; Jump to #R$98AA if they are not on the same
                     ; screen.
 $9899 LD A,L        ; Fetch the low byte of the gap.
 $989A CP $10        ; {Jump to #R$98AA if it is at least #N$10.
 $989C JR NC,$98AA   ; }
; Test whether the alien is vertically close to the object.
 $989E LD A,($60C4)  ; Fetch #R$60C4.
 $98A1 SUB (IX+$04)  ; Subtract the alien's Y position.
 $98A4 CP $10        ; {Jump to #R$98AA if the Y gap is at least #N$10.
 $98A6 JR NC,$98AA   ; }
 $98A8 XOR A         ; {Return with the Z flag set.
 $98A9 RET           ; }
@label=TestAlienBesideSlot_NotBeside
*$98AA LD A,$01      ; {Return with the Z flag unset.
 $98AC AND A         ;
 $98AD RET           ; }

; Clear Terrain Under Actor
;
; Used by the routines at #R$93E8 and #R$95B6.
; .
; Clear the play-area pixels under the actor and return with the Z
; flag set, or return with it unset if the actor is off-screen.
;
; IX Actor slot
@label=ClearTerrainUnderActor
c$98AE LD H,(IX+$03) ; Fetch the high byte of the world X.
 $98B1 LD L,(IX+$02) ; Fetch the low byte of the world X.
 $98B4 LD DE,($607A) ; Fetch #R$607A.
 $98B8 AND A         ; {Subtract the scroll position.
 $98B9 SBC HL,DE     ; }
 $98BB LD DE,$0078   ; {Add a #N$78 tolerance.
 $98BE ADD HL,DE     ; }
 $98BF LD A,H        ; Fetch the high byte of the gap.
 $98C0 AND %00011111 ; Keep only bits 0-4.
 $98C2 RET NZ        ; Return if the actor is not on this screen.
; Build the pixel mask for the fine scroll position.
 $98C3 EX DE,HL      ; Switch the gap into #REGde.
 $98C4 LD A,($607A)  ; Fetch #R$607A.
 $98C7 AND %00000111 ; Keep only bits 0-2.
 $98C9 LD B,A        ; Store the fine scroll in #REGb.
 $98CA LD A,$00      ; #REGa=#N$00.
 $98CC LD HL,$00FF   ; #REGhl=#N($00FF,$04,$04).
 $98CF JR Z,$98D5    ; Jump to #R$98D5 if there is no fine scroll.
@label=ClearTerrainUnderActor_ShiftMask
*$98D1 ADD HL,HL     ; {Shift the mask left by one pixel.
 $98D2 RLA           ; }
 $98D3 DJNZ $98D1    ; Decrease the fine-scroll counter by one and loop
                     ; back to #R$98D1 until the shift is done.
@label=ClearTerrainUnderActor_StoreMask
*$98D5 EX DE,HL      ; {Store the mask in #REGde and the overflow in
 $98D6 LD C,A        ; #REGc.}
; Work out the screen column under the actor.
 $98D7 LD A,($607A)  ; Fetch #R$607A.
 $98DA RRA           ; {Divide the scroll by #N$08.
 $98DB RRA           ;
 $98DC RRA           ; }
 $98DD AND %00011111 ; Keep only bits 0-4.
 $98DF LD L,A        ; Store the scroll column in #REGl.
; Work out the actor's column relative to the scroll column.
 $98E0 LD A,(IX+$02) ; Fetch the low byte of the world X.
 $98E3 RRA           ; {Divide it by #N$08.
 $98E4 RRA           ;
 $98E5 RRA           ; }
 $98E6 AND %00011111 ; Keep only bits 0-4.
 $98E8 SUB L         ; Subtract the scroll column.
 $98E9 ADD A,$0E     ; Add #N$0E.
 $98EB AND %00011111 ; Keep only bits 0-4.
 $98ED LD HL,$50C0   ; #REGhl=#N$50C0.
 $98F0 ADD A,L       ; {Point #REGhl at that screen column.
 $98F1 LD L,A        ; }
 $98F2 LD B,$08      ; Set a pixel row counter in #REGb for #N$08 loops.
; Clear the masked pixels one pixel row at a time.
@label=ClearTerrainUnderActor_MaskRow
*$98F4 PUSH HL       ; Stash the row start on the stack.
 $98F5 LD A,E        ; {Mask the first screen byte.
 $98F6 AND (HL)      ;
 $98F7 LD (HL),A     ;
 $98F8 INC L         ; }
 $98F9 LD A,C        ; {Mask the middle screen byte.
 $98FA AND (HL)      ;
 $98FB LD (HL),A     ;
 $98FC INC L         ; }
 $98FD LD A,D        ; {Mask the third screen byte.
 $98FE AND (HL)      ;
 $98FF LD (HL),A     ; }
 $9900 POP HL        ; Restore the row start from the stack.
 $9901 INC H         ; Move down one pixel row.
 $9902 DJNZ $98F4    ; Decrease the row counter by one and loop back to
                     ; #R$98F4 until the column is cleared.
 $9904 XOR A         ; {Return with the Z flag set.
 $9905 RET           ; }

; Handler: The Block
;
; Animate The Block, or clear the slot once it has moved off the
; screen in the direction it is travelling.
;
; IX Actor slot
@label=Handler_Block
c$9906 LD H,(IX+$03)   ; Fetch the high byte of the world X.
 $9909 LD L,(IX+$02)   ; Fetch the low byte of the world X.
 $990C LD DE,($607A)   ; Fetch #R$607A.
 $9910 AND A           ; {Subtract the scroll position.
 $9911 SBC HL,DE       ; }
 $9913 BIT 7,(IX+$05)  ; {Jump to #R$9930 if the horizontal speed is
 $9917 JR NZ,$9930     ; negative.}
 $9919 LD A,H          ; Fetch the high byte of the gap.
 $991A AND %00011111   ; Keep only bits 0-4.
 $991C CP $01          ; {Jump to #R$9937 if the alien has left the screen.
 $991E JR Z,$9937      ; }
; Select the animation frame for The Block.
@label=Handler_Block_Animation
*$9920 INC (IX+$11)    ; Increase the animation timer.
 $9923 LD A,(IX+$11)   ; Fetch the animation timer.
 $9926 AND %00000111   ; Keep only bits 0-2.
; Sprite IDs begin at #R$E2A7(#N$88) (#SPRITENAME$88).
 $9928 ADD A,$88       ; Add #N$88 for these frames.
 $992A LD (IX+$00),A   ; Write it to the actor type.
 $992D JP $954B        ; Jump to #R$954B.
; When The Block is moving left, test whether it has left the left edge.
@label=Handler_Block_StillOnScreen
*$9930 LD A,H          ; Fetch the high byte of the gap.
 $9931 OR %11100000    ; Set bits 5-7.
 $9933 CP $FE          ; {Jump to #R$9920 if the alien has not left the
 $9935 JR NZ,$9920     ; left edge.}
; This entry point is used by the routine at #R$9531.
@label=Handler_Block_ClearType
*$9937 LD (IX+$00),$00 ; Write #N$00 to the actor type.
 $993B RET             ; Return.

; Handler: Bouncing Wheel
;
; Steer the Bouncing Wheel toward the scroll position and bounce it
; at the play-area edges.
;
; IX Actor slot
@label=Handler_BouncingWheel
c$993C LD H,(IX+$03)   ; Fetch the high byte of the world X.
 $993F LD L,(IX+$02)   ; Fetch the low byte of the world X.
 $9942 LD DE,($607A)   ; Fetch #R$607A.
 $9946 AND A           ; {Subtract the scroll position.
 $9947 SBC HL,DE       ; }
 $9949 LD C,$00        ; #REGc=#N$00.
; Leave the speed unchanged if the wheel is on this screen or just off
; its left edge.
 $994B LD A,H          ; Fetch the high byte of the gap.
 $994C AND %00011111   ; Keep only bits 0-4.
 $994E JR Z,$9961      ; Jump to #R$9961 if the alien is on this screen.
 $9950 OR %11100000    ; Set bits 5-7.
 $9952 CPL             ; Flip the bits.
 $9953 AND A           ; {Jump to #R$9961 if the result is zero.
 $9954 JR Z,$9961      ; }
 $9956 BIT 4,H         ; Test bit 4 of the gap.
; #N$30 is a signed +#N$30 rightward speed; #N$D0
; is signed -#N$30 leftward.
 $9958 LD A,$30        ; #REGa=#N$30.
 $995A JR NZ,$995E     ; Jump to #R$995E if the alien is left of the
                       ; scroll.
 $995C LD A,$D0        ; #REGa=#N$D0.
@label=Handler_BouncingWheel_WriteSpeed
*$995E LD (IX+$05),A   ; Write the speed to *#REGix+#N$05.
; Move the wheel vertically, bouncing it off the play-area edges.
@label=Handler_BouncingWheel_AddY
*$9961 LD A,(IX+$04)   ; Fetch the alien's Y position.
 $9964 ADD A,(IX+$06)  ; Add the vertical thrust.
 $9967 CP $38          ; {Jump to #R$9988 if the alien is above the play
 $9969 JR C,$9988      ; area.}
 $996B CP $B0          ; {Jump to #R$998E if the alien has hit the ground
 $996D JR NC,$998E     ; line.}
 $996F LD (IX+$04),A   ; Write the Y position back.
; Step the animation timer and pick the animation frame.
@label=Handler_BouncingWheel_TickAnimation
*$9972 INC (IX+$11)    ; Increase the animation timer.
 $9975 LD A,(IX+$11)   ; Fetch the animation timer.
 $9978 CP $06          ; {Jump to #R$9980 if it is still below #N$06.
 $997A JR C,$9980      ; }
 $997C XOR A           ; {Write #N$00 to the animation timer.
 $997D LD (IX+$11),A   ; }
; Sprite IDs begin at #R$ED51(#N$A8) (#SPRITENAME$A8).
@label=Handler_BouncingWheel_WriteFrame
*$9980 ADD A,$A8       ; Add #N$A8 for these frames.
 $9982 LD (IX+$00),A   ; Write it to the actor type.
 $9985 JP $954B        ; Jump to #R$954B.
; Bounce off the top by thrusting down, or off the ground by thrusting
; up.
@label=Handler_BouncingWheel_ThrustDown
*$9988 LD (IX+$06),$03 ; Write #N$03 to the vertical thrust.
 $998C JR $9972        ; Jump to #R$9972.
@label=Handler_BouncingWheel_ThrustUp
*$998E LD (IX+$06),$FD ; Write #N$FD to the vertical thrust.
 $9992 JR $9972        ; Jump to #R$9972.

; Handler: Spinner
;
; Wobble the Spinner's X and Y speed offsets, steer it toward the
; scroll position and bounce it at the play-area edges.
;
; IX Actor slot
@label=Handler_Spinner
c$9994 LD A,(IX+$12)   ; {Jump to #R$999F if *#REGix+#N$12 is positive.
 $9997 AND A           ;
 $9998 JP P,$999F      ; }
 $999B LD A,$02        ; #REGa=#N$02.
 $999D JR $99A1        ; Jump to #R$99A1.
@label=Handler_Spinner_WobbleX
*$999F LD A,$FE        ; #REGa=#N$FE.
@label=Handler_Spinner_AddWobbleX
*$99A1 ADD A,(IX+$13)  ; Add it to *#REGix+#N$13.
 $99A4 LD (IX+$13),A   ; Write the new value back.
 $99A7 ADD A,(IX+$12)  ; Add it to *#REGix+#N$12.
 $99AA LD (IX+$12),A   ; Write the new value back.
; Wobble the vertical speed offsets in the same way.
 $99AD LD A,(IX+$14)   ; {Jump to #R$99B8 if *#REGix+#N$14 is positive.
 $99B0 AND A           ;
 $99B1 JP P,$99B8      ; }
 $99B4 LD A,$02        ; #REGa=#N$02.
 $99B6 JR $99BA        ; Jump to #R$99BA.
@label=Handler_Spinner_WobbleY
*$99B8 LD A,$FE        ; #REGa=#N$FE.
@label=Handler_Spinner_AddWobbleY
*$99BA ADD A,(IX+$15)  ; Add it to *#REGix+#N$15.
 $99BD LD (IX+$15),A   ; Write the new value back.
 $99C0 ADD A,(IX+$14)  ; Add it to *#REGix+#N$14.
 $99C3 LD (IX+$14),A   ; Write the new value back.
; Move the spinner vertically, bouncing it off the play-area
; edges.
 $99C6 ADD A,(IX+$06)  ; Add the vertical thrust.
 $99C9 SRA A           ; {Divide the result by #N$10.
 $99CB SRA A           ;
 $99CD SRA A           ;
 $99CF SRA A           ; }
 $99D1 ADD A,(IX+$04)  ; Add it to the alien's Y position.
 $99D4 CP $3A          ; {Jump to #R$9A23 if the alien is above the play
 $99D6 JR C,$9A23      ; area.}
 $99D8 CP $B0          ; {Jump to #R$9A29 if the alien has hit the ground
 $99DA JR NC,$9A29     ; line.}
 $99DC LD (IX+$04),A   ; Write the Y position back.
; Work out the extra horizontal speed from the scroll position.
@label=Handler_Spinner_CompareScroll
*$99DF LD H,(IX+$03)   ; Fetch the high byte of the world X.
 $99E2 LD L,(IX+$02)   ; Fetch the low byte of the world X.
 $99E5 LD DE,($607A)   ; Fetch #R$607A.
 $99E9 AND A           ; {Subtract the scroll position.
 $99EA SBC HL,DE       ; }
 $99EC LD C,$00        ; #REGc=#N$00.
; Leave the extra speed unchanged if the spinner is on this screen or
; just off its left edge.
 $99EE LD A,H          ; Fetch the high byte of the gap.
 $99EF AND %00011111   ; Keep only bits 0-4.
 $99F1 JR Z,$9A04      ; Jump to #R$9A04 if the alien is on this screen.
 $99F3 OR %11100000    ; Set bits 5-7.
 $99F5 CPL             ; Flip the bits.
 $99F6 AND A           ; {Jump to #R$9A04 if the result is zero.
 $99F7 JR Z,$9A04      ; }
 $99F9 BIT 4,H         ; Test bit 4 of the gap.
; #N$20 is a signed +#N$20 rightward extra speed;
; #N$E0 is signed -#N$20 leftward.
 $99FB LD A,$20        ; #REGa=#N$20.
 $99FD JR NZ,$9A01     ; Jump to #R$9A01 if the alien is left of the
                       ; scroll.
 $99FF LD A,$E0        ; #REGa=#N$E0.
@label=Handler_Spinner_WriteExtraX
*$9A01 LD (IX+$16),A   ; Write it to *#REGix+#N$16.
@label=Handler_Spinner_MergeExtraSpeed
*$9A04 LD A,(IX+$16)   ; Fetch *#REGix+#N$16.
 $9A07 ADD A,(IX+$12)  ; Add *#REGix+#N$12.
 $9A0A LD (IX+$05),A   ; Write the result to the horizontal speed.
; Step the animation timer and pick the animation frame.
 $9A0D INC (IX+$11)    ; Increase the animation timer.
 $9A10 LD A,(IX+$11)   ; Fetch the animation timer.
 $9A13 CP $06          ; {Jump to #R$9A1B if it is still below #N$06.
 $9A15 JR C,$9A1B      ; }
 $9A17 XOR A           ; {Write #N$00 to the animation timer.
 $9A18 LD (IX+$11),A   ; }
; Sprite IDs begin at #R$E848(#N$B0) (#SPRITENAME$B0).
@label=Handler_Spinner_WriteFrame
*$9A1B ADD A,$B0       ; Add #N$B0 for these frames.
 $9A1D LD (IX+$00),A   ; Write it to the actor type.
 $9A20 JP $954B        ; Jump to #R$954B.
; #N$20 is a signed +#N$20 downward thrust. #N$E0
; is signed -#N$20 upward.
@label=Handler_Spinner_ThrustDown
*$9A23 LD (IX+$06),$20 ; Write #N$20 to the vertical thrust.
 $9A27 JR $99DF        ; Jump to #R$99DF.
@label=Handler_Spinner_ThrustUp
*$9A29 LD (IX+$06),$E0 ; Write #N$E0 to the vertical thrust.
 $9A2D JR $99DF        ; Jump to #R$99DF.

; Handler: Saturn
;
; Drift the Saturn toward the scroll position and aim it at Jetman.
;
; IX Actor slot
@label=Handler_Saturn
c$9A2F LD HL,$5E5E    ; #REGhl=#R$5E5E.
 $9A32 INC (HL)       ; Increase #R$5E5E by one.
; Steer the horizontal speed toward the scroll position.
 $9A33 LD H,(IX+$03)  ; Fetch the high byte of the world X.
 $9A36 LD L,(IX+$02)  ; Fetch the low byte of the world X.
 $9A39 LD DE,($607A)  ; Fetch #R$607A.
 $9A3D AND A          ; {Subtract the scroll position.
 $9A3E SBC HL,DE      ; }
 $9A40 BIT 4,H        ; {Jump to #R$9AAB if the alien is left of the
 $9A42 JP NZ,$9AAB    ; scroll.}
; Speed the alien up towards the left, up to a limit.
 $9A45 LD C,$00       ; #REGc=#N$00.
 $9A47 LD A,(IX+$05)  ; {Jump to #R$9A52 if the horizontal speed is
 $9A4A AND A          ; positive.
 $9A4B JP P,$9A52     ; }
 $9A4E CP $B1         ; {Jump to #R$9A54 if the speed is already below
 $9A50 JR C,$9A54     ; #N$B1.}
@label=Handler_Saturn_Decelerate
*$9A52 SUB $02        ; Subtract #N$02 from the speed.
@label=Handler_Saturn_WriteSpeed
*$9A54 LD (IX+$05),A  ; Write the speed back.
; Pick a target height from Jetman's position and steer the
; vertical thrust toward it.
 $9A57 LD A,($6078)   ; Fetch the Jetman type from #R$6078.
 $9A5A CP $11         ; {Jump to #R$9A62 if Jetman is on foot.
 $9A5C JR C,$9A62     ; }
 $9A5E LD A,$68       ; #REGa=#N$68.
 $9A60 JR $9A65       ; Jump to #R$9A65.
@label=Handler_Saturn_FetchJetmanY
*$9A62 LD A,($607C)   ; Fetch #R$607C.
; Compare with the alien's Y position and, if the alien is above the
; target, increase the downward thrust, up to a limit.
@label=Handler_Saturn_CompareY
*$9A65 SUB (IX+$04)   ; Subtract the alien's Y position.
 $9A68 JP M,$9ABC     ; Jump to #R$9ABC if the alien is below the target.
 $9A6B LD A,(IX+$06)  ; {Jump to #R$9A76 if the vertical thrust is
 $9A6E AND A          ; negative.
 $9A6F JP M,$9A76     ; }
 $9A72 CP $40         ; {Jump to #R$9A78 if the thrust is already at least
 $9A74 JR NC,$9A78    ; #N$40.}
@label=Handler_Saturn_AddThrust
*$9A76 ADD A,$02      ; Add #N$02 to the thrust.
; Apply the thrust to the Y position, bouncing off the play-area
; edges.
@label=Handler_Saturn_ApplyThrust
*$9A78 LD (IX+$06),A  ; Write the thrust back.
 $9A7B SRA A          ; {Divide it by #N$10.
 $9A7D SRA A          ;
 $9A7F SRA A          ;
 $9A81 SRA A          ; }
 $9A83 ADD A,(IX+$04) ; Add it to the alien's Y position.
 $9A86 CP $38         ; {Jump to #R$9ACB if the alien is above the play
 $9A88 JR C,$9ACB     ; area.}
 $9A8A CP $B0         ; {Jump to #R$9AD9 if the alien has hit the ground
 $9A8C JR NC,$9AD9    ; line.}
 $9A8E LD (IX+$04),A  ; Write the Y position back.
; Pick the animation frame and colour.
@label=Handler_Saturn_Animate
*$9A91 INC (IX+$11)   ; Increase the animation timer.
 $9A94 LD A,(IX+$11)  ; Fetch the animation timer.
 $9A97 AND %00001111  ; Keep only bits 0-3.
; Sprite IDs begin at #R$E703(#N$CC) (#SPRITENAME$CC).
 $9A99 ADD A,$CC      ; Add #N$CC for these frames.
 $9A9B LD (IX+$00),A  ; Write it to the actor type.
; Alternate the colour using bit 0 of #R$5E42.
 $9A9E LD A,($5E42)   ; Fetch #R$5E42.
 $9AA1 AND %00000001  ; Keep only bit 0.
 $9AA3 ADD A,$45      ; Add #N$45 for the colour.
 $9AA5 LD (IX+$07),A  ; Write it to the actor colour.
 $9AA8 JP $954B       ; Jump to #R$954B.
; When the alien is left of the scroll, drift right.
@label=Handler_Saturn_DriftRight
*$9AAB LD C,$80       ; #REGc=#N$80.
 $9AAD LD A,(IX+$05)  ; {Jump to #R$9AB8 if the horizontal speed is
 $9AB0 AND A          ; negative.
 $9AB1 JP M,$9AB8     ; }
 $9AB4 CP $50         ; {Jump to #R$9A54 if the speed is already at least
 $9AB6 JR NC,$9A54    ; #N$50.}
@label=Handler_Saturn_AddSpeed
*$9AB8 ADD A,$02      ; Add #N$02 to the speed.
 $9ABA JR $9A54       ; Jump to #R$9A54.
; When the alien is below the target, apply upward thrust.
@label=Handler_Saturn_ApplyUpThrust
*$9ABC LD A,(IX+$06)  ; {Jump to #R$9AC7 if the vertical thrust is
 $9ABF AND A          ; positive.
 $9AC0 JP P,$9AC7     ; }
 $9AC3 CP $C1         ; {Jump to #R$9A78 if the thrust is already below
 $9AC5 JR C,$9A78     ; #N$C1.}
@label=Handler_Saturn_SubtractThrust
*$9AC7 SUB $02        ; Subtract #N$02 from the thrust.
 $9AC9 JR $9A78       ; Jump to #R$9A78.
; Bounce off the top of the play area.
@label=Handler_Saturn_BounceTop
*$9ACB LD A,(IX+$06)  ; {Jump to #R$9A91 if the vertical thrust is
 $9ACE AND A          ; positive.
 $9ACF JP P,$9A91     ; }
@label=Handler_Saturn_NegateThrust
*$9AD2 NEG            ; Negate the thrust.
 $9AD4 LD (IX+$06),A  ; Write it back.
 $9AD7 JR $9A91       ; Jump to #R$9A91.
; Bounce off the ground line.
@label=Handler_Saturn_BounceGround
*$9AD9 LD A,(IX+$06)  ; {Jump to #R$9A91 if the vertical thrust is
 $9ADC AND A          ; negative.
 $9ADD JP M,$9A91     ; }
 $9AE0 JR $9AD2       ; Jump to #R$9AD2.

; Handler: Shooter
;
; Fire a shot when the Shooter is on screen, then chase Jetman's Y
; position.
;
; IX Actor slot
@label=Handler_Shooter
c$9AE2 LD H,(IX+$03)   ; Fetch the high byte of the world X.
 $9AE5 LD L,(IX+$02)   ; Fetch the low byte of the world X.
 $9AE8 PUSH HL         ; Stash the world X on the stack.
 $9AE9 LD DE,($607A)   ; Fetch #R$607A.
 $9AED AND A           ; {Subtract the scroll position.
 $9AEE SBC HL,DE       ; }
 $9AF0 BIT 7,(IX+$05)  ; {Jump to #R$9B9E if the horizontal speed is
 $9AF4 JP NZ,$9B9E     ; negative.}
 $9AF7 LD A,H          ; Fetch the high byte of the gap.
 $9AF8 AND %00011111   ; Keep only bits 0-4.
 $9AFA CP $01          ; {Jump to #R$9BA6 if the alien has left the screen.
 $9AFC JP Z,$9BA6      ; }
; Skip firing and chase Jetman if the shooter is not on this
; screen.
@label=Handler_Shooter_ShotTolerance
*$9AFF LD DE,$0078     ; {Add a #N$78 tolerance.
 $9B02 ADD HL,DE       ; }
 $9B03 LD A,H          ; Fetch the high byte.
 $9B04 POP DE          ; Restore the world X into #REGde from the stack.
 $9B05 AND A           ; {Jump to #R$9B59 if the alien is not on this
 $9B06 JR NZ,$9B59     ; screen.}
 $9B08 PUSH DE         ; Stash the world X on the stack again.
; Set the speed to #N$50 or #N$B0 if bit 7 of *#REGix+#N$01 differs
; from the direction of travel.
 $9B09 LD A,(IX+$01)   ; Fetch the screen column.
 $9B0C XOR (IX+$05)    ; XOR it with the horizontal speed.
 $9B0F AND %10000000   ; Keep only bit 7.
 $9B11 JR Z,$9B24      ; Jump to #R$9B24 if they already match.
 $9B13 LD A,(IX+$05)   ; {Jump to #R$9B20 if the horizontal speed is
 $9B16 AND A           ; negative.
 $9B17 JP M,$9B20      ; }
 $9B1A LD (IX+$05),$50 ; Write #N$50 to the horizontal speed.
 $9B1E JR $9B24        ; Jump to #R$9B24.
@label=Handler_Shooter_ShotSpeedLeft
*$9B20 LD (IX+$05),$B0 ; Write #N$B0 to the horizontal speed.
; Spawn a shot in a free alien slot.
@label=Handler_Shooter_SpawnShot
*$9B24 CALL $9395      ; Call #R$9395.
 $9B27 POP DE          ; Restore the world X into #REGde from the stack.
 $9B28 JR NZ,$9B59     ; Jump to #R$9B59 if no alien slot is free.
 $9B2A LD (HL),$B6     ; Write type #N$B6 to the new slot.
 $9B2C BIT 7,(IX+$05)  ; {Jump to #R$9B34 if the shot is moving left.
 $9B30 JR NZ,$9B34     ; }
 $9B32 LD (HL),$B7     ; Write type #N$B7.
; Fill in the new shot: its position, speed, thrust and colour.
@label=Handler_Shooter_CopyShotX
*$9B34 INC HL          ; {Move onto the world X.
 $9B35 INC HL          ; }
 $9B36 LD (HL),E       ; {Write the shooter's world X into the slot.
 $9B37 INC HL          ;
 $9B38 LD (HL),D       ; }
 $9B39 INC HL          ; Move onto the Y position.
 $9B3A LD A,(IX+$04)   ; {Copy the shooter's Y position.
 $9B3D LD (HL),A       ; }
; Give the shot a speed in the direction the shooter is moving.
 $9B3E INC HL          ; Move onto the horizontal speed.
 $9B3F LD A,(IX+$05)   ; {Jump to #R$9B4A if the shooter is moving left.
 $9B42 AND A           ;
 $9B43 JP M,$9B4A      ; }
 $9B46 LD (HL),$70     ; Write #N$70 to the shot speed.
 $9B48 JR $9B4C        ; Jump to #R$9B4C.
@label=Handler_Shooter_ShotSpeedRight
*$9B4A LD (HL),$90     ; Write #N$90 to the shot speed.
; Zero the thrust, set the colour and clear the rest of the slot.
@label=Handler_Shooter_InitialiseShotSlot
*$9B4C INC HL          ; {Write #N$00 to the thrust.
 $9B4D LD (HL),$00     ;
 $9B4F INC HL          ; }
 $9B50 LD (HL),$47     ; Write #COLOUR$47 to the colour.
 $9B52 LD B,$0F        ; Set a byte counter in #REGb for #N$0F loops.
@label=Handler_Shooter_ClearShotTail
*$9B54 INC HL          ; {Clear the next slot byte.
 $9B55 LD (HL),$00     ; }
 $9B57 DJNZ $9B54      ; Decrease the byte counter by one and loop back
                       ; to #R$9B54 until the slot is cleared.
; Chase Jetman's Y position.
@label=Handler_Shooter_ChaseJetmanY
*$9B59 LD A,($607C)    ; Fetch #R$607C.
 $9B5C SUB (IX+$04)    ; Subtract the alien's Y position.
 $9B5F JP P,$9BAC      ; Jump to #R$9BAC if Jetman is below the alien.
 $9B62 LD A,(IX+$06)   ; {Jump to #R$9B6D if the vertical thrust is
 $9B65 AND A           ; positive.
 $9B66 JP P,$9B6D      ; }
 $9B69 CP $EF          ; {Jump to #R$9B6F if the thrust is already below
 $9B6B JR C,$9B6F      ; #N$EF.}
@label=Handler_Shooter_ChaseSubtractThrust
*$9B6D SUB $02         ; Subtract #N$02 from the thrust.
; Apply the thrust to the Y position unless it would leave the
; play area.
@label=Handler_Shooter_ChaseApplyThrust
*$9B6F LD (IX+$06),A   ; Write the thrust back.
 $9B72 SRA A           ; {Divide it by #N$10.
 $9B74 SRA A           ;
 $9B76 SRA A           ;
 $9B78 SRA A           ; }
 $9B7A ADD A,(IX+$04)  ; Add it to the alien's Y position.
 $9B7D CP $38          ; {Jump to #R$9B88 if the alien is above the play
 $9B7F JR C,$9B88      ; area.}
 $9B81 CP $B0          ; {Jump to #R$9B88 if the alien has hit the ground
 $9B83 JR NC,$9B88     ; line.}
 $9B85 LD (IX+$04),A   ; Write the Y position back.
; Step the animation timer and pick the animation frame.
@label=Handler_Shooter_ChaseTickAnimation
*$9B88 INC (IX+$11)    ; Increase the animation timer.
 $9B8B LD A,(IX+$11)   ; Fetch the animation timer.
 $9B8E CP $07          ; {Jump to #R$9B96 if it is still below #N$07.
 $9B90 JR C,$9B96      ; }
 $9B92 XOR A           ; {Write #N$00 to the animation timer.
 $9B93 LD (IX+$11),A   ; }
; Sprite IDs begin at #R$E99C(#N$B8) (#SPRITENAME$B8).
@label=Handler_Shooter_ChaseWriteFrame
*$9B96 ADD A,$B8       ; Add #N$B8 for these frames.
 $9B98 LD (IX+$00),A   ; Write it to the actor type.
 $9B9B JP $954B        ; Jump to #R$954B.
; Test whether a left-moving shooter has gone off the left edge.
@label=Handler_Shooter_ChaseStillOnScreen
*$9B9E LD A,H          ; Fetch the high byte of the gap.
 $9B9F OR %11100000    ; Set bits 5-7.
 $9BA1 CP $FE          ; {Jump to #R$9AFF if the alien has not left the
 $9BA3 JP NZ,$9AFF     ; left edge.}
@label=Handler_Shooter_ChaseClearType
*$9BA6 LD (IX+$00),$00 ; Write #N$00 to the actor type.
 $9BAA POP HL          ; Restore the world X from the stack.
 $9BAB RET             ; Return.
; When Jetman is below the shooter, thrust downward.
@label=Handler_Shooter_ChaseAddThrustTest
*$9BAC LD A,(IX+$06)   ; {Jump to #R$9BB7 if the vertical thrust is
 $9BAF AND A           ; negative.
 $9BB0 JP M,$9BB7      ; }
 $9BB3 CP $20          ; {Jump to #R$9B6F if the thrust is already at least
 $9BB5 JR NC,$9B6F     ; #N$20.}
@label=Handler_Shooter_ChaseAddThrust
*$9BB7 ADD A,$02       ; Add #N$02 to the thrust.
 $9BB9 JR $9B6F        ; Jump to #R$9B6F.

; Handler: The Pip
;
; Move the shot with its horizontal speed and test whether it has
; hit.
;
; IX Actor slot
@label=Handler_ThePip
c$9BBB LD H,(IX+$03)   ; Fetch the high byte of the world X.
 $9BBE LD L,(IX+$02)   ; Fetch the low byte of the world X.
 $9BC1 LD DE,($607A)   ; Fetch #R$607A.
 $9BC5 AND A           ; {Subtract the scroll position.
 $9BC6 SBC HL,DE       ; }
 $9BC8 BIT 7,(IX+$05)  ; {Jump to #R$9C17 if the horizontal speed is
 $9BCC JR NZ,$9C17     ; negative.}
 $9BCE LD A,H          ; Fetch the high byte of the gap.
 $9BCF AND %00011111   ; Keep only bits 0-4.
 $9BD1 CP $01          ; {Jump to #R$9C1E if the shot has left the screen.
 $9BD3 JR Z,$9C1E      ; }
; Move the shot along its horizontal speed.
@label=Handler_ThePip_MoveShotX
*$9BD5 LD H,(IX+$03)   ; Fetch the high byte of the world X.
 $9BD8 LD L,(IX+$02)   ; Fetch the low byte of the world X.
; Turn the horizontal speed into a signed pixel step.
 $9BDB LD A,(IX+$05)   ; Fetch the horizontal speed.
 $9BDE LD D,$00        ; Clear #REGd for a positive step.
 $9BE0 SRA A           ; {Divide it by #N$10.
 $9BE2 SRA A           ;
 $9BE4 SRA A           ;
 $9BE6 SRA A           ; }
 $9BE8 JP P,$9BED      ; Jump to #R$9BED if the speed is positive.
 $9BEB LD D,$FF        ; Set #REGd=#N$FF for a negative step.
@label=Handler_ThePip_AddShotStep
*$9BED LD E,A          ; Store the pixel step in #REGe.
; Add the step to the world X, keep it in range and write it back.
 $9BEE ADD HL,DE       ; Add the step to the world X.
 $9BEF LD A,H          ; Fetch the high byte.
 $9BF0 AND %00011111   ; Keep only bits 0-4.
 $9BF2 LD (IX+$03),A   ; Write the high byte back.
 $9BF5 LD (IX+$02),L   ; Write the low byte back.
; Draw the shot and colour its sprite.
 $9BF8 CALL $8B73      ; Call #R$8B73.
 $9BFB CALL $8733      ; Call #R$8733.
 $9BFE BIT 0,(IX+$10)  ; {Jump to #R$9C0D if bit 0 of *#REGix+#N$10 is
 $9C02 JR Z,$9C0D      ; reset.}
 $9C04 LD BC,$0050     ; Set the points to award in #REGbc to
                       ; #N($0050,$04,$04).
 $9C07 CALL $899C      ; Call #R$899C.
 $9C0A CALL $A73C      ; Call #R$A73C.
; Test whether the shot has hit Jetman, and kill him if so.
@label=Handler_ThePip_ShotHit
*$9C0D CALL $B2A2      ; {Return if #R$B2A2 does not set carry.
 $9C10 RET NC          ; }
 $9C11 CALL $A73C      ; Call #R$A73C.
 $9C14 JP $B2D7        ; Jump to #R$B2D7.
@label=Handler_ThePip_ShotStillOnScreen
*$9C17 LD A,H          ; Fetch the high byte of the gap.
 $9C18 OR %11100000    ; Set bits 5-7.
 $9C1A CP $FE          ; {Jump to #R$9BD5 if the shot has not left the left
 $9C1C JR NZ,$9BD5     ; edge.}
@label=Handler_ThePip_ShotClearType
*$9C1E LD (IX+$00),$00 ; Write #N$00 to the actor type.
 $9C22 RET             ; Return.

; Set Default Values
;
; Used by the routine at #R$800A.
; .
; Copy the default names and high-score tables into
; working RAM.
;
; .
;
; Copy the default names and high-score tables into RAM.
@label=SetDefaults
c$9C23 LD HL,$9D80   ; {Copy #N($0018,$04,$04) bytes from #R$9D80 to #R$5E20.
 $9C26 LD DE,$5E20   ;
 $9C29 LD BC,$0018   ;
 $9C2C LDIR          ; }
 $9C2E LD HL,$9D98   ; {Copy #N($0018,$04,$04) bytes from #R$9D98 to #R$5E06.
 $9C31 LD DE,$5E06   ;
 $9C34 LD BC,$0018   ;
 $9C37 LDIR          ; }
 $9C39 RET           ; Return.

; Alien States
@label=Alien_Meteor
b$9C3A DEFB $50,$00,$00,$00,$38,$60,$00,$42 ; {#SPRITENAME(#PEEK(#PC)).
 $9C42 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
 $9C4A DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; }
