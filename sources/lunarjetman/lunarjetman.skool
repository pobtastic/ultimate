 $9CAA DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; }
@label=Alien_Spinner
 $9CB2 DEFB $B0,$00,$00,$00,$38,$20,$20,$43 ; {#SPRITENAME(#PEEK(#PC)).
