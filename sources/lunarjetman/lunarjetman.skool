@label=Level3Aliens
 $9D1A DEFW $9C3A
 $9D1C DEFW $9C3A
 $9D1E DEFW $9C9A
 $9D20 DEFW $9C82
 $9D22 DEFW $9CB2
 $9D24 DEFW $9C6A
 $9D26 DEFW $9C9A
 $9D28 DEFW $9C82
