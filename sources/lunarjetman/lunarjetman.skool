 $9C72 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
 $9C7A DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; }
@label=Alien_TheBlock
 $9C82 DEFB $88,$00,$00,$00,$00,$00,$00,$44 ; {#SPRITENAME(#PEEK(#PC)).
