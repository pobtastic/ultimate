; Write Menu Line
;
; Used by the routine at #R$80D1.
; .
; Converts a menu line co-ordinate into screen and
; attribute addresses, then prints the line using #R$5E66.
;
; HL Menu line co-ordinate
; DE Message pointer
;
; Convert the menu line co-ordinate and print the string.
@label=MenuWriteText
c$81AB PUSH HL       ; Stash the menu line co-ordinate on the stack.
 $81AC CALL $851E    ; Call #R$851E.
 $81AF LD A,($5E66)  ; Fetch the menu attribute from #R$5E66.
 $81B2 EX AF,AF'     ; Switch to the shadow #REGaf register.
 $81B3 EXX           ; Switch to the shadow registers.
 $81B4 POP HL        ; Restore the menu line co-ordinate from the stack.
 $81B5 CALL $8506    ; Call #R$8506.
 $81B8 JP $8A1D      ; Jump to #R$8A1D.
; View the equivalent code in;
; #LIST
; { #ATICATAC$7D8A }
; { #COOKIE$63E0 }
; { #JETPAC$62FF }
; { #PSSST$62E7 }
; { #SABREWULF$B52D }
; { #TRANZAM$5F97 }
; { #UNDERWURLDE$91B0 }
; LIST#

; Start Game
;
; Used by the routine at #R$802C.
; .
; Queues the start-game tune, clears planet RAM and then
; walks every actor through #R$82C5.
;
; .
;
; Queue the start-game tune and clear planet RAM.
@label=StartGame
c$81BB LD DE,$BA35   ; Set the tune pointer to #R$BA35.
 $81BE CALL $B9BC    ; Queue the start-game tune.
; Reset the planet and player state.
 $81C1 LD HL,$5E50   ; Set the start address to #R$5E50.
 $81C4 LD BC,$6000   ; Set the end address to #R$6000.
 $81C7 CALL $84B2    ; Call #R$84B2.
 $81CA CALL $84F7    ; Call #R$84F7.
 $81CD CALL $A84C    ; Call #R$A84C.
 $81D0 CALL $822F    ; Call #R$822F.
 $81D3 CALL $A826    ; Call #R$A826.
; This entry point is used by the routine at #R$8259.
; .
; Ready the stack and restore Jetman after a teleport.
@label=StartGame_ReadyStack
*$81D6 LD SP,$5E00   ; Set the stack pointer to #R$5E00.
 $81D9 LD A,($5E68)  ; {Call #R$A2CF if #R$5E68 is set.
 $81DC AND A         ;
 $81DD CALL NZ,$A2CF ; }
 $81E0 EI            ; Enable interrupts.
; This entry point is used by the routine at #R$A299.
; .
; Dispatch the current actor through the jump table.
@label=StartGame_DispatchActor
*$81E1 XOR A         ; {Write #N$00 to #R$5E5E.
 $81E2 LD ($5E5E),A  ; }
 $81E5 LD IX,$6078   ; Point #REGix at #R$6078.
; This entry point is used by the routines at #R$8209 and #R$8259.
@label=StartGame_NextActor
*$81E9 LD A,($5C78)  ; {#REGc=#SKOOLKID$5C78(FRAMES).
 $81EC LD C,A        ; }
 $81ED LD A,($5E53)  ; {Call #R$8209 if #R$5E53 does not match.
 $81F0 CP C          ;
 $81F1 CALL NZ,$8209 ; }
 $81F4 LD HL,$8259   ; {Push #R$8259 as the return address.
 $81F7 PUSH HL       ; }
 $81F8 LD BC,$82C5   ; Set the jump-table pointer to #R$82C5.
 $81FB LD L,(IX+$00) ; Fetch the actor type from *#REGix+#N$00.
; This entry point is used by the routine at #R$B6CF.
@label=StartGame_AfterActor
*$81FE LD H,$00      ; {Fetch the handler address from #R$82C5.
 $8200 ADD HL,HL     ;
 $8201 ADD HL,BC     ;
 $8202 LD A,(HL)     ;
 $8203 INC HL        ;
 $8204 LD H,(HL)     ;
 $8205 LD L,A        ; }
 $8206 JP $5CB0      ; Jump to #R$5CB0.
; View the equivalent code in;
; #LIST
; { #ATICATAC$7D9A }
; { #COOKIE$6428 }
; { #JETPAC$6333 }
; { #PSSST$632D }
; { #TRANZAM$5FEF }
; LIST#

; Frame Update
;
; Used by the routine at #R$81BB.
; .
; Runs when the FRAMES counter has ticked. Marks the frame as
; updated and walks the actor slots from #R$6000 up to #R$6078 (the
; laser beams and explosion), then returns to the current actor.
;
; .
;
; Mark the frame as updated, then walk the slots up to #R$6078.
@label=FrameUpdate
c$8209 DI            ; Disable interrupts.
 $820A LD A,($5C78)  ; {Write #SKOOLKID$5C78(FRAMES) to #R$5E53.
 $820D LD ($5E53),A  ; }
 $8210 LD A,$01      ; {Write #N$01 to #R$5E52.
 $8212 LD ($5E52),A  ; }
 $8215 PUSH IX       ; Stash #REGix on the stack.
 $8217 LD HL,$6078   ; {Write #R$6078 to #R$8261(#N$8262).
 $821A LD ($8262),HL ; }
 $821D LD A,$C3      ; {Write #N$C3 (JP) to #R$826A.
 $821F LD ($826A),A  ; }
 $8222 LD HL,$823F   ; {Write #R$823F to #R$826B.
 $8225 LD ($826B),HL ; }
 $8228 LD IX,$6000   ; #REGix=#R$6000.
 $822C JP $81E9      ; Jump to #R$81E9.
; View the equivalent code in;
; #LIST
; { #COOKIE$7160 }
; { #PSSST$70ED }
; LIST#

; Reset Modified Code
;
; Used by the routines at #R$81BB and #R$823F.
; .
; Points the object iterator at #R$6240 and removes the JP
; patched in by #R$8209.
;
; .
;
; Point the object iterator at #R$6240 and remove the JP.
@label=ResetModifiedCode
c$822F LD HL,$6240   ; {Write #R$6240 to #R$8261(#N$8262).
 $8232 LD ($8262),HL ; }
 $8235 LD HL,$826A   ; {Write #N$00 to #R$826A, #R$826B and #R$826C.
 $8238 XOR A         ;
 $8239 LD (HL),A     ;
 $823A INC HL        ;
 $823B LD (HL),A     ;
 $823C INC HL        ;
 $823D LD (HL),A     ; }
 $823E RET           ; Return.
; View the equivalent code in;
; #LIST
; { #COOKIE$7186 }
; { #PSSST$7113 }
; LIST#

; Reset Modified Code In Frame
;
; Restores the actor pointer stashed by #R$8209 and clears
; #R$5E52.
;
; .
;
; Restore the actor pointer stashed by #R$8209.
@label=ResetModifiedInFrame
c$823F CALL $822F    ; Call #R$822F.
 $8242 POP IX        ; Restore #REGix from the stack.
 $8244 XOR A         ; {Write #N$00 to #R$5E52.
 $8245 LD ($5E52),A  ; }
 $8248 EI            ; Enable interrupts.
 $8249 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #PSSST$7125 }
; LIST#

; Limit Frame Rate
;
; Handler for an empty actor slot (type #N$00). Waits for a short
; delay unless a frame update is running. A larger counter here slows
; the game down.
;
; .
;
; Return if the frame is marked as updated, otherwise pause.
@label=LimitFrameRate
c$824A LD A,($5E52)  ; {Return if #R$5E52 is marked as being updated.
 $824D AND A         ;
 $824E RET NZ        ; }
 $824F LD HL,$00C0   ; Introduce a counter (#N($00C0,$04,$04)) for a slight
                     ; pause.
@label=LimitFrameRate_Loop
*$8252 DEC HL        ; Decrease counter by one.
 $8253 LD A,L        ; {Keep jumping back to #R$8252 until the counter is zero.
 $8254 OR H          ;
 $8255 JR NZ,$8252   ; }
 $8257 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #COOKIE$7152 }
; { #JETPAC$691B }
; { #PSSST$70DF }
; LIST#

; Unused
;
; Never reached, as nothing jumps here.
u$8258 RET           ; Return.

; Next Object Slot
;
; Return address pushed by #R$81F4. Moves #REGix onto the next
; #N$18-byte actor and either dispatches it or runs the rest of
; the game loop once the list is finished.
;
; IX Actor slot
;
; Advance #REGix onto the next #N$18-byte actor slot.
@label=NextObjectSlot
c$8259 LD DE,$0018   ; {#REGix+=#N($0018,$04,$04).
 $825C ADD IX,DE     ; }
 $825E PUSH IX       ; {Copy #REGix to #REGhl (using the stack).
 $8260 POP HL        ; }
 $8261 LD BC,$6240   ; {Jump to #R$81E9 if #REGhl is still below #R$6240.
 $8264 AND A         ;
 $8265 SBC HL,BC     ;
 $8267 JP C,$81E9    ; }
 $826A DEFB $00      ; {Patched to JP #R$823F while a frame update is running.
 $826B DEFB $00      ;
 $826C DEFB $00      ; }
; Update timers, then handle pause, spawning, pickups and bombs.
 $826D LD HL,($5E42) ; {Increment #R$5E42 by one.
 $8270 INC HL        ;
 $8271 LD ($5E42),HL ; }
; Stir the random number with a byte from the ROM, picked by the low
; byte of the timer.
 $8274 LD H,$00      ; #REGh=#N$00, so #REGhl is a ROM address from #N($0000,$04,$04) to
                     ; #N($00FF,$04,$04), set by the low byte of #R$5E42.
 $8276 LD A,($5E40)  ; #REGa=*#R$5E40.
 $8279 ADD A,(HL)    ; Add the ROM byte at *#REGhl to #REGa.
 $827A LD ($5E40),A  ; Write #REGa back to #R$5E40.
 $827D CALL $8298    ; Call #R$8298.
; Restart the game loop early if Jetman is not in play.
 $8280 LD A,($5E6C)  ; {Jump to #R$81D6 if #R$5E6C is set.
 $8283 AND A         ;
 $8284 JP NZ,$81D6   ; }
; Spawn an alien if there are too few, then run the
; remaining handlers for this frame.
 $8287 LD A,($5E5E)  ; {Call #R$9466 if #R$5E5E is less than #N$07.
 $828A CP $07        ;
 $828C CALL C,$9466  ; }
 $828F CALL $9F70    ; Call #R$9F70.
 $8292 CALL $B731    ; Call #R$B731.
 $8295 JP $81D6      ; Jump to #R$81D6.

; Controls: Pause
;
; Used by the routines at #R$8259 and #R$B52E.
; .
; If "O" is pressed on its own, waits for it to be released, then
; for a second press and release of "O" before returning.
;
; .
;
; Hold the game while "O" is pressed.
@label=ControlsPause
c$8298 DI            ; Disable interrupts.
 $8299 LD A,$DF      ; {Read from the keyboard;
 $829B OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $829D IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$DF | P | O | I | U | Y }
                     ; TABLE#}
; If key "O" is not being pressed, then just return.
 $829F BIT 1,A       ; {Return if bit 1 is set.
 $82A1 RET NZ        ; }
; Return if any other key has been pressed with "O".
 $82A2 CPL           ; Flip the bits.
 $82A3 AND %00011101 ; Keep only bits 0, 2-4.
 $82A5 RET NZ        ; Return if the result is not zero.
; Loop until the "O" button is released.
@label=GamePaused_Debounce
*$82A6 LD A,$DF      ; {Read from the keyboard;
 $82A8 OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $82AA IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$DF | P | O | I | U | Y }
                     ; TABLE#}
 $82AC BIT 1,A       ; {Jump to #R$82A6 if "O" is still pressed.
 $82AE JR Z,$82A6    ; }
; Creates an infinite loop which only exits when "O" is pressed again.
@label=GamePaused
*$82B0 LD A,$DF      ; {Read from the keyboard;
 $82B2 OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $82B4 IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$DF | P | O | I | U | Y }
                     ; TABLE#}
 $82B6 BIT 1,A       ; {Jump to #R$82B0 if "O" is not pressed.
 $82B8 JR NZ,$82B0   ; }
; Likewise, to prevent the pause from recurring
; instantly, loop until the "O" button is released.
@label=GamePaused_Debounce_Exit
*$82BA LD A,$DF      ; {Read from the keyboard;
 $82BC OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $82BE IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$DF | P | O | I | U | Y }
                     ; TABLE#}
 $82C0 BIT 1,A       ; {Jump to #R$82BA if "O" is still pressed.
 $82C2 JR Z,$82BA    ; }
 $82C4 RET           ; Return.

