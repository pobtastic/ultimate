@label=Level5Aliens
 $9D3A DEFW $9C3A
 $9D3C DEFW $9C9A
 $9D3E DEFW $9C82
 $9D40 DEFW $9C52
 $9D42 DEFW $9CB2
 $9D44 DEFW $9C6A
 $9D46 DEFW $9CE2
 $9D48 DEFW $9C3A
