@label=Level4Aliens
 $9D2A DEFW $9C3A
 $9D2C DEFW $9C9A
 $9D2E DEFW $9C82
 $9D30 DEFW $9C52
 $9D32 DEFW $9CB2
 $9D34 DEFW $9C6A
 $9D36 DEFW $9C3A
 $9D38 DEFW $9C82
