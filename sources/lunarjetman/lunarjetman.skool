; Reset Screen Buffer
;
; Used by the routine at #R$84D8.
; .
; Points at the screen buffer and fills it with #N$00.
;
; .
;
; Point at the screen buffer and fall into #R$84B4.
@label=ResetScreen
c$84AD LD HL,$4000   ; Set the target address to #N$4000 (screen buffer).
 $84B0 LD B,$58      ; Finish at the start of #N$5800.
; This entry point is used by the routine at #R$81BB.
@label=ResetScreen_Fill
*$84B2 LD C,$00      ; Set the fill value to #N$00.
; Continue on to #R$84B4 to blank the screen buffer.
; .
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CE60 }
; { #ATICATAC$80B4 }
; { #COOKIE$74D4 }
; { #CYBERUN$9A7E }
; { #GUNFRIGHT$D6DB }
; { #JETPAC$71B8 }
; { #KNIGHTLORE$D544 }
; { #NIGHTSHADE$E5A8 }
; { #PSSST$7439 }
; { #SABREWULF$BB81 }
; { #TRANZAM$7211 }
; LIST#

; Fill Memory
;
; Used by the routine at #R$84BB.
; .
; Writes #REGc from the target address up to the page in
; #REGb.
;
; HL Target address
; B End-address MSB (the LSB is always #N$00)
; C Value to write
@label=ResetCopier
c$84B4 LD (HL),C     ; Write the fill value to the target address.
 $84B5 INC HL        ; Move onto the next byte.
 $84B6 LD A,H        ; {Compare the target page with the end page.
 $84B7 CP B          ; }
 $84B8 JR NZ,$84B4   ; Jump back to #R$84B4 until the end page is reached.
 $84BA RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$80BB }
; { #COOKIE$74DB }
; { #JETPAC$71BF }
; { #PSSST$7440 }
; { #SABREWULF$BB88 }
; { #TRANZAM$7218 }
; LIST#

; Reset Attribute Buffer
;
; Used by the routine at #R$84D8.
; .
; Fills the attribute buffer with #COLOUR$43, then paints
; a black column on the left and right of each row.
;
; .
;
; Fill the attribute buffer with #COLOUR$43.
@label=ResetAttributes
c$84BB XOR A         ; {Set the border to #INK$00.
 $84BC OUT ($FE),A   ; }
 $84BE LD HL,$5800   ; Set the target address to #N$5800 (attribute
                     ; buffer).
 $84C1 LD B,$5B      ; Finish at the end of the attribute buffer (#N$5B00).
 $84C3 LD C,$43      ; Set the fill value to #COLOUR$43.
 $84C5 CALL $84B4    ; Call #R$84B4.
; Paint a black column on each side of the play area.
 $84C8 LD HL,$5800   ; Set the attribute pointer to #N$5800.
 $84CB LD DE,$001F   ; Set the offset to the right-hand column to
                     ; #N($001F,$04,$04).
 $84CE LD BC,$1800   ; Set the row counter to #N$18 and the edge colour to
                     ; #INK$00.
@label=ResetAttributes_Loop
*$84D1 LD (HL),C     ; Write black to the left-hand column.
 $84D2 ADD HL,DE     ; Move to the right-hand column.
 $84D3 LD (HL),C     ; {Write black to the right-hand column and move onto
 $84D4 INC HL        ; the next row.}
 $84D5 DJNZ $84D1    ; Decrease the row counter by one and loop back to
                     ; #R$84D1 until all #N$18 rows are done.
 $84D7 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$80C2 }
; { #COOKIE$74E2 }
; { #JETPAC$71C6 }
; { #PSSST$7447 }
; { #SABREWULF$BB8F }
; { #TRANZAM$7200 }
; LIST#

; Create Game Window
;
; Used by the routines at #R$800A, #R$802C, #R$A826, #R$A8E3 and #R$F535.
; .
; Blanks the screen, draws the banner and writes the
; score line.
;
; .
;
; #PUSHS #UDGTABLE { #SIM(start=$800A,stop=$8024,sp=$5E00)
; #SCR$02(game-window) } UDGTABLE# #POPS
; .
; Blank the screen and write the banner.
@label=CreateWindow
c$84D8 CALL $84BB    ; Call #R$84BB.
 $84DB CALL $84AD    ; Call #R$84AD.
 $84DE CALL $8A37    ; Call #R$8A37.
; Colour the score line #COLOUR$46.
 $84E1 LD HL,$5820   ; Set the attribute pointer to #N$5820.
 $84E4 LD BC,$2046   ; Set the column counter to #N$20 and the colour to
                     ; #COLOUR$46.
@label=CreateWindow_Loop
*$84E7 LD (HL),C     ; Write #COLOUR$46 to the attribute buffer.
 $84E8 INC L         ; Move onto the next column.
 $84E9 DJNZ $84E7    ; Decrease the column counter by one and loop back to
                     ; #R$84E7 until the line is done.
; Display the current 1UP and 2UP levels.
 $84EB CALL $F5EC    ; Call #R$F5EC.
; Write the 1UP, 2UP and HI scores.
 $84EE CALL $89BF    ; Call #R$89BF.
 $84F1 CALL $89C7    ; Call #R$89C7.
 $84F4 JP $89CF      ; Jump to #R$89CF.
; View the equivalent code in;
; #LIST
; { #ATICATAC$80AA }
; { #COOKIE$5FB7 }
; { #JETPAC$608A }
; { #PSSST$5F53 }
; { #TRANZAM$68A0 }
; LIST#

; Reset Planet
;
; Used by the routine at #R$81BB.
; .
; Clears #N($0480,$04,$04) bytes of object RAM from
; #R$6000.
;
; .
;
; Clear #N($0480,$04,$04) bytes of object RAM from #R$6000.
@label=ResetPlanet
c$84F7 LD HL,$6000   ; Set the target address to #R$6000.
 $84FA LD BC,$0480   ; Set the byte counter to #N($0480,$04,$04).
@label=ResetPlanet_Loop
*$84FD LD (HL),$00   ; Write #N$00 to the current object-RAM byte.
 $84FF INC HL        ; Move onto the next byte.
 $8500 DEC BC        ; {Decrease the byte counter by one and loop back to
 $8501 LD A,B        ; #R$84FD until every byte is clear.
 $8502 OR C          ;
 $8503 JR NZ,$84FD   ; }
 $8505 RET           ; Return.

; Calculate Attribute Address
;
; Used by the routines at #R$81AB, #R$8733, #R$890A, #R$8A11, #R$8C01, #R$8C3E,
; #R$8C5F, #R$9E2C, #R$9EDC, #R$A993, #R$B128 and #R$F662.
; .
; Converts a pixel address into the matching attribute
; buffer address.
;
;   HL Pixel address co-ordinates
; O:HL Attribute buffer address
;
; Convert the pixel X/Y in #REGhl into an attribute address.
@label=AttributeAddress
c$8506 PUSH BC       ; Stash #REGbc on the stack.
 $8507 LD A,L        ; Horizontal co-ordinate.
 $8508 RRCA          ; {Divide by #N$08.
 $8509 RRCA          ;
 $850A RRCA          ; }
 $850B AND %00011111 ; Keep only bits 0-4 (#N$00-#N$1F /
                     ; minimum-maximum horizontal screen values).
 $850D LD L,A        ; Store this back in #REGl.
; Merge the vertical co-ordinate into the low byte.
 $850E LD A,H        ; Vertical co-ordinate.
 $850F RLCA          ; {Multiply by #N$04.
 $8510 RLCA          ; }
 $8511 LD C,A        ; Store this in #REGc temporarily.
 $8512 AND %11100000 ; Keep only bits 5-7.
 $8514 OR L          ; Set the bits from #REGl.
 $8515 LD L,A        ; #REGl=#REGa.
; Work out the high byte in the attribute buffer.
 $8516 LD A,C        ; Fetch the stored value from #REGc.
 $8517 AND %00000011 ; Keep only bits 0-1.
 $8519 OR %01011000  ; Set the attribute buffer MSB to #N$58.
 $851B LD H,A        ; Store this back in #REGh.
 $851C POP BC        ; Restore #REGbc from the stack.
 $851D RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9BD2 }
; { #COOKIE$7534 }
; { #JETPAC$720E }
; { #MARTIANOIDS$BD6A }
; { #PSSST$748F }
; { #SABREWULF$B8DD }
; { #TRANZAM$7097 }
; { #UNDERWURLDE$ADE0 }
; LIST#

; Calculate Screen Address
;
; Used by the routines at #R$81AB, #R$86A1, #R$8826, #R$894F, #R$8A11, #R$8AF7,
; #R$8C01, #R$9E2C, #R$A993, #R$F410 and #R$F5EC.
; .
; Converts a pixel address into the matching screen
; buffer address.
;
;   HL Pixel address co-ordinates
; O:HL Screen buffer address
;
; Convert the pixel X/Y in #REGhl into a screen address.
@label=ScreenAddress
c$851E LD A,L        ; Fetch the horizontal co-ordinate.
 $851F RRCA          ; {#REGa=#REGa / #N$08.
 $8520 RRCA          ;
 $8521 RRCA          ; }
 $8522 AND %00011111 ; Keep only bits 0-4.
 $8524 LD L,A        ; #REGl=#REGa.
 $8525 LD A,H        ; #REGa=#REGh.
 $8526 RLCA          ; {#REGa=#REGa * #N$04.
 $8527 RLCA          ; }
 $8528 AND %11100000 ; Keep only bits 5-7.
 $852A OR L          ; Merge in the column bits.
 $852B LD L,A        ; Store this back in #REGl.
; Work out the high byte from the vertical co-ordinate.
 $852C LD A,H        ; Fetch the vertical co-ordinate.
 $852D AND %00000111 ; Keep only bits 0-2.
 $852F EX AF,AF'     ; Switch to the shadow #REGaf register.
 $8530 LD A,H        ; Fetch the vertical co-ordinate.
 $8531 RRCA          ; {Divide by #N$08.
 $8532 RRCA          ;
 $8533 RRCA          ; }
 $8534 AND %00011000 ; Keep only bits 3-4.
 $8536 OR %01000000  ; Set the screen-buffer MSB bit.
 $8538 LD H,A        ; Store this back in #REGh.
 $8539 EX AF,AF'     ; Switch to the shadow #REGaf register.
 $853A OR H          ; Merge in the line bits.
 $853B LD H,A        ; Store this back in #REGh.
 $853C RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9BA2 }
; { #COOKIE$76E3 }
; { #JETPAC$7308 }
; { #MARTIANOIDS$BD4B }
; { #PSSST$759A }
; { #SABREWULF$B8AD }
; { #TRANZAM$6F10 }
; { #UNDERWURLDE$ADF8 }
; LIST#

; Remap Alien Sprite
;
; Used by the routines at #R$8568 and #R$857F.
; .
; On odd levels, #R$8568 and #R$857F pass the sprite ID here
; so four alien families can be drawn from #R$EE7A instead of
; #R$BAC0. Any other ID is returned unchanged, and the caller
; keeps #R$BAC0.
; #TABLE(default,centre,centre,centre)
; { =h Sprite IDs | =h Family | =h #R$EE7A Index }
; { #N$40-#N$47 | Brella | #N$01-#N$08 }
; { #N$48-#N$4F | Blob | #N$09-#N$10 }
; { #N$88-#N$8F | Block | #N$11-#N$18 }
; { #N$B0-#N$B5 | Spinner | #N$19-#N$1E }
; TABLE#
;
;   A Sprite ID
; O:A Sprite ID, or a 1-based index into #R$EE7A
; O:BC #R$EE7A when the ID is one of the remapped families
;
; Test the four odd-level alien ID ranges.
@label=MapSpriteBand
c$853D LD L,A        ; Stash the original sprite ID.
 $853E SUB $40       ; {Drop #N$40 and test for brella IDs #N$40-#N$47.
 $8540 CP $08        ; }
 $8542 LD H,$00      ; {Jump to #R$8560 with table offset #N$00 if it matches.
 $8544 JR C,$8560    ; }
 $8546 SUB $08       ; Drop another #N$08.
 $8548 LD H,$08      ; Set the table offset to #N$08.
 $854A CP $08        ; {Jump to #R$8560 if it is now a blob ID
 $854C JR C,$8560    ; #N$48-#N$4F.}
 $854E SUB $40       ; {Drop #N$40 and test for block IDs #N$88-#N$8F.
 $8550 CP $08        ; }
 $8552 LD H,$10      ; {Jump to #R$8560 with table offset #N$10 if it matches.
 $8554 JR C,$8560    ; }
 $8556 SUB $28       ; {Drop #N$28 and test for spinner IDs #N$B0-#N$B5.
 $8558 CP $06        ; }
 $855A LD H,$18      ; {Jump to #R$8560 with table offset #N$18 if it matches.
 $855C JR C,$8560    ; }
 $855E LD A,L        ; {Return the original sprite ID if no family matched.
 $855F RET           ; }
; Build the #R$EE7A index and return that table pointer.
@label=MapSpriteBand_Matched
*$8560 AND %00000111 ; Keep only the frame within the family.
 $8562 ADD A,H       ; {Add the table offset and make the index 1-based.
 $8563 INC A         ; }
 $8564 LD BC,$EE7A   ; Point #REGbc at #R$EE7A.
 $8567 RET           ; Return.

; Fetch Sprite
;
; Looks up the sprite pointer for the ID in #R$5E53(#N$5E54).
; #R$BAC0 is the default table. On an odd level #R$853D may
; switch the index and table to #R$EE7A. Nothing calls this
; routine; the game uses #R$857F instead.
;
; O:DE Sprite address
@label=FetchSprite
c$8568 LD BC,$BAC0   ; Point the sprite table at #R$BAC0.
 $856B LD A,($5EA2)  ; {Test #R$5EA2.
 $856E AND A         ; }
 $856F LD A,($5E54)  ; Fetch the sprite ID from #R$5E53(#N$5E54).
 $8572 CALL NZ,$853D ; Call #R$853D if this is an odd level.
; This entry point is used by the routine at #R$857F.
; .
; Index the sprite table and return the address.
@label=FetchSprite_Loop
*$8575 DEC A         ; {Fetch the sprite address for index #REGa-#N$01.
 $8576 LD L,A        ;
 $8577 LD H,$00      ;
 $8579 ADD HL,HL     ;
 $857A ADD HL,BC     ;
 $857B LD E,(HL)     ;
 $857C INC HL        ;
 $857D LD D,(HL)     ; }
 $857E RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9E89 }
; { #COOKIE$7623 }
; { #SABREWULF$B928 }
; { #TRANZAM$7155 }
; { #UNDERWURLDE$9646 }
; LIST#

; Fetch Actor Sprite
;
; Used by the routines at #R$86A1, #R$8826, #R$88A3 and #R$8AF7.
; .
; Same lookup as #R$8568, but the index comes from the current
; actor type at *#REGix+#N$00.
;
;   IX Actor slot
; O:DE Sprite address
@label=FetchActorSprite
c$857F LD BC,$BAC0   ; Point the sprite table at #R$BAC0.
 $8582 LD A,($5EA2)  ; {Test #R$5EA2.
 $8585 AND A         ; }
 $8586 LD A,(IX+$00) ; Fetch the actor type from *#REGix+#N$00.
 $8589 CALL NZ,$853D ; Call #R$853D if this is an odd level.
 $858C JR $8575      ; Jump to #R$8575.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9E96 }
; { #SABREWULF$B934 }
; { #UNDERWURLDE$9652 }
; LIST#

; XOR Sprite Loop
;
; Used by the routines at #R$8634, #R$8640 and #R$8701.
; .
; XOR the old sprite (normal registers) and the new sprite
; (shadow registers) onto the screen one row at a time, using
; #REGc as each sprite's row counter. Any rows left in #R$5E5A
; and #R$5E59 are then picked up.
;
; HL Screen address
; DE Graphic pointer
;
; Draw remaining rows from the current graphic pair.
@label=XORSpriteLoop
c$858E LD A,C        ; {Jump to #R$85A2 if the row counter is zero.
 $858F AND A         ;
 $8590 JR Z,$85A2    ; }
 $8592 DEC C         ; {Decrease the row counter and XOR the next row of the old
 $8593 CALL $85CF    ; sprite.}
 $8596 EXX           ; Switch to the shadow registers.
 $8597 LD A,C        ; {Jump to #R$859F if the shadow row counter is zero.
 $8598 AND A         ;
 $8599 JR Z,$859F    ; }
@label=XORSpriteLoop_Loop
*$859B DEC C         ; {Decrease the shadow row counter and XOR the next row of
 $859C CALL $8614    ; the new sprite.}
@label=XORSpriteLoop_NextSide
*$859F EXX           ; {Switch back and loop to #R$858E.
 $85A0 JR $858E      ; }
; No more rows on this side; try the other register set.
@label=XORSpriteLoop_TryShadow
*$85A2 EXX           ; Switch to the shadow registers.
 $85A3 LD A,C        ; {Jump to #R$859B if the shadow row counter is still
 $85A4 AND A         ; live.
 $85A5 JR NZ,$859B   ; }
; This entry point is used by the routine at #R$8701.
; .
; Finish the sprites if either has rows left to draw.
@label=XORSpriteLoop_FinishSprite
*$85A7 EXX           ; Switch back to the normal registers.
; This entry point is used by the routine at #R$8701.
@label=XORSpriteLoop_Write
*$85A8 LD A,($5E5A)  ; {Return if both #R$5E5A and #R$5E59 are zero.
 $85AB LD C,A        ;
 $85AC LD A,($5E59)  ;
 $85AF OR C          ;
 $85B0 RET Z         ; }
 $85B1 XOR A         ; {Write #N$00 to #R$5E5A and switch register sets.
 $85B2 LD ($5E5A),A  ;
 $85B5 EXX           ; }
 $85B6 LD A,($5E59)  ; {Load the remaining row count and clear #REGa.
 $85B9 LD C,A        ;
 $85BA XOR A         ; }
; This entry point is used by the routine at #R$8701.
@label=XORSpriteLoop_NextPair
*$85BB LD ($5E59),A  ; Write the remaining row count to #R$5E59.
 $85BE EXX           ; {Switch back and loop to #R$858E.
 $85BF JR $858E      ; }
; Copy of #R$8606 for the old sprite. The self-modified jump at
; #R$85D7 lands here when the sprite is byte-aligned.
 $85C1 EX DE,HL      ; {XOR the graphic pair onto the screen and move up one
 $85C2 EX (SP),HL    ; pixel.
 $85C3 LD A,D        ;
 $85C4 XOR (HL)      ;
 $85C5 LD (HL),A     ;
 $85C6 INC L         ;
 $85C7 LD A,E        ;
 $85C8 XOR (HL)      ;
 $85C9 LD (HL),A     ;
 $85CA POP DE        ;
 $85CB DEC L         ;
 $85CC JP $85F6      ; }
@label=XORSpriteLoop_LoadPair
*$85CF EX DE,HL      ; {Load the next graphic pair from #REGde.
 $85D0 PUSH DE       ;
 $85D1 LD D,(HL)     ;
 $85D2 INC HL        ;
 $85D3 LD E,(HL)     ;
 $85D4 INC HL        ;
 $85D5 EX DE,HL      ;
 $85D6 XOR A         ; }
@label=XORSpriteLoop_Shift
*$85D7 JR $85D7      ; Self-modifying shift. The operand is written by
                     ; #R$866A.
; View the equivalent code in;
; #LIST
; { #COOKIE$763A }
; { #SABREWULF$B9DA }
; { #UNDERWURLDE$9728 }
; LIST#

; Shift Old Sprite Pair
;
; Copy of #R$8614(#N$861E) for the old sprite. The self-modified jump at
; #R$85D7 lands in this run of shifts, which push the graphic
; pair into pixel alignment before it is XORed onto the screen.
@label=ShiftOldSpritePair
c$85D9 ADD HL,HL     ; {Shift the pair left through #REGa.
 $85DA ADC A,A       ;
 $85DB ADD HL,HL     ;
 $85DC ADC A,A       ;
 $85DD ADD HL,HL     ;
 $85DE ADC A,A       ;
 $85DF ADD HL,HL     ;
 $85E0 ADC A,A       ;
 $85E1 ADD HL,HL     ;
 $85E2 ADC A,A       ;
 $85E3 ADD HL,HL     ;
 $85E4 ADC A,A       ;
 $85E5 ADD HL,HL     ;
 $85E6 ADC A,A       ; }
 $85E7 EX DE,HL      ; Switch the shifted pair into #REGde.
; This entry point is used by the routine at #R$8614.
; .
; XOR three bytes onto the screen, then move up one pixel.
@label=ShiftOldSpritePair_XOR
*$85E8 EX (SP),HL    ; {XOR #REGa, #REGd and #REGe onto the screen at #REGhl and
 $85E9 XOR (HL)      ; restore the graphic pointer.
 $85EA LD (HL),A     ;
 $85EB INC L         ;
 $85EC LD A,D        ;
 $85ED XOR (HL)      ;
 $85EE LD (HL),A     ;
 $85EF INC L         ;
 $85F0 LD A,E        ;
 $85F1 XOR (HL)      ;
 $85F2 LD (HL),A     ;
 $85F3 POP DE        ;
 $85F4 DEC L         ;
 $85F5 DEC L         ; }

; Screen Address One Pixel Above
;
; Used by the routines at #R$858E, #R$8606, #R$87B9, #R$8BA5 and #R$A993.
; .
; Moves a screen address up one pixel, wrapping through the
; Spectrum display layout.
;
;   HL Current position
; O:HL Address for new position
;
; Move the screen address up one pixel, wrapping the row.
@label=ScreenPosition1PixelAbove
c$85F6 DEC H         ; Move up one pixel.
 $85F7 LD A,H        ; {Invert the new line byte.
 $85F8 CPL           ; }
 $85F9 AND %00000111 ; Keep only bits 0-2.
 $85FB RET NZ        ; Return if a character-row boundary was not crossed.
 $85FC LD A,L        ; {Subtract #N$20 from the column address.
 $85FD SUB $20       ;
 $85FF LD L,A        ; }
 $8600 RET C         ; Return if that wrapped into the previous third.
 $8601 LD A,H        ; {Add #N$08 to the line byte.
 $8602 ADD A,$08     ;
 $8604 LD H,A        ; }
 $8605 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9F03 }
; { #CYBERUN$A1C3 }
; { #PSSST$7585 }
; { #TRANZAM$6ECB }
; { #UNDERWURLDE$AE71 }
; LIST#

; XOR Sprite Pair Up
;
; XOR a 16-bit graphic pair onto the screen, then move up one
; pixel via #R$85F6.
;
; HL Screen address
@label=XORSpritePairUp
c$8606 EX DE,HL      ; {XOR the graphic pair onto the screen at #REGhl.
 $8607 EX (SP),HL    ;
 $8608 LD A,D        ;
 $8609 XOR (HL)      ;
 $860A LD (HL),A     ;
 $860B INC L         ;
 $860C LD A,E        ;
 $860D XOR (HL)      ;
 $860E LD (HL),A     ;
 $860F POP DE        ;
 $8610 DEC L         ; }
 $8611 JP $85F6      ; Jump to #R$85F6.

; Prepare Sprite Write
;
; Used by the routine at #R$858E.
; .
; Shift the next graphic pair of the new sprite and XOR it onto
; the screen, moving up one pixel. #R$862F positions the actor and then
; continues at #R$8637.
;
; DE Graphic pointer
;
; Shift the next graphic pair into place and XOR it onto the screen.
@label=PrepareSpriteWrite
c$8614 EX DE,HL      ; {Load the next graphic pair from #REGde.
 $8615 PUSH DE       ;
 $8616 LD D,(HL)     ;
 $8617 INC HL        ;
 $8618 LD E,(HL)     ;
 $8619 INC HL        ;
 $861A EX DE,HL      ;
 $861B XOR A         ; }
@label=PrepareSpriteWrite_ShiftPair
*$861C JR $861C      ; Self-modifying shift. The operand is written by
                     ; #R$86D3.
 $861E ADD HL,HL     ; {Rotate the pair into pixel alignment.
 $861F ADC A,A       ;
 $8620 ADD HL,HL     ;
 $8621 ADC A,A       ;
 $8622 ADD HL,HL     ;
 $8623 ADC A,A       ;
 $8624 ADD HL,HL     ;
 $8625 ADC A,A       ;
 $8626 ADD HL,HL     ;
 $8627 ADC A,A       ;
 $8628 ADD HL,HL     ;
 $8629 ADC A,A       ;
 $862A ADD HL,HL     ;
 $862B ADC A,A       ; }
 $862C EX DE,HL      ; {Switch the pair back and jump to #R$85E8.
 $862D JR $85E8      ; }
 $862F CALL $86C2    ; {Apply the actor position, then continue at #R$8637.
 $8632 JR $8637      ; }

; Position And Draw Sprite
;
; Used by the routines at #R$8D06 and #R$91E2.
; .
; Position the actor's sprite with #R$86A1, clear the remaining row
; count and start the draw through #R$858E.
;
; IX Actor slot
;
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After #R$8634 | =h After #R$8733 }
; { #SIM(start=$800A,stop=$8024,sp=$5E00)
; #SIM(start=$81BB,stop=$81D6,sp=$5E00)
; #SCR$03,$0B,$11,$0A,$06(position-draw-before)
; | #SIM(start=$8E53,stop=$8E56,ix=$6078,sp=$5E00)
; #SCR$03,$0B,$11,$0A,$06(position-draw-drawn)
; | #SIM(start=$8733,stop=$0000,ix=$6078,sp=$5E00)
; #SCR$03,$0B,$11,$0A,$06(position-draw-coloured) } UDGTABLE# #POPS
@label=PositionAndDrawSprite
c$8634 CALL $86A1    ; Call #R$86A1.
; This entry point is used by the routine at #R$8614.
@label=PositionAndDrawSprite_ClearWidth
*$8637 EXX           ; {Switch register sets, then write #N$00 to #R$5E5A and the
 $8638 XOR A         ; row counter.
 $8639 LD ($5E5A),A  ;
 $863C LD C,A        ; }
 $863D JP $858E      ; Jump to #R$858E.
; View the equivalent code in;
; #LIST
; { #UNDERWURLDE$962A }
; LIST#

; Draw Cached Sprite
;
; Used by the routines at #R$A299, #R$A783, #R$ADEA, #R$B065, #R$B1A4 and
; #R$B460.
; .
; Clear the scratch counts, load the actor's cached sprite with
; #R$865E and start the draw through #R$858E.
;
; IX Actor slot
;
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before #R$8640 | =h After #R$8640 }
; { #SIM(start=$800A,stop=$8024,sp=$5E00)
; #SIM(start=$81BB,stop=$81D6,sp=$5E00)
; #SIM(start=$8DD9,stop=$8DDC,ix=$6078,sp=$5E00)
; #SIM(start=$8DDC,stop=$8DDF,ix=$6078,sp=$5E00)
; #SCR$03,$0B,$11,$0A,$06(cached-drawn)
; | #SIM(start=$B4BA,stop=$B4BD,ix=$6078,sp=$5E00)
; #SCR$03,$0B,$11,$0A,$06(cached-erased) } UDGTABLE# #POPS
; .
; The cached image of the sprite is XORed off the screen, so the
; pixels of the sprite disappear.
@label=DrawCachedSprite
c$8640 XOR A         ; {Write #N$00 to #R$5E59, #R$5E58 and the row
 $8641 LD ($5E59),A  ; counter.
 $8644 LD ($5E58),A  ;
 $8647 LD C,A        ; }
 $8648 EXX           ; Switch to the shadow registers.
 $8649 CALL $865E    ; Call #R$865E.
 $864C JP $858E      ; Jump to #R$858E.

; Clear Sprite Scratch
;
; Used by the routines at #R$AD59 and #R$B3E8.
; .
; Zero #R$5E59 and #R$5E58, then XOR the actor's cached sprite
; onto the screen again (erasing it) through #R$87B9.
;
; IX Actor slot
;
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before #R$864F | =h After #R$864F }
; { #SIM(start=$800A,stop=$8024,sp=$5E00)
; #SIM(start=$81BB,stop=$81D6,sp=$5E00)
; #SIM(start=$9EEB,stop=$9EEE,ix=$6090,sp=$5E00)
; #SIM(start=$8733,stop=$0000,ix=$6090,sp=$5E00)
; #SCR$03,$04,$11,$0A,$06(scratch-drawn)
; | #SIM(start=$B441,stop=$B444,ix=$6090,sp=$5E00)
; #SCR$03,$04,$11,$0A,$06(scratch-erased) } UDGTABLE# #POPS
; .
; The cached image of the sprite is XORed off the screen, so the
; pixels of the sprite disappear.
@label=ClearSpriteScratch
c$864F XOR A         ; {Write #N$00 to #LIST { #R$5E59 } { #R$5E58 } LIST#
 $8650 LD ($5E59),A  ;
 $8653 LD ($5E58),A  ; }
 $8656 LD C,A        ; {Clear the row counter and switch register sets.
 $8657 EXX           ; }
 $8658 CALL $88E8    ; Call #R$88E8.
 $865B JP $87B9      ; Jump to #R$87B9.

; Load Sprite Scratch
;
; Used by the routines at #R$8640 and #R$8701.
; .
; Copy the current actor's cached sprite fields into the draw
; workspace.
;
; IX Actor slot
@label=LoadSpriteScratch
c$865E LD E,(IX+$0C) ; {Fetch the cached graphic pointer.
 $8661 LD D,(IX+$0D) ; }
 $8664 LD L,(IX+$0E) ; {Fetch the cached screen address.
 $8667 LD H,(IX+$0F) ; }
 $866A LD A,(IX+$09) ; {Write the cached shift to #R$85D7(#N$85D8).
 $866D LD ($85D8),A  ; }
 $8670 LD A,(IX+$0A) ; {Write the cached height (row count) to #R$5E5A.
 $8673 LD ($5E5A),A  ; }
 $8676 LD A,(IX+$0B) ; {Write the cached Y position to #R$5E56.
 $8679 LD ($5E56),A  ; }
 $867C LD C,$00      ; Clear the row counter.
 $867E RET           ; Return.

; Reset Sprite Fields
;
; Used by the routines at #R$86A1 and #R$8AF7.
; .
; Clear the cached sprite bytes on the actor and the draw
; workspace.
;
; IX Actor slot
@label=ResetSpriteFields
c$867F XOR A         ; {Write #N$00 to;
 $8680 LD (IX+$09),A ; #LIST
 $8683 LD (IX+$0A),A ; { #REGix+#N$09 }
 $8686 LD (IX+$0B),A ; { #REGix+#N$0A }
 $8689 LD (IX+$0C),A ; { #REGix+#N$0B }
 $868C LD (IX+$0D),A ; { #REGix+#N$0C }
 $868F LD (IX+$0E),A ; { #REGix+#N$0D }
 $8692 LD (IX+$0F),A ; { #REGix+#N$0E }
 $8695 LD ($5E59),A  ; { #REGix+#N$0F }
 $8698 LD ($5E57),A  ; { #R$5E59 }
 $869B LD ($5E58),A  ; { #R$5E57 }
                     ; { #R$5E58 }
                     ; LIST#}
 $869E LD C,$00      ; Clear the row counter.
 $86A0 RET           ; Return.

; Position Sprite
;
; Used by the routines at #R$8634, #R$8701 and #R$8A5C.
; .
; Convert the actor's world position into a screen column
; relative to #R$607A, then fetch its sprite.
;
; IX Actor slot
;
; Convert the actor world X into a screen column.
@label=PositionSprite
c$86A1 LD L,(IX+$02) ; {Fetch the actor's world X position.
 $86A4 LD H,(IX+$03) ; }
 $86A7 LD BC,$0078   ; {Add the #N($0078,$04,$04) draw offset.
 $86AA ADD HL,BC     ; }
 $86AB LD BC,($607A) ; Fetch the scroll position from #R$607A.
 $86AF AND A         ; {Subtract the scroll position.
 $86B0 SBC HL,BC     ; }
 $86B2 LD A,H        ; Fetch the high byte of the screen column.
 $86B3 AND %00011111 ; Keep only bits 0-4.
 $86B5 JR NZ,$867F   ; Jump to #R$867F if the actor is off-screen.
 $86B7 LD A,L        ; {Jump to #R$867F if the column is at least #N$F0.
 $86B8 CP $F0        ;
 $86BA JR NC,$867F   ; }
; Store the column and look up the actor sprite.
 $86BC LD (IX+$01),L ; Store the screen column in *#REGix+#N$01.
 $86BF CALL $857F    ; Call #R$857F.
; This entry point is used by the routine at #R$8614.
; .
; Build the pixel-shift index from the column.
@label=PositionSprite_Apply
*$86C2 LD L,(IX+$01) ; {Fetch the screen column and actor Y.
 $86C5 LD H,(IX+$04) ; }
 $86C8 LD A,L        ; {Build a pixel-shift index from the column.
 $86C9 DEC A         ;
 $86CA RLCA          ; }
 $86CB AND %00001110 ; Keep only bits 1-3.
 $86CD CP $0E        ; {Jump to #R$86D3 if the shift is not #N$0E.
 $86CF JR NZ,$86D3   ; }
 $86D1 LD A,$E8      ; Set the shift operand to #N$E8.
; Store the pixel shift for the sprite drawing code.
@label=PositionSprite_StoreShift
*$86D3 LD ($861D),A  ; {Write the shift to #R$861C(#N$861D) and
 $86D6 LD (IX+$09),A ; *#REGix+#N$09.}
; Choose the scratch width from the shift.
 $86D9 LD A,$02      ; Set the scratch width to #N$02.
 $86DB JR Z,$86DE    ; Jump to #R$86DE if the shift was #N$0E.
 $86DD INC A         ; Widen the scratch width to #N$03.
@label=PositionSprite_StoreWidth
*$86DE LD ($5E57),A  ; {Write the scratch width and cache the actor Y.
 $86E1 LD (IX+$0B),H ; }
; Work out the screen address, then cache the sprite details on
; the actor.
 $86E4 CALL $851E    ; Call #R$851E.
 $86E7 LD A,(DE)     ; {Copy the sprite height into #R$5E59, #R$5E58 and
 $86E8 INC DE        ; *#REGix+#N$0A.
 $86E9 LD ($5E59),A  ;
 $86EC LD ($5E58),A  ;
 $86EF LD (IX+$0A),A ; }
 $86F2 LD (IX+$0C),E ; {Cache the graphic pointer and screen address on the
 $86F5 LD (IX+$0D),D ; actor.
 $86F8 LD (IX+$0E),L ;
 $86FB LD (IX+$0F),H ; }
 $86FE LD C,$00      ; Clear the row counter.
 $8700 RET           ; Return.

; Draw Sprite
;
; Used by the routines at #R$8D06, #R$93A6, #R$93E8, #R$9531, #R$ABA9 and
; #R$B128.
; .
; Load the actor's cached (old) sprite, work out the new sprite
; position, and XOR both onto the screen through #R$858E.
;
; IX Actor slot
;
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After #R$8701 | =h After #R$8733 }
; { #SIM(start=$800A,stop=$8024,sp=$5E00)
; #SIM(start=$81BB,stop=$81D6,sp=$5E00)
; #SCR$03,$0B,$11,$0A,$06(jetman-before)
; | #SIM(start=$8DD9,stop=$8DDC,ix=$6078,sp=$5E00)
; #SCR$03,$0B,$11,$0A,$06(jetman-drawn)
; | #SIM(start=$8DDC,stop=$8DDF,ix=$6078,sp=$5E00)
; #SCR$03,$0B,$11,$0A,$06(jetman-coloured) } UDGTABLE# #POPS
; .
; Load the cached sprite, then XOR it onto the screen.
@label=DrawSprite
c$8701 CALL $865E    ; Call #R$865E.
 $8704 EXX           ; Switch to the shadow registers.
 $8705 CALL $86A1    ; Call #R$86A1.
 $8708 EXX           ; Switch back to the normal registers.
; Compare the cached Y position with the actor Y.
 $8709 LD A,($5E56)  ; {Subtract the actor Y from #R$5E56.
 $870C SUB (IX+$04)  ; }
 $870F JP Z,$85A8    ; Jump to #R$85A8 if they match.
 $8712 JP M,$8724    ; Jump to #R$8724 if the actor has moved down (the result
                     ; is negative).
 $8715 LD C,A        ; Store the row difference in the row counter.
 $8716 LD A,($5E5A)  ; {Jump to #R$85A8 if the difference is taller than the old
 $8719 CP C          ; sprite's rows in #R$5E5A.
 $871A JP C,$85A8    ; }
 $871D SUB C         ; {Subtract it from #R$5E5A and jump to #R$858E.
 $871E LD ($5E5A),A  ;
 $8721 JP $858E      ; }
@label=DrawSprite_ActorMovedDown
*$8724 EXX           ; {Switch register sets and negate the row difference.
 $8725 NEG           ;
 $8727 LD C,A        ; }
 $8728 LD A,($5E59)  ; {Jump to #R$85A7 if the difference is taller than the new
 $872B CP C          ; sprite's rows in #R$5E59.
 $872C JP C,$85A7    ; }
 $872F SUB C         ; {Subtract it from the row count and jump to
 $8730 JP $85BB      ; #R$85BB.}

; Colourise Sprite
;
; Used by the routines at #R$8D06, #R$93A6, #R$93E8, #R$9531, #R$9BBB, #R$9EDC,
; #R$A579, #R$A742, #R$A81C, #R$ABA9, #R$AD59, #R$B218 and #R$B3E8.
; .
; Write the actor's attribute bytes into the buffer using
; #R$8506.
;
; IX Actor slot
;
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After #R$8701 | =h After #R$8733 }
; { #SIM(start=$800A,stop=$8024,sp=$5E00)
; #SIM(start=$81BB,stop=$81D6,sp=$5E00)
; #SCR$03,$0B,$11,$0A,$06(jetman-before)
; | #SIM(start=$8DD9,stop=$8DDC,ix=$6078,sp=$5E00)
; #SCR$03,$0B,$11,$0A,$06(jetman-drawn)
; | #SIM(start=$8DDC,stop=$8DDF,ix=$6078,sp=$5E00)
; #SCR$03,$0B,$11,$0A,$06(jetman-coloured) } UDGTABLE# #POPS
; .
; Write the actor colour into the attribute rectangle.
@label=ColouriseSprite
c$8733 LD L,(IX+$01) ; {Fetch the screen column and actor Y.
 $8736 LD H,(IX+$04) ; }
 $8739 LD D,(IX+$07) ; Fetch the actor colour from *#REGix+#N$07.
 $873C LD A,($5E57)  ; {Return if #R$5E57 is zero.
 $873F AND A         ;
 $8740 RET Z         ; }
 $8741 LD B,A        ; Set the column counter from #R$5E57.
 $8742 CALL $8506    ; Call #R$8506.
 $8745 LD A,($5E58)  ; {Turn #R$5E58 into an attribute-row count.
 $8748 RRCA          ;
 $8749 RRCA          ;
 $874A INC A         ;
 $874B RRCA          ; }
 $874C AND %00011111 ; Keep only bits 0-4.
 $874E INC A         ; {Store the row count.
 $874F LD C,A        ; }
; This entry point is used by the routine at #R$B128.
; .
; Paint one attribute row, then step up to the next.
@label=ColouriseSprite_Loop
*$8750 PUSH BC       ; {Stash the counters and attribute address.
 $8751 PUSH HL       ; }
 $8752 LD A,H        ; {Jump to #R$8770 if the address is below #N$5800.
 $8753 CP $58        ;
 $8755 JR C,$8770    ; }
 $8757 PUSH BC       ; {Skip this row if the address is at or past
 $8758 PUSH HL       ; #N$5AC0.
 $8759 LD BC,$5AC0   ;
 $875C AND A         ;
 $875D SBC HL,BC     ;
 $875F POP HL        ;
 $8760 POP BC        ;
 $8761 JR NC,$8770   ; }
; Write the actor colour along the row, skipping empty
; attributes.
@label=ColouriseSprite_WriteInk
*$8763 LD A,(HL)     ; {Jump to #R$8768 if this attribute is empty.
 $8764 AND A         ;
 $8765 JR Z,$8768    ; }
 $8767 LD (HL),D     ; Write the actor colour.
@label=ColouriseSprite_NextColumn
*$8768 INC L         ; {Move onto the next attribute column.
 $8769 LD A,L        ; }
 $876A AND %00011111 ; Keep only bits 0-4.
 $876C JR Z,$8770    ; {Jump to #R$8770 if the row wrapped, else loop back
 $876E DJNZ $8763    ; to #R$8763.}
; Step up one attribute row and repeat until every row is
; painted.
@label=ColouriseSprite_NextRow
*$8770 POP HL        ; Restore the start of this attribute row.
 $8771 LD BC,$0020   ; {Move up one attribute row.
 $8774 AND A         ;
 $8775 SBC HL,BC     ;
 $8777 POP BC        ; }
 $8778 DEC C         ; {Decrease the row counter and loop back to #R$8750
 $8779 JR NZ,$8750   ; until every row is painted.}
 $877B RET           ; Return.
; View the equivalent code in;
; #LIST
; { #JETPAC$71CF }
; { #PSSST$7450 }
; { #TRANZAM$704B }
; LIST#

; Draw Sprite Pair
;
; Used by the routine at #R$91E2.
; .
; Reload the actor graphic and XOR it via #R$88A3.
;
; IX Actor slot
;
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After #R$8787 | =h After #R$877C | =h After #R$890A }
; { #SIM(start=$800A,stop=$8024,sp=$5E00)
; #SIM(start=$81BB,stop=$81D6,sp=$5E00)
; #SCR$03,$04,$11,$0A,$06(pair-before)
; | #SIM(start=$9EEB,stop=$9EEE,ix=$6090,sp=$5E00)
; #SCR$03,$04,$11,$0A,$06(pair-drawn)
; | #SIM(start=$9267,stop=$926A,ix=$6090,sp=$5E00)
; #SCR$03,$04,$11,$0A,$06(pair-redrawn)
; | #SIM(start=$927A,stop=$9280,ix=$6090,sp=$5E00)
; #SCR$03,$04,$11,$0A,$06(pair-coloured) } UDGTABLE# #POPS
@label=DrawSpritePair
c$877C CALL $88E8    ; Call #R$88E8.
 $877F EXX           ; Switch to the shadow registers.
 $8780 CALL $88A3    ; Call #R$88A3.
 $8783 EXX           ; Switch back to the normal registers.
 $8784 JP $878F      ; Jump to #R$878F.

; Draw Actor Sprite
;
; Used by the routines at #R$9ECA, #R$9EDC, #R$AD59 and #R$B3E8.
; .
; Reload the actor graphic and XOR it via #R$8826.
;
; IX Actor slot
;
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After #R$8787 | =h After #R$8733 }
; { #SIM(start=$800A,stop=$8024,sp=$5E00)
; #SIM(start=$81BB,stop=$81D6,sp=$5E00)
; #SCR$03,$04,$11,$0A,$06(rover-before)
; | #SIM(start=$9EEB,stop=$9EEE,ix=$6090,sp=$5E00)
; #SCR$03,$04,$11,$0A,$06(rover-drawn)
; | #SIM(start=$8733,stop=$0000,ix=$6090,sp=$5E00)
; #SCR$03,$04,$11,$0A,$06(rover-coloured) } UDGTABLE# #POPS
; .
; Reload the actor graphic and XOR it via #R$8826.
@label=DrawActorSprite
c$8787 CALL $88E8    ; Call #R$88E8.
 $878A EXX           ; Switch to the shadow registers.
 $878B CALL $8826    ; Call #R$8826.
 $878E EXX           ; Switch back to the normal registers.
; This entry point is used by the routine at #R$877C.
; .
; Compare the cached screen MSB with the actor Y.
@label=DrawActorSprite_Fetch
*$878F LD A,($5E56)  ; {Subtract the actor Y from #R$5E56.
 $8792 SUB (IX+$04)  ; }
 $8795 JP Z,$880D    ; Jump to #R$880D if they match.
 $8798 JP M,$87AA    ; Jump to #R$87AA if the result is negative.
 $879B LD C,A        ; Store the row difference in the row counter.
 $879C LD A,($5E5A)  ; {Jump to #R$880D if the difference is taller than the old
 $879F CP C          ; sprite's rows in #R$5E5A.
 $87A0 JP C,$880D    ; }
 $87A3 SUB C         ; {Subtract it from #R$5E5A and jump to #R$87B9.
 $87A4 LD ($5E5A),A  ;
 $87A7 JP $87B9      ; }
@label=DrawActorSprite_Draw
*$87AA EXX           ; {Switch register sets and negate the row difference.
 $87AB NEG           ;
 $87AD LD C,A        ; }
 $87AE LD A,($5E59)  ; {Jump to #R$880C if the difference is taller than the new
 $87B1 CP C          ; sprite's rows in #R$5E59.
 $87B2 JP C,$880C    ; }
 $87B5 SUB C         ; {Subtract it from the row count and jump to
 $87B6 JP $8820      ; #R$8820.}

; Write Sprite Row
;
; Used by the routines at #R$864F, #R$8787 and #R$8807.
; .
; XOR one graphic row from #REGde onto the screen at #REGhl.
;
; HL Screen address
; DE Graphic pointer
;
; XOR one graphic row from #REGde onto the screen at #REGhl.
@label=WriteSpriteRow
c$87B9 LD A,C        ; {Jump to #R$8807 if the row counter is zero.
 $87BA AND A         ;
 $87BB JR Z,$8807    ; }
 $87BD DEC C         ; Decrease the row counter by one.
 $87BE PUSH BC       ; {Stash the counters and screen address.
 $87BF PUSH HL       ; }
@label=WriteSpriteRow_Loop
*$87C0 LD A,(DE)     ; {XOR the next graphic byte onto the screen.
 $87C1 INC DE        ;
 $87C2 XOR (HL)      ;
 $87C3 LD (HL),A     ; }
 $87C4 INC L         ; {Move to the next column and loop back to #R$87C0.
 $87C5 DJNZ $87C0    ; }
; Skip the unused graphic bytes, then step up one pixel line.
@label=WriteSpriteRow_SkipRest
*$87C7 JR $87C7      ; Self-modifying skip. The operand is written by
                     ; #R$88F8.
 $87C9 INC DE        ; {Skip the remaining bytes of this graphic row.
 $87CA INC DE        ;
 $87CB INC DE        ;
 $87CC INC DE        ;
 $87CD INC DE        ;
 $87CE INC DE        ;
 $87CF INC DE        ;
 $87D0 INC DE        ;
 $87D1 INC DE        ;
 $87D2 INC DE        ;
 $87D3 INC DE        ;
 $87D4 INC DE        ;
 $87D5 INC DE        ;
 $87D6 INC DE        ;
 $87D7 INC DE        ;
 $87D8 INC DE        ; }
 $87D9 POP HL        ; Restore the screen address from the stack.
 $87DA CALL $85F6    ; Call #R$85F6.
 $87DD POP BC        ; Restore the counters from the stack.
; Switch to the other sprite and write its next row if
; it has rows left.
 $87DE EXX           ; {Jump to #R$8804 if the shadow row counter is zero.
 $87DF LD A,C        ;
 $87E0 AND A         ;
 $87E1 JR Z,$8804    ; }
; This entry point is used by the routine at #R$8807.
@label=WriteSpriteRow_DecreaseShadow
*$87E3 DEC C         ; Decrease the shadow row counter.
 $87E4 PUSH BC       ; {Stash the counters and the screen address on the
 $87E5 PUSH HL       ; stack.}
@label=WriteSpriteRow_XORByte
*$87E6 LD A,(DE)     ; {XOR the next graphic byte onto the screen.
 $87E7 INC DE        ;
 $87E8 XOR (HL)      ;
 $87E9 LD (HL),A     ; }
 $87EA INC L         ; {Move to the next column and loop back to #R$87E6.
 $87EB DJNZ $87E6    ; }
; Skip the unused graphic bytes, then step up one pixel line.
@label=WriteSpriteRow_SkipGraphic
*$87ED JR $87ED      ; Self-modifying skip. The operand is written by
                     ; #R$8850 and #R$88C6.
 $87EF INC DE        ; {Skip the remaining bytes of this graphic row.
 $87F0 INC DE        ;
 $87F1 INC DE        ;
 $87F2 INC DE        ;
 $87F3 INC DE        ;
 $87F4 INC DE        ;
 $87F5 INC DE        ;
 $87F6 INC DE        ;
 $87F7 INC DE        ;
 $87F8 INC DE        ;
 $87F9 INC DE        ;
 $87FA INC DE        ;
 $87FB INC DE        ;
 $87FC INC DE        ;
 $87FD INC DE        ;
 $87FE INC DE        ; }
 $87FF POP HL        ; Restore the screen address from the stack.
 $8800 CALL $85F6    ; Call #R$85F6.
 $8803 POP BC        ; Restore the counters from the stack.
@label=WriteSpriteRow_NextSide
*$8804 EXX           ; {Switch back and loop to #R$87B9.
 $8805 JR $87B9      ; }

; Continue Sprite Write
;
; Used by the routine at #R$87B9.
; .
; Switch to the shadow registers and keep XOR-ing the current
; sprite.
@label=ContinueSpriteWrite
c$8807 EXX           ; {Jump to #R$87E3 if the shadow row counter
 $8808 LD A,C        ; is live.
 $8809 AND A         ;
 $880A JR NZ,$87E3   ; }
; This entry point is used by the routine at #R$8787.
@label=ContinueSpriteWrite_Next
*$880C EXX           ; Switch back to the normal registers.
; This entry point is used by the routine at #R$8787.
@label=ContinueSpriteWrite_Row
*$880D LD A,($5E5A)  ; {Return if both #R$5E5A and #R$5E59 are zero.
 $8810 LD C,A        ;
 $8811 LD A,($5E59)  ;
 $8814 OR C          ;
 $8815 RET Z         ; }
 $8816 XOR A         ; {Write #N$00 to #R$5E5A and switch register sets.
 $8817 LD ($5E5A),A  ;
 $881A EXX           ; }
 $881B LD A,($5E59)  ; {Load the remaining row count and clear #REGa.
 $881E LD C,A        ;
 $881F XOR A         ; }
; This entry point is used by the routine at #R$8787.
@label=ContinueSpriteWrite_Done
*$8820 LD ($5E59),A  ; Write the remaining row count to #R$5E59.
 $8823 EXX           ; {Switch back and loop to #R$87B9.
 $8824 JR $87B9      ; }

; Fetch And Draw
;
; Used by the routine at #R$8787.
; .
; Look up the actor sprite, clip it against the left and right
; screen edges, and cache its graphic pointer and screen address on
; the actor.
;
; IX Actor slot
;
; Look up the actor sprite and test whether it is on-screen.
@label=FetchAndDraw
c$8826 CALL $857F    ; Call #R$857F.
 $8829 LD L,(IX+$02) ; {Fetch the actor's world X position.
 $882C LD H,(IX+$03) ; }
 $882F LD BC,($607A) ; {Subtract the scroll position at #R$607A.
 $8833 AND A         ;
 $8834 SBC HL,BC     ; }
 $8836 LD BC,$0068   ; {Add the #N($0068,$04,$04) draw offset.
 $8839 ADD HL,BC     ; }
 $883A LD A,H        ; Fetch the high byte of the screen column.
 $883B AND %00011111 ; Keep only bits 0-4.
 $883D JR Z,$88B1    ; Jump to #R$88B1 if the actor is on-screen.
 $883F ADD A,$E1     ; {Jump to #R$8891 if the column is not #N$1F.
 $8841 JR NZ,$8891   ; }
; Clip a sprite that straddles the left edge.
 $8843 LD A,L        ; {Arithmetic-shift the column down by three.
 $8844 SRA A         ;
 $8846 SRA A         ;
 $8848 SRA A         ; }
 $884A JP P,$8891    ; Jump to #R$8891 if the result is positive.
 $884D LD B,A        ; Store the shifted column.
 $884E AND %00001111 ; Keep only bits 0-3.
 $8850 LD ($87EE),A  ; {Write the skip to #R$87ED(#N$87EE) and
 $8853 LD (IX+$09),A ; *#REGix+#N$09.}
; Work out how much of the sprite width is visible and
; cache the visible width and height.
 $8856 LD A,(DE)     ; {Fetch the sprite width and add the shifted column.
 $8857 INC DE        ;
 $8858 LD C,A        ;
 $8859 ADD A,B       ; }
 $885A JP M,$8891    ; {Jump to #R$8891 if that sum is zero or negative.
 $885D JR Z,$8891    ; }
 $885F LD B,A        ; Copy the visible width into #REGb.
 $8860 LD ($5E57),A  ; {Write the visible width to #R$5E57 and
 $8863 LD (IX+$0B),A ; *#REGix+#N$0B.}
 $8866 LD A,(DE)     ; {Copy the next header byte into #R$5E59, #R$5E58
 $8867 INC DE        ; and *#REGix+#N$0A.
 $8868 LD ($5E59),A  ;
 $886B LD ($5E58),A  ;
 $886E LD (IX+$0A),A ; }
; Skip the graphic bytes hidden off the left edge.
 $8871 LD A,C        ; {#REGa=width-visible width (the bytes hidden on the
 $8872 SUB B         ; left).}
@label=FetchAndDraw_Loop
*$8873 INC DE        ; {Skip graphic bytes until the visible strip starts.
 $8874 DEC A         ;
 $8875 JR NZ,$8873   ; }
 $8877 LD L,$00      ; Set the screen column to #N$00.
; This entry point is used by the routines at #R$8891 and #R$88B1.
; .
; Cache the visible strip and draw it.
@label=FetchAndDraw_StoreColumn
*$8879 LD (IX+$01),L ; Store the screen column.
 $887C LD H,(IX+$04) ; Fetch the actor Y.
 $887F CALL $851E    ; Call #R$851E.
 $8882 LD (IX+$0C),E ; {Cache the graphic pointer and screen address on the
 $8885 LD (IX+$0D),D ; actor.
 $8888 LD (IX+$0E),L ;
 $888B LD (IX+$0F),H ; }
 $888E LD C,$00      ; Clear the row counter.
 $8890 RET           ; Return.

; Clear Sprite Cache
;
; Used by the routine at #R$8826.
; .
; Zero the remaining sprite workspace and the actor's cached
; width/height.
;
; IX Actor slot
@label=ClearSpriteCache
c$8891 XOR A         ; {Write #N$00 to:
 $8892 LD ($5E59),A  ; #LIST
 $8895 LD ($5E58),A  ; { #R$5E59 }
 $8898 LD (IX+$0A),A ; { #R$5E58 }
 $889B LD ($5E57),A  ; { #REGix+#N$0A }
 $889E LD (IX+$0B),A ; { #R$5E57 }
                     ; { #REGix+#N$0B }
                     ; LIST#}
 $88A1 JR $8879      ; Jump to #R$8879.

; Fetch Sprite Size
;
; Used by the routine at #R$877C.
; .
; Look up the actor sprite and take its width from the first
; graphic byte.
;
; IX Actor slot
;
; Look up the actor sprite and take its width from the header.
@label=FetchSpriteSize
c$88A3 CALL $857F    ; Call #R$857F.
 $88A6 LD L,(IX+$01) ; {Fetch the screen column and actor Y.
 $88A9 LD H,(IX+$04) ; }
 $88AC LD A,(DE)     ; {Fetch the sprite width and move past the header.
 $88AD INC DE        ;
 $88AE LD B,A        ; }
 $88AF JR $88E2      ; Jump to #R$88E2.

; Read Sprite Header
;
; Used by the routine at #R$8826.
; .
; Fetch the width byte from the graphic and rotate it into a
; pixel count.
;
; DE Graphic pointer
;
; Read the sprite width and rotate it into a pixel count.
@label=ReadSpriteHeader
c$88B1 LD A,(DE)     ; {Fetch the sprite width and move past the header.
 $88B2 INC DE        ;
 $88B3 LD B,A        ; }
 $88B4 RLCA          ; {Rotate the width into a pixel count.
 $88B5 RLCA          ;
 $88B6 RLCA          ; }
 $88B7 AND %11111000 ; Keep only bits 3-7.
 $88B9 ADD A,L       ; {Jump to #R$88E2 if adding the column does not wrap.
 $88BA JR NC,$88E2   ; }
 $88BC RRCA          ; {Rotate the overflow back to a nibble.
 $88BD RRCA          ;
 $88BE RRCA          ; }
 $88BF AND %00001111 ; Keep only bits 0-3.
 $88C1 LD C,A        ; {Store the overflow and turn it into a right-hand
 $88C2 NEG           ; skip.
 $88C4 ADD A,$10     ; }
; Store the skip and visible width, then copy the
; height into the draw workspace.
@label=ReadSpriteHeader_Loop
*$88C6 LD ($87EE),A  ; {Write the skip to #R$87ED(#N$87EE) and
 $88C9 LD (IX+$09),A ; *#REGix+#N$09.}
 $88CC LD A,B        ; {Write the visible width to #R$5E57 and
 $88CD SUB C         ; *#REGix+#N$0B.
 $88CE LD B,A        ;
 $88CF LD ($5E57),A  ;
 $88D2 LD (IX+$0B),A ; }
 $88D5 LD A,(DE)     ; {Copy the next header byte into #R$5E58, #R$5E59
 $88D6 INC DE        ; and *#REGix+#N$0A.
 $88D7 LD ($5E58),A  ;
 $88DA LD ($5E59),A  ;
 $88DD LD (IX+$0A),A ; }
 $88E0 JR $8879      ; Jump to #R$8879.
; This entry point is used by the routine at #R$88A3.
; .
; Use no skip when the sprite does not wrap past
; the screen column.
@label=ReadSpriteHeader_Done
*$88E2 LD A,$10      ; {Set the skip operand to #N$10 (skip nothing) and clear
 $88E4 LD C,$00      ; the overflow.}
 $88E6 JR $88C6      ; Jump to #R$88C6.

; Load Sprite Pointers
;
; Used by the routines at #R$864F, #R$877C and #R$8787.
; .
; Copy the graphic pointer and size from the actor into the
; draw workspace.
;
; IX Actor slot
;
; Copy the cached graphic pointer and size from the actor.
@label=LoadSpritePointers
c$88E8 LD E,(IX+$0C) ; {Fetch the cached graphic pointer.
 $88EB LD D,(IX+$0D) ; }
 $88EE LD L,(IX+$0E) ; {Fetch the cached screen address.
 $88F1 LD H,(IX+$0F) ; }
 $88F4 LD A,H        ; {Write the screen MSB to #R$5E56.
 $88F5 LD ($5E56),A  ; }
 $88F8 LD A,(IX+$09) ; {Write the cached skip to #R$87C7(#N$87C8).
 $88FB LD ($87C8),A  ; }
 $88FE LD A,(IX+$0A) ; {Write the cached height (row count) to #R$5E5A.
 $8901 LD ($5E5A),A  ; }
 $8904 LD B,(IX+$0B) ; Fetch the cached width into the column counter.
 $8907 LD C,$00      ; Clear the row counter.
 $8909 RET           ; Return.

; Write Sprite Attributes
;
; Used by the routine at #R$91E2.
; .
; Paint a rectangle of colours into the attribute buffer, taking one
; colour byte from the grid at #REGde for every cell the actor's sprite covers
; and leaving empty cells alone.
;
; DE Colour grid
; IX Actor slot
;
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h After #R$877C | =h After #R$890A }
; { #SIM(start=$800A,stop=$8024,sp=$5E00)
; #SIM(start=$81BB,stop=$81D6,sp=$5E00)
; #SIM(start=$9EEB,stop=$9EEE,ix=$6090,sp=$5E00)
; #SIM(start=$9267,stop=$926A,ix=$6090,sp=$5E00)
; #SCR$03,$04,$11,$0A,$06(pair-redrawn)
; | #SIM(start=$927A,stop=$9280,ix=$6090,sp=$5E00)
; #SCR$03,$04,$11,$0A,$06(pair-coloured) } UDGTABLE# #POPS
; .
; Paint the actor colour rectangle into the attribute buffer.
@label=WriteSpriteAttributes
c$890A LD L,(IX+$01) ; {Fetch the screen column and actor Y.
 $890D LD H,(IX+$04) ; }
 $8910 CALL $8506    ; Call #R$8506.
 $8913 LD A,(DE)     ; {Fetch the width and height from the graphic header.
 $8914 INC DE        ;
 $8915 LD B,A        ;
 $8916 LD A,(DE)     ;
 $8917 INC DE        ;
 $8918 LD C,A        ; }
@label=WriteSpriteAttributes_Loop
*$8919 PUSH BC       ; {Stash the counters and attribute address.
 $891A PUSH HL       ; }
; Write the colours along the row, skipping empty attributes.
@label=WriteSpriteAttributes_WriteInk
*$891B LD A,(HL)     ; {Jump to #R$8921 if this attribute is empty.
 $891C AND A         ;
 $891D JR Z,$8921    ; }
 $891F LD A,(DE)     ; {Write the next colour byte.
 $8920 LD (HL),A     ; }
@label=WriteSpriteAttributes_NextColumn
*$8921 INC DE        ; {Move onto the next colour and attribute column,
 $8922 INC L         ; looping back to #R$891B.
 $8923 DJNZ $891B    ; }
; Step up one attribute row and repeat until every row is
; painted.
 $8925 POP HL        ; {Restore this row and step up one attribute row.
 $8926 LD BC,$0020   ;
 $8929 AND A         ;
 $892A SBC HL,BC     ;
 $892C POP BC        ; }
 $892D DEC C         ; {Decrease the height and loop back to #R$8919 until
 $892E JR NZ,$8919   ; every row is painted.}
 $8930 RET           ; Return.

; Fill Attribute Row
;
; Used by the routine at #R$9EDC.
; .
; Write #REGd over a block of attributes, #REGb columns wide and
; #REGc rows high, stepping up a row at a time. Empty (zero)
; attributes are left alone.
;
; B Number of columns
; C Number of rows
; D Attribute value
; HL Attribute address of the bottom-left cell
@label=FillAttributeRow
c$8931 PUSH BC       ; {Stash the counters and attribute address.
 $8932 PUSH HL       ; }
@label=FillAttributeRow_Loop
*$8933 LD A,(HL)     ; {Jump to #R$8938 if this attribute is empty.
 $8934 AND A         ;
 $8935 JR Z,$8938    ; }
 $8937 LD (HL),D     ; Write the fill colour.
@label=FillAttributeRow_NextColumn
*$8938 INC L         ; {Move onto the next column and loop back to #R$8933.
 $8939 DJNZ $8933    ; }
 $893B POP HL        ; {Restore this row and step up one attribute row.
 $893C LD BC,$0020   ;
 $893F AND A         ;
 $8940 SBC HL,BC     ;
 $8942 POP BC        ; }
 $8943 DEC C         ; {Decrease the height and loop back to #R$8931 until
 $8944 JR NZ,$8931   ; every row is painted.}
 $8946 RET           ; Return.

; Negate HL
;
; Used by the routines at #R$A4BA, #R$AD36 and #R$B0D1.
; .
; Makes #REGhl negative.
;
;   HL The word
; O:HL The negative of the word
;
; Invert both bytes, then add one.
@label=NegateHL
c$8947 LD A,L        ; {Invert the low byte.
 $8948 CPL           ;
 $8949 LD L,A        ; }
 $894A LD A,H        ; {Invert the high byte.
 $894B CPL           ;
 $894C LD H,A        ; }
 $894D INC HL        ; Add one.
 $894E RET           ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$D01B }
; { #MARTIANOIDS$B4B1 }
; { #NIGHTSHADE$E0DD }
; LIST#

; Display Lives
;
; Used by the routines at #R$9020, #R$9F70 and #R$A826.
; .
; Draw the 1UP and 2UP lives counts and the life UDG, or
; spaces if a player has none.
;
; .
;
; Controller for 1UP lives.
@label=DisplayPlayerLives
c$894F LD HL,$0040   ; {Call #R$851E with the pixel co-ordinates
 $8952 CALL $851E    ; #N($0040,$04,$04) to get the 1UP lives screen address.}
 $8955 CALL $8986    ; #REGa=1UP lives remaining (by calling #R$8986).
 $8958 AND A         ; {If 1UP lives are zero, jump to #R$8977.
 $8959 JR Z,$8977    ; }
 $895B CALL $896A    ; Else, there are lives to display so call #R$896A.
; Controller for 2UP lives.
@label=Controller2UPLives
*$895E LD HL,$00B0   ; {Call #R$851E with the pixel co-ordinates
 $8961 CALL $851E    ; #N($00B0,$04,$04) to get the 2UP lives screen address.}
 $8964 CALL $8994    ; #REGa=2UP lives remaining (by calling #R$8994).
 $8967 AND A         ; {If 2UP lives are zero, jump to #R$897C.
 $8968 JR Z,$897C    ; }
; Handles displaying the lives count and UDG character.
@label=HandlerDisplayLives
*$896A ADD A,$30     ; Add #N$30 to convert to an ASCII character
                     ; (starting at "0").
 $896C CALL $89EF    ; Call #R$89EF.
 $896F LD DE,$D151   ; #REGde=#R$D151.
 $8972 PUSH BC       ; {Stash #REGbc and #REGde on the stack.
 $8973 PUSH DE       ; }
 $8974 JP $8A01      ; Jump to #R$8A01.
; 1UP has no lives.
@label=Handler1UPNoLives
*$8977 CALL $897C    ; Call #R$897C.
 $897A JR $895E      ; Jump to #R$895E.
; 2UP has no lives.
@label=Handler2UPNoLives
*$897C LD A,$20      ; #REGa=ASCII " " (SPACE).
 $897E CALL $89EF    ; Call #R$89EF.
 $8981 LD A,$20      ; #REGa=ASCII " " (SPACE).
 $8983 JP $89EF      ; Jump to #R$89EF.
; Return the 1UP player's lives left.
@label=FetchLives_1UP
*$8986 LD A,($5E65)  ; {If #R$5E65 is not zero then jump to #R$8990.
 $8989 AND A         ;
 $898A JR NZ,$8990   ; }
; Return currently active players lives left.
@label=ActivePlayerLives
*$898C LD A,($5EA1)  ; #REGa=*#R$5EA1.
 $898F RET           ; Return.
; Return inactive players lives left.
@label=InactivePlayerLives
*$8990 LD A,($5EA5)  ; #REGa=*#R$5EA5.
 $8993 RET           ; Return.
; Return the 2UP player's lives left.
@label=FetchLives_2UP
*$8994 LD A,($5E65)  ; {If #R$5E65 is zero then jump to #R$8990.
 $8997 AND A         ;
 $8998 JR Z,$8990    ; }
 $899A JR $898C      ; Jump to #R$898C.
