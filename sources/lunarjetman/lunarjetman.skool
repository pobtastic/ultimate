 $9CE2 DEFB $B8,$00,$00,$00,$00,$00,$00,$42 ; {#SPRITENAME(#PEEK(#PC)).
 $9CEA DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
 $9CF2 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; }

; Alien Lookup Table
;
; Eight alien template pointers per row, picked at random by
; #R$9466. #R$9D72 selects the row from the level number (bits 1-3),
; so each row serves two levels and level #N$0A onwards uses the
; last row.
;
; .
;
; Level 1 aliens.
@label=Level1Aliens
w$9CFA DEFW $9C3A
 $9CFC DEFW $9C3A
 $9CFE DEFW $9C9A
 $9D00 DEFW $9C82
 $9D02 DEFW $9C3A
 $9D04 DEFW $9C82
 $9D06 DEFW $9C9A
 $9D08 DEFW $9C82
