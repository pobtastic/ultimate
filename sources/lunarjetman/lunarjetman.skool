@label=String_DestroyMissile
 $B683 DEFM $47                                     ; {"DESTROY THE MISSILE. ".
 $B684 DEFM "DESTROY THE MISSILE."," "+$80          ; }

; Convert To Base 10
;
; Used by the routines at #R$B52E and #R$F641.
; .
; Converts #REGa into packed decimal, with the tens in the high
; nibble and the units in the low nibble.
;
;   A Input number
; O:A Output number
;
; For an example, given #REGa=#N$16 - the output is #EVAL($22,$02,$08).
; .
; First count the number of "10's" in #REGa.
@label=Convert_Base10
c$B699 LD BC,$000A   ; Set the tens counter in #REGb to zero and the divisor in #REGc
                     ; to #N$0A.
@label=Convert_Base10_Loop
*$B69C INC B         ; Increment #REGb counter.
 $B69D SUB C         ; #REGa-=#N$0A.
 $B69E JR NC,$B69C   ; Jump back to #R$B69C until there's a carry amount.
; Restore the units and correct the tens count.
 $B6A0 ADD A,C       ; #REGa+=#REGc.
 $B6A1 DEC B         ; Decrease the counter in #REGb by one to account for the
                     ; carry.
; Move the tens into the high nibble and merge in the units.
 $B6A2 SLA B         ; {Shift and rotate #REGb four times.
 $B6A4 SLA B         ;
 $B6A6 SLA B         ;
 $B6A8 SLA B         ; }
 $B6AA AND %00001111 ; Keep only bits 0-3.
 $B6AC OR B          ; Set the bits from #REGb.
 $B6AD RET           ; Return.

; Move By Speed
;
; Used by the routines at #R$A522, #R$B460 and #R$B810.
; .
; Add the actor's horizontal speed to its world X and return
; the Y plus thrust in #REGa.
;
; IX Actor slot
;
; Add the actor's horizontal speed to its world X.
@label=MoveBySpeed
c$B6AE LD A,(IX+$05)  ; {Copy the actor speed into #REGc.
 $B6B1 LD C,A         ; }
 $B6B2 LD B,$00       ; Clear #REGb.
 $B6B4 AND A          ; {Jump to #R$B6B9 if the speed is positive.
 $B6B5 JP P,$B6B9     ; }
 $B6B8 DEC B          ; Sign-extend the speed into #REGbc.
; Add the sign-extended speed to the world X and wrap it.
@label=MoveBySpeed_AddWorldX
*$B6B9 LD L,(IX+$02)  ; Fetch the actor world X.
 $B6BC LD H,(IX+$03)  ; Fetch the high byte.
 $B6BF CALL $A002     ; Call #R$A002.
 $B6C2 LD (IX+$02),L  ; Write the wrapped low byte back.
 $B6C5 LD (IX+$03),H  ; Write the wrapped high byte back.
; Return the actor Y plus its thrust.
 $B6C8 LD A,(IX+$04)  ; Fetch the actor Y.
 $B6CB ADD A,(IX+$06) ; Add the actor thrust.
 $B6CE RET            ; Return.

; Dispatch Object State
;
; Use bits 0-3 of *#REGix+#N$08 as an index into #R$B6DB.
;
; IX Actor slot
;
; Use bits 0-3 of the actor flags as an index into #R$B6DB.
@label=DispatchObjectState
c$B6CF LD BC,$B6DB   ; Point #REGbc at the state table at #R$B6DB.
 $B6D2 LD A,(IX+$08) ; #REGa=*#REGix+#N$08.
 $B6D5 AND %00001111 ; Keep only bits 0-3.
 $B6D7 LD L,A        ; #REGl=#REGa.
 $B6D8 JP $81FE      ; Jump to #R$81FE.
@label=Object_State_Table
 $B6DB DEFW $B785    ; #R$B785.
 $B6DD DEFW $B7BC    ; #R$B7BC.
 $B6DF DEFW $B810    ; #R$B810.
 $B6E1 DEFW $B6EB    ; #R$B6EB.
 $B6E3 DEFW $B6EC    ; {#R$B6EC.
 $B6E5 DEFW $B6EC    ;
 $B6E7 DEFW $B6EC    ;
 $B6E9 DEFW $B6EC    ; }

; Ignore Object State
;
; No-op handler for object-state index #N$03 in
; #R$B6DB.
@label=IgnoreObjectState
c$B6EB RET           ; Return.

; Handler: Armed Bomb
;
; Animate the bomb and, on action, collect it and play
; #R$B8BD.
;
; IX Actor slot
;
; Animate the bomb and test the action key.
@label=Handler_ArmedBomb
c$B6EC CALL $B7A8      ; Call #R$B7A8.
 $B6EF CALL $945C      ; Call #R$945C.
 $B6F2 JR NZ,$B6F8     ; Jump to #R$B6F8 if action is pressed.
 $B6F4 RES 7,(IX+$08)  ; Reset bit 7 of the actor flags.
; Collect the bomb when the rover type is in
; #N$1A-#N$29.
@label=Handler_ArmedBomb_TestRover
*$B6F8 LD A,($6090)    ; Fetch #R$6090.
 $B6FB SUB $1A         ; Subtract #N$1A.
 $B6FD CP $10          ; {Jump to #R$B71C if it is out of range.
 $B6FF JR NC,$B71C     ; }
 $B701 CALL $A4E7      ; Call #R$A4E7.
 $B704 JR NC,$B719     ; Jump to #R$B719 if Jetman cannot collect it.
; Mark the bomb as carried and play the take sound.
 $B706 LD (IX+$08),$81 ; Write #N$81 to the actor flags.
 $B70A LD A,($6080)    ; Fetch #R$6080.
 $B70D OR %00000001    ; Set bit 0.
 $B70F LD ($6080),A    ; Write it back.
 $B712 XOR A           ; {Write #N$00 to #R$5EA3.
 $B713 LD ($5EA3),A    ; }
 $B716 CALL $B8BD      ; Call #R$B8BD.
@label=Handler_ArmedBomb_DrawHeld
*$B719 JP $A431        ; Jump to #R$A431.
; Hang the bomb beside Jetman. Type #N$16 and
; above is seated facing right; hang it on the left.
@label=Handler_ArmedBomb_HangBeside
*$B71C LD A,($6078)    ; Fetch #R$6078.
 $B71F CP $16          ; {Jump to #R$B72C if it is lower.
 $B721 JR C,$B72C      ; }
 $B723 LD BC,$FFF4     ; Set the offset in #REGbc to #N$FFF4 (-#N$0C).
@label=Handler_ArmedBomb_Loop
*$B726 LD HL,($607A)   ; Fetch #R$607A.
 $B729 JP $A43E        ; Jump to #R$A43E.
@label=Handler_ArmedBomb_OnFootOffset
*$B72C LD BC,$0012     ; Set the offset in #REGbc to #N($0012,$04,$04).
 $B72F JR $B726        ; Jump to #R$B726.

; Handler: Bombs
;
; Used by the routine at #R$8259.
; .
; Copy the template into #R$6198 when that slot is empty,
; then place the bomb from the rover or Jetman.
;
; .
;
; Copy the bomb template into #R$6198 when that slot is empty.
@label=Handler_Bombs
c$B731 LD DE,$6198                          ; #REGde=#R$6198.
 $B734 LD A,(DE)                            ; {Return if a bomb is already
 $B735 AND A                                ; active.
 $B736 RET NZ                               ; }
 $B737 LD HL,$B76D                          ; #REGhl=#R$B76D.
 $B73A LD BC,$0018                          ; {Copy the #N$18-byte template
 $B73D LDIR                                 ; into the bomb slot.}
; Take the spawn X from the rover or from Jetman.
 $B73F LD A,($6090)                         ; Fetch #R$6090.
 $B742 SUB $1A                              ; Subtract #N$1A.
 $B744 CP $10                               ; {Jump to #R$B763 if the rover
 $B746 JR C,$B763                           ; type is in range.}
 $B748 LD HL,($607A)                        ; Fetch #R$607A.
; Offset the spawn X by #N$30 to the right, or to the
; left when the rover is outside the alien base range.
@label=Handler_Bombs_Loop
*$B74B PUSH HL                              ; Stash the spawn X on the stack.
 $B74C LD HL,($6092)                        ; Fetch #R$6092.
 $B74F LD BC,($6182)                        ; Fetch #R$6182.
 $B753 CALL $AD3F                           ; Call #R$AD3F.
 $B756 JR NC,$B768                          ; Jump to #R$B768 if the rover is outside the
                                            ; #N$1000 range of #R$6182.
 $B758 LD BC,$0030                          ; Set the offset in #REGbc to
                                            ; #N($0030,$04,$04).
; Add the offset to the spawn X and write it to the bomb slot.
@label=Handler_Bombs_PlaceX
*$B75B POP HL                               ; Restore the spawn X from the
                                            ; stack.
 $B75C CALL $A002                           ; Call #R$A002.
 $B75F LD ($619A),HL                        ; Write it to #R$6198(#N$619A).
 $B762 RET                                  ; Return.
@label=Handler_Bombs_FromRover
*$B763 LD HL,($6092)                        ; Fetch #R$6092.
 $B766 JR $B74B                             ; Jump to #R$B74B.
@label=Handler_Bombs_OffsetLeft
*$B768 LD BC,$FFD0                          ; Set the offset in #REGbc to
                                            ; #N$FFD0 (-#N$30).
 $B76B JR $B75B                             ; Jump to #R$B75B.
@label=Bomb_Actor_Template
 $B76D DEFB $EC,$00,$00,$00,$AF,$00,$01,$44 ; {Bomb actor template.
 $B775 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
 $B77D DEFB $00,$06,$06,$00,$00,$00,$00,$00 ; }

; Collect Bomb
;
; On action, mark the bomb carried and play #R$B8BD.
;
; IX Actor slot
;
; On action, mark the bomb carried and play #R$B8BD.
@label=CollectBomb
c$B785 CALL $945C      ; Call #R$945C.
 $B788 JR NZ,$B78E     ; Jump to #R$B78E if action is pressed.
 $B78A RES 7,(IX+$08)  ; Reset bit 7 of the actor flags.
; Mark the bomb as carried if Jetman can collect it.
@label=CollectBomb_TestRange
*$B78E CALL $A4E7      ; Call #R$A4E7.
 $B791 JR NC,$B7A2     ; Jump to #R$B7A2 if Jetman cannot collect it.
 $B793 LD (IX+$08),$81 ; Write #N$81 to the actor flags.
 $B797 LD A,($6080)    ; Fetch #R$6080.
 $B79A OR %00000001    ; Set bit 0.
 $B79C LD ($6080),A    ; Write it back.
 $B79F CALL $B8BD      ; Call #R$B8BD.
; This entry point is used by the routines at #R$B7BC and #R$B810.
@label=CollectBomb_Loop
*$B7A2 CALL $B7A8      ; Call #R$B7A8.
 $B7A5 JP $ABB4        ; Jump to #R$ABB4.

; Handler: Bomb
;
; Used by the routines at #R$B6EC and #R$B785.
; .
; Steps the bomb through its four sprite frames and flips bit 0 of
; #REGix+#N$07.
;
; IX Animation object
;
; Animate the sprite.
@label=Handler_Bomb
c$B7A8 LD A,(IX+$00) ; #REGa=*#REGix+#N$00.
 $B7AB INC A         ; Increment #REGa by one.
; The bomb has four frames of animation.
 $B7AC AND %00000011 ; Keep only bits 0-1.
; With sprite IDs beginning from #R$EE17(#N$EC) (#SPRITENAME$EC).
 $B7AE ADD A,$EC     ; #REGa=#REGa+#N$EC.
 $B7B0 LD (IX+$00),A ; Write #REGa back to *#REGix+#N$00.
 $B7B3 LD A,(IX+$07) ; #REGa=*#REGix+#N$07.
 $B7B6 XOR %00000001 ; Flip bit 0.
 $B7B8 LD (IX+$07),A ; Write #REGa back to *#REGix+#N$07.
 $B7BB RET           ; Return.

; Carry Bomb
;
; Stick the bomb to Jetman, or on action drop it with his
; current X speed and play #R$B8C3.
;
; IX Actor slot
;
; Stick the bomb to Jetman, or drop it on action.
@label=CarryBomb
c$B7BC CALL $945C      ; Call #R$945C.
 $B7BF JR NZ,$B7DE     ; Jump to #R$B7DE if action is pressed.
 $B7C1 RES 7,(IX+$08)  ; Reset bit 7 of the actor flags.
; Keep the bomb under Jetman.
@label=CarryBomb_Loop
*$B7C5 LD HL,($607A)   ; Fetch #R$607A.
 $B7C8 LD (IX+$02),L   ; Write the low world X.
 $B7CB LD (IX+$03),H   ; Write the high world X.
 $B7CE LD A,($607C)    ; Fetch #R$607C.
 $B7D1 ADD A,$10       ; Add #N$10.
 $B7D3 CP $AF          ; {Jump to #R$B7D9 if it is still above the ground
 $B7D5 JR C,$B7D9      ; line.}
; #N$AF is the ground line.
 $B7D7 LD A,$AF        ; #REGa=#N$AF.
@label=CarryBomb_WriteY
*$B7D9 LD (IX+$04),A   ; Write the actor Y.
 $B7DC JR $B7A2        ; Jump to #R$B7A2.
; Drop the bomb, throwing it with a share of Jetman's
; speed unless it is on the ground line.
@label=CarryBomb_TestDrop
*$B7DE BIT 7,(IX+$08)  ; {Jump to #R$B7C5 if bit 7 of the actor flags is
 $B7E2 JR NZ,$B7C5     ; set.}
 $B7E4 LD A,(IX+$04)   ; Fetch the actor Y.
 $B7E7 CP $AF          ; {Jump to #R$B80A if it is on the ground line.
 $B7E9 JR Z,$B80A      ; }
; Mark the bomb as thrown with a share of Jetman's speed.
 $B7EB LD (IX+$08),$82 ; Write #N$82 to the actor flags.
 $B7EF LD A,($607D)    ; Fetch #R$607D.
 $B7F2 SRA A           ; {Divide it by #N$10.
 $B7F4 SRA A           ;
 $B7F6 SRA A           ;
 $B7F8 SRA A           ; }
 $B7FA LD (IX+$05),A   ; Write it as the bomb speed.
; Clear bit 0 of Jetman's flags and play the drop sound.
@label=CarryBomb_ClearCarrying
*$B7FD LD A,($6080)    ; Fetch #R$6080.
 $B800 AND %11111110   ; Clear bit 0.
 $B802 LD ($6080),A    ; Write it back.
 $B805 CALL $B8C3      ; Call #R$B8C3.
 $B808 JR $B7A2        ; Jump to #R$B7A2.
@label=CarryBomb_OnGround
*$B80A LD (IX+$08),$80 ; Write #N$80 to the actor flags.
 $B80E JR $B7FD        ; Jump to #R$B7FD.

; Fly Thrown Bomb
;
; Move the bomb by its speed. A hit on the alien base scores
; #N$3000 and writes #N$01 to #R$6195.
;
; IX Actor slot
;
; Move the thrown bomb by its speed.
@label=FlyThrownBomb
c$B810 CALL $B89A      ; Call #R$B89A.
 $B813 LD A,($5EA3)    ; Fetch #R$5EA3.
 $B816 AND A           ; {Jump to #R$B81E if it is not zero.
 $B817 JR NZ,$B81E     ; }
 $B819 CALL $A4BA      ; Call #R$A4BA.
 $B81C JR C,$B848      ; Jump to #R$B848 if the bomb is close to the rover.
; Move the bomb along and check the ground line.
@label=FlyThrownBomb_Move
*$B81E CALL $B6AE      ; Call #R$B6AE.
 $B821 CP $AF          ; {Jump to #R$B83C if the new Y is on or below the
 $B823 JR NC,$B83C     ; ground line.}
; Test the bomb against the alien base.
 $B825 LD (IX+$04),A   ; Write the actor Y.
 $B828 CALL $B854      ; Call #R$B854.
 $B82B JP NC,$B7A2     ; Jump to #R$B7A2 if the bomb missed the base.
; Turn the object slots into craters and explosions and record
; the hit on the base.
 $B82E CALL $B16F      ; Call #R$B16F.
 $B831 LD A,$01        ; {Write #N$01 to #R$6195.
 $B833 LD ($6195),A    ; }
; Destroying the alien base adds #N$3000 points.
 $B836 LD BC,$3000     ; Set the points to award in #REGbc to #N$3000.
 $B839 CALL $899C      ; Call #R$899C.
; Put the bomb on the ground line and change its type
; to #N$C0.
@label=FlyThrownBomb_Land
*$B83C LD (IX+$04),$AF ; Write #N$AF to the actor Y.
 $B840 CALL $ABB4      ; Call #R$ABB4.
; "#SPRITENAME$C0".
 $B843 LD (IX+$00),$C0 ; Write type #N$C0.
 $B847 RET             ; Return.
; Flag the bomb as collected by the rover.
@label=FlyThrownBomb_CollectRover
*$B848 SET 2,(IX+$08)  ; Set bit 2 of the actor flags.
 $B84C LD A,$01        ; {Write #N$01 to #R$5EA3.
 $B84E LD ($5EA3),A    ; }
 $B851 JP $ABB4        ; Jump to #R$ABB4.
; Test the bomb against the alien-base slot.
@label=FlyThrownBomb_TestBase
*$B854 LD E,$18        ; #REGe=#N$18.
 $B856 LD L,(IX+$02)   ; Fetch the bomb world X.
 $B859 LD H,(IX+$03)   ; Fetch the high byte.
 $B85C LD BC,$0018     ; {Add a #N$18 window.
 $B85F ADD HL,BC       ; }
 $B860 LD BC,($6182)   ; Fetch #R$6182.
 $B864 AND A           ; {Subtract the alien base world X.
 $B865 SBC HL,BC       ; }
 $B867 LD A,H          ; Copy the high byte of the difference.
 $B868 AND %00011111   ; Keep only bits 0-4.
 $B86A RET NZ          ; Return if the result is not zero.
 $B86B LD A,L          ; Copy the low byte of the difference.
 $B86C CP $20          ; {Return if it is at least #N$20.
 $B86E RET NC          ; }
 $B86F LD A,($6184)    ; Fetch the base Y from #R$6180(#N$6184).
 $B872 SUB $04         ; Subtract #N$04.
 $B874 SUB (IX+$04)    ; Subtract the bomb Y.
 $B877 JP P,$B87C      ; Jump to #R$B87C if the result is positive.
 $B87A NEG             ; Negate it.
@label=FlyThrownBomb_CompareY
*$B87C CP E            ; Compare it with the window.
 $B87D RET             ; Return.

; Colourise Rover Lights
;
; Used by the routine at #R$91E2.
; .
; Write the rover lamp attributes at #R$BCA9 from the Jetman
; type.
;
; .
;
; Write the rover lamp attributes from the Jetman
; type. Type #N$16 and above is seated facing right.
@label=ColouriseRoverLights
c$B87E LD A,($6078)  ; Fetch #R$6078.
 $B881 CP $16        ; Compare it with #N$16.
 $B883 LD HL,$BCA9   ; #REGhl=#R$BCA9.
 $B886 JR C,$B891    ; Jump to #R$B891 if the type is lower.
; Write the lamp attributes for type #N$16 and above:
; #COLOUR$57, #COLOUR$57, then #COLOUR$47.
 $B888 LD A,$57      ; #REGa=#COLOUR$57.
 $B88A LD (HL),A     ; Write #REGa to *#REGhl.
 $B88B INC HL        ; Increment #REGhl by one.
 $B88C LD (HL),A     ; Write #REGa to *#REGhl.
 $B88D INC HL        ; Increment #REGhl by one.
 $B88E LD (HL),$47   ; Write #COLOUR$47 to *#REGhl.
 $B890 RET           ; Return.
; Write the lamp attributes for the lower types:
; #COLOUR$47, #COLOUR$57, then #COLOUR$57.
@label=ColouriseRoverLights_OnFoot
*$B891 LD A,$57      ; #REGa=#COLOUR$57.
 $B893 LD (HL),$47   ; Write #COLOUR$47 to *#REGhl.
 $B895 INC HL        ; Increment #REGhl by one.
 $B896 LD (HL),A     ; Write #REGa to *#REGhl.
 $B897 INC HL        ; Increment #REGhl by one.
 $B898 LD (HL),A     ; Write #REGa to *#REGhl.
 $B899 RET           ; Return.

; Tick Object Timer
;
; Used by the routines at #R$A522 and #R$B810.
; .
; Decrease *#REGix+#N$11 and, when it hits zero, reload it
; and increase the vertical thrust in *#REGix+#N$06.
;
; IX Actor slot
;
; Decrease the object timer and increase the thrust on zero.
@label=TickObjectTimer
c$B89A DEC (IX+$11)  ; Decrease *#REGix+#N$11 by one.
 $B89D RET NZ        ; Return if the result is not zero.
 $B89E LD A,(IX+$12) ; #REGa=*#REGix+#N$12.
 $B8A1 LD (IX+$11),A ; Write #REGa to *#REGix+#N$11.
 $B8A4 INC (IX+$06)  ; Increment *#REGix+#N$06 by one.
 $B8A7 RET           ; Return.

; Sounds: Laser Beam
;
; Used by the routine at #R$9DC0.
; .
; #HTML(#AUDIO0(laser-beam.wav)(#INCLUDE(LaserBeam)))
@label=SoundsLaserBeam
c$B8A8 LD C,$08      ; #REGc=#N$08 (pitch).
@label=SoundsLaserBeam_Loop
*$B8AA CALL $B8DA    ; Call #R$B8DA.
 $B8AD INC C         ; Increase the pitch by one.
 $B8AE LD A,C        ; Copy it into #REGa.
 $B8AF CP $38        ; {Jump back to #R$B8AA if it is not #N$38.
 $B8B1 JR NZ,$B8AA   ; }
 $B8B3 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #JETPAC$681E }
; LIST#

