i$5B00

; Decryption Routine
;
; Decrypts the game by running RRD on every byte from
; #N$7FFF up to #N($FBFE), then jumps to #R$8000.
;
; .
;
; Decrypt every byte from #N$7FFF upwards.
@label=GameEntry
c$5B80 LD HL,$7FFF   ; Set the start address to #N$7FFF.
 $5B83 LD BC,$007C   ; Set #REGb to #N$00 so each inner pass covers one
                     ; page, and #REGc to #N$7C pages.
 $5B86 XOR A         ; Reset the flags.
@label=Decryption_Loop
*$5B87 RRD           ; Rotate the current byte right through the accumulator.
 $5B89 INC HL        ; Move onto the next byte.
 $5B8A DJNZ $5B87    ; Decrease #REGb by one and loop back to #R$5B87
                     ; until this page is done.
 $5B8C DEC C         ; Decrease the page count by one.
 $5B8D JR NZ,$5B87   ; Loop back to #R$5B87 until every page is decrypted.
@label=GameEntry_Jump
 $5B8F JP $8000      ; Jump to #R$8000.
; View the equivalent code in;
; #LIST
; { #ATICATAC$5B80 }
; { #NIGHTSHADE$5B80 }
; { #SABREWULF$5B80 }
; LIST#
; .
; Earlier Ultimate games use a much simpler mechanism;
; #LIST
; { #COOKIE$5B80 }
; { #JETPAC$5B80 }
; { #PSSST$5B80 }
; { #TRANZAM$5B80 }
; LIST#

i$5B92

; Indirect Jump
;
; Used by the routine at #R$81BB.
; .
; Jumps to the handler address already held in #REGhl.
;
; HL Jump address
@label=IndirectJump
c$5CB0 JP (HL)       ; Jump to the address held in #REGhl.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$5CB0 }
; { #NIGHTSHADE$5CB0 }
; { #PSSST$5CB0 }
; { #SABREWULF$5CB0 }
; { #TRANZAM$5CB0 }
; LIST#

i$5CB1

; Game Options
;
; Holds the number of players and the chosen control method.
; Bit #N$00 is the player count, bits #N$01-#N$02 are the control method.
; #TABLE(default,centre,centre)
; { =h Bits 1-2 | =h Control Method }
; { #N$00 | Keyboard }
; { #N$02 | Kempston Joystick }
; { #N$04 | Cursor Joystick }
; TABLE#
; Bit #N$00 is reset for a 1UP game, or set for a 2UP game.
@label=GameOptions
g$5E00 DEFB $00
; View the equivalent code in;
; #LIST
; { #JETPAC$5CF3 }
; { #PSSST$5E03 }
; { #UNDERWURLDE$8ED5 }
; LIST#

; Unused
;
; Cleared by #R$800A; not referenced by the game.
@label=Unused_After_Game_Options
u$5E01 DEFB $00,$2C,$30

; Font Pointer
;
; Holds a pointer to the currently used font data.
@label=FontPointer
g$5E04 DEFW $000E

; High Score
;
; 3-byte representation of the score.
@label=High_Score
g$5E06 DEFB $00,$00,$00
; View the equivalent code in;
; #LIST
; { #COOKIE$5F09 }
; { #JETPAC$5CF0 }
; { #PSSST$5E00 }
; { #SABREWULF$B304 }
; { #TRANZAM$5E49 }
; LIST#

; High Score Table
;
; Remaining 3-byte scores which follow #R$5E06. #R$9C23 copies
; #R$9D98 over this whole table on initialisation.
@label=High_Score_Table
g$5E09 DEFB $00,$3A,$EF,$22,$22,$AF,$3A,$F5
 $5E11 DEFB $AC,$36,$0E,$00,$00,$06,$00,$00
 $5E19 DEFB $2C,$30,$0E,$00,$00,$00,$00

; Hall Of Fame Names
;
; Eight 3-letter names. #R$9C23 copies #R$9D80 here;
; #R$F410 prints them beside the scores at #R$5E06. The
; eighth name occupies #R$5E35.
@label=HallOfFame_Names
g$5E20 DEFB $00,$3A,$EF,$22,$22,$AF,$3A,$F5
 $5E28 DEFB $AC,$36,$0E,$00,$00,$06,$00,$00
 $5E30 DEFB $2C,$30,$0E,$00,$00

; Hall Of Fame Last Name
;
; Eighth name slot. #R$F345 uses it as the LDDR source
; when opening a gap in the name table.
@label=HallOfFame_LastName
g$5E35 DEFB $00,$00,$00

; Hall Of Fame Name End
;
; Byte after the name table. #R$F345 uses it as the LDDR
; destination.
@label=HallOfFame_NameEnd
g$5E38 DEFB $3A,$EF,$22,$22,$AF,$3A,$F5,$C0

; Random Number
;
; Updated each game loop by adding a ROM byte, addressed by the
; low byte of #R$5E42, to itself.
@label=RandomNumber
g$5E40 DEFB $32,$33
; View the equivalent code in #JETPAC$5DCE.

; Game Timer
;
; Incremented once per game loop. The low byte indexes ROM when
; refreshing #R$5E40.
@label=GameTimer
g$5E42 DEFB $34,$32,$34,$0E,$00,$00,$80,$5B
 $5E4A DEFB $00,$0D,$00,$00,$00,$00
; View the equivalent code in #JETPAC$5DCC.

; Planet Data
;
; Start of the in-play object RAM that #R$81BB clears up to
; #R$6000.
@label=PlanetData
g$5E50 DEFB $00,$00

; Frame Updated
;
; Has the frame been updated?
; #TABLE(default,centre,centre)
; { #N$00 | No }
; { #N$01 | Yes }
; TABLE#
@label=FrameUpdated
g$5E52 DEFB $00

; Last Frame
;
; Holds a copy of the last #SKOOLKID$5C78(FRAMES) counter.
@label=LastFrame
g$5E53 DEFB $00
 $5E54 DEFB $00,$00

; Sprite Cached Y
;
; Working copy of the actor's cached Y position (*#REGix+#N$0B),
; compared with the new Y when a sprite is redrawn. #R$88E8 uses it to
; hold the high byte of the cached screen address instead.
@label=SpriteCachedY
g$5E56 DEFB $00

; Sprite Width
;
; Width in character columns of the sprite being drawn. #R$8733
; uses it as the column count when colouring the sprite.
@label=SpriteWidth
g$5E57 DEFB $00

; Sprite Height
;
; Height in pixel rows of the sprite being drawn, kept so #R$8733
; can work out how many attribute rows to colour.
@label=SpriteHeight
g$5E58 DEFB $00

; Sprite Rows Left
;
; Rows of the new sprite image still to be drawn.
@label=SpriteRowsLeft
g$5E59 DEFB $00

; Sprite Cached Rows
;
; Rows of the old (cached) sprite image still to be erased. It is
; copied from *#REGix+#N$0A and counted down while a sprite is redrawn.
@label=SpriteCachedRows
g$5E5A DEFB $00,$00,$00

; Space Key Latch
;
; Set to #N$01 by #R$933E when SPACE is first pressed, so holding
; the key only counts once. Cleared again when SPACE is released.
@label=SpaceKeyLatch
g$5E5D DEFB $00

; Alien Count
;
; Number of live aliens this frame. #R$8287 asks #R$9466 to spawn
; another while this is less than #N$07.
@label=AlienCount
g$5E5E DEFB $00

; 1UP Score
;
; 3-byte representation of the score.
@label=1UP_Score_1
g$5E5F DEFB $00      ; Byte #1.
@label=1UP_Score_2
 $5E60 DEFB $00      ; Byte #2.
@label=1UP_Score_3
 $5E61 DEFB $00      ; Byte #3.

; 2UP Score
;
; 3-byte representation of the score.
