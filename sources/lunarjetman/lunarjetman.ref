[Links]
Graphics=[Graphics]

[Paths]
Credits=reference/credits.html
Graphics=graphics/graphics.html
Sound=sound/sounds.html

[Page:Graphics]
SectionPrefix=Graphics

[Page:Sound]
SectionPrefix=Audio

[Page:Credits]
PageContent=#INCLUDE(Credits)

[Credits]
<div class="box box-1">
  This disassembly would have taken a lot longer to finish if it weren't for the
  research and documentation already done and made available by:
#LIST
  { <a href="https://mrcook.uk/">Michael R. Cook</a> }
  { <a href="https://web.archive.org/web/20240429184336/https://www.angelfire.com/retro/carcass/ultimate/lunar/luntip.htm">Matthew Carrier</a> }
LIST#
  This game shares a lot of functionality with Jetpac, and Michaels' disassembly work was
  invaluable!
</div>

[Expand]
#DEF(#NOCROP(addr,size,attr)(fname) #UDGARRAY($size,attr=$attr,scale=4,step=$size,mask=1,flip=2)(($addr)-($addr+(((({height}+$07)/$08)*$08)*$size)-$01)-$01-($size*$08))($fname))

#DEF(#CROP(addr,size,attr)(fname) #UDGARRAY($size,attr=$attr,scale=4,step=$size,mask=1,flip=2)(($addr)-($addr+(((({height}+$07)/$08)*$08)*$size)-$01)-$01-($size*$08)){$00,$04*($08-({height}%$08)),$04*$size*$08,$04*{height}}($fname))

#DEF(#GRAPHIC(id,base=$BAC0,attr=$07)(fname)
  #LET(offset=($id-$01)*$02)
  #LET(addr=#PEEK($base+{offset})+#PEEK($base+{offset}+$01)*$100)
  #LET(width=#PEEK({addr}))
  #LET(height=#PEEK({addr}+$01))
  #IF({height}%$08)(
    #CROP({addr}+$02,{width},$attr)($fname),
    #NOCROP({addr}+$02,{width},$attr)($fname)
  )
)

#DEF(#SPRITE(id,base=$BAC0,size=$02,attr=$07)(fname)
  #LET(offset=($id-$01)*$02)
  #LET(addr=#PEEK($base+{offset})+#PEEK($base+{offset}+$01)*$100)
  #LET(height=#PEEK({addr}))
  #IF({height}%$08)(
    #CROP({addr}+$01,$size,$attr)($fname),
    #NOCROP({addr}+$01,$size,$attr)($fname)
  )
)

#DEF(#ROVERCROPNARROW(addr)(fname) #UDGARRAY$07,scale=4,step=$07,mask=1,flip=2(($addr)-($addr+(((({height}+$07)/$08)*$08)*$07)-$01)-$01-($07*$08))[($BCA0)-($BCA6);($BCA7)-($BCAD);($BCAE)-($BCB4);($BCB5)-($BCBB)]{$00,$04*($08-({height}%$08)),$04*$07*$08,$04*{height}}($fname))

#DEF(#ROVERCROPWIDE(addr)(fname) #UDGARRAY$08,scale=4,step=$08,mask=1,flip=2(($addr)-($addr+(((({height}+$07)/$08)*$08)*$08)-$01)-$01-($08*$08))[($BCA0)-($BCA6);($BCA6);($BCA7)-($BCAD);($BCAD);($BCAE)-($BCB4);($BCB4);($BCB5)-($BCBB);($BCBB)]{$00,$04*($08-({height}%$08)),$04*$08*$08,$04*{height}}($fname))

#DEF(#ROVER(id,base=$BAC0)(fname)
  #LET(offset=($id-$01)*$02)
  #LET(addr=#PEEK($base+{offset})+#PEEK($base+{offset}+$01)*$100)
  #LET(width=#PEEK({addr}))
  #LET(height=#PEEK({addr}+$01))
  #IF({width}==$07)(
    #ROVERCROPNARROW({addr}+$02)($fname),
    #ROVERCROPWIDE({addr}+$02)($fname)
  )
)

#DEF(#SPRITEDATA()(fname)
  #LET(height=#PEEK(#PC-$01))
  #IF({height}%$08)(
    #CROP(#PC,$02,$07)($fname),
    #NOCROP(#PC,$02,$07)($fname)
  )
)

