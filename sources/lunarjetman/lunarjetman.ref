;
; SkoolKit ref file for Lunar Jetman
;
; To build the HTML disassembly, run these commands:
;   tap2sna.py @lunarjetman.t2s
;   sna2skool.py -H -c sources/lunarjetman/lunarjetman.ctl LunarJetman.z80 > sources/lunarjetman/lunarjetman.skool
;   skool2html.py -H sources/lunarjetman/lunarjetman.skool -T dark -T wide -toOa

[Config]
Expand=#INCLUDE(Expand)
RefFiles=../analytics.ref;../bases.ref;changelog.ref;data.ref;pokes.ref;lunarjetmanGraphics.ref;sounds.ref
HtmlWriterClass=sources:linking.UltimateHtmlWriter
GameDir=ultimate/lunarjetman

[Game]
Game=Lunar Jetman
Logo=#SCR$01,$00,$00,$1F,$08,$4000,$5800(/images/logo)
Copyright=&copy; 1983 Ashby Computers &amp; Graphics Ltd<br />&copy; Rare Ltd<br />&copy; 2026 ArcadeGeek LTD.
Repository=https://github.com/pobtastic/ultimate/tree/main/sources/lunarjetman/
Canonical=https://skoolkit.arcadegeek.co.uk/ultimate/lunarjetman/
GameIndexUrl=https://skoolkit.arcadegeek.co.uk/ultimate/lunarjetman/
OgImage=https://skoolkit.arcadegeek.co.uk/ultimate/lunarjetman/images/logo.png
StyleSheet=skoolkit.css;skoolkit-dark.css;skoolkit-wide.css;lunarjetman.css
LinkInternalOperands=1
AddressAnchor={address#IF({base}==16)(:04x)}

[PageHeaders]
GameIndex=The complete<>RAM disassembly (work in progress)

[Index]
MemoryMaps
Graphics
DataTables
Reference

[Index:Graphics:Graphics And Sounds]
Graphics
Sound

[Index:Reference:Reference]
