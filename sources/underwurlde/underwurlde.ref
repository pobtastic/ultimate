;
; SkoolKit ref file for Underwurlde
;
; To build the HTML disassembly, run these commands:
;   tap2sna.py @underwurlde.t2s
;   sna2skool.py -H -c sources/underwurlde/underwurlde.ctl Underwurlde.z80 \
;     > sources/underwurlde/underwurlde.skool
;   skool2html.py -H sources/underwurlde/underwurlde.skool -T dark -T wide -toOa

[Config]
Expand=#INCLUDE(Expand)
RefFiles=../analytics.ref;../bases.ref;changelog.ref;data.ref;pokes.ref;sounds.ref;underwurldeGraphics.ref
HtmlWriterClass=sources:linking.UltimateHtmlWriter
GameDir=ultimate/underwurlde

[Game]
Game=Underwurlde
Logo=#SCR$01,$05,$02,$16,$07,$4000,$5800(/images/logo)
Copyright=&copy; 1984 Ashby Computers &amp; Graphics Ltd<br />&copy; Rare Ltd<br />&copy; 2026 ArcadeGeek LTD.
Repository=https://github.com/pobtastic/ultimate/tree/main/sources/underwurlde/
StyleSheet=skoolkit.css;skoolkit-dark.css;skoolkit-wide.css;underwurlde.css

[PageHeaders]
GameIndex=The complete<>RAM disassembly (work in progress)

[Index]
MemoryMaps
Graphics
DataTables
Reference

[Index:Graphics:Graphics And Sounds]
Graphics
Sound

[Index:Reference:Reference]
Changelog
Pokes

[Links]
Graphics=[Graphics]
Sound=[Sound]

[Paths]
Graphics=graphics/graphics.html
Sound=sound/sounds.html

[Page:Graphics]
SectionPrefix=Graphics

[Page:Sound]
SectionPrefix=Audio

[Expand]
#DEF(#CONVERTFF(addr)
  #LET(length=#PEEK($addr) * #PEEK($addr + $01))
  #FOR($00,{length})||n|
    #IF(#PEEK($02 + $addr + n) == $FF)(#POKES(($02 + $addr + n), $47))
  ||
)

#DEF(#NOCROP(a,s,c)(f)
  #LET(e=$a+(((({height}+$07)/$08)*$08)*$s)-$01)
  #LET(r=$s*$08)
  #UDGARRAY($s,$c,4,$s,0,2)(($a)-({e})-$01-({r}))($f)
)

#DEF(#CROP(a,s,c)(f)
  #LET(e=$a+(((({height}+$07)/$08)*$08)*$s)-$01)
  #LET(r=$s*$08)
  #LET(y=$04*($08-({height}%$08)))
  #LET(w=$04*$s*$08)
  #LET(h=$04*{height})
  #UDGARRAY($s,$c,4,$s,0,2)(($a)-({e})-$01-({r})){$00,{y},{w},{h}}($f)
)

#DEF(#SPRITE(id,attr=$07)(fname)
  #LET(addr=#PEEK($9332+$id*$02)+#PEEK($9333+$id*$02)*$100)
  #LET(width=#PEEK({addr}))
  #LET(height=#PEEK({addr}+$01))
  #IF({height}%$08)(
    #CROP({addr}+$02,{width},$attr)($fname),
    #NOCROP({addr}+$02,{width},$attr)($fname)
  )
)

#DEF(#SPRITEDATA()(fname)
  #LET(width=#PEEK(#PC-$02))
  #LET(height=#PEEK(#PC-$01))
  #IF({height}%$08)(
    #CROP(#PC,{width},$07)($fname),
    #NOCROP(#PC,{width},$07)($fname)
  )
)
