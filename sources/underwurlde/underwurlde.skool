; Make Dust Puff
;
; Used by the routine at #R$B58C.
; .
; Makes a puff of dust at the position of an object, by copying the object
; to the record at #R$8F4A and changing the type of the copy to #N$4A.
; Nothing happens if that record is already in use. The puff lasts for four
; frames (see #R$DEE8). The routine finishes by playing a deep tone.
;
; IX Object record of the object that makes the puff
@label=Make_Dust_Puff
c$DEB8 LD A,($8F4A)  ; Fetch the type of the dust record.
 $DEBB AND A         ; {Return if the record is already in use.
 $DEBC RET NZ        ; }
 $DEBD PUSH IX       ; {Copy the address of the object record to #REGhl.
 $DEBF POP HL        ; }
 $DEC0 LD DE,$8F4A   ; Point #REGde at #R$8F4A.
 $DEC3 LD BC,$000F   ; Set a counter of #N$0F bytes.
 $DEC6 LDIR          ; Copy the object to the dust record, except for its
                     ; redraw flags.
 $DEC8 LD A,$4A      ; {Set the type of the new object to #N$4A, which is a
 $DECA LD ($8F4A),A  ; puff of dust.}
 $DECD LD A,$04      ; {Set the counter in byte #N$08 to #N$04.
 $DECF LD ($8F52),A  ; }
 $DED2 LD A,$01      ; {Set the redraw flags to #N$01, so that the puff is drawn without
 $DED4 LD ($8F59),A  ; being erased first.}
 $DED7 JP $A173      ; Jump to #R$A173.

; Burst Into Dust
;
; Used by the routine at #R$B58C.
; .
; Turns an object (a thrown weapon that has hit something) into a puff of
; dust of the type #N$48, which lasts for four frames (see #R$DEE8). A noise is
; made and the puff is drawn.
;
; IX Object record
@label=Burst_Into_Dust
c$DEDA LD (IX+$00),$48 ; Change the object into a puff of dust.
 $DEDE LD (IX+$08),$04 ; Set the counter in byte #N$08 to #N$04.
 $DEE2 CALL $A131      ; Make a noise.
 $DEE5 JP $96CB        ; Jump to #R$96CB.

; Handle Dust
;
; Handler for the object types #N$48 to #N$4B (a puff of dust). The
; counter in byte #N$08 goes down on every call and the puff is removed, and
; erased, when it reaches zero. Bit 0 of the type follows bit 0 of the counter,
; which makes the puff flicker between two frames. The puff is removed if
; Sabreman is not in its room.
;
; IX Object record
@label=Handle_Dust
c$DEE8 CALL $989F    ; Save the state of the puff.
 $DEEB LD A,($8F1C)  ; Fetch the room x of Sabreman.
 $DEEE CP (IX+$02)   ; {Jump to #R$B6E3 to remove the puff if it is in a
 $DEF1 JP NZ,$B6E3   ; different room x.}
 $DEF4 LD A,($8F1E)  ; Fetch the room y of Sabreman.
 $DEF7 CP (IX+$04)   ; {Jump to #R$B6E3 to remove the puff if it is in a
 $DEFA JP NZ,$B6E3   ; different room y.}
 $DEFD DEC (IX+$08)  ; {Decrease the counter and jump to #R$B6D3 to remove the puff when it
 $DF00 JP Z,$B6D3    ; reaches zero.}
 $DF03 LD A,(IX+$08) ; Fetch the counter.
 $DF06 AND %00000001 ; Keep only bit 0.
 $DF08 LD B,A        ; Store it in #REGb.
 $DF09 LD A,(IX+$00) ; Fetch the type.
 $DF0C AND %11111110 ; Reset bit 0.
 $DF0E ADD A,B       ; Add bit 0 of the counter.
 $DF0F LD (IX+$00),A ; Store the type.
 $DF12 JP $96CB      ; Jump to #R$96CB.

; Handle Explosion
;
; Handler for the object types #N$4C to #N$4F (an explosion). It works
; like #R$DEE8, but the explosion starts with a counter of #N$09 and the two low
; bits of the type follow the two low bits of the counter, so the explosion goes
; through four frames.
;
; IX Object record
@label=Handle_Explosion
c$DF15 CALL $989F    ; Save the state of the explosion.
 $DF18 LD A,($8F1C)  ; Fetch the room x of Sabreman.
 $DF1B CP (IX+$02)   ; {Jump to #R$B6E3 to remove the explosion if it is in a different room
 $DF1E JP NZ,$B6E3   ; x.}
 $DF21 LD A,($8F1E)  ; Fetch the room y of Sabreman.
 $DF24 CP (IX+$04)   ; {Jump to #R$B6E3 to remove the explosion if it is in a different room
 $DF27 JP NZ,$B6E3   ; y.}
 $DF2A DEC (IX+$08)  ; {Decrease the counter and jump to #R$B6D3 to remove the explosion
 $DF2D JP Z,$B6D3    ; when it reaches zero.}
 $DF30 LD A,(IX+$08) ; Fetch the counter.
 $DF33 AND %00000011 ; Keep only the two low bits.
 $DF35 LD B,A        ; Store them in #REGb.
 $DF36 LD A,(IX+$00) ; Fetch the type.
 $DF39 AND %11111100 ; Reset the two low bits.
 $DF3B ADD A,B       ; Add the two low bits of the counter.
 $DF3C LD (IX+$00),A ; Store the type.
 $DF3F JP $96CB      ; Jump to #R$96CB.

; Destroy Creature
;
; Used by the routines at #R$B3D4, #R$E027, #R$E556 and #R$ECCA.
; .
; Destroys a creature. The sound of the creature being destroyed is
; played, the type of the creature is added to the score (see #R$A045) and the
; creature turns into an explosion of the type #N$4C, which lasts for nine
; frames (see #R$DF15).
;
; IX Object record of the creature
@label=Destroy_Creature
c$DF42 CALL $A107      ; Play the sound of a creature being destroyed.
 $DF45 LD C,(IX+$00)   ; Fetch the type of the creature into #REGc.
 $DF48 LD B,$00        ; Clear #REGb, so that #REGbc holds the points for the
                       ; creature.
 $DF4A CALL $A045      ; Add the points for the creature (its type) to the
                       ; score.
 $DF4D LD (IX+$00),$4C ; Change the creature into an explosion.
 $DF51 LD (IX+$08),$09 ; Set the counter in byte #N$08 to #N$09.
 $DF55 JP $96CB        ; Jump to #R$96CB.

; Spawn Falling Stalactite
;
; Used by the routine at #R$91C0.
; .
; Lets a stalactite fall from the ceiling of a cave room every now and
; then. Nothing happens in a special room, in a room that has no ceiling, or
; while the stalactite record at #R$8F3A is in use. The stalactite is
; only made when the low four bits of the tick counter and the frame counter,
; combined, are zero.
; .
; The record is a copy of the record of Sabreman, so the stalactite falls from
; the same x position, with the type #N$50, the y position #N$40, the attribute
; #N$46 (yellow) and a y velocity of #N$10 (see #R$DF98).
@label=Spawn_Falling_Stalactite
c$DF58 LD A,(IX+$04) ; Fetch the room y of the object.
 $DF5B CP $10        ; {Return if it is a special room.
 $DF5D RET C         ; }
 $DF5E LD A,($AAAC)  ; Fetch the flags of the room that Sabreman is in.
 $DF61 AND %00000001 ; Keep only bit 0 (the ceiling).
 $DF63 RET Z         ; Return if the room has no ceiling.
 $DF64 LD A,($8F3A)  ; Fetch the type of the stalactite record.
 $DF67 AND A         ; {Return if the record is already in use.
 $DF68 RET NZ        ; }
 $DF69 LD A,($8ED6)  ; {Fetch the tick counter and keep it in #REGb.
 $DF6C LD B,A        ; }
 $DF6D LD A,($5C78)  ; Fetch the low byte of the frame counter.
 $DF70 OR B          ; Combine it with the tick counter.
 $DF71 AND %00001111 ; Keep only the low four bits.
 $DF73 RET NZ        ; Return unless they are zero.
 $DF74 LD HL,$8F1A   ; Point #REGhl at #R$8F1A.
 $DF77 LD DE,$8F3A   ; Point #REGde at #R$8F3A.
 $DF7A LD BC,$0010   ; Set a counter of #N$10 bytes.
 $DF7D PUSH DE       ; Stash the address of the stalactite record.
 $DF7E LDIR          ; Copy the record of Sabreman to the stalactite record.
 $DF80 POP HL        ; Restore the address of the stalactite record to #REGhl.
 $DF81 LD (HL),$50   ; Set the type to #N$50.
 $DF83 INC HL        ; {Move to the y position.
 $DF84 INC HL        ;
 $DF85 INC HL        ; }
 $DF86 LD (HL),$40   ; Set the y position to #N$40.
 $DF88 INC HL        ; {Move to the attribute.
 $DF89 INC HL        ; }
 $DF8A LD (HL),$46   ; Set the attribute to #N$46 (yellow).
 $DF8C INC HL        ; {Move to the y velocity.
 $DF8D INC HL        ;
 $DF8E INC HL        ;
 $DF8F INC HL        ; }
 $DF90 LD (HL),$10   ; Set the y velocity to #N$10.
 $DF92 LD A,$01      ; {Set the redraw flags of the stalactite to #N$01, so that it is drawn
 $DF94 LD ($8F49),A  ; without being erased first.}
 $DF97 RET           ; Return.

; Handle Falling Stalactite
;
; Handler for the object type #N$50, a stalactite that falls from the
; ceiling towards Sabreman (see #R$DF58).
; .
; The y velocity (byte #N$09) goes up by two on every call, to a limit of #N$6D,
; and the y position and its fraction (byte #N$0D) change by sixteen times the
; velocity. The stalactite lands on a decoration if it touches the top of one
; near the middle of it. It lands on the floor if the room has one, and if the
; room has no floor it falls into the room below. When it lands it becomes the
; type #N$51 (see #R$E027) and is not a stalactite any more.
; .
; If Sabreman is not in the room the stalactite carries on falling but is not
; drawn. The countdown in byte #N$0A, which is reset to #N$50 while Sabreman is
; in the room, removes it when he has been away for long enough.
;
; IX Object record
@label=Handle_Falling_Stalactite
c$DF98 CALL $989F      ; Save the state of the stalactite.
 $DF9B LD A,(IX+$09)   ; Fetch the y velocity.
 $DF9E ADD A,$02       ; Add two to the y velocity, as gravity pulls the
                       ; stalactite down.
 $DFA0 CP $6E          ; {Jump to #R$DFA7 if the stalactite is falling at full speed (the y
 $DFA2 JR NC,$DFA7     ; velocity has reached #N$6E).}
 $DFA4 LD (IX+$09),A   ; Store the y velocity.
@label=Handle_Falling_Stalactite_Move
*$DFA7 LD L,(IX+$09)   ; Fetch the y velocity into #REGl.
 $DFAA LD H,$00        ; Clear the high byte of the y velocity (as a word).
 $DFAC ADD HL,HL       ; {Multiply the y velocity by sixteen.
 $DFAD ADD HL,HL       ;
 $DFAE ADD HL,HL       ;
 $DFAF ADD HL,HL       ; }
 $DFB0 LD C,(IX+$0D)   ; Fetch the fraction of the y position.
 $DFB3 LD B,(IX+$03)   ; Fetch the y position.
 $DFB6 ADD HL,BC       ; Add the y velocity.
 $DFB7 LD (IX+$0D),L   ; Store the new fraction of the y position.
 $DFBA LD (IX+$03),H   ; Store the new y position.
 $DFBD CALL $98CC      ; Read the world map entry of the room that the stalactite is in. The
                       ; flags of the room are returned in #REGe.
 $DFC0 LD A,E          ; Copy the flags of the room to #REGa.
 $DFC1 AND %00010000   ; Keep only bit 4 (the floor).
 $DFC3 LD A,H          ; Fetch the new y position.
 $DFC4 JR Z,$DFCC      ; Jump to #R$DFCC if the room has no floor.
 $DFC6 CP $9F          ; {Jump to #R$DFE3 if the stalactite has reached the
 $DFC8 JR NC,$DFE3     ; floor.}
 $DFCA JR $DFD1        ; Jump to #R$DFD1.
@label=Handle_Falling_Stalactite_No_Floor
*$DFCC CP $BF          ; {Jump to #R$E00D if the stalactite has fallen out of the bottom of
 $DFCE JP NC,$E00D     ; the room.}
@label=Handle_Falling_Stalactite_Check_Decorations
*$DFD1 CALL $B43E      ; Check for contact with the decorations.
 $DFD4 BIT 1,C         ; {Jump to #R$DFF4 if the stalactite is not on top of a
 $DFD6 JR Z,$DFF4      ; decoration.}
 $DFD8 BIT 0,C         ; {Jump to #R$DFF4 if the stalactite is not near the middle of the
 $DFDA JR NZ,$DFF4     ; decoration.}
 $DFDC LD A,B          ; Copy #N$A0 less the y position of the top of the decoration to
                       ; #REGa.
 $DFDD NEG             ; Negate it.
 $DFDF ADD A,$A1       ; Add #N$A1, to get the y position just below the top of the
                       ; decoration.
 $DFE1 JR $DFE9        ; Jump to #R$DFE9.
@label=Handle_Falling_Stalactite_Land_On_Floor
*$DFE3 LD A,(IX+$03)   ; Fetch the y position.
 $DFE6 AND %11111000   ; Round it down to a multiple of eight.
 $DFE8 DEC A           ; Subtract one.
@label=Handle_Falling_Stalactite_Shatter
*$DFE9 LD (IX+$03),A   ; Store the y position.
 $DFEC LD (IX+$00),$51 ; Change the stalactite into the first piece of rock.
 $DFF0 LD (IX+$06),$00 ; Reset the counter in byte #N$06.
@label=Handle_Falling_Stalactite_Check_Room
*$DFF4 LD A,($8F1C)    ; Fetch the room x of Sabreman.
 $DFF7 CP (IX+$02)     ; {Jump to #R$E01C if the stalactite is in a different
 $DFFA JP NZ,$E01C     ; room x.}
 $DFFD LD A,($8F1E)    ; Fetch the room y of Sabreman.
 $E000 CP (IX+$04)     ; {Jump to #R$E01C if the stalactite is in a different
 $E003 JP NZ,$E01C     ; room y.}
 $E006 LD (IX+$0A),$50 ; Reset the countdown to #N$50.
 $E00A JP $96CB        ; Jump to #R$96CB.
@label=Handle_Falling_Stalactite_Next_Room
*$E00D LD (IX+$03),$40 ; Set the y position to #N$40.
 $E011 INC (IX+$04)    ; Move the stalactite to the room below.
 $E014 BIT 0,(IX+$0F)  ; {Return if the stalactite has not been drawn yet.
 $E018 RET NZ          ; }
 $E019 JP $9636        ; Erase the sprite of the stalactite.
@label=Handle_Falling_Stalactite_Count_Down
*$E01C DEC (IX+$0A)    ; {Decrease the countdown and jump to #R$B6E3 to remove the stalactite
 $E01F JP Z,$B6E3      ; when it reaches zero.}
 $E022 SET 0,(IX+$0F)  ; Set bit 0 of the redraw flags, as the stalactite is not on the
                       ; screen.
 $E026 RET             ; Return.

; Handle Rock Fragments
;
; Handler for the object types #N$51 to #N$53 (the pieces of a stalactite
; that has landed). The counter in byte #N$06 goes up on every call. The type
; goes up by one on every second call, and when it would go past #N$53 the piece
; moves four pixels to the left and is destroyed (see #R$DF42). The piece is
; removed if Sabreman is not in the room.
;
; IX Object record
@label=Handle_Rock_Fragments
c$E027 CALL $989F     ; Save the state of the piece.
 $E02A LD A,($8F1C)   ; Fetch the room x of Sabreman.
 $E02D CP (IX+$02)    ; {Jump to #R$B6E3 to remove the piece if it is in a
 $E030 JP NZ,$B6E3    ; different room x.}
 $E033 LD A,($8F1E)   ; Fetch the room y of Sabreman.
 $E036 CP (IX+$04)    ; {Jump to #R$B6E3 to remove the piece if it is in a
 $E039 JP NZ,$B6E3    ; different room y.}
 $E03C INC (IX+$06)   ; Increase the counter.
 $E03F BIT 0,(IX+$06) ; {Jump to #R$96CB if the counter is odd.
 $E043 JP NZ,$96CB    ; }
 $E046 LD A,(IX+$00)  ; Fetch the type.
 $E049 INC A          ; Add one.
 $E04A CP $54         ; {Jump to #R$E054 if the type is past #N$53.
 $E04C JR NC,$E054    ; }
 $E04E LD (IX+$00),A  ; Store the type.
 $E051 JP $96CB       ; Jump to #R$96CB.
@label=Handle_Rock_Fragments_Explode
*$E054 LD A,(IX+$01)  ; Fetch the x position.
 $E057 SUB $04        ; Subtract four.
 $E059 LD (IX+$01),A  ; Store the x position.
 $E05C JP $DF42       ; Destroy the piece.

; Spawn Bubble
;
; Used by the routine at #R$91C0.
; .
; Starts a bubble at the bottom of the room every now and then.
; .
; Nothing happens in a special room (a room y below #N$10), or when the type of
; Sabreman is #N$3C or more, which means that he is dying or being carried. The
; bubble takes one of the four bubble records that start at #R$8F5A, if
; one is free. A bubble is only made when the low byte of the frame counter plus
; #N$1A has its low six bits clear.
; .
; The record is a copy of the record of Sabreman, so the bubble is in his room.
; Its type is #N$58, its y position is #N$BF (the bottom of the room), its
; attribute is #N$46 (yellow) and its x position is #N$40 or #N$C0, depending on
; bit 7 of the tick counter. The handler is #R$E117.
@label=Spawn_Bubble
c$E05F LD A,($8F1A)  ; Fetch the type of Sabreman.
 $E062 CP $3C        ; {Return if the type is #N$3C or more.
 $E064 RET NC        ; }
 $E065 LD A,($8F1E)  ; Fetch the room y of Sabreman.
 $E068 CP $10        ; {Return if it is a special room.
 $E06A RET C         ; }
 $E06B LD HL,$8F5A   ; Point #REGhl at #R$8F5A.
 $E06E LD DE,$0010   ; Set #REGde to the size of an object record.
 $E071 LD B,$04      ; Set a counter in #REGb for the four bubble records.
@label=Spawn_Bubble_Find_Record
*$E073 LD A,(HL)     ; Fetch the type of the record.
 $E074 AND A         ; {Jump to #R$E07B if the record is free.
 $E075 JR Z,$E07B    ; }
 $E077 ADD HL,DE     ; Move on to the next record.
 $E078 DJNZ $E073    ; Decrease the record counter and loop back for the next
                     ; record.
 $E07A RET           ; Return, as all four bubble records are in use.
@label=Spawn_Bubble_Create
*$E07B EX DE,HL      ; Point #REGde at the free record.
 $E07C LD HL,$8F1A   ; Point #REGhl at #R$8F1A.
 $E07F LD A,($5C78)  ; Fetch the low byte of the frame counter.
 $E082 ADD A,L       ; Add the low byte of the address of the record of
                     ; Sabreman.
 $E083 AND %00111111 ; Keep only the low six bits.
 $E085 RET NZ        ; Return unless they are zero.
 $E086 LD BC,$000F   ; Set a counter of #N$0F bytes.
 $E089 PUSH DE       ; Stash the address of the bubble record.
 $E08A LDIR          ; Copy the record of Sabreman to the bubble record, except for the
                     ; redraw flags.
 $E08C POP HL        ; Restore the address of the bubble record to #REGhl.
 $E08D LD A,$58      ; {Set the type to #N$58.
 $E08F LD (HL),A     ; }
 $E090 LD A,($8ED6)  ; Fetch the tick counter.
 $E093 AND %10000000 ; Keep only bit 7.
 $E095 ADD A,$40     ; Add #N$40, which makes #N$40 or #N$C0.
 $E097 INC HL        ; Move to the x position.
 $E098 LD (HL),A     ; Set the x position.
 $E099 INC HL        ; {Move to the y position.
 $E09A INC HL        ; }
 $E09B LD (HL),$BF   ; Set the y position to #N$BF.
 $E09D INC HL        ; {Move to the attribute.
 $E09E INC HL        ; }
 $E09F LD (HL),$46   ; Set the attribute to #N$46 (yellow).
 $E0A1 LD A,$01      ; #REGa=#N$01 (the value of the redraw flags).
 $E0A3 LD DE,$000A   ; Set the offset from the attribute to the redraw flags of the record
                     ; (#N$000A).
 $E0A6 ADD HL,DE     ; Move to the redraw flags.
 $E0A7 LD (HL),A     ; Set the redraw flags to #N$01, so that the bubble is drawn without
                     ; being erased first.
 $E0A8 RET           ; Return.

; Release Bubble
;
; Used by the routine at #R$AF3F.
; .
; Lets an object (the object of type #N$54, see #R$AF3F) release a bubble
; every now and then. The bubble takes one of the four bubble records that start
; at #R$8F5A, if one is free. A bubble is only made when the low byte
; of the frame counter plus the low byte of the address of the object has its
; low six bits clear.
; .
; The record is a copy of the record of the object, with the type #N$58 and an x
; position that is #N$0C more. The room is the room that Sabreman is in.
;
; IX Object record of the object that releases the bubble
@label=Release_Bubble
c$E0A9 LD HL,$8F5A   ; Point #REGhl at the first bubble record.
 $E0AC LD DE,$0010   ; Set #REGde to the size of an object record.
 $E0AF LD B,$04      ; Set a counter in #REGb for the four bubble records.
@label=Release_Bubble_Find_Record
*$E0B1 LD A,(HL)     ; Fetch the type of the record.
 $E0B2 AND A         ; {Jump to #R$E0B9 if the record is free.
 $E0B3 JR Z,$E0B9    ; }
 $E0B5 ADD HL,DE     ; Move on to the next record.
 $E0B6 DJNZ $E0B1    ; Decrease the record counter and loop back for the next
                     ; record.
 $E0B8 RET           ; Return, as all four bubble records are in use.
@label=Release_Bubble_Create
*$E0B9 PUSH IX       ; Point #REGhl at the record of the object, and #REGde at the free
                     ; record.
 $E0BB EX DE,HL      ; Exchange #REGde and #REGhl.
 $E0BC POP HL        ; Restore #REGhl from the stack.
 $E0BD LD A,($5C78)  ; Fetch the low byte of the frame counter.
 $E0C0 ADD A,L       ; Add the low byte of the address of the record of the
                     ; object.
 $E0C1 AND %00111111 ; Keep only the low six bits.
 $E0C3 RET NZ        ; Return unless they are zero.
 $E0C4 LD BC,$000F   ; Set a counter of #N$0F bytes.
 $E0C7 PUSH DE       ; Stash the address of the bubble record.
 $E0C8 LDIR          ; Copy the record of the object to the bubble record, except for the
                     ; redraw flags.
 $E0CA POP HL        ; Restore the address of the bubble record to #REGhl.
 $E0CB LD A,$58      ; {Set the type to #N$58.
 $E0CD LD (HL),A     ; }
 $E0CE LD A,(IX+$01) ; Fetch the x position of the object.
 $E0D1 ADD A,$0C     ; Add #N$0C.
 $E0D3 INC HL        ; Move to the x position.
 $E0D4 LD (HL),A     ; Set the x position.
 $E0D5 INC HL        ; Move to the room x.
 $E0D6 LD A,($8F1C)  ; Fetch the room x of Sabreman.
 $E0D9 LD (HL),A     ; Set the room x.
 $E0DA INC HL        ; {Move to the room y.
 $E0DB INC HL        ; }
 $E0DC LD A,($8F1E)  ; Fetch the room y of Sabreman.
 $E0DF LD (HL),A     ; Set the room y.
 $E0E0 LD A,$01      ; #REGa=#N$01 (the value of the redraw flags).
 $E0E2 LD DE,$000B   ; Set the offset to the redraw flags of the record
                     ; (#N$000B).
 $E0E5 ADD HL,DE     ; Move to the redraw flags.
 $E0E6 LD (HL),A     ; Set the redraw flags to #N$01, so that the bubble is drawn without
                     ; being erased first.
 $E0E7 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #JETPAC$6F97 }
; { #LUNARJETMAN$9DC6 }
; LIST#

; Move Distant Bubble
;
; Used by the routine at #R$E117.
; .
; Moves a bubble that is not in the room that Sabreman is in. The bubble
; rises by two pixels each time. The countdown in byte #N$0A removes the bubble
; when it reaches zero. A bubble in a room with a ceiling is removed when it
; reaches the ceiling. A bubble in a room with no ceiling moves into the room
; above when it reaches the top.
;
; IX Object record
@label=Move_Distant_Bubble
c$E0E8 DEC (IX+$0A)    ; {Decrease the countdown and jump to #R$B6E3 to remove the bubble when
 $E0EB JP Z,$B6E3      ; it reaches zero.}
 $E0EE SET 0,(IX+$0F)  ; Set bit 0 of the redraw flags, as the bubble is not on
                       ; the screen.
 $E0F2 LD A,(IX+$03)   ; Fetch the y position.
 $E0F5 SUB $02         ; Subtract two.
 $E0F7 LD (IX+$03),A   ; Store the y position.
 $E0FA BIT 0,(IX+$0B)  ; {Jump to #R$E106 if the room had no ceiling.
 $E0FE JR Z,$E106      ; }
 $E100 CP $42          ; {Remove the bubble if the y position is less than
 $E102 JP C,$B6E3      ; #N$42.}
 $E105 RET             ; Return.
@label=Move_Distant_Bubble_No_Ceiling
*$E106 CP $22          ; {Return if the y position is #N$22 or more.
 $E108 RET NC          ; }
 $E109 LD (IX+$03),$BF ; Set the y position to #N$BF.
 $E10D DEC (IX+$04)    ; Move the bubble to the room above.
 $E110 CALL $98CC      ; Read the world map entry of the room that the bubble
                       ; is in now.
 $E113 LD (IX+$0B),E   ; Store the flags of the room in the contact flags.
 $E116 RET             ; Return.

; Handle Bubble
;
; Handler for the object types #N$58 to #N$5B (a bubble that rises). A
; bubble is made by #R$E05F, or by #R$E0A9.
; .
; The bubble rises by two pixels on each call. The contact flags (byte #N$0B)
; are set to the flags of the room, which lets other objects stand on top of it
; (see #R$E1B4). The counter in byte #N$06 goes up on each call and makes the
; two low bits of the type, so the bubble goes through three frames.
; .
; A bubble in a room with a ceiling bursts when it reaches the ceiling and
; becomes a sparkle (the type #N$72, see #R$E18C). A bubble in a room with no
; ceiling moves into the room above when it reaches the top. A bubble that has
; just been made in a room with a floor and a ceiling, and is #N$AF or more down
; the screen, is removed.
; .
; If the bubble is in a different room from Sabreman, #R$E0E8 moves it.
;
; IX Object record
@label=Handle_Bubble
c$E117 CALL $989F      ; Save the state of the bubble.
 $E11A LD A,($8F1C)    ; Fetch the room x of Sabreman.
 $E11D CP (IX+$02)     ; {Jump to #R$E0E8 if the bubble is in a different room
 $E120 JP NZ,$E0E8     ; x.}
 $E123 LD A,($8F1E)    ; Fetch the room y of Sabreman.
 $E126 CP (IX+$04)     ; {Jump to #R$E0E8 if the bubble is in a different room
 $E129 JP NZ,$E0E8     ; y.}
 $E12C DEC (IX+$03)    ; {Move the bubble up two pixels.
 $E12F DEC (IX+$03)    ; }
 $E132 LD (IX+$0A),$50 ; Reset the countdown in byte #N$0A to #N$50.
 $E136 CALL $98CC      ; Read the world map entry of the room that the bubble is in. The
                       ; flags of the room are returned in #REGe.
 $E139 LD (IX+$0B),E   ; Store the flags of the room in the contact flags.
 $E13C BIT 0,E         ; Test bit 0 of the flags (the ceiling).
 $E13E LD A,(IX+$03)   ; Fetch the y position.
 $E141 JR Z,$E16B      ; Jump to #R$E16B if the room has no ceiling.
 $E143 CP $42          ; {Jump to #R$E17A if the bubble has reached the
 $E145 JP C,$E17A      ; ceiling.}
 $E148 CP $AF          ; {Jump to #R$E15B if the y position is less than #N$AF.
 $E14A JR C,$E15B      ; }
 $E14C BIT 4,E         ; {Jump to #R$E15B if the room has no floor.
 $E14E JR Z,$E15B      ; }
 $E150 BIT 0,(IX+$0F)  ; {Jump to #R$E15B if the bubble has been drawn already.
 $E154 JR Z,$E15B      ; }
 $E156 LD (IX+$00),$00 ; Remove the bubble.
 $E15A RET             ; Return.
@label=Handle_Bubble_Animate
*$E15B INC (IX+$06)    ; Add one to the animation counter of the bubble.
 $E15E LD A,(IX+$06)   ; Fetch the animation counter of the bubble.
 $E161 AND %00000011   ; Keep only the two low bits.
 $E163 ADD A,$58       ; Add #N$58 to make the type.
 $E165 LD (IX+$00),A   ; Store the type.
 $E168 JP $96CB        ; Jump to #R$96CB.
@label=Handle_Bubble_No_Ceiling
*$E16B CP $22          ; {Jump to #R$E15B if the bubble is still in the room.
 $E16D JR NC,$E15B     ; }
 $E16F DEC (IX+$04)    ; Move the bubble to the room above.
 $E172 BIT 0,(IX+$0F)  ; {Return if the bubble has not been drawn yet.
 $E176 RET NZ          ; }
 $E177 JP $9636        ; Erase the sprite of the bubble.
@label=Handle_Bubble_Pop
*$E17A BIT 0,(IX+$0F)  ; {Jump to #R$B6E3 to remove the bubble if it has not
 $E17E JP NZ,$B6E3     ; been drawn yet.}
 $E181 LD (IX+$00),$72 ; Change the bubble into a sparkle.
 $E185 LD (IX+$08),$03 ; Set the counter in byte #N$08 to #N$03.
 $E189 JP $96CB        ; Jump to #R$96CB.

; Handle Sparkle
;
; Handler for the object types #N$72 and #N$73, the sparkle that shows
; where a bubble has burst (see #R$E117). The counter in byte #N$08 goes down on
; each call and the sprite id alternates between #N$72 and #N$73 with it. The
; sparkle is removed (and erased) when the counter reaches zero, and at once if
; Sabreman is not in the room.
;
; IX Object record
@label=Handle_Sparkle
c$E18C CALL $989F    ; Save the state of the sparkle.
 $E18F LD A,($8F1C)  ; Fetch the room x of Sabreman.
 $E192 CP (IX+$02)   ; {Jump to #R$B6E3 to remove the sparkle if it is in a different room
 $E195 JP NZ,$B6E3   ; x.}
 $E198 LD A,($8F1E)  ; Fetch the room y of Sabreman.
 $E19B CP (IX+$04)   ; {Jump to #R$B6E3 to remove the sparkle if it is in a different room
 $E19E JP NZ,$B6E3   ; y.}
 $E1A1 DEC (IX+$08)  ; {Decrease the counter and jump to #R$B6D3 to remove and erase the
 $E1A4 JP Z,$B6D3    ; sparkle when it reaches zero.}
 $E1A7 LD A,(IX+$08) ; Fetch the counter.
 $E1AA AND %00000001 ; Keep only bit 0.
 $E1AC ADD A,$72     ; Add #N$72 to make the sprite id.
 $E1AE LD (IX+$00),A ; Store the sprite id.
 $E1B1 JP $96CB      ; Jump to #R$96CB.

; Check Bubble Contact
;
; Used by the routines at #R$A316, #R$A433, #R$A5F1, #R$A6A6, #R$A925, #R$B079
; and #R$E2CB.
; .
; Checks whether an object is touching one of the four bubbles (the object
; records that start at #R$8F5A and have the type #N$58 to #N$5B).
; .
; No bubble is touched if bit 4 or bit 5 of the countdown in byte #N$0A is set.
; This is the case for Sabreman for a while after he has started to fall, and it
; lets him get away from a bubble.
; .
; An object touches a bubble when the two are in the same room, the x positions
; differ by less than #N$0D and the y position of the object is between zero and
; #N$0E pixels above the y position of the bubble.
; .
; When there is contact the result in #REGc has bit 2 and bit 1 set (a bubble is
; always taken as being under the object). Bit 7 is set if the object is to the
; right of the bubble. Bits 5 and 0 are set if the x positions differ by #N$0A
; or more, which means that the object is not near the middle of the bubble.
; Otherwise the y position of the object is set to #N$0E less than that of the
; bubble so that it stands on it, and bit 4 of #REGe and bit 4 of the contact
; flags (byte #N$0B) are set.
; .
; If the object is Sabreman (the type is between #N$09 and #N$1B) and he is
; touching a bubble while he is near the top of the room (the y position is less
; than #N$48) then the bubble pushes him up. In a room with a ceiling he starts
; tumbling (see #R$E272), which draws him and ends the handler that called this
; routine. In a room with no ceiling he moves into the room above, if his y
; position is less than #N$2C. The y position then becomes #N$AF, the first
; bubble record becomes a copy of the record of Sabreman as a bubble (#N$58) at
; the y position #N$B8, and the new room is drawn.
;
;   IX Object record
;   E Flags of the room (see #R$98CC)
; O:B #N$A0 less the y position of the object (valid when there is contact)
; O:C Contact result
; O:E Flags of the room, with bit 4 set if the object stands on a bubble
@label=Check_Bubble_Contact
c$E1B4 LD C,$00        ; Set the contact result to zero.
 $E1B6 LD A,(IX+$0A)   ; Fetch the countdown.
 $E1B9 AND %00110000   ; Keep only bits 4 and 5.
 $E1BB RET NZ          ; Return if either of them is set.
 $E1BC PUSH DE         ; Stash the flags of the room.
 $E1BD LD HL,$8F5A     ; Point #REGhl at #R$8F5A.
 $E1C0 LD DE,$0010     ; Set #REGde to the size of an object record.
 $E1C3 LD B,$04        ; Set a counter in #REGb for the four bubble records.
@label=Check_Bubble_Contact_Loop
*$E1C5 LD A,(HL)       ; Fetch the type of the record.
 $E1C6 AND %11111100   ; Ignore the two low bits.
 $E1C8 CP $58          ; {Jump to #R$E1D6 if the record holds a bubble.
 $E1CA JR Z,$E1D6      ; }
@label=Check_Bubble_Contact_Next_Record
*$E1CC ADD HL,DE       ; Move on to the next record.
 $E1CD DJNZ $E1C5      ; Decrease the record counter and loop back for the next
                       ; record.
 $E1CF LD C,$00        ; Clear the contact result, as no bubble was touched.
 $E1D1 POP DE          ; Restore the flags of the room.
 $E1D2 RET             ; Return.
@label=Check_Bubble_Contact_Skip
*$E1D3 POP HL          ; Discard the address of the bubble record.
 $E1D4 JR $E1CC        ; Jump to #R$E1CC to try the next bubble.
@label=Check_Bubble_Contact_Found
*$E1D6 PUSH HL         ; Stash the address of the bubble record.
 $E1D7 LD C,$00        ; Clear the contact result.
 $E1D9 INC HL          ; Point #REGhl at the x position of the bubble.
 $E1DA LD A,(HL)       ; Fetch the x position of the bubble.
 $E1DB SUB (IX+$01)    ; {Jump to #R$E1E5 if the object is not to the right of
 $E1DE JP P,$E1E5      ; the bubble.}
 $E1E1 NEG             ; Make the difference positive.
 $E1E3 SET 7,C         ; Set bit 7 of the contact result, as the object is to the right of
                       ; the bubble.
@label=Check_Bubble_Contact_Check_Width
*$E1E5 CP $0D          ; {Jump to #R$E1D3 if the difference is #N$0D or more.
 $E1E7 JR NC,$E1D3     ; }
 $E1E9 CP $0A          ; {Jump to #R$E1F1 if the difference is less than #N$0A.
 $E1EB JR C,$E1F1      ; }
 $E1ED SET 5,C         ; Set bit 5 of the contact result.
 $E1EF SET 0,C         ; Set bit 0 of the contact result.
@label=Check_Bubble_Contact_Check_Room
*$E1F1 INC HL          ; Point #REGhl at the room x of the bubble.
 $E1F2 LD A,(HL)       ; Fetch the room x of the bubble.
 $E1F3 CP (IX+$02)     ; {Jump to #R$E1D3 if the bubble is in a different room
 $E1F6 JR NZ,$E1D3     ; x.}
 $E1F8 INC HL          ; Point #REGhl at the y position of the bubble.
 $E1F9 LD A,(HL)       ; Fetch the y position of the bubble.
 $E1FA SUB (IX+$03)    ; Subtract the y position of the object.
 $E1FD CP $0F          ; {Jump to #R$E1D3 if the object is more than #N$0E above the bubble,
 $E1FF JR NC,$E1D3     ; or below it.}
 $E201 INC HL          ; Point #REGhl at the room y of the bubble.
 $E202 LD A,(HL)       ; Fetch the room y of the bubble.
 $E203 CP (IX+$04)     ; {Jump to #R$E1D3 if the bubble is in a different room
 $E206 JR NZ,$E1D3     ; y.}
 $E208 DEC HL          ; Point #REGhl at the y position of the bubble again.
 $E209 SET 2,C         ; Set bit 2 of the contact result (contact).
 $E20B SET 1,C         ; Set bit 1 of the contact result (the object is on
                       ; top).
 $E20D BIT 0,C         ; {Jump to #R$E217 if the object is not near the middle
 $E20F JR NZ,$E217     ; of the bubble.}
 $E211 LD A,(HL)       ; Fetch the y position of the bubble.
 $E212 SUB $0E         ; Subtract #N$0E.
 $E214 LD (IX+$03),A   ; Set the y position of the object, so that it stands on
                       ; the bubble.
@label=Check_Bubble_Contact_Set_Height
*$E217 LD A,(IX+$03)   ; Fetch the y position of the object.
 $E21A SUB $A0         ; Subtract #N$A0.
 $E21C NEG             ; Negate it.
 $E21E LD B,A          ; Store the result in #REGb.
 $E21F POP HL          ; Discard the address of the bubble record.
 $E220 POP DE          ; Restore the flags of the room to #REGe.
 $E221 BIT 0,C         ; {Jump to #R$E22B if the object is not near the middle
 $E223 JR NZ,$E22B     ; of the bubble.}
 $E225 SET 4,E         ; Set bit 4 of the flags of the room (the floor).
 $E227 SET 4,(IX+$0B)  ; Set bit 4 of the contact flags (standing).
@label=Check_Bubble_Contact_Check_Type
*$E22B LD A,(IX+$00)   ; Fetch the type of the object.
 $E22E CP $1C          ; {Return if the type is #N$1C or more.
 $E230 RET NC          ; }
 $E231 CP $09          ; {Return if the type is less than #N$09.
 $E233 RET C           ; }
 $E234 LD A,(IX+$03)   ; Fetch the y position of the object.
 $E237 CP $48          ; {Return if it is #N$48 or more.
 $E239 RET NC          ; }
 $E23A BIT 0,E         ; {Jump to #R$E271 if the room has a ceiling.
 $E23C JR NZ,$E271     ; }
 $E23E CP $2C          ; {Return if the y position is #N$2C or more.
 $E240 RET NC          ; }
 $E241 DEC (IX+$04)    ; Move Sabreman to the room above.
 $E244 LD (IX+$03),$AF ; Set his y position to #N$AF.
 $E248 LD B,$F1        ; Set #REGb to #N$F1, which is #N$A0 less the new y
                       ; position.
 $E24A PUSH DE         ; Stash the flags of the room.
 $E24B PUSH BC         ; Stash the contact result and #REGb.
 $E24C LD DE,$8F5A     ; Point #REGde at #R$8F5A.
 $E24F LD HL,$8F1A     ; Point #REGhl at #R$8F1A.
 $E252 LD BC,$000F     ; Set a counter of #N$0F bytes.
 $E255 LDIR            ; Copy the record of Sabreman to the bubble record.
 $E257 LD A,$B8        ; Set the y position of the bubble to #N$B8.
 $E259 LD ($8F5D),A    ; Store the y position of the bubble.
 $E25C LD A,$58        ; Set the type of the bubble to #N$58.
 $E25E LD ($8F5A),A    ; Store the type of the bubble.
 $E261 LD A,$01        ; Set the redraw flags of the bubble to #N$01.
 $E263 LD ($8F69),A    ; Store the redraw flags of the bubble.
 $E266 LD A,$46        ; Set the attribute of the bubble to #N$46 (yellow).
 $E268 LD ($8F5F),A    ; Store the attribute of the bubble.
 $E26B CALL $9906      ; Draw the room.
 $E26E POP BC          ; Restore the contact result and #REGb.
 $E26F POP DE          ; Restore the flags of the room.
 $E270 RET             ; Return.
@label=Check_Bubble_Contact_Tumble
*$E271 POP HL          ; Discard the return address, so that the handler of Sabreman that
                       ; called this routine stops here.

; Start Tumbling Downwards
;
; Used by the routine at #R$A433.
; .
; Makes Sabreman tumble downwards, as when a bubble pushes him against a
; ceiling. The sprite becomes #N$18, the countdown (byte #N$0A) is set to #N$1A
; and the y velocity to #N$20.
; .
; The routine ends by drawing Sabreman and returning to the main loop.
;
; IX Object record of Sabreman
@label=Start_Tumbling_Downwards
c$E272 LD (IX+$00),$18 ; Set the sprite id to #N$18 (tumbling).
 $E276 LD (IX+$0A),$1A ; Set the countdown to #N$1A.
 $E27A LD (IX+$09),$20 ; Set the y velocity to #N$20.
 $E27E LD (IX+$0B),$00 ; Clear the contact flags.
 $E282 JP $96CB        ; Jump to #R$96CB.

; Check Sabreman Contact
;
; Used by the routines at #R$B079, #R$E751 and #R$E8D7.
; .
; Checks whether an object is touching Sabreman.
; .
; Nothing is touched if the sprite id of Sabreman is #N$1D or more (he is dying
; or being carried), or if bit 6 of his redraw flags is set (he is being
; carried).
; .
; There is contact when the two are in the same room, the x positions differ by
; less than #N$10 and the y position of Sabreman, less four, differs from that
; of the object by less than #N$0A. A tone is played on contact (see #R$A0F5).
;
;   IX Object record
; O:C Contact result
@label=Check_Sabreman_Contact
c$E285 LD C,$00      ; Clear the contact result.
 $E287 LD A,($8F1A)  ; Fetch the sprite id of Sabreman.
 $E28A CP $1D        ; {Return if it is #N$1D or more.
 $E28C RET NC        ; }
; This entry point is used by the routine at #R$ECCA.
@label=Check_Sabreman_Contact_Clear_Result
*$E28D LD C,$00      ; Clear the contact result.
 $E28F LD A,($8F29)  ; Fetch the redraw flags of Sabreman.
 $E292 AND %01000000 ; Keep only bit 6.
 $E294 RET NZ        ; Return if Sabreman is being carried.
 $E295 LD HL,$8F1B   ; Point #REGhl at #R$8F1B.
 $E298 LD A,(HL)     ; Fetch the x position of Sabreman.
 $E299 SUB (IX+$01)  ; {Subtract the x position of the object, and jump to #R$E2A3 if
 $E29C JP P,$E2A3    ; Sabreman is not to the left of it.}
 $E29F SET 7,C       ; Set bit 7 of the contact result, as Sabreman is to the left of the
                     ; object.
 $E2A1 NEG           ; Make the difference positive.
@label=Check_Sabreman_Contact_Check_Width
*$E2A3 CP $10        ; {Return if the difference is #N$10 or more.
 $E2A5 RET NC        ; }
 $E2A6 INC HL        ; Point #REGhl at the room x of Sabreman.
 $E2A7 LD A,(HL)     ; Fetch the room x of Sabreman.
 $E2A8 CP (IX+$02)   ; {Return if Sabreman is in a different room x from the
 $E2AB RET NZ        ; object.}
 $E2AC INC HL        ; Point #REGhl at the y position of Sabreman.
 $E2AD LD A,(HL)     ; Fetch the y position of Sabreman.
 $E2AE SUB $04       ; Subtract four.
 $E2B0 SUB (IX+$03)  ; {Subtract the y position of the object, and jump to #R$E2BA if
 $E2B3 JP P,$E2BA    ; Sabreman is not above it.}
 $E2B6 NEG           ; Make the difference positive.
 $E2B8 SET 1,C       ; Set bit 1 of the contact result, as Sabreman is above
                     ; the object.
@label=Check_Sabreman_Contact_Check_Height
*$E2BA CP $0A        ; {Return if the difference is #N$0A or more.
 $E2BC RET NC        ; }
 $E2BD INC HL        ; Point #REGhl at the room y of Sabreman.
 $E2BE LD A,(HL)     ; Fetch the room y of Sabreman.
 $E2BF CP (IX+$04)   ; {Return if Sabreman is in a different room y from the
 $E2C2 RET NZ        ; object.}
 $E2C3 SET 2,C       ; Set bit 2 of the contact result (contact).
 $E2C5 PUSH BC       ; Stash the contact result.
 $E2C6 CALL $A0F5    ; Play a tone.
 $E2C9 POP BC        ; Restore the contact result.
 $E2CA RET           ; Return.

; Handle Carrying Eagle
;
; Handler for the object types #N$5C to #N$5F, an eagle that carries
; Sabreman (see #R$B079). Bit 0 of the type is the frame of the animation, which
; follows bit 1 of the tick counter, and bit 1 is set when the x velocity is
; negative.
; .
; While Sabreman is being carried his record has the sprite id #N$60 to #N$63.
; The eagle puts his position in bytes #N$08 (x) and #N$09 (y) of his record (at
; #R$8F22 and #R$8F23), where #R$E570 picks it up. The y
; position is #N$10 more than that of the eagle, so he hangs below it.
; .
; The eagle flies towards a target (byte #N$0C is the x position and byte #N$0E
; the y position, see #R$B73F). Each call changes each velocity by one towards
; the target. The x velocity is kept between #N$D0 and #N$37 and the y velocity
; between #N$C7 and #N$37. The target changes when the eagle bounces off a
; decoration, a bubble, the floor, the ceiling or a wall. The eagle can also fly
; through the gaps in the frame of a room, and into the next room. The player
; can nudge the eagle with the controls (see #R$E420).
; .
; The eagle lets go (see #R$E51B) when the low byte of FRAMES is zero, or when
; Sabreman has set bit 5 of his redraw flags, if it is in the open part of the
; room. If the sprite id of Sabreman is less than #N$1C (he is not being
; carried), the eagle lets go at once (see #R$E556).
;
; IX Object record of the eagle
@label=Handle_Carrying_Eagle
c$E2CB CALL $989F     ; Save the state of the eagle.
 $E2CE LD A,($8F1A)   ; Fetch the sprite id of Sabreman.
 $E2D1 CP $1C         ; {Jump to #R$E556 if he is not being carried.
 $E2D3 JP C,$E556     ; }
 $E2D6 CALL $E420     ; Nudge the eagle if the player presses a direction.
 $E2D9 CALL $98CC     ; Read the world map entry of the room that the eagle is in. The flags
                      ; of the room are returned in #REGe.
 $E2DC LD A,($5C78)   ; Fetch the low byte of FRAMES.
 $E2DF AND A          ; {Call #R$E51B to let go of Sabreman if the low byte of FRAMES is
 $E2E0 CALL Z,$E51B   ; zero.}
 $E2E3 LD A,($8F29)   ; Fetch the redraw flags of Sabreman.
 $E2E6 BIT 5,A        ; Test bit 5, which Sabreman sets to ask the eagle to let
                      ; go.
 $E2E8 RES 5,A        ; Reset bit 5.
 $E2EA LD ($8F29),A   ; Store the redraw flags of Sabreman.
 $E2ED CALL NZ,$E51B  ; Call #R$E51B to let go of Sabreman if bit 5 was set.
; This entry point is used by the routine at #R$B079.
@label=Handle_Carrying_Eagle_Carry
*$E2F0 LD A,$01       ; {Set the flag at #R$8EF1 to show that an eagle is
 $E2F2 LD ($8EF1),A   ; carrying Sabreman.}
 $E2F5 LD A,(IX+$03)  ; Fetch the y position of the eagle.
 $E2F8 ADD A,$10      ; Add #N$10.
 $E2FA CP $9F         ; {Jump to #R$E304 if the result is less than #N$9F.
 $E2FC JR C,$E304     ; }
 $E2FE BIT 4,E        ; {Jump to #R$E304 if the room has no floor.
 $E300 JR Z,$E304     ; }
 $E302 LD A,$9F       ; Limit the y position to #N$9F.
@label=Handle_Carrying_Eagle_Set_Carry_Position
*$E304 LD ($8F23),A   ; Set the y position of Sabreman.
 $E307 LD A,(IX+$01)  ; Fetch the x position of the eagle.
 $E30A LD ($8F22),A   ; Set the x position of Sabreman.
; Work out the type of the eagle. Bit 0 follows bit 1 of the tick counter
; and bit 1 is set when the x velocity is negative.
 $E30D LD A,(IX+$00)  ; Fetch the type of the eagle.
 $E310 AND %11111110  ; Reset bit 0.
 $E312 LD C,A         ; Keep the type without bit 0 in #REGc.
 $E313 LD A,($8ED6)   ; Fetch the tick counter.
 $E316 RRA            ; Move bit 1 into bit 0.
 $E317 AND %00000001  ; Keep only that bit.
 $E319 ADD A,C        ; Add the type.
 $E31A BIT 7,(IX+$08) ; {Jump to #R$E324 if the x velocity is positive.
 $E31E JR Z,$E324     ; }
 $E320 OR %00000010   ; Set bit 1.
 $E322 JR $E326       ; Jump to #R$E326.
@label=Handle_Carrying_Eagle_Face_Right
*$E324 AND %11111101  ; Reset bit 1.
@label=Handle_Carrying_Eagle_Store_Type
*$E326 LD (IX+$00),A  ; Store the type of the eagle.
; Change the x velocity by one towards the target.
 $E329 LD A,(IX+$01)  ; Fetch the x position of the eagle.
 $E32C CP (IX+$0C)    ; Compare it with the x position of the target.
 $E32F LD A,(IX+$08)  ; Fetch the x velocity.
 $E332 JP NC,$E443    ; Jump to #R$E443 if the eagle is at or to the right of
                      ; the target.
 $E335 INC A          ; Add one to the x velocity.
 $E336 BIT 7,A        ; {Jump to #R$E33E if the x velocity is negative.
 $E338 JR NZ,$E33E    ; }
 $E33A CP $38         ; {Jump to #R$E341 if the x velocity has reached #N$38.
 $E33C JR NC,$E341    ; }
; This entry point is used by the routine at #R$E443.
@label=Handle_Carrying_Eagle_Store_X_Velocity
*$E33E LD (IX+$08),A  ; Store the x velocity.
; This entry point is used by the routine at #R$E443.
; .
; Change the y velocity by one towards the target.
@label=Handle_Carrying_Eagle_Adjust_Y_Velocity
*$E341 LD A,(IX+$03)  ; Fetch the y position of the eagle.
 $E344 CP (IX+$0E)    ; Compare it with the y position of the target.
 $E347 LD A,(IX+$09)  ; Fetch the y velocity.
 $E34A JP NC,$E451    ; Jump to #R$E451 if the eagle is at or below the target.
 $E34D INC A          ; Add one to the y velocity.
 $E34E BIT 7,A        ; {Jump to #R$E356 if the y velocity is negative.
 $E350 JR NZ,$E356    ; }
 $E352 CP $38         ; {Jump to #R$E359 if the y velocity has reached #N$38.
 $E354 JR NC,$E359    ; }
; This entry point is used by the routine at #R$E451.
@label=Handle_Carrying_Eagle_Store_Y_Velocity
*$E356 LD (IX+$09),A  ; Store the y velocity.
; This entry point is used by the routine at #R$E451.
; .
; Check for contact with the decorations and the bubbles, and bounce off
; them.
@label=Handle_Carrying_Eagle_Check_Contact
*$E359 PUSH DE        ; Stash the flags of the room.
 $E35A CALL $B43E     ; Check for contact with the decorations.
 $E35D LD D,C         ; Store the result in #REGd.
 $E35E CALL $E1B4     ; Check for contact with the bubbles.
 $E361 LD A,C         ; Copy the result to #REGa.
 $E362 OR D           ; Combine it with the result for the decorations.
 $E363 LD C,A         ; Store the combined result in #REGc.
 $E364 POP DE         ; Restore the flags of the room.
 $E365 BIT 2,C        ; {Jump to #R$E3AF if the eagle is not touching anything.
 $E367 JR Z,$E3AF     ; }
 $E369 BIT 1,C        ; {Jump to #R$E381 if the eagle is not on top of the
 $E36B JR Z,$E381     ; object.}
 $E36D BIT 5,C        ; {Jump to #R$E390 if the object is a bubble and the eagle is away from
 $E36F JR NZ,$E390    ; the middle of it.}
 $E371 LD A,(IX+$09)  ; Fetch the y velocity.
 $E374 AND A          ; {Jump to #R$E3AF if the eagle is moving up already.
 $E375 JP M,$E3AF     ; }
 $E378 CPL            ; Invert the y velocity, to send the eagle up.
 $E379 LD (IX+$09),A  ; Store the y velocity.
 $E37C CALL $B73F     ; Choose a new target.
 $E37F JR $E3AF       ; Jump to #R$E3AF.
@label=Handle_Carrying_Eagle_Check_Underside
*$E381 BIT 0,C        ; {Jump to #R$E390 if the eagle is not near the middle of
 $E383 JR NZ,$E390    ; the object.}
 $E385 LD A,(IX+$09)  ; Fetch the y velocity.
 $E388 AND A          ; {Jump to #R$E390 if the eagle is moving down already.
 $E389 JP P,$E390     ; }
 $E38C CPL            ; Invert the y velocity, to send the eagle down.
 $E38D LD (IX+$09),A  ; Store the y velocity.
@label=Handle_Carrying_Eagle_Check_Sides
*$E390 LD A,(IX+$08)  ; Fetch the x velocity.
 $E393 BIT 7,C        ; {Jump to #R$E3A4 if the eagle is not to the right of
 $E395 JR Z,$E3A4     ; the object.}
 $E397 AND A          ; {Jump to #R$E3AF if the eagle is moving to the right
 $E398 JP P,$E3AF     ; already.}
 $E39B CPL            ; Invert the x velocity.
 $E39C LD (IX+$08),A  ; Store the x velocity.
 $E39F CALL $B73F     ; Choose a new target.
 $E3A2 JR $E3AF       ; Jump to #R$E3AF.
@label=Handle_Carrying_Eagle_Bounce_Left
*$E3A4 AND A          ; {Jump to #R$E3AF if the eagle is moving to the left
 $E3A5 JP M,$E3AF     ; already.}
 $E3A8 CPL            ; Invert the x velocity.
 $E3A9 LD (IX+$08),A  ; Store the x velocity.
 $E3AC CALL $B73F     ; Choose a new target.
; Move the eagle horizontally.
@label=Handle_Carrying_Eagle_Move_X
*$E3AF LD A,(IX+$0B)  ; Fetch the contact flags.
 $E3B2 AND %11101110  ; Reset bits 0 and 4 (the ceiling and the floor).
 $E3B4 LD (IX+$0B),A  ; Store the contact flags.
 $E3B7 LD L,(IX+$08)  ; Fetch the x velocity into #REGl.
 $E3BA BIT 7,L        ; Test the sign of the x velocity.
 $E3BC LD H,$00       ; Clear the high byte of the x velocity (as a word).
 $E3BE JR Z,$E3C2     ; Jump to #R$E3C2 if the x velocity is positive.
 $E3C0 LD H,$FF       ; Set the high byte of the x velocity to #N$FF to extend
                      ; the sign.
@label=Handle_Carrying_Eagle_Set_Sabreman_Velocity
*$E3C2 LD A,L         ; Copy the x velocity to #REGa.
 $E3C3 SRA A          ; {Divide it by sixteen, keeping its sign.
 $E3C5 SRA A          ;
 $E3C7 SRA A          ;
 $E3C9 SRA A          ; }
 $E3CB LD ($8F20),A   ; Set the x velocity of Sabreman.
 $E3CE CALL $EE42     ; Move the eagle horizontally (see #R$EE42). The new x position is
                      ; returned in #REGa.
 $E3D1 JP Z,$E45F     ; Jump to #R$E45F if the new x position is less than
                      ; #N$80.
 $E3D4 CP $D0         ; {Jump to #R$E3E9 if the new x position is less than
 $E3D6 JR C,$E3E9     ; #N$D0.}
 $E3D8 BIT 2,E        ; {Jump to #R$E47E if the room has no wall on the right.
 $E3DA JP Z,$E47E     ; }
 $E3DD LD A,(IX+$08)  ; Fetch the x velocity.
 $E3E0 CPL            ; Invert it.
 $E3E1 LD (IX+$08),A  ; Store the x velocity.
 $E3E4 CALL $B73F     ; Choose a new target.
 $E3E7 LD A,$CF       ; Set the x position to #N$CF.
; This entry point is used by the routine at #R$E45F.
@label=Handle_Carrying_Eagle_Store_X
*$E3E9 LD (IX+$01),A  ; Store the x position.
 $E3EC LD A,(IX+$0B)  ; Fetch the contact flags.
 $E3EF AND %10111011  ; Reset bits 2 and 6 (the right and left walls).
 $E3F1 LD (IX+$0B),A  ; Store the contact flags.
; Move the eagle vertically.
 $E3F4 LD L,(IX+$09)  ; Fetch the y velocity into #REGl.
 $E3F7 BIT 7,L        ; Test the sign of the y velocity.
 $E3F9 LD H,$00       ; Clear the high byte of the y velocity (as a word).
 $E3FB JR Z,$E3FF     ; Jump to #R$E3FF if the y velocity is positive.
 $E3FD LD H,$FF       ; Set the high byte of the y velocity to #N$FF to extend
                      ; the sign.
@label=Handle_Carrying_Eagle_Move_Y
*$E3FF CALL $EE54     ; Move the eagle vertically (see #R$EE54). The new y position is
                      ; returned in #REGa.
 $E402 JP Z,$E496     ; Jump to #R$E496 if the new y position is less than
                      ; #N$80.
 $E405 CP $9F         ; {Jump to #R$E41A if the new y position is less than
 $E407 JR C,$E41A     ; #N$9F.}
 $E409 BIT 4,E        ; {Jump to #R$E4B6 if the room has no floor.
 $E40B JP Z,$E4B6     ; }
 $E40E LD A,(IX+$09)  ; Fetch the y velocity.
 $E411 CPL            ; Invert it.
 $E412 LD (IX+$09),A  ; Store the y velocity.
 $E415 CALL $B73F     ; Choose a new target.
 $E418 LD A,$9F       ; Set the y position to #N$9F.
; This entry point is used by the routine at #R$E496.
@label=Handle_Carrying_Eagle_Store_Y
*$E41A LD (IX+$03),A  ; Store the y position.
 $E41D JP $96CB       ; Jump to #R$96CB.

; Steer Eagle
;
; Used by the routine at #R$E2CB.
; .
; Moves the eagle by one pixel in the direction that the player is
; pressing. If more than one direction is pressed, right has priority, then
; left, up and down.
;
; IX Object record of the eagle
@label=Steer_Eagle
c$E420 CALL $AE17    ; Read the controls (see #R$AE17).
 $E423 BIT 0,A       ; {Jump to #R$E433 if right is pressed.
 $E425 JR Z,$E433    ; }
 $E427 BIT 1,A       ; {Jump to #R$E437 if left is pressed.
 $E429 JR Z,$E437    ; }
 $E42B BIT 3,A       ; {Jump to #R$E43B if up is pressed.
 $E42D JR Z,$E43B    ; }
 $E42F BIT 2,A       ; {Jump to #R$E43F if down is pressed.
 $E431 JR Z,$E43F    ; }
@label=Steer_Eagle_Right
*$E433 INC (IX+$01)  ; Move the eagle one pixel to the right.
 $E436 RET           ; Return.
@label=Steer_Eagle_Left
*$E437 DEC (IX+$01)  ; Move the eagle one pixel to the left.
 $E43A RET           ; Return.
@label=Steer_Eagle_Up
*$E43B DEC (IX+$03)  ; Move the eagle one pixel up.
 $E43E RET           ; Return.
@label=Steer_Eagle_Down
*$E43F INC (IX+$03)  ; Move the eagle one pixel down.
 $E442 RET           ; Return.

; Accelerate Eagle Left
;
; Used by the routine at #R$E2CB.
; .
; Decreases the x velocity of the eagle by one, but not below #N$D0, as
; the eagle is to the right of its target.
;
; A X velocity of the eagle
; IX Object record of the eagle
@label=Accelerate_Eagle_Left
c$E443 DEC A         ; Subtract one from the x velocity.
 $E444 BIT 7,A       ; {Jump to #R$E33E to store it if it is positive.
 $E446 JP Z,$E33E    ; }
 $E449 CP $D0        ; {Jump to #R$E341 without storing it if it is less than
 $E44B JP C,$E341    ; #N$D0.}
 $E44E JP $E33E      ; Jump to #R$E33E to store it.

; Accelerate Eagle Up
;
; Used by the routine at #R$E2CB.
; .
; Decreases the y velocity of the eagle by one, but not below #N$C7, as
; the eagle is below its target.
;
; A Y velocity of the eagle
; IX Object record of the eagle
@label=Accelerate_Eagle_Up
c$E451 DEC A         ; Subtract one from the y velocity.
 $E452 BIT 7,A       ; {Jump to #R$E356 to store it if it is positive.
 $E454 JP Z,$E356    ; }
 $E457 CP $C7        ; {Jump to #R$E359 without storing it if it is less than
 $E459 JP C,$E359    ; #N$C7.}
 $E45C JP $E356      ; Jump to #R$E356 to store it.

; Limit Eagle Sideways Movement
;
; Used by the routine at #R$E2CB.
; .
; Deals with an eagle that has moved to a new x position that is outside
; the main part of the room.
; .
; The first entry point is for an x position below #N$80, and the second
; (#R$E47E) for an x position of #N$D0 or more in a room that has no wall on the
; right. The eagle bounces off a wall on the left, flies through the gaps in the
; frame of the room and goes into the next room when it reaches the edge.
; .
; A gap sets bits 0 and 4 of the contact flags and of the flags of the room, so
; that the eagle bounces off it like it would off a ceiling or a floor.
;
; A New x position of the eagle
; E Flags of the room
; IX Object record of the eagle
@label=Limit_Eagle_Sideways_Movement
c$E45F CP $18        ; {Jump to #R$E3E9 to store the x position if it is #N$18
 $E461 JP NC,$E3E9   ; or more.}
 $E464 BIT 6,E       ; {Jump to #R$E477 if the room has no wall on the left.
 $E466 JR Z,$E477    ; }
 $E468 LD A,(IX+$08) ; Fetch the x velocity.
 $E46B CPL           ; Invert it.
 $E46C LD (IX+$08),A ; Store the x velocity.
 $E46F CALL $B73F    ; Choose a new target.
 $E472 LD A,$18      ; Set the x position to #N$18.
 $E474 JP $E3E9      ; Jump to #R$E3E9.
@label=Limit_Eagle_Sideways_Movement_Left_Gap
*$E477 CP $08        ; {Jump to #R$E485 if the x position is #N$08 or more, as the eagle is
 $E479 JR NC,$E485   ; in the gap.}
 $E47B JP $E4F6      ; Jump to #R$E4F6 to move the eagle into the next room on
                     ; the left.
; This entry point is used by the routine at #R$E2CB.
@label=Limit_Eagle_Sideways_Movement_Right_Gap
*$E47E CP $E7        ; {Jump to #R$E485 if the x position is less than #N$E7, as the eagle
 $E480 JR C,$E485    ; is in the gap.}
 $E482 JP $E50E      ; Jump to #R$E50E to move the eagle into the next room on
                     ; the right.
@label=Limit_Eagle_Sideways_Movement_In_Gap
*$E485 EX AF,AF'     ; Save the x position.
 $E486 LD A,(IX+$0B) ; Fetch the contact flags.
 $E489 OR %00010001  ; Set bits 0 and 4.
 $E48B LD (IX+$0B),A ; Store the contact flags.
 $E48E LD A,E        ; Copy the flags of the room to #REGa.
 $E48F OR %00010001  ; Set bits 0 and 4.
 $E491 LD E,A        ; Store the result in #REGe.
 $E492 EX AF,AF'     ; Restore the x position.
 $E493 JP $E3E9      ; Jump to #R$E3E9 to store the x position.

; Limit Eagle Vertical Movement
;
; Used by the routine at #R$E2CB.
; .
; Deals with an eagle that has moved to a new y position that is outside
; the main part of the room.
; .
; The first entry point is for a y position of less than #N$80 (at the top of
; the room) and the second (#R$E4B6) for a y position of #N$9F or more in a room
; that has no floor. The eagle bounces off a ceiling, flies through the gaps in
; the frame of the room and goes into the next room when it reaches the edge.
; .
; A gap sets bits 2 and 6 of the contact flags, so that the eagle bounces off it
; like it would off a wall.
;
; A New y position of the eagle
; E Flags of the room
; IX Object record of the eagle
@label=Limit_Eagle_Vertical_Movement
c$E496 CP $4C        ; {Jump to #R$E41A to store the y position if it is #N$4C
 $E498 JP NC,$E41A   ; or more.}
 $E49B BIT 0,E       ; {Jump to #R$E4AF if the room has no ceiling.
 $E49D JP Z,$E4AF    ; }
 $E4A0 LD A,(IX+$09) ; Fetch the y velocity.
 $E4A3 CPL           ; Invert it.
 $E4A4 LD (IX+$09),A ; Store the y velocity.
 $E4A7 CALL $B73F    ; Choose a new target.
 $E4AA LD A,$4C      ; Set the y position to #N$4C.
 $E4AC JP $E41A      ; Jump to #R$E41A.
@label=Limit_Eagle_Vertical_Movement_Top_Gap
*$E4AF CP $28        ; {Jump to #R$E4BD if the y position is #N$28 or more, as the eagle is
 $E4B1 JR NC,$E4BD   ; in the gap.}
 $E4B3 JP $E4CA      ; Jump to #R$E4CA to move the eagle into the next room
                     ; above.
; This entry point is used by the routine at #R$E2CB.
@label=Limit_Eagle_Vertical_Movement_Bottom_Gap
*$E4B6 CP $AF        ; {Jump to #R$E4BD if the y position is less than #N$AF, as the eagle
 $E4B8 JR C,$E4BD    ; is in the gap.}
 $E4BA JP $E4E7      ; Jump to #R$E4E7 to move the eagle into the next room
                     ; below.
@label=Limit_Eagle_Vertical_Movement_In_Gap
*$E4BD EX AF,AF'     ; Save the y position.
 $E4BE LD A,(IX+$0B) ; Fetch the contact flags.
 $E4C1 OR %01000100  ; Set bits 2 and 6.
 $E4C3 LD (IX+$0B),A ; Store the contact flags.
 $E4C6 EX AF,AF'     ; Restore the y position.
 $E4C7 JP $E41A      ; Jump to #R$E41A to store the y position.

; Move Eagle To Next Room
;
; Used by the routine at #R$E496.
; .
; Moves the eagle and Sabreman into the next room. There is an entry point
; for each direction, and the first one (#R$E4CA) is for the room above. The
; eagle and Sabreman are put at the opposite edge of the new room, and the room
; is drawn.
;
; IX Object record of the eagle
@label=Move_Eagle_To_Next_Room
c$E4CA DEC (IX+$04)    ; Move the eagle to the room above.
 $E4CD LD A,$A8        ; {Set the y position of the eagle to #N$A8.
 $E4CF LD (IX+$03),A   ; }
 $E4D2 LD A,$B8        ; {Set the y position of Sabreman to #N$B8.
 $E4D4 LD ($8F23),A    ; }
@label=Move_Eagle_To_Next_Room_Set_Room_Y
*$E4D7 LD A,(IX+$04)   ; Fetch the room y of the eagle.
 $E4DA LD ($8F1E),A    ; Set the room y of Sabreman.
@label=Move_Eagle_To_Next_Room_Draw
*$E4DD LD (IX+$0F),$01 ; Set the redraw flags of the eagle to #N$01, so that it is drawn
                       ; without being erased first.
 $E4E1 CALL $96CB      ; Draw the eagle.
 $E4E4 JP $9906        ; Jump to #R$9906.
; This entry point is used by the routine at #R$E496.
@label=Move_Eagle_To_Room_Below
*$E4E7 INC (IX+$04)    ; Move the eagle to the room below.
 $E4EA LD A,$28        ; {Set the y position of the eagle to #N$28.
 $E4EC LD (IX+$03),A   ; }
 $E4EF LD A,$38        ; {Set the y position of Sabreman to #N$38.
 $E4F1 LD ($8F23),A    ; }
 $E4F4 JR $E4D7        ; Jump to #R$E4D7.
; This entry point is used by the routine at #R$E45F.
@label=Move_Eagle_To_Room_On_Left
*$E4F6 DEC (IX+$02)    ; Move the eagle to the room on the left.
 $E4F9 LD A,$E7        ; {Set the x position of the eagle and of Sabreman to
 $E4FB LD (IX+$01),A   ; #N$E7.
 $E4FE LD ($8F22),A    ; }
@label=Move_Eagle_To_Next_Room_Set_Room_X
*$E501 LD A,(IX+$02)   ; Fetch the room x of the eagle.
 $E504 LD ($8F1C),A    ; Set the room x of Sabreman.
 $E507 LD A,$11        ; {Set the contact flags of Sabreman to #N$11.
 $E509 LD ($8F25),A    ; }
 $E50C JR $E4DD        ; Jump to #R$E4DD.
; This entry point is used by the routine at #R$E45F.
@label=Move_Eagle_To_Room_On_Right
*$E50E INC (IX+$02)    ; Move the eagle to the room on the right.
 $E511 LD A,$08        ; {Set the x position of the eagle and of Sabreman to
 $E513 LD (IX+$01),A   ; #N$08.
 $E516 LD ($8F22),A    ; }
 $E519 JR $E501        ; Jump to #R$E501.

; Check Eagle Release
;
; Used by the routine at #R$E2CB.
; .
; Makes the eagle let go of Sabreman, if it is in the open part of the
; room (the x position is from #N$18 to #N$CF and the y position is from #N$48
; to #N$9F). If it is not, the routine returns and the eagle goes on carrying
; him.
; .
; When the eagle lets go, the routine does not return to its caller but carries
; on at #R$E556, which ends the handler. The position of Sabreman is set to the
; position of the eagle, #N$10 further down but no lower than #N$9F if the room
; has a floor. The contact flags of Sabreman and the target of the eagle are
; cleared.
;
; IX Object record of the eagle
; E Flags of the room
@label=Check_Eagle_Release
c$E51B DI            ; Disable interrupts.
 $E51C LD A,(IX+$01) ; Fetch the x position of the eagle.
 $E51F CP $18        ; {Return if it is less than #N$18.
 $E521 RET C         ; }
 $E522 CP $D0        ; {Return if it is #N$D0 or more.
 $E524 RET NC        ; }
 $E525 LD A,(IX+$03) ; Fetch the y position of the eagle.
 $E528 CP $48        ; {Return if it is less than #N$48.
 $E52A RET C         ; }
 $E52B CP $A0        ; {Return if it is #N$A0 or more.
 $E52D RET NC        ; }
 $E52E POP HL        ; Discard the return address.
 $E52F LD A,(IX+$0B) ; Fetch the contact flags.
 $E532 OR E          ; Combine them with the flags of the room.
 $E533 LD E,A        ; Store the result in #REGe.
 $E534 LD A,(IX+$03) ; Fetch the y position of the eagle.
 $E537 ADD A,$10     ; Add #N$10.
 $E539 BIT 4,E       ; {Jump to #R$E543 if the room has no floor.
 $E53B JR Z,$E543    ; }
 $E53D CP $9F        ; {Jump to #R$E543 if the result is less than #N$9F.
 $E53F JR C,$E543    ; }
 $E541 LD A,$9F      ; Limit the y position to #N$9F.
@label=Check_Eagle_Release_Set_Position
*$E543 LD ($8F23),A  ; Set the y position of Sabreman.
 $E546 LD A,(IX+$01) ; Fetch the x position of the eagle.
 $E549 LD ($8F22),A  ; Set the x position of Sabreman.
 $E54C XOR A         ; {Clear the contact flags of Sabreman.
 $E54D LD ($8F25),A  ; }
 $E550 LD (IX+$0C),A ; Clear the x position of the target.
 $E553 LD (IX+$0E),A ; Clear the y position of the target.

; Release Sabreman
;
; Used by the routine at #R$E2CB.
; .
; Makes the eagle let go of Sabreman. Bit 6 of the redraw flags of
; Sabreman is set, and when #R$E570 sees that bit it makes him tumble.
; .
; If bit 7 of the redraw flags of Sabreman is set (he has been hit while he was
; being carried) bit 7 is reset and the eagle is destroyed (see #R$DF42).
; Otherwise the eagle becomes the type #N$30 and flies away upwards, with a y
; velocity of #N$F0.
; .
; The handler of the eagle also comes here when Sabreman is not being carried.
;
; IX Object record of the eagle
@label=Release_Sabreman
c$E556 LD A,($8F29)    ; Fetch the redraw flags of Sabreman.
 $E559 OR %01000000    ; Set bit 6.
 $E55B BIT 7,A         ; Test bit 7.
 $E55D RES 7,A         ; Reset bit 7.
 $E55F LD ($8F29),A    ; Store the redraw flags of Sabreman.
 $E562 JP NZ,$DF42     ; Jump to #R$DF42 to destroy the eagle if bit 7 was set.
 $E565 LD (IX+$00),$30 ; Change the eagle into a flying eagle.
 $E569 LD (IX+$09),$F0 ; Set the y velocity to #N$F0.
 $E56D JP $96CB        ; Jump to #R$96CB.

; Handle Carried Sabreman
;
; Handler for the object types #N$60 to #N$63, which are the sprites of
; Sabreman while an eagle carries him (see #R$E2CB). Bit 1 of the type is set
; when he moves to the left and bit 0 follows bit 1 of the tick counter.
; .
; His position is taken from bytes #N$08 (x) and #N$09 (y) of his record, which
; the eagle sets. If bit 7 of the redraw flags is set (he has been hit) bit 5 is
; set to ask the eagle to let go, and the countdown in byte #N$0A is set to
; #N$0F.
; .
; If no eagle was carrying him in the last pass of the main loop (see #R$8EF2)
; he drops, and so does he when bit 6 of the redraw flags is set (see #R$E556).
; He starts to tumble, with the sprite id #N$18 and a y velocity of #N$10.
; .
; Touching a decoration puts him on top of it when he is on top of it or near
; its middle. If he touches the side of one he sets bit 5 to ask the eagle to
; let go. He is kept within the walls of the room. If the fire key is pressed he
; throws a weapon (see #R$B4D1).
;
; IX Object record of Sabreman
@label=Handle_Carried_Sabreman
c$E570 CALL $989F      ; Save the state of Sabreman.
 $E573 BIT 7,(IX+$0F)  ; {Jump to #R$E582 if bit 7 of the redraw flags is
 $E577 JP Z,$E582      ; reset.}
 $E57A SET 5,(IX+$0F)  ; Set bit 5 of the redraw flags, to ask the eagle to let
                       ; go.
 $E57E LD (IX+$0A),$0F ; Set the countdown to #N$0F.
; This entry point is used by the routine at #R$B72C.
@label=Handle_Carried_Sabreman_Update
*$E582 LD A,(IX+$08)   ; Fetch the x position that the eagle has set.
 $E585 SUB (IX+$01)    ; Subtract the current x position.
 $E588 RLCA            ; {Rotate bit 6 of the result into bit 1.
 $E589 RLCA            ; }
 $E58A AND %00000010   ; Keep only bit 1, which is set when he is moving to the
                       ; left.
 $E58C LD C,A          ; Store the result in #REGc.
 $E58D LD A,($8ED6)    ; Fetch the tick counter.
 $E590 RRA             ; Move bit 1 into bit 0.
 $E591 AND %00000001   ; Keep only that bit.
 $E593 ADD A,C         ; Add the direction bit.
 $E594 LD C,A          ; Store the result in #REGc.
 $E595 LD A,(IX+$00)   ; Fetch the type.
 $E598 AND %11111100   ; Reset bits 0 and 1.
 $E59A ADD A,C         ; Add the frame and direction bits.
 $E59B LD (IX+$00),A   ; Store the type.
 $E59E LD A,(IX+$09)   ; Fetch the y position that the eagle has set.
 $E5A1 LD (IX+$03),A   ; Set the y position of Sabreman.
 $E5A4 LD A,(IX+$08)   ; Fetch the x position that the eagle has set.
 $E5A7 LD (IX+$01),A   ; Set the x position of Sabreman.
 $E5AA LD A,($8EF2)    ; Fetch the flag at #R$8EF2.
 $E5AD AND A           ; {Jump to #R$E606 if no eagle was carrying him.
 $E5AE JR Z,$E606      ; }
 $E5B0 CALL $B43E      ; Check for contact with the decorations.
 $E5B3 BIT 2,C         ; {Jump to #R$E5C3 if he is not touching a decoration.
 $E5B5 JR Z,$E5C3      ; }
 $E5B7 BIT 1,C         ; {Jump to #R$E616 if he is on top of it.
 $E5B9 JR NZ,$E616     ; }
 $E5BB BIT 0,C         ; {Jump to #R$E616 if he is near the middle of it.
 $E5BD JR Z,$E616      ; }
 $E5BF SET 5,(IX+$0F)  ; Set bit 5 of the redraw flags, to ask the eagle to let
                       ; go.
@label=Handle_Carried_Sabreman_Check_Walls
*$E5C3 CALL $98CC      ; Read the world map entry of the room that he is in. The flags of the
                       ; room are returned in #REGe.
 $E5C6 LD A,(IX+$01)   ; Fetch the x position.
 $E5C9 CP $CF          ; {Jump to #R$E5DB if it is #N$CF or more.
 $E5CB JR NC,$E5DB     ; }
 $E5CD CP $18          ; {Jump to #R$E5F2 if it is #N$18 or more.
 $E5CF JR NC,$E5F2     ; }
 $E5D1 BIT 6,E         ; {Jump to #R$E5E3 if the room has no wall on the left.
 $E5D3 JR Z,$E5E3      ; }
 $E5D5 LD (IX+$01),$18 ; Set the x position to #N$18.
 $E5D9 JR $E5E3        ; Jump to #R$E5E3.
@label=Handle_Carried_Sabreman_Check_Right_Wall
*$E5DB BIT 2,E         ; {Jump to #R$E5E3 if the room has no wall on the right.
 $E5DD JR Z,$E5E3      ; }
 $E5DF LD (IX+$01),$CF ; Set the x position to #N$CF.
@label=Handle_Carried_Sabreman_Check_Floor
*$E5E3 BIT 4,E         ; {Jump to #R$E5F2 if the room has a floor.
 $E5E5 JR NZ,$E5F2     ; }
 $E5E7 LD A,(IX+$03)   ; Fetch the y position.
 $E5EA CP $9F          ; {Jump to #R$E5F2 if it is less than #N$9F.
 $E5EC JR C,$E5F2      ; }
 $E5EE LD (IX+$03),$9F ; Set the y position to #N$9F.
@label=Handle_Carried_Sabreman_Check_Release
*$E5F2 BIT 6,(IX+$0F)  ; {Jump to #R$E606 if bit 6 of the redraw flags is set, as the eagle
 $E5F6 JR NZ,$E606     ; has let go.}
 $E5F8 CALL $AE17      ; Read the controls.
 $E5FB BIT 4,A         ; {Jump to #R$96CB if the fire key is not pressed.
 $E5FD JP NZ,$96CB     ; }
 $E600 CALL $B4D1      ; Throw a weapon.
 $E603 JP $96CB        ; Jump to #R$96CB.
@label=Handle_Carried_Sabreman_Drop
*$E606 DI              ; Disable interrupts.
 $E607 RES 6,(IX+$0F)  ; Reset bit 6 of the redraw flags.
 $E60B LD (IX+$00),$18 ; Set the sprite id to #N$18 (tumbling).
 $E60F LD (IX+$09),$10 ; Set the y velocity to #N$10.
 $E613 JP $96CB        ; Jump to #R$96CB.
@label=Handle_Carried_Sabreman_Stand
*$E616 LD A,B          ; Copy #N$A0 less the y position of the top of the decoration to
                       ; #REGa.
 $E617 DEC A           ; Subtract one.
 $E618 NEG             ; Negate it.
 $E61A ADD A,$A0       ; Add #N$A0, to get the y position just below the top of the
                       ; decoration.
 $E61C LD (IX+$03),A   ; Set the y position of Sabreman.
 $E61F JP $96CB        ; Jump to #R$96CB.

; Handle Stalactite
;
; Handler for the object types #N$3C, #N$3D, #N$55, #N$56 and #N$57, the
; stalactites that hang from the ceiling of a cave room. They are made by
; #R$E6BE from the templates at #R$B7CB. A stalactite does not move.
; .
; It is drawn once, when bit 0 of its redraw flags is set. At the same time, if
; bit 3 of byte #N$06 is set, the stalactite has a gem in it. The gem is made as
; a copy of the record of the stalactite in the record that is #N$20 bytes on,
; with the type #N$64 plus the two low bits of the sum of the room x, the room y
; and byte #N$06 (so there are four kinds of gem). Its y position is that of the
; stalactite less the height of the stalactite (byte #N$0C), its attribute is
; #N$45 (cyan) and it is handled by #R$E751. Byte #N$06 of the stalactite is
; then cleared, so that only one gem is made.
; .
; The attributes of the cells that the stalactite covers are copied from the
; colour data on every call (see #R$DC0B), which keeps the stalactite coloured
; whatever passes in front of it. The colour data is chosen by the two low bits
; of the type, using the pointers at #R$E69D.
;
; IX Object record of the stalactite
@label=Handle_Stalactite
c$E622 CALL $9689      ; Prepare the sprite of the stalactite.
 $E625 BIT 0,(IX+$0F)  ; {Jump to #R$E665 if the stalactite has been drawn
 $E629 JR Z,$E665      ; already.}
 $E62B BIT 3,(IX+$06)  ; {Jump to #R$E65E if the stalactite has no gem in it.
 $E62F JR Z,$E65E      ; }
 $E631 PUSH IX         ; {Copy the address of the record of the stalactite to
 $E633 POP DE          ; #REGde.}
 $E634 LD HL,$0020     ; Set #REGhl to #N$0020.
 $E637 ADD HL,DE       ; Point #REGhl at the record that is #N$20 bytes on.
 $E638 LD BC,$0010     ; Set a counter of #N$10 bytes.
 $E63B EX DE,HL        ; Swap the addresses, so that #REGde points at the other
                       ; record.
 $E63C PUSH DE         ; Stash the address of the other record.
 $E63D LDIR            ; Copy the record of the stalactite to the other record.
 $E63F POP HL          ; Restore the address of the other record to #REGhl.
 $E640 LD A,(IX+$02)   ; Fetch the room x.
 $E643 ADD A,(IX+$04)  ; Add the room y.
 $E646 ADD A,(IX+$06)  ; Add byte #N$06.
 $E649 AND %00000011   ; Keep only the two low bits.
 $E64B ADD A,$64       ; Add #N$64, to make the type of one of the four gems.
 $E64D LD (HL),A       ; Set the type of the gem.
 $E64E INC HL          ; {Move on to the y position of the gem.
 $E64F INC HL          ;
 $E650 INC HL          ; }
 $E651 LD A,(HL)       ; Fetch the y position of the gem.
 $E652 SUB (IX+$0C)    ; Subtract the height of the stalactite.
 $E655 LD (HL),A       ; Set the y position of the gem.
 $E656 INC HL          ; {Move on to the attribute of the gem.
 $E657 INC HL          ; }
 $E658 LD (HL),$45     ; Set the attribute of the gem to #N$45 (cyan).
 $E65A LD (IX+$06),$00 ; Clear byte #N$06 of the stalactite.
@label=Handle_Stalactite_Draw
*$E65E RES 0,(IX+$0F)  ; Reset bit 0 of the redraw flags.
 $E662 CALL $962A      ; Draw the stalactite.
@label=Handle_Stalactite_Colour
*$E665 LD D,$00        ; Clear the high byte of the offset.
 $E667 LD A,(IX+$00)   ; Fetch the type of the stalactite.
 $E66A AND %00000011   ; Keep only the two low bits.
 $E66C LD E,A          ; Store the colour type in #REGe.
 $E66D LD HL,$E69D     ; Point #REGhl at #R$E69D.
 $E670 ADD HL,DE       ; {Add the result twice, to point at the pointer for the
 $E671 ADD HL,DE       ; type.}
 $E672 LD E,(HL)       ; Fetch the low byte of the pointer.
 $E673 INC HL          ; Move on to the high byte.
 $E674 LD D,(HL)       ; Fetch the high byte of the pointer, which makes #REGde point at the
                       ; colour data.
; This entry point is used by the routine at #R$EB39.
@label=Handle_Stalactite_Colour_Copy
*$E675 LD L,(IX+$01)   ; Fetch the x position of the object.
 $E678 LD H,(IX+$03)   ; Fetch the y position of the object.
 $E67B CALL $ADE0      ; Get the attribute address of the bottom left cell of the sprite
                       ; in #REGhl.
 $E67E LD A,($8EE6)    ; Fetch the number of cells in each row of the sprite.
 $E681 LD B,A          ; Store it in #REGb.
 $E682 LD A,($8EE7)    ; Fetch the height of the sprite in pixels.
 $E685 RRCA            ; {Divide it by eight.
 $E686 RRCA            ;
 $E687 RRCA            ; }
 $E688 AND %00011111   ; Keep only the low five bits.
 $E68A LD C,A          ; Store the number of rows in #REGc.
@label=Handle_Stalactite_Colour_Row
*$E68B PUSH BC         ; Stash the number of rows and the number of cells in
                       ; each row.
 $E68C PUSH HL         ; Stash the attribute address of the start of the row.
@label=Handle_Stalactite_Colour_Cell
*$E68D LD A,(DE)       ; Fetch an attribute from the colour data.
 $E68E LD (HL),A       ; Set the attribute of the cell.
 $E68F INC HL          ; Move on to the next cell.
 $E690 INC DE          ; Move on to the next attribute in the colour data.
 $E691 DJNZ $E68D      ; Decrease the cell counter and loop back for the rest of the cells in
                       ; the row.
 $E693 POP HL          ; Restore the attribute address of the start of the row.
 $E694 LD BC,$FFE0     ; Set #REGbc to #N$FFE0, which is minus the number of cells in a row
                       ; of the screen.
 $E697 ADD HL,BC       ; Move up to the row above.
 $E698 POP BC          ; Restore the number of rows and the number of cells in
                       ; each row.
 $E699 DEC C           ; {Decrease the row counter and loop back until all of the rows have
 $E69A JR NZ,$E68B     ; been done.}
 $E69C RET             ; Return.

; Stalactite Colour Pointers
;
; Pointers into the colour data at #R$DC0B, which are chosen by the two
; low bits of the type of the stalactite (see #R$E622).
@label=Stalactite_Colour_Pointers
w$E69D DEFW $DC1D    ; Type #N$3C: the colour data at #R$DC1D.
 $E69F DEFW $DC0B    ; Types #N$3D and #N$55: the colour data at #R$DC0B.
 $E6A1 DEFW $DC1D    ; Type #N$56: the colour data at #R$DC1D.
 $E6A3 DEFW $DC2F    ; Type #N$57: the colour data at #R$DC2F.

; Read Room State
;
; Used by the routines at #R$9906, #R$E6EE and #R$E751.
; .
; Reads the entry of the room visit table (see #R$6000) for the room that
; an object is in. The address of the entry is worked out in the same way as the
; address of the world map entry (see #R$98B2), but from #N$6000 instead of
; #N$7000.
;
;   IX Object record
; O:A First byte of the entry
; O:HL Address of the entry
@label=Read_Room_State
c$E6A5 LD H,(IX+$04) ; Fetch the room y of the object into #REGh.
 $E6A8 XOR A         ; Clear #REGa.
 $E6A9 SRL H         ; {Move the three low bits of the room y into the top of #REGa, so that
 $E6AB RRA           ; #REGh holds the room y divided by eight.
 $E6AC SRL H         ;
 $E6AE RRA           ;
 $E6AF SRL H         ;
 $E6B1 RRA           ; }
 $E6B2 LD L,(IX+$02) ; Fetch the room x of the object into #REGl.
 $E6B5 ADD A,L       ; {Add the room x twice to #REGa.
 $E6B6 ADD A,L       ; }
 $E6B7 LD L,A        ; Store the result in #REGl.
 $E6B8 LD BC,$6000   ; Set #REGbc to #N$6000.
 $E6BB ADD HL,BC     ; Add it to the offset.
 $E6BC LD A,(HL)     ; Fetch the first byte of the entry.
 $E6BD RET           ; Return.

; Build Stalactite
;
; Used by the routine at #R$E6EE.
; .
; Makes the object record of one stalactite from a template (see #R$B7CB).
; .
; The byte that describes the stalactite (one of the two bytes of the entry of
; the room visit table, see #R$E6EE) is in #REGb. Bits 1 and 2 of it choose the
; template. Bits 4 and 5 give the x position, which is that number of sixteen
; pixels more than #REGc. Bits 6 and 7 give the y position, which is that number
; of sixteen pixels more than #N$77. Bit 3 is set if the stalactite has a gem in
; it (see #R$E622). Bit 0 tells the first stalactite of a room from the second.
; .
; The room x and the room y are those of the object at #REGix. The attribute is
; #N$46 (yellow). The byte is also stored in byte #N$06 of the record.
;
; A Template number multiplied by two (bits 1 and 2 of #REGb)
; B Byte that describes the stalactite
; C Smallest x position
; DE Address of the stalactite record
; HL Address of the table of pointers to the templates
; IX Object record of Sabreman
@label=Build_Stalactite
c$E6BE PUSH BC       ; Stash the byte that describes the stalactite and the smallest x
                     ; position.
 $E6BF LD C,A        ; Copy the template number to #REGc.
 $E6C0 LD B,$00      ; Clear the high byte of the offset.
 $E6C2 ADD HL,BC     ; Point #REGhl at the pointer to the template.
 $E6C3 LD A,(HL)     ; Fetch the low byte of the pointer.
 $E6C4 INC HL        ; Move on to the high byte.
 $E6C5 LD H,(HL)     ; Fetch the high byte of the pointer.
 $E6C6 LD L,A        ; Make #REGhl point at the template.
 $E6C7 LD BC,$0010   ; Set the number of bytes to copy to #N$10.
 $E6CA PUSH DE       ; Stash the address of the stalactite record.
 $E6CB LDIR          ; Copy the template to the stalactite record.
 $E6CD POP HL        ; Restore the address of the stalactite record to #REGhl.
 $E6CE POP BC        ; Restore the byte that describes the stalactite to #REGb and the
                     ; smallest x position to #REGc.
 $E6CF LD A,B        ; Copy the byte that describes the stalactite to #REGa.
 $E6D0 INC HL        ; Move on to the x position.
 $E6D1 AND %00110000 ; Keep only bits 4 and 5.
 $E6D3 ADD A,C       ; Add the smallest x position.
 $E6D4 LD (HL),A     ; Set the x position.
 $E6D5 INC HL        ; Move on to the room x.
 $E6D6 LD A,(IX+$02) ; Fetch the room x.
 $E6D9 LD (HL),A     ; Set the room x.
 $E6DA INC HL        ; Move on to the y position.
 $E6DB LD A,B        ; Fetch the byte that describes the stalactite.
 $E6DC RRA           ; {Move bits 6 and 7 into bits 4 and 5.
 $E6DD RRA           ; }
 $E6DE AND %00110000 ; Keep only bits 4 and 5.
 $E6E0 ADD A,$77     ; Add #N$77.
 $E6E2 LD (HL),A     ; Set the y position.
 $E6E3 INC HL        ; Move on to the room y.
 $E6E4 LD A,(IX+$04) ; Fetch the room y.
 $E6E7 LD (HL),A     ; Set the room y.
 $E6E8 INC HL        ; Move on to the attribute.
 $E6E9 LD (HL),$46   ; Set the attribute to #N$46 (yellow).
 $E6EB INC HL        ; Move on to byte #N$06.
 $E6EC LD (HL),B     ; Store the byte that describes the stalactite.
 $E6ED RET           ; Return.

; Set Up Stalactites
;
; Used by the routine at #R$AF56.
; .
; Sets up the two stalactites of a cave room that has no floor when the
; room is drawn (see #R$AF56). The stalactites are the records at
; #R$8F9A and #R$8FAA.
; .
; Each stalactite is described by one byte, and these are the two bytes of the
; entry of the room in the room visit table (see #R$6000). If the first byte is
; zero the room has not been visited before, so both bytes are made up.
; .
; The first byte is the tick counter with bit 0 set, if bit 2 of that value is
; set, or otherwise #REGb with bits 4 and 5 reset (#REGb is whatever the
; routines that drew the room frame left in it). If the room has no wall on the
; left, bits 2, 5 and 7 are set. The second byte is the low byte of FRAMES with
; bit 0 reset, if bit 2 of that value is set, or otherwise #REGb with bits 4 and
; 5 set. If the room has no wall on the right, bits 2 and 7 are set and bit 5 is
; reset.
; .
; The first stalactite is built with the smallest x position #N$18 and the first
; table of template pointers at #R$E741, and the second one with the smallest x
; position #N$A0 and the second table at #R$E749. Both are built by #R$E6BE.
;
; E Flags of the room
; IX Object record of Sabreman
@label=Set_Up_Stalactites
c$E6EE CALL $E6A5    ; Read the entry of the room in the room visit table. #REGhl holds the
                     ; address of the entry and #REGa the first byte.
 $E6F1 PUSH HL       ; Stash the address of the entry.
 $E6F2 AND A         ; {Jump to #R$E714 if the room has not been visited
 $E6F3 JR Z,$E714    ; before.}
@label=Set_Up_Stalactites_Build
*$E6F5 LD B,A        ; Store the byte that describes the first stalactite in
                     ; #REGb.
 $E6F6 AND %00000110 ; Keep only bits 1 and 2, which give the template number.
 $E6F8 LD C,$18      ; Set the smallest x position to #N$18.
 $E6FA LD HL,$E741   ; Point #REGhl at #R$E741.
 $E6FD LD DE,$8F9A   ; Point #REGde at #R$8F9A.
 $E700 CALL $E6BE    ; Build the first stalactite.
 $E703 POP HL        ; Restore the address of the entry to #REGhl.
 $E704 INC HL        ; Move on to the second byte.
 $E705 LD A,(HL)     ; Fetch the byte that describes the second stalactite.
 $E706 LD B,A        ; Store it in #REGb.
 $E707 AND %00000110 ; Keep only bits 1 and 2, which give the template number.
 $E709 LD C,$A0      ; Set the smallest x position to #N$A0.
 $E70B LD HL,$E749   ; Point #REGhl at #R$E749.
 $E70E LD DE,$8FAA   ; Point #REGde at #R$8FAA.
 $E711 JP $E6BE      ; Jump to #R$E6BE.
; Make up the two bytes for a room that has not been visited.
@label=Set_Up_Stalactites_Generate
*$E714 LD A,($8ED6)  ; Fetch the tick counter.
 $E717 OR %00000001  ; Set bit 0.
 $E719 BIT 2,A       ; {Jump to #R$E720 if it is set.
 $E71B JR NZ,$E720   ; }
 $E71D LD A,B        ; Fetch #REGb.
 $E71E AND %11001111 ; Reset bits 4 and 5.
@label=Set_Up_Stalactites_Check_Left_Wall
*$E720 BIT 6,E       ; {Jump to #R$E726 if the room has a wall on the left.
 $E722 JR NZ,$E726   ; }
 $E724 OR %10100100  ; Set bits 2, 5 and 7.
@label=Set_Up_Stalactites_Store_First
*$E726 LD (HL),A     ; Store the first byte of the entry.
 $E727 LD A,($5C78)  ; Fetch the low byte of FRAMES.
 $E72A AND %11111110 ; Reset bit 0.
 $E72C INC HL        ; Move on to the second byte of the entry.
 $E72D BIT 2,A       ; {Jump to #R$E734 if it is set.
 $E72F JR NZ,$E734   ; }
 $E731 LD A,B        ; Fetch #REGb.
 $E732 OR %00110000  ; Set bits 4 and 5.
@label=Set_Up_Stalactites_Check_Right_Wall
*$E734 BIT 2,E       ; {Jump to #R$E73C if the room has a wall on the right.
 $E736 JR NZ,$E73C   ; }
 $E738 OR %10000100  ; Set bits 2 and 7.
 $E73A AND %11011111 ; Reset bit 5.
@label=Set_Up_Stalactites_Store_Second
*$E73C LD (HL),A     ; Store the second byte of the entry.
 $E73D DEC HL        ; Move back to the first byte of the entry.
 $E73E LD A,(HL)     ; Fetch the first byte of the entry.
 $E73F JR $E6F5      ; Jump to #R$E6F5 to build the stalactites.

; Stalactite Template Pointers
;
; Two tables of four pointers to the templates of the stalactites at
; #R$B7CB, which are chosen by bits 1 and 2 of the byte that describes the
; stalactite (see #R$E6BE).
; .
; The first table is used for the first stalactite of a room (on the left, with
; an x position from #N$18) and the second for the second stalactite (on the
; right, with an x position from #N$A0).
;
; .
;
; The first table, with the templates of the types #N$55, #N$56, #N$57 and
; #N$57.
@label=Stalactite_Template_Pointers
w$E741 DEFW $B7CB
 $E743 DEFW $B7DB
 $E745 DEFW $B7EB
 $E747 DEFW $B7EB
; The second table, with the templates of the types #N$3C, #N$3D, #N$57
; and #N$57.
@label=Stalactite_Template_Pointers_Right
 $E749 DEFW $B7FB
 $E74B DEFW $B80B
 $E74D DEFW $B7EB
 $E74F DEFW $B7EB

; Handle Collectable
;
; Handler for the object types #N$64 to #N$67 (the four kinds of gem, see
; #R$E622) and #N$7F (an extra life, see #R$EDB4).
; .
; An object that is in a different room from Sabreman is removed. When Sabreman
; touches the object (see #R$E285) it is erased and the pickup sound is played
; (see #R$A0E4). An extra life goes on at #R$E7AD. For a gem the score goes up
; (see #R$A045) by the type divided by two, as a number of hundreds, plus #N$99.
; Sabreman turns cyan, the gem timer at #R$8EEE is set to #N$50 and printed, and
; the gem is taken out of the entry of the room in the room visit table (see
; #R$E6EE), so that it does not come back when the room is drawn again. Bit 0 of
; byte #N$06 of the gem is taken to show which of the two bytes of the entry it
; came from.
;
; IX Object record of the gem or the extra life
@label=Handle_Collectable
c$E751 LD A,($8F1C)    ; Fetch the room x of Sabreman.
 $E754 CP (IX+$02)     ; {Jump to #R$E7A8 to remove the object if it is in a
 $E757 JR NZ,$E7A8     ; different room x.}
 $E759 LD A,($8F1E)    ; Fetch the room y of Sabreman.
 $E75C CP (IX+$04)     ; {Jump to #R$E7A8 to remove the object if it is in a
 $E75F JR NZ,$E7A8     ; different room y.}
 $E761 BIT 0,(IX+$0F)  ; {Jump to #R$96CB if it has not been drawn yet.
 $E765 JP NZ,$96CB     ; }
@label=Handle_Collectable_Check_Contact
 $E768 CALL $E285      ; Check for contact with Sabreman.
 $E76B BIT 2,C         ; {Jump to #R$E775 if Sabreman touches the object.
 $E76D JR NZ,$E775     ; }
 $E76F CALL $9689      ; Prepare the sprite of the object.
 $E772 JP $9867        ; Jump to #R$9867.
@label=Handle_Collectable_Collect
*$E775 CALL $989F      ; Save the state of the object.
 $E778 CALL $9636      ; Erase the sprite of the object.
 $E77B CALL $A0E4      ; Play the pickup sound.
 $E77E LD A,(IX+$00)   ; Fetch the type of the object.
 $E781 CP $7F          ; {Jump to #R$E7AD if the object is an extra life.
 $E783 JR Z,$E7AD      ; }
 $E785 LD B,(IX+$00)   ; Fetch the type of the object into #REGb.
 $E788 SRL B           ; Divide it by two.
 $E78A LD C,$00        ; Clear #REGc, so that #REGbc holds the points for the
                       ; object.
 $E78C CALL $A045      ; Add to the score.
 $E78F LD A,$45        ; {Set the attribute of Sabreman to cyan (#N$45).
 $E791 LD ($8F1F),A    ; }
 $E794 LD A,$50        ; {Set the gem timer to #N$50.
 $E796 LD ($8EEE),A    ; }
 $E799 CALL $9E27      ; Print the gem timer.
 $E79C CALL $E6A5      ; Read the entry of the room in the room visit table. #REGhl holds the
                       ; address of the first byte.
 $E79F BIT 0,(IX+$06)  ; {Jump to #R$E7A6 if the gem came from the first
 $E7A3 JR NZ,$E7A6     ; stalactite.}
 $E7A5 INC HL          ; Move on to the second byte of the entry.
@label=Handle_Collectable_Clear_Gem
*$E7A6 RES 3,(HL)      ; Reset bit 3 of the byte, so that the stalactite has no gem in it any
                       ; more.
; This entry point is used by the routines at #R$E7AD, #R$EAF9, #R$EB39 and
; #R$ECCA.
@label=Handle_Collectable_Remove
*$E7A8 LD (IX+$00),$00 ; Remove the object.
 $E7AC RET             ; Return.

; Collect Extra Life
;
; Used by the routine at #R$E751.
; .
; Adds a life when Sabreman has touched an extra life (see #R$E751),
; prints the number of lives, and marks the extra life as collected in the table
; at #R$EDC4. The routine ends by removing the object.
;
; IX Object record of the extra life
@label=Collect_Extra_Life
c$E7AD LD A,($8EDA)  ; Fetch the number of lives.
 $E7B0 INC A         ; Add one.
 $E7B1 DAA           ; Adjust the result to a BCD value.
 $E7B2 LD ($8EDA),A  ; Store the number of lives.
 $E7B5 CALL $A02F    ; Print the number of lives.
 $E7B8 LD A,$10      ; Set the number of entries in the table to #N$10.
 $E7BA LD HL,$EDC6   ; Point #REGhl at #R$EDC6.
 $E7BD CALL $E7C4    ; Set the collected flag of the extra life.
 $E7C0 JR $E7A8      ; Jump to #R$E7A8 to remove the object.

; Set Collected Flag
;
; Used by the routine at #R$ECCA.
; .
; Sets the collected flag of the entry of a table that an object came
; from. The entries are three bytes long, and byte #N$06 of the object is the
; number of the entry counted from the end of the table, so the entry is the
; length of the table less that number.
; .
; The routine has two entry points: #R$E7C2 for a table of #N$08 entries, and
; #R$E7C4 with the length in #REGa.
;
; HL Address of the collected flag of the first entry
; IX Object record
@label=Set_Collected_Flag
c$E7C2 LD A,$08      ; #REGa=#N$08.
; This entry point is used by the routine at #R$E7AD.
@label=Set_Collected_Flag_Entry
*$E7C4 SUB (IX+$06)  ; Subtract byte #N$06 of the object, to get the number of
                     ; the entry.
 $E7C7 LD E,A        ; Store it in #REGe.
 $E7C8 LD D,$00      ; Clear the high byte of the number of the entry.
 $E7CA ADD HL,DE     ; {Add the number of the entry three times, to point at the collected
 $E7CB ADD HL,DE     ; flag.
 $E7CC ADD HL,DE     ; }
 $E7CD LD (HL),$01   ; Set the collected flag.
 $E7CF RET           ; Return.

; Start Dying
;
; Used by the routines at #R$A3E9 and #R$A6A6.
; .
; Makes Sabreman die. The sprite id becomes #N$3E or #N$3F, depending on
; bit 2 of the sprite id that he has, and the countdown in byte #N$0A is set to
; #N$20. #R$E7E3 handles the rest.
;
; IX Object record of Sabreman
@label=Start_Dying
c$E7D0 LD A,(IX+$00)   ; Fetch the sprite id.
 $E7D3 RRA             ; {Move bit 2 into bit 0.
 $E7D4 RRA             ; }
 $E7D5 AND %00000001   ; Keep only that bit.
 $E7D7 ADD A,$3E       ; Add #N$3E.
 $E7D9 LD (IX+$00),A   ; Set the sprite id.
 $E7DC LD (IX+$0A),$20 ; Set the countdown to #N$20.
 $E7E0 JP $96CB        ; Jump to #R$96CB.

; Handle Death
;
; Handler for the object types #N$3E and #N$3F, the sprites that Sabreman
; has when he dies (see #R$E7D0). The sprite is drawn until the countdown in
; byte #N$0A reaches zero. Then he loses a life and the game is over if he has
; none left (see #R$95DE).
; .
; Otherwise his position is saved (see #R$8EDB), all of the object records are
; cleared (see #R$E825), Sabreman is reset (see #R$A3DD), his position is put
; back and the room is drawn again, so he carries on where he died.
;
; IX Object record of Sabreman
@label=Handle_Death
c$E7E3 CALL $989F    ; Save the state of Sabreman.
 $E7E6 DEC (IX+$0A)  ; {Jump to #R$96CB if the countdown is not zero.
 $E7E9 JP NZ,$96CB   ; }
 $E7EC LD A,($8EDA)  ; Fetch the number of lives.
 $E7EF DEC A         ; {Jump to #R$E821 if he had none left.
 $E7F0 JP M,$E821    ; }
 $E7F3 DAA           ; Adjust the result to a BCD value.
 $E7F4 LD ($8EDA),A  ; Store the number of lives.
 $E7F7 CALL $A02F    ; Print the number of lives.
 $E7FA LD HL,($8F1B) ; Fetch the x position and the room x of Sabreman.
 $E7FD LD ($8EDB),HL ; Save them.
 $E800 LD HL,($8F1D) ; Fetch the y position and the room y of Sabreman.
 $E803 LD ($8EDD),HL ; Save them.
 $E806 CALL $E825    ; Clear the object records.
 $E809 CALL $A3DD    ; Reset Sabreman.
 $E80C LD HL,($8EDB) ; Fetch the saved x position and room x.
 $E80F LD ($8F1B),HL ; Put them back in the record of Sabreman.
 $E812 LD HL,($8EDD) ; Fetch the saved y position and room y.
 $E815 LD ($8F1D),HL ; Put them back in the record of Sabreman.
 $E818 LD A,$10      ; {Set the contact flags of Sabreman to #N$10, so that he stands on a
 $E81A LD ($8F25),A  ; floor.}
 $E81D CALL $9906    ; Draw the room.
 $E820 RET           ; Return.
@label=Handle_Death_Game_Over
*$E821 POP HL        ; Discard the return address.
 $E822 JP $95DE      ; Show the game over message.

; Clear Object Records
;
; Used by the routines at #R$91C0 and #R$E7E3.
; .
; Clears the object records from the record of Sabreman (at
; #R$8F1A) up to the end of the records at #R$902A, which are
; #N$110 bytes.
@label=Clear_Object_Records
c$E825 LD HL,$8F1A   ; Point #REGhl at the record of Sabreman.
 $E828 LD BC,$0110   ; Set the number of bytes to clear to #N$0110.
@label=Clear_Object_Records_Loop
*$E82B LD (HL),$00   ; Clear a byte.
 $E82D INC HL        ; Move on to the next byte.
 $E82E DEC BC        ; {Decrease the byte counter and loop back until all of the object
 $E82F LD A,B        ; records have been cleared.
 $E830 OR C          ;
 $E831 JR NZ,$E82B   ; }
; Continue on to #R$E833.

; Check Stalactite Contact
;
; Used by the routines at #R$A316, #R$A433 and #R$A6A6.
; .
; Checks whether an object is touching the falling stalactite (the record
; at #R$8F3A, see #R$DF98).
; .
; Nothing is touched when there is no falling stalactite, while the gem timer at
; #R$8EEE is not zero, or if the stalactite is in a different room. The two are
; touching when the x positions differ by less than #N$10 and the y positions by
; less than #N$14.
; .
; The result in #REGc starts as #N$80 and is: bit 7 set if the stalactite is
; level with or to the right of the object, bit 0 set if the x positions differ
; by #N$0A or more, bit 1 set if the stalactite is above the object, and bit 2
; set if they are touching. #REGb is the y velocity of the stalactite.
;
;   IX Object record
; O:B Y velocity of the stalactite (when they are touching)
; O:C Contact result
@label=Check_Stalactite_Contact
c$E833 LD BC,$0080   ; Set #REGbc to #N$0080.
 $E836 LD A,($8F3A)  ; Fetch the type of the stalactite.
 $E839 AND A         ; {Return if there is no falling stalactite.
 $E83A RET Z         ; }
 $E83B LD A,($8EEE)  ; Fetch the gem timer.
 $E83E AND A         ; {Return if it is not zero.
 $E83F RET NZ        ; }
 $E840 LD A,($8F3C)  ; Fetch the room x of the stalactite.
 $E843 CP (IX+$02)   ; {Return if it is different.
 $E846 RET NZ        ; }
 $E847 LD A,($8F3E)  ; Fetch the room y of the stalactite.
 $E84A CP (IX+$04)   ; {Return if it is different.
 $E84D RET NZ        ; }
 $E84E LD A,($8F3B)  ; Fetch the x position of the stalactite.
 $E851 SUB (IX+$01)  ; {Jump to #R$E85B if the stalactite is level with or to the right of
 $E854 JP P,$E85B    ; the object.}
 $E857 NEG           ; Make the difference positive.
 $E859 RES 7,C       ; Reset bit 7 of the contact result.
@label=Check_Stalactite_Contact_Check_Width
*$E85B CP $10        ; {Return if the difference is #N$10 or more.
 $E85D RET NC        ; }
 $E85E CP $0A        ; {Jump to #R$E864 if the difference is less than #N$0A.
 $E860 JR C,$E864    ; }
 $E862 SET 0,C       ; Set bit 0 of the contact result.
@label=Check_Stalactite_Contact_Check_Height
*$E864 LD A,($8F3D)  ; Fetch the y position of the stalactite.
 $E867 SUB (IX+$03)  ; {Jump to #R$E871 if the stalactite is below the object.
 $E86A JP P,$E871    ; }
 $E86D NEG           ; Make the difference positive.
 $E86F SET 1,C       ; Set bit 1 of the contact result.
@label=Check_Stalactite_Contact_Check_Contact
*$E871 CP $14        ; {Return if the difference is #N$14 or more.
 $E873 RET NC        ; }
 $E874 SET 2,C       ; Set bit 2 of the contact result (contact).
 $E876 LD A,($8F43)  ; Fetch the y velocity of the stalactite.
 $E879 LD B,A        ; Store it in #REGb.
 $E87A RET           ; Return.

; Knock Sabreman Off Rope
;
; Used by the routine at #R$A316.
; .
; Makes Sabreman fall off the rope when something hits him (a bubble, a
; creature or the falling stalactite). He tumbles, with the y velocity that is
; in #REGb. His x velocity is the distance that the end of the rope moved (see
; #R$AA95) and the countdown in byte #N$0A is set to #N$14. The rope is made a
; type #N$17 object again, and Sabreman is drawn, at #R$A8DA.
;
; B Y velocity
; IX Object record of Sabreman
@label=Knock_Sabreman_Off_Rope
c$E87B LD A,($AA97)    ; Fetch the previous position of the end of the rope.
 $E87E LD E,A          ; Store it in #REGe.
 $E87F LD A,($AA95)    ; Fetch the position of the end of the rope.
 $E882 SUB E           ; Subtract the previous position.
 $E883 LD (IX+$06),A   ; Set the x velocity.
 $E886 LD (IX+$09),B   ; Set the y velocity.
 $E889 LD (IX+$00),$18 ; Set the sprite id to #N$18 (tumbling).
 $E88D LD (IX+$0A),$14 ; Set the countdown to #N$14.
 $E891 JP $A8DA        ; Jump to #R$A8DA.

; Knock Sabreman Down
;
; Used by the routine at #R$A433.
; .
; Makes Sabreman tumble when he has been hit by a bubble. The y velocity
; is the value in #REGb, the countdown in byte #N$0A is set to #N$14 and the
; sprite id to #N$18 (tumbling). Sabreman is drawn and the routine returns to
; the main loop.
;
; B Y velocity
; IX Object record of Sabreman
@label=Knock_Sabreman_Down
c$E894 LD (IX+$0A),$14 ; Set the countdown to #N$14.
; This entry point is used by the routine at #R$A6A6.
@label=Knock_Sabreman_Down_Set_Velocity
*$E898 LD (IX+$09),B   ; Set the y velocity.
 $E89B LD (IX+$00),$18 ; Set the sprite id to #N$18 (tumbling).
 $E89F JP $96CB        ; Jump to #R$96CB.

; Tumble Sabreman
;
; Used by the routines at #R$A433 and #R$A6A6.
; .
; Makes Sabreman tumble after a creature has hit him (see #R$B079), which
; sets bit 3 of his redraw flags. The sprite id is #N$18 plus a random number
; from zero to three (the low bits of FRAMES). Bits 3 and 4 of the redraw flags
; are reset, he moves up by one pixel, and the countdown in byte #N$0A is set to
; #N$14. The routine goes on at #R$A928 to carry on with the tumbling.
;
; IX Object record of Sabreman
@label=Tumble_Sabreman
c$E8A2 LD A,($5C78)    ; Fetch the low byte of FRAMES.
 $E8A5 AND %00000011   ; Keep only the two low bits.
 $E8A7 ADD A,$18       ; Add #N$18.
 $E8A9 LD (IX+$00),A   ; Set the sprite id.
 $E8AC LD A,(IX+$0F)   ; Fetch the redraw flags.
 $E8AF AND %11100111   ; Reset bits 3 and 4.
 $E8B1 LD (IX+$0F),A   ; Store the redraw flags.
 $E8B4 DEC (IX+$03)    ; Move Sabreman up by one pixel.
 $E8B7 LD (IX+$0A),$14 ; Set the countdown to #N$14.
 $E8BB JP $A928        ; Jump to #R$A928.

; Place Weapon Pickups
;
; Used by the routine at #R$9052.
; .
; Puts the four weapons that Sabreman can pick up in their places at the
; start of a game (see #R$9052). It copies one of four sets of four records from
; the table at #R$E9FD to the small object records at #R$902A, and the set is
; chosen by bits 1 and 2 of the low byte of FRAMES.
@label=Place_Weapon_Pickups
c$E8BE LD DE,$902A   ; Point #REGde at the first small object record.
 $E8C1 LD HL,$E9FD   ; Point #REGhl at #R$E9FD.
 $E8C4 LD A,($5C78)  ; Fetch the low byte of FRAMES.
 $E8C7 RLA           ; {Shift it left four times.
 $E8C8 RLA           ;
 $E8C9 RLA           ;
 $E8CA RLA           ; }
 $E8CB AND %01100000 ; Keep only bits 5 and 6, which are the old bits 1 and 2.
 $E8CD LD C,A        ; Store the result in #REGc.
 $E8CE LD B,$00      ; Clear the high byte of the offset.
 $E8D0 ADD HL,BC     ; Point #REGhl at the chosen set of records.
 $E8D1 LD BC,$0020   ; Set the number of bytes to copy to #N$20 (four records).
 $E8D4 LDIR          ; Copy the records.
 $E8D6 RET           ; Return.

; Handle Weapon Pickup
;
; Handler for the object types #N$68 to #N$6B, the four weapons that
; Sabreman can pick up (see #R$DDA8). The weapons are the small object records
; at #R$902A. Byte #N$07 of a record holds the flags: bit 0 is set if there is
; no old image to erase, bit 1 is set while Sabreman carries the weapon and bit
; 2 is set while the weapon falls.
; .
; A weapon that lies on the floor is drawn again and again. When an action key
; has just been pressed (the flag at #R$8EEA is #N$FF) and Sabreman is touching
; it (see #R$E285), he picks it up: the weapon moves to the x position #N$88 and
; the y position #N$0F, which is its place in the panel at the top of the
; screen, bit 1 of the flags is set, the flag at #R$8EEA is set to #N$FE to show
; that the key press has been used, and the type of the weapon is stored in the
; first of the weapon slots at #R$8EEB.
; .
; Each later key press moves a carried weapon #N$18 pixels to the right in the
; panel and stores its type in the weapon slot that goes with the new x position
; (the x positions #N$A0 and #N$B8 both give the third slot, and none gives the
; second). A key press when the weapon has reached #N$B8 makes Sabreman drop it.
; It is put at his position, with bit 1 of the flags reset, bit 2 set and the
; counter in byte #N$06 set to #N$10, and it falls (see #R$E980).
; .
; A weapon that is in a different room is dealt with by #R$E9DF.
;
; IX Small object record of the weapon
@label=Handle_Weapon_Pickup
c$E8D7 CALL $989F      ; Save the state of the weapon.
 $E8DA BIT 1,(IX+$07)  ; {Jump to #R$E92A if Sabreman is carrying the weapon.
 $E8DE JR NZ,$E92A     ; }
 $E8E0 LD A,($8F1C)    ; Fetch the room x of Sabreman.
 $E8E3 CP (IX+$02)     ; {Jump to #R$E9DF if the weapon is in a different room
 $E8E6 JP NZ,$E9DF     ; x.}
 $E8E9 LD A,($8F1E)    ; Fetch the room y of Sabreman.
 $E8EC CP (IX+$04)     ; {Jump to #R$E9DF if the weapon is in a different room
 $E8EF JP NZ,$E9DF     ; y.}
 $E8F2 BIT 0,(IX+$07)  ; {Jump to #R$96E1 if it has no old image to erase.
 $E8F6 JP NZ,$96E1     ; }
 $E8F9 BIT 2,(IX+$07)  ; {Jump to #R$E980 if the weapon is falling.
 $E8FD JP NZ,$E980     ; }
 $E900 LD A,($8EEA)    ; Fetch the flag for a new action key press.
 $E903 AND A           ; {Jump to #R$E97A if no action key has been pressed.
 $E904 JR Z,$E97A      ; }
 $E906 INC A           ; {Jump to #R$E97A if the key press has been used already (the flag is
 $E907 JR NZ,$E97A     ; not #N$FF).}
 $E909 CALL $E285      ; Check for contact with Sabreman.
 $E90C BIT 2,C         ; {Jump to #R$E97A if Sabreman is not touching the
 $E90E JR Z,$E97A      ; weapon.}
 $E910 LD (IX+$01),$88 ; Set the x position of the weapon to #N$88.
 $E914 LD (IX+$03),$0F ; Set the y position of the weapon to #N$0F.
 $E918 SET 1,(IX+$07)  ; Set bit 1 of the flags, as Sabreman carries the
                       ; weapon.
 $E91C LD A,$FE        ; {Mark the key press as used by writing #N$FE to
 $E91E LD ($8EEA),A    ; #R$8EEA.}
 $E921 LD A,(IX+$00)   ; Fetch the type of the weapon.
 $E924 LD ($8EEB),A    ; Store it in the first weapon slot.
 $E927 JP $96E1        ; Jump to #R$96E1.
@label=Handle_Weapon_Pickup_Carried
*$E92A RES 0,(IX+$07)  ; Reset bit 0 of the flags.
 $E92E LD A,($8EEA)    ; Fetch the flag for a new action key press.
 $E931 AND A           ; {Jump to #R$E97A if no action key has been pressed.
 $E932 JR Z,$E97A      ; }
 $E934 LD A,(IX+$01)   ; Fetch the x position of the weapon.
 $E937 ADD A,$18       ; Add #N$18, to move it to the next place in the panel.
 $E939 CP $C8          ; {Jump to #R$E95E if the result is less than #N$C8.
 $E93B JR C,$E95E      ; }
 $E93D LD HL,($8F1B)   ; Fetch the x position and the room x of Sabreman.
 $E940 LD (IX+$01),L   ; Set the x position of the weapon.
 $E943 LD (IX+$02),H   ; Set the room x of the weapon.
 $E946 LD HL,($8F1D)   ; Fetch the y position and the room y of Sabreman.
 $E949 LD (IX+$03),L   ; Set the y position of the weapon.
 $E94C LD (IX+$04),H   ; Set the room y of the weapon.
 $E94F RES 1,(IX+$07)  ; Reset bit 1 of the flags, as the weapon is dropped.
 $E953 SET 2,(IX+$07)  ; Set bit 2 of the flags, as the weapon falls.
 $E957 LD (IX+$06),$10 ; Set the counter in byte #N$06 to #N$10.
 $E95B JP $96E1        ; Jump to #R$96E1.
@label=Handle_Weapon_Pickup_Next_Slot
*$E95E LD (IX+$01),A   ; Set the x position of the weapon.
 $E961 RRA             ; {Shift the x position right four times.
 $E962 RRA             ;
 $E963 RRA             ;
 $E964 RRA             ; }
 $E965 AND %00000011   ; Keep only the two low bits.
 $E967 CP $03          ; {Jump to #R$E96C unless the result is #N$03.
 $E969 JR NZ,$E96C     ; }
 $E96B DEC A           ; Change #N$03 to #N$02.
@label=Handle_Weapon_Pickup_Store_Slot
*$E96C LD E,A          ; Store the weapon slot number in #REGe.
 $E96D LD D,$00        ; Clear the high byte of the slot number.
 $E96F LD HL,$8EEB     ; Point #REGhl at #R$8EEB.
 $E972 ADD HL,DE       ; Add the slot number to point at the weapon slot.
 $E973 LD A,(IX+$00)   ; Fetch the type of the weapon.
 $E976 LD (HL),A       ; Store it in the weapon slot.
 $E977 JP $96E1        ; Jump to #R$96E1.
@label=Handle_Weapon_Pickup_Draw
*$E97A CALL $9689      ; Prepare the sprite of the weapon.
 $E97D JP $9867        ; Jump to #R$9867.
; The weapon falls. The counter in byte #N$06 goes up on every call and
; one sixteenth of it is added to the y position.
@label=Handle_Weapon_Pickup_Fall
*$E980 LD A,(IX+$06)   ; Fetch the counter.
 $E983 INC (IX+$06)    ; Add one to the counter.
 $E986 RRA             ; {Divide the old value by sixteen.
 $E987 RRA             ;
 $E988 RRA             ;
 $E989 RRA             ; }
 $E98A AND %00001111   ; Keep only the low four bits.
 $E98C ADD A,(IX+$03)  ; Add the y position of the weapon.
 $E98F LD (IX+$03),A   ; Set the y position of the weapon.
 $E992 CALL $B43E      ; Check for contact with the decorations.
 $E995 BIT 2,C         ; {Jump to #R$E9A8 if the weapon is not touching a
 $E997 JR Z,$E9A8      ; decoration.}
 $E999 LD A,B          ; Copy #N$A0 less the y position of the top of the decoration to
                       ; #REGa.
 $E99A NEG             ; Negate it.
 $E99C ADD A,$A1       ; Add #N$A1, to get the y position just below the top of the
                       ; decoration.
 $E99E LD (IX+$03),A   ; Set the y position of the weapon.
 $E9A1 RES 2,(IX+$07)  ; Reset bit 2 of the flags, as the weapon has stopped
                       ; falling.
 $E9A5 JP $96E1        ; Jump to #R$96E1.
@label=Handle_Weapon_Pickup_Check_Floor
*$E9A8 LD A,(IX+$03)   ; Fetch the y position of the weapon.
 $E9AB CP $9F          ; {Jump to #R$96E1 if it is less than #N$9F.
 $E9AD JP C,$96E1      ; }
 $E9B0 CALL $98CC      ; Read the world map entry of the room that the weapon is in. The
                       ; flags of the room are returned in #REGe.
 $E9B3 BIT 4,E         ; {Jump to #R$E9C2 if the room has no floor.
 $E9B5 JR Z,$E9C2      ; }
 $E9B7 LD (IX+$03),$9F ; Set the y position of the weapon to #N$9F, which is
                       ; the floor.
 $E9BB RES 2,(IX+$07)  ; Reset bit 2 of the flags, as the weapon has stopped
                       ; falling.
 $E9BF JP $96E1        ; Jump to #R$96E1.
@label=Handle_Weapon_Pickup_Check_Bottom
*$E9C2 LD A,(IX+$03)   ; Fetch the y position of the weapon.
 $E9C5 CP $BF          ; {Jump to #R$96E1 if it is less than #N$BF.
 $E9C7 JP C,$96E1      ; }
@label=Handle_Weapon_Pickup_Next_Room
*$E9CA INC (IX+$04)    ; Move the weapon to the room below.
 $E9CD CALL $98CC      ; Read the world map entry of the room that the weapon
                       ; is in.
 $E9D0 BIT 4,E         ; {Jump back to #R$E9CA if the room has no floor.
 $E9D2 JR Z,$E9CA      ; }
 $E9D4 LD (IX+$03),$9E ; Set the y position of the weapon to #N$9E.
 $E9D8 LD (IX+$06),$00 ; Clear the counter in byte #N$06.
 $E9DC JP $9636        ; Erase the sprite of the weapon.

; Handle Distant Weapon
;
; Used by the routine at #R$E8D7.
; .
; Deals with a weapon that is in a different room from Sabreman (see
; #R$E8D7). Bit 0 of the flags is set, so that the weapon is drawn without an
; old image to erase when Sabreman comes back. If the weapon falls it moves down
; through the rooms below until it gets to one that has a floor, and it is put
; at the y position #N$9E with its counter cleared.
;
; IX Small object record of the weapon
@label=Handle_Distant_Weapon
c$E9DF SET 0,(IX+$07)  ; Set bit 0 of the flags.
 $E9E3 BIT 2,(IX+$07)  ; {Jump to #R$E9ED if the weapon is falling.
 $E9E7 JR NZ,$E9ED     ; }
 $E9E9 RET             ; Return.
@label=Handle_Distant_Weapon_Next_Room
*$E9EA INC (IX+$04)    ; Move the weapon to the room below.
@label=Handle_Distant_Weapon_Find_Floor
*$E9ED CALL $98CC      ; Read the world map entry of the room that the weapon is in. The
                       ; flags of the room are returned in #REGe.
 $E9F0 BIT 4,E         ; {Jump back to #R$E9EA if the room has no floor.
 $E9F2 JR Z,$E9EA      ; }
 $E9F4 LD (IX+$03),$9E ; Set the y position of the weapon to #N$9E.
 $E9F8 LD (IX+$06),$00 ; Clear the counter in byte #N$06.
 $E9FC RET             ; Return.

; Weapon Placement Table
;
; Four sets of four records of #N$08 bytes each, which #R$E8BE copies to
; the small object records at #R$902A (see #R$E8D7). A record has the type
; (#N$68 to #N$6B), the x position, the room x, the y position (#N$9F, which is
; the floor, or #N$8F for one of them), the room y and the attribute (#N$42 red,
; #N$43 magenta, #N$44 green or #N$45 cyan). Byte #N$06 (the counter) is zero
; and byte #N$07 holds the flags #N$05, which are bit 0 (no old image to erase)
; and bit 2 (falling). Each set has one weapon of each type, but in different
; places.
;
; .
;
; The first set.
@label=Weapon_Placement_Table
b$E9FD DEFB $68,$20,$09,$9F,$0E,$42,$00,$05
 $EA05 DEFB $69,$30,$05,$9F,$13,$43,$00,$05
 $EA0D DEFB $6A,$70,$0B,$9F,$08,$44,$00,$05
 $EA15 DEFB $6B,$80,$0A,$9F,$10,$45,$00,$05
; The second set.
 $EA1D DEFB $68,$20,$09,$9F,$0E,$42,$00,$05
 $EA25 DEFB $69,$30,$0F,$9F,$0B,$43,$00,$05
 $EA2D DEFB $6A,$70,$08,$9F,$16,$44,$00,$05
 $EA35 DEFB $6B,$80,$0A,$9F,$0F,$45,$00,$05
; The third set.
 $EA3D DEFB $68,$20,$09,$9F,$0E,$42,$00,$05
 $EA45 DEFB $69,$30,$08,$9F,$18,$43,$00,$05
 $EA4D DEFB $6A,$70,$06,$9F,$0A,$44,$00,$05
 $EA55 DEFB $6B,$50,$0D,$9F,$12,$45,$00,$05
; The fourth set.
 $EA5D DEFB $68,$20,$09,$9F,$0E,$42,$00,$05
 $EA65 DEFB $69,$30,$01,$9F,$18,$43,$00,$05
 $EA6D DEFB $6A,$70,$06,$9F,$0E,$44,$00,$05
 $EA75 DEFB $6B,$90,$0E,$8F,$0E,$45,$00,$05

; Handle Fire
;
; Handler for the object types #N$70 and #N$71, the fire that is thrown by
; the torch (see #R$B4D1). Bit 0 of the type and the attribute follow bit 0 of
; the tick counter, so the fire flickers between two frames and between red
; (#N$42) and magenta (#N$43). It moves in the same way as the other thrown
; weapons (see #R$B58C).
;
; IX Object record of the fire
@label=Handle_Fire
c$EA7D CALL $989F    ; Save the state of the fire.
 $EA80 LD A,($8ED6)  ; Fetch the tick counter.
 $EA83 AND %00000001 ; Keep only bit 0.
 $EA85 LD B,A        ; Store it in #REGb.
 $EA86 LD A,(IX+$00) ; Fetch the type of the fire.
 $EA89 AND %11111110 ; Reset bit 0.
 $EA8B ADD A,B       ; Add bit 0 of the tick counter.
 $EA8C LD (IX+$00),A ; Set the type of the fire.
 $EA8F LD A,($8ED6)  ; Fetch the tick counter.
 $EA92 AND %00000001 ; Keep only bit 0.
 $EA94 ADD A,$42     ; Add #N$42.
 $EA96 LD (IX+$05),A ; Set the attribute of the fire.
 $EA99 JP $B58C      ; Jump to #R$B58C to move the fire.

; Handle Projectile
;
; Handler for the object types #N$6C to #N$6F, which are the daggers and
; the arrows that Sabreman throws (see #R$B4D1). It saves the state of the
; object and moves it in the same way as the other thrown weapons (see #R$B58C).
;
; IX Object record of the projectile
@label=Handle_Projectile
c$EA9C CALL $989F    ; Save the state of the projectile.
 $EA9F JP $B58C      ; Jump to #R$B58C to move the projectile.

; Load Room Decorations
;
; Used by the routine at #R$9906.
; .
; Copies the four decorations of the room that Sabreman is in from the
; table at #R$6800 into the four object records that start at #R$8F7A.
; It is used for the special rooms (a room y below #N$10), where the decorations
; are the furniture and the pictures.
; .
; The table has eight bytes for each room, and #N$80 bytes for each row of #N$10
; rooms. A pair of bytes describes each decoration. The first byte is the sprite
; id, which becomes the type of the object. The high nibble of the second byte
; is the x position in units of #N$10 pixels and the low nibble is the y
; position in units of #N$08 pixels.
; .
; The records are set up with the attribute #N$45 (cyan) and bit 0 of the redraw
; flags set, so that the decorations are drawn when they are first handled (by
; #R$EAF9 or #R$EB39).
;
; IX Object record of Sabreman
@label=Load_Room_Decorations
c$EAA2 LD H,(IX+$04)   ; Fetch the room y of Sabreman into #REGh.
 $EAA5 LD L,(IX+$02)   ; Fetch the room x of Sabreman into #REGl.
 $EAA8 SLA L           ; {Multiply the room x by eight, as there are eight
 $EAAA SLA L           ; bytes in an entry.
 $EAAC SLA L           ; }
 $EAAE XOR A           ; {Clear #REGa and halve the room y, with the lowest bit going into bit
 $EAAF SRL H           ; 7 of #REGa. This makes the offset of the row of rooms (#N$80 bytes for each
 $EAB1 RRA             ; room y).}
 $EAB2 ADD A,L         ; Add the offset for the room x.
 $EAB3 LD L,A          ; #REGhl is now the offset of the entry in the table.
 $EAB4 LD DE,$6800     ; Point #REGde at #R$6800.
 $EAB7 ADD HL,DE       ; Make #REGhl point at the entry of the room.
 $EAB8 DI              ; Disable interrupts.
 $EAB9 PUSH IY         ; Save #REGiy.
 $EABB LD IY,$8F7A     ; Point #REGiy at #R$8F7A.
 $EABF LD DE,$0010     ; Set the size of an object record in #REGde.
 $EAC2 LD B,$04        ; Set the number of decorations to load to #N$04.
@label=Load_Room_Decorations_Loop
*$EAC4 LD A,(HL)       ; Fetch the sprite id of the decoration.
 $EAC5 LD (IY+$00),A   ; Store it as the type of the object.
 $EAC8 INC HL          ; Move on to the position byte.
 $EAC9 LD A,(HL)       ; Fetch the position byte.
 $EACA AND %11110000   ; Keep the high nibble.
 $EACC ADD A,$08       ; Add #N$08.
 $EACE LD (IY+$01),A   ; Set the x position of the decoration.
 $EAD1 LD A,(HL)       ; Fetch the position byte again.
 $EAD2 RLA             ; {Shift it left three times, which moves the low nibble to bits 3 to
 $EAD3 RLA             ; 6.
 $EAD4 RLA             ; }
 $EAD5 AND %01111000   ; Keep only those bits.
 $EAD7 ADD A,$3F       ; Add #N$3F.
 $EAD9 LD (IY+$03),A   ; Set the y position of the decoration.
 $EADC LD A,(IX+$02)   ; Fetch the room x.
 $EADF LD (IY+$02),A   ; Set the room x of the decoration.
 $EAE2 LD A,(IX+$04)   ; Fetch the room y.
 $EAE5 LD (IY+$04),A   ; Set the room y of the decoration.
 $EAE8 LD (IY+$0F),$01 ; Set bit 0 of the redraw flags, as the decoration has not been drawn
                       ; yet.
 $EAEC LD (IY+$05),$45 ; Set the attribute of the decoration to #N$45 (cyan).
 $EAF0 INC HL          ; Move on to the next pair of bytes in the table.
 $EAF1 ADD IY,DE       ; Move on to the next object record.
 $EAF3 DJNZ $EAC4      ; Loop back until all four decorations have been loaded.
 $EAF5 POP IY          ; Restore #REGiy.
 $EAF7 EI              ; Enable interrupts.
 $EAF8 RET             ; Return.

; Handle Plain Decoration
;
; Handler for the object types #N$74 to #N$78: the clock, the tapestry,
; the table, the sideboard and the bird (see #R$889D). These decorations are
; drawn in the single attribute of the record, which is cyan. The other
; decorations, which have colours of their own, are handled by #R$EB39.
; .
; A decoration is removed (see #R$E7A8) when Sabreman is not in its room. The
; first time that it is handled #R$EB18 gives it the size of its obstacle, which
; #R$B46A uses to find out if an object touches it, and then #R$AF3F draws it.
; After that #R$AF3F only colours it.
;
; IX Object record of the decoration
@label=Handle_Plain_Decoration
c$EAF9 LD A,($8F1C)   ; Fetch the room x of Sabreman.
 $EAFC CP (IX+$02)    ; {Jump to #R$E7A8 to remove the decoration if it is in a different
 $EAFF JP NZ,$E7A8    ; room x.}
 $EB02 LD A,($8F1E)   ; Fetch the room y of Sabreman.
 $EB05 CP (IX+$04)    ; {Jump to #R$E7A8 to remove the decoration if it is in a different
 $EB08 JP NZ,$E7A8    ; room y.}
 $EB0B BIT 0,(IX+$0F) ; {Jump to #R$AF3F if the decoration has been drawn already (bit 0 of
 $EB0F JP Z,$AF3F     ; the redraw flags is clear).}
 $EB12 CALL $EB18     ; Copy the size of the obstacle to the object record.
 $EB15 JP $AF3F       ; Jump to #R$AF3F to draw the decoration.

; Set Decoration Size
;
; Used by the routines at #R$EAF9 and #R$EB39.
; .
; Copies the five bytes that describe the size of the obstacle that a
; decoration makes (see #R$B46A) from the table at #R$EB7E to the bytes #N$0A to
; #N$0E of its object record. The entry is chosen by the type of the decoration,
; which is #N$74 for the first entry.
;
; IX Object record of the decoration
@label=Set_Decoration_Size
c$EB18 LD A,(IX+$00) ; Fetch the type of the decoration.
 $EB1B SUB $74       ; Subtract #N$74 to make the number of the entry.
 $EB1D LD C,A        ; Store the number in #REGc.
 $EB1E SLA A         ; {Multiply the number by four.
 $EB20 SLA A         ; }
 $EB22 ADD A,C       ; Add the number to make it five times the number.
 $EB23 LD E,A        ; Store the offset of the entry in #REGe.
 $EB24 LD D,$00      ; Clear the high byte of the offset.
 $EB26 LD HL,$EB7E   ; Point #REGhl at #R$EB7E.
 $EB29 ADD HL,DE     ; Make #REGhl point at the entry.
 $EB2A EX DE,HL      ; Swap, so that #REGde points at the entry.
 $EB2B PUSH IX       ; {Copy the address of the object record into #REGhl.
 $EB2D POP HL        ; }
 $EB2E LD BC,$000A   ; Set the offset of byte #N$0A in #REGbc.
 $EB31 ADD HL,BC     ; Make #REGhl point at byte #N$0A of the object record.
 $EB32 EX DE,HL      ; Swap, so that #REGhl points at the entry and #REGde at
                     ; the record.
 $EB33 LD BC,$0005   ; Set the number of bytes to copy to #N$0005.
 $EB36 LDIR          ; Copy the size to the object record.
 $EB38 RET           ; Return.

; Handle Coloured Decoration
;
; Handler for the object types #N$79 to #N$7E: the two pictures, the
; bookshelf, the hanging bowl, the bowl of flowers and the torch (see #R$8C69).
; They are coloured by copying the attributes from the colour data (see #R$DC0B)
; rather than from the single attribute of the record, so that they are not
; drawn in one colour only. The other decorations are handled by #R$EAF9.
; .
; A decoration is removed (see #R$E7A8) when Sabreman is not in its room. The
; first time that it is handled #R$EB18 gives it the size of its obstacle and it
; is drawn. It is then coloured every time that it is handled, by #R$E675.
;
; IX Object record of the decoration
@label=Handle_Coloured_Decoration
c$EB39 LD A,($8F1C)   ; Fetch the room x of Sabreman.
 $EB3C CP (IX+$02)    ; {Jump to #R$E7A8 to remove the decoration if it is in a different
 $EB3F JP NZ,$E7A8    ; room x.}
 $EB42 LD A,($8F1E)   ; Fetch the room y of Sabreman.
 $EB45 CP (IX+$04)    ; {Jump to #R$E7A8 to remove the decoration if it is in a different
 $EB48 JP NZ,$E7A8    ; room y.}
 $EB4B CALL $9689     ; Prepare the sprite of the decoration.
 $EB4E BIT 0,(IX+$0F) ; {Jump to #R$EB5E if the decoration has been drawn already (bit 0 of
 $EB52 JR Z,$EB5E     ; the redraw flags is clear).}
 $EB54 RES 0,(IX+$0F) ; Reset bit 0 of the redraw flags.
 $EB58 CALL $EB18     ; Copy the size of the obstacle to the object record.
 $EB5B CALL $962A     ; Draw the decoration.
@label=Handle_Coloured_Decoration_Colour
*$EB5E LD A,(IX+$00)  ; Fetch the type of the decoration.
 $EB61 SUB $79        ; Subtract #N$79 to make the number of the decoration.
 $EB63 SLA A          ; Double it, as the pointers are two bytes long.
 $EB65 LD E,A         ; Store the result in #REGe.
 $EB66 LD D,$00       ; Clear the high byte of the offset.
 $EB68 LD HL,$EB72    ; Point #REGhl at #R$EB72.
 $EB6B ADD HL,DE      ; Make #REGhl point at the pointer for the decoration.
 $EB6C LD E,(HL)      ; Fetch the low byte of the pointer.
 $EB6D INC HL         ; Move on to the high byte.
 $EB6E LD D,(HL)      ; Fetch the high byte, which makes #REGde point at the
                      ; colour data.
 $EB6F JP $E675       ; Jump to #R$E675 to colour the decoration.

; Decoration Colour Pointers
;
; One pointer to the colour data (see #R$DC0B) for each of the object
; types #N$79 to #N$7E, which #R$EB39 uses to colour the decorations.
@label=Decoration_Colour_Pointers
b$EB72 DEFW $DC72    ; The picture of type #N$79.
 $EB74 DEFW $DC86    ; The picture of type #N$7A.
 $EB76 DEFW $DC41    ; The bookshelf, the type #N$7B.
 $EB78 DEFW $DC69    ; The hanging bowl, the type #N$7C.
 $EB7A DEFW $DC5D    ; The bowl of flowers, the type #N$7D.
 $EB7C DEFW $DC53    ; The torch, the type #N$7E.

; Decoration Size Table
;
; Five bytes for each of the object types #N$74 to #N$7E, which #R$EB18
; copies to the bytes #N$0A to #N$0E of the object record. They are the half
; width of the decoration, the width of its middle, its height, the depth from
; the top at which an object counts as being beside it and the offset of its
; middle from its x position (see #R$B46A).
;
; .
;
; The clock, the type #N$74.
@label=Decoration_Size_Table
b$EB7E DEFB $14,$0C,$35,$2C,$04
; The tapestry, the type #N$75.
 $EB83 DEFB $14,$0C,$21,$19,$04
; The table, the type #N$76.
 $EB88 DEFB $24,$1C,$29,$1C,$14
; The sideboard, the type #N$77.
 $EB8D DEFB $2E,$25,$31,$24,$1C
; The bird, the type #N$78.
 $EB92 DEFB $18,$10,$19,$10,$08
; The picture, the type #N$79.
 $EB97 DEFB $18,$10,$21,$18,$08
; The picture, the type #N$7A.
 $EB9C DEFB $18,$10,$1D,$14,$08
; The bookshelf, the type #N$7B.
 $EBA1 DEFB $20,$18,$19,$10,$10
; The hanging bowl, the type #N$7C.
 $EBA6 DEFB $14,$0C,$19,$10,$04
; The bowl of flowers, the type #N$7D.
 $EBAB DEFB $18,$10,$19,$10,$08
; The torch, the type #N$7E.
 $EBB0 DEFB $10,$08,$29,$20,$00

; Decoration Height Table
;
; The height of each of the object types #N$74 to #N$7E, which is the same
; as the height in the #R$EB7E(size table). #R$EC3A uses it to put an extra life
; on top of a decoration.
@label=Decoration_Height_Table
b$EBB5 DEFB $35,$21,$29,$31,$19,$21,$1D,$19,$19,$19,$29

; Start Tumbling Inside Walls
;
; Used by the routine at #R$A6A6.
; .
; Makes Sabreman tumble (see #R$A925) when he is knocked about while he
; jumps or falls. The type of the object is set to #N$18, which is the first
; frame of the tumbling Sabreman.
; .
; The x position is then limited so that he does not tumble into the wall: it is
; kept below #N$C0 when the room has a wall on the right, and below #N$E8 when
; it does not.
;
; IX Object record of Sabreman
@label=Start_Tumbling_Inside_Walls
c$EBC0 LD (IX+$00),$18 ; Set the type of the object to #N$18, the tumbling
                       ; Sabreman.
 $EBC4 CALL $98CC      ; Fetch the frame flags of the room into #REGe.
 $EBC7 BIT 2,E         ; Test bit 2 of the frame flags, which is set when the room has a wall
                       ; on the right.
 $EBC9 LD A,(IX+$01)   ; Fetch the x position of the object.
 $EBCC JR Z,$EBD6      ; Jump to #R$EBD6 if there is no wall on the right.
 $EBCE CP $C0          ; {Return if the x position is less than #N$C0.
 $EBD0 RET C           ; }
 $EBD1 LD (IX+$01),$C0 ; Limit the x position to #N$C0.
 $EBD5 RET             ; Return.
@label=Start_Tumbling_Inside_Walls_No_Wall
*$EBD6 CP $E8          ; {Return if the x position is less than #N$E8.
 $EBD8 RET C           ; }
 $EBD9 LD (IX+$01),$E8 ; Limit the x position to #N$E8.
 $EBDD RET             ; Return.

; Place Guardian
;
; Used by the routine at #R$EC3A.
; .
; Puts a guardian in the room, unless it has been destroyed already. It is
; the continuation of #R$EC3A when the room of Sabreman is that of an entry of
; the table of guardians at #R$EDF4.
; .
; The rock formation is put in the room first (see #R$EC1C). The guardian is
; made from a copy of the template at #R$EDB4. Its type is #N$80, #N$86, #N$84
; or #N$82, which depends on the number of the entry, and it is placed at the x
; position #N$80 and the y position #N$9F with the attribute #N$03 (magenta).
; Byte #N$06 of the record holds the number of the entry, which #R$ECCA uses to
; set the collected flag of the entry when the guardian is destroyed.
; .
; The record that is used is the first of the two special object records,
; #R$8FBA.
;
; B Number of entries left in the table of guardians, including this one
; C Room x of Sabreman
; D Room y of Sabreman
; HL Address of the room y of the entry
@label=Place_Guardian
c$EBDE EXX             ; Switch to the alternate registers, to keep the registers that the
                       ; caller uses.
 $EBDF CALL $EC1C      ; Put the rock formation in the room.
 $EBE2 EXX             ; Switch back to the main registers.
 $EBE3 INC HL          ; Move on to the collected flag of the entry.
 $EBE4 LD A,(HL)       ; Fetch the collected flag.
 $EBE5 AND A           ; {Return if the guardian has been destroyed already.
 $EBE6 RET NZ          ; }
 $EBE7 LD A,B          ; Fetch the number of the entry, counted from the end of
                       ; the table.
 $EBE8 PUSH DE         ; Stash the room of Sabreman.
 $EBE9 LD HL,$EDB4     ; Point #REGhl at #R$EDB4.
 $EBEC LD DE,$8FBA     ; Point #REGde at #R$8FBA.
 $EBEF LD BC,$0010     ; Set the size of a record in #REGbc.
 $EBF2 LDIR            ; Copy the template to the record.
 $EBF4 LD ($8FC0),A    ; Store the number of the entry in byte #N$06 of the
                       ; record.
 $EBF7 POP BC          ; Restore the room of Sabreman into #REGbc.
 $EBF8 DI              ; Disable interrupts.
 $EBF9 PUSH IY         ; Save #REGiy.
 $EBFB LD IY,$8FBA     ; Point #REGiy at #R$8FBA.
 $EBFF RLA             ; Shift the number of the entry left, to double it.
 $EC00 AND %00000110   ; Keep the result in bits 1 and 2.
 $EC02 ADD A,$80       ; Add #N$80 to make the type of the guardian.
 $EC04 LD (IY+$00),A   ; Set the type of the guardian.
 $EC07 LD (IY+$02),C   ; Set the room x of the guardian.
 $EC0A LD (IY+$04),B   ; Set the room y of the guardian.
 $EC0D LD (IY+$01),$80 ; Set the x position of the guardian to #N$80.
 $EC11 LD (IY+$03),$9F ; Set the y position of the guardian to #N$9F.
 $EC15 LD (IY+$05),$03 ; Set the attribute of the guardian to #N$03 (magenta).
 $EC19 POP IY          ; Restore #REGiy.
 $EC1B RET             ; Return.

; Place Rock Formation
;
; Used by the routine at #R$EBDE.
; .
; Puts the rock formation of the type #N$88 (see #R$ED2E) in the room of a
; guardian, if the room is a cave.
; .
; The four object records that start at #R$8F7A are cleared. The third
; one, at #R$8F9A, becomes the rock formation and has bit 0 of its
; redraw flags set, so that it is drawn.
@label=Place_Rock_Formation
c$EC1C LD A,($8F1E)  ; Fetch the room y of Sabreman.
 $EC1F CP $10        ; {Return if the room is a special room (the room y is
 $EC21 RET C         ; below #N$10).}
 $EC22 LD HL,$8F7A   ; Point #REGhl at #R$8F7A.
 $EC25 LD DE,$0010   ; Set the size of a record in #REGde.
 $EC28 LD B,$04      ; Set the number of records to clear to #N$04.
@label=Place_Rock_Formation_Clear
*$EC2A LD (HL),$00   ; Clear the type of the record, which removes the object.
 $EC2C ADD HL,DE     ; Move on to the next record.
 $EC2D DJNZ $EC2A    ; Loop back until all four records have been cleared.
 $EC2F LD A,$88      ; Set the type of the third record to #N$88.
 $EC31 LD ($8F9A),A  ; Store the type in the record.
 $EC34 LD A,$01      ; Set bit 0 of the redraw flags.
 $EC36 LD ($8FA9),A  ; Store the flags in the third record.
 $EC39 RET           ; Return.

; Place Special Object
;
; Used by the routine at #R$9906.
; .
; Puts an extra life or a guardian in the room that Sabreman has just
; entered, if there is one in it and it has not been collected or destroyed.
; .
; The room of Sabreman is looked up in the table of the sixteen extra lives at
; #R$EDC4 and then in the table of the guardians at #R$EDF4 (the entries are
; three bytes long: the room x, the room y and a collected flag). A guardian is
; dealt with by #R$EBDE.
; .
; An extra life is made from a copy of the template at #R$EDB4 in the first of
; the two special object records at #R$8FBA. Byte #N$06 of the record
; holds the number of the entry, counted from the end of the table, which
; #R$E7AD uses to set the collected flag when the extra life is picked up.
; .
; The extra life sits on top of one of the two objects at #R$8F9A and
; #R$8FAA, which are the decorations of a special room or the
; stalactites of a cave: the first is used if the room y is odd, the second if
; it is even. In a special room the height of the object comes from the table at
; #R$EBB5.
; .
; The loop over the guardians counts eight entries, but the table only has four,
; so it carries on into the code that follows the table.
@label=Place_Special_Object
c$EC3A LD HL,$EDC4   ; Point #REGhl at the table of extra lives.
 $EC3D LD A,($8F1C)  ; Fetch the room x of Sabreman.
 $EC40 LD E,A        ; Store it in #REGe.
 $EC41 LD A,($8F1E)  ; Fetch the room y of Sabreman.
 $EC44 LD D,A        ; Store it in #REGd.
 $EC45 LD B,$10      ; Set the number of extra lives to check to #N$10.
@label=Place_Special_Object_Find_Extra_Life
*$EC47 LD A,(HL)     ; Fetch the room x of the entry.
 $EC48 INC HL        ; Move on to the room y.
 $EC49 CP E          ; {Jump to #R$EC50 if it is not the room x of Sabreman.
 $EC4A JR NZ,$EC50   ; }
 $EC4C LD A,(HL)     ; Fetch the room y of the entry.
 $EC4D CP D          ; {Jump to #R$EC68 if it is the room y of Sabreman.
 $EC4E JR Z,$EC68    ; }
@label=Place_Special_Object_Next_Extra_Life
*$EC50 INC HL        ; {Move on to the next entry.
 $EC51 INC HL        ; }
 $EC52 DJNZ $EC47    ; Loop back until all the extra lives have been checked.
 $EC54 LD HL,$EDF4   ; Point #REGhl at #R$EDF4.
 $EC57 LD B,$08      ; Set the number of guardians to check to #N$08.
@label=Place_Special_Object_Find_Guardian
*$EC59 LD A,(HL)     ; Fetch the room x of the entry.
 $EC5A INC HL        ; Move on to the room y.
 $EC5B CP E          ; {Jump to #R$EC63 if it is not the room x of Sabreman.
 $EC5C JR NZ,$EC63   ; }
 $EC5E LD A,(HL)     ; Fetch the room y of the entry.
 $EC5F CP D          ; {Jump to #R$EBDE if it is the room y of Sabreman, to place the
 $EC60 JP Z,$EBDE    ; guardian.}
@label=Place_Special_Object_Next_Guardian
*$EC63 INC HL        ; {Move on to the next entry.
 $EC64 INC HL        ; }
 $EC65 DJNZ $EC59    ; Loop back until all the entries have been checked.
 $EC67 RET           ; Return.
@label=Place_Special_Object_Extra_Life
*$EC68 INC HL        ; Move on to the collected flag of the entry.
 $EC69 LD A,(HL)     ; Fetch the collected flag.
 $EC6A AND A         ; {Return if the extra life has been collected already.
 $EC6B RET NZ        ; }
 $EC6C LD A,B        ; Fetch the number of the entry, counted from the end of
                     ; the table.
 $EC6D PUSH DE       ; Stash the room of Sabreman.
 $EC6E LD HL,$EDB4   ; Point #REGhl at #R$EDB4.
 $EC71 LD DE,$8FBA   ; Point #REGde at #R$8FBA.
 $EC74 LD BC,$0010   ; Set the size of a record in #REGbc.
 $EC77 LDIR          ; Copy the template to the record.
 $EC79 LD ($8FC0),A  ; Store the number of the entry in byte #N$06 of the
                     ; record.
 $EC7C POP BC        ; Restore the room of Sabreman into #REGbc.
 $EC7D DI            ; Disable interrupts.
 $EC7E PUSH IY       ; Save #REGiy.
 $EC80 LD IY,$8F9A   ; Point #REGiy at the object at #R$8F9A.
 $EC84 BIT 0,B       ; {Jump to #R$EC8C if the room y is odd.
 $EC86 JR NZ,$EC8C   ; }
 $EC88 LD IY,$8FAA   ; Point #REGiy at the object at #R$8FAA instead.
@label=Place_Special_Object_Set_Position
*$EC8C LD DE,$8FBB   ; Point #REGde at the x position of the special object
                     ; record.
 $EC8F LD A,(IY+$01) ; Fetch the x position of the object.
 $EC92 ADD A,$08     ; Add #N$08.
 $EC94 LD (DE),A     ; Set the x position of the extra life.
 $EC95 INC DE        ; Move on to the room x.
 $EC96 LD A,C        ; Fetch the room x.
 $EC97 LD (DE),A     ; Set the room x of the extra life.
 $EC98 INC DE        ; Move on to the y position.
 $EC99 LD A,B        ; Fetch the room y.
 $EC9A CP $10        ; {Jump to #R$ECB0 if the room is a cave (the room y is
 $EC9C JR NC,$ECB0   ; #N$10 or more).}
@label=Place_Special_Object_Set_Height
 $EC9E LD HL,$EBB5   ; Point #REGhl at #R$EBB5.
 $ECA1 LD A,(IY+$00) ; Fetch the type of the decoration.
 $ECA4 SUB $74       ; Subtract #N$74 to make the number of the decoration.
 $ECA6 ADD A,L       ; Add the number to the address in #REGhl.
 $ECA7 LD L,A        ; Store the low byte of the address.
 $ECA8 LD A,H        ; Fetch the high byte of the address.
 $ECA9 ADC A,$00     ; Add the carry.
 $ECAB LD H,A        ; Store the high byte of the address.
 $ECAC LD A,(HL)     ; Fetch the height of the decoration.
 $ECAD LD (IY+$0C),A ; Store it in byte #N$0C of the object, where the size of the obstacle
                     ; is kept.
@label=Place_Special_Object_Set_Top
*$ECB0 LD A,(IY+$03) ; Fetch the y position of the object.
 $ECB3 SUB (IY+$0C)  ; Subtract its height to get the y position of its top.
 $ECB6 LD (DE),A     ; Set the y position of the extra life.
 $ECB7 INC DE        ; Move on to the room y.
 $ECB8 LD A,B        ; Fetch the room y.
 $ECB9 LD (DE),A     ; Set the room y of the extra life.
 $ECBA POP IY        ; Restore #REGiy.
 $ECBC RET           ; Return.

; Clear Collected Flags
;
; Used by the routine at #R$91C0.
; .
; Clears the collected flags of the sixteen extra lives and the four
; guardians, which are in the two tables that start at #R$EDC4. It is used when
; a new game starts.
@label=Clear_Collected_Flags
c$ECBD LD HL,$EDC6   ; Point #REGhl at the collected flag of the first entry.
 $ECC0 LD B,$14      ; Set the number of entries to clear to #N$14.
@label=Clear_Collected_Flags_Loop
*$ECC2 LD (HL),$00   ; Clear the collected flag.
 $ECC4 INC HL        ; {Move on to the next entry.
 $ECC5 INC HL        ;
 $ECC6 INC HL        ; }
 $ECC7 DJNZ $ECC2    ; Loop back until all the flags have been cleared.
 $ECC9 RET           ; Return.

; Handle Guardian
;
; Handler for the object types #N$80 to #N$87, the four guardians that
; stand in the caves: the imps (#N$80, #N$81, #N$84 and #N$85, see #R$A1B5), the
; spiders (#N$82 and #N$83, see #R$D4B9) and the bats (#N$86 and #N$87, see
; #R$A267). Bit 0 of the type is the frame of the animation and it is flipped
; whenever bit 0 of the tick counter is set. #R$EBDE puts a guardian in its
; room, where it stays until Sabreman leaves the room (see #R$E7A8).
; .
; A guardian is destroyed by one kind of weapon, which depends on bits 1 and 2
; of its type: the daggers (the types #N$6C and #N$6D) destroy a spider, the
; arrows (#N$6E and #N$6F) destroy the imp of the type #N$84 and the fire (#N$70
; and #N$71) destroys a bat. The imp of the type #N$80 cannot be destroyed. When
; a guardian is destroyed its collected flag is set (see #R$E7C2), the flag at
; #R$8EF9 is set and the guardian explodes (see #R$DF42).
; .
; A guardian that is touched by Sabreman makes him tumble (bit 7 of his redraw
; flags is set) and pushes him to the left (his x velocity is set to #N$FE).
;
; IX Object record of the guardian
@label=Handle_Guardian
c$ECCA CALL $989F    ; Save the state of the guardian.
 $ECCD LD A,($8F1C)  ; Fetch the room x of Sabreman.
 $ECD0 CP (IX+$02)   ; {Jump to #R$E7A8 to remove the guardian if it is in a different room
 $ECD3 JP NZ,$E7A8   ; x.}
 $ECD6 LD A,($8F1E)  ; Fetch the room y of Sabreman.
 $ECD9 CP (IX+$04)   ; {Jump to #R$E7A8 to remove the guardian if it is in a different room
 $ECDC JP NZ,$E7A8   ; y.}
 $ECDF LD A,($8ED6)  ; Fetch the tick counter.
 $ECE2 AND %00000001 ; Test bit 0 of the tick counter.
 $ECE4 JR Z,$ECEE    ; Jump to #R$ECEE if it is not set.
 $ECE6 LD A,(IX+$00) ; Fetch the type of the guardian.
 $ECE9 XOR %00000001 ; Flip the frame of the animation.
 $ECEB LD (IX+$00),A ; Store the type.
@label=Handle_Guardian_Check_Weapon
*$ECEE CALL $B6E8    ; Check whether a weapon has hit the guardian.
 $ECF1 LD A,D        ; {Jump to #R$ED16 if no weapon has hit it.
 $ECF2 AND A         ;
 $ECF3 JR Z,$ED16    ; }
 $ECF5 LD A,E        ; Fetch the type of the weapon into #REGa.
 $ECF6 CP $6C        ; {Jump to #R$ED16 if the weapon is not a dagger, an arrow
 $ECF8 JR C,$ED16    ; or fire.}
 $ECFA RRA           ; Halve the type of the weapon.
 $ECFB DEC A         ; Subtract one.
 $ECFC AND %00000011 ; Keep the two low bits, which gives the kind of weapon (#N$01
                     ; for the daggers, #N$02 for the arrows and #N$03 for the fire).
 $ECFE LD E,A        ; Store the kind in #REGe.
 $ECFF LD A,(IX+$00) ; Fetch the type of the guardian.
 $ED02 RRA           ; Halve it.
 $ED03 AND %00000011 ; Keep the two low bits, which gives the kind of weapon that
                     ; destroys the guardian.
 $ED05 CP E          ; {Jump to #R$ED16 if the weapon is not the right one for
 $ED06 JR NZ,$ED16   ; the guardian.}
 $ED08 LD HL,$EDF6   ; Point #REGhl at #R$EDF6.
 $ED0B CALL $E7C2    ; Set the collected flag of this guardian.
 $ED0E LD A,$01      ; {Set the flag that shows that a guardian has been
 $ED10 LD ($8EF9),A  ; destroyed.}
 $ED13 JP $DF42      ; Jump to #R$DF42 to make the guardian explode.
@label=Handle_Guardian_Check_Sabreman
*$ED16 CALL $E28D    ; Check for contact with Sabreman, without testing his
                     ; sprite id.
 $ED19 BIT 2,C       ; {Jump to #R$96CB to draw the guardian if Sabreman is not
 $ED1B JP Z,$96CB    ; touching it.}
 $ED1E LD A,($8F29)  ; Fetch the redraw flags of Sabreman.
 $ED21 OR %10000000  ; Set bit 7, which makes him tumble.
 $ED23 LD ($8F29),A  ; Store the flags.
 $ED26 LD A,$FE      ; Set the x velocity of Sabreman to #N$FE, which pushes him to the
                     ; left.
 $ED28 LD ($8F20),A  ; Store the velocity.
 $ED2B JP $96CB      ; Jump to #R$96CB to draw the guardian.

; Handle Rock Formation
;
; Handler for the object type #N$88, the rock formation that hangs from
; the ceiling of the cave of a guardian (see #R$EC1C).
; .
; The formation is made from ten of the rocks of the sprite at #R$D815, in four
; rows of four, three, two and one rocks. They are drawn once, when bit 0 of the
; redraw flags is set. The rocks of a row are #N$08 pixels apart, and the rows
; are #N$18 pixels apart: the y positions of the rows are #N$30, #N$48, #N$60
; and #N$78, and the x positions of the first rocks are #N$78, #N$7A, #N$7E and
; #N$82. The bit is set again before each rock is drawn so that nothing is
; erased.
; .
; After that the area that the formation covers is coloured on every call, with
; five cells in each of ten rows set to the attribute #N$46 (yellow).
; .
; An object touches the formation according to #R$ED8A.
;
; IX Object record of the rock formation
@label=Handle_Rock_Formation
c$ED2E BIT 0,(IX+$0F)  ; {Jump to #R$ED73 to colour the formation if it has been drawn
 $ED32 JR Z,$ED73      ; already.}
 $ED34 LD (IX+$01),$78 ; Set the x position of the first rock to #N$78.
 $ED38 LD (IX+$03),$30 ; Set the y position of the first row to #N$30.
 $ED3C LD C,$04        ; Set the number of rocks in the first row (and of rows)
                       ; to four.
 $ED3E LD (IX+$05),$46 ; Set the attribute of the rocks to #N$46 (yellow).
@label=Handle_Rock_Formation_Row
*$ED42 LD B,C          ; Set the number of rocks in the row.
@label=Handle_Rock_Formation_Rock
*$ED43 PUSH BC         ; Stash the counters.
 $ED44 CALL $96CB      ; Draw the rock.
 $ED47 SET 0,(IX+$0F)  ; Set bit 0 of the redraw flags, so that the next rock does not erase
                       ; the last one.
 $ED4B LD A,(IX+$01)   ; Fetch the x position.
 $ED4E ADD A,$08       ; Move on to the next rock.
 $ED50 LD (IX+$01),A   ; Set the x position.
 $ED53 POP BC          ; Restore the counters.
 $ED54 DJNZ $ED43      ; Loop back until the row has been drawn.
 $ED56 LD A,C          ; Fetch the number of rows left.
 $ED57 SLA A           ; Double it.
 $ED59 DEC A           ; Subtract one.
 $ED5A SLA A           ; Double it again.
 $ED5C NEG             ; Negate it.
 $ED5E ADD A,$88       ; Add #N$88 to make the x position of the first rock of
                       ; the next row.
 $ED60 LD (IX+$01),A   ; Set the x position.
 $ED63 LD A,(IX+$03)   ; Fetch the y position.
 $ED66 ADD A,$18       ; Move on to the next row.
 $ED68 LD (IX+$03),A   ; Set the y position.
 $ED6B DEC C           ; {Jump back to #R$ED42 until all the rows have been
 $ED6C JR NZ,$ED42     ; drawn.}
 $ED6E RES 0,(IX+$0F)  ; Reset bit 0 of the redraw flags.
 $ED72 RET             ; Return.
@label=Handle_Rock_Formation_Colour
*$ED73 LD HL,$3078     ; Set the x position #N$78 in #REGl and the y position
                       ; #N$30 in #REGh.
 $ED76 CALL $ADE0      ; Get the attribute address of the cell.
 $ED79 LD DE,$001B     ; Set the offset to the start of the next row (the row is #N$20 cells
                       ; long and five have been set).
 $ED7C LD C,$0A        ; Set the number of rows to colour to ten.
@label=Handle_Rock_Formation_Colour_Row
*$ED7E LD B,$05        ; Set the number of cells in each row to five.
@label=Handle_Rock_Formation_Colour_Cell
*$ED80 LD (HL),$46     ; Set the attribute of the cell to #N$46 (yellow).
 $ED82 INC L           ; Move on to the next cell.
 $ED83 DJNZ $ED80      ; Loop back until the row has been coloured.
 $ED85 ADD HL,DE       ; Move on to the next row.
 $ED86 DEC C           ; {Jump back to #R$ED7E until all the rows have been
 $ED87 JR NZ,$ED7E     ; coloured.}
 $ED89 RET             ; Return.

; Check Rock Formation Contact
;
; Used by the routine at #R$B46A.
; .
; Checks whether an object touches the rock formation (see #R$ED2E). It is
; used by #R$B46A in place of the usual test when the obstacle is of the type
; #N$88.
; .
; The formation is a triangle with its point at the bottom, which is centred on
; the x position #N$80. The half width of the triangle at the height of the
; object is #N$9A less the y position of the object, divided by four (the half
; width is larger when the object is higher) and then #N$08 is added. An object
; touches the formation when it is not below #N$90 and its distance from the
; centre is less than that.
; .
; The result has bits 0 and 2 set when the object touches the formation, and bit
; 7 as well when the object is on the right of the centre. The object is never
; standing on the formation.
;
;   IX Object record
; O:C Contact result (see #R$B46A)
@label=Check_Rock_Formation_Contact
c$ED8A LD C,$00      ; Clear the contact result.
 $ED8C LD B,$01      ; #REGb=#N$01.
 $ED8E LD A,(IX+$03) ; Fetch the y position of the object.
 $ED91 CP $90        ; {Return if the object is #N$90 or more pixels down, as it is below
 $ED93 RET NC        ; the formation.}
 $ED94 NEG           ; Negate the y position.
 $ED96 SUB $66       ; Subtract #N$66, which gives #N$9A less the y position.
 $ED98 SRL A         ; {Divide the result by four.
 $ED9A SRL A         ; }
 $ED9C ADD A,$08     ; Add #N$08.
 $ED9E LD D,A        ; Store the half width in #REGd.
 $ED9F LD A,$80      ; Set the centre of the formation, #N$80.
 $EDA1 SUB (IX+$01)  ; {Jump to #R$EDAB if the object is on the left of the
 $EDA4 JP P,$EDAB    ; centre.}
 $EDA7 NEG           ; Make the distance positive.
 $EDA9 SET 7,C       ; Set bit 7 of the result, as the object is on the right.
@label=Check_Rock_Formation_Contact_Test_Width
*$EDAB CP D          ; {Jump to #R$B4CA if the distance is the half width or more, as the
 $EDAC JP NC,$B4CA   ; objects do not touch.}
 $EDAF SET 0,C       ; Set bit 0 of the result, as the object is outside the
                     ; middle.
 $EDB1 SET 2,C       ; Set bit 2 of the result, as the objects touch.
 $EDB3 RET           ; Return.

; Extra Life Template
;
; An object record that #R$EC3A copies to the first of the two special
; object records at #R$8FBA, to make an extra life. #R$EBDE uses it for
; a guardian too and changes the type, the attribute and the position.
@label=Extra_Life_Template
b$EDB4 DEFB $7F                             ; The type, #N$7F (see #R$A1A3).
 $EDB5 DEFB $00,$00,$00,$00                 ; The x position, the room x, the y position and the room y, which
                                            ; are set when the extra life is placed.
 $EDB9 DEFB $47                             ; The attribute, #N$47 (bright
                                            ; white).
 $EDBA DEFB $00                             ; The number of the entry in the table of extra lives (or of
                                            ; guardians), which is set when the extra life is placed.
 $EDBB DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; Not used.
 $EDC3 DEFB $01                             ; The redraw flags, with bit 0 set so that the extra life is drawn
                                            ; without erasing anything.

; Extra Life Table
;
; The sixteen places of the extra lives, with three bytes for each: the
; room x, the room y and the collected flag. The flag is set to #N$01 by #R$E7AD
; when Sabreman picks up the extra life and is cleared at the start of a game by
; #R$ECBD. #R$EC3A looks for the room of Sabreman in this table.
@label=Extra_Life_Table
b$EDC4 DEFB $0A,$0B     ; The room x and room y of the first extra life.
@label=Extra_Life_Table_First_Flag
 $EDC6 DEFB $00         ; The collected flag of the first extra life.
 $EDC7 DEFB $0D,$0E,$00 ; {The other fifteen extra lives.
 $EDCA DEFB $02,$0F,$00 ;
 $EDCD DEFB $07,$11,$00 ;
 $EDD0 DEFB $02,$0B,$00 ;
 $EDD3 DEFB $02,$05,$00 ;
 $EDD6 DEFB $08,$05,$00 ;
 $EDD9 DEFB $0E,$03,$00 ;
 $EDDC DEFB $06,$16,$00 ;
 $EDDF DEFB $05,$1F,$00 ;
 $EDE2 DEFB $0C,$1A,$00 ;
 $EDE5 DEFB $02,$19,$00 ;
 $EDE8 DEFB $09,$12,$00 ;
 $EDEB DEFB $02,$15,$00 ;
 $EDEE DEFB $0D,$14,$00 ;
 $EDF1 DEFB $0B,$0B,$00 ; }

; Guardian Table
;
; The places of the four guardians, with three bytes for each: the room x,
; the room y and the destroyed flag (see #R$ECCA). The table follows the table
; of extra lives, so that the flags of both can be cleared together by #R$ECBD.
; .
; The entries make the guardians of the types #N$80, #N$86, #N$84 and #N$82 in
; that order (see #R$EBDE).
;
; .
;
; An imp, which no weapon can destroy.
@label=Guardian_Table
b$EDF4 DEFB $00,$20     ; The room x and room y of the first guardian.
@label=Guardian_Table_First_Flag
 $EDF6 DEFB $00         ; The destroyed flag of the first guardian.
; A bat.
 $EDF7 DEFB $01,$10,$00
; An imp.
 $EDFA DEFB $08,$11,$00
; A spider.
 $EDFD DEFB $0E,$14,$00

; Read Cursor Keys
;
; Used by the routine at #R$AE17.
; .
; Reads the cursor keys and puts the state of the controls in #REGb, to be
; completed by #R$AE2C (see #R$AE17). The keys are 5 (left), 6 (down), 7 (up), 8
; (right) and 0 (fire), and a bit is reset when its key is pressed.
;
; O:B The state of the controls
@label=Read_Cursor_Keys
c$EE00 LD A,$EF      ; {Read from the keyboard;
 $EE02 OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $EE04 IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$EF | 0 | 9 | 8 | 7 | 6 }
                     ; TABLE#}
 $EE06 LD C,A        ; Stash the state of the keys in #REGc.
 $EE07 AND %00001000 ; Keep only bit 3, which is the key 7 (up).
 $EE09 LD E,A        ; Store it in #REGe.
 $EE0A LD A,C        ; Fetch the state of the keys.
 $EE0B RRCA          ; {Rotate the keys right twice, which moves the key 0 into bit 6, the
 $EE0C RRCA          ; key 6 into bit 2 and the key 8 into bit 0.}
 $EE0D AND %01000101 ; Keep only those three bits.
 $EE0F OR E          ; Combine them with up.
 $EE10 LD E,A        ; Store the result in #REGe.
 $EE11 RRCA          ; {Rotate the result right twice, which moves fire from bit 6 into bit
 $EE12 RRCA          ; 4.}
 $EE13 AND %00010000 ; Keep only bit 4.
 $EE15 OR E          ; Combine it with the other directions.
 $EE16 AND %00011111 ; Keep only the five low bits, which are right, down, up and fire
                     ; (the bit for left is not set yet).
 $EE18 LD E,A        ; Store the result in #REGe.
 $EE19 LD A,$F7      ; {Read from the keyboard;
 $EE1B OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $EE1D IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$F7 | 1 | 2 | 3 | 4 | 5 }
                     ; TABLE#}
 $EE1F RRA           ; {Rotate the keys right three times, which moves the key
 $EE20 RRA           ; 5 into bit 1.
 $EE21 RRA           ; }
 $EE22 AND %00000010 ; Keep only that bit (left).
 $EE24 OR E          ; Combine it with the other controls.
 $EE25 LD B,A        ; Store the state of the controls in #REGb.
 $EE26 JP $AE2C      ; Jump to #R$AE2C to read the bottom row of the keyboard.

; Read Interface II Joystick
;
; Used by the routine at #R$AE17.
; .
; Reads the Interface II joystick, which acts as the keys 6 (left), 7
; (right), 8 (down), 9 (up) and 0 (fire), and puts the state of the controls in
; #REGb, to be completed by #R$AE2C (see #R$AE17). A bit is reset when its key
; is pressed.
;
; O:B The state of the controls
@label=Read_Interface_II_Joystick
c$EE29 LD A,$EF      ; {Read from the keyboard;
 $EE2B OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $EE2D IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$EF | 0 | 9 | 8 | 7 | 6 }
                     ; TABLE#}
 $EE2F RRA           ; Move the key 0 (fire) into the carry flag.
 $EE30 RL B          ; Shift it into #REGb.
 $EE32 RRA           ; Move the key 9 (up) into the carry flag.
 $EE33 RL B          ; Shift it into #REGb.
 $EE35 RRA           ; Move the key 8 (down) into the carry flag.
 $EE36 RL B          ; Shift it into #REGb.
 $EE38 RRA           ; {Move the key 6 (left) into the carry flag, skipping the
 $EE39 RRA           ; key 7.}
 $EE3A RL B          ; Shift it into #REGb.
 $EE3C RLA           ; Move the key 7 (right) into the carry flag.
 $EE3D RL B          ; Shift it into #REGb, which makes bit 0 right, bit 1 left, bit 2
                     ; down, bit 3 up and bit 4 fire.
 $EE3F JP $AE2C      ; Jump to #R$AE2C to read the bottom row of the keyboard.

; Move Object Horizontally
;
; Used by the routines at #R$B079 and #R$E2CB.
; .
; Adds a velocity to the x position of an object. The velocity is
; multiplied by sixteen and added to the x position and its fraction (byte #N$0A
; of the record), so that the position changes by a sixteenth of the velocity in
; each call. The new x position is returned, but it is not stored in the record:
; that is up to the caller.
;
;   HL The x velocity, with the sign extended to sixteen bits
;   IX Object record
; O:A The new x position
; O:F The zero flag is set if the new x position is less than #N$80
@label=Move_Object_Horizontally
c$EE42 ADD HL,HL     ; {Multiply the velocity by sixteen.
 $EE43 ADD HL,HL     ;
 $EE44 ADD HL,HL     ;
 $EE45 ADD HL,HL     ; }
 $EE46 LD C,(IX+$0A) ; Fetch the fraction of the x position.
 $EE49 LD B,(IX+$01) ; Fetch the x position.
 $EE4C ADD HL,BC     ; Add the velocity to the position.
 $EE4D LD (IX+$0A),L ; Store the new fraction.
 $EE50 LD A,H        ; Fetch the new x position.
 $EE51 BIT 7,A       ; Test bit 7 of the new x position.
 $EE53 RET           ; Return.

; Move Object Vertically
;
; Used by the routines at #R$B079 and #R$E2CB.
; .
; Adds a velocity to the y position of an object. It works like #R$EE42,
; but with the y position and its fraction (byte #N$0D of the record).
;
;   HL The y velocity, with the sign extended to sixteen bits
;   IX Object record
; O:A The new y position
; O:F The zero flag is set if the new y position is less than #N$80
@label=Move_Object_Vertically
c$EE54 ADD HL,HL     ; {Multiply the velocity by sixteen.
 $EE55 ADD HL,HL     ;
 $EE56 ADD HL,HL     ;
 $EE57 ADD HL,HL     ; }
 $EE58 LD C,(IX+$0D) ; Fetch the fraction of the y position.
 $EE5B LD B,(IX+$03) ; Fetch the y position.
 $EE5E ADD HL,BC     ; Add the velocity to the position.
 $EE5F LD (IX+$0D),L ; Store the new fraction.
 $EE62 LD A,H        ; Fetch the new y position.
 $EE63 BIT 7,A       ; Test bit 7 of the new y position.
 $EE65 RET           ; Return.

; Handle Gargoyle
;
; Handler for the object types #N$34 to #N$37, the gargoyle (see #R$D2EB).
; It is a flying creature that is handled like the jellyfish (see #R$B3D8), and
; it shares the routines that animate and move it.
; .
; When the gargoyle is in a different room x from Sabreman, its y velocity is
; set to a random #N$20 or #N$E0 (see #R$EE9A) and #R$B2CF moves it towards his
; room. When it is in the same room x but a different room y, its x velocity is
; set to a random #N$20 or #N$E0 and #R$B358 moves it towards his room. When it
; is in the same room as Sabreman it is animated and moves in the same way as
; the jellyfish (see #R$B40B).
;
; IX Object record
@label=Handle_Gargoyle
c$EE66 CALL $98CC    ; Read the world map entry of the room that the gargoyle is in. The
                     ; flags of the room are returned in #REGe.
 $EE69 LD A,(IX+$0B) ; Fetch the contact flags of the gargoyle.
 $EE6C OR E          ; Combine them with the flags of the room.
 $EE6D LD E,A        ; Store the result in #REGe.
 $EE6E LD A,($8F1C)  ; Fetch the room x of Sabreman.
 $EE71 CP (IX+$02)   ; {Jump to #R$EE84 if the gargoyle is in a different room
 $EE74 JR NZ,$EE84   ; x.}
 $EE76 LD A,($8F1E)  ; Fetch the room y of Sabreman.
 $EE79 CP (IX+$04)   ; {Jump to #R$EE8F if the gargoyle is in a different room
 $EE7C JR NZ,$EE8F   ; y.}
 $EE7E CALL $B41F    ; Animate the gargoyle.
 $EE81 JP $B40B      ; Jump to #R$B40B to set the x velocity and to move the
                     ; gargoyle.
@label=Handle_Gargoyle_Different_Room_X
*$EE84 PUSH AF       ; Stash the result of the comparison, as the carry flag says which way
                     ; Sabreman's room is.
 $EE85 CALL $EE9A    ; Choose a velocity.
 $EE88 LD (IX+$09),A ; Set the y velocity.
 $EE8B POP AF        ; Restore the result of the comparison.
 $EE8C JP $B2CF      ; Jump to #R$B2CF to move the gargoyle towards the room x
                     ; of Sabreman.
@label=Handle_Gargoyle_Different_Room_Y
*$EE8F PUSH AF       ; Stash the result of the comparison, as the carry flag says which way
                     ; Sabreman's room is.
 $EE90 CALL $EE9A    ; Choose a velocity.
 $EE93 LD (IX+$08),A ; Set the x velocity.
 $EE96 POP AF        ; Restore the result of the comparison.
 $EE97 JP $B358      ; Jump to #R$B358 to move the gargoyle towards the room y
                     ; of Sabreman.

; Choose Random Velocity
;
; Used by the routine at #R$EE66.
; .
; Returns either #N$20 or #N$E0 (that is, #N$20 or minus #N$20), which
; depends on bit 6 of the low byte of FRAMES.
;
; O:A #N$20 if bit 6 of FRAMES is set, otherwise #N$E0
@label=Choose_Random_Velocity
c$EE9A LD A,($5C78)  ; Fetch the low byte of FRAMES.
 $EE9D AND %01000000 ; Keep only bit 6.
 $EE9F OR %00100000  ; Set bit 5.
 $EEA1 SUB $40       ; Subtract #N$40, which gives #N$20 if bit 6 was set and #N$E0 if it
                     ; was not.
 $EEA3 RET           ; Return.

; Font
;
; The glyphs for the characters #N$30 to #N$5A. #R$98DF finds the
; glyph for a character at #N$ED24 plus eight times the character code, so
; the glyphs for the codes below #N$30 would fall inside the code above.
@label=Font
b$EEA4 DEFB $38,$6C,$D6,$D6,$D6,$D6,$6C,$38 ; #UDG(#PC)
 $EEAC DEFB $18,$38,$58,$18,$18,$18,$18,$7C ; #UDG(#PC)
 $EEB4 DEFB $38,$4C,$0C,$3C,$60,$C2,$C2,$FE ; #UDG(#PC)
 $EEBC DEFB $38,$4C,$0C,$3C,$0E,$86,$86,$FC ; #UDG(#PC)
 $EEC4 DEFB $18,$38,$58,$9A,$FE,$1A,$18,$7C ; #UDG(#PC)
 $EECC DEFB $FE,$C2,$C0,$FC,$06,$06,$86,$7C ; #UDG(#PC)
 $EED4 DEFB $1E,$32,$60,$EC,$C6,$C6,$C6,$7C ; #UDG(#PC)
 $EEDC DEFB $7E,$46,$4C,$0C,$18,$18,$38,$F8 ; #UDG(#PC)
 $EEE4 DEFB $38,$6C,$6C,$7C,$FE,$C6,$C6,$7C ; #UDG(#PC)
 $EEEC DEFB $7C,$C6,$C6,$C6,$7C,$0C,$98,$F0 ; #UDG(#PC)
 $EEF4 DEFB $00,$00,$00,$00,$00,$00,$18,$18 ; #UDG(#PC)
 $EEFC DEFB $00,$C3,$C6,$0C,$18,$30,$63,$C3 ; #UDG(#PC)
 $EF04 DEFB $3C,$42,$99,$A1,$A1,$99,$42,$3C ; #UDG(#PC)
 $EF0C DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; #UDG(#PC)
