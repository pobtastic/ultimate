                                                                            ; object.
 $8FC1 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00                             ; Bytes
                                                                            ; #N$07 to
                                                                            ; #N$0F.
 $8FCA DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00 ; Record 13:
