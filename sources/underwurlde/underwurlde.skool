                                                                            ; bubble.
 $8F60 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00                             ; Bytes
                                                                            ; #N$06 to
                                                                            ; #N$0E.
@label=First_Bubble_Redraw_Flags
 $8F69 DEFB $00                                                             ; The redraw
                                                                            ; flags of
                                                                            ; the first
                                                                            ; bubble.
 $8F6A DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00 ; Record 7:
                                                                            ; the second
                                                                            ; bubble.
@label=Object_Record_8
 $8F7A DEFB $00                                                             ; Record 8:
                                                                            ; the third
                                                                            ; bubble, or
                                                                            ; the first
                                                                            ; decoration.
@label=Object_Record_8_X_Position
 $8F7B DEFB $00                                                             ; The x
                                                                            ; position
                                                                            ; of record
                                                                            ; #N$08.
 $8F7C DEFB $00                                                             ; The room x
                                                                            ; of record
                                                                            ; #N$08.
@label=Object_Record_8_Y_Position
 $8F7D DEFB $00                                                             ; The y
