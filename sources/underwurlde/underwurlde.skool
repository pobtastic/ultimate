; #LIST
; { #SABREWULF$BA8C }
; LIST#

; Colour Entity
;
; Used by the routines at #R$95A3, #R$96CB, #R$A021, #R$AF3F, #R$E751 and
; #R$E8D7.
; .
; Sets the attributes of the character cells that the sprite of the object
; covers to the attribute of the object. The width in cells and the height in
; pixels come from #R$8EE6 and #R$8EE7, which are set when the sprite is
; prepared. It works upwards from the bottom row of cells.
; .
; The number of rows of cells is worked out from the number of pixel lines of
; the sprite and the position of the bottom of the sprite within its character
; cell.
;
; IX Object record
@label=ColourEntity
c$9867 LD L,(IX+$01) ; Fetch the x position of the object into #REGl.
 $986A LD H,(IX+$03) ; Fetch the y position of the object into #REGh.
 $986D LD D,(IX+$05) ; Fetch the attribute of the object into #REGd.
 $9870 LD A,H        ; {Copy the y position to #REGa and flip the bits.
 $9871 CPL           ; }
 $9872 AND %00000111 ; Keep only the pixel line within the character cell.
 $9874 LD B,A        ; Store it in #REGb.
 $9875 LD A,($8EE7)  ; Fetch the height of the sprite from #R$8EE7.
 $9878 ADD A,$08     ; Add #N$08.
 $987A ADD A,B       ; Add the pixel line.
 $987B RRCA          ; {Divide by eight.
 $987C RRCA          ;
 $987D RRCA          ; }
 $987E AND %00011111 ; Keep only the low five bits.
 $9880 LD C,A        ; Store the number of rows of cells in #REGc.
 $9881 LD A,($8EE6)  ; Fetch the width of the sprite in cells from #R$8EE6.
 $9884 LD B,A        ; Store it in #REGb.
 $9885 CALL $ADE0    ; Convert the position into the address in the attribute
                     ; buffer.
; View the equivalent code in;
; #LIST
; { #SABREWULF$BB24 }
; LIST#
; .
; Continue on to #R$9888.

; Colour Rows
;
; Sets the attributes of #REGc rows of #REGb character cells, working
; upwards from the attribute address in #REGhl. A row that is above the start of
; the attribute buffer is skipped.
;
; B Number of cells in each row
; C Number of rows
; D Attribute to write
; HL Address in the attribute buffer of the bottom left cell
@label=ColourRows
c$9888 PUSH BC       ; Stash the counters on the stack.
 $9889 PUSH HL       ; Stash the address on the stack.
 $988A LD A,H        ; {Fetch the high byte of the address and compare it with #N$58 (the
 $988B CP $58        ; start of the attribute buffer).}
 $988D JR C,$9893    ; Jump to #R$9893 if the row is above the attribute
                     ; buffer.
@label=ColourRows_Loop
*$988F LD (HL),D     ; Write the attribute to the cell.
 $9890 INC L         ; Move on to the next cell.
 $9891 DJNZ $988F    ; Decrease the cell counter and loop back until the row is
                     ; done.
@label=ColourRows_Next
*$9893 POP HL        ; Restore the address from the stack.
 $9894 LD BC,$0020   ; Set the size of a row of cells to #N$0020.
 $9897 AND A         ; {Move up to the row above.
 $9898 SBC HL,BC     ; }
 $989A POP BC        ; Restore the counters from the stack.
 $989B DEC C         ; {Decrease the row counter and loop back until all of the rows are
 $989C JR NZ,$9888   ; done.}
 $989E RET           ; Return.
; View the equivalent code in;
; #LIST
; { #SABREWULF$BB45 }
; LIST#

; Store Entity
;
; Used by the routines at #R$A316, #R$A433, #R$A5F1, #R$A6A6, #R$A925, #R$AEB9,
; #R$B079, #R$B41F, #R$B57A, #R$DEE8, #R$DF15, #R$DF98, #R$E027, #R$E117,
; #R$E18C, #R$E2CB, #R$E570, #R$E751, #R$E7E3, #R$E8D7, #R$EA7D, #R$EA9C and
; #R$ECCA.
; .
; Stores the position and the sprite id of the object that #REGix points
; at, so that the sprite can be found and erased later.
;
; IX Object record
@label=StoreEntity
c$989F LD A,(IX+$01) ; Fetch the x position of the object.
 $98A2 LD ($8EE4),A  ; Store it in #R$8EE4.
 $98A5 LD A,(IX+$03) ; Fetch the y position of the object.
 $98A8 LD ($8EE5),A  ; Store it in #R$8EE5.
 $98AB LD A,(IX+$00) ; Fetch the type of the object (its sprite id).
 $98AE LD ($8EE1),A  ; Store it in #R$8EE1.
 $98B1 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9FFB }
; { #COOKIE$76D0 }
; { #JETPAC$7327 }
; { #PSSST$75B9 }
; { #SABREWULF$BB0B }
; { #TRANZAM$71ED }
; LIST#

; Find World Map Address
;
; Used by the routines at #R$98CC, #R$A6A6, #R$AAF4 and #R$AB30.
; .
; Works out the address in the #R$7000 world map of the entry for the room
; that the object at #REGix is in. The address is #N$7000 plus #N$20 times the
; room y plus twice the room x.
; .
; The multiplication of the room y by #N$20 is done as a multiplication of the
; low three bits of the room y by #N$20, plus #N$0100 times the rest of the room
; y.
;
;   IX Object record
; O:HL Address of the world map entry
@label=Find_World_Map_Address
c$98B2 PUSH BC       ; Stash #REGbc on the stack.
 $98B3 LD H,(IX+$04) ; Fetch the room y of the object into #REGh.
 $98B6 XOR A         ; Start the offset at zero.
 $98B7 SRL H         ; {Move bit 0 of the room y into #REGa.
 $98B9 RRA           ; }
 $98BA SRL H         ; {Move bit 1 of the room y into #REGa.
 $98BC RRA           ; }
 $98BD SRL H         ; {Move bit 2 of the room y into #REGa. (#REGa is now #N$20 times the
 $98BF RRA           ; low three bits.)}
 $98C0 LD L,(IX+$02) ; Fetch the room x of the object into #REGl.
 $98C3 ADD A,L       ; Add the room x to #REGa.
 $98C4 ADD A,L       ; Add the room x to #REGa again, to make twice the room x.
 $98C5 LD L,A        ; Store the low byte of the offset in #REGl.
 $98C6 LD BC,$7000   ; Point at the world map (#R$7000).
 $98C9 ADD HL,BC     ; Add the address of the world map to the offset.
 $98CA POP BC        ; Restore #REGbc from the stack.
 $98CB RET           ; Return.

; Read World Map
;
; Used by the routines at #R$9906, #R$A316, #R$A433, #R$A5F1, #R$A6A6, #R$A925,
; #R$AAF4, #R$AE81, #R$AF56, #R$B079, #R$B3D8, #R$B58C, #R$DF98, #R$E0E8,
; #R$E117, #R$E2CB, #R$E570, #R$E8D7, #R$E9DF, #R$EBC0 and #R$EE66.
; .
; Reads the world map entry of the room that the object at #REGix is in.
; The first byte of an entry is made up of eight flags that say which parts of
; the frame of the room are present (see #R$9906).
;
;   IX Object record
; O:E First byte of the entry (the frame flags of the room)
; O:D Second byte of the entry
@label=Read_World_Map
c$98CC PUSH HL       ; Stash #REGhl on the stack.
 $98CD CALL $98B2    ; Find the address of the entry.
 $98D0 LD E,(HL)     ; Fetch the first byte of the entry.
 $98D1 INC HL        ; Move on to the second byte.
 $98D2 LD D,(HL)     ; Fetch the second byte of the entry.
 $98D3 POP HL        ; Restore #REGhl from the stack.
 $98D4 RET           ; Return.

; Move Down Row
;
; Moves a screen address down by one character row.
;
;   HL Screen address
; O:HL Screen address of the character cell below
@label=MoveDownRow
c$98D5 LD A,L        ; Fetch the low byte of the address.
 $98D6 ADD A,$20     ; Add #N$20 to move down one row of the character cells.
 $98D8 LD L,A        ; Store the low byte of the address.
 $98D9 RET NC        ; Return if the move did not cross into the next third of
                     ; the screen.
 $98DA LD A,H        ; Fetch the high byte of the address.
 $98DB ADD A,$08     ; Add #N$08 to move on to the next third of the screen.
 $98DD LD H,A        ; Store the high byte of the address.
 $98DE RET           ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$D64F }
; { #MARTIANOIDS$B6B2 }
; { #NIGHTSHADE$CB71 }
; LIST#

; Print Character
;
; Used by the routines at #R$9C3C and #R$9E16.
; .
; Draws a character at a screen address and moves on to the next cell to
; the right. The attribute is not changed.
; .
; The shape of the character comes from the font at #R$EEA4, which has
; eight bytes for each code. The address is worked out as #N$ED24 plus eight
; times the code, so the glyph for code #N$30 (the digit 0) is the first one of
; the font. A space (#N$20) is replaced by code #N$3D, which is the blank
; character of the font.
; .
; #PUSHS #UDGTABLE(default,centre)
; { =h Before | =h After #R$98DF }
; { #SIM(start=$9052,stop=$9078,clear=1,sp=$5B40)
; #SIM(start=$91C0,stop=$91E5,sp=$5B40)
; #SCR$02,$00,$00,$20,$02(character-before)
; | #SIM(start=$98DF,stop=$0000,a=$53,hl=$4010,sp=$5B40)
; #SCR$02,$00,$00,$20,$02(character-after) } UDGTABLE# #POPS
;
;   A Character code
;   HL Screen address
; O:HL Screen address of the cell to the right
@label=PrintScreen
c$98DF PUSH AF       ; Stash #REGaf on the stack.
 $98E0 PUSH BC       ; Stash #REGbc on the stack.
 $98E1 PUSH DE       ; Stash #REGde on the stack.
 $98E2 PUSH HL       ; Stash #REGhl on the stack.
 $98E3 CP $20        ; {Jump to #R$98E9 if it is not a space.
 $98E5 JR NZ,$98E9   ; }
 $98E7 LD A,$3D      ; Use the code of the blank character (#N$3D) instead.
@label=PrintScreen_Not_Space
*$98E9 LD L,A        ; Copy the character code to #REGl.
 $98EA LD H,$00      ; Clear the high byte of the character code.
 $98EC ADD HL,HL     ; {Multiply the character code by eight.
 $98ED ADD HL,HL     ;
 $98EE ADD HL,HL     ; }
 $98EF LD DE,$ED24   ; Point at the character set (less #N$0180, as the character codes
                     ; start at #N$20).
 $98F2 ADD HL,DE     ; Add the address of the character set.
 $98F3 EX DE,HL      ; Exchange the registers so that #REGde points at the shape of the
                     ; character.
 $98F4 POP HL        ; Restore the screen address into #REGhl.
@label=PrintScreen_Write
 $98F5 LD B,$08      ; Set the number of pixel lines in a character to #N$08.
@label=PrintScreen_Loop
*$98F7 LD A,(DE)     ; Fetch a line of the character.
 $98F8 LD (HL),A     ; Write it to the screen.
 $98F9 INC DE        ; Move on to the next line of the character.
 $98FA INC H         ; Move down one pixel line.
 $98FB DJNZ $98F7    ; Decrease the line counter and loop back until all eight lines are
                     ; done.
 $98FD POP DE        ; Restore #REGde from the stack.
 $98FE POP BC        ; Restore #REGbc from the stack.
 $98FF LD A,H        ; Fetch the high byte of the screen address.
 $9900 SUB $08       ; Subtract #N$08 to move back to the top of the cell.
 $9902 LD H,A        ; Store the high byte of the address.
 $9903 INC L         ; Move on to the next cell to the right.
 $9904 POP AF        ; Restore #REGaf from the stack.
 $9905 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$A1D3 }
; { #COOKIE$7468 }
; { #JETPAC$714C }
; { #LUNARJETMAN$89EF }
; { #MARTIANOIDS$B5CB }
; { #NIGHTSHADE$CB19 }
; { #PSSST$73CD }
; { #SABREWULF$B589 }
; { #TRANZAM$6C96 }
; LIST#

; Draw Room
;
; Used by the routines at #R$91C0, #R$A433, #R$A678, #R$A6A6, #R$A8EF, #R$A925,
; #R$AAF4, #R$AB30, #R$E1B4, #R$E4CA and #R$E7E3.
; .
; Draws the room that Sabreman is in and then carries on with the main
; loop. It does not return to its caller: it resets the stack.
; .
; First the play area is cleared. Then, for the rooms in the lower part of the
; map (the room y is #N$10 or more), the eight parts of the frame of the room
; are drawn, in the order of the bits of the first byte of the world map entry
; (see #R$99F5), the objects of the room are set up and the room is marked as
; visited.
; .
; The rooms with a room y below #N$10 are special rooms, which are drawn by
; #R$9DA0, and which get their decorations from #R$EAA2. A room y of #N$FF is
; the way out of the Underwurlde and shows the ending (see #R$9EA0).
; .
; #PUSHS #UDGTABLE(default,centre)
; { =h Before | =h After #R$9906 }
; { #SIM(start=$9052,stop=$9078,clear=1,sp=$5B40)
; #SIM(start=$91C0,stop=$91E5,sp=$5B40)
; #SCR$01(draw-room-before)
; | #POKES$8F1C,$09;$8F1E,$12
; #SIM(start=$9906,stop=$91E5,ix=$8F1A,sp=$5B40)
; #SCR$01(draw-room-after) } UDGTABLE# #POPS
@label=Draw_Room
c$9906 DI            ; Disable interrupts.
 $9907 CALL $99AB    ; Clear the play area.
 $990A LD HL,$0000   ; {Clear the word at #R$AA97.
 $990D LD ($AA97),HL ; }
 $9910 CALL $98CC    ; Read the world map entry of the room into #REGde.
 $9913 LD A,(IX+$04) ; Fetch the room y of Sabreman.
 $9916 CP $FF        ; {Show the ending screen if the room y is #N$FF.
 $9918 JP Z,$9EA0    ; }
 $991B CP $10        ; {Jump to #R$997D if the room y is below #N$10.
 $991D JP C,$997D    ; }
; Draw the eight parts of the frame of the room. Each of the routines
; draws its part if the matching bit of #REGe is set and clears the area if it
; is not.
 $9920 CALL $99F5    ; Draw the ceiling (bit 0).
 $9923 CALL $9A53    ; Draw the top right corner (bit 1).
 $9926 CALL $9AB6    ; Draw the right wall (bit 2).
 $9929 CALL $9AF8    ; Draw the bottom right corner (bit 3).
 $992C CALL $9B38    ; Draw the floor (bit 4).
 $992F CALL $9B64    ; Draw the bottom left corner (bit 5).
 $9932 CALL $9BA4    ; Draw the left wall (bit 6).
 $9935 CALL $9BB8    ; Draw the top left corner (bit 7).
 $9938 CALL $AF56    ; Set up the objects of the room (see #R$AF56).
; Mark the room as visited and set up the rest of the room.
@label=Finish_Room
*$993B CALL $E6A5    ; Find the entry of the room in the room visit table.
 $993E LD A,(HL)     ; Fetch the first byte of the entry.
 $993F AND A         ; {Jump to #R$9944 if the room has been visited before.
 $9940 JR NZ,$9944   ; }
 $9942 LD (HL),$01   ; Mark the room as visited.
@label=Draw_Room_Print_Depth
*$9944 CALL $9E66    ; Print the depth of the room.
 $9947 CALL $998F    ; Flag all of the object records for redrawing.
 $994A CALL $999D    ; Flag the small object records for redrawing.
 $994D CALL $EC3A    ; Place the collectable of the room, if it has one and it has not been
                     ; collected.
 $9950 XOR A         ; {Write #N$00 to #R$AAAC.
 $9951 LD ($AAAC),A  ; }
 $9954 LD A,($8F29)  ; Fetch the redraw flags of Sabreman.
 $9957 OR %00000001  ; Set bit 0 so that he is drawn without erasing.
 $9959 LD ($8F29),A  ; Store the redraw flags of Sabreman.
 $995C LD ($8F39),A  ; Store them in the redraw flags of the rope record too.
 $995F LD ($8EF0),A  ; Store them in the room redrawn flag at #R$8EF0.
 $9962 LD A,($8F1A)  ; Fetch the type of Sabreman.
 $9965 CP $09        ; {Jump to #R$996C if the type is below #N$09.
 $9967 JR C,$996C    ; }
 $9969 CALL $AE81    ; Set up the rope of the room.
@label=Draw_Room_Reset_Stack
*$996C LD SP,$6000   ; Reset the stack pointer to #N$6000 as this routine does
                     ; not return.
 $996F LD IX,$8F2A   ; Point at the object record of the rope (#R$8F2A).
 $9973 LD HL,($5C78) ; Fetch the frame counter.
 $9976 DEC HL        ; Subtract one.
 $9977 LD ($8EDF),HL ; Store it in #R$8EDF so that the priority records are
                     ; handled.
 $997A JP $9207      ; Jump to #R$9207 to handle the rope record.
; The room is a special room.
@label=Draw_Room_Draw_Special_Room
*$997D CALL $9DA0    ; Draw the special room.
 $9980 LD HL,$8F9A   ; Point at the twelfth object record (#R$8F9A).
 $9983 LD B,$40      ; Set the size of four records to #N$40.
@label=Draw_Room_Clear_Records_Loop
*$9985 LD (HL),$00   ; Write #N$00 to the byte.
 $9987 INC HL        ; Move on to the next byte.
 $9988 DJNZ $9985    ; Decrease the counter and loop back until the four
                     ; records are empty.
 $998A CALL $EAA2    ; Load the decorations of the room.
 $998D JR $993B      ; Jump to #R$993B.

; Flag Objects For Redraw
;
; Used by the routine at #R$9906.
; .
; Writes #N$01 to byte #N$0F of each of the nineteen object records, so
; that each of the sprites is drawn without being erased first (see #R$96CB).
@label=Flag_Objects_For_Redraw
c$998F LD HL,$8F09   ; Point at byte #N$0F of the first record (#R$8F09).
 $9992 LD DE,$0010   ; Set the size of a record to #N$0010.
 $9995 LD BC,$1301   ; Set the number of records to #N$13 and the value to flag them with
                     ; to #N$01.
@label=Flag_Objects_For_Redraw_Loop
*$9998 LD (HL),C     ; Set byte #N$0F of the record.
 $9999 ADD HL,DE     ; Move on to the next record.
 $999A DJNZ $9998    ; Decrease the counter and loop back until all of the records are
                     ; flagged.
 $999C RET           ; Return.

; Flag Small Objects For Redraw
;
; Used by the routine at #R$9906.
; .
; Sets bit 0 of byte #N$07 of the first four small object records, so that
; their sprites are drawn without being erased first.
@label=Flag_Small_Objects_For_Redraw
c$999D LD HL,$9031   ; Point at byte #N$07 of the first small record (#R$9031).
 $99A0 LD DE,$0008   ; Set the size of a small record to #N$0008.
 $99A3 LD B,$04      ; Set the number of records to #N$04.
@label=Flag_Small_Objects_For_Redraw_Loop
*$99A5 SET 0,(HL)    ; Set bit 0 of byte #N$07.
 $99A7 ADD HL,DE     ; Move on to the next record.
 $99A8 DJNZ $99A5    ; Decrease the counter and loop back until all of the records are
                     ; flagged.
 $99AA RET           ; Return.

; Clear Play Area
;
; Used by the routine at #R$9906.
; .
; Clears the pixels of the #N$B0 lines of the play area and then sets the
; attributes of its #N$16 rows to white. The entry at #R$99C2 only sets
; the attributes.
; .
; #PUSHS #UDGTABLE(default,centre)
; { =h Before | =h After #R$99AB }
; { #SIM(start=$9052,stop=$9078,clear=1,sp=$5B40)
; #SIM(start=$91C0,stop=$91E5,sp=$5B40)
; #SCR$01(clear-play-area-before)
; | #SIM(start=$99AB,stop=$0000,sp=$5B40)
; #SCR$01(clear-play-area-after) } UDGTABLE# #POPS
@label=Clear_Play_Area
c$99AB LD HL,$BF00   ; Set the x position to #N$00 and the y position to #N$BF
                     ; (#N$BF00).
 $99AE CALL $ADF8    ; Convert the position into a screen address.
 $99B1 LD C,$B0      ; Set the number of lines to clear to #N$B0.
@label=Clear_Play_Area_Line_Loop
*$99B3 PUSH HL       ; Stash the screen address on the stack.
 $99B4 LD B,$20      ; Set the number of bytes in a line to #N$20.
@label=Clear_Play_Area_Byte_Loop
*$99B6 LD (HL),$00   ; Clear a byte of the line.
 $99B8 INC L         ; Move on to the next byte.
 $99B9 DJNZ $99B6    ; Decrease the byte counter and loop back until the line
                     ; is clear.
 $99BB POP HL        ; Restore the screen address from the stack.
 $99BC CALL $AE71    ; Move up one pixel line.
 $99BF DEC C         ; {Decrease the line counter and loop back until all of the lines are
 $99C0 JR NZ,$99B3   ; clear.}
; This entry point is used by the routine at #R$957D.
@label=Clear_Play_Area_Attributes
*$99C2 LD HL,$5840   ; Point at the second row of the attribute buffer
                     ; (#N$5840).
 $99C5 LD C,$16      ; Set the number of rows to #N$16.
@label=Clear_Play_Area_Row_Loop
*$99C7 LD B,$20      ; Set the number of cells in a row to #N$20.
@label=Clear_Play_Area_Cell_Loop
*$99C9 LD (HL),$47   ; Set the attribute of the cell to white ink on black
                     ; paper (bright).
 $99CB INC HL        ; Move on to the next cell.
 $99CC DJNZ $99C9    ; Decrease the cell counter and loop back until the row is
                     ; done.
 $99CE DEC C         ; {Decrease the row counter and loop back until all of the rows are
 $99CF JR NZ,$99C7   ; done.}
 $99D1 RET           ; Return.

; Clear Panel
;
; Used by the routines at #R$9A53, #R$9AF8, #R$9B64 and #R$9BB8.
; .
; Clears a rectangle of the screen to the right of the position in #REGhl.
; There are three entry points, which select the size of the rectangle. They
; stand in for the parts of the frame of the room (see #R$9906) that are not
; present.
; .
; Each of those routines stashed #REGde on the stack, so this routine ends by
; restoring it. The caller is returned to by the last instruction.
; .
; #PUSHS #UDGTABLE(default,centre)
; { =h Before | =h After #R$99D2 }
; { #SIM(start=$9052,stop=$9078,clear=1,sp=$5B40)
; #SIM(start=$91C0,stop=$91E5,sp=$5B40)
; #SCR$01,$00,$02,$20,$14(clear-panel-before)
; | #SIM(start=$99D7,stop=$0000,hl=$3090,sp=$5B40)
; #SCR$01,$00,$02,$20,$14(clear-panel-after) } UDGTABLE# #POPS
;
; HL Position (#REGl is the x position, #REGh is the y position)
@label=Clear_Panel
c$99D2 LD BC,$0304   ; Set the size of the area to #N$03 bytes wide and #N$04 lines high
                     ; (#N$0304).
 $99D5 JR $99DF      ; Jump to #R$99DF.
; This entry point is used by the routine at #R$9AB6.
@label=Clear_Tall_Panel
*$99D7 LD BC,$0370   ; Set the size of the area to #N$03 bytes wide and #N$70 lines high
                     ; (#N$0370).
 $99DA JR $99DF      ; Jump to #R$99DF.
; This entry point is used by the routine at #R$99F5.
@label=Clear_Wide_Panel
*$99DC LD BC,$1A20   ; Set the size of the area to #N$1A bytes wide and #N$20 lines high
                     ; (#N$1A20).
@label=Clear_Panel_Rectangle
*$99DF CALL $ADF8    ; Convert the position into a screen address.
 $99E2 LD E,$00      ; Set the byte to write to #N$00.
 $99E4 LD D,B        ; Keep the width of the rectangle for the next line.
@label=Clear_Panel_Loop
*$99E5 LD (HL),E     ; Clear a byte of the line.
 $99E6 INC L         ; Move on to the next byte.
 $99E7 DJNZ $99E5    ; Decrease the width counter and loop back until the line
                     ; is clear.
 $99E9 LD B,D        ; Fetch the width of the rectangle again.
 $99EA LD A,L        ; Fetch the low byte of the screen address.
 $99EB SUB B         ; Subtract the width to move back to the start of the
                     ; line.
 $99EC LD L,A        ; Store the low byte of the address.
 $99ED CALL $9C2B    ; Move down one pixel line.
 $99F0 DEC C         ; {Decrease the line counter and loop back until all of the lines are
 $99F1 JR NZ,$99E5   ; clear.}
 $99F3 POP DE        ; Restore #REGde from the stack.
 $99F4 RET           ; Return.

; Draw Ceiling
;
; Used by the routine at #R$9906.
; .
; Draws the ceiling of the room if bit 0 of the frame flags is set, or
; clears its area if it is not.
; .
; The ceiling is made of thirteen tiles of two bytes by #N$20 lines, which are
; drawn from left to right starting at x position #N$18 and y position #N$10.
; Each tile is chosen from the table at #R$9A33. The first tile that is used
; depends on the sum of the room x and the room y, which makes the ceiling look
; different from room to room, and the next tiles come from the following
; entries of the table.
; .
; Finally the attributes of the area are set (see #R$9C10). The floor, drawn by
; #R$9B38, uses this code too.
;
; DE Frame flags of the room in #REGe
; IX Object record of Sabreman
@label=Draw_Ceiling
c$99F5 PUSH DE        ; Stash the frame flags on the stack.
 $99F6 BIT 0,E        ; Test bit 0 of the frame flags (the ceiling).
 $99F8 LD HL,$1018    ; Set the x position to #N$18 and the y position to #N$10
                      ; (#N$1018).
 $99FB LD DE,$9A33    ; Point at the table of ceiling tiles (#R$9A33).
; This entry point is used by the routine at #R$9B38.
@label=Draw_Ceiling_Check_Present
*$99FE JP Z,$99DC     ; Jump to #R$99DC if there is no ceiling.
; Draw the row of tiles. The same code draws the floor, which jumps to
; #R$99FE.
@label=Draw_Row_Of_Tiles
 $9A01 LD B,$0D       ; Set the number of tiles to #N$0D.
 $9A03 PUSH HL        ; Stash the screen position on the stack.
 $9A04 CALL $ADF8     ; Convert the position into a screen address.
 $9A07 LD A,(IX+$02)  ; Fetch the room x of Sabreman.
 $9A0A ADD A,(IX+$04) ; Add the room y of Sabreman.
 $9A0D RLCA           ; Double the sum to make an offset into the table of word
                      ; pointers.
@label=Draw_Ceiling_Tile_Loop
*$9A0E AND %00011110  ; Keep the offset within the table (sixteen entries).
 $9A10 LD C,A         ; Store the offset in #REGc.
 $9A11 PUSH BC        ; Stash the tile counter and the offset on the stack.
 $9A12 EX DE,HL       ; Exchange the registers so that #REGhl holds the address of the
                      ; table.
 $9A13 PUSH HL        ; Stash the address of the table on the stack.
 $9A14 LD B,$00       ; Clear the high byte of the offset.
 $9A16 ADD HL,BC      ; Add the offset to the address of the table.
 $9A17 LD A,(HL)      ; Fetch the low byte of the address of the tile.
 $9A18 INC HL         ; Move on to the high byte.
 $9A19 LD H,(HL)      ; Fetch the high byte of the address of the tile.
 $9A1A LD L,A         ; Copy the low byte to #REGl.
 $9A1B EX DE,HL       ; Exchange the registers so that #REGde holds the address of the tile
                      ; and #REGhl the screen address.
 $9A1C PUSH HL        ; Stash the screen address on the stack.
 $9A1D CALL $9BF8     ; Draw the tile.
 $9A20 POP HL         ; Restore the screen address from the stack.
 $9A21 INC L          ; {Move on two cells to the right.
 $9A22 INC L          ; }
 $9A23 POP DE         ; Restore the address of the table into #REGde.
 $9A24 POP BC         ; Restore the tile counter and the offset.
 $9A25 LD A,C         ; Copy the offset to #REGa.
 $9A26 ADD A,$02      ; Move on to the next entry of the table.
 $9A28 DJNZ $9A0E     ; Decrease the tile counter and loop back until all of the tiles are
                      ; drawn.
 $9A2A POP HL         ; Restore the position of the area.
 $9A2B LD BC,$1A20    ; Set the size of the area to #N$1A20.
 $9A2E CALL $9C10     ; Set the attributes of the area.
 $9A31 POP DE         ; Restore the frame flags from the stack.
 $9A32 RET            ; Return.

; Ceiling Tile Table
;
; The addresses of the tiles of the ceiling, indexed by twice the sum of
; the room x and the room y. The eight tiles in the first half are repeated in
; the second half. Each tile is two bytes wide and #N$20 lines high, and is
; preceded by its height and width (see #R$9BF8).
@label=Ceiling_Tile_Table
w$9A33 DEFW $BAEB,$BB2D,$BB6F,$BBB1,$BBF3,$BC35,$BC77,$BCB9
 $9A43 DEFW $BAEB,$BB2D,$BB6F,$BBB1,$BBF3,$BC35,$BC77,$BCB9

; Draw Top Right Corner
;
; Used by the routine at #R$9906.
; .
; Draws the top right corner of the frame of the room if bit 1 of the
; frame flags is set, or clears its area if it is not.
; .
; The corner is three bytes wide and #N$20 lines high and is drawn at x position
; #N$E8, y position #N$10. The shape depends on whether the ceiling (bit 0) and
; the right wall (bit 2) are present, and on the room x and y: the table at
; #R$9A96 has a set of four shapes for each of four combinations of the room
; coordinates. The routine also draws the other corners, which jump to
; #R$9A70.
;
; DE Frame flags of the room in #REGe
; IX Object record of Sabreman
@label=Draw_Top_Right_Corner
c$9A53 PUSH DE        ; Stash the frame flags on the stack.
 $9A54 LD HL,$10E8    ; Set the x position to #N$E8 and the y position to #N$10
                      ; (#N$10E8).
 $9A57 LD A,E         ; Copy the frame flags to #REGa.
 $9A58 LD DE,$9A96    ; Point at the table of corner shapes (#R$9A96).
 $9A5B BIT 1,A        ; {Jump to #R$9A62 to clear the area if the corner is not
 $9A5D JP Z,$99D2     ; present.}
 $9A5F SBC A,C        ;
@label=Draw_Corner
 $9A60 PUSH HL        ; Stash the position on the stack.
 $9A61 EX DE,HL       ; Exchange the registers so that #REGhl holds the address of the
                      ; table.
 $9A62 BIT 0,A        ; {Jump to #R$9A68 if the ceiling is not present.
 $9A64 JR Z,$9A68     ; }
 $9A66 INC HL         ; {Skip the shapes for a ceiling.
 $9A67 INC HL         ; }
@label=Draw_Top_Right_Corner_Check_Right_Wall
*$9A68 BIT 2,A        ; {Jump to #R$9A70 if the right wall is not present.
 $9A6A JR Z,$9A70     ; }
 $9A6C INC HL         ; {Skip the shapes for a right wall.
 $9A6D INC HL         ;
 $9A6E INC HL         ;
 $9A6F INC HL         ; }
; This entry point is used by the routines at #R$9AF8, #R$9B64 and #R$9BB8.
@label=Draw_Corner_Shape
*$9A70 LD A,(IX+$02)  ; Fetch the room x of Sabreman.
 $9A73 ADD A,(IX+$04) ; Add the room y of Sabreman.
 $9A76 ADD A,A        ; {Multiply the sum by eight.
 $9A77 ADD A,A        ;
 $9A78 ADD A,A        ; }
 $9A79 AND %00011000  ; Keep only bits 3 and 4.
 $9A7B LD C,A         ; Store the offset in #REGc.
 $9A7C LD B,$00       ; Clear the high byte of the offset.
 $9A7E ADD HL,BC      ; Add the offset to the address in the table.
 $9A7F LD A,(HL)      ; Fetch the low byte of the address of the shape.
 $9A80 INC HL         ; Move on to the high byte.
 $9A81 LD H,(HL)      ; Fetch the high byte of the address of the shape.
 $9A82 LD L,A         ; Copy the low byte to #REGl.
 $9A83 EX DE,HL       ; Exchange the registers so that #REGde holds the address of the
                      ; shape.
 $9A84 LD BC,$0320    ; Set the size of the area to three bytes wide, #N$20 lines high
                      ; (#N$0320).
 $9A87 CALL $ADF8     ; Convert the position into a screen address.
 $9A8A CALL $9BFE     ; Draw the shape.
 $9A8D POP HL         ; Restore the position from the stack.
 $9A8E LD BC,$0320    ; Set the size of the area to #N$0320.
 $9A91 CALL $9C10     ; Set the attributes of the area.
 $9A94 POP DE         ; Restore the frame flags from the stack.
 $9A95 RET            ; Return.

; Top Right Corner Table
;
; The addresses of the shapes of the top right corner. Each shape is three
; bytes wide and #N$20 lines high and has no header. There are four sets of four
; shapes, one set for each value of the sum of the room x and the room y (modulo
; four). Within a set the shapes are for: no ceiling and no right wall, ceiling
; only, right wall only, and both.
@label=Top_Right_Corner_Table
w$9A96 DEFW $C2B7,$C989,$BD4D,$C8C9,$C2B7,$C9E9,$BDF7,$C8C9
 $9AA6 DEFW $C2B7,$CA49,$BEA1,$C8C9,$C2B7,$CAA9,$BF4B,$C8C9

; Draw Right Wall
;
; Used by the routine at #R$9906.
; .
; Draws the right wall of the room if bit 2 of the frame flags is set, or
; clears its area if it is not.
; .
; The wall is made of two tiles, each three bytes wide and #N$38 lines high,
; which are drawn from top to bottom at x position #N$E8 and y position #N$30.
; The tiles come from the table at #R$9BB0, indexed by the sum of the room x and
; the room y. The routine is also used to draw the left wall (see #R$9BA4).
;
; DE Frame flags of the room in #REGe
; IX Object record of Sabreman
@label=Draw_Right_Wall
c$9AB6 PUSH DE        ; Stash the frame flags on the stack.
 $9AB7 BIT 2,E        ; Test bit 2 of the frame flags (the right wall).
 $9AB9 LD HL,$30E8    ; Set the x position to #N$E8 and the y position to #N$30
                      ; (#N$30E8).
 $9ABC LD DE,$9BB0    ; Point at the table of wall tiles (#R$9BB0).
; This entry point is used by the routine at #R$9BA4.
@label=Draw_Right_Wall_Check_Present
*$9ABF JP Z,$99D7     ; Jump to #R$99D7 if the wall is not present.
@label=Draw_Wall_Tiles
 $9AC2 LD B,$02       ; Set the number of tiles to #N$02.
 $9AC4 PUSH HL        ; Stash the position on the stack.
 $9AC5 CALL $ADF8     ; Convert the position into a screen address.
 $9AC8 LD A,(IX+$02)  ; Fetch the room x of Sabreman.
 $9ACB ADD A,(IX+$04) ; Add the room y of Sabreman.
 $9ACE RLCA           ; Double the sum to make an offset into the table of word
                      ; pointers.
@label=Draw_Right_Wall_Tile_Loop
*$9ACF AND %00000110  ; Keep the offset within the table (four entries).
 $9AD1 LD C,A         ; Store the offset in #REGc.
 $9AD2 PUSH BC        ; Stash the tile counter and the offset on the stack.
 $9AD3 EX DE,HL       ; Exchange the registers so that #REGhl holds the address of the
                      ; table.
 $9AD4 PUSH HL        ; Stash the address of the table on the stack.
 $9AD5 LD B,$00       ; Clear the high byte of the offset.
 $9AD7 ADD HL,BC      ; Add the offset to the address of the table.
 $9AD8 LD A,(HL)      ; Fetch the low byte of the address of the tile.
 $9AD9 INC HL         ; Move on to the high byte.
 $9ADA LD H,(HL)      ; Fetch the high byte of the address of the tile.
 $9ADB LD L,A         ; Copy the low byte to #REGl.
 $9ADC EX DE,HL       ; Exchange the registers so that #REGde holds the address of the tile
                      ; and #REGhl the screen address.
 $9ADD CALL $9BF8     ; Draw the tile.
 $9AE0 POP DE         ; Restore the address of the table into #REGde.
 $9AE1 POP BC         ; Restore the tile counter and the offset.
 $9AE2 LD A,C         ; Copy the offset to #REGa.
 $9AE3 ADD A,$02      ; Move on to the next entry of the table.
 $9AE5 DJNZ $9ACF     ; Decrease the tile counter and loop back until both
                      ; tiles are drawn.
 $9AE7 POP HL         ; Restore the position of the area.
 $9AE8 LD BC,$0370    ; Set the size of the area to #N$0370.
 $9AEB CALL $9C10     ; Set the attributes of the area.
 $9AEE POP DE         ; Restore the frame flags from the stack.
 $9AEF RET            ; Return.

; Left Wall Tile Table
;
; The addresses of the tiles of the left wall, indexed by twice the sum of
; the room x and the room y. Each tile is three bytes wide and #N$38 lines high,
; and is preceded by its height and width (see #R$9BF8).
@label=Left_Wall_Tile_Table
w$9AF0 DEFW $BFAB,$C055,$C0FF,$C1AC

; Draw Bottom Right Corner
;
; Used by the routine at #R$9906.
; .
; Draws the bottom right corner of the frame of the room if bit 3 of the
; frame flags is set, or clears its area if it is not.
; .
; The corner is drawn at x position #N$E8, y position #N$A0 by #R$9A70.
; Its shape depends on whether the floor (bit 4) and the right wall (bit 2) are
; present.
;
; DE Frame flags of the room in #REGe
; IX Object record of Sabreman
@label=Draw_Bottom_Right_Corner
c$9AF8 PUSH DE       ; Stash the frame flags on the stack.
 $9AF9 LD HL,$A0E8   ; Set the x position to #N$E8 and the y position to #N$A0
                     ; (#N$A0E8).
 $9AFC LD A,E        ; Copy the frame flags to #REGa.
 $9AFD LD DE,$9B18   ; Point at the table of corner shapes (#R$9B18).
 $9B00 BIT 3,A       ; {Jump to #R$9B07 to clear the area if the corner is not
 $9B02 JP Z,$99D2    ; present.}
 $9B04 SBC A,C       ;
 $9B05 PUSH HL       ; Stash the position on the stack.
 $9B06 EX DE,HL      ; Exchange the registers so that #REGhl holds the address of the
                     ; table.
 $9B07 BIT 4,A       ; {Jump to #R$9B0D if the floor is not present.
 $9B09 JR Z,$9B0D    ; }
 $9B0B INC HL        ; {Skip the shapes for a floor.
 $9B0C INC HL        ; }
@label=Draw_Bottom_Right_Corner_Check_Right_Wall
*$9B0D BIT 2,A       ; {Jump to #R$9B15 if the right wall is not present.
 $9B0F JR Z,$9B15    ; }
 $9B11 INC HL        ; {Skip the shapes for a right wall.
 $9B12 INC HL        ;
 $9B13 INC HL        ;
 $9B14 INC HL        ; }
@label=Draw_Bottom_Right_Corner_Draw_Shape
*$9B15 JP $9A70      ; Jump to #R$9A70 to draw the shape.

; Bottom Right Corner Table
;
; The addresses of the shapes of the bottom right corner, arranged in the
; same way as the table at #R$9A96. Each shape is three bytes wide and #N$20
; lines high and has no header.
@label=Bottom_Right_Corner_Table
w$9B18 DEFW $B87B,$CB09,$BD05,$C809,$B87B,$CB69,$BDAF,$C809
 $9B28 DEFW $B87B,$CBC9,$BE59,$C809,$B87B,$CC29,$BF03,$C809

; Draw Floor
;
; Used by the routine at #R$9906.
; .
; Draws the floor of the room if bit 4 of the frame flags is set, or
; clears its area if it is not.
; .
; The floor is drawn at x position #N$18 and y position #N$A0 by the code that
; draws the ceiling (see #R$99F5), using the tiles of the table at #R$9B44.
;
; DE Frame flags of the room in #REGe
; IX Object record of Sabreman
@label=Draw_Floor
c$9B38 PUSH DE       ; Stash the frame flags on the stack.
 $9B39 BIT 4,E       ; Test bit 4 of the frame flags (the floor).
 $9B3B LD HL,$A018   ; Set the x position to #N$18 and the y position to #N$A0
                     ; (#N$A018).
 $9B3E LD DE,$9B44   ; Point at the table of floor tiles (#R$9B44).
 $9B41 JP $99FE      ; Jump to #R$99FE to draw the floor.

; Floor Tile Table
;
; The addresses of the tiles of the floor, indexed by twice the sum of the
; room x and the room y. The eight tiles in the first half are repeated in the
; second half. Each tile is two bytes wide and #N$20 lines high, and is preceded
; by its height and width (see #R$9BF8).
@label=Floor_Tile_Table
w$9B44 DEFW $B8DB,$B91D,$B95F,$B9A1,$B9E3,$BA25,$BA67,$BAA9
 $9B54 DEFW $B8DB,$B91D,$B95F,$B9A1,$B9E3,$BA25,$BA67,$BAA9

; Draw Bottom Left Corner
;
; Used by the routine at #R$9906.
; .
; Draws the bottom left corner of the frame of the room if bit 5 of the
; frame flags is set, or clears its area if it is not.
; .
; The corner is drawn at x position #N$00, y position #N$A0 by #R$9A70.
; Its shape depends on whether the floor (bit 4) and the left wall (bit 6) are
; present.
;
; DE Frame flags of the room in #REGe
; IX Object record of Sabreman
@label=Draw_Bottom_Left_Corner
c$9B64 PUSH DE       ; Stash the frame flags on the stack.
 $9B65 LD HL,$A000   ; Set the x position to #N$00 and the y position to #N$A0
                     ; (#N$A000).
 $9B68 LD A,E        ; Copy the frame flags to #REGa.
 $9B69 LD DE,$9B84   ; Point at the table of corner shapes (#R$9B84).
 $9B6C BIT 5,A       ; {Jump to #R$9B73 to clear the area if the corner is not
 $9B6E JP Z,$99D2    ; present.}
 $9B70 SBC A,C       ;
 $9B71 PUSH HL       ; Stash the position on the stack.
 $9B72 EX DE,HL      ; Exchange the registers so that #REGhl holds the address of the
                     ; table.
 $9B73 BIT 4,A       ; {Jump to #R$9B79 if the floor is not present.
 $9B75 JR Z,$9B79    ; }
 $9B77 INC HL        ; {Skip the shapes for a floor.
 $9B78 INC HL        ; }
@label=Draw_Bottom_Left_Corner_Check_Left_Wall
*$9B79 BIT 6,A       ; {Jump to #R$9B81 if the left wall is not present.
 $9B7B JR Z,$9B81    ; }
 $9B7D INC HL        ; {Skip the shapes for a left wall.
 $9B7E INC HL        ;
 $9B7F INC HL        ;
 $9B80 INC HL        ; }
@label=Draw_Bottom_Left_Corner_Draw_Shape
*$9B81 JP $9A70      ; Jump to #R$9A70 to draw the shape.

; Bottom Left Corner Table
;
; The addresses of the shapes of the bottom left corner, arranged in the
; same way as the table at #R$9A96. Each shape is three bytes wide and #N$20
; lines high and has no header.
@label=Bottom_Left_Corner_Table
w$9B84 DEFW $B81B,$CB09,$BFAD,$C869,$B81B,$CB69,$C057,$C869
 $9B94 DEFW $B81B,$CBC9,$C101,$C869,$B81B,$CC29,$C1AE,$C869

; Draw Left Wall
;
; Used by the routine at #R$9906.
; .
; Draws the left wall of the room if bit 6 of the frame flags is set, or
; clears its area if it is not.
; .
; The wall is drawn at x position #N$00 and y position #N$30 by
; #R$9ABF, using the tiles of the table at #R$9AF0.
;
; DE Frame flags of the room in #REGe
; IX Object record of Sabreman
@label=Draw_Left_Wall
c$9BA4 PUSH DE       ; Stash the frame flags on the stack.
 $9BA5 BIT 6,E       ; Test bit 6 of the frame flags (the left wall).
 $9BA7 LD HL,$3000   ; Set the x position to #N$00 and the y position to #N$30
                     ; (#N$3000).
 $9BAA LD DE,$9AF0   ; Point at the table of wall tiles (#R$9AF0).
 $9BAD JP $9ABF      ; Jump to #R$9ABF to draw the left wall.

; Right Wall Tile Table
;
; The addresses of the tiles of the right wall, indexed by twice the sum
; of the room x and the room y. Each tile is three bytes wide and #N$38 lines
; high, and is preceded by its height and width (see #R$9BF8).
@label=Right_Wall_Tile_Table
w$9BB0 DEFW $BD03,$BDAD,$BE57,$BF01

; Draw Top Left Corner
;
; Used by the routine at #R$9906.
; .
; Draws the top left corner of the frame of the room if bit 7 of the frame
; flags is set, or clears its area if it is not.
; .
; The corner is drawn at x position #N$00, y position #N$10 by #R$9A70.
; Its shape depends on whether the ceiling (bit 0) and the left wall (bit 6) are
; present.
;
; DE Frame flags of the room in #REGe
; IX Object record of Sabreman
@label=Draw_Top_Left_Corner
c$9BB8 PUSH DE       ; Stash the frame flags on the stack.
 $9BB9 LD HL,$1000   ; Set the x position to #N$00 and the y position to #N$10
                     ; (#N$1000).
 $9BBC LD A,E        ; Copy the frame flags to #REGa.
 $9BBD LD DE,$9BD8   ; Point at the table of corner shapes (#R$9BD8).
 $9BC0 BIT 7,A       ; {Jump to #R$9BC7 to clear the area if the corner is not
 $9BC2 JP Z,$99D2    ; present.}
 $9BC4 SBC A,C       ;
 $9BC5 PUSH HL       ; Stash the position on the stack.
 $9BC6 EX DE,HL      ; Exchange the registers so that #REGhl holds the address of the
                     ; table.
 $9BC7 BIT 0,A       ; {Jump to #R$9BCD if the ceiling is not present.
 $9BC9 JR Z,$9BCD    ; }
 $9BCB INC HL        ; {Skip the shapes for a ceiling.
 $9BCC INC HL        ; }
@label=Draw_Top_Left_Corner_Check_Left_Wall
*$9BCD BIT 6,A       ; {Jump to #R$9BD5 if the left wall is not present.
 $9BCF JR Z,$9BD5    ; }
 $9BD1 INC HL        ; {Skip the shapes for a left wall.
 $9BD2 INC HL        ;
 $9BD3 INC HL        ;
 $9BD4 INC HL        ; }
@label=Draw_Top_Left_Corner_Draw_Shape
*$9BD5 JP $9A70      ; Jump to #R$9A70 to draw the shape.

; Top Left Corner Table
;
; The addresses of the shapes of the top left corner, arranged in the same
; way as the table at #R$9A96. Each shape is three bytes wide and #N$20 lines
; high and has no header.
@label=Top_Left_Corner_Table
w$9BD8 DEFW $C257,$C989,$BFF5,$C929,$C257,$C9E9,$C09F,$C929
 $9BE8 DEFW $C257,$CA49,$C149,$C929,$C257,$CAA9,$C1F7,$C929

; Draw Tile
;
; Used by the routines at #R$99F5 and #R$9AB6.
; .
; Draws a tile that starts with its height and width, at the screen
; address in #REGhl. The entry at #R$9BFE draws a tile that has no
; header, using the size in #REGbc.
; .
; The pixel data is drawn from left to right and from top to bottom, one row at
; a time, moving down one pixel line for each row. When it returns #REGhl is the
; screen address of the line below the tile.
;
;   DE Address of the tile (height, width, then pixel data)
;   HL Screen address of the top left corner
; O:DE Address of the byte after the tile
; O:HL Screen address of the line below the tile
@label=Draw_Tile
c$9BF8 LD A,(DE)     ; {Fetch the height of the tile as the row counter.
 $9BF9 INC DE        ;
 $9BFA LD C,A        ; }
 $9BFB LD A,(DE)     ; {Fetch the width of the tile as the width counter.
 $9BFC INC DE        ;
 $9BFD LD B,A        ; }
; This entry point is used by the routine at #R$9A53.
@label=Draw_Tile_Without_Header
*$9BFE PUSH BC       ; Stash the width of the tile on the stack.
@label=Draw_Tile_Loop
*$9BFF LD A,(DE)     ; Fetch a byte of the tile.
 $9C00 INC DE        ; Move on to the next byte.
 $9C01 LD (HL),A     ; Write it to the screen.
 $9C02 INC L         ; Move on to the next cell.
 $9C03 DJNZ $9BFF    ; Decrease the width counter and loop back until the row
                     ; is done.
 $9C05 POP BC        ; Restore the width of the tile.
 $9C06 LD A,L        ; Fetch the low byte of the screen address.
 $9C07 SUB B         ; Subtract the width to move back to the start of the row.
 $9C08 LD L,A        ; Store the low byte of the address.
 $9C09 CALL $9C2B    ; Move down one pixel line.
 $9C0C DEC C         ; {Decrease the row counter and loop back until all of the rows of the
 $9C0D JR NZ,$9BFE   ; tile are drawn.}
 $9C0F RET           ; Return.

; Set Area Attributes
;
; Used by the routines at #R$99F5, #R$9A53 and #R$9AB6.
; .
; Sets the attributes of a rectangle of character cells to yellow ink on
; black paper (bright). The rectangle is given in pixels.
;
; BC Size (#REGb is the width in cells, #REGc is the height in pixels)
; HL Position (#REGl is the x position, #REGh is the y position)
@label=Set_Area_Attributes
c$9C10 LD E,$46      ; Set the attribute to #N$46.
 $9C12 CALL $ADE0    ; Convert the position into an address in the attribute
                     ; buffer.
 $9C15 SRL C         ; {Divide the height by eight to get the number of rows of
 $9C17 SRL C         ; cells.
 $9C19 SRL C         ; }
@label=Set_Area_Attributes_Row_Loop
*$9C1B PUSH BC       ; Stash the counters on the stack.
 $9C1C PUSH HL       ; Stash the address on the stack.
@label=Set_Area_Attributes_Cell_Loop
*$9C1D LD (HL),E     ; Set the attribute of the cell.
 $9C1E INC L         ; Move on to the next cell.
 $9C1F DJNZ $9C1D    ; Decrease the width counter and loop back until the row
                     ; is done.
 $9C21 POP HL        ; Restore the address from the stack.
 $9C22 LD BC,$0020   ; Set the size of a row of cells to #N$0020.
 $9C25 ADD HL,BC     ; Move down to the next row of cells.
 $9C26 POP BC        ; Restore the counters from the stack.
 $9C27 DEC C         ; {Decrease the row counter and loop back until all of the rows of
 $9C28 JR NZ,$9C1B   ; cells are done.}
 $9C2A RET           ; Return.

; Screen Address One Pixel Below
;
; Used by the routines at #R$99D2, #R$9BF8, #R$9C70 and #R$9CB1.
; .
; Moves a screen address down by one pixel line.
;
;   HL Screen address
; O:HL Screen address of the next line down
@label=ScreenPosition1PixelBelow
c$9C2B INC H         ; Move down a line within the character.
 $9C2C LD A,H        ; Fetch the high byte of the screen address.
 $9C2D AND $07       ; Keep only the line number.
 $9C2F RET NZ        ; Return unless the character boundary has been crossed.
 $9C30 LD A,L        ; Fetch the low byte of the screen address.
 $9C31 ADD A,$20     ; Move on to the next character row.
 $9C33 LD L,A        ; Store the low byte of the screen address.
 $9C34 AND $E0       ; Keep only the row bits.
 $9C36 RET Z         ; Return if the third of the screen has not been crossed.
 $9C37 LD A,H        ; Copy #REGh to #REGa.
 $9C38 SUB $08       ; Go back up to the first line of the character.
 $9C3A LD H,A        ; Store the high byte of the screen address.
 $9C3B RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9BC1 }
; { #MARTIANOIDS$BD3A }
; { #SABREWULF$B8CC }
; LIST#

; Print Colour String
;
; Used by the routines at #R$90E4, #R$95DE and #R$9EA0.
; .
; Prints a string whose first byte is the attribute for every
; character. The last character of the string has bit 7 set. Entering at
; #N$9C48 prints the characters with the attribute that is already in
; #REGaf'.
; .
; #PUSHS #UDGTABLE(default,centre)
; { =h Before | =h After #R$9C3C }
; { #SIM(start=$9052,stop=$9078,clear=1,sp=$5B40)
; #SIM(start=$9078,stop=$9110,sp=$5B40)
; #SCR$02,$00,$00,$20,$02(colour-string-before)
; | #SIM(start=$9C3C,stop=$0000,hl=$0010,de=$9195,sp=$5B40)
; #SCR$02,$00,$00,$20,$02(colour-string-after) } UDGTABLE# #POPS
;
; HL Position (#REGl is the x position, #REGh is the y position)
; DE Pointer to the string
@label=PrintStringColour
c$9C3C PUSH HL       ; Stash the position on the stack.
 $9C3D CALL $ADF8    ; Convert the position into a screen address.
 $9C40 LD A,(DE)     ; Fetch the attribute from the start of the string.
 $9C41 EX AF,AF'     ; Keep it as the attribute of every character of the string (in
                     ; #REGaf').
 $9C42 INC DE        ; Move on to the first character.
 $9C43 EXX           ; Switch to the shadow registers.
 $9C44 POP HL        ; Restore the position from the stack.
 $9C45 CALL $ADE0    ; Convert the position into an attribute buffer address.
; This entry point is used by the routine at #R$91B0.
@label=PrintString_Loop
*$9C48 EXX           ; Switch to the shadow registers.
 $9C49 LD A,(DE)     ; Fetch a character.
 $9C4A BIT 7,A       ; {Jump to #R$9C59 if this is the last character of the string (bit 7
 $9C4C JR NZ,$9C59   ; is set).}
 $9C4E CALL $98DF    ; Print the character.
 $9C51 INC DE        ; Move on to the next character.
 $9C52 EXX           ; Switch to the shadow registers.
 $9C53 EX AF,AF'     ; Fetch the attribute from #REGaf'.
 $9C54 LD (HL),A     ; Write it to the attribute buffer.
 $9C55 INC L         ; Move on to the next cell.
 $9C56 EX AF,AF'     ; Store the attribute in #REGaf' again.
 $9C57 JR $9C48      ; Jump back to #R$9C48.
@label=PrintString_LastCharacter
*$9C59 AND $7F       ; Clear bit 7 of the last character.
 $9C5B CALL $98DF    ; Print the character.
 $9C5E EXX           ; Switch to the shadow registers.
 $9C5F EX AF,AF'     ; Fetch the attribute from #REGaf'.
 $9C60 LD (HL),A     ; Write it to the attribute buffer.
 $9C61 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$A1F3 }
; { #COOKIE$7488 }
; { #JETPAC$716C }
; { #LUNARJETMAN$8A11 }
; { #PSSST$73ED }
; { #SABREWULF$B53D }
; { #TRANZAM$6518 }
; LIST#

; Reset Room Table
;
; Used by the routine at #R$91C0.
; .
; Writes #N$00 to #N$07FF bytes starting at #R$6000, which empties the
; room visit table.
@label=Reset_Room_Table
c$9C62 LD HL,$6000   ; Point at the start of the room visit table (#R$6000).
 $9C65 LD DE,$6001   ; #REGde=#N$6001 (the second byte of the table, which is the
                     ; destination of the copy).
 $9C68 LD BC,$07FF   ; Set the byte count to #N$07FF.
 $9C6B LD (HL),$00   ; Write #N$00 to the first byte.
 $9C6D LDIR          ; Copy the byte through the rest of the area.
 $9C6F RET           ; Return.

; Draw Ceiling Picture
;
; Used by the routine at #R$9D28.
; .
; Draws the picture of the ceiling of a special room, at x position #N$18
; and y position #N$10. The picture is #N$1A bytes wide and #N$20 lines high
; (see #R$7D27).
; .
; The attributes of the picture are bright red (#N$42). The shared code from
; #R$9C78 onwards also draws the floor (see #R$9CA7).
@label=Draw_Ceiling_Picture
c$9C70 LD HL,$1018   ; Set the x position to #N$18 and the y position to #N$10
                     ; (#N$1018).
 $9C73 LD DE,$7D27   ; Point at the picture (#N$7D27).
 $9C76 LD C,$42      ; Set the attribute of the picture to #N$42.
; This entry point is used by the routine at #R$9CA7.
; .
; Fill in the attributes of the picture, four rows of #N$1A cells.
@label=Draw_Wide_Picture
*$9C78 PUSH HL       ; Stash the position on the stack.
 $9C79 PUSH DE       ; Stash the address of the picture on the stack.
 $9C7A CALL $ADE0    ; Convert the position into an attribute buffer address.
 $9C7D LD DE,$0020   ; Set the size of a row of cells to #N$0020.
 $9C80 LD A,C        ; Copy the attribute to #REGa.
 $9C81 LD C,$04      ; Set the number of rows to #N$04.
@label=Draw_Ceiling_Picture_Row_Loop
*$9C83 PUSH HL       ; Stash the address of the start of the row on the stack.
 $9C84 LD B,$1A      ; Set the number of cells in a row to #N$1A.
@label=Draw_Ceiling_Picture_Cell_Loop
*$9C86 LD (HL),A     ; Write the attribute to the cell.
 $9C87 INC L         ; Move on to the next cell.
 $9C88 DJNZ $9C86    ; Decrease the cell counter and loop back until the row is
                     ; filled.
 $9C8A POP HL        ; Restore the address of the start of the row.
 $9C8B ADD HL,DE     ; Move down to the next row.
 $9C8C DEC C         ; {Decrease the row counter and loop back until all of the rows of
 $9C8D JR NZ,$9C83   ; attributes are filled.}
; Copy the pixels of the picture, #N$20 lines of #N$1A bytes.
 $9C8F POP DE        ; Restore the address of the picture from the stack.
 $9C90 POP HL        ; Restore the position from the stack.
 $9C91 CALL $ADF8    ; Convert the position into a screen address.
 $9C94 LD C,$20      ; Set the number of lines to #N$20.
@label=Draw_Ceiling_Picture_Line_Loop
*$9C96 PUSH HL       ; Stash the screen address of the start of the line on the
                     ; stack.
 $9C97 LD B,$1A      ; Set the number of bytes in a line to #N$1A.
@label=Draw_Ceiling_Picture_Byte_Loop
*$9C99 LD A,(DE)     ; Fetch a byte of the picture.
 $9C9A LD (HL),A     ; Write it to the screen.
 $9C9B INC DE        ; Move on to the next byte of the picture.
 $9C9C INC L         ; Move on to the next screen address.
 $9C9D DJNZ $9C99    ; Decrease the byte counter and loop back until the line
                     ; is drawn.
 $9C9F POP HL        ; Restore the screen address of the start of the line.
 $9CA0 CALL $9C2B    ; Move down a line.
 $9CA3 DEC C         ; {Decrease the line counter and loop back until all of the lines of
 $9CA4 JR NZ,$9C96   ; the picture are drawn.}
 $9CA6 RET           ; Return.

; Draw Floor Picture
;
; Used by the routine at #R$9D28.
; .
; Draws the picture of the floor of a special room, at x position #N$18
; and y position #N$A0. The picture is #N$1A bytes wide and #N$20 lines high
; (see #R$78A3).
; .
; The attributes of the picture are bright magenta (#N$4B). The picture is drawn
; by #R$9C78.
@label=Draw_Floor_Picture
c$9CA7 LD HL,$A018   ; Set the x position to #N$18 and the y position to #N$A0
                     ; (#N$A018).
 $9CAA LD DE,$78A3   ; Point at the picture (#N$78A3).
 $9CAD LD C,$4B      ; Set the attribute of the picture to #N$4B.
 $9CAF JR $9C78      ; Jump to #R$9C78 to draw the picture.

; Draw Left Wall Picture
;
; Used by the routine at #R$9D28.
; .
; Draws the picture of the left wall of a special room, at x position
; #N$00 and y position #N$30. The picture is three bytes wide and #N$70 lines
; high (see #R$8367).
; .
; The attributes of the picture are bright cyan (#N$4D). The shared code from
; #R$9CB9 onwards also draws the right wall (see #R$9CE8).
@label=Draw_Left_Wall_Picture
c$9CB1 LD HL,$3000   ; Set the x position to #N$00 and the y position to #N$30
                     ; (#N$3000).
 $9CB4 LD DE,$8367   ; Point at the picture (#N$8367).
 $9CB7 LD C,$4D      ; Set the attribute of the picture to #N$4D.
; This entry point is used by the routine at #R$9CE8.
; .
; Fill in the attributes of the picture, #N$0E rows of three cells.
@label=Draw_Wall_Picture
*$9CB9 PUSH HL       ; Stash the position on the stack.
 $9CBA PUSH DE       ; Stash the address of the picture on the stack.
 $9CBB CALL $ADE0    ; Convert the position into an attribute buffer address.
 $9CBE LD DE,$0020   ; Set the size of a row of cells to #N$0020.
 $9CC1 LD A,C        ; Copy the attribute to #REGa.
 $9CC2 LD C,$0E      ; Set the number of rows to #N$0E.
@label=Draw_Left_Wall_Picture_Row_Loop
*$9CC4 PUSH HL       ; Stash the address of the start of the row on the stack.
 $9CC5 LD B,$03      ; Set the number of cells in a row to #N$03.
@label=Draw_Left_Wall_Picture_Cell_Loop
*$9CC7 LD (HL),A     ; Write the attribute to the cell.
 $9CC8 INC L         ; Move on to the next cell.
 $9CC9 DJNZ $9CC7    ; Decrease the cell counter and loop back until the row is
                     ; filled.
 $9CCB POP HL        ; Restore the address of the start of the row.
 $9CCC ADD HL,DE     ; Move down to the next row.
 $9CCD DEC C         ; {Decrease the row counter and loop back until all of the rows of
 $9CCE JR NZ,$9CC4   ; attributes are filled.}
; Copy the pixels of the picture, #N$70 lines of three bytes.
 $9CD0 POP DE        ; Restore the address of the picture from the stack.
 $9CD1 POP HL        ; Restore the position from the stack.
 $9CD2 CALL $ADF8    ; Convert the position into a screen address.
 $9CD5 LD C,$70      ; Set the number of lines to #N$70.
; This entry point is used by the routine at #R$9CF2.
@label=Draw_Three_Byte_Lines
*$9CD7 PUSH HL       ; Stash the screen address of the start of the line on the
                     ; stack.
 $9CD8 LD B,$03      ; Set the number of bytes in a line to #N$03.
@label=Draw_Left_Wall_Picture_Byte_Loop
*$9CDA LD A,(DE)     ; Fetch a byte of the picture.
 $9CDB LD (HL),A     ; Write it to the screen.
 $9CDC INC DE        ; Move on to the next byte of the picture.
 $9CDD INC L         ; Move on to the next screen address.
 $9CDE DJNZ $9CDA    ; Decrease the byte counter and loop back until the line
                     ; is drawn.
 $9CE0 POP HL        ; Restore the screen address of the start of the line.
 $9CE1 CALL $9C2B    ; Move down a line.
 $9CE4 DEC C         ; {Decrease the line counter and loop back until all of the lines of
 $9CE5 JR NZ,$9CD7   ; the picture are drawn.}
 $9CE7 RET           ; Return.

; Draw Right Wall Picture
;
; Used by the routine at #R$9D28.
; .
; Draws the picture of the right wall of a special room, at x position
; #N$E8 and y position #N$30. The picture is three bytes wide and #N$70 lines
; high (see #R$8217).
; .
; The attributes of the picture are bright cyan (#N$4D). The picture is drawn by
; #R$9CB9.
@label=Draw_Right_Wall_Picture
c$9CE8 LD HL,$30E8   ; Set the x position to #N$E8 and the y position to #N$30
                     ; (#N$30E8).
 $9CEB LD DE,$8217   ; Point at the picture (#N$8217).
 $9CEE LD C,$4D      ; Set the attribute of the picture to #N$4D.
 $9CF0 JR $9CB9      ; Jump to #R$9CB9 to draw the picture.

; Draw Top Left Corner Picture
;
; Used by the routine at #R$9D28.
; .
; Draws a picture of a corner of the frame of a special room at x position
; #N$00 and y position #N$10, which is the top left corner. The picture is three
; bytes wide and #N$20 lines high, and starts with its attributes (see #R$7687).
; .
; The entries at #R$9D19, #R$9D1E and #R$9D23 draw the other three corners,
; using the shared code from #R$9CF5 onwards.
;
; DE Address of the picture
@label=Draw_Top_Left_Corner_Picture
c$9CF2 LD HL,$1000   ; Set the x position to #N$00 and the y position to #N$10
                     ; (#N$1000).
; This entry point is used by the routines at #R$9D19, #R$9D1E and #R$9D23.
; .
; Copy the attributes of the picture, four rows of three cells.
@label=Draw_Corner_Picture
*$9CF5 PUSH HL       ; Stash the position on the stack.
 $9CF6 CALL $ADE0    ; Convert the position into an attribute buffer address.
 $9CF9 LD C,$04      ; Set the number of rows to #N$04.
@label=Draw_Top_Left_Corner_Picture_Row_Loop
*$9CFB PUSH HL       ; Stash the address of the start of the row on the stack.
 $9CFC LD B,$03      ; Set the number of cells in a row to #N$03.
@label=Draw_Top_Left_Corner_Picture_Cell_Loop
*$9CFE LD A,(DE)     ; Fetch an attribute from the picture.
 $9CFF LD (HL),A     ; Write it to the cell.
 $9D00 INC DE        ; Move on to the next attribute of the picture.
 $9D01 INC L         ; Move on to the next cell.
 $9D02 DJNZ $9CFE    ; Decrease the cell counter and loop back until the row is
                     ; copied.
 $9D04 POP HL        ; Restore the address of the start of the row.
 $9D05 LD A,L        ; Fetch the low byte of the address.
 $9D06 ADD A,$20     ; Add the size of a row of cells.
 $9D08 LD L,A        ; Store the low byte of the address.
 $9D09 LD A,H        ; Fetch the high byte of the address.
 $9D0A ADC A,$00     ; Add the carry.
 $9D0C LD H,A        ; Store the high byte of the address.
 $9D0D DEC C         ; {Decrease the row counter and loop back until all of the rows of
 $9D0E JR NZ,$9CFB   ; attributes are copied.}
 $9D10 POP HL        ; Restore the position from the stack.
 $9D11 CALL $ADF8    ; Convert the position into a screen address.
 $9D14 LD C,$20      ; Set the number of lines to #N$20.
 $9D16 JP $9CD7      ; Jump to #R$9CD7 to copy the pixels.

; Draw Top Right Corner Picture
;
; Used by the routine at #R$9D28.
; .
; Draws a picture of the top right corner of the frame of a special room,
; at x position #N$E8 and y position #N$10 (see #R$9CF2).
;
; DE Address of the picture
@label=Draw_Top_Right_Corner_Picture
c$9D19 LD HL,$10E8   ; Set the x position to #N$E8 and the y position to #N$10
                     ; (#N$10E8).
 $9D1C JR $9CF5      ; Jump to #R$9CF5 to draw the picture.

; Draw Bottom Left Corner Picture
;
; Used by the routine at #R$9D28.
; .
; Draws a picture of the bottom left corner of the frame of a special
; room, at x position #N$00 and y position #N$A0 (see #R$9CF2).
;
; DE Address of the picture
@label=Draw_Bottom_Left_Corner_Picture
c$9D1E LD HL,$A000   ; Set the x position to #N$00 and the y position to #N$A0
                     ; (#N$A000).
 $9D21 JR $9CF5      ; Jump to #R$9CF5 to draw the picture.

; Draw Bottom Right Corner Picture
;
; Used by the routine at #R$9D28.
; .
; Draws a picture of the bottom right corner of the frame of a special
; room, at x position #N$E8 and y position #N$A0 (see #R$9CF2).
;
; DE Address of the picture
@label=Draw_Bottom_Right_Corner_Picture
c$9D23 LD HL,$A0E8   ; Set the x position to #N$E8 and the y position to #N$A0
                     ; (#N$A0E8).
 $9D26 JR $9CF5      ; Jump to #R$9CF5 to draw the picture.

; Draw Special Room Parts
;
; The routines that draw the parts of the frame of a special room that are
; chosen by the four tables at #R$9DD6. Each entry draws one to three pictures
; (see #R$7687) and returns to the code that called it. The entries are in the
; order of their addresses: they are not grouped by table.
;
; .
;
; Top right: the ceiling and a corner. Used for code #N$03 of the first
; table.
@label=Draw_Special_Room_Parts
c$9D28 CALL $9C70    ; Draw the ceiling.
 $9D2B LD DE,$81AB   ; Point at the top right corner picture (#N$81AB).
 $9D2E JR $9D19      ; Jump to #R$9D19 to draw the corner.
; Top right: a corner and the right wall. Used for code #N$06 of the first
; table.
@label=Draw_Top_Right_Corner_And_Right_Wall
 $9D30 LD DE,$80D3   ; Point at the top right corner picture (#N$80D3).
 $9D33 CALL $9D19    ; Draw the corner.
 $9D36 JP $9CE8      ; Jump to #R$9CE8 to draw the right wall.
; Top right: the ceiling, a corner and the right wall. Used for code #N$07
; of the first table.
@label=Draw_Top_Right_Ceiling_Corner_And_Wall
 $9D39 CALL $9C70    ; Draw the ceiling.
 $9D3C LD DE,$7CBB   ; Point at the top right corner picture (#N$7CBB).
 $9D3F CALL $9D19    ; Draw the corner.
 $9D42 JP $9CE8      ; Jump to #R$9CE8 to draw the right wall.
; Bottom right: a corner. Used for code #N$03 of the second table.
 $9D45 LD DE,$77CB   ; Point at the bottom right corner picture (#N$77CB).
 $9D48 JR $9D23      ; Jump to #R$9D23 to draw the corner.
; Bottom right: a corner and the floor. Used for code #N$06 of the second
; table.
@label=Draw_Bottom_Right_Corner_And_Floor
 $9D4A LD DE,$76F3   ; Point at the bottom right corner picture (#N$76F3).
 $9D4D CALL $9D23    ; Draw the corner.
 $9D50 JP $9CA7      ; Jump to #R$9CA7 to draw the floor.
; Bottom right: a corner and the floor. Used for code #N$07 of the second
; table.
 $9D53 LD DE,$7BE3   ; Point at the bottom right corner picture (#N$7BE3).
 $9D56 CALL $9D23    ; Draw the corner.
 $9D59 JP $9CA7      ; Jump to #R$9CA7 to draw the floor.
; Bottom left: the floor and a corner. Used for code #N$03 of the third
; table.
@label=Draw_Floor_And_Bottom_Left_Corner
 $9D5C CALL $9CA7    ; Draw the floor.
 $9D5F LD DE,$7687   ; Point at the bottom left corner picture (#N$7687).
 $9D62 JR $9D1E      ; Jump to #R$9D1E to draw the corner.
; Bottom left: a corner and the left wall. Used for code #N$06 of the
; third table.
@label=Draw_Bottom_Left_Corner_And_Left_Wall
 $9D64 LD DE,$775F   ; Point at the bottom left corner picture (#N$775F).
 $9D67 CALL $9D1E    ; Draw the corner.
 $9D6A JP $9CB1      ; Jump to #R$9CB1 to draw the left wall.
; Bottom left: a corner and the left wall. Used for code #N$07 of the
; third table.
 $9D6D LD DE,$7837   ; Point at the bottom left corner picture (#N$7837).
 $9D70 CALL $9D1E    ; Draw the corner.
 $9D73 JP $9CB1      ; Jump to #R$9CB1 to draw the left wall.
; Top left: a corner. Used for code #N$03 of the fourth table.
 $9D76 LD DE,$8067   ; Point at the top left corner picture (#N$8067).
 $9D79 JP $9CF2      ; Jump to #R$9CF2 to draw the corner.
; Top left: a corner. Used for code #N$06 of the fourth table.
 $9D7C LD DE,$813F   ; Point at the top left corner picture (#N$813F).
 $9D7F JP $9CF2      ; Jump to #R$9CF2 to draw the corner.
; Top left: a corner. Used for code #N$07 of the fourth table.
 $9D82 LD DE,$7C4F   ; Point at the top left corner picture (#N$7C4F).
 $9D85 JP $9CF2      ; Jump to #R$9CF2 to draw the corner.
; Top right: a corner. Used for codes #N$00 and #N$02 of the first table.
 $9D88 LD DE,$858F   ; Point at the top right corner picture (#N$858F).
 $9D8B JP $9D19      ; Jump to #R$9D19 to draw the corner.
; Bottom right: a corner. Used for codes #N$00 and #N$02 of the second
; table.
 $9D8E LD DE,$84B7   ; Point at the bottom right corner picture (#N$84B7).
 $9D91 JP $9D23      ; Jump to #R$9D23 to draw the corner.
; Bottom left: a corner. Used for codes #N$00 and #N$02 of the third
; table.
 $9D94 LD DE,$8523   ; Point at the bottom left corner picture (#N$8523).
 $9D97 JP $9D1E      ; Jump to #R$9D1E to draw the corner.
; Top left: a corner. Used for codes #N$00 and #N$02 of the fourth table.
 $9D9A LD DE,$85FB   ; Point at the top left corner picture (#N$85FB).
 $9D9D JP $9CF2      ; Jump to #R$9CF2 to draw the corner.

; Draw Special Room Frame
;
; Used by the routine at #R$9906.
; .
; Draws the frame of a special room (one with a room y below #N$10).
; .
; In these rooms the first byte of the world map entry is not a set of flags
; (see #R$9906) but four codes of three bits each, which overlap by one bit.
; Each code selects one of eight routines from a table of eight addresses (see
; #R$9DD6) and each routine draws the pictures for one part of the frame. The
; codes are:
; .
; #TABLE(default,centre) { =h Bits | =h Part of the frame | =h Table } { 0 to 2
; | Top right | #R$9DD6 } { 2 to 4 | Bottom right | #R$9DE6 } { 4 to 6
; | Bottom left | #R$9DF6 } { 6, 7 and 0 | Top left | #R$9E06
; } TABLE#
; .
; The first three routines run with the shadow registers, which keeps #REGde
; safe, and the last runs with the main registers.
; .
; #PUSHS #UDGTABLE(default,centre)
; { =h Before | =h After #R$9DA0 }
; { #SIM(start=$9052,stop=$9078,clear=1,sp=$5B40)
; #SIM(start=$91C0,stop=$997D,sp=$5B40)
; #SCR$01(special-frame-before)
; | #SIM(start=$997D,stop=$9980,sp=$5B40)
; #SCR$01(special-frame-after) } UDGTABLE# #POPS
;
; E First byte of the world map entry
@label=Draw_Special_Room_Frame
c$9DA0 LD A,E        ; Fetch the first byte of the world map entry.
 $9DA1 EXX           ; Switch to the shadow registers.
 $9DA2 AND %00000111 ; Keep bits 0 to 2 (the code for the top right).
 $9DA4 LD HL,$9DD6   ; Point at the table for the top right (#R$9DD6).
 $9DA7 CALL $9DC9    ; Draw the top right of the frame.
 $9DAA EXX           ; Switch to the main registers.
 $9DAB LD A,E        ; Fetch the first byte of the world map entry.
 $9DAC EXX           ; Switch to the shadow registers.
 $9DAD RRA           ; {Move bits 2 to 4 down to bits 0 to 2.
 $9DAE RRA           ; }
 $9DAF LD HL,$9DE6   ; Point at the table for the bottom right (#R$9DE6).
 $9DB2 CALL $9DC9    ; Draw the bottom right of the frame.
 $9DB5 EXX           ; Switch to the main registers.
 $9DB6 LD A,E        ; Fetch the first byte of the world map entry.
 $9DB7 EXX           ; Switch to the shadow registers.
 $9DB8 RRA           ; {Move bits 4 to 6 down to bits 0 to 2.
 $9DB9 RRA           ;
 $9DBA RRA           ;
 $9DBB RRA           ; }
 $9DBC LD HL,$9DF6   ; Point at the table for the bottom left (#R$9DF6).
 $9DBF CALL $9DC9    ; Draw the bottom left of the frame.
 $9DC2 EXX           ; Switch to the main registers.
 $9DC3 LD A,E        ; Fetch the first byte of the world map entry.
 $9DC4 RLCA          ; {Rotate bits 6, 7 and 0 into bits 0 to 2.
 $9DC5 RLCA          ; }
 $9DC6 LD HL,$9E06   ; Point at the table for the top left (#R$9E06).
; Run the routine that the code selects from the table. The routine
; returns to the caller of this one.
@label=Draw_Frame_Part
*$9DC9 AND %00000111 ; Keep bits 0 to 2 (the code).
 $9DCB LD E,A        ; {Make the code into an offset in #REGde.
 $9DCC LD D,$00      ; }
 $9DCE ADD HL,DE     ; Add the code to the address of the table.
 $9DCF ADD HL,DE     ; Add the code to the address of the table again, as the entries are
                     ; two bytes long.
 $9DD0 LD A,(HL)     ; Fetch the low byte of the address of the routine.
 $9DD1 INC HL        ; Move on to the high byte.
 $9DD2 LD H,(HL)     ; Fetch the high byte of the address of the routine.
 $9DD3 LD L,A        ; Copy the low byte into #REGl.
 $9DD4 JP (HL)       ; Jump to the routine.
; Several codes in the tables lead here, so nothing is drawn.
@label=Draw_Nothing
 $9DD5 RET           ; Return.

; Special Room Frame Tables
;
; Four tables of eight routines, one table for each part of the frame of a
; special room (see #R$9DA0). The code from the world map selects the entry. The
; tables are for the top right, the bottom right, the bottom left and the top
; left, in that order.
;
; .
;
; Top right.
@label=Special_Room_Frame_Tables
w$9DD6 DEFW $9D88    ; Code 0: a corner (#R$9D88).
 $9DD8 DEFW $9C70    ; Code 1: the ceiling (#R$9C70).
 $9DDA DEFW $9D88    ; Code 2: a corner (#R$9D88).
 $9DDC DEFW $9D28    ; Code 3: the ceiling and a corner (#R$9D28).
 $9DDE DEFW $9CE8    ; Code 4: the right wall (#R$9CE8).
 $9DE0 DEFW $9DD5    ; Code 5: nothing (#R$9DD5).
 $9DE2 DEFW $9D30    ; Code 6: a corner and the right wall (#R$9D30).
 $9DE4 DEFW $9D39    ; Code 7: the ceiling, a corner and the right wall
                     ; (#R$9D39).
; Bottom right.
@label=Special_Room_Frame_Tables_Bottom_Right
 $9DE6 DEFW $9D8E    ; Code 0: a corner (#R$9D8E).
 $9DE8 DEFW $9DD5    ; Code 1: nothing (#R$9DD5).
 $9DEA DEFW $9D8E    ; Code 2: a corner (#R$9D8E).
 $9DEC DEFW $9D45    ; Code 3: a corner (#R$9D45).
 $9DEE DEFW $9DD5    ; Code 4: nothing (#R$9DD5).
 $9DF0 DEFW $9DD5    ; Code 5: nothing (#R$9DD5).
 $9DF2 DEFW $9D4A    ; Code 6: a corner and the floor (#R$9D4A).
 $9DF4 DEFW $9D53    ; Code 7: a corner and the floor (#R$9D53).
; Bottom left.
@label=Special_Room_Frame_Tables_Bottom_Left
 $9DF6 DEFW $9D94    ; Code 0: a corner (#R$9D94).
 $9DF8 DEFW $9DD5    ; Code 1: nothing (#R$9DD5).
 $9DFA DEFW $9D94    ; Code 2: a corner (#R$9D94).
 $9DFC DEFW $9D5C    ; Code 3: the floor and a corner (#R$9D5C).
 $9DFE DEFW $9DD5    ; Code 4: nothing (#R$9DD5).
 $9E00 DEFW $9DD5    ; Code 5: nothing (#R$9DD5).
 $9E02 DEFW $9D64    ; Code 6: a corner and the left wall (#R$9D64).
 $9E04 DEFW $9D6D    ; Code 7: a corner and the left wall (#R$9D6D).
; Top left.
@label=Special_Room_Frame_Tables_Top_Left
 $9E06 DEFW $9D9A    ; Code 0: a corner (#R$9D9A).
 $9E08 DEFW $9DD5    ; Code 1: nothing (#R$9DD5).
 $9E0A DEFW $9D9A    ; Code 2: a corner (#R$9D9A).
 $9E0C DEFW $9D76    ; Code 3: a corner (#R$9D76).
 $9E0E DEFW $9DD5    ; Code 4: nothing (#R$9DD5).
 $9E10 DEFW $9DD5    ; Code 5: nothing (#R$9DD5).
 $9E12 DEFW $9D7C    ; Code 6: a corner (#R$9D7C).
 $9E14 DEFW $9D82    ; Code 7: a corner (#R$9D82).

; Print Status Panel
;
; Used by the routine at #R$91C0.
; .
; Prints the depth, the GEMS label and the gem counter. The entry at
; #N$9E27 only prints the gem counter, and the entry at #N$9E32 prints a
; number of BCD digits.
; .
; #PUSHS #UDGTABLE(default,centre)
; { =h Before | =h After #R$9E16 }
; { #SIM(start=$9052,stop=$9078,clear=1,sp=$5B40)
; #SIM(start=$91C0,stop=$91DC,sp=$5B40)
; #SCR$02,$00,$00,$20,$02(status-panel-before)
; | #SIM(start=$91DC,stop=$91DF,sp=$5B40)
; #SCR$02,$00,$00,$20,$02(status-panel-after) } UDGTABLE# #POPS
;
; IX Object record of Sabreman
@label=Print_Status_Panel
c$9E16 CALL $9E58    ; Call #R$9E58.
 $9E19 LD A,$45      ; Set the attribute to cyan (#N$45).
 $9E1B LD ($8EE8),A  ; Store it in #R$8EE8.
 $9E1E LD DE,$9E97   ; Point at the text GEMS (#R$9E97).
 $9E21 LD HL,$0800   ; Set the position to x=#N$00, y=#N$08.
 $9E24 CALL $91B0    ; Call #R$91B0.
; This entry point is used by the routines at #R$9459 and #R$E751.
@label=Print_Status_Panel_Gem_Timer
*$9E27 LD HL,$0828   ; Set the screen position to x=#N$28, y=#N$08.
 $9E2A CALL $ADF8    ; Convert the position into a screen address.
 $9E2D LD DE,$8EEE   ; Point at the gem counter (#R$8EEE).
 $9E30 LD B,$01      ; Set the number of digits to print to #N$01.
; This entry point is used by the routines at #R$9E58, #R$9FA3, #R$A021 and
; #R$A045.
@label=Print_Status_Panel_Digits
*$9E32 LD A,(DE)     ; Fetch a BCD byte.
 $9E33 RRCA          ; {Move the high digit down.
 $9E34 RRCA          ;
 $9E35 RRCA          ;
 $9E36 RRCA          ; }
 $9E37 AND $0F       ; Keep only the digit.
 $9E39 ADD A,$30     ; Convert it into a character code.
 $9E3B CALL $98DF    ; Print the digit.
 $9E3E LD A,(DE)     ; Fetch the BCD byte again.
 $9E3F AND $0F       ; Keep only the low digit.
 $9E41 ADD A,$30     ; Convert it into a character code.
 $9E43 CALL $98DF    ; Print the digit.
 $9E46 INC DE        ; Move on to the next byte.
 $9E47 DJNZ $9E32    ; Repeat for each of the bytes.
 $9E49 RET           ; Return.

; Print Score Label
;
; Used by the routine at #R$91C0.
; .
; Prints the text SCORE and six zeroes at the top left of the screen.
; .
; #PUSHS #UDGTABLE(default,centre)
; { =h Before | =h After #R$9E4A }
; { #SIM(start=$9052,stop=$9078,clear=1,sp=$5B40)
; #SIM(start=$91C0,stop=$91DF,sp=$5B40)
; #SCR$02,$00,$00,$20,$02(score-label-before)
; | #SIM(start=$91DF,stop=$91E2,sp=$5B40)
; #SCR$02,$00,$00,$20,$02(score-label-after) } UDGTABLE# #POPS
@label=Print_Score_Label
c$9E4A LD A,$46      ; Set the attribute to yellow (#N$46).
 $9E4C LD ($8EE8),A  ; Store it in #R$8EE8.
 $9E4F LD DE,$9F3F   ; Point at the text SCORE (#R$9F3F).
 $9E52 LD HL,$0000   ; Set the position to x=#N$00, y=#N$00.
 $9E55 JP $91B0      ; Jump to #R$91B0.

; Print Depth
;
; Used by the routine at #R$9E16.
; .
; Prints the text DEPTH and the depth of the room that Sabreman is
; in. The depth is worked out from the room y by adding one to the BCD
; base held in #R$9E93 for each row in the band. The entry at #N$9E66
; leaves out the text.
; .
; #PUSHS #UDGTABLE(default,centre)
; { =h Before | =h After #R$9E58 }
; { #SIM(start=$9052,stop=$9078,clear=1,sp=$5B40)
; #SIM(start=$91C0,stop=$91DC,sp=$5B40)
; #SCR$02,$00,$00,$20,$02(depth-before)
; | #SIM(start=$9E58,stop=$0000,ix=$8F1A,sp=$5B40)
; #SCR$02,$00,$00,$20,$02(depth-after) } UDGTABLE# #POPS
;
; IX Object record of Sabreman
@label=Print_Depth
c$9E58 LD A,$45      ; Set the attribute to cyan (#N$45).
 $9E5A LD ($8EE8),A  ; Store it in #R$8EE8.
 $9E5D LD DE,$9E9B   ; Point at the text DEPTH (#R$9E9B).
 $9E60 LD HL,$0840   ; Set the position to x=#N$40, y=#N$08.
 $9E63 CALL $91B0    ; Call #R$91B0.
; This entry point is used by the routine at #R$9906.
@label=Print_Depth_From_Object
*$9E66 LD A,(IX+$04) ; Fetch the room y of the object.
 $9E69 RRA           ; {Move the high nibble down.
 $9E6A RRA           ;
 $9E6B RRA           ;
 $9E6C RRA           ; }
 $9E6D AND $0F       ; Keep only the nibble.
 $9E6F LD C,A        ; {Use the band number as the offset into the table of
 $9E70 LD B,$00      ; bases.}
 $9E72 LD HL,$9E93   ; Point at the table of bases (#R$9E93).
 $9E75 ADD HL,BC     ; Add the offset.
 $9E76 LD C,(HL)     ; Fetch the BCD base.
 $9E77 LD A,(IX+$04) ; Fetch the room y of the object again.
 $9E7A AND $0F       ; Keep only the low nibble.
 $9E7C INC A         ; Add one.
 $9E7D LD B,A        ; Store the number of rows in the band as the row counter.
 $9E7E LD A,C        ; Start from the BCD depth of the top of the band.
@label=Print_Depth_Row_Loop
*$9E7F INC A         ; {Add one to the depth, keeping it as a BCD value.
 $9E80 DAA           ; }
 $9E81 DJNZ $9E7F    ; Repeat until the depth of the room has been counted up from the top
                     ; of the band.
 $9E83 LD ($8EEF),A  ; Store the depth in #N$8EEF.
 $9E86 LD HL,$0870   ; Set the screen position to x=#N$70, y=#N$08.
 $9E89 CALL $ADF8    ; Convert the position into a screen address.
 $9E8C LD DE,$8EEF   ; Point at the depth (#R$8EEF).
 $9E8F LD B,$01      ; Set the number of digits to print to #N$01.
 $9E91 JR $9E32      ; Jump to #R$9E32.

; Status Panel Data
;
; The BCD depth at the top of each band of sixteen room rows, followed
; by the text for the status panel.
@label=Status_Panel_Data
b$9E93 DEFB $00,$16,$32,$48
@label=Status_Panel_Text_Gems
 $9E97 DEFM "GEM","S"+$80   ; "GEMS"
@label=Status_Panel_Text_Depth
 $9E9B DEFM "DEPT","H"+$80  ; "DEPTH"

; Show Ending Screen
;
; Used by the routine at #R$9906.
; .
; Shows the screen for escaping from the Underwurlde and then shows the
; game over screen. It does not return.
; .
; The screen says CONGRATULATIONS and YOU HAVE ESCAPED FROM THE UNDERWURLDE, and
; then gives the name of the next adventure, which depends on the room x of
; Sabreman: #N$03 for KNIGHT LORE, #N$09 for PENTAGRAM and anything else for
; MIRE MARE. The two letters A of PENTAGRAM are drawn as star sprites (see
; #R$9F07).
; .
; This is where the game ends if Sabreman reaches room y #N$FF (see #R$9906).
; .
; #PUSHS #UDGTABLE(default,centre)
; { =h PENTAGRAM | =h KNIGHT LORE | =h MIRE MARE }
; { #SIM(start=$9052,stop=$9078,clear=1,sp=$5B40)
; #SIM(start=$91C0,stop=$91E5,sp=$5B40)
; #POKES$8F1E,$FF
; #SIM(start=$9906,stop=$9EDE,ix=$8F1A,sp=$5B40)
; #SCR$01(ending-pentagram)
; | #SIM(start=$9052,stop=$9078,clear=1,sp=$5B40)
; #SIM(start=$91C0,stop=$91E5,sp=$5B40)
; #POKES$8F1C,$03;$8F1E,$FF
; #SIM(start=$9906,stop=$9EDE,ix=$8F1A,sp=$5B40)
; #SCR$01(ending-knight-lore)
; | #SIM(start=$9052,stop=$9078,clear=1,sp=$5B40)
; #SIM(start=$91C0,stop=$91E5,sp=$5B40)
; #POKES$8F1C,$05;$8F1E,$FF
; #SIM(start=$9906,stop=$9EDE,ix=$8F1A,sp=$5B40)
; #SCR$01(ending-mire-mare) } UDGTABLE# #POPS
@label=Show_Ending_Screen
c$9EA0 LD A,$47        ; Set the attribute to bright white (#N$47).
 $9EA2 LD ($8EE8),A    ; Store it as the attribute for printing (#R$8EE8).
 $9EA5 LD DE,$9F0D     ; Point at the text CONGRATULATIONS (#R$9F0D).
 $9EA8 LD HL,$3040     ; Set the x position to #N$40 and the y position to
                       ; #N$30 (#N$3040).
 $9EAB CALL $91B0      ; Print the text.
 $9EAE LD DE,$9F4B     ; Point at the text YOU HAVE ESCAPED FROM (#R$9F4B).
 $9EB1 LD HL,$4828     ; Set the x position to #N$28 and the y position to
                       ; #N$48 (#N$4828).
 $9EB4 CALL $91B0      ; Print the text.
 $9EB7 LD DE,$9F61     ; Point at the text THE UNDERWURLDE (#R$9F61).
 $9EBA LD HL,$6040     ; Set the x position to #N$40 and the y position to
                       ; #N$60 (#N$6040).
 $9EBD CALL $91B0      ; Print the text.
 $9EC0 LD DE,$9F71     ; Point at the text YOUR NEXT ADVENTURE IS (#R$9F71).
 $9EC3 LD HL,$7828     ; Set the x position to #N$28 and the y position to
                       ; #N$78 (#N$7828).
 $9EC6 CALL $91B0      ; Print the text.
 $9EC9 LD H,$90        ; Set the y position for the name of the next adventure
                       ; to #N$90.
 $9ECB LD A,($8F1C)    ; Fetch the room x of Sabreman.
 $9ECE CP $03          ; {Jump to #R$9EE4 if the room x is #N$03.
 $9ED0 JR Z,$9EE4      ; }
 $9ED2 CP $09          ; {Jump to #R$9EEB if the room x is #N$09.
 $9ED4 JR Z,$9EEB      ; }
 $9ED6 LD DE,$9F35     ; Point at the text MIRE MARE (#R$9F35).
 $9ED9 LD L,$58        ; Set the x position to #N$58.
@label=Show_Ending_Screen_Print_Text
*$9EDB CALL $91B0      ; Print the text.
@label=Show_Ending_Screen_Wait_For_Key
*$9EDE CALL $95F3      ; Wait for key 0 to be pressed.
 $9EE1 JP $95DE        ; Jump to #R$95DE to show the game over screen.
; The room x is #N$03.
@label=Show_Ending_Screen_Knight_Lore
*$9EE4 LD DE,$9F1C     ; Point at the text KNIGHT LORE (#R$9F1C).
 $9EE7 LD L,$50        ; Set the x position to #N$50.
 $9EE9 JR $9EDB        ; Jump to #R$9EDB to print the text.
; The room x is #N$09. The text PENTAGRAM leaves a gap of two cells for
; each A, which is filled by a star.
@label=Show_Ending_Screen_Pentagram
*$9EEB LD DE,$9F28     ; Point at the attribute and the text PENT GR M
                       ; (#R$9F28).
 $9EEE LD L,$50        ; Set the x position to #N$50.
 $9EF0 CALL $9C3C      ; Print the text using the attribute at the start of the
                       ; string.
 $9EF3 LD IX,$9F07     ; Point at the object record of the star (#R$9F07).
 $9EF7 LD (IX+$01),$70 ; Set the x position of the star to #N$70.
 $9EFB CALL $96DB      ; Draw the first star.
 $9EFE LD (IX+$01),$90 ; Set the x position of the star to #N$90.
 $9F02 CALL $96DB      ; Draw the second star.
 $9F05 JR $9EDE        ; Jump to #R$9EDE to wait for a key.

; Messaging: Ending Text
;
; The object record of the star that is drawn for each letter A of
; PENTAGRAM, followed by the text for the ending screen and for the game over
; screen. The last character of each string has bit 7 set. #R$9C3C prints the
; strings that start with an attribute byte, and #R$91B0 prints the others using
; the attribute in #R$8EE8.
@label=Ending_Text
t$9F07 DEFB $90                              ; Sprite id of the star.
 $9F08 DEFB $70                              ; X position (set to #N$70 and
                                             ; then #N$90 before the star is
                                             ; drawn).
 $9F09 DEFB $00                              ; Room x.
 $9F0A DEFB $9C                              ; Y position.
 $9F0B DEFB $00                              ; Room y.
 $9F0C DEFB $46                              ; Attribute: #COLOUR(#PEEK(#PC)).
@label=Ending_Text_Congratulations
 $9F0D DEFM "CONGRATULATION","S"+$80         ; "CONGRATULATIONS"
@label=Ending_Text_Knight_Lore
 $9F1C DEFM "KNIGHT LORE"," "+$80            ; "KNIGHT LORE"
; PENTAGRAM, with an attribute first. Each of the two gaps is where a star
; is drawn in place of an A.
@label=Ending_Text_Pentagram
 $9F28 DEFB $46                              ; Attribute: #COLOUR(#PEEK(#PC)).
 $9F29 DEFM "PENT  GR  M"," "+$80            ; "PENT  GR  M"
@label=Ending_Text_Mire_Mare
 $9F35 DEFM "MIRE MARE"," "+$80              ; "MIRE MARE"
@label=Ending_Text_Score
 $9F3F DEFM "SCORE 00000","0"+$80            ; "SCORE 000000"
@label=Ending_Text_You_Have_Escaped_From
 $9F4B DEFM "YOU HAVE ESCAPED FROM"," "+$80  ; "YOU HAVE ESCAPED FROM"
@label=Ending_Text_The_Underwurlde
 $9F61 DEFM "THE UNDERWURLDE"," "+$80        ; "THE UNDERWURLDE"
@label=Ending_Text_Your_Next_Adventure_Is
 $9F71 DEFM "YOUR NEXT ADVENTURE IS"," "+$80 ; "YOUR NEXT ADVENTURE IS"
@label=Ending_Text_You_Have_Completed
 $9F88 DEFM "YOU HAVE COMPLETED"," "+$80     ; "YOU HAVE COMPLETED"
; The percent sign (character code #N$3B), followed by the text 100 and
; the word OF.
@label=Ending_Text_Percent_Sign
 $9F9B DEFB $BB
@label=Ending_Text_One_Hundred
 $9F9C DEFM "100"," "+$80                    ; "100 "
@label=Ending_Text_Of
 $9FA0 DEFM "OF"," "+$80                     ; "OF "

; Print Completion Percentage
;
; Used by the routine at #R$95DE.
; .
; Prints YOU HAVE COMPLETED, the percentage of the Underwurlde that has
; been explored, and OF THE UNDERWURLDE.
; .
; The percentage comes from the room visit table at #R$6000. The first byte of
; each of the first #N$0240 pairs of bytes is non-zero if the room has been
; visited, and the number of those is the count. The count is multiplied by
; #N$20 and has #N$80 added, so that its high byte is the count divided by eight
; and rounded. The division routine at #R$AC75 then divides that by
; #N$00C0 after multiplying it by #N$0100, which makes the result about one
; sixth of the count. The result is held as two BCD digits in #R$8EF8.
; .
; The count and the result are also stored at #N$5E00, #N$5E02 and #N$5E04,
; which nothing reads.
; .
; With #N$0240 entries the result can not be more than 96, so the text 100 is
; never printed.
; .
; #PUSHS #UDGTABLE(default,centre)
; { =h Before | =h After #R$9FA3 }
; { #SIM(start=$9052,stop=$9078,clear=1,sp=$5B40)
; #SIM(start=$91C0,stop=$91E5,sp=$5B40)
; #POKES$6000,$01,$0480,$01
; #SIM(start=$95DE,stop=$95E1,sp=$5B40)
; #SCR$01(percentage-before)
; | #SIM(start=$95E1,stop=$95E4,sp=$5B40)
; #SCR$01(percentage-after) } UDGTABLE# #POPS
@label=Print_Completion_Percentage
c$9FA3 LD DE,$9F88   ; Point at the text YOU HAVE COMPLETED (#R$9F88).
 $9FA6 LD HL,$4838   ; Set the x position to #N$38 and the y position to #N$48
                     ; (#N$4838).
 $9FA9 CALL $91B0    ; Print the text.
 $9FAC LD DE,$9FA0   ; Point at the text OF (#R$9FA0).
 $9FAF LD HL,$7878   ; Set the x position to #N$78 and the y position to #N$78
                     ; (#N$7878).
 $9FB2 CALL $91B0    ; Print the text.
 $9FB5 LD DE,$9F61   ; Point at the text THE UNDERWURLDE (#R$9F61).
 $9FB8 LD HL,$9048   ; Set the x position to #N$48 and the y position to #N$90
                     ; (#N$9048).
 $9FBB CALL $91B0    ; Print the text.
; Count the rooms that have been visited.
 $9FBE LD HL,$6000   ; Point at the room visit table (#R$6000).
 $9FC1 LD DE,$0000   ; Set the count to #N$0000.
 $9FC4 LD BC,$4003   ; #REGbc=#N$4003 (#REGb is #N$40 and #REGc is #N$03, which gives #N$40
                     ; passes of the loop and then #N$0100 twice).
@label=Count_Visited_Rooms
*$9FC7 LD A,(HL)     ; Fetch the first byte of an entry.
 $9FC8 INC HL        ; Move on to the second byte of the entry.
 $9FC9 INC HL        ; Move on to the next entry.
 $9FCA AND A         ; {Jump to #R$9FCE if the room has not been visited.
 $9FCB JR Z,$9FCE    ; }
 $9FCD INC DE        ; Add one to the count.
@label=Print_Completion_Percentage_Next_Room
*$9FCE DJNZ $9FC7    ; Decrease the inner room counter and loop back until it
                     ; is zero.
 $9FD0 DEC C         ; {Decrease the outer room counter and loop back until every entry of
 $9FD1 JR NZ,$9FC7   ; the room visit table has been checked.}
; Work out the percentage.
 $9FD3 LD ($5E00),DE ; Store the count (nothing reads it).
 $9FD7 LD HL,$00C0   ; Set the divisor to #N$00C0.
 $9FDA EX DE,HL      ; Exchange the registers so that #REGde holds the divisor and #REGhl
                     ; the count.
 $9FDB ADD HL,HL     ; {Multiply the count by #N$20.
 $9FDC ADD HL,HL     ;
 $9FDD ADD HL,HL     ;
 $9FDE ADD HL,HL     ;
 $9FDF ADD HL,HL     ; }
 $9FE0 LD BC,$0080   ; Set the amount to add for rounding to #N$0080.
 $9FE3 ADD HL,BC     ; Add #N$80 to round the result.
 $9FE4 CALL $AC75    ; Divide the high byte by #REGde (see above).
 $9FE7 LD ($5E02),HL ; Store the result (nothing reads it).
 $9FEA LD A,L        ; Fetch the result.
 $9FEB CP $64        ; {Jump to #R$A016 if the result is 100 (#N$64) or more.
 $9FED JR NC,$A016   ; }
 $9FEF XOR A         ; {Set the percentage counter to the result and clear the BCD
 $9FF0 LD B,L        ; percentage.}
 $9FF1 INC B         ; Add one to the loop counter, as the loop is entered at
                     ; the end.
 $9FF2 JR $9FF7      ; Jump to #R$9FF7 to start the loop.
@label=Print_Completion_Percentage_Convert_Loop
*$9FF4 ADD A,$01     ; Add one.
 $9FF6 DAA           ; Adjust the result to a BCD value.
@label=Print_Completion_Percentage_Convert_Check
*$9FF7 DJNZ $9FF4    ; Decrease the percentage counter and loop back until the percentage
                     ; has been converted to BCD.
 $9FF9 LD ($8EF8),A  ; Store the percentage.
 $9FFC LD ($5E04),A  ; Store the percentage again (nothing reads it).
 $9FFF LD HL,$6070   ; Set the x position to #N$70 and the y position to #N$60
                     ; (#N$6070).
 $A002 CALL $ADF8    ; Convert the position into a screen address.
 $A005 LD DE,$8EF8   ; Point at the percentage (#R$8EF8).
 $A008 LD B,$01      ; Set the number of digits to print to #N$01.
 $A00A CALL $9E32    ; Print the digits.
@label=Print_Percent_Sign
*$A00D LD DE,$9F9B   ; Point at the percent sign (#R$9F9B).
 $A010 LD HL,$6088   ; Set the x position to #N$88 and the y position to #N$60
                     ; (#N$6088).
 $A013 JP $91B0      ; Jump to #R$91B0 to print the percent sign.
@label=Print_Completion_Percentage_Print_100
*$A016 LD DE,$9F9C   ; Point at the text 100 (#R$9F9C).
 $A019 LD HL,$6068   ; Set the x position to #N$68 and the y position to #N$60
                     ; (#N$6068).
 $A01C CALL $91B0    ; Print the text.
 $A01F JR $A00D      ; Jump to #R$A00D to print the percent sign.

; Draw Lives
;
; Used by the routine at #R$91C0.
; .
; Draws a small Sabreman icon and prints the number of lives left (see
; #R$8EDA) at the top right of the screen. The entry at #R$A02F only
; prints the number of lives.
; .
; #PUSHS #UDGTABLE(default,centre)
; { =h Before | =h After #R$A021 }
; { #SIM(start=$9052,stop=$9078,clear=1,sp=$5B40)
; #SIM(start=$91C0,stop=$91D9,sp=$5B40)
; #SCR$02,$18,$00,$08,$02(lives-before)
; | #SIM(start=$91D9,stop=$91DC,sp=$5B40)
; #SCR$02,$18,$00,$08,$02(lives-after) } UDGTABLE# #POPS
@label=Draw_Lives
c$A021 PUSH IX       ; Stash #REGix on the stack.
 $A023 LD IX,$A03D   ; Point at the object record of the icon (#R$A03D).
 $A027 CALL $962A    ; Draw the icon.
 $A02A CALL $9867    ; Colour the icon.
 $A02D POP IX        ; Restore #REGix from the stack.
; This entry point is used by the routines at #R$E7AD and #R$E7E3.
@label=Draw_Lives_Print_Number
*$A02F LD HL,$08F0   ; Set the x position to #N$F0 and the y position to #N$08
                     ; (#N$08F0).
 $A032 CALL $ADF8    ; Convert the position into a screen address.
 $A035 LD DE,$8EDA   ; Point at the number of lives (#R$8EDA).
 $A038 LD B,$01      ; Set the number of digits to print to #N$01.
 $A03A JP $9E32      ; Jump to #R$9E32 to print the digits.

; Extra Life Icon Record
;
; The object record of the little Sabreman icon that is drawn next to the
; number of lives by #R$A021.
@label=Extra_Life_Icon_Record
b$A03D DEFB $7F      ; Sprite id of the icon (#N$7F).
 $A03E DEFB $E0      ; X position.
 $A03F DEFB $00      ; Room x.
 $A040 DEFB $0F      ; Y position.
 $A041 DEFB $00      ; Room y.
 $A042 DEFB $47      ; Attribute: #COLOUR(#PEEK(#PC)).
 $A043 DEFB $00,$00  ; Unused.

; Add Points To Score
;
; Used by the routines at #R$DF42 and #R$E751.
; .
; Adds to the score (see #R$8EF3) and prints the new score at the top of
; the screen.
; .
; The amount is a pair of BCD bytes: #REGb holds the hundreds and #REGc the
; units. One is taken off #REGc before it is added, so when #REGc is not zero
; the score goes up by #REGb hundreds plus #REGc minus one. When #REGc is #N$00
; it goes up by #REGb hundreds plus 99.
; .
; #PUSHS #UDGTABLE(default,centre)
; { =h Before | =h After #R$A045 }
; { #SIM(start=$9052,stop=$9078,clear=1,sp=$5B40)
; #SIM(start=$91C0,stop=$91E5,sp=$5B40)
; #SCR$02,$00,$00,$20,$02(add-points-before)
; | #SIM(start=$A045,stop=$0000,bc=$0150,sp=$5B40)
; #SCR$02,$00,$00,$20,$02(add-points-after) } UDGTABLE# #POPS
;
; B Hundreds to add, as two BCD digits
; C Units to add, as two BCD digits (see above)
@label=AddPointsToScore
c$A045 LD HL,$8EF5   ; Point at the low byte of the score (#R$8EF5).
 $A048 XOR A         ; Clear #REGa (which also clears the carry flag).
 $A049 LD A,C        ; Fetch the low byte of the amount.
 $A04A DEC A         ; {Subtract one, in BCD.
 $A04B DAA           ; }
 $A04C ADD A,(HL)    ; {Add the low byte of the score and adjust the result to
 $A04D DAA           ; a BCD value.}
 $A04E LD (HL),A     ; Store the new low byte of the score.
 $A04F DEC HL        ; Move on to the middle byte of the score.
 $A050 LD A,(HL)     ; Fetch the middle byte of the score.
 $A051 ADC A,B       ; Add the high byte of the amount and the carry.
 $A052 DAA           ; Adjust the result to a BCD value.
 $A053 LD (HL),A     ; Store the new middle byte of the score.
 $A054 DEC HL        ; Move on to the high byte of the score.
 $A055 LD A,(HL)     ; Fetch the high byte of the score.
 $A056 ADC A,$00     ; Add the carry.
 $A058 DAA           ; Adjust the result to a BCD value.
 $A059 LD (HL),A     ; Store the new high byte of the score.
 $A05A LD HL,$0030   ; Set the x position to #N$30 and the y position to #N$00
                     ; (#N$0030).
 $A05D LD DE,$8EF3   ; Point at the score (#R$8EF3).
 $A060 LD B,$03      ; Set the number of digits to print to #N$03.
 $A062 CALL $ADF8    ; Convert the position into a screen address.
 $A065 JP $9E32      ; Jump to #R$9E32 to print the digits.
; View the equivalent code in;
; #LIST
; { #ATICATAC$A19C }
; { #COOKIE$7415 }
; { #JETPAC$70F9 }
; { #LUNARJETMAN$899C }
; { #PSSST$737A }
; { #SABREWULF$B5A9 }
; { #TRANZAM$6046 }
; LIST#

; Sounds: Click
;
; Used by the routines at #R$A0E4, #R$A0F5 and #R$A107.
; .
; Plays a tone on the speaker by switching it on and off. Each cycle is a
; wait of the half period with the speaker on and the same wait with the speaker
; off.
; .
; The entry at #R$A06A plays the number of cycles that is in #REGc. The
; code that follows plays other tones by loading #REGbc and jumping to that
; entry.
; .
; Writing #N$10 to port #N$FE sets the speaker bit and leaves the border black.
;
; B Half period of the tone
@label=SoundsClick
c$A068 LD C,$01      ; #REGc=#N$01 (one cycle).
; This entry point is used by the routines at #R$A07D, #R$A087, #R$A0AC,
; #R$A0C5 and #R$A173.
; .
; Play #REGc cycles of the tone.
@label=SoundsBeep
*$A06A LD A,$10      ; {Switch the speaker on.
 $A06C OUT ($FE),A   ; }
 $A06E PUSH BC       ; Stash the half period on the stack, as the wait counts #REGb down to
                     ; zero.
@label=SoundsBeep_Speaker_On_Wait
*$A06F DJNZ $A06F    ; Wait for the half period of the tone by counting down to
                     ; zero.
 $A071 POP BC        ; Restore the half period from the stack.
 $A072 PUSH BC       ; Stash the half period on the stack again.
 $A073 XOR A         ; {Switch the speaker off.
 $A074 OUT ($FE),A   ; }
@label=SoundsBeep_Speaker_Off_Wait
*$A076 DJNZ $A076    ; Wait for the other half of the period by counting down
                     ; to zero.
 $A078 POP BC        ; Restore the half period from the stack.
 $A079 DEC C         ; {Decrease the cycle counter and loop back until all of the cycles
 $A07A JR NZ,$A06A   ; have been played.}
 $A07C RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$A3A8 }
; LIST#

; Play Low Tone
;
; Used by the routines at #R$A6A6 and #R$A925.
; .
; Plays a tone of #N$40 cycles with a half period of #N$40.
; #HTML(#AUDIO0(low-tone.wav)(#INCLUDE(LowTone)))
@label=Play_Low_Tone
c$A07D LD BC,$4040   ; #REGbc=#N$4040 (half period #N$40, #N$40 cycles).
 $A080 JR $A06A      ; Jump to #R$A06A to play the tone.

; Unused
;
; Never reached, as nothing jumps here. Plays a tone of #N$80 cycles with
; a half period of #N$20.
@label=Unused_Play_Tone_A082
u$A082 LD BC,$2080   ; #REGbc=#N$2080 (half period #N$20, #N$80 cycles).
 $A085 JR $A06A      ; Jump to #R$A06A to play the tone.

; Play Alternating Tone
;
; Used by the routine at #R$A433.
; .
; Plays a short tone on one call in every four. Each call adds one to the
; sound counter (see #R$8EF6) and it returns at once unless the two low bits of
; the counter are zero. When it does play, it uses a half period of #N$40 if bit
; 2 of the counter is set and #N$60 if it is clear, and plays four cycles.
; #HTML(#AUDIO0(footstep-sound.wav)(#INCLUDE(FootstepSound)))
@label=Play_Alternating_Tone
c$A087 LD HL,$8EF6   ; Point at the sound counter (#R$8EF6).
 $A08A INC (HL)      ; Add one to the counter.
 $A08B LD A,(HL)     ; Fetch the counter.
 $A08C AND %00000011 ; Keep only the two low bits of the sound counter.
 $A08E RET NZ        ; Return unless the sound counter is a multiple of four.
 $A08F BIT 2,(HL)    ; {Jump to #R$A098 if bit 2 of the counter is clear.
 $A091 JR Z,$A098    ; }
 $A093 LD BC,$4004   ; #REGbc=#N$4004 (half period #N$40, four cycles).
 $A096 JR $A06A      ; Jump to #R$A06A to play the tone.
@label=Play_Alternating_Tone_Lower
*$A098 LD BC,$6004   ; #REGbc=#N$6004 (half period #N$60, four cycles).
 $A09B JR $A06A      ; Jump to #R$A06A to play the tone.

; Unused
;
; Never reached, as nothing jumps here. Plays a tone of #N$60 cycles with
; a half period of #N$80.
@label=Unused_Play_Tone_A09D
u$A09D LD BC,$8060   ; #REGbc=#N$8060 (half period #N$80, #N$60 cycles).
 $A0A0 JR $A06A      ; Jump to #R$A06A to play the tone.

; Unused
;
; Never reached, as nothing jumps here. Sets up a sound object of type
; #N$89 with a count of #N$10 in the fifth of the small object records (see
; #R$902A). The routine at #R$A0AC handles that type of object. The entry at
; #R$A0A5 sets up a sound object with the type in #REGb and the count
; in #REGc.
;
; B Type of the sound object (at #N$A0A5)
; C Count of the sound object (at #N$A0A5)
@label=Unused_Start_Sound_Object_89
u$A0A2 LD BC,$8910   ; #REGbc=#N$8910 (type #N$89, count #N$10).
@label=Unused_Set_Sound_Object
 $A0A5 LD HL,$904A   ; #REGhl=#R$904A (the fifth small object record).
 $A0A8 LD (HL),B     ; Store the type of the object.
 $A0A9 INC HL        ; Move on to the count.
 $A0AA LD (HL),C     ; Store the count of the object.
 $A0AB RET           ; Return.

; Sound Effect
;
; Handler for the object type #N$89, a sound object. Byte #N$01 of the
; object is a count, which it decreases. When the count reaches zero the object
; is removed. Until then it plays a tone of as many cycles as the count, with a
; half period of the count exclusive ORed with #N$43, so the pitch changes as
; the count falls.
; No object of this type is ever created (see #R$A0A2), so the game never
; plays this sound.
; #HTML(#AUDIO0(touching.wav)(#INCLUDE(Touching)))
;
; IX Object record
@label=SoundEffect
c$A0AC DEC (IX+$01)    ; {Decrease the count of the sound and jump to #R$A0BB if it has run
 $A0AF JR Z,$A0BB      ; out.}
 $A0B1 LD A,(IX+$01)   ; Fetch the count of the sound.
 $A0B4 LD C,A          ; Use it as the number of cycles.
 $A0B5 XOR %01000011   ; Combine the count with #N$43 to make the half period.
 $A0B7 LD B,A          ; Store the half period in #REGb.
 $A0B8 JP $A06A        ; Jump to #R$A06A to play the tone.
; This entry point is used by the routine at #R$A0C5.
; .
; Remove the object.
@label=ClearSound
*$A0BB LD (IX+$00),$00 ; Set the type of the object to #N$00.
 $A0BF RET             ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$A3EF }
; LIST#

; Unused
;
; Never reached, as nothing jumps here. Sets up a sound object of type
; #N$8A with a count of #N$0A (see #R$A0A2).
@label=Unused_Start_Sound_Object_8A
u$A0C0 LD BC,$8A0A   ; #REGbc=#N$8A0A (type #N$8A, count #N$0A).
 $A0C3 JR $A0A5      ; Jump to #R$A0A5 to set up the object.

; Sound Effect Next Note
;
; Handler for the object type #N$8A, a sound object. Byte #N$01 of the
; object is a count, which it decreases. When the count reaches zero the object
; is removed. Until then it plays a tone of as many cycles as the count, with a
; half period that is made from the count rotated left three times, inverted and
; exclusive ORed with #N$40.
; No object of this type is ever created (see #R$A0C0), so the game never
; plays this sound.
; #HTML(#AUDIO0(enter-room.wav)(#INCLUDE(EnterRoom)))
;
; IX Object record
@label=SoundEffectNext
c$A0C5 DEC (IX+$01)  ; {Decrease the count of the sound and jump to #R$A0BB if it has run
 $A0C8 JR Z,$A0BB    ; out.}
 $A0CA LD A,(IX+$01) ; Fetch the count of the sound.
 $A0CD LD C,A        ; Use it as the number of cycles.
 $A0CE RLCA          ; {Rotate the count left three times.
 $A0CF RLCA          ;
 $A0D0 RLCA          ; }
 $A0D1 CPL           ; Invert the bits.
 $A0D2 XOR %01000000 ; Flip bit 6 to make the half period.
 $A0D4 LD B,A        ; Store the half period in #REGb.
 $A0D5 JP $A06A      ; Jump to #R$A06A to play the tone.
; View the equivalent code in;
; #LIST
; { #ATICATAC$A408 }
; LIST#

; Unused
;
; Never reached, as nothing jumps here. Plays #N$0C tones of one cycle
; each. The half period is the counter rotated right by one bit.
@label=Unused_Play_Falling_Tones
u$A0D8 LD D,$0C      ; #REGd=#N$0C (the number of tones).
@label=Unused_Play_Falling_Tones_Loop
*$A0DA LD A,D        ; Fetch the counter.
 $A0DB RRCA          ; Rotate it right.
 $A0DC LD B,A        ; Use the result as the half period.
 $A0DD CALL $A068    ; Play the tone.
 $A0E0 DEC D         ; {Decrease the tone counter and loop back until all of the tones have
 $A0E1 JR NZ,$A0DA   ; been played.}
 $A0E3 RET           ; Return.

; Sounds: Sword
;
; Used by the routines at #R$A5F1 and #R$E751.
; .
; Plays #N$10 tones of one cycle each. The half period of each tone is the
; counter multiplied by #N$10 and exclusive ORed with #N$1C.
; #HTML(#AUDIO0(sword.wav)(#INCLUDE(Sword)))
@label=SoundsSword
c$A0E4 LD D,$10      ; Set the number of tones to #N$10.
@label=SoundsSword_Loop
*$A0E6 LD A,D        ; Fetch the tone counter, which is used to work out the half period of
                     ; the tone.
 $A0E7 RLCA          ; {Rotate it left twice.
 $A0E8 RLCA          ; }
 $A0E9 XOR %00000111 ; Flip the low three bits.
 $A0EB RLCA          ; {Rotate it left twice again, which makes the half
 $A0EC RLCA          ; period.}
 $A0ED LD B,A        ; Store the half period in #REGb.
 $A0EE CALL $A068    ; Play the tone.
 $A0F1 DEC D         ; {Decrease the tone counter and loop back until all of the tones have
 $A0F2 JR NZ,$A0E6   ; been played.}
 $A0F4 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$A427 }
; LIST#

; Play Position Sound
;
; Used by the routine at #R$E285.
; .
; Plays #N$08 tones of one cycle each. The half period of each tone
; depends on the y position of the object: it is made from the counter added to
; the y position, keeping the low four bits, inverted and rotated left.
; #HTML(#AUDIO0(contact-sound.wav)(#INCLUDE(ContactSound)))
;
; IX Object record
@label=Play_Position_Sound
c$A0F5 LD D,$08       ; Set the number of tones to #N$08.
@label=Play_Position_Sound_Loop
*$A0F7 LD A,D         ; Fetch the tone counter.
 $A0F8 ADD A,(IX+$03) ; Add the y position of the object, so that the pitch depends on its
                      ; position.
 $A0FB AND %00001111  ; Keep only the low four bits.
 $A0FD CPL            ; Invert the bits.
 $A0FE RLCA           ; Rotate the result left.
 $A0FF LD B,A         ; Use the result as the half period.
 $A100 CALL $A068     ; Play the tone.
 $A103 DEC D          ; {Decrease the tone counter and loop back until all of the tones have
 $A104 JR NZ,$A0F7    ; been played.}
 $A106 RET            ; Return.

; Sounds: Weapon Pop
;
; Used by the routine at #R$DF42.
; .
; Handler for the object type #N$8B, which is also called directly to make
; a sound. It plays a run of tones of one cycle each, and the pitch of each one
; is made from a counter that falls by two each time.
; .
; The counter starts at the low byte of the frame counter plus one with its
; nibbles swapped, with the low four bits set and bit 7 cleared, so the sound is
; not always the same length. The half period is the counter exclusive ORed with
; #N$20 and rotated left.
; #HTML(#AUDIO0(weapon-pop.wav)(#INCLUDE(WeaponPop)))
;
; IX Object record
@label=SoundsWeaponPop
c$A107 LD A,($5C78)  ; Fetch the low byte of the frame counter.
 $A10A INC A         ; Add one.
 $A10B RLCA          ; {Rotate the result left four times, which swaps the
 $A10C RLCA          ; nibbles.
 $A10D RLCA          ;
 $A10E RLCA          ; }
 $A10F OR %00001111  ; Set the low four bits.
 $A111 AND %01111111 ; Clear bit 7.
 $A113 LD D,A        ; Store the result as the tone counter.
@label=SoundsWeaponPop_Loop
*$A114 LD A,D        ; Fetch the tone counter.
 $A115 XOR %00100000 ; Flip bit 5.
 $A117 RLCA          ; Rotate the result left to make the half period.
 $A118 LD B,A        ; Store the half period in #REGb.
 $A119 CALL $A068    ; Play the tone.
 $A11C DEC D         ; {Decrease the tone counter and return if all of the tones have been
 $A11D RET Z         ; played.}
 $A11E DEC D         ; {Decrease the tone counter again and return if all of the tones have
 $A11F RET Z         ; been played.}
 $A120 JR $A114      ; Jump back to play the next tone.
; View the equivalent code in;
; #LIST
; { #ATICATAC$A445 }
; LIST#

; Unused
;
; Never reached, as nothing jumps here. Plays #N$10 cycles of a tone whose
; half period is made from byte #N$06 of the object: it is inverted, rotated
; left and cut down to the low six bits, and then bit 6 is set.
;
; IX Object record
@label=Unused_Play_Object_Tone
u$A122 LD A,(IX+$06) ; Fetch byte #N$06 of the object.
 $A125 CPL           ; Invert the bits.
 $A126 RLCA          ; Rotate it left.
 $A127 AND %00111111 ; Keep only the low six bits.
 $A129 OR %01000000  ; Set bit 6.
 $A12B LD B,A        ; Use the result as the half period.
 $A12C LD C,$10      ; #REGc=#N$10 (the number of cycles).
 $A12E JP $A06A      ; Jump to #R$A06A to play the tone.

; Sounds: Door
;
; Used by the routine at #R$DEDA.
; .
; Makes a burst of noise by sending the bits of the first #N$30 bytes of
; the ROM to the speaker. Bit 4 of the port is the speaker bit. The byte is
; rotated right before each of the eight writes, so every bit of it is sent to
; the speaker in turn.
; #HTML(#AUDIO0(door.wav)(#INCLUDE(Door)))
@label=SoundsDoor
c$A131 LD BC,$0830   ; #REGbc=#N$0830 (#REGb counts the bits of a byte and #REGc counts
                     ; #N$30 bytes).
 $A134 LD HL,$0000   ; Point at the start of the ROM (#N$0000).
@label=SoundsDoor_Byte
*$A137 LD E,(HL)     ; Fetch a byte of the ROM.
 $A138 INC HL        ; Move on to the next byte.
 $A139 PUSH BC       ; Stash the counters on the stack.
@label=SoundsDoor_Bit
*$A13A RRC E         ; Rotate the byte right.
 $A13C LD A,E        ; Copy it to #REGa.
 $A13D AND %00010000 ; Keep only the speaker bit.
 $A13F OUT ($FE),A   ; Send it to the speaker.
 $A141 DJNZ $A13A    ; Decrease the bit counter and loop back until all eight bits are
                     ; sent.
 $A143 POP BC        ; Restore the counters from the stack.
 $A144 DEC C         ; {Decrease the byte counter and loop back until all of the bytes have
 $A145 JR NZ,$A137   ; been sent.}
 $A147 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$A46E }
; LIST#

; Unused
;
; Never reached, as nothing jumps here. Sets up a sound object of type
; #N$A0 with a count of #N$10 (see #R$A0A2). There is no handler for that type.
@label=Unused_Start_Sound_Object_A0
u$A148 LD BC,$A010   ; #REGbc=#N$A010 (type #N$A0, count #N$10).
 $A14B JP $A0A5      ; Jump to #R$A0A5 to set up the object.

; Unused
;
; Never reached, as nothing jumps here. It would be a handler for a sound
; object, like #R$A0AC. It decreases byte #N$01 of the object and removes the
; object once the count has gone below zero. Until then it uses the count as an
; index into the table at #R$A163 to get the half period, and plays eight
; cycles.
;
; IX Object record
@label=Unused_Handle_Sound_Object
u$A14E DEC (IX+$01)  ; Decrease the count.
 $A151 JP M,$A0BB    ; Jump to #R$A0BB if the count has gone below zero.
 $A154 LD C,(IX+$01) ; Fetch the count.
 $A157 LD B,$00      ; #REGb=#N$00.
 $A159 LD HL,$A163   ; #REGhl=#R$A163 (the table of half periods).
 $A15C ADD HL,BC     ; Add the count to the address of the table.
 $A15D LD B,(HL)     ; Fetch the half period.
 $A15E LD C,$08      ; #REGc=#N$08 (the number of cycles).
 $A160 JP $A06A      ; Jump to #R$A06A to play the tone.

; Unused Tone Table
;
; Sixteen half periods, indexed by the count of a sound object. They are
; only used by the unused code at #R$A14E.
@label=Unused_Tone_Table
b$A163 DEFB $80,$90,$80,$90,$80,$90,$80,$90
 $A16B DEFB $80,$70,$60,$50,$40,$30,$20,$10

; Sounds: Bounce
;
; Used by the routine at #R$DEB8.
; .
; Plays four cycles of a tone with a half period of #N$E7, which is a low
; pitch. The counter in #REGd is set to #N$40, and the tone is made from the
; counter after one has been taken off it.
; .
; The routine jumps to the tone player, which returns to the caller.
; #HTML(#AUDIO0(bounce.wav)(#INCLUDE(Bounce)))
@label=SoundsBounce
c$A173 LD D,$40      ; #REGd=#N$40 (the counter).
 $A175 DEC D         ; {Decrease the tone counter and return if it is zero (this does not
 $A176 RET Z         ; happen when the routine is entered at the start).}
 $A177 LD A,D        ; Fetch the counter.
 $A178 RRCA          ; {Rotate the counter right three times.
 $A179 RRCA          ;
 $A17A RRCA          ; }
 $A17B LD B,A        ; Use the result as the half period.
 $A17C LD C,$04      ; Set the number of cycles to #N$04.
 $A17E JP $A06A      ; Jump to #R$A06A to play the tone.
; View the equivalent code in;
; #LIST
; { #ATICATAC$A4B0 }
; { #TRANZAM$60E3 }
; LIST#

