                                                                            ; object.
@label=First_Creature_Record
 $8FDA DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00 ; {Records
 $8FEA DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00 ; 14 to 17:
 $8FFA DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00 ; the four
 $900A DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00 ; creatures.
                                                                            ; }
 $901A DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00 ; Record 18.

; Small Object Records
;
; Five records of #N$08 bytes each. They are handled in the same way as
; the larger records, after all of those have been handled (see #R$9459).
; .
; The first four are the weapons that Sabreman can pick up. #R$E8BE copies their
; starting positions from #R$E9FD at the start of the game.
@label=Small_Object_Records
g$902A DEFB $00,$00,$00,$00,$00,$00,$00     ; Records 0 to 3: the four weapons.
                                            ; This is the first.
@label=Small_Object_Record_0_Redraw_Flags
 $9031 DEFB $00                             ; The redraw flags of the first
                                            ; weapon.
 $9032 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; {The other three weapons.
 $903A DEFB $00,$00,$00,$00,$00,$00,$00,$00 ;
 $9042 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; }
@label=Small_Object_Record_4
 $904A DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; Record 4.

; Select Game Options
;
; Used by the routine at #R$7680.
; .
; Sets up the game selection screen and waits for the player to choose a
; control method and start the game.
; .
; The method is chosen with the keys 1 to 4 (see #R$9119) and is stored in
; #R$8ED5. Pressing 0 starts the game at #R$91C0.
; .
; Everything from #R$8ED5 up to #R$9052 is cleared first, so this routine also
; gives every object record and every game variable its starting value of zero.
;
; .
;
; Set the border to black, build the shift tables and clear the game
; variables, the object records and the attributes.
@label=Select_Game_Options
c$9052 XOR A         ; {Set the border to black by writing #N$00 to port #N$FE.
 $9053 OUT ($FE),A   ; }
 $9055 CALL $9613    ; Build the shift tables used to draw the sprites.
 $9058 LD HL,$8ED5   ; Point at the start of the game variables (#R$8ED5).
 $905B LD BC,$017D   ; Set the number of bytes to #N$017D, which reaches
                     ; #R$9052.
 $905E CALL $9569    ; Fill the variables and the object records with zero.
 $9061 LD HL,$5800   ; Point at the start of the attribute buffer (#N$5800).
 $9064 LD BC,$0300   ; Set the size of the attribute buffer to #N$0300.
 $9067 CALL $9569    ; Set every attribute to black ink on black paper.
; This entry point is used by the routine at #R$95DE.
@label=Select_Game_Options_Restart
*$906A CALL $957D    ; Clear the screen.
 $906D CALL $9588    ; Clear the second byte of every room in the world map.
 $9070 CALL $E8BE    ; Choose where the four weapons are hidden.
 $9073 LD A,$06      ; {Set the number of lives to #N$06.
 $9075 LD ($8EDA),A  ; }
; Draw the selection menu and the icons, and read the keys 1 to 4.
@label=Select_Game_Options_Loop
*$9078 CALL $90E4    ; Draw the five lines of the menu, the title and the copyright
                     ; message.
 $907B CALL $95A3    ; Draw the icons next to the menu lines.
 $907E LD A,$F7      ; {Read from the keyboard;
 $9080 OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $9082 IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$F7 | 1 | 2 | 3 | 4 | 5 }
                     ; TABLE#}
 $9084 CPL           ; Flip the bits so that a pressed key gives a set bit.
 $9085 LD E,A        ; Keep the state of the keys for the tests below.
 $9086 LD A,($8ED5)  ; Fetch the control method from #R$8ED5.
; Key 1 selects the keyboard (#N$00).
 $9089 BIT 0,E       ; {Jump to #R$908F if key 1 is not pressed.
 $908B JR Z,$908F    ; }
 $908D AND %11111100 ; Clear the control method bits (bits 0 and 1).
; Key 2 selects a Kempston joystick (#N$01).
@label=Select_Game_Options_Test_Key_2
*$908F BIT 1,E       ; {Jump to #R$9097 if key 2 is not pressed.
 $9091 JR Z,$9097    ; }
 $9093 AND %11111100 ; Clear the control method bits (bits 0 and 1).
 $9095 OR %00000001  ; Set the control method to #N$01.
; Key 3 selects a cursor joystick (#N$02).
@label=Select_Game_Options_Test_Key_3
*$9097 BIT 2,E       ; {Jump to #R$909F if key 3 is not pressed.
 $9099 JR Z,$909F    ; }
 $909B AND %11111100 ; Clear the control method bits (bits 0 and 1).
 $909D OR %00000010  ; Set the control method to #N$02.
; Key 4 selects an Interface II joystick (#N$03).
@label=Select_Game_Options_Test_Key_4
*$909F BIT 3,E       ; {Jump to #R$90A7 if key 4 is not pressed.
 $90A1 JR Z,$90A7    ; }
 $90A3 AND %11111100 ; Clear the control method bits (bits 0 and 1).
 $90A5 OR %00000011  ; Set the control method to #N$03.
; Store the control method and test key 0 which starts the game.
@label=Select_Game_Options_Store_Method
*$90A7 LD D,A        ; Keep the control method while the keys are read.
 $90A8 LD A,$EF      ; {Read from the keyboard;
 $90AA OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $90AC IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$EF | 0 | 9 | 8 | 7 | 6 }
                     ; TABLE#}
 $90AE CPL           ; Flip the bits so that a pressed key gives a set bit.
 $90AF LD E,A        ; Keep the state of the keys for the test below.
 $90B0 LD A,D        ; {Store the control method in #R$8ED5.
 $90B1 LD ($8ED5),A  ; }
 $90B4 LD C,A        ; Keep the control method while key 0 is tested.
 $90B5 BIT 0,E       ; {Jump to #R$91C0 if key 0 is pressed.
 $90B7 JP NZ,$91C0   ; }
; Highlight the line of the chosen control method and go round again.
 $90BA LD HL,$9119   ; Point at the attributes of the menu lines (#R$9119).
 $90BD LD B,$04      ; Set the number of control methods to #N$04.
 $90BF LD A,C        ; Fetch the control method as the number of the chosen
                     ; line.
 $90C0 CALL $90C6    ; Flash the attribute of the chosen line.
 $90C3 JP $9078      ; Jump back to #R$9078.

; Highlight Selected Option
;
; Used by the routine at #R$9052.
; .
; Flashes the menu line of the chosen control method and stops the other
; lines from flashing. It does this by setting or resetting bit 7 (FLASH) of
; each of the line attributes that start at #REGhl.
; .
; The two small routines at #R$90D9 and #R$90E0 reset or set the bit for one
; line and move on to the next one. The loop is entered again at
; #R$90C6(#N$90C8) with the zero flag set by the #REGa decrease at
; #R$90CD.
;
; A Control method
; B Number of control methods (#N$04)
; HL Address of the attribute of the first line
@label=Highlight_Selected_Option
c$90C6 AND %00000011 ; Keep only the control method bits (bits 0 and 1).
 $90C8 JR Z,$90D1    ; Jump to #R$90D1 if this is the line of the chosen
                     ; method.
 $90CA CALL $90D9    ; Clear the flash bit of this line and move on to the next
                     ; line.
@label=Highlight_Selected_Option_Loop
*$90CD DEC A         ; Decrease the line count in #REGa (it is zero when the chosen line is
                     ; reached).
 $90CE DJNZ $90C6    ; Repeat for each of the four lines.
 $90D0 RET           ; Return.
@label=Highlight_Selected_Option_Flash_Line
*$90D1 CALL $90E0    ; Set the flash bit of this line and move on to the next
                     ; line.
 $90D4 JR $90CD      ; Jump back to #R$90CD.

; Unused
;
; Sets bit 7 of the attribute at #REGhl and moves on. Nothing calls it.
u$90D6 SET 7,(HL)    ; Set the flash bit (bit 7) of the line attribute.
 $90D8 INC HL        ; Move on to the next attribute.

; Clear Flash Attribute
;
; Used by the routine at #R$90C6.
; .
; Resets bit 7 (FLASH) of the attribute at #REGhl and moves on to the next
; attribute.
;
;   HL Address of the attribute
; O:HL Address of the next attribute
@label=Clear_Flash_Attribute
c$90D9 RES 7,(HL)    ; Reset the flash bit (bit 7) of the line attribute.
 $90DB INC HL        ; Move on to the next attribute.
 $90DC RET           ; Return.

; Unused
;
; Resets bit 7 of the attribute at #REGhl and moves on. Nothing calls it.
u$90DD RES 7,(HL)    ; Reset the flash bit (bit 7) of the line attribute.
 $90DF INC HL        ; Move on to the next attribute.

; Set Flash Attribute
;
; Used by the routine at #R$90C6.
; .
; Sets bit 7 (FLASH) of the attribute at #REGhl and moves on to the next
; attribute.
;
;   HL Address of the attribute
; O:HL Address of the next attribute
@label=Set_Flash_Attribute
c$90E0 SET 7,(HL)    ; Set the flash bit (bit 7) of the line attribute.
 $90E2 INC HL        ; Move on to the next attribute.
 $90E3 RET           ; Return.

; Game Selection Menu
;
; Used by the routine at #R$9052.
; .
; Prints the five lines of the game selection menu, the copyright message
; and the title.
; .
; The attributes of the lines are read through #REGde from #R$9119, while the y
; positions and the strings are read through #REGhl' and #REGde'.
; .
; #PUSHS #UDGTABLE(default,centre)
; { =h Game Selection Menu }
; { #SIM(start=$9052,stop=$9078,clear=1,sp=$5B40)
; #SIM(start=$9078,stop=$907B,sp=$5B40)
; #SCR$02(game-menu) } UDGTABLE# #POPS
;
; .
;
; Set up the pointers and the counter of the five lines.
@label=GameMenu
c$90E4 LD DE,$9119   ; Point at the attributes of the lines (#R$9119).
 $90E7 EXX           ; Switch to the shadow registers.
 $90E8 LD HL,$911F   ; #REGhl'=#R$911F (the y positions of the lines).
 $90EB LD DE,$9125   ; #REGde'=#R$9125 (the first string).
 $90EE LD B,$05      ; #REGb'=#N$05 (the number of lines).
@label=GameMenu_Loop
*$90F0 EXX           ; Switch to the main registers.
; Print each of the lines.
 $90F1 LD A,(DE)     ; Fetch the attribute of the line.
 $90F2 LD ($8EE8),A  ; Store it in the print attribute (#R$8EE8).
 $90F5 INC DE        ; Move on to the next attribute.
 $90F6 EXX           ; Switch to the shadow registers.
 $90F7 PUSH BC       ; Stash the counter on the stack.
 $90F8 LD A,(HL)     ; Fetch the y position of the line.
 $90F9 INC HL        ; Move on to the next y position.
 $90FA PUSH HL       ; Stash the pointer to the y positions on the stack.
 $90FB LD H,A        ; Use it as the y position of the line.
 $90FC LD L,$58      ; #REGl'=#N$58 (the x position of the lines).
 $90FE CALL $91B0    ; Print the string.
 $9101 EXX           ; Switch to the shadow registers.
 $9102 POP HL        ; Restore the pointer to the y positions.
 $9103 POP BC        ; Restore the counter.
 $9104 INC DE        ; Move on to the next string.
 $9105 DJNZ $90F0    ; Repeat for each of the lines.
; Print the copyright message and the title.
 $9107 LD HL,$B800   ; Set the x position to #N$00 and the y position to #N$B8
                     ; (#N$B800).
 $910A LD DE,$9174   ; Point at the copyright message (#R$9174).
 $910D CALL $9C3C    ; Print the copyright message.
 $9110 LD HL,$0010   ; Set the x position to #N$10 and the y position to #N$00
                     ; (#N$0010).
 $9113 LD DE,$9195   ; Point at the title (#R$9195).
 $9116 JP $9C3C      ; Jump to #R$9C3C.
; View the equivalent code in;
