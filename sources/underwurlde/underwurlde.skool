; Handle Sabreman On Rope
;
; Handler for the object types #N$01 to #N$08, which Sabreman has while he
; hangs on and swings from the rope (the type #N$17 object, see #R$AA4C). The
; sprites are the ones that are called swimming (#N$01 to #N$04 when he moves to
; the left and #N$05 to #N$08 when he moves to the right; the frame follows the
; x position).
; .
; If bit 3 or bit 6 of the redraw flags is set, he lets go at #R$A3A5.
; Otherwise the routine checks for contact with the bubbles, the creatures and
; the falling stalactite, any of which sends him to #R$E87B with
; #REGb=#N$10. Next it moves the rope with #R$AAB0 and, if he stays in
; the same room, reads the controls: a bottom row key (or the joystick fire
; button) makes him let go at #R$A3A5, and the fire key throws a
; weapon.
; .
; The position and the velocity of the end of the rope (see #R$AA93) are then
; converted to the position and the velocity of Sabreman. If the y position is
; #N$9F or more and the room has a floor, he lets go and stands on the floor at
; #R$A8C9.
;
; IX Object record of Sabreman
@label=Handle_Sabreman_On_Rope
c$A316 CALL $989F      ; Remember the position and sprite id of Sabreman (see
                       ; #R$989F).
 $A319 LD A,(IX+$0F)   ; Fetch the redraw flags of Sabreman.
 $A31C AND %01001000   ; Keep only bit 3 (the special state) and bit 6 (being
                       ; carried).
 $A31E JP NZ,$A3A5     ; Jump to #R$A3A5 and let go of the rope if either of
                       ; them is set.
 $A321 CALL $E1B4      ; Check for contact with the bubbles.
 $A324 BIT 2,C         ; {Jump to #R$A32D if Sabreman touches a bubble (bit 2 of
 $A326 JR NZ,$A32D     ; #REGc).}
 $A328 CALL $B43E      ; Check for contact with the creatures.
 $A32B BIT 2,C         ; Test bit 2 of #REGc (set if Sabreman touches one).
@label=Handle_Sabreman_On_Rope_Hit
*$A32D LD B,$10        ; Set #REGb to #N$10 (this is not changed by the contact
                       ; test above).
 $A32F JP NZ,$E87B     ; Jump to #R$E87B to knock Sabreman off the rope if he touches a
                       ; bubble or a creature.
 $A332 CALL $E833      ; Check for contact with the falling stalactite.
 $A335 BIT 2,C         ; {Jump to #R$E87B to knock Sabreman off the rope if the stalactite
 $A337 JP NZ,$E87B     ; hits him.}
 $A33A LD L,(IX+$02)   ; Fetch the room x of Sabreman.
 $A33D LD H,(IX+$04)   ; Fetch the room y of Sabreman.
 $A340 PUSH HL         ; Stash the room of Sabreman on the stack.
 $A341 CALL $AAB0      ; Move the rope (see #R$AAB0).
 $A344 POP HL          ; Restore the room that Sabreman was in before the rope
                       ; moved.
 $A345 LD E,(IX+$02)   ; Fetch the room x that Sabreman is in now.
 $A348 LD D,(IX+$04)   ; Fetch the room y that Sabreman is in now.
 $A34B AND A           ; {Compare the old room with the new room.
 $A34C SBC HL,DE       ; }
 $A34E JR NZ,$A365     ; Jump to #R$A365 if the swing of the rope has taken him to a
                       ; different room.
 $A350 CALL $AE17      ; Read the controls.
 $A353 BIT 5,A         ; {Jump to #R$A3A5 and let go of the rope if the "bottom row key" bit
 $A355 JR Z,$A3A5      ; of the controls (bit 5) is clear.}
 $A357 BIT 4,A         ; {Jump to #R$A360 if the fire key is not pressed (bit 4 of the
 $A359 JR NZ,$A360     ; controls is set).}
 $A35B CALL $B4D1      ; Throw a weapon (see #R$B4D1).
 $A35E JR $A365        ; Jump to #R$A365.
@label=Handle_Sabreman_On_Rope_Fire_Released
*$A360 LD A,$FF        ; {Set the flag for the released fire key (#R$AAAB) to
 $A362 LD ($AAAB),A    ; #N$FF.}
; This entry point is used by the routine at #R$A6A6.
; .
; Set the position of Sabreman from the position of the end of the rope.
@label=Set_Position_From_Rope
*$A365 LD HL,($AA95)   ; Fetch the position of the end of the rope (x position in #REGl, y
                       ; position in #REGh).
 $A368 LD DE,$F80C     ; Set the offset from the end of the rope to Sabreman (#N$0C pixels to
                       ; the left and #N$08 pixels down).
 $A36B AND A           ; {Work out the position of Sabreman from the end of the rope and stash
 $A36C SBC HL,DE       ; it on the stack.
 $A36E PUSH HL         ; }
 $A36F CALL $98CC      ; Read the world map entry of the room.
 $A372 LD A,E          ; Copy the room flags to #REGa.
 $A373 LD ($AAAC),A    ; Store the room flags in #R$AAAC.
 $A376 POP HL          ; Restore the position of Sabreman.
 $A377 LD (IX+$01),L   ; Set the x position of Sabreman.
 $A37A LD (IX+$03),H   ; Set the y position of Sabreman.
 $A37D LD A,H          ; Copy the y position of Sabreman to #REGa.
 $A37E CP $9F          ; Is Sabreman at or below the height of the floor (y
                       ; position #N$9F)?
 $A380 LD A,($AAA2)    ; Fetch the x velocity of the end of the rope.
 $A383 LD (IX+$06),A   ; Give Sabreman the x velocity of the end of the rope.
 $A386 JR C,$A38D      ; Jump to #R$A38D if Sabreman is still above the floor.
 $A388 BIT 4,E         ; {Jump to #R$A8C9 if the room has a floor and Sabreman has reached it
 $A38A JP NZ,$A8C9     ; (bit 4 of the room flags).}
@label=Handle_Sabreman_On_Rope_Choose_Frame
*$A38D LD A,L          ; Copy the x position of Sabreman to #REGa.
 $A38E RRA             ; {Divide the x position by eight (the frame of the swimming animation
 $A38F RRA             ; follows the x position).
 $A390 RRA             ; }
 $A391 AND %00000011   ; Keep only the two low bits.
 $A393 INC A           ; Add one to make a frame from #N$01 to #N$04.
 $A394 BIT 7,(IX+$06)  ; {Jump to #R$A39C if he is swinging to the left (the x velocity is
 $A398 JR NZ,$A39C     ; negative).}
 $A39A ADD A,$04       ; Add four to use the frames for swinging to the right.
@label=Handle_Sabreman_On_Rope_Set_Sprite
*$A39C LD (IX+$00),A   ; Set the sprite id.
 $A39F CALL $96CB      ; Update the sprite of the object (see #R$96CB).
 $A3A2 JP $AB54        ; Jump to #R$AB54.
; Sabreman is hit or lets go of the rope, and starts to fall from the
; position of the end of the rope. The velocities are taken from the change in
; that position and the sprite id becomes #N$15 or #N$16 (falling).
@label=Handle_Sabreman_On_Rope_Let_Go
*$A3A5 LD HL,($AA95)   ; Fetch the position of the end of the rope.
 $A3A8 LD DE,($AA97)   ; Fetch the previous position of the end of the rope.
 $A3AC LD A,H          ; Copy the y position of the end of the rope to #REGa.
 $A3AD SUB D           ; Subtract the previous y position to get how far the end of the rope
                       ; moved.
 $A3AE SLA A           ; {Multiply the movement by eight to get the y velocity.
 $A3B0 SLA A           ;
 $A3B2 SLA A           ; }
 $A3B4 LD (IX+$09),A   ; Give Sabreman the y velocity.
 $A3B7 LD A,L          ; Copy the x position of the end of the rope to #REGa.
 $A3B8 SUB E           ; Subtract the previous x position to get how far the end of the rope
                       ; moved.
 $A3B9 LD (IX+$06),A   ; Give Sabreman that as his x velocity.
 $A3BC LD A,$15        ; Use the sprite id for falling to the left (#N$15).
 $A3BE BIT 7,(IX+$06)  ; {Jump to #R$A3C6 if he is moving to the left (the x velocity is
 $A3C2 JR NZ,$A3C6     ; negative).}
 $A3C4 ADD A,$01       ; Use the sprite id for falling to the right (#N$16).
@label=Handle_Sabreman_On_Rope_Let_Go_Set_Sprite
*$A3C6 LD (IX+$00),A   ; Set the sprite id.
 $A3C9 LD (IX+$0A),$20 ; Set the countdown to #N$20.
 $A3CD LD A,(IX+$06)   ; Fetch the x velocity.
 $A3D0 OR (IX+$09)     ; Combine it with the y velocity to see if Sabreman is
                       ; moving at all.
 $A3D3 JP NZ,$A8DA     ; Jump to #R$A8DA to start him falling if Sabreman is
                       ; moving.
 $A3D6 LD (IX+$09),$10 ; Set the y velocity to #N$10 so that he falls.
 $A3DA JP $A8DA        ; Jump to #R$A8DA.

; Reset Sabreman
;
; Used by the routines at #R$91C0 and #R$E7E3.
; .
; Copies the template at #R$AA3C into the object record of Sabreman
; (#R$8F1A).
@label=Reset_Sabreman
c$A3DD LD HL,$AA3C   ; Point at the template of Sabreman (#R$AA3C).
 $A3E0 LD DE,$8F1A   ; Point at the object record of Sabreman (#R$8F1A).
 $A3E3 LD BC,$0010   ; Set the number of bytes to copy to #N$0010.
 $A3E6 LDIR          ; Copy the template into the object record of Sabreman.
 $A3E8 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$8D61 }
; { #COOKIE$64E8 }
; { #TRANZAM$6A09 }
; LIST#

; Handle Stalactite Hit
;
; Used by the routine at #R$A433.
; .
; Handles Sabreman being touched by the falling stalactite. It is entered
; from #R$A433(#N$A475) with the result of #R$E833 in #REGc. Bit 7 of
; #REGc is set when the stalactite is on the right of Sabreman or level with
; him, and bit 0 is set when it is at least #N$0A pixels away horizontally.
; .
; Sabreman is pushed away from the stalactite at a speed of #N$02. If bit 0 of
; #REGc is clear (a direct hit), the routine goes to #R$E7D0, which turns the
; sprite into the death sprite. Otherwise he starts to tumble with a jump
; upwards.
;
; C Result of the stalactite contact check
; IX Object record of Sabreman
@label=Handle_Stalactite_Hit
c$A3E9 BIT 7,C         ; {Jump to #R$A3F1 if bit 7 of the contact result is
 $A3EB JR NZ,$A3F1     ; set.}
 $A3ED LD A,$02        ; #REGa=#N$02 (move to the right).
 $A3EF JR $A3F3        ; Jump to #R$A3F3.
@label=Handle_Stalactite_Hit_Move_Left
*$A3F1 LD A,$FE        ; #REGa=#N$FE (move to the left).
@label=Handle_Stalactite_Hit_Set_Velocity
*$A3F3 LD (IX+$06),A   ; Set the x velocity.
 $A3F6 BIT 0,C         ; {Jump to #R$E7D0 if the stalactite hit him directly.
 $A3F8 JP Z,$E7D0      ; }
 $A3FB LD (IX+$00),$18 ; Set the sprite id to #N$18 (tumbling).
 $A3FF LD (IX+$09),$C0 ; Set the y velocity to #N$C0 (up).
 $A403 JP $96CB        ; Jump to #R$96CB.

; Start Tumbling
;
; Used by the routines at #R$A433, #R$A5F1, #R$A6A6 and #R$A925.
; .
; Makes Sabreman tumble. The sprite becomes #N$18 (the first of the
; tumbling frames) and the y velocity is set to #N$C0 so that he is thrown
; upwards. Bit 7 of the redraw flags is cleared.
; .
; If the x velocity is zero it is set to #N$02 or #N$FE, depending on bit 7 of
; the system variable FRAMES (#N$5C78), which makes the direction random.
; Otherwise the x velocity is negated, so that he bounces back the way he came.
;
; IX Object record of Sabreman
@label=Start_Tumbling
c$A406 LD (IX+$00),$18 ; Set the sprite id to #N$18 (tumbling).
 $A40A LD (IX+$09),$C0 ; Set the y velocity to #N$C0 (up).
 $A40E RES 7,(IX+$0F)  ; Clear bit 7 of the redraw flags.
 $A412 LD A,(IX+$06)   ; Fetch the x velocity.
 $A415 AND A           ; {Jump to #R$A42B if he is moving sideways.
 $A416 JR NZ,$A42B     ; }
 $A418 LD (IX+$06),$02 ; Set the x velocity to #N$02.
 $A41C LD A,($5C78)    ; Fetch the low byte of FRAMES.
 $A41F AND %10000000   ; Keep only bit 7.
 $A421 JP Z,$96CB      ; Jump to #R$96CB if the bit is clear.
 $A424 LD (IX+$06),$FE ; Set the x velocity to #N$FE.
 $A428 JP $96CB        ; Jump to #R$96CB.
@label=Start_Tumbling_Reverse_Velocity
*$A42B NEG             ; Negate the x velocity.
 $A42D LD (IX+$06),A   ; Set the new x velocity.
 $A430 JP $96CB        ; Jump to #R$96CB.

; Handle Sabreman Walking
;
; Handler for the object types #N$09 to #N$10, which are the walking
; sprites of Sabreman (#N$09 to #N$0C when he walks to the left and #N$0D to
; #N$10 when he walks to the right). It is also the state that he is in when he
; is standing still.
; .
; Each time it saves the object state, handles being carried off (bit 6 of the
; redraw flags), tumbling (bit 7) and the special state at #R$E8A2 (bit
; 3), checks for contact with the bubbles, the stalactite and the creatures,
; reads the controls, moves him sideways, and finally keeps him inside the room,
; moving him to the next room when he walks off the edge.
;
; IX Object record of Sabreman
;
; Clear the countdown and the contact flags. In the top part of the room
; (y position less than #N$48) the contact flags are set to #N$44, which marks
; both side walls as solid.
@label=Handle_Sabreman_Walking
c$A433 CALL $989F      ; Remember the position and sprite id of Sabreman (see
                       ; #R$989F).
 $A436 LD A,(IX+$0F)   ; Fetch the redraw flags of Sabreman.
 $A439 AND %01000000   ; Keep only bit 6 (being carried).
 $A43B JP NZ,$B72C     ; Jump to #R$B72C if Sabreman is being carried by an eagle (bit 6 of
                       ; the redraw flags is set).
 $A43E LD (IX+$0A),$00 ; Clear the countdown of Sabreman.
 $A442 LD (IX+$0B),$00 ; Clear the contact flags of Sabreman.
 $A446 LD A,(IX+$03)   ; Fetch the y position of Sabreman.
 $A449 CP $48          ; {Jump to #R$A451 if Sabreman is in the lower part of the room (y
 $A44B JR NC,$A451     ; position #N$48 or more).}
 $A44D LD (IX+$0B),$44 ; Mark the walls on both sides as solid by setting the contact flags
                       ; to #N$44, as he is in the upper part of the room.
; Check the special states.
@label=Handle_Sabreman_Walking_Check_Special_States
*$A451 BIT 7,(IX+$0F)  ; {Jump to #R$A406 if bit 7 of the redraw flags is set (Sabreman starts
 $A455 JR NZ,$A406     ; to tumble).}
 $A457 BIT 3,(IX+$0F)  ; {Jump to #R$E8A2 if bit 3 of the redraw flags is set.
 $A45B JP NZ,$E8A2     ; }
; Check for contact with the bubbles, the stalactite and the creatures.
; The result of the bubble contact check is kept in byte #N$0E of the record
; of Sabreman.
 $A45E CALL $98CC      ; Read the world map entry of the room (the room flags are returned in
                       ; #REGe).
 $A461 CALL $E1B4      ; Check for contact with the bubbles.
 $A464 LD (IX+$0E),C   ; Store the bubble contact result in byte #N$0E of the record of
                       ; Sabreman.
 $A467 CALL $E833      ; Check for contact with the falling stalactite.
 $A46A BIT 2,C         ; {Jump to #R$A478 if the stalactite does not touch him (bit 2 of #REGc
 $A46C JR Z,$A478      ; is clear).}
 $A46E BIT 2,(IX+$0E)  ; {Jump to #R$E894 to knock Sabreman down if the stalactite hit him
 $A472 JP NZ,$E894     ; while he was touching a bubble.}
 $A475 JP $A3E9        ; Jump to #R$A3E9 to handle the stalactite hit.
@label=Handle_Sabreman_Walking_Check_Creatures
*$A478 BIT 2,(IX+$0E)  ; {Jump to #R$A48C if he is touching a bubble, as the creatures are
 $A47C JR NZ,$A48C     ; only checked when he is not.}
 $A47E CALL $B43E      ; Check for contact with the creatures.
 $A481 LD A,C          ; Copy the creature contact result to #REGa.
 $A482 AND %01111111   ; Keep only bits 0 to 6 (ignore which side the creature
                       ; is on).
 $A484 CP $04          ; {Jump to #R$E272 to start tumbling downwards if a creature is
 $A486 JP Z,$E272      ; touching him from the side (the contact result is #N$04).
                       ; }
 $A489 LD (IX+$0E),C   ; Store the creature contact result in byte #N$0E of the record of
                       ; Sabreman.
; Read the controls. A clear fire bit throws a weapon, and a set fire bit
; sets the flag for the released fire key. Then bit 3 of the controls (clear)
; starts a jump, bit 0 (clear) moves him to the right and bit 1 (clear) moves
; him to the left.
@label=Handle_Sabreman_Walking_Read_Controls
*$A48C CALL $AE17      ; Read the controls.
 $A48F BIT 4,A         ; {Jump to #R$A499 if bit 4 of the controls is set (the fire
 $A491 JR NZ,$A499     ; key is not pressed).}
 $A493 EX AF,AF'       ; Keep the controls in #REGaf' while the weapon is
                       ; thrown.
 $A494 CALL $B4D1      ; Throw a weapon (see #R$B4D1).
 $A497 JR $A49F        ; Jump to #R$A49F.
@label=Handle_Sabreman_Walking_Fire_Released
*$A499 EX AF,AF'       ; Keep the controls in #REGaf'.
 $A49A LD A,$FF        ; {Set the flag for the released fire key (#R$AAAB) to
 $A49C LD ($AAAB),A    ; #N$FF.}
@label=Handle_Sabreman_Walking_Check_Movement
*$A49F EX AF,AF'       ; Fetch the controls again from #REGaf'.
 $A4A0 BIT 3,A         ; {Jump to #R$A596 to start a jump if the up control is used (bit 3 of
 $A4A2 JP Z,$A596      ; the controls is clear).}
 $A4A5 BIT 0,A         ; {Jump to #R$A54A to walk to the right if the right control is used
 $A4A7 JP Z,$A54A      ; (bit 0 of the controls is clear).}
 $A4AA BIT 1,A         ; {Jump to #R$A56E to walk to the left if the left control is used (bit
 $A4AC JP Z,$A56E      ; 1 of the controls is clear).}
 $A4AF LD (IX+$06),$00 ; Set the x velocity to #N$00, as he is standing still.
; Move Sabreman sideways by the x velocity, unless the contact bits of the
; bubble or creature that he touches (bits 0 to 2) are all set, in which case
; the routine goes to #R$A5EB, which starts a jump with a y velocity of zero.
@label=Handle_Sabreman_Walking_Move_Sideways
*$A4B3 LD A,(IX+$0E)   ; Fetch the bubble or creature contact result of Sabreman (byte
                       ; #N$0E).
 $A4B6 AND %00000111   ; Keep only bits 0 to 2 (touching, on top and at the
                       ; edge).
 $A4B8 CP $07          ; {Jump to #R$A5EB if all three are set (he is standing on the edge of
 $A4BA JP Z,$A5EB      ; a bubble or a creature).}
 $A4BD LD A,(IX+$01)   ; Fetch the x position of Sabreman.
 $A4C0 ADD A,(IX+$06)  ; Add the x velocity of Sabreman.
 $A4C3 LD (IX+$01),A   ; Store the new x position of Sabreman.
 $A4C6 CALL $98CC      ; Read the world map entry of the room.
 $A4C9 LD A,E          ; Copy the room flags to #REGa.
 $A4CA LD ($AAAC),A    ; Store the room flags in #R$AAAC.
 $A4CD OR (IX+$0B)     ; Combine the room flags with the contact flags of
                       ; Sabreman.
 $A4D0 LD E,A          ; Keep the combined flags in #REGe.
 $A4D1 LD A,(IX+$01)   ; Fetch the x position of Sabreman.
 $A4D4 CP $10          ; {Jump to #R$A4EB if Sabreman is at the left edge of the room (x
 $A4D6 JR C,$A4EB      ; position less than #N$10).}
 $A4D8 CP $E8          ; {Jump to #R$A4EB if Sabreman is at the right edge of the room (x
 $A4DA JR NC,$A4EB     ; position #N$E8 or more).}
 $A4DC EX AF,AF'       ; Keep the controls in #REGaf' while the room redrawn
                       ; flag is fetched.
 $A4DD LD A,($8EF0)    ; Fetch the room redrawn flag from #R$8EF0.
 $A4E0 LD D,A          ; Copy the flag to #REGd.
 $A4E1 EX AF,AF'       ; Fetch the controls again from #REGaf'.
 $A4E2 BIT 0,D         ; {Jump to #R$A4EB if the room has just been drawn (bit 0 of the flag
 $A4E4 JR NZ,$A4EB     ; is set).}
 $A4E6 BIT 4,E         ; {Jump to #R$A5C3 if there is no floor under him (bit 4 of #REGe is
 $A4E8 JP Z,$A5C3      ; clear), as he walks off the ledge.}
; Sabreman is on the ground, so the y velocity is cleared. Then the x
; position is kept inside the room. Bit 2 of the sprite id less one tells which
; way he is facing (set for the right).
@label=Handle_Sabreman_Walking_On_Ground
*$A4EB LD (IX+$09),$00 ; Set the y velocity to #N$00, as he is standing on the
                       ; floor.
 $A4EF LD B,(IX+$00)   ; Fetch the sprite id of Sabreman.
 $A4F2 DEC B           ; Decrease it so that bit 2 tells which way he is
                       ; facing.
 $A4F3 BIT 2,B         ; {Jump to #R$A520 if he is facing right (bit 2 is set).
 $A4F5 JR NZ,$A520     ; }
 $A4F7 BIT 7,(IX+$01)  ; {Jump to #R$96CB if he is in the right half of the room (bit 7 of the
 $A4FB JP NZ,$96CB     ; x position is set), as he is far from the left wall.}
 $A4FE CP $18          ; {Jump to #R$96CB if he has not reached the left wall (x position
 $A500 JP NC,$96CB     ; #N$18 or more).}
 $A503 BIT 6,E         ; {Jump to #R$A50E if the left wall is not solid (bit 6 of #REGe is
 $A505 JR Z,$A50E      ; clear).}
 $A507 LD (IX+$01),$18 ; Stop him at the left wall by setting the x position to
                       ; #N$18.
 $A50B JP $96CB        ; Jump to #R$96CB.
@label=Handle_Sabreman_Walking_Left_Room_Edge
*$A50E CP $08          ; {Jump to #R$96CB if he has not left the room (x position #N$08 or
 $A510 JP NC,$96CB     ; more).}
 $A513 LD (IX+$01),$F0 ; Put him at the right edge of the next room (x position
                       ; #N$F0).
 $A517 DEC (IX+$02)    ; Decrease the room x, to go to the room on the left.
 $A51A CALL $9906      ; Draw the new room.
 $A51D JP $96CB        ; Jump to #R$96CB.
@label=Handle_Sabreman_Walking_Facing_Right
*$A520 BIT 7,(IX+$01)  ; {Jump to #R$96CB if he is in the left half of the room (bit 7 of the
 $A524 JP Z,$96CB      ; x position is clear), as he is far from the right wall.
                       ; }
 $A527 CP $D8          ; {Jump to #R$96CB if he has not reached the right wall (x position
 $A529 JP C,$96CB      ; less than #N$D8).}
 $A52C BIT 2,E         ; {Jump to #R$A538 if the right wall is not solid (bit 2 of #REGe is
 $A52E JP Z,$A538      ; clear).}
 $A531 LD (IX+$01),$D8 ; Stop him at the right wall by setting the x position
                       ; to #N$D8.
 $A535 JP $96CB        ; Jump to #R$96CB.
@label=Handle_Sabreman_Walking_Right_Room_Edge
*$A538 CP $F1          ; {Jump to #R$96CB if he has not left the room (x position less than
 $A53A JP C,$96CB      ; #N$F1).}
 $A53D LD (IX+$01),$08 ; Put him at the left edge of the next room (x position
                       ; #N$08).
 $A541 INC (IX+$02)    ; Increase the room x, to go to the room on the right.
 $A544 CALL $9906      ; Draw the new room.
 $A547 JP $96CB        ; Jump to #R$96CB.
; Walk to the right. If the contact bits of the bubble or creature that he
; touches (bits 1, 2 and 7) are exactly #N$04 he is blocked and stands still.
; Otherwise the x velocity is #N$02 and the sprite id is #N$0D plus bits 1 and 2
; of the animation counter.
@label=Handle_Sabreman_Walking_Right
*$A54A LD A,(IX+$0E)   ; Fetch the bubble or creature contact result of Sabreman (byte
                       ; #N$0E).
 $A54D AND %10000110   ; Keep only bits 1, 2 and 7 (on top, touching and the
                       ; side).
 $A54F CP $04          ; {Jump to #R$A55A if he is not blocked on the right (the result is not
 $A551 JR NZ,$A55A     ; #N$04).}
 $A553 LD (IX+$06),$00 ; Set the x velocity to #N$00, as he is blocked.
 $A557 JP $A4B3        ; Jump to #R$A4B3.
@label=Handle_Sabreman_Walking_Right_Free
*$A55A LD (IX+$06),$02 ; Set the x velocity to #N$02 (walking right).
 $A55E INC (IX+$08)    ; Increase the animation counter of Sabreman.
 $A561 LD A,(IX+$08)   ; Fetch the animation counter.
 $A564 RRA             ; Halve the animation counter so that the frame changes every other
                       ; pass.
 $A565 AND %00000011   ; Keep only the two low bits (one of four frames).
 $A567 ADD A,$0D       ; Add #N$0D to make the sprite id (the frames for
                       ; walking right).
 $A569 LD (IX+$00),A   ; Set the sprite id.
 $A56C JR $A590        ; Jump to #R$A590 to play the footstep sound.
; Walk to the left. If the contact bits of the bubble or creature that he
; touches (bits 1, 2 and 7) are exactly #N$84 he is blocked and stands still.
; Otherwise the x velocity is #N$FE and the sprite id is #N$09 plus bits 1 and 2
; of the animation counter.
@label=Handle_Sabreman_Walking_Left
*$A56E LD A,(IX+$0E)   ; Fetch the bubble or creature contact result of Sabreman (byte
                       ; #N$0E).
 $A571 AND %10000110   ; Keep only bits 1, 2 and 7 (on top, touching and the
                       ; side).
 $A573 CP $84          ; {Jump to #R$A57E if he is not blocked on the left (the result is not
 $A575 JR NZ,$A57E     ; #N$84).}
 $A577 LD (IX+$06),$00 ; Set the x velocity to #N$00, as he is blocked.
 $A57B JP $A4B3        ; Jump to #R$A4B3.
@label=Handle_Sabreman_Walking_Left_Free
*$A57E LD (IX+$06),$FE ; Set the x velocity to #N$FE (walking left).
 $A582 INC (IX+$08)    ; Increase the animation counter of Sabreman.
 $A585 LD A,(IX+$08)   ; Fetch the animation counter.
 $A588 RRA             ; Halve the animation counter so that the frame changes every other
                       ; pass.
 $A589 AND %00000011   ; Keep only the two low bits (one of four frames).
 $A58B ADD A,$09       ; Add #N$09 to make the sprite id (the frames for
                       ; walking left).
 $A58D LD (IX+$00),A   ; Set the sprite id.
@label=Handle_Sabreman_Walking_Play_Tone
*$A590 CALL $A087      ; Play the footstep sound (see #R$A087).
 $A593 JP $A4B3        ; Jump to #R$A4B3.
; Jump. The y velocity is set to #N$D0, the countdown to #N$08 and the
; sprite id becomes #N$11 (facing left) or #N$13 (facing right), according to
; the direction of the x velocity or, when he is not moving sideways, to the way
; that he faced.
@label=Handle_Sabreman_Walking_Jump
*$A596 LD (IX+$09),$D0 ; Set the y velocity to #N$D0 (up) to start the jump.
@label=Handle_Sabreman_Walking_Jump_Set_Countdown
*$A59A LD (IX+$0A),$08 ; Set the jump countdown to #N$08.
 $A59E LD A,(IX+$00)   ; Fetch the sprite id of Sabreman.
 $A5A1 DEC A           ; Decrease it so that bit 2 tells which way he is
                       ; facing.
 $A5A2 AND %00000100   ; Keep only bit 2 (set when he faces right).
 $A5A4 SRL A           ; Shift it right to make #N$00 (left) or #N$02 (right).
 $A5A6 ADD A,$11       ; Add #N$11 to make the jumping sprite id.
 $A5A8 LD (IX+$00),A   ; Set the sprite id.
 $A5AB LD A,(IX+$06)   ; Fetch the x velocity of Sabreman.
 $A5AE AND A           ; {Jump to #R$96CB if he is not moving sideways.
 $A5AF JP Z,$96CB      ; }
 $A5B2 JP M,$A5BC      ; Jump to #R$A5BC if he is moving to the left.
 $A5B5 LD (IX+$00),$13 ; Set the sprite id to #N$13 (jumping right).
 $A5B9 JP $96CB        ; Jump to #R$96CB.
@label=Handle_Sabreman_Walking_Jump_Left
*$A5BC LD (IX+$00),$11 ; Set the sprite id to #N$11 (jumping left).
 $A5C0 JP $96CB        ; Jump to #R$96CB.
; The room has no floor at this position. Sabreman jumps with a y velocity
; of #N$C0 and an x velocity of #N$02 (when his x position is below #N$80) or
; #N$FE.
@label=Handle_Sabreman_Walking_No_Floor
*$A5C3 LD (IX+$09),$C0 ; Set the y velocity to #N$C0 (up), as he steps off the
                       ; ledge.
 $A5C7 BIT 7,(IX+$01)  ; {Jump to #R$A5DC if bit 7 of the x position is set.
 $A5CB JR NZ,$A5DC     ; }
 $A5CD LD (IX+$06),$02 ; Set the x velocity to #N$02.
 $A5D1 LD (IX+$0A),$08 ; Set the countdown to #N$08.
 $A5D5 LD (IX+$00),$13 ; Set the sprite id to #N$13 (jumping right).
 $A5D9 JP $96CB        ; Jump to #R$96CB.
@label=Handle_Sabreman_Walking_No_Floor_Left
*$A5DC LD (IX+$06),$FE ; Set the x velocity to #N$FE.
 $A5E0 LD (IX+$0A),$08 ; Set the countdown to #N$08.
 $A5E4 LD (IX+$00),$11 ; Set the sprite id to #N$11 (jumping left).
 $A5E8 JP $96CB        ; Jump to #R$96CB.
@label=Handle_Sabreman_Walking_Jump_Straight_Up
*$A5EB LD (IX+$09),$00 ; Set the y velocity to #N$00, so that the jump has no
                       ; height.
 $A5EF JR $A59A        ; Jump to #R$A59A.

; Handle Sabreman Jumping
;
; Handler for the object types #N$11 to #N$14, which are the jumping
; sprites of Sabreman (#N$11 and #N$12 when he jumps to the left and #N$13 and
; #N$14 when he jumps to the right).
; .
; The countdown in the object record is decreased on every call. When it reaches
; #N$03 the sprite moves on to the next frame, and when it reaches zero the jump
; is over and the sprite becomes #N$15 or #N$16 (falling), so that #R$A6A6 takes
; over. The controls steer him left or right while he is in the air.
; .
; At the end of the jump the y position is moved up by #N$04 and the countdown
; is set to #N$0C. If that takes him into the top part of the room and the room
; has a ceiling, he hits it and tumbles at #R$A928.
;
; IX Object record of Sabreman
;
; Save the state of the object, then deal with the special states in the
; same way as #R$A433.
@label=Handle_Sabreman_Jumping
c$A5F1 CALL $989F      ; Remember the position and sprite id of Sabreman.
 $A5F4 BIT 6,(IX+$0F)  ; {Jump to #R$B72C if Sabreman is being carried (bit 6 of the redraw
 $A5F8 JP NZ,$B72C     ; flags).}
 $A5FB BIT 7,(IX+$0F)  ; {Jump to #R$A406 if Sabreman is tumbling (bit 7 of the
 $A5FF JP NZ,$A406     ; redraw flags).}
 $A602 CALL $98CC      ; Read the world map entry of the room.
 $A605 CALL $E1B4      ; Check for contact with the bubbles.
; Decrease the countdown. When it reaches zero the jump ends at
; #R$A645.
 $A608 DEC (IX+$0A)    ; {Decrease the jump countdown and jump to #R$A645 if
 $A60B JR Z,$A645      ; the jump is over.}
 $A60D LD A,(IX+$0A)   ; {Fetch the jump countdown and jump to #R$A617 unless it has reached
 $A610 CP $03          ; #N$03.
 $A612 JR NZ,$A617     ; }
 $A614 INC (IX+$00)    ; Move on to the next frame of the jumping sprite, as he is at the top
                       ; of the jump.
; Read the controls. Bit 0 clear sets an x velocity of #N$02 and moves to
; the frames for jumping to the right. Bit 1 clear sets an x velocity of #N$FE
; and moves to the frames for jumping to the left. If neither is clear the
; velocity is unchanged.
@label=Handle_Sabreman_Jumping_Read_Controls
*$A617 CALL $AE17      ; Read the controls.
 $A61A BIT 0,A         ; {Jump to #R$A634 if the right control is used (bit 0 of the controls
 $A61C JR Z,$A634      ; is clear).}
 $A61E BIT 1,A         ; {Jump to #R$96CB if the left control is not used either (bit 1 of the
 $A620 JP NZ,$96CB     ; controls is set).}
 $A623 LD (IX+$06),$FE ; Set the x velocity of Sabreman to #N$FE (moving left).
 $A627 LD A,(IX+$00)   ; {Switch to the frame for jumping to the left.
 $A62A DEC A           ;
 $A62B RES 1,A         ;
 $A62D INC A           ; }
 $A62E LD (IX+$00),A   ; Set the sprite id.
 $A631 JP $96CB        ; Jump to #R$96CB.
@label=Handle_Sabreman_Jumping_Move_Right
*$A634 LD (IX+$06),$02 ; Set the x velocity of Sabreman to #N$02 (moving
                       ; right).
 $A638 LD A,(IX+$00)   ; {Switch to the frame for jumping to the right.
 $A63B DEC A           ;
 $A63C SET 1,A         ;
 $A63E INC A           ; }
 $A63F LD (IX+$00),A   ; Set the sprite id.
 $A642 JP $96CB        ; Jump to #R$96CB.
; The jump is over. The sprite id becomes #N$15 (when the jump was to the
; left) or #N$16 (when it was to the right).
@label=Handle_Sabreman_Jumping_Finish
*$A645 LD A,(IX+$00)   ; Fetch the sprite id of Sabreman.
 $A648 DEC A           ; Decrease the sprite id.
 $A649 RRA             ; Rotate it right, which leaves the direction in bit 0.
 $A64A AND %00000001   ; Keep only the direction (#N$00 for left, #N$01 for
                       ; right).
 $A64C ADD A,$15       ; Add #N$15 to make the sprite id for falling in that
                       ; direction.
 $A64E LD (IX+$00),A   ; Set the sprite id.
 $A651 CALL $98CC      ; Read the world map entry of the room.
 $A654 LD A,(IX+$0B)   ; Fetch the contact flags of Sabreman.
 $A657 OR E            ; {Combine the contact flags of Sabreman with the contact flags of the
 $A658 LD E,A          ; room.}
 $A659 LD A,(IX+$03)   ; Fetch the y position of Sabreman.
 $A65C SUB $04         ; Take #N$04 off the y position of Sabreman.
 $A65E CP $49          ; {Jump to #R$A66B if he is not in the top part of the room (y position
 $A660 JR NC,$A66B     ; of at least #N$49).}
 $A662 LD (IX+$0B),$44 ; Mark the walls on both sides as solid by setting the contact flags
                       ; to #N$44, as he is in the upper part of the room.
 $A666 BIT 0,E         ; {Jump to #R$A928 if he hits the ceiling (bit 0 of the contact flags
 $A668 JP NZ,$A928     ; is set).}
@label=Handle_Sabreman_Jumping_Land
*$A66B LD (IX+$03),A   ; Store the new y position of Sabreman.
 $A66E LD (IX+$0A),$0C ; Set the countdown of Sabreman to #N$0C.
 $A672 CALL $A0E4      ; Play the sword sound (see #R$A0E4).
 $A675 JP $96CB        ; Jump to #R$96CB.

; Handle Falling At Right Edge
;
; Used by the routine at #R$A6A6.
; .
; Deals with Sabreman when he falls (or tumbles from a fall) and his x
; position has gone past the right-hand side of the room. It is entered from
; #R$A6A6(#N$A747) with the new x position in #REGa and the room flags in #REGe.
; .
; If the x position is less than #N$D8 nothing happens and the routine goes on
; at #R$A77E. If the right wall is solid (bit 2 of #REGe), the x
; position is set to #N$D0 and the x velocity is reversed, which then makes him
; tumble. If it is not, the contact flags are given the bits #N$11 and, once the
; x position reaches #N$F0, he enters the room on the right.
;
; A New x position of Sabreman
; E Flags of the room
; IX Object record of Sabreman
@label=Handle_Falling_At_Right_Edge
c$A678 CP $D8          ; {Jump to #R$A77E if he has not reached the right wall (x position
 $A67A JP C,$A77E      ; less than #N$D8).}
 $A67D BIT 2,E         ; {Jump to #R$A688 if the right wall is not solid (bit 2 of #REGe is
 $A67F JR Z,$A688      ; clear).}
 $A681 LD (IX+$01),$D0 ; Stop him at the right wall by setting the x position
                       ; to #N$D0.
 $A685 JP $A756        ; Jump to #R$A756.
@label=Handle_Falling_At_Right_Edge_No_Wall
*$A688 EX AF,AF'       ; {Mark the ceiling and the floor as solid (bits 0 and 4 of the contact
 $A689 LD A,$11        ; flags of Sabreman), as he is in the gap in the wall, keeping the new x
 $A68B OR (IX+$0B)     ; position in #REGaf'.
 $A68E LD (IX+$0B),A   ;
 $A691 EX AF,AF'       ; }
 $A692 SET 4,E         ; Mark the room as having a floor (bit 4 of #REGe).
 $A694 CP $F0          ; {Jump to #R$A77E if he has not left the room (x position less than
 $A696 JP C,$A77E      ; #N$F0).}
 $A699 INC (IX+$02)    ; Increase the room x, to go to the room on the right.
 $A69C LD (IX+$01),$08 ; Put him at the left edge of the next room (x position
                       ; #N$08).
 $A6A0 CALL $9906      ; Draw the new room.
 $A6A3 JP $96CB        ; Jump to #R$96CB.

; Handle Sabreman Falling
;
; Handler for the object types #N$15 and #N$16, which are the falling
; sprites of Sabreman (#N$15 when he falls to the left and #N$16 when he falls
; to the right). It is also where he lands from a jump or a fall.
; .
; The routine checks for contact with the falling stalactite, deals with the
; special states in the same way as #R$A433, lets him steer while he is not
; moving sideways, checks for contact with the bubbles and the creatures, moves
; him sideways and then applies the pull of gravity to the y velocity, which is
; increased by #N$02 each time up to a limit of #N$4C. The y position changes by
; one sixteenth of the y velocity.
; .
; He lands when the y position reaches #N$9F. Landing after a fall that reaches
; a y velocity of #N$74 or more kills him (see #R$E7D0).
;
; IX Object record of Sabreman
@label=Handle_Sabreman_Falling
c$A6A6 CALL $989F      ; Remember the position and sprite id of Sabreman.
; Check for contact with the falling stalactite. If it touches him, the
; routine ends at #R$E898.
 $A6A9 CALL $E833      ; Check for contact with the falling stalactite.
 $A6AC BIT 2,C         ; {Jump to #R$E898 to knock him down if the falling stalactite touches
 $A6AE JP NZ,$E898     ; him (bit 2 of #REGc is set).}
 $A6B1 BIT 6,(IX+$0F)  ; {Jump to #R$B72C if Sabreman is being carried (bit 6 of the redraw
 $A6B5 JP NZ,$B72C     ; flags).}
 $A6B8 BIT 7,(IX+$0F)  ; {Jump to #R$A406 if Sabreman is tumbling (bit 7 of the
 $A6BC JP NZ,$A406     ; redraw flags).}
 $A6BF BIT 3,(IX+$0F)  ; {Jump to #R$E8A2 if Sabreman is in the special state (bit 3 of the
 $A6C3 JP NZ,$E8A2     ; redraw flags is set).}
; Read the controls. While he is not moving sideways, bit 0 clear makes
; the sprite id #N$16 and bit 1 clear makes it #N$15. A clear bit 4 throws a
; weapon, otherwise the flag for the released fire key is set.
 $A6C6 CALL $AE17      ; Read the controls.
 $A6C9 LD C,A          ; Keep the state of the controls in #REGc.
 $A6CA LD A,(IX+$06)   ; Fetch the x velocity of Sabreman.
 $A6CD AND A           ; {Jump to #R$A6E0 if he is moving sideways (the x velocity is not
 $A6CE JR NZ,$A6E0     ; zero).}
 $A6D0 BIT 0,C         ; {Jump to #R$A6D8 if the right control is not used (bit 0 of the
 $A6D2 JR NZ,$A6D8     ; controls is set).}
 $A6D4 LD (IX+$00),$16 ; Set the sprite id to #N$16 (falling to the right).
@label=Handle_Sabreman_Falling_Check_Left_Key
*$A6D8 BIT 1,C         ; {Jump to #R$A6E0 if the left control is not used (bit 1 of the
 $A6DA JR NZ,$A6E0     ; controls is set).}
 $A6DC LD (IX+$00),$15 ; Set the sprite id to #N$15 (falling to the left).
@label=Handle_Sabreman_Falling_Check_Fire
*$A6E0 BIT 4,C         ; {Jump to #R$A6E9 if the fire control is not used (bit 4 of the
 $A6E2 JR NZ,$A6E9     ; controls is set).}
 $A6E4 CALL $B4D1      ; Throw a weapon (see #R$B4D1).
 $A6E7 JR $A6EE        ; Jump to #R$A6EE.
@label=Handle_Sabreman_Falling_Fire_Released
*$A6E9 LD A,$FF        ; {Set the flag for the released fire key (#R$AAAB) to
 $A6EB LD ($AAAB),A    ; #N$FF.}
; Check for contact with the bubbles and then the creatures. The contact
; result is in #REGc. With bit 1 clear he is pushed away sideways with an x
; velocity of #N$02 or #N$FE, a tone is played and he tumbles at
; #R$A928. With bit 1 set he lands on top of the object at
; #R$A8A0 when bit 0 is clear, and nothing happens when bit 0 is set.
@label=Handle_Sabreman_Falling_Check_Contact
*$A6EE CALL $98CC      ; Read the world map entry of the room.
 $A6F1 LD A,E          ; {Store the room flags in #R$AAAC.
 $A6F2 LD ($AAAC),A    ; }
 $A6F5 CALL $E1B4      ; Check for contact with the bubbles.
 $A6F8 BIT 2,C         ; {Jump to #R$A705 if Sabreman touches a bubble (bit 2 of #REGc is
 $A6FA JR NZ,$A705     ; set).}
 $A6FC PUSH DE         ; Stash the world map entry on the stack.
 $A6FD CALL $B43E      ; Check for contact with the creatures.
 $A700 POP DE          ; Restore the world map entry from the stack.
 $A701 BIT 2,C         ; {Jump to #R$A733 if Sabreman touches no creature (bit 2 of #REGc is
 $A703 JR Z,$A733      ; not set).}
@label=Handle_Sabreman_Falling_Bubble_Contact
*$A705 BIT 0,C         ; {Jump to #R$A724 if he is touching the middle of it (bit 0 of #REGc
 $A707 JR Z,$A724      ; is clear).}
 $A709 BIT 1,C         ; {Jump to #R$A733 to carry on falling if he is on top of the edge of
 $A70B JR NZ,$A733     ; it (bit 1 of #REGc is set).}
@label=Handle_Sabreman_Falling_Push_Sideways
*$A70D CALL $EBC0      ; Make Sabreman tumble inside the walls (see #R$EBC0).
 $A710 BIT 7,C         ; {Jump to #R$A71A if he is on the left of it (bit 7 of #REGc is
 $A712 JR Z,$A71A      ; clear).}
 $A714 LD (IX+$06),$02 ; Push him to the right by setting the x velocity to
                       ; #N$02.
 $A718 JR $A71E        ; Jump to #R$A71E.
@label=Handle_Sabreman_Falling_Push_Left
*$A71A LD (IX+$06),$FE ; Push him to the left by setting the x velocity to
                       ; #N$FE.
@label=Handle_Sabreman_Falling_Push_Play_Tone
*$A71E CALL $A07D      ; Play a low tone.
 $A721 JP $A928        ; Jump to #R$A928.
@label=Handle_Sabreman_Falling_Land_On_Bubble
*$A724 BIT 1,C         ; {Jump to #R$A70D and push him away sideways if he is not on top of it
 $A726 JR Z,$A70D      ; (bit 1 of #REGc is clear).}
 $A728 LD A,B          ; {Set the y position so that Sabreman stands on top of
 $A729 NEG             ; the bubble.
 $A72B ADD A,$A1       ;
 $A72D LD (IX+$03),A   ; }
 $A730 JP $A8A0        ; Jump to #R$A8A0.
; Move Sabreman sideways by the x velocity. At the left-hand side of the
; room (x position less than #N$18) a solid left wall stops him and reverses the
; x velocity so that he tumbles. Without a wall, he enters the room on the left
; when the x position is less than #N$08.
@label=Handle_Sabreman_Falling_Move_Sideways
*$A733 LD A,E          ; {Combine the contact flags of Sabreman with the contact flags of the
 $A734 OR (IX+$0B)     ; room.
 $A737 LD E,A          ; }
 $A738 XOR A           ; {Clear the contact flags of Sabreman.
 $A739 LD (IX+$0B),A   ; }
 $A73C LD A,(IX+$01)   ; Fetch the x position of Sabreman.
 $A73F ADD A,(IX+$06)  ; Add the x velocity of Sabreman.
 $A742 LD (IX+$01),A   ; Store the new x position of Sabreman.
 $A745 BIT 7,A         ; {Jump to #R$A678 if he is in the right half of the room (bit 7 of the
 $A747 JP NZ,$A678     ; x position is set).}
 $A74A CP $18          ; {Jump to #R$A77E if he is clear of the left wall (x position #N$18 or
 $A74C JR NC,$A77E     ; more).}
 $A74E BIT 6,E         ; {Jump to #R$A761 if the left wall is not solid (bit 6 of #REGe is
 $A750 JR Z,$A761      ; clear).}
 $A752 LD (IX+$01),$18 ; Stop him at the left wall by setting the x position to
                       ; #N$18.
; This entry point is used by the routine at #R$A678.
@label=Handle_Sabreman_Falling_Reverse_Velocity
*$A756 LD A,(IX+$06)   ; {Reverse the x velocity, so that he bounces off the
 $A759 NEG             ; wall.
 $A75B LD (IX+$06),A   ; }
 $A75E JP $A928        ; Jump to #R$A928 to tumble.
@label=Handle_Sabreman_Falling_No_Left_Wall
*$A761 EX AF,AF'       ; {Mark the ceiling and the floor as solid (bits 0 and 4 of the contact
 $A762 LD A,$11        ; flags of Sabreman), as he is in the gap in the wall, keeping the new x
 $A764 OR (IX+$0B)     ; position in #REGaf'.
 $A767 LD (IX+$0B),A   ;
 $A76A EX AF,AF'       ; }
 $A76B SET 4,E         ; Mark the room as having a floor (bit 4 of #REGe).
 $A76D CP $08          ; {Jump to #R$A77E if he has not left the room (x position #N$08 or
 $A76F JR NC,$A77E     ; more).}
 $A771 DEC (IX+$02)    ; Decrease the room x, to go to the room on the left.
 $A774 LD (IX+$01),$F0 ; Put him at the right edge of the next room (x position
                       ; #N$F0).
 $A778 CALL $9906      ; Draw the new room.
 $A77B JP $96CB        ; Jump to #R$96CB.
; This entry point is used by the routine at #R$A678.
; .
; Apply gravity. If the y velocity is positive and has reached #N$4C it is
; left as it is, otherwise it is increased by #N$02. The y position is then
; changed by the y velocity divided by #N$10.
; .
; If the new y position is #N$9F or more, the contact flags are given the bits
; #N$44, and he lands at #R$A89C when the room has a floor or goes down
; to the room below at #R$A86F when it does not.
@label=Handle_Sabreman_Falling_Apply_Gravity
*$A77E LD A,(IX+$09)   ; Fetch the y velocity of Sabreman.
 $A781 BIT 7,A         ; {Jump to #R$A78E if he is moving upwards (bit 7 of the y velocity is
 $A783 JR NZ,$A78E     ; set).}
 $A785 CP $4C          ; {Jump to #R$A78E if he is not yet falling at full speed (the y
 $A787 JR C,$A78E      ; velocity is less than #N$4C).}
 $A789 CALL $EBC0      ; Make Sabreman tumble inside the walls (see #R$EBC0).
 $A78C JR $A794        ; Jump to #R$A794.
@label=Handle_Sabreman_Falling_Increase_Velocity
*$A78E INC (IX+$09)    ; Increase the y velocity (gravity pulls him down).
 $A791 INC (IX+$09)    ; Increase the y velocity again.
@label=Handle_Sabreman_Falling_Move_Vertically
*$A794 SRA A           ; {Divide the y velocity by sixteen, keeping the sign.
 $A796 SRA A           ;
 $A798 SRA A           ;
 $A79A SRA A           ; }
 $A79C ADD A,(IX+$03)  ; Add the y position of Sabreman to get the new y
                       ; position.
 $A79F CP $9F          ; {Jump to #R$A7B5 if he has not reached the bottom of the room (the
 $A7A1 JR C,$A7B5      ; new y position is less than #N$9F).}
 $A7A3 EX AF,AF'       ; {Set bits 2 and 6 of the contact flags of Sabreman (both side walls
 $A7A4 LD A,$44        ; are solid), keeping the new y position in the alternate #REGaf'.
 $A7A6 OR (IX+$0B)     ;
 $A7A9 LD (IX+$0B),A   ;
 $A7AC EX AF,AF'       ; }
 $A7AD BIT 4,E         ; {Jump to #R$A86F if the room has no floor (bit 4 of #REGe is clear),
 $A7AF JP Z,$A86F      ; to go down to the room below.}
 $A7B2 JP $A89C        ; Jump to #R$A89C to land on the floor.
; This entry point is used by the routine at #R$A925.
; .
; The y position is above #N$9F. If it is less than #N$48 and the room has
; a ceiling (bit 0 of #REGe), a negative y velocity is made positive and the y
; position is set to #N$48. If it is less than #N$48 and the room has no
; ceiling, the contact flags are given the bits #N$44 and, when the y position
; is less than #N$28, he moves up to the room above.
@label=Handle_Sabreman_Falling_Above_Floor
*$A7B5 CP $48          ; {Jump to #R$A7CE if he is below the top of the room (y position #N$48
 $A7B7 JR NC,$A7CE     ; or more).}
 $A7B9 BIT 0,E         ; {Jump to #R$A7E4 if the room has no ceiling (bit 0 of #REGe is
 $A7BB JR Z,$A7E4      ; clear).}
 $A7BD CALL $EBC0      ; Make Sabreman tumble inside the walls (see #R$EBC0).
 $A7C0 LD A,(IX+$09)   ; Fetch the y velocity of Sabreman.
 $A7C3 BIT 7,A         ; {Jump to #R$A7CC if he is moving down (bit 7 of the y velocity is
 $A7C5 JR Z,$A7CC      ; clear).}
 $A7C7 NEG             ; Negate the y velocity, so that he bounces off the
                       ; ceiling.
 $A7C9 LD (IX+$09),A   ; Store the new y velocity of Sabreman.
@label=Handle_Sabreman_Falling_Set_Ceiling_Position
*$A7CC LD A,$48        ; Set the y position to #N$48, just below the ceiling.
; Store the y position and make #REGc the y position less #N$37 (with a
; minimum of #N$02). While the countdown is not zero it is decreased and the
; routine ends.
@label=Handle_Sabreman_Falling_Store_Y_Position
*$A7CE LD (IX+$03),A   ; Store the y position of Sabreman.
 $A7D1 SUB $37         ; {Work out the length of rope needed to reach him (the y position less
 $A7D3 JR NC,$A7D7     ; #N$37) and jump to #R$A7D7 unless that is negative.}
 $A7D5 LD A,$02        ; Use the shortest length of #N$02 instead.
@label=Handle_Sabreman_Falling_Set_Threshold
*$A7D7 LD C,A          ; Keep the length of rope needed in #REGc.
 $A7D8 LD A,(IX+$0A)   ; Fetch the countdown of Sabreman.
 $A7DB AND A           ; {Jump to #R$A7FF if the countdown is zero.
 $A7DC JR Z,$A7FF      ; }
 $A7DE DEC (IX+$0A)    ; Decrease the countdown of Sabreman.
 $A7E1 JP $96CB        ; Jump to #R$96CB.
@label=Handle_Sabreman_Falling_No_Ceiling
*$A7E4 EX AF,AF'       ; Switch to the shadow registers.
 $A7E5 LD A,(IX+$0B)   ; Fetch the contact flags of Sabreman.
 $A7E8 OR %01000100    ; Set bits 2 and 6 (both side walls are solid).
 $A7EA LD (IX+$0B),A   ; Store the contact flags of Sabreman.
 $A7ED EX AF,AF'       ; Switch back to the main registers.
 $A7EE CP $28          ; {Jump to #R$A7CE if he has not left the top of the room (y position
 $A7F0 JR NC,$A7CE     ; #N$28 or more).}
 $A7F2 DEC (IX+$04)    ; Decrease the room y, to go to the room above.
 $A7F5 LD (IX+$03),$BA ; Put him at the bottom of the room above (y position
                       ; #N$BA).
 $A7F9 CALL $9906      ; Draw the new room.
 $A7FC JP $96CB        ; Jump to #R$96CB.
; The countdown is zero. Now the routine checks whether he is falling onto
; the rope (the type #N$17 object, see #R$AA4C). The conditions are that the
; room y is #N$10 or more, that the number in #R$AAA5 (the length of
; the rope) is not less than #REGc, that his x position is within #N$10 of #N$78
; (where the rope hangs), and that record 3 holds the rope and #R$AAA4
; is zero. When they hold, he grabs the rope: the sprite id is set to #N$01,
; record 3 is cleared (from then on #R$A316 looks after the rope), and the
; second byte of the world map entry of each room below him is cleared down to
; the first room that has a floor.
@label=Handle_Sabreman_Falling_Check_Rope
*$A7FF LD A,(IX+$04)   ; Fetch the room y of Sabreman.
 $A802 CP $10          ; {Jump to #R$96CB if he is in a special room (the room y is less than
 $A804 JP C,$96CB      ; #N$10), as there is no rope there.}
 $A807 LD A,($AAA5)    ; Fetch the length of the rope from #R$AAA5.
 $A80A AND %01111111   ; Keep only the length (bits 0 to 6).
 $A80C CP C            ; {Jump to #R$96CB if the rope is too short to reach him (the length is
 $A80D JP C,$96CB      ; less than #REGc).}
 $A810 LD A,(IX+$0F)   ; Fetch the redraw flags of Sabreman.
 $A813 AND %10100111   ; Keep only bits 0, 1, 2, 5 and 7 (this clears bits 3, 4
                       ; and 6).
 $A815 LD (IX+$0F),A   ; Store the redraw flags of Sabreman.
 $A818 LD A,(IX+$01)   ; Fetch the x position of Sabreman.
 $A81B SUB $78         ; {Work out how far he is from the rope (x position #N$78) and jump to
 $A81D JP P,$A822      ; #R$A822 if he is on the right of it.}
 $A820 NEG             ; Make the distance positive.
@label=Handle_Sabreman_Falling_Check_Rope_Distance
*$A822 CP $10          ; {Jump to #R$96CB if he is too far from the rope (the distance is
 $A824 JP NC,$96CB     ; #N$10 or more).}
 $A827 LD A,($8F2A)    ; Fetch the type of record 3 (the rope).
 $A82A AND A           ; {Jump to #R$A881 if the rope has not been set up.
 $A82B JP Z,$A881      ; }
 $A82E LD A,($AAA4)    ; Fetch the displacement of the rope from #R$AAA4.
 $A831 AND A           ; {Jump to #R$96CB if the rope is swinging (the displacement is not
 $A832 JP NZ,$96CB     ; zero).}
@label=Handle_Sabreman_Falling_Catch_Rope
*$A835 LD B,C          ; Copy the length of rope needed to #REGb.
 $A836 BIT 7,B         ; {Jump to #R$96CB if the length of rope needed is too long (bit 7 of
 $A838 JP NZ,$96CB     ; #REGb is set).}
 $A83B LD A,($AAA5)    ; Fetch the length of the rope from #R$AAA5.
 $A83E AND %10000000   ; Keep only bit 7 (the flag of the rope).
 $A840 OR B            ; Combine the flag with the length of rope needed.
 $A841 LD ($AAA5),A    ; Set the length of the rope to the length needed to
                       ; reach him.
 $A844 LD (IX+$00),$01 ; Set the sprite id to #N$01 (hanging on the rope).
 $A848 LD A,(IX+$06)   ; Fetch the x velocity of Sabreman.
 $A84B SLA A           ; {Multiply the x velocity by eight.
 $A84D SLA A           ;
 $A84F SLA A           ; }
 $A851 LD ($AAA2),A    ; Set the x velocity of the end of the rope (#R$AAA2) so that it
                       ; swings the way that he was moving.
 $A854 XOR A           ; {Clear the type of record 3 (the rope), as Sabreman is now holding
 $A855 LD ($8F2A),A    ; it.}
 $A858 CALL $98B2      ; Find the world map entry of the room.
 $A85B LD BC,$0020     ; Set the offset to the room below (#N$20).
@label=Handle_Sabreman_Falling_Find_Rope_Row_Loop
*$A85E BIT 4,(HL)      ; {Jump to #R$A869 if this room has a floor (bit 4 of
 $A860 JR NZ,$A869     ; the room flags).}
 $A862 ADD HL,BC       ; Add the offset to move to the entry of the room below.
 $A863 INC HL          ; Move on to the second byte of the entry.
 $A864 LD (HL),$00     ; Clear the second byte of the entry.
 $A866 DEC HL          ; Move back to the first byte of the entry.
 $A867 JR $A85E        ; Jump to #R$A85E.
@label=Handle_Sabreman_Falling_Move_Rope
*$A869 CALL $AAB0      ; Move the rope (see #R$AAB0).
 $A86C JP $A365        ; Jump to #R$A365 to position Sabreman on the rope.
@label=Handle_Sabreman_Falling_Check_Bottom_Edge
*$A86F CP $BC          ; {Jump to #R$A7B5 if he has not reached the bottom of the room (the y
 $A871 JP C,$A7B5      ; position is less than #N$BC).}
 $A874 INC (IX+$04)    ; Increase the room y, to go to the room below.
 $A877 LD (IX+$03),$2A ; Put him at the top of the room below (y position
                       ; #N$2A).
 $A87B CALL $9906      ; Draw the new room.
 $A87E JP $A7B5        ; Jump to #R$A7B5.
; There is no rope in record 3. If the room has a ceiling (bit 0 of #REGe)
; and no floor (bit 4), the second byte of the world map entry of the room is
; set to #N$08, the rope end positions in #R$AA93 are cleared and the code above
; carries on, so that he grabs a rope that is just long enough.
@label=Handle_Sabreman_Falling_No_Rope
*$A881 BIT 0,E         ; {Jump to #R$96CB if the room has no ceiling (bit 0 of #REGe is
 $A883 JP Z,$96CB      ; clear).}
 $A886 BIT 4,E         ; {Jump to #R$96CB if the room has a floor (bit 4 of
 $A888 JP NZ,$96CB     ; #REGe is set).}
 $A88B CALL $98B2      ; Find the world map entry of the room.
 $A88E INC HL          ; Move on to the second byte of the entry.
 $A88F LD (HL),$08     ; Write #N$08 to the second byte of the entry.
 $A891 LD HL,$0000     ; {Clear the length of the rope (#R$AAA5) and the word
 $A894 LD ($AA97),HL   ; at #R$AA97.
 $A897 LD ($AAA5),HL   ; }
 $A89A JR $A835        ; Jump to #R$A835 to grab the new rope.
; This entry point is used by the routine at #R$A925.
@label=Handle_Sabreman_Falling_Reach_Floor
*$A89C LD (IX+$03),$9F ; Put him on the floor by setting the y position to
                       ; #N$9F.
; This entry point is used by the routine at #R$A925.
; .
; Sabreman lands. If the y velocity is positive and #N$74 or more (and the
; gem timer at #R$8EEE is zero) he dies at #R$E7D0. Otherwise a low tone is
; played and the sprite id becomes #N$09 (when he faced left) or #N$0D (when he
; faced right), which are the walking sprites.
@label=Land_Sabreman
*$A8A0 LD A,($8EEE)    ; Fetch the gem timer from #R$8EEE.
 $A8A3 AND A           ; {Jump to #R$A8B2 if the gem timer is running (it is not zero), as he
 $A8A4 JR NZ,$A8B2     ; cannot be hurt.}
 $A8A6 LD A,(IX+$09)   ; Fetch the y velocity of Sabreman.
 $A8A9 BIT 7,A         ; {Jump to #R$A8B2 if he is moving up (bit 7 of the y
 $A8AB JR NZ,$A8B2     ; velocity is set).}
 $A8AD CP $74          ; {Jump to #R$E7D0 and kill him if he has fallen too fast (the y
 $A8AF JP NC,$E7D0     ; velocity is #N$74 or more).}
@label=Land_Sabreman_Play_Tone
*$A8B2 CALL $A07D      ; Play a low tone.
 $A8B5 LD A,(IX+$00)   ; Fetch the sprite id of Sabreman.
 $A8B8 DEC A           ; Decrease the sprite id so that bit 0 tells which way
                       ; he was falling.
 $A8B9 RLA             ; {Rotate the direction up to bit 2.
 $A8BA RLA             ; }
 $A8BB AND %00000100   ; Keep only bit 2 (set when he faced right).
 $A8BD ADD A,$09       ; Add #N$09 to make the sprite id for walking in that
                       ; direction.
 $A8BF LD (IX+$00),A   ; Set the sprite id of Sabreman.
 $A8C2 RES 7,(IX+$0F)  ; Stop him tumbling by resetting bit 7 of the redraw
                       ; flags.
 $A8C6 JP $96CB        ; Jump to #R$96CB.
; This entry point is used by the routine at #R$A316.
; .
; Sabreman comes down from the rope onto the floor at y position #N$9F.
; The sprite id becomes #N$09 (when the x velocity is negative) or #N$0D.
@label=Stand_Sabreman_On_Floor
*$A8C9 LD (IX+$03),$9F ; Put him on the floor by setting the y position to
                       ; #N$9F.
 $A8CD LD A,$09        ; Start with the sprite id #N$09 (walking to the left).
 $A8CF BIT 7,(IX+$06)  ; {Jump to #R$A8D7 if he is moving to the left (bit 7 of the x velocity
 $A8D3 JR NZ,$A8D7     ; is set).}
 $A8D5 ADD A,$04       ; Add #N$04 to make the sprite id #N$0D (walking to the
                       ; right).
@label=Stand_Sabreman_On_Floor_Set_Sprite
*$A8D7 LD (IX+$00),A   ; Set the sprite id of Sabreman.
; This entry point is used by the routines at #R$A316 and #R$E87B.
; .
; Record 3 is made a type #N$17 object again, with its x velocity (byte
; #N$06) set to #N$03.
@label=Restore_Type_17_Object
*$A8DA LD A,$17        ; {Set the type of record 3 (the rope) to #N$17.
 $A8DC LD ($8F2A),A    ; }
 $A8DF LD A,$03        ; {Set the x velocity of the rope to #N$03.
 $A8E1 LD ($8F30),A    ; }
 $A8E4 LD A,(IX+$0F)   ; Fetch the redraw flags of Sabreman.
 $A8E7 AND %01000000   ; Keep only bit 6 (being carried).
 $A8E9 JP NZ,$B72C     ; Jump to #R$B72C if Sabreman is being carried by an
                       ; eagle.
 $A8EC JP $96CB        ; Jump to #R$96CB.

; Handle Tumbling At Right Edge
;
; Used by the routine at #R$A925.
; .
; Deals with Sabreman when he tumbles and his x position has gone past the
; right-hand side of the room. It is entered from #R$A925(#N$A9BE) with the new
; x position in #REGa and the room flags in #REGe.
; .
; If the x position is less than #N$CF nothing happens and the routine goes on
; at #R$A9F5. If the right wall is solid (bit 2 of #REGe), the x
; velocity is reversed and the x position is set to #N$CF. If it is not, the
; contact flags are given the bits #N$11 and, once the x position reaches #N$E8,
; he enters the room on the right.
;
; A New x position of Sabreman
; E Flags of the room
; IX Object record of Sabreman
@label=Handle_Tumbling_At_Right_Edge
c$A8EF CP $CF          ; {Jump to #R$A9F5 if he has not reached the right wall (x position
 $A8F1 JP C,$A9F5      ; less than #N$CF).}
 $A8F4 BIT 2,E         ; {Jump to #R$A907 if the right wall is not solid (bit 2 of #REGe is
 $A8F6 JR Z,$A907      ; clear).}
 $A8F8 LD A,(IX+$06)   ; {Reverse the x velocity, so that he bounces off the
 $A8FB NEG             ; wall.
 $A8FD LD (IX+$06),A   ; }
 $A900 LD (IX+$01),$CF ; Stop him at the right wall by setting the x position
                       ; to #N$CF.
 $A904 JP $A9F5        ; Jump to #R$A9F5.
@label=Handle_Tumbling_At_Right_Edge_No_Wall
*$A907 EX AF,AF'       ; {Mark the ceiling and the floor as solid (bits 0 and 4 of the contact
 $A908 LD A,$11        ; flags of Sabreman), as he is in the gap in the wall, keeping the new x
 $A90A OR (IX+$0B)     ; position in #REGaf'.
 $A90D LD (IX+$0B),A   ;
 $A910 EX AF,AF'       ; }
 $A911 SET 4,E         ; Mark the room as having a floor (bit 4 of #REGe).
 $A913 CP $E8          ; {Jump to #R$A9F5 if he has not left the room (x position less than
 $A915 JP C,$A9F5      ; #N$E8).}
 $A918 INC (IX+$02)    ; Increase the room x, to go to the room on the right.
 $A91B LD (IX+$01),$08 ; Put him at the left edge of the next room (x position
                       ; #N$08).
 $A91F CALL $9906      ; Draw the new room.
 $A922 JP $96CB        ; Jump to #R$96CB.

; Handle Sabreman Tumbling
;
; Handler for the object types #N$18 to #N$1B, which are the tumbling
; sprites of Sabreman. The sprite id is #N$18 plus bits 1 and 2 of the tick
; counter at #R$8ED6, so the frames follow each other as time passes.
; .
; He tumbles after the stalactite or a creature has hit him and when he bumps
; into a side wall while he is falling. The routine decreases the countdown,
; checks for contact with the bubbles and the creatures (which push him sideways
; with an x velocity of #N$02 or #N$FE), moves him sideways and applies gravity
; in the same way as #R$A6A6, and goes on at #R$A7B5 once the y
; position is less than #N$9F.
; .
; Unlike the falling handler the y velocity here has a limit of #N$76.
;
; IX Object record of Sabreman
@label=Handle_Sabreman_Tumbling
c$A925 CALL $989F      ; Remember the position and sprite id of Sabreman.
; This entry point is used by the routines at #R$A5F1, #R$A6A6 and #R$E8A2.
; .
; Deal with the special states in the same way as #R$A433.
@label=Continue_Sabreman_Tumbling
*$A928 BIT 6,(IX+$0F)  ; {Jump to #R$B72C if Sabreman is being carried (bit 6 of the redraw
 $A92C JP NZ,$B72C     ; flags).}
 $A92F BIT 7,(IX+$0F)  ; {Jump to #R$A406 if Sabreman is tumbling (bit 7 of the
 $A933 JP NZ,$A406     ; redraw flags).}
; Read the world map entry and decrease the countdown unless it is zero.
 $A936 CALL $98CC      ; Read the world map entry of the room.
 $A939 LD A,(IX+$0A)   ; Fetch the countdown of Sabreman.
 $A93C AND A           ; {Jump to #R$A942 if the countdown is zero.
 $A93D JR Z,$A942      ; }
 $A93F DEC (IX+$0A)    ; Decrease the countdown of Sabreman.
@label=Handle_Sabreman_Tumbling_Save_Room_Flags
*$A942 LD A,E          ; {Store the room flags in #R$AAAC.
 $A943 LD ($AAAC),A    ; }
; Check for contact with the bubbles and the creatures.
 $A946 CALL $E1B4      ; Check for contact with the bubbles.
 $A949 BIT 2,C         ; {Jump to #R$A97A if Sabreman touches a bubble (bit 2 of #REGc is
 $A94B JR NZ,$A97A     ; set).}
 $A94D PUSH DE         ; Stash the world map entry on the stack.
 $A94E CALL $B43E      ; Check for contact with the creatures.
 $A951 POP DE          ; Restore the world map entry from the stack.
 $A952 BIT 2,C         ; {Jump to #R$A995 if Sabreman touches no creature (bit 2 of #REGc is
 $A954 JR Z,$A995      ; not set).}
@label=Handle_Sabreman_Tumbling_Creature_Check_Side
*$A956 BIT 0,C         ; {Jump to #R$A96A if he is touching the middle of it (bit 0 of #REGc
 $A958 JR Z,$A96A      ; is clear).}
 $A95A BIT 1,C         ; {Jump to #R$A995 if he is on top of the edge of it (bit 1 of #REGc is
 $A95C JR NZ,$A995     ; set).}
@label=Handle_Sabreman_Tumbling_Creature_Bounce
*$A95E BIT 7,C         ; {Jump to #R$A966 if he is on the left of it (bit 7 of #REGc is
 $A960 JR Z,$A966      ; clear).}
 $A962 LD B,$02        ; Set the new x velocity to #N$02 (pushed to the right).
 $A964 JR $A987        ; Jump to #R$A987.
@label=Handle_Sabreman_Tumbling_Creature_Bounce_Left
*$A966 LD B,$FE        ; Set the new x velocity to #N$FE (pushed to the left).
 $A968 JR $A987        ; Jump to #R$A987.
@label=Handle_Sabreman_Tumbling_Creature_Check_Top
*$A96A BIT 1,C         ; {Jump to #R$A95E and push him away sideways if he is not on top of it
 $A96C JR Z,$A95E      ; (bit 1 of #REGc is clear).}
 $A96E LD A,B          ; {Set the y position so that Sabreman stands on top of
 $A96F DEC A           ; the creature.
 $A970 NEG             ;
 $A972 ADD A,$A0       ;
 $A974 LD (IX+$03),A   ; }
 $A977 JP $A8A0        ; Jump to #R$A8A0.
@label=Handle_Sabreman_Tumbling_Bubble_Contact
*$A97A LD A,C          ; Copy the bubble contact result to #REGa.
 $A97B AND %00000011   ; Keep only bits 0 and 1.
 $A97D CP $02          ; {Jump to #R$A956 unless he is on top of the middle of the bubble (the
 $A97F JR NZ,$A956     ; result is #N$02).}
 $A981 LD (IX+$09),$00 ; Stop him falling by setting the y velocity to #N$00.
 $A985 JR $A96A        ; Jump to #R$A96A.
@label=Handle_Sabreman_Tumbling_Set_Velocity
*$A987 LD A,B          ; Copy the new x velocity to #REGa.
 $A988 XOR (IX+$06)    ; Combine it with the old x velocity using XOR to find out if the
                       ; direction has changed.
 $A98B LD (IX+$06),B   ; Set the new x velocity of Sabreman.
 $A98E AND %10000000   ; Keep only bit 7 (set when the direction has changed).
 $A990 EXX             ; Switch to the shadow registers to keep #REGbc, #REGde
                       ; and #REGhl.
 $A991 CALL NZ,$A07D   ; Play a low tone if the direction has changed.
 $A994 EXX             ; Switch back to the main registers.
; Combine the room flags with the contact flags and clear the contact
; flags. The sprite id is set to #N$18 plus bits 1 and 2 of the tick counter.
@label=Handle_Sabreman_Tumbling_Combine_Flags
*$A995 LD A,E          ; {Combine the contact flags of Sabreman with the contact flags of the
 $A996 OR (IX+$0B)     ; room.
 $A999 LD E,A          ; }
 $A99A XOR A           ; {Clear the contact flags of Sabreman.
 $A99B LD (IX+$0B),A   ; }
 $A99E LD A,($8ED6)    ; Fetch the tick counter from #R$8ED6.
 $A9A1 RRA             ; Rotate the tick counter right, so that the frame changes every other
                       ; tick.
 $A9A2 AND %00000011   ; Keep only bits 0-1.
 $A9A4 ADD A,$18       ; Add #N$18 to make the sprite id of a tumbling frame.
 $A9A6 LD (IX+$00),A   ; Set the sprite id of Sabreman.
 $A9A9 LD A,(IX+$06)   ; Fetch the x velocity of Sabreman.
 $A9AC AND A           ; Test the x velocity.
; Move Sabreman sideways. This is done when the x velocity is not zero or
; the x position is less than #N$80.
 $A9AD LD A,(IX+$01)   ; Fetch the x position of Sabreman.
 $A9B0 JR NZ,$A9B6     ; Jump to #R$A9B6 if he is moving sideways (the x velocity is not
                       ; zero).
 $A9B2 BIT 7,A         ; {Jump to #R$A9C1 if he is in the left half of the room (bit 7 of the
 $A9B4 JR Z,$A9C1      ; x position is clear).}
@label=Handle_Sabreman_Tumbling_Move_Sideways
*$A9B6 ADD A,(IX+$06)  ; Add the x velocity of Sabreman.
 $A9B9 LD (IX+$01),A   ; Store the new x position of Sabreman.
 $A9BC BIT 7,A         ; {Jump to #R$A8EF if he is in the right half of the room (bit 7 of the
 $A9BE JP NZ,$A8EF     ; x position is set).}
@label=Handle_Sabreman_Tumbling_Check_Left_Edge
*$A9C1 CP $18          ; {Jump to #R$A9F5 if he is clear of the left wall (x position #N$18 or
 $A9C3 JP NC,$A9F5     ; more).}
 $A9C6 BIT 6,E         ; {Jump to #R$A9D8 if the left wall is not solid (bit 6 of #REGe is
 $A9C8 JR Z,$A9D8      ; clear).}
 $A9CA LD A,(IX+$06)   ; Fetch the x velocity of Sabreman.
 $A9CD NEG             ; Negate the x velocity, so that he bounces off the
                       ; wall.
 $A9CF LD (IX+$06),A   ; Store the new x velocity of Sabreman.
 $A9D2 LD (IX+$01),$18 ; Stop him at the left wall by setting the x position to
                       ; #N$18.
 $A9D6 JR $A9F5        ; Jump to #R$A9F5.
@label=Handle_Sabreman_Tumbling_No_Left_Wall
*$A9D8 EX AF,AF'       ; {Mark the ceiling and the floor as solid (bits 0 and 4 of the contact
 $A9D9 LD A,$11        ; flags of Sabreman), as he is in the gap in the wall, keeping the new x
 $A9DB OR (IX+$0B)     ; position in #REGaf'.
 $A9DE LD (IX+$0B),A   ;
 $A9E1 EX AF,AF'       ; }
 $A9E2 SET 4,E         ; Mark the room as having a floor (bit 4 of #REGe).
 $A9E4 CP $08          ; {Jump to #R$A9F5 if he has not left the room (x position #N$08 or
 $A9E6 JR NC,$A9F5     ; more).}
 $A9E8 DEC (IX+$02)    ; Decrease the room x, to go to the room on the left.
 $A9EB LD (IX+$01),$E7 ; Put him at the right edge of the next room (x position
                       ; #N$E7).
 $A9EF CALL $9906      ; Draw the new room.
 $A9F2 JP $96CB        ; Jump to #R$96CB.
; This entry point is used by the routine at #R$A8EF.
; .
; Apply gravity. The y velocity is increased by #N$02 each time up to a
; limit of #N$76, and the y position is changed by the y velocity divided by
; #N$10. A y position of #N$9F or more sends him to #R$A89C when the
; room has a floor.
@label=Apply_Tumbling_Gravity
*$A9F5 LD A,(IX+$09)   ; Fetch the y velocity of Sabreman.
 $A9F8 BIT 7,A         ; {Jump to #R$AA00 if he is moving up (bit 7 of the y
 $A9FA JR NZ,$AA00     ; velocity is set).}
 $A9FC CP $76          ; {Jump to #R$AA06 if he is falling at full speed (the y velocity is
 $A9FE JR NC,$AA06     ; #N$76 or more).}
@label=Apply_Tumbling_Gravity_Increase_Velocity
*$AA00 INC (IX+$09)    ; Increase the y velocity (gravity pulls him down).
 $AA03 INC (IX+$09)    ; Increase the y velocity again.
@label=Apply_Tumbling_Gravity_Move_Vertically
*$AA06 SRA A           ; {Divide the y velocity by sixteen, keeping the sign.
 $AA08 SRA A           ;
 $AA0A SRA A           ;
 $AA0C SRA A           ; }
 $AA0E ADD A,(IX+$03)  ; Add the y position of Sabreman to get the new y
                       ; position.
 $AA11 LD (IX+$03),A   ; Store the new y position of Sabreman.
 $AA14 CP $9F          ; {Jump to #R$A7B5 if he has not reached the bottom of the room (the y
 $AA16 JP C,$A7B5      ; position is less than #N$9F).}
 $AA19 EX AF,AF'       ; {Mark both side walls as solid (bits 2 and 6 of the contact flags of
 $AA1A LD A,$44        ; Sabreman), keeping the new y position in #REGaf'.
 $AA1C OR (IX+$0B)     ;
 $AA1F LD (IX+$0B),A   ;
 $AA22 EX AF,AF'       ; }
 $AA23 BIT 4,E         ; {Jump to #R$AA2A if the room has no floor (bit 4 of
 $AA25 JR Z,$AA2A      ; #REGe is clear).}
 $AA27 JP $A89C        ; Jump to #R$A89C to land on the floor.
@label=Apply_Tumbling_Gravity_Check_Bottom_Edge
*$AA2A CP $BC          ; {Jump to #R$96CB if he has not reached the bottom of the room (the y
 $AA2C JP C,$96CB      ; position is less than #N$BC).}
 $AA2F INC (IX+$04)    ; Increase the room y, to go to the room below.
 $AA32 LD (IX+$03),$2C ; Put him at the top of the room below (y position
                       ; #N$2C).
 $AA36 CALL $9906      ; Draw the new room.
 $AA39 JP $96CB        ; Jump to #R$96CB.

; Sabreman Template
;
; The object record that #R$A3DD copies into the record of Sabreman.
; It sets his type to #N$09, his position to #N$40,#N$9F in the room with
; x=#N$09 and y=#N$0E, and his attribute to #N$47 (white).
@label=Sabreman_Template
g$AA3C DEFB $09,$40,$09,$9F,$0E,$47,$00,$00,$00,$00,$00,$00,$00,$00,$00,$01

; Handle Rope
;
; Handler for the object type #N$17, which is the rope that hangs from the
; ceiling of a room (see #R$AE81). It is the handler of record 3 while Sabreman
; is not holding the rope; when he grabs it the record is cleared and #R$A316
; takes over.
; .
; Each call lengthens the rope by one (the length is the word at
; #R$AAA5) until its low seven bits reach #N$38, and sets bit 0 of the
; redraw flags so that the rope gets drawn.
; .
; If the rope is swinging (the displacement in #R$AAA4 is not zero) the
; displacement moves back towards zero by #N$02 on each call and the counter in
; byte #N$06 of the record is set to #N$03. When the rope hangs straight down,
; the counter counts down to zero and the redraw flag is set for each count.
; Finally the position of the end of the rope is worked out (#R$AB78) and the
; rope is drawn (#R$AB54).
;
; IX Object record of the rope (#R$8F2A)
;
; Make the rope longer, up to a length of #N$38.
@label=Handle_Rope
c$AA4C LD HL,($AAA5)   ; Fetch the length of the rope from #R$AAA5.
 $AA4F LD A,L          ; Copy the low byte to #REGa.
 $AA50 AND $7F         ; Keep only the low seven bits.
 $AA52 CP $38          ; {Jump to #R$AA5E if the rope is already full length (the length is
 $AA54 JR NC,$AA5E     ; #N$38 or more).}
 $AA56 INC HL          ; Add one to the length, so that the rope grows.
 $AA57 LD ($AAA5),HL   ; Store the new length of the rope.
 $AA5A SET 0,(IX+$0F)  ; Set bit 0 of the redraw flags, so that the rope is
                       ; drawn.
; Make the swing die down.
@label=Handle_Rope_Fetch_Displacement
*$AA5E LD A,($AAA4)    ; Fetch the displacement of the end of the rope.
 $AA61 AND A           ; {Jump to #R$AA70 if the rope hangs straight down.
 $AA62 JR Z,$AA70      ; }
 $AA64 LD (IX+$06),$03 ; Set the swing counter to #N$03.
 $AA68 JP P,$AA8C      ; Jump to #R$AA8C if the end of the rope is displaced to the right
                       ; (the displacement is positive).
 $AA6B INC A           ; {Add two to the displacement, which moves it back
 $AA6C INC A           ; towards zero.}
 $AA6D JP P,$AA86      ; Jump to #R$AA86 if the displacement has become zero or
                       ; positive.
@label=Handle_Rope_Store_Displacement
*$AA70 LD ($AAA4),A    ; Store the displacement of the end of the rope.
 $AA73 LD A,(IX+$06)   ; Fetch the swing counter.
 $AA76 AND A           ; {Jump to #R$AA80 if the swing counter is zero.
 $AA77 JR Z,$AA80      ; }
 $AA79 DEC (IX+$06)    ; Decrease the swing counter.
 $AA7C SET 0,(IX+$0F)  ; Set bit 0 of the redraw flags, so that the rope is
                       ; drawn.
@label=Handle_Rope_Position_End
*$AA80 CALL $AB78      ; Work out the position of the end of the rope.
 $AA83 JP $AB54        ; Jump to #R$AB54 to draw the rope.
@label=Handle_Rope_Zero_Displacement
*$AA86 XOR A           ; {Set the displacement to zero, so that the rope hangs
 $AA87 LD ($AAA4),A    ; straight down.}
 $AA8A JR $AA70        ; Jump to #R$AA70.
@label=Handle_Rope_Reduce_Positive
*$AA8C DEC A           ; {Subtract two from the displacement, which moves it back towards
 $AA8D DEC A           ; zero.}
 $AA8E JP M,$AA86      ; Jump to #R$AA86 if the displacement has become
                       ; negative.
 $AA91 JR $AA70        ; Jump to #R$AA70.

; Line Step Count
;
; The difference between the y positions of the two end points of the line
; that #R$ACAB sets up. It is the number of steps of the line, which has one
; step for each pixel row.
@label=Line_Step_Count
g$AA93 DEFB $00

; Line Direction Flags
;
; The direction of the line that #R$ACAB sets up. Bit 0 is set when the y
; position in #REGh is less than the y position in #REGd, and bit 1 is set when
; the x position in #REGl is less than the x position in #REGe.
@label=Line_Direction_Flags
g$AA94 DEFB $00

; Rope End Position
;
; The position of the end of the rope, that #R$AB78 works out. The low
; byte is the x position and the high byte is the y position. The x position is
; the displacement of the rope (#R$AAA4) plus #N$80.
@label=Rope_End_Position
g$AA95 DEFB $00      ; The x position.
@label=Rope_End_Position_Y
 $AA96 DEFB $00      ; The y position.

; Previous Rope End Position
;
; The position of the end of the rope when it was last drawn by #R$AB54,
; which erases the rope there. The low byte is the x position and the high byte
; is the y position. It is set to zero when a rope is set up (see #R$AE81).
@label=Previous_Rope_End_Position
g$AA97 DEFW $0000

; Unused
;
; Not used by the game.
g$AA99 DEFB $00,$00,$00,$00,$00,$00,$00

; Main Line Fraction
;
; The fraction that is carried from step to step by the line that #R$AD02
; draws with the main register set.
@label=Main_Line_Fraction
g$AAA0 DEFB $00

; Shadow Line Fraction
;
; The fraction that is carried from step to step by the line that #R$AD02
; draws with the shadow register set.
@label=Shadow_Line_Fraction
g$AAA1 DEFB $00

; Rope Velocity
;
; The horizontal velocity of the end of the rope. The left and right
; controls change it by #N$02 (see #R$AAB0) and #R$ABE5 moves it towards zero.
; #R$A365 gives it to Sabreman as his x velocity.
@label=Rope_Velocity
g$AAA2 DEFB $00

; Rope Displacement
;
; The displacement of the end of the rope from the vertical, as a word.
; The low byte is a fraction. The high byte, at #N$AAA4, is the displacement in
; pixels (it is negative when the rope swings to the left). It is zero when the
; rope hangs straight down.
@label=Rope_Displacement
g$AAA3 DEFB $00      ; The fraction.
@label=Rope_Displacement_Pixels
 $AAA4 DEFB $00      ; The displacement in pixels.

; Rope Length
;
; The length of the rope, as a word. #R$AA4C makes the low byte grow to
; #N$38 when a rope is first drawn, and #R$AAF4 and #R$AB30 change it when
; Sabreman climbs down or up. Each time the length passes a multiple of #N$80
; the rope reaches the next room down.
@label=Rope_Length
g$AAA5 DEFB $60      ; The low byte.
@label=Rope_Length_High_Byte
 $AAA6 DEFB $00      ; The high byte.

; Rope Anchor Position
;
; The position of the point where the rope hangs from, which #R$AB78 works
; out. The low byte is the x position (it is always #N$80) and the high byte is
; the y position.
@label=Rope_Anchor_Position
g$AAA7 DEFW $0000

; Previous Rope Anchor Position
;
; The position of the point where the rope hung from when #R$AB54 last
; drew it.
@label=Previous_Rope_Anchor_Position
g$AAA9 DEFW $0000

; Fire Key Flag
;
; The handlers of Sabreman set this to #N$FF while the fire key is not
; pressed. #R$B4D1 counts it up while a weapon is in flight and throws
; a new weapon only when its low three bits are zero.
@label=Fire_Key_Flag
g$AAAB DEFB $00

; Room Flags
;
; The flags of the room that Sabreman is in, which are the first byte of
; its world map entry (see #R$7000). The handlers of Sabreman keep it up to
; date. The main loop tests bit 4 (the floor) at #R$91C0(#N$91FF) and #R$DF58
; tests bit 0 (the ceiling).
@label=Room_Flags
g$AAAC DEFB $00

; Skip Rope Push
;
; Used by the routine at #R$AAB0.
; .
; Used by #R$AAB0 when the end of the rope has already swung as far as the
; length of the rope allows, so that the left and right controls are ignored. It
; restores the controls from #REGaf' and carries on at #R$AAE1.
@label=Skip_Rope_Push
c$AAAD EX AF,AF'     ; Fetch the controls again from #REGaf'.
 $AAAE JR $AAE1      ; Jump to #R$AAE1 without pushing the rope.

; Update Rope
;
; Used by the routines at #R$A316 and #R$A6A6.
; .
; Reads the controls and updates the rope that Sabreman hangs from.
; .
; The left and right controls (bits 0 and 1 of the controls, which are clear
; when the control is used) push the end of the rope by changing the velocity in
; #R$AAA2 by #N$02. That is only done while the displacement of the rope
; (#R$AAA4) is not more than the length of the rope divided by #N$08,
; with a maximum of #N$08.
; .
; The down and up controls (bits 2 and 3) make the rope longer, which lowers
; Sabreman, and shorter, which raises him. Then #R$ABE5 moves the rope and
; #R$AB78 works out where its end is.
;
; IX Object record of Sabreman
;
; Read the controls and find out whether the rope may be pushed.
@label=Update_Rope
c$AAB0 CALL $AE17    ; Read the controls.
 $AAB3 LD HL,$AAA2   ; Point at the velocity of the end of the rope (#R$AAA2).
 $AAB6 EX AF,AF'     ; Keep the controls in #REGaf'.
 $AAB7 LD A,($AAA4)  ; Fetch the displacement of the end of the rope.
 $AABA AND A         ; {Jump to #R$AAC0 if the displacement is positive.
 $AABB JP P,$AAC0    ; }
 $AABE NEG           ; Make the displacement positive.
@label=Update_Rope_Check_Displacement
*$AAC0 LD B,A        ; Keep the displacement in #REGb.
 $AAC1 LD A,($AAA6)  ; Fetch the high byte of the length of the rope.
 $AAC4 RRA           ; Rotate bit 0 of the high byte into the carry.
 $AAC5 LD A,($AAA5)  ; Fetch the low byte of the length of the rope.
 $AAC8 RRA           ; {Divide the length by #N$08 to work out how far the rope may be
 $AAC9 RRA           ; pushed.
 $AACA RRA           ; }
 $AACB AND %00111111 ; Keep only six bits.
 $AACD CP $08        ; {Jump to #R$AAD3 if the limit is less than #N$08.
 $AACF JR C,$AAD3    ; }
 $AAD1 LD A,$08      ; Limit the push to #N$08.
@label=Update_Rope_Check_Limit
*$AAD3 CP B          ; {Jump to #R$AAAD if the displacement is larger than the limit, as the
 $AAD4 JR C,$AAAD    ; rope cannot be pushed any further.}
; Use the left and right controls to push the end of the rope.
 $AAD6 EX AF,AF'     ; Fetch the controls again from #REGaf'.
 $AAD7 BIT 0,A       ; {Push the rope to the right if the right control is used (bit 0 of
 $AAD9 CALL Z,$AB6E  ; the controls is clear).}
 $AADC BIT 1,A       ; {Push the rope to the left if the left control is used (bit 1 of the
 $AADE CALL Z,$AB73  ; controls is clear).}
; This entry point is used by the routine at #R$AAAD.
; .
; Use the down and up controls to change the length of the rope.
@label=Update_Rope_Fetch_Length
*$AAE1 LD HL,($AAA5) ; Fetch the length of the rope.
 $AAE4 BIT 2,A       ; {Lower the rope if the down control is used (bit 2 of the controls is
 $AAE6 CALL Z,$AAF4  ; clear).}
 $AAE9 BIT 3,A       ; {Raise the rope if the up control is used (bit 3 of the controls is
 $AAEB CALL Z,$AB30  ; clear).}
 $AAEE CALL $ABE5    ; Move the rope (see #R$ABE5).
 $AAF1 JP $AB78      ; Jump to #R$AB78 to work out the position of the end of
                     ; the rope.

; Lower Rope
;
; Used by the routine at #R$AAB0.
; .
; Makes the rope longer by two, which lowers Sabreman.
; .
; When the length reaches a multiple of #N$80 he is at the bottom of the room.
; If the room has a floor he cannot go on and the length is only made longer by
; one. Otherwise the length is made longer by two more, the world map entries of
; the room and of the room below are given the second byte that marks where the
; rope runs (see #R$AE81), Sabreman moves down to the room below and the room is
; drawn.
;
; A Controls
; HL Length of the rope
; IX Object record of Sabreman
@label=Lower_Rope
c$AAF4 PUSH AF       ; Keep the controls on the stack.
 $AAF5 INC HL        ; {Make the length of the rope longer by two.
 $AAF6 INC HL        ; }
 $AAF7 LD A,L        ; Copy the low byte of the length to #REGa.
 $AAF8 AND %01111110 ; Keep only bits 1 to 6.
 $AAFA JR NZ,$AB2B   ; Jump to #R$AB2B if the rope has not reached the bottom of the room
                     ; (the length is not a multiple of #N$80).
 $AAFC CALL $98CC    ; Read the world map entry of the room.
 $AAFF LD A,E        ; Copy the room flags to #REGa.
 $AB00 LD ($AAAC),A  ; Store the room flags in #R$AAAC.
 $AB03 BIT 4,E       ; {Jump to #R$AB0A if the room has no floor (bit 4 of the room flags is
 $AB05 JR Z,$AB0A    ; clear).}
 $AB07 DEC HL        ; Make the length one shorter, as the floor stops the
                     ; rope.
 $AB08 JR $AB2B      ; Jump to #R$AB2B.
@label=Lower_Rope_Lengthen
*$AB0A INC HL        ; {Make the length longer by two, to lower the rope into the room
 $AB0B INC HL        ; below.}
 $AB0C LD ($AAA5),HL ; Store the new length of the rope.
 $AB0F ADD HL,HL     ; Double the length.
 $AB10 LD A,H        ; Copy the high byte (the number of the room along the
                     ; rope) to #REGa.
 $AB11 EX AF,AF'     ; Stash it in #REGaf'.
 $AB12 CALL $98B2    ; Find the address of the world map entry of the room.
 $AB15 INC HL        ; Point at the second byte of the entry.
 $AB16 EX AF,AF'     ; Fetch the number of the room along the rope.
 $AB17 DEC A         ; Subtract one.
 $AB18 OR %00001100  ; Set bits 2 and 3.
 $AB1A LD (HL),A     ; Store the result in the second byte of the entry of the
                     ; room.
 $AB1B LD BC,$0020   ; Set the offset to the room below (#N$0020).
 $AB1E ADD HL,BC     ; Point at the entry of the room below.
 $AB1F INC A         ; Add one to make the number of the room along the rope for the room
                     ; below.
 $AB20 AND %11111011 ; Reset bit 2.
 $AB22 LD (HL),A     ; Store it in the second byte of the entry of the room
                     ; below.
 $AB23 INC (IX+$04)  ; Move Sabreman down to the room below.
 $AB26 CALL $9906    ; Draw the new room.
 $AB29 POP AF        ; Fetch the controls again from the stack.
 $AB2A RET           ; Return.
; This entry point is used by the routine at #R$AB30.
@label=Lower_Rope_Store_Length
*$AB2B LD ($AAA5),HL ; Store the new length of the rope.
 $AB2E POP AF        ; Fetch the controls again from the stack.
 $AB2F RET           ; Return.

; Raise Rope
;
; Used by the routine at #R$AAB0.
; .
; Makes the rope shorter by two, which raises Sabreman. The length never
; gets below #N$20.
; .
; When the length falls to a multiple of #N$80 he is at the top of the room. The
; length is then made shorter by two more, the second byte of the world map
; entry of the room is cleared, Sabreman moves up to the room above and the room
; is drawn.
;
; A Controls
; HL Length of the rope
; IX Object record of Sabreman
@label=Raise_Rope
c$AB30 PUSH AF       ; Keep the controls on the stack.
 $AB31 LD A,H        ; Copy the high byte of the length to #REGa.
 $AB32 AND A         ; {Jump to #R$AB3A if the length is more than #N$FF.
 $AB33 JR NZ,$AB3A   ; }
 $AB35 LD A,L        ; Copy the low byte of the length to #REGa.
 $AB36 CP $20        ; {Jump to #R$AB2B if the rope is already at its shortest (the length
 $AB38 JR C,$AB2B    ; is less than #N$20).}
@label=Raise_Rope_Shorten
*$AB3A DEC HL        ; {Make the length of the rope shorter by two.
 $AB3B DEC HL        ; }
 $AB3C LD A,L        ; Copy the low byte of the length to #REGa.
 $AB3D AND %01111110 ; Keep only bits 1 to 6.
 $AB3F JR NZ,$AB2B   ; Jump to #R$AB2B if the rope has not reached the top of the room (the
                     ; length is not a multiple of #N$80).
 $AB41 DEC HL        ; {Make the length shorter by two, to raise the rope into the room
 $AB42 DEC HL        ; above.}
 $AB43 LD ($AAA5),HL ; Store the new length of the rope.
 $AB46 CALL $98B2    ; Find the address of the world map entry of the room.
 $AB49 INC HL        ; Point at the second byte of the entry.
 $AB4A LD (HL),$00   ; Clear the second byte of the entry.
 $AB4C DEC (IX+$04)  ; Move Sabreman up to the room above.
 $AB4F CALL $9906    ; Draw the new room.
 $AB52 POP AF        ; Fetch the controls again from the stack.
 $AB53 RET           ; Return.

; Draw Rope
;
; Used by the routines at #R$A316 and #R$AA4C.
; .
; Draws the rope in its new position and erases it from its old position.
; The drawing of a line uses XOR, so drawing the old line again removes it.
; .
; The old position of the anchor and the old end of the rope are put in the main
; register set and the new ones in the shadow register set. The new end of the
; rope is stored as the old one for the next time. #R$AD02 draws both lines.
@label=Draw_Rope
c$AB54 LD DE,($AAA9) ; Fetch the previous position of the point where the rope hangs from
                     ; (#R$AAA9).
 $AB58 LD HL,($AA97) ; Fetch the previous position of the end of the rope
                     ; (#R$AA97).
 $AB5B EXX           ; Switch to the shadow registers.
 $AB5C LD HL,($AA95) ; Fetch the new position of the end of the rope.
 $AB5F LD ($AA97),HL ; Store it as the previous position.
 $AB62 LD DE,($AAA7) ; Fetch the position of the point where the rope hangs
                     ; from.
 $AB66 LD ($AAA9),DE ; Store it as the previous position.
 $AB6A CALL $AD02    ; Draw the old rope and the new rope (see #R$AD02).
 $AB6D RET           ; Return.

; Push Rope Right
;
; Used by the routine at #R$AAB0.
; .
; Adds two to the velocity of the end of the rope.
;
; HL Address of the velocity (#R$AAA2)
; A Controls
@label=Push_Rope_Right
c$AB6E PUSH AF       ; Keep the controls on the stack.
 $AB6F INC (HL)      ; {Push the rope to the right by adding two to the
 $AB70 INC (HL)      ; velocity of its end.}
 $AB71 JR $AB76      ; Jump to #R$AB76.

; Push Rope Left
;
; Used by the routine at #R$AAB0.
; .
; Subtracts two from the velocity of the end of the rope.
;
; HL Address of the velocity (#R$AAA2)
; A Controls
@label=Push_Rope_Left
c$AB73 PUSH AF       ; Keep the controls on the stack.
 $AB74 DEC (HL)      ; {Push the rope to the left by subtracting two from the velocity of
 $AB75 DEC (HL)      ; its end.}
; This entry point is used by the routine at #R$AB6E.
@label=Push_Rope_Left_Restore_Controls
*$AB76 POP AF        ; Fetch the controls again from the stack.
 $AB77 RET           ; Return.

; Position Rope End
;
; Used by the routines at #R$AA4C and #R$AAB0.
; .
; Works out the position of the end of the rope and the position of the
; point that it hangs from.
; .
; The end of the rope is below the point that it hangs from by a depth that is
; found from the displacement of the rope (#R$AAA4) and its length
; (#R$AAA5). The routine squares the displacement, squares the length, subtracts
; the first square from the second and takes the square root of the result with
; #R$AE56. When the length is #N$100 or more, the length and the square of the
; displacement are halved before they are used.
; .
; The x position is the displacement plus #N$80, and it is stored in #R$AA95.
; The y position is stored in the byte after it. The point that the rope hangs
; from is stored in #R$AAA7: it is #N$24 pixels down at an x position of
; #N$80 when the length is less than #N$80, and #N$10 pixels down when it is
; longer.
;
; IX Object record
;
; Square the displacement.
@label=Position_Rope_End
c$AB78 LD D,$00      ; Clear the high byte of the displacement.
 $AB7A LD A,($AAA4)  ; Fetch the displacement of the end of the rope.
 $AB7D BIT 7,A       ; {Jump to #R$AB83 if it is positive.
 $AB7F JR Z,$AB83    ; }
 $AB81 NEG           ; Make it positive.
@label=Position_Rope_End_Square_Displacement
*$AB83 LD E,A        ; Copy the displacement to #REGe.
 $AB84 CALL $AC68    ; Multiply the displacement by itself.
 $AB87 PUSH HL       ; Stash the square of the displacement on the stack.
; Square the length of the rope. If the high byte of the length is not
; zero, the square of the displacement and the length are halved first.
 $AB88 LD D,$00      ; Clear the high byte of the length.
 $AB8A LD A,($AAA6)  ; Fetch the high byte of the length of the rope.
 $AB8D AND A         ; {Jump to #R$ABA0 if the length is less than #N$100.
 $AB8E JR Z,$ABA0    ; }
 $AB90 POP HL        ; Restore the square of the displacement from the stack.
 $AB91 SRL H         ; {Halve it.
 $AB93 RR L          ; }
 $AB95 PUSH HL       ; Stash it on the stack again.
 $AB96 LD HL,($AAA5) ; Fetch the length of the rope.
 $AB99 SRL H         ; {Halve it.
 $AB9B RR L          ; }
 $AB9D LD A,L        ; Copy the low byte of the halved length to #REGa.
 $AB9E JR $ABA3      ; Jump to #R$ABA3.
@label=Position_Rope_End_Short_Rope
*$ABA0 LD A,($AAA5)  ; Fetch the low byte of the length of the rope.
@label=Position_Rope_End_Square_Length
*$ABA3 LD E,A        ; Copy the length to #REGe.
 $ABA4 CALL $AC68    ; Square the length (or half of it).
 $ABA7 POP DE        ; Restore the square of the displacement from the stack.
 $ABA8 AND A         ; {Subtract the square of the displacement from the square of the
 $ABA9 SBC HL,DE     ; length.}
 $ABAB CALL $AE56    ; Take the square root, which is the depth of the end of
                     ; the rope.
 $ABAE LD A,L        ; Keep the depth of the end of the rope in #REGa.
; Work out the y position of the end of the rope and the position that the
; rope hangs from, which depend on the number of the room along the rope.
 $ABAF LD HL,($AAA5) ; Fetch the length of the rope.
 $ABB2 ADD HL,HL     ; Double it.
 $ABB3 EX AF,AF'     ; Stash the depth in #REGaf'.
 $ABB4 LD A,H        ; Copy the high byte (the number of the room along the
                     ; rope) to #REGa.
 $ABB5 AND A         ; Test the number of the room.
 $ABB6 LD DE,$2480   ; #REGde=#N$2480 (the position that the rope hangs from in the top
                     ; room).
 $ABB9 JR Z,$ABD0    ; Jump to #R$ABD0 if it is the top room.
 $ABBB LD DE,$1080   ; #REGde=#N$1080 (the position that the rope hangs from in the other
                     ; rooms).
 $ABBE LD C,$D7      ; Set the offset to take off the depth to #N$D7.
 $ABC0 BIT 0,H       ; {Jump to #R$ABC6 if bit 0 of the number of the room is
 $ABC2 JR Z,$ABC6    ; clear.}
 $ABC4 LD C,$58      ; Set the offset to take off the depth to #N$58.
@label=Position_Rope_End_Check_Room_Number
*$ABC6 EX AF,AF'     ; Fetch the depth again from #REGaf'.
 $ABC7 BIT 1,H       ; {Jump to #R$ABCD if bit 1 of the number of the room is
 $ABC9 JR Z,$ABCD    ; clear.}
 $ABCB SLA A         ; Double the depth.
@label=Position_Rope_End_Subtract_Offset
*$ABCD SUB C         ; Subtract the offset from the depth.
 $ABCE JR $ABD3      ; Jump to #R$ABD3.
@label=Position_Rope_End_Top_Room
*$ABD0 EX AF,AF'     ; Fetch the depth again from #REGaf'.
 $ABD1 ADD A,$18     ; Add #N$18 to the depth.
@label=Position_Rope_End_Store_Position
*$ABD3 ADD A,$0C     ; Add #N$0C to the result.
 $ABD5 LD ($AA96),A  ; Store it as the y position of the end of the rope.
 $ABD8 LD ($AAA7),DE ; Store the position that the rope hangs from.
 $ABDC LD A,($AAA4)  ; Fetch the displacement of the end of the rope.
 $ABDF ADD A,$80     ; Add #N$80 (the middle of the room) to make the x position of the end
                     ; of the rope.
 $ABE1 LD ($AA95),A  ; Store it as the x position of the end of the rope.
 $ABE4 RET           ; Return.

; Move Rope
;
; Used by the routine at #R$AAB0.
; .
; Makes the rope swing. The velocity of the end of the rope (#R$AAA2) is
; changed by four towards the middle of the swing (it is increased when the
; displacement is negative and decreased when it is positive) and then it is
; multiplied by #N$20 and added to the displacement (#R$AAA3).
; .
; When the rope is already at rest nothing changes. When the end of the rope is
; moving towards the middle, the change of velocity is left out on one call in
; eight (the test is made on the tick counter at #R$8ED6 for a negative
; displacement and on FRAMES for a positive one).
; .
; If the length of the rope is less than #N$80 the displacement is limited to
; the length multiplied by #N$B0 and divided by #N$100. When it would go
; further, the displacement is set to the limit and the velocity and the
; fraction are set to zero. For a longer rope the displacement is not limited.
;
; IX Object record
;
; Find out if the rope is at rest (no displacement and no velocity).
@label=Move_Rope
c$ABE5 LD A,($AAA4)  ; Fetch the displacement of the end of the rope.
 $ABE8 LD HL,$AAA2   ; Point at the velocity of the end of the rope.
 $ABEB AND A         ; {Jump to #R$ABF3 if the rope is not hanging straight down (the
 $ABEC JR NZ,$ABF3   ; displacement is not zero).}
 $ABEE EX AF,AF'     ; Keep the displacement in #REGaf'.
 $ABEF LD A,(HL)     ; Fetch the velocity of the end of the rope.
 $ABF0 AND A         ; {Return if the rope is at rest (the velocity is zero).
 $ABF1 RET Z         ; }
 $ABF2 EX AF,AF'     ; Fetch the displacement again from #REGaf'.
; Change the velocity. A negative displacement adds four to it and a
; positive one subtracts four.
@label=Move_Rope_Change_Velocity
*$ABF3 AND %10000000 ; Keep only bit 7 (the sign of the displacement).
 $ABF5 JR Z,$AC08    ; Jump to #R$AC08 if the displacement is positive.
 $ABF7 BIT 7,(HL)    ; {Jump to #R$AC02 if the velocity is negative.
 $ABF9 JR NZ,$AC02   ; }
 $ABFB LD A,($8ED6)  ; Fetch the tick counter from #R$8ED6.
 $ABFE AND %00000111 ; Keep only bits 0 to 2.
 $AC00 JR Z,$AC17    ; Jump to #R$AC17 without changing the velocity if the result is zero
                     ; (once in every eight passes).
@label=Move_Rope_Add_Four
*$AC02 INC (HL)      ; {Add four to the velocity, to pull the end of the rope back towards
 $AC03 INC (HL)      ; the middle.
 $AC04 INC (HL)      ;
 $AC05 INC (HL)      ; }
 $AC06 JR $AC17      ; Jump to #R$AC17.
@label=Move_Rope_Positive_Displacement
*$AC08 BIT 7,(HL)    ; {Jump to #R$AC13 if the velocity is positive.
 $AC0A JR Z,$AC13    ; }
 $AC0C LD A,($5C78)  ; Fetch the low byte of FRAMES.
 $AC0F AND %00000111 ; Keep only bits 0 to 2.
 $AC11 JR Z,$AC17    ; Jump to #R$AC17 without changing the velocity if the result is zero
                     ; (once in every eight passes).
@label=Move_Rope_Subtract_Four
*$AC13 DEC (HL)      ; {Subtract four from the velocity, to pull the end of the rope back
 $AC14 DEC (HL)      ; towards the middle.
 $AC15 DEC (HL)      ;
 $AC16 DEC (HL)      ; }
; Multiply the velocity by #N$20 and add it to the displacement.
@label=Move_Rope_Move_End
*$AC17 LD A,(HL)     ; Fetch the velocity of the end of the rope.
 $AC18 AND A         ; Test the sign of the velocity.
 $AC19 LD D,$00      ; Clear the high byte of the velocity.
 $AC1B JP P,$AC20    ; Jump to #R$AC20 if the velocity is positive.
 $AC1E LD D,$FF      ; Set the high byte of the velocity to #N$FF to extend the
                     ; sign.
@label=Move_Rope_Sign_Extended
*$AC20 LD E,A        ; Copy the velocity to #REGe.
 $AC21 EX DE,HL      ; Move the velocity (as a word) to #REGhl.
 $AC22 ADD HL,HL     ; {Multiply the velocity by #N$20.
 $AC23 ADD HL,HL     ;
 $AC24 ADD HL,HL     ;
 $AC25 ADD HL,HL     ;
 $AC26 ADD HL,HL     ; }
 $AC27 LD DE,($AAA3) ; Fetch the displacement (the fraction is in the low
                     ; byte).
 $AC2B ADD HL,DE     ; Add the velocity to the displacement.
 $AC2C PUSH HL       ; Stash the new displacement on the stack.
 $AC2D LD DE,$00B0   ; Set the multiplier for the limit of the displacement to
                     ; #N$00B0.
 $AC30 LD HL,($AAA5) ; Fetch the length of the rope.
 $AC33 SRL H         ; {Halve the length of the rope.
 $AC35 RR L          ; }
 $AC37 LD A,L        ; Copy the low byte to #REGa.
 $AC38 AND %11000000 ; Keep only bits 6 and 7.
 $AC3A JR Z,$AC3F    ; Jump to #R$AC3F if the length is less than #N$80.
 $AC3C POP HL        ; Fetch the new displacement again from the stack.
 $AC3D JR $AC59      ; Jump to #R$AC59 to store it without a limit.
; Find the limit of the displacement, which is the length of the rope
; multiplied by #N$B0 and divided by #N$100.
@label=Move_Rope_Find_Limit
*$AC3F LD A,($AAA5)  ; Fetch the low byte of the length of the rope.
 $AC42 CALL $AC68    ; Multiply it by #N$B0.
 $AC45 LD A,H        ; Copy the high byte of the result (the limit) to #REGa.
 $AC46 POP HL        ; Fetch the new displacement again from the stack.
 $AC47 BIT 7,H       ; {Jump to #R$AC52 if the displacement is negative.
 $AC49 JR NZ,$AC52   ; }
 $AC4B CP H          ; {Jump to #R$AC5D if the displacement is beyond the
 $AC4C JR C,$AC5D    ; limit.}
 $AC4E LD ($AAA3),HL ; Store the new displacement.
 $AC51 RET           ; Return.
@label=Move_Rope_Negative_Limit
*$AC52 NEG           ; Make the limit negative.
 $AC54 CP H          ; {Jump to #R$AC59 if the displacement is at the limit.
 $AC55 JR Z,$AC59    ; }
 $AC57 JR NC,$AC5D   ; Jump to #R$AC5D if the displacement is beyond the limit.
@label=Move_Rope_Store_Displacement
*$AC59 LD ($AAA3),HL ; Store the new displacement.
 $AC5C RET           ; Return.
; The displacement is beyond the limit. Set it to the limit and stop the
; swing.
@label=Move_Rope_Beyond_Limit
*$AC5D LD ($AAA4),A  ; Set the displacement to the limit.
 $AC60 XOR A         ; {Clear the fraction of the displacement and the
 $AC61 LD ($AAA3),A  ; velocity.
 $AC64 LD ($AAA2),A  ; }
 $AC67 RET           ; Return.

; Multiply A By DE
;
; Used by the routines at #R$AB78 and #R$ABE5.
; .
; Multiplies #REGa by #REGde, by adding #REGde to the product for each bit
; of #REGa that is set. The product is a word.
;
;   A The first number
;   DE The second number
; O:HL Product
@label=MultiplyAByDE
c$AC68 LD HL,$0000   ; Set the product so far to #N$0000.
 $AC6B LD B,$08      ; Set the number of bits to #N$08.
@label=MultiplyAByDE_Loop
*$AC6D ADD HL,HL     ; Double the product.
 $AC6E RLCA          ; Move the next bit of the first number into the carry.
 $AC6F JR NC,$AC72   ; Jump to #R$AC72 if the bit is clear.
 $AC71 ADD HL,DE     ; Add the second number to the product.
@label=MultiplyAByDE_Next
*$AC72 DJNZ $AC6D    ; Decrease the bit counter and loop back until all eight bits of the
                     ; first number have been used.
 $AC74 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CE0D }
; { #ATICATAC$9AAD }
; { #GUNFRIGHT$D03E }
; { #KNIGHTLORE$D4F9 }
; { #NIGHTSHADE$E0EE }
; { #SABREWULF$BC5A }
; { #TRANZAM$6F2F }
; LIST#

; Divide
;
; Used by the routines at #R$9FA3 and #R$ACAB.
; .
; Divides #REGh multiplied by #N$100 by #REGde, one bit at a time. The
; quotient has eight bits, so #REGde must be greater than #REGh for the answer
; to be right. The quotient is built up in the shadow registers and the working
; is done in the main registers, so the shadow registers are not preserved.
; .
; The line drawing code uses it to find how far to move across for each pixel
; moved down.
;
;   H Dividend (it is multiplied by #N$100)
;   DE Divisor
; O:HL Quotient
; O:DE Remainder
@label=Divide
c$AC75 LD L,H        ; Copy the dividend to #REGl.
 $AC76 LD H,$00      ; Clear #REGh.
 $AC78 EXX           ; Switch to the shadow registers.
 $AC79 LD HL,$0000   ; #REGhl'=#N$0000 (the quotient so far).
 $AC7C LD B,$08      ; #REGb'=#N$08 (the number of bits).
@label=Divide_Loop
*$AC7E EXX           ; Switch to the main registers.
 $AC7F SLA L         ; {Shift the dividend left.
 $AC81 RL H          ;
 $AC83 PUSH HL       ;
 $AC84 AND A         ; }
 $AC85 SBC HL,DE     ; Try to subtract the divisor.
 $AC87 JR C,$AC95    ; Jump to #R$AC95 if it does not go.
 $AC89 POP AF        ; Discard the stashed dividend.
 $AC8A EXX           ; Switch to the shadow registers.
 $AC8B ADD HL,HL     ; Shift the quotient left.
 $AC8C INC HL        ; Add one for the bit.
@label=Divide_Next
*$AC8D DJNZ $AC7E    ; Decrease the bit counter and loop back until all eight bits have
                     ; been done.
 $AC8F PUSH HL       ; Stash the quotient on the stack.
 $AC90 EXX           ; Switch to the main registers.
 $AC91 LD E,L        ; Copy the remainder to #REGde.
 $AC92 LD D,H        ; Copy #REGh to #REGd.
 $AC93 POP HL        ; Restore #REGhl from the stack.
 $AC94 RET           ; Restore the quotient from the stack.
@label=Divide_Restore
*$AC95 POP HL        ; Restore the stashed dividend (the subtraction is
                     ; undone).
 $AC96 EXX           ; Switch to the shadow registers.
 $AC97 ADD HL,HL     ; Shift the quotient left.
 $AC98 JR $AC8D      ; Jump to #R$AC8D.
; View the equivalent code in;
; #LIST
; { #ATICATAC$A379 }
; LIST#

; Plot Pixel
;
; Used by the routines at #R$AD02 and #R$ADB0.
; .
; Plots a pixel in the display file by combining it with the byte that is
; already there using XOR, so plotting the same pixel again erases it. Nothing
; is plotted when the address is not in the display file (when the high byte is
; #N$58 or more).
; .
; The pixel within the byte is bit #N$07 less the lowest three bits of the x
; position.
;
; HL Display file address
; C x position (only the lowest three bits are used)
@label=Plot_Pixel
c$AC9A LD A,H        ; Fetch the high byte of the address.
 $AC9B CP $58        ; {Return if it is not in the display file.
 $AC9D RET NC        ; }
 $AC9E LD A,C        ; Fetch the x position.
 $AC9F AND %00000111 ; Keep only the lowest three bits.
 $ACA1 INC A         ; Add one to make the number of rotations.
 $ACA2 LD B,A        ; Store the number in #REGb.
 $ACA3 XOR A         ; Start with an empty byte.
 $ACA4 SCF           ; Set the carry flag, which is the pixel.
@label=Plot_Pixel_Rotate_Loop
*$ACA5 RRA           ; Rotate the pixel along the byte.
 $ACA6 DJNZ $ACA5    ; Decrease the rotation counter and loop back until the pixel is in
                     ; the right place.
 $ACA8 XOR (HL)      ; Combine the pixel with the display file byte using XOR.
 $ACA9 LD (HL),A     ; Write the result back to the display file.
 $ACAA RET           ; Return.

; Set Up Line
;
; Used by the routine at #R$AD02.
; .
; Works out what is needed to draw a line that goes up the screen from the
; first point (the start) to the second point, one pixel row at a time. The
; number of steps is the difference between the y positions, and the amount that
; the x position changes for each step is the difference between the x positions
; multiplied by #N$100 and divided by the number of steps (see #R$AC75).
; .
; The step count is stored in #R$AA93 and the direction flags in #R$AA94 (see
; there). The slope is made negative when the line goes to the left, and it is
; halved once for each room that the rope is long (the high byte of the length
; multiplied by two), which scales it to the length of the rope.
;
;   HL Start of the line (x position in #REGl, y position in #REGh)
;   DE End of the line (#REGe is the x position and #REGd is the y position)
; O:A Low byte of the slope
; O:B Number of steps
; O:C Direction of the y position (#N$01 or #N$FF)
; O:DE Slope (x position change per step, multiplied by #N$100)
; O:HL Start of the line
;
; Find the difference between the y positions (in #REGb) and between the x
; positions, and the direction flags.
@label=Set_Up_Line
c$ACAB LD C,$00      ; Clear the direction flags.
 $ACAD LD A,H        ; Fetch the y position of the start.
 $ACAE SUB D         ; {Jump to #R$ACB5 if the difference is positive.
 $ACAF JR NC,$ACB5   ; }
 $ACB1 NEG           ; Make the difference positive.
 $ACB3 SET 0,C       ; Set bit 0 of the direction flags.
@label=Set_Up_Line_Store_Y_Difference
*$ACB5 LD B,A        ; Copy the difference to #REGb.
 $ACB6 LD A,L        ; Fetch the x position of the start.
 $ACB7 SUB E         ; {Jump to #R$ACBE if the difference is positive.
 $ACB8 JR NC,$ACBE   ; }
 $ACBA NEG           ; Make the difference positive.
 $ACBC SET 1,C       ; Set bit 1 of the direction flags.
@label=Set_Up_Line_Store_X_Difference
*$ACBE EX AF,AF'     ; Stash the difference between the x positions in #REGaf'.
 $ACBF LD A,C        ; Fetch the direction flags.
 $ACC0 LD ($AA94),A  ; Store the direction flags.
 $ACC3 LD A,B        ; Fetch the difference between the y positions.
 $ACC4 LD ($AA93),A  ; Store the number of steps.
 $ACC7 EX AF,AF'     ; Restore the difference between the x positions from
                     ; #REGaf'.
; Divide the difference between the x positions by the number of steps.
 $ACC8 PUSH HL       ; Stash the start of the line on the stack.
 $ACC9 LD E,B        ; Copy the number of steps to #REGe.
 $ACCA LD D,$00      ; Make #REGd zero.
 $ACCC LD L,D        ; Clear #REGl.
 $ACCD LD H,A        ; Copy the difference between the x positions to #REGh.
 $ACCE CALL $AC75    ; Divide the difference by the number of steps (the result is the
                     ; slope).
 $ACD1 LD A,($AA94)  ; Fetch the direction flags.
 $ACD4 BIT 1,A       ; {Jump to #R$ACDB if bit 1 is set (the line goes to the
 $ACD6 JR NZ,$ACDB   ; right).}
 $ACD8 CALL $ADD6    ; Make the slope negative.
@label=Set_Up_Line_Check_Vertical_Direction
*$ACDB LD A,($AA94)  ; Fetch the direction flags.
 $ACDE BIT 0,A       ; Test bit 0 of the direction flags.
 $ACE0 LD C,$01      ; Set the vertical step of the line to #N$01.
 $ACE2 JR NZ,$ACE6   ; Jump to #R$ACE6 if bit 0 is set.
 $ACE4 LD C,$FF      ; Set the vertical step of the line to #N$FF.
@label=Set_Up_Line_Store_Slope
*$ACE6 EX DE,HL      ; Move the slope to #REGde and the remainder to #REGhl.
 $ACE7 POP HL        ; Restore the start of the line from the stack.
 $ACE8 LD A,($AA93)  ; Fetch the number of steps.
 $ACEB LD B,A        ; Copy it to #REGb.
 $ACEC PUSH BC       ; Stash the number of steps and the direction on the
                     ; stack.
; Halve the slope once for each room that the rope is long.
 $ACED LD BC,($AAA5) ; Fetch the length of the rope.
 $ACF1 RL C          ; {Double the length.
 $ACF3 RL B          ; }
 $ACF5 LD A,B        ; Copy the high byte to #REGa.
 $ACF6 AND A         ; {Jump to #R$ACFF if the rope is not longer than a room.
 $ACF7 JR Z,$ACFF    ; }
@label=Set_Up_Line_Halve_Slope_Loop
*$ACF9 SRA D         ; {Halve the slope.
 $ACFB RR E          ; }
 $ACFD DJNZ $ACF9    ; Decrease the room counter and loop back until the slope has been
                     ; halved for each room.
@label=Set_Up_Line_Finish
*$ACFF POP BC        ; Restore the number of steps and the direction from the
                     ; stack.
 $AD00 LD A,E        ; Copy the low byte of the slope to #REGa.
 $AD01 RET           ; Return.

; Draw Line
;
; Used by the routine at #R$AB54.
; .
; Draws two lines at the same time, both going up the screen. The main
; registers hold the start and the end of the first line, and the shadow
; registers hold the start and the end of the second line. The rope uses it to
; erase the old rope and draw the new one in the same pass (see #R$AB54), as
; every pixel is plotted with XOR.
; .
; Each line is set up with #R$ACAB. The two lines are drawn together, one step
; each at a time, until one of them is finished, and then the other is finished
; on its own. Each step is the plotting of a pixel with #R$AC9A, a move of the x
; position by the slope and a move up by one pixel line with #R$AE71.
; .
; When the object is the rope (type #N$17) and bit 0 of its redraw flags is
; clear, the lines are limited to one step each, and the flag is reset.
; .
; At the end the attribute of every cell that the line goes through is set to
; #N$47 (white ink on black paper), starting at a cell near the end of the rope
; and moving up by one cell for each eight steps.
;
; HL Start of the first line
; DE End of the first line
; HL' Start of the second line
; DE' End of the second line
; IX Object record
;
; Set up the second line (the shadow registers) and then the first line
; (the main registers). The fractions of the lines are kept in #R$AAA1 and
; #R$AAA0.
@label=Draw_Line
c$AD02 PUSH HL        ; Stash the start of the first line on the stack.
 $AD03 PUSH DE        ; Stash the end of the first line on the stack.
 $AD04 EXX            ; Switch to the shadow registers.
 $AD05 CALL $ACAB     ; Set up the second line.
 $AD08 LD ($AAA1),A   ; Store the low byte of the slope as the fraction of the
                      ; second line.
 $AD0B LD C,L         ; Copy the x position of the start to #REGc.
 $AD0C CALL $ADF8     ; Get the display file address of the start.
 $AD0F EXX            ; Switch to the main registers.
 $AD10 POP DE         ; Restore the end of the first line from the stack.
 $AD11 POP HL         ; Restore the start of the first line from the stack.
 $AD12 EXX            ; Switch to the shadow registers.
 $AD13 PUSH HL        ; Stash the display file address of the second line on
                      ; the stack.
 $AD14 PUSH DE        ; Stash the slope of the second line on the stack.
 $AD15 PUSH BC        ; Stash the steps of the second line on the stack.
 $AD16 EXX            ; Switch to the main registers.
 $AD17 CALL $ACAB     ; Set up the first line.
 $AD1A LD ($AAA0),A   ; Store the low byte of the slope as the fraction of the
                      ; first line.
 $AD1D LD C,L         ; Copy the x position of the start to #REGc.
 $AD1E CALL $ADF8     ; Get the display file address of the start.
 $AD21 EXX            ; Switch to the shadow registers.
 $AD22 POP BC         ; Restore the steps of the second line from the stack.
 $AD23 POP DE         ; Restore the slope of the second line from the stack.
 $AD24 POP HL         ; Restore the display file address of the second line
                      ; from the stack.
; For the rope, limit both lines to one step unless bit 0 of the redraw
; flags is set. Then reset that bit.
 $AD25 LD A,(IX+$00)  ; Fetch the sprite id.
 $AD28 CP $17         ; {Jump to #R$AD3C if the object is not the rope.
 $AD2A JR NZ,$AD3C    ; }
 $AD2C BIT 0,(IX+$0F) ; {Jump to #R$AD38 if bit 0 of the redraw flags is set.
 $AD30 JR NZ,$AD38    ; }
 $AD32 LD B,$01       ; Limit the second line to one step.
 $AD34 EXX            ; Switch to the main registers.
 $AD35 LD B,$01       ; Limit the first line to one step.
 $AD37 EXX            ; Switch to the shadow registers.
@label=Draw_Line_Reset_Redraw_Flag
*$AD38 RES 0,(IX+$0F) ; Reset bit 0 of the redraw flags.
; Draw a step of each line in turn, until one of the lines has ended.
@label=Draw_Line_Step_Loop
*$AD3C CALL $ADB0     ; Draw a step of the second line.
 $AD3F EXX            ; Switch to the main registers.
 $AD40 PUSH BC        ; Stash the steps and the direction of the first line on
                      ; the stack.
 $AD41 CALL $AC9A     ; Plot a pixel of the first line.
 $AD44 LD A,H         ; {Stash the high byte of the display file address in
 $AD45 EX AF,AF'      ; #REGaf'.}
 $AD46 LD A,($AAA0)   ; Fetch the fraction of the first line.
 $AD49 LD H,C         ; Copy the x position to #REGh.
 $AD4A LD B,L         ; Stash the low byte of the display file address in
                      ; #REGb.
 $AD4B LD L,A         ; Copy the fraction to #REGl.
 $AD4C ADD HL,DE      ; Add the slope to the x position and the fraction.
 $AD4D LD A,L         ; Copy the new fraction to #REGa.
 $AD4E LD ($AAA0),A   ; Store it as the fraction of the first line.
 $AD51 LD C,H         ; Copy the new x position to #REGc.
 $AD52 LD A,B         ; Restore the low byte of the display file address.
 $AD53 AND %11100000  ; Keep only the row bits of the low byte.
 $AD55 LD B,A         ; Store them in #REGb.
 $AD56 LD A,C         ; Copy the new x position to #REGa.
 $AD57 RRA            ; {Divide the x position by #N$08.
 $AD58 RRA            ;
 $AD59 RRA            ; }
 $AD5A AND %00011111  ; Keep only five bits to make the column.
 $AD5C OR B           ; Combine the row bits with the column.
 $AD5D LD L,A         ; Store the new low byte of the display file address in
                      ; #REGl.
 $AD5E LD A,C         ; Copy the new x position to #REGa.
 $AD5F POP BC         ; Restore the steps and the direction of the first line from the
                      ; stack.
 $AD60 LD C,A         ; Store the new x position in #REGc.
 $AD61 EX AF,AF'      ; {Restore the high byte of the display file address and store it in
 $AD62 LD H,A         ; #REGh.}
 $AD63 CALL $AE71     ; Move up a pixel line.
 $AD66 DEC B          ; {Jump to #R$AD75 if the first line has ended.
 $AD67 JR Z,$AD75     ; }
 $AD69 EXX            ; Switch to the shadow registers.
 $AD6A DJNZ $AD3C     ; Jump to #R$AD3C until the second line has ended.
; The second line has ended first, so the remaining steps of the first
; line are drawn with its fraction in #R$AAA1.
 $AD6C LD A,($AAA0)   ; Fetch the fraction of the first line.
 $AD6F LD ($AAA1),A   ; Store it as the fraction used by #R$ADB0.
 $AD72 EXX            ; Switch to the main registers.
 $AD73 JR $AD79       ; Jump to #R$AD79.
; The first line has ended first. Draw the remaining steps of the second
; line.
@label=Draw_Line_First_Line_Ended
*$AD75 EXX            ; Switch to the shadow registers.
 $AD76 DEC B          ; {Jump to #R$AD7E if the second line has ended as well.
 $AD77 JR Z,$AD7E     ; }
@label=Draw_Line_Finish_Line_Loop
*$AD79 CALL $ADB0     ; Draw a step of the line.
 $AD7C DJNZ $AD79     ; Repeat until the line has ended.
; Set the attributes of the cells that the line goes through.
@label=Draw_Line_Set_Attributes
*$AD7E EX DE,HL       ; Move the slope to #REGhl.
 $AD7F LD DE,$2000    ; #REGde=#N$2000 (one row of attribute cells, in the high
                      ; byte).
 $AD82 AND A          ; {Subtract #N$2000 from the slope.
 $AD83 SBC HL,DE      ; }
 $AD85 EX DE,HL       ; Store the result in #REGde.
 $AD86 LD HL,($AA95)  ; Fetch the position of the end of the rope.
 $AD89 INC L          ; {Move the x position on by four pixels.
 $AD8A INC L          ;
 $AD8B INC L          ;
 $AD8C INC L          ; }
 $AD8D CALL $ADE0     ; Get the attribute address of the position.
 $AD90 XOR A          ; {Clear the fraction in #REGaf'.
 $AD91 EX AF,AF'      ; }
 $AD92 LD A,($AA93)   ; Fetch the number of steps.
 $AD95 RRA            ; {Divide the number of steps by eight.
 $AD96 RRA            ;
 $AD97 RRA            ; }
 $AD98 AND %00011111  ; Keep only five bits to make the number of cells.
 $AD9A RET Z          ; Return if there are no cells.
 $AD9B LD B,A         ; Copy the number of cells to #REGb.
@label=Draw_Line_Attribute_Loop
*$AD9C LD (HL),$47    ; Set the attribute to #N$47 (white ink on black paper).
 $AD9E LD C,H         ; Stash the high byte of the attribute address in #REGc.
 $AD9F LD H,L         ; Copy the low byte to #REGh.
 $ADA0 EX AF,AF'      ; Restore the fraction from #REGaf'.
 $ADA1 LD L,A         ; Copy it to #REGl.
 $ADA2 ADD HL,DE      ; Move the position by the slope and up by one row of
                      ; cells.
 $ADA3 LD A,L         ; Copy the new fraction to #REGa.
 $ADA4 PUSH AF        ; Stash it, with the carry flag, on the stack.
 $ADA5 EX AF,AF'      ; Keep the new fraction in #REGaf'.
 $ADA6 POP AF         ; Restore the carry flag from the stack.
 $ADA7 LD L,H         ; Copy the new low byte of the attribute address to
                      ; #REGl.
 $ADA8 LD A,C         ; Fetch the stashed high byte of the attribute address.
 $ADA9 CCF            ; Invert the carry flag.
 $ADAA SBC A,$00      ; Subtract the carry from the high byte, in case the address has
                      ; crossed into another third of the screen.
 $ADAC LD H,A         ; Store it as the high byte of the attribute address.
 $ADAD DJNZ $AD9C     ; Decrease the cell counter and loop back until all of the cells have
                      ; been done.
 $ADAF RET            ; Return.

; Draw Line Step
;
; Used by the routine at #R$AD02.
; .
; Draws one step of a line. It plots a pixel with #R$AC9A, adds the slope
; in #REGde and the fraction in #R$AAA1 to the x position, and moves the display
; file address across by the new x position and up by one pixel line.
;
;   HL Display file address
;   C x position
;   DE Slope
; O:HL New display file address
; O:C New x position
@label=Draw_Line_Step
c$ADB0 PUSH BC       ; Stash the steps and the direction on the stack.
 $ADB1 CALL $AC9A    ; Plot a pixel.
 $ADB4 LD A,H        ; {Stash the high byte of the display file address in
 $ADB5 EX AF,AF'     ; #REGaf'.}
 $ADB6 LD A,($AAA1)  ; Fetch the fraction of the line.
 $ADB9 LD H,C        ; Copy the x position to #REGh.
 $ADBA LD B,L        ; Stash the low byte of the display file address in #REGb.
 $ADBB LD L,A        ; Copy the fraction to #REGl.
 $ADBC ADD HL,DE     ; Add the slope to the x position and the fraction.
 $ADBD LD A,L        ; Copy the new fraction to #REGa.
 $ADBE LD ($AAA1),A  ; Store it as the fraction of the line.
 $ADC1 LD C,H        ; Copy the new x position to #REGc.
 $ADC2 LD A,B        ; Restore the low byte of the display file address.
 $ADC3 AND %11100000 ; Keep only the row bits of the low byte.
 $ADC5 LD B,A        ; Store them in #REGb.
 $ADC6 LD A,C        ; Copy the new x position to #REGa.
 $ADC7 RRA           ; {Divide the x position by #N$08.
 $ADC8 RRA           ;
 $ADC9 RRA           ; }
 $ADCA AND %00011111 ; Keep only five bits to make the column.
 $ADCC OR B          ; Combine the row bits with the column.
 $ADCD LD L,A        ; Store the new low byte of the display file address in
                     ; #REGl.
 $ADCE LD A,C        ; Copy the new x position to #REGa.
 $ADCF POP BC        ; Restore the steps and the direction from the stack.
 $ADD0 LD C,A        ; Store the new x position in #REGc.
 $ADD1 EX AF,AF'     ; {Restore the high byte of the display file address and store it in
 $ADD2 LD H,A        ; #REGh.}
 $ADD3 JP $AE71      ; Jump to #R$AE71 to move up a pixel line.

; Negate HL
;
; Used by the routine at #R$ACAB.
; .
; Makes #REGhl negative by subtracting it from zero. #REGde is not
; changed.
;
;   HL Number
; O:HL Zero less the number
@label=NegateHL
c$ADD6 PUSH DE       ; Stash #REGde on the stack.
 $ADD7 EX DE,HL      ; Move the number to #REGde.
 $ADD8 LD HL,$0000   ; #REGhl=#N$0000.
 $ADDB AND A         ; {Subtract the number from zero.
 $ADDC SBC HL,DE     ; }
 $ADDE POP DE        ; Restore #REGde from the stack.
 $ADDF RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$A39E }
; { #TRANZAM$6BF6 }
; LIST#

; Calculate Attribute Address
;
; Used by the routines at #R$91B0, #R$9867, #R$9C10, #R$9C3C, #R$9C70, #R$9CB1,
; #R$9CF2, #R$AD02, #R$E622 and #R$ED2E.
; .
; Converts a pixel position into the address of the matching cell of
; the attribute buffer.
;
;   HL Position (#REGl is the x position, #REGh is the y position)
; O:HL Attribute buffer address
@label=AttributeAddress
c$ADE0 PUSH BC       ; Stash #REGbc on the stack.
 $ADE1 LD A,L        ; Fetch the x position.
 $ADE2 RRCA          ; {Divide it by #N$08.
 $ADE3 RRCA          ;
 $ADE4 RRCA          ; }
 $ADE5 AND $1F       ; Keep only five bits.
 $ADE7 LD L,A        ; Store the column in #REGl.
 $ADE8 LD A,H        ; Fetch the y position.
 $ADE9 RLCA          ; {Multiply it by #N$04.
 $ADEA RLCA          ; }
 $ADEB LD C,A        ; Store the result in #REGc.
 $ADEC AND $E0       ; Keep only the bits that give the low part of the row.
 $ADEE OR L          ; Combine them with the column.
 $ADEF LD L,A        ; Store the low byte of the address in #REGl.
 $ADF0 LD A,C        ; Fetch the multiplied y position.
 $ADF1 AND $03       ; Keep only the bits that give the high part of the row.
 $ADF3 OR $58        ; Add the start of the attribute buffer.
 $ADF5 LD H,A        ; Store the high byte of the address in #REGh.
 $ADF6 POP BC        ; Restore #REGbc from the stack.
 $ADF7 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9BD2 }
; { #COOKIE$7534 }
; { #JETPAC$720E }
; { #LUNARJETMAN$8506 }
; { #MARTIANOIDS$BD6A }
; { #PSSST$748F }
; { #SABREWULF$B8DD }
; { #TRANZAM$7097 }
; LIST#

; Calculate Screen Address
;
; Used by the routines at #R$91B0, #R$9657, #R$9689, #R$99AB, #R$99D2, #R$99F5,
; #R$9A53, #R$9AB6, #R$9C3C, #R$9C70, #R$9CB1, #R$9CF2, #R$9E16, #R$9E58,
; #R$9FA3, #R$A021, #R$A045 and #R$AD02.
; .
; Converts a pixel position into the address of the matching byte of
; the display file.
;
;   HL Position (#REGl is the x position, #REGh is the y position)
; O:HL Display file address
@label=ScreenAddress
c$ADF8 LD A,L        ; Fetch the x position.
 $ADF9 RRCA          ; {Divide it by #N$08.
 $ADFA RRCA          ;
 $ADFB RRCA          ; }
 $ADFC AND $1F       ; Keep only five bits.
 $ADFE LD L,A        ; Store the column in #REGl.
 $ADFF LD A,H        ; Fetch the y position.
 $AE00 RLCA          ; {Multiply it by #N$04.
 $AE01 RLCA          ; }
 $AE02 AND $E0       ; Keep only the bits that give the character row within a
                     ; third.
 $AE04 OR L          ; Combine them with the column.
 $AE05 LD L,A        ; Store the low byte of the address in #REGl.
 $AE06 LD A,H        ; Fetch the y position.
 $AE07 AND $07       ; Keep only the pixel line within the character.
 $AE09 EX AF,AF'     ; Stash the line in #REGaf'.
 $AE0A LD A,H        ; Fetch the y position.
 $AE0B RRCA          ; {Divide it by #N$08.
 $AE0C RRCA          ;
 $AE0D RRCA          ; }
 $AE0E AND $18       ; Keep only the bits that give the third of the screen.
 $AE10 OR $40        ; Add the start of the display file.
 $AE12 LD H,A        ; Store the result in #REGh.
 $AE13 EX AF,AF'     ; Retrieve the pixel line from #REGaf'.
 $AE14 OR H          ; Combine it with the high byte of the address.
 $AE15 LD H,A        ; Store the high byte of the address in #REGh.
 $AE16 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9BA2 }
; { #COOKIE$76E3 }
; { #JETPAC$7308 }
; { #LUNARJETMAN$851E }
; { #PSSST$759A }
; { #SABREWULF$B8AD }
; { #TRANZAM$6F10 }
; LIST#

; Read Controls
;
; Used by the routines at #R$A316, #R$A433, #R$A5F1, #R$A6A6, #R$AAB0, #R$E420
; and #R$E570.
; .
; Reads the controls that were chosen on the game selection screen (see
; #R$8ED5). A bit is reset when its control is used: bit 0 is right, bit 1 is
; left, bit 2 is down, bit 3 is up and bit 4 is fire. The keyboard uses W, Q, E,
; R and T.
; .
; Bit 5 is reset when a key from the bottom row of the keyboard (CAPS SHIFT, Z,
; X, C or V) is pressed, whichever control method is in use.
; .
; The cursor keys and the Interface II joystick are read by #R$EE00 and #R$EE29.
; The Kempston joystick is read directly.
;
; O:A The state of the controls
; O:B The state of the controls
;
; Pick the routine for the control method.
@label=ReadControls
c$AE17 LD A,($8ED5)  ; Fetch the control method from #R$8ED5.
 $AE1A AND %00000011 ; Keep only the control method bits (bits 0 and 1).
 $AE1C JR Z,$AE3D    ; Jump to #R$AE3D if the keyboard is being used.
 $AE1E CP $02        ; {Jump to #R$EE00 if the cursor keys are being used.
 $AE20 JP Z,$EE00    ; }
 $AE23 CP $03        ; {Jump to #R$EE29 if the Interface II joystick is being
 $AE25 JP Z,$EE29    ; used.}
; Read the Kempston joystick.
 $AE28 IN A,($1F)    ; Read the Kempston joystick.
 $AE2A CPL           ; Flip the bits, so that a reset bit is a direction or fire which is
                     ; used.
 $AE2B LD B,A        ; Store the state of the controls in #REGb.
; This entry point is used by the routines at #R$EE00 and #R$EE29.
; .
; Read the bottom row of the keyboard, which sets bit 5 whichever control
; method is being used.
@label=ReadControls_Bottom_Row
*$AE2C LD A,$FE      ; {Read from the keyboard;
 $AE2E OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $AE30 IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$FE | CAPS SHIFT | Z | X | C | V }
                     ; TABLE#}
 $AE32 CPL           ; Flip the bits so that a pressed key gives a set bit.
 $AE33 AND %00011111 ; Keep only the five keys.
 $AE35 SET 5,B       ; Set bit 5 of the controls.
 $AE37 JR Z,$AE3B    ; Jump to #R$AE3B if none of those keys is pressed.
 $AE39 RES 5,B       ; Reset bit 5 of the controls.
@label=ReadControls_Fetch_State
*$AE3B LD A,B        ; Fetch the state of the controls.
 $AE3C RET           ; Return.
; Read the keyboard controls.
@label=ReadControls_Keyboard
*$AE3D LD A,$FB      ; {Read from the keyboard;
 $AE3F OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $AE41 IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$FB | Q | W | E | R | T }
                     ; TABLE#}
 $AE43 LD C,A        ; Stash the state of the keys in #REGc.
 $AE44 RRA           ; Move bit 1 (W) into bit 0.
 $AE45 AND %00000001 ; Keep only that bit (right).
 $AE47 LD B,A        ; Store it in #REGb.
 $AE48 LD A,C        ; Fetch the state of the keys.
 $AE49 RLA           ; Move bit 0 (Q) into bit 1.
 $AE4A AND %00000010 ; Keep only that bit (left).
 $AE4C OR B          ; Combine it with right.
 $AE4D LD B,A        ; Store the result in #REGb.
 $AE4E LD A,C        ; Fetch the state of the keys.
 $AE4F AND %00011100 ; Keep only bits 2 to 4 (E, R and T: down, up and fire).
 $AE51 OR B          ; Combine them with right and left.
 $AE52 LD B,A        ; Store the result in #REGb.
 $AE53 JP $AE2C      ; Jump to #R$AE2C to read the bottom row of the keyboard.
; View the equivalent code in;
; #LIST
; { #ATICATAC$93BE }
; { #COOKIE$6FB4 }
; LIST#

; Calculate Square Root
;
; Used by the routine at #R$AB78.
; .
; Calculates the square root of a 16-bit number, rounded down. It works
; eight times through, taking two bits of the number each time.
;
;   HL Number
; O:L Square root (#REGh is not meaningful)
@label=Calculate_Square_Root
c$AE56 LD DE,$0040   ; Set up the trial value: #REGd builds up the root and
                     ; #REGe is #N$40.
 $AE59 LD A,L        ; Copy the low byte of the number to #REGa.
 $AE5A LD L,H        ; Copy the high byte of the number to #REGl.
 $AE5B LD H,D        ; Clear #REGh.
 $AE5C LD B,$08      ; Set a counter in #REGb for eight bits of the root.
 $AE5E OR A          ; Clear the carry flag.
@label=Calculate_Square_Root_Loop
*$AE5F SBC HL,DE     ; Subtract the trial value (the root so far and #N$40) from the
                     ; remainder.
 $AE61 JR NC,$AE64   ; Jump to #R$AE64 if it fitted.
 $AE63 ADD HL,DE     ; Otherwise restore the remainder.
@label=Calculate_Square_Root_Fitted
*$AE64 CCF           ; Invert the carry flag, so that it is set if the trial
                     ; value fitted.
 $AE65 RL D          ; Shift the new bit into the root.
 $AE67 ADD A,A       ; Shift the next bit of the number out of #REGa.
 $AE68 ADC HL,HL     ; Shift it into the remainder.
 $AE6A ADD A,A       ; Shift the next bit of the number out of #REGa.
 $AE6B ADC HL,HL     ; Shift it into the remainder.
 $AE6D DJNZ $AE5F    ; Decrease the bit counter and loop back until all eight bits of the
                     ; root have been found.
 $AE6F LD L,D        ; Copy the root to #REGl.
 $AE70 RET           ; Return.

; Screen Address One Pixel Above
;
; Used by the routines at #R$99AB, #R$AD02 and #R$ADB0.
; .
; Moves a display file address up by one pixel line.
;
;   HL Display file address
; O:HL Display file address of the line above
@label=ScreenPosition1PixelAbove
c$AE71 DEC H         ; Move up a pixel line.
 $AE72 LD A,H        ; Copy #REGh to #REGa.
 $AE73 CPL           ; Flip all of the bits.
 $AE74 AND $07       ; Keep only the line number within the character.
 $AE76 RET NZ        ; Return if a character boundary has not been crossed.
 $AE77 LD A,L        ; Copy #REGl to #REGa.
 $AE78 SUB $20       ; Move up a character row.
 $AE7A LD L,A        ; Store the result in #REGl.
 $AE7B RET C         ; Return if the subtraction borrowed.
 $AE7C LD A,H        ; Copy #REGh to #REGa.
 $AE7D ADD A,$08     ; Add #N$08.
 $AE7F LD H,A        ; Store the result in #REGh.
 $AE80 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9F03 }
; { #LUNARJETMAN$85F6 }
; { #PSSST$7585 }
; { #TRANZAM$6ECB }
; LIST#

; Set Up Rope
;
; Used by the routine at #R$9906.
; .
; Sets up the rope for the room that has just been drawn, using the map
; entry of the room (see #R$98CC). Bit 3 of the second byte says whether the
; room has a rope.
; .
; The rope is the object in record 3 (type #N$17).
; .
; The length of the rope is stored in #R$AAA5. It is half of the sum of #N$FF
; (or #N$A0 if bit 2 is reset) and #N$100 times the two low bits of the second
; byte.
@label=Set_Up_Rope
c$AE81 CALL $98CC    ; Read the world map entry of the room into #REGde.
 $AE84 LD A,E        ; Copy the room flags to #REGa.
 $AE85 LD ($AAAC),A  ; Store the room flags in #R$AAAC.
 $AE88 XOR A         ; {Clear the displacement of the end of the rope in pixels
 $AE89 LD ($AAA4),A  ; (#R$AAA4).}
 $AE8C LD ($AAA3),A  ; Clear the fraction of the displacement of the end of the rope
                     ; (#R$AAA3).
 $AE8F BIT 3,D       ; {Jump to #R$AEB0 if there is no rope in this room (bit 3 of the
 $AE91 JR Z,$AEB0    ; second byte of the world map entry is clear).}
 $AE93 LD A,$17      ; Use the type of the rope (#N$17).
 $AE95 LD ($8F2A),A  ; Store it as the type of record 3 (the rope).
 $AE98 LD HL,$0000   ; {Clear the previous position of the end of the rope
 $AE9B LD ($AA97),HL ; (#R$AA97).}
 $AE9E BIT 2,D       ; {Jump to #R$AEB5 if the rope is a short one (bit 2 of the second byte
 $AEA0 JR Z,$AEB5    ; of the world map entry is clear).}
 $AEA2 LD L,$FF      ; Set the low byte of the length of a long rope to #N$FF.
@label=Set_Up_Rope_Fetch_Second_Byte
*$AEA4 LD A,D        ; Fetch the second byte of the world map entry.
 $AEA5 AND %00000011 ; Keep only the two low bits (the number of rooms down the
                     ; rope).
 $AEA7 LD H,A        ; Store them in the high byte of the length.
 $AEA8 SRA H         ; {Halve the length of the rope.
 $AEAA RR L          ; }
 $AEAC LD ($AAA5),HL ; Store the length of the rope in #R$AAA5.
 $AEAF RET           ; Return.
@label=Set_Up_Rope_Remove_Rope
*$AEB0 XOR A         ; {Remove the rope by clearing the type of record 3.
 $AEB1 LD ($8F2A),A  ; }
 $AEB4 RET           ; Return.
@label=Set_Up_Rope_Set_Length
*$AEB5 LD L,$A0      ; Set the low byte of the length of a short rope to #N$A0.
 $AEB7 JR $AEA4      ; Jump to #R$AEA4.

; Handle Plant
;
; Handler for the object types #N$1C to #N$2B, the plants (mushrooms,
; pods, flytraps, weeds and bellflowers) that stand in some of the rooms. Each
; plant has two frames, and bit 0 of its type picks the frame.
; .
; A plant is set up the first time that it is handled after its room has been
; drawn (see #R$AF12). After that it makes Sabreman tumble if he touches it, by
; setting bit 7 of his redraw flags (see #R$A406).
;
; IX Object record
@label=Handle_Plant
c$AEB9 BIT 0,(IX+$0F)  ; {Jump to #R$AF12 if the plant has just been created (bit 0 of the
 $AEBD JR NZ,$AF12     ; redraw flags is set).}
 $AEBF CALL $989F      ; Save the state of the plant (see #R$989F).
; Remove the plant if Sabreman is not in the same room.
 $AEC2 LD A,($8F1C)    ; Fetch the room x of Sabreman.
 $AEC5 CP (IX+$02)     ; {Jump to #R$AF0D if the plant is not in the same room
 $AEC8 JR NZ,$AF0D     ; x.}
 $AECA LD A,($8F1E)    ; Fetch the room y of Sabreman.
 $AECD CP (IX+$04)     ; {Jump to #R$AF0D if the plant is not in the same room
 $AED0 JR NZ,$AF0D     ; y.}
; See if Sabreman is touching the plant.
 $AED2 LD A,($8F1D)    ; Fetch the y position of Sabreman.
 $AED5 SUB (IX+$03)    ; Subtract the y position of the plant.
 $AED8 CP $14          ; {Jump to #R$AEF5 if Sabreman is #N$14 or more pixels below the plant,
 $AEDA JR NC,$AEF5     ; or above it.}
 $AEDC LD A,($8F1B)    ; Fetch the x position of Sabreman.
 $AEDF SUB (IX+$01)    ; Subtract the x position of the plant.
 $AEE2 SUB $04         ; Subtract #N$04 to allow for the difference between the widths of the
                       ; sprites.
 $AEE4 JP P,$AEE9      ; Jump to #R$AEE9 if the difference is positive.
 $AEE7 NEG             ; Make the difference positive.
@label=Handle_Plant_Test_Width
*$AEE9 CP $14          ; {Jump to #R$AEF5 if Sabreman is #N$14 or more pixels away from the
 $AEEB JR NC,$AEF5     ; plant sideways.}
 $AEED LD A,($8F29)    ; Fetch the redraw flags of Sabreman.
 $AEF0 OR %10000000    ; Set bit 7, which makes him tumble.
 $AEF2 LD ($8F29),A    ; Store the redraw flags of Sabreman.
; Choose the frame of the plant from bit 3 of a counter.
@label=Handle_Plant_Animate
*$AEF5 INC (IX+$06)    ; Add one to the animation counter of the plant.
 $AEF8 LD A,(IX+$06)   ; Fetch the animation counter of the plant.
 $AEFB RRA             ; {Shift bit 3 of the counter into bit 0 (rotate right
 $AEFC RRA             ; three times).
 $AEFD RRA             ; }
 $AEFE AND %00000001   ; Keep only the bit.
 $AF00 LD B,A          ; Keep the frame number in #REGb.
 $AF01 LD A,(IX+$00)   ; Fetch the type of the plant.
 $AF04 AND %11111110   ; Clear bit 0 of the type of the plant.
 $AF06 ADD A,B         ; Add the frame number to make the new type.
 $AF07 LD (IX+$00),A   ; Store the new type.
 $AF0A JP $96CB        ; Jump to #R$96CB.
@label=Handle_Plant_Remove
*$AF0D LD (IX+$00),$00 ; Remove the plant by setting its type to zero.
 $AF11 RET             ; Return.
; Set up a new plant. Its type depends on its x position and on the room,
; and it takes its room from Sabreman.
@label=Handle_Plant_Set_Up
*$AF12 LD A,($8F1C)    ; Fetch the room x of Sabreman.
 $AF15 LD (IX+$02),A   ; Store it as the room x of the plant.
 $AF18 LD A,($8F1E)    ; Fetch the room y of Sabreman.
 $AF1B LD (IX+$04),A   ; Store it as the room y of the plant.
 $AF1E LD (IX+$05),$45 ; Set the attribute to #N$45 (bright cyan).
 $AF22 LD A,(IX+$01)   ; Fetch the x position of the plant.
 $AF25 RRA             ; {Divide it by four.
 $AF26 RRA             ; }
 $AF27 ADD A,(IX+$02)  ; Add the room x.
 $AF2A AND %00001110   ; Keep only bits 1 to 3, so that the type is even.
 $AF2C ADD A,$1C       ; Add #N$1C, the first type of a plant.
 $AF2E LD (IX+$00),A   ; Store it as the type of the plant.
 $AF31 LD (IX+$06),A   ; Store it as the animation counter of the plant.
 $AF34 RRA             ; Divide the type by two.
 $AF35 AND %00000011   ; Keep only two bits.
 $AF37 ADD A,$42       ; Add #N$42 to make a bright attribute.
 $AF39 LD (IX+$05),A   ; Store it as the attribute of the plant.
 $AF3C JP $96CB        ; Jump to #R$96CB.

; Handle Static Object
;
; Used by the routine at #R$EAF9.
; .
; Handler for the object types #N$2C to #N$2F (rocks) and #N$54 (spikes).
; These objects never move, so the sprite is only drawn when the room is drawn.
; On every other pass the routine just sets the attributes again (see #R$9867).
; .
; An object of type #N$54 also lets out a bubble now and then (see #R$E0A9).
;
; IX Object record
@label=Handle_Static_Object
c$AF3F BIT 0,(IX+$0F) ; {Jump to #R$AF53 if the object has just been created (bit 0 of the
 $AF43 JR NZ,$AF53    ; redraw flags is set).}
 $AF45 LD A,(IX+$00)  ; Fetch the type of the object.
 $AF48 CP $54         ; {Call #R$E0A9 to let out a bubble if the type is #N$54.
 $AF4A CALL Z,$E0A9   ; }
 $AF4D CALL $9689     ; Prepare the sprite of the object.
 $AF50 JP $9867       ; Jump to #R$9867.
@label=Handle_Static_Object_Draw
*$AF53 JP $96CB       ; Jump to #R$96CB.

; Set Up Room Objects
;
; Used by the routine at #R$9906.
; .
; Sets up the objects of a room that is in the lower part of the map (the
; room y is #N$10 or more) when the room is drawn.
; .
; The two decoration records that start at #R$8F9A are emptied. The two
; before them are emptied too, unless they hold a bubble. What happens next
; depends on the first byte of the world map entry of the room (see #R$99F5).
; .
; A room with both a ceiling and a floor gets a plant and a rock. Their x
; positions come from the table at #R$B757, and the rock is one of the
; four templates at #R$B76B.
; .
; A room with no floor gets the objects that are set up by #R$E6EE. A room with
; a floor but no ceiling gets the two objects of type #N$54 that start at
; #R$B7AB.
@label=Set_Up_Room_Objects
c$AF56 CALL $98CC    ; Read the world map entry of the room. The flags of the room are
                     ; returned in #REGe.
 $AF59 XOR A         ; {Clear the type of the first room object record
 $AF5A LD ($8F9A),A  ; (#R$8F9A).}
 $AF5D LD ($8FAA),A  ; Clear the type of the second room object record
                     ; (#R$8FAA).
 $AF60 LD A,($8F7A)  ; Fetch the type of the record at #R$8F7A.
 $AF63 AND %11111100 ; Ignore the low two bits.
 $AF65 CP $58        ; {Jump to #R$AF6D if the record holds a bubble (#N$58 to
 $AF67 JR Z,$AF6D    ; #N$5B).}
 $AF69 XOR A         ; {Write #N$00 to the type of the record at #R$8F7A.
 $AF6A LD ($8F7A),A  ; }
@label=Set_Up_Room_Objects_Next_Record
*$AF6D LD A,($8F8A)  ; Fetch the type of the record at #R$8F8A.
 $AF70 AND %11111100 ; Ignore the low two bits.
 $AF72 CP $58        ; {Jump to #R$AF7A if the record holds a bubble.
 $AF74 JR Z,$AF7A    ; }
 $AF76 XOR A         ; {Write #N$00 to the type of the record at #R$8F8A.
 $AF77 LD ($8F8A),A  ; }
@label=Set_Up_Room_Objects_Test_Flags
*$AF7A LD A,E        ; Copy the flags of the room to #REGa.
 $AF7B AND %00010001 ; Keep only the ceiling bit (bit 0) and the floor bit (bit
                     ; 4).
 $AF7D CP $11        ; {Jump to #R$AFC9 if the room does not have both.
 $AF7F JR NZ,$AFC9   ; }
; Put a plant and a rock in the room. The x positions come from the table
; at #R$B757, starting at an offset that is the sum of the room
; coordinates, modulo #N$10.
 $AF81 LD A,($8F1C)  ; Fetch the room x of Sabreman.
 $AF84 LD L,A        ; Copy it to #REGl.
 $AF85 LD A,($8F1E)  ; Fetch the room y of Sabreman.
 $AF88 ADD A,L       ; Add the room x.
 $AF89 LD H,$00      ; Clear the high byte of the offset.
 $AF8B AND %00001111 ; Keep only the low four bits.
 $AF8D LD L,A        ; Store the offset in #REGl.
 $AF8E LD DE,$B757   ; Point at the table of x positions (#R$B757).
 $AF91 ADD HL,DE     ; Add the offset.
 $AF92 EX DE,HL      ; Move the table address to #REGde.
 $AF93 LD HL,$8F7B   ; Point at the x position of the record (#R$8F7B).
 $AF96 LD A,(DE)     ; Fetch the x position of the plant from the table.
 $AF97 LD (HL),A     ; Store it in the record.
 $AF98 INC DE        ; Move on to the x position of the rock.
 $AF99 LD HL,$8F7D   ; Point at the y position of the record (#R$8F7D).
 $AF9C LD (HL),$9F   ; Set the y position to #N$9F, which is the floor.
 $AF9E LD HL,$8F7A   ; Point at the type of the record (#R$8F7A).
 $AFA1 LD (HL),$1C   ; Set the type to #N$1C (a plant).
 $AFA3 LD HL,$8F89   ; Point at the redraw flags of the record (#R$8F89).
 $AFA6 LD (HL),$01   ; Set the redraw flags to #N$01 so that the plant is drawn without
                     ; being erased.
 $AFA8 PUSH DE       ; Stash the table address on the stack.
 $AFA9 LD DE,$B76B   ; Point at the templates of the rocks (#R$B76B).
 $AFAC LD A,($8F1C)  ; Fetch the room x of Sabreman.
 $AFAF LD C,A        ; Copy it to #REGc.
 $AFB0 RLA           ; {Multiply it by sixteen (rotate left four times).
 $AFB1 RLA           ;
 $AFB2 RLA           ;
 $AFB3 RLA           ; }
 $AFB4 AND %00110000 ; Keep only bits 4 and 5, which pick one of the four
                     ; templates.
 $AFB6 LD L,A        ; Store the offset of the template in #REGl.
 $AFB7 LD H,$00      ; Clear the high byte of the offset.
 $AFB9 ADD HL,DE     ; Add the address of the first template.
 $AFBA LD DE,$8F9A   ; #REGde=#R$8F9A (the first decoration record that is for a
                     ; room object).
 $AFBD LD A,C        ; Copy the room x to #REGa (this is not used).
 $AFBE LD BC,$0010   ; Set the size of a record to #N$0010.
 $AFC1 LDIR          ; Copy the template into the record.
 $AFC3 POP DE        ; Restore the table address from the stack.
 $AFC4 LD A,(DE)     ; Fetch the x position of the rock from the table.
 $AFC5 LD ($8F9B),A  ; Store it in the record.
 $AFC8 RET           ; Return.
@label=Set_Up_Room_Objects_Test_Floor
*$AFC9 BIT 4,E       ; {Jump to #R$E6EE if the room has no floor.
 $AFCB JP Z,$E6EE    ; }
; The room has a floor but no ceiling.
 $AFCE LD HL,$B7AB   ; #REGhl=#R$B7AB (the templates of the two objects of type
                     ; #N$54).
 $AFD1 LD DE,$8F9A   ; #REGde=#R$8F9A (the first decoration record that is for a
                     ; room object).
 $AFD4 LD BC,$0020   ; Set the size of two records to #N$0020.
 $AFD7 LDIR          ; Copy the templates into the two records.
 $AFD9 RET           ; Return.

; Spawn Flying Creature
;
; Used by the routine at #R$91C0.
; .
; Lets a flying creature into the room every now and then. Nothing happens
; unless the sum of the tick counter and the frame counter is a multiple of
; eight.
; .
; If one of the four creature records that start at #R$8FDA is free, it
; is filled in with a type that comes from bits 2 and 4 of the tick counter:
; #N$30 (eagle), #N$34 (gargoyle), #N$40 (vulture) or #N$44 (jellyfish). Only
; the vultures and the jellyfish appear until the flag at #R$8EF9 has been set,
; which happens when Sabreman kills a guardian.
; .
; The creature starts in a room next to the one that Sabreman is in. It is on
; the left or the right if the room has a gap in that wall (the choice is made
; from bit 0 of the tick counter), and it is above or below otherwise. Its
; position inside the room, and its attribute, come from the frame counter.
; .
; #R$B079 then makes the creature fly into the room that Sabreman is in.
@label=Spawn_Flying_Creature
c$AFDA LD A,($8ED6)  ; {Fetch the tick counter from #R$8ED6 and keep it in
 $AFDD LD B,A        ; #REGb.}
 $AFDE LD A,($5C78)  ; Fetch the low byte of FRAMES.
 $AFE1 ADD A,B       ; Add the tick counter to make a pseudo-random number.
 $AFE2 AND %00000111 ; Keep only the low three bits.
 $AFE4 RET NZ        ; Return unless the result is zero (a creature can only appear on one
                     ; pass in eight).
 $AFE5 LD HL,$8FDA   ; Point at the first of the four creature records
                     ; (#R$8FDA).
 $AFE8 LD DE,$0010   ; Set the size of a record to #N$0010.
 $AFEB LD B,$04      ; Set the number of records to #N$04.
@label=Spawn_Flying_Creature_Find_Record
*$AFED LD A,(HL)     ; Fetch the type of the record.
 $AFEE AND A         ; {Jump to #R$AFF5 if the record is not in use (the type
 $AFEF JR Z,$AFF5    ; is zero).}
 $AFF1 ADD HL,DE     ; Move on to the next record.
 $AFF2 DJNZ $AFED    ; Loop back until all of the records have been tried.
 $AFF4 RET           ; Return as all of the records are in use.
@label=Spawn_Flying_Creature_Choose_Type
*$AFF5 LD A,($AAAC)  ; Fetch the flags of the room that Sabreman is in.
 $AFF8 LD E,A        ; Store them in #REGe.
 $AFF9 LD A,($8EF9)  ; Fetch the creature spawn flag.
 $AFFC AND A         ; Test the flag.
 $AFFD LD A,($8ED6)  ; Fetch the tick counter.
 $B000 JR NZ,$B004   ; Jump to #R$B004 if the flag is set.
 $B002 OR %00010000  ; Set bit 4, which limits the choice to the vulture and the
                     ; jellyfish.
@label=Spawn_Flying_Creature_Store_Type
*$B004 PUSH AF       ; Stash the tick counter on the stack.
 $B005 AND %00010100 ; Keep only bits 2 and 4.
 $B007 ADD A,$30     ; Add #N$30 to make the type.
 $B009 LD (HL),A     ; Store the type in the record.
 $B00A POP AF        ; Restore the tick counter.
 $B00B INC HL        ; Move on to the x position.
 $B00C BIT 0,A       ; {Jump to #R$B03B if bit 0 of the tick counter is set.
 $B00E JR NZ,$B03B   ; }
; Bit 0 of the tick counter is reset, so use the right of the room if it
; has no right wall, and the left otherwise.
 $B010 BIT 2,E       ; {Jump to #R$B043 if the room has no right wall.
 $B012 JR Z,$B043    ; }
 $B014 BIT 6,E       ; {Jump to #R$B04F if the room has a left wall too.
 $B016 JR NZ,$B04F   ; }
; The creature comes in from the room on the left.
@label=Spawn_Flying_Creature_From_Left
*$B018 AND %01111111 ; Keep only the low seven bits of the tick counter.
 $B01A ADD A,$48     ; Add #N$48 to make the x position.
 $B01C LD (HL),A     ; Store the x position.
 $B01D INC HL        ; Move on to the room x.
 $B01E LD A,($8F1C)  ; Fetch the room x of Sabreman.
 $B021 DEC A         ; Subtract one to get the room on the left.
@label=Spawn_Flying_Creature_Store_Room_X
*$B022 LD (HL),A     ; Store the room x.
 $B023 INC HL        ; Move on to the y position.
 $B024 LD A,($5C78)  ; Fetch the low byte of the frame counter.
 $B027 AND %00111111 ; Keep only the low six bits.
 $B029 ADD A,$40     ; Add #N$40 to make the y position.
 $B02B LD (HL),A     ; Store the y position.
 $B02C INC HL        ; Move on to the room y.
 $B02D LD A,($8F1E)  ; Fetch the room y of Sabreman.
 $B030 LD (HL),A     ; Store it as the room y of the creature.
 $B031 INC HL        ; Move on to the attribute.
 $B032 LD A,($5C78)  ; Fetch the low byte of the frame counter.
 $B035 AND %00000011 ; Keep only the low two bits.
 $B037 ADD A,$42     ; Add #N$42 to make a bright attribute.
 $B039 LD (HL),A     ; Store the attribute of the creature.
 $B03A RET           ; Return.
@label=Spawn_Flying_Creature_Test_Left
*$B03B BIT 6,E       ; {Jump to #R$B018 if the room has no left wall.
 $B03D JR Z,$B018    ; }
 $B03F BIT 2,E       ; {Jump to #R$B04F if the room has a right wall.
 $B041 JR NZ,$B04F   ; }
; The creature comes in from the room on the right.
@label=Spawn_Flying_Creature_From_Right
*$B043 AND %00111111 ; Keep only the low six bits of the tick counter.
 $B045 ADD A,$40     ; Add #N$40 to make the x position.
 $B047 LD (HL),A     ; Store the x position.
 $B048 INC HL        ; Move on to the room x.
 $B049 LD A,($8F1C)  ; Fetch the room x of Sabreman.
 $B04C INC A         ; Add one to get the room on the right.
 $B04D JR $B022      ; Jump to #R$B022 to store the room x.
; The creature comes in from the room above or below.
@label=Spawn_Flying_Creature_Vertically
*$B04F AND %01111111 ; Keep only the low seven bits of the tick counter.
 $B051 ADD A,$48     ; Add #N$48 to make the x position.
 $B053 LD (HL),A     ; Store the x position.
 $B054 INC HL        ; Move on to the room x.
 $B055 LD A,($8F1C)  ; Fetch the room x of Sabreman.
 $B058 LD (HL),A     ; Store it as the room x of the creature.
 $B059 INC HL        ; Move on to the y position.
 $B05A LD A,($5C78)  ; Fetch the low byte of the frame counter.
 $B05D AND %00111111 ; Keep only the low six bits.
 $B05F ADD A,$40     ; Add #N$40 to make the y position.
 $B061 LD (HL),A     ; Store the y position.
 $B062 INC HL        ; Move on to the room y.
 $B063 LD A,($8F1E)  ; Fetch the room y of Sabreman.
 $B066 BIT 0,E       ; {Jump to #R$B06D if the room has no ceiling.
 $B068 JR Z,$B06D    ; }
 $B06A INC A         ; Add one to get the room below.
 $B06B JR $B06E      ; Jump to #R$B06E to store the room y.
@label=Spawn_Flying_Creature_From_Above
*$B06D DEC A         ; Subtract one to get the room above.
@label=Spawn_Flying_Creature_Store_Room_Y
*$B06E LD (HL),A     ; Store the room y.
 $B06F INC HL        ; Move on to the attribute.
 $B070 LD A,($5C78)  ; Fetch the low byte of the frame counter.
 $B073 AND %00000011 ; Keep only the low two bits.
 $B075 ADD A,$42     ; Add #N$42 to make a bright attribute.
 $B077 LD (HL),A     ; Store the attribute of the creature.
 $B078 RET           ; Return.

; Handle Flying Creature
;
; Handler for the object types #N$30 to #N$33 (eagles) and #N$40 to #N$43
; (vultures). The creature flies towards Sabreman, bounces off the decorations
; and the bubbles, bounces off the frame of the room and flies out of the room
; through its gaps.
; .
; If the creature is in a different room from Sabreman it is moved by #R$B2CF
; (when the room x is different) or by #R$B358 (when the room y is different).
; .
; In Sabreman's room, an eagle that is above him and touches him picks him up
; (the type changes to #N$5C and #R$E2CB takes over). Bit 0 of the type is the
; frame of the animation and changes every two ticks, and bit 1 follows the
; direction of the x velocity.
; .
; The x velocity and the y velocity (bytes #N$08 and #N$09 of the record) each
; change by two on every call, in the direction of Sabreman, up to a limit of
; #N$40. A thrown weapon destroys the creature (see #R$B3D4). If the creature
; touches Sabreman he is pushed away with an x velocity of #N$03 and tumbles.
; .
; The contact flags (byte #N$0B of the record) use the same bits as the flags of
; the room (see #R$9906), and they are combined with those flags in #REGe.
;
; IX Object record
@label=Handle_Flying_Creature
c$B079 CALL $98CC      ; Read the world map entry of the room that the creature is in. The
                       ; flags of the room are returned in #REGe.
 $B07C LD A,(IX+$0B)   ; Fetch the contact flags of the creature.
 $B07F OR E            ; Combine them with the flags of the room.
 $B080 LD E,A          ; Store the result in #REGe.
 $B081 LD A,($8F1C)    ; Fetch the room x of Sabreman.
 $B084 CP (IX+$02)     ; {Jump to #R$B2CF if the creature is in a different
 $B087 JP NZ,$B2CF     ; room x.}
 $B08A LD A,($8F1E)    ; Fetch the room y of Sabreman.
 $B08D CP (IX+$04)     ; {Jump to #R$B358 if the creature is in a different
 $B090 JP NZ,$B358     ; room y.}
 $B093 CALL $989F      ; Save the state of the creature.
; Only an eagle that has been drawn and is inside the room can pick up
; Sabreman, and only if he is not hanging on the rope.
 $B096 LD A,(IX+$00)   ; Fetch the type of the creature.
 $B099 AND %11111100   ; Ignore the low two bits.
 $B09B CP $30          ; {Jump to #R$B0E4 if the creature is not an eagle.
 $B09D JR NZ,$B0E4     ; }
 $B09F BIT 0,(IX+$0F)  ; {Jump to #R$B0E4 if the creature has just been
 $B0A3 JR NZ,$B0E4     ; created.}
 $B0A5 LD A,(IX+$01)   ; Fetch the x position of the creature.
 $B0A8 CP $D0          ; {Jump to #R$B0E4 if the x position is #N$D0 or more.
 $B0AA JR NC,$B0E4     ; }
 $B0AC CP $18          ; {Jump to #R$B0E4 if the x position is less than #N$18.
 $B0AE JR C,$B0E4      ; }
 $B0B0 LD A,(IX+$03)   ; Fetch the y position of the creature.
 $B0B3 CP $A8          ; {Jump to #R$B0E4 if the y position is #N$A8 or more.
 $B0B5 JR NC,$B0E4     ; }
 $B0B7 CP $41          ; {Jump to #R$B0E4 if the y position is less than #N$41.
 $B0B9 JR C,$B0E4      ; }
 $B0BB LD A,($8F1A)    ; Fetch the type of Sabreman.
 $B0BE CP $09          ; {Jump to #R$B0E4 if Sabreman is hanging on the rope (the type is less
 $B0C0 JR C,$B0E4      ; than #N$09).}
 $B0C2 CALL $E285      ; Check for contact with Sabreman. Bit 2 of #REGc is set if the
                       ; creature touches him and bit 1 is set if he is above the creature.
 $B0C5 LD A,C          ; Copy the result to #REGa.
 $B0C6 AND %00000110   ; Keep only bits 1 and 2.
 $B0C8 CP $04          ; {Jump to #R$B0E4 unless the creature touches Sabreman and he is not
 $B0CA JR NZ,$B0E4     ; above it.}
 $B0CC DI              ; Disable interrupts while the frame counter is changed.
 $B0CD LD (IX+$00),$5C ; Change the type of the creature to #N$5C, which makes it carry
                       ; Sabreman (see #R$E2CB).
 $B0D1 LD A,$40        ; {Write #N$40 to the redraw flags of Sabreman (#R$8F29),
 $B0D3 LD ($8F29),A    ; which marks him as being carried (bit 6).}
 $B0D6 LD A,($5C78)    ; Fetch the low byte of the frame counter.
 $B0D9 OR %01000000    ; Set bit 6.
 $B0DB LD ($5C78),A    ; Store it. The carry ends when this byte next wraps round to zero
                       ; (see #R$E2CB).
 $B0DE LD ($8EF2),A    ; Store it in #R$8EF2 as well, as a non-zero value.
 $B0E1 JP $E2F0        ; Jump to #R$E2F0 to carry on as an eagle that carries
                       ; Sabreman.
; Work out the type of the creature. Bit 0 follows bit 1 of the tick
; counter and bit 1 is set when the x velocity is negative.
@label=Handle_Flying_Creature_Animate
*$B0E4 LD A,($8ED6)    ; Fetch the tick counter.
 $B0E7 RRA             ; Move bit 1 into bit 0.
 $B0E8 AND %00000001   ; Keep only that bit.
 $B0EA LD C,A          ; Keep the frame bit in #REGc.
 $B0EB LD A,(IX+$00)   ; Fetch the type of the creature.
 $B0EE AND %11111110   ; Clear bit 0.
 $B0F0 ADD A,C         ; Add the frame bit.
 $B0F1 BIT 7,(IX+$08)  ; {Jump to #R$B0FB if the x velocity is positive.
 $B0F5 JR Z,$B0FB      ; }
 $B0F7 OR %00000010    ; Set bit 1.
 $B0F9 JR $B0FD        ; Jump to #R$B0FD.
@label=Handle_Flying_Creature_Clear_Direction
*$B0FB AND %11111101   ; Clear bit 1.
@label=Handle_Flying_Creature_Store_Type
*$B0FD LD (IX+$00),A   ; Store the type of the creature.
; Change the x velocity by two in the direction of Sabreman, up to a limit
; of #N$40 in either direction.
 $B100 LD A,($8F1B)    ; Fetch the x position of Sabreman.
 $B103 SUB (IX+$01)    ; Subtract the x position of the creature.
 $B106 LD A,(IX+$08)   ; Fetch the x velocity of the creature.
 $B109 JP C,$B218      ; Jump to #R$B218 if Sabreman is on the left of the
                       ; creature.
 $B10C ADD A,$02       ; Add two to the x velocity.
 $B10E BIT 7,A         ; {Jump to #R$B116 if the x velocity is negative.
 $B110 JR NZ,$B116     ; }
 $B112 CP $40          ; {Jump to #R$B119 if the x velocity has reached #N$40.
 $B114 JR NC,$B119     ; }
@label=Handle_Flying_Creature_Store_X_Velocity
*$B116 LD (IX+$08),A   ; Store the x velocity.
; Do the same with the y velocity.
@label=Handle_Flying_Creature_Steer_Vertically
*$B119 LD A,($8F1D)    ; Fetch the y position of Sabreman.
 $B11C SUB (IX+$03)    ; Subtract the y position of the creature.
 $B11F LD A,(IX+$09)   ; Fetch the y velocity of the creature.
 $B122 JP C,$B227      ; Jump to #R$B227 if Sabreman is above the creature.
 $B125 ADD A,$02       ; Add two to the y velocity.
 $B127 BIT 7,A         ; {Jump to #R$B12F if the y velocity is negative.
 $B129 JR NZ,$B12F     ; }
 $B12B CP $40          ; {Jump to #R$B132 if the y velocity has reached #N$40.
 $B12D JR NC,$B132     ; }
@label=Handle_Flying_Creature_Store_Y_Velocity
*$B12F LD (IX+$09),A   ; Store the y velocity.
; This entry point is used by the routine at #R$B3D8.
; .
; Check for contact with a thrown weapon and with Sabreman. This is also
; the entry point for the jellyfish.
@label=Handle_Flying_Creature_Check_Contact
*$B132 PUSH DE         ; Stash the flags of the room on the stack.
 $B133 BIT 0,(IX+$0F)  ; {Jump to #R$B161 if the creature has just been
 $B137 JR NZ,$B161     ; created.}
 $B139 CALL $B6E8      ; Check whether a thrown weapon has hit the creature. #REGd is #N$FF
                       ; if one has.
 $B13C LD A,D          ; Copy the result to #REGa.
 $B13D AND A           ; {Jump to #R$B3D4 if a weapon has hit the creature.
 $B13E JP NZ,$B3D4     ; }
 $B141 CALL $E285      ; Check for contact with Sabreman.
 $B144 BIT 2,C         ; {Jump to #R$B161 if the creature is not touching him.
 $B146 JR Z,$B161      ; }
 $B148 XOR A           ; Clear #REGa, which collects the new redraw flags of
                       ; Sabreman.
 $B149 BIT 7,C         ; Test bit 7 of #REGc, which is set when the creature is on the right
                       ; of Sabreman.
 $B14B LD B,$03        ; Use an x velocity of #N$03 to push Sabreman to the
                       ; right.
 $B14D JR Z,$B153      ; Jump to #R$B153 if the creature is on the left of
                       ; Sabreman.
 $B14F LD B,$FD        ; Use an x velocity of #N$FD to push Sabreman to the
                       ; left.
 $B151 LD A,$10        ; Set bit 4 of #REGa.
@label=Handle_Flying_Creature_Push_Sabreman
*$B153 OR %00001000    ; Set bit 3 of #REGa.
 $B155 LD C,A          ; Copy the new redraw flags to #REGc.
 $B156 LD A,($8F29)    ; Fetch the redraw flags of Sabreman.
 $B159 OR C            ; Combine them with the new bits. Bit 3 makes him tumble (see
                       ; #R$E8A2).
 $B15A LD ($8F29),A    ; Store the redraw flags of Sabreman.
 $B15D LD A,B          ; Copy the x velocity to #REGa.
 $B15E LD ($8F20),A    ; Store it as the x velocity of Sabreman (#R$8F20).
; Check for contact with the decorations and the bubbles, and bounce off
; them.
@label=Handle_Flying_Creature_Check_Obstacles
*$B161 CALL $B43E      ; Check for contact with the decorations. #REGc holds
                       ; the result.
 $B164 LD D,C          ; Store the result in #REGd.
 $B165 CALL $E1B4      ; Check for contact with the bubbles.
 $B168 LD A,C          ; Copy the result to #REGa.
 $B169 OR D            ; Combine it with the result for the decorations.
 $B16A LD C,A          ; Store the combined result in #REGc.
 $B16B POP DE          ; Restore #REGde from the stack.
 $B16C BIT 2,C         ; {Jump to #R$B1B9 if the creature is not touching
 $B16E JR Z,$B1B9      ; anything.}
 $B170 BIT 1,C         ; {Jump to #R$B18E if the creature is not on top of the
 $B172 JR Z,$B18E      ; object.}
 $B174 BIT 5,C         ; {Jump to #R$B19E if the object is a bubble and the creature is away
 $B176 JR NZ,$B19E     ; from the middle of it.}
 $B178 LD A,(IX+$09)   ; Fetch the y velocity.
 $B17B DEC A           ; {Subtract two.
 $B17C DEC A           ; }
 $B17D JP M,$B1B9      ; Jump to #R$B1B9 if the result is negative, as the creature is
                       ; already moving up.
 $B180 CPL             ; Invert the y velocity, to send the creature up.
 $B181 LD (IX+$09),A   ; Store the y velocity.
 $B184 LD A,(IX+$03)   ; Fetch the y position.
 $B187 SUB $02         ; Subtract two.
 $B189 LD (IX+$03),A   ; Store the y position.
 $B18C JR $B1B9        ; Jump to #R$B1B9.
@label=Handle_Flying_Creature_Test_Underside
*$B18E BIT 0,C         ; {Jump to #R$B19E if the creature is away from the middle of the
 $B190 JR NZ,$B19E     ; object.}
 $B192 LD A,(IX+$09)   ; Fetch the y velocity.
 $B195 INC A           ; {Add two.
 $B196 INC A           ; }
 $B197 JP P,$B19E      ; Jump to #R$B19E if the result is positive, as the creature is
                       ; already moving down.
 $B19A CPL             ; Invert the y velocity, to send the creature down.
 $B19B LD (IX+$09),A   ; Store the y velocity.
@label=Handle_Flying_Creature_Bounce_Sideways
*$B19E LD A,(IX+$08)   ; Fetch the x velocity.
 $B1A1 BIT 7,C         ; {Jump to #R$B1B0 if the creature is on the left of the
 $B1A3 JR Z,$B1B0      ; object.}
 $B1A5 INC A           ; {Add two.
 $B1A6 INC A           ; }
 $B1A7 JP P,$B1B9      ; Jump to #R$B1B9 if the result is positive, as the creature is
                       ; already moving right.
 $B1AA CPL             ; Invert the x velocity, to send the creature right.
 $B1AB LD (IX+$08),A   ; Store the x velocity.
 $B1AE JR $B1B9        ; Jump to #R$B1B9.
@label=Handle_Flying_Creature_Bounce_Left
*$B1B0 DEC A           ; {Subtract two.
 $B1B1 DEC A           ; }
 $B1B2 JP M,$B1B9      ; Jump to #R$B1B9 if the result is negative, as the creature is
                       ; already moving left.
 $B1B5 CPL             ; Invert the x velocity, to send the creature left.
 $B1B6 LD (IX+$08),A   ; Store the x velocity.
; Move the creature sideways. Reset bits 0 and 4 of the contact flags
; first.
@label=Handle_Flying_Creature_Move_Sideways
*$B1B9 LD A,(IX+$0B)   ; Fetch the contact flags.
 $B1BC AND %11101110   ; Reset bits 0 and 4.
 $B1BE LD (IX+$0B),A   ; Store the contact flags.
 $B1C1 LD L,(IX+$08)   ; Fetch the x velocity into #REGl.
 $B1C4 BIT 7,L         ; Test the sign of the x velocity.
 $B1C6 LD H,$00        ; Clear the high byte of the x velocity (as a word).
 $B1C8 JR Z,$B1CC      ; Jump to #R$B1CC if the x velocity is positive.
 $B1CA LD H,$FF        ; Set the high byte of the x velocity to #N$FF to extend
                       ; the sign.
@label=Handle_Flying_Creature_Add_X_Velocity
*$B1CC CALL $EE42      ; Add the x velocity to the x position (see #R$EE42). #REGa is the new
                       ; x position, and the zero flag is set when it is less than #N$80.
 $B1CF JP Z,$B236      ; Jump to #R$B236 if the x position is less than #N$80.
 $B1D2 CP $D0          ; {Jump to #R$B1E4 if the x position is less than #N$D0.
 $B1D4 JR C,$B1E4      ; }
 $B1D6 BIT 2,E         ; {Jump to #R$B25E if the room has no right wall.
 $B1D8 JP Z,$B25E      ; }
 $B1DB LD A,(IX+$08)   ; Fetch the x velocity.
 $B1DE CPL             ; Invert it, to bounce off the right wall.
 $B1DF LD (IX+$08),A   ; Store the x velocity.
 $B1E2 LD A,$CF        ; Set the x position to #N$CF.
@label=Handle_Flying_Creature_Store_X
*$B1E4 LD (IX+$01),A   ; Store the x position.
; Move the creature up or down. Reset bits 2 and 6 of the contact flags
; first.
 $B1E7 LD A,(IX+$0B)   ; Fetch the contact flags.
 $B1EA AND %10111011   ; Reset bits 2 and 6.
 $B1EC LD (IX+$0B),A   ; Store the contact flags.
 $B1EF LD L,(IX+$09)   ; Fetch the y velocity into #REGl.
 $B1F2 BIT 7,L         ; Test the sign of the y velocity.
 $B1F4 LD H,$00        ; Clear the high byte of the y velocity (as a word).
 $B1F6 JR Z,$B1FA      ; Jump to #R$B1FA if the y velocity is positive.
 $B1F8 LD H,$FF        ; Set the high byte of the y velocity to #N$FF to extend
                       ; the sign.
@label=Handle_Flying_Creature_Add_Y_Velocity
*$B1FA CALL $EE54      ; Add the y velocity to the y position (see #R$EE54). #REGa is the new
                       ; y position, and the zero flag is set when it is less than #N$80.
 $B1FD JP Z,$B282      ; Jump to #R$B282 if the y position is less than #N$80.
 $B200 CP $9F          ; {Jump to #R$B212 if the y position is less than #N$9F.
 $B202 JR C,$B212      ; }
 $B204 BIT 4,E         ; {Jump to #R$B2AA if the room has no floor.
 $B206 JP Z,$B2AA      ; }
 $B209 LD A,(IX+$09)   ; Fetch the y velocity.
 $B20C CPL             ; Invert it, to bounce off the floor.
 $B20D LD (IX+$09),A   ; Store the y velocity.
 $B210 LD A,$9F        ; Set the y position to #N$9F.
@label=Handle_Flying_Creature_Store_Y
*$B212 LD (IX+$03),A   ; Store the y position.
 $B215 JP $96CB        ; Jump to #R$96CB.
; Sabreman is on the left of the creature, so subtract two from the x
; velocity, down to a limit of #N$C0.
@label=Handle_Flying_Creature_Steer_Left
*$B218 SUB $02         ; Subtract two from the x velocity.
 $B21A BIT 7,A         ; {Jump to #R$B116 if the x velocity is positive.
 $B21C JP Z,$B116      ; }
 $B21F CP $C0          ; {Jump to #R$B119 if the x velocity is less than #N$C0.
 $B221 JP C,$B119      ; }
 $B224 JP $B116        ; Jump to #R$B116.
; Sabreman is above the creature, so subtract two from the y velocity,
; down to a limit of #N$C0.
@label=Handle_Flying_Creature_Steer_Up
*$B227 SUB $02         ; Subtract two from the y velocity.
 $B229 BIT 7,A         ; {Jump to #R$B12F if the y velocity is positive.
 $B22B JP Z,$B12F      ; }
 $B22E CP $C0          ; {Jump to #R$B132 if the y velocity is less than #N$C0.
 $B230 JP C,$B132      ; }
 $B233 JP $B12F        ; Jump to #R$B12F.
; The x position is less than #N$80. The creature bounces off the left
; wall if there is one, and leaves the room by the gap otherwise.
@label=Handle_Flying_Creature_Test_Left_Edge
*$B236 CP $18          ; {Jump to #R$B1E4 if the x position is #N$18 or more.
 $B238 JP NC,$B1E4     ; }
 $B23B BIT 6,E         ; {Jump to #R$B24B if the room has no left wall.
 $B23D JR Z,$B24B      ; }
 $B23F LD A,(IX+$08)   ; Fetch the x velocity.
 $B242 CPL             ; Invert it, to bounce off the left wall.
 $B243 LD (IX+$08),A   ; Store the x velocity.
 $B246 LD A,$18        ; Set the x position to #N$18.
 $B248 JP $B1E4        ; Jump to #R$B1E4.
@label=Handle_Flying_Creature_Test_Left_Gap
*$B24B CP $08          ; {Jump to #R$B271 if the x position is #N$08 or more.
 $B24D JR NC,$B271     ; }
 $B24F DEC (IX+$02)    ; Move the creature to the room on the left.
 $B252 LD (IX+$01),$D0 ; Set the x position to #N$D0.
 $B256 BIT 0,(IX+$0F)  ; {Return if the creature has not been drawn yet.
 $B25A RET NZ          ; }
 $B25B JP $9636        ; Erase the sprite of the creature.
@label=Handle_Flying_Creature_Test_Right_Gap
*$B25E CP $E7          ; {Jump to #R$B271 if the x position is less than #N$E7.
 $B260 JR C,$B271      ; }
 $B262 INC (IX+$02)    ; Move the creature to the room on the right.
 $B265 LD (IX+$01),$18 ; Set the x position to #N$18.
 $B269 BIT 0,(IX+$0F)  ; {Return if the creature has not been drawn yet.
 $B26D RET NZ          ; }
 $B26E JP $9636        ; Erase the sprite of the creature.
; The creature is in a gap in the left or right wall, so set bits 0 and 4
; in the contact flags and in #REGe, which makes the ceiling and the floor seem
; to be present.
@label=Handle_Flying_Creature_Set_Gap_Flags
*$B271 EX AF,AF'       ; Save the new position in #REGaf'.
 $B272 LD A,(IX+$0B)   ; Fetch the contact flags.
 $B275 OR %00010001    ; Set bits 0 and 4.
 $B277 LD (IX+$0B),A   ; Store the contact flags.
 $B27A LD A,E          ; Copy the flags of the room to #REGa.
 $B27B OR %00010001    ; Set bits 0 and 4.
 $B27D LD E,A          ; Store them in #REGe.
 $B27E EX AF,AF'       ; Restore the new position from #REGaf'.
 $B27F JP $B1E4        ; Jump to #R$B1E4.
; The y position is less than #N$80. The creature bounces off the ceiling
; if there is one, and leaves the room by the gap otherwise.
@label=Handle_Flying_Creature_Test_Top_Edge
*$B282 CP $4C          ; {Jump to #R$B212 if the y position is #N$4C or more.
 $B284 JR NC,$B212     ; }
 $B286 BIT 0,E         ; {Jump to #R$B297 if the room has no ceiling.
 $B288 JP Z,$B297      ; }
 $B28B LD A,(IX+$09)   ; Fetch the y velocity.
 $B28E CPL             ; Invert it, to bounce off the ceiling.
 $B28F LD (IX+$09),A   ; Store the y velocity.
 $B292 LD A,$4C        ; Set the y position to #N$4C.
 $B294 JP $B212        ; Jump to #R$B212.
@label=Handle_Flying_Creature_Test_Top_Gap
*$B297 CP $2A          ; {Jump to #R$B2BD if the y position is #N$2A or more.
 $B299 JR NC,$B2BD     ; }
 $B29B DEC (IX+$04)    ; Move the creature to the room above.
 $B29E LD (IX+$03),$90 ; Set the y position to #N$90.
 $B2A2 BIT 0,(IX+$0F)  ; {Return if the creature has not been drawn yet.
 $B2A6 RET NZ          ; }
 $B2A7 JP $9636        ; Erase the sprite of the creature.
@label=Handle_Flying_Creature_Test_Bottom_Gap
*$B2AA CP $BF          ; {Jump to #R$B2BD if the y position is less than #N$BF.
 $B2AC JR C,$B2BD      ; }
 $B2AE INC (IX+$04)    ; Move the creature to the room below.
 $B2B1 LD (IX+$03),$40 ; Set the y position to #N$40.
 $B2B5 BIT 0,(IX+$0F)  ; {Return if the creature has not been drawn yet.
 $B2B9 RET NZ          ; }
 $B2BA JP $9636        ; Erase the sprite of the creature.
; The creature is in a gap in the ceiling or the floor, so set bits 2 and
; 6 in the contact flags and in #REGaf', which makes the side walls seem to be
; present.
@label=Handle_Flying_Creature_Set_Vertical_Gap_Flags
*$B2BD EX AF,AF'       ; Save the new position in #REGaf'.
 $B2BE LD A,(IX+$0B)   ; Fetch the contact flags.
 $B2C1 OR %01000100    ; Set bits 2 and 6.
 $B2C3 LD (IX+$0B),A   ; Store the contact flags.
 $B2C6 EX AF,AF'       ; Restore the new position from #REGaf'.
 $B2C7 JP $B212        ; Jump to #R$B212.

; Unused
;
; Never reached, as nothing jumps here. Sets bit 0 of the redraw flags of
; the object, so that its sprite is drawn without being erased first, and
; returns.
;
; IX Object record
@label=Unused_Set_Creature_Redraw_Flag
u$B2CA LD (IX+$0F),$01 ; Set the redraw flags to #N$01.
 $B2CE RET             ; Return.

; Move Creature Horizontally
;
; Used by the routines at #R$B079, #R$B3D8 and #R$EE66.
; .
; Moves a creature one step closer to Sabreman's room when it is in a
; different room x. It does not draw the creature. It is entered with the carry
; flag set if Sabreman's room x is less than the room x of the creature.
; .
; The creature is flagged so that it will be drawn without being erased when it
; arrives. It accelerates by two on each call in the direction of Sabreman's
; room, up to a speed of #N$30, and its x position changes by a sixteenth of the
; speed. When the x position goes past #N$D0 (or below #N$18) it moves into the
; next room.
; .
; The y position is kept at #N$40 or more, and when it is #N$80 or more it moves
; up two pixels each time.
; .
; A creature cannot leave its room through a wall. If the wall is on the side
; that it is going to, it is removed when it is in the same room y as Sabreman,
; and otherwise #R$B358 moves it up or down.
;
; IX Object record
; E Flags of the room that the creature is in
@label=Move_Creature_Horizontally
c$B2CF LD (IX+$0F),$01 ; Set the redraw flags to #N$01, so that the creature is drawn without
                       ; being erased when it arrives.
 $B2D3 LD (IX+$0B),$00 ; Clear the contact flags.
 $B2D7 JR C,$B31B      ; Jump to #R$B31B if Sabreman is on the left of the
                       ; creature.
 $B2D9 BIT 2,E         ; {Jump to #R$B34B if the room has a right wall.
 $B2DB JR NZ,$B34B     ; }
 $B2DD LD A,(IX+$08)   ; Fetch the x velocity.
 $B2E0 ADD A,$02       ; Accelerate to the right by adding two.
 $B2E2 BIT 7,A         ; {Jump to #R$B2EA if the x velocity is negative.
 $B2E4 JR NZ,$B2EA     ; }
 $B2E6 CP $31          ; {Jump to #R$B2ED if the x velocity has reached #N$31.
 $B2E8 JR NC,$B2ED     ; }
@label=Move_Creature_Horizontally_Store_Velocity
*$B2EA LD (IX+$08),A   ; Store the x velocity.
@label=Move_Creature_Horizontally_Move_Right
*$B2ED LD A,(IX+$08)   ; Fetch the x velocity.
 $B2F0 SRA A           ; {Divide it by sixteen, keeping the sign.
 $B2F2 SRA A           ;
 $B2F4 SRA A           ;
 $B2F6 SRA A           ; }
 $B2F8 ADD A,(IX+$01)  ; Add the x position of the creature.
 $B2FB CP $D0          ; {Jump to #R$B304 if the x position is less than #N$D0.
 $B2FD JR C,$B304      ; }
 $B2FF INC (IX+$02)    ; Move the creature to the room on the right.
 $B302 LD A,$08        ; Set the x position to #N$08.
@label=Move_Creature_Horizontally_Store_X
*$B304 LD (IX+$01),A   ; Store the x position.
; Keep the y position between #N$40 and #N$80, and make it drift upwards
; when it is #N$80 or more.
@label=Move_Creature_Horizontally_Adjust_Y
*$B307 LD A,(IX+$03)   ; Fetch the y position.
 $B30A CP $40          ; {Jump to #R$B312 if the y position is #N$40 or more.
 $B30C JR NC,$B312     ; }
 $B30E LD (IX+$03),$40 ; Set the y position to #N$40.
@label=Move_Creature_Horizontally_Drift_Up
*$B312 CP $80          ; {Return if the y position is less than #N$80.
 $B314 RET C           ; }
 $B315 SUB $02         ; Subtract two.
 $B317 LD (IX+$03),A   ; Store the y position.
 $B31A RET             ; Return.
; Sabreman is on the left of the creature.
@label=Move_Creature_Horizontally_Move_Left
*$B31B BIT 6,E         ; {Jump to #R$B34B if the room has a left wall.
 $B31D JR NZ,$B34B     ; }
 $B31F LD A,(IX+$08)   ; Fetch the x velocity.
 $B322 SUB $02         ; Accelerate to the left by subtracting two.
 $B324 BIT 7,A         ; {Jump to #R$B32C if the x velocity is positive.
 $B326 JR Z,$B32C      ; }
 $B328 CP $D0          ; {Jump to #R$B32F if the x velocity is less than #N$D0.
 $B32A JR C,$B32F      ; }
@label=Move_Creature_Horizontally_Store_Left_Velocity
*$B32C LD (IX+$08),A   ; Store the x velocity.
@label=Move_Creature_Horizontally_Add_Left_Velocity
*$B32F LD A,(IX+$08)   ; Fetch the x velocity.
 $B332 SRA A           ; {Divide it by sixteen, keeping the sign.
 $B334 SRA A           ;
 $B336 SRA A           ;
 $B338 SRA A           ; }
 $B33A ADD A,(IX+$01)  ; Add the x position of the creature.
 $B33D CP $18          ; {Jump to #R$B346 if the x position is #N$18 or more.
 $B33F JR NC,$B346     ; }
 $B341 DEC (IX+$02)    ; Move the creature to the room on the left.
 $B344 LD A,$DF        ; Set the x position to #N$DF.
@label=Move_Creature_Horizontally_Store_Left_X
*$B346 LD (IX+$01),A   ; Store the x position.
 $B349 JR $B307        ; Jump to #R$B307.
; The creature cannot go that way.
@label=Move_Creature_Horizontally_Blocked
*$B34B LD A,($8F1E)    ; Fetch the room y of Sabreman.
 $B34E CP (IX+$04)     ; {Jump to #R$B358 if the creature is in a different
 $B351 JR NZ,$B358     ; room y.}
; This entry point is used by the routine at #R$B358.
@label=Move_Creature_Horizontally_Remove_Creature
*$B353 LD (IX+$00),$00 ; Remove the creature.
 $B357 RET             ; Return.

; Move Creature Vertically
;
; Used by the routines at #R$B079, #R$B2CF, #R$B3D8 and #R$EE66.
; .
; Moves a creature one step closer to Sabreman's room when it is in a
; different room y (and the same room x). It works like #R$B2CF but vertically.
; It is entered with the carry flag set if Sabreman's room y is less than the
; room y of the creature.
; .
; The creature is removed if the room has a floor and it is above Sabreman's
; room (or a ceiling and it is below), as it cannot get through. The x position
; is kept between #N$18 and #N$E0.
;
; IX Object record
; E Flags of the room that the creature is in
@label=Move_Creature_Vertically
c$B358 LD (IX+$0F),$01 ; Set the redraw flags to #N$01, so that the creature is drawn without
                       ; being erased when it arrives.
 $B35C LD (IX+$0B),$00 ; Clear the contact flags.
 $B360 JR C,$B3A3      ; Jump to #R$B3A3 if Sabreman is above the creature.
 $B362 BIT 4,E         ; {Jump to #R$B353 if the room has a floor.
 $B364 JR NZ,$B353     ; }
 $B366 LD A,(IX+$09)   ; Fetch the y velocity.
 $B369 ADD A,$02       ; Accelerate downwards by adding two.
 $B36B BIT 7,A         ; {Jump to #R$B373 if the y velocity is negative.
 $B36D JR NZ,$B373     ; }
 $B36F CP $31          ; {Jump to #R$B376 if the y velocity has reached #N$31.
 $B371 JR NC,$B376     ; }
@label=Move_Creature_Vertically_Store_Velocity
*$B373 LD (IX+$09),A   ; Store the y velocity.
@label=Move_Creature_Vertically_Move_Down
*$B376 LD A,(IX+$09)   ; Fetch the y velocity.
 $B379 SRA A           ; {Divide it by sixteen, keeping the sign.
 $B37B SRA A           ;
 $B37D SRA A           ;
 $B37F SRA A           ; }
 $B381 ADD A,(IX+$03)  ; Add the y position of the creature.
 $B384 CP $9F          ; {Jump to #R$B38D if the y position is less than #N$9F.
 $B386 JR C,$B38D      ; }
 $B388 INC (IX+$04)    ; Move the creature to the room below.
 $B38B LD A,$2C        ; Set the y position to #N$2C.
@label=Move_Creature_Vertically_Store_Y
*$B38D LD (IX+$03),A   ; Store the y position.
; Keep the x position between #N$18 and #N$E0.
@label=Move_Creature_Vertically_Adjust_X
*$B390 LD A,(IX+$01)   ; Fetch the x position.
 $B393 CP $18          ; {Jump to #R$B39B if the x position is #N$18 or more.
 $B395 JR NC,$B39B     ; }
 $B397 LD (IX+$01),$18 ; Set the x position to #N$18.
@label=Move_Creature_Vertically_Test_Right
*$B39B CP $E0          ; {Return if the x position is less than #N$E0.
 $B39D RET C           ; }
 $B39E LD (IX+$01),$E0 ; Set the x position to #N$E0.
 $B3A2 RET             ; Return.
; Sabreman is above the creature.
@label=Move_Creature_Vertically_Move_Up
*$B3A3 BIT 0,E         ; {Jump to #R$B353 if the room has a ceiling.
 $B3A5 JP NZ,$B353     ; }
 $B3A8 LD A,(IX+$09)   ; Fetch the y velocity.
 $B3AB SUB $02         ; Accelerate upwards by subtracting two.
 $B3AD BIT 7,A         ; {Jump to #R$B3B5 if the y velocity is positive.
 $B3AF JR Z,$B3B5      ; }
 $B3B1 CP $D0          ; {Jump to #R$B3B8 if the y velocity is less than #N$D0.
 $B3B3 JR C,$B3B8      ; }
@label=Move_Creature_Vertically_Store_Up_Velocity
*$B3B5 LD (IX+$09),A   ; Store the y velocity.
@label=Move_Creature_Vertically_Add_Up_Velocity
*$B3B8 LD A,(IX+$09)   ; Fetch the y velocity.
 $B3BB SRA A           ; {Divide it by sixteen, keeping the sign.
 $B3BD SRA A           ;
 $B3BF SRA A           ;
 $B3C1 SRA A           ; }
 $B3C3 ADD A,(IX+$03)  ; Add the y position of the creature.
 $B3C6 CP $40          ; {Jump to #R$B3CF if the y position is #N$40 or more.
 $B3C8 JR NC,$B3CF     ; }
 $B3CA DEC (IX+$04)    ; Move the creature to the room above.
 $B3CD LD A,$BF        ; Set the y position to #N$BF.
@label=Move_Creature_Vertically_Store_Up_Y
*$B3CF LD (IX+$03),A   ; Store the y position.
 $B3D2 JR $B390        ; Jump to #R$B390.

; Destroy Flying Creature
;
; Used by the routine at #R$B079.
; .
; Reached when a thrown weapon has hit a creature. It restores the
; registers that #R$B132 stashed and goes on to destroy the creature at #R$DF42.
;
; IX Object record
@label=Destroy_Flying_Creature
c$B3D4 POP DE        ; Restore #REGde from the stack.
 $B3D5 JP $DF42      ; Destroy the creature.

; Handle Jellyfish
;
; Handler for the object types #N$44 to #N$47 (jellyfish). A jellyfish is
; a flying creature that is handled like the eagles and vultures (see #R$B079),
; except that its x velocity is always #N$30 (to the right) or #N$D0 (to the
; left), and its y velocity only ever increases, up to #N$20, so that it sinks
; and bounces off the floor and the decorations.
; .
; If the jellyfish is in a different room x from Sabreman, #R$B2CF moves it. If
; it is in a room that is below Sabreman's room, it is removed. If it is in a
; room that is above Sabreman's room, #R$B358 moves it down.
;
; IX Object record
@label=Handle_Jellyfish
c$B3D8 CALL $98CC      ; Read the world map entry of the room that the jellyfish is in. The
                       ; flags of the room are returned in #REGe.
 $B3DB LD A,(IX+$0B)   ; Fetch the contact flags of the jellyfish.
 $B3DE OR E            ; Combine them with the flags of the room.
 $B3DF LD E,A          ; Store the result in #REGe.
 $B3E0 LD A,($8F1C)    ; Fetch the room x of Sabreman.
 $B3E3 CP (IX+$02)     ; {Jump to #R$B2CF if the jellyfish is in a different
 $B3E6 JP NZ,$B2CF     ; room x.}
 $B3E9 LD A,($8F1E)    ; Fetch the room y of Sabreman.
 $B3EC CP (IX+$04)     ; {Jump to #R$B3F9 if the jellyfish is in the same room
 $B3EF JR Z,$B3F9      ; y.}
 $B3F1 JP NC,$B358     ; Jump to #R$B358 if Sabreman is in a room below the
                       ; jellyfish.
 $B3F4 LD (IX+$00),$00 ; Remove the jellyfish, as Sabreman is in a room above
                       ; it.
 $B3F8 RET             ; Return.
@label=Handle_Jellyfish_Animate
*$B3F9 CALL $B41F      ; Animate the jellyfish.
 $B3FC LD A,(IX+$09)   ; Fetch the y velocity.
 $B3FF INC A           ; Add one to the y velocity, so that gravity slowly pulls the
                       ; jellyfish down.
 $B400 BIT 7,A         ; {Jump to #R$B408 if the y velocity is negative.
 $B402 JR NZ,$B408     ; }
 $B404 CP $21          ; {Jump to #R$B40B if the y velocity has reached #N$21.
 $B406 JR NC,$B40B     ; }
@label=Handle_Jellyfish_Store_Y_Velocity
*$B408 LD (IX+$09),A   ; Store the y velocity.
; This entry point is used by the routine at #R$EE66.
@label=Handle_Jellyfish_Set_X_Velocity
*$B40B BIT 7,(IX+$08)  ; {Jump to #R$B418 if the x velocity is negative.
 $B40F JR NZ,$B418     ; }
 $B411 LD (IX+$08),$30 ; Set the x velocity to #N$30 (right).
 $B415 JP $B132        ; Jump to #R$B132 to check for contact and to move the
                       ; jellyfish.
@label=Handle_Jellyfish_Move_Left
*$B418 LD (IX+$08),$D0 ; Set the x velocity to #N$D0 (left).
 $B41C JP $B132        ; Jump to #R$B132 to check for contact and to move the
                       ; jellyfish.

; Animate Jellyfish
;
; Used by the routines at #R$B3D8 and #R$EE66.
; .
; Counts a jellyfish through the six steps of its animation. The type of
; the jellyfish gets the counter divided by two (so #N$00, #N$01 or #N$02) in
; its low two bits, which gives three frames.
;
; IX Object record
@label=Animate_Jellyfish
c$B41F CALL $989F    ; Save the state of the jellyfish.
 $B422 INC (IX+$0E)  ; Increase the animation counter of the jellyfish.
 $B425 LD A,(IX+$0E) ; Fetch the animation counter of the jellyfish.
 $B428 CP $06        ; {Jump to #R$B430 if the animation counter is less than
 $B42A JR C,$B430    ; #N$06.}
 $B42C XOR A         ; {Reset the animation counter.
 $B42D LD (IX+$0E),A ; }
@label=Animate_Jellyfish_Set_Type
*$B430 RRA           ; Divide the animation counter by two.
 $B431 AND %00000011 ; Keep only the two low bits.
 $B433 LD C,A        ; Keep the frame in #REGc.
 $B434 LD A,(IX+$00) ; Fetch the type of the jellyfish.
 $B437 AND %11111100 ; Reset the two low bits.
 $B439 OR C          ; Combine the type with the frame.
 $B43A LD (IX+$00),A ; Store the type of the jellyfish.
 $B43D RET           ; Return.

; Check Decoration Contact
;
; Used by the routines at #R$A316, #R$A433, #R$A6A6, #R$A925, #R$B079, #R$B58C,
; #R$DF98, #R$E2CB, #R$E570 and #R$E8D7.
; .
; Checks whether an object touches one of the decorations, using #R$B46A.
; In the special rooms (a room y below #N$10) the four records that start at
; #R$8F7A are checked. In the cave rooms the two records that start at
; #R$8F9A are checked. The check stops at the first decoration that the
; object touches.
; .
; Interrupts are disabled while the check is made, as the result is kept in
; #REGaf'.
;
;   IX Object record
; O:B #N$A0 less the y position of the top of the decoration
; O:C Contact result (see #R$B46A)
@label=Check_Decoration_Contact
c$B43E DI            ; Disable interrupts.
 $B43F PUSH IY       ; Stash #REGiy on the stack.
 $B441 LD A,(IX+$04) ; Fetch the room y of the object.
 $B444 CP $10        ; {Jump to #R$B450 if the object is in a cave room.
 $B446 JR NC,$B450   ; }
 $B448 LD IY,$8F7A   ; Point #REGiy at #R$8F7A.
 $B44C LD B,$04      ; Set a counter in #REGb for the four records.
 $B44E JR $B456      ; Jump to #R$B456.
@label=Check_Decoration_Contact_Cave_Room
*$B450 LD IY,$8F9A   ; Point #REGiy at the first of the two records that are used in a cave
                     ; room.
 $B454 LD B,$02      ; Set a counter in #REGb for the two records.
@label=Check_Decoration_Contact_Set_Record_Size
*$B456 LD DE,$0010   ; Set the size of an object record.
@label=Check_Decoration_Contact_Loop
*$B459 CALL $B46A    ; Check for contact with the object.
 $B45C BIT 2,C       ; {Jump to #R$B464 if the object touches the decoration.
 $B45E JR NZ,$B464   ; }
 $B460 ADD IY,DE     ; Move on to the next record.
 $B462 DJNZ $B459    ; Decrease the record counter and loop back for the next
                     ; record.
@label=Check_Decoration_Contact_Done
*$B464 POP IY        ; Restore #REGiy from the stack.
 $B466 EX AF,AF'     ; Swap in the height that #R$B46A left in #REGaf'.
 $B467 LD B,A        ; Copy it to #REGb.
 $B468 EI            ; Enable interrupts.
 $B469 RET           ; Return.

; Check Object Contact
;
; Used by the routine at #R$B43E.
; .
; Checks whether the object at #REGix touches the object at #REGiy, which
; is an obstacle. The bytes #N$0A to #N$0E of the obstacle record are not used
; for movement. Instead they describe the size of the obstacle: its half width
; (byte #N$0A), the width of its middle (byte #N$0B), its height (byte #N$0C),
; the depth from the top at which the object counts as being beside it (byte
; #N$0D) and the offset of the middle from its x position (byte #N$0E). The y
; position of an obstacle is the position of its bottom.
; .
; The result is returned in #REGc. Bit 2 is set if the objects touch. Bit 7 is
; set if #REGix is on the right of the middle of the obstacle. Bit 0 is set if
; #REGix is outside the width of the middle. Bit 1 is set if the bottom of
; #REGix is in the top part of the obstacle (so that it is standing or landing
; on it).
; .
; When the object touches the top of the obstacle, bit 4 of its contact flags is
; set (so it is standing on it) unless it is a weapon pickup (see #R$E8D7) or it
; is outside the width of the middle. An obstacle of type #N$88 is handled by
; #R$ED8A instead.
;
;   IX Object record
;   IY Obstacle record
; O:C Contact result
; O:AF' #N$A0 less the y position of the top of the obstacle
@label=Check_Object_Contact
c$B46A LD C,$00       ; Clear the contact result.
 $B46C LD A,(IY+$00)  ; Fetch the type of the obstacle.
 $B46F AND A          ; {Return if the obstacle record is empty.
 $B470 RET Z          ; }
 $B471 BIT 0,(IY+$0F) ; {Return if the obstacle has just been created.
 $B475 RET NZ         ; }
 $B476 CP $88         ; {Jump to #R$ED8A if the obstacle is a type #N$88
 $B478 JP Z,$ED8A     ; object.}
 $B47B LD A,(IY+$01)  ; Fetch the x position of the obstacle.
 $B47E ADD A,(IY+$0E) ; Add the offset of its middle.
 $B481 SUB (IX+$01)   ; {Jump to #R$B48B if the object is on the left of the middle of the
 $B484 JP P,$B48B     ; obstacle.}
 $B487 NEG            ; Make the distance positive.
 $B489 SET 7,C        ; Set bit 7 of the result, as the object is on the right.
@label=Check_Object_Contact_Test_Distance
*$B48B CP (IY+$0A)    ; {Jump to #R$B4CA if the distance is too great for them
 $B48E JR NC,$B4CA    ; to touch.}
 $B490 CP (IY+$0B)    ; {Jump to #R$B497 if the object is inside the width of
 $B493 JR C,$B497     ; the middle.}
 $B495 SET 0,C        ; Set bit 0 of the result, as the object is outside the
                      ; middle.
@label=Check_Object_Contact_Test_Height
*$B497 LD A,(IY+$03)  ; Fetch the y position of the obstacle.
 $B49A SUB (IX+$03)   ; {Jump to #R$B4CA if the object is below the bottom of
 $B49D JP M,$B4CA     ; the obstacle.}
 $B4A0 PUSH AF        ; Stash the distance.
 $B4A1 LD A,(IY+$03)  ; {Work out the y position of the top of the obstacle.
 $B4A4 SUB (IY+$0C)   ; }
 $B4A7 SUB $A0        ; {Subtract it from #N$A0.
 $B4A9 NEG            ; }
 $B4AB EX AF,AF'      ; Keep the result in #REGaf'.
 $B4AC POP AF         ; Restore the distance.
 $B4AD CP (IY+$0C)    ; {Jump to #R$B4CA if the distance is the height of the obstacle or
 $B4B0 JR NC,$B4CA    ; more.}
 $B4B2 SET 2,C        ; Set bit 2 of the result, as the objects touch.
 $B4B4 CP (IY+$0D)    ; {Return if the distance is less than the depth in byte #N$0D of the
 $B4B7 RET C          ; obstacle.}
 $B4B8 SET 1,C        ; Set bit 1 of the result, as the object is on top of the
                      ; obstacle.
 $B4BA LD A,(IX+$00)  ; Fetch the type of the object.
 $B4BD AND %11111100  ; Reset the two low bits.
 $B4BF CP $68         ; {Return if the object is a weapon pickup.
 $B4C1 RET Z          ; }
 $B4C2 BIT 0,C        ; {Return if the object is outside the width of the
 $B4C4 RET NZ         ; middle.}
 $B4C5 SET 4,(IX+$0B) ; Set bit 4 of the contact flags of the object, as it is standing on
                      ; the obstacle.
 $B4C9 RET            ; Return.
; This entry point is used by the routine at #R$ED8A.
@label=Check_Object_Contact_None
*$B4CA LD C,$00       ; Clear the result, as the objects do not touch.
 $B4CC RET            ; Return.

; Adjust Throw Facing
;
; Used by the routine at #R$B4D1.
; .
; Subtracts two (instead of one) from the type of Sabreman when #R$B4D1
; works out which way he is facing, as his type is #N$15 or more. It carries on
; at #R$B538.
;
; A Type of Sabreman
@label=Adjust_Throw_Facing
c$B4CD SUB $02       ; Subtract two from the type.
 $B4CF JR $B538      ; Jump to #R$B538.

; Throw Weapon
;
; Used by the routines at #R$A316, #R$A433, #R$A6A6 and #R$E570.
; .
; Throws a weapon that Sabreman is carrying. Nothing happens if bit 0 of
; the redraw flags of Sabreman is set or if he is not carrying a weapon (one of
; the types #N$68 to #N$6B in the three slots from #R$8EEB).
; .
; One weapon at a time is thrown unless the counter in #R$AAAB allows another:
; the counter is reset while both weapon records are empty, and while a weapon
; is in flight it goes up each time this routine is called, so a weapon is
; thrown only when its low three bits are zero.
; .
; The weapon record is a free one of the two records at #R$8EFA and #R$8F0A. The
; type, the position and the attribute are copied from Sabreman. The type of the
; weapon is then changed to the type of the projectile for the weapon that was
; carried (from the table at #R$B753), plus one if it is thrown to the left. The
; weapon starts #N$08 pixels to the side of Sabreman and #N$08 pixels higher,
; with an x velocity between #N$40 and #N$7F and an upward y velocity that comes
; from the frame counter. Bit 2 of the type of Sabreman, less one (or less two
; if his type is #N$15 or more), tells which way he is facing (set for the
; right). The weapon is not thrown if there is no room to its left.
;
; IX Object record of Sabreman
@label=Throw_Weapon
c$B4D1 LD A,($8F29)  ; Fetch the redraw flags of Sabreman.
 $B4D4 AND %00000001 ; Keep only bit 0.
 $B4D6 RET NZ        ; Return if Sabreman has only just appeared in the room (bit 0 is
                     ; set).
 $B4D7 LD HL,$8EEB   ; Point #REGhl at the first of the three slots that hold the items
                     ; that Sabreman carries.
 $B4DA LD B,$03      ; Set a counter in #REGb for the three slots.
@label=Throw_Weapon_Find_Weapon
*$B4DC LD A,(HL)     ; Fetch the type of the item.
 $B4DD AND %11111100 ; Reset the two low bits.
 $B4DF CP $68        ; {Jump to #R$B4E7 if the item is a weapon.
 $B4E1 JR Z,$B4E7    ; }
 $B4E3 INC HL        ; Move on to the next slot.
 $B4E4 DJNZ $B4DC    ; Decrease the slot counter and loop back for the next
                     ; slot.
 $B4E6 RET           ; Return, as Sabreman has no weapon.
@label=Throw_Weapon_Found
*$B4E7 LD C,(HL)     ; Fetch the type of the weapon into #REGc.
 $B4E8 LD A,($8EFA)  ; {Fetch the type of the first weapon record into #REGb.
 $B4EB LD B,A        ; }
 $B4EC LD A,($8F0A)  ; {Combine it with the type of the second weapon record, and jump to
 $B4EF OR B          ; #R$B4F6 if both of the records are empty.
 $B4F0 JR Z,$B4F6    ; }
 $B4F2 LD A,($AAAB)  ; Fetch the fire key flag.
 $B4F5 INC A         ; Increase it.
@label=Throw_Weapon_Store_Counter
*$B4F6 LD ($AAAB),A  ; Store the counter.
 $B4F9 AND %00000111 ; Keep only the low three bits.
 $B4FB RET NZ        ; Return unless they are zero (a weapon can only be thrown on one pass
                     ; in eight).
 $B4FC LD DE,$8EFA   ; Point #REGde at #R$8EFA.
 $B4FF LD A,(DE)     ; Fetch its type.
 $B500 AND A         ; {Jump to #R$B509 if the record is empty.
 $B501 JR Z,$B509    ; }
 $B503 LD DE,$8F0A   ; Point #REGde at #R$8F0A.
 $B506 LD A,(DE)     ; Fetch its type.
 $B507 AND A         ; {Return if the record is in use too.
 $B508 RET NZ        ; }
@label=Throw_Weapon_Copy_Position
*$B509 LD HL,$8F1A   ; Point #REGhl at the record of Sabreman.
 $B50C PUSH BC       ; Stash the type of the weapon.
 $B50D LD BC,$0006   ; Set the number of bytes to copy to #N$06.
 $B510 PUSH DE       ; Stash the address of the weapon record.
 $B511 LDIR          ; Copy the type, the position and the attribute of Sabreman to the
                     ; weapon record.
 $B513 POP HL        ; Restore the address of the weapon record to #REGhl.
 $B514 POP BC        ; Restore the type of the weapon to #REGc.
 $B515 LD A,($5C78)  ; Fetch the low byte of the frame counter.
 $B518 LD B,A        ; Store it in #REGb.
 $B519 LD A,($8ED6)  ; Fetch the tick counter.
 $B51C ADD A,B       ; Add the low byte of the frame counter.
 $B51D AND %01111111 ; Keep only the low seven bits.
 $B51F OR %01000000  ; Set bit 6.
 $B521 LD B,A        ; Store the result in #REGb, to use as the x velocity of
                     ; the weapon.
 $B522 LD A,C        ; Fetch the type of the weapon.
 $B523 AND %00000011 ; Keep only the two low bits.
 $B525 LD DE,$B753   ; Point #REGde at #R$B753.
 $B528 ADD A,E       ; {Add the weapon number to the address.
 $B529 LD E,A        ;
 $B52A LD A,D        ;
 $B52B ADC A,$00     ;
 $B52D LD D,A        ; }
 $B52E LD A,(DE)     ; {Fetch the type of the projectile into #REGc.
 $B52F LD C,A        ; }
 $B530 LD A,(IX+$00) ; Fetch the type of Sabreman.
 $B533 CP $15        ; {Jump to #R$B4CD if the type is #N$15 or more.
 $B535 JR NC,$B4CD   ; }
 $B537 DEC A         ; Subtract one from the type.
; This entry point is used by the routine at #R$B4CD.
@label=Throw_Weapon_Test_Facing
*$B538 INC HL        ; Move to the x position in the weapon record.
 $B539 LD DE,$0003   ; Set #REGde to #N$0003.
 $B53C AND %00000100 ; Test which way Sabreman is facing (bit 2 of the type that was
                     ; worked out).
 $B53E LD A,(HL)     ; Fetch the x position.
 $B53F JR Z,$B545    ; Jump to #R$B545 if Sabreman is facing left.
 $B541 ADD A,$08     ; Add #N$08, to start the weapon on his right.
 $B543 JR $B54F      ; Jump to #R$B54F.
@label=Throw_Weapon_Face_Left
*$B545 SUB $08       ; {Jump to #R$B576 if the x position would be below zero.
 $B547 JR C,$B576    ; }
 $B549 PUSH AF       ; {Invert the x velocity in #REGb, so that it is negative.
 $B54A LD A,B        ;
 $B54B CPL           ;
 $B54C LD B,A        ;
 $B54D POP AF        ; }
 $B54E INC C         ; Use the next projectile type, for a weapon that travels
                     ; to the left.
@label=Throw_Weapon_Store_Position
*$B54F LD (HL),A     ; Store the x position.
 $B550 DEC HL        ; Move back to the type.
 $B551 LD (HL),C     ; Store the type of the projectile.
 $B552 INC HL        ; {Move to the y position.
 $B553 INC HL        ;
 $B554 INC HL        ; }
 $B555 LD A,(HL)     ; Fetch the y position.
 $B556 SUB $08       ; Subtract #N$08.
 $B558 LD (HL),A     ; Store the y position.
 $B559 ADD HL,DE     ; Move to byte #N$06 of the record.
 $B55A LD (HL),$00   ; Clear byte #N$06 of the record.
 $B55C INC HL        ; {Move to the x velocity.
 $B55D INC HL        ; }
 $B55E LD (HL),B     ; Store the x velocity.
 $B55F INC HL        ; Move to the y velocity.
 $B560 LD A,($5C78)  ; Fetch the low byte of the frame counter.
 $B563 RLA           ; {Multiply it by four.
 $B564 RLA           ; }
 $B565 AND %01111111 ; Keep only the low seven bits.
 $B567 NEG           ; Negate it, to make an upward velocity.
 $B569 LD (HL),A     ; Store the y velocity.
 $B56A LD A,($8F25)  ; Fetch the contact flags of Sabreman.
 $B56D INC HL        ; {Move to the contact flags.
 $B56E INC HL        ; }
 $B56F LD (HL),A     ; Store the contact flags.
 $B570 LD E,$04      ; Set #REGe to #N$04.
 $B572 ADD HL,DE     ; Move to the redraw flags.
 $B573 LD (HL),$01   ; Set bit 0 of the redraw flags, so that the weapon is drawn without
                     ; being erased first.
 $B575 RET           ; Return.
@label=Throw_Weapon_Cancel
*$B576 DEC HL        ; Move back to the type.
 $B577 LD (HL),$00   ; Empty the weapon record.
 $B579 RET           ; Return.

; Handle Thrown Weapon
;
; Handler for the object types #N$38 to #N$3B (orbs). The two low bits of
; the type are set from the tick counter, which animates the orb. It carries on
; with #R$B58C.
;
; IX Object record
@label=Handle_Thrown_Weapon
c$B57A CALL $989F    ; Save the state of the orb.
 $B57D LD A,($8ED6)  ; Fetch the tick counter from #R$8ED6.
 $B580 AND %00000011 ; Keep only the two low bits (the frame of the weapon).
 $B582 LD B,A        ; Store the frame in #REGb.
 $B583 LD A,(IX+$00) ; Fetch the type.
 $B586 AND %11111100 ; Reset the two low bits.
 $B588 OR B          ; Combine them with the frame.
 $B589 LD (IX+$00),A ; Store the type.

; Move Thrown Weapon
;
; Used by the routines at #R$EA7D and #R$EA9C.
; .
; Moves a weapon in flight. The projectiles (see #R$EA9C) and the fire
; (see #R$EA7D) are moved by this routine too.
; .
; The object is removed if Sabreman is not in its room, or if bit 0 of byte
; #N$07 is set, which #R$B6F4 does when the weapon hits a creature. If it
; touches a decoration (see #R$B43E) it bursts into dust (see #R$DEDA) unless it
; lands on top, when it bounces.
; .
; The y velocity increases by four each time, up to #N$78. The x and y positions
; are moved by the velocities (multiplied by sixteen, with the fractions in
; bytes #N$0A and #N$0D). The weapon bursts when it hits a wall, bounces off the
; floor (making a puff of dust) and off the ceiling, and is removed when it
; leaves the room through a gap. While it is in a gap the contact flags of the
; weapon and the flags of the room are changed, as for a creature (see #R$B271).
;
; IX Object record
@label=Move_Thrown_Weapon
c$B58C LD A,($8F1C)    ; Fetch the room x of Sabreman.
 $B58F CP (IX+$02)     ; {Jump to #R$B6E3 if the object is in a different room
 $B592 JP NZ,$B6E3     ; x.}
 $B595 LD A,($8F1E)    ; Fetch the room y of Sabreman.
 $B598 CP (IX+$04)     ; {Jump to #R$B6E3 if the object is in a different room
 $B59B JP NZ,$B6E3     ; y.}
 $B59E BIT 0,(IX+$07)  ; {Jump to #R$B6D3 if the object has been marked for
 $B5A2 JP NZ,$B6D3     ; removal.}
 $B5A5 CALL $B43E      ; Check for contact with a decoration.
 $B5A8 BIT 2,C         ; {Jump to #R$B5C5 if the object does not touch one.
 $B5AA JR Z,$B5C5      ; }
 $B5AC LD A,C          ; Copy the result to #REGa.
 $B5AD AND %00000010   ; Keep only bit 1.
 $B5AF JP Z,$DEDA      ; Jump to #R$DEDA if the object is not on top of the decoration, so
                       ; that it bursts into dust.
 $B5B2 LD A,(IX+$09)   ; Fetch the y velocity.
 $B5B5 CPL             ; Invert it, to bounce.
 $B5B6 LD (IX+$09),A   ; Store the y velocity.
 $B5B9 LD A,$A0        ; Start from the level of the floor (#N$A0).
 $B5BB SUB B           ; Subtract #REGb to get the y position of the top of the
                       ; decoration.
 $B5BC LD (IX+$03),A   ; Store the y position, so that the object is on top.
 $B5BF CALL $DEB8      ; Make a puff of dust.
 $B5C2 JP $96CB        ; Jump to #R$96CB.
; Move the object. First the y velocity is increased by four, up to a
; limit of #N$78.
@label=Move_Thrown_Weapon_Move
*$B5C5 CALL $98CC      ; Read the world map entry of the room that the object
                       ; is in.
 $B5C8 LD A,(IX+$0B)   ; Fetch the contact flags.
 $B5CB OR E            ; Combine them with the flags of the room.
 $B5CC LD E,A          ; Store the result in #REGe.
 $B5CD LD (IX+$0B),$00 ; Clear the contact flags.
 $B5D1 LD A,(IX+$09)   ; Fetch the y velocity.
 $B5D4 ADD A,$04       ; Add four to the y velocity, as gravity pulls the
                       ; weapon down.
 $B5D6 BIT 7,A         ; {Jump to #R$B5E0 if the y velocity is negative.
 $B5D8 JR NZ,$B5E0     ; }
 $B5DA CP $78          ; {Jump to #R$B5E0 if the y velocity is less than #N$78.
 $B5DC JR C,$B5E0      ; }
 $B5DE LD A,$78        ; Limit the y velocity to #N$78.
@label=Move_Thrown_Weapon_Store_Y_Velocity
*$B5E0 LD (IX+$09),A   ; Store the y velocity.
; Add the x velocity, multiplied by sixteen, to the x position and its
; fraction. #REGa is zero or one to say whether the velocity is positive or
; negative.
 $B5E3 LD L,(IX+$08)   ; Fetch the x velocity into #REGl.
 $B5E6 XOR A           ; Set #REGa to zero.
 $B5E7 BIT 7,L         ; Test the sign of the x velocity.
 $B5E9 LD H,$00        ; Clear the high byte of the x velocity (as a word).
 $B5EB JR Z,$B5F0      ; Jump to #R$B5F0 if the x velocity is positive.
 $B5ED INC A           ; Set #REGa to one.
 $B5EE LD H,$FF        ; Set the high byte of the x velocity to #N$FF to extend
                       ; the sign.
@label=Move_Thrown_Weapon_Add_X_Velocity
*$B5F0 ADD HL,HL       ; {Multiply the x velocity by sixteen.
 $B5F1 ADD HL,HL       ;
 $B5F2 ADD HL,HL       ;
 $B5F3 ADD HL,HL       ; }
 $B5F4 LD C,(IX+$0A)   ; Fetch the fraction of the x position.
 $B5F7 LD B,(IX+$01)   ; Fetch the x position.
 $B5FA ADD HL,BC       ; Add the x velocity.
 $B5FB DEC A           ; {Jump to #R$B5FF if the x velocity is negative.
 $B5FC JR Z,$B5FF      ; }
 $B5FE CCF             ; Invert the carry flag.
@label=Move_Thrown_Weapon_Check_Wrap
*$B5FF JP NC,$B6E3     ; Jump to #R$B6E3 if the x position has wrapped round.
 $B602 LD (IX+$0A),L   ; Store the new fraction of the x position.
 $B605 LD A,H          ; Fetch the new x position.
 $B606 BIT 7,A         ; {Jump to #R$B658 if the x position is less than #N$80.
 $B608 JP Z,$B658      ; }
 $B60B CP $D8          ; {Jump to #R$B61B if the x position is less than #N$D8.
 $B60D JR C,$B61B      ; }
 $B60F BIT 2,E         ; {Jump to #R$B676 if the room has no right wall.
 $B611 JP Z,$B676      ; }
 $B614 LD (IX+$01),$D7 ; Set the x position to #N$D7.
 $B618 JP $DEDA        ; Jump to #R$DEDA, so that the object bursts into dust against the
                       ; wall.
@label=Move_Thrown_Weapon_Store_X
*$B61B LD (IX+$01),A   ; Store the x position.
; Do the same with the y velocity and the y position.
 $B61E LD L,(IX+$09)   ; Fetch the y velocity into #REGl.
 $B621 BIT 7,L         ; Test the sign of the y velocity.
 $B623 LD H,$00        ; Clear the high byte of the y velocity (as a word).
 $B625 JR Z,$B629      ; Jump to #R$B629 if the y velocity is positive.
 $B627 LD H,$FF        ; Set the high byte of the y velocity to #N$FF to extend
                       ; the sign.
@label=Move_Thrown_Weapon_Add_Y_Velocity
*$B629 ADD HL,HL       ; {Multiply the y velocity by sixteen.
 $B62A ADD HL,HL       ;
 $B62B ADD HL,HL       ;
 $B62C ADD HL,HL       ; }
 $B62D LD C,(IX+$0D)   ; Fetch the fraction of the y position.
 $B630 LD B,(IX+$03)   ; Fetch the y position.
 $B633 ADD HL,BC       ; Add the y velocity.
 $B634 LD (IX+$0D),L   ; Store the new fraction of the y position.
 $B637 LD A,H          ; Fetch the new y position.
 $B638 BIT 7,A         ; {Jump to #R$B695 if the y position is less than #N$80.
 $B63A JP Z,$B695      ; }
 $B63D CP $9F          ; {Jump to #R$B652 if the y position is less than #N$9F.
 $B63F JR C,$B652      ; }
 $B641 BIT 4,E         ; {Jump to #R$B6B8 if the room has no floor.
 $B643 JP Z,$B6B8      ; }
 $B646 LD A,(IX+$09)   ; Fetch the y velocity.
 $B649 CPL             ; Invert it, to bounce off the floor.
 $B64A LD (IX+$09),A   ; Store the y velocity.
 $B64D CALL $DEB8      ; Make a puff of dust.
 $B650 LD A,$9F        ; Set the y position to #N$9F.
@label=Move_Thrown_Weapon_Store_Y
*$B652 LD (IX+$03),A   ; Store the y position.
 $B655 JP $96CB        ; Jump to #R$96CB.
@label=Move_Thrown_Weapon_Test_Left_Edge
*$B658 CP $18          ; {Jump to #R$B61B if the x position is #N$18 or more.
 $B65A JP NC,$B61B     ; }
 $B65D BIT 6,E         ; {Jump to #R$B668 if the room has no left wall.
 $B65F JR Z,$B668      ; }
 $B661 LD (IX+$01),$18 ; Set the x position to #N$18.
 $B665 JP $DEDA        ; Jump to #R$DEDA, so that the object bursts into dust against the
                       ; wall.
@label=Move_Thrown_Weapon_Test_Left_Gap
*$B668 CP $08          ; {Jump to #R$B684 if the x position is #N$08 or more.
 $B66A JR NC,$B684     ; }
 $B66C BIT 0,(IX+$0F)  ; {Jump to #R$B6E3 if the object has not been drawn yet,
 $B670 JP NZ,$B6E3     ; to remove it.}
 $B673 JP $B6D3        ; Remove the object and erase it.
@label=Move_Thrown_Weapon_Test_Right_Gap
*$B676 CP $F0          ; {Jump to #R$B684 if the x position is less than #N$F0.
 $B678 JR C,$B684      ; }
 $B67A BIT 0,(IX+$0F)  ; {Jump to #R$B6E3 if the object has not been drawn yet,
 $B67E JP NZ,$B6E3     ; to remove it.}
 $B681 JP $B6D3        ; Remove the object and erase it.
@label=Move_Thrown_Weapon_Set_Gap_Flags
*$B684 EX AF,AF'       ; Save the x position in #REGaf'.
 $B685 LD A,(IX+$0B)   ; Fetch the contact flags.
 $B688 OR %00010001    ; Set bits 0 and 4, which makes the ceiling and the floor seem to
                       ; be present.
 $B68A LD (IX+$0B),A   ; Store the contact flags.
 $B68D LD A,E          ; Copy the flags of the room to #REGa.
 $B68E OR %00010001    ; Set bits 0 and 4 too.
 $B690 LD E,A          ; Store them in #REGe.
 $B691 EX AF,AF'       ; Restore the x position from #REGaf'.
 $B692 JP $B61B        ; Jump to #R$B61B.
@label=Move_Thrown_Weapon_Test_Top_Edge
*$B695 CP $40          ; {Jump to #R$B652 if the y position is #N$40 or more.
 $B697 JR NC,$B652     ; }
 $B699 BIT 0,E         ; {Jump to #R$B6AA if the room has no ceiling.
 $B69B JP Z,$B6AA      ; }
 $B69E LD A,(IX+$09)   ; Fetch the y velocity.
 $B6A1 CPL             ; Invert it, to bounce off the ceiling.
 $B6A2 LD (IX+$09),A   ; Store the y velocity.
 $B6A5 LD A,$40        ; Set the y position to #N$40.
 $B6A7 JP $B652        ; Jump to #R$B652.
@label=Move_Thrown_Weapon_Test_Top_Gap
*$B6AA CP $20          ; {Jump to #R$B6C6 if the y position is #N$20 or more.
 $B6AC JR NC,$B6C6     ; }
 $B6AE BIT 0,(IX+$0F)  ; {Jump to #R$B6E3 if the object has not been drawn yet,
 $B6B2 JP NZ,$B6E3     ; to remove it.}
 $B6B5 JP $B6D3        ; Remove the object and erase it.
@label=Move_Thrown_Weapon_Test_Bottom_Gap
*$B6B8 CP $BF          ; {Jump to #R$B6C6 if the y position is less than #N$BF.
 $B6BA JR C,$B6C6      ; }
 $B6BC BIT 0,(IX+$0F)  ; {Jump to #R$B6E3 if the object has not been drawn yet,
 $B6C0 JP NZ,$B6E3     ; to remove it.}
 $B6C3 JP $B6D3        ; Remove the object and erase it.
@label=Move_Thrown_Weapon_Set_Vertical_Gap_Flags
*$B6C6 EX AF,AF'       ; Save the y position in #REGaf'.
 $B6C7 LD A,(IX+$0B)   ; Fetch the contact flags.
 $B6CA OR %01000100    ; Set bits 2 and 6, which makes the side walls seem to be
                       ; present.
 $B6CC LD (IX+$0B),A   ; Store the contact flags.
 $B6CF EX AF,AF'       ; Restore the y position from #REGaf'.
 $B6D0 JP $B652        ; Jump to #R$B652.

; Remove Thrown Weapon
;
; Used by the routines at #R$B58C, #R$DEE8, #R$DF15 and #R$E18C.
; .
; Removes a weapon (or other object) that has been drawn, by emptying its
; record and erasing its sprite. If it has not been drawn there is nothing to
; erase.
;
; IX Object record
@label=Remove_Thrown_Weapon
c$B6D3 LD (IX+$00),$00 ; Empty the record by setting the type to zero.
 $B6D7 LD (IX+$07),$00 ; Clear byte #N$07.
 $B6DB BIT 0,(IX+$0F)  ; {Return if the object has not been drawn yet.
 $B6DF RET NZ          ; }
 $B6E0 JP $9636        ; Erase the sprite of the object.

; Remove Unseen Weapon
;
; Used by the routines at #R$B58C, #R$DEE8, #R$DF15, #R$DF98, #R$E027, #R$E0E8,
; #R$E117 and #R$E18C.
; .
; Removes an object that does not have to be erased from the screen, by
; emptying its record.
;
; IX Object record
@label=Remove_Unseen_Weapon
c$B6E3 LD (IX+$00),$00 ; Empty the record by setting the type to zero.
 $B6E7 RET             ; Return.

; Check Weapon Hit
;
; Used by the routines at #R$B079 and #R$ECCA.
; .
; Checks whether either of the two weapon records is touching an object.
; .
; See #R$B6F4 for the details.
;
;   IX Object record
; O:D #N$FF if a weapon has hit the object, otherwise #N$00
; O:E Type of the weapon that has hit the object
@label=Check_Weapon_Hit
c$B6E8 LD HL,$8EFA   ; Point #REGhl at the first weapon record.
 $B6EB CALL $B6F4    ; Check whether the weapon hits the object.
 $B6EE LD A,D        ; {Return if it does.
 $B6EF AND A         ;
 $B6F0 RET NZ        ; }
 $B6F1 LD HL,$8F0A   ; Point #REGhl at #R$8F0A.

; Check Weapon Record Hit
;
; Used by the routine at #R$B6E8.
; .
; Checks whether a weapon is touching an object. The weapon hits the
; object if it is in the same room, less than #N$10 pixels away horizontally and
; less than #N$10 pixels away vertically (allowing #N$04 pixels for the
; difference in their sizes). When it hits, bit 0 of byte #N$07 of the weapon is
; set, which makes #R$B58C remove the weapon.
;
;   HL Weapon record
;   IX Object record
; O:D #N$FF if the weapon hits the object, otherwise #N$00
; O:E Type of the weapon
@label=Check_Weapon_Record_Hit
c$B6F4 LD D,$00      ; Clear the hit flag in #REGd.
 $B6F6 LD A,(HL)     ; Fetch the type of the weapon.
 $B6F7 AND A         ; {Copy it to #REGe, testing it for zero.
 $B6F8 LD E,A        ; }
 $B6F9 RET Z         ; Return if the record is empty.
 $B6FA INC HL        ; Move to the x position of the weapon.
 $B6FB LD A,(HL)     ; Fetch the x position of the weapon.
 $B6FC SUB (IX+$01)  ; Subtract the x position of the object.
 $B6FF ADD A,$04     ; Add #N$04.
 $B701 JP P,$B706    ; Jump to #R$B706 if the result is positive.
 $B704 NEG           ; Make the result positive.
@label=Check_Weapon_Record_Hit_Test_X
*$B706 CP $10        ; {Return if they are #N$10 or more pixels apart
 $B708 RET NC        ; horizontally.}
 $B709 INC HL        ; Move to the room x of the weapon.
 $B70A LD A,(HL)     ; Fetch the room x of the weapon.
 $B70B CP (IX+$02)   ; {Return if it is not the room x of the object.
 $B70E RET NZ        ; }
 $B70F INC HL        ; Move to the y position of the weapon.
 $B710 LD A,(HL)     ; Fetch the y position of the weapon.
 $B711 SUB (IX+$03)  ; Subtract the y position of the object.
 $B714 ADD A,$04     ; Add #N$04.
 $B716 JP P,$B71B    ; Jump to #R$B71B if the result is positive.
 $B719 NEG           ; Make the result positive.
@label=Check_Weapon_Record_Hit_Test_Y
*$B71B CP $10        ; {Return if they are #N$10 or more pixels apart
 $B71D RET NC        ; vertically.}
 $B71E INC HL        ; Move to the room y of the weapon.
 $B71F LD A,(HL)     ; Fetch the room y of the weapon.
 $B720 CP (IX+$04)   ; {Return if it is not the room y of the object.
 $B723 RET NZ        ; }
 $B724 LD D,$FF      ; Flag a hit by setting #REGd to #N$FF.
 $B726 INC HL        ; {Move to byte #N$07.
 $B727 INC HL        ;
 $B728 INC HL        ; }
 $B729 LD (HL),$01   ; Set bit 0 of byte #N$07, so that the weapon will be
                     ; removed.
 $B72B RET           ; Return.

; Start Being Carried
;
; Used by the routines at #R$A433, #R$A5F1, #R$A6A6 and #R$A925.
; .
; Starts the part of the game in which an eagle carries Sabreman. The
; handler of Sabreman jumps here when bit 6 of his redraw flags has been set by
; the eagle (see #R$B079). The bits 5 and 6 of the redraw flags and the contact
; flags are cleared, the type becomes #N$60 and the routine carries on with the
; handler for that type at #R$E582.
;
; IX Object record of Sabreman
@label=Start_Being_Carried
c$B72C RES 6,(IX+$0F)  ; Reset bit 6 of the redraw flags.
 $B730 RES 5,(IX+$0F)  ; Reset bit 5 of the redraw flags.
 $B734 LD (IX+$0B),$00 ; Clear the contact flags.
 $B738 LD (IX+$00),$60 ; Set the type to #N$60.
 $B73C JP $E582        ; Jump to #R$E582.

; Choose Eagle Target
;
; Used by the routines at #R$E2CB, #R$E45F and #R$E496.
; .
; Chooses the point that an eagle flies towards while it carries Sabreman
; (see #R$E2CB). The x position (byte #N$0C) is a random number from #N$40 to
; #N$BF, from the frame counter. The y position (byte #N$0E) is a random number
; from #N$4C to #N$6B, from the refresh register.
;
; IX Object record of the eagle
@label=Choose_Eagle_Target
c$B73F LD A,($5C78)  ; Fetch the low byte of the frame counter.
 $B742 AND %01111111 ; Keep only the low seven bits.
 $B744 ADD A,$40     ; Add #N$40.
 $B746 LD (IX+$0C),A ; Store the target x position.
 $B749 LD A,R        ; Fetch a random number from the refresh register.
 $B74B AND %00011111 ; Keep only the low five bits.
 $B74D ADD A,$4C     ; Add #N$4C.
 $B74F LD (IX+$0E),A ; Store the target y position.
 $B752 RET           ; Return.

; Weapon Projectile Types
;
; The type of the projectile that #R$B4D1 makes for each of the four kinds
; of weapon that Sabreman can carry (the types #N$68 to #N$6B). A weapon that is
; thrown to the left has a type that is one more.
@label=Weapon_Projectile_Types
b$B753 DEFB $38      ; Weapon #N$68 gives type #N$38 (see #R$B57A).
 $B754 DEFB $6E      ; Weapon #N$69 gives type #N$6E (see #R$EA9C).
 $B755 DEFB $70      ; Weapon #N$6A gives type #N$70 (see #R$EA7D).
 $B756 DEFB $6C      ; Weapon #N$6B gives type #N$6C (see #R$EA9C).

; Room Object X Positions
;
; The x positions of the plant and the rock that #R$AF56 puts in a room
; that has both a ceiling and a floor. The offset into the table is the sum of
; the room x and the room y, modulo #N$10. The plant gets the byte at that
; offset and the rock gets the byte after it.
@label=Room_Object_X_Positions
b$B757 DEFB $80,$98,$68,$30
 $B75B DEFB $B0,$98,$50,$68
 $B75F DEFB $B0,$80,$38,$98
 $B763 DEFB $50,$68,$C8,$80
 $B767 DEFB $98,$68,$C8,$30

; Rock Templates
;
; The object records of the four rocks (the types #N$2C to #N$2F). #R$AF56
; copies one of them, chosen by the room x, into a decoration record, and then
; writes the x position that it takes from the table at #R$B757. The y position
; #N$A0 is the floor. Bytes #N$0A to #N$0E give the size of the rock as an
; obstacle, so that creatures and weapons bounce off it: its half width, the
; width of its middle, its height, its depth and the x offset of its middle (see
; #R$B46A). Bit 0 of the redraw flags is set so that the rock is drawn without
; being erased first.
;
; .
;
; Rock of type #N$2C.
@label=Rock_Templates
b$B76B DEFB $2C             ; {Type, x, room x, y, room y and attribute
 $B76C DEFB $80             ; (yellow).
 $B76D DEFB $00             ;
 $B76E DEFB $A0             ;
 $B76F DEFB $00             ;
 $B770 DEFB $46             ; }
 $B771 DEFB $00,$00,$00,$00 ; Not used.
 $B775 DEFB $14             ; {Size of the obstacle (see #R$B46A).
 $B776 DEFB $08             ;
 $B777 DEFB $22             ;
 $B778 DEFB $1B             ;
 $B779 DEFB $04             ; }
 $B77A DEFB $01             ; Redraw flags (bit 0 is set).
; Rock of type #N$2D.
 $B77B DEFB $2D             ; {Type, x, room x, y, room y and attribute
 $B77C DEFB $80             ; (yellow).
 $B77D DEFB $00             ;
 $B77E DEFB $A0             ;
 $B77F DEFB $00             ;
 $B780 DEFB $46             ; }
