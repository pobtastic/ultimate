 $8F3F DEFB $00,$00,$00,$00                                                 ; Bytes
                                                                            ; #N$05 to
                                                                            ; #N$08.
@label=Falling_Stalactite_Y_Velocity
 $8F43 DEFB $00                                                             ; The y
                                                                            ; velocity
                                                                            ; of the
                                                                            ; stalactite.
 $8F44 DEFB $00,$00,$00,$00,$00                                             ; Bytes
                                                                            ; #N$0A to
                                                                            ; #N$0E.
@label=Falling_Stalactite_Redraw_Flags
 $8F49 DEFB $00                                                             ; The redraw
                                                                            ; flags of
                                                                            ; the
                                                                            ; stalactite.
@label=Dust_Record
 $8F4A DEFB $00,$00,$00,$00,$00,$00,$00,$00                                 ; Record 5:
                                                                            ; the puff
                                                                            ; of dust.
@label=Dust_Counter
 $8F52 DEFB $00                                                             ; The
                                                                            ; counter of
                                                                            ; the puff
                                                                            ; of dust.
 $8F53 DEFB $00,$00,$00,$00,$00,$00                                         ; Bytes
                                                                            ; #N$09 to
                                                                            ; #N$0E.
@label=Dust_Redraw_Flags
 $8F59 DEFB $00                                                             ; The redraw
                                                                            ; flags of
                                                                            ; the puff
                                                                            ; of dust.
@label=First_Bubble_Record
 $8F5A DEFB $00,$00,$00                                                     ; Records 6
                                                                            ; to 9: the
                                                                            ; four
                                                                            ; bubbles.
                                                                            ; This is
                                                                            ; the first.
@label=First_Bubble_Y_Position
 $8F5D DEFB $00                                                             ; The y
                                                                            ; position
                                                                            ; of the
                                                                            ; first
                                                                            ; bubble.
 $8F5E DEFB $00                                                             ; The room y
                                                                            ; of the
                                                                            ; first
                                                                            ; bubble.
@label=First_Bubble_Attribute
 $8F5F DEFB $00                                                             ; The
                                                                            ; attribute
                                                                            ; of the
