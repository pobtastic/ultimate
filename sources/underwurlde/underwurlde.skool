                                                                            ; of record
                                                                            ; #N$08.
 $8F7E DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00                     ; Bytes
                                                                            ; #N$04 to
                                                                            ; #N$0E.
@label=Object_Record_8_Redraw_Flags
 $8F89 DEFB $00                                                             ; The redraw
                                                                            ; flags of
                                                                            ; record
                                                                            ; #N$08.
@label=Object_Record_9
 $8F8A DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00 ; Record 9:
                                                                            ; the fourth
                                                                            ; bubble, or
                                                                            ; the second
                                                                            ; decoration.
@label=Object_Record_10
 $8F9A DEFB $00                                                             ; Record 10:
                                                                            ; the third
                                                                            ; decoration.
@label=Object_Record_10_X_Position
 $8F9B DEFB $00                                                             ; The x
                                                                            ; position
                                                                            ; of record
                                                                            ; #N$0A.
 $8F9C DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00             ; Bytes
                                                                            ; #N$02 to
                                                                            ; #N$0E.
@label=Object_Record_10_Redraw_Flags
 $8FA9 DEFB $00                                                             ; The redraw
                                                                            ; flags of
                                                                            ; record
                                                                            ; #N$0A.
@label=Object_Record_11
