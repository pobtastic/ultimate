 $9372 DEFW $CDFF,$CE58,$CC89,$CCE5,$CF78,$CFDA,$CEB4,$CF16 ; Sprites #N$20 to
                                                            ; #N$27.
 $9382 DEFW $CC89,$CCE5,$CD44,$CDA0,$D03F,$D0A1,$D103,$D14D ; Sprites #N$28 to
                                                            ; #N$2F.
 $9392 DEFW $D26C,$D2A1,$D1ED,$D222,$D2EB,$D33B,$D38B,$D33B ; Sprites #N$30 to
                                                            ; #N$37.
 $93A2 DEFW $D18D,$D1A5,$D1BD,$D1D5,$D9EF,$DA81,$DCBF,$DC96 ; Sprites #N$38 to
                                                            ; #N$3F.
 $93B2 DEFW $D619,$D65A,$D597,$D5D8,$D3DB,$D425,$D46F,$D425 ; Sprites #N$40 to
                                                            ; #N$47.
 $93C2 DEFW $D7B1,$D7CD,$D7ED,$D7FD,$D69B,$D6D9,$D71D,$D767 ; Sprites #N$48 to
                                                            ; #N$4F.
 $93D2 DEFW $D815,$D857,$D88D,$D8B3,$DB75,$D8CB,$D95D,$DB13 ; Sprites #N$50 to
                                                            ; #N$57.
 $93E2 DEFW $DB9F,$DBC1,$DBE5,$DBC1,$D26C,$D2A1,$D1ED,$D222 ; Sprites #N$58 to
                                                            ; #N$5F.
 $93F2 DEFW $C6A7,$C6D9,$C4F7,$C529,$DCE8,$DD02,$DD20,$DD42 ; Sprites #N$60 to
                                                            ; #N$67.
 $9402 DEFW $DDA8,$DDDA,$DE3E,$DE0C,$DE70,$DE82,$DE94,$DEA6 ; Sprites #N$68 to
                                                            ; #N$6F.
 $9412 DEFW $DD64,$DD86,$87F7,$8819,$889D,$883B,$8B4F,$899D ; Sprites #N$70 to
                                                            ; #N$77.
 $9422 DEFW $893B,$8CEB,$8C69,$8765,$871B,$86B9,$8667,$A1A3 ; Sprites #N$78 to
                                                            ; #N$7F.
 $9432 DEFW $A1B5,$A20E,$D4B9,$D503,$A1B5,$A20E,$A267,$A2C6 ; Sprites #N$80 to
                                                            ; #N$87.
 $9442 DEFW $D815,$C3DB,$C3DB,$C3DB,$8E3D,$8D8D,$8DEB,$8E7F ; Sprites #N$88 to
                                                            ; #N$8F.
 $9452 DEFW $A181                                           ; Sprites #N$90.

; Pause Briefly
;
; Used by the routine at #R$9459.
; .
; A short delay loop. It is the handler of type #N$00, the type of an
; empty object record, so a record that is not in use costs a little time
; instead of none. It is also used to debounce the pause key.
@label=Pause_Briefly
c$9454 XOR A         ; Start the delay counter at #N$00, which makes #N$0100 passes round
                     ; the loop.
@label=Pause_Briefly_Loop
*$9455 DEC A         ; {Decrease the delay counter and loop back until it is
 $9456 JR NZ,$9455   ; zero.}
 $9458 RET           ; Return.

; Finish Object Pass
;
; The return address of every object handler.
; .
; It moves #REGix on to the next object record. If the frame counter has changed
; since the last time (that is, an interrupt has happened) the priority records
; are handled first: the two projectile records and, while Sabreman's type is
; from #N$09 to #N$1B, Sabreman himself.
; .
; When all of the object records have been handled it adds one to the tick
; counter, counts down the gem timer, checks for the pause key and for a new
; press of an action key, runs the handlers of the small object records and then
; starts the main loop again.
;
; .
;
; Move on to the next object record and see if the frame counter has
; changed.
@label=Finish_Object_Pass
c$9459 LD DE,$0010   ; Set the size of an object record to #N$10.
 $945C ADD IX,DE     ; Move #REGix on to the next object record.
 $945E PUSH IX       ; Stash the pointer to the next record on the stack.
 $9460 LD HL,($5C78) ; Fetch the frame counter (the low word of FRAMES) from
                     ; #N$5C78.
 $9463 LD DE,($8EDF) ; Fetch the last frame counter from #R$8EDF.
 $9467 LD ($8EDF),HL ; Store the new frame counter in #R$8EDF.
 $946A AND A         ; {Subtract the last frame counter from the new one.
 $946B SBC HL,DE     ; }
 $946D JP NZ,$951D   ; Jump to #R$951D if the frame counter has changed.
; If there are more object records, run the handler of the next one.
@label=Finish_Object_Pass_Next_Record
*$9470 POP HL        ; Restore the pointer to the next record into #REGhl.
 $9471 LD DE,$902A   ; Point at the end of the object records (#R$902A).
 $9474 AND A         ; {Subtract the end of the records from the pointer.
 $9475 SBC HL,DE     ; }
 $9477 JP C,$9207    ; Jump to #R$9207 if there are more records to handle.
; All of the records have been handled, so count a tick.
 $947A LD HL,($8ED6) ; Fetch the tick counter from #R$8ED6.
 $947D INC HL        ; Add one to the tick counter.
 $947E LD ($8ED6),HL ; Store the tick counter.
 $9481 LD A,($8EF1)  ; Fetch the byte at #R$8EF1.
 $9484 LD ($8EF2),A  ; Store it in #R$8EF2.
 $9487 XOR A         ; {Write #N$00 to #R$8EF1.
 $9488 LD ($8EF1),A  ; }
 $948B LD A,($8ED6)  ; Fetch the low byte of the tick counter.
 $948E AND %00000011 ; Keep only bits 0 and 1.
 $9490 JR NZ,$94A9   ; Jump to #R$94A9 if the tick counter is not a multiple of
                     ; four.
; Every fourth tick the gem timer counts down.
 $9492 LD A,($8EEE)  ; Fetch the gem timer from #R$8EEE.
 $9495 AND A         ; {Jump to #R$94A9 if the gem timer is zero.
 $9496 JR Z,$94A9    ; }
 $9498 DEC A         ; {Count down the gem timer, keeping it as a BCD value.
 $9499 DAA           ; }
 $949A LD ($8EEE),A  ; Store the gem timer.
 $949D PUSH AF       ; Stash the timer flags on the stack.
 $949E CALL $9E27    ; Print the gem timer.
 $94A1 POP AF        ; Restore the timer flags.
 $94A2 JR NZ,$94A9   ; Jump to #R$94A9 if the gem timer has not run out.
 $94A4 LD A,$47      ; {Make Sabreman bright white again.
 $94A6 LD ($8F1F),A  ; }
; Check for the ENTER key which pauses the game.
@label=Finish_Object_Pass_Check_Pause
*$94A9 LD A,$BF      ; {Read from the keyboard;
 $94AB OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $94AD IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$BF | ENTER | L | K | J | H }
                     ; TABLE#}
 $94AF AND %00000001 ; Keep only the bit for ENTER.
 $94B1 JR NZ,$94DC   ; Jump to #R$94DC if ENTER is not pressed.
 $94B3 DI            ; Disable interrupts.
; Wait for ENTER to be released.
@label=Finish_Object_Pass_Wait_For_Release
*$94B4 LD A,$BF      ; {Read from the keyboard;
 $94B6 OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $94B8 CALL $9454    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$BF | ENTER | L | K | J | H }
                     ; TABLE#}
 $94BB IN A,($FE)    ; Read from port #N$FE.
 $94BD AND %00000001 ; Keep only the bit for ENTER.
 $94BF JR Z,$94B4    ; Jump to #R$94B4 if ENTER is still pressed.
; The game is paused. Wait for ENTER to be pressed again.
@label=Finish_Object_Pass_Wait_For_Resume
*$94C1 LD A,$BF      ; {Read from the keyboard;
 $94C3 OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $94C5 CALL $9454    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$BF | ENTER | L | K | J | H }
                     ; TABLE#}
 $94C8 IN A,($FE)    ; Read from port #N$FE.
 $94CA AND %00000001 ; Keep only the bit for ENTER.
 $94CC JR NZ,$94C1   ; Jump to #R$94C1 if ENTER is not pressed.
; Wait for ENTER to be released and carry on with the game.
@label=Finish_Object_Pass_Wait_For_Final_Release
*$94CE LD A,$BF      ; {Read from the keyboard;
 $94D0 OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $94D2 CALL $9454    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$BF | ENTER | L | K | J | H }
                     ; TABLE#}
 $94D5 IN A,($FE)    ; Read from port #N$FE.
 $94D7 AND %00000001 ; Keep only the bit for ENTER.
 $94D9 JR Z,$94CE    ; Jump to #R$94CE if ENTER is still pressed.
 $94DB EI            ; Enable interrupts.
; Check for the keys that pick up, drop or throw weapons (SPACE, SYMBOL
; SHIFT, M, N and B). A new press is recorded in #R$8EEA and a held key in
; #R$8EE9.
@label=Finish_Object_Pass_Check_Action_Keys
*$94DC LD A,($8EF0)  ; Fetch the room redrawn flag from #R$8EF0.
 $94DF AND A         ; {Jump to #R$950C if the room has just been redrawn.
 $94E0 JR NZ,$950C   ; }
 $94E2 LD A,$7F      ; {Read from the keyboard;
 $94E4 OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $94E6 IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$7F | SPACE | SYMBOL SHIFT | M | N | B }
                     ; TABLE#}
 $94E8 CPL           ; Flip the bits so that a pressed key gives a set bit.
 $94E9 AND %00011111 ; Keep only the bits of the five keys.
 $94EB JR NZ,$94F5   ; Jump to #R$94F5 if one of the keys is pressed.
@label=Finish_Object_Pass_Store_Key_Flags
*$94ED LD ($8EE9),A  ; Store the key held flag in #R$8EE9.
 $94F0 LD ($8EEA),A  ; Store the new key press flag in #R$8EEA.
 $94F3 JR $950C      ; Jump to #R$950C.
@label=Finish_Object_Pass_Key_Is_Pressed
*$94F5 LD A,($8EE9)  ; Fetch the key held flag from #R$8EE9.
 $94F8 AND A         ; {Jump to #R$9508 if the key was already pressed.
 $94F9 JR NZ,$9508   ; }
; This is a new press, so empty the table of the weapons that Sabreman
; holds; the handlers of the weapons fill it in again.
 $94FB XOR A         ; {Empty the three slots of the weapons table at #R$8EEB.
 $94FC LD H,A        ;
 $94FD LD L,A        ;
 $94FE LD ($8EEB),A  ;
 $9501 LD ($8EEC),HL ; }
 $9504 LD A,$FF      ; {Jump to #R$94ED with #N$FF to set the key held and new key press
 $9506 JR $94ED      ; flags.}
@label=Finish_Object_Pass_Key_Is_Held
*$9508 XOR A         ; {The key is only being held, so clear the new key press flag in
 $9509 LD ($8EEA),A  ; #R$8EEA.}
; Run the handlers of the small object records.
@label=Handle_Small_Objects
*$950C LD IX,$902A   ; Point at the first small object record (#R$902A).
@label=Finish_Object_Pass_Small_Object_Loop
*$9510 LD HL,$954C   ; Point at the return address of the handler (#R$954C).
 $9513 PUSH HL       ; Stash it on the stack.
 $9514 LD L,(IX+$00) ; Fetch the type of the object.
 $9517 LD BC,$921A   ; Point at the handler table (#R$921A).
 $951A JP $9211      ; Jump to #R$9211 to run the handler.
; The frame counter has changed, so handle the priority records: the first
; two object records (the projectiles) and, when Sabreman's type is from #N$09
; to #N$1B, Sabreman's record too.
@label=Finish_Object_Pass_Priority_Records
*$951D LD IX,$8EFA   ; Point at the first object record (#R$8EFA).
@label=Finish_Object_Pass_Priority_Loop
*$9521 LD HL,$9527   ; Point at the return address of the handler (#R$9527).
 $9524 JP $920A      ; Jump to #R$920A to run the handler.
@label=Finish_Object_Pass_Priority_Return
 $9527 LD DE,$0010   ; Set the size of an object record to #N$10.
 $952A ADD IX,DE     ; Move #REGix on to the next object record.
 $952C LD DE,$8F1A   ; Point at the record of Sabreman (#R$8F1A).
 $952F LD A,($8F1A)  ; Fetch the type of Sabreman.
 $9532 CP $1C        ; {Jump to #R$953D if the type is greater than or equal to
 $9534 JR NC,$953D   ; #N$1C.}
 $9536 CP $09        ; {Jump to #R$953D if the type is less than #N$09.
 $9538 JR C,$953D    ; }
 $953A LD DE,$8F2A   ; Point at the record after Sabreman's (#R$8F2A).
@label=Finish_Object_Pass_Priority_Limit
*$953D PUSH IX       ; {Copy #REGix to #REGhl (using the stack).
 $953F POP HL        ; }
 $9540 AND A         ; {Subtract the limit from the pointer.
 $9541 SBC HL,DE     ; }
 $9543 JR C,$9521    ; Jump to #R$9521 if there are more priority records to
                     ; handle.
 $9545 POP IX        ; Restore #REGix to the pointer to the next record.
 $9547 PUSH IX       ; Stash it on the stack again.
 $9549 JP $9470      ; Jump to #R$9470 to carry on with the normal pass.
; Return address of the handlers of the small object records.
@label=Finish_Object_Pass_Small_Object_Return
 $954C LD DE,$0008   ; Set the size of a small object record to #N$08.
 $954F ADD IX,DE     ; Move #REGix on to the next small object record.
 $9551 PUSH IX       ; {Copy #REGix to #REGhl (using the stack).
 $9553 POP HL        ; }
 $9554 LD DE,$9052   ; Point at the end of the small object records (#R$9052).
 $9557 AND A         ; {Subtract the end of the records from the pointer.
 $9558 SBC HL,DE     ; }
 $955A JR C,$9510    ; Jump to #R$9510 if there are more small object records to
                     ; handle.
 $955C XOR A         ; {Write #N$00 to #R$8EF0 to clear the room redrawn flag.
 $955D LD ($8EF0),A  ; }
 $9560 JP $91E5      ; Jump back to the main loop.

; Clear Workspace
;
; Used by the routine at #R$91C0.
; .
; Sets up the registers to clear the #N$19 bytes of the sprite drawing
; workspace and the other variables from #R$8EE1 to #R$8EF9 (which includes the
; score and the completion percentage).
@label=Clear_Workspace
c$9563 LD BC,$0019   ; Set the number of bytes of the workspace to clear to
                     ; #N$0019.
 $9566 LD HL,$8EE1   ; Point at the start of the workspace (#R$8EE1).
; Continue on to #R$9569.

; Fill Memory
;
; Used by the routines at #R$9052 and #R$957D.
; .
; Fills an area of memory with
; zero. The entry point at #R$956B fills
; it with the byte in #REGe.
;
; BC Number of bytes
; HL Address of the first byte
@label=FillMemory
c$9569 LD E,$00      ; Set the value to write to #N$00.
; This entry point is used by the routine at #R$9573.
@label=FillMemory_WithValue
*$956B LD (HL),E     ; Write the value to the address.
 $956C INC HL        ; Move on to the next address.
; Decrease the byte counter and loop back to #R$956B until all of the
; bytes have been written.
 $956D DEC BC        ; Decrement the byte counter.
 $956E LD A,B        ; {Jump back to #R$956B until all of the bytes have been
 $956F OR C          ; written.
 $9570 JR NZ,$956B   ; }
 $9572 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CE56 }
; { #GUNFRIGHT$D6E1 }
; { #KNIGHTLORE$D53A }
; { #MARTIANOIDS$B1A3 }
; { #NIGHTSHADE$E5BA }
; { #PENTAGRAM$CB77 }
; LIST#

; Clear Attributes
;
; Used by the routine at #R$91C0.
; .
; Sets the whole of the attribute buffer to white ink on black paper.
@label=Clear_Attributes
c$9573 LD HL,$5800   ; Point at the start of the attribute buffer (#N$5800).
 $9576 LD BC,$0300   ; Set the size of the attribute buffer (#N$0300 bytes).
 $9579 LD E,$47      ; Use bright white ink on black paper (#N$47) as the attribute to
                     ; write.
 $957B JR $956B      ; Jump to #R$956B to fill the attribute buffer.

; Clear Screen
;
; Used by the routines at #R$9052, #R$91C0 and #R$95DE.
; .
; Sets the attributes of the play area to white ink on black paper and
; then clears the pixels of the whole screen.
; .
; #PUSHS #UDGTABLE(default,centre)
; { =h Before | =h After #R$957D }
; { #SIM(start=$9052,stop=$9078,clear=1,sp=$5B40)
; #SIM(start=$91C0,stop=$91E5,sp=$5B40)
; #SCR$01(clear-screen-before)
; | #SIM(start=$957D,stop=$0000,sp=$5B40)
; #SCR$01(clear-screen-after) } UDGTABLE# #POPS
@label=Clear_Screen
c$957D CALL $99C2    ; Set the attributes of the play area.
 $9580 LD HL,$4000   ; Point at the start of the display file (#N$4000).
 $9583 LD BC,$1800   ; Set the size of the display file (#N$1800 bytes).
 $9586 JR $9569      ; Jump to #R$9569 to clear the display file.

; Reset World Map
;
; Used by the routine at #R$9052.
; .
; Writes #N$00 to the second byte of each of the first #N$0240 entries of
; the #R$7000 world map. The second byte of an entry holds the data of a rope
; (see #R$AE81), which changes during the game.
; .
; The counters are set up so that the loop runs #N$40 times on the first pass
; and #N$0100 times on each of the next two passes. The last #N$0100 entries of
; the map (the last sixteen rows of rooms) are not reset.
@label=Reset_World_Map
c$9588 LD HL,$7680   ; Point at the end of the world map (#R$7680).
 $958B LD DE,$7000   ; Point at the start of the world map (#R$7000).
 $958E AND A         ; {Subtract the start from the end of the map to get the size of the
 $958F SBC HL,DE     ; map in bytes.}
 $9591 EX DE,HL      ; Exchange the registers so that #REGde holds the size and #REGhl the
                     ; address.
 $9592 INC HL        ; Move to the second byte of the first entry.
 $9593 SRL D         ; {Halve the size of the map to get the number of entries.
 $9595 RR E          ; }
 $9597 LD C,D        ; {Copy the number of entries into the loop counters (the high byte
 $9598 LD B,E        ; into #REGc and the low byte into #REGb).}
@label=Reset_World_Map_Loop
*$9599 LD (HL),$00   ; Write #N$00 to the second byte of the entry.
 $959B INC HL        ; {Move on to the second byte of the next entry.
 $959C INC HL        ; }
 $959D DJNZ $9599    ; Decrease the entry counter (low byte) and loop back until it is
                     ; zero.
 $959F DEC C         ; {Decrease the high byte of the entry counter and loop back until the
 $95A0 JR NZ,$9599   ; second byte of every entry has been cleared.}
 $95A2 RET           ; Return.

; Draw Menu Icons
;
; Used by the routine at #R$9052.
; .
; Draws the four icons (keyboard, joystick, cursor keys and Interface II)
; down the side of the game selection screen, using the object record at #R$95D8
; and the sprite ids #N$8C to #N$8F. The attributes of the icons are red,
; magenta, green and cyan, like the lines of the menu.
; .
; It only does anything the first time it is called.
; .
; #PUSHS #UDGTABLE(default,centre)
; { =h Before | =h After #R$95A3 }
; { #SIM(start=$9052,stop=$9078,clear=1,sp=$5B40)
; #SIM(start=$9078,stop=$907B,sp=$5B40)
; #SCR$02,$00,$04,$0A,$10(menu-icons-before)
; | #SIM(start=$907B,stop=$907E,sp=$5B40)
; #SCR$02,$00,$04,$0A,$10(menu-icons-after) } UDGTABLE# #POPS
@label=Draw_Menu_Icons
c$95A3 LD A,($8EF7)    ; Fetch the icons drawn flag from #R$8EF7.
 $95A6 AND A           ; {Return if the icons have already been drawn.
 $95A7 RET NZ          ; }
 $95A8 LD IX,$95D8     ; Point at the record of the menu icon (#R$95D8).
 $95AC LD (IX+$00),$8C ; Set the sprite id to #N$8C.
 $95B0 LD (IX+$05),$42 ; Set the attribute to #N$42 (red).
 $95B4 LD (IX+$03),$38 ; Set the y position to #N$38.
 $95B8 LD B,$04        ; Set the number of menu icons to draw to #N$04.
@label=Draw_Menu_Icons_Loop
*$95BA PUSH BC         ; Stash the icon counter on the stack.
 $95BB CALL $962A      ; Draw the icon.
 $95BE CALL $9867      ; Set the attributes of the icon.
 $95C1 POP BC          ; Restore the icon counter.
 $95C2 LD A,(IX+$03)   ; Fetch the y position of the icon.
 $95C5 ADD A,$18       ; Move down by #N$18 pixels.
 $95C7 LD (IX+$03),A   ; Store the new y position.
 $95CA INC (IX+$00)    ; Move on to the next sprite id.
 $95CD INC (IX+$05)    ; Move on to the next attribute.
 $95D0 DJNZ $95BA      ; Decrease the icon counter and loop back until all of the icons are
                       ; drawn.
 $95D2 LD A,$01        ; {Write #N$01 to #R$8EF7 to show that the icons have
 $95D4 LD ($8EF7),A    ; been drawn.}
 $95D7 RET             ; Return.

; Menu Icon Record
;
; The object record that #R$95A3 uses to draw each of the four menu icons.
; The sprite id, the y position and the attribute are changed for each icon.
@label=Menu_Icon_Record
b$95D8 DEFB $8C      ; Sprite id (the keyboard icon).
 $95D9 DEFB $20      ; X position.
 $95DA DEFB $00      ; Room x.
 $95DB DEFB $00      ; Y position (set by #R$95A3).
 $95DC DEFB $00      ; Room y.
 $95DD DEFB $42      ; Attribute: #COLOUR(#PEEK(#PC)).

; Show Game Over
;
; Used by the routines at #R$9EA0 and #R$E7E3.
; .
; Clears the screen, prints how much of the Underwurlde has been explored,
; prints GAME OVER, waits for key 0 (or a timeout) and then goes back to the
; game selection screen.
; .
; #PUSHS #UDGTABLE(default,centre)
; { =h Before | =h After #R$95DE }
; { #SIM(start=$9052,stop=$9078,clear=1,sp=$5B40)
; #SIM(start=$91C0,stop=$91E5,sp=$5B40)
; #SCR$01(game-over-before)
; | #SIM(start=$95DE,stop=$95ED,sp=$5B40)
; #SCR$01(game-over-after) } UDGTABLE# #POPS
@label=Show_Game_Over
c$95DE CALL $957D    ; Clear the screen.
 $95E1 CALL $9FA3    ; Print the percentage of the Underwurlde that has been
                     ; explored.
 $95E4 LD HL,$3058   ; Set the position of the text (x position #N$58, y
                     ; position #N$30).
 $95E7 LD DE,$9609   ; Point at the text GAME OVER (#R$9609).
 $95EA CALL $9C3C    ; Print the text.
 $95ED CALL $95F3    ; Wait for key 0.
 $95F0 JP $906A      ; Jump to #R$906A to go back to the selection screen.

; Wait For Key
;
; Used by the routines at #R$95DE and #R$9EA0.
; .
; Waits until key 0 is pressed. It gives up after #N$0C times #N$010000
; passes round the inner loop if no key is pressed.
@label=Wait_For_Key
c$95F3 LD B,$0C      ; Set the outer counter to #N$0C.
 $95F5 LD HL,$0000   ; Set the inner counter to #N$0000, which makes #N$010000 passes round
                     ; the inner loop.
@label=Wait_For_Key_Inner_Loop
*$95F8 DEC HL        ; Decrease the inner counter.
 $95F9 LD A,$EF      ; {Read from the keyboard;
 $95FB OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $95FD IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$EF | 0 | 9 | 8 | 7 | 6 }
                     ; TABLE#}
 $95FF AND %00000001 ; Keep only the bit for key 0.
 $9601 RET Z         ; Return if key 0 is pressed.
 $9602 LD A,H        ; {Jump back to #R$95F8 until the inner counter is zero.
 $9603 OR L          ;
 $9604 JR NZ,$95F8   ; }
 $9606 DJNZ $95F8    ; Decrease the outer counter and loop back until it is
                     ; zero.
 $9608 RET           ; Return.

; Messaging: Game Over Text
;
; The text GAME OVER, with its attribute first. The last character has bit
; 7 set.
@label=Game_Over_Text
t$9609 DEFB $45                ; Attribute: #COLOUR(#PEEK(#PC)).
 $960A DEFM "GAME OVE","R"+$80 ; "GAME OVER"

; Build Shift Table
;
; Used by the routine at #R$9052.
; .
; Builds the tables that the sprite routines use to shift a byte of sprite
; data to any pixel position.
; .
; For every byte value #REGl from #N$00 to #N$FF the table holds eight words,
; which are the byte shifted left by zero to seven bits. For a shift of n
; bits, the low byte of the word is stored at #N$FF00 less #N$0200 times n, plus
; #REGl, and the high byte is stored in the page below it. The tables use the
; pages from #N$F0 to #N$FF.
; .
; The sprite routines select a table with #REGb (which is always an even page)
; and read the high byte with #REGb and the low byte with #REGb+#N$01.
@label=BuildShiftTable
c$9613 LD L,$00      ; Start with the byte value #N$00.
@label=BuildShiftTable_Value
*$9615 LD D,$00      ; Clear the high byte of the shifted word.
 $9617 LD E,L        ; Start the low byte of the shifted word with the byte
                     ; value.
 $9618 LD H,$FF      ; Start at the page of the first low byte (#N$FF).
 $961A LD B,$08      ; Set the number of pixel offsets to build to #N$08.
@label=BuildShiftTable_Offset
*$961C LD (HL),E     ; Store the low byte of the shifted word.
 $961D DEC H         ; Move down to the page of the high byte.
 $961E LD (HL),D     ; Store the high byte of the shifted word.
 $961F DEC H         ; Move down to the page of the next low byte.
 $9620 SLA E         ; {Shift the word left by one bit.
 $9622 RL D          ; }
 $9624 DJNZ $961C    ; Decrease the shift counter and loop back until all eight shifts are
                     ; stored.
 $9626 INC L         ; Move on to the next byte value.
 $9627 JR NZ,$9615   ; Jump back to #R$9615 until all of the byte values have been
                     ; done.
 $9629 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #SABREWULF$B902 }
; LIST#

; Draw Entity
;
; Used by the routines at #R$95A3, #R$96CB, #R$A021, #R$E622 and #R$EB39.
; .
; Draws the sprite of the object that #REGix points at, using XOR. Nothing
; is erased.
; .
; The #R$9728 routine works through two sets of registers: the set that is
; current when it is entered belongs to the sprite at the old position and the
; other set belongs to the sprite at the new position. Here there is no old
; sprite, so its row count is zero.
; .
; #PUSHS #UDGTABLE(default,centre)
; { =h Before | =h After #R$962A }
; { #SIM(start=$9052,stop=$9078,clear=1,sp=$5B40)
; #SIM(start=$91C0,stop=$91E5,sp=$5B40)
; #SIM(start=$989F,stop=$0000,ix=$8F1A,sp=$5B40)
; #SIM(start=$9636,stop=$0000,ix=$8F1A,sp=$5B40)
; #SCR$03,$06,$0E,$09,$06(draw-entity-before)
; | #SIM(start=$962A,stop=$0000,ix=$8F1A,sp=$5B40)
; #SCR$03,$06,$0E,$09,$06(draw-entity-after) } UDGTABLE# #POPS
;
; IX Object record
@label=DrawEntity
c$962A CALL $9689    ; Prepare the registers for the sprite at its new
                     ; position.
 $962D EXX           ; Switch to the registers of the old sprite.
 $962E XOR A         ; {Write #N$00 to #R$8EE2 as there are no rows of the old sprite to
 $962F LD ($8EE2),A  ; draw.}
 $9632 LD C,A        ; #REGc=#N$00.
 $9633 JP $9728      ; Jump to #R$9728 to draw the sprite.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9F4A }
; { #COOKIE$7617 }
; { #LUNARJETMAN$8634 }
; { #PSSST$7536 }
; { #SABREWULF$B919 }
; { #TRANZAM$7149 }
; LIST#

; Remove Entity
;
; Used by the routines at #R$B079, #R$B6D3, #R$DF98, #R$E117, #R$E751 and
; #R$E8D7.
; .
; Draws the sprite of the object at the position that was stored by
; #R$989F, which removes it from the screen because the drawing uses XOR.
; Nothing new is drawn, so the row count of the new sprite is zero.
; .
; #PUSHS #UDGTABLE(default,centre)
; { =h Before | =h After #R$9636 }
; { #SIM(start=$9052,stop=$9078,clear=1,sp=$5B40)
; #SIM(start=$91C0,stop=$91E5,sp=$5B40)
; #SIM(start=$989F,stop=$0000,ix=$8F1A,sp=$5B40)
; #SCR$03,$06,$0E,$09,$06(remove-entity-before)
; | #SIM(start=$9636,stop=$0000,ix=$8F1A,sp=$5B40)
; #SCR$03,$06,$0E,$09,$06(remove-entity-after) } UDGTABLE# #POPS
;
; IX Object record
@label=RemoveEntity
c$9636 CALL $9657    ; Prepare the registers for the sprite at its old
                     ; position.
 $9639 EXX           ; Switch to the registers of the new sprite.
 $963A XOR A         ; {Write #N$00 to #R$8EE3 as there are no rows of the new sprite to
 $963B LD C,A        ; draw.}
 $963C LD ($8EE3),A  ; Store #REGa in the second row counter (#R$8EE3).
 $963F EXX           ; Switch back to the registers of the old sprite.
 $9640 JP $9728      ; Jump to #R$9728 to draw the sprite.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9F56 }
; { #COOKIE$7607 }
; { #SABREWULF$B8F5 }
; { #TRANZAM$7139 }
; LIST#

; Get Sprite "A"
;
; Used by the routine at #R$9657.
; .
; Fetches the address of the graphic for the sprite id that was
; recorded in #R$8EE1 by #R$989F.
;
; O:DE Address of the sprite data
@label=GetSpriteA
c$9643 LD A,($8EE1)  ; Fetch the previous sprite id from #R$8EE1.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9E86 }
; { #SABREWULF$B925 }
; LIST#

; Fetch Sprite
;
; Used by the routine at #R$9652.
; .
; Looks up the address of the graphic for a sprite in the table at
; #R$9332. The table has a two byte entry for each sprite id, starting at id
; #N$00.
;
;   A Sprite id
; O:DE Address of the sprite data
@label=FetchSprite
c$9646 LD L,A        ; Use the sprite id as the low byte of the offset.
 $9647 LD H,$00      ; Clear the high byte of the offset.
 $9649 ADD HL,HL     ; Double the sprite id to get the offset into the table.
 $964A LD BC,$9332   ; Point at the sprite address table (#R$9332).
 $964D ADD HL,BC     ; Add the offset to the address of the table.
 $964E LD E,(HL)     ; Fetch the low byte of the address of the sprite data.
 $964F INC HL        ; Move on to the high byte.
 $9650 LD D,(HL)     ; Fetch the high byte of the address of the sprite data.
 $9651 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9E89 }
; { #COOKIE$7623 }
; { #LUNARJETMAN$8568 }
; { #SABREWULF$B928 }
; { #TRANZAM$7155 }
; LIST#

; Fetch Actor Sprite
;
; Used by the routine at #R$9689.
; .
; Fetches the address of the graphic for the sprite of an object. The type
; of the object is also the id of its sprite. It uses #R$9646 to look the
; address up.
;
;   IX Object record
; O:DE Address of the sprite data
@label=FetchActorSprite
c$9652 LD A,(IX+$00) ; Fetch the type of the object (which is also its sprite
                     ; id).
 $9655 JR $9646      ; Jump to #R$9646 to look up the address.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9E96 }
; { #LUNARJETMAN$857F }
; { #SABREWULF$B934 }
; { #TRANZAM$7168 }
; LIST#

; Prepare Draw 2/ 3 Byte Sprite
;
; Used by the routines at #R$9636 and #R$96F7.
; .
; Gets the registers ready to draw the sprite at its old position, which
; was stored by #R$989F.
; .
; The shift table page is put in #REGb, the screen address of the bottom row is
; put in #REGhl, and the pointer to the pixel data is put in #REGde. The operand
; of the jump at #R$9760 is changed so that the unrolled code at #R$975B draws
; the right number of bytes for each row, and the number of rows is stored in
; #R$8EE2.
;
; O:B Page of the shift table
; O:C #N$00
; O:DE Address of the pixel data
; O:HL Screen address of the bottom row
@label=PrepDraw23
c$9657 CALL $9643    ; Fetch the address of the sprite data in #REGde.
 $965A LD HL,($8EE4) ; Fetch the old x position into #REGl and the old y position into
                     ; #REGh.
 $965D LD A,L        ; Copy the x position to #REGa.
 $965E DEC A         ; Subtract one.
 $965F RLCA          ; Multiply by two (rotate left).
 $9660 AND %00001110 ; Keep only the bits of the pixel offset (bits 1-3).
 $9662 OR %11110000  ; Set bits 4-7 to point at the pages #N$F0 to #N$FF.
 $9664 LD B,A        ; Store the page of the shift table in #REGb.
 $9665 LD A,(DE)     ; Fetch the width of the sprite in bytes.
 $9666 INC DE        ; Move on to the height of the sprite.
 $9667 NEG           ; Negate the width.
 $9669 AND %00001111 ; Keep only the low four bits.
 $966B SUB $07       ; Subtract #N$07 (which leaves #N$09 minus the width, the number of
                     ; unused pieces of the unrolled code).
 $966D ADD A,A       ; {Multiply by four.
 $966E ADD A,A       ; }
 $966F LD C,A        ; Store the result in #REGc.
 $9670 ADD A,A       ; Multiply by two.
 $9671 ADD A,C       ; Add the result so that it is multiplied by twelve (the size of the
                     ; code for one byte of the row).
 $9672 LD C,A        ; Store the offset in #REGc.
 $9673 LD A,L        ; Copy the x position to #REGa.
 $9674 AND %00000111 ; Keep only the pixel offset.
 $9676 LD A,C        ; Fetch the offset.
 $9677 JR NZ,$967B   ; Jump to #R$967B if the sprite does not start on a character
                     ; boundary.
 $9679 ADD A,$06     ; Add #N$06 to the offset to skip the first six bytes of the code for
                     ; the first byte of the row, as no cell to the left is needed.
@label=PrepDraw23_SetJump
*$967B LD ($9761),A  ; Change the operand of the jump at #R$9760.
 $967E LD A,(DE)     ; Fetch the height of the sprite.
 $967F INC DE        ; Move on to the pixel data.
 $9680 LD ($8EE2),A  ; Store the number of rows of the old sprite in #R$8EE2.
 $9683 CALL $ADF8    ; Convert the position into the screen address.
 $9686 LD C,$00      ; #REGc=#N$00.
 $9688 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9F80 }
; { #SABREWULF$B939 }
; LIST#

; Prepare Draw 2 Byte Sprite
;
; Used by the routines at #R$962A, #R$96F7, #R$AF3F, #R$E622, #R$E751, #R$E8D7
; and #R$EB39.
; .
; Gets the registers ready to draw the sprite of the object that #REGix
; points at, at its current position.
; .
; It does what #R$9657 does for the old sprite, but it uses the position and the
; type of the object, patches the jump at #R$97E6 (used by the unrolled code at
; #R$97E1), and stores the number of rows in #R$8EE3 and #R$8EE7. The number of
; character cells that the sprite covers in each row (one more than the width if
; the sprite is not aligned to a character boundary) is stored in #R$8EE6.
;
;   IX Object record
; O:B Page of the shift table
; O:C #N$00
; O:DE Address of the pixel data
; O:HL Screen address of the bottom row
@label=PrepDraw2
c$9689 CALL $9652    ; Fetch the address of the sprite data in #REGde.
 $968C LD L,(IX+$01) ; Fetch the x position of the object into #REGl.
 $968F LD H,(IX+$03) ; Fetch the y position of the object into #REGh.
 $9692 LD A,L        ; Copy the x position to #REGa.
 $9693 DEC A         ; Subtract one.
 $9694 RLCA          ; Multiply by two (rotate left).
 $9695 AND %00001110 ; Keep only the bits of the pixel offset (bits 1-3).
 $9697 OR %11110000  ; Set bits 4-7 to point at the pages #N$F0 to #N$FF.
 $9699 LD B,A        ; Store the page of the shift table in #REGb.
 $969A LD A,L        ; Copy the x position to #REGa.
 $969B AND %00000111 ; Keep only the pixel offset.
 $969D LD A,(DE)     ; Fetch the width of the sprite in bytes.
 $969E JR Z,$96A1    ; Jump to #R$96A1 if the sprite starts on a character
                     ; boundary.
 $96A0 INC A         ; Add one for the extra cell that the shifted sprite
                     ; needs.
@label=PrepDraw2_StoreCells
*$96A1 LD ($8EE6),A  ; Store the number of cells in each row in #R$8EE6.
 $96A4 LD A,(DE)     ; Fetch the width of the sprite in bytes.
 $96A5 INC DE        ; Move on to the height of the sprite.
 $96A6 NEG           ; Negate the width.
 $96A8 AND %00001111 ; Keep only the low four bits.
 $96AA SUB $07       ; Subtract #N$07 (which leaves #N$09 minus the width, the number of
                     ; unused pieces of the unrolled code).
 $96AC ADD A,A       ; {Multiply by four.
 $96AD ADD A,A       ; }
 $96AE LD C,A        ; Store the result in #REGc.
 $96AF ADD A,A       ; Multiply by two.
 $96B0 ADD A,C       ; Add the result so that it is multiplied by twelve (the size of the
                     ; code for one byte of the row).
 $96B1 LD C,A        ; Store the offset in #REGc.
 $96B2 LD A,L        ; Copy the x position to #REGa.
 $96B3 AND %00000111 ; Keep only the pixel offset.
 $96B5 LD A,C        ; Fetch the offset.
 $96B6 JR NZ,$96BA   ; Jump to #R$96BA if the sprite does not start on a character
                     ; boundary.
 $96B8 ADD A,$06     ; Add #N$06 to the offset to skip the first six bytes of the code for
                     ; the first byte of the row, as no cell to the left is needed.
@label=PrepDraw2_SetJump
*$96BA LD ($97E7),A  ; Change the operand of the jump at #R$97E6.
 $96BD LD A,(DE)     ; Fetch the height of the sprite.
 $96BE INC DE        ; Move on to the pixel data.
 $96BF LD ($8EE3),A  ; Store the number of rows of the new sprite in #R$8EE3.
 $96C2 LD ($8EE7),A  ; Store the height of the sprite in #R$8EE7.
 $96C5 CALL $ADF8    ; Convert the position into the screen address.
 $96C8 LD C,$00      ; #REGc=#N$00.
 $96CA RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9F9F }
; { #SABREWULF$B969 }
; LIST#

; Update Object Sprite
;
; Used by the routines at #R$A316, #R$A3E9, #R$A406, #R$A433, #R$A5F1, #R$A678,
; #R$A6A6, #R$A8EF, #R$A925, #R$AEB9, #R$AF3F, #R$B079, #R$B58C, #R$DEDA,
; #R$DEE8, #R$DF15, #R$DF42, #R$DF98, #R$E027, #R$E117, #R$E18C, #R$E272,
; #R$E2CB, #R$E4CA, #R$E556, #R$E570, #R$E751, #R$E7D0, #R$E7E3, #R$E894,
; #R$ECCA and #R$ED2E.
; .
; Redraws the sprite of the object that #REGix points at and sets its
; attributes.
; .
; If bit 0 of byte #N$0F of the object is clear, the sprite is moved with
; #R$96F7. If the bit is set, the sprite has no old image on the screen to erase
; (for example because the room has just been drawn), so the bit is cleared and
; the sprite is just drawn.
; .
; The entry at #R$96E1 does the same using bit 0 of byte #N$07 of the object.
;
; IX Object record
@label=Update_Object_Sprite
c$96CB BIT 0,(IX+$0F) ; {Jump to #R$96D7 if the flag is set.
 $96CF JR NZ,$96D7    ; }
 $96D1 CALL $96F7     ; Erase the sprite at its old position and draw it at the
                      ; new one.
 $96D4 JP $9867       ; Jump to #R$9867.
@label=Update_Object_Sprite_Reset_Redraw_Flag
*$96D7 RES 0,(IX+$0F) ; Reset bit 0 of the redraw flags of the object.
; This entry point is used by the routine at #R$9EA0.
@label=Update_Object_Sprite_Draw
*$96DB CALL $962A     ; Draw the sprite.
 $96DE JP $9867       ; Jump to #R$9867.
; This entry point is used by the routine at #R$E8D7.
@label=Update_Object_Sprite_Using_Flags
*$96E1 BIT 0,(IX+$07) ; {Jump to #R$96ED if the flag is set.
 $96E5 JR NZ,$96ED    ; }
 $96E7 CALL $96F7     ; Erase the sprite at its old position and draw it at the
                      ; new one.
 $96EA JP $9867       ; Jump to #R$9867.
@label=Update_Object_Sprite_Reset_Flag
*$96ED RES 0,(IX+$07) ; Reset bit 0 of the flags of the object.
 $96F1 CALL $962A     ; Draw the sprite.
 $96F4 JP $9867       ; Jump to #R$9867.

; Display Entity
;
; Used by the routine at #R$96CB.
; .
; Erases the sprite at its old position and draws it at the new one.
; .
; Both sprites are drawn with XOR, a row at a time, so that the rows are
; alternated between the two sprites and the screen is never without the sprite
; for long. If the sprites are offset vertically, the rows of the sprite that
; has no matching row in the other one are drawn first.
; .
; #PUSHS #UDGTABLE(default,centre)
; { =h Before | =h After #R$96F7 }
; { #SIM(start=$9052,stop=$9078,clear=1,sp=$5B40)
; #SIM(start=$91C0,stop=$91E5,sp=$5B40)
; #SIM(start=$989F,stop=$0000,ix=$8F1A,sp=$5B40)
; #SCR$03,$06,$0E,$09,$06(display-entity-before)
; | #POKES$8F1B,$50;$8F1D,$97
; #SIM(start=$96F7,stop=$0000,ix=$8F1A,sp=$5B40)
; #SIM(start=$9867,stop=$0000,ix=$8F1A,sp=$5B40)
; #SCR$03,$06,$0E,$09,$06(display-entity-after) } UDGTABLE# #POPS
;
; IX Object record
@label=DisplayEntity
c$96F7 CALL $9689    ; Prepare the registers for the sprite at its new
                     ; position.
 $96FA EXX           ; Switch to the registers of the old sprite.
 $96FB CALL $9657    ; Prepare the registers for the sprite at its old
                     ; position.
 $96FE LD A,($8EE5)  ; Fetch the old y position from #R$8EE5.
 $9701 SUB (IX+$03)  ; Subtract the new y position of the object.
 $9704 JP Z,$9742    ; Jump to #R$9742 if the y position has not changed.
 $9707 JP M,$9719    ; Jump to #R$9719 if the sprite has moved down the screen.
; The old sprite is lower than the new one, so draw the bottom rows of the
; old sprite on their own first.
 $970A LD C,A        ; Copy the number of rows that stand alone to #REGc.
 $970B LD A,($8EE2)  ; Fetch the number of rows of the old sprite from #R$8EE2.
 $970E CP C          ; Compare it with the number of rows that stand alone.
 $970F JP C,$9742    ; Jump to #R$9742 if the old sprite has no more rows than that, so
                     ; that the sprites do not overlap and are each drawn in full.
 $9712 SUB C         ; Subtract the number of rows that stand alone.
 $9713 LD ($8EE2),A  ; Store the number of rows that remain.
 $9716 JP $9728      ; Jump to #R$9728 to draw those rows of the old sprite on
                     ; their own.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9FCA }
; { #COOKIE$75CC }
; { #JETPAC$726A }
; { #PSSST$74EB }
; { #SABREWULF$B9A9 }
; { #TRANZAM$7101 }
; LIST#

; Display Entity Moved Down
;
; Used by the routine at #R$96F7.
; .
; Draws the bottom rows of the new sprite on their own first, because the
; new sprite is lower than the old one (the old sprite has moved up the screen).
;
; A Old y position minus the new y position (negative)
@label=DisplayEntity_NewLower
c$9719 EXX           ; Switch to the registers of the new sprite.
 $971A NEG           ; Make the difference positive.
 $971C LD C,A        ; Copy the number of rows that stand alone to #REGc.
 $971D LD A,($8EE3)  ; Fetch the number of rows of the new sprite from #R$8EE3.
 $9720 CP C          ; Compare it with the number of rows that stand alone.
 $9721 JP C,$9741    ; Jump to #R$9741 if the new sprite has no more rows than that, so
                     ; that the sprites do not overlap and are each drawn in full.
 $9724 SUB C         ; Subtract the number of rows that stand alone.
 $9725 JP $9755      ; Jump to #R$9755 to store the number of rows that remain and draw
                     ; those rows of the new sprite on their own.
; View the equivalent code in;
; #LIST
; { #SABREWULF$B9CB }
; LIST#

; XOR Sprite Loop
;
; Used by the routines at #R$962A, #R$9636 and #R$96F7.
; .
; Draws the old sprite and the new sprite a row at a time, alternating
; between the two, until every row of both has been drawn. The set of registers
; that is current on entry belongs to the old sprite, which is drawn by #R$975B.
; The other set belongs to the new sprite, which is drawn by #R$97E1.
; .
; In each set #REGhl is the screen address of the next row (the sprites are
; drawn from the bottom row upwards), #REGde points at the pixel data and #REGb
; is the page of the shift table. #REGc counts the rows that remain.
; .
; When both counts reach zero, the counts that are held in #R$8EE2 (old sprite)
; and #R$8EE3 (new sprite) are loaded and the whole process repeats. The routine
; returns when those are zero as well. This allows the rows that have no partner
; to be drawn first (see #R$96F7).
;
; .
;
; Draw a row of the old sprite, if it has any rows left.
@label=XORSpriteLoop
c$9728 LD A,C        ; Fetch the row count of the old sprite.
 $9729 AND A         ; {Jump to #R$973C if there are no rows left.
 $972A JR Z,$973C    ; }
 $972C DEC C         ; Decrease the row count.
 $972D CALL $975B    ; Draw a row of the old sprite.
; Draw a row of the new sprite, if it has any rows left.
 $9730 EXX           ; Switch to the registers of the new sprite.
 $9731 LD A,C        ; Fetch the row count of the new sprite.
 $9732 AND A         ; {Jump to #R$9739 if there are no rows left.
 $9733 JR Z,$9739    ; }
@label=XORSpriteLoop_NewRow
*$9735 DEC C         ; Decrease the row count.
 $9736 CALL $97E1    ; Draw a row of the new sprite.
@label=XORSpriteLoop_OldRow
*$9739 EXX           ; Switch to the registers of the old sprite.
 $973A JR $9728      ; Jump back to #R$9728 to draw the next pair of rows.
@label=XORSpriteLoop_NewOnly
*$973C EXX           ; Switch to the registers of the new sprite.
 $973D LD A,C        ; Fetch the row count of the new sprite.
 $973E AND A         ; {Jump to #R$9735 if there are rows left.
 $973F JR NZ,$9735   ; }
; This entry point is used by the routine at #R$9719.
@label=XORSpriteLoop_Done
*$9741 EXX           ; Switch to the registers of the old sprite.
; This entry point is used by the routine at #R$96F7.
; .
; Both of the counts are zero. Load the row counts that were stored by the
; preparation routines and go round again, unless they are zero too.
@label=XORSpriteLoop_Reload
*$9742 LD A,($8EE2)  ; Fetch the number of rows of the old sprite from #R$8EE2.
 $9745 LD C,A        ; Copy the number of rows to #REGc.
 $9746 LD A,($8EE3)  ; Fetch the number of rows of the new sprite from #R$8EE3.
 $9749 OR C          ; Combine it with the number of rows of the old sprite.
 $974A RET Z         ; Return if there are no rows left to draw.
 $974B XOR A         ; {Write #N$00 to #R$8EE2.
 $974C LD ($8EE2),A  ; }
 $974F EXX           ; Switch to the registers of the new sprite.
 $9750 LD A,($8EE3)  ; Fetch the number of rows of the new sprite from #R$8EE3.
 $9753 LD C,A        ; Copy the number of rows to #REGc.
 $9754 XOR A         ; Set the number of rows to store to #N$00.
; This entry point is used by the routine at #R$9719.
@label=XORSpriteLoop_StoreNew
*$9755 LD ($8EE3),A  ; Store #REGa in #R$8EE3.
 $9758 EXX           ; Switch to the registers of the old sprite.
 $9759 JR $9728      ; Jump back to #R$9728 to start drawing rows.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9E9B }
; { #COOKIE$763A }
; { #LUNARJETMAN$858E }
; { #SABREWULF$B9DA }
; LIST#

; Draw Old Entity Row
;
; Used by the routine at #R$9728.
; .
; Draws one row of the old sprite, using XOR, and moves up to the next
; row.
; .
; The row is drawn by unrolled code with one piece of #N$0C bytes for each byte
; of the row (up to nine bytes). The operand of the jump at #R$9760 is changed
; by #R$9657 so that the jump lands on the first piece that is needed. If the
; sprite is aligned to a character boundary the jump goes six bytes further in,
; which leaves out the first write.
;
;   B Page of the shift table
;   DE Pointer to the pixel data
;   HL Screen address of the row
;   C Number of rows left
; O:C Number of rows left
; O:DE Pointer to the next row of pixel data
; O:HL Screen address of the next row
@label=DrawOldEntityRow
c$975B LD A,C        ; Copy the row count to #REGa.
 $975C EX AF,AF'     ; Store the row count in #REGaf'.
 $975D LD A,(DE)     ; Fetch the first byte of the row.
 $975E LD C,A        ; Copy it to #REGc to use as the index into the shift
                     ; table.
 $975F PUSH HL       ; Stash the screen address on the stack.
@label=DrawOldEntityRow_Jump
*$9760 JR $9760      ; Jump into the unrolled code. The operand of this instruction is
                     ; changed by #R$9657.
@label=DrawOldEntityRow_Byte_1
 $9762 LD A,(DE)     ; {Byte 1 of the row: look up the shifted byte for the left
 $9763 LD C,A        ; cell and XOR it onto the screen.
 $9764 LD A,(BC)     ;
 $9765 XOR (HL)      ;
 $9766 LD (HL),A     ;
 $9767 INC L         ; }
@label=DrawOldEntityRow_Byte_1_Right
 $9768 INC B         ; {Look up the shifted byte for the cell to the right and XOR it
 $9769 LD A,(BC)     ; onto the screen, then move on to the next byte of pixel data.
 $976A XOR (HL)      ;
 $976B LD (HL),A     ;
 $976C DEC B         ;
 $976D INC DE        ; }
@label=DrawOldEntityRow_Byte_2
 $976E LD A,(DE)     ; {Byte 2 of the row: look up the shifted byte for the left
 $976F LD C,A        ; cell and XOR it onto the screen.
 $9770 LD A,(BC)     ;
 $9771 XOR (HL)      ;
 $9772 LD (HL),A     ;
 $9773 INC L         ; }
@label=DrawOldEntityRow_Byte_2_Right
 $9774 INC B         ; {Look up the shifted byte for the cell to the right and XOR it
 $9775 LD A,(BC)     ; onto the screen, then move on to the next byte of pixel data.
 $9776 XOR (HL)      ;
 $9777 LD (HL),A     ;
 $9778 DEC B         ;
 $9779 INC DE        ; }
@label=DrawOldEntityRow_Byte_3
 $977A LD A,(DE)     ; {Byte 3 of the row: look up the shifted byte for the left
 $977B LD C,A        ; cell and XOR it onto the screen.
 $977C LD A,(BC)     ;
 $977D XOR (HL)      ;
 $977E LD (HL),A     ;
 $977F INC L         ; }
@label=DrawOldEntityRow_Byte_3_Right
 $9780 INC B         ; {Look up the shifted byte for the cell to the right and XOR it
 $9781 LD A,(BC)     ; onto the screen, then move on to the next byte of pixel data.
 $9782 XOR (HL)      ;
 $9783 LD (HL),A     ;
 $9784 DEC B         ;
 $9785 INC DE        ; }
@label=DrawOldEntityRow_Byte_4
 $9786 LD A,(DE)     ; {Byte 4 of the row: look up the shifted byte for the left
 $9787 LD C,A        ; cell and XOR it onto the screen.
 $9788 LD A,(BC)     ;
 $9789 XOR (HL)      ;
 $978A LD (HL),A     ;
 $978B INC L         ; }
@label=DrawOldEntityRow_Byte_4_Right
 $978C INC B         ; {Look up the shifted byte for the cell to the right and XOR it
 $978D LD A,(BC)     ; onto the screen, then move on to the next byte of pixel data.
 $978E XOR (HL)      ;
 $978F LD (HL),A     ;
 $9790 DEC B         ;
 $9791 INC DE        ; }
@label=DrawOldEntityRow_Byte_5
 $9792 LD A,(DE)     ; {Byte 5 of the row: look up the shifted byte for the left
 $9793 LD C,A        ; cell and XOR it onto the screen.
 $9794 LD A,(BC)     ;
 $9795 XOR (HL)      ;
 $9796 LD (HL),A     ;
 $9797 INC L         ; }
@label=DrawOldEntityRow_Byte_5_Right
 $9798 INC B         ; {Look up the shifted byte for the cell to the right and XOR it
 $9799 LD A,(BC)     ; onto the screen, then move on to the next byte of pixel data.
 $979A XOR (HL)      ;
 $979B LD (HL),A     ;
 $979C DEC B         ;
 $979D INC DE        ; }
@label=DrawOldEntityRow_Byte_6
 $979E LD A,(DE)     ; {Byte 6 of the row: look up the shifted byte for the left
 $979F LD C,A        ; cell and XOR it onto the screen.
 $97A0 LD A,(BC)     ;
 $97A1 XOR (HL)      ;
 $97A2 LD (HL),A     ;
 $97A3 INC L         ; }
@label=DrawOldEntityRow_Byte_6_Right
 $97A4 INC B         ; {Look up the shifted byte for the cell to the right and XOR it
 $97A5 LD A,(BC)     ; onto the screen, then move on to the next byte of pixel data.
 $97A6 XOR (HL)      ;
 $97A7 LD (HL),A     ;
 $97A8 DEC B         ;
 $97A9 INC DE        ; }
@label=DrawOldEntityRow_Byte_7
 $97AA LD A,(DE)     ; {Byte 7 of the row: look up the shifted byte for the left
 $97AB LD C,A        ; cell and XOR it onto the screen.
 $97AC LD A,(BC)     ;
 $97AD XOR (HL)      ;
 $97AE LD (HL),A     ;
 $97AF INC L         ; }
@label=DrawOldEntityRow_Byte_7_Right
 $97B0 INC B         ; {Look up the shifted byte for the cell to the right and XOR it
 $97B1 LD A,(BC)     ; onto the screen, then move on to the next byte of pixel data.
 $97B2 XOR (HL)      ;
 $97B3 LD (HL),A     ;
 $97B4 DEC B         ;
 $97B5 INC DE        ; }
@label=DrawOldEntityRow_Byte_8
 $97B6 LD A,(DE)     ; {Byte 8 of the row: look up the shifted byte for the left
 $97B7 LD C,A        ; cell and XOR it onto the screen.
 $97B8 LD A,(BC)     ;
 $97B9 XOR (HL)      ;
 $97BA LD (HL),A     ;
 $97BB INC L         ; }
@label=DrawOldEntityRow_Byte_8_Right
 $97BC INC B         ; {Look up the shifted byte for the cell to the right and XOR it
 $97BD LD A,(BC)     ; onto the screen, then move on to the next byte of pixel data.
 $97BE XOR (HL)      ;
 $97BF LD (HL),A     ;
 $97C0 DEC B         ;
 $97C1 INC DE        ; }
@label=DrawOldEntityRow_Byte_9
 $97C2 LD A,(DE)     ; {Byte 9 of the row: look up the shifted byte for the left
 $97C3 LD C,A        ; cell and XOR it onto the screen.
 $97C4 LD A,(BC)     ;
 $97C5 XOR (HL)      ;
 $97C6 LD (HL),A     ;
 $97C7 INC L         ; }
@label=DrawOldEntityRow_Byte_9_Right
 $97C8 INC B         ; {Look up the shifted byte for the cell to the right and XOR it
 $97C9 LD A,(BC)     ; onto the screen, then move on to the next byte of pixel data.
 $97CA XOR (HL)      ;
 $97CB LD (HL),A     ;
 $97CC DEC B         ;
 $97CD INC DE        ; }
@label=DrawOldEntityRow_Byte_9_Next
 $97CE EX AF,AF'     ; Fetch the row count from #REGaf'.
 $97CF LD C,A        ; Copy the row count to #REGc.
 $97D0 POP HL        ; Restore the screen address from the stack.
 $97D1 DEC H         ; Move up one pixel line.
 $97D2 LD A,H        ; {Fetch the inverse of the high byte of the address in
 $97D3 CPL           ; #REGa.}
 $97D4 AND %00000111 ; Keep only the pixel line bits (bits 0-2).
 $97D6 RET NZ        ; Return if the move up stayed inside the same character
                     ; cell.
 $97D7 LD A,L        ; {Subtract #N$20 from the low byte to move up to the previous
 $97D8 SUB $20       ; character row.
 $97DA LD L,A        ; }
 $97DB RET C         ; Return if the move up stayed inside the same third of
                     ; the screen.
 $97DC LD A,H        ; {Add #N$08 to the high byte to move up to the previous third of the
 $97DD ADD A,$08     ; screen.
 $97DF LD H,A        ; }
 $97E0 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #SABREWULF$BA0D }
; LIST#

; Draw New Entity Row
;
; Used by the routine at #R$9728.
; .
; Draws one row of the new sprite, using XOR, and moves up to the next
; row. It is a copy of #R$975B that uses the jump at #R$97E6, which is changed
; by #R$9689.
;
;   B Page of the shift table
;   DE Pointer to the pixel data
;   HL Screen address of the row
;   C Number of rows left
; O:C Number of rows left
; O:DE Pointer to the next row of pixel data
; O:HL Screen address of the next row
@label=DrawNewEntityRow
c$97E1 LD A,C        ; Copy the row count to #REGa.
 $97E2 EX AF,AF'     ; Store the row count in #REGaf'.
 $97E3 LD A,(DE)     ; Fetch the first byte of the row.
 $97E4 LD C,A        ; Copy it to #REGc to use as the index into the shift
                     ; table.
 $97E5 PUSH HL       ; Stash the screen address on the stack.
@label=DrawNewEntityRow_Jump
*$97E6 JR $97E6      ; Jump into the unrolled code. The operand of this instruction is
                     ; changed by #R$9689.
@label=DrawNewEntityRow_Byte_1
 $97E8 LD A,(DE)     ; {Byte 1 of the row: look up the shifted byte for the left
 $97E9 LD C,A        ; cell and XOR it onto the screen.
 $97EA LD A,(BC)     ;
 $97EB XOR (HL)      ;
 $97EC LD (HL),A     ;
 $97ED INC L         ; }
@label=DrawNewEntityRow_Byte_1_Right
 $97EE INC B         ; {Look up the shifted byte for the cell to the right and XOR it
 $97EF LD A,(BC)     ; onto the screen, then move on to the next byte of pixel data.
 $97F0 XOR (HL)      ;
 $97F1 LD (HL),A     ;
 $97F2 DEC B         ;
 $97F3 INC DE        ; }
@label=DrawNewEntityRow_Byte_2
 $97F4 LD A,(DE)     ; {Byte 2 of the row: look up the shifted byte for the left
 $97F5 LD C,A        ; cell and XOR it onto the screen.
 $97F6 LD A,(BC)     ;
 $97F7 XOR (HL)      ;
 $97F8 LD (HL),A     ;
 $97F9 INC L         ; }
@label=DrawNewEntityRow_Byte_2_Right
 $97FA INC B         ; {Look up the shifted byte for the cell to the right and XOR it
 $97FB LD A,(BC)     ; onto the screen, then move on to the next byte of pixel data.
 $97FC XOR (HL)      ;
 $97FD LD (HL),A     ;
 $97FE DEC B         ;
 $97FF INC DE        ; }
@label=DrawNewEntityRow_Byte_3
 $9800 LD A,(DE)     ; {Byte 3 of the row: look up the shifted byte for the left
 $9801 LD C,A        ; cell and XOR it onto the screen.
 $9802 LD A,(BC)     ;
 $9803 XOR (HL)      ;
 $9804 LD (HL),A     ;
 $9805 INC L         ; }
@label=DrawNewEntityRow_Byte_3_Right
 $9806 INC B         ; {Look up the shifted byte for the cell to the right and XOR it
 $9807 LD A,(BC)     ; onto the screen, then move on to the next byte of pixel data.
 $9808 XOR (HL)      ;
 $9809 LD (HL),A     ;
 $980A DEC B         ;
 $980B INC DE        ; }
@label=DrawNewEntityRow_Byte_4
 $980C LD A,(DE)     ; {Byte 4 of the row: look up the shifted byte for the left
 $980D LD C,A        ; cell and XOR it onto the screen.
 $980E LD A,(BC)     ;
 $980F XOR (HL)      ;
 $9810 LD (HL),A     ;
 $9811 INC L         ; }
@label=DrawNewEntityRow_Byte_4_Right
 $9812 INC B         ; {Look up the shifted byte for the cell to the right and XOR it
 $9813 LD A,(BC)     ; onto the screen, then move on to the next byte of pixel data.
 $9814 XOR (HL)      ;
 $9815 LD (HL),A     ;
 $9816 DEC B         ;
 $9817 INC DE        ; }
@label=DrawNewEntityRow_Byte_5
 $9818 LD A,(DE)     ; {Byte 5 of the row: look up the shifted byte for the left
 $9819 LD C,A        ; cell and XOR it onto the screen.
 $981A LD A,(BC)     ;
 $981B XOR (HL)      ;
 $981C LD (HL),A     ;
 $981D INC L         ; }
@label=DrawNewEntityRow_Byte_5_Right
 $981E INC B         ; {Look up the shifted byte for the cell to the right and XOR it
 $981F LD A,(BC)     ; onto the screen, then move on to the next byte of pixel data.
 $9820 XOR (HL)      ;
 $9821 LD (HL),A     ;
 $9822 DEC B         ;
 $9823 INC DE        ; }
@label=DrawNewEntityRow_Byte_6
 $9824 LD A,(DE)     ; {Byte 6 of the row: look up the shifted byte for the left
 $9825 LD C,A        ; cell and XOR it onto the screen.
 $9826 LD A,(BC)     ;
 $9827 XOR (HL)      ;
 $9828 LD (HL),A     ;
 $9829 INC L         ; }
@label=DrawNewEntityRow_Byte_6_Right
 $982A INC B         ; {Look up the shifted byte for the cell to the right and XOR it
 $982B LD A,(BC)     ; onto the screen, then move on to the next byte of pixel data.
 $982C XOR (HL)      ;
 $982D LD (HL),A     ;
 $982E DEC B         ;
 $982F INC DE        ; }
@label=DrawNewEntityRow_Byte_7
 $9830 LD A,(DE)     ; {Byte 7 of the row: look up the shifted byte for the left
 $9831 LD C,A        ; cell and XOR it onto the screen.
 $9832 LD A,(BC)     ;
 $9833 XOR (HL)      ;
 $9834 LD (HL),A     ;
 $9835 INC L         ; }
@label=DrawNewEntityRow_Byte_7_Right
 $9836 INC B         ; {Look up the shifted byte for the cell to the right and XOR it
 $9837 LD A,(BC)     ; onto the screen, then move on to the next byte of pixel data.
 $9838 XOR (HL)      ;
 $9839 LD (HL),A     ;
 $983A DEC B         ;
 $983B INC DE        ; }
@label=DrawNewEntityRow_Byte_8
 $983C LD A,(DE)     ; {Byte 8 of the row: look up the shifted byte for the left
 $983D LD C,A        ; cell and XOR it onto the screen.
 $983E LD A,(BC)     ;
 $983F XOR (HL)      ;
 $9840 LD (HL),A     ;
 $9841 INC L         ; }
@label=DrawNewEntityRow_Byte_8_Right
 $9842 INC B         ; {Look up the shifted byte for the cell to the right and XOR it
 $9843 LD A,(BC)     ; onto the screen, then move on to the next byte of pixel data.
 $9844 XOR (HL)      ;
 $9845 LD (HL),A     ;
 $9846 DEC B         ;
 $9847 INC DE        ; }
@label=DrawNewEntityRow_Byte_9
 $9848 LD A,(DE)     ; {Byte 9 of the row: look up the shifted byte for the left
 $9849 LD C,A        ; cell and XOR it onto the screen.
 $984A LD A,(BC)     ;
 $984B XOR (HL)      ;
 $984C LD (HL),A     ;
 $984D INC L         ; }
@label=DrawNewEntityRow_Byte_9_Right
 $984E INC B         ; {Look up the shifted byte for the cell to the right and XOR it
 $984F LD A,(BC)     ; onto the screen, then move on to the next byte of pixel data.
 $9850 XOR (HL)      ;
 $9851 LD (HL),A     ;
 $9852 DEC B         ;
 $9853 INC DE        ; }
@label=DrawNewEntityRow_Byte_9_Next
 $9854 EX AF,AF'     ; Fetch the row count from #REGaf'.
 $9855 LD C,A        ; Copy the row count to #REGc.
 $9856 POP HL        ; Restore the screen address from the stack.
 $9857 DEC H         ; Move up one pixel line.
 $9858 LD A,H        ; {Fetch the inverse of the high byte of the address in
 $9859 CPL           ; #REGa.}
 $985A AND %00000111 ; Keep only the pixel line bits (bits 0-2).
 $985C RET NZ        ; Return if the move up stayed inside the same character
                     ; cell.
 $985D LD A,L        ; {Subtract #N$20 from the low byte to move up to the previous
 $985E SUB $20       ; character row.
 $9860 LD L,A        ; }
 $9861 RET C         ; Return if the move up stayed inside the same third of
                     ; the screen.
 $9862 LD A,H        ; {Add #N$08 to the high byte to move up to the previous third of the
 $9863 ADD A,$08     ; screen.
 $9865 LD H,A        ; }
 $9866 RET           ; Return.
