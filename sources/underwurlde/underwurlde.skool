; Write Menu Line
;
; Used by the routines at #R$90E4, #R$9E16, #R$9E4A, #R$9E58, #R$9EA0 and
; #R$9FA3.
; .
; Prints a string at a pixel position, giving every character the
; attribute that is held in #R$8EE8. The last character of the string has bit 7
; set.
; .
; The work is done by #R$9C48, which prints through #REGhl (the screen
; address) while the attribute buffer address is kept in #REGhl' and the
; attribute in #REGaf'.
; .
; #PUSHS #UDGTABLE(default,centre)
; { =h Before | =h After #R$91B0 }
; { #SIM(start=$9052,stop=$9078,clear=1,sp=$5B40)
; #SIM(start=$9078,stop=$90FE,sp=$5B40)
; #SCR$02,$0A,$04,$16,$03(menu-line-before)
; | #SIM(start=$90FE,stop=$9101,sp=$5B40)
; #SCR$02,$0A,$04,$16,$03(menu-line-after) } UDGTABLE# #POPS
;
; HL Position (#REGl is the x position, #REGh is the y position)
; DE Pointer to the string
@label=MenuWriteText
c$91B0 PUSH HL       ; Stash the position on the stack.
 $91B1 CALL $ADF8    ; Convert the position into the screen address (in
                     ; #REGhl).
 $91B4 LD A,($8EE8)  ; Fetch the attribute from #R$8EE8.
 $91B7 EX AF,AF'     ; Keep the attribute for the characters of the string.
 $91B8 EXX           ; Switch to the shadow registers.
 $91B9 POP HL        ; Restore the position into #REGhl'.
 $91BA CALL $ADE0    ; Convert the position into the address in the attribute
                     ; buffer.
 $91BD JP $9C48      ; Jump to #R$9C48 to print the string.
; View the equivalent code in;
; #LIST
; { #ATICATAC$7D8A }
; { #COOKIE$63E0 }
; { #JETPAC$62FF }
; { #LUNARJETMAN$81AB }
; { #PSSST$62E7 }
; { #SABREWULF$B52D }
; { #TRANZAM$5F97 }
; LIST#

; Run Game
;
; Used by the routine at #R$9052.
; .
; Starts a new game and then runs the main loop forever.
; .
; The loop at #R$91E5 goes through the object records one at a time. Byte #N$00
; of a record is the type of the object, which is used as an index into the
; #R$921A handler table. The handler is run with #REGix pointing at the record
; and with #R$9459 stacked as its return address, so every handler ends by
; returning to #R$9459 which moves on to the next record.
;
; .
;
; Start a new game: empty the room table, clear the workspace and the
; objects, and clear the screen.
@label=Run_Game
c$91C0 CALL $9C62    ; Empty the room visit table.
 $91C3 CALL $9563    ; Clear the sprite workspace, the score and the other
                     ; variables.
 $91C6 CALL $E825    ; Clear all of the object records except the first two.
 $91C9 CALL $9573    ; Set every attribute to white ink on black paper.
 $91CC CALL $957D    ; Clear the screen.
 $91CF CALL $ECBD    ; Set up the fifth small object record.
; Set up Sabreman and draw the status panel and the room.
 $91D2 CALL $A3DD    ; Copy the template of Sabreman into his object record.
 $91D5 LD IX,$8F1A   ; Point at the object record of Sabreman (#R$8F1A).
 $91D9 CALL $A021    ; Draw the lives icon and the number of lives.
 $91DC CALL $9E16    ; Print the status panel.
 $91DF CALL $9E4A    ; Print the word SCORE and the score.
 $91E2 CALL $9906    ; Draw the room. This does not return: it resets the stack and jumps
                     ; to #R$91E5.
; This entry point is used by the routine at #R$9459.
; .
; This is the main loop. The normal pass starts with Sabreman's record,
; unless his type is from #N$09 to #N$1B. Those types are handled with the
; priority records (see #R$951D), so then the pass starts with the
; record after his. The first two records are only ever handled as priority
; records.
@label=Main_Loop
*$91E5 EI            ; Enable interrupts.
 $91E6 LD IX,$8F1A   ; Point at the object record of Sabreman (#R$8F1A).
 $91EA LD A,($8F1A)  ; Fetch the type of Sabreman.
 $91ED CP $1C        ; {Jump to #R$91F9 if the type is greater than or equal to
 $91EF JR NC,$91F9   ; #N$1C.}
 $91F1 CP $09        ; {Jump to #R$91F9 if the type is less than #N$09.
 $91F3 JR C,$91F9    ; }
 $91F5 LD IX,$8F2A   ; Point at the record after Sabreman's (#R$8F2A).
; Give the creature spawners a chance to run, then run the handler of the
; object that #REGix points at.
@label=Run_Game_Spawn_Creatures
*$91F9 CALL $DF58    ; Maybe spawn a stalactite.
 $91FC CALL $AFDA    ; Maybe spawn a flying creature.
 $91FF LD A,($AAAC)  ; Fetch the room flags from #R$AAAC.
 $9202 AND %00010000 ; Keep only bit 4.
 $9204 CALL Z,$E05F  ; Maybe spawn a bubble if bit 4 is not set.
; This entry point is used by the routines at #R$9459 and #R$9906.
; .
; Run the handler of the object that #REGix points at.
@label=Run_Object_Handler
*$9207 LD HL,$9459   ; Point at the return address of the handler (#R$9459).
; This entry point is used by the routine at #R$9459.
@label=Run_Object_Handler_Stash_Return
*$920A PUSH HL       ; Stash it on the stack.
 $920B LD BC,$921A   ; Point at the handler table (#R$921A).
 $920E LD L,(IX+$00) ; Fetch the type of the object.
; This entry point is used by the routine at #R$9459.
@label=Run_Object_Handler_Look_Up
*$9211 LD H,$00      ; Clear #REGh so that #REGhl holds the type.
 $9213 ADD HL,HL     ; Double the type to get the offset of its handler in the
                     ; table.
 $9214 ADD HL,BC     ; Add the address of the table.
 $9215 LD A,(HL)     ; Fetch the low byte of the handler address.
 $9216 INC HL        ; Move on to the high byte.
 $9217 LD H,(HL)     ; Fetch the high byte of the handler address.
 $9218 LD L,A        ; Copy the low byte of the handler address to #REGl.
 $9219 JP (HL)       ; Jump to the handler.

; Object Handler Table
;
; The address of the handler for every type of object, indexed by the type
; (the first byte of an object record). Several types share a handler. The
; handler for type #N$00 (an empty record) is #R$9454, which only wastes a
; little time.
@label=Object_Handler_Table
w$921A DEFW $9454,$A316,$A316,$A316,$A316,$A316,$A316,$A316 ; Handlers for the
                                                            ; object types
                                                            ; #N$00 to #N$07.
 $922A DEFW $A316,$A433,$A433,$A433,$A433,$A433,$A433,$A433 ; Handlers for the
                                                            ; object types
                                                            ; #N$08 to #N$0F.
 $923A DEFW $A433,$A5F1,$A5F1,$A5F1,$A5F1,$A6A6,$A6A6,$AA4C ; Handlers for the
                                                            ; object types
                                                            ; #N$10 to #N$17.
 $924A DEFW $A925,$A925,$A925,$A925,$AEB9,$AEB9,$AEB9,$AEB9 ; Handlers for the
                                                            ; object types
                                                            ; #N$18 to #N$1F.
 $925A DEFW $AEB9,$AEB9,$AEB9,$AEB9,$AEB9,$AEB9,$AEB9,$AEB9 ; Handlers for the
                                                            ; object types
                                                            ; #N$20 to #N$27.
 $926A DEFW $AEB9,$AEB9,$AEB9,$AEB9,$AF3F,$AF3F,$AF3F,$AF3F ; Handlers for the
                                                            ; object types
                                                            ; #N$28 to #N$2F.
 $927A DEFW $B079,$B079,$B079,$B079,$EE66,$EE66,$EE66,$EE66 ; Handlers for the
                                                            ; object types
                                                            ; #N$30 to #N$37.
 $928A DEFW $B57A,$B57A,$B57A,$B57A,$E622,$E622,$E7E3,$E7E3 ; Handlers for the
                                                            ; object types
                                                            ; #N$38 to #N$3F.
 $929A DEFW $B079,$B079,$B079,$B079,$B3D8,$B3D8,$B3D8,$B3D8 ; Handlers for the
                                                            ; object types
                                                            ; #N$40 to #N$47.
 $92AA DEFW $DEE8,$DEE8,$DEE8,$DEE8,$DF15,$DF15,$DF15,$DF15 ; Handlers for the
                                                            ; object types
                                                            ; #N$48 to #N$4F.
 $92BA DEFW $DF98,$E027,$E027,$E027,$AF3F,$E622,$E622,$E622 ; Handlers for the
                                                            ; object types
                                                            ; #N$50 to #N$57.
 $92CA DEFW $E117,$E117,$E117,$E117,$E2CB,$E2CB,$E2CB,$E2CB ; Handlers for the
                                                            ; object types
                                                            ; #N$58 to #N$5F.
 $92DA DEFW $E570,$E570,$E570,$E570,$E751,$E751,$E751,$E751 ; Handlers for the
                                                            ; object types
                                                            ; #N$60 to #N$67.
 $92EA DEFW $E8D7,$E8D7,$E8D7,$E8D7,$EA9C,$EA9C,$EA9C,$EA9C ; Handlers for the
                                                            ; object types
                                                            ; #N$68 to #N$6F.
 $92FA DEFW $EA7D,$EA7D,$E18C,$E18C,$EAF9,$EAF9,$EAF9,$EAF9 ; Handlers for the
                                                            ; object types
                                                            ; #N$70 to #N$77.
 $930A DEFW $EAF9,$EB39,$EB39,$EB39,$EB39,$EB39,$EB39,$E751 ; Handlers for the
                                                            ; object types
                                                            ; #N$78 to #N$7F.
 $931A DEFW $ECCA,$ECCA,$ECCA,$ECCA,$ECCA,$ECCA,$ECCA,$ECCA ; Handlers for the
                                                            ; object types
                                                            ; #N$80 to #N$87.
 $932A DEFW $ED2E,$A0AC,$A0C5,$A107                         ; Handlers for the
                                                            ; object types
                                                            ; #N$88 to #N$8B.

; Sprite Address Table
;
; The address of the data of each sprite, indexed by the sprite id (which
; is also the type of the object). Several ids share the same sprite data; they
; are drawn with different attributes or by different handlers.
@label=Sprite_Address_Table
w$9332 DEFW $C3DB,$C4F7,$C529,$C55B,$C529,$C6A7,$C6D9,$C70B ; Sprites #N$00 to
                                                            ; #N$07.
 $9342 DEFW $C6D9,$C3DD,$C40B,$C439,$C40B,$C58D,$C5BB,$C5E9 ; Sprites #N$08 to
                                                            ; #N$0F.
 $9352 DEFW $C5BB,$C467,$C491,$C617,$C641,$C4C5,$C675,$C3DB ; Sprites #N$10 to
                                                            ; #N$17.
 $9362 DEFW $C73D,$C76F,$C798,$C7CA,$CC89,$CCE5,$CD44,$CDA0 ; Sprites #N$18 to
