@label=GameSelection_Attributes
b$9119 DEFB $42      ; {Lines 1 to 5.
 $911A DEFB $43      ;
 $911B DEFB $44      ;
 $911C DEFB $45      ;
 $911D DEFB $46      ; }
 $911E DEFB $47      ; Not used.
