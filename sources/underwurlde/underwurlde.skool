; Game Options
;
; The options that were chosen on the game selection screen (see
; #R$9052). Only the low two bits are used, as there is only one player. They
; are the controls that #R$AE17 reads:
; #TABLE(default,centre,left)
; { =h Bits 0-1 | =h Controls }
; { #N$00 | Keyboard }
; { #N$01 | Kempston Joystick }
; { #N$02 | Cursor Joystick }
; { #N$03 | Interface II Joystick }
; TABLE#
@label=GameOptions
g$8ED5 DEFB $00
; View the equivalent code in;
; #LIST
; { #ATICATAC$5E00 }
; { #COOKIE$5F0C }
; { #JETPAC$5CF3 }
; { #LUNARJETMAN$5E00 }
; { #PSSST$5E03 }
; { #SABREWULF$9692 }
; { #TRANZAM$5E3E }
; LIST#

; Game Timer
;
; The game timer. It is incremented by #R$9459 each time every object
; record has been handled. The low bits of the counter time many of the game's
; events, for example the gem timer, the animation of the creatures and the
; release of new creatures.
@label=GameTimer
g$8ED6 DEFW $0000

; Unused
;
; Cleared when the game starts. The game does not use it.
@label=Unused_After_Tick_Counter
u$8ED8 DEFB $00,$00

; Lives
;
; The number of lives that Sabreman has left, held as a BCD value. It is
; set to #N$06 on the game selection screen, goes up by one when Sabreman
; collects an extra life (type #N$7F) and goes down by one when he dies.
@label=PlayerLives
g$8EDA DEFB $00

; Saved Position
;
; Holds Sabreman's x position and room x (the two bytes of #R$8EDB), and
; his y position and room y (the two bytes of #R$8EDD), while #R$E7E3 resets his
; object record after he has lost a life. The values are then put back, so he
; restarts where he died.
@label=Saved_Position
g$8EDB DEFW $0000
@label=Saved_Position_Y
 $8EDD DEFW $0000

; Last Frame
;
; The last value of the system variable FRAMES (#N$5C78) that #R$9459 saw.
; When FRAMES has changed, the priority objects are handled.
@label=LastFrame
g$8EDF DEFW $0000

; Previous Sprite Id
;
; The sprite id of the object that #R$989F last saved. #R$9657 uses it,
; with the saved position, to find the sprite that has to be erased.
@label=Previous_Sprite_Id
g$8EE1 DEFB $00

; Old Sprite Row Count
;
; The number of rows of the old sprite that the sprite routines have still
; to draw (see #R$9728). It is set up by #R$9657.
@label=Old_Sprite_Row_Count
g$8EE2 DEFB $00

; New Sprite Row Count
;
; The number of rows of the new sprite that the sprite routines have still
; to draw (see #R$9728). It is set up by #R$9689.
@label=New_Sprite_Row_Count
g$8EE3 DEFB $00

; Previous X Position
;
; The x position of the object that #R$989F last saved.
@label=Previous_X_Position
g$8EE4 DEFB $00

; Previous Y Position
;
; The y position of the object that #R$989F last saved.
@label=Previous_Y_Position
g$8EE5 DEFB $00

; New Sprite Width
;
; The number of character cells that each row of the new sprite covers. It
; is one more than the width of the sprite in bytes when the sprite is not
; aligned to a character boundary. It is set up by #R$9689 and used by #R$9867.
@label=New_Sprite_Width
g$8EE6 DEFB $00

; New Sprite Height
;
; The height in pixel lines of the new sprite. It is set up by #R$9689 and
; used by #R$9867.
@label=New_Sprite_Height
g$8EE7 DEFB $00

; Menu Item Attribute
;
; The attribute that #R$91B0 gives to the characters that it prints.
@label=Current_MenuAttribute
g$8EE8 DEFB $00

; Action Key Held Flag
;
; Set to #N$FF while one of the action keys (SPACE, SYMBOL SHIFT, M, N and
; B) is held down and set to #N$00 when none is. #R$9459 maintains it.
@label=Action_Key_Held_Flag
g$8EE9 DEFB $00

; New Action Key Press Flag
;
; Set to #N$FF for one pass of the main loop when one of the action keys
; is first pressed, and to #N$00 otherwise. The handlers of the weapons
; (#R$E8D7) use it to pick up a weapon, move it along the weapon slots or drop
; it, and set it to #N$FE once they have used it.
@label=New_Action_Key_Press_Flag
g$8EEA DEFB $00

; Weapon Slots
;
; The type of the weapon (#N$68 to #N$6B) that Sabreman carries in each of
; three slots, or #N$00 for an empty slot. #R$9459 empties the slots when an
; action key is first pressed and the handlers of the carried weapons (#R$E8D7)
; fill them in again. #R$B4D1 throws the first weapon that it finds.
@label=Weapon_Slots
g$8EEB DEFB $00      ; The first slot.
@label=Weapon_Slots_Second
 $8EEC DEFB $00      ; The second slot.
 $8EED DEFB $00      ; The third slot.

; Gem Timer
;
; A BCD value that is printed next to the word GEMS. It is set to #N$50
; when Sabreman collects a gem (see #R$E751), which also turns him cyan, and
; #R$9459 reduces it by one every fourth tick. While it is not zero Sabreman
; survives landing after a long fall (see #R$A8A0) and a falling
; stalactite does not hurt him (see #R$E825(#N$E83B)). When it reaches zero he
; turns white again.
@label=Gem_Timer
g$8EEE DEFB $00

; Depth
;
; The depth of the room that Sabreman is in, held as a BCD value and
; printed by #R$9E58.
@label=Depth
g$8EEF DEFB $00

; Room Redrawn Flag
;
; Set to a non-zero value by #R$9906 when a room has been drawn and
; cleared at the end of the next pass of the main loop (see #R$9459).
@label=Room_Redrawn_Flag
g$8EF0 DEFB $00

; Type 5C Active Flag
;
; Set to #N$01 by the handler for the object types #N$5C to #N$5F
; (#R$E2CB) each time it runs. #R$9459 copies it to #R$8EF2 and clears it at the
; end of every pass.
@label=Type_5C_Active_Flag
g$8EF1 DEFB $00

; Previous Type 5C Active Flag
;
; Holds the value of #R$8EF1 from the last complete pass of the main loop.
; It is also set by #R$B079 when an object changes into type #N$5C. #R$E570
; reads it.
@label=Previous_Type_5C_Active_Flag
g$8EF2 DEFB $00

; Score
;
; The score, held as six BCD digits in three bytes. #R$A045 adds to it and
; prints it.
@label=Score
g$8EF3 DEFB $00      ; The high byte (the two highest digits).
 $8EF4 DEFB $00      ; The middle byte.
@label=Score_Low_Byte
 $8EF5 DEFB $00      ; The low byte (the two lowest digits).

; Sound Counter
;
; Incremented by #R$A087 each time it is called, to alternate the pitch of
; the tones that it plays.
@label=Sound_Counter
g$8EF6 DEFB $00

; Menu Icons Drawn
;
; Set to #N$01 once #R$95A3 has drawn the icons on the game selection
; screen.
@label=Menu_Icons_Drawn
g$8EF7 DEFB $00

; Completion Percentage
;
; The percentage of the Underwurlde that has been explored, held as a BCD
; value. #R$9FA3 works it out and prints it.
@label=Completion_Percentage
g$8EF8 DEFB $00

; Creature Spawn Flag
;
; Set to #N$01 by #R$ECCA(#N$ED10). #R$AFDA tests it when it decides how a
; new flying creature enters the room.
@label=Creature_Spawn_Flag
g$8EF9 DEFB $00

; Object Records
;
; Nineteen records of #N$10 bytes each. #R$91C0 works through them one by
; one, using byte #N$00 of each record (the type of the object, which is also
; its sprite id) as an index into the handler table at #R$921A. A type of #N$00
; marks a record that is not in use.
; .
; The first two records are the weapons that Sabreman throws. They are handled
; only as priority records (see #R$9459). The third record is Sabreman. #R$A3DD
; fills it in using the template at #R$AA3C.
; .
; Some of the other records have fixed uses: the fourth is the rope (type #N$17,
; which #R$AE81 sets up when the room has a rope) and the fifth is a falling
; stalactite (see #R$DF58).
; .
; #TABLE(default,centre,centre)
; { =h Byte | =h Contents }
; { #N$00 | Type of the object (the sprite id) }
; { #N$01 | X position }
; { #N$02 | Room x }
; { #N$03 | Y position }
; { #N$04 | Room y }
; { #N$05 | Attribute }
; { #N$06-#N$0F | Used differently by each type of handler }
; TABLE#
; Most handlers use bit 0 of byte #N$0F (or of byte #N$07) as a flag to say
; that the sprite has no old image to erase (see #R$96CB). Byte #N$09 is
; often a vertical speed and bytes #N$0A and #N$0D are often the fractions of
; the x and y positions.
@label=Object_Records
g$8EFA DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00     ; Record 0:
                                                                            ; the first
                                                                            ; thrown
                                                                            ; weapon.
@label=First_Weapon_Redraw_Flags
 $8F09 DEFB $00                                                             ; Record 0:
                                                                            ; the redraw
                                                                            ; flags.
@label=Second_Weapon_Record
 $8F0A DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00 ; Record 1:
                                                                            ; the second
                                                                            ; thrown
                                                                            ; weapon.
@label=Sabreman_Record
 $8F1A DEFB $00                                                             ; Record 2:
                                                                            ; the sprite
                                                                            ; id of
                                                                            ; Sabreman.
@label=Sabreman_X_Position
 $8F1B DEFB $00                                                             ; The x
                                                                            ; position
                                                                            ; of
                                                                            ; Sabreman.
@label=Sabreman_Room_X
 $8F1C DEFB $00                                                             ; The room x
                                                                            ; of
                                                                            ; Sabreman.
@label=Sabreman_Y_Position
 $8F1D DEFB $00                                                             ; The y
                                                                            ; position
                                                                            ; of
                                                                            ; Sabreman.
@label=Sabreman_Room_Y
 $8F1E DEFB $00                                                             ; The room y
                                                                            ; of
                                                                            ; Sabreman.
@label=Sabreman_Attribute
 $8F1F DEFB $00                                                             ; The
                                                                            ; attribute
                                                                            ; of
                                                                            ; Sabreman.
@label=Sabreman_X_Velocity
 $8F20 DEFB $00                                                             ; The x
                                                                            ; velocity
                                                                            ; of
                                                                            ; Sabreman.
 $8F21 DEFB $00                                                             ; Byte
                                                                            ; #N$07.
@label=Sabreman_Carried_X_Position
 $8F22 DEFB $00                                                             ; Byte
                                                                            ; #N$08,
                                                                            ; where an
                                                                            ; eagle puts
                                                                            ; the x
                                                                            ; position
                                                                            ; of
                                                                            ; Sabreman.
@label=Sabreman_Carried_Y_Position
 $8F23 DEFB $00                                                             ; Byte
                                                                            ; #N$09,
                                                                            ; where an
                                                                            ; eagle puts
                                                                            ; the y
                                                                            ; position
                                                                            ; of
                                                                            ; Sabreman.
 $8F24 DEFB $00                                                             ; Byte
                                                                            ; #N$0A.
@label=Sabreman_Contact_Flags
 $8F25 DEFB $00                                                             ; The
                                                                            ; contact
                                                                            ; flags of
                                                                            ; Sabreman.
 $8F26 DEFB $00,$00,$00                                                     ; Bytes
                                                                            ; #N$0C to
                                                                            ; #N$0E.
@label=Sabreman_Redraw_Flags
 $8F29 DEFB $00                                                             ; The redraw
                                                                            ; flags of
                                                                            ; Sabreman.
@label=Rope_Record
 $8F2A DEFB $00,$00,$00,$00,$00,$00                                         ; Record 3:
                                                                            ; the rope.
@label=Rope_X_Velocity
 $8F30 DEFB $00                                                             ; The x
                                                                            ; velocity
                                                                            ; of the
