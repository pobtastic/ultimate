; the text, which ends with a character that has bit 7 set.
@label=GameSelection_Title
t$9195 DEFB $47                                 ; Attribute:
                                                ; #COLOUR(#PEEK(#PC)).
 $9196 DEFM "UNDERWURLDE GAME SELECTIO","N"+$80 ; "UNDERWURLDE GAME SELECTION"
