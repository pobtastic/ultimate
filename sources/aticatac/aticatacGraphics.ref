[Sprites:Knight]
#UDGTABLE(default,centre,centre,centre,centre,centre,centre,centre,centre)
  { =h,c2 Frame 1 | =h,c2 Frame 2 | =h,c2 Frame 3 | =h,c2 Frame 4 }
  { =h,c8 Left }
  { #N$00 | #SPRITE$00,attr=$47(knight-left-01-colour*) | #N$01 | #SPRITE$01,attr=$47(knight-left-02-colour*) | #N$02 | #SPRITE$02,attr=$47(knight-left-03-colour*) | #N$03 | #SPRITE$03,attr=$47(knight-left-04-colour*) }
  { =h,c8 Right }
  { #N$04 | #SPRITE$04,attr=$47(knight-right-01-colour*) | #N$05 | #SPRITE$05,attr=$47(knight-right-02-colour*) | #N$06 | #SPRITE$06,attr=$47(knight-right-03-colour*) | #N$07 | #SPRITE$07,attr=$47(knight-right-04-colour*) }
  { =h,c8 Up }
  { #N$08 | #SPRITE$08,attr=$47(knight-up-01-colour*) | #N$09 | #SPRITE$09,attr=$47(knight-up-02-colour*) | #N$0A | #SPRITE$0A,attr=$47(knight-up-03-colour*) | #N$0B | #SPRITE$0B,attr=$47(knight-up-04-colour*) }
  { =h,c8 Down }
  { #N$0C | #SPRITE$0C,attr=$47(knight-down-01-colour*)  | #N$0D | #SPRITE$0D,attr=$47(knight-down-02-colour*) | #N$0E | #SPRITE$0E,attr=$47(knight-down-03-colour*) | #N$0F | #SPRITE$0F,attr=$47(knight-down-04-colour*) }
UDGTABLE#

