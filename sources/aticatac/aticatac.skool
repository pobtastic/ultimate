; LIST#

; Game Selection Screen Text
;
; The text of each of the seven menu lines. Each string ends with a
; character that has bit 7 set, which tells #R$A1F3 where it finishes.
@label=GameSelection_Text
t$7CF8 DEFM "1  KEYBOAR","D"+$80          ; "1  KEYBOARD".
 $7D03 DEFM "2  KEMPSTON JOYSTIC","K"+$80 ; "2  KEMPSTON JOYSTICK".
 $7D17 DEFM "3  CURSOR   JOYSTIC","K"+$80 ; "3  CURSOR   JOYSTICK".
 $7D2B DEFM "4  KNIGH","T"+$80            ; "4  KNIGHT".
 $7D34 DEFM "5  WIZAR","D"+$80            ; "5  WIZARD".
 $7D3D DEFM "6  SER","F"+$80              ; "6  SERF".
 $7D44 DEFM "0  START GAM","E"+$80        ; "0  START GAME".
; View the equivalent code in;
; #LIST
; { #COOKIE$636C }
; { #JETPAC$6299 }
; { #LUNARJETMAN$811C }
; { #PSSST$6288 }
; { #SABREWULF$B4B0 }
; { #TRANZAM$5FB1 }
; { #UNDERWURLDE$9125 }
; LIST#

; Copyright Messaging
;
; The first byte is the attribute used for the whole message (#COLOUR$47),
; followed by the text, which ends with a character that has bit 7 set. It is
; printed by #R$7CAF.
@label=Message_Copyright
t$7D51 DEFM $47                                      ; {Attribute:
 $7D52 DEFM "%"                                      ; #COLOUR(#PEEK(#PC)) + "©
 $7D53 DEFM "1983 A.C.G. ALL RIGHTS RESERVE","D"+$80 ; 1983 A.C.G. ALL RIGHTS
                                                     ; RESERVED".}
; View the equivalent code in #LUNARJETMAN$818A.
; .
; View the equivalent code in;
; #LIST
; { #UNDERWURLDE$9174 }
; LIST#

; Game Selection Title Text
;
; The first byte is the attribute used for the whole title, followed by
; the text, which ends with a character that has bit 7 set. It is printed by
; #R$7CAF.
@label=GameSelection_Title
t$7D72 DEFM $47                              ; {Attribute: #COLOUR(#PEEK(#PC))
 $7D73 DEFM "ATICATAC GAME SELECTIO","N"+$80 ; + "ATICATAC GAME SELECTION".}
; View the equivalent code in;
; #LIST
; { #UNDERWURLDE$9195 }
; LIST#

; Write Menu Line
;
; Used by the routine at #R$7CAF.
; .
; Prints one line of text for the game selection menu. The screen address
; of the line is worked out in one register set and the attribute address in
; the other, using the attribute held in #R$5E22, and then the text is printed
; by #R$A1FF.
; #PUSHS #POKES$5C78,$34,$02 #POKES$5CB0,$E9
; #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$7C19,stop=$7C2F,clear=1,sp=$5E00)
; #SCR$02,$00,$00,$20,$06(menu-line-before)
; | #POKES$5E22,$45
; #SIM(start=$7D8A,stop=$0000,hl=$1858,de=$7CF8,sp=$5B60)
; #SCR$02,$00,$00,$20,$06(menu-line-after) } UDGTABLE# #POPS
;
; HL The Y position (in #REGh) and X position (in #REGl)
; DE The address of the text
@label=MenuWriteText
c$7D8A PUSH HL       ; Stash the co-ordinates of the line on the stack.
 $7D8B CALL $9BA2    ; Call #R$9BA2 to convert the co-ordinates to a screen
                     ; address.
 $7D8E LD A,($5E22)  ; {Fetch the attribute of the line and keep it in #REGaf'.
 $7D91 EX AF,AF'     ; }
 $7D92 EXX           ; Switch to the shadow registers.
 $7D93 POP HL        ; Restore the co-ordinates of the line from the stack.
 $7D94 CALL $9BD2    ; Call #R$9BD2 to convert the co-ordinates to an attribute
                     ; address.
 $7D97 JP $A1FF      ; Jump to #R$A1FF to print the menu line.
; View the equivalent code in;
; #LIST
; { #COOKIE$63E0 }
; { #LUNARJETMAN$81AB }
; { #PSSST$62E7 }
; { #SABREWULF$B52D }
; { #TRANZAM$5F97 }
; { #UNDERWURLDE$91B0 }
; LIST#

; Start Game
;
; Used by the routine at #R$7C19.
; .
; Prepares a new game: the player data, the screen and side panel,
; the key pieces, the entity table and the doors. Then enters the
; starting room.
;
; .
;
; #PUSHS #POKES$5C78,$34,$02 #POKES$5CB0,$E9 #UDGTABLE {
; #SIM(start=$7D9A,stop=$7DDC,clear=1,sp=$5E00)
; #SCR$02(start-game) } UDGTABLE# #POPS
@label=StartGame
c$7D9A CALL $80CB    ; Call #R$80CB to reset the game data.
; See #POKE(set_starting_lives,Set Starting Lives).
 $7D9D LD A,$03      ; {Write #N$03 (the number of lives at the start of the game) to
 $7D9F LD ($5E21),A  ; #R$5E21.}
 $7DA2 LD HL,$EB58   ; {Set the food pointer in #R$5E55 to #R$EB58.
 $7DA5 LD ($5E55),HL ; }
 $7DA8 CALL $80AA    ; Call #R$80AA to clear the screen.
 $7DAB CALL $A219    ; Call #R$A219 to draw the side panel.
 $7DAE CALL $A2CE    ; Call #R$A2CE to display the lives.
 $7DB1 CALL $94B6    ; Call #R$94B6 to place the key pieces.
 $7DB4 CALL $98D2    ; Call #R$98D2 to set the positions of the keys.
 $7DB7 CALL $8D61    ; Call #R$8D61 to reset the game state.
 $7DBA CALL $94F5    ; Call #R$94F5 to randomise the doors.
 $7DBD CALL $9443    ; Call #R$9443 to prepare the player.
 $7DC0 JP $9147      ; Jump to #R$9147 to enter the room.
; View the equivalent code in;
; #LIST
; { #COOKIE$6428 }
; { #JETPAC$6333 }
; { #LUNARJETMAN$81BB }
; { #PSSST$632D }
; { #TRANZAM$5FEF }
; LIST#

; Run Main Loop
;
; Used by the routines at #R$7E23 and #R$9147.
; .
; Runs the game one entity at a time. Whenever FRAMES has changed
; since the last time, #R$7EB2 runs the handlers of the three fixed
; entities starting at #R$EA90. Each entity from #R$EAA8 onwards that
; is in the same room as the player is then given to #R$7E7E, and
; every 16-byte record from #R$EE60 onwards after that. Finally the
; room items are processed by #R$7E23.
; If the room has not been drawn yet (bit 0 of #R$5E14 is clear) the
; entities are skipped and #R$7E23 is run immediately.
@label=MainLoop
c$7DC3 LD SP,$5E00   ; Set stack pointer to #N$5E00.
 $7DC6 EI            ; Enable interrupts.
 $7DC7 XOR A         ; {Reset the number of creatures in #R$5E25 to zero.
 $7DC8 LD ($5E25),A  ; }
 $7DCB LD IX,$EAA8   ; Point #REGix at the first entity after the three fixed entities at
                     ; #R$EAA8.
 $7DCF LD A,($5E14)  ; {Jump to #R$7DDC if the entities in the room have already been drawn
 $7DD2 BIT 0,A       ; (bit 0 of #R$5E14 is set).
 $7DD4 JR NZ,$7DDC   ; }
 $7DD6 LD IX,$EEE0   ; Point #REGix at the end of the entity table, so that no entities are
                     ; processed at #R$EEE0.
 $7DDA JR $7E23      ; Jump to #R$7E23 to draw the room.
; Each pass of this loop considers one of the 8-byte entities.
@label=MainLoop_Entities
*$7DDC LD A,($5C78)  ; {Fetch the low byte of FRAMES into #REGc (using #REGa).
 $7DDF LD C,A        ; }
 $7DE0 LD A,($5E03)  ; Fetch the FRAMES value from the previous pass.
 $7DE3 CP C          ; {Call #R$7EB2 if FRAMES has changed since it was last stored in
 $7DE4 CALL NZ,$7EB2 ; #R$5E03.}
 $7DE7 LD A,($EA91)  ; Fetch the room of the player.
 $7DEA CP (IX+$01)   ; Compare it with the room of this entity.
 $7DED LD HL,$7DF3   ; Point #REGhl at the address for the handler to return to
                     ; at #R$7DF3.
 $7DF0 JP Z,$7E7E    ; Process the entity with #R$7E7E if it is in the same room as the
                     ; player.
; Move on to the next 8-byte entity.
@label=MainLoop_NextEntity
 $7DF3 LD DE,$0008   ; #REGde=#N($0008,$04,$04) (the size of an entity).
 $7DF6 ADD IX,DE     ; Move #REGix on to the next entity.
 $7DF8 PUSH IX       ; {Copy #REGix to #REGhl (using the stack).
 $7DFA POP HL        ; }
 $7DFB LD DE,$EE60   ; Point #REGde at the end of the 8-byte entities at
                     ; #R$EE60.
 $7DFE AND A         ; {Jump back to #R$7DDC until #REGix reaches #R$EE60.
 $7DFF SBC HL,DE     ;
 $7E01 JR C,$7DDC    ; }
; Now work through the 16-byte records. These are processed no matter
; which room the player is in.
@label=MainLoop_Records
*$7E03 LD A,($5C78)  ; {Fetch the low byte of FRAMES into #REGc (using #REGa).
 $7E06 LD C,A        ; }
 $7E07 LD A,($5E03)  ; Fetch the FRAMES value from the previous pass.
 $7E0A CP C          ; {Call #R$7EB2 if FRAMES has changed since it was last stored in
 $7E0B CALL NZ,$7EB2 ; #R$5E03.}
 $7E0E LD HL,$7E13   ; Point #REGhl at the address for the handler to return to
                     ; at #R$7E13.
 $7E11 JR $7E7E      ; Jump to #R$7E7E to process the record.
@label=MainLoop_NextRecord
 $7E13 LD DE,$0010   ; #REGde=#N($0010,$04,$04) (the size of a record).
 $7E16 ADD IX,DE     ; Move #REGix on to the next record.
 $7E18 PUSH IX       ; {Copy #REGix to #REGhl (using the stack).
 $7E1A POP HL        ; }
 $7E1B LD DE,$EEE0   ; Point #REGde at the end of the entity table at #R$EEE0.
 $7E1E AND A         ; {Jump back to #R$7E03 until #REGix reaches #R$EEE0.
 $7E1F SBC HL,DE     ;
 $7E21 JR C,$7E03    ; }

; Draw Room
;
; Used by the routine at #R$7DC3.
; .
; Reached at the end of every pass of #R$7DC3. Looks up the list of
; items for the current room in #R$757D and runs the handler of each
; one through #R$7E93. Each entry in a list is the address of an item
; record in the initial entity data at #R$600D.
; Once the list is finished the counter at #R$5E12 is incremented and, on
; the first pass, #R$9291 draws all of the entities in the room and bit 0
; of #R$5E14 is set. The random number seed at #R$5E05 is then stirred,
; the pick-up key, the pause keys and the food are dealt with and the main
; loop is restarted, unless the player is in room #N$8E, which ends the game
; with #R$96EC.
;
; .
;
; #PUSHS #POKES$5C78,$34,$02 #POKES$5CB0,$E9
; #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$7D9A,stop=$7DC3,clear=1,sp=$5E00)
; #SCR$01(draw-room-before)
; | #SIM(start=$7DC3,stop=$7DDC,sp=$5E00)
; #SCR$01(draw-room-after) } UDGTABLE# #POPS
@label=DrawRoom
c$7E23 LD A,($EA91)  ; Fetch the room of the player.
 $7E26 LD L,A        ; {Double the room number to create an offset in #REGhl.
 $7E27 LD H,$00      ;
 $7E29 ADD HL,HL     ; }
 $7E2A LD BC,$757D   ; {Find the entry for the room in the table of item lists
 $7E2D ADD HL,BC     ; at #R$757D.}
 $7E2E LD A,(HL)     ; {Fetch the address of the list of items for the room.
 $7E2F INC HL        ;
 $7E30 LD H,(HL)     ;
 $7E31 LD L,A        ; }
 $7E32 LD ($5E1B),HL ; Update the room pointer in #R$5E1B.
; Each pass of this loop reads one item from the list.
@label=Decor_Loop
 $7E35 LD HL,($5E1B) ; Fetch the pointer to the next entry in the list of
                     ; items.
 $7E38 LD A,(HL)     ; Fetch the low byte of the item address.
 $7E39 INC HL        ; {Move on to the next entry in the list and write the pointer to
 $7E3A INC HL        ; #R$5E1B.
 $7E3B LD ($5E1B),HL ; }
 $7E3E DEC HL        ; {Fetch the address of the item.
 $7E3F LD H,(HL)     ;
 $7E40 LD L,A        ; }
 $7E41 OR H          ; {Jump to #R$7E93 to process the item if the list has not ended (the
 $7E42 JR NZ,$7E93   ; item address is not zero).}
; The list is finished (it is terminated by an address of #N$0000).
 $7E44 LD HL,($5E12) ; {Increment the counter held in #R$5E12 by one.
 $7E47 INC HL        ;
 $7E48 LD ($5E12),HL ; }
 $7E4B LD HL,$5E14   ; {Jump to #R$7E55 if bit 0 of #R$5E14 is set (the
 $7E4E BIT 0,(HL)    ; entities are drawn).
 $7E50 JR NZ,$7E55   ; }
 $7E52 CALL $9291    ; Call #R$9291 to draw the entities in this room.
@label=DrawRoom_Finish
*$7E55 LD HL,$5E14   ; {Set bit 0 of #R$5E14.
 $7E58 SET 0,(HL)    ; }
; Stir the random number seed with FRAMES and the counter.
 $7E5A LD HL,($5E05) ; Fetch the random seed.
 $7E5D LD DE,($5C78) ; Fetch FRAMES.
 $7E61 ADD HL,DE     ; Add FRAMES to the random seed.
 $7E62 LD A,($5E12)  ; Fetch the low byte of the counter.
 $7E65 ADD A,L       ; {Add the counter to the random seed.
 $7E66 LD L,A        ; }
 $7E67 LD ($5E05),HL ; Store the new random seed.
; Read the pick-up key, check for the game being paused and spawn food.
 $7E6A CALL $938B    ; Call #R$938B to read the key to pick up an item.
 $7E6D CALL $9489    ; Call #R$9489 to check whether the game is paused.
 $7E70 CALL $9924    ; Call #R$9924 to spawn the food.
; Finish the game if the player has reached the final room.
 $7E73 LD A,($EA91)  ; Fetch the room of the player.
 $7E76 CP $8E        ; {Jump to #R$96EC if the player is in room #N$8E.
 $7E78 JP Z,$96EC    ; }
 $7E7B JP $7DC3      ; Jump back to #R$7DC3 to run the next pass of the main
                     ; loop.

; Process Action
;
; Used by the routine at #R$7DC3.
; .
; Calls the handler of an entity. The handler's address is read from
; #R$7EE6, indexed by the first byte of the entity record, and entered
; through the #N$E9 (JP (HL)) at #N$5CB0. The entry point at #R$7E7F is used
; when the return address has already been stacked, and the one at #R$7E82
; when the table of handlers in #REGhl is not #R$7EE6.
;
; IX The entity
; HL The address for the handler to return to
@label=ProcessAction
c$7E7E PUSH HL       ; Stash the return address on the stack.
; This entry point is used by the routine at #R$7EB2.
@label=ProcessAction_Dispatch
*$7E7F LD HL,$7EE6   ; Point #REGhl at the handler table at #R$7EE6.
; This entry point is used by the routine at #R$7E93.
; .
; Double the first byte of the entity to create an offset in #REGbc.
@label=ProcessAction_Lookup
*$7E82 LD C,(IX+$00) ; Fetch the first byte of the entity, which is its sprite
                     ; ID.
; This entry point is used by the routine at #R$9962.
@label=ProcessAction_Offset
*$7E85 LD B,$00      ; #REGb=#N$00.
 $7E87 SLA C         ; {Double #REGbc, which gives two bytes for each sprite
 $7E89 RL B          ; ID.}
 $7E8B ADD HL,BC     ; Find the entry for the entity in the handler table.
 $7E8C LD A,(HL)     ; {Fetch the address of the handler.
 $7E8D INC HL        ;
 $7E8E LD H,(HL)     ;
 $7E8F LD L,A        ; }
 $7E90 JP $5CB0      ; Jump to the handler, using the #N$E9 (JP (HL)) at
                     ; #N$5CB0.

; Process Room Item
;
; Used by the routine at #R$7E23.
; .
; Runs the handler of one of the items in a room's list (see
; #R$7E23). The list entry is the address of the item in the initial
; entity data; subtracting #N$757D converts it to the address of the
; live record. Door records are two 8-byte halves (one for each of the
; two rooms they join), so the second half is used if the first is not
; for the current room. The handler is looked up in #R$802A and returns
; to #R$7E35.
;
; HL The list entry
@label=ProcessRoomItem
c$7E93 LD BC,$7E35   ; {Stash #R$7E35 on the stack as the address for the handler to return
 $7E96 PUSH BC       ; to.}
 $7E97 LD BC,$757D   ; {Subtract #N$757D from the address of the item to get the address of
 $7E9A AND A         ; the live record.
 $7E9B SBC HL,BC     ; }
 $7E9D PUSH HL       ; {Copy #REGhl to #REGix (using the stack).
 $7E9E POP IX        ; }
 $7EA0 LD A,($EA91)  ; Fetch the room of the player.
 $7EA3 CP (IX+$01)   ; {Jump to #R$7EAD if the item is in the same room as the
 $7EA6 JR Z,$7EAD    ; player.}
 $7EA8 LD BC,$0008   ; {Move #REGix on to the second half of the record (#N$08
 $7EAB ADD IX,BC     ; bytes on).}
@label=ProcessRoomItem_Dispatch
*$7EAD LD HL,$802A   ; Point #REGhl at the handler table 2 at #R$802A.
 $7EB0 JR $7E82      ; Jump to #R$7E82 to turn the first byte of the entity
                     ; into an offset.

; Update Fixed Entities
;
; Used by the routine at #R$7DC3.
; .
; Called whenever FRAMES has changed. Runs the handlers of the three
; entities at #R$EA90, ticks the clock with #R$95DA and records the
; new value of FRAMES in #R$5E03. #R$5E04 is set while the handlers
; are running.
@label=UpdateFixedEntities
c$7EB2 DI            ; Disable interrupts.
 $7EB3 PUSH IX       ; Stash #REGix on the stack.
 $7EB5 LD A,$01      ; {Set the flag in #R$5E04 that shows the handlers are
 $7EB7 LD ($5E04),A  ; running.}
 $7EBA LD IX,$EA90   ; Point #REGix at the player at #R$EA90.
@label=UpdateFixedEntities_Loop
*$7EBE LD HL,$7EC5   ; Point #REGhl at the address for the handler to return to
                     ; at #R$7EC5.
 $7EC1 PUSH HL       ; Stash the return address on the stack.
 $7EC2 JP $7E7F      ; Jump to #R$7E7F to run the handler.
@label=UpdateFixedEntities_Next
 $7EC5 LD DE,$0008   ; #REGde=#N($0008,$04,$04) (the size of an entity).
 $7EC8 ADD IX,DE     ; Move #REGix on to the next entity.
 $7ECA PUSH IX       ; {Copy #REGix to #REGhl (using the stack).
 $7ECC POP HL        ; }
 $7ECD LD DE,$EAA8   ; Point #REGde at the end of the fixed entities at
                     ; #R$EAA8.
 $7ED0 AND A         ; {Loop back to #R$7EBE until all three entities are done.
 $7ED1 SBC HL,DE     ;
 $7ED3 JR C,$7EBE    ; }
 $7ED5 CALL $95DA    ; Call #R$95DA to update the clock.
 $7ED8 LD A,($5C78)  ; {Write FRAMES to #R$5E03.
 $7EDB LD ($5E03),A  ; }
 $7EDE XOR A         ; {Clear the flag in #R$5E04 that shows the handlers are
 $7EDF LD ($5E04),A  ; running.}
 $7EE2 POP IX        ; Restore #REGix from the stack.
 $7EE4 EI            ; Enable interrupts.
 $7EE5 RET           ; Return.

; Handler Table
;
; The address of the handler for each kind of 8-byte entity record,
; indexed by the first byte of the record (the sprite ID, see
; #R$A4BE). #R$7E7E reads the entry and calls the handler. The same handler is
; shared by all of the sprites of one kind of entity, so the knight sprites all
; point to #R$8E26, and so on. Entries that no entity uses point to #R$807A,
; which does nothing.
@label=HandlerTable
w$7EE6 DEFW $807A    ; ID #N$00 (no sprite): #R(#PEEK(#PC) + #PEEK(#PC + $01) *
                     ; $100).
 $7EE8 DEFW $8E26    ; ID #N((#PC - $7EE6) / $02)
                     ; (#SPRITENAME((#PC - $7EE6) / $02 - $01)):
                     ; #R(#PEEK(#PC) + #PEEK(#PC + $01) * $100).
 $7EEA DEFW $8E26    ; ID #N((#PC - $7EE6) / $02)
                     ; (#SPRITENAME((#PC - $7EE6) / $02 - $01)):
                     ; #R(#PEEK(#PC) + #PEEK(#PC + $01) * $100).
 $7EEC DEFW $8E26    ; ID #N((#PC - $7EE6) / $02)
                     ; (#SPRITENAME((#PC - $7EE6) / $02 - $01)):
                     ; #R(#PEEK(#PC) + #PEEK(#PC + $01) * $100).
 $7EEE DEFW $8E26    ; ID #N((#PC - $7EE6) / $02)
                     ; (#SPRITENAME((#PC - $7EE6) / $02 - $01)):
                     ; #R(#PEEK(#PC) + #PEEK(#PC + $01) * $100).
 $7EF0 DEFW $8E26    ; ID #N((#PC - $7EE6) / $02)
                     ; (#SPRITENAME((#PC - $7EE6) / $02 - $01)):
                     ; #R(#PEEK(#PC) + #PEEK(#PC + $01) * $100).
 $7EF2 DEFW $8E26    ; ID #N((#PC - $7EE6) / $02)
                     ; (#SPRITENAME((#PC - $7EE6) / $02 - $01)):
                     ; #R(#PEEK(#PC) + #PEEK(#PC + $01) * $100).
 $7EF4 DEFW $8E26    ; ID #N((#PC - $7EE6) / $02)
                     ; (#SPRITENAME((#PC - $7EE6) / $02 - $01)):
                     ; #R(#PEEK(#PC) + #PEEK(#PC + $01) * $100).
 $7EF6 DEFW $8E26    ; ID #N((#PC - $7EE6) / $02)
                     ; (#SPRITENAME((#PC - $7EE6) / $02 - $01)):
                     ; #R(#PEEK(#PC) + #PEEK(#PC + $01) * $100).
 $7EF8 DEFW $8E26    ; ID #N((#PC - $7EE6) / $02)
                     ; (#SPRITENAME((#PC - $7EE6) / $02 - $01)):
                     ; #R(#PEEK(#PC) + #PEEK(#PC + $01) * $100).
 $7EFA DEFW $8E26    ; ID #N((#PC - $7EE6) / $02)
                     ; (#SPRITENAME((#PC - $7EE6) / $02 - $01)):
                     ; #R(#PEEK(#PC) + #PEEK(#PC + $01) * $100).
 $7EFC DEFW $8E26    ; ID #N((#PC - $7EE6) / $02)
                     ; (#SPRITENAME((#PC - $7EE6) / $02 - $01)):
                     ; #R(#PEEK(#PC) + #PEEK(#PC + $01) * $100).
 $7EFE DEFW $8E26    ; ID #N((#PC - $7EE6) / $02)
                     ; (#SPRITENAME((#PC - $7EE6) / $02 - $01)):
                     ; #R(#PEEK(#PC) + #PEEK(#PC + $01) * $100).
 $7F00 DEFW $8E26    ; ID #N((#PC - $7EE6) / $02)
                     ; (#SPRITENAME((#PC - $7EE6) / $02 - $01)):
                     ; #R(#PEEK(#PC) + #PEEK(#PC + $01) * $100).
