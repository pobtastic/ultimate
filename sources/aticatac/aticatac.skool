; Room Shape #N$01 Lines
;
; The lines that join the corners of the frame of room shape #N$01 (see
; #R$A982). Each list has the corner to start from, followed by the corners to
; draw lines to, and ends with #N$FF. The last byte is #N$FF to end all of the
; lists, and the corners are those at #R$AA04.
@label=RoomShape_01_Lines
b$AA78 DEFB $00,$2F,$31,$39,$FF ; Start at corner #N$00 and draw lines to corners #N$2F, #N$31 and
                                ; #N$39.
 $AA7D DEFB $01,$FF             ; Corner #N$01 has no lines to draw.
 $AA7F DEFB $02,$FF             ; Corner #N$02 has no lines to draw.
 $AA81 DEFB $03,$01,$04,$20,$FF ; Start at corner #N$03 and draw lines to corners #N$01, #N$04 and
                                ; #N$20.
 $AA86 DEFB $04,$FF             ; Corner #N$04 has no lines to draw.
 $AA88 DEFB $05,$06,$08,$04,$FF ; Start at corner #N$05 and draw lines to corners #N$06, #N$08 and
                                ; #N$04.
 $AA8D DEFB $06,$FF             ; Corner #N$06 has no lines to draw.
 $AA8F DEFB $07,$06,$08,$0B,$FF ; Start at corner #N$07 and draw lines to corners #N$06, #N$08 and
                                ; #N$0B.
