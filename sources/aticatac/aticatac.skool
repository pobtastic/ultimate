; For each square there are two lists, which each have the corner to start from
; followed by the corners to draw lines to, ending with #N$FF. The last byte is
; #N$FF to end all of the lists.
@label=TunnelFrameLines
b$9809 DEFB $00,$01,$03,$FF
 $980D DEFB $02,$01,$03,$FF
 $9811 DEFB $04,$05,$07,$FF
 $9815 DEFB $06,$05,$07,$FF
 $9819 DEFB $08,$09,$0B,$FF
 $981D DEFB $0A,$09,$0B,$FF
 $9821 DEFB $0C,$0D,$0F,$FF
 $9825 DEFB $0E,$0D,$0F,$FF
 $9829 DEFB $10,$11,$13,$FF
 $982D DEFB $12,$11,$13,$FF
 $9831 DEFB $14,$15,$17,$FF
 $9835 DEFB $16,$15,$17,$FF
 $9839 DEFB $18,$19,$1B,$FF
 $983D DEFB $1A,$19,$1B,$FF
 $9841 DEFB $1C,$1D,$1F,$FF
 $9845 DEFB $1E,$1D,$1F,$FF
 $9849 DEFB $20,$21,$23,$FF
 $984D DEFB $22,$21,$23,$FF
 $9851 DEFB $24,$25,$27,$FF
 $9855 DEFB $26,$25,$27,$FF
 $9859 DEFB $28,$29,$2B,$FF
 $985D DEFB $2A,$29,$2B,$FF
 $9861 DEFB $2C,$2D,$2F,$FF
 $9865 DEFB $2E,$2D,$2F,$FF
 $9869 DEFB $FF

; Set Player Velocity
;
; Used by the routine at #R$9117.
; .
; Sets the velocities of the player (offsets #N$06 and #N$07) from bits
; 6-7 of the attribute of a door, using #R$9883. This is done by #R$9117 so that
; the player moves out of the door.
;
; IX The door entity
@label=SetPlayerVelocity
c$986A LD A,(IX+$05) ; Fetch the attribute of the door.
 $986D RLCA          ; {Rotate #REGa left three times.
 $986E RLCA          ;
 $986F RLCA          ; }
 $9870 AND %00000110 ; Keep only bits 1-2, which were bits 6-7.
 $9872 LD C,A        ; Keep the velocity index in #REGc.
 $9873 LD B,$00      ; #REGb=#N$00.
 $9875 LD HL,$9883   ; Point #REGhl at the door velocities at #R$9883.
 $9878 ADD HL,BC     ; Find the velocities for the door in the table.
 $9879 LD A,(HL)     ; Fetch the X velocity.
 $987A INC HL        ; Move #REGhl on to the next byte.
 $987B LD ($EA96),A  ; Update the X velocity of the player (offset #N$06).
 $987E LD A,(HL)     ; Fetch the Y velocity.
 $987F LD ($EA97),A  ; Update the Y velocity of the player (offset #N$07).
 $9882 RET           ; Return.

; Door Velocities
;
; The velocities for the player when it comes out of a door, for each of
; the values of bits 6-7 of the attribute of the door (see #R$986A).
; #TABLE(default,centre,centre,centre)
; { =h Bits 6-7 | =h X Velocity | =h Y Velocity }
; { #N$00 | #N$00 | #N$20 }
; { #N$01 | #N$E0 | #N$00 }
; { #N$02 | #N$00 | #N$E0 }
; { #N$03 | #N$20 | #N$00 }
; TABLE#
@label=DoorVelocities
b$9883 DEFB $00,$20
 $9885 DEFB $E0,$00
 $9887 DEFB $00,$E0
 $9889 DEFB $20,$00

; Handle Mushroom
;
; The handler for the mushroom (sprite ID #N$A1). While the player is
; touching it (see #R$90FB), the energy in #R$5E28 is decreased by one every
; frame, the chicken is drawn again with #R$8B8A and a sound is made with
; #R$A3E5. When the energy reaches zero the mushroom is removed by #R$98C8. The
; attribute of the mushroom cycles round the colours in #R$98C4, changing every
; fourth frame (using offset #N$06), and the attributes are set by #R$92E0.
;
; IX The mushroom entity
@label=HandlerMushroom
c$988B CALL $9FFB    ; Call #R$9FFB to save the position of the mushroom.
 $988E CALL $90FB    ; Call #R$90FB to see whether the player is touching the
                     ; mushroom.
 $9891 JR C,$98B1    ; Jump to #R$98B1 if it is.
@label=HandlerMushroom_Colour
*$9893 LD A,($5E12)  ; Fetch the counter from #R$5E12.
 $9896 CPL           ; Flip the bits.
 $9897 AND %00000011 ; Keep only bits 0-1.
 $9899 JR NZ,$989E   ; Jump to #R$989E unless this is every fourth frame.
 $989B INC (IX+$06)  ; Increment offset #N$06 of the mushroom.
@label=HandlerMushroom_Attribute
*$989E LD A,(IX+$06) ; #REGa=offset #N$06 of the mushroom.
 $98A1 AND %00000011 ; Keep only bits 0-1.
 $98A3 LD C,A        ; Keep the index in #REGc.
 $98A4 LD B,$00      ; #REGb=#N$00.
 $98A6 LD HL,$98C4   ; Point #REGhl at the mushroom attributes at #R$98C4.
 $98A9 ADD HL,BC     ; Add #REGbc to #REGhl.
 $98AA LD A,(HL)     ; Fetch the attribute.
 $98AB LD (IX+$05),A ; Update the attribute of the mushroom.
 $98AE JP $92E0      ; Jump to #R$92E0 to set the attributes of the item.
; The player is touching the mushroom, so decrease the energy.
@label=HandlerMushroom_Touching
*$98B1 LD A,($5E28)  ; Fetch the energy of the player from #R$5E28.
; See #POKE(infinite_energy,Infinite Energy).
 $98B4 DEC A         ; Decrease it by one.
 $98B5 LD ($5E28),A  ; Update the energy of the player in #R$5E28.
 $98B8 JP Z,$98C8    ; Jump to #R$98C8 if the energy is zero.
 $98BB CALL $8B8A    ; Call #R$8B8A to draw the chicken.
 $98BE CALL $A3E5    ; Call #R$A3E5 to make the sound of touching.
 $98C1 JP $9893      ; Jump to #R$9893 to colour the mushroom.

; Mushroom Attributes
;
; The attributes that the mushroom cycles through (see #R$988B).
; #TABLE(default,centre,left)
; { =h Value | =h Colour }
; { #N$42 | #COLOUR$42 }
; { #N$43 | #COLOUR$43 }
; { #N$46 | #COLOUR$46 }
; { #N$43 | #COLOUR$43 }
; TABLE#
@label=MushroomAttributes
b$98C4 DEFB $42
 $98C5 DEFB $43
 $98C6 DEFB $46
 $98C7 DEFB $43

; Remove Mushroom
;
; Used by the routine at #R$988B.
; .
; Used by #R$988B when the player has no energy left. The mushroom is
; removed and a life is lost with #R$8EA0.
;
; IX The mushroom entity
@label=RemoveMushroom
c$98C8 CALL $9F56      ; Call #R$9F56 to remove the mushroom.
 $98CB LD (IX+$00),$00 ; Write #N$00 to the sprite ID of the mushroom.
 $98CF JP $8EA0        ; Jump to #R$8EA0 to take a life from the player.

; Set Key Positions
;
; Used by the routine at #R$7D9A.
; .
; Called when a game starts. Chooses the rooms for three of the keys from
; the three tables of rooms that follow, using FRAMES and the counter at
; #R$5E12. The green key (#R$603D) uses FRAMES, the red key (#R$6045) uses
; FRAMES plus the low byte of the counter, and the cyan key (#R$604D) uses the
; high bytes of both. The room of the red key is also given to the mummy (see
; #R$640D). The yellow key does not move.
@label=SetKeyPositions
c$98D2 LD A,($5C78)  ; Fetch FRAMES.
 $98D5 LD HL,$990C   ; Point #REGhl at the green key rooms at #R$990C.
 $98D8 CALL $9904    ; Call #R$9904 to get a room.
 $98DB LD ($603E),A  ; Update the room of the green key.
 $98DE LD A,($5C78)  ; {Fetch FRAMES and keep FRAMES in #REGc.
 $98E1 LD C,A        ; }
 $98E2 LD A,($5E12)  ; Fetch the counter from #R$5E12.
 $98E5 ADD A,C       ; Add FRAMES to the counter.
 $98E6 LD HL,$9914   ; Point #REGhl at the red key rooms at #R$9914.
 $98E9 CALL $9904    ; Call #R$9904 to get a room.
 $98EC LD ($6046),A  ; Update the room of the red key.
 $98EF LD ($640E),A  ; Update the room of the mummy (offset #N$01 of #R$640D).
 $98F2 LD A,($5C79)  ; {Fetch the second byte of FRAMES and keep it in #REGc.
 $98F5 LD C,A        ; }
 $98F6 LD A,($5E13)  ; Fetch the high byte of the counter from #R$5E13.
 $98F9 ADD A,C       ; Add it to the high byte of the counter.
 $98FA LD HL,$991C   ; Point #REGhl at the cyan key rooms at #R$991C.
 $98FD CALL $9904    ; Call #R$9904 to get a room.
 $9900 LD ($604E),A  ; Update the room of the cyan key.
 $9903 RET           ; Return.

; Get Key Room
;
; Used by the routine at #R$98D2.
; .
; Looks up one of the eight rooms in a table using the bottom three bits
; of #REGa.
;
;   A The value to use
;   HL The table of eight rooms
; O:A The room
@label=GetKeyRoom
c$9904 AND %00000111 ; Keep only bits 0-2.
 $9906 LD C,A        ; Keep the index in #REGc.
 $9907 LD B,$00      ; #REGb=#N$00.
 $9909 ADD HL,BC     ; Add #REGbc to #REGhl.
 $990A LD A,(HL)     ; Fetch the room.
 $990B RET           ; Return.

; Green Key Rooms
;
; The eight rooms that the green key can start in (see #R$98D2).
@label=GreenKeyRooms
b$990C DEFB $05
 $990D DEFB $06
 $990E DEFB $07
 $990F DEFB $6D
 $9910 DEFB $25
 $9911 DEFB $24
 $9912 DEFB $23
 $9913 DEFB $22

; Red Key Rooms
;
; The eight rooms that the red key can start in (see #R$98D2).
@label=RedKeyRooms
b$9914 DEFB $17
 $9915 DEFB $13
 $9916 DEFB $09
 $9917 DEFB $0D
 $9918 DEFB $89
 $9919 DEFB $87
 $991A DEFB $80
 $991B DEFB $85

; Cyan Key Rooms
;
; The eight rooms that the cyan key can start in (see #R$98D2).
@label=CyanKeyRooms
b$991C DEFB $53
 $991D DEFB $8F
 $991E DEFB $41
 $991F DEFB $94
 $9920 DEFB $33
 $9921 DEFB $91
 $9922 DEFB $39
 $9923 DEFB $4C

; Spawn Food
;
; Used by the routine at #R$7E23.
; .
; Called by the main loop. When the counter at #R$5E12 is zero and bit 0
; of #R$5E13 is reset, the next of the food items from #R$EB58 to #N$EDD8 is
; looked at (the food pointer in #R$5E55 moves on by #N$08 bytes, and starts
; again at #R$EB58 after the last one). If the item is not in the room of the
; player and is not already in use then it is made one of the foods (sprite IDs
; #N$50 to #N$57), using FRAMES.
@label=SpawnFood
c$9924 LD A,($5E12)  ; {Fetch the counter from #R$5E12 and keep the low byte of the counter
 $9927 LD C,A        ; in #REGc.}
 $9928 LD A,($5E13)  ; Fetch the high byte of the counter from #R$5E13.
 $992B AND %00000001 ; Keep only bit 0.
 $992D OR C          ; {Return unless the counter is zero and bit 0 of its high byte is
 $992E RET NZ        ; reset.}
 $992F LD HL,($5E55) ; #REGhl=*#R$5E55.
 $9932 LD DE,$0008   ; #REGde=#N($0008,$04,$04) (the size of a food item).
 $9935 ADD HL,DE     ; Move #REGhl on to the next food item.
 $9936 LD ($5E55),HL ; Write #REGhl back to #R$5E55.
 $9939 PUSH HL       ; {Copy #REGhl into #REGix, as the food item.
 $993A POP IX        ; }
 $993C LD DE,$EDD8   ; #REGde=#N$EDD8 (the end of the food items).
 $993F AND A         ; {Subtract #REGde from #REGhl.
 $9940 SBC HL,DE     ; }
 $9942 JR NC,$995B   ; Jump to #R$995B if the food pointer is past the last
                     ; item.
 $9944 LD A,($EA91)  ; Fetch the room of the player from #R$EA91.
 $9947 CP (IX+$01)   ; {Return if the player is in the same room.
 $994A RET Z         ; }
 $994B LD A,(IX+$00) ; Fetch the sprite ID of the item.
 $994E AND A         ; {Return if the item is in use.
 $994F RET NZ        ; }
 $9950 LD A,($5C78)  ; Fetch FRAMES.
 $9953 AND %00000111 ; Keep only bits 0-2.
 $9955 ADD A,$50     ; Add #N$50, to make the sprite ID of the food.
 $9957 LD (IX+$00),A ; Update the sprite ID of the item.
 $995A RET           ; Return.
@label=SpawnFood_Restart
*$995B LD HL,$EB58   ; #REGhl=#N$EB58.
 $995E LD ($5E55),HL ; Write #REGhl to #R$5E55.
 $9961 RET           ; Return.

; Draw Graphic
;
; Used by the routine at #R$9213.
; .
; Draws a graphic on the screen. The way that it is drawn depends on bits
; 5-7 of the attribute, which choose one of the handlers in #R$9970. Bits 0-1
; choose how it is mixed with what is already on the screen (see #R$9D19).
; #TABLE(default,centre,left)
; { =h Bits 5-7 | =h Handler | =h Orientation }
; { #N$00 | #R$99C9 | Upright }
; { #N$01 | #R$99E5 | Mirrored left to right }
; { #N$02 | #R$9A0A | Rotated a quarter turn anti-clockwise }
; { #N$03 | #R$9A50 | Transposed (flipped along the main diagonal) }
; { #N$04 | #R$9ACB | Flipped top to bottom }
; { #N$05 | #R$9AEF | Rotated a half turn }
; { #N$06 | #R$9B14 | Transposed (flipped along the other diagonal) }
; { #N$07 | #R$9B5D | Rotated a quarter turn clockwise }
; TABLE#
;
; B The attribute
; C The graphic ID
; D The Y position
; E The X position
@label=DrawGraphic
c$9962 LD HL,$9970   ; Point #REGhl at the draw graphic handlers at #R$9970.
; This entry point is used by the routine at #R$9980.
; .
; This is also used by #R$9980, with a different table of handlers.
@label=DrawGraphic_Dispatch
*$9965 PUSH BC       ; Stash the attribute and graphic ID on the stack.
 $9966 LD A,B        ; Fetch the attribute.
 $9967 RLCA          ; {Rotate #REGa left three times, to move bits 5-7 to bits
 $9968 RLCA          ; 0-2.
 $9969 RLCA          ; }
 $996A AND %00000111 ; Keep only bits 0-2.
 $996C LD C,A        ; Keep the type of handler in #REGc.
 $996D JP $7E85      ; Jump to #R$7E85, which jumps to the handler in the table
                     ; at #REGhl.

; Draw Graphic Handlers
;
; The handlers for the eight ways to draw a graphic, which are chosen by
; bits 5-7 of the attribute (see #R$9962).
@label=DrawGraphicHandlers
w$9970 DEFW $99C9
 $9972 DEFW $99E5
 $9974 DEFW $9A0A
 $9976 DEFW $9A50
 $9978 DEFW $9ACB
 $997A DEFW $9AEF
 $997C DEFW $9B14
 $997E DEFW $9B5D

; Set Graphic Attributes
;
; Used by the routine at #R$91FE.
; .
; Sets the attributes of the cells that a graphic covers. This is the
; same as #R$9962 but with the handlers in #R$9985, which are the routines from
; #R$9D25 onwards.
;
; B The attribute
; C The graphic ID
; D The Y position
; E The X position
@label=SetGraphicAttributes
c$9980 LD HL,$9985   ; Point #REGhl at the set graphic attributes handlers at
                     ; #R$9985.
 $9983 JR $9965      ; Jump to #R$9965 to draw the graphic.

; Set Graphic Attributes Handlers
;
; The handlers for the eight ways to set the attributes of a graphic,
; which are chosen by bits 5-7 of the attribute (see #R$9980).
@label=SetGraphicAttributesHandlers
w$9985 DEFW $9D25
 $9987 DEFW $9D47
 $9989 DEFW $9D6F
 $998B DEFW $9DA0
 $998D DEFW $9DCE
 $998F DEFW $9DF8
 $9991 DEFW $9E21
 $9993 DEFW $9E55

; Get Graphic Details
;
; Used by the routines at #R$99C9, #R$99E5, #R$9A0A, #R$9A50, #R$9ACB, #R$9AEF,
; #R$9B14 and #R$9B5D.
; .
; Finds the details of a graphic from the table at #R$A600 (the entry is
; the graphic ID minus one). The first two bytes of the graphic are the width in
; bytes and the height in lines.
;
;   C The graphic ID
;   DE The position (#REGe is the X position and #REGd is the Y position)
; O:B The width of the graphic
; O:C The height of the graphic
; O:DE The address of the first byte of the graphic after the size
; O:HL The screen buffer address of the position
@label=GetGraphicDetails
c$9995 LD HL,$A600   ; Point #REGhl at the graphics table at #R$A600.
 $9998 DEC C         ; Decrease the graphic ID by one.
 $9999 LD B,$00      ; Clear the high byte of the graphic ID.
 $999B SLA C         ; Shift #REGc left.
 $999D RL B          ; Rotate #REGb left (so #REGbc=#REGbc * #N$02).
 $999F ADD HL,BC     ; Find the entry for the graphic in the table.
 $99A0 LD A,(HL)     ; Fetch the low byte of the address of the graphic.
 $99A1 INC HL        ; Move #REGhl on to the high byte.
 $99A2 LD H,(HL)     ; Fetch the high byte of the address of the graphic.
 $99A3 LD L,A        ; Keep the low byte of the address of the graphic in
                     ; #REGl.
 $99A4 EX DE,HL      ; Switch #REGde and #REGhl.
 $99A5 CALL $9BA2    ; Call #R$9BA2 to get the screen buffer address of the
                     ; position.
 $99A8 LD A,(DE)     ; Fetch the width.
 $99A9 LD B,A        ; Keep the width in #REGb.
 $99AA INC DE        ; Move #REGde on to the next byte.
 $99AB LD A,(DE)     ; Fetch the height.
 $99AC LD C,A        ; Keep the height in #REGc.
 $99AD INC DE        ; Move #REGde on to the next byte.
 $99AE RET           ; Return.

; Get Graphic Attribute Details
;
; Used by the routines at #R$9D25, #R$9D47, #R$9D6F, #R$9DA0, #R$9DCE, #R$9DF8,
; #R$9E21 and #R$9E55.
; .
; This is the same as #R$9995 but for the attributes of a graphic, from
; the table at #R$A64E, and the position gives the address in the attribute
; buffer (see #R$9BD2).
;
;   C The graphic ID
;   DE The position (#REGe is the X position and #REGd is the Y position)
; O:B The width of the graphic
; O:C The height of the graphic
; O:DE The address of the first attribute of the graphic after the size
; O:HL The attribute buffer address of the position
@label=GetGraphicAttributeDetails
c$99AF LD HL,$A64E   ; Point #REGhl at the graphics attributes table at
                     ; #R$A64E.
 $99B2 DEC C         ; Decrease the graphic ID by one.
 $99B3 LD B,$00      ; Clear the high byte of the graphic ID.
 $99B5 SLA C         ; Shift #REGc left.
 $99B7 RL B          ; Rotate #REGb left (so #REGbc=#REGbc * #N$02).
 $99B9 ADD HL,BC     ; Find the entry for the graphic in the table.
 $99BA LD A,(HL)     ; Fetch the low byte of the address of the attributes.
 $99BB INC HL        ; Move #REGhl on to the high byte.
 $99BC LD H,(HL)     ; Fetch the high byte of the address of the attributes.
 $99BD LD L,A        ; Keep the low byte of the address of the attributes in
                     ; #REGl.
 $99BE EX DE,HL      ; Switch #REGde and #REGhl.
 $99BF CALL $9BD2    ; Call #R$9BD2 to get the attribute buffer address of the
                     ; position.
 $99C2 LD A,(DE)     ; Fetch the width.
 $99C3 LD B,A        ; Keep the width in #REGb.
 $99C4 INC DE        ; Move #REGde on to the next byte.
 $99C5 LD A,(DE)     ; Fetch the height.
 $99C6 LD C,A        ; Keep the height in #REGc.
 $99C7 INC DE        ; Move #REGde on to the next byte.
 $99C8 RET           ; Return.

; Draw Graphic Upright
;
; The handler of #R$9962 for a graphic that is drawn as it is stored. A
; row of bytes is copied at a time, and then #R$9F03 moves up a line.
@label=DrawGraphic_Upright
c$99C9 POP BC        ; Restore the attribute and graphic ID from the stack.
 $99CA CALL $9D19    ; Call #R$9D19 to get the instruction to mix the graphic with the
                     ; screen.
 $99CD LD ($99D7),A  ; Write it over the instruction at #R$99D7.
 $99D0 CALL $9995    ; Call #R$9995 to get the details of the graphic.
@label=DrawGraphic_Upright_Row
*$99D3 PUSH BC       ; Stash the width and height on the stack.
 $99D4 PUSH HL       ; Stash the screen address on the stack.
@label=DrawGraphic_Upright_Byte
*$99D5 LD A,(DE)     ; Fetch the next byte of the graphic.
 $99D6 INC DE        ; Move #REGde on to the next byte.
 $99D7 NOP           ; This is replaced by an instruction that mixes #REGa with
                     ; the screen.
 $99D8 LD (HL),A     ; Write #REGa to the screen.
 $99D9 INC L         ; Move #REGhl on to the next byte.
 $99DA DJNZ $99D5    ; Decrease the width by one and loop back to #R$99D5 until all of the
                     ; bytes in the row have been drawn.
 $99DC POP HL        ; Restore the screen address from the stack.
 $99DD CALL $9F03    ; Call #R$9F03 to move up a line.
 $99E0 POP BC        ; Restore the width and height from the stack.
 $99E1 DEC C         ; {Decrease the height by one and loop back to #R$99D3 until all of the
 $99E2 JR NZ,$99D3   ; rows have been done.}
 $99E4 RET           ; Return.

; Draw Graphic Mirrored
;
; The handler of #R$9962 for a graphic that is mirrored from left to
; right. Each row is read from its end and the bits of each byte are
; reversed with #R$9A92.
@label=DrawGraphic_Mirrored
c$99E5 POP BC        ; Restore the attribute and graphic ID from the stack.
 $99E6 CALL $9D19    ; Call #R$9D19 to get the instruction to mix the graphic with the
                     ; screen.
 $99E9 LD ($99F9),A  ; Write it over the instruction at #R$99F9.
 $99EC CALL $9995    ; Call #R$9995 to get the details of the graphic.
@label=DrawGraphic_Mirrored_Row
*$99EF PUSH BC       ; Stash the width and height on the stack.
 $99F0 PUSH HL       ; Stash the screen address on the stack.
 $99F1 CALL $9A9D    ; Call #R$9A9D to move #REGde on to the end of the row.
@label=DrawGraphic_Mirrored_Byte
*$99F4 DEC DE        ; Move #REGde back one byte.
 $99F5 LD A,(DE)     ; Fetch the byte of the graphic.
 $99F6 CALL $9A92    ; Call #R$9A92 to reverse the bits.
 $99F9 NOP           ; This is replaced by an instruction that mixes #REGa with
                     ; the screen.
 $99FA LD (HL),A     ; Write #REGa to the screen.
 $99FB INC L         ; Move #REGhl on to the next byte.
 $99FC DJNZ $99F4    ; Decrease the width by one and loop back to #R$99F4 until all of the
                     ; bytes in the row have been drawn.
 $99FE POP HL        ; Restore the screen address from the stack.
 $99FF CALL $9F03    ; Call #R$9F03 to move up a line.
 $9A02 POP BC        ; Restore the width and height from the stack.
 $9A03 CALL $9A9D    ; Call #R$9A9D to move #REGde on to the start of the next
                     ; row.
 $9A06 DEC C         ; {Decrease the height by one and loop back to #R$99EF until all of the
 $9A07 JR NZ,$99EF   ; rows have been done.}
 $9A09 RET           ; Return.

; Draw Graphic Rotated Left
;
; The handler of #R$9962 for a graphic that is turned a quarter turn
; anti-clockwise. Each row of the screen is made from a column of the graphic,
; from the right-hand side to the left-hand side. The bits for each byte come
; from eight rows of the graphic, which are gathered up in #REGh' using the
; mask in #REGl'.
@label=DrawGraphic_RotatedLeft
c$9A0A POP BC        ; Restore the attribute and graphic ID from the stack.
 $9A0B CALL $9D19    ; Call #R$9D19 to get the instruction to mix the graphic with the
                     ; screen.
 $9A0E LD ($9A36),A  ; Write it over the instruction at #R$9A36.
 $9A11 CALL $9995    ; Call #R$9995 to get the details of the graphic.
 $9A14 LD A,B        ; Fetch the width.
 $9A15 EXX           ; Switch to the shadow registers.
 $9A16 LD L,$01      ; #REGl'=#N$01 (the mask for the first column).
 $9A18 LD B,A        ; Keep the number of columns in #REGb'.
 $9A19 EXX           ; Switch back to the main registers.
 $9A1A CALL $9A9D    ; Call #R$9A9D to move #REGde on to the second row.
 $9A1D DEC DE        ; Move #REGde back to the last byte of the first row.
@label=DrawGraphic_RotatedLeft_Row
*$9A1E PUSH BC       ; Stash the width and height on the stack.
 $9A1F PUSH DE       ; Stash the position in the graphic on the stack.
 $9A20 PUSH HL       ; Stash the screen address on the stack.
@label=DrawGraphic_RotatedLeft_Bit
*$9A21 LD A,(DE)     ; Fetch the byte of the graphic.
 $9A22 EXX           ; Switch to the shadow registers.
 $9A23 AND L         ; Mask the column.
 $9A24 JR Z,$9A27    ; Jump to #R$9A27 if the bit is not set.
 $9A26 SCF           ; Set the carry flag.
@label=DrawGraphic_RotatedLeft_Shift
*$9A27 RL H          ; Shift the bit into #REGh'.
 $9A29 EXX           ; Switch back to the main registers.
 $9A2A CALL $9A9D    ; Call #R$9A9D to move down to the next row of the
                     ; graphic.
 $9A2D DEC C         ; Decrease the height by one.
 $9A2E LD A,C        ; Fetch the number of rows left.
 $9A2F AND %00000111 ; Keep only bits 0-2.
 $9A31 JR NZ,$9A21   ; Jump to #R$9A21 until eight bits have been gathered.
 $9A33 EXX           ; Switch to the shadow registers.
 $9A34 LD A,H        ; Fetch the byte that was built from the column.
 $9A35 EXX           ; Switch back to the main registers.
 $9A36 NOP           ; This is replaced by an instruction that mixes #REGa with
                     ; the screen.
 $9A37 LD (HL),A     ; Write #REGa to the screen.
 $9A38 INC L         ; Move #REGhl on to the next byte.
 $9A39 LD A,C        ; Fetch the number of rows left.
 $9A3A AND A         ; {Jump to #R$9A21 if there are more bytes in this row of
 $9A3B JR NZ,$9A21   ; the screen.}
 $9A3D POP HL        ; Restore the screen address from the stack.
 $9A3E CALL $9F03    ; Call #R$9F03 to move up a line.
 $9A41 POP DE        ; Restore the position in the graphic from the stack.
 $9A42 POP BC        ; Restore the width and height from the stack.
 $9A43 EXX           ; Switch to the shadow registers.
 $9A44 RLC L         ; Move the mask on to the next column.
 $9A46 EXX           ; Switch back to the main registers.
 $9A47 JR NC,$9A1E   ; Jump to #R$9A1E if there are more columns in this byte.
 $9A49 EXX           ; Switch to the shadow registers.
 $9A4A DEC B         ; Decrease the number of columns by one.
 $9A4B EXX           ; Switch back to the main registers.
 $9A4C RET Z         ; Return if all of the columns have been drawn.
 $9A4D DEC DE        ; Move #REGde back to the previous byte.
 $9A4E JR $9A1E      ; Jump back to #R$9A1E to draw the next row of the
                     ; graphic.

; Draw Graphic Transposed
;
; The handler of #R$9962 for a graphic that is flipped along the diagonal
; from top left to bottom right. Each row of the screen is made from a column
; of the graphic, from the left-hand side to the right-hand side, from the top
; down. This is the same as #R$9A0A except for the direction of the columns.
@label=DrawGraphic_Transposed
c$9A50 POP BC        ; Restore the attribute and graphic ID from the stack.
 $9A51 CALL $9D19    ; Call #R$9D19 to get the instruction to mix the graphic with the
                     ; screen.
 $9A54 LD ($9A78),A  ; Write it over the instruction at #R$9A78.
 $9A57 CALL $9995    ; Call #R$9995 to get the details of the graphic.
 $9A5A LD A,B        ; Fetch the width.
 $9A5B EXX           ; Switch to the shadow registers.
 $9A5C LD B,A        ; Keep the number of columns in #REGb'.
 $9A5D LD L,$80      ; #REGl'=#N$80 (the mask for the first column).
 $9A5F EXX           ; Switch back to the main registers.
@label=DrawGraphic_Transposed_Row
*$9A60 PUSH BC       ; Stash the width and height on the stack.
 $9A61 PUSH DE       ; Stash the position in the graphic on the stack.
 $9A62 PUSH HL       ; Stash the screen address on the stack.
@label=DrawGraphic_Transposed_Bit
*$9A63 LD A,(DE)     ; Fetch the byte of the graphic.
 $9A64 EXX           ; Switch to the shadow registers.
 $9A65 AND L         ; Mask the column.
 $9A66 JR Z,$9A69    ; Jump to #R$9A69 if the bit is not set.
 $9A68 SCF           ; Set the carry flag.
@label=DrawGraphic_Transposed_Shift
*$9A69 RL H          ; Shift the bit into #REGh'.
 $9A6B EXX           ; Switch back to the main registers.
 $9A6C CALL $9A9D    ; Call #R$9A9D to move down to the next row of the
                     ; graphic.
 $9A6F DEC C         ; Decrease the height by one.
 $9A70 LD A,C        ; Fetch the number of rows left.
 $9A71 AND %00000111 ; Keep only bits 0-2.
 $9A73 JR NZ,$9A63   ; Jump to #R$9A63 until eight bits have been gathered.
 $9A75 EXX           ; Switch to the shadow registers.
 $9A76 LD A,H        ; Fetch the byte that was built from the column.
 $9A77 EXX           ; Switch back to the main registers.
 $9A78 NOP           ; This is replaced by an instruction that mixes #REGa with
                     ; the screen.
 $9A79 LD (HL),A     ; Write #REGa to the screen.
 $9A7A INC L         ; Move #REGhl on to the next byte.
 $9A7B LD A,C        ; Fetch the number of rows left.
 $9A7C AND A         ; {Jump to #R$9A63 if there are more bytes in this row of
 $9A7D JR NZ,$9A63   ; the screen.}
 $9A7F POP HL        ; Restore the screen address from the stack.
 $9A80 CALL $9F03    ; Call #R$9F03 to move up a line.
 $9A83 POP DE        ; Restore the position in the graphic from the stack.
 $9A84 POP BC        ; Restore the width and height from the stack.
 $9A85 EXX           ; Switch to the shadow registers.
 $9A86 RRC L         ; Move the mask on to the next column.
 $9A88 EXX           ; Switch back to the main registers.
 $9A89 JR NC,$9A60   ; Jump to #R$9A60 if there are more columns in this byte.
 $9A8B EXX           ; Switch to the shadow registers.
 $9A8C DEC B         ; Decrease the number of columns by one.
 $9A8D EXX           ; Switch back to the main registers.
 $9A8E RET Z         ; Return if all of the columns have been drawn.
 $9A8F INC DE        ; Move #REGde on to the next byte.
 $9A90 JR $9A60      ; Jump back to #R$9A60 to draw the next row of the
                     ; graphic.

; Reverse Bits
;
; Used by the routines at #R$99E5 and #R$9AEF.
; .
; Reverses the order of the bits in a byte.
;
;   A The byte
; O:A The byte with its bits reversed
@label=ReverseBits
c$9A92 PUSH BC       ; Stash #REGbc on the stack.
 $9A93 LD B,$08      ; #REGb=#N$08 (the number of bits to reverse).
@label=ReverseBits_Loop
*$9A95 RLA           ; Rotate the top bit of #REGa into the carry flag.
 $9A96 RR C          ; Rotate the carry flag into the top of #REGc.
 $9A98 DJNZ $9A95    ; Decrease the bit counter by one and loop back to #R$9A95 until all
                     ; eight bits have been reversed.
 $9A9A LD A,C        ; Fetch the reversed byte.
 $9A9B POP BC        ; Restore #REGbc from the stack.
 $9A9C RET           ; Return.

; Add Width To Address
;
; Used by the routines at #R$99E5, #R$9A0A, #R$9A50, #R$9AEF, #R$9B14, #R$9D47,
; #R$9D6F, #R$9DA0, #R$9DF8 and #R$9E21.
; .
; Adds the width of a graphic to #REGde, to move on one row.
;
;   B The width of the graphic
;   DE The address
; O:DE The address plus the width
@label=AddWidthToAddress
c$9A9D LD A,B        ; Fetch the width of the graphic.
 $9A9E ADD A,E       ; Add the low byte of the address.
 $9A9F LD E,A        ; Keep the new low byte in #REGe.
 $9AA0 LD A,D        ; Fetch the high byte of the address.
 $9AA1 ADC A,$00     ; Add the carry.
 $9AA3 LD D,A        ; Keep the new high byte in #REGd.
 $9AA4 RET           ; Return.

; Subtract Width From Address
;
; Used by the routines at #R$9ACB, #R$9B14, #R$9B5D, #R$9DCE, #R$9E21 and
; #R$9E55.
; .
; Subtracts the width of a graphic from #REGde, to move back one row.
;
;   B The width of the graphic
;   DE The address
; O:DE The address minus the width
@label=SubtractWidthFromAddress
c$9AA5 LD A,E        ; Fetch the low byte of the address.
 $9AA6 SUB B         ; Subtract the width.
 $9AA7 LD E,A        ; Keep the new low byte in #REGe.
 $9AA8 LD A,D        ; Fetch the high byte of the address.
 $9AA9 SBC A,$00     ; Subtract the carry.
 $9AAB LD D,A        ; Keep the new high byte in #REGd.
 $9AAC RET           ; Return.

; Multiply A By DE
;
; Used by the routines at #R$8B8A and #R$9ABA.
; .
; Multiplies #REGa by #REGde.
;
;   A The multiplier
;   DE The multiplicand
; O:HL The result
@label=MultiplyAByDE
c$9AAD LD HL,$0000   ; #REGhl=#N($0000,$04,$04).
 $9AB0 LD B,$08      ; #REGb=#N$08 (the number of bits in the multiplier).
@label=MultiplyAByDE_Loop
*$9AB2 ADD HL,HL     ; Shift the result left.
 $9AB3 RLCA          ; Rotate the next bit of #REGa into the carry flag.
 $9AB4 JR NC,$9AB7   ; Jump to #R$9AB7 if it was not set.
 $9AB6 ADD HL,DE     ; Add #REGde to the result.
@label=MultiplyAByDE_Next
*$9AB7 DJNZ $9AB2    ; Decrease the bit counter by one and loop back to #R$9AB2 until every
                     ; bit of the multiplier has been used.
 $9AB9 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CE0D }
; { #GUNFRIGHT$D03E }
; { #KNIGHTLORE$D4F9 }
; { #NIGHTSHADE$E0EE }
; { #SABREWULF$BC5A }
; { #TRANZAM$6F2F }
; { #UNDERWURLDE$AC68 }
; LIST#

; Find Last Row
;
; Used by the routines at #R$9ACB, #R$9AEF, #R$9B14, #R$9B5D, #R$9DCE, #R$9DF8,
; #R$9E21 and #R$9E55.
; .
; Moves #REGde on to the first byte of the last row of a graphic, which is
; the width multiplied by one less than the height.
;
;   B The width of the graphic
;   C The height of the graphic
;   DE The address of the graphic
; O:DE The address of the last row
@label=FindLastRow
c$9ABA PUSH HL       ; Stash #REGhl on the stack.
 $9ABB PUSH DE       ; Stash #REGde on the stack.
 $9ABC LD A,B        ; Fetch the width of the graphic.
 $9ABD LD E,C        ; Fetch the height of the graphic.
 $9ABE DEC E         ; Decrease it by one.
 $9ABF LD D,$00      ; Clear the high byte of the height.
 $9AC1 PUSH BC       ; Stash #REGbc on the stack.
 $9AC2 CALL $9AAD    ; Call #R$9AAD to multiply the width by one less than the
                     ; height.
 $9AC5 POP BC        ; Restore #REGbc from the stack.
 $9AC6 POP DE        ; Restore #REGde from the stack.
 $9AC7 ADD HL,DE     ; Add #REGde to the result.
 $9AC8 EX DE,HL      ; Switch #REGde and #REGhl.
 $9AC9 POP HL        ; Restore #REGhl from the stack.
 $9ACA RET           ; Return.

; Draw Graphic Flipped
;
; The handler of #R$9962 for a graphic that is flipped top to bottom. This
; is the same as #R$99C9, except that it starts from the last row and works up
; using #R$9AA5.
@label=DrawGraphic_Flipped
c$9ACB POP BC        ; Restore the attribute and graphic ID from the stack.
 $9ACC CALL $9D19    ; Call #R$9D19 to get the instruction to mix the graphic with the
                     ; screen.
 $9ACF LD ($9ADD),A  ; Write it over the instruction at #R$9ADD.
 $9AD2 CALL $9995    ; Call #R$9995 to get the details of the graphic.
 $9AD5 CALL $9ABA    ; Call #R$9ABA to move on to the last row.
@label=DrawGraphic_Flipped_Row
*$9AD8 PUSH BC       ; Stash the width and height on the stack.
 $9AD9 PUSH DE       ; Stash the position in the graphic on the stack.
 $9ADA PUSH HL       ; Stash the screen address on the stack.
@label=DrawGraphic_Flipped_Byte
*$9ADB LD A,(DE)     ; Fetch the next byte of the graphic.
 $9ADC INC DE        ; Move #REGde on to the next byte.
 $9ADD NOP           ; This is replaced by an instruction that mixes #REGa with
                     ; the screen.
 $9ADE LD (HL),A     ; Write #REGa to the screen.
 $9ADF INC L         ; Move #REGhl on to the next byte.
 $9AE0 DJNZ $9ADB    ; Decrease the width by one and loop back to #R$9ADB until all of the
                     ; bytes in the row have been drawn.
 $9AE2 POP HL        ; Restore the screen address from the stack.
 $9AE3 CALL $9F03    ; Call #R$9F03 to move up a line.
 $9AE6 POP DE        ; Restore the position in the graphic from the stack.
 $9AE7 POP BC        ; Restore the width and height from the stack.
 $9AE8 CALL $9AA5    ; Call #R$9AA5 to move back to the previous row of the
                     ; graphic.
 $9AEB DEC C         ; {Decrease the height by one and loop back to #R$9AD8 until all of the
 $9AEC JR NZ,$9AD8   ; rows have been done.}
 $9AEE RET           ; Return.

; Draw Graphic Rotated Half
;
; The handler of #R$9962 for a graphic that is turned a half turn. This is
; the same as #R$99E5, except that it starts from the end of the last row.
@label=DrawGraphic_RotatedHalf
c$9AEF POP BC        ; Restore the attribute and graphic ID from the stack.
 $9AF0 CALL $9D19    ; Call #R$9D19 to get the instruction to mix the graphic with the
                     ; screen.
 $9AF3 LD ($9B06),A  ; Write it over the instruction at #R$9B06.
 $9AF6 CALL $9995    ; Call #R$9995 to get the details of the graphic.
 $9AF9 CALL $9ABA    ; Call #R$9ABA to move on to the last row.
 $9AFC CALL $9A9D    ; Call #R$9A9D to move on to the end of the last row.
@label=DrawGraphic_RotatedHalf_Row
*$9AFF PUSH BC       ; Stash the width and height on the stack.
 $9B00 PUSH HL       ; Stash the screen address on the stack.
@label=DrawGraphic_RotatedHalf_Byte
*$9B01 DEC DE        ; Move #REGde back one byte.
 $9B02 LD A,(DE)     ; Fetch the byte of the graphic.
 $9B03 CALL $9A92    ; Call #R$9A92 to reverse the bits.
 $9B06 NOP           ; This is replaced by an instruction that mixes #REGa with
                     ; the screen.
 $9B07 LD (HL),A     ; Write #REGa to the screen.
 $9B08 INC L         ; Move #REGhl on to the next byte.
 $9B09 DJNZ $9B01    ; Decrease the width by one and loop back to #R$9B01 until all of the
                     ; bytes in the row have been drawn.
 $9B0B POP HL        ; Restore the screen address from the stack.
 $9B0C CALL $9F03    ; Call #R$9F03 to move up a line.
 $9B0F POP BC        ; Restore the width and height from the stack.
 $9B10 DEC C         ; {Decrease the height by one and loop back to #R$9AFF until all of the
 $9B11 JR NZ,$9AFF   ; rows have been done.}
 $9B13 RET           ; Return.

; Draw Graphic Transposed Flipped
;
; The handler of #R$9962 for a graphic that is flipped along the diagonal
; from bottom left to top right. This is the same as #R$9A0A, except that it
; starts from the last row and works up using #R$9AA5.
@label=DrawGraphic_TransposedFlipped
c$9B14 POP BC        ; Restore the attribute and graphic ID from the stack.
 $9B15 CALL $9D19    ; Call #R$9D19 to get the instruction to mix the graphic with the
                     ; screen.
 $9B18 LD ($9B43),A  ; Write it over the instruction at #R$9B43.
 $9B1B CALL $9995    ; Call #R$9995 to get the details of the graphic.
 $9B1E LD A,B        ; Fetch the width.
 $9B1F EXX           ; Switch to the shadow registers.
 $9B20 LD B,A        ; Keep the number of columns in #REGb'.
 $9B21 LD L,$01      ; #REGl'=#N$01 (the mask for the first column).
 $9B23 EXX           ; Switch back to the main registers.
 $9B24 CALL $9A9D    ; Call #R$9A9D to move #REGde on to the end of the first
                     ; row.
 $9B27 DEC DE        ; Move #REGde back to the last byte of the first row.
 $9B28 CALL $9ABA    ; Call #R$9ABA to move on to the last row.
@label=DrawGraphic_TransposedFlipped_Row
*$9B2B PUSH BC       ; Stash the width and height on the stack.
 $9B2C PUSH DE       ; Stash the position in the graphic on the stack.
 $9B2D PUSH HL       ; Stash the screen address on the stack.
@label=DrawGraphic_TransposedFlipped_Bit
*$9B2E LD A,(DE)     ; Fetch the byte of the graphic.
 $9B2F EXX           ; Switch to the shadow registers.
 $9B30 AND L         ; Mask the column.
 $9B31 JR Z,$9B34    ; Jump to #R$9B34 if the bit is not set.
 $9B33 SCF           ; Set the carry flag.
@label=DrawGraphic_TransposedFlipped_Shift
*$9B34 RL H          ; Shift the bit into #REGh'.
 $9B36 EXX           ; Switch back to the main registers.
 $9B37 CALL $9AA5    ; Call #R$9AA5 to move up to the previous row of the
                     ; graphic.
 $9B3A DEC C         ; Decrease the height by one.
 $9B3B LD A,C        ; Fetch the number of rows left.
 $9B3C AND %00000111 ; Keep only bits 0-2.
 $9B3E JR NZ,$9B2E   ; Jump to #R$9B2E until eight bits have been gathered.
 $9B40 EXX           ; Switch to the shadow registers.
 $9B41 LD A,H        ; Fetch the byte that was built from the column.
 $9B42 EXX           ; Switch back to the main registers.
 $9B43 NOP           ; This is replaced by an instruction that mixes #REGa with
                     ; the screen.
 $9B44 LD (HL),A     ; Write #REGa to the screen.
 $9B45 INC L         ; Move #REGhl on to the next byte.
 $9B46 LD A,C        ; Fetch the number of rows left.
 $9B47 AND A         ; {Jump to #R$9B2E if there are more bytes in this row of
 $9B48 JR NZ,$9B2E   ; the screen.}
 $9B4A POP HL        ; Restore the screen address from the stack.
 $9B4B CALL $9F03    ; Call #R$9F03 to move up a line.
 $9B4E POP DE        ; Restore the position in the graphic from the stack.
 $9B4F POP BC        ; Restore the width and height from the stack.
 $9B50 EXX           ; Switch to the shadow registers.
 $9B51 RLC L         ; Move the mask on to the next column.
 $9B53 EXX           ; Switch back to the main registers.
 $9B54 JR NC,$9B2B   ; Jump to #R$9B2B if there are more columns in this byte.
 $9B56 EXX           ; Switch to the shadow registers.
 $9B57 DEC B         ; Decrease the number of columns by one.
 $9B58 EXX           ; Switch back to the main registers.
 $9B59 RET Z         ; Return if all of the columns have been drawn.
 $9B5A DEC DE        ; Move #REGde back to the previous byte.
 $9B5B JR $9B2B      ; Jump back to #R$9B2B to draw the next row of the
                     ; graphic.

; Draw Graphic Rotated Right
;
; The handler of #R$9962 for a graphic that is turned a quarter turn
; clockwise. This is the same as #R$9A50, except that it starts from the last
; row and works up using #R$9AA5.
@label=DrawGraphic_RotatedRight
c$9B5D POP BC        ; Restore the attribute and graphic ID from the stack.
 $9B5E CALL $9D19    ; Call #R$9D19 to get the instruction to mix the graphic with the
                     ; screen.
 $9B61 LD ($9B88),A  ; Write it over the instruction at #R$9B88.
 $9B64 CALL $9995    ; Call #R$9995 to get the details of the graphic.
 $9B67 LD A,B        ; Fetch the width.
 $9B68 EXX           ; Switch to the shadow registers.
 $9B69 LD B,A        ; Keep the number of columns in #REGb'.
 $9B6A LD L,$80      ; #REGl'=#N$80 (the mask for the first column).
 $9B6C EXX           ; Switch back to the main registers.
 $9B6D CALL $9ABA    ; Call #R$9ABA to move on to the last row.
@label=DrawGraphic_RotatedRight_Row
*$9B70 PUSH BC       ; Stash the width and height on the stack.
 $9B71 PUSH DE       ; Stash the position in the graphic on the stack.
 $9B72 PUSH HL       ; Stash the screen address on the stack.
@label=DrawGraphic_RotatedRight_Bit
*$9B73 LD A,(DE)     ; Fetch the byte of the graphic.
 $9B74 EXX           ; Switch to the shadow registers.
 $9B75 AND L         ; Mask the column.
 $9B76 JR Z,$9B79    ; Jump to #R$9B79 if the bit is not set.
 $9B78 SCF           ; Set the carry flag.
@label=DrawGraphic_RotatedRight_Shift
*$9B79 RL H          ; Shift the bit into #REGh'.
 $9B7B EXX           ; Switch back to the main registers.
 $9B7C CALL $9AA5    ; Call #R$9AA5 to move up to the previous row of the
                     ; graphic.
 $9B7F DEC C         ; Decrease the height by one.
 $9B80 LD A,C        ; Fetch the number of rows left.
 $9B81 AND %00000111 ; Keep only bits 0-2.
 $9B83 JR NZ,$9B73   ; Jump to #R$9B73 until eight bits have been gathered.
 $9B85 EXX           ; Switch to the shadow registers.
 $9B86 LD A,H        ; Fetch the byte that was built from the column.
 $9B87 EXX           ; Switch back to the main registers.
 $9B88 NOP           ; This is replaced by an instruction that mixes #REGa with
                     ; the screen.
 $9B89 LD (HL),A     ; Write #REGa to the screen.
 $9B8A INC L         ; Move #REGhl on to the next byte.
 $9B8B LD A,C        ; Fetch the number of rows left.
 $9B8C AND A         ; {Jump to #R$9B73 if there are more bytes in this row of
 $9B8D JR NZ,$9B73   ; the screen.}
 $9B8F POP HL        ; Restore the screen address from the stack.
 $9B90 CALL $9F03    ; Call #R$9F03 to move up a line.
 $9B93 POP DE        ; Restore the position in the graphic from the stack.
 $9B94 POP BC        ; Restore the width and height from the stack.
 $9B95 EXX           ; Switch to the shadow registers.
 $9B96 RRC L         ; Move the mask on to the next column.
 $9B98 EXX           ; Switch back to the main registers.
 $9B99 JR NC,$9B70   ; Jump to #R$9B70 if there are more columns in this byte.
 $9B9B EXX           ; Switch to the shadow registers.
 $9B9C DEC B         ; Decrease the number of columns by one.
 $9B9D EXX           ; Switch back to the main registers.
 $9B9E RET Z         ; Return if all of the columns have been drawn.
 $9B9F INC DE        ; Move #REGde on to the next byte.
 $9BA0 JR $9B70      ; Jump back to #R$9B70 to draw the next row of the
                     ; graphic.

; Calculate Screen Address
;
; Used by the routines at #R$7D8A, #R$8B8A, #R$95DA, #R$9641, #R$9995, #R$9C61,
; #R$9F80, #R$9F9F, #R$A185, #R$A1AE, #R$A1F3 and #R$A219.
; .
; Converts the pixel position of a point into the address in the screen
; buffer that holds it. The bits that are left over are not used here, so the
; address is the one for the left-hand pixel of the character cell.
;
;   H The Y position (the pixel line down from the top)
;   L The X position (the pixel across from the left)
; O:HL The screen buffer address
@label=ScreenAddress
c$9BA2 LD A,L        ; Fetch the X position.
 $9BA3 RRCA          ; {Rotate right three times, which divides the X position
 $9BA4 RRCA          ; by #N$08.
 $9BA5 RRCA          ; }
 $9BA6 AND %00011111 ; Keep only bits 0-4.
 $9BA8 LD L,A        ; Keep the column in #REGl.
 $9BA9 LD A,H        ; Fetch the Y position.
 $9BAA RLCA          ; {Rotate left twice.
 $9BAB RLCA          ; }
 $9BAC AND %11100000 ; Keep only bits 5-7 (the character row within the third of the
                     ; screen).
 $9BAE OR L          ; Combine it with the column.
 $9BAF LD L,A        ; Keep the low byte of the screen buffer address in #REGl.
 $9BB0 LD A,H        ; Fetch the Y position.
 $9BB1 AND %00000111 ; Keep only bits 0-2 (the pixel line within the
                     ; character).
 $9BB3 EX AF,AF'     ; Switch to the shadow #REGaf register.
 $9BB4 LD A,H        ; Fetch the Y position.
 $9BB5 RRCA          ; {Rotate right three times.
 $9BB6 RRCA          ;
 $9BB7 RRCA          ; }
 $9BB8 AND %00011000 ; Keep only bits 3-4 (the third of the screen).
 $9BBA OR %01000000  ; Set bit 6, so the address is in the screen buffer.
 $9BBC LD H,A        ; Keep the third of the screen in #REGh.
 $9BBD EX AF,AF'     ; Switch back to the main #REGaf register.
 $9BBE OR H          ; Combine the pixel line with the third of the screen.
 $9BBF LD H,A        ; Keep the high byte of the screen buffer address in
                     ; #REGh.
 $9BC0 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #COOKIE$76E3 }
; { #JETPAC$7308 }
; { #LUNARJETMAN$851E }
; { #PSSST$759A }
; { #SABREWULF$B8AD }
; { #TRANZAM$6F10 }
; { #UNDERWURLDE$ADF8 }
; LIST#

; Screen Address One Pixel Below
;
; Moves a screen buffer address down by one pixel line.
;
;   HL The screen buffer address
; O:HL The screen buffer address of the line below
@label=ScreenPosition1PixelBelow
c$9BC1 INC H         ; Move down a pixel line.
 $9BC2 LD A,H        ; Fetch the high byte of the address.
 $9BC3 AND %00000111 ; Keep only bits 0-2.
 $9BC5 RET NZ        ; Return if a character boundary has not been crossed.
 $9BC6 LD A,L        ; Fetch the low byte of the address.
 $9BC7 ADD A,$20     ; Move down a character row.
 $9BC9 LD L,A        ; Keep the new low byte in #REGl.
 $9BCA AND %11100000 ; Keep only bits 5-7.
 $9BCC RET Z         ; Return if the next third of the screen has been reached.
 $9BCD LD A,H        ; Fetch the high byte of the address.
 $9BCE SUB $08       ; Subtract #N$08.
 $9BD0 LD H,A        ; Keep the new high byte in #REGh.
 $9BD1 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #MARTIANOIDS$BD3A }
; { #UNDERWURLDE$9C2B }
; LIST#

; Calculate Attribute Address
;
; Used by the routines at #R$7D8A, #R$8C8C, #R$99AF, #R$A00E, #R$A1F3 and
; #R$A240.
; .
; Converts the pixel position of a point into the address in the attribute
; buffer of the character cell that holds it.
;
;   H The Y position (the pixel line down from the top)
;   L The X position (the pixel across from the left)
; O:HL The attribute buffer address
@label=AttributeAddress
c$9BD2 PUSH BC       ; Stash #REGbc on the stack.
 $9BD3 LD A,L        ; Fetch the X position.
 $9BD4 RRCA          ; {Rotate right three times, which divides the X position
 $9BD5 RRCA          ; by #N$08.
 $9BD6 RRCA          ; }
 $9BD7 AND %00011111 ; Keep only bits 0-4 (the column).
 $9BD9 LD L,A        ; Keep the column in #REGl.
 $9BDA LD A,H        ; Fetch the Y position.
 $9BDB RLCA          ; {Rotate left twice.
 $9BDC RLCA          ; }
 $9BDD LD C,A        ; Keep the Y position, rotated, in #REGc.
 $9BDE AND %11100000 ; Keep only bits 5-7 (the character row within the third of the
                     ; screen).
 $9BE0 OR L          ; Combine it with the column.
 $9BE1 LD L,A        ; Keep the low byte of the attribute buffer address in
                     ; #REGl.
 $9BE2 LD A,C        ; Fetch the Y position, rotated.
 $9BE3 AND %00000011 ; Keep only bits 0-1 (the third of the screen).
 $9BE5 OR %01011000  ; Set bits 3-4 and 6, so the address is in the attribute buffer
                     ; (#N$58).
 $9BE7 LD H,A        ; Keep the high byte of the attribute buffer address in
                     ; #REGh.
 $9BE8 POP BC        ; Restore #REGbc from the stack.
 $9BE9 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #COOKIE$7534 }
; { #JETPAC$720E }
; { #LUNARJETMAN$8506 }
; { #MARTIANOIDS$BD6A }
; { #PSSST$748F }
; { #SABREWULF$B8DD }
; { #TRANZAM$7097 }
; { #UNDERWURLDE$ADE0 }
; LIST#

; Draw Room Frame
;
; Used by the routine at #R$9147.
; .
; Clears #R$5E14 (so the next pass of #R$7DC3 draws the items in the
; room), reads the room's attribute from #R$A854 and draws the frame. The
; entry point at #R$9BF1 draws the frame of the room in #REGa, which is how
; #R$9731 draws the frame of room #N$96.
; The entry for the shape of the room in #R$A982 gives the width and height of
; the floor (written to #R$5E1D and #R$5E1E), the coordinates of the corners of
; the frame and the lists of the lines to draw between them (see #R$97A9 and
; #R$9809 for the frame of room #N$96). Each list has a corner to start from,
; followed by the corners to draw lines to, ending with #N$FF. The list of lists
; ends with #N$FF.
;
; A The room (at the entry point #R$9BF1)
;
; #PUSHS #POKES$5C78,$34,$02 #POKES$5CB0,$E9
; #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$7D9A,stop=$9150,clear=1,sp=$5E00)
; #SCR$01(room-frame-before)
; | #SIM(start=$9150,stop=$9153,sp=$5E00)
; #SCR$01(room-frame-after) } UDGTABLE# #POPS
; The frame of a cave room (room #N$30):
; #PUSHS #POKES$5C78,$34,$02 #POKES$5CB0,$E9 #UDGTABLE {
; #SIM(start=$7D9A,stop=$9147,clear=1,sp=$5E00)
; #POKES$EA91,$30
; #SIM(start=$9147,stop=$9153,sp=$5E00)
; #SCR$01(room-frame-cave) } UDGTABLE# #POPS
@label=DrawRoomFrame
c$9BEA XOR A         ; Reset #REGa.
 $9BEB LD ($5E14),A  ; Update the game flags in #R$5E14.
 $9BEE LD A,($EA91)  ; Fetch the room of the player from #R$EA91.
; This entry point is used by the routine at #R$9731.
@label=DrawRoomFrame_Room
*$9BF1 LD BC,$A854   ; Point #REGbc at the room attribute table at #R$A854.
 $9BF4 LD L,A        ; Keep the room in #REGl.
 $9BF5 LD H,$00      ; Clear the high byte of the room.
 $9BF7 ADD HL,HL     ; Multiply #REGhl by #N$02.
 $9BF8 ADD HL,BC     ; Add #REGbc to #REGhl to get the entry for the room.
 $9BF9 LD A,(HL)     ; Fetch the attribute of the room.
 $9BFA INC HL        ; Move on to the shape of the room.
 $9BFB LD ($5E1A),A  ; Update the room attribute in #R$5E1A.
 $9BFE EXX           ; Switch to the shadow registers.
 $9BFF LD HL,$5800   ; #REGhl'=#N$5800 (the attribute buffer).
 $9C02 LD BC,$1818   ; #REGbc'=#N($1818,$04,$04) (the size of the play area).
 $9C05 LD A,($5E1A)  ; Fetch the room attribute from #R$5E1A.
 $9C08 CALL $809A    ; Call #R$809A to fill the play area with the attribute.
 $9C0B EXX           ; Switch back to the main registers.
 $9C0C LD L,(HL)     ; Fetch the shape of the room.
 $9C0D LD H,$00      ; Clear the high byte of the shape.
 $9C0F ADD HL,HL     ; Multiply #REGhl by #N$02.
 $9C10 LD C,L        ; {Keep the shape multiplied by two in #REGbc.
 $9C11 LD B,H        ; }
 $9C12 ADD HL,HL     ; Multiply #REGhl by #N$02.
 $9C13 ADD HL,BC     ; Add #REGbc to #REGhl, to multiply the shape by #N$06.
 $9C14 LD BC,$A982   ; Point #REGbc at the room shape table at #R$A982.
 $9C17 ADD HL,BC     ; Add #REGbc to #REGhl to get the entry for the shape.
 $9C18 LD A,(HL)     ; Fetch the width.
 $9C19 INC HL        ; Move on to the next byte.
 $9C1A LD ($5E1D),A  ; Update the room width in #R$5E1D.
 $9C1D LD A,(HL)     ; Fetch the height.
 $9C1E INC HL        ; Move on to the next byte.
 $9C1F LD ($5E1E),A  ; Update the room height in #R$5E1E.
 $9C22 LD E,(HL)     ; Fetch the low byte of the address of the coordinates.
 $9C23 INC HL        ; Move on to the next byte.
 $9C24 LD D,(HL)     ; Fetch the high byte of the address of the coordinates.
 $9C25 INC HL        ; Move on to the next byte.
 $9C26 LD A,(HL)     ; Fetch the low byte of the address of the lists of lines.
 $9C27 INC HL        ; Move on to the next byte.
 $9C28 LD H,(HL)     ; Fetch the high byte of the address of the lists of
                     ; lines.
 $9C29 LD L,A        ; Keep the low byte of the address of the lists of lines
                     ; in #REGl.
 $9C2A PUSH DE       ; {Copy #REGde into #REGix, as the address of the
 $9C2B POP IX        ; coordinates.}
; Start a list. The corner to start from is found by changing the offsets
; in the instructions at #R$9C3D and #R$9C40.
 $9C2D PUSH BC       ; Stash #REGbc on the stack.
@label=DrawRoomFrame_List
*$9C2E POP BC        ; Restore #REGbc from the stack.
 $9C2F LD A,(HL)     ; Fetch the corner to start from.
 $9C30 INC HL        ; Move #REGhl on to the next byte.
 $9C31 CP $FF        ; {Return if there are no more lists.
 $9C33 RET Z         ; }
 $9C34 SLA A         ; Multiply the corner by #N$02.
 $9C36 LD ($9C3F),A  ; Write it as the offset in the instruction at #R$9C3D.
 $9C39 INC A         ; Increment it.
 $9C3A LD ($9C42),A  ; Write it as the offset in the instruction at #R$9C40.
 $9C3D LD C,(IX+$00) ; Fetch the X coordinate of the corner.
 $9C40 LD B,(IX+$00) ; Fetch the Y coordinate of the corner.
@label=DrawRoomFrame_Line
*$9C43 PUSH BC       ; Stash the coordinates of the corner on the stack.
 $9C44 LD A,(HL)     ; Fetch the corner to draw a line to.
 $9C45 INC HL        ; Move #REGhl on to the next byte.
 $9C46 CP $FF        ; {Jump to #R$9C2E if this is the end of the list.
 $9C48 JR Z,$9C2E    ; }
 $9C4A SLA A         ; Multiply the corner by #N$02.
 $9C4C LD ($9C55),A  ; Write it as the offset in the instruction at #R$9C53.
 $9C4F INC A         ; Increment it.
 $9C50 LD ($9C58),A  ; Write it as the offset in the instruction at #R$9C56.
 $9C53 LD E,(IX+$00) ; Fetch the X coordinate of the corner.
 $9C56 LD D,(IX+$00) ; Fetch the Y coordinate of the corner.
 $9C59 PUSH HL       ; Stash #REGhl on the stack.
 $9C5A CALL $9C79    ; Call #R$9C79 to draw the line.
 $9C5D POP HL        ; Restore #REGhl from the stack.
 $9C5E POP BC        ; Restore the coordinates of the first corner from the
                     ; stack.
 $9C5F JR $9C43      ; Jump back to #R$9C43 to draw the next line of the frame.

; Plot Pixel
;
; Used by the routine at #R$9C79.
; .
; Sets one pixel in the screen buffer.
; #PUSHS #POKES$5C78,$34,$02 #POKES$5CB0,$E9
; #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$7D9A,stop=$7DDC,clear=1,sp=$5E00)
; #SIM(start=$8093,stop=$0000,sp=$5B60)
; #SCR$08,$02,$09,$03,$03(plot-pixel-before)
; | #SIM(start=$9C61,stop=$0000,hl=$5018,sp=$5B60)
; #SCR$08,$02,$09,$03,$03(plot-pixel-after) } UDGTABLE# #POPS
;
; H The Y position
; L The X position
@label=PlotPixel
c$9C61 LD A,L        ; Fetch the X position.
 $9C62 AND %00000111 ; Keep only bits 0-2.
 $9C64 INC A         ; Add one, to get the number of shifts.
 $9C65 LD B,A        ; Keep the number of shifts in #REGb.
 $9C66 XOR A         ; Clear #REGa, ready to make the mask for the pixel.
 $9C67 SCF           ; Set the carry flag.
@label=PlotPixel_Mask
*$9C68 RRA           ; Rotate the carry flag into #REGa.
 $9C69 DJNZ $9C68    ; Decrease the shift counter by one and loop back to #R$9C68 until the
                     ; pixel is in position.
 $9C6B PUSH HL       ; Stash the position on the stack.
 $9C6C PUSH AF       ; Stash the pixel on the stack.
 $9C6D EX AF,AF'     ; Switch to the shadow #REGaf register.
 $9C6E PUSH AF       ; Stash it on the stack.
 $9C6F CALL $9BA2    ; Call #R$9BA2 to get the screen buffer address.
 $9C72 POP AF        ; Restore the shadow #REGaf register from the stack.
 $9C73 EX AF,AF'     ; Switch back to the main #REGaf register.
 $9C74 POP AF        ; Restore the pixel from the stack.
 $9C75 OR (HL)       ; Combine it with the byte in the screen buffer.
 $9C76 LD (HL),A     ; Write it back.
 $9C77 POP HL        ; Restore the position from the stack.
 $9C78 RET           ; Return.

; Draw Line
;
; Used by the routine at #R$9BEA.
; .
; Draws a line between two points with #R$9C61. The longer of the two
; distances is the number of steps, and the other changes by a fraction of
; a pixel at each step, which is worked out with #R$A379. The flags in #R$5E24
; have bit 0 set if the line goes down, and bit 1 set if it goes right.
; #PUSHS #POKES$5C78,$34,$02 #POKES$5CB0,$E9
; #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$7D9A,stop=$7DDC,clear=1,sp=$5E00)
; #SIM(start=$8093,stop=$0000,sp=$5B60)
; #SCR$02,$02,$03,$0C,$10(draw-line-before)
; | #SIM(start=$9C79,stop=$0000,bc=$2020,de=$9060,sp=$5B60)
; #SCR$02,$02,$03,$0C,$10(draw-line-after) } UDGTABLE# #POPS
;
; B The Y position of the first point
; C The X position of the first point
; D The Y position of the second point
; E The X position of the second point
@label=DrawLine
c$9C79 LD H,B        ; Keep the Y position of the first point in #REGh.
 $9C7A LD L,C        ; Keep the X position of the first point in #REGl.
 $9C7B LD C,$00      ; #REGc=#N$00 (the flags).
 $9C7D LD A,H        ; Fetch the Y position of the first point.
 $9C7E SUB D         ; Subtract the Y position of the second point.
 $9C7F JR NC,$9C85   ; Jump to #R$9C85 if the line does not go down.
 $9C81 NEG           ; Negate it, to make the distance positive.
 $9C83 SET 0,C       ; Set bit 0 of the flags.
@label=DrawLine_Width
*$9C85 LD B,A        ; Keep the distance up or down in #REGb.
 $9C86 LD A,L        ; Fetch the X position of the first point.
 $9C87 SUB E         ; Subtract the X position of the second point.
 $9C88 JR NC,$9C8E   ; Jump to #R$9C8E if the line does not go right.
 $9C8A NEG           ; Negate it, to make the distance positive.
 $9C8C SET 1,C       ; Set bit 1 of the flags.
@label=DrawLine_Direction
*$9C8E CP B          ; Compare the distance across with the distance up or
                     ; down.
 $9C8F EX AF,AF'     ; Switch to the shadow #REGaf register.
 $9C90 LD A,C        ; Fetch the flags.
 $9C91 LD ($5E24),A  ; Write the flags to #R$5E24.
 $9C94 EX AF,AF'     ; Switch back to the main #REGaf register.
 $9C95 JP C,$9CD6    ; Jump to #R$9CD6 if the distance up or down is more.
; The distance across is the most, so move one pixel across at each step.
 $9C98 LD ($5E23),A  ; Write the distance across to #R$5E23.
 $9C9B PUSH DE       ; Stash the second point on the stack.
 $9C9C PUSH HL       ; Stash the first point on the stack.
 $9C9D LD E,A        ; Keep the distance across in #REGe.
 $9C9E LD D,$00      ; Clear the high byte of the distance.
 $9CA0 LD L,D        ; Clear #REGl.
 $9CA1 LD H,B        ; #REGh=the distance up or down.
 $9CA2 CALL $A379    ; Call #R$A379 to work out the fraction of a pixel to move
                     ; up or down.
 $9CA5 LD A,($5E24)  ; Fetch the line flags from #R$5E24.
 $9CA8 BIT 0,A       ; {Jump to #R$9CAF if the line goes down.
 $9CAA JR NZ,$9CAF   ; }
 $9CAC CALL $A39E    ; Call #R$A39E to negate the fraction.
@label=DrawLine_StepAcross
*$9CAF LD A,($5E24)  ; Fetch the line flags from #R$5E24.
 $9CB2 BIT 1,A       ; Test bit 1.
 $9CB4 LD C,$01      ; #REGc=#N$01 (the step to the right).
 $9CB6 JR NZ,$9CBA   ; Jump to #R$9CBA if the line goes right.
 $9CB8 LD C,$FF      ; #REGc=#N$FF (the step to the left).
@label=DrawLine_Across
*$9CBA EX DE,HL      ; Switch #REGde and #REGhl.
 $9CBB POP HL        ; Restore the first point from the stack.
 $9CBC LD A,($5E23)  ; Fetch the line distance from #R$5E23.
 $9CBF INC A         ; Add one, to get the number of steps.
 $9CC0 LD B,A        ; Keep the number of steps in #REGb.
 $9CC1 LD A,E        ; #REGa=#REGe.
 $9CC2 EX AF,AF'     ; Switch to the shadow #REGaf register.
@label=DrawLine_AcrossLoop
*$9CC3 PUSH BC       ; Stash the number of steps and the step across on the
                     ; stack.
 $9CC4 CALL $9C61    ; Call #R$9C61 to plot the pixel.
 $9CC7 LD A,L        ; #REGa=#REGl.
 $9CC8 EX AF,AF'     ; Switch #REGa with the shadow #REGa.
 $9CC9 LD L,A        ; #REGl=#REGa.
 $9CCA ADD HL,DE     ; Add the fraction to the position.
 $9CCB LD A,L        ; #REGa=#REGl.
 $9CCC EX AF,AF'     ; Switch #REGa with the shadow #REGa.
 $9CCD POP BC        ; Restore the number of steps and the step across from the
                     ; stack.
 $9CCE ADD A,C       ; Move to the next pixel across.
 $9CCF LD L,A        ; #REGl=#REGa.
 $9CD0 DJNZ $9CC3    ; Decrease the number of steps by one and loop back to #R$9CC3 until
                     ; every pixel of the line has been plotted.
 $9CD2 POP HL        ; Restore the second point from the stack.
 $9CD3 JP $9C61      ; Jump to #R$9C61 to plot the last pixel.
; The distance up or down is the most, so move one pixel up or down at
; each step.
@label=DrawLine_Height
*$9CD6 EX AF,AF'     ; Switch to the shadow #REGaf register.
 $9CD7 LD A,B        ; Fetch the distance up or down.
 $9CD8 LD ($5E23),A  ; Write the distance up or down to #R$5E23.
 $9CDB EX AF,AF'     ; Switch back to the main #REGaf register.
 $9CDC PUSH DE       ; Stash the second point on the stack.
 $9CDD PUSH HL       ; Stash the first point on the stack.
 $9CDE LD E,B        ; Keep the distance up or down in #REGe.
 $9CDF LD D,$00      ; Clear the high byte of the distance.
 $9CE1 LD L,D        ; Clear #REGl.
 $9CE2 LD H,A        ; #REGh=the distance across.
 $9CE3 CALL $A379    ; Call #R$A379 to work out the fraction of a pixel to move
                     ; across.
 $9CE6 LD A,($5E24)  ; Fetch the line flags from #R$5E24.
 $9CE9 BIT 1,A       ; {Jump to #R$9CF0 if the line goes right.
 $9CEB JR NZ,$9CF0   ; }
 $9CED CALL $A39E    ; Call #R$A39E to negate the fraction.
@label=DrawLine_StepDown
*$9CF0 LD A,($5E24)  ; Fetch the line flags from #R$5E24.
 $9CF3 BIT 0,A       ; Test bit 0.
 $9CF5 LD C,$01      ; #REGc=#N$01 (the step down).
 $9CF7 JR NZ,$9CFB   ; Jump to #R$9CFB if the line goes down.
 $9CF9 LD C,$FF      ; #REGc=#N$FF (the step up).
@label=DrawLine_Down
*$9CFB EX DE,HL      ; Switch #REGde and #REGhl.
 $9CFC POP HL        ; Restore the first point from the stack.
 $9CFD LD A,($5E23)  ; Fetch the line distance from #R$5E23.
 $9D00 INC A         ; Add one, to get the number of steps.
 $9D01 LD B,A        ; Keep the number of steps in #REGb.
 $9D02 LD A,E        ; #REGa=#REGe.
 $9D03 EX AF,AF'     ; Switch to the shadow #REGaf register.
@label=DrawLine_DownLoop
*$9D04 PUSH BC       ; Stash the number of steps and the step down on the
                     ; stack.
 $9D05 CALL $9C61    ; Call #R$9C61 to plot the pixel.
 $9D08 LD A,H        ; #REGa=#REGh.
 $9D09 EX AF,AF'     ; Switch #REGa with the shadow #REGa.
 $9D0A LD H,L        ; #REGh=#REGl.
 $9D0B LD L,A        ; #REGl=#REGa.
 $9D0C ADD HL,DE     ; Add the fraction to the position.
 $9D0D LD A,L        ; #REGa=#REGl.
 $9D0E LD L,H        ; #REGl=#REGh.
 $9D0F EX AF,AF'     ; Switch #REGa with the shadow #REGa.
 $9D10 POP BC        ; Restore the number of steps and the step down from the
                     ; stack.
 $9D11 ADD A,C       ; Move to the next pixel down.
 $9D12 LD H,A        ; #REGh=#REGa.
 $9D13 DJNZ $9D04    ; Decrease the number of steps by one and loop back to #R$9D04 until
                     ; every pixel of the line has been plotted.
 $9D15 POP HL        ; Restore the second point from the stack.
 $9D16 JP $9C61      ; Jump to #R$9C61 to plot the last pixel.

; Get Blend Instruction
;
; Used by the routines at #R$99C9, #R$99E5, #R$9A0A, #R$9A50, #R$9ACB, #R$9AEF,
; #R$9B14 and #R$9B5D.
; .
; Gets the instruction that #R$9962 uses to mix a graphic with what is on
; the screen, from bits 0-1 of the attribute.
; #TABLE(default,centre,left)
; { =h Bits 0-1 | =h Instruction }
; { #N$00 | #N$00 (NOP), which replaces what is on the screen }
; { #N$01 | #N$B6 (OR (HL)) }
; { #N$02 | #N$AE (XOR (HL)) }
; { #N$03 | #N$AE (XOR (HL)) }
; TABLE#
;
;   B The attribute
; O:A The instruction
@label=GetBlendInstruction
c$9D19 LD A,B        ; Fetch the attribute.
 $9D1A AND %00000011 ; Keep only bits 0-1.
 $9D1C RET Z         ; Return if #N$00 (no blending).
 $9D1D CP $01        ; Compare #REGa with #N$01...
 $9D1F LD A,$AE      ; #REGa=#N$AE.
 $9D21 RET NZ        ; Return if the comparison was not zero (XOR blending).
 $9D22 ADD A,$08     ; #REGa+=#N$08.
 $9D24 RET           ; Return (OR blending).

; Set Attributes Upright
;
; The handler of #R$9980 for a graphic that is as it is stored. Each
; attribute byte is written to the attribute buffer, unless it is #N$00 (which
; leaves the attribute as it is) or #N$FF (which uses the attribute of the room
; from #R$5E1A). Each row is a line up from the last, as in #R$99C9.
@label=SetAttributes_Upright
c$9D25 POP BC        ; Restore the attribute and graphic ID from the stack.
 $9D26 CALL $99AF    ; Call #R$99AF to get the details of the attributes.
@label=SetAttributes_Upright_Row
*$9D29 PUSH BC       ; Stash the width and height on the stack.
 $9D2A PUSH HL       ; Stash the attribute buffer address on the stack.
@label=SetAttributes_Upright_Cell
*$9D2B LD A,(DE)     ; Fetch the next attribute.
 $9D2C INC DE        ; Move #REGde on to the next byte.
 $9D2D AND A         ; {Jump to #R$9D38 if it is #N$00.
 $9D2E JR Z,$9D38    ; }
 $9D30 CP $FF        ; {Jump to #R$9D37 if it is not #N$FF.
 $9D32 JR NZ,$9D37   ; }
 $9D34 LD A,($5E1A)  ; Fetch the room attribute from #R$5E1A.
@label=SetAttributes_Upright_Write
*$9D37 LD (HL),A     ; Write #REGa to the attribute buffer.
@label=SetAttributes_Upright_Next
*$9D38 INC L         ; Move #REGhl on to the next cell.
 $9D39 DJNZ $9D2B    ; Decrease the width by one and loop back to #R$9D2B until all of the
                     ; cells in the row have been set.
 $9D3B POP HL        ; Restore the attribute buffer address from the stack.
 $9D3C LD BC,$0020   ; #REGbc=#N($0020,$04,$04) (the size of a row of the attribute
                     ; buffer).
 $9D3F AND A         ; {Move up a row.
 $9D40 SBC HL,BC     ; }
 $9D42 POP BC        ; Restore the width and height from the stack.
 $9D43 DEC C         ; {Decrease the height by one and loop back to #R$9D29 until all of the
 $9D44 JR NZ,$9D29   ; rows have been set.}
 $9D46 RET           ; Return.

; Set Attributes Mirrored
;
; The handler of #R$9980 for a graphic that is mirrored from left to
; right.
; This is the same as #R$9D25, except that each row is read from its end.
@label=SetAttributes_Mirrored
c$9D47 POP BC        ; Restore the attribute and graphic ID from the stack.
 $9D48 CALL $99AF    ; Call #R$99AF to get the details of the attributes.
 $9D4B DEC DE        ; Move #REGde back one byte.
@label=SetAttributes_Mirrored_Row
*$9D4C CALL $9A9D    ; Call #R$9A9D to move #REGde on to the end of the row.
 $9D4F PUSH BC       ; Stash the width and height on the stack.
 $9D50 PUSH DE       ; Stash the position in the attributes on the stack.
 $9D51 PUSH HL       ; Stash the attribute buffer address on the stack.
@label=SetAttributes_Mirrored_Cell
*$9D52 LD A,(DE)     ; Fetch the next attribute.
 $9D53 DEC DE        ; Move #REGde back one byte.
 $9D54 AND A         ; {Jump to #R$9D5F if it is #N$00.
 $9D55 JR Z,$9D5F    ; }
 $9D57 CP $FF        ; {Jump to #R$9D5E if it is not #N$FF.
 $9D59 JR NZ,$9D5E   ; }
 $9D5B LD A,($5E1A)  ; Fetch the room attribute from #R$5E1A.
@label=SetAttributes_Mirrored_Write
*$9D5E LD (HL),A     ; Write #REGa to the attribute buffer.
@label=SetAttributes_Mirrored_Next
*$9D5F INC L         ; Move #REGhl on to the next cell.
 $9D60 DJNZ $9D52    ; Decrease the width by one and loop back to #R$9D52 until all of the
                     ; cells in the row have been set.
 $9D62 POP HL        ; Restore the attribute buffer address from the stack.
 $9D63 LD BC,$0020   ; #REGbc=#N($0020,$04,$04) (the size of a row of the attribute
                     ; buffer).
 $9D66 AND A         ; {Move up a row.
 $9D67 SBC HL,BC     ; }
 $9D69 POP DE        ; Restore the position in the attributes from the stack.
 $9D6A POP BC        ; Restore the width and height from the stack.
 $9D6B DEC C         ; {Decrease the height by one and loop back to #R$9D4C until all of the
 $9D6C JR NZ,$9D4C   ; rows have been set.}
 $9D6E RET           ; Return.

; Set Attributes Rotated Left
;
; The handler of #R$9980 for a graphic that is turned a quarter turn
; anti-clockwise. This is the same as #R$9D25, except that each row of the
; screen is made from a column of the attributes, from the right-hand side to
; the left-hand side.
@label=SetAttributes_RotatedLeft
c$9D6F POP BC        ; Restore the attribute and graphic ID from the stack.
 $9D70 CALL $99AF    ; Call #R$99AF to get the details of the attributes.
 $9D73 LD A,B        ; Fetch the width.
 $9D74 EXX           ; Switch to the shadow registers.
 $9D75 LD B,A        ; Keep the number of columns in #REGb'.
 $9D76 EXX           ; Switch back to the main registers.
 $9D77 CALL $9A9D    ; Call #R$9A9D to move #REGde on to the second row.
@label=SetAttributes_RotatedLeft_Row
*$9D7A DEC DE        ; Move #REGde back to the previous column (at first, the last byte of
                     ; the first row).
 $9D7B PUSH BC       ; Stash the width and height on the stack.
 $9D7C PUSH DE       ; Stash the position in the attributes on the stack.
 $9D7D PUSH HL       ; Stash the attribute buffer address on the stack.
@label=SetAttributes_RotatedLeft_Cell
*$9D7E LD A,(DE)     ; Fetch the next attribute.
 $9D7F AND A         ; {Jump to #R$9D8A if it is #N$00.
 $9D80 JR Z,$9D8A    ; }
 $9D82 CP $FF        ; {Jump to #R$9D89 if it is not #N$FF.
 $9D84 JR NZ,$9D89   ; }
 $9D86 LD A,($5E1A)  ; Fetch the room attribute from #R$5E1A.
@label=SetAttributes_RotatedLeft_Write
*$9D89 LD (HL),A     ; Write #REGa to the attribute buffer.
@label=SetAttributes_RotatedLeft_Next
*$9D8A CALL $9A9D    ; Call #R$9A9D to move down to the next row of the
                     ; attributes.
 $9D8D INC L         ; Move #REGhl on to the next cell.
 $9D8E DEC C         ; {Decrease the height by one and loop back to #R$9D7E until all of the
 $9D8F JR NZ,$9D7E   ; rows have been set.}
 $9D91 POP HL        ; Restore the attribute buffer address from the stack.
 $9D92 LD BC,$0020   ; #REGbc=#N($0020,$04,$04) (the size of a row of the attribute
                     ; buffer).
 $9D95 AND A         ; {Move up a row.
 $9D96 SBC HL,BC     ; }
 $9D98 POP DE        ; Restore the position in the attributes from the stack.
 $9D99 POP BC        ; Restore the width and height from the stack.
 $9D9A EXX           ; Switch to the shadow registers.
 $9D9B DEC B         ; Decrease the number of columns by one.
 $9D9C EXX           ; Switch back to the main registers.
 $9D9D JR NZ,$9D7A   ; Jump to #R$9D7A until all of the columns are done.
 $9D9F RET           ; Return.

; Set Attributes Transposed
;
; The handler of #R$9980 for a graphic that is flipped along the diagonal
; from top left to bottom right. This is the same as #R$9D6F, except that the
; columns of the attributes are used from the left-hand side to the right-hand
; side.
@label=SetAttributes_Transposed
c$9DA0 POP BC        ; Restore the attribute and graphic ID from the stack.
 $9DA1 CALL $99AF    ; Call #R$99AF to get the details of the attributes.
 $9DA4 LD A,B        ; Fetch the width.
 $9DA5 EXX           ; Switch to the shadow registers.
 $9DA6 LD B,A        ; Keep the number of columns in #REGb'.
 $9DA7 EXX           ; Switch back to the main registers.
@label=SetAttributes_Transposed_Row
*$9DA8 PUSH BC       ; Stash the width and height on the stack.
 $9DA9 PUSH DE       ; Stash the position in the attributes on the stack.
 $9DAA PUSH HL       ; Stash the attribute buffer address on the stack.
@label=SetAttributes_Transposed_Cell
*$9DAB LD A,(DE)     ; Fetch the next attribute.
 $9DAC AND A         ; {Jump to #R$9DB7 if it is #N$00.
 $9DAD JR Z,$9DB7    ; }
 $9DAF CP $FF        ; {Jump to #R$9DB6 if it is not #N$FF.
 $9DB1 JR NZ,$9DB6   ; }
 $9DB3 LD A,($5E1A)  ; Fetch the room attribute from #R$5E1A.
@label=SetAttributes_Transposed_Write
*$9DB6 LD (HL),A     ; Write #REGa to the attribute buffer.
@label=SetAttributes_Transposed_Next
*$9DB7 CALL $9A9D    ; Call #R$9A9D to move down to the next row of the
                     ; attributes.
 $9DBA INC L         ; Move #REGhl on to the next cell.
 $9DBB DEC C         ; {Decrease the height by one and loop back to #R$9DAB until all of the
 $9DBC JR NZ,$9DAB   ; rows have been set.}
 $9DBE POP HL        ; Restore the attribute buffer address from the stack.
 $9DBF LD BC,$0020   ; #REGbc=#N($0020,$04,$04) (the size of a row of the attribute
                     ; buffer).
 $9DC2 AND A         ; {Move up a row.
 $9DC3 SBC HL,BC     ; }
 $9DC5 POP DE        ; Restore the position in the attributes from the stack.
 $9DC6 POP BC        ; Restore the width and height from the stack.
 $9DC7 INC DE        ; Move #REGde on to the next column.
 $9DC8 EXX           ; Switch to the shadow registers.
 $9DC9 DEC B         ; Decrease the number of columns by one.
 $9DCA EXX           ; Switch back to the main registers.
 $9DCB JR NZ,$9DA8   ; Jump to #R$9DA8 until all of the columns are done.
 $9DCD RET           ; Return.

; Set Attributes Flipped
;
; The handler of #R$9980 for a graphic that is flipped from top to bottom.
; This is the same as #R$9D25, except that it starts from the last row and works
; back up with #R$9AA5.
@label=SetAttributes_Flipped
c$9DCE POP BC        ; Restore the attribute and graphic ID from the stack.
 $9DCF CALL $99AF    ; Call #R$99AF to get the details of the attributes.
 $9DD2 CALL $9ABA    ; Call #R$9ABA to move on to the last row.
@label=SetAttributes_Flipped_Row
*$9DD5 PUSH BC       ; Stash the width and height on the stack.
 $9DD6 PUSH DE       ; Stash the position in the attributes on the stack.
 $9DD7 PUSH HL       ; Stash the attribute buffer address on the stack.
@label=SetAttributes_Flipped_Cell
*$9DD8 LD A,(DE)     ; Fetch the next attribute.
 $9DD9 INC DE        ; Move #REGde on to the next byte.
 $9DDA AND A         ; {Jump to #R$9DE5 if it is #N$00.
 $9DDB JR Z,$9DE5    ; }
 $9DDD CP $FF        ; {Jump to #R$9DE4 if it is not #N$FF.
 $9DDF JR NZ,$9DE4   ; }
 $9DE1 LD A,($5E1A)  ; Fetch the room attribute from #R$5E1A.
@label=SetAttributes_Flipped_Write
*$9DE4 LD (HL),A     ; Write #REGa to the attribute buffer.
@label=SetAttributes_Flipped_Next
*$9DE5 INC L         ; Move #REGhl on to the next cell.
 $9DE6 DJNZ $9DD8    ; Decrease the width by one and loop back to #R$9DD8 until all of the
                     ; cells in the row have been set.
 $9DE8 POP HL        ; Restore the attribute buffer address from the stack.
 $9DE9 LD BC,$0020   ; #REGbc=#N($0020,$04,$04) (the size of a row of the attribute
                     ; buffer).
 $9DEC AND A         ; {Move up a row.
 $9DED SBC HL,BC     ; }
 $9DEF POP DE        ; Restore the position in the attributes from the stack.
 $9DF0 POP BC        ; Restore the width and height from the stack.
 $9DF1 CALL $9AA5    ; Call #R$9AA5 to move back to the previous row of the
                     ; attributes.
 $9DF4 DEC C         ; {Decrease the height by one and loop back to #R$9DD5 until all of the
 $9DF5 JR NZ,$9DD5   ; rows have been set.}
 $9DF7 RET           ; Return.

; Set Attributes Rotated Half
;
; The handler of #R$9980 for a graphic that is turned a half turn. This is
; the same as #R$9D47, except that it starts from the end of the last row.
@label=SetAttributes_RotatedHalf
c$9DF8 POP BC        ; Restore the attribute and graphic ID from the stack.
 $9DF9 CALL $99AF    ; Call #R$99AF to get the details of the attributes.
 $9DFC CALL $9ABA    ; Call #R$9ABA to move on to the last row.
 $9DFF CALL $9A9D    ; Call #R$9A9D to move on to the end of the last row.
 $9E02 DEC DE        ; Move #REGde back one byte.
@label=SetAttributes_RotatedHalf_Row
*$9E03 PUSH BC       ; Stash the width and height on the stack.
 $9E04 PUSH HL       ; Stash the attribute buffer address on the stack.
@label=SetAttributes_RotatedHalf_Cell
*$9E05 LD A,(DE)     ; Fetch the next attribute.
 $9E06 DEC DE        ; Move #REGde back one byte.
 $9E07 AND A         ; {Jump to #R$9E12 if it is #N$00.
 $9E08 JR Z,$9E12    ; }
 $9E0A CP $FF        ; {Jump to #R$9E11 if it is not #N$FF.
 $9E0C JR NZ,$9E11   ; }
 $9E0E LD A,($5E1A)  ; Fetch the room attribute from #R$5E1A.
@label=SetAttributes_RotatedHalf_Write
*$9E11 LD (HL),A     ; Write #REGa to the attribute buffer.
@label=SetAttributes_RotatedHalf_Next
*$9E12 INC L         ; Move #REGhl on to the next cell.
 $9E13 DJNZ $9E05    ; Decrease the width by one and loop back to #R$9E05 until all of the
                     ; cells in the row have been set.
 $9E15 POP HL        ; Restore the attribute buffer address from the stack.
 $9E16 LD BC,$0020   ; #REGbc=#N($0020,$04,$04) (the size of a row of the attribute
                     ; buffer).
 $9E19 AND A         ; {Move up a row.
 $9E1A SBC HL,BC     ; }
 $9E1C POP BC        ; Restore the width and height from the stack.
 $9E1D DEC C         ; {Decrease the height by one and loop back to #R$9E03 until all of the
 $9E1E JR NZ,$9E03   ; rows have been set.}
 $9E20 RET           ; Return.

; Set Attributes Transposed Flipped
;
; The handler of #R$9980 for a graphic that is flipped along the diagonal
; from bottom left to top right. This is the same as #R$9D6F, except that it
; starts from the last row and works back up with #R$9AA5.
@label=SetAttributes_TransposedFlipped
c$9E21 POP BC        ; Restore the attribute and graphic ID from the stack.
 $9E22 CALL $99AF    ; Call #R$99AF to get the details of the attributes.
 $9E25 LD A,B        ; Fetch the width.
 $9E26 EXX           ; Switch to the shadow registers.
 $9E27 LD B,A        ; Keep the number of columns in #REGb'.
 $9E28 EXX           ; Switch back to the main registers.
 $9E29 CALL $9ABA    ; Call #R$9ABA to move on to the last row.
 $9E2C CALL $9A9D    ; Call #R$9A9D to move #REGde on to the end of the last
                     ; row.
@label=SetAttributes_TransposedFlipped_Row
*$9E2F DEC DE        ; Move #REGde back to the previous column (at first, the last byte of
                     ; the last row).
 $9E30 PUSH BC       ; Stash the width and height on the stack.
 $9E31 PUSH DE       ; Stash the position in the attributes on the stack.
 $9E32 PUSH HL       ; Stash the attribute buffer address on the stack.
@label=SetAttributes_TransposedFlipped_Cell
*$9E33 LD A,(DE)     ; Fetch the next attribute.
 $9E34 AND A         ; {Jump to #R$9E3F if it is #N$00.
 $9E35 JR Z,$9E3F    ; }
 $9E37 CP $FF        ; {Jump to #R$9E3E if it is not #N$FF.
 $9E39 JR NZ,$9E3E   ; }
 $9E3B LD A,($5E1A)  ; Fetch the room attribute from #R$5E1A.
@label=SetAttributes_TransposedFlipped_Write
*$9E3E LD (HL),A     ; Write #REGa to the attribute buffer.
@label=SetAttributes_TransposedFlipped_Next
*$9E3F CALL $9AA5    ; Call #R$9AA5 to move up to the previous row of the
                     ; attributes.
 $9E42 INC L         ; Move #REGhl on to the next cell.
 $9E43 DEC C         ; {Decrease the height by one and loop back to #R$9E33 until all of the
 $9E44 JR NZ,$9E33   ; rows have been set.}
 $9E46 POP HL        ; Restore the attribute buffer address from the stack.
 $9E47 LD BC,$0020   ; #REGbc=#N($0020,$04,$04) (the size of a row of the attribute
                     ; buffer).
 $9E4A AND A         ; {Move up a row.
 $9E4B SBC HL,BC     ; }
 $9E4D POP DE        ; Restore the position in the attributes from the stack.
 $9E4E POP BC        ; Restore the width and height from the stack.
 $9E4F EXX           ; Switch to the shadow registers.
 $9E50 DEC B         ; Decrease the number of columns by one.
 $9E51 EXX           ; Switch back to the main registers.
 $9E52 JR NZ,$9E2F   ; Jump to #R$9E2F until all of the columns are done.
 $9E54 RET           ; Return.

; Set Attributes Rotated Right
;
; The handler of #R$9980 for a graphic that is turned a quarter turn
; clockwise. This is the same as #R$9DA0, except that it starts from the last
; row and works back up with #R$9AA5.
@label=SetAttributes_RotatedRight
c$9E55 POP BC        ; Restore the attribute and graphic ID from the stack.
 $9E56 CALL $99AF    ; Call #R$99AF to get the details of the attributes.
 $9E59 LD A,B        ; Fetch the width.
 $9E5A EXX           ; Switch to the shadow registers.
 $9E5B LD B,A        ; Keep the number of columns in #REGb'.
 $9E5C EXX           ; Switch back to the main registers.
 $9E5D CALL $9ABA    ; Call #R$9ABA to move on to the last row.
@label=SetAttributes_RotatedRight_Row
*$9E60 PUSH BC       ; Stash the width and height on the stack.
 $9E61 PUSH DE       ; Stash the position in the attributes on the stack.
 $9E62 PUSH HL       ; Stash the attribute buffer address on the stack.
@label=SetAttributes_RotatedRight_Cell
*$9E63 LD A,(DE)     ; Fetch the next attribute.
 $9E64 AND A         ; {Jump to #R$9E6F if it is #N$00.
 $9E65 JR Z,$9E6F    ; }
 $9E67 CP $FF        ; {Jump to #R$9E6E if it is not #N$FF.
 $9E69 JR NZ,$9E6E   ; }
 $9E6B LD A,($5E1A)  ; Fetch the room attribute from #R$5E1A.
@label=SetAttributes_RotatedRight_Write
*$9E6E LD (HL),A     ; Write #REGa to the attribute buffer.
@label=SetAttributes_RotatedRight_Next
*$9E6F CALL $9AA5    ; Call #R$9AA5 to move up to the previous row of the
                     ; attributes.
 $9E72 INC L         ; Move #REGhl on to the next cell.
 $9E73 DEC C         ; {Decrease the height by one and loop back to #R$9E63 until all of the
 $9E74 JR NZ,$9E63   ; rows have been set.}
 $9E76 POP HL        ; Restore the attribute buffer address from the stack.
 $9E77 LD BC,$0020   ; #REGbc=#N($0020,$04,$04) (the size of a row of the attribute
                     ; buffer).
 $9E7A AND A         ; {Move up a row.
 $9E7B SBC HL,BC     ; }
 $9E7D POP DE        ; Restore the position in the attributes from the stack.
 $9E7E POP BC        ; Restore the width and height from the stack.
 $9E7F INC DE        ; Move #REGde on to the next column.
 $9E80 EXX           ; Switch to the shadow registers.
 $9E81 DEC B         ; Decrease the number of columns by one.
 $9E82 EXX           ; Switch back to the main registers.
 $9E83 JR NZ,$9E60   ; Jump to #R$9E60 until all of the columns are done.
 $9E85 RET           ; Return.

; Get Sprite "A"
;
; Used by the routine at #R$9F80.
; .
; Fetches the address of the graphic for the sprite ID that was recorded
; by #R$9FFB.
;
; O:DE The sprite address
@label=GetSpriteA
c$9E86 LD A,($5E15)  ; #REGa=the sprite ID from #R$5E15.
; View the equivalent code in;
; #LIST
; { #SABREWULF$B925 }
; { #UNDERWURLDE$9643 }
; LIST#
; .
; Continue on to #R$9E89.

; Fetch Sprite
;
; Used by the routines at #R$8CB7, #R$8D45, #R$8EA0 and #R$9E96.
; .
; Looks up the address of the graphic for a sprite in the table at
; #R$A4BE. The table has a two byte entry for each sprite ID, starting at
; ID #N$01.
;
;   A The sprite ID
; O:DE The sprite address
@label=FetchSprite
c$9E89 DEC A         ; Decrease the sprite ID by one, as the table starts at ID
                     ; #N$01.
 $9E8A LD L,A        ; {Fetch the sprite ID.
 $9E8B LD H,$00      ; }
 $9E8D ADD HL,HL     ; Multiply by #N$02, as each entry in the table is a two
                     ; byte address.
 $9E8E LD BC,$A4BE   ; {#REGhl=#R$A4BE + the offset of the entry.
 $9E91 ADD HL,BC     ; }
 $9E92 LD E,(HL)     ; {Fetch the sprite address.
 $9E93 INC HL        ;
 $9E94 LD D,(HL)     ; }
 $9E95 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #LUNARJETMAN$8568 }
; { #SABREWULF$B928 }
; { #SABREWULF$B934 }
; { #UNDERWURLDE$9646 }
; LIST#

; Fetch Actor Sprite
;
; Used by the routine at #R$9F9F.
; .
; Fetches the address of the graphic for the sprite ID of an entity (held
; in the first byte of its record), by using #R$9E89.
;
;   IX The entity
; O:DE The sprite address
@label=FetchActorSprite
c$9E96 LD A,(IX+$00) ; #REGa=the sprite ID from *#REGix+#N$00.
 $9E99 JR $9E89      ; Jump to #R$9E89 to fetch the sprite.
; View the equivalent code in;
; #LIST
; { #LUNARJETMAN$857F }
; { #SABREWULF$B934 }
; { #UNDERWURLDE$9652 }
; LIST#

; XOR Sprite Loop
;
; Used by the routines at #R$9F4A, #R$9F56 and #R$9FCA.
; .
; XORs the old sprite and the new sprite onto the screen one row at a
; time, working up from the bottom row. The row counters are in #REGc and
; #REGc' (in the normal and the shadow register sets), and each register set
; holds the screen address in #REGhl and the sprite data address in #REGde for
; one of the two sprites. When the counters run out, any rows left over in
; #R$5E18 and #R$5E19 are drawn.
; .
; Drawing a sprite a second time erases it, so the old sprite is removed
; from where it was and the new sprite is drawn where it is now.
@label=XORSpriteLoop
c$9E9B LD A,C        ; Fetch the number of rows of the old sprite that are
                     ; left.
 $9E9C AND A         ; {Jump to #R$9EAF if there are no rows of the old sprite
 $9E9D JR Z,$9EAF    ; left to draw.}
 $9E9F DEC C         ; Decrease the row counter by one.
 $9EA0 CALL $9EDC    ; Call #R$9EDC to draw the old sprite row.
 $9EA3 EXX           ; Switch to the shadow registers.
 $9EA4 LD A,C        ; Fetch the number of rows of the new sprite that are
                     ; left.
 $9EA5 AND A         ; {Jump to #R$9EAC if there are no rows of the new sprite
 $9EA6 JR Z,$9EAC    ; left to draw.}
@label=XORSpriteLoop_Actor
*$9EA8 DEC C         ; Decrease the row counter by one.
 $9EA9 CALL $9F21    ; Call #R$9F21 to draw the new sprite row.
@label=XORSpriteLoop_Next
*$9EAC EXX           ; Switch to the normal registers.
 $9EAD JR $9E9B      ; Jump to #R$9E9B to draw the sprites onto the screen.
@label=XORSpriteLoop_Swap
*$9EAF EXX           ; Switch to the shadow registers.
 $9EB0 LD A,C        ; Fetch the number of rows of the new sprite that are
                     ; left.
 $9EB1 AND A         ; {Jump to #R$9EA8 if there are more rows of the new
 $9EB2 JR NZ,$9EA8   ; sprite to draw.}
; This entry point is used by the routine at #R$9FCA.
@label=XORSpriteLoop_Restore
*$9EB4 EXX           ; Switch to the normal registers.
; This entry point is used by the routine at #R$9FCA.
; .
; Fetch the number of rows left over from the old sprite and the new
; sprite. If there are none then the drawing is finished.
@label=XORSpriteLoop_Remaining
*$9EB5 LD A,($5E18)  ; {Fetch the number of old sprite rows from #R$5E18 and keep it in
 $9EB8 LD C,A        ; #REGc.}
 $9EB9 LD A,($5E19)  ; Fetch the number of new sprite rows from #R$5E19.
 $9EBC OR C          ; {Return if there are no rows left to draw.
 $9EBD RET Z         ; }
 $9EBE XOR A         ; #REGa=#N$00.
 $9EBF LD ($5E18),A  ; Update the number of old sprite rows in #R$5E18.
 $9EC2 EXX           ; Switch to the shadow registers.
 $9EC3 LD A,($5E19)  ; {Fetch the number of new sprite rows from #R$5E19 and keep it in
 $9EC6 LD C,A        ; #REGc.}
 $9EC7 XOR A         ; #REGa=#N$00.
; This entry point is used by the routine at #R$9FCA.
@label=XORSpriteLoop_Continue
*$9EC8 LD ($5E19),A  ; Update the number of new sprite rows in #R$5E19.
 $9ECB EXX           ; Switch to the normal registers.
 $9ECC JR $9E9B      ; Jump to #R$9E9B to draw the sprites onto the screen.
; View the equivalent code in;
; #LIST
; { #COOKIE$763A }
; { #SABREWULF$B9DA }
; { #UNDERWURLDE$9728 }
; LIST#

; Draw Old Sprite Row
;
; XORs one row of the old sprite onto the screen, then moves up to the
; row above. The row is two bytes of graphic data, which are written to two
; bytes of the screen when the sprite is aligned to a character cell, and
; otherwise are shifted along and written to three bytes.
;
;   DE The address of the row of sprite data
;   HL The screen address
; O:DE The address of the next row of sprite data
; O:HL The screen address of the row above
;
; The entry point for a sprite which is aligned to a character cell.
; #R$9EE4 jumps here when the shift is the one which does nothing.
@label=DrawOldSpriteRow_Aligned
c$9ECE EX DE,HL      ; #REGde=the row of sprite data, and #REGhl=the address of the next
                     ; row.
 $9ECF EX (SP),HL    ; Fetch the screen address, and the address of the next row of sprite
                     ; data is stored on the stack.
 $9ED0 LD A,D        ; Fetch the first byte of the row.
 $9ED1 XOR (HL)      ; Exclusive OR it onto the screen.
 $9ED2 LD (HL),A     ; Write the result to the screen.
 $9ED3 INC L         ; Move to the next byte on the screen.
 $9ED4 LD A,E        ; Fetch the second byte of the row.
 $9ED5 XOR (HL)      ; Exclusive OR it onto the screen.
 $9ED6 LD (HL),A     ; Write the result to the screen.
 $9ED7 POP DE        ; Fetch the address of the next row of sprite data.
 $9ED8 DEC L         ; Move back to the first byte on the screen.
 $9ED9 JP $9F03      ; Jump to #R$9F03 to move up one pixel row.
; This entry point is used by the routine at #R$9E9B.
; .
; The entry point for a sprite which is not aligned to a character cell.
@label=DrawOldSpriteRow
*$9EDC EX DE,HL      ; #REGhl=the address of the sprite data, and #REGde=the screen
                     ; address.
 $9EDD PUSH DE       ; Stash the screen address on the stack.
 $9EDE LD D,(HL)     ; Fetch the first byte of the row.
 $9EDF INC HL        ; Move to the next byte of sprite data.
 $9EE0 LD E,(HL)     ; Fetch the second byte of the row.
 $9EE1 INC HL        ; Move on to the next row of sprite data.
 $9EE2 EX DE,HL      ; #REGhl=the row of sprite data, and #REGde=the address of the next
                     ; row.
 $9EE3 XOR A         ; #REGa=#N$00.
; Self modifying code; the operand of this command is written by
; #R$9F83(#N$9F91). It jumps into the run of shifts below so that the row is
; moved the right number of pixels, or to #R$9ECE for a sprite which does not
; need to be shifted.
@label=DrawOldSpriteRow_Shift
*$9EE4 JR $9EE4      ; Jump to the first shift to do.
; Shift the row left by up to seven bits; the bits which are shifted out
; of the row end up in #REGa.
 $9EE6 ADD HL,HL     ; {Shift #REGhl left by one, moving the bit shifted out into #REGa
 $9EE7 ADC A,A       ; (seven times).
 $9EE8 ADD HL,HL     ;
 $9EE9 ADC A,A       ;
 $9EEA ADD HL,HL     ;
 $9EEB ADC A,A       ;
 $9EEC ADD HL,HL     ;
 $9EED ADC A,A       ;
 $9EEE ADD HL,HL     ;
 $9EEF ADC A,A       ;
 $9EF0 ADD HL,HL     ;
 $9EF1 ADC A,A       ;
 $9EF2 ADD HL,HL     ;
 $9EF3 ADC A,A       ; }
 $9EF4 EX DE,HL      ; #REGde=the shifted row, and #REGhl=the address of the next row of
                     ; sprite data.
 $9EF5 EX (SP),HL    ; Fetch the screen address, and the address of the next row of sprite
                     ; data is stored on the stack.
 $9EF6 XOR (HL)      ; Exclusive OR the first byte (in #REGa) onto the screen.
 $9EF7 LD (HL),A     ; Write the result to the screen.
 $9EF8 INC L         ; Move to the next byte on the screen.
; This entry point is used by the routine at #R$9F13.
; .
; XOR the other two bytes onto the screen. #R$9F21 also finishes here.
@label=DrawSpriteRow_Write
*$9EF9 LD A,D        ; Fetch the second byte.
 $9EFA XOR (HL)      ; Exclusive OR it onto the screen.
 $9EFB LD (HL),A     ; Write the result to the screen.
 $9EFC INC L         ; Move to the next byte on the screen.
 $9EFD LD A,E        ; Fetch the third byte.
 $9EFE XOR (HL)      ; Exclusive OR it onto the screen.
 $9EFF LD (HL),A     ; Write the result to the screen.
 $9F00 POP DE        ; Fetch the address of the next row of sprite data.
 $9F01 DEC L         ; {Move back to the first byte on the screen.
 $9F02 DEC L         ; }

; Screen Address One Pixel Above
;
; Used by the routines at #R$99C9, #R$99E5, #R$9A0A, #R$9A50, #R$9ACB, #R$9AEF,
; #R$9B14, #R$9B5D, #R$9ECE, #R$9F13 and #R$A185.
; .
; Moves a screen address up by one pixel row, allowing for the layout of
; the screen. The XOR sprite row routines continue here so that they finish
; with the screen address of the row above the one just drawn.
;
;   HL The screen address
; O:HL The screen address one pixel row above
@label=ScreenPosition1PixelAbove
c$9F03 DEC H         ; Decrease #REGh by one to move up one pixel row within the character
                     ; cell.
 $9F04 LD A,H        ; #REGa=#REGh.
 $9F05 CPL           ; Flip the bits.
 $9F06 AND %00000111 ; Keep only bits 0-2.
 $9F08 RET NZ        ; Return if still inside the same character cell.
 $9F09 LD A,L        ; #REGa=#REGl.
 $9F0A SUB $20       ; Subtract #N$20 to move up a character row.
 $9F0C LD L,A        ; #REGl=#REGa.
 $9F0D RET C         ; Return if that moved into the previous third of the screen (the
                     ; address is then already correct).
 $9F0E LD A,H        ; #REGa=#REGh.
 $9F0F ADD A,$08     ; Add #N$08.
 $9F11 LD H,A        ; #REGh=#REGa.
 $9F12 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #CYBERUN$A1C3 }
; { #LUNARJETMAN$85F6 }
; { #PSSST$7585 }
; { #TRANZAM$6ECB }
; { #UNDERWURLDE$AE71 }
; LIST#

; Draw Actor Sprite Row
;
; Does the same as #R$9ECE, but for the sprite prepared by #R$9FA2 (the
; new sprite).
;
;   DE The address of the row of sprite data
;   HL The screen address
; O:DE The address of the next row of sprite data
; O:HL The screen address of the row above
;
; The entry point for a sprite which is aligned to a character cell.
; #R$9F29 jumps here when the shift is the one which does nothing.
@label=DrawActorSpriteRow_Aligned
c$9F13 EX DE,HL      ; #REGde=the row of sprite data, and #REGhl=the address of the next
                     ; row.
 $9F14 EX (SP),HL    ; Fetch the screen address, and the address of the next row of sprite
                     ; data is stored on the stack.
 $9F15 LD A,D        ; Fetch the first byte of the row.
 $9F16 XOR (HL)      ; Exclusive OR it onto the screen.
 $9F17 LD (HL),A     ; Write the result to the screen.
 $9F18 INC L         ; Move to the next byte on the screen.
 $9F19 LD A,E        ; Fetch the second byte of the row.
 $9F1A XOR (HL)      ; Exclusive OR it onto the screen.
 $9F1B LD (HL),A     ; Write the result to the screen.
 $9F1C POP DE        ; Fetch the address of the next row of sprite data.
 $9F1D DEC L         ; Move back to the first byte on the screen.
 $9F1E JP $9F03      ; Jump to #R$9F03 to move up one pixel row.
; This entry point is used by the routine at #R$9E9B.
; .
; The entry point for a sprite which is not aligned to a character cell.
@label=DrawActorSpriteRow
*$9F21 EX DE,HL      ; #REGhl=the address of the sprite data, and #REGde=the screen
                     ; address.
 $9F22 PUSH DE       ; Stash the screen address on the stack.
 $9F23 LD D,(HL)     ; Fetch the first byte of the row.
 $9F24 INC HL        ; Move to the next byte of sprite data.
 $9F25 LD E,(HL)     ; Fetch the second byte of the row.
 $9F26 INC HL        ; Move on to the next row of sprite data.
 $9F27 EX DE,HL      ; #REGhl=the row of sprite data, and #REGde=the address of the next
                     ; row.
 $9F28 XOR A         ; #REGa=#N$00.
; Self modifying code; the operand of this command is written by
; #R$9FA2(#N$9FB3). It jumps into the run of shifts below so that the row is
; moved the right number of pixels, or to #R$9F13 for a sprite which does not
; need to be shifted.
@label=DrawActorSpriteRow_Shift
*$9F29 JR $9F29      ; Jump to the first shift to do.
; Shift the row left by up to seven bits; the bits which are shifted out
; of the row end up in #REGa.
 $9F2B ADD HL,HL     ; {Shift #REGhl left by one, moving the bit shifted out into #REGa
 $9F2C ADC A,A       ; (seven times).
 $9F2D ADD HL,HL     ;
 $9F2E ADC A,A       ;
 $9F2F ADD HL,HL     ;
 $9F30 ADC A,A       ;
 $9F31 ADD HL,HL     ;
 $9F32 ADC A,A       ;
 $9F33 ADD HL,HL     ;
 $9F34 ADC A,A       ;
 $9F35 ADD HL,HL     ;
 $9F36 ADC A,A       ;
 $9F37 ADD HL,HL     ;
 $9F38 ADC A,A       ; }
 $9F39 EX DE,HL      ; #REGde=the shifted row, and #REGhl=the address of the next row of
                     ; sprite data.
 $9F3A EX (SP),HL    ; Fetch the screen address, and the address of the next row of sprite
                     ; data is stored on the stack.
 $9F3B XOR (HL)      ; Exclusive OR the first byte (in #REGa) onto the screen.
 $9F3C LD (HL),A     ; Write the result to the screen.
 $9F3D INC L         ; Move to the next byte on the screen.
 $9F3E JR $9EF9      ; Jump to #R$9EF9 to XOR the other two bytes onto the
                     ; screen.

; Unused Sprite Entry Points
;
; Not used by the game. These are versions of #R$9F4A and #R$9F56 which
; skip the code that finds the data for the sprite, for use when #REGde already
; holds the address of the sprite data.
;
; .
;
; Draws the sprite of the entity, without fetching the sprite data.
@label=Unused_SpriteEntryPoints
u$9F40 CALL $9FA2    ; Call #R$9FA2 (part of #R$9F9F).
 $9F43 JR $9F4D      ; Jump to #R$9F4D.
; Erases the sprite at the recorded position, without fetching the
; sprite data.
 $9F45 CALL $9F83    ; Call #R$9F83 (part of #R$9F80).
 $9F48 JR $9F59      ; Jump to #R$9F59.

; Draw Entity
;
; Used by the routines at #R$814B, #R$83EA, #R$875F, #R$8862, #R$8AFF, #R$8CB7,
; #R$9291, #R$9358, #R$9443, #R$95A9, #R$A14D, #R$A2CE and #R$A311.
; .
; Draws the sprite of an entity at its position. Only the pixels are
; drawn; the attributes are set by #R$A00E.
; The old sprite is given no rows, so only the new sprite is drawn.
;
; IX The entity
;
; #PUSHS #POKES$5C78,$34,$02 #POKES$5CB0,$E9
; #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$7D9A,stop=$7DDC,clear=1,sp=$5E00)
; #SCR$04,$0C,$0A,$05,$05(draw-entity-before)
; | #SIM(start=$9F4A,stop=$0000,ix=$EAC0,sp=$5B60)
; #SCR$04,$0C,$0A,$05,$05(draw-entity-after) } UDGTABLE# #POPS
@label=DrawEntity
c$9F4A CALL $9F9F    ; Prepare the sprite of the entity with #R$9F9F.
@label=DrawEntity_Prepared
 $9F4D EXX           ; Switch to the shadow registers.
 $9F4E XOR A         ; {Write #N$00 to #R$5E18.
 $9F4F LD ($5E18),A  ; }
 $9F52 LD C,A        ; Keep zero as the number of rows of the old sprite in
                     ; #REGc.
 $9F53 JP $9E9B      ; Jump to #R$9E9B to draw the sprites onto the screen.
; View the equivalent code in;
; #LIST
; { #COOKIE$7617 }
; { #SABREWULF$B919 }
; { #TRANZAM$7149 }
; { #UNDERWURLDE$962A }
; LIST#

; Remove Entity
;
; Used by the routines at #R$8209, #R$875F, #R$8C63, #R$9326 and #R$98C8.
; .
; Removes the image of an entity that was saved by #R$9FFB, by
; drawing it again (sprites are XORed onto the screen).
;
; IX The entity
;
; #PUSHS #POKES$5C78,$34,$02 #POKES$5CB0,$E9
; #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$7D9A,stop=$7DDC,clear=1,sp=$5E00)
; #SIM(start=$9F4A,stop=$0000,ix=$EAC0,sp=$5B60)
; #SIM(start=$A00E,stop=$0000,ix=$EAC0,sp=$5B60)
; #SIM(start=$9FFB,stop=$0000,ix=$EAC0,sp=$5B60)
; #SCR$04,$0C,$0A,$05,$05(remove-entity-before)
; | #SIM(start=$9F56,stop=$0000,ix=$EAC0,sp=$5B60)
; #SCR$04,$0C,$0A,$05,$05(remove-entity-after) } UDGTABLE# #POPS
@label=RemoveEntity
c$9F56 CALL $9F80    ; Prepare the old sprite with #R$9F80.
@label=RemoveEntity_Prepared
 $9F59 EXX           ; Switch to the shadow registers.
 $9F5A XOR A         ; #REGa=#N$00.
 $9F5B LD C,A        ; Keep zero as the number of rows of the new sprite in
                     ; #REGc.
 $9F5C LD ($5E19),A  ; Update the number of new sprite rows in #R$5E19.
 $9F5F LD A,($5E18)  ; Fetch the number of old sprite rows from #R$5E18.
 $9F62 LD ($5E11),A  ; Update the sprite height in #R$5E11.
; Work out the width of the sprite in bytes. The code uses #REGl from the
; shadow registers, which holds whatever an earlier routine left there.
 $9F65 LD A,L        ; #REGa=#REGl.
 $9F66 AND %00000111 ; Keep only bits 0-2.
 $9F68 LD A,$02      ; #REGa=#N$02.
 $9F6A JR Z,$9F6D    ; Jump to #R$9F6D if bits 0-2 were zero.
 $9F6C INC A         ; #REGa=#N$03.
@label=RemoveEntity_Width
*$9F6D LD ($5E10),A  ; Write the width to #R$5E10.
 $9F70 EXX           ; Switch to the normal registers.
 $9F71 JP $9E9B      ; Jump to #R$9E9B to draw the sprites onto the screen.
; View the equivalent code in;
; #LIST
; { #SABREWULF$B8F5 }
; { #TRANZAM$7139 }
; { #UNDERWURLDE$9636 }
; LIST#

; Unused Move Sprite Without Fetch
;
; Not used by the game. It is like #R$9FCA, but skips the code which
; finds the data for the sprites (#R$9E86 and #R$9E96), by entering the
; routines which prepare the sprites after that code. It then carries on at
; #R$9FD1.
@label=Unused_MoveSprite_NoFetch
u$9F74 PUSH DE       ; Stash #REGde on the stack.
 $9F75 CALL $9F83    ; Call #R$9F83 (part of #R$9F80).
 $9F78 EXX           ; Switch to the shadow registers.
 $9F79 POP DE        ; Restore #REGde from the stack.
 $9F7A CALL $9FA2    ; Call #R$9FA2 (part of #R$9F9F).
 $9F7D EXX           ; Switch to the normal registers.
 $9F7E JR $9FD1      ; Jump to #R$9FD1.

; Prepare Draw 2/ 3 Byte Sprite
;
; Used by the routines at #R$9F56 and #R$9FCA.
; .
; Gets everything ready to draw (or erase) the sprite at the position
; which was last recorded by #R$9FFB. Sprites are drawn using the exclusive OR
; operation, so drawing a sprite for a second time erases it.
; .
; The number of rows to draw is written to #R$5E18, and the shifting routine at
; #R$9ECE is set up to move the sprite along by the position MOD #N$08 pixels.
;
; O:C #N$00
; O:DE The address of the first row of sprite data to draw
; O:HL The screen address of the bottom row of the sprite
@label=PrepDraw23
c$9F80 CALL $9E86    ; Fetch the address of the old sprite with #R$9E86.
@label=PrepDraw23_NoFetch
 $9F83 LD HL,($5E16) ; #REGhl=#R$5E16 (the saved X position in #REGl and the saved Y
                     ; position in #REGh).
 $9F86 LD A,L        ; Fetch the X position.
 $9F87 DEC A         ; Decrease #REGa by one.
 $9F88 RLCA          ; Multiply by #N$02.
 $9F89 AND %00001110 ; Keep only bits 1-3.
 $9F8B CP $0E        ; {Jump to #R$9F91 if this is not the maximum offset.
 $9F8D JR NZ,$9F91   ; }
 $9F8F LD A,$E8      ; Use the offset which jumps to the code for sprites which are aligned
                     ; to a character cell.
; Self modifying code; this updates the operand of the JR command at
; #R$9EE4(#N$9EE5).
@label=PrepDraw23_Shift
*$9F91 LD ($9EE5),A  ; Write the offset to #R$9EE4(#N$9EE5).
 $9F94 CALL $9BA2    ; Call #R$9BA2 to get the screen address of the position.
 $9F97 LD A,(DE)     ; Fetch the number of rows in the sprite (the first byte of the sprite
                     ; data).
 $9F98 LD ($5E18),A  ; Write the number of rows to #R$5E18.
; This entry point is used by the routine at #R$9F9F.
@label=PrepDraw23_Finish
*$9F9B LD C,$00      ; #REGc=#N$00.
 $9F9D INC DE        ; Move past the height byte.
 $9F9E RET           ; Return.
; View the equivalent code in;
; #LIST
; { #SABREWULF$B939 }
; { #UNDERWURLDE$9657 }
; LIST#

; Prepare Draw 2 Byte Sprite
;
; Used by the routines at #R$9F4A and #R$9FCA.
; .
; Does the same as #R$9F80 for the sprite of the entity in #REGix (the new
; sprite). As well as the screen address, it records the width of the sprite in
; bytes in #R$5E10, the number of rows to draw in #R$5E19 and its height in
; #R$5E11. The shifting routine at #R$9F13 is set up for it.
;
;   IX The entity
; O:C #N$00
; O:DE The address of the first row of sprite data to draw
; O:HL The screen address of the bottom row of the sprite
@label=PrepDraw2
c$9F9F CALL $9E96    ; Fetch the address of the sprite of the entity with
                     ; #R$9E96.
@label=PrepDraw2_NoFetch
 $9FA2 LD L,(IX+$03) ; {#REGl=the entity X position, and #REGh=the entity Y
 $9FA5 LD H,(IX+$04) ; position.}
 $9FA8 LD A,L        ; Fetch the X position.
 $9FA9 DEC A         ; Decrease #REGa by one.
 $9FAA RLCA          ; Multiply by #N$02.
 $9FAB AND %00001110 ; Keep only bits 1-3.
 $9FAD CP $0E        ; {Jump to #R$9FB3 if this is not the maximum offset.
 $9FAF JR NZ,$9FB3   ; }
 $9FB1 LD A,$E8      ; Use the offset which jumps to the code for sprites which are aligned
                     ; to a character cell.
; Self modifying code; this updates the operand of the JR command at
; #R$9F29(#N$9F2A).
@label=PrepDraw2_Shift
*$9FB3 LD ($9F2A),A  ; Write the offset to #R$9F29(#N$9F2A).
; A sprite which is aligned to a character cell is two bytes wide,
; otherwise it is three bytes wide.
 $9FB6 LD A,$02      ; #REGa=#N$02.
 $9FB8 JR Z,$9FBB    ; Jump to #R$9FBB if the offset was the maximum offset.
 $9FBA INC A         ; #REGa=#N$03.
@label=PrepDraw2_Width
*$9FBB LD ($5E10),A  ; Write the width to #R$5E10.
 $9FBE CALL $9BA2    ; Call #R$9BA2 to get the screen address of the position.
 $9FC1 LD A,(DE)     ; Fetch the number of rows in the sprite (the first byte of the sprite
                     ; data).
 $9FC2 LD ($5E19),A  ; Write the number of rows to #R$5E19.
 $9FC5 LD ($5E11),A  ; Write the number of rows to #R$5E11.
 $9FC8 JR $9F9B      ; Jump to #R$9F9B to finish preparing the sprite.
; View the equivalent code in;
; #LIST
; { #SABREWULF$B969 }
; { #UNDERWURLDE$9689 }
; LIST#

; Display Entity
;
; Used by the routine at #R$8E26.
; .
; Erases the sprite from the position recorded by #R$9FFB and draws it at
; the new position held by the entity. The old and the new sprite are processed
; together so that the screen lines which they share are updated in step.
;
; IX The entity
@label=DisplayEntity
c$9FCA CALL $9F9F    ; Prepare the new sprite with #R$9F9F.
 $9FCD EXX           ; Switch to the shadow registers.
 $9FCE CALL $9F80    ; Prepare the old sprite with #R$9F80.
; Compare the vertical position of the old sprite with the new one.
@label=DisplayEntity_Compare
 $9FD1 LD A,($5E17)  ; Fetch the previous Y position from #R$5E17.
 $9FD4 SUB (IX+$04)  ; Subtract the new vertical position.
 $9FD7 JP Z,$9EB5    ; Jump to #R$9EB5 if they are the same.
 $9FDA JP M,$9FEC    ; Jump to #R$9FEC if the new sprite is lower down the
                     ; screen.
; The old sprite is lower down. Draw the rows of it which the new sprite
; does not cover first.
 $9FDD LD C,A        ; Fetch the number of rows.
 $9FDE LD A,($5E18)  ; Fetch the number of old sprite rows from #R$5E18.
 $9FE1 CP C          ; {Jump to #R$9EB5 if the sprites do not overlap.
 $9FE2 JP C,$9EB5    ; }
 $9FE5 SUB C         ; Subtract the rows which are about to be drawn.
 $9FE6 LD ($5E18),A  ; Write the number of rows remaining to #R$5E18.
 $9FE9 JP $9E9B      ; Jump to #R$9E9B to draw the sprites onto the screen.
; The new sprite is lower down. Draw the rows of it which the old sprite
; does not cover first.
@label=DisplayEntity_NewLower
*$9FEC EXX           ; Switch to the shadow registers.
 $9FED NEG           ; Make the number of rows positive.
 $9FEF LD C,A        ; Fetch the number of rows.
 $9FF0 LD A,($5E19)  ; Fetch the number of new sprite rows from #R$5E19.
 $9FF3 CP C          ; {Jump to #R$9EB4 if the sprites do not overlap.
 $9FF4 JP C,$9EB4    ; }
 $9FF7 SUB C         ; Subtract the rows which are about to be drawn.
 $9FF8 JP $9EC8      ; Jump to #R$9EC8 to write the number of rows remaining to
                     ; #R$5E19.
; View the equivalent code in;
; #LIST
; { #COOKIE$75CC }
; { #JETPAC$726A }
; { #SABREWULF$B9A9 }
; { #TRANZAM$7101 }
; { #UNDERWURLDE$96F7 }
; LIST#

; Store Entity
;
; Used by the routines at #R$81DB, #R$81F0, #R$82F1, #R$8301, #R$845F, #R$85F7,
; #R$862E, #R$8672, #R$871A, #R$8787, #R$87A6, #R$8862, #R$8906, #R$8988,
; #R$89ED, #R$8A2F, #R$8A80, #R$8AFF, #R$8C63, #R$8D77, #R$92F5 and #R$988B.
; .
; Saves the position and sprite ID of an entity so that #R$9F56 and
; #R$A01A can use them after the entity has moved.
;
; IX The entity
@label=StoreEntity
c$9FFB LD A,(IX+$03) ; {Write the entity X position to #R$5E16.
 $9FFE LD ($5E16),A  ; }
 $A001 LD A,(IX+$04) ; {Write the entity Y position to #R$5E17.
 $A004 LD ($5E17),A  ; }
 $A007 LD A,(IX+$00) ; {Write the entity sprite ID to #R$5E15.
 $A00A LD ($5E15),A  ; }
 $A00D RET           ; Return.
; View the equivalent code in;
; #LIST
; { #JETPAC$7327 }
; { #PSSST$75B9 }
; { #SABREWULF$BB0B }
; { #TRANZAM$71ED }
; { #UNDERWURLDE$989F }
; LIST#

; Set Entity Attributes
;
; Used by the routines at #R$A14D and #R$A311.
; .
; Colours the attribute cells under an entity. This entry point first
; saves the position of the entity as if it has not moved; #R$A01A
; instead uses the position saved by #R$9FFB to work out which way the
; entity has moved.
; .
; The cells under the entity are set to the attribute of the entity, and the
; cells which the entity has just left behind are put back to the attribute of
; the room (from #R$5E1A). Which way the entity has moved picks one of the
; routines in the table at #R$A064, and that routine is jumped to with the
; registers set up as follows:
; #TABLE(default,centre,left)
; { =h Register | =h Contents }
; { #REGb | The width of the sprite in cells }
; { #REGc | The number of rows of cells }
; { #REGd | The attribute of the entity }
; { #REGe | The attribute of the room }
; { #REGhl | The attribute address of the cell holding the position of the
; entity (the cell at the bottom left) }
; TABLE#
;
; IX The entity to colour
;
; #PUSHS #POKES$5C78,$34,$02 #POKES$5CB0,$E9
; #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$7D9A,stop=$7DDC,clear=1,sp=$5E00)
; #SIM(start=$9F4A,stop=$0000,ix=$EAC0,sp=$5B60)
; #SCR$04,$0C,$0A,$05,$05(set-attributes-before)
; | #SIM(start=$A00E,stop=$0000,ix=$EAC0,sp=$5B60)
; #SCR$04,$0C,$0A,$05,$05(set-attributes-after) } UDGTABLE# #POPS
@label=SetEntityAttributes
c$A00E LD A,(IX+$03) ; {Write the entity X position to #R$5E16.
 $A011 LD ($5E16),A  ; }
 $A014 LD A,(IX+$04) ; {Write the entity Y position to #R$5E17.
 $A017 LD ($5E17),A  ; }
; This entry point is used by the routines at #R$8209, #R$875F, #R$8E26,
; #R$92E0 and #R$9326.
; .
; Get the entity position, attribute and the room attribute.
@label=SetEntityAttributes_Moved
*$A01A LD L,(IX+$03) ; {#REGl=the entity X position, and #REGh=the entity Y
 $A01D LD H,(IX+$04) ; position.}
 $A020 LD D,(IX+$05) ; Fetch the attribute of the entity.
 $A023 LD A,($5E1A)  ; {#REGe=the room attribute from #R$5E1A.
 $A026 LD E,A        ; }
 $A027 LD A,($5E10)  ; {#REGb=the width of the sprite from #R$5E10.
 $A02A LD B,A        ; }
; Work out the number of rows of cells from the height of the sprite in
; pixels.
 $A02B LD A,($5E11)  ; #REGa=the height of the sprite from #R$5E11.
 $A02E RRCA          ; {Divide by #N$04.
 $A02F RRCA          ; }
 $A030 INC A         ; Increment #REGa by one.
 $A031 RRCA          ; Divide by #N$02.
 $A032 AND %00011111 ; Keep only bits 0-4.
 $A034 INC A         ; Increment #REGa by one.
 $A035 LD C,A        ; Keep the number of rows of cells in #REGc.
; Work out which way the entity has moved. The horizontal movement gives
; #N$00 (none), #N$01 (right) or #N$02 (left), and the vertical movement adds
; #N$00 (none), #N$04 (down) or #N$08 (up).
 $A036 PUSH BC       ; Stash the width and the number of rows on the stack.
 $A037 LD B,$00      ; #REGb=#N$00 (the direction so far, which is no
                     ; movement).
 $A039 LD A,($5E16)  ; Fetch the previous X position from #R$5E16.
 $A03C CP L          ; {Jump to #R$A043 if the X position is unchanged.
 $A03D JR Z,$A043    ; }
 $A03F JR C,$A042    ; Jump to #R$A042 if the entity has moved right.
 $A041 INC B         ; Add #N$01 to #REGb (the entity has moved left).
@label=SetEntityAttributes_Right
*$A042 INC B         ; Add #N$01 to #REGb.
@label=SetEntityAttributes_Vertical
*$A043 LD A,($5E17)  ; Fetch the previous Y position from #R$5E17.
 $A046 CP H          ; Compare the saved Y position against #REGh.
 $A047 LD A,B        ; Fetch the horizontal direction from #REGb.
 $A048 JR Z,$A050    ; Jump to #R$A050 if the Y position is unchanged.
 $A04A JR C,$A04E    ; Jump to #R$A04E if the entity has moved down.
 $A04C ADD A,$04     ; Add #N$04 to #REGa (the entity has moved up).
@label=SetEntityAttributes_Down
*$A04E ADD A,$04     ; Add #N$04 to #REGa.
@label=SetEntityAttributes_Select
*$A050 LD B,A        ; Stash the direction in #REGb.
 $A051 CALL $9BD2    ; Call #R$9BD2 to get the attribute address of the
                     ; position.
 $A054 LD A,B        ; Restore the direction into #REGa.
 $A055 POP BC        ; Restore the width and the number of rows from the stack.
 $A056 PUSH HL       ; Stash the attribute address on the stack.
 $A057 LD HL,$A064   ; Point #REGhl at the attribute jump table at #R$A064.
 $A05A SLA A         ; Multiply the direction by #N$02, as the table contains
                     ; addresses.
 $A05C CALL $926C    ; Call #R$926C to add it to the address of the table.
 $A05F LD A,(HL)     ; {Fetch the routine selected from the table.
 $A060 INC HL        ;
 $A061 LD H,(HL)     ;
 $A062 LD L,A        ; }
 $A063 JP (HL)       ; Jump to the routine.

; Attribute Jump Table
;
; The routines which colour the attribute cells under an entity, chosen
; by #R$A01A from the way the entity has moved. The direction is the
; horizontal movement plus the vertical movement.
; #TABLE(default,centre,left,left)
; { =h Direction | =h Movement | =h Routine }
; { #N$00 | Unchanged | #R$A07A }
; { #N$01 | Right | #R$A08D }
; { #N$02 | Left | #R$A0A3 }
; { #N$03 | (not possible) | #R$807A }
; { #N$04 | Down | #R$A0B7 }
; { #N$05 | Down and right | #R$A0D2 }
; { #N$06 | Down and left | #R$A110 }
; { #N$07 | (not possible) | #R$807A }
; { #N$08 | Up | #R$A0EC }
; { #N$09 | Up and right | #R$A127 }
; { #N$0A | Up and left | #R$A0FE }
; TABLE#
@label=AttributeJumpTable
w$A064 DEFW $A07A
 $A066 DEFW $A08D
 $A068 DEFW $A0A3
 $A06A DEFW $807A
 $A06C DEFW $A0B7
 $A06E DEFW $A0D2
 $A070 DEFW $A110
 $A072 DEFW $807A
 $A074 DEFW $A0EC
 $A076 DEFW $A127
 $A078 DEFW $A0FE

; Draw Attributes Unchanged
;
; The attribute routine for an entity which has not moved. Every cell
; under the entity is set to the attribute of the entity, a row at a time
; working up from the bottom row.
;
; B The width of the sprite in cells
; C The number of rows of cells
; D The attribute of the entity
; E The attribute of the room
@label=AttrDrawUnchanged
c$A07A POP HL        ; Restore the attribute address from the stack.
; This entry point is used by the routine at #R$A0EC.
@label=AttrDrawUnchanged_Row
*$A07B PUSH BC       ; Stash the width and the number of rows on the stack.
 $A07C PUSH HL       ; Stash the attribute address on the stack.
@label=AttrDrawUnchanged_Cell
*$A07D LD (HL),D     ; Write the attribute of the entity to the cell.
 $A07E INC L         ; Move to the next cell.
 $A07F DJNZ $A07D    ; Decrease the width by one and loop back to #R$A07D until the row is
                     ; done.
 $A081 POP HL        ; Restore the attribute address from the stack.
 $A082 LD BC,$0020   ; #REGbc=#N($0020,$04,$04).
 $A085 AND A         ; {Move up a row.
 $A086 SBC HL,BC     ; }
 $A088 POP BC        ; Restore the width and the number of rows from the stack.
 $A089 DEC C         ; {Decrease the number of rows by one and loop back to #R$A07B until
 $A08A JR NZ,$A07B   ; all of the rows have been set.}
 $A08C RET           ; Return.

; Draw Attributes Moving Right
;
; The attribute routine for an entity which has moved right. Each row of
; cells under the entity is set to the attribute of the entity, and the cell
; just to the left of it (which the entity has left) is put back to the
; attribute of the room.
;
; B The width of the sprite in cells
; C The number of rows of cells
; D The attribute of the entity
; E The attribute of the room
@label=AttrDrawMovingRight
c$A08D POP HL        ; Restore the attribute address from the stack.
; This entry point is used by the routine at #R$A127.
@label=AttrDrawMovingRight_Row
*$A08E PUSH BC       ; Stash the width and the number of rows on the stack.
 $A08F PUSH HL       ; Stash the attribute address on the stack.
 $A090 DEC L         ; Move to the cell on the left.
 $A091 LD (HL),E     ; Write the attribute of the room to the cell.
 $A092 INC L         ; Move back to the first cell.
@label=AttrDrawMovingRight_Cell
*$A093 LD (HL),D     ; Write the attribute of the entity to the cell.
 $A094 INC L         ; Move to the next cell.
 $A095 DJNZ $A093    ; Decrease the width by one and loop back to #R$A093 until the row is
                     ; done.
 $A097 POP HL        ; Restore the attribute address from the stack.
 $A098 LD BC,$0020   ; #REGbc=#N($0020,$04,$04).
 $A09B AND A         ; {Move up a row.
 $A09C SBC HL,BC     ; }
 $A09E POP BC        ; Restore the width and the number of rows from the stack.
 $A09F DEC C         ; {Decrease the number of rows by one and loop back to #R$A08E until
 $A0A0 JR NZ,$A08E   ; all of the rows have been set.}
 $A0A2 RET           ; Return.

; Draw Attributes Moving Left
;
; The attribute routine for an entity which has moved left. Each row of
; cells under the entity is set to the attribute of the entity, and the cell
; just to the right of it (which the entity has left) is put back to the
; attribute of the room.
;
; B The width of the sprite in cells
; C The number of rows of cells
; D The attribute of the entity
; E The attribute of the room
@label=AttrDrawMovingLeft
c$A0A3 POP HL        ; Restore the attribute address from the stack.
; This entry point is used by the routine at #R$A0FE.
@label=AttrDrawMovingLeft_Row
*$A0A4 PUSH BC       ; Stash the width and the number of rows on the stack.
 $A0A5 PUSH HL       ; Stash the attribute address on the stack.
@label=AttrDrawMovingLeft_Cell
*$A0A6 LD (HL),D     ; Write the attribute of the entity to the cell.
 $A0A7 INC L         ; Move to the next cell.
 $A0A8 DJNZ $A0A6    ; Decrease the width by one and loop back to #R$A0A6 until the row is
                     ; done.
 $A0AA LD (HL),E     ; Write the attribute of the room to the cell on the
                     ; right.
 $A0AB POP HL        ; Restore the attribute address from the stack.
 $A0AC LD BC,$0020   ; #REGbc=#N($0020,$04,$04).
 $A0AF AND A         ; {Move up a row.
 $A0B0 SBC HL,BC     ; }
 $A0B2 POP BC        ; Restore the width and the number of rows from the stack.
 $A0B3 DEC C         ; {Decrease the number of rows by one and loop back to #R$A0A4 until
 $A0B4 JR NZ,$A0A4   ; all of the rows have been set.}
 $A0B6 RET           ; Return.

; Draw Attributes Moving Down
;
; The attribute routine for an entity which has moved down. Each row of
; cells under the entity is set to the attribute of the entity, and the row
; just above it (which the entity has left) is put back to the attribute of the
; room.
;
; B The width of the sprite in cells
; C The number of rows of cells
; D The attribute of the entity
; E The attribute of the room
@label=AttrDrawMovingDown
c$A0B7 POP HL        ; Restore the attribute address from the stack.
@label=AttrDrawMovingDown_Row
*$A0B8 PUSH BC       ; Stash the width and the number of rows on the stack.
 $A0B9 PUSH HL       ; Stash the attribute address on the stack.
@label=AttrDrawMovingDown_Cell
*$A0BA LD (HL),D     ; Write the attribute of the entity to the cell.
 $A0BB INC L         ; Move to the next cell.
 $A0BC DJNZ $A0BA    ; Decrease the width by one and loop back to #R$A0BA until the row is
                     ; done.
 $A0BE POP HL        ; Restore the attribute address from the stack.
 $A0BF LD BC,$0020   ; #REGbc=#N($0020,$04,$04).
 $A0C2 AND A         ; {Move up a row.
 $A0C3 SBC HL,BC     ; }
 $A0C5 POP BC        ; Restore the width and the number of rows from the stack.
 $A0C6 DEC C         ; {Decrease the number of rows by one and loop back to #R$A0B8 until
 $A0C7 JR NZ,$A0B8   ; all of the rows have been set.}
; This entry point is used by the routines at #R$A0D2 and #R$A110.
; .
; Put the row above the entity back to the attribute of the room, unless
; it is above the start of the attributes.
@label=AttrDrawMovingDown_Above
*$A0C9 LD A,H        ; Fetch the high byte of the attribute address.
 $A0CA CP $58        ; {Return if the row is above the start of the attributes.
 $A0CC RET C         ; }
@label=AttrDrawMovingDown_Restore
*$A0CD LD (HL),E     ; Write the attribute of the room to the cell.
 $A0CE INC L         ; Move to the next cell.
 $A0CF DJNZ $A0CD    ; Decrease the width by one and loop back to #R$A0CD until the row is
                     ; done.
 $A0D1 RET           ; Return.

; Draw Attributes Moving Down-Right
;
; The attribute routine for an entity which has moved down and right.
; Each row of cells under the entity is set to the attribute of the entity, and
; the cell to the left of it is put back to the attribute of the room. So is
; the row above the entity, from one cell to the left of the entity.
;
; B The width of the sprite in cells
; C The number of rows of cells
; D The attribute of the entity
; E The attribute of the room
@label=AttrDrawMovingDownRight
c$A0D2 POP HL        ; Restore the attribute address from the stack.
@label=AttrDrawMovingDownRight_Row
*$A0D3 PUSH BC       ; Stash the width and the number of rows on the stack.
 $A0D4 PUSH HL       ; Stash the attribute address on the stack.
 $A0D5 DEC L         ; Move to the cell on the left.
 $A0D6 LD (HL),E     ; Write the attribute of the room to the cell.
 $A0D7 INC L         ; Move back to the first cell.
@label=AttrDrawMovingDownRight_Cell
*$A0D8 LD (HL),D     ; Write the attribute of the entity to the cell.
 $A0D9 INC L         ; Move to the next cell.
 $A0DA DJNZ $A0D8    ; Decrease the width by one and loop back to #R$A0D8 until the row is
                     ; done.
 $A0DC POP HL        ; Restore the attribute address from the stack.
 $A0DD LD BC,$0020   ; #REGbc=#N($0020,$04,$04).
 $A0E0 AND A         ; {Move up a row.
 $A0E1 SBC HL,BC     ; }
 $A0E3 POP BC        ; Restore the width and the number of rows from the stack.
 $A0E4 DEC C         ; {Decrease the number of rows by one and loop back to #R$A0D3 until
 $A0E5 JR NZ,$A0D3   ; all of the rows have been set.}
 $A0E7 DEC L         ; Move to the cell on the left in the row above.
 $A0E8 LD (HL),E     ; Write the attribute of the room to the cell.
 $A0E9 INC L         ; Move back to the first cell.
 $A0EA JR $A0C9      ; Jump to #R$A0C9 to put the row above back to the attribute of the
                     ; room.

; Draw Attributes Moving Up
;
; The attribute routine for an entity which has moved up. The row just
; below the entity (which the entity has left) is put back to the attribute of
; the room, then each row of cells under the entity is set to the attribute of
; the entity.
;
; B The width of the sprite in cells
; C The number of rows of cells
; D The attribute of the entity
; E The attribute of the room
@label=AttrDrawMovingUp
c$A0EC POP HL        ; Restore the attribute address from the stack.
 $A0ED PUSH BC       ; Stash the width and the number of rows on the stack.
 $A0EE PUSH HL       ; Stash the attribute address on the stack.
 $A0EF PUSH BC       ; Stash the width and the number of rows on the stack
                     ; again.
 $A0F0 LD BC,$0020   ; #REGbc=#N($0020,$04,$04).
 $A0F3 ADD HL,BC     ; Move down a row.
 $A0F4 POP BC        ; Restore the width.
@label=AttrDrawMovingUp_Cell
*$A0F5 LD (HL),E     ; Write the attribute of the room to the cell.
 $A0F6 INC L         ; Move to the next cell.
 $A0F7 DJNZ $A0F5    ; Decrease the width by one and loop back to #R$A0F5 until the row is
                     ; done.
 $A0F9 POP HL        ; Restore the attribute address from the stack.
 $A0FA POP BC        ; Restore the width and the number of rows from the stack.
 $A0FB JP $A07B      ; Jump to #R$A07B to set the cells under the entity.

; Draw Attributes Moving Up-Left
;
; The attribute routine for an entity which has moved up and left. The
; row just below the entity, and one more cell to the right, is put back to the
; attribute of the room. Then each row of cells under the entity is set to the
; attribute of the entity, with the cell to the right of it put back to the
; attribute of the room.
;
; B The width of the sprite in cells
; C The number of rows of cells
; D The attribute of the entity
; E The attribute of the room
@label=AttrDrawMovingUpLeft
c$A0FE POP HL        ; Restore the attribute address from the stack.
 $A0FF PUSH BC       ; Stash the width and the number of rows on the stack.
 $A100 PUSH HL       ; Stash the attribute address on the stack.
 $A101 PUSH BC       ; Stash the width and the number of rows on the stack
                     ; again.
 $A102 LD BC,$0020   ; #REGbc=#N($0020,$04,$04).
 $A105 ADD HL,BC     ; Move down a row.
 $A106 POP BC        ; Restore the width.
 $A107 INC B         ; Add one more cell to the width.
@label=AttrDrawMovingUpLeft_Cell
*$A108 LD (HL),E     ; Write the attribute of the room to the cell.
 $A109 INC L         ; Move to the next cell.
 $A10A DJNZ $A108    ; Decrease the width by one and loop back to #R$A108 until the row is
                     ; done.
 $A10C POP HL        ; Restore the attribute address from the stack.
 $A10D POP BC        ; Restore the width and the number of rows from the stack.
 $A10E JR $A0A4      ; Jump to #R$A0A4 to set the cells under the entity.

; Draw Attributes Moving Down-Left
;
; The attribute routine for an entity which has moved down and left. Each
; row of cells under the entity is set to the attribute of the entity, and the
; cell to the right of it is put back to the attribute of the room. So is the
; row above the entity, with one more cell to the right.
;
; B The width of the sprite in cells
; C The number of rows of cells
; D The attribute of the entity
; E The attribute of the room
@label=AttrDrawMovingDownLeft
c$A110 POP HL        ; Restore the attribute address from the stack.
@label=AttrDrawMovingDownLeft_Row
*$A111 PUSH BC       ; Stash the width and the number of rows on the stack.
 $A112 PUSH HL       ; Stash the attribute address on the stack.
@label=AttrDrawMovingDownLeft_Cell
*$A113 LD (HL),D     ; Write the attribute of the entity to the cell.
 $A114 INC L         ; Move to the next cell.
 $A115 DJNZ $A113    ; Decrease the width by one and loop back to #R$A113 until the row is
                     ; done.
 $A117 LD (HL),E     ; Write the attribute of the room to the cell on the
                     ; right.
 $A118 POP HL        ; Restore the attribute address from the stack.
 $A119 LD BC,$0020   ; #REGbc=#N($0020,$04,$04).
 $A11C AND A         ; {Move up a row.
 $A11D SBC HL,BC     ; }
 $A11F POP BC        ; Restore the width and the number of rows from the stack.
 $A120 DEC C         ; {Decrease the number of rows by one and loop back to #R$A111 until
 $A121 JR NZ,$A111   ; all of the rows have been set.}
 $A123 INC B         ; Add one more cell to the width.
 $A124 JP $A0C9      ; Jump to #R$A0C9 to put the row above back to the attribute of the
                     ; room.

; Draw Attributes Moving Up-Right
;
; The attribute routine for an entity which has moved up and right. The
; row just below the entity, and one more cell to the left, is put back to the
; attribute of the room. Then each row of cells under the entity is set to the
; attribute of the entity, with the cell to the left of it put back to the
; attribute of the room.
;
; B The width of the sprite in cells
; C The number of rows of cells
; D The attribute of the entity
; E The attribute of the room
@label=AttrDrawMovingUpRight
c$A127 POP HL        ; Restore the attribute address from the stack.
 $A128 PUSH BC       ; Stash the width and the number of rows on the stack.
 $A129 PUSH HL       ; Stash the attribute address on the stack.
 $A12A PUSH BC       ; Stash the width and the number of rows on the stack
                     ; again.
 $A12B LD BC,$0020   ; #REGbc=#N($0020,$04,$04).
 $A12E ADD HL,BC     ; Move down a row.
 $A12F POP BC        ; Restore the width.
 $A130 DEC L         ; Move to the cell on the left.
 $A131 INC B         ; Add one more cell to the width.
@label=AttrDrawMovingUpRight_Cell
*$A132 LD (HL),E     ; Write the attribute of the room to the cell.
 $A133 INC L         ; Move to the next cell.
 $A134 DJNZ $A132    ; Decrease the width by one and loop back to #R$A132 until the row is
                     ; done.
 $A136 POP HL        ; Restore the attribute address from the stack.
 $A137 POP BC        ; Restore the width and the number of rows from the stack.
 $A138 JP $A08E      ; Jump to #R$A08E to set the cells under the entity.

; Draw Inventory
;
; Used by the routines at #R$9147, #R$92F5 and #R$93E3.
; .
; Draws the three items that the player is carrying in the side panel,
; one for each slot of the inventory at #R$5E30. The slots are drawn #N$10
; pixels apart.
; #PUSHS #POKES$5C78,$34,$02 #POKES$5CB0,$E9
; #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$7D9A,stop=$7DDC,clear=1,sp=$5E00)
; #SCR$04,$18,$03,$08,$05(inventory-before)
; | #POKES$5E30,$01;$5E32,$8C;$5E33,$46;$5E34,$01;$5E36,$81;$5E37,$44
; #POKES$5E38,$01;$5E3A,$81;$5E3B,$42
; #SIM(start=$A13B,stop=$0000,sp=$5B60)
; #SCR$04,$18,$03,$08,$05(inventory-after) } UDGTABLE# #POPS
@label=DrawInventory
c$A13B LD DE,$2CC8   ; #REGd=#N$2C (the Y position) and #REGe=#N$C8 (the X position) of the
                     ; first slot.
 $A13E LD HL,$5E30   ; Point #REGhl at the first slot of the inventory at
                     ; #R$5E30.
 $A141 LD B,$03      ; #REGb=#N$03 (the number of slots).
@label=DrawInventory_Loop
*$A143 CALL $A14D    ; Draw the item in the slot with #R$A14D.
 $A146 LD A,E        ; Fetch the X position of the slot.
 $A147 ADD A,$10     ; Add #N$10 to move on to the X position of the next slot.
 $A149 LD E,A        ; Keep the X position of the next slot in #REGe.
 $A14A DJNZ $A143    ; Decrease the slot counter by one and loop back to #R$A143 until all
                     ; of the slots are drawn.
 $A14C RET           ; Return.

; Draw Inventory Item
;
; Used by the routine at #R$A13B.
; .
; Draws and colours the item in one slot of the inventory. The item is
; built up as an entity in the record at #R$A17D, so that it can be drawn with
; #R$9F4A and coloured with #R$A00E. An empty slot is drawn as the blank sprite
; (#N$31), which clears the position.
;
; D The Y position
; E The X position
; HL The inventory slot
@label=DrawInventoryItem
c$A14D PUSH BC       ; Stash the slot counter on the stack.
 $A14E PUSH DE       ; Stash the position on the stack.
 $A14F PUSH IX       ; Stash #REGix on the stack.
 $A151 LD IX,$A17D   ; Point #REGix at the entity to draw at #R$A17D.
 $A155 LD A,(HL)     ; Fetch the low byte of the address of the item.
 $A156 INC HL        ; Move to the high byte.
 $A157 OR (HL)       ; Combine it with the high byte, which gives zero if the slot is
                     ; empty.
 $A158 INC HL        ; Move to the sprite ID.
 $A159 LD A,(HL)     ; Fetch the sprite ID.
 $A15A JR NZ,$A15E   ; Jump to #R$A15E if the slot is not empty.
 $A15C LD A,$31      ; #REGa=#N$31 (the blank sprite).
@label=DrawInventoryItem_Set
*$A15E INC HL        ; Move to the attribute.
 $A15F LD (IX+$00),A ; Write the sprite ID to *#REGix+#N$00.
 $A162 LD (IX+$03),E ; Write the X position to *#REGix+#N$03.
 $A165 LD (IX+$04),D ; Write the Y position to *#REGix+#N$04.
 $A168 LD A,(HL)     ; Fetch the attribute.
 $A169 INC HL        ; Move to the next slot.
 $A16A LD (IX+$05),A ; Write the attribute to *#REGix+#N$05.
 $A16D PUSH HL       ; Stash the pointer to the next slot on the stack.
 $A16E CALL $A185    ; Clear the area with #R$A185.
 $A171 CALL $9F4A    ; Draw the sprite with #R$9F4A.
 $A174 CALL $A00E    ; Set the attributes with #R$A00E.
 $A177 POP HL        ; Restore the pointer to the next slot from the stack.
 $A178 POP IX        ; Restore #REGix from the stack.
 $A17A POP DE        ; Restore the position from the stack.
 $A17B POP BC        ; Restore the slot counter from the stack.
 $A17C RET           ; Return.

; Entity To Draw
;
; A scratch entity record, which the routines that draw the side panel
; fill
; in before drawing it as an entity. Only the sprite ID, the position and the
; attribute are used for drawing.
@label=EntityToDraw
g$A17D DEFB $00      ; The sprite ID.
 $A17E DEFB $00,$00  ; Not used when drawing.
 $A180 DEFB $00      ; The X position.
 $A181 DEFB $00      ; The Y position.
 $A182 DEFB $00      ; The attribute.
 $A183 DEFB $00,$00  ; Not used when drawing.

; Clear Sprite
;
; Used by the routines at #R$A14D and #R$A2CE.
; .
; Clears the pixels in the area under a sprite, which is two bytes wide
; and
; #N$14 rows high, working up from the position of an entity.
;
; IX The entity
@label=ClearSprite
c$A185 LD L,(IX+$03) ; {#REGl=the entity X position, and #REGh=the entity Y
 $A188 LD H,(IX+$04) ; position.}
 $A18B CALL $9BA2    ; Call #R$9BA2 to get the screen address of the position.
 $A18E LD B,$14      ; #REGb=#N$14 (the number of rows).
@label=ClearSprite_Row
*$A190 LD (HL),$00   ; Clear the first byte of the row.
 $A192 INC L         ; Move to the next byte.
 $A193 LD (HL),$00   ; Clear the second byte of the row.
 $A195 DEC L         ; Move back to the first byte.
 $A196 CALL $9F03    ; Call #R$9F03 to move up one pixel row.
 $A199 DJNZ $A190    ; Decrease the row counter by one and loop back to #R$A190 until it is
                     ; zero.
 $A19B RET           ; Return.

; Add Points To Score
;
; Used by the routines at #R$875F and #R$8988.
; .
; Adds some points to the score, which is held as three bytes of BCD
; starting at #R$5E2A (the most significant byte is first). It then carries on
; to print the score.
; #PUSHS #POKES$5C78,$34,$02 #POKES$5CB0,$E9
; #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$7D9A,stop=$7DDC,clear=1,sp=$5E00)
; #SCR$04,$18,$08,$08,$04(add-points-before)
; | #SIM(start=$A19C,stop=$0000,bc=$0050,sp=$5B60)
; #SIM(start=$A1AE,stop=$0000,sp=$5B60)
; #SCR$04,$18,$08,$08,$04(add-points-after) } UDGTABLE# #POPS
;
; BC The points to add to the score (as BCD)
@label=AddPointsToScore
c$A19C LD HL,$5E2C   ; Point #REGhl at the last byte of the score at #R$5E2C.
 $A19F LD A,(HL)     ; Fetch the last byte of the score.
 $A1A0 ADD A,C       ; Add #REGc.
 $A1A1 DAA           ; Convert the result to BCD.
 $A1A2 LD (HL),A     ; Update the last byte of the score.
 $A1A3 DEC HL        ; Move on to the middle byte of the score.
 $A1A4 LD A,(HL)     ; Fetch the middle byte of the score.
 $A1A5 ADC A,B       ; Add #REGb, with the carry.
 $A1A6 DAA           ; Convert the result to BCD.
 $A1A7 LD (HL),A     ; Update the middle byte of the score.
 $A1A8 DEC HL        ; Move on to the first byte of the score.
 $A1A9 LD A,(HL)     ; Fetch the first byte of the score.
 $A1AA ADC A,$00     ; Add #N$00 (i.e. just the carry flag).
 $A1AC DAA           ; Convert the result to BCD.
 $A1AD LD (HL),A     ; Update the first byte of the score.
; View the equivalent code in;
; #LIST
; { #COOKIE$7415 }
; { #JETPAC$70F9 }
; { #PSSST$737A }
; { #TRANZAM$6046 }
; { #UNDERWURLDE$A045 }
; LIST#

; Print Scores
;
; Used by the routine at #R$A219.
; .
; Prints the score, as six digits, in the side panel.
; #PUSHS #POKES$5C78,$34,$02 #POKES$5CB0,$E9
; #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$7D9A,stop=$7DDC,clear=1,sp=$5E00)
; #SCR$04,$18,$08,$08,$04(print-scores-before)
; | #POKES$5E2A,$12;$5E2B,$34;$5E2C,$56
; #SIM(start=$A1AE,stop=$0000,sp=$5B60)
; #SCR$04,$18,$08,$08,$04(print-scores-after) } UDGTABLE# #POPS
@label=Score_1UP
c$A1AE LD HL,$BFCC   ; {Write #R$BFCC to #R$5E01.
 $A1B1 LD ($5E01),HL ; }
 $A1B4 LD HL,$50C8   ; #REGhl=#N$50C8 (the Y position is #N$50 and the X position is
                     ; #N$C8).
; This entry point is used by the routine at #R$9641.
@label=PrintScore
*$A1B7 CALL $9BA2    ; Call #R$9BA2 to get the screen address of the position.
 $A1BA LD DE,$5E2A   ; Point #REGde at the first byte of the score at #R$5E2A.
 $A1BD LD B,$03      ; #REGb=#N$03 (the number of bytes).
; This entry point is used by the routines at #R$95DA and #R$9641.
@label=PrintScore_Loop
*$A1BF LD A,(DE)     ; Fetch the next byte of the score.
 $A1C0 RRCA          ; {Rotate right four times, which moves the high digit into the low
 $A1C1 RRCA          ; nibble.
 $A1C2 RRCA          ;
 $A1C3 RRCA          ; }
 $A1C4 AND %00001111 ; Keep only bits 0-3.
 $A1C6 CALL $A1D3    ; Call #R$A1D3 to print the digit.
; This entry point is used by the routine at #R$95DA.
@label=PrintScore_LowDigit
*$A1C9 LD A,(DE)     ; Fetch the byte of the score again.
 $A1CA AND %00001111 ; Keep only bits 0-3.
 $A1CC CALL $A1D3    ; Call #R$A1D3 to print the digit.
 $A1CF INC DE        ; Move on to the next byte of the score.
 $A1D0 DJNZ $A1BF    ; Decrease the byte counter by one and loop back to #R$A1BF until all
                     ; the bytes of the score have been printed.
 $A1D2 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #COOKIE$7438 }
; { #JETPAC$711C }
; { #LUNARJETMAN$89BF }
; { #PSSST$739D }
; { #TRANZAM$6CB6 }
; LIST#

; Print Character
;
; Used by the routines at #R$A1AE, #R$A1F3 and #R$A219.
; .
; Prints a character at a screen address, using the graphics in the font
; that #R$5E01 points to, and moves on to the next character cell.
; #PUSHS #POKES$5C78,$34,$02 #POKES$5CB0,$E9
; #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$7D9A,stop=$7DDC,clear=1,sp=$5E00)
; #SIM(start=$8093,stop=$0000,sp=$5B60)
; #POKES$5E01,$4C;$5E02,$BE
; #SCR$04,$06,$06,$08,$04(print-character-before)
; | #SIM(start=$A1D3,stop=$0000,a=$41,hl=$4808,sp=$5B60)
; #SIM(start=$A1D3,stop=$0000,a=$43,sp=$5B60)
; #SIM(start=$A1D3,stop=$0000,a=$47,sp=$5B60)
; #SCR$04,$06,$06,$08,$04(print-character-after) } UDGTABLE# #POPS
;
;   A The character code (the number of its graphic in the font)
;   HL The screen address
; O:HL The screen address of the next character cell
@label=PrintScreen
c$A1D3 PUSH BC       ; Stash #REGbc on the stack.
 $A1D4 PUSH DE       ; Stash #REGde on the stack.
 $A1D5 PUSH HL       ; Stash the screen address on the stack.
 $A1D6 LD L,A        ; {Fetch the character code.
 $A1D7 LD H,$00      ; }
 $A1D9 ADD HL,HL     ; {Multiply by #N$08, as each character has eight bytes of
 $A1DA ADD HL,HL     ; graphics.
 $A1DB ADD HL,HL     ; }
 $A1DC LD DE,($5E01) ; Fetch the address of the font from #R$5E01.
 $A1E0 ADD HL,DE     ; Fetch the address of the graphics of the character.
 $A1E1 EX DE,HL      ; Fetch the address of the graphics of the character.
 $A1E2 POP HL        ; Restore the screen address from the stack.
 $A1E3 LD B,$08      ; #REGb=#N$08 (the number of rows).
@label=PrintScreen_Loop
*$A1E5 LD A,(DE)     ; Fetch the next row of the graphics.
 $A1E6 LD (HL),A     ; Write it to the screen.
 $A1E7 INC DE        ; Move on to the next row of the graphics.
 $A1E8 INC H         ; Move down a pixel row on the screen.
 $A1E9 DJNZ $A1E5    ; Decrease the row counter by one and loop back to #R$A1E5 until it is
                     ; zero.
 $A1EB POP DE        ; Restore #REGde from the stack.
 $A1EC POP BC        ; Restore #REGbc from the stack.
 $A1ED LD A,H        ; Fetch the high byte of the screen address.
 $A1EE SUB $08       ; Subtract #N$08 to move back to the top row of the
                     ; character.
 $A1F0 LD H,A        ; Keep the high byte of the top row in #REGh.
 $A1F1 INC L         ; Move on to the next character cell.
 $A1F2 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #COOKIE$7468 }
; { #JETPAC$714C }
; { #LUNARJETMAN$89EF }
; { #MARTIANOIDS$B5CB }
; { #NIGHTSHADE$CB19 }
; { #PSSST$73CD }
; { #SABREWULF$B589 }
; { #TRANZAM$6C96 }
; { #UNDERWURLDE$98DF }
; LIST#

; Print Colour String
;
; Used by the routines at #R$7CAF, #R$8C35, #R$9641 and #R$96EC.
; .
; Prints a string of characters, and sets the attribute of each character
; cell it uses. The string data starts with the attribute, followed by the
; characters, and bit 7 of the last character is set to mark the end of the
; string.
; #PUSHS #POKES$5C78,$34,$02 #POKES$5CB0,$E9
; #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$7D9A,stop=$7DDC,clear=1,sp=$5E00)
; #SIM(start=$80AA,stop=$0000,sp=$5B60)
; #POKES$5E01,$4C;$5E02,$BE
; #SCR$02,$00,$00,$20,$04(print-string-before)
; | #SIM(start=$A1F3,stop=$0000,hl=$0020,de=$7D72,sp=$5B60)
; #SCR$02,$00,$00,$20,$04(print-string-after) } UDGTABLE# #POPS
;
; DE Pointer to string data
; HL The position (the Y position in #REGh and the X position in #REGl)
@label=PrintStringColour
c$A1F3 PUSH HL       ; Stash #REGhl on the stack.
 $A1F4 CALL $9BA2    ; Call #R$9BA2 to get the screen address.
 $A1F7 LD A,(DE)     ; Fetch the attribute byte.
 $A1F8 EX AF,AF'     ; Switch to the shadow #REGaf register.
 $A1F9 INC DE        ; Increment #REGde by one to point to the text of the
                     ; string.
 $A1FA EXX           ; Switch to the shadow registers.
 $A1FB POP HL        ; Restore #REGhl from the stack.
 $A1FC CALL $9BD2    ; Call #R$9BD2 to get the attribute address.
; This entry point is used by the routine at #R$7D8A.
@label=PrintString_Loop
*$A1FF EXX           ; Switch back to the normal registers.
 $A200 LD A,(DE)     ; Fetch the character to print.
 $A201 BIT 7,A       ; {If bit 7 is set (which signifies the end of the
 $A203 JR NZ,$A210   ; string), jump to #R$A210.}
 $A205 CALL $A1D3    ; Call #R$A1D3 to print the character.
 $A208 INC DE        ; Move #REGde on to the next character of the string.
 $A209 EXX           ; Switch to the shadow registers.
 $A20A EX AF,AF'     ; Switch to the shadow #REGaf register.
 $A20B LD (HL),A     ; Copy the attribute byte to the screen.
 $A20C INC L         ; Move #REGl on to the next attribute cell.
 $A20D EX AF,AF'     ; Switch to the shadow #REGaf register.
 $A20E JR $A1FF      ; Jump back to #R$A1FF to print the next character of the
                     ; string.
; Because the last character contains the terminator, it needs to be handled
; separately.
@label=PrintString_LastCharacter
*$A210 AND %01111111 ; Keep only bits 0-6 (i.e. strip the bit 7 terminator).
 $A212 CALL $A1D3    ; Call #R$A1D3 to print the character.
 $A215 EXX           ; Switch to the shadow registers.
 $A216 EX AF,AF'     ; Switch to the shadow #REGaf register.
 $A217 LD (HL),A     ; Copy the attribute byte to the screen.
 $A218 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #COOKIE$7488 }
; { #JETPAC$716C }
; { #LUNARJETMAN$8A11 }
; { #PSSST$73ED }
; { #SABREWULF$B53D }
; { #TRANZAM$6518 }
; { #UNDERWURLDE$9C3C }
; LIST#

; Draw Side Panel
;
; Used by the routine at #R$7D9A.
; .
; Draws the side panel on the right of the screen. The panel is #N$08
; characters wide and #N$18 characters high, and the characters to use are
; listed in #R$B32A. They are drawn with the graphics at #R$B03A as the font.
; It then jumps to #R$A1AE to print the score.
; #PUSHS #POKES$5C78,$34,$02 #POKES$5CB0,$E9
; #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$7D9A,stop=$7DDC,clear=1,sp=$5E00)
; #SIM(start=$80B4,stop=$0000,sp=$5B60)
; #SCR$02,$18,$00,$08,$18(side-panel-before)
; | #SIM(start=$A219,stop=$0000,sp=$5B60)
; #SCR$02,$18,$00,$08,$18(side-panel-after) } UDGTABLE# #POPS
@label=DrawSidePanel
c$A219 LD HL,$B03A   ; {Write #R$B03A to #R$5E01.
 $A21C LD ($5E01),HL ; }
 $A21F LD HL,$00C0   ; #REGhl=#N($00C0, $04, $04) (screen buffer location).
 $A222 LD DE,$B32A   ; Point #REGde at the side panel data at #R$B32A.
 $A225 LD BC,$0818   ; #REGbc=#N$08 (width), #N$18 (height).
@label=SidePanel_Loop_Y
*$A228 PUSH BC       ; {Stash #REGbc and #REGhl on the stack.
 $A229 PUSH HL       ; }
 $A22A CALL $9BA2    ; Call #R$9BA2 to get the screen address.
@label=SidePanel_Loop_X
*$A22D LD A,(DE)     ; Fetch the next character of the panel.
 $A22E INC DE        ; Increment the character data pointer by one.
 $A22F CALL $A1D3    ; Call #R$A1D3 to print the character.
 $A232 DJNZ $A22D    ; Decrease the width counter by one and loop back to #R$A22D until the
                     ; row of the panel has been printed.
 $A234 POP HL        ; Restore #REGhl from the stack.
 $A235 LD A,H        ; {Add #N$08 to #REGh, to move down one character row.
 $A236 ADD A,$08     ;
 $A238 LD H,A        ; }
 $A239 POP BC        ; Restore #REGbc from the stack.
 $A23A DEC C         ; {Decrease the height counter by one and loop back to #R$A228 until
 $A23B JR NZ,$A228   ; all the rows of the panel have been printed.}
 $A23D JP $A1AE      ; Jump to #R$A1AE to print the scores.

; Draw Side Panel Attributes
;
; Used by the routine at #R$9147.
; .
; Sets the attributes of the side panel. The whole panel is filled with a
; colour that is picked from the attribute of the room, and then a shape and
; some bands of colour are put on top. #R$809A, which fills a block of cells
; with a value, does most of the work.
;
; .
;
; #PUSHS #POKES$5C78,$34,$02 #POKES$5CB0,$E9
; #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$7D9A,stop=$9153,clear=1,sp=$5E00)
; #SCR$01(panel-attributes-before)
; | #SIM(start=$9153,stop=$9156,sp=$5E00)
; #SCR$01(panel-attributes-after) } UDGTABLE# #POPS
@label=DrawSidePanelAttrs
c$A240 LD HL,$00C0   ; #REGhl=#N$00C0 (the Y position is #N$00 and the X position is
                     ; #N$C0), which is the top left of the side panel.
 $A243 CALL $9BD2    ; Call #R$9BD2 to get the attribute address of the
                     ; position.
 $A246 LD BC,$0818   ; #REGb=#N$08 (the width of the panel in cells) and #REGc=#N$18 (the
                     ; number of rows).
; Pick the colour for the panel. Take the inverse of bits 0-2 of the
; attribute of the room, unless that is less than #N$02, when #N$44 is used.
 $A249 LD A,($5E1A)  ; Fetch the room attribute from #R$5E1A.
 $A24C CPL           ; Flip the bits.
 $A24D AND %00000111 ; Keep only bits 0-2.
 $A24F CP $02        ; {Jump to #R$A255 if the colour is #N$02 or more.
 $A251 JR NC,$A255   ; }
 $A253 LD A,$44      ; #REGa=#N$44.
@label=DrawSidePanelAttrs_Colour
*$A255 LD E,A        ; Keep the attribute of the panel in #REGe.
 $A256 PUSH DE       ; Stash the attribute of the panel on the stack.
@label=DrawSidePanelAttrs_Row
*$A257 PUSH BC       ; Stash the width and the number of rows on the stack.
 $A258 PUSH HL       ; Stash the attribute address on the stack.
@label=DrawSidePanelAttrs_Cell
*$A259 LD (HL),E     ; Write the attribute of the panel to the cell.
 $A25A INC L         ; Move to the next cell.
 $A25B DJNZ $A259    ; Decrease the width by one and loop back to #R$A259 until the row is
                     ; done.
 $A25D POP HL        ; Restore the attribute address from the stack.
 $A25E LD BC,$0020   ; #REGbc=#N($0020,$04,$04).
 $A261 ADD HL,BC     ; Move down a row.
 $A262 POP BC        ; Restore the width and the number of rows from the stack.
 $A263 DEC C         ; {Decrease the number of rows by one and loop back to #R$A257 until
 $A264 JR NZ,$A257   ; all of the rows have been set.}
; Fill a square of three by three cells, and then a cell and a square of
; two by two cells below it, with the attribute of the room. Then put the
; attribute of the panel back in the middle of the three by three square.
 $A266 LD HL,$90C8   ; #REGhl=#N$90C8 (the Y position is #N$90 and the X position is
                     ; #N$C8).
 $A269 CALL $9BD2    ; Call #R$9BD2 to get the attribute address of the
                     ; position.
 $A26C LD A,($5E1A)  ; Fetch the room attribute from #R$5E1A.
 $A26F LD BC,$0303   ; #REGb=#N$03 (the width) and #REGc=#N$03 (the number of
                     ; rows).
 $A272 CALL $809A    ; Call #R$809A to fill the cells with the attribute of the
                     ; room.
 $A275 INC L         ; Move to the next cell.
 $A276 LD (HL),A     ; Write the attribute of the room to the cell.
 $A277 ADD HL,DE     ; Move down a row (#REGde is #N($0020,$04,$04) after the
                     ; call).
 $A278 LD BC,$0202   ; #REGb=#N$02 (the width) and #REGc=#N$02 (the number of
                     ; rows).
 $A27B CALL $809A    ; Call #R$809A to fill the cells with the attribute of the
                     ; room.
 $A27E LD HL,$98D0   ; #REGhl=#N$98D0 (the Y position is #N$98 and the X position is
                     ; #N$D0).
 $A281 CALL $9BD2    ; Call #R$9BD2 to get the attribute address of the
                     ; position.
 $A284 POP DE        ; Restore the attribute of the panel from the stack.
 $A285 LD (HL),E     ; Write it to the cell.
; Colour the bands of the panel from the bottom upwards. Each is filled
; with #R$809A.
 $A286 LD HL,$7DC8   ; #REGhl=#N$7DC8 (the Y position is #N$7D and the X position is
                     ; #N$C8).
 $A289 CALL $9BD2    ; Call #R$9BD2 to get the attribute address of the
                     ; position.
 $A28C LD BC,$0603   ; #REGb=#N$06 (the width) and #REGc=#N$03 (the number of
                     ; rows).
 $A28F LD A,$47      ; #REGa=#N$47 (bright white).
 $A291 CALL $809A    ; Call #R$809A to fill the cells.
 $A294 LD HL,$5FC8   ; #REGhl=#N$5FC8 (the Y position is #N$5F and the X position is
                     ; #N$C8).
 $A297 CALL $9BD2    ; Call #R$9BD2 to get the attribute address of the
                     ; position.
 $A29A LD BC,$0604   ; #REGb=#N$06 (the width) and #REGc=#N$04 (the number of
                     ; rows).
 $A29D LD A,$46      ; #REGa=#N$46 (bright yellow).
 $A29F CALL $809A    ; Call #R$809A to fill the cells.
 $A2A2 LD HL,$48C8   ; #REGhl=#N$48C8 (the Y position is #N$48 and the X position is
                     ; #N$C8).
 $A2A5 CALL $9BD2    ; Call #R$9BD2 to get the attribute address of the
                     ; position.
 $A2A8 LD BC,$0601   ; #REGb=#N$06 (the width) and #REGc=#N$01 (the number of
                     ; rows).
 $A2AB LD A,$45      ; #REGa=#N$45 (bright cyan).
 $A2AD CALL $809A    ; Call #R$809A to fill the cells.
 $A2B0 LD BC,$0601   ; #REGb=#N$06 (the width) and #REGc=#N$01 (the number of
                     ; rows).
 $A2B3 LD A,$47      ; #REGa=#N$47 (bright white).
 $A2B5 CALL $809A    ; Call #R$809A to fill the cells in the next row down.
 $A2B8 LD HL,$38C8   ; #REGhl=#N$38C8 (the Y position is #N$38 and the X position is
                     ; #N$C8).
 $A2BB CALL $9BD2    ; Call #R$9BD2 to get the attribute address of the
                     ; position.
 $A2BE LD BC,$0601   ; #REGb=#N$06 (the width) and #REGc=#N$01 (the number of
                     ; rows).
 $A2C1 LD A,$43      ; #REGa=#N$43 (bright magenta).
 $A2C3 CALL $809A    ; Call #R$809A to fill the cells.
 $A2C6 LD BC,$0601   ; #REGb=#N$06 (the width) and #REGc=#N$01 (the number of
                     ; rows).
 $A2C9 LD A,$47      ; #REGa=#N$47 (bright white).
 $A2CB JP $809A      ; Jump to #R$809A to fill the cells in the next row down.

; Display Lives
;
; Used by the routines at #R$7D9A and #R$9443.
; .
; Draws an icon of the character for each life that the player has left
; (up to three) in the side panel, and clears the icon of each life that has
; been lost. The icon is the first sprite of the character that was chosen
; in the menu (#R$5E00 bits 3-4).
; #PUSHS #POKES$5C78,$34,$02 #POKES$5CB0,$E9
; #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$7D9A,stop=$7DDC,clear=1,sp=$5E00)
; #SCR$04,$18,$10,$08,$03(display-lives-before)
; | #POKES$5E21,$01
; #SIM(start=$A2CE,stop=$0000,sp=$5B60)
; #SCR$04,$18,$10,$08,$03(display-lives-after) } UDGTABLE# #POPS
@label=DisplayPlayerLives
c$A2CE PUSH IX         ; Stash #REGix on the stack.
 $A2D0 LD IX,$A17D     ; Point #REGix at the entity to draw at #R$A17D.
 $A2D4 LD A,($5E00)    ; Fetch the character that was chosen from #R$5E00.
 $A2D7 RLCA            ; Rotate left once.
 $A2D8 AND %00110000   ; Keep only bits 4-5.
 $A2DA OR %00000001    ; Set bit 0, to get the first sprite of the character (#N$01,
                       ; #N$11 or #N$21).
 $A2DC LD (IX+$00),A   ; Write the sprite ID to *#REGix+#N$00.
 $A2DF LD (IX+$05),$47 ; Write #N$47 (the attribute) to *#REGix+#N$05.
 $A2E3 LD HL,$8DC8     ; #REGhl=#N$8DC8 (the Y position is #N$8D and the X position is
                       ; #N$C8).
 $A2E6 LD (IX+$03),L   ; Write the X position to *#REGix+#N$03.
 $A2E9 LD (IX+$04),H   ; Write the Y position to *#REGix+#N$04.
 $A2EC LD A,($5E21)    ; {Fetch the number of lives from #R$5E21 and keep the number of lives
 $A2EF LD C,A          ; left to draw in #REGc.}
 $A2F0 LD B,$03        ; #REGb=#N$03 (the number of icons).
@label=DisplayPlayerLives_Loop
*$A2F2 PUSH BC         ; Stash the counters on the stack.
 $A2F3 CALL $A185      ; Clear the icon with #R$A185.
 $A2F6 LD A,C          ; Fetch the number of lives left to draw.
 $A2F7 AND A           ; {Jump to #R$A2FD if there are no lives left to draw.
 $A2F8 JR Z,$A2FD      ; }
 $A2FA CALL $9F4A      ; Draw the icon with #R$9F4A.
@label=DisplayPlayerLives_Next
*$A2FD LD A,(IX+$03)   ; Fetch the X position.
 $A300 ADD A,$10       ; Add #N$10 to move on to the next icon.
 $A302 LD (IX+$03),A   ; Write the X position back to *#REGix+#N$03.
 $A305 POP BC          ; Restore the counters from the stack.
 $A306 DEC C           ; {Decrease the number of lives left to draw by one, and jump to
 $A307 JP P,$A30C      ; #R$A30C if it is not negative.}
 $A30A LD C,$00        ; #REGc=#N$00 (no lives left to draw).
@label=DisplayPlayerLives_Count
*$A30C DJNZ $A2F2      ; Decrease the icon counter by one and loop back to #R$A2F2 until it
                       ; is zero.
 $A30E POP IX          ; Restore #REGix from the stack.
 $A310 RET             ; Return.
; View the equivalent code in;
; #LIST
; { #LUNARJETMAN$894F }
; { #TRANZAM$687B }
; LIST#

; Menu Icons
;
; Used by the routine at #R$7C19.
; .
; Draws the nine icons of the menu. The data for each one is the same as
; an entity record, which is copied from the table at #R$A331 to #R$A17D,
; drawn with #R$9F4A and then coloured with #R$A00E.
; #PUSHS #POKES$5C78,$34,$02 #POKES$5CB0,$E9
; #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$7C19,stop=$7C2C,clear=1,sp=$5E00)
; #SCR$03,$03,$08,$05,$0E(menu-icons-before)
; | #SIM(start=$A311,stop=$0000,sp=$5B60)
; #SCR$03,$03,$08,$05,$0E(menu-icons-after) } UDGTABLE# #POPS
@label=MenuIcons
c$A311 LD IX,$A17D                          ; Point #REGix at the entity to
                                            ; draw at #R$A17D.
 $A315 LD HL,$A331                          ; Point #REGhl at the table of
                                            ; icons at #R$A331.
 $A318 LD B,$09                             ; #REGb=#N$09 (the number of
                                            ; icons).
@label=MenuIcons_Loop
*$A31A PUSH BC                              ; Stash the icon counter on the
                                            ; stack.
 $A31B LD DE,$A17D                          ; {Copy #N$08 bytes of data from
 $A31E LD BC,$0008                          ; #REGhl to #R$A17D.
 $A321 LDIR                                 ; }
 $A323 PUSH HL                              ; {Stash #REGhl and #REGde on the
 $A324 PUSH DE                              ; stack.}
 $A325 CALL $9F4A                           ; Call #R$9F4A to draw the entity.
 $A328 CALL $A00E                           ; Call #R$A00E to set the
                                            ; attributes of the entity.
 $A32B POP DE                               ; {Restore #REGde and #REGhl from
 $A32C POP HL                               ; the stack.}
 $A32D POP BC                               ; Restore the icon counter from the
                                            ; stack.
 $A32E DJNZ $A31A                           ; Decrease the icon counter by one and loop back to #R$A31A until all
                                            ; nine icons have been drawn.
 $A330 RET                                  ; Return.
; The sprite IDs are stored +#N$01 higher than their actual value.
@label=MenuEntities
 $A331 DEFB $32,$00,$00,$20,$4F,$46,$00,$00 ; {#TABLE(default,centre,centre,centre,centre)
 $A339 DEFB $33,$00,$00,$30,$4F,$46,$00,$00 ; { =h Address | =h Sprite | =h Attribute | =h Screen Buffer Location }
 $A341 DEFB $4A,$00,$00,$20,$37,$44,$00,$00 ; { #N$A331 | #SPRITENAME(#PEEK($A331) - $01) | #N(#PEEK($A334)) | #N(#PEEK($A335) + #PEEK($A336) * $100) }
 $A349 DEFB $4B,$00,$00,$30,$37,$44,$00,$00 ; { #N$A339 | #SPRITENAME(#PEEK($A339) - $01) | #N(#PEEK($A33C)) | #N(#PEEK($A33D) + #PEEK($A33E) * $100) }
 $A351 DEFB $48,$00,$00,$20,$1C,$43,$00,$00 ; { #N$A341 | #SPRITENAME(#PEEK($A341) - $01) | #N(#PEEK($A344)) | #N(#PEEK($A335) + #PEEK($A346) * $100) }
 $A359 DEFB $49,$00,$00,$30,$1C,$43,$00,$00 ; { #N$A349 | #SPRITENAME(#PEEK($A349) - $01) | #N(#PEEK($A34C)) | #N(#PEEK($A335) + #PEEK($A34E) * $100) }
 $A361 DEFB $01,$00,$00,$28,$67,$47,$00,$00 ; { #N$A351 | #SPRITENAME(#PEEK($A351) - $01) | #N(#PEEK($A354)) | #N(#PEEK($A335) + #PEEK($A356) * $100) }
 $A369 DEFB $11,$00,$00,$28,$7F,$47,$00,$00 ; { #N$A359 | #SPRITENAME(#PEEK($A359) - $01) | #N(#PEEK($A35C)) | #N(#PEEK($A335) + #PEEK($A35E) * $100) }
 $A371 DEFB $21,$00,$00,$28,$97,$47,$00,$00 ; { #N$A361 | #SPRITENAME(#PEEK($A361) - $01) | #N(#PEEK($A364)) | #N(#PEEK($A335) + #PEEK($A366) * $100) }
                                            ; { #N$A369 | #SPRITENAME(#PEEK($A369) - $01) | #N(#PEEK($A36C)) | #N(#PEEK($A335) + #PEEK($A36E) * $100) }
                                            ; { #N$A371 | #SPRITENAME(#PEEK($A371) - $01) | #N(#PEEK($A374)) | #N(#PEEK($A375) + #PEEK($A376) * $100) }
                                            ; TABLE#}

; Divide
;
; Used by the routine at #R$9C79.
; .
; Divides a number by another and returns the answer as a fraction of
; #N$100, which is a number between #N$00 and #N$FF as long as the first
; number is the smaller. The answer is worked out one bit at a time (long
; division), with the answer in the shadow registers and the working in the
; normal registers.
; #R$9C79 uses it to work out how far to move across or up for every pixel
; moved in the other direction.
;
;   H The number to divide (the numerator)
;   DE The number to divide by (the denominator)
; O:DE The remainder
; O:HL The answer (the numerator * #N$100 / the denominator)
@label=Divide
c$A379 LD L,H        ; Move the numerator into #REGl.
 $A37A LD H,$00      ; #REGh=#N$00 (so that #REGhl is the numerator).
 $A37C EXX           ; Switch to the shadow registers.
 $A37D LD HL,$0000   ; #REGhl'=#N$0000 (the answer so far).
 $A380 LD B,$08      ; #REGb'=#N$08 (the number of bits to work out).
@label=Divide_Loop
*$A382 EXX           ; Switch to the normal registers.
 $A383 SLA L         ; Shift #REGhl left by one.
 $A385 RL H          ; Rotate the carry into #REGh.
 $A387 PUSH HL       ; Stash the working number on the stack.
 $A388 AND A         ; {Subtract the denominator.
 $A389 SBC HL,DE     ; }
 $A38B JR C,$A399    ; Jump to #R$A399 if it is bigger than the working number.
 $A38D POP AF        ; Discard the stashed working number, as the subtraction
                     ; can stay.
 $A38E EXX           ; Switch to the shadow registers.
 $A38F ADD HL,HL     ; Shift the answer left by one.
 $A390 INC HL        ; Add one to the answer for this bit.
@label=Divide_Next
*$A391 DJNZ $A382    ; Decrease the bit counter by one and loop back to #R$A382 until all
                     ; eight bits of the answer have been worked out.
 $A393 PUSH HL       ; Stash the answer on the stack.
 $A394 EXX           ; Switch to the normal registers.
 $A395 LD E,L        ; #REGe=#REGl (the low byte of the remainder).
 $A396 LD D,H        ; #REGd=#REGh (the high byte of the remainder).
 $A397 POP HL        ; Fetch the answer.
 $A398 RET           ; Return.
@label=Divide_Restore
*$A399 POP HL        ; Restore the working number from the stack.
 $A39A EXX           ; Switch to the shadow registers.
 $A39B ADD HL,HL     ; Shift the answer left by one.
 $A39C JR $A391      ; Jump to #R$A391 to move on to the next bit.
; View the equivalent code in;
; #LIST
; { #UNDERWURLDE$AC75 }
; LIST#

; Negate HL
;
; Used by the routine at #R$9C79.
; .
; Replaces #REGhl with its two's complement (i.e. #REGhl=#N$0000 -
; #REGhl).
;
;   HL The value
; O:HL The negated value
@label=NegateHL
c$A39E PUSH DE       ; Stash #REGde on the stack.
 $A39F EX DE,HL      ; #REGde=#REGhl.
 $A3A0 LD HL,$0000   ; #REGhl=#N$0000.
 $A3A3 AND A         ; {Subtract the value.
 $A3A4 SBC HL,DE     ; }
 $A3A6 POP DE        ; Restore #REGde from the stack.
 $A3A7 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #UNDERWURLDE$ADD6 }
; LIST#

; Sounds: Click
;
; Used by the routines at #R$9731, #R$A41B, #R$A427, #R$A438 and #R$A445.
; .
; Plays a tone on the speaker by switching it on and off. Each cycle is a
; wait of the half period with the speaker on and the same wait with the speaker
; off.
; .
; This entry plays one cycle (a click). The entry at #R$A3AA plays the
; number of cycles that is in #REGc, and the routines which follow play other
; tones by loading #REGbc and jumping to it.
; .
; Writing #N$10 to port #N$FE sets the speaker bit and leaves the border black.
; .
; A single click is too short to be heard on its own, so there is no sample for
; it here. It is heard in the run of clicks played by #R$A445 (which has a
; sample), and in those played by #R$A41B, #R$A427 and #R$A438, and when the
; player falls through a trapdoor in #R$9731.
;
; B The half period of the tone (#N$00 is #N$100)
@label=SoundsClick
c$A3A8 LD C,$01      ; #REGc=#N$01 (one cycle).
; This entry point is used by the routines at #R$A3BD, #R$A3C2, #R$A3C7,
; #R$A3D8, #R$A3E0, #R$A3EF, #R$A408, #R$A45F, #R$A48B and #R$A4B0.
; .
; Play #REGc cycles of the tone.
@label=SoundsBeep
*$A3AA LD A,$10      ; #REGa=#N$10 (the speaker bit).
 $A3AC OUT ($FE),A   ; Switch the speaker on.
 $A3AE PUSH BC       ; Stash the cycle counter and the half period on the stack, as the
                     ; wait counts #REGb down to zero.
@label=SoundsClick_OnDelay
*$A3AF DJNZ $A3AF    ; Wait for the half period.
 $A3B1 POP BC        ; Restore the cycle counter and the half period from the
                     ; stack.
 $A3B2 PUSH BC       ; Stash them on the stack again.
 $A3B3 XOR A         ; #REGa=#N$00 (clear the speaker bit).
 $A3B4 OUT ($FE),A   ; Switch the speaker off.
@label=SoundsClick_OffDelay
*$A3B6 DJNZ $A3B6    ; Wait for the half period.
 $A3B8 POP BC        ; Restore the cycle counter and the half period from the
                     ; stack.
 $A3B9 DEC C         ; Decrease the cycle counter by one.
 $A3BA JR NZ,$A3AA   ; Jump back to #R$A3AA until all of the cycles have been
                     ; played.
 $A3BC RET           ; Return.
; View the equivalent code in;
; #LIST
; { #UNDERWURLDE$A068 }
; LIST#

; Sounds: Inventory
;
; Used by the routine at #R$9326.
; .
; Plays the tone for picking up an item, which is #N$40 cycles with a
; half period of #N$40.
; #HTML(#AUDIO0(inventory-tone.wav)(#INCLUDE(InventoryTone)))
@label=SoundsInventory
c$A3BD LD BC,$4040   ; #REGb=#N$40 (the half period) and #REGc=#N$40 (the number of
                     ; cycles).
 $A3C0 JR $A3AA      ; Jump to #R$A3AA to play the tone.

; Sounds: Drop Item
;
; Used by the routine at #R$9358.
; .
; Plays the tone for dropping an item, which is #N$80 cycles with a half
; period of #N$20.
; #HTML(#AUDIO0(drop-item.wav)(#INCLUDE(DropItem)))
@label=SoundsDropItem
c$A3C2 LD BC,$2080   ; #REGb=#N$20 (the half period) and #REGc=#N$80 (the number of
                     ; cycles).
 $A3C5 JR $A3AA      ; Jump to #R$A3AA to play the tone.
; View the equivalent code in;
; #LIST
; { #LUNARJETMAN$B8C3 }
; LIST#

; Sounds: Walking
;
; Used by the routines at #R$80D2, #R$8DC4 and #R$8E26.
; .
; Plays a footstep. The walk counter is increased each time this is
; called. A tone is only played when the counter is odd, which makes it
; every other call, and the half period alternates between #N$60 and #N$40.
; #HTML(#AUDIO0(footstep-sound.wav)(#INCLUDE(FootstepSound)))
@label=SoundsWalking
c$A3C7 LD HL,$5E2F   ; Point #REGhl at the walk counter at #R$5E2F.
 $A3CA INC (HL)      ; Increase the counter by one.
 $A3CB LD A,(HL)     ; Fetch the counter.
 $A3CC BIT 1,A       ; {Jump to #R$A3D8 if bit 1 of the walk counter is not
 $A3CE JR Z,$A3D8    ; set.}
 $A3D0 AND %00000001 ; Keep only bit 0.
 $A3D2 RET Z         ; Return if the counter is even.
 $A3D3 LD BC,$4004   ; #REGb=#N$40 (the half period) and #REGc=#N$04 (the number of
                     ; cycles).
 $A3D6 JR $A3AA      ; Jump to #R$A3AA to play the tone.

; Sounds: Walk Low
;
; Used by the routine at #R$A3C7.
; .
; The second part of #R$A3C7, which plays the lower of the two footsteps.
; The sample for #R$A3C7 includes both footsteps, so there is no separate
; sample for this one.
@label=SoundsWalkLow
c$A3D8 AND %00000001 ; Keep only bit 0.
 $A3DA RET Z         ; Return if the counter is even.
 $A3DB LD BC,$6004   ; #REGb=#N$60 (the half period) and #REGc=#N$04 (the number of
                     ; cycles).
 $A3DE JR $A3AA      ; Jump to #R$A3AA to play the tone.

; Sounds: Start Beep
;
; Used by the routine at #R$8C8C.
; .
; Plays a beep, which is #N$60 cycles with a half period of #N$80.
; #HTML(#AUDIO0(start-beep.wav)(#INCLUDE(StartBeep)))
@label=SoundsStart
c$A3E0 LD BC,$8060   ; #REGb=#N$80 (the half period) and #REGc=#N$60 (the number of
                     ; cycles).
 $A3E3 JR $A3AA      ; Jump to #R$A3AA to play the tone.

; Sounds: Touching
;
; Used by the routines at #R$85B2 and #R$988B.
; .
; Queues a sound that is played by #R$A3EF, one note on each pass of
; the main loop.
; #HTML(#AUDIO0(touching.wav)(#INCLUDE(Touching)))
@label=SoundsTouching
c$A3E5 LD BC,$6410   ; #REGb=#N$64 (the sound handler) and #REGc=#N$10 (the
                     ; count).

; Queue Sound
;
; Used by the routines at #R$A403 and #R$A485.
; .
; Sets up the sound entity at #R$EAA0, so that its handler is called on
; each pass of the main loop to play the notes of the sound one by one.
;
; B The sound handler (the first byte of the entity)
; C The count of notes (the second byte of the entity)
@label=QueueSound
c$A3E8 LD HL,$EAA0   ; Point #REGhl at the sound entity at #R$EAA0.
 $A3EB LD (HL),B     ; Write the sound handler to the first byte.
 $A3EC INC HL        ; Move to the second byte.
 $A3ED LD (HL),C     ; Write the count to the second byte.
 $A3EE RET           ; Return.

; Sound Effect
;
; The handler of the sound entity for the sound set up by #R$A3E5. The
; count in the second byte of the entity is decreased on each pass of the main
; loop. When the count reaches zero the entity is cleared. Until then it plays
; a tone of as many cycles as the count, with a half period of the count
; exclusive ORed with #N$43, so the pitch changes as the count falls.
;
; IX The sound entity
@label=SoundEffect
c$A3EF DEC (IX+$01)  ; {Decrease the count of notes, and jump to #R$A3FE if there are none
 $A3F2 JR Z,$A3FE    ; left.}
 $A3F4 LD A,(IX+$01) ; {Fetch the count and keep the number of cycles in #REGc.
 $A3F7 LD C,A        ; }
 $A3F8 XOR %01000011 ; Combine the count with #N$43 to make the half period.
 $A3FA LD B,A        ; Keep the half period in #REGb.
 $A3FB JP $A3AA      ; Jump to #R$A3AA to play the tone.
; View the equivalent code in;
; #LIST
; { #UNDERWURLDE$A0AC }
; LIST#

; Clear Sound
;
; Used by the routines at #R$A3EF, #R$A408 and #R$A48B.
; .
; Clears the first byte of the sound entity, so that it does nothing on
; the following passes of the main loop.
;
; IX The sound entity
@label=ClearSound
c$A3FE LD (IX+$00),$00 ; Write #N$00 to the first byte of the entity.
 $A402 RET             ; Return.

; Sounds: Entry
;
; Used by the routine at #R$9147.
; .
; Queues a sound that is played by #R$A408, one note on each pass of
; the main loop.
; #HTML(#AUDIO0(enter-room.wav)(#INCLUDE(EnterRoom)))
@label=SoundsEntry
c$A403 LD BC,$650A   ; #REGb=#N$65 (the sound handler) and #REGc=#N$0A (the
                     ; count).
 $A406 JR $A3E8      ; Jump to #R$A3E8 to queue the sound.

; Sound Effect Next Note
;
; The handler of the sound entity for the sound set up by #R$A403. The
; count in the second byte of the entity is decreased on each pass of the main
; loop. When the count reaches zero the entity is cleared. Until then it plays
; a tone of as many cycles as the count, and the half period is made from the
; count (rotated left three times, flipped and exclusive ORed with #N$40).
;
; IX The sound entity
@label=SoundEffectNext
c$A408 DEC (IX+$01)  ; {Decrease the count of notes, and jump to #R$A3FE if there are none
 $A40B JR Z,$A3FE    ; left.}
 $A40D LD A,(IX+$01) ; {Fetch the count and keep the number of cycles in #REGc.
 $A410 LD C,A        ; }
 $A411 RLCA          ; {Rotate left three times.
 $A412 RLCA          ;
 $A413 RLCA          ; }
 $A414 CPL           ; Flip the bits.
 $A415 XOR %01000000 ; Flip bit 6.
 $A417 LD B,A        ; Keep the half period in #REGb.
 $A418 JP $A3AA      ; Jump to #R$A3AA to play the tone.
; View the equivalent code in;
; #LIST
; { #UNDERWURLDE$A0C5 }
; LIST#

; Sounds: Axe Throw
;
; Used by the routine at #R$8134.
; .
; Plays #N$0C clicks, one straight after the other. The half period of
; each click is the counter rotated right once.
; #HTML(#AUDIO0(axe-throw.wav)(#INCLUDE(AxeThrow)))
@label=SoundsAxeThrow
c$A41B LD D,$0C      ; #REGd=#N$0C (the counter).
@label=SoundsAxeThrow_Loop
*$A41D LD A,D        ; Fetch the click counter.
 $A41E RRCA          ; Rotate right once.
 $A41F LD B,A        ; Keep the half period in #REGb.
 $A420 CALL $A3A8    ; Play a click with #R$A3A8.
 $A423 DEC D         ; {Decrease the counter by one and loop back to #R$A41D until all of
 $A424 JR NZ,$A41D   ; the clicks have been played.}
 $A426 RET           ; Return.

; Sounds: Sword
;
; Used by the routine at #R$8283.
; .
; Plays #N$10 clicks, one straight after the other. The half period of
; each click is the counter rotated left twice, exclusive ORed with #N$07 and
; rotated left twice again.
; #HTML(#AUDIO0(sword.wav)(#INCLUDE(Sword)))
@label=SoundsSword
c$A427 LD D,$10      ; #REGd=#N$10 (the counter).
@label=SoundsSword_Loop
*$A429 LD A,D        ; Fetch the click counter.
 $A42A RLCA          ; {Rotate left twice.
 $A42B RLCA          ; }
 $A42C XOR %00000111 ; Flip bits 0-2.
 $A42E RLCA          ; {Rotate left twice.
 $A42F RLCA          ; }
 $A430 LD B,A        ; Keep the half period in #REGb.
 $A431 CALL $A3A8    ; Play a click with #R$A3A8.
 $A434 DEC D         ; {Decrease the counter by one and loop back to #R$A429 until all of
 $A435 JR NZ,$A429   ; the clicks have been played.}
 $A437 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #UNDERWURLDE$A0E4 }
; LIST#

; Sounds: Fireball
;
; Used by the routine at #R$814B.
; .
; Plays #N$08 clicks, one straight after the other. The half period of
; each click is the counter flipped and rotated left once.
; #HTML(#AUDIO0(fireball.wav)(#INCLUDE(Fireball)))
@label=SoundsFireball
c$A438 LD D,$08      ; #REGd=#N$08 (the counter).
@label=SoundsFireball_Loop
*$A43A LD A,D        ; Fetch the click counter.
 $A43B CPL           ; Flip the bits.
 $A43C RLCA          ; Rotate left once.
 $A43D LD B,A        ; Keep the half period in #REGb.
 $A43E CALL $A3A8    ; Play a click with #R$A3A8.
 $A441 DEC D         ; {Decrease the counter by one and loop back to #R$A43A until all of
 $A442 JR NZ,$A43A   ; the clicks have been played.}
 $A444 RET           ; Return.

; Sounds: Weapon Pop
;
; Used by the routine at #R$8209.
; .
; Plays a run of clicks. The number of clicks comes from #R$5E25, and the
; counter goes down by two each time.
; #HTML(#AUDIO0(weapon-pop.wav)(#INCLUDE(WeaponPop)))
@label=SoundsWeaponPop
c$A445 LD A,($5E25)  ; Fetch the number of creatures from #R$5E25.
 $A448 INC A         ; Increment #REGa by one.
 $A449 RLCA          ; {Rotate left four times.
 $A44A RLCA          ;
 $A44B RLCA          ;
 $A44C RLCA          ; }
 $A44D OR %00001111  ; Set bits 0-3.
 $A44F AND %01111111 ; Keep only bits 0-6.
 $A451 LD D,A        ; Keep the counter in #REGd.
@label=SoundsWeaponPop_Loop
*$A452 LD A,D        ; Fetch the counter.
 $A453 XOR %00100000 ; Flip bit 5.
 $A455 LD B,A        ; Keep the half period in #REGb.
 $A456 CALL $A3A8    ; Play a click with #R$A3A8.
 $A459 DEC D         ; {Decrease the counter by one, and return if it is zero.
 $A45A RET Z         ; }
 $A45B DEC D         ; {Decrease the counter by one again, and return if it is
 $A45C RET Z         ; zero.}
 $A45D JR $A452      ; Jump back to #R$A452.
; View the equivalent code in;
; #LIST
; { #UNDERWURLDE$A107 }
; LIST#

; Sounds: Appear
;
; Used by the routine at #R$8CB7.
; .
; Plays a tone of #N$10 cycles. The half period is made from the seventh
; byte of the entity (flipped, rotated left once and limited to the range
; #N$40 to #N$7F), so it changes as the byte does.
; #HTML(#AUDIO0(appearing-sound.wav)(#INCLUDE(AppearingSound)))
;
; IX The entity
@label=SoundsAppear
c$A45F LD A,(IX+$06) ; Fetch offset #N$06 of the entity.
 $A462 CPL           ; Flip the bits.
 $A463 RLCA          ; Rotate left once.
 $A464 AND %00111111 ; Keep only bits 0-5.
 $A466 OR %01000000  ; Set bit 6.
 $A468 LD B,A        ; Keep the half period in #REGb.
 $A469 LD C,$10      ; #REGc=#N$10 (the number of cycles).
 $A46B JP $A3AA      ; Jump to #R$A3AA to play the tone.

; Sounds: Door
;
; Used by the routines at #R$917D and #R$91C5.
; .
; Makes a burst of noise by sending the bits of the first #N$30 bytes of
; the ROM to the speaker. Bit 4 of the port is the speaker bit.
; #HTML(#AUDIO0(door.wav)(#INCLUDE(Door)))
@label=SoundsDoor
c$A46E LD BC,$0830   ; #REGb=#N$08 (the number of bits in a byte) and #REGc=#N$30 (the
                     ; number of bytes).
 $A471 LD HL,$0000   ; #REGhl=#N$0000 (the start of the ROM).
@label=SoundsDoor_Byte
*$A474 LD E,(HL)     ; Fetch the next byte of the ROM.
 $A475 INC HL        ; Move on to the next byte.
 $A476 PUSH BC       ; Stash the counters on the stack.
@label=SoundsDoor_Bit
*$A477 RRC E         ; Rotate #REGe right by one.
 $A479 LD A,E        ; #REGa=#REGe.
 $A47A AND %00010000 ; Keep only bit 4 (the speaker bit).
 $A47C OUT ($FE),A   ; Send it to the speaker.
 $A47E DJNZ $A477    ; Decrease the bit counter by one and loop back to #R$A477 until it is
                     ; zero.
 $A480 POP BC        ; Restore the counters from the stack.
 $A481 DEC C         ; {Decrease the byte counter by one and loop back to #R$A474 until all
 $A482 JR NZ,$A474   ; of the bytes have been sent.}
 $A484 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #UNDERWURLDE$A131 }
; LIST#

; Sounds: Eating
;
; Used by the routine at #R$8C63.
; .
; Queues a sound that is played by #R$A48B, one note on each pass of
; the main loop.
; #HTML(#AUDIO0(eating.wav)(#INCLUDE(Eating)))
@label=SoundsEating
c$A485 LD BC,$A010   ; #REGb=#N$A0 (the sound handler) and #REGc=#N$10 (the
                     ; count).
 $A488 JP $A3E8      ; Jump to #R$A3E8 to queue the sound.

; Sound Effect Eating
;
; The handler of the sound entity for the sound set up by #R$A485. The
; count in the second byte of the entity is decreased on each pass of the main
; loop. When it goes below zero the entity is cleared. Until then it plays a
; tone of #N$08 cycles, and the count picks the half period from the table at
; #R$A4A0.
;
; IX The sound entity
@label=SoundEffectEating
c$A48B DEC (IX+$01)  ; {Decrease the count of notes, and jump to #R$A3FE if it is below
 $A48E JP M,$A3FE    ; zero.}
 $A491 LD C,(IX+$01) ; Fetch the count.
 $A494 LD B,$00      ; #REGb=#N$00.
 $A496 LD HL,$A4A0   ; Point #REGhl at the eating tones at #R$A4A0.
 $A499 ADD HL,BC     ; Add the count to the address of the table.
 $A49A LD B,(HL)     ; Fetch the half period from the table.
 $A49B LD C,$08      ; #REGc=#N$08 (the number of cycles).
 $A49D JP $A3AA      ; Jump to #R$A3AA to play the tone.

; Eating Tones
;
; The half period of each note of the eating sound. They are played from
; the last to the first, one on each pass of the main loop.
@label=TableTonesEating
b$A4A0 DEFB $80,$90,$80,$90,$80,$90,$80,$90
 $A4A8 DEFB $80,$70,$60,$50,$40,$30,$20,$10

; Sounds: Bounce
;
; Used by the routine at #R$8209.
; .
; Plays a tone of #N$04 cycles. The half period is made by rotating the
; counter right three times. The counter is set to #N$40 and decreased before it
; is tested for zero, so the routine always carries on and plays the tone, with
; a half period of #N$E7.
; #HTML(#AUDIO0(bounce.wav)(#INCLUDE(Bounce)))
@label=SoundsBounce
c$A4B0 LD D,$40      ; #REGd=#N$40.
 $A4B2 DEC D         ; Decrease #REGd by one.
 $A4B3 RET Z         ; Return if it is zero.
 $A4B4 LD A,D        ; #REGa=#REGd.
 $A4B5 RRCA          ; {Rotate right three times.
 $A4B6 RRCA          ;
 $A4B7 RRCA          ; }
 $A4B8 LD B,A        ; Keep the half period in #REGb.
 $A4B9 LD C,$04      ; #REGc=#N$04 (the number of cycles).
 $A4BB JP $A3AA      ; Jump to #R$A3AA to play the tone.
; View the equivalent code in;
; #LIST
; { #UNDERWURLDE$A173 }
; LIST#

