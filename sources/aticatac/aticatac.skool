 $BDAA DEFB $0D,$FF             ; Corner #N$0D has no lines to draw.
 $BDAC DEFB $0E,$0F,$0D,$0C,$FF ; Start at corner #N$0E and draw lines to corners #N$0F, #N$0D and
                                ; #N$0C.
 $BDB1 DEFB $0F,$FF             ; Corner #N$0F has no lines to draw.
