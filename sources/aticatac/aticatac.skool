; Room Shape #N$0B Coordinates
;
; The coordinates of the corners of the frame of room shape #N$0B (see
; #R$A982), each of which is an X position followed by a Y position. The corners
; are numbered from #N$00, and the lines between them are listed at #R$A9D8. It
; is used by room #N$8E.
@label=RoomShape_0B_Coordinates
b$A9D0 DEFB $04,$BF  ; Corner #N((#PC - $A9D0) / $02).
 $A9D2 DEFB $04,$00  ; Corner #N((#PC - $A9D0) / $02).
 $A9D4 DEFB $1F,$BF  ; Corner #N((#PC - $A9D0) / $02).
 $A9D6 DEFB $1F,$00  ; Corner #N((#PC - $A9D0) / $02).

; Room Shape #N$0B Lines
;
; The lines that join the corners of the frame of room shape #N$0B (see
; #R$A982). Each list has the corner to start from, followed by the corners to
; draw lines to, and ends with #N$FF. The last byte is #N$FF to end all of the
; lists, and the corners are those at #R$A9D0.
@label=RoomShape_0B_Lines
b$A9D8 DEFB $00,$01,$FF ; Start at corner #N$00 and draw lines to corner #N$01.
 $A9DB DEFB $02,$03,$FF ; Start at corner #N$02 and draw lines to corner #N$03.
 $A9DE DEFB $FF         ; Terminator.

; Room Shape #N$00 Coordinates
;
; The coordinates of the corners of the frame of room shape #N$00 (see
; #R$A982), each of which is an X position followed by a Y position. The corners
; are numbered from #N$00, and the lines between them are listed at #R$A9EF. It
; is used by 55 rooms.
@label=RoomShape_00_Coordinates
b$A9DF DEFB $04,$BB  ; Corner #N((#PC - $A9DF) / $02).
 $A9E1 DEFB $04,$04  ; Corner #N((#PC - $A9DF) / $02).
