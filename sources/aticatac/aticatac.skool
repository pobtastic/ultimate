; Room Shape Table
;
; One entry of six bytes for each of the #N$0D shapes that the frame of a
; room can have, read by #R$9BEA. The entry has the width and the height of the
; floor, the address of the coordinates of the corners of the frame and the
; address of the lists of the lines to draw between those corners. The shape of
; a room comes from its entry in #R$A854. No room uses shapes #N$06 or #N$07.
@label=RoomShapeTable
b$A982 DEFB $38      ; Width: #N(#PEEK(#PC)).
 $A983 DEFB $38      ; Height: #N(#PEEK(#PC)).
 $A984 DEFW $A9DF    ; Coordinates: #R(#PEEK(#PC) + #PEEK(#PC + $01) * $100).
 $A986 DEFW $A9EF    ; Lines: #R(#PEEK(#PC) + #PEEK(#PC + $01) * $100).
 $A988 DEFB $28      ; Width: #N(#PEEK(#PC)).
 $A989 DEFB $28      ; Height: #N(#PEEK(#PC)).
 $A98A DEFW $AA04    ; Coordinates: #R(#PEEK(#PC) + #PEEK(#PC + $01) * $100).
 $A98C DEFW $AA78    ; Lines: #R(#PEEK(#PC) + #PEEK(#PC + $01) * $100).
 $A98E DEFB $38      ; Width: #N(#PEEK(#PC)).
 $A98F DEFB $38      ; Height: #N(#PEEK(#PC)).
 $A990 DEFW $AB34    ; Coordinates: #R(#PEEK(#PC) + #PEEK(#PC + $01) * $100).
 $A992 DEFW $AB54    ; Lines: #R(#PEEK(#PC) + #PEEK(#PC + $01) * $100).
 $A994 DEFB $38      ; Width: #N(#PEEK(#PC)).
 $A995 DEFB $18      ; Height: #N(#PEEK(#PC)).
 $A996 DEFW $AB7D    ; Coordinates: #R(#PEEK(#PC) + #PEEK(#PC + $01) * $100).
 $A998 DEFW $A9EF    ; Lines: #R(#PEEK(#PC) + #PEEK(#PC + $01) * $100).
 $A99A DEFB $18      ; Width: #N(#PEEK(#PC)).
 $A99B DEFB $38      ; Height: #N(#PEEK(#PC)).
 $A99C DEFW $AB8D    ; Coordinates: #R(#PEEK(#PC) + #PEEK(#PC + $01) * $100).
 $A99E DEFW $A9EF    ; Lines: #R(#PEEK(#PC) + #PEEK(#PC + $01) * $100).
 $A9A0 DEFB $10      ; Width: #N(#PEEK(#PC)).
