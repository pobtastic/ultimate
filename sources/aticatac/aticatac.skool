; Unused
;
; The space between the last of the graphics and the entities. The game
; does not use it, and it is all zero apart from three bytes that no code refers
; to by address.
s$D505 DEFS $06
 $D50B DEFB $01
 $D50C DEFS $F2
 $D5FE DEFB $85,$3A
 $D600 DEFS $1490

; Player
;
; Entities are 8-byte records, held in the table that starts here.
; #TABLE(default,centre,left)
; { =h Offset | =h Description }
; { #N$00 | Sprite ID (also the index of the handler in #R$7EE6) }
; { #N$01 | Room ID }
; { #N$02 | Used by the handler of the entity }
; { #N$03 | X position (pixels) }
; { #N$04 | Y position (pixels) }
; { #N$05 | Attribute }
; { #N$06 | Used by the handler of the entity }
; { #N$07 | Used by the handler of the entity }
; TABLE#
; .
; The player is the first entity. Every entity from here up to #R$EEE0 is a copy
; of the data from #R$600D onwards, which #R$8D61 copies when a game starts, and
; this one is set up from #R$9481 for each life by #R$9443.
@label=Player
b$EA90 DEFB $00      ; Sprite ID (the frame that the player is drawn with).
@label=PlayerRoom
 $EA91 DEFB $00      ; Room ID (the room that the player is in).
 $EA92 DEFB $00      ; Used by the handler of the entity.
 $EA93 DEFB $00      ; X position.
 $EA94 DEFB $00      ; Y position.
 $EA95 DEFB $00      ; Attribute.
 $EA96 DEFB $00      ; Number of rows drawn so far while the player is appearing (see
                     ; #R$8CB7).
 $EA97 DEFB $00      ; Sprite ID of the character (see #R$9443).

; Player Weapon
;
; The 16-byte record for the weapon that the player throws, which is a
; copy of #R$6015. The second half is the entity for the sound effects (see
; #R$601D).
@label=PlayerWeapon
b$EA98 DEFB $00,$00,$00,$00,$00,$00         ; The sprite ID, room, flags, X position, Y position and attribute of
                                            ; the weapon.
@label=PlayerWeapon_X_Velocity
 $EA9E DEFB $00                             ; The X velocity of the weapon.
@label=PlayerWeapon_Y_Velocity
 $EA9F DEFB $00                             ; The Y velocity of the weapon.
@label=PlayerWeapon_Sound
 $EAA0 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; The second half, which is the
                                            ; sound entity.

