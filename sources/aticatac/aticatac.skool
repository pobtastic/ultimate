; Create Delay
;
; The handler for entities that have nothing to do. If the entity is one
; of the first three 16-byte records, which start at #R$EE60, then a short
; delay loop is run before returning. Otherwise it returns straight away.
;
; IX The entity
@label=CreateDelay
c$807A PUSH IX       ; {Copy #REGix to #REGhl (using the stack).
 $807C POP HL        ; }
 $807D LD DE,$EE60   ; Point #REGde at the creatures at #R$EE60.
 $8080 AND A         ; {Subtract #REGde from #REGhl, to get the offset of the entity into
 $8081 SBC HL,DE     ; the 16-byte records.}
 $8083 LD A,H        ; {Return if the high byte of the offset is not zero.
 $8084 AND A         ;
 $8085 RET NZ        ; }
 $8086 LD A,L        ; {Return if the low byte of the offset is #N$30 or more.
 $8087 CP $30        ;
 $8089 RET NC        ; }
 $808A LD HL,$00C0   ; #REGhl=#N($00C0,$04,$04) (the length of the delay).
@label=CreateDelay_Loop
*$808D DEC HL        ; Decrease the delay counter by one.
 $808E LD A,H        ; {Loop back to #R$808D until the delay counter is zero.
 $808F OR L          ;
 $8090 JR NZ,$808D   ; }
 $8092 RET           ; Return.

; Clear Play Area
;
; Used by the routines at #R$8C35, #R$9147 and #R$9731.
; .
; Clears the pixels of the play area, which is the left-hand #N$18 bytes
; of each of the #N$C0 rows of the screen buffer. The attributes are left
; alone.
; #PUSHS #POKES$5C78,$34,$02 #POKES$5CB0,$E9
; #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$7D9A,stop=$7DDC,clear=1,sp=$5E00)
; #SCR$01(clear-play-area-before)
; | #SIM(start=$8093,stop=$0000,sp=$5B60)
; #SCR$01(clear-play-area-after) } UDGTABLE# #POPS
@label=ClearPlayArea
c$8093 LD HL,$4000   ; #REGhl=#N$4000 (the start of the screen buffer).
 $8096 LD BC,$18C0   ; #REGb=#N$18 (the number of bytes to clear in each row) and
                     ; #REGc=#N$C0 (the number of rows).
 $8099 XOR A         ; #REGa=#N$00 (the value to write).
; This entry point is used by the routines at #R$9BEA and #R$A240.
; .
; Each pass of this loop clears one row.
@label=ClearPlayArea_Row
*$809A PUSH BC       ; Stash the counters on the stack.
 $809B PUSH HL       ; Stash the row address on the stack.
 $809C LD DE,$0020   ; #REGde=#N($0020,$04,$04) (the size of a row).
@label=ClearPlayArea_Byte
*$809F LD (HL),A     ; Write #REGa to *#REGhl.
 $80A0 INC HL        ; Move #REGhl on to the next byte.
 $80A1 DJNZ $809F    ; Decrease the byte counter by one and loop back to #R$809F until the
                     ; whole row has been cleared.
 $80A3 POP HL        ; Restore the row address from the stack.
 $80A4 ADD HL,DE     ; Move #REGhl on to the next row.
 $80A5 POP BC        ; Restore the counters from the stack.
 $80A6 DEC C         ; {Decrease the row counter by one and loop back to #R$809A until all
 $80A7 JR NZ,$809A   ; #N$C0 rows have been cleared.}
 $80A9 RET           ; Return.

; Clear Screen
;
; Used by the routines at #R$7C19 and #R$7D9A.
; .
; Clears the attributes and the pixels of the whole screen, and sets the
; border to black.
; #PUSHS #POKES$5C78,$34,$02 #POKES$5CB0,$E9
; #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$7D9A,stop=$7DDC,clear=1,sp=$5E00)
; #SCR$01(clear-screen-before)
; | #SIM(start=$80AA,stop=$0000,sp=$5B60)
; #SCR$01(clear-screen-after) } UDGTABLE# #POPS
@label=ClearScreen
c$80AA CALL $80C2    ; Call #R$80C2 to clear the attribute buffer.
 $80AD CALL $80B4    ; Call #R$80B4 to clear the screen buffer.
 $80B0 XOR A         ; {Set the border to #INK$00.
 $80B1 OUT ($FE),A   ; }
 $80B3 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #COOKIE$5FB7 }
; { #PSSST$5F53 }
; LIST#

; Reset Screen Buffer
;
; Used by the routine at #R$80AA.
; .
; Points at the start of the screen buffer and fills it with #N$00.
@label=ResetScreen
c$80B4 LD HL,$4000   ; #REGhl=#N$4000 (the start of the screen buffer).
 $80B7 LD B,$58      ; #REGb=#N$58 (i.e. finish once we reach the start of the attribute
                     ; buffer at #N$5800).
; This entry point is used by the routine at #R$80CB.
@label=ResetScreen_Fill
*$80B9 LD C,$00      ; Set the value to write in #REGc to #N$00.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CE60 }
; { #COOKIE$74D4 }
; { #CYBERUN$9A7E }
; { #GUNFRIGHT$D6DB }
; { #JETPAC$71B8 }
; { #KNIGHTLORE$D544 }
; { #LUNARJETMAN$84AD }
; { #NIGHTSHADE$E5A8 }
; { #PSSST$7439 }
; { #SABREWULF$BB81 }
; { #TRANZAM$7211 }
; LIST#
; .
; Continue on to #R$80BB to blank the screen buffer.

; Fill Memory
;
; Used by the routine at #R$80C2.
; .
; Writes a single byte to memory from the target address, up to (but not
; including) the first address whose high byte is the end value.
;
; HL Target address
; B The high byte of the end address (the fill stops at an LSB of #N$00)
; C Value to write
@label=ResetCopier
c$80BB LD (HL),C     ; Write the fill value to the byte at the target address.
 $80BC INC HL        ; Move on to the next address.
 $80BD LD A,H        ; {Loop back to #R$80BB until the target address has reached the end
 $80BE CP B          ; address.
 $80BF JR NZ,$80BB   ; }
 $80C1 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #COOKIE$74DB }
; { #JETPAC$71BF }
; { #LUNARJETMAN$84B4 }
; { #PSSST$7440 }
; { #SABREWULF$BB88 }
; { #TRANZAM$7218 }
; LIST#

; Reset Attribute Buffer
;
; Used by the routine at #R$80AA.
; .
; Points at the attribute buffer and jumps into #R$80BB to fill it with
; #N$00.
@label=ResetAttributes
c$80C2 LD HL,$5800   ; #REGhl=#N$5800 (the start of the attribute buffer).
 $80C5 LD B,$5B      ; #REGb=#N$5B (i.e. finish once we reach the end of the attribute
                     ; buffer).
 $80C7 LD C,$00      ; Set the value to write in #REGc to #N$00.
 $80C9 JR $80BB      ; Jump to #R$80BB to fill the memory.
; View the equivalent code in;
; #LIST
; { #COOKIE$74E2 }
; { #JETPAC$71C6 }
; { #LUNARJETMAN$84BB }
; { #PSSST$7447 }
; { #SABREWULF$BB8F }
; { #TRANZAM$7200 }
; LIST#

; Reset Player Data
;
; Used by the routine at #R$7D9A.
; .
; Clears the game variables by filling memory from #R$5E10 up to #N$5FFF
; with #N$00. This leaves the game options and font pointer alone.
@label=ResetPlayerData
c$80CB LD HL,$5E10   ; Point #REGhl at the sprite width at #R$5E10.
 $80CE LD B,$60      ; #REGb=#N$60 (i.e. finish once we reach #N$6000).
 $80D0 JR $80B9      ; Jump to #R$80B9 to fill the memory with the value to
                     ; write.

; Handle Wizard
;
; The handler for the wizard, which has the sprite IDs #N$11 to #N$20.
; The speed limits and the friction are passed to #R$8D77, which reads the
; controls and moves the player. Then, every fourth frame while the player is
; moving, the walking frame is advanced and the sprite is turned to face the
; direction of the strongest movement. If the fire button is pressed then a
; fireball is thrown by #R$814B. The routine finishes by jumping to the code
; that is shared with the other characters at #R$8E78.
;
; IX The player entity
;
; Control the player. #REGbc holds the speed limits (#REGc for X and
; #REGb for Y, where #REGb is also the acceleration) and #REGde holds the
; friction (#REGe for X and #REGd for Y). #REGhl is not used by #R$8D77.
@label=HandlerWizard
c$80D2 LD BC,$2020   ; Set the speed limits in #REGbc to #N$20 on both axes.
 $80D5 LD DE,$2020   ; Set the friction in #REGde to #N$20 on both axes.
 $80D8 LD HL,$2020   ; #REGhl=#N($2020,$04,$04), which is not used by #R$8D77.
 $80DB CALL $8D77    ; Call #R$8D77 to control the player.
; Only change the walking frame if the player is moving.
 $80DE LD E,(IX+$06) ; Fetch the X velocity of the player into #REGe.
 $80E1 LD D,(IX+$07) ; Fetch the Y velocity of the player into #REGd.
 $80E4 LD A,D        ; {Jump to #R$811D if the player is not moving.
 $80E5 OR E          ;
 $80E6 JR Z,$811D    ; }
; The walking frame only changes every fourth frame.
 $80E8 LD A,($5C78)  ; Fetch FRAMES.
 $80EB AND %00000011 ; Keep only bits 0-1.
 $80ED JR NZ,$811D   ; Jump to #R$811D if the result is not zero.
; Move on to the next of the four walking frames.
 $80EF LD A,(IX+$00) ; Fetch the sprite ID of the player.
 $80F2 AND %00000011 ; Keep only bits 0-1.
 $80F4 ADD A,$11     ; Add #N$11, which gives the next walking frame.
 $80F6 LD (IX+$00),A ; Write the new sprite ID back to the player.
; Make a copy of the Y speed, ignoring the direction.
 $80F9 LD A,D        ; {Fetch the Y velocity from #REGd, then jump to #R$8100 if it is
 $80FA AND A         ; positive.
 $80FB JP P,$8100    ; }
 $80FE NEG           ; Make the Y speed positive.
@label=HandlerWizard_AbsoluteX
*$8100 LD C,A        ; Keep the Y speed in #REGc.
; Make a copy of the X speed, ignoring the direction.
 $8101 LD A,E        ; {Fetch the X velocity from #REGe, then jump to #R$8108 if it is
 $8102 AND A         ; positive.
 $8103 JP P,$8108    ; }
 $8106 NEG           ; Make the X speed positive.
@label=HandlerWizard_CompareAxes
*$8108 CP C          ; {Jump to #R$8128 if the X speed is the strongest
 $8109 JR NC,$8128   ; movement.}
; The Y movement is the strongest, so face up or down.
 $810B LD A,D        ; {Test the sign of the Y velocity.
 $810C AND A         ; }
 $810D LD A,(IX+$00) ; Fetch the sprite ID of the player.
 $8110 JP M,$8115    ; Jump to #R$8115 if the player is moving up.
 $8113 ADD A,$04     ; Add #N$04 to select the sprites for moving down.
@label=HandlerWizard_Vertical
*$8115 ADD A,$08     ; Add #N$08.
@label=HandlerWizard_SetSprite
*$8117 LD (IX+$00),A ; Write the new sprite ID back to the player.
 $811A CALL $A3C7    ; Call #R$A3C7 to make the walking sound.
; Check if the fire button is being pressed.
@label=HandlerWizard_Fire
*$811D CALL $93BE    ; Call #R$93BE to read the controls.
 $8120 AND %00010000 ; Keep only bit 4.
 $8122 CALL Z,$814B  ; Call #R$814B if the fire button is pressed.
 $8125 JP $8E78      ; Jump to #R$8E78 to finish handling the character.
; The X movement is the strongest, so face left or right.
@label=HandlerWizard_Horizontal
*$8128 LD A,E        ; {Test the sign of the X velocity.
 $8129 AND A         ; }
 $812A LD A,(IX+$00) ; Fetch the sprite ID of the player.
 $812D JP M,$8117    ; Jump to #R$8117 if the player is moving left.
 $8130 ADD A,$04     ; Add #N$04 to select the sprites for moving right.
 $8132 JR $8117      ; Jump to #R$8117 to set the sprite of the wizard.

; Throw Axe
;
; Used by the routine at #R$8E26.
; .
; Launches an axe for the knight, unless a weapon is already in flight or
; the player is in a doorway. The axe sprites have the IDs #N$40 to #N$47
; and are animated by #R$81DB.
;
; IX The player entity
@label=ThrowAxe
c$8134 LD A,($EA98)  ; {Return if a weapon is already in flight.
 $8137 AND A         ;
 $8138 RET NZ        ; }
 $8139 LD A,($5E2D)  ; {Return if the player is in a doorway.
 $813C AND A         ;
 $813D RET NZ        ; }
 $813E CALL $A41B    ; Call #R$A41B to make the axe throwing sound.
 $8141 CALL $817C    ; Call #R$817C to set the velocity of the weapon.
 $8144 LD HL,$EA98   ; Point #REGhl at the player weapon at #R$EA98.
 $8147 LD (HL),$40   ; Write #N$40 to the weapon, the sprite ID of the first
                     ; axe frame.
 $8149 JR $8160      ; Jump to #R$8160 to launch the axe.

; Throw Fireball
;
; Used by the routine at #R$80D2.
; .
; Launches a fireball for the wizard, unless a weapon is already in
; flight or the player is in a doorway. The fireball sprites have the IDs
; #N$34 to #N$37 and are animated by #R$81F0.
;
; IX The player entity
@label=ThrowFireball
c$814B LD A,($EA98)  ; {Return if a weapon is already in flight.
 $814E AND A         ;
 $814F RET NZ        ; }
 $8150 LD A,($5E2D)  ; {Return if the player is in a doorway.
 $8153 AND A         ;
 $8154 RET NZ        ; }
 $8155 CALL $A438    ; Call #R$A438 to make the fireball sound.
 $8158 CALL $817C    ; Call #R$817C to set the velocity of the weapon.
 $815B LD HL,$EA98   ; Point #REGhl at the player weapon at #R$EA98.
 $815E LD (HL),$34   ; Write #N$34 to the weapon, the sprite ID of the first fireball
                     ; frame.
; This entry point is used by the routines at #R$8134 and #R$8283.
; .
; Place the weapon in the same room as the player, at the position of the
; player, and draw it.
@label=LaunchWeapon
*$8160 INC HL        ; Move #REGhl on to the room of the weapon.
 $8161 LD A,(IX+$01) ; Fetch the room of the player.
 $8164 LD (HL),A     ; Write the room of the player to the room of the weapon.
 $8165 INC HL        ; {Move #REGhl on to the X position of the weapon.
 $8166 INC HL        ; }
 $8167 LD A,(IX+$03) ; Fetch the X position of the player.
 $816A LD (HL),A     ; Write the X position of the player to the X position of
                     ; the weapon.
 $816B INC HL        ; Move #REGhl on to the Y position of the weapon.
 $816C LD A,(IX+$04) ; Fetch the Y position of the player.
 $816F LD (HL),A     ; Write the Y position of the player to the Y position of
                     ; the weapon.
 $8170 PUSH IX       ; Stash the player entity on the stack.
 $8172 LD IX,$EA98   ; Point #REGix at the weapon at #R$EA98.
 $8176 CALL $9F4A    ; Call #R$9F4A to draw the weapon.
 $8179 POP IX        ; Restore the player entity from the stack.
 $817B RET           ; Return.

; Set Weapon Velocity
;
; Used by the routines at #R$8134, #R$814B and #R$8283.
; .
; Gets a weapon ready to be launched. The lifetime of the weapon is set
; to #N$30 and its flags are cleared. The velocity is #N$04 pixels per frame
; in the direction that the player is moving, or if the player is standing
; still then in the direction that the player is facing.
;
; IX The player entity
;
; Reset the weapon.
@label=SetWeaponVelocity
c$817C LD HL,$EA9E   ; Point #REGhl at the X velocity of the weapon at #R$EA9E.
 $817F LD A,$30      ; {Write #N$30 to #N$EAA7 (the lifetime of the weapon).
 $8181 LD ($EAA7),A  ; }
 $8184 LD A,$00      ; {Write #N$00 to #N$EA9A (the flags of the weapon).
 $8186 LD ($EA9A),A  ; }
; If the player is moving then the weapon follows the direction of the
; movement.
 $8189 LD A,(IX+$06) ; Fetch the X velocity of the player.
 $818C OR (IX+$07)   ; {Jump to #R$81B3 if the player is not moving.
 $818F JR Z,$81B3    ; }
 $8191 LD A,(IX+$06) ; Fetch the X velocity of the player.
 $8194 AND A         ; {Jump to #R$81A0 if the player is not moving
 $8195 JR Z,$81A0    ; horizontally.}
 $8197 JP M,$819E    ; Jump to #R$819E if the player is moving left.
 $819A LD A,$04      ; #REGa=#N$04 (the velocity for moving right).
 $819C JR $81A0      ; Jump to #R$81A0 to store the X velocity of the weapon.
@label=SetWeaponVelocity_Left
*$819E LD A,$FC      ; #REGa=#N$FC (-#N$04, the velocity for moving left).
@label=SetWeaponVelocity_StoreX
*$81A0 LD (HL),A     ; Update the X velocity of the weapon.
 $81A1 INC HL        ; Move #REGhl on to the Y velocity of the weapon.
 $81A2 LD A,(IX+$07) ; Fetch the Y velocity of the player.
 $81A5 AND A         ; {Jump to #R$81B1 if the player is not moving vertically.
 $81A6 JR Z,$81B1    ; }
 $81A8 JP M,$81AF    ; Jump to #R$81AF if the player is moving up.
 $81AB LD A,$04      ; #REGa=#N$04 (the velocity for moving down).
 $81AD JR $81B1      ; Jump to #R$81B1 to store the Y velocity of the weapon.
@label=SetWeaponVelocity_Up
*$81AF LD A,$FC      ; #REGa=#N$FC (-#N$04, the velocity for moving up).
@label=SetWeaponVelocity_StoreY
*$81B1 LD (HL),A     ; Update the Y velocity of the weapon.
 $81B2 RET           ; Return.
; The player is standing still, so use the direction that the sprite is
; facing.
@label=SetWeaponVelocity_Facing
*$81B3 LD A,(IX+$00) ; Fetch the sprite ID of the player.
 $81B6 DEC A         ; Decrease #REGa by one.
 $81B7 AND %00001100 ; Keep only bits 2-3, which is the direction.
 $81B9 JR Z,$81C9    ; Jump to #R$81C9 if the player is facing left.
 $81BB CP $04        ; {Jump to #R$81CF if the player is facing right.
 $81BD JR Z,$81CF    ; }
 $81BF CP $08        ; {Jump to #R$81D5 if the player is not facing up.
 $81C1 JR NZ,$81D5   ; }
 $81C3 LD (HL),$00   ; Write #N$00 to the X velocity of the weapon.
 $81C5 INC HL        ; Move #REGhl on to the Y velocity of the weapon.
 $81C6 LD (HL),$FC   ; Write #N$FC (-#N$04) to the Y velocity of the weapon.
 $81C8 RET           ; Return.
@label=SetWeaponVelocity_FacingLeft
*$81C9 LD (HL),$FC   ; Write #N$FC (-#N$04) to the X velocity of the weapon.
 $81CB INC HL        ; Move #REGhl on to the Y velocity of the weapon.
 $81CC LD (HL),$00   ; Write #N$00 to the Y velocity of the weapon.
 $81CE RET           ; Return.
@label=SetWeaponVelocity_FacingRight
*$81CF LD (HL),$04   ; Write #N$04 to the X velocity of the weapon.
 $81D1 INC HL        ; Move #REGhl on to the Y velocity of the weapon.
 $81D2 LD (HL),$00   ; Write #N$00 to the Y velocity of the weapon.
 $81D4 RET           ; Return.
@label=SetWeaponVelocity_FacingDown
*$81D5 LD (HL),$00   ; Write #N$00 to the X velocity of the weapon.
 $81D7 INC HL        ; Move #REGhl on to the Y velocity of the weapon.
 $81D8 LD (HL),$04   ; Write #N$04 to the Y velocity of the weapon.
 $81DA RET           ; Return.

; Handle Axe
;
; The handler for a thrown axe, which has the sprite IDs #N$40 to #N$47.
; Picks the animation frame from FRAMES, sets the attribute and then runs the
; movement code that is shared by all of the weapons at #R$8209.
;
; IX The weapon entity
@label=HandlerAxe
c$81DB CALL $9FFB      ; Call #R$9FFB to save the position of the weapon.
 $81DE LD A,($5C78)    ; Fetch FRAMES.
 $81E1 CPL             ; Invert the bits.
 $81E2 RRA             ; Rotate #REGa right (the frame changes on every other
                       ; tick).
 $81E3 AND %00000111   ; Keep only bits 0-2 (there are 8 animation frames).
 $81E5 ADD A,$40       ; Add #N$40 to point to the correct frame/ sprite ID (the axe base
                       ; sprite ID is: #R($A4BC + $40 * $02)(#N$40)).
 $81E7 LD (IX+$00),A   ; Write the new frame/ sprite ID back to the entity.
 $81EA LD (IX+$05),$42 ; Set the attribute of the axe to #COLOUR$42.
 $81EE JR $8209        ; Jump to #R$8209 to move the weapon.

; Handle Fireball
;
; The handler for a fireball, which has the sprite IDs #N$34 to #N$37.
; Advances the animation frame and flickers the colour.
;
; IX The weapon entity
@label=HandlerFireball
c$81F0 CALL $9FFB    ; Call #R$9FFB to save the position of the weapon.
 $81F3 LD A,(IX+$00) ; {Fetch the sprite ID of the fireball and add one, to move on to the
 $81F6 INC A         ; next frame.}
 $81F7 AND %00000011 ; Keep only bits 0-1 (there are 4 animation frames).
 $81F9 ADD A,$34     ; Add #N$34 to point to the correct frame/ sprite ID (the fireball
                     ; base sprite ID is: #R($A4BC + $34 * $02)(#N$34)).
 $81FB LD (IX+$00),A ; Write the new frame/ sprite ID back to the entity.
 $81FE LD A,($5C78)  ; Fetch FRAMES.
 $8201 RLA           ; Rotate #REGa left, which moves bit 0 into bit 1.
 $8202 AND %00000010 ; Keep only bit 1.
 $8204 ADD A,$45     ; Add #N$45 to get an attribute of #COLOUR$45 or
                     ; #COLOUR$47.
 $8206 LD (IX+$05),A ; Set the attribute of the fireball.
; Continue on to #R$8209.

; Handle Weapon
;
; Used by the routines at #R$81DB and #R$82F1.
; .
; The movement code that is shared by the axe, the fireball and the
; sword. The weapon is removed if the player has left the room, if its
; lifetime (held in #N$EAA7) has run out, or if it has hit something (bit 0
; of the flags is set). Otherwise it moves by its velocity, bouncing off the
; walls of the room by reversing the velocity on the axis that was crossed.
;
; IX The weapon entity
;
; Remove the weapon if the player is not in the same room.
@label=HandlerWeapon
c$8209 LD DE,($5E1D)   ; #REGde=*#R$5E1D (#REGe is the width of the room and #REGd is the
                       ; height).
 $820D LD A,($EA91)    ; Fetch the room of the player.
 $8210 CP (IX+$01)     ; {Jump to #R$827E if the weapon is not in the same room
 $8213 JR NZ,$827E     ; as the player.}
; Remove the weapon if it has run out of time, or it has hit something.
 $8215 DEC (IX+$0F)    ; {Decrease the lifetime of the weapon by one and jump to #R$826F if it
 $8218 JR Z,$826F      ; is zero.}
 $821A BIT 0,(IX+$02)  ; {Jump to #R$826F if bit 0 of the flags of the weapon
 $821E JR NZ,$826F     ; is set.}
; Work out the new X position of the weapon and check it is inside the
; room.
 $8220 LD A,(IX+$03)   ; Fetch the X position of the weapon.
 $8223 ADD A,(IX+$06)  ; Add the X velocity of the weapon.
 $8226 LD C,A          ; Keep the new X position in #REGc.
 $8227 SUB $58         ; Subtract #N$58 (the centre of the room).
 $8229 JP P,$822E      ; {Jump to #R$822E if the result is positive, otherwise make it
 $822C NEG             ; positive.}
@label=HandlerWeapon_CheckX
*$822E CP E            ; {Jump to #R$825D if the weapon has crossed the left or right wall of
 $822F JR NC,$825D     ; the room.}
; Work out the new Y position of the weapon and check it is inside the
; room.
@label=HandlerWeapon_CheckY
*$8231 LD A,(IX+$04)   ; Fetch the Y position of the weapon.
 $8234 ADD A,(IX+$07)  ; Add the Y velocity of the weapon.
 $8237 LD B,A          ; Keep the new Y position in #REGb.
 $8238 SUB $68         ; Subtract #N$68 (the centre of the room).
 $823A JP P,$823F      ; {Jump to #R$823F if the result is positive, otherwise make it
 $823D NEG             ; positive.}
@label=HandlerWeapon_CheckYLimit
*$823F CP D            ; {Jump to #R$824B if the weapon has crossed the top or bottom wall of
 $8240 JR NC,$824B     ; the room.}
; Move the weapon to its new position, and display it.
@label=HandlerWeapon_Move
*$8242 LD (IX+$03),C   ; Update the X position of the weapon.
 $8245 LD (IX+$04),B   ; Update the Y position of the weapon.
 $8248 JP $8E8E        ; Jump to #R$8E8E to display the weapon.
; The weapon has hit the top or bottom wall, so bounce it back.
@label=HandlerWeapon_BounceY
*$824B LD B,(IX+$04)   ; Keep the current Y position in #REGb.
 $824E LD A,(IX+$07)   ; Fetch the Y velocity of the weapon.
 $8251 NEG             ; Reverse the direction of the Y velocity.
 $8253 LD (IX+$07),A   ; Update the Y velocity of the weapon.
 $8256 PUSH BC         ; Stash the position on the stack.
 $8257 CALL $A4B0      ; Call #R$A4B0 to make the bounce sound.
 $825A POP BC          ; Restore the position from the stack.
 $825B JR $8242        ; Jump to #R$8242 to move the weapon to its new
                       ; position.
; The weapon has hit the left or right wall, so bounce it back.
@label=HandlerWeapon_BounceX
*$825D LD C,(IX+$03)   ; Keep the current X position in #REGc.
 $8260 LD A,(IX+$06)   ; Fetch the X velocity of the weapon.
 $8263 NEG             ; Reverse the direction of the X velocity.
 $8265 LD (IX+$06),A   ; Update the X velocity of the weapon.
 $8268 PUSH BC         ; Stash the position on the stack.
 $8269 CALL $A4B0      ; Call #R$A4B0 to make the bounce sound.
 $826C POP BC          ; Restore the position from the stack.
 $826D JR $8231        ; Jump to #R$8231 to check the new Y position of the
                       ; weapon.
; This entry point is used by the routine at #R$8787.
; .
; The weapon has finished, so remove it from the screen and restore the
; colour of the room.
@label=HandlerWeapon_Expire
*$826F CALL $9F56      ; Call #R$9F56 to remove the weapon from the screen.
 $8272 CALL $A445      ; Call #R$A445 to make the pop sound.
 $8275 LD A,($5E1A)    ; Fetch the room attribute.
 $8278 LD (IX+$05),A   ; Set the attribute of the weapon to the room attribute.
 $827B CALL $A01A      ; Call #R$A01A to set the attributes of the cells that the weapon
                       ; covered.
; This entry point is used by the routine at #R$85F0.
; .
; The weapon is no longer in use.
@label=HandlerWeapon_Remove
*$827E LD (IX+$00),$00 ; Clear the sprite ID of the weapon, which means it is no longer in
                       ; use.
 $8282 RET             ; Return.

; Throw Sword
;
; Used by the routine at #R$8DC4.
; .
; Launches a sword for the serf, unless a weapon is already in flight or
; the player is in a doorway. The sprite ID of the sword depends on the
; direction that the weapon is travelling in (#N$38 to #N$3F), as worked out
; by the same method that #R$82C3 uses.
;
; IX The player entity
@label=ThrowSword
c$8283 LD A,($EA98)  ; {Return if a weapon is already in flight.
 $8286 AND A         ;
 $8287 RET NZ        ; }
 $8288 LD A,($5E2D)  ; {Return if the player is in a doorway.
 $828B AND A         ;
 $828C RET NZ        ; }
 $828D CALL $A427    ; Call #R$A427 to make the sword sound.
 $8290 CALL $817C    ; Call #R$817C to set the velocity of the weapon.
 $8293 LD C,$00      ; #REGc=#N$00 (the direction number for down).
; #REGhl points at the Y velocity of the weapon.
 $8295 LD A,(HL)     ; Fetch the Y velocity of the weapon.
 $8296 AND A         ; {Jump to #R$82B6 if the weapon is not moving vertically.
 $8297 JR Z,$82B6    ; }
 $8299 JP P,$829E    ; Jump to #R$829E if the weapon is moving down.
 $829C LD C,$04      ; #REGc=#N$04 (the direction number for up).
@label=ThrowSword_CheckX
*$829E DEC HL        ; Point #REGhl at the X velocity of the weapon.
 $829F LD A,(HL)     ; Fetch the X velocity of the weapon.
 $82A0 AND A         ; {Jump to #R$82A7 if the weapon is not moving
 $82A1 JR Z,$82A7    ; horizontally.}
 $82A3 JP P,$82B3    ; Jump to #R$82B3 if the weapon is moving right.
 $82A6 DEC C         ; Decrease the direction number by one, as the weapon is
                     ; moving left.
@label=ThrowSword_SetSprite
*$82A7 LD A,C        ; Fetch the direction number.
 $82A8 AND %00000111 ; Keep only bits 0-2 (there are 8 sword sprites).
 $82AA ADD A,$38     ; Add #N$38 to point to the correct sprite ID (the sword base sprite
                     ; ID is: #R($A4BC + $38 * $02)(#N$38)).
 $82AC LD HL,$EA98   ; Point #REGhl at the player weapon at #R$EA98.
 $82AF LD (HL),A     ; Write the sprite ID to the weapon.
 $82B0 JP $8160      ; Jump to #R$8160 to launch the sword.
@label=ThrowSword_Right
*$82B3 INC C         ; Increase the direction number by one, as the weapon is
                     ; moving right.
 $82B4 JR $82A7      ; Jump to #R$82A7 to set the sprite of the sword.
; The weapon is moving horizontally only.
@label=ThrowSword_Horizontal
*$82B6 DEC HL        ; Point #REGhl at the X velocity of the weapon.
 $82B7 BIT 7,(HL)    ; {Jump to #R$82BF if the weapon is moving right.
 $82B9 JR Z,$82BF    ; }
 $82BB LD C,$06      ; #REGc=#N$06 (the direction number for left).
 $82BD JR $82A7      ; Jump to #R$82A7 to set the sprite of the sword.
@label=ThrowSword_MovingRight
*$82BF LD C,$02      ; #REGc=#N$02 (the direction number for right).
 $82C1 JR $82A7      ; Jump to #R$82A7 to set the sprite of the sword.

; Set Sword Direction
;
; Used by the routine at #R$82F1.
; .
; Chooses the sprite of the sword in flight from its velocity. The sprite
; ID is #N$38 plus a direction number from #N$00 to #N$07, which is worked out
; in #REGc from the signs of the Y and X velocities of the weapon.
;
; HL The address of the Y velocity of the weapon
@label=SwordDirection
c$82C3 LD C,$00      ; #REGc=#N$00 (the direction number for down).
 $82C5 LD A,(HL)     ; {Jump to #R$82E4 if the weapon is not moving vertically.
 $82C6 AND A         ;
 $82C7 JR Z,$82E4    ; }
 $82C9 JP P,$82CE    ; Jump to #R$82CE if the weapon is moving down.
 $82CC LD C,$04      ; #REGc=#N$04 (the direction number for up).
@label=SwordDirection_CheckX
*$82CE DEC HL        ; Point #REGhl at the X velocity of the weapon.
 $82CF LD A,(HL)     ; Fetch the X velocity of the weapon.
 $82D0 AND A         ; {Jump to #R$82D7 if the weapon is not moving
 $82D1 JR Z,$82D7    ; horizontally.}
 $82D3 JP P,$82E1    ; Jump to #R$82E1 if the weapon is moving right.
 $82D6 DEC C         ; Decrease the direction number by one, as the weapon is
                     ; moving left.
@label=SwordDirection_SetSprite
*$82D7 LD A,C        ; Fetch the direction number.
 $82D8 AND %00000111 ; Keep only bits 0-2 (there are 8 animation frames).
 $82DA ADD A,$38     ; Add #N$38 to point to the correct frame/ sprite ID (the sword base
                     ; sprite ID is: #R($A4BC + $38 * $02)(#N$38)).
 $82DC LD HL,$EA98   ; Point #REGhl at the player weapon at #R$EA98.
 $82DF LD (HL),A     ; Write the new frame/ sprite ID to the weapon.
 $82E0 RET           ; Return.
@label=SwordDirection_Right
*$82E1 INC C         ; Increase the direction number by one, as the weapon is
                     ; moving right.
 $82E2 JR $82D7      ; Jump to #R$82D7 to set the sprite of the sword.
; The weapon is moving horizontally only.
@label=SwordDirection_Horizontal
*$82E4 DEC HL        ; Point #REGhl at the X velocity of the weapon.
 $82E5 BIT 7,(HL)    ; {Jump to #R$82ED if the weapon is moving right.
 $82E7 JR Z,$82ED    ; }
 $82E9 LD C,$06      ; #REGc=#N$06 (the direction number for left).
 $82EB JR $82D7      ; Jump to #R$82D7 to set the sprite of the sword.
@label=SwordDirection_MovingRight
*$82ED LD C,$02      ; #REGc=#N$02 (the direction number for right).
 $82EF JR $82D7      ; Jump to #R$82D7 to set the sprite of the sword.

; Handle Sword
;
; The handler for a thrown sword, which has the sprite IDs #N$38 to #N$3F.
; Sets the attribute, points the sprite in the direction of travel and then
; runs the movement code that is shared by all of the weapons.
;
; IX The weapon entity
@label=HandlerSword
c$82F1 CALL $9FFB      ; Call #R$9FFB to save the position of the weapon.
 $82F4 LD (IX+$05),$46 ; Set the attribute of the sword to #COLOUR$46.
 $82F8 LD HL,$EA9F     ; Point #REGhl at the Y velocity of the weapon at
                       ; #R$EA9F.
 $82FB CALL $82C3      ; Call #R$82C3 to choose the sprite of the sword.
 $82FE JP $8209        ; Jump to #R$8209 to move the weapon.

; Handle Bat
;
; The handler for a bat, which has the sprite IDs #N$6A and #N$6B. If the
; player is in another room then #R$85F0 counts the bat down until it is
; removed. Otherwise the bat is counted, tested for touching the player (see
; #R$85B2) and for being hit by a weapon (see #R$8566), and then it flies.
; The step it is on in its flight pattern is held at offset #N$09 of the
; entity, and #R$83CA holds the distance to fly on each axis for each step.
; The low bits of offset #N$08 hold the direction: bit 0 is set when moving
; right, bit 1 is set when moving down and bit 2 swaps which of the two
; distances is used for each axis. The bat turns around at the walls.
;
; IX The bat entity
@label=HandlerBatlet
c$8301 LD A,($EA91)    ; Fetch the room of the player from #R$EA91.
 $8304 CP (IX+$01)     ; {Jump to #R$85F0 if the bat is not in the same room as
 $8307 JP NZ,$85F0     ; the player.}
 $830A CALL $9FFB      ; Call #R$9FFB to save the position of the bat.
 $830D LD HL,$5E25     ; Point #REGhl at the number of creatures at #R$5E25.
 $8310 INC (HL)        ; Increment the number of creatures by one.
; Check whether the bat has touched the player or been hit by a weapon.
 $8311 CALL $85B2      ; Call #R$85B2 to check whether the entity is touching
                       ; the player.
 $8314 DEC E           ; {Jump to #R$85EA if the bat touched the player.
 $8315 JP Z,$85EA      ; }
 $8318 CALL $8566      ; Call #R$8566 to check whether the weapon has hit the
                       ; entity.
 $831B DEC E           ; {Jump to #R$875F if the bat was hit by a weapon.
 $831C JP Z,$875F      ; }
 $831F LD (IX+$0F),$00 ; Write #N$00 to offset #N$0F of the bat, so it is not
                       ; removed.
 $8323 LD DE,($5E1D)   ; Fetch the size of the room from #R$5E1D.
; Move on to the next step of the pattern. A new direction is chosen every
; sixteen steps.
 $8327 LD A,(IX+$09)   ; Fetch the step of the flight pattern.
 $832A INC A           ; Increment #REGa by one.
 $832B AND %00001111   ; Keep only bits 0-3.
 $832D LD (IX+$09),A   ; Write #REGa back to the bat.
 $8330 JP NZ,$833A     ; Jump to #R$833A unless the pattern has restarted.
 $8333 LD A,R          ; Fetch a random number (from the refresh register).
 $8335 AND %00000111   ; Keep only bits 0-2.
 $8337 LD (IX+$08),A   ; Update the direction of the bat.
; Move the bat vertically.
@label=HandlerBatlet_Move
*$833A CALL $83BA      ; Call #R$83BA to get the table entry for this step.
 $833D LD (IX+$05),$43 ; Set the attribute of the entity to #COLOUR$43.
 $8341 JR NZ,$8344     ; Jump to #R$8344 if the axes are not swapped.
 $8343 INC HL          ; Move on to the second distance.
@label=HandlerBatlet_MoveY
*$8344 LD A,(HL)       ; Fetch the distance to fly.
 $8345 BIT 1,(IX+$08)  ; {Jump to #R$834D if the bat is moving down.
 $8349 JR NZ,$834D     ; }
 $834B NEG             ; Reverse the distance, so that the bat flies up.
@label=HandlerBatlet_AddY
*$834D ADD A,(IX+$04)  ; Add the Y position of the bat.
 $8350 LD C,A          ; Keep the new Y position in #REGc.
 $8351 SUB $68         ; Subtract #N$68 (the vertical centre of the room).
 $8353 JR C,$835A      ; Jump to #R$835A if the new position is above the
                       ; centre.
 $8355 CP D            ; {Jump to #R$83A2 if the new position is beyond the
 $8356 JR NC,$83A2     ; bottom wall.}
 $8358 JR $835F        ; Jump to #R$835F to set the Y position of the bat.
@label=HandlerBatlet_CheckTop
*$835A NEG             ; Make the distance from the centre positive.
 $835C CP D            ; {Jump to #R$83A8 if the new position is beyond the top
 $835D JR NC,$83A8     ; wall.}
@label=HandlerBatlet_SetY
*$835F LD (IX+$04),C   ; Update the Y position of the bat.
; Move the bat horizontally.
@label=HandlerBatlet_Horizontal
*$8362 CALL $83BA      ; Call #R$83BA to get the table entry for this step.
 $8365 JR Z,$8368      ; Jump to #R$8368 if the axes are swapped.
 $8367 INC HL          ; Move on to the second distance.
@label=HandlerBatlet_MoveX
*$8368 LD A,(HL)       ; Fetch the distance to fly.
 $8369 BIT 0,(IX+$08)  ; {Jump to #R$8371 if the bat is moving right.
 $836D JR NZ,$8371     ; }
 $836F NEG             ; Reverse the distance, so that the bat flies left.
@label=HandlerBatlet_AddX
*$8371 ADD A,(IX+$03)  ; Add the X position of the bat.
 $8374 LD C,A          ; Keep the new X position in #REGc.
 $8375 SUB $58         ; Subtract #N$58 (the horizontal centre of the room).
 $8377 JR C,$837E      ; Jump to #R$837E if the new position is left of the
                       ; centre.
 $8379 CP E            ; {Jump to #R$83B4 if the new position is beyond the
 $837A JR NC,$83B4     ; right wall.}
 $837C JR $8383        ; Jump to #R$8383 to set the X position of the bat.
@label=HandlerBatlet_CheckLeft
*$837E NEG             ; Make the distance from the centre positive.
 $8380 CP E            ; {Jump to #R$83AE if the new position is beyond the
 $8381 JR NC,$83AE     ; left wall.}
@label=HandlerBatlet_SetX
*$8383 LD (IX+$03),C   ; Update the X position of the bat.
; Flap the wings, by changing the sprite every fourth step.
 $8386 LD A,(IX+$09)   ; Fetch the step of the flight pattern.
 $8389 RRA             ; {Divide the step by four, so that the wings flap every
 $838A RRA             ; fourth step.}
 $838B AND %00000001   ; Keep only bit 0.
 $838D LD C,A          ; Keep the wing frame in #REGc.
 $838E LD A,(IX+$00)   ; Fetch the sprite ID of the bat.
 $8391 AND %11111110   ; Reset bit 0.
 $8393 ADD A,C         ; Add the wing frame to the sprite ID.
 $8394 LD (IX+$00),A   ; Update the sprite ID of the bat.
; Remove the bat if the player is no longer in play, otherwise display it.
 $8397 LD A,($EA90)    ; Fetch the sprite ID of the player from #R$EA90.
 $839A CP $31          ; {Jump to #R$875F if the player is no longer in play (the sprite ID is
 $839C JP NC,$875F     ; #N$31 or more).}
 $839F JP $8E8E        ; Jump to #R$8E8E to display the bat.
; The bat has reached a wall so reverse its direction.
@label=HandlerBatlet_TurnUp
*$83A2 RES 1,(IX+$08)  ; Reset bit 1 of the direction of the bat, so it moves
                       ; up.
 $83A6 JR $8362        ; Jump to #R$8362 to move the bat horizontally.
@label=HandlerBatlet_TurnDown
*$83A8 SET 1,(IX+$08)  ; Set bit 1 of the direction of the bat, so it moves
                       ; down.
 $83AC JR $8362        ; Jump to #R$8362 to move the bat horizontally.
@label=HandlerBatlet_TurnRight
*$83AE SET 0,(IX+$08)  ; Set bit 0 of the direction of the bat, so it moves
                       ; right.
 $83B2 JR $8383        ; Jump to #R$8383 to set the X position of the bat.
@label=HandlerBatlet_TurnLeft
*$83B4 RES 0,(IX+$08)  ; Reset bit 0 of the direction of the bat, so it moves
                       ; left.
 $83B8 JR $8383        ; Jump to #R$8383 to set the X position of the bat.

; Get Bat Step
;
; Used by the routine at #R$8301.
; .
; Looks up the distances for the current step of the flight pattern of a
; bat in #R$83CA. Bit 2 of the direction of the bat is returned in the Z flag
; (which is set when the axes are not swapped).
;
;   IX The bat entity
; O:HL The address of the first of the two distances
@label=GetBatStep
c$83BA LD C,(IX+$09)  ; Fetch the step of the flight pattern.
 $83BD SLA C          ; Double the step number, to get an offset of two bytes
                      ; for each step.
 $83BF LD B,$00       ; Clear the high byte of the offset.
 $83C1 LD HL,$83CA    ; Point #REGhl at the bat flight pattern at #R$83CA.
 $83C4 ADD HL,BC      ; Find the entry for this step in the flight pattern.
 $83C5 BIT 2,(IX+$08) ; {Test bit 2 of the direction of the bat, and return.
 $83C9 RET            ; }

; Bat Flight Pattern
;
; The distance for each axis for each of the sixteen steps of the flight
; pattern of a bat, as pairs of bytes. #R$83BA picks the pair for the step.
@label=BatFlightPattern
b$83CA DEFB $03,$00
 $83CC DEFB $03,$00
 $83CE DEFB $03,$01
 $83D0 DEFB $03,$01
 $83D2 DEFB $03,$01
 $83D4 DEFB $02,$02
 $83D6 DEFB $02,$02
 $83D8 DEFB $02,$02
 $83DA DEFB $02,$02
 $83DC DEFB $02,$02
 $83DE DEFB $02,$02
 $83E0 DEFB $01,$03
 $83E2 DEFB $01,$03
 $83E4 DEFB $01,$03
 $83E6 DEFB $00,$03
 $83E8 DEFB $00,$03

; Spawn Creature
;
; Used by the routine at #R$8E26.
; .
; Called by the handlers of the characters. When the player enters a new
; room a delay of #N$20 is started (see #R$5E27). Once the delay has run
; out, and then at random about one time in sixteen, a creature is created
; in a free one of the first three 16-byte records at #R$EE60. The new
; record is a copy of #R$8B6A, in the current room and with a random
; position. It starts as a sparkle (see #R$85F7) that turns into the
; creature chosen by FRAMES from #R$8B7A.
;
; .
;
; See if the player is in a different room to the last one a creature was
; made in.
@label=SpawnCreature
c$83EA LD A,($5E26)  ; {Fetch the room of the last creature from #R$5E26 and keep it in
 $83ED LD C,A        ; #REGc.}
 $83EE LD A,($EA91)  ; Fetch the room of the player from #R$EA91.
 $83F1 CP C          ; {Jump to #R$844F if the player is in a different room.
 $83F2 JR NZ,$844F   ; }
 $83F4 LD HL,$5E27   ; Point #REGhl at the creature delay at #R$5E27.
 $83F7 LD A,(HL)     ; Fetch the creature delay.
 $83F8 AND A         ; {Jump to #R$8458 if the delay is zero.
 $83F9 JR Z,$8458    ; }
 $83FB DEC (HL)      ; Decrease the delay by one.
 $83FC RET NZ        ; Return if the delay is not zero yet.
; Look for a free record for the creature, in the first three of the
; 16-byte records.
@label=SpawnCreature_Find
*$83FD LD HL,$EE60   ; Point #REGhl at the creatures at #R$EE60.
 $8400 LD DE,$0010   ; #REGde=#N($0010,$04,$04) (the size of a record).
 $8403 LD B,$03      ; #REGb=#N$03 (the number of records to look at).
@label=SpawnCreature_FindLoop
*$8405 LD A,(HL)     ; Fetch the sprite ID of the record.
 $8406 AND A         ; {Jump to #R$840D if the record is free.
 $8407 JR Z,$840D    ; }
 $8409 ADD HL,DE     ; Move #REGhl on to the next record.
 $840A DJNZ $8405    ; Decrease the record counter by one and loop back to #R$8405 until
                     ; all three records have been checked.
 $840C RET           ; Return.
; Copy the default creature into the free record.
@label=SpawnCreature_Copy
*$840D EX DE,HL      ; Swap #REGde and #REGhl, so that #REGde is the free
                     ; record.
 $840E LD HL,$8B6A   ; Point #REGhl at the creature defaults at #R$8B6A.
 $8411 LD BC,$0010   ; #REGbc=#N($0010,$04,$04) (the size of a record).
 $8414 PUSH DE       ; Stash the record on the stack.
 $8415 LDIR          ; Copy the default creature into the record.
 $8417 POP HL        ; Restore the record from the stack.
 $8418 PUSH HL       ; Stash the record on the stack again.
 $8419 INC HL        ; Move #REGhl on to the room of the creature.
 $841A LD A,($EA91)  ; Fetch the room of the player from #R$EA91.
 $841D LD (HL),A     ; Update the room of the creature.
 $841E INC HL        ; Move #REGhl on to offset #N$02 of the creature.
 $841F PUSH HL       ; Stash it on the stack.
; The creature that it turns into is chosen from the table using the
; bottom four bits of FRAMES.
 $8420 LD HL,$8B7A   ; Point #REGhl at the creatures at #R$8B7A.
 $8423 LD A,($5C78)  ; Fetch FRAMES.
 $8426 AND %00001111 ; Keep only bits 0-3.
 $8428 LD E,A        ; Set the offset in #REGe to the bottom four bits of
                     ; FRAMES.
 $8429 LD D,$00      ; Clear the high byte of the offset in #REGd.
 $842B ADD HL,DE     ; Find the entry in the table of creatures.
 $842C LD A,(HL)     ; Fetch the sprite ID of the creature to make.
 $842D POP HL        ; Restore the address of offset #N$02 from the stack.
 $842E LD (HL),A     ; Set the type of the creature at offset #N$02.
; Choose a random X and Y position inside the room.
 $842F LD DE,($5E1D) ; Fetch the size of the room from #R$5E1D.
 $8433 LD B,E        ; Set the limit for the X position in #REGb to the width
                     ; of the room.
 $8434 CALL $8598    ; Call #R$8598 to pick a random coordinate.
 $8437 LD (HL),A     ; Update the X position of the creature.
 $8438 LD B,D        ; Set the limit for the Y position in #REGb to the height
                     ; of the room.
 $8439 CALL $8598    ; Call #R$8598 to pick a random coordinate.
 $843C LD (HL),A     ; Update the Y position of the creature.
; Give the creature a random velocity and draw it.
 $843D POP DE        ; Restore the address of the record from the stack.
 $843E PUSH IX       ; Stash the current entity on the stack.
 $8440 LD IX,$0000   ; {Make #REGix point at the new creature (copy #REGde to
 $8444 ADD IX,DE     ; #REGix).}
 $8446 CALL $86F2    ; Call #R$86F2 to give the creature a new random velocity.
 $8449 CALL $9F4A    ; Call #R$9F4A to draw the sparkle.
 $844C POP IX        ; Restore the current entity from the stack.
 $844E RET           ; Return.
; The player is in a new room, so remember the room and start the delay.
@label=SpawnCreature_NewRoom
*$844F LD ($5E26),A  ; Update the room of the last creature in #R$5E26.
 $8452 LD A,$20      ; {Write #N$20 to #R$5E27.
 $8454 LD ($5E27),A  ; }
 $8457 RET           ; Return.
; There is no delay, so only make a creature one time in sixteen.
@label=SpawnCreature_Random
*$8458 LD A,R        ; Fetch a random number (from the refresh register).
 $845A AND %00001111 ; Keep only bits 0-3.
 $845C RET NZ        ; Return if the result is not zero.
 $845D JR $83FD      ; Jump back to #R$83FD to look at the next record.

; Handle Pumpkin And Spider
;
; The handler for the pumpkin (sprite IDs #N$4C and #N$4D) and the spider
; (#N$5C and #N$5D). If the player is in another room then #R$85F0 counts the
; creature down until it is removed. Otherwise the creature is counted and
; checked for being hit by a weapon (#R$8566) or touching the player
; (#R$85B2). Offset #N$06 of the creature holds the direction it is heading
; in (bit 0 is set for right and bit 1 is set for down). A new direction is
; chosen at random every sixteen steps, and the velocities at offsets #N$08
; and #N$09 build up by one every other step towards #N$02 or -#N$02.
; The movement itself is done by #R$84CD.
;
; IX The creature entity
@label=HandlerPumpkin
c$845F CALL $9FFB      ; Call #R$9FFB to save the position of the creature.
 $8462 LD A,($EA91)    ; Fetch the room of the player from #R$EA91.
 $8465 CP (IX+$01)     ; {Jump to #R$85F0 if the creature is not in the same room as the
 $8468 JP NZ,$85F0     ; player.}
 $846B LD HL,$5E25     ; Point #REGhl at the number of creatures at #R$5E25.
 $846E INC (HL)        ; Increment the number of creatures by one.
; Check whether the creature has been hit by a weapon or touched the
; player.
 $846F CALL $8566      ; Call #R$8566 to check whether the weapon has hit the
                       ; entity.
 $8472 DEC E           ; {Jump to #R$875F if the creature was hit by a weapon.
 $8473 JP Z,$875F      ; }
 $8476 CALL $85B2      ; Call #R$85B2 to check whether the entity is touching
                       ; the player.
 $8479 DEC E           ; {Jump to #R$85EA if the creature touched the player.
 $847A JP Z,$85EA      ; }
 $847D LD DE,($5E1D)   ; Fetch the size of the room from #R$5E1D.
 $8481 LD (IX+$0F),$00 ; Write #N$00 to offset #N$0F of the creature, so it is
                       ; not removed.
 $8485 LD (IX+$05),$46 ; Set the attribute of the entity to #COLOUR$46.
; Choose a new direction every sixteen steps.
 $8489 LD A,(IX+$07)   ; Fetch the step counter of the creature.
 $848C AND %00001111   ; Keep only bits 0-3.
 $848E JR NZ,$8497     ; Jump to #R$8497 if the result is not zero.
 $8490 LD A,R          ; Fetch a random number (from the refresh register).
 $8492 AND %00000011   ; Keep only bits 0-1.
 $8494 LD (IX+$06),A   ; Update the direction of the creature.
; Only change the velocities on every other step.
@label=HandlerPumpkin_Velocity
*$8497 BIT 0,(IX+$07)  ; {Jump to #R$84BF if bit 0 of the step counter is set.
 $849B JR NZ,$84BF     ; }
 $849D BIT 0,(IX+$06)  ; {Jump to #R$854A if the creature is not heading right.
 $84A1 JP Z,$854A      ; }
 $84A4 LD A,(IX+$08)   ; Fetch the X velocity of the creature.
 $84A7 CP $02          ; {Jump to #R$84AE if it is already #N$02.
 $84A9 JR Z,$84AE      ; }
 $84AB INC (IX+$08)    ; Increment the X velocity by one.
; This entry point is used by the routine at #R$84CD.
@label=HandlerPumpkin_VelocityY
*$84AE BIT 1,(IX+$06)  ; {Jump to #R$8558 if the creature is not heading down.
 $84B2 JP Z,$8558      ; }
 $84B5 LD A,(IX+$09)   ; Fetch the Y velocity of the creature.
 $84B8 CP $02          ; {Jump to #R$84BF if it is already #N$02.
 $84BA JR Z,$84BF      ; }
 $84BC INC (IX+$09)    ; Increment the Y velocity by one.
; This entry point is used by the routine at #R$84CD.
; .
; Move on to the next step, and animate the creature by changing its
; sprite.
@label=HandlerPumpkin_Animate
*$84BF INC (IX+$07)    ; Increment the step counter of the creature.
 $84C2 LD A,(IX+$07)   ; Fetch the step counter of the creature.
 $84C5 AND %00000001   ; Keep only bit 0.
 $84C7 XOR (IX+$00)    ; Exclusive-or the sprite ID with #REGa, which flips bit 0 of it on
                       ; every other step.
 $84CA LD (IX+$00),A   ; Write the new sprite ID back to the creature.

; Move Creature
;
; Used by the routines at #R$862E, #R$8672, #R$871A, #R$87A6, #R$8988, #R$8A2F,
; #R$8A80 and #R$8AFF.
; .
; Moves a creature by its velocities, and turns it around if it would
; leave the room. Then, if the player is in the room, the creature is displayed
; by #R$8E8E. The creatures that are not bosses are removed instead if the
; player is not a character sprite any more (the sprite ID is #N$31 or more).
; The creature is kept within the room by comparing its distance from the
; centre of the room (#N$58 across and #N$68 down) to the size of the room.
;
; IX The creature entity
; DE The size of the room (width in #REGe and height in #REGd)
;
; Move the creature horizontally. The X velocity is at offset #N$08.
@label=MoveCreature
c$84CD LD A,(IX+$03)   ; Fetch the X position of the creature.
 $84D0 ADD A,(IX+$08)  ; Add the X velocity of the creature.
 $84D3 LD C,A          ; Keep the new X position in #REGc.
 $84D4 SUB $58         ; Subtract #N$58 (the horizontal centre of the room).
 $84D6 JR C,$84E8      ; Jump to #R$84E8 if the creature is left of the centre.
 $84D8 CP E            ; {Jump to #R$84F8 if the new position is still inside
 $84D9 JR C,$84F8      ; the room.}
 $84DB RES 0,(IX+$06)  ; Reset bit 0 of the direction of the creature, so it is
                       ; heading left.
 $84DF LD (IX+$08),$FE ; Set the X velocity of the creature to -#N$02.
 $84E3 LD C,(IX+$03)   ; Keep the old X position in #REGc.
 $84E6 JR $84F8        ; Jump to #R$84F8 to move the creature vertically.
@label=MoveCreature_CheckLeft
*$84E8 NEG             ; Negate #REGa.
 $84EA CP E            ; {Jump to #R$84F8 if the new position is still inside
 $84EB JR C,$84F8      ; the room.}
 $84ED SET 0,(IX+$06)  ; Set bit 0 of the direction of the creature, so it is
                       ; heading right.
 $84F1 LD C,(IX+$03)   ; Keep the old X position in #REGc.
 $84F4 LD (IX+$08),$02 ; Set the X velocity of the creature to #N$02.
; Move the creature vertically. The Y velocity is at offset #N$09.
@label=MoveCreature_Vertical
*$84F8 LD A,(IX+$04)   ; Fetch the Y position of the creature.
 $84FB ADD A,(IX+$09)  ; Add the Y velocity of the creature.
 $84FE LD B,A          ; Keep the new Y position in #REGb.
 $84FF SUB $68         ; Subtract #N$68 (the vertical centre of the room).
 $8501 JR C,$8513      ; Jump to #R$8513 if the creature is above the centre.
 $8503 CP D            ; {Jump to #R$8523 if the new position is still inside
 $8504 JR C,$8523      ; the room.}
 $8506 RES 1,(IX+$06)  ; Reset bit 1 of the direction of the creature, so it is
                       ; heading up.
 $850A LD (IX+$09),$FE ; Set the Y velocity of the creature to -#N$02.
 $850E LD B,(IX+$04)   ; Keep the old Y position in #REGb.
 $8511 JR $8523        ; Jump to #R$8523 to save the new position of the
                       ; creature.
@label=MoveCreature_CheckTop
*$8513 NEG             ; Negate #REGa.
 $8515 CP D            ; {Jump to #R$8523 if the new position is still inside
 $8516 JR C,$8523      ; the room.}
 $8518 SET 1,(IX+$06)  ; Set bit 1 of the direction of the creature, so it is
                       ; heading down.
 $851C LD B,(IX+$04)   ; Keep the old Y position in #REGb.
 $851F LD (IX+$09),$02 ; Set the Y velocity of the creature to #N$02.
; Save the new position, and then display the creature if the player is in
; the same room.
@label=MoveCreature_Store
*$8523 LD (IX+$03),C   ; Update the X position of the creature.
 $8526 LD (IX+$04),B   ; Update the Y position of the creature.
 $8529 LD A,($EA91)    ; Fetch the room of the player from #R$EA91.
 $852C CP (IX+$01)     ; {Return if the creature is not in the same room as the
 $852F RET NZ          ; player.}
 $8530 LD A,(IX+$00)   ; Fetch the sprite ID of the creature.
 $8533 AND %11111100   ; Keep only bits 2-7.
 $8535 CP $9C          ; {Jump to #R$8547 if the creature is a hunchback (#N$9C
 $8537 JR Z,$8547      ; to #N$9F).}
 $8539 AND %11110000   ; Keep only bits 4-7.
 $853B CP $70          ; {Jump to #R$8547 if the creature is a boss (#N$70 to
 $853D JR Z,$8547      ; #N$7F).}
 $853F LD A,($EA90)    ; Fetch the sprite ID of the player from #R$EA90.
 $8542 CP $31          ; {Jump to #R$875F if the player sprite ID is #N$31 or
 $8544 JP NC,$875F     ; more.}
@label=MoveCreature_Display
*$8547 JP $8E8E        ; Jump to #R$8E8E to display the creature.
; This entry point is used by the routine at #R$845F.
; .
; Speed up the X velocity towards -#N$02, which is used when the creature
; is heading left.
@label=MoveCreature_SlowLeft
*$854A LD A,(IX+$08)   ; Fetch the X velocity of the creature.
 $854D CP $FE          ; {Jump to #R$84AE if it is already -#N$02.
 $854F JP Z,$84AE      ; }
 $8552 DEC (IX+$08)    ; Decrease the X velocity by one.
 $8555 JP $84AE        ; Jump to #R$84AE to work out the vertical velocity of
                       ; the pumpkin.
; This entry point is used by the routine at #R$845F.
; .
; Speed up the Y velocity towards -#N$02, which is used when the creature
; is heading up.
@label=MoveCreature_SlowUp
*$8558 LD A,(IX+$09)   ; Fetch the Y velocity of the creature.
 $855B CP $FE          ; {Jump to #R$84BF if it is already -#N$02.
 $855D JP Z,$84BF      ; }
 $8560 DEC (IX+$09)    ; Decrease the Y velocity by one.
 $8563 JP $84BF        ; Jump to #R$84BF to animate the pumpkin.

; Check Weapon Hit
;
; Used by the routines at #R$8301, #R$845F, #R$862E, #R$8672, #R$871A, #R$87A6,
; #R$8A2F and #R$8A80.
; .
; Checks whether the weapon of the player is touching an entity. The
; weapon touches an entity if it is in the same room and within #N$0B pixels of
; it on both axes. When it touches, the weapon is flagged by setting its
; byte at offset #N$02 to #N$01.
;
;   IX The entity to check
; O:E #N$01 if the weapon touches the entity, otherwise #N$00
@label=CheckWeaponHit
c$8566 LD A,($EA99)  ; Fetch the room of the weapon from #N$EA99.
 $8569 LD E,$00      ; Set the result in #REGe to #N$00 (not touching).
 $856B CP (IX+$01)   ; Compare the room of the weapon with the room of the
                     ; entity.
 $856E RET NZ        ; Return if they are in different rooms.
 $856F LD A,($EA98)  ; Fetch the sprite ID of the weapon from #R$EA98.
 $8572 AND A         ; {Return if there is no weapon.
 $8573 RET Z         ; }
 $8574 LD A,($EA9B)  ; Fetch the X position of the weapon from #N$EA9B.
 $8577 SUB (IX+$03)  ; Subtract the X position of the entity.
 $857A JP P,$857F    ; Jump to #R$857F if the difference is positive.
 $857D NEG           ; Make the difference positive.
@label=CheckWeaponHit_Test_X
*$857F CP $0C        ; {Return if the weapon is too far away on the X axis.
 $8581 RET NC        ; }
 $8582 LD A,($EA9C)  ; Fetch the Y position of the weapon from #N$EA9C.
 $8585 SUB (IX+$04)  ; Subtract the Y position of the entity.
 $8588 JP P,$858D    ; Jump to #R$858D if the difference is positive.
 $858B NEG           ; Make the difference positive.
@label=CheckWeaponHit_Test_Y
*$858D CP $0C        ; {Return if the weapon is too far away on the Y axis.
 $858F RET NC        ; }
 $8590 LD A,$01      ; {Flag that the weapon has hit an entity.
 $8592 LD ($EA9A),A  ; }
 $8595 LD E,$01      ; Set the result in #REGe to #N$01 (touching).
 $8597 RET           ; Return.

; Get Random Coordinate
;
; Used by the routine at #R$83EA.
; .
; Chooses a random position along one axis of the room. A random number
; is reduced to less than the size of the room less #N$08, and then it is
; either added to or taken away from #N$60. This is used by #R$83EA to
; place a new creature.
;
;   B The size of the room along the axis
;   HL The address of the previous byte of the position in the entity
; O:A The coordinate
; O:HL The address of the next byte of the entity
@label=GetRandomCoordinate
c$8598 LD A,B        ; Fetch the size of the room along the axis.
 $8599 SUB $08       ; Take #N$08 off the size of the room.
 $859B LD B,A        ; Keep the result in #REGb as the limit for the random
                     ; number.
 $859C LD A,R        ; Fetch a random number (from the refresh register).
 $859E INC HL        ; Move #REGhl on to the next byte.
@label=GetRandomCoordinate_Reduce
*$859F CP B          ; {Jump to #R$85A5 if the random number is less than the
 $85A0 JR C,$85A5    ; limit.}
 $85A2 SUB B         ; Subtract the limit from the random number.
 $85A3 JR $859F      ; Jump back to #R$859F to keep reducing the number.
@label=GetRandomCoordinate_Offset
*$85A5 LD C,A        ; Keep the random offset in #REGc.
 $85A6 LD A,R        ; Fetch a random number (from the refresh register).
 $85A8 BIT 1,A       ; Test bit 1 of the random number, to choose which side of #N$60 to
                     ; use.
 $85AA LD A,$60      ; #REGa=#N$60.
 $85AC JR Z,$85B0    ; Jump to #R$85B0 if bit 1 was not set.
 $85AE ADD A,C       ; Add the offset to #N$60.
 $85AF RET           ; Return.
@label=GetRandomCoordinate_Negative
*$85B0 SUB C         ; Take the offset away from #N$60.
 $85B1 RET           ; Return.

; Check Player Touch
;
; Used by the routines at #R$8301, #R$845F, #R$862E, #R$8672, #R$871A, #R$87A6,
; #R$8862, #R$8906, #R$8988, #R$89ED, #R$8A2F, #R$8A80 and #R$8AFF.
; .
; Checks whether an entity is touching the player. The player is touching
; an entity if the player is a character sprite (a sprite ID of #N$01 to #N$30),
; is in the same room and is within #N$0B pixels of it on both axes. When
; it touches, the byte at offset #N$02 of the player is set to #N$01 and the
; sound of touching is made.
;
;   IX The entity to check
; O:E #N$01 if the player touches the entity, otherwise #N$00
@label=CheckPlayerTouch
c$85B2 LD A,($EA91)  ; Fetch the room of the player from #R$EA91.
 $85B5 LD E,$00      ; Set the result in #REGe to #N$00 (not touching).
 $85B7 CP (IX+$01)   ; Compare the room of the player with the room of the
                     ; entity.
 $85BA RET NZ        ; Return if they are in different rooms.
 $85BB LD A,($EA90)  ; Fetch the sprite ID of the player from #R$EA90.
 $85BE AND A         ; Test whether the player is in play.
 $85BF RET Z         ; Return if not.
 $85C0 CP $31        ; {Return if the player is not a character sprite.
 $85C2 RET NC        ; }
 $85C3 LD A,($EA93)  ; Fetch the X position of the player from #N$EA93.
 $85C6 SUB (IX+$03)  ; Subtract the X position of the entity.
 $85C9 JP P,$85CE    ; Jump to #R$85CE if the difference is positive.
 $85CC NEG           ; Make the difference positive.
@label=CheckPlayerTouch_Test_X
*$85CE CP $0C        ; {Return if the player is too far away on the X axis.
 $85D0 RET NC        ; }
 $85D1 LD A,($EA94)  ; Fetch the Y position of the player from #N$EA94.
 $85D4 SUB (IX+$04)  ; Subtract the Y position of the entity.
 $85D7 JP P,$85DC    ; Jump to #R$85DC if the difference is positive.
 $85DA NEG           ; Make the difference positive.
@label=CheckPlayerTouch_Test_Y
*$85DC CP $0C        ; {Return if the player is too far away on the Y axis.
 $85DE RET NC        ; }
 $85DF LD A,$01      ; {Flag that the player has been touched.
 $85E1 LD ($EA92),A  ; }
 $85E4 CALL $A3E5    ; Call #R$A3E5 to make the sound of touching.
 $85E7 LD E,$01      ; Set the result in #REGe to #N$01 (touching).
 $85E9 RET           ; Return.

; Handle Touching Creature
;
; Used by the routines at #R$8301, #R$845F, #R$862E, #R$8672, #R$871A, #R$87A6,
; #R$8A2F and #R$8A80.
; .
; Called when a creature has touched the player. The player loses
; energy (see #R$8ED7) and the creature turns into a pop (see #R$875F).
;
; IX The creature entity
@label=HandleTouchingCreature
c$85EA CALL $8ED7    ; Call #R$8ED7 to take energy from the player.
 $85ED JP $875F      ; Jump to #R$875F to turn the creature into a pop.

; Count Down Creature
;
; Used by the routines at #R$8301, #R$845F, #R$85F7, #R$862E, #R$8672, #R$871A,
; #R$8787, #R$87A6, #R$8A2F and #R$8A80.
; .
; Used by the handlers of the creatures when the player is not in the room
; of the creature. The counter at offset #N$0F of the entity is counted down
; and when it reaches zero the creature is removed (see #R$827E).
;
; IX The creature entity
@label=CountDownCreature
c$85F0 DEC (IX+$0F)  ; Decrease the counter at offset #N$0F by one.
 $85F3 RET NZ        ; Return if it is not zero.
 $85F4 JP $827E      ; Jump to #R$827E to remove the creature.

; Handle Sparkle
;
; The handler for the sparkle (sprite IDs #N$58 to #N$5B) that appears
; when a creature is created by #R$83EA. The counter at offset #N$0E of the
; entity starts at #N$20 and the sprite is chosen from its bottom two bits to
; animate the sparkle. When the counter reaches zero the sparkle turns into the
; creature that is held at offset #N$02.
;
; IX The sparkle entity
@label=HandlerSparkle
c$85F7 CALL $9FFB      ; Call #R$9FFB to save the position of the sparkle.
 $85FA LD A,($EA91)    ; Fetch the room of the player from #R$EA91.
 $85FD CP (IX+$01)     ; {Jump to #R$85F0 if the sparkle is not in the same room as the
 $8600 JP NZ,$85F0     ; player.}
 $8603 LD HL,$5E25     ; Point #REGhl at the number of creatures at #R$5E25.
 $8606 INC (HL)        ; Increment the number of creatures by one.
 $8607 DEC (IX+$0E)    ; Decrease the counter at offset #N$0E by one.
 $860A JR Z,$8625      ; Jump to #R$8625 if it has reached zero.
 $860C LD A,(IX+$0E)   ; Fetch the counter.
 $860F AND %00000011   ; Keep only bits 0-1.
 $8611 ADD A,$58       ; Add #N$58 to get the sprite ID of the sparkle.
 $8613 LD (IX+$00),A   ; Update the sprite ID of the sparkle.
 $8616 LD (IX+$0F),$80 ; Write #N$80 to the counter at offset #N$0F.
 $861A LD A,($EA90)    ; Fetch the sprite ID of the player from #R$EA90.
 $861D CP $31          ; {Jump to #R$875F if the player sprite ID is #N$31 or
 $861F JP NC,$875F     ; more.}
 $8622 JP $8E8E        ; Jump to #R$8E8E to display the sparkle.
; The sparkle is finished, so it turns into the creature.
@label=HandlerSparkle_Finish
*$8625 LD A,(IX+$02)   ; Fetch the type of the creature from offset #N$02.
 $8628 LD (IX+$00),A   ; Update the sprite ID of the entity.
 $862B JP $8E8E        ; Jump to #R$8E8E to display the sparkle.

; Handle Ghostlet
;
; The handler for the ghostlet (sprite IDs #N$4E and #N$4F). It is the
; same
; as #R$845F at the start, but the player is checked for touching before the
; weapon. The ghostlet changes to a new random velocity every time the counter
; at offset #N$07 wraps round to zero (every #N$100 steps) and then moves by
; #R$84CD.
;
; IX The ghostlet entity
@label=HandlerGhostlet
c$862E CALL $9FFB      ; Call #R$9FFB to save the position of the ghostlet.
 $8631 LD A,($EA91)    ; Fetch the room of the player from #R$EA91.
 $8634 CP (IX+$01)     ; {Jump to #R$85F0 if the ghostlet is not in the same room as the
 $8637 JP NZ,$85F0     ; player.}
 $863A LD HL,$5E25     ; Point #REGhl at the number of creatures at #R$5E25.
 $863D INC (HL)        ; Increment the number of creatures by one.
 $863E CALL $85B2      ; Call #R$85B2 to check whether the entity is touching
                       ; the player.
 $8641 DEC E           ; {Jump to #R$85EA if the ghostlet touched the player.
 $8642 JP Z,$85EA      ; }
 $8645 CALL $8566      ; Call #R$8566 to check whether the weapon has hit the
                       ; entity.
 $8648 DEC E           ; {Jump to #R$875F if the ghostlet was hit by a weapon.
 $8649 JP Z,$875F      ; }
 $864C LD (IX+$05),$45 ; Set the attribute of the entity to #COLOUR$45.
 $8650 INC (IX+$07)    ; Increment the step counter at offset #N$07.
 $8653 CALL Z,$86F2    ; Call #R$86F2 if it has wrapped round to zero.
; Animate the ghostlet by changing the sprite every fourth step.
 $8656 LD A,(IX+$07)   ; Fetch the step counter.
 $8659 RRA             ; {Divide the step counter by four, so that the sprite changes every
 $865A RRA             ; fourth step.}
 $865B AND %00000001   ; Keep only bit 0.
 $865D LD C,A          ; Keep the animation frame in #REGc.
 $865E LD A,(IX+$00)   ; Fetch the sprite ID of the ghostlet.
 $8661 AND %11111110   ; Reset bit 0.
 $8663 ADD A,C         ; Add the animation frame to the sprite ID.
 $8664 LD (IX+$00),A   ; Update the sprite ID of the ghostlet.
 $8667 LD DE,($5E1D)   ; Fetch the size of the room from #R$5E1D.
 $866B LD (IX+$0F),$00 ; Write #N$00 to offset #N$0F of the ghostlet, so it is
                       ; not removed.
 $866F JP $84CD        ; Jump to #R$84CD to move the creature.

; Handle Spikey And Ghost
;
; The handler for the spikey (sprite IDs #N$5E and #N$5F) and the ghost
; (#N$68 and #N$69). The counter at offset #N$0A runs from -#N$07 up to #N$06
; and half of it is added to the Y position, which makes the creature bob up
; and down as it moves. A new random velocity is chosen every time that
; the counter wraps round. The movement itself is done by #R$84CD.
;
; IX The creature entity
@label=HandlerSpikey
c$8672 CALL $9FFB      ; Call #R$9FFB to save the position of the creature.
 $8675 LD A,($EA91)    ; Fetch the room of the player from #R$EA91.
 $8678 CP (IX+$01)     ; {Jump to #R$85F0 if the creature is not in the same room as the
 $867B JP NZ,$85F0     ; player.}
 $867E LD HL,$5E25     ; Point #REGhl at the number of creatures at #R$5E25.
 $8681 INC (HL)        ; Increment the number of creatures by one.
 $8682 LD (IX+$0F),$00 ; Write #N$00 to offset #N$0F of the creature, so it is
                       ; not removed.
 $8686 CALL $85B2      ; Call #R$85B2 to check whether the entity is touching
                       ; the player.
 $8689 DEC E           ; {Jump to #R$85EA if the creature touched the player.
 $868A JP Z,$85EA      ; }
 $868D CALL $8566      ; Call #R$8566 to check whether the weapon has hit the
                       ; entity.
 $8690 DEC E           ; {Jump to #R$875F if the creature was hit by a weapon.
 $8691 JP Z,$875F      ; }
; Animate the creature by changing the sprite every other step.
 $8694 LD A,(IX+$0A)   ; Fetch the bobbing counter from offset #N$0A.
 $8697 RRA             ; Halve the bobbing counter.
 $8698 AND %00000001   ; Keep only bit 0.
 $869A LD C,A          ; Keep the animation frame in #REGc.
 $869B LD A,(IX+$00)   ; Fetch the sprite ID of the creature.
 $869E AND %11111110   ; Reset bit 0.
 $86A0 ADD A,C         ; Add the animation frame to the sprite ID.
 $86A1 LD (IX+$00),A   ; Update the sprite ID of the creature.
 $86A4 LD DE,($5E1D)   ; Fetch the size of the room from #R$5E1D.
; Move on to the next step of the bobbing. A new velocity is chosen when
; the counter reaches #N$07.
 $86A8 INC (IX+$0A)    ; Increment the bobbing counter.
 $86AB LD A,(IX+$0A)   ; Fetch the bobbing counter.
 $86AE CP $07          ; {Jump to #R$86B9 unless it has reached #N$07.
 $86B0 JR NZ,$86B9     ; }
 $86B2 CALL $86F2      ; Call #R$86F2 to give the creature a new random
                       ; velocity.
 $86B5 LD (IX+$0A),$F9 ; Set the bobbing counter to -#N$07.
; Add half of the counter to the Y position of the creature and keep it
; inside the room.
@label=HandlerSpikey_Bob
*$86B9 SRA A           ; Halve the counter, keeping its sign.
 $86BB ADD A,(IX+$04)  ; Add the Y position of the creature.
 $86BE LD C,A          ; Keep the new Y position in #REGc.
 $86BF SUB $68         ; Subtract #N$68 (the vertical centre of the room).
 $86C1 JP P,$86E1      ; Jump to #R$86E1 if the new position is below the
                       ; centre.
 $86C4 NEG             ; Make the distance from the centre positive.
 $86C6 CP D            ; {Jump to #R$86DB if the new position is still inside
 $86C7 JR C,$86DB      ; the room.}
 $86C9 LD (IX+$09),$02 ; Set the Y velocity of the creature to #N$02.
 $86CD SET 1,(IX+$06)  ; Set bit 1 of the direction of the creature, so it is
                       ; heading down.
 $86D1 BIT 7,(IX+$0A)  ; {Jump to #R$86DB if the bobbing counter is positive.
 $86D5 JR Z,$86DB      ; }
 $86D7 LD (IX+$0A),$00 ; Reset the bobbing counter to #N$00.
@label=HandlerSpikey_Store
*$86DB LD (IX+$04),C   ; Update the Y position of the creature.
 $86DE JP $84CD        ; Jump to #R$84CD to move the creature.
@label=HandlerSpikey_CheckBottom
*$86E1 CP D            ; {Jump to #R$86DB if the new position is still inside
 $86E2 JR C,$86DB      ; the room.}
 $86E4 RES 1,(IX+$06)  ; Reset bit 1 of the direction of the creature, so it is
                       ; heading up.
 $86E8 LD (IX+$09),$FE ; Set the Y velocity of the creature to -#N$02.
 $86EC LD (IX+$0A),$F9 ; Set the bobbing counter to -#N$07.
 $86F0 JR $86DB        ; Jump to #R$86DB to store the Y position of the
                       ; creature.

; Randomise Velocity
;
; Used by the routines at #R$83EA, #R$862E, #R$8672, #R$871A, #R$8A2F and
; #R$8A80.
; .
; Gives a creature a new random velocity on each axis. The Y velocity is
; chosen first. Each velocity is either -#N$02 or #N$02, or else -#N$01 or
; #N$01. The random number comes from the refresh register.
;
; IX The creature entity
@label=RandomiseVelocity
c$86F2 LD A,R        ; Fetch a random number (from the refresh register).
 $86F4 BIT 0,A       ; {Jump to #R$870E if bit 0 was not set.
 $86F6 JR Z,$870E    ; }
 $86F8 AND %00000100 ; Keep only bit 2.
 $86FA SUB $02       ; Subtract #N$02, giving -#N$02 or #N$02.
@label=RandomiseVelocity_SetY
*$86FC LD (IX+$09),A ; Update the Y velocity of the creature.
 $86FF LD A,R        ; Fetch a random number (from the refresh register).
 $8701 RRA           ; Rotate the random number right, so that bit 1 becomes
                     ; bit 0.
 $8702 BIT 0,A       ; {Jump to #R$8714 if bit 0 was not set.
 $8704 JR Z,$8714    ; }
 $8706 AND %00000100 ; Keep only bit 2.
 $8708 SUB $02       ; Subtract #N$02, giving -#N$02 or #N$02.
@label=RandomiseVelocity_SetX
*$870A LD (IX+$08),A ; Update the X velocity of the creature.
 $870D RET           ; Return.
@label=RandomiseVelocity_SlowY
*$870E AND %00000010 ; Keep only bit 1.
 $8710 SUB $01       ; Subtract #N$01, giving -#N$01 or #N$01.
 $8712 JR $86FC      ; Jump to #R$86FC to set the Y velocity of the creature.
@label=RandomiseVelocity_SlowX
*$8714 AND %00000010 ; Keep only bit 1.
 $8716 SUB $01       ; Subtract #N$01, giving -#N$01 or #N$01.
 $8718 JR $870A      ; Jump to #R$870A to set the X velocity of the creature.

; Handle Blob
;
; The handler for the blob (sprite IDs #N$60 and #N$61). A new random
; velocity is chosen every #N$11 steps, by counting down the counter at offset
; #N$0D. The movement itself is done by #R$84CD.
;
; IX The blob entity
@label=HandlerBlob
c$871A CALL $9FFB      ; Call #R$9FFB to save the position of the blob.
 $871D LD A,($EA91)    ; Fetch the room of the player from #R$EA91.
 $8720 CP (IX+$01)     ; {Jump to #R$85F0 if the blob is not in the same room
 $8723 JP NZ,$85F0     ; as the player.}
 $8726 LD HL,$5E25     ; Point #REGhl at the number of creatures at #R$5E25.
 $8729 INC (HL)        ; Increment the number of creatures by one.
 $872A LD (IX+$0F),$00 ; Write #N$00 to offset #N$0F of the blob, so it is not
                       ; removed.
 $872E CALL $85B2      ; Call #R$85B2 to check whether the entity is touching
                       ; the player.
 $8731 DEC E           ; {Jump to #R$85EA if the blob touched the player.
 $8732 JP Z,$85EA      ; }
 $8735 CALL $8566      ; Call #R$8566 to check whether the weapon has hit the
                       ; entity.
 $8738 DEC E           ; {Jump to #R$875F if the blob was hit by a weapon.
 $8739 JP Z,$875F      ; }
 $873C LD DE,($5E1D)   ; Fetch the size of the room from #R$5E1D.
 $8740 DEC (IX+$0D)    ; Decrease the counter at offset #N$0D by one.
 $8743 JR NZ,$874C     ; Jump to #R$874C if it is not zero.
 $8745 LD (IX+$0D),$11 ; Set the counter to #N$11.
 $8749 CALL $86F2      ; Call #R$86F2 to give the creature a new random
                       ; velocity.
; Animate the blob by changing the sprite every other step.
@label=HandlerBlob_Animate
*$874C LD A,(IX+$0D)   ; Fetch the counter.
 $874F RRA             ; Halve the counter.
 $8750 AND %00000001   ; Keep only bit 0.
 $8752 LD C,A          ; Keep the animation frame in #REGc.
 $8753 LD A,(IX+$00)   ; Fetch the sprite ID of the blob.
 $8756 AND %11111110   ; Reset bit 0.
 $8758 ADD A,C         ; Add the animation frame to the sprite ID.
 $8759 LD (IX+$00),A   ; Update the sprite ID of the blob.
 $875C JP $84CD        ; Jump to #R$84CD to move the creature.

; Pop Creature
;
; Used by the routines at #R$8301, #R$845F, #R$84CD, #R$85EA, #R$85F7, #R$862E,
; #R$8672, #R$871A, #R$87A6, #R$8988, #R$8A2F and #R$8A80.
; .
; Turns a creature into a pop, which is what happens when it is hit by a
; weapon or when it touches the player. The creature is removed from the
; screen and redrawn as the first frame of the pop with the room attribute
; under it (see #R$8787), and the player is given #N($0155,$04,$04) points.
;
; IX The creature entity
@label=PopCreature
c$875F LD A,(IX+$05)   ; Fetch the attribute of the creature.
 $8762 PUSH AF         ; Stash it on the stack.
 $8763 LD A,($5E1A)    ; Fetch the room attribute from #R$5E1A.
 $8766 LD (IX+$05),A   ; Update the attribute of the creature.
 $8769 CALL $9F56      ; Call #R$9F56 to remove the creature from the screen.
 $876C CALL $A01A      ; Call #R$A01A to set the attributes of the cells that the creature
                       ; covered.
 $876F POP AF          ; Restore the attribute of the creature from the stack.
 $8770 LD (IX+$05),A   ; Write it to the attribute of the creature.
 $8773 LD (IX+$00),$6C ; Write #N$6C to the sprite ID of the creature (the first frame of the
                       ; pop).
 $8777 LD (IX+$0E),$10 ; Set the counter at offset #N$0E to #N$10.
 $877B LD BC,$0155     ; #REGbc=#N($0155,$04,$04) (the points to add to the
                       ; score).
 $877E CALL $A19C      ; Call #R$A19C to add the points to the score.
 $8781 CALL $9F4A      ; Call #R$9F4A to draw the pop.
 $8784 JP $A01A        ; Jump to #R$A01A to set the attributes.

; Handle Pop
;
; The handler for the pop (sprite IDs #N$6C to #N$6F) that is left when
; a creature is hit. The counter at offset #N$0E, which was started at #N$10
; by #R$875F, is counted down and the bottom two bits choose the frame of the
; animation. The pop is removed when the counter reaches zero.
;
; IX The pop entity
@label=HandlerPop
c$8787 CALL $9FFB    ; Call #R$9FFB to save the position of the pop.
 $878A LD A,($EA91)  ; Fetch the room of the player from #R$EA91.
 $878D CP (IX+$01)   ; {Jump to #R$85F0 if the pop is not in the same room as
 $8790 JP NZ,$85F0   ; the player.}
 $8793 DEC (IX+$0E)  ; Decrease the counter at offset #N$0E by one.
 $8796 JP Z,$826F    ; Jump to #R$826F if it has reached zero, to remove the
                     ; pop.
 $8799 LD A,(IX+$0E) ; Fetch the counter.
 $879C AND %00000011 ; Keep only bits 0-1.
 $879E ADD A,$6C     ; Add #N$6C to get the sprite ID of the pop.
 $87A0 LD (IX+$00),A ; Update the sprite ID of the pop.
 $87A3 JP $8E8E      ; Jump to #R$8E8E to display the pop.

; Handle Ghoul
;
; The handler for the ghoul (sprite IDs #N$62 and #N$63). It is like
; #R$845F, but the weapon is checked before the player, and the direction
; at offset #N$06 is changed every eight steps. The velocities build up by
; one every other step towards #N$02 or -#N$02. The movement itself is
; done by #R$84CD.
;
; IX The ghoul entity
@label=HandlerGhoul
c$87A6 CALL $9FFB      ; Call #R$9FFB to save the position of the ghoul.
 $87A9 LD A,($EA91)    ; Fetch the room of the player from #R$EA91.
 $87AC CP (IX+$01)     ; {Jump to #R$85F0 if the ghoul is not in the same room
 $87AF JP NZ,$85F0     ; as the player.}
 $87B2 LD HL,$5E25     ; Point #REGhl at the number of creatures at #R$5E25.
 $87B5 INC (HL)        ; Increment the number of creatures by one.
 $87B6 CALL $8566      ; Call #R$8566 to check whether the weapon has hit the
                       ; entity.
 $87B9 DEC E           ; {Jump to #R$875F if the ghoul was hit by a weapon.
 $87BA JP Z,$875F      ; }
 $87BD CALL $85B2      ; Call #R$85B2 to check whether the entity is touching
                       ; the player.
 $87C0 DEC E           ; {Jump to #R$85EA if the ghoul touched the player.
 $87C1 JP Z,$85EA      ; }
 $87C4 LD DE,($5E1D)   ; Fetch the size of the room from #R$5E1D.
 $87C8 LD (IX+$0F),$00 ; Write #N$00 to offset #N$0F of the ghoul, so it is not
                       ; removed.
 $87CC LD (IX+$05),$46 ; Set the attribute of the entity to #COLOUR$46.
 $87D0 LD A,(IX+$07)   ; Fetch the step counter from offset #N$07.
 $87D3 AND %00000111   ; Keep only bits 0-2.
 $87D5 JR NZ,$87DE     ; Jump to #R$87DE if the result is not zero.
 $87D7 LD A,R          ; Fetch a random number (from the refresh register).
 $87D9 AND %00000011   ; Keep only bits 0-1.
 $87DB LD (IX+$06),A   ; Update the direction of the ghoul.
@label=HandlerGhoul_Velocity
*$87DE BIT 0,(IX+$07)  ; {Jump to #R$8804 if bit 0 of the step counter is set.
 $87E2 JR NZ,$8804     ; }
 $87E4 BIT 0,(IX+$06)  ; {Jump to #R$8815 if the ghoul is not heading right.
 $87E8 JR Z,$8815      ; }
 $87EA LD A,(IX+$08)   ; Fetch the X velocity of the ghoul.
 $87ED CP $02          ; {Jump to #R$87F4 if it is already #N$02.
 $87EF JR Z,$87F4      ; }
 $87F1 INC (IX+$08)    ; Increment the X velocity by one.
@label=HandlerGhoul_VelocityY
*$87F4 BIT 1,(IX+$06)  ; {Jump to #R$8821 if the ghoul is not heading down.
 $87F8 JR Z,$8821      ; }
 $87FA LD A,(IX+$09)   ; Fetch the Y velocity of the ghoul.
 $87FD CP $02          ; {Jump to #R$8804 if it is already #N$02.
 $87FF JR Z,$8804      ; }
 $8801 INC (IX+$09)    ; Increment the Y velocity by one.
; Move on to the next step, and animate the ghoul by changing its sprite.
@label=HandlerGhoul_Animate
*$8804 INC (IX+$07)    ; Increment the step counter.
 $8807 LD A,(IX+$07)   ; Fetch the step counter.
 $880A AND %00000001   ; Keep only bit 0.
 $880C XOR (IX+$00)    ; Exclusive-or the sprite ID with #REGa, which flips bit 0 of it on
                       ; every other step.
 $880F LD (IX+$00),A   ; Write the new sprite ID back to the ghoul.
 $8812 JP $84CD        ; Jump to #R$84CD to move the creature.
; Speed up the X velocity towards -#N$02, which is used when the ghoul is
; heading left.
@label=HandlerGhoul_SlowLeft
*$8815 LD A,(IX+$08)   ; Fetch the X velocity of the ghoul.
 $8818 CP $FE          ; {Jump to #R$87F4 if it is already -#N$02.
 $881A JR Z,$87F4      ; }
 $881C DEC (IX+$08)    ; Decrease the X velocity by one.
 $881F JR $87F4        ; Jump to #R$87F4 to work out the vertical velocity of
                       ; the ghoul.
; Speed up the Y velocity towards -#N$02, which is used when the ghoul is
; heading up.
@label=HandlerGhoul_SlowUp
*$8821 LD A,(IX+$09)   ; Fetch the Y velocity of the ghoul.
 $8824 CP $FE          ; {Jump to #R$8804 if it is already -#N$02.
 $8826 JR Z,$8804      ; }
 $8828 DEC (IX+$09)    ; Decrease the Y velocity by one.
 $882B JR $8804        ; Jump to #R$8804 to animate the ghoul.

; Steer Creature
;
; Used by the routines at #R$8862, #R$8906, #R$8988, #R$89ED and #R$8AFF.
; .
; Sets the velocities of a creature so that it heads towards a target
; position, which is one pixel per step on each axis (or nothing on an axis
; where it has already arrived). Bit 0 of #REGc is set if the creature is at the
; Y position of the target and bit 1 is set if it is at the X position, so
; #REGc is #N$03 when it has arrived.
;
;   IX The creature entity
;   DE The target position (X in #REGe and Y in #REGd)
; O:C Bit 0 set if the Y positions match, bit 1 set if the X ones do
@label=SteerCreature
c$882D LD C,$00        ; Clear the result in #REGc, which flags which axes have
                       ; been reached.
 $882F LD A,D          ; Fetch the target Y position.
 $8830 CP (IX+$04)     ; Compare the target Y position with the Y position of
                       ; the creature.
 $8833 JR Z,$8848      ; {Jump to #R$8848 if they are the same.
 $8835 JR NC,$8850     ; }
 $8837 LD (IX+$09),$FF ; Set the Y velocity of the creature to -#N$01 (the
                       ; target is above).
@label=SteerCreature_X
*$883B LD A,E          ; Fetch the target X position.
 $883C CP (IX+$03)     ; Compare the target X position with the X position of
                       ; the creature.
 $883F JR Z,$8856      ; {Jump to #R$8856 if they are the same.
 $8841 JR NC,$885D     ; }
 $8843 LD (IX+$08),$FF ; Set the X velocity of the creature to -#N$01 (the target is to the
                       ; left).
 $8847 RET             ; Return.
@label=SteerCreature_SameY
*$8848 LD (IX+$09),$00 ; Set the Y velocity of the creature to #N$00.
 $884C SET 0,C         ; Flag that the creature is at the target Y position.
 $884E JR $883B        ; Jump to #R$883B to work out the X velocity.
@label=SteerCreature_Below
*$8850 LD (IX+$09),$01 ; Set the Y velocity of the creature to #N$01.
 $8854 JR $883B        ; Jump to #R$883B to work out the X velocity.
@label=SteerCreature_SameX
*$8856 LD (IX+$08),$00 ; Set the X velocity of the creature to #N$00.
 $885A SET 1,C         ; Flag that the creature is at the target X position.
 $885C RET             ; Return.
@label=SteerCreature_Right
*$885D LD (IX+$08),$01 ; Set the X velocity of the creature to #N$01.
 $8861 RET             ; Return.

; Handle Mummy
;
; The handler for the mummy (sprite IDs #N$70 to #N$73). If the mummy
; touches the player then #R$8A1E takes some energy. Then the mummy picks a
; target to steer towards with #R$882D. If the leaf (#R$EAE0, the copy of
; #R$605D) is in the room then it is the target, and when the mummy reaches it
; the leaf is moved to room #N$6B. Otherwise, when bit 7 of offset #N$06 is
; reset and the red key (#R$EAC8, the copy of #R$6045) is in the room, the
; mummy goes backwards and forwards between two waypoints that are kept at
; offsets #N$0B and #N$0C, and when bit 7 is set (or the red key is not in the
; room) the target is the player.
; The sprite comes from the bottom two bits of the counter at #R$5E12, and then
; #R$89BB does the rest.
;
; IX The mummy entity
@label=HandlerMummy
c$8862 CALL $9FFB      ; Call #R$9FFB to save the position of the mummy.
 $8865 CALL $85B2      ; Call #R$85B2 to check whether the entity is touching
                       ; the player.
 $8868 DEC E           ; {Call #R$8A1E if the mummy touched the player.
 $8869 CALL Z,$8A1E    ; }
; See if the leaf (#R$EAE0) is in the room, and if so make it the target.
 $886C LD HL,$EAE0     ; Point #REGhl at the leaf at #R$EAE0.
 $886F LD A,(HL)       ; Fetch the sprite ID of the entity.
 $8870 AND A           ; {Jump to #R$8881 if the leaf is not in use.
 $8871 JR Z,$8881      ; }
 $8873 INC HL          ; Move #REGhl on to the room of the entity.
 $8874 LD A,(HL)       ; Fetch the room of the entity.
 $8875 CP (IX+$01)     ; {Jump to #R$8881 if the leaf is in a different room to
 $8878 JR NZ,$8881     ; the mummy.}
 $887A INC HL          ; {Move #REGhl on to the X position of the entity.
 $887B INC HL          ; }
 $887C LD E,(HL)       ; Fetch the X position of the entity.
 $887D INC HL          ; Move #REGhl on to the Y position of the entity.
 $887E LD D,(HL)       ; Fetch the Y position of the entity.
 $887F JR $88D7        ; Jump to #R$88D7 to steer the mummy towards its target.
; If bit 7 of the flags is set then the target is the player.
@label=HandlerMummy_CheckFlags
*$8881 BIT 7,(IX+$06)  ; {Jump to #R$88FD if bit 7 of offset #N$06 is set.
 $8885 JR NZ,$88FD     ; }
; See if the red key (#R$EAC8) is in the room.
 $8887 LD HL,$EAC8     ; Point #REGhl at the red key at #R$EAC8.
 $888A LD A,(HL)       ; Fetch the sprite ID of the entity.
 $888B AND A           ; {Jump to #R$88F9 if the red key is not in use.
 $888C JR Z,$88F9      ; }
 $888E INC HL          ; Move #REGhl on to the room of the entity.
 $888F LD A,(HL)       ; Fetch the room of the entity.
 $8890 CP (IX+$01)     ; {Jump to #R$88F9 if the red key is in a different room
 $8893 JR NZ,$88F9     ; to the mummy.}
; Steer towards the current waypoint.
 $8895 LD D,(IX+$0C)   ; Fetch the Y position of the waypoint.
 $8898 LD E,(IX+$0B)   ; Fetch the X position of the waypoint.
 $889B CALL $882D      ; Call #R$882D to steer the creature towards its target.
 $889E LD A,C          ; Fetch which of the axes have been reached.
 $889F CP $03          ; {Jump to #R$88B5 if the mummy is at the waypoint.
 $88A1 JR Z,$88B5      ; }
; Choose the sprite and the area that the mummy can move in.
@label=HandlerMummy_SetSprite
*$88A3 LD A,($5E12)    ; Fetch the counter from #R$5E12.
 $88A6 RRA             ; {Divide the counter by four.
 $88A7 RRA             ; }
 $88A8 AND %00000011   ; Keep only bits 0-1.
 $88AA ADD A,$70       ; Add #N$70 to get the sprite ID of the mummy.
 $88AC LD (IX+$00),A   ; Update the sprite ID of the mummy.
 $88AF LD DE,$3838     ; #REGde=#N($3838,$04,$04) (the area).
 $88B2 JP $89BB        ; Jump to #R$89BB to move the boss.
; The mummy is at a waypoint, so change to the other one.
@label=HandlerMummy_NextWaypoint
*$88B5 BIT 6,(IX+$06)  ; {Jump to #R$88C9 if bit 6 of offset #N$06 is reset.
 $88B9 JR Z,$88C9      ; }
 $88BB LD (IX+$0B),$8C ; Set the X position of the waypoint to #N$8C.
 $88BF LD (IX+$0C),$68 ; Set the Y position of the waypoint to #N$68.
 $88C3 RES 6,(IX+$06)  ; Reset bit 6 of offset #N$06.
 $88C7 JR $88A3        ; Jump to #R$88A3 to choose the sprite of the mummy.
@label=HandlerMummy_FirstWaypoint
*$88C9 LD (IX+$0B),$68 ; Set the X position of the waypoint to #N$68.
 $88CD LD (IX+$0C),$38 ; Set the Y position of the waypoint to #N$38.
 $88D1 SET 6,(IX+$06)  ; Set bit 6 of offset #N$06.
 $88D5 JR $88A3        ; Jump to #R$88A3 to choose the sprite of the mummy.
; Steer towards the leaf, and when the mummy gets there move it out of the
; way.
@label=HandlerMummy_Target
*$88D7 CALL $882D      ; Call #R$882D to steer the creature towards its target.
 $88DA LD A,C          ; Fetch which of the axes have been reached.
 $88DB CP $03          ; {Jump to #R$88A3 if the mummy has not arrived.
 $88DD JR NZ,$88A3     ; }
 $88DF PUSH IX         ; Stash the mummy on the stack.
 $88E1 LD IX,$EAE0     ; Point #REGix at the leaf at #R$EAE0.
 $88E5 LD A,($EA91)    ; Fetch the room of the player from #R$EA91.
 $88E8 CP (IX+$01)     ; {Jump to #R$88F0 if the leaf is in a different room to
 $88EB JR NZ,$88F0     ; the player.}
 $88ED CALL $9F4A      ; Call #R$9F4A to draw the entity.
@label=HandlerMummy_Moved
*$88F0 POP IX          ; Restore the mummy from the stack.
 $88F2 LD A,$6B        ; {Write #N$6B to the room of the leaf, to move it out
 $88F4 LD ($EAE1),A    ; of the way.}
 $88F7 JR $88B5        ; Jump to #R$88B5 to change the mummy to its other
                       ; waypoint.
; There is nothing else to go for, so the target is the player.
@label=HandlerMummy_SeekPlayer
*$88F9 SET 7,(IX+$06)  ; Set bit 7 of offset #N$06.
@label=HandlerMummy_Player
*$88FD LD DE,($EA93)   ; Fetch the position of the player from #N$EA93.
 $8901 CALL $882D      ; Call #R$882D to steer the creature towards its target.
 $8904 JR $88A3        ; Jump to #R$88A3 to choose the sprite of the mummy.

; Handle Dracula
;
; The handler for Dracula (sprite IDs #N$7C to #N$7F). If Dracula
; touches the player then #R$8A1E takes some energy. When the player is
; holding the crucifix (sprite ID #N$8A with attribute #N$46) Dracula heads
; away from the player, otherwise he heads towards the player when they are
; in the same room. If they are not, then about once every #N$100 frames he
; goes to a random room, if the shape of that room (see #R$897D) is less than
; #N$03.
;
; IX The Dracula entity
@label=HandlerDracula
c$8906 CALL $9FFB      ; Call #R$9FFB to save the position of Dracula.
 $8909 CALL $85B2      ; Call #R$85B2 to check whether the entity is touching
                       ; the player.
 $890C DEC E           ; {Call #R$8A1E if Dracula touched the player.
 $890D CALL Z,$8A1E    ; }
; See if the player is holding the crucifix.
 $8910 LD DE,$468A     ; #REGde=#N($468A,$04,$04) (the attribute and the sprite ID of the
                       ; crucifix).
 $8913 CALL $9273      ; Call #R$9273 to look for the crucifix in the
                       ; inventory.
 $8916 JR NZ,$8931     ; Jump to #R$8931 if the player is not holding it.
; The player has the crucifix, so steer towards the player and then
; reverse the velocities to run away.
 $8918 LD DE,($EA93)   ; Fetch the position of the player from #N$EA93.
 $891C CALL $882D      ; Call #R$882D to steer the creature towards its target.
 $891F LD A,(IX+$08)   ; Fetch the X velocity.
 $8922 NEG             ; Reverse the direction of the X velocity.
 $8924 LD (IX+$08),A   ; Update the X velocity.
 $8927 LD A,(IX+$09)   ; Fetch the Y velocity.
 $892A NEG             ; Reverse the direction of the Y velocity.
 $892C LD (IX+$09),A   ; Update the Y velocity.
 $892F JR $8940        ; Jump to #R$8940 to choose the sprite of Dracula.
; Check whether Dracula is in the same room as the player.
@label=HandlerDracula_CheckRoom
*$8931 LD A,($EA91)    ; Fetch the room of the player from #R$EA91.
 $8934 CP (IX+$01)     ; {Jump to #R$8952 if Dracula is in a different room.
 $8937 JR NZ,$8952     ; }
 $8939 LD DE,($EA93)   ; Fetch the position of the player from #N$EA93.
 $893D CALL $882D      ; Call #R$882D to steer the creature towards its target.
; Choose the sprite and the area that Dracula can move in.
@label=HandlerDracula_SetSprite
*$8940 LD A,($5E12)    ; Fetch the counter from #R$5E12.
 $8943 RRA             ; {Divide the counter by four.
 $8944 RRA             ; }
 $8945 AND %00000011   ; Keep only bits 0-1.
 $8947 ADD A,$7C       ; Add #N$7C to get the sprite ID of Dracula.
 $8949 LD (IX+$00),A   ; Update the sprite ID of Dracula.
 $894C LD DE,$3434     ; #REGde=#N($3434,$04,$04) (the area).
 $894F JP $89BB        ; Jump to #R$89BB to move the boss.
; Dracula is in a different room, so every so often send him to a random
; one.
@label=HandlerDracula_OtherRoom
*$8952 LD (IX+$0B),$68 ; Set the X position of the waypoint to #N$68.
 $8956 LD (IX+$0C),$68 ; Set the Y position of the waypoint to #N$68.
 $895A CALL $882D      ; Call #R$882D to steer the creature towards its target.
 $895D LD A,($5C78)    ; Fetch the low byte of FRAMES.
 $8960 AND A           ; {Jump to #R$8940 unless the low byte of FRAMES is zero, which happens
 $8961 JP NZ,$8940     ; once in every #N$100 frames.}
 $8964 LD A,R          ; Fetch a random number (from the refresh register).
 $8966 AND %01111111   ; Keep only bits 0-6.
 $8968 LD C,A          ; Keep the random room in #REGc.
 $8969 CALL $897D      ; Call #R$897D to look up the value for the room.
 $896C CP $03          ; {Jump to #R$8940 if the value for the room is #N$03 or
 $896E JP NC,$8940     ; more.}
 $8971 LD A,($EA91)    ; Fetch the room of the player from #R$EA91.
 $8974 CP C            ; {Jump to #R$8940 if the random room is the room of the
 $8975 JP Z,$8940      ; player.}
 $8978 LD (IX+$01),C   ; Update the room of Dracula.
 $897B JR $8940        ; Jump to #R$8940 to choose the sprite of Dracula.

; Get Room Value
;
; Used by the routine at #R$8906.
; .
; Reads the second byte of the entry for a room in #R$A854, which is the
; shape of the frame of the room (see #R$A982).
;
;   A The room
; O:A The shape of the room
@label=GetRoomValue
c$897D LD L,A        ; Set #REGl to the room.
 $897E LD H,$00      ; Clear the high byte of the room in #REGh.
 $8980 LD DE,$A854   ; Point #REGde at the room attribute table at #R$A854.
 $8983 ADD HL,HL     ; Double #REGhl, as the entries are two bytes long.
 $8984 ADD HL,DE     ; Find the entry for the room.
 $8985 INC HL        ; Move #REGhl on to the second byte of the entry.
 $8986 LD A,(HL)     ; Fetch the second byte of the entry.
 $8987 RET           ; Return.

; Handle Frankenstein
;
; The handler for Frankenstein (sprite IDs #N$74 to #N$77). He steers
; towards the player. If he touches the player while the player is holding
; the spanner (sprite ID #N$8B with attribute #N$45) then he is hit instead
; and the player is given #N($1000,$04,$04) points, otherwise #R$8A1E takes some
; energy. The sprite comes from the bottom two bits of the counter at
; #R$5E12. The tail at #R$89BB is also used by the other bosses.
;
; IX The Frankenstein entity
@label=HandlerFrankenstein
c$8988 CALL $9FFB      ; Call #R$9FFB to save the position of Frankenstein.
 $898B CALL $85B2      ; Call #R$85B2 to check whether the entity is touching
                       ; the player.
 $898E DEC E           ; {Jump to #R$89A5 if Frankenstein did not touch the
 $898F JR NZ,$89A5     ; player.}
 $8991 LD DE,$458B     ; #REGde=#N($458B,$04,$04) (the attribute and the sprite ID of the
                       ; spanner).
 $8994 CALL $9273      ; Call #R$9273 to look for the spanner in the inventory.
 $8997 JR NZ,$89A2     ; Jump to #R$89A2 if the player is not holding it.
 $8999 LD BC,$1000     ; #REGbc=#N($1000,$04,$04) (the points to add to the
                       ; score).
 $899C CALL $A19C      ; Call #R$A19C to add the points to the score.
 $899F JP $875F        ; Jump to #R$875F to turn the creature into a pop.
@label=HandlerFrankenstein_Hurt
*$89A2 CALL $8A1E      ; Call #R$8A1E to take energy from the player.
@label=HandlerFrankenstein_Steer
*$89A5 LD DE,($EA93)   ; Fetch the position of the player from #N$EA93.
 $89A9 CALL $882D      ; Call #R$882D to steer the creature towards its target.
 $89AC LD A,($5E12)    ; Fetch the counter from #R$5E12.
 $89AF RRA             ; {Divide the counter by four.
 $89B0 RRA             ; }
 $89B1 AND %00000011   ; Keep only bits 0-1.
 $89B3 ADD A,$74       ; Add #N$74 to get the sprite ID of Frankenstein.
 $89B5 LD (IX+$00),A   ; Update the sprite ID of Frankenstein.
 $89B8 LD DE,$3434     ; #REGde=#N($3434,$04,$04) (the area).
; This entry point is used by the routines at #R$8862, #R$8906 and #R$89ED.
; .
; The shared end of the handlers of the bosses. If the player is a
; character then the boss moves. If not, the boss moves away from the player.
@label=HandlerBoss_Move
*$89BB LD A,($EA90)    ; Fetch the sprite ID of the player from #R$EA90.
 $89BE CP $31          ; {Jump to #R$84CD if the player is a character.
 $89C0 JP C,$84CD      ; }
 $89C3 LD DE,($EA93)   ; Fetch the position of the player from #N$EA93.
 $89C7 CALL $882D      ; Call #R$882D to steer the creature towards its target.
 $89CA LD A,(IX+$08)   ; Fetch the X velocity.
 $89CD NEG             ; Reverse the direction of the X velocity.
 $89CF LD (IX+$08),A   ; Update the X velocity.
 $89D2 LD C,A          ; Keep the reversed X velocity in #REGc.
 $89D3 LD A,(IX+$09)   ; Fetch the Y velocity.
 $89D6 NEG             ; Reverse the direction of the Y velocity.
 $89D8 LD (IX+$09),A   ; Update the Y velocity.
 $89DB LD DE,$3434     ; #REGde=#N($3434,$04,$04) (the area).
 $89DE AND C           ; {Jump to #R$84CD if the AND of the two velocities is
 $89DF JP NZ,$84CD     ; not zero.}
 $89E2 LD (IX+$08),$01 ; Set the X velocity to #N$01.
 $89E6 LD (IX+$09),$01 ; Set the Y velocity to #N$01.
 $89EA JP $84CD        ; Jump to #R$84CD to move the creature.

; Handle Devil
;
; The handler for the devil (sprite IDs #N$78 to #N$7B). If the devil
; touches the player then #R$8A1E takes some energy. The devil always steers
; towards the player. The sprite comes from the bottom two bits of the
; counter at #R$5E12, and then #R$89BB does the rest.
;
; IX The devil entity
@label=HandlerDevil
c$89ED CALL $9FFB    ; Call #R$9FFB to save the position of the devil.
 $89F0 CALL $85B2    ; Call #R$85B2 to check whether the entity is touching the
                     ; player.
 $89F3 DEC E         ; {Call #R$8A1E if the devil touched the player.
 $89F4 CALL Z,$8A1E  ; }
 $89F7 LD DE,($EA93) ; Fetch the position of the player from #N$EA93.
 $89FB CALL $882D    ; Call #R$882D to steer the creature towards its target.
 $89FE LD A,(IX+$00) ; Fetch the sprite ID of the devil.
 $8A01 AND %11111100 ; Keep only bits 2-7.
 $8A03 LD C,A        ; Keep the base sprite ID in #REGc.
 $8A04 LD A,($5E12)  ; Fetch the counter from #R$5E12.
 $8A07 RRA           ; {Divide the counter by four.
 $8A08 RRA           ; }
 $8A09 AND %00000011 ; Keep only bits 0-1.
 $8A0B ADD A,C       ; Add the animation frame to the base sprite ID.
 $8A0C LD (IX+$00),A ; Update the sprite ID of the devil.
 $8A0F LD DE,$3434   ; #REGde=#N($3434,$04,$04) (the area).
 $8A12 JP $89BB      ; Jump to #R$89BB to move the boss.

; Take Energy From Player
;
; Used by the routine at #R$8AFF.
; .
; Called when a boss has touched the player. It takes #N$10 (at #R$8A15)
; or #N$08 (at #R$8A1E) from #R$5E28. The chicken is then redrawn by #R$8B8A,
; which returns to the caller. If the player did not have enough energy then
; the return address is discarded and #R$8EA0 is used to take a life.
;
; IX The boss entity
@label=TakeEnergyFromPlayer
c$8A15 LD A,($5E28)  ; Fetch the energy of the player from #R$5E28.
 $8A18 SUB $10       ; Take #N$10 off the energy of the player.
 $8A1A JR C,$8A2B    ; Jump to #R$8A2B if the player has run out of energy.
 $8A1C JR $8A25      ; Jump to #R$8A25 to update the energy of the player.
; This entry point is used by the routines at #R$8862, #R$8906, #R$8988 and
; #R$89ED.
@label=TakeEnergyFromPlayer_Small
*$8A1E LD A,($5E28)  ; Fetch the energy of the player from #R$5E28.
 $8A21 SUB $08       ; Take #N$08 off the energy of the player.
 $8A23 JR C,$8A2B    ; Jump to #R$8A2B if the player has run out of energy.
@label=TakeEnergyFromPlayer_Update
*$8A25 LD ($5E28),A  ; Update the energy of the player in #R$5E28.
 $8A28 JP $8B8A      ; Jump to #R$8B8A to update the roast chicken.
@label=TakeEnergyFromPlayer_Dead
*$8A2B POP HL        ; Discard the return address.
 $8A2C JP $8EA0      ; Jump to #R$8EA0 to take a life from the player.

; Handle Witch
;
; The handler for the witch (sprite IDs #N$90 to #N$93). The counter at
; offset #N$0D is counted down from #N$10 and when it reaches zero the witch
; gets a new random velocity (see #R$86F2) with the Y velocity halved. The
; sprite faces right when the X velocity is not negative, and the bottom bit of
; the counter animates it. The movement itself is done by #R$84CD.
;
; IX The witch entity
@label=HandlerWitch
c$8A2F CALL $9FFB      ; Call #R$9FFB to save the position of the witch.
 $8A32 LD A,($EA91)    ; Fetch the room of the player from #R$EA91.
 $8A35 CP (IX+$01)     ; {Jump to #R$85F0 if the witch is not in the same room
 $8A38 JP NZ,$85F0     ; as the player.}
 $8A3B LD HL,$5E25     ; Point #REGhl at the number of creatures at #R$5E25.
 $8A3E INC (HL)        ; Increment the number of creatures by one.
 $8A3F CALL $85B2      ; Call #R$85B2 to check whether the entity is touching
                       ; the player.
 $8A42 DEC E           ; {Jump to #R$85EA if the witch touched the player.
 $8A43 JP Z,$85EA      ; }
 $8A46 CALL $8566      ; Call #R$8566 to check whether the weapon has hit the
                       ; entity.
 $8A49 DEC E           ; {Jump to #R$875F if the witch was hit by a weapon.
 $8A4A JP Z,$875F      ; }
 $8A4D DEC (IX+$0D)    ; Decrease the counter at offset #N$0D by one.
 $8A50 JR NZ,$8A5D     ; Jump to #R$8A5D if it is not zero.
 $8A52 CALL $86F2      ; Call #R$86F2 to give the creature a new random
                       ; velocity.
 $8A55 SRA (IX+$09)    ; Halve the Y velocity, keeping its sign.
 $8A59 LD (IX+$0D),$10 ; Set the counter to #N$10.
; Choose the sprite, which depends on the direction of travel and the
; counter.
@label=HandlerWitch_SetSprite
*$8A5D LD A,(IX+$00)   ; Fetch the sprite ID of the witch.
 $8A60 AND %11111100   ; Keep only bits 2-7.
 $8A62 BIT 7,(IX+$08)  ; {Jump to #R$8A6A if the X velocity is negative.
 $8A66 JR NZ,$8A6A     ; }
 $8A68 ADD A,$02       ; Add #N$02 to use the sprites facing right.
@label=HandlerWitch_Animate
*$8A6A LD C,A          ; Keep the base sprite ID in #REGc.
 $8A6B LD A,(IX+$0D)   ; Fetch the counter.
 $8A6E RRA             ; Halve the counter.
 $8A6F AND %00000001   ; Keep only bit 0.
 $8A71 ADD A,C         ; Add the animation frame to the base sprite ID.
 $8A72 LD (IX+$00),A   ; Update the sprite ID of the witch.
 $8A75 LD DE,($5E1D)   ; Fetch the size of the room from #R$5E1D.
 $8A79 LD (IX+$05),$43 ; Set the attribute of the entity to #COLOUR$43.
 $8A7D JP $84CD        ; Jump to #R$84CD to move the creature.

; Handle Monk And Bat
;
; The handler for the monk (sprite IDs #N$94 to #N$97) and the second kind
; of bat (#N$98 to #N$9B). It is the same as #R$8A2F, but the counter is
; restarted at #N$20 and when it runs out the X velocity is also set to
; -#N$02 or #N$02, depending on the bottom bit of FRAMES. The attribute is
; #COLOUR$42.
;
; IX The monk or bat entity
@label=HandlerMonk
c$8A80 CALL $9FFB      ; Call #R$9FFB to save the position of the creature.
 $8A83 LD A,($EA91)    ; Fetch the room of the player from #R$EA91.
 $8A86 CP (IX+$01)     ; {Jump to #R$85F0 if the creature is not in the same room as the
 $8A89 JP NZ,$85F0     ; player.}
 $8A8C LD HL,$5E25     ; Point #REGhl at the number of creatures at #R$5E25.
 $8A8F INC (HL)        ; Increment the number of creatures by one.
 $8A90 CALL $85B2      ; Call #R$85B2 to check whether the entity is touching
                       ; the player.
 $8A93 DEC E           ; {Jump to #R$85EA if the creature touched the player.
 $8A94 JP Z,$85EA      ; }
 $8A97 CALL $8566      ; Call #R$8566 to check whether the weapon has hit the
                       ; entity.
 $8A9A DEC E           ; {Jump to #R$875F if the creature was hit by a weapon.
 $8A9B JP Z,$875F      ; }
 $8A9E DEC (IX+$0D)    ; Decrease the counter at offset #N$0D by one.
 $8AA1 JR NZ,$8AB8     ; Jump to #R$8AB8 if it is not zero.
 $8AA3 CALL $86F2      ; Call #R$86F2 to give the creature a new random
                       ; velocity.
 $8AA6 LD A,($5C78)    ; Fetch the low byte of FRAMES.
 $8AA9 AND %00000100   ; Keep only bit 2.
 $8AAB SUB $02         ; Subtract #N$02, giving -#N$02 or #N$02.
 $8AAD LD (IX+$08),A   ; Update the X velocity of the creature.
 $8AB0 SRA (IX+$09)    ; Halve the Y velocity, keeping its sign.
 $8AB4 LD (IX+$0D),$20 ; Set the counter to #N$20.
@label=HandlerMonk_SetSprite
*$8AB8 LD A,(IX+$00)   ; Fetch the sprite ID of the creature.
 $8ABB AND %11111100   ; Keep only bits 2-7.
 $8ABD BIT 7,(IX+$08)  ; {Jump to #R$8AC5 if the X velocity is negative.
 $8AC1 JR NZ,$8AC5     ; }
 $8AC3 ADD A,$02       ; Add #N$02 to use the sprites facing right.
@label=HandlerMonk_Animate
*$8AC5 LD C,A          ; Keep the base sprite ID in #REGc.
 $8AC6 LD A,(IX+$0D)   ; Fetch the counter.
 $8AC9 RRA             ; Halve the counter.
 $8ACA AND %00000001   ; Keep only bit 0.
 $8ACC ADD A,C         ; Add the animation frame to the base sprite ID.
 $8ACD LD (IX+$00),A   ; Update the sprite ID of the creature.
 $8AD0 LD DE,($5E1D)   ; Fetch the size of the room from #R$5E1D.
 $8AD4 LD (IX+$05),$42 ; Set the attribute of the entity to #COLOUR$42.
 $8AD8 JP $84CD        ; Jump to #R$84CD to move the creature.

; Find Item In Room
;
; Used by the routine at #R$8AFF.
; .
; Searches the eight records that start at #R$EB18 for one that is in
; use and is in the same room as an entity. The records have eight bytes each,
; laid out in the same way as an entity.
;
;   IX The entity
; O:C #N$01 if a record was found, otherwise #N$00
; O:DE The position of the record that was found (X in #REGe and Y in
; #REGd)
; O:HL The address of the Y position of the record that was found
@label=FindItemInRoom
c$8ADB LD HL,$EB18   ; Point #REGhl at the first of the item records at
                     ; #R$EB18.
 $8ADE LD DE,$0008   ; #REGde=#N($0008,$04,$04) (the size of each record).
 $8AE1 LD B,$08      ; #REGb=#N$08 (the number of records to look at).
@label=FindItemInRoom_Loop
*$8AE3 PUSH HL       ; Stash the address of the record on the stack.
 $8AE4 LD A,(HL)     ; Fetch the sprite ID of the record.
 $8AE5 AND A         ; Test whether the record is in use.
 $8AE6 JR Z,$8AF8    ; Jump to #R$8AF8 if it is not.
 $8AE8 INC HL        ; Move #REGhl on to the room of the record.
 $8AE9 LD A,(HL)     ; Fetch the room of the record.
 $8AEA CP (IX+$01)   ; Compare it with the room of the entity.
 $8AED JR NZ,$8AF8   ; Jump to #R$8AF8 if they are different.
 $8AEF POP DE        ; Restore the address of the record into #REGde.
 $8AF0 INC HL        ; {Move #REGhl on to the X position of the record.
 $8AF1 INC HL        ; }
 $8AF2 LD E,(HL)     ; Fetch the X position of the record.
 $8AF3 INC HL        ; Move #REGhl on to the Y position of the record.
 $8AF4 LD D,(HL)     ; Fetch the Y position of the record.
 $8AF5 LD C,$01      ; Set the result in #REGc to #N$01 (found).
 $8AF7 RET           ; Return.
@label=FindItemInRoom_Next
*$8AF8 POP HL        ; Restore the address of the record from the stack.
 $8AF9 ADD HL,DE     ; Move #REGhl on to the next record.
 $8AFA DJNZ $8AE3    ; Decrease the record counter by one and loop back to #R$8AE3 until
                     ; all eight records have been checked.
 $8AFC LD C,$00      ; Set the result in #REGc to #N$00 (not found).
 $8AFE RET           ; Return.

; Handle Hunchback
;
; The handler for the hunchback (sprite IDs #N$9C to #N$9F). If he
; touches the player then #R$8A15 takes some energy. The velocities are
; set by #R$882D, as the hunchback goes for the first item that is in his
; room (see #R$8ADB). When he reaches it the item is removed. If there is
; nothing to go for he stays still, and if the player is not a character
; then he heads for a position in the room. The movement itself is done by
; #R$84CD.
;
; IX The hunchback entity
@label=HandlerHunchback
c$8AFF CALL $9FFB      ; Call #R$9FFB to save the position of the hunchback.
 $8B02 CALL $85B2      ; Call #R$85B2 to check whether the entity is touching
                       ; the player.
 $8B05 DEC E           ; {Call #R$8A15 if the hunchback touched the player.
 $8B06 CALL Z,$8A15    ; }
 $8B09 XOR A           ; #REGa=#N$00 (no velocity).
 $8B0A LD (IX+$09),A   ; Set the Y velocity to zero.
 $8B0D LD (IX+$08),A   ; Set the X velocity to zero.
 $8B10 CALL $8ADB      ; Call #R$8ADB to look for an item.
 $8B13 DEC C           ; {Jump to #R$8B59 if there is no item.
 $8B14 JP NZ,$8B59     ; }
 $8B17 CALL $882D      ; Call #R$882D to head for the item.
 $8B1A LD A,C          ; Fetch which of the axes have been reached.
 $8B1B CP $03          ; {Jump to #R$8B45 if the hunchback has not arrived.
 $8B1D JR NZ,$8B45     ; }
; The hunchback is at the item, so remove it.
 $8B1F CALL $8ADB      ; Call #R$8ADB to find the item again.
 $8B22 LD DE,$0004     ; #REGde=#N($0004,$04,$04) (the offset of the Y position within a
                       ; record).
 $8B25 AND A           ; Reset the carry flag.
 $8B26 SBC HL,DE       ; Subtract #REGde from #REGhl to get the address of the
                       ; item.
 $8B28 PUSH IX         ; Stash the hunchback on the stack.
 $8B2A LD IX,$0000     ; {Make #REGix point at the item (copy #REGhl to
 $8B2E EX DE,HL        ; #REGix).
 $8B2F ADD IX,DE       ; }
 $8B31 LD A,($EA91)    ; Fetch the room of the player from #R$EA91.
 $8B34 CP (IX+$01)     ; Compare it with the room of the item.
 $8B37 JR NZ,$8B3C     ; Jump to #R$8B3C if they are different.
 $8B39 CALL $9F4A      ; Call #R$9F4A to draw the item.
@label=HandlerHunchback_Remove
*$8B3C LD (IX+$00),$00 ; Write #N$00 to the sprite ID of the item.
 $8B40 POP IX          ; Restore the hunchback from the stack.
 $8B42 JP $8B59        ; Jump to #R$8B59 to move the hunchback.
; The hunchback is on the way, so choose the sprite.
@label=HandlerHunchback_SetSprite
*$8B45 LD A,(IX+$00)   ; Fetch the sprite ID of the hunchback.
 $8B48 AND %11111100   ; Keep only bits 2-7.
 $8B4A LD C,A          ; Keep the base sprite ID in #REGc.
 $8B4B LD A,($5E12)    ; Fetch the counter from #R$5E12.
 $8B4E RRA             ; {Divide the counter by four.
 $8B4F RRA             ; }
 $8B50 AND %00000011   ; Keep only bits 0-1.
 $8B52 ADD A,C         ; Add the animation frame to the base sprite ID.
 $8B53 LD (IX+$00),A   ; Update the sprite ID of the hunchback.
 $8B56 LD DE,$3C3C     ; #REGde=#N($3C3C,$04,$04) (the area).
; If the player is a character then the hunchback moves, otherwise he
; heads for a position in the room.
@label=HandlerHunchback_Move
*$8B59 LD A,($EA90)    ; Fetch the sprite ID of the player from #R$EA90.
 $8B5C CP $31          ; {Jump to #R$84CD if the player is a character.
 $8B5E JP C,$84CD      ; }
 $8B61 LD DE,$3A58     ; #REGde=#N($3A58,$04,$04) (the target position).
 $8B64 CALL $882D      ; Call #R$882D to steer the creature towards its target.
 $8B67 JP $84CD        ; Jump to #R$84CD to move the creature.

; Creature Defaults
;
; The 16-byte record that #R$83EA copies into a free record to make a new
; creature. It starts as a sparkle (see #R$85F7).
; #TABLE(default,centre,left)
; { =h Offset | =h Description }
; { #N$00 | Sprite ID: #N$58 (the first frame of the sparkle) }
; { #N$01 | Room ID (set to the room of the player) }
; { #N$02 | The creature that the sparkle turns into (set from #R$8B7A) }
; { #N$03 | X position (set at random) }
; { #N$04 | Y position (set at random) }
; { #N$05 | Attribute: #COLOUR$44 }
; { #N$06 | Direction: #N$00 }
; { #N$07 | Step counter: #N$00 }
; { #N$08 | X velocity: #N$02 (set at random) }
; { #N$09 | Y velocity: #N$02 (set at random) }
; { #N$0A | Bobbing counter: #N$00 }
; { #N$0B | Waypoint X position: #N$00 }
; { #N$0C | Waypoint Y position: #N$00 }
; { #N$0D | Counter: #N$10 }
; { #N$0E | Sparkle counter: #N$20 }
; { #N$0F | Removal counter: #N$00 }
; TABLE#
@label=CreatureDefaults
b$8B6A DEFB $58,$00,$5C,$68,$68,$44,$00,$00
 $8B72 DEFB $02,$02,$00,$00,$00,$10,$20,$00

; Creatures
;
; The creatures that #R$83EA can make. One is chosen using the bottom four
; bits of FRAMES, and the value is the sprite ID of the first frame of the
; creature.
@label=Creatures
b$8B7A DEFB $5C      ; #SPRITENAME(#PEEK(#PC) - $01)
 $8B7B DEFB $5E      ; #SPRITENAME(#PEEK(#PC) - $01)
 $8B7C DEFB $98      ; #SPRITENAME(#PEEK(#PC) - $01)
 $8B7D DEFB $98      ; #SPRITENAME(#PEEK(#PC) - $01)
 $8B7E DEFB $90      ; #SPRITENAME(#PEEK(#PC) - $01)
 $8B7F DEFB $90      ; #SPRITENAME(#PEEK(#PC) - $01)
 $8B80 DEFB $94      ; #SPRITENAME(#PEEK(#PC) - $01)
 $8B81 DEFB $94      ; #SPRITENAME(#PEEK(#PC) - $01)
 $8B82 DEFB $5C      ; #SPRITENAME(#PEEK(#PC) - $01)
 $8B83 DEFB $5E      ; #SPRITENAME(#PEEK(#PC) - $01)
 $8B84 DEFB $60      ; #SPRITENAME(#PEEK(#PC) - $01)
 $8B85 DEFB $62      ; #SPRITENAME(#PEEK(#PC) - $01)
 $8B86 DEFB $4C      ; #SPRITENAME(#PEEK(#PC) - $01)
 $8B87 DEFB $4E      ; #SPRITENAME(#PEEK(#PC) - $01)
 $8B88 DEFB $68      ; #SPRITENAME(#PEEK(#PC) - $01)
 $8B89 DEFB $6A      ; #SPRITENAME(#PEEK(#PC) - $01)

; Draw Chicken
;
; Used by the routines at #R$8A15, #R$8C63, #R$8E26, #R$8ED7, #R$9443 and
; #R$988B.
; .
; Updates the picture of the roast chicken so that it shows the energy of
; the player. The energy in #R$5E28 and the level that was last drawn in
; #R$5E29 are both divided by eight, and nothing is done if they are the
; same. When the energy has gone up, the picture of the full chicken is
; drawn with a height of the new level. When it has gone down, the part of
; the empty chicken (see #R$C48C) below that level is drawn, by pointing the
; entry for it in the graphics table at #N$A626 at the data for that row and
; temporarily writing a new width and height there.
; #PUSHS #POKES$5C78,$34,$02 #POKES$5CB0,$E9
; #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$7D9A,stop=$7DDC,clear=1,sp=$5E00)
; #SCR$04,$18,$0A,$08,$06(chicken-before)
; | #POKES$5E28,$30
; #SIM(start=$8B8A,stop=$0000,sp=$5B60)
; #SCR$04,$18,$0A,$08,$06(chicken-after) } UDGTABLE# #POPS
;
; .
;
; Work out the new level and the level that was last drawn.
@label=DrawChicken
c$8B8A LD A,($5E28)  ; Fetch the energy of the player from #R$5E28.
 $8B8D SRL A         ; {Divide the energy of the player by eight, to get the
 $8B8F SRL A         ; new level.
 $8B91 SRL A         ; }
 $8B93 LD C,A        ; Keep the new level in #REGc.
 $8B94 LD A,($5E29)  ; Fetch the level of the chicken from #R$5E29.
 $8B97 SRL A         ; {Divide the level that was drawn by eight.
 $8B99 SRL A         ;
 $8B9B SRL A         ; }
 $8B9D LD B,A        ; Keep the level that was drawn in #REGb.
 $8B9E CP C          ; Compare it with the new level.
 $8B9F RET Z         ; Return if they are the same.
; Stash the heights of the two chicken graphics, and the entity, as they
; are changed below.
 $8BA0 LD A,($C543)  ; {Fetch the height of the full chicken from #R$C543 and keep it in
 $8BA3 LD E,A        ; #REGe.}
 $8BA4 LD A,($C48D)  ; {Fetch the height of the empty chicken from #R$C48D and keep it in
 $8BA7 LD D,A        ; #REGd.}
 $8BA8 PUSH IX       ; Stash the chicken entity on the stack.
 $8BAA LD IX,$8C2D   ; Point #REGix at the entity for the chicken at #R$8C2D.
 $8BAE PUSH DE       ; Stash the heights of the graphics on the stack.
 $8BAF JR C,$8C12    ; Jump to #R$8C12 if the energy has gone up.
; The energy has gone down, so draw the part of the empty chicken that is
; below the new level. First find the data for the row.
 $8BB1 LD A,($C48C)  ; {Fetch the width of the graphics in bytes from #R$C48C and keep it
 $8BB4 LD E,A        ; in #REGe.}
 $8BB5 LD D,$00      ; Clear the high byte of the width in #REGd.
 $8BB7 LD A,C        ; Fetch the new level.
 $8BB8 PUSH BC       ; Stash the levels on the stack.
 $8BB9 CALL $9AAD    ; Call #R$9AAD to multiply the width by the new level.
 $8BBC POP BC        ; Restore the levels from the stack.
 $8BBD LD DE,($A626) ; Fetch the address of the graphic from #N$A626.
 $8BC1 PUSH DE       ; Stash it on the stack.
 $8BC2 ADD HL,DE     ; Add the offset to the address of the graphic.
 $8BC3 LD ($A626),HL ; Update the address of the graphic at #N$A626.
; Save the two bytes at that address, and replace them with the width and
; the height that is left.
 $8BC6 LD E,(HL)     ; Fetch the first byte.
 $8BC7 INC HL        ; Move #REGhl on to the second byte.
 $8BC8 LD D,(HL)     ; Fetch the second byte.
 $8BC9 LD A,($C48D)  ; Fetch the height of the empty chicken from #R$C48D.
 $8BCC SUB C         ; Subtract the new level to get the height that is left.
 $8BCD JR Z,$8BFC    ; Jump to #R$8BFC if there is nothing left to draw.
 $8BCF PUSH DE       ; Stash #REGde on the stack.
 $8BD0 LD (HL),A     ; Write the height that is left to the second byte.
 $8BD1 LD A,($C48C)  ; Fetch the width from #R$C48C.
 $8BD4 DEC HL        ; Move #REGhl back to the first byte.
 $8BD5 LD (HL),A     ; Write the width to the first byte.
 $8BD6 PUSH HL       ; Stash the address of the graphic on the stack.
; Draw the part of the empty chicken, which is moved up by the new level.
 $8BD7 LD A,$14      ; #REGa=#N$14 (the empty chicken).
 $8BD9 LD (IX+$00),A ; Update the graphic of the entity.
 $8BDC LD HL,$77C8   ; #REGhl=#N$77C8 (the position of the chicken).
 $8BDF LD A,H        ; Fetch the Y position.
 $8BE0 SUB C         ; Subtract the new level.
 $8BE1 LD H,A        ; Set the new Y position in #REGh.
 $8BE2 LD ($8C30),HL ; Update the position of the entity.
 $8BE5 CALL $9213    ; Call #R$9213 to draw the entity.
 $8BE8 LD HL,($8C30) ; Fetch the position of the entity.
 $8BEB CALL $9BA2    ; Call #R$9BA2 to get the screen address of the position.
; Clear a row of bytes at that address.
 $8BEE LD A,($C48C)  ; {Fetch the width from #R$C48C and keep the number of bytes to clear,
 $8BF1 LD B,A        ; which is the width in #REGb.}
@label=DrawChicken_ClearRow
*$8BF2 LD (HL),$00   ; Clear a byte of the row.
 $8BF4 INC L         ; Move on to the next byte.
 $8BF5 DJNZ $8BF2    ; Decrease the byte counter by one and loop back to #R$8BF2 until the
                     ; whole row has been cleared.
; Put back the two bytes that were replaced.
 $8BF7 POP HL        ; Restore the address of the first byte from the stack.
 $8BF8 POP DE        ; Restore the two bytes from the stack.
 $8BF9 LD (HL),E     ; Write the first byte.
 $8BFA INC HL        ; Move #REGhl on to the second byte.
 $8BFB LD (HL),D     ; Write the second byte.
@label=DrawChicken_RestoreGraphic
*$8BFC POP HL        ; Restore the address of the graphic from the stack.
 $8BFD LD ($A626),HL ; Update the address of the graphic at #N$A626.
; Put back the heights of the graphics, and remember the level that has
; been drawn.
@label=DrawChicken_Finish
*$8C00 POP DE        ; Restore the stashed heights from the stack.
 $8C01 LD A,E        ; Fetch the height of the full chicken.
 $8C02 LD ($C543),A  ; Update the height of the full chicken in #R$C543.
 $8C05 LD A,D        ; Fetch the height of the empty chicken.
 $8C06 LD ($C48D),A  ; Update the height of the empty chicken in #R$C48D.
 $8C09 POP IX        ; Restore the chicken entity from the stack.
; See #POKE(infinite_chicken,Infinite Chicken).
 $8C0B LD A,($5E28)  ; Fetch the energy of the player from #R$5E28.
 $8C0E LD ($5E29),A  ; Update the level of the chicken in #R$5E29.
 $8C11 RET           ; Return.
; The energy has gone up, so draw the full chicken with the height of the
; new level.
@label=DrawChicken_Increase
*$8C12 LD A,C        ; Keep the new level in #REGa.
 $8C13 LD ($C543),A  ; Update the height of the full chicken in #R$C543.
 $8C16 LD A,$13      ; #REGa=#N$13 (the full chicken).
 $8C18 LD (IX+$00),A ; Update the graphic of the entity.
 $8C1B LD HL,$77C8   ; #REGhl=#N$77C8 (the position of the chicken).
 $8C1E LD ($8C30),HL ; Update the position of the entity.
 $8C21 CALL $9213    ; Call #R$9213 to draw the entity.
 $8C24 LD B,$06      ; #REGb=#N$06 (the number of bytes to clear).
@label=DrawChicken_ClearBytes
*$8C26 LD (HL),$00   ; Clear a byte of the chicken.
 $8C28 INC L         ; Move on to the next byte.
 $8C29 DJNZ $8C26    ; Decrease the byte counter by one and loop back to #R$8C26 until all
                     ; six bytes have been cleared.
 $8C2B JR $8C00      ; Jump to #R$8C00 to put back the heights of the graphics.

; Chicken Entity
;
; The entity that #R$8B8A uses to draw the chicken. Entities are 8-byte
; records, and the position is set before each use.
@label=Entity_Chicken
b$8C2D DEFB $00,$00,$00,$00,$00,$00,$00,$00

; Game Over
;
; Used by the routine at #R$8EA0.
; .
; Clears the play area, prints "GAME OVER" and the game statistics,
; waits for a while and then returns to the game selection menu.
;
; .
;
; #PUSHS #POKES$5C78,$34,$02 #POKES$5CB0,$E9
; #UDGTABLE(default,centre,centre)
; { =h Before | =h After #R$A1F3 | =h After #R$9641 }
; { #SIM(start=$7D9A,stop=$7DDC,clear=1,sp=$5E00)
; #SIM(start=$8C35,stop=$8C44,sp=$5E00)
; #SCR$01(game-over-before)
; | #SIM(start=$8C44,stop=$8C47,sp=$5E00)
; #SCR$01(game-over-text)
; | #SIM(start=$8C47,stop=$8C4A,sp=$5E00)
; #SCR$01(game-over-statistics) } UDGTABLE# #POPS
@label=GameOver
c$8C35 CALL $8093              ; Call #R$8093 to clear the play area.
 $8C38 LD HL,$BE4C             ; {Write #N$BE4C (the main font, see #R$BF4C) to
 $8C3B LD ($5E01),HL           ; #R$5E01.}
; Handle printing "Game Over" messaging.
 $8C3E LD HL,$3040             ; #REGhl=#N$3040 (a Y position of #N$30 and an X
                               ; position of #N$40).
 $8C41 LD DE,$8C59             ; Point #REGde at the "Game Over" text at
                               ; #R$8C59.
 $8C44 CALL $A1F3              ; Call #R$A1F3 to print the string.
; Handle printing the game statistics.
 $8C47 CALL $9641              ; Call #R$9641 to show the game statistics.
; This entry point is used by the routine at #R$96EC.
; .
; Provide a pause for us to reflect that the game has now ended.
@label=GameOverDelay
*$8C4A LD B,$14                ; #REGb=#N$14 (the number of times to run the
                               ; delay loop).
 $8C4C LD HL,$0000             ; #REGhl=#N($0000, $04, $04) (the delay
                               ; counter).
; From #REGhl being set above (and for each loop), decrementing #N($0000, $04,
; $04) by one gives #N$FFFF.
@label=GameOverDelay_Loop
*$8C4F DEC HL                  ; Count the delay down by one.
 $8C50 LD A,H                  ; {Loop back to #R$8C4F until the delay has
 $8C51 OR L                    ; counted down to zero.
 $8C52 JR NZ,$8C4F             ; }
 $8C54 DJNZ $8C4F              ; Decrease the delay counter by one and loop back to #R$8C4F until the
                               ; delay has finished.
 $8C56 JP $7C29                ; Jump to #R$7C29 to go back to the menu.
; "Game Over" messaging.
@label=StringGameOver
 $8C59 DEFM $47                ; {Attribute: #COLOUR(#PEEK(#PC)) + "GAME OVER".
 $8C5A DEFM "GAME OVE","R"+$80 ; }
; View the equivalent code in;
; #LIST
; { #LUNARJETMAN$A8E3 }
; { #TRANZAM$6353 }
; LIST#

; Handle Food Item
;
; The handler for the food and drink items (sprite IDs #N$50 to #N$57).
; If the player is not touching the item then the colour of its cells is set
; by #R$92E0. When the player touches it the item is removed, the eating sound
; is queued (see #R$A485), and #N$40 is added to the energy of the player
; in #R$5E28, up to a maximum of #N$F0. The chicken is then redrawn by
; #R$8B8A.
;
; IX The food item entity
@label=HandlerFoodItem
c$8C63 CALL $9FFB      ; Call #R$9FFB to save the position of the item.
 $8C66 CALL $90FB      ; Call #R$90FB to check whether the player is touching
                       ; the item.
 $8C69 JR C,$8C6E      ; Jump to #R$8C6E if the player is touching it.
 $8C6B JP $92E0        ; Jump to #R$92E0 to set the colour of the item.
; The player has touched the item, so remove it and give the player some
; energy.
@label=HandlerFoodItem_Eat
*$8C6E CALL $9F56      ; Call #R$9F56 to remove the item from the screen.
 $8C71 LD (IX+$00),$00 ; Write #N$00 to the sprite ID of the item.
 $8C75 CALL $A485      ; Call #R$A485 to queue the eating sound.
 $8C78 LD C,$40        ; #REGc=#N$40 (the energy that is gained).
 $8C7A LD A,($5E28)    ; Fetch the energy of the player from #R$5E28.
 $8C7D ADD A,C         ; Add the energy that is gained to the energy of the
                       ; player.
 $8C7E JR C,$8C84      ; Jump to #R$8C84 if the energy has overflowed.
 $8C80 CP $F0          ; {Jump to #R$8C86 if the energy of the player is lower than #N$F0,
 $8C82 JR C,$8C86      ; which is the maximum.}
@label=HandlerFoodItem_MaximumEnergy
*$8C84 LD A,$F0        ; #REGa=#N$F0 (the maximum energy).
@label=HandlerFoodItem_SetEnergy
*$8C86 LD ($5E28),A    ; Update the energy of the player in #R$5E28.
 $8C89 JP $8B8A        ; Jump to #R$8B8A to redraw the chicken.

; Flash Score
;
; Used by the routine at #R$8CB7.
; .
; Called by #R$8CB7 while the timer at #R$5E3C is running. The timer is
; counted down, the beep of the start is made every sixteen steps, and the
; six attribute cells of the score at the top of the screen are set to flash.
; When the timer reaches zero the flash is turned off again.
@label=FlashScore
c$8C8C DEC A         ; Decrease the timer.
 $8C8D LD ($5E3C),A  ; Write the timer back to #R$5E3C.
 $8C90 JR Z,$8CA7    ; Jump to #R$8CA7 if the timer has reached zero.
 $8C92 AND %00001111 ; Keep only bits 0-3.
 $8C94 CALL Z,$A3E0  ; Call #R$A3E0 to make the beep, if the bottom four bits
                     ; are zero.
 $8C97 LD HL,$50C8   ; #REGhl=#N$50C8 (the screen address of the score).
 $8C9A CALL $9BD2    ; Call #R$9BD2 to convert it to an attribute address.
 $8C9D LD B,$06      ; #REGb=#N$06 (the number of attribute cells of the
                     ; score).
@label=FlashScore_Loop
*$8C9F LD A,(HL)     ; Fetch the attribute.
 $8CA0 OR %10000000  ; Set bit 7 (flash).
 $8CA2 LD (HL),A     ; Write #REGa back to the attribute.
 $8CA3 INC HL        ; Move on to the next attribute.
 $8CA4 DJNZ $8C9F    ; Decrease the cell counter by one and loop back to #R$8C9F until all
                     ; six cells are flashing.
 $8CA6 RET           ; Return.
; The timer has finished, so turn the flash off.
@label=FlashScore_Stop
*$8CA7 LD HL,$50C8   ; #REGhl=#N$50C8 (the screen address of the score).
 $8CAA CALL $9BD2    ; Call #R$9BD2 to convert it to an attribute address.
 $8CAD LD B,$06      ; #REGb=#N$06 (the number of attribute cells of the
                     ; score).
@label=FlashScore_StopLoop
*$8CAF LD A,(HL)     ; Fetch the attribute.
 $8CB0 AND %01111111 ; Reset bit 7 (flash).
 $8CB2 LD (HL),A     ; Write #REGa back to the attribute.
 $8CB3 INC HL        ; Move on to the next attribute.
 $8CB4 DJNZ $8CAF    ; Decrease the cell counter by one and loop back to #R$8CAF until the
                     ; flash is off in all six cells.
 $8CB6 RET           ; Return.

; Handle Player Appearing
;
; The handler for the player (sprite ID #N$66) while the player is
; appearing at the start of a life, which is set up by #R$9443. While the timer
; at #R$5E3C is running #R$8C8C counts it down. After that the sprite of the
; player (the sprite ID at offset #N$07) is drawn one row more every fourth
; frame by #R$8CD4, while the sound of appearing is made and the colour of the
; cells changes. When all the rows have been drawn the sprite ID is put back
; and the handler is no longer used.
;
; IX The player entity
@label=HandlerPlayerAppearing
c$8CB7 LD A,($5E3C)    ; Fetch the timer from #R$5E3C.
 $8CBA AND A           ; {Jump to #R$8C8C if the timer is running.
 $8CBB JR NZ,$8C8C     ; }
 $8CBD LD A,($5C78)    ; Fetch FRAMES.
 $8CC0 AND %00000011   ; Keep only bits 0-1.
 $8CC2 JP NZ,$8D12     ; Jump to #R$8D12 unless this is every fourth frame.
 $8CC5 INC (IX+$06)    ; Increment the number of rows to draw at offset #N$06.
 $8CC8 LD A,(IX+$07)   ; Fetch the sprite ID of the player from offset #N$07.
 $8CCB CALL $9E89      ; Call #R$9E89 to get the address of the sprite data.
 $8CCE LD A,(DE)       ; Fetch the height of the sprite.
 $8CCF CP (IX+$06)     ; {Jump to #R$8D32 if all of the rows have been drawn.
 $8CD2 JR Z,$8D32      ; }
; This entry point is used by the routine at #R$8D45.
; .
; Draw the row of the sprite that is given by the number of rows. This is
; done by pointing the entry for the sprite in the table of sprites at the row,
; and temporarily changing the byte before it to a height of one row.
@label=HandlerPlayerAppearing_DrawRow
*$8CD4 PUSH DE         ; Stash the address of the sprite data on the stack.
 $8CD5 PUSH HL         ; Stash the address of the entry in the table of sprites
                       ; on the stack.
 $8CD6 LD B,H          ; {Keep the address of the table entry in #REGbc.
 $8CD7 LD C,L          ; }
 $8CD8 LD A,(IX+$04)   ; Fetch the Y position of the entity.
 $8CDB LD (IX+$02),A   ; Save it at offset #N$02.
 $8CDE SUB (IX+$06)    ; Subtract the number of rows.
 $8CE1 LD (IX+$04),A   ; Update the Y position of the entity.
 $8CE4 LD L,(IX+$06)   ; Fetch the number of rows.
 $8CE7 LD H,$00        ; Clear the high byte of the number of rows in #REGh.
 $8CE9 ADD HL,HL       ; Double #REGhl, as there are two bytes in each row.
 $8CEA ADD HL,DE       ; Add the address of the sprite data to #REGhl.
 $8CEB LD A,H          ; Fetch the high byte of the address of the row.
 $8CEC LD (BC),A       ; Write #REGa to the high byte of the table entry.
 $8CED DEC BC          ; Move #REGbc back to the low byte.
 $8CEE LD A,L          ; Fetch the low byte of the address of the row.
 $8CEF LD (BC),A       ; Write #REGa to the low byte of the table entry.
 $8CF0 PUSH HL         ; Stash the address of the row on the stack.
 $8CF1 LD C,(HL)       ; Fetch the byte at the address of the row.
 $8CF2 LD B,(IX+$00)   ; Fetch the sprite ID of the entity.
 $8CF5 PUSH BC         ; Stash them on the stack.
 $8CF6 LD (HL),$01     ; Write #N$01 (the height of one row) to the address of
                       ; the row.
 $8CF8 LD A,(IX+$07)   ; Fetch the sprite ID of the player from offset #N$07.
 $8CFB LD (IX+$00),A   ; Write it to the sprite ID of the entity.
 $8CFE CALL $9F4A      ; Call #R$9F4A to draw the row.
 $8D01 POP BC          ; Restore the byte and the sprite ID from the stack.
 $8D02 POP HL          ; Restore the address of the row from the stack.
 $8D03 LD (HL),C       ; Write the byte back.
 $8D04 LD (IX+$00),B   ; Write the sprite ID back to the entity.
 $8D07 LD A,(IX+$02)   ; Fetch the saved Y position from offset #N$02.
 $8D0A LD (IX+$04),A   ; Write it back to the Y position of the entity.
 $8D0D POP HL          ; Restore the address of the table entry from the stack.
 $8D0E POP DE          ; Restore the address of the sprite data from the stack.
 $8D0F LD (HL),D       ; Write the high byte back to the table entry.
 $8D10 DEC HL          ; Move #REGhl back to the low byte.
 $8D11 LD (HL),E       ; Write the low byte back to the table entry.
; This entry point is used by the routine at #R$8D45.
; .
; Set the colour of the cells that have been drawn so far, which cycles
; with FRAMES, and make the sound of appearing.
@label=HandlerPlayerAppearing_Colour
*$8D12 LD A,(IX+$05)   ; Fetch the attribute of the entity.
 $8D15 PUSH AF         ; Stash it on the stack.
 $8D16 LD A,($5C78)    ; Fetch FRAMES.
 $8D19 RRCA            ; {Divide FRAMES by four.
 $8D1A RRCA            ; }
 $8D1B AND %00000111   ; Keep only bits 0-2.
 $8D1D JR NZ,$8D20     ; Jump to #R$8D20 if the result is not zero.
 $8D1F INC A           ; Use #N$01 instead, to avoid black.
@label=HandlerPlayerAppearing_SetColour
*$8D20 OR %01000000    ; Set bit 6 (bright).
 $8D22 LD (IX+$05),A   ; Update the attribute of the entity.
 $8D25 LD A,(IX+$06)   ; Fetch the number of rows.
 $8D28 CALL $92E2      ; Call #R$92E2 to set the attributes of that many rows.
 $8D2B POP AF          ; Restore the attribute of the entity from the stack.
 $8D2C LD (IX+$05),A   ; Write it back to the entity.
 $8D2F JP $A45F        ; Jump to #R$A45F to make the sound of appearing.
; All of the rows have been drawn, so the player is back.
@label=HandlerPlayerAppearing_Finish
*$8D32 LD A,(IX+$07)   ; Fetch the sprite ID of the player from offset #N$07.
 $8D35 LD (IX+$00),A   ; Write it to the sprite ID of the entity.
 $8D38 LD (IX+$06),$00 ; Write #N$00 to offset #N$06.
 $8D3C LD (IX+$07),$00 ; Write #N$00 to offset #N$07.
 $8D40 LD (IX+$02),$00 ; Write #N$00 to offset #N$02.
 $8D44 RET             ; Return.

; Handle Player Vanishing
;
; The handler for the player (sprite ID #N$67) while a life is being
; lost, which is set up by #R$8EA0. This is the opposite of #R$8CB7, with the
; number of rows at offset #N$06 starting at the height of the sprite. On
; three frames out of four the row is drawn again (which erases it) by
; #R$8CD4 and the number is decreased. After the last row a tombstone is
; made by #R$95A9 and the next life is set up by #R$9443.
;
; IX The player entity
@label=HandlerPlayerVanishing
c$8D45 LD A,($5C78)  ; Fetch FRAMES.
 $8D48 AND %00000011 ; Keep only bits 0-1.
 $8D4A JR Z,$8D12    ; Jump to #R$8D12 if this is every fourth frame.
 $8D4C DEC (IX+$06)  ; Decrease the number of rows at offset #N$06.
 $8D4F JP M,$8D5B    ; Jump to #R$8D5B if all the rows have gone.
 $8D52 LD A,(IX+$07) ; Fetch the sprite ID of the player from offset #N$07.
 $8D55 CALL $9E89    ; Call #R$9E89 to get the address of the sprite data.
 $8D58 JP $8CD4      ; Jump to #R$8CD4 to draw the row of the sprite.
@label=HandlerPlayerVanishing_Finish
*$8D5B CALL $95A9    ; Call #R$95A9 to make the tombstone.
 $8D5E JP $9443      ; Jump to #R$9443 to set up the next life.

; Reset Game State
;
; Used by the routine at #R$7D9A.
; .
; Restores the entities and the other game data that start at #R$EA90 to
; their initial state, ready for a new game. The initial state is kept in
; the copy of the data that starts at #R$600D.
@label=ResetGameState
c$8D61 LD HL,$600D   ; Point #REGhl at the player initialisation data at
                     ; #R$600D.
 $8D64 LD DE,$EA90   ; Point #REGde at the player at #R$EA90.
 $8D67 LD BC,$1570   ; #REGbc=#N($1570,$04,$04) (the number of bytes of game
                     ; data).
 $8D6A LDIR          ; Copy the initial game data over the live game data.
 $8D6C RET           ; Return.
; View the equivalent code in;
; #LIST
; { #UNDERWURLDE$A3DD }
; LIST#

; Auto Walk Step
;
; Used by the routine at #R$8D77.
; .
; Counts down the bottom four bits of offset #N$02 of an entity, if they
; are not zero. While they are not zero #R$8EEF moves the entity by a fixed
; step in the direction it is going, rather than by the controls.
;
; IX The entity
@label=AutoWalkStep
c$8D6D LD A,(IX+$02) ; Fetch offset #N$02 of the entity.
 $8D70 AND %00001111 ; Keep only bits 0-3.
 $8D72 RET Z         ; Return if the result is zero.
 $8D73 DEC (IX+$02)  ; Decrease offset #N$02 of the entity by one.
 $8D76 RET           ; Return.

; Control Player
;
; Used by the routines at #R$80D2, #R$8DC4 and #R$8E26.
; .
; Moves the entity of a character, using the controls. Called by the
; handlers of the knight and the serf (and the wizard). The velocities of the
; entity are kept at offsets #N$06 (X) and #N$07 (Y), and have four bits after
; the point, so only the top four bits make up the whole pixels moved each
; frame. They are changed by #R$8EEF, slowed by #R$8F96 and limited by #R$8FCA
; and #R$900A before #R$8F66 moves the entity. The bits at offset #N$02 are
; the number of steps still to be taken in the bottom four, and in bits 4-5
; a flag that is set when movement is blocked along the X axis (bit 4) or
; the Y axis (bit 5).
;
; B The change made to a velocity each frame by the controls
; C The fastest X velocity
; (the Y velocity is limited by #REGb)
; D The amount that the Y velocity is slowed by each frame
; E The amount that the X velocity is slowed by each frame
; IX The entity of the character
@label=ControlPlayer
c$8D77 LD A,($EA91)  ; Fetch the room of the player from #R$EA91.
 $8D7A LD ($EE59),A  ; Write #REGa to #N$EE59 (the room of the entity at
                     ; #R$63D5).
 $8D7D PUSH BC       ; {Stash the speed limits (#REGbc), the slowing (#REGde) and #REGhl on
 $8D7E PUSH DE       ; the stack.
 $8D7F PUSH HL       ; }
 $8D80 CALL $8D6D    ; Call #R$8D6D to take a step of the auto walk.
 $8D83 LD A,(IX+$02) ; Fetch offset #N$02 of the entity.
 $8D86 OR %00110000  ; Set bits 4-5, to stop all movement until a check shows it is
                     ; possible.
 $8D88 LD (IX+$02),A ; Update offset #N$02 of the entity.
 $8D8B CALL $9FFB    ; Call #R$9FFB to save the position of the entity.
; Read the controls (a bit is zero when the control is used) and work out
; the change in velocity for each axis.
 $8D8E CALL $93BE    ; Call #R$93BE to read the controls.
 $8D91 LD C,A        ; Keep the controls in #REGc.
 $8D92 POP HL        ; Restore #REGhl from the stack.
 $8D93 LD DE,$0000   ; #REGde=#N($0000,$04,$04) (no change in either velocity).
 $8D96 BIT 1,C       ; {Jump to #R$8D9E if bit 1 (left) is not used.
 $8D98 JR NZ,$8D9E   ; }
 $8D9A LD A,B        ; Fetch the change in velocity.
 $8D9B NEG           ; Reverse the change, so that it is negative.
 $8D9D LD E,A        ; #REGe=#REGa (the X change is -#REGb).
@label=ControlPlayer_Right
*$8D9E BIT 0,C       ; {Jump to #R$8DA3 if bit 0 (right) is not used.
 $8DA0 JR NZ,$8DA3   ; }
 $8DA2 LD E,B        ; #REGe=#REGb (the X change is #REGb).
@label=ControlPlayer_Down
*$8DA3 BIT 2,C       ; {Jump to #R$8DA8 if bit 2 (down) is not used.
 $8DA5 JR NZ,$8DA8   ; }
 $8DA7 LD D,B        ; #REGd=#REGb (the Y change is #REGb).
@label=ControlPlayer_Up
*$8DA8 BIT 3,C       ; {Jump to #R$8DB0 if bit 3 (up) is not used.
 $8DAA JR NZ,$8DB0   ; }
 $8DAC LD A,B        ; Fetch the change in velocity.
 $8DAD NEG           ; Reverse the change, so that it is negative.
 $8DAF LD D,A        ; #REGd=#REGa (the Y change is -#REGb).
; Slow the velocities, change them, check for obstacles and then move the
; entity.
@label=ControlPlayer_Move
*$8DB0 POP HL        ; Restore the amounts of slowing from the stack into
                     ; #REGhl.
 $8DB1 CALL $8F96    ; Call #R$8F96 to slow the entity down.
 $8DB4 POP HL        ; Restore the fastest velocities from the stack into
                     ; #REGhl.
 $8DB5 CALL $8EEF    ; Call #R$8EEF to update the velocities of the entity.
 $8DB8 CALL $8FCA    ; Call #R$8FCA to check whether the entity is inside the
                     ; room.
 $8DBB CALL $957D    ; Call #R$957D to check the doorway.
 $8DBE CALL $900A    ; Call #R$900A to check whether the entity would hit an
                     ; item.
 $8DC1 JP $8F66      ; Jump to #R$8F66 to move the entity by its velocities.

; Handle Serf
;
; The handler for the serf (sprite IDs #N$21 to #N$30) when it is the
; character being played. The serf is moved by #R$8D77, with a change in
; velocity of #N$20, a top speed of #N$20 and a slowing of #N$01 on each
; frame. When it is moving, every fourth frame the next frame of the
; animation is chosen for the direction of travel (the four sets are left,
; right, up and down) and the sound of walking is made. Then the fire
; button throws a sword (see #R$8283), and #R$8E78 does the rest.
;
; IX The serf entity
@label=HandlerSerf
c$8DC4 LD BC,$2020   ; #REGbc=#N($2020,$04,$04) (the change in velocity and the
                     ; top speed).
 $8DC7 LD DE,$0101   ; #REGde=#N($0101,$04,$04) (the slowing of each velocity).
 $8DCA LD HL,$0707   ; #REGhl=#N($0707,$04,$04) (this is not used by #R$8D77).
 $8DCD CALL $8D77    ; Call #R$8D77 to move the serf.
 $8DD0 LD E,(IX+$06) ; Fetch the X velocity.
 $8DD3 LD D,(IX+$07) ; Fetch the Y velocity.
 $8DD6 LD A,D        ; {Jump to #R$8E0F if the serf is not moving (both velocities are
 $8DD7 OR E          ; zero).
 $8DD8 JR Z,$8E0F    ; }
 $8DDA LD A,($5C78)  ; Fetch FRAMES.
 $8DDD AND %00000011 ; Keep only bits 0-1.
 $8DDF JR NZ,$8E0F   ; Jump to #R$8E0F unless this is every fourth frame.
; Move on to the next frame of the animation, for the left set of sprites.
 $8DE1 LD A,(IX+$00) ; Fetch the sprite ID of the serf.
 $8DE4 AND %00000011 ; Keep only bits 0-1.
 $8DE6 ADD A,$21     ; Add #N$21 (the first of the sprites facing left).
 $8DE8 LD (IX+$00),A ; Update the sprite ID of the serf.
; Work out which axis the serf is moving fastest on, by comparing the
; sizes of the velocities.
 $8DEB LD A,D        ; Fetch the Y velocity.
 $8DEC AND A         ; {Jump to #R$8DF2 if the Y velocity is positive.
 $8DED JP P,$8DF2    ; }
 $8DF0 NEG           ; Make it positive.
@label=HandlerSerf_CompareAxes
*$8DF2 LD C,A        ; Keep the Y speed in #REGc.
 $8DF3 LD A,E        ; Fetch the X velocity.
 $8DF4 AND A         ; {Jump to #R$8DFA if the X velocity is positive.
 $8DF5 JP P,$8DFA    ; }
 $8DF8 NEG           ; Make it positive.
@label=HandlerSerf_Compare
*$8DFA CP C          ; {Jump to #R$8E1A if the serf is moving more across than
 $8DFB JR NC,$8E1A   ; up or down.}
; The serf is moving up or down, so add #N$08 for the sprites facing up or
; #N$0C for those facing down.
 $8DFD LD A,D        ; Fetch the Y velocity.
 $8DFE AND A         ; Test the sign of the Y velocity.
 $8DFF LD A,(IX+$00) ; Fetch the sprite ID of the serf.
 $8E02 JP M,$8E07    ; Jump to #R$8E07 if the serf is moving up.
 $8E05 ADD A,$04     ; Add #N$04.
@label=HandlerSerf_Vertical
*$8E07 ADD A,$08     ; Add #N$08.
@label=HandlerSerf_SetSprite
*$8E09 LD (IX+$00),A ; Update the sprite ID of the serf.
 $8E0C CALL $A3C7    ; Call #R$A3C7 to make the sound of walking.
; See whether the fire button is pressed, and then do what every character
; does.
@label=HandlerSerf_Fire
*$8E0F CALL $93BE    ; Call #R$93BE to read the controls.
 $8E12 AND %00010000 ; Keep only bit 4 (fire).
 $8E14 CALL Z,$8283  ; Call #R$8283 to throw a sword if the fire button is
                     ; pressed.
 $8E17 JP $8E78      ; Jump to #R$8E78 to finish handling the character.
; The serf is moving across, so add #N$04 for the sprites facing right.
@label=HandlerSerf_Horizontal
*$8E1A LD A,E        ; Fetch the X velocity.
 $8E1B AND A         ; Test the sign of the X velocity.
 $8E1C LD A,(IX+$00) ; Fetch the sprite ID of the serf.
 $8E1F JP M,$8E09    ; Jump to #R$8E09 if the serf is moving left.
 $8E22 ADD A,$04     ; Add #N$04.
 $8E24 JR $8E09      ; Jump to #R$8E09 to set the sprite of the serf.

; Handle Knight
;
; The handler for the knight (sprite IDs #N$01 to #N$10) when it is the
; character being played. It is the same as #R$8DC4, except that the slowing is
; #N$03 on each frame and the fire button throws an axe (see #R$8134). The
; second part of this routine is used by the other characters as well: it
; makes creatures (see #R$83EA), takes energy from the player every sixteen
; frames, and displays the character.
;
; IX The knight entity
@label=HandlerKnight
c$8E26 LD BC,$2020   ; #REGbc=#N($2020,$04,$04) (the change in velocity and the
                     ; top speed).
 $8E29 LD DE,$0303   ; #REGde=#N($0303,$04,$04) (the slowing of each velocity).
 $8E2C LD HL,$0707   ; #REGhl=#N($0707,$04,$04) (this is not used by #R$8D77).
 $8E2F CALL $8D77    ; Call #R$8D77 to move the knight.
 $8E32 LD E,(IX+$06) ; Fetch the X velocity.
 $8E35 LD D,(IX+$07) ; Fetch the Y velocity.
 $8E38 LD A,D        ; {Jump to #R$8E70 if the knight is not moving (both velocities are
 $8E39 OR E          ; zero).
 $8E3A JR Z,$8E70    ; }
 $8E3C LD A,($5C78)  ; Fetch FRAMES.
 $8E3F AND %00000011 ; Keep only bits 0-1.
 $8E41 JR NZ,$8E70   ; Jump to #R$8E70 unless this is every fourth frame.
; Move on to the next frame of the animation, for the left set of sprites.
 $8E43 LD A,(IX+$00) ; Fetch the sprite ID of the knight.
 $8E46 AND %00000011 ; Keep only bits 0-1.
 $8E48 INC A         ; Add #N$01 (the first of the sprites facing left).
 $8E49 LD (IX+$00),A ; Update the sprite ID of the knight.
; Work out which axis the knight is moving fastest on, by comparing the
; sizes of the velocities.
 $8E4C LD A,D        ; Fetch the Y velocity.
 $8E4D AND A         ; {Jump to #R$8E53 if the Y velocity is positive.
 $8E4E JP P,$8E53    ; }
 $8E51 NEG           ; Make it positive.
@label=HandlerKnight_CompareAxes
*$8E53 LD C,A        ; Keep the Y speed in #REGc.
 $8E54 LD A,E        ; Fetch the X velocity.
 $8E55 AND A         ; {Jump to #R$8E5B if the X velocity is positive.
 $8E56 JP P,$8E5B    ; }
 $8E59 NEG           ; Make it positive.
@label=HandlerKnight_Compare
*$8E5B CP C          ; {Jump to #R$8E94 if the knight is moving more across
 $8E5C JR NC,$8E94   ; than up or down.}
; The knight is moving up or down, so add #N$08 for the sprites facing up
; or #N$0C for those facing down.
 $8E5E LD A,D        ; Fetch the Y velocity.
 $8E5F AND A         ; Test the sign of the Y velocity.
 $8E60 LD A,(IX+$00) ; Fetch the sprite ID of the knight.
 $8E63 JP M,$8E68    ; Jump to #R$8E68 if the knight is moving up.
 $8E66 ADD A,$04     ; Add #N$04.
@label=HandlerKnight_Vertical
*$8E68 ADD A,$08     ; Add #N$08.
@label=HandlerKnight_SetSprite
*$8E6A LD (IX+$00),A ; Update the sprite ID of the knight.
 $8E6D CALL $A3C7    ; Call #R$A3C7 to make the sound of walking.
; See whether the fire button is pressed.
@label=HandlerKnight_Fire
*$8E70 CALL $93BE    ; Call #R$93BE to read the controls.
 $8E73 AND %00010000 ; Keep only bit 4 (fire).
 $8E75 CALL Z,$8134  ; Call #R$8134 to throw an axe if the fire button is
                     ; pressed.
; This entry point is used by the routines at #R$80D2 and #R$8DC4.
; .
; Make creatures, use up some energy and display the character. This is
; also where the serf and the wizard come in.
@label=HandlerCharacter_Finish
*$8E78 CALL $83EA    ; Call #R$83EA to make a creature, if one is due.
 $8E7B LD A,($5E12)  ; Fetch the counter from #R$5E12.
 $8E7E AND %00001111 ; Keep only bits 0-3.
 $8E80 JR NZ,$8E8E   ; Jump to #R$8E8E unless this is every sixteenth frame.
 $8E82 LD A,($5E28)  ; Fetch the energy of the player from #R$5E28.
 $8E85 DEC A         ; Decrease the energy by one.
 $8E86 JR Z,$8EA0    ; Jump to #R$8EA0 if there is no energy left.
 $8E88 LD ($5E28),A  ; Update the energy of the player in #R$5E28.
 $8E8B CALL $8B8A    ; Call #R$8B8A to redraw the chicken.
; This entry point is used by the routines at #R$8209, #R$8301, #R$84CD,
; #R$85F7 and #R$8787.
@label=HandlerCharacter_Display
*$8E8E CALL $9FCA    ; Call #R$9FCA to display the character.
 $8E91 JP $A01A      ; Jump to #R$A01A to set the attributes of the cells it
                     ; covers.
; The knight is moving across, so add #N$04 for the sprites facing right.
@label=HandlerKnight_Horizontal
*$8E94 LD A,E        ; Fetch the X velocity.
 $8E95 AND A         ; Test the sign of the X velocity.
 $8E96 LD A,(IX+$00) ; Fetch the sprite ID of the knight.
 $8E99 JP M,$8E6A    ; Jump to #R$8E6A if the knight is moving left.
 $8E9C ADD A,$04     ; Add #N$04.
 $8E9E JR $8E6A      ; Jump to #R$8E6A to set the sprite of the knight.

; Lose Life
;
; Used by the routines at #R$8A15, #R$8E26, #R$8ED7 and #R$98C8.
; .
; Takes one of the lives of the player, or ends the game if there are none
; left. The player is set to the vanishing sprite #N$67 (see #R$8D45), with the
; number of rows to erase (at offset #N$06) set to the height of the sprite
; and the sprite ID that it came from (at offset #N$07). If the entity is a
; character then the position that was saved by #R$9FFB is used first.
;
; IX The entity of the character
@label=LoseLife
c$8EA0 LD A,($5E21)  ; Fetch the number of lives from #R$5E21.
 $8EA3 AND A         ; Test whether there are no lives left.
 $8EA4 JP Z,$8C35    ; Jump to #R$8C35 if there are none.
; See #POKE(infinite_lives,Infinite Lives).
 $8EA7 DEC A         ; Decrease the number of lives by one.
 $8EA8 LD ($5E21),A  ; Update the number of lives in #R$5E21.
 $8EAB LD A,(IX+$00) ; Fetch the sprite ID of the entity.
 $8EAE DEC A         ; Subtract one to get the ID that starts at zero.
 $8EAF CP $30        ; {Jump to #R$8EC6 if the entity is a character.
 $8EB1 JR C,$8EC6    ; }
 $8EB3 LD A,($EA90)  ; Fetch the sprite ID of the player from #R$EA90.
@label=LoseLife_Vanish
*$8EB6 LD ($EA97),A  ; Store the sprite ID of the player at offset #N$07.
 $8EB9 CALL $9E89    ; Call #R$9E89 to get the address of the sprite data.
 $8EBC LD A,(DE)     ; Fetch the height of the sprite.
 $8EBD LD ($EA96),A  ; Store the height of the sprite at offset #N$06, as the number of
                     ; rows to draw.
 $8EC0 LD A,$67      ; #REGa=#N$67 (the vanishing player).
 $8EC2 LD ($EA90),A  ; Update the sprite ID of the player.
 $8EC5 RET           ; Return.
; Use the position and the sprite that were saved.
@label=LoseLife_Character
*$8EC6 LD A,($5E16)  ; Fetch the previous X position from #R$5E16.
 $8EC9 LD ($EA93),A  ; Update the X position of the player.
 $8ECC LD A,($5E17)  ; Fetch the previous Y position from #R$5E17.
 $8ECF LD ($EA94),A  ; Update the Y position of the player.
 $8ED2 LD A,($5E15)  ; Fetch the previous sprite ID from #R$5E15.
 $8ED5 JR $8EB6      ; Jump to #R$8EB6 to start the player vanishing.

; Hurt Player
;
; Used by the routine at #R$85EA.
; .
; Takes #N$20 from the energy of the player in #R$5E28, which is what
; happens when a creature touches them (see #R$85EA). The chicken is redrawn
; by #R$8B8A. If the energy is gone then #R$8EA0 takes a life.
@label=HurtPlayer
c$8ED7 LD A,($5E28)  ; Fetch the energy of the player from #R$5E28.
 $8EDA SUB $20       ; Subtract #N$20.
 $8EDC JR Z,$8EE1    ; Jump to #R$8EE1 if the energy is zero.
 $8EDE JR NC,$8EE9   ; Jump to #R$8EE9 if there is some energy left.
 $8EE0 XOR A         ; #REGa=#N$00 (no energy left).
@label=HurtPlayer_NoEnergy
*$8EE1 LD ($5E28),A  ; Update the energy of the player in #R$5E28.
 $8EE4 CALL $8B8A    ; Call #R$8B8A to redraw the chicken.
 $8EE7 JR $8EA0      ; Jump to #R$8EA0 to take a life from the player.
@label=HurtPlayer_Update
*$8EE9 LD ($5E28),A  ; Update the energy of the player in #R$5E28.
 $8EEC JP $8B8A      ; Jump to #R$8B8A to redraw the chicken.

; Update Velocity
;
; Used by the routine at #R$8D77.
; .
; Changes the velocities of an entity that is controlled by #R$8D77, and
; works out how many whole pixels it will move this frame. Each velocity (at
; offsets #N$06 and #N$07) has the change added, and is then limited to the
; fastest speed in either direction. The top four bits of the velocity are
; the pixels to move, which is #R$8F80. While the steps of an automatic
; walk are being counted down by #R$8D6D (the bottom four bits of offset
; #N$02) the pixels moved are #N$00 or #N$02 instead, depending on whether
; the velocity is below #N$10, with the sign of the velocity.
;
;   DE The change in each velocity (X in #REGe and Y in #REGd)
;   HL The fastest velocity (X in #REGl and Y in #REGh)
;   IX The entity
; O:DE The pixels to move (X in #REGe and Y in #REGd)
@label=UpdateVelocity
c$8EEF LD A,(IX+$02)  ; Fetch offset #N$02 of the entity.
 $8EF2 AND %00001111  ; Keep only bits 0-3.
 $8EF4 JR NZ,$8F35    ; Jump to #R$8F35 if an automatic walk is under way.
; Change the X velocity, and keep it within the fastest speed.
 $8EF6 LD A,E         ; Fetch the change in the X velocity from #REGe.
 $8EF7 ADD A,(IX+$06) ; Add the X velocity.
 $8EFA JP M,$8F21     ; Jump to #R$8F21 if the result is negative.
 $8EFD CP L           ; {Jump to #R$8F01 if the X velocity is slower than the fastest X
 $8EFE JR C,$8F01     ; velocity.}
 $8F00 LD A,L         ; Use the fastest X velocity.
@label=UpdateVelocity_SetX
*$8F01 LD (IX+$06),A  ; Update the X velocity.
; Change the Y velocity, and keep it within the fastest speed.
 $8F04 LD A,D         ; Fetch the change in the Y velocity from #REGd.
 $8F05 ADD A,(IX+$07) ; Add the Y velocity.
 $8F08 JP M,$8F2B     ; Jump to #R$8F2B if the result is negative.
 $8F0B CP H           ; {Jump to #R$8F0F if the Y velocity is slower than the fastest Y
 $8F0C JR C,$8F0F     ; velocity.}
 $8F0E LD A,H         ; Use the fastest Y velocity.
@label=UpdateVelocity_SetY
*$8F0F LD (IX+$07),A  ; Update the Y velocity.
; Get the whole pixels from the velocities.
 $8F12 LD A,(IX+$06)  ; Fetch the X velocity.
 $8F15 CALL $8F80     ; Call #R$8F80 to convert the velocity to whole pixels.
 $8F18 LD E,A         ; Keep the whole pixels of the X velocity in #REGe.
 $8F19 LD A,(IX+$07)  ; Fetch the Y velocity.
 $8F1C CALL $8F80     ; Call #R$8F80 to convert the velocity to whole pixels.
 $8F1F LD D,A         ; Keep the whole pixels of the Y velocity in #REGd.
 $8F20 RET            ; Return.
; The X velocity is negative, so limit it using its size.
@label=UpdateVelocity_NegativeX
*$8F21 NEG            ; Make the X velocity positive.
 $8F23 CP L           ; {Jump to #R$8F27 if the X velocity is slower than the fastest X
 $8F24 JR C,$8F27     ; velocity.}
 $8F26 LD A,L         ; Use the fastest X velocity.
@label=UpdateVelocity_NegateX
*$8F27 NEG            ; Make the X velocity negative again.
 $8F29 JR $8F01       ; Jump to #R$8F01 to set the X velocity.
; The Y velocity is negative, so limit it using its size.
@label=UpdateVelocity_NegativeY
*$8F2B NEG            ; Make the Y velocity positive.
 $8F2D CP H           ; {Jump to #R$8F31 if the Y velocity is slower than the fastest Y
 $8F2E JR C,$8F31     ; velocity.}
 $8F30 LD A,H         ; Use the fastest Y velocity.
@label=UpdateVelocity_NegateY
*$8F31 NEG            ; Make the Y velocity negative again.
 $8F33 JR $8F0F       ; Jump to #R$8F0F to set the Y velocity.
; An automatic walk is under way, so move by two pixels on an axis if its
; velocity is #N$10 or more, or else not at all.
@label=UpdateVelocity_Walk
*$8F35 LD A,(IX+$06)  ; Fetch the X velocity.
 $8F38 AND A          ; {Jump to #R$8F52 if the X velocity is negative.
 $8F39 JP M,$8F52     ; }
 $8F3C AND %11110000  ; Keep only bits 4-7.
 $8F3E JR Z,$8F42     ; Jump to #R$8F42 if the result is zero.
 $8F40 LD A,$02       ; #REGa=#N$02 (move two pixels right).
@label=UpdateVelocity_WalkY
*$8F42 LD E,A         ; Keep the X move in #REGe.
 $8F43 LD A,(IX+$07)  ; Fetch the Y velocity.
 $8F46 AND A          ; {Jump to #R$8F5C if the Y velocity is negative.
 $8F47 JP M,$8F5C     ; }
 $8F4A AND %11110000  ; Keep only bits 4-7.
 $8F4C JR Z,$8F50     ; Jump to #R$8F50 if the result is zero.
 $8F4E LD A,$02       ; #REGa=#N$02 (move two pixels down).
@label=UpdateVelocity_WalkEnd
*$8F50 LD D,A         ; Keep the Y move in #REGd.
 $8F51 RET            ; Return.
@label=UpdateVelocity_WalkNegativeX
*$8F52 NEG            ; Make the X velocity positive.
 $8F54 AND %11110000  ; Keep only bits 4-7.
 $8F56 JR Z,$8F42     ; Jump to #R$8F42 if the result is zero.
 $8F58 LD A,$FE       ; #REGa=-#N$02 (move two pixels left).
 $8F5A JR $8F42       ; Jump to #R$8F42 to do the walk on the Y axis.
@label=UpdateVelocity_WalkNegativeY
*$8F5C NEG            ; Make the Y velocity positive.
 $8F5E AND %11110000  ; Keep only bits 4-7.
 $8F60 JR Z,$8F50     ; Jump to #R$8F50 if the result is zero.
 $8F62 LD A,$FE       ; #REGa=-#N$02 (move two pixels up).
 $8F64 JR $8F50       ; Jump to #R$8F50 to finish the walk.

; Apply Movement
;
; Used by the routine at #R$8D77.
; .
; Moves an entity by whole pixels on each axis, unless the flag for the
; axis in bits 4-5 of offset #N$02 is set. The flags are set by #R$8D77 and
; cleared again by #R$8FCA and #R$900A if the move is possible.
;
; DE The pixels to move (X in #REGe and Y in #REGd)
; IX The entity
@label=ApplyMovement
c$8F66 BIT 4,(IX+$02) ; {Jump to #R$8F73 if the flag for the X axis (bit 4) is
 $8F6A JR NZ,$8F73    ; set.}
 $8F6C LD A,E         ; Fetch the X move.
 $8F6D ADD A,(IX+$03) ; Add the X position of the entity.
 $8F70 LD (IX+$03),A  ; Update the X position of the entity.
@label=ApplyMovement_Y
*$8F73 BIT 5,(IX+$02) ; {Return if the flag for the Y axis (bit 5) is set.
 $8F77 RET NZ         ; }
 $8F78 LD A,D         ; Fetch the Y move.
 $8F79 ADD A,(IX+$04) ; Add the Y position of the entity.
 $8F7C LD (IX+$04),A  ; Update the Y position of the entity.
 $8F7F RET            ; Return.

; Get Whole Pixels
;
; Used by the routine at #R$8EEF.
; .
; Converts a velocity, which has four bits after the point, to the number
; of whole pixels to move. This is the velocity divided by sixteen, rounded
; towards zero.
;
;   A The velocity (signed)
; O:A The whole pixels
@label=GetWholePixels
c$8F80 AND A         ; Test the sign of the velocity.
 $8F81 JP P,$8F8F    ; Jump to #R$8F8F if it is positive.
 $8F84 NEG           ; Make the velocity positive.
 $8F86 RRCA          ; {Shift the velocity right four times, to drop the bits after the
 $8F87 RRCA          ; point.
 $8F88 RRCA          ;
 $8F89 RRCA          ; }
 $8F8A AND %00001111 ; Keep only bits 0-3.
 $8F8C NEG           ; Make the result negative.
 $8F8E RET           ; Return.
@label=GetWholePixels_Positive
*$8F8F RRCA          ; {Shift the velocity right four times, to drop the bits after the
 $8F90 RRCA          ; point.
 $8F91 RRCA          ;
 $8F92 RRCA          ; }
 $8F93 AND %00001111 ; Keep only bits 0-3.
 $8F95 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #SABREWULF$B031 }
; LIST#

; Slow Velocity
;
; Used by the routine at #R$8D77.
; .
; Takes some speed off both of the velocities of an entity, which are at
; offsets #N$06 and #N$07. Neither of them goes beyond zero. Nothing is
; done while an automatic walk is under way (see #R$8D6D).
;
; HL The amount to take off each velocity (X in #REGl and Y in #REGh)
; IX The entity
@label=SlowVelocity
c$8F96 LD A,(IX+$02) ; Fetch offset #N$02 of the entity.
 $8F99 AND %00001111 ; Keep only bits 0-3.
 $8F9B RET NZ        ; Return if an automatic walk is under way.
 $8F9C LD A,(IX+$06) ; Fetch the X velocity.
 $8F9F AND A         ; Test whether it is zero.
 $8FA0 JR Z,$8FAD    ; Jump to #R$8FAD if it is.
 $8FA2 JP M,$8FBE    ; Jump to #R$8FBE if it is negative.
 $8FA5 SUB L         ; Subtract the amount from the velocity.
 $8FA6 JP P,$8FAA    ; Jump to #R$8FAA if it is still positive.
@label=SlowVelocity_ZeroX
*$8FA9 XOR A         ; #REGa=#N$00 (the velocity when it is stopped).
@label=SlowVelocity_SetX
*$8FAA LD (IX+$06),A ; Update the X velocity.
@label=SlowVelocity_Y
*$8FAD LD A,(IX+$07) ; Fetch the Y velocity.
 $8FB0 AND A         ; Test whether it is zero.
 $8FB1 RET Z         ; Return if it is.
 $8FB2 JP M,$8FC4    ; Jump to #R$8FC4 if it is negative.
 $8FB5 SUB H         ; Subtract the amount from the velocity.
 $8FB6 JP P,$8FBA    ; Jump to #R$8FBA if it is still positive.
@label=SlowVelocity_ZeroY
*$8FB9 XOR A         ; #REGa=#N$00 (the velocity when it is stopped).
@label=SlowVelocity_SetY
*$8FBA LD (IX+$07),A ; Update the Y velocity.
 $8FBD RET           ; Return.
@label=SlowVelocity_NegativeX
*$8FBE ADD A,L       ; Add the amount to the velocity.
 $8FBF JP M,$8FAA    ; Jump to #R$8FAA if it is still negative.
 $8FC2 JR $8FA9      ; Jump to #R$8FA9 to zero the X velocity.
@label=SlowVelocity_NegativeY
*$8FC4 ADD A,H       ; Add the amount to the velocity.
 $8FC5 JP M,$8FBA    ; Jump to #R$8FBA if it is still negative.
 $8FC8 JR $8FB9      ; Jump to #R$8FB9 to zero the Y velocity.

; Check Room Bounds
;
; Used by the routine at #R$8D77.
; .
; Checks whether an entity could move along each axis without leaving the
; room. If the position it would be at is inside the room then the flag for
; the axis in offset #N$02 is cleared (bit 4 for X and bit 5 for Y), so that
; #R$8F66 will move it. The position is inside the room when the distance
; from the centre of the room (#N$58 across and #N$68 down) is less than the
; width and the height in #R$5E1D.
;
; DE The pixels to move (X in #REGe and Y in #REGd)
; IX The entity
@label=CheckRoomBounds
c$8FCA PUSH DE        ; Stash the moves on the stack.
 $8FCB LD A,E         ; Fetch the X move.
 $8FCC ADD A,(IX+$03) ; Add the X position of the entity.
 $8FCF LD E,A         ; Keep the new X position in #REGe.
 $8FD0 LD D,(IX+$04)  ; Fetch the Y position of the entity.
 $8FD3 LD B,$10       ; #REGb=#N$10 (the flag for the X axis).
 $8FD5 CALL $8FE9     ; Call #R$8FE9 to check whether the position is inside
                      ; the room.
 $8FD8 POP DE         ; Restore the moves from the stack.
 $8FD9 PUSH DE        ; Stash it on the stack again.
 $8FDA LD E,(IX+$03)  ; Fetch the X position of the entity.
 $8FDD LD A,D         ; Fetch the Y move.
 $8FDE ADD A,(IX+$04) ; Add the Y position of the entity.
 $8FE1 LD D,A         ; Keep the new Y position in #REGd.
 $8FE2 LD B,$20       ; #REGb=#N$20 (the flag for the Y axis).
 $8FE4 CALL $8FE9     ; Call #R$8FE9 to check whether the position is inside
                      ; the room.
 $8FE7 POP DE         ; Restore the moves from the stack.
 $8FE8 RET            ; Return.
; Clears a flag if a position is inside the room.
@label=CheckRoomBounds_Position
*$8FE9 LD HL,$5E1D    ; Point #REGhl at the room width at #R$5E1D.
 $8FEC LD A,E         ; Fetch the X position to check.
 $8FED SUB $58        ; Subtract #N$58 (the horizontal centre of the room).
 $8FEF JP P,$8FF4     ; Jump to #R$8FF4 if the result is positive.
 $8FF2 NEG            ; Make the result positive.
@label=CheckRoomBounds_Width
*$8FF4 CP (HL)        ; Compare it with the width of the room.
 $8FF5 RET NC         ; Return if it is outside.
 $8FF6 INC HL         ; Move #REGhl on to the height of the room.
 $8FF7 LD A,D         ; Fetch the Y position to check.
 $8FF8 SUB $68        ; Subtract #N$68 (the vertical centre of the room).
 $8FFA JP P,$8FFF     ; Jump to #R$8FFF if the result is positive.
 $8FFD NEG            ; Make the result positive.
@label=CheckRoomBounds_Height
*$8FFF CP (HL)        ; Compare it with the height of the room.
 $9000 RET NC         ; Return if it is outside.
 $9001 LD A,B         ; Fetch the flag for the axis.
 $9002 CPL            ; Invert the flag, to make a mask.
 $9003 AND (IX+$02)   ; Clear the flag in offset #N$02 of the entity.
 $9006 LD (IX+$02),A  ; Write the result back to offset #N$02.
 $9009 RET            ; Return.

; Check Obstacles
;
; Used by the routine at #R$8D77.
; .
; Checks whether an entity would hit one of the items in the room if it
; moved along each axis. This is the same as #R$8FCA, but for each of the
; items in the list for the room (see #R$7E23) whose attribute does not have
; bit 3 set. The position that the entity would move to is tested against
; a rectangle for the item. The byte at offset #N$06 of the item gives the
; left side in its top four bits (signed) and the width in its bottom four
; bits, and the byte at offset #N$07 gives the top and the height in
; the same way, all in units of four pixels. If the position is in the
; rectangle then the flag for the axis in offset #N$02 of the entity is set
; if the attribute of the item has bit 2 set, and cleared if it does not.
;
; DE The pixels to move (X in #REGe and Y in #REGd)
; IX The entity
@label=CheckObstacles
c$900A PUSH DE        ; Stash the moves on the stack.
 $900B LD A,E         ; Fetch the X move.
 $900C ADD A,(IX+$03) ; Add the X position of the entity.
 $900F LD E,A         ; Keep the new X position in #REGe.
 $9010 LD D,(IX+$04)  ; Fetch the Y position of the entity.
 $9013 LD A,$10       ; #REGa=#N$10 (the flag for the X axis).
 $9015 EX AF,AF'      ; Save the flag for the axis in #REGaf'.
 $9016 CALL $902B     ; Call #R$902B to test the position against the items for
                      ; the room.
 $9019 POP DE         ; Restore the moves from the stack.
 $901A PUSH DE        ; Stash it on the stack again.
 $901B LD E,(IX+$03)  ; Fetch the X position of the entity.
 $901E LD A,D         ; Fetch the Y move.
 $901F ADD A,(IX+$04) ; Add the Y position of the entity.
 $9022 LD D,A         ; Keep the new Y position in #REGd.
 $9023 LD A,$20       ; #REGa=#N$20 (the flag for the Y axis).
 $9025 EX AF,AF'      ; Save the flag for the axis in #REGaf'.
 $9026 CALL $902B     ; Call #R$902B to test the position against the items for
                      ; the room.
 $9029 POP DE         ; Restore the moves from the stack.
 $902A RET            ; Return.
; Test the position against the items for the room.
@label=CheckObstacles_Position
*$902B LD C,(IX+$01)  ; Fetch the room of the entity.
 $902E LD B,$00       ; Clear the high byte of the room number.
 $9030 LD HL,$757D    ; #REGhl=#N$757D (the start of the lists of items for the
                      ; rooms).
 $9033 SLA C          ; {Double #REGbc, as there are two bytes for each room.
 $9035 RL B           ; }
 $9037 ADD HL,BC      ; Find the entry for the room in the table of item lists.
 $9038 LD C,(HL)      ; Fetch the low byte of the address of the list.
 $9039 INC HL         ; Move #REGhl on to the high byte.
 $903A LD B,(HL)      ; Fetch the high byte of the address of the list.
@label=CheckObstacles_Next
*$903B LD A,(BC)      ; Fetch the low byte of the address of the item.
 $903C INC BC         ; Move #REGbc on to the next byte.
 $903D LD L,A         ; Keep the low byte of the address of the item in #REGl.
 $903E LD A,(BC)      ; Fetch the high byte of the address of the item.
 $903F INC BC         ; Move #REGbc on to the next entry in the list.
 $9040 LD H,A         ; Keep the high byte of the address of the item in #REGh.
 $9041 OR L           ; {Return if the address of the item is zero, which is the end of the
 $9042 RET Z          ; list.}
 $9043 PUSH BC        ; Stash the list pointer on the stack.
 $9044 LD BC,$757D    ; #REGbc=#N$757D.
 $9047 AND A          ; {Subtract #REGbc from #REGhl to get the address of the
 $9048 SBC HL,BC      ; live record.}
 $904A INC HL         ; Move #REGhl on to the room of the item.
 $904B LD A,(HL)      ; Fetch the room of the item.
 $904C CP (IX+$01)    ; Compare it with the room of the entity.
 $904F JR Z,$9055     ; Jump to #R$9055 if they are the same.
 $9051 LD BC,$0008    ; #REGbc=#N($0008,$04,$04) (the size of half a record).
 $9054 ADD HL,BC      ; Move #REGhl on to the second half of the record.
@label=CheckObstacles_Item
*$9055 INC HL         ; {Move #REGhl on to offset #N$03 of the item.
 $9056 INC HL         ; }
 $9057 LD C,(HL)      ; Fetch the X position of the item.
 $9058 INC HL         ; Move #REGhl on to the next byte.
 $9059 LD B,(HL)      ; Fetch the Y position of the item.
 $905A INC HL         ; Move #REGhl on to the next byte.
 $905B LD A,(HL)      ; Fetch the attribute of the item.
 $905C INC HL         ; Move #REGhl on to the next byte.
 $905D BIT 2,A        ; {Jump to #R$909B if bit 2 of the attribute is set.
 $905F JR NZ,$909B    ; }
 $9061 BIT 3,A        ; {Jump to #R$9098 if bit 3 of the attribute is set.
 $9063 JR NZ,$9098    ; }
; The item lets the entity through if the position is inside the
; rectangle, so clear the flag.
 $9065 LD A,(HL)      ; #REGa=offset #N$06 of the item (the left side and the
                      ; width).
 $9066 SRA A          ; {Shift #REGa right twice, keeping the sign.
 $9068 SRA A          ; }
 $906A AND %11111100  ; Keep only bits 2-7.
 $906C ADD A,C        ; Add the X position of the item.
 $906D SUB E          ; Subtract the new X position of the entity.
 $906E NEG            ; Negate the result, to get the distance from the left
                      ; side.
 $9070 LD C,A         ; Keep the distance from the left in #REGc.
 $9071 LD A,(HL)      ; Fetch offset #N$06 of the item.
 $9072 RLCA           ; {Rotate #REGa left twice.
 $9073 RLCA           ; }
 $9074 AND %00111100  ; Keep only bits 2-5 (the width).
 $9076 INC HL         ; Move #REGhl on to offset #N$07 of the item.
 $9077 CP C           ; {Jump to #R$9098 if the position is not inside the
 $9078 JR C,$9098     ; item.}
 $907A LD A,(HL)      ; #REGa=offset #N$07 of the item (the top and the
                      ; height).
 $907B SRA A          ; {Shift #REGa right twice, keeping the sign.
 $907D SRA A          ; }
 $907F AND %11111100  ; Keep only bits 2-7.
 $9081 ADD A,B        ; Add the Y position of the item.
 $9082 SUB D          ; Subtract the new Y position of the entity.
 $9083 LD B,A         ; Keep the distance from the top in #REGb.
 $9084 LD A,(HL)      ; Fetch offset #N$07 of the item.
 $9085 INC HL         ; Move #REGhl on to the next byte.
 $9086 RLCA           ; {Rotate #REGa left twice.
 $9087 RLCA           ; }
 $9088 AND %00111100  ; Keep only bits 2-5 (the height).
 $908A CP B           ; {Jump to #R$9098 if the position is not inside the
 $908B JR C,$9098     ; item.}
 $908D EX AF,AF'      ; Swap #REGaf and #REGaf' to get the flag.
 $908E LD C,A         ; Keep the flag for the axis in #REGc.
 $908F EX AF,AF'      ; Swap #REGaf and #REGaf' back again.
 $9090 LD A,C         ; Fetch the flag for the axis.
 $9091 CPL            ; Invert the flag, to make a mask.
 $9092 AND (IX+$02)   ; Clear the flag in offset #N$02 of the entity.
@label=CheckObstacles_SetFlags
*$9095 LD (IX+$02),A  ; Write #REGa to offset #N$02 of the entity.
@label=CheckObstacles_Skip
*$9098 POP BC         ; Restore the list pointer from the stack.
 $9099 JR $903B       ; Jump back to #R$903B to look at the next item.
; The item blocks the entity if the position is inside the rectangle, so
; set the flag.
@label=CheckObstacles_Solid
*$909B LD A,(HL)      ; #REGa=offset #N$06 of the item (the left side and the
                      ; width).
 $909C SRA A          ; {Shift #REGa right twice, keeping the sign.
 $909E SRA A          ; }
 $90A0 AND %11111100  ; Keep only bits 2-7.
 $90A2 ADD A,C        ; Add the X position of the item.
 $90A3 SUB E          ; Subtract the new X position of the entity.
 $90A4 NEG            ; Negate the result, to get the distance from the left
                      ; side.
 $90A6 LD C,A         ; Keep the distance from the left in #REGc.
 $90A7 LD A,(HL)      ; Fetch offset #N$06 of the item.
 $90A8 RLCA           ; {Rotate #REGa left twice.
 $90A9 RLCA           ; }
 $90AA AND %00111100  ; Keep only bits 2-5 (the width).
 $90AC INC HL         ; Move #REGhl on to offset #N$07 of the item.
 $90AD CP C           ; {Jump to #R$9098 if the position is not inside the
 $90AE JR C,$9098     ; item.}
 $90B0 LD A,(HL)      ; #REGa=offset #N$07 of the item (the top and the
                      ; height).
 $90B1 SRA A          ; {Shift #REGa right twice, keeping the sign.
 $90B3 SRA A          ; }
 $90B5 AND %11111100  ; Keep only bits 2-7.
 $90B7 ADD A,B        ; Add the Y position of the item.
 $90B8 SUB D          ; Subtract the new Y position of the entity.
 $90B9 LD B,A         ; Keep the distance from the top in #REGb.
 $90BA LD A,(HL)      ; Fetch offset #N$07 of the item.
 $90BB INC HL         ; Move #REGhl on to the next byte.
 $90BC RLCA           ; {Rotate #REGa left twice.
 $90BD RLCA           ; }
 $90BE AND %00111100  ; Keep only bits 2-5 (the height).
 $90C0 CP B           ; {Jump to #R$9098 if the position is not inside the
 $90C1 JR C,$9098     ; item.}
 $90C3 EX AF,AF'      ; Swap #REGaf and #REGaf' to get the flag.
 $90C4 LD C,A         ; Keep the flag for the axis in #REGc.
 $90C5 EX AF,AF'      ; Swap #REGaf and #REGaf' back again.
 $90C6 LD A,C         ; Fetch the flag for the axis.
 $90C7 OR (IX+$02)    ; Set the flag in offset #N$02 of the entity.
 $90CA JR $9095       ; Jump to #R$9095 to set the flags of the entity.

; Check Player In Range
;
; Used by the routines at #R$91F2, #R$9222 and #R$9731.
; .
; Checks whether the player is close to the entity of a door. It is only
; checked when the player is a character and the bottom four bits of offset
; #N$02 of the player are zero. The player is in range when it is to the right
; of the position of the entity by less than the range along the X axis, and
; above it by less than the range along the Y axis. The range along the X axis
; is halved if the attribute of the entity is bright, and the range along the
; Y axis is halved if it is not.
;
;   B The range along the Y axis
;   C The range along the X axis
;   IX The entity
; O:F The carry flag is set if the player is in range
@label=CheckPlayerInRange
c$90CC LD A,($EA92)   ; Fetch offset #N$02 of the player.
 $90CF AND %00001111  ; Keep only bits 0-3.
 $90D1 RET NZ         ; Return if they are not all zero.
 $90D2 LD A,($EA90)   ; Fetch the sprite ID of the player from #R$EA90.
 $90D5 DEC A          ; Subtract one to get the ID that starts at zero.
 $90D6 CP $30         ; {Return if the player is not a character.
 $90D8 RET NC         ; }
 $90D9 BIT 6,(IX+$05) ; {Jump to #R$90E1 if the attribute of the entity is not
 $90DD JR Z,$90E1     ; bright.}
 $90DF SRL C          ; Halve the range along the X axis.
@label=CheckPlayerInRange_X
*$90E1 LD A,($EA93)   ; Fetch the X position of the player from #N$EA93.
 $90E4 SUB (IX+$03)   ; Subtract the X position of the entity.
 $90E7 CP C           ; {Return if the player is not in range.
 $90E8 RET NC         ; }
 $90E9 BIT 6,(IX+$05) ; {Jump to #R$90F1 if the attribute of the entity is
 $90ED JR NZ,$90F1    ; bright.}
 $90EF SRL B          ; Halve the range along the Y axis.
@label=CheckPlayerInRange_Y
*$90F1 LD A,($EA94)   ; Fetch the Y position of the player from #N$EA94.
 $90F4 SUB (IX+$04)   ; Subtract the Y position of the entity.
 $90F7 NEG            ; Negate the result.
 $90F9 CP B           ; Compare it with the range.
 $90FA RET            ; Return.

; Check Player Touching
;
; Used by the routines at #R$8C63, #R$92F5 and #R$988B.
; .
; Checks whether the player is touching an entity. The player is touching
; it when it is less than #N$0C pixels away on both axes.
;
;   IX The entity
; O:F The carry flag is set if the player is touching the entity
@label=CheckPlayerTouching
c$90FB LD A,($EA93)  ; Fetch the X position of the player from #N$EA93.
 $90FE SUB (IX+$03)  ; Subtract the X position of the entity.
 $9101 JP P,$9106    ; Jump to #R$9106 if the result is positive.
 $9104 NEG           ; Make the result positive.
@label=CheckPlayerTouching_X
*$9106 CP $0C        ; {Return if the player is too far away on the X axis.
 $9108 RET NC        ; }
 $9109 LD A,($EA94)  ; Fetch the Y position of the player from #N$EA94.
 $910C SUB (IX+$04)  ; Subtract the Y position of the entity.
 $910F JP P,$9114    ; Jump to #R$9114 if the result is positive.
 $9112 NEG           ; Make the result positive.
@label=CheckPlayerTouching_Y
*$9114 CP $0C        ; Compare it with #N$0C.
 $9116 RET           ; Return.

; Enter Door
;
; Used by the routines at #R$91F2, #R$9244 and #R$9731.
; .
; Moves the player through the door that has been entered, to the room on
; the other side. The entity for the other half of the door is found with
; #R$9286. The room, the position, and the velocity of the player (from
; #R$986A) are set from it. The player is flagged as being in a doorway (the
; bottom four bits of offset #N$02 are set), and this carries on into
; #R$9147 to draw the room.
;
; IX The entity of the door
@label=EnterDoor
c$9117 CALL $9286     ; Call #R$9286 to point #REGix at the other half of the
                      ; door.
 $911A LD A,(IX+$01)  ; Fetch the room of the other half of the door.
 $911D LD ($EA91),A   ; Update the room of the player in #R$EA91.
 $9120 LD A,(IX+$02)  ; Fetch offset #N$02 of the door.
 $9123 RLCA           ; Rotate #REGa left.
 $9124 AND %00011110  ; Keep only bits 1-4.
 $9126 ADD A,(IX+$03) ; Add the X position of the door.
 $9129 LD ($EA93),A   ; Update the X position of the player.
 $912C LD A,(IX+$02)  ; Fetch offset #N$02 of the door.
 $912F RRCA           ; {Rotate #REGa right three times.
 $9130 RRCA           ;
 $9131 RRCA           ; }
 $9132 AND %00011110  ; Keep only bits 1-4.
 $9134 NEG            ; Make the offset negative.
 $9136 ADD A,(IX+$04) ; Add the Y position of the door.
 $9139 LD ($EA94),A   ; Update the Y position of the player.
 $913C CALL $986A     ; Call #R$986A to set the velocity of the player to move out of the
                      ; door.
 $913F LD A,($EA92)   ; Fetch offset #N$02 of the player.
 $9142 OR %00001111   ; Set bits 0-3.
 $9144 LD ($EA92),A   ; Update offset #N$02 of the player.

; Enter Room
;
; Used by the routine at #R$7D9A.
; .
; Enters the room held in #R$EA91: records the visit, clears the play
; area and draws the room frame, the side panel attributes and the
; inventory. Then jumps to the main loop.
@label=EnterRoom
c$9147 LD A,($EA91)  ; Fetch the room of the player from #R$EA91.
 $914A CALL $96AF    ; Call #R$96AF to mark the room as visited.
 $914D CALL $8093    ; Call #R$8093 to clear the play area.
 $9150 CALL $9BEA    ; Call #R$9BEA to draw the frame of the room.
 $9153 CALL $A240    ; Call #R$A240 to set the attributes of the side panel.
 $9156 CALL $A13B    ; Call #R$A13B to draw the inventory.
 $9159 CALL $A403    ; Call #R$A403 to play the sound for entering a room.
 $915C JP $7DC3      ; Jump to #R$7DC3 to run the main loop.

; Handle Door Open
;
; The handler for the doors that are open (sprite IDs #N$21 and #N$23 in
; #R$802A) and that close after a time, as made by #R$94F5. On every other frame
; (when bit 0 of #R$5E12 is reset) the door timer at #R$5E2E is counted down.
; When it has reached zero, and the player is not in a doorway (see #R$957D),
; #R$9193 closes the door. Otherwise the door is just checked for being used as
; an exit (see #R$91F2).
;
; IX The door entity
@label=HandlerDoorOpen
c$915F LD A,($5E12)  ; Fetch the counter from #R$5E12.
 $9162 AND %00000001 ; Keep only bit 0.
 $9164 JP NZ,$91F2   ; Jump to #R$91F2 on every other frame.
 $9167 LD A,($5E2E)  ; Fetch the door timer from #R$5E2E.
 $916A AND A         ; Test whether the door timer is zero.
 $916B JR Z,$9174    ; Jump to #R$9174 if it is.
 $916D DEC A         ; Decrease the door timer by one.
 $916E LD ($5E2E),A  ; Update the door timer in #R$5E2E.
 $9171 JP $91F2      ; Jump to #R$91F2 to handle the exit of the door.
@label=HandlerDoorOpen_CheckDoorway
*$9174 LD A,($5E2D)  ; Fetch the doorway flag from #R$5E2D.
 $9177 AND A         ; Test whether the player is in a doorway.
 $9178 JP NZ,$91F2   ; Jump to #R$91F2 if the player is.
 $917B JR $9193      ; Jump to #R$9193 to restart the door timer and toggle both halves of
                     ; the door.

; Handle Door Closed
;
; The handler for the doors that are closed (sprite IDs #N$20 and #N$22 in
; #R$802A) and that open after a time, as made by #R$94F5. This is the same as
; #R$915F, except that the door is shown (see #R$91FE) instead of being used
; as an exit, there is no check for the player being in a doorway, and #R$9193
; opens the door.
;
; IX The door entity
@label=HandlerDoorClosed
c$917D LD A,($5E12)  ; Fetch the counter from #R$5E12.
 $9180 AND %00000001 ; Keep only bit 0.
 $9182 JP NZ,$91FE   ; Jump to #R$91FE on every other frame.
 $9185 LD A,($5E2E)  ; Fetch the door timer from #R$5E2E.
 $9188 AND A         ; Test whether the door timer is zero.
 $9189 JP Z,$9193    ; Jump to #R$9193 if it is.
; See #POKE(allow_doors_to_open_quickly,Allow Doors To Open Quickly).
 $918C DEC A         ; Decrease the door timer by one.
 $918D LD ($5E2E),A  ; Update the door timer in #R$5E2E.
 $9190 JP $91FE      ; Jump to #R$91FE to handle a room item that does nothing.
; This entry point is used by the routine at #R$915F.
; .
; Restart the door timer, and change both halves of the door from open to
; closed or the other way round. The door is erased and drawn again with a
; temporary attribute.
@label=HandlerDoor_Toggle
*$9193 LD A,$5E      ; {Restart the door timer by writing #N$5E to #R$5E2E.
 $9195 LD ($5E2E),A  ; }
 $9198 LD A,(IX+$05) ; Fetch the attribute of the door.
 $919B PUSH AF       ; Stash it on the stack.
 $919C OR %00000011  ; Set bits 0-1, which is temporary.
 $919E LD (IX+$05),A ; Update the attribute of the door.
 $91A1 CALL $9213    ; Call #R$9213 to erase the door.
 $91A4 LD A,(IX+$00) ; Fetch the sprite ID of the door.
 $91A7 XOR %00000001 ; Flip bit 0, which changes the door from open to closed or the
                     ; other way round.
 $91A9 CALL $9260    ; Call #R$9260 to write #REGa to both halves of the door.
 $91AC CALL $9213    ; Call #R$9213 to draw the door.
 $91AF POP AF        ; Restore the attribute of the door from the stack.
 $91B0 LD (IX+$05),A ; Write it to the attribute of the door.
 $91B3 CALL $9546    ; Call #R$9546 to set whether the doorway can be used.
 $91B6 CALL $91FE    ; Call #R$91FE to handle a room item that does nothing.
 $91B9 JP $A46E      ; Jump to #R$A46E to make the sound of a door.

; Handle Trap Closed
;
; The handler for a trapdoor that is closed (sprite ID #N$18). It is
; opened by #R$91CC when the counter in #R$5E12 is zero.
;
; IX The trapdoor entity
@label=HandlerTrapClosed
c$91BC LD A,($5E12)  ; Fetch the counter from #R$5E12.
 $91BF AND A         ; Test whether the counter is zero.
 $91C0 JP NZ,$91FE   ; Jump to #R$91FE if it is not.
 $91C3 JR $91CC      ; Jump to #R$91CC to toggle the trapdoor between open and
                     ; closed.

; Handle Trap Open
;
; The handler for a trapdoor that is open (sprite ID #N$19). If the
; low byte of the random number seed at #R$5E05 is not zero then the trapdoor
; is used by #R$9731. Otherwise #R$91CC closes it.
;
; IX The trapdoor entity
@label=HandlerTrapOpen
c$91C5 LD A,($5E05)  ; Fetch the random seed from #R$5E05.
 $91C8 AND A         ; Test whether it is zero.
 $91C9 JP NZ,$9731   ; Jump to #R$9731 if it is not.
; This entry point is used by the routine at #R$91BC.
; .
; Change the trapdoor from open to closed or the other way round. It is
; erased and drawn again with a temporary attribute.
@label=HandlerTrap_Toggle
*$91CC LD A,(IX+$05) ; Fetch the attribute of the trapdoor.
 $91CF PUSH AF       ; Stash it on the stack.
 $91D0 OR %00000011  ; Set bits 0-1, which is temporary.
 $91D2 LD (IX+$05),A ; Update the attribute of the trapdoor.
 $91D5 CALL $9213    ; Call #R$9213 to erase the trapdoor.
 $91D8 LD A,(IX+$00) ; Fetch the sprite ID of the trapdoor.
 $91DB XOR %00000001 ; Flip bit 0, which changes the trapdoor from open to closed or
                     ; the other way round.
 $91DD LD (IX+$00),A ; Update the sprite ID of the trapdoor.
 $91E0 CALL $9213    ; Call #R$9213 to draw the trapdoor.
 $91E3 POP AF        ; Restore the attribute of the trapdoor from the stack.
 $91E4 LD (IX+$05),A ; Write it to the attribute of the trapdoor.
 $91E7 CALL $91FE    ; Call #R$91FE to handle a room item that does nothing.
 $91EA JP $A46E      ; Jump to #R$A46E to make the sound of a door.

; Handle Big Door Exit
;
; The handler for the doors that are bigger than normal (sprite ID #N$03),
; which the player goes through from a greater distance than #R$91F2.
;
; IX The door entity
@label=HandlerDoorBigExit
c$91ED LD BC,$2020   ; #REGbc=#N($2020,$04,$04) (the range of the door).
 $91F0 JR $91F5      ; Jump to #R$91F5 to check whether the player is in range
                     ; of the door.

; Handle Door Exit
;
; Used by the routines at #R$915F and #R$942F.
; .
; The handler for the doors that are always open (sprite IDs #N$01 and
; #N$02 in #R$802A). It uses #R$90CC to check whether
; the player is in range of the door, and then #R$9117 takes them through it.
; Whether or not they do, the door is then shown by #R$91FE.
;
; IX The door entity
@label=HandlerDoorExit
c$91F2 LD BC,$1111   ; #REGbc=#N($1111,$04,$04) (the range of the door).
; This entry point is used by the routines at #R$91ED and #R$961B.
@label=HandlerDoorExit_Check
*$91F5 CALL $90CC    ; Call #R$90CC to see whether the player is in range of
                     ; the door.
 $91F8 CALL C,$9117  ; Call #R$9117 if the player is in range.
 $91FB JP $91FE      ; Jump to #R$91FE to handle a room item that does nothing.

; Handle Room Item
;
; Used by the routines at #R$917D, #R$91BC, #R$91C5, #R$91F2, #R$9244, #R$9252,
; #R$942F, #R$961B and #R$9731.
; .
; The handler for the items in a room that do nothing. The attributes of
; the cells that it covers are set by #R$9980 every time, but the graphic is
; only drawn (by #R$9213) when #R$5E14 is zero.
;
; IX The item entity
@label=HandlerRoomItem
c$91FE LD E,(IX+$03) ; Fetch the X position of the item.
 $9201 LD D,(IX+$04) ; Fetch the Y position of the item.
 $9204 DEC D         ; Move up one pixel.
 $9205 LD C,(IX+$00) ; Fetch the graphic of the item.
 $9208 LD B,(IX+$05) ; Fetch the attribute of the item.
 $920B CALL $9980    ; Call #R$9980 to set the attributes.
 $920E LD A,($5E14)  ; Fetch the game flags from #R$5E14.
 $9211 AND A         ; Test whether any of the game flags are set.
 $9212 RET NZ        ; Return if they are.
; Continue on to #R$9213.

; Draw Item Graphic
;
; Used by the routines at #R$8B8A, #R$917D and #R$91C5.
; .
; Draws the graphic of an entity at its position, using #R$9962.
;
; IX The entity
@label=DrawItemGraphic
c$9213 LD E,(IX+$03) ; Fetch the X position of the entity.
 $9216 LD D,(IX+$04) ; Fetch the Y position of the entity.
 $9219 LD C,(IX+$00) ; Fetch the graphic of the entity.
 $921C LD B,(IX+$05) ; Fetch the attribute of the entity.
 $921F JP $9962      ; Jump to #R$9962 to draw the graphic.

; Check Door Key
;
; Used by the routines at #R$9244 and #R$9252.
; .
; Checks whether the player has the key for a locked door. The colour of
; the key that is needed is found in #R$925C using bits 0-1 of the sprite ID of
; the door. If the player has it, then the doorway is opened by #R$954D and
; the player is checked for being in range of the door by #R$90CC. If the
; player does not have the key then the doorway is closed by #R$9565.
;
;   IX The locked door entity
; O:F The carry flag is set if the player has the key and is in range
@label=CheckDoorKey
c$9222 LD A,(IX+$00) ; Fetch the sprite ID of the door.
 $9225 AND %00000011 ; Keep only bits 0-1.
 $9227 LD HL,$925C   ; Point #REGhl at the door key colours at #R$925C.
 $922A CALL $926C    ; Call #R$926C to find the key that is needed in the
                     ; table.
 $922D LD D,(HL)     ; Fetch the attribute of the key that is needed.
 $922E LD E,$81      ; #REGe=#N$81 (the sprite ID of the key).
 $9230 CALL $9273    ; Call #R$9273 to look for the key in the inventory.
 $9233 JP NZ,$923F   ; Jump to #R$923F if the player does not have it.
 $9236 CALL $954D    ; Call #R$954D to open the doorway.
 $9239 LD BC,$1111   ; #REGbc=#N($1111,$04,$04) (the range of the door).
 $923C JP $90CC      ; Jump to #R$90CC to check whether the player is in range
                     ; of the door.
@label=CheckDoorKey_NoKey
*$923F CALL $9565    ; Call #R$9565 to close the doorway.
 $9242 AND A         ; Clear the carry flag.
 $9243 RET           ; Return.

; Handle Door Locked
;
; The handler for the locked doors (sprite IDs #N$08 to #N$0B). When the
; player has the key and is in range of the door, both halves of the door
; become exits (sprite ID #N$02, see #R$91F2) and the player goes through
; it with #R$9117. The door is otherwise shown by #R$91FE.
;
; IX The door entity
@label=HandlerDoorLocked
c$9244 CALL $9222    ; Call #R$9222 to see whether the player has the key.
 $9247 JP NC,$91FE   ; Jump to #R$91FE if not.
 $924A LD A,$02      ; #REGa=#N$02 (the sprite ID of an unlocked door).
; This entry point is used by the routine at #R$9252.
@label=HandlerDoorLocked_Unlock
*$924C CALL $9260    ; Call #R$9260 to unlock both halves of the door.
 $924F JP $9117      ; Jump to #R$9117 to enter the door.

; Handle Cave Door Locked
;
; The handler for the locked cave doors (sprite IDs #N$0C to #N$0F). This
; is the same as #R$9244, but the doors become sprite ID #N$01.
;
; IX The door entity
@label=HandlerCaveDoorLocked
c$9252 CALL $9222    ; Call #R$9222 to see whether the player has the key.
 $9255 JP NC,$91FE   ; Jump to #R$91FE if not.
 $9258 LD A,$01      ; #REGa=#N$01 (the sprite ID of an unlocked cave door).
 $925A JR $924C      ; Jump to #R$924C to unlock the door.

; Door Key Colours
;
; The attribute of the key that is needed for each of the four colours of
; locked door. See #R$9222.
; #TABLE(default,centre,left)
; { =h Door | =h Key }
; { #N$00 | #COLOUR$42 }
; { #N$01 | #COLOUR$44 }
; { #N$02 | #COLOUR$45 }
; { #N$03 | #COLOUR$46 }
; TABLE#
@label=DoorKeyColours
b$925C DEFB $42
 $925D DEFB $44
 $925E DEFB $45
 $925F DEFB $46

; Set Door Sprites
;
; Used by the routines at #R$917D and #R$9244.
; .
; Writes a sprite ID to both halves of a door.
;
; A The sprite ID
; IX The door entity
@label=SetDoorSprites
c$9260 PUSH IX       ; {Copy #REGix into #REGhl, as the address of this half of
 $9262 POP HL        ; the door.}
 $9263 LD (HL),A     ; Update the sprite ID of this half of the door.
 $9264 EX AF,AF'     ; Hold the sprite ID in #REGaf'.
 $9265 LD A,L        ; Fetch the low byte of the address of this half.
 $9266 XOR %00001000 ; Flip bit 3, to get the address of the other half of the
                     ; door.
 $9268 LD L,A        ; Keep the address of the other half of the door in #REGl.
 $9269 EX AF,AF'     ; Fetch the sprite ID from #REGaf'.
 $926A LD (HL),A     ; Update the sprite ID of the other half of the door.
 $926B RET           ; Return.

; Add A To HL
;
; Used by the routines at #R$9222 and #R$A00E.
; .
; Adds the byte in #REGa to #REGhl.
;
;   A The value to add
;   HL The address
; O:HL The address plus #REGa
@label=AddAToHL
c$926C ADD A,L       ; Add the low byte of the address to the value.
 $926D LD L,A        ; Keep the new low byte in #REGl.
 $926E LD A,H        ; Fetch the high byte of the address.
 $926F ADC A,$00     ; Add the carry.
 $9271 LD H,A        ; Keep the new high byte in #REGh.
 $9272 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #CYBERUN$9BCF }
; { #NIGHTSHADE$E596 }
; { #PENTAGRAM$B519 }
; LIST#

; Find Inventory Item
;
; Used by the routines at #R$8906, #R$8988 and #R$9222.
; .
; Looks for an item in the three slots of the inventory (see #R$5E30). The
; sprite ID and the attribute of the item are at offsets #N$02 and #N$03 of
; each slot.
;
;   D The attribute of the item
;   E The sprite ID of the item
; O:F The Z flag is set if the player has the item
@label=FindInventoryItem
c$9273 LD B,$03      ; #REGb=#N$03 (the number of slots in the inventory).
 $9275 LD HL,$5E32   ; Point #REGhl at the sprite ID of the first slot at
                     ; #R$5E32.
@label=FindInventoryItem_Loop
*$9278 LD A,(HL)     ; Fetch the sprite ID of the slot.
 $9279 CP E          ; Is it the sprite ID of the item?
 $927A INC HL        ; Move #REGhl on to the attribute of the slot.
 $927B JR NZ,$9280   ; Jump to #R$9280 if they are different.
 $927D LD A,(HL)     ; Fetch the attribute of the slot.
 $927E CP D          ; {Return if the attribute matches too, as the player has
 $927F RET Z         ; the item.}
@label=FindInventoryItem_Next
*$9280 INC HL        ; {Move #REGhl on to the next slot.
 $9281 INC HL        ;
 $9282 INC HL        ; }
 $9283 DJNZ $9278    ; Decrease the slot counter by one and loop back to #R$9278 until all
                     ; three slots have been checked.
 $9285 RET           ; Return.

; Get Other Door Half
;
; Used by the routines at #R$9117, #R$954D and #R$9565.
; .
; A door is held as two 8-byte entities, one for each of the two rooms
; that it joins, and these are #N$08 bytes apart with one of them on an
; address that has bit 3 reset. This flips bit 3 of #REGix to get the other.
;
;   IX One half of the door
; O:IX The other half of the door
@label=GetOtherDoorHalf
c$9286 PUSH IX       ; {Copy #REGix into #REGhl.
 $9288 POP HL        ; }
 $9289 LD A,L        ; Fetch the low byte of the address of this half.
 $928A XOR %00001000 ; Flip bit 3.
 $928C LD L,A        ; Keep the address of the other half of the door in #REGl.
 $928D PUSH HL       ; {Copy #REGhl into #REGix, as the other half of the door.
 $928E POP IX        ; }
 $9290 RET           ; Return.

; Draw Room Entities
;
; Used by the routine at #R$7E23.
; .
; Draws every entity that is in the same room as the player and is in use.
; First the 8-byte entities from #R$EA90 up to #R$EE60 are done, and then
; the 16-byte ones up to #R$EEE0.
@label=DrawRoomEntities
c$9291 LD IX,$EA90   ; Point #REGix at the player at #R$EA90.
@label=DrawRoomEntities_Loop
*$9295 LD A,(IX+$00) ; Fetch the sprite ID of the entity.
 $9298 AND A         ; {Jump to #R$92A6 if the entity is not in use.
 $9299 JR Z,$92A6    ; }
 $929B LD A,($EA91)  ; Fetch the room of the player from #R$EA91.
 $929E CP (IX+$01)   ; {Jump to #R$92A6 if the entity is in a different room.
 $92A1 JR NZ,$92A6   ; }
 $92A3 CALL $9F4A    ; Call #R$9F4A to draw the entity.
@label=DrawRoomEntities_Next
*$92A6 LD DE,$0008   ; #REGde=#N($0008,$04,$04) (the size of an 8-byte entity).
 $92A9 ADD IX,DE     ; Move #REGix on to the next entity.
 $92AB PUSH IX       ; {Copy #REGix into #REGhl.
 $92AD POP HL        ; }
 $92AE LD DE,$EE60   ; Point #REGde at the end of the 8-byte entities at
                     ; #R$EE60.
 $92B1 AND A         ; {Subtract #REGde from #REGhl, to check whether all of the 8-byte
 $92B2 SBC HL,DE     ; entities have been done.}
 $92B4 JR C,$9295    ; Loop back to #R$9295 until all of the 8-byte entities have been
                     ; drawn.
@label=DrawRoomEntities_Large
*$92B6 LD A,(IX+$00) ; Fetch the sprite ID of the entity.
 $92B9 AND A         ; {Jump to #R$92C7 if the entity is not in use.
 $92BA JR Z,$92C7    ; }
 $92BC LD A,($EA91)  ; Fetch the room of the player from #R$EA91.
 $92BF CP (IX+$01)   ; {Jump to #R$92C7 if the entity is in a different room.
 $92C2 JR NZ,$92C7   ; }
 $92C4 CALL $9F4A    ; Call #R$9F4A to draw the entity.
@label=DrawRoomEntities_NextLarge
*$92C7 LD DE,$0010   ; #REGde=#N($0010,$04,$04) (the size of a 16-byte entity).
 $92CA ADD IX,DE     ; Move #REGix on to the next entity.
 $92CC PUSH IX       ; {Copy #REGix into #REGhl.
 $92CE POP HL        ; }
 $92CF LD DE,$EEE0   ; Point #REGde at the end of the 16-byte entities at
                     ; #R$EEE0.
 $92D2 AND A         ; {Subtract #REGde from #REGhl, to check whether all of the 16-byte
 $92D3 SBC HL,DE     ; entities have been done.}
 $92D5 JR C,$92B6    ; Loop back to #R$92B6 until all of the 16-byte entities have been
                     ; drawn.
 $92D7 RET           ; Return.

; Clear Pickup Flag
;
; Used by the routine at #R$92F5.
; .
; Resets bit 1 of #R$5E1F, which is set while an item is being picked up,
; and then sets the colour of the item with #R$92E0.
;
; IX The item entity
@label=ClearPickupFlag
c$92D8 LD A,($5E1F)  ; Fetch the pickup flags from #R$5E1F.
 $92DB AND %11111101 ; Reset bit 1.
 $92DD LD ($5E1F),A  ; Update the pickup flags in #R$5E1F.

; Set Item Attributes
;
; Used by the routines at #R$8C63, #R$92F5, #R$95D7 and #R$988B.
; .
; Sets the attributes of the cells that an item covers with #R$A01A. The
; item is #N$10 lines high (at #R$92E0), or the number of lines in #REGa (at
; #R$92E2), and it is two bytes wide or three if it is not on a multiple of
; eight pixels across.
;
; IX The item entity
@label=SetItemAttributes
c$92E0 LD A,$10      ; #REGa=#N$10 (the height of the item in lines).
; This entry point is used by the routine at #R$8CB7.
@label=SetItemAttributes_Lines
*$92E2 LD ($5E11),A  ; Update the sprite height in #R$5E11.
 $92E5 LD A,(IX+$03) ; Fetch the X position of the item.
 $92E8 AND %00000111 ; Keep only bits 0-2.
 $92EA LD A,$02      ; #REGa=#N$02 (the width of the item in bytes).
 $92EC JR Z,$92EF    ; Jump to #R$92EF if the X position is a multiple of
                     ; eight.
 $92EE INC A         ; #REGa=#N$03 (the item is one byte wider, as it straddles another
                     ; cell).
@label=SetItemAttributes_Width
*$92EF LD ($5E10),A  ; Update the sprite width in #R$5E10.
 $92F2 JP $A01A      ; Jump to #R$A01A to set the attributes of the item.

; Handle Pickup Item
;
; The handler for the items that the player can pick up (sprite IDs
; #N$80 to #N$8E). If the pick up key is not pressed then #R$92D8 clears the
; flag for it. Otherwise nothing is done if another item has just been picked
; up (bits 0-1 of #R$5E1F), or if the player is not a character, or if the
; player is not touching the item (see #R$90FB). If they are, the flags are
; set, the item that has been carried the longest is dropped (see #R$9358),
; the others move along (see #R$934C), the item is picked up (see #R$9326)
; and the inventory is drawn by #R$A13B.
;
; IX The item entity
@label=HandlerPickupItem
c$92F5 CALL $9FFB    ; Call #R$9FFB to save the position of the item.
 $92F8 LD A,($5E20)  ; Fetch the pickup pressed flag from #R$5E20.
 $92FB AND A         ; {Jump to #R$92D8 if the pick up key is not pressed.
 $92FC JR Z,$92D8    ; }
 $92FE LD A,($5E1F)  ; Fetch the pickup flags from #R$5E1F.
 $9301 AND %00000011 ; Keep only bits 0-1.
 $9303 JR NZ,$92E0   ; Jump to #R$92E0 if an item has just been picked up.
 $9305 LD A,($EA90)  ; Fetch the sprite ID of the player from #R$EA90.
 $9308 DEC A         ; Subtract one to get the ID that starts at zero.
 $9309 CP $30        ; {Jump to #R$92E0 if the player is not a character.
 $930B JR NC,$92E0   ; }
 $930D CALL $90FB    ; Call #R$90FB to see whether the player is touching the
                     ; item.
 $9310 JR NC,$92E0   ; Jump to #R$92E0 if not.
 $9312 LD A,($5E1F)  ; Fetch the pickup flags from #R$5E1F.
 $9315 OR %00000011  ; Set bits 0-1.
 $9317 LD ($5E1F),A  ; Update the pickup flags in #R$5E1F.
 $931A CALL $9358    ; Call #R$9358 to drop the third item.
 $931D CALL $934C    ; Call #R$934C to move the other items along.
 $9320 CALL $9326    ; Call #R$9326 to pick up the item.
 $9323 JP $A13B      ; Jump to #R$A13B to draw the inventory.

; Pick Up Item
;
; Used by the routine at #R$92F5.
; .
; Puts an item in the first slot of the inventory (see #R$5E30) and takes
; it off the screen. A slot is the address of the entity (two bytes), the
; sprite ID and the attribute.
;
; IX The item entity
@label=PickUpItem
c$9326 LD HL,$5E30     ; Point #REGhl at the first inventory slot at #R$5E30.
 $9329 PUSH IX         ; {Copy #REGix into #REGde, as the address of the item.
 $932B POP DE          ; }
 $932C LD (HL),E       ; Write the low byte of the address of the item to the
                       ; first slot.
 $932D INC HL          ; Move on to the next byte.
 $932E LD (HL),D       ; Write the high byte of the address of the item to the
                       ; first slot.
 $932F INC HL          ; Move on to the next byte.
 $9330 LD A,(IX+$00)   ; Fetch the sprite ID of the item.
 $9333 LD (HL),A       ; Write the sprite ID of the item to the first slot.
 $9334 INC HL          ; Move on to the next byte.
 $9335 LD A,(IX+$05)   ; Fetch the attribute of the item.
 $9338 LD (HL),A       ; Write the attribute of the item to the first slot.
 $9339 CALL $9F56      ; Call #R$9F56 to remove the item from the screen.
 $933C LD A,($5E1A)    ; Fetch the room attribute from #R$5E1A.
 $933F LD (IX+$05),A   ; Update the attribute of the item.
 $9342 CALL $A01A      ; Call #R$A01A to set the attributes of the cells it
                       ; covered.
 $9345 LD (IX+$00),$00 ; Write #N$00 to the sprite ID of the item, as it is not in the room
                       ; now.
 $9349 JP $A3BD        ; Jump to #R$A3BD to make the sound of picking up.

; Shift Inventory
;
; Used by the routines at #R$92F5 and #R$93E3.
; .
; Moves the first two slots of the inventory (see #R$5E30) along to be the
; second and third slots.
@label=ShiftInventory
c$934C LD HL,$5E37   ; Point #REGhl at the end of the second slot at #R$5E37.
 $934F LD DE,$5E3B   ; Point #REGde at the end of the third slot at #R$5E3B.
 $9352 LD BC,$0008   ; #REGbc=#N($0008,$04,$04) (the size of two slots).
 $9355 LDDR          ; Copy the two slots, working backwards.
 $9357 RET           ; Return.

; Drop Item
;
; Used by the routines at #R$92F5 and #R$93E3.
; .
; Puts the item in the third slot of the inventory (see #R$5E38) back into
; the room at the position of the player, and makes the sound of dropping.
; Nothing is done if the slot is empty.
@label=DropItem
c$9358 LD HL,$5E38   ; Point #REGhl at the third inventory slot at #R$5E38.
 $935B LD E,(HL)     ; Fetch the low byte of the address of the entity.
 $935C INC HL        ; Move on to the next byte.
 $935D LD D,(HL)     ; Fetch the high byte of the address of the entity.
 $935E INC HL        ; Move on to the next byte.
 $935F LD A,D        ; {Return if the slot is empty (the address of the entity
 $9360 OR E          ; is zero).
 $9361 RET Z         ; }
 $9362 PUSH DE       ; Stash the address of the entity on the stack.
 $9363 LD A,(HL)     ; Fetch the sprite ID in the slot.
 $9364 INC HL        ; Move on to the next byte.
 $9365 LD (DE),A     ; Update the sprite ID of the entity.
 $9366 INC DE        ; Move on to the room of the entity.
 $9367 LD A,($EA91)  ; Fetch the room of the player from #R$EA91.
 $936A LD (DE),A     ; Update the room of the entity.
 $936B INC DE        ; Move on to offset #N$02 of the entity.
 $936C LD A,$80      ; {Write #N$80 to offset #N$02 of the entity.
 $936E LD (DE),A     ; }
 $936F INC DE        ; Move on to the X position of the entity.
 $9370 LD A,($EA93)  ; Fetch the X position of the player from #R$EA93.
 $9373 LD (DE),A     ; Update the X position of the entity.
 $9374 INC DE        ; Move on to the Y position of the entity.
 $9375 LD A,($EA94)  ; Fetch the Y position of the player from #R$EA94.
 $9378 LD (DE),A     ; Update the Y position of the entity.
 $9379 INC DE        ; Move on to the attribute of the entity.
 $937A LD A,(HL)     ; Fetch the attribute in the slot.
 $937B LD (DE),A     ; Update the attribute of the entity.
 $937C POP DE        ; Restore the address of the entity from the stack.
 $937D CALL $A3C2    ; Call #R$A3C2 to make the sound of dropping.
 $9380 PUSH IX       ; Stash #REGix on the stack.
 $9382 PUSH DE       ; {Copy #REGde into #REGix, as the entity to draw.
 $9383 POP IX        ; }
 $9385 CALL $9F4A    ; Call #R$9F4A to draw the entity.
 $9388 POP IX        ; Restore #REGix from the stack.
 $938A RET           ; Return.

; Read Pickup Key
;
; Used by the routine at #R$7E23.
; .
; Reads the key to pick up an item, which is CAPS SHIFT or SPACE, and
; Z or SYMBOL SHIFT. The result is stored in #R$5E20.
@label=ReadPickupKey
c$938B LD A,$7E      ; {Read from the keyboard;
 $938D OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $938F IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$7E | CAPS SHIFT / SPACE | Z / SYMBOL SHIFT | X / M | C / N | V / B }
                     ; TABLE#}
 $9391 CPL           ; Flip the bits, so that a set bit is a key which is
                     ; pressed.
 $9392 AND %00000010 ; Keep only bit 1.
 $9394 LD ($5E20),A  ; Update the pickup pressed flag in #R$5E20.
 $9397 RET           ; Return.

; Read Cursor Keys
;
; Used by the routine at #R$93BE.
; .
; Reads the cursor keys in the same way as the controls from #R$93BE are
; returned. Bit 0 is right (8), bit 1 is left (5), bit 2 is down (6), bit 3
; is up (7) and bit 4 is fire (0). A bit is reset when the key is pressed.
;
; O:A The state of the keys
@label=ReadCursorKeys
c$9398 LD A,$EF      ; {Read from the keyboard;
 $939A OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $939C IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$EF | 0 | 9 | 8 | 7 | 6 }
                     ; TABLE#}
 $939E LD C,A        ; Keep the keys in #REGc.
 $939F AND %00001000 ; Keep only bit 3 (up).
 $93A1 LD E,A        ; Keep up in #REGe.
 $93A2 LD A,C        ; Fetch the keys.
 $93A3 RRCA          ; {Rotate #REGa right twice.
 $93A4 RRCA          ; }
 $93A5 AND %01000101 ; Keep only bits 0, 2 and 6 (right, down and fire).
 $93A7 OR E          ; Combine right, down and fire with up.
 $93A8 LD E,A        ; Keep the keys so far in #REGe.
 $93A9 RRCA          ; {Rotate #REGa right twice, which moves fire to bit 4.
 $93AA RRCA          ; }
 $93AB AND %00010000 ; Keep only bit 4.
 $93AD OR E          ; Combine fire with the keys so far.
 $93AE AND %00011111 ; Keep only bits 0-4.
 $93B0 LD E,A        ; Keep the keys so far in #REGe.
 $93B1 LD A,$F7      ; {Read from the keyboard;
 $93B3 OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $93B5 IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$F7 | 1 | 2 | 3 | 4 | 5 }
                     ; TABLE#}
 $93B7 RRA           ; {Rotate #REGa right three times, which moves left (5) to
 $93B8 RRA           ; bit 1.
 $93B9 RRA           ; }
 $93BA AND %00000010 ; Keep only bit 1.
 $93BC OR E          ; Combine left with the keys so far.
 $93BD RET           ; Return.

; Read Controls
;
; Used by the routines at #R$80D2, #R$8D77, #R$8DC4 and #R$8E26.
; .
; Reads the controls that were chosen in #R$5E00. A bit is reset when the
; control is used: bit 0 is right, bit 1 is left, bit 2 is down, bit 3 is up and
; bit 4 is fire. The keyboard uses W, Q, E, R and T, the cursor keys are read by
; #R$9398 and otherwise the Kempston joystick is read.
;
; O:A The state of the controls
@label=ReadControls
c$93BE LD A,($5E00)  ; Fetch the controls that were chosen from #R$5E00.
 $93C1 AND %00000110 ; Keep only bits 1-2.
 $93C3 JR Z,$93CD    ; Jump to #R$93CD if the keyboard is used.
 $93C5 CP $04        ; {Jump to #R$9398 if the cursor keys are used.
 $93C7 JR Z,$9398    ; }
 $93C9 IN A,($1F)    ; Read the Kempston joystick.
 $93CB CPL           ; Flip the bits, so that a reset bit is a control which is
                     ; used.
 $93CC RET           ; Return.
@label=ReadControls_Keyboard
*$93CD LD A,$FB      ; {Read from the keyboard;
 $93CF OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $93D1 IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$FB | Q | W | E | R | T }
                     ; TABLE#}
 $93D3 LD C,A        ; Keep the keys in #REGc.
 $93D4 RRA           ; Rotate #REGa right, to move W (right) to bit 0.
 $93D5 AND %00000001 ; Keep only bit 0.
 $93D7 LD E,A        ; Keep right in #REGe.
 $93D8 LD A,C        ; Fetch the keys.
 $93D9 RLA           ; Rotate #REGa left, to move Q (left) to bit 1.
 $93DA AND %00000010 ; Keep only bit 1.
 $93DC OR E          ; Combine left with right.
 $93DD LD E,A        ; Keep right and left in #REGe.
 $93DE LD A,C        ; Fetch the keys.
 $93DF AND %00011100 ; Keep only bits 2-4 (E is down, R is up and T is fire).
 $93E1 OR E          ; Combine down, up and fire with right and left.
 $93E2 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #COOKIE$6FB4 }
; { #UNDERWURLDE$AE17 }
; LIST#

; Handle Blank
;
; The handler for the entity with sprite ID #N$31, which is always
; there. While the player is a character it drops the inventory when the pick up
; key is pressed. The item in the third slot is dropped (see #R$9358), the
; other slots are moved along (see #R$934C) and the first slot is emptied.
; Bit 1 of #R$5E1F is set while the key is held down.
;
; IX The entity
;
; Return unless the player is a character.
@label=HandlerBlank
c$93E3 LD A,($EA90)  ; Fetch the sprite ID of the player from #R$EA90.
 $93E6 DEC A         ; Subtract one to get the ID that starts at zero.
 $93E7 CP $30        ; {Return if the player is not a character.
 $93E9 RET NC        ; }
; Test the pick up key.
 $93EA LD A,($5E20)  ; Fetch the pickup pressed flag from #R$5E20.
 $93ED AND A         ; {Jump to #R$9417 if the pick up key is not pressed.
 $93EE JR Z,$9417    ; }
; Skip the drop if this press has already picked up or dropped an
; item.
 $93F0 LD A,($5E1F)  ; Fetch the pickup flags from #R$5E1F.
 $93F3 AND %00000011 ; Keep only bits 0-1.
 $93F5 JR NZ,$940E   ; Jump to #R$940E if this press has already been used.
; Mark the key as used and drop the oldest item.
 $93F7 OR %00000010  ; Set bit 1.
 $93F9 LD ($5E1F),A  ; Update the pickup flags in #R$5E1F.
 $93FC CALL $9358    ; Call #R$9358 to drop the third item.
 $93FF CALL $934C    ; Call #R$934C to move the other items along.
; Empty the first slot and redraw the inventory.
 $9402 LD HL,$0000   ; {Write #N($0000,$04,$04) to the first inventory slot, as the
 $9405 LD ($5E30),HL ; address of no entity and as the sprite ID and attribute.
 $9408 LD ($5E32),HL ; }
 $940B CALL $A13B    ; Call #R$A13B to draw the inventory.
; Clear the bit that is set when an item is picked up.
@label=HandlerBlank_Finish
*$940E LD A,($5E1F)  ; Fetch the pickup flags from #R$5E1F.
 $9411 AND %11111110 ; Reset bit 0.
 $9413 LD ($5E1F),A  ; Update the pickup flags in #R$5E1F.
 $9416 RET           ; Return.
; The pick up key is up, so allow another drop on the next press.
@label=HandlerBlank_KeyUp
*$9417 LD A,($5E1F)  ; Fetch the pickup flags from #R$5E1F.
 $941A AND %11111101 ; Reset bit 1.
 $941C LD ($5E1F),A  ; Update the pickup flags in #R$5E1F.
 $941F JR $940E      ; Jump to #R$940E to finish handling the blank item.

; Handle Barrel
;
; The handler for the barrel stack, which is a secret door that only the
; serf can use. The doorway is opened by #R$954D when the player is the serf
; (sprite IDs #N$21 to #N$30), and then the door is used (see #R$91F2).
; For anyone else the doorway is closed by #R$9565 and the door is just shown
; (see #R$91FE).
;
; IX The door entity
@label=HandlerBarrel
c$9421 LD A,($EA90)  ; Fetch the sprite ID of the player from #R$EA90.
 $9424 SUB $21       ; Subtract #N$21, to make the serf's sprite IDs start at
                     ; zero.
 $9426 JR $9433      ; Jump to #R$9433 to check for the secret door.

; Handle Bookcase
;
; The handler for the bookcase, which is a secret door that only the
; wizard can use. This is the same as #R$9421 but for the sprite IDs #N$11 to
; #N$20.
;
; IX The door entity
@label=HandlerBookcase
c$9428 LD A,($EA90)  ; Fetch the sprite ID of the player from #R$EA90.
 $942B SUB $11       ; Subtract #N$11, to make the wizard's sprite IDs start at
                     ; zero.
 $942D JR $9433      ; Jump to #R$9433 to check for the secret door.

; Handle Clock
;
; The handler for the clock, which is a secret door that only the knight
; can use. This is the same as #R$9421 but for the sprite IDs #N$01 to #N$10.
;
; IX The door entity
@label=HandlerClock
c$942F LD A,($EA90)  ; Fetch the sprite ID of the player from #R$EA90.
 $9432 DEC A         ; Subtract one, to make the knight's sprite IDs start at
                     ; zero.
; This entry point is used by the routines at #R$9421 and #R$9428.
@label=HandlerSecretDoor_Check
*$9433 CP $10        ; {Jump to #R$943D if the player is not the right
 $9435 JR NC,$943D   ; character.}
 $9437 CALL $954D    ; Call #R$954D to open the doorway.
 $943A JP $91F2      ; Jump to #R$91F2 to handle the exit of the door.
@label=HandlerSecretDoor_Closed
*$943D CALL $9565    ; Call #R$9565 to close the doorway.
 $9440 JP $91FE      ; Jump to #R$91FE to handle a room item that does nothing.

; Prepare Player
;
; Used by the routines at #R$7D9A and #R$8D45.
; .
; Sets up the player entity at #R$EA90 for the start of a life. The
; template at #R$9481 is given the room that the player is in and the sprite ID
; of the character that was chosen in #R$5E00, and is then copied over the
; player. Then the timer for the player appearing is set, the player is
; drawn (unless the number of lives is #N$03), the energy is refilled, and the
; chicken and the lives are drawn.
;
; .
;
; Work out the sprite ID to use.
; #TABLE(default,centre,centre,centre,centre,centre)
; { =h Byte | =h Character | =h * #N$02 | =h Only Bits 4-5 | =h + #N$08 }
; #LET(char=$00) #LET(id=#EVAL((({char} * $02) & $30) + $08)) { #N({char}) | Knight (+ Keyboard) | #N(#EVAL({char} * $02)) | #N(#EVAL(({char} * $02) & $30)) | Sprite ID: #R($A4BC + {id} * $02)(#N({id})) }
; #LET(char=$08) #LET(id=#EVAL((({char} * $02) & $30) + $08)) { #N({char}) | Wizard (+ Kempston Joystick) | #N(#EVAL({char} * $02)) | #N(#EVAL(({char} * $02) & $30)) | Sprite ID: #R($A4BC + {id} * $02)(#N({id})) }
; #LET(char=$14) #LET(id=#EVAL((({char} * $02) & $30) + $08)) { #N({char}) | Serf (+ Cursor Joystick) | #N(#EVAL({char} * $02)) | #N(#EVAL(({char} * $02) & $30)) | Sprite ID: #R($A4BC + {id} * $02)(#N({id})) }
; TABLE#
@label=PreparePlayer
c$9443 LD A,($5E00)  ; {#REGa=#R$5E00 * #N$02.
 $9446 RLCA          ; }
 $9447 AND %00110000 ; {Keep only bits 4-5 (the base character address) + #N$08 frames
 $9449 ADD A,$08     ; (for the character direction).}
 $944B LD ($9488),A  ; Write #REGa to #R$9481(#N$9488).
; Update the current room.
 $944E LD A,($EA91)  ; {Write #R$EA91 to #R$9481(#N$9482).
 $9451 LD ($9482),A  ; }
; Copy the template over the player.
 $9454 LD HL,$9481   ; {Copy #N$08 bytes of data from #R$9481 to #R$EA90.
 $9457 LD DE,$EA90   ;
 $945A LD BC,$0008   ;
 $945D LDIR          ; }
 $945F LD A,$68      ; {Write #N$68 to #R$5E3C, the timer for the player
 $9461 LD ($5E3C),A  ; appearing.}
 $9464 LD A,($5E21)  ; Fetch the number of lives from #R$5E21.
 $9467 CP $03        ; {Jump to #R$9476 if the number of lives is #N$03.
 $9469 JR Z,$9476    ; }
 $946B PUSH IX       ; Stash #REGix on the stack.
 $946D LD IX,$EA90   ; Point #REGix at the player at #R$EA90.
 $9471 CALL $9F4A    ; Call #R$9F4A to draw the player.
 $9474 POP IX        ; Restore #REGix from the stack.
; Set starting energy.
@label=PreparePlayer_Energy
*$9476 LD A,$F0      ; {Write #N$F0 to #R$5E28.
 $9478 LD ($5E28),A  ; }
 $947B CALL $8B8A    ; Call #R$8B8A to draw the chicken.
 $947E JP $A2CE      ; Jump to #R$A2CE to draw the lives.

; Player Template
;
; The entity that #R$9443 copies to #R$EA90 for a new life. The room and
; the sprite ID at the end are filled in before it is copied.
@label=PlayerTemplate
b$9481 DEFB $66      ; Sprite ID: #N$66 (the player appearing, see #R$8CB7).
 $9482 DEFB $00      ; The room (written by #R$9443).
 $9483 DEFB $00      ; Offset #N$02.
 $9484 DEFB $60      ; The X position.
 $9485 DEFB $68      ; The Y position.
 $9486 DEFB $47      ; The attribute.
 $9487 DEFB $FF      ; The number of rows drawn so far (see #R$8CB7).
 $9488 DEFB $00      ; The sprite ID of the character (written by #R$9443).

; Pause Game
;
; Used by the routine at #R$7E23.
; .
; Called by the main loop to check for the game being paused. The game is
; paused when only the key for CAPS SHIFT or SPACE is pressed. It then waits
; until the key has been released, pressed again and released again, before
; returning.
@label=PauseGame
c$9489 DI            ; Disable interrupts.
 $948A LD A,$7E      ; {Read from the keyboard;
 $948C OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $948E IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$7E | CAPS SHIFT / SPACE | Z / SYMBOL SHIFT | X / M | C / N | V / B }
                     ; TABLE#}
 $9490 BIT 0,A       ; {Return if the key for bit 0 is not pressed.
 $9492 RET NZ        ; }
 $9493 CPL           ; Flip the bits, so that a set bit is a key which is
                     ; pressed.
 $9494 AND %00011110 ; Keep only bits 1-4.
 $9496 RET NZ        ; Return if any of the other keys are pressed.
; Wait for the key to be released.
@label=PauseGame_Release
*$9497 LD A,$7E      ; {Read from the keyboard.
 $9499 OUT ($FD),A   ;
 $949B IN A,($FE)    ; }
 $949D BIT 0,A       ; {Loop back to #R$9497 until the key is released.
 $949F JR Z,$9497    ; }
; Wait for the key to be pressed again.
@label=PauseGame_Wait
*$94A1 LD A,$7E      ; {Read from the keyboard.
 $94A3 OUT ($FD),A   ;
 $94A5 IN A,($FE)    ; }
 $94A7 BIT 0,A       ; {Loop back to #R$94A1 until the key is pressed.
 $94A9 JR NZ,$94A1   ; }
; Wait for the key to be released again.
@label=PauseGame_Resume
*$94AB LD A,$7E      ; {Read from the keyboard.
 $94AD OUT ($FD),A   ;
 $94AF IN A,($FE)    ; }
 $94B1 BIT 0,A       ; {Loop back to #R$94AB until the key is released.
 $94B3 JR Z,$94AB    ; }
 $94B5 RET           ; Return.

; Place Key Pieces
;
; Used by the routine at #R$7D9A.
; .
; Chooses which of the eight sets of rooms in #R$94DD will hold the three
; entities for the A.C.G. key at #R$6025, using FRAMES and #R$5E12, and writes
; the three rooms to them.
@label=PlaceKeyPieces
c$94B6 LD A,($5C78)  ; {Fetch FRAMES and keep FRAMES in #REGc.
 $94B9 LD C,A        ; }
 $94BA LD A,($5E12)  ; Fetch the counter from #R$5E12.
 $94BD ADD A,C       ; Add FRAMES to the counter.
 $94BE AND %00000111 ; Keep only bits 0-2.
 $94C0 LD C,A        ; Keep the number of the set in #REGc.
 $94C1 ADD A,A       ; {Multiply the number of the set by #N$03.
 $94C2 ADD A,C       ; }
 $94C3 LD L,A        ; Keep the offset of the set in #REGl.
 $94C4 LD H,$00      ; Clear the high byte of the offset.
 $94C6 LD BC,$94DD   ; Point #REGbc at the key piece rooms at #R$94DD.
 $94C9 ADD HL,BC     ; Add the offset to the table, to find the chosen set.
 $94CA EX DE,HL      ; Keep the set of rooms in #REGde.
 $94CB LD HL,$6026   ; Point #REGhl at the room of the first entity at #R$6026.
 $94CE LD BC,$0008   ; #REGbc=#N($0008,$04,$04) (the distance between the
                     ; entities).
 $94D1 LD A,$03      ; #REGa=#N$03 (the number of key pieces to place).
@label=PlaceKeyPieces_Loop
*$94D3 EX AF,AF'     ; Save the key piece counter in #REGaf'.
 $94D4 LD A,(DE)     ; Fetch the next room.
 $94D5 LD (HL),A     ; Write it to the entity.
 $94D6 ADD HL,BC     ; Move #REGhl on to the next entity.
 $94D7 INC DE        ; Move #REGde on to the next room.
 $94D8 EX AF,AF'     ; Restore the key piece counter from #REGaf'.
 $94D9 DEC A         ; {Decrease the key piece counter by one and loop back to #R$94D3 until
 $94DA JR NZ,$94D3   ; all three have been placed.}
 $94DC RET           ; Return.

; Key Piece Rooms
;
; The eight sets of rooms for the three entities at #R$6025, used by
; #R$94B6.
; #TABLE(default,centre,centre,centre,centre)
; { =h Set | =h Room 1 | =h Room 2 | =h Room 3 }
; { #N$00 | #N$81 | #N$45 | #N$7C }
; { #N$01 | #N$85 | #N$49 | #N$2B }
; { #N$02 | #N$6A | #N$3B | #N$7C }
; { #N$03 | #N$69 | #N$71 | #N$2B }
; { #N$04 | #N$67 | #N$85 | #N$7C }
; { #N$05 | #N$68 | #N$7F | #N$2B }
; { #N$06 | #N$4D | #N$73 | #N$7C }
; { #N$07 | #N$17 | #N$10 | #N$2B }
; TABLE#
@label=KeyPieceRooms
b$94DD DEFB $81,$45,$7C
 $94E0 DEFB $85,$49,$2B
 $94E3 DEFB $6A,$3B,$7C
 $94E6 DEFB $69,$71,$2B
 $94E9 DEFB $67,$85,$7C
 $94EC DEFB $68,$7F,$2B
 $94EF DEFB $4D,$73,$7C
 $94F2 DEFB $17,$10,$2B

; Randomise Doors
;
; Used by the routine at #R$7D9A.
; .
; Called when a game starts. For each of the doors from #R$EEE0 onwards,
; a byte from the ROM (from an address that depends on FRAMES and #R$5E12) is
; used as a random number. If it is less than #N$70, and the sprite ID of both
; halves of the door is #N$01 then they are both changed to #N$22, or if it is
; #N$02 then to #N$20. Both of those are doors that open and close (see
; #R$915F and #R$917D). The doorway is then closed by setting bit 3 of the
; attribute of both halves (see #R$9565).
@label=RandomiseDoors
c$94F5 LD A,($5E12)  ; {Fetch the counter from #R$5E12 and keep the low byte of the ROM
 $94F8 LD L,A        ; address in #REGl.}
 $94F9 LD A,($5C78)  ; Fetch FRAMES.
 $94FC AND %00001111 ; Keep only bits 0-3.
 $94FE OR %00010000  ; Set bit 4.
 $9500 LD H,A        ; Keep the high byte of the ROM address in #REGh.
 $9501 EXX           ; Switch to the shadow registers.
 $9502 LD HL,$EEE0   ; #REGhl'=#N$EEE0 (the first half of the first door).
 $9505 LD DE,$EEE8   ; Point #REGde' at the second half of the first door at
                     ; #R$EEE8.
 $9508 LD BC,$0010   ; #REGbc'=#N($0010,$04,$04) (the distance between the
                     ; doors).
@label=RandomiseDoors_Loop
*$950B EXX           ; Switch to the main registers.
 $950C LD A,(HL)     ; Fetch the next random byte from the ROM.
 $950D INC HL        ; Move #REGhl on to the next byte.
 $950E EXX           ; Switch to the shadow registers.
 $950F CP $70        ; {Jump to #R$951F if the byte is #N$70 or more.
 $9511 JR NC,$951F   ; }
 $9513 LD A,(DE)     ; Fetch the sprite ID of the second half of the door.
 $9514 CP (HL)       ; {Jump to #R$951F if it is different to the first half.
 $9515 JR NZ,$951F   ; }
 $9517 CP $01        ; {Jump to #R$9526 if it is #N$01.
 $9519 JR Z,$9526    ; }
 $951B CP $02        ; {Jump to #R$9542 if it is #N$02.
 $951D JR Z,$9542    ; }
@label=RandomiseDoors_Next
*$951F ADD HL,BC     ; Move #REGhl on to the next door.
 $9520 EX DE,HL      ; Switch #REGde and #REGhl.
 $9521 ADD HL,BC     ; Move #REGhl on to the next door.
 $9522 RET C         ; Return if there are no more doors.
 $9523 EX DE,HL      ; Switch #REGde and #REGhl back again.
 $9524 JR $950B      ; Jump back to #R$950B to carry on with the loop through
                     ; the doors.
@label=RandomiseDoors_Close
*$9526 LD A,$22      ; #REGa=#N$22 (the new sprite ID of the closed door).
@label=RandomiseDoors_Change
*$9528 LD (DE),A     ; Update the sprite ID of the second half.
 $9529 LD (HL),A     ; Update the sprite ID of the first half.
 $952A PUSH DE       ; Stash #REGde on the stack.
 $952B INC DE        ; {Move #REGde on to the attribute of the second half.
 $952C INC DE        ;
 $952D INC DE        ;
 $952E INC DE        ;
 $952F INC DE        ; }
 $9530 LD A,(DE)     ; Fetch the attribute.
 $9531 OR %00001000  ; Set bit 3, to close the doorway.
 $9533 LD (DE),A     ; Write it back.
 $9534 POP DE        ; Restore #REGde from the stack.
 $9535 PUSH HL       ; Stash #REGhl on the stack.
 $9536 INC HL        ; {Move #REGhl on to the attribute of the first half.
 $9537 INC HL        ;
 $9538 INC HL        ;
 $9539 INC HL        ;
 $953A INC HL        ; }
 $953B LD A,(HL)     ; Fetch the attribute.
 $953C OR %00001000  ; Set bit 3, to close the doorway.
 $953E LD (HL),A     ; Write it back.
 $953F POP HL        ; Restore #REGhl from the stack.
 $9540 JR $951F      ; Jump back to #R$951F to move on to the next door.
@label=RandomiseDoors_Close_Alternate
*$9542 LD A,$20      ; #REGa=#N$20 (the new sprite ID of the closed door).
 $9544 JR $9528      ; Jump to #R$9528 to change the door.

; Update Doorway
;
; Used by the routine at #R$917D.
; .
; Opens the doorway of a door if bit 0 of its sprite ID is set (which is
; so for the doors that are open), and closes it if it is not. The other entry
; points open and close the doorway of a door whatever the sprite ID. The
; doorway is open when bit 3 of the attribute is reset for both halves of the
; door, because #R$900A skips the doors that have it set.
;
; IX One half of the door
@label=UpdateDoorway
c$9546 LD A,(IX+$00) ; Fetch the sprite ID of the door.
 $9549 AND %00000001 ; Keep only bit 0.
 $954B JR Z,$9565    ; Jump to #R$9565 if it is reset.

; Open Doorway
;
; Used by the routines at #R$9222, #R$942F and #R$961B.
; .
; Resets bit 3 of the attribute of both halves of a door.
;
; IX One half of the door
@label=OpenDoorway
c$954D LD A,(IX+$05) ; Fetch the attribute of the door.
 $9550 AND %11110111 ; Reset bit 3.
 $9552 LD (IX+$05),A ; Write it back.
 $9555 PUSH IX       ; Stash #REGix on the stack.
 $9557 CALL $9286    ; Call #R$9286 to point #REGix at the other half of the
                     ; door.
 $955A LD A,(IX+$05) ; Fetch the attribute of the other half.
 $955D AND %11110111 ; Reset bit 3.
 $955F LD (IX+$05),A ; Write it back.
 $9562 POP IX        ; Restore #REGix from the stack.
 $9564 RET           ; Return.

; Close Doorway
;
; Used by the routines at #R$9222, #R$942F, #R$9546 and #R$961B.
; .
; Sets bit 3 of the attribute of both halves of a door.
;
; IX One half of the door
@label=CloseDoorway
c$9565 LD A,(IX+$05) ; Fetch the attribute of the door.
 $9568 OR %00001000  ; Set bit 3.
 $956A LD (IX+$05),A ; Write it back.
 $956D PUSH IX       ; Stash #REGix on the stack.
 $956F CALL $9286    ; Call #R$9286 to point #REGix at the other half of the
                     ; door.
 $9572 LD A,(IX+$05) ; Fetch the attribute of the other half.
 $9575 OR %00001000  ; Set bit 3.
 $9577 LD (IX+$05),A ; Write it back.
 $957A POP IX        ; Restore #REGix from the stack.
 $957C RET           ; Return.

; Check Doorway
;
; Used by the routine at #R$8D77.
; .
; Counts how many of the two axes an entity is beyond the edge of the
; floor of the room. The floor is centred on #N$58 across and #N$68 down, and on
; each axis it extends one more than the width in #R$5E1D or the height in
; #R$5E1E from the centre. The count is written to #R$5E2D, which is zero when
; the entity is not in a doorway.
;
; IX The entity
@label=CheckDoorway
c$957D PUSH DE       ; Stash #REGde on the stack.
 $957E LD B,$00      ; #REGb=#N$00 (the count).
 $9580 LD HL,($5E1D) ; #REGhl=*#R$5E1D (the width in #REGl and the height in
                     ; #REGh).
 $9583 INC L         ; Increment the width.
 $9584 INC H         ; Increment the height.
 $9585 LD E,(IX+$03) ; Fetch the X position of the entity.
 $9588 LD D,(IX+$04) ; Fetch the Y position of the entity.
 $958B LD A,E        ; Fetch the X position.
 $958C SUB $58       ; Subtract #N$58, to get the distance from the centre of
                     ; the floor.
 $958E JP P,$9593    ; Jump to #R$9593 if the result is positive.
 $9591 NEG           ; Negate it, to make the distance positive.
@label=CheckDoorway_X
*$9593 CP L          ; {Jump to #R$9597 if the entity is within the width of
 $9594 JR C,$9597    ; the floor.}
 $9596 INC B         ; Increment the count of axes that it is beyond.
@label=CheckDoorway_Y
*$9597 LD A,D        ; Fetch the Y position.
 $9598 SUB $68       ; Subtract #N$68, to get the distance from the centre of
                     ; the floor.
 $959A JP P,$959F    ; Jump to #R$959F if the result is positive.
 $959D NEG           ; Negate it, to make the distance positive.
@label=CheckDoorway_Compare
*$959F CP H          ; {Jump to #R$95A3 if the entity is within the height of
 $95A0 JR C,$95A3    ; the floor.}
 $95A2 INC B         ; Increment the count of axes that it is beyond.
@label=CheckDoorway_Finish
*$95A3 LD A,B        ; Fetch the count.
 $95A4 LD ($5E2D),A  ; Update the doorway flag in #R$5E2D.
 $95A7 POP DE        ; Restore #REGde from the stack.
 $95A8 RET           ; Return.

; Make Tombstone
;
; Used by the routine at #R$8D45.
; .
; Makes a tombstone (sprite ID #N$8F) where the player is. The four
; entities from #R$EAE8 are searched for one that is not in use. If there is
; one, it is made a copy of the player, apart from the sprite ID, and with the
; attribute of the player set to #N$45 first. Then it is drawn.
@label=MakeTombstone
c$95A9 LD HL,$EAE8   ; #REGhl=#R$EAE8 (the first of the four entities to
                     ; search).
 $95AC LD DE,$0008   ; #REGde=#N($0008,$04,$04) (the size of an entity).
 $95AF LD B,$04      ; #REGb=#N$04 (the number of entities to look at).
@label=MakeTombstone_Loop
*$95B1 LD A,(HL)     ; Fetch the sprite ID of the entity.
 $95B2 AND A         ; {Jump to #R$95B9 if the entity is not in use.
 $95B3 JR Z,$95B9    ; }
 $95B5 ADD HL,DE     ; Move #REGhl on to the next entity.
 $95B6 DJNZ $95B1    ; Decrease the entity counter by one and loop back to #R$95B1 until
                     ; all four have been checked.
 $95B8 RET           ; Return.
@label=MakeTombstone_Create
*$95B9 LD A,$45      ; {Write #N$45 to the attribute of the player.
 $95BB LD ($EA95),A  ; }
 $95BE PUSH HL       ; Stash the address of the entity on the stack.
 $95BF LD (HL),$8F   ; Write #N$8F to the sprite ID of the entity.
 $95C1 EX DE,HL      ; Swap #REGde and #REGhl, so that #REGde points at the
                     ; entity.
 $95C2 INC DE        ; Move #REGde on to the room of the entity.
 $95C3 LD HL,$EA91   ; Point #REGhl at the room of the player at #R$EA91.
 $95C6 LD BC,$0007   ; #REGbc=#N($0007,$04,$04).
 $95C9 LDIR          ; Copy the seven bytes from the player to the entity.
 $95CB POP HL        ; Restore the address of the entity from the stack.
; This entry point is used by the routine at #R$96EC.
; .
; Draw the entity that #REGhl points to.
@label=DrawEntityAtHL
*$95CC PUSH IX       ; Stash #REGix on the stack.
 $95CE PUSH HL       ; {Copy #REGhl into #REGix, as the entity to draw.
 $95CF POP IX        ; }
 $95D1 CALL $9F4A    ; Call #R$9F4A to draw the entity.
 $95D4 POP IX        ; Restore #REGix from the stack.
 $95D6 RET           ; Return.

; Handle Tombstone
;
; The handler for the tombstone (sprite ID #N$8F), which just sets the
; attributes with #R$92E0.
;
; IX The tombstone entity
@label=HandlerTombstone
c$95D7 JP $92E0      ; Jump to #R$92E0 to set the attributes of the item.

; Update Clock
;
; Used by the routine at #R$7EB2.
; .
; Called whenever FRAMES has changed. Once #N$32 frames have passed,
; FRAMES is reduced by that, the seconds in #R$5E3F are increased (in BCD), the
; minutes in #R$5E3E when the seconds reach #N$60, and the hours in #R$5E3D when
; the minutes reach #N$60, and then the clock is printed on the screen.
@label=ClockTick
c$95DA LD A,($5C78)  ; Fetch FRAMES.
 $95DD CP $32        ; {Return if fewer than #N$32 frames have passed.
 $95DF RET C         ; }
 $95E0 SUB $32       ; Subtract #N$32, as a second has passed.
 $95E2 LD ($5C78),A  ; Update FRAMES.
 $95E5 LD HL,$5E3F   ; Point #REGhl at the clock seconds at #R$5E3F.
 $95E8 LD A,(HL)     ; Fetch the seconds.
 $95E9 INC A         ; Increment the seconds.
 $95EA DAA           ; Convert it to BCD.
 $95EB LD (HL),A     ; Write it back.
 $95EC CP $60        ; {Jump to #R$9604 if the seconds have not reached #N$60.
 $95EE JR NZ,$9604   ; }
 $95F0 LD (HL),$00   ; Reset the seconds to #N$00.
 $95F2 DEC HL        ; Move #REGhl on to the minutes.
 $95F3 LD A,(HL)     ; Fetch the minutes.
 $95F4 INC A         ; Increment the minutes.
 $95F5 DAA           ; Convert it to BCD.
 $95F6 LD (HL),A     ; Write it back.
 $95F7 CP $60        ; {Jump to #R$9604 if the minutes have not reached #N$60.
 $95F9 JR NZ,$9604   ; }
 $95FB LD (HL),$00   ; Reset the minutes to #N$00.
 $95FD DEC HL        ; Move #REGhl on to the hours.
 $95FE LD A,(HL)     ; Fetch the hours.
 $95FF INC A         ; Increment the hours.
 $9600 DAA           ; Convert it to BCD.
 $9601 AND %00001111 ; Keep only bits 0-3.
 $9603 LD (HL),A     ; Write it back.
; Print the clock.
@label=ClockTick_Print
*$9604 LD HL,$40C8   ; #REGhl=#N$40C8 (screen buffer location).
; This entry point is used by the routine at #R$9641.
@label=PrintClock
*$9607 CALL $9BA2    ; Call #R$9BA2 to get the screen address.
 $960A LD DE,$5E3D   ; Point #REGde at the clock hours at #R$5E3D.
 $960D LD B,$02      ; #REGb=#N$02.
 $960F CALL $A1C9    ; Call #R$A1C9 to print the last digit of the hours and both digits of
                     ; the minutes.
 $9612 LD DE,$5E3F   ; Point #REGde at the clock seconds at #R$5E3F.
 $9615 INC HL        ; Move #REGhl on to the next character position.
 $9616 LD B,$01      ; #REGb=#N$01.
 $9618 JP $A1BF      ; Jump to #R$A1BF to print both digits of the seconds.

; Handle A.C.G. Door
;
; The handler for the A.C.G. door (sprite ID #N$24 in #R$802A). When the
; three slots of the inventory hold the three A.C.G. key pieces (sprite IDs
; #N$8C, #N$8D and #N$8E, in that order) the doorway is opened and the door is
; used as an exit with #R$91F5, with a bigger range than other doors.
; Otherwise the doorway is closed and the door is just shown by #R$91FE.
;
; IX The door entity
@label=HandlerDoorACGExit
c$961B LD HL,$5E32   ; Point #REGhl at the sprite ID in the first slot of the inventory at
                     ; #R$5E32.
 $961E LD DE,$0004   ; #REGde=#N($0004,$04,$04) (the size of a slot).
 $9621 LD A,(HL)     ; Fetch the sprite ID in the slot.
 $9622 CP $8C        ; {Jump to #R$963B if it is not #N$8C.
 $9624 JR NZ,$963B   ; }
 $9626 ADD HL,DE     ; Move #REGhl on to the second slot.
 $9627 LD A,(HL)     ; Fetch the sprite ID in the slot.
 $9628 CP $8D        ; {Jump to #R$963B if it is not #N$8D.
 $962A JR NZ,$963B   ; }
 $962C ADD HL,DE     ; Move #REGhl on to the third slot.
 $962D LD A,(HL)     ; Fetch the sprite ID in the slot.
 $962E CP $8E        ; {Jump to #R$963B if it is not #N$8E.
 $9630 JR NZ,$963B   ; }
 $9632 CALL $954D    ; Call #R$954D to open the doorway.
 $9635 LD BC,$3020   ; #REGbc=#N($3020,$04,$04) (the range of the door).
 $9638 JP $91F5      ; Jump to #R$91F5 to check whether the player is in range
                     ; of the door.
@label=HandlerDoorACGExit_Locked
*$963B CALL $9565    ; Call #R$9565 to close the doorway.
 $963E JP $91FE      ; Jump to #R$91FE to handle a room item that does nothing.

; Show Game Statistics
;
; Used by the routines at #R$8C35 and #R$96EC.
; .
; Prints the time, score and percentage of rooms visited, each with
; its label, on the game over screen.
; #PUSHS #POKES$5C78,$34,$02 #POKES$5CB0,$E9
; #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$7D9A,stop=$7DDC,clear=1,sp=$5E00)
; #POKES$5E01,$4C;$5E02,$BE
; #SCR$02,$07,$07,$11,$07(statistics-before)
; | #SIM(start=$9641,stop=$0000,sp=$5B60)
; #SCR$02,$07,$07,$11,$07(statistics-after) } UDGTABLE# #POPS
@label=GameStats
c$9641 CALL $96C9                    ; Call #R$96C9 to calculate the percentage
                                     ; of rooms visited.
; Handle printing the time.
 $9644 LD HL,$4040                   ; #REGhl=#N$4040 (screen buffer location).
 $9647 LD DE,$967F                   ; Point #REGde at the label for the time
                                     ; at #R$967F.
 $964A CALL $A1F3                    ; Call #R$A1F3 to print the string.
; Handle printing the score.
 $964D LD HL,$5040                   ; #REGhl=#N$5040 (screen buffer location).
 $9650 LD DE,$968F                   ; Point #REGde at the label for the score
                                     ; at #R$968F.
 $9653 CALL $A1F3                    ; Call #R$A1F3 to print the string.
; Handle printing the percentage label.
 $9656 LD HL,$6040                   ; #REGhl=#N$6040 (screen buffer location).
 $9659 LD DE,$969F                   ; Point #REGde at the label for the
                                     ; percentage at #R$969F.
 $965C CALL $A1F3                    ; Call #R$A1F3 to print the string.
; Handle printing the clock.
 $965F LD HL,$BFCC                   ; {Write #R$BFCC(main font "0") to
 $9662 LD ($5E01),HL                 ; #R$5E01.}
 $9665 LD HL,$4080                   ; #REGhl=#N$4080 (screen buffer location).
 $9668 CALL $9607                    ; Call #R$9607 to print the clock.
; Handle printing the score.
 $966B LD HL,$5080                   ; #REGhl=#N$5080 (screen buffer location).
 $966E CALL $A1B7                    ; Call #R$A1B7 to print the score.
; Handle printing the percentage of rooms visited.
 $9671 LD HL,$6080                   ; #REGhl=#N$6080 (screen buffer location).
 $9674 CALL $9BA2                    ; Call #R$9BA2 to get the screen address.
 $9677 LD DE,$5E54                   ; Point #REGde at the visited percentage
                                     ; at #R$5E54.
 $967A LD B,$01                      ; #REGb=#N$01.
 $967C JP $A1BF                      ; Jump to #R$A1BF to print the score.
; The strings for the three labels. Each is in the format that #R$A1F3
; prints: an attribute, followed by the characters, with bit 7 set on the last
; character.
@label=StringTime
 $967F DEFM $45                      ; {Attribute: #COLOUR(#PEEK(#PC)) + "TIME" and a colon
 $9680 DEFM "TIME       #  "," "+$80 ; (character code #N$23 is drawn as ":" in the font).
                                     ; }
@label=StringScore
 $968F DEFM $45                      ; {Attribute: #COLOUR(#PEEK(#PC)) +
 $9690 DEFM "SCORE         "," "+$80 ; "SCORE".}
@label=StringPercentage
 $969F DEFM $45                      ; {Attribute: #COLOUR(#PEEK(#PC)) + a percent sign
 $96A0 DEFM "$             "," "+$80 ; (character code #N$24 is drawn as "%" in the font).
                                     ; }

; Visit Room
;
; Used by the routine at #R$9147.
; .
; Marks a room as having been visited, by setting its bit in the table of
; visited rooms at #R$5E40. The table has one bit for each room, #N$08 rooms to
; a byte.
; The bit to set is worked out from the room ID and written into the SET
; instruction at #R$96C6 (self modifying code), which then sets it.
;
; A The room ID
;
; Create an offset in #REGbc.
@label=VisitRoom
c$96AF LD C,A        ; Keep the room ID in #REGc.
 $96B0 SRL C         ; {Divide by #N$08.
 $96B2 SRL C         ;
 $96B4 SRL C         ; }
 $96B6 LD B,$00      ; #REGb=#N$00.
 $96B8 LD HL,$5E40   ; {#REGhl=#R$5E40 + #REGbc.
 $96BB ADD HL,BC     ; }
; Work out the bit to set, which is the bottom three bits of the room ID.
 $96BC RLCA          ; {Multiply by #N$08.
 $96BD RLCA          ;
 $96BE RLCA          ; }
 $96BF AND %00111000 ; Keep only bits 3-5.
 $96C1 OR %11000110  ; Set bits 1-2, 6-7. This makes the second byte of the
                     ; instruction SET n,(HL) for the bit.
 $96C3 LD ($96C7),A  ; Write this value to #R$96C6(#N$96C7), which updates the
                     ; bit to set.
 $96C6 SET 0,(HL)    ; Set the bit to mark the room as having been visited.
 $96C8 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #SABREWULF$9D23 }
; LIST#

; Calculate Rooms Visited
;
; Used by the routine at #R$9641.
; .
; Works out the percentage of the rooms that have been visited, from the
; bits that are set in the table at #R$5E40, and writes it to #R$5E54 as BCD.
; Every third room that has been visited adds #N$02 to the percentage, and
; then #N$01 is added at the end.
@label=CalculateRoomsVisited
c$96C9 LD HL,$5E40   ; Point #REGhl at the table of visited rooms at #R$5E40.
 $96CC LD BC,$0813   ; #REGb=#N$08 (the number of bits in each byte) and #REGc=#N$13 (the
                     ; number of bytes).
 $96CF LD D,$03      ; #REGd=#N$03 (the number of rooms that are left before the next
                     ; increase).
 $96D1 XOR A         ; #REGa=#N$00 (the percentage so far).
@label=CalculateRoomsVisited_Byte
*$96D2 PUSH BC       ; Stash the counters on the stack.
 $96D3 LD E,(HL)     ; Fetch the next byte of the table.
 $96D4 INC HL        ; Move on to the next byte.
@label=CalculateRoomsVisited_Bit
*$96D5 RR E          ; Rotate the next bit into the carry flag.
 $96D7 JR NC,$96E1   ; Jump to #R$96E1 if the room has not been visited.
 $96D9 DEC D         ; {Jump to #R$96E1 if there are more rooms before the next
 $96DA JR NZ,$96E1   ; increase.}
 $96DC LD D,$03      ; #REGd=#N$03.
 $96DE ADD A,$02     ; Add #N$02 to the percentage.
 $96E0 DAA           ; Convert the result to BCD.
@label=CalculateRoomsVisited_Next
*$96E1 DJNZ $96D5    ; Decrease the bit counter by one and loop back to #R$96D5 until the
                     ; byte is done.
 $96E3 POP BC        ; Restore the counters from the stack.
 $96E4 DEC C         ; {Decrease the byte counter by one and loop back to #R$96D2 until all
 $96E5 JR NZ,$96D2   ; of the bytes are done.}
 $96E7 INC A         ; Add one to the percentage.
 $96E8 LD ($5E54),A  ; Write the percentage to #R$5E54.
 $96EB RET           ; Return.
; View the equivalent code in;
; #LIST
; { #SABREWULF$9CC6 }
; LIST#

; Game Complete
;
; Used by the routine at #R$7E23.
; .
; Called when the player has reached room #N$8E. The player is drawn, the
; messages are printed, and the game statistics are shown by #R$9641. The game
; then carries on as if it were over.
; #PUSHS #POKES$5C78,$34,$02 #POKES$5CB0,$E9
; #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$7D9A,stop=$7DDC,clear=1,sp=$5E00)
; #SCR$01(game-complete-before)
; | #SIM(start=$96EC,stop=$970D,sp=$5E00)
; #SCR$01(game-complete-after) } UDGTABLE# #POPS
@label=GameComplete
c$96EC LD HL,$EA90   ; Point #REGhl at the player at #R$EA90.
 $96EF CALL $95CC    ; Call #R$95CC to draw the entity that #REGhl points to.
 $96F2 LD HL,$BE4C   ; {Write #N$BE4C (the main font, see #R$BF4C) to #R$5E01, which sets
 $96F5 LD ($5E01),HL ; the font.}
; Handle printing "CONGRATULATIONS".
 $96F8 LD HL,$2040   ; #REGhl=#N$2040 (screen buffer location).
 $96FB LD DE,$9710   ; Point #REGde at the game complete messages at #R$9710.
 $96FE CALL $A1F3    ; Call #R$A1F3 to print the string.
; Handle printing "YOU HAVE ESCAPED".
 $9701 LD HL,$3040   ; #REGhl=#N$3040 (screen buffer location).
 $9704 LD DE,$9720   ; Point #REGde at the message that the player has escaped
                     ; at #R$9720.
 $9707 CALL $A1F3    ; Call #R$A1F3 to print the string.
; Show the game statistics.
 $970A CALL $9641    ; Call #R$9641 to show the game statistics.
; Disappointingly cut into the "normal" game over routine.
 $970D JP $8C4A      ; Jump to #R$8C4A to wait for a moment.

; Game Complete Messages
;
; The messages that #R$96EC prints. Each one starts with the attribute to
; colour it with and ends with a character that has bit 7 set.
@label=GameCompleteMessages
t$9710 DEFM $47                       ; {Attribute: #COLOUR(#PEEK(#PC)) +
 $9711 DEFM "CONGRATULATION","S"+$80  ; "CONGRATULATIONS".}
@label=GameCompleteMessage_Escaped
 $9720 DEFM $47                       ; {Attribute: #COLOUR(#PEEK(#PC)) + "YOU
 $9721 DEFM "YOU HAVE ESCAPE","D"+$80 ; HAVE ESCAPED".}

; Fall Through Trapdoor
;
; Used by the routine at #R$91C5.
; .
; Used by #R$91C5 for a trapdoor that is open. If the player is in range
; of the trapdoor (#N$18 in each direction), the screen is cleared and the
; frame of room #N$96 is drawn. Then for #N$80 frames of rings of colour (see
; #R$9774) spread out from the centre of the screen, while the centre flashes
; and clicks are made. Then the player goes through the door with #R$9117.
; If the player is not in range then the trapdoor is just shown by #R$91FE.
;
; IX The trapdoor entity
@label=FallThroughTrapdoor
c$9731 LD BC,$1818   ; #REGbc=#N($1818,$04,$04) (the range of the trapdoor).
 $9734 CALL $90CC    ; Call #R$90CC to see whether the player is in range.
 $9737 JP NC,$91FE   ; Jump to #R$91FE if the player is not.
 $973A CALL $8093    ; Call #R$8093 to clear the play area.
 $973D LD A,$96      ; #REGa=#N$96 (the room to draw the frame of).
 $973F PUSH IX       ; Stash #REGix on the stack.
 $9741 CALL $9BF1    ; Call #R$9BF1 to draw the frame of the room.
 $9744 POP IX        ; Restore #REGix from the stack.
 $9746 LD B,$80      ; #REGb=#N$80 (the number of frames to fall for, which also sets the
                     ; pitch of the clicks).
@label=FallThroughTrapdoor_Loop
*$9748 LD A,($5C78)  ; {Fetch FRAMES and keep FRAMES in #REGc.
 $974B LD C,A        ; }
; Make clicks until FRAMES has changed.
@label=FallThroughTrapdoor_Wait
*$974C PUSH BC       ; Stash the fall counter and FRAMES on the stack.
 $974D LD A,B        ; Fetch the fall counter.
 $974E CPL           ; Flip the bits of the fall counter.
 $974F LD B,A        ; Keep the pitch of the click in #REGb.
 $9750 CALL $A3A8    ; Call #R$A3A8 to make a click.
 $9753 POP BC        ; Restore the fall counter and FRAMES from the stack.
 $9754 LD A,($5C78)  ; Fetch FRAMES.
 $9757 CP C          ; {Jump to #R$974C if FRAMES has not changed.
 $9758 JR Z,$974C    ; }
; Flash the centre of the screen on every eighth frame.
 $975A AND %00000111 ; Keep only bits 0-2.
 $975C LD A,$00      ; #REGa=#N$00 (the attribute for black).
 $975E JR NZ,$9762   ; Jump to #R$9762 if FRAMES is not a multiple of eight.
 $9760 LD A,$47      ; #REGa=#N$47 (the attribute for bright white ink on
                     ; black).
@label=FallThroughTrapdoor_Flash
*$9762 LD L,A        ; Keep the attribute in #REGl.
 $9763 LD H,A        ; Keep the attribute in #REGh.
 $9764 LD ($596B),HL ; Write the attribute to the two cells at #N$596B.
 $9767 LD ($598B),HL ; Write the attribute to the two cells at #N$598B.
 $976A PUSH BC       ; Stash the fall counter on the stack.
 $976B CALL $9774    ; Call #R$9774 to spread the colours out.
 $976E POP BC        ; Restore the fall counter from the stack.
 $976F DJNZ $9748    ; Decrease the fall counter by one and loop back to #R$9748 until the
                     ; fall has finished.
 $9771 JP $9117      ; Jump to #R$9117 to enter the door.

; Ripple Attributes
;
; Used by the routine at #R$9731.
; .
; Moves the colours of a set of #N$0B rings of the attribute buffer
; outwards. Each ring is a square with sides of #N$17 cells, starting from the
; bottom left of the screen (#N$5AE0) and moving one cell up and one to the
; right for each ring, so that the sides are #N$02 cells shorter. All of the
; cells of a ring are given the colour of the cell diagonally inside the first
; one.
@label=RippleAttributes
c$9774 LD BC,$170B   ; #REGbc=#N$170B (#REGb is the length of the sides and #REGc is the
                     ; number
                     ; of rings).
 $9777 LD HL,$5AE0   ; #REGhl=#N$5AE0 (the start of the first ring).
 $977A LD DE,$0020   ; #REGde=#N($0020,$04,$04) (the size of a row).
@label=RippleAttributes_Ring
*$977D PUSH HL       ; Stash #REGhl on the stack.
 $977E AND A         ; {Move up one row.
 $977F SBC HL,DE     ; }
 $9781 INC L         ; Move one cell to the right.
 $9782 LD A,(HL)     ; Fetch the attribute of that cell.
 $9783 POP HL        ; Restore #REGhl from the stack.
 $9784 PUSH BC       ; Stash the length on the stack.
; Draw the bottom of the ring, from left to right.
@label=RippleAttributes_Bottom
*$9785 LD (HL),A     ; Write #REGa to the attribute buffer.
 $9786 INC L         ; Move one cell to the right.
 $9787 DJNZ $9785    ; Decrease the length by one and loop back to #R$9785 until it is
                     ; zero.
 $9789 POP BC        ; Restore the length from the stack.
 $978A PUSH BC       ; Stash it on the stack again.
; Draw the right side of the ring, from bottom to top.
@label=RippleAttributes_Right
*$978B LD (HL),A     ; Write #REGa to the attribute buffer.
 $978C AND A         ; {Move up one row.
 $978D SBC HL,DE     ; }
 $978F DJNZ $978B    ; Decrease the length by one and loop back to #R$978B until it is
                     ; zero.
 $9791 POP BC        ; Restore the length from the stack.
 $9792 PUSH BC       ; Stash it on the stack again.
; Draw the top of the ring, from right to left.
@label=RippleAttributes_Top
*$9793 LD (HL),A     ; Write #REGa to the attribute buffer.
 $9794 DEC L         ; Move one cell to the left.
 $9795 DJNZ $9793    ; Decrease the length by one and loop back to #R$9793 until it is
                     ; zero.
 $9797 POP BC        ; Restore the length from the stack.
 $9798 PUSH BC       ; Stash it on the stack again.
; Draw the left side of the ring, from top to bottom.
@label=RippleAttributes_Left
*$9799 LD (HL),A     ; Write #REGa to the attribute buffer.
 $979A ADD HL,DE     ; Move down one row.
 $979B DJNZ $9799    ; Decrease the length by one and loop back to #R$9799 until it is
                     ; zero.
; Move on to the next ring, which is inside this one.
 $979D LD (HL),A     ; Write #REGa to the attribute buffer.
 $979E AND A         ; {Move up one row.
 $979F SBC HL,DE     ; }
 $97A1 INC L         ; Move one cell to the right.
 $97A2 POP BC        ; Restore the length from the stack.
 $97A3 DEC B         ; {Make the sides two cells shorter.
 $97A4 DEC B         ; }
 $97A5 DEC C         ; {Decrease the number of rings by one and loop back to #R$977D until
 $97A6 JR NZ,$977D   ; it is zero.}
 $97A8 RET           ; Return.

; Tunnel Frame Coordinates
;
; The X and Y coordinates of the corners of the #N$0C squares that make up
; the frame of room #N$96, which is drawn by #R$9BEA (#N$04 pairs of coordinates
; for each square, from the smallest to the largest). The lines between the
; corners are listed in #R$9809.
@label=TunnelFrameCoordinates
b$97A9 DEFB $5C,$63,$63,$63,$63,$5C,$5C,$5C
 $97B1 DEFB $54,$6B,$6B,$6B,$6B,$54,$54,$54
 $97B9 DEFB $4C,$73,$73,$73,$73,$4C,$4C,$4C
 $97C1 DEFB $44,$7B,$7B,$7B,$7B,$44,$44,$44
 $97C9 DEFB $3C,$83,$83,$83,$83,$3C,$3C,$3C
 $97D1 DEFB $34,$8B,$8B,$8B,$8B,$34,$34,$34
 $97D9 DEFB $2C,$93,$93,$93,$93,$2C,$2C,$2C
 $97E1 DEFB $24,$9B,$9B,$9B,$9B,$24,$24,$24
 $97E9 DEFB $1C,$A3,$A3,$A3,$A3,$1C,$1C,$1C
 $97F1 DEFB $14,$AB,$AB,$AB,$AB,$14,$14,$14
 $97F9 DEFB $0C,$B3,$B3,$B3,$B3,$0C,$0C,$0C
 $9801 DEFB $04,$BB,$BB,$BB,$BB,$04,$04,$04

