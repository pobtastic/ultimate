 $A9E9 DEFB $1F,$1F  ; Corner #N((#PC - $A9DF) / $02).
 $A9EB DEFB $A0,$1F  ; Corner #N((#PC - $A9DF) / $02).
 $A9ED DEFB $A0,$A0  ; Corner #N((#PC - $A9DF) / $02).

; Room Shapes #N$00, #N$03 and #N$04 Lines
;
; The lines that join the corners of the frame of room shapes #N$00, #N$03
; and #N$04 (see #R$A982). Each list has the corner to start from, followed by
; the corners to draw lines to, and ends with #N$FF. The last byte is #N$FF to
; end all of the lists, and the corners are those in the coordinates of each
; shape (#R$A9DF for the first).
@label=RoomShapes_00_03_04_Lines
b$A9EF DEFB $00,$01,$03,$04,$FF ; Start at corner #N$00 and draw lines to corners #N$01, #N$03 and
                                ; #N$04.
 $A9F4 DEFB $02,$01,$03,$06,$FF ; Start at corner #N$02 and draw lines to corners #N$01, #N$03 and
                                ; #N$06.
 $A9F9 DEFB $05,$01,$04,$06,$FF ; Start at corner #N$05 and draw lines to corners #N$01, #N$04 and
                                ; #N$06.
 $A9FE DEFB $07,$03,$04,$06,$FF ; Start at corner #N$07 and draw lines to corners #N$03, #N$04 and
                                ; #N$06.
 $AA03 DEFB $FF                 ; Terminator.

