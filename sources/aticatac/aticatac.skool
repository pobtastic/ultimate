; Game Initialisation
;
; Used by the routine at #R$6000.
; .
; Clears the first #N$10 bytes of the game variables, selects the main
; font and then runs the game selection menu. The menu is drawn by #R$7CAF
; and the keyboard is scanned for the keys "1" to "6" and "0" until "0" is
; pressed. Each key changes the control method or the character stored in
; #R$5E00 and moves the highlight on the menu, and "0" starts the game at
; #R$7D9A. The entry point at #R$7C29 is also used to return to the menu when
; a game ends.
;
; .
;
; Clear the first #N$10 bytes of the game variables.
@label=GameInitialisation
c$7C19 LD HL,$5E00   ; Point #REGhl at the game options at #R$5E00.
 $7C1C LD B,$10      ; #REGb=#N$10 (the number of bytes to clear).
@label=GameInitialisation_Loop
*$7C1E LD (HL),$00   ; Clear a byte of the game variables.
 $7C20 INC HL        ; Move #REGhl on to the next byte of the game variables.
 $7C21 DJNZ $7C1E    ; Decrease the byte counter by one and loop back to #R$7C1E until all
                     ; #N$10 bytes have been cleared.
 $7C23 LD HL,$BE4C   ; {Write #N$BE4C (the main font, see #R$BF4C) to #R$5E01.
 $7C26 LD ($5E01),HL ; }
; This entry point is used by the routine at #R$8C35.
; .
; Clear the screen and draw the icons for the menu.
@label=Game_Restart
*$7C29 CALL $80AA    ; Call #R$80AA to clear the screen.
 $7C2C CALL $A311    ; Call #R$A311 to draw the icons of the menu.
; Each pass of this loop draws the menu and handles one scan of the
; keyboard.
@label=GameSelect_Loop
*$7C2F CALL $7CAF    ; Call #R$7CAF to show the game selection menu.
 $7C32 LD A,$F7      ; {Read from the keyboard;
 $7C34 OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $7C36 IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$F7 | 1 | 2 | 3 | 4 | 5 }
                     ; TABLE#}
 $7C38 CPL           ; Flip the bits, so that a set bit is a key which is
                     ; pressed.
 $7C39 LD E,A        ; Keep the keys that are pressed in #REGe.
 $7C3A LD A,($5E00)  ; Fetch the game options.
; Handle "Keyboard" selection.
 $7C3D BIT 0,E       ; {Jump to #R$7C43 if key "1" is not being pressed
 $7C3F JR Z,$7C43    ; ("KEYBOARD").}
 $7C41 AND %11111001 ; Keep only bits 0 and 3-7, so the control method is the keyboard
                     ; (#N$00).
; Handle "Kempston Joystick" selection.
@label=GameSelect_CheckKempston
*$7C43 BIT 1,E       ; {Jump to #R$7C4B if key "2" is not being pressed ("KEMPSTON
 $7C45 JR Z,$7C4B    ; JOYSTICK").}
 $7C47 AND %11111001 ; Keep only bits 0 and 3-7.
 $7C49 OR %00000010  ; Set the control method to Kempston joystick (#N$02).
; Handle "Cursor Joystick" selection.
@label=GameSelect_CheckCursor
*$7C4B BIT 2,E       ; {Jump to #R$7C53 if key "3" is not being pressed
 $7C4D JR Z,$7C53    ; ("CURSOR JOYSTICK").}
 $7C4F AND %11111001 ; Keep only bits 0 and 3-7.
 $7C51 OR %00000100  ; Set the control method to cursor joystick (#N$04).
; Handle "Knight" selection.
@label=GameSelect_CheckKnight
*$7C53 BIT 3,E       ; {Jump to #R$7C59 if key "4" is not being pressed
 $7C55 JR Z,$7C59    ; ("KNIGHT").}
 $7C57 AND %11100111 ; Keep only bits 0-2 and 5-7, so the character is the knight
                     ; (#N$00).
; Handle "Wizard" selection.
@label=GameSelect_CheckWizard
*$7C59 BIT 4,E       ; {Jump to #R$7C61 if key "5" is not being pressed
 $7C5B JR Z,$7C61    ; ("WIZARD").}
 $7C5D AND %11100111 ; Keep only bits 0-2 and 5-7.
 $7C5F OR %00001000  ; Set the character to the wizard (#N$08).
; Save the options so far and read the second row of keys.
@label=GameSelect_SecondRow
*$7C61 LD D,A        ; Keep the options so far in #REGd.
 $7C62 LD A,$EF      ; {Read from the keyboard;
 $7C64 OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $7C66 IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$EF | 0 | 9 | 8 | 7 | 6 }
                     ; TABLE#}
 $7C68 CPL           ; Flip the bits, so that a set bit is a key which is
                     ; pressed.
 $7C69 LD E,A        ; Keep the keys that are pressed in #REGe.
 $7C6A LD A,D        ; Fetch the options so far.
; Handle "Serf" selection.
@label=GameSelect_CheckSerf
 $7C6B BIT 4,E       ; {Jump to #R$7C73 if key "6" is not being pressed
 $7C6D JR Z,$7C73    ; ("SERF").}
 $7C6F AND %11100111 ; Keep only bits 0-2 and 5-7.
 $7C71 OR %00010000  ; Set the character to the serf (#N$10).
; Write the options back and keep a copy in #REGc.
@label=GameSelect_StoreOptions
*$7C73 LD ($5E00),A  ; Write the options back to #R$5E00.
 $7C76 LD C,A        ; Keep a copy of the options in #REGc.
; Handle starting a new game.
@label=GameSelect_Start
 $7C77 BIT 0,E       ; {Jump to #R$7D9A if key "0" is being pressed ("START
 $7C79 JP NZ,$7D9A   ; GAME").}
; Highlight the selected control method, then the selected character.
 $7C7C LD HL,$7CEA   ; Point #REGhl at the game select attribute table at
                     ; #R$7CEA.
 $7C7F LD B,$03      ; #REGb=#N$03 (the number of control method entries).
 $7C81 LD A,C        ; Fetch the options.
 $7C82 CALL $7C90    ; Call #R$7C90 to highlight the selected menu entry.
 $7C85 LD B,$03      ; #REGb=#N$03 (the number of character entries).
 $7C87 LD A,C        ; Fetch the options.
 $7C88 RRCA          ; {Rotate #REGa right twice, which brings the character bits into
 $7C89 RRCA          ; position.}
 $7C8A CALL $7C90    ; Call #R$7C90 to highlight the selected menu entry.
 $7C8D JP $7C2F      ; Jump back to #R$7C2F to run the menu again.
; View the equivalent code in;
; #LIST
; { #COOKIE$6298 }
; { #JETPAC$61EB }
; { #LUNARJETMAN$800A }
; { #PSSST$61CD }
; { #SABREWULF$9960 }
; { #TRANZAM$5F07 }
; LIST#

; Flash Menu Selection
;
; Used by the routine at #R$7C19.
; .
; Updates three consecutive entries of the menu attribute table so that
; only the selected entry has its flash (bit 7) set. After the first
; rotation, bits 0-1 of #REGa hold the number of the selected entry (#N$00 to
; #N$02), which counts down as each entry is processed; the entry where it
; reaches zero is flashed.
;
;   A Options, with the selection in bits 1-2
;   B Number of entries (always #N$03)
;   HL First attribute table entry
; O:HL Entry after the last one updated
@label=FlashSelection
c$7C90 RRCA          ; Rotate #REGa right, which brings the selection into bits
                     ; 0-1.
@label=FlashSelection_Loop
*$7C91 AND %00000011 ; Keep only bits 0-1.
 $7C93 JR Z,$7C9C    ; Jump to #R$7C9C if this is the selected entry, which is when the
                     ; selection number has counted down to zero.
 $7C95 CALL $7CA4    ; Call #R$7CA4 to stop this entry flashing.
@label=FlashSelection_Next
*$7C98 DEC A         ; Decrease the selection number by one.
 $7C99 DJNZ $7C91    ; Decrease the entry counter by one and loop back to #R$7C91 until all
                     ; three entries have been updated.
 $7C9B RET           ; Return.
@label=FlashSelection_Selected
*$7C9C CALL $7CAB    ; Call #R$7CAB to make this entry flash.
 $7C9F JR $7C98      ; Jump back to #R$7C98 to move on to the next menu entry.
; These instructions are never used.
 $7CA1 SET 7,(HL)    ; Set bit 7 of *#REGhl.
 $7CA3 INC HL        ; Move #REGhl on to the next menu entry.
; Stop one entry flashing and move on to the next.
@label=FlashSelection_Clear
*$7CA4 RES 7,(HL)    ; Reset bit 7 of *#REGhl.
 $7CA6 INC HL        ; Move #REGhl on to the next menu entry.
 $7CA7 RET           ; Return.
; These instructions are never used.
 $7CA8 RES 7,(HL)    ; Reset bit 7 of *#REGhl.
 $7CAA INC HL        ; Move #REGhl on to the next menu entry.
; Make one entry flash and move on to the next.
@label=FlashSelection_Set
*$7CAB SET 7,(HL)    ; Set bit 7 of *#REGhl.
 $7CAD INC HL        ; Move #REGhl on to the next menu entry.
 $7CAE RET           ; Return.

; Game Selection Menu
;
; Used by the routine at #R$7C19.
; .
; Prints the seven menu lines, then the copyright message and the title.
; The icons were drawn by #R$A311. The main registers are used to step
; through the attribute table at #R$7CEA, whilst the shadow registers step
; through the Y position table at #R$7CF1 and the text at #R$7CF8.
;
; .
;
; #PUSHS #UDGTABLE { #SIM(start=$7C19,stop=$7C32,clear=1,sp=$5E00)
; #SCR$02(game-menu) } UDGTABLE# #POPS
@label=GameMenu
c$7CAF LD HL,$BE4C   ; {Write #N$BE4C (the main font, see #R$BF4C) to #R$5E01.
 $7CB2 LD ($5E01),HL ; }
 $7CB5 LD DE,$7CEA   ; Point #REGde at the menu attribute table at #R$7CEA.
 $7CB8 EXX           ; Switch to the shadow registers.
 $7CB9 LD HL,$7CF1   ; Point #REGhl' at the menu Y position table at #R$7CF1.
 $7CBC LD DE,$7CF8   ; Point #REGde' at the menu text at #R$7CF8.
; There are seven lines of text.
 $7CBF LD B,$07      ; #REGb'=#N$07 (the number of lines to print).
@label=GameMenu_Loop
*$7CC1 EXX           ; Switch back to the normal registers.
 $7CC2 LD A,(DE)     ; {Copy the attribute of the line from the menu attribute table to
 $7CC3 LD ($5E22),A  ; #R$5E22.}
 $7CC6 INC DE        ; Move #REGde on to the text of the line.
 $7CC7 EXX           ; Switch to the shadow registers.
 $7CC8 PUSH BC       ; Stash the line counter on the stack.
 $7CC9 LD A,(HL)     ; Fetch the Y position of the line.
 $7CCA INC HL        ; Move #REGhl' on to the next Y position in the table.
 $7CCB PUSH HL       ; Stash the position table pointer on the stack.
 $7CCC LD H,A        ; Set the Y position of the line in #REGh'.
 $7CCD LD L,$58      ; Set the X position of the line to #N$58 in #REGl'.
 $7CCF CALL $7D8A    ; Call #R$7D8A to print the line.
 $7CD2 EXX           ; Switch to the shadow registers.
 $7CD3 POP HL        ; Restore the position table pointer from the stack.
 $7CD4 POP BC        ; Restore the line counter from the stack.
 $7CD5 INC DE        ; Move #REGde' on to the start of the next line of text.
 $7CD6 DJNZ $7CC1    ; Decrease the line counter by one and loop back to #R$7CC1 until all
                     ; seven lines have been printed.
; Print the copyright message at the bottom of the screen.
 $7CD8 LD HL,$B800   ; #REGhl=#N($B800,$04,$04) (a Y position of #N$B8 and an X position of
                     ; #N$00).
 $7CDB LD DE,$7D51   ; Point #REGde at the copyright messaging at #R$7D51.
 $7CDE CALL $A1F3    ; Call #R$A1F3 to print the string.
; Print the title at the top of the screen.
 $7CE1 LD HL,$0020   ; #REGhl=#N($0020,$04,$04) (a Y position of #N$00 and an X position of
                     ; #N$20).
 $7CE4 LD DE,$7D72   ; Point #REGde at the game selection title text at
                     ; #R$7D72.
 $7CE7 JP $A1F3      ; Jump to #R$A1F3 to print the string.
; View the equivalent code in;
; #LIST
; { #COOKIE$6332 }
; { #JETPAC$6260 }
; { #LUNARJETMAN$80D1 }
; { #PSSST$6250 }
; { #SABREWULF$B473 }
; { #TRANZAM$5F6C }
; { #UNDERWURLDE$90E4 }
; LIST#

; Game Select Attribute Table
;
; The attribute for each of the seven menu lines. Bit 7 (FLASH) is set
; by #R$7C90 for the control method and the character that are currently
; selected, which are held in #R$5E00.
@label=GameSelection_Attributes
b$7CEA DEFB $45      ; {#TABLE(default,centre)
 $7CEB DEFB $45      ; { =h Byte(n) | =h Menu Item }
 $7CEC DEFB $45      ; { #N$01 | 1 Keyboard }
 $7CED DEFB $45      ; { #N$02 | 2 Kempston Joystick }
 $7CEE DEFB $45      ; { #N$03 | 3 Cursor Joystick }
 $7CEF DEFB $45      ; { #N$04 | 4 Knight }
 $7CF0 DEFB $47      ; { #N$05 | 5 Wizard }
                     ; { #N$06 | 6 Serf }
                     ; { #N$07 | 0 Start Game }
                     ; TABLE#}
; View the equivalent code in;
; #LIST
; { #COOKIE$635E }
; { #JETPAC$628D }
; { #LUNARJETMAN$810E }
; { #PSSST$627C }
; { #SABREWULF$B498 }
; { #TRANZAM$5FA7 }
; { #UNDERWURLDE$9119 }
; LIST#

; Game Select Y Position Table
;
; The Y pixel position for each of the seven menu lines. Each line is
; printed starting at an X position of #N$58.
@label=GameSelection_Position
b$7CF1 DEFB $10      ; {#TABLE(default,centre,centre)
 $7CF2 DEFB $28      ; { =h Byte(n) | =h Position | =h Menu Item }
 $7CF3 DEFB $40      ; { #N$01 | #EVAL(#PEEK(#PC+$00) / $08) | 1 Keyboard }
 $7CF4 DEFB $58      ; { #N$02 | #EVAL(#PEEK(#PC+$01) / $08) | 2 Kempston Joystick }
 $7CF5 DEFB $70      ; { #N$03 | #EVAL(#PEEK(#PC+$02) / $08) | 3 Cursor Joystick }
 $7CF6 DEFB $88      ; { #N$04 | #EVAL(#PEEK(#PC+$03) / $08) | 4 Knight }
 $7CF7 DEFB $A0      ; { #N$05 | #EVAL(#PEEK(#PC+$04) / $08) | 5 Wizard }
                     ; { #N$06 | #EVAL(#PEEK(#PC+$05) / $08) | 6 Serf }
                     ; { #N$07 | #EVAL(#PEEK(#PC+$06) / $08) | 0 Start Game }
                     ; TABLE#}
