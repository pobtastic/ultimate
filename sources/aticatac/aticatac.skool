i$5B00

; Decryption Routine
;
; Runs "RRD" on each of the #N($7C00,$04,$04) bytes that start at
; #N$5FFF, which decrypts the game, and then jumps to #R$6000.
;
; .
;
; Set up the address of the first byte to decrypt and the counters.
@label=GameEntry
c$5B80 LD HL,$5FFF   ; #REGhl=#N$5FFF (the address of the first byte to
                     ; decrypt).
 $5B83 LD BC,$007C   ; #REGbc=#N($007C,$04,$04) (#REGb=#N$00 so the inner loop runs #N$0100
                     ; times, and #REGc counts the #N$7C outer passes).
 $5B86 XOR A         ; #REGa=#N$00 (and reset the flags).
; Rotate the nibbles of each byte, chaining the low nibble of one byte
; into the high nibble of the next.
@label=Decryption_Loop
*$5B87 RRD           ; RRD operation on *#REGhl.
 $5B89 INC HL        ; Move #REGhl on to the next byte to decrypt.
 $5B8A DJNZ $5B87    ; Decrease the byte counter (#REGb) by one and loop back to #R$5B87
                     ; until all #N$0100 bytes have been done.
 $5B8C DEC C         ; {Decrease the pass counter (#REGc) by one and loop back to #R$5B87
 $5B8D JR NZ,$5B87   ; until all #N$7C passes have been done.}
 $5B8F JP $6000      ; Jump to #R$6000 to run the security check.
; View the equivalent code in #LUNARJETMAN$5B80.
; .
; Earlier Ultimate games use a much simpler mechanism;
; #LIST
; { #COOKIE$5B80 }
; { #JETPAC$5B80 }
; { #PSSST$5B80 }
; { #TRANZAM$5B80 }
; LIST#

i$5B92

; Game Options
;
; #TABLE(default,centre,centre,centre,centre)
; { =h Byte | =h Binary | =h Character | =h Option }
; { #N$00 | #EVAL($00, $02, $08) | Knight | Keyboard }
; { #N$02 | #EVAL($02, $02, $08) | Knight | Kempston Joystick }
; { #N$04 | #EVAL($04, $02, $08) | Knight | Cursor Joystick }
; { #N$08 | #EVAL($08, $02, $08) | Wizard | Keyboard }
; { #N$0A | #EVAL($0A, $02, $08) | Wizard | Kempston Joystick }
; { #N$0C | #EVAL($0C, $02, $08) | Wizard | Cursor Joystick }
; { #N$10 | #EVAL($10, $02, $08) | Serf | Keyboard }
; { #N$12 | #EVAL($12, $02, $08) | Serf | Kempston Joystick }
; { #N$14 | #EVAL($14, $02, $08) | Serf | Cursor Joystick }
; TABLE#
@label=GameOptions
g$5E00 DEFB $00
; View the equivalent code in;
; #LIST
; { #JETPAC$5CF3 }
; { #PSSST$5E03 }
; { #UNDERWURLDE$8ED5 }
; LIST#

; Font Pointer
;
; Holds a pointer to the currently used font data.
@label=FontPointer
g$5E01 DEFW $0600

; Last Frame
;
; The low byte of FRAMES as it was when #R$7EB2 last ran. The main loop
; compares it with FRAMES to find out whether a new frame has started.
@label=LastFrame
g$5E03 DEFB $00

; In Handlers
;
; Set to #N$01 while #R$7EB2 runs the handlers of the fixed entities, and
; set back to #N$00 when it has finished. Nothing in the game reads it.
@label=InHandlers
g$5E04 DEFB $00

; Random Seed
;
; A random number seed. At the end of every pass through #R$7E23 the value
; of FRAMES and the low byte of the counter at #R$5E12 are added to it. The low
; byte is tested by #R$91C5 to decide whether an open trapdoor closes.
@label=RandomSeed
g$5E05 DEFW $302C

; Unused
;
; Nine bytes that the game does not use.
s$5E07 DEFB $0E,$00,$00,$00,$00,$00,$3A,$EF
 $5E0F DEFB $22

; Sprite Width
;
; The width in bytes of the sprite that is being drawn or removed, or of
; the item whose attribute cells are being set. It is #N$02 when the sprite
; starts on a multiple of eight pixels across, and #N$03 when it does not, as
; the sprite then covers a third byte once it has been shifted.
@label=SpriteWidth
g$5E10 DEFB $22

; Sprite Height
;
; The height in pixel rows of the sprite that is being drawn or removed,
; or of the item whose attribute cells are being set (#N$10 for the items that
; can be picked up).
@label=SpriteHeight
g$5E11 DEFB $AF

; Counter Low
;
; The low byte of a 16-bit counter that is increased by #R$7E23 at the end
; of every pass through the main loop. The handlers use it to make things happen
; on every other pass (bit 0), and to choose the frames of animations.
@label=CounterLow
g$5E12 DEFB $3A

; Counter High
;
; The high byte of the counter that is held in #R$5E12. #R$9924 tests bit
; 0 of it, and #R$98D2 adds it to FRAMES to choose the room of the cyan key.
@label=CounterHigh
g$5E13 DEFB $F5

; Game Flags
;
; Bit 0 is set by #R$7E23 once the entities in the room have been drawn,
; and is reset by #R$9BEA when a new room is going to be drawn. The items in the
; room are only drawn (see #R$91FE) while it is zero. The game does not use any
; of the other bits.
@label=GameFlags
g$5E14 DEFB $AC

; Previous Sprite Id
;
; The sprite ID of the entity that was last stored by #R$9FFB or #R$A00E.
; #R$9E86 uses it to find the old sprite to erase, and #R$8EA0 uses it to put
; the player back after a life has been lost.
@label=Previous_Sprite_Id
g$5E15 DEFB $36

; Previous X Position
;
; The X position of the entity that was last stored by #R$9FFB or #R$A00E.
@label=Previous_X_Position
g$5E16 DEFB $0E

; Previous Y Position
;
; The Y position of the entity that was last stored by #R$9FFB or #R$A00E.
@label=Previous_Y_Position
g$5E17 DEFB $00

; Old Sprite Row Count
;
; The number of rows of the old sprite that are left to be drawn (erased)
; when the rows that overlap with the new sprite have been done. See #R$9E9B.
@label=Old_Sprite_Row_Count
g$5E18 DEFB $00

; New Sprite Row Count
;
; The number of rows of the new sprite that are left to be drawn when the
; rows that overlap with the old sprite have been done. See #R$9E9B.
@label=New_Sprite_Row_Count
g$5E19 DEFB $06

; Room Attribute
;
; The attribute of the floor of the current room, which is read from the
; room attribute table by #R$9BEA. It is the attribute that #R$A01A gives to the
; cells that an entity has left behind.
@label=CurrentRoom_Attribute
g$5E1A DEFB $00

; Room Pointer
;
; The address of the next item to look at in the list of items for the
; current room (see #R$757D). #R$7E23 sets it to the start of the list and moves
; it on by two bytes for each item.
@label=CurrentRoom
g$5E1B DEFW $2C00

; Room Width
;
; The width of the floor of the current room, written by #R$9BEA from the
; shape of the room. It is stored just before the height, so that routines can
; read both with one #REGde or #REGhl load.
@label=CurrentRoom_Width
g$5E1D DEFB $30

; Room Height
;
; The height of the floor of the current room, written by #R$9BEA from the
; shape of the room.
@label=CurrentRoom_Height
g$5E1E DEFB $0E

; Pickup Flags
;
; Stops a single press of the pick up key from picking up or dropping more
; than one item. Bits 0-1 are set by #R$92F5 when an item is picked up, and bit
; 1 is set by #R$93E3 when the inventory is dropped. While either bit is set the
; key does nothing. Bit 1 is reset by #R$92D8 and #R$9417 when the key is not
; pressed, and bit 0 is reset by #R$940E.
@label=PickupFlags
g$5E1F DEFB $00

; Pickup Pressed
;
; Set to #N$02 while the pick up key is pressed, and to #N$00 when it is
; not. It is written by #R$938B.
@label=PickupPressed
g$5E20 DEFB $00

; Lives
;
; The number of lives that the player has left. It starts at #N$03 (see
; #R$7D9A), and is decreased by #R$8EA0 when a life is lost.
;
; .
;
; See #POKE(set_current_lives,Set Current Lives).
; .
; See #POKE(infinite_lives,Infinite Lives).
@label=PlayerLives
g$5E21 DEFB $00

; Menu Item Attribute
;
; The attribute of the line of text that #R$7D8A is printing on the game
; selection screen. #R$7CC1 copies it from the table of attributes at #R$7CEA.
@label=Current_MenuAttribute
g$5E22 DEFB $00

; Line Distance
;
; The longer of the two distances of the line that #R$9C79 is drawing (the
; distance across or the distance up or down). One more than this is the number
; of steps that are taken.
@label=LineDistance
g$5E23 DEFB $00

; Line Flags
;
; The direction of the line that #R$9C79 is drawing. Bit 0 is set if the
; line goes down, and bit 1 is set if it goes right.
@label=LineFlags
g$5E24 DEFB $3A

; Number Creatures
;
; Number of creatures processed this frame.
@label=NumCreatures
g$5E25 DEFB $EF

; Last Creature Room
;
; The room that the player was in when #R$83EA last started the delay
; before a creature is created.
@label=LastCreatureRoom
g$5E26 DEFB $22

; Creature Delay
;
; The number of passes that #R$83EA waits before it starts to create
; creatures in a room. It is set to #N$20 when the player enters a new room, and
; counted down while the player stays in it.
@label=CreatureDelay
g$5E27 DEFB $22

; Player Energy
;
; The energy of the player, which is shown as the chicken at the side of
; the screen. It starts at #N$F0 (see #R$9476). It is decreased when the player
; is hurt (see #R$8ED7) and increased by eating food (see #R$8C63). When it
; reaches zero a life is lost.
@label=PlayerEnergy
g$5E28 DEFB $AF

; Chicken Level
;
; The energy that was last drawn as the chicken, so that #R$8B8A only
; redraws it when the energy has changed enough to make a difference.
@label=ChickenLevel
g$5E29 DEFB $3A

; Score
;
; The score, which is six decimal digits held as three bytes of BCD. The
; most significant byte is first. #R$A19C adds to it and #R$A1AE prints it.
@label=Score_1
g$5E2A DEFB $F5      ; The most significant two digits.
@label=Score_2
 $5E2B DEFB $AC      ; The middle two digits.
@label=Score_3
 $5E2C DEFB $36      ; The least significant two digits.

; In Doorway
;
; The number of axes on which the player is outside the floor of the room,
; as counted by #R$957D. It is zero when the player is not in a doorway.
@label=InDoorway
g$5E2D DEFB $0E

; Door Timer
;
; The time left before the doors that open and close (see #R$915F and
; #R$917D) change. It is counted down every other pass, and set to #N$5E when
; they change.
@label=DoorTimer
g$5E2E DEFB $00

; Walk Counter
;
; Counts the footsteps of the player. #R$A3C7 increases it on every call
; and uses it to alternate the sound.
@label=WalkCounter
g$5E2F DEFB $00

; Inventory 1
;
; The slot of the inventory for the item that has been carried for the
; shortest time. A slot is the address of the entity of the item (two bytes, low
; byte first, or #N$0000 if the slot is empty), then the sprite ID and the
; attribute of the item.
@label=Inventory_Slot1
g$5E30 DEFW $0006
@label=Inventory_Slot1_Sprite_Id
 $5E32 DEFB $00      ; The sprite ID of the item.
 $5E33 DEFB $2C      ; The attribute of the item.

; Inventory 2
;
; The slot of the inventory for the item that has been carried for the
; second shortest time. A slot is the address of the entity of the item (two
; bytes, low byte first, or #N$0000 if the slot is empty), then the sprite ID
; and the attribute of the item.
@label=Inventory_Slot2
g$5E34 DEFW $0E30
 $5E36 DEFB $00      ; The sprite ID of the item.
@label=Inventory_Slot2_Attribute
 $5E37 DEFB $00      ; The attribute of the item.

; Inventory 3
;
; The slot of the inventory for the item that has been carried for the
; longest time. A slot is the address of the entity of the item (two bytes, low
; byte first, or #N$0000 if the slot is empty), then the sprite ID and the
; attribute of the item.
@label=Inventory_Slot3
g$5E38 DEFW $0000
 $5E3A DEFB $00      ; The sprite ID of the item.
@label=Inventory_Slot3_Attribute
 $5E3B DEFB $3A      ; The attribute of the item.

; Flash Timer
;
; The time left before the player starts to appear at the start of a life.
; #R$9443 sets it to #N$68, and #R$8C8C counts it down (see #R$8CB7) while the
; score flashes.
@label=FlashTimer
g$5E3C DEFB $EF

; Clock Hours
;
; The hours of the clock that is shown at the top of the screen, as BCD.
; See #R$95DA.
@label=ClockHours
g$5E3D DEFB $22

; Clock Minutes
;
; The minutes of the clock that is shown at the top of the screen, as BCD.
; See #R$95DA.
@label=ClockMinutes
g$5E3E DEFB $22

; Clock Seconds
;
; The seconds of the clock that is shown at the top of the screen, as BCD.
; See #R$95DA.
@label=ClockSeconds
g$5E3F DEFB $AF

; Visited Rooms
;
; One bit for each room, set by #R$96AF when the player has been in it.
; There are #N$08 rooms to a byte, so the bit for a room is bit (room MOD #N$08)
; of byte (room / #N$08). #R$96C9 counts the bits.
@label=VisitedRooms
g$5E40 DEFB $3A
 $5E41 DEFB $F5
 $5E42 DEFB $C0
 $5E43 DEFB $32
 $5E44 DEFB $33
 $5E45 DEFB $34
 $5E46 DEFB $32
 $5E47 DEFB $34
 $5E48 DEFB $0E
 $5E49 DEFB $00
 $5E4A DEFB $00
 $5E4B DEFB $80
 $5E4C DEFB $5B
 $5E4D DEFB $00
 $5E4E DEFB $0D
 $5E4F DEFB $00
 $5E50 DEFB $00
 $5E51 DEFB $00
 $5E52 DEFB $00
 $5E53 DEFB $00
; View the equivalent code in;
; #LIST
; { #SABREWULF$96BF }
; LIST#

; Visited Percentage
;
; The percentage of the rooms that the player has visited, as BCD. It is
; calculated by #R$96C9 and shown by #R$9641.
@label=VisitedPercentage
g$5E54 DEFB $00

; Food Pointer
;
; The address of the entity that #R$9924 will look at next, to see whether
; it can be made into a food item. It starts at #R$EB58 (see #R$7DA2).
@label=FoodPointer
g$5E55 DEFW $0000

; Unused
;
; The rest of the game variables. These bytes are not used.
s$5E57 DEFS $01A9

; Security Check
;
; Used by the routine at #R$5B80.
; .
; A short check on the second byte of FRAMES. The game only continues
; into #R$7C19 when it holds the expected value; otherwise the "RET" takes
; its return address from the game variables at #R$5E00.
@label=SecurityCheck
c$6000 DI            ; Disable interrupts.
 $6001 LD SP,$5E00   ; Set the stack pointer to #N$5E00.
 $6004 LD A,($5C79)  ; Fetch the second byte of FRAMES.
 $6007 CP $25        ; {Return if the second byte of FRAMES is not #N$25, which is the value
 $6009 RET NZ        ; that the game expects.}
 $600A JP $7C19      ; Jump to #R$7C19 to initialise the game.
; View the equivalent code in;
; #LIST
; { #COOKIE$5F00 }
; { #JETPAC$61E5 }
; { #LUNARJETMAN$8000 }
; { #PSSST$61C6 }
; { #TRANZAM$5F00 }
; LIST#

; Player Initialisation Data
;
; The entity for the player, which is copied to #R$EA90 when the game is
; reset (see #R$8D61). It is all zero because #R$9443 sets it up from the
; template at #R$9481 at the start of each life. #R$EA90 describes the layout of
; an entity.
@label=Initialisation_Player
g$600D DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; Not set up yet.

; Weapon Initialisation Data
;
; The entity for the weapon that the player throws, which is copied to
; #R$EA98. The weapon is a 16-byte record, and the sound entity that follows is
; its second half. The flags are at offset #N$02 and the velocities are at
; offsets #N$06 and #N$07, and the lifetime is at offset #N$0F (see #R$817C).
; The sprite ID is zero while the weapon is not in use.
@label=Initialisation_Weapon
g$6015 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; Not in use.

; Sound Initialisation Data
;
; The entity for the sound effects, which is copied to #R$EAA0. The first
; byte is the handler of the sound and the second byte is the count of notes
; left to play (see #R$A3E8). Both are zero when there is no sound. The last
; byte of it is the lifetime of the weapon.
@label=Initialisation_Sound
g$601D DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; No sound to play.

; A.C.G. Initialisation Data
;
; The left, middle and right pieces of the A.C.G. key. The room of each is
; put in at the start of the game by #R$94B6, so the rooms here are not used.
; The three pieces open the A.C.G. door when they are all in the inventory (see
; #R$961B).
@label=Initialisation_Key_ACG
g$6025 DEFB $8C      ; Sprite ID: #SPRITENAME(#PEEK(#PC) - $01).
@label=Initialisation_Key_ACG_Room
 $6026 DEFB $00      ; Room: #N(#PEEK(#PC)).
 $6027 DEFB $00      ; Flags: #N(#PEEK(#PC)).
 $6028 DEFB $58      ; X position: #N(#PEEK(#PC)).
 $6029 DEFB $58      ; Y position: #N(#PEEK(#PC)).
 $602A DEFB $46      ; Attribute: #COLOUR(#PEEK(#PC)).
 $602B DEFB $00,$00  ; Not used.
 $602D DEFB $8D      ; Sprite ID: #SPRITENAME(#PEEK(#PC) - $01).
 $602E DEFB $00      ; Room: #N(#PEEK(#PC)).
 $602F DEFB $00      ; Flags: #N(#PEEK(#PC)).
 $6030 DEFB $58      ; X position: #N(#PEEK(#PC)).
 $6031 DEFB $58      ; Y position: #N(#PEEK(#PC)).
 $6032 DEFB $46      ; Attribute: #COLOUR(#PEEK(#PC)).
 $6033 DEFB $00,$00  ; Not used.
 $6035 DEFB $8E      ; Sprite ID: #SPRITENAME(#PEEK(#PC) - $01).
 $6036 DEFB $00      ; Room: #N(#PEEK(#PC)).
 $6037 DEFB $00      ; Flags: #N(#PEEK(#PC)).
 $6038 DEFB $58      ; X position: #N(#PEEK(#PC)).
 $6039 DEFB $58      ; Y position: #N(#PEEK(#PC)).
 $603A DEFB $46      ; Attribute: #COLOUR(#PEEK(#PC)).
 $603B DEFB $00,$00  ; Not used.

; Key Initialisation Data
;
; The green, red, cyan and yellow keys. The rooms of the green, red and
; cyan keys are chosen at the start of every game by #R$98D2, so the rooms here
; are not used for them. Each key opens the locked doors of its own colour (see
; #R$9222).
