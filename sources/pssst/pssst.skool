@replace=/#DIMENSIONS/Dimensions #EVAL(#PEEK(#PC + $01) * $08) pixels x #EVAL(#PEEK(#PC + $02), $0A, $02) pixels.
@expand=#DEF(#FONT(id) #EVAL($7B4A + $id * $08))
i$5B00

; Game Entry Point
;
; Moves the whole game image down by one byte, then jumps to the
; security check. The #N$2114 bytes from #N$5EED up to the end of the game
; at #N$7FFF are copied to #N$5EEC onwards.
@label=GameEntry
c$5B80 DI            ; Disable interrupts.
 $5B81 LD HL,$5EED   ; {Copy #N$2114 bytes of the game from #N$5EED to #N$5EEC.
 $5B84 LD DE,$5EEC   ;
 $5B87 LD BC,$2114   ;
 $5B8A LDIR          ; }
 $5B8C JP $61C6      ; Jump to #R$61C6.
; View the equivalent code in;
; #LIST
; { #COOKIE$5B80 }
; { #JETPAC$5B80 }
; { #TRANZAM$5B80 }
; { #UNDERWURLDE$67F2 }
; LIST#
; .
; Later Ultimate games use more advanced decryption mechanisms;
; #LIST
; { #ATICATAC$5B80 }
; { #LUNARJETMAN$5B80 }
; LIST#

i$5B8F

; Indirect Jump
;
; Used by the routine at #R$634F.
; .
; Jumps to the routine whose address is held in #REGhl.
;
; HL Jump address
@label=IndirectJump
c$5CB0 JP (HL)       ; Jump to the address held in #REGhl.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$5CB0 }
; { #LUNARJETMAN$5CB0 }
; { #SABREWULF$5CB0 }
; LIST#

; Stack
;
; The game's stack. The stack pointer is set to #N$5D00 by #R$61EA and
; #R$634F and the stack grows downwards from there. The bytes held here in
; the snapshot are left over from the BASIC loader.
@label=Stack
g$5CB1 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $5CC1 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$01,$77,$01,$FD,$32
 $5CD1 DEFB $34,$32,$39,$39,$0E,$00,$00,$EB,$5E,$00,$3A,$D7,$2E,$31,$0E,$7D
 $5CE1 DEFB $4C,$CC,$CC,$CC,$2C,$31,$0E,$00,$00,$01,$00,$00,$3A,$D7,$2E,$31
 $5CF1 DEFB $0E,$7D,$4C,$CC,$CC,$CC,$2C,$32,$0E,$00,$00,$02,$00,$00,$3A

; Unused
;
; Not used by the game. The bytes held here in the snapshot are left
; over from the BASIC loader.
@label=Unused_After_Stack
u$5D00 DEFB $D7,$2E,$31,$0E,$7D,$4C,$CC,$CC
 $5D08 DEFB $CC,$2C,$33,$0E,$00,$00,$03,$00
 $5D10 DEFB $00,$3A,$D7,$2E,$31,$0E,$7D,$4C
 $5D18 DEFB $CC,$CC,$CC,$2C,$34,$0E,$00,$00
 $5D20 DEFB $04,$00,$00,$3A,$D7,$2E,$31,$0E
 $5D28 DEFB $7D,$4C,$CC,$CC,$CC,$2C,$35,$0E
 $5D30 DEFB $00,$00,$05,$00,$00,$3A,$DA,$30
 $5D38 DEFB $0E,$00,$00,$00,$00,$00,$3A,$D9
 $5D40 DEFB $37,$0E,$00,$00,$07,$00,$00,$3A
 $5D48 DEFB $DC,$31,$0E,$00,$00,$01,$00,$00
 $5D50 DEFB $3A,$FB,$3A,$F5,$DC,$31,$0E,$00
 $5D58 DEFB $00,$01,$00,$00,$3B,$D9,$37,$0E
 $5D60 DEFB $00,$00,$07,$00,$00,$3B,$AC,$39
 $5D68 DEFB $0E,$00,$00,$09,$00,$00,$2C,$37
 $5D70 DEFB $0E,$00,$00,$07,$00,$00,$3B,$22
 $5D78 DEFB $50,$53,$53,$53,$54,$20,$49,$53
 $5D80 DEFB $20,$4C,$4F,$41,$44,$49,$4E,$47
 $5D88 DEFB $22,$3B,$AC,$31,$32,$0E,$00,$00
 $5D90 DEFB $0C,$00,$00,$2C,$31,$30,$0E,$00
 $5D98 DEFB $00,$0A,$00,$00,$3B,$22,$14,$01
 $5DA0 DEFB $50,$4C,$45,$41,$53,$45,$20,$57
 $5DA8 DEFB $41,$49,$54,$22,$14,$00,$3A,$F5
 $5DB0 DEFB $AC,$30,$0E,$00,$00,$00,$00,$00
 $5DB8 DEFB $2C,$30,$0E,$00,$00,$00,$00,$00
 $5DC0 DEFB $3A,$EF,$22,$22,$AA,$3A,$D9,$30
 $5DC8 DEFB $0E,$00,$00,$00,$00,$00,$3A,$DA
 $5DD0 DEFB $30,$0E,$00,$00,$00,$00,$00,$3A
 $5DD8 DEFB $F5,$AC,$31,$33,$0E,$00,$00,$0D
 $5DE0 DEFB $00,$00,$2C,$30,$0E,$00,$00,$00
 $5DE8 DEFB $00,$00,$3A,$EF,$22,$22,$AF,$3A
 $5DF0 DEFB $F5,$AC,$31,$33,$0E,$00,$00,$0D
 $5DF8 DEFB $00,$00,$2C,$30,$0E,$00,$00,$00

; High Score
;
; 3-byte representation of the score.
@label=High_Score
g$5E00 DEFB $00,$00,$3A
; View the equivalent code in;
; #LIST
; { #COOKIE$5F09 }
; { #JETPAC$5CF0 }
; { #LUNARJETMAN$5E06 }
; { #SABREWULF$B304 }
; { #TRANZAM$5E49 }
; LIST#

; Game Options
;
; Holds the number of players and the chosen control method.
; #TABLE(default,centre,centre)
; { =h Byte | =h Binary | =h Option }
; { #N$00 | #EVAL($00, $02, $08) | 1UP Game + Keyboard }
; { #N$01 | #EVAL($01, $02, $08) | 2UP Game + Keyboard }
; { #N$02 | #EVAL($02, $02, $08) | 1UP Game + Kempston Joystick }
; { #N$03 | #EVAL($03, $02, $08) | 2UP Game + Kempston Joystick }
; TABLE#
;
; .
;
; "Number of Players" on Bit #N$00.
; .
; "Control Method" on Bit #N$01.
@label=GameOptions
g$5E03 DEFB $EF
; View the equivalent code in;
; #LIST
; { #ATICATAC$5E00 }
; { #COOKIE$5F0C }
; { #JETPAC$5CF3 }
; { #LUNARJETMAN$5E00 }
; { #UNDERWURLDE$8ED5 }
; LIST#

; Sound Mute Flag
;
; Tunes are only played if this is #N$00, and are muted if it is not (see
; #R$66DF). It is set from the checksum of the BEEPER routine in the ROM,
; which is stored by #R$61E3.
@label=Sound_Enable
g$5E04 DEFB $22

; 1UP Score
;
; 3-byte representation of the score.
@label=1UP_Score_1
g$5E05 DEFB $22      ; Byte #1.
@label=1UP_Score_2
 $5E06 DEFB $AF      ; Byte #2.
@label=1UP_Score_3
 $5E07 DEFB $3A      ; Byte #3.

; 2UP Score
;
; 3-byte representation of the score.
@label=2UP_Score_1
g$5E08 DEFB $F5      ; Byte #1.
@label=2UP_Score_2
 $5E09 DEFB $AC      ; Byte #2.
@label=2UP_Score_3
 $5E0A DEFB $31      ; Byte #3.

; Temporary Sprite State
;
; The saved position and state of the object which is being drawn, and the
; details of the sprites being drawn. The object position and state are saved
; by #R$75B9 and the sprite details are set by #R$74A5 and #R$74C0. #R$5E0F is
; also used as a dummy object when drawing the items in the cubby holes, so
; that #R$7450 can fetch the colour from #R$5E12.
@label=Actor
g$5E0B DEFB $33      ; Saved X position of the object.
 $5E0C DEFB $0E      ; Saved Y position of the object.
 $5E0D DEFB $00      ; Saved state of the object.
 $5E0E DEFB $00      ; Height of the new sprite in pixel rows (set by #R$74C0).
@label=NewSprite_Width
 $5E0F DEFB $0D      ; Width of the new sprite in bytes (set by #R$74C0).
 $5E10 DEFB $00      ; Rows of the previous sprite still to be erased.
 $5E11 DEFB $00      ; Rows of the new sprite still to be drawn.
 $5E12 DEFB $2C      ; Colour attribute of the cubby hole item being drawn (set by
                     ; #R$5FDE).

; Bug Start Cubby Hole
;
; The number of the cubby hole that the next bug will start from, which is
; written by #R$7164 and read by #R$7262.
@label=BugStart_CubbyHole
g$5E13 DEFB $30

; Unused
;
; Not referenced by any code.
@label=Unused_After_Bug_Start_Cubby_Hole
u$5E14 DEFB $0E

; Leaf Growth Flags
;
; Used to grow the leaves of the flower (see #R$6C0E and #R$6D0C).
; #LIST
; { Bit 6 is flipped each time a leaf is added, so that the leaves alternate
; between the right and the left of the flower. }
; { Bit 0 is set when a leaf is added and is reset when the flower moves, to
; stop another leaf being added until then. }
; LIST#
@label=LeafGrowth_Flags
g$5E15 DEFB $00

; Bug Count
;
; The number of bugs found in the current pass through the objects. It is
; set to #N$00 at the start of each pass (#R$6358), added to by every bug that
; is updated (#R$64ED) and used by #R$7164 to decide whether a new bug should
; be added. The most there can be is #N$06.
@label=CurrentBug_ID
g$5E16 DEFB $00

; Game Timer
;
; A 16-bit counter which is increased by one at the end of every full pass
; through the objects (see #R$7145). It is used for timing, such as when leaves
; grow and when the bonus item flashes. It goes back to #N$0000 after
; #N$FFFF.
@label=GameTimer
g$5E17 DEFW $0000

; Random Number
;
; The random number is added to every time an object has been updated
; (#R$7130). At the end of each pass it is also added to the byte of the ROM
; at the address given by the low byte of the game timer, and to the refresh
; register (#R$7156).
@label=RandomNumber
g$5E19 DEFB $00

; Sprite Screen Position
;
; The position of the sprite most recently set up by #R$74C0 (X in
; #REGl, Y in #REGh), after the horizontal offset from the sprite data has
; been added.
@label=SpritePosition
g$5E1A DEFW $EF3A

; Free Weapon Slot
;
; The address of the first free weapon object, which is either #R$5E7C or
; #R$5E84 (each #N$08 bytes), set by #R$6B70.
@label=FreeWeaponSlot
g$5E1C DEFW $2222

; Current Player
;
; Either #N$00 for 1UP or #N$FF for 2UP.
@label=Current_Player
g$5E1E DEFB $AF

; Last Frame
;
; Holds a copy of the last #SKOOLKID$5C78(FRAMES) counter.
@label=LastFrame
g$5E1F DEFB $3A

; Frame Updated
;
; Has the frame been updated? #N$00=No #N$01=Yes.
@label=FrameUpdated
g$5E20 DEFB $F5

; Menu Item Attribute
;
; Current menu item colour attribute.
@label=Current_MenuAttribute
g$5E21 DEFB $AC

; "Get Ready" Delay Counter
;
; Counts down while Robbie waits at the start of a turn (set by #R$6191,
; to #N$80 for a 1UP game and #N$FF for a 2UP game), during which the label of
; the active player flashes and no bugs are added.
@label=PlayDelay_Counter
g$5E22 DEFB $31

; Cubby Holes
;
; The contents of the ten cubby holes of the active player. Holes #N$00 to
; #N$04 are on the left (X position #N$08) and holes #N$05 to #N$09 are on the
; right (X position #N$E8), each going down the screen from the top.
; .
; An empty hole is #N$00. For a spray can, bits 0-2 are the colour and bit 3
; is set. A hole is #N$FF when a bonus item is waiting there (see #R$71BE) and
; is set to #N$80 when Robbie collects it.
@label=CubbyHoles
g$5E23 DEFB $33      ; {Left-hand holes.
 $5E24 DEFB $0E      ;
 $5E25 DEFB $00      ;
 $5E26 DEFB $00      ;
 $5E27 DEFB $0D      ; }
 $5E28 DEFB $00      ; {Right-hand holes.
 $5E29 DEFB $00      ;
 $5E2A DEFB $2C      ;
 $5E2B DEFB $30      ;
 $5E2C DEFB $0E      ; }

; Inactive Player Cubby Holes
;
; The cubby holes of the player who is not active in a two player game.
; They are swapped with the holes at #R$5E23 when the active player changes
; (see #R$6146).
@label=InactivePlayer_CubbyHoles
g$5E2D DEFB $00
 $5E2E DEFB $00
 $5E2F DEFB $00
 $5E30 DEFB $00
 $5E31 DEFB $00
 $5E32 DEFB $3A
 $5E33 DEFB $EF
 $5E34 DEFB $22
 $5E35 DEFB $22
 $5E36 DEFB $AF

; Active Player Level
;
; Note that level 1 is #N$00.
@label=ActivePlayer_Level
g$5E37 DEFB $3A

; Active Player Lives
;
; The currently active players remaining lives.
@label=CurrentPlayer_Lives
g$5E38 DEFB $F5

; Inactive Player Level
;
; Note that level 1 is #N$00.
@label=InactivePlayer_Level
g$5E39 DEFB $C0

; Inactive Player Lives
;
; The inactive players remaining lives.
@label=InactivePlayer_Lives
g$5E3A DEFB $32

; Bugs Eating Flower
;
; The number of bugs which have been eating the flower during the current
; pass through the objects. Each bug that is eating adds one (#R$6B3A), and the
; flower uses the total and then resets it to #N$00 (#R$6D84).
@label=BugsEating_Flower
g$5E3B DEFB $33

; Bonus Item State
;
; The bonus item, which sits in a cubby hole until Robbie collects it (see
; #R$71BE and #R$721A). It is an object which is not in the main table.
@label=State_BonusItem
g$5E3C DEFB $34      ; State: #N$00 when there is no bonus item, or the type #N$0B, #N$0C
                     ; or #N$0D.
 $5E3D DEFB $32      ; X position (#N$08 or #N$E8).
 $5E3E DEFB $34      ; Y position.
 $5E3F DEFB $0E      ; Colour attribute (it flashes).
 $5E40 DEFB $00      ; What the cubby hole contains while the bonus item is waiting
                     ; (#N$FF).
 $5E41 DEFB $00      ; The number of the cubby hole.
 $5E42 DEFB $80      ; {Not used.
 $5E43 DEFB $5B      ; }

; Inactive Player Flower And Leaves
;
; The flower and the four leaves of the player who is not active in a two
; player game. They are swapped with the objects at #R$5E8C when the active
; player changes (see #R$6151).
@label=InactivePlayer_Flower
g$5E44 DEFB $00      ; {Flower.
 $5E45 DEFB $0D      ;
 $5E46 DEFB $00      ;
 $5E47 DEFB $00      ;
 $5E48 DEFB $00      ;
 $5E49 DEFB $00      ;
 $5E4A DEFB $00      ;
 $5E4B DEFB $00      ; }
 $5E4C DEFB $00      ; {Leaf 1.
 $5E4D DEFB $00      ;
 $5E4E DEFB $00      ;
 $5E4F DEFB $00      ;
 $5E50 DEFB $00      ;
 $5E51 DEFB $00      ;
 $5E52 DEFB $00      ;
 $5E53 DEFB $00      ; }
 $5E54 DEFB $00      ; {Leaf 2.
 $5E55 DEFB $00      ;
 $5E56 DEFB $00      ;
 $5E57 DEFB $00      ;
 $5E58 DEFB $00      ;
 $5E59 DEFB $00      ;
 $5E5A DEFB $00      ;
 $5E5B DEFB $00      ; }
 $5E5C DEFB $00      ; {Leaf 3.
 $5E5D DEFB $00      ;
 $5E5E DEFB $00      ;
 $5E5F DEFB $00      ;
 $5E60 DEFB $00      ;
 $5E61 DEFB $00      ;
 $5E62 DEFB $00      ;
 $5E63 DEFB $00      ; }
 $5E64 DEFB $00      ; {Leaf 4.
 $5E65 DEFB $00      ;
 $5E66 DEFB $00      ;
 $5E67 DEFB $00      ;
 $5E68 DEFB $00      ;
 $5E69 DEFB $00      ;
 $5E6A DEFB $00      ;
 $5E6B DEFB $00      ; }

; Robbie State
;
; Robbie is the first of the objects which are updated in each pass.
@label=State_Robbie_Active
g$5E6C DEFB $00      ; State: #N$00 inactive, #N$01 empty-handed or #N$02 carrying a can
                     ; of pesticide.
@label=State_Robbie_Pos_X
 $5E6D DEFB $00      ; X position.
@label=State_Robbie_Pos_Y
 $5E6E DEFB $00      ; Y position.
@label=State_Robbie_Colour
 $5E6F DEFB $00      ; Colour attribute.
@label=State_Robbie_Flags
 $5E70 DEFB $00      ; Flags: bit 0 is set when Robbie faces left, bit 2 is set while he
                     ; cannot pick up an item and bit 3 is set when he has just picked up a can.
 $5E71 DEFB $00      ; Not used.
@label=State_Robbie_LastItem
 $5E72 DEFB $00      ; The last item that Robbie dropped, so that he does not pick it up
                     ; again straight away.
 $5E73 DEFB $00      ; Not used.

; Spray Can State
;
; The spray can which Robbie is carrying (see #R$6ED2).
@label=State_SprayCan
g$5E74 DEFB $00      ; State: #N$00 inactive or #N$03 active.
 $5E75 DEFB $00      ; X position.
 $5E76 DEFB $00      ; Y position.
 $5E77 DEFB $00      ; Colour attribute.
 $5E78 DEFB $00      ; Bit 0 is set when the can is being put away in a cubby
                     ; hole.
 $5E79 DEFB $00      ; New X position, which Robbie works out.
 $5E7A DEFB $00      ; New Y position, which Robbie works out.
 $5E7B DEFB $00      ; Not used.

; Weapon 1 State
;
; The first of the two weapons that Robbie can fire at once (see #R$6B70).
@label=State_Weapon_1
g$5E7C DEFB $00      ; State: #N$00 inactive, or the type of weapon and its
                     ; direction.
 $5E7D DEFB $00      ; X position.
 $5E7E DEFB $00      ; Y position.
 $5E7F DEFB $00      ; Colour attribute.
 $5E80 DEFB $00      ; Age of a smoke bomb.
 $5E81 DEFB $00      ; Set when the weapon has hit a bug.
 $5E82 DEFB $00      ; {Not used.
 $5E83 DEFB $00      ; }

; Weapon 2 State
;
; The second of the two weapons that Robbie can fire at once. It has the
; same fields as #R$5E7C.
@label=State_Weapon_2
g$5E84 DEFB $00
 $5E85 DEFB $00
 $5E86 DEFB $00
 $5E87 DEFB $00
 $5E88 DEFB $00
 $5E89 DEFB $00
 $5E8A DEFB $00
 $5E8B DEFB $00

; Flower State
;
; The flower (see #R$6D0C).
@label=State_Flower
g$5E8C DEFB $00      ; State: #N$10 growing or #N$13 blooming.
@label=State_Flower_Pos_X
 $5E8D DEFB $00      ; X position.
@label=State_Flower_Pos_Y
 $5E8E DEFB $00      ; Y position.
@label=State_Flower_Colour
 $5E8F DEFB $00      ; Colour attribute.
@label=State_Flower_Leaves
 $5E90 DEFB $00      ; The number of leaves on the flower.
 $5E91 DEFB $00      ; Timer until the flower next moves.
 $5E92 DEFB $00      ; The number of bugs seen eating the flower the last time.
 $5E93 DEFB $00      ; Not used.

; Leaf Data
;
; The four leaves of the flower (see #R$6C53). Each leaf is an object of
; eight bytes. Bit 6 of the state is set when the leaf is on the left of the
; flower. The other fields are the position, the colour, a flag which is set
; while the leaf is animating, a flag which is set once it is being eaten, and
; the frame.
;
; .
;
; Leaf 1 data.
@label=Leaf_1_State
g$5E94 DEFB $00      ; Leaf "1" state.
                     ; #TABLE(default,centre,centre) { =h Value | =h State }
                     ; { #N$00 | Inactive }
                     ; { #N$11 | Right-hand side }
                     ; { #N$51 | Left-hand side }
                     ; TABLE#
@label=Leaf_1_Pos_X
 $5E95 DEFB $00      ; Leaf "1" X position in pixels.
@label=Leaf_1_Pos_Y
 $5E96 DEFB $00      ; Leaf "1" Y position in pixels.
@label=Leaf_1_Colour
 $5E97 DEFB $00      ; Leaf "1" colour attribute.
@label=Leaf_1_Animating
 $5E98 DEFB $00      ; Leaf "1" animating flag (#N$01 while it is growing or
                     ; shrinking).
@label=Leaf_1_Eaten
 $5E99 DEFB $00      ; Leaf "1" eaten flag (#N$01 once the leaf is being
                     ; eaten).
@label=Leaf_1_Frame
 $5E9A DEFB $00      ; Leaf "1" frame ID.
 $5E9B DEFB $00      ; Not used.
; Leaf 2 data.
@label=Leaf_2_State
 $5E9C DEFB $00      ; Leaf "2" state.
                     ; #TABLE(default,centre,centre) { =h Value | =h State }
                     ; { #N$00 | Inactive }
                     ; { #N$11 | Right-hand side }
                     ; { #N$51 | Left-hand side }
                     ; TABLE#
@label=Leaf_2_Pos_X
 $5E9D DEFB $00      ; Leaf "2" X position in pixels.
@label=Leaf_2_Pos_Y
 $5E9E DEFB $00      ; Leaf "2" Y position in pixels.
@label=Leaf_2_Colour
 $5E9F DEFB $00      ; Leaf "2" colour attribute.
@label=Leaf_2_Animating
 $5EA0 DEFB $00      ; Leaf "2" animating flag (#N$01 while it is growing or
                     ; shrinking).
@label=Leaf_2_Eaten
 $5EA1 DEFB $00      ; Leaf "2" eaten flag (#N$01 once the leaf is being
                     ; eaten).
@label=Leaf_2_Frame
 $5EA2 DEFB $00      ; Leaf "2" frame ID.
 $5EA3 DEFB $00      ; Not used.
; Leaf 3 data.
@label=Leaf_3_State
 $5EA4 DEFB $00      ; Leaf "3" state.
                     ; #TABLE(default,centre,centre) { =h Value | =h State }
                     ; { #N$00 | Inactive }
                     ; { #N$11 | Right-hand side }
                     ; { #N$51 | Left-hand side }
                     ; TABLE#
@label=Leaf_3_Pos_X
 $5EA5 DEFB $00      ; Leaf "3" X position.
@label=Leaf_3_Pos_Y
 $5EA6 DEFB $00      ; Leaf "3" Y position.
@label=Leaf_3_Colour
 $5EA7 DEFB $00      ; Leaf "3" colour attribute.
@label=Leaf_3_Animating
 $5EA8 DEFB $00      ; Leaf "3" animating flag (#N$01 while it is growing or
                     ; shrinking).
@label=Leaf_3_Eaten
 $5EA9 DEFB $00      ; Leaf "3" eaten flag (#N$01 once the leaf is being
                     ; eaten).
@label=Leaf_3_Frame
 $5EAA DEFB $00      ; Leaf "3" frame ID.
 $5EAB DEFB $00      ; Not used.
; Leaf 4 data.
@label=Leaf_4_State
 $5EAC DEFB $00      ; Leaf "4" state.
                     ; #TABLE(default,centre,centre) { =h Value | =h State }
                     ; { #N$00 | Inactive }
                     ; { #N$11 | Right-hand side }
                     ; { #N$51 | Left-hand side }
                     ; TABLE#
@label=Leaf_4_Pos_X
 $5EAD DEFB $00      ; Leaf "4" X position.
@label=Leaf_4_Pos_Y
 $5EAE DEFB $00      ; Leaf "4" Y position.
@label=Leaf_4_Colour
 $5EAF DEFB $00      ; Leaf "4" colour attribute.
@label=Leaf_4_Animating
 $5EB0 DEFB $00      ; Leaf "4" animating flag (#N$01 while it is growing or
                     ; shrinking).
@label=Leaf_4_Eaten
 $5EB1 DEFB $00      ; Leaf "4" eaten flag (#N$01 once the leaf is being
                     ; eaten).
@label=Leaf_4_Frame
 $5EB2 DEFB $00      ; Leaf "4" frame ID.
 $5EB3 DEFB $00      ; Not used.

; Bug State
;
; The six bugs, each an object of eight bytes. A bug is inactive (state
; #N$00) or is a slug (#N$07), a swarm of midges (#N$09) or a leech (#N$0A).
; The fields of a bug are:
; #TABLE(default,centre)
; { =h Field | =h Use }
; { +0 | State, with the direction of movement in bits 6 and 7 }
; { +1 | X position }
; { +2 | Y position }
; { +3 | Colour attribute }
; { +4 | Bit 2 is set when the bug is stunned, bit 3 when it is eating the
; flower and (for a leech) bit 0 when it is moving vertically }
; { +5 | The stun timer, the horizontal motion of midges or a counter used
; while eating }
; { +6 | The vertical movement counter, the vertical motion of midges or the
; Y position where the bug started eating }
; { +7 | The height of the sprite in pixels, used to find collisions }
; TABLE#
@label=State_Bugs
g$5EB4 DEFB $00      ; {Bug 1.
 $5EB5 DEFB $00      ;
 $5EB6 DEFB $00      ;
 $5EB7 DEFB $00      ;
 $5EB8 DEFB $00      ;
 $5EB9 DEFB $00      ;
 $5EBA DEFB $00      ;
 $5EBB DEFB $00      ; }
 $5EBC DEFB $00      ; {Bug 2.
 $5EBD DEFB $00      ;
 $5EBE DEFB $00      ;
 $5EBF DEFB $00      ;
 $5EC0 DEFB $00      ;
 $5EC1 DEFB $00      ;
 $5EC2 DEFB $00      ;
 $5EC3 DEFB $00      ; }
 $5EC4 DEFB $00      ; {Bug 3.
 $5EC5 DEFB $00      ;
 $5EC6 DEFB $00      ;
 $5EC7 DEFB $00      ;
 $5EC8 DEFB $00      ;
 $5EC9 DEFB $00      ;
 $5ECA DEFB $00      ;
 $5ECB DEFB $00      ; }
 $5ECC DEFB $00      ; {Bug 4.
 $5ECD DEFB $00      ;
 $5ECE DEFB $00      ;
 $5ECF DEFB $00      ;
 $5ED0 DEFB $00      ;
 $5ED1 DEFB $00      ;
 $5ED2 DEFB $00      ;
 $5ED3 DEFB $00      ; }
 $5ED4 DEFB $00      ; {Bug 5.
 $5ED5 DEFB $00      ;
 $5ED6 DEFB $00      ;
 $5ED7 DEFB $00      ;
 $5ED8 DEFB $00      ;
 $5ED9 DEFB $00      ;
 $5EDA DEFB $00      ;
 $5EDB DEFB $00      ; }
 $5EDC DEFB $00      ; {Bug 6.
 $5EDD DEFB $00      ;
 $5EDE DEFB $00      ;
 $5EDF DEFB $00      ;
 $5EE0 DEFB $00      ;
 $5EE1 DEFB $00      ;
 $5EE2 DEFB $00      ;
 $5EE3 DEFB $00      ; }

; Explosion State
;
; The explosion, which is the last of the objects (see #R$65F7). It is
; state #N$15 (which does nothing) until an object explodes.
@label=State_Explosion
g$5EE4 DEFB $00      ; State: #N$15 inactive or #N$14 exploding.
 $5EE5 DEFB $00      ; X position.
 $5EE6 DEFB $00      ; Y position.
 $5EE7 DEFB $00      ; Colour attribute.
 $5EE8 DEFB $00      ; The frame of the explosion.
 $5EE9 DEFB $00      ; The mask which sets the speed of the explosion.
 $5EEA DEFB $00      ; The state of the object which exploded, so that it can
                     ; be put back.
 $5EEB DEFB $00      ; Not used.

; Messaging: Unused Text
;
; Not referenced by any code. This is the end of the objects.
@label=Unused_Text
t$5EEC DEFM "COPYRIGHT" ; "COPYRIGHT"

; Messaging: Copyright
;
; The copyright message, which is printed on the game menu (see #R$6276).
@label=Message_Copyright
t$5EF5 DEFM $47                                      ; {Attribute:
 $5EF6 DEFM $7F                                      ; #COLOUR(#PEEK(#PC)) + "©
 $5EF7 DEFM "1983 A.C.G. ALL RIGHTS RESERVE","D"+$80 ; 1983 A.C.G. ALL RIGHTS
                                                     ; RESERVED".}
; View the equivalent code in;
; #LIST
; { #UNDERWURLDE$9174 }
; LIST#

; Default Bug State
;
; Copied into a bug when it is created (see #R$7262), which then changes
; its type and colour.
@label=DefaultState_Bug
g$5F16 DEFB $07      ; State: #N$07 (a slug).
 $5F17 DEFB $00      ; {X and Y position.
 $5F18 DEFB $00      ; }
 $5F19 DEFB $04      ; Colour attribute.
 $5F1A DEFB $00      ; {Not used.
 $5F1B DEFB $00      ;
 $5F1C DEFB $00      ; }
 $5F1D DEFB $0C      ; The height of the sprite in pixels.

; Default Robbie State
;
; Copied into Robbie at the start of a turn (see #R$6176).
@label=DefaultState_Robbie
g$5F1E DEFB $01      ; State: #N$01 (empty-handed).
 $5F1F DEFB $78      ; X position.
 $5F20 DEFB $78      ; Y position.
 $5F21 DEFB $47      ; Colour attribute (bright white).
 $5F22 DEFB $00      ; {Not used.
 $5F23 DEFB $00      ;
 $5F24 DEFB $00      ;
 $5F25 DEFB $00      ; }

; Default Flower State
;
; Copied into the flower at the start of a level (see #R$5F40).
@label=DefaultState_Flower
g$5F26 DEFB $10      ; State: #N$10 (growing).
 $5F27 DEFB $78      ; X position.
 $5F28 DEFB $A7      ; Y position.
 $5F29 DEFB $47      ; Colour attribute (bright white).
 $5F2A DEFB $01      ; The number of leaves.
 $5F2B DEFB $01      ; Timer until the flower next moves.
 $5F2C DEFB $00      ; {Not used.
 $5F2D DEFB $00      ; }

; Default Cubby Holes
;
; Copied into the cubby holes at the start of a level (see #R$5FA0). Three
; of the holes hold a spray can: cyan in hole #N$00, yellow in hole #N$03 and
; red in hole #N$06.
@label=DefaultState_CubbyHoles
g$5F2E DEFB $0D
 $5F2F DEFB $00
 $5F30 DEFB $00
 $5F31 DEFB $0E
 $5F32 DEFB $00
 $5F33 DEFB $00
 $5F34 DEFB $0A
 $5F35 DEFB $00
 $5F36 DEFB $00
 $5F37 DEFB $00

; Default Leaf State
;
; Copied into a leaf when it starts to grow (see #R$6C0E).
@label=DefaultState_Leaf
g$5F38 DEFB $11      ; State: #N$11 (a leaf on the right of the flower).
 $5F39 DEFB $00      ; {X and Y position.
 $5F3A DEFB $00      ; }
 $5F3B DEFB $44      ; Colour attribute.
 $5F3C DEFB $01      ; Animating flag (#N$01, so the leaf starts to grow).
 $5F3D DEFB $00      ; {Not used.
 $5F3E DEFB $00      ;
 $5F3F DEFB $00      ; }

; Reset Flower And Leaves
;
; Used by the routines at #R$5F80 and #R$62F7.
; .
; Restores the flower from its default state at #R$5F26 and sets the
; four leaf objects inactive.
@label=ResetFlowerLeaf
c$5F40 LD HL,$5F26   ; {Copy #N$08 bytes of data from #R$5F26 to #R$5E8C.
 $5F43 LD DE,$5E8C   ;
 $5F46 LD BC,$0008   ;
 $5F49 LDIR          ; }
 $5F4B LD HL,$5E94   ; #REGhl=#R$5E94 (the first leaf object).
 $5F4E LD B,$04      ; Set the leaf counter to #N$04.
 $5F50 JP $70D6      ; Jump to #R$70D6 to set all four leaf objects inactive.

; Create Game Window
;
; Used by the routines at #R$5F80, #R$60AA, #R$60FD, #R$61EA and #R$632D.
; .
; Blanks the screen, draws the banner, colours the score line and
; prints the 1UP, 2UP and HI scores. The in-game text is drawn using the ROM
; character set, so the screenshots on this page and the others load the ROM
; and set #SKOOLKID$5C36(CHARS) to #N$3C00 (the snapshot does not hold the
; value that the ROM would have set).
;
; .
;
; #PUSHS #UDGTABLE { #SIM(start=$61CD,stop=$61EA,clear=1,sp=$5D00)
; #POKES$5C37,$3C
; #SIM(start=$61EE,stop=$61F1,sp=$5D00)
; #SCR$02(game-window) } UDGTABLE# #POPS
; .
; Blank the screen and write the banner.
@label=CreateWindow
c$5F53 XOR A         ; {Set the border to #INK$00.
 $5F54 OUT ($FE),A   ; }
 $5F56 CALL $7447    ; Blank the attribute buffer using #R$7447.
 $5F59 CALL $7439    ; Blank the screen buffer using #R$7439.
 $5F5C CALL $7413    ; Print the "1UP", "HI" and "2UP" banner using #R$7413.
; Set the attributes for the 1UP lives graphic.
 $5F5F LD HL,$5808   ; Point #REGhl at the first cell of the 1UP lives graphic in the
                     ; attribute buffer (#N$5808).
 $5F62 LD A,$47      ; Set the colour to #COLOUR$47.
 $5F64 LD (HL),A     ; Colour the first cell of the 1UP lives graphic.
 $5F65 INC HL        ; Move onto the second cell.
 $5F66 LD (HL),A     ; Colour the second cell of the 1UP lives graphic.
; Set the attributes for the 2UP lives graphic.
 $5F67 LD HL,$5816   ; Point #REGhl at the first cell of the 2UP lives graphic in the
                     ; attribute buffer (#N$5816).
 $5F6A LD (HL),A     ; Colour the first cell of the 2UP lives graphic.
 $5F6B INC HL        ; Move onto the second cell.
 $5F6C LD (HL),A     ; Colour the second cell of the 2UP lives graphic.
; Set the attributes for the score line (the whole line is #COLOUR$46).
 $5F6D LD HL,$5820   ; Point #REGhl at the start of the score line in the attribute buffer
                     ; (#N$5820).
 $5F70 LD BC,$2046   ; Set the column counter to #N$20 and the colour to
                     ; #COLOUR$46.
@label=CreateWindow_Loop
*$5F73 LD (HL),C     ; Colour a cell of the score line.
 $5F74 INC L         ; Move onto the next column.
 $5F75 DJNZ $5F73    ; Decrease the column counter by one and loop back to #R$5F73 until
                     ; the whole score line has been coloured.
; Print the three scores.
 $5F77 CALL $739D    ; Print the 1UP score using #R$739D.
 $5F7A CALL $73A5    ; Print the 2UP score using #R$73A5.
 $5F7D JP $73AD      ; Jump to #R$73AD to print the HI score.
; View the equivalent code in;
; #LIST
; { #JETPAC$608A }
; { #LUNARJETMAN$84D8 }
; LIST#

; Initialise New Level
;
; Used by the routines at #R$632D and #R$66D7.
; .
; Starts a new level for the active player: refills the cubby holes,
; resets the flower and leaves, sets up the player and then draws the game
; window ready for the level to start.
;
; .
;
; #PUSHS #UDGTABLE { #SIM(start=$61CD,stop=$61EA,clear=1,sp=$5D00)
; #POKES$5C37,$3C
; #SIM(start=$6339,stop=$634F,sp=$5D00)
; #SCR$02(new-level) } UDGTABLE# #POPS
; .
; Give the player a life, as #R$6176 is about to "spend" one.
@label=LevelNew
c$5F80 LD HL,$5E38   ; {Increment #R$5E38 by one.
 $5F83 INC (HL)      ; }
; Reset the cubby holes, the flower and the leaves, then set up the
; player.
 $5F84 CALL $5FA0    ; Call #R$5FA0.
 $5F87 CALL $5F40    ; Call #R$5F40.
 $5F8A CALL $6176    ; Call #R$6176.
; This entry point is used by the routine at #R$60AA.
; .
; Draw the game window; this entry point is also used to continue the
; game after a turn.
@label=LevelInit
*$5F8D CALL $5F53    ; Create the game window using #R$5F53.
 $5F90 CALL $602E    ; Draw the play area using #R$602E.
 $5F93 CALL $5FB0    ; Draw the cubby hole items using #R$5FB0.
 $5F96 CALL $7325    ; Display the lives using #R$7325.
 $5F99 LD A,($5C78)  ; {Write #SKOOLKID$5C78(FRAMES) to #R$5E1F.
 $5F9C LD ($5E1F),A  ; }
 $5F9F RET           ; Return.
; View the equivalent code in;
; #LIST
; { #LUNARJETMAN$A826 }
; LIST#

; Reset Cubby Holes
;
; Used by the routines at #R$5F80 and #R$62F7.
; .
; Copies the default contents of the ten cubby holes (five down each
; side of the play area) from #R$5F2E to #R$5E23, and cancels any bonus item
; object at #R$5E3C.
@label=ResetCubbyHoles
c$5FA0 LD HL,$5F2E   ; {Copy #N$0A bytes of data from #R$5F2E to #R$5E23.
 $5FA3 LD DE,$5E23   ;
 $5FA6 LD BC,$000A   ;
 $5FA9 LDIR          ; }
 $5FAB XOR A         ; {Write #N$00 to #R$5E3C.
 $5FAC LD ($5E3C),A  ; }
 $5FAF RET           ; Return.

; Draw Cubby Hole Items
;
; Used by the routine at #R$5F80.
; .
; Draws the contents of all ten cubby holes: first the five down the
; left-hand side (X position #N$08) and then the five down the right-hand side
; (X position #N$E8). Each hole is drawn by #R$5FDE.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$61CD,stop=$61EA,clear=1,sp=$5D00)
; #POKES$5C37,$3C
; #SIM(start=$61EE,stop=$61F1,sp=$5D00)
; #SIM(start=$5F84,stop=$5F87,sp=$5D00)
; #SIM(start=$5F90,stop=$5F93,sp=$5D00)
; #SCR$01(cubby-items-before)
; | #SIM(start=$5F93,stop=$5F96,sp=$5D00)
; #SCR$01(cubby-items-after) } UDGTABLE# #POPS
@label=DrawCubbyHoleItems
c$5FB0 LD C,$01      ; Start with the first row of shelves by setting the row counter in
                     ; #REGc to #N$01.
 $5FB2 LD DE,$5E23   ; Point #REGde at the first cubby hole (#R$5E23).
; Draw the left-hand side.
@label=DrawCubbyHoleItems_Left
*$5FB5 LD L,$08      ; Set the X position in #REGl to #N$08 (the left-hand
                     ; side).
 $5FB7 PUSH DE       ; {Stash #REGde and #REGbc on the stack.
 $5FB8 PUSH BC       ; }
 $5FB9 CALL $5FDE    ; Call #R$5FDE.
 $5FBC POP BC        ; {Restore #REGbc and #REGde from the stack.
 $5FBD POP DE        ; }
 $5FBE INC DE        ; Move onto the next cubby hole.
 $5FBF INC C         ; Increment the row counter by one.
 $5FC0 LD A,C        ; {Loop back to #R$5FB5 until all five cubby holes down the left-hand
 $5FC1 CP $06        ; side have been drawn (the row counter reaches #N$06).
 $5FC3 JR NZ,$5FB5   ; }
; Draw the right-hand side.
 $5FC5 LD C,$01      ; Reset the row counter in #REGc to #N$01 for the
                     ; right-hand side.
@label=DrawCubbyHoleItems_Right
*$5FC7 LD L,$E8      ; Set the X position in #REGl to #N$E8 (the right-hand
                     ; side).
 $5FC9 PUSH DE       ; {Stash #REGde and #REGbc on the stack.
 $5FCA PUSH BC       ; }
 $5FCB CALL $5FDE    ; Call #R$5FDE.
 $5FCE POP BC        ; {Restore #REGbc and #REGde from the stack.
 $5FCF POP DE        ; }
 $5FD0 INC DE        ; Move onto the next cubby hole.
 $5FD1 INC C         ; Increment the row counter by one.
 $5FD2 LD A,C        ; {Loop back to #R$5FC7 until all five cubby holes down the right-hand
 $5FD3 CP $06        ; side have been drawn (the row counter reaches #N$06).
 $5FD5 JR NZ,$5FC7   ; }
 $5FD7 RET           ; Return.

; Clear Cubby Hole
;
; Used by the routine at #R$5FDE.
; .
; Empties a cubby hole that has a bonus item in it, and cancels the
; bonus item object at #R$5E3C.
;
; DE Address of the cubby hole
@label=ClearCubbyHole
c$5FD8 XOR A         ; {Write #N$00 to *#REGde.
 $5FD9 LD (DE),A     ; }
 $5FDA LD ($5E3C),A  ; Write #N$00 to #R$5E3C.
 $5FDD RET           ; Return.

; Draw Cubby Hole Item
;
; Used by the routine at #R$5FB0.
; .
; Draws the item held in one cubby hole. The item type is held in bits
; 3-7 of the cubby hole and the item colour in bits 0-2. The sprite for the
; item type is fetched from #R$601B, and the item is drawn standing on the
; shelf at the position given by the row counter.
; If bit 7 of the cubby hole is set it holds a bonus item and the hole is
; emptied using #R$5FD8 instead.
;
; C Row counter (#N$01-#N$05)
; DE Address of the cubby hole
; L X position (#N$08 on the left, #N$E8 on the right)
@label=DrawCubbyHoleItem
c$5FDE LD A,(DE)     ; #REGa=*#REGde (the contents of the cubby hole).
 $5FDF AND %11111000 ; Keep only bits 3-7 (the item type).
 $5FE1 RET Z         ; Return if the cubby hole is empty.
 $5FE2 BIT 7,A       ; {Jump to #R$5FD8 if bit 7 is set.
 $5FE4 JR NZ,$5FD8   ; }
 $5FE6 LD A,(DE)     ; #REGa=*#REGde (the contents of the cubby hole).
 $5FE7 PUSH AF       ; Stash the cubby hole contents on the stack.
; Use the item type to look up the sprite.
 $5FE8 RRCA          ; {Rotate the item type (held in bits 3-7) down into bits
 $5FE9 RRCA          ; 1-5.}
 $5FEA AND %00111110 ; Keep only bits 1-5
                     ; (the item type multiplied by two, as each sprite pointer is two bytes).
 $5FEC LD E,A        ; {Make this the offset into the table in #REGde.
 $5FED LD D,$00      ; }
 $5FEF PUSH HL       ; Stash the X position (in #REGl) on the stack.
 $5FF0 LD HL,$601B   ; #REGhl=#R$601B.
 $5FF3 ADD HL,DE     ; Add the offset to #REGhl.
 $5FF4 LD E,(HL)     ; {#REGde=the sprite address for the item type from the
 $5FF5 INC HL        ; table.
 $5FF6 LD D,(HL)     ; }
 $5FF7 POP HL        ; Restore the X position from the stack.
; Work out the Y position from the row counter.
 $5FF8 LD A,C        ; {Rotate the row counter right three times (multiplying
 $5FF9 RRCA          ; it by #N$20).
 $5FFA RRCA          ;
 $5FFB RRCA          ; }
 $5FFC AND %11100000 ; Keep only bits 5-7
                     ; (so each row of shelves is #N$20 pixels lower).
 $5FFE OR %00010111  ; Set bits 0-2 and bit 4
                     ; (adding #N$17 so that the item stands on the shelf).
 $6000 LD H,A        ; Store the Y position in #REGh.
; Work out the colour attribute.
 $6001 POP AF        ; Restore the cubby hole contents from the stack.
 $6002 AND %00000111 ; Keep only bits 0-2 (the item colour).
 $6004 OR %01000000  ; Set bit 6 (BRIGHT).
 $6006 LD ($5E12),A  ; Write the colour attribute to #R$5E12.
; Draw and colour the sprite.
 $6009 PUSH IX       ; Stash #REGix on the stack.
 $600B LD IX,$5E0F   ; #REGix=#R$5E0F (so that the colour is fetched from
                     ; #R$5E12).
 $600F CALL $74C6    ; Set up the sprite at the position in #REGhl using
                     ; #R$74C6.
 $6012 CALL $7539    ; Draw the sprite using #R$7539.
 $6015 CALL $7450    ; Colour the sprite using #R$7450.
 $6018 POP IX        ; Restore #REGix from the stack.
 $601A RET           ; Return.

; Cubby Hole Item Sprites
;
; Indexed by the item type held in bits 3-7 of a cubby hole. An empty
; hole is item type #N$00, so its entry is never used.
@label=CubbyHoleItem_Sprites
w$601B DEFW $0000    ; Item type #N$00: not used.
 $601D DEFW $7711    ; Item type #N$01: #R$7711 (the spray can).

; Draw Cubby Hole Shelves
;
; Used by the routine at #R$602E.
; .
; Draws the five shelves of the cubby holes down one side of the play
; area, each made of three bricks and each #N$20 pixels below the last.
;
; DE Pointer to the string for the shelf
; HL Screen position of the first shelf
@label=DrawCubbyHoleShelves
c$601F LD C,$05      ; Set the shelf counter in #REGc to #N$05.
@label=DrawCubbyHoleShelves_Loop
*$6021 LD B,$01      ; Set the brick counter in #REGb to #N$01
                     ; (one row of bricks per shelf).
 $6023 CALL $6077    ; Print the shelf using #R$6077.
 $6026 LD A,H        ; #REGa=the Y position, which #R$6077 has moved down by
                     ; #N$08.
 $6027 ADD A,$18     ; Add #N$18 to move down to the next shelf
                     ; (#N$20 pixels below the last).
 $6029 LD H,A        ; Store the Y position in #REGh.
 $602A DEC C         ; Decrease the shelf counter by one.
 $602B JR NZ,$6021   ; Loop back to #R$6021 until all five shelves have been
                     ; drawn.
 $602D RET           ; Return.

; Draw Play Area
;
; Used by the routine at #R$5F80.
; .
; Draws the brick walls, the cubby hole shelves either side of the play
; area and the floor using the UDGs at #R$76D6.
;
; .
;
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$61CD,stop=$61EA,clear=1,sp=$5D00)
; #POKES$5C37,$3C
; #SIM(start=$61EE,stop=$61F1,sp=$5D00)
; #SCR$01(play-area-before)
; | #SIM(start=$602E,stop=$6076,sp=$5D00)
; #SCR$01(play-area-after) }
; { =c2 #SCR$02,$00,$17,$20,$01(floor-strip) } UDGTABLE# #POPS
@label=DrawPlayArea
c$602E LD HL,($5C36) ; {Stash #SKOOLKID$5C36(CHARS) on the stack.
 $6031 PUSH HL       ; }
 $6032 LD HL,$76D6   ; {Write #R$76D6 to #SKOOLKID$5C36(CHARS).
 $6035 LD ($5C36),HL ; }
; Create the left-hand wall.
 $6038 LD DE,$6087   ; #REGde=#R$6087.
 $603B LD HL,$1800   ; #REGhl=#N$1800 (screen position).
 $603E LD B,$14      ; Set the brick counter to #N$14 (the wall is #N$14 bricks
                     ; high).
 $6040 CALL $6077    ; Print the wall using #R$6077.
; Create the right-hand wall.
 $6043 LD HL,$18F8   ; #REGhl=#N$18F8 (screen position).
 $6046 LD B,$14      ; Set the brick counter to #N$14 (the wall is #N$14 bricks
                     ; high).
 $6048 CALL $6077    ; Print the wall using #R$6077.
; Create the left-hand cubby hole shelves.
 $604B LD DE,$6089   ; #REGde=#R$6089.
 $604E LD HL,$1800   ; #REGhl=#N$1800 (screen position).
 $6051 CALL $601F    ; Draw the shelves using #R$601F.
; Create the right-hand cubby hole shelves.
 $6054 LD HL,$18E8   ; #REGhl=#N$18E8 (screen position).
 $6057 CALL $601F    ; Draw the shelves using #R$601F.
; Create the floor, which is #N$10 tiles wide.
 $605A LD HL,$B800   ; #REGhl=#N$B800 (screen position).
 $605D LD DE,$608D   ; #REGde=#R$608D.
 $6060 LD C,$10      ; Set the tile counter in #REGc to #N$10.
@label=DrawPlayArea_FloorLoop
*$6062 LD B,$01      ; Set the row counter in #REGb to #N$01 (the tile is one
                     ; row high).
 $6064 CALL $6077    ; Print the tile using #R$6077.
 $6067 LD A,L        ; {Move the screen position #N$10 pixels to the right and back up #N$08
 $6068 ADD A,$10     ; pixels to the row it was printed on.
 $606A LD L,A        ;
 $606B LD A,H        ;
 $606C SUB $08       ;
 $606E LD H,A        ; }
 $606F DEC C         ; {Decrease the tile counter by one and loop back to #R$6062 until the
 $6070 JR NZ,$6062   ; whole floor has been drawn.}
 $6072 POP HL        ; {Restore #SKOOLKID$5C36(CHARS) from the stack, and write it back to
 $6073 LD ($5C36),HL ; #N$5C36.}
 $6076 RET           ; Return.

; Print String Rows
;
; Used by the routines at #R$601F and #R$602E.
; .
; Prints the same string on a number of consecutive character rows,
; so that a UDG is repeated down the screen.
;
;   B Number of rows
;   DE Pointer to string data
;   HL Screen position of the first row
; O:HL Screen position of the row below the last one printed
@label=PrintString_Wrapper
c$6077 PUSH HL       ; {Stash #REGhl, #REGde and #REGbc on the stack.
 $6078 PUSH DE       ;
 $6079 PUSH BC       ; }
 $607A CALL $73ED    ; Print the string using #R$73ED.
 $607D POP BC        ; {Restore #REGbc, #REGde and #REGhl from the stack.
 $607E POP DE        ;
 $607F POP HL        ; }
 $6080 LD A,H        ; {Move down #N$08 pixels onto the next row.
 $6081 ADD A,$08     ;
 $6083 LD H,A        ; }
 $6084 DJNZ $6077    ; Decrease the row counter by one and loop back to #R$6077 until all
                     ; of the rows have been printed.
 $6086 RET           ; Return.

; Play Area Strings
;
; Strings used by #R$602E. Each is an attribute byte followed by UDG IDs
; (see #R$76D6), where the last UDG ID has bit 7 set to mark the end of the
; string.
@label=Message_Bricks_LR
b$6087 DEFB $7A      ; {A brick wall string: #COLOUR$7A, one brick (UDG ID #N$00 with
 $6088 DEFB $80      ; bit 7 set).}
@label=Message_Bricks_Cubby
 $6089 DEFB $7A      ; {A cubby hole shelf string: #COLOUR$7A, three bricks (UDG ID
 $608A DEFB $00      ; #N$00, with bit 7 set on the last).
 $608B DEFB $00      ;
 $608C DEFB $80      ; }
@label=Message_Floor
 $608D DEFB $32      ; {A floor tile string: #COLOUR$32, UDG ID #N$01 and UDG ID #N$02
 $608E DEFB $01      ; (with bit 7 set).
 $608F DEFB $82      ; }

; Messaging: Plant Eaten
;
; Shown by #R$60AA when the flower has been eaten away.
@label=Message_Eaten
t$6090 DEFM $47                                ; {Attribute:
 $6091 DEFM "YOUR PLANT HAS BEEN EATE","N"+$80 ; #COLOUR(#PEEK(#PC)) + "YOUR
                                               ; PLANT HAS BEEN EATEN".}

; Player Turn Ends
;
; Used by the routine at #R$65F7.
; .
; Runs when Robbie has been killed. If the flower has also been eaten
; away then the "YOUR PLANT HAS BEEN EATEN" message is shown first and the
; flower is reset. All of the bugs are removed, and then either the current
; player starts another turn, the other player takes over, or the game is
; over.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After (flower eaten) }
; { #SIM(start=$61CD,stop=$61EA,clear=1,sp=$5D00)
; #POKES$5C37,$3C
; #SIM(start=$6339,stop=$634F,sp=$5D00)
; #SCR$01(turn-ends-before)
; | #POKES$5E8E,$B7
; #SIM(start=$60AA,stop=$610E,sp=$5D00)
; #SCR$01(turn-ends-after) } UDGTABLE# #POPS
@label=PlayerTurnEnds
c$60AA XOR A         ; {Write #N$00 to #R$5E3C.
 $60AB LD ($5E3C),A  ; }
; Check whether the flower has been eaten right down to the ground.
 $60AE LD HL,$5E8E   ; Point #REGhl at the flower's Y position (#R$5E8E).
 $60B1 LD A,(HL)     ; #REGa=the flower Y position.
 $60B2 CP $B7        ; {Jump to #R$60C4 if the flower Y position is less than
 $60B4 JR C,$60C4    ; #N$B7.}
 $60B6 LD (HL),$A7   ; Reset the flower Y position to #N$A7.
 $60B8 CALL $5F53    ; Create the game window using #R$5F53.
 $60BB LD DE,$6090   ; #REGde=the "YOUR PLANT HAS BEEN EATEN" message
                     ; (#R$6090).
 $60BE LD HL,$7020   ; #REGhl=#N$7020 (screen position).
 $60C1 CALL $610B    ; Print the message and pause using #R$610B.
; Remove all of the bugs and the explosion object.
@label=PlayerTurnEnds_RemoveBugs
*$60C4 LD HL,$5EB4   ; #REGhl=#R$5EB4 (the first bug).
 $60C7 LD B,$07      ; Set the object counter to #N$07 (the bugs and the
                     ; explosion).
 $60C9 CALL $70D6    ; Set the objects inactive using #R$70D6.
; Is this a 2UP game?
 $60CC LD A,($5E03)  ; #REGa=the game options from #R$5E03.
 $60CF AND %00000001 ; Keep only bit 0 (the player count).
 $60D1 JR NZ,$60E0   ; Jump to #R$60E0 if this is a 2UP game.
; Handle 1UP player.
@label=PlayerTurnEnds_1UP
*$60D3 LD A,($5E38)  ; {Jump to #R$6127 if the current player is out of lives (using
 $60D6 AND A         ; #R$5E38).
 $60D7 JP Z,$6127    ; }
 $60DA CALL $5F8D    ; Create the game window using #R$5F8D.
 $60DD JP $6176      ; Jump to #R$6176 to start the player's next turn.
; Handle 2UP player.
@label=PlayerTurnEnds_2UP
*$60E0 LD A,($5E3A)  ; {Jump to #R$60D3 if the other player is out of lives (using
 $60E3 AND A         ; #R$5E3A).
 $60E4 JR Z,$60D3    ; }
 $60E6 LD A,($5E38)  ; {Call #R$611F if the current player is out of lives (using
 $60E9 AND A         ; #R$5E38).
 $60EA CALL Z,$611F  ; }
 $60ED CALL $613B    ; Swap the two players' data using #R$613B.
 $60F0 LD A,($5E1E)  ; {Change current player at #R$5E1E (flip bits between
 $60F3 CPL           ; #N$00 and #N$FF).
 $60F4 LD ($5E1E),A  ; }
 $60F7 CALL $5F8D    ; Create the game window using #R$5F8D.
 $60FA JP $6176      ; Jump to #R$6176 to start the other player's turn.

; Show Game Over For 1UP
;
; Used by the routines at #R$611F and #R$6127.
; .
; Shows "GAME OVER PLAYER 1" or "GAME OVER PLAYER 2" on a blank game
; window and pauses for a couple of seconds. The player number is written
; over the last character of the message at #R$6163.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$61CD,stop=$61EA,clear=1,sp=$5D00)
; #POKES$5C37,$3C
; #SIM(start=$6339,stop=$634F,sp=$5D00)
; #SCR$01(game-over-1up-before)
; | #SIM(start=$60FD,stop=$610E,sp=$5D00)
; #SCR$01(game-over-1up-after) } UDGTABLE# #POPS
;
; .
;
; #HTML(Set up altering the "GAME OVER PLAYER <em>X</em>" message for 1UP.)
@label=GameOver_1UP
c$60FD LD A,"1"+$80  ; #REGa="1" + #N$80 (escape character).
; This entry point is used by the routine at #R$611B.
; .
; Print the messaging and pause to show it for a period of time.
@label=GameOver_Write
*$60FF LD ($6175),A  ; Write ASCII player number to #R$6163(#N$6175).
 $6102 CALL $5F53    ; Create the game window using #R$5F53.
 $6105 LD DE,$6163   ; #REGde=#R$6163.
 $6108 LD HL,$7038   ; #REGhl=#N$7038 (screen position).
; This entry point is used by the routines at #R$60AA and #R$632D.
; .
; Print message and pause, also used by #R$60AA and #R$632D.
@label=GameOverPrint_Pause
*$610B CALL $73ED    ; Print the message using #R$73ED.
; Introduce a pause by counting down from #N$10000 four times.
 $610E LD B,$04      ; Set the number of countdowns to #N$04.
; This entry point is used by the routine at #R$66D7.
@label=PauseForCount
*$6110 LD HL,$0000   ; #REGhl=#N$0000 (the start of a countdown of #N$10000
                     ; steps).
@label=GameOver_Pause
*$6113 DEC HL        ; Decrease the countdown by one.
 $6114 LD A,H        ; {Loop back to #R$6113 until the countdown has reached
 $6115 OR L          ; zero.
 $6116 JR NZ,$6113   ; }
 $6118 DJNZ $6113    ; Decrease the number of countdowns by one and loop back to #R$6113
                     ; until the pause is over.
 $611A RET           ; Return.

; Show Game Over For 2UP
;
; Used by the routines at #R$611F and #R$6127.
; .
; Sets up the "GAME OVER PLAYER 2" message and then shows it using
; #R$60FF.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$61CD,stop=$61EA,clear=1,sp=$5D00)
; #POKES$5C37,$3C
; #SIM(start=$6339,stop=$634F,sp=$5D00)
; #SCR$01(game-over-2up-before)
; | #SIM(start=$611B,stop=$610E,sp=$5D00)
; #SCR$01(game-over-2up-after) } UDGTABLE# #POPS
;
; .
;
; #HTML(Set up altering the "GAME OVER PLAYER <em>X</em>" message for 2UP.)
@label=GameOver_2UP
c$611B LD A,"2"+$80  ; #REGa="2" + #N$80 (escape character).
 $611D JR $60FF      ; Jump to #R$60FF.

; Show Game Over For Active Player
;
; Used by the routine at #R$60AA.
; .
; Shows the "GAME OVER" message for whichever player is currently
; active.
@label=GameOver_Controller
c$611F LD A,($5E1E)  ; {Jump to #R$60FD if the current player (#R$5E1E) is
 $6122 AND A         ; #N$00 (1UP).
 $6123 JR Z,$60FD    ; }
 $6125 JR $611B      ; Else, jump to #R$611B.

; End Game
;
; Used by the routine at #R$60AA.
; .
; Both players are out of lives. Updates the high score, shows the
; "GAME OVER" message for the current player and then returns to the game
; selection screen.
;
; .
;
; This is a controller with a jump to #R$61EA to return to the game selection
; screen.
@label=GameOver_ControllerRestart
c$6127 CALL $708F    ; Update the high score using #R$708F.
 $612A LD A,($5E1E)  ; {Jump to #R$6136 if the current player (#R$5E1E) is not
 $612D AND A         ; #N$00 (2UP).
 $612E JR NZ,$6136   ; }
 $6130 CALL $60FD    ; Show the "GAME OVER PLAYER 1" message using #R$60FD.
@label=GameOver_Restart
*$6133 JP $61EA      ; Jump to #R$61EA.
@label=GameOver_Restart2UP
*$6136 CALL $611B    ; Show the "GAME OVER PLAYER 2" message using #R$611B.
 $6139 JR $6133      ; Jump to #R$6133.

; 1UP/ 2UP Swapper
;
; Used by the routines at #R$60AA and #R$62F7.
; .
; Swaps the data of the active player with that of the inactive player:
; the level and lives, the cubby holes, and the flower and leaf objects.
;
; .
;
; This routine "swaps" the data between #REGde and #REGhl.
; .
; Swap the levels and lives.
@label=ChangePlayer
c$613B LD HL,$5E37   ; #REGhl=#R$5E37.
 $613E LD DE,$5E39   ; #REGde=#R$5E39.
 $6141 LD B,$02      ; Set the byte counter to #N$02 (the level and the lives).
 $6143 CALL $6159    ; Swap the data using #R$6159.
; Swap the cubby holes.
 $6146 LD HL,$5E23   ; #REGhl=#R$5E23.
 $6149 LD DE,$5E2D   ; #REGde=#R$5E2D.
 $614C LD B,$0A      ; Set the byte counter to #N$0A (the ten cubby holes).
 $614E CALL $6159    ; Swap the data using #R$6159.
; Swap the flower and leaves.
 $6151 LD HL,$5E44   ; #REGhl=#R$5E44.
 $6154 LD DE,$5E8C   ; #REGde=#R$5E8C.
 $6157 LD B,$28      ; Set the byte counter to #N$28 (the flower and the four
                     ; leaves).
; Swap the bytes at #REGhl and #REGde, then move onto the next pair of
; bytes.
@label=ChangePlayer_Loop
*$6159 LD A,(DE)     ; Fetch the byte of the inactive player.
 $615A LD C,(HL)     ; Fetch the byte of the active player.
 $615B LD (HL),A     ; Write the inactive player's byte over the active
                     ; player's.
 $615C LD A,C        ; #REGa=the active player's byte.
 $615D LD (DE),A     ; Write the active player's byte over the inactive
                     ; player's.
 $615E INC HL        ; {Move both pointers onto the next byte.
 $615F INC DE        ; }
 $6160 DJNZ $6159    ; Decrease the byte counter by one and loop back to #R$6159 until all
                     ; of the bytes have been swapped.
 $6162 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #COOKIE$6416 }
; { #JETPAC$616A }
; { #LUNARJETMAN$A880 }
; { #SABREWULF$B235 }
; LIST#

; Messaging: Game Over
;
; The message shown when a player has lost all of their lives. The last
; character is replaced with the number of the player (see #R$60FD).
@label=GameOver_Text
t$6163 DEFM $47                         ; {"GAME OVER PLAYER X".
 $6164 DEFM "GAME OVER PLAYER ","1"+$80 ; }

; Initialise Player
;
; Used by the routines at #R$5F80 and #R$60AA.
; .
; Sets up the active player for a turn: puts Robbie at his default
; position, sets how long the "get ready" delay lasts and takes a life.
@label=PlayerInit
c$6176 LD A,$15      ; {Write #N$15 to #R$5EE4.
 $6178 LD ($5EE4),A  ; }
 $617B LD HL,$5F1E   ; {Copy #N$08 bytes of data from #R$5F1E to #R$5E6C.
 $617E LD DE,$5E6C   ;
 $6181 LD BC,$0008   ;
 $6184 LDIR          ; }
; Set default "begin play" delay period.
 $6186 LD A,$80      ; #REGa=#N$80 (the length of the "get ready" delay).
 $6188 LD HL,$5E03   ; {Jump to #R$6191 if #R$5E03 says this is a 1UP game.
 $618B BIT 0,(HL)    ;
 $618D JR Z,$6191    ; }
 $618F ADD A,$7F     ; Else, add #N$7F to make the delay #N$FF for a two player game
                     ; (giving more time for "passing over" the controls).
@label=PlayerInit_WriteDelay
*$6191 LD ($5E22),A  ; Write the delay to #R$5E22.
; "Spend" a life.
; .
; See #POKE(infinite_lives,Infinite Lives).
 $6194 LD A,($5E38)  ; {Decrease #R$5E38 by one.
 $6197 DEC A         ;
 $6198 LD ($5E38),A  ; }
 $619B JP $7325      ; Jump to #R$7325 to display the lives.

; Flash Player Label
;
; Used by the routine at #R$6DBA.
; .
; Sets the FLASH attribute on the three cells of the active player's
; "1UP" or "2UP" label in the banner. Called while the "get ready" delay at
; #R$5E22 is running.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$61CD,stop=$61EA,clear=1,sp=$5D00)
; #POKES$5C37,$3C
; #SIM(start=$61EE,stop=$61F1,sp=$5D00)
; #SCR$04,$00,$00,$08,$02(flash-label-before)
; | #POKES$5E1E,$00;$5D00,$00,$02
; #SIM(start=$619E,stop=$0000,sp=$5D00)
; #SCR$04,$00,$00,$08,$02(flash-label-after) } UDGTABLE# #POPS
@label=FlashPlayerLabel
c$619E LD A,($5E1E)  ; Fetch the current player from #R$5E1E.
 $61A1 AND A         ; {Jump to #R$61C1 if the current player is not #N$00
 $61A2 JR NZ,$61C1   ; (2UP).}
 $61A4 LD HL,$0018   ; #REGhl=#N($0018, 4, 4) (the position of "1UP").
; This entry point is used by the routine at #R$61B4.
; .
; Set the FLASH bit on each of the three attribute cells.
@label=FlashPlayerLabel_Set
*$61A7 CALL $748F    ; Convert the position to an attribute buffer address
                     ; using #R$748F.
 $61AA LD B,$03      ; Set the cell counter to #N$03 (the three characters of
                     ; the label).
@label=FlashPlayerLabel_Loop
*$61AC LD A,(HL)     ; Fetch the attribute of the cell.
 $61AD OR %10000000  ; Set bit 7 (FLASH).
 $61AF LD (HL),A     ; Write the attribute back.
 $61B0 INC HL        ; Move onto the next cell.
 $61B1 DJNZ $61AC    ; Decrease the cell counter by one and loop back to #R$61AC until all
                     ; three cells are flashing.
 $61B3 RET           ; Return.

; Stop Flashing Player Label
;
; Used by the routine at #R$6DBA.
; .
; Clears the FLASH attribute on the three cells of a "1UP" or "2UP"
; label.
;
; HL Position of the label (X in #REGl, Y in #REGh)
@label=StopFlashingPlayerLabel
c$61B4 CALL $748F    ; Convert the position to an attribute buffer address
                     ; using #R$748F.
 $61B7 LD B,$03      ; Set the cell counter to #N$03 (the three characters of
                     ; the label).
@label=StopFlashingPlayerLabel_Loop
*$61B9 LD A,(HL)     ; Fetch the attribute of the cell.
 $61BA AND %01111111 ; Keep only bits 0-6 (reset the FLASH bit).
 $61BC LD (HL),A     ; Write the attribute back.
 $61BD INC HL        ; Move onto the next cell.
 $61BE DJNZ $61B9    ; Decrease the cell counter by one and loop back to #R$61B9 until all
                     ; three cells have stopped flashing.
 $61C0 RET           ; Return.
; This entry point is used by the routine at #R$619E.
; .
; Use the position of "2UP" instead.
@label=FlashPlayerLabel_2UP
*$61C1 LD HL,$00D8   ; #REGhl=#N($00D8, 4, 4) (the position of "2UP").
 $61C4 JR $61A7      ; Jump to #R$61A7.

; Security Check
;
; Used by the routine at #R$5B80.
; .
; Returns to the caller (BASIC) without starting the game unless the
; second byte of #SKOOLKID$5C78(FRAMES) is #N$65.
@label=SecurityCheck
c$61C6 DI            ; Disable interrupts.
 $61C7 LD A,($5C79)  ; #REGa=the second byte of #SKOOLKID$5C78(FRAMES).
 $61CA CP $65        ; {Return if #REGa is not #N$65.
 $61CC RET NZ        ; }
; Continue on to #R$61CD.
; .
; View the equivalent code in;
; #LIST
; { #ATICATAC$6000 }
; { #COOKIE$5F00 }
; { #JETPAC$61E5 }
; { #LUNARJETMAN$8000 }
; { #SABREWULF$995A }
; { #TRANZAM$5F00 }
; LIST#

; Game Initialisation
;
; Clears the high score, the game options, the sound flag and the 1UP
; and 2UP scores, calculates a checksum of the ROM #SKOOLKID$03B5(BEEPER)
; routine to set the sound flag, and sets the border colour system variable.
;
; .
;
; Blank the high score, game options, sound flag, 1UP and 2UP scores.
@label=GameInitialisation
c$61CD LD HL,$5E00   ; {#REGhl=#N$5E00 (the high score), #REGb=#N$0B (the byte counter) and
 $61D0 LD BC,$0B00   ; #REGc=#N$00 (the value to write).}
@label=GameInitialisation_Loop
*$61D3 LD (HL),C     ; Clear the byte.
 $61D4 INC HL        ; Move onto the next byte.
 $61D5 DJNZ $61D3    ; Decrease the byte counter by one and loop back to #R$61D3 until all
                     ; #N$0B bytes have been cleared.
; This calculates a "checksum" of the #SKOOLKID$03B5(BEEPER) routine.
; The expected value at the end is #N$00, and if #R$5E04 does not contain
; #N$00 then the tunes are not played.
 $61D7 LD HL,$03B5   ; #REGhl=#SKOOLKID$03B5(BEEPER).
 $61DA LD B,$43      ; Set the byte counter to #N$43 (the length of the
                     ; routine).
 $61DC XOR A         ; #REGa=#N$00 (the start of the checksum).
@label=Mute_Loop
*$61DD ADD A,(HL)    ; Add the byte of the routine to the checksum.
 $61DE INC HL        ; Move onto the next byte of the routine.
 $61DF DJNZ $61DD    ; Decrease the byte counter by one and loop back to #R$61DD until the
                     ; whole routine has been added.
 $61E1 ADD A,$68     ; Add #N$68 to the checksum
                     ; (which gives #N$00 if the routine is unchanged).
 $61E3 LD ($5E04),A  ; Store the checksum at #R$5E04 (the sound flag).
 $61E6 XOR A         ; {Write #N$00 to #SKOOLKID$5C48(BORDCR).
 $61E7 LD ($5C48),A  ; }
; Continue on to #R$61EA.
; .
; View the equivalent code in;
; #LIST
; { #ATICATAC$7C19 }
; { #COOKIE$6298 }
; { #JETPAC$61EB }
; { #LUNARJETMAN$800A }
; { #SABREWULF$9960 }
; { #TRANZAM$5F07 }
; LIST#

; Select Game
;
; Used by the routine at #R$6127.
; .
; Shows the game selection menu and reads the keys "1" to "5" until the
; player starts the game by pressing "5". Keys "1" and "2" choose the number
; of players, keys "3" and "4" choose the control method, and the chosen
; options are shown by flashing the menu lines.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After pressing "2" and "4" (the chosen lines flash) }
; { #SIM(start=$61CD,stop=$61EA,clear=1,sp=$5D00)
; #POKES$5C37,$3C
; #SIM(start=$61EE,stop=$61F1,sp=$5D00)
; #SIM(start=$61F1,stop=$61F4,sp=$5D00)
; #SCR$02,$05,$03,$18,$0D(select-before)
; | #POKES$5E03,$03
; #SIM(start=$6220,stop=$61F1,sp=$5D00)
; #SIM(start=$61F1,stop=$61F4,sp=$5D00)
; #SCR$02,$05,$03,$18,$0D(select-after) } UDGTABLE# #POPS
@label=Game_Restart
c$61EA DI            ; Disable interrupts.
 $61EB LD SP,$5D00   ; Reset the stack pointer to #N$5D00 (the top of the
                     ; game's stack).
 $61EE CALL $5F53    ; Create the game window using #R$5F53.
@label=GameSelect_Loop
*$61F1 CALL $6250    ; Print the menu using #R$6250.
 $61F4 LD A,($5E03)  ; {Fetch the game options from #R$5E03 into #REGd.
 $61F7 LD D,A        ; }
 $61F8 LD A,$F7      ; {Read from the keyboard;
 $61FA OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $61FC IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$F7 | 1 | 2 | 3 | 4 | 5 }
                     ; TABLE#}
 $61FE CPL           ; Flip the bits, so that a key being pressed is a set bit.
; Handle 1UP selection.
 $61FF BIT 0,A       ; {Jump to #R$6205 if key "1" ("1 PLAYER GAME") is not
 $6201 JR Z,$6205    ; being pressed.}
 $6203 RES 0,D       ; Reset bit 0 of #REGd (a 1UP game).
; Handle 2UP selection.
@label=GameSelect_CheckP2
*$6205 BIT 1,A       ; {Jump to #R$620B if key "2" ("2 PLAYER GAME") is not
 $6207 JR Z,$620B    ; being pressed.}
 $6209 SET 0,D       ; Set bit 0 of #REGd (a 2UP game).
; Handle Keyboard selection.
@label=GameSelect_CheckKeyboard
*$620B BIT 2,A       ; {Jump to #R$6211 if key "3" ("KEYBOARD") is not being
 $620D JR Z,$6211    ; pressed.}
 $620F RES 1,D       ; Reset bit 1 of #REGd (keyboard control).
; Handle Kempston Joystick selection.
@label=GameSelect_CheckKempston
*$6211 BIT 3,A       ; {Jump to #R$6217 if key "4" ("KEMPSTON JOYSTICK") is not being
 $6213 JR Z,$6217    ; pressed.}
 $6215 SET 1,D       ; Set bit 1 of #REGd (joystick control).
; Handle starting a new game.
@label=GameSelect_StartGame
*$6217 BIT 4,A       ; {Jump to #R$632D if key "5" ("START GAME") is being
 $6219 JP NZ,$632D   ; pressed.}
; Handle flashing each selection.
 $621C LD A,D        ; {Write #REGd to #R$5E03.
 $621D LD ($5E03),A  ; }
 $6220 LD HL,$627D   ; #REGhl=#R$627D (the first selectable line, skipping the
                     ; title).
 $6223 LD A,($5E03)  ; {Fetch the game options from #R$5E03 into #REGc.
 $6226 LD C,A        ; }
@label=MenuAttributeCheckPlayer
 $6227 BIT 0,C       ; {Jump to #R$6238 if a 2UP game is selected.
 $6229 JR NZ,$6238   ; }
 $622B CALL $6242    ; Else, flash the first line using #R$6242.
; Check control method.
@label=MenuAttributeCheckControl
*$622E BIT 1,C       ; {Jump to #R$623D if joystick control is selected.
 $6230 JR NZ,$623D   ; }
 $6232 CALL $6242    ; Else, flash the first line using #R$6242.
@label=GameSelect_End
*$6235 JP $61F1      ; Jump back to #R$61F1.
; Handle flashing 2UP.
@label=MenuAttributeHandle2UP
*$6238 CALL $6249    ; Flash the second line using #R$6249.
 $623B JR $622E      ; Jump to #R$622E.
; Handle flashing joystick.
@label=MenuAttributeHandleJoystick
*$623D CALL $6249    ; Flash the second line using #R$6249.
 $6240 JR $6235      ; Jump to #R$6235.

; Flash First Menu Line
;
; Used by the routine at #R$61EA.
; .
; Sets the FLASH attribute for the first of two menu lines and resets
; it for the second.
;
;   HL Pointer to the attribute byte of the first line
; O:HL Pointer to the attribute byte after the second line
@label=MenuAttributeSetFirst
c$6242 SET 7,(HL)    ; Set the FLASH attribute for the first selection.
 $6244 INC HL        ; Move onto the next menu attribute.
 $6245 RES 7,(HL)    ; Unset the FLASH attribute for the second selection.
 $6247 INC HL        ; Move onto the next menu selection attribute.
 $6248 RET           ; Return.

; Flash Second Menu Line
;
; Used by the routine at #R$61EA.
; .
; Resets the FLASH attribute for the first of two menu lines and sets
; it for the second.
;
;   HL Pointer to the attribute byte of the first line
; O:HL Pointer to the attribute byte after the second line
@label=MenuAttributeSetSecond
c$6249 RES 7,(HL)    ; Unset the FLASH attribute for the first selection.
 $624B INC HL        ; Move onto the next menu attribute.
 $624C SET 7,(HL)    ; Set the FLASH attribute for the second selection.
 $624E INC HL        ; Move onto the next menu selection attribute.
 $624F RET           ; Return.

; Game Selection Menu
;
; Used by the routine at #R$61EA.
; .
; Prints the six lines of the game selection menu, each with its own
; attribute byte and Y position, and then the copyright message at the
; bottom of the screen. The main registers hold the pointer to the attribute
; table, and the shadow registers hold the pointer to the Y position table
; (#REGhl'), the pointer to the text (#REGde') and the line counter (#REGb').
; #PUSHS #UDGTABLE { #SIM(start=$61CD,stop=$61EA,clear=1,sp=$5D00)
; #POKES$5C37,$3C
; #SIM(start=$61EE,stop=$61F1,sp=$5D00)
; #SIM(start=$61F1,stop=$61F4,sp=$5D00)
; #SCR$02(game-menu) } UDGTABLE# #POPS
@label=GameMenu
c$6250 LD DE,$627C   ; Point #REGde at the table of menu attributes (#R$627C).
 $6253 EXX           ; Switch to the shadow registers.
 $6254 LD HL,$6282   ; #REGhl'=#R$6282 (the table of Y positions).
 $6257 LD DE,$6288   ; #REGde'=#R$6288 (the text of the menu).
; There are six lines of text.
 $625A LD B,$06      ; Set the line counter in #REGb' to #N$06.
@label=GameMenu_Loop
*$625C EXX           ; Switch back to the normal registers.
 $625D LD A,(DE)     ; {Store the attribute byte of the line to #R$5E21.
 $625E LD ($5E21),A  ; }
 $6261 INC DE        ; Move onto the next menu attribute.
 $6262 EXX           ; Switch to the shadow registers.
 $6263 PUSH BC       ; Stash the line counter (#REGbc') on the stack.
 $6264 LD A,(HL)     ; Fetch the Y position of the line from the table.
 $6265 INC HL        ; Move onto the next Y position in the table.
 $6266 PUSH HL       ; Stash the table pointer on the stack.
 $6267 LD H,A        ; {Set the Y position of the line in #REGh' and the X position (#N$38)
 $6268 LD L,$38      ; in #REGl'.}
 $626A CALL $62E7    ; Print the line using #R$62E7.
 $626D EXX           ; Switch to the shadow registers.
 $626E POP HL        ; {Restore the table pointer and the line counter from the
 $626F POP BC        ; stack.}
 $6270 INC DE        ; Move #REGde' onto the next line of text.
 $6271 DJNZ $625C    ; Decrease the line counter by one and loop back to #R$625C until all
                     ; six lines have been printed.
; Print the copyright footer.
 $6273 LD HL,$B800   ; #REGhl=#N$B800 (the screen position of the copyright
                     ; message).
 $6276 LD DE,$5EF5   ; #REGde=the copyright message (#R$5EF5).
 $6279 JP $73ED      ; Jump to #R$73ED.
; View the equivalent code in;
; #LIST
; { #ATICATAC$7CAF }
; { #COOKIE$6332 }
; { #JETPAC$6260 }
; { #LUNARJETMAN$80D1 }
; { #SABREWULF$B473 }
; { #TRANZAM$5F6C }
; { #UNDERWURLDE$90E4 }
; LIST#

; Game Select Attribute Table
;
; One attribute byte per menu line. The routines that flash the
; selected line set or clear FLASH in the byte for the line being
; updated. The first byte belongs to the title, so the flashing code
; starts at #R$627D.
; #TABLE(default,centre)
; { =h Byte(n) | =h Menu Item }
; { #N$01 | Game Selection }
; { #N$02 | 1 Player Game }
; { #N$03 | 2 Player Game }
; { #N$04 | Keyboard }
; { #N$05 | Kempston Joystick }
; { #N$06 | Start Game }
; TABLE#
@label=GameSelection_Attributes
b$627C DEFB $47      ; Attribute for "GAME SELECTION": #COLOUR(#PEEK(#PC)).
@label=GameSelection_Attributes_Options
 $627D DEFB $47      ; {Attributes for "1 PLAYER GAME" and "2 PLAYER GAME".
 $627E DEFB $47      ; }
 $627F DEFB $47      ; {Attributes for "KEYBOARD" and "KEMPSTON JOYSTICK".
 $6280 DEFB $47      ; }
 $6281 DEFB $47      ; Attribute for "START GAME": #COLOUR(#PEEK(#PC)).
; View the equivalent code in;
; #LIST
; { #ATICATAC$7CEA }
; { #COOKIE$635E }
; { #JETPAC$628D }
; { #LUNARJETMAN$810E }
; { #SABREWULF$B498 }
; { #TRANZAM$5FA7 }
; { #UNDERWURLDE$9119 }
; LIST#

; Game Select Y Position Table
;
; The Y position of each menu line in pixels, with the X position of
; each line being fixed at #N$38.
@label=GameSelection_Position
b$6282 DEFB $20      ; {#TABLE(default,centre,centre)
 $6283 DEFB $38      ; { =h Byte(n) | =h Position | =h Menu Item }
 $6284 DEFB $48      ; { #N$01 | #EVAL(#PEEK(#PC+$00) / $08) | Game Selection }
 $6285 DEFB $58      ; { #N$02 | #EVAL(#PEEK(#PC+$01) / $08) | 1 Player Game }
 $6286 DEFB $68      ; { #N$03 | #EVAL(#PEEK(#PC+$02) / $08) | 2 Player Game }
 $6287 DEFB $98      ; { #N$04 | #EVAL(#PEEK(#PC+$03) / $08) | Keyboard }
                     ; { #N$05 | #EVAL(#PEEK(#PC+$04) / $08) | Kempston Joystick }
                     ; { #N$06 | #EVAL(#PEEK(#PC+$05) / $08) | Start Game }
                     ; TABLE#}
; View the equivalent code in;
; #LIST
; { #ATICATAC$7CF1 }
; { #COOKIE$6365 }
; { #JETPAC$6293 }
; { #LUNARJETMAN$8115 }
; { #SABREWULF$B4A0 }
; { #TRANZAM$5FAC }
; { #UNDERWURLDE$911F }
; LIST#

; Messaging: Game Selection Screen Text
;
; The text of each menu line. There is no attribute byte as that comes
; from #R$627C, and the last character of each string has bit 7 set.
@label=GameSelection_Text
t$6288 DEFM "GAME SELECTIO","N"+$80        ; "GAME SELECTION".
 $6296 DEFM "1   1 PLAYER GAM","E"+$80     ; "1   1 PLAYER GAME".
 $62A7 DEFM "2   2 PLAYER GAM","E"+$80     ; "2   2 PLAYER GAME".
 $62B8 DEFM "3   KEYBOAR","D"+$80          ; "3   KEYBOARD".
 $62C4 DEFM "4   KEMPSTON JOYSTIC","K"+$80 ; "4   KEMPSTON JOYSTICK".
 $62D9 DEFM "5   START GAM","E"+$80        ; "5   START GAME".
; View the equivalent code in;
; #LIST
; { #ATICATAC$7CF8 }
; { #COOKIE$636C }
; { #JETPAC$6299 }
; { #LUNARJETMAN$811C }
; { #SABREWULF$B4B0 }
; { #TRANZAM$5FB1 }
; { #UNDERWURLDE$9125 }
; LIST#

; Write Menu Line
;
; Used by the routine at #R$6250.
; .
; Prints one line of the game selection menu. This is similar to
; #R$73ED, but the attribute comes from #R$5E21 and the text has no
; attribute byte. It is called with the shadow registers selected, so
; that #REGhl' and #REGde' hold the position and the text.
; #PUSHS #UDGTABLE(default,centre)
; { =h Before }
; { #SIM(start=$61CD,stop=$61EA,clear=1,sp=$5D00)
; #POKES$5C37,$3C
; #SIM(start=$61EE,stop=$61F1,sp=$5D00)
; #SCR$02,$05,$03,$18,$03(menu-line-before) }
; { =h After }
; { #POKES$5E21,$47;$5D00,$00,$02
; #SIM(start=$62E7,stop=$0000,hl=$2038,de=$6288,sp=$5D00)
; #SCR$02,$05,$03,$18,$03(menu-line-after) } UDGTABLE# #POPS
;
; DE' Pointer to the text
; HL' Position (X in #REGl', Y in #REGh')
@label=MenuWriteText
c$62E7 PUSH HL       ; Stash the position (#REGhl) on the stack.
 $62E8 CALL $759A    ; Convert the co-ordinate to a screen address using
                     ; #R$759A.
 $62EB LD A,($5E21)  ; #REGa=the menu attribute byte from #R$5E21.
 $62EE EX AF,AF'     ; Keep the attribute in the shadow #REGaf register.
 $62EF EXX           ; Switch to the shadow registers.
 $62F0 POP HL        ; Restore #REGhl from the stack.
 $62F1 CALL $748F    ; Convert the co-ordinate to an attribute buffer address using
                     ; #R$748F.
 $62F4 JP $73F9      ; Jump to #R$73F9 to print the text and write the
                     ; attributes.
; View the equivalent code in;
; #LIST
; { #ATICATAC$7D8A }
; { #COOKIE$63E0 }
; { #LUNARJETMAN$81AB }
; { #SABREWULF$B52D }
; { #TRANZAM$5F97 }
; { #UNDERWURLDE$91B0 }
; LIST#

; Reset Player Data
;
; Used by the routine at #R$632D.
; .
; Gives both players their starting level and lives, and resets their
; cubby holes, flower and leaves. The data is set up for one player and then
; swapped using #R$613B, and then the same is done for the other.
@label=ResetPlayerData
c$62F7 LD B,$02      ; Set the player counter to #N$02 (a game has at most two
                     ; players).
@label=ResetPlayerData_Loop
*$62F9 PUSH BC       ; Stash the player counter on the stack.
 $62FA XOR A         ; {Reset #R$5E37 to #N$00 (level 1).
 $62FB LD ($5E37),A  ; }
 $62FE LD A,$04      ; {Set #R$5E38 to #N$04.
 $6300 LD ($5E38),A  ; }
 $6303 CALL $5FA0    ; Reset the cubby holes using #R$5FA0.
 $6306 CALL $5F40    ; Reset the flower and leaves using #R$5F40.
 $6309 CALL $613B    ; Swap the players using #R$613B.
 $630C POP BC        ; Restore the player counter from the stack.
 $630D DJNZ $62F9    ; Decrease the player counter by one and loop back to #R$62F9 until
                     ; both players have been set up.
; 2UP has one "extra" life, due to the way the game "spends" a life
; when your turn starts.
 $630F LD A,$05      ; {Write #N$05 to #R$5E3A.
 $6311 LD ($5E3A),A  ; }
 $6314 LD A,($5E03)  ; #REGa=the game options from #R$5E03.
 $6317 AND %00000001 ; Keep only bit 0 (1 or 2 players).
 $6319 RET NZ        ; Return if this is a two player game.
 $631A LD ($5E3A),A  ; Else, write #N$00 to #R$5E3A (2UP has no lives).
 $631D RET           ; Return.

; Messaging: Spray The Bugs
;
; Shown when a new game is about to start.
@label=Message_SprayBugs
t$631E DEFM $47                     ; {Attribute: #COLOUR(#PEEK(#PC)) + "SPRAY
 $631F DEFM "SPRAY THE BUG","S"+$80 ; THE BUGS".}

; Start Game
;
; Used by the routine at #R$61EA.
; .
; Shows the "SPRAY THE BUGS" message, clears the scores and all of the
; game variables and objects, sets up the data for both players and then
; starts the first level. Continues on to the main loop.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$61CD,stop=$61EA,clear=1,sp=$5D00)
; #POKES$5C37,$3C
; #SIM(start=$61EE,stop=$61F1,sp=$5D00)
; #SIM(start=$61F1,stop=$61F4,sp=$5D00)
; #SCR$01(start-game-before)
; | #SIM(start=$632D,stop=$610E,sp=$5D00)
; #SCR$01(start-game-after) } UDGTABLE# #POPS
@label=StartGame
c$632D CALL $5F53    ; Create the game window using #R$5F53.
 $6330 LD HL,$7048   ; #REGhl=#N($7048, 4, 4) (screen position).
 $6333 LD DE,$631E   ; #REGde=#R$631E.
 $6336 CALL $610B    ; Print the message and pause using #R$610B.
 $6339 LD HL,$5E05   ; {Write #N$00 to every byte from #R$5E05 to #N$5EEB (the scores,
 $633C LD (HL),$00   ; the game variables and the objects).
 $633E LD D,H        ;
 $633F LD E,L        ;
 $6340 INC DE        ;
 $6341 LD BC,$00E6   ;
 $6344 LDIR          ; }
 $6346 CALL $62F7    ; Reset the player data using #R$62F7.
 $6349 CALL $7113    ; Reset the modified code using #R$7113.
 $634C CALL $5F80    ; Start the first level using #R$5F80.
; Continue on to #R$634F.
; .
; View the equivalent code in;
; #LIST
; { #ATICATAC$7D9A }
; { #COOKIE$6428 }
; { #JETPAC$6333 }
; { #LUNARJETMAN$81BB }
; { #TRANZAM$5FEF }
; LIST#

; Run Main Loop
;
; Used by the routines at #R$71BE and #R$721A.
; .
; The main game loop. The objects from #R$5E6C onwards are #N$08 bytes
; each, and the loop calls the update routine for the type of each object
; in turn (see #R$637E). Every update routine returns to #R$7130, which
; moves on to the next object.
; .
; A pass starts here with the flower object at #R$5E8C and carries on up to
; the last object (the explosion at #R$5EE4), then the next pass is started
; here again. Whenever the frame counter has changed, #R$70ED is called to
; update the first four objects (Robbie, the spray can and the two weapons)
; once. This means that these are updated on every frame no matter how long
; a pass through the other objects takes.
;
; .
;
; Start a new pass through the objects.
@label=MainLoop_NewPass
c$634F LD SP,$5D00   ; #REGsp=#N$5D00.
 $6352 EI            ; Enable interrupts.
 $6353 LD IX,$5E8C   ; #REGix=#R$5E8C (the flower object).
 $6357 XOR A         ; {Write #N$00 to #R$5E16 to reset the enemy counter.
 $6358 LD ($5E16),A  ; }
; This entry point is used by the routines at #R$70ED and #R$7130.
; .
; Check whether the frame counter has changed.
@label=MainLoop
*$635B LD A,($5C78)  ; {Compare #SKOOLKID$5C78(FRAMES) and #R$5E1F.
 $635E LD C,A        ;
 $635F LD A,($5E1F)  ; }
 $6362 CP C          ; {If they are not equal call #R$70ED to update the fast
 $6363 CALL NZ,$70ED ; objects.}
; Every update routine returns to #R$7130.
 $6366 LD HL,$7130   ; #REGhl=#R$7130 (the routine which moves onto the next
                     ; object).
 $6369 PUSH HL       ; Stash the return address on the stack.
; Find the update routine for the type of the object.
 $636A LD HL,$637E   ; #REGhl=#R$637E.
 $636D LD A,(IX+$00) ; #REGa=*#REGix+#N$00 (the object state).
 $6370 RLCA          ; Rotate #REGa left once.
 $6371 AND %01111110 ; Keep only bits 1-6 (the object type, held in bits 0-5 of the
                     ; state, multiplied by two).
@label=PerformJump
 $6373 LD C,A        ; {#REGbc=the offset into the jump table.
 $6374 LD B,$00      ; }
 $6376 ADD HL,BC     ; #REGhl=the address of the entry in the jump table.
 $6377 LD A,(HL)     ; {#REGhl=the address of the update routine from the jump
 $6378 INC HL        ; table.
 $6379 LD H,(HL)     ;
 $637A LD L,A        ; }
 $637B JP $5CB0      ; Jump to #R$5CB0 which does an indirect jump to the jump
                     ; address.

; Main Jump Table
;
; The update routine for each object type, indexed by the type held in
; bits 0-5 of the state byte of an object. Bits 6 and 7 of the state byte
; are flags used by the update routines for the type.
@label=JumpTable_Main
w$637E DEFW $70DF    ; Type #N$00: an inactive object, handled by #R$70DF.
 $6380 DEFW $6DBA    ; Type #N$01: Robbie without a spray can, handled by
                     ; #R$6DBA.
 $6382 DEFW $6EF1    ; Type #N$02: Robbie carrying a spray can, handled by
                     ; #R$6EF1.
 $6384 DEFW $6ED2    ; Type #N$03: the spray can being carried, handled by
                     ; #R$6ED2.
 $6386 DEFW $6BD0    ; Type #N$04: a smoke bomb, handled by #R$6BD0.
 $6388 DEFW $6BD0    ; Type #N$05: a smoke bomb, handled by #R$6BD0.
 $638A DEFW $6BD0    ; Type #N$06: a smoke bomb, handled by #R$6BD0.
 $638C DEFW $6A98    ; Type #N$07: a space slug, handled by #R$6A98.
 $638E DEFW $698F    ; Type #N$08: insect repellent, handled by #R$698F.
 $6390 DEFW $67AE    ; Type #N$09: midges, handled by #R$67AE.
 $6392 DEFW $64FA    ; Type #N$0A: a leech, handled by #R$64FA.
 $6394 DEFW $70DF    ; Type #N$0B: a bonus item, which is never in the main loop,
                     ; handled by #R$70DF.
 $6396 DEFW $70DF    ; Type #N$0C: a bonus item, which is never in the main loop,
                     ; handled by #R$70DF.
 $6398 DEFW $70DF    ; Type #N$0D: a bonus item, which is never in the main loop,
                     ; handled by #R$70DF.
 $639A DEFW $70DF    ; Type #N$0E: not used, handled by #R$70DF.
 $639C DEFW $70DF    ; Type #N$0F: not used, handled by #R$70DF.
 $639E DEFW $6D0C    ; Type #N$10: the flower, handled by #R$6D0C.
 $63A0 DEFW $6C53    ; Type #N$11: a leaf, handled by #R$6C53.
 $63A2 DEFW $69E8    ; Type #N$12: a streamer, handled by #R$69E8.
 $63A4 DEFW $66A6    ; Type #N$13: the flower in bloom, handled by #R$66A6.
 $63A6 DEFW $65F7    ; Type #N$14: an explosion, handled by #R$65F7.
 $63A8 DEFW $63DB    ; Type #N$15: an idle object, handled by #R$63DB (which just
                     ; returns).

; Check Bug Leaf Collision
;
; Used by the routine at #R$64ED.
; .
; Checks whether the bug being updated (#REGix) is touching any of the
; four leaf objects. If it is on top of an active leaf, the leaf is marked as
; being eaten and it returns straight away, so only one leaf is eaten at a
; time.
@label=LeafCollision
c$63AA LD HL,$5E94   ; #REGhl=#R$5E94 (the first leaf object).
 $63AD LD B,$04      ; Set the leaf counter to #N$04.
 $63AF LD DE,$0008   ; #REGde=#N$0008
                     ; (the size of an object, used to move onto the next leaf).
@label=LeafCollision_Loop
*$63B2 PUSH HL       ; Stash the address of the leaf on the stack.
 $63B3 LD A,(HL)     ; {If the current leaf is not active, jump to #R$63DC.
 $63B4 AND A         ;
 $63B5 JR Z,$63DC    ; }
; Is the leaf within #N$09 pixels of the bug horizontally?
 $63B7 INC HL        ; {#REGa=the X position of the leaf.
 $63B8 LD A,(HL)     ; }
 $63B9 SUB (IX+$01)  ; Subtract the X position of the bug.
 $63BC JP P,$63C1    ; {Make the horizontal distance positive.
 $63BF NEG           ; }
@label=LeafCollision_Test_X
*$63C1 CP $0A        ; {Jump to #R$63DC if the leaf is #N$0A or more pixels
 $63C3 JR NC,$63DC   ; away.}
; Is the leaf within #N$09 pixels of the bug vertically?
 $63C5 INC HL        ; {#REGa=the Y position of the leaf.
 $63C6 LD A,(HL)     ; }
 $63C7 SUB (IX+$02)  ; Subtract the Y position of the bug.
 $63CA JP P,$63CF    ; {Make the vertical distance positive.
 $63CD NEG           ; }
@label=LeafCollision_Test_Y
*$63CF CP $0A        ; {Jump to #R$63DC if the leaf is #N$0A or more pixels
 $63D1 JR NC,$63DC   ; away.}
; The bug is on the leaf, so the leaf starts to shrink away.
 $63D3 INC HL        ; {Skip the colour attribute to point to the leaf
 $63D4 INC HL        ; animating flag.}
 $63D5 LD A,$01      ; {Write #N$01 to the animating flag and the "being eaten" flag of the
 $63D7 LD (HL),A     ; leaf (see #R$6C53).
 $63D8 INC HL        ;
 $63D9 LD (HL),A     ; }
 $63DA POP HL        ; Restore the address of the leaf from the stack.
 $63DB RET           ; Return.
; Move onto the next leaf object.
@label=LeafCollision_Next
*$63DC POP HL        ; Restore #REGhl from the stack.
 $63DD ADD HL,DE     ; Add the object size to move onto the next leaf.
 $63DE DJNZ $63B2    ; Decrease the leaf counter by one and loop back to #R$63B2 until all
                     ; four leaves have been checked.
 $63E0 RET           ; Return.

; Play Tune
;
; Used by the routine at #R$66D7.
; .
; Plays a tune one note at a time until the terminator is reached. The
; low five bits of each byte in the tune data are a note number from #N$01
; to #N$08, which is used to look up the pitch and the duration of the note
; in the table at #R$640D for the ROM #SKOOLKID$03B5(BEEPER) routine.
;
; DE Pointer to the tune data
@label=PlayMusic
c$63E1 LD A,(DE)     ; Fetch the next note of the tune.
 $63E2 CP $FF        ; {Return if the terminator (#N$FF) has been reached.
 $63E4 RET Z         ; }
 $63E5 AND %00011111 ; Keep only bits 0-4 (the note number).
 $63E7 DEC A         ; Decrease the note number by one (the notes are numbered
                     ; from one).
 $63E8 SLA A         ; Double it, as there are two bytes for each note in the
                     ; table.
 $63EA LD C,A        ; {Make this the offset into the note table in #REGbc.
 $63EB LD B,$00      ; }
 $63ED LD HL,$640D   ; #REGhl=#R$640D (the note table).
 $63F0 ADD HL,BC     ; Add the offset to find the note.
 $63F1 PUSH DE       ; Stash the tune pointer on the stack.
 $63F2 LD A,(HL)     ; Fetch the pitch of the note.
 $63F3 INC HL        ; Move onto the duration of the note.
 $63F4 LD E,(HL)     ; #REGe=the duration of the note.
 $63F5 LD D,$00      ; Set the high byte of the duration (#REGd) to #N$00.
 $63F7 LD L,A        ; {#REGhl=the pitch of the note.
 $63F8 LD H,$00      ; }
 $63FA SLA L         ; {Multiply #REGhl by four to make the pitch for the
 $63FC RL H          ; beeper.
 $63FE SLA L         ;
 $6400 RL H          ; }
 $6402 PUSH IX       ; Stash #REGix on the stack, as the beeper routine
                     ; overwrites it.
 $6404 CALL $03B5    ; Call #SKOOLKID$03B5(BEEPER).
 $6407 POP IX        ; {Restore #REGix and the tune pointer from the stack.
 $6409 POP DE        ; }
 $640A INC DE        ; Move onto the next note of the tune.
 $640B JR $63E1      ; Loop back round to #R$63E1 to play the next note
                     ; (the tune only ends when the terminator is reached).

; Note Table
;
; The pitch and the duration for each of the eight notes of a scale,
; which are used as the inputs for the ROM #SKOOLKID$03B5(BEEPER) routine.
; The pitch is multiplied by four by #R$63E1 and, as the pitch gets
; higher, the duration gets longer so that every note lasts for about the
; same time.
@label=NoteTable
b$640D DEFB $E0,$62  ; {Note #N$01 to note #N$08 (pitch, duration).
 $640F DEFB $C7,$6E  ;
 $6411 DEFB $B1,$7B  ;
 $6413 DEFB $A7,$83  ;
 $6415 DEFB $95,$93  ;
 $6417 DEFB $85,$A4  ;
 $6419 DEFB $7D,$AF  ;
 $641B DEFB $6E,$C3  ; }

; Level Complete Tune
;
; A rising scale with each note played twice. The data has no
; terminator, so it runs straight on into the tune at #R$642D.
; .
; #HTML(#AUDIO0(level-complete-tune.wav)(#INCLUDE(LevelCompleteTune)))
@label=Tune_Scale
b$641D DEFB $01,$01  ; {Notes #N$01 to #N$08, two of each.
 $641F DEFB $02,$02  ;
 $6421 DEFB $03,$03  ;
 $6423 DEFB $04,$04  ;
 $6425 DEFB $05,$05  ;
 $6427 DEFB $06,$06  ;
 $6429 DEFB $07,$07  ;
 $642B DEFB $08,$08  ; }

; Jingle Tune
;
; A short jingle, ending with the terminator (#N$FF) that stops
; #R$63E1.
; .
; #HTML(#AUDIO0(jingle-tune.wav)(#INCLUDE(JingleTune)))
@label=Tune_Jingle
b$642D DEFB $04,$06,$08,$06,$07,$05,$03,$01 ; {Note numbers (#N$04, #N$06,
 $6435 DEFB $04,$06,$08,$06,$07,$05,$03,$03 ; #N$08 and so on).
 $643D DEFB $04,$06,$08,$06,$07,$05,$03,$01 ;
 $6445 DEFB $04,$06,$02,$03,$04,$04,$04     ; }
 $644C DEFB $FF                             ; Terminator.

; Check Bug Flower Collision
;
; Used by the routines at #R$64FA, #R$67AE and #R$6A98.
; .
; Checks whether a bug is touching the flower, using a window that is
; wider for a slug than it is for the midges and the leech. It also only
; counts when the bug is below the top of the flower.
;
;   IX Bug object
; O:E #N$00 No collision
; O:E #N$01 Collision
@label=BugFlowerCollision
c$644D LD E,$00       ; #REGe=#N$00 (no collision).
 $644F LD HL,$5E8D    ; #REGhl=#R$5E8D (the X position of the flower).
; Calculate the horizontal distance between the flower and the bug.
 $6452 LD A,(HL)      ; #REGa=flower X position.
 $6453 SUB (IX+$01)   ; Subtract the bug X position.
 $6456 ADD A,$09      ; Add #N$09 (so a bug up to #N$09 pixels to the right of the flower
                      ; gives zero).
 $6458 BIT 3,(IX+$00) ; {Jump to #R$6462 if the bug is not a slug (bit 3 of the type is
 $645C JR NZ,$6462    ; set for the midges and the leech).}
 $645E CP $24         ; Compare #REGa with #N$24 (the width of the window for a
                      ; slug).
 $6460 JR $6464       ; Jump to #R$6464.
@label=BugFlowerCollision_Narrow
*$6462 CP $1C         ; Compare #REGa with #N$1C (the width of the window for the other
                      ; bugs).
@label=BugFlowerCollision_TestX
*$6464 RET NC         ; Return if the bug is too far away horizontally.
; Is the bug below the top of the flower?
 $6465 INC HL         ; Increment #REGhl by one to point to the flower Y
                      ; position.
 $6466 LD A,(HL)      ; {Halve the flower Y position.
 $6467 SRL A          ; }
 $6469 LD D,(IX+$02)  ; {Halve the bug Y position into #REGd.
 $646C SRL D          ; }
 $646E SUB D          ; Subtract the halved bug Y position from the halved flower Y
                      ; position.
 $646F RET NC         ; Return if the flower is not above the bug.
 $6470 LD E,$01       ; #REGe=#N$01 (collision).
 $6472 RET            ; Return.

; Play Repellent Hit Sound
;
; Used by the routine at #R$65CB.
; .
; Plays #N$0F square waves of nearly constant pitch.
; .
; #HTML(#AUDIO0(repellent-hit.wav)(#INCLUDE(RepellentHit)))
@label=PlayRepellentHitSound
c$6473 LD C,$0F      ; Set the wave counter in #REGc to #N$0F.
@label=PlayRepellentHitSound_Loop
*$6475 LD A,C        ; Fetch the wave counter.
 $6476 RRCA          ; {Rotate the wave counter right three times.
 $6477 RRCA          ;
 $6478 RRCA          ; }
 $6479 AND %00000111 ; Keep only bits 0-2.
 $647B CPL           ; Invert all of the bits in #REGa.
 $647C DAA           ; Decimal adjust #REGa.
 $647D LD D,A        ; Use the result as the duration of the wave in #REGd.
 $647E CALL $64AA    ; Call #R$64AA.
 $6481 DEC C         ; Decrease the wave counter by one.
 $6482 JR NZ,$6475   ; Loop back to #R$6475 until all of the waves have been
                     ; played.
 $6484 RET           ; Return.

; Play Explosion Sound
;
; Used by the routine at #R$65DC.
; .
; Plays #N$20 square waves of falling pitch. A random value from
; #R$5E19 is written over the operand of the instruction at #R$6494, which
; changes the durations, so this isn't the same twice.
; .
; #HTML(#AUDIO0(explosion.wav)(#INCLUDE(Explosion)))
@label=PlayExplosionSound
c$6485 LD A,($5E19)  ; Fetch the random value from #R$5E19.
 $6488 AND %01111111 ; Keep only bits 0-6.
 $648A OR %00110000  ; Set bits 4-5.
 $648C LD ($6495),A  ; Write this over the operand of the instruction at
                     ; #R$6494.
 $648F LD C,$20      ; Set the wave counter in #REGc to #N$20.
@label=PlayExplosionSound_Loop
*$6491 LD A,C        ; Fetch the wave counter.
 $6492 XOR %00001111 ; Flip bits 0-3.
 $6494 AND %00011111 ; Keep only the bits set in the operand written at
                     ; #R$648C.
 $6496 LD D,A        ; Set the duration of the wave in #REGd.
 $6497 CALL $64AA    ; Call #R$64AA.
 $649A DEC C         ; Decrease the wave counter by one.
 $649B JR NZ,$6491   ; Loop back to #R$6491 until all of the waves have been
                     ; played.
 $649D RET           ; Return.

; Play Repellent Sound
;
; Used by the routine at #R$6BA5.
; .
; Plays #N$10 square waves, alternating between a high and a low pitch.
; .
; #HTML(#AUDIO0(repellent.wav)(#INCLUDE(Repellent)))
@label=PlayRepellentSound
c$649E LD C,$10      ; Set the wave counter in #REGc to #N$10.
@label=PlayRepellentSound_Loop
*$64A0 LD A,C        ; Fetch the wave counter.
 $64A1 RRCA          ; Rotate #REGa right once.
 $64A2 LD D,A        ; Set the duration of the wave in #REGd.
 $64A3 CALL $64AA    ; Call #R$64AA.
 $64A6 DEC C         ; Decrease the wave counter by one.
 $64A7 JR NZ,$64A0   ; Loop back to #R$64A0 until all of the waves have been
                     ; played.
 $64A9 RET           ; Return.

; Play Square Wave
;
; Used by the routines at #R$6473, #R$6485, #R$649E, #R$64B8, #R$64C9 and
; #R$64DC.
; .
; Plays one square wave: the speaker is switched on for the duration,
; then off for the same duration.
;
; D Duration of wave
@label=PlaySquareWave
c$64AA LD A,$10      ; {Switch the speaker on (bit 4) and write it to the port.
 $64AC OUT ($FE),A   ; }
 $64AE LD B,D        ; Set the delay counter in #REGb to the duration of the
                     ; wave.
@label=PlaySquareWave_Loop
*$64AF DJNZ $64AF    ; Decrease the delay counter by one and loop back to #R$64AF until the
                     ; speaker has been on for the whole duration.
 $64B1 XOR A         ; {Switch the speaker off and write it to the port.
 $64B2 OUT ($FE),A   ; }
 $64B4 LD B,D        ; Set the delay counter in #REGb to the duration of the
                     ; wave.
@label=Silence_Loop
*$64B5 DJNZ $64B5    ; Decrease the delay counter by one and loop back to #R$64B5 until the
                     ; speaker has been off for the whole duration.
 $64B7 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #COOKIE$68B1 }
; { #LUNARJETMAN$B8DA }
; { #MARTIANOIDS$C062 }
; { #SABREWULF$BF74 }
; LIST#

; Play Streamer Sound
;
; Used by the routine at #R$6BA5.
; .
; Plays #N$08 square waves of varying pitch.
; .
; #HTML(#AUDIO0(streamer.wav)(#INCLUDE(Streamer)))
@label=PlayStreamerSound
c$64B8 LD C,$08      ; Set the wave counter in #REGc to #N$08.
@label=PlayStreamerSound_Loop
*$64BA LD A,C        ; Fetch the wave counter.
 $64BB RLCA          ; {Rotate #REGa left twice.
 $64BC RLCA          ; }
 $64BD XOR %00000111 ; Flip bits 0-2.
 $64BF RLCA          ; {Rotate #REGa left twice.
 $64C0 RLCA          ; }
 $64C1 LD D,A        ; Set the duration of the wave in #REGd.
 $64C2 CALL $64AA    ; Call #R$64AA.
 $64C5 DEC C         ; Decrease the wave counter by one.
 $64C6 JR NZ,$64BA   ; Loop back to #R$64BA until all of the waves have been
                     ; played.
 $64C8 RET           ; Return.

; Play Smoke Sound
;
; Used by the routine at #R$6BA5.
; .
; Plays #N$08 square waves of falling pitch.
; .
; #HTML(#AUDIO0(smoke.wav)(#INCLUDE(Smoke)))
@label=PlaySmokeSound
c$64C9 LD C,$08      ; Set the wave counter in #REGc to #N$08.
@label=PlaySmokeSound_Loop
*$64CB LD A,C        ; Fetch the wave counter.
 $64CC CPL           ; Invert all of the bits in #REGa.
 $64CD RLCA          ; Rotate #REGa left once.
 $64CE LD D,A        ; Set the duration of the wave in #REGd.
 $64CF CALL $64AA    ; Call #R$64AA.
 $64D2 DEC C         ; Decrease the wave counter by one.
 $64D3 JR NZ,$64CB   ; Loop back to #R$64CB until all of the waves have been
                     ; played.
 $64D5 RET           ; Return.

; Play High Tone
;
; Used by the routine at #R$6DBA.
; .
; Plays #N$50 square waves with a duration of #N$20.
; .
; #HTML(#AUDIO0(high-tone.wav)(#INCLUDE(HighTone)))
@label=PlayHighTone
c$64D6 LD D,$20      ; Set the duration of the wave in #REGd to #N$20.
 $64D8 LD C,$50      ; Set the wave counter in #REGc to #N$50.
 $64DA JR $64E0      ; Jump to #R$64E0.

; Play Low Tone
;
; Used by the routine at #R$7007.
; .
; Plays #N$28 square waves with a duration of #N$50.
; .
; #HTML(#AUDIO0(low-tone.wav)(#INCLUDE(LowTone)))
@label=PlayLowTone
c$64DC LD D,$50      ; Set the duration of the wave in #REGd to #N$50.
 $64DE LD C,$28      ; Set the wave counter in #REGc to #N$28.
; This entry point is used by the routines at #R$64D6 and #R$64E7.
; .
; Play each wave until all of the waves have been played.
@label=PlayTone_Loop
*$64E0 CALL $64AA    ; Play a wave using #R$64AA.
 $64E3 DEC C         ; Decrease the wave counter by one.
 $64E4 JR NZ,$64E0   ; Loop back to #R$64E0 until all of the waves have been
                     ; played.
 $64E6 RET           ; Return.

; Play Mid Tone
;
; Used by the routines at #R$6DBA and #R$71BE.
; .
; Plays #N$40 square waves with a duration of #N$30.
; .
; #HTML(#AUDIO0(mid-tone.wav)(#INCLUDE(MidTone)))
@label=PlayMidTone
c$64E7 LD D,$30      ; Set the duration of the wave in #REGd to #N$30.
 $64E9 LD C,$40      ; Set the wave counter in #REGc to #N$40.
 $64EB JR $64E0      ; Jump to #R$64E0.

; Update Bug Common
;
; Used by the routines at #R$64FA, #R$67AE and #R$6A98.
; .
; The checks which are made at the start of the update of every bug.
; This counts the bug (the bug counter at #R$5E16 is used to decide when to
; spawn more bugs), remembers the position and state of the bug so that
; it can be erased, checks the bug against the leaves and finally checks
; whether the bug is touching Robbie by jumping to #R$72F5, which returns
; to the caller.
;
;   IX Bug object
; O:E #N$00 The bug is not touching Robbie
; O:E #N$01 The bug is touching Robbie
@label=UpdateBugCommon
c$64ED LD HL,$5E16   ; #REGhl=#R$5E16 (the bug counter).
 $64F0 INC (HL)      ; Increment the bug counter by one.
 $64F1 CALL $75B9    ; Remember the position and state of the bug using
                     ; #R$75B9.
 $64F4 CALL $63AA    ; Call #R$63AA.
 $64F7 JP $72F5      ; Jump to #R$72F5.

; Update Leech
;
; Updates a leech. If the leech is touching Robbie then both explode. A
; weapon hitting the leech either kills it (a streamer, worth #N$75 points)
; or stuns it for a while (the repellent spray), and smoke bombs have no
; effect. When the leech touches the flower it starts to eat it. Otherwise
; it crawls horizontally along the ground in steps of two pixels, bouncing
; off the sides of the play area, and every so often it also moves
; vertically for a random period.
;
; IX Leech object
;
; The object fields used are:
; #TABLE(default,centre)
; { =h Field | =h Use }
; { +0 bit 6 | Moving right }
; { +0 bit 7 | Moving down }
; { +4 bit 0 | Moving vertically }
; { +4 bit 2 | Stunned }
; { +4 bit 3 | Eating the flower }
; { +5 | Stun timer }
; { +6 | Vertical movement counter }
; TABLE#
@label=UpdateLeech
c$64FA CALL $64ED     ; Do the common bug checks using #R$64ED.
 $64FD DEC E          ; Decrease the collision result in #REGe by one
                      ; (zero means that the leech is touching Robbie).
 $64FE JP Z,$6A73     ; Jump to #R$6A73 if the leech is touching Robbie.
; Check whether a weapon has hit the leech.
 $6501 CALL $6A42     ; Check whether a weapon has hit the leech using #R$6A42.
 $6504 DEC E          ; Decrease the collision result in #REGe by one
                      ; (zero means that a weapon has hit the leech).
 $6505 JR NZ,$650C    ; Jump to #R$650C if there was no hit.
 $6507 LD A,C         ; {#REGa=the state of the weapon, and jump to #R$65BA if the weapon
 $6508 AND A          ; is active.
 $6509 JP NZ,$65BA    ; }
; This entry point is used by the routine at #R$65BA.
@label=UpdateLeech_NoWeaponHit
*$650C BIT 3,(IX+$04) ; {Jump to #R$6B3A if the leech is eating the flower.
 $6510 JP NZ,$6B3A    ; }
 $6513 CALL $644D     ; Check whether the leech has reached the flower using
                      ; #R$644D.
 $6516 DEC E          ; Decrease the collision result in #REGe by one
                      ; (zero means that the leech has reached the flower).
 $6517 JP Z,$679C     ; Jump to #R$679C if the leech has reached the flower, to start
                      ; eating it.
; Is the leech stunned?
 $651A BIT 2,(IX+$04) ; {Jump to #R$652A if the leech is not stunned.
 $651E JR Z,$652A     ; }
 $6520 DEC (IX+$05)   ; Decrease the stun timer in #REGix+#N$05 by one.
 $6523 JP NZ,$659F    ; Jump to #R$659F if the leech is still stunned, to redraw it
                      ; without moving.
 $6526 RES 2,(IX+$04) ; Reset bit 2 of #REGix+#N$04 (the stun has ended).
; If the leech is not moving vertically there is a one in thirty-two
; chance of it starting to.
@label=UpdateLeech_Vertical
*$652A BIT 0,(IX+$04) ; {Jump to #R$6555 if it is moving vertically.
 $652E JR NZ,$6555    ; }
 $6530 LD A,($5E19)   ; {#REGe=the random number from #R$5E19.
 $6533 LD E,A         ; }
 $6534 AND $1F        ; {Jump to #R$6555 unless the random number is a multiple
 $6536 JR NZ,$6555    ; of #N$20.}
 $6538 SET 0,(IX+$04) ; Set bit 0 of #REGix+#N$04 (moving vertically).
 $653C LD A,($5E17)   ; #REGa=#R$5E17.
 $653F AND %00011111  ; Keep only bits 0-4.
 $6541 ADD A,$10      ; Add #N$10 (this value is not stored, as the next instruction
                      ; overwrites it).
 $6543 LD A,(IX+$06)  ; #REGa=#REGix+#N$06 (the vertical movement counter).
 $6546 LD A,E         ; #REGa=the random number.
 $6547 AND %10000000  ; Keep only bit 7 (the direction).
 $6549 LD E,A         ; Keep the direction bit in #REGe.
 $654A LD A,(IX+$00)  ; #REGa=#REGix+#N$00 (the state).
 $654D AND %01111111  ; Reset bit 7 (move up).
 $654F OR E           ; {Set bit 7 if the random number had bit 7 set, and write the state
 $6550 LD (IX+$00),A  ; back.}
 $6553 JR $650C       ; Jump to #R$650C.
@label=UpdateLeech_MoveVertical
*$6555 BIT 0,(IX+$04) ; {Jump to #R$6587 if the leech is not moving vertically.
 $6559 JR Z,$6587     ; }
 $655B LD A,(IX+$01)  ; #REGa=leech X position.
 $655E CP $18         ; {Jump to #R$6587 if the leech is too far left to move
 $6560 JR C,$6587     ; vertically.}
 $6562 CP $D8         ; {Jump to #R$6587 if the leech is too far right to move
 $6564 JR NC,$6587    ; vertically.}
 $6566 LD A,(IX+$02)  ; #REGa=leech Y position.
 $6569 BIT 7,(IX+$00) ; {Jump to #R$65A2 if the leech is moving up (bit 7 is
 $656D JR Z,$65A2     ; not set).}
 $656F ADD A,$02      ; Add #N$02 to move down.
 $6571 CP $B8         ; {Jump to #R$657B if this is above the bottom of the
 $6573 JR C,$657B     ; play area.}
 $6575 RES 7,(IX+$00) ; Reset bit 7 of #REGix+#N$00 (turn the leech upwards).
 $6579 JR $657E       ; Jump to #R$657E.
@label=UpdateLeech_StoreY
*$657B LD (IX+$02),A  ; Write the new Y position.
@label=UpdateLeech_Countdown
*$657E DEC (IX+$06)   ; Decrease the vertical movement counter by one.
 $6581 JR NZ,$6587    ; Jump to #R$6587 if the counter is not zero.
 $6583 RES 0,(IX+$04) ; Reset bit 0 of #REGix+#N$04 (stop moving vertically).
; Move the leech horizontally.
@label=UpdateLeech_MoveHorizontal
*$6587 LD A,(IX+$01)  ; #REGa=leech X position.
 $658A BIT 6,(IX+$00) ; {Jump to #R$65AE if the leech is moving left (bit 6 is
 $658E JR Z,$65AE     ; not set).}
 $6590 ADD A,$02      ; Add #N$02 to move right.
 $6592 CP $D8         ; {Jump to #R$659C if this is not past the right edge.
 $6594 JR C,$659C     ; }
 $6596 RES 6,(IX+$00) ; Reset bit 6 of #REGix+#N$00 (turn the leech to the
                      ; left).
 $659A JR $659F       ; Jump to #R$659F.
@label=UpdateLeech_StoreX
*$659C LD (IX+$01),A  ; Write the new X position.
@label=UpdateLeech_Draw
*$659F JP $6F31       ; Jump to #R$6F31 to draw the leech.
; Moving up.
@label=UpdateLeech_MoveUp
*$65A2 SUB $02        ; Subtract #N$02 to move up.
 $65A4 CP $28         ; {Jump to #R$657B if this is not above the top limit.
 $65A6 JR NC,$657B    ; }
 $65A8 SET 7,(IX+$00) ; Set bit 7 of #REGix+#N$00 (turn the leech downwards).
 $65AC JR $657B       ; Jump to #R$657B.
; Moving left.
@label=UpdateLeech_MoveLeft
*$65AE SUB $02        ; Subtract #N$02 to move left.
 $65B0 CP $18         ; {Jump to #R$659C if this is not past the left edge.
 $65B2 JR NC,$659C    ; }
 $65B4 SET 6,(IX+$00) ; Set bit 6 of #REGix+#N$00 (turn the leech to the
                      ; right).
 $65B8 JR $659F       ; Jump to #R$659F.

; Handle Leech Weapon Hit
;
; Used by the routine at #R$64FA.
; .
; A weapon has hit the leech. A streamer kills it, the repellent spray
; stuns it and a smoke bomb has no effect.
;
; A State of the weapon
; IX Leech object
@label=LeechWeaponHit
c$65BA AND %00111111 ; Keep only bits 0-5 (the type of the weapon).
 $65BC CP $12        ; {Jump to #R$65D6 if the weapon is a streamer.
 $65BE JR Z,$65D6    ; }
 $65C0 CP $08        ; {Jump to #R$650C if it is not the repellent spray.
 $65C2 JP NZ,$650C   ; }
 $65C5 CALL $65CB    ; Call #R$65CB to stun the leech.
 $65C8 JP $650C      ; Jump to #R$650C.

; Stun Bug
;
; Used by the routines at #R$65BA, #R$68ED and #R$6B20.
; .
; Stuns a bug for #N$10 updates and plays the sound for a weapon hit.
;
; IX Bug object
@label=StunBug
c$65CB SET 2,(IX+$04)  ; Set bit 2 of #REGix+#N$04 (stunned).
 $65CF LD (IX+$05),$10 ; Write #N$10 to #REGix+#N$05 (the stun timer).
 $65D3 JP $6473        ; Jump to #R$6473 (which returns to the caller).

; Kill Leech
;
; Used by the routine at #R$65BA.
; .
; Adds #N$75 points to the score and then explodes the leech.
;
; IX Leech object
@label=KillLeech
c$65D6 LD BC,$0075   ; #REGbc=#N$0075 (the points for the kill).
; This entry point is used by the routine at #R$68ED.
@label=KillLeech_AddPoints
*$65D9 CALL $737A    ; Add the points to the score using #R$737A.

; Explode Bug
;
; Used by the routines at #R$6A73 and #R$6B20.
; .
; Turns a bug into an explosion. The state of the bug is kept in
; #REGix+#N$06 so that the object can be put back to how it was once the
; explosion has finished (see #R$65F7), and the explosion sound plays.
; .
; #HTML(#AUDIO0(explosion.wav)(#INCLUDE(Explosion)))
;
; IX Bug object
@label=ExplodeBug
c$65DC LD A,(IX+$00)   ; #REGa=the state of the bug.
 $65DF LD (IX+$05),$00 ; Write #N$00 to #REGix+#N$05 (the speed of the animation, which is
                       ; the fastest).
; This entry point is used by the routine at #R$65F1.
@label=ExplodeBug_RememberState
*$65E3 LD (IX+$06),A   ; Remember the old state in #REGix+#N$06.
 $65E6 LD (IX+$00),$14 ; Write #N$14 (an explosion) to #REGix+#N$00.
 $65EA LD (IX+$04),$00 ; Write #N$00 to #REGix+#N$04 (the first frame of the
                       ; animation).
 $65EE JP $6485        ; Jump to #R$6485 to play the explosion sound (which returns to the
                       ; caller).

; Start Explosion
;
; Used by the routine at #R$6A73.
; .
; Starts a slower explosion for Robbie, used by #R$6A73.
; .
; #HTML(#AUDIO0(explosion.wav)(#INCLUDE(Explosion)))
;
; A State to restore when the explosion is over
; IX Explosion object
@label=StartExplosion
c$65F1 LD (IX+$05),$01 ; Write #N$01 to #REGix+#N$05 (the speed of the animation, which is
                       ; every other update).
 $65F5 JR $65E3        ; Jump to #R$65E3.

; Animate Explosion
;
; Animates an explosion through three frames of a growing explosion
; (drawn in random colours) and then three frames to erase it again. At the
; end of the animation the object is restored to its old state (kept in
; #REGix+#N$06), then:
; #LIST
; { if it is a bug, the object is removed; }
; { if it was Robbie with an empty hand, the player's turn ends; }
; { if it was Robbie carrying a can, the can is put back into a random
; empty cubby hole and then the player's turn ends. }
; LIST#
;
; IX Explosion object
@label=AnimateExplosion
c$65F7 LD HL,$5E16     ; #REGhl=#R$5E16.
 $65FA INC (HL)        ; Increment the bug counter by one.
 $65FB LD C,(IX+$04)   ; #REGc=the animation frame from #REGix+#N$04.
 $65FE LD B,(IX+$05)   ; #REGb=the animation speed mask from #REGix+#N$05.
 $6601 LD A,($5E17)    ; #REGa=the game timer from #R$5E17.
 $6604 AND B           ; Keep only the bits set in the speed mask.
 $6605 JR NZ,$660A     ; Jump to #R$660A if the result is not zero.
 $6607 INC (IX+$04)    ; Increment the animation frame by one.
@label=ExplosionFetchSpriteFrame
*$660A LD A,C          ; #REGa=the current explosion animation frame.
 $660B SLA C           ; Double the frame to make an offset into the table.
 $660D LD B,$00        ; Clear the high byte of the offset in #REGb.
 $660F LD HL,$6682     ; #REGhl=#R$6682 (the table of explosion sprites).
 $6612 ADD HL,BC       ; Add the offset to find the sprite for the frame.
 $6613 LD E,(HL)       ; {#REGde=the sprite address for the frame from the
 $6614 INC HL          ; table.
 $6615 LD D,(HL)       ; }
 $6616 LD L,(IX+$01)   ; #REGl=the X position of the explosion.
 $6619 LD H,(IX+$02)   ; #REGh=the Y position of the explosion.
 $661C CP $06          ; {If the current frame >= #N$06 then the animation has
 $661E JR NC,$6634     ; finished.}
 $6620 CP $03          ; {If the current frame >= #N$03 then we are erasing it.
 $6622 JR NC,$667C     ; }
 $6624 CALL $751C      ; Call #R$751C.
 $6627 LD A,($5E19)    ; #REGa=#R$5E19.
 $662A AND %00000111   ; Keep only bits 0-2.
 $662C OR %01000010    ; Set bits 1 and 6 (BRIGHT).
 $662E LD (IX+$03),A   ; Write the random colour to #REGix+#N$03
                       ; (the colour of the explosion).
 $6631 JP $7450        ; Jump to #R$7450.
; After an explosion, we check if it was the player that died!
@label=AnimateExplosion_End
*$6634 LD A,(IX+$06)   ; {Restore the old state of the object from
 $6637 LD (IX+$00),A   ; #REGix+#N$06.}
 $663A CALL $75B9      ; Call #R$75B9.
 $663D CALL $7526      ; Call #R$7526.
 $6640 LD (IX+$00),$00 ; Write #N$00 to #REGix+#N$00 (make the object
                       ; inactive).
 $6644 LD A,(IX+$06)   ; #REGa=the old state.
 $6647 AND %00111111   ; Keep only bits 0-5.
 $6649 CP $03          ; {Return if it was not Robbie (#REGa >= #N$03).
 $664B RET NC          ; }
 $664C CP $02          ; {Jump to #R$60AA if Robbie was not carrying a can (the type is not
 $664E JP NZ,$60AA     ; #N$02).}
; Robbie was carrying a can, so put it back in an empty cubby hole. A
; random hole is tried first, and then the following holes until an empty
; one is found.
 $6651 LD HL,$5E23     ; #REGhl=#R$5E23 (the first cubby hole).
 $6654 LD BC,$5E2D     ; #REGbc=#R$5E2D (the end of the cubby holes).
 $6657 LD A,($5E19)    ; #REGa=#R$5E19.
 $665A AND %00000111   ; Keep only bits 0-2.
 $665C LD E,A          ; #REGe=the random offset.
 $665D LD D,$00        ; Clear the high byte of the offset in #REGd.
 $665F ADD HL,DE       ; Add the random offset to #REGhl.
@label=ExplosionCubbyHole_Loop
*$6660 LD A,(HL)       ; #REGa=the cubby hole.
 $6661 AND A           ; {Jump to #R$6671 if the hole is empty.
 $6662 JR Z,$6671      ; }
 $6664 INC HL          ; Move on to the next hole.
 $6665 PUSH HL         ; Stash #REGhl on the stack.
 $6666 AND A           ; {Compare #REGhl with the end of the cubby holes.
 $6667 SBC HL,BC       ; }
 $6669 POP HL          ; Restore #REGhl from the stack.
 $666A JR NZ,$6660     ; Jump back to #R$6660 if the end has not been reached.
 $666C LD HL,$5E23     ; #REGhl=#R$5E23 (wrap round to the first hole).
 $666F JR $6660        ; Jump to #R$6660.
@label=ExplosionCubbyHole_Found
*$6671 LD A,($5E77)    ; #REGa=the colour of the spray can from #R$5E77.
 $6674 AND %00000111   ; Keep only bits 0-2.
 $6676 OR %00001000    ; Set bit 3 (the type of the item is a spray can).
 $6678 LD (HL),A       ; Write the item to the cubby hole.
 $6679 JP $60AA        ; Jump to #R$60AA.
; Erase the explosion.
@label=AnimateExplosion_Erase
*$667C CALL $74AB      ; Call #R$74AB.
 $667F JP $7529        ; Jump to #R$7529.

; Explosion Sprite Table
;
; The sprite for each frame of an explosion. The addresses are
; repeated because on first use the sprites are drawn in a bright colour
; as the explosion grows, and then are erased in the same order, so as to
; make the explosion disappear.
@label=ExplosionLookupTable
w$6682 DEFW $7ECA    ; Frame 0: small explosion.
 $6684 DEFW $7EFD    ; Frame 1: medium explosion.
 $6686 DEFW $7F30    ; Frame 2: large explosion.
 $6688 DEFW $7ECA    ; Frame 3: small explosion (erase).
 $668A DEFW $7EFD    ; Frame 4: medium explosion (erase).
 $668C DEFW $7F30    ; Frame 5: large explosion (erase).

; Start Flower Bloom
;
; Used by the routine at #R$6D0C.
; .
; The flower has grown to the top of the play area. This turns the
; flower into a blooming flower, then removes every other object
; (Robbie, the spray can, the weapons, the leaves, the bugs and the
; explosion).
;
; IX Flower object
@label=StartFlowerBloom
c$668E LD (IX+$00),$13 ; Write #N$13 (the flower in bloom) to #REGix+#N$00.
 $6692 LD (IX+$04),$00 ; Write #N$00 to #REGix+#N$04 (the first stage of
                       ; blooming).
 $6696 LD B,$04        ; Set the object counter to #N$04.
 $6698 LD HL,$5E6C     ; #REGhl=#R$5E6C (Robbie, the spray can and the
                       ; weapons).
 $669B CALL $70D6      ; Set the objects inactive using #R$70D6.
 $669E LD B,$0B        ; Set the object counter to #N$0B.
 $66A0 LD HL,$5E94     ; #REGhl=#R$5E94 (the leaves, the bugs and the
                       ; explosion).
 $66A3 JP $70D6        ; Jump to #R$70D6 to set the objects inactive (which returns to the
                       ; caller).

; Update Blooming Flower
;
; Opens the flower once the "get ready" delay has finished. Every eighth
; update the flower moves on to the next stage, using the sprite for the
; stage from #R$6787. At stage #N$04 the flower is coloured in using
; #R$670E, and at stage #N$05 the level is complete (#R$66D7).
; #PUSHS #UDGTABLE(default,centre,centre,centre,centre,centre)
; { =h Stage #N$00 | =h Stage #N$01 | =h Stage #N$02 | =h Stage #N$03
; | =h Stage #N$04 }
; { #SIM(start=$61CD,stop=$61EA,clear=1,sp=$5D00)
; #POKES$5C37,$3C
; #SIM(start=$6339,stop=$634F,sp=$5D00)
; #POKES$5E22,$00;$5E03,$00;$5D00,$00,$02
; #POKES$5E8C,$13;$5E8E,$6F;$5E90,$00
; #SIM(start=$6D07,stop=$0000,de=$769A,ix=$5E8C,sp=$5D00)
; #SCR$02,$0A,$05,$0B,$0B(bloom-stage-0)
; | #POKES$5E17,$00
; #SIM(start=$66A6,stop=$0000,ix=$5E8C,sp=$5D00)
; #SCR$02,$0A,$05,$0B,$0B(bloom-stage-1)
; | #POKES$5E17,$00
; #SIM(start=$66A6,stop=$0000,ix=$5E8C,sp=$5D00)
; #SCR$02,$0A,$05,$0B,$0B(bloom-stage-2)
; | #POKES$5E17,$00
; #SIM(start=$66A6,stop=$0000,ix=$5E8C,sp=$5D00)
; #SCR$02,$0A,$05,$0B,$0B(bloom-stage-3)
; | #POKES$5E17,$00
; #SIM(start=$66A6,stop=$0000,ix=$5E8C,sp=$5D00)
; #SCR$02,$0A,$05,$0B,$0B(bloom-stage-4) } UDGTABLE# #POPS
;
; IX Flower object
@label=UpdateBloomingFlower
c$66A6 CALL $75B9    ; Remember the position and state using #R$75B9.
 $66A9 LD A,($5E22)  ; {Return if the "get ready" delay in #R$5E22 is not
 $66AC AND A         ; finished.
 $66AD JR NZ,$66D6   ; }
 $66AF LD A,($5E17)  ; #REGa=the game timer from #R$5E17.
 $66B2 AND %00000111 ; Keep only bits 0-2
                     ; (so that the flower only changes stage every eighth update).
 $66B4 JR NZ,$66D6   ; Return if it is not time for the next stage.
 $66B6 CALL $6791    ; Get the sprite for the current stage using #R$6791.
 $66B9 CALL $74A8    ; Set up the previous sprite using #R$74A8.
 $66BC EXX           ; Switch to the shadow registers.
 $66BD INC (IX+$04)  ; Increment the stage in #REGix+#N$04 by one.
 $66C0 LD A,(IX+$04) ; #REGa=the stage.
 $66C3 CP $04        ; Compare the stage with #N$04 (the open flower).
 $66C5 CALL Z,$670E  ; Call #R$670E if this is stage #N$04 to colour the flower
                     ; in.
 $66C8 CP $05        ; {Jump to #R$66D7 if the stage is #N$05 (note that #REGa has been
 $66CA JR Z,$66D7    ; overwritten if the flower was just coloured).}
 $66CC CALL $6791    ; Get the sprite for the new stage using #R$6791.
 $66CF CALL $74C0    ; Set up the new sprite using #R$74C0.
 $66D2 EXX           ; Switch to the shadow registers.
 $66D3 CALL $74F2    ; Draw the new sprite and erase the previous one using
                     ; #R$74F2.
@label=UpdateBloomingFlower_Return
*$66D6 RET           ; Return.

; Complete Level
;
; Used by the routine at #R$66A6.
; .
; Clears all of the objects from the play area, plays a tune (unless the
; tunes are switched off, when there is a pause instead) and then starts the
; next level using #R$5F80.
; .
; Every fourth level (the fifth, the ninth and so on) earns an extra life
; and the longer tune at #R$641D, and the other levels just play the
; jingle at #R$642D.
@label=LevelComplete
c$66D7 LD HL,$5E6C   ; #REGhl=#R$5E6C (Robbie).
 $66DA LD B,$10      ; Set the object counter to #N$10.
 $66DC CALL $70D6    ; Set all of the objects inactive using #R$70D6.
 $66DF LD A,($5E04)  ; {Jump to #R$6705 if the tunes are switched off (#R$5E04 is not
 $66E2 AND A         ; zero).
 $66E3 JR NZ,$6705   ; }
 $66E5 LD A,($5E37)  ; {Jump to #R$6700 if this is the first level (#R$5E37 is
 $66E8 AND A         ; zero).
 $66E9 JR Z,$6700    ; }
 $66EB AND $03       ; {Jump to #R$6700 if the level is not a multiple of four.
 $66ED JR NZ,$6700   ; }
 $66EF LD DE,$641D   ; #REGde=#R$641D.
 $66F2 LD HL,$5E38   ; #REGhl=#R$5E38 (the lives of the active player).
 $66F5 INC (HL)      ; Give the player an extra life.
@label=LevelComplete_PlayTune
*$66F6 CALL $63E1    ; Play the tune using #R$63E1.
@label=LevelComplete_NextLevel
*$66F9 LD HL,$5E37   ; #REGhl=#R$5E37 (the level of the active player).
 $66FC INC (HL)      ; Increment the level by one.
 $66FD JP $5F80      ; Jump to #R$5F80.
@label=LevelComplete_Jingle
*$6700 LD DE,$642D   ; #REGde=#R$642D.
 $6703 JR $66F6      ; Jump to #R$66F6.
@label=LevelComplete_Pause
*$6705 DI            ; Disable interrupts.
 $6706 LD B,$0A      ; Set the number of countdowns to #N$0A.
 $6708 CALL $6110    ; Pause using #R$6110.
 $670B EI            ; Enable interrupts.
 $670C JR $66F9      ; Jump to #R$66F9.

; Colour Open Flower
;
; Used by the routine at #R$66A6.
; .
; Writes the attributes of the open flower into the attribute buffer,
; using the table at #R$6748, which is nine cells wide and seven cells high.
; The colour of the centre of the flower changes from yellow to magenta,
; unless the level is a multiple of four (and not the first level), which
; are the levels that award an extra life.
;
; IX Flower object
@label=ColouriseFlower
c$670E LD A,(IX+$01) ; {#REGl=the X position of the flower - #N$20.
 $6711 SUB $20       ;
 $6713 LD L,A        ; }
 $6714 LD A,(IX+$02) ; {#REGh=the Y position of the flower - #N$30.
 $6717 SUB $30       ;
 $6719 LD H,A        ; }
 $671A CALL $748F    ; Convert the position to an attribute buffer address
                     ; using #R$748F.
 $671D LD DE,$6748   ; #REGde=#R$6748.
 $6720 LD BC,$0907   ; #REGb=#N$09 (the number of columns) and #REGc=#N$07
                     ; (the number of rows).
@label=ColouriseFlower_Row
*$6723 PUSH BC       ; Stash the column and row counters on the stack.
 $6724 PUSH HL       ; Stash the attribute address on the stack.
@label=ColouriseFlower_Column
*$6725 LD A,($5E37)  ; {Jump to #R$673F if this is the first level (#R$5E37 is
 $6728 AND A         ; zero).
 $6729 JR Z,$673F    ; }
 $672B AND $03       ; {Jump to #R$673F if the level is not a multiple of four.
 $672D JR NZ,$673F   ; }
@label=ColouriseFlower_Write
 $672F LD A,(DE)     ; #REGa=the attribute from the table.
@label=ColouriseFlower_Store
*$6730 LD (HL),A     ; Write it to the attribute buffer.
 $6731 INC HL        ; Move onto the next attribute buffer cell.
 $6732 INC DE        ; Move onto the next attribute in the table.
 $6733 DJNZ $6725    ; Decrease the column counter by one and loop back to #R$6725 until
                     ; the row has been coloured.
 $6735 POP HL        ; Restore the attribute address from the stack.
 $6736 LD BC,$0020   ; #REGbc=#N$0020 (the size of a row).
 $6739 ADD HL,BC     ; Move down one row.
 $673A POP BC        ; Restore the column and row counters from the stack.
 $673B DEC C         ; Decrease the row counter by one.
 $673C JR NZ,$6723   ; Loop back to #R$6723 until all of the rows have been
                     ; coloured.
 $673E RET           ; Return.
; For any other level, the yellow in the centre of the flower is replaced.
@label=ColouriseFlower_Replace
*$673F LD A,(DE)     ; #REGa=the attribute from the table.
 $6740 CP $5E        ; {Jump to #R$6730 if it is not #N$5E (yellow on magenta).
 $6742 JR NZ,$6730   ; }
 $6744 LD A,$5B      ; #REGa=#N$5B (magenta on magenta).
 $6746 JR $6730      ; Jump to #R$6730.

; Flower Attributes
;
; The attributes of the open flower, nine cells wide and seven cells
; high.
@label=FlowerAttributes
b$6748 DEFB $44,$44,$44,$44,$44,$44,$44,$44,$44
 $6751 DEFB $44,$63,$63,$5E,$5E,$5E,$63,$63,$44
 $675A DEFB $44,$63,$63,$5E,$5E,$5E,$63,$63,$44
 $6763 DEFB $44,$63,$5E,$5E,$5E,$5E,$5E,$63,$44
 $676C DEFB $44,$63,$63,$63,$5E,$5E,$63,$63,$44
 $6775 DEFB $44,$44,$44,$44,$44,$44,$44,$44,$44
 $677E DEFB $44,$44,$44,$44,$44,$44,$44,$44,$44

; Flower Sprite Table
;
; The sprite for each stage of the flower: stages #N$00 to #N$04.
@label=FlowerSpriteTable
w$6787 DEFW $769A
 $6789 DEFW $7C39
 $678B DEFW $7C72
 $678D DEFW $7C72
 $678F DEFW $7CCF

; Get Flower Sprite
;
; Used by the routine at #R$66A6.
; .
; Looks up the sprite for the stage of the flower.
;
;   IX Flower object
; O:DE Sprite data
@label=GetFlowerSprite
c$6791 LD A,(IX+$04) ; #REGa=the stage from #REGix+#N$04.
 $6794 SLA A         ; Double the stage to make an offset into the table.
 $6796 LD HL,$6787   ; #REGhl=#R$6787.
 $6799 JP $6CD9      ; Jump to #R$6CD9 to read the address from the table.

; Start Eating Flower
;
; Used by the routines at #R$64FA, #R$67AE and #R$6A98.
; .
; A bug has reached the flower and starts eating it. The flag in bit 3
; of #REGix+#N$04 marks that the bug is eating, #REGix+#N$05 is set to a
; random number and #REGix+#N$06 remembers the Y position of the bug (see
; #R$6B3A).
;
; IX Bug object
@label=StartEatingFlower
c$679C LD A,R         ; #REGa=the refresh register (a random number).
 $679E LD (IX+$05),A  ; Write it to #REGix+#N$05.
 $67A1 LD A,(IX+$02)  ; #REGa=the Y position of the bug.
 $67A4 LD (IX+$06),A  ; Write it to #REGix+#N$06.
 $67A7 SET 3,(IX+$04) ; Set bit 3 of #REGix+#N$04 (eating the flower).
 $67AB JP $6F31       ; Jump to #R$6F31 to draw the bug.

; Update Midges
;
; Updates a swarm of midges. If the midges touch Robbie then both
; explode. A repellent spray kills them (worth #N$50 points), a smoke bomb
; stuns them, and a streamer has no effect. When they reach the flower they
; start to eat it.
; .
; Otherwise they fly towards a target (Robbie, or the flower if that is
; closer) and use a speed and a direction in each axis, so that they speed
; up when flying towards the target and slow down, stop and turn round when
; flying away from it. #REGix+#N$05 holds the horizontal motion and
; #REGix+#N$06 holds the vertical motion. In each of them the low nibble is
; the speed (#N$00 to #N$0F) and the high nibble is the fraction of a pixel
; left over from the last move (see #R$68DD).
;
; IX Midges object
;
; The object fields used are:
; #TABLE(default,centre)
; { =h Field | =h Use }
; { +0 bit 6 | Moving left (the midges move right if this is not set) }
; { +0 bit 7 | Moving down (the midges move up if this is not set) }
; { +4 bit 2 | Stunned }
; { +4 bit 3 | Eating the flower }
; { +5 | Horizontal motion (or the stun timer while stunned) }
; { +6 | Vertical motion }
; TABLE#
@label=UpdateMidges
c$67AE CALL $64ED     ; Do the common bug checks using #R$64ED.
 $67B1 DEC E          ; Decrease the collision result in #REGe by one
                      ; (zero means that the midges are touching Robbie).
 $67B2 JP Z,$6A73     ; Jump to #R$6A73 if the midges are touching Robbie.
 $67B5 CALL $6A42     ; Call #R$6A42 to check whether a weapon has hit the
                      ; midges.
 $67B8 DEC E          ; Decrease the collision result in #REGe by one
                      ; (zero means that a weapon has hit the midges).
 $67B9 JR NZ,$67C0    ; Jump to #R$67C0 if there was no hit.
 $67BB LD A,C         ; {#REGa=the state of the weapon, and jump to #R$68ED if the weapon
 $67BC AND A          ; is active.
 $67BD JP NZ,$68ED    ; }
; This entry point is used by the routine at #R$68ED.
@label=UpdateMidges_NoWeaponHit
*$67C0 BIT 3,(IX+$04) ; {Jump to #R$6B3A if the midges are eating the flower.
 $67C4 JP NZ,$6B3A    ; }
 $67C7 CALL $644D     ; Check whether the midges have reached the flower using
                      ; #R$644D.
 $67CA DEC E          ; Decrease the collision result in #REGe by one
                      ; (zero means that the midges have reached the flower).
 $67CB JR Z,$679C     ; Jump to #R$679C if the midges have reached the flower, to start
                      ; eating it.
; Are the midges stunned?
 $67CD BIT 2,(IX+$04) ; {Jump to #R$67DD if the midges are not stunned.
 $67D1 JR Z,$67DD     ; }
 $67D3 DEC (IX+$05)   ; Decrease the stun timer in #REGix+#N$05 by one.
 $67D6 JP NZ,$6F31    ; Jump to #R$6F31 if the midges are still stunned, to draw them
                      ; without moving.
 $67D9 RES 2,(IX+$04) ; Reset bit 2 of #REGix+#N$04 (the stun has ended).
; Horizontal movement. Find the target and see which side of it the
; midges are on.
@label=UpdateMidges_Horizontal
*$67DD CALL $690F     ; Find the target using #R$690F, returning #REGhl pointing to the X
                      ; position of the target.
 $67E0 LD A,(IX+$05)  ; {#REGb=the horizontal motion from #REGix+#N$05.
 $67E3 LD B,A         ; }
 $67E4 AND $0F        ; {#REGc=the speed (the low nibble).
 $67E6 LD C,A         ; }
 $67E7 LD A,B         ; {#REGb=the fraction (the high nibble).
 $67E8 AND $F0        ;
 $67EA LD B,A         ; }
 $67EB LD A,(HL)      ; #REGa=the X position of the target.
 $67EC SUB (IX+$01)   ; Subtract the X position of the midges.
 $67EF JP P,$686E     ; Jump to #R$686E if the target is to the right.
 $67F2 BIT 6,(IX+$00) ; {Jump to #R$689A if the midges are moving right.
 $67F6 JP Z,$689A     ; }
; The target is to the left and the midges are moving left, so speed
; up (to a maximum of #N$0F) and move left.
@label=UpdateMidges_AccelerateLeft
 $67F9 LD A,C         ; #REGa=the speed.
 $67FA CP $0F         ; {Increase the speed by one, up to a maximum of #N$0F.
 $67FC JR NC,$67FF    ;
 $67FE INC A          ; }
@label=UpdateMidges_MoveLeft
*$67FF LD C,A         ; #REGc=the new speed.
 $6800 LD H,(IX+$01)  ; #REGh=the X position of the midges.
 $6803 CALL $68DD     ; Work out the distance to move using #R$68DD.
 $6806 AND A          ; {Subtract the distance from the position.
 $6807 SBC HL,DE      ; }
 $6809 LD A,H         ; #REGa=the new X position.
 $680A CP $1A         ; {Jump to #R$6812 if the midges have not reached the
 $680C JR NC,$6812    ; left edge.}
 $680E RES 6,(IX+$00) ; Reset bit 6 of #REGix+#N$00 (turn the midges round to
                      ; move right).
@label=UpdateMidges_StoreX
*$6812 LD (IX+$01),A  ; Write the new X position.
 $6815 LD A,L         ; {#REGa=the fraction (the high nibble of #REGl).
 $6816 AND $F0        ; }
 $6818 OR C           ; Add the speed.
 $6819 LD (IX+$05),A  ; Write the horizontal motion to #REGix+#N$05.
 $681C LD A,(IX+$01)  ; #REGa=the X position of the midges.
 $681F CP $18         ; {Jump to #R$6F31 to draw the midges without moving vertically if
 $6821 JP C,$6F31     ; they are too far to the left.}
 $6824 CP $D0         ; {Jump to #R$6F31 to draw the midges without moving vertically if
 $6826 JP NC,$6F31    ; they are too far to the right.}
; Vertical movement works in the same way, with the target being above
; or below the midges.
@label=UpdateMidges_Vertical
 $6829 CALL $690F     ; Find the target using #R$690F.
 $682C LD A,(IX+$06)  ; {#REGb=the vertical motion from #REGix+#N$06.
 $682F LD B,A         ; }
 $6830 AND $0F        ; {#REGc=the speed (the low nibble).
 $6832 LD C,A         ; }
 $6833 LD A,B         ; {#REGb=the fraction (the high nibble).
 $6834 AND $F0        ;
 $6836 LD B,A         ; }
 $6837 INC HL         ; Move #REGhl onto the Y position of the target.
 $6838 LD A,(HL)      ; #REGa=the Y position of the target.
 $6839 SUB (IX+$02)   ; Subtract the Y position of the midges.
 $683C JP P,$68A6     ; Jump to #R$68A6 if the target is below.
 $683F BIT 7,(IX+$00) ; {Jump to #R$68D3 if the midges are moving up.
 $6843 JP Z,$68D3     ; }
 $6846 LD A,C         ; #REGa=the speed.
 $6847 DEC A          ; Decrease the speed by one.
 $6848 JR NZ,$68B3    ; Jump to #R$68B3 if the midges have not stopped.
 $684A RES 7,(IX+$00) ; Reset bit 7 of #REGix+#N$00 (turn the midges to move
                      ; up).
@label=UpdateMidges_MoveUp
*$684E LD C,A         ; #REGc=the new speed.
 $684F LD H,(IX+$02)  ; #REGh=the Y position of the midges.
 $6852 CALL $68DD     ; Work out the distance to move using #R$68DD.
 $6855 AND A          ; {Subtract the distance from the position.
 $6856 SBC HL,DE      ; }
 $6858 LD A,H         ; #REGa=the new Y position.
 $6859 CP $28         ; {Jump to #R$6861 if the midges have not reached the
 $685B JR NC,$6861    ; top.}
 $685D SET 7,(IX+$00) ; Set bit 7 of #REGix+#N$00 (turn the midges to move
                      ; down).
@label=UpdateMidges_StoreY
*$6861 LD (IX+$02),A  ; Write the new Y position.
 $6864 LD A,L         ; {#REGa=the fraction (the high nibble of #REGl).
 $6865 AND $F0        ; }
 $6867 OR C           ; Add the speed.
 $6868 LD (IX+$06),A  ; Write the vertical motion to #REGix+#N$06.
 $686B JP $6F31       ; Jump to #R$6F31 to draw the midges.
; The target is to the right.
@label=UpdateMidges_TargetRight
*$686E BIT 6,(IX+$00) ; {Jump to #R$6892 if the midges are moving right.
 $6872 JR Z,$6892     ; }
 $6874 LD A,C         ; {The midges are moving left, so slow down: #REGa=the
 $6875 DEC A          ; speed - #N$01.}
 $6876 JP NZ,$67FF    ; Jump to #R$67FF if the speed is not zero.
 $6879 RES 6,(IX+$00) ; Reset bit 6 of #REGix+#N$00 (turn the midges to move
                      ; right).
@label=UpdateMidges_MoveRight
*$687D LD C,A         ; #REGc=the new speed.
 $687E LD H,(IX+$01)  ; #REGh=the X position of the midges.
 $6881 CALL $68DD     ; Work out the distance to move using #R$68DD.
 $6884 ADD HL,DE      ; Add the distance to the position.
 $6885 LD A,H         ; #REGa=the new X position.
 $6886 CP $D6         ; {Jump to #R$6812 if the midges have not reached the
 $6888 JP C,$6812     ; right edge.}
 $688B SET 6,(IX+$00) ; Set bit 6 of #REGix+#N$00 (turn the midges round to
                      ; move left).
 $688F JP $6812       ; Jump to #R$6812.
; The target is to the right and the midges are moving right, so speed up.
@label=UpdateMidges_AccelerateRight
*$6892 LD A,C         ; #REGa=the speed.
 $6893 CP $0F         ; {Jump to #R$687D if the speed is already at the maximum
 $6895 JR NC,$687D    ; (#N$0F).}
 $6897 INC A          ; Increase the speed by one.
 $6898 JR $687D       ; Jump to #R$687D.
; The target is to the left but the midges are moving right, so slow
; down and turn round when they have stopped.
@label=UpdateMidges_TargetLeft
*$689A LD A,C         ; {#REGa=the speed - #N$01.
 $689B DEC A          ; }
 $689C JP NZ,$687D    ; Jump to #R$687D if the speed is not zero.
 $689F SET 6,(IX+$00) ; Set bit 6 of #REGix+#N$00 (turn the midges to move
                      ; left).
 $68A3 JP $67FF       ; Jump to #R$67FF.
; The target is below the midges.
@label=UpdateMidges_TargetBelow
*$68A6 BIT 7,(IX+$00) ; {Jump to #R$68C8 if the midges are moving up.
 $68AA JR Z,$68C8     ; }
 $68AC LD A,C         ; #REGa=the speed.
 $68AD CP $0F         ; {Jump to #R$68B3 if the speed is already at the maximum
 $68AF JP NC,$68B3    ; (#N$0F).}
 $68B2 INC A          ; Increase the speed by one.
@label=UpdateMidges_MoveDown
*$68B3 LD C,A         ; #REGc=the new speed.
 $68B4 LD H,(IX+$02)  ; #REGh=the Y position of the midges.
 $68B7 CALL $68DD     ; Work out the distance to move using #R$68DD.
 $68BA ADD HL,DE      ; Add the distance to the position.
 $68BB LD A,H         ; #REGa=the new Y position.
 $68BC CP $B6         ; {Jump to #R$6861 if the midges have not reached the
 $68BE JP C,$6861     ; bottom.}
 $68C1 RES 7,(IX+$00) ; Reset bit 7 of #REGix+#N$00 (turn the midges to move
                      ; up).
 $68C5 JP $6861       ; Jump to #R$6861.
; The target is below the midges but they are moving up, so slow down and
; turn round when they have stopped.
@label=UpdateMidges_TargetBelowMovingUp
*$68C8 LD A,C         ; {#REGa=the speed - #N$01.
 $68C9 DEC A          ; }
 $68CA JP NZ,$684E    ; Jump to #R$684E if the speed is not zero.
 $68CD SET 7,(IX+$00) ; Set bit 7 of #REGix+#N$00 (turn the midges to move
                      ; down).
 $68D1 JR $68B3       ; Jump to #R$68B3.
; The target is above the midges and they are moving up, so speed up.
@label=UpdateMidges_AccelerateUp
*$68D3 LD A,C         ; #REGa=the speed.
 $68D4 CP $0F         ; {Jump to #R$684E if the speed is already at the maximum
 $68D6 JP NC,$684E    ; (#N$0F).}
 $68D9 INC A          ; Increase the speed by one.
 $68DA JP $684E       ; Jump to #R$684E.

; Calculate Midges Movement
;
; Used by the routine at #R$67AE.
; .
; Prepares for the movement of the midges along one axis: a 16-bit
; value which has the position in #REGh and the fraction of a pixel in
; #REGl, and a distance to move which is #N$20 times the speed (so the
; distance is up to #N$01E0 which is just under two pixels).
;
;   B The fraction of a pixel (in the high nibble)
;   C The speed
;   H The position
; O:DE The distance to move
; O:HL The position and the fraction
@label=CalculateMidgesMovement
c$68DD LD L,B        ; #REGl=the fraction.
 $68DE LD A,C        ; {Multiply the speed by sixteen.
 $68DF RLA           ;
 $68E0 RLA           ;
 $68E1 RLA           ;
 $68E2 RLA           ;
 $68E3 AND $F0       ; }
 $68E5 LD E,A        ; #REGe=the speed multiplied by sixteen.
 $68E6 LD D,$00      ; Clear the high byte of the distance in #REGd.
 $68E8 SLA E         ; {Double #REGde.
 $68EA RL D          ; }
 $68EC RET           ; Return.

; Handle Midges Weapon Hit
;
; Used by the routine at #R$67AE.
; .
; A weapon has hit the midges. The repellent spray kills them, a
; streamer has no effect and a smoke bomb stuns them (and stops them dead).
;
; A State of the weapon
; IX Midges object
@label=MidgesWeaponHit
c$68ED AND %00111111   ; Keep only bits 0-5 (the type of the weapon).
 $68EF CP $08          ; {Jump to #R$6909 if it is the repellent spray.
 $68F1 JR Z,$6909      ; }
 $68F3 CP $12          ; {Jump to #R$67C0 if it is a streamer.
 $68F5 JP Z,$67C0      ; }
 $68F8 BIT 3,(IX+$04)  ; {Jump to #R$6B3A if the midges are eating the flower.
 $68FC JP NZ,$6B3A     ; }
 $68FF LD (IX+$06),$00 ; Write #N$00 to #REGix+#N$06 (stop the vertical
                       ; movement).
 $6903 CALL $65CB      ; Stun the midges using #R$65CB.
 $6906 JP $67C0        ; Jump to #R$67C0.
@label=MidgesWeaponHit_Kill
*$6909 LD BC,$0050     ; #REGbc=#N$0050 (the points for the kill).
 $690C JP $65D9        ; Add the points to the score and explode the midges
                       ; using #R$65D9.

; Find Bug Target
;
; Used by the routine at #R$67AE.
; .
; Finds the object that the midges are chasing. This is Robbie, unless
; he is too close to either edge of the play area or the flower is nearer. The
; distances are measured as the sum of the horizontal and vertical distances
; at half resolution.
;
;   IX Midges object
; O:HL Address of the X position of the target (Robbie or the flower)
@label=FindBugTarget
c$690F LD A,($5E6D)  ; #REGa=the X position of Robbie.
 $6912 CP $18        ; {Jump to #R$6967 to use the flower if Robbie is too far to the
 $6914 JR C,$6967    ; left.}
 $6916 CP $D8        ; {Jump to #R$6967 to use the flower if Robbie is too far to the
 $6918 JR NC,$6967   ; right.}
; Distance from the midges to Robbie.
 $691A SRL A         ; {#REGb=the X position of Robbie / #N$02.
 $691C LD B,A        ; }
 $691D LD A,(IX+$01) ; {#REGa=the X position of the midges / #N$02.
 $6920 SRL A         ; }
 $6922 SUB B         ; Subtract the X position of Robbie.
 $6923 JP P,$6928    ; {Make sure we have a positive byte.
 $6926 NEG           ; }
@label=FindBugTarget_Robbie_X
*$6928 LD B,A        ; #REGb=the horizontal distance.
 $6929 LD A,($5E6E)  ; #REGa=the Y position of Robbie.
 $692C SRL A         ; {#REGc=the Y position of Robbie / #N$02.
 $692E LD C,A        ; }
 $692F LD A,(IX+$02) ; {#REGa=the Y position of the midges / #N$02.
 $6932 SRL A         ; }
 $6934 SUB C         ; Subtract the Y position of Robbie.
 $6935 JP P,$693A    ; {Make sure we have a positive byte.
 $6938 NEG           ; }
@label=FindBugTarget_Robbie_Y
*$693A ADD A,B       ; Add the horizontal distance to get the distance to
                     ; Robbie.
 $693B LD D,A        ; #REGd=the distance to Robbie.
; Distance from the midges to the flower.
 $693C LD A,($5E8D)  ; #REGa=the X position of the flower.
 $693F SRL A         ; {#REGb=the X position of the flower / #N$02.
 $6941 LD B,A        ; }
 $6942 LD A,(IX+$01) ; {#REGa=the X position of the midges / #N$02.
 $6945 SRL A         ; }
 $6947 SUB B         ; Subtract the X position of the flower.
 $6948 JP P,$694D    ; {Make sure we have a positive byte.
 $694B NEG           ; }
@label=FindBugTarget_Flower_X
*$694D LD B,A        ; #REGb=the horizontal distance.
 $694E LD A,($5E8E)  ; #REGa=the Y position of the flower.
 $6951 SRL A         ; {#REGc=the Y position of the flower / #N$02.
 $6953 LD C,A        ; }
 $6954 LD A,(IX+$02) ; {#REGa=the Y position of the midges / #N$02.
 $6957 SRL A         ; }
 $6959 SUB C         ; Subtract the Y position of the flower.
 $695A JP P,$695F    ; {Make sure we have a positive byte.
 $695D NEG           ; }
@label=FindBugTarget_Flower_Y
*$695F ADD A,B       ; Add the horizontal distance to get the distance to the
                     ; flower.
 $6960 CP D          ; Compare the distance to the flower with the distance to
                     ; Robbie.
 $6961 JR C,$6967    ; Jump to #R$6967 if the flower is nearer.
 $6963 LD HL,$5E6D   ; #REGhl=#R$5E6D (Robbie).
 $6966 RET           ; Return.
@label=FindBugTarget_Flower
*$6967 LD HL,$5E8D   ; #REGhl=#R$5E8D (the flower).
 $696A RET           ; Return.

; Get Robbie Direction
;
; Used by the routines at #R$6974, #R$69BB and #R$6B70.
; .
; Used when a weapon is fired. This gets the X position of Robbie and
; tests bit 0 of #R$5E70, which decides the direction of the weapon: the
; weapon is fired to the right when the bit is clear.
;
;   DE #R$5E6F (the colour of Robbie)
; O:A The X position of Robbie
; O:DE #R$5E6D (the X position of Robbie)
; O:F The zero flag is set if the weapon goes to the right
@label=GetRobbieDirection
c$696B INC DE        ; Move #REGde onto #R$5E70.
 $696C LD A,(DE)     ; #REGa=the direction byte of Robbie.
 $696D DEC DE        ; {Move #REGde back onto the X position of Robbie.
 $696E DEC DE        ;
 $696F DEC DE        ; }
 $6970 AND %00000001 ; Keep only bit 0.
 $6972 LD A,(DE)     ; #REGa=the X position of Robbie.
 $6973 RET           ; Return.

; Fire Repellent Spray
;
; Used by the routine at #R$6B70.
; .
; Starts a repellent spray in the weapon slot held in #R$5E1C, in front
; of Robbie. It is not fired if Robbie is too close to the edge of the play
; area.
;
; DE #R$5E6F (the colour of Robbie)
; HL The weapon object
@label=FireRepellentSpray
c$6974 CALL $696B    ; Get the X position and the direction using #R$696B.
 $6977 JR Z,$6985    ; Jump to #R$6985 if the spray goes to the right.
 $6979 CP $30        ; {Return if Robbie is too close to the left edge.
 $697B RET C         ; }
 $697C SUB $0C       ; Subtract #N$0C from the X position (so it starts to the left of
                     ; Robbie).
 $697E LD (HL),$48   ; Write #N$48 (a repellent spray moving left) to the state of the
                     ; weapon.
@label=FireRepellentSpray_Colour
*$6980 LD B,$45      ; #REGb=#N$45 (the colour of the spray).
 $6982 JP $6BA5      ; Jump to #R$6BA5 to create the weapon.
@label=FireRepellentSpray_Right
*$6985 CP $C0        ; {Return if Robbie is too close to the right edge.
 $6987 RET NC        ; }
 $6988 ADD A,$18     ; Add #N$18 to the X position (so it starts to the right
                     ; of Robbie).
 $698A LD (HL),$08   ; Write #N$08 (a repellent spray moving right) to the state of the
                     ; weapon.
 $698C JP $6980      ; Jump to #R$6980.

; Update Repellent Spray
;
; Moves a repellent spray #N$04 pixels at a time in the direction it was
; fired. The spray is removed if it hits a bug (see #R$6A42) or reaches the
; edge of the play area.
;
; IX Repellent spray object
@label=UpdateRepellentSpray
c$698F CALL $75B9     ; Remember the position and state using #R$75B9.
 $6992 LD A,(IX+$05)  ; {Jump to #R$69B3 to remove the spray if it has hit a
 $6995 AND A          ; bug.
 $6996 JR NZ,$69B3    ; }
 $6998 LD A,$04       ; #REGa=#N$04 (the distance to move).
 $699A BIT 6,(IX+$00) ; {Jump to #R$69A2 if the spray is moving right (bit 6 is
 $699E JR Z,$69A2     ; not set).}
 $69A0 NEG            ; Negate the distance (move left).
@label=UpdateRepellentSpray_Move
*$69A2 ADD A,(IX+$01) ; Add the X position of the spray.
 $69A5 CP $18         ; {Jump to #R$69B3 to remove the spray if it is past the
 $69A7 JR C,$69B3     ; left edge.}
 $69A9 CP $E0         ; {Jump to #R$69B3 to remove the spray if it is past the
 $69AB JR NC,$69B3    ; right edge.}
 $69AD LD (IX+$01),A  ; Write the new X position.
 $69B0 JP $6F31       ; Jump to #R$6F31 to draw the spray.

; Remove Weapon
;
; Used by the routines at #R$698F and #R$6BD0.
; .
; Erases a weapon and makes the object inactive.
;
; IX Weapon object
@label=RemoveWeapon
c$69B3 CALL $7526      ; Erase the previous sprite using #R$7526.
 $69B6 LD (IX+$00),$00 ; Write #N$00 to #REGix+#N$00 (the object is inactive).
 $69BA RET             ; Return.

; Fire Streamer
;
; Used by the routine at #R$6B70.
; .
; Starts a streamer in the weapon slot held in #R$5E1C, in front of
; Robbie. It is not fired if Robbie is too close to the edge of the play
; area. The colour of the streamer is chosen at random.
;
; DE #R$5E6F (the colour of Robbie)
; HL The weapon object
@label=FireStreamer
c$69BB CALL $696B    ; Get the X position and the direction using #R$696B.
 $69BE JR Z,$69DF    ; Jump to #R$69DF if the streamer goes to the right.
 $69C0 CP $38        ; {Return if Robbie is too close to the left edge.
 $69C2 RET C         ; }
 $69C3 SUB $0C       ; Subtract #N$0C from the X position (so it starts to the left of
                     ; Robbie).
 $69C5 LD (HL),$52   ; Write #N$52 (a streamer moving left) to the state of the
                     ; weapon.
; This entry point is used by the routine at #R$69DF.
@label=FireStreamer_Colour
*$69C7 PUSH AF       ; Stash the X position on the stack.
 $69C8 PUSH HL       ; Stash the weapon object on the stack.
 $69C9 LD A,($5E19)  ; #REGa=the random number from #R$5E19.
 $69CC AND %00000011 ; Keep only bits 0-1
                     ; (a random colour number from #N$00 to #N$03).
 $69CE LD C,A        ; #REGc=the random colour number.
 $69CF LD B,$00      ; Clear the high byte of the offset in #REGb.
 $69D1 LD HL,$69DB   ; #REGhl=#R$69DB.
 $69D4 ADD HL,BC     ; Add the offset to find the colour in the table.
 $69D5 LD B,(HL)     ; #REGb=the colour of the streamer.
 $69D6 POP HL        ; Restore the weapon object from the stack.
 $69D7 POP AF        ; Restore the X position from the stack.
 $69D8 JP $6BA5      ; Jump to #R$6BA5 to create the weapon.

; Streamer Colours
;
; The colours that a streamer can be.
@label=StreamerColours
b$69DB DEFB $47      ; #COLOUR(#PEEK(#PC)).
 $69DC DEFB $46      ; #COLOUR(#PEEK(#PC)).
 $69DD DEFB $45      ; #COLOUR(#PEEK(#PC)).
 $69DE DEFB $43      ; #COLOUR(#PEEK(#PC)).

; Fire Streamer Right
;
; Used by the routine at #R$69BB.
; .
; Fires a streamer to the right of Robbie, if he is not too close to
; the right edge of the play area.
;
; A The X position of Robbie
; HL The weapon object
@label=FireStreamer_Right
c$69DF CP $B8        ; {Return if Robbie is too close to the right edge.
 $69E1 RET NC        ; }
 $69E2 ADD A,$18     ; Add #N$18 to the X position (so it starts to the right
                     ; of Robbie).
 $69E4 LD (HL),$12   ; Write #N$12 (a streamer moving right) to the state of
                     ; the weapon.
 $69E6 JR $69C7      ; Jump to #R$69C7.

; Update Streamer
;
; Moves a streamer #N$08 pixels at a time in the direction it was
; fired. The streamer alternates between two sprites as it travels, and is
; removed if it hits a bug (see #R$6A42) or reaches the edge of the play
; area.
;
; IX Streamer object
@label=UpdateStreamer
c$69E8 CALL $75B9     ; Remember the position and state using #R$75B9.
 $69EB LD A,(IX+$05)  ; {Jump to #R$6A31 to remove the streamer if it has hit a
 $69EE AND A          ; bug.
 $69EF JR NZ,$6A31    ; }
 $69F1 LD A,$08       ; #REGa=#N$08 (the distance to move).
 $69F3 BIT 6,(IX+$00) ; {Jump to #R$69FB if the streamer is moving right (bit 6 is not
 $69F7 JR Z,$69FB     ; set).}
 $69F9 NEG            ; Negate the distance (move left).
@label=UpdateStreamer_Move
*$69FB ADD A,(IX+$01) ; Add the X position of the streamer.
 $69FE CP $18         ; {Jump to #R$6A31 to remove the streamer if it is past the left
 $6A00 JR C,$6A31     ; edge.}
 $6A02 CP $E0         ; {Jump to #R$6A31 to remove the streamer if it is past the right
 $6A04 JR NC,$6A31    ; edge.}
 $6A06 LD (IX+$01),A  ; Write the new X position.
; Choose the sprite for the new position, using bit 3 of the X position.
 $6A09 AND $08        ; {Jump to #R$6A27 if bit 3 of the X position is not set.
 $6A0B JR Z,$6A27     ; }
 $6A0D LD DE,$7991    ; #REGde=#R$7991 (the first sprite).
@label=UpdateStreamer_Draw
*$6A10 CALL $74C0     ; Set up the new sprite using #R$74C0.
 $6A13 EXX            ; Switch to the shadow registers.
; Choose the sprite for the previous position in the same way.
 $6A14 LD A,($5E0B)   ; #REGa=the previous X position from #R$5E0B.
 $6A17 AND $08        ; {Jump to #R$6A2C if bit 3 of the previous X position is
 $6A19 JR Z,$6A2C     ; not set.}
 $6A1B LD DE,$7991    ; #REGde=#R$7991 (the first sprite).
@label=UpdateStreamer_Previous
*$6A1E CALL $74A8     ; Set up the previous sprite using #R$74A8.
 $6A21 CALL $74F2     ; Erase the previous sprite and draw the new one using
                      ; #R$74F2.
 $6A24 JP $7450       ; Jump to #R$7450 to colour the sprite.
@label=UpdateStreamer_SecondSprite
*$6A27 LD DE,$79A2    ; #REGde=#R$79A2 (the second sprite).
 $6A2A JR $6A10       ; Jump to #R$6A10.
@label=UpdateStreamer_PreviousSecondSprite
*$6A2C LD DE,$79A2    ; #REGde=#R$79A2 (the second sprite).
 $6A2F JR $6A1E       ; Jump to #R$6A1E.

; Remove Streamer
;
; Used by the routine at #R$69E8.
; .
; Erases a streamer, which could be using either of the two sprites, and
; makes the object inactive.
;
; IX Streamer object
@label=RemoveStreamer
c$6A31 LD DE,$7991   ; #REGde=#R$7991 (the first sprite).
 $6A34 CALL $7521    ; Erase the sprite using #R$7521.
 $6A37 LD DE,$79A2   ; #REGde=#R$79A2 (the second sprite).

; Remove Object
;
; Used by the routine at #R$6C53.
; .
; Erases the sprite of an object at its previous position and makes the
; object inactive.
;
; DE Sprite data
; IX Object
@label=RemoveObject
c$6A3A CALL $7521      ; Erase the sprite using #R$7521.
 $6A3D LD (IX+$00),$00 ; Write #N$00 to #REGix+#N$00 (the object is inactive).
 $6A41 RET             ; Return.

; Check Weapon Hit
;
; Used by the routines at #R$64FA, #R$67AE and #R$6A98.
; .
; Checks whether a bug is touching either of the two weapon objects (the
; weapon has to be within #N$0F pixels horizontally and #N$0C pixels
; vertically). If it is, the "hit" flag of the weapon (#REGix+#N$05 of the
; weapon) is set so that the weapon removes itself. This does not check
; whether the weapon is active, so the caller does that using the state
; which is returned in #REGc.
;
;   IX Bug object
; O:C The state of the weapon which was checked
; O:E #N$00 No weapon hit the bug
; O:E #N$01 A weapon hit the bug
@label=CheckWeaponHit
c$6A42 LD HL,$5E7C   ; #REGhl=#R$5E7C (the first weapon object).
 $6A45 LD B,$02      ; Set the weapon counter to #N$02.
@label=CheckWeaponHit_Loop
*$6A47 LD A,(IX+$01) ; #REGa=the X position of the bug.
 $6A4A LD C,(HL)     ; #REGc=the state of the weapon.
 $6A4B INC HL        ; Move onto the X position of the weapon.
 $6A4C SUB (HL)      ; Subtract the X position of the weapon.
 $6A4D JP P,$6A52    ; {Make sure we have a positive byte.
 $6A50 NEG           ; }
@label=CheckWeaponHit_Test_X
*$6A52 CP $10        ; {Jump to #R$6A6B if the weapon is #N$10 pixels or more
 $6A54 JR NC,$6A6B   ; away.}
 $6A56 LD A,(IX+$02) ; #REGa=the Y position of the bug.
 $6A59 INC HL        ; Move onto the Y position of the weapon.
 $6A5A SUB (HL)      ; Subtract the Y position of the weapon.
 $6A5B JP P,$6A60    ; {Make sure we have a positive byte.
 $6A5E NEG           ; }
@label=CheckWeaponHit_Test_Y
*$6A60 CP $0D        ; {Jump to #R$6A6B if the weapon is #N$0D pixels or more
 $6A62 JR NC,$6A6B   ; away.}
 $6A64 INC HL        ; {Move onto the "hit" flag of the weapon.
 $6A65 INC HL        ;
 $6A66 INC HL        ; }
 $6A67 LD E,$01      ; #REGe=#N$01 (a weapon has hit the bug).
 $6A69 LD (HL),E     ; Set the "hit" flag of the weapon.
 $6A6A RET           ; Return.
@label=CheckWeaponHit_Next
*$6A6B LD HL,$5E84   ; #REGhl=#R$5E84 (the second weapon object).
 $6A6E DJNZ $6A47    ; Decrease the weapon counter by one and loop back to #R$6A47 until
                     ; both weapons have been checked.
 $6A70 LD E,$00      ; #REGe=#N$00 (no hit).
 $6A72 RET           ; Return.

; Explode Robbie
;
; Used by the routines at #R$64FA, #R$67AE and #R$6A98.
; .
; A bug has touched Robbie. The bug explodes, and then so does Robbie:
; the position and state of Robbie are copied to the explosion object, and
; Robbie and the spray can are made inactive.
;
; IX Bug object
@label=ExplodeRobbie
c$6A73 CALL $65DC    ; Explode the bug using #R$65DC.
; This entry point is used by the routine at #R$6CF1.
@label=ExplodeRobbie_Flower
*$6A76 PUSH IX       ; Stash #REGix on the stack.
 $6A78 LD IX,$5EE4   ; #REGix=#R$5EE4 (the explosion object).
 $6A7C LD HL,$5E6C   ; {#REGc=the state of Robbie from #R$5E6C.
 $6A7F LD C,(HL)     ; }
 $6A80 INC HL        ; {#REGa=the X position of Robbie.
 $6A81 LD A,(HL)     ; }
 $6A82 LD (IX+$01),A ; Write it to the explosion object.
 $6A85 INC HL        ; {#REGa=the Y position of Robbie.
 $6A86 LD A,(HL)     ; }
 $6A87 LD (IX+$02),A ; Write it to the explosion object.
 $6A8A LD A,C        ; #REGa=the old state of Robbie.
 $6A8B CALL $65F1    ; Start the explosion using #R$65F1.
 $6A8E POP IX        ; Restore #REGix from the stack.
 $6A90 XOR A         ; {Write #N$00 to #R$5E6C and #R$5E74 to make Robbie and the spray
 $6A91 LD ($5E6C),A  ; can inactive.
 $6A94 LD ($5E74),A  ; }
 $6A97 RET           ; Return.

; Update Slug
;
; Updates a slug. If the slug is touching Robbie then both explode. A
; weapon hitting the slug either kills it (a smoke bomb, worth #N$35
; points) or stuns it (a streamer), and the repellent spray has no effect.
; When the slug reaches the flower it starts to eat it.
; .
; Otherwise it crawls around, moving once every four updates: #N$04 pixels
; horizontally, bouncing off the sides of the play area, and #N$01 pixel
; vertically (but only when it is in the middle of the play area).
;
; IX Slug object
;
; The object fields used are:
; #TABLE(default,centre)
; { =h Field | =h Use }
; { +0 bit 6 | Moving right }
; { +0 bit 7 | Moving down }
; { +4 bit 3 | Eating the flower }
; { +5 | Stun timer }
; { +6 | Y position when the slug started eating }
; TABLE#
@label=UpdateSlug
c$6A98 CALL $64ED     ; Do the common bug checks using #R$64ED.
 $6A9B DEC E          ; Decrease the collision result in #REGe by one
                      ; (zero means that the slug is touching Robbie).
 $6A9C JP Z,$6A73     ; Jump to #R$6A73 if the slug is touching Robbie.
 $6A9F CALL $6A42     ; Call #R$6A42 to check whether a weapon has hit the
                      ; slug.
 $6AA2 DEC E          ; Decrease the collision result in #REGe by one
                      ; (zero means that a weapon has hit the slug).
 $6AA3 JR NZ,$6AAA    ; Jump to #R$6AAA if there was no hit.
 $6AA5 LD A,C         ; {#REGa=the state of the weapon, and jump to #R$6B20 if the weapon
 $6AA6 AND A          ; is active.
 $6AA7 JP NZ,$6B20    ; }
; This entry point is used by the routine at #R$6B20.
@label=UpdateSlug_NoWeaponHit
*$6AAA BIT 3,(IX+$04) ; {Jump to #R$6B3A if the slug is eating the flower.
 $6AAE JP NZ,$6B3A    ; }
 $6AB1 CALL $644D     ; Check whether the slug has reached the flower using
                      ; #R$644D.
 $6AB4 DEC E          ; Decrease the collision result in #REGe by one
                      ; (zero means that the slug has reached the flower).
 $6AB5 JP Z,$679C     ; Jump to #R$679C if the slug has reached the flower, to start
                      ; eating it.
 $6AB8 LD A,(IX+$05)  ; {Jump to #R$6AC3 if the stun timer in #REGix+#N$05 is
 $6ABB AND A          ; zero.
 $6ABC JR Z,$6AC3     ; }
; See #POKE(worms_stay_stunned,Worms stay stunned).
 $6ABE DEC (IX+$05)   ; Decrease the stun timer by one.
 $6AC1 JR $6AF9       ; Jump to #R$6AF9 to draw the slug without moving it.
@label=UpdateSlug_Move
*$6AC3 LD A,($5E17)   ; #REGa=the game timer from #R$5E17.
 $6AC6 AND %00000011  ; Keep only bits 0-1 (the slug only moves every fourth
                      ; update).
 $6AC8 JR NZ,$6AF9    ; Jump to #R$6AF9 to draw the slug if it is not time to
                      ; move.
 $6ACA LD A,(IX+$01)  ; #REGa=the X position of the slug.
 $6ACD CP $18         ; {Jump to #R$6AE7 if the slug is too far to the left to move
 $6ACF JR C,$6AE7     ; vertically.}
 $6AD1 CP $D0         ; {Jump to #R$6AE7 if the slug is too far to the right to move
 $6AD3 JR NC,$6AE7    ; vertically.}
 $6AD5 LD A,(IX+$02)  ; #REGa=the Y position of the slug.
 $6AD8 BIT 7,(IX+$00) ; {Jump to #R$6AFC if the slug is moving up (bit 7 is not
 $6ADC JR Z,$6AFC     ; set).}
 $6ADE ADD A,$01      ; Add #N$01 to move down.
 $6AE0 CP $B8         ; {Jump to #R$6B08 if the slug has reached the bottom.
 $6AE2 JR NC,$6B08    ; }
@label=UpdateSlug_StoreY
*$6AE4 LD (IX+$02),A  ; Write the new Y position.
@label=UpdateSlug_Horizontal
*$6AE7 LD A,(IX+$01)  ; #REGa=the X position of the slug.
 $6AEA BIT 6,(IX+$00) ; {Jump to #R$6B0E if the slug is moving left (bit 6 is
 $6AEE JR Z,$6B0E     ; not set).}
 $6AF0 ADD A,$04      ; Add #N$04 to move right.
 $6AF2 CP $D0         ; {Jump to #R$6B1A if the slug has reached the right
 $6AF4 JR NC,$6B1A    ; edge.}
@label=UpdateSlug_StoreX
*$6AF6 LD (IX+$01),A  ; Write the new X position.
; This entry point is used by the routine at #R$6B3A.
@label=UpdateSlug_Draw
*$6AF9 JP $6F31       ; Jump to #R$6F31 to draw the slug.
@label=UpdateSlug_MoveUp
*$6AFC SUB $01        ; Subtract #N$01 to move up.
 $6AFE CP $28         ; {Jump to #R$6AE4 if the slug has not reached the top.
 $6B00 JR NC,$6AE4    ; }
 $6B02 SET 7,(IX+$00) ; Set bit 7 of #REGix+#N$00 (turn the slug downwards).
 $6B06 JR $6AE7       ; Jump to #R$6AE7.
@label=UpdateSlug_TurnUp
*$6B08 RES 7,(IX+$00) ; Reset bit 7 of #REGix+#N$00 (turn the slug upwards).
 $6B0C JR $6AE7       ; Jump to #R$6AE7.
@label=UpdateSlug_MoveLeft
*$6B0E SUB $04        ; Subtract #N$04 to move left.
 $6B10 CP $18         ; {Jump to #R$6AF6 if the slug has not reached the left
 $6B12 JR NC,$6AF6    ; edge.}
 $6B14 SET 6,(IX+$00) ; Set bit 6 of #REGix+#N$00 (turn the slug to the right).
 $6B18 JR $6AF9       ; Jump to #R$6AF9.
@label=UpdateSlug_TurnLeft
*$6B1A RES 6,(IX+$00) ; Reset bit 6 of #REGix+#N$00 (turn the slug to the
                      ; left).
 $6B1E JR $6AF9       ; Jump to #R$6AF9.

; Handle Slug Weapon Hit
;
; Used by the routine at #R$6A98.
; .
; A weapon has hit the slug. A smoke bomb kills it, a streamer stuns it
; and the repellent spray has no effect.
;
; A State of the weapon
; IX Slug object
@label=SlugWeaponHit
c$6B20 AND %00111111 ; Keep only bits 0-5 (the type of the weapon).
 $6B22 CP $12        ; {Jump to #R$6B34 if the weapon is a streamer.
 $6B24 JR Z,$6B34    ; }
 $6B26 CP $08        ; {Jump to #R$6AAA if the weapon is the repellent spray.
 $6B28 JP Z,$6AAA    ; }
 $6B2B LD BC,$0035   ; #REGbc=#N$0035 (the points for the kill).
 $6B2E CALL $737A    ; Add the points to the score using #R$737A.
 $6B31 JP $65DC      ; Jump to #R$65DC to explode the slug.
@label=SlugWeaponHit_Stun
*$6B34 CALL $65CB    ; Stun the slug using #R$65CB.
 $6B37 JP $6AAA      ; Jump to #R$6AAA.

; Eat Flower
;
; Used by the routines at #R$64FA, #R$67AE, #R$68ED and #R$6A98.
; .
; Updates a bug which is eating the flower. Every update adds one to the
; count of the bugs that are eating in #R$5E3B (which the flower uses to
; decide whether to sink, see #R$6D0C), and the bug wobbles up and down. When
; the flower has sunk below the bug, it stops eating.
;
; IX Bug object
@label=EatFlower
c$6B3A INC (IX+$05)   ; Increment the eating counter in #REGix+#N$05 by one.
 $6B3D LD A,($5E3B)   ; {Increment #R$5E3B by one.
 $6B40 INC A          ;
 $6B41 LD ($5E3B),A   ; }
 $6B44 BIT 3,(IX+$05) ; Test bit 3 of #REGix+#N$05 (the bug moves up and down
                      ; as it eats).
 $6B48 LD A,(IX+$06)  ; #REGa=the Y position the bug started eating at, from
                      ; #REGix+#N$06.
 $6B4B JR NZ,$6B4E    ; Jump to #R$6B4E if bit 3 is set.
 $6B4D DEC A          ; Move the bug up by one pixel.
@label=EatFlower_StoreY
*$6B4E LD (IX+$02),A  ; Write the new Y position.
 $6B51 LD A,($5E8E)   ; #REGa=the Y position of the flower.
 $6B54 SRL A          ; Halve it.
 $6B56 SUB $02        ; Subtract #N$02.
 $6B58 LD C,A         ; #REGc=the position of the top of the flower.
 $6B59 LD A,(IX+$02)  ; #REGa=the Y position of the bug.
 $6B5C SRL A          ; Halve it.
 $6B5E SUB C          ; Subtract the flower position.
 $6B5F JP NC,$6AF9    ; Jump to #R$6AF9 to draw the bug if it is not above the
                      ; flower.
 $6B62 RES 3,(IX+$04) ; Reset bit 3 of #REGix+#N$04 (the bug stops eating).
 $6B66 XOR A          ; #REGa=#N$00.
 $6B67 LD (IX+$05),A  ; Write #N$00 to #REGix+#N$05.
 $6B6A LD (IX+$06),A  ; Write #N$00 to #REGix+#N$06.
 $6B6D JP $6AF9       ; Jump to #R$6AF9 to draw the bug.

; Fire Weapon
;
; Used by the routine at #R$6EF1.
; .
; Fires a weapon from Robbie's spray can into an empty weapon slot, but
; only on every eighth frame. The colour in #R$5E6F decides which weapon it
; is: #N$42 fires a streamer, #N$46 fires the repellent spray and anything
; else fires a smoke bomb.
@label=FireWeapon
c$6B70 LD A,($5C78)  ; #REGa=#SKOOLKID$5C78(FRAMES).
 $6B73 AND %00000111 ; Keep only bits 0-2.
 $6B75 RET NZ        ; Return if the frame is not a multiple of eight.
 $6B76 LD HL,$5E7C   ; #REGhl=#R$5E7C (the first weapon object).
 $6B79 LD DE,$0008   ; #REGde=#N$0008 (the size of an object).
 $6B7C LD B,$02      ; Set the weapon counter to #N$02.
@label=FireWeapon_Loop
*$6B7E LD A,(HL)     ; {Jump to #R$6B86 if the weapon slot is empty.
 $6B7F AND A         ;
 $6B80 JR Z,$6B86    ; }
 $6B82 ADD HL,DE     ; Move onto the next weapon object.
 $6B83 DJNZ $6B7E    ; Decrease the weapon counter by one and loop back to #R$6B7E until
                     ; both weapon slots have been checked.
 $6B85 RET           ; Return.
@label=FireWeapon_Slot
*$6B86 LD ($5E1C),HL ; Write the weapon slot to #R$5E1C.
 $6B89 LD DE,$5E6F   ; #REGde=#R$5E6F (the colour of Robbie).
 $6B8C LD A,(DE)     ; #REGa=the colour of Robbie (which tells us which weapon
                     ; he has).
 $6B8D CP $42        ; {Jump to #R$69BB to fire a streamer if it matches.
 $6B8F JP Z,$69BB    ; }
 $6B92 CP $46        ; {Jump to #R$6974 to fire the repellent spray if it
 $6B94 JP Z,$6974    ; matches.}
; Fire a smoke bomb.
 $6B97 CALL $696B    ; Get the X position and the direction using #R$696B.
 $6B9A JR Z,$6BC7    ; Jump to #R$6BC7 if the smoke bomb goes to the right.
 $6B9C CP $30        ; {Return if Robbie is too close to the left edge.
 $6B9E RET C         ; }
 $6B9F SUB $0C       ; Subtract #N$0C from the X position (so it starts to the left of
                     ; Robbie).
 $6BA1 LD (HL),$44   ; Write #N$44 (a smoke bomb moving left) to the state of
                     ; the weapon.
; This entry point is used by the routine at #R$6BC7.
@label=FireWeapon_SmokeColour
*$6BA3 LD B,$47      ; #REGb=#N$47 (the colour of the smoke bomb).

; Create Weapon
;
; Used by the routines at #R$6974 and #R$69BB.
; .
; Writes the position and the colour of a new weapon into its object and
; plays the sound for the type of the weapon. The weapon starts #N$0C pixels
; above Robbie.
;
; A The X position of the weapon
; B The colour of the weapon
; DE #R$5E6D (the X position of Robbie)
; HL The weapon object (which has the state already written)
@label=CreateWeapon
c$6BA5 INC HL        ; Move onto the X position of the weapon.
 $6BA6 LD (HL),A     ; Write the X position.
 $6BA7 INC DE        ; Move onto the Y position of Robbie.
 $6BA8 INC HL        ; Move onto the Y position of the weapon.
 $6BA9 LD A,(DE)     ; #REGa=the Y position of Robbie.
 $6BAA SUB $0C       ; Subtract #N$0C.
 $6BAC LD (HL),A     ; Write the Y position.
 $6BAD INC HL        ; Move onto the colour of the weapon.
 $6BAE LD (HL),B     ; Write the colour.
 $6BAF INC HL        ; Move onto #REGix+#N$04 of the weapon.
 $6BB0 XOR A         ; #REGa=#N$00.
 $6BB1 LD (HL),A     ; Write #N$00 to #REGix+#N$04.
 $6BB2 INC HL        ; Move onto #REGix+#N$05 of the weapon (the "hit" flag).
 $6BB3 LD (HL),A     ; Write #N$00 to #REGix+#N$05.
 $6BB4 LD HL,($5E1C) ; #REGhl=the weapon object from #R$5E1C.
 $6BB7 LD A,(HL)     ; #REGa=the state of the weapon.
 $6BB8 AND %00111111 ; Keep only bits 0-5 (the type of the weapon).
 $6BBA CP $08        ; {Jump to #R$649E to play the repellent sound if it
 $6BBC JP Z,$649E    ; matches.}
 $6BBF CP $12        ; {Jump to #R$64B8 to play the streamer sound if it
 $6BC1 JP Z,$64B8    ; matches.}
 $6BC4 JP $64C9      ; Jump to #R$64C9 to play the smoke sound.

; Fire Smoke Bomb Right
;
; Used by the routine at #R$6B70.
; .
; Fires a smoke bomb to the right of Robbie, if he is not too close to
; the right edge of the play area.
;
; A The X position of Robbie
; HL The weapon object
@label=FireSmokeBomb_Right
c$6BC7 CP $C0        ; {Return if Robbie is too close to the right edge.
 $6BC9 RET NC        ; }
 $6BCA ADD A,$18     ; Add #N$18 to the X position (so it starts to the right
                     ; of Robbie).
 $6BCC LD (HL),$04   ; Write #N$04 (a smoke bomb moving right) to the state of
                     ; the weapon.
 $6BCE JR $6BA3      ; Jump to #R$6BA3.

; Update Smoke Bomb
;
; Moves a smoke bomb #N$04 pixels at a time in the direction it was
; fired. Every sixteen updates it grows into the next size of cloud (types
; #N$04 to #N$06). The bomb is removed if it hits a bug (see #R$6A42) or
; reaches the edge of the play area.
;
; IX Smoke bomb object
@label=UpdateSmokeBomb
c$6BD0 CALL $75B9     ; Remember the position and state using #R$75B9.
 $6BD3 LD A,(IX+$05)  ; {Jump to #R$69B3 to remove the bomb if it has hit a
 $6BD6 AND A          ; bug.
 $6BD7 JP NZ,$69B3    ; }
 $6BDA INC (IX+$04)   ; Increment the age of the bomb in #REGix+#N$04 by one.
 $6BDD LD A,(IX+$04)  ; #REGa=the age of the bomb.
 $6BE0 AND %00001111  ; Keep only bits 0-3 (every sixteenth update).
 $6BE2 CALL Z,$6C02   ; Call #R$6C02 every sixteen updates.
 $6BE5 LD A,$04       ; #REGa=#N$04 (the distance to move).
 $6BE7 BIT 6,(IX+$00) ; {Jump to #R$6BEF if the bomb is moving right (bit 6 is
 $6BEB JR Z,$6BEF     ; not set).}
 $6BED NEG            ; Negate the distance (move left).
@label=UpdateSmokeBomb_Move
*$6BEF ADD A,(IX+$01) ; Add the X position of the bomb.
 $6BF2 CP $18         ; {Jump to #R$69B3 to remove the bomb if it is past the
 $6BF4 JP C,$69B3     ; left edge.}
 $6BF7 CP $D8         ; {Jump to #R$69B3 to remove the bomb if it is past the
 $6BF9 JP NC,$69B3    ; right edge.}
 $6BFC LD (IX+$01),A  ; Write the new X position.
 $6BFF JP $6F31       ; Jump to #R$6F31 to draw the bomb.

; Grow Smoke Bomb
;
; Used by the routine at #R$6BD0.
; .
; Moves a smoke bomb onto the next size of cloud, up to type #N$06.
;
; IX Smoke bomb object
@label=GrowSmokeBomb
c$6C02 LD A,(IX+$00) ; #REGa=the state of the bomb.
 $6C05 AND %00111111 ; Keep only bits 0-5 (the type).
 $6C07 CP $06        ; Compare the type with #N$06 (the largest cloud).
 $6C09 RET NC        ; Return if the bomb is already the largest cloud.
 $6C0A INC (IX+$00)  ; Increment the state of the bomb by one.
 $6C0D RET           ; Return.

; Grow Leaf
;
; Used by the routine at #R$6D0C.
; .
; Looks for an inactive leaf object and, if there is one, starts a new
; leaf growing on the flower. The leaves alternate between the right and the
; left of the flower using bit 6 of #R$5E15, and bit 0 of #R$5E15 is set to
; stop another leaf being added until the flower has moved again.
@label=GrowLeaf
c$6C0E LD HL,$5E94   ; #REGhl=#R$5E94 (the first leaf object).
 $6C11 LD B,$04      ; Set the leaf counter to #N$04.
 $6C13 LD DE,$0008   ; #REGde=#N$0008 (the size of an object).
@label=GrowLeaf_Loop
*$6C16 LD A,(HL)     ; {Jump to #R$6C1E if the leaf is inactive.
 $6C17 AND A         ;
 $6C18 JR Z,$6C1E    ; }
 $6C1A ADD HL,DE     ; Move onto the next leaf object.
 $6C1B DJNZ $6C16    ; Decrease the leaf counter by one and loop back to #R$6C16 until all
                     ; four leaves have been checked.
 $6C1D RET           ; Return.
@label=GrowLeaf_Found
*$6C1E LD A,($5E15)  ; #REGa=#R$5E15.
 $6C21 XOR %01000000 ; Flip bit 6.
 $6C23 OR %00000001  ; Set bit 0.
 $6C25 LD ($5E15),A  ; Write it back to #R$5E15.
 $6C28 PUSH HL       ; Stash the leaf object on the stack.
 $6C29 EX DE,HL      ; #REGde=the leaf object.
 $6C2A LD HL,$5F38   ; #REGhl=#R$5F38 (the default leaf).
 $6C2D LD BC,$0008   ; #REGbc=#N$0008 (the size of an object).
 $6C30 LDIR          ; Copy the default leaf into the leaf object.
 $6C32 POP HL        ; Restore the leaf object from the stack.
 $6C33 LD A,($5E15)  ; #REGa=#R$5E15.
 $6C36 AND %01000000 ; Keep only bit 6.
 $6C38 LD DE,$5E8D   ; #REGde=#R$5E8D (the X position of the flower).
 $6C3B LD A,(DE)     ; #REGa=the X position of the flower.
 $6C3C JR Z,$6C4D    ; Jump to #R$6C4D if bit 6 was not set, to put the leaf on
                     ; the left.
 $6C3E ADD A,$08     ; Add #N$08.
@label=GrowLeaf_Position
*$6C40 INC HL        ; Move onto the X position of the leaf.
 $6C41 LD (HL),A     ; Write the X position.
 $6C42 INC DE        ; Move onto the Y position of the flower.
 $6C43 INC HL        ; Move onto the Y position of the leaf.
 $6C44 LD A,(DE)     ; #REGa=the Y position of the flower.
 $6C45 ADD A,$07     ; Add #N$07.
 $6C47 LD (HL),A     ; Write the Y position.
 $6C48 LD HL,$5E90   ; #REGhl=#R$5E90 (the number of leaves on the flower).
 $6C4B INC (HL)      ; Increment the number of leaves by one.
 $6C4C RET           ; Return.
@label=GrowLeaf_Left
*$6C4D SET 6,(HL)    ; Set bit 6 of the state of the leaf (so it faces left).
 $6C4F SUB $10       ; Subtract #N$10.
 $6C51 JR $6C40      ; Jump to #R$6C40.

; Update Leaf
;
; Updates a leaf of the flower. A new leaf grows through four frames
; (one every eight updates), an eaten leaf shrinks back through them (one
; every four updates) and is then removed. A leaf is eaten if the
; flower sinks down to the level of the leaf, or when a bug touches it (see
; #R$63AA).
;
; IX Leaf object
;
; The object fields used are:
; #TABLE(default,centre)
; { =h Field | =h Use }
; { +0 bit 6 | The leaf is on the left of the flower }
; { +4 | The leaf is growing or shrinking }
; { +5 | The leaf is being eaten (shrinking) }
; { +6 | The frame of the leaf (#N$00 to #N$03) }
; TABLE#
@label=UpdateLeaf
c$6C53 CALL $75B9      ; Remember the position and state using #R$75B9.
 $6C56 LD A,($5E8E)    ; #REGa=the Y position of the flower.
 $6C59 CP (IX+$02)     ; Compare it with the Y position of the leaf.
 $6C5C JR C,$6C66      ; Jump to #R$6C66 if the flower is above the leaf.
 $6C5E LD (IX+$05),$01 ; Write #N$01 to #REGix+#N$05 (the leaf is being eaten).
 $6C62 LD (IX+$04),$01 ; Write #N$01 to #REGix+#N$04 (the leaf is animating).
@label=UpdateLeaf_Animate
*$6C66 LD A,(IX+$04)   ; {Jump to #R$6CBE if the leaf is not animating.
 $6C69 AND A           ;
 $6C6A JR Z,$6CBE      ; }
 $6C6C LD A,(IX+$05)   ; {Jump to #R$6C9C if the leaf is being eaten.
 $6C6F AND A           ;
 $6C70 JR NZ,$6C9C     ; }
; The leaf is growing, which is done every eighth update.
 $6C72 LD A,($5E17)    ; #REGa=#R$5E17.
 $6C75 CPL             ; Invert all of the bits in #REGa.
 $6C76 AND %00000111   ; Keep only bits 0-2.
 $6C78 JR NZ,$6CBE     ; Jump to #R$6CBE if it is not time for the next frame.
 $6C7A CALL $6CC7      ; Get the sprite of the current frame using #R$6CC7.
 $6C7D CALL $74A8      ; Set up the previous sprite using #R$74A8.
 $6C80 EXX             ; Switch to the shadow registers.
 $6C81 INC (IX+$06)    ; Increment the frame in #REGix+#N$06 by one.
 $6C84 LD A,(IX+$06)   ; #REGa=the frame.
 $6C87 CP $03          ; {Jump to #R$6C8F if it is not the last frame.
 $6C89 JR NZ,$6C8F     ; }
 $6C8B LD (IX+$04),$00 ; Write #N$00 to #REGix+#N$04 (the leaf stops
                       ; animating).
@label=UpdateLeaf_Draw
*$6C8F CALL $6CC7      ; Get the sprite of the new frame using #R$6CC7.
 $6C92 CALL $74C0      ; Set up the new sprite using #R$74C0.
 $6C95 EXX             ; Switch to the shadow registers.
 $6C96 CALL $74F2      ; Erase the previous sprite and draw the new one using
                       ; #R$74F2.
 $6C99 JP $7450        ; Jump to #R$7450 to colour the sprite.
; The leaf is being eaten, which is done every fourth update.
@label=UpdateLeaf_Eaten
*$6C9C LD A,($5E17)    ; #REGa=#R$5E17.
 $6C9F AND %00000011   ; Keep only bits 0-1.
 $6CA1 JR NZ,$6CBE     ; Jump to #R$6CBE if it is not time for the next frame.
 $6CA3 CALL $6CC7      ; Get the sprite of the current frame using #R$6CC7.
 $6CA6 CALL $74A8      ; Set up the previous sprite using #R$74A8.
 $6CA9 EXX             ; Switch to the shadow registers.
 $6CAA DEC (IX+$06)    ; Decrease the frame in #REGix+#N$06 by one.
 $6CAD JP P,$6C8F      ; Jump to #R$6C8F to draw the new frame if there is one.
; The leaf has gone, so remove it.
 $6CB0 INC (IX+$06)    ; Put the frame back to #N$00.
 $6CB3 CALL $6CC7      ; Get the sprite of the first frame using #R$6CC7.
 $6CB6 CALL $6A3A      ; Erase the leaf and make it inactive using #R$6A3A.
 $6CB9 LD HL,$5E90     ; #REGhl=#R$5E90 (the number of leaves on the flower).
 $6CBC DEC (HL)        ; Decrease the number of leaves by one.
 $6CBD RET             ; Return.
@label=UpdateLeaf_Static
*$6CBE CALL $6CC7      ; Get the sprite of the current frame using #R$6CC7.
 $6CC1 CALL $751C      ; Draw the sprite using #R$751C.
 $6CC4 JP $7450        ; Jump to #R$7450 to colour the sprite.

; Get Leaf Sprite
;
; Used by the routine at #R$6C53.
; .
; Finds the sprite for the frame of a leaf. There are four frames for a
; leaf on the right and four for a leaf on the left.
;
;   IX Leaf object
; O:DE Sprite data
@label=GetLeafSprite
c$6CC7 LD A,(IX+$00) ; #REGa=the state of the leaf.
 $6CCA RRCA          ; {Rotate bit 6 round to bit 3.
 $6CCB RRCA          ;
 $6CCC RRCA          ; }
 $6CCD AND %00001000 ; Keep only bit 3.
 $6CCF LD C,A        ; #REGc=#N$08 if the leaf is on the left, or #N$00 if not.
 $6CD0 LD A,(IX+$06) ; #REGa=the frame of the leaf.
 $6CD3 SLA A         ; Double the frame to make an offset into the table.
 $6CD5 OR C          ; Add the offset for the side of the flower.
 $6CD6 LD HL,$6CE1   ; #REGhl=#R$6CE1.
; This entry point is used by the routine at #R$6791.
@label=GetSpriteFromTable
*$6CD9 LD C,A        ; #REGc=the offset.
 $6CDA LD B,$00      ; #REGb=#N$00.
 $6CDC ADD HL,BC     ; Add the offset to #REGhl.
 $6CDD LD E,(HL)     ; #REGe=the low byte of the sprite address.
 $6CDE INC HL        ; Move onto the high byte.
 $6CDF LD D,(HL)     ; #REGd=the high byte of the sprite address.
 $6CE0 RET           ; Return.

; Leaf Sprite Table
;
; The sprite for each frame of a leaf: four for a leaf on the right of
; the flower and then four for a leaf on the left.
@label=LeafSpriteTable
w$6CE1 DEFW $787A
 $6CE3 DEFW $7882
 $6CE5 DEFW $788D
 $6CE7 DEFW $78A6
 $6CE9 DEFW $78C9
 $6CEB DEFW $78D1
 $6CED DEFW $78DC
 $6CEF DEFW $78F5

; Sink Flower
;
; Used by the routine at #R$6D0C.
; .
; Moves the flower down one pixel, and sets the time until the next move
; to #N$0F minus twice the number of bugs eating the flower. If the flower
; reaches the bottom of the play area it has been eaten, and Robbie is
; blown up using #R$6A76.
;
; IX Flower object
@label=SinkFlower
c$6CF1 LD A,(IX+$02) ; #REGa=the Y position of the flower.
 $6CF4 CP $B7        ; {Jump to #R$6A76 if the flower has reached the bottom.
 $6CF6 JP NC,$6A76   ; }
 $6CF9 INC (IX+$02)  ; Increment the Y position of the flower by one.
 $6CFC LD A,($5E3B)  ; #REGa=the number of bugs eating the flower from #R$5E3B.
 $6CFF SLA A         ; Double it.
 $6D01 NEG           ; Negate it.
 $6D03 ADD A,$0F     ; Add #N$0F.
 $6D05 JR $6D52      ; Jump to #R$6D52.

; Draw Flower
;
; Used by the routine at #R$6D0C.
; .
; Draws the flower without moving it.
;
; DE Sprite data
; IX Flower object
@label=DrawFlower
c$6D07 CALL $751C    ; Draw the sprite using #R$751C.
 $6D0A JR $6D60      ; Jump to #R$6D60.

; Update Flower
;
; Updates the flower. Nothing happens until Robbie is active and the
; "get ready" delay has finished. The number of bugs which were eating the
; flower in the last pass of the main loop is in #R$5E3B (which is reset
; here once it has been read), and the flower then does one of three things
; each time the timer in #REGix+#N$05 runs out:
; #LIST
; { grows by one pixel if no bugs are eating it, and the time until the next
; step is #N$20 minus four times the number of leaves (see #R$6D3E); }
; { stays where it is if one bug is eating it; }
; { sinks by one pixel if more than one bug is eating it (see #R$6CF1). }
; LIST#
; Every time the flower reaches a multiple of sixteen pixels in height, a new
; leaf is grown using #R$6C0E. If the flower reaches the top it blooms using
; #R$668E.
;
; IX Flower object
;
; The object fields used are:
; #TABLE(default,centre)
; { =h Field | =h Use }
; { +4 | The number of leaves on the flower }
; { +5 | The timer until the flower next moves }
; { +6 | The number of bugs that were eating the flower last time }
; TABLE#
@label=UpdateFlower
c$6D0C CALL $75B9      ; Remember the position and state using #R$75B9.
 $6D0F LD DE,$769A     ; #REGde=#R$769A (the flower sprite).
 $6D12 LD A,($5E6C)    ; {Jump to #R$6D07 to draw the flower if Robbie is
 $6D15 AND A           ; inactive.
 $6D16 JR Z,$6D07      ; }
 $6D18 LD A,($5E22)    ; {Jump to #R$6D07 to draw the flower if the "get ready" delay in
 $6D1B AND A           ; #R$5E22 is not finished.
 $6D1C JR NZ,$6D07     ; }
 $6D1E LD A,($5E3B)    ; #REGa=the number of bugs eating the flower from
                       ; #R$5E3B.
 $6D21 CP (IX+$06)     ; Compare it with the number in #REGix+#N$06.
 $6D24 JR Z,$6D2D      ; Jump to #R$6D2D if it has not changed.
 $6D26 LD (IX+$06),A   ; Remember the new number in #REGix+#N$06.
 $6D29 LD (IX+$05),$01 ; Write #N$01 to #REGix+#N$05 so that the timer runs out straight
                       ; away.
@label=UpdateFlower_Timer
*$6D2D DEC (IX+$05)    ; Decrease the timer in #REGix+#N$05 by one.
 $6D30 JR NZ,$6D07     ; Jump to #R$6D07 to draw the flower if the timer has
                       ; not run out.
 $6D32 LD A,($5E3B)    ; #REGa=the number of bugs eating the flower from
                       ; #R$5E3B.
 $6D35 AND A           ; Test the number.
 $6D36 JR Z,$6D3E      ; Jump to #R$6D3E if no bugs are eating the flower.
 $6D38 CP $01          ; {Jump to #R$6D07 to draw the flower if only one bug is
 $6D3A JR Z,$6D07      ; eating it.}
 $6D3C JR $6CF1        ; Jump to #R$6CF1 to sink the flower.
@label=UpdateFlower_Grow
*$6D3E DEC (IX+$02)    ; Decrease the Y position of the flower by one.
 $6D41 LD A,(IX+$04)   ; #REGa=the number of leaves from #REGix+#N$04.
 $6D44 RLCA            ; {Multiply it by four.
 $6D45 RLCA            ; }
 $6D46 LD B,A          ; #REGb=four times the number of leaves.
 $6D47 LD A,(IX+$02)   ; #REGa=the Y position of the flower.
 $6D4A CP $70          ; {Jump to #R$668E if the flower has reached the top.
 $6D4C JP C,$668E      ; }
 $6D4F LD A,$20        ; #REGa=#N$20.
 $6D51 SUB B           ; Subtract four times the number of leaves.
; This entry point is used by the routine at #R$6CF1.
@label=UpdateFlower_SetTimer
*$6D52 LD (IX+$05),A   ; Write the time until the next move to #REGix+#N$05.
 $6D55 LD A,($5E15)    ; #REGa=#R$5E15.
 $6D58 AND %01000000   ; Keep only bit 6.
 $6D5A LD ($5E15),A    ; Write it back to #R$5E15 (so bit 0 is reset and a leaf can be
                       ; added).
 $6D5D CALL $74DF      ; Move the flower sprite using #R$74DF.
; This entry point is used by the routine at #R$6D07.
@label=UpdateFlower_Colour
*$6D60 CALL $7450      ; Colour the sprite using #R$7450.
; Draw the stem of the flower from the flower down to the ground.
 $6D63 LD L,(IX+$01)   ; #REGl=the X position of the flower.
 $6D66 LD H,(IX+$02)   ; #REGh=the Y position of the flower.
@label=UpdateFlower_Stem_Loop
*$6D69 LD A,H          ; #REGa=the Y position.
 $6D6A CP $B8          ; {Jump to #R$6D84 if the bottom of the stem has been
 $6D6C JR NC,$6D84     ; reached.}
 $6D6E CPL             ; Invert all of the bits in #REGa.
 $6D6F AND %00000111   ; Keep only bits 0-2.
 $6D71 JR NZ,$6D7A     ; Jump to #R$6D7A unless this is the last pixel row in a
                       ; cell.
 $6D73 PUSH HL         ; Stash the position on the stack.
 $6D74 CALL $748F      ; Convert the position to an attribute buffer address
                       ; using #R$748F.
 $6D77 LD (HL),$7C     ; Write #N$7C (bright green on white) to the attribute
                       ; buffer.
 $6D79 POP HL          ; Restore the position from the stack.
@label=UpdateFlower_Stem_Pixels
*$6D7A PUSH HL         ; Stash the position on the stack.
 $6D7B CALL $759A      ; Convert the position to a screen address using
                       ; #R$759A.
 $6D7E LD (HL),$B9     ; Write #N$B9 to the screen.
 $6D80 POP HL          ; Restore the position from the stack.
 $6D81 INC H           ; Move down one pixel row.
 $6D82 JR $6D69        ; Jump to #R$6D69.
@label=UpdateFlower_Finish
*$6D84 XOR A           ; {Write #N$00 to #R$5E3B (the number of bugs eating the
 $6D85 LD ($5E3B),A    ; flower).}
 $6D88 LD A,(IX+$04)   ; #REGa=the number of leaves from #REGix+#N$04.
 $6D8B AND A           ; Test the number.
 $6D8C RET M           ; Return if it is negative.
 $6D8D LD A,($5E15)    ; #REGa=#R$5E15.
 $6D90 AND %00000001   ; Keep only bit 0.
 $6D92 RET NZ          ; Return if a leaf has already been added.
 $6D93 LD A,(IX+$02)   ; #REGa=the Y position of the flower.
 $6D96 AND %00001111   ; Keep only bits 0-3.
 $6D98 RET NZ          ; Return unless the Y position is a multiple of sixteen.
 $6D99 JP $6C0E        ; Jump to #R$6C0E to grow a leaf.

; Read Player Input
;
; Used by the routines at #R$6DBA and #R$6EF1.
; .
; Reads the controls, using either the Kempston joystick or the keyboard
; depending on the option chosen on the game selection screen. The bits of the
; result are reset when the control is being used:
; #TABLE(default,centre,centre,centre)
; { =h Bit | =h Joystick | =h Key }
; { 0 | Right | W }
; { 1 | Left | Q }
; { 2 | Down | E }
; { 3 | Up | R }
; { 4 | Fire | T }
; TABLE#
;
; O:A The controls
@label=ReadInput
c$6D9C LD A,($5E03)  ; {Jump to #R$75CC if #R$5E03 is set to joystick controls.
 $6D9F BIT 1,A       ;
 $6DA1 JP NZ,$75CC   ; }
; Read keyboard input.
 $6DA4 LD A,$FB      ; {Read from the keyboard;
 $6DA6 OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $6DA8 IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { $FB | Q | W | E | R | T }
                     ; TABLE#}
; Convert the bits into game compatible bits (as in, see #R$75CC - as this is
; what is being matched).
 $6DAA LD C,A        ; Remember the keys that have been read in #REGc.
 $6DAB RRA           ; Rotate the keys right once, so that the W key (right) is
                     ; in bit 0.
 $6DAC AND %00000001 ; Keep only bit 0 (right).
 $6DAE LD E,A        ; Store the right key in #REGe.
 $6DAF LD A,C        ; Restore the keys that were read.
 $6DB0 RLA           ; Rotate the keys left once, so that the Q key (left) is
                     ; in bit 1.
 $6DB1 AND %00000010 ; Keep only bit 1 (left).
 $6DB3 OR E          ; Combine it with the right key.
 $6DB4 LD E,A        ; Store the right and left keys in #REGe.
 $6DB5 LD A,C        ; Restore the keys that were read.
 $6DB6 AND %00011100 ; Keep only bits 2-4 (the E, R and T keys: down, up and
                     ; fire).
 $6DB8 OR E          ; Combine them with the right and left keys.
 $6DB9 RET           ; Return.

; Game Play Entry
;
; Handles Robbie while he is not carrying a spray can (Robbie state
; #N$01). While the "get ready" delay in #R$5E22 counts down, Robbie does
; nothing and the label for the player flashes. After that, the controls move
; him around the play area. When he walks into a cubby hole which contains a
; spray can he picks it up and becomes Robbie carrying a can (see #R$6EF1).
; Walking into a cubby hole which has a bonus item in it collects the item
; (see #R$721A).
;
; IX Robbie object
;
; The Robbie object fields used (here and in #R$6EF1) are:
; #TABLE(default,centre)
; { =h Field | =h Use }
; { +0 | The state: #N$01 when empty-handed and #N$02 when carrying a can }
; { +3 | The colour (white when empty-handed, otherwise the colour of the can) }
; { +4 bit 0 | Facing left (Robbie faces right if this is not set) }
; { +4 bit 2 | Cannot pick up or drop a can (until he has moved away) }
; { +4 bit 3 | Has just picked up a can }
; { +6 | The item last dropped into a cubby hole }
; TABLE#
@label=GamePlayEntry
c$6DBA LD HL,$5E22     ; #REGhl=#R$5E22 (the "get ready" delay).
 $6DBD LD A,(HL)       ; {Jump to #R$6DDB if the delay is zero.
 $6DBE AND A           ;
 $6DBF JR Z,$6DDB      ; }
 $6DC1 DEC (HL)        ; Decrease the delay by one.
 $6DC2 JP NZ,$619E     ; Jump to #R$619E to flash the player label if the delay has not run
                       ; out (which returns to the main loop).
 $6DC5 LD A,($5E1E)    ; #REGa=the current player from #R$5E1E.
 $6DC8 AND A           ; {Jump to #R$6DD6 if it is the second player.
 $6DC9 JR NZ,$6DD6     ; }
 $6DCB LD HL,$0018     ; #REGhl=#N$0018 (the position of the label for 1UP).
@label=Robbie_EmptyHanded_GetReady
*$6DCE CALL $61B4      ; Stop the player label flashing using #R$61B4.
 $6DD1 CALL $64E7      ; Play a tone using #R$64E7.
 $6DD4 JR $6DDB        ; Jump to #R$6DDB.
@label=Robbie_EmptyHanded_GetReady2UP
*$6DD6 LD HL,$00D8     ; #REGhl=#N$00D8 (the position of the label for 2UP).
 $6DD9 JR $6DCE        ; Jump to #R$6DCE.
; Once Robbie is away from the cubby holes he can pick up and drop things
; again.
@label=Robbie_EmptyHanded_Move
*$6DDB LD A,(IX+$01)   ; #REGa=the X position of Robbie.
 $6DDE CP $20          ; {Jump to #R$6DEA if Robbie is too far to the left.
 $6DE0 JR C,$6DEA      ; }
 $6DE2 CP $D0          ; {Jump to #R$6DEA if Robbie is too far to the right.
 $6DE4 JR NC,$6DEA     ; }
 $6DE6 RES 2,(IX+$04)  ; Reset bit 2 of #REGix+#N$04.
@label=Robbie_EmptyHanded_Input
*$6DEA CALL $75B9      ; Remember the position and state using #R$75B9.
 $6DED CALL $6D9C      ; Read the controls using #R$6D9C.
 $6DF0 BIT 0,A         ; {Jump to #R$6E11 if right is being pressed.
 $6DF2 JR Z,$6E11      ; }
 $6DF4 BIT 1,A         ; {Jump to #R$6E1F if left is being pressed.
 $6DF6 JR Z,$6E1F      ; }
@label=Robbie_EmptyHanded_Vertical
*$6DF8 LD A,(IX+$01)   ; #REGa=the X position of Robbie.
 $6DFB CP $18          ; {Jump to #R$6E0E if Robbie is in the cubby hole column
 $6DFD JR C,$6E0E      ; on the left.}
 $6DFF CP $D8          ; {Jump to #R$6E0E if Robbie is in the cubby hole column on the
 $6E01 JR NC,$6E0E     ; right.}
 $6E03 CALL $6D9C      ; Read the controls using #R$6D9C.
 $6E06 BIT 3,A         ; {Jump to #R$6E2A if up is being pressed.
 $6E08 JR Z,$6E2A      ; }
 $6E0A BIT 2,A         ; {Jump to #R$6E38 if down is being pressed.
 $6E0C JR Z,$6E38      ; }
@label=Robbie_EmptyHanded_Draw
*$6E0E JP $6F31        ; Jump to #R$6F31 to draw Robbie.
; Move right.
@label=Robbie_EmptyHanded_Right
*$6E11 LD A,(IX+$01)   ; #REGa=the X position of Robbie.
 $6E14 ADD A,$02       ; Add #N$02.
 $6E16 CP $D8          ; {Jump to #R$6E43 if Robbie has reached the cubby hole column on the
 $6E18 JR NC,$6E43     ; right.}
@label=Robbie_EmptyHanded_StoreX
*$6E1A LD (IX+$01),A   ; Write the new X position.
 $6E1D JR $6DF8        ; Jump to #R$6DF8.
; Move left.
@label=Robbie_EmptyHanded_Left
*$6E1F LD A,(IX+$01)   ; #REGa=the X position of Robbie.
 $6E22 SUB $02         ; Subtract #N$02.
 $6E24 CP $18          ; {Jump to #R$6E43 if Robbie has reached the cubby hole column on the
 $6E26 JR C,$6E43      ; left.}
 $6E28 JR $6E1A        ; Jump to #R$6E1A.
; Move up.
@label=Robbie_EmptyHanded_Up
*$6E2A LD A,(IX+$02)   ; #REGa=the Y position of Robbie.
 $6E2D SUB $02         ; Subtract #N$02.
 $6E2F CP $28          ; {Jump to #R$6E0E if Robbie has reached the top.
 $6E31 JR C,$6E0E      ; }
@label=Robbie_EmptyHanded_StoreY
*$6E33 LD (IX+$02),A   ; Write the new Y position.
 $6E36 JR $6E0E        ; Jump to #R$6E0E.
; Move down.
@label=Robbie_EmptyHanded_Down
*$6E38 LD A,(IX+$02)   ; #REGa=the Y position of Robbie.
 $6E3B ADD A,$02       ; Add #N$02.
 $6E3D CP $B8          ; {Jump to #R$6E0E if Robbie has reached the bottom.
 $6E3F JR NC,$6E0E     ; }
 $6E41 JR $6E33        ; Jump to #R$6E33.
; Robbie has reached one of the cubby hole columns.
@label=Robbie_EmptyHanded_CubbyColumn
*$6E43 CALL $7049      ; Check for a cubby hole using #R$7049.
 $6E46 BIT 0,E         ; {Jump to #R$6DF8 if Robbie is not level with a cubby
 $6E48 JR Z,$6DF8      ; hole.}
 $6E4A BIT 1,E         ; Test bit 1 of #REGe (the right hand side).
 $6E4C LD A,(IX+$01)   ; #REGa=the X position of Robbie.
 $6E4F JR Z,$6E60      ; Jump to #R$6E60 if Robbie is on the left hand side.
 $6E51 ADD A,$02       ; Add #N$02.
 $6E53 CP $E4          ; {Jump to #R$6E0E if Robbie has reached the edge of the
 $6E55 JR NC,$6E0E     ; play area.}
@label=Robbie_EmptyHanded_CubbyHole
*$6E57 BIT 2,E         ; {Jump to #R$6E68 if the cubby hole is not empty.
 $6E59 JR NZ,$6E68     ; }
 $6E5B LD (IX+$01),A   ; Write the new X position.
 $6E5E JR $6E0E        ; Jump to #R$6E0E.
@label=Robbie_EmptyHanded_CubbyHoleLeft
*$6E60 SUB $02         ; Subtract #N$02.
 $6E62 CP $0C          ; {Jump to #R$6E0E if Robbie has reached the edge of the
 $6E64 JR C,$6E0E      ; play area.}
 $6E66 JR $6E57        ; Jump to #R$6E57.
; Robbie has walked into a cubby hole which is not empty.
@label=Robbie_EmptyHanded_Pickup
*$6E68 LD A,(HL)       ; #REGa=the contents of the cubby hole.
 $6E69 BIT 7,A         ; {Jump to #R$6EC0 if bit 7 is set (a bonus item is in
 $6E6B JR NZ,$6EC0     ; the hole).}
 $6E6D BIT 2,(IX+$04)  ; {Jump to #R$6E79 if Robbie is free to pick the item
 $6E71 JR Z,$6E79      ; up.}
 $6E73 CP (IX+$06)     ; {Jump to #R$6E0E if this is the item that Robbie has
 $6E76 JP Z,$6E0E      ; just dropped.}
@label=Robbie_EmptyHanded_TakeCan
*$6E79 AND %00000111   ; Keep only bits 0-2 (the colour of the can).
 $6E7B OR %01000000    ; Set bit 6 (BRIGHT).
 $6E7D LD (IX+$03),A   ; Write it to the colour of Robbie.
 $6E80 LD (IX+$0B),A   ; Write it to the colour of the spray can object.
 $6E83 LD A,$02        ; #REGa=#N$02 (the state of Robbie when he is carrying a
                       ; can).
 $6E85 LD (IX+$00),A   ; Make Robbie carry a can (state #N$02).
 $6E88 INC A           ; Increment the state by one (the state of the spray can
                       ; object).
 $6E89 LD (IX+$08),A   ; Make the spray can object active (state #N$03).
 $6E8C CALL $64D6      ; Play a tone using #R$64D6.
 $6E8F BIT 7,(IX+$01)  ; Test bit 7 of the X position of Robbie.
 $6E93 LD A,(IX+$01)   ; #REGa=the X position of Robbie.
 $6E96 JR Z,$6EC5      ; Jump to #R$6EC5 if Robbie is on the left hand side.
 $6E98 RES 0,(IX+$04)  ; Reset bit 0 of #REGix+#N$04 (Robbie faces right).
 $6E9C ADD A,$14       ; Add #N$14.
 $6E9E LD (IX+$09),A   ; Write it to the X position of the spray can object.
 $6EA1 SUB $04         ; Subtract #N$04.
@label=Robbie_EmptyHanded_PlaceCan
*$6EA3 LD (IX+$0D),A   ; Write it to the new X position of the spray can.
 $6EA6 LD A,(IX+$02)   ; #REGa=the Y position of Robbie.
 $6EA9 LD (IX+$0A),A   ; Write it to the Y position of the spray can object.
 $6EAC LD (IX+$0E),A   ; Write it to the new Y position of the spray can.
 $6EAF LD (IX+$0C),$00 ; Write #N$00 to #REGix+#N$0C (the can is not being put
                       ; away).
 $6EB3 LD (HL),$00     ; Empty the cubby hole.
 $6EB5 SET 2,(IX+$04)  ; Set bit 2 of #REGix+#N$04.
 $6EB9 SET 3,(IX+$04)  ; Set bit 3 of #REGix+#N$04.
 $6EBD JP $6E0E        ; Jump to #R$6E0E.
@label=Robbie_EmptyHanded_Bonus
*$6EC0 LD (HL),$80     ; Write #N$80 to the cubby hole to mark the bonus item
                       ; as collected.
 $6EC2 JP $6E0E        ; Jump to #R$6E0E.
@label=Robbie_EmptyHanded_TakeCanLeft
*$6EC5 SUB $0D         ; Subtract #N$0D.
 $6EC7 LD (IX+$09),A   ; Write it to the X position of the spray can object.
 $6ECA ADD A,$01       ; Add #N$01.
 $6ECC SET 0,(IX+$04)  ; Set bit 0 of #REGix+#N$04 (Robbie faces left).
 $6ED0 JR $6EA3        ; Jump to #R$6EA3.
; View the equivalent code in;
; #LIST
; { #COOKIE$7048 }
; { #JETPAC$73B2 }
; { #SABREWULF$AECF }
; LIST#

; Update Spray Can
;
; Moves the spray can which Robbie is carrying to its new position, which
; Robbie works out in #REGix+#N$05 and #REGix+#N$06. When Robbie puts the can
; in a cubby hole, #REGix+#N$04 is set to #N$01 and the can is made inactive
; after it has been drawn for the last time.
;
; IX Spray can object
@label=UpdateSprayCan
c$6ED2 CALL $75B9      ; Remember the position and state using #R$75B9.
 $6ED5 LD A,(IX+$05)   ; #REGa=the new X position from #REGix+#N$05.
 $6ED8 LD (IX+$01),A   ; Write it to the X position.
 $6EDB LD A,(IX+$06)   ; #REGa=the new Y position from #REGix+#N$06.
 $6EDE LD (IX+$02),A   ; Write it to the Y position.
 $6EE1 CALL $74EB      ; Erase the sprite at the previous position and draw it at the new
                       ; position using #R$74EB.
 $6EE4 CALL $7450      ; Colour the sprite using #R$7450.
 $6EE7 BIT 0,(IX+$04)  ; Test bit 0 of #REGix+#N$04 (the can is being put
                       ; away).
 $6EEB RET Z           ; Return if it is not.
 $6EEC LD (IX+$00),$00 ; Write #N$00 to #REGix+#N$00 (the can is inactive).
 $6EF0 RET             ; Return.

; Update Robbie Carrying Can
;
; Handles Robbie while he is carrying a spray can (Robbie state #N$02).
; The controls move Robbie and the can together, and the can is held out in
; front of him. Robbie can turn round, and he can fire a weapon when fire is
; pressed (see #R$6B70). If Robbie walks all the way into an empty cubby hole
; then he drops the can into it, and becomes Robbie empty-handed (see
; #R$6DBA).
;
; IX Robbie object
@label=Robbie_CarryingCan
c$6EF1 CALL $75B9     ; Remember the position and state using #R$75B9.
 $6EF4 BIT 3,(IX+$04) ; {Jump to #R$6F00 unless Robbie has just picked up the
 $6EF8 JR Z,$6F00     ; can.}
 $6EFA RES 3,(IX+$04) ; Reset bit 3 of #REGix+#N$04.
 $6EFE JR $6F29       ; Jump to #R$6F29.
@label=Robbie_CarryingCan_Input
*$6F00 CALL $6D9C     ; Read the controls using #R$6D9C.
 $6F03 BIT 0,A        ; {Jump to #R$6F41 if right is being pressed.
 $6F05 JR Z,$6F41     ; }
 $6F07 BIT 1,A        ; {Jump to #R$6F77 if left is being pressed.
 $6F09 JR Z,$6F77     ; }
; This entry point is used by the routines at #R$6F41 and #R$6FC9.
@label=Robbie_CarryingCan_Vertical
*$6F0B LD A,(IX+$01)  ; #REGa=the X position of Robbie.
 $6F0E BIT 0,(IX+$04) ; {Jump to #R$6F37 if Robbie is facing right.
 $6F12 JR Z,$6F37     ; }
 $6F14 CP $D8         ; {Jump to #R$6F29 if Robbie is too far to the right to move
 $6F16 JR NC,$6F29    ; vertically.}
 $6F18 CP $24         ; {Jump to #R$6F29 if Robbie is too far to the left to move
 $6F1A JR C,$6F29     ; vertically.}
; This entry point is used by the routine at #R$6F37.
@label=Robbie_CarryingCan_VerticalInput
*$6F1C CALL $6D9C     ; Read the controls using #R$6D9C.
 $6F1F BIT 3,A        ; {Jump to #R$6FAA if up is being pressed.
 $6F21 JP Z,$6FAA     ; }
 $6F24 BIT 2,A        ; {Jump to #R$6FBD if down is being pressed.
 $6F26 JP Z,$6FBD     ; }
; This entry point is used by the routines at #R$6F37, #R$6FAA, #R$6FBD,
; #R$6FC9 and #R$7007.
@label=Robbie_CarryingCan_Fire
*$6F29 CALL $6D9C     ; Read the controls using #R$6D9C.
 $6F2C BIT 4,A        ; Test bit 4 of #REGa (fire).
 $6F2E CALL Z,$6B70   ; Fire a weapon using #R$6B70 if fire is being pressed.

; Draw Object
;
; Used by the routines at #R$64FA, #R$679C, #R$67AE, #R$698F, #R$6A98, #R$6BD0
; and #R$6DBA.
; .
; Erases the sprite of an object from its previous position, draws it at
; the new position and then colours it. This is the end of the update routines
; for most of the objects.
;
; IX Object
@label=DrawObject
c$6F31 CALL $74EB    ; Erase the sprite at the previous position and draw it at the new
                     ; position using #R$74EB.
 $6F34 JP $7450      ; Jump to #R$7450 to colour the sprite.

; Check Vertical Movement Facing Right
;
; Used by the routine at #R$6EF1.
; .
; Robbie is carrying a can and is facing right. He can only move up or
; down when he is away from the cubby hole columns.
;
; A The X position of Robbie
@label=Robbie_CarryingCan_FacingRight
c$6F37 CP $18        ; {Jump to #R$6F29 if Robbie is too far to the left to move
 $6F39 JR C,$6F29    ; vertically.}
 $6F3B CP $CC        ; {Jump to #R$6F29 if Robbie is too far to the right to move
 $6F3D JR NC,$6F29   ; vertically.}
 $6F3F JR $6F1C      ; Jump to #R$6F1C.

; Move Robbie Right
;
; Used by the routine at #R$6EF1.
; .
; Right is being pressed while Robbie is carrying a can. If he is facing
; left then he turns round, otherwise he moves two pixels to the right. The
; can moves with him.
;
; IX Robbie object
@label=Robbie_CarryingCan_Right
c$6F41 BIT 0,(IX+$04) ; {Jump to #R$6F61 if Robbie is facing right.
 $6F45 JR Z,$6F61     ; }
 $6F47 LD A,(IX+$01)  ; #REGa=the X position of Robbie.
 $6F4A SUB $0C        ; Subtract #N$0C.
 $6F4C LD (IX+$01),A  ; Write the new X position.
 $6F4F LD A,(IX+$09)  ; #REGa=the X position of the spray can.
 $6F52 ADD A,$10      ; Add #N$10.
 $6F54 LD (IX+$0D),A  ; Write it to the new X position of the spray can.
 $6F57 RES 0,(IX+$04) ; Reset bit 0 of #REGix+#N$04 (Robbie faces right).
 $6F5B RES 2,(IX+$04) ; Reset bit 2 of #REGix+#N$04.
 $6F5F JR $6F72       ; Jump to #R$6F72.
@label=Robbie_CarryingCan_MoveRight
*$6F61 LD A,(IX+$01)  ; #REGa=the X position of Robbie.
 $6F64 ADD A,$02      ; Add #N$02.
 $6F66 CP $CC         ; {Jump to #R$6FC9 if Robbie has reached the cubby hole
 $6F68 JR NC,$6FC9    ; column.}
 $6F6A LD (IX+$01),A  ; Write the new X position.
 $6F6D LD A,(IX+$09)  ; #REGa=the X position of the spray can.
 $6F70 ADD A,$02      ; Add #N$02.
; This entry point is used by the routine at #R$6F77.
@label=Robbie_CarryingCan_StoreCanX
*$6F72 LD (IX+$0D),A  ; Write it to the new X position of the spray can.
 $6F75 JR $6F0B       ; Jump to #R$6F0B.

; Move Robbie Left
;
; Used by the routine at #R$6EF1.
; .
; Left is being pressed while Robbie is carrying a can. If he is facing
; right then he turns round, otherwise he moves two pixels to the left. The
; can moves with him.
;
; IX Robbie object
@label=Robbie_CarryingCan_Left
c$6F77 BIT 0,(IX+$04) ; {Jump to #R$6F97 if Robbie is facing left.
 $6F7B JR NZ,$6F97    ; }
 $6F7D LD A,(IX+$01)  ; #REGa=the X position of Robbie.
 $6F80 ADD A,$0C      ; Add #N$0C.
 $6F82 LD (IX+$01),A  ; Write the new X position.
 $6F85 LD A,(IX+$09)  ; #REGa=the X position of the spray can.
 $6F88 SUB $10        ; Subtract #N$10.
 $6F8A LD (IX+$0D),A  ; Write it to the new X position of the spray can.
 $6F8D SET 0,(IX+$04) ; Set bit 0 of #REGix+#N$04 (Robbie faces left).
 $6F91 RES 2,(IX+$04) ; Reset bit 2 of #REGix+#N$04.
 $6F95 JR $6F72       ; Jump to #R$6F72.
@label=Robbie_CarryingCan_MoveLeft
*$6F97 LD A,(IX+$01)  ; #REGa=the X position of Robbie.
 $6F9A SUB $02        ; Subtract #N$02.
 $6F9C CP $24         ; {Jump to #R$6FC9 if Robbie has reached the cubby hole
 $6F9E JR C,$6FC9     ; column.}
 $6FA0 LD (IX+$01),A  ; Write the new X position.
 $6FA3 LD A,(IX+$09)  ; #REGa=the X position of the spray can.
 $6FA6 SUB $02        ; Subtract #N$02.
 $6FA8 JR $6F72       ; Jump to #R$6F72.

; Move Robbie Up
;
; Used by the routine at #R$6EF1.
; .
; Moves Robbie, and the can, up two pixels unless he is at the top.
;
; IX Robbie object
@label=Robbie_CarryingCan_Up
c$6FAA LD A,(IX+$02) ; #REGa=the Y position of Robbie.
 $6FAD CP $28        ; {Jump to #R$6F29 if Robbie is at the top.
 $6FAF JP C,$6F29    ; }
 $6FB2 SUB $02       ; Subtract #N$02.
; This entry point is used by the routine at #R$6FBD.
@label=Robbie_CarryingCan_StoreY
*$6FB4 LD (IX+$02),A ; Write the new Y position.
 $6FB7 LD (IX+$0E),A ; Write it to the new Y position of the spray can.
 $6FBA JP $6F29      ; Jump to #R$6F29.

; Move Robbie Down
;
; Used by the routine at #R$6EF1.
; .
; Moves Robbie, and the can, down two pixels unless he is at the bottom.
;
; IX Robbie object
@label=Robbie_CarryingCan_Down
c$6FBD LD A,(IX+$02) ; #REGa=the Y position of Robbie.
 $6FC0 ADD A,$02     ; Add #N$02.
 $6FC2 CP $B8        ; {Jump to #R$6F29 if Robbie is at the bottom.
 $6FC4 JP NC,$6F29   ; }
 $6FC7 JR $6FB4      ; Jump to #R$6FB4.

; Move Robbie Into Cubby Hole
;
; Used by the routines at #R$6F41 and #R$6F77.
; .
; Robbie has walked into one of the cubby hole columns while carrying a
; can. If he is level with a cubby hole which is empty, he keeps on going
; until he reaches the edge and puts the can in the hole.
;
; IX Robbie object
@label=Robbie_CarryingCan_CubbyColumn
c$6FC9 CALL $7049    ; Check for a cubby hole using #R$7049.
 $6FCC LD A,(IX+$02) ; #REGa=the Y position of Robbie.
 $6FCF LD (IX+$0E),A ; Write it to the new Y position of the spray can.
 $6FD2 BIT 0,E       ; {Jump to #R$6F0B if Robbie is not level with a cubby
 $6FD4 JP Z,$6F0B    ; hole.}
 $6FD7 BIT 2,E       ; {Jump to #R$6F29 if the cubby hole is not empty.
 $6FD9 JP NZ,$6F29   ; }
 $6FDC LD A,(IX+$01) ; #REGa=the X position of Robbie.
 $6FDF BIT 1,E       ; {Jump to #R$6FF7 if Robbie is on the left hand side.
 $6FE1 JR Z,$6FF7    ; }
 $6FE3 ADD A,$02     ; Add #N$02.
 $6FE5 CP $D8        ; {Jump to #R$7007 if Robbie has reached the edge.
 $6FE7 JR NC,$7007   ; }
@label=Robbie_CarryingCan_StoreX
 $6FE9 LD (IX+$01),A ; Write the new X position.
 $6FEC LD A,(IX+$09) ; #REGa=the X position of the spray can.
 $6FEF ADD A,$02     ; Add #N$02.
@label=Robbie_CarryingCan_StoreCanX_Left
*$6FF1 LD (IX+$0D),A ; Write it to the new X position of the spray can.
 $6FF4 JP $6F29      ; Jump to #R$6F29.
@label=Robbie_CarryingCan_CubbyColumnLeft
*$6FF7 SUB $02       ; Subtract #N$02.
 $6FF9 CP $18        ; {Jump to #R$7007 if Robbie has reached the edge.
 $6FFB JR C,$7007    ; }
 $6FFD LD (IX+$01),A ; Write the new X position.
 $7000 LD A,(IX+$09) ; #REGa=the X position of the spray can.
 $7003 SUB $02       ; Subtract #N$02.
 $7005 JR $6FF1      ; Jump to #R$6FF1.

; Put Can In Cubby Hole
;
; Used by the routine at #R$6FC9.
; .
; Robbie puts the spray can into the cubby hole in #REGhl, and becomes
; Robbie empty-handed. The can is moved to the cubby hole and, with
; #REGix+#N$0C set to #N$01, is then made inactive by #R$6ED2.
;
; HL The cubby hole
; IX Robbie object
@label=PutCanInCubbyHole
c$7007 BIT 2,(IX+$04)  ; {Jump to #R$6F29 if Robbie cannot drop the can yet.
 $700B JP NZ,$6F29     ; }
 $700E LD A,(IX+$03)   ; #REGa=the colour of Robbie.
 $7011 AND %00000111   ; Keep only bits 0-2 (the colour of the can).
 $7013 OR %00001000    ; Set bit 3 (the item is a spray can).
 $7015 LD (IX+$06),A   ; Remember the item in #REGix+#N$06 so it is not picked up again
                       ; straight away.
 $7018 LD (HL),A       ; Write the item to the cubby hole.
 $7019 SET 2,(IX+$04)  ; Set bit 2 of #REGix+#N$04.
 $701D LD (IX+$00),$01 ; Write #N$01 to #REGix+#N$00 (Robbie is empty-handed).
 $7021 LD (IX+$03),$47 ; Write #N$47 (white) to the colour of Robbie.
 $7025 LD A,(IX+$09)   ; #REGa=the X position of the spray can.
 $7028 BIT 7,A         ; {Jump to #R$703B if the can is on the right hand side.
 $702A JR NZ,$703B     ; }
 $702C SUB $02         ; Subtract #N$02.
@label=PutCanInCubbyHole_Move
*$702E LD (IX+$0D),A   ; Write it to the new X position of the spray can.
 $7031 LD (IX+$0C),$01 ; Write #N$01 to #REGix+#N$0C (the can is being put
                       ; away).
 $7035 CALL $64DC      ; Play a tone using #R$64DC.
 $7038 JP $6F29        ; Jump to #R$6F29.
@label=PutCanInCubbyHole_Right
*$703B ADD A,$04       ; Add #N$04.
 $703D JR $702E        ; Jump to #R$702E.

; Release Item Lock
;
; Used by the routine at #R$7049.
; .
; Used when Robbie is not level with a cubby hole: if he is empty-handed
; then he is allowed to pick up or drop an item again.
;
;   IX Robbie object
; O:E #N$00
@label=ReleaseItemLock
c$703F LD A,(IX+$00)  ; #REGa=the state of Robbie.
 $7042 DEC A          ; Decrease the state by one (zero if Robbie is
                      ; empty-handed).
 $7043 RET NZ         ; Return if Robbie is carrying a can.
 $7044 RES 2,(IX+$04) ; Reset bit 2 of #REGix+#N$04
                      ; (Robbie can pick up and drop a can again).
 $7048 RET            ; Return.

; Check Cubby Hole
;
; Used by the routines at #R$6DBA and #R$6FC9.
; .
; Checks whether Robbie is level with one of the rows of cubby holes.
; If he is then his Y position is made exactly level with the row. #REGe holds
; whether there is a cubby hole, which side it is on and whether it has
; something in it.
;
;   IX Robbie object
; O:E Bit 0 is set if Robbie is level with a cubby hole
; O:E Bit 1 is set if the cubby hole is on the right hand side
; O:E Bit 2 is set if the cubby hole is not empty
; O:HL The cubby hole
@label=CheckCubbyHole
c$7049 LD E,$00       ; #REGe=#N$00 (no cubby hole).
 $704B LD A,(IX+$02)  ; #REGa=the Y position of Robbie.
 $704E AND %00011111  ; Keep only bits 0-4.
 $7050 SUB $17        ; Subtract #N$17 (the cubby holes are at Y positions which are a
                      ; multiple of #N$20 plus #N$17).
 $7052 JP P,$7057     ; {Make sure we have a positive byte.
 $7055 NEG            ; }
@label=CheckCubbyHole_Test_Row
*$7057 CP $05         ; {Jump to #R$703F if Robbie is #N$05 pixels or more away
 $7059 JR NC,$703F    ; from a row.}
 $705B LD A,(IX+$02)  ; #REGa=the Y position of Robbie.
 $705E AND %11100000  ; Keep only bits 5-7.
 $7060 OR %00010111   ; Set bits 0-2 and 4.
 $7062 LD (IX+$02),A  ; Write the new Y position.
 $7065 BIT 7,(IX+$01) ; {Jump to #R$708B if Robbie is on the left hand side.
 $7069 JR Z,$708B     ; }
 $706B LD E,$03       ; #REGe=#N$03 (Robbie is on the right hand side).
@label=CheckCubbyHole_Row
*$706D LD A,(IX+$02)  ; #REGa=the Y position of Robbie.
 $7070 RLCA           ; {Rotate bits 5-7 round to bits 0-2.
 $7071 RLCA           ;
 $7072 RLCA           ; }
 $7073 AND %00000111  ; Keep only bits 0-2.
 $7075 DEC A          ; Decrease #REGa by one to give the row number (0 to 4).
 $7076 BIT 7,(IX+$01) ; {Jump to #R$707E if Robbie is on the left hand side.
 $707A JR Z,$707E     ; }
 $707C ADD A,$05      ; Add #N$05 to select the cubby holes on the right.
@label=CheckCubbyHole_Hole
*$707E LD C,A         ; #REGc=the cubby hole number.
 $707F LD B,$00       ; Clear the high byte of the number in #REGb.
 $7081 LD HL,$5E23    ; #REGhl=#R$5E23.
 $7084 ADD HL,BC      ; Add the cubby hole number to find its contents.
 $7085 LD A,(HL)      ; #REGa=the contents of the cubby hole.
 $7086 AND A          ; Test the contents.
 $7087 RET Z          ; Return if the cubby hole is empty.
 $7088 SET 2,E        ; Set bit 2 of #REGe (the cubby hole is not empty).
 $708A RET            ; Return.
@label=CheckCubbyHole_Left
*$708B LD E,$01       ; #REGe=#N$01 (Robbie is on the left hand side).
 $708D JR $706D       ; Jump to #R$706D.

; Update High Score
;
; Used by the routine at #R$6127.
; .
; Finds the higher of the scores of the two players and, if that is
; higher than the high score at #R$5E00, makes it the new high score. The
; scores are stored as three BCD bytes with the most significant byte first.
@label=UpdateHighScore
c$708F LD HL,($5E05) ; #REGhl=the first two bytes of the score of 1UP.
 $7092 LD DE,($5E08) ; #REGde=the first two bytes of the score of 2UP.
 $7096 LD A,L        ; {Swap #REGh and #REGl so that the most significant byte is in
 $7097 LD L,H        ; #REGh.
 $7098 LD H,A        ; }
 $7099 LD A,E        ; {Swap #REGd and #REGe so that the most significant byte is in
 $709A LD E,D        ; #REGd.
 $709B LD D,A        ; }
 $709C AND A         ; {Compare the first two bytes of the scores.
 $709D SBC HL,DE     ; }
 $709F JR C,$70AD    ; Jump to #R$70AD if 2UP has the higher score.
 $70A1 JR NZ,$70CC   ; Jump to #R$70CC if 1UP has the higher score.
 $70A3 LD A,($5E07)  ; {#REGe=the last byte of the score of 1UP.
 $70A6 LD E,A        ; }
 $70A7 LD A,($5E0A)  ; #REGa=the last byte of the score of 2UP.
 $70AA CP E          ; Compare the last bytes of the scores.
 $70AB JR C,$70CC    ; Jump to #R$70CC if 1UP has the higher score.
@label=UpdateHighScore_2UP
*$70AD LD HL,$5E08   ; #REGhl=#R$5E08 (the score of 2UP).
@label=UpdateHighScore_Compare
*$70B0 PUSH HL       ; Stash the pointer to the score on the stack.
 $70B1 LD DE,$5E00   ; #REGde=#R$5E00 (the high score).
 $70B4 LD B,$03      ; Set the byte counter to #N$03.
@label=UpdateHighScore_Loop
*$70B6 LD A,(DE)     ; {Jump to #R$70C2 if the high score is lower than the
 $70B7 CP (HL)       ; score.
 $70B8 JR C,$70C2    ; }
 $70BA JR NZ,$70C0   ; Jump to #R$70C0 if the high score is higher than the
                     ; score.
 $70BC INC HL        ; {Move onto the next byte of each.
 $70BD INC DE        ; }
 $70BE DJNZ $70B6    ; Decrease the byte counter by one and loop back to #R$70B6 until all
                     ; three bytes have been compared.
@label=UpdateHighScore_Done
*$70C0 POP HL        ; Restore the pointer from the stack.
 $70C1 RET           ; Return.
@label=UpdateHighScore_Copy
*$70C2 POP HL        ; Restore the pointer from the stack.
 $70C3 LD DE,$5E00   ; #REGde=#R$5E00 (the high score).
 $70C6 LD BC,$0003   ; #REGbc=#N$0003.
 $70C9 LDIR          ; Copy the score to the high score.
 $70CB RET           ; Return.
@label=UpdateHighScore_1UP
*$70CC LD HL,$5E05   ; #REGhl=#R$5E05 (the score of 1UP).
 $70CF JR $70B0      ; Jump to #R$70B0.

; Set Leaves Bugs And Explosion Inactive
;
; Sets the leaves, the bugs and the explosion objects to inactive. Nothing
; calls this entry point; the game uses #R$70D6 directly.
@label=Reset
c$70D1 LD HL,$5E94   ; #REGhl=#R$5E94.
 $70D4 LD B,$0B      ; Set the object counter to #N$0B.

; Set Objects Inactive
;
; Used by the routines at #R$5F40, #R$60AA, #R$668E and #R$66D7.
; .
; Writes #N$00 to the state of a number of objects, which makes them
; inactive.
;
; B Loop counter
; HL Object to be updated
@label=SetObjectInactive
c$70D6 LD DE,$0008   ; #REGde=#N$0008 (the size of an object).
@label=SetObjectInactive_Loop
*$70D9 LD (HL),$00   ; Set the state of the object to inactive.
 $70DB ADD HL,DE     ; Move onto the next object.
 $70DC DJNZ $70D9    ; Decrease the object counter by one and loop back to #R$70D9 until
                     ; all of the objects have been made inactive.
 $70DE RET           ; Return.

; Limit Frame Rate
;
; The update routine for the objects which do nothing (type #N$00 and
; types #N$0B to #N$0F). This also slows down the main loop in the slow pass
; when there are not many objects, by making a short pause.
@label=LimitFrameRate
c$70DF LD A,($5E20)  ; {Return if the fast pass is being done (#R$5E20 is marked as being
 $70E2 AND A         ; updated), so there is no pause.
 $70E3 RET NZ        ; }
 $70E4 LD HL,$00C0   ; Set the delay counter for a slight pause
                     ; (so that the game does not run too fast).
@label=LimitFrameRate_Loop
*$70E7 DEC HL        ; Decrease the delay counter by one.
 $70E8 LD A,L        ; {Keep looping back to #R$70E7 until the delay is over.
 $70E9 OR H          ;
 $70EA JR NZ,$70E7   ; }
 $70EC RET           ; Return.
; View the equivalent code in;
; #LIST
; { #COOKIE$7152 }
; { #JETPAC$691B }
; { #LUNARJETMAN$824A }
; LIST#

; Frame Update
;
; Used by the routine at #R$634F.
; .
; Called from the main loop when a new frame has started. It does a
; "fast pass" over the first four objects (Robbie, the spray can and the two
; weapons) so that they are updated once per frame, and then returns to the
; slow pass. It does this by changing the code at #R$713C so that the pass
; ends after the weapons, and at #R$714F so that the end of the pass jumps to
; #R$7125, and then running the main loop from #R$635B.
@label=FrameUpdate
c$70ED DI            ; Disable interrupts.
 $70EE LD A,($5C78)  ; {Update #R$5E1F with #SKOOLKID$5C78(FRAMES).
 $70F1 LD ($5E1F),A  ; }
 $70F4 LD A,$01      ; {Set #R$5E20 as "being updated" (i.e. #N$01).
 $70F6 LD ($5E20),A  ; }
 $70F9 PUSH IX       ; Stash #REGix on the stack.
 $70FB LD HL,$5E8C   ; {Write #R$5E8C to #R$713C(#N$713D).
 $70FE LD ($713D),HL ; }
 $7101 LD A,$C3      ; {#HTML(Write #N$C3 to #R$714F and #R$7125 to
 $7103 LD ($714F),A  ; #R$714F(#N$7150), i.e. <code>JP #R$7125</code>).
 $7106 LD HL,$7125   ;
 $7109 LD ($7150),HL ; }
 $710C LD IX,$5E6C   ; #REGix=#R$5E6C.
 $7110 JP $635B      ; Jump to #R$635B.
; View the equivalent code in;
; #LIST
; { #COOKIE$7160 }
; { #LUNARJETMAN$8209 }
; LIST#

; Reset Modified Code
;
; Used by the routines at #R$632D and #R$7125.
; .
; Puts back the code which is changed by #R$70ED, so that the slow pass
; goes up to the end of the objects at #R$5EEC and the end of the pass does
; the normal housekeeping.
@label=ResetModifiedCode
c$7113 LD HL,$5EEC   ; {Write #R$5EEC to #R$713C(#N$713D).
 $7116 LD ($713D),HL ; }
 $7119 LD A,$2A      ; {Write #N$2A to #R$714F.
 $711B LD ($714F),A  ; }
 $711E LD HL,$5E17   ; {Write #R$5E17 to #R$714F(#N$7150).
 $7121 LD ($7150),HL ; }
 $7124 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #COOKIE$7186 }
; { #LUNARJETMAN$822F }
; LIST#

; Reset Modified Code In Frame
;
; The end of the fast pass, which is reached from #R$714F. It puts back
; the code changed by #R$70ED, gets the old #REGix back and returns to the
; main loop.
@label=ResetModifiedInFrame
c$7125 CALL $7113    ; Call #R$7113.
 $7128 POP IX        ; Restore #REGix, saved during frame update.
 $712A XOR A         ; {Set #R$5E20 as "not updated" (i.e. #N$00).
 $712B LD ($5E20),A  ; }
 $712E EI            ; Enable interrupts.
 $712F RET           ; Return.
; View the equivalent code in;
; #LIST
; { #LUNARJETMAN$823F }
; LIST#

; Next Object
;
; Every update routine returns here. This moves onto the next object and
; goes round the main loop again, unless it was the last object of the pass.
; Then the pass ends by continuing at #R$7145.
;
; IX Object
@label=NewActor
c$7130 LD HL,$5E19   ; {Increment #R$5E19 by one (this changes the random
 $7133 INC (HL)      ; number).}
 $7134 LD DE,$0008   ; #REGde=#N$0008 (the size of an object).
 $7137 ADD IX,DE     ; Set #REGix to the next object.
 $7139 PUSH IX       ; {Copy #REGix to #REGhl using the stack.
 $713B POP HL        ; }
; The self-modifying code routines change the address here to be either;
; #TABLE(default,centre,centre)
; { =h Altering Routine | =h Alteration }
; { #R$7113 | #N$5EEC }
; { #R$70ED | #N$5E8C }
; TABLE#
 $713C LD BC,$5EEC   ; #REGbc=#R$5EEC (the end of the objects).
 $713F AND A         ; {Subtract the end of the objects from the address of the
 $7140 SBC HL,BC     ; object.}
 $7142 JP C,$635B    ; Jump to #R$635B if there are more objects to update.

; End Of Pass
;
; The housekeeping which is done at the end of every pass through the
; objects: this pauses the game while "SHIFT" is held down, adds one to the
; game timer and updates the random number. In the fast pass the instruction at
; #R$714F is changed to jump to #R$7125 instead.
;
; .
;
; Holding "SHIFT" pauses the game.
@label=Pause_Loop
c$7145 LD A,$FE      ; {Read from the keyboard;
 $7147 OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $7149 IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$FE | SHIFT | Z | X | C | V }
                     ; TABLE#}
 $714B BIT 0,A       ; {Jump to #R$7145 if the "SHIFT" key has been pressed.
 $714D JR Z,$7145    ; }
 $714F LD HL,($5E17) ; #REGhl=#R$5E17(see #R$711E).
 $7152 INC HL        ; Increment the game timer by one.
 $7153 LD ($5E17),HL ; Write the game timer back to #R$5E17.
; The random number is the old random number added to the byte of the ROM
; found using the low byte of the game timer, and added to the refresh
; register.
 $7156 LD H,$00      ; #REGh=#N$00.
 $7158 LD A,R        ; #REGa=the refresh register.
 $715A LD C,A        ; #REGc=#REGa.
 $715B LD A,($5E19)  ; #REGa=#R$5E19.
 $715E ADD A,(HL)    ; Add the byte from the ROM.
 $715F ADD A,C       ; Add the refresh register.
 $7160 LD ($5E19),A  ; Write the new random number to #R$5E19.
 $7163 EX AF,AF'     ; Keep a copy of the random number in #REGaf'.

; Spawn Bug
;
; Decides whether to add a new bug to the play area. A bug is added when
; all of the following are true:
; #LIST
; { there are fewer than three bugs, or the level is #N$06 or more, or there
; are fewer than six bugs and the low five bits of the random number are
; zero (a one in thirty-two chance); }
; { the "get ready" delay is over; }
; { the cubby hole picked by the game timer (one of the first ten) is empty; }
; { the flower is not blooming; }
; { Robbie is alive; }
; { there is an inactive bug object. }
; LIST#
; The cubby hole is where the new bug starts. If a bug is not added then this
; carries on at #R$71BE.
@label=SpawnBug
c$7164 LD A,($5E16)  ; #REGa=the number of bugs from #R$5E16.
 $7167 CP $03        ; {Jump to #R$717E if there are fewer than three bugs.
 $7169 JR C,$717E    ; }
 $716B LD A,($5E37)  ; #REGa=the level from #R$5E37.
 $716E CP $06        ; {Jump to #R$717E if the level is #N$06 or more.
 $7170 JR NC,$717E   ; }
 $7172 EX AF,AF'     ; Get the random number back from #REGaf'.
 $7173 AND %00011111 ; Keep only bits 0-4 (a one in thirty-two chance).
 $7175 JR NZ,$71BE   ; Jump to #R$71BE unless the result is zero.
 $7177 LD A,($5E16)  ; #REGa=the number of bugs from #R$5E16.
 $717A CP $06        ; {Jump to #R$71BE if there are six bugs.
 $717C JR NC,$71BE   ; }
@label=SpawnBug_Delay
*$717E LD A,($5E22)  ; #REGa=#R$5E22 (the "get ready" delay).
 $7181 AND A         ; Test the delay.
 $7182 JR NZ,$71BE   ; Jump to #R$71BE if the delay is not over.
 $7184 LD A,($5E17)  ; #REGa=the game timer from #R$5E17.
 $7187 AND %00001111 ; Keep only bits 0-3.
 $7189 CP $0A        ; {Jump to #R$71BE if it is #N$0A or more.
 $718B JR NC,$71BE   ; }
 $718D LD C,A        ; #REGc=the cubby hole number.
 $718E LD B,$00      ; #REGb=#N$00.
 $7190 LD HL,$5E23   ; #REGhl=#R$5E23.
 $7193 ADD HL,BC     ; Add the cubby hole number.
 $7194 LD A,(HL)     ; #REGa=the contents of the cubby hole.
 $7195 AND A         ; Test the contents.
 $7196 JR NZ,$71BE   ; Jump to #R$71BE if the cubby hole is not empty.
 $7198 LD A,($5E8C)  ; #REGa=the state of the flower from #R$5E8C.
 $719B CP $13        ; {Jump to #R$71BE if the flower is blooming.
 $719D JR Z,$71BE    ; }
 $719F LD A,C        ; #REGa=the cubby hole number.
 $71A0 LD ($5E13),A  ; Write it to #R$5E13.
 $71A3 LD A,($5E6C)  ; #REGa=the state of Robbie from #R$5E6C.
 $71A6 AND %00111111 ; Keep only bits 0-5.
 $71A8 DEC A         ; Decrease the state of Robbie by one (zero if he is
                     ; empty-handed).
 $71A9 JR Z,$71AE    ; Jump to #R$71AE if Robbie is empty-handed.
 $71AB DEC A         ; Decrease the state of Robbie by one again
                     ; (zero if he is carrying a can).
 $71AC JR NZ,$71BE   ; Jump to #R$71BE unless Robbie is carrying a can.
@label=SpawnBug_FindSlot
*$71AE LD HL,$5EB4   ; #REGhl=#R$5EB4 (the first bug object).
 $71B1 LD B,$06      ; Set the bug counter to #N$06.
 $71B3 LD DE,$0008   ; #REGde=#N$0008 (the size of an object).
@label=SpawnBug_FindSlot_Loop
*$71B6 LD A,(HL)     ; #REGa=the state of the bug.
 $71B7 AND A         ; Test the state.
 $71B8 JP Z,$7262    ; Jump to #R$7262 if the bug is inactive.
 $71BB ADD HL,DE     ; Move onto the next bug.
 $71BC DJNZ $71B6    ; Decrease the bug counter by one and loop back to #R$71B6 until all
                     ; six bug slots have been checked.

; Spawn Bonus Item
;
; Used by the routines at #R$7164 and #R$7262.
; .
; Updates the bonus item if there is one. Otherwise, it puts a new bonus
; item into a cubby hole, with a chance of one in two hundred and fifty-six. The
; hole is chosen using the game timer, from the first ten, and has to be empty.
; The hole is marked with #N$FF, and the type of the bonus item is a random
; one of #N$0B, #N$0C or #N$0D (with #N$0B more likely). It goes back to the
; start of the main loop at #R$634F.
@label=SpawnBonusItem
c$71BE LD A,($5E3C)    ; #REGa=the state of the bonus item from #R$5E3C.
 $71C1 AND A           ; Test the state.
 $71C2 JP NZ,$721A     ; Jump to #R$721A if there is a bonus item.
 $71C5 LD A,($5E19)    ; #REGa=the random number from #R$5E19.
 $71C8 AND A           ; Test the random number.
 $71C9 JP NZ,$634F     ; Jump to #R$634F to start another pass unless it is
                       ; zero.
 $71CC LD A,($5E17)    ; #REGa=the game timer from #R$5E17.
 $71CF AND %00001111   ; Keep only bits 0-3.
 $71D1 CP $0A          ; {Jump to #R$634F if it is #N$0A or more.
 $71D3 JP NC,$634F     ; }
 $71D6 LD C,A          ; #REGc=the cubby hole number.
 $71D7 LD B,$00        ; #REGb=#N$00.
 $71D9 LD HL,$5E23     ; #REGhl=#R$5E23.
 $71DC ADD HL,BC       ; Add the cubby hole number.
 $71DD LD A,(HL)       ; #REGa=the contents of the cubby hole.
 $71DE AND A           ; Test the contents.
 $71DF JP NZ,$634F     ; Jump to #R$634F if the cubby hole is not empty.
 $71E2 LD (HL),$FF     ; Write #N$FF to the cubby hole.
 $71E4 LD IX,$5E3C     ; #REGix=#R$5E3C (the bonus item).
 $71E8 LD A,C          ; #REGa=the cubby hole number.
 $71E9 CP $05          ; {Jump to #R$725A if the cubby hole is on the right.
 $71EB JR NC,$725A     ; }
 $71ED LD (IX+$01),$08 ; Write #N$08 to the X position of the bonus item.
; This entry point is used by the routine at #R$725A.
@label=SpawnBonusItem_Row
*$71F1 RRCA            ; {Rotate the row number round so it is in bits 5-7.
 $71F2 RRCA            ;
 $71F3 RRCA            ; }
 $71F4 AND %11100000   ; Keep only bits 5-7.
 $71F6 ADD A,$37       ; Add #N$37.
 $71F8 LD (IX+$02),A   ; Write it to the Y position of the bonus item.
 $71FB LD A,R          ; #REGa=the refresh register.
 $71FD AND %00000011   ; Keep only bits 0-1.
 $71FF CP $03          ; {Jump to #R$7204 unless it is #N$03.
 $7201 JR NZ,$7204     ; }
 $7203 XOR A           ; #REGa=#N$00.
@label=SpawnBonusItem_Type
*$7204 ADD A,$0B       ; Add #N$0B to give the type of the bonus item.
 $7206 LD (IX+$04),$FF ; Write #N$FF to #REGix+#N$04 (the contents the cubby hole should
                       ; have).
 $720A LD (IX+$00),A   ; Write the type to the state of the bonus item.
 $720D LD (IX+$03),$43 ; Write #N$43 (magenta) to the colour of the bonus item.
 $7211 LD (IX+$05),C   ; Write the cubby hole number to #REGix+#N$05.
; This entry point is used by the routine at #R$7249.
@label=SpawnBonusItem_Tone
*$7214 CALL $64E7      ; Play a tone using #R$64E7.
 $7217 JP $634F        ; Jump to #R$634F.

; Update Bonus Item
;
; Used by the routine at #R$71BE.
; .
; Updates the bonus item. It sits in a cubby hole and flashes, and when
; Robbie touches it the cubby hole is changed (see #R$6E68) and so the bonus
; item is collected by #R$7249. It goes back to the start of the main loop at
; #R$634F.
@label=UpdateBonusItem
c$721A LD IX,$5E3C   ; #REGix=#R$5E3C.
 $721E CALL $75B9    ; Remember the position and state using #R$75B9.
 $7221 LD C,(IX+$05) ; #REGc=the cubby hole number from #REGix+#N$05.
 $7224 LD B,$00      ; #REGb=#N$00.
 $7226 LD HL,$5E23   ; #REGhl=#R$5E23.
 $7229 ADD HL,BC     ; Add the cubby hole number.
 $722A LD A,(HL)     ; #REGa=the contents of the cubby hole.
 $722B CP (IX+$04)   ; Compare it with #REGix+#N$04.
 $722E JR NZ,$7249   ; Jump to #R$7249 if it has changed.
 $7230 CALL $74EB    ; Erase the sprite at the previous position and draw it at the new
                     ; position using #R$74EB.
 $7233 CALL $7450    ; Colour the sprite using #R$7450.
 $7236 LD A,($5E17)  ; #REGa=the game timer from #R$5E17.
 $7239 AND %00000011 ; Keep only bits 0-1 (every fourth update).
 $723B JP NZ,$634F   ; Jump to #R$634F unless the result is zero.
 $723E LD A,(IX+$03) ; #REGa=the colour of the bonus item.
 $7241 XOR %00000100 ; Flip bit 2 (so the item flashes).
 $7243 LD (IX+$03),A ; Write it back to the colour of the bonus item.
 $7246 JP $634F      ; Jump to #R$634F.

; Collect Bonus Item
;
; Used by the routine at #R$721A.
; .
; Empties the cubby hole and removes the bonus item, and adds #N$1000
; points (as BCD) to the score. Then it plays a tone, and goes back to the start
; of the main loop at #R$634F.
;
; HL The cubby hole
; IX The bonus item
@label=CollectBonusItem
c$7249 LD (HL),$00     ; Write #N$00 to the cubby hole.
 $724B CALL $7526      ; Erase the previous sprite using #R$7526.
 $724E LD BC,$1000     ; #REGbc=#N$1000 (the points).
 $7251 CALL $737A      ; Add the points to the score using #R$737A.
 $7254 LD (IX+$00),$00 ; Write #N$00 to the state of the bonus item.
 $7258 JR $7214        ; Jump to #R$7214.

; Place Bonus Item Right
;
; Used by the routine at #R$71BE.
; .
; The cubby hole is on the right, so the bonus item is put at the right
; hand side.
;
; A The cubby hole number
; IX The bonus item
@label=SpawnBonusItem_Right
c$725A LD (IX+$01),$E8 ; Write #N$E8 to the X position of the bonus item.
 $725E SUB $05         ; Subtract #N$05 to give the row number.
 $7260 JR $71F1        ; Jump to #R$71F1.

; Create Bug
;
; Used by the routine at #R$7164.
; .
; Creates a new bug in an inactive bug object, at the cubby hole whose
; number is in #R$5E13. The type and the colour are chosen using the level, and
; the random number (see #R$72E9). The bug is cancelled if Robbie is too
; close to it.
;
; HL The inactive bug object
@label=CreateBug
c$7262 PUSH HL         ; Stash #REGhl on the stack.
 $7263 EX DE,HL        ; Switch #REGde and #REGhl.
 $7264 LD HL,$5F16     ; {Copy #N$0008 bytes of data from #R$5F16 to #REGde.
 $7267 LD BC,$0008     ;
 $726A LDIR            ; }
 $726C POP IX          ; Restore #REGix from the stack (the old value in
                       ; #REGhl).
 $726E LD A,($5E13)    ; #REGa=#R$5E13.
 $7271 CP $05          ; {Jump to #R$72CC if the cubby hole is on the right.
 $7273 JR NC,$72CC     ; }
 $7275 LD (IX+$01),$08 ; Write #N$08 to the X position of the bug.
 $7279 SET 6,(IX+$00)  ; Set bit 6 of the state of the bug (this has no effect as the
                       ; state is overwritten at #R$72AA).
; This entry point is used by the routine at #R$72CC.
@label=CreateBug_Row
*$727D RRCA            ; {Rotate the row number round so it is in bits 5-7.
 $727E RRCA            ;
 $727F RRCA            ; }
 $7280 AND %11100000   ; Keep only bits 5-7.
 $7282 ADD A,$37       ; Add #N$37.
 $7284 LD (IX+$02),A   ; Write it to the Y position of the bug.
 $7287 LD A,($5E37)    ; #REGa=the level from #R$5E37.
 $728A CP $01          ; {Jump to #R$72D4 if it is level #N$01.
 $728C JR Z,$72D4      ; }
 $728E CP $02          ; {Jump to #R$72DA if it is level #N$02.
 $7290 JR Z,$72DA      ; }
 $7292 CP $03          ; {Jump to #R$72E1 if it is level #N$03.
 $7294 JR Z,$72E1      ; }
 $7296 CP $04          ; {Jump to #R$729C if it is a lower level.
 $7298 JR C,$729C      ; }
 $729A LD A,R          ; #REGa=the refresh register.
; This entry point is used by the routines at #R$72D4, #R$72DA and #R$72E1.
@label=CreateBug_Type
*$729C AND %00000011   ; Keep only bits 0-1.
 $729E LD C,A          ; #REGc=#REGa.
 $729F SLA A           ; Multiply #REGa by two.
 $72A1 ADD A,C         ; Add #REGc to make it three times the bug type.
 $72A2 LD C,A          ; #REGc=the offset into the table (three bytes for each
                       ; type of bug).
 $72A3 LD B,$00        ; Clear the high byte of the offset in #REGb.
 $72A5 LD HL,$72E9     ; #REGhl=#R$72E9.
 $72A8 ADD HL,BC       ; Add the offset.
 $72A9 LD A,(HL)       ; #REGa=the type of the bug.
 $72AA LD (IX+$00),A   ; Write it to the state of the bug.
 $72AD INC HL          ; Move onto the first colour.
 $72AE LD A,($5E19)    ; #REGa=the random number from #R$5E19.
 $72B1 BIT 6,A         ; {Jump to #R$72B6 if bit 6 is not set.
 $72B3 JR Z,$72B6      ; }
 $72B5 INC HL          ; Move onto the second colour.
@label=CreateBug_Colour
*$72B6 LD A,(HL)       ; #REGa=the colour of the bug.
 $72B7 LD (IX+$03),A   ; Write it to the colour of the bug.
 $72BA LD E,$00        ; #REGe=#N$00 (no collision).
 $72BC LD HL,$5E6E     ; #REGhl=#R$5E6E (the Y position of Robbie).
 $72BF CALL $7310      ; Check whether the bug is on top of Robbie using
                       ; #R$7310.
 $72C2 DEC E           ; Decrease the collision result in #REGe by one
                       ; (zero means that the bug is on top of Robbie).
 $72C3 JR NZ,$72C9     ; Jump to #R$72C9 if the bug is not on top of Robbie.
 $72C5 LD (IX+$00),$00 ; Write #N$00 to the state of the bug (cancel it).
@label=CreateBug_Done
*$72C9 JP $71BE        ; Jump to #R$71BE.

; Create Bug Right
;
; Used by the routine at #R$7262.
; .
; The cubby hole is on the right, so the bug is put at the right hand
; side.
;
; A The cubby hole number
; IX The bug
@label=CreateBug_Right
c$72CC LD (IX+$01),$E0 ; Write #N$E0 to the X position of the bug.
 $72D0 SUB $05         ; Subtract #N$05 to give the row number.
 $72D2 JR $727D        ; Jump to #R$727D.

; Create Bug Level 1
;
; Used by the routine at #R$7262.
; .
; On level #N$01 the type of bug is a slug or a leech.
@label=CreateBug_Level1
c$72D4 LD A,R        ; #REGa=the refresh register.
 $72D6 AND %00000001 ; Keep only bit 0.
 $72D8 JR $729C      ; Jump to #R$729C.

; Create Bug Level 2
;
; Used by the routine at #R$7262.
; .
; On level #N$02 the type of bug is a leech or midges.
@label=CreateBug_Level2
c$72DA LD A,R        ; #REGa=the refresh register.
 $72DC AND %00000001 ; Keep only bit 0.
 $72DE INC A         ; Add one.
 $72DF JR $729C      ; Jump to #R$729C.

; Create Bug Level 3
;
; Used by the routine at #R$7262.
; .
; On level #N$03 the type of bug is midges or a slug.
@label=CreateBug_Level3
c$72E1 LD A,R        ; #REGa=the refresh register.
 $72E3 AND %00000001 ; Keep only bit 0.
 $72E5 OR %00000010  ; Set bit 1.
 $72E7 JR $729C      ; Jump to #R$729C.

; Bug Type Table
;
; For each of four sets of bugs, the type of the bug and then its two
; possible colours. The type is #N$07 for a slug, #N$0A for a leech and
; #N$09 for midges.
; #TABLE(default,centre,centre,centre)
; { =h Set | =h Bug | =h Used when #R$5E37 is }
; { #N$00 | Slug | #N$00, #N$01, and #N$04 or more }
; { #N$01 | Leech | #N$01, #N$02, and #N$04 or more }
; { #N$02 | Midges | #N$02, #N$03, and #N$04 or more }
; { #N$03 | Slug | #N$03, and #N$04 or more }
; TABLE#
@label=BugTypeTable
b$72E9 DEFB $07,$44,$45
 $72EC DEFB $0A,$41,$42
 $72EF DEFB $09,$46,$43
 $72F2 DEFB $07,$44,$45

; Check Bug Robbie Collision
;
; Used by the routine at #R$64ED.
; .
; Tests whether a bug is touching Robbie. Robbie only counts when his
; state is #N$01 or #N$02 (empty-handed or carrying a can), so a collision
; cannot happen while he is exploding.
; .
; The two collide when their X positions differ by less than #N$10 and their
; Y positions are close enough. The vertical limit is #N$12 when Robbie is
; lower down the screen than the bug, or the bug's height (from
; *#REGix+#N$07) when the bug is lower down.
;
;   IX Bug object
; O:E #N$00 No collision
; O:E #N$01 Collision
@label=BugCollision
c$72F5 LD HL,$5E6C   ; #REGhl=#R$5E6C (Robbie).
 $72F8 LD E,$00      ; #REGe=#N$00 (the default result, no collision).
 $72FA LD A,(HL)     ; Fetch Robbie's state.
 $72FB AND %00111111 ; Keep only bits 0-5.
 $72FD DEC A         ; Decrease the state of Robbie by one (zero if he is
                     ; empty-handed).
 $72FE JR Z,$7302    ; Jump to #R$7302 if Robbie is empty-handed (state #N$01).
 $7300 DEC A         ; Decrease #REGa by one again.
 $7301 RET NZ        ; Return if Robbie is not carrying a can (state #N$02).
; Check the horizontal distance.
@label=BugCollision_X
*$7302 INC HL        ; {#REGa=Robbie's X position (from #R$5E6D).
 $7303 LD A,(HL)     ; }
 $7304 SUB (IX+$01)  ; Subtract the bug's X position.
 $7307 JP P,$730C    ; {Make sure the difference is positive.
 $730A NEG           ; }
@label=BugCollision_Test_X
*$730C CP $10        ; {Return if the difference is #N$10 or more.
 $730E RET NC        ; }
; Check the vertical distance.
 $730F INC HL        ; Move on to Robbie's Y position.
; This entry point is used by the routine at #R$7262.
@label=BugCollision_Y
*$7310 LD A,(HL)     ; #REGa=Robbie's Y position (from #R$5E6E).
 $7311 SUB (IX+$02)  ; Subtract the bug's Y position.
 $7314 JP P,$731E    ; Jump to #R$731E if Robbie is lower down the screen than
                     ; the bug.
 $7317 NEG           ; Make the difference positive.
 $7319 LD D,(IX+$07) ; #REGd=the bug's height (from *#REGix+#N$07).
 $731C JR $7320      ; Jump to #R$7320.
@label=BugCollision_SetHeight
*$731E LD D,$12      ; #REGd=#N$12.
@label=BugCollision_Test_Y
*$7320 CP D          ; {Return if the difference is #REGd or more.
 $7321 RET NC        ; }
; A collision has been detected.
; .
; See #POKE(immunity,Immunity).
 $7322 LD E,$01      ; #REGe=#N$01.
 $7324 RET           ; Return.

; Display Lives
;
; Used by the routines at #R$5F80 and #R$6176.
; .
; Prints the number of lives each player has left at the top of the
; screen, each followed by a small life icon. A player with no lives left gets
; two spaces instead.
; #PUSHS #UDGTABLE(default,centre)
; { =h Before }
; { #SIM(start=$61CD,stop=$61EA,clear=1,sp=$5D00)
; #POKES$5C37,$3C
; #SIM(start=$6339,stop=$5F96,sp=$5D00)
; #SCR$02,$00,$00,$20,$02(lives-before) }
; { =h After (with #N$03 lives given to 2UP) }
; { #POKES$5E3A,$03
; #SIM(start=$5F96,stop=$5F99,sp=$5D00)
; #SCR$02,$00,$00,$20,$02(lives-after) } UDGTABLE# #POPS
;
; .
;
; Controller for 1UP lives.
@label=DisplayPlayerLives
c$7325 LD HL,$0040    ; {Call #R$759A with #N($0040, $04, $04) (screen buffer
 $7328 CALL $759A     ; address) for 1UP lives.}
 $732B CALL $7364     ; #REGa=1UP lives remaining (by calling #R$7364).
 $732E AND A          ; {If 1UP lives are zero, jump to #R$734D.
 $732F JR Z,$734D     ; }
 $7331 CALL $7340     ; Else, there are lives to display so call #R$7340.
; Controller for 2UP lives.
@label=Controller2UPLives
*$7334 LD HL,$00B0    ; {Call #R$759A with #N($00B0, $04, $04) (screen buffer
 $7337 CALL $759A     ; address) for 2UP lives.}
 $733A CALL $7372     ; #REGa=2UP lives remaining (by calling #R$7372).
 $733D AND A          ; {If 2UP lives are zero, jump to #R$7352.
 $733E JR Z,$7352     ; }
; Handles displaying the lives count and UDG character.
@label=HandlerDisplayLives
*$7340 ADD A,$30      ; Add #N$30 to convert to an ASCII character (starting at
                      ; "0" character).
 $7342 CALL $73CD     ; Call #R$73CD.
 $7345 LD DE,$735C    ; #REGde=#R$735C.
 $7348 PUSH BC        ; {Stash #REGbc and #REGde on the stack.
 $7349 PUSH DE        ; }
 $734A JP $73DD       ; Jump to #R$73DD.
; 1UP has no lives.
@label=Handler1UPNoLives
*$734D CALL $7352     ; Call #R$7352.
 $7350 JR $7334       ; Jump to #R$7334.
; 2UP has no lives.
@label=Handler2UPNoLives
*$7352 LD A,$20       ; #REGa=ASCII " " (SPACE).
 $7354 CALL $73CD     ; Call #R$73CD.
 $7357 LD A,$20       ; #REGa=ASCII " " (SPACE).
 $7359 JP $73CD       ; Jump to #R$73CD.
; The UDG for the lives icon.
@label=UDG_Life
 $735C DEFB %00011000 ; {#UDGTABLE(default,centre) { #UDG#(#PC),attr=$07 }
 $735D DEFB %00100100 ; UDGTABLE#
 $735E DEFB %00111100 ;
 $735F DEFB %01111110 ;
 $7360 DEFB %01011010 ;
 $7361 DEFB %00111100 ;
 $7362 DEFB %00111100 ;
 $7363 DEFB %01100110 ; }
; Return the 1UP player's lives left.
@label=FetchLives_1UP
*$7364 LD A,($5E1E)   ; {If #R$5E1E is not zero then jump to #R$736E.
 $7367 AND A          ;
 $7368 JR NZ,$736E    ; }
; Return currently active players Lives left.
@label=ActivePlayerLives
*$736A LD A,($5E38)   ; #REGa=#R$5E38.
 $736D RET            ; Return.
; Return inactive players Lives left.
@label=InactivePlayerLives
*$736E LD A,($5E3A)   ; #REGa=#R$5E3A.
 $7371 RET            ; Return.
; Return the 2UP player's lives left.
@label=FetchLives_2UP
*$7372 LD A,($5E1E)   ; {If #R$5E1E is zero then jump to #R$736E.
 $7375 AND A          ;
 $7376 JR Z,$736E     ; }
 $7378 JR $736A       ; Jump to #R$736A.
; View the equivalent code in;
; #LIST
; { #COOKIE$7378 }
; { #JETPAC$70A4 }
; { #LUNARJETMAN$894F }
; { #SABREWULF$B7CD }
; { #TRANZAM$687B }
; LIST#

; Add Points To Score
;
; Used by the routines at #R$65D6, #R$6B20 and #R$7249.
; .
; Adds a number of points to the score of the active player. The points
; are given as a two byte BCD number and the score is stored as three BCD bytes
; with the most significant byte first.
;
; BC Points to add to score
;
; Check the active player.
@label=AddPointsToScore
c$737A LD A,($5E1E)  ; {If #R$5E1E is not zero, jump to #R$7385.
 $737D AND A         ;
 $737E JR NZ,$7385   ; }
; Set the score address for 1UP.
 $7380 LD HL,$5E07   ; #REGhl=#R$5E07.
 $7383 JR $7388      ; Jump to #R$7388.
; Set the score address for 2UP.
@label=AddPointsToScore_2UP
*$7385 LD HL,$5E0A   ; #REGhl=#R$5E0A.
; Process adding the points to the appropriate score.
@label=AddPointsToScore_Start
*$7388 LD A,(HL)     ; #REGa=score byte #3.
 $7389 ADD A,C       ; {Add #REGc to score byte #3 with BCD conversion.
 $738A DAA           ; }
 $738B LD (HL),A     ; Update score byte #3.
 $738C DEC HL        ; Move onto the next score byte.
 $738D LD A,(HL)     ; #REGa=score byte #2.
 $738E ADC A,B       ; {Add (with carry) #REGb to score byte #2 with BCD
 $738F DAA           ; conversion.}
 $7390 LD (HL),A     ; Update score byte #2.
 $7391 DEC HL        ; Move onto the next score byte.
 $7392 LD A,(HL)     ; #REGa=score byte #1.
 $7393 ADC A,$00     ; {Add #N$00 (i.e. just the carry flag) to score byte #1
 $7395 DAA           ; with BCD conversion.}
 $7396 LD (HL),A     ; Update score byte #1.
; Check the active player.
 $7397 LD A,($5E1E)  ; {If #R$5E1E is not zero (the active player is 2UP), jump
 $739A AND A         ; to #R$73A5.
 $739B JR NZ,$73A5   ; }
; View the equivalent code in;
; #LIST
; { #ATICATAC$A19C }
; { #BUBBLER$9662 }
; { #COOKIE$7415 }
; { #CYBERUN$925E }
; { #JETPAC$70F9 }
; { #LUNARJETMAN$899C }
; { #MARTIANOIDS$B573 }
; { #NIGHTSHADE$C2ED }
; { #PENTAGRAM$BB29 }
; { #SABREWULF$B5A9 }
; { #TRANZAM$6046 }
; { #UNDERWURLDE$A045 }
; LIST#

; Print Scores
;
; Used by the routine at #R$5F53.
; .
; Prints the 1UP, 2UP and high scores as six digit numbers at the top of
; the screen. Entry points set up the screen address and the score address, and
; #R$73B3 prints the three BCD bytes as six digits.
; #PUSHS #UDGTABLE(default,centre)
; { =h Before }
; { #SIM(start=$61CD,stop=$61EA,clear=1,sp=$5D00)
; #POKES$5C37,$3C
; #SIM(start=$5F53,stop=$5F77,sp=$5D00)
; #SCR$02,$00,$00,$20,$02(scores-before) }
; { =h After }
; { #POKES$5E00,$01;$5E01,$23;$5E02,$40;$5E06,$12;$5E07,$34
; #POKES$5E09,$05;$5E0A,$60;$5D00,$00,$02
; #SIM(start=$5F77,stop=$0000,sp=$5D00)
; #SCR$02,$00,$00,$20,$02(scores-after) } UDGTABLE# #POPS
;
; .
;
; Sets up the 1UP score.
@label=Score_1UP
c$739D LD HL,$4021   ; #REGhl=#N$4021 (screen buffer address).
 $73A0 LD DE,$5E05   ; #REGde=#R$5E05.
 $73A3 JR $73B3      ; Jump to #R$73B3.
; This entry point is used by the routines at #R$5F53 and #R$737A.
; .
; Sets up the 2UP score.
@label=Score_2UP
*$73A5 LD HL,$4039   ; #REGhl=#N$4039 (screen buffer address).
 $73A8 LD DE,$5E08   ; #REGde=#R$5E08.
 $73AB JR $73B3      ; Jump to #R$73B3.
; This entry point is used by the routine at #R$5F53.
; .
; Sets up the HI score.
@label=Score_HI
*$73AD LD HL,$402D   ; #REGhl=#N$402D (screen buffer address).
 $73B0 LD DE,$5E00   ; #REGde=#R$5E00.
; Prints the score.
@label=PrintScore
*$73B3 LD B,$03      ; Set the byte counter to #N$03
                     ; (each byte of the score holds two digits).
@label=PrintScore_Loop
*$73B5 LD A,(DE)     ; Fetch a byte of the score.
 $73B6 RRCA          ; {Move the high digit down into the low nibble.
 $73B7 RRCA          ;
 $73B8 RRCA          ;
 $73B9 RRCA          ; }
 $73BA AND %00001111 ; Keep only bits 0-3 (the high digit).
 $73BC ADD A,$30     ; #REGa=#REGa + #N$30 (convert to ASCII).
 $73BE CALL $73CD    ; Call #R$73CD.
 $73C1 LD A,(DE)     ; Fetch the same byte of the score again.
 $73C2 AND %00001111 ; Keep only bits 0-3 (the low digit).
 $73C4 ADD A,$30     ; #REGa=#REGa + #N$30 (convert to ASCII).
 $73C6 CALL $73CD    ; Call #R$73CD.
 $73C9 INC DE        ; Increment #REGde by one.
 $73CA DJNZ $73B5    ; Decrease the byte counter by one and loop back to #R$73B5 until all
                     ; six digits have been printed.
 $73CC RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$A1AE }
; { #COOKIE$7438 }
; { #JETPAC$711C }
; { #LUNARJETMAN$89BF }
; { #SABREWULF$B5CC }
; { #TRANZAM$6CB6 }
; LIST#

; Print Character
;
; Used by the routines at #R$7325, #R$739D and #R$73ED.
; .
; Prints a single character from the ROM character set at a screen
; address, then moves on to the next column. #R$73DD is also used on its own to
; print the eight byte graphic at #REGde.
;
; A ASCII value to print
; HL Screen address
@label=PrintScreen
c$73CD PUSH BC       ; {Stash #REGbc, #REGde and #REGhl on the stack.
 $73CE PUSH DE       ;
 $73CF PUSH HL       ; }
 $73D0 LD L,A        ; {Create an offset in #REGhl.
 $73D1 LD H,$00      ; }
 $73D3 ADD HL,HL     ; {#REGhl=#REGhl * 8.
 $73D4 ADD HL,HL     ;
 $73D5 ADD HL,HL     ; }
 $73D6 LD DE,($5C36) ; #REGde=#SKOOLKID$5C36(CHARS).
 $73DA ADD HL,DE     ; {#REGde=#REGhl + #N$3C00. For examples of usage;
 $73DB EX DE,HL      ; #TABLE(default,centre,centre,centre,centre,centre)
                     ; { =h Letter | =h ASCII Value | =h * 8 (offset) | =h CHARS + offset }
                     ; #FOREACH($55,$4C,$54,$49,$4D,$41,$54,$45)(value,
                     ; { #LET(result=$3C00 + value * $08) "#CHR(value)" | #N(value) | #N(value * 8) | #SKOOLKID($3D00,{result})(#N({result})) }
                     ; )
                     ; TABLE#}
; Print the character to the screen.
 $73DC POP HL        ; Restore #REGhl, containing the screen buffer location,
                     ; from the stack.
; This entry point is used by the routine at #R$7325.
@label=PrintScreen_Draw
*$73DD LD B,$08      ; #REGb=#N$08 (#N$08 rows of pixels).
@label=PrintScreen_Loop
*$73DF LD A,(DE)     ; {Copy a byte from the font data to the screen buffer.
 $73E0 LD (HL),A     ; }
 $73E1 INC DE        ; Increment the font data by one.
 $73E2 INC H         ; Move onto the next pixel line.
 $73E3 DJNZ $73DF    ; Decrease the row counter by one and loop back to #R$73DF until all
                     ; eight pixel rows have been copied.
 $73E5 POP DE        ; {Restore #REGde and #REGbc from the stack.
 $73E6 POP BC        ; }
; Reset #REGhl and move to the next column, ready to print the next character.
 $73E7 LD A,H        ; {#REGh=#REGh - #N$08 (reset the display line).
 $73E8 SUB $08       ;
 $73EA LD H,A        ; }
 $73EB INC L         ; Increment screen column by one.
 $73EC RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$A1D3 }
; { #COOKIE$7468 }
; { #JETPAC$714C }
; { #LUNARJETMAN$89EF }
; { #MARTIANOIDS$B5CB }
; { #NIGHTSHADE$CB19 }
; { #SABREWULF$B589 }
; { #TRANZAM$6C96 }
; { #UNDERWURLDE$98DF }
; LIST#

; Print Colour String
;
; Used by the routines at #R$6077, #R$60FD, #R$6250 and #R$7413.
; .
; Prints a string, with its colour, at a pixel position. The first byte of
; the string is the colour attribute and the characters that follow are printed
; until one with bit 7 set, which is the last character of the string.
;
; DE Pointer to string data
@label=PrintStringColour
c$73ED PUSH HL       ; Stash #REGhl on the stack.
 $73EE CALL $759A    ; Call #R$759A.
 $73F1 LD A,(DE)     ; Fetch the attribute byte.
 $73F2 EX AF,AF'     ; Switch to the shadow #REGaf register.
 $73F3 INC DE        ; Increment #REGde by one to point to the text of the
                     ; string.
 $73F4 EXX           ; Switch to the shadow registers.
 $73F5 POP HL        ; Restore #REGhl' from the stack.
 $73F6 CALL $748F    ; Call #R$748F.
; This entry point is used by the routine at #R$62E7.
@label=PrintString_Loop
*$73F9 EXX           ; Switch back to the normal registers.
 $73FA LD A,(DE)     ; Fetch the character to print.
 $73FB BIT 7,A       ; {If bit 7 is set (which signifies the end of the
 $73FD JR NZ,$740A   ; string), jump to #R$740A.}
 $73FF CALL $73CD    ; Call #R$73CD.
 $7402 INC DE        ; Increment #REGde by one.
 $7403 EXX           ; Switch to the shadow registers.
 $7404 EX AF,AF'     ; Switch to the shadow #REGaf register.
 $7405 LD (HL),A     ; Copy the attribute byte to the screen.
 $7406 INC L         ; Increment #REGl by one.
 $7407 EX AF,AF'     ; Switch to the shadow #REGaf register.
 $7408 JR $73F9      ; Jump to #R$73F9.
; Because the last character contains the terminator, it needs to be handled
; separately.
@label=PrintString_LastCharacter
*$740A AND %01111111 ; Keep only bits 0-6 (i.e. strip the bit 7 terminator).
 $740C CALL $73CD    ; Call #R$73CD.
 $740F EXX           ; Switch to the shadow registers.
 $7410 EX AF,AF'     ; Switch to the shadow #REGaf register.
 $7411 LD (HL),A     ; Copy the attribute byte to the screen.
 $7412 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$A1F3 }
; { #COOKIE$7488 }
; { #JETPAC$716C }
; { #LUNARJETMAN$8A11 }
; { #MARTIANOIDS$BD99 }
; { #SABREWULF$B53D }
; { #TRANZAM$6518 }
; { #UNDERWURLDE$9C3C }
; LIST#

; Print Banner
;
; Used by the routine at #R$5F53.
; .
; Prints the "1UP", "HI" and "2UP" captions along the top of the screen.
; #PUSHS #UDGTABLE(default,centre)
; { =h Before }
; { #SIM(start=$61CD,stop=$61EA,clear=1,sp=$5D00)
; #POKES$5C37,$3C
; #SIM(start=$5F53,stop=$5F5C,sp=$5D00)
; #SCR$02,$00,$00,$20,$01(banner-before) }
; { =h After }
; { #SIM(start=$5F5C,stop=$5F5F,sp=$5D00)
; #SCR$02,$00,$00,$20,$01(banner-after) } UDGTABLE# #POPS
;
; .
;
; Prints "1UP".
@label=PrintBanner
c$7413 LD HL,$0018       ; #REGhl=#N($0018, 4, 4).
 $7416 LD DE,$742E       ; #REGde=#R$742E.
 $7419 CALL $73ED        ; Call #R$73ED.
; Prints "HI".
 $741C LD HL,$0078       ; #REGhl=#N($0078, 4, 4).
 $741F LD DE,$7436       ; #REGde=#R$7436.
 $7422 CALL $73ED        ; Call #R$73ED.
; Prints "2UP".
 $7425 LD HL,$00D8       ; #REGhl=#N($00D8, 4, 4).
 $7428 LD DE,$7432       ; #REGde=#R$7432.
 $742B JP $73ED          ; Jump to #R$73ED.
; Banner text data.
@label=1UP_Text
 $742E DEFM $47          ; {"1UP" (#COLOUR(#PEEK(#PC)) is the attribute).
 $742F DEFM "1U","P"+$80 ; }
@label=2UP_Text
 $7432 DEFM $47          ; {"2UP" (#COLOUR(#PEEK(#PC)) is the attribute).
 $7433 DEFM "2U","P"+$80 ; }
@label=HI_Text
 $7436 DEFM $78          ; {"HI" (#COLOUR(#PEEK(#PC)) is the attribute).
 $7437 DEFM "H","I"+$80  ; }
; View the equivalent code in;
; #LIST
; { #COOKIE$74AE }
; { #JETPAC$7192 }
; { #LUNARJETMAN$8A37 }
; { #SABREWULF$B563 }
; LIST#

; Reset Screen Buffer
;
; Used by the routine at #R$5F53.
; .
; Clears the screen buffer to zero, but leaves the attribute buffer alone.
@label=ResetScreen
c$7439 LD HL,$4000   ; #REGhl=#N$4000 (the start of the screen buffer).
 $743C LD B,$58      ; #REGb=#N$58 (i.e. finish once we reach the start of the attribute
                     ; buffer at #N$5800).
 $743E LD C,$00      ; #REGc=#N$00 (value to write).
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CE60 }
; { #ATICATAC$80B4 }
; { #COOKIE$74D4 }
; { #CYBERUN$9A7E }
; { #GUNFRIGHT$D6DB }
; { #JETPAC$71B8 }
; { #KNIGHTLORE$D544 }
; { #LUNARJETMAN$84AD }
; { #NIGHTSHADE$E5A8 }
; { #SABREWULF$BB81 }
; { #TRANZAM$7211 }
; LIST#
; .
; Continue on to #R$7440 to blank the screen buffer.

; Fill Memory
;
; Used by the routine at #R$7447.
; .
; Writes a single byte over a block of memory, from the start address up
; to (but not including) the page whose MSB is in #REGb.
;
; HL Target address
; B Single byte representing the MSB of the end address (will always end on LSB
; . #N$00)
; C Value to write
@label=ResetCopier
c$7440 LD (HL),C     ; Write #REGc to the target address.
 $7441 INC HL        ; Increment the target address by one.
 $7442 LD A,H        ; {Are we finished yet? Check the MSB of the target vs.
 $7443 CP B          ; #REGb.}
 $7444 JR C,$7440    ; Keep looping back to #R$7440 until there is no
                     ; carry-over.
 $7446 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$80BB }
; { #COOKIE$74DB }
; { #JETPAC$71B8 }
; { #JETPAC$71BF }
; { #LUNARJETMAN$84B4 }
; { #SABREWULF$BB88 }
; { #TRANZAM$7218 }
; LIST#

; Reset Attribute Buffer
;
; Used by the routine at #R$5F53.
; .
; Clears the attribute buffer to zero (black ink on a black paper).
@label=ResetAttributes
c$7447 LD HL,$5800   ; #REGhl=#N$5800 (the start of the attribute buffer).
 $744A LD B,$5B      ; #REGb=#N$5B (i.e. finish once we reach the end of the attribute
                     ; buffer).
 $744C LD C,$00      ; #REGc=#N$00 (value to write).
 $744E JR $7440      ; Jump to #R$7440.
; View the equivalent code in;
; #LIST
; { #ATICATAC$80C2 }
; { #COOKIE$74E2 }
; { #JETPAC$71C6 }
; { #LUNARJETMAN$84BB }
; { #SABREWULF$BB8F }
; { #TRANZAM$7200 }
; LIST#

; Colourise Sprite
;
; Used by the routines at #R$5FDE, #R$65F7, #R$69E8, #R$6C53, #R$6D0C, #R$6ED2,
; #R$6F31 and #R$721A.
; .
; Writes the colour of an actor into the attribute buffer, covering the
; character cells that its sprite has just been drawn over. The pixels are
; drawn first (see #R$74EB), so until this routine runs the sprite is drawn in
; the attribute that was already there.
;
; IX Actor object
;
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$6339,stop=$634F,sp=$5D00)
; #POKES$5E22,$00;$5E03,$00
; #SIM(start=$6DBA,stop=$6F31,ix=$5E6C,sp=$5D00)
; #SIM(start=$6F31,stop=$7450,ix=$5E6C,sp=$5D00)
; #SCR$03,$0D,$0B,$07,$06(colourise-before)
; | #SIM(start=$7450,stop=$748E,ix=$5E6C,sp=$5D00)
; #SCR$03,$0D,$0B,$07,$06(colourise-after) } UDGTABLE# #POPS
@label=ColouriseSprite
c$7450 EXX           ; Switch to the shadow registers.
 $7451 LD HL,($5E1A) ; Fetch the screen position of the sprite from #R$5E1A.
 $7454 CALL $748F    ; Convert it to an attribute buffer address using #R$748F.
 $7457 LD A,($5E0F)  ; {Set the column counter in #REGb' to the sprite width, from
 $745A LD B,A        ; #R$5E0F.}
 $745B LD A,($5E0E)  ; Fetch the sprite height in pixels from #R$5E0E.
 $745E RRCA          ; {Divide the height by #N$04, add #N$01, then divide by
 $745F RRCA          ; #N$02.
 $7460 INC A         ;
 $7461 RRCA          ; }
 $7462 AND %00011111 ; Keep only bits 0-4.
 $7464 INC A         ; Increment #REGa by one.
 $7465 LD C,A        ; Set the row counter in #REGc' to the result.
 $7466 LD D,(IX+$03) ; Fetch the colour attribute from *#REGix+#N$03.
 $7469 LD E,B        ; Remember the sprite width in #REGe' so that the column counter can
                     ; be reset for each row.
; Colour one row of attribute cells.
@label=ColouriseSprite_Loop1
*$746A PUSH HL       ; Stash the address of the start of the row on the stack.
@label=ColouriseSprite_Loop2
*$746B LD A,H        ; Fetch the MSB of the attribute buffer address.
 $746C CP $5B        ; {Jump to #R$7481 if the address is beyond the attribute buffer
 $746E JR NC,$7481   ; (#REGh is at least #N$5B).}
 $7470 CP $58        ; {Jump to #R$7481 if the address is before the attribute buffer
 $7472 JR C,$7481    ; (#REGh is less than #N$58).}
 $7474 LD (HL),D     ; Write the colour to the attribute buffer.
 $7475 INC L         ; Move onto the next column.
 $7476 LD A,L        ; Fetch the low byte of the address.
 $7477 AND %00011111 ; Keep only bits 0-4 (the column).
 $7479 JR NZ,$747F   ; Jump to #R$747F if the column has not wrapped onto the
                     ; next row.
 $747B LD A,L        ; {Move back to the start of the same row of attribute
 $747C SUB $20       ; cells.
 $747E LD L,A        ; }
@label=ColouriseSprite_NextColumn
*$747F DJNZ $746B    ; Decrease the column counter by one and loop back to #R$746B until
                     ; it is zero.
; Move up one row of attribute cells.
@label=ColouriseSprite_NextRow
*$7481 POP HL        ; Restore the address of the start of the row from the
                     ; stack.
 $7482 PUSH BC       ; {Subtract #N$20 from #REGhl, preserving #REGbc.
 $7483 AND A         ;
 $7484 LD BC,$0020   ;
 $7487 SBC HL,BC     ;
 $7489 POP BC        ; }
 $748A LD B,E        ; Reset the column counter from #REGe'.
 $748B DEC C         ; {Decrease the row counter by one and loop back to #R$746A until it
 $748C JR NZ,$746A   ; is zero.}
 $748E RET           ; Return.
; View the equivalent code in;
; #LIST
; { #LUNARJETMAN$8733 }
; LIST#

; Calculate Attribute Address
;
; Used by the routines at #R$619E, #R$61B4, #R$62E7, #R$670E, #R$6D0C, #R$73ED
; and #R$7450.
; .
; Converts a pixel position into the address of the attribute cell that
; covers it. This is the attribute equivalent of #R$759A.
;
;   HL Pixel address co-ordinates
; O:HL Attribute buffer address
;
; Converts a given pixel address to the associated attribute buffer address.
@label=AttributeAddress
c$748F LD A,L        ; Horizontal co-ordinate.
 $7490 RRCA          ; {Divide by #N08.
 $7491 RRCA          ;
 $7492 RRCA          ; }
 $7493 AND %00011111 ; Keep only bits 0-4 (#N$00-#N$1F / minimum-maximum
                     ; horizontal screen values).
 $7495 LD L,A        ; Store this back in #REGl.
 $7496 LD A,H        ; Vertical co-ordinate.
 $7497 RLCA          ; {Multiply by #N$04.
 $7498 RLCA          ; }
 $7499 LD C,A        ; Store this in #REGc temporarily.
 $749A AND %11100000 ; Keep only bits 5-7.
 $749C OR L          ; Set the bits from #REGl.
 $749D LD L,A        ; #REGl=#REGa.
 $749E LD A,C        ; Fetch the stored value from #REGc.
 $749F AND %00000011 ; Keep only bits 0-1.
 $74A1 OR %01011000  ; Set MSB of the attribute buffer #N$58. This ensures our value is
                     ; >= #N$5800.
 $74A3 LD H,A        ; Store this back in #REGh.
 $74A4 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9BD2 }
; { #COOKIE$7534 }
; { #JETPAC$720E }
; { #LUNARJETMAN$8506 }
; { #SABREWULF$B8DD }
; { #TRANZAM$7097 }
; { #UNDERWURLDE$ADE0 }
; LIST#

; Set Up Previous Sprite
;
; Used by the routine at #R$751C.
; .
; Sprites are drawn by erasing the previous image and drawing the new
; one at the same time, a row at a time. The routines from here to #R$74F2
; prepare the two images: the main registers hold one sprite and the shadow
; registers hold the other. Each is set up with the screen address in
; #REGhl, the sprite width in #REGb, a row count of zero in #REGc and the
; sprite data pointer in #REGde.
; .
; This entry point finds the previous sprite from the temporary actor state
; at #R$5E0B, using #R$7542 to get its graphic.
@label=SetUpPreviousSprite
c$74A5 CALL $7542    ; Call #R$7542.
; This entry point is used by the routines at #R$66A6, #R$69E8, #R$6C53 and
; #R$751C.
; .
; Sets up the previous sprite using the sprite data address in #REGde,
; rather than looking it up.
@label=SetUpPreviousSprite_Address
*$74A8 LD HL,($5E0B) ; Fetch the previous X and Y position from #R$5E0B.
; This entry point is used by the routine at #R$65F7.
; .
; The first byte of the sprite is a horizontal offset in pixels.
@label=SetUpPreviousSprite_Offset
*$74AB LD A,(DE)     ; Fetch the horizontal offset.
 $74AC INC DE        ; Move onto the sprite width.
 $74AD ADD A,L       ; Add the horizontal offset to the X position.
 $74AE LD L,A        ; Store the result back in #REGl.
 $74AF CALL $759A    ; Convert the position into a screen address using
                     ; #R$759A.
 $74B2 LD A,(DE)     ; Fetch the sprite width.
 $74B3 LD B,A        ; Set the width counter in #REGb to the sprite width.
 $74B4 INC DE        ; Move onto the sprite height.
 $74B5 LD A,(DE)     ; Fetch the sprite height.
 $74B6 LD ($5E10),A  ; Store it in #R$5E10 as the height of the previous
                     ; sprite.
@label=SetUpSprite_Finish
*$74B9 LD C,$00      ; Set the row count in #REGc to #N$00 (no rows have been
                     ; drawn yet).
 $74BB INC DE        ; Move onto the first byte of the sprite graphic data.
 $74BC RET           ; Return.
; This entry point is used by the routine at #R$751C.
; .
; Sets up the sprite of the actor in #REGix, using #R$757A to get its
; graphic.
@label=SetUpSprite
*$74BD CALL $757A    ; Call #R$757A.
; This entry point is used by the routines at #R$66A6, #R$69E8, #R$6C53 and
; #R$751C.
; .
; Sets up the sprite using the sprite data address in #REGde, at the
; position held in the actor object.
@label=SetUpSprite_Address
*$74C0 LD L,(IX+$01) ; {Fetch the X and Y position from *#REGix+#N$01 and
 $74C3 LD H,(IX+$02) ; *#REGix+#N$02.}
; This entry point is used by the routine at #R$5FDE.
@label=SetUpSprite_Offset
*$74C6 LD A,(DE)     ; Fetch the horizontal offset.
 $74C7 INC DE        ; Move onto the sprite width.
 $74C8 ADD A,L       ; Add the horizontal offset to the X position.
 $74C9 LD L,A        ; Store the result back in #REGl.
 $74CA LD ($5E1A),HL ; Store the screen position in #R$5E1A.
 $74CD CALL $759A    ; Convert the position into a screen address using
                     ; #R$759A.
 $74D0 LD A,(DE)     ; Fetch the sprite width.
 $74D1 LD B,A        ; Set the width counter in #REGb to the sprite width.
 $74D2 LD ($5E0F),A  ; Store it in #R$5E0F.
 $74D5 INC DE        ; Move onto the sprite height.
 $74D6 LD A,(DE)     ; Fetch the sprite height.
 $74D7 LD ($5E11),A  ; Store it in #R$5E11 as the height of the new sprite.
 $74DA LD ($5E0E),A  ; Store it in #R$5E0E.
 $74DD JR $74B9      ; Jump to #R$74B9.
; This entry point is used by the routine at #R$6D0C.
; .
; Moves a sprite using the same sprite data in #REGde for both the
; previous image (erased) and the new image (drawn).
@label=ReplaceSprite
*$74DF PUSH DE       ; Stash the sprite data pointer on the stack.
 $74E0 CALL $74A8    ; Set up the previous sprite using #R$74A8.
 $74E3 EXX           ; Switch to the shadow registers.
 $74E4 POP DE        ; Restore the sprite data pointer from the stack.
 $74E5 CALL $74C0    ; Set up the new sprite using #R$74C0.
 $74E8 EXX           ; Switch to the shadow registers.
 $74E9 JR $74F2      ; Jump to #R$74F2.
; This entry point is used by the routines at #R$6ED2, #R$6F31 and #R$721A.
; .
; Display Entity. Erases the previous sprite of the actor in
; #REGix and draws the new one.
; .
; #PUSHS #UDGTABLE(default,centre,centre,centre)
; { =h Before | =h After #R$74EB | =h After #R$7450 }
; { #SIM(start=$6339,stop=$634F,sp=$5D00)
; #POKES$5E22,$00;$5E03,$00
; #SIM(start=$6DBA,stop=$6F31,ix=$5E6C,sp=$5D00)
; #SCR$03,$0D,$0B,$07,$06(move-sprite-before)
; | #SIM(start=$6F31,stop=$7450,ix=$5E6C,sp=$5D00)
; #SCR$03,$0D,$0B,$07,$06(move-sprite-drawn)
; | #SIM(start=$7450,stop=$748E,ix=$5E6C,sp=$5D00)
; #SCR$03,$0D,$0B,$07,$06(move-sprite-coloured) } UDGTABLE# #POPS
@label=DisplayEntity
*$74EB CALL $74BD    ; Set up the new sprite using #R$74BD.
 $74EE EXX           ; Switch to the shadow registers.
 $74EF CALL $74A5    ; Set up the previous sprite using #R$74A5.
; This entry point is used by the routines at #R$66A6, #R$69E8 and #R$6C53.
; .
; Work out how many rows of one sprite lie beyond the other.
@label=DisplayEntity_Compare
*$74F2 LD A,($5E0C)  ; Fetch the previous Y position from #R$5E0C.
 $74F5 SUB (IX+$02)  ; Subtract the new Y position.
 $74F8 JP Z,$7601    ; Jump to #R$7601 if the two sprites start on the same
                     ; row.
 $74FB JP M,$750D    ; Jump to #R$750D if the new sprite starts lower down the
                     ; screen.
 $74FE LD C,A        ; Store the number of extra rows in #REGc.
 $74FF LD A,($5E10)  ; Fetch the height of the previous sprite from #R$5E10.
 $7502 CP C          ; Compare it with the number of extra rows.
 $7503 JP C,$7601    ; Jump to #R$7601 if the sprites do not overlap.
 $7506 SUB C         ; Subtract the extra rows from the height of the previous
                     ; sprite.
 $7507 LD ($5E10),A  ; Write it back to #R$5E10.
 $750A JP $75D0      ; Jump to #R$75D0 to erase the extra rows of the previous sprite
                     ; first.
; The new sprite starts lower down the screen, so its extra rows are
; drawn first.
@label=DisplayEntity_NewLower
*$750D EXX           ; Switch to the shadow registers.
 $750E NEG           ; Make the number of extra rows positive.
 $7510 LD C,A        ; Store the number of extra rows in #REGc.
 $7511 LD A,($5E11)  ; Fetch the height of the new sprite from #R$5E11.
 $7514 CP C          ; Compare it with the number of extra rows.
 $7515 JP C,$7600    ; Jump to #R$7600 if the sprites do not overlap.
 $7518 SUB C         ; Subtract the extra rows from the height of the new
                     ; sprite.
 $7519 JP $7614      ; Jump to #R$7614.

; Draw Sprite
;
; Used by the routines at #R$65F7, #R$6C53 and #R$6D07.
; .
; Draws a sprite without erasing anything, or erases a sprite without
; drawing anything.
;
; DE Sprite data
; IX Actor object
@label=DrawSprite
c$751C CALL $74C0    ; Set up the sprite using #R$74C0.
 $751F JR $7539      ; Jump to #R$7539.
; This entry point is used by the routines at #R$6A31 and #R$6A3A.
; .
; Erases the sprite at #REGde from the previous position.
@label=RemoveEntity_Address
*$7521 CALL $74A8    ; Set up the previous sprite using #R$74A8.
 $7524 JR $7529      ; Jump to #R$7529.
; This entry point is used by the routines at #R$65F7, #R$69B3 and #R$7249.
; .
; Remove Entity. Erases the previous sprite of an actor.
@label=RemoveEntity
*$7526 CALL $74A5    ; Set up the previous sprite using #R$74A5.
; This entry point is used by the routine at #R$65F7.
; .
; Clears the height of the new sprite so that nothing is drawn.
@label=RemoveEntity_ClearNew
*$7529 EXX           ; Switch to the shadow registers.
 $752A XOR A         ; Set #REGa to #N$00.
 $752B LD C,A        ; Set the row count in #REGc to #N$00.
 $752C LD ($5E11),A  ; Write #N$00 to #R$5E11.
 $752F LD ($5E0E),A  ; Write #N$00 to #R$5E0E.
 $7532 EXX           ; Switch to the shadow registers.
 $7533 JP $75D0      ; Jump to #R$75D0.
; Draw Entity. This entry point is not used.
@label=DrawEntity
 $7536 CALL $74BD    ; Set up the sprite of the actor in #REGix using #R$74BD.
; This entry point is used by the routine at #R$5FDE.
; .
; Clears the height of the previous sprite so that nothing is erased.
@label=DrawSprite_ClearPrevious
*$7539 EXX           ; Switch to the shadow registers.
 $753A XOR A         ; Set #REGa to #N$00.
 $753B LD ($5E10),A  ; Write #N$00 to #R$5E10.
 $753E LD C,A        ; Set the row count in #REGc to #N$00.
 $753F JP $75D0      ; Jump to #R$75D0.

; Prepare Old Sprite
;
; Used by the routine at #R$74A5.
; .
; Finds the graphic for the previous state of an object, using the copy
; of its X position and state that #R$75B9 saved at #R$5E0B. The rest of the
; routine, from #R$754B, is shared with #R$757A.
; .
; The sprite is looked up in #R$761A (for types #N$01-#N$03) or #R$764A (for
; types #N$04-#N$0D). The entry is chosen by the object type (the state with
; bits 6 and 7 removed), by the X position within a character cell and by bit
; 6 of the state, which selects the second set of sprites.
;
; O:DE Address of the sprite
@label=PrepareOldSprite
c$7542 LD A,($5E0B)  ; #REGa=the saved X position (from #R$5E0B).
 $7545 AND %00000110 ; Keep only bits 1-2 (the X position within a character cell, in
                     ; steps of two pixels).
 $7547 LD C,A        ; Keep the X position bits in #REGc.
 $7548 LD A,($5E0D)  ; #REGa=the saved state (from #R$5E0D).
; This entry point is used by the routine at #R$757A.
; .
; Find the sprite from the state in #REGa and the X position bits in
; #REGc.
@label=ActorGetSpriteAddress
*$754B BIT 6,A       ; {Jump to #R$7551 if bit 6 of the state is clear.
 $754D JR Z,$7551    ; }
 $754F SET 3,C       ; Set bit 3 of #REGc to select the second set of sprites.
@label=ActorGetSpriteAddress_Type
*$7551 DEC A         ; Decrease the state by one (so that type #N$01 becomes
                     ; #N$00).
 $7552 CP $03        ; {Jump to #R$7568 if the result is #N$03 or more.
 $7554 JR NC,$7568   ; }
; Types #N$01-#N$03 have eight sprites each (four X positions for each of
; the two directions).
 $7556 RLCA          ; {Multiply the type by #N$10 (the length of a type's entries in the
 $7557 RLCA          ; table).
 $7558 RLCA          ;
 $7559 RLCA          ; }
 $755A AND %11110000 ; Keep only bits 4-7.
 $755C OR C          ; Add in the X position and direction bits from #REGc.
 $755D LD HL,$761A   ; #REGhl=#R$761A.
@label=ActorGetSpriteAddress_Lookup
*$7560 LD C,A        ; Store the offset in #REGc.
 $7561 LD B,$00      ; #REGb=#N$00.
 $7563 ADD HL,BC     ; #REGhl=the table address + the offset.
 $7564 LD E,(HL)     ; {Fetch the sprite address into #REGde.
 $7565 INC HL        ;
 $7566 LD D,(HL)     ; }
 $7567 RET           ; Return.
; Types #N$04 and above have four sprites each, which only change with bit
; 2 of the X position and with the direction.
@label=ActorGetSpriteAddress_OtherTypes
*$7568 SUB $03       ; Subtract #N$03 from the type (it is already one less than the real
                     ; type), so that type #N$04 becomes #N$00.
 $756A RLCA          ; {Multiply the type by #N$08 (the length of a type's entries in the
 $756B RLCA          ; table).
 $756C RLCA          ; }
 $756D AND %11111000 ; Keep only bits 3-7.
 $756F LD B,A        ; Store the result in #REGb.
 $7570 LD A,C        ; #REGa=#REGc.
 $7571 RRCA          ; Move the X position bits and the direction bit down by
                     ; one place.
 $7572 AND %00000110 ; Keep only bits 1-2.
 $7574 OR B          ; Add in the type offset.
 $7575 LD HL,$764A   ; #REGhl=#R$764A.
 $7578 JR $7560      ; Jump to #R$7560.
; View the equivalent code in;
; #LIST
; { #TRANZAM$70B2 }
; LIST#

; Find Object Sprite
;
; Used by the routine at #R$74A5.
; .
; Finds the graphic for the current state of an object. This is the same
; as #R$7542 except that the X position and state are taken from the object.
;
;   IX Object
; O:DE Address of the sprite
@label=ActorMoveSprite
c$757A LD A,(IX+$01) ; #REGa=the object's X position.
 $757D AND %00000110 ; Keep only bits 1-2.
 $757F LD C,A        ; Keep the X position bits in #REGc.
 $7580 LD A,(IX+$00) ; #REGa=the object's state.
 $7583 JR $754B      ; Jump to #R$754B.

; Screen Address One Pixel Above
;
; Used by the routine at #R$75D0.
; .
; Moves a screen address up by one pixel row, allowing for the layout of
; the screen buffer.
;
;   HL Screen address
; O:HL Screen address one pixel row above
@label=ScreenPosition1PixelAbove
c$7585 DEC H         ; Decrease #REGh by one to move up one pixel row within the character
                     ; cell.
 $7586 LD A,H        ; Store the result in #REGa.
 $7587 AND %00000111 ; Keep only bits 0-2.
 $7589 CP $07        ; {Return if the top of the character cell has not been
 $758B RET NZ        ; crossed.}
 $758C LD A,L        ; {Subtract #N$20 from #REGl to move up one character row.
 $758D SUB $20       ;
 $758F LD L,A        ; }
 $7590 AND %11100000 ; Keep only bits 5-7.
 $7592 CP $E0        ; {Return if the move crossed into the previous third of the screen
 $7594 RET Z         ; (the address is then already correct).}
 $7595 LD A,H        ; {Add #N$08 to #REGh to move to the bottom pixel row of the character
 $7596 ADD A,$08     ; row above, then return.
 $7598 LD H,A        ;
 $7599 RET           ; }
; View the equivalent code in;
; #LIST
; { #ATICATAC$9F03 }
; { #LUNARJETMAN$85F6 }
; { #UNDERWURLDE$AE71 }
; LIST#

; Calculate Screen Address
;
; Used by the routines at #R$62E7, #R$6D0C, #R$7325, #R$73ED and #R$74A5.
; .
; Converts a pixel position into an address in the screen buffer.
;
;   H Y position (pixel row)
;   L X position (pixel column)
; O:HL Screen buffer address
@label=ScreenAddress
c$759A LD A,L        ; #REGa=the X position.
 $759B RRCA          ; {Divide by #N$08 (to give the character column).
 $759C RRCA          ;
 $759D RRCA          ; }
 $759E AND %00011111 ; Keep only bits 0-4.
 $75A0 LD L,A        ; Store the column in #REGl.
 $75A1 LD A,H        ; #REGa=the Y position.
 $75A2 RLCA          ; {Multiply by #N$04, so that bits 3-5 of the Y position are in bits
 $75A3 RLCA          ; 5-7.}
 $75A4 AND %11100000 ; Keep only bits 5-7 (the character row within the third).
 $75A6 OR L          ; Combine with the column.
 $75A7 LD L,A        ; Store the result in #REGl.
 $75A8 LD A,H        ; #REGa=the Y position.
 $75A9 AND %00000111 ; Keep only bits 0-2 (the pixel row within the character
                     ; cell).
 $75AB EX AF,AF'     ; Switch to the shadow #REGaf register to keep the result.
 $75AC LD A,H        ; #REGa=the Y position.
 $75AD RRCA          ; {Divide by #N$08.
 $75AE RRCA          ;
 $75AF RRCA          ; }
 $75B0 AND %00011000 ; Keep only bits 3-4 (the third of the screen).
 $75B2 OR %01000000  ; Set bit 6 to point at the screen buffer.
 $75B4 LD H,A        ; Store the result in #REGh.
 $75B5 EX AF,AF'     ; Switch back to the saved pixel row.
 $75B6 OR H          ; Combine with the third of the screen.
 $75B7 LD H,A        ; Store the result in #REGh.
 $75B8 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9BA2 }
; { #COOKIE$76E3 }
; { #JETPAC$7308 }
; { #LUNARJETMAN$851E }
; { #MARTIANOIDS$BD4B }
; { #SABREWULF$B8AD }
; { #TRANZAM$6F10 }
; { #UNDERWURLDE$ADF8 }
; LIST#

; Store Entity
;
; Used by the routines at #R$64ED, #R$65F7, #R$66A6, #R$698F, #R$69E8, #R$6BD0,
; #R$6C53, #R$6D0C, #R$6DBA, #R$6ED2, #R$6EF1 and #R$721A.
; .
; Saves the position and state of an object, so that its sprite can be
; erased from the old position when it is next drawn.
;
; IX Object
@label=StoreEntity
c$75B9 LD A,(IX+$01) ; {Save the object's X position in #R$5E0B.
 $75BC LD ($5E0B),A  ; }
 $75BF LD A,(IX+$02) ; {Save the object's Y position in #R$5E0C.
 $75C2 LD ($5E0C),A  ; }
 $75C5 LD A,(IX+$00) ; {Save the object's state in #R$5E0D.
 $75C8 LD ($5E0D),A  ; }
 $75CB RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9FFB }
; { #JETPAC$7327 }
; { #SABREWULF$BB0B }
; { #TRANZAM$71ED }
; { #UNDERWURLDE$989F }
; LIST#

; Controls: Kempston Joystick
;
; Used by the routine at #R$6D9C.
; .
; Reads the Kempston joystick port. The bits are inverted so that a
; pressed direction or fire button reads as a clear bit, in the same way as
; the keyboard controls.
;
; O:A Joystick controls
@label=ReadKempstonJoystick
c$75CC IN A,($1F)    ; Read the joystick from the Kempston port.
 $75CE CPL           ; Flip the bits.
 $75CF RET           ; Return.
; View the equivalent code in;
; #LIST
; { #JETPAC$733A }
; { #LUNARJETMAN$8F9B }
; { #SABREWULF$B0D9 }
; LIST#

; Draw Sprite Rows
;
; Used by the routines at #R$74A5 and #R$751C.
; .
; Erases the previous sprite and draws the new one, one pixel row at a
; time, working up the screen from the bottom row. The main registers hold the
; previous sprite and the shadow registers hold the new sprite. A row of the
; previous sprite is cleared by ANDing the screen with the inverted sprite
; data. A row of the new sprite is ORed onto the screen.
; .
; The first pass handles the rows where only one of the two sprites has any
; data. The heights at #R$5E10 and #R$5E11 then give the rows both sprites
; have in common, which are done on the second pass.
;
; B Sprite width in bytes
; C Number of rows left to process
; DE Address into a sprite
; HL Address in the screen buffer
@label=MaskSprite
c$75D0 LD A,C        ; #REGa=the number of rows left of the previous sprite.
 $75D1 AND A         ; Set the flags.
 $75D2 JR Z,$75FB    ; Jump to #R$75FB if there are no more rows of the
                     ; previous sprite.
 $75D4 DEC C         ; Decrease the row counter by one.
 $75D5 PUSH BC       ; {Stash the counter and the screen address on the stack.
 $75D6 PUSH HL       ; }
; Clear one row of the previous sprite from the screen.
@label=MaskSprite_Erase
*$75D7 LD A,(DE)     ; Fetch a byte of the sprite.
 $75D8 CPL           ; Invert it.
 $75D9 AND (HL)      ; Remove the sprite pixels from the screen.
 $75DA LD (HL),A     ; Write the result back to the screen.
 $75DB INC DE        ; Move onto the next byte of the sprite.
 $75DC INC L         ; Move onto the next column.
 $75DD DJNZ $75D7    ; Decrease the width counter by one and loop back to #R$75D7 until the
                     ; whole row of the sprite has been erased.
 $75DF POP HL        ; Restore the screen address from the stack.
 $75E0 CALL $7585    ; Move up one pixel row.
 $75E3 POP BC        ; Restore the counter from the stack.
; Switch to the new sprite.
@label=MaskSprite_Draw
 $75E4 EXX           ; Switch to the shadow registers.
 $75E5 LD A,C        ; #REGa=the number of rows left of the new sprite.
 $75E6 AND A         ; Set the flags.
 $75E7 JR Z,$75F8    ; Jump to #R$75F8 if there are no more rows of the new
                     ; sprite.
@label=MaskSprite_Draw_Row
*$75E9 DEC C         ; Decrease the row counter by one.
 $75EA PUSH BC       ; {Stash the counter and the screen address on the stack.
 $75EB PUSH HL       ; }
; Draw one row of the new sprite onto the screen.
@label=MaskSprite_Draw_Loop
*$75EC LD A,(DE)     ; Fetch a byte of the sprite.
 $75ED OR (HL)       ; Combine it with the screen.
 $75EE LD (HL),A     ; Write the result back to the screen.
 $75EF INC DE        ; Move onto the next byte of the sprite.
 $75F0 INC L         ; Move onto the next column.
 $75F1 DJNZ $75EC    ; Decrease the width counter by one and loop back to #R$75EC until the
                     ; whole row of the sprite has been drawn.
 $75F3 POP HL        ; Restore the screen address from the stack.
 $75F4 CALL $7585    ; Move up one pixel row.
 $75F7 POP BC        ; Restore the counter from the stack.
@label=MaskSprite_Next
*$75F8 EXX           ; Switch back to the previous sprite.
 $75F9 JR $75D0      ; Jump back to #R$75D0 to do the next pair of rows.
; There are no more rows of the previous sprite, so only the new sprite
; is left to draw.
@label=MaskSprite_NewOnly
*$75FB EXX           ; Switch to the new sprite.
 $75FC LD A,C        ; #REGa=the number of rows left of the new sprite.
 $75FD AND A         ; Set the flags.
 $75FE JR NZ,$75E9   ; Jump to #R$75E9 if there are rows to draw.
; This entry point is used by the routine at #R$74A5.
; .
; Both sprites have been drawn as far as their rows go.
@label=MaskSprite_Finish
*$7600 EXX           ; Switch back to the previous sprite.
; This entry point is used by the routine at #R$74A5.
@label=MaskSprite_Finish_Previous
*$7601 LD A,($5E10)  ; {Fetch the remaining row count of the previous sprite from #R$5E10
 $7604 LD C,A        ; and keep it in #REGc.}
 $7605 LD A,($5E11)  ; Fetch the remaining row count of the new sprite from
                     ; #R$5E11.
 $7608 OR C          ; Combine them.
 $7609 RET Z         ; Return if there are no rows left on either sprite.
 $760A XOR A         ; {Clear #R$5E10 so that it is only used once.
 $760B LD ($5E10),A  ; }
 $760E EXX           ; Switch to the new sprite.
 $760F LD A,($5E11)  ; {Fetch the remaining row count from #R$5E11 and keep the remaining
 $7612 LD C,A        ; row count of the new sprite in #REGc.}
 $7613 XOR A         ; #REGa=#N$00.
; This entry point is used by the routine at #R$74A5.
@label=MaskSprite_Finish_ClearNew
*$7614 LD ($5E11),A  ; Write #N$00 to #R$5E11 so that it is only used once.
 $7617 EXX           ; Switch back to the previous sprite.
 $7618 JR $75D0      ; Jump to #R$75D0 to process the rows both sprites have.

; Sprite Table
;
; The addresses of the sprites for each object type, which are found by
; #R$7542 and #R$757A. Types #N$01-#N$03 (Robbie and the spray can) have eight
; words each. The first four are for the X position within a character cell
; (bits 1-2) when bit 6 of the state is clear. The second four are for when bit
; 6 is set, and have the same four images in the reverse order. Types #N$01
; and #N$02 (Robbie) share the same images.
; .
; Types #N$04-#N$0D (from #R$764A: smoke bombs, a slug, repellent, midges, a
; leech and the bonus items) have four words each. Bit 2 of the X position
; gives the first or the second image of a pair, and then the same pair is used
; again when bit 6 of the state is set (or a different pair for the slug,
; repellent and leech).
@label=SpritesTable
w$761A DEFW $778A    ; Sprite ID:
                     ; #R(#PEEK(#PC)+#PEEK(#PC+$01)*$100)(#N((#PC-$761A)/$02)).
 $761C DEFW $77C6    ; Sprite ID:
                     ; #R(#PEEK(#PC)+#PEEK(#PC+$01)*$100)(#N((#PC-$761A)/$02)).
 $761E DEFW $7802    ; Sprite ID:
