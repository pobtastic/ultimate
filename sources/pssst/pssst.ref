;
; SkoolKit ref file for PSSST
;
; To build the HTML disassembly, run these commands:
;   tap2sna.py @pssst.t2s
;   sna2skool.py -H -c sources/pssst/pssst.ctl Pssst.z80 > sources/pssst/pssst.skool
;   skool2html.py -H sources/pssst/pssst.skool -T dark -T wide -toOa

[Config]
Expand=#INCLUDE(Expand)
RefFiles=../analytics.ref;../bases.ref;changelog.ref;data.ref;pokes.ref;pssstGraphics.ref;sounds.ref
HtmlWriterClass=sources:linking.UltimateHtmlWriter
GameDir=ultimate/pssst

[Game]
Game=PSSST
Logo=#SCR$01,$00,$10,$12,$06,$4000,$5800(/images/ultimate) #SCR$01,$00,$02,$13,$0D,$4000,$5800(/images/logo)
Copyright=&copy; 1983 Ashby Computers &amp; Graphics Ltd<br />&copy; Rare Ltd<br />&copy; 2026 ArcadeGeek LTD.
Repository=https://github.com/pobtastic/ultimate/tree/main/sources/pssst/
StyleSheet=skoolkit.css;skoolkit-dark.css;skoolkit-wide.css;pssst.css
LinkInternalOperands=1
AddressAnchor={address#IF({base}==16)(:04x)}

[PageHeaders]
GameIndex=The complete <> RAM disassembly (work in progress)

[Index]
MemoryMaps
Graphics
DataTables
Reference

[Index:Graphics:Graphics And Sounds]
Player
Weapons
Plant
Items
Pests
Sound

[Index:Reference:Reference]
Changelog
Glossary
Facts
Bugs
Pokes
Credits

[Links]
Player=[Player]
Weapons=[Weapons]
Plant=[Plant]
Items=[Items]
Pests=[Pests]

[Paths]
Credits=reference/credits.html
Items=graphics/items.html
Pests=graphics/pests.html
Plant=graphics/plant.html
Player=graphics/player.html
Sound=sound/sounds.html
Weapons=graphics/weapons.html

[Page:Items]
SectionPrefix=Items

[Page:Pests]
SectionPrefix=Pests

[Page:Plant]
SectionPrefix=Plant

[Page:Player]
SectionPrefix=Player

[Page:Sound]
SectionPrefix=Audio

[Page:Weapons]
SectionPrefix=Weapons

[Page:Credits]
PageContent=#INCLUDE(Credits)

[Credits]
<div class="box box-1">
  This disassembly would have taken a lot longer to finish if it weren't for the
  research and documentation already done and made available by:
#LIST
  { <a href="https://mrcook.uk/">Michael R. Cook</a> }
LIST#
  This game shares a lot of functionality with Jetpac, hence his disassembly was
  invaluable!
</div>

[Expand]
#DEF(#NOCROP(addr,size,attr)(fname) #UDGARRAY($size,attr=$attr,scale=4,step=$size,flip=2)(($addr)-($addr+(((({height}+$07)/$08)*$08)*$size)-$01)-$01-($size*$08))($fname))

#DEF(#CROP(addr,size,attr)(fname) #UDGARRAY($size,attr=$attr,scale=4,step=$size,flip=2)(($addr)-($addr+(((({height}+$07)/$08)*$08)*$size)-$01)-$01-($size*$08)){$00,$04*($08-({height}%$08)),$04*$size*$08,$04*{height}}($fname))

#DEF(#SPRITE(addr,attr=$07)(fname)
  #LET(width=#PEEK($addr+$01))
  #LET(height=#PEEK($addr+$02))
  #IF({height}%$08)(
    #CROP($addr+$03,{width},$attr)($fname),
    #NOCROP($addr+$03,{width},$attr)($fname)
  )
)

#DEF(#CONVERTFF(addr)
  #LET(length=#PEEK($addr) * #PEEK($addr + $01))
  #FOR($00,{length})||n|
    #IF(#PEEK($02 + $addr + n) == $FF)(#POKES(($02 + $addr + n), $47))
  ||
)
