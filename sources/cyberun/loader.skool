i$4000

@org=$6000
@start=$6000
@remote=main:$5C80

; Copy Loader
;
; The helper that the BASIC loader runs at #N$6000. It copies the move
; routine to #N$FC00, the decrypt stub to #N$5B80, and the loading screen to
; #N$4000, then returns so that BASIC can load the encrypted game to #N$5E80.
;
; .
;
; Copy the routine that moves the game down.
@label=Copy_Loader
c$6000 LD HL,$6022   ; {Copy #N$10 bytes from #R$6022 to #N$FC00.
 $6003 LD DE,$FC00   ;
 $6006 LD BC,$0010   ;
 $6009 LDIR          ; }
; Copy the decrypt stub.
 $600B LD HL,$602E   ; {Copy #N$20 bytes from #R$602E to #N$5B80.
 $600E LD DE,$5B80   ;
 $6011 LD BC,$0020   ;
 $6014 LDIR          ; }
; Copy the loading screen.
 $6016 LD HL,$6047   ; {Copy #N$1B00 bytes from #R$6047 to #N$4000.
 $6019 LD DE,$4000   ;
 $601C LD BC,$1B00   ;
 $601F LDIR          ; }
 $6021 RET           ; Return.

; Copy Game Down
;
; Copied to #N$FC00 by #R$6000 and then called from #R$602E. Moves the
; encrypted game from #N$5E80 down to #N$5C80, stopping short of this routine.
@label=Copy_Game_Down
c$6022 LD HL,$5E80   ; {Copy #N$9D80 bytes from #N$5E80 to #N$5C80.
 $6025 LD DE,$5C80   ;
 $6028 LD BC,$9D80   ;
 $602B LDIR          ; }
 $602D RET           ; Return.

; Decrypt Game
;
; Copied to #N$5B80 by #R$6000. After the game has been loaded to
; #N$5E80, this moves it down and decrypts it from the top with RRD, then
; starts the game at #R$5C80@main(StartGame).
;
; .
;
; Set up the stack and move the game down into place.
@label=Decrypt_Game
c$602E LD SP,$FE00   ; Set the stack pointer to #N$FE00.
 $6031 DI            ; Disable interrupts.
 $6032 CALL $FC00    ; Call #N$FC00 to move the game down to #N$5C80.
; Decrypt every byte from #N$FA00 down to #N$5C01.
 $6035 LD HL,$FA00   ; Set the start address in #REGhl to #N$FA00.
 $6038 XOR A         ; Clear the nibble carried between bytes in #REGa.
 $6039 LD BC,$9E00   ; Set the byte count in #REGbc to #N$9E00.
; Start rotating each byte through #REGa to decrypt it.
@label=Decrypt_Game_Loop
*$603C RRD           ; Rotate the nibbles of the current byte through #REGa.
 $603E DEC HL        ; Move down to the previous byte.
 $603F DEC C         ; {Decrease the low byte of the counter by one and loop back to
 $6040 JR NZ,$603C   ; #R$603C until none remain.}
 $6042 DJNZ $603C    ; Decrease the high byte of the counter by one and loop back to
                     ; #R$603C until every byte has been decrypted.
 $6044 JP $5C80      ; Jump to #R$5C80@main(StartGame).

