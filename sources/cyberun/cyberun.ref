[Page:Map]
JavaScript=openseadragon.min.js;planet-map.js
PageContent=#INCLUDE(PlanetMap)

[Page:Sound]
SectionPrefix=Audio

[PlanetMap]
<p>
The map of the world is stored at #R$61BC. It is #N$60 tiles wide and
#N$1C tiles high, row by row from the top. Tile #N$00 is blank sky.
The other tiles are the ground, coloured by their number.
</p>
<p>
The dots mark the objects from #R$5E17. Their column is taken from
#R$5DB6 and their row from the second byte of each pair. Yellow dots
are empty slots; magenta dots are the kinds listed at #R$E0FD. Drag
to move, and use the mouse wheel or pinch to zoom.
</p>
#HTML(<div class="planet-map-viewer" id="planet-map-viewer"></div>)
<p class="planet-map-hint">Drag to move. Scroll or pinch to zoom.</p>

[Expand]
#DEF(#NOCROP(a,s,c)(f)
  #LET(e=$a+(((({height}+$07)/$08)*$08)*$s)-$01)
  #LET(r=$s*$08)
  #UDGARRAY($s,$c,4,$s,0,2)(($a)-({e})-$01-({r}))($f)
)

#DEF(#CROP(a,s,c)(f)
  #LET(e=$a+(((({height}+$07)/$08)*$08)*$s)-$01)
  #LET(r=$s*$08)
  #LET(y=$04*($08-({height}%$08)))
  #LET(w=$04*$s*$08)
  #LET(h=$04*{height})
  #UDGARRAY($s,$c,4,$s,0,2)(($a)-({e})-$01-({r})){$00,{y},{w},{h}}($f)
)

#DEF(#SPRITE(sp,attr=$07)(fname)
  #LET(width=#PEEK($sp))
  #LET(height=#PEEK($sp+$01))
  #IF({height}%$08)(
    #CROP($sp+$02,{width},$attr)($fname),
    #NOCROP($sp+$02,{width},$attr)($fname)
  )
)

#DEF(#SPRITEDATA()(fname)
  #LET(width=#PEEK(#PC-$02))
  #LET(height=#PEEK(#PC-$01))
  #IF({height}%$08)(
    #CROP(#PC,{width},$07)($fname),
    #NOCROP(#PC,{width},$07)($fname)
  )
)
