;
; SkoolKit ref file for Cyberun
;
; To build the HTML disassembly, run these commands:
;   tap2sna.py @cyberun.t2s
;   tap2sna.py @cyberun-loader.t2s
;   sna2skool.py -H -c sources/cyberun/cyberun.ctl Cyberun.z80 > sources/cyberun/cyberun.skool
;   sna2skool.py -H -c sources/cyberun/loader.ctl CyberunLoader.z80 > sources/cyberun/loader.skool
;   skool2html.py -H sources/cyberun/cyberun.skool -T dark -T wide -toOa

[Config]
Expand=#INCLUDE(Expand)
RefFiles=../analytics.ref;../bases.ref;changelog.ref;data.ref;pokes.ref;sounds.ref;cyberunGraphics.ref
HtmlWriterClass=sources:linking.UltimateHtmlWriter
GameDir=ultimate/cyberun

[Game]
Game=Cyberun
Logo=#SCR$01,$02,$00,$1C,$06,$4000,$5800(/images/logo)
Copyright=&copy; 1985 Ashby Computers &amp; Graphics Ltd<br />&copy; Rare Ltd<br />&copy; 2026 ArcadeGeek LTD.
Repository=https://github.com/pobtastic/ultimate/tree/main/sources/cyberun/
Canonical=https://skoolkit.arcadegeek.co.uk/ultimate/cyberun/
GameIndexUrl=https://skoolkit.arcadegeek.co.uk/ultimate/cyberun/
OgImage=https://skoolkit.arcadegeek.co.uk/ultimate/cyberun/images/logo.png
StyleSheet=skoolkit.css;skoolkit-dark.css;skoolkit-wide.css;cyberun.css
LinkInternalOperands=1
AddressAnchor={address#IF({base}==16)(:04x)}

[Titles]
loader-Index=Loading Code

[OtherCode:loader]

[PageHeaders]
