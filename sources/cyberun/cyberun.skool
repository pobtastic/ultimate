 $AFE7 DEFW $F793

; Build Ship
;
; Used by the routines at #R$C374 and #R$DCA1.
; .
; Builds the graphic of the ship from the parts that have been fitted.
; Copies the base of the ship to #R$F755 and adds each of the nine parts that
; are flagged at #R$F5EE with #R$B09C. Then works out the height of the ship
; from the parts, the position of the buffer to draw it from and the vertical
; position of the ship.
@label=BuildShip
c$AFE9 LD A,($F5EE)  ; The number stored for the first part.
 $AFEC ADD A,A       ; Double that number.
 $AFED LD ($F5EF),A  ; Use the double as the second part's number.
 $AFF0 LD A,$02      ; Both scroll limits start at two.
 $AFF2 LD ($5C3E),A  ; The horizontal limit.
 $AFF5 LD ($5C3F),A  ; The vertical limit.
 $AFF8 LD BC,$0054   ; The base graphic is #N($54) bytes.
 $AFFB LD DE,$F755   ; The ship graphic is built at #R$F755.
 $AFFE LD HL,$C891   ; The base graphic is at #R$C891.
 $B001 LDIR          ; Copy the base graphic into the buffer.
 $B003 LD IX,$F5EE   ; The nine part flags start at #R$F5EE.
 $B007 LD A,$0E      ; The ship starts #N($0E) rows tall.
 $B009 LD ($C1A9),A  ; That height.
 $B00C LD B,$09      ; Nine parts.
@label=BuildShip_Loop
*$B00E PUSH BC       ; Keep the part count.
 $B00F LD A,(IX+$00) ; This part's number.
 $B012 AND A         ; {Add the part when a number is stored.
 $B013 CALL NZ,$B09C ; }
 $B016 INC IX        ; The next part flag.
 $B018 POP BC        ; Back to the part count.
 $B019 DJNZ $B00E    ; Repeat for all nine parts.
 $B01B LD A,($C1A9)  ; The height of the ship.
 $B01E LD B,A        ; #REGb=#REGa.
 $B01F LD A,$28      ; #REGa=#N$28.
 $B021 SUB B         ; Subtract #REGb from #REGa.
 $B022 ADD A,A       ; Double #REGa.
 $B023 LD E,A        ; #REGe=#REGa.
 $B024 ADD A,A       ; Double #REGa.
 $B025 ADD A,E       ; #REGa gains #REGe.
 $B026 LD E,A        ; #REGe=#REGa.
 $B027 LD D,$00      ; Clear #REGd.
 $B029 LD HL,$F6B9   ; The ship work area.
 $B02C ADD HL,DE     ; #REGhl gains #REGde.
 $B02D LD ($C1AA),HL ; Update the ship buffer address.
 $B030 LD A,($C903)  ; The row the ship was drawn on.
 $B033 LD B,A        ; #REGb=#REGa.
 $B034 LD A,($C1A9)  ; The height of the ship.
 $B037 SUB $0E       ; Subtract #N$0E from #REGa.
 $B039 ADD A,$6F     ; Add #N$6F to #REGa.
 $B03B OR %00000111  ; Set the bits of #REGa that are set in #N$07.
 $B03D LD ($C903),A  ; Update the row the ship was drawn on.
 $B040 SUB B         ; Subtract #REGb from #REGa.
 $B041 LD ($C8EE),A  ; Update the high byte of the ship's vertical speed.
 $B044 LD IX,$C8E5   ; The ship.
 $B048 CALL $B9BB    ; Call #R$B9BB.
 $B04B LD (IX+$04),H ; Write #REGh to offset #N$04 of #REGix.
 $B04E LD (IX+$05),L ; Write #REGl to offset #N$05 of #REGix.
 $B051 CALL $B9EC    ; Call #R$B9EC.
 $B054 LD A,($C1A9)  ; The height of the ship.
 $B057 LD B,A        ; #REGb=#REGa.
 $B058 LD A,(IX+$1E) ; Read offset #N$1E of #REGix.
 $B05B SUB B         ; Subtract #REGb from #REGa.
 $B05C ADD A,$09     ; Add #N$09 to #REGa.
 $B05E LD ($5C38),A  ; Update the ship row.
 $B061 LD A,($F5F1)  ; The flag at #R$F5F1.
 $B064 AND A         ; {Leave the horizontal limit at two when it is clear.
 $B065 JR Z,$B06C    ; }
 $B067 LD A,$04      ; A fitted part raises the limit to four.
 $B069 LD ($5C3E),A  ; The horizontal limit.
@label=BuildShip_Limit
*$B06C LD A,($F5F2)  ; The flag at #R$F5F2.
 $B06F AND A         ; {Leave the vertical limit at two when it is clear.
 $B070 JR Z,$B077    ; }
 $B072 LD A,$04      ; A fitted part raises the limit to four.
 $B074 LD ($5C3F),A  ; The vertical limit.
@label=BuildShip_Carried
*$B077 LD A,($F601)  ; The carried item.
 $B07A INC A         ; Advance #REGa.
 $B07B JR Z,$B08A    ; Jump to #R$B08A if the zero flag is set.
 $B07D DEC A         ; Step #REGa back.
 $B07E OR %11000000  ; Set the bits of #REGa that are set in #N$C0.
 $B080 LD ($C904),A  ; Update the item the ship is about to pick up.
 $B083 CALL $AA94    ; Call #R$AA94.
 $B086 XOR A         ; Clear #REGa.
 $B087 LD ($C904),A  ; Update the item the ship is about to pick up.
@label=BuildShip_Last
*$B08A LD A,($F5F6)  ; The ninth part flag.
 $B08D AND A         ; {Jump to #R$A8D9 if #REGa is zero.
 $B08E JP Z,$A8D9    ; }
 $B091 LD A,($C1A9)  ; The height of the ship.
 $B094 ADD A,$0B     ; Add #N$0B to #REGa.
 $B096 LD ($C1A9),A  ; Update the height of the ship.
 $B099 JP $A8D9      ; Jump to #R$A8D9.

; Add Ship Part
;
; Used by the routine at #R$AFE9.
; .
; Adds one part to the graphic of the ship. The sprite of the part is
; found in the table at #R$AF95 and the place in the graphic where it goes in
; the table at #R$AFD7. The height of the ship is made at least as tall as the
; part. The mask of the part is ANDed into the graphic, one row at a time,
; then its picture is ORed in.
;
; IX Address of the flag for the part, which is the number of the part
@label=AddShipPart
c$B09C LD HL,$AF95   ; The ship-part sprites.
 $B09F LD C,(IX+$00) ; Read offset #N$00 of #REGix into #REGc.
 $B0A2 DEC C         ; Step #REGc back.
 $B0A3 CALL $A1AA    ; Call #R$A1AA.
 $B0A6 EX DE,HL      ; Swap #REGde and #REGhl.
 $B0A7 PUSH DE       ; Stash #REGde on the stack.
 $B0A8 LD A,(IX+$00) ; Read offset #N$00 of #REGix.
 $B0AB LD C,A        ; #REGc=#REGa.
 $B0AC DEC C         ; Step #REGc back.
 $B0AD LD HL,$AFD7   ; The positions of the ship parts.
 $B0B0 CALL $A1AA    ; Call #R$A1AA.
 $B0B3 POP DE        ; Bring #REGde back off the stack.
 $B0B4 PUSH DE       ; Stash #REGde on the stack.
 $B0B5 PUSH HL       ; Stash #REGhl on the stack.
 $B0B6 DEC DE        ; Step #REGde back.
 $B0B7 LD A,(DE)     ; Read #REGde.
 $B0B8 INC DE        ; Advance #REGde.
 $B0B9 LD B,A        ; #REGb=#REGa.
 $B0BA LD A,($C1A9)  ; The height of the ship.
 $B0BD CP B          ; {Jump to #R$B0C4 if #REGa is #REGb or more.
 $B0BE JR NC,$B0C4   ; }
 $B0C0 LD A,B        ; #REGa=#REGb.
 $B0C1 LD ($C1A9),A  ; Update the height of the ship.
@label=AddShipPart_Picture2
*$B0C4 LD A,(DE)     ; Read #REGde.
 $B0C5 LD B,A        ; #REGb=#REGa.
 $B0C6 EX AF,AF'     ; Switch to the alternate accumulator and flags.
 $B0C7 INC DE        ; Advance #REGde.
 $B0C8 LD A,(DE)     ; Read #REGde.
 $B0C9 LD ($5C1D),A  ; The height of the part.
 $B0CC INC DE        ; Advance #REGde.
 $B0CD LD C,A        ; #REGc=#REGa.
 $B0CE XOR A         ; Clear #REGa.
@label=AddShipPart_Multiply
*$B0CF ADD A,C       ; #REGa gains #REGc.
 $B0D0 DJNZ $B0CF    ; Decrease #REGb and jump to #R$B0CF until none remain.
 $B0D2 LD C,A        ; #REGc=#REGa.
 $B0D3 EX DE,HL      ; Swap #REGde and #REGhl.
 $B0D4 ADD HL,BC     ; #REGhl gains #REGbc.
 $B0D5 EX DE,HL      ; Swap #REGde and #REGhl.
 $B0D6 LD A,(DE)     ; Read #REGde.
 $B0D7 CP $FF        ; {Jump to #R$B0F8 if #REGa is #N$FF.
 $B0D9 JR Z,$B0F8    ; }
 $B0DB EX AF,AF'     ; Switch to the alternate accumulator and flags.
 $B0DC LD B,A        ; #REGb=#REGa.
 $B0DD LD A,($5C1D)  ; The height of the part.
 $B0E0 EX AF,AF'     ; Switch to the alternate accumulator and flags.
 $B0E1 LD C,B        ; #REGc=#REGb.
 $B0E2 JR $B0E5      ; Jump to #R$B0E5.
@label=AddShipPart_Mask
*$B0E4 EX AF,AF'     ; Switch to the alternate accumulator and flags.
@label=AddShipPart_Row2
*$B0E5 LD B,C        ; #REGb=#REGc.
 $B0E6 PUSH HL       ; Stash #REGhl on the stack.
@label=AddShipPart_Erase
*$B0E7 LD A,(DE)     ; Read #REGde.
 $B0E8 AND (HL)      ; Keep the bits of #REGa that are set in the byte at
                     ; #REGhl.
 $B0E9 LD (HL),A     ; Write #REGa where #REGhl points.
 $B0EA INC DE        ; Advance #REGde.
 $B0EB INC HL        ; Advance #REGhl.
 $B0EC DJNZ $B0E7    ; Decrease #REGb and jump to #R$B0E7 until none remain.
 $B0EE POP HL        ; Bring #REGhl back off the stack.
 $B0EF LD A,$06      ; #REGa=#N$06.
 $B0F1 CALL $9BCF    ; Call #R$9BCF.
 $B0F4 EX AF,AF'     ; Switch to the alternate accumulator and flags.
 $B0F5 DEC A         ; Step #REGa back.
 $B0F6 JR NZ,$B0E4   ; Jump to #R$B0E4 if the zero flag is clear.
@label=AddShipPart_Picture
*$B0F8 POP HL        ; Bring #REGhl back off the stack.
 $B0F9 POP DE        ; Bring #REGde back off the stack.
 $B0FA LD A,(DE)     ; Read #REGde.
 $B0FB LD B,A        ; #REGb=#REGa.
 $B0FC LD C,A        ; #REGc=#REGa.
 $B0FD INC DE        ; Advance #REGde.
 $B0FE LD A,(DE)     ; Read #REGde.
 $B0FF INC DE        ; Advance #REGde.
@label=AddShipPart_Row
*$B100 EX AF,AF'     ; Switch to the alternate accumulator and flags.
 $B101 LD B,C        ; #REGb=#REGc.
 $B102 PUSH HL       ; Stash #REGhl on the stack.
@label=AddShipPart_Draw
*$B103 LD A,(DE)     ; Read #REGde.
 $B104 OR (HL)       ; Set the bits of #REGa that are set in the byte at
                     ; #REGhl.
 $B105 LD (HL),A     ; Write #REGa where #REGhl points.
 $B106 INC DE        ; Advance #REGde.
 $B107 INC HL        ; Advance #REGhl.
 $B108 DJNZ $B103    ; Decrease #REGb and jump to #R$B103 until none remain.
 $B10A POP HL        ; Bring #REGhl back off the stack.
 $B10B LD A,$06      ; #REGa=#N$06.
 $B10D CALL $9BCF    ; Call #R$9BCF.
 $B110 EX AF,AF'     ; Switch to the alternate accumulator and flags.
 $B111 DEC A         ; Step #REGa back.
 $B112 JR NZ,$B100   ; Jump to #R$B100 if the zero flag is clear.
 $B114 RET           ; Return.

; Read Controls
;
; Used by the routine at #R$B234.
; .
; Reads the controls and keeps what is pressed at #R$5C37 (bit 0 is
; right, bit 1 is left, bit 3 is up, bit 4 is fire and bit 5 is the extra
; key). Up is ignored in one place near the start of the planet, and only
; fire and the extra key are used while the special shot is out. Moving uses
; fuel, which is worked out here and taken off by #R$CC4D: more for going up
; and sideways together, and half as much if part #N$06 is fitted or the
; value at #R$5C40 is not zero.
@label=ReadControls
c$B115 CALL $B16F    ; Call #R$B16F.
 $B118 LD B,$00      ; Clear #REGb.
 $B11A LD A,($F5F2)  ; The fifth part flag.
 $B11D AND A         ; {Jump to #R$B122 if #REGa is not zero.
 $B11E JR NZ,$B122   ; }
 $B120 LD B,$05      ; #REGb=#N$05.
@label=ReadControls_Zone
*$B122 LD A,($CE58)  ; The map row.
 $B125 CP B          ; {Jump to #R$B133 if #REGa is not #REGb.
 $B126 JR NZ,$B133   ; }
 $B128 LD A,($CE46)  ; The position down.
 $B12B CP $60        ; {Jump to #R$B133 if #REGa is #N$60 or more.
 $B12D JR NC,$B133   ; }
 $B12F LD A,C        ; #REGa=#REGc.
 $B130 AND %11110111 ; Keep the bits of #REGa that are set in #N$F7.
 $B132 LD C,A        ; #REGc=#REGa.
@label=ReadControls_Special
*$B133 LD A,($B832)  ; The special-shot flag.
 $B136 AND A         ; {Jump to #R$B13D if #REGa is zero.
 $B137 JR Z,$B13D    ; }
 $B139 LD A,C        ; #REGa=#REGc.
 $B13A AND %00110000 ; Keep the bits of #REGa that are set in #N$30.
 $B13C LD C,A        ; #REGc=#REGa.
@label=ReadControls_Store
*$B13D LD A,($96AB)  ; The crystal-delivery flag.
 $B140 AND A         ; {Return if #REGa is not zero.
 $B141 RET NZ        ; }
 $B142 LD A,C        ; #REGa=#REGc.
 $B143 LD ($5C37),A  ; Update the controls.
 $B146 AND %00001011 ; Keep the bits of #REGa that are set in #N$0B.
 $B148 RET Z         ; Return if the zero flag is set.
 $B149 LD DE,$0008   ; #REGde=#N$08.
 $B14C BIT 3,A       ; {Jump to #R$B157 if bit 3 of #REGa is clear.
 $B14E JR Z,$B157    ; }
 $B150 AND %00000011 ; Keep the bits of #REGa that are set in #N$03.
 $B152 JR Z,$B157    ; Jump to #R$B157 if the zero flag is set.
 $B154 LD DE,$0010   ; #REGde=#N$10.
@label=ReadControls_Part
*$B157 LD A,($F5F3)  ; The sixth part, which halves the fuel.
 $B15A AND A         ; {Jump to #R$B161 if #REGa is zero.
 $B15B JR Z,$B161    ; }
 $B15D SRA D         ; Shift #REGd right keeping the sign.
 $B15F RR E          ; Rotate #REGe right through the carry.
@label=ReadControls_Use
*$B161 LD A,($5C40)  ; The ship was just hit.
 $B164 AND A         ; {Jump to #R$CC4D if #REGa is zero.
 $B165 JP Z,$CC4D    ; }
 $B168 SRA D         ; Shift #REGd right keeping the sign.
 $B16A RR E          ; Rotate #REGe right through the carry.
 $B16C JP $CC4D      ; Jump to #R$CC4D.

; Read Input Device
;
; Used by the routine at #R$B115.
; .
; Reads the device that was chosen on the title screen: the keyboard
; (#N$00), a Kempston joystick (#N$01), a Cursor joystick (#N$02) or a Sinclair
; Interface 2 joystick (#N$03). The result is in the same layout for all of
; them. The keyboard has no joystick, so the keys of the middle two rows are
; all for up, the top row is for fire, the number keys are for the extra key,
; and the keys of the bottom row alternate between right and left.
;
; O:C Controls: bit 0 is right, bit 1 left, bit 3 up, bit 4 fire and bit 5 the
; .   extra key
@label=ReadInputDevice
c$B16F LD A,($F603)  ; The control device.
 $B172 AND A         ; {Jump to #R$B1D2 if #REGa is zero.
 $B173 JP Z,$B1D2    ; }
 $B176 CP $01        ; {Jump to #R$B180 if #REGa is #N$01.
 $B178 JR Z,$B180    ; }
 $B17A CP $02        ; {Jump to #R$B1A6 if #REGa is #N$02.
 $B17C JR Z,$B1A6    ; }
 $B17E JR $B188      ; Jump to #R$B188.
@label=ReadInputDevice_Kempston
*$B180 IN A,($1F)    ; Read port #N$1F.
 $B182 AND %00011111 ; Keep the bits of #REGa that are set in #N$1F.
 $B184 LD C,A        ; #REGc=#REGa.
 $B185 JP $B226      ; Jump to #R$B226.
@label=ReadInputDevice_Interface2
*$B188 LD A,$EF      ; #REGa=#N$EF.
 $B18A OUT ($FD),A   ; Send #REGa to port #N$FD.
 $B18C IN A,($FE)    ; Read port #N$FE.
 $B18E LD B,$FF      ; #REGb=#N$FF.
 $B190 RRA           ; Rotate #REGa right.
 $B191 RL B          ; Rotate #REGb left through the carry.
 $B193 RRA           ; Rotate #REGa right.
 $B194 RL B          ; Rotate #REGb left through the carry.
 $B196 RRA           ; Rotate #REGa right.
 $B197 RL B          ; Rotate #REGb left through the carry.
 $B199 RRA           ; Rotate #REGa right.
 $B19A RRA           ; Rotate #REGa right.
 $B19B RL B          ; Rotate #REGb left through the carry.
 $B19D RLA           ; Rotate #REGa left.
 $B19E RL B          ; Rotate #REGb left through the carry.
 $B1A0 LD A,B        ; #REGa=#REGb.
 $B1A1 CPL           ; Invert #REGa.
 $B1A2 LD C,A        ; #REGc=#REGa.
 $B1A3 JP $B226      ; Jump to #R$B226.
@label=ReadInputDevice_Cursor
*$B1A6 LD A,$EF      ; #REGa=#N$EF.
 $B1A8 OUT ($FD),A   ; Send #REGa to port #N$FD.
 $B1AA IN A,($FE)    ; Read port #N$FE.
 $B1AC OR %11100000  ; Set the bits of #REGa that are set in #N$E0.
 $B1AE LD B,A        ; #REGb=#REGa.
 $B1AF AND %00001000 ; Keep the bits of #REGa that are set in #N$08.
 $B1B1 LD C,A        ; #REGc=#REGa.
 $B1B2 LD A,B        ; #REGa=#REGb.
 $B1B3 RRCA          ; Rotate #REGa right.
 $B1B4 RRCA          ; Rotate #REGa right.
 $B1B5 LD B,A        ; #REGb=#REGa.
 $B1B6 AND %00000101 ; Keep the bits of #REGa that are set in #N$05.
 $B1B8 OR C          ; Set the bits of #REGa that are set in #REGc.
 $B1B9 LD C,A        ; #REGc=#REGa.
 $B1BA LD A,B        ; #REGa=#REGb.
 $B1BB RRA           ; Rotate #REGa right.
 $B1BC RRA           ; Rotate #REGa right.
 $B1BD AND %00010000 ; Keep the bits of #REGa that are set in #N$10.
 $B1BF OR C          ; Set the bits of #REGa that are set in #REGc.
 $B1C0 LD C,A        ; #REGc=#REGa.
 $B1C1 LD A,$F7      ; #REGa=#N$F7.
 $B1C3 OUT ($FD),A   ; Send #REGa to port #N$FD.
 $B1C5 IN A,($FE)    ; Read port #N$FE.
 $B1C7 RRA           ; Rotate #REGa right.
 $B1C8 RRA           ; Rotate #REGa right.
 $B1C9 RRA           ; Rotate #REGa right.
 $B1CA AND %00000010 ; Keep the bits of #REGa that are set in #N$02.
 $B1CC OR C          ; Set the bits of #REGa that are set in #REGc.
 $B1CD CPL           ; Invert #REGa.
 $B1CE LD C,A        ; #REGc=#REGa.
 $B1CF JP $B226      ; Jump to #R$B226.
@label=ReadInputDevice_Keyboard
*$B1D2 XOR A         ; Clear #REGa.
 $B1D3 LD C,A        ; #REGc=#REGa.
 $B1D4 LD A,$FE      ; #REGa=#N$FE.
 $B1D6 OUT ($FD),A   ; Send #REGa to port #N$FD.
 $B1D8 IN A,($FE)    ; Read port #N$FE.
 $B1DA AND %00010100 ; Keep the bits of #REGa that are set in #N$14.
 $B1DC LD B,A        ; #REGb=#REGa.
 $B1DD LD A,$7F      ; #REGa=#N$7F.
 $B1DF OUT ($FD),A   ; Send #REGa to port #N$FD.
 $B1E1 IN A,($FE)    ; Read port #N$FE.
 $B1E3 AND %00001010 ; Keep the bits of #REGa that are set in #N$0A.
 $B1E5 OR B          ; Set the bits of #REGa that are set in #REGb.
 $B1E6 XOR %00011110 ; Flip the bits of #REGa that are set in #N$1E.
 $B1E8 JR Z,$B1F0    ; Jump to #R$B1F0 if the zero flag is set.
 $B1EA LD A,C        ; #REGa=#REGc.
 $B1EB OR %00000001  ; Set the bits of #REGa that are set in #N$01.
 $B1ED LD C,A        ; #REGc=#REGa.
 $B1EE JR $B208      ; Jump to #R$B208.
@label=ReadInputDevice_Left
*$B1F0 LD A,$FE      ; #REGa=#N$FE.
 $B1F2 OUT ($FD),A   ; Send #REGa to port #N$FD.
 $B1F4 IN A,($FE)    ; Read port #N$FE.
 $B1F6 AND %00001010 ; Keep the bits of #REGa that are set in #N$0A.
 $B1F8 LD B,A        ; #REGb=#REGa.
 $B1F9 LD A,$7F      ; #REGa=#N$7F.
 $B1FB OUT ($FD),A   ; Send #REGa to port #N$FD.
 $B1FD IN A,($FE)    ; Read port #N$FE.
 $B1FF AND %00010100 ; Keep the bits of #REGa that are set in #N$14.
 $B201 OR B          ; Set the bits of #REGa that are set in #REGb.
 $B202 XOR %00011110 ; Flip the bits of #REGa that are set in #N$1E.
 $B204 JR Z,$B208    ; Jump to #R$B208 if the zero flag is set.
 $B206 SET 1,C       ; Set bit 1 of #REGc.
@label=ReadInputDevice_Up
*$B208 LD A,$BD      ; #REGa=#N$BD.
 $B20A CALL $9BC3    ; Call #R$9BC3.
 $B20D JR Z,$B211    ; Jump to #R$B211 if the zero flag is set.
 $B20F SET 3,C       ; Set bit 3 of #REGc.
@label=ReadInputDevice_Fire
*$B211 LD A,$DB      ; #REGa=#N$DB.
 $B213 CALL $9BC3    ; Call #R$9BC3.
 $B216 JR Z,$B21A    ; Jump to #R$B21A if the zero flag is set.
 $B218 SET 4,C       ; Set bit 4 of #REGc.
@label=ReadInputDevice_Extra
*$B21A LD A,$E7      ; #REGa=#N$E7.
 $B21C LD B,$00      ; Clear #REGb.
@label=ReadInputDevice_Test
*$B21E CALL $9BC3    ; Call #R$9BC3.
 $B221 OR B          ; Set the bits of #REGa that are set in #REGb.
 $B222 RET Z         ; Return if the zero flag is set.
 $B223 SET 5,C       ; Set bit 5 of #REGc.
 $B225 RET           ; Return.
@label=ReadInputDevice_Joystick
*$B226 RES 5,C       ; Reset bit 5 of #REGc.
 $B228 LD A,$7E      ; #REGa=#N$7E.
 $B22A CALL $9BC3    ; Call #R$9BC3.
 $B22D AND %00011110 ; Keep the bits of #REGa that are set in #N$1E.
 $B22F LD B,A        ; #REGb=#REGa.
 $B230 LD A,$99      ; #REGa=#N$99.
 $B232 JR $B21E      ; Jump to #R$B21E.

; Update Ship Speeds
;
; Used by the routine at #R$C374.
; .
; Reads the controls, then changes the horizontal and vertical speeds
; of the ship by the amounts in the table at #R$B312, depending on what is
; pressed and on the speed it already has, limits them, and works out the
; vertical scroll speed in #R$CCBA with #R$B2D5.
;
; IX Address of the ship at #R$C8E5
@label=UpdateShipSpeeds
c$B234 CALL $B115    ; Call #R$B115.
 $B237 XOR A         ; Clear #REGa.
 $B238 LD ($5C36),A  ; Update the steering direction.
 $B23B LD DE,($B31A) ; Fetch the word at #R$B31A into #REGde.
 $B23F LD A,($96AB)  ; The crystal-delivery flag.
 $B242 AND A         ; {Jump to #R$B259 if #REGa is zero.
 $B243 JR Z,$B259    ; }
 $B245 LD A,$08      ; #REGa=#N$08.
 $B247 LD ($5C37),A  ; Update the controls.
 $B24A LD A,$04      ; #REGa=#N$04.
 $B24C LD ($5C3F),A  ; Update the vertical scroll limit.
 $B24F LD A,($CE58)  ; The map row.
 $B252 AND A         ; {Jump to #R$B26D if #REGa is not zero.
 $B253 JR NZ,$B26D   ; }
 $B255 LD ($CCBA),A  ; Update the vertical scroll speed.
 $B258 RET           ; Return.
@label=UpdateShipSpeeds_Drag
*$B259 LD A,(IX+$07) ; Read offset #N$07 of #REGix.
 $B25C NEG           ; Negate #REGa.
 $B25E AND A         ; {Jump to #R$B26D if #REGa is zero.
 $B25F JR Z,$B26D    ; }
 $B261 LD DE,($B31E) ; Fetch the word at #R$B31E into #REGde.
 $B265 BIT 7,A       ; {Jump to #R$B26D if bit 7 of #REGa is set.
 $B267 JR NZ,$B26D   ; }
 $B269 LD DE,($B31C) ; Fetch the word at #R$B31C into #REGde.
@label=UpdateShipSpeeds_Sideways
*$B26D LD A,($5C37)  ; The controls.
 $B270 BIT 1,A       ; {Jump to #R$B287 if bit 1 of #REGa is clear.
 $B272 JR Z,$B287    ; }
 $B274 EX DE,HL      ; Swap #REGde and #REGhl.
 $B275 LD DE,($B318) ; Fetch the word at #R$B318 into #REGde.
 $B279 LD A,$80      ; #REGa=#N$80.
 $B27B LD ($5C36),A  ; Update the steering direction.
 $B27E LD A,H        ; #REGa=#REGh.
 $B27F CP $FF        ; {Jump to #R$B29B if #REGa is #N$FF.
 $B281 JR Z,$B29B    ; }
 $B283 ADD HL,DE     ; #REGhl gains #REGde.
 $B284 EX DE,HL      ; Swap #REGde and #REGhl.
 $B285 JR $B29B      ; Jump to #R$B29B.
@label=UpdateShipSpeeds_Right
*$B287 BIT 0,A       ; {Jump to #R$B29B if bit 0 of #REGa is clear.
 $B289 JR Z,$B29B    ; }
 $B28B EX DE,HL      ; Swap #REGde and #REGhl.
 $B28C LD DE,($B316) ; Fetch the word at #R$B316 into #REGde.
 $B290 LD A,$03      ; #REGa=#N$03.
 $B292 LD ($5C36),A  ; Update the steering direction.
 $B295 LD A,H        ; #REGa=#REGh.
 $B296 AND A         ; {Jump to #R$B29B if #REGa is zero.
 $B297 JR Z,$B29B    ; }
 $B299 ADD HL,DE     ; #REGhl gains #REGde.
 $B29A EX DE,HL      ; Swap #REGde and #REGhl.
@label=UpdateShipSpeeds_Vertical
*$B29B LD A,($5C40)  ; The ship was just hit.
 $B29E AND A         ; {Jump to #R$B2A4 if #REGa is zero.
 $B29F JR Z,$B2A4    ; }
 $B2A1 LD DE,$0000   ; #REGde=#N$00.
@label=UpdateShipSpeeds_Thrust
*$B2A4 CALL $C7FC    ; Call #R$C7FC.
 $B2A7 LD DE,($B312) ; Fetch the word at #R$B312 into #REGde.
 $B2AB LD A,($5C37)  ; The controls.
 $B2AE AND %00001000 ; Keep the bits of #REGa that are set in #N$08.
 $B2B0 JR Z,$B2B6    ; Jump to #R$B2B6 if the zero flag is set.
 $B2B2 LD DE,($B314) ; Fetch the word at #R$B314 into #REGde.
@label=UpdateShipSpeeds_Gravity
*$B2B6 LD H,(IX+$1B) ; Read offset #N$1B of #REGix into #REGh.
 $B2B9 LD L,(IX+$1C) ; Read offset #N$1C of #REGix into #REGl.
 $B2BC LD A,($B832)  ; The special-shot flag.
 $B2BF AND A         ; {Jump to #R$B2CB if #REGa is zero.
 $B2C0 JR Z,$B2CB    ; }
 $B2C2 LD HL,$0000   ; #REGhl=#N$00.
 $B2C5 LD DE,$0000   ; #REGde=#N$00.
 $B2C8 LD ($B320),HL ; Update the vertical scroll fraction.
@label=UpdateShipSpeeds_Limit
*$B2CB ADD HL,DE     ; #REGhl gains #REGde.
 $B2CC CALL $B322    ; Call #R$B322.
 $B2CF LD (IX+$1B),H ; Write #REGh to offset #N$1B of #REGix.
 $B2D2 LD (IX+$1C),L ; Write #REGl to offset #N$1C of #REGix.
; Continue on to #R$B2D5.

; Update Vertical Scroll Speed
;
; Used by the routines at #R$AA15 and #R$BA21.
; .
; Adds the vertical speed of the ship to the fraction in #R$B320 and
; works out how many whole pixels of vertical scroll that makes, limited to
; the value at #R$5C3F and stores it in #R$CCBA. Halved if the speed is at
; its limit and bit 1 of #R$CE42 is set.
@label=UpdateVerticalScrollSpeed
c$B2D5 LD DE,($B320) ; Fetch the word at #R$B320 into #REGde.
 $B2D9 ADD HL,DE     ; #REGhl gains #REGde.
 $B2DA LD ($B320),HL ; Update the vertical scroll fraction.
 $B2DD LD A,H        ; #REGa=#REGh.
 $B2DE SUB D         ; Subtract #REGd from #REGa.
 $B2DF ADD A,A       ; Double #REGa.
 $B2E0 LD H,A        ; #REGh=#REGa.
 $B2E1 BIT 7,A       ; {Jump to #R$B2F3 if bit 7 of #REGa is set.
 $B2E3 JR NZ,$B2F3   ; }
 $B2E5 LD A,($5C3F)  ; The vertical scroll limit.
 $B2E8 ADD A,$02     ; Add #N$02 to #REGa.
 $B2EA CP H          ; Compare #REGa with #REGh.
 $B2EB LD A,H        ; #REGa=#REGh.
 $B2EC JR NZ,$B2F9   ; Jump to #R$B2F9 if the zero flag is clear.
 $B2EE LD A,($5C3F)  ; The vertical scroll limit.
 $B2F1 JR $B2F9      ; Jump to #R$B2F9.
@label=UpdateVerticalScrollSpeed_Up
*$B2F3 CP $FA        ; {Jump to #R$B2F9 if #REGa is not #N$FA.
 $B2F5 JR NZ,$B2F9   ; }
 $B2F7 LD A,$FC      ; #REGa=#N$FC.
@label=UpdateVerticalScrollSpeed_Store
*$B2F9 LD ($CCBA),A  ; Update the vertical scroll speed.
 $B2FC CP $04        ; {Jump to #R$B303 if #REGa is #N$04.
 $B2FE JR Z,$B303    ; }
 $B300 CP $FC        ; {Return if #REGa is not #N$FC.
 $B302 RET NZ        ; }
@label=UpdateVerticalScrollSpeed_Halve
*$B303 LD A,($CE42)  ; The vertical offset.
 $B306 AND %00000010 ; Keep the bits of #REGa that are set in #N$02.
 $B308 RET Z         ; Return if the zero flag is set.
 $B309 LD A,($CCBA)  ; The vertical scroll speed.
 $B30C SRA A         ; Shift #REGa right keeping the sign.
 $B30E LD ($CCBA),A  ; Update the vertical scroll speed.
 $B311 RET           ; Return.

; Ship Acceleration Table
;
; The amounts that #R$B234 adds to the speeds of the ship, which are
; signed numbers with the fraction in the bottom byte.
@label=ShipAccelerationTable
w$B312 DEFW $FFC0    ; Vertical, when not going up
 $B314 DEFW $0050    ; Vertical, when going up
 $B316 DEFW $FFC0    ; Horizontal, for the right key
 $B318 DEFW $0040    ; Horizontal, for the left key
 $B31A DEFW $0000    ; Horizontal drag, when not moving
 $B31C DEFW $FFF4    ; Horizontal drag, one way
 $B31E DEFW $000C    ; Horizontal drag, the other way

; Vertical Scroll Fraction
;
; The fraction of a pixel that is left over from the vertical scroll
; speed worked out by #R$B2D5.
@label=VerticalScrollFraction
g$B320 DEFW $0000

; Limit Vertical Speed
;
; Used by the routine at #R$B234.
; .
; Keeps the vertical speed of the ship within its limits: no faster than
; #N$FD downwards, and no faster than half the value at #R$5C3F upwards.
;
;   HL Vertical speed
; O:HL Limited vertical speed
@label=LimitVerticalSpeed
c$B322 LD A,H        ; #REGa=#REGh.
 $B323 BIT 7,A       ; {Jump to #R$B32D if bit 7 of #REGa is clear.
 $B325 JR Z,$B32D    ; }
 $B327 CP $FE        ; {Return if #REGa is #N$FE or more.
 $B329 RET NC        ; }
 $B32A LD H,$FD      ; #REGh=#N$FD.
 $B32C RET           ; Return.
@label=LimitVerticalSpeed_Up
*$B32D LD A,($5C3F)  ; The vertical scroll limit.
 $B330 SRL A         ; Shift #REGa right.
 $B332 CP H          ; {Return if #REGa is #REGh or more.
 $B333 RET NC        ; }
 $B334 LD H,A        ; #REGh=#REGa.
 $B335 RET           ; Return.

; Draw Rows
;
; Used by the routine at #R$B5B5.
; .
; Draws rows of a buffer onto the screen by ORing them in, going up the
; screen from the row that #REGhl is at. The number of rows is the value in
; #R$A1D8 and a row is #REGb bytes of the buffer, which has eight bytes to a
; row.
;
; B Number of bytes in a row
; DE Address of the buffer
; HL Screen address
@label=DrawRows
c$B336 LD A,B        ; #REGa=#REGb.
 $B337 AND A         ; {Return if #REGa is zero.
 $B338 RET Z         ; }
 $B339 LD C,B        ; #REGc=#REGb.
 $B33A LD A,($A1D8)  ; The rows to draw.
@label=DrawRows_Row
*$B33D EX AF,AF'     ; Switch to the alternate accumulator and flags.
 $B33E LD B,C        ; #REGb=#REGc.
 $B33F PUSH DE       ; Stash #REGde on the stack.
 $B340 PUSH HL       ; Stash #REGhl on the stack.
@label=DrawRows_Byte
*$B341 LD A,(DE)     ; Read #REGde.
 $B342 OR (HL)       ; Set the bits of #REGa that are set in the byte at
                     ; #REGhl.
 $B343 LD (HL),A     ; Write #REGa where #REGhl points.
 $B344 INC L         ; Advance #REGl.
 $B345 INC DE        ; Advance #REGde.
 $B346 DJNZ $B341    ; Decrease #REGb and jump to #R$B341 until none remain.
 $B348 POP HL        ; Bring #REGhl back off the stack.
 $B349 CALL $A1C3    ; Call #R$A1C3.
 $B34C POP DE        ; Bring #REGde back off the stack.
 $B34D LD A,$08      ; #REGa=#N$08.
 $B34F ADD A,E       ; #REGa gains #REGe.
 $B350 LD E,A        ; #REGe=#REGa.
 $B351 EX AF,AF'     ; Switch to the alternate accumulator and flags.
 $B352 DEC A         ; Step #REGa back.
 $B353 JR NZ,$B33D   ; Jump to #R$B33D if the zero flag is clear.
 $B355 RET           ; Return.

; Erase Rows
;
; Used by the routine at #R$B5B5.
; .
; Erases rows from the screen, going up from the row that #REGhl is at,
; using the same layout as #R$B336 but with the number of rows in #R$A1D7. The
; alternate registers are used.
;
; B' Number of bytes in a row
; DE' Address of the buffer
; HL' Screen address
@label=EraseRows
c$B356 EXX           ; Switch to the alternate registers.
 $B357 LD A,B        ; #REGa=#REGb.
 $B358 AND A         ; {Jump to #R$B378 if #REGa is zero.
 $B359 JR Z,$B378    ; }
 $B35B LD C,B        ; #REGc=#REGb.
 $B35C LD A,($A1D7)  ; The rows to erase.
@label=EraseRows_Row
*$B35F EX AF,AF'     ; Switch to the alternate accumulator and flags.
 $B360 LD B,C        ; #REGb=#REGc.
 $B361 PUSH DE       ; Stash #REGde on the stack.
 $B362 PUSH HL       ; Stash #REGhl on the stack.
@label=EraseRows_Byte
*$B363 LD A,(DE)     ; Read #REGde.
 $B364 CPL           ; Invert #REGa.
 $B365 AND (HL)      ; Keep the bits of #REGa that are set in the byte at
                     ; #REGhl.
 $B366 LD (HL),A     ; Write #REGa where #REGhl points.
 $B367 INC L         ; Advance #REGl.
 $B368 INC DE        ; Advance #REGde.
 $B369 DJNZ $B363    ; Decrease #REGb and jump to #R$B363 until none remain.
 $B36B POP HL        ; Bring #REGhl back off the stack.
 $B36C CALL $A1C3    ; Call #R$A1C3.
 $B36F POP DE        ; Bring #REGde back off the stack.
 $B370 LD A,$08      ; #REGa=#N$08.
 $B372 ADD A,E       ; #REGa gains #REGe.
 $B373 LD E,A        ; #REGe=#REGa.
 $B374 EX AF,AF'     ; Switch to the alternate accumulator and flags.
 $B375 DEC A         ; Step #REGa back.
 $B376 JR NZ,$B35F   ; Jump to #R$B35F if the zero flag is clear.
@label=EraseRows_Finish
*$B378 EXX           ; Switch to the alternate registers.
 $B379 RET           ; Return.

; Shot Slots
;
; Four slots of #N($18) bytes for the shots that the ship fires, in the
; same layout as the slots at #R$9974. The routine at #R$B706 updates them.
@label=ShotSlots
g$B37A DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $B392 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $B3AA DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $B3C2 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00

; Shot Offsets
;
; Two tables of eight bytes. The offset in the shot is added to the
; address of one of them by #R$B3EA.
@label=ShotOffsets
b$B3DA DEFB $4D,$9E,$7C,$7F,$3F,$E7,$FF,$FF
@label=ShotOffsets_Second
 $B3E2 DEFB $FF,$FF,$E7,$FC,$FE,$3E,$79,$B2

; Add Shot Offset
;
; Used by the routines at #R$B483 and #R$B628.
; .
; Adds the byte at offset #N($0F) of a shot to a table address.
;
;   DE Address of the table
;   IX Address of the shot
; O:DE Address of the entry
@label=AddShotOffset
c$B3EA LD L,(IX+$0F) ; The low byte of the vertical acceleration.
 $B3ED LD H,$00      ; Clear #REGh.
 $B3EF ADD HL,DE     ; #REGhl gains #REGde.
 $B3F0 EX DE,HL      ; Swap #REGde and #REGhl.
 $B3F1 RET           ; Return.

; Choose Random Colour
;
; Used by the routine at #R$B483.
; .
; Picks one of four attributes for an object at random and stores it at
; offset #N($0D).
;
; IX Address of the object
@label=ChooseRandomColour
c$B3F2 LD A,($9BCB)  ; The random numbers.
 $B3F5 AND %00000011 ; Keep the bits of #REGa that are set in #N$03.
 $B3F7 ADD A,$45     ; Add #N$45 to #REGa.
 $B3F9 CP $48        ; {Jump to #R$B3FF if #REGa is not #N$48.
 $B3FB JR NZ,$B3FF   ; }
 $B3FD LD A,$43      ; #REGa=#N$43.
@label=ChooseRandomColour_Store
*$B3FF LD (IX+$0D),A ; Write #REGa to offset #N$0D of #REGix.
 $B402 RET           ; Return.

; Choose Random Step
;
; Used by the routine at #R$B483.
; .
; Chooses a step of #N($FF), #N($00) or #N($01) at random, with zero
; twice as likely as the others.
;
; O:B Step
@label=ChooseRandomStep
c$B403 LD A,($9BCC)  ; The second random byte.
 $B406 AND %00000011 ; Keep the bits of #REGa that are set in #N$03.
 $B408 LD B,$00      ; Clear #REGb.
 $B40A CP $02        ; {Return if #REGa is less than #N$02.
 $B40C RET C         ; }
 $B40D DEC B         ; Step #REGb back.
 $B40E CP $03        ; {Return if #REGa is #N$03.
 $B410 RET Z         ; }
 $B411 INC B         ; Advance #REGb.
 $B412 INC B         ; Advance #REGb.
 $B413 RET           ; Return.

; Update Special Shot
;
; Used by the routine at #R$B483.
; .
; Updates a shot that has bit 7 of offset #N($15) set, which is the
; kind that is made by #R$B7F6. The length of the shot is at offset #N($0E).
; Purpose of the details not yet known.
;
; IX Address of the shot
@label=UpdateSpecialShot
c$B414 LD A,(IX+$0E)  ; The high byte of the vertical acceleration.
 $B417 AND A          ; {Call #R$7234 if #REGa is not zero.
 $B418 CALL NZ,$7234  ; }
 $B41B INC (IX+$11)   ; Increase offset #N$11 of #REGix by one.
 $B41E CALL $B897     ; Call #R$B897.
 $B421 CALL $A28B     ; Call #R$A28B.
 $B424 LD B,(IX+$0E)  ; The high byte of the vertical acceleration.
 $B427 EXX            ; Switch to the alternate registers.
 $B428 BIT 7,(IX+$10) ; {Jump to #R$B460 if bit 7 of offset #N$10 of #REGix is
 $B42C JR NZ,$B460    ; set.}
 $B42E BIT 0,(IX+$11) ; {Jump to #R$B471 if bit 0 of offset #N$11 of #REGix is
 $B432 JR Z,$B471     ; clear.}
 $B434 LD A,(IX+$12)  ; The vertical screen position.
 $B437 ADD A,(IX+$07) ; Add the byte at offset #N$07 of #REGix to #REGa.
 $B43A LD (IX+$07),A  ; Write the high byte of the horizontal speed.
 $B43D LD A,(IX+$0E)  ; The high byte of the vertical acceleration.
 $B440 CP $08         ; {Jump to #R$B455 if #REGa is #N$08.
 $B442 JR Z,$B455     ; }
 $B444 INC (IX+$0E)   ; Increase offset #N$0E of #REGix by one.
 $B447 BIT 7,(IX+$00) ; {Jump to #R$B455 if bit 7 of offset #N$00 of #REGix is
 $B44B JR Z,$B455     ; clear.}
 $B44D LD A,$F8       ; #REGa=#N$F8.
 $B44F ADD A,(IX+$0B) ; Add the byte at offset #N$0B of #REGix to #REGa.
 $B452 LD (IX+$0B),A  ; Write the high byte of the horizontal acceleration.
@label=UpdateSpecialShot_Test
*$B455 CALL $B6F0     ; Call #R$B6F0.
 $B458 JR Z,$B471     ; Jump to #R$B471 if the zero flag is set.
 $B45A LD A,($C8EC)   ; The high byte of the ship's horizontal speed.
 $B45D LD (IX+$07),A  ; Write the high byte of the horizontal speed.
@label=UpdateSpecialShot_Shorter
*$B460 DEC (IX+$0E)   ; Decrease offset #N$0E of #REGix by one.
 $B463 BIT 7,(IX+$00) ; {Jump to #R$B471 if bit 7 of offset #N$00 of #REGix is
 $B467 JR Z,$B471     ; clear.}
 $B469 LD A,$08       ; #REGa=#N$08.
 $B46B ADD A,(IX+$0B) ; Add the byte at offset #N$0B of #REGix to #REGa.
 $B46E LD (IX+$0B),A  ; Write the high byte of the horizontal acceleration.
@label=UpdateSpecialShot_Frame
*$B471 CALL $B8B5     ; Call #R$B8B5.
 $B474 LD A,(IX+$11)  ; The horizontal screen position.
 $B477 CP $16         ; {Jump to #R$B5B5 if #REGa is not #N$16.
 $B479 JP NZ,$B5B5    ; }
 $B47C SET 7,(IX+$10) ; Set bit 7 of offset #N$10 of #REGix.
 $B480 JP $B5B5       ; Jump to #R$B5B5.

; Update Shot
;
; Used by the routine at #R$B706.
; .
; Updates one of the shots that the ship has fired. Shots that have bit
; 7 of offset #N($15) set go to #R$B414. A shot that is starting (with a
; length of zero at offset #N($0E)) is given a starting vertical position from
; #R$5C38 with a random step, and a random colour. Shots that are
; facing right continue at #R$B4C9 and ones that are facing left at #R$B628.
;
; IX Address of the shot
@label=UpdateShot
c$B483 LD A,($C8EC)    ; The high byte of the ship's horizontal speed.
 $B486 LD (IX+$07),A   ; Write the high byte of the horizontal speed.
 $B489 LD A,$80        ; #REGa=#N$80.
 $B48B LD ($5C25),A    ; The shot stops on the terrain.
 $B48E BIT 7,(IX+$15)  ; {Jump to #R$B414 if bit 7 of offset #N$15 of #REGix is
 $B492 JP NZ,$B414     ; set.}
 $B495 LD A,$01        ; #REGa=#N$01.
 $B497 LD ($A1D7),A    ; One row to erase.
 $B49A LD ($A1D8),A    ; One row to draw.
 $B49D LD A,(IX+$0E)   ; The high byte of the vertical acceleration.
 $B4A0 AND A           ; {Jump to #R$B4C9 if #REGa is not zero.
 $B4A1 JR NZ,$B4C9     ; }
 $B4A3 LD (IX+$10),$00 ; Store #N$00 at offset #N$10 of #REGix.
 $B4A7 LD (IX+$07),$00 ; Store #N$00 at offset #N$07 of #REGix.
 $B4AB CALL $B403      ; Call #R$B403.
 $B4AE LD A,($CCBA)    ; The vertical scroll speed.
 $B4B1 NEG             ; Negate #REGa.
 $B4B3 ADD A,B         ; #REGa gains #REGb.
 $B4B4 LD (IX+$09),B   ; Write the high byte of the vertical speed.
 $B4B7 LD B,A          ; #REGb=#REGa.
 $B4B8 LD A,($5C38)    ; The ship row.
 $B4BB ADD A,B         ; #REGa gains #REGb.
 $B4BC LD (IX+$0C),A   ; Write the low byte of the horizontal acceleration.
 $B4BF CALL $B3F2      ; Call #R$B3F2.
 $B4C2 CALL $BF66      ; Call #R$BF66.
 $B4C5 LD (IX+$09),$00 ; Store #N$00 at offset #N$09 of #REGix.
@label=UpdateShot_Right
*$B4C9 BIT 7,(IX+$00)  ; {Jump to #R$B628 if bit 7 of offset #N$00 of #REGix is
 $B4CD JP NZ,$B628     ; set.}
 $B4D0 LD DE,$B3DA     ; The shot offsets.
 $B4D3 CALL $B3EA      ; Call #R$B3EA.
 $B4D6 CALL $A28B      ; Call #R$A28B.
 $B4D9 LD B,(IX+$0E)   ; The high byte of the vertical acceleration.
 $B4DC EXX             ; Switch to the alternate registers.
 $B4DD BIT 7,(IX+$10)  ; {Jump to #R$B532 if bit 7 of offset #N$10 of #REGix is
 $B4E1 JR NZ,$B532     ; set.}
 $B4E3 LD A,(IX+$0E)   ; The high byte of the vertical acceleration.
 $B4E6 AND A           ; {Jump to #R$B4F1 if #REGa is not zero.
 $B4E7 JR NZ,$B4F1     ; }
 $B4E9 LD (IX+$0F),$08 ; Store #N$08 at offset #N$0F of #REGix.
 $B4ED LD (IX+$0B),$88 ; Store #N$88 at offset #N$0B of #REGix.
@label=UpdateShot_Longer
*$B4F1 LD A,$10        ; #REGa=#N$10.
 $B4F3 ADD A,(IX+$07)  ; Add the byte at offset #N$07 of #REGix to #REGa.
 $B4F6 LD (IX+$07),A   ; Write the high byte of the horizontal speed.
 $B4F9 CALL $B6EC      ; Call #R$B6EC.
 $B4FC JR Z,$B511      ; Jump to #R$B511 if the zero flag is set.
 $B4FE LD A,$F0        ; #REGa=#N$F0.
 $B500 ADD A,(IX+$07)  ; Add the byte at offset #N$07 of #REGix to #REGa.
 $B503 LD (IX+$07),A   ; Write the high byte of the horizontal speed.
 $B506 SET 7,(IX+$10)  ; Set bit 7 of offset #N$10 of #REGix.
 $B50A SET 5,(IX+$10)  ; Set bit 5 of offset #N$10 of #REGix.
 $B50E JP $B59D        ; Jump to #R$B59D.
@label=UpdateShot_Move
*$B511 LD A,$08        ; #REGa=#N$08.
 $B513 ADD A,(IX+$0B)  ; Add the byte at offset #N$0B of #REGix to #REGa.
 $B516 LD (IX+$0B),A   ; Write the high byte of the horizontal acceleration.
 $B519 CP $B8          ; {Jump to #R$B521 if #REGa is not #N$B8.
 $B51B JR NZ,$B521     ; }
 $B51D SET 7,(IX+$10)  ; Set bit 7 of offset #N$10 of #REGix.
@label=UpdateShot_Length
*$B521 LD A,(IX+$0E)   ; The high byte of the vertical acceleration.
 $B524 INC A           ; Advance #REGa.
 $B525 LD (IX+$0E),A   ; Write the high byte of the vertical acceleration.
 $B528 LD A,(IX+$0F)   ; The low byte of the vertical acceleration.
 $B52B DEC A           ; Step #REGa back.
 $B52C LD (IX+$0F),A   ; Write the low byte of the vertical acceleration.
 $B52F JP $B5AA        ; Jump to #R$B5AA.
@label=UpdateShot_Hit
*$B532 BIT 5,(IX+$10)  ; {Jump to #R$B541 if bit 5 of offset #N$10 of #REGix is
 $B536 JR NZ,$B541     ; set.}
 $B538 CALL $B6EC      ; Call #R$B6EC.
 $B53B JR Z,$B586      ; Jump to #R$B586 if the zero flag is set.
 $B53D SET 5,(IX+$10)  ; Set bit 5 of offset #N$10 of #REGix.
@label=UpdateShot_Stopped
*$B541 LD A,(IX+$07)   ; The high byte of the horizontal speed.
 $B544 NEG             ; Negate #REGa.
 $B546 ADD A,(IX+$0B)  ; Add the byte at offset #N$0B of #REGix to #REGa.
 $B549 LD (IX+$0B),A   ; Write the high byte of the horizontal acceleration.
 $B54C LD (IX+$07),$00 ; Store #N$00 at offset #N$07 of #REGix.
 $B550 BIT 6,(IX+$10)  ; Test bit 6 of offset #N$10 of #REGix.
 $B554 LD B,(IX+$0E)   ; The high byte of the vertical acceleration.
 $B557 LD C,(IX+$0B)   ; The high byte of the horizontal acceleration.
 $B55A JR Z,$B561      ; Jump to #R$B561 if the zero flag is set.
 $B55C DEC B           ; Step #REGb back.
 $B55D LD A,C          ; #REGa=#REGc.
 $B55E ADD A,$08       ; Add #N$08 to #REGa.
 $B560 LD C,A          ; #REGc=#REGa.
@label=UpdateShot_Clip
*$B561 SLA B           ; Shift #REGb left.
 $B563 SLA B           ; Shift #REGb left.
 $B565 SLA B           ; Shift #REGb left.
 $B567 LD A,B          ; #REGa=#REGb.
 $B568 ADD A,C         ; #REGa gains #REGc.
 $B569 AND %11111000   ; Keep the bits of #REGa that are set in #N$F8.
 $B56B CP $E4          ; {Jump to #R$B586 if #REGa is less than #N$E4.
 $B56D JR C,$B586      ; }
 $B56F CP $F0          ; {Jump to #R$B577 if #REGa is less than #N$F0.
 $B571 JR C,$B577      ; }
 $B573 LD (IX+$0E),$00 ; Store #N$00 at offset #N$0E of #REGix.
@label=UpdateShot_Shorten
*$B577 LD A,(IX+$0E)   ; The high byte of the vertical acceleration.
 $B57A DEC A           ; Step #REGa back.
 $B57B LD (IX+$0E),A   ; Write the high byte of the vertical acceleration.
 $B57E LD A,(IX+$0B)   ; The high byte of the horizontal acceleration.
 $B581 SUB $08         ; Subtract #N$08 from #REGa.
 $B583 LD (IX+$0B),A   ; Write the high byte of the horizontal acceleration.
@label=UpdateShot_Facing
*$B586 BIT 6,(IX+$10)  ; {Jump to #R$B59D if bit 6 of offset #N$10 of #REGix is
 $B58A JR Z,$B59D      ; clear.}
 $B58C LD A,(IX+$0E)   ; The high byte of the vertical acceleration.
 $B58F DEC A           ; Step #REGa back.
 $B590 LD (IX+$0E),A   ; Write the high byte of the vertical acceleration.
 $B593 LD A,(IX+$0B)   ; The high byte of the horizontal acceleration.
 $B596 ADD A,$08       ; Add #N$08 to #REGa.
 $B598 LD (IX+$0B),A   ; Write the high byte of the horizontal acceleration.
 $B59B JR $B5AA        ; Jump to #R$B5AA.
@label=UpdateShot_Count
*$B59D LD A,(IX+$0F)   ; The low byte of the vertical acceleration.
 $B5A0 DEC A           ; Step #REGa back.
 $B5A1 LD (IX+$0F),A   ; Write the low byte of the vertical acceleration.
 $B5A4 JR NZ,$B5AA     ; Jump to #R$B5AA if the zero flag is clear.
 $B5A6 SET 6,(IX+$10)  ; Set bit 6 of offset #N$10 of #REGix.
@label=UpdateShot_Table
*$B5AA LD DE,$B3DA     ; The shot offsets.
 $B5AD JR $B5B2        ; Jump to #R$B5B2.
; This entry point is used by the routine at #R$B628.
@label=UpdateShot_LeftTable
*$B5AF LD DE,$B3E2     ; The second shot offset.
@label=UpdateShot_Offset
*$B5B2 CALL $B3EA      ; Call #R$B3EA.

; Draw Shot
;
; Used by the routine at #R$B414.
; .
; The end of the routines that update a shot. Moves the shot by the
; vertical scroll speed, then erases the old picture of the shot with
; #R$B356 and draws the new one with #R$B336. If the shot has ended, its slot
; is made free; if it was a special shot that ends the flag at #R$B832 is
; cleared. Otherwise the area of the screen under it is given its attribute
; by #R$B60B.
;
; IX Address of the shot
@label=DrawShot
c$B5B5 LD A,($CCBA)    ; The vertical scroll speed.
 $B5B8 ADD A,(IX+$0C)  ; Add the byte at offset #N$0C of #REGix to #REGa.
 $B5BB LD (IX+$0C),A   ; Write the low byte of the horizontal acceleration.
 $B5BE CALL $A28B      ; Call #R$A28B.
 $B5C1 LD B,(IX+$0E)   ; The high byte of the vertical acceleration.
 $B5C4 BIT 7,B         ; {Jump to #R$B5CD if bit 7 of #REGb is clear.
 $B5C6 JR Z,$B5CD      ; }
 $B5C8 LD B,$00        ; Clear #REGb.
 $B5CA LD (IX+$0E),B   ; Write the high byte of the vertical acceleration.
@label=DrawShot_Draw
*$B5CD CALL $B356      ; Call #R$B356.
 $B5D0 CALL $B336      ; Call #R$B336.
 $B5D3 CALL $BF66      ; Call #R$BF66.
 $B5D6 LD A,(IX+$0E)   ; The high byte of the vertical acceleration.
 $B5D9 AND A           ; {Jump to #R$B5EC if #REGa is not zero.
 $B5DA JR NZ,$B5EC     ; }
 $B5DC LD (IX+$0B),$00 ; Store #N$00 at offset #N$0B of #REGix.
 $B5E0 BIT 7,(IX+$15)  ; {Return if bit 7 of offset #N$15 of #REGix is clear.
 $B5E4 RET Z           ; }
 $B5E5 XOR A           ; Clear #REGa.
 $B5E6 LD ($B832),A    ; The special shot has ended.
 $B5E9 JP $A8A5        ; Jump to #R$A8A5.
@label=DrawShot_Attributes
*$B5EC BIT 7,(IX+$15)  ; {Jump to #R$B60B if bit 7 of offset #N$15 of #REGix is
 $B5F0 JR Z,$B60B      ; clear.}
 $B5F2 LD A,$43        ; #REGa=#N$43.
 $B5F4 LD ($AF03),A    ; The special shot is bright magenta.
 $B5F7 LD L,(IX+$0B)   ; The high byte of the horizontal acceleration.
 $B5FA LD H,(IX+$0C)   ; The low byte of the horizontal acceleration.
 $B5FD LD A,($A1D8)    ; The rows of the shot.
 $B600 LD D,A          ; #REGd=#REGa.
 $B601 LD A,(IX+$0E)   ; The high byte of the vertical acceleration.
 $B604 ADD A,A         ; Double #REGa.
 $B605 ADD A,A         ; Double #REGa.
 $B606 ADD A,A         ; Double #REGa.
 $B607 LD B,A          ; #REGb=#REGa.
 $B608 JP $AED3        ; Jump to #R$AED3.
@label=SetShotAttributes
*$B60B LD DE,$B625     ; The shot attribute area.
 $B60E LD A,(IX+$0E)   ; The high byte of the vertical acceleration.
 $B611 LD (DE),A       ; Write #REGa where #REGde points.
 $B612 INC DE          ; Advance #REGde.
 $B613 INC DE          ; Advance #REGde.
 $B614 LD A,(IX+$0D)   ; The attribute.
 $B617 LD (DE),A       ; Write #REGa where #REGde points.
 $B618 LD L,(IX+$0B)   ; The high byte of the horizontal acceleration.
 $B61B LD H,(IX+$0C)   ; The low byte of the horizontal acceleration.
 $B61E LD DE,$B625     ; The shot attribute area.
 $B621 CALL $C991      ; Call #R$C991.
 $B624 RET             ; Return.

; Shot Attribute Area
;
; The width in cells, the height in cells and the attribute of the
; area that #R$B60B fills in the same way as #R$AE98.
@label=ShotAttributeArea
g$B625 DEFB $00
 $B626 DEFB $01
 $B627 DEFB $00

; Update Left Shot
;
; Used by the routine at #R$B483.
; .
; Updates a shot that is facing left (bit 7 of its type is set), in the
; same way as the section of #R$B483 that is used for a shot that is facing
; right.
;
; IX Address of the shot
@label=UpdateLeftShot
c$B628 LD DE,$B3E2     ; The second shot offset.
 $B62B CALL $B3EA      ; Call #R$B3EA.
 $B62E CALL $A28B      ; Call #R$A28B.
 $B631 LD B,(IX+$0E)   ; The high byte of the vertical acceleration.
 $B634 EXX             ; Switch to the alternate registers.
 $B635 BIT 7,(IX+$10)  ; {Jump to #R$B68E if bit 7 of offset #N$10 of #REGix is
 $B639 JR NZ,$B68E     ; set.}
 $B63B LD A,$F0        ; #REGa=#N$F0.
 $B63D ADD A,(IX+$0B)  ; Add the byte at offset #N$0B of #REGix to #REGa.
 $B640 LD (IX+$0B),A   ; Write the high byte of the horizontal acceleration.
 $B643 LD A,$F0        ; #REGa=#N$F0.
 $B645 ADD A,(IX+$07)  ; Add the byte at offset #N$07 of #REGix to #REGa.
 $B648 LD (IX+$07),A   ; Write the high byte of the horizontal speed.
 $B64B LD A,(IX+$0E)   ; The high byte of the vertical acceleration.
 $B64E AND A           ; {Jump to #R$B655 if #REGa is not zero.
 $B64F JR NZ,$B655     ; }
 $B651 LD (IX+$0B),$58 ; Store #N$58 at offset #N$0B of #REGix.
@label=UpdateLeftShot_Test
*$B655 LD (IX+$0F),$00 ; Store #N$00 at offset #N$0F of #REGix.
 $B659 CALL $B6EC      ; Call #R$B6EC.
 $B65C JR Z,$B678      ; Jump to #R$B678 if the zero flag is set.
 $B65E SET 7,(IX+$10)  ; Set bit 7 of offset #N$10 of #REGix.
 $B662 SET 5,(IX+$10)  ; Set bit 5 of offset #N$10 of #REGix.
 $B666 LD A,$10        ; #REGa=#N$10.
 $B668 ADD A,(IX+$07)  ; Add the byte at offset #N$07 of #REGix to #REGa.
 $B66B LD (IX+$07),A   ; Write the high byte of the horizontal speed.
 $B66E LD A,$10        ; #REGa=#N$10.
 $B670 ADD A,(IX+$0B)  ; Add the byte at offset #N$0B of #REGix to #REGa.
 $B673 LD (IX+$0B),A   ; Write the high byte of the horizontal acceleration.
 $B676 JR $B67F        ; Jump to #R$B67F.
@label=UpdateLeftShot_Length
*$B678 LD A,(IX+$0E)   ; The high byte of the vertical acceleration.
 $B67B INC A           ; Advance #REGa.
 $B67C LD (IX+$0E),A   ; Write the high byte of the vertical acceleration.
@label=UpdateLeftShot_End
*$B67F LD A,(IX+$0B)   ; The high byte of the horizontal acceleration.
 $B682 CP $08          ; {Jump to #R$B5AF if #REGa is not #N$08.
 $B684 JP NZ,$B5AF     ; }
 $B687 SET 7,(IX+$10)  ; Set bit 7 of offset #N$10 of #REGix.
 $B68B JP $B5AF        ; Jump to #R$B5AF.
@label=UpdateLeftShot_Hit
*$B68E LD A,(IX+$0F)   ; The low byte of the vertical acceleration.
 $B691 INC A           ; Advance #REGa.
 $B692 LD (IX+$0F),A   ; Write the low byte of the vertical acceleration.
 $B695 BIT 5,(IX+$10)  ; {Jump to #R$B6A4 if bit 5 of offset #N$10 of #REGix is
 $B699 JR NZ,$B6A4     ; set.}
 $B69B CALL $B6EC      ; Call #R$B6EC.
 $B69E JR Z,$B6CA      ; Jump to #R$B6CA if the zero flag is set.
 $B6A0 SET 5,(IX+$10)  ; Set bit 5 of offset #N$10 of #REGix.
@label=UpdateLeftShot_Stopped
*$B6A4 LD A,(IX+$07)   ; The high byte of the horizontal speed.
 $B6A7 NEG             ; Negate #REGa.
 $B6A9 ADD A,(IX+$0B)  ; Add the byte at offset #N$0B of #REGix to #REGa.
 $B6AC LD (IX+$0B),A   ; Write the high byte of the horizontal acceleration.
 $B6AF LD (IX+$07),$00 ; Store #N$00 at offset #N$07 of #REGix.
 $B6B3 CP $08          ; {Jump to #R$B6CA if #REGa is #N$08 or more.
 $B6B5 JR NC,$B6CA     ; }
 $B6B7 ADD A,$08       ; Add #N$08 to #REGa.
 $B6B9 LD (IX+$0B),A   ; Write the high byte of the horizontal acceleration.
 $B6BC LD A,(IX+$0E)   ; The high byte of the vertical acceleration.
 $B6BF DEC A           ; Step #REGa back.
 $B6C0 LD (IX+$0E),A   ; Write the high byte of the vertical acceleration.
 $B6C3 LD A,(IX+$0F)   ; The low byte of the vertical acceleration.
 $B6C6 INC A           ; Advance #REGa.
 $B6C7 LD (IX+$0F),A   ; Write the low byte of the vertical acceleration.
@label=UpdateLeftShot_Facing
*$B6CA BIT 6,(IX+$10)  ; {Jump to #R$B6DA if bit 6 of offset #N$10 of #REGix is
 $B6CE JR Z,$B6DA      ; clear.}
 $B6D0 LD A,(IX+$0E)   ; The high byte of the vertical acceleration.
 $B6D3 DEC A           ; Step #REGa back.
 $B6D4 LD (IX+$0E),A   ; Write the high byte of the vertical acceleration.
 $B6D7 JP $B5AF        ; Jump to #R$B5AF.
@label=UpdateLeftShot_Count
*$B6DA LD A,(IX+$0F)   ; The low byte of the vertical acceleration.
 $B6DD ADD A,(IX+$0E)  ; Add the byte at offset #N$0E of #REGix to #REGa.
 $B6E0 CP $08          ; {Jump to #R$B5AF if #REGa is not #N$08.
 $B6E2 JP NZ,$B5AF     ; }
 $B6E5 SET 6,(IX+$10)  ; Set bit 6 of offset #N$10 of #REGix.
 $B6E9 JP $B5AF        ; Jump to #R$B5AF.

; Test Shot Hits Ground
;
; Used by the routines at #R$B483 and #R$B628.
; .
; Tests whether a shot has hit the ground or an object, using
; #R$9056 with a box that is #N($18) wide and #N($0C) high (#N($10) high if
; entered at #R$B6F0). A sound is made if the shot is not a special one.
;
;   IX Address of the shot
; O:F The zero flag is set if nothing was hit
@label=TestShotHitsGround
c$B6EC LD B,$0C       ; #REGb=#N$0C.
 $B6EE JR $B6F2       ; Jump to #R$B6F2.
; This entry point is used by the routine at #R$B414.
@label=TestShotHitsGround_Wide
*$B6F0 LD B,$10       ; #REGb=#N$10.
@label=TestShotHitsGround_Check
*$B6F2 LD C,$18       ; #REGc=#N$18.
 $B6F4 CALL $9056     ; Call #R$9056.
 $B6F7 LD A,($5C1C)   ; The hit flag.
 $B6FA AND A          ; {Return if #REGa is zero.
 $B6FB RET Z          ; }
 $B6FC BIT 7,(IX+$15) ; {Call #R$72A5 if bit 7 of offset #N$15 of #REGix is
 $B700 CALL Z,$72A5   ; clear.}
 $B703 OR %00000001   ; Set the bits of #REGa that are set in #N$01.
 $B705 RET            ; Return.

; Update Shots
;
; Used by the routine at #R$C374.
; .
; Updates the four shots in the slots at #R$B37A. A shot with bit 7 of
; offset #N($16) set and a type of zero is a chasing shot, which is dealt
; with by #R$9307. The others are shots in use when offset #N($0B) is not
; zero, and are dealt with by #R$B483.
@label=UpdateShots
c$B706 LD IX,$B37A    ; The shot slots.
 $B70A LD B,$04       ; #REGb=#N$04.
@label=UpdateShots_Loop
*$B70C PUSH BC        ; Stash #REGbc on the stack.
 $B70D PUSH IX        ; Stash #REGix on the stack.
 $B70F BIT 7,(IX+$16) ; {Jump to #R$B71E if bit 7 of offset #N$16 of #REGix is
 $B713 JR Z,$B71E     ; clear.}
 $B715 LD A,(IX+$00)  ; Read offset #N$00 of #REGix.
 $B718 AND A          ; {Call #R$9307 if #REGa is zero.
 $B719 CALL Z,$9307   ; }
 $B71C JR $B725       ; Jump to #R$B725.
@label=UpdateShots_Shot
*$B71E LD A,(IX+$0B)  ; Read offset #N$0B of #REGix.
 $B721 AND A          ; {Call #R$B483 if #REGa is not zero.
 $B722 CALL NZ,$B483  ; }
@label=UpdateShots_Next
*$B725 POP IX         ; Bring #REGix back off the stack.
 $B727 LD BC,$0018    ; #REGbc=#N$18.
 $B72A ADD IX,BC      ; #REGix gains #REGbc.
 $B72C POP BC         ; Bring #REGbc back off the stack.
 $B72D DJNZ $B70C     ; Decrease #REGb and jump to #R$B70C until none remain.
 $B72F RET            ; Return.

; Weapon Toggle
;
; Bit 0 changes every time the ship fires. Bit 2 is flipped by
; #R$B833 to make #R$B752 launch a special shot.
@label=WeaponToggle
g$B730 DEFB $00

; Fire Weapons
;
; Used by the routine at #R$C4ED.
; .
; Checks the controls for the fire key. The extra key is dealt with by
; #R$B833 first. When fire is pressed, and the six frames since the last
; shot have passed, a shot is launched.
@label=FireWeapons
c$B731 CALL $B833    ; Call #R$B833.
 $B734 LD A,($5C39)  ; The frames before the next shot.
 $B737 AND A         ; {Jump to #R$B73F if #REGa is zero.
 $B738 JR Z,$B73F    ; }
 $B73A DEC A         ; Step #REGa back.
 $B73B LD ($5C39),A  ; One fewer frame before the next shot.
 $B73E RET           ; Return.
@label=FireWeapons_Fire
*$B73F LD A,($5C37)  ; The controls.
 $B742 BIT 4,A       ; {Return if bit 4 of #REGa is clear.
 $B744 RET Z         ; }
 $B745 LD A,$06      ; #REGa=#N$06.
 $B747 LD ($5C39),A  ; Six frames before the next shot.
 $B74A LD A,($B730)  ; The weapon toggle.
 $B74D XOR %00000001 ; Flip the bits of #REGa that are set in #N$01.
 $B74F LD ($B730),A  ; Update the weapon toggle.
; Continue on to #R$B752.

; Launch Shot
;
; Used by the routine at #R$B833.
; .
; Launches a shot, from the first free slot out of the four at #R$B37A.
; It faces the way the ship is facing and starts at the ship. Three kinds of
; shot can be launched: an ordinary one, a chasing shot if the ship has part
; #N$08 and the weapon toggle at #R$B730 is one, and a special shot if bit 2
; of the toggle is set.
@label=LaunchShot
c$B752 LD IX,$B37A     ; The shot slots.
 $B756 LD A,$04        ; #REGa=#N$04.
@label=LaunchShot_Slot
*$B758 EX AF,AF'       ; Switch to the alternate accumulator and flags.
 $B759 BIT 7,(IX+$16)  ; {Jump to #R$B765 if bit 7 of offset #N$16 of #REGix is
 $B75D JR NZ,$B765     ; set.}
 $B75F LD A,(IX+$0B)   ; Read offset #N$0B of #REGix.
 $B762 AND A           ; {Jump to #R$B76B if #REGa is zero.
 $B763 JR Z,$B76B      ; }
@label=LaunchShot_Check
*$B765 LD A,(IX+$00)   ; Read offset #N$00 of #REGix.
 $B768 INC A           ; Advance #REGa.
 $B769 JR NZ,$B796     ; Jump to #R$B796 if the zero flag is clear.
@label=LaunchShot_Free
*$B76B CALL $AC34      ; Call #R$AC34.
 $B76E LD A,($C8FD)    ; The ship's facing.
 $B771 LD (IX+$00),A   ; Write #REGa to offset #N$00 of #REGix.
 $B774 LD (IX+$0B),$99 ; Store #N$99 at offset #N$0B of #REGix.
 $B778 CALL $B90A      ; Call #R$B90A.
 $B77B LD A,($B730)    ; The weapon toggle.
 $B77E BIT 2,A         ; {Jump to #R$B7F6 if bit 2 of #REGa is set.
 $B780 JP NZ,$B7F6     ; }
 $B783 DEC A           ; Step #REGa back.
 $B784 JP Z,$B7A0      ; Jump to #R$B7A0 if the zero flag is set.
@label=LaunchShot_Ordinary
*$B787 CALL $BF66      ; Call #R$BF66.
 $B78A LD (IX+$09),$00 ; Store #N$00 at offset #N$09 of #REGix.
 $B78E BIT 7,(IX+$15)  ; {Return if bit 7 of offset #N$15 of #REGix is set.
 $B792 RET NZ          ; }
 $B793 JP $72F2        ; Jump to #R$72F2.
@label=LaunchShot_Next
*$B796 LD BC,$0018     ; #REGbc=#N$18.
 $B799 ADD IX,BC       ; #REGix gains #REGbc.
 $B79B EX AF,AF'       ; Switch to the alternate accumulator and flags.
 $B79C DEC A           ; Step #REGa back.
 $B79D JR NZ,$B758     ; Jump to #R$B758 if the zero flag is clear.
 $B79F RET             ; Return.
@label=LaunchShot_Chasing
*$B7A0 LD A,($F5F5)    ; The eighth part, which makes a chasing shot.
 $B7A3 AND A           ; {Jump to #R$B787 if #REGa is zero.
 $B7A4 JP Z,$B787      ; }
 $B7A7 LD A,(IX+$07)   ; Read offset #N$07 of #REGix.
 $B7AA CP $08          ; {Jump to #R$B7B2 if #REGa is #N$08.
 $B7AC JR Z,$B7B2      ; }
 $B7AE LD (IX+$07),$20 ; Store #N$20 at offset #N$07 of #REGix.
@label=LaunchShot_Speed
*$B7B2 LD A,(IX+$09)   ; Read offset #N$09 of #REGix.
 $B7B5 SUB $03         ; Subtract #N$03 from #REGa.
 $B7B7 LD (IX+$09),A   ; Write #REGa to offset #N$09 of #REGix.
 $B7BA LD (IX+$08),$00 ; Store #N$00 at offset #N$08 of #REGix.
 $B7BE LD (IX+$0A),$00 ; Store #N$00 at offset #N$0A of #REGix.
 $B7C2 CALL $BF66      ; Call #R$BF66.
 $B7C5 LD (IX+$09),$00 ; Store #N$00 at offset #N$09 of #REGix.
 $B7C9 LD (IX+$10),$27 ; Store #N$27 at offset #N$10 of #REGix.
 $B7CD LD A,(IX+$07)   ; Read offset #N$07 of #REGix.
 $B7D0 LD (IX+$07),$08 ; Store #N$08 at offset #N$07 of #REGix.
 $B7D4 CP $20          ; {Jump to #R$B7DC if #REGa is #N$20.
 $B7D6 JR Z,$B7DC      ; }
 $B7D8 LD (IX+$07),$F8 ; Store #N$F8 at offset #N$07 of #REGix.
@label=LaunchShot_Set
*$B7DC LD (IX+$00),$00 ; Store #N$00 at offset #N$00 of #REGix.
 $B7E0 LD (IX+$0D),$DD ; Store #N$DD at offset #N$0D of #REGix.
 $B7E4 LD (IX+$15),$7F ; Store #N$7F at offset #N$15 of #REGix.
 $B7E8 LD (IX+$16),$80 ; Store #N$80 at offset #N$16 of #REGix.
 $B7EC CALL $B8FC      ; Call #R$B8FC.
 $B7EF LD (IX+$17),$F0 ; Store #N$F0 at offset #N$17 of #REGix.
 $B7F3 JP $72F2        ; Jump to #R$72F2.
@label=LaunchShot_Special
*$B7F6 LD A,$80        ; #REGa=#N$80.
 $B7F8 LD (IX+$15),A   ; Write #REGa to offset #N$15 of #REGix.
 $B7FB LD ($B832),A    ; A special shot has been launched.
 $B7FE LD (IX+$0D),$43 ; Store #N$43 at offset #N$0D of #REGix.
 $B802 LD A,($5C38)    ; The ship row.
 $B805 ADD A,$09       ; Add #N$09 to #REGa.
 $B807 LD (IX+$0C),A   ; Write #REGa to offset #N$0C of #REGix.
 $B80A LD A,(IX+$09)   ; Read offset #N$09 of #REGix.
 $B80D ADD A,$09       ; Add #N$09 to #REGa.
 $B80F LD (IX+$09),A   ; Write #REGa to offset #N$09 of #REGix.
 $B812 LD A,(IX+$07)   ; Read offset #N$07 of #REGix.
 $B815 ADD A,$08       ; Add #N$08 to #REGa.
 $B817 AND %00100000   ; Keep the bits of #REGa that are set in #N$20.
 $B819 LD (IX+$07),A   ; Write #REGa to offset #N$07 of #REGix.
 $B81C LD (IX+$12),$F8 ; Store #N$F8 at offset #N$12 of #REGix.
 $B820 LD (IX+$0B),$60 ; Store #N$60 at offset #N$0B of #REGix.
 $B824 JP Z,$B787      ; Jump to #R$B787 if the zero flag is set.
 $B827 LD (IX+$12),$08 ; Store #N$08 at offset #N$12 of #REGix.
 $B82B LD (IX+$0B),$90 ; Store #N$90 at offset #N$0B of #REGix.
 $B82F JP $B787        ; Jump to #R$B787.
 $B832 NOP             ; Do nothing.

; Check Special Shot
;
; Used by the routine at #R$B731.
; .
; Used when the extra key is pressed. If there is no special shot at
; #R$B832 and the ship has part #N$07 and is moving slowly in both
; directions, launches one. If there is one already, goes to #R$B889.
@label=CheckSpecialShot
c$B833 LD A,($B832)   ; The special-shot flag.
 $B836 AND A          ; {Jump to #R$B889 if #REGa is not zero.
 $B837 JR NZ,$B889    ; }
 $B839 LD A,($5C37)   ; The controls.
 $B83C BIT 5,A        ; {Return if bit 5 of #REGa is clear.
 $B83E RET Z          ; }
 $B83F LD A,($F5F4)   ; The seventh part, which makes a special shot.
 $B842 AND A          ; {Return if #REGa is zero.
 $B843 RET Z          ; }
 $B844 LD HL,($C8FE)  ; Fetch the word at #N$C8FE into #REGhl.
 $B847 LD A,H         ; #REGa=#REGh.
 $B848 LD H,L         ; #REGh=#REGl.
 $B849 LD L,A         ; #REGl=#REGa.
 $B84A CALL $BA0B     ; Call #R$BA0B.
 $B84D LD A,H         ; #REGa=#REGh.
 $B84E OR L           ; Set the bits of #REGa that are set in #REGl.
 $B84F RET NZ         ; Return if the zero flag is clear.
 $B850 LD HL,($C900)  ; Fetch the word at #N$C900 into #REGhl.
 $B853 LD A,H         ; #REGa=#REGh.
 $B854 LD H,L         ; #REGh=#REGl.
 $B855 LD L,A         ; #REGl=#REGa.
 $B856 CALL $BA0B     ; Call #R$BA0B.
 $B859 LD A,H         ; #REGa=#REGh.
 $B85A OR L           ; Set the bits of #REGa that are set in #REGl.
 $B85B RET NZ         ; Return if the zero flag is clear.
 $B85C LD A,($B730)   ; The weapon toggle.
 $B85F XOR %00000100  ; Flip the bits of #REGa that are set in #N$04.
 $B861 LD ($B730),A   ; Update the weapon toggle.
 $B864 CALL $B752     ; Call #R$B752.
 $B867 LD A,($B730)   ; The weapon toggle.
 $B86A AND %00000001  ; Keep the bits of #REGa that are set in #N$01.
 $B86C LD ($B730),A   ; Update the weapon toggle.
 $B86F RET            ; Return.
; This entry point is used by the routine at #R$ABA8.
@label=FindShot
*$B870 LD IY,$B37A    ; The shot slots.
 $B874 LD DE,$0018    ; #REGde=#N$18.
 $B877 LD B,$03       ; #REGb=#N$03.
@label=CheckSpecialShot_Loop
*$B879 BIT 7,(IY+$16) ; {Jump to #R$B884 if bit 7 of offset #N$16 of #REGiy is
 $B87D JR NZ,$B884    ; set.}
 $B87F BIT 7,(IY+$15) ; {Return if bit 7 of offset #N$15 of #REGiy is set.
 $B883 RET NZ         ; }
@label=CheckSpecialShot_Next
*$B884 ADD IY,DE      ; #REGiy gains #REGde.
 $B886 DJNZ $B879     ; Decrease #REGb and jump to #R$B879 until none remain.
 $B888 RET            ; Return.
@label=DetonateSpecialShot
*$B889 LD A,($5C37)   ; The controls.
 $B88C BIT 5,A        ; {Return if bit 5 of #REGa is set.
 $B88E RET NZ         ; }
 $B88F CALL $B870     ; Call #R$B870.
 $B892 SET 7,(IY+$10) ; Set bit 7 of offset #N$10 of #REGiy.
 $B896 RET            ; Return.

; Make Shot Row
;
; Used by the routine at #R$B414.
; .
; Builds the picture of a shot from one of the six patterns in the table
; at #R$B8CF, picked by the bottom four bits of offset #N($15), which go round
; from zero to five as the shot is updated. The picture is made in the buffer
; at #N$F800 and its size is stored in #R$A1D7. #R$B8B5 does the same for the
; buffer at #R$F880 and #R$A1D8.
;
; IX Address of the shot
@label=MakeShotRow
c$B897 LD DE,$F800   ; Use #N$F800.
 $B89A CALL $B8C3    ; Call #R$B8C3.
 $B89D LD A,(IX+$15) ; Read offset #N$15 of #REGix.
 $B8A0 AND %00001111 ; Keep the bits of #REGa that are set in #N$0F.
 $B8A2 INC A         ; Advance #REGa.
 $B8A3 CP $06        ; {Jump to #R$B8A8 if #REGa is not #N$06.
 $B8A5 JR NZ,$B8A8   ; }
 $B8A7 XOR A         ; Clear #REGa.
@label=MakeShotRow_Store
*$B8A8 OR %10000000  ; Set the bits of #REGa that are set in #N$80.
 $B8AA LD (IX+$15),A ; Write #REGa to offset #N$15 of #REGix.
 $B8AD EX DE,HL      ; Swap #REGde and #REGhl.
 $B8AE LD A,(DE)     ; Read #REGde.
 $B8AF LD ($A1D7),A  ; The rows of the shot picture.
 $B8B2 JP $B8DB      ; Jump to #R$B8DB.
; This entry point is used by the routine at #R$B414.
@label=MakeShotColumn
*$B8B5 LD DE,$F880   ; The build buffer.
 $B8B8 CALL $B8C3    ; Call #R$B8C3.
 $B8BB EX DE,HL      ; Swap #REGde and #REGhl.
 $B8BC LD A,(DE)     ; Read #REGde.
 $B8BD LD ($A1D8),A  ; The rows of the shot column.
 $B8C0 JP $B8DB      ; Jump to #R$B8DB.
@label=FindShotPattern
*$B8C3 LD A,(IX+$15) ; Read offset #N$15 of #REGix.
 $B8C6 AND %00001111 ; Keep the bits of #REGa that are set in #N$0F.
 $B8C8 LD C,A        ; #REGc=#REGa.
 $B8C9 LD HL,$B8CF   ; The shot pattern table.
 $B8CC JP $A1AA      ; Jump to #R$A1AA.

; Shot Pattern Table
;
; The addresses of the six patterns that #R$B897 and #R$B8B5 use for the
; shots, in the order that they are used.
@label=ShotPatternTable
w$B8CF DEFW $803B
 $B8D1 DEFW $8046
 $B8D3 DEFW $8053
 $B8D5 DEFW $8062
 $B8D7 DEFW $8053
 $B8D9 DEFW $8046

; Build Shot Pattern
;
; Used by the routine at #R$B897.
; .
; Builds the rows of a pattern in a buffer. The first byte of the pattern
; is the number of rows and each row is two bytes, which are repeated four times
; in the buffer. Returns with the start of the buffer in #REGde, which has one
; added to #REGe if the shot is facing left and bit 0 of its length is set.
;
;   A Number of rows
;   DE Address of the pattern
;   HL Address of the buffer
;   IX Address of the shot
; O:DE Address of the buffer
@label=BuildShotPattern
c$B8DB PUSH HL        ; Stash #REGhl on the stack.
 $B8DC INC DE         ; Advance #REGde.
@label=BuildShotPattern_Loop
*$B8DD EX AF,AF'      ; Switch to the alternate accumulator and flags.
 $B8DE LD A,(DE)      ; Read #REGde.
 $B8DF LD C,A         ; #REGc=#REGa.
 $B8E0 INC DE         ; Advance #REGde.
 $B8E1 LD A,(DE)      ; Read #REGde.
 $B8E2 INC DE         ; Advance #REGde.
 $B8E3 LD B,$04       ; #REGb=#N$04.
@label=BuildShotPattern_Row
*$B8E5 LD (HL),C      ; Write #REGc where #REGhl points.
 $B8E6 INC L          ; Advance #REGl.
 $B8E7 LD (HL),A      ; Write #REGa where #REGhl points.
 $B8E8 INC L          ; Advance #REGl.
 $B8E9 DJNZ $B8E5     ; Decrease #REGb and jump to #R$B8E5 until none remain.
 $B8EB EX AF,AF'      ; Switch to the alternate accumulator and flags.
 $B8EC DEC A          ; Step #REGa back.
 $B8ED JR NZ,$B8DD    ; Jump to #R$B8DD if the zero flag is clear.
 $B8EF POP DE         ; Bring #REGde back off the stack.
 $B8F0 BIT 7,(IX+$00) ; {Return if bit 7 of offset #N$00 of #REGix is clear.
 $B8F4 RET Z          ; }
 $B8F5 BIT 0,(IX+$0E) ; {Return if bit 0 of offset #N$0E of #REGix is clear.
 $B8F9 RET Z          ; }
 $B8FA INC E          ; Advance #REGe.
 $B8FB RET            ; Return.

; Clear Shot
;
; Used by the routines at #R$994B, #R$AC34, #R$B752 and #R$BA21.
; .
; Clears offsets #N($0B), #N($0C), #N($0E) and #N($0F) of a shot.
;
; IX Address of the shot
@label=ClearShot
c$B8FC XOR A         ; Clear #REGa.
 $B8FD LD (IX+$0B),A ; Write the high byte of the horizontal acceleration.
 $B900 LD (IX+$0C),A ; Write the low byte of the horizontal acceleration.
 $B903 LD (IX+$0E),A ; Write the high byte of the vertical acceleration.
 $B906 LD (IX+$0F),A ; Write the low byte of the vertical acceleration.
 $B909 RET           ; Return.

; Start Shot At Ship
;
; Used by the routine at #R$B752.
; .
; Gives a new shot the position of the ship, and a horizontal speed of
; #N($08) if bit 7 of its type is set or #N($18) if not. Its vertical speed is
; the value at #R$5C38 less the vertical position of the ship.
;
; IX Address of the shot
@label=StartShotAtShip
c$B90A LD A,($C903)    ; The row the ship was drawn on.
 $B90D LD B,A          ; #REGb=#REGa.
 $B90E LD A,($5C38)    ; The ship row.
 $B911 SUB B           ; Subtract #REGb from #REGa.
 $B912 LD (IX+$09),A   ; Write the high byte of the vertical speed.
 $B915 LD HL,($C8E6)   ; Fetch the word at #N$C8E6 into #REGhl.
 $B918 LD DE,($C8E9)   ; Fetch the word at #N$C8E9 into #REGde.
 $B91C LD (IX+$01),L   ; Write the map column.
 $B91F LD (IX+$02),H   ; Write the horizontal position.
 $B922 LD (IX+$04),E   ; Write the map zone.
 $B925 LD (IX+$05),D   ; Write the vertical position.
 $B928 LD (IX+$07),$08 ; Store #N$08 at offset #N$07 of #REGix.
 $B92C BIT 7,(IX+$00)  ; {Return if bit 7 of offset #N$00 of #REGix is set.
 $B930 RET NZ          ; }
 $B931 LD (IX+$07),$18 ; Store #N$18 at offset #N$07 of #REGix.
 $B935 RET             ; Return.

; Shot Frame Table
;
; The table of sprites for type #N($00), which is the type of a shot,
; followed by the two sprites (a width of one byte and three rows each).
; The two bytes after them make a record of a tile that has nothing in it, for
; #R$B946 to return when it finds no tile.
@label=ShotFrameTable
b$B936 DEFW $B93A
 $B938 DEFW $B93F
 $B93A DEFB $01,$03,$BC,$BF,$BC
 $B93F DEFB $01,$03,$3D,$FD,$3D
@label=ShotFrameTable_Records
 $B944 DEFB $00,$FF

; Find Tile Record
;
; Used by the routine at #R$BEE7.
; .
; Looks for the record of the tile at a position of the planet, in the
; four records that are kept at #R$5B80 and then every #N($25) bytes, which are
; for the tile at the map position in #R$CE57 and the ones next to it. If none
; of them match, the address of an empty record is returned.
;
;   B Map zone
;   D Map column
; O:IX Address of the record of the tile
; O:F The zero flag is set if the tile was found
@label=FindTileRecord
c$B946 LD E,B        ; #REGe=#REGb.
 $B947 LD IX,$5B80   ; The decryption routine.
 $B94B LD BC,($CE57) ; Fetch the word at #R$CE57 into #REGbc.
 $B94F CALL $B97A    ; Call #R$B97A.
 $B952 RET Z         ; Return if the zero flag is set.
 $B953 LD IX,$5BA5   ; Use #N$5BA5.
 $B957 INC B         ; Advance #REGb.
 $B958 CALL $B97A    ; Call #R$B97A.
 $B95B RET Z         ; Return if the zero flag is set.
 $B95C LD IX,$5BEF   ; Use #N$5BEF.
 $B960 INC C         ; Advance #REGc.
 $B961 LD A,C        ; #REGa=#REGc.
 $B962 CP $60        ; {Jump to #R$B968 if #REGa is not #N$60.
 $B964 JR NZ,$B968   ; }
 $B966 LD C,$00      ; Clear #REGc.
@label=FindTileRecord_Column
*$B968 CALL $B97A    ; Call #R$B97A.
 $B96B RET Z         ; Return if the zero flag is set.
 $B96C DEC B         ; Step #REGb back.
 $B96D LD IX,$5BCA   ; Use #N$5BCA.
 $B971 CALL $B97A    ; Call #R$B97A.
 $B974 RET Z         ; Return if the zero flag is set.
 $B975 LD IX,$B944   ; The shot frame records.
 $B979 RET           ; Return.

; Compare Tile Position
;
; Used by the routine at #R$B946.
; .
; Compares a map column and zone with another.
;
;   B Zone
;   C Column
;   D Column to compare
;   E Zone to compare
; O:F The zero flag is set if they are the same
@label=CompareTilePosition
c$B97A LD A,D        ; #REGa=#REGd.
 $B97B CP C          ; {Return if #REGa is not #REGc.
 $B97C RET NZ        ; }
 $B97D LD A,E        ; #REGa=#REGe.
 $B97E CP B          ; Compare #REGa with #REGb.
 $B97F RET           ; Return.

; Find Horizontal Move
;
; Used by the routines at #R$BA21, #R$BE8F and #R$BF66.
; .
; Works out the horizontal position of an object after it has moved by
; its horizontal speed, which is wrapped around to the next map column, or the
; previous one, when it goes off the edge of the column. There are #N($60)
; columns.
;
;   IX Address of the object
; O:H Map column
; O:L Horizontal position
; O:E Fraction of the horizontal position
@label=FindHorizontalMove
c$B980 LD H,(IX+$02) ; The horizontal position.
 $B983 LD L,(IX+$03) ; Read offset #N$03 of #REGix into #REGl.
 $B986 LD D,(IX+$07) ; The high byte of the horizontal speed.
 $B989 LD E,(IX+$08) ; The low byte of the horizontal speed.
 $B98C ADD HL,DE     ; #REGhl gains #REGde.
 $B98D LD E,L        ; #REGe=#REGl.
 $B98E LD L,H        ; #REGl=#REGh.
 $B98F LD H,(IX+$01) ; The map column.
 $B992 LD C,(IX+$02) ; The horizontal position.
 $B995 LD A,L        ; #REGa=#REGl.
 $B996 BIT 7,D       ; {Jump to #R$B9AA if bit 7 of #REGd is set.
 $B998 JR NZ,$B9AA   ; }
@label=FindHorizontalMove_Right
 $B99A CP $E8        ; {Jump to #R$B9A0 if #REGa is #N$E8 or more.
 $B99C JR NC,$B9A0   ; }
 $B99E CP C          ; {Return if #REGa is #REGc or more.
 $B99F RET NC        ; }
@label=FindHorizontalMove_Next
*$B9A0 SUB $E0       ; Subtract #N$E0 from #REGa.
 $B9A2 LD L,A        ; #REGl=#REGa.
 $B9A3 INC H         ; Advance #REGh.
 $B9A4 LD A,H        ; #REGa=#REGh.
 $B9A5 SUB $60       ; Subtract #N$60 from #REGa.
 $B9A7 RET NZ        ; Return if the zero flag is clear.
 $B9A8 LD H,A        ; #REGh=#REGa.
 $B9A9 RET           ; Return.
@label=FindHorizontalMove_Left
*$B9AA CP $08        ; {Jump to #R$B9B1 if #REGa is less than #N$08.
 $B9AC JR C,$B9B1    ; }
 $B9AE CP C          ; {Return if #REGa is less than #REGc.
 $B9AF RET C         ; }
 $B9B0 RET Z         ; Return if the zero flag is set.
@label=FindHorizontalMove_Previous
*$B9B1 ADD A,$E0     ; Add #N$E0 to #REGa.
 $B9B3 LD L,A        ; #REGl=#REGa.
 $B9B4 DEC H         ; Step #REGh back.
 $B9B5 LD A,H        ; #REGa=#REGh.
 $B9B6 INC A         ; Advance #REGa.
 $B9B7 RET NZ        ; Return if the zero flag is clear.
 $B9B8 LD H,$5F      ; #REGh=#N$5F.
 $B9BA RET           ; Return.

; Find Vertical Move
;
; Used by the routines at #R$AFE9, #R$BE8F and #R$BF66.
; .
; Works out the vertical position of an object after it has moved by
; its vertical speed, in the same way as #R$B980 does for the horizontal
; position. The zone changes when the position goes beyond the limits of
; #N($18) and #N($B8).
;
;   IX Address of the object
; O:H Map zone
; O:L Vertical position
; O:E Fraction of the vertical position
@label=FindVerticalMove
c$B9BB LD H,(IX+$05) ; The vertical position.
 $B9BE LD L,(IX+$06) ; Read offset #N$06 of #REGix into #REGl.
 $B9C1 LD D,(IX+$09) ; The high byte of the vertical speed.
 $B9C4 LD E,(IX+$0A) ; The low byte of the vertical speed.
 $B9C7 ADD HL,DE     ; #REGhl gains #REGde.
 $B9C8 LD E,L        ; #REGe=#REGl.
 $B9C9 LD L,H        ; #REGl=#REGh.
 $B9CA LD H,(IX+$04) ; The map zone.
 $B9CD LD C,(IX+$05) ; The vertical position.
 $B9D0 LD A,L        ; #REGa=#REGl.
 $B9D1 BIT 7,D       ; {Jump to #R$B9E0 if bit 7 of #REGd is set.
 $B9D3 JR NZ,$B9E0   ; }
 $B9D5 CP $B8        ; {Jump to #R$B9DB if #REGa is #N$B8 or more.
 $B9D7 JR NC,$B9DB   ; }
 $B9D9 CP C          ; {Return if #REGa is #REGc or more.
 $B9DA RET NC        ; }
@label=FindVerticalMove_Down
*$B9DB SUB $A0       ; Subtract #N$A0 from #REGa.
 $B9DD LD L,A        ; #REGl=#REGa.
 $B9DE INC H         ; Advance #REGh.
 $B9DF RET           ; Return.
@label=FindVerticalMove_Up
*$B9E0 CP $18        ; {Jump to #R$B9E7 if #REGa is less than #N$18.
 $B9E2 JR C,$B9E7    ; }
 $B9E4 CP C          ; {Return if #REGa is less than #REGc.
 $B9E5 RET C         ; }
 $B9E6 RET Z         ; Return if the zero flag is set.
@label=FindVerticalMove_Previous
*$B9E7 ADD A,$A0     ; Add #N$A0 to #REGa.
 $B9E9 LD L,A        ; #REGl=#REGa.
 $B9EA DEC H         ; Step #REGh back.
 $B9EB RET           ; Return.

; Set Ship Speeds
;
; Used by the routines at #R$AA94, #R$AFE9 and #R$C374.
; .
; Gives the ship (at #R$C8E5) horizontal and vertical speeds that are
; the opposite of the two scroll speeds, with no fractions. Moving the ship
; at these speeds makes it stay in the same place on the screen.
@label=SetShipSpeeds
c$B9EC LD IX,$C8E5     ; The ship.
 $B9F0 LD A,($CCBB)    ; The horizontal scroll speed.
 $B9F3 NEG             ; Negate #REGa.
 $B9F5 LD (IX+$07),A   ; Write #REGa to offset #N$07 of #REGix.
 $B9F8 LD A,($CCBA)    ; The vertical scroll speed.
 $B9FB NEG             ; Negate #REGa.
 $B9FD LD (IX+$09),A   ; Write #REGa to offset #N$09 of #REGix.
 $BA00 LD (IX+$08),$00 ; Store #N$00 at offset #N$08 of #REGix.
 $BA04 LD (IX+$0A),$00 ; Store #N$00 at offset #N$0A of #REGix.
 $BA08 RET             ; Return.
 $BA09 NOP             ; Do nothing.
 $BA0A NOP             ; Do nothing.

; Zero Small Speed
;
; Used by the routines at #R$AA27, #R$B833 and #R$BA21.
; .
; Sets a speed to zero if it is too small to matter. The speed is a
; signed number, which is changed if it is below #N($0064) or above #N($FF58).
;
;   HL Speed
; O:HL New speed
@label=ZeroSmallSpeed
c$BA0B LD A,H        ; #REGa=#REGh.
 $BA0C AND A         ; {Jump to #R$BA17 if #REGa is not zero.
 $BA0D JR NZ,$BA17   ; }
 $BA0F LD A,L        ; #REGa=#REGl.
 $BA10 CP $64        ; {Return if #REGa is #N$64 or more.
 $BA12 RET NC        ; }
 $BA13 LD HL,$0000   ; #REGhl=#N$00.
 $BA16 RET           ; Return.
@label=ZeroSmallSpeed_Negative
*$BA17 INC A         ; Advance #REGa.
 $BA18 RET NZ        ; Return if the zero flag is clear.
 $BA19 LD A,L        ; #REGa=#REGl.
 $BA1A CP $58        ; {Return if #REGa is less than #N$58.
 $BA1C RET C         ; }
 $BA1D LD HL,$0000   ; #REGhl=#N$00.
 $BA20 RET           ; Return.

; Check Terrain Collision
;
; Used by the routines at #R$9056 and #R$C374.
; .
; Checks whether an object has run into the terrain and bounces it when
; it has. The tiles come from #R$BE8F and #R$BE43. A tile record starts with
; the number of boxes, and each box is five bytes: its position, its width,
; its height and its flags. Bits 2 to 5 clear means a slope (#R$9E35);
; otherwise the box is a rectangle (#R$9DB1). A rectangle with bits 4 and 5
; clear reverses, halves and limits the vertical speed. Any other rectangle
; does the same to the horizontal speed, and skips the halving when the
; collision mode is zero. The mode in #R$5C25 is #N$FF for the ship, #N$80
; when the object should stop, and zero otherwise. The ship also plays the
; crash or bump sound and changes the scroll speed.
;
;   B Height of the object
;   C Width of the object
;   IX Address of the object
; O:$5C1C Non-zero if the object hit something
@label=CheckTerrainCollision
c$BA21 XOR A           ; Clear the hit flag.
 $BA22 LD ($5C1C),A    ; The hit flag at #R$5C1C starts clear.
 $BA25 LD ($BA09),IX   ; Keep the address of the object.
 $BA29 CALL $BE8F      ; Find the tiles the object overlaps.
 $BA2C JR $BA31        ; Test the first of those tiles.
@label=CheckTerrainCollision_NextTiles
*$BA2E CALL $BE43      ; The next overlapping tile.
@label=CheckTerrainCollision_Tile
*$BA31 LD A,(IX+$00)   ; The number of boxes in this tile.
 $BA34 AND A           ; {None: on to the next tile.
 $BA35 JR Z,$BA5F      ; }
 $BA37 INC IX          ; The first box of the tile.
@label=CheckTerrainCollision_Box
*$BA39 PUSH IX         ; Keep the address of this box.
 $BA3B EX AF,AF'       ; The box count is in the alternate accumulator.
 $BA3C XOR A           ; Clear the hit flag for this box.
 $BA3D LD ($5C1C),A    ; The hit flag starts clear.
 $BA40 LD A,(IX+$04)   ; The flags of this box.
 $BA43 LD ($5C20),A    ; Keep the flags.
 $BA46 AND %00111100   ; Bits 2 to 5 mark a rectangle.
 $BA48 JR NZ,$BA8F     ; A rectangle is tested below.
 $BA4A JP $BC13        ; Otherwise the box is a slope.
@label=CheckTerrainCollision_Check
*$BA4D LD A,($5C35)    ; The collision status.
 $BA50 BIT 6,A         ; {Jump to #R$BA76 if bit 6 of #REGa is set.
 $BA52 JR NZ,$BA76     ; }
@label=CheckTerrainCollision_NextBox
*$BA54 POP IX          ; Back to this box.
 $BA56 LD DE,$0005     ; A box is five bytes.
 $BA59 ADD IX,DE       ; The next box.
 $BA5B EX AF,AF'       ; Back to the box count.
 $BA5C DEC A           ; One box has been tested.
 $BA5D JR NZ,$BA39     ; Repeat while boxes remain.
@label=CheckTerrainCollision_Done
*$BA5F LD A,($5C1D)    ; The tiles still to test.
 $BA62 DEC A           ; One tile has been tested.
 $BA63 LD ($5C1D),A    ; Remember how many tiles remain.
 $BA66 JP NZ,$BA2E     ; Jump to #R$BA2E if the zero flag is clear.
 $BA69 LD IX,($BA09)   ; Fetch the word at #R$BA09 into #REGix.
 $BA6D LD A,($5C25)    ; The collision mode.
 $BA70 INC A           ; The ship is mode #N$FF, which becomes zero here.
 $BA71 RET NZ          ; Return if the zero flag is clear.
 $BA72 LD ($BC12),A    ; The ship has finished this check.
 $BA75 RET             ; Return.
@label=CheckTerrainCollision_Stop
*$BA76 LD A,($8F53)    ; The ship state.
 $BA79 CP $0A          ; {Jump to #R$BA86 if #REGa is less than #N$0A.
 $BA7B JR C,$BA86      ; }
 $BA7D LD A,($5C25)    ; The collision mode.
 $BA80 AND A           ; {Jump to #R$BA86 if #REGa is not zero.
 $BA81 JR NZ,$BA86     ; }
 $BA83 JP $BA54        ; Jump to #R$BA54.
@label=CheckTerrainCollision_Return
*$BA86 POP IX          ; Discard the box address.
 $BA88 LD IX,($BA09)   ; Fetch the word at #R$BA09 into #REGix.
 $BA8C RET             ; Return.
 $BA8D NOP             ; Do nothing.
 $BA8E NOP             ; Do nothing.
@label=CheckTerrainCollision_Rectangle
*$BA8F LD A,($5C35)    ; The collision status.
 $BA92 BIT 7,A         ; {Jump to #R$BA4D if bit 7 of #REGa is set.
 $BA94 JP NZ,$BA4D     ; }
 $BA97 LD HL,($CE3A)   ; Fetch the word at #R$CE3A into #REGhl.
 $BA9A LD A,($5C25)    ; The collision mode.
 $BA9D CP $80          ; {Jump to #R$BB0D if #REGa is #N$80.
 $BA9F JR Z,$BB0D      ; }
 $BAA1 LD A,($5C25)    ; The collision mode again.
 $BAA4 INC A           ; The ship is the only object tested here.
 $BAA5 JP NZ,$BADE     ; Jump to #R$BADE if the zero flag is clear.
 $BAA8 LD A,L          ; The low byte of the position in the tile.
 $BAA9 ADD A,$04       ; Add #N$04 to #REGa.
 $BAAB CP $E8          ; {Jump to #R$BAB1 if #REGa is less than #N$E8.
 $BAAD JR C,$BAB1      ; }
 $BAAF LD A,$E8        ; Do not test past column #N$E8.
@label=CheckTerrainCollision_Limit
*$BAB1 LD D,A          ; The near edge of the test.
 $BAB2 ADD A,$24       ; Add #N$24 to #REGa.
 $BAB4 JR NC,$BAB8     ; Jump to #R$BAB8 if the carry flag is clear.
 $BAB6 LD A,$F8        ; Do not test past column #N$F8.
@label=CheckTerrainCollision_Lower
*$BAB8 LD E,A          ; The far edge of the test.
 $BAB9 BIT 2,(IX+$04)  ; {Jump to #R$BADE if bit 2 of offset #N$04 of #REGix is
 $BABD JR Z,$BADE      ; clear.}
 $BABF LD A,($F5EF)    ; The second part flag.
 $BAC2 AND A           ; {Jump to #R$BADE if #REGa is not zero.
 $BAC3 JR NZ,$BADE     ; }
 $BAC5 LD A,(IX+$01)   ; The box's other coordinate.
 $BAC8 SUB H           ; Subtract #REGh from #REGa.
 $BAC9 JR C,$BADE      ; Jump to #R$BADE if the carry flag is set.
 $BACB CP $29          ; {Jump to #R$BADE if #REGa is #N$29 or more.
 $BACD JR NC,$BADE     ; }
 $BACF LD A,(IX+$00)   ; The box's first coordinate.
 $BAD2 CP E            ; {Jump to #R$BADE if #REGa is #REGe or more.
 $BAD3 JR NC,$BADE     ; }
 $BAD5 ADD A,(IX+$02)  ; Add the byte at offset #N$02 of #REGix to #REGa.
 $BAD8 CP D            ; {Jump to #R$BADE if #REGa is less than #REGd.
 $BAD9 JR C,$BADE      ; }
 $BADB LD ($C6D0),A    ; The ship has landed on this box.
@label=CheckTerrainCollision_Flags
*$BADE LD A,(IX+$04)   ; The box flags.
 $BAE1 AND %00110000   ; Bits 4 and 5 select a sideways face.
 $BAE3 JR NZ,$BAFA     ; Jump to #R$BAFA if the zero flag is clear.
 $BAE5 LD A,($BE8E)    ; The saved vertical speed.
 $BAE8 AND A           ; {Jump to #R$BB0D if #REGa is zero.
 $BAE9 JR Z,$BB0D      ; }
 $BAEB BIT 2,(IX+$04)  ; {Jump to #R$BAF3 if bit 2 of offset #N$04 of #REGix is
 $BAEF JR NZ,$BAF3     ; set.}
 $BAF1 NEG             ; Negate #REGa.
@label=CheckTerrainCollision_Skip
*$BAF3 BIT 7,A         ; {Jump to #R$BA4D if bit 7 of #REGa is set.
 $BAF5 JP NZ,$BA4D     ; }
 $BAF8 JR $BB0D        ; Jump to #R$BB0D.
@label=CheckTerrainCollision_Test2
*$BAFA BIT 4,A         ; Test bit 4 of #REGa.
 $BAFC LD A,($BE8D)    ; The saved horizontal speed.
 $BAFF JR NZ,$BB03     ; Jump to #R$BB03 if the zero flag is clear.
 $BB01 NEG             ; Negate #REGa.
@label=CheckTerrainCollision_Check2
*$BB03 AND A           ; {Jump to #R$BB0D if #REGa is zero.
 $BB04 JR Z,$BB0D      ; }
 $BB06 BIT 7,A         ; {Jump to #R$BA4D if bit 7 of #REGa is clear.
 $BB08 JP Z,$BA4D      ; }
 $BB0B JR $BB0D        ; Jump to #R$BB0D.
@label=CheckTerrainCollision_Test
*$BB0D LD DE,($CE3C)   ; Fetch the word at #R$CE3C into #REGde.
 $BB11 CALL $9DB1      ; Call #R$9DB1.
 $BB14 LD A,($5C1C)    ; The hit flag from the rectangle test.
 $BB17 AND A           ; {Jump to #R$BA4D if #REGa is zero.
 $BB18 JP Z,$BA4D      ; }
 $BB1B LD A,($5C25)    ; The collision mode.
 $BB1E CP $80          ; {Jump to #R$BA76 if #REGa is #N$80.
 $BB20 JP Z,$BA76      ; }
 $BB23 LD A,$80        ; A rectangle hit is marked with #N$80.
 $BB25 LD ($5C35),A    ; Remember that hit in the collision status.
 $BB28 LD A,(IX+$01)   ; The box's second coordinate.
 $BB2B SUB $14         ; Subtract #N$14 from #REGa.
 $BB2D LD ($DEDC),A    ; Keep that coordinate.
 $BB30 LD A,(IX+$04)   ; The box flags again.
 $BB33 LD ($DEDD),A    ; Keep the box flags.
 $BB36 LD B,A          ; The flags, kept for the bounce.
 $BB37 AND %00110000   ; Bits 4 and 5 mean the face is sideways.
 $BB39 LD IX,($BA09)   ; Fetch the word at #R$BA09 into #REGix.
 $BB3D JP NZ,$BBCD     ; Jump to #R$BBCD if the zero flag is clear.
 $BB40 LD A,($5C25)    ; The collision mode.
 $BB43 AND A           ; {Jump to #R$BB57 if #REGa is zero.
 $BB44 JR Z,$BB57      ; }
 $BB46 BIT 3,B         ; {Jump to #R$BB64 if bit 3 of #REGb is clear.
 $BB48 JR Z,$BB64      ; }
 $BB4A LD A,($F5F6)    ; The ninth part flag.
 $BB4D AND A           ; {Jump to #R$BB64 if #REGa is not zero.
 $BB4E JR NZ,$BB64     ; }
 $BB50 LD A,$04        ; Four frames of the hit flash.
 $BB52 LD ($C7C1),A    ; Start the hit flash.
 $BB55 JR $BB64        ; Jump to #R$BB64.
@label=CheckTerrainCollision_Free
*$BB57 CALL $B8FC      ; Call #R$B8FC.
 $BB5A BIT 3,B         ; {Jump to #R$BB64 if bit 3 of #REGb is set.
 $BB5C JR NZ,$BB64     ; }
 $BB5E LD A,($DEDC)    ; The coordinate the object should stand on.
 $BB61 LD (IX+$05),A   ; Put the object on that row.
@label=CheckTerrainCollision_Vertical
*$BB64 LD H,(IX+$09)   ; The high byte of the vertical speed.
 $BB67 LD L,(IX+$0A)   ; The low byte of the vertical speed.
 $BB6A CALL $BE08      ; Call #R$BE08.
 $BB6D CALL $BE03      ; Call #R$BE03.
 $BB70 CALL $C880      ; Call #R$C880.
 $BB73 CALL $BA0B      ; Call #R$BA0B.
@label=CheckTerrainCollision_StoreVertical
 $BB76 LD (IX+$09),H   ; The bounced vertical speed.
 $BB79 LD (IX+$0A),L   ; The low byte of the bounced vertical speed.
 $BB7C LD A,H          ; The high byte of that speed.
 $BB7D LD ($BE8E),A    ; Keep it for the next box.
 $BB80 OR L            ; Set the bits of #REGa that are set in #REGl.
 $BB81 JR Z,$BB8D      ; Jump to #R$BB8D if the zero flag is set.
 $BB83 LD A,($5C35)    ; The collision status.
 $BB86 OR %01000000    ; Set the bits of #REGa that are set in #N$40.
 $BB88 LD ($5C35),A    ; Note that the object is still moving vertically.
 $BB8B JR $BB9C        ; Jump to #R$BB9C.
@label=CheckTerrainCollision_Still
*$BB8D LD A,($5C25)    ; The collision mode.
 $BB90 INC A           ; See whether this is the ship.
 $BB91 JR Z,$BB9C      ; Jump to #R$BB9C if the zero flag is set.
 $BB93 BIT 3,B         ; {Jump to #R$BA4D if bit 3 of #REGb is clear.
 $BB95 JP Z,$BA4D      ; }
 $BB98 LD (IX+$09),$FE ; Store #N$FE at offset #N$09 of #REGix.
@label=CheckTerrainCollision_Ship
*$BB9C LD A,($5C25)    ; The collision mode.
 $BB9F INC A           ; The ship is mode #N$FF.
 $BBA0 JP NZ,$BA4D     ; Jump to #R$BA4D if the zero flag is clear.
 $BBA3 LD A,L          ; The low byte of the bounced speed.
 $BBA4 OR H            ; Set the bits of #REGa that are set in #REGh.
 $BBA5 CALL NZ,$7293   ; Call #R$7293 if the zero flag is clear.
 $BBA8 LD DE,$0000     ; No fractional vertical scroll.
 $BBAB LD ($B320),DE   ; Clear the vertical scroll fraction.
 $BBAF CALL $B2D5      ; Call #R$B2D5.
 $BBB2 LD A,($DEDD)    ; The box flags that were hit.
 $BBB5 CP $04          ; {Jump to #R$BA4D if #REGa is not #N$04.
 $BBB7 JP NZ,$BA4D     ; }
 $BBBA LD A,($C8EA)    ; The ship's map zone.
 $BBBD LD B,A          ; Keep the map zone.
 $BBBE LD A,($DEDC)    ; The box coordinate.
 $BBC1 CP B            ; {Jump to #R$BA4D if #REGa is #REGb or more.
 $BBC2 JP NC,$BA4D     ; }
 $BBC5 LD A,$02        ; A small downward scroll.
 $BBC7 LD ($CCBA),A    ; Scroll the world down by two.
 $BBCA JP $BA4D        ; Jump to #R$BA4D.
@label=CheckTerrainCollision_Wall
*$BBCD LD H,(IX+$07)   ; The high byte of the horizontal speed.
 $BBD0 LD L,(IX+$08)   ; The low byte of the horizontal speed.
 $BBD3 CALL $BE08      ; Call #R$BE08.
 $BBD6 LD A,($5C25)    ; The collision mode.
 $BBD9 AND A           ; {Jump to #R$BBE1 if #REGa is not zero.
 $BBDA JR NZ,$BBE1     ; }
 $BBDC CALL $B8FC      ; Call #R$B8FC.
 $BBDF JR $BBEA        ; Jump to #R$BBEA.
@label=CheckTerrainCollision_Update
*$BBE1 CALL $BE03      ; Call #R$BE03.
 $BBE4 CALL $C880      ; Call #R$C880.
 $BBE7 CALL $BA0B      ; Call #R$BA0B.
@label=CheckTerrainCollision_StoreHorizontal
*$BBEA LD (IX+$07),H   ; The bounced horizontal speed.
 $BBED LD (IX+$08),L   ; The low byte of the bounced horizontal speed.
 $BBF0 LD A,H          ; The high byte of that speed.
 $BBF1 LD ($BE8D),A    ; Keep it for the next box.
 $BBF4 LD A,($5C25)    ; The collision mode.
 $BBF7 INC A           ; The ship is mode #N$FF.
 $BBF8 JP NZ,$BA4D     ; Jump to #R$BA4D if the zero flag is clear.
 $BBFB LD A,L          ; The low byte of the bounced speed.
 $BBFC OR H            ; Set the bits of #REGa that are set in #REGh.
 $BBFD CALL NZ,$7263   ; Call #R$7263 if the zero flag is clear.
 $BC00 LD DE,$0000     ; No fractional horizontal scroll.
 $BC03 LD ($C7FA),DE   ; Clear the horizontal scroll fraction.
 $BC07 CALL $C81F      ; Call #R$C81F.
 $BC0A LD A,$01        ; The ship has hit a wall.
 $BC0C LD ($D0BC),A    ; The collision kind is the terrain.
 $BC0F JP $BA4D        ; Jump to #R$BA4D.
 $BC12 NOP             ; Do nothing.
@label=CheckTerrainCollision_Slope
*$BC13 LD A,($5C35)    ; The collision status.
 $BC16 BIT 4,A         ; {Jump to #R$BA4D if bit 4 of #REGa is set.
 $BC18 JP NZ,$BA4D     ; }
 $BC1B CALL $9E35      ; Call #R$9E35.
 $BC1E LD A,($5C1C)    ; The hit flag from the slope test.
 $BC21 AND A           ; {Jump to #R$BA4D if #REGa is zero.
 $BC22 JP Z,$BA4D      ; }
 $BC25 LD A,($5C35)    ; The collision status.
 $BC28 OR %00010000    ; Set the bits of #REGa that are set in #N$10.
 $BC2A LD ($5C35),A    ; Note that a slope has been hit.
 $BC2D LD A,($5C25)    ; The collision mode.
 $BC30 CP $80          ; {Jump to #R$BA76 if #REGa is #N$80.
 $BC32 JP Z,$BA76      ; }
 $BC35 AND A           ; {Jump to #R$BC3C if #REGa is zero.
 $BC36 JR Z,$BC3C      ; }
 $BC38 DEC A           ; One less than the mode.
 $BC39 LD ($D0BC),A    ; The collision kind follows the mode.
@label=CheckTerrainCollision_Kind
*$BC3C LD A,(IX+$04)   ; The slope flags.
 $BC3F LD ($5C20),A    ; Keep the slope flags.
 $BC42 AND %01111111   ; The steepness and the facing, without bit 7.
 $BC44 CP $02          ; {Jump to #R$BD04 if #REGa is #N$02.
 $BC46 JP Z,$BD04      ; }
 $BC49 AND %00000111   ; The steepness.
 $BC4B CP $02          ; {Jump to #R$BD3B if #REGa is #N$02.
 $BC4D JP Z,$BD3B      ; }
 $BC50 LD A,(IX+$04)   ; The slope flags again.
 $BC53 BIT 6,A         ; {Jump to #R$BD44 if bit 6 of #REGa is clear.
 $BC55 JP Z,$BD44      ; }
 $BC58 JP $BDBD        ; Jump to #R$BDBD.
@label=CheckTerrainCollision_Bounce
*$BC5B LD IX,($BA09)   ; Fetch the word at #R$BA09 into #REGix.
 $BC5F LD A,($5C25)    ; The collision mode.
 $BC62 INC A           ; See whether this is the ship.
 $BC63 JR Z,$BC9A      ; Jump to #R$BC9A if the zero flag is set.
 $BC65 LD L,(IX+$07)   ; The high byte of the horizontal speed, kept in #REGl.
 $BC68 LD H,(IX+$08)   ; The low byte of the horizontal speed, kept in #REGh.
 $BC6B LD ($BA8D),HL   ; Keep the old horizontal speed.
 $BC6E LD A,($5C1A)    ; How far the object went into the slope.
 $BC71 NEG             ; Negate #REGa.
 $BC73 LD (IX+$07),A   ; The horizontal speed becomes that depth, reversed.
 $BC76 BIT 7,A         ; {Jump to #R$BC7C if bit 7 of #REGa is clear.
 $BC78 JR Z,$BC7C      ; }
 $BC7A NEG             ; Negate #REGa.
@label=CheckTerrainCollision_Speed
*$BC7C CP $10          ; {Jump to #R$BC84 if #REGa is less than #N$10.
 $BC7E JR C,$BC84      ; }
 $BC80 SET 3,(IX+$10)  ; Set bit 3 of offset #N$10 of #REGix.
@label=CheckTerrainCollision_Position
*$BC84 LD (IX+$08),$00 ; Store #N$00 at offset #N$08 of #REGix.
 $BC88 CALL $B980      ; Call #R$B980.
 $BC8B LD (IX+$01),H   ; The map column after the bounce.
 $BC8E LD (IX+$02),L   ; The horizontal position after the bounce.
 $BC91 LD HL,($BA8D)   ; Fetch the word at #R$BA8D into #REGhl.
 $BC94 LD (IX+$07),L   ; Restore the high byte of the old horizontal speed.
 $BC97 LD (IX+$08),H   ; Restore the low byte of the old horizontal speed.
@label=CheckTerrainCollision_Clear
*$BC9A CALL $B8FC      ; Call #R$B8FC.
 $BC9D LD H,(IX+$09)   ; The high byte of the vertical speed.
 $BCA0 LD L,(IX+$0A)   ; The low byte of the vertical speed.
 $BCA3 CALL $BA0B      ; Call #R$BA0B.
 $BCA6 LD A,L          ; The low byte of the vertical speed.
 $BCA7 OR H            ; Set the bits of #REGa that are set in #REGh.
 $BCA8 JR NZ,$BCD1     ; Jump to #R$BCD1 if the zero flag is clear.
 $BCAA LD H,(IX+$07)   ; The high byte of the horizontal speed.
 $BCAD LD L,(IX+$08)   ; The low byte of the horizontal speed.
 $BCB0 CALL $BA0B      ; Call #R$BA0B.
 $BCB3 LD (IX+$08),L   ; The low byte, once a tiny speed has been dropped.
 $BCB6 LD A,H          ; The high byte of the horizontal speed.
 $BCB7 OR L            ; Set the bits of #REGa that are set in #REGl.
 $BCB8 JR NZ,$BCD1     ; Jump to #R$BCD1 if the zero flag is clear.
 $BCBA CALL $BCBF      ; Call #R$BCBF.
 $BCBD JR $BCD1        ; Jump to #R$BCD1.
@label=CheckTerrainCollision_Flags2
*$BCBF LD A,($5C20)    ; The slope flags.
 $BCC2 LD (IX+$07),$01 ; Store #N$01 at offset #N$07 of #REGix.
 $BCC6 AND %11000000   ; The two facing bits.
 $BCC8 RET Z           ; Return if the zero flag is set.
 $BCC9 XOR %11000000   ; Flip the bits of #REGa that are set in #N$C0.
 $BCCB RET Z           ; Return if the zero flag is set.
 $BCCC LD (IX+$07),$FF ; Store #N$FF at offset #N$07 of #REGix.
 $BCD0 RET             ; Return.
@label=CheckTerrainCollision_Finish
*$BCD1 LD A,($5C25)    ; The collision mode.
 $BCD4 AND A           ; {Jump to #R$BA76 if #REGa is zero.
 $BCD5 JP Z,$BA76      ; }
 $BCD8 XOR A           ; Clear #REGa.
 $BCD9 LD ($CCBB),A    ; Stop the horizontal scroll.
 $BCDC LD ($CCBA),A    ; Stop the vertical scroll.
 $BCDF LD A,($5C40)    ; The ship was just hit.
 $BCE2 AND A           ; {Jump to #R$BCEC if #REGa is not zero.
 $BCE3 JR NZ,$BCEC     ; }
 $BCE5 LD A,($BC12)    ; The terrain-check flag.
 $BCE8 AND A           ; {Call #R$7263 if #REGa is zero.
 $BCE9 CALL Z,$7263    ; }
@label=CheckTerrainCollision_Pending
*$BCEC LD A,($BC12)    ; The terrain-check flag.
 $BCEF AND A           ; {Jump to #R$BCFC if #REGa is zero.
 $BCF0 JR Z,$BCFC      ; }
 $BCF2 CALL $BCBF      ; Call #R$BCBF.
 $BCF5 LD A,(IX+$07)   ; The high byte of the horizontal speed.
 $BCF8 ADD A,A         ; Twice that speed.
 $BCF9 LD ($CCBB),A    ; The scroll follows the bounce.
@label=CheckTerrainCollision_Set
*$BCFC LD A,$80        ; The check is finished.
 $BCFE LD ($BC12),A    ; Mark the check as finished.
 $BD01 JP $BA76        ; Jump to #R$BA76.
@label=CheckTerrainCollision_Reflect
*$BD04 XOR A           ; Clear #REGa.
@label=CheckTerrainCollision_Patch
*$BD05 LD ($BD16),A    ; Choose whether the first speed is reversed.
 $BD08 LD ($BD2B),A    ; Choose whether the second speed is reversed.
 $BD0B LD IX,($BA09)   ; Fetch the word at #R$BA09 into #REGix.
 $BD0F LD H,(IX+$07)   ; The high byte of the horizontal speed.
 $BD12 LD L,(IX+$08)   ; The low byte of the horizontal speed.
@label=CheckTerrainCollision_PatchFirst
*$BD15 JR $BD15        ; Jump to #R$BD15.
 $BD17 CALL $BD3F      ; Call #R$BD3F.
 $BD1A CALL $C880      ; Call #R$C880.
 $BD1D EX DE,HL        ; Swap #REGde and #REGhl.
 $BD1E LD H,(IX+$09)   ; The high byte of the vertical speed.
 $BD21 LD L,(IX+$0A)   ; The low byte of the vertical speed.
 $BD24 LD (IX+$09),D   ; The vertical speed takes the adjusted horizontal
                       ; speed.
 $BD27 LD (IX+$0A),E   ; The low byte of that new vertical speed.
@label=CheckTerrainCollision_PatchSecond
*$BD2A JR $BD2A        ; Jump to #R$BD2A.
 $BD2C CALL $BD3F      ; Call #R$BD3F.
@label=CheckTerrainCollision_Horizontal
 $BD2F CALL $C880      ; Call #R$C880.
 $BD32 LD (IX+$07),H   ; The horizontal speed takes the adjusted vertical
                       ; speed.
 $BD35 LD (IX+$08),L   ; The low byte of that new horizontal speed.
 $BD38 JP $BC5B        ; Jump to #R$BC5B.
@label=CheckTerrainCollision_Three
*$BD3B LD A,$03        ; Steepness two does not reverse the speeds.
 $BD3D JR $BD05        ; Jump to #R$BD05.
@label=CheckTerrainCollision_Negate
*$BD3F LD A,H          ; The high byte of the speed.
 $BD40 NEG             ; Negate #REGa.
 $BD42 LD H,A          ; The speed is reversed.
 $BD43 RET             ; Return.
@label=CheckTerrainCollision_Rebound
*$BD44 XOR A           ; Clear #REGa.
 $BD45 LD ($BD85),A    ; Choose whether this speed is reversed.
 $BD48 LD ($BD74),A    ; Choose whether the other speed is reversed.
@label=CheckTerrainCollision_ReboundStart
*$BD4B LD A,(IX+$04)   ; The slope flags.
 $BD4E LD C,A          ; Keep the slope flags.
 $BD4F AND %00000111   ; The steepness.
 $BD51 PUSH AF         ; Keep the steepness.
 $BD52 LD IX,($BA09)   ; Fetch the word at #R$BA09 into #REGix.
 $BD56 CP $03          ; {Call #R$BDD8 if #REGa is #N$03.
 $BD58 CALL Z,$BDD8    ; }
 $BD5B LD H,(IX+$07)   ; The high byte of the horizontal speed.
 $BD5E LD L,(IX+$08)   ; The low byte of the horizontal speed.
 $BD61 CALL $BDF1      ; Call #R$BDF1.
 $BD64 LD ($5C15),HL   ; Three eighths of the horizontal speed.
 $BD67 LD H,(IX+$07)   ; The horizontal speed again.
 $BD6A LD L,(IX+$08)   ; The low byte again.
 $BD6D CALL $BDFE      ; Call #R$BDFE.
 $BD70 CALL $BDF1      ; Call #R$BDF1.
@label=CheckTerrainCollision_PatchThird
*$BD73 JR $BD73        ; Jump to #R$BD73.
 $BD75 CALL $BDC8      ; Call #R$BDC8.
 $BD78 LD ($5C17),HL   ; The adjusted fraction of the doubled horizontal speed.
 $BD7B LD H,(IX+$09)   ; The high byte of the vertical speed.
 $BD7E LD L,(IX+$0A)   ; The low byte of the vertical speed.
 $BD81 CALL $BDF1      ; Call #R$BDF1.
@label=CheckTerrainCollision_PatchFourth
*$BD84 JR $BD84        ; Jump to #R$BD84.
 $BD86 CALL $BDC8      ; Call #R$BDC8.
 $BD89 LD DE,($5C15)   ; Fetch the word at #N$5C15 into #REGde.
 $BD8D ADD HL,DE       ; Add the saved fraction of the horizontal speed.
 $BD8E CALL $C880      ; Call #R$C880.
 $BD91 LD (IX+$07),H   ; The new horizontal speed.
 $BD94 LD (IX+$08),L   ; The low byte of the new horizontal speed.
 $BD97 LD H,(IX+$09)   ; The vertical speed.
 $BD9A LD L,(IX+$0A)   ; The low byte of the vertical speed.
 $BD9D CALL $BDFE      ; Call #R$BDFE.
 $BDA0 CALL $BDF1      ; Call #R$BDF1.
 $BDA3 CALL $BDC8      ; Call #R$BDC8.
 $BDA6 LD DE,($5C17)   ; Fetch the word at #N$5C17 into #REGde.
 $BDAA ADD HL,DE       ; Add the saved fraction of the doubled horizontal
                       ; speed.
 $BDAB CALL $C880      ; Call #R$C880.
 $BDAE LD (IX+$09),H   ; The new vertical speed.
 $BDB1 LD (IX+$0A),L   ; The low byte of the new vertical speed.
 $BDB4 POP AF          ; Back to the steepness.
 $BDB5 CP $03          ; {Call #R$BDD8 if #REGa is #N$03.
 $BDB7 CALL Z,$BDD8    ; }
 $BDBA JP $BC5B        ; Jump to #R$BC5B.
@label=CheckTerrainCollision_ReboundBoth
*$BDBD LD A,$03        ; This facing does not reverse the speeds.
 $BDBF LD ($BD85),A    ; This facing skips the first reverse.
 $BDC2 LD ($BD74),A    ; This facing skips the second reverse.
 $BDC5 JP $BD4B        ; Jump to #R$BD4B.
@label=CheckTerrainCollision_ReboundNegate
*$BDC8 BIT 7,C         ; {Jump to #R$BE08 if bit 7 of #REGc is set.
 $BDCA JP NZ,$BE08     ; }
 $BDCD LD A,C          ; The slope flags.
 $BDCE AND %00000111   ; The steepness.
 $BDD0 CP $03          ; {Jump to #R$BE08 if #REGa is #N$03.
 $BDD2 JP Z,$BE08      ; }
 $BDD5 JP $BD3F        ; Jump to #R$BD3F.
@label=SwapSpeeds
*$BDD8 LD H,(IX+$07)   ; The high byte of the horizontal speed.
 $BDDB LD L,(IX+$08)   ; The low byte of the horizontal speed.
 $BDDE LD D,(IX+$09)   ; The high byte of the vertical speed.
 $BDE1 LD E,(IX+$0A)   ; The low byte of the vertical speed.
 $BDE4 LD (IX+$07),D   ; Swap the speeds: horizontal takes the vertical.
 $BDE7 LD (IX+$08),E   ; The low byte of the new horizontal speed.
 $BDEA LD (IX+$09),H   ; Vertical takes the old horizontal speed.
 $BDED LD (IX+$0A),L   ; The low byte of the new vertical speed.
 $BDF0 RET             ; Return.

; Take Three Eighths
;
; Used by the routine at #R$BA21.
; .
; Divides a signed number by eight and by four, and adds the two
; results.
;
;   HL Number
; O:HL Three eighths of the number
@label=TakeThreeEighths
c$BDF1 CALL $BE03    ; Call #R$BE03.
 $BDF4 CALL $BE03    ; Call #R$BE03.
 $BDF7 PUSH HL       ; Stash #REGhl on the stack.
 $BDF8 POP DE        ; Bring #REGde back off the stack.
 $BDF9 CALL $BE03    ; Call #R$BE03.
 $BDFC ADD HL,DE     ; #REGhl gains #REGde.
 $BDFD RET           ; Return.

; Double Number
;
; Used by the routine at #R$BA21.
; .
; Multiplies a number by two.
;
;   HL Number
; O:HL Number multiplied by two
@label=DoubleNumber
c$BDFE SLA L         ; Shift #REGl left.
@label=DoubleNumber_Rotate
 $BE00 RL H          ; Rotate #REGh left through the carry.
 $BE02 RET           ; Return.

; Halve Number
;
; Used by the routines at #R$AA27, #R$BA21 and #R$BDF1.
; .
; Divides a signed number by two.
;
;   HL Number
; O:HL Number divided by two
@label=HalveNumber
c$BE03 SRA H         ; Shift #REGh right keeping the sign.
 $BE05 RR L          ; Rotate #REGl right through the carry.
 $BE07 RET           ; Return.

; Negate Number
;
; Used by the routines at #R$8ECA, #R$8FCA, #R$90CD, #R$9724, #R$AA27, #R$BA21
; and #R$C4ED.
; .
; Changes the sign of a signed number.
;
;   HL Number
; O:HL Number with the sign changed
@label=NegateNumber
c$BE08 LD A,H        ; #REGa=#REGh.
 $BE09 CPL           ; Invert #REGa.
 $BE0A LD H,A        ; #REGh=#REGa.
 $BE0B LD A,L        ; #REGa=#REGl.
 $BE0C CPL           ; Invert #REGa.
 $BE0D LD L,A        ; #REGl=#REGa.
 $BE0E INC HL        ; Advance #REGhl.
 $BE0F RET           ; Return.

; Select Previous Zone
;
; Used by the routine at #R$BE43.
; .
; Sets the tile to look at next to the one in the zone above the current
; one, at the bottom of it, for #R$BE43.
@label=SelectPreviousZone
c$BE10 LD A,($5C2B)  ; The object reaches into the zone above.
 $BE13 LD ($5C2D),A  ; Update the segment screen row.
 $BE16 LD HL,($5C30) ; Fetch the word at #R$5C30 into #REGhl.
 $BE19 DEC H         ; Step #REGh back.
 $BE1A LD L,$B7      ; #REGl=#N$B7.
 $BE1C LD ($BF81),HL ; The tile in the zone above, at its bottom.
 $BE1F LD A,($CE43)  ; The segment column.
 $BE22 LD ($5C2C),A  ; Update the segment screen column.
 $BE25 RET           ; Return.

; Select Next Column
;
; Used by the routine at #R$BE43.
; .
; Sets the tile to look at next to the one in the column to the right of
; the current one, at the left of it, for #R$BE43. The column goes round to zero
; after #N($5F).
@label=SelectNextColumn
c$BE26 LD A,($5C2A)  ; The object reaches into the next column.
 $BE29 LD ($5C2C),A  ; Update the segment screen column.
 $BE2C LD HL,($5C2E) ; Fetch the word at #R$5C2E into #REGhl.
 $BE2F INC H         ; Advance #REGh.
 $BE30 LD A,H        ; #REGa=#REGh.
 $BE31 CP $60        ; {Jump to #R$BE37 if #REGa is not #N$60.
 $BE33 JR NZ,$BE37   ; }
 $BE35 LD H,$00      ; Clear #REGh.
@label=SelectNextColumn_Store
*$BE37 LD L,$08      ; #REGl=#N$08.
 $BE39 LD ($BF7F),HL ; Update the tile position.
 $BE3C LD A,($CE44)  ; The segment row.
 $BE3F LD ($5C2D),A  ; Update the segment screen row.
 $BE42 RET           ; Return.

; Select Next Tile
;
; Used by the routine at #R$BA21.
; .
; Chooses the next tile for #R$BA21 to check the object against, from the
; tiles that the object overlaps and the count in #R$5C1D, then carries on at
; #R$BEE7.
@label=SelectNextTile
c$BE43 LD A,($5C1D)  ; The tiles still to test.
 $BE46 CP $01        ; {Jump to #R$BE65 if #REGa is not #N$01.
 $BE48 JR NZ,$BE65   ; }
 $BE4A LD A,($5C2A)  ; The object reaches into the next column.
 $BE4D AND A         ; {Jump to #R$BE65 if #REGa is zero.
 $BE4E JR Z,$BE65    ; }
 $BE50 LD A,($5C2B)  ; The object reaches into the zone above.
 $BE53 AND A         ; {Jump to #R$BE65 if #REGa is zero.
 $BE54 JR Z,$BE65    ; }
 $BE56 CALL $BE10    ; Call #R$BE10.
 $BE59 CALL $BE26    ; Call #R$BE26.
 $BE5C LD A,($5C2B)  ; The object reaches into the zone above.
 $BE5F LD ($5C2D),A  ; Update the segment screen row.
 $BE62 JP $BEE7      ; Jump to #R$BEE7.
@label=SelectNextTile_Column
*$BE65 LD A,($5C2A)  ; The object reaches into the next column.
 $BE68 AND A         ; {Jump to #R$BE81 if #REGa is zero.
 $BE69 JR Z,$BE81    ; }
 $BE6B LD A,($E41B)  ; The slope direction.
 $BE6E AND A         ; {Jump to #R$BE81 if #REGa is zero.
 $BE6F JR Z,$BE81    ; }
 $BE71 XOR A         ; Clear #REGa.
 $BE72 LD ($E41B),A  ; Update the slope direction.
 $BE75 CALL $BE26    ; Call #R$BE26.
 $BE78 LD HL,($5C30) ; Fetch the word at #R$5C30 into #REGhl.
 $BE7B LD ($BF81),HL ; The vertical position of the next tile.
 $BE7E JP $BEE7      ; Jump to #R$BEE7.
@label=SelectNextTile_Current
*$BE81 CALL $BE10    ; Call #R$BE10.
 $BE84 LD HL,($5C2E) ; Fetch the word at #R$5C2E into #REGhl.
 $BE87 LD ($BF7F),HL ; Update the tile position.
 $BE8A JP $BEE7      ; Jump to #R$BEE7.
 $BE8D NOP           ; Do nothing.
 $BE8E NOP           ; Do nothing.

; Start Terrain Check
;
; Used by the routine at #R$BA21.
; .
; Sets up #R$BA21: keeps the size of the object in #R$CE43 and clears the
; working values, finds where the object will be after it has moved by its
; speeds using #R$B980 and #R$B9BB, and keeps its speeds. Carries on at
; #R$BEE7.
;
; BC Size of the object
; IX Address of the object
@label=StartTerrainCheck
c$BE8F LD ($CE43),BC ; Update the segment column.
 $BE93 XOR A         ; Clear #REGa.
 $BE94 LD ($5C2A),A  ; The object does not reach the next column.
 $BE97 LD ($5C2B),A  ; The object does not reach the zone above.
 $BE9A LD ($5C1D),A  ; Update the tiles still to test.
 $BE9D LD ($5C35),A  ; Update the collision status.
 $BEA0 LD ($E41B),A  ; Update the slope direction.
 $BEA3 CALL $B980    ; Call #R$B980.
 $BEA6 LD ($BF7F),HL ; Update the tile position.
 $BEA9 LD ($5C2E),HL ; Update the piece column.
 $BEAC CALL $B9BB    ; Call #R$B9BB.
 $BEAF LD ($BF81),HL ; The vertical position after the move.
 $BEB2 LD ($5C30),HL ; Update the back to front flag.
 $BEB5 LD A,($5C25)  ; The collision mode.
 $BEB8 INC A         ; Advance #REGa.
 $BEB9 JR Z,$BEC1    ; Jump to #R$BEC1 if the zero flag is set.
 $BEBB DEC A         ; Step #REGa back.
 $BEBC CALL Z,$90CD  ; Call #R$90CD if the zero flag is set.
 $BEBF JR $BECD      ; Jump to #R$BECD.
@label=StartTerrainCheck_Ship
*$BEC1 LD HL,($C8FE) ; Fetch the word at #N$C8FE into #REGhl.
 $BEC4 LD ($C8EC),HL ; Update the high byte of the ship's horizontal speed.
 $BEC7 LD HL,($C900) ; Fetch the word at #N$C900 into #REGhl.
 $BECA LD ($C8EE),HL ; Update the high byte of the ship's vertical speed.
@label=StartTerrainCheck_Speeds
*$BECD LD A,(IX+$07) ; Read offset #N$07 of #REGix.
 $BED0 LD ($BE8D),A  ; Update the saved horizontal speed.
 $BED3 LD A,(IX+$09) ; Read offset #N$09 of #REGix.
 $BED6 NEG           ; Negate #REGa.
 $BED8 LD ($BE8E),A  ; Update the saved vertical speed.
 $BEDB LD A,($CE43)  ; The segment column.
 $BEDE LD ($5C2C),A  ; Update the segment screen column.
 $BEE1 LD A,($CE44)  ; The segment row.
 $BEE4 LD ($5C2D),A  ; Update the segment screen row.
; Continue on to #R$BEE7.

; Find Tiles Overlapped
;
; Used by the routine at #R$BE43.
; .
; Finds the tile record for the position of the object using
; #R$B946, works out where the object is within the tile and stores
; it in #R$CE3A to #R$CE3D and counts the tiles that it overlaps (up to four)
; in #R$5C1D.
@label=FindTilesOverlapped
c$BEE7 LD BC,($BF81) ; Fetch the word at #R$BF81 into #REGbc.
 $BEEB LD DE,($BF7F) ; Fetch the word at #R$BF7F into #REGde.
 $BEEF CALL $B946    ; Call #R$B946.
 $BEF2 LD A,($BF7F)  ; The tile position.
 $BEF5 LD C,A        ; #REGc=#REGa.
 $BEF6 LD A,($5C2C)  ; The segment screen column.
 $BEF9 LD B,A        ; #REGb=#REGa.
 $BEFA LD A,C        ; #REGa=#REGc.
 $BEFB ADD A,$18     ; Add #N$18 to #REGa.
 $BEFD ADD A,B       ; #REGa gains #REGb.
 $BEFE LD E,B        ; #REGe=#REGb.
 $BEFF JR NC,$BF15   ; Jump to #R$BF15 if the carry flag is clear.
 $BF01 LD B,A        ; #REGb=#REGa.
 $BF02 LD A,($5C1D)  ; The tiles still to test.
 $BF05 AND A         ; {Jump to #R$BF11 if #REGa is not zero.
 $BF06 JR NZ,$BF11   ; }
 $BF08 LD A,B        ; #REGa=#REGb.
 $BF09 LD ($5C2A),A  ; The object reaches into the next column.
 $BF0C LD A,$01      ; #REGa=#N$01.
 $BF0E LD ($E41B),A  ; Update the slope direction.
@label=FindTilesOverlapped_Right
*$BF11 LD A,$E8      ; #REGa=#N$E8.
 $BF13 SUB C         ; Subtract #REGc from #REGa.
 $BF14 LD E,A        ; #REGe=#REGa.
@label=FindTilesOverlapped_Horizontal
*$BF15 LD A,E        ; #REGa=#REGe.
 $BF16 LD ($CE3D),A  ; The horizontal edge in the tile.
 $BF19 LD A,C        ; #REGa=#REGc.
 $BF1A LD ($CE3A),A  ; The horizontal position in the tile.
 $BF1D LD A,($BF81)  ; The vertical position.
 $BF20 LD C,A        ; #REGc=#REGa.
 $BF21 LD A,($5C2D)  ; The segment screen row.
 $BF24 LD B,A        ; #REGb=#REGa.
 $BF25 LD A,C        ; #REGa=#REGc.
 $BF26 SUB $17       ; Subtract #N$17 from #REGa.
 $BF28 SUB B         ; Subtract #REGb from #REGa.
 $BF29 LD E,B        ; #REGe=#REGb.
 $BF2A JR NC,$BF3D   ; Jump to #R$BF3D if the carry flag is clear.
 $BF2C LD B,A        ; #REGb=#REGa.
 $BF2D LD A,($5C1D)  ; The tiles still to test.
 $BF30 AND A         ; {Jump to #R$BF39 if #REGa is not zero.
 $BF31 JR NZ,$BF39   ; }
 $BF33 LD A,B        ; #REGa=#REGb.
 $BF34 NEG           ; Negate #REGa.
 $BF36 LD ($5C2B),A  ; The object reaches into the zone above.
@label=FindTilesOverlapped_Up
*$BF39 LD A,C        ; #REGa=#REGc.
 $BF3A SUB $17       ; Subtract #N$17 from #REGa.
 $BF3C LD E,A        ; #REGe=#REGa.
@label=FindTilesOverlapped_Vertical
*$BF3D LD A,E        ; #REGa=#REGe.
 $BF3E LD ($CE3C),A  ; The vertical edge in the tile.
 $BF41 LD A,C        ; #REGa=#REGc.
 $BF42 LD ($CE3B),A  ; The vertical position in the tile.
 $BF45 LD A,($5C1D)  ; The tiles still to test.
 $BF48 AND A         ; {Return if #REGa is not zero.
 $BF49 RET NZ        ; }
 $BF4A LD B,$01      ; #REGb=#N$01.
 $BF4C LD A,($5C2A)  ; The object reaches into the next column.
 $BF4F AND A         ; {Jump to #R$BF5A if #REGa is zero.
 $BF50 JR Z,$BF5A    ; }
 $BF52 INC B         ; Advance #REGb.
 $BF53 LD A,($5C2B)  ; The object reaches into the zone above.
 $BF56 AND A         ; {Jump to #R$BF5A if #REGa is zero.
 $BF57 JR Z,$BF5A    ; }
 $BF59 INC B         ; Advance #REGb.
@label=FindTilesOverlapped_Count
*$BF5A LD A,($5C2B)  ; The object reaches into the zone above.
 $BF5D AND A         ; {Jump to #R$BF61 if #REGa is zero.
 $BF5E JR Z,$BF61    ; }
 $BF60 INC B         ; Advance #REGb.
@label=FindTilesOverlapped_Return
*$BF61 LD A,B        ; #REGa=#REGb.
 $BF62 LD ($5C1D),A  ; Update the tiles still to test.
 $BF65 RET           ; Return.

; Move Object
;
; Used by the routines at #R$882B, #R$89D3, #R$8D29, #R$9056, #R$909A, #R$90A7,
; #R$9524, #R$9572, #R$AA94, #R$B483, #R$B5B5, #R$B752, #R$C374 and #R$DDBF.
; .
; Moves an object by its speeds: the horizontal position with
; #R$B980 and the vertical position with #R$B9BB.
;
; IX Address of the object
@label=MoveObject
c$BF66 CALL $B980    ; Call #R$B980.
 $BF69 LD (IX+$01),H ; Write the map column.
 $BF6C LD (IX+$02),L ; Write the horizontal position.
 $BF6F LD (IX+$03),E ; Write #REGe to offset #N$03 of #REGix.
 $BF72 CALL $B9BB    ; Call #R$B9BB.
 $BF75 LD (IX+$04),H ; Write the map zone.
 $BF78 LD (IX+$05),L ; Write the vertical position.
 $BF7B LD (IX+$06),E ; Write #REGe to offset #N$06 of #REGix.
 $BF7E RET           ; Return.

; Tile Position
;
; Used while checking the terrain: the map column and horizontal position
; of the object, then its map zone and vertical position, then a third
; position that is used by #R$BF85.
@label=TilePosition
g$BF7F DEFW $0000
 $BF81 DEFW $0000
 $BF83 DEFW $0000

; Select Mirrored Erase
;
; Used by the routine at #R$C374.
; .
; Used when the ship is erased. If it is facing left (bit 7 of
; #N$C8FD or of #REGa if entered at #R$BF88) the horizontal position is
; moved to the other side of the sprite by its width in #R$5C28 and #REGiy
; is pointed at the routine for the width in the table at #R$A7A4, which
; erases a mirrored sprite.
;
;   HL' Position (if entered at #R$BF88)
; O:IY Address of the routine
@label=SelectMirroredErase
c$BF85 LD A,($C8FD)  ; The ship's facing.
; This entry point is used by the routine at #R$C27F.
@label=SelectMirroredErase_Entry
*$BF88 LD HL,($BF83) ; Fetch the word at #R$BF83 into #REGhl.
 $BF8B BIT 7,A       ; {Return if bit 7 of #REGa is clear.
 $BF8D RET Z         ; }
 $BF8E LD B,$F9      ; #REGb=#N$F9.
 $BF90 LD A,($5C28)  ; The sprite width in bytes.
 $BF93 DEC A         ; Step #REGa back.
 $BF94 ADD A,A       ; Double #REGa.
 $BF95 ADD A,A       ; Double #REGa.
 $BF96 ADD A,A       ; Double #REGa.
 $BF97 ADD A,L       ; #REGa gains #REGl.
 $BF98 LD ($BF83),A  ; The column on the other side of the sprite.
 $BF9B LD A,($5C28)  ; The sprite width in bytes.
 $BF9E LD IY,$A7A4   ; The erase mirrored row directly.
 $BFA2 CP $06        ; {Return if #REGa is #N$06.
 $BFA4 RET Z         ; }
 $BFA5 LD IY,$A7AC   ; The second mirrored-row erase.
 $BFA9 CP $05        ; {Return if #REGa is #N$05.
 $BFAB RET Z         ; }
 $BFAC LD IY,$A7B4   ; The third mirrored-row erase.
 $BFB0 CP $04        ; {Return if #REGa is #N$04.
 $BFB2 RET Z         ; }
 $BFB3 LD IY,$A7BC   ; The fourth mirrored-row erase.
 $BFB7 RET           ; Return.

; Select Mirrored Draw
;
; Used by the routines at #R$C27F and #R$C374.
; .
; Used when the ship is drawn. If it is facing left, moves the
; horizontal position to the other side of the sprite by its width in
; #R$5C29 and points #REGix at the routine for the width in the table at
; #R$A7D6, which draws a mirrored sprite.
;
;   HL Position
; O:IX Address of the routine
@label=SelectMirroredDraw
c$BFB8 LD A,($C8FD)  ; The ship's facing.
 $BFBB BIT 7,A       ; {Return if bit 7 of #REGa is clear.
 $BFBD RET Z         ; }
 $BFBE LD B,$F9      ; #REGb=#N$F9.
 $BFC0 LD A,($5C29)  ; The sprite width in bytes.
 $BFC3 DEC A         ; Step #REGa back.
 $BFC4 ADD A,L       ; #REGa gains #REGl.
 $BFC5 LD L,A        ; #REGl=#REGa.
 $BFC6 LD A,($5C29)  ; The sprite width in bytes.
 $BFC9 LD IX,$A7D6   ; The draw mirrored row directly.
 $BFCD CP $06        ; {Return if #REGa is #N$06.
 $BFCF RET Z         ; }
 $BFD0 LD IX,$A7DD   ; The second mirrored-row draw.
 $BFD4 CP $05        ; {Return if #REGa is #N$05.
 $BFD6 RET Z         ; }
 $BFD7 LD IX,$A7E4   ; The third mirrored-row draw.
 $BFDB CP $04        ; {Return if #REGa is #N$04.
 $BFDD RET Z         ; }
 $BFDE LD IX,$A7EB   ; The fourth mirrored-row draw.
 $BFE2 RET           ; Return.

; Update Stars
;
; Used by the routine at #R$DDF8.
; .
; Moves and draws the stars in the sky, in three layers of six stars.
; Only does anything when the ship is in one of the four zones at the top of
; the planet. The stars in the nearer layers move faster than the ones in the
; further layers when the screen scrolls, and are bigger. This is a best
; reading of the code.
@label=UpdateStars
c$BFE3 LD A,($CE58)   ; The map row.
 $BFE6 CP $04         ; {Return if #REGa is #N$04 or more.
 $BFE8 RET NC         ; }
 $BFE9 LD BC,$0006    ; #REGbc=#N$06.
 $BFEC LD HL,$C184    ; The star offsets.
 $BFEF LD DE,$C18A    ; The second star offset.
 $BFF2 LDIR           ; Copy #REGbc bytes from #REGhl to #REGde.
 $BFF4 LD B,$03       ; #REGb=#N$03.
 $BFF6 LD IX,$C184    ; The star offsets.
@label=UpdateStars_Loop
*$BFFA LD HL,($CCBA)  ; Fetch the word at #R$CCBA into #REGhl.
 $BFFD CALL $C152     ; Call #R$C152.
 $C000 LD A,H         ; #REGa=#REGh.
 $C001 ADD A,(IX+$00) ; Add the byte at offset #N$00 of #REGix to #REGa.
 $C004 LD (IX+$00),A  ; Write #REGa to offset #N$00 of #REGix.
 $C007 LD H,L         ; #REGh=#REGl.
 $C008 INC IX         ; Advance #REGix.
 $C00A CALL $C152     ; Call #R$C152.
 $C00D LD A,H         ; #REGa=#REGh.
 $C00E ADD A,(IX+$00) ; Add the byte at offset #N$00 of #REGix to #REGa.
 $C011 LD (IX+$00),A  ; Write #REGa to offset #N$00 of #REGix.
 $C014 INC IX         ; Advance #REGix.
 $C016 DJNZ $BFFA     ; Decrease #REGb and jump to #R$BFFA until none remain.
@label=UpdateStars_Draw
 $C018 LD HL,$C0EA    ; The star positions.
 $C01B LD ($C0E8),HL  ; The address of the star's position.
 $C01E LD IX,$C1A3    ; The star layer types.
 $C022 LD HL,$C184    ; The star offsets.
 $C025 LD ($C0E6),HL  ; The address of the star's offset.
 $C028 LD B,$03       ; #REGb=#N$03.
@label=UpdateStars_Layer
*$C02A PUSH BC        ; Stash #REGbc on the stack.
 $C02B CALL $C032     ; Call #R$C032.
 $C02E POP BC         ; Bring #REGbc back off the stack.
 $C02F DJNZ $C02A     ; Decrease #REGb and jump to #R$C02A until none remain.
 $C031 RET            ; Return.

; Update Star Layer
;
; Used by the routine at #R$BFE3.
; .
; Erases and draws the six stars of one layer, from the positions in the
; table at #R$C0EA. A star is only drawn when it is on the screen, as decided
; by #R$C10E. Its attribute is set to bright white.
;
; IX Address of the table of types for the layer
@label=UpdateStarLayer
c$C032 PUSH IX        ; Stash #REGix on the stack.
 $C034 LD B,$06       ; #REGb=#N$06.
@label=UpdateStarLayer_Loop
*$C036 CALL $A2EA     ; Call #R$A2EA.
 $C039 LD ($CCBC),A   ; Update the star flags.
 $C03C PUSH BC        ; Stash #REGbc on the stack.
 $C03D PUSH IX        ; Stash #REGix on the stack.
 $C03F LD HL,($C0E8)  ; Fetch the word at #R$C0E8 into #REGhl.
 $C042 BIT 0,(HL)     ; {Jump to #R$C069 if bit 0 of the byte at the address in #REGhl is
 $C044 JR Z,$C069     ; clear.}
 $C046 LD BC,$0006    ; #REGbc=#N$06.
 $C049 LD HL,($C0E6)  ; Fetch the word at #R$C0E6 into #REGhl.
 $C04C ADD HL,BC      ; #REGhl gains #REGbc.
 $C04D LD DE,($C0E8)  ; Fetch the word at #R$C0E8 into #REGde.
 $C051 LD A,(DE)      ; Read #REGde.
 $C052 AND %11111110  ; Keep the bits of #REGa that are set in #N$FE.
 $C054 ADD A,(HL)     ; Add the byte at #REGhl to #REGa.
 $C055 LD ($A1D3),A   ; Update the sprite positions.
 $C058 INC HL         ; Advance #REGhl.
 $C059 INC DE         ; Advance #REGde.
 $C05A LD A,(DE)      ; Read #REGde.
 $C05B ADD A,(HL)     ; Add the byte at #REGhl to #REGa.
 $C05C LD ($A1D4),A   ; The star's vertical position.
 $C05F LD A,($CCBC)   ; The star flags.
 $C062 OR %00000001   ; Set the bits of #REGa that are set in #N$01.
 $C064 LD ($CCBC),A   ; Update the star flags.
 $C067 JR $C06B       ; Jump to #R$C06B.
@label=UpdateStarLayer_Erased
*$C069 JR $C087       ; Jump to #R$C087.
@label=UpdateStarLayer_Update2
*$C06B LD A,($A1D3)   ; The sprite positions.
 $C06E AND %00000001  ; Keep the bits of #REGa that are set in #N$01.
 $C070 ADD A,(IX+$01) ; Add the byte at offset #N$01 of #REGix to #REGa.
 $C073 LD (IX+$00),A  ; Write #REGa to offset #N$00 of #REGix.
 $C076 LD A,($A1D3)   ; The sprite positions.
 $C079 AND %11111110  ; Keep the bits of #REGa that are set in #N$FE.
 $C07B LD ($A1D3),A   ; Update the sprite positions.
 $C07E CALL $A19F     ; Call #R$A19F.
 $C081 CALL $A1EA     ; Call #R$A1EA.
 $C084 CALL $A234     ; Call #R$A234.
@label=UpdateStarLayer_Draw
*$C087 EXX            ; Switch to the alternate registers.
 $C088 CALL $C10E     ; Call #R$C10E.
 $C08B JR NZ,$C094    ; Jump to #R$C094 if the zero flag is clear.
 $C08D LD HL,($C0E8)  ; Fetch the word at #R$C0E8 into #REGhl.
 $C090 RES 0,(HL)     ; Reset bit 0 of the byte at the address in #REGhl.
 $C092 JR $C0B5       ; Jump to #R$C0B5.
@label=UpdateStarLayer_Visible
*$C094 LD HL,($C0E8)  ; Fetch the word at #R$C0E8 into #REGhl.
 $C097 SET 0,(HL)     ; Set bit 0 of the byte at the address in #REGhl.
 $C099 LD A,($A1D5)   ; The star's horizontal position.
 $C09C AND %00000001  ; Keep the bits of #REGa that are set in #N$01.
 $C09E ADD A,(IX+$01) ; Add the byte at offset #N$01 of #REGix to #REGa.
 $C0A1 LD (IX+$00),A  ; Write #REGa to offset #N$00 of #REGix.
 $C0A4 LD A,($A1D5)   ; The star's horizontal position.
 $C0A7 AND %11111110  ; Keep the bits of #REGa that are set in #N$FE.
 $C0A9 LD ($A1D5),A   ; The star's horizontal position.
 $C0AC CALL $A19F     ; Call #R$A19F.
 $C0AF CALL $A1D9     ; Call #R$A1D9.
 $C0B2 CALL $A247     ; Call #R$A247.
@label=UpdateStarLayer_Update
*$C0B5 LD A,($CCBC)   ; The star flags.
 $C0B8 AND A          ; {Jump to #R$C0C6 if #REGa is zero.
 $C0B9 JR Z,$C0C6     ; }
 $C0BB CALL $A303     ; Call #R$A303.
 $C0BE LD HL,($A1D5)  ; Fetch the word at #R$A1D5 into #REGhl.
 $C0C1 CALL $A170     ; Call #R$A170.
 $C0C4 LD (HL),$47    ; Store #N$47 at the address in #REGhl.
@label=UpdateStarLayer_Next
*$C0C6 LD DE,($C0E8)  ; Fetch the word at #R$C0E8 into #REGde.
 $C0CA INC DE         ; Advance #REGde.
 $C0CB INC DE         ; Advance #REGde.
 $C0CC LD ($C0E8),DE  ; The address of the next star's position.
 $C0D0 POP IX         ; Bring #REGix back off the stack.
 $C0D2 POP BC         ; Bring #REGbc back off the stack.
 $C0D3 DEC B          ; Step #REGb back.
 $C0D4 JP NZ,$C036    ; Jump to #R$C036 if the zero flag is clear.
 $C0D7 POP IX         ; Bring #REGix back off the stack.
 $C0D9 INC IX         ; Advance #REGix.
 $C0DB INC IX         ; Advance #REGix.
 $C0DD LD HL,($C0E6)  ; Fetch the word at #R$C0E6 into #REGhl.
 $C0E0 INC HL         ; Advance #REGhl.
 $C0E1 INC HL         ; Advance #REGhl.
 $C0E2 LD ($C0E6),HL  ; The address of the next star's offset.
 $C0E5 RET            ; Return.

; Star Variables
;
; The addresses of the offsets of the layer and of the position of the
; current star.
@label=StarVariables
g$C0E6 DEFW $0000
 $C0E8 DEFW $0000

; Star Positions
;
; The horizontal and vertical positions of the eighteen stars. Bit 0 of
; the horizontal position is set while the star is being shown.
@label=StarPositions
g$C0EA DEFB $50,$20
 $C0EC DEFB $A0,$40
 $C0EE DEFB $38,$88
 $C0F0 DEFB $D8,$90
 $C0F2 DEFB $78,$C0
 $C0F4 DEFB $10,$D0
 $C0F6 DEFB $28,$10
 $C0F8 DEFB $E0,$28
 $C0FA DEFB $68,$68
 $C0FC DEFB $B0,$A8
 $C0FE DEFB $70,$B4
 $C100 DEFB $28,$E0
 $C102 DEFB $38,$18
 $C104 DEFB $D0,$30
 $C106 DEFB $90,$60
 $C108 DEFB $08,$6C
 $C10A DEFB $60,$BD
 $C10C DEFB $D8,$E6

; Check Star Position
;
; Used by the routine at #R$C032.
; .
; Finds the position of a star on the screen, from its position and the
; offset of its layer. It is stored in #R$A1D5 and #R$A1D6. In the third zone
; a star is also left out if it is below the level of the ground.
;
; O:F The zero flag is set if the star is not on the screen
@label=CheckStarPosition
c$C10E LD HL,($C0E6) ; Fetch the word at #R$C0E6 into #REGhl.
 $C111 LD DE,($C0E8) ; Fetch the word at #R$C0E8 into #REGde.
 $C115 LD A,(DE)     ; Read #REGde.
 $C116 AND %11111110 ; Keep the bits of #REGa that are set in #N$FE.
 $C118 ADD A,(HL)    ; Add the byte at #REGhl to #REGa.
 $C119 SUB $08       ; Subtract #N$08 from #REGa.
 $C11B CP $E0        ; {Jump to #R$C150 if #REGa is #N$E0 or more.
 $C11D JR NC,$C150   ; }
 $C11F ADD A,$08     ; Add #N$08 to #REGa.
 $C121 LD ($A1D5),A  ; The star's horizontal position.
 $C124 INC DE        ; Advance #REGde.
 $C125 INC HL        ; Advance #REGhl.
 $C126 LD A,(DE)     ; Read #REGde.
 $C127 ADD A,(HL)    ; Add the byte at #REGhl to #REGa.
 $C128 SUB $18       ; Subtract #N$18 from #REGa.
 $C12A CP $A1        ; {Jump to #R$C150 if #REGa is #N$A1 or more.
 $C12C JR NC,$C150   ; }
 $C12E ADD A,$18     ; Add #N$18 to #REGa.
 $C130 LD ($A1D6),A  ; The star's vertical position.
 $C133 LD A,($CE58)  ; The map row.
 $C136 CP $03        ; {Jump to #R$C147 if #REGa is not #N$03.
 $C138 JR NZ,$C147   ; }
 $C13A LD A,($CE46)  ; The position down.
 $C13D CPL           ; Invert #REGa.
 $C13E SUB $31       ; Subtract #N$31 from #REGa.
 $C140 LD B,A        ; #REGb=#REGa.
 $C141 LD A,($A1D6)  ; The star's vertical position.
 $C144 CP B          ; {Jump to #R$C150 if #REGa is #REGb or more.
 $C145 JR NC,$C150   ; }
@label=CheckStarPosition_Visible
*$C147 LD A,($CCBC)  ; The star flags.
 $C14A OR %00000001  ; Set the bits of #REGa that are set in #N$01.
 $C14C LD ($CCBC),A  ; Update the star flags.
 $C14F RET           ; Return.
@label=CheckStarPosition_Hidden
*$C150 XOR A         ; Clear #REGa.
 $C151 RET           ; Return.

; Scale Scroll Speed
;
; Used by the routine at #R$BFE3.
; .
; Makes a scroll speed smaller for the stars of a layer further away,
; by shifting it right once for the second layer and twice for the third. For
; the third layer, on odd frames, a speed of #N($FE) is first changed to zero
; and a speed of #N($02) is changed to #N($04).
;
;   B Layer (one for the nearest)
;   H Scroll speed
; O:H Scaled scroll speed
@label=ScaleScrollSpeed
c$C152 LD A,B        ; #REGa=#REGb.
 $C153 CP $01        ; {Return if #REGa is #N$01.
 $C155 RET Z         ; }
 $C156 CP $02        ; {Jump to #R$C169 if #REGa is #N$02.
 $C158 JR Z,$C169    ; }
 $C15A LD A,H        ; #REGa=#REGh.
 $C15B CP $FE        ; {Jump to #R$C169 if #REGa is not #N$FE.
 $C15D JR NZ,$C169   ; }
 $C15F LD A,($9A64)  ; The frame counter.
 $C162 AND %00000001 ; Keep the bits of #REGa that are set in #N$01.
 $C164 JR Z,$C169    ; Jump to #R$C169 if the zero flag is set.
 $C166 LD H,$00      ; Clear #REGh.
 $C168 RET           ; Return.
@label=ScaleScrollSpeed_Third
*$C169 LD A,B        ; #REGa=#REGb.
 $C16A CP $03        ; {Jump to #R$C17C if #REGa is not #N$03.
 $C16C JR NZ,$C17C   ; }
 $C16E LD A,H        ; #REGa=#REGh.
 $C16F CP $02        ; {Jump to #R$C17C if #REGa is not #N$02.
 $C171 JR NZ,$C17C   ; }
 $C173 LD A,($9A64)  ; The frame counter.
 $C176 AND %00000001 ; Keep the bits of #REGa that are set in #N$01.
 $C178 JR Z,$C17C    ; Jump to #R$C17C if the zero flag is set.
 $C17A LD H,$04      ; #REGh=#N$04.
@label=ScaleScrollSpeed_Shift
*$C17C LD A,B        ; #REGa=#REGb.
 $C17D DEC A         ; Step #REGa back.
@label=ScaleScrollSpeed_Loop
*$C17E SRA H         ; Shift #REGh right keeping the sign.
 $C180 DEC A         ; Step #REGa back.
 $C181 JR NZ,$C17E   ; Jump to #R$C17E if the zero flag is clear.
 $C183 RET           ; Return.

; Star Offsets
;
; The distance that each of the three layers of stars has moved, as
; a horizontal and a vertical offset, followed by a copy that is kept while
; the layers are being updated.
@label=StarOffsets
g$C184 DEFB $00,$00
 $C186 DEFB $00,$00
 $C188 DEFB $00,$00
@label=StarOffsets_Second
 $C18A DEFB $00,$00
 $C18C DEFB $00,$00
 $C18E DEFB $00,$00

; Star Sprites
;
; The sprites of the five types of star, which are types #N($07) to
; #N($0B). Each has a width of one byte and a height of one to three rows.
@label=StarSprites
b$C190 DEFB $01,$01,$80
 $C193 DEFB $01,$01,$40
 $C196 DEFB $01,$02,$C0,$C0
 $C19A DEFB $01,$02,$60,$60
 $C19E DEFB $01,$03,$40,$E0,$40

; Star Layer Types
;
; Two bytes for each layer of stars, of which the second is the base type
; of the stars in the layer. The type of a star is that plus bit 0 of its
; horizontal position.
@label=StarLayerTypes
b$C1A3 DEFB $07,$07
 $C1A5 DEFB $09,$09
 $C1A7 DEFB $0B,$0B

; Ship Height
;
; The height of the ship in pixels, which is made taller by parts that
; are fitted.
@label=ShipHeight
g$C1A9 DEFB $0E

; Ship Buffer Address
;
; The address in the buffer at #R$F6B9 that the ship is drawn from.
@label=ShipBufferAddress
g$C1AA DEFW $0000

; Create Ship Piece
;
; Used by the routine at #R$C1CE.
; .
; Makes an object of type #N($0C) in a slot, with the state in #REGb and
; a position that is held in four bytes: the map column, the map zone, the
; horizontal position and the vertical position.
;
; B State of the object
; HL Address of the position
; IX Address of the slot
@label=CreatePiece
c$C1AC CALL $AC34      ; Call #R$AC34.
 $C1AF LD (IX+$00),$0C ; Store #N$0C at offset #N$00 of #REGix.
 $C1B3 LD (IX+$13),B   ; Write #REGb to offset #N$13 of #REGix.
 $C1B6 LD (IX+$0D),$FF ; Store #N$FF at offset #N$0D of #REGix.
 $C1BA LD A,(HL)       ; Read #REGhl.
 $C1BB LD (IX+$01),A   ; Write #REGa to offset #N$01 of #REGix.
 $C1BE INC HL          ; Advance #REGhl.
 $C1BF LD A,(HL)       ; Read #REGhl.
 $C1C0 LD (IX+$04),A   ; Write #REGa to offset #N$04 of #REGix.
 $C1C3 INC HL          ; Advance #REGhl.
 $C1C4 LD A,(HL)       ; Read #REGhl.
 $C1C5 LD (IX+$02),A   ; Write #REGa to offset #N$02 of #REGix.
 $C1C8 INC HL          ; Advance #REGhl.
 $C1C9 LD A,(HL)       ; Read #REGhl.
 $C1CA LD (IX+$05),A   ; Write #REGa to offset #N$05 of #REGix.
 $C1CD RET             ; Return.

; Check Item Delivery
;
; Used by the routines at #R$9572, #R$C374 and #R$F48B.
; .
; Does nothing unless the flag at #R$F5F7 is set, which happens when item
; number #N($09) has been picked up. Once the ship is at the bottom of zone
; #N($0B), the item is delivered: it is no longer carried, and two pieces are
; made with #R$C1AC in the last two slots of the map objects. Either way,
; carries on to draw the two pieces that are held at #R$C27B and #R$C27D and
; to set their attributes. This is a best reading of the code.
@label=CheckItemDelivery
c$C1CE LD A,($F5F7)  ; The flag set when item #N($09) has been picked up.
 $C1D1 AND A         ; {Return if #REGa is zero.
 $C1D2 RET Z         ; }
 $C1D3 LD A,($C8E9)  ; The ship's map zone.
 $C1D6 CP $0B        ; {Jump to #R$C240 if #REGa is not #N$0B.
 $C1D8 JP NZ,$C240   ; }
 $C1DB LD A,($C8EA)  ; The ship's vertical position.
 $C1DE CP $A7        ; {Jump to #R$C240 if #REGa is less than #N$A7.
 $C1E0 JP C,$C240    ; }
 $C1E3 LD A,($C279)  ; The facing kept for the pieces.
 $C1E6 OR %01000000  ; Set the bits of #REGa that are set in #N$40.
 $C1E8 LD ($C279),A  ; A piece is being delivered.
 $C1EB XOR A         ; Clear #REGa.
 $C1EC LD ($F5F7),A  ; Update the flag set when item #N($09) has been picked
                     ; up.
 $C1EF LD ($C904),A  ; Update the item the ship is about to pick up.
 $C1F2 LD A,($C8E9)  ; The ship's map zone.
 $C1F5 LD D,A        ; #REGd=#REGa.
 $C1F6 LD A,($C8E6)  ; The ship's map column.
 $C1F9 LD E,A        ; #REGe=#REGa.
 $C1FA LD ($F628),DE ; The tenth item site.
 $C1FE LD ($F62C),DE ; The eleventh item site.
 $C202 LD A,($5C38)  ; The ship row.
 $C205 SUB $0D       ; Subtract #N$0D from #REGa.
 $C207 LD B,A        ; #REGb=#REGa.
 $C208 LD A,($C903)  ; The row the ship was drawn on.
 $C20B SUB B         ; Subtract #REGb from #REGa.
 $C20C LD B,A        ; #REGb=#REGa.
 $C20D LD A,($C8EA)  ; The ship's vertical position.
 $C210 SUB B         ; Subtract #REGb from #REGa.
 $C211 LD H,A        ; #REGh=#REGa.
 $C212 LD A,($C8E7)  ; The ship's horizontal position.
 $C215 ADD A,$08     ; Add #N$08 to #REGa.
 $C217 AND %11111000 ; Keep the bits of #REGa that are set in #N$F8.
 $C219 LD L,A        ; #REGl=#REGa.
 $C21A LD ($F62A),HL ; The position of the tenth item site.
 $C21D LD A,L        ; #REGa=#REGl.
 $C21E ADD A,$10     ; Add #N$10 to #REGa.
 $C220 LD L,A        ; #REGl=#REGa.
 $C221 LD A,H        ; #REGa=#REGh.
 $C222 SUB $23       ; Subtract #N$23 from #REGa.
 $C224 LD H,A        ; #REGh=#REGa.
 $C225 LD ($F62E),HL ; The position of the eleventh item site.
 $C228 LD HL,$F628   ; The tenth item site.
 $C22B LD IX,$A873   ; The fifth map-object slot.
 $C22F LD B,$09      ; #REGb=#N$09.
 $C231 CALL $C1AC    ; Call #R$C1AC.
 $C234 LD IX,$A88D   ; The sixth map-object slot.
 $C238 LD HL,$F62C   ; The eleventh item site.
 $C23B LD B,$0A      ; #REGb=#N$0A.
 $C23D CALL $C1AC    ; Call #R$C1AC.
@label=CheckItemDelivery_Pieces
*$C240 LD IX,$C27B   ; The first piece beside the ship.
 $C244 LD DE,$7438   ; The picture of type #N$0C, frame #N$09.
 $C247 LD HL,$0505   ; #REGhl=#N$0505.
 $C24A LD ($5C28),HL ; The first piece is five bytes wide.
 $C24D LD HL,$2300   ; #REGhl=#N$2300.
 $C250 LD ($5C1C),HL ; No rows saved, and the piece is #N($23) pixels high.
 $C253 CALL $C27F    ; Call #R$C27F.
 $C256 LD IX,$C27D   ; The second piece beside the ship.
 $C25A LD DE,$74E9   ; The picture of type #N$0C, frame #N$0A.
 $C25D LD HL,$0303   ; #REGhl=#N$0303.
 $C260 LD ($5C28),HL ; The second piece is three bytes wide.
 $C263 LD HL,$2F00   ; #REGhl=#N$2F00.
 $C266 LD ($5C1C),HL ; No rows saved, and the piece is #N($2F) pixels high.
 $C269 CALL $C27F    ; Call #R$C27F.
 $C26C LD A,($C8FD)  ; The ship's facing.
 $C26F LD ($C279),A  ; The facing the pieces were drawn with.
 $C272 XOR A         ; Clear #REGa.
 $C273 LD ($C27A),A  ; No piece has been drawn yet.
 $C276 JP $AF04      ; Jump to #R$AF04.

; Piece Variables
;
; Used to draw the pieces that are next to the ship. The first byte has
; bit 6 set when a piece is being delivered, and otherwise holds the
; direction that the ship was facing when it started. The second is set to
; #N($80) after a piece is drawn, and the others are the positions of
; the two pieces.
@label=PieceVariables
g$C279 DEFB $00
 $C27A DEFB $00
@label=PieceVariables_FirstSprite
 $C27B DEFW $0000
@label=PieceVariables_SecondSprite
 $C27D DEFW $0000

; Draw Piece
;
; Used by the routine at #R$C1CE.
; .
; Draws one of the two pieces that are next to the ship, if there is
; one. The position of the piece is at #REGix and its sprite
; is in #REGde. Pieces that are being delivered are drawn directly to the
; screen with #R$A59F.
;
; DE Address of the sprite
; IX Address of the position
@label=DrawPiece
c$C27F PUSH DE         ; Stash #REGde on the stack.
 $C280 LD A,($C279)    ; The piece flags.
 $C283 BIT 6,A         ; {Jump to #R$C299 if bit 6 of #REGa is set.
 $C285 JR NZ,$C299     ; }
 $C287 AND A           ; {Jump to #R$C2D2 if #REGa is zero.
 $C288 JR Z,$C2D2      ; }
 $C28A LD B,A          ; #REGb=#REGa.
 $C28B LD A,($C27A)    ; A piece has already been drawn.
 $C28E AND A           ; {Jump to #R$C299 if #REGa is not zero.
 $C28F JR NZ,$C299     ; }
 $C291 LD A,($C8FD)    ; The ship's facing.
 $C294 XOR B           ; Flip the bits of #REGa that are set in #REGb.
 $C295 BIT 7,A         ; {Jump to #R$C2D2 if bit 7 of #REGa is clear.
 $C297 JR Z,$C2D2      ; }
@label=DrawPiece_Draw
*$C299 LD A,($5C1D)    ; The height of the piece.
 $C29C LD ($5C1C),A    ; Keep the height of the piece.
 $C29F LD L,(IX+$00)   ; Read offset #N$00 of #REGix into #REGl.
 $C2A2 LD H,(IX+$01)   ; Read offset #N$01 of #REGix into #REGh.
 $C2A5 LD A,H          ; #REGa=#REGh.
 $C2A6 LD ($A289),A    ; Update the row offsets.
 $C2A9 LD A,($5C1C)    ; The height of the piece.
 $C2AC CALL $C331      ; Call #R$C331.
 $C2AF LD A,B          ; #REGa=#REGb.
 $C2B0 LD ($5C1C),A    ; The height, kept below the top of the playfield.
 $C2B3 LD ($BF83),HL   ; The position of the piece.
 $C2B6 LD IY,$A62F     ; The second aligned-row erase.
 $C2BA LD A,($5C28)    ; The piece width in bytes.
 $C2BD CP $05          ; {Jump to #R$C2C5 if #REGa is #N$05.
 $C2BF JR Z,$C2C5      ; }
 $C2C1 LD IY,$A63B     ; The fourth aligned-row erase.
@label=DrawPiece_Draw2
*$C2C5 LD A,($C279)    ; The piece flags.
 $C2C8 CALL $BF88      ; Call #R$BF88.
 $C2CB LD HL,($BF83)   ; Fetch the word at #R$BF83 into #REGhl.
 $C2CE CALL $A149      ; Call #R$A149.
 $C2D1 EXX             ; Switch to the alternate registers.
@label=DrawPiece_Done
*$C2D2 POP DE          ; Bring #REGde back off the stack.
 $C2D3 LD A,($C279)    ; The piece flags.
 $C2D6 BIT 6,A         ; {Jump to #R$C2E1 if bit 6 of #REGa is clear.
 $C2D8 JR Z,$C2E1      ; }
 $C2DA XOR A           ; Clear #REGa.
 $C2DB LD ($5C1D),A    ; Draw the piece straight to the screen.
 $C2DE JP $A59F        ; Jump to #R$A59F.
@label=DrawPiece_Ship
*$C2E1 LD (IX+$00),$68 ; Store #N$68 at offset #N$00 of #REGix.
 $C2E5 LD A,($5C38)    ; The ship row.
 $C2E8 SUB $0D         ; Subtract #N$0D from #REGa.
 $C2EA LD (IX+$01),A   ; Write #REGa to offset #N$01 of #REGix.
 $C2ED LD HL,$A67D     ; The second aligned-row draw.
 $C2F0 LD A,($5C29)    ; The piece width in bytes.
 $C2F3 CP $05          ; {Jump to #R$C306 if #REGa is #N$05.
 $C2F5 JR Z,$C306      ; }
 $C2F7 LD (IX+$00),$78 ; Store #N$78 at offset #N$00 of #REGix.
 $C2FB LD A,(IX+$01)   ; Read offset #N$01 of #REGix.
 $C2FE SUB $23         ; Subtract #N$23 from #REGa.
 $C300 LD (IX+$01),A   ; Write #REGa to offset #N$01 of #REGix.
 $C303 LD HL,$A687     ; The fourth aligned-row draw.
@label=DrawPiece_Mask
*$C306 LD A,($C8FD)    ; The ship's facing.
 $C309 BIT 7,A         ; {Jump to #R$C311 if bit 7 of #REGa is clear.
 $C30B JR Z,$C311      ; }
 $C30D LD (IX+$00),$60 ; Store #N$60 at offset #N$00 of #REGix.
@label=DrawPiece_Position
*$C311 PUSH HL         ; Stash #REGhl on the stack.
 $C312 LD L,(IX+$00)   ; Read offset #N$00 of #REGix into #REGl.
 $C315 LD H,(IX+$01)   ; Read offset #N$01 of #REGix into #REGh.
 $C318 LD A,H          ; #REGa=#REGh.
 $C319 LD ($A28A),A    ; The row the piece is drawn on.
 $C31C LD A,($5C1D)    ; The height of the piece.
 $C31F CALL $C331      ; Call #R$C331.
 $C322 LD A,B          ; #REGa=#REGb.
 $C323 LD ($5C1D),A    ; The height of the piece.
 $C326 CALL $A149      ; Call #R$A149.
 $C329 POP IX          ; Bring #REGix back off the stack.
 $C32B CALL $BFB8      ; Call #R$BFB8.
 $C32E JP $A59F        ; Jump to #R$A59F.

; Limit Height
;
; Used by the routines at #R$8ECA, #R$AF04 and #R$C27F.
; .
; Stops a height from reaching above the top of the playfield, which
; is at row #N($17).
;
;   A Height
;   H Row at the bottom
; O:B Limited height
@label=LimitHeight
c$C331 LD B,A        ; #REGb=#REGa.
 $C332 LD A,H        ; #REGa=#REGh.
 $C333 SUB $17       ; Subtract #N$17 from #REGa.
 $C335 SUB B         ; Subtract #REGb from #REGa.
 $C336 RET NC        ; Return if the carry flag is clear.
 $C337 LD A,H        ; #REGa=#REGh.
 $C338 SUB $17       ; Subtract #N$17 from #REGa.
 $C33A LD B,A        ; #REGb=#REGa.
 $C33B RET           ; Return.

; Save Restart Position
;
; Used by the routine at #R$C374.
; .
; Called when the bottom two bits of the frame counter are zero. The
; position of the ship is saved when it is safe to restart there: that is
; when the row of the screen at #N$57C1 holds only #N($55), or when none of
; the four tiles that are on the screen has anything in it other than the
; tile #N($A6). The position is kept at #R$F5FA to #R$F5FF. This is a best
; reading of the code.
@label=SaveRestartPosition
c$C33C LD HL,$57C1   ; #REGhl=#N$57C1.
 $C33F LD B,$1C      ; #REGb=#N$1C.
@label=SaveRestartPosition_Loop
*$C341 LD A,(HL)     ; Read #REGhl.
 $C342 CP $55        ; {Jump to #R$C361 if #REGa is not #N$55.
 $C344 JR NZ,$C361   ; }
 $C346 INC L         ; Advance #REGl.
 $C347 DJNZ $C341    ; Decrease #REGb and jump to #R$C341 until none remain.
@label=SaveRestartPosition_Zero
 $C349 LD B,$00      ; Clear #REGb.
@label=SaveRestartPosition_Store
*$C34B LD HL,($CE57) ; Fetch the word at #R$CE57 into #REGhl.
 $C34E LD ($F5FA),HL ; Update the map column of the position that the ship
                     ; restarts at.
 $C351 LD HL,($CE45) ; Fetch the word at #R$CE45 into #REGhl.
 $C354 LD A,L        ; #REGa=#REGl.
 $C355 OR B          ; Set the bits of #REGa that are set in #REGb.
 $C356 LD L,A        ; #REGl=#REGa.
 $C357 LD ($F5FC),HL ; Update the position of the ship: horizontal then
                     ; vertical.
 $C35A LD HL,($CE41) ; Fetch the word at #R$CE41 into #REGhl.
 $C35D LD ($F5FE),HL ; Update the scroll offsets: horizontal then vertical.
 $C360 RET           ; Return.
@label=SaveRestartPosition_Tiles
*$C361 LD HL,$DC91   ; The visible tiles.
 $C364 LD B,$04      ; #REGb=#N$04.
@label=SaveRestartPosition_Row
*$C366 LD A,(HL)     ; Read #REGhl.
 $C367 AND A         ; {Jump to #R$C36D if #REGa is zero.
 $C368 JR Z,$C36D    ; }
 $C36A CP $A6        ; {Return if #REGa is not #N$A6.
 $C36C RET NZ        ; }
@label=SaveRestartPosition_Next
*$C36D INC HL        ; Advance #REGhl.
 $C36E DJNZ $C366    ; Decrease #REGb and jump to #R$C366 until none remain.
 $C370 LD B,$01      ; #REGb=#N$01.
 $C372 JR $C34B      ; Jump to #R$C34B.

; Run Frame
;
; Used by the routines at #R$F46C and #R$F48B.
; .
; Does the work for one frame of the game: increases the frame counter at
; #R$9A64, saves the position where the ship can restart with #R$C33C (every
; fourth frame) and clears the scroll speeds. Unless the ship is out of
; control, it is then moved by #R$B234 and tested against the terrain and the
; map objects. The shots are moved by #R$B706 and the rest of the world by
; #R$DDF8, which comes back at #R$C3E3. Then a part that has just been
; collected is fitted and the ship is drawn.
@label=RunFrame
c$C374 LD HL,($9A64) ; The frame counter.
 $C377 INC HL        ; The next frame.
 $C378 LD ($9A64),HL ; Write the frame counter back.
 $C37B BIT 0,L       ; {On even frames the falling timer is left alone.
 $C37D JR Z,$C389    ; }
 $C37F LD A,($896F)  ; The falling timer.
 $C382 AND A         ; {Leave it once it has run out.
 $C383 JR Z,$C389    ; }
 $C385 DEC A         ; One frame less on the timer.
 $C386 LD ($896F),A  ; Write the falling timer back.
@label=RunFrame_Counter
*$C389 LD A,L        ; The low byte of the frame counter.
 $C38A AND %00000011 ; Only the bottom two bits of the frame.
 $C38C CALL Z,$C33C  ; Save the restart position every fourth frame.
 $C38F PUSH IY       ; Keep the pointer that was in #REGiy.
 $C391 XOR A         ; The scroll starts at rest.
 $C392 LD ($CCBB),A  ; No horizontal scroll yet.
 $C395 LD ($CCBA),A  ; No vertical scroll yet.
 $C398 LD A,($8F53)  ; The ship state.
 $C39B CP $0B        ; {State #N$0B or more means the ship is gone.
 $C39D JR NC,$C3DD   ; }
 $C39F LD IX,$C8E5   ; The ship.
 $C3A3 CALL $B234    ; Change the ship's speeds from the controls.
 $C3A6 LD A,$FF      ; The ship uses collision mode #N$FF.
 $C3A8 LD ($5C25),A  ; Remember that mode for the terrain test.
 $C3AB LD A,($96AB)  ; The crystal-delivery flag.
 $C3AE AND A         ; {A delivered stack skips the terrain test.
 $C3AF JR NZ,$C3DD   ; }
 $C3B1 CALL $B9EC    ; Give the ship the opposite of the scroll, so it stays
                     ; put.
 $C3B4 LD C,$30      ; The ship's collision width is #N($30).
 $C3B6 LD A,($F5F6)  ; The ninth part flag.
 $C3B9 AND A         ; Is the ninth part fitted?
 $C3BA LD B,$04      ; Four extra rows of height without that part.
 $C3BC JR Z,$C3C0    ; Jump to #R$C3C0 if the zero flag is set.
 $C3BE LD B,$00      ; No extra rows.
@label=RunFrame_Add
*$C3C0 LD A,($C1A9)  ; The height of the ship.
 $C3C3 ADD A,B       ; Add the extra rows.
 $C3C4 LD B,A        ; That is the collision height.
 $C3C5 CALL $BA21    ; Test the ship against the terrain.
 $C3C8 CALL $A8F4    ; Test the ship against the map objects.
 $C3CB LD HL,($C8EC) ; The ship's horizontal speed.
 $C3CE LD ($C8FE),HL ; Keep it for the end of the frame.
 $C3D1 LD HL,($C8EE) ; The ship's vertical speed.
 $C3D4 LD ($C900),HL ; Keep it for the end of the frame.
 $C3D7 CALL $B9EC    ; Set the ship speeds from the scroll again.
 $C3DA CALL $BF66    ; Move the ship by those speeds.
@label=RunFrame_Shots
*$C3DD CALL $B706    ; Call #R$B706.
 $C3E0 JP $DDF8      ; Jump to #R$DDF8.
; This entry point is used by the routine at #R$DDF8.
@label=RunFrame_Draw
*$C3E3 POP IY        ; Back to the pointer saved at the start of the frame.
 $C3E5 LD A,($96AB)  ; The crystal-delivery flag.
 $C3E8 AND A         ; {A delivered stack draws nothing more this frame.
 $C3E9 RET NZ        ; }
 $C3EA LD A,($8F53)  ; The ship state.
 $C3ED CP $0B        ; {An explosion past ten draws nothing more.
 $C3EF RET NC        ; }
 $C3F0 CALL $9724    ; Call #R$9724.
 $C3F3 LD A,($9A64)  ; The frame counter.
 $C3F6 AND %00000001 ; Bit 0 set means an odd frame.
 $C3F8 JR NZ,$C421   ; Jump to #R$C421 if the zero flag is clear.
 $C3FA CALL $C1CE    ; Call #R$C1CE.
 $C3FD LD A,($C904)  ; The carried-item marker.
 $C400 AND A         ; {Jump to #R$C421 if #REGa is not zero.
 $C401 JR NZ,$C421   ; }
 $C403 LD A,($8F53)  ; The ship state.
 $C406 CP $0A        ; {State ten skips the flame test.
 $C408 JR Z,$C421    ; }
 $C40A LD A,($BC12)  ; A finished slope check skips the flames.
 $C40D AND A         ; {Jump to #R$C421 if #REGa is not zero.
 $C40E JR NZ,$C421   ; }
 $C410 LD A,($5C36)  ; The steering direction.
 $C413 AND A         ; {Jump to #R$C5EA if #REGa is zero.
 $C414 JP Z,$C5EA    ; }
 $C417 LD B,A        ; The direction being steered.
 $C418 LD A,($C8FD)  ; The ship's facing.
 $C41B XOR B         ; Flip the bits of #REGa that are set in #REGb.
 $C41C BIT 7,A       ; {Jump to #R$C5EA if bit 7 of #REGa is clear.
 $C41E JP Z,$C5EA    ; }
; This entry point is used by the routine at #R$9572.
@label=RunFrame_Ship
*$C421 LD HL,$0000   ; The draw scratch starts clear.
 $C424 LD ($5C1C),HL ; The draw scratch starts at zero.
 $C427 LD A,($C903)  ; The ship's screen row.
 $C42A LD ($A289),A  ; The row the sprites are drawn on.
 $C42D LD HL,$0606   ; A width and height of six.
 $C430 LD ($5C28),HL ; The sprite size is six by six.
 $C433 LD IX,$C8E5   ; The ship.
 $C437 LD A,($8F53)  ; The ship state.
 $C43A CP $0A        ; {State ten skips the flame colour.
 $C43C JR Z,$C453    ; }
 $C43E LD C,(IX+$18) ; The ship's facing.
 $C441 LD A,($5C36)  ; The direction being steered.
 $C444 AND A         ; {Jump to #R$C4AB if #REGa is zero.
 $C445 JR Z,$C4AB    ; }
 $C447 XOR C         ; Compare it with the facing byte.
 $C448 AND %10000000 ; Only the facing bit.
 $C44A LD ($C7C0),A  ; Note that the steering and the facing differ.
 $C44D JR Z,$C4AB    ; Jump to #R$C4AB if the zero flag is set.
 $C44F XOR A         ; Clear #REGa.
 $C450 LD ($5C39),A  ; Clear the shot scratch.
@label=RunFrame_Erase
*$C453 LD HL,($C902) ; Where the ship was drawn.
 $C456 LD ($BF83),HL ; Keep that, so it can be erased.
 $C459 LD DE,($C1AA) ; The ship graphic in the buffer.
 $C45D LD A,($C1A9)  ; The height of the ship.
 $C460 LD ($5C1C),A  ; The height, kept for the draw.
 $C463 LD IY,$A629   ; The erase aligned row directly.
 $C467 CALL $BF85    ; Call #R$BF85.
 $C46A LD HL,($BF83) ; Fetch the word at #R$BF83 into #REGhl.
 $C46D CALL $A149    ; Call #R$A149.
 $C470 EXX           ; Switch to the alternate registers.
 $C471 LD A,(IX+$1F) ; Read offset #N$1F of #REGix.
 $C474 AND A         ; {Jump to #R$C4AB if #REGa is zero.
 $C475 JR Z,$C4AB    ; }
 $C477 BIT 7,A       ; {Jump to #R$C485 if bit 7 of #REGa is clear.
 $C479 JR Z,$C485    ; }
 $C47B CALL $AA37    ; Call #R$AA37.
 $C47E LD A,$80      ; #REGa=#N$80.
 $C480 LD ($C27A),A  ; A piece has been drawn.
 $C483 JR $C4B1      ; Jump to #R$C4B1.
@label=RunFrame_FitPart
*$C485 LD B,A        ; #REGb=#REGa.
 $C486 DEC A         ; Step #REGa back.
 $C487 LD HL,$F5EE   ; The first part flag.
 $C48A CALL $9BCF    ; Call #R$9BCF.
 $C48D LD (HL),B     ; Write #REGb where #REGhl points.
 $C48E CALL $A59F    ; Call #R$A59F.
 $C491 CALL $AFE9    ; Call #R$AFE9.
 $C494 LD A,$80      ; #REGa=#N$80.
 $C496 LD ($C27A),A  ; A piece has been drawn.
 $C499 LD IX,$C8E5   ; The ship.
 $C49D LD HL,$0000   ; #REGhl=#N$00.
 $C4A0 LD ($5C1C),HL ; No saved row count.
 $C4A3 LD HL,$0606   ; #REGhl=#N$0606.
 $C4A6 LD ($5C28),HL ; The ship sprite is six bytes wide.
 $C4A9 JR $C4B1      ; Jump to #R$C4B1.
@label=RunFrame_Check
*$C4AB LD A,(IX+$1F) ; Read offset #N$1F of #REGix.
 $C4AE AND A         ; {Jump to #R$C453 if #REGa is not zero.
 $C4AF JR NZ,$C453   ; }
@label=RunFrame_Facing
*$C4B1 LD A,($5C36)  ; The steering direction.
 $C4B4 AND A         ; {Jump to #R$C4BA if #REGa is zero.
 $C4B5 JR Z,$C4BA    ; }
 $C4B7 LD (IX+$18),A ; Write #REGa to offset #N$18 of #REGix.
@label=RunFrame_Explosion
*$C4BA LD A,($8F53)  ; The ship state.
 $C4BD CP $0A        ; {Jump to #R$C4E1 if #REGa is #N$0A.
 $C4BF JR Z,$C4E1    ; }
 $C4C1 LD A,($C903)  ; The row the ship was drawn on.
 $C4C4 LD ($A28A),A  ; The row the ship was drawn on.
 $C4C7 LD DE,($C1AA) ; Fetch the word at #R$C1AA into #REGde.
 $C4CB LD HL,($C902) ; Fetch the word at #N$C902 into #REGhl.
 $C4CE LD ($BF83),HL ; The position the ship was drawn at.
 $C4D1 CALL $A149    ; Call #R$A149.
 $C4D4 LD A,($C1A9)  ; The height of the ship.
 $C4D7 LD ($5C1D),A  ; The height of the ship.
 $C4DA LD IX,$A678   ; The draw aligned row directly.
 $C4DE CALL $BFB8    ; Call #R$BFB8.
@label=RunFrame_DrawShip
*$C4E1 CALL $A59F    ; Call #R$A59F.
 $C4E4 CALL $F1BD    ; Call #R$F1BD.
 $C4E7 LD A,($8F53)  ; The ship state.
 $C4EA CP $0A        ; {Return if #REGa is #N$0A or more.
 $C4EC RET NC        ; }
; Continue on to #R$C4ED.

; Draw Ship Top
;
; Used by the routines at #R$9572 and #R$F48B.
; .
; Draws the top of the ship, which is one of the six sprites for types
; #N($01) to #N($06): the one that is used depends on the horizontal speed of
; the ship, and type #N($06) is used while the ship has just been hit.
; Then it checks for the pause keys with #R$9F54 and fires the weapons with
; #R$B731. Carries on with #R$C6D2 or #R$C5FF on alternate frames. This is a
; best reading of the code.
@label=DrawShipTop
c$C4ED LD HL,$0000     ; #REGhl=#N$00.
 $C4F0 LD ($5C1C),HL   ; No saved row count.
 $C4F3 LD IX,$C7BC     ; The ship top object.
 $C4F7 CALL $A19F      ; Call #R$A19F.
 $C4FA LD HL,($C7BD)   ; Fetch the word at #R$C7BD into #REGhl.
 $C4FD LD ($BF83),HL   ; The position of the ship top.
 $C500 CALL $A21C      ; Call #R$A21C.
 $C503 CALL $A27A      ; Call #R$A27A.
 $C506 LD HL,($BF83)   ; Fetch the word at #R$BF83 into #REGhl.
 $C509 CALL $A149      ; Call #R$A149.
 $C50C LD IY,$A647     ; The sixth aligned-row erase.
 $C510 CALL $C7B1      ; Call #R$C7B1.
 $C513 JR NZ,$C519     ; Jump to #R$C519 if the zero flag is clear.
 $C515 LD IY,$A7CC     ; The sixth mirrored-row erase.
@label=DrawShipTop_Frame
*$C519 EXX             ; Switch to the alternate registers.
 $C51A LD E,(IX+$00)   ; Read offset #N$00 of #REGix into #REGe.
 $C51D LD A,($C904)    ; The item the ship is about to pick up.
 $C520 AND A           ; {Jump to #R$C534 if #REGa is zero.
 $C521 JR Z,$C534      ; }
 $C523 LD A,($5C38)    ; The ship row.
 $C526 SUB $09         ; Subtract #N$09 from #REGa.
 $C528 LD ($C7BE),A    ; The row of the carried item.
 $C52B LD ($BF84),A    ; The row the item is drawn on.
 $C52E LD E,$FF        ; #REGe=#N$FF.
 $C530 XOR A           ; Clear #REGa.
 $C531 LD ($C904),A    ; Update the item the ship is about to pick up.
@label=DrawShipTop_Speed
*$C534 LD HL,($C8FE)   ; Fetch the word at #N$C8FE into #REGhl.
 $C537 LD A,H          ; #REGa=#REGh.
 $C538 LD H,L          ; #REGh=#REGl.
 $C539 LD L,A          ; #REGl=#REGa.
 $C53A LD A,H          ; #REGa=#REGh.
 $C53B AND A           ; {Jump to #R$C54B if #REGa is not zero.
 $C53C JR NZ,$C54B     ; }
 $C53E LD A,L          ; #REGa=#REGl.
 $C53F CP $80          ; Compare #REGa with #N$80.
 $C541 LD A,H          ; #REGa=#REGh.
 $C542 JR NC,$C54B     ; Jump to #R$C54B if the carry flag is clear.
 $C544 LD A,$80        ; #REGa=#N$80.
 $C546 LD ($C7BF),A    ; The ship top faces left.
 $C549 JR $C553        ; Jump to #R$C553.
@label=DrawShipTop_Fast
*$C54B AND %10000000   ; Keep the bits of #REGa that are set in #N$80.
 $C54D LD ($C7BF),A    ; The facing of the ship top.
 $C550 CALL NZ,$BE08   ; Call #R$BE08 if the zero flag is clear.
@label=DrawShipTop_Select
*$C553 LD A,L          ; #REGa=#REGl.
 $C554 AND %10000000   ; Keep the bits of #REGa that are set in #N$80.
 $C556 RLCA            ; Rotate #REGa left.
 $C557 SLA H           ; Shift #REGh left.
 $C559 ADD A,H         ; #REGa gains #REGh.
 $C55A INC A           ; Advance #REGa.
 $C55B LD (IX+$00),A   ; Write #REGa to offset #N$00 of #REGix.
 $C55E LD A,($5C3E)    ; The horizontal scroll limit.
 $C561 LD B,A          ; #REGb=#REGa.
 $C562 LD A,H          ; #REGa=#REGh.
 $C563 CP B            ; {Jump to #R$C56A if #REGa is less than #REGb.
 $C564 JR C,$C56A      ; }
 $C566 INC B           ; Advance #REGb.
 $C567 LD (IX+$00),B   ; Write #REGb to offset #N$00 of #REGix.
@label=DrawShipTop_Hit
*$C56A LD A,($8F53)    ; The ship state.
 $C56D AND A           ; {Jump to #R$C580 if #REGa is not zero.
 $C56E JR NZ,$C580     ; }
 $C570 LD A,($C7C1)    ; The hit-flash timer.
 $C573 AND A           ; {Jump to #R$C580 if #REGa is zero.
 $C574 JR Z,$C580      ; }
 $C576 DEC A           ; Step #REGa back.
 $C577 LD ($C7C1),A    ; Update the hit-flash timer.
 $C57A LD (IX+$00),$06 ; Store #N$06 at offset #N$00 of #REGix.
 $C57E JR $C59C        ; Jump to #R$C59C.
@label=DrawShipTop_Show
*$C580 LD A,($8F53)    ; The ship state.
 $C583 CP $0A          ; {Jump to #R$C5CF if #REGa is #N$0A or more.
 $C585 JR NC,$C5CF     ; }
 $C587 LD A,($D0BC)    ; The collision kind.
 $C58A AND A           ; {Jump to #R$C59C if #REGa is not zero.
 $C58B JR NZ,$C59C     ; }
 $C58D LD A,(IX+$00)   ; Read offset #N$00 of #REGix.
 $C590 CP E            ; {Jump to #R$C59C if #REGa is not #REGe.
 $C591 JR NZ,$C59C     ; }
 $C593 LD A,($C7C0)    ; The turn flag.
 $C596 AND A           ; {Jump to #R$C59C if #REGa is not zero.
 $C597 JR NZ,$C59C     ; }
 $C599 LD ($5C1C),A    ; The ship is not turning.
@label=DrawShipTop_Position
*$C59C CALL $A19F      ; Call #R$A19F.
 $C59F LD B,$68        ; #REGb=#N$68.
 $C5A1 LD A,($C8FD)    ; The ship's facing.
 $C5A4 BIT 7,A         ; {Jump to #R$C5AA if bit 7 of #REGa is clear.
 $C5A6 JR Z,$C5AA      ; }
 $C5A8 LD B,$78        ; #REGb=#N$78.
@label=DrawShipTop_Store
*$C5AA LD A,B          ; #REGa=#REGb.
 $C5AB LD ($C7BD),A    ; The column of the ship top.
 $C5AE LD ($BF83),A    ; The column of the ship top.
 $C5B1 CALL $A19F      ; Call #R$A19F.
 $C5B4 CALL $A21C      ; Call #R$A21C.
 $C5B7 CALL $A266      ; Call #R$A266.
 $C5BA LD IX,$A691     ; The sixth aligned-row draw.
 $C5BE CALL $C7B1      ; Call #R$C7B1.
 $C5C1 JR NZ,$C5CF     ; Jump to #R$C5CF if the zero flag is clear.
 $C5C3 LD IX,$A7F9     ; The sixth mirrored-row draw.
 $C5C7 LD A,($BF83)    ; The column of the ship top.
 $C5CA ADD A,$08       ; Add #N$08 to #REGa.
 $C5CC LD ($BF83),A    ; The column one byte to the right.
@label=DrawShipTop_Draw
*$C5CF CALL $A59F      ; Call #R$A59F.
 $C5D2 XOR A           ; Clear #REGa.
 $C5D3 LD ($D0BC),A    ; Update the collision kind.
 $C5D6 LD A,($C7BC)    ; The ship top object.
 $C5D9 CP $06          ; {Jump to #R$C5EA if #REGa is #N$06.
 $C5DB JP Z,$C5EA      ; }
 $C5DE LD HL,($BF83)   ; Fetch the word at #R$BF83 into #REGhl.
 $C5E1 LD A,H          ; #REGa=#REGh.
 $C5E2 SUB $07         ; Subtract #N$07 from #REGa.
 $C5E4 LD H,A          ; #REGh=#REGa.
 $C5E5 CALL $A170      ; Call #R$A170.
 $C5E8 LD (HL),$47     ; Store #N$47 at the address in #REGhl.
; This entry point is used by the routine at #R$C374.
@label=DrawShipTop_Pause
*$C5EA CALL $9F54      ; Call #R$9F54.
 $C5ED CALL $B731      ; Call #R$B731.
 $C5F0 LD A,($8F53)    ; The ship state.
 $C5F3 CP $0A          ; {Jump to #R$C5FF if #REGa is #N$0A or more.
 $C5F5 JR NC,$C5FF     ; }
 $C5F7 LD A,($9A64)    ; The frame counter.
 $C5FA AND %00000001   ; Keep the bits of #REGa that are set in #N$01.
 $C5FC JP Z,$C6D2      ; Jump to #R$C6D2 if the zero flag is set.
; Continue on to #R$C5FF.

; Draw Side Flames
;
; Used by the routines at #R$9F54 and #R$C4ED.
; .
; Does nothing unless part #N$04 has been fitted. Draws the flame at the
; side of the ship when it is moving to the left or to the right, from the
; object at #R$C6C2, and sets its attribute with #R$C6A8. This is a best
; reading of the code.
@label=DrawSideFlames
c$C5FF LD A,($F5F1)    ; The fourth part flag.
 $C602 AND A           ; {Return if #REGa is zero.
 $C603 RET Z           ; }
 $C604 LD IX,$C6C2     ; The side flame object.
 $C608 LD HL,$0000     ; #REGhl=#N$00.
 $C60B LD ($5C1C),HL   ; No saved row count.
 $C60E BIT 7,(IX+$03)  ; {Jump to #R$C61C if bit 7 of offset #N$03 of #REGix is
 $C612 JR NZ,$C61C     ; set.}
 $C614 LD A,($5C37)    ; The controls.
 $C617 AND %00000011   ; Keep the bits of #REGa that are set in #N$03.
 $C619 RET Z           ; Return if the zero flag is set.
 $C61A JR $C635        ; Jump to #R$C635.
@label=DrawSideFlames_Flame
*$C61C CALL $C7A3      ; Call #R$C7A3.
 $C61F LD ($5C1C),A    ; The flame sprite's width.
 $C622 LD HL,($C6C3)   ; Fetch the word at #N$C6C3 into #REGhl.
 $C625 LD IY,$A641     ; The fifth aligned-row erase.
 $C629 BIT 6,(IX+$03)  ; {Jump to #R$C635 if bit 6 of offset #N$03 of #REGix is
 $C62D JR Z,$C635      ; clear.}
 $C62F LD IY,$A7C4     ; The fifth mirrored-row erase.
 $C633 LD B,$F9        ; #REGb=#N$F9.
@label=DrawSideFlames_Update
*$C635 EXX             ; Switch to the alternate registers.
 $C636 LD (IX+$03),$00 ; Store #N$00 at offset #N$03 of #REGix.
 $C63A LD A,($5C37)    ; The controls.
 $C63D AND %00000011   ; Keep the bits of #REGa that are set in #N$03.
 $C63F JP Z,$C691      ; Jump to #R$C691 if the zero flag is set.
 $C642 LD A,($8F53)    ; The ship state.
 $C645 CP $0A          ; {Jump to #R$C691 if #REGa is #N$0A or more.
 $C647 JR NC,$C691     ; }
 $C649 LD A,(IX+$06)   ; Read offset #N$06 of #REGix.
 $C64C INC A           ; Advance #REGa.
 $C64D AND %00000111   ; Keep the bits of #REGa that are set in #N$07.
 $C64F LD (IX+$06),A   ; Write #REGa to offset #N$06 of #REGix.
 $C652 LD HL,$C7A9     ; The flame frames.
 $C655 CALL $9BCF      ; Call #R$9BCF.
 $C658 LD A,(HL)       ; Read #REGhl.
 $C659 ADD A,$0E       ; Add #N$0E to #REGa.
 $C65B LD (IX+$00),A   ; Write #REGa to offset #N$00 of #REGix.
 $C65E CALL $C7A3      ; Call #R$C7A3.
 $C661 LD ($5C1D),A    ; The flame sprite's width.
 $C664 LD (IX+$03),$80 ; Store #N$80 at offset #N$03 of #REGix.
 $C668 LD IX,$A68C     ; The fifth aligned-row draw.
 $C66C LD A,($5C38)    ; The ship row.
 $C66F ADD A,$08       ; Add #N$08 to #REGa.
 $C671 LD H,A          ; #REGh=#REGa.
 $C672 LD L,$50        ; #REGl=#N$50.
 $C674 LD A,($5C37)    ; The controls.
 $C677 BIT 1,A         ; {Jump to #R$C688 if bit 1 of #REGa is clear.
 $C679 JR Z,$C688      ; }
 $C67B LD L,$98        ; #REGl=#N$98.
 $C67D LD B,$F9        ; #REGb=#N$F9.
 $C67F LD A,$C0        ; #REGa=#N$C0.
 $C681 LD ($C6C5),A    ; The side flame faces left.
 $C684 LD IX,$A7F2     ; The fifth mirrored-row draw.
@label=DrawSideFlames_Draw2
*$C688 LD ($C6C6),HL   ; The position of the side flame.
 $C68B CALL $A149      ; Call #R$A149.
 $C68E LD ($C6C3),HL   ; The screen address of the side flame.
@label=DrawSideFlames_Draw
*$C691 CALL $A59F      ; Call #R$A59F.
 $C694 LD A,($C6C5)    ; The side flame faces left.
 $C697 AND %10000000   ; Keep the bits of #REGa that are set in #N$80.
 $C699 RET Z           ; Return if the zero flag is set.
 $C69A LD HL,($C6C6)   ; Fetch the word at #N$C6C6 into #REGhl.
 $C69D LD A,L          ; #REGa=#REGl.
 $C69E AND %11110000   ; Keep the bits of #REGa that are set in #N$F0.
 $C6A0 LD L,A          ; #REGl=#REGa.
 $C6A1 LD A,H          ; #REGa=#REGh.
 $C6A2 SUB $04         ; Subtract #N$04 from #REGa.
 $C6A4 LD H,A          ; #REGh=#REGa.
 $C6A5 LD A,($C6C8)    ; The flame attribute.
; This entry point is used by the routine at #R$C6D2.
@label=SetFlameAttributes
*$C6A8 EX DE,HL        ; Swap #REGde and #REGhl.
 $C6A9 LD HL,$0202     ; #REGhl=#N$0202.
 $C6AC LD ($AF01),HL   ; Update the attribute area.
 $C6AF LD HL,$C79B     ; The flame attributes.
 $C6B2 AND %00000111   ; Keep the bits of #REGa that are set in #N$07.
 $C6B4 CALL $9BCF      ; Call #R$9BCF.
 $C6B7 LD A,(HL)       ; Read #REGhl.
 $C6B8 EX DE,HL        ; Swap #REGde and #REGhl.
 $C6B9 LD ($AF03),A    ; The attribute of the side flame.
 $C6BC LD DE,$AF01     ; The attribute area.
 $C6BF JP $C991        ; Jump to #R$C991.

; Side Flame Object
;
; The object that is used to draw the flame at the side of the ship,
; followed by a copy that is kept for the other player. The byte at #R$C6D0
; is set by #R$BA21 when the ship has landed.
@label=SideFlameObject
g$C6C2 DEFB $00,$00,$00,$00,$00,$00,$00
@label=SideFlameObject_Second
 $C6C9 DEFB $00,$00,$00,$00,$00,$00,$00
 $C6D0 DEFB $00
 $C6D1 DEFB $00

; Draw Main Flame
;
; Used by the routines at #R$9572, #R$C4ED and #R$F48B.
; .
; Does nothing unless part #N$05 has been fitted. Draws the flame under
; the ship, from the object at #R$C78F: a larger one (type #N($11)) when
; going up and a smaller one (type #N($12)) when not. This is a best reading
; of the code.
@label=DrawMainFlame
c$C6D2 LD A,($F5F2)    ; The fifth part flag.
 $C6D5 AND A           ; {Return if #REGa is zero.
 $C6D6 RET Z           ; }
 $C6D7 LD IX,$C78F     ; The main flame object.
 $C6DB LD HL,$0000     ; #REGhl=#N$00.
 $C6DE LD ($5C1C),HL   ; No saved row count.
 $C6E1 LD ($A289),HL   ; Update the row offsets.
 $C6E4 BIT 7,(IX+$03)  ; {Jump to #R$C703 if bit 7 of offset #N$03 of #REGix is
 $C6E8 JR Z,$C703      ; clear.}
 $C6EA CALL $C7A3      ; Call #R$C7A3.
 $C6ED LD ($5C1C),A    ; The flame sprite's width.
 $C6F0 LD HL,($C790)   ; Fetch the word at #N$C790 into #REGhl.
 $C6F3 LD IY,$A635     ; The third aligned-row erase.
 $C6F7 BIT 6,(IX+$03)  ; {Jump to #R$C703 if bit 6 of offset #N$03 of #REGix is
 $C6FB JR Z,$C703      ; clear.}
 $C6FD LD IY,$A7B4     ; The third mirrored-row erase.
 $C701 LD B,$F9        ; #REGb=#N$F9.
@label=DrawMainFlame_Update
*$C703 RES 7,(IX+$03)  ; Reset bit 7 of offset #N$03 of #REGix.
 $C707 EXX             ; Switch to the alternate registers.
 $C708 LD A,($C6D0)    ; The ship has landed.
 $C70B AND A           ; {Jump to #R$C774 if #REGa is not zero.
 $C70C JR NZ,$C774     ; }
 $C70E LD (IX+$00),$12 ; Store #N$12 at offset #N$00 of #REGix.
 $C712 LD A,($8F53)    ; The ship state.
 $C715 CP $0A          ; {Jump to #R$C774 if #REGa is #N$0A or more.
 $C717 JR NC,$C774     ; }
 $C719 LD A,($5C37)    ; The controls.
 $C71C AND %00001000   ; Keep the bits of #REGa that are set in #N$08.
 $C71E JR Z,$C724      ; Jump to #R$C724 if the zero flag is set.
 $C720 LD (IX+$00),$11 ; Store #N$11 at offset #N$00 of #REGix.
@label=DrawMainFlame_Frame
*$C724 CALL $C7A3      ; Call #R$C7A3.
 $C727 LD ($5C1D),A    ; The flame sprite's width.
 $C72A LD A,(IX+$03)   ; Read offset #N$03 of #REGix.
 $C72D XOR %01000000   ; Flip the bits of #REGa that are set in #N$40.
 $C72F OR %10000000    ; Set the bits of #REGa that are set in #N$80.
 $C731 LD (IX+$03),A   ; Write #REGa to offset #N$03 of #REGix.
 $C734 LD A,($96AB)    ; The crystal-delivery flag.
 $C737 AND A           ; {Jump to #R$C746 if #REGa is zero.
 $C738 JR Z,$C746      ; }
 $C73A LD A,($96B2)    ; The row of the crystal stack.
 $C73D ADD A,$13       ; Add #N$13 to #REGa.
 $C73F LD H,A          ; #REGh=#REGa.
 $C740 LD (IX+$00),$11 ; Store #N$11 at offset #N$00 of #REGix.
 $C744 JR $C757        ; Jump to #R$C757.
@label=DrawMainFlame_Position
*$C746 LD A,($5C38)    ; The ship row.
 $C749 ADD A,$1D       ; Add #N$1D to #REGa.
 $C74B LD H,A          ; #REGh=#REGa.
 $C74C LD A,(IX+$00)   ; Read offset #N$00 of #REGix.
 $C74F CP $11          ; {Jump to #R$C757 if #REGa is #N$11.
 $C751 JR Z,$C757      ; }
 $C753 LD A,H          ; #REGa=#REGh.
 $C754 SUB $08         ; Subtract #N$08 from #REGa.
 $C756 LD H,A          ; #REGh=#REGa.
@label=DrawMainFlame_Side
*$C757 LD L,$68        ; #REGl=#N$68.
 $C759 BIT 6,(IX+$03)  ; Test bit 6 of offset #N$03 of #REGix.
 $C75D LD IX,$A682     ; The third aligned-row draw.
 $C761 JR Z,$C76B      ; Jump to #R$C76B if the zero flag is set.
 $C763 LD IX,$A7E4     ; The third mirrored-row draw.
 $C767 LD B,$F9        ; #REGb=#N$F9.
 $C769 LD L,$80        ; #REGl=#N$80.
@label=DrawMainFlame_Store
*$C76B LD ($C793),HL   ; The position of the main flame.
 $C76E CALL $A149      ; Call #R$A149.
 $C771 LD ($C790),HL   ; The screen address of the main flame.
@label=DrawMainFlame_Draw
*$C774 CALL $A59F      ; Call #R$A59F.
 $C777 XOR A           ; Clear #REGa.
 $C778 LD ($C6D0),A    ; The ship is no longer on the ground.
 $C77B LD A,($C792)    ; The main flame faces left.
 $C77E AND %10000000   ; Keep the bits of #REGa that are set in #N$80.
 $C780 RET Z           ; Return if the zero flag is set.
 $C781 LD HL,($C793)   ; Fetch the word at #N$C793 into #REGhl.
 $C784 LD A,H          ; #REGa=#REGh.
 $C785 SUB $07         ; Subtract #N$07 from #REGa.
 $C787 LD H,A          ; #REGh=#REGa.
 $C788 LD L,$70        ; #REGl=#N$70.
 $C78A LD A,$07        ; #REGa=#N$07.
 $C78C JP $C6A8        ; Jump to #R$C6A8.

; Main Flame Object
;
; The object that is used to draw the flame under the ship.
@label=MainFlameObject
g$C78F DEFB $12,$00,$00,$00,$00,$00
@label=MainFlameObject_Second
 $C795 DEFB $12,$00,$00,$00,$00,$00

; Flame Attributes
;
; The attributes for the flames, which are used in turn.
@label=FlameAttributes
b$C79B DEFB $42      ; #COLOUR(#PEEK(#PC)).
 $C79C DEFB $46      ; #COLOUR(#PEEK(#PC)).
 $C79D DEFB $43      ; #COLOUR(#PEEK(#PC)).
 $C79E DEFB $41      ; #COLOUR(#PEEK(#PC)).
 $C79F DEFB $46      ; #COLOUR(#PEEK(#PC)).
 $C7A0 DEFB $43      ; #COLOUR(#PEEK(#PC)).
 $C7A1 DEFB $42      ; #COLOUR(#PEEK(#PC)).
 $C7A2 DEFB $47      ; #COLOUR(#PEEK(#PC)).

; Fetch Sprite Type
;
; Used by the routines at #R$C5FF and #R$C6D2.
; .
; Finds the sprite for the type of an object, and reads the first byte
; of it, which is its width.
;
;   IX Address of the object
; O:A Width of the sprite
; O:DE Address of the second byte of the sprite
@label=FetchSpriteType
c$C7A3 CALL $A19F    ; Call #R$A19F.
 $C7A6 LD A,(DE)     ; Read #REGde.
 $C7A7 INC DE        ; Advance #REGde.
 $C7A8 RET           ; Return.

; Flame Frames
;
; Eight numbers that are added to fourteen to make the type of the flame.
@label=FlameFrames
b$C7A9 DEFB $00,$01,$02,$01,$00,$02,$01,$02

; Test Direction
;
; Used by the routine at #R$C4ED.
; .
; Tests the flag at #R$C7BF, which has bit 7 set when the object is facing
; left. If it is not, #REGl is increased, #REGb is made #N($F9) and the zero
; flag is set.
;
;   L Horizontal position
; O:A Zero if not facing left
; O:B #N($F9) if not facing left
; O:F The zero flag is set if the object is not facing left
@label=TestDirection
c$C7B1 LD A,($C7BF)  ; The ship top faces left.
 $C7B4 BIT 7,A       ; {Return if bit 7 of #REGa is set.
 $C7B6 RET NZ        ; }
 $C7B7 LD B,$F9      ; #REGb=#N$F9.
 $C7B9 INC L         ; Advance #REGl.
 $C7BA XOR A         ; Clear #REGa.
 $C7BB RET           ; Return.

; Ship Top Object
;
; The object that is used to draw the top of the ship: its type, its
; position on the screen, and some flags. The flag at #R$C7BF has bit 7 set
; when it faces left, and #R$C7C1 is the number of frames for which it is
; shown as hit. There is a second copy of it that is kept for the other
; player.
@label=ShipTopObject
g$C7BC DEFB $01
 $C7BD DEFB $68
 $C7BE DEFB $61
 $C7BF DEFB $00
 $C7C0 DEFB $00
 $C7C1 DEFB $00
@label=ShipTopObject_Second
 $C7C2 DEFB $01,$68,$61,$00,$00,$00

; Ship Top Sprites
;
; The sprites for types #N($01) to #N($06), each of which is one byte wide
; and has one to eight rows.
@label=ShipTopSprites
b$C7C8 DEFB $01,$08,$01,$01,$01,$01,$01,$01,$00,$01
 $C7D2 DEFB $01,$08,$01,$01,$01,$01,$02,$02,$02,$04
 $C7DC DEFB $01,$07,$01,$01,$01,$02,$02,$04,$10
 $C7E5 DEFB $01,$06,$01,$01,$02,$04,$18,$40
 $C7ED DEFB $01,$05,$01,$01,$06,$38,$80
 $C7F4 DEFB $01,$04,$01,$81,$42,$3C

; Horizontal Scroll Fraction
;
; The fraction of a pixel that is left over from the horizontal speed
; worked out by #R$C81F.
@label=HorizontalScrollFraction
g$C7FA DEFW $0000

; Update Horizontal Speed
;
; Used by the routine at #R$B234.
; .
; Adds the acceleration in #REGde to the horizontal speed of the ship,
; limits it, and sets it to zero if the ship has turned round. Carries on at
; #R$C81F to work out the horizontal scroll speed.
;
; DE Acceleration
; IX Address of the ship
@label=UpdateHorizontalSpeed
c$C7FC LD H,(IX+$19) ; Read offset #N$19 of #REGix into #REGh.
 $C7FF LD L,(IX+$1A) ; Read offset #N$1A of #REGix into #REGl.
 $C802 EX DE,HL      ; Swap #REGde and #REGhl.
 $C803 ADD HL,DE     ; #REGhl gains #REGde.
 $C804 CALL $C868    ; Call #R$C868.
 $C807 LD A,($5C36)  ; The steering direction.
 $C80A AND A         ; {Jump to #R$C819 if #REGa is not zero.
 $C80B JR NZ,$C819   ; }
 $C80D LD A,H        ; #REGa=#REGh.
 $C80E XOR D         ; Flip the bits of #REGa that are set in #REGd.
 $C80F AND %10000000 ; Keep the bits of #REGa that are set in #N$80.
 $C811 JR Z,$C819    ; Jump to #R$C819 if the zero flag is set.
 $C813 LD HL,$0000   ; #REGhl=#N$00.
 $C816 LD ($C7FA),HL ; Update the horizontal scroll fraction.
@label=UpdateHorizontalSpeed_Store
*$C819 LD (IX+$19),H ; Write #REGh to offset #N$19 of #REGix.
 $C81C LD (IX+$1A),L ; Write #REGl to offset #N$1A of #REGix.
; Continue on to #R$C81F.

; Update Horizontal Scroll Speed
;
; Used by the routine at #R$BA21.
; .
; Adds the horizontal speed of the ship to the fraction in #R$C7FA and
; works out how many whole pixels of horizontal scroll that makes, limited by
; the value in #R$5C3E in the same way as #R$B2D5 for the vertical scroll.
; The result is stored in #R$CCBB.
;
; HL Horizontal speed
@label=UpdateHorizontalScrollSpeed
c$C81F LD DE,($C7FA) ; Fetch the word at #R$C7FA into #REGde.
 $C823 ADD HL,DE     ; #REGhl gains #REGde.
 $C824 LD ($C7FA),HL ; Update the horizontal scroll fraction.
 $C827 LD A,H        ; #REGa=#REGh.
 $C828 SUB D         ; Subtract #REGd from #REGa.
 $C829 ADD A,A       ; Double #REGa.
 $C82A LD H,A        ; #REGh=#REGa.
 $C82B LD A,($5C3E)  ; The horizontal scroll limit.
 $C82E BIT 7,H       ; {Jump to #R$C837 if bit 7 of #REGh is set.
 $C830 JR NZ,$C837   ; }
 $C832 ADD A,$02     ; Add #N$02 to #REGa.
 $C834 LD B,A        ; #REGb=#REGa.
 $C835 JR $C83C      ; Jump to #R$C83C.
@label=UpdateHorizontalScrollSpeed_Negative
*$C837 NEG           ; Negate #REGa.
 $C839 SUB $02       ; Subtract #N$02 from #REGa.
 $C83B LD B,A        ; #REGb=#REGa.
@label=UpdateHorizontalScrollSpeed_Limit
*$C83C LD A,H        ; #REGa=#REGh.
 $C83D BIT 7,A       ; {Jump to #R$C847 if bit 7 of #REGa is set.
 $C83F JR NZ,$C847   ; }
 $C841 CP B          ; {Jump to #R$C84F if #REGa is not #REGb.
 $C842 JR NZ,$C84F   ; }
 $C844 LD A,($5C3E)  ; The horizontal scroll limit.
@label=UpdateHorizontalScrollSpeed_Fast
*$C847 CP B          ; {Jump to #R$C84F if #REGa is not #REGb.
 $C848 JR NZ,$C84F   ; }
 $C84A LD A,($5C3E)  ; The horizontal scroll limit.
 $C84D NEG           ; Negate #REGa.
@label=UpdateHorizontalScrollSpeed_Store
*$C84F LD ($CCBB),A  ; Update the horizontal scroll speed.
 $C852 CP $04        ; {Jump to #R$C859 if #REGa is #N$04.
 $C854 JR Z,$C859    ; }
 $C856 CP $FC        ; {Return if #REGa is not #N$FC.
 $C858 RET NZ        ; }
@label=UpdateHorizontalScrollSpeed_Halve
*$C859 LD A,($CE41)  ; The horizontal offset.
 $C85C AND %00000010 ; Keep the bits of #REGa that are set in #N$02.
 $C85E RET Z         ; Return if the zero flag is set.
 $C85F LD A,($CCBB)  ; The horizontal scroll speed.
 $C862 SRA A         ; Shift #REGa right keeping the sign.
 $C864 LD ($CCBB),A  ; Update the horizontal scroll speed.
 $C867 RET           ; Return.

; Limit Horizontal Speed
;
; Used by the routine at #R$C7FC.
; .
; Keeps the horizontal speed of the ship within a limit that is half the
; value at #R$5C3E.
;
;   H Horizontal speed
; O:H Limited horizontal speed
@label=LimitHorizontalSpeed
c$C868 LD A,($5C3E)  ; The horizontal scroll limit.
 $C86B SRL A         ; Shift #REGa right.
 $C86D BIT 7,H       ; {Jump to #R$C87A if bit 7 of #REGh is clear.
 $C86F JR Z,$C87A    ; }
 $C871 NEG           ; Negate #REGa.
 $C873 LD B,A        ; #REGb=#REGa.
 $C874 LD A,H        ; #REGa=#REGh.
 $C875 CP B          ; {Return if #REGa is #REGb or more.
 $C876 RET NC        ; }
 $C877 DEC B         ; Step #REGb back.
 $C878 LD H,B        ; #REGh=#REGb.
 $C879 RET           ; Return.
@label=LimitHorizontalSpeed_Positive
*$C87A LD B,A        ; #REGb=#REGa.
 $C87B LD A,H        ; #REGa=#REGh.
 $C87C CP B          ; {Return if #REGa is less than #REGb.
 $C87D RET C         ; }
 $C87E LD H,B        ; #REGh=#REGb.
 $C87F RET           ; Return.

; Limit Speed
;
; Used by the routine at #R$BA21.
; .
; Keeps the high byte of a speed within #N($FD) (the fastest upwards or
; to the left) and #N($02) (the fastest downwards or to the right).
;
;   H Speed (high byte)
; O:H Limited speed (high byte)
@label=LimitSpeed
c$C880 LD A,H        ; #REGa=#REGh.
 $C881 BIT 7,A       ; {Jump to #R$C88B if bit 7 of #REGa is clear.
 $C883 JR Z,$C88B    ; }
 $C885 CP $FE        ; {Return if #REGa is #N$FE or more.
 $C887 RET NC        ; }
 $C888 LD H,$FD      ; #REGh=#N$FD.
 $C88A RET           ; Return.
@label=LimitSpeed_Positive
*$C88B CP $02        ; {Return if #REGa is less than #N$02.
 $C88D RET C         ; }
 $C88E LD H,$02      ; #REGh=#N$02.
 $C890 RET           ; Return.

; Ship Base Graphic
;
; The picture of the ship without any parts fitted: fourteen rows of six
; bytes. #R$AFE9 copies it to the buffer at #N($F755) when the ship is built.
@label=ShipBaseGraphic
b$C891 DEFB $00,$00,$07,$FC,$00,$00
 $C897 DEFB $00,$0F,$F8,$06,$00,$00
 $C89D DEFB $00,$3F,$FF,$F8,$00,$00
 $C8A3 DEFB $00,$FF,$FF,$FF,$F8,$00
 $C8A9 DEFB $03,$FF,$FF,$FF,$FF,$F8
 $C8AF DEFB $02,$00,$00,$00,$00,$1E
 $C8B5 DEFB $01,$FF,$FF,$FF,$FF,$E0
 $C8BB DEFB $00,$83,$FF,$E0,$0E,$00
 $C8C1 DEFB $00,$43,$FF,$EF,$E0,$00
 $C8C7 DEFB $00,$23,$FF,$EE,$00,$00
 $C8CD DEFB $00,$13,$FF,$E0,$00,$00
 $C8D3 DEFB $00,$0B,$FE,$00,$00,$00
 $C8D9 DEFB $00,$07,$E0,$00,$00,$00
 $C8DF DEFB $00,$02,$00,$00,$00,$00

; Ship Object
;
; The player's ship. The first #N($18) bytes have the layout of an enemy
; slot, as described at #R$9974, and then there are some extra fields:
; #TABLE(default,centre,centre)
; { =h Offset | =h Contents }
; { #N($18) | Bit 7 is set when the ship is facing left }
; { #N($19)-#N($1A) | Copy of the horizontal speed (offsets #N($07) and
; #N($08)) taken at the end of the frame }
; { #N($1B)-#N($1C) | Copy of the vertical speed (offsets #N($09) and
; #N($0A)) taken at the end of the frame }
; { #N($1D)-#N($1E) | Horizontal then vertical position at which the ship was
; last drawn, which is used to erase it }
