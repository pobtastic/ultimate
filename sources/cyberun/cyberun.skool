                                                                                                        ; ON"
@label=PlanetCompleteText_FirstRecord
 $8501 DEFB $38,$6F,$47,$10
@label=PlanetCompleteText_FirstPlanetName
 $8505 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00                             ; Space for
                                                                                                        ; the name
                                                                                                        ; of the
                                                                                                        ; planet
                                                                                                        ; just
                                                                                                        ; finished.
 $8515 DEFB $50,$7F,$46,$0A
 $8519 DEFB $0F,$11,$0E,$02,$04,$04,$03,$26,$13,$0E                                                     ; "PROCEED
                                                                                                        ; TO"
 $8523 DEFB $38,$8F,$44,$0F
@label=PlanetCompleteText_SecondPlanetName
 $8527 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00                                 ; Space for
                                                                                                        ; the name
                                                                                                        ; of the
                                                                                                        ; next
                                                                                                        ; planet.
 $8536 DEFB $48,$9F,$46,$0C
 $853A DEFB $00,$0D,$03,$26,$02,$0E,$0D,$13,$08,$0D,$14,$04                                             ; "AND
                                                                                                        ; CONTINUE"
 $8546 DEFB $30,$AF,$46,$12
 $854A DEFB $02,$11,$18,$12,$13,$00,$0B,$26,$02,$0E,$0B,$0B,$04,$02,$13,$08,$0E,$0D                     ; "CRYSTAL
                                                                                                        ; COLLECTION"

