b$990A DEFB $1A,$01,$50,$02
 $990E DEFB $13,$21,$00,$00
 $9912 DEFB $17,$02,$F0,$01
 $9916 DEFB $18,$01,$F0,$03
 $991A DEFB $19,$01,$00,$00
