; Choose Item Sites
;
; Used by the routine at #R$F3BD.
; .
; Chooses the sites of the items on a planet. Each site is a four byte
; record (map column, map zone, horizontal position and vertical position)
; copied into the table in #REGde. The sites are picked at random from the five
; pools of candidate records at #R$605B, #R$609B, #R$60DB, #R$60E3 and #R$6103,
; using the list of pool numbers at #R$61A9. A pool number of zero leaves the
; site unset or, when the next pool number is #N($03), copies the previous site
; with the positions adjusted.
; .
; Bit 7 of the first byte of a pool record marks it as used so that the same
; record is never picked twice in one go.
;
; DE Address of the table to fill (#R$F604 for player one, #R$F66D for player
; .  two)
;
; Start at the beginning of the list of pool numbers.
@label=ChooseItemSites
c$6113 LD IY,$61A9   ; Use the list of pool numbers at #R$61A9.
; This entry point is used by the routine at #R$83D6.
; .
; Mark all of the pool records as unused.
@label=ChooseItemSites_ClearUsed
*$6117 LD HL,$605B   ; Use the first pool record.
 $611A LD B,$2E      ; Set a counter in #REGb for #N$2E records.
@label=ChooseItemSites_ClearLoop
*$611C LD A,(HL)     ; Fetch the first byte of the record.
 $611D AND %01111111 ; Clear its used flag (bit 7).
 $611F LD (HL),A     ; Write it back.
 $6120 INC HL        ; {Move on to the next record.
 $6121 INC HL        ;
 $6122 INC HL        ;
 $6123 INC HL        ; }
 $6124 DJNZ $611C    ; Decrease the record counter by one and loop back to #R$611C until
                     ; all of the records have been cleared.
 $6126 LD A,$FF      ; {Make the first byte of the record at #R$60E3 #N($FF), so it can
 $6128 LD ($60E3),A  ; never be picked.}
 $612B LD ($60EB),A  ; Do the same for the record at #R$60EB.
; Work through the list of pool numbers, filling one site each time.
@label=ChooseItemSites_Loop
*$612E LD A,(IY+$00) ; Fetch the pool number for this site.
 $6131 AND A         ; Test whether it is zero.
 $6132 JR NZ,$6152   ; Jump to #R$6152 if it is not.
 $6134 LD A,(IY+$01) ; Fetch the next pool number from the list.
 $6137 CP $03        ; Jump to #R$619B if it is not equal to #N($03), leaving this
                     ; site unset.
 $6139 JR NZ,$619B   ;
; This site is a copy of the previous one, moved along a little.
 $613B PUSH DE       ; {Copy the table pointer from #REGde to #REGhl.
 $613C POP HL        ; }
 $613D DEC HL        ; {Step back to the previous site.
 $613E DEC HL        ;
 $613F DEC HL        ;
 $6140 DEC HL        ; }
 $6141 LD BC,$0004   ; Set the length of a site record in #REGbc.
 $6144 LDIR          ; Copy the previous site into this one.
 $6146 DEC DE        ; Step back to the last byte of the site, the vertical
                     ; position.
 $6147 LD A,(DE)     ; Fetch it...
 $6148 SUB $23       ; ...subtract #N$23...
 $614A LD (DE),A     ; ...and write it back.
 $614B DEC DE        ; Step back to the horizontal position.
 $614C LD A,(DE)     ; Fetch it...
 $614D ADD A,$10     ; ...add #N$10...
 $614F LD (DE),A     ; ...and write it back.
 $6150 JR $619D      ; Jump to #R$619D.
; Select the pool for this pool number.
@label=ChooseItemSites_SelectPool
*$6152 LD C,$0F      ; Set the pool size mask to #N$0F (sixteen records).
 $6154 LD HL,$609B   ; Use the pool for pool number #N$01.
 $6157 CP $01        ; {Jump to #R$6179 if the pool number is #N$01.
 $6159 JR Z,$6179    ; }
 $615B LD HL,$605B   ; Use the pool for pool number #N$03.
 $615E CP $03        ; {Jump to #R$6179 if the pool number is #N$03.
 $6160 JR Z,$6179    ; }
 $6162 LD C,$07      ; Set the pool size mask to #N$07 (eight records).
 $6164 LD HL,$60E3   ; Use the pool for pool number #N$02.
 $6167 CP $02        ; {Jump to #R$6179 if the pool number is #N$02.
 $6169 JR Z,$6179    ; }
 $616B LD C,$03      ; Set the pool size mask to #N$03 (four records).
 $616D LD HL,$6103   ; Use the pool for pool number #N$04.
 $6170 CP $04        ; {Jump to #R$6179 if the pool number is #N$04.
 $6172 JR Z,$6179    ; }
 $6174 LD HL,$60DB   ; Use the pool for pool number #N$05.
 $6177 LD C,$01      ; Set the pool size mask to #N$01 (two records).
; Pick an unused record from the pool at random.
@label=ChooseItemSites_PickRecord
*$6179 PUSH HL       ; Stash the address of the pool on the stack.
 $617A LD A,($9BCB)  ; Fetch a random number.
 $617D AND C         ; Keep only the bits allowed by the pool size.
 $617E ADD A,A       ; {Multiply it by four to get an offset into the pool.
 $617F ADD A,A       ; }
 $6180 CALL $9BCF    ; Add the offset to #REGhl.
 $6183 BIT 7,(HL)    ; {Jump to #R$618D if it has not been used.
 $6185 JR Z,$618D    ; }
 $6187 CALL $F23B    ; Call #R$F23B to get a new random number.
 $618A POP HL        ; Restore the address of the pool.
 $618B JR $6179      ; Jump back to #R$6179 to try again.
; Copy the unused record into the site table and mark it used.
@label=ChooseItemSites_CopyRecord
*$618D LD BC,$0004   ; Set the length of a site record in #REGbc.
 $6190 LDIR          ; Copy the record into the site table.
 $6192 DEC HL        ; {Step back to the start of the pool record.
 $6193 DEC HL        ;
 $6194 DEC HL        ;
 $6195 DEC HL        ; }
 $6196 SET 7,(HL)    ; Set the used flag of the pool record.
 $6198 POP HL        ; Restore the address of the pool.
 $6199 JR $619F      ; Jump to #R$619F.
@label=ChooseItemSites_Skip
*$619B INC DE        ; {Skip the first two bytes of this site, leaving it
 $619C INC DE        ; unset.}
@label=ChooseItemSites_SkipRest
*$619D INC DE        ; {Skip the last two bytes of the site.
 $619E INC DE        ; }
; Move on to the next pool number, unless this was the last one.
@label=ChooseItemSites_Next
*$619F LD A,(IY+$00) ; Fetch the pool number just dealt with.
 $61A2 CP $04        ; {Return if it was #N($04), as the last pool number in the list is
 $61A4 RET Z         ; always #N$04.}
 $61A5 INC IY        ; Use the next pool number.
 $61A7 JR $612E      ; Jump back to #R$612E.

; Item Site Pool Numbers
;
; The pool number for each item site that #R$6113 fills in, in order,
; followed by #N$04 to mark the end of the list.
@label=ItemSitePoolNumbers
b$61A9 DEFB $01
 $61AA DEFB $00
 $61AB DEFB $00
 $61AC DEFB $05
 $61AD DEFB $05
 $61AE DEFB $02
 $61AF DEFB $01
 $61B0 DEFB $02
 $61B1 DEFB $01
 $61B2 DEFB $01
 $61B3 DEFB $00
 $61B4 DEFB $03
 $61B5 DEFB $03
 $61B6 DEFB $03
 $61B7 DEFB $03
 $61B8 DEFB $03
 $61B9 DEFB $03
 $61BA DEFB $03
@label=ItemSitePoolNumbers_End
 $61BB DEFB $04      ; Terminator.

; Tile Map
;
; The map of the world: #N$1C rows of #N$60 columns, one byte for each
; tile, row by row from the top. The byte is the number of the tile, which
; #R$6C3C turns into a script that draws it. Tile #N$00 is blank. The top rows
; are mostly empty sky and the rest is ground.
