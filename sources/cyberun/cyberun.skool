; Clear Object Speeds
;
; Used by the routine at #R$995B.
; .
; Clears the speeds of an object.
;
; IX Address of the object
@label=ClearObjectSpeeds
c$994B CALL $B8FC    ; Call #R$B8FC.
 $994E LD (IX+$07),A ; {Clear the speeds of the object.
 $9951 LD (IX+$08),A ;
 $9954 LD (IX+$09),A ;
 $9957 LD (IX+$0A),A ; }
 $995A RET           ; Return.

; Run Type 19 Behaviour
;
; Behaviour code for objects of type #N($19) (see #R$97DF). Gives the
; object a random lifetime and, with a small chance, chases the player.
;
; IX Address of the object
@label=RunType19Behaviour
c$995B LD A,($9BCB)   ; Fetch the second byte of the random seed.
 $995E AND %00111111  ; Keep six bits.
 $9960 ADD A,$10      ; Add #N$10.
 $9962 LD (IX+$15),A  ; Set the lifetime of the object.
 $9965 LD A,R         ; Fetch a pseudo-random value from the refresh register.
 $9967 AND %00000011  ; Keep two bits.
 $9969 JP Z,$994B     ; Jump to #R$994B if they are zero.
 $996C CALL $97FF     ; Chase the player.
 $996F RES 7,(IX+$16) ; Clear bit 7 of the third state byte of the object.
 $9973 RET            ; Return.

; Enemy Slots
;
; Nine slots of #N$18 bytes, one for each enemy or similar object.
; Each slot is laid out as follows:
; #TABLE(default,centre,centre)
; { =h Offset | =h Contents }
; { #N$00 | Type of the object (#N($FF) if the slot is free) }
; { #N$01 | Map column }
; { #N$02 | Horizontal position }
; { #N$04 | Map zone }
; { #N$05 | Vertical position }
; { #N$07-#N$08 | Horizontal speed }
; { #N$09-#N$0A | Vertical speed }
; { #N$0B-#N$0C | Horizontal acceleration }
; { #N$0D | Attribute }
; { #N$0E-#N$0F | Vertical acceleration }
; { #N$10 | Flags }
; { #N$11-#N$12 | Horizontal and vertical screen position }
; { #N$13-#N$14 | State }
; { #N$15 | Lifetime }
; { #N$16-#N$17 | More flags }
; TABLE#
@label=EnemySlots
g$9974 DEFB $FF,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $998C DEFB $FF,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $99A4 DEFB $FF,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $99BC DEFB $FF,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
@label=EnemySlots_Fifth
 $99D4 DEFB $FF,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $99EC DEFB $FF,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $9A04 DEFB $FF,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
@label=EnemySlots_Eighth
 $9A1C DEFB $FF,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $9A34 DEFB $FF,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00

; Crystal Stack Slot
;
; A tenth slot in the same format as the enemy slots, used by
; #R$9572.
@label=CrystalStackSlot
g$9A4C DEFB $1E,$52,$00,$00,$0A,$00,$00,$00,$00,$00,$00,$00,$00,$FF,$00,$00
@label=CrystalStackSlot_Flags
 $9A5C DEFB $00,$00,$00,$00,$00,$00,$00,$00

; Frame Counter
;
; A two byte counter that is incremented every frame, for example by
; #R$8615 and #R$C374.
@label=FrameCounter
g$9A64 DEFW $0000

; Initialise Game
;
; Used by the routine at #R$5C80.
; .
; The game starts here, after #R$5C80. It sets up the stack, makes the
; border black, builds the shift tables and then carries on at #R$F422.
@label=InitialiseGame
c$9A66 LD SP,$5B80   ; Set the stack pointer to #N$5B80.
 $9A69 XOR A         ; {Set the border to black.
 $9A6A OUT ($FE),A   ; }
 $9A6C CALL $F86B    ; Build the shift tables.
 $9A6F JP $F422      ; Jump to #R$F422.

; Fill Attributes White
;
; Used by the routines at #R$F26C and #R$F422.
; .
; Sets every attribute on the screen to bright white ink on black.
@label=FillAttributesWhite
c$9A72 LD HL,$5800   ; Use the first attribute.
@label=FillAttributesWhite_Loop
*$9A75 LD (HL),$47   ; Write the attribute.
 $9A77 INC HL        ; Move on to the next one.
 $9A78 LD A,H        ; Fetch the high byte of the address.
 $9A79 CP $5B        ; {Jump back to #R$9A75 if all of the attributes have not
 $9A7B JR NZ,$9A75   ; been written.}
 $9A7D RET           ; Return.

; Clear Pixels
;
; Used by the routines at #R$F26C and #R$F422.
; .
; Clears all of the pixels on the screen.
@label=ClearPixels
c$9A7E LD HL,$4000   ; Use the start of the display file.
@label=ClearPixels_Loop
*$9A81 LD (HL),$00   ; Clear a byte.
 $9A83 INC HL        ; Move on to the next one.
 $9A84 LD A,H        ; Fetch the high byte of the address.
 $9A85 CP $58        ; {Jump back to #R$9A81 if the whole display file has not
 $9A87 JR NZ,$9A81   ; been cleared.}
 $9A89 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CE60 }
; { #ATICATAC$80B4 }
; { #COOKIE$74D4 }
; { #GUNFRIGHT$D6DB }
; { #JETPAC$71B8 }
; { #KNIGHTLORE$D544 }
; { #LUNARJETMAN$84AD }
; { #NIGHTSHADE$E5A8 }
; { #PSSST$7439 }
; { #SABREWULF$BB81 }
; { #TRANZAM$7211 }
; LIST#

; Mask Map Table
;
; Used by the routines at #R$83D6 and #R$F3BD.
; .
; Applies a mask to every byte of the table at #R$5C94.
;
; E Mask
@label=MaskMapTable
c$9A8A LD BC,$0122   ; Set the number of bytes in #REGbc.
 $9A8D LD HL,$5C94   ; Use the table.
@label=MaskMapTable_Loop
*$9A90 LD A,(HL)     ; Fetch a byte of the table.
 $9A91 AND E         ; Apply the mask.
 $9A92 LD (HL),A     ; Store the byte.
 $9A93 INC HL        ; Move on to the next one.
 $9A94 DEC BC        ; Decrease the counter.
 $9A95 LD A,B        ; {Combine #REGb and #REGc.
 $9A96 OR C          ; }
 $9A97 JR NZ,$9A90   ; Jump back to #R$9A90 until the counter is zero.
 $9A99 RET           ; Return.

; Play Music Until Key Pressed
;
; Used by the routine at #R$F26C.
; .
; Plays a tune made of notes, which ends with #N($FF). The tune stops
; as soon as a key is pressed.
;
; DE Address of the first note
@label=PlayMusic_WaitKey
c$9A9A XOR A         ; Select every keyboard row.
 $9A9B CALL $9BC3    ; Read the keyboard.
 $9A9E RET NZ        ; Return if a key is pressed.
 $9A9F LD A,(DE)     ; Fetch a note.
 $9AA0 CP $FF        ; {Jump to #R$9AB3 if it is the end of the tune.
 $9AA2 JR Z,$9AB3    ; }
 $9AA4 CALL $9AB4    ; Play the note.
 $9AA7 JR $9A9A      ; Jump back to #R$9A9A for the next note.
; View the equivalent code in;
; #LIST
; { #BUBBLER$A1B2 }
; LIST#

; Play Music
;
; Used by the routines at #R$F26C, #R$F48B, #R$F4FC and #R$F52A.
; .
; Plays a tune made of notes, which ends with #N($FF). The keyboard is
; not checked.
; .
; The tunes played by this routine are:
; #TABLE(default,centre,centre)
; { =h Tune | =h Sound }
; { Title Tune |
; #HTML(#AUDIO0(title-tune.wav)(#INCLUDE(TitleTune))) }
; { Game Start Tune |
; #HTML(#AUDIO0(game-start-tune.wav)(#INCLUDE(GameStartTune))) }
; { Ship Destroyed Tune |
; #HTML(#AUDIO0(ship-destroyed-tune.wav)(#INCLUDE(ShipDestroyedTune))) }
; { Planet Complete Tune |
; #HTML(#AUDIO0(planet-complete-tune.wav)(#INCLUDE(PlanetCompleteTune))) }
; { Game Over Tune |
; #HTML(#AUDIO0(game-over-tune.wav)(#INCLUDE(GameOverTune))) }
; TABLE#
;
; DE Address of the first note
@label=PlayMusic
c$9AA9 LD A,(DE)     ; Fetch a note.
 $9AAA CP $FF        ; {Jump to #R$9AB3 if it is the end of the tune.
 $9AAC JR Z,$9AB3    ; }
 $9AAE CALL $9AB4    ; Play the note.
 $9AB1 JR $9AA9      ; Jump back to #R$9AA9 for the next note.
; This entry point is used by the routine at #R$9A9A.
@label=PlayMusic_Return
*$9AB3 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B4BA }
; { #BUBBLER$A1C1 }
; { #GUNFRIGHT$AF8F }
; { #KNIGHTLORE$B2CF }
; { #MARTIANOIDS$C0CF }
; { #NIGHTSHADE$C656 }
; { #PENTAGRAM$D6B5 }
; LIST#

; Play Note
;
; Used by the routines at #R$9A9A and #R$9AA9.
; .
; Plays a note of a tune, or a rest if the note number is zero.
; Bits 0 to 5 select the entry in #R$9B0C that holds the two delays of a cycle
; and the number of cycles. Bits 6 and 7 are the length less one, which
; multiplies the number of cycles, so the note is one to four times as long.
;
;   A The note
;   DE Address of the note
; O:DE Address of the next note
;
; Look up the delays and the number of cycles.
@label=PlayNote
c$9AB4 AND %00111111 ; Keep the note number.
 $9AB6 JR Z,$9AF6    ; Jump to #R$9AF6 if the note is a rest.
 $9AB8 LD L,A        ; {Set #REGhl to the note number.
 $9AB9 LD H,$00      ; }
 $9ABB ADD HL,HL     ; Double the number.
; Add the address of the table of notes at #R$9B0C.
 $9ABC CALL $9BCF    ; Call #R$9BCF.
 $9ABF LD BC,$9B0C   ; Point #REGbc at #R$9B0C.
 $9AC2 ADD HL,BC     ; Find the entry for the note.
 $9AC3 LD B,(HL)     ; Fetch the first delay.
 $9AC4 INC HL        ; Move on.
 $9AC5 LD C,(HL)     ; Fetch the second delay.
 $9AC6 INC HL        ; Move on.
 $9AC7 LD L,(HL)     ; Fetch the number of cycles.
 $9AC8 LD H,$00      ; Set #REGh to #N$00.
; Bits 6 and 7 are the length, less one.
 $9ACA LD A,(DE)     ; Fetch the note again.
 $9ACB RLCA          ; {Move bits 6 and 7 to bits 0 and 1.
 $9ACC RLCA          ; }
 $9ACD AND %00000011 ; Keep bits 0 and 1.
 $9ACF INC A         ; Add one.
 $9AD0 PUSH DE       ; Save the address of the note.
 $9AD1 LD E,L        ; {Copy the number of cycles to #REGde.
 $9AD2 LD D,H        ; }
; Multiply the number of cycles by the length.
@label=PlayNote_Multiply
*$9AD3 DEC A         ; Count down the length.
 $9AD4 JR Z,$9AD9    ; Jump to #R$9AD9 if it is zero.
 $9AD6 ADD HL,DE     ; Add the number of cycles again.
 $9AD7 JR $9AD3      ; Jump back to #R$9AD3.
@label=PlayNote_Play
*$9AD9 POP DE        ; Restore the note address from the stack.
; Each pass makes one cycle of the note.
@label=PlayNote_Cycle
*$9ADA PUSH BC       ; Stash the delays on the stack.
 $9ADB XOR A         ; Set #REGa to #N$00.
 $9ADC OUT ($FE),A   ; Send it to the speaker.
@label=PlayNote_Low
*$9ADE DJNZ $9ADE    ; Wait for the first half of the cycle.
 $9AE0 DEC C         ; Count down the second delay.
 $9AE1 JR NZ,$9ADE   ; Jump back to #R$9ADE until none remain.
 $9AE3 POP BC        ; Restore the delays from the stack.
 $9AE4 PUSH BC       ; Stash the delays on the stack.
 $9AE5 LD A,$10      ; Set bit 4.
 $9AE7 OUT ($FE),A   ; Send it to the speaker.
@label=PlayNote_High
*$9AE9 DJNZ $9AE9    ; Wait for the second half of the cycle.
 $9AEB DEC C         ; Count down the second delay.
 $9AEC JR NZ,$9AE9   ; Jump back to #R$9AE9 until none remain.
 $9AEE POP BC        ; Restore the delays from the stack.
 $9AEF DEC HL        ; Decrease the number of cycles.
 $9AF0 LD A,H        ; {Combine the high and low bytes.
 $9AF1 OR L          ; }
 $9AF2 JR NZ,$9ADA   ; Jump back to #R$9ADA until the note is over.
 $9AF4 INC DE        ; Move on to the next note.
 $9AF5 RET           ; Return.
; A rest is a silence of the same length as the other notes.
@label=PlayNote_Rest
*$9AF6 LD A,(DE)     ; Fetch the note byte.
 $9AF7 INC DE        ; Move on to the next note.
 $9AF8 RLCA          ; {Move the top two bits to the bottom.
 $9AF9 RLCA          ; }
 $9AFA AND %00000011 ; Keep them.
 $9AFC INC A         ; Add one to get a multiplier.
 $9AFD LD L,A        ; Use it as a counter.
@label=PlayNote_RestLoop
 $9AFE LD BC,$430B   ; Set the delay.
@label=PlayNote_Loop
*$9B01 PUSH BC       ; Save the delay.
@label=PlayNote_Delay
*$9B02 DEC BC        ; Count down.
 $9B03 LD A,B        ; {Combine the high and low bytes.
 $9B04 OR C          ; }
 $9B05 JR NZ,$9B02   ; Jump back to #R$9B02 until the delay is over.
 $9B07 POP BC        ; Restore the delay.
 $9B08 DEC L         ; Decrease the multiplier by one.
 $9B09 JR NZ,$9B01   ; Jump back to #R$9B01 until none remain.
 $9B0B RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B4C5 }
; { #BUBBLER$A1CC }
; { #GUNFRIGHT$AF9A }
; { #KNIGHTLORE$B2DA }
; { #MARTIANOIDS$C0DA }
; { #NIGHTSHADE$C661 }
; { #PENTAGRAM$D6C0 }
; LIST#

