; Run Title Menu
;
; Used by the routine at #R$F26C.
; .
; Runs the title screen: it keeps the random number generator ticking
; over, slides the control icons for each player to the position of the control
; method selected, redraws the option markers and waits for the "0" key to be
; pressed to start the game.
@label=RunTitleMenu
c$8615 CALL $F23B    ; Fetch a random number to keep the seed moving.
 $8618 LD HL,($9A64) ; {Add one to the frame counter in #R$9A64.
 $861B INC HL        ;
 $861C LD ($9A64),HL ; }
 $861F LD IX,$8708   ; Use the control icon data for player one...
 $8623 LD DE,$870E   ; ...with the sprite of the icon in #REGde...
 $8626 CALL $8690    ; ...and update the icon.
 $8629 LD IX,$870B   ; Use the control icon data for player two...
 $862D LD DE,$874F   ; ...with the sprite of the icon in #REGde...
 $8630 CALL $8690    ; ...and update the icon.
 $8633 LD HL,$2F70   ; {Draw the first option marker.
 $8636 CALL $8666    ; }
 $8639 LD HL,$3F70   ; {Draw the second option marker.
 $863C CALL $8666    ; }
 $863F LD D,$18      ; {Delay for a short while.
 $8641 CALL $A802    ; }
 $8644 LD A,$EF      ; {Read the keyboard row "0" to "6".
 $8646 OUT ($FD),A   ;
 $8648 IN A,($FE)    ; }
 $864A AND %00000001 ; Test the "0" key.
 $864C RET Z         ; Return if it is pressed, to start the game.
 $864D CALL $86B9    ; Check the other keys.
 $8650 JR $8615      ; Go round again.

; Draw Menu Options
;
; Used by the routine at #R$F26C.
; .
; Redraws both option markers, highlighting the selected one.
; .
; #PUSHS #UDGTABLE { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$F26C,stop=$F2D0,clear=1,sp=$FE00)
; #SCR$02(title-menu) } UDGTABLE# #POPS
@label=DrawMenuOptions
c$8652 LD A,($9A64)  ; {Set bit 2 of the frame counter in #R$9A64, so that the selected
 $8655 OR $04        ; option is highlighted.
 $8657 LD ($9A64),A  ; }
 $865A LD HL,$2F70   ; {Draw the first option marker.
 $865D CALL $8666    ; }
 $8660 LD HL,$3F70   ; {Jump to #R$8666.
 $8663 JP $8666      ; }

; Draw Menu Option
;
; Used by the routines at #R$8615 and #R$8652.
; .
; Draws one option marker, in bright white if it is the selected option
; or in bright magenta otherwise.
;
; HL Pixel position of the option marker
@label=DrawMenuOption
c$8666 LD B,$43         ; Use bright magenta as the default attribute.
 $8668 LD A,($9A64)     ; Fetch the frame counter from #R$9A64.
 $866B AND %00000100    ; Test bit 2.
 $866D JR Z,$8683       ; Jump to #R$8683 if it is clear.
 $866F LD A,H           ; {Turn the Y position into the option number in #REGc.
 $8670 SUB $2F          ;
 $8672 LD C,A           ;
 $8673 SRL C            ;
 $8675 SRL C            ;
 $8677 SRL C            ;
 $8679 SRL C            ; }
 $867B LD A,($F2E2)     ; Fetch the selected option from #R$F2E2.
 $867E CP C             ; Is this the selected option?
 $867F JR NZ,$8683      ; Jump to #R$8683 if not.
 $8681 LD B,$47         ; Use bright white for the selected option instead.
@label=DrawMenuOption_Fill
*$8683 LD A,B           ; {Store the attribute in the data at #R$868D.
 $8684 LD ($868F),A     ; }
 $8687 LD DE,$868D      ; Use the attribute data.
 $868A JP $C991         ; Jump to #R$C991.
@label=DrawMenuOption_Attributes
 $868D DEFB $09,$01,$00 ;

; Update Control Icon
;
; Used by the routines at #R$8615 and #R$F26C.
; .
; Slides the icon for a player's control method towards the row of the
; selected method and draws it.
;
; IX Address of the control icon data (see #R$8708)
; DE Address of the sprite of the icon
@label=UpdateControlIcon
c$8690 LD A,(IX+$02) ; Fetch the selected control method.
 $8693 LD HL,$8704   ; Use the table of icon positions at #R$8704.
 $8696 CALL $9BCF    ; Add the control method to the address.
 $8699 LD A,(HL)     ; Fetch the target position of the icon.
 $869A SUB (IX+$01)  ; Subtract the current position of the icon.
 $869D JR Z,$86B0    ; Jump to #R$86B0 if the icon is already in place.
 $869F BIT 7,A       ; {Jump to #R$86A8 if the icon is above the target.
 $86A1 JR NZ,$86A8   ; }
 $86A3 INC (IX+$01)  ; Move the icon one pixel closer.
 $86A6 JR $86B0      ; Jump to #R$86B0.
@label=UpdateControlIcon_Up
*$86A8 LD A,(IX+$01) ; Fetch the current position of the icon.
 $86AB SUB $04       ; Move the icon four pixels closer.
 $86AD LD (IX+$01),A ; Store the new position.
@label=UpdateControlIcon_Draw
*$86B0 LD L,(IX+$00) ; {Fetch the pixel position of the icon into #REGhl.
 $86B3 LD H,(IX+$01) ; }
 $86B6 JP $C96F      ; Draw the icon.

; Read Menu Keys
;
; Used by the routine at #R$8615.
; .
; Reads the keys that choose the number of players ("A" and "B") and
; the control methods of each player ("1" and "2").
@label=ReadMenuKeys
c$86B9 LD A,$FD      ; {Read the keyboard row "A" to "G".
 $86BB OUT ($FD),A   ; }
 $86BD IN A,($FE)    ; {Test the "A" key.
 $86BF AND $01       ; }
 $86C1 JR NZ,$86C6   ; Jump to #R$86C6 if it is not pressed.
 $86C3 LD ($F2E2),A  ; Select option zero in #R$F2E2.
@label=ReadMenuKeys_B
*$86C6 LD A,$7F      ; {Read the keyboard row "B" to "SPACE".
 $86C8 OUT ($FD),A   ; }
 $86CA IN A,($FE)    ; {Test the "B" key.
 $86CC BIT 4,A       ; }
 $86CE JR NZ,$86D5   ; Jump to #R$86D5 if it is not pressed.
 $86D0 LD A,$01      ; {Select option one in #R$F2E2.
 $86D2 LD ($F2E2),A  ; }
@label=ReadMenuKeys_Icons
*$86D5 LD IX,$8708   ; Use the control icon data for player one.
 $86D9 LD B,$01      ; Use the "1" key.
 $86DB CALL $86E4    ; Check for a change of control method.
 $86DE LD IX,$870B   ; Use the control icon data for player two.
 $86E2 LD B,$02      ; Use the "2" key.
; Continue on to #R$86E4.

; Change Control Method
;
; Used by the routine at #R$86B9.
; .
; Moves on to the next control method for a player if the key for that
; player is pressed and the icon has finished sliding into place.
;
; B Key mask for the row "1" to "5"
; IX Address of the control icon data
@label=ChangeControlMethod
c$86E4 LD A,(IX+$02) ; Fetch the selected control method.
 $86E7 LD HL,$8704   ; Use the table of icon positions at #R$8704.
 $86EA CALL $9BCF    ; Add the control method to the address.
 $86ED LD A,(HL)     ; Fetch the target position of the icon.
 $86EE SUB (IX+$01)  ; Subtract the current position of the icon.
 $86F1 RET NZ        ; Return if the icon is still moving.
 $86F2 LD A,$F7      ; {Read the keyboard row "1" to "5".
 $86F4 OUT ($FD),A   ; }
 $86F6 IN A,($FE)    ; Read the keyboard.
 $86F8 AND B         ; Test the key.
 $86F9 RET NZ        ; Return if it is not pressed.
 $86FA LD A,(IX+$02) ; Fetch the selected control method.
 $86FD INC A         ; Move on to the next one...
 $86FE AND %00000011 ; ...wrapping round after the fourth.
 $8700 LD (IX+$02),A ; Store the new control method.
 $8703 RET           ; Return.

; Control Icon Positions
;
; The vertical position of the icon for each of the four control
; methods.
@label=ControlIconPositions
b$8704 DEFB $6F,$83,$9B,$AF

; Control Icon Data
;
; Two sets of three bytes: the X position, the current Y position and
; the control method selected for each player.
@label=ControlIconPlayerOne
b$8708 DEFB $38,$6F,$00
@label=ControlIconPlayerTwo
 $870B DEFB $B8,$6F,$00

; Control Icon Sprites
;
; Two sprites of three bytes by twenty-one rows.
@label=ControlIconSprite_1
b$870E DEFB $03,$15
 $8710 DEFB $00,$00,$00
 $8713 DEFB $00,$00,$00
 $8716 DEFB $00,$00,$00
 $8719 DEFB $00,$00,$00
 $871C DEFB $00,$01,$80
 $871F DEFB $00,$01,$C0
 $8722 DEFB $00,$01,$E0
 $8725 DEFB $7F,$FF,$F0
 $8728 DEFB $7F,$FF,$F8
 $872B DEFB $67,$87,$FC
 $872E DEFB $67,$CF,$FE
 $8731 DEFB $61,$CF,$FF
 $8734 DEFB $64,$CF,$FF
 $8737 DEFB $64,$8F,$FE
 $873A DEFB $61,$CF,$FC
 $873D DEFB $7F,$FF,$F8
 $8740 DEFB $7F,$FF,$F0
 $8743 DEFB $00,$01,$E0
 $8746 DEFB $00,$01,$C0
 $8749 DEFB $00,$01,$80
 $874C DEFB $00,$00,$00
@label=ControlIconSprite_2
 $874F DEFB $03,$15
 $8751 DEFB $00,$00,$00
 $8754 DEFB $00,$00,$00
 $8757 DEFB $00,$00,$00
 $875A DEFB $00,$00,$00
 $875D DEFB $01,$80,$00
 $8760 DEFB $03,$80,$00
 $8763 DEFB $07,$80,$00
 $8766 DEFB $0F,$FF,$FE
 $8769 DEFB $1F,$FF,$FE
 $876C DEFB $3F,$CF,$06
 $876F DEFB $7F,$CF,$3E
 $8772 DEFB $FF,$C3,$8E
 $8775 DEFB $FF,$C9,$E6
 $8778 DEFB $7F,$C9,$26
 $877B DEFB $3F,$C3,$8E
 $877E DEFB $1F,$FF,$FE
 $8781 DEFB $0F,$FF,$FE
 $8784 DEFB $07,$80,$00
 $8787 DEFB $03,$80,$00
 $878A DEFB $01,$80,$00
 $878D DEFB $00,$00,$00
 $8790 DEFB $10,$04

; Spawn Special Enemy
;
; Used by the routines at #R$87AF and #R$8D42.
; .
; Starts one of the special enemies, but only in the middle zones of the
; planet (zones #N$03 to #N$09).
@label=SpawnSpecialEnemy
c$8792 LD A,($CE58)  ; Fetch the map zone from #R$CE58.
 $8795 CP $0A        ; {Return if it is #N$0A or higher...
 $8797 RET NC        ; }
 $8798 CP $03        ; {...or lower than #N$03.
 $879A RET C         ; }
 $879B LD A,$02      ; {Look for a free slot among two slots.
 $879D LD IX,$9A1C   ; }
 $87A1 CALL $87F6    ; Search for a free enemy slot.
 $87A4 RET NZ        ; Return if there is not one.
 $87A5 LD A,$01      ; {Select the second type of enemy.
 $87A7 LD ($89D2),A  ; }
 $87AA LD B,$03      ; {With #N$03 in #REGb, jump to #R$8A28 to start the
 $87AC JP $8A28      ; enemy.}

; Update Enemy Spawning
;
; Used by the routine at #R$F46C.
; .
; Called once a frame to decide whether to start another enemy. A new
; enemy is started every eight calls, with a special enemy started part of the
; way through the countdown, as long as fewer than eight enemies are alive.
@label=UpdateEnemySpawning
c$87AF LD A,($8E2B)  ; Fetch the number of enemies that are alive from #R$8E2B.
 $87B2 CP $08        ; {Return if there are eight of them.
 $87B4 RET NC        ; }
 $87B5 LD A,($87F5)  ; Fetch the bonus timer from #R$87F5.
 $87B8 AND A         ; Test it.
 $87B9 JR NZ,$87D0   ; Jump to #R$87D0 if the timer is running.
 $87BB LD A,($9BCB)  ; Fetch the random seed.
 $87BE CP $6A        ; {Jump to #R$87D4 if it is not the same.
 $87C0 JR NZ,$87D4   ; }
 $87C2 LD A,($9BCC)  ; Fetch the second byte of the seed.
 $87C5 AND %00000011 ; Test the bottom two bits.
 $87C7 JR NZ,$87D4   ; Jump to #R$87D4 if they are not zero.
 $87C9 OR %10000000  ; Set bit 7 of #REGa, which is zero.
 $87CB LD ($87F5),A  ; Start the bonus timer.
 $87CE JR $87D4      ; Jump to #R$87D4.
@label=UpdateEnemySpawning_Timer
*$87D0 DEC A         ; {Count the bonus timer down.
 $87D1 LD ($87F5),A  ; }
@label=UpdateEnemySpawning_Countdown
*$87D4 LD A,($8790)  ; {Count down the spawn timer in #R$8790.
 $87D7 DEC A         ;
 $87D8 LD ($8790),A  ; }
 $87DB CP $07        ; {Jump to #R$8792 if it is #N$07.
 $87DD JP Z,$8792    ; }
 $87E0 AND A         ; {Return if the countdown has not reached zero.
 $87E1 RET NZ        ; }
 $87E2 LD A,$08      ; {Restart the countdown at eight.
 $87E4 LD ($8790),A  ; }
; This entry point is used by the routine at #R$8D42.
@label=UpdateEnemySpawning_Spawn
*$87E7 LD A,($8791)  ; Fetch the number of slots to search from #N$8791.
 $87EA LD IX,$9974   ; Use the first enemy slot.
 $87EE CALL $87F6    ; Search for a free enemy slot.
 $87F1 JP Z,$89D3    ; Spawn an enemy if there is a free slot.
 $87F4 RET           ; Return.
 $87F5 DEFB $00      ;

; Find Free Slot
;
; Used by the routines at #R$8792, #R$87AF and #R$882B.
; .
; Searches for a free enemy slot (one with type #N$FF) by stepping #REGix
; through the slots, which are #N$18 bytes long. No slot is returned if too
; many enemies are alive or if the player's ship is exploding.
;
;   A Number of slots to search
;   IX Address of the first slot to try
; O:IX Address of the free slot
; O:F The zero flag is set if a free slot was found
@label=FindFreeSlot
c$87F6 LD B,A        ; Store the number of slots in #REGb.
 $87F7 LD A,($8E2B)  ; Fetch the number of enemies that are alive from #R$8E2B.
 $87FA CP $07        ; {Jump to #R$8810 if it is #N$07 or more.
 $87FC JR NC,$8810   ; }
 $87FE LD A,($8F53)  ; Fetch the death counter from #R$8F53.
 $8801 AND A         ; Test it.
 $8802 JR NZ,$8810   ; Jump to #R$8810 if the ship is exploding.
 $8804 LD DE,$0018   ; Set the size of a slot in #REGde.
@label=FindFreeSlot_Loop
*$8807 LD A,(IX+$00) ; Fetch the type of the object in the slot.
 $880A INC A         ; Increment it.
 $880B RET Z         ; Return with the zero flag set if the type was #N$FF.
 $880C ADD IX,DE     ; Move on to the next slot.
 $880E DJNZ $8807    ; Decrease the slot counter by one and loop back to #R$8807 until none
                     ; remain.
@label=FindFreeSlot_None
*$8810 OR %00000001  ; Clear the zero flag.
 $8812 RET           ; Return.

; Fire Random Shot
;
; Used by the routines at #R$93F2 and #R$94A8.
; .
; Occasionally fires a shot from an object, when the flag at #R$A1D7 is
; set.
;
; IX Address of the object
@label=FireRandomShot
c$8813 LD A,($A1D7)  ; Fetch the flag from #R$A1D7.
 $8816 AND A         ; Test it.
 $8817 RET Z         ; Return if it is clear.
 $8818 LD A,($9BCB)  ; Fetch the first byte of the random seed.
 $881B AND %00101111 ; Keep only some of the bits.
 $881D RET NZ        ; Return if any are set, so a shot is only fired now and
                     ; then.
 $881E JR $882B      ; Jump to #R$882B.

; Fire Shot When Hit
;
; Used by the routine at #R$AC60.
; .
; Occasionally fires a shot from an object that has been hit.
;
; IX Address of the object
@label=FireShotWhenHit
c$8820 LD A,($9BCB)   ; Fetch the first byte of the random seed.
 $8823 AND %01011010  ; Keep only some of the bits.
 $8825 RET NZ         ; Return if any are set.
 $8826 BIT 7,(IX+$10) ; Test bit 7 of the flags of the object.
 $882A RET Z          ; Return if it is clear.
; Continue on to #R$882B.

; Fire Shot
;
; Used by the routine at #R$8813.
; .
; Starts a shot (type #N$1C) from an object, in one of the three shot
; slots. The kind of shot is chosen by the caller using the value in #R$5C1C.
;
;   IX Address of the object that fires
; O:IY Address of the shot slot
@label=FireShot
c$882B PUSH IX         ; Save the address of the object.
 $882D LD A,$03        ; Look for a free slot among three slots...
 $882F LD IX,$99D4     ; ...starting at the first shot slot.
 $8833 CALL $87F6      ; Search for a free slot.
 $8836 PUSH IX         ; {Copy the address of the slot into #REGiy...
 $8838 POP IY          ; }
 $883A POP IX          ; ...and restore the address of the object.
 $883C RET NZ          ; Return if there are no free slots.
 $883D LD A,(IX+$11)   ; Fetch the horizontal screen position of the object.
 $8840 CP $C0          ; {Return if it is off the right-hand side of the
 $8842 RET NC          ; screen...}
 $8843 CP $18          ; {...or off the left-hand side.
 $8845 RET C           ; }
 $8846 LD A,($5C1C)    ; Fetch the kind of shot from #R$5C1C.
 $8849 LD HL,$89A6     ; Use the table of shot flags at #R$89A7, less one.
 $884C CALL $9BCF      ; Add the kind of shot to the address.
 $884F LD A,(HL)       ; Fetch the flags for this kind of shot.
 $8850 LD ($5C1D),A    ; Store them in #R$5C1D.
 $8853 LD A,(IX+$12)   ; Fetch the vertical screen position of the object.
 $8856 BIT 7,(HL)      ; {Jump to #R$885D if bit 7 of the flags is clear.
 $8858 JR Z,$885D      ; }
 $885A CP $58          ; {Return if the object is too low down the screen for
 $885C RET NC          ; this shot.}
@label=FireShot_CheckHigh
*$885D BIT 6,(HL)      ; {Jump to #R$8864 if bit 6 of the flags is clear.
 $885F JR Z,$8864      ; }
 $8861 CP $50          ; {Return if the object is too high up the screen for
 $8863 RET C           ; this shot.}
@label=FireShot_Start
*$8864 CALL $8986      ; Swap #REGix and #REGiy, then copy the position of the
                       ; object.
 $8867 CALL $AC34      ; Clear the slot of the shot.
 $886A LD (IX+$00),$1C ; Make the object a shot.
 $886E LD (IX+$10),$20 ; Set the flags of the shot.
 $8872 LD HL,$89AB     ; Use the table of shot speeds at #R$89AB.
 $8875 LD A,($5C1C)    ; Fetch the kind of shot.
 $8878 ADD A,A         ; {Multiply it by four.
 $8879 ADD A,A         ; }
 $887A CALL $9BCF      ; Add it to the address.
 $887D LD A,(HL)       ; {Set the horizontal speed of the shot from the table.
 $887E LD (IX+$07),A   ;
 $8881 INC HL          ;
 $8882 LD A,(HL)       ; }
 $8883 LD (IX+$09),A   ; {Set the vertical speed of the shot from the table.
 $8886 INC HL          ;
 $8887 LD A,(HL)       ; }
 $8888 LD (IX+$13),A   ; {Set the first state byte of the shot from the table.
 $888B INC HL          ;
 $888C LD A,(HL)       ; }
 $888D LD (IX+$14),A   ; Set the second state byte of the shot from the table.
 $8890 LD A,($5C1D)    ; Fetch the flags for this kind of shot.
 $8893 AND %00001111   ; Keep the colour in the bottom four bits.
 $8895 LD B,A          ; {Copy it into the top four bits...
 $8896 ADD A,A         ;
 $8897 ADD A,A         ;
 $8898 ADD A,A         ;
 $8899 ADD A,A         ; }
 $889A OR B            ; {...and set the attribute of the shot.
 $889B LD (IX+$0D),A   ; }
 $889E LD (IX+$15),$38 ; Set the lifetime of the shot to #N$38.
 $88A2 CALL $BF66      ; Draw the shot.
 $88A5 PUSH IY         ; {Swap #REGix and #REGiy back again.
 $88A7 PUSH IX         ;
 $88A9 POP IY          ;
 $88AB POP IX          ; }
 $88AD LD A,(IY+$13)   ; Fetch the state of the object that fired the shot.
 $88B0 AND %00001111   ; Keep the bottom four bits.
 $88B2 JP Z,$8934      ; Jump to #R$8934 if it is zero.
 $88B5 CP $05          ; {Jump to #R$890D if it is #N$05.
 $88B7 JP Z,$890D      ; }
 $88BA CP $06          ; {Jump to #R$890D if it is #N$06.
 $88BC JP Z,$890D      ; }
 $88BF CP $07          ; {Jump to #R$8970 if it is #N$07.
 $88C1 JP Z,$8970      ; }
 $88C4 CP $0A          ; {Jump to #R$88F0 if it is #N$0A.
 $88C6 JP Z,$88F0      ; }
 $88C9 LD H,(IX+$07)   ; {Fetch the horizontal speed of the shot...
 $88CC LD L,(IX+$08)   ; }
 $88CF SRA H           ; {...halve it...
 $88D1 RR L            ; }
 $88D3 LD (IY+$07),H   ; {...and give it to the object that fired.
 $88D6 LD (IY+$08),L   ; }
 $88D9 LD A,($5C1D)    ; Fetch the flags for this kind of shot.
 $88DC LD (IY+$09),$05 ; Set the vertical speed of the object to push it up.
 $88E0 BIT 7,A         ; {Jump to #R$88E8 if bit 7 of the flags is set.
 $88E2 JR NZ,$88E8     ; }
 $88E4 LD (IY+$09),$FB ; Otherwise set the vertical speed to push it down
                       ; instead.
; This entry point is used by the routines at #R$890D, #R$8934 and #R$8970.
@label=FireShot_Sound
*$88E8 LD A,(IY+$00)   ; Fetch the type of the object.
 $88EB INC A           ; Increment it.
 $88EC CALL NZ,$7311   ; Play a sound if the object is active.
 $88EF RET             ; Return.
@label=FireShot_State0A
*$88F0 LD (IY+$07),$06 ; Set the horizontal speed of the object to six...
 $88F4 LD (IY+$08),$00 ; {...and clear its other speeds.
 $88F8 LD (IY+$09),$00 ;
 $88FC LD (IY+$0A),$00 ; }
 $8900 LD A,($5C1C)    ; Fetch the kind of shot.
 $8903 CP $07          ; {Jump to #R$88E8 if it is #N$07.
 $8905 JR Z,$88E8      ; }
 $8907 LD (IY+$07),$FA ; Otherwise reverse the horizontal speed.
 $890B JR $88E8        ; Jump to #R$88E8.

; Set Random Speed
;
; Used by the routines at #R$882B, #R$8934 and #R$8970.
; .
; Gives an object a random speed. The object is removed if it ends up
; with no speed at all.
;
; IY Address of the object
@label=SetRandomSpeed
c$890D LD A,($9BCC)    ; Fetch the second byte of the random seed.
 $8910 LD B,A          ; Copy it into #REGb.
 $8911 AND %00000110   ; Keep two bits.
 $8913 NEG             ; Negate them.
 $8915 LD C,A          ; Copy the result into #REGc.
 $8916 LD (IY+$09),A   ; Set the vertical speed of the object.
 $8919 LD A,B          ; Fetch the random value again.
 $891A RLCA            ; {Rotate bits 5 to 3 into the bottom three bits.
 $891B RLCA            ;
 $891C RLCA            ; }
 $891D AND %00000111   ; Keep them.
 $891F CP $07          ; {Jump to #R$892E if the value is #N$07.
 $8921 JP Z,$892E      ; }
 $8924 SUB $03         ; Subtract three...
 $8926 ADD A,A         ; {...and double it to get a horizontal speed.
 $8927 LD B,A          ; }
 $8928 LD (IY+$07),A   ; Set the horizontal speed of the object.
 $892B OR C            ; Combine the speeds.
 $892C JR NZ,$88E8     ; Jump to #R$88E8 if the object has any speed.
; This entry point is used by the routine at #R$8934.
@label=SetRandomSpeed_Remove
*$892E LD (IY+$00),$FF ; Free the slot of the object.
 $8932 JR $88E8        ; Jump to #R$88E8.

; Set Falling Speed
;
; Used by the routine at #R$882B.
; .
; Gives an object a random speed and then sets its vertical acceleration.
;
; IY Address of the object
@label=SetFallingSpeed
c$8934 CALL $890D      ; Give the object a random speed.
 $8937 LD A,(IY+$09)   ; Fetch the vertical speed.
 $893A AND A           ; Test it.
 $893B JR Z,$892E      ; Remove the object if it is zero.
 $893D LD A,R          ; Fetch a random number...
 $893F AND %00000111   ; ...and keep three bits.
 $8941 JR NZ,$8947     ; Jump to #R$8947 if any are set.
 $8943 LD (IY+$13),$09 ; Occasionally change the state of the object to #N$09.
@label=SetFallingSpeed_Flags
*$8947 LD (IY+$10),$25 ; Set the flags of the object to #N$25.
 $894B LD A,(IY+$00)   ; Fetch the type of the object.
 $894E INC A           ; Increment it.
 $894F JP Z,$88E8      ; Jump to #R$88E8 if the slot is free.
 $8952 LD A,($896E)    ; {Count down the timer at #R$896E.
 $8955 DEC A           ;
 $8956 LD ($896E),A    ; }
 $8959 JR NZ,$8967     ; Jump to #R$8967 if it has not run out.
 $895B LD A,($F5ED)    ; Fetch the number of ships left from #R$F5ED.
 $895E ADD A,A         ; {Multiply it by four...
 $895F ADD A,A         ; }
 $8960 LD ($896E),A    ; ...and restart the timer.
 $8963 LD (IY+$13),$08 ; Change the state of the object to #N$08.
@label=SetFallingSpeed_Accelerate
*$8967 LD (IY+$0F),$20 ; Set the vertical acceleration of the object to #N$20.
 $896B JP $88E8        ; Jump to #R$88E8.
 $896E DEFB $08        ;
 $896F DEFB $00        ;

; Reverse Vertical Speed
;
; Used by the routine at #R$882B.
; .
; Part of #R$882B. Sets a random speed and, unless the object is moving
; fast, reverses its vertical direction.
;
; IX Address of the shot
; IY Address of the object
@label=ReverseVerticalSpeed
c$8970 CALL $890D    ; Give the object a random speed.
 $8973 LD A,(IX+$12) ; Fetch the second state byte of the shot.
 $8976 CP $67        ; {Jump to #R$88E8 if it is #N$67 or higher.
 $8978 JP NC,$88E8   ; }
 $897B LD A,(IY+$09) ; Fetch the vertical speed of the object.
 $897E NEG           ; Negate it.
 $8980 LD (IY+$09),A ; Store it.
 $8983 JP $88E8      ; Jump to #R$88E8.

; Swap Objects
;
; Used by the routine at #R$882B.
; .
; Swaps the registers #REGix and #REGiy.
@label=SwapObjects
c$8986 PUSH IX       ; Stash #REGix on the stack.
 $8988 PUSH IY       ; Stash #REGiy on the stack.
 $898A POP IX        ; Retrieve #REGix from the stack as #REGix...
 $898C POP IY        ; ...and #REGiy.
; Continue on to #R$898E.

; Copy Position
;
; Used by the routines at #R$89D3 and #R$8D29.
; .
; Copies the position of one object to another.
;
; IX Address of the object to copy to
; IY Address of the object to copy from
@label=CopyPosition
c$898E LD A,(IY+$01) ; {Copy the map column.
 $8991 LD (IX+$01),A ; }
 $8994 LD A,(IY+$02) ; {Copy the horizontal position.
 $8997 LD (IX+$02),A ; }
 $899A LD A,(IY+$04) ; {Copy the map zone.
 $899D LD (IX+$04),A ; }
 $89A0 LD A,(IY+$05) ; {Copy the vertical position.
 $89A3 LD (IX+$05),A ; }
@label=CopyPosition_Return
 $89A6 RET           ; Return.

; Shot Tables
;
; Two overlapping tables used by #R$882B. The first holds a byte of flags
; for each kind of shot (the table starts at #R$89A6, so the first byte is for
; kind one). The second holds four bytes for each kind of shot, starting at
; #R$89AB: the horizontal speed, the vertical speed and the two state bytes of
; the shot.
; .
; Only kinds #N($03), #N($07) and #N($08) are known to be used.
@label=ShotTables
b$89A7 DEFB $4E,$4E,$8D,$4F
@label=ShotTables_Speeds
 $89AB DEFB $4F,$0D,$0F,$0F
 $89AF DEFB $0C,$F5,$50,$02
 $89B3 DEFB $08,$E2,$F3,$33
 $89B7 DEFB $10,$00,$F4,$44
 $89BB DEFB $07,$F8,$F5,$55
 $89BF DEFB $07,$F8,$F6,$66
 $89C3 DEFB $07,$FC,$F7,$77
 $89C7 DEFB $20,$FB,$FA,$AA
 $89CB DEFB $00,$FB,$FA,$AA
 $89CF DEFB $01,$01,$FF,$00

; Spawn Enemy
;
; Used by the routine at #R$87AF.
; .
; Starts an enemy in the slot found by #R$87F6. The kind of enemy comes
; from the table at #R$990A, indexed by a counter that steps through a
; sequence of values.
;
; IX Address of the free slot
@label=SpawnEnemy
c$89D3 LD B,$06        ; Use a counter limit of six...
 $89D5 LD A,($F5F1)    ; {...or eight if the flags at #R$F5F1 and #R$F5F2 are
 $89D8 AND A           ; both set.
 $89D9 JR Z,$89E3      ;
 $89DB LD A,($F5F2)    ;
 $89DE AND A           ;
 $89DF JR Z,$89E3      ;
 $89E1 LD B,$08        ; }
@label=SpawnEnemy_Counter
*$89E3 LD A,($9932)    ; Fetch the counter from #R$9932.
 $89E6 INC A           ; {Increase it and store it.
 $89E7 LD ($9932),A    ; }
 $89EA CP B            ; Compare it with the limit.
 $89EB JR C,$89F1      ; Jump to #R$89F1 if it is lower.
 $89ED XOR A           ; {Otherwise restart the counter at zero.
 $89EE LD ($9932),A    ; }
@label=SpawnEnemy_Kind
*$89F1 CP $04          ; {Jump to #R$89FE if the counter is not four.
 $89F3 JR NZ,$89FE     ; }
 $89F5 LD B,A          ; Keep the counter in #REGb.
 $89F6 LD A,R          ; Fetch a pseudo-random value from the refresh register.
 $89F8 AND %00110010   ; Keep some of its bits.
 $89FA LD A,B          ; Restore the counter.
 $89FB JR Z,$89FE      ; Jump to #R$89FE if the random bits were zero.
 $89FD DEC A           ; Otherwise use three instead of four.
@label=SpawnEnemy_Store
*$89FE LD ($89D2),A    ; Store the kind of enemy in #N$89D2.
 $8A01 CP $01          ; {Jump to #R$8A09 if it is one.
 $8A03 JR Z,$8A09      ; }
 $8A05 CP $05          ; {Jump to #R$8A18 if it is not five.
 $8A07 JR NZ,$8A18     ; }
@label=SpawnEnemy_CheckZone
*$8A09 LD A,($CE58)    ; Fetch the map zone from #R$CE58.
 $8A0C CP $03          ; {Jump to #R$8A14 if it is lower than #N$03.
 $8A0E JR C,$8A14      ; }
 $8A10 CP $0A          ; {Jump to #R$8A18 if it is lower than #N$0A.
 $8A12 JR C,$8A18      ; }
@label=SpawnEnemy_Reset
*$8A14 XOR A           ; {Use kind zero instead.
 $8A15 LD ($89D2),A    ; }
@label=SpawnEnemy_CheckBonus
*$8A18 LD A,($CE58)    ; Fetch the map zone from #R$CE58.
 $8A1B CP $0B          ; {Jump to #R$8A26 if it is #N$0B or more.
 $8A1D JR NC,$8A26     ; }
 $8A1F LD A,($87F5)    ; Fetch the bonus timer from #R$87F5.
 $8A22 AND A           ; Test it.
 $8A23 JP NZ,$8B9B     ; Jump to #R$8B9B if it is running.
@label=SpawnEnemy_Limit
*$8A26 LD B,$03        ; #REGb=#N$03.
; This entry point is used by the routine at #R$8792.
@label=SpawnEnemy_ChooseSide
*$8A28 LD C,$00        ; Clear #REGc.
 $8A2A LD A,($C8FE)    ; Fetch the first byte of #N$C8FE.
 $8A2D AND A           ; Test it.
 $8A2E JR Z,$8A42      ; Jump to #R$8A42 if it is zero.
 $8A30 INC A           ; Increment it.
 $8A31 JR Z,$8A42      ; Jump to #R$8A42 if it was #N$FF.
 $8A33 LD A,($CCBB)    ; Fetch the scroll speed from #R$CCBB.
 $8A36 BIT 7,A         ; {Jump to #R$8A40 if bit 7 is set.
 $8A38 JR NZ,$8A40     ; }
 $8A3A LD A,B          ; {Keep only bit 0 of #REGb.
 $8A3B AND $01         ;
 $8A3D LD B,A          ; }
 $8A3E JR $8A42        ; Jump to #R$8A42.
@label=SpawnEnemy_ChooseRight
*$8A40 LD C,$02        ; #REGc=#N$02.
@label=SpawnEnemy_ChooseLower
*$8A42 LD A,($C900)    ; Fetch the first byte of #N$C900.
 $8A45 AND A           ; Test it.
 $8A46 JR Z,$8A58      ; Jump to #R$8A58 if it is zero.
 $8A48 INC A           ; Increment it.
 $8A49 JR Z,$8A58      ; Jump to #R$8A58 if it was #N$FF.
 $8A4B INC C           ; Add one to #REGc.
 $8A4C LD A,($CCBA)    ; Fetch the scroll speed from #R$CCBA.
 $8A4F BIT 7,A         ; {Jump to #R$8A58 if bit 7 is set.
 $8A51 JR NZ,$8A58     ; }
 $8A53 DEC C           ; Subtract one from #REGc.
 $8A54 LD A,B          ; {Keep only bit 1 of #REGb.
 $8A55 AND $02         ;
 $8A57 LD B,A          ; }
@label=SpawnEnemy_Pick
*$8A58 LD A,$04        ; {Set the number of attempts in #R$8C04 to four.
 $8A5A LD ($8C04),A    ; }
 $8A5D LD A,($9BCB)    ; Fetch the first byte of the random seed.
 $8A60 AND B           ; {Mask it with #REGb and combine it with #REGc.
 $8A61 OR C            ; }
@label=SpawnEnemy_Try
*$8A62 LD ($5C1C),A    ; Store the result in #R$5C1C.
 $8A65 LD HL,$DC91     ; Use the table at #R$DC91.
 $8A68 CALL $9BCF      ; Add a random value to the address.
 $8A6B LD E,(HL)       ; Fetch the entry.
 $8A6C LD HL,$855C     ; {Use the table at #R$855C and add the entry.
 $8A6F ADD HL,DE       ; }
 $8A70 LD A,(HL)       ; Fetch the pattern.
 $8A71 LD ($5C1D),A    ; Store it in #R$5C1D.
 $8A74 LD A,R          ; Fetch a pseudo-random value from the refresh register.
 $8A76 AND %00000111   ; Keep three bits.
 $8A78 LD ($5C1E),A    ; Store them in #R$5C1E.
 $8A7B ADD A,A         ; {Multiply them by eight...
 $8A7C ADD A,A         ;
 $8A7D ADD A,A         ; }
 $8A7E ADD A,$47       ; ...and add #N$47 to make an attribute value.
 $8A80 LD ($8A8B),A    ; Store it in the data at #N$8A8B.
 $8A83 XOR A           ; {Clear the bit counter in #R$5C1F.
 $8A84 LD ($5C1F),A    ; }
@label=SpawnEnemy_Bit
*$8A87 LD A,($5C1D)    ; Fetch the pattern from #R$5C1D.
 $8A8A RLC B           ; Rotate the mask in #REGb left.
 $8A8C JR NZ,$8AA3     ; Jump to #R$8AA3 if the bit was set.
 $8A8E LD A,($5C1D)    ; Fetch the pattern again.
 $8A91 RRCA            ; Rotate it right.
 $8A92 LD ($5C1D),A    ; Store it.
 $8A95 LD A,($5C1F)    ; Fetch the bit counter from #R$5C1F.
 $8A98 INC A           ; {Increment it and store it.
 $8A99 LD ($5C1F),A    ; }
 $8A9C CP $08          ; {Jump back to #R$8A87 if all eight bits have not been
 $8A9E JR NZ,$8A87     ; tried.}
 $8AA0 JP $8B82        ; Give up and jump to #R$8B82.
@label=SpawnEnemy_Position
*$8AA3 LD A,($5C1E)    ; Fetch the random three bits from #R$5C1E.
 $8AA6 LD B,A          ; {Add the bit counter from #R$5C1F.
 $8AA7 LD A,($5C1F)    ;
 $8AAA ADD A,B         ; }
 $8AAB AND %00000111   ; Keep the bottom three bits.
 $8AAD ADD A,A         ; Double it to index a pair of bytes.
 $8AAE LD HL,$8605     ; Use the table at #R$8605.
 $8AB1 CALL $9BCF      ; Add the offset to the address.
 $8AB4 LD A,(HL)       ; {Set the horizontal position of the enemy from the
 $8AB5 LD (IX+$02),A   ; table.}
 $8AB8 INC HL          ; {Set the vertical position of the enemy from the
 $8AB9 LD A,(HL)       ; table.
 $8ABA LD (IX+$05),A   ; }
 $8ABD LD (IX+$0D),$FF ; Make the enemy's attribute #N($FF).
 $8AC1 LD A,($9BCC)    ; Fetch the second byte of the random seed.
 $8AC4 AND %01001000   ; Keep two bits.
 $8AC6 JR NZ,$8ACC     ; Jump to #R$8ACC if either is set.
 $8AC8 LD (IX+$0D),$77 ; Otherwise make the attribute #N$77.
@label=SpawnEnemy_FetchKind
*$8ACC LD A,($89D2)    ; Fetch the kind of enemy from #N$89D2.
@label=SpawnEnemy_SetKind
*$8ACF ADD A,A         ; {Multiply it by four.
 $8AD0 ADD A,A         ; }
 $8AD1 LD HL,$990A     ; Use the table at #R$990A.
 $8AD4 CALL $9BCF      ; Add the offset to the address.
 $8AD7 CALL $AC34      ; Clear the slot.
 $8ADA LD (IX+$15),$01 ; Set the lifetime of the enemy to one.
 $8ADE LD A,(HL)       ; {Set the type of the enemy from the table.
 $8ADF LD (IX+$00),A   ;
 $8AE2 INC HL          ;
 $8AE3 LD A,(HL)       ; }
 $8AE4 LD (IX+$10),A   ; {Set the flags of the enemy from the table.
 $8AE7 INC HL          ;
 $8AE8 LD A,(HL)       ; }
 $8AE9 LD (IX+$13),A   ; {Set the first state byte of the enemy from the table.
 $8AEC INC HL          ;
 $8AED LD A,(HL)       ; }
 $8AEE LD (IX+$14),A   ; Set the second state byte of the enemy from the table.
 $8AF1 LD A,(IX+$00)   ; Fetch the type of the enemy.
 $8AF4 CP $1D          ; {Jump to #R$8BD1 if it is #N$1D.
 $8AF6 JP Z,$8BD1      ; }
 $8AF9 LD HL,($CE57)   ; Fetch the map position from #R$CE57.
 $8AFC LD A,($5C1C)    ; Fetch the value from #R$5C1C.
 $8AFF AND A           ; Test it.
 $8B00 JR Z,$8B0F      ; Jump to #R$8B0F if it is zero.
 $8B02 BIT 0,A         ; {Jump to #R$8B07 if bit 0 is clear.
 $8B04 JR Z,$8B07      ; }
 $8B06 INC H           ; Move the enemy one zone along.
@label=SpawnEnemy_Column
*$8B07 BIT 1,A         ; {Jump to #R$8B0F if bit 1 is clear.
 $8B09 JR Z,$8B0F      ; }
 $8B0B LD A,($DDF7)    ; Fetch the column from #R$DDF7.
 $8B0E LD L,A          ; Use it as the column of the enemy.
@label=SpawnEnemy_Place
*$8B0F LD (IX+$01),L   ; Set the map column of the enemy.
 $8B12 LD (IX+$04),H   ; Set the map zone of the enemy.
 $8B15 LD A,(IX+$00)   ; Fetch the type of the enemy.
 $8B18 CP $13          ; {Jump to #R$8B58 if it is not #N$13.
 $8B1A JR NZ,$8B58     ; }
 $8B1C LD (IX+$13),$00 ; Clear the first state byte of the enemy.
 $8B20 LD A,R          ; Fetch a pseudo-random value from the refresh register.
 $8B22 AND %00011100   ; Keep some of its bits.
 $8B24 JR NZ,$8B29     ; Jump to #R$8B29 if any are set.
 $8B26 INC (IX+$13)    ; Otherwise change the state of the enemy.
@label=SpawnEnemy_Zone
*$8B29 LD A,H          ; Fetch the map zone of the enemy.
 $8B2A CP $05          ; {Jump to #R$8B75 if it is #N$05 or higher.
 $8B2C JR NC,$8B75     ; }
 $8B2E LD (IX+$10),$23 ; Set the flags of the enemy to #N$23.
 $8B32 LD (IX+$04),$04 ; Set the map zone of the enemy to #N$04.
 $8B36 LD (IX+$05),$1F ; Set the vertical position of the enemy to #N$1F.
 $8B3A LD (IX+$0D),$FF ; Make the attribute of the enemy #N($FF).
 $8B3E LD A,($DDF7)    ; Fetch the column from #R$DDF7.
 $8B41 CP L            ; Compare it with the column of the enemy.
 $8B42 JR Z,$8B51      ; Jump to #R$8B51 if it is the same.
 $8B44 LD A,($CE45)    ; Fetch the horizontal position of the player from
                       ; #R$CE45.
 $8B47 SUB $30         ; Subtract #N$30 from it.
 $8B49 JR C,$8B96      ; Remove the enemy if that goes below zero.
 $8B4B ADD A,$08       ; Add #N$08 to it.
 $8B4D LD (IX+$02),A   ; Set the horizontal position of the enemy.
 $8B50 RET             ; Return.
@label=SpawnEnemy_SameColumn
*$8B51 LD A,($CE45)    ; Fetch the horizontal position of the player from
                       ; #R$CE45.
 $8B54 LD (IX+$02),A   ; Set the horizontal position of the enemy.
 $8B57 RET             ; Return.
@label=SpawnEnemy_Attribute
*$8B58 LD A,R          ; Fetch a pseudo-random value from the refresh register.
 $8B5A AND %00000111   ; Keep three bits.
 $8B5C LD B,A          ; Copy them into #REGb.
 $8B5D LD A,H          ; Fetch the map zone of the enemy.
 $8B5E CP $0C          ; {Jump to #R$8B6A if it is #N$0C or higher.
 $8B60 JR NC,$8B6A     ; }
 $8B62 CP $04          ; {Jump to #R$8B6A if it is lower than #N$04.
 $8B64 JR C,$8B6A      ; }
 $8B66 LD A,B          ; {Keep only two bits of the random value.
 $8B67 AND $03         ;
 $8B69 LD B,A          ; }
@label=SpawnEnemy_Colour
*$8B6A LD A,B          ; Fetch the random value.
 $8B6B LD HL,$9933     ; Use the table at #R$9933.
 $8B6E CALL $9BCF      ; Add the value to the address.
 $8B71 LD A,(HL)       ; Fetch the attribute from the table.
 $8B72 LD (IX+$0D),A   ; Set the attribute of the enemy.
@label=SpawnEnemy_Finish
*$8B75 CALL $ADD8      ; Update the enemy.
 $8B78 BIT 7,(IX+$10)  ; {Jump to #R$8B93 if bit 7 of the flags of the enemy is
 $8B7C JR Z,$8B93      ; clear.}
 $8B7E LD (IX+$00),$FF ; Otherwise remove the enemy.
@label=SpawnEnemy_Retry
*$8B82 LD A,($8C04)    ; Fetch the number of attempts left from #R$8C04.
 $8B85 DEC A           ; {Decrease it and store it.
 $8B86 LD ($8C04),A    ; }
 $8B89 RET Z           ; Return if there are none left.
 $8B8A LD A,($5C1C)    ; Fetch the value from #R$5C1C.
 $8B8D INC A           ; Move on to the next one...
 $8B8E AND %00000011   ; ...keeping two bits.
 $8B90 JP $8A62        ; Try again.
@label=SpawnEnemy_Accelerate
*$8B93 JP $8C67        ; Set the acceleration of the enemy.
@label=SpawnEnemy_Remove
*$8B96 LD (IX+$00),$FF ; Free the slot.
 $8B9A RET             ; Return.
@label=SpawnEnemy_Bonus
*$8B9B LD IY,$C8E5     ; Use the player's object at #R$C8E5.
 $8B9F CALL $898E      ; Copy the position of the player to the enemy.
 $8BA2 LD A,($9BCB)    ; Fetch the first byte of the random seed.
 $8BA5 LD B,A          ; Copy it into #REGb.
 $8BA6 AND %00110000   ; Keep two bits.
 $8BA8 ADD A,$18       ; Add #N$18.
 $8BAA BIT 7,B         ; {Jump to #R$8BB2 if bit 7 of the random value is
 $8BAC JR Z,$8BB2      ; clear.}
 $8BAE SUB $18         ; Subtract #N$18...
 $8BB0 NEG             ; ...and negate the result.
@label=SpawnEnemy_BonusSpeed
*$8BB2 LD (IX+$07),A   ; Set the horizontal speed of the enemy.
 $8BB5 LD A,(IY+$1E)   ; Fetch the second vertical value of the player.
 $8BB8 SUB $10         ; Subtract #N$10...
 $8BBA NEG             ; ...and negate the result.
 $8BBC LD (IX+$09),A   ; Set the vertical speed of the enemy.
 $8BBF CALL $BF66      ; Draw the enemy.
 $8BC2 LD A,($CE57)    ; Fetch the map column from #R$CE57.
 $8BC5 CP (IX+$01)     ; Compare it with the map column of the enemy.
 $8BC8 LD A,$09        ; Select the kind of enemy.
 $8BCA JP Z,$8ACF      ; Jump to #R$8ACF if they are the same.
 $8BCD DEC A           ; Otherwise use the one before.
 $8BCE JP $8ACF        ; Jump to #R$8ACF.
@label=SpawnEnemy_Type1D
*$8BD1 LD A,($9BCB)    ; Fetch the first byte of the random seed.
 $8BD4 AND %00001000   ; Keep bit 3.
 $8BD6 SRL A           ; {Shift it right twice.
 $8BD8 SRL A           ; }
 $8BDA ADD A,$02       ; Add two.
 $8BDC LD (IX+$09),A   ; Set the vertical speed of the enemy.
 $8BDF LD A,($9BCC)    ; Fetch the second byte of the random seed.
 $8BE2 AND %00001000   ; Keep bit 3.
 $8BE4 SRL A           ; {Shift it right twice.
 $8BE6 SRL A           ; }
 $8BE8 ADD A,$02       ; Add two.
 $8BEA LD (IX+$07),A   ; Set the horizontal speed of the enemy.
 $8BED NEG             ; {Negate it and copy it into #REGb.
 $8BEF LD B,A          ; }
 $8BF0 LD A,($CE57)    ; Fetch the map column from #R$CE57.
 $8BF3 CP (IX+$01)     ; Compare it with the map column of the enemy.
 $8BF6 LD (IX+$0D),$FE ; Make the attribute of the enemy #N($FE).
 $8BFA RET Z           ; Return if they are the same.
 $8BFB LD (IX+$07),B   ; Otherwise reverse the horizontal speed.
 $8BFE LD (IX+$0D),$EE ; Make the attribute of the enemy #N($EE).
 $8C02 RET             ; Return.
 $8C03 DEFB $00        ;
 $8C04 DEFB $00        ;

; Accelerate Object
;
; Used by the routines at #R$938D, #R$93F2, #R$9457, #R$94A8, #R$9507 and
; #R$9524.
; .
; Adds the acceleration of an object to its speed in both directions,
; limiting the speed to a maximum which depends on the flags of the object.
; The speeds are two byte values (see #R$8C3F).
;
; IX Address of the object
@label=AccelerateObject
c$8C05 LD A,(IX+$10) ; Fetch the flags of the object.
 $8C08 AND %00000111 ; Keep the bottom three bits.
 $8C0A INC A         ; Add one to get the speed limit.
 $8C0B LD ($8C03),A  ; Store it in #R$8C03.
 $8C0E CPL           ; Negate it...
 $8C0F LD ($8C04),A  ; ...and store the negative limit in #R$8C04.
 $8C12 LD H,(IX+$07) ; {Fetch the horizontal speed of the object into #REGhl.
 $8C15 LD L,(IX+$08) ; }
 $8C18 LD D,(IX+$0B) ; {Fetch the horizontal acceleration into #REGde.
 $8C1B LD E,(IX+$0C) ; }
 $8C1E ADD HL,DE     ; Add it to the speed.
 $8C1F CALL $8C3F    ; Limit the speed.
 $8C22 LD (IX+$07),H ; {Store the new horizontal speed.
 $8C25 LD (IX+$08),L ; }
 $8C28 LD H,(IX+$09) ; {Fetch the vertical speed of the object into #REGhl.
 $8C2B LD L,(IX+$0A) ; }
 $8C2E LD D,(IX+$0E) ; {Fetch the vertical acceleration into #REGde.
 $8C31 LD E,(IX+$0F) ; }
 $8C34 ADD HL,DE     ; Add it to the speed.
 $8C35 CALL $8C3F    ; Limit the speed.
 $8C38 LD (IX+$09),H ; {Store the new vertical speed.
 $8C3B LD (IX+$0A),L ; }
 $8C3E RET           ; Return.

; Limit Speed To Range
;
; Used by the routine at #R$8C05.
; .
; Limits a speed to the range set by #R$8C05.
;
;   HL Speed
; O:HL Limited speed
@label=LimitSpeedToRange
c$8C3F BIT 7,H       ; {Jump to #R$8C4E if it is negative.
 $8C41 JR NZ,$8C4E   ; }
 $8C43 LD A,($8C03)  ; Fetch the positive limit from #R$8C03.
 $8C46 DEC A         ; Subtract one.
 $8C47 CP H          ; Compare it with the high byte of the speed.
 $8C48 RET NC        ; Return if the speed is within the limit.
 $8C49 INC A         ; Restore the limit...
 $8C4A LD H,A        ; ...and use it as the speed.
 $8C4B LD L,$00      ; Clear the low byte of the speed.
 $8C4D RET           ; Return.
@label=LimitSpeedToRange_Negative
*$8C4E LD A,($8C04)  ; Fetch the negative limit from #R$8C04.
 $8C51 CP H          ; Compare it with the high byte of the speed.
 $8C52 RET C         ; Return if the speed is within the limit.
 $8C53 INC A         ; Add one to the limit...
 $8C54 LD H,A        ; ...and use it as the speed.
 $8C55 LD L,$00      ; Clear the low byte of the speed.
 $8C57 RET           ; Return.

; Accelerate Towards Player
;
; Used by the routine at #R$90EC.
; .
; Sets the acceleration of an object so that it heads towards the
; player. Objects of type #N$1D and #N$1E are left alone.
;
; IX Address of the object
@label=AccelerateTowardsPlayer
c$8C58 LD A,(IX+$00)   ; Fetch the type of the object.
 $8C5B CP $1D          ; Is it #N$1D?
 $8C5D RET Z           ; Return if so.
 $8C5E CP $1E          ; Is it #N$1E?
 $8C60 RET Z           ; Return if so.
 $8C61 LD A,($5C31)    ; Fetch the value from #R$5C31.
 $8C64 AND %10000000   ; Keep bit 7.
 $8C66 RET NZ          ; Return if it is set.
; This entry point is used by the routine at #R$89D3.
@label=AccelerateTowardsPlayer_Horizontal
*$8C67 LD (IX+$0B),$00 ; {Set the horizontal acceleration to #N$0020.
 $8C6B LD (IX+$0C),$20 ; }
 $8C6F LD A,($CE57)    ; Fetch the map column of the player from #R$CE57.
 $8C72 CP (IX+$01)     ; Compare it with the map column of the object.
 $8C75 JR Z,$8C7F      ; Jump to #R$8C7F if they are the same.
 $8C77 LD (IX+$0C),$E0 ; {Otherwise set the horizontal acceleration to #N$FFE0.
 $8C7B LD (IX+$0B),$FF ; }
@label=AccelerateTowardsPlayer_Stop
*$8C7F XOR A           ; {Clear the speeds of the object and its vertical
 $8C80 LD (IX+$09),A   ; acceleration.
 $8C83 LD (IX+$0A),A   ;
 $8C86 LD (IX+$0E),A   ;
 $8C89 LD (IX+$0F),A   ; }
 $8C8C LD A,($CE58)    ; Fetch the map zone of the player from #R$CE58.
 $8C8F CP (IX+$04)     ; Compare it with the map zone of the object.
 $8C92 LD A,($CE46)    ; Fetch the vertical position of the player from
                       ; #R$CE46.
 $8C95 JR NZ,$8CA4     ; Jump to #R$8CA4 if the zones are different.
 $8C97 CP (IX+$05)     ; Compare it with the vertical position of the object.
 $8C9A RET C           ; Return if it is lower.
 $8C9B LD (IX+$0E),$00 ; {Set the vertical acceleration to #N$0020.
 $8C9F LD (IX+$0F),$20 ; }
 $8CA3 RET             ; Return.
@label=AccelerateTowardsPlayer_Other
*$8CA4 CP (IX+$05)     ; Compare the vertical position of the player with that
                       ; of the object.
 $8CA7 RET NC          ; Return if it is not lower.
 $8CA8 LD (IX+$0E),$FF ; {Set the vertical acceleration to #N$FFE0.
 $8CAC LD (IX+$0F),$E0 ; }
 $8CB0 RET             ; Return.
 $8CB1 DEFB $00        ;

; Explode Player Ship
;
; Used by the routine at #R$8D42.
; .
; Fills all nine enemy slots with the pieces of debris from the player's
; exploding ship: four pieces of type #N$15 followed by five pieces of type
; #N$1C.
@label=ExplodePlayerShip
c$8CB2 LD IY,$C8E5     ; Use the player's object.
 $8CB6 LD BC,$0400     ; Set the piece counter and timer in #REGbc.
 $8CB9 LD IX,$9974     ; Use the first enemy slot.
 $8CBD LD A,($C1A9)    ; Fetch the scroll value from #R$C1A9.
 $8CC0 SRL A           ; Halve it.
 $8CC2 NEG             ; Negate it.
 $8CC4 LD ($5C1D),A    ; Store it in #R$5C1D.
@label=ExplodePlayerShip_First
*$8CC7 PUSH BC         ; Save the counters.
 $8CC8 CALL $8D29      ; Start a piece at the position of the player.
 $8CCB CALL $903D      ; Make the piece type #N$15.
 $8CCE LD (IX+$0D),$FF ; Make the attribute of the piece #N($FF).
 $8CD2 POP BC          ; Restore the counters.
 $8CD3 LD A,C          ; {Set the timer of the piece.
 $8CD4 LD (IX+$15),A   ; }
 $8CD7 ADD A,$40       ; {Add #N$40 to the timer for the next piece.
 $8CD9 LD C,A          ; }
 $8CDA LD DE,$0018     ; Set the length of a slot.
 $8CDD ADD IX,DE       ; Move on to the next slot.
 $8CDF DJNZ $8CC7      ; Decrease the piece counter by one and loop back to #R$8CC7 until
                       ; none remain.
 $8CE1 LD BC,$0500     ; Set the counter for five more pieces.
@label=ExplodePlayerShip_Second
*$8CE4 PUSH BC         ; Save the counters.
 $8CE5 CALL $8D29      ; Start a piece at the position of the player.
 $8CE8 LD (IX+$00),$1C ; Make the piece type #N$1C.
 $8CEC LD (IX+$10),$06 ; Set the flags of the piece.
 $8CF0 LD (IX+$13),$50 ; Set the first state byte of the piece.
 $8CF4 LD (IX+$14),$02 ; Set the second state byte of the piece.
 $8CF8 LD (IX+$15),$40 ; Set the lifetime of the piece.
 $8CFC LD (IX+$0D),$EE ; Make the attribute of the piece #N($EE).
 $8D00 POP BC          ; Restore the counters.
 $8D01 LD A,C          ; Fetch the timer.
 $8D02 LD HL,$8D1F     ; Use the table of speeds at #R$8D1F.
 $8D05 CALL $9BCF      ; Add the offset to the address.
 $8D08 LD A,(HL)       ; {Set the horizontal speed of the piece from the table.
 $8D09 LD (IX+$07),A   ; }
 $8D0C INC HL          ; Fetch the next byte of the table.
 $8D0D LD A,(HL)       ; {Set the vertical speed of the piece from the table.
 $8D0E LD (IX+$09),A   ; }
 $8D11 INC C           ; {Move on to the next pair of speeds.
 $8D12 INC C           ; }
 $8D13 LD (IX+$0F),$20 ; Set the vertical acceleration of the piece.
 $8D17 LD DE,$0018     ; Set the length of a slot.
 $8D1A ADD IX,DE       ; Move on to the next slot.
 $8D1C DJNZ $8CE4      ; Decrease the piece counter by one and loop back to #R$8CE4 until
                       ; none remain.
 $8D1E RET             ; Return.

; Debris Speeds
;
; Five pairs of horizontal and vertical speeds for the pieces of debris
; of type #N$1C.
@label=DebrisSpeeds
b$8D1F DEFB $FA,$FD
 $8D21 DEFB $FD,$FA
 $8D23 DEFB $00,$FC
 $8D25 DEFB $03,$FA
 $8D27 DEFB $06,$FD

; Start Debris Piece
;
; Used by the routine at #R$8CB2.
; .
; Starts a piece of debris at the position of the player's ship.
;
; IX Address of the slot
; IY Address of the player's object
@label=StartDebrisPiece
c$8D29 CALL $AC34      ; Clear the slot.
 $8D2C CALL $898E      ; Copy the position of the player.
 $8D2F LD (IX+$07),$1C ; Set the horizontal speed of the piece.
 $8D33 LD A,($5C1D)    ; Fetch the speed from #R$5C1D.
 $8D36 LD (IX+$09),A   ; Set the vertical speed of the piece.
 $8D39 JP $BF66        ; Jump to #R$BF66.
 $8D3C DEFB $00        ;

; Skip Enemy Slot
;
; Used by the routine at #R$8D42.
; .
; Part of #R$8D42: restores #REGix and moves on to the next slot.
@label=UpdateEnemies_Skip
c$8D3D POP IX        ; Bring #REGix back off the stack.
 $8D3F JP $8DFA      ; Jump to #R$8DFA.

; Update Enemies
;
; Used by the routines at #R$F46C and #R$F48B.
; .
; Updates all nine enemy slots once a frame. The counter at #R$8F53
; tracks the explosion of the player's ship: it counts up from one when the
; ship is destroyed, the debris is started when it reaches ten, and the ship
; is gone for good when it has gone past that point.
@label=UpdateEnemies
c$8D42 LD A,($8F53)    ; Fetch the explosion counter from #R$8F53.
 $8D45 AND A           ; Test it.
 $8D46 JR Z,$8D4C      ; Jump to #R$8D4C if the ship is intact.
 $8D48 INC A           ; Increase the counter...
 $8D49 LD ($8F53),A    ; ...and store it.
@label=UpdateEnemies_Debris
*$8D4C CP $0A          ; Has the counter reached ten?
 $8D4E CALL Z,$8CB2    ; Start the debris if so.
 $8D51 LD A,($8F53)    ; Fetch the explosion counter again.
 $8D54 CP $0A          ; Is it ten or more?
 $8D56 CALL NC,$72AB   ; Play the sound of the explosion if so.
 $8D59 LD A,($5C40)    ; Fetch the value from #R$5C40.
 $8D5C LD ($8CB1),A    ; Store it in #R$8CB1.
 $8D5F XOR A           ; Clear #REGa.
 $8D60 LD ($8E2B),A    ; Clear the number of active enemies in #R$8E2B.
 $8D63 LD ($5C40),A    ; Clear #R$5C40.
 $8D66 LD A,($8D3C)    ; Fetch the value from #R$8D3C.
 $8D69 LD ($8E2B),A    ; Store it in #R$8E2B.
 $8D6C LD IX,$9974     ; Use the first enemy slot.
 $8D70 LD B,$09        ; Set the counter for nine slots.
@label=UpdateEnemies_Loop
*$8D72 PUSH BC         ; Save the slot counter.
 $8D73 PUSH IX         ; Save the address of the slot.
 $8D75 LD A,(IX+$00)   ; Fetch the type of the object in the slot.
 $8D78 INC A           ; Increment it.
 $8D79 JP Z,$8D3D      ; Skip the slot if it is free.
 $8D7C LD A,(IX+$17)   ; Fetch the second set of flags of the object.
 $8D7F AND %11110000   ; Keep the top four bits.
 $8D81 JR Z,$8D8F      ; Jump to #R$8D8F if they are zero.
 $8D83 SUB $10         ; Subtract one from the top four bits...
 $8D85 LD B,A          ; {...and store them back with the bottom four bits.
 $8D86 LD A,(IX+$17)   ;
 $8D89 AND $0F         ;
 $8D8B OR B            ;
 $8D8C LD (IX+$17),A   ; }
@label=UpdateEnemies_Exploding
*$8D8F LD A,($8F53)    ; Fetch the explosion counter from #R$8F53.
 $8D92 AND A           ; Test it.
 $8D93 JR Z,$8D9D      ; Jump to #R$8D9D if the ship is intact.
 $8D95 CP $04          ; {Jump to #R$8D9D if the counter is four or higher.
 $8D97 JR NC,$8D9D     ; }
 $8D99 SET 3,(IX+$17)  ; Otherwise set bit 3 of the second set of flags.
@label=UpdateEnemies_Update
*$8D9D LD A,$50        ; {Set the collision effects in #R$8E2C to #N$50.
 $8D9F LD ($8E2C),A    ; }
 $8DA2 LD A,($8E2B)    ; {Add one to the number of active enemies in #R$8E2B.
 $8DA5 INC A           ;
 $8DA6 LD ($8E2B),A    ; }
 $8DA9 CALL $A2EA      ; Reset the collision state.
 $8DAC BIT 7,(IX+$10)  ; Test bit 7 of the flags.
 $8DB0 CALL NZ,$8E21   ; Call #R$8E21 if it is set.
 $8DB3 RES 6,(IX+$10)  ; Clear bit 6 of the flags.
 $8DB7 EXX             ; Switch registers.
 $8DB8 CALL $A18D      ; Run the code for the type of object.
 $8DBB CALL $8E2D      ; Deal with any collision at #R$8E2D.
 $8DBE POP IX          ; Restore the address of the slot.
 $8DC0 LD A,(IX+$00)   ; Fetch the type of the object.
 $8DC3 CP $13          ; {Jump to #R$8DD8 if it is #N$13.
 $8DC5 JR Z,$8DD8      ; }
 $8DC7 CP $1C          ; {Jump to #R$8DD1 if it is #N$1C.
 $8DC9 JR Z,$8DD1      ; }
 $8DCB CP $1D          ; {Jump to #R$8DD8 if it is #N$1D.
 $8DCD JR Z,$8DD8      ; }
 $8DCF JR $8DE8        ; Jump to #R$8DE8.
@label=UpdateEnemies_Type1C
*$8DD1 LD A,(IX+$14)   ; Fetch the second state byte of the object.
 $8DD4 CP $02          ; {Jump to #R$8DE8 if it is two.
 $8DD6 JR Z,$8DE8      ; }
@label=UpdateEnemies_CheckHit
*$8DD8 LD A,($A1D7)    ; Fetch the flag from #R$A1D7.
 $8DDB AND A           ; Test it.
 $8DDC JR Z,$8DE8      ; Jump to #R$8DE8 if it is clear.
 $8DDE LD A,($A1D8)    ; Fetch the flag from #R$A1D8.
 $8DE1 AND A           ; Test it.
 $8DE2 JR NZ,$8DE8     ; Jump to #R$8DE8 if it is set.
 $8DE4 LD (IX+$00),$FF ; Otherwise free the slot.
@label=UpdateEnemies_Check
*$8DE8 BIT 5,(IX+$10)  ; {Jump to #R$8DFA if bit 5 of the flags is set.
 $8DEC JR NZ,$8DFA     ; }
 $8DEE BIT 3,(IX+$17)  ; {Jump to #R$8DFA if bit 3 of the second set of flags
 $8DF2 JR NZ,$8DFA     ; is set.}
 $8DF4 CALL $9143      ; Work out the position of a hit.
 $8DF7 CALL $917C      ; Check for a collision with a shot.
; This entry point is used by the routine at #R$8D3D.
@label=UpdateEnemies_Next
*$8DFA LD BC,$0018     ; Set the length of a slot.
 $8DFD ADD IX,BC       ; Move on to the next slot.
 $8DFF POP BC          ; Restore the slot counter.
 $8E00 DEC B           ; Decrease the slot counter...
 $8E01 JP NZ,$8D72     ; ...and loop back to #R$8D72 until none remain.
 $8E04 LD A,($8E2B)    ; Fetch the number of active enemies from #R$8E2B.
 $8E07 CP $04          ; Return if there are four or more.
 $8E09 RET NC          ; Fetch a pseudo-random value from the refresh register.
 $8E0A LD A,R          ; {Test bit 3.
 $8E0C AND $08         ; }
 $8E0E JR Z,$8E1E      ; Jump to #R$8E1E if it is clear.
 $8E10 LD A,($CE58)    ; Fetch the map zone from #R$CE58.
 $8E13 CP $0B          ; {Jump to #R$8E1E if it is #N$0B or more...
 $8E15 JR NC,$8E1E     ; }
 $8E17 CP $03          ; {...or less than #N$03.
 $8E19 JR C,$8E1E      ; }
 $8E1B JP $8792        ; Spawn a special enemy.
@label=UpdateEnemies_Spawn
*$8E1E JP $87E7        ; Spawn an enemy.

; Count Active Enemy
;
; Used by the routine at #R$8D42.
; .
; Adds one to the number of active enemies and then jumps to #R$AD27.
@label=CountActiveEnemy
c$8E21 LD A,($8E2B)  ; Fetch the number of active enemies from #R$8E2B.
 $8E24 INC A         ; {Add one and store it.
 $8E25 LD ($8E2B),A  ; }
 $8E28 JP $AD27      ; Jump to #R$AD27.
 $8E2B DEFB $00      ;
 $8E2C DEFB $00      ;

; Apply Collision Effects
;
; Used by the routine at #R$8D42.
; .
; Works out what happens when the player's ship hits an object. The
; object sets the byte at #R$8E2C when it is updated, and each bit of that
; byte selects an effect:
; #TABLE(default,centre,centre)
; { =h Bit | =h Effect }
; { 7 | Slow the ship down (#R$8F1E) }
; { 6 | Damage the ship (#R$8F54) }
; { 5 | Drain fuel (#R$8FC4) }
; { 4 | Bounce the ship (#R$8FCA) }
; { 3 | Mark the object as destroyed (#R$900B) }
; { 2 | Add fuel (#R$9015) }
; { 1 | Add a ship (#R$9020) }
; { 0 | Mark the object as hit (#R$9030) }
; TABLE#
;
; IX Address of the object
@label=ApplyCollisionEffects
c$8E2D LD A,($96AB)   ; Fetch the flag from #R$96AB.
 $8E30 AND A          ; Test it.
 $8E31 RET NZ         ; Return if it is set.
 $8E32 LD A,($8F53)   ; Fetch the explosion counter from #R$8F53.
 $8E35 AND A          ; Test it.
 $8E36 RET NZ         ; Return if the ship is exploding.
 $8E37 LD A,($8E2C)   ; Fetch the collision effects from #R$8E2C.
 $8E3A AND A          ; Test them.
 $8E3B RET Z          ; Return if there are none.
 $8E3C LD A,($A1D8)   ; Fetch the collision flag from #R$A1D8.
 $8E3F AND A          ; Test it.
 $8E40 RET Z          ; Return if there is no collision.
 $8E41 LD IX,($AD46)  ; Fetch the address of the object that was hit from
                      ; #R$AD46.
 $8E45 BIT 3,(IX+$17) ; Test bit 3 of its second set of flags.
 $8E49 RET NZ         ; Return if it is set.
 $8E4A LD L,(IX+$11)  ; {Fetch the screen position of the object into #REGhl.
 $8E4D LD H,(IX+$12)  ; }
 $8E50 LD IX,$ABA4    ; Use the hit data at #R$ABA4.
 $8E54 LD (IX+$03),A  ; Store the collision effects in the hit data.
 $8E57 LD A,L         ; Fetch the horizontal screen position.
 $8E58 CP $8E         ; Is it #N$8E or more?
 $8E5A RET NC         ; Return if so.
 $8E5B CP $28         ; Is it lower than #N$28?
 $8E5D RET C          ; Return if so.
 $8E5E LD (IX+$00),L  ; {Store the screen position in the hit data.
 $8E61 LD (IX+$01),H  ; }
 $8E64 LD A,($5C29)   ; Fetch the value from #R$5C29.
 $8E67 LD (IX+$02),A  ; Store it in the hit data.
 $8E6A LD A,($5C38)   ; Fetch the value from #R$5C38.
 $8E6D ADD A,$08      ; Add eight.
 $8E6F LD H,A         ; Use it as the vertical position.
 $8E70 LD L,$64       ; Set the horizontal position to #N$64.
 $8E72 LD D,$28       ; Set the width to #N$28...
 $8E74 LD E,$10       ; ...and the height to #N$10.
 $8E76 CALL $9DB1     ; Check for a hit.
 $8E79 LD IX,($AD46)  ; Bring #REGix back from #R$AD46.
 $8E7D LD IY,$C8E5    ; Use the player's object.
 $8E81 LD A,($5C1C)   ; Fetch the value from #R$5C1C.
 $8E84 AND A          ; Test it.
 $8E85 JP Z,$8ECA     ; Jump to #R$8ECA if it is zero.
 $8E88 LD A,$80       ; {Set #R$D0BC to #N$80.
 $8E8A LD ($D0BC),A   ; }
 $8E8D LD A,($8E2C)   ; Fetch the collision effects from #R$8E2C.
 $8E90 LD C,A         ; Copy them into #REGc.
 $8E91 INC A          ; Increment them.
 $8E92 JR NZ,$8E9F    ; Jump to #R$8E9F if they were not #N($FF).
 $8E94 DEC A          ; {Make #R$896F #N($FF).
 $8E95 LD ($896F),A   ; }
 $8E98 SET 4,(IX+$10) ; Set bit 4 of the flags of the object.
 $8E9C JP $724C       ; Play the explosion sound.
@label=ApplyCollisionEffects_Bit7
*$8E9F BIT 7,C        ; Test bit 7.
 $8EA1 CALL NZ,$8F1E  ; Slow the ship down if it is set.
 $8EA4 BIT 6,C        ; Test bit 6.
 $8EA6 CALL NZ,$8F54  ; Damage the ship if it is set.
 $8EA9 BIT 5,C        ; Test bit 5.
 $8EAB CALL NZ,$8FC4  ; Drain the fuel if it is set.
 $8EAE BIT 4,C        ; Test bit 4.
 $8EB0 CALL NZ,$8FCA  ; Bounce the ship if it is set.
 $8EB3 BIT 3,C        ; Test bit 3.
 $8EB5 CALL NZ,$900B  ; Mark the object as destroyed if it is set.
 $8EB8 BIT 2,C        ; Test bit 2.
 $8EBA CALL NZ,$9015  ; Add fuel if it is set.
 $8EBD PUSH BC        ; Save the effects.
 $8EBE BIT 1,C        ; Test bit 1.
 $8EC0 CALL NZ,$9020  ; Add a ship if it is set.
 $8EC3 POP BC         ; Restore the effects.
 $8EC4 BIT 0,C        ; {Jump to #R$9030 if bit 0 is set.
 $8EC6 JP NZ,$9030    ; }
 $8EC9 RET            ; Return.

; Apply Player Collision
;
; Used by the routine at #R$8E2D.
; .
; Part of #R$8E2D, used when the value in #R$5C1C is zero. Only objects
; of type #N$13 are dealt with here. Purpose not yet known.
;
; IX Address of the object
; IY Address of the player's object
@label=ApplyPlayerCollision
c$8ECA LD A,(IX+$00) ; Fetch the type of the object.
 $8ECD CP $13        ; Is it #N$13?
 $8ECF RET NZ        ; Return if not.
 $8ED0 LD A,($F5F7)  ; Fetch the value from #R$F5F7.
 $8ED3 AND A         ; Test it.
 $8ED4 RET Z         ; Return if it is zero.
 $8ED5 LD A,($C8FD)  ; Fetch the value from #N$C8FD.
 $8ED8 XOR (IX+$07)  ; Combine the sign with the horizontal speed of the
                     ; object.
 $8EDB BIT 7,A       ; Test bit 7.
 $8EDD RET NZ        ; Return if it is set.
 $8EDE LD A,($C27C)  ; Fetch the value from #N$C27C.
 $8EE1 LD H,A        ; Use it as the horizontal position.
 $8EE2 LD A,($C27D)  ; Fetch the value from #R$C27D.
 $8EE5 ADD A,$08     ; Add eight.
 $8EE7 LD L,A        ; Use it as the vertical position.
 $8EE8 LD A,$50      ; #REGa=#N$50.
 $8EEA CALL $C331    ; Work out the position.
 $8EED LD E,B        ; Use the result as the height.
 $8EEE LD D,$0C      ; Set the width to #N$0C.
 $8EF0 LD IX,$ABA4   ; Use the hit data at #R$ABA4.
 $8EF4 CALL $9DB1    ; Check for a hit.
 $8EF7 LD A,($5C1C)  ; Fetch the value from #R$5C1C.
 $8EFA AND A         ; Test it.
 $8EFB RET Z         ; Return if it is zero.
 $8EFC LD A,$80      ; {Set #R$D0BC to #N$80.
 $8EFE LD ($D0BC),A  ; }
 $8F01 LD IX,($AD46) ; Fetch the address of the object that was hit from
                     ; #R$AD46.
 $8F05 LD H,(IX+$07) ; {Fetch its horizontal speed into #REGhl.
 $8F08 LD L,(IX+$08) ; }
 $8F0B CALL $BE08    ; Negate it.
 $8F0E SRA H         ; {Halve it.
 $8F10 RR L          ; }
 $8F12 LD (IY+$19),H ; {Give the result to the player as horizontal speed.
 $8F15 LD (IY+$1A),L ; }
 $8F18 LD A,$FF      ; {Set #R$5C40 to #N($FF).
 $8F1A LD ($5C40),A  ; }
 $8F1D RET           ; Return.

; Slow Ship
;
; Used by the routine at #R$8E2D.
; .
; Halves the speed of the player's ship in each direction, unless the
; speed of the object that was hit is in the opposite direction.
;
; IX Address of the object that was hit
; IY Address of the player's object
@label=SlowShip
c$8F1E LD A,($8CB1)  ; Fetch the value from #R$8CB1.
 $8F21 AND A         ; Test it.
 $8F22 RET NZ        ; Return if it is not zero.
 $8F23 LD D,(IY+$19) ; {Fetch the horizontal speed of the player into #REGde.
 $8F26 LD E,(IY+$1A) ; }
 $8F29 LD A,D        ; {Compare its sign with that of the object.
 $8F2A XOR (IX+$07)  ; }
 $8F2D BIT 7,A       ; {Jump to #R$8F3B if they are different.
 $8F2F JR NZ,$8F3B   ; }
 $8F31 SRA D         ; {Halve the horizontal speed...
 $8F33 RR E          ; }
 $8F35 LD (IY+$19),D ; {...and store it.
 $8F38 LD (IY+$1A),E ; }
@label=SlowShip_Vertical
*$8F3B LD D,(IY+$1B) ; {Fetch the vertical speed of the player into #REGde.
 $8F3E LD E,(IY+$1C) ; }
 $8F41 LD A,D        ; {Compare its sign with that of the object.
 $8F42 XOR (IX+$09)  ; }
 $8F45 BIT 7,A       ; Test bit 7.
 $8F47 RET NZ        ; Return if they are different.
 $8F48 SRA D         ; {Halve the vertical speed...
 $8F4A RR E          ; }
 $8F4C LD (IY+$1B),D ; {...and store it.
 $8F4F LD (IY+$1C),E ; }
 $8F52 RET           ; Return.
 $8F53 DEFB $00      ;

; Damage Ship
;
; Used by the routine at #R$8E2D.
; .
; Damages the player's ship. A ship that has just been hit cannot be hit
; again for a few frames. Each hit changes the colour of the damage indicator,
; and the third hit destroys the ship.
;
; IX Address of the object that was hit
@label=DamageShip
c$8F54 LD A,(IX+$17)            ; Fetch the second set of flags of the object.
 $8F57 AND %11110000            ; Keep the top four bits.
 $8F59 RET NZ                   ; Return if they are not zero.
 $8F5A LD A,(IX+$17)            ; Fetch the second set of flags again.
 $8F5D ADD A,$F0                ; Set the top four bits.
 $8F5F LD (IX+$17),A            ; Store them.
 $8F62 LD A,($896F)             ; Fetch the flag from #R$896F.
 $8F65 AND A                    ; Test it.
 $8F66 JR Z,$8F76               ; Jump to #R$8F76 if it is zero.
 $8F68 LD A,C                   ; Fetch the collision effects.
 $8F69 AND %11111110            ; Clear bit 0.
 $8F6B CP $50                   ; {Jump to #R$8F76 if the remaining effects are
 $8F6D JR NZ,$8F76              ; not #N$50.}
 $8F6F SET 5,(IX+$10)           ; Set bit 5 of the flags of the object.
 $8F73 CALL $724C               ; Play the explosion sound.
; This entry point is used by the routines at #R$9D0E and #R$A8F4.
@label=DamageShip_Hit
*$8F76 LD A,($896F)             ; Fetch the flag from #R$896F.
 $8F79 AND A                    ; Test it.
 $8F7A RET NZ                   ; Return if it is set.
 $8F7B LD A,($8F53)             ; Fetch the explosion counter from #R$8F53.
 $8F7E AND A                    ; Test it.
 $8F7F RET NZ                   ; Return if the ship is exploding.
 $8F80 CALL $724C               ; Play the explosion sound.
 $8F83 LD A,($8FC3)             ; Fetch the damage counter from #N$8FC3.
 $8F86 INC A                    ; {Add one and store it.
 $8F87 LD ($8FC3),A             ; }
 $8F8A PUSH BC                  ; Stash #REGbc on the stack.
 $8F8B LD B,$47                 ; Use bright white for the first hit...
 $8F8D AND A                    ; Test the counter.
 $8F8E JR Z,$8F98               ; Jump to #R$8F98 if it is zero.
 $8F90 LD B,$46                 ; Use bright yellow for the second hit...
 $8F92 CP $01                   ; {Jump to #R$8F98 if the counter is one.
 $8F94 JR Z,$8F98               ; }
 $8F96 LD B,$43                 ; Otherwise use bright magenta.
@label=DamageShip_Colour
*$8F98 CP $03                   ; {Jump to #R$8FA3 if the counter is not three.
 $8F9A JR NZ,$8FA3              ; }
 $8F9C LD A,$01                 ; {Set the explosion counter to one.
 $8F9E LD ($8F53),A             ; }
 $8FA1 LD B,$00                 ; Use black for the damage indicator.
@label=DamageShip_Indicator
*$8FA3 LD A,B                   ; {Store the attribute in the data at #R$8FBF.
 $8FA4 LD ($8FC1),A             ; }
 $8FA7 LD HL,$0F30              ; Set the position of the damage indicator.
 $8FAA LD A,($CA1C)             ; Fetch the flag from #R$CA1C.
 $8FAD AND A                    ; Test it.
 $8FAE JR Z,$8FB3               ; Jump to #R$8FB3 if it is zero.
 $8FB0 LD HL,$0FB0              ; Move the damage indicator.
@label=DamageShip_Draw
*$8FB3 LD DE,$8FBF              ; Use the data at #R$8FBF.
 $8FB6 CALL $C991               ; Draw the damage indicator.
 $8FB9 POP BC                   ; Bring #REGbc back off the stack.
 $8FBA RET                      ; Return.
 $8FBB DEFB $30,$0F,$B0,$0F     ;
@label=DamageShip_Attribute
 $8FBF DEFB $04,$02,$00,$C9,$00 ;

; Drain Fuel
;
; Used by the routine at #R$8E2D.
; .
; Takes fuel from the player's ship.
@label=DrainFuel
c$8FC4 LD DE,$E400   ; Set the change in fuel to #N$E400.
 $8FC7 JP $CC4D      ; Adjust the fuel.

; Bounce Ship
;
; Used by the routine at #R$8E2D.
; .
; Bounces the player's ship off an object, by exchanging half of the
; speed of each of them.
;
; IX Address of the object that was hit
; IY Address of the player's object
@label=BounceShip
c$8FCA LD D,(IY+$19) ; {Fetch the horizontal speed of the player into #REGde.
 $8FCD LD E,(IY+$1A) ; }
 $8FD0 LD H,(IX+$07) ; {Fetch the horizontal speed of the object into #REGhl.
 $8FD3 LD L,(IX+$08) ; }
 $8FD6 SRA H         ; {Halve it.
 $8FD8 RR L          ; }
 $8FDA CALL $BE08    ; Negate it.
 $8FDD LD (IX+$07),H ; {Store it as the new speed of the object.
 $8FE0 LD (IX+$08),L ; }
 $8FE3 ADD HL,DE     ; Add the speed of the player.
 $8FE4 LD (IY+$19),H ; {Store the result as the new speed of the player.
 $8FE7 LD (IY+$1A),L ; }
 $8FEA LD D,(IY+$1B) ; {Fetch the vertical speed of the player into #REGde.
 $8FED LD E,(IY+$1C) ; }
 $8FF0 LD H,(IX+$09) ; {Fetch the vertical speed of the object into #REGhl.
 $8FF3 LD L,(IX+$0A) ; }
 $8FF6 SRA H         ; {Halve it.
 $8FF8 RR L          ; }
 $8FFA CALL $BE08    ; Negate it.
 $8FFD LD (IX+$09),H ; {Store it as the new speed of the object.
 $9000 LD (IX+$0A),L ; }
 $9003 ADD HL,DE     ; Add the speed of the player.
 $9004 LD (IY+$1B),H ; {Store the result as the new speed of the player.
 $9007 LD (IY+$1C),L ; }
 $900A RET           ; Return.

; Destroy Object
;
; Used by the routine at #R$8E2D.
; .
; Marks an object as destroyed and plays a sound.
;
; IX Address of the object
@label=DestroyObject
c$900B SET 4,(IX+$10) ; Set bit 4 of the flags of the object.
 $900F PUSH BC        ; Stash #REGbc on the stack.
 $9010 CALL $7318     ; Play a sound.
 $9013 POP BC         ; Bring #REGbc back off the stack.
 $9014 RET            ; Return.

; Add Fuel
;
; Used by the routine at #R$8E2D.
; .
; Gives fuel to the player's ship.
@label=AddFuel
c$9015 PUSH BC       ; Stash #REGbc on the stack.
 $9016 CALL $724C    ; Play the explosion sound.
 $9019 POP BC        ; Bring #REGbc back off the stack.
 $901A LD DE,$1000   ; Set the change in fuel to #N$1000.
 $901D JP $CC4D      ; Adjust the fuel.

; Add Ship
;
; Used by the routine at #R$8E2D.
; .
; Gives the player an extra ship, up to a maximum of ten.
@label=AddShip
c$9020 LD A,($F5ED)  ; Fetch the number of ships from #R$F5ED.
 $9023 INC A         ; Add one.
 $9024 CP $0A        ; Is it ten?
 $9026 RET Z         ; Return if so.
 $9027 LD ($F5ED),A  ; Store the new number of ships.
 $902A CALL $724C    ; Play the explosion sound.
 $902D JP $CA31      ; Show the number of ships.

; Mark Object Hit
;
; Used by the routine at #R$8E2D.
; .
; Sets bit 5 of the flags of an object.
;
; IX Address of the object
@label=MarkObjectHit
c$9030 SET 5,(IX+$10) ; Set bit 5 of the flags of the object.
 $9034 RET            ; Return.

; Explode Hit Object
;
; Used by the routines at #R$9494 and #R$9507.
; .
; If bit 5 of the flags of an object is set, scores the points for it.
;
; IX Address of the object
@label=ExplodeHitObject
c$9035 BIT 5,(IX+$10) ; Test bit 5 of the flags of the object.
 $9039 RET Z          ; Return if it is clear.
 $903A CALL $9234     ; Score the points for the object.
; Continue on to #R$903D.

; Start Explosion
;
; Used by the routine at #R$8CB2.
; .
; Turns an object into an explosion (type #N$15).
;
; IX Address of the object
@label=StartExplosion
c$903D LD (IX+$00),$15 ; Set the type of the object to #N$15.
 $9041 LD (IX+$13),$50 ; Set its first state byte to #N$50.
 $9045 LD (IX+$14),$05 ; Set its second state byte to #N$05.
 $9049 LD A,($9BCC)    ; Fetch the second byte of the random seed.
 $904C AND %00000011   ; Keep two bits.
 $904E RRCA            ; {Rotate them into the top of the byte.
 $904F RRCA            ; }
 $9050 LD (IX+$15),A   ; Set the lifetime of the object.
 $9053 OR %00000001    ; Set bit 0 and return.
 $9055 RET             ; Return.

; Nudge Object
;
; Used by the routines at #R$909A, #R$90A7 and #R$B6EC.
; .
; Moves an object by a small fixed amount in two steps, by temporarily
; replacing its speeds and calling #R$BF66. Purpose of the call to #R$BA21
; in between not yet known.
;
; IX Address of the object
@label=NudgeObject
c$9056 LD A,$04        ; Set the displacement to four.
 $9058 PUSH BC         ; Stash #REGbc on the stack.
 $9059 CALL $9062      ; Move the object.
 $905C POP BC          ; Bring #REGbc back off the stack.
 $905D CALL $BA21      ; Call #R$BA21.
 $9060 LD A,$FC        ; Set the displacement to #N($FC).
@label=NudgeObject_Step
*$9062 LD H,(IX+$07)   ; {Save the horizontal speed of the object in #R$DEDC.
 $9065 LD L,(IX+$08)   ;
 $9068 LD ($DEDC),HL   ; }
 $906B LD H,(IX+$09)   ; {Save the vertical speed of the object in #R$DEDE.
 $906E LD L,(IX+$0A)   ;
 $9071 LD ($DEDE),HL   ; }
 $9074 LD (IX+$09),A   ; Set the vertical speed to the displacement.
 $9077 LD (IX+$0A),$00 ; Clear the low byte of the vertical speed.
 $907B NEG             ; Negate the displacement.
 $907D LD (IX+$07),A   ; Set the horizontal speed to the displacement.
 $9080 LD (IX+$08),$00 ; Clear the low byte of the horizontal speed.
 $9084 CALL $BF66      ; Update the position of the object.
 $9087 LD HL,($DEDC)   ; {Restore the horizontal speed of the object.
 $908A LD (IX+$07),H   ;
 $908D LD (IX+$08),L   ; }
 $9090 LD HL,($DEDE)   ; {Restore the vertical speed of the object.
 $9093 LD (IX+$09),H   ;
 $9096 LD (IX+$0A),L   ; }
 $9099 RET             ; Return.

; Move Object Back And Forth
;
; Used by the routines at #R$938D and #R$9507.
; .
; Clears the byte at #R$5C25 and nudges the object, then reverses its
; speeds and updates its position. Purpose not yet known.
;
; IX Address of the object
@label=MoveObjectBackAndForth
c$909A XOR A         ; {Clear #R$5C25.
 $909B LD ($5C25),A  ; }
 $909E CALL $9056    ; Nudge the object.
 $90A1 CALL $90CD    ; Reverse the speeds of the object.
 $90A4 JP $BF66      ; Jump to #R$BF66.

; Move Object And Stop
;
; Used by the routines at #R$9457 and #R$9494.
; .
; Sets #R$5C25 to #N$80 and nudges the object. When the value in #R$5C1C
; is not zero, the object is also marked, stopped and a sound is played.
;
; IX Address of the object
@label=MoveObjectAndStop
c$90A7 LD A,$80       ; {Set #R$5C25 to #N$80.
 $90A9 LD ($5C25),A   ; }
 $90AC CALL $9056     ; Nudge the object.
 $90AF LD A,($5C1C)   ; Fetch the value from #R$5C1C.
 $90B2 AND A          ; Test it.
 $90B3 JP Z,$BF66     ; Jump to #R$BF66 if it is zero.
 $90B6 SET 3,(IX+$17) ; Set bit 3 of the second set of flags of the object.
 $90BA XOR A          ; {Clear the speeds of the object.
 $90BB LD (IX+$07),A  ;
 $90BE LD (IX+$08),A  ;
 $90C1 LD (IX+$09),A  ;
 $90C4 LD (IX+$0A),A  ; }
 $90C7 CALL $72A5     ; Play a sound.
 $90CA JP $BF66       ; Jump to #R$BF66.

; Reverse Object Speed
;
; Used by the routines at #R$909A and #R$BE8F.
; .
; Negates both speeds of an object.
;
; IX Address of the object
@label=ReverseObjectSpeed
c$90CD LD H,(IX+$07) ; {Fetch the horizontal speed into #REGhl.
 $90D0 LD L,(IX+$08) ; }
 $90D3 CALL $BE08    ; Negate it.
 $90D6 LD (IX+$07),H ; {Store the new horizontal speed.
 $90D9 LD (IX+$08),L ; }
 $90DC LD H,(IX+$09) ; {Fetch the vertical speed into #REGhl.
 $90DF LD L,(IX+$0A) ; }
 $90E2 CALL $BE08    ; Negate it.
 $90E5 LD (IX+$09),H ; {Store the new vertical speed.
 $90E8 LD (IX+$0A),L ; }
 $90EB RET           ; Return.

; Process Object Flags
;
; Used by the routines at #R$9507, #R$9524 and #R$9572.
; .
; Remembers the address of the object in #R$AD46. If bit 4 of its flags
; is set the object is removed. Otherwise, bit 3 of the flags is cleared and,
; if it had been set, the routine returns; if not, the object is drawn and
; made to accelerate towards the player.
;
; IX Address of the object
@label=ProcessObjectFlags
c$90EC LD ($AD46),IX   ; Store the address of the object in #R$AD46.
 $90F0 BIT 4,(IX+$10)  ; {Jump to #R$90FB if bit 4 of the flags of the object
 $90F4 JR Z,$90FB      ; is clear.}
 $90F6 LD (IX+$00),$FF ; Free the slot.
 $90FA RET             ; Return.
@label=ProcessObjectFlags_Bit3
*$90FB BIT 3,(IX+$10)  ; Test bit 3 of the flags of the object.
 $90FF RES 3,(IX+$10)  ; Clear bit 3.
 $9103 RET NZ          ; Return if it was set.
 $9104 CALL $AD48      ; Draw the object.
 $9107 JP $8C58        ; Make the object accelerate towards the player.

; Step Object State
;
; Used by the routines at #R$9457, #R$9494, #R$9507 and #R$AC60.
; .
; Steps through a sequence held in the two state bytes of an object. If
; bits 4 and 5 of the first state byte are equal to one, the bottom four bits
; of the first state byte count up and wrap round when they reach the value in
; the bottom four bits of the second state byte. Otherwise, bits 4 and 5 of the
; first state byte are adjusted. Purpose not yet known.
;
; IX Address of the object
@label=StepObjectState
c$910A LD A,(IX+$13) ; {Fetch the first state byte and keep a copy in #REGb.
 $910D LD B,A        ; }
 $910E AND %00110000 ; Only bits 4 and 5.
 $9110 SUB $10       ; Subtract #N$10.
 $9112 LD D,A        ; Keep the result in #REGd.
 $9113 JR NZ,$913B   ; Jump to #R$913B if bits 4 and 5 were not equal to one.
 $9115 LD A,B        ; Fetch the first state byte again.
 $9116 AND %00001111 ; Keep the bottom four bits.
 $9118 INC A         ; Add one.
 $9119 LD E,A        ; Keep it in #REGe.
 $911A LD A,(IX+$14) ; Fetch the second state byte.
 $911D AND %00001111 ; Keep the bottom four bits.
 $911F INC A         ; Add one.
 $9120 CP E          ; Compare it with the first.
 $9121 JR NZ,$912E   ; Jump to #R$912E if they are not the same.
 $9123 LD E,(IX+$14) ; Fetch the second state byte.
 $9126 SRL E         ; {Shift the top four bits into the bottom four bits to use as the new
 $9128 SRL E         ; count.
 $912A SRL E         ;
 $912C SRL E         ; }
@label=StepObjectState_Store
*$912E LD A,B        ; Fetch the first state byte.
 $912F AND %11110000 ; Keep the top four bits.
 $9131 OR E          ; Combine them with the new count.
 $9132 LD B,A        ; Keep the result in #REGb.
 $9133 LD A,B        ; Copy it into #REGa.
 $9134 AND %11000000 ; Only bits 6 and 7.
 $9136 SRL A         ; {Shift them right twice.
 $9138 SRL A         ; }
 $913A LD D,A        ; Keep the result in #REGd.
@label=StepObjectState_Finish
*$913B LD A,B        ; Fetch the first state byte.
 $913C AND %11001111 ; Clear bits 4 and 5.
 $913E OR D          ; Combine them with the new bits.
 $913F LD (IX+$13),A ; Store it.
 $9142 RET           ; Return.

; Find Hit Position
;
; Used by the routines at #R$8D42 and #R$ABA8.
; .
; Works out the screen position of the object that was hit, and sets up
; the hit data used by #R$917C. Does nothing if the collision flag at #R$A1D8
; is clear.
@label=FindHitPosition
c$9143 LD IY,($AD46) ; Fetch the address of the object from #R$AD46.
 $9147 LD L,(IY+$11) ; {Fetch its screen position into #REGhl.
 $914A LD H,(IY+$12) ; }
 $914D LD A,($5C29)  ; {Fetch the value from #R$5C29 into #REGe.
 $9150 LD E,A        ; }
 $9151 LD A,($A1D8)  ; {Fetch the collision flag from #R$A1D8 into #REGd.
 $9154 LD D,A        ; }
 $9155 LD A,D        ; Copy it into #REGa.
 $9156 DEC A         ; Subtract one.
 $9157 RET M         ; Return if it was zero.
 $9158 LD A,($A2FA)  ; Fetch the flag from #R$A2FA.
 $915B AND A         ; Test it.
 $915C LD A,L        ; Fetch the horizontal screen position.
 $915D JR Z,$9166    ; Jump to #R$9166 if the flag is clear.
 $915F ADD A,E       ; Add the value from #REGe.
 $9160 LD L,$08      ; Set the horizontal screen position to #N$08.
 $9162 SUB L         ; Subtract it.
 $9163 LD E,A        ; Keep the result in #REGe.
 $9164 JR $916F      ; Jump to #R$916F.
@label=FindHitPosition_Clear
*$9166 ADD A,$17     ; Add #N$17 to the horizontal screen position.
 $9168 ADD A,E       ; Add the value from #REGe.
 $9169 JR NC,$916F   ; Jump to #R$916F if there is no carry.
 $916B LD A,$EE      ; Otherwise use #N$EE...
 $916D SUB L         ; ...less the horizontal screen position.
 $916E LD E,A        ; Keep the result in #REGe.
@label=FindHitPosition_Store
*$916F LD ($ABA4),HL ; Store the position in #R$ABA4.
 $9172 LD ($ABA6),DE ; Store the size in #N$ABA6.
 $9176 LD A,H        ; Fetch the vertical screen position.
 $9177 SUB D         ; Subtract the collision flag.
 $9178 LD ($5C1E),A  ; Store the result in #R$5C1E.
 $917B RET           ; Return.

; Check Shot Collisions
;
; Used by the routine at #R$8D42.
; .
; Checks whether any of the four objects at #R$B37A has hit the object
; described by the hit data at #R$ABA4. If one has, bit 7 of its flags is set
; and effects are applied to the object that was hit.
;
; D Collision flag from #R$A1D8
; IX Address of the object that was hit
@label=CheckShotCollisions
c$917C LD A,D         ; Fetch the collision flag.
 $917D DEC A          ; Subtract one.
 $917E RET M          ; Return if it was zero.
 $917F PUSH IX        ; Save the address of the object.
 $9181 LD IX,$ABA4    ; Use the hit data at #R$ABA4.
 $9185 LD A,$04       ; Set the counter for four objects.
 $9187 LD IY,$B37A    ; Use the first object.
; This entry point is used by the routine at #R$AC29.
@label=CheckShotCollisions_Loop
*$918B EX AF,AF'      ; Save the counter.
 $918C BIT 7,(IY+$16) ; {Jump to #R$919B if bit 7 of the second set of flags of the object
 $9190 JR NZ,$919B    ; is set.}
 $9192 LD L,(IY+$0B)  ; Fetch the first value of the object.
 $9195 LD A,L         ; Test it.
 $9196 AND A          ; {Jump to #R$91E3 if it is zero.
 $9197 JR Z,$91E3     ; }
 $9199 JR $91A9       ; Jump to #R$91A9.
@label=CheckShotCollisions_Position
*$919B BIT 7,(IY+$10) ; {Jump to #R$91E3 if bit 7 of the flags of the object is
 $919F JR Z,$91E3     ; clear.}
 $91A1 LD L,(IY+$11)  ; {Fetch the screen position of the object.
 $91A4 LD H,(IY+$12)  ; }
 $91A7 JR $91B3       ; Jump to #R$91B3.
@label=CheckShotCollisions_Offset
*$91A9 LD H,(IY+$0C)  ; Fetch the value from the object.
 $91AC INC H          ; Add one.
 $91AD BIT 7,(IY+$15) ; {Jump to #R$91C7 if bit 7 of the third set of flags of the object is
 $91B1 JR NZ,$91C7    ; set.}
@label=CheckShotCollisions_Range
*$91B3 LD A,($5C1E)   ; Fetch the value from #R$5C1E.
 $91B6 INC H          ; Add one to the vertical position.
 $91B7 CP H           ; Compare it with the vertical position.
 $91B8 JR NC,$91E3    ; Jump to #R$91E3 if it is lower.
 $91BA DEC H          ; Subtract one again.
 $91BB LD A,(IX+$01)  ; Fetch the vertical position of the hit data.
 $91BE ADD A,$03      ; Add three.
 $91C0 CP H           ; Compare it with the vertical position.
 $91C1 JR C,$91E3     ; Jump to #R$91E3 if it is lower.
 $91C3 LD E,$05       ; Set the width to five.
 $91C5 JR $91C9       ; Jump to #R$91C9.
@label=CheckShotCollisions_Wide
*$91C7 LD E,$08       ; Set the width to eight.
@label=CheckShotCollisions_Height
*$91C9 LD D,$08       ; Set the height to eight.
 $91CB BIT 7,(IY+$16) ; {Jump to #R$91DA if bit 7 of the third set of flags of the object is
 $91CF JR NZ,$91DA    ; set.}
 $91D1 LD A,(IY+$0E)  ; Fetch the value from the object.
 $91D4 ADD A,A        ; {Multiply it by eight.
 $91D5 ADD A,A        ;
 $91D6 ADD A,A        ; }
 $91D7 JR Z,$91E3     ; Jump to #R$91E3 if it is zero.
 $91D9 LD D,A         ; Use it as the height.
@label=CheckShotCollisions_Check
*$91DA CALL $9DB1     ; Check for a collision.
 $91DD LD A,($5C1C)   ; Fetch the value from #R$5C1C.
 $91E0 AND A          ; Test it.
 $91E1 JR NZ,$91EF    ; Jump to #R$91EF if there has been a collision.
@label=CheckShotCollisions_Next
*$91E3 LD BC,$0018    ; Set the length of an object.
 $91E6 ADD IY,BC      ; Move on to the next object.
 $91E8 EX AF,AF'      ; Restore the counter.
 $91E9 DEC A          ; Decrease the counter by one...
 $91EA JR NZ,$918B    ; ...and loop back to #R$918B until none remain.
 $91EC POP IX         ; Restore the address of the object.
 $91EE RET            ; Return.
@label=CheckShotCollisions_Hit
*$91EF POP IX         ; Restore the address of the object.
 $91F1 BIT 7,(IY+$16) ; {Jump to #R$920B if bit 7 of the third set of flags of the shot is
 $91F5 JR Z,$920B     ; clear.}
 $91F7 SET 4,(IY+$10) ; Set bit 4 of the flags of the shot.
 $91FB LD A,(IX+$00)  ; Fetch the type of the object that was hit.
 $91FE CP $19         ; {Jump to #R$920B if it is not #N$19.
 $9200 JR NZ,$920B    ; }
 $9202 INC (IX+$16)   ; Add one to the third state byte of the object.
 $9205 CALL $724C     ; Play the explosion sound.
 $9208 CALL $9234     ; Score the points for the object.
@label=CheckShotCollisions_Mark
*$920B SET 7,(IY+$10) ; Set bit 7 of the flags of the shot.
 $920F SET 5,(IX+$10) ; Set bit 5 of the flags of the object that was hit.
 $9213 BIT 7,(IY+$15) ; Test bit 7 of the second value of the shot.
 $9217 RET Z          ; Return if it is clear.
 $9218 SET 3,(IX+$17) ; Set bit 3 of the second set of flags of the object.
 $921C RES 5,(IX+$10) ; Clear bit 5 of its flags.
 $9220 LD A,(IX+$00)  ; Fetch the type of the object.
 $9223 CP $19         ; {Jump to #R$9234 if it is not #N$19.
 $9225 JR NZ,$9234    ; }
 $9227 LD A,(IX+$0D)  ; Fetch the attribute of the object.
 $922A INC A          ; Increment it.
 $922B RET NZ         ; Return if it was not #N($FF).
 $922C CALL $9234     ; Score the points for the object.
 $922F LD A,R         ; Fetch a pseudo-random value from the refresh register.
 $9231 JP $A8AA       ; Jump to #R$A8AA.

; Score Destroyed Object
;
; Used by the routines at #R$9035, #R$917C and #R$94A8.
; .
; Adds the points for an object to the score of player one. The points
; come from the table at #R$929C, indexed by the type of the object. Objects
; of type #N$0D and #N$1B are worth #N$0250 points. The points are doubled
; if bit 3 of the second flags of the object is set.
;
; IX Address of the object
@label=ScoreDestroyedObject
c$9234 LD A,(IX+$00)  ; Fetch the type of the object.
 $9237 CP $0D         ; {Jump to #R$923F if it is #N$0D.
 $9239 JR Z,$923F     ; }
 $923B CP $1B         ; {Jump to #R$9244 if it is not #N$1B.
 $923D JR NZ,$9244    ; }
@label=ScoreDestroyedObject_Fixed
*$923F LD BC,$0250    ; Set the points to #N$0250.
 $9242 JR $925E       ; Jump to #R$925E.
@label=ScoreDestroyedObject_Table
*$9244 SUB $13        ; Subtract #N$13 from the type.
 $9246 ADD A,A        ; Double it.
 $9247 LD HL,$929C    ; Use the table at #R$929C.
 $924A CALL $9BCF     ; Add the offset to the address.
 $924D LD B,(HL)      ; {Fetch the points into #REGbc.
 $924E INC HL         ;
 $924F LD C,(HL)      ; }
 $9250 BIT 3,(IX+$17) ; {Jump to #R$925E if bit 3 of the second set of flags is
 $9254 JR Z,$925E     ; clear.}
 $9256 LD A,C         ; {Double the points.
 $9257 ADD A,A        ;
 $9258 DAA            ;
 $9259 LD C,A         ;
 $925A LD A,B         ;
 $925B ADC A,B        ;
 $925C DAA            ; }
 $925D LD B,A         ; Keep the result in #REGb.
; Continue on to #R$925E.

; Add To Score
;
; Used by the routines at #R$83D6, #R$9234, #R$9524 and #R$AAD7.
; .
; Adds points to the score of player one and prints the new score. The
; score is held as three bytes of binary coded decimal at #R$F5E7.
;
; BC Points (binary coded decimal)
@label=AddToScore
c$925E LD HL,$F5E7   ; Use the score.
 $9261 LD A,C        ; {Add the low byte of the points.
 $9262 ADD A,(HL)    ; }
 $9263 DAA           ; Adjust for decimal.
 $9264 LD (HL),A     ; Store the result.
 $9265 INC HL        ; Move on to the next byte.
 $9266 LD A,B        ; {Add the middle byte of the points.
 $9267 ADC A,(HL)    ; }
 $9268 DAA           ; Adjust for decimal.
 $9269 LD (HL),A     ; Store the result.
 $926A INC HL        ; Move on to the last byte.
 $926B LD A,$00      ; {Add the carry.
 $926D ADC A,(HL)    ; }
 $926E DAA           ; Adjust for decimal.
 $926F LD (HL),A     ; Store the result.
 $9270 LD DE,$C9F0   ; Use the text record for the score at #R$C9EC.
 $9273 LD B,$03      ; Set a counter for three bytes.
@label=AddToScore_Digits
*$9275 LD A,(HL)     ; Fetch a byte of the score.
 $9276 RRCA          ; {Shift the top four bits into the bottom four.
 $9277 RRCA          ;
 $9278 RRCA          ;
 $9279 RRCA          ; }
 $927A AND %00001111 ; Keep them.
 $927C ADD A,$1A     ; Add #N$1A to make the character code of the digit.
 $927E LD (DE),A     ; {Store it in the text record.
 $927F INC DE        ; }
 $9280 LD A,(HL)     ; Fetch the byte of the score again.
 $9281 AND %00001111 ; Keep the bottom four bits.
 $9283 ADD A,$1A     ; Add #N$1A to make the character code of the digit.
 $9285 LD (DE),A     ; {Store it in the text record.
 $9286 INC DE        ; }
 $9287 DEC HL        ; Move back to the previous byte of the score.
 $9288 DJNZ $9275    ; Decrease the counter by one and loop back to #R$9275 until none
                     ; remain.
 $928A LD DE,$C9EC   ; Use the text record.
 $928D EXX           ; Switch registers.
 $928E PUSH HL       ; {Save the registers.
 $928F PUSH DE       ;
 $9290 PUSH BC       ; }
 $9291 LD DE,$C9EC   ; Use the text record.
 $9294 CALL $A115    ; Print the score.
 $9297 POP BC        ; {Restore the registers.
 $9298 POP DE        ;
 $9299 POP HL        ; }
 $929A EXX           ; Switch registers back.
 $929B RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$A19C }
; { #BUBBLER$9662 }
; { #COOKIE$7415 }
; { #JETPAC$70F9 }
; { #LUNARJETMAN$899C }
; { #MARTIANOIDS$B573 }
; { #NIGHTSHADE$C2ED }
; { #PENTAGRAM$BB29 }
; { #PSSST$737A }
; { #SABREWULF$B5A9 }
; { #TRANZAM$6046 }
; { #UNDERWURLDE$A045 }
; LIST#

; Points Table
;
; The points for each type of object from #N($13) to #N($1E), as two
; bytes of binary coded decimal.
@label=PointsTable
b$929C DEFB $00,$00
 $929E DEFB $02,$50
 $92A0 DEFB $00,$00
 $92A2 DEFB $02,$00
 $92A4 DEFB $01,$50
 $92A6 DEFB $01,$00
 $92A8 DEFB $00,$75
 $92AA DEFB $00,$90
 $92AC DEFB $00,$00
 $92AE DEFB $00,$00
 $92B0 DEFB $03,$50
 $92B2 DEFB $00,$00

; Choose Target
;
; Used by the routine at #R$9307.
; .
; Looks through the first seven enemy slots for the active object with
; the highest priority and stores the number of its slot in the top four bits
; of the second set of flags of the object in #REGix. The priority of each
; type of object comes from the table at #R$92EE.
;
; IX Address of the object that is choosing
@label=ChooseTarget
c$92B4 LD IY,$9974    ; Use the first enemy slot.
 $92B8 LD B,$07       ; Set a counter for seven slots.
 $92BA XOR A          ; {Clear the highest priority so far.
 $92BB LD ($5C1C),A   ; }
@label=ChooseTarget_Loop
*$92BE BIT 7,(IY+$10) ; {Jump to #R$92E6 if bit 7 of the flags of the object in the slot is
 $92C2 JR Z,$92E6     ; clear.}
 $92C4 LD A,(IY+$00)  ; Fetch the type of the object.
 $92C7 INC A          ; Increment it.
 $92C8 JR Z,$92E6     ; Jump to #R$92E6 if the slot is free.
 $92CA SUB $14        ; Subtract #N($14), which leaves the type minus #N($13) as the type
                      ; has been incremented.
 $92CC LD HL,$92EE    ; Use the table at #R$92EE.
 $92CF CALL $9BCF     ; Add the offset to the address.
 $92D2 LD A,($5C1C)   ; Fetch the highest priority so far from #R$5C1C.
 $92D5 CP (HL)        ; Compare it with the priority of this type.
 $92D6 JR NC,$92E6    ; Jump to #R$92E6 if it is not lower.
 $92D8 LD A,(HL)      ; Fetch the priority of this type.
 $92D9 LD ($5C1C),A   ; Make it the highest priority so far.
 $92DC LD A,B         ; Fetch the slot counter.
 $92DD XOR %00000111  ; Turn it into the number of the slot.
 $92DF ADD A,A        ; {Shift the number into the top four bits.
 $92E0 ADD A,A        ;
 $92E1 ADD A,A        ;
 $92E2 ADD A,A        ; }
 $92E3 LD (IX+$17),A  ; Store it in the second set of flags of the object.
@label=ChooseTarget_Next
*$92E6 LD DE,$0018    ; Set the length of a slot.
 $92E9 ADD IY,DE      ; Move on to the next slot.
 $92EB DJNZ $92BE     ; Decrease the slot counter by one and loop back to #R$92BE until none
                      ; remain.
 $92ED RET            ; Return.

; Target Priorities
;
; The priority of each type of object for #R$92B4, starting at type
; #N$13.
@label=TargetPriorities
b$92EE DEFB $00,$08,$00,$07,$06,$05,$02,$04,$00,$00,$09,$00

; Set Facing
;
; Used by the routines at #R$938D and #R$94A8.
; .
; Sets the first state byte of an object to zero, or one if the object is
; moving left.
;
; IX Address of the object
@label=SetFacing
c$92FA LD (IX+$13),$00 ; Clear the first state byte.
 $92FE BIT 7,(IX+$07)  ; Test bit 7 of the horizontal speed.
 $9302 RET Z           ; Return if it is clear.
 $9303 INC (IX+$13)    ; Set the first state byte to one.
 $9306 RET             ; Return.

; Update Chasing Object
;
; Used by the routine at #R$B706.
; .
; Moves an object that is chasing one of the enemies. The slot number of
; the target is held in the top four bits of the second set of flags; when all
; four are set, a new target is chosen with #R$92B4.
;
; IX Address of the object
@label=UpdateChasingObject
c$9307 LD A,(IX+$17)   ; Fetch the second set of flags.
 $930A AND %11110000   ; Keep the top four bits.
 $930C CP $F0          ; Are all of them set?
 $930E CALL Z,$92B4    ; Choose a target if so.
 $9311 LD A,(IX+$17)   ; Fetch the second set of flags again.
 $9314 AND %11110000   ; Keep the top four bits.
 $9316 CP $F0          ; {Jump to #R$938D if all of them set are.
 $9318 JP Z,$938D      ; }
 $931B RLCA            ; {Shift the slot number into the bottom four bits.
 $931C RLCA            ;
 $931D RLCA            ;
 $931E RLCA            ; }
 $931F LD B,A          ; Keep it in #REGb.
 $9320 LD DE,$0018     ; Set the length of a slot.
 $9323 LD IY,$9974     ; Use the first enemy slot.
 $9327 AND A           ; Test the slot number.
 $9328 JR Z,$932E      ; Jump to #R$932E if it is zero.
@label=UpdateChasingObject_Find
*$932A ADD IY,DE       ; Move on to the next slot.
 $932C DJNZ $932A      ; Decrease the slot number by one and loop back to #R$932A until none
                       ; remain.
@label=UpdateChasingObject_Target
*$932E LD A,(IY+$00)   ; Fetch the type of the object in the target slot.
 $9331 INC A           ; Increment it.
 $9332 JR NZ,$933B     ; Jump to #R$933B if the slot is in use.
 $9334 LD (IX+$17),$F0 ; Otherwise forget the target.
 $9338 JP $938D        ; Jump to #R$938D.
@label=UpdateChasingObject_Chase
*$933B CALL $9341      ; Set the acceleration towards the target.
 $933E JP $938D        ; Jump to #R$938D.

; Accelerate Towards Target
;
; Used by the routines at #R$9307, #R$97FF and #R$9837.
; .
; Sets the acceleration of an object so that it heads towards another
; object.
;
; IX Address of the object that is moving
; IY Address of the object that is the target
@label=AccelerateTowardsTarget
c$9341 LD (IX+$0B),$00 ; {Set the horizontal acceleration to #N$00C0.
 $9345 LD (IX+$0C),$C0 ; }
 $9349 LD A,(IX+$01)   ; Fetch the map column of the object.
 $934C CP (IY+$01)     ; Compare it with the map column of the target.
 $934F JR NZ,$935B     ; Jump to #R$935B if they are different.
 $9351 LD A,(IX+$02)   ; Fetch the horizontal position of the object.
 $9354 CP (IY+$02)     ; Compare it with the horizontal position of the target.
 $9357 JR NC,$9365     ; Jump to #R$9365 if it is not lower.
 $9359 JR $936D        ; Jump to #R$936D.
@label=AccelerateTowardsTarget_Column
*$935B LD A,($DDF7)    ; Fetch the column from #R$DDF7.
 $935E CP (IX+$01)     ; Compare it with the map column of the object.
 $9361 JR Z,$9365      ; Jump to #R$9365 if they are the same.
 $9363 JR $936D        ; Jump to #R$936D.
@label=AccelerateTowardsTarget_Left
*$9365 LD (IX+$0B),$FF ; {Set the horizontal acceleration to #N$FF40.
 $9369 LD (IX+$0C),$40 ; }
@label=AccelerateTowardsTarget_Vertical
*$936D LD H,(IX+$04)   ; {Fetch the map zone and vertical position of the
 $9370 LD L,(IX+$05)   ; object into #REGhl.}
 $9373 LD D,(IY+$04)   ; {Fetch the map zone and vertical position of the
 $9376 LD E,(IY+$05)   ; target into #REGde.}
 $9379 SBC HL,DE       ; Subtract them.
 $937B LD (IX+$0E),$00 ; {Set the vertical acceleration to #N$00C0.
 $937F LD (IX+$0F),$C0 ; }
 $9383 RET C           ; Return if the target is lower.
 $9384 LD (IX+$0E),$FF ; {Otherwise set the vertical acceleration to #N$FF40.
 $9388 LD (IX+$0F),$40 ; }
 $938C RET             ; Return.

; Update Object
;
; Used by the routine at #R$9307.
; .
; Part of #R$9307. Redraws the object, moves it, counts down its
; lifetime and gives it a position.
;
; IX Address of the object
@label=UpdateObject
c$938D CALL $A2EA      ; Reset the collision state.
 $9390 BIT 7,(IX+$10)  ; Test bit 7 of the flags of the object.
 $9394 CALL NZ,$AD27   ; Call #R$AD27 if it is set.
 $9397 RES 6,(IX+$10)  ; Clear bit 6 of the flags of the object.
 $939B EXX             ; Switch registers.
 $939C CALL $8C05      ; Move the object.
 $939F CALL $92FA      ; Set the facing of the object.
 $93A2 DEC (IX+$15)    ; Count down the lifetime of the object.
 $93A5 JR NZ,$93AE     ; Jump to #R$93AE if it has not run out.
@label=UpdateObject_Remove
*$93A7 LD (IX+$00),$FF ; Free the slot.
 $93AB JP $93EC        ; Jump to #R$93EC.
@label=UpdateObject_Flags
*$93AE BIT 4,(IX+$10)  ; {Jump to #R$93A7 if bit 4 of the flags of the object
 $93B2 JR NZ,$93A7     ; is set.}
 $93B4 LD BC,$0B10     ; #REGbc=#N$0B10.
 $93B7 CALL $909A      ; Nudge the object and reverse its speeds.
 $93BA LD HL,($CE57)   ; Fetch the map position from #R$CE57.
 $93BD LD B,$00        ; Clear #REGb.
 $93BF LD A,L          ; Fetch the map column.
 $93C0 CP (IX+$01)     ; Compare it with the map column of the object.
 $93C3 JR Z,$93C7      ; Jump to #R$93C7 if they are the same.
 $93C5 INC B           ; {Add two to #REGb.
 $93C6 INC B           ; }
@label=UpdateObject_Zone
*$93C7 LD A,H          ; Fetch the map zone.
 $93C8 CP (IX+$04)     ; Compare it with the map zone of the object.
 $93CB JR Z,$93CE      ; Jump to #R$93CE if they are the same.
 $93CD INC B           ; Add one to #REGb.
@label=UpdateObject_Table
*$93CE LD A,B          ; #REGa=#REGb.
 $93CF LD HL,$DC91     ; Use the table at #R$DC91.
 $93D2 CALL $9BCF      ; Add the offset to the address.
 $93D5 LD A,(HL)       ; Fetch the entry.
 $93D6 CP $3E          ; {Jump to #R$93E9 if it is not #N$3E.
 $93D8 JR NZ,$93E9     ; }
 $93DA LD A,(IX+$02)   ; Fetch the horizontal position of the object.
 $93DD CP $18          ; {Jump to #R$93E9 if it is lower than #N$18.
 $93DF JR C,$93E9      ; }
 $93E1 CP $D8          ; {Jump to #R$93E9 if it is #N$D8 or higher.
 $93E3 JR NC,$93E9     ; }
 $93E5 LD (IX+$05),$6A ; Set the vertical position of the object to #N$6A.
@label=UpdateObject_Draw
*$93E9 CALL $AD48      ; Draw the object.
@label=UpdateObject_Finish
*$93EC CALL $AD1B      ; Call #R$AD1B.
 $93EF JP $AE98        ; Jump to #R$AE98.

; Update Type 13 Object
;
; The code for an object of type #N($13), which is run by
; #R$A18D.
;
; IX Address of the object
@label=UpdateType13
c$93F2 LD A,$80                                         ; {Set the collision
 $93F4 LD ($8E2C),A                                     ; effects in #R$8E2C to
                                                        ; #N$80.}
 $93F7 LD A,(IX+$04)                                    ; Fetch the map zone of
                                                        ; the object.
 $93FA CP $0A                                           ; {Jump to #R$940B if
 $93FC JR NZ,$940B                                      ; it is not #N$0A.}
 $93FE LD A,(IX+$05)                                    ; Fetch the vertical
                                                        ; position of the
                                                        ; object.
 $9401 CP $A0                                           ; {Jump to #R$9413 if
 $9403 JR C,$9413                                       ; it is lower than
                                                        ; #N$A0.}
 $9405 SET 3,(IX+$17)                                   ; Set bit 3 of the
                                                        ; second set of flags
                                                        ; of the object.
 $9409 JR $9413                                         ; Jump to #R$9413.
@label=UpdateType13_Zone3
*$940B CP $03                                           ; {Jump to #R$9413 if
 $940D JR NZ,$9413                                      ; the map is not zone
                                                        ; #N$03.}
 $940F SET 3,(IX+$17)                                   ; Set bit 3 of the
                                                        ; second set of flags
                                                        ; of the object.
@label=UpdateType13_Move
*$9413 LD A,$03                                         ; {Set #R$5C1C to
 $9415 LD ($5C1C),A                                     ; #N$03.}
 $9418 LD A,(IX+$0D)                                    ; Fetch the attribute
                                                        ; of the object.
 $941B CP $77                                           ; Is it #N$77?
 $941D PUSH IY                                          ; Stash #REGiy on the
                                                        ; stack.
 $941F CALL Z,$8813                                     ; Fire a random shot if
                                                        ; so.
 $9422 POP IY                                           ; Bring #REGiy back off
                                                        ; the stack.
 $9424 LD A,(IX+$10)                                    ; Fetch the flags of
                                                        ; the object.
 $9427 AND %00000011                                    ; Keep the bottom two
                                                        ; bits.
 $9429 CP $03                                           ; {Jump to #R$9435 if
 $942B JR NZ,$9435                                      ; they are not both
                                                        ; set.}
 $942D LD (IX+$0E),$00                                  ; {Clear the vertical
 $9431 LD (IX+$0F),$00                                  ; acceleration of the
                                                        ; object.}
@label=UpdateType13_Accelerate
*$9435 CALL $8C05                                       ; Move the object.
 $9438 LD BC,$2030                                      ; #REGbc=#N$2030.
 $943B LD A,(IX+$13)                                    ; Fetch the first state
                                                        ; byte of the object.
 $943E AND A                                            ; Test it.
 $943F JP Z,$9518                                       ; Jump to #R$9518 if it
                                                        ; is zero.
 $9442 LD A,($8E2B)                                     ; Fetch the number of
                                                        ; active enemies from
                                                        ; #R$8E2B.
 $9445 INC A                                            ; {Add one and store
 $9446 LD ($8E2B),A                                     ; it.}
 $9449 JP $9518                                         ; Jump to #R$9518.
@label=UpdateType13_Table
 $944C DEFB $50,$50,$50,$28,$58,$58,$1C,$58,$1A,$FF,$58 ;

; Update Type 1C Object
;
; The code for an object of type #N($1C), which is run by
; #R$A18D.
;
; IX Address of the object
@label=UpdateType1C
c$9457 LD A,(IX+$13)  ; Fetch the first state byte of the object.
 $945A AND %00001111  ; Keep the bottom four bits.
 $945C LD HL,$944C    ; Use the table at #R$944C.
 $945F CALL $9BCF     ; Add the offset to the address.
 $9462 LD A,(HL)      ; Fetch the collision effects for this state.
 $9463 LD ($8E2C),A   ; Store them in #R$8E2C.
 $9466 LD A,(IX+$14)  ; Fetch the second state byte of the object.
 $9469 CP $02         ; Is it two?
 $946B CALL Z,$8C05   ; Move the object if so.
 $946E LD A,(IX+$13)  ; Fetch the first state byte of the object.
 $9471 AND %00001111  ; Keep the bottom four bits.
 $9473 CP $08         ; Is it eight?
 $9475 LD C,$2A       ; #REGc=#N$2A.
 $9477 JR Z,$9482     ; Jump to #R$9482 if so.
 $9479 CP $09         ; {Jump to #R$9482 if it is nine.
 $947B JR Z,$9482     ; }
 $947D CALL $910A     ; Step the state of the object.
 $9480 LD C,$18       ; #REGc=#N$18.
@label=UpdateType1C_Finish
*$9482 LD B,$18       ; #REGb=#N$18.
 $9484 CALL $90A7     ; Move the object and stop it.
 $9487 DEC (IX+$15)   ; Count down the lifetime of the object.
 $948A JP NZ,$951B    ; Jump to #R$951B if it has not run out.
 $948D SET 3,(IX+$17) ; Set bit 3 of the second set of flags of the object.
 $9491 JP $951B       ; Jump to #R$951B.

; Update Type 1D Object
;
; The code for an object of type #N($1D), which is run by
; #R$A18D.
;
; IX Address of the object
@label=UpdateType1D
c$9494 LD A,$51      ; {Set the collision effects in #R$8E2C to #N$51.
 $9496 LD ($8E2C),A  ; }
 $9499 CALL $9035    ; Explode the object if it has been hit.
 $949C CALL $910A    ; Step the state of the object.
 $949F LD BC,$2020   ; #REGbc=#N$2020.
 $94A2 CALL $90A7    ; Move the object and stop it.
 $94A5 JP $951B      ; Jump to #R$951B.

; Update Type 19 Object
;
; The code for an object of type #N($19), which is run by
; #R$A18D.
;
; IX Address of the object
@label=UpdateType19
c$94A8 CALL $7275      ; Play a sound.
 $94AB LD (IX+$0D),$55 ; Make the attribute of the object #N$55.
 $94AF BIT 5,(IX+$10)  ; {Jump to #R$94C5 if bit 5 of the flags of the object
 $94B3 JR Z,$94C5      ; is clear.}
 $94B5 LD A,($9A64)    ; Fetch the frame counter from #R$9A64.
 $94B8 AND %00000111   ; Keep the bottom three bits.
 $94BA JR NZ,$94C5     ; Jump to #R$94C5 if any are set.
 $94BC INC (IX+$16)    ; Add one to the third state byte of the object.
 $94BF CALL $9234      ; Score the points for the object.
 $94C2 CALL $724C      ; Play the explosion sound.
@label=UpdateType19_Clear
*$94C5 RES 5,(IX+$10)  ; Clear bit 5 of the flags of the object.
 $94C9 LD A,(IX+$16)   ; Fetch the third state byte of the object.
 $94CC AND %00111111   ; Keep the bottom six bits.
 $94CE CP $0A          ; {Jump to #R$94D6 if it is not ten or more.
 $94D0 JR C,$94D6      ; }
 $94D2 LD (IX+$0D),$FF ; Make the attribute of the object #N($FF).
@label=UpdateType19_Count
*$94D6 CP $0E          ; {Jump to #R$94E1 if it is not fourteen or more.
 $94D8 JR C,$94E1      ; }
 $94DA SET 3,(IX+$17)  ; Set bit 3 of the second set of flags of the object.
 $94DE CALL $9234      ; Score the points for the object.
@label=UpdateType19_Shoot
*$94E1 PUSH IY         ; Stash #REGiy on the stack.
 $94E3 LD A,(IX+$13)   ; Fetch the first state byte of the object.
 $94E6 AND %00000001   ; Keep bit 0.
 $94E8 ADD A,$07       ; Add seven.
 $94EA LD ($5C1C),A    ; Store it in #R$5C1C.
 $94ED CALL $8813      ; Fire a random shot.
 $94F0 POP IY          ; Bring #REGiy back off the stack.
 $94F2 CALL $97DF      ; Run the behaviour code for the object.
 $94F5 CALL $8C05      ; Move the object.
 $94F8 LD A,(IX+$07)   ; Fetch the horizontal speed of the object.
 $94FB OR (IX+$08)     ; Combine it with the low byte of the speed.
 $94FE CALL NZ,$92FA   ; Set the facing of the object if it is moving.
 $9501 LD BC,$1830     ; #REGbc=#N$1830.
 $9504 JP $9518        ; Jump to #R$9518.

; Update Type 14 Object
;
; The code for objects of type #N($14), #N($16), #N($17), #N($18) and
; #N($1A), which is run by #R$A18D.
;
; IX Address of the object
@label=UpdateType14
c$9507 CALL $9035    ; Explode the object if it has been hit.
 $950A JR NZ,$9512   ; Jump to #R$9512 if it was.
 $950C CALL $97DF    ; Run the behaviour code for the object.
 $950F CALL $8C05    ; Move the object.
; This entry point is used by the routine at #R$96D8.
@label=UpdateType14_Step
*$9512 CALL $910A    ; Step the state of the object.
 $9515 LD BC,$2322   ; #REGbc=#N$2322.
; This entry point is used by the routines at #R$93F2 and #R$94A8.
@label=UpdateType14_Move
*$9518 CALL $909A    ; Move the object back and forth.
; This entry point is used by the routines at #R$9457 and #R$9494.
@label=UpdateType14_Flags
*$951B CALL $90EC    ; Process the flags of the object.
; This entry point is used by the routines at #R$9524 and #R$96D8.
@label=UpdateType14_Draw
*$951E CALL $AD1B    ; Call #R$AD1B.
 $9521 JP $AE98      ; Jump to #R$AE98.

; Update Type 1E Object
;
; The code for an object of type #N($1E), which is run by
; #R$A18D.
;
; IX Address of the object
@label=UpdateType1E
c$9524 LD A,$10       ; {Set the collision effects in #R$8E2C to #N$10.
 $9526 LD ($8E2C),A   ; }
 $9529 CALL $8C05     ; Move the object.
 $952C CALL $BF66     ; Update the position of the object.
 $952F LD A,(IX+$04)  ; Fetch the map zone of the object.
 $9532 CP (IX+$15)    ; Compare it with the third state byte of the object.
 $9535 JR NZ,$9543    ; Jump to #R$9543 if they are different.
 $9537 LD A,(IX+$05)  ; Fetch the vertical position of the object.
 $953A CP (IX+$16)    ; Compare it with the fourth state byte of the object.
 $953D JR C,$9543     ; Jump to #R$9543 if it is lower.
 $953F SET 4,(IX+$10) ; Set bit 4 of the flags of the object.
@label=UpdateType1E_Flags
*$9543 CALL $90EC     ; Process the flags of the object.
 $9546 PUSH HL        ; Stash #REGhl on the stack.
 $9547 LD HL,($AD46)  ; Fetch the address of the object from #R$AD46.
 $954A LD A,(HL)      ; Fetch the type of the object.
 $954B INC A          ; Increment it.
 $954C JR NZ,$955B    ; Jump to #R$955B if it is in use.
 $954E LD A,($F602)   ; Fetch the value from #R$F602.
 $9551 INC A          ; {Add one and store it.
 $9552 LD ($F602),A   ; }
 $9555 LD BC,$1500    ; Set the points to #N$1500.
 $9558 CALL $925E     ; Add them to the score.
@label=UpdateType1E_Finish
*$955B POP HL         ; Bring #REGhl back off the stack.
 $955C JP $951E       ; Jump to #R$951E.

; Set Object Position
;
; Used by the routine at #R$9572.
; .
; Gives an object the position held in #R$96AC and #R$96AE.
;
; IX Address of the object
@label=SetObjectPosition
c$955F LD HL,($96AC) ; Fetch the horizontal position from #R$96AC.
 $9562 LD (IX+$02),L ; {Set the horizontal position and the map column of the
 $9565 LD (IX+$01),H ; object.}
 $9568 LD HL,($96AE) ; Fetch the vertical position from #R$96AE.
 $956B LD (IX+$05),L ; {Set the vertical position and the map zone of the
 $956E LD (IX+$04),H ; object.}
 $9571 RET           ; Return.

; Update Crystal Stack
;
; Used by the routine at #R$AC60.
; .
; Purpose not yet known. It builds a stack of objects in the slot at
; #R$9A4C, one for each of the crystals counted at #R$F602 and takes
; different action when the player's ship is in the right place on the map.
; Called once a frame.
@label=UpdateCrystalStack
c$9572 XOR A                    ; {Clear #R$8D3C.
 $9573 LD ($8D3C),A             ; }
 $9576 LD A,($96AB)             ; Fetch the flag from #R$96AB.
 $9579 AND A                    ; Test it.
 $957A JR NZ,$958F              ; Jump to #R$958F if it is set.
 $957C LD HL,($CE57)            ; Fetch the map position from #R$CE57.
 $957F LD A,L                   ; Fetch the map column.
 $9580 CP $51                   ; {Jump to #R$9587 if it is #N$51.
 $9582 JR Z,$9587               ; }
 $9584 CP $52                   ; Is it #N$52?
 $9586 RET NZ                   ; Return if not.
@label=UpdateCrystalStack_Zone
*$9587 LD A,H                   ; Fetch the map zone.
 $9588 CP $09                   ; {Jump to #R$958F if it is #N$09.
 $958A JR Z,$958F               ; }
 $958C CP $0A                   ; Is it #N$0A?
 $958E RET NZ                   ; Return if not.
@label=UpdateCrystalStack_Count
*$958F LD A,($F602)             ; Fetch the number of crystals from #R$F602.
 $9592 AND A                    ; Test it.
 $9593 RET Z                    ; Return if there are none.
 $9594 INC A                    ; Add one.
 $9595 SRL A                    ; Halve it.
 $9597 LD ($8D3C),A             ; Store the result in #R$8D3C.
 $959A LD IX,$9A4C              ; Use the slot at #R$9A4C.
 $959E LD (IX+$13),$00          ; Clear the first state byte of the object.
 $95A2 LD A,($96AB)             ; Fetch the flag from #R$96AB.
 $95A5 AND A                    ; Test it.
 $95A6 JR Z,$95DA               ; Jump to #R$95DA if it is clear.
 $95A8 LD A,($9A64)             ; Fetch the frame counter from #R$9A64.
 $95AB AND %00000011            ; Keep the bottom two bits.
 $95AD CALL $7303               ; Play a sound.
 $95B0 CALL $955F               ; Set the position of the object.
 $95B3 LD A,($CCBA)             ; Fetch the speed from #R$CCBA.
 $95B6 NEG                      ; Negate it.
 $95B8 LD (IX+$09),A            ; Set the vertical speed of the object.
 $95BB LD A,($CE58)             ; Fetch the map zone from #R$CE58.
 $95BE AND A                    ; Test it.
 $95BF JR NZ,$95C5              ; Jump to #R$95C5 if it is not zero.
 $95C1 LD (IX+$09),$FC          ; Otherwise set the vertical speed of the
                                ; object to #N$FC.
@label=UpdateCrystalStack_Move
*$95C5 CALL $BF66               ; Update the position of the object.
 $95C8 LD L,(IX+$02)            ; {Store the horizontal position of the object
 $95CB LD H,(IX+$01)            ; in #R$96AC.
 $95CE LD ($96AC),HL            ; }
 $95D1 LD L,(IX+$05)            ; {Store the vertical position of the object in
 $95D4 LD H,(IX+$04)            ; #R$96AE.
 $95D7 LD ($96AE),HL            ; }
@label=UpdateCrystalStack_Next
*$95DA CALL $955F               ; Set the position of the object.
 $95DD LD A,(IX+$13)            ; {Fetch the first state byte of the object and
 $95E0 LD B,A                   ; keep it in #REGb.}
 $95E1 ADD A,A                  ; {Multiply it by five.
 $95E2 ADD A,A                  ;
 $95E3 ADD A,B                  ; }
 $95E4 LD HL,$96B0              ; Use the table at #R$96B0.
 $95E7 CALL $9BCF               ; Add the offset to the address.
 $95EA LD DE,$9A5C              ; Use the data at #R$9A5C.
 $95ED LD BC,$0003              ; Set the length to three.
 $95F0 LDIR                     ; Copy the three bytes.
 $95F2 LD A,(HL)                ; Fetch the next byte of the table.
 $95F3 LD (IX+$07),A            ; Set the horizontal speed of the object.
 $95F6 INC HL                   ; Fetch the next byte of the table.
 $95F7 LD A,(HL)                ; {Set the vertical speed of the object.
 $95F8 LD (IX+$09),A            ; }
 $95FB CALL $BF66               ; Update the position of the object.
 $95FE LD (IX+$07),$00          ; Clear the horizontal speed.
 $9602 LD (IX+$09),$00          ; Clear the vertical speed.
 $9606 LD A,(IX+$13)            ; Fetch the first state byte of the object.
 $9609 CP $06                   ; {Jump to #R$9611 if it is not six.
 $960B JR NZ,$9611              ; }
 $960D LD (IX+$13),$08          ; Set the first state byte to eight.
@label=UpdateCrystalStack_Draw
*$9611 CALL $A2EA               ; Reset the collision state.
 $9614 BIT 7,(IX+$10)           ; Test bit 7 of the flags of the object.
 $9618 CALL NZ,$AD27            ; Call #R$AD27 if it is set.
 $961B RES 6,(IX+$10)           ; Clear bit 6 of the flags of the object.
 $961F EXX                      ; Switch registers.
 $9620 CALL $90EC               ; Process the flags of the object.
 $9623 CALL $AD1B               ; Call #R$AD1B.
 $9626 CALL $AE98               ; Call #R$AE98.
 $9629 LD IX,$9A4C              ; Use the slot at #R$9A4C.
 $962D LD A,(IX+$13)            ; Fetch the first state byte of the object.
 $9630 CP $08                   ; {Jump to #R$9639 if it is not eight.
 $9632 JR NZ,$9639              ; }
 $9634 LD A,$06                 ; Use six instead.
 $9636 LD (IX+$13),A            ; Store it.
@label=UpdateCrystalStack_Copy
*$9639 LD B,A                   ; Keep the state in #REGb.
 $963A ADD A,A                  ; {Multiply it by five.
 $963B ADD A,A                  ;
 $963C ADD A,B                  ; }
 $963D LD HL,$96B0              ; Use the table at #R$96B0.
 $9640 CALL $9BCF               ; Add the offset to the address.
 $9643 LD DE,$9A5C              ; Use the data at #R$9A5C.
 $9646 EX DE,HL                 ; Swap the pointers.
 $9647 LD BC,$0003              ; Set the length to three.
 $964A LDIR                     ; Copy the three bytes back.
 $964C INC (IX+$13)             ; Move on to the next state.
 $964F LD A,($F602)             ; Fetch the number of crystals from #R$F602.
 $9652 CP (IX+$13)              ; Compare it with the state.
 $9655 JP NZ,$95DA              ; Jump to #R$95DA if they are different.
 $9658 LD A,($F602)             ; Fetch the number of crystals again.
 $965B CP $08                   ; Are there eight?
 $965D RET NZ                   ; Return if not.
 $965E LD A,($96AB)             ; Fetch the flag from #R$96AB.
 $9661 AND A                    ; Test it.
 $9662 JR Z,$9672               ; Jump to #R$9672 if it is clear.
 $9664 CALL $C6D2               ; Call #R$C6D2.
 $9667 LD A,($96B0)             ; Fetch the value from #R$96B0.
 $966A AND %10000000            ; Keep bit 7.
 $966C RET NZ                   ; Return if it is set.
 $966D DEC A                    ; Decrease it.
 $966E LD ($96AB),A             ; Store it in #R$96AB.
 $9671 RET                      ; Return.
@label=UpdateCrystalStack_Docked
*$9672 LD HL,($C8E6)            ; Fetch the map column and horizontal position of the player from
                                ; #N$C8E6.
 $9675 LD A,L                   ; Fetch the map column.
 $9676 CP $52                   ; Is it #N$52?
 $9678 RET NZ                   ; Return if not.
 $9679 LD A,H                   ; Fetch the horizontal position.
 $967A CP $5C                   ; Is it #N$5C?
 $967C RET NZ                   ; Return if not.
 $967D LD HL,($C8E9)            ; Fetch the map zone and vertical position of
                                ; the player from #N$C8E9.
 $9680 LD A,L                   ; Fetch the map zone.
 $9681 CP $0A                   ; Is it #N$0A?
 $9683 RET NZ                   ; Return if not.
 $9684 LD A,H                   ; Fetch the vertical position.
 $9685 CP $63                   ; Is it lower than #N$63?
 $9687 RET C                    ; Return if so.
 $9688 LD ($96AB),A             ; Set the flag at #R$96AB.
 $968B LD A,$0A                 ; {Set the explosion counter at #R$8F53 to
 $968D LD ($8F53),A             ; #N$0A.}
 $9690 CALL $C421               ; Call #R$C421.
 $9693 CALL $C4ED               ; Call #R$C4ED.
 $9696 XOR A                    ; {Clear the explosion counter.
 $9697 LD ($8F53),A             ; }
 $969A LD A,$80                 ; {Set #R$C27A to #N$80.
 $969C LD ($C27A),A             ; }
 $969F CALL $C1CE               ; Call #R$C1CE.
 $96A2 LD HL,$0000              ; {Clear #N$C8FE.
 $96A5 LD ($C8FE),HL            ; }
 $96A8 JP $724C                 ; Play the explosion sound.
 $96AB DEFB $00                 ;
 $96AC DEFW $5268               ;
 $96AE DEFW $0A73               ;
@label=UpdateCrystalStack_Table
 $96B0 DEFB $00,$00,$00,$00,$00 ;
 $96B5 DEFB $00,$00,$00,$00,$F7 ;
 $96BA DEFB $00,$00,$00,$00,$EE ;
 $96BF DEFB $00,$00,$00,$00,$DE ;
 $96C4 DEFB $00,$00,$00,$F2,$E2 ;
 $96C9 DEFB $00,$00,$00,$16,$E2 ;
 $96CE DEFB $00,$00,$00,$00,$D1 ;
 $96D3 DEFB $00,$00,$00,$00,$C1 ;

; Update Type 15 Object
;
; The code for an object of type #N($15), which is run by #R$A18D. The
; speeds of the object follow the table at #R$9873, which ends with #N$80.
;
; IX Address of the object
@label=UpdateType15
c$96D8 XOR A           ; {Clear the collision effects in #R$8E2C.
 $96D9 LD ($8E2C),A    ; }
 $96DC CALL $720A      ; Play a sound.
 $96DF LD A,(IX+$15)   ; Fetch the lifetime of the object.
 $96E2 AND %00111111   ; Keep the bottom six bits.
 $96E4 LD HL,$9873     ; Use the table at #R$9873.
 $96E7 CALL $9BCF      ; Add the offset to the address.
 $96EA LD A,(HL)       ; Fetch the horizontal speed from the table.
 $96EB CP $80          ; {Jump to #R$96F6 if it is not the end of the table.
 $96ED JR NZ,$96F6     ; }
 $96EF LD (IX+$00),$FF ; Free the slot.
 $96F3 JP $951E        ; Jump to #R$951E.
@label=UpdateType15_Speed
*$96F6 LD (IX+$07),A   ; Set the horizontal speed of the object.
 $96F9 INC HL          ; {Fetch the vertical speed from the table.
 $96FA LD A,(HL)       ; }
 $96FB LD (IX+$09),A   ; Set the vertical speed of the object.
 $96FE INC (IX+$15)    ; {Move two steps along the table.
 $9701 INC (IX+$15)    ; }
 $9704 BIT 7,(IX+$15)  ; {Jump to #R$9712 if bit 7 of the lifetime of the
 $9708 JR Z,$9712      ; object is clear.}
 $970A LD A,(IX+$07)   ; {Reverse the horizontal speed.
 $970D NEG             ;
 $970F LD (IX+$07),A   ; }
@label=UpdateType15_Vertical
*$9712 BIT 6,(IX+$15)  ; {Jump to #R$9512 if bit 6 of the lifetime of the
 $9716 JP Z,$9512      ; object is clear.}
 $9719 LD A,(IX+$09)   ; {Reverse the vertical speed.
 $971C NEG             ;
 $971E LD (IX+$09),A   ; }
 $9721 JP $9512        ; Jump to #R$9512.

; Start Crystal Object
;
; Used by the routine at #R$C374.
; .
; Purpose not yet known. Starts an object of type #N($1E) at a fixed
; map position when the player is in the right place and the value at #R$F601
; is not #N($FF).
@label=StartCrystalObject
c$9724 LD A,($F601)    ; Fetch the value from #R$F601.
 $9727 INC A           ; Increment it.
 $9728 RET Z           ; Return if it was #N($FF).
 $9729 LD A,($C8E9)    ; Fetch the map zone of the player from #N$C8E9.
 $972C CP $0B          ; Is it #N$0B or more?
 $972E RET NC          ; Return if so.
 $972F LD A,($C8E6)    ; Fetch the map column of the player from #N$C8E6.
 $9732 CP $52          ; Is it #N$52?
 $9734 RET NZ          ; Return if not.
 $9735 LD A,($C8E7)    ; Fetch the horizontal position of the player from
                       ; #N$C8E7.
 $9738 CP $5C          ; Is it #N$5C?
 $973A RET NZ          ; Return if not.
 $973B LD A,($F601)    ; Fetch the value from #R$F601.
 $973E CP $06          ; {Jump to #R$974A if it is not six.
 $9740 JR NZ,$974A     ; }
 $9742 LD A,($C905)    ; Fetch the value from #R$C905.
 $9745 CP $12          ; Is it #N$12?
 $9747 RET NZ          ; Return if not.
 $9748 LD A,$08        ; Use #N$08.
@label=StartCrystalObject_Set
*$974A OR %10000000    ; Set bit 7.
 $974C LD ($C904),A    ; Store the value in #N$C904.
 $974F CALL $97BD      ; Find a free slot.
 $9752 CALL $AC34      ; Clear the slot.
 $9755 LD HL,($C900)   ; Fetch the value from #N$C900.
 $9758 LD A,L          ; {Swap the bytes...
 $9759 LD L,H          ;
 $975A LD H,A          ; }
 $975B CALL $BE08      ; ...and negate the result.
 $975E LD (IX+$09),H   ; {Set the vertical speed of the object.
 $9761 LD (IX+$0A),L   ; }
 $9764 LD (IX+$10),$23 ; Set the flags of the object to #N$23.
 $9768 LD (IX+$0F),$1B ; Set the vertical acceleration of the object.
 $976C LD (IX+$00),$1E ; Set the type of the object to #N$1E.
 $9770 LD A,($F601)    ; Fetch the value from #R$F601.
 $9773 LD (IX+$13),A   ; Set the first state byte of the object.
 $9776 LD B,A          ; Keep a copy in #REGb.
 $9777 ADD A,A         ; {Multiply it by five.
 $9778 ADD A,A         ;
 $9779 ADD A,B         ; }
 $977A ADD A,$04       ; Add four.
 $977C LD HL,$96B0     ; Use the table at #R$96B0.
 $977F CALL $9BCF      ; Add the offset to the address.
 $9782 LD B,(HL)       ; Fetch the value from the table.
 $9783 LD A,$73        ; {Add #N$73.
 $9785 ADD A,B         ; }
 $9786 LD (IX+$16),A   ; Set the third state byte of the object.
 $9789 LD A,($C8E9)    ; Fetch the map zone of the player from #N$C8E9.
 $978C LD (IX+$04),A   ; Set the map zone of the object.
 $978F LD (IX+$01),$52 ; Set the map column of the object to #N$52.
 $9793 LD (IX+$02),$68 ; Set the horizontal position of the object to #N$68.
 $9797 LD A,($C8EA)    ; Fetch the vertical position of the player from
                       ; #N$C8EA.
 $979A LD (IX+$05),A   ; Set the vertical position of the object.
 $979D LD (IX+$0D),$FF ; Make the attribute of the object #N($FF).
 $97A1 LD (IX+$15),$0A ; Set the lifetime of the object to ten.
 $97A5 LD A,($F601)    ; Fetch the value from #R$F601.
 $97A8 CP $06          ; {Jump to #R$97B7 if it is not six.
 $97AA JR NZ,$97B7     ; }
 $97AC LD (IX+$13),$08 ; Set the first state byte of the object to eight.
 $97B0 XOR A           ; {Clear #R$C905.
 $97B1 LD ($C905),A    ; }
 $97B4 LD ($F600),A    ; Clear #R$F600.
@label=StartCrystalObject_Done
*$97B7 LD A,$FF        ; {Set #R$F601 to #N($FF).
 $97B9 LD ($F601),A    ; }
 $97BC RET             ; Return.

; Find Free Enemy Slot
;
; Used by the routine at #R$9724.
; .
; Looks for a free slot among the nine enemy slots. If there is not one,
; it looks for an object with bit 7 of its flags set among the first eight.
;
; O:IX Address of the slot
@label=FindFreeEnemySlot
c$97BD LD B,$09       ; Set a counter for nine slots.
 $97BF LD IX,$9974    ; Use the first enemy slot.
 $97C3 LD DE,$0018    ; Set the length of a slot.
@label=FindFreeEnemySlot_Loop
*$97C6 LD A,(IX+$00)  ; Fetch the type of the object in the slot.
 $97C9 INC A          ; Increment it.
 $97CA RET Z          ; Return if the slot is free.
 $97CB ADD IX,DE      ; Move on to the next slot.
 $97CD DJNZ $97C6     ; Decrease the counter by one and loop back to #R$97C6 until none
                      ; remain.
 $97CF LD IX,$9974    ; Use the first enemy slot.
 $97D3 LD B,$08       ; Set a counter for eight slots.
@label=FindFreeEnemySlot_Flags
*$97D5 BIT 7,(IX+$10) ; Test bit 7 of the flags of the object.
 $97D9 RET Z          ; Return if it is clear.
 $97DA ADD IX,DE      ; Move on to the next slot.
 $97DC DJNZ $97D5     ; Decrease the counter by one and loop back to #R$97D5 until none
                      ; remain.
 $97DE RET            ; Return.

; Run Object Behaviour
;
; Used by the routines at #R$94A8 and #R$9507.
; .
; Counts down a timer for an object and, when it has expired, runs the
; behaviour code for its type from the table at #R$993B.
;
; IX Address of the object
@label=RunObjectBehaviour
c$97DF BIT 7,(IX+$16) ; {Jump to #R$97F2 if bit 7 of the third state byte of the object is
 $97E3 JR NZ,$97F2    ; set.}
 $97E5 DEC (IX+$15)   ; Count down the lifetime of the object.
 $97E8 RET NZ         ; Return if it has not run out.
 $97E9 LD A,($9BCC)   ; Fetch the second byte of the random seed.
 $97EC AND %00011111  ; Keep five bits.
 $97EE INC A          ; Add one.
 $97EF LD (IX+$15),A  ; Restart the lifetime of the object.
@label=RunObjectBehaviour_Run
*$97F2 LD A,(IX+$00)  ; Fetch the type of the object.
 $97F5 SUB $13        ; Subtract #N$13.
 $97F7 LD C,A         ; Copy it into #REGc.
 $97F8 LD HL,$993B    ; Use the table at #R$993B.
 $97FB CALL $A1AA     ; Fetch the address of the code from the table.
 $97FE JP (HL)        ; Run it.

; Chase Player
;
; Used by the routine at #R$995B.
; .
; Behaviour code used for several types of object (see #R$97DF). Makes
; the object accelerate towards the player and then halves the acceleration.
;
; IX Address of the object
@label=ChasePlayer
c$97FF PUSH IY        ; Stash #REGiy on the stack.
 $9801 LD IY,$C8E5    ; Use the player's object.
 $9805 CALL $9341     ; Accelerate towards the player.
 $9808 POP IY         ; Bring #REGiy back off the stack.
 $980A SET 7,(IX+$16) ; Set bit 7 of the third state byte of the object.
 $980E LD H,(IX+$0B)  ; {Fetch the horizontal acceleration of the object.
 $9811 LD L,(IX+$0C)  ; }
 $9814 SRA H          ; {Halve it twice.
 $9816 RR L           ;
 $9818 SRA H          ;
 $981A RR L           ; }
 $981C LD (IX+$0B),H  ; {Store it.
 $981F LD (IX+$0C),L  ; }
 $9822 LD H,(IX+$0E)  ; {Fetch the vertical acceleration of the object.
 $9825 LD L,(IX+$0F)  ; }
 $9828 SRA H          ; {Halve it twice.
 $982A RR L           ;
 $982C SRA H          ;
 $982E RR L           ; }
 $9830 LD (IX+$0E),H  ; {Store it.
 $9833 LD (IX+$0F),L  ; }
 $9836 RET            ; Return.

; Chase Player Briefly
;
; Behaviour code used for objects of type #N($17) (see #R$97DF). Makes
; the object accelerate towards the player and then gives it a new lifetime.
;
; IX Address of the object
@label=ChasePlayerBriefly
c$9837 PUSH IY       ; Stash #REGiy on the stack.
 $9839 LD IY,$C8E5   ; Use the player's object.
 $983D CALL $9341    ; Accelerate towards the player.
 $9840 POP IY        ; Bring #REGiy back off the stack.
 $9842 LD A,($9BCB)  ; Fetch the first byte of the random seed.
 $9845 AND %00001111 ; Keep four bits.
 $9847 ADD A,$0A     ; Add ten.
 $9849 LD (IX+$15),A ; Set the lifetime of the object.
 $984C RET           ; Return.

; Accelerate Randomly
;
; Behaviour code used for objects of type #N($18) and #N($1A) (see
; #R$97DF). Gives the object a random acceleration.
;
; IX Address of the object
@label=AccelerateRandomly
c$984D LD A,($9BCB)  ; Fetch the first byte of the random seed.
 $9850 AND %00000001 ; Keep bit 0.
 $9852 CALL $986A    ; Choose a horizontal acceleration.
 $9855 LD (IX+$0B),D ; {Set the horizontal acceleration of the object.
 $9858 LD (IX+$0C),E ; }
 $985B LD A,($9BCB)  ; Fetch the first byte of the random seed.
 $985E AND %00000010 ; Keep bit 1.
 $9860 CALL $986A    ; Choose a vertical acceleration.
 $9863 LD (IX+$0E),D ; {Set the vertical acceleration of the object.
 $9866 LD (IX+$0F),E ; }
 $9869 RET           ; Return.

; Choose Acceleration
;
; Used by the routine at #R$984D.
; .
; Chooses an acceleration of #N$FFE0 or #N$0020.
;
;   F The zero flag selects the negative acceleration
; O:DE Acceleration
@label=ChooseAcceleration
c$986A LD D,$FF      ; {Use #N$FFE0 as the acceleration.
 $986C LD E,$E0      ; }
 $986E RET Z         ; Return if the zero flag is set.
 $986F LD DE,$0020   ; Use #N$0020 as the acceleration.
 $9872 RET           ; Return.

; Explosion Speeds
;
; Pairs of horizontal and vertical speeds used by #R$96D8, ending with
; #N$80.
@label=ExplosionSpeeds
b$9873 DEFB $02,$F8
 $9875 DEFB $02,$F8
 $9877 DEFB $04,$F9
 $9879 DEFB $06,$FA
 $987B DEFB $06,$FC
 $987D DEFB $08,$02
 $987F DEFB $04,$07
 $9881 DEFB $FE,$07
 $9883 DEFB $FA,$04
 $9885 DEFB $FA,$FF
 $9887 DEFB $FC,$FB
 $9889 DEFB $FE,$F9
 $988B DEFB $04,$F7
 $988D DEFB $06,$FA
 $988F DEFB $06,$FC
 $9891 DEFB $08,$FE
 $9893 DEFB $80

