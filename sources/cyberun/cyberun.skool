 $CB70 DEFB $0F,$00
 $CB72 DEFB $0F,$00
 $CB74 DEFB $0F,$00
 $CB76 DEFB $0F,$00
 $CB78 DEFB $00,$00
 $CB7A DEFB $0F,$F0
 $CB7C DEFB $0F,$00
 $CB7E DEFB $0F,$00
 $CB80 DEFB $0F,$C0
 $CB82 DEFB $0F,$00
 $CB84 DEFB $0F,$00
 $CB86 DEFB $0F,$F0
 $CB88 DEFB $00,$00
 $CB8A DEFB $07,$E0
 $CB8C DEFB $0F,$30
 $CB8E DEFB $0F,$30
 $CB90 DEFB $0F,$30
 $CB92 DEFB $0F,$30
 $CB94 DEFB $0F,$30
 $CB96 DEFB $0F,$30
 $CB98 DEFB $00,$00
 $CB9A DEFB $0F,$00
 $CB9C DEFB $0F,$00
 $CB9E DEFB $0F,$00
 $CBA0 DEFB $0F,$C0
 $CBA2 DEFB $0F,$00
 $CBA4 DEFB $0F,$00
 $CBA6 DEFB $0F,$F0

; Fuel Gauge Attributes
;
; Two areas of attributes, each with a width, a height and an attribute.
; The first is for the label and the second is for the gauge: #R$CAA7 changes
; the attribute of the second.
@label=FuelGaugeAttributes
b$CBA8 DEFB $02,$04,$45
@label=FuelGaugeAttributes_Second
 $CBAB DEFB $02,$10,$46

; Draw Fuel Gauge Frame
;
; Used by the routine at #R$CA3F.
; .
; Draws the outline of the fuel gauge: a cap at the bottom and one at
; the top, and a column of dots down the right of the gauge.
@label=DrawFuelGaugeFrame
c$CBAE LD HL,$BFF0   ; The bottom of the gauge is at #N$BFF0.
 $CBB1 LD DE,$CBDB   ; The bottom cap is at #R$CBDB.
 $CBB4 CALL $C96F    ; Draw the bottom cap.
 $CBB7 LD HL,$43F0   ; The top of the gauge is at #N$43F0.
 $CBBA LD DE,$CBD1   ; The top cap is at #R$CBD1.
 $CBBD CALL $C96F    ; Draw the top cap.
 $CBC0 LD HL,$53FE   ; The column of dots starts at #N$53FE.
 $CBC3 LD B,$78      ; There are #N($78) rows of dots.
@label=DrawFuelGaugeFrame_Dots
*$CBC5 LD (HL),$10   ; Plot the left-hand dot.
 $CBC7 INC HL        ; Move across to the right-hand dot.
 $CBC8 LD (HL),$10   ; Plot the right-hand dot.
 $CBCA DEC HL        ; Back to the left-hand dot.
 $CBCB CALL $A1C3    ; Move up one pixel row.
 $CBCE DJNZ $CBC5    ; Repeat for every row of the gauge.
 $CBD0 RET           ; Return.

; Fuel Gauge Caps
;
; The bitmaps for the top and the bottom of the fuel gauge, which are
; two bytes wide and four rows high.
@label=FuelGaugeCaps
b$CBD1 DEFB $02,$04,$10,$10,$18,$30,$0C,$60,$07,$C0 ; Top
@label=FuelGaugeCaps_Second
 $CBDB DEFB $02,$04,$07,$C0,$0C,$60,$18,$30,$10,$10 ; Bottom

; Frame Tick Table
;
; The positions of the ticks that #R$CACB draws on the frame. Each pair
; is the pixel column of a tick along the top and bottom, and then the pixel
; row of a tick down the left and right.
@label=FrameTickTable
b$CBE5 DEFB $20,$36
 $CBE7 DEFB $40,$56
 $CBE9 DEFB $60,$7E
 $CBEB DEFB $88,$9E
 $CBED DEFB $A8,$9E
 $CBEF DEFB $C8,$9E

; Fetch Position
;
; Used by the routine at #R$CACB.
; .
; Reads a position (pixel column first) from a table.
;
;   DE Address of the position
; O:DE Address after the position
; O:HL Position (#REGh is the pixel row and #REGl is the pixel column)
@label=FetchPosition
c$CBF1 LD A,(DE)     ; Fetch the pixel column.
 $CBF2 INC DE        ; Move on to the pixel row.
 $CBF3 LD L,A        ; Keep the column.
 $CBF4 LD A,(DE)     ; Fetch the pixel row.
 $CBF5 INC DE        ; Move on past this position.
 $CBF6 LD H,A        ; Keep the row.
 $CBF7 RET           ; Return.

; Frame Corner Table
;
; Four entries of seven bytes for #R$CACB, one for each corner. Each has
; the position of the corner graphic, the position of an area of attributes
; along the edge and then the area (width, height and attribute).
@label=FrameCornerTable
b$CBF8 DEFB $00,$BE,$00,$BF,$1E,$01,$4D ; Bottom left
 $CBFF DEFB $E8,$BE,$00,$17,$1E,$01,$4D ; Bottom right
 $CC06 DEFB $00,$17,$00,$B7,$01,$14,$4D ; Top left
 $CC0D DEFB $E8,$17,$E8,$B7,$01,$14,$4D ; Top right

; Frame Corner Graphics
;
; The four corner graphics for #R$CACB, each of which is one byte wide
; and seven rows high.
@label=FrameCornerGraphics
b$CC14 DEFB $01,$07,$07,$07,$06,$06,$76,$76,$66 ; Bottom left
 $CC1D DEFB $01,$07,$E0,$E0,$60,$60,$6E,$6E,$66 ; Bottom right
 $CC26 DEFB $01,$07,$66,$76,$76,$06,$06,$07,$07 ; Top left
 $CC2F DEFB $01,$07,$66,$6E,$6E,$60,$60,$E0,$E0 ; Top right

; Draw Line Pair
;
; Used by the routine at #R$CACB.
; .
; Draws a horizontal line of solid bytes at each of two screen addresses
; and moves both addresses up one pixel row. The length of the lines is in
; offset #N($10) of the table.
;
;   DE Second screen address
;   HL First screen address
;   IX Address of the table (#R$CA1D)
; O:DE Second screen address, one row up
; O:HL First screen address, one row up
@label=DrawLinePair
c$CC38 LD B,(IX+$10) ; The length of the rules, in bytes.
 $CC3B PUSH HL       ; Keep the address of the first rule.
 $CC3C PUSH DE       ; Keep the address of the second rule.
@label=DrawLinePair_Loop
*$CC3D LD (HL),$FF   ; Plot a solid byte on the first rule.
 $CC3F LD A,$FF      ; A solid byte is #N$FF.
 $CC41 LD (DE),A     ; Plot it on the second rule.
 $CC42 INC DE        ; Move along the second rule.
 $CC43 INC HL        ; Move along the first rule.
 $CC44 DJNZ $CC3D    ; Repeat for the whole length of the rules.
 $CC46 POP DE        ; Back to the start of the second rule.
 $CC47 POP HL        ; Back to the start of the first rule.
 $CC48 DEC D         ; Move the second rule up one pixel row.
 $CC49 DEC H         ; Move the first rule up one pixel row.
 $CC4A RET           ; Return.

; Fuel Level
;
; The amount of fuel that is left. The high byte is the row of the fuel
; gauge: #N($42) when the tank is full and #N($BE) when it is empty.
@label=FuelLevel
g$CC4B DEFW $0000

; Use Fuel
;
; Used by the routines at #R$8FC4, #R$9015 and #R$B115.
; .
; Adds an amount to the fuel level, to use up some fuel (a positive
; amount) or to put some in (a negative one), keeping the high byte between
; #N($42) and #N($BE).
;
; DE Amount
@label=UseFuel
c$CC4D LD HL,($CC4B) ; The fuel level.
; See #POKE(infinite_fuel,Infinite Fuel).
 $CC50 ADD HL,DE     ; Add the amount.
 $CC51 LD A,H        ; The high byte is the row of the top of the fuel.
 $CC52 CP $BE        ; {Carry on if that row is still on the gauge.
 $CC54 JR C,$CC58    ; }
 $CC56 LD H,$BE      ; Otherwise the tank is empty.
@label=UseFuel_Upper
*$CC58 CP $42        ; {Carry on if the tank is not fuller than full.
 $CC5A JR NC,$CC5E   ; }
 $CC5C LD H,$42      ; Otherwise the tank is full.
@label=UseFuel_Store
*$CC5E LD ($CC4B),HL ; Write the new fuel level.
 $CC61 RET           ; Return.

; Fuel Gauge Row
;
; The pixel row that the fuel gauge is currently showing, which
; #R$CC77 moves one row at a time towards the high byte of the fuel level.
@label=FuelGaugeRow
g$CC62 DEFB $00

; Check Fuel Empty
;
; Used by the routine at #R$CC77.
; .
; Used when the fuel gauge has reached the level of the fuel. If the ship
; is in its normal state, the gauge is at the empty row and the bottom seven
; bits of the frame counter are zero, the ship is put in state 1: out of fuel.
;
; B Pixel row of the fuel gauge
@label=CheckFuelEmpty
c$CC63 LD A,($8F53)  ; The state of the ship.
 $CC66 AND A         ; {Return unless the ship is flying normally.
 $CC67 RET NZ        ; }
 $CC68 LD A,B        ; The row of the needle.
 $CC69 CP $BE        ; {Return unless the needle is on the empty row.
 $CC6B RET NZ        ; }
 $CC6C LD A,($9A64)  ; The frame counter.
 $CC6F AND %01111111 ; The bottom seven bits.
 $CC71 RET NZ        ; Return unless they are all clear.
 $CC72 INC A         ; The out-of-fuel state is one.
 $CC73 LD ($8F53),A  ; Put the ship in that state.
 $CC76 RET           ; Return.

; Update Fuel Gauge
;
; Used by the routines at #R$DD72, #R$F46C and #R$F48B.
; .
; Moves the needle of the fuel gauge one row towards the level of the
; fuel. The needle is a small marker that is drawn at the right of the gauge
; using XOR, so drawing it again at the same row erases it.
@label=UpdateFuelGauge
c$CC77 CALL $CAA7    ; Colour the gauge.
 $CC7A LD A,($CC62)  ; The row the needle is on.
 $CC7D LD B,A        ; Keep that row.
 $CC7E LD A,($CC4C)  ; The row of the top of the fuel.
 $CC81 SUB B         ; How far the needle is from the fuel.
 $CC82 JR Z,$CC63    ; The needle has arrived: see if the tank is empty.
 $CC84 DEC B         ; Step the needle one row up.
 $CC85 LD H,B        ; The upper row of the marker.
 $CC86 BIT 7,A       ; {The fuel is above the needle, so that step stands.
 $CC88 JR NZ,$CC8D   ; }
 $CC8A INC B         ; The fuel is below, so put that row back.
 $CC8B LD H,B        ; The row the needle is leaving.
 $CC8C INC B         ; Step the needle one row down.
@label=UpdateFuelGauge_Store
*$CC8D LD A,B        ; The new row of the needle.
 $CC8E LD ($CC62),A  ; Remember it.
 $CC91 LD A,H        ; The other row of the marker.
 $CC92 LD ($5C1C),A  ; Keep it while the screen address is found.
 $CC95 LD L,$F0      ; The needle sits in the right-hand column.
 $CC97 CALL $A149    ; Find the screen address of that row.
 $CC9A LD A,$03      ; The upper part of the marker.
 $CC9C XOR (HL)      ; Toggle it into the screen byte.
 $CC9D LD (HL),A     ; Write that byte back.
 $CC9E INC HL        ; The next byte of the marker.
 $CC9F LD A,$80      ; The right-hand bit of the upper part.
 $CCA1 XOR (HL)      ; Toggle it into the screen byte.
 $CCA2 LD (HL),A     ; Write that byte back.
 $CCA3 LD A,($5C1C)  ; The other row of the marker.
 $CCA6 CP $BC        ; {Nothing more to draw once the needle is this low.
 $CCA8 RET NC        ; }
 $CCA9 INC A         ; The row below that one.
 $CCAA LD H,A        ; That row.
 $CCAB LD L,$F0      ; The same column.
 $CCAD CALL $A149    ; Find the screen address.
 $CCB0 LD A,$04      ; The lower part of the marker.
 $CCB2 XOR (HL)      ; Toggle it into the screen byte.
 $CCB3 LD (HL),A     ; Write that byte back.
 $CCB4 INC HL        ; The next byte of the marker.
 $CCB5 LD A,$40      ; The right-hand bit of the lower part.
 $CCB7 XOR (HL)      ; Toggle it into the screen byte.
 $CCB8 LD (HL),A     ; Write that byte back.
 $CCB9 RET           ; Return.

; Vertical Speed
;
; The vertical scroll speed: how many pixel rows the world moves each
; frame. It is negative when the ship is going up the screen.
@label=VerticalSpeed
g$CCBA DEFB $00

; Horizontal Speed
;
; The horizontal scroll speed: how many pixels the world moves sideways
; each frame. It is negative when the ship is going to the left.
@label=HorizontalSpeed
g$CCBB DEFB $00

; Star Flags
;
; Flags for the layers of stars. Bit 0 is set when a star has been drawn
; (see #R$C032 and #R$C10E). Purpose not yet known for the other bits.
@label=StarFlags
g$CCBC DEFB $00

; Shape Table Pointer
;
; The address of the table of shapes for the current horizontal scroll
; offset, which is one of #R$E2BD, #R$E2FD, #R$E33D and #R$E37D. #R$D0BD sets
; it.
@label=ShapeTablePointer
g$CCBD DEFW $0000

; Picture Offsets
;
; Six bytes for each of the nine types of slope listed at #R$E3BD. The
; terrain drawing routine at #R$D0BD points #R$CE51 at the entry for the type
; of the current segment and #R$D672 uses the third and later bytes as offsets
; into the picture of the segment. The first two bytes are always zero. The
; values are repeated by the types that are the same shape.
@label=PictureOffsets
b$CCBF DEFB $00,$00,$0C,$0C,$18,$18
 $CCC5 DEFB $00,$00,$12,$1B,$24,$36
 $CCCB DEFB $00,$00,$09,$12,$12,$24
 $CCD1 DEFB $00,$00,$11,$22,$22,$44
 $CCD7 DEFB $00,$00,$12,$1B,$24,$36
 $CCDD DEFB $00,$00,$09,$12,$12,$24
 $CCE3 DEFB $00,$00,$11,$22,$22,$44
 $CCE9 DEFB $00,$00,$11,$22,$22,$44
 $CCEF DEFB $00,$00,$11,$22,$22,$44

; Advance Screen Address
;
; Used by the routine at #R$D3D2.
; .
; Moves the screen address of the segment that is being drawn along by
; the column step of its type, and then clears the column step and the
; horizontal step ready for the next segment.
@label=AdvanceScreenAddress
c$CCF5 LD A,($CE49)  ; The segment screen address.
 $CCF8 LD B,A        ; #REGb=#REGa.
 $CCF9 LD A,($CE36)  ; The column step.
 $CCFC ADD A,B       ; #REGa gains #REGb.
 $CCFD LD ($CE49),A  ; Update the segment screen address.
 $CD00 XOR A         ; Clear #REGa.
 $CD01 LD ($CE36),A  ; Update the column step.
 $CD04 LD ($CE35),A  ; Update the horizontal step.
 $CD07 RET           ; Return.

; Set Up Segment
;
; Used by the routine at #R$D0BD.
; .
; Sets up the variables for a segment of the tile, whose type is at
; offset #N$03 of the segment record. When the tile is drawn upside down the
; type is first changed with the table at #R$CE14. #R$E3D8 then loads the three
; steps of the type. The routine stores a vertical step of #N$04 if the type
; has none (and so is flat), and stores the absolute values of the column and
; horizontal steps in #R$5C24 and #R$5C25. If the tile is upside down it moves
; the pixel position of a vertical segment sideways.
;
; IX Address of the segment record
@label=SetUpSegment
c$CD08 LD A,($5C26)  ; The upside down flag.
 $CD0B AND A         ; {Jump to #R$CD1B if #REGa is zero.
 $CD0C JR Z,$CD1B    ; }
 $CD0E LD E,(IX+$03) ; Read offset #N$03 of #REGix into #REGe.
 $CD11 LD D,$00      ; Clear #REGd.
 $CD13 LD HL,$CE14   ; The flip type table.
 $CD16 ADD HL,DE     ; #REGhl gains #REGde.
 $CD17 LD A,(HL)     ; Read #REGhl.
 $CD18 LD (IX+$03),A ; Write #REGa to offset #N$03 of #REGix.
@label=SetUpSegment_Steps
*$CD1B CALL $E3D8    ; Call #R$E3D8.
 $CD1E LD A,($CE37)  ; The vertical step.
 $CD21 LD ($CE5A),A  ; Update the vertical step copy.
 $CD24 AND A         ; {Jump to #R$CD2C if #REGa is not zero.
 $CD25 JR NZ,$CD2C   ; }
 $CD27 OR %00000100  ; Set the bits of #REGa that are set in #N$04.
 $CD29 LD ($CE5A),A  ; Update the vertical step copy.
@label=SetUpSegment_Column
*$CD2C LD A,($CE36)  ; The column step.
 $CD2F LD ($5C24),A  ; Update the column step size.
 $CD32 LD A,($CE35)  ; The horizontal step.
 $CD35 LD ($CE59),A  ; Update the horizontal step copy.
 $CD38 AND A         ; {Jump to #R$CD44 if #REGa is not zero.
 $CD39 JR NZ,$CD44   ; }
 $CD3B LD A,($E41B)  ; The slope direction.
 $CD3E NEG           ; Negate #REGa.
 $CD40 ADD A,A       ; Double #REGa.
 $CD41 ADD A,A       ; Double #REGa.
 $CD42 ADD A,A       ; Double #REGa.
 $CD43 LD B,A        ; #REGb=#REGa.
@label=SetUpSegment_Absolute
*$CD44 LD ($5C25),A  ; Update the horizontal step size.
 $CD47 BIT 7,A       ; {Jump to #R$CD58 if bit 7 of #REGa is clear.
 $CD49 JR Z,$CD58    ; }
 $CD4B NEG           ; Negate #REGa.
 $CD4D LD ($5C25),A  ; Update the horizontal step size.
 $CD50 LD A,($5C24)  ; The column step size.
 $CD53 NEG           ; Negate #REGa.
 $CD55 LD ($5C24),A  ; Update the column step size.
@label=SetUpSegment_Flip
*$CD58 LD A,($5C26)  ; The upside down flag.
 $CD5B CP $99        ; {Return if #REGa is not #N$99.
 $CD5D RET NZ        ; }
 $CD5E LD A,($CE59)  ; The horizontal step copy.
 $CD61 AND A         ; {Return if #REGa is not zero.
 $CD62 RET NZ        ; }
 $CD63 LD A,($CE43)  ; The segment column.
 $CD66 ADD A,B       ; #REGa gains #REGb.
 $CD67 LD ($CE43),A  ; Update the segment column.
 $CD6A RET           ; Return.

; Read Segment Shapes
;
; Used by the routine at #R$D0BD.
; .
; Reads the two bytes that give the shapes at the ends of a flat segment
; from the script and stores them in #R$5C33 and #R$5C34. It changes them if
; the tile is drawn back to front or upside down. When the tile is back to
; front the horizontal position of the segment is mirrored and its type is
; changed with the table at #R$CE04. The routine finally stores the address of
; the rest of the script in #R$CE4D.
;
;   HL Address of the shape bytes in the script
; O:HL Address of the next segment in the script
@label=ReadSegmentShapes
c$CD6B LD A,($CE37)  ; The vertical step.
 $CD6E AND A         ; {Jump to #R$CDC3 if #REGa is not zero.
 $CD6F JR NZ,$CDC3   ; }
 $CD71 LD A,($5C26)  ; The upside down flag.
 $CD74 AND A         ; {Jump to #R$CD7F if #REGa is zero.
 $CD75 JR Z,$CD7F    ; }
 $CD77 LD A,($CE44)  ; The segment row.
 $CD7A XOR %00001100 ; Flip the bits of #REGa that are set in #N$0C.
 $CD7C LD ($CE44),A  ; Update the segment row.
@label=ReadSegmentShapes_BackToFront
*$CD7F LD A,($5C30)  ; The back to front flag.
 $CD82 AND A         ; {Jump to #R$CD9F if #REGa is zero.
 $CD83 JR Z,$CD9F    ; }
 $CD85 LD A,(HL)     ; Read #REGhl.
 $CD86 XOR %00000010 ; Flip the bits of #REGa that are set in #N$02.
 $CD88 LD ($5C34),A  ; Update the segment end shape.
 $CD8B INC HL        ; Advance #REGhl.
 $CD8C LD A,(HL)     ; Read #REGhl.
 $CD8D CP $16        ; {Jump to #R$CD99 if #REGa is #N$16.
 $CD8F JR Z,$CD99    ; }
 $CD91 XOR %00000010 ; Flip the bits of #REGa that are set in #N$02.
 $CD93 LD ($5C33),A  ; Update the segment start shape.
 $CD96 INC HL        ; Advance #REGhl.
 $CD97 JR $CDA9      ; Jump to #R$CDA9.
@label=ReadSegmentShapes_End
*$CD99 LD ($5C34),A  ; Update the segment end shape.
 $CD9C INC HL        ; Advance #REGhl.
 $CD9D JR $CDA9      ; Jump to #R$CDA9.
@label=ReadSegmentShapes_Normal
*$CD9F LD A,(HL)     ; Read #REGhl.
 $CDA0 LD ($5C33),A  ; Update the segment start shape.
 $CDA3 INC HL        ; Advance #REGhl.
 $CDA4 LD A,(HL)     ; Read #REGhl.
 $CDA5 LD ($5C34),A  ; Update the segment end shape.
 $CDA8 INC HL        ; Advance #REGhl.
@label=ReadSegmentShapes_UpsideDown
*$CDA9 LD A,($5C26)  ; The upside down flag.
 $CDAC AND A         ; {Jump to #R$CDC3 if #REGa is zero.
 $CDAD JR Z,$CDC3    ; }
 $CDAF LD A,($5C33)  ; The segment start shape.
 $CDB2 XOR %00000001 ; Flip the bits of #REGa that are set in #N$01.
 $CDB4 LD ($5C33),A  ; Update the segment start shape.
 $CDB7 LD A,($5C34)  ; The segment end shape.
 $CDBA CP $16        ; {Jump to #R$CDC3 if #REGa is #N$16.
 $CDBC JR Z,$CDC3    ; }
 $CDBE XOR %00000001 ; Flip the bits of #REGa that are set in #N$01.
 $CDC0 LD ($5C34),A  ; Update the segment end shape.
@label=ReadSegmentShapes_Store
*$CDC3 LD ($CE4D),HL ; Update the script pointer.
 $CDC6 LD A,($5C30)  ; The back to front flag.
 $CDC9 AND A         ; {Return if #REGa is zero.
 $CDCA RET Z         ; }
 $CDCB LD A,($5C34)  ; The segment end shape.
 $CDCE CP $16        ; {Return if #REGa is #N$16.
 $CDD0 RET Z         ; }
 $CDD1 LD A,($CE43)  ; The segment column.
 $CDD4 LD B,A        ; #REGb=#REGa.
 $CDD5 LD A,($5C25)  ; The horizontal step size.
 $CDD8 ADD A,B       ; #REGa gains #REGb.
 $CDD9 ADD A,$0F     ; Add #N$0F to #REGa.
 $CDDB CPL           ; Invert #REGa.
 $CDDC LD ($CE43),A  ; Update the segment column.
 $CDDF EXX           ; Switch to the alternate registers.
 $CDE0 LD E,(IX+$03) ; Read offset #N$03 of #REGix into #REGe.
 $CDE3 LD D,$00      ; Clear #REGd.
 $CDE5 LD HL,$CE04   ; The mirror type table.
 $CDE8 ADD HL,DE     ; #REGhl gains #REGde.
 $CDE9 LD A,(HL)     ; Read #REGhl.
 $CDEA LD (IX+$03),A ; Write #REGa to offset #N$03 of #REGix.
 $CDED CALL $E3D8    ; Call #R$E3D8.
 $CDF0 EXX           ; Switch to the alternate registers.
 $CDF1 LD A,($CE37)  ; The vertical step.
 $CDF4 AND A         ; {Return if #REGa is not zero.
 $CDF5 RET NZ        ; }
 $CDF6 LD B,C        ; #REGb=#REGc.
 $CDF7 LD A,($CE43)  ; The segment column.
 $CDFA DEC B         ; Step #REGb back.
 $CDFB RET Z         ; Return if the zero flag is set.
@label=ReadSegmentShapes_Position
*$CDFC SUB $18       ; Subtract #N$18 from #REGa.
 $CDFE DJNZ $CDFC    ; Decrease #REGb and jump to #R$CDFC until none remain.
 $CE00 LD ($CE43),A  ; Update the segment column.
 $CE03 RET           ; Return.

; Mirror Type Table
;
; The type to use for each of the sixteen types of segment when the tile
; is drawn back to front. #R$CD6B uses it.
@label=MirrorTypeTable
b$CE04 DEFB $00,$04,$05,$06,$01,$02,$03,$07,$0B,$0C,$0D,$08,$09,$0A,$0F,$0E

; Flip Type Table
;
; The type to use for each of the sixteen types of segment when the tile
; is drawn upside down. #R$CD08 uses it.
@label=FlipTypeTable
b$CE14 DEFB $07,$08,$09,$0A,$0B,$0C,$0D,$00,$01,$02,$03,$04,$05,$06,$0F,$0E

; Column Phase Table
;
; A value from #N$00 to #N$02 for each step of a segment, which #R$D3D2
; uses to choose the part of the picture to draw. The last byte is not used.
@label=ColumnPhaseTable
b$CE24 DEFB $00,$01,$00,$02,$02,$01,$00,$02,$01,$02,$00,$01,$02,$00,$01,$00
 $CE34 DEFB $02

; Horizontal Step
;
; The number of pixels that the current type of segment moves across the
; screen at each step, which is negative if it goes to the left. It is the
; first of the three steps that #R$E3D8 loads, and is also used by the routines
; that draw the ship parts.
@label=HorizontalStep
g$CE35 DEFB $00

; Column Step
;
; The second of the steps that #R$E3D8 loads: the number added to the
; screen address at each step of a segment, which is negative if it goes to the
; left.
@label=ColumnStep
g$CE36 DEFB $00

; Vertical Step
;
; The third of the steps that #R$E3D8 loads: the number of pixel rows
; that the current type of segment moves down the screen at each step, which is
; zero for a flat segment.
@label=VerticalStep
g$CE37 DEFB $00

; Not Used
s$CE38 DEFS $02

; Scratch Values
;
; Four bytes that many of the routines use for temporary values, and
; which #R$BEE7 uses for the position of an object within a tile.
@label=ScratchValues
g$CE3A DEFB $00
 $CE3B DEFB $00
 $CE3C DEFB $00
 $CE3D DEFB $00

; Attribute Rows
;
; The number of rows of attributes that #R$CF38 colours at each step of a
; segment.
@label=AttributeRows
g$CE3E DEFB $00

; Vertical Distance
;
; The number of pixel rows that the world moves vertically in a frame,
; which is the vertical speed without its sign. #R$DDF8 sets it. #R$D9A8 uses
; it as the number of rows of the edge to fill, with #R$DB49 if it is four and
; #R$DB41 otherwise.
@label=VerticalDistance
g$CE3F DEFB $00

; Segment Height
;
; Set by #R$D3D2 to the pixel row where the picture of a segment starts.
; #R$D672 reads it.
@label=SegmentHeight
g$CE40 DEFB $00

; Horizontal Offset
;
; How far the view of the world is across the first tile, from #N$00 to
; #N$20 pixels. #R$DE46 adds the horizontal speed to it. Its bottom three bits
; choose which of the tables of shifted pictures is used.
@label=HorizontalOffset
g$CE41 DEFB $00

; Vertical Offset
;
; How far the view of the world is down the first tile, from #N$00 to
; #N$A0 pixel rows. #R$DE09 adds the vertical speed to it.
@label=VerticalOffset
g$CE42 DEFB $00

; Segment Column
;
; The pixel column where the current segment starts. The script gives it
; and #R$D319 adds the horizontal step at each step of the segment.
@label=SegmentColumn
g$CE43 DEFB $00

; Segment Row
;
; The pixel row where the current segment starts. The script gives it and
; #R$D319 subtracts the vertical step at each step of the segment.
@label=SegmentRow
g$CE44 DEFB $00

; Position Across
;
; The pixel column that the tests of a segment at #R$D25A compare the
; segment with. #R$DE46 subtracts the horizontal speed from it, and when it
; leaves the range #N$08 to #N$E8 (the width of the area of the terrain) the
; map position moves one tile and it wraps round.
@label=PositionAcross
g$CE45 DEFB $00

; Position Down
;
; The pixel row that the tests of a segment at #R$D25A compare the
; segment with. #R$DE09 subtracts the vertical speed from it, and when it
; leaves the range #N$17 to #N$B7 (the height of the area of the terrain) the
; map position moves one tile and it wraps round.
@label=PositionDown
g$CE46 DEFB $00

; Picture Pointer
;
; The address of the picture of the current segment, which #R$D3D2 sets
; and #R$D672 reads.
@label=PicturePointer
g$CE47 DEFW $0000

; Segment Screen Address
;
; The screen address where the drawing of the current segment is up to.
@label=SegmentScreenAddress
g$CE49 DEFW $0000

; Picture Offsets Pointer
;
; A pointer into #R$CCBF that #R$D0BD sets: to the start of the table
; when the horizontal offset has no pixels to the side of a whole byte, or one
; byte on otherwise. #R$D3D2 adds the offset of the type to set #R$CE51.
@label=PictureOffsetsPointer
g$CE4B DEFW $0000

; Script Pointer
;
; The address in the script of the next segment, which #R$CD6B sets.
@label=ScriptPointer
g$CE4D DEFW $0000

; Saved Screen Address
;
; A screen address that #R$D5EC and #R$D937 store. #R$D711 and #R$D8DA
; read it.
@label=SavedScreenAddress
g$CE4F DEFW $0000

; Segment Picture Offsets
;
; The address of the six bytes in #R$CCBF for the type of the current
; segment, which #R$D3D2 sets.
@label=SegmentPictureOffsets
g$CE51 DEFW $0000

; Saved Row
;
; A pixel row that #R$D937 stores. #R$D711 and #R$D8DA read it.
@label=SavedRow
g$CE53 DEFB $00

; Steps Drawn
;
; The number of steps of the current segment that have been drawn so far.
@label=StepsDrawn
g$CE54 DEFB $00

; Start Column
;
; The pixel column where the first step that was seen of the current
; segment started, which #R$D979 stores.
@label=StartColumn
g$CE55 DEFB $00

; Start Row
;
; The pixel row where the first step that was seen of the current segment
; started, which #R$D979 stores.
@label=StartRow
g$CE56 DEFB $00

; Map Position
;
; The map column (in the first byte) and map row (in the second) of the
; tile at the top left of the view of the world.
@label=MapPosition
g$CE57 DEFB $00
 $CE58 DEFB $00

; Horizontal Step Copy
;
; A copy of the horizontal step of the type of the current segment. It is
; zero for a vertical segment.
@label=HorizontalStepCopy
g$CE59 DEFB $00

; Vertical Step Copy
;
; A copy of the vertical step of the type of the current segment, which
; is set to #N$04 when it is zero. Some routines use it as a count of rows.
@label=VerticalStepCopy
g$CE5A DEFB $00

; Count Vertical Contact
;
; Used by the routine at #R$D319.
; .
; Used when the ship touches the top or bottom of a segment. On the top
; row of tiles a vertical segment is made to end at the next step. The count of
; steps drawn is increased, and when it is the first the start of the segment
; is noted with #R$D979. The routine then carries on with the next step at
; #R$D724.
@label=CountVerticalContact
c$CE5B LD A,($5C1D)  ; The tile number.
 $CE5E BIT 0,A       ; {Jump to #R$CE6A if bit 0 of #REGa is set.
 $CE60 JR NZ,$CE6A   ; }
 $CE62 LD A,($CE37)  ; The vertical step.
 $CE65 AND A         ; {Jump to #R$CE6A if #REGa is zero.
 $CE66 JR Z,$CE6A    ; }
 $CE68 LD C,$01      ; #REGc=#N$01.
@label=CountVerticalContact_Count
*$CE6A LD A,($CE54)  ; The steps already drawn.
 $CE6D INC A         ; Advance #REGa.
 $CE6E LD ($CE54),A  ; Update the steps already drawn.
 $CE71 CP $01        ; {Call #R$D979 if #REGa is #N$01.
 $CE73 CALL Z,$D979  ; }
 $CE76 JP $D724      ; Jump to #R$D724.

; Record Floor Contact
;
; Used by the routine at #R$D319.
; .
; Used when the ship is on the same row as a step of a segment. It sets
; bit 7 of the contact flags at #R$5C31. If the vertical speed is not negative
; it also sets bit 0 (clearing bit 7) and copies the flags into #R$5C32. It
; carries on at #R$D36C.
@label=FlagFloorContact
c$CE79 LD A,($5C31)  ; The contact flags.
 $CE7C OR %10000000  ; Set the bits of #REGa that are set in #N$80.
 $CE7E LD ($5C31),A  ; Update the contact flags.
 $CE81 LD A,($CCBA)  ; The vertical scroll speed.
 $CE84 BIT 7,A       ; {Jump to #R$D36C if bit 7 of #REGa is set.
 $CE86 JP NZ,$D36C   ; }
 $CE89 LD A,($5C31)  ; The contact flags.
 $CE8C XOR %10000001 ; Flip the bits of #REGa that are set in #N$81.
 $CE8E LD ($5C31),A  ; Update the contact flags.
 $CE91 LD ($5C32),A  ; Update the last contact flags.
 $CE94 JP $D36C      ; Jump to #R$D36C.

; Record Ceiling Contact
;
; Used by the routine at #R$D319.
; .
; Used when the ship is on the same row as a step of a segment in the
; bottom half of the tile. It sets bit 7 of the contact flags at #R$5C31. If
; the vertical speed is negative it also sets bit 1 (clearing bit 7) and copies
; the flags into #R$5C32. It carries on at #R$D36C.
@label=FlagCeilingContact
c$CE97 LD A,($5C31)  ; The contact flags.
 $CE9A OR %10000000  ; Set the bits of #REGa that are set in #N$80.
 $CE9C LD ($5C31),A  ; Update the contact flags.
 $CE9F LD A,($CCBA)  ; The vertical scroll speed.
 $CEA2 BIT 7,A       ; {Jump to #R$D36C if bit 7 of #REGa is clear.
 $CEA4 JP Z,$D36C    ; }
 $CEA7 LD A,($5C31)  ; The contact flags.
 $CEAA XOR %10000010 ; Flip the bits of #REGa that are set in #N$82.
 $CEAC LD ($5C31),A  ; Update the contact flags.
 $CEAF LD ($5C32),A  ; Update the last contact flags.
 $CEB2 JP $D36C      ; Jump to #R$D36C.

; Record Left Contact
;
; Used by the routine at #R$D319.
; .
; Used when the ship is in the same column as a step of a segment. When
; the horizontal speed is negative it sets bit 3 of the contact flags at
; #R$5C31 and carries on at #R$D3B0. Otherwise the next step is drawn.
@label=FlagLeftContact
c$CEB5 LD A,($CCBB)  ; The horizontal scroll speed.
 $CEB8 BIT 7,A       ; {Jump to #R$D724 if bit 7 of #REGa is clear.
 $CEBA JP Z,$D724    ; }
 $CEBD LD A,($5C31)  ; The contact flags.
 $CEC0 OR %00001000  ; Set the bits of #REGa that are set in #N$08.
 $CEC2 LD ($5C31),A  ; Update the contact flags.
 $CEC5 JP $D3B0      ; Jump to #R$D3B0.

; Record Right Contact
;
; Used by the routine at #R$D319.
; .
; Used when the ship is in the same column as a step of a segment. When
; the horizontal speed is not negative it sets bit 2 of the contact flags at
; #R$5C31 and carries on at #R$D3B0. Otherwise the next step is drawn.
@label=FlagRightContact
c$CEC8 LD A,($CCBB)  ; The horizontal scroll speed.
 $CECB BIT 7,A       ; {Jump to #R$D724 if bit 7 of #REGa is set.
 $CECD JP NZ,$D724   ; }
 $CED0 LD A,($5C31)  ; The contact flags.
 $CED3 OR %00000100  ; Set the bits of #REGa that are set in #N$04.
 $CED5 LD ($5C31),A  ; Update the contact flags.
 $CED8 JP $D3B0      ; Jump to #R$D3B0.

; Note Wall Contact
;
; Used by the routine at #R$D319.
; .
; Used when the ship has touched the side of a segment. For a segment
; that has a horizontal step the remaining length is limited to two steps if
; the slope goes the way that the tile is facing. If the ship has not touched a
; segment already the routine finds the screen address of the start with
; #R$D937 and clears the first byte of the record. It carries on at #R$D716.
@label=NoteWallContact
c$CEDB LD A,($CE59)  ; The horizontal step copy.
 $CEDE AND A         ; {Jump to #R$CF01 if #REGa is zero.
 $CEDF JR Z,$CF01    ; }
 $CEE1 LD A,($5C1D)  ; The tile number.
 $CEE4 BIT 1,A       ; {Jump to #R$CEF8 if bit 1 of #REGa is set.
 $CEE6 JR NZ,$CEF8   ; }
 $CEE8 LD A,($E41B)  ; The slope direction.
 $CEEB CP $01        ; {Jump to #R$CF01 if #REGa is not #N$01.
 $CEED JR NZ,$CF01   ; }
@label=NoteWallContact_Limit
*$CEEF LD A,C        ; #REGa=#REGc.
 $CEF0 CP $02        ; {Jump to #R$CF01 if #REGa is less than #N$02.
 $CEF2 JR C,$CF01    ; }
 $CEF4 LD C,$02      ; #REGc=#N$02.
 $CEF6 JR $CF01      ; Jump to #R$CF01.
@label=NoteWallContact_Right
*$CEF8 LD A,($E41B)  ; The slope direction.
 $CEFB CP $FF        ; {Jump to #R$CF01 if #REGa is not #N$FF.
 $CEFD JR NZ,$CF01   ; }
 $CEFF JR $CEEF      ; Jump to #R$CEEF.
@label=NoteWallContact_Check
*$CF01 LD A,($5C2F)  ; The flagged steps.
 $CF04 AND A         ; {Jump to #R$D716 if #REGa is not zero.
 $CF05 JP NZ,$D716   ; }
 $CF08 EXX           ; Switch to the alternate registers.
 $CF09 CALL $D937    ; Call #R$D937.
 $CF0C XOR A         ; Clear #REGa.
 $CF0D LD (IX+$01),A ; Write #REGa to offset #N$01 of #REGix.
 $CF10 EXX           ; Switch to the alternate registers.
 $CF11 JP $D716      ; Jump to #R$D716.

; Test Attribute Address
;
; Used by the routines at #R$D04F, #R$D063 and #R$D082.
; .
; Tests the attribute address after the one in #REGhl. The top three rows
; of attributes and the last row are not part of the area where the terrain is
; drawn.
;
;   HL Attribute address
; O:F Zero if the next address is outside the area of the terrain
@label=TestAttributeAddress
c$CF14 INC HL        ; Advance #REGhl.
 $CF15 LD A,H        ; #REGa=#REGh.
 $CF16 CP $58        ; {Jump to #R$CF28 if #REGa is not #N$58.
 $CF18 JR NZ,$CF28   ; }
 $CF1A LD A,L        ; #REGa=#REGl.
 $CF1B AND %11100000 ; Keep the bits of #REGa that are set in #N$E0.
 $CF1D CP $60        ; {Jump to #R$CF25 if #REGa is less than #N$60.
 $CF1F JR C,$CF25    ; }
@label=TestAttributeAddress_Inside
*$CF21 DEC HL        ; Step #REGhl back.
 $CF22 OR %11111111  ; Set the bits of #REGa that are set in #N$FF.
 $CF24 RET           ; Return.
@label=TestAttributeAddress_Outside
*$CF25 DEC HL        ; Step #REGhl back.
 $CF26 XOR A         ; Clear #REGa.
 $CF27 RET           ; Return.
@label=TestAttributeAddress_Rows
*$CF28 LD A,H        ; #REGa=#REGh.
 $CF29 CP $5A        ; {Jump to #R$CF21 if #REGa is not #N$5A.
 $CF2B JR NZ,$CF21   ; }
 $CF2D LD A,L        ; #REGa=#REGl.
 $CF2E AND %11100000 ; Keep the bits of #REGa that are set in #N$E0.
 $CF30 CP $E0        ; {Jump to #R$CF25 if #REGa is #N$E0 or more.
 $CF32 JR NC,$CF25   ; }
 $CF34 JR $CF21      ; Jump to #R$CF21.

; Jump To Painter
;
; Used by the routine at #R$CF38.
; .
; Jumps to the routine that paints one row of attributes, which #R$CF38
; has chosen: one of #R$D04F, #R$D063 and #R$D082.
@label=JumpToPainter
c$CF36 JP (IY)       ; Jump to the address in #REGiy.

; Colour Segment
;
; Used by the routine at #R$D7F8.
; .
; Colours the attribute cells that a segment covers, one step at a time.
; Nothing is coloured if #R$5C3C is set or if the drawing record has no screen
; address or no length. The number of cells across at each step (one to three)
; chooses the routine that paints the cells of a column: a flat segment is
; painted three cells across. The colour is #R$5C3A for a tile on the top row
; and #R$5C3B for one on the bottom row, with the colours at #R$DC95 and
; #R$DC96 used for some of the tiles on map rows #N$0B and #N$0C.
;
; IX Address of the drawing record at #R$DEDC
@label=ColourSegment
c$CF38 LD A,($5C3C)  ; The scroll-in flag.
 $CF3B AND A         ; {Return if #REGa is not zero.
 $CF3C RET NZ        ; }
 $CF3D LD A,(IX+$01) ; Read offset #N$01 of #REGix.
 $CF40 AND A         ; {Return if #REGa is zero.
 $CF41 RET Z         ; }
 $CF42 LD A,(IX+$02) ; Read offset #N$02 of #REGix.
 $CF45 AND A         ; {Return if #REGa is zero.
 $CF46 RET Z         ; }
 $CF47 LD A,($CE59)  ; The horizontal step copy.
 $CF4A AND A         ; {Jump to #R$CF54 if #REGa is not zero.
 $CF4B JR NZ,$CF54   ; }
 $CF4D LD ($CE36),A  ; Update the column step.
 $CF50 INC A         ; Advance #REGa.
 $CF51 LD ($5C24),A  ; Update the column step size.
@label=ColourSegment_Cells
*$CF54 LD A,($5C24)  ; The column step size.
 $CF57 INC A         ; Advance #REGa.
 $CF58 LD C,A        ; #REGc=#REGa.
 $CF59 LD A,($E41B)  ; The slope direction.
 $CF5C CP $FF        ; {Jump to #R$CF6A if #REGa is #N$FF.
 $CF5E JR Z,$CF6A    ; }
 $CF60 LD A,(IX+$00) ; Read offset #N$00 of #REGix.
 $CF63 SUB $02       ; Subtract #N$02 from #REGa.
 $CF65 AND %11111000 ; Keep the bits of #REGa that are set in #N$F8.
 $CF67 LD (IX+$00),A ; Write #REGa to offset #N$00 of #REGix.
@label=ColourSegment_Painter
*$CF6A LD A,C        ; #REGa=#REGc.
 $CF6B LD IY,$D04F   ; The paint one column.
 $CF6F CP $01        ; {Jump to #R$CF7F if #REGa is #N$01.
 $CF71 JR Z,$CF7F    ; }
 $CF73 LD IY,$D063   ; The paint two columns.
 $CF77 CP $02        ; {Jump to #R$CF7F if #REGa is #N$02.
 $CF79 JR Z,$CF7F    ; }
 $CF7B LD IY,$D082   ; The paint three columns.
@label=ColourSegment_Rows
*$CF7F LD A,($CE37)  ; The vertical step.
 $CF82 SRL A         ; Shift #REGa right.
 $CF84 SRL A         ; Shift #REGa right.
 $CF86 SRL A         ; Shift #REGa right.
 $CF88 LD ($CE5A),A  ; Update the vertical step copy.
 $CF8B LD L,(IX+$00) ; Read offset #N$00 of #REGix into #REGl.
 $CF8E LD H,(IX+$01) ; Read offset #N$01 of #REGix into #REGh.
 $CF91 LD A,($CE5A)  ; The vertical step copy.
 $CF94 LD ($CE3E),A  ; Update the attribute rows.
 $CF97 LD A,H        ; #REGa=#REGh.
 $CF98 AND %00000111 ; Keep the bits of #REGa that are set in #N$07.
 $CF9A XOR %00000111 ; Flip the bits of #REGa that are set in #N$07.
 $CF9C JR Z,$CFA5    ; Jump to #R$CFA5 if the zero flag is set.
 $CF9E LD A,($CE3E)  ; The attribute rows.
 $CFA1 INC A         ; Advance #REGa.
 $CFA2 LD ($CE3E),A  ; Update the attribute rows.
@label=ColourSegment_Flat
*$CFA5 LD A,(IX+$03) ; Read offset #N$03 of #REGix.
 $CFA8 AND A         ; {Jump to #R$CFAF if #REGa is zero.
 $CFA9 JR Z,$CFAF    ; }
 $CFAB CP $07        ; {Jump to #R$CFC8 if #REGa is not #N$07.
 $CFAD JR NZ,$CFC8   ; }
@label=ColourSegment_FlatCells
*$CFAF LD IY,$D082   ; The paint three columns.
 $CFB3 XOR A         ; Clear #REGa.
 $CFB4 LD ($CE5A),A  ; Update the vertical step copy.
 $CFB7 LD A,H        ; #REGa=#REGh.
 $CFB8 SUB $0B       ; Subtract #N$0B from #REGa.
 $CFBA LD B,A        ; #REGb=#REGa.
 $CFBB LD A,H        ; #REGa=#REGh.
 $CFBC OR %00000111  ; Set the bits of #REGa that are set in #N$07.
 $CFBE SUB B         ; Subtract #REGb from #REGa.
 $CFBF SRL A         ; Shift #REGa right.
 $CFC1 SRL A         ; Shift #REGa right.
 $CFC3 SRL A         ; Shift #REGa right.
 $CFC5 LD ($CE3E),A  ; Update the attribute rows.
@label=ColourSegment_Address
*$CFC8 LD B,L        ; #REGb=#REGl.
 $CFC9 LD A,L        ; #REGa=#REGl.
 $CFCA CP $F0        ; {Jump to #R$CFD0 if #REGa is less than #N$F0.
 $CFCC JR C,$CFD0    ; }
 $CFCE LD L,$00      ; Clear #REGl.
@label=ColourSegment_Convert
*$CFD0 CALL $A170    ; Call #R$A170.
 $CFD3 LD A,B        ; #REGa=#REGb.
 $CFD4 CP $F0        ; {Jump to #R$CFD9 if #REGa is less than #N$F0.
 $CFD6 JR C,$CFD9    ; }
 $CFD8 DEC HL        ; Step #REGhl back.
@label=ColourSegment_Colour
*$CFD9 LD A,($5C3A)  ; The top-tile colour.
 $CFDC LD C,A        ; #REGc=#REGa.
 $CFDD LD A,($5C1D)  ; The tile number.
 $CFE0 BIT 0,A       ; {Jump to #R$CFE8 if bit 0 of #REGa is clear.
 $CFE2 JR Z,$CFE8    ; }
 $CFE4 LD A,($5C3B)  ; The bottom-tile colour.
 $CFE7 LD C,A        ; #REGc=#REGa.
@label=ColourSegment_Row
*$CFE8 LD A,($CE58)  ; The map row.
 $CFEB CP $0B        ; {Jump to #R$CFFC if #REGa is #N$0B.
 $CFED JR Z,$CFFC    ; }
 $CFEF CP $0C        ; {Jump to #R$D012 if #REGa is not #N$0C.
 $CFF1 JR NZ,$D012   ; }
 $CFF3 LD A,($5C1D)  ; The tile number.
 $CFF6 BIT 0,A       ; {Jump to #R$D012 if bit 0 of #REGa is set.
 $CFF8 JR NZ,$D012   ; }
 $CFFA JR $D003      ; Jump to #R$D003.
@label=ColourSegment_Special
*$CFFC LD A,($5C1D)  ; The tile number.
 $CFFF BIT 0,A       ; {Jump to #R$D012 if bit 0 of #REGa is clear.
 $D001 JR Z,$D012    ; }
@label=ColourSegment_Alternate
*$D003 LD A,($DC96)  ; The underground attribute.
 $D006 LD C,A        ; #REGc=#REGa.
 $D007 LD A,($CE3C)  ; The vertical edge in the tile.
 $D00A CP $67        ; {Jump to #R$D012 if #REGa is #N$67 or more.
 $D00C JR NC,$D012   ; }
 $D00E LD A,($DC95)  ; The sky attribute.
 $D011 LD C,A        ; #REGc=#REGa.
@label=ColourSegment_Paint
*$D012 LD DE,$0020   ; #REGde=#N$20.
 $D015 LD B,(IX+$02) ; Read offset #N$02 of #REGix into #REGb.
@label=ColourSegment_Loop
*$D018 PUSH BC       ; Stash #REGbc on the stack.
 $D019 LD A,($CE3E)  ; The attribute rows.
 $D01C LD B,A        ; #REGb=#REGa.
 $D01D PUSH HL       ; Stash #REGhl on the stack.
 $D01E CALL $CF36    ; Call #R$CF36.
 $D021 POP HL        ; Bring #REGhl back off the stack.
 $D022 LD A,($CE5A)  ; The vertical step copy.
 $D025 AND A         ; {Jump to #R$D02E if #REGa is zero.
 $D026 JR Z,$D02E    ; }
 $D028 LD B,A        ; #REGb=#REGa.
@label=ColourSegment_Up
*$D029 AND A         ; Is #REGa zero?
 $D02A SBC HL,DE     ; Subtract #REGde and the carry from #REGhl.
 $D02C DJNZ $D029    ; Decrease #REGb and jump to #R$D029 until none remain.
@label=ColourSegment_Across
*$D02E LD A,($CE36)  ; The column step.
 $D031 LD C,A        ; #REGc=#REGa.
 $D032 LD B,$00      ; Clear #REGb.
 $D034 BIT 7,A       ; {Jump to #R$D039 if bit 7 of #REGa is clear.
 $D036 JR Z,$D039    ; }
 $D038 DEC B         ; Step #REGb back.
@label=ColourSegment_Advance
*$D039 ADD HL,BC     ; #REGhl gains #REGbc.
 $D03A POP BC        ; Bring #REGbc back off the stack.
 $D03B DJNZ $D018    ; Decrease #REGb and jump to #R$D018 until none remain.
 $D03D LD A,($5C34)  ; The segment end shape.
 $D040 AND %01111111 ; Keep the bits of #REGa that are set in #N$7F.
 $D042 CP $13        ; {Return if #REGa is not #N$13.
 $D044 RET NZ        ; }
 $D045 LD A,($CE41)  ; The horizontal offset.
 $D048 AND %00000111 ; Keep the bits of #REGa that are set in #N$07.
 $D04A RET Z         ; Return if the zero flag is set.
@label=ColourSegment_Edge
 $D04B LD A,($CE3E)  ; The attribute rows.
 $D04E LD B,A        ; #REGb=#REGa.
; Continue on to #R$D04F.

; Paint One Column
;
; Paints one attribute cell in each of the rows going up the screen, but
; only the cells inside the area of the terrain.
;
; B Number of rows
; C Attribute value
; DE #N$0020
; HL Attribute address of the bottom cell
@label=PaintOneColumn
c$D04F CALL $CF14    ; Call #R$CF14.
 $D052 JR Z,$D05D    ; Jump to #R$D05D if the zero flag is set.
 $D054 LD A,L        ; #REGa=#REGl.
 $D055 AND %00011111 ; Keep the bits of #REGa that are set in #N$1F.
 $D057 DEC A         ; Step #REGa back.
 $D058 CP $1C        ; {Jump to #R$D05D if #REGa is #N$1C or more.
 $D05A JR NC,$D05D   ; }
 $D05C LD (HL),C     ; Write #REGc where #REGhl points.
@label=PaintOneColumn_Next
*$D05D AND A         ; Is #REGa zero?
 $D05E SBC HL,DE     ; Subtract #REGde and the carry from #REGhl.
 $D060 DJNZ $D04F    ; Decrease #REGb and jump to #R$D04F until none remain.
 $D062 RET           ; Return.

; Paint Two Columns
;
; Paints two attribute cells in each of the rows going up the screen, but
; only the cells inside the area of the terrain.
;
; B Number of rows
; C Attribute value
; DE #N$0020
; HL Attribute address of the bottom left cell
@label=PaintTwoColumns
c$D063 CALL $CF14    ; Call #R$CF14.
 $D066 JR Z,$D07C    ; Jump to #R$D07C if the zero flag is set.
 $D068 LD A,L        ; #REGa=#REGl.
 $D069 AND %00011111 ; Keep the bits of #REGa that are set in #N$1F.
 $D06B DEC A         ; Step #REGa back.
 $D06C CP $1C        ; {Jump to #R$D071 if #REGa is #N$1C or more.
 $D06E JR NC,$D071   ; }
 $D070 LD (HL),C     ; Write #REGc where #REGhl points.
@label=PaintTwoColumns_Second
*$D071 INC HL        ; Advance #REGhl.
 $D072 LD A,L        ; #REGa=#REGl.
 $D073 AND %00011111 ; Keep the bits of #REGa that are set in #N$1F.
 $D075 DEC A         ; Step #REGa back.
 $D076 CP $1C        ; {Jump to #R$D07B if #REGa is #N$1C or more.
 $D078 JR NC,$D07B   ; }
 $D07A LD (HL),C     ; Write #REGc where #REGhl points.
@label=PaintTwoColumns_Restore
*$D07B DEC HL        ; Step #REGhl back.
@label=PaintTwoColumns_Next
*$D07C AND A         ; Is #REGa zero?
 $D07D SBC HL,DE     ; Subtract #REGde and the carry from #REGhl.
 $D07F DJNZ $D063    ; Decrease #REGb and jump to #R$D063 until none remain.
 $D081 RET           ; Return.

; Paint Three Columns
;
; Paints three attribute cells in each of the rows going up the screen,
; but only the cells inside the area of the terrain.
;
; B Number of rows
; C Attribute value
; DE #N$0020
; HL Attribute address of the bottom left cell
@label=PaintThreeColumns
c$D082 CALL $CF14    ; Call #R$CF14.
 $D085 JR Z,$D0A6    ; Jump to #R$D0A6 if the zero flag is set.
 $D087 LD A,L        ; #REGa=#REGl.
 $D088 AND %00011111 ; Keep the bits of #REGa that are set in #N$1F.
 $D08A DEC A         ; Step #REGa back.
 $D08B CP $1C        ; {Jump to #R$D090 if #REGa is #N$1C or more.
 $D08D JR NC,$D090   ; }
 $D08F LD (HL),C     ; Write #REGc where #REGhl points.
@label=PaintThreeColumns_Second
*$D090 INC HL        ; Advance #REGhl.
 $D091 LD A,L        ; #REGa=#REGl.
 $D092 AND %00011111 ; Keep the bits of #REGa that are set in #N$1F.
 $D094 DEC A         ; Step #REGa back.
 $D095 CP $1C        ; {Jump to #R$D09A if #REGa is #N$1C or more.
 $D097 JR NC,$D09A   ; }
 $D099 LD (HL),C     ; Write #REGc where #REGhl points.
@label=PaintThreeColumns_Third
*$D09A INC HL        ; Advance #REGhl.
 $D09B LD A,L        ; #REGa=#REGl.
 $D09C AND %00011111 ; Keep the bits of #REGa that are set in #N$1F.
 $D09E DEC A         ; Step #REGa back.
 $D09F CP $1C        ; {Jump to #R$D0A4 if #REGa is #N$1C or more.
 $D0A1 JR NC,$D0A4   ; }
 $D0A3 LD (HL),C     ; Write #REGc where #REGhl points.
@label=PaintThreeColumns_Restore
*$D0A4 DEC HL        ; Step #REGhl back.
 $D0A5 DEC HL        ; Step #REGhl back.
@label=PaintThreeColumns_Next
*$D0A6 AND A         ; Is #REGa zero?
 $D0A7 SBC HL,DE     ; Subtract #REGde and the carry from #REGhl.
 $D0A9 DJNZ $D082    ; Decrease #REGb and jump to #R$D082 until none remain.
 $D0AB RET           ; Return.

; Segment Codes
;
; A code for each of the sixteen types of segment, which #R$D0BD stores
; at offset #N$04 of the record that it makes for the segment (the first four
; bytes are the position and size). Purpose not yet known.
@label=SegmentCodes
b$D0AC DEFB $04,$01,$02,$03,$41,$42,$43,$08,$81,$82,$83,$C1,$C2,$C3,$10,$20

; Collision Kind
;
; What the ship has collided with: zero for nothing, #N$80 for an object,
; #N($FF) or #N$01 for the terrain. The routines that detect collisions set it
; and #R$C5D2 clears it each frame.
@label=CollisionKind
g$D0BC DEFB $00

; Draw Terrain
;
; Used by the routine at #R$DDF8.
; .
; Draws the terrain of the four tiles that are in view, by running the
; script of each tile. The number of the tile is kept in #R$5C1D: bit 0 is set
; for a tile below the first and bit 1 for a tile to the right. The scripts of
; the tiles are found from the table at #R$DC87. Each tile is a list of
; segments, and each segment is set up with #R$CD08 and #R$CD6B and then drawn
; step by step, each step of a segment being a piece of picture. #R$5C3D is
; non-zero when the tiles have changed, and then the routine also makes a
; record of each segment in the area from #R$5B80: a count byte for the tile
; followed by five bytes for each segment (the position, the size and the code
; from #R$D0AC), which the routines that move objects use to test for
; collisions with the terrain. The segments that are not near the position at
; #R$CE45 and #R$CE46 are not drawn.
@label=DrawTerrain
c$D0BD LD A,($5C3C)    ; The scroll-in flag.
 $D0C0 AND A           ; {Jump to #R$D0C6 if #REGa is zero.
 $D0C1 JR Z,$D0C6      ; }
 $D0C3 LD ($5C3D),A    ; Update the tiles changed.
; Choose the table of shifted pictures for the horizontal offset, and
; the offsets table that goes with it.
@label=DrawTerrain_Tables
*$D0C6 LD A,($CE42)    ; The vertical offset.
 $D0C9 ADD A,$60       ; Add #N$60 to #REGa.
 $D0CB LD ($CE42),A    ; Update the vertical offset.
 $D0CE LD DE,$CCBF     ; The picture offsets.
 $D0D1 LD ($CE4B),DE   ; Update the picture offsets pointer.
 $D0D5 EXX             ; Switch to the alternate registers.
 $D0D6 LD HL,$E37D     ; The shape table shift zero.
 $D0D9 LD A,($CE41)    ; The horizontal offset.
 $D0DC AND %00000111   ; Keep the bits of #REGa that are set in #N$07.
 $D0DE JR Z,$D0F8      ; Jump to #R$D0F8 if the zero flag is set.
 $D0E0 EXX             ; Switch to the alternate registers.
 $D0E1 INC DE          ; Advance #REGde.
 $D0E2 LD ($CE4B),DE   ; Update the picture offsets pointer.
 $D0E6 EXX             ; Switch to the alternate registers.
 $D0E7 LD HL,$E2BD     ; The shape table shift two.
 $D0EA CP $02          ; {Jump to #R$D0F8 if #REGa is #N$02.
 $D0EC JR Z,$D0F8      ; }
 $D0EE LD HL,$E2FD     ; The shape table shift four.
 $D0F1 CP $04          ; {Jump to #R$D0F8 if #REGa is #N$04.
 $D0F3 JR Z,$D0F8      ; }
 $D0F5 LD HL,$E33D     ; The shape table shift six.
; Run the script of each of the four tiles in turn.
@label=DrawTerrain_Tile
*$D0F8 LD ($CCBD),HL   ; Update the shape table pointer.
 $D0FB XOR A           ; Clear #REGa.
 $D0FC LD ($5C1D),A    ; Update the tile number.
; This entry point is used by the routine at #R$D80A.
@label=DrawTerrain_Record
*$D0FF LD IX,$5B80     ; The decryption routine.
 $D103 LD A,($5C1D)    ; The tile number.
 $D106 AND A           ; {Jump to #R$D11D if #REGa is zero.
 $D107 JR Z,$D11D      ; }
 $D109 LD IX,$5BA5     ; Use #N$5BA5.
 $D10D CP $01          ; {Jump to #R$D11D if #REGa is #N$01.
 $D10F JR Z,$D11D      ; }
 $D111 LD IX,$5BCA     ; Use #N$5BCA.
 $D115 CP $02          ; {Jump to #R$D11D if #REGa is #N$02.
 $D117 JR Z,$D11D      ; }
 $D119 LD IX,$5BEF     ; Use #N$5BEF.
; Read the address of the script of the tile and see if it starts with the
; prefix bytes that draw it upside down (#N($99)) and back to front (#N($FF)).
@label=DrawTerrain_Script
*$D11D LD HL,($DC87)   ; Fetch the word at #R$DC87 into #REGhl.
 $D120 LD E,(HL)       ; Read #REGhl into #REGe.
 $D121 INC HL          ; Advance #REGhl.
 $D122 LD D,(HL)       ; Read #REGhl into #REGd.
 $D123 INC HL          ; Advance #REGhl.
 $D124 LD ($DC87),HL   ; Update the tile script pointer.
 $D127 EX DE,HL        ; Swap #REGde and #REGhl.
 $D128 XOR A           ; Clear #REGa.
 $D129 LD ($5C30),A    ; Update the back to front flag.
 $D12C LD ($5C26),A    ; Update the upside down flag.
 $D12F LD (IX+$00),A   ; Write #REGa to offset #N$00 of #REGix.
 $D132 LD A,(HL)       ; Read #REGhl.
 $D133 AND A           ; {Jump to #R$D81A if #REGa is zero.
 $D134 JP Z,$D81A      ; }
 $D137 CP $99          ; {Jump to #R$D13F if #REGa is not #N$99.
 $D139 JR NZ,$D13F     ; }
 $D13B LD ($5C26),A    ; Update the upside down flag.
 $D13E INC HL          ; Advance #REGhl.
@label=DrawTerrain_BackToFront
*$D13F LD A,(HL)       ; Read #REGhl.
 $D140 CP $FF          ; {Jump to #R$D148 if #REGa is not #N$FF.
 $D142 JR NZ,$D148     ; }
 $D144 LD ($5C30),A    ; Update the back to front flag.
 $D147 INC HL          ; Advance #REGhl.
@label=DrawTerrain_Count
*$D148 LD A,(HL)       ; Read #REGhl.
 $D149 CP $95          ; {Jump to #R$D14F if #REGa is less than #N$95.
 $D14B JR C,$D14F      ; }
 $D14D INC HL          ; Advance #REGhl.
 $D14E LD A,(HL)       ; Read #REGhl.
@label=DrawTerrain_Remember
*$D14F LD ($5C20),A    ; Update the segments still to draw.
 $D152 LD (IX+$00),A   ; Write #REGa to offset #N$00 of #REGix.
 $D155 INC IX          ; Advance #REGix.
 $D157 INC HL          ; Advance #REGhl.
 $D158 LD ($BA09),IX   ; The segment record.
; This entry point is used by the routine at #R$D80A.
; .
; Start a segment: clear the variables, read its position and type from
; the script and set up its slope and shapes.
@label=DrawTerrain_Segment
*$D15C LD IX,$DEDC     ; The segment record.
 $D160 XOR A           ; Clear #REGa.
 $D161 LD ($5C2F),A    ; Update the flagged steps.
 $D164 LD ($CE54),A    ; Update the steps already drawn.
 $D167 LD ($5C32),A    ; Update the last contact flags.
 $D16A LD ($5C27),A    ; Update the shape flag.
 $D16D LD ($5C34),A    ; Update the segment end shape.
 $D170 LD ($5C33),A    ; Update the segment start shape.
 $D173 LD ($5C35),A    ; Update the upside-down segment flag.
 $D176 LD ($CE5A),A    ; Update the vertical step copy.
 $D179 LD ($D85D),A    ; Update the edge flag.
 $D17C LD (IX+$01),A   ; Write #REGa to offset #N$01 of #REGix.
 $D17F LD A,(HL)       ; Read #REGhl.
 $D180 LD ($CE43),A    ; Update the segment column.
 $D183 INC HL          ; Advance #REGhl.
 $D184 LD A,(HL)       ; Read #REGhl.
 $D185 LD ($CE44),A    ; Update the segment row.
 $D188 LD ($CE3C),A    ; The segment row.
 $D18B INC HL          ; Advance #REGhl.
 $D18C LD A,(HL)       ; Read #REGhl.
 $D18D RRCA            ; Rotate #REGa right.
 $D18E RRCA            ; Rotate #REGa right.
 $D18F RRCA            ; Rotate #REGa right.
 $D190 RRCA            ; Rotate #REGa right.
 $D191 AND %00001111   ; Keep the bits of #REGa that are set in #N$0F.
 $D193 LD (IX+$03),A   ; Write #REGa to offset #N$03 of #REGix.
 $D196 EXX             ; Switch to the alternate registers.
 $D197 CALL $CD08      ; Call #R$CD08.
 $D19A EXX             ; Switch to the alternate registers.
 $D19B LD A,(HL)       ; Read #REGhl.
 $D19C AND %00001111   ; Keep the bits of #REGa that are set in #N$0F.
 $D19E JR NZ,$D1A2     ; Jump to #R$D1A2 if the zero flag is clear.
 $D1A0 LD A,$10        ; #REGa=#N$10.
@label=DrawTerrain_Length
*$D1A2 LD ($5C22),A    ; Update the segment length.
 $D1A5 LD C,A          ; #REGc=#REGa.
 $D1A6 INC HL          ; Advance #REGhl.
 $D1A7 CALL $CD6B      ; Call #R$CD6B.
 $D1AA LD HL,$CE24     ; The column phase table.
 $D1AD LD B,(IX+$03)   ; Read offset #N$03 of #REGix into #REGb.
 $D1B0 EXX             ; Switch to the alternate registers.
 $D1B1 LD IX,($BA09)   ; Fetch the word at #R$BA09 into #REGix.
; If the tiles have changed, make the record of the segment.
@label=DrawTerrain_Changed
 $D1B5 LD A,($5C3D)    ; The tiles changed.
 $D1B8 AND A           ; {Jump to #R$D25A if #REGa is zero.
 $D1B9 JP Z,$D25A      ; }
 $D1BC LD A,($DEDF)    ; The segment type.
 $D1BF LD E,A          ; #REGe=#REGa.
 $D1C0 LD D,$00        ; Clear #REGd.
 $D1C2 LD HL,$D0AC     ; The segment codes.
 $D1C5 ADD HL,DE       ; #REGhl gains #REGde.
 $D1C6 LD A,(HL)       ; Read #REGhl.
 $D1C7 LD (IX+$04),A   ; Write #REGa to offset #N$04 of #REGix.
 $D1CA LD A,($5C22)    ; The segment length.
 $D1CD LD (IX+$02),A   ; Write #REGa to offset #N$02 of #REGix.
 $D1D0 LD A,($CE43)    ; The segment column.
 $D1D3 LD (IX+$00),A   ; Write #REGa to offset #N$00 of #REGix.
 $D1D6 LD A,($CE44)    ; The segment row.
 $D1D9 LD (IX+$01),A   ; Write #REGa to offset #N$01 of #REGix.
 $D1DC LD A,($CE37)    ; The vertical step.
 $D1DF AND A           ; {Jump to #R$D204 if #REGa is not zero.
 $D1E0 JR NZ,$D204     ; }
 $D1E2 LD B,(IX+$02)   ; Read offset #N$02 of #REGix into #REGb.
 $D1E5 XOR A           ; Clear #REGa.
@label=DrawTerrain_FlatWidth
*$D1E6 ADD A,$18       ; Add #N$18 to #REGa.
 $D1E8 DJNZ $D1E6      ; Decrease #REGb and jump to #R$D1E6 until none remain.
 $D1EA LD (IX+$02),A   ; Write #REGa to offset #N$02 of #REGix.
 $D1ED LD A,($DEDF)    ; The segment type.
 $D1F0 CP $07          ; Compare #REGa with #N$07.
 $D1F2 LD (IX+$03),$14 ; Store #N$14 at offset #N$03 of #REGix.
 $D1F6 JP Z,$D25A      ; Jump to #R$D25A if the zero flag is set.
 $D1F9 LD A,(IX+$01)   ; Read offset #N$01 of #REGix.
 $D1FC ADD A,$10       ; Add #N$10 to #REGa.
 $D1FE LD (IX+$01),A   ; Write #REGa to offset #N$01 of #REGix.
 $D201 JP $D25A        ; Jump to #R$D25A.
@label=DrawTerrain_Sloped
*$D204 LD A,($CE59)    ; The horizontal step copy.
 $D207 AND A           ; {Jump to #R$D22D if #REGa is not zero.
 $D208 JR NZ,$D22D     ; }
 $D20A LD B,(IX+$02)   ; Read offset #N$02 of #REGix into #REGb.
 $D20D XOR A           ; Clear #REGa.
@label=DrawTerrain_SlopeWidth
*$D20E ADD A,$10       ; Add #N$10 to #REGa.
 $D210 DJNZ $D20E      ; Decrease #REGb and jump to #R$D20E until none remain.
 $D212 LD B,A          ; #REGb=#REGa.
 $D213 LD (IX+$02),$18 ; Store #N$18 at offset #N$02 of #REGix.
 $D217 LD A,($DEDF)    ; The segment type.
 $D21A LD (IX+$03),B   ; Write #REGb to offset #N$03 of #REGix.
 $D21D CP $0F          ; {Jump to #R$D25A if #REGa is not #N$0F.
 $D21F JP NZ,$D25A     ; }
 $D222 LD A,(IX+$00)   ; Read offset #N$00 of #REGix.
 $D225 SUB $10         ; Subtract #N$10 from #REGa.
 $D227 LD (IX+$00),A   ; Write #REGa to offset #N$00 of #REGix.
 $D22A JP $D25A        ; Jump to #R$D25A.
@label=DrawTerrain_Extent
*$D22D LD A,($E41B)    ; The slope direction.
 $D230 CP $FF          ; {Jump to #R$D23D if #REGa is #N$FF.
 $D232 JR Z,$D23D      ; }
 $D234 LD A,($5C25)    ; The horizontal step size.
 $D237 ADD A,(IX+$00)  ; Add the byte at offset #N$00 of #REGix to #REGa.
 $D23A LD (IX+$00),A   ; Write #REGa to offset #N$00 of #REGix.
@label=DrawTerrain_End
*$D23D LD B,(IX+$02)   ; Read offset #N$02 of #REGix into #REGb.
 $D240 LD D,(IX+$00)   ; Read offset #N$00 of #REGix into #REGd.
 $D243 LD E,(IX+$01)   ; Read offset #N$01 of #REGix into #REGe.
@label=DrawTerrain_ExtentLoop
*$D246 LD A,($CE35)    ; The horizontal step.
 $D249 ADD A,D         ; #REGa gains #REGd.
 $D24A LD D,A          ; #REGd=#REGa.
 $D24B LD A,($CE37)    ; The vertical step.
 $D24E NEG             ; Negate #REGa.
 $D250 ADD A,E         ; #REGa gains #REGe.
 $D251 LD E,A          ; #REGe=#REGa.
 $D252 DJNZ $D246      ; Decrease #REGb and jump to #R$D246 until none remain.
 $D254 LD (IX+$03),E   ; Write #REGe to offset #N$03 of #REGix.
 $D257 LD (IX+$02),D   ; Write #REGd to offset #N$02 of #REGix.
; Test whether the segment is near the position at #R$CE45 and #R$CE46,
; and skip it if it is not.
@label=DrawTerrain_Test
*$D25A LD A,($CE45)    ; The position across.
 $D25D LD B,A          ; #REGb=#REGa.
 $D25E LD A,($5C1D)    ; The tile number.
 $D261 BIT 1,A         ; {Jump to #R$D26A if bit 1 of #REGa is clear.
 $D263 JR Z,$D26A      ; }
 $D265 CALL $D2C0      ; Call #R$D2C0.
 $D268 JR $D26D        ; Jump to #R$D26D.
@label=DrawTerrain_TestVertical
*$D26A CALL $D292      ; Call #R$D292.
@label=DrawTerrain_Vertical
*$D26D JP NZ,$D28C     ; Jump to #R$D28C if the zero flag is clear.
 $D270 LD A,($CE46)    ; The position down.
 $D273 LD B,A          ; #REGb=#REGa.
 $D274 LD A,($5C1D)    ; The tile number.
 $D277 BIT 0,A         ; {Jump to #R$D280 if bit 0 of #REGa is clear.
 $D279 JR Z,$D280      ; }
 $D27B CALL $D2E1      ; Call #R$D2E1.
 $D27E JR $D283        ; Jump to #R$D283.
@label=DrawTerrain_Top
*$D280 CALL $D2DA      ; Call #R$D2DA.
@label=DrawTerrain_Near
*$D283 JP NZ,$D28C     ; Jump to #R$D28C if the zero flag is clear.
 $D286 CALL $D303      ; Call #R$D303.
 $D289 JP $D33D        ; Jump to #R$D33D.
@label=DrawTerrain_Skip
*$D28C CALL $D303      ; Call #R$D303.
 $D28F JP $D80A        ; Jump to #R$D80A.

; Test Left Column
;
; Used by the routine at #R$D0BD.
; .
; Tests the right end of a segment of a tile in the left column against
; the horizontal position in #REGb.
;
;   B Horizontal position to test against
;   IX Address of the record of the segment
; O:F Zero if the end of the segment is at the position or beyond it
@label=TestLeftColumn
c$D292 LD A,($CE37)   ; The vertical step.
 $D295 AND A          ; {Jump to #R$D2A0 if #REGa is not zero.
 $D296 JR NZ,$D2A0    ; }
 $D298 LD A,(IX+$00)  ; Read offset #N$00 of #REGix.
 $D29B ADD A,(IX+$02) ; Add the byte at offset #N$02 of #REGix to #REGa.
 $D29E JR $D2BC       ; Jump to #R$D2BC.
@label=TestLeftColumn_Sloped
*$D2A0 LD A,($CE59)   ; The horizontal step copy.
 $D2A3 AND A          ; {Jump to #R$D2AD if #REGa is not zero.
 $D2A4 JR NZ,$D2AD    ; }
 $D2A6 LD A,($CE43)   ; The segment column.
 $D2A9 ADD A,$08      ; Add #N$08 to #REGa.
 $D2AB JR $D2BC       ; Jump to #R$D2BC.
@label=TestLeftColumn_Direction
*$D2AD LD A,($E41B)   ; The slope direction.
 $D2B0 CP $01         ; {Jump to #R$D2B9 if #REGa is #N$01.
 $D2B2 JR Z,$D2B9     ; }
 $D2B4 LD A,(IX+$02)  ; Read offset #N$02 of #REGix.
 $D2B7 JR $D2BC       ; Jump to #R$D2BC.
@label=TestLeftColumn_Start
*$D2B9 LD A,(IX+$00)  ; Read offset #N$00 of #REGix.
@label=TestLeftColumn_Compare
*$D2BC CP B           ; {Return if #REGa is less than #REGb.
 $D2BD RET C          ; }
 $D2BE XOR A          ; Clear #REGa.
 $D2BF RET            ; Return.

; Test Right Column
;
; Used by the routine at #R$D0BD.
; .
; Tests the left end of a segment of a tile in the right column against
; the horizontal position in #REGb.
;
;   B Horizontal position to test against
;   IX Address of the record of the segment
; O:F Zero if the start of the segment is at the position or before it
@label=TestRightColumn
c$D2C0 LD A,($CE59)  ; The horizontal step copy.
 $D2C3 AND A         ; {Jump to #R$D2D3 if #REGa is zero.
 $D2C4 JR Z,$D2D3    ; }
 $D2C6 LD A,($E41B)  ; The slope direction.
 $D2C9 CP $FF        ; {Jump to #R$D2D3 if #REGa is #N$FF.
 $D2CB JR Z,$D2D3    ; }
 $D2CD LD A,(IX+$02) ; Read offset #N$02 of #REGix.
 $D2D0 DEC A         ; Step #REGa back.
 $D2D1 JR $D2D6      ; Jump to #R$D2D6.
@label=TestRightColumn_Start
*$D2D3 LD A,($CE43)  ; The segment column.
@label=TestRightColumn_Compare
*$D2D6 CP B          ; {Return if #REGa is #REGb or more.
 $D2D7 RET NC        ; }
 $D2D8 XOR A         ; Clear #REGa.
 $D2D9 RET           ; Return.

; Test Top Row
;
; Used by the routine at #R$D0BD.
; .
; Tests the vertical position of the start of a segment of a tile in the
; top row against the vertical position in #REGb.
;
;   B Vertical position to test against
; O:F Zero if the start of the segment is at the position or below it
@label=TestTopRow
c$D2DA LD A,($CE44)  ; The segment row.
 $D2DD CP B          ; {Return if #REGa is less than #REGb.
 $D2DE RET C         ; }
 $D2DF XOR A         ; Clear #REGa.
 $D2E0 RET           ; Return.

; Test Bottom Row
;
; Used by the routine at #R$D0BD.
; .
; Tests the vertical extent of a segment of a tile in the bottom row
; against the vertical position in #REGb.
;
;   B Vertical position to test against
;   IX Address of the record of the segment
; O:F Zero if the segment reaches the position or goes beyond it
@label=TestBottomRow
c$D2E1 LD A,($CE37)  ; The vertical step.
 $D2E4 AND A         ; {Jump to #R$D2EE if #REGa is not zero.
 $D2E5 JR NZ,$D2EE   ; }
 $D2E7 LD A,($CE44)  ; The segment row.
 $D2EA SUB $04       ; Subtract #N$04 from #REGa.
 $D2EC JR $D2FF      ; Jump to #R$D2FF.
@label=TestBottomRow_Sloped
*$D2EE LD A,($CE59)  ; The horizontal step copy.
 $D2F1 AND A         ; {Jump to #R$D2FC if #REGa is not zero.
 $D2F2 JR NZ,$D2FC   ; }
 $D2F4 LD A,(IX+$01) ; Read offset #N$01 of #REGix.
 $D2F7 SUB (IX+$03)  ; Subtract the byte at offset #N$03 of #REGix from #REGa.
 $D2FA JR $D2FF      ; Jump to #R$D2FF.
@label=TestBottomRow_Direction
*$D2FC LD A,(IX+$03) ; Read offset #N$03 of #REGix.
@label=TestBottomRow_Compare
*$D2FF CP B          ; {Return if #REGa is #REGb or more.
 $D300 RET NC        ; }
 $D301 XOR A         ; Clear #REGa.
 $D302 RET           ; Return.

; Next Record
;
; Used by the routine at #R$D0BD.
; .
; Moves on to the next five byte record of a segment in the tile record
; and stores it in #R$BA09, then points #REGix back at the drawing record at
; #R$DEDC with its screen address cleared.
;
; IX Address of the record of the segment
@label=NextRecord
c$D303 LD DE,$0005     ; #REGde=#N$05.
 $D306 ADD IX,DE       ; #REGix gains #REGde.
 $D308 LD ($BA09),IX   ; The next segment record.
 $D30C LD IX,$DEDC     ; The segment record.
 $D310 EXX             ; Switch to the alternate registers.
 $D311 LD (IX+$01),$00 ; Store #N$00 at offset #N$01 of #REGix.
 $D315 LD (IX+$03),B   ; Write #REGb to offset #N$03 of #REGix.
 $D318 RET             ; Return.

; Next Step
;
; Used by the routine at #R$D711.
; .
; Moves to the next step of a segment: the pixel row goes up by the
; vertical step and the pixel column along by the horizontal step. Then the
; step is tested against the position at #R$CE45 and #R$CE46, and the flags in
; #R$5C31 are set to say where they are in relation to each other.
@label=NextStep
c$D319 LD A,($CE37)  ; The vertical step.
 $D31C LD B,A        ; #REGb=#REGa.
 $D31D LD A,($CE44)  ; The segment row.
 $D320 SUB B         ; Subtract #REGb from #REGa.
 $D321 LD ($CE44),A  ; Update the segment row.
 $D324 LD A,($5C2D)  ; The segment screen row.
 $D327 SUB B         ; Subtract #REGb from #REGa.
 $D328 LD ($5C2D),A  ; Update the segment screen row.
 $D32B LD A,($CE35)  ; The horizontal step.
 $D32E LD B,A        ; #REGb=#REGa.
 $D32F LD A,($5C2C)  ; The segment screen column.
 $D332 ADD A,B       ; #REGa gains #REGb.
 $D333 LD ($5C2C),A  ; Update the segment screen column.
 $D336 LD A,($CE43)  ; The segment column.
 $D339 ADD A,B       ; #REGa gains #REGb.
 $D33A LD ($CE43),A  ; Update the segment column.
; This entry point is used by the routine at #R$D0BD.
; .
; Test the row. Rows that are above the position are drawn, a step at the
; same row is flagged by #R$CE79 or #R$CE97, and steps below the position are
; skipped.
@label=NextStep_Test
*$D33D XOR A         ; Clear #REGa.
 $D33E LD ($5C31),A  ; Update the contact flags.
 $D341 LD A,($5C1D)  ; The tile number.
 $D344 BIT 0,A       ; {Jump to #R$D359 if bit 0 of #REGa is set.
 $D346 JR NZ,$D359   ; }
 $D348 LD A,($CE44)  ; The segment row.
 $D34B LD B,A        ; #REGb=#REGa.
 $D34C LD A,($CE46)  ; The position down.
 $D34F CP B          ; {Jump to #R$CE97 if #REGa is #REGb.
 $D350 JP Z,$CE97    ; }
 $D353 JP NC,$D724   ; Jump to #R$D724 if the carry flag is clear.
 $D356 JP $D36C      ; Jump to #R$D36C.
@label=NextStep_Bottom
*$D359 LD A,($CE5A)  ; The vertical step copy.
 $D35C LD B,A        ; #REGb=#REGa.
 $D35D LD A,($CE44)  ; The segment row.
 $D360 SUB B         ; Subtract #REGb from #REGa.
 $D361 LD B,A        ; #REGb=#REGa.
 $D362 LD A,($CE46)  ; The position down.
 $D365 CP B          ; {Jump to #R$D724 if #REGa is less than #REGb.
 $D366 JP C,$D724    ; }
 $D369 JP Z,$CE79    ; Jump to #R$CE79 if the zero flag is set.
; This entry point is used by the routines at #R$CE79 and #R$CE97.
; .
; Test the column in the same way, with #R$CEB5 and #R$CEC8 for the same
; column.
@label=NextStep_Column
*$D36C LD A,($CE43)  ; The segment column.
 $D36F LD B,A        ; #REGb=#REGa.
 $D370 LD A,($5C1D)  ; The tile number.
 $D373 BIT 1,A       ; {Jump to #R$D3A6 if bit 1 of #REGa is set.
 $D375 JR NZ,$D3A6   ; }
 $D377 LD A,($CE37)  ; The vertical step.
 $D37A AND A         ; {Jump to #R$D395 if #REGa is not zero.
 $D37B JR NZ,$D395   ; }
 $D37D LD A,($CE41)  ; The horizontal offset.
 $D380 ADD A,B       ; #REGa gains #REGb.
 $D381 CP $F0        ; {Jump to #R$D395 if #REGa is less than #N$F0.
 $D383 JR C,$D395    ; }
 $D385 JP Z,$CEB5    ; Jump to #R$CEB5 if the zero flag is set.
 $D388 CP $F7        ; {Jump to #R$D395 if #REGa is #N$F7 or more.
 $D38A JR NC,$D395   ; }
 $D38C LD A,C        ; #REGa=#REGc.
 $D38D DEC A         ; Step #REGa back.
 $D38E JP NZ,$D724   ; Jump to #R$D724 if the zero flag is clear.
 $D391 DEC A         ; Step #REGa back.
 $D392 LD ($D85D),A  ; Update the edge flag.
@label=NextStep_Width
*$D395 LD A,($5C25)  ; The horizontal step size.
 $D398 ADD A,B       ; #REGa gains #REGb.
 $D399 LD B,A        ; #REGb=#REGa.
 $D39A LD A,($CE45)  ; The position across.
 $D39D CP B          ; {Jump to #R$CEB5 if #REGa is #REGb.
 $D39E JP Z,$CEB5    ; }
 $D3A1 JP NC,$D724   ; Jump to #R$D724 if the carry flag is clear.
 $D3A4 JR $D3B0      ; Jump to #R$D3B0.
@label=NextStep_Right
*$D3A6 LD A,($CE45)  ; The position across.
 $D3A9 CP B          ; {Jump to #R$CEC8 if #REGa is #REGb.
 $D3AA JP Z,$CEC8    ; }
 $D3AD JP C,$D724    ; Jump to #R$D724 if the carry flag is set.
; This entry point is used by the routines at #R$CEB5 and #R$CEC8.
; .
; If any of the flags have been set the step is handled by one of the
; routines for contact. Otherwise the step is drawn.
@label=NextStep_Flags
*$D3B0 LD A,($5C31)  ; The contact flags.
 $D3B3 AND A         ; {Jump to #R$D3D2 if #REGa is zero.
 $D3B4 JR Z,$D3D2    ; }
 $D3B6 CP $08        ; {Jump to #R$CEDB if #REGa is #N$08.
 $D3B8 JP Z,$CEDB    ; }
 $D3BB CP $04        ; {Jump to #R$CEDB if #REGa is #N$04.
 $D3BD JP Z,$CEDB    ; }
 $D3C0 CP $01        ; {Jump to #R$CE5B if #REGa is #N$01.
 $D3C2 JP Z,$CE5B    ; }
 $D3C5 CP $02        ; {Jump to #R$CE5B if #REGa is #N$02.
 $D3C7 JP Z,$CE5B    ; }
 $D3CA AND %00001111 ; Keep the bits of #REGa that are set in #N$0F.
 $D3CC JP NZ,$CE5B   ; Jump to #R$CE5B if the zero flag is clear.
 $D3CF JP $D724      ; Jump to #R$D724.

; Set Up Piece
;
; Used by the routine at #R$D319.
; .
; Sets up the drawing of the piece of picture for a step of a segment.
; Normally the routine for the type of the segment and the address of its
; picture are looked up in the table at #R$CCBD (four bytes for each type: the
; routine, which goes into #REGiy, and the picture) and the screen address for
; the start of the piece is found with #R$D937. Then, depending on the type of
; the segment and where on the screen it is, the routine sets the displacement
; of the jump at #R$D701 (in #N$D702) to choose a routine, and changes the
; instructions of the drawing routines to suit. Steps that were set up already
; start at #R$D435.
;
; HL Address of the entry for the step in the table at #R$CE24
; IX Address of the drawing record at #R$DEDC
@label=SetUpPiece
c$D3D2 LD E,(HL)     ; Read #REGhl into #REGe.
 $D3D3 LD A,(IX+$01) ; Read offset #N$01 of #REGix.
 $D3D6 AND A         ; {Jump to #R$D435 if #REGa is not zero.
 $D3D7 JP NZ,$D435   ; }
@label=SetUpPiece_Table
 $D3DA EXX           ; Switch to the alternate registers.
 $D3DB LD HL,($CCBD) ; Fetch the word at #R$CCBD into #REGhl.
 $D3DE LD E,(IX+$03) ; Read offset #N$03 of #REGix into #REGe.
 $D3E1 LD D,$00      ; Clear #REGd.
 $D3E3 SLA E         ; Shift #REGe left.
 $D3E5 SLA E         ; Shift #REGe left.
 $D3E7 ADD HL,DE     ; #REGhl gains #REGde.
 $D3E8 LD C,(HL)     ; Read #REGhl into #REGc.
 $D3E9 INC HL        ; Advance #REGhl.
 $D3EA LD B,(HL)     ; Read #REGhl into #REGb.
 $D3EB INC HL        ; Advance #REGhl.
 $D3EC PUSH BC       ; Stash #REGbc on the stack.
 $D3ED POP IY        ; Bring #REGiy back off the stack.
 $D3EF LD C,(HL)     ; Read #REGhl into #REGc.
 $D3F0 INC HL        ; Advance #REGhl.
 $D3F1 LD B,(HL)     ; Read #REGhl into #REGb.
 $D3F2 LD ($CE47),BC ; Update the picture pointer.
 $D3F6 LD A,($CE5A)  ; The vertical step copy.
 $D3F9 SRL A         ; Shift #REGa right.
 $D3FB LD ($CE40),A  ; Update the segment height.
 $D3FE CALL $D937    ; Call #R$D937.
 $D401 LD A,($CE36)  ; The column step.
 $D404 LD B,A        ; #REGb=#REGa.
 $D405 LD A,L        ; #REGa=#REGl.
 $D406 SUB B         ; Subtract #REGb from #REGa.
 $D407 LD L,A        ; #REGl=#REGa.
 $D408 LD ($CE49),HL ; Update the segment screen address.
 $D40B LD DE,($CE4B) ; Fetch the word at #R$CE4B into #REGde.
 $D40F LD A,(IX+$03) ; Read offset #N$03 of #REGix.
 $D412 CP $07        ; {Jump to #R$D418 if #REGa is less than #N$07.
 $D414 JR C,$D418    ; }
 $D416 SUB $07       ; Subtract #N$07 from #REGa.
@label=SetUpPiece_Offsets
*$D418 ADD A,A       ; Double #REGa.
 $D419 LD H,A        ; #REGh=#REGa.
 $D41A ADD A,A       ; Double #REGa.
 $D41B ADD A,H       ; #REGa gains #REGh.
 $D41C LD L,A        ; #REGl=#REGa.
 $D41D LD H,$00      ; Clear #REGh.
 $D41F ADD HL,DE     ; #REGhl gains #REGde.
 $D420 LD ($CE51),HL ; Update the segment picture offsets.
 $D423 EXX           ; Switch to the alternate registers.
 $D424 XOR A         ; Clear #REGa.
 $D425 LD D,A        ; #REGd=#REGa.
 $D426 LD ($D480),A  ; Shorten the piece by one column.
 $D429 LD A,(IX+$00) ; Read offset #N$00 of #REGix.
 $D42C AND %00000111 ; Keep the bits of #REGa that are set in #N$07.
 $D42E JR NZ,$D435   ; Jump to #R$D435 if the zero flag is clear.
 $D430 LD A,$01      ; #REGa=#N$01.
 $D432 LD ($D480),A  ; Keep the width of the piece.
@label=SetUpPiece_Type
*$D435 LD A,($CE59)  ; The horizontal step copy.
 $D438 AND A         ; {Jump to #R$D44B if #REGa is not zero.
 $D439 JR NZ,$D44B   ; }
 $D43B LD A,D        ; #REGa=#REGd.
 $D43C AND A         ; {Jump to #R$D672 if #REGa is not zero.
 $D43D JP NZ,$D672   ; }
 $D440 LD A,($E41B)  ; The slope direction.
 $D443 NEG           ; Negate #REGa.
 $D445 ADD A,A       ; Double #REGa.
 $D446 ADD A,A       ; Double #REGa.
 $D447 ADD A,A       ; Double #REGa.
 $D448 LD ($CE35),A  ; Update the horizontal step.
; Flat segments are handled at #R$D588.
@label=SetUpPiece_Slope
*$D44B XOR A         ; Clear #REGa.
 $D44C LD ($D702),A  ; Use the routine in #REGiy.
 $D44F LD A,($CE37)  ; The vertical step.
 $D452 AND A         ; {Jump to #R$D588 if #REGa is zero.
 $D453 JP Z,$D588    ; }
 $D456 LD A,($5C2C)  ; The segment screen column.
 $D459 CP $D1        ; {Jump to #R$D4CB if #REGa is less than #N$D1.
 $D45B JP C,$D4CB    ; }
 $D45E LD B,A        ; #REGb=#REGa.
 $D45F LD A,($CE35)  ; The horizontal step.
; The displacement of this jump is set by #R$E3D8: it is zero when the
; second step of the slope is negative, so that the next instruction is run, and
; two otherwise, to skip it.
@label=SetUpPiece_Patched
*$D462 JR $D462      ; Skip ahead by the displacement at #N$D463.
 $D464 NEG           ; Negate #REGa.
 $D466 ADD A,B       ; #REGa gains #REGb.
 $D467 CP $E9        ; {Jump to #R$D4CB if #REGa is less than #N$E9.
 $D469 JP C,$D4CB    ; }
 $D46C LD A,B        ; #REGa=#REGb.
 $D46D CP $E0        ; {Jump to #R$D494 if #REGa is less than #N$E0.
 $D46F JR C,$D494    ; }
 $D471 LD A,($E41B)  ; The slope direction.
 $D474 CP $01        ; {Jump to #R$D4A7 if #REGa is #N$01.
 $D476 JR Z,$D4A7    ; }
 $D478 LD A,($CE36)  ; The column step.
 $D47B LD B,A        ; #REGb=#REGa.
 $D47C LD A,$21      ; #REGa=#N$21.
 $D47E SUB B         ; Subtract #REGb from #REGa.
@label=SetUpPiece_ShortPatch
*$D47F JR $D47F      ; Skip ahead by the displacement at #N$D480.
 $D481 DEC A         ; Step #REGa back.
 $D482 LD ($DB92),A  ; Whether the second byte of the slope row is skipped.
 $D485 LD A,$02      ; #REGa=#N$02.
 $D487 LD ($D702),A  ; Draw the slope rows.
 $D48A LD A,($CE59)  ; The horizontal step copy.
 $D48D AND A         ; {Call #R$CCF5 if #REGa is zero.
 $D48E CALL Z,$CCF5  ; }
 $D491 JP $D672      ; Jump to #R$D672.
@label=SetUpPiece_Reverse
*$D494 LD A,($E41B)  ; The slope direction.
 $D497 CP $01        ; {Jump to #R$D4B8 if #REGa is #N$01.
 $D499 JR Z,$D4B8    ; }
 $D49B XOR A         ; Clear #REGa.
 $D49C LD ($DB92),A  ; Draw both bytes of the slope row.
 $D49F LD A,$02      ; #REGa=#N$02.
 $D4A1 LD ($D702),A  ; Draw the slope rows.
 $D4A4 JP $D672      ; Jump to #R$D672.
@label=SetUpPiece_Edge
*$D4A7 LD A,($D480)  ; Whether the piece was shortened.
 $D4AA LD ($D4B7),A  ; Whether the piece is shortened at the edge.
 $D4AD LD A,($CE36)  ; The column step.
 $D4B0 NEG           ; Negate #REGa.
 $D4B2 LD B,A        ; #REGb=#REGa.
 $D4B3 LD A,$29      ; #REGa=#N$29.
 $D4B5 SUB B         ; Subtract #REGb from #REGa.
@label=SetUpPiece_EdgePatch
*$D4B6 JR $D4B6      ; Skip ahead by the displacement at #N$D4B7.
@label=SetUpPiece_Draw
*$D4B8 DEC A         ; Step #REGa back.
 $D4B9 LD ($DC5A),A  ; How far to skip along the mirrored row.
 $D4BC LD A,$05      ; #REGa=#N$05.
 $D4BE LD ($D702),A  ; Draw the mirrored slope rows.
 $D4C1 LD A,($CE59)  ; The horizontal step copy.
 $D4C4 AND A         ; {Call #R$CCF5 if #REGa is zero.
 $D4C5 CALL Z,$CCF5  ; }
 $D4C8 JP $D672      ; Jump to #R$D672.
@label=SetUpPiece_Left
*$D4CB LD A,($5C2C)  ; The segment screen column.
 $D4CE ADD A,$08     ; Add #N$08 to #REGa.
 $D4D0 CP $0F        ; {Jump to #R$D4E1 if #REGa is less than #N$0F.
 $D4D2 JR C,$D4E1    ; }
 $D4D4 LD A,($CE59)  ; The horizontal step copy.
 $D4D7 AND A         ; {Jump to #R$D672 if #REGa is not zero.
 $D4D8 JP NZ,$D672   ; }
 $D4DB CALL $CCF5    ; Call #R$CCF5.
 $D4DE JP $D672      ; Jump to #R$D672.
@label=SetUpPiece_Direction
*$D4E1 LD A,($E41B)  ; The slope direction.
 $D4E4 CP $01        ; {Jump to #R$D539 if #REGa is #N$01.
 $D4E6 JR Z,$D539    ; }
 $D4E8 LD A,($CE49)  ; The segment screen address.
 $D4EB AND %00011111 ; Keep the bits of #REGa that are set in #N$1F.
 $D4ED CP $1D        ; {Jump to #R$D514 if #REGa is #N$1D.
 $D4EF JR Z,$D514    ; }
 $D4F1 CP $1E        ; {Jump to #R$D525 if #REGa is #N$1E.
 $D4F3 JR Z,$D525    ; }
@label=SetUpPiece_Flat
*$D4F5 LD A,($CE59)  ; The horizontal step copy.
 $D4F8 AND A         ; {Call #R$CCF5 if #REGa is zero.
 $D4F9 CALL Z,$CCF5  ; }
 $D4FC LD A,($CE36)  ; The column step.
 $D4FF LD ($5C2E),A  ; Update the piece column.
 $D502 LD A,$2C      ; #REGa=#N$2C.
 $D504 LD ($DBC6),A  ; Skip along the slope row.
@label=SetUpPiece_SetCounts
*$D507 LD A,$01      ; #REGa=#N$01.
 $D509 LD ($DBC1),A  ; Skip a word of the picture.
@label=SetUpPiece_SelectEight
*$D50C LD A,$08      ; #REGa=#N$08.
 $D50E LD ($D702),A  ; Draw the slope rows from the edge.
 $D511 JP $D672      ; Jump to #R$D672.
@label=SetUpPiece_Column29
*$D514 LD A,$01      ; #REGa=#N$01.
 $D516 LD ($5C2E),A  ; Update the piece column.
 $D519 XOR A         ; Clear #REGa.
 $D51A LD ($DBC1),A  ; Keep the word of the picture.
 $D51D LD A,$30      ; #REGa=#N$30.
 $D51F LD ($DBC6),A  ; Skip further along the slope row.
 $D522 JP $D50C      ; Jump to #R$D50C.
@label=SetUpPiece_Column30
*$D525 LD A,($D480)  ; Whether the piece was shortened.
 $D528 CP $01        ; {Jump to #R$D4F5 if #REGa is #N$01.
 $D52A JR Z,$D4F5    ; }
 $D52C LD A,($CE36)  ; The column step.
 $D52F LD ($5C2E),A  ; Update the piece column.
 $D532 XOR A         ; Clear #REGa.
 $D533 LD ($DBC6),A  ; Do not skip along the slope row.
 $D536 JP $D507      ; Jump to #R$D507.
@label=SetUpPiece_Backwards
*$D539 LD A,($CE36)  ; The column step.
 $D53C LD B,A        ; #REGb=#REGa.
 $D53D LD A,($CE49)  ; The segment screen address.
 $D540 SUB B         ; Subtract #REGb from #REGa.
 $D541 AND %00011111 ; Keep the bits of #REGa that are set in #N$1F.
 $D543 CP $02        ; {Jump to #R$D562 if #REGa is #N$02.
 $D545 JR Z,$D562    ; }
 $D547 CP $03        ; {Jump to #R$D573 if #REGa is #N$03.
 $D549 JR Z,$D573    ; }
 $D54B LD A,($D480)  ; Whether the piece was shortened.
 $D54E CP $01        ; {Jump to #R$D562 if #REGa is #N$01.
 $D550 JR Z,$D562    ; }
 $D552 XOR A         ; Clear #REGa.
 $D553 LD ($DC14),A  ; Do not skip along the mirrored slope row.
 $D556 INC A         ; Advance #REGa.
@label=SetUpPiece_SelectEleven
*$D557 LD ($DC0C),A  ; Whether a word of the mirrored picture is skipped.
 $D55A LD A,$0B      ; #REGa=#N$0B.
 $D55C LD ($D702),A  ; Draw the mirrored rows from the edge.
 $D55F JP $D672      ; Jump to #R$D672.
@label=SetUpPiece_Two
*$D562 LD A,($CE59)  ; The horizontal step copy.
 $D565 AND A         ; {Call #R$CCF5 if #REGa is zero.
 $D566 CALL Z,$CCF5  ; }
 $D569 LD A,$26      ; #REGa=#N$26.
 $D56B LD ($DC14),A  ; Skip along the mirrored slope row.
 $D56E LD A,$01      ; #REGa=#N$01.
 $D570 JP $D557      ; Jump to #R$D557.
@label=SetUpPiece_Three
*$D573 LD A,D        ; #REGa=#REGd.
 $D574 AND A         ; {Jump to #R$D57F if #REGa is not zero.
 $D575 JR NZ,$D57F   ; }
 $D577 LD A,($CE49)  ; The segment screen address.
 $D57A SUB $20       ; Subtract #N$20 from #REGa.
 $D57C LD ($CE49),A  ; Update the segment screen address.
@label=SetUpPiece_ThreeBytes
*$D57F LD A,$2A      ; #REGa=#N$2A.
 $D581 LD ($DC14),A  ; Skip further along the mirrored slope row.
 $D584 XOR A         ; Clear #REGa.
 $D585 JP $D557      ; Jump to #R$D557.

; Set Up Flat Piece
;
; Used by the routine at #R$D3D2.
; .
; Sets up the drawing of the piece of picture for a step of a flat
; segment, which is three bytes wide. The jumps at #R$E259, #R$E25D and #R$E261
; and the instructions at #N$E2A5 and #N$E2AA of #R$E249 are changed when the
; piece is at the edge of the screen (the column in the bottom five bits of the
; screen address is #N($18), #N($19), #N($1C) or #N($1D)) so that only the part
; inside the area of the terrain is drawn. The routine then reads the shape at
; the end of the segment from #R$5C33 and #R$5C34 and finds the picture and the
; routine that draws it.
;
; C Number of steps left in the segment
; IX Address of the drawing record at #R$DEDC
@label=SetUpFlatPiece
c$D588 XOR A         ; Clear #REGa.
 $D589 LD ($E25A),A  ; Draw the first word of the flat row.
 $D58C LD ($E25E),A  ; Draw the second word of the flat row.
 $D58F LD ($E262),A  ; Draw the third word of the flat row.
 $D592 LD A,($CE49)  ; The segment screen address.
 $D595 AND %00011111 ; Keep the bits of #REGa that are set in #N$1F.
 $D597 CP $1D        ; {Jump to #R$D5C6 if #REGa is #N$1D.
 $D599 JR Z,$D5C6    ; }
 $D59B CP $1C        ; {Jump to #R$D5D5 if #REGa is #N$1C.
 $D59D JR Z,$D5D5    ; }
 $D59F CP $18        ; {Jump to #R$D5E5 if #REGa is #N$18.
 $D5A1 JR Z,$D5E5    ; }
 $D5A3 CP $19        ; {Jump to #R$D5EC if #REGa is #N$19.
 $D5A5 JR Z,$D5EC    ; }
 $D5A7 LD A,($D85D)  ; The edge flag.
 $D5AA AND A         ; {Jump to #R$D716 if #REGa is not zero.
 $D5AB JP NZ,$D716   ; }
 $D5AE LD A,($5C22)  ; The segment length.
 $D5B1 CP C          ; {Jump to #R$D5F1 if #REGa is not #REGc.
 $D5B2 JR NZ,$D5F1   ; }
 $D5B4 LD A,($5C33)  ; The segment start shape.
 $D5B7 CP $10        ; {Jump to #R$D5F1 if #REGa is not #N$10.
 $D5B9 JR NZ,$D5F1   ; }
 $D5BB LD A,($CE41)  ; The horizontal offset.
 $D5BE AND %00000111 ; Keep the bits of #REGa that are set in #N$07.
 $D5C0 JR Z,$D5F1    ; Jump to #R$D5F1 if the zero flag is set.
 $D5C2 LD A,$EE      ; #REGa=#N$EE.
 $D5C4 JR $D5C8      ; Jump to #R$D5C8.
@label=SetUpFlatPiece_Right
*$D5C6 LD A,$33      ; #REGa=#N$33.
@label=SetUpFlatPiece_Patch
*$D5C8 LD ($E25A),A  ; Skip part of the flat row at the right edge.
 $D5CB XOR A         ; Clear #REGa.
 $D5CC LD ($E2AA),A  ; Draw the right-hand byte.
 $D5CF INC A         ; Advance #REGa.
 $D5D0 LD ($E2A5),A  ; Skip the byte before the right-hand byte.
 $D5D3 JR $D5F1      ; Jump to #R$D5F1.
@label=SetUpFlatPiece_Edge
*$D5D5 LD A,$33      ; #REGa=#N$33.
 $D5D7 LD ($E25A),A  ; Skip part of the flat row at the edge.
 $D5DA LD A,$0B      ; #REGa=#N$0B.
 $D5DC LD ($E2AA),A  ; Skip most of the right-hand side.
 $D5DF XOR A         ; Clear #REGa.
 $D5E0 LD ($E2A5),A  ; Draw the byte before the right-hand byte.
 $D5E3 JR $D5F1      ; Jump to #R$D5F1.
@label=SetUpFlatPiece_Column
*$D5E5 LD A,$26      ; #REGa=#N$26.
 $D5E7 LD ($E262),A  ; Skip the third word of the flat row.
 $D5EA JR $D5F1      ; Jump to #R$D5F1.
@label=SetUpFlatPiece_Skip
*$D5EC LD A,$24      ; #REGa=#N$24.
 $D5EE LD ($E25E),A  ; Skip the second word of the flat row.
@label=SetUpFlatPiece_Shape
*$D5F1 LD A,($5C22)  ; The segment length.
 $D5F4 CP C          ; {Jump to #R$D65E if #REGa is not #REGc.
 $D5F5 JP NZ,$D65E   ; }
 $D5F8 LD A,($5C33)  ; The segment start shape.
 $D5FB BIT 4,A       ; {Jump to #R$D672 if bit 4 of #REGa is clear.
 $D5FD JP Z,$D672    ; }
 $D600 OR %10000000  ; Set the bits of #REGa that are set in #N$80.
 $D602 LD ($5C33),A  ; Update the segment start shape.
@label=SetUpFlatPiece_Picture
*$D605 LD B,A        ; #REGb=#REGa.
 $D606 CP $96        ; {Jump to #R$D636 if #REGa is #N$96.
 $D608 JR Z,$D636    ; }
 $D60A BIT 0,A       ; {Jump to #R$D64E if bit 0 of #REGa is clear.
 $D60C JR Z,$D64E    ; }
 $D60E CP $91        ; Compare #REGa with #N$91.
 $D610 LD A,($CCBB)  ; The horizontal scroll speed.
 $D613 JR Z,$D617    ; Jump to #R$D617 if the zero flag is set.
 $D615 NEG           ; Negate #REGa.
@label=SetUpFlatPiece_Direction
*$D617 BIT 7,A       ; {Jump to #R$D64E if bit 7 of #REGa is set.
 $D619 JR NZ,$D64E   ; }
 $D61B LD A,(IX+$00) ; Read offset #N$00 of #REGix.
 $D61E AND %00000111 ; Keep the bits of #REGa that are set in #N$07.
 $D620 JR NZ,$D64E   ; Jump to #R$D64E if the zero flag is clear.
 $D622 LD A,B        ; #REGa=#REGb.
 $D623 LD ($5C27),A  ; Update the shape flag.
 $D626 EXX           ; Switch to the alternate registers.
 $D627 LD HL,($CE49) ; Fetch the word at #R$CE49 into #REGhl.
 $D62A LD ($CE4F),HL ; Update the saved screen address.
 $D62D LD A,($5C2C)  ; The segment screen column.
 $D630 LD ($5C1C),A  ; Update the screen column.
 $D633 EXX           ; Switch to the alternate registers.
 $D634 JR $D64E      ; Jump to #R$D64E.
@label=SetUpFlatPiece_Edges
*$D636 LD A,($CE49)  ; The segment screen address.
 $D639 INC A         ; Advance #REGa.
 $D63A INC A         ; Advance #REGa.
 $D63B AND %00011111 ; Keep the bits of #REGa that are set in #N$1F.
 $D63D CP $1C        ; {Jump to #R$D724 if #REGa is #N$1C or more.
 $D63F JP NC,$D724   ; }
 $D642 XOR A         ; Clear #REGa.
 $D643 LD ($E25A),A  ; Draw the first word of the flat row.
 $D646 LD ($E262),A  ; Draw the third word of the flat row.
 $D649 LD A,$24      ; #REGa=#N$24.
 $D64B LD ($E25E),A  ; Skip the second word of the flat row.
@label=SetUpFlatPiece_Offset
*$D64E LD A,B        ; #REGa=#REGb.
 $D64F AND %00000011 ; Keep the bits of #REGa that are set in #N$03.
 $D651 ADD A,A       ; Double #REGa.
 $D652 ADD A,A       ; Double #REGa.
 $D653 LD B,A        ; #REGb=#REGa.
 $D654 ADD A,A       ; Double #REGa.
 $D655 ADD A,B       ; #REGa gains #REGb.
 $D656 ADD A,$24     ; Add #N$24 to #REGa.
 $D658 EXX           ; Switch to the alternate registers.
 $D659 LD E,A        ; #REGe=#REGa.
 $D65A LD D,$00      ; Clear #REGd.
 $D65C JR $D67E      ; Jump to #R$D67E.
@label=SetUpFlatPiece_Last
*$D65E LD A,C        ; #REGa=#REGc.
 $D65F CP $01        ; {Jump to #R$D672 if #REGa is not #N$01.
 $D661 JR NZ,$D672   ; }
 $D663 LD A,($5C34)  ; The segment end shape.
 $D666 BIT 4,A       ; {Jump to #R$D672 if bit 4 of #REGa is clear.
 $D668 JR Z,$D672    ; }
 $D66A OR %10000000  ; Set the bits of #REGa that are set in #N$80.
 $D66C LD ($5C34),A  ; Update the segment end shape.
 $D66F JP $D605      ; Jump to #R$D605.

; Locate Picture
;
; Used by the routines at #R$D3D2 and #R$D588.
; .
; Finds the picture for the piece. The offset of the picture is looked up
; in the table that #R$CE51 points at, using the value in #REGe as the index,
; and added to the address of the picture at #R$CE47. The stack pointer is
; pointed at the result, so that the drawing routines can pop the words of the
; picture. The routine then works out how many rows to draw. If the piece is at
; the bottom of the screen the rows that are below the bottom are skipped by
; popping their words.
;
; E Index into the table of offsets, in words
@label=LocatePicture
c$D672 LD A,E        ; #REGa=#REGe.
 $D673 EXX           ; Switch to the alternate registers.
 $D674 LD HL,($CE51) ; Fetch the word at #R$CE51 into #REGhl.
 $D677 LD E,A        ; #REGe=#REGa.
 $D678 SLA E         ; Shift #REGe left.
 $D67A LD D,$00      ; Clear #REGd.
 $D67C ADD HL,DE     ; #REGhl gains #REGde.
 $D67D LD E,(HL)     ; Read #REGhl into #REGe.
; This entry point is used by the routine at #R$D588.
@label=LocatePicture_Address
*$D67E LD HL,($CE47) ; Fetch the word at #R$CE47 into #REGhl.
 $D681 ADD HL,DE     ; #REGhl gains #REGde.
 $D682 LD SP,HL      ; Set the stack pointer from #REGhl.
 $D683 LD A,($CE40)  ; The segment height.
 $D686 LD E,A        ; #REGe=#REGa.
 $D687 LD A,($5C2D)  ; The segment screen row.
 $D68A CP $B8        ; {Jump to #R$D6DB if #REGa is less than #N$B8.
 $D68C JP C,$D6DB    ; }
 $D68F SUB $B7       ; Subtract #N$B7 from #REGa.
 $D691 LD B,A        ; #REGb=#REGa.
 $D692 SRL B         ; Shift #REGb right.
 $D694 LD A,E        ; #REGa=#REGe.
 $D695 SUB B         ; Subtract #REGb from #REGa.
 $D696 LD E,A        ; #REGe=#REGa.
 $D697 LD A,($5C24)  ; The column step size.
 $D69A LD D,A        ; #REGd=#REGa.
 $D69B LD A,($CE37)  ; The vertical step.
 $D69E AND A         ; {Jump to #R$D6A9 if #REGa is zero.
 $D69F JR Z,$D6A9    ; }
 $D6A1 LD A,(IX+$00) ; Read offset #N$00 of #REGix.
 $D6A4 AND %00000111 ; Keep the bits of #REGa that are set in #N$07.
 $D6A6 JR Z,$D6A9    ; Jump to #R$D6A9 if the zero flag is set.
 $D6A8 INC D         ; Advance #REGd.
@label=LocatePicture_Skip
*$D6A9 LD A,D        ; #REGa=#REGd.
@label=LocatePicture_Pop
*$D6AA POP HL        ; Bring #REGhl back off the stack.
 $D6AB DEC A         ; Step #REGa back.
 $D6AC JR NZ,$D6AA   ; Jump to #R$D6AA if the zero flag is clear.
 $D6AE DJNZ $D6A9    ; Decrease #REGb and jump to #R$D6A9 until none remain.
 $D6B0 LD H,$57      ; #REGh=#N$57.
 $D6B2 LD A,($CE49)  ; The segment screen address.
 $D6B5 LD L,A        ; #REGl=#REGa.
 $D6B6 LD A,($CE36)  ; The column step.
 $D6B9 ADD A,L       ; #REGa gains #REGl.
 $D6BA AND %00011111 ; Keep the bits of #REGa that are set in #N$1F.
 $D6BC OR %11000000  ; Set the bits of #REGa that are set in #N$C0.
 $D6BE LD L,A        ; #REGl=#REGa.
 $D6BF LD A,($CE36)  ; The column step.
 $D6C2 NEG           ; Negate #REGa.
 $D6C4 ADD A,L       ; #REGa gains #REGl.
 $D6C5 LD L,A        ; #REGl=#REGa.
 $D6C6 LD A,($D702)  ; Which drawing routine was chosen.
 $D6C9 CP $0B        ; {Jump to #R$D700 if #REGa is not #N$0B.
 $D6CB JP NZ,$D700   ; }
 $D6CE LD A,L        ; #REGa=#REGl.
 $D6CF CP $DD        ; {Jump to #R$D700 if #REGa is less than #N$DD.
 $D6D1 JP C,$D700    ; }
 $D6D4 LD A,L        ; #REGa=#REGl.
 $D6D5 SUB $20       ; Subtract #N$20 from #REGa.
 $D6D7 LD L,A        ; #REGl=#REGa.
 $D6D8 JP $D700      ; Jump to #R$D700.

; Adjust Piece
;
; Used by the routine at #R$D672.
; .
; Adjusts the number of rows of a piece that is near the top of the
; screen so that it does not go above the top, and, for a sloped piece, limits
; the number of steps left in the segment to two. The screen address is loaded
; from #R$CE49.
;
; A Vertical position of the piece
@label=AdjustPiece
c$D6DB LD B,A        ; #REGb=#REGa.
 $D6DC LD A,($CE5A)  ; The vertical step copy.
 $D6DF NEG           ; Negate #REGa.
 $D6E1 ADD A,B       ; #REGa gains #REGb.
 $D6E2 SUB $18       ; Subtract #N$18 from #REGa.
 $D6E4 JP NC,$D6FD   ; Jump to #R$D6FD if the carry flag is clear.
 $D6E7 CPL           ; Invert #REGa.
 $D6E8 SRL A         ; Shift #REGa right.
 $D6EA NEG           ; Negate #REGa.
 $D6EC ADD A,E       ; #REGa gains #REGe.
 $D6ED LD E,A        ; #REGe=#REGa.
 $D6EE LD A,($CE37)  ; The vertical step.
 $D6F1 AND A         ; {Jump to #R$D6FD if #REGa is zero.
 $D6F2 JR Z,$D6FD    ; }
 $D6F4 EXX           ; Switch to the alternate registers.
 $D6F5 LD A,C        ; #REGa=#REGc.
 $D6F6 CP $01        ; {Jump to #R$D6FC if #REGa is #N$01.
 $D6F8 JR Z,$D6FC    ; }
 $D6FA LD C,$02      ; #REGc=#N$02.
@label=AdjustPiece_Columns
*$D6FC EXX           ; Switch to the alternate registers.
@label=AdjustPiece_Address
*$D6FD LD HL,($CE49) ; Fetch the word at #R$CE49 into #REGhl.
; Continue on to #R$D700.

; Jump To Drawing Routine
;
; Used by the routine at #R$D672.
; .
; Jumps to the routine that draws the piece. The displacement of the
; relative jump at #R$D701 is held in #N$D702 and chosen by #R$D3D2 and
; #R$D588: zero for the routine in #REGiy, #N$02 for #R$DB89, #N$05 for
; #R$DC47, #N$08 for #R$DBB7 and #N$0B for #R$DBFD.
;
; E Number of rows in a block
; HL Screen address
; IY Address of the routine for the type of segment
@label=JumpToDrawingRoutine
c$D700 LD A,E        ; #REGa=#REGe.
@label=JumpToDrawingRoutine_Jump
*$D701 JR $D701      ; Jump forward by the displacement at #N$D702.
@label=JumpToDrawingRoutine_Iy
 $D703 JP (IY)       ; Jump to the address in #REGiy.
@label=JumpToDrawingRoutine_First
 $D705 JP $DB89      ; Jump to #R$DB89.
@label=JumpToDrawingRoutine_Second
 $D708 JP $DC47      ; Jump to #R$DC47.
@label=JumpToDrawingRoutine_Third
 $D70B JP $DBB7      ; Jump to #R$DBB7.
@label=JumpToDrawingRoutine_Fourth
 $D70E JP $DBFD      ; Jump to #R$DBFD.

; Finish Step
;
; Used by the routines at #R$DB89, #R$DBB7, #R$DBFD, #R$DC47, #R$E48B, #R$E4A7,
; #R$E4CF, #R$E4F1, #R$E52B and #R$E55B.
; .
; Finishes the drawing of a step. The screen address that the drawing has
; reached is stored in #R$CE49 (at #R$D711 only), the number of steps drawn is
; counted and the next step of the segment is started, until the segment has no
; steps left.
;
; HL Screen address
@label=FinishStep
c$D711 LD ($CE49),HL ; Update the segment screen address.
; This entry point is used by the routine at #R$E249.
@label=FinishStep_Exchange
*$D714 EXX           ; Switch to the alternate registers.
 $D715 INC D         ; Advance #REGd.
; This entry point is used by the routines at #R$CEDB and #R$D588.
@label=FinishStep_Count
*$D716 LD A,($5C2F)  ; The flagged steps.
 $D719 INC A         ; Advance #REGa.
 $D71A LD ($5C2F),A  ; Update the flagged steps.
 $D71D LD A,($CE54)  ; The steps already drawn.
 $D720 INC A         ; Advance #REGa.
 $D721 LD ($CE54),A  ; Update the steps already drawn.
; This entry point is used by the routines at #R$CE5B, #R$CEB5, #R$CEC8,
; #R$D319 and #R$D588.
@label=FinishStep_Next
*$D724 INC HL        ; Advance #REGhl.
 $D725 DEC C         ; Step #REGc back.
 $D726 JP NZ,$D319   ; Jump to #R$D319 if the zero flag is clear.
; Continue on to #R$D729.

; End Segment
;
; Finishes the last step of a segment: the end of the segment is stored
; at offset #N$02 of the record and #R$D86A draws the pixels at the edge of a
; sloped segment. If steps of the segment were flagged (#R$5C2F is not zero)
; and the horizontal offset is a multiple of eight, the routine starts or stops
; the horizontal speed in #R$CCBB depending on the direction of the segment and
; fills the pixels of the steps that were flagged with #R$E41C, using the
; chequer pattern or blank. Purpose not yet known for the details of this.
@label=EndSegment
c$D729 LD (IX+$02),D ; Write #REGd to offset #N$02 of #REGix.
 $D72C LD SP,$5B7A   ; Set the stack pointer to #N$5B7A.
 $D72F CALL $D86A    ; Call #R$D86A.
 $D732 LD A,($5C2F)  ; The flagged steps.
 $D735 AND A         ; {Jump to #R$D7F8 if #REGa is zero.
 $D736 JP Z,$D7F8    ; }
 $D739 LD A,($CE41)  ; The horizontal offset.
 $D73C AND %00000111 ; Keep the bits of #REGa that are set in #N$07.
 $D73E JP NZ,$D7F8   ; Jump to #R$D7F8 if the zero flag is clear.
 $D741 LD ($5C1A),A  ; The alignment that should stop the scroll.
 $D744 LD A,($CCBB)  ; The horizontal scroll speed.
 $D747 AND A         ; {Jump to #R$D766 if #REGa is not zero.
 $D748 JP NZ,$D766   ; }
 $D74B LD A,($CE37)  ; The vertical step.
 $D74E AND A         ; {Jump to #R$D7F8 if #REGa is zero.
 $D74F JP Z,$D7F8    ; }
 $D752 LD ($5C1A),A  ; The vertical step that should stop the scroll.
 $D755 LD A,($E41B)  ; The slope direction.
 $D758 LD B,A        ; #REGb=#REGa.
 $D759 LD A,($CE59)  ; The horizontal step copy.
 $D75C AND A         ; {Jump to #R$D762 if #REGa is zero.
 $D75D JR Z,$D762    ; }
 $D75F LD A,($5C35)  ; The upside-down segment flag.
@label=EndSegment_Store
*$D762 XOR B         ; Flip the bits of #REGa that are set in #REGb.
 $D763 LD ($CCBB),A  ; Update the horizontal scroll speed.
@label=EndSegment_Fill
*$D766 LD A,($CE37)  ; The vertical step.
 $D769 AND A         ; {Jump to #R$D8DA if #REGa is zero.
 $D76A JP Z,$D8DA    ; }
 $D76D EXX           ; Switch to the alternate registers.
 $D76E LD HL,($CE4F) ; Fetch the word at #R$CE4F into #REGhl.
 $D771 LD A,($CE53)  ; The saved row.
 $D774 LD ($CE44),A  ; Update the segment row.
 $D777 LD A,($CE59)  ; The horizontal step copy.
 $D77A AND A         ; {Jump to #R$D788 if #REGa is not zero.
 $D77B JR NZ,$D788   ; }
 $D77D LD ($5C35),A  ; Update the upside-down segment flag.
 $D780 LD A,($E41B)  ; The slope direction.
 $D783 NEG           ; Negate #REGa.
 $D785 LD ($CE36),A  ; Update the column step.
@label=EndSegment_Pattern
*$D788 LD DE,$55AA   ; #REGde=#N$55AA.
 $D78B LD A,($CCBB)  ; The horizontal scroll speed.
 $D78E LD B,A        ; #REGb=#REGa.
 $D78F LD A,($5C35)  ; The upside-down segment flag.
 $D792 XOR B         ; Flip the bits of #REGa that are set in #REGb.
 $D793 LD B,A        ; #REGb=#REGa.
 $D794 LD A,($E41B)  ; The slope direction.
 $D797 XOR B         ; Flip the bits of #REGa that are set in #REGb.
 $D798 BIT 7,A       ; {Jump to #R$D79F if bit 7 of #REGa is clear.
 $D79A JR Z,$D79F    ; }
 $D79C LD DE,$0000   ; #REGde=#N$00.
@label=EndSegment_Direction
*$D79F LD A,($E41B)  ; The slope direction.
 $D7A2 CP $FF        ; {Jump to #R$D7B9 if #REGa is #N$FF.
 $D7A4 JR Z,$D7B9    ; }
 $D7A6 LD A,($CCBB)  ; The horizontal scroll speed.
 $D7A9 BIT 7,A       ; {Jump to #R$D7B1 if bit 7 of #REGa is set.
 $D7AB JR NZ,$D7B1   ; }
 $D7AD DEC L         ; Step #REGl back.
 $D7AE JP $D7C9      ; Jump to #R$D7C9.
@label=EndSegment_Column
*$D7B1 LD A,($5C24)  ; The column step size.
 $D7B4 ADD A,L       ; #REGa gains #REGl.
 $D7B5 LD L,A        ; #REGl=#REGa.
 $D7B6 JP $D7C1      ; Jump to #R$D7C1.
@label=EndSegment_Flat
*$D7B9 LD A,($CCBB)  ; The horizontal scroll speed.
 $D7BC BIT 7,A       ; {Jump to #R$D7C4 if bit 7 of #REGa is set.
 $D7BE JR NZ,$D7C4   ; }
 $D7C0 DEC L         ; Step #REGl back.
@label=EndSegment_Jump
*$D7C1 JP $D7C9      ; Jump to #R$D7C9.
@label=EndSegment_Step
*$D7C4 LD A,($CE36)  ; The column step.
 $D7C7 ADD A,L       ; #REGa gains #REGl.
 $D7C8 LD L,A        ; #REGl=#REGa.
@label=EndSegment_Rows
*$D7C9 LD A,($CE59)  ; The horizontal step copy.
 $D7CC AND A         ; {Jump to #R$D7E0 if #REGa is not zero.
 $D7CD JR NZ,$D7E0   ; }
 $D7CF LD A,($5C2F)  ; The flagged steps.
 $D7D2 LD B,A        ; #REGb=#REGa.
 $D7D3 XOR A         ; Clear #REGa.
@label=EndSegment_Rows2
*$D7D4 ADD A,$10     ; Add #N$10 to #REGa.
 $D7D6 DJNZ $D7D4    ; Decrease #REGb and jump to #R$D7D4 until none remain.
 $D7D8 LD ($CE5A),A  ; Update the vertical step copy.
 $D7DB LD A,$01      ; #REGa=#N$01.
 $D7DD LD ($5C2F),A  ; Update the flagged steps.
@label=EndSegment_Strip
*$D7E0 LD A,($CE5A)  ; The vertical step copy.
 $D7E3 SRL A         ; Shift #REGa right.
 $D7E5 LD C,A        ; #REGc=#REGa.
 $D7E6 EXX           ; Switch to the alternate registers.
 $D7E7 LD A,($5C2F)  ; The flagged steps.
 $D7EA LD B,A        ; #REGb=#REGa.
 $D7EB CALL $E41C    ; Call #R$E41C.
 $D7EE LD A,($5C1A)  ; See whether that marker should stop the scroll.
 $D7F1 AND A         ; {Jump to #R$D7F8 if #REGa is zero.
 $D7F2 JR Z,$D7F8    ; }
 $D7F4 XOR A         ; Clear #REGa.
 $D7F5 LD ($CCBB),A  ; Update the horizontal scroll speed.
; Continue on to #R$D7F8.

; Finish Segment
;
; Used by the routines at #R$D729 and #R$D8DA.
; .
; Finishes a segment. When the world is scrolling vertically and steps of
; the segment have been counted, the edge of the segment is drawn by #R$D9A8.
; Otherwise the attributes of the segment are coloured with #R$CF38.
@label=FinishSegment
c$D7F8 EXX           ; Switch to the alternate registers.
 $D7F9 LD A,($CCBA)  ; The vertical scroll speed.
 $D7FC AND A         ; {Jump to #R$D806 if #REGa is zero.
 $D7FD JR Z,$D806    ; }
 $D7FF LD A,($CE54)  ; The steps already drawn.
 $D802 AND A         ; {Jump to #R$D9A8 if #REGa is not zero.
 $D803 JP NZ,$D9A8   ; }
; This entry point is used by the routine at #R$D9A8.
@label=FinishSegment_Colour
*$D806 CALL $CF38    ; Call #R$CF38.
 $D809 EXX           ; Switch to the alternate registers.
; Continue on to #R$D80A.

; Next Segment
;
; Used by the routine at #R$D0BD.
; .
; Moves on to the next segment of the script, using the address that
; #R$CD6B stored in #R$CE4D, until the last has been drawn. Then the next tile
; is started: the vertical offset (and for the third tile the horizontal
; offset) is changed to move to the position of that tile. After the fourth
; tile the horizontal offset is put back.
@label=NextSegment
c$D80A LD SP,$5B7A   ; Set the stack pointer to #N$5B7A.
 $D80D LD HL,($CE4D) ; Fetch the word at #R$CE4D into #REGhl.
 $D810 LD A,($5C20)  ; The segments still to draw.
 $D813 DEC A         ; Step #REGa back.
 $D814 LD ($5C20),A  ; Update the segments still to draw.
 $D817 JP NZ,$D15C   ; Jump to #R$D15C if the zero flag is clear.
; This entry point is used by the routine at #R$D0BD.
@label=NextSegment_Tile
*$D81A LD A,($5C1D)  ; The tile number.
 $D81D INC A         ; Advance #REGa.
 $D81E LD ($5C1D),A  ; Update the tile number.
 $D821 CP $04        ; {Jump to #R$D848 if #REGa is #N$04.
 $D823 JR Z,$D848    ; }
 $D825 BIT 0,A       ; Test bit 0 of #REGa.
 $D827 LD B,$60      ; #REGb=#N$60.
 $D829 JR Z,$D82D    ; Jump to #R$D82D if the zero flag is set.
 $D82B LD B,$A0      ; #REGb=#N$A0.
@label=NextSegment_Offset
*$D82D LD A,($CE42)  ; The vertical offset.
 $D830 ADD A,B       ; #REGa gains #REGb.
 $D831 LD ($CE42),A  ; Update the vertical offset.
 $D834 LD A,($5C1D)  ; The tile number.
 $D837 CP $02        ; {Jump to #R$D0FF if #REGa is not #N$02.
 $D839 JP NZ,$D0FF   ; }
 $D83C LD B,$20      ; #REGb=#N$20.
 $D83E LD A,($CE41)  ; The horizontal offset.
 $D841 SUB B         ; Subtract #REGb from #REGa.
 $D842 LD ($CE41),A  ; Update the horizontal offset.
 $D845 JP $D0FF      ; Jump to #R$D0FF.
@label=NextSegment_Done
*$D848 LD A,($CE41)  ; The horizontal offset.
 $D84B ADD A,$20     ; Add #N$20 to #REGa.
 $D84D LD ($CE41),A  ; Update the horizontal offset.
 $D850 RET           ; Return.

; Edge Patterns Right
;
; Pixel bytes for the edge of a flat segment, four bytes for each of the
; horizontal offsets of two to seven pixels (each starts two bytes after the
; one before). #R$D86A draws them.
@label=EdgePatternsRight
b$D851 DEFB $40,$C0,$00,$00
 $D855 DEFB $50,$B0,$C0,$80
 $D859 DEFB $54,$AC,$F0,$E0

; Edge Flag
;
; Set to zero when each segment is started and to #N($FF) by #R$D319 when
; the last step of a flat segment is found to be at the right edge of the area.
; #R$D86A and #R$D9A8 test it.
@label=EdgeFlag
g$D85D DEFB $00

; Edge Patterns Left
;
; The same as #R$D851 for a segment that is not the first of a tile, as
; selected by the type at offset #N$03 of the drawing record.
@label=EdgePatternsLeft
b$D85E DEFB $00,$00,$C0,$C0
 $D862 DEFB $00,$C0,$70,$B0
 $D866 DEFB $00,$F0,$5C,$AC

; Draw Edge Pixels
;
; Used by the routine at #R$D729.
; .
; Draws the pixels that finish the edge of a flat segment when the
; horizontal offset is not a multiple of eight. Nothing is drawn unless the
; segment is flat, its shape code (see #R$5C34) is #N($13) or #N($93) and steps
; have been flagged. The four bytes come from #R$D851 or #R$D85E, depending on
; the type, and are stored going up the screen at the address in #R$CE49,
; except that only #N$02 are stored when the segment is at the top or bottom of
; the area.
;
; IX Address of the drawing record at #R$DEDC
@label=DrawEdgePixels
c$D86A LD A,($CE37)    ; The vertical step.
 $D86D AND A           ; {Return if #REGa is not zero.
 $D86E RET NZ          ; }
 $D86F LD A,($5C34)    ; The segment end shape.
 $D872 AND %01111111   ; Keep the bits of #REGa that are set in #N$7F.
 $D874 CP $13          ; {Return if #REGa is not #N$13.
 $D876 RET NZ          ; }
 $D877 LD A,($5C2F)    ; The flagged steps.
 $D87A AND A           ; {Return if #REGa is zero.
 $D87B RET Z           ; }
 $D87C LD HL,$D851     ; The edge patterns right.
 $D87F LD A,(IX+$03)   ; Read offset #N$03 of #REGix.
 $D882 AND A           ; {Jump to #R$D888 if #REGa is zero.
 $D883 JR Z,$D888      ; }
 $D885 LD HL,$D85E     ; The edge patterns left.
@label=DrawEdgePixels_Table
*$D888 LD A,($CE41)    ; The horizontal offset.
 $D88B AND %00000111   ; Keep the bits of #REGa that are set in #N$07.
 $D88D RET Z           ; Return if the zero flag is set.
 $D88E DEC A           ; Step #REGa back.
 $D88F DEC A           ; Step #REGa back.
 $D890 ADD A,A         ; Double #REGa.
 $D891 LD E,A          ; #REGe=#REGa.
 $D892 LD D,$00        ; Clear #REGd.
 $D894 ADD HL,DE       ; #REGhl gains #REGde.
 $D895 EX DE,HL        ; Swap #REGde and #REGhl.
 $D896 LD A,($D85D)    ; The edge flag.
 $D899 AND A           ; Is #REGa zero?
 $D89A LD HL,($CE49)   ; Fetch the word at #R$CE49 into #REGhl.
 $D89D JR Z,$D8AA      ; Jump to #R$D8AA if the zero flag is set.
 $D89F LD (IX+$01),$00 ; Store #N$00 at offset #N$01 of #REGix.
 $D8A3 LD A,L          ; #REGa=#REGl.
 $D8A4 SUB $20         ; Subtract #N$20 from #REGa.
 $D8A6 LD L,A          ; #REGl=#REGa.
 $D8A7 INC L           ; Advance #REGl.
 $D8A8 INC L           ; Advance #REGl.
 $D8A9 INC L           ; Advance #REGl.
@label=DrawEdgePixels_Address
*$D8AA INC L           ; Advance #REGl.
 $D8AB INC L           ; Advance #REGl.
 $D8AC INC L           ; Advance #REGl.
 $D8AD LD A,L          ; #REGa=#REGl.
 $D8AE AND %00011111   ; Keep the bits of #REGa that are set in #N$1F.
 $D8B0 DEC A           ; Step #REGa back.
 $D8B1 CP $1C          ; {Return if #REGa is #N$1C or more.
 $D8B3 RET NC          ; }
 $D8B4 LD B,$04        ; #REGb=#N$04.
 $D8B6 LD A,($5C2D)    ; The segment screen row.
 $D8B9 CP $B9          ; {Jump to #R$D8CB if #REGa is not #N$B9.
 $D8BB JR NZ,$D8CB     ; }
 $D8BD INC DE          ; Advance #REGde.
 $D8BE INC DE          ; Advance #REGde.
 $D8BF LD H,$57        ; #REGh=#N$57.
 $D8C1 LD A,L          ; #REGa=#REGl.
 $D8C2 AND %00011111   ; Keep the bits of #REGa that are set in #N$1F.
 $D8C4 OR %11000000    ; Set the bits of #REGa that are set in #N$C0.
 $D8C6 LD L,A          ; #REGl=#REGa.
 $D8C7 LD B,$02        ; #REGb=#N$02.
 $D8C9 JR $D8D1        ; Jump to #R$D8D1.
@label=DrawEdgePixels_Rows
*$D8CB CP $19          ; {Jump to #R$D8D1 if #REGa is not #N$19.
 $D8CD JR NZ,$D8D1     ; }
 $D8CF LD B,$02        ; #REGb=#N$02.
@label=DrawEdgePixels_Draw
*$D8D1 LD A,(DE)       ; Read #REGde.
 $D8D2 LD (HL),A       ; Write #REGa where #REGhl points.
 $D8D3 INC DE          ; Advance #REGde.
 $D8D4 CALL $A1C3      ; Call #R$A1C3.
 $D8D7 DJNZ $D8D1      ; Decrease #REGb and jump to #R$D8D1 until none remain.
 $D8D9 RET             ; Return.

; Fill Slope Edge
;
; Used by the routine at #R$D729.
; .
; Clears the pixels at the end of a sloped segment when the world is
; moving horizontally and the shape code of the segment says that it is a slope
; (bit 0 of the shape code that goes with the direction, in #R$5C33 or
; #R$5C34). The screen address of the end is found from #R$CE4F, moved to
; either side, and #R$E41C fills a strip there with zeros.
;
; IX Address of the drawing record at #R$DEDC
@label=FillSlopeEdge
c$D8DA LD A,($CCBB)  ; The horizontal scroll speed.
 $D8DD AND A         ; {Jump to #R$D7F8 if #REGa is zero.
 $D8DE JP Z,$D7F8    ; }
 $D8E1 LD A,(IX+$01) ; Read offset #N$01 of #REGix.
 $D8E4 AND A         ; {Jump to #R$D900 if #REGa is not zero.
 $D8E5 JR NZ,$D900   ; }
 $D8E7 LD A,($CCBB)  ; The horizontal scroll speed.
 $D8EA BIT 7,A       ; Test bit 7 of #REGa.
 $D8EC LD A,($5C34)  ; The segment end shape.
 $D8EF JR NZ,$D8F4   ; Jump to #R$D8F4 if the zero flag is clear.
 $D8F1 LD A,($5C33)  ; The segment start shape.
@label=FillSlopeEdge_Check
*$D8F4 BIT 0,A       ; {Jump to #R$D7F8 if bit 0 of #REGa is clear.
 $D8F6 JP Z,$D7F8    ; }
 $D8F9 EXX           ; Switch to the alternate registers.
 $D8FA LD HL,($CE4F) ; Fetch the word at #R$CE4F into #REGhl.
 $D8FD DEC L         ; Step #REGl back.
 $D8FE JR $D918      ; Jump to #R$D918.
@label=FillSlopeEdge_Right
*$D900 LD A,($5C27)  ; The shape flag.
 $D903 AND A         ; {Jump to #R$D7F8 if #REGa is zero.
 $D904 JP Z,$D7F8    ; }
 $D907 EXX           ; Switch to the alternate registers.
 $D908 LD HL,($CE4F) ; Fetch the word at #R$CE4F into #REGhl.
 $D90B INC L         ; Advance #REGl.
 $D90C INC L         ; Advance #REGl.
 $D90D LD A,($5C1C)  ; The screen column.
 $D910 CP $F0        ; {Jump to #R$D918 if #REGa is less than #N$F0.
 $D912 JR C,$D918    ; }
 $D914 LD A,L        ; #REGa=#REGl.
 $D915 SUB $20       ; Subtract #N$20 from #REGa.
 $D917 LD L,A        ; #REGl=#REGa.
@label=FillSlopeEdge_Fill
*$D918 LD A,($CE53)  ; The saved row.
 $D91B LD ($CE44),A  ; Update the segment row.
 $D91E LD A,($CCBB)  ; The horizontal scroll speed.
 $D921 BIT 7,A       ; {Jump to #R$D929 if bit 7 of #REGa is clear.
 $D923 JR Z,$D929    ; }
 $D925 LD A,L        ; #REGa=#REGl.
 $D926 ADD A,$04     ; Add #N$04 to #REGa.
 $D928 LD L,A        ; #REGl=#REGa.
@label=FillSlopeEdge_Pattern
*$D929 LD DE,$0000   ; #REGde=#N$00.
 $D92C LD C,$02      ; #REGc=#N$02.
 $D92E EXX           ; Switch to the alternate registers.
 $D92F LD B,$01      ; #REGb=#N$01.
 $D931 CALL $E41C    ; Call #R$E41C.
 $D934 JP $D7F8      ; Jump to #R$D7F8.

; Find Segment Address
;
; Used by the routines at #R$CEDB and #R$D3D2.
; .
; Finds the screen address of the start of the current segment from its
; pixel position in #R$CE43 and #R$CE44 and the offsets in #R$CE41 and #R$CE42.
; The pixel position is stored in the drawing record at #R$DEDC and in #R$5C2C
; and #R$5C2D. If no step of the segment has been flagged (#R$5C2F is zero) the
; address is also stored in #R$CE4F with the pixel row in #R$CE53.
;
;   IX Address of the drawing record at #R$DEDC
; O:HL Screen address
@label=FindSegmentAddress
c$D937 LD A,($CE44)  ; The segment row.
 $D93A LD H,A        ; #REGh=#REGa.
 $D93B LD A,($CE42)  ; The vertical offset.
 $D93E ADD A,H       ; #REGa gains #REGh.
 $D93F LD H,A        ; #REGh=#REGa.
 $D940 LD (IX+$01),A ; Write #REGa to offset #N$01 of #REGix.
 $D943 LD ($5C2D),A  ; Update the segment screen row.
 $D946 LD A,($CE43)  ; The segment column.
 $D949 LD L,A        ; #REGl=#REGa.
 $D94A LD A,($CE41)  ; The horizontal offset.
 $D94D ADD A,L       ; #REGa gains #REGl.
 $D94E LD L,A        ; #REGl=#REGa.
 $D94F LD ($5C2C),A  ; Update the segment screen column.
 $D952 LD (IX+$00),A ; Write #REGa to offset #N$00 of #REGix.
 $D955 LD D,$00      ; Clear #REGd.
 $D957 CP $F0        ; {Jump to #R$D95D if #REGa is less than #N$F0.
 $D959 JR C,$D95D    ; }
 $D95B LD D,$20      ; #REGd=#N$20.
@label=FindSegmentAddress_Address
*$D95D CALL $A149    ; Call #R$A149.
 $D960 LD A,($5C2F)  ; The flagged steps.
 $D963 AND A         ; {Jump to #R$D974 if #REGa is not zero.
 $D964 JR NZ,$D974   ; }
 $D966 LD A,L        ; #REGa=#REGl.
 $D967 SUB D         ; Subtract #REGd from #REGa.
 $D968 LD L,A        ; #REGl=#REGa.
 $D969 LD ($CE4F),HL ; Update the saved screen address.
 $D96C ADD A,D       ; #REGa gains #REGd.
 $D96D LD L,A        ; #REGl=#REGa.
 $D96E LD A,($5C2D)  ; The segment screen row.
 $D971 LD ($CE53),A  ; Update the saved row.
@label=FindSegmentAddress_Count
*$D974 LD A,($CE54)  ; The steps already drawn.
 $D977 AND A         ; {Return if #REGa is not zero.
 $D978 RET NZ        ; }
; Continue on to #R$D979.

; Note Segment Start
;
; Used by the routine at #R$CE5B.
; .
; Stores the pixel position of the start of the segment, with the offsets
; of the view added, in #R$CE55 and #R$CE56.
@label=NoteSegmentStart
c$D979 LD A,($CE43)  ; The segment column.
 $D97C LD B,A        ; #REGb=#REGa.
 $D97D LD A,($CE41)  ; The horizontal offset.
 $D980 ADD A,B       ; #REGa gains #REGb.
 $D981 LD ($CE55),A  ; Update the start column.
 $D984 LD A,($CE44)  ; The segment row.
 $D987 LD B,A        ; #REGb=#REGa.
 $D988 LD A,($CE42)  ; The vertical offset.
 $D98B ADD A,B       ; #REGa gains #REGb.
 $D98C LD ($CE56),A  ; Update the start row.
 $D98F RET           ; Return.

; Adjust Edge Address
;
; Used by the routine at #R$D9A8.
; .
; Moves the screen address in #REGhl one cell to the left when the
; horizontal speed is negative. The last four instructions, which would move it
; back and count a step less, cannot be reached because the speed is known to
; be negative.
;
;   C Number of steps left
;   HL Screen address
; O:C Number of steps left
; O:HL Screen address
@label=AdjustEdgeAddress
c$D990 LD A,($CCBB)  ; The horizontal scroll speed.
 $D993 BIT 7,A       ; {Return if bit 7 of #REGa is clear.
 $D995 RET Z         ; }
 $D996 DEC L         ; Step #REGl back.
 $D997 LD A,($CE44)  ; The segment row.
 $D99A CP $5F        ; {Return if #REGa is #N$5F or more.
 $D99C RET NC        ; }
 $D99D LD A,($CCBB)  ; The horizontal scroll speed.
 $D9A0 NEG           ; Negate #REGa.
 $D9A2 BIT 7,A       ; {Return if bit 7 of #REGa is clear.
 $D9A4 RET Z         ; }
 $D9A5 INC L         ; Advance #REGl.
 $D9A6 DEC C         ; Step #REGc back.
 $D9A7 RET           ; Return.

; Draw Vertical Edge
;
; Used by the routine at #R$D7F8.
; .
; Draws the edge of the terrain when the world is scrolling vertically,
; for the steps of a segment that have been counted in #R$CE54. A strip across
; the segment is filled with either a chequered pattern (#N($55AA)) or blank
; (zero), depending on whether the vertical speed in #R$CCBA and the direction
; are the same, using #R$DB41 or #R$DB49. The routine finally carries on with
; #R$D806. Purpose not yet known for the details of the positions.
@label=DrawVerticalEdge
c$D9A8 LD IY,$DB49   ; The fill four edge rows.
 $D9AC LD A,($CE3F)  ; The vertical distance.
 $D9AF CP $04        ; {Jump to #R$D9B7 if #REGa is #N$04.
 $D9B1 JR Z,$D9B7    ; }
 $D9B3 LD IY,$DB41   ; The fill two edge rows.
@label=DrawVerticalEdge_Pattern
*$D9B7 LD DE,$0000   ; #REGde=#N$00.
 $D9BA LD A,($CCBA)  ; The vertical scroll speed.
 $D9BD LD B,A        ; #REGb=#REGa.
 $D9BE LD A,($5C35)  ; The upside-down segment flag.
 $D9C1 XOR B         ; Flip the bits of #REGa that are set in #REGb.
 $D9C2 BIT 7,A       ; {Jump to #R$D9C9 if bit 7 of #REGa is clear.
 $D9C4 JR Z,$D9C9    ; }
 $D9C6 LD DE,$55AA   ; #REGde=#N$55AA.
@label=DrawVerticalEdge_Address
*$D9C9 LD HL,($CE55) ; Fetch the word at #R$CE55 into #REGhl.
 $D9CC LD A,($CE59)  ; The horizontal step copy.
 $D9CF AND A         ; {Jump to #R$DA01 if #REGa is not zero.
 $D9D0 JR NZ,$DA01   ; }
 $D9D2 LD A,($E41B)  ; The slope direction.
 $D9D5 CP $01        ; {Jump to #R$D9DD if #REGa is #N$01.
 $D9D7 JR Z,$D9DD    ; }
 $D9D9 LD A,L        ; #REGa=#REGl.
 $D9DA ADD A,$07     ; Add #N$07 to #REGa.
 $D9DC LD L,A        ; #REGl=#REGa.
@label=DrawVerticalEdge_Count
*$D9DD LD A,($CE54)  ; The steps already drawn.
 $D9E0 LD B,A        ; #REGb=#REGa.
 $D9E1 XOR A         ; Clear #REGa.
@label=DrawVerticalEdge_Rows2
*$D9E2 ADD A,$10     ; Add #N$10 to #REGa.
 $D9E4 DJNZ $D9E2    ; Decrease #REGb and jump to #R$D9E2 until none remain.
 $D9E6 LD ($CE5A),A  ; Update the vertical step copy.
 $D9E9 LD A,$01      ; #REGa=#N$01.
 $D9EB LD ($CE54),A  ; Update the steps already drawn.
 $D9EE LD DE,$55AA   ; #REGde=#N$55AA.
 $D9F1 LD A,($E41B)  ; The slope direction.
 $D9F4 LD B,A        ; #REGb=#REGa.
 $D9F5 LD A,($CCBB)  ; The horizontal scroll speed.
 $D9F8 AND A         ; {Jump to #R$DA01 if #REGa is zero.
 $D9F9 JR Z,$DA01    ; }
 $D9FB XOR B         ; Flip the bits of #REGa that are set in #REGb.
 $D9FC BIT 7,A       ; {Jump to #R$D806 if bit 7 of #REGa is set.
 $D9FE JP NZ,$D806   ; }
@label=DrawVerticalEdge_Rows
*$DA01 LD A,($CCBA)  ; The vertical scroll speed.
 $DA04 BIT 7,A       ; Test bit 7 of #REGa.
 $DA06 LD A,($CE3F)  ; The vertical distance.
 $DA09 JR NZ,$DA10   ; Jump to #R$DA10 if the zero flag is clear.
 $DA0B LD A,($CE5A)  ; The vertical step copy.
 $DA0E NEG           ; Negate #REGa.
@label=DrawVerticalEdge_Row
*$DA10 ADD A,H       ; #REGa gains #REGh.
 $DA11 LD H,A        ; #REGh=#REGa.
 $DA12 LD ($CE44),A  ; Update the segment row.
 $DA15 LD ($BA8D),HL ; The edge position.
 $DA18 LD A,($CE37)  ; The vertical step.
 $DA1B AND A         ; {Jump to #R$DA52 if #REGa is not zero.
 $DA1C JR NZ,$DA52   ; }
 $DA1E LD A,($CCBB)  ; The horizontal scroll speed.
 $DA21 NEG           ; Negate #REGa.
 $DA23 ADD A,L       ; #REGa gains #REGl.
 $DA24 LD L,A        ; #REGl=#REGa.
 $DA25 LD A,($CE54)  ; The steps already drawn.
 $DA28 LD B,A        ; #REGb=#REGa.
 $DA29 LD A,$01      ; #REGa=#N$01.
 $DA2B LD ($CE54),A  ; Update the steps already drawn.
 $DA2E LD A,($D85D)  ; The edge flag.
 $DA31 AND A         ; {Jump to #R$DA45 if #REGa is zero.
 $DA32 JR Z,$DA45    ; }
 $DA34 LD A,($5C34)  ; The segment end shape.
 $DA37 AND %01111111 ; Keep the bits of #REGa that are set in #N$7F.
 $DA39 CP $13        ; {Jump to #R$DA45 if #REGa is not #N$13.
 $DA3B JR NZ,$DA45   ; }
 $DA3D LD A,E        ; #REGa=#REGe.
 $DA3E AND A         ; {Jump to #R$DA45 if #REGa is zero.
 $DA3F JR Z,$DA45    ; }
 $DA41 LD A,$01      ; #REGa=#N$01.
 $DA43 JR $DA4B      ; Jump to #R$DA4B.
@label=DrawVerticalEdge_Width
*$DA45 LD A,$01      ; #REGa=#N$01.
@label=DrawVerticalEdge_Cells
*$DA47 ADD A,$03     ; Add #N$03 to #REGa.
 $DA49 DJNZ $DA47    ; Decrease #REGb and jump to #R$DA47 until none remain.
@label=DrawVerticalEdge_Columns
*$DA4B LD ($5C24),A  ; Update the column step size.
 $DA4E DEC A         ; Step #REGa back.
 $DA4F LD ($8384),A  ; The extra columns of the edge.
@label=DrawVerticalEdge_Sloped
*$DA52 LD A,($CE59)  ; The horizontal step copy.
 $DA55 AND A         ; {Jump to #R$DAA0 if #REGa is zero.
 $DA56 JP Z,$DAA0    ; }
 $DA59 LD A,(IX+$01) ; Read offset #N$01 of #REGix.
 $DA5C AND A         ; {Jump to #R$DAA0 if #REGa is not zero.
 $DA5D JR NZ,$DAA0   ; }
 $DA5F LD A,E        ; #REGa=#REGe.
 $DA60 AND A         ; {Jump to #R$DA6E if #REGa is zero.
 $DA61 JR Z,$DA6E    ; }
 $DA63 LD A,($5C32)  ; The last contact flags.
 $DA66 AND A         ; {Jump to #R$DA6E if #REGa is zero.
 $DA67 JR Z,$DA6E    ; }
 $DA69 LD A,H        ; #REGa=#REGh.
 $DA6A CP $1F        ; {Jump to #R$DA75 if #REGa is #N$1F or more.
 $DA6C JR NC,$DA75   ; }
@label=DrawVerticalEdge_Move
*$DA6E LD A,($CCBB)  ; The horizontal scroll speed.
 $DA71 NEG           ; Negate #REGa.
 $DA73 ADD A,L       ; #REGa gains #REGl.
 $DA74 LD L,A        ; #REGl=#REGa.
@label=DrawVerticalEdge_Flags
*$DA75 LD A,($5C32)  ; The last contact flags.
 $DA78 AND A         ; {Jump to #R$DAA0 if #REGa is zero.
 $DA79 JR Z,$DAA0    ; }
 $DA7B CP $01        ; {Jump to #R$DA8D if #REGa is #N$01.
 $DA7D JR Z,$DA8D    ; }
 $DA7F LD A,($E41B)  ; The slope direction.
 $DA82 CP $01        ; {Jump to #R$DA94 if #REGa is #N$01.
 $DA84 JR Z,$DA94    ; }
@label=DrawVerticalEdge_Reverse
*$DA86 NEG           ; Negate #REGa.
 $DA88 LD ($E41B),A  ; Update the slope direction.
 $DA8B JR $DA94      ; Jump to #R$DA94.
@label=DrawVerticalEdge_Same
*$DA8D LD A,($E41B)  ; The slope direction.
 $DA90 CP $01        ; {Jump to #R$DA86 if #REGa is #N$01.
 $DA92 JR Z,$DA86    ; }
@label=DrawVerticalEdge_Align
*$DA94 LD A,L        ; #REGa=#REGl.
 $DA95 AND %00000111 ; Keep the bits of #REGa that are set in #N$07.
 $DA97 JR Z,$DAA0    ; Jump to #R$DAA0 if the zero flag is set.
 $DA99 LD A,($5C24)  ; The column step size.
 $DA9C INC A         ; Advance #REGa.
 $DA9D LD ($5C24),A  ; Update the column step size.
@label=DrawVerticalEdge_Start
*$DAA0 LD A,($CE37)  ; The vertical step.
 $DAA3 AND A         ; {Call #R$8347 if #REGa is zero.
 $DAA4 CALL Z,$8347  ; }
 $DAA7 LD B,$00      ; Clear #REGb.
 $DAA9 LD A,L        ; #REGa=#REGl.
 $DAAA LD ($5C1C),A  ; Update the screen column.
 $DAAD CP $F0        ; {Jump to #R$DAB3 if #REGa is less than #N$F0.
 $DAAF JR C,$DAB3    ; }
 $DAB1 LD L,B        ; #REGl=#REGb.
 $DAB2 INC B         ; Advance #REGb.
@label=DrawVerticalEdge_Screen
*$DAB3 CALL $A149    ; Call #R$A149.
 $DAB6 LD A,L        ; #REGa=#REGl.
 $DAB7 SUB B         ; Subtract #REGb from #REGa.
 $DAB8 LD L,A        ; #REGl=#REGa.
 $DAB9 LD A,($5C24)  ; The column step size.
 $DABC LD C,A        ; #REGc=#REGa.
 $DABD LD A,($CE59)  ; The horizontal step copy.
 $DAC0 AND A         ; {Jump to #R$DB1A if #REGa is zero.
 $DAC1 JP Z,$DB1A    ; }
 $DAC4 LD A,($CE37)  ; The vertical step.
 $DAC7 AND A         ; {Jump to #R$DAFA if #REGa is zero.
 $DAC8 JR Z,$DAFA    ; }
 $DACA LD A,(IX+$01) ; Read offset #N$01 of #REGix.
 $DACD AND A         ; {Jump to #R$DB03 if #REGa is zero.
 $DACE JP Z,$DB03    ; }
 $DAD1 LD A,($5C1C)  ; The screen column.
 $DAD4 AND %00000111 ; Keep the bits of #REGa that are set in #N$07.
 $DAD6 JP NZ,$DB03   ; Jump to #R$DB03 if the zero flag is clear.
 $DAD9 LD A,($CCBB)  ; The horizontal scroll speed.
 $DADC AND A         ; {Jump to #R$DAF7 if #REGa is zero.
 $DADD JR Z,$DAF7    ; }
 $DADF LD B,A        ; #REGb=#REGa.
 $DAE0 LD A,($CCBA)  ; The vertical scroll speed.
 $DAE3 XOR B         ; Flip the bits of #REGa that are set in #REGb.
 $DAE4 LD B,A        ; #REGb=#REGa.
 $DAE5 LD A,($E41B)  ; The slope direction.
 $DAE8 XOR B         ; Flip the bits of #REGa that are set in #REGb.
 $DAE9 BIT 7,A       ; {Jump to #R$DAF7 if bit 7 of #REGa is clear.
 $DAEB JR Z,$DAF7    ; }
 $DAED DEC L         ; Step #REGl back.
 $DAEE LD A,($CCBB)  ; The horizontal scroll speed.
 $DAF1 BIT 7,A       ; {Jump to #R$DAF7 if bit 7 of #REGa is clear.
 $DAF3 JR Z,$DAF7    ; }
 $DAF5 INC L         ; Advance #REGl.
 $DAF6 INC L         ; Advance #REGl.
@label=DrawVerticalEdge_Draw
*$DAF7 JP $DB1A      ; Jump to #R$DB1A.
@label=DrawVerticalEdge_Flat
*$DAFA LD A,(IX+$01) ; Read offset #N$01 of #REGix.
 $DAFD AND A         ; {Call #R$D990 if #REGa is zero.
 $DAFE CALL Z,$D990  ; }
 $DB01 JR $DB1A      ; Jump to #R$DB1A.
@label=DrawVerticalEdge_Slope
*$DB03 LD A,($CE37)  ; The vertical step.
 $DB06 AND A         ; {Jump to #R$DB1A if #REGa is zero.
 $DB07 JR Z,$DB1A    ; }
 $DB09 LD A,($E41B)  ; The slope direction.
 $DB0C CP $01        ; Compare #REGa with #N$01.
 $DB0E LD A,($CCBA)  ; The vertical scroll speed.
 $DB11 JR NZ,$DB15   ; Jump to #R$DB15 if the zero flag is clear.
 $DB13 NEG           ; Negate #REGa.
@label=DrawVerticalEdge_Check
*$DB15 BIT 7,A       ; {Jump to #R$DB1A if bit 7 of #REGa is clear.
 $DB17 JR Z,$DB1A    ; }
 $DB19 INC L         ; Advance #REGl.
@label=DrawVerticalEdge_Fill
*$DB1A EXX           ; Switch to the alternate registers.
 $DB1B LD A,($CE54)  ; The steps already drawn.
 $DB1E LD B,A        ; #REGb=#REGa.
 $DB1F CALL $DB26    ; Call #R$DB26.
 $DB22 EXX           ; Switch to the alternate registers.
 $DB23 JP $D806      ; Jump to #R$D806.

; Call Edge Painter
;
; Used by the routines at #R$D9A8 and #R$DB29.
; .
; Jumps to the routine for the edge in #REGiy, which is #R$DB41 or
; #R$DB49.
@label=CallEdgePainter
c$DB26 EXX           ; Switch to the alternate registers.
 $DB27 JP (IY)       ; Jump to the address in #REGiy.

; Move Up Edge Rows
;
; Used by the routines at #R$DB41 and #R$DB49.
; .
; The end of the routines that fill the edge: moves up the rows that are
; left in the step and then goes round for the next step.
;
; B Number of rows already filled
@label=MoveUpEdgeRows
c$DB29 LD A,($CE5A)  ; The vertical step copy.
 $DB2C SUB B         ; Subtract #REGb from #REGa.
 $DB2D LD B,A        ; #REGb=#REGa.
 $DB2E LD A,($CE44)  ; The segment row.
 $DB31 SUB B         ; Subtract #REGb from #REGa.
 $DB32 LD ($CE44),A  ; Update the segment row.
 $DB35 SRL B         ; Shift #REGb right.
@label=MoveUpEdgeRows_Up
*$DB37 DEC H         ; Step #REGh back.
 $DB38 CALL $A1C3    ; Call #R$A1C3.
 $DB3B DJNZ $DB37    ; Decrease #REGb and jump to #R$DB37 until none remain.
 $DB3D EXX           ; Switch to the alternate registers.
 $DB3E DJNZ $DB26    ; Decrease #REGb and jump to #R$DB26 until none remain.
 $DB40 RET           ; Return.

; Fill Two Edge Rows
;
; Fills one pair of pixel rows of the edge with the pattern in #REGde.
@label=FillTwoEdgeRows
c$DB41 CALL $DB5B    ; Call #R$DB5B.
 $DB44 LD B,$02      ; #REGb=#N$02.
 $DB46 JP $DB29      ; Jump to #R$DB29.

; Fill Four Edge Rows
;
; Fills two pairs of pixel rows of the edge with the pattern in #REGde,
; moving along by the column step between them.
@label=FillFourEdgeRows
c$DB49 CALL $DB5B    ; Call #R$DB5B.
 $DB4C LD A,($CE36)  ; The column step.
 $DB4F NEG           ; Negate #REGa.
 $DB51 ADD A,L       ; #REGa gains #REGl.
 $DB52 LD L,A        ; #REGl=#REGa.
 $DB53 CALL $DB5B    ; Call #R$DB5B.
 $DB56 LD B,$04      ; #REGb=#N$04.
 $DB58 JP $DB29      ; Jump to #R$DB29.

; Fill Edge Row Pair
;
; Used by the routines at #R$DB41 and #R$DB49.
; .
; Stores the pattern in #REGd and #REGe in two pixel rows, one above the
; other, for each of the #REGc cells across, but only the cells inside the area
; of the terrain. The pixel row in #R$CE44 goes up by two and the screen
; address moves up a row and along by the column step.
;
; C Number of cells
; DE Pattern for the two rows
; HL Screen address
@label=FillEdgeRowPair
c$DB5B LD A,($CE44)  ; The segment row.
 $DB5E CP $B8        ; {Jump to #R$DB78 if #REGa is #N$B8 or more.
 $DB60 JR NC,$DB78   ; }
 $DB62 CP $18        ; {Jump to #R$DB78 if #REGa is less than #N$18.
 $DB64 JR C,$DB78    ; }
 $DB66 LD B,C        ; #REGb=#REGc.
 $DB67 PUSH HL       ; Stash #REGhl on the stack.
@label=FillEdgeRowPair_Cell
*$DB68 LD A,L        ; #REGa=#REGl.
 $DB69 AND %00011111 ; Keep the bits of #REGa that are set in #N$1F.
 $DB6B DEC A         ; Step #REGa back.
 $DB6C CP $1C        ; {Jump to #R$DB74 if #REGa is #N$1C or more.
 $DB6E JR NC,$DB74   ; }
 $DB70 LD (HL),D     ; Write #REGd where #REGhl points.
 $DB71 DEC H         ; Step #REGh back.
 $DB72 LD (HL),E     ; Write #REGe where #REGhl points.
 $DB73 INC H         ; Advance #REGh.
@label=FillEdgeRowPair_Next
*$DB74 INC L         ; Advance #REGl.
 $DB75 DJNZ $DB68    ; Decrease #REGb and jump to #R$DB68 until none remain.
 $DB77 POP HL        ; Bring #REGhl back off the stack.
@label=FillEdgeRowPair_Up
*$DB78 LD A,($CE44)  ; The segment row.
 $DB7B DEC A         ; Step #REGa back.
 $DB7C DEC A         ; Step #REGa back.
 $DB7D LD ($CE44),A  ; Update the segment row.
 $DB80 LD A,($CE36)  ; The column step.
 $DB83 ADD A,L       ; #REGa gains #REGl.
 $DB84 LD L,A        ; #REGl=#REGa.
 $DB85 DEC H         ; Step #REGh back.
 $DB86 JP $A1C3      ; Jump to #R$A1C3.

; Draw Slope Rows
;
; Used by the routine at #R$D700.
; .
; Draws the rows of a piece of a slope two bytes wide, going up the
; screen two pixel rows at a time. The words of the picture are popped from the
; stack: the bytes of the first word go to the left and right, and of the third
; word to the right and left, so that they make a zigzag. The second word of
; each group is not used. The jump at #R$DB91 has its displacement set by
; #R$D3D2 to skip the first byte of each pair of rows when only part of the
; piece is drawn. When the pixel row is the top of a character the routine
; moves up to the character above.
;
; A Number of pairs of pixel rows to draw
; HL Screen address
; SP Address of the picture
@label=DrawSlopeRows
c$DB89 LD B,A        ; #REGb=#REGa.
 $DB8A LD A,($CE36)  ; The column step.
 $DB8D ADD A,L       ; #REGa gains #REGl.
 $DB8E LD L,A        ; #REGl=#REGa.
@label=DrawSlopeRows_Loop
*$DB8F POP DE        ; Bring #REGde back off the stack.
 $DB90 LD (HL),E     ; Write #REGe where #REGhl points.
@label=DrawSlopeRows_Patch
*$DB91 JR $DB91      ; Skip ahead by the displacement at #N$DB92.
 $DB93 INC L         ; Advance #REGl.
 $DB94 LD (HL),D     ; Write #REGd where #REGhl points.
 $DB95 DEC H         ; Step #REGh back.
 $DB96 POP DE        ; Bring #REGde back off the stack.
 $DB97 POP DE        ; Bring #REGde back off the stack.
 $DB98 LD (HL),E     ; Write #REGe where #REGhl points.
 $DB99 DEC L         ; Step #REGl back.
@label=DrawSlopeRows_Second
*$DB9A LD (HL),D     ; Write #REGd where #REGhl points.
 $DB9B DEC H         ; Step #REGh back.
 $DB9C LD A,H        ; #REGa=#REGh.
 $DB9D INC A         ; Advance #REGa.
 $DB9E AND %00000111 ; Keep the bits of #REGa that are set in #N$07.
 $DBA0 JR NZ,$DBAC   ; Jump to #R$DBAC if the zero flag is clear.
 $DBA2 LD A,L        ; #REGa=#REGl.
 $DBA3 SUB $20       ; Subtract #N$20 from #REGa.
 $DBA5 LD L,A        ; #REGl=#REGa.
 $DBA6 JR C,$DBAC    ; Jump to #R$DBAC if the carry flag is set.
 $DBA8 LD A,H        ; #REGa=#REGh.
 $DBA9 ADD A,$08     ; Add #N$08 to #REGa.
 $DBAB LD H,A        ; #REGh=#REGa.
@label=DrawSlopeRows_Next
*$DBAC DJNZ $DB8F    ; Decrease #REGb and jump to #R$DB8F until none remain.
 $DBAE JP $D711      ; Jump to #R$D711.
 $DBB1 POP DE        ; Bring #REGde back off the stack.
 $DBB2 POP DE        ; Bring #REGde back off the stack.
 $DBB3 DEC H         ; Step #REGh back.
 $DBB4 JP $DB9A      ; Jump to #R$DB9A.

; Draw Slope Rows From Edge
;
; Used by the routine at #R$D700.
; .
; Draws the rows of a piece of a slope two bytes wide, going up the
; screen two pixel rows at a time, starting from the second column of the row
; that the screen address is in (or the next one if it is in the last two
; columns). The two jumps at #R$DBC0 and #R$DBC5 are changed by #R$D3D2 to skip
; bytes when only part of the piece is to be drawn. The variable #R$5C2E sets
; where the next piece starts on the row. The routine finishes with #R$D711.
;
; A Number of pairs of pixel rows to draw
; HL Screen address
; SP Address of the picture
@label=DrawSlopeRowsFromEdge
c$DBB7 LD B,A        ; #REGb=#REGa.
 $DBB8 LD A,L        ; #REGa=#REGl.
 $DBB9 INC A         ; Advance #REGa.
 $DBBA INC A         ; Advance #REGa.
 $DBBB AND %11100000 ; Keep the bits of #REGa that are set in #N$E0.
 $DBBD INC A         ; Advance #REGa.
 $DBBE LD L,A        ; #REGl=#REGa.
 $DBBF INC SP        ; Advance #REGsp.
@label=DrawSlopeRowsFromEdge_PatchFirst
*$DBC0 JR $DBC0      ; Skip ahead by the displacement at #N$DBC1.
 $DBC2 INC SP        ; Advance #REGsp.
@label=DrawSlopeRowsFromEdge_Loop
*$DBC3 POP DE        ; Bring #REGde back off the stack.
 $DBC4 LD (HL),E     ; Write #REGe where #REGhl points.
@label=DrawSlopeRowsFromEdge_PatchSecond
*$DBC5 JR $DBC5      ; Skip ahead by the displacement at #N$DBC6.
 $DBC7 INC L         ; Advance #REGl.
 $DBC8 LD (HL),D     ; Write #REGd where #REGhl points.
 $DBC9 DEC H         ; Step #REGh back.
 $DBCA POP DE        ; Bring #REGde back off the stack.
 $DBCB LD (HL),E     ; Write #REGe where #REGhl points.
 $DBCC DEC L         ; Step #REGl back.
@label=DrawSlopeRowsFromEdge_StoreHigh
*$DBCD LD (HL),D     ; Write #REGd where #REGhl points.
@label=DrawSlopeRowsFromEdge_PopWord
*$DBCE POP DE        ; Bring #REGde back off the stack.
 $DBCF DEC H         ; Step #REGh back.
 $DBD0 LD A,H        ; #REGa=#REGh.
 $DBD1 INC A         ; Advance #REGa.
 $DBD2 AND %00000111 ; Keep the bits of #REGa that are set in #N$07.
 $DBD4 JR NZ,$DBE0   ; Jump to #R$DBE0 if the zero flag is clear.
 $DBD6 LD A,L        ; #REGa=#REGl.
 $DBD7 SUB $20       ; Subtract #N$20 from #REGa.
 $DBD9 LD L,A        ; #REGl=#REGa.
 $DBDA JR C,$DBE0    ; Jump to #R$DBE0 if the carry flag is set.
 $DBDC LD A,H        ; #REGa=#REGh.
 $DBDD ADD A,$08     ; Add #N$08 to #REGa.
 $DBDF LD H,A        ; #REGh=#REGa.
@label=DrawSlopeRowsFromEdge_Next
*$DBE0 DJNZ $DBC3    ; Decrease #REGb and jump to #R$DBC3 until none remain.
 $DBE2 LD A,($5C2E)  ; The piece column.
 $DBE5 LD B,A        ; #REGb=#REGa.
 $DBE6 LD A,($CE36)  ; The column step.
 $DBE9 LD C,A        ; #REGc=#REGa.
 $DBEA LD A,L        ; #REGa=#REGl.
 $DBEB AND %11100000 ; Keep the bits of #REGa that are set in #N$E0.
 $DBED OR B          ; Set the bits of #REGa that are set in #REGb.
 $DBEE SUB C         ; Subtract #REGc from #REGa.
 $DBEF LD L,A        ; #REGl=#REGa.
 $DBF0 JP $D711      ; Jump to #R$D711.
 $DBF3 DEC H         ; Step #REGh back.
 $DBF4 JP $DBCD      ; Jump to #R$DBCD.
 $DBF7 DEC H         ; Step #REGh back.
 $DBF8 LD (HL),D     ; Write #REGd where #REGhl points.
 $DBF9 POP DE        ; Bring #REGde back off the stack.
 $DBFA JP $DBCE      ; Jump to #R$DBCE.

; Draw Mirrored Rows From Edge
;
; Used by the routine at #R$D700.
; .
; Draws the rows of a piece of a slope back to front, two bytes wide,
; going up the screen two pixel rows at a time, starting from the second column
; of the row (see #R$DBB7). Each byte of the picture is reversed using the
; table at #N$F900 (#REGb is set to #N($F9)). The jumps at #R$DC0B and #R$DC13
; are changed by #R$D3D2 to skip bytes when only part of the piece is to be
; drawn.
;
; A Number of pairs of pixel rows to draw
; HL Screen address
; SP Address of the picture
@label=DrawMirroredRowsFromEdge
c$DBFD EXX           ; Switch to the alternate registers.
 $DBFE LD B,A        ; #REGb=#REGa.
 $DBFF EXX           ; Switch to the alternate registers.
 $DC00 LD A,L        ; #REGa=#REGl.
 $DC01 INC A         ; Advance #REGa.
 $DC02 INC A         ; Advance #REGa.
 $DC03 AND %11100000 ; Keep the bits of #REGa that are set in #N$E0.
 $DC05 INC A         ; Advance #REGa.
 $DC06 LD L,A        ; #REGl=#REGa.
 $DC07 LD B,$F9      ; #REGb=#N$F9.
 $DC09 EXX           ; Switch to the alternate registers.
 $DC0A INC SP        ; Advance #REGsp.
@label=DrawMirroredRowsFromEdge_PatchFirst
*$DC0B JR $DC0B      ; Skip ahead by the displacement at #N$DC0C.
 $DC0D INC SP        ; Advance #REGsp.
@label=DrawMirroredRowsFromEdge_Loop
*$DC0E EXX           ; Switch to the alternate registers.
 $DC0F POP DE        ; Bring #REGde back off the stack.
 $DC10 LD C,E        ; #REGc=#REGe.
 $DC11 LD A,(BC)     ; Read #REGbc.
 $DC12 LD (HL),A     ; Write #REGa where #REGhl points.
@label=DrawMirroredRowsFromEdge_PatchSecond
*$DC13 JR $DC13      ; Skip ahead by the displacement at #N$DC14.
 $DC15 INC L         ; Advance #REGl.
 $DC16 LD C,D        ; #REGc=#REGd.
 $DC17 LD A,(BC)     ; Read #REGbc.
 $DC18 LD (HL),A     ; Write #REGa where #REGhl points.
 $DC19 DEC H         ; Step #REGh back.
 $DC1A POP DE        ; Bring #REGde back off the stack.
 $DC1B LD C,E        ; #REGc=#REGe.
 $DC1C LD A,(BC)     ; Read #REGbc.
 $DC1D LD (HL),A     ; Write #REGa where #REGhl points.
 $DC1E DEC L         ; Step #REGl back.
@label=DrawMirroredRowsFromEdge_Second
*$DC1F LD C,D        ; #REGc=#REGd.
 $DC20 LD A,(BC)     ; Read #REGbc.
 $DC21 LD (HL),A     ; Write #REGa where #REGhl points.
@label=DrawMirroredRowsFromEdge_PopWord
*$DC22 POP DE        ; Bring #REGde back off the stack.
 $DC23 DEC H         ; Step #REGh back.
 $DC24 LD A,H        ; #REGa=#REGh.
 $DC25 INC A         ; Advance #REGa.
 $DC26 AND %00000111 ; Keep the bits of #REGa that are set in #N$07.
 $DC28 JR NZ,$DC34   ; Jump to #R$DC34 if the zero flag is clear.
 $DC2A LD A,L        ; #REGa=#REGl.
 $DC2B SUB $20       ; Subtract #N$20 from #REGa.
 $DC2D LD L,A        ; #REGl=#REGa.
 $DC2E JR C,$DC34    ; Jump to #R$DC34 if the carry flag is set.
 $DC30 LD A,H        ; #REGa=#REGh.
 $DC31 ADD A,$08     ; Add #N$08 to #REGa.
 $DC33 LD H,A        ; #REGh=#REGa.
@label=DrawMirroredRowsFromEdge_Next
*$DC34 EXX           ; Switch to the alternate registers.
 $DC35 DJNZ $DC0E    ; Decrease #REGb and jump to #R$DC0E until none remain.
 $DC37 EXX           ; Switch to the alternate registers.
 $DC38 JP $D711      ; Jump to #R$D711.
 $DC3B DEC H         ; Step #REGh back.
 $DC3C JP $DC1F      ; Jump to #R$DC1F.
 $DC3F DEC H         ; Step #REGh back.
 $DC40 LD C,D        ; #REGc=#REGd.
 $DC41 LD A,(BC)     ; Read #REGbc.
 $DC42 LD (HL),A     ; Write #REGa where #REGhl points.
 $DC43 POP DE        ; Bring #REGde back off the stack.
 $DC44 JP $DC22      ; Jump to #R$DC22.

; Draw Mirrored Slope Rows
;
; Used by the routine at #R$D700.
; .
; Draws the rows of a piece of a slope back to front, two bytes wide,
; going up the screen two pixel rows at a time. Each byte of the picture is
; reversed using the table at #N$F900 (#REGb is set to #N($F9)). The jump at
; #R$DC59 is changed by #R$D3D2 to skip bytes when only part of the piece is to
; be drawn, and the last words of each group are entered at #R$DC81 and
; #R$DC66.
;
; A Number of pairs of pixel rows to draw
; HL Screen address
; SP Address of the picture
@label=DrawMirroredSlopeRows
c$DC47 EXX           ; Switch to the alternate registers.
 $DC48 LD B,A        ; #REGb=#REGa.
 $DC49 EXX           ; Switch to the alternate registers.
 $DC4A LD A,($CE36)  ; The column step.
 $DC4D ADD A,L       ; #REGa gains #REGl.
 $DC4E LD L,A        ; #REGl=#REGa.
 $DC4F LD B,$F9      ; #REGb=#N$F9.
 $DC51 JP $DC55      ; Jump to #R$DC55.
@label=DrawMirroredSlopeRows_Loop
*$DC54 EXX           ; Switch to the alternate registers.
@label=DrawMirroredSlopeRows_PopWord
*$DC55 POP DE        ; Bring #REGde back off the stack.
 $DC56 LD C,E        ; #REGc=#REGe.
 $DC57 LD A,(BC)     ; Read #REGbc.
 $DC58 LD (HL),A     ; Write #REGa where #REGhl points.
@label=DrawMirroredSlopeRows_Patch
*$DC59 JR $DC59      ; Skip ahead by the displacement at #N$DC5A.
 $DC5B INC L         ; Advance #REGl.
 $DC5C LD C,D        ; #REGc=#REGd.
 $DC5D LD A,(BC)     ; Read #REGbc.
 $DC5E LD (HL),A     ; Write #REGa where #REGhl points.
 $DC5F DEC H         ; Step #REGh back.
 $DC60 POP DE        ; Bring #REGde back off the stack.
 $DC61 POP DE        ; Bring #REGde back off the stack.
 $DC62 LD C,E        ; #REGc=#REGe.
 $DC63 LD A,(BC)     ; Read #REGbc.
 $DC64 LD (HL),A     ; Write #REGa where #REGhl points.
 $DC65 DEC L         ; Step #REGl back.
@label=DrawMirroredSlopeRows_Second
*$DC66 LD C,D        ; #REGc=#REGd.
 $DC67 LD A,(BC)     ; Read #REGbc.
 $DC68 LD (HL),A     ; Write #REGa where #REGhl points.
 $DC69 DEC H         ; Step #REGh back.
 $DC6A LD A,H        ; #REGa=#REGh.
 $DC6B INC A         ; Advance #REGa.
 $DC6C AND %00000111 ; Keep the bits of #REGa that are set in #N$07.
 $DC6E JR NZ,$DC7A   ; Jump to #R$DC7A if the zero flag is clear.
 $DC70 LD A,L        ; #REGa=#REGl.
 $DC71 SUB $20       ; Subtract #N$20 from #REGa.
 $DC73 LD L,A        ; #REGl=#REGa.
 $DC74 JR C,$DC7A    ; Jump to #R$DC7A if the carry flag is set.
 $DC76 LD A,H        ; #REGa=#REGh.
 $DC77 ADD A,$08     ; Add #N$08 to #REGa.
 $DC79 LD H,A        ; #REGh=#REGa.
@label=DrawMirroredSlopeRows_Next
*$DC7A EXX           ; Switch to the alternate registers.
 $DC7B DJNZ $DC54    ; Decrease #REGb and jump to #R$DC54 until none remain.
 $DC7D EXX           ; Switch to the alternate registers.
 $DC7E JP $D711      ; Jump to #R$D711.
@label=DrawMirroredSlopeRows_Last
 $DC81 POP DE        ; Bring #REGde back off the stack.
 $DC82 POP DE        ; Bring #REGde back off the stack.
 $DC83 DEC H         ; Step #REGh back.
 $DC84 JP $DC66      ; Jump to #R$DC66.

; Tile Script Pointer
;
; The address in the list at #R$DC89 that #R$D0BD reads next.
@label=TileScriptPointer
g$DC87 DEFW $0000

; Tile Script Addresses
;
; The addresses of the scripts that draw the four tiles that are on the
; screen, which #R$DF08 gets from the table at #R$6C3C.
@label=TileScriptAddresses
g$DC89 DEFW $0000
 $DC8B DEFW $0000
 $DC8D DEFW $0000
 $DC8F DEFW $0000

; Visible Tiles
;
; The numbers of the four tiles that are on the screen, which #R$DF08
; reads from the map at #R$61BC. They are the top tile and the bottom tile of
; the left column and then the same of the right column.
@label=VisibleTiles
g$DC91 DEFB $02,$02,$02,$02

; Sky Attribute
;
; The attribute for the background of the map rows above row #N($0C),
; which #R$DCA1 gets from the table at #R$DC97.
@label=SkyAttribute
g$DC95 DEFB $00

; Underground Attribute
;
; The attribute for the background of the map rows from row #N($0C) down,
; which #R$DCA1 gets from the table at #R$DC97.
@label=UndergroundAttribute
g$DC96 DEFB $00

; Planet Attributes
;
; The attributes for the sky and for the underground of each of the five
; planets, in that order. The last byte is not used, so the second attribute of
; the fifth planet is taken from the code at #R$DCA1.
@label=PlanetAttributes
b$DC97 DEFB $43,$06
 $DC99 DEFB $44,$46
 $DC9B DEFB $47,$43
 $DC9D DEFB $46,$47
 $DC9F DEFB $45
 $DCA0 DEFB $44

; Begin Life
;
; Used by the routine at #R$F44C.
; .
; Sets up the screen at the start of each life. It shows the fuel gauge
; as empty but fills the tank, so the gauge fills up, and chooses the
; attributes for the planet. It restores the position of the ship from the
; state of the current player (which starts at #R$F5E7) and makes the tiles for
; that position. It builds the ship with #R$AFE9 and puts back any item that it
; was carrying. It then drops into the loop at #R$DD72 that scrolls the world
; until the ship is in place.
@label=BeginLife
c$DCA1 LD A,$BE      ; #REGa=#N$BE.
 $DCA3 LD ($CC62),A  ; Update the fuel gauge row.
 $DCA6 LD HL,$4200   ; #REGhl=#N$4200.
 $DCA9 LD ($CC4B),HL ; Update the fuel level.
 $DCAC XOR A         ; Clear #REGa.
 $DCAD LD ($F111),A  ; Clear the background attribute.
 $DCB0 CALL $F419    ; Call #R$F419.
 $DCB3 LD A,($F5F9)  ; The planet number, from #N($00) to #N($04).
 $DCB6 ADD A,A       ; Double #REGa.
 $DCB7 LD HL,$DC97   ; The planet attributes.
 $DCBA CALL $9BCF    ; Call #R$9BCF.
 $DCBD LD A,(HL)     ; Read #REGhl.
 $DCBE LD ($DC95),A  ; Update the sky attribute.
 $DCC1 INC HL        ; Advance #REGhl.
 $DCC2 LD A,(HL)     ; Read #REGhl.
 $DCC3 LD ($DC96),A  ; Update the underground attribute.
 $DCC6 LD A,($DC95)  ; The sky attribute.
 $DCC9 LD B,A        ; #REGb=#REGa.
 $DCCA LD A,($F5FB)  ; The map row of the position that the ship restarts at.
 $DCCD CP $0C        ; {Jump to #R$DCE3 if #REGa is less than #N$0C.
 $DCCF JR C,$DCE3    ; }
 $DCD1 LD A,($DC96)  ; The underground attribute.
 $DCD4 LD B,A        ; #REGb=#REGa.
 $DCD5 LD HL,$F628   ; The tenth item site.
 $DCD8 RES 7,(HL)    ; Reset bit 7 of the byte at the address in #REGhl.
 $DCDA LD HL,$F62C   ; The eleventh item site.
 $DCDD RES 7,(HL)    ; Reset bit 7 of the byte at the address in #REGhl.
 $DCDF XOR A         ; Clear #REGa.
 $DCE0 LD ($F5F7),A  ; Update the flag set when item #N($09) has been picked
                     ; up.
@label=BeginLife_Attributes
*$DCE3 LD A,B        ; #REGa=#REGb.
 $DCE4 LD ($F111),A  ; The background attribute.
 $DCE7 LD A,($F5FC)  ; The position of the ship: horizontal then vertical.
 $DCEA AND %00000001 ; Keep the bits of #REGa that are set in #N$01.
 $DCEC XOR %00000001 ; Flip the bits of #REGa that are set in #N$01.
 $DCEE LD ($DDF2),A  ; Update the chequered floor flag.
 $DCF1 JR Z,$DD0C    ; Jump to #R$DD0C if the zero flag is set.
 $DCF3 LD HL,$57C1   ; #REGhl=#N$57C1.
 $DCF6 LD C,$50      ; #REGc=#N$50.
@label=BeginLife_Row
*$DCF8 LD B,$1C      ; #REGb=#N$1C.
 $DCFA PUSH HL       ; Stash #REGhl on the stack.
@label=BeginLife_Cell
*$DCFB LD (HL),$55   ; Store #N$55 at the address in #REGhl.
 $DCFD DEC H         ; Step #REGh back.
 $DCFE LD (HL),$AA   ; Store #N$AA at the address in #REGhl.
 $DD00 INC H         ; Advance #REGh.
 $DD01 INC HL        ; Advance #REGhl.
 $DD02 DJNZ $DCFB    ; Decrease #REGb and jump to #R$DCFB until none remain.
 $DD04 POP HL        ; Bring #REGhl back off the stack.
 $DD05 DEC H         ; Step #REGh back.
 $DD06 CALL $A1C3    ; Call #R$A1C3.
 $DD09 DEC C         ; Step #REGc back.
 $DD0A JR NZ,$DCF8   ; Jump to #R$DCF8 if the zero flag is clear.
@label=BeginLife_Position
*$DD0C LD HL,($F5FA) ; Fetch the word at #R$F5FA into #REGhl.
 $DD0F INC H         ; Advance #REGh.
 $DD10 LD ($CE57),HL ; Update the map position.
 $DD13 LD HL,($F5FC) ; Fetch the word at #R$F5FC into #REGhl.
 $DD16 LD A,L        ; #REGa=#REGl.
 $DD17 AND %11111110 ; Keep the bits of #REGa that are set in #N$FE.
 $DD19 LD L,A        ; #REGl=#REGa.
 $DD1A LD ($CE45),HL ; Update the position across.
 $DD1D LD HL,($F5FE) ; Fetch the word at #R$F5FE into #REGhl.
 $DD20 LD ($CE41),HL ; Update the horizontal offset.
 $DD23 LD A,$02      ; #REGa=#N$02.
 $DD25 BIT 1,H       ; {Jump to #R$DD2A if bit 1 of #REGh is set.
 $DD27 JR NZ,$DD2A   ; }
 $DD29 ADD A,A       ; Double #REGa.
@label=BeginLife_Speed
*$DD2A LD ($CCBA),A  ; Update the vertical scroll speed.
 $DD2D LD A,$FF      ; #REGa=#N$FF.
 $DD2F LD ($5C3C),A  ; Update the scroll-in flag.
 $DD32 LD HL,($CE57) ; Fetch the word at #R$CE57 into #REGhl.
 $DD35 CALL $DF08    ; Call #R$DF08.
 $DD38 XOR A         ; Clear #REGa.
 $DD39 LD ($CCBB),A  ; Update the horizontal scroll speed.
 $DD3C LD A,$60      ; #REGa=#N$60.
 $DD3E LD ($C902),A  ; The column the ship starts drawn at.
 $DD41 LD BC,$012C   ; #REGbc=#N$012C.
 $DD44 LD HL,$F6B9   ; The ship work area.
@label=BeginLife_Clear
*$DD47 LD (HL),$00   ; Store #N$00 at the address in #REGhl.
 $DD49 INC HL        ; Advance #REGhl.
 $DD4A DEC BC        ; Step #REGbc back.
 $DD4B LD A,B        ; #REGa=#REGb.
 $DD4C OR C          ; Set the bits of #REGa that are set in #REGc.
 $DD4D JR NZ,$DD47   ; Jump to #R$DD47 if the zero flag is clear.
 $DD4F CALL $AFE9    ; Call #R$AFE9.
 $DD52 LD A,($F601)  ; The carried item.
 $DD55 INC A         ; Advance #REGa.
 $DD56 JR Z,$DD61    ; Jump to #R$DD61 if the zero flag is set.
 $DD58 DEC A         ; Step #REGa back.
 $DD59 OR %11000000  ; Set the bits of #REGa that are set in #N$C0.
 $DD5B LD ($C904),A  ; Update the item the ship is about to pick up.
 $DD5E CALL $AA37    ; Call #R$AA37.
@label=BeginLife_Continue
*$DD61 XOR A         ; Clear #REGa.
 $DD62 LD ($C904),A  ; Update the item the ship is about to pick up.
 $DD65 CALL $A8D9    ; Call #R$A8D9.
 $DD68 LD A,($5C38)  ; The ship row.
 $DD6B SUB $09       ; Subtract #N$09 from #REGa.
 $DD6D LD ($C7BE),A  ; The row of the carried item.
 $DD70 LD B,$28      ; #REGb=#N$28.
; Continue on to #R$DD72.

; Scroll In World
;
; Used by the routine at #R$DD79.
; .
; One step of the loop that runs at the start of a life, in which the
; world scrolls past while the fuel gauge is updated. The step is done by
; #R$DDF8, which comes back to #R$DD79 while the flag at #R$5C3C is not zero.
; The flag is #N($FF) while the scroll is looking for the ground, and then
; #N($03) until the loop ends.
;
; B Number of steps left
@label=ScrollInWorld
c$DD72 PUSH BC       ; Stash #REGbc on the stack.
 $DD73 CALL $CC77    ; Call #R$CC77.
 $DD76 JP $DDF8      ; Jump to #R$DDF8.

; Look For Ground
;
; Used by the routine at #R$DDF8.
; .
; Used while the world is scrolling in at the start of a life. If the
; flag at #R$5C3C is #N($03) the scroll is finished (see #R$DDBF). If not, the
; vertical scroll speed is set to #N($04). If the flag at #R$DDF2 is zero the
; scroll lasts for the number of steps that are left in #REGb. Otherwise it
; looks at the six bytes of the screen where the ship is, and at the row above
; them, and goes on scrolling until they are all blank. Then the flag is set to
; #N($03), the playfield is coloured and the tiles are made again.
@label=LookForGround
c$DD79 LD A,($5C3C)  ; The scroll-in flag.
 $DD7C CP $03        ; {Jump to #R$DDBF if #REGa is #N$03.
 $DD7E JP Z,$DDBF    ; }
 $DD81 LD A,$04      ; #REGa=#N$04.
 $DD83 LD ($CCBA),A  ; Update the vertical scroll speed.
 $DD86 LD A,($DDF2)  ; The chequered floor flag.
 $DD89 AND A         ; {Jump to #R$DDA7 if #REGa is zero.
 $DD8A JR Z,$DDA7    ; }
 $DD8C LD B,$06      ; #REGb=#N$06.
 $DD8E LD HL,($C902) ; Fetch the word at #N$C902 into #REGhl.
 $DD91 CALL $A149    ; Call #R$A149.
@label=LookForGround_Loop
*$DD94 LD A,(HL)     ; Read #REGhl.
 $DD95 AND A         ; {Jump to #R$DDA4 if #REGa is not zero.
 $DD96 JR NZ,$DDA4   ; }
 $DD98 DEC H         ; Step #REGh back.
 $DD99 LD A,(HL)     ; Read #REGhl.
 $DD9A AND A         ; {Jump to #R$DDA4 if #REGa is not zero.
 $DD9B JR NZ,$DDA4   ; }
 $DD9D INC H         ; Advance #REGh.
 $DD9E INC L         ; Advance #REGl.
 $DD9F DJNZ $DD94    ; Decrease #REGb and jump to #R$DD94 until none remain.
 $DDA1 POP BC        ; Bring #REGbc back off the stack.
 $DDA2 JR $DDAA      ; Jump to #R$DDAA.
@label=LookForGround_Restore
*$DDA4 POP BC        ; Bring #REGbc back off the stack.
 $DDA5 JR $DD72      ; Jump to #R$DD72.
@label=LookForGround_Count
*$DDA7 POP BC        ; Bring #REGbc back off the stack.
 $DDA8 DJNZ $DD72    ; Decrease #REGb and jump to #R$DD72 until none remain.
@label=LookForGround_Found
*$DDAA CALL $F419    ; Call #R$F419.
 $DDAD XOR A         ; Clear #REGa.
 $DDAE LD ($CCBA),A  ; Update the vertical scroll speed.
 $DDB1 LD A,$03      ; #REGa=#N$03.
 $DDB3 LD ($5C3C),A  ; Update the scroll-in flag.
 $DDB6 LD HL,($CE57) ; Fetch the word at #R$CE57 into #REGhl.
 $DDB9 CALL $DF08    ; Call #R$DF08.
 $DDBC JP $DD72      ; Jump to #R$DD72.

; Finish Scroll In
;
; Used by the routine at #R$DD79.
; .
; Ends the scroll at the start of a life. It clears the flag at #R$5C3C
; and makes the tiles for the current position again. It sets the map column
; and row, the position and the speeds of the ship from the position of the
; view, moves the ship with #R$BF66 and then goes to the sound routine at
; #N($71F0).
@label=FinishScrollIn
c$DDBF POP BC          ; Bring #REGbc back off the stack.
 $DDC0 XOR A           ; Clear #REGa.
 $DDC1 LD ($5C3C),A    ; Update the scroll-in flag.
 $DDC4 LD HL,($CE57)   ; Fetch the word at #R$CE57 into #REGhl.
 $DDC7 CALL $DF08      ; Call #R$DF08.
 $DDCA LD IX,$C8E5     ; The ship.
 $DDCE LD HL,($CE57)   ; Fetch the word at #R$CE57 into #REGhl.
 $DDD1 LD (IX+$01),L   ; Write #REGl to offset #N$01 of #REGix.
 $DDD4 LD (IX+$04),H   ; Write #REGh to offset #N$04 of #REGix.
 $DDD7 LD HL,($CE45)   ; Fetch the word at #R$CE45 into #REGhl.
 $DDDA LD (IX+$02),L   ; Write #REGl to offset #N$02 of #REGix.
 $DDDD LD (IX+$05),H   ; Write #REGh to offset #N$05 of #REGix.
 $DDE0 LD (IX+$07),$58 ; Store #N$58 at offset #N$07 of #REGix.
 $DDE4 LD A,(IX+$1E)   ; Read offset #N$1E of #REGix.
 $DDE7 SUB $17         ; Subtract #N$17 from #REGa.
 $DDE9 LD (IX+$09),A   ; Write #REGa to offset #N$09 of #REGix.
 $DDEC CALL $BF66      ; Call #R$BF66.
 $DDEF JP $71F0        ; Jump to #R$71F0.

; Chequered Floor Flag
;
; Set by #R$DCA1 to one when the horizontal position of the ship is an
; even number, in which case the bottom of the playfield is filled with a
; chequered pattern.
@label=ChequeredFloorFlag
g$DDF2 DEFB $01

; Unused
;
; Not referenced by the code.
@label=Unused_DDF3
g$DDF3 DEFB $00,$00

; Column Counts
;
; The number of map objects in the column that the left side of the
; screen is in and in the one to its right, set by #R$E08F.
@label=ColumnCounts
g$DDF5 DEFB $00
 $DDF6 DEFB $00

; Next Column
;
; The number of the map column that is to the right of the one that the
; left side of the screen is in, set by #R$E235. It wraps round from #N($5F) to
; #N($00).
@label=NextColumn
g$DDF7 DEFB $00

; Scroll World
;
; Used by the routines at #R$C374 and #R$DD72.
; .
; Moves the view of the world by the scroll speeds, which are the
; vertical speed at #R$CCBA and the horizontal speed at #R$CCBB. The speeds are
; added to the offsets within the tile and when an edge of the tile is passed
; the map position at #R$CE57 moves to the next tile. If any tile has changed
; the four visible tiles are found again. Unless the map row is above row
; #N($03), where there is no terrain, the tile scripts are then run to draw the
; tiles and to make the boxes for the terrain. The map objects, beams and stars
; are updated, and the lines at the bottom of the frame that the drawing may
; have damaged are drawn again.
@label=ScrollWorld
c$DDF8 LD A,($CCBA)  ; The vertical scroll speed.
 $DDFB BIT 7,A       ; {Jump to #R$DE01 if bit 7 of #REGa is clear.
 $DDFD JR Z,$DE01    ; }
 $DDFF NEG           ; Negate #REGa.
@label=ScrollWorld_Speed
*$DE01 LD ($CE3F),A  ; Update the vertical distance.
 $DE04 LD C,$00      ; Clear #REGc.
 $DE06 LD HL,($CE57) ; Fetch the word at #R$CE57 into #REGhl.
@label=ScrollWorld_Vertical
*$DE09 LD A,($CE42)  ; The vertical offset.
 $DE0C LD B,A        ; #REGb=#REGa.
 $DE0D LD A,($CCBA)  ; The vertical scroll speed.
 $DE10 ADD A,B       ; #REGa gains #REGb.
 $DE11 LD ($CE42),A  ; Update the vertical offset.
 $DE14 LD A,($CCBA)  ; The vertical scroll speed.
 $DE17 NEG           ; Negate #REGa.
 $DE19 LD B,A        ; #REGb=#REGa.
 $DE1A LD A,($CE46)  ; The position down.
 $DE1D ADD A,B       ; #REGa gains #REGb.
 $DE1E LD ($CE46),A  ; Update the position down.
 $DE21 CP $B8        ; {Jump to #R$DE37 if #REGa is #N$B8 or more.
 $DE23 JR NC,$DE37   ; }
 $DE25 CP $16        ; {Jump to #R$DE46 if #REGa is #N$16 or more.
 $DE27 JR NC,$DE46   ; }
@label=ScrollWorld_Up
 $DE29 LD A,$B7      ; #REGa=#N$B7.
 $DE2B LD ($CE46),A  ; Update the position down.
 $DE2E XOR A         ; Clear #REGa.
 $DE2F LD ($CE42),A  ; Update the vertical offset.
 $DE32 DEC H         ; Step #REGh back.
 $DE33 INC C         ; Advance #REGc.
 $DE34 JP $DE09      ; Jump to #R$DE09.
@label=ScrollWorld_Down
*$DE37 LD A,$17      ; #REGa=#N$17.
 $DE39 LD ($CE46),A  ; Update the position down.
 $DE3C LD A,$A0      ; #REGa=#N$A0.
 $DE3E LD ($CE42),A  ; Update the vertical offset.
 $DE41 INC H         ; Advance #REGh.
 $DE42 INC C         ; Advance #REGc.
 $DE43 JP $DE09      ; Jump to #R$DE09.
@label=ScrollWorld_Horizontal
*$DE46 LD A,($CCBB)  ; The horizontal scroll speed.
 $DE49 LD B,A        ; #REGb=#REGa.
 $DE4A LD A,($CE41)  ; The horizontal offset.
 $DE4D ADD A,B       ; #REGa gains #REGb.
 $DE4E LD ($CE41),A  ; Update the horizontal offset.
 $DE51 LD A,($CCBB)  ; The horizontal scroll speed.
 $DE54 NEG           ; Negate #REGa.
 $DE56 LD B,A        ; #REGb=#REGa.
 $DE57 LD A,($CE45)  ; The position across.
 $DE5A ADD A,B       ; #REGa gains #REGb.
 $DE5B LD ($CE45),A  ; Update the position across.
 $DE5E CP $E9        ; {Jump to #R$DE75 if #REGa is #N$E9 or more.
 $DE60 JR NC,$DE75   ; }
 $DE62 CP $07        ; {Jump to #R$DE83 if #REGa is #N$07 or more.
 $DE64 JR NC,$DE83   ; }
@label=ScrollWorld_Left
 $DE66 LD A,$E8      ; #REGa=#N$E8.
 $DE68 LD ($CE45),A  ; Update the position across.
 $DE6B LD A,$20      ; #REGa=#N$20.
 $DE6D LD ($CE41),A  ; Update the horizontal offset.
 $DE70 DEC L         ; Step #REGl back.
 $DE71 INC C         ; Advance #REGc.
 $DE72 JP $DE46      ; Jump to #R$DE46.
@label=ScrollWorld_Right
*$DE75 LD A,$08      ; #REGa=#N$08.
 $DE77 LD ($CE45),A  ; Update the position across.
 $DE7A XOR A         ; Clear #REGa.
 $DE7B LD ($CE41),A  ; Update the horizontal offset.
 $DE7E INC L         ; Advance #REGl.
 $DE7F INC C         ; Advance #REGc.
 $DE80 JP $DE46      ; Jump to #R$DE46.
@label=ScrollWorld_Redraw
*$DE83 LD A,C        ; #REGa=#REGc.
 $DE84 LD ($5C3D),A  ; Update the tiles changed.
 $DE87 AND A         ; {Call #R$DF08 if #REGa is not zero.
 $DE88 CALL NZ,$DF08 ; }
 $DE8B CALL $DEE1    ; Call #R$DEE1.
 $DE8E LD DE,$DC89   ; The tile script addresses.
 $DE91 LD ($DC87),DE ; Update the tile script pointer.
 $DE95 LD A,($CCBA)  ; The vertical scroll speed.
 $DE98 BIT 7,A       ; {Call #R$AC60 if bit 7 of #REGa is set.
 $DE9A CALL NZ,$AC60 ; }
 $DE9D LD A,($CE58)  ; The map row.
 $DEA0 CP $03        ; {Jump to #R$DEB3 if #REGa is #N$03 or more.
 $DEA2 JR NC,$DEB3   ; }
 $DEA4 XOR A         ; Clear #REGa.
 $DEA5 LD ($5B80),A  ; Update the decryption routine.
 $DEA8 LD ($5BA5),A  ; Clear the second tile record.
 $DEAB LD ($5BCA),A  ; Clear the third tile record.
 $DEAE LD ($5BEF),A  ; Clear the fourth tile record.
 $DEB1 JR $DEB6      ; Jump to #R$DEB6.
@label=ScrollWorld_Terrain
*$DEB3 CALL $D0BD    ; Call #R$D0BD.
@label=ScrollWorld_Objects
*$DEB6 LD A,($CCBA)  ; The vertical scroll speed.
 $DEB9 BIT 7,A       ; {Call #R$AC60 if bit 7 of #REGa is clear.
 $DEBB CALL Z,$AC60  ; }
 $DEBE CALL $9BDA    ; Call #R$9BDA.
 $DEC1 CALL $BFE3    ; Call #R$BFE3.
 $DEC4 LD A,$FF      ; #REGa=#N$FF.
 $DEC6 LD ($56E1),A  ; A solid pixel byte in the playfield.
 $DEC9 LD ($55E1),A  ; A solid pixel byte in the playfield.
 $DECC LD ($52E1),A  ; A solid pixel byte in the playfield.
 $DECF LD ($51E1),A  ; A solid pixel byte in the playfield.
 $DED2 LD A,($5C3C)  ; The scroll-in flag.
 $DED5 AND A         ; {Jump to #R$C3E3 if #REGa is zero.
 $DED6 JP Z,$C3E3    ; }
 $DED9 JP $DD79      ; Jump to #R$DD79.
@label=ScrollWorld_Record
 $DEDC NOP           ; Do nothing.
 $DEDD NOP           ; Do nothing.
 $DEDE NOP           ; Do nothing.
 $DEDF NOP           ; Do nothing.
 $DEE0 NOP           ; Do nothing.

; Set Row Attributes
;
; Used by the routine at #R$DDF8.
; .
; Does nothing unless the tiles have just changed or the world is being
; scrolled in at the start of a life. Sets the attributes of the background for
; the two rows of the tile at #R$5C3A and #R$5C3B.
@label=SetRowAttributes
c$DEE1 LD A,($5C3D)  ; The tiles changed.
 $DEE4 LD B,A        ; #REGb=#REGa.
 $DEE5 LD A,($5C3C)  ; The scroll-in flag.
 $DEE8 OR B          ; Set the bits of #REGa that are set in #REGb.
 $DEE9 RET Z         ; Return if the zero flag is set.
 $DEEA LD A,($CE58)  ; The map row.
 $DEED CALL $DEF7    ; Call #R$DEF7.
 $DEF0 LD ($5C3A),A  ; Update the top-tile colour.
 $DEF3 LD A,($CE58)  ; The map row.
 $DEF6 INC A         ; Advance #REGa.
; Continue on to #R$DEF7.

; Choose Row Attribute
;
; Used by the routine at #R$DEE1.
; .
; Chooses the attribute for the background of a map row: the one at
; #R$DC95 for the rows above row #N($0C) and the one at #R$DC96 for the rows
; from row #N($0C) down.
;
;   A Map row
; O:A Attribute
@label=ChooseRowAttribute
c$DEF7 CP $0C        ; Compare #REGa with #N$0C.
 $DEF9 LD A,($DC95)  ; The sky attribute.
 $DEFC LD B,A        ; #REGb=#REGa.
 $DEFD JR C,$DF03    ; Jump to #R$DF03 if the carry flag is set.
 $DEFF LD A,($DC96)  ; The underground attribute.
 $DF02 LD B,A        ; #REGb=#REGa.
@label=ChooseRowAttribute_Store
*$DF03 LD A,B        ; #REGa=#REGb.
 $DF04 LD ($5C3B),A  ; Update the bottom-tile colour.
 $DF07 RET           ; Return.

; Make Tiles
;
; Used by the routines at #R$DCA1, #R$DD79, #R$DDBF and #R$DDF8.
; .
; Finds the four tiles that are on the screen for a position on the map.
; The tile numbers are read from the map for two columns and two rows, and are
; stored in the table at #R$DC91. Tiles that are above the first row, or below
; the last row (rows #N($1C) and #N($1D)), are blank. While the world scrolls
; in at the start of a life tile #N($3E) is replaced by #N($AA). The address of
; the script of each tile is looked up in the table at #R$6C3C and stored in
; the list at #R$DC89. Unless the world is being scrolled in, the pick-ups and
; the map objects for the position are then put in their slots, and the slots
; of any that are no longer on the screen are freed.
;
; HL Map position (#REGl is the column and #REGh is the row)
@label=MakeTiles
c$DF08 LD DE,$0060     ; #REGde=#N$60.
 $DF0B LD A,L          ; #REGa=#REGl.
 $DF0C CP $FF          ; {Jump to #R$DF12 if #REGa is not #N$FF.
 $DF0E JR NZ,$DF12     ; }
 $DF10 LD L,$5F        ; #REGl=#N$5F.
@label=MakeTiles_Wrapped
*$DF12 CP $60          ; {Jump to #R$DF18 if #REGa is not #N$60.
 $DF14 JR NZ,$DF18     ; }
 $DF16 LD L,$00        ; Clear #REGl.
@label=MakeTiles_Start
*$DF18 LD ($CE57),HL   ; Update the map position.
 $DF1B LD BC,$DC89     ; Set #REGbc to #R$DC89.
 $DF1E LD ($DC87),BC   ; Update the tile script pointer.
 $DF22 PUSH HL         ; Stash #REGhl on the stack.
 $DF23 CALL $E235      ; Call #R$E235.
 $DF26 LD ($DC91),A    ; Update the visible tiles.
 $DF29 ADD HL,DE       ; #REGhl gains #REGde.
 $DF2A LD A,(HL)       ; Read #REGhl.
 $DF2B LD ($DC92),A    ; The bottom tile of the left column.
 $DF2E POP HL          ; Bring #REGhl back off the stack.
 $DF2F INC L           ; Advance #REGl.
 $DF30 CALL $E235      ; Call #R$E235.
 $DF33 LD ($DC93),A    ; The top tile of the right column.
 $DF36 ADD HL,DE       ; #REGhl gains #REGde.
 $DF37 LD A,(HL)       ; Read #REGhl.
 $DF38 LD ($DC94),A    ; The bottom tile of the right column.
 $DF3B LD A,($CE58)    ; The map row.
 $DF3E CP $1C          ; {Jump to #R$DF4A if #REGa is not #N$1C.
 $DF40 JR NZ,$DF4A     ; }
 $DF42 LD A,$20        ; #REGa=#N$20.
 $DF44 LD ($DC92),A    ; The bottom tile of the left column is empty.
 $DF47 LD ($DC94),A    ; The bottom tile of the right column is empty.
@label=MakeTiles_Rows
*$DF4A CP $1D          ; {Jump to #R$DF59 if #REGa is not #N$1D.
 $DF4C JR NZ,$DF59     ; }
 $DF4E LD BC,$2020     ; #REGbc=#N$2020.
 $DF51 LD ($DC91),BC   ; Update the visible tiles.
 $DF55 LD ($DC93),BC   ; The right column is empty.
@label=MakeTiles_Scripts
*$DF59 LD A,($5C3C)    ; The scroll-in flag.
 $DF5C BIT 7,A         ; {Jump to #R$DF6F if bit 7 of #REGa is clear.
 $DF5E JR Z,$DF6F      ; }
 $DF60 LD B,$04        ; #REGb=#N$04.
 $DF62 LD HL,$DC91     ; The visible tiles.
@label=MakeTiles_Search
*$DF65 LD A,(HL)       ; Read #REGhl.
 $DF66 CP $3E          ; {Jump to #R$DF6C if #REGa is not #N$3E.
 $DF68 JR NZ,$DF6C     ; }
 $DF6A LD (HL),$AA     ; Store #N$AA at the address in #REGhl.
@label=MakeTiles_Next
*$DF6C INC HL          ; Advance #REGhl.
 $DF6D DJNZ $DF65      ; Decrease #REGb and jump to #R$DF65 until none remain.
@label=MakeTiles_Lookup
*$DF6F LD BC,$DC91     ; Set #REGbc to #R$DC91.
 $DF72 LD A,$04        ; #REGa=#N$04.
@label=MakeTiles_Tile
*$DF74 EX AF,AF'       ; Switch to the alternate accumulator and flags.
 $DF75 LD A,(BC)       ; Read #REGbc.
 $DF76 LD L,A          ; #REGl=#REGa.
 $DF77 LD H,$00        ; Clear #REGh.
 $DF79 LD DE,$6C3C     ; The tile script pointers.
 $DF7C ADD HL,HL       ; Double #REGhl.
 $DF7D ADD HL,DE       ; #REGhl gains #REGde.
 $DF7E LD E,(HL)       ; Read #REGhl into #REGe.
 $DF7F INC HL          ; Advance #REGhl.
 $DF80 LD D,(HL)       ; Read #REGhl into #REGd.
 $DF81 LD HL,($DC87)   ; Fetch the word at #R$DC87 into #REGhl.
 $DF84 LD (HL),E       ; Write #REGe where #REGhl points.
 $DF85 INC HL          ; Advance #REGhl.
 $DF86 LD (HL),D       ; Write #REGd where #REGhl points.
 $DF87 INC HL          ; Advance #REGhl.
 $DF88 LD ($DC87),HL   ; Update the tile script pointer.
 $DF8B INC BC          ; Advance #REGbc.
 $DF8C EX AF,AF'       ; Switch to the alternate accumulator and flags.
 $DF8D DEC A           ; Step #REGa back.
 $DF8E JR NZ,$DF74     ; Jump to #R$DF74 if the zero flag is clear.
 $DF90 LD A,($5C3C)    ; The scroll-in flag.
 $DF93 AND A           ; {Return if #REGa is not zero.
 $DF94 RET NZ          ; }
@label=MakeTiles_PickUps
 $DF95 LD A,$0C        ; #REGa=#N$0C.
 $DF97 LD ($5C1C),A    ; The object type is #N($0C).
 $DF9A LD IX,$A873     ; The fifth map-object slot.
 $DF9E LD B,$02        ; #REGb=#N$02.
 $DFA0 CALL $E062      ; Call #R$E062.
 $DFA3 LD IX,$F604     ; The item sites.
 $DFA7 LD HL,($CE57)   ; Fetch the word at #R$CE57 into #REGhl.
 $DFAA LD A,($DDF7)    ; The next column.
 $DFAD LD D,A          ; #REGd=#REGa.
 $DFAE LD BC,$1300     ; #REGbc=#N$1300.
@label=MakeTiles_NextSite
*$DFB1 LD A,C          ; #REGa=#REGc.
 $DFB2 SUB $0B         ; Subtract #N$0B from #REGa.
 $DFB4 JR NZ,$DFBC     ; Jump to #R$DFBC if the zero flag is clear.
 $DFB6 LD C,A          ; #REGc=#REGa.
 $DFB7 LD A,$1E        ; #REGa=#N$1E.
 $DFB9 LD ($5C1C),A    ; The object type is #N($1E).
@label=MakeTiles_Object
*$DFBC BIT 7,(IX+$00)  ; {Jump to #R$E01D if bit 7 of offset #N$00 of #REGix is
 $DFC0 JR NZ,$E01D     ; set.}
 $DFC2 LD A,(IX+$00)   ; Read offset #N$00 of #REGix.
 $DFC5 CP L            ; {Jump to #R$DFCB if #REGa is #REGl.
 $DFC6 JR Z,$DFCB      ; }
 $DFC8 CP D            ; {Jump to #R$E01D if #REGa is not #REGd.
 $DFC9 JR NZ,$E01D     ; }
@label=MakeTiles_Compare
*$DFCB LD A,H          ; #REGa=#REGh.
 $DFCC INC A           ; Advance #REGa.
 $DFCD CP (IX+$01)     ; {Jump to #R$DFD8 if #REGa is the byte at offset #N$01
 $DFD0 JR Z,$DFD8      ; of #REGix.}
 $DFD2 LD A,H          ; #REGa=#REGh.
 $DFD3 CP (IX+$01)     ; {Jump to #R$E01D if #REGa is not the byte at offset #N$01 of
 $DFD6 JR NZ,$E01D     ; #REGix.}
@label=MakeTiles_Slot
*$DFD8 LD IY,$A873     ; The fifth map-object slot.
 $DFDC CALL $E03D      ; Call #R$E03D.
 $DFDF JR Z,$E01D      ; Jump to #R$E01D if the zero flag is set.
 $DFE1 LD IY,$A88D     ; The sixth map-object slot.
 $DFE5 CALL $E03D      ; Call #R$E03D.
 $DFE8 JR Z,$E01D      ; Jump to #R$E01D if the zero flag is set.
 $DFEA LD IY,$A873     ; The fifth map-object slot.
 $DFEE LD A,(IY+$00)   ; Read offset #N$00 of #REGiy.
 $DFF1 INC A           ; Advance #REGa.
 $DFF2 JR Z,$DFF8      ; Jump to #R$DFF8 if the zero flag is set.
 $DFF4 LD IY,$A88D     ; The sixth map-object slot.
@label=MakeTiles_FillSlot
*$DFF8 LD A,(IX+$00)   ; Read offset #N$00 of #REGix.
 $DFFB LD (IY+$01),A   ; Write #REGa to offset #N$01 of #REGiy.
 $DFFE LD A,(IX+$01)   ; Read offset #N$01 of #REGix.
 $E001 LD (IY+$04),A   ; Write #REGa to offset #N$04 of #REGiy.
 $E004 LD A,(IX+$02)   ; Read offset #N$02 of #REGix.
 $E007 LD (IY+$02),A   ; Write #REGa to offset #N$02 of #REGiy.
 $E00A LD A,(IX+$03)   ; Read offset #N$03 of #REGix.
 $E00D LD (IY+$05),A   ; Write #REGa to offset #N$05 of #REGiy.
 $E010 LD (IY+$13),C   ; Write #REGc to offset #N$13 of #REGiy.
 $E013 LD (IY+$0D),$FF ; Store #N$FF at offset #N$0D of #REGiy.
 $E017 LD A,($5C1C)    ; The object type.
 $E01A LD (IY+$00),A   ; Write #REGa to offset #N$00 of #REGiy.
@label=MakeTiles_Skip
*$E01D INC IX          ; Advance #REGix.
 $E01F INC IX          ; Advance #REGix.
 $E021 INC IX          ; Advance #REGix.
 $E023 INC IX          ; Advance #REGix.
 $E025 INC C           ; Advance #REGc.
 $E026 DJNZ $DFB1      ; Decrease #REGb and jump to #R$DFB1 until none remain.
@label=MakeTiles_Finish
 $E028 LD IX,$A873     ; The fifth map-object slot.
 $E02C LD B,$02        ; #REGb=#N$02.
 $E02E CALL $E0EA      ; Call #R$E0EA.
 $E031 LD IX,$A80B     ; The map object slots.
 $E035 LD B,$04        ; #REGb=#N$04.
 $E037 CALL $E062      ; Call #R$E062.
 $E03A JP $E08F        ; Jump to #R$E08F.

; Compare Slot With Site
;
; Used by the routine at #R$DF08.
; .
; Compares a slot for a pick-up with a site, using the column, the row
; and the position. The result is that the zero flag is set if the slot holds
; the pick-up for the site, and is clear if not or if the slot is free.
;
;   IX Address of the site
;   IY Address of the slot
; O:F Zero flag set if the slot has the pick-up
@label=CompareSlotWithSite
c$E03D LD A,(IY+$00) ; Read offset #N$00 of #REGiy.
 $E040 INC A         ; Advance #REGa.
 $E041 JR Z,$E05F    ; Jump to #R$E05F if the zero flag is set.
 $E043 LD A,(IX+$00) ; Read offset #N$00 of #REGix.
 $E046 CP (IY+$01)   ; {Return if #REGa is not the byte at offset #N$01 of
 $E049 RET NZ        ; #REGiy.}
 $E04A LD A,(IX+$01) ; Read offset #N$01 of #REGix.
 $E04D CP (IY+$04)   ; {Return if #REGa is not the byte at offset #N$04 of
 $E050 RET NZ        ; #REGiy.}
 $E051 LD A,(IX+$02) ; Read offset #N$02 of #REGix.
 $E054 CP (IY+$02)   ; {Return if #REGa is not the byte at offset #N$02 of
 $E057 RET NZ        ; #REGiy.}
 $E058 LD A,(IX+$03) ; Read offset #N$03 of #REGix.
 $E05B CP (IY+$05)   ; Compare #REGa with the byte at offset #N$05 of #REGiy.
 $E05E RET           ; Return.
@label=CompareSlotWithSite_Free
*$E05F OR %00000001  ; Set the bits of #REGa that are set in #N$01.
 $E061 RET           ; Return.

; Free Distant Slots
;
; Used by the routine at #R$DF08.
; .
; Frees any slots of objects that are not on one of the two columns and
; two rows that are on the screen.
;
; B Number of slots
; IX Address of the first slot
@label=FreeDistantSlots
c$E062 LD A,($DDF7)    ; The next column.
 $E065 LD C,A          ; #REGc=#REGa.
 $E066 LD DE,$001A     ; #REGde=#N$1A.
 $E069 LD HL,($CE57)   ; Fetch the word at #R$CE57 into #REGhl.
 $E06C INC H           ; Advance #REGh.
@label=FreeDistantSlots_Loop
*$E06D LD A,(IX+$00)   ; Read offset #N$00 of #REGix.
 $E070 INC A           ; Advance #REGa.
 $E071 JR Z,$E08A      ; Jump to #R$E08A if the zero flag is set.
 $E073 LD A,(IX+$01)   ; Read offset #N$01 of #REGix.
 $E076 CP L            ; {Jump to #R$E07C if #REGa is #REGl.
 $E077 JR Z,$E07C      ; }
 $E079 CP C            ; {Jump to #R$E086 if #REGa is not #REGc.
 $E07A JR NZ,$E086     ; }
@label=FreeDistantSlots_Row
*$E07C LD A,(IX+$04)   ; Read offset #N$04 of #REGix.
 $E07F CP H            ; {Jump to #R$E08A if #REGa is #REGh.
 $E080 JR Z,$E08A      ; }
 $E082 INC A           ; Advance #REGa.
 $E083 CP H            ; {Jump to #R$E08A if #REGa is #REGh.
 $E084 JR Z,$E08A      ; }
@label=FreeDistantSlots_Free
*$E086 LD (IX+$00),$FF ; Store #N$FF at offset #N$00 of #REGix.
@label=FreeDistantSlots_Next
*$E08A ADD IX,DE       ; #REGix gains #REGde.
 $E08C DJNZ $E06D      ; Decrease #REGb and jump to #R$E06D until none remain.
 $E08E RET             ; Return.

; Load Map Objects
;
; Used by the routine at #R$DF08.
; .
; Puts the objects of the map for the two columns that are on the screen
; into the slots for the map objects. The objects of a column are found by
; adding up the numbers of the objects in the columns before it, from the table
; at #R$5DB6, to get the place in the tables at #R$5C94 and #R$5E17. If the
; second column wraps round to column zero its objects are the first in the
; tables. The slots of any objects that are free have their flags cleared.
@label=LoadMapObjects
c$E08F LD A,($CE57)  ; The map position.
 $E092 LD B,A        ; #REGb=#REGa.
 $E093 LD HL,$0000   ; #REGhl=#N$00.
 $E096 LD DE,$5DB6   ; The column table.
 $E099 AND A         ; {Jump to #R$E0A3 if #REGa is zero.
 $E09A JR Z,$E0A3    ; }
@label=LoadMapObjects_Count
*$E09C LD A,(DE)     ; Read #REGde.
 $E09D CALL $9BCF    ; Call #R$9BCF.
 $E0A0 INC DE        ; Advance #REGde.
 $E0A1 DJNZ $E09C    ; Decrease #REGb and jump to #R$E09C until none remain.
@label=LoadMapObjects_Column
*$E0A3 LD ($CE3A),HL ; The column of the map objects.
 $E0A6 ADD HL,HL     ; Double #REGhl.
 $E0A7 EX DE,HL      ; Swap #REGde and #REGhl.
 $E0A8 LD A,(HL)     ; Read #REGhl.
 $E0A9 LD ($DDF5),A  ; Update the column counts.
 $E0AC INC HL        ; Advance #REGhl.
 $E0AD LD A,(HL)     ; Read #REGhl.
 $E0AE LD ($DDF6),A  ; The object count of the next column.
 $E0B1 LD IX,$5E17   ; The terrain data.
 $E0B5 ADD IX,DE     ; #REGix gains #REGde.
 $E0B7 LD DE,$5C94   ; The map table.
 $E0BA LD HL,($CE3A) ; Fetch the word at #R$CE3A into #REGhl.
 $E0BD ADD HL,DE     ; #REGhl gains #REGde.
 $E0BE LD A,($CE57)  ; The map position.
 $E0C1 LD C,A        ; #REGc=#REGa.
 $E0C2 LD A,($DDF5)  ; The column counts.
 $E0C5 LD B,A        ; #REGb=#REGa.
 $E0C6 CALL $E114    ; Call #R$E114.
 $E0C9 LD A,($DDF7)  ; The next column.
 $E0CC AND A         ; {Jump to #R$E0DC if #REGa is not zero.
 $E0CD JR NZ,$E0DC   ; }
 $E0CF LD HL,$0000   ; #REGhl=#N$00.
 $E0D2 LD ($CE3A),HL ; The column of the map objects.
 $E0D5 LD HL,$5C94   ; The map table.
 $E0D8 LD IX,$5E17   ; The terrain data.
@label=LoadMapObjects_Second
*$E0DC LD C,A        ; #REGc=#REGa.
 $E0DD LD A,($DDF6)  ; The object count of the next column.
 $E0E0 LD B,A        ; #REGb=#REGa.
 $E0E1 CALL $E114    ; Call #R$E114.
 $E0E4 LD B,$04      ; #REGb=#N$04.
 $E0E6 LD IX,$A80B   ; The map object slots.
; Continue on to #R$E0EA.

; Clear Free Slot Flags
;
; Used by the routine at #R$DF08.
; .
; Clears the flags at offset #N($10) of every slot of the map objects
; that is free.
;
; B Number of slots
; IX Address of the first slot
@label=ClearFreeSlotFlags
c$E0EA LD DE,$001A     ; #REGde=#N$1A.
@label=ClearFreeSlotFlags_Loop
*$E0ED LD A,(IX+$00)   ; Read offset #N$00 of #REGix.
 $E0F0 CP $FF          ; {Jump to #R$E0F8 if #REGa is not #N$FF.
 $E0F2 JR NZ,$E0F8     ; }
 $E0F4 LD (IX+$10),$00 ; Store #N$00 at offset #N$10 of #REGix.
@label=ClearFreeSlotFlags_Next
*$E0F8 ADD IX,DE       ; #REGix gains #REGde.
 $E0FA DJNZ $E0ED      ; Decrease #REGb and jump to #R$E0ED until none remain.
 $E0FC RET             ; Return.

; Object Kinds
;
; One byte for each kind of object on the map. The top three bits are
; shifted down into bits 1 to 3 of offset #N($18) of the slot, where #R$AC60
; passes them to #R$8820 when they are not zero. If bit 4 is set the object is
; one of the special ones, and the bottom four bits are the offset in #R$E10E
; of its state.
@label=ObjectKinds
b$E0FD DEFB $40
 $E0FE DEFB $01
 $E0FF DEFB $02
 $E100 DEFB $23
 $E101 DEFB $D0
 $E102 DEFB $92
 $E103 DEFB $06
 $E104 DEFB $07
 $E105 DEFB $08
 $E106 DEFB $09
 $E107 DEFB $0A
 $E108 DEFB $0B
 $E109 DEFB $B2
 $E10A DEFB $6D
 $E10B DEFB $14
 $E10C DEFB $0F
 $E10D DEFB $10

; Special Object States
;
; The states for the special kinds of object, which are put in offsets
; #N($13) and #N($14) of the slot.
@label=SpecialObjectStates
b$E10E DEFB $50,$01
 $E110 DEFB $52,$23
 $E112 DEFB $54,$45

; Add Map Objects
;
; Used by the routine at #R$E08F.
; .
; Puts the objects of one column of the map in free slots of the map
; objects. An object is skipped if the current player has destroyed it (bit 7
; of its byte in the table at #R$5C94 is set, or bit 6 for player two), if it
; is not on one of the two rows that are on the screen or if there is already a
; slot for it. It is put in the first free slot of the first three slots, or in
; the fourth if none of them is free. Its column, row, position and kind are
; set from the tables. The slot holds the index of the object in offsets
; #N($18) and #N($19) so that the object can be marked as destroyed later.
;
; B Number of objects in the column
; C Column
; HL Address of the first object in #R$5C94
; IX Address of the first object in #R$5E17
@label=AddMapObjects
c$E114 AND A           ; {Return if #REGa is zero.
 $E115 RET Z           ; }
@label=AddMapObjects_Next2
*$E116 PUSH BC         ; Stash #REGbc on the stack.
 $E117 BIT 7,(HL)      ; {Jump to #R$E1F1 if bit 7 of the byte at the address in #REGhl is
 $E119 JP NZ,$E1F1     ; set.}
 $E11C LD A,(IX+$01)   ; Read offset #N$01 of #REGix.
 $E11F AND %00011111   ; Keep the bits of #REGa that are set in #N$1F.
 $E121 LD E,A          ; #REGe=#REGa.
 $E122 LD A,($CE58)    ; The map row.
 $E125 CP E            ; {Jump to #R$E12D if #REGa is #REGe.
 $E126 JR Z,$E12D      ; }
 $E128 INC A           ; Advance #REGa.
 $E129 CP E            ; {Jump to #R$E1F1 if #REGa is not #REGe.
 $E12A JP NZ,$E1F1     ; }
@label=AddMapObjects_Search
*$E12D LD IY,$A80B     ; The map object slots.
 $E131 LD B,$04        ; #REGb=#N$04.
@label=AddMapObjects_Search2
*$E133 LD A,(IY+$00)   ; Read offset #N$00 of #REGiy.
 $E136 INC A           ; Advance #REGa.
 $E137 JR Z,$E146      ; Jump to #R$E146 if the zero flag is set.
 $E139 LD A,(IY+$01)   ; Read offset #N$01 of #REGiy.
 $E13C CP C            ; {Jump to #R$E146 if #REGa is not #REGc.
 $E13D JR NZ,$E146     ; }
 $E13F LD A,(IY+$04)   ; Read offset #N$04 of #REGiy.
 $E142 CP E            ; {Jump to #R$E1F1 if #REGa is #REGe.
 $E143 JP Z,$E1F1      ; }
@label=AddMapObjects_Next
*$E146 LD A,E          ; #REGa=#REGe.
 $E147 LD DE,$001A     ; #REGde=#N$1A.
 $E14A ADD IY,DE       ; #REGiy gains #REGde.
 $E14C LD E,A          ; #REGe=#REGa.
 $E14D DJNZ $E133      ; Decrease #REGb and jump to #R$E133 until none remain.
@label=AddMapObjects_Free
 $E14F LD IY,$A80B     ; The map object slots.
 $E153 LD B,$03        ; #REGb=#N$03.
@label=AddMapObjects_SearchSecond
*$E155 LD A,(IY+$00)   ; Read offset #N$00 of #REGiy.
 $E158 INC A           ; Advance #REGa.
 $E159 JR Z,$E164      ; Jump to #R$E164 if the zero flag is set.
 $E15B LD A,E          ; #REGa=#REGe.
 $E15C LD DE,$001A     ; #REGde=#N$1A.
 $E15F ADD IY,DE       ; #REGiy gains #REGde.
 $E161 LD E,A          ; #REGe=#REGa.
 $E162 DJNZ $E155      ; Decrease #REGb and jump to #R$E155 until none remain.
@label=AddMapObjects_Fill
*$E164 PUSH IX         ; Stash #REGix on the stack.
 $E166 PUSH IY         ; Stash #REGiy on the stack.
 $E168 POP IX          ; Bring #REGix back off the stack.
 $E16A POP IY          ; Bring #REGiy back off the stack.
 $E16C CALL $AC34      ; Call #R$AC34.
 $E16F PUSH IX         ; Stash #REGix on the stack.
 $E171 PUSH IY         ; Stash #REGiy on the stack.
 $E173 POP IX          ; Bring #REGix back off the stack.
 $E175 POP IY          ; Bring #REGiy back off the stack.
 $E177 LD (IY+$04),E   ; Write #REGe to offset #N$04 of #REGiy.
 $E17A LD (IY+$00),$0D ; Store #N$0D at offset #N$00 of #REGiy.
 $E17E LD A,(HL)       ; Read #REGhl.
 $E17F AND %00111111   ; Keep the bits of #REGa that are set in #N$3F.
 $E181 LD (IY+$13),A   ; Write #REGa to offset #N$13 of #REGiy.
 $E184 PUSH HL         ; Stash #REGhl on the stack.
 $E185 LD HL,$E205     ; The object attributes.
 $E188 CALL $9BCF      ; Call #R$9BCF.
 $E18B LD A,(HL)       ; Read #REGhl.
 $E18C LD (IY+$0D),A   ; Write #REGa to offset #N$0D of #REGiy.
 $E18F LD HL,$E0FD     ; The object kinds.
 $E192 LD A,(IY+$13)   ; Read offset #N$13 of #REGiy.
 $E195 CALL $9BCF      ; Call #R$9BCF.
 $E198 LD A,(HL)       ; Read #REGhl.
 $E199 AND %11100000   ; Keep the bits of #REGa that are set in #N$E0.
 $E19B SRL A           ; Shift #REGa right.
 $E19D SRL A           ; Shift #REGa right.
 $E19F SRL A           ; Shift #REGa right.
 $E1A1 SRL A           ; Shift #REGa right.
 $E1A3 LD (IY+$18),A   ; Write #REGa to offset #N$18 of #REGiy.
 $E1A6 BIT 4,(HL)      ; {Jump to #R$E1C4 if bit 4 of the byte at the address in #REGhl is
 $E1A8 JR Z,$E1C4      ; clear.}
 $E1AA LD A,(HL)       ; Read #REGhl.
 $E1AB AND %00001111   ; Keep the bits of #REGa that are set in #N$0F.
 $E1AD LD HL,$E10E     ; The special object states.
 $E1B0 CALL $9BCF      ; Call #R$9BCF.
 $E1B3 LD A,(HL)       ; Read #REGhl.
 $E1B4 LD (IY+$13),A   ; Write #REGa to offset #N$13 of #REGiy.
 $E1B7 INC HL          ; Advance #REGhl.
 $E1B8 LD A,(HL)       ; Read #REGhl.
 $E1B9 LD (IY+$14),A   ; Write #REGa to offset #N$14 of #REGiy.
 $E1BC LD (IY+$15),$80 ; Store #N$80 at offset #N$15 of #REGiy.
 $E1C0 LD (IY+$00),$1B ; Store #N$1B at offset #N$00 of #REGiy.
@label=AddMapObjects_Position
*$E1C4 POP HL          ; Bring #REGhl back off the stack.
 $E1C5 LD DE,($CE3A)   ; Fetch the word at #R$CE3A into #REGde.
 $E1C9 LD A,D          ; #REGa=#REGd.
 $E1CA OR (IY+$18)     ; Set the bits of #REGa that are set in the byte at offset #N$18 of
                       ; #REGiy.
 $E1CD LD (IY+$18),A   ; Write #REGa to offset #N$18 of #REGiy.
 $E1D0 LD (IY+$19),E   ; Write #REGe to offset #N$19 of #REGiy.
 $E1D3 LD (IY+$01),C   ; Write #REGc to offset #N$01 of #REGiy.
 $E1D6 LD A,(IX+$00)   ; Read offset #N$00 of #REGix.
 $E1D9 AND %11111100   ; Keep the bits of #REGa that are set in #N$FC.
 $E1DB DEC A           ; Step #REGa back.
 $E1DC LD (IY+$05),A   ; Write #REGa to offset #N$05 of #REGiy.
 $E1DF LD A,(IX+$00)   ; Read offset #N$00 of #REGix.
 $E1E2 AND %00000011   ; Keep the bits of #REGa that are set in #N$03.
 $E1E4 ADD A,A         ; Double #REGa.
 $E1E5 ADD A,A         ; Double #REGa.
 $E1E6 ADD A,A         ; Double #REGa.
 $E1E7 LD E,A          ; #REGe=#REGa.
 $E1E8 LD A,(IX+$01)   ; Read offset #N$01 of #REGix.
 $E1EB AND %11100000   ; Keep the bits of #REGa that are set in #N$E0.
 $E1ED OR E            ; Set the bits of #REGa that are set in #REGe.
 $E1EE LD (IY+$02),A   ; Write #REGa to offset #N$02 of #REGiy.
@label=AddMapObjects_Skip
*$E1F1 INC IX          ; Advance #REGix.
 $E1F3 INC IX          ; Advance #REGix.
 $E1F5 INC HL          ; Advance #REGhl.
 $E1F6 LD DE,($CE3A)   ; Fetch the word at #R$CE3A into #REGde.
 $E1FA INC DE          ; Advance #REGde.
 $E1FB LD ($CE3A),DE   ; The next object in the column.
 $E1FF POP BC          ; Bring #REGbc back off the stack.
 $E200 DEC B           ; Step #REGb back.
 $E201 JP NZ,$E116     ; Jump to #R$E116 if the zero flag is clear.
 $E204 RET             ; Return.

; Object Attributes
;
; The attribute of each kind of object on the map, which is put in offset
; #N($0D) of the slot.
@label=ObjectAttributes
b$E205 DEFB $EE      ; #COLOUR(#PEEK(#PC)).
 $E206 DEFB $DD      ; #COLOUR(#PEEK(#PC)).
 $E207 DEFB $FF      ; #COLOUR(#PEEK(#PC)).
 $E208 DEFB $BB      ; #COLOUR(#PEEK(#PC)).
 $E209 DEFB $CD      ; #COLOUR(#PEEK(#PC)).
 $E20A DEFB $DF      ; #COLOUR(#PEEK(#PC)).
 $E20B DEFB $DD      ; #COLOUR(#PEEK(#PC)).
 $E20C DEFB $DD      ; #COLOUR(#PEEK(#PC)).
 $E20D DEFB $DD      ; #COLOUR(#PEEK(#PC)).
 $E20E DEFB $DD      ; #COLOUR(#PEEK(#PC)).
 $E20F DEFB $DD      ; #COLOUR(#PEEK(#PC)).
 $E210 DEFB $FF      ; #COLOUR(#PEEK(#PC)).
 $E211 DEFB $AA      ; #COLOUR(#PEEK(#PC)).
 $E212 DEFB $CC      ; #COLOUR(#PEEK(#PC)).
 $E213 DEFB $EE      ; #COLOUR(#PEEK(#PC)).
 $E214 DEFB $FF      ; #COLOUR(#PEEK(#PC)).
 $E215 DEFB $DD      ; #COLOUR(#PEEK(#PC)).

; Find Map Address
;
; Used by the routine at #R$E235.
; .
; Finds the address in the map at #R$61BC of the tile at a column and a
; row. Each row of the map is #N($60) bytes, and rows zero and one both give
; the address of the first row, because the row that is given is that of the
; tile at the bottom of the two on the screen. The column wraps round from
; #N($FF) to #N($5F) and from #N($60) to #N($00).
;
;   DE #N($0060)
;   H Row
;   L Column
; O:C Column, wrapped
; O:HL Address in the map
@label=FindMapAddress
c$E216 LD C,L        ; #REGc=#REGl.
 $E217 LD A,H        ; #REGa=#REGh.
 $E218 AND A         ; Is #REGa zero?
 $E219 LD B,H        ; #REGb=#REGh.
 $E21A LD HL,$61BC   ; The tile map.
 $E21D JR Z,$E225    ; Jump to #R$E225 if the zero flag is set.
 $E21F DEC B         ; Step #REGb back.
 $E220 JR Z,$E225    ; Jump to #R$E225 if the zero flag is set.
@label=FindMapAddress_Loop
*$E222 ADD HL,DE     ; #REGhl gains #REGde.
 $E223 DJNZ $E222    ; Decrease #REGb and jump to #R$E222 until none remain.
@label=FindMapAddress_Wrap
*$E225 LD A,C        ; #REGa=#REGc.
 $E226 CP $FF        ; {Jump to #R$E22C if #REGa is not #N$FF.
 $E228 JR NZ,$E22C   ; }
 $E22A LD C,$5F      ; #REGc=#N$5F.
@label=FindMapAddress_Wrapped
*$E22C LD A,C        ; #REGa=#REGc.
 $E22D CP $60        ; {Jump to #R$E233 if #REGa is not #N$60.
 $E22F JR NZ,$E233   ; }
 $E231 LD C,$00      ; Clear #REGc.
@label=FindMapAddress_Return
*$E233 ADD HL,BC     ; #REGhl gains #REGbc.
 $E234 RET           ; Return.

; Get Tile
;
; Used by the routine at #R$DF08.
; .
; Gets the number of the tile at a column and a row of the map. It also
; stores the column, after it has wrapped, at #R$DDF7. If the row is zero there
; is no tile above the first row of the map, so the tile is blank and the
; address is moved up a row, ready for the next tile.
;
;   DE #N($0060)
;   H Row
;   L Column
; O:A Tile number
; O:HL Address in the map
@label=GetTile
c$E235 CALL $E216    ; Call #R$E216.
 $E238 LD A,C        ; #REGa=#REGc.
 $E239 LD ($DDF7),A  ; Update the next column.
 $E23C LD A,($CE58)  ; The map row.
 $E23F AND A         ; {Jump to #R$E244 if #REGa is zero.
 $E240 JR Z,$E244    ; }
 $E242 LD A,(HL)     ; Read #REGhl.
 $E243 RET           ; Return.

; Get Blank Tile
;
; Used by the routine at #R$E235.
; .
; Used by #R$E235 when the row is zero. Moves the address back up a row
; and returns a blank tile.
;
;   DE #N($0060)
;   HL Address in the map
; O:A Tile number (zero)
; O:HL Address in the map, one row up
@label=GetBlankTile
c$E244 AND A         ; Is #REGa zero?
 $E245 SBC HL,DE     ; Subtract #REGde and the carry from #REGhl.
 $E247 XOR A         ; Clear #REGa.
 $E248 RET           ; Return.

; Draw Flat Rows
;
; Draws a flat piece of terrain, three bytes wide, going up the screen
; two pixel rows at a time. The words of the picture are popped from the stack
; (which #R$D0BD has pointed at the picture) and stored in a zigzag, so that a
; word is two screen bytes next to each other. The entry point at #R$E249 moves
; one column to the right and carries on at #R$E29E. The three JR instructions
; at #R$E259, #R$E25D and #R$E261 have their displacements set by #R$D0BD to
; choose how much of the three bytes is drawn. When one is changed to #N($33)
; or to #N($EE) the row is drawn from #R$E28E or #R$E249, and when #R$E25D or
; #R$E261 is changed to #N($24) or #N($26) the word is skipped (#R$E283 and
; #R$E289).
;
; A Number of pairs of pixel rows to draw
; HL Screen address of the bottom left of the piece
; SP Address of the picture
@label=DrawFlatRows
c$E249 INC L         ; Advance #REGl.
 $E24A JP $E29E      ; Jump to #R$E29E.
@label=DrawFlatRows_Normal
 $E24D LD B,A        ; #REGb=#REGa.
 $E24E LD A,($CE49)  ; The segment screen address.
 $E251 ADD A,$03     ; Add #N$03 to #REGa.
 $E253 LD ($CE49),A  ; Update the segment screen address.
 $E256 INC L         ; Advance #REGl.
 $E257 INC L         ; Advance #REGl.
 $E258 INC L         ; Advance #REGl.
@label=DrawFlatRows_Next
*$E259 JR $E259      ; Skip ahead by the displacement that #R$D0BD sets.
@label=DrawFlatRows_Word1
 $E25B POP DE        ; Bring #REGde back off the stack.
 $E25C LD (HL),E     ; Write #REGe where #REGhl points.
@label=DrawFlatRows_PatchSecond
*$E25D JR $E25D      ; Skip ahead by the displacement that #R$D0BD sets.
@label=DrawFlatRows_Word2
 $E25F INC L         ; Advance #REGl.
 $E260 LD (HL),D     ; Write #REGd where #REGhl points.
@label=DrawFlatRows_PatchThird
*$E261 JR $E261      ; Skip ahead by the displacement that #R$D0BD sets.
@label=DrawFlatRows_Word3
 $E263 INC L         ; Advance #REGl.
 $E264 POP DE        ; Bring #REGde back off the stack.
 $E265 LD (HL),E     ; Write #REGe where #REGhl points.
 $E266 DEC H         ; Step #REGh back.
 $E267 LD (HL),D     ; Write #REGd where #REGhl points.
 $E268 DEC L         ; Step #REGl back.
@label=DrawFlatRows_Word4
*$E269 POP DE        ; Bring #REGde back off the stack.
 $E26A LD (HL),E     ; Write #REGe where #REGhl points.
 $E26B DEC L         ; Step #REGl back.
@label=DrawFlatRows_Store
*$E26C LD (HL),D     ; Write #REGd where #REGhl points.
@label=DrawFlatRows_Up
*$E26D DEC H         ; Step #REGh back.
 $E26E LD A,H        ; #REGa=#REGh.
 $E26F INC A         ; Advance #REGa.
 $E270 AND %00000111 ; Keep the bits of #REGa that are set in #N$07.
 $E272 JR NZ,$E27E   ; Jump to #R$E27E if the zero flag is clear.
 $E274 LD A,L        ; #REGa=#REGl.
 $E275 SUB $20       ; Subtract #N$20 from #REGa.
 $E277 LD L,A        ; #REGl=#REGa.
 $E278 JR C,$E27E    ; Jump to #R$E27E if the carry flag is set.
 $E27A LD A,H        ; #REGa=#REGh.
 $E27B ADD A,$08     ; Add #N$08 to #REGa.
 $E27D LD H,A        ; #REGh=#REGa.
@label=DrawFlatRows_Loop
*$E27E DJNZ $E259    ; Decrease #REGb and jump to #R$E259 until none remain.
 $E280 JP $D714      ; Jump to #R$D714.
@label=DrawFlatRows_SkipWord
 $E283 DEC H         ; Step #REGh back.
 $E284 POP DE        ; Bring #REGde back off the stack.
 $E285 POP DE        ; Bring #REGde back off the stack.
 $E286 JP $E26C      ; Jump to #R$E26C.
@label=DrawFlatRows_SkipOne
 $E289 DEC H         ; Step #REGh back.
 $E28A POP DE        ; Bring #REGde back off the stack.
 $E28B JP $E269      ; Jump to #R$E269.
@label=DrawFlatRows_NextColumn
 $E28E INC A         ; Advance #REGa.
 $E28F AND %00011111 ; Keep the bits of #REGa that are set in #N$1F.
 $E291 JR NZ,$E299   ; Jump to #R$E299 if the zero flag is clear.
 $E293 LD A,L        ; #REGa=#REGl.
 $E294 SUB $20       ; Subtract #N$20 from #REGa.
 $E296 LD ($CE49),A  ; Update the segment screen address.
@label=DrawFlatRows_Column
*$E299 LD A,L        ; #REGa=#REGl.
 $E29A AND %11100000 ; Keep the bits of #REGa that are set in #N$E0.
 $E29C INC A         ; Advance #REGa.
 $E29D LD L,A        ; #REGl=#REGa.
@label=DrawFlatRows_Start
*$E29E LD A,$4C      ; #REGa=#N$4C.
 $E2A0 LD ($E25A),A  ; Skip the rest of the flat row.
 $E2A3 INC SP        ; Advance #REGsp.
@label=DrawFlatRows_PatchFourth
*$E2A4 JR $E2A4      ; Skip ahead by the displacement that #R$D0BD sets.
@label=DrawFlatRows_Pop
 $E2A6 INC SP        ; Advance #REGsp.
 $E2A7 POP DE        ; Bring #REGde back off the stack.
 $E2A8 LD (HL),E     ; Write #REGe where #REGhl points.
@label=DrawFlatRows_PatchFifth
*$E2A9 JR $E2A9      ; Skip ahead by the displacement that #R$D0BD sets.
@label=DrawFlatRows_Right
 $E2AB INC L         ; Advance #REGl.
 $E2AC LD (HL),D     ; Write #REGd where #REGhl points.
 $E2AD POP DE        ; Bring #REGde back off the stack.
 $E2AE DEC H         ; Step #REGh back.
 $E2AF LD (HL),E     ; Write #REGe where #REGhl points.
 $E2B0 DEC L         ; Step #REGl back.
 $E2B1 LD (HL),D     ; Write #REGd where #REGhl points.
 $E2B2 POP DE        ; Bring #REGde back off the stack.
 $E2B3 JP $E26D      ; Jump to #R$E26D.
@label=DrawFlatRows_Left
 $E2B6 DEC H         ; Step #REGh back.
 $E2B7 LD (HL),D     ; Write #REGd where #REGhl points.
 $E2B8 POP DE        ; Bring #REGde back off the stack.
 $E2B9 POP DE        ; Bring #REGde back off the stack.
 $E2BA JP $E26D      ; Jump to #R$E26D.

; Shape Table Shift Two
;
; The sixteen entries, one for each type of segment, that #R$D0BD uses
; when the terrain is scrolled two pixels to the right. Each entry is two
; words: the routine that draws the type of segment, and the address of the
; shifted picture of the type.
@label=ShapeTableShiftTwo
b$E2BD DEFW $E24D,$EA68
 $E2C1 DEFW $E4A8,$E804
 $E2C5 DEFW $E4D0,$E74A
 $E2C9 DEFW $E4D0,$E91E
 $E2CD DEFW $E4F2,$E8C1
 $E2D1 DEFW $E52C,$E7C8
 $E2D5 DEFW $E52C,$E9FC
 $E2D9 DEFW $E24D,$EB64
 $E2DD DEFW $E4A8,$EE9A
 $E2E1 DEFW $E4D0,$EDE0
 $E2E5 DEFW $E4D0,$EFB1
 $E2E9 DEFW $E4F2,$EF57
 $E2ED DEFW $E52C,$EE5E
 $E2F1 DEFW $E52C,$F08F
 $E2F5 DEFW $E4D1,$EC96
 $E2F9 DEFW $E52D,$ED74

; Shape Table Shift Four
;
; The entries that are used when the terrain is scrolled four pixels to
; the right.
@label=ShapeTableShiftFour
b$E2FD DEFW $E24D,$EABC
 $E301 DEFW $E4A8,$E861
 $E305 DEFW $E4D0,$E788
 $E309 DEFW $E4D0,$E98C
 $E30D DEFW $E4F2,$E864
 $E311 DEFW $E52C,$E78A
 $E315 DEFW $E52C,$E98E
 $E319 DEFW $E24D,$EBB8
 $E31D DEFW $E4A8,$EEF7
 $E321 DEFW $E4D0,$EE1E
 $E325 DEFW $E4D0,$F01F
 $E329 DEFW $E4F2,$EEFA
 $E32D DEFW $E52C,$EE20
 $E331 DEFW $E52C,$F021
 $E335 DEFW $E4D1,$ED04
 $E339 DEFW $E52D,$ED06

; Shape Table Shift Six
;
; The entries that are used when the terrain is scrolled six pixels to
; the right (or by any other amount that is not a multiple of two).
@label=ShapeTableShiftSix
b$E33D DEFW $E24D,$EB10
 $E341 DEFW $E4A8,$E8BE
 $E345 DEFW $E4D0,$E7C6
 $E349 DEFW $E4D0,$E9FA
 $E34D DEFW $E4F2,$E807
 $E351 DEFW $E52C,$E74C
 $E355 DEFW $E52C,$E920
 $E359 DEFW $E24D,$EC0C
 $E35D DEFW $E4A8,$EF54
 $E361 DEFW $E4D0,$EE5C
 $E365 DEFW $E4D0,$F08D
 $E369 DEFW $E4F2,$EE9D
 $E36D DEFW $E52C,$EDE2
 $E371 DEFW $E52C,$EFB3
 $E375 DEFW $E4D1,$ED72
 $E379 DEFW $E52D,$EC98

; Shape Table Shift Zero
;
; The entries that are used when the terrain is not scrolled. The
; pictures are the descriptions of the shapes at #R$E581.
@label=ShapeTableShiftZero
b$E37D DEFW $E24D,$E583
 $E381 DEFW $E4CF,$E6A5
 $E385 DEFW $E48B,$E64E
 $E389 DEFW $E48B,$E716
 $E38D DEFW $E52B,$E6A7
 $E391 DEFW $E55B,$E64F
 $E395 DEFW $E55B,$E717
 $E399 DEFW $E24D,$E5D9
 $E39D DEFW $E4CF,$E66C
 $E3A1 DEFW $E48B,$E630
 $E3A5 DEFW $E48B,$E6E0
 $E3A9 DEFW $E52B,$E66E
 $E3AD DEFW $E55B,$E631
 $E3B1 DEFW $E55B,$E6E1
 $E3B5 DEFW $E48C,$EC63
 $E3B9 DEFW $E55C,$EC64

; Slope Parameters
;
; Three bytes for each of the types of slope #N$00 to #N$08. The routine
; at #R$E3D8 copies to the variables at #R$CE35. The second is added to the
; screen address for each step of a segment, so it is negative for a slope that
; goes to the left.
@label=SlopeParameters
b$E3BD DEFB $18,$03,$00
 $E3C0 DEFB $10,$02,$08
 $E3C3 DEFB $08,$01,$08
 $E3C6 DEFB $08,$01,$10
 $E3C9 DEFB $F0,$FE,$08
 $E3CC DEFB $F8,$FF,$08
 $E3CF DEFB $F8,$FF,$10
 $E3D2 DEFB $00,$01,$10
 $E3D5 DEFB $00,$FF,$10

; Set Slope Parameters
;
; Used by the routines at #R$CD08 and #R$CD6B.
; .
; Looks up the three parameters of the type of the current segment in the
; table at #R$E3BD and stores them in the variables at #R$CE35. A type of #N$07
; or more is for a segment that is upside down: it sets #R$5C35 to #N($80) and
; uses the parameters of the type less seven. It then sets #R$E41B to #N$01
; when the second parameter is negative and to #N($FF) when it is not, and in
; the second case changes the JR instruction at #R$D462 to skip two bytes.
;
; IX Address of the record of the segment (#N$03 is the type)
@label=SetSlopeParameters
c$E3D8 LD HL,$E3BD   ; The slope parameters.
 $E3DB LD A,(IX+$03) ; Read offset #N$03 of #REGix.
 $E3DE CP $07        ; {Jump to #R$E3EC if #REGa is less than #N$07.
 $E3E0 JR C,$E3EC    ; }
 $E3E2 LD A,$80      ; #REGa=#N$80.
 $E3E4 LD ($5C35),A  ; Update the upside-down segment flag.
 $E3E7 LD A,(IX+$03) ; Read offset #N$03 of #REGix.
 $E3EA SUB $07       ; Subtract #N$07 from #REGa.
@label=SetSlopeParameters_Fetch
*$E3EC LD E,A        ; #REGe=#REGa.
 $E3ED ADD A,A       ; Double #REGa.
 $E3EE ADD A,E       ; #REGa gains #REGe.
 $E3EF LD E,A        ; #REGe=#REGa.
 $E3F0 LD D,$00      ; Clear #REGd.
 $E3F2 ADD HL,DE     ; #REGhl gains #REGde.
 $E3F3 LD A,(HL)     ; Read #REGhl.
 $E3F4 LD ($CE35),A  ; Update the horizontal step.
 $E3F7 INC HL        ; Advance #REGhl.
 $E3F8 LD A,(HL)     ; Read #REGhl.
 $E3F9 LD ($CE36),A  ; Update the column step.
 $E3FC INC HL        ; Advance #REGhl.
 $E3FD LD A,(HL)     ; Read #REGhl.
 $E3FE LD ($CE37),A  ; Update the vertical step.
 $E401 LD A,$01      ; #REGa=#N$01.
 $E403 LD ($E41B),A  ; Update the slope direction.
 $E406 XOR A         ; Clear #REGa.
 $E407 LD ($D463),A  ; Negate the slope step.
 $E40A LD A,($CE36)  ; The column step.
 $E40D BIT 7,A       ; {Return if bit 7 of #REGa is set.
 $E40F RET NZ        ; }
 $E410 LD A,$FF      ; #REGa=#N$FF.
 $E412 LD ($E41B),A  ; Update the slope direction.
 $E415 LD A,$02      ; #REGa=#N$02.
 $E417 LD ($D463),A  ; Leave the slope step as it is.
 $E41A RET           ; Return.

; Slope Direction
;
; The direction of the current segment, which is #N$01 when the second
; parameter of its slope is negative (the segment goes to the left) and #N($FF)
; when it is not. It is set by #R$E3D8.
@label=SlopeDirection
g$E41B DEFB $00

; Fill Strip With Pattern
;
; Used by the routines at #R$D729 and #R$D8DA.
; .
; Fills a strip of screen bytes with a pattern of two bytes, going up two
; pixel rows at a time, and then moves along to the next column of the strip by
; the amount in #R$CE36. The strip is not drawn where the column is within one
; character of the edge of the screen, and its height is reduced where it would
; go past the bottom of the screen or above the top of the terrain.
;
; B' Number of columns
; C' Number of pairs of pixel rows
; DE Pattern: the first byte in #REGd and the second in #REGe
; HL' Screen address of the bottom of the first column
@label=FillStripWithPattern
c$E41C EXX           ; Switch to the alternate registers.
 $E41D LD B,C        ; #REGb=#REGc.
 $E41E LD A,L        ; #REGa=#REGl.
 $E41F AND %00011111 ; Keep the bits of #REGa that are set in #N$1F.
 $E421 DEC A         ; Step #REGa back.
 $E422 CP $1C        ; {Jump to #R$E471 if #REGa is #N$1C or more.
 $E424 JR NC,$E471   ; }
 $E426 LD A,($CE44)  ; The segment row.
 $E429 CP $B8        ; {Jump to #R$E442 if #REGa is less than #N$B8.
 $E42B JR C,$E442    ; }
 $E42D JR Z,$E442    ; Jump to #R$E442 if the zero flag is set.
 $E42F SUB $B7       ; Subtract #N$B7 from #REGa.
 $E431 SRL A         ; Shift #REGa right.
 $E433 NEG           ; Negate #REGa.
 $E435 ADD A,B       ; #REGa gains #REGb.
 $E436 LD B,A        ; #REGb=#REGa.
 $E437 LD H,$57      ; #REGh=#N$57.
 $E439 LD A,L        ; #REGa=#REGl.
 $E43A AND %00011111 ; Keep the bits of #REGa that are set in #N$1F.
 $E43C OR %11000000  ; Set the bits of #REGa that are set in #N$C0.
 $E43E LD L,A        ; #REGl=#REGa.
 $E43F JP $E455      ; Jump to #R$E455.
@label=FillStripWithPattern_Height
*$E442 LD B,A        ; #REGb=#REGa.
 $E443 LD A,($CE5A)  ; The vertical step copy.
 $E446 NEG           ; Negate #REGa.
 $E448 ADD A,B       ; #REGa gains #REGb.
 $E449 SUB $18       ; Subtract #N$18 from #REGa.
 $E44B LD B,C        ; #REGb=#REGc.
 $E44C JR NC,$E455   ; Jump to #R$E455 if the carry flag is clear.
 $E44E CPL           ; Invert #REGa.
 $E44F SRL A         ; Shift #REGa right.
 $E451 NEG           ; Negate #REGa.
 $E453 ADD A,B       ; #REGa gains #REGb.
 $E454 LD B,A        ; #REGb=#REGa.
@label=FillStripWithPattern_Draw
*$E455 LD A,($CE44)  ; The segment row.
 $E458 SLA C         ; Shift #REGc left.
 $E45A SUB C         ; Subtract #REGc from #REGa.
 $E45B SRL C         ; Shift #REGc right.
 $E45D LD ($CE44),A  ; Update the segment row.
@label=FillStripWithPattern_Rows
*$E460 LD (HL),D     ; Write #REGd where #REGhl points.
 $E461 DEC H         ; Step #REGh back.
 $E462 LD (HL),E     ; Write #REGe where #REGhl points.
 $E463 CALL $A1C3    ; Call #R$A1C3.
 $E466 DJNZ $E460    ; Decrease #REGb and jump to #R$E460 until none remain.
 $E468 LD A,($CE36)  ; The column step.
 $E46B ADD A,L       ; #REGa gains #REGl.
 $E46C LD L,A        ; #REGl=#REGa.
 $E46D EXX           ; Switch to the alternate registers.
 $E46E DJNZ $E41C    ; Decrease #REGb and jump to #R$E41C until none remain.
 $E470 RET           ; Return.
@label=FillStripWithPattern_Skip
*$E471 LD A,($CE44)  ; The segment row.
 $E474 SLA B         ; Shift #REGb left.
 $E476 SUB B         ; Subtract #REGb from #REGa.
 $E477 SRL B         ; Shift #REGb right.
 $E479 LD ($CE44),A  ; Update the segment row.
 $E47C LD A,($CE36)  ; The column step.
 $E47F ADD A,L       ; #REGa gains #REGl.
 $E480 LD L,A        ; #REGl=#REGa.
@label=FillStripWithPattern_SkipRows
*$E481 DEC H         ; Step #REGh back.
 $E482 CALL $A1C3    ; Call #R$A1C3.
 $E485 DJNZ $E481    ; Decrease #REGb and jump to #R$E481 until none remain.
 $E487 EXX           ; Switch to the alternate registers.
 $E488 DJNZ $E41C    ; Decrease #REGb and jump to #R$E41C until none remain.
 $E48A RET           ; Return.

; Draw One Byte Rows
;
; Draws a piece of terrain that is one byte wide, going up the screen two
; pixel rows at a time, using a word of the picture for each pair of rows. The
; entry point at #R$E48B moves one column to the right first.
;
; A Number of pairs of pixel rows to draw
; HL Screen address of the bottom of the piece
; SP Address of the picture
@label=DrawOneByteRows
c$E48B INC L         ; Advance #REGl.
@label=DrawOneByteRows_Start
 $E48C LD B,A        ; #REGb=#REGa.
@label=DrawOneByteRows_Loop
*$E48D POP DE        ; Bring #REGde back off the stack.
 $E48E LD (HL),E     ; Write #REGe where #REGhl points.
 $E48F DEC H         ; Step #REGh back.
 $E490 LD (HL),D     ; Write #REGd where #REGhl points.
 $E491 DEC H         ; Step #REGh back.
 $E492 LD A,H        ; #REGa=#REGh.
 $E493 INC A         ; Advance #REGa.
 $E494 AND %00000111 ; Keep the bits of #REGa that are set in #N$07.
 $E496 JR NZ,$E4A2   ; Jump to #R$E4A2 if the zero flag is clear.
 $E498 LD A,L        ; #REGa=#REGl.
 $E499 SUB $20       ; Subtract #N$20 from #REGa.
 $E49B LD L,A        ; #REGl=#REGa.
 $E49C JR C,$E4A2    ; Jump to #R$E4A2 if the carry flag is set.
 $E49E LD A,H        ; #REGa=#REGh.
 $E49F ADD A,$08     ; Add #N$08 to #REGa.
 $E4A1 LD H,A        ; #REGh=#REGa.
@label=DrawOneByteRows_Next
*$E4A2 DJNZ $E48D    ; Decrease #REGb and jump to #R$E48D until none remain.
 $E4A4 JP $D711      ; Jump to #R$D711.

; Draw Three Byte Rows
;
; Draws a piece of terrain that is three bytes wide, going up the screen
; two pixel rows at a time, using three words of the picture for each pair of
; rows. The entry points at #R$E4A7 and #R$E4A8 first move to the right by
; three columns and two columns.
;
; A Number of pairs of pixel rows to draw
; HL Screen address of the bottom left of the piece
; SP Address of the picture
@label=DrawThreeByteRows
c$E4A7 INC L         ; Advance #REGl.
@label=DrawThreeByteRows_Two
 $E4A8 INC L         ; Advance #REGl.
 $E4A9 INC L         ; Advance #REGl.
 $E4AA LD B,A        ; #REGb=#REGa.
@label=DrawThreeByteRows_Loop
*$E4AB POP DE        ; Bring #REGde back off the stack.
 $E4AC LD (HL),E     ; Write #REGe where #REGhl points.
 $E4AD INC L         ; Advance #REGl.
 $E4AE LD (HL),D     ; Write #REGd where #REGhl points.
 $E4AF INC L         ; Advance #REGl.
 $E4B0 POP DE        ; Bring #REGde back off the stack.
 $E4B1 LD (HL),E     ; Write #REGe where #REGhl points.
 $E4B2 DEC H         ; Step #REGh back.
 $E4B3 LD (HL),D     ; Write #REGd where #REGhl points.
 $E4B4 DEC L         ; Step #REGl back.
 $E4B5 POP DE        ; Bring #REGde back off the stack.
 $E4B6 LD (HL),E     ; Write #REGe where #REGhl points.
 $E4B7 DEC L         ; Step #REGl back.
 $E4B8 LD (HL),D     ; Write #REGd where #REGhl points.
 $E4B9 DEC H         ; Step #REGh back.
 $E4BA LD A,H        ; #REGa=#REGh.
 $E4BB INC A         ; Advance #REGa.
 $E4BC AND %00000111 ; Keep the bits of #REGa that are set in #N$07.
 $E4BE JR NZ,$E4CA   ; Jump to #R$E4CA if the zero flag is clear.
 $E4C0 LD A,L        ; #REGa=#REGl.
 $E4C1 SUB $20       ; Subtract #N$20 from #REGa.
 $E4C3 LD L,A        ; #REGl=#REGa.
 $E4C4 JR C,$E4CA    ; Jump to #R$E4CA if the carry flag is set.
 $E4C6 LD A,H        ; #REGa=#REGh.
 $E4C7 ADD A,$08     ; Add #N$08 to #REGa.
 $E4C9 LD H,A        ; #REGh=#REGa.
@label=DrawThreeByteRows_Next
*$E4CA DJNZ $E4AB    ; Decrease #REGb and jump to #R$E4AB until none remain.
 $E4CC JP $D711      ; Jump to #R$D711.

; Draw Two Byte Rows
;
; Draws a piece of terrain that is two bytes wide, going up the screen
; two pixel rows at a time, using two words of the picture for each pair of
; rows. The entry points at #R$E4CF and #R$E4D0 first move to the right by two
; columns and one column, and the one at #R$E4D1 does not.
;
; A Number of pairs of pixel rows to draw
; HL Screen address of the bottom left of the piece
; SP Address of the picture
@label=DrawTwoByteRows
c$E4CF INC L         ; Advance #REGl.
@label=DrawTwoByteRows_One
 $E4D0 INC L         ; Advance #REGl.
@label=DrawTwoByteRows_Start
 $E4D1 LD B,A        ; #REGb=#REGa.
@label=DrawTwoByteRows_Loop
*$E4D2 POP DE        ; Bring #REGde back off the stack.
 $E4D3 LD (HL),E     ; Write #REGe where #REGhl points.
 $E4D4 INC L         ; Advance #REGl.
 $E4D5 LD (HL),D     ; Write #REGd where #REGhl points.
 $E4D6 DEC H         ; Step #REGh back.
 $E4D7 POP DE        ; Bring #REGde back off the stack.
 $E4D8 LD (HL),E     ; Write #REGe where #REGhl points.
 $E4D9 DEC L         ; Step #REGl back.
 $E4DA LD (HL),D     ; Write #REGd where #REGhl points.
 $E4DB DEC H         ; Step #REGh back.
 $E4DC LD A,H        ; #REGa=#REGh.
 $E4DD INC A         ; Advance #REGa.
 $E4DE AND %00000111 ; Keep the bits of #REGa that are set in #N$07.
 $E4E0 JR NZ,$E4EC   ; Jump to #R$E4EC if the zero flag is clear.
 $E4E2 LD A,L        ; #REGa=#REGl.
 $E4E3 SUB $20       ; Subtract #N$20 from #REGa.
 $E4E5 LD L,A        ; #REGl=#REGa.
 $E4E6 JR C,$E4EC    ; Jump to #R$E4EC if the carry flag is set.
 $E4E8 LD A,H        ; #REGa=#REGh.
 $E4E9 ADD A,$08     ; Add #N$08 to #REGa.
 $E4EB LD H,A        ; #REGh=#REGa.
@label=DrawTwoByteRows_Next
*$E4EC DJNZ $E4D2    ; Decrease #REGb and jump to #R$E4D2 until none remain.
 $E4EE JP $D711      ; Jump to #R$D711.

; Draw Mirrored Three Byte Rows
;
; Draws a piece of terrain that is three bytes wide in the same way as
; #R$E4A7, but passes every byte through the table of reversed bytes at #N$F900
; so that the piece is drawn back to front. The entry points at #R$E4F1 and
; #R$E4F2 first move to the left by three columns and two columns.
;
; A Number of pairs of pixel rows to draw
; HL Screen address of the bottom left of the piece
; SP Address of the picture
@label=DrawMirroredThreeByteRows
c$E4F1 DEC L         ; Step #REGl back.
@label=DrawMirroredThreeByteRows_Two
 $E4F2 DEC L         ; Step #REGl back.
 $E4F3 DEC L         ; Step #REGl back.
@label=DrawMirroredThreeByteRows_Start
 $E4F4 LD B,$F9      ; #REGb=#N$F9.
 $E4F6 EXX           ; Switch to the alternate registers.
 $E4F7 LD B,A        ; #REGb=#REGa.
@label=DrawMirroredThreeByteRows_Loop
*$E4F8 EXX           ; Switch to the alternate registers.
 $E4F9 POP DE        ; Bring #REGde back off the stack.
 $E4FA LD C,E        ; #REGc=#REGe.
 $E4FB LD A,(BC)     ; Read #REGbc.
 $E4FC LD (HL),A     ; Write #REGa where #REGhl points.
 $E4FD INC L         ; Advance #REGl.
 $E4FE LD C,D        ; #REGc=#REGd.
 $E4FF LD A,(BC)     ; Read #REGbc.
 $E500 LD (HL),A     ; Write #REGa where #REGhl points.
 $E501 INC L         ; Advance #REGl.
 $E502 POP DE        ; Bring #REGde back off the stack.
 $E503 LD C,E        ; #REGc=#REGe.
 $E504 LD A,(BC)     ; Read #REGbc.
 $E505 LD (HL),A     ; Write #REGa where #REGhl points.
 $E506 DEC H         ; Step #REGh back.
 $E507 LD C,D        ; #REGc=#REGd.
 $E508 LD A,(BC)     ; Read #REGbc.
 $E509 LD (HL),A     ; Write #REGa where #REGhl points.
 $E50A DEC L         ; Step #REGl back.
 $E50B POP DE        ; Bring #REGde back off the stack.
 $E50C LD C,E        ; #REGc=#REGe.
 $E50D LD A,(BC)     ; Read #REGbc.
 $E50E LD (HL),A     ; Write #REGa where #REGhl points.
 $E50F DEC L         ; Step #REGl back.
 $E510 LD C,D        ; #REGc=#REGd.
 $E511 LD A,(BC)     ; Read #REGbc.
 $E512 LD (HL),A     ; Write #REGa where #REGhl points.
 $E513 DEC H         ; Step #REGh back.
 $E514 LD A,H        ; #REGa=#REGh.
 $E515 INC A         ; Advance #REGa.
 $E516 AND %00000111 ; Keep the bits of #REGa that are set in #N$07.
 $E518 JR NZ,$E524   ; Jump to #R$E524 if the zero flag is clear.
 $E51A LD A,L        ; #REGa=#REGl.
 $E51B SUB $20       ; Subtract #N$20 from #REGa.
 $E51D LD L,A        ; #REGl=#REGa.
 $E51E JR C,$E524    ; Jump to #R$E524 if the carry flag is set.
 $E520 LD A,H        ; #REGa=#REGh.
 $E521 ADD A,$08     ; Add #N$08 to #REGa.
 $E523 LD H,A        ; #REGh=#REGa.
@label=DrawMirroredThreeByteRows_Next
*$E524 EXX           ; Switch to the alternate registers.
 $E525 DJNZ $E4F8    ; Decrease #REGb and jump to #R$E4F8 until none remain.
 $E527 EXX           ; Switch to the alternate registers.
 $E528 JP $D711      ; Jump to #R$D711.

