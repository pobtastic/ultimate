i$5B00

; Decryption Routine
;
; The loader copies this routine here and runs it once the encrypted
; game has been loaded to #N$5E80. The helper at #R$6000@loader copies this
; stub here and the move routine to #N$FC00. It first moves the game down to
; its home at #N$5C80 (see #R$FC00) and then decrypts it, one byte at a time
; and from the top down, by running RRD over #N$9E00 bytes starting at
; #N$FA00. Each RRD passes a nibble along from one byte to the next, so the
; whole game is stored shifted by half a byte. Control then goes to #R$5C80.
; Once the game is running the space up to #N$5BFF is reused, for the records
; of the segments of the four tiles that #R$D0BD makes (starting at #N($5B80),
; #N($5BA5), #N($5BCA) and #N($5BEF)). That routine also sets the stack pointer
; to #N$5B7A.
;
; .
;
; Set up the stack and move the game down into place.
@label=GameEntry
c$5B80 LD SP,$FE00   ; Set the stack pointer to #N$FE00.
 $5B83 DI            ; Disable interrupts.
 $5B84 CALL $FC00    ; Call #R$FC00 to move the game down to #N$5C80.
; Decrypt every byte from #N$FA00 down to #N$5C01.
 $5B87 LD HL,$FA00   ; Set the start address in #REGhl to #N$FA00.
 $5B8A XOR A         ; Clear the nibble carried between bytes in #REGa.
 $5B8B LD BC,$9E00   ; Set the byte count in #REGbc to #N$9E00.
@label=Decryption_Loop
*$5B8E RRD           ; Rotate the nibbles of the current byte through #REGa.
 $5B90 DEC HL        ; Move down to the previous byte.
 $5B91 DEC C         ; {Decrease the low byte of the counter by one and loop back to #R$5B8E
 $5B92 JR NZ,$5B8E   ; until none remain.}
 $5B94 DJNZ $5B8E    ; Decrease the high byte of the counter by one and loop back to
                     ; #R$5B8E until every byte has been decrypted.
 $5B96 JP $5C80      ; Jump to #R$5C80.

i$5B99

; Unused
