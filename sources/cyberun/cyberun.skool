 $A7E7 OR (HL)       ; Set the pixels of the screen.
 $A7E8 LD (HL),A     ; Store the byte.
 $A7E9 DEC L         ; Move on to the next byte of the screen to the left.
 $A7EA INC DE        ; Move on to the next byte of the sprite.
@label=DrawMirroredRowDirectly_Fourth
 $A7EB LD A,(DE)     ; Fetch a byte of the sprite.
 $A7EC LD C,A        ; Use it to look up the byte with the bits reversed.
 $A7ED LD A,(BC)     ; Fetch it.
 $A7EE OR (HL)       ; Set the pixels of the screen.
 $A7EF LD (HL),A     ; Store the byte.
 $A7F0 DEC L         ; Move on to the next byte of the screen to the left.
 $A7F1 INC DE        ; Move on to the next byte of the sprite.
@label=DrawMirroredRowDirectly_Fifth
 $A7F2 LD A,(DE)     ; Fetch a byte of the sprite.
 $A7F3 LD C,A        ; Use it to look up the byte with the bits reversed.
 $A7F4 LD A,(BC)     ; Fetch it.
 $A7F5 OR (HL)       ; Set the pixels of the screen.
 $A7F6 LD (HL),A     ; Store the byte.
 $A7F7 DEC L         ; Move on to the next byte of the screen to the left.
