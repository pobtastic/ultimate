@label=ItemSites
g$F604 DEFB $00,$00,$00,$00
 $F608 DEFB $FF,$FF,$FF,$FF
 $F60C DEFB $FF,$FF,$FF,$FF
 $F610 DEFB $00,$00,$00,$00
 $F614 DEFB $00,$00,$00,$00
 $F618 DEFB $00,$00,$00,$00
 $F61C DEFB $00,$00,$00,$00
 $F620 DEFB $00,$00,$00,$00
 $F624 DEFB $00,$00,$00,$00
@label=ItemSites_Tenth
 $F628 DEFB $00,$00,$00,$00
@label=ItemSites_Eleventh
 $F62C DEFB $00,$00,$00,$00
@label=ItemSites_Twelfth
 $F630 DEFB $00,$00,$00,$00
 $F634 DEFB $00,$00,$00,$00
 $F638 DEFB $00,$00,$00,$00
 $F63C DEFB $00,$00,$00,$00
 $F640 DEFB $00,$00,$00,$00
 $F644 DEFB $00,$00,$00,$00
 $F648 DEFB $00,$00,$00,$00
@label=ItemSites_Nineteenth
 $F64C DEFB $00,$00,$00,$00

; Other Player State
;
; The state of the other player, in the same layout as #R$F5E7.
@label=OtherPlayerState
g$F650 DEFB $00,$00,$00,$00,$00,$00,$03,$00
 $F658 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $F660 DEFB $00,$00,$00,$0D,$07,$90,$B7,$78
 $F668 DEFB $40,$00,$FF,$00,$00
@label=OtherPlayerState_ItemSites
 $F66D DEFB $00,$00,$00,$00
 $F671 DEFB $FF,$FF,$FF,$FF
 $F675 DEFB $FF,$FF,$FF,$FF
 $F679 DEFB $00,$00,$00,$00
 $F67D DEFB $00,$00,$00,$00
 $F681 DEFB $00,$00,$00,$00
 $F685 DEFB $00,$00,$00,$00
 $F689 DEFB $00,$00,$00,$00
 $F68D DEFB $00,$00,$00,$00
 $F691 DEFB $00,$00,$00,$00
 $F695 DEFB $00,$00,$00,$00
 $F699 DEFB $00,$00,$00,$00
 $F69D DEFB $00,$00,$00,$00
 $F6A1 DEFB $00,$00,$00,$00
 $F6A5 DEFB $00,$00,$00,$00
 $F6A9 DEFB $00,$00,$00,$00
 $F6AD DEFB $00,$00,$00,$00
 $F6B1 DEFB $00,$00,$00,$00
 $F6B5 DEFB $00,$00,$00,$00

; Ship Work Area
;
; Cleared by #R$DCA1 at the start of each life. #R$AFE9 builds the
; graphic of the ship from #R$C891 at #R$F755.
@label=ShipWorkArea
g$F6B9 DEFB $00
@label=ShipWorkArea_Carried
 $F6BA DEFB $00
@label=ShipWorkArea_Stack
 $F6BB DEFB $00,$00,$00,$00,$00,$00,$00
 $F6C2 DEFB $00,$00,$00,$00,$00,$00,$00
 $F6C9 DEFB $00,$00,$00,$00,$00,$00,$00
 $F6D0 DEFB $00,$00,$00,$00,$00,$00,$00
@label=ShipWorkArea_Right
 $F6D7 DEFB $00,$00,$00,$00,$00,$00,$00
 $F6DE DEFB $00,$00,$00,$00,$00,$00,$00
 $F6E5 DEFB $00,$00,$00,$00,$00,$00,$00
 $F6EC DEFB $00,$00,$00,$00,$00,$00,$00
 $F6F3 DEFB $00,$00,$00,$00,$00,$00,$00
 $F6FA DEFB $00,$00,$00,$00,$00,$00,$00
 $F701 DEFB $00,$00,$00,$00,$00,$00,$00
 $F708 DEFB $00,$00,$00,$00,$00,$00,$00
 $F70F DEFB $00,$00,$00,$00,$00,$00,$00
 $F716 DEFB $00,$00,$00,$00,$00,$00,$00
 $F71D DEFB $00,$00,$00,$00,$00,$00,$00
 $F724 DEFB $00,$00,$00,$00,$00,$00,$00
 $F72B DEFB $00,$00,$00,$00,$00,$00,$00
 $F732 DEFB $00,$00,$00,$00,$00,$00,$00
 $F739 DEFB $00,$00,$00,$00,$00,$00,$00
 $F740 DEFB $00,$00,$00,$00,$00,$00,$00
 $F747 DEFB $00,$00,$00,$00,$00,$00,$00
 $F74E DEFB $00,$00,$00,$00,$00,$00,$00
@label=ShipWorkArea_ShipGraphic
 $F755 DEFB $00,$00,$00,$00,$00,$00
 $F75B DEFB $00,$00,$00,$00,$00,$00
 $F761 DEFB $00,$00,$00,$00,$00,$00
 $F767 DEFB $00,$00,$00,$00,$00,$00
 $F76D DEFB $00,$00,$00,$00,$00,$00
 $F773 DEFB $00,$00,$00,$00,$00,$00
 $F779 DEFB $00,$00,$00,$00,$00,$00
 $F77F DEFB $00,$00,$00,$00,$00,$00
 $F785 DEFB $00,$00,$00,$00,$00,$00
 $F78B DEFB $00,$00,$00,$00,$00,$00
 $F791 DEFB $00,$00,$00,$00,$00,$00
 $F797 DEFB $00,$00,$00,$00,$00,$00
 $F79D DEFB $00,$00,$00,$00,$00,$00
 $F7A3 DEFB $00,$00,$00,$00,$00,$00
 $F7A9 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $F7B9 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $F7C9 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $F7D9 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $F7E9 DEFB $00,$00

; Build Shape Tables
;
; Used by the routine at #R$F86B.
; .
; Builds the shifted copies of the descriptions of the ground textures
; (see #R$E581). Each description is merged into three buffers, shifted by two,
; four and six pixels to the right, so that the terrain can be drawn at any
; horizontal pixel position. Those buffers are in #R$E74A to #N$F10E. Four of
; the descriptions are read in the format of #R$F939, two in the format that
; #R$F8E2 handles, and the last three in the format of #R$F939 again with
; #R$5C25 set to #N($FF).
@label=BuildShapeTables
c$F7EB LD HL,$5C1C   ; The working variables start here.
 $F7EE LD B,$26      ; #REGb=#N$26.
 $F7F0 CALL $F30B    ; Call #R$F30B.
 $F7F3 XOR A         ; Clear #REGa.
 $F7F4 LD ($5C25),A  ; The shapes are built front to back.
; Make the copies of each description, with the description in #REGhl and
; the buffer for the copies in #REGhl'.
@label=BuildShapeTables_First
 $F7F7 LD HL,$E74A   ; The shifted shapes one.
 $F7FA EXX           ; Switch to the alternate registers.
 $F7FB LD HL,$E64B   ; The fourth shape description.
 $F7FE CALL $F939    ; Call #R$F939.
 $F801 LD HL,$E804   ; The shifted shapes two.
 $F804 EXX           ; Switch to the alternate registers.
 $F805 LD HL,$E6A2   ; The sixth shape description.
 $F808 CALL $F939    ; Call #R$F939.
 $F80B LD HL,$E91E   ; The shifted shapes three.
 $F80E EXX           ; Switch to the alternate registers.
 $F80F LD HL,$E713   ; The eighth shape description.
 $F812 CALL $F939    ; Call #R$F939.
 $F815 LD HL,$EC96   ; The shifted shapes six.
 $F818 EXX           ; Switch to the alternate registers.
 $F819 LD HL,$EC60   ; The shape description.
 $F81C CALL $F939    ; Call #R$F939.
 $F81F LD HL,$EA68   ; The shifted shapes four.
 $F822 EXX           ; Switch to the alternate registers.
; The next two descriptions use the other format.
 $F823 LD HL,$E581   ; The shape descriptions.
 $F826 CALL $F8E2    ; Call #R$F8E2.
 $F829 LD HL,$EB64   ; The shifted shapes five.
 $F82C EXX           ; Switch to the alternate registers.
 $F82D LD HL,$E5D7   ; The second shape description.
 $F830 CALL $F8E2    ; Call #R$F8E2.
; The last three descriptions are built with the flag at #R$5C25 set.
 $F833 OR %11111111  ; Set the bits of #REGa that are set in #N$FF.
 $F835 LD ($5C25),A  ; The last shapes are built back to front.
 $F838 LD HL,$EDE0   ; The shifted shapes seven.
 $F83B EXX           ; Switch to the alternate registers.
 $F83C LD HL,$E62D   ; The third shape description.
 $F83F CALL $F939    ; Call #R$F939.
 $F842 LD HL,$EE9A   ; The shifted shapes eight.
 $F845 EXX           ; Switch to the alternate registers.
 $F846 LD HL,$E669   ; The fifth shape description.
 $F849 CALL $F939    ; Call #R$F939.
 $F84C LD HL,$EFB1   ; The shifted shapes nine.
 $F84F EXX           ; Switch to the alternate registers.
 $F850 LD HL,$E6DD   ; The seventh shape description.
 $F853 JP $F939      ; Jump to #R$F939.

; Build Reverse Table
;
; Used by the routine at #R$F86B.
; .
; Builds the table at #N$F900 of every byte with its bits in reverse
; order, indexed by the byte. The drawing routines use it to draw tiles back to
; front. The table overwrites the routine at #R$F8FD onwards, which is no
; longer needed once the shape tables have been built.
@label=BuildReverseTable
c$F856 LD C,$00      ; Clear #REGc.
 $F858 LD HL,$F900   ; The next shifted shape.
@label=BuildReverseTable_Loop
*$F85B LD B,$08      ; #REGb=#N$08.
 $F85D LD D,C        ; #REGd=#REGc.
 $F85E XOR A         ; Clear #REGa.
@label=BuildReverseTable_Bits
*$F85F SLA D         ; Shift #REGd left.
 $F861 RR A          ; Rotate #REGa right through the carry.
 $F863 DJNZ $F85F    ; Decrease #REGb and jump to #R$F85F until none remain.
 $F865 LD (HL),A     ; Write #REGa where #REGhl points.
 $F866 INC HL        ; Advance #REGhl.
 $F867 INC C         ; Advance #REGc.
 $F868 JR NZ,$F85B   ; Jump to #R$F85B if the zero flag is clear.
 $F86A RET           ; Return.

; Build Tables
;
; Used by the routine at #R$9A66.
; .
; Builds the tables that the game needs before it can start. First it
; makes the tables at #R$FA00 of every byte shifted two, four and six bits to
; the right, as a pair of bytes. A page holds the first byte of every shifted
; value and the page after holds the second byte. Then it builds the shape
; tables with #R$F7EB and the table of reversed bytes with #R$F856.
@label=BuildTables
c$F86B LD HL,$FA00   ; The shift tables.
 $F86E LD B,$02      ; #REGb=#N$02.
@label=BuildTables_Shift
*$F870 LD C,$00      ; Clear #REGc.
@label=BuildTables_Byte
*$F872 LD D,C        ; #REGd=#REGc.
 $F873 LD E,$00      ; Clear #REGe.
 $F875 LD A,B        ; #REGa=#REGb.
@label=BuildTables_Bits
*$F876 SRL D         ; Shift #REGd right.
 $F878 RR E          ; Rotate #REGe right through the carry.
 $F87A DEC A         ; Step #REGa back.
 $F87B JR NZ,$F876   ; Jump to #R$F876 if the zero flag is clear.
 $F87D LD (HL),D     ; Write #REGd where #REGhl points.
 $F87E INC H         ; Advance #REGh.
 $F87F LD (HL),E     ; Write #REGe where #REGhl points.
@label=BuildTables_Buffer
 $F880 DEC H         ; Step #REGh back.
 $F881 INC HL        ; Advance #REGhl.
 $F882 INC C         ; Advance #REGc.
 $F883 LD A,C        ; #REGa=#REGc.
 $F884 AND A         ; {Jump to #R$F872 if #REGa is not zero.
 $F885 JR NZ,$F872   ; }
 $F887 INC H         ; Advance #REGh.
 $F888 INC B         ; Advance #REGb.
 $F889 INC B         ; Advance #REGb.
 $F88A LD A,B        ; #REGa=#REGb.
 $F88B CP $08        ; {Jump to #R$F870 if #REGa is not #N$08.
 $F88D JR NZ,$F870   ; }
 $F88F CALL $F7EB    ; Call #R$F7EB.
 $F892 JP $F856      ; Jump to #R$F856.

; Read Shape Header
;
; Used by the routine at #R$F939.
; .
; Reads the header of a description of a shape and sets up the counters
; that the routines at #R$F8E2 and #R$F939 use. The first byte is the number of
; strips, which is stored in #R$5C1E and #R$5C1F. The second byte is the number
; of rows, which is stored in #R$5C1C and #R$5C1D. The third byte is the number
; of bytes in a row. The entry point at #R$F89D skips the first byte.
;
;   HL Address of the description
; O:HL Address of the first byte after the header
; O:C Number of bytes in a row
; O:D #N($FA), the page of the table of bytes shifted by two pixels
@label=ReadShapeHeader
c$F895 LD A,(HL)     ; Read #REGhl.
 $F896 LD ($5C1E),A  ; The number of strips.
 $F899 LD ($5C1F),A  ; The number of strips.
 $F89C INC HL        ; Advance #REGhl.
; This entry point is used by the routine at #R$F8E2.
@label=ReadShapeHeader_Rows
*$F89D LD A,(HL)     ; Read #REGhl.
 $F89E LD ($5C1C),A  ; The number of rows.
 $F8A1 LD ($5C1D),A  ; The number of rows.
 $F8A4 INC HL        ; Advance #REGhl.
 $F8A5 LD D,$FA      ; #REGd=#N$FA.
 $F8A7 LD C,(HL)     ; Read #REGhl into #REGc.
 $F8A8 INC HL        ; Advance #REGhl.
 $F8A9 RET           ; Return.

; Merge Shifted Byte
;
; Used by the routines at #R$F8E2 and #R$F939.
; .
; Merges a byte of a shape into the buffer, shifted to the right by the
; number of pixels that the table in #REGd gives. The shifted byte is two
; bytes: the first is ORed into the byte at #REGhl' and the second into the one
; after it.
;
;   D Page of the table of shifted bytes
;   HL Address of the byte to shift
;   HL' Address in the buffer
; O:HL' Address of the second byte that was merged
@label=MergeShiftedByte
c$F8AA LD E,(HL)     ; Read #REGhl into #REGe.
 $F8AB LD A,(DE)     ; Read #REGde.
 $F8AC EXX           ; Switch to the alternate registers.
 $F8AD OR (HL)       ; Set the bits of #REGa that are set in the byte at
                     ; #REGhl.
 $F8AE LD (HL),A     ; Write #REGa where #REGhl points.
 $F8AF INC HL        ; Advance #REGhl.
 $F8B0 EXX           ; Switch to the alternate registers.
 $F8B1 INC D         ; Advance #REGd.
 $F8B2 LD A,(DE)     ; Read #REGde.
 $F8B3 DEC D         ; Step #REGd back.
 $F8B4 EXX           ; Switch to the alternate registers.
 $F8B5 OR (HL)       ; Set the bits of #REGa that are set in the byte at
                     ; #REGhl.
 $F8B6 LD (HL),A     ; Write #REGa where #REGhl points.
 $F8B7 EXX           ; Switch to the alternate registers.
 $F8B8 RET           ; Return.

; Merge Background Byte
;
; Used by the routine at #R$F939.
; .
; Merges one byte of the chequered background into the buffer: the
; pattern byte of #N($55), shifted by the amount that the table in #REGd gives.
; The entry point at #R$F8BC merges #REGa.
;
;   D Page of the table of shifted bytes
;   HL' Address in the buffer
; O:HL' Address of the next byte in the buffer
@label=MergeBackgroundByte
c$F8B9 LD E,$55      ; #REGe=#N$55.
 $F8BB LD A,(DE)     ; Read #REGde.
; This entry point is used by the routines at #R$F8E2 and #R$F939.
@label=MergeBackgroundByte_Merge
*$F8BC EXX           ; Switch to the alternate registers.
; This entry point is used by the routine at #R$F8E2.
@label=MergeBackgroundByte_Store
*$F8BD OR (HL)       ; Set the bits of #REGa that are set in the byte at
                     ; #REGhl.
 $F8BE LD (HL),A     ; Write #REGa where #REGhl points.
 $F8BF INC HL        ; Advance #REGhl.
 $F8C0 EXX           ; Switch to the alternate registers.
 $F8C1 RET           ; Return.

; Fetch Shifted Byte
;
; Finds the second byte of a byte of a shape that has been shifted to the
; right. The entry point at #R$F8C3 first sets the byte count to the width of a
; row and the one at #R$F8C4 does not change #REGhl.
;
;   C Number of bytes in a row
;   D Page of the table of shifted bytes
;   HL Address of the byte to shift
; O:A The second byte of the shifted byte
@label=FetchShiftedByte
c$F8C2 INC HL        ; Advance #REGhl.
; This entry point is used by the routine at #R$F8E2.
@label=FetchShiftedByte_Count
*$F8C3 LD B,C        ; #REGb=#REGc.
; This entry point is used by the routines at #R$F8E2 and #R$F939.
@label=FetchShiftedByte_Byte
*$F8C4 LD E,(HL)     ; Read #REGhl into #REGe.
 $F8C5 INC D         ; Advance #REGd.
 $F8C6 LD A,(DE)     ; Read #REGde.
 $F8C7 DEC D         ; Step #REGd back.
 $F8C8 RET           ; Return.

; Merge Next Shifted Byte
;
; Used by the routines at #R$F8E2 and #R$F939.
; .
; Moves on to the next byte of a shape and merges the first byte of the
; shifted value of the byte that was fetched. The entry point at #R$F8CB merges
; #REGa.
;
;   DE Address in the table of shifted bytes
;   HL Address of the byte of the shape
;   HL' Address in the buffer
; O:HL Address of the next byte of the shape
@label=MergeNextShiftedByte
c$F8C9 INC HL        ; Advance #REGhl.
 $F8CA LD A,(DE)     ; Read #REGde.
; This entry point is used by the routine at #R$F939.
@label=MergeNextShiftedByte_Merge
*$F8CB EXX           ; Switch to the alternate registers.
 $F8CC OR (HL)       ; Set the bits of #REGa that are set in the byte at
                     ; #REGhl.
 $F8CD LD (HL),A     ; Write #REGa where #REGhl points.
 $F8CE EXX           ; Switch to the alternate registers.
 $F8CF RET           ; Return.

; Next Shift
;
; Used by the routine at #R$F939.
; .
; Moves on to the table for the next shift: it restores the strip and row
; counters from their copies and adds two to the page of the table. The Z flag
; is set when there are no more tables.
;
;   D Page of the table of shifted bytes
; O:D Page of the table for the next shift
; O:F The Z flag is set after the shift by six pixels
@label=NextShift
c$F8D0 LD A,($5C1F)  ; The number of strips.
 $F8D3 LD ($5C1E),A  ; The number of strips.
; This entry point is used by the routine at #R$F8E2.
@label=NextShift_Rows
*$F8D6 LD A,($5C1D)  ; The number of rows.
 $F8D9 LD ($5C1C),A  ; The number of rows.
 $F8DC LD A,D        ; #REGa=#REGd.
 $F8DD ADD A,$02     ; Add #N$02 to #REGa.
 $F8DF LD D,A        ; #REGd=#REGa.
 $F8E0 AND A         ; Is #REGa zero?
 $F8E1 RET           ; Return.

; Build Shifted Shape A
;
; Used by the routine at #R$F7EB.
; .
; Merges a description of a shape into the buffers, once for each of the
; three shifts, using the first of the two formats. The description starts with
; the number of rows and the number of bytes in a row; the rows follow. Each
; row is merged into the buffer, with the byte that is left over at the end of
; the row from the shifted bytes, and the buffer moves on #N($30) bytes after
; each shift.
;
; HL Address of the description
; HL' Address of the buffer for the shifted shape
@label=BuildShiftedShapeA
c$F8E2 CALL $F89D    ; Call #R$F89D.
@label=BuildShiftedShapeA_Shift
*$F8E5 PUSH HL       ; Stash #REGhl on the stack.
@label=BuildShiftedShapeA_Row
*$F8E6 LD B,C        ; #REGb=#REGc.
 $F8E7 INC B         ; Advance #REGb.
@label=BuildShiftedShapeA_Merge
*$F8E8 CALL $F8AA    ; Call #R$F8AA.
 $F8EB INC HL        ; Advance #REGhl.
 $F8EC DJNZ $F8E8    ; Decrease #REGb and jump to #R$F8E8 until none remain.
 $F8EE EXX           ; Switch to the alternate registers.
 $F8EF LD (HL),$00   ; Store #N$00 at the address in #REGhl.
 $F8F1 DEC HL        ; Step #REGhl back.
 $F8F2 DEC HL        ; Step #REGhl back.
 $F8F3 DEC HL        ; Step #REGhl back.
 $F8F4 OR (HL)       ; Set the bits of #REGa that are set in the byte at
                     ; #REGhl.
 $F8F5 LD (HL),A     ; Write #REGa where #REGhl points.
 $F8F6 INC HL        ; Advance #REGhl.
 $F8F7 INC HL        ; Advance #REGhl.
 $F8F8 INC HL        ; Advance #REGhl.
 $F8F9 EXX           ; Switch to the alternate registers.
 $F8FA CALL $F8C3    ; Call #R$F8C3.
 $F8FD LD ($5C20),A  ; Update the segments still to draw.
@label=BuildShiftedShapeA_Next
 $F900 INC B         ; Advance #REGb.
@label=BuildShiftedShapeA_Loop
*$F901 CALL $F8C9    ; Call #R$F8C9.
 $F904 CALL $F8C4    ; Call #R$F8C4.
 $F907 CALL $F8BC    ; Call #R$F8BC.
 $F90A DJNZ $F901    ; Decrease #REGb and jump to #R$F901 until none remain.
 $F90C INC D         ; Advance #REGd.
 $F90D LD A,(DE)     ; Read #REGde.
 $F90E DEC D         ; Step #REGd back.
 $F90F EXX           ; Switch to the alternate registers.
 $F910 DEC HL        ; Step #REGhl back.
 $F911 XOR (HL)      ; Flip the bits of #REGa that are set in the byte at
                     ; #REGhl.
 $F912 LD (HL),A     ; Write #REGa where #REGhl points.
 $F913 LD A,($5C20)  ; The segments still to draw.
 $F916 CALL $F8BD    ; Call #R$F8BD.
 $F919 LD A,($5C1C)  ; The number of rows.
 $F91C DEC A         ; Step #REGa back.
 $F91D LD ($5C1C),A  ; One fewer row of the shifted shape.
 $F920 JR NZ,$F8E6   ; Jump to #R$F8E6 if the zero flag is clear.
 $F922 CALL $F8D6    ; Call #R$F8D6.
 $F925 EXX           ; Switch to the alternate registers.
 $F926 LD DE,$0030   ; #REGde=#N$30.
 $F929 ADD HL,DE     ; #REGhl gains #REGde.
 $F92A EXX           ; Switch to the alternate registers.
 $F92B POP HL        ; Bring #REGhl back off the stack.
 $F92C JR NZ,$F8E5   ; Jump to #R$F8E5 if the zero flag is clear.
 $F92E LD A,$5C      ; #REGa=#N$5C.
 $F930 LD ($EB34),A  ; Purpose not yet known.
 $F933 LD A,$40      ; #REGa=#N$40.
 $F935 LD ($EC30),A  ; Purpose not yet known.
 $F938 RET           ; Return.

; Build Shifted Shape B
;
; Used by the routine at #R$F7EB.
; .
; Merges a description of a shape into the buffers, once for each of the
; three shifts, using the second format. The description starts with the number
; of strips, the number of rows and the number of bytes in a row. Each row is
; merged into the buffer next to the chequered background. When the flag at
; #R$5C25 is set the background is merged differently, as the shape is back to
; front.
;
; HL Address of the description
; HL' Address of the buffer for the shifted shape
@label=BuildShiftedShapeB
c$F939 CALL $F895    ; Call #R$F895.
@label=BuildShiftedShapeB_Shift
*$F93C PUSH HL       ; Stash #REGhl on the stack.
@label=BuildShiftedShapeB_Row
*$F93D LD B,C        ; #REGb=#REGc.
 $F93E LD A,($5C25)  ; The back-to-front flag.
 $F941 AND A         ; {Jump to #R$F94D if #REGa is zero.
 $F942 JR Z,$F94D    ; }
 $F944 LD E,$55      ; #REGe=#N$55.
 $F946 INC D         ; Advance #REGd.
 $F947 LD A,(DE)     ; Read #REGde.
 $F948 DEC D         ; Step #REGd back.
 $F949 EXX           ; Switch to the alternate registers.
 $F94A OR (HL)       ; Set the bits of #REGa that are set in the byte at
                     ; #REGhl.
 $F94B LD (HL),A     ; Write #REGa where #REGhl points.
 $F94C EXX           ; Switch to the alternate registers.
@label=BuildShiftedShapeB_Merge
*$F94D CALL $F8AA    ; Call #R$F8AA.
 $F950 INC HL        ; Advance #REGhl.
 $F951 DJNZ $F94D    ; Decrease #REGb and jump to #R$F94D until none remain.
 $F953 LD A,($5C25)  ; The back-to-front flag.
 $F956 AND A         ; {Jump to #R$F95E if #REGa is zero.
 $F957 JR Z,$F95E    ; }
 $F959 EXX           ; Switch to the alternate registers.
 $F95A INC HL        ; Advance #REGhl.
 $F95B EXX           ; Switch to the alternate registers.
 $F95C JR $F961      ; Jump to #R$F961.
@label=BuildShiftedShapeB_Background
*$F95E CALL $F8B9    ; Call #R$F8B9.
@label=BuildShiftedShapeB_Strip
*$F961 LD A,($5C1E)  ; The strips still to merge.
 $F964 DEC A         ; Step #REGa back.
 $F965 LD ($5C1E),A  ; The strips still to merge.
 $F968 JR Z,$F996    ; Jump to #R$F996 if the zero flag is set.
 $F96A LD A,($5C25)  ; The back-to-front flag.
 $F96D AND A         ; {Jump to #R$F976 if #REGa is not zero.
 $F96E JR NZ,$F976   ; }
 $F970 LD E,$AA      ; #REGe=#N$AA.
 $F972 LD A,(DE)     ; Read #REGde.
 $F973 CALL $F8CB    ; Call #R$F8CB.
@label=BuildShiftedShapeB_Second
*$F976 LD B,C        ; #REGb=#REGc.
@label=BuildShiftedShapeB_Bytes
*$F977 CALL $F8C4    ; Call #R$F8C4.
 $F97A CALL $F8BC    ; Call #R$F8BC.
 $F97D CALL $F8C9    ; Call #R$F8C9.
 $F980 DJNZ $F977    ; Decrease #REGb and jump to #R$F977 until none remain.
 $F982 LD A,($5C25)  ; The back-to-front flag.
 $F985 AND A         ; Is #REGa zero?
 $F986 EXX           ; Switch to the alternate registers.
 $F987 JR Z,$F992    ; Jump to #R$F992 if the zero flag is set.
 $F989 EXX           ; Switch to the alternate registers.
 $F98A LD E,$AA      ; #REGe=#N$AA.
 $F98C INC D         ; Advance #REGd.
 $F98D LD A,(DE)     ; Read #REGde.
 $F98E DEC D         ; Step #REGd back.
 $F98F EXX           ; Switch to the alternate registers.
 $F990 OR (HL)       ; Set the bits of #REGa that are set in the byte at
                     ; #REGhl.
 $F991 LD (HL),A     ; Write #REGa where #REGhl points.
@label=BuildShiftedShapeB_Advance
*$F992 INC HL        ; Advance #REGhl.
 $F993 EXX           ; Switch to the alternate registers.
 $F994 JR $F99C      ; Jump to #R$F99C.
@label=BuildShiftedShapeB_Reload
*$F996 LD A,($5C1F)  ; The number of strips.
 $F999 LD ($5C1E),A  ; The number of strips.
@label=BuildShiftedShapeB_Count
*$F99C LD A,($5C1C)  ; The rows still to merge.
 $F99F DEC A         ; Step #REGa back.
 $F9A0 LD ($5C1C),A  ; The rows still to merge.
 $F9A3 JR NZ,$F93D   ; Jump to #R$F93D if the zero flag is clear.
 $F9A5 POP HL        ; Bring #REGhl back off the stack.
 $F9A6 CALL $F8D0    ; Call #R$F8D0.
 $F9A9 JR NZ,$F93C   ; Jump to #R$F93C if the zero flag is clear.
 $F9AB RET           ; Return.

; Unused
s$F9AC DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $F9B4 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $F9BC DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $F9C4 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $F9CC DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $F9D4 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $F9DC DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $F9E4 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $F9EC DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $F9F4 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $F9FC DEFB $00,$00,$00,$30

