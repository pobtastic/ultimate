 $A7FB LD A,(BC)     ; Fetch it.
 $A7FC OR (HL)       ; Set the pixels of the screen.
 $A7FD LD (HL),A     ; Store the byte.
 $A7FE INC DE        ; Move on to the next byte of the sprite.
 $A7FF JP $A695      ; Jump to #R$A695.

; Delay
;
; Used by the routines at #R$83D6, #R$8615, #R$9F71, #R$F422, #R$F4FC, #R$F52A
; and #R$F591.
; .
; Waits for a short time that is proportional to #REGd.
;
; D Length of the delay
@label=Delay
c$A802 LD E,$FF      ; Set the inner counter.
@label=Delay_Loop
*$A804 DEC E         ; Count down the inner counter.
 $A805 JR NZ,$A804   ; Loop back to #R$A804 until none remain.
 $A807 DEC D         ; Count down the outer counter.
 $A808 JR NZ,$A802   ; Loop back to #R$A802 until none remain.
 $A80A RET           ; Return.
; View the equivalent code in;
; #LIST
; { #BUBBLER$A8F9 }
; LIST#

; Map Object Slots
;
; Six slots of #N($1A) bytes for the objects of the planet that are
; near the ship. They have the same layout as the slots at #R$9974, with two
; more bytes at the end: the index in the table at #N$5C94 of the map entry
; that the object came from (at offsets #N($18) and #N($19)). A slot with a
; type of #N($FF) is free. The last slot is cut short by the code at
; #R$A8A5.
@label=MapObjectSlots
g$A80B DEFB $FF,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $A825 DEFB $FF,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $A83F DEFB $FF,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
 $A859 DEFB $FF,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
@label=MapObjectSlots_Fifth
 $A873 DEFB $FF,$00,$00,$80,$00,$00,$00,$00,$00,$00,$00,$00,$00,$FF,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
@label=MapObjectSlots_Sixth
 $A88D DEFB $FF,$00,$00,$80,$00,$00,$00,$00,$00,$00,$00,$00,$00,$FF,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00

; Add To Stack
;
; Used by the routine at #R$B5B5.
; .
; Adds one or two units to the height of the stack at #R$C905 (which
; hangs below the ship) if the item that is carried at #R$F601 is item number
; #N($06). The limit is #N($12). The screen is cleared where the new units
; will be drawn. This is a best reading of the code. An object with a state of
; zero does not add anything.
;
; IX Address of the object
@label=AddToStack
c$A8A5 LD A,(IX+$13) ; Fetch the state of the object.
 $A8A8 AND A         ; {Return if it is zero.
 $A8A9 RET Z         ; }
; This entry point is used by the routine at #R$917C.
; .
; The routine is entered here with a state in #REGa when the number of
; units is random.
@label=AddToStack_Units
*$A8AA AND %00000010 ; Keep bit 1 of the state...
 $A8AC SRL A         ; ...move it to bit 0...
 $A8AE INC A         ; ...and add one to get one or two units.
 $A8AF LD B,A        ; Store the number of units in #REGb.
 $A8B0 LD A,($F601)  ; Fetch the item that is carried.
 $A8B3 CP $06        ; {Return if it is not item number #N($06).
 $A8B5 RET NZ        ; }
 $A8B6 LD A,($C905)  ; {Fetch the height of the stack and keep the old height
 $A8B9 LD E,A        ; in #REGe.}
 $A8BA ADD A,B       ; Add the new units.
 $A8BB CP $12        ; {Jump to #R$A8C1 if the height is below the limit of
 $A8BD JR C,$A8C1    ; #N($12).}
 $A8BF LD A,$12      ; Use the limit.
@label=AddToStack_Store
*$A8C1 LD ($C905),A  ; Store the new height of the stack.
 $A8C4 LD A,($C903)  ; Fetch the vertical position of the ship.
 $A8C7 SUB E         ; Subtract the old height to find the first new row.
 $A8C8 LD H,A        ; Store it in #REGh.
 $A8C9 LD L,$70      ; Use the horizontal position of the stack.
 $A8CB CALL $A149    ; Find the screen address.
@label=AddToStack_Clear
*$A8CE LD (HL),$00   ; Clear the left byte of the row.
 $A8D0 INC L         ; Move on to the right.
 $A8D1 LD (HL),$00   ; Clear the right byte of the row.
 $A8D3 DEC L         ; Move back to the left.
 $A8D4 CALL $A1B3    ; Move up a row.
 $A8D7 DJNZ $A8CE    ; Loop back to #R$A8CE for each new unit.
; Continue on to #R$A8D9.

; Build Stack Graphic
;
; Used by the routines at #R$AFE9 and #R$DCA1.
; .
; Builds the graphic of the stack that hangs below the ship, as a sprite
; that is two bytes wide in a buffer with seven bytes to a row, by copying one
; row of the stack for each unit of its height. This is a best reading of the
; code.
@label=BuildStackGraphic
c$A8D9 LD HL,$F6BB   ; Use the buffer.
 $A8DC LD DE,$7721   ; Use the graphic of the stack.
 $A8DF LD A,($C905)  ; Fetch the height of the stack.
 $A8E2 AND A         ; {Return if the stack is empty.
 $A8E3 RET Z         ; }
 $A8E4 LD B,A        ; Use the height as a counter.
@label=BuildStackGraphic_Loop
*$A8E5 LD A,(DE)     ; Copy a row of the stack...
 $A8E6 LD (HL),A     ; Write #REGa where #REGhl points.
 $A8E7 INC DE        ; Advance #REGde.
 $A8E8 INC HL        ; Advance #REGhl.
 $A8E9 LD A,(DE)     ; ...two bytes wide.
 $A8EA LD (HL),A     ; Write #REGa where #REGhl points.
 $A8EB INC DE        ; Advance #REGde.
 $A8EC LD A,$05      ; Move on to the next row of the buffer.
 $A8EE CALL $9BCF    ; Call #R$9BCF.
 $A8F1 DJNZ $A8E5    ; Loop back to #R$A8E5 for each row.
 $A8F3 RET           ; Return.

; Check Map Object Collisions
;
; Used by the routine at #R$C374.
; .
; Checks whether the ship is touching any of the first four map objects
; in the slots at #R$A80B. When it is, most objects bounce the ship back, but a
; type #N($1B) object in state four or five fills the fuel gauge, which is
; held in #R$CC4B, and flashes the ship, and is then removed and marked as
; destroyed in the map table.
@label=CheckMapObjectCollisions
c$A8F4 LD A,($96AB)   ; Fetch the flag that is set once the crystals are
                      ; delivered.
 $A8F7 AND A          ; {Return if it is set.
 $A8F8 RET NZ         ; }
 $A8F9 LD B,$04       ; Set the number of slots to four.
 $A8FB LD IX,$A80B    ; Use the first slot.
 $A8FF LD HL,($C902)  ; Fetch the position of the ship.
 $A902 LD L,$64       ; The ship is always at the same horizontal position.
 $A904 LD A,($CCBB)   ; Fetch the horizontal scroll speed.
 $A907 NEG            ; Negate it.
 $A909 ADD A,L        ; Subtract it from the horizontal position.
 $A90A LD L,A         ; Store the horizontal position.
 $A90B LD A,($CCBA)   ; Fetch the vertical scroll speed.
 $A90E NEG            ; Negate it.
 $A910 ADD A,H        ; Subtract it from the vertical position.
 $A911 LD H,A         ; Store the vertical position.
 $A912 LD ($CE3A),HL  ; Store the position of the ship.
 $A915 LD D,$28       ; The ship is #N($28) pixels wide.
 $A917 LD A,($C1A9)   ; Fetch the height of the ship.
 $A91A LD E,A         ; Put it in #REGe.
 $A91B LD ($BA09),DE  ; Store the size of the ship.
@label=CheckMapObjectCollisions_Loop
*$A91F PUSH BC        ; Save the slot counter.
 $A920 PUSH IX        ; Save the address of the slot.
 $A922 LD A,(IX+$00)  ; Fetch the type of the object.
 $A925 INC A          ; Is it #N($FF), which is free?
 $A926 JP Z,$A97B     ; Jump to #R$A97B if so.
 $A929 LD A,(IX+$13)  ; Fetch the state of the object.
 $A92C AND %00001111  ; Keep the bottom four bits.
 $A92E CP $0B         ; {Jump to #R$A97B if the state is #N($0B).
 $A930 JP Z,$A97B     ; }
 $A933 BIT 7,(IX+$10) ; {Jump to #R$A97B if the object is not on the screen.
 $A937 JP Z,$A97B     ; }
 $A93A LD A,(IX+$12)  ; Fetch the vertical position of the object on the
                      ; screen.
 $A93D CP $28         ; {Jump to #R$A97B if it is too far up.
 $A93F JP C,$A97B     ; }
 $A942 LD H,A         ; Store it in #REGh.
 $A943 LD A,(IX+$11)  ; Fetch the horizontal position of the object on the
                      ; screen.
 $A946 CP $30         ; {Jump to #R$A97B if it is too far to the left.
 $A948 JP C,$A97B     ; }
 $A94B CP $A0         ; {Jump to #R$A97B if it is too far to the right.
 $A94D JP NC,$A97B    ; }
 $A950 LD L,A         ; Store it in #REGl.
 $A951 LD ($ABA4),HL  ; Store the position of the object as the first box.
 $A954 CALL $ADBE     ; Find the sprite of the object.
 $A957 LD A,(DE)      ; Fetch the width of the sprite in bytes.
 $A958 ADD A,A        ; Multiply it by eight to get the width in pixels.
 $A959 ADD A,A        ; Double #REGa.
 $A95A ADD A,A        ; Double #REGa.
 $A95B LD ($ABA6),A   ; Store it as the width of the first box.
 $A95E INC DE         ; Move on to the height.
 $A95F LD A,(DE)      ; Fetch the height of the sprite.
 $A960 LD ($ABA7),A   ; Store it as the height of the first box.
 $A963 LD HL,($CE3A)  ; Fetch the position of the ship.
 $A966 LD DE,($BA09)  ; Fetch the size of the ship.
 $A96A LD ($AD46),IX  ; Save the address of the slot.
 $A96E LD IX,$ABA4    ; Use the first box.
 $A972 CALL $9DB1     ; Test whether the boxes overlap.
 $A975 LD A,($5C1C)   ; Fetch the result.
 $A978 AND A          ; {Jump to #R$A988 if they do.
 $A979 JR NZ,$A988    ; }
@label=CheckMapObjectCollisions_Next
*$A97B POP IX         ; Restore the address of the slot.
 $A97D LD BC,$001A    ; Move on to the next slot...
 $A980 ADD IX,BC      ; #REGix gains #REGbc.
 $A982 POP BC         ; Restore the slot counter.
 $A983 DEC B          ; Decrease the slot counter.
 $A984 JP NZ,$A91F    ; Jump back to #R$A91F for each slot.
 $A987 RET            ; Return.
; The ship has touched an object.
@label=CheckMapObjectCollisions_Hit
*$A988 LD IY,($AD46)  ; Fetch the address of the slot.
 $A98C LD A,(IY+$00)  ; Fetch the type of the object.
 $A98F CP $1B         ; {Jump to #R$A9C4 unless it is type #N($1B).
 $A991 JR NZ,$A9C4    ; }
 $A993 LD A,(IY+$13)  ; Fetch the state of the object.
 $A996 AND %00001111  ; Keep the bottom four bits.
 $A998 CP $04         ; {Jump to #R$A9A0 if the state is four.
 $A99A JR Z,$A9A0     ; }
 $A99C CP $05         ; {Jump to #R$A9C4 unless the state is five.
 $A99E JR NZ,$A9C4    ; }
@label=CheckMapObjectCollisions_Refuel
*$A9A0 LD HL,$4200    ; Use the value for a full fuel gauge.
 $A9A3 LD ($CC4B),HL  ; Fill the fuel gauge.
 $A9A6 SET 4,(IY+$10) ; Mark the object to be removed.
 $A9AA LD A,(IY+$18)  ; Fetch the position of the object in the map table.
 $A9AD AND %00000001  ; Keep the bits of #REGa that are set in #N$01.
 $A9AF LD H,A         ; #REGh=#REGa.
 $A9B0 LD L,(IY+$19)  ; Read offset #N$19 of #REGiy into #REGl.
 $A9B3 LD DE,$5C94    ; The map table.
 $A9B6 ADD HL,DE      ; #REGhl gains #REGde.
 $A9B7 SET 7,(HL)     ; Mark the entry in the map table as destroyed.
 $A9B9 LD A,$FF       ; #REGa=#N$FF.
 $A9BB LD ($8FC3),A   ; The damage counter.
 $A9BE CALL $8F76     ; Flash the ship.
 $A9C1 JP $A9FD       ; Jump to #R$A9FD.
; Any other object makes the ship bounce, if it is to the left or right
; of the ship or above or below it.
@label=CheckMapObjectCollisions_Bounce
*$A9C4 LD A,$FF       ; Set the flag for the ship bouncing.
 $A9C6 LD ($D0BC),A   ; Update the collision kind.
 $A9C9 LD A,(IX+$00)  ; Fetch the left edge of the box of the object.
 $A9CC CP $8B         ; {Bounce horizontally if it is #N($8B) or more.
 $A9CE CALL NC,$AA01  ; }
 $A9D1 LD A,(IX+$00)  ; Fetch the left edge of the box of the object.
 $A9D4 ADD A,(IX+$02) ; Add its width to get the right edge.
 $A9D7 CP $65         ; {Bounce horizontally if it is less than #N($65).
 $A9D9 CALL C,$AA01   ; }
 $A9DC LD A,($C903)   ; Fetch the vertical position of the ship.
 $A9DF LD H,A         ; Store it in #REGh.
 $A9E0 SUB E          ; Subtract the height of the ship...
 $A9E1 INC A          ; ...and add one to get the top of the ship.
 $A9E2 CP (IX+$01)    ; {Bounce vertically if the top of the ship is not above
 $A9E5 CALL NC,$AA15  ; the object.}
 $A9E8 LD A,($CCBA)   ; Fetch the vertical scroll speed.
 $A9EB NEG            ; Negate it.
 $A9ED BIT 7,A        ; {Jump to #R$A9FD if it is negative.
 $A9EF JR NZ,$A9FD    ; }
 $A9F1 LD A,(IX+$01)  ; Fetch the bottom edge of the box of the object.
 $A9F4 SUB (IX+$03)   ; Subtract its height.
 $A9F7 ADD A,$09      ; Add nine.
 $A9F9 CP H           ; {Bounce vertically if that is not above the bottom of
 $A9FA CALL NC,$AA15  ; the ship.}
@label=CheckMapObjectCollisions_Done
*$A9FD POP IX         ; Restore the address of the slot.
 $A9FF POP BC         ; Restore the slot counter.
 $AA00 RET            ; Return.

; Bounce Horizontally
;
; Used by the routine at #R$A8F4.
; .
; Makes the ship rebound after hitting something to its left or right:
; the horizontal speed of the ship is reversed and halved by #R$AA27, and the
; horizontal scroll speed is negated.
@label=BounceHorizontally
c$AA01 PUSH HL       ; Stash #REGhl on the stack.
 $AA02 LD HL,($C8EC) ; Fetch the word at #N$C8EC into #REGhl.
 $AA05 CALL $AA27    ; Call #R$AA27.
 $AA08 LD ($C8EC),HL ; Update the high byte of the ship's horizontal speed.
 $AA0B POP HL        ; Bring #REGhl back off the stack.
 $AA0C LD A,($CCBB)  ; The horizontal scroll speed.
 $AA0F NEG           ; Negate #REGa.
 $AA11 LD ($CCBB),A  ; Update the horizontal scroll speed.
 $AA14 RET           ; Return.

; Bounce Vertically
;
; Used by the routine at #R$A8F4.
; .
; Makes the ship rebound after hitting something above or below it: the
; vertical speed of the ship is reversed and halved by #R$AA27.
@label=BounceVertically
c$AA15 PUSH HL       ; Stash #REGhl on the stack.
 $AA16 LD HL,($C8EE) ; Fetch the word at #N$C8EE into #REGhl.
 $AA19 CALL $AA27    ; Call #R$AA27.
 $AA1C LD ($C8EE),HL ; Update the high byte of the ship's vertical speed.
 $AA1F LD A,H        ; #REGa=#REGh.
 $AA20 LD H,L        ; #REGh=#REGl.
 $AA21 LD L,A        ; #REGl=#REGa.
 $AA22 CALL $B2D5    ; Call #R$B2D5.
 $AA25 POP HL        ; Bring #REGhl back off the stack.
 $AA26 RET           ; Return.

; Reverse And Halve Speed
;
; Used by the routines at #R$AA01 and #R$AA15.
; .
; Used to make the ship rebound. The bytes of the speed are swapped
; into #REGhl, the speed is negated and halved, a speed that is close to zero
; is set to zero, and the bytes are swapped back.
;
;   HL Speed
; O:HL New speed
@label=ReverseAndHalveSpeed
c$AA27 LD A,H        ; #REGa=#REGh.
 $AA28 LD H,L        ; #REGh=#REGl.
 $AA29 LD L,A        ; #REGl=#REGa.
 $AA2A CALL $BE08    ; Call #R$BE08.
 $AA2D CALL $BE03    ; Call #R$BE03.
 $AA30 CALL $BA0B    ; Call #R$BA0B.
 $AA33 LD A,H        ; #REGa=#REGh.
 $AA34 LD H,L        ; #REGh=#REGl.
 $AA35 LD L,A        ; #REGl=#REGa.
 $AA36 RET           ; Return.

; Build Carried Item Graphic
;
; Used by the routines at #R$C374 and #R$DCA1.
; .
; Builds the graphic of the item that is carried by the ship in the
; buffer at #R$F6BA (six bytes to a row) and clears the part of the
; screen beside the ship where the item will be drawn. Each byte of the
; sprite of the item is looked up in the shift table at #R$FC00 and combined
; with the buffer using XOR.
@label=BuildCarriedItemGraphic
c$AA37 LD HL,$AF7B   ; The sprite tables.
 $AA3A LD A,($C904)  ; The item the ship is about to pick up.
 $AA3D AND %00001111 ; Keep the bits of #REGa that are set in #N$0F.
 $AA3F LD C,A        ; #REGc=#REGa.
 $AA40 CALL $A1AA    ; Call #R$A1AA.
 $AA43 EX DE,HL      ; Swap #REGde and #REGhl.
 $AA44 LD A,(DE)     ; Read #REGde.
 $AA45 LD B,A        ; #REGb=#REGa.
 $AA46 LD ($5C1F),A  ; The width of the carried item.
 $AA49 INC DE        ; Advance #REGde.
 $AA4A LD A,(DE)     ; Read #REGde.
 $AA4B LD ($5C20),A  ; Update the segments still to draw.
 $AA4E LD C,A        ; #REGc=#REGa.
 $AA4F LD HL,$F6BA   ; The carried picture in the ship work area.
@label=BuildCarriedItemGraphic_Row
*$AA52 PUSH HL       ; Stash #REGhl on the stack.
@label=BuildCarriedItemGraphic_Column
*$AA53 PUSH BC       ; Stash #REGbc on the stack.
 $AA54 LD B,$FC      ; #REGb=#N$FC.
 $AA56 INC DE        ; Advance #REGde.
 $AA57 LD A,(DE)     ; Read #REGde.
 $AA58 LD C,A        ; #REGc=#REGa.
 $AA59 LD A,(BC)     ; Read #REGbc.
 $AA5A XOR (HL)      ; Flip the bits of #REGa that are set in the byte at
                     ; #REGhl.
 $AA5B LD (HL),A     ; Write #REGa where #REGhl points.
 $AA5C INC B         ; Advance #REGb.
 $AA5D INC HL        ; Advance #REGhl.
 $AA5E LD A,(BC)     ; Read #REGbc.
 $AA5F XOR (HL)      ; Flip the bits of #REGa that are set in the byte at
                     ; #REGhl.
 $AA60 LD (HL),A     ; Write #REGa where #REGhl points.
 $AA61 POP BC        ; Bring #REGbc back off the stack.
 $AA62 DJNZ $AA53    ; Decrease #REGb and jump to #R$AA53 until none remain.
 $AA64 POP HL        ; Bring #REGhl back off the stack.
 $AA65 LD A,($5C1F)  ; The width of the carried item.
 $AA68 LD B,A        ; #REGb=#REGa.
 $AA69 LD A,$06      ; #REGa=#N$06.
 $AA6B CALL $9BCF    ; Call #R$9BCF.
 $AA6E DEC C         ; Step #REGc back.
 $AA6F JR NZ,$AA52   ; Jump to #R$AA52 if the zero flag is clear.
 $AA71 LD HL,($C902) ; Fetch the word at #N$C902 into #REGhl.
 $AA74 CALL $A149    ; Call #R$A149.
 $AA77 LD A,($5C20)  ; The segments still to draw.
 $AA7A LD B,A        ; #REGb=#REGa.
 $AA7B INC L         ; Advance #REGl.
@label=BuildCarriedItemGraphic_Clear
*$AA7C LD (HL),$00   ; Store #N$00 at the address in #REGhl.
 $AA7E INC L         ; Advance #REGl.
 $AA7F LD (HL),$00   ; Store #N$00 at the address in #REGhl.
 $AA81 INC L         ; Advance #REGl.
 $AA82 LD (HL),$00   ; Store #N$00 at the address in #REGhl.
 $AA84 INC L         ; Advance #REGl.
 $AA85 LD (HL),$00   ; Store #N$00 at the address in #REGhl.
 $AA87 DEC L         ; Step #REGl back.
 $AA88 DEC L         ; Step #REGl back.
 $AA89 DEC L         ; Step #REGl back.
 $AA8A CALL $A1C3    ; Call #R$A1C3.
 $AA8D DJNZ $AA7C    ; Decrease #REGb and jump to #R$AA7C until none remain.
 $AA8F LD A,($5C3C)  ; The scroll-in flag.
 $AA92 AND A         ; {Return if #REGa is not zero.
 $AA93 RET NZ        ; }
; Continue on to #R$AA94.

; Attach Item To Ship
;
; Used by the routine at #R$AFE9.
; .
; Makes the ship taller by the height of the item that it carries, and
; adjusts its position, according to whether bit 6 of the item at #N$C904
; says that the item is carried above the ship or below it. Then the ship is
; drawn.
@label=AttachItemToShip
c$AA94 LD A,($C904)    ; The item the ship is about to pick up.
 $AA97 LD B,A          ; #REGb=#REGa.
 $AA98 LD A,($C1A9)    ; The height of the ship.
 $AA9B LD C,A          ; #REGc=#REGa.
 $AA9C LD (IX+$09),$08 ; Store #N$08 at offset #N$09 of #REGix.
 $AAA0 LD E,$03        ; #REGe=#N$03.
 $AAA2 LD HL,$F6B9     ; The ship work area.
 $AAA5 LD A,$05        ; #REGa=#N$05.
 $AAA7 BIT 6,B         ; {Jump to #R$AAB6 if bit 6 of #REGb is set.
 $AAA9 JR NZ,$AAB6     ; }
 $AAAB LD HL,$F6D7     ; The right-hand picture in the ship work area.
 $AAAE LD E,$FD        ; #REGe=#N$FD.
 $AAB0 NEG             ; Negate #REGa.
 $AAB2 LD (IX+$09),$F8 ; Store #N$F8 at offset #N$09 of #REGix.
@label=AttachItemToShip_Store
*$AAB6 LD ($C1AA),HL   ; Update the ship buffer address.
 $AAB9 ADD A,C         ; #REGa gains #REGc.
 $AABA LD ($C1A9),A    ; Update the height of the ship.
 $AABD LD A,($5C38)    ; The ship row.
 $AAC0 ADD A,E         ; #REGa gains #REGe.
 $AAC1 LD ($5C38),A    ; Update the ship row.
 $AAC4 LD A,(IX+$09)   ; Read offset #N$09 of #REGix.
 $AAC7 ADD A,(IX+$1E)  ; Add the byte at offset #N$1E of #REGix to #REGa.
 $AACA LD (IX+$1E),A   ; Write #REGa to offset #N$1E of #REGix.
 $AACD LD (IX+$07),$00 ; Store #N$00 at offset #N$07 of #REGix.
 $AAD1 CALL $BF66      ; Call #R$BF66.
 $AAD4 JP $B9EC        ; Jump to #R$B9EC.

; Check Item Pickup
;
; Used by the routine at #R$AC60.
; .
; Checks whether the ship can pick up an object. A type #N($1E) object
; can only be picked up when its item number is the one that is wanted at
; #R$F602; objects with an item number of #N($0A) can never be picked up.
; #R$AB03 does the pick up if the ship is touching the object.
;
; IX Address of the object
@label=CheckItemPickup
c$AAD7 LD A,(IX+$00)   ; The type.
 $AADA CP $1E          ; {Jump to #R$AAF2 if #REGa is not #N$1E.
 $AADC JR NZ,$AAF2     ; }
 $AADE LD A,($F5EE)    ; The first part flag.
 $AAE1 AND A           ; {Return if #REGa is zero.
 $AAE2 RET Z           ; }
 $AAE3 LD A,(IX+$13)   ; The state.
 $AAE6 AND %00001111   ; Keep the bits of #REGa that are set in #N$0F.
 $AAE8 LD B,A          ; #REGb=#REGa.
 $AAE9 LD A,($F602)    ; The crystal count.
 $AAEC CP B            ; {Return if #REGa is not #REGb.
 $AAED RET NZ          ; }
 $AAEE LD (IX+$0D),$FA ; Store #N$FA at offset #N$0D of #REGix.
@label=CheckItemPickup_Kind
*$AAF2 LD A,(IX+$13)   ; The state.
 $AAF5 AND %00001111   ; Keep the bits of #REGa that are set in #N$0F.
 $AAF7 CP $0A          ; {Return if #REGa is #N$0A.
 $AAF9 RET Z           ; }
 $AAFA CP $09          ; {Jump to #R$AB03 if #REGa is not #N$09.
 $AAFC JR NZ,$AB03     ; }
 $AAFE LD A,($F5F6)    ; The ninth part flag.
 $AB01 AND A           ; {Return if #REGa is zero.
 $AB02 RET Z           ; }
; Test whether the ship is touching the object, and give up if the
; object is not on the screen.
@label=CheckItemPickup_Touch
*$AB03 LD A,($A1D7)    ; The rows of the first sprite.
 $AB06 AND A           ; {Return if #REGa is zero.
 $AB07 RET Z           ; }
 $AB08 LD ($ABA7),A    ; The height of the collision box.
 $AB0B LD HL,($A1D3)   ; Fetch the word at #R$A1D3 into #REGhl.
 $AB0E LD A,H          ; #REGa=#REGh.
 $AB0F CP $28          ; {Return if #REGa is less than #N$28.
 $AB11 RET C           ; }
 $AB12 LD A,L          ; #REGa=#REGl.
 $AB13 CP $30          ; {Return if #REGa is less than #N$30.
 $AB15 RET C           ; }
 $AB16 CP $90          ; {Return if #REGa is #N$90 or more.
 $AB18 RET NC          ; }
 $AB19 LD ($ABA4),HL   ; Update the collision box.
 $AB1C LD A,($5C28)    ; The sprite width in bytes.
 $AB1F ADD A,A         ; Double #REGa.
 $AB20 ADD A,A         ; Double #REGa.
 $AB21 ADD A,A         ; Double #REGa.
 $AB22 LD ($ABA6),A    ; The width of the collision box.
 $AB25 LD HL,($C902)   ; Fetch the word at #N$C902 into #REGhl.
 $AB28 LD L,$70        ; #REGl=#N$70.
 $AB2A LD D,$10        ; #REGd=#N$10.
 $AB2C LD A,($C1A9)    ; The height of the ship.
 $AB2F SUB $0A         ; Subtract #N$0A from #REGa.
 $AB31 LD E,A          ; #REGe=#REGa.
; Test the box of the object against a box around the ship.
 $AB32 CALL $AB98      ; Call #R$AB98.
 $AB35 LD A,($5C1C)    ; The hit flag.
 $AB38 AND A           ; {Return if #REGa is zero.
 $AB39 RET Z           ; }
; The ship has picked the object up: play a sound, score #N(1000) points,
; then record the item that is now carried.
 $AB3A CALL $71FE      ; Call #R$71FE.
 $AB3D LD BC,$1000     ; #REGbc=#N$1000.
 $AB40 CALL $925E      ; Call #R$925E.
 $AB43 LD A,(IX+$00)   ; The type.
 $AB46 CP $1E          ; {Jump to #R$AB5E if #REGa is not #N$1E.
 $AB48 JR NZ,$AB5E     ; }
 $AB4A LD A,(IX+$13)   ; The state.
 $AB4D AND %00001111   ; Keep the bits of #REGa that are set in #N$0F.
 $AB4F OR %11000000    ; Set the bits of #REGa that are set in #N$C0.
 $AB51 LD ($C904),A    ; Update the item the ship is about to pick up.
 $AB54 LD HL,$F630     ; The twelfth item site.
 $AB57 AND %00001111   ; Keep the bits of #REGa that are set in #N$0F.
 $AB59 LD ($F601),A    ; Update the carried item.
 $AB5C JR $AB69        ; Jump to #R$AB69.
; The object is not type #N($1E): the item is recorded in the table of
; item sites at #R$F604 and the carried item at #N$C904 is set to its number.
@label=CheckItemPickup_Site
*$AB5E LD A,(IX+$13)   ; The state.
 $AB61 INC A           ; Advance #REGa.
 $AB62 LD ($C904),A    ; Update the item the ship is about to pick up.
 $AB65 DEC A           ; Step #REGa back.
 $AB66 LD HL,$F604     ; The item sites.
; Set bit 7 of the record for the item, remove the object from the
; screen and free its slot.
@label=CheckItemPickup_Record
*$AB69 ADD A,A         ; Double #REGa.
 $AB6A ADD A,A         ; Double #REGa.
 $AB6B CALL $9BCF      ; Call #R$9BCF.
 $AB6E SET 7,(HL)      ; Set bit 7 of the byte at the address in #REGhl.
 $AB70 SET 4,(IX+$10)  ; Set bit 4 of offset #N$10 of #REGix.
 $AB74 LD (IX+$00),$FF ; Store #N$FF at offset #N$00 of #REGix.
 $AB78 LD A,(IX+$13)   ; The state.
 $AB7B CP $09          ; {Return if #REGa is not #N$09.
 $AB7D RET NZ          ; }
; Item number #N($09) is special.
@label=CheckItemPickup_Special
 $AB7E XOR A           ; Clear #REGa.
 $AB7F LD ($C904),A    ; Update the item the ship is about to pick up.
 $AB82 LD ($C279),A    ; The pieces beside the ship are cleared.
 $AB85 LD A,$09        ; #REGa=#N$09.
 $AB87 LD ($F5F7),A    ; Update the flag set when item #N($09) has been picked
                       ; up.
 $AB8A LD A,($A89D)    ; Bit 4 of the sixth map object's flags.
 $AB8D OR %00010000    ; Set the bits of #REGa that are set in #N$10.
 $AB8F LD ($A89D),A    ; Bit 4 of the sixth map object's flags.
 $AB92 LD HL,$F62C     ; The eleventh item site.
 $AB95 SET 7,(HL)      ; Set bit 7 of the byte at the address in #REGhl.
 $AB97 RET             ; Return.

; Test Box Against Ship
;
; Used by the routines at #R$9D0E and #R$AAD7.
; .
; Tests the box at #R$ABA4 against the box in #REGhl and #REGde.
;
;   HL Position of the second box
;   D Width of the second box
;   E Height of the second box
; O:$5C1C Non-zero if the boxes overlap
@label=TestBoxAgainstShip
c$AB98 PUSH IX       ; Stash #REGix on the stack.
 $AB9A LD IX,$ABA4   ; The collision box.
 $AB9E CALL $9DB1    ; Call #R$9DB1.
 $ABA1 POP IX        ; Bring #REGix back off the stack.
 $ABA3 RET           ; Return.

; Collision Box
;
; The box of the object that is being tested for a collision: horizontal
; position, vertical position, width in pixels and height in pixels.
@label=CollisionBox
g$ABA4 DEFB $00,$00,$00,$00

; Check Object Hit By Shot
;
; Used by the routine at #R$AC60.
; .
; Checks whether the object that was drawn has been shot, and if it has
; been destroyed, marks its entry in the map table as destroyed.
;
; IX Address of the object
@label=CheckObjectHitByShot
c$ABA8 BIT 7,(IX+$03) ; {Return if bit 7 of offset #N$03 of #REGix is set.
 $ABAC RET NZ         ; }
 $ABAD LD A,($B832)   ; The special-shot flag.
 $ABB0 AND A          ; {Return if #REGa is zero.
 $ABB1 RET Z          ; }
 $ABB2 BIT 7,(IX+$10) ; {Return if bit 7 of offset #N$10 of #REGix is clear.
 $ABB6 RET Z          ; }
 $ABB7 BIT 3,(IX+$17) ; {Return if bit 3 of offset #N$17 of #REGix is set.
 $ABBB RET NZ         ; }
 $ABBC LD A,(IX+$13)  ; The state.
 $ABBF CP $0B         ; {Return if #REGa is #N$0B.
 $ABC1 RET Z          ; }
 $ABC2 CALL $9143     ; Call #R$9143.
 $ABC5 CALL $B870     ; Call #R$B870.
 $ABC8 CALL $AC29     ; Call #R$AC29.
 $ABCB BIT 3,(IX+$17) ; {Return if bit 3 of offset #N$17 of #REGix is clear.
 $ABCF RET Z          ; }
 $ABD0 LD A,(IX+$18)  ; Read offset #N$18 of #REGix.
 $ABD3 AND %00000001  ; Keep the bits of #REGa that are set in #N$01.
 $ABD5 LD H,A         ; #REGh=#REGa.
 $ABD6 LD L,(IX+$19)  ; Read offset #N$19 of #REGix into #REGl.
 $ABD9 LD DE,$5C94    ; The map table.
 $ABDC ADD HL,DE      ; #REGhl gains #REGde.
 $ABDD SET 7,(HL)     ; Set bit 7 of the byte at the address in #REGhl.
 $ABDF LD A,(IX+$00)  ; The type.
 $ABE2 CP $0D         ; {Return if #REGa is not #N$0D.
 $ABE4 RET NZ         ; }
 $ABE5 LD A,(IX+$13)  ; The state.
 $ABE8 CP $08         ; {Jump to #R$ABF3 if #REGa is less than #N$08.
 $ABEA JR C,$ABF3     ; }
 $ABEC CP $0B         ; {Return if #REGa is #N$0B or more.
 $ABEE RET NC         ; }
 $ABEF LD (IY+$13),A  ; Write the state.
 $ABF2 RET            ; Return.

; Mark Cell Destroyed
;
; Used by the routine at #R$ABA8.
; .
; Sets the bit for the map cell of an object in the bitmap at #R$F5EA
; (found by #R$AC08), unless the item number in #REGa is below #N($06). The
; bit number is written straight into the operand of the SET instruction at
; #R$AC05, so this routine modifies its own code.
;
; A Item number of the object
; IX Address of the object
@label=MarkCellDestroyed
c$ABF3 CP $06        ; {Return if #REGa is less than #N$06.
 $ABF5 RET C         ; }
 $ABF6 LD E,(IX+$01) ; The map column.
 $ABF9 LD D,(IX+$04) ; The map zone.
 $ABFC CALL $AC08    ; Call #R$AC08.
 $ABFF LD A,B        ; #REGa=#REGb.
 $AC00 ADD A,$C6     ; Add #N$C6 to #REGa.
 $AC02 LD ($AC06),A  ; The bit of the map cell.
 $AC05 SET 0,(HL)    ; Set bit 0 of the byte at the address in #REGhl.
 $AC07 RET           ; Return.

; Find Cell Bit
;
; Used by the routines at #R$9BDA and #R$ABF3.
; .
; Finds the byte of the bitmap at #R$F5EA and the bit within it for a
; cell of the planet. Each of the three bytes of the bitmap holds the bits for
; four zones of the map, and each zone has two bits: one for the left half and
; one for the right half.
;
;   D Map zone
;   E Horizontal position
; O:HL Address of the byte
; O:B The bit number multiplied by eight
@label=FindCellBit
c$AC08 LD HL,$F5EA   ; The current player's map cells.
 $AC0B LD A,D        ; #REGa=#REGd.
 $AC0C SUB $01       ; Subtract #N$01 from #REGa.
 $AC0E LD D,A        ; #REGd=#REGa.
 $AC0F AND %00001100 ; Keep the bits of #REGa that are set in #N$0C.
 $AC11 SRL A         ; Shift #REGa right.
 $AC13 SRL A         ; Shift #REGa right.
 $AC15 CALL $9BCF    ; Call #R$9BCF.
 $AC18 LD A,D        ; #REGa=#REGd.
 $AC19 AND %00000011 ; Keep the bits of #REGa that are set in #N$03.
 $AC1B ADD A,A       ; Double #REGa.
 $AC1C ADD A,A       ; Double #REGa.
 $AC1D ADD A,A       ; Double #REGa.
 $AC1E ADD A,A       ; Double #REGa.
 $AC1F LD B,A        ; #REGb=#REGa.
 $AC20 LD A,E        ; #REGa=#REGe.
 $AC21 CP $30        ; {Return if #REGa is less than #N$30.
 $AC23 RET C         ; }
 $AC24 LD A,B        ; #REGa=#REGb.
 $AC25 ADD A,$08     ; Add #N$08 to #REGa.
 $AC27 LD B,A        ; #REGb=#REGa.
 $AC28 RET           ; Return.

; Check Object Against Shots
;
; Used by the routine at #R$ABA8.
; .
; Tests the box at #R$ABA4 against the four objects at #R$B37A by
; entering #R$917C at #R$918B with a count of one.
@label=CheckObjectAgainstShots
c$AC29 PUSH IX       ; Stash #REGix on the stack.
 $AC2B LD IX,$ABA4   ; The collision box.
 $AC2F LD A,$01      ; #REGa=#N$01.
 $AC31 JP $918B      ; Jump to #R$918B.

; Free Object Slot
;
; Used by the routines at #R$882B, #R$89D3, #R$8D29, #R$9724, #R$B752, #R$C1AC,
; #R$E114 and #R$F311.
; .
; Clears the fields of an object slot to zero, then marks the slot as
; free by setting its type to #N($FF).
;
; IX Address of the slot
@label=FreeObjectSlot
c$AC34 CALL $B8FC      ; Call #R$B8FC.
 $AC37 LD (IX+$07),A   ; Write #REGa to offset #N$07 of #REGix.
 $AC3A LD (IX+$08),A   ; Write #REGa to offset #N$08 of #REGix.
 $AC3D LD (IX+$09),A   ; Write #REGa to offset #N$09 of #REGix.
 $AC40 LD (IX+$0A),A   ; Write #REGa to offset #N$0A of #REGix.
 $AC43 LD (IX+$10),A   ; Write #REGa to offset #N$10 of #REGix.
 $AC46 LD (IX+$11),A   ; Write #REGa to offset #N$11 of #REGix.
 $AC49 LD (IX+$12),A   ; Write #REGa to offset #N$12 of #REGix.
 $AC4C LD (IX+$13),A   ; Write #REGa to offset #N$13 of #REGix.
 $AC4F LD (IX+$14),A   ; Write #REGa to offset #N$14 of #REGix.
 $AC52 LD (IX+$15),A   ; Write #REGa to offset #N$15 of #REGix.
 $AC55 LD (IX+$16),A   ; Write #REGa to offset #N$16 of #REGix.
 $AC58 LD (IX+$17),A   ; Write #REGa to offset #N$17 of #REGix.
 $AC5B LD (IX+$00),$FF ; Store #N$FF at offset #N$00 of #REGix.
 $AC5F RET             ; Return.

; Update Map Objects
;
; Used by the routine at #R$DDF8.
; .
; Runs once a frame to look after the six map objects in the slots at
; #R$A80B. For each used slot it erases the old sprite, removes the object if
; it is flagged for removal or lets it move and draws it in its new place,
; sets the attributes under it, and checks whether it has been shot.
@label=UpdateMapObjects
c$AC60 LD A,($5C3C)    ; The scroll-in flag.
 $AC63 AND A           ; {Call #R$9572 if #REGa is zero.
 $AC64 CALL Z,$9572    ; }
 $AC67 LD IX,$A80B     ; The map object slots.
 $AC6B LD B,$06        ; #REGb=#N$06.
@label=UpdateMapObjects_Loop
*$AC6D PUSH BC         ; Stash #REGbc on the stack.
 $AC6E PUSH IX         ; Stash #REGix on the stack.
 $AC70 LD A,(IX+$00)   ; Read offset #N$00 of #REGix.
 $AC73 CP $FF          ; {Jump to #R$ACD2 if #REGa is #N$FF.
 $AC75 JR Z,$ACD2      ; }
 $AC77 BIT 7,(IX+$03)  ; {Jump to #R$AC8A if bit 7 of offset #N$03 of #REGix is
 $AC7B JR NZ,$AC8A     ; set.}
 $AC7D LD A,(IX+$18)   ; Read offset #N$18 of #REGix.
 $AC80 AND %00001110   ; Keep the bits of #REGa that are set in #N$0E.
 $AC82 SRL A           ; Shift #REGa right.
 $AC84 LD ($5C1C),A    ; The bits that fire a shot from the object.
 $AC87 CALL NZ,$8820   ; Call #R$8820 if the zero flag is clear.
@label=UpdateMapObjects_Next2
*$AC8A CALL $A2EA      ; Call #R$A2EA.
 $AC8D BIT 7,(IX+$10)  ; {Call #R$AD27 if bit 7 of offset #N$10 of #REGix is
 $AC91 CALL NZ,$AD27   ; set.}
 $AC94 RES 6,(IX+$10)  ; Reset bit 6 of offset #N$10 of #REGix.
 $AC98 EXX             ; Switch to the alternate registers.
 $AC99 BIT 7,(IX+$15)  ; {Call #R$910A if bit 7 of offset #N$15 of #REGix is
 $AC9D CALL NZ,$910A   ; set.}
 $ACA0 BIT 7,(IX+$03)  ; {Call #R$AAD7 if bit 7 of offset #N$03 of #REGix is
 $ACA4 CALL NZ,$AAD7   ; set.}
 $ACA7 BIT 4,(IX+$10)  ; {Jump to #R$ACB7 if bit 4 of offset #N$10 of #REGix is
 $ACAB JR Z,$ACB7      ; clear.}
 $ACAD LD (IX+$00),$FF ; Store #N$FF at offset #N$00 of #REGix.
 $ACB1 LD (IX+$10),$00 ; Store #N$00 at offset #N$10 of #REGix.
 $ACB5 JR $ACBA        ; Jump to #R$ACBA.
@label=UpdateMapObjects_Move
*$ACB7 CALL $AD48      ; Call #R$AD48.
@label=UpdateMapObjects_Draw
*$ACBA CALL $AD1B      ; Call #R$AD1B.
 $ACBD LD IY,($AD46)   ; Fetch the word at #R$AD46 into #REGiy.
 $ACC1 BIT 7,(IY+$03)  ; {Call #R$ACDD if bit 7 of offset #N$03 of #REGiy is
 $ACC5 CALL Z,$ACDD    ; clear.}
 $ACC8 CALL $AE98      ; Call #R$AE98.
 $ACCB LD IX,($AD46)   ; Fetch the word at #R$AD46 into #REGix.
 $ACCF CALL $ABA8      ; Call #R$ABA8.
@label=UpdateMapObjects_Next
*$ACD2 POP IX          ; Bring #REGix back off the stack.
 $ACD4 LD BC,$001A     ; #REGbc=#N$1A.
 $ACD7 ADD IX,BC       ; #REGix gains #REGbc.
 $ACD9 POP BC          ; Bring #REGbc back off the stack.
 $ACDA DJNZ $AC6D      ; Decrease #REGb and jump to #R$AC6D until none remain.
 $ACDC RET             ; Return.

; Trim Object Sprite
;
; Used by the routine at #R$AC60.
; .
; Used for the object at #REGiy if it is type #N($1B) or has state zero,
; one, three, ten or twelve. Returns if the bottom three bits of the
; vertical position in #R$A1D6 are all set. Otherwise subtracts seven from
; that position and four from the number of rows in #R$A1D8 (and sets the
; number of rows to zero if the new position is below #N($18)).
@label=TrimObjectSprite
c$ACDD LD A,(IY+$00) ; Read offset #N$00 of #REGiy.
 $ACE0 CP $1B        ; {Jump to #R$ACFA if #REGa is #N$1B.
 $ACE2 JR Z,$ACFA    ; }
 $ACE4 LD A,(IY+$13) ; Read offset #N$13 of #REGiy.
 $ACE7 AND %00001111 ; Keep the bits of #REGa that are set in #N$0F.
 $ACE9 JR Z,$ACFA    ; Jump to #R$ACFA if the zero flag is set.
 $ACEB CP $01        ; {Jump to #R$ACFA if #REGa is #N$01.
 $ACED JR Z,$ACFA    ; }
 $ACEF CP $03        ; {Jump to #R$ACFA if #REGa is #N$03.
 $ACF1 JR Z,$ACFA    ; }
 $ACF3 CP $0A        ; {Jump to #R$ACFA if #REGa is #N$0A.
 $ACF5 JR Z,$ACFA    ; }
 $ACF7 CP $0C        ; {Return if #REGa is not #N$0C.
 $ACF9 RET NZ        ; }
@label=TrimObjectSprite_Trim
*$ACFA LD A,($A1D6)  ; The vertical position of the second sprite.
 $ACFD XOR %00000111 ; Flip the bits of #REGa that are set in #N$07.
 $ACFF AND %00000111 ; Keep the bits of #REGa that are set in #N$07.
 $AD01 RET Z         ; Return if the zero flag is set.
 $AD02 LD A,($A1D8)  ; The rows of the second sprite.
 $AD05 SUB $04       ; Subtract #N$04 from #REGa.
 $AD07 LD ($A1D8),A  ; The rows of the second sprite.
 $AD0A LD A,($A1D6)  ; The vertical position of the second sprite.
 $AD0D SUB $07       ; Subtract #N$07 from #REGa.
 $AD0F CP $18        ; {Jump to #R$AD17 if #REGa is #N$18 or more.
 $AD11 JR NC,$AD17   ; }
 $AD13 XOR A         ; Clear #REGa.
 $AD14 LD ($A1D8),A  ; The rows of the second sprite.
@label=TrimObjectSprite_Store
*$AD17 LD ($A1D6),A  ; The vertical position of the second sprite.
 $AD1A RET           ; Return.

; Draw Object
;
; Used by the routines at #R$938D, #R$9507, #R$9572 and #R$AC60.
; .
; Draws the sprite that was set up for an object by #R$AD48, unless both
; the width in #R$A1D7 and the number of rows in #R$A1D8 are zero.
@label=DrawObject
c$AD1B LD A,($A1D7)  ; The rows of the first sprite.
 $AD1E LD C,A        ; #REGc=#REGa.
 $AD1F LD A,($A1D8)  ; The rows of the second sprite.
 $AD22 OR C          ; Set the bits of #REGa that are set in #REGc.
 $AD23 RET Z         ; Return if the zero flag is set.
 $AD24 JP $A303      ; Jump to #R$A303.

; Prepare Erase
;
; Used by the routines at #R$8E21, #R$938D, #R$9572 and #R$AC60.
; .
; Sets up the erasing of the old sprite of an object, from its position
; on the screen at the last frame. Also clears the visible flag of the object
; (bit 7 of offset #N($10)) and keeps the wrap flag (bit 6) in #R$A2FA.
;
; IX Address of the object
@label=PrepareErase
c$AD27 CALL $ADBE     ; Call #R$ADBE.
 $AD2A LD L,(IX+$11)  ; The horizontal screen position.
 $AD2D LD H,(IX+$12)  ; The vertical screen position.
 $AD30 LD ($A1D3),HL  ; Update the sprite positions.
 $AD33 CALL $A1EA     ; Call #R$A1EA.
 $AD36 CALL $A234     ; Call #R$A234.
 $AD39 RES 7,(IX+$10) ; Reset bit 7 of offset #N$10 of #REGix.
 $AD3D LD A,(IX+$10)  ; The flags.
 $AD40 AND %01000000  ; Keep the bits of #REGa that are set in #N$40.
 $AD42 LD ($A2FA),A   ; The wrap flag.
 $AD45 RET            ; Return.

; Current Object
;
; The address of the object that is being drawn.
@label=CurrentObject
b$AD46 DEFW $0000

; Prepare Draw
;
; Used by the routines at #R$90EC, #R$938D and #R$AC60.
; .
; Sets up the drawing of the new sprite of an object. Finds the sprite
; from its type and state, and its position on the screen (which frees the
; slot if it is off screen). If the object is exploding (bit 3 of offset
; #N($17)), the explosion count in the bottom three bits is increased and
; the slot is freed when it reaches eight; the count is also used as the
; dissolve step in #N$A302. The attribute of the sprite is taken from offset
; #N($0D), which holds two colours; the choice between them depends on bit 0
; of the frame counter at #R$9A64.
;
; IX Address of the object
@label=PrepareDraw
c$AD48 LD ($AD46),IX   ; Update the current object.
 $AD4C XOR A           ; Clear #REGa.
 $AD4D LD ($A302),A    ; No dissolve yet.
 $AD50 CALL $ADBE      ; Call #R$ADBE.
 $AD53 PUSH DE         ; Stash #REGde on the stack.
 $AD54 CALL $ADD8      ; Call #R$ADD8.
 $AD57 POP DE          ; Bring #REGde back off the stack.
 $AD58 BIT 3,(IX+$17)  ; {Jump to #R$AD84 if bit 3 of offset #N$17 of #REGix is
 $AD5C JR Z,$AD84      ; clear.}
 $AD5E LD A,(IX+$17)   ; The second set of flags.
 $AD61 AND %00000111   ; Keep the bits of #REGa that are set in #N$07.
 $AD63 INC A           ; Advance #REGa.
 $AD64 LD B,A          ; #REGb=#REGa.
 $AD65 CP $08          ; {Jump to #R$AD73 if #REGa is not #N$08.
 $AD67 JR NZ,$AD73     ; }
 $AD69 LD (IX+$00),$FF ; Store #N$FF at offset #N$00 of #REGix.
 $AD6D RES 7,(IX+$10)  ; Reset bit 7 of offset #N$10 of #REGix.
 $AD71 JR $AD84        ; Jump to #R$AD84.
@label=PrepareDraw_Attributes
*$AD73 LD A,(IX+$17)   ; The second set of flags.
 $AD76 AND %11110000   ; Keep the bits of #REGa that are set in #N$F0.
 $AD78 OR B            ; Set the bits of #REGa that are set in #REGb.
 $AD79 OR %00001000    ; Set the bits of #REGa that are set in #N$08.
 $AD7B LD (IX+$17),A   ; Write the second set of flags.
 $AD7E LD A,B          ; #REGa=#REGb.
 $AD7F OR %10000000    ; Set the bits of #REGa that are set in #N$80.
 $AD81 LD ($A302),A    ; The dissolve step of the explosion.
@label=PrepareDraw_Colour
*$AD84 LD A,(IX+$10)   ; The flags.
 $AD87 LD ($5C31),A    ; Update the contact flags.
 $AD8A BIT 7,A         ; {Return if bit 7 of #REGa is clear.
 $AD8C RET Z           ; }
 $AD8D LD C,(IX+$0D)   ; The attribute.
 $AD90 LD A,($9A64)    ; The frame counter.
 $AD93 AND %00000001   ; Keep the bits of #REGa that are set in #N$01.
 $AD95 JR Z,$ADA3      ; Jump to #R$ADA3 if the zero flag is set.
 $AD97 LD A,C          ; #REGa=#REGc.
 $AD98 AND %00001000   ; Keep the bits of #REGa that are set in #N$08.
 $AD9A ADD A,A         ; Double #REGa.
 $AD9B ADD A,A         ; Double #REGa.
 $AD9C ADD A,A         ; Double #REGa.
 $AD9D LD B,A          ; #REGb=#REGa.
 $AD9E LD A,C          ; #REGa=#REGc.
 $AD9F AND %00000111   ; Keep the bits of #REGa that are set in #N$07.
 $ADA1 JR $ADB4        ; Jump to #R$ADB4.
@label=PrepareDraw_Colour2
*$ADA3 LD A,C          ; #REGa=#REGc.
 $ADA4 AND %01110000   ; Keep the bits of #REGa that are set in #N$70.
 $ADA6 SRL A           ; Shift #REGa right.
 $ADA8 SRL A           ; Shift #REGa right.
 $ADAA SRL A           ; Shift #REGa right.
 $ADAC SRL A           ; Shift #REGa right.
 $ADAE LD B,A          ; #REGb=#REGa.
 $ADAF LD A,C          ; #REGa=#REGc.
 $ADB0 AND %10000000   ; Keep the bits of #REGa that are set in #N$80.
 $ADB2 SRL A           ; Shift #REGa right.
@label=PrepareDraw_Attribute
*$ADB4 OR B            ; Set the bits of #REGa that are set in #REGb.
 $ADB5 LD ($AF03),A    ; The attribute of the sprite.
 $ADB8 CALL $A1D9      ; Call #R$A1D9.
 $ADBB JP $A247        ; Jump to #R$A247.

; Fetch Frame Sprite
;
; Used by the routines at #R$A8F4, #R$AD27 and #R$AD48.
; .
; Finds the address of the sprite for the state of an object. The type
; is used as an index into the table at #R$AF3D, which gives the address of a
; table of sprites for the type; the bottom four bits of offset #N($13) are
; the index into that table.
;
;   IX Address of the object
; O:DE Address of the sprite
@label=FetchFrameSprite
c$ADBE LD C,(IX+$00) ; The type.
 $ADC1 LD B,$00      ; Clear #REGb.
 $ADC3 LD HL,$AF3D   ; The frame table addresses.
 $ADC6 ADD HL,BC     ; #REGhl gains #REGbc.
 $ADC7 ADD HL,BC     ; #REGhl gains #REGbc.
 $ADC8 LD A,(HL)     ; Read #REGhl.
 $ADC9 INC HL        ; Advance #REGhl.
 $ADCA LD H,(HL)     ; Read #REGhl into #REGh.
 $ADCB LD L,A        ; #REGl=#REGa.
 $ADCC LD A,(IX+$13) ; The state.
 $ADCF AND %00001111 ; Keep the bits of #REGa that are set in #N$0F.
 $ADD1 LD C,A        ; #REGc=#REGa.
 $ADD2 ADD HL,BC     ; #REGhl gains #REGbc.
 $ADD3 ADD HL,BC     ; #REGhl gains #REGbc.
 $ADD4 LD E,(HL)     ; Read #REGhl into #REGe.
 $ADD5 INC HL        ; Advance #REGhl.
 $ADD6 LD D,(HL)     ; Read #REGhl into #REGd.
 $ADD7 RET           ; Return.

; Find Object Screen Position
;
; Used by the routines at #R$89D3 and #R$AD48.
; .
; Works out where an object is on the screen from its position on the
; planet and the position of the part of the planet that is on the screen. If
; the object is off the screen, its slot is freed. Otherwise the horizontal
; and vertical screen positions are stored at offsets #N($11) and #N($12), and
; the object is flagged as visible with bit 7 of offset #N($10). The wrap
; flag (bit 6 of offset #N($10)) is set if the object has crossed the edge of
; the part of the planet that is on the screen.
;
; DE Address of the sprite
; IX Address of the object
@label=FindObjectScreenPosition
c$ADD8 LD A,(DE)       ; Read #REGde.
 $ADD9 ADD A,A         ; Double #REGa.
 $ADDA ADD A,A         ; Double #REGa.
 $ADDB ADD A,A         ; Double #REGa.
 $ADDC LD B,A          ; #REGb=#REGa.
 $ADDD INC DE          ; Advance #REGde.
 $ADDE LD A,(DE)       ; Read #REGde.
 $ADDF LD C,A          ; #REGc=#REGa.
 $ADE0 LD A,($CE45)    ; The position across.
 $ADE3 LD E,A          ; #REGe=#REGa.
 $ADE4 LD A,(IX+$02)   ; The horizontal position.
 $ADE7 AND %11111110   ; Keep the bits of #REGa that are set in #N$FE.
 $ADE9 LD L,A          ; #REGl=#REGa.
 $ADEA LD A,($DDF7)    ; The next column.
 $ADED CP (IX+$01)     ; {Jump to #R$AE56 if #REGa is the byte at offset #N$01
 $ADF0 JP Z,$AE56      ; of #REGix.}
 $ADF3 LD A,($CE57)    ; The map position.
 $ADF6 CP (IX+$01)     ; {Jump to #R$AE19 if #REGa is the byte at offset #N$01
 $ADF9 JR Z,$AE19      ; of #REGix.}
 $ADFB LD A,($A1D7)    ; The rows of the sprite that was drawn.
 $ADFE AND A           ; {Jump to #R$AE93 if #REGa is zero.
 $ADFF JP Z,$AE93      ; }
 $AE02 LD A,L          ; #REGa=#REGl.
 $AE03 ADD A,$17       ; Add #N$17 to #REGa.
 $AE05 ADD A,B         ; #REGa gains #REGb.
 $AE06 JP NC,$AE93     ; Jump to #R$AE93 if the carry flag is clear.
 $AE09 LD A,(IX+$02)   ; The horizontal position.
 $AE0C CP $80          ; {Jump to #R$AE93 if #REGa is less than #N$80.
 $AE0E JP C,$AE93      ; }
 $AE11 LD A,E          ; #REGa=#REGe.
 $AE12 ADD A,$B0       ; Add #N$B0 to #REGa.
 $AE14 LD E,A          ; #REGe=#REGa.
 $AE15 LD A,L          ; #REGa=#REGl.
 $AE16 SUB $30         ; Subtract #N$30 from #REGa.
 $AE18 LD L,A          ; #REGl=#REGa.
@label=FindObjectScreenPosition_Wrap
*$AE19 LD A,L          ; #REGa=#REGl.
 $AE1A CP E            ; {Jump to #R$AE32 if #REGa is #REGe or more.
 $AE1B JR NC,$AE32     ; }
 $AE1D ADD A,B         ; #REGa gains #REGb.
 $AE1E JR C,$AE23      ; Jump to #R$AE23 if the carry flag is set.
 $AE20 DEC A           ; Step #REGa back.
 $AE21 CP E            ; {Return if #REGa is less than #REGe.
 $AE22 RET C           ; }
@label=FindObjectScreenPosition_Row
*$AE23 LD A,E          ; #REGa=#REGe.
 $AE24 SUB L           ; Subtract #REGl from #REGa.
 $AE25 SUB $09         ; Subtract #N$09 from #REGa.
 $AE27 JR C,$AE32      ; Jump to #R$AE32 if the carry flag is set.
 $AE29 SET 6,(IX+$10)  ; Set bit 6 of offset #N$10 of #REGix.
 $AE2D LD A,$01        ; #REGa=#N$01.
 $AE2F LD ($A2FA),A    ; The sprite reaches past the right of the screen.
@label=FindObjectScreenPosition_Horizontal
*$AE32 LD A,($CE57)    ; The map position.
 $AE35 CP (IX+$01)     ; {Jump to #R$AE49 if #REGa is the byte at offset #N$01
 $AE38 JR Z,$AE49      ; of #REGix.}
 $AE3A LD A,($DDF7)    ; The next column.
 $AE3D CP (IX+$01)     ; {Jump to #R$AE49 if #REGa is the byte at offset #N$01
 $AE40 JR Z,$AE49      ; of #REGix.}
 $AE42 LD A,L          ; #REGa=#REGl.
 $AE43 SUB E           ; Subtract #REGe from #REGa.
 $AE44 ADD A,$08       ; Add #N$08 to #REGa.
 $AE46 LD L,A          ; #REGl=#REGa.
 $AE47 JR $AE4D        ; Jump to #R$AE4D.
@label=FindObjectScreenPosition_Same
*$AE49 LD A,($CE41)    ; The horizontal offset.
 $AE4C ADD A,L         ; #REGa gains #REGl.
@label=FindObjectScreenPosition_StoreX
*$AE4D LD ($A1D5),A    ; The horizontal screen position.
 $AE50 LD (IX+$11),A   ; Write the horizontal screen position.
 $AE53 JP $AE5E        ; Jump to #R$AE5E.
@label=FindObjectScreenPosition_Edge
*$AE56 LD A,L          ; #REGa=#REGl.
 $AE57 CP E            ; {Return if #REGa is #REGe or more.
 $AE58 RET NC          ; }
 $AE59 ADD A,$E0       ; Add #N$E0 to #REGa.
 $AE5B LD L,A          ; #REGl=#REGa.
 $AE5C JR $AE32        ; Jump to #R$AE32.
@label=FindObjectScreenPosition_Vertical
*$AE5E LD L,(IX+$05)   ; The vertical position.
 $AE61 LD A,($CE46)    ; The position down.
 $AE64 LD E,A          ; #REGe=#REGa.
 $AE65 LD A,($CE58)    ; The map row.
 $AE68 CP (IX+$04)     ; {Jump to #R$AE83 if #REGa is not the byte at offset #N$04 of
 $AE6B JR NZ,$AE83     ; #REGix.}
 $AE6D LD A,L          ; #REGa=#REGl.
 $AE6E DEC A           ; Step #REGa back.
 $AE6F CP E            ; {Return if #REGa is less than #REGe.
 $AE70 RET C           ; }
 $AE71 ADD A,$61       ; Add #N$61 to #REGa.
 $AE73 LD L,A          ; #REGl=#REGa.
@label=FindObjectScreenPosition_StoreY
*$AE74 LD A,($CE42)    ; The vertical offset.
 $AE77 ADD A,L         ; #REGa gains #REGl.
 $AE78 LD ($A1D6),A    ; The vertical screen position.
 $AE7B LD (IX+$12),A   ; Write the vertical screen position.
 $AE7E SET 7,(IX+$10)  ; Set bit 7 of offset #N$10 of #REGix.
 $AE82 RET             ; Return.
@label=FindObjectScreenPosition_NextZone
*$AE83 INC A           ; Advance #REGa.
 $AE84 CP (IX+$04)     ; {Jump to #R$AE93 if #REGa is not the byte at offset #N$04 of
 $AE87 JP NZ,$AE93     ; #REGix.}
 $AE8A LD A,L          ; #REGa=#REGl.
 $AE8B SUB C           ; Subtract #REGc from #REGa.
 $AE8C JR C,$AE74      ; Jump to #R$AE74 if the carry flag is set.
 $AE8E CP E            ; {Return if #REGa is #REGe or more.
 $AE8F RET NC          ; }
 $AE90 JP $AE74        ; Jump to #R$AE74.
@label=FindObjectScreenPosition_Free
*$AE93 LD (IX+$00),$FF ; Store #N$FF at offset #N$00 of #REGix.
 $AE97 RET             ; Return.

; Set Object Attributes
;
; Used by the routines at #R$938D, #R$9507, #R$9572 and #R$AC60.
; .
; Works out the area of attribute cells that is covered by the sprite
; that has just been drawn, as a width and height in cells, and fills it with
; the attribute at #R$AF03 by calling #R$C991.
@label=SetObjectAttributes
c$AE98 LD A,($A1D8)  ; The rows of the sprite.
 $AE9B DEC A         ; Step #REGa back.
 $AE9C RET M         ; Return if the sign flag is set.
 $AE9D LD D,A        ; #REGd=#REGa.
 $AE9E LD HL,($A1D5) ; Fetch the word at #R$A1D5 into #REGhl.
 $AEA1 LD A,($5C29)  ; The width of the sprite in bytes.
 $AEA4 LD B,A        ; #REGb=#REGa.
 $AEA5 LD A,($A2FA)  ; The sprite reaches past the right of the screen.
 $AEA8 AND A         ; {Jump to #R$AEB3 if #REGa is zero.
 $AEA9 JR Z,$AEB3    ; }
 $AEAB LD A,L        ; #REGa=#REGl.
 $AEAC ADD A,B       ; #REGa gains #REGb.
 $AEAD SUB $A4       ; Subtract #N$A4 from #REGa.
 $AEAF LD L,$08      ; #REGl=#N$08.
 $AEB1 JR $AED6      ; Jump to #R$AED6.
@label=SetObjectAttributes_Width
*$AEB3 LD A,L        ; #REGa=#REGl.
 $AEB4 CP $08        ; {Jump to #R$AEBF if #REGa is #N$08 or more.
 $AEB6 JR NC,$AEBF   ; }
 $AEB8 ADD A,$08     ; Add #N$08 to #REGa.
 $AEBA LD L,A        ; #REGl=#REGa.
 $AEBB LD A,B        ; #REGa=#REGb.
 $AEBC SUB $08       ; Subtract #N$08 from #REGa.
 $AEBE LD B,A        ; #REGb=#REGa.
@label=SetObjectAttributes_Right
*$AEBF LD A,L        ; #REGa=#REGl.
 $AEC0 ADD A,$17     ; Add #N$17 to #REGa.
 $AEC2 ADD A,B       ; #REGa gains #REGb.
 $AEC3 JR NC,$AECA   ; Jump to #R$AECA if the carry flag is clear.
 $AEC5 LD A,$EE      ; #REGa=#N$EE.
 $AEC7 SUB L         ; Subtract #REGl from #REGa.
 $AEC8 JR $AED6      ; Jump to #R$AED6.
@label=SetObjectAttributes_Aligned
*$AECA LD A,L        ; #REGa=#REGl.
 $AECB AND %00000111 ; Keep the bits of #REGa that are set in #N$07.
 $AECD JR Z,$AED3    ; Jump to #R$AED3 if the zero flag is set.
 $AECF LD A,B        ; #REGa=#REGb.
 $AED0 ADD A,$08     ; Add #N$08 to #REGa.
 $AED2 LD B,A        ; #REGb=#REGa.
; This entry point is used by the routine at #R$B5B5.
@label=SetObjectAttributes_Sum
*$AED3 LD A,L        ; #REGa=#REGl.
 $AED4 ADD A,B       ; #REGa gains #REGb.
 $AED5 SUB L         ; Subtract #REGl from #REGa.
@label=SetObjectAttributes_Cells
*$AED6 SRL A         ; Shift #REGa right.
 $AED8 SRL A         ; Shift #REGa right.
 $AEDA SRL A         ; Shift #REGa right.
 $AEDC LD ($AF01),A  ; Update the attribute area.
 $AEDF DEC A         ; Step #REGa back.
 $AEE0 RET M         ; Return if the sign flag is set.
; This entry point is used by the routine at #R$AF04.
@label=SetObjectAttributes_Height
*$AEE1 LD A,H        ; #REGa=#REGh.
 $AEE2 SUB D         ; Subtract #REGd from #REGa.
 $AEE3 SUB $07       ; Subtract #N$07 from #REGa.
 $AEE5 LD E,A        ; #REGe=#REGa.
 $AEE6 CP $17        ; {Jump to #R$AEEC if #REGa is #N$17 or more.
 $AEE8 JR NC,$AEEC   ; }
 $AEEA LD E,$17      ; #REGe=#N$17.
@label=SetObjectAttributes_Rows
*$AEEC LD A,H        ; #REGa=#REGh.
 $AEED OR %00000111  ; Set the bits of #REGa that are set in #N$07.
 $AEEF SUB E         ; Subtract #REGe from #REGa.
 $AEF0 SRL A         ; Shift #REGa right.
 $AEF2 SRL A         ; Shift #REGa right.
 $AEF4 SRL A         ; Shift #REGa right.
 $AEF6 LD ($AF02),A  ; The height of the attribute area.
 $AEF9 DEC A         ; Step #REGa back.
 $AEFA RET M         ; Return if the sign flag is set.
 $AEFB LD DE,$AF01   ; The attribute area.
 $AEFE JP $C991      ; Jump to #R$C991.

; Attribute Area
;
; The width in cells, the height in cells and the attribute of the area
; to fill, as used by #R$C991.
@label=AttributeArea
g$AF01 DEFB $00
 $AF02 DEFB $00
 $AF03 DEFB $00

; Set Pair Attributes
;
; Used by the routine at #R$C1CE.
; .
; Sets the attributes of the two sprites at #R$C27B and #R$C27D (which
; are #N5 and #N3 cells wide) to bright white, by filling the area under each
; one in the same way as #R$AE98.
@label=SetPairAttributes
c$AF04 LD A,$47      ; #REGa=#N$47.
 $AF06 LD ($AF03),A  ; The pieces are bright white.
 $AF09 LD HL,($C27B) ; Fetch the word at #R$C27B into #REGhl.
 $AF0C LD B,$23      ; #REGb=#N$23.
 $AF0E LD A,$05      ; #REGa=#N$05.
 $AF10 CALL $AF1A    ; Call #R$AF1A.
 $AF13 LD HL,($C27D) ; Fetch the word at #R$C27D into #REGhl.
 $AF16 LD B,$2F      ; #REGb=#N$2F.
 $AF18 LD A,$03      ; #REGa=#N$03.
@label=SetPairAttributes_Second
*$AF1A LD ($AF01),A  ; Update the attribute area.
 $AF1D LD A,B        ; #REGa=#REGb.
 $AF1E CALL $C331    ; Call #R$C331.
 $AF21 LD D,B        ; #REGd=#REGb.
 $AF22 JP $AEE1      ; Jump to #R$AEE1.

; Object Handlers
;
; The routines that #R$A18D jumps to for the objects of types #N($13)
; to #N($1E). The entry for type #N($1B) is never used.
@label=ObjectHandlers
w$AF25 DEFW $93F2
 $AF27 DEFW $9507
 $AF29 DEFW $96D8
 $AF2B DEFW $9507
 $AF2D DEFW $9507
 $AF2F DEFW $9507
 $AF31 DEFW $94A8
 $AF33 DEFW $9507
 $AF35 DEFW $AFCB
 $AF37 DEFW $9457
 $AF39 DEFW $9494
 $AF3B DEFW $9524

; Frame Table Addresses
;
; The address of the table of sprites for each type of object, from type
; #N$00 to type #N($1E); used by #R$A19F and #R$ADBE. The table for the
; object is indexed by the bottom four bits of offset #N($13) of the object.
@label=FrameTableAddresses
w$AF3D DEFW $B936
 $AF3F DEFW $C7C8
 $AF41 DEFW $C7D2
 $AF43 DEFW $C7DC
 $AF45 DEFW $C7E5
 $AF47 DEFW $C7ED
 $AF49 DEFW $C7F4
 $AF4B DEFW $C190
 $AF4D DEFW $C193
 $AF4F DEFW $C196
 $AF51 DEFW $C19A
 $AF53 DEFW $C19E
 $AF55 DEFW $AF95
 $AF57 DEFW $AFAB
 $AF59 DEFW $7846
 $AF5B DEFW $7867
 $AF5D DEFW $7886
 $AF5F DEFW $78A3
 $AF61 DEFW $78E4
 $AF63 DEFW $98BE
 $AF65 DEFW $AF8D
 $AF67 DEFW $9894
 $AF69 DEFW $98A0
 $AF6B DEFW $98A8
 $AF6D DEFW $98AC
 $AF6F DEFW $98B4
 $AF71 DEFW $98B8
 $AF73 DEFW $AFCB
 $AF75 DEFW $98C2
 $AF77 DEFW $98FA
 $AF79 DEFW $AF7B

; Sprite Tables
;
; Tables of the addresses of sprites. The first is indexed by the item
; that is carried and is also the table for type #N($1E). The tables for
; types #N($14), #N($0C), #N($0D) and #N($1B) overlap it, and follow it.
@label=SpriteTables
w$AF7B DEFW $731F
 $AF7D DEFW $7339
 $AF7F DEFW $7353
 $AF81 DEFW $7388
 $AF83 DEFW $73BA
 $AF85 DEFW $73DC
 $AF87 DEFW $76E9
 $AF89 DEFW $73FE
 $AF8B DEFW $7745
 $AF8D DEFW $79F4
 $AF8F DEFW $7A29
 $AF91 DEFW $7A5E
 $AF93 DEFW $7A29
@label=SpriteTables_ShipParts
 $AF95 DEFW $7685
 $AF97 DEFW $76B7
 $AF99 DEFW $76E9
 $AF9B DEFW $75EF
 $AF9D DEFW $762A
 $AF9F DEFW $758A
 $AFA1 DEFW $75D8
 $AFA3 DEFW $7577
 $AFA5 DEFW $75B1
 $AFA7 DEFW $7436
 $AFA9 DEFW $74E7
 $AFAB DEFW $777D
 $AFAD DEFW $77E8
 $AFAF DEFW $8133
 $AFB1 DEFW $7905
 $AFB3 DEFW $81D9
 $AFB5 DEFW $8199
 $AFB7 DEFW $810A
 $AFB9 DEFW $7E6A
 $AFBB DEFW $8073
 $AFBD DEFW $7E17
 $AFBF DEFW $80C6
 $AFC1 DEFW $8303
 $AFC3 DEFW $8199
 $AFC5 DEFW $82B1
 $AFC7 DEFW $821D
 $AFC9 DEFW $82B1
 $AFCB DEFW $81D9
 $AFCD DEFW $81FB
 $AFCF DEFW $8199
 $AFD1 DEFW $81B9
 $AFD3 DEFW $821D
 $AFD5 DEFW $8267
@label=SpriteTables_ShipPartPositions
 $AFD7 DEFW $F6D7
 $AFD9 DEFW $F6DB
 $AFDB DEFW $F6BA
 $AFDD DEFW $F749
 $AFDF DEFW $F72C
 $AFE1 DEFW $F74A
