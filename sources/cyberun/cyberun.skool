; Contact Flag
;
; Cleared by #R$D729, which sets it when the terrain was touched in a
; way that stops the horizontal speed, and tests it again at the end. Other
; routines also use it.
@label=ContactFlag
g$5C1A DEFB $00

; Not Used
s$5C1B DEFS $01

; Scratch Value
;
; One of the values that many routines use for temporary results. The
; terrain drawing routines keep a screen column in it, for #R$D8DA.
@label=ScratchValue
g$5C1C DEFB $01

; Tile Number
;
; Which of the four tiles in view is being drawn, from #N$00 to #N$03: bit
; 0 is set for a tile below the first and bit 1 for a tile to the right. #R$D0BD
; sets it. Other routines use it to count tiles that an object overlaps, and
; for temporary values.
@label=TileNumber
g$5C1D DEFB $00

; Scratch Values
;
; Two more of the values that many routines use for temporary results.
@label=ScratchPair
g$5C1E DEFB $00
 $5C1F DEFB $00

; Segments Left
;
; The number of segments of the script of the current tile that are not
; drawn yet, which #R$D0BD sets from the script. Other routines use it for
; temporary values.
@label=SegmentsLeft
g$5C20 DEFB $00

; Not Used
s$5C21 DEFS $01

; Segment Length
;
; The number of steps in the current segment, from #N$01 to #N$10. #R$D0BD
; reads it from the script.
@label=SegmentLength
g$5C22 DEFB $00

; Not Used
s$5C23 DEFS $01

; Column Step Size
;
; The column step of the type of the current segment without its sign,
; set by #R$CD08. Also used by #R$8347.
@label=ColumnStepSize
g$5C24 DEFB $00

; Horizontal Step Size
;
; The horizontal step of the type of the current segment without its
; sign, set by #R$CD08. #R$C374 sets it to #N$FF while the ship is tested
; against the terrain, and #R$90A7 sets it to #N$80 when an object should stop.
@label=HorizontalStepSize
g$5C25 DEFB $00

; Upside Down Flag
;
; Set to #N($99) when the current tile is drawn upside down and to zero
; when it is not, by #R$D0BD.
@label=UpsideDownFlag
g$5C26 DEFB $00

; Shape Flag
;
; Cleared at the start of each segment. #R$D588 stores a shape code in it
; for a segment that goes the way that the horizontal speed does and that
; starts at the edge of a cell, and #R$D8DA tests it.
@label=ShapeFlag
g$5C27 DEFB $00

; Scratch Values
;
; Four more of the values that many routines use for temporary results.
@label=ScratchQuad
g$5C28 DEFB $00
 $5C29 DEFB $00
 $5C2A DEFB $00
 $5C2B DEFB $00

; Segment Screen Column
;
; The pixel column of the current step of a segment on the screen, found
; by #R$D937 and moved on by #R$D319. Other routines use it for the position of
; an object.
@label=SegmentScreenColumn
g$5C2C DEFB $00

; Segment Screen Row
;
; The pixel row of the current step of a segment on the screen, found by
; #R$D937 and moved on by #R$D319. Other routines use it for the position of an
; object.
@label=SegmentScreenRow
g$5C2D DEFB $00

; Piece Column
;
; The column where the next piece of a sloped segment starts in its row,
; set by #R$D3D2 and read by #R$DBB7. Other routines use the two bytes from
; here as a word.
@label=PieceColumn
g$5C2E DEFB $00

; Flagged Steps
;
; The number of steps of the current segment that have been flagged: it is
; cleared at the start of each segment and increased by #R$D716.
@label=FlaggedSteps
g$5C2F DEFB $00

; Back To Front Flag
;
; Set to #N($FF) when the current tile is drawn back to front and to zero
; when it is not, by #R$D0BD. Other routines use the two bytes from here as a
; word.
@label=BackToFrontFlag
g$5C30 DEFB $00

; Contact Flags
;
; Cleared by #R$D33D for each step of a segment. #R$CE79 and #R$CE97 set
; bit 7, and then bit 0 or bit 1 instead; #R$CEB5 sets bit 3 and #R$CEC8
; sets bit 2. #R$D3B0 chooses what to do from the result.
@label=ContactFlags
g$5C31 DEFB $00

; Last Contact Flags
;
; A copy of the flags at #R$5C31 that #R$CE79 and #R$CE97 make when they
; set bit 0 or bit 1, cleared at the start of each segment. #R$D9A8 tests it.
@label=LastContactFlags
g$5C32 DEFB $00

; Start Shape
;
; The shape code for the start of a flat segment, read from the script by
; #R$CD6B and changed when the tile is back to front or upside down.
@label=StartShape
g$5C33 DEFB $00

; End Shape
;
; The shape code for the end of a flat segment, read from the script by
; #R$CD6B and changed when the tile is back to front or upside down.
@label=EndShape
g$5C34 DEFB $00

; Upside Down Segment
;
; Set to #N($80) by #R$E3D8 when the current segment is upside down, and
; cleared at the start of each segment. #R$BA21 also uses it as the collision
; status: #N$80 once a rectangle has been hit, bit 6 after a vertical bounce,
; and bit 4 after a slope has been hit.
@label=UpsideDownSegment
g$5C35 DEFB $00

; Scratch Value
;
; Cleared at the start of #R$B234. Left stores #N($80) here and right
; stores #N($03), and #R$C374 compares bit 7 with the facing of the ship.
@label=ControlScratch
g$5C36 DEFB $C0

; Controls
;
; What is pressed on the keyboard or joystick, set by #R$B115 (bit 0 is
; right, bit 1 is left, bit 3 is up, bit 4 is fire and bit 5 is the extra key).
@label=Controls
g$5C37 DEFB $03

; Ship Row
;
; A vertical position that #R$AFE9 works out from the height of the ship
; and that other routines compare with the positions of objects. Also used for
; the step of the shots.
@label=ShipRow
g$5C38 DEFB $04

; Scratch Value
;
; The number of frames before the ship can fire again. #R$B734
; stores #N$06 when the ship fires and counts it down, and returns
; while it is not zero.
@label=ShotScratch
g$5C39 DEFB $F0

; Top Tile Colour
;
; The attribute value for the terrain of a tile on the top row, set by
; #R$DEE1 and used by #R$CF38.
@label=TopTileColour
g$5C3A DEFB $DF

; Bottom Tile Colour
;
; The attribute value for the terrain of a tile on the bottom row, set by
; #R$DEE1 and used by #R$CF38.
@label=BottomTileColour
g$5C3B DEFB $0C

; Scroll In Flag
;
; Not zero while the world scrolls in at the start of a life: #N($FF)
; at first and #N$03 once the ground has been found (see #R$DD79). While it is
; set #R$D0BD treats all of the tiles as changed and #R$CF38 does not colour
; them.
@label=ScrollInFlag
g$5C3C DEFB $D0

; Tiles Changed
;
; The number of times that the map position moved in the frame, set by
; #R$DDF8 (and set by #R$D0BD when #R$5C3C is not zero). When it is not zero
; #R$D0BD makes the records of the segments of the tiles again.
@label=TilesChanged
g$5C3D DEFB $DF

; Horizontal Limit
;
; Two normally, and four when the flag at #R$F5F1 is set.
; #R$AFE9 sets it.
@label=HorizontalLimit
g$5C3E DEFB $05

; Vertical Limit
;
; Two normally, and four when the flag at #R$F5F2 is set. #R$AFE9
; sets it. It is
; the limit of the vertical scroll speed, used by #R$B2D5.
@label=VerticalLimit
g$5C3F DEFB $00

