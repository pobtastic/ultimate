@label=TitleFrameParameters
g$F22A DEFW $57C0    ; Left vertical line
 $F22C DEFW $57DF    ; Right vertical line
 $F22E DEFB $B0      ; Number of rows in the vertical lines
 $F22F DEFW $56E1    ; Bottom horizontal lines
 $F231 DEFW $4601    ; Top horizontal lines
 $F233 DEFW $0000    ; Address of the corner table (set by #R$F26C)
 $F235 DEFB $06      ; Number of ticks along each edge
 $F236 DEFW $0000    ; Address of the tick table (set by #R$F26C)
 $F238 DEFB $06      ; Pixel row of the top edge
 $F239 DEFB $F8      ; Pixel column of the right edge
 $F23A DEFB $1F      ; Length of the horizontal lines, in bytes

; Get Random Numbers
;
; Used by the routines at #R$6113, #R$8615 and #R$F46C.
; .
; Makes two new random numbers at #R$9BCB, using a pointer to a byte of
; memory that is moved on one place each time and stays below #N($B000). The
; byte that it points to is added to each number, together with the value of
; the value of the controls (see #R$B115), so pressing the controls at
; different times changes the numbers.
@label=RandomNumber
c$F23B LD IX,$9BCB    ; The random numbers.
 $F23F LD H,(IX+$02)  ; Read offset #N$02 of #REGix into #REGh.
 $F242 LD L,(IX+$03)  ; Read offset #N$03 of #REGix into #REGl.
 $F245 INC HL         ; Advance #REGhl.
 $F246 LD A,H         ; #REGa=#REGh.
 $F247 AND %10101111  ; Keep the bits of #REGa that are set in #N$AF.
 $F249 LD (IX+$02),A  ; Write #REGa to offset #N$02 of #REGix.
 $F24C LD (IX+$03),L  ; Write #REGl to offset #N$03 of #REGix.
 $F24F LD B,(HL)      ; Read #REGhl into #REGb.
 $F250 LD A,($5C37)   ; The controls.
 $F253 ADD A,B        ; #REGa gains #REGb.
 $F254 ADD A,$05      ; Add #N$05 to #REGa.
 $F256 ADD A,(IX+$00) ; Add the byte at offset #N$00 of #REGix to #REGa.
 $F259 LD (IX+$00),A  ; Write #REGa to offset #N$00 of #REGix.
 $F25C LD A,B         ; #REGa=#REGb.
 $F25D CPL            ; Invert #REGa.
 $F25E LD B,A         ; #REGb=#REGa.
 $F25F LD A,($5C37)   ; The controls.
 $F262 ADD A,$09      ; Add #N$09 to #REGa.
 $F264 ADD A,B        ; #REGa gains #REGb.
 $F265 ADD A,(IX+$01) ; Add the byte at offset #N$01 of #REGix to #REGa.
 $F268 LD (IX+$01),A  ; Write #REGa to offset #N$01 of #REGix.
 $F26B RET            ; Return.

; Show Title Screen
;
; Used by the routine at #R$F422.
; .
; Draws the title screen, with a frame, the title text and two small
; graphics, and shows the control icons and the options with #R$8690 and
; #R$8652. A tune plays until a key is pressed and then the menu runs with
; #R$8615. When it has finished, the options are shown again and a short tune
; plays.
; .
; #HTML(#AUDIO0(title-tune.wav)(#INCLUDE(TitleTune)))
; #HTML(#AUDIO0(game-start-tune.wav)(#INCLUDE(GameStartTune)))
; #PUSHS #UDGTABLE { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$F26C,stop=$F2D0,clear=1,sp=$FE00)
; #SCR$02(title-screen) } UDGTABLE# #POPS
@label=ShowTitleScreen
c$F26C CALL $9A7E    ; Call #R$9A7E.
 $F26F CALL $9A72    ; Call #R$9A72.
 $F272 LD IX,$F22A   ; The title frame parameters.
 $F276 LD DE,$F202   ; The title frame corners.
 $F279 LD (IX+$09),E ; Write #REGe to offset #N$09 of #REGix.
 $F27C LD (IX+$0A),D ; Write #REGd to offset #N$0A of #REGix.
 $F27F LD DE,$F21E   ; The title frame ticks.
 $F282 LD (IX+$0C),E ; Write #REGe to offset #N$0C of #REGix.
 $F285 LD (IX+$0D),D ; Write #REGd to offset #N$0D of #REGix.
 $F288 CALL $CACB    ; Call #R$CACB.
 $F28B LD DE,$F112   ; The title text.
 $F28E LD B,$0C      ; #REGb=#N$0C.
 $F290 CALL $83CE    ; Call #R$83CE.
 $F293 LD HL,$BF40   ; Use #N$BF40.
 $F296 LD DE,$F2E3   ; The title graphics.
 $F299 CALL $C96F    ; Call #R$C96F.
 $F29C LD HL,$BEB0   ; Use #N$BEB0.
 $F29F CALL $C96F    ; Call #R$C96F.
 $F2A2 LD A,$46      ; #REGa=#N$46.
 $F2A4 LD ($5AE9),A  ; A title-screen attribute.
 $F2A7 LD ($5AF6),A  ; A title-screen attribute.
 $F2AA LD HL,$486C   ; #REGhl=#N$486C.
 $F2AD LD (HL),$0F   ; Store #N$0F at the address in #REGhl.
 $F2AF INC L         ; Advance #REGl.
 $F2B0 LD B,$06      ; #REGb=#N$06.
@label=ShowTitleScreen_Line
*$F2B2 LD (HL),$FF   ; Store #N$FF at the address in #REGhl.
 $F2B4 INC L         ; Advance #REGl.
 $F2B5 DJNZ $F2B2    ; Decrease #REGb and jump to #R$F2B2 until none remain.
 $F2B7 LD (HL),$F0   ; Store #N$F0 at the address in #REGhl.
 $F2B9 LD IX,$8708   ; The control icon data.
 $F2BD LD DE,$870E   ; The control icon sprites.
 $F2C0 CALL $8690    ; Call #R$8690.
 $F2C3 LD IX,$870B   ; The second player's control icon.
 $F2C7 LD DE,$874F   ; The second control-icon sprite.
 $F2CA CALL $8690    ; Call #R$8690.
 $F2CD CALL $8652    ; Call #R$8652.
 $F2D0 LD DE,$70D8   ; The tune: title screen.
 $F2D3 CALL $9A9A    ; Call #R$9A9A.
 $F2D6 CALL $8615    ; Call #R$8615.
 $F2D9 CALL $8652    ; Call #R$8652.
 $F2DC LD DE,$F4E4   ; The tune: game start.
 $F2DF JP $9AA9      ; Jump to #R$9AA9.

; Two Player Flag
;
; Is zero for a game with one player and not zero for a game with two
; players, which the menu at #R$8615 sets.
@label=TwoPlayerFlag
g$F2E2 DEFB $00

; Title Graphics
;
; The two small graphics that #R$F26C draws at the bottom of the title
; screen: the first is three bytes wide and eight rows high, the second two
; bytes wide and six rows high.
@label=TitleGraphics
b$F2E3 DEFB $03,$08
 $F2E5 DEFB $00,$01,$3C
 $F2E8 DEFB $FC,$83,$42
 $F2EB DEFB $FE,$C7,$99
 $F2EE DEFB $03,$C7,$A1
 $F2F1 DEFB $03,$C7,$A1
 $F2F4 DEFB $FE,$C7,$99
 $F2F7 DEFB $FC,$83,$42
 $F2FA DEFB $00,$01,$3C
 $F2FD DEFB $02,$06
 $F2FF DEFB $81,$3F
 $F301 DEFB $C3,$7F
 $F303 DEFB $C3,$C0
 $F305 DEFB $C3,$C0
 $F307 DEFB $C3,$7F
 $F309 DEFB $81,$3F

; Clear Bytes
;
; Used by the routines at #R$F311, #R$F39E and #R$F7EB.
; .
; Sets a number of bytes of memory to zero.
;
;   B Number of bytes
;   HL Address
; O:HL Address after the last byte
@label=ClearBytes
c$F30B LD (HL),$00   ; Store #N$00 at the address in #REGhl.
 $F30D INC HL        ; Advance #REGhl.
 $F30E DJNZ $F30B    ; Decrease #REGb and jump to #R$F30B until none remain.
 $F310 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #BUBBLER$A2E0 }
; LIST#

; Reset Life
;
; Used by the routine at #R$F440.
; .
; Resets everything for the start of a life: the colour of the ship, the
; explosion, the shield timer and some other counters, the stars, the shots and
; the saved copies of the flame objects. The ship object at #R$C8E5 is restored
; from the state at #R$C906 and all the enemy and map object slots are freed.
@label=ResetLife
c$F311 LD A,$47      ; #REGa=#N$47.
 $F313 LD ($F201),A  ; The ship starts white.
 $F316 XOR A         ; Clear #REGa.
 $F317 LD ($8F53),A  ; Update the ship state.
 $F31A LD ($896F),A  ; Update the falling timer.
 $F31D LD ($96AB),A  ; Update the crystal-delivery flag.
 $F320 LD ($8FC3),A  ; The damage counter.
 $F323 LD ($C27A),A  ; No piece has been drawn yet.
 $F326 LD ($87F5),A  ; The bonus timer.
 $F329 LD A,$18      ; #REGa=#N$18.
 $F32B LD ($9D2F),A  ; Update the beam hit delay.
 $F32E LD HL,$C0EA   ; The star positions.
 $F331 LD B,$12      ; #REGb=#N$12.
@label=ResetLife_Stars
*$F333 LD A,(HL)     ; Read #REGhl.
 $F334 AND %11111110 ; Keep the bits of #REGa that are set in #N$FE.
 $F336 LD (HL),A     ; Write #REGa where #REGhl points.
 $F337 INC HL        ; Advance #REGhl.
 $F338 INC HL        ; Advance #REGhl.
 $F339 DJNZ $F333    ; Decrease #REGb and jump to #R$F333 until none remain.
 $F33B LD HL,$B37A   ; The shot slots.
 $F33E LD B,$60      ; #REGb=#N$60.
 $F340 CALL $F30B    ; Call #R$F30B.
 $F343 LD HL,$96B0   ; The crystal-stack table.
 $F346 LD B,$08      ; #REGb=#N$08.
@label=ResetLife_Entries
*$F348 LD (HL),$00   ; Store #N$00 at the address in #REGhl.
 $F34A LD A,$05      ; #REGa=#N$05.
 $F34C CALL $9BCF    ; Call #R$9BCF.
 $F34F DJNZ $F348    ; Decrease #REGb and jump to #R$F348 until none remain.
 $F351 LD HL,$9D43   ; The beam table.
 $F354 LD B,$10      ; #REGb=#N$10.
 $F356 CALL $F30B    ; Call #R$F30B.
 $F359 LD DE,$C7BC   ; The ship top object.
 $F35C LD HL,$C7C2   ; The other player's ship top.
 $F35F LD BC,$0006   ; #REGbc=#N$06.
 $F362 LDIR          ; Copy #REGbc bytes from #REGhl to #REGde.
 $F364 LD DE,$C78F   ; The main flame object.
 $F367 LD HL,$C795   ; The other player's main flame.
 $F36A LD C,$06      ; #REGc=#N$06.
 $F36C LDIR          ; Copy #REGbc bytes from #REGhl to #REGde.
 $F36E LD DE,$C6C2   ; The side flame object.
 $F371 LD HL,$C6C9   ; The other player's side flame.
 $F374 LD C,$07      ; #REGc=#N$07.
 $F376 LDIR          ; Copy #REGbc bytes from #REGhl to #REGde.
 $F378 LD C,$20      ; #REGc=#N$20.
 $F37A LD DE,$C8E5   ; The ship.
 $F37D LD HL,$C906   ; The ship start state.
 $F380 LDIR          ; Copy #REGbc bytes from #REGhl to #REGde.
@label=ResetLife_Slots
 $F382 LD IX,$9974   ; The enemy slots.
 $F386 LD B,$09      ; #REGb=#N$09.
 $F388 LD DE,$0018   ; #REGde=#N$18.
 $F38B CALL $F396    ; Call #R$F396.
 $F38E LD IX,$A80B   ; The map object slots.
 $F392 LD E,$1A      ; #REGe=#N$1A.
 $F394 LD B,$06      ; #REGb=#N$06.
@label=ResetLife_FreeSlot
*$F396 CALL $AC34    ; Call #R$AC34.
 $F399 ADD IX,DE     ; #REGix gains #REGde.
 $F39B DJNZ $F396    ; Decrease #REGb and jump to #R$F396 until none remain.
 $F39D RET           ; Return.

; Reset Player State
;
; Used by the routine at #R$F3BD.
; .
; Clears the state of a player apart from the sites of the items, sets
; the item that is carried to none (#N($FF)) and copies the starting position
; from #R$F3B7.
;
; HL Address of the state of the player
@label=ResetPlayerState
c$F39E LD B,$1C      ; #REGb=#N$1C.
 $F3A0 PUSH HL       ; Stash #REGhl on the stack.
 $F3A1 CALL $F30B    ; Call #R$F30B.
 $F3A4 DEC HL        ; Step #REGhl back.
 $F3A5 DEC HL        ; Step #REGhl back.
 $F3A6 LD (HL),$FF   ; Store #N$FF at the address in #REGhl.
 $F3A8 POP HL        ; Bring #REGhl back off the stack.
 $F3A9 LD A,$13      ; #REGa=#N$13.
 $F3AB CALL $9BCF    ; Call #R$9BCF.
 $F3AE LD DE,$F3B7   ; The starting position.
 $F3B1 LD C,$06      ; #REGc=#N$06.
 $F3B3 EX DE,HL      ; Swap #REGde and #REGhl.
 $F3B4 LDIR          ; Copy #REGbc bytes from #REGhl to #REGde.
 $F3B6 RET           ; Return.

; Starting Position
;
; The position that each player starts at, in the same format as at
; #R$F5FA: the map column and row, the two positions and the two offsets.
@label=StartingPosition
b$F3B7 DEFB $0D,$07,$90,$B7,$78,$40

; Start New Game
;
; Used by the routine at #R$F422.
; .
; Sets up a new game: the objects on the map are all put back, the state
; of both players is reset and each player is given five ships. If the players
; were swapped by the last game they are swapped back, the second player is
; given no ships in a game with one player, the control devices that were
; chosen by the menu are copied for the players, the scores are set to zero and
; the sites of the items are chosen for both players.
@label=StartNewGame
c$F3BD LD E,$3F      ; #REGe=#N$3F.
 $F3BF CALL $9A8A    ; Call #R$9A8A.
 $F3C2 LD HL,$F5E7   ; The current player state.
 $F3C5 CALL $F39E    ; Call #R$F39E.
 $F3C8 LD HL,$F650   ; The other player state.
 $F3CB CALL $F39E    ; Call #R$F39E.
 $F3CE LD A,$05      ; #REGa=#N$05.
 $F3D0 LD ($F5ED),A  ; Update the ships remaining.
 $F3D3 LD ($F656),A  ; The other player is given five ships.
 $F3D6 LD A,$99      ; #REGa=#N$99.
 $F3D8 LD ($CA1C),A  ; The players are being set up.
 $F3DB LD A,($C9F6)  ; The player 1: ships left.
 $F3DE CP $A0        ; {Call #R$F591 if #REGa is #N$A0.
 $F3E0 CALL Z,$F591  ; }
 $F3E3 XOR A         ; Clear #REGa.
 $F3E4 LD ($CA1C),A  ; Player one is up.
 $F3E7 LD A,($F2E2)  ; The two player flag.
 $F3EA AND A         ; {Jump to #R$F3F0 if #REGa is not zero.
 $F3EB JR NZ,$F3F0   ; }
 $F3ED LD ($F656),A  ; The other player has no ships.
@label=StartNewGame_Controls
*$F3F0 LD A,($870A)  ; The control method chosen for player one.
 $F3F3 LD ($F603),A  ; Update the control device.
 $F3F6 LD A,($870D)  ; The control method chosen for player two.
 $F3F9 LD ($F66C),A  ; The other player's control device.
 $F3FC LD B,$06      ; #REGb=#N$06.
 $F3FE LD DE,$C9F0   ; The player 1 score digits.
 $F401 LD HL,$CA00   ; The player 2 score digits.
 $F404 LD A,$1A      ; #REGa=#N$1A.
@label=StartNewGame_Loop
*$F406 LD (DE),A     ; Write #REGa where #REGde points.
 $F407 LD (HL),A     ; Write #REGa where #REGhl points.
 $F408 INC HL        ; Advance #REGhl.
 $F409 INC DE        ; Advance #REGde.
 $F40A DJNZ $F406    ; Decrease #REGb and jump to #R$F406 until none remain.
 $F40C LD DE,$F604   ; The item sites.
 $F40F CALL $6113    ; Call #R$6113.
 $F412 LD DE,$F66D   ; The other player's item sites.
 $F415 CALL $6113    ; Call #R$6113.
 $F418 RET           ; Return.

; Colour Playfield
;
; Used by the routines at #R$DCA1 and #R$DD79.
; .
; Fills the attributes of the playfield with the background colour.
@label=ColourPlayfield
c$F419 LD HL,$B708   ; Use #N$B708.
 $F41C LD DE,$F10F   ; The playfield attribute area.
 $F41F JP $C991      ; Jump to #R$C991.

; Run Game
;
; Used by the routines at #R$9A66 and #R$F440.
; .
; Runs the game, starting with the title screen: it makes a new game,
; draws the screen and the HUD and prints the number of the player. Returns
; here from #R$F440 when all the ships have gone.
@label=RunGame
c$F422 CALL $F26C    ; Call #R$F26C.
 $F425 CALL $F3BD    ; Call #R$F3BD.
 $F428 CALL $9A72    ; Call #R$9A72.
 $F42B CALL $9A7E    ; Call #R$9A7E.
 $F42E CALL $CA3F    ; Call #R$CA3F.
 $F431 CALL $F4EE    ; Call #R$F4EE.
 $F434 LD B,$06      ; #REGb=#N$06.
@label=RunGame_Wait
*$F436 CALL $A802    ; Call #R$A802.
 $F439 DJNZ $F436    ; Decrease #REGb and jump to #R$F436 until none remain.
 $F43B CALL $9F2C    ; Call #R$9F2C.
 $F43E JR $F44C      ; Jump to #R$F44C.

; Prepare Life
;
; Used by the routines at #R$F48B and #R$F52A.
; .
; Resets the ship and everything else for the next life. If there are no
; ships left the game goes back to the title screen. If there are, the HUD is
; drawn again.
@label=PrepareLife
c$F440 CALL $F311    ; Call #R$F311.
 $F443 LD A,($F5ED)  ; The ships remaining.
 $F446 AND A         ; {Jump to #R$F422 if #REGa is zero.
 $F447 JR Z,$F422    ; }
 $F449 CALL $CA3F    ; Call #R$CA3F.
; Continue on to #R$F44C.

; Play Life
;
; Used by the routine at #R$F422.
; .
; Plays a life. The height of the stack of units is restored and the code
; that tests and sets the bit for a destroyed object in the map table is
; changed (at #N($E118), #N($A9B8) and #N($ABDE)) so that player two uses bit 6
; rather than bit 7. The life is started with #R$DCA1.
@label=PlayLife
c$F44C LD A,($F600)  ; The height of the stack of units that the ship carries.
 $F44F LD ($C905),A  ; Update the stack height.
 $F452 LD A,($CA1C)  ; The current player.
 $F455 LD B,A        ; #REGb=#REGa.
 $F456 LD A,$7E      ; #REGa=#N$7E.
 $F458 BIT 0,B       ; {Jump to #R$F45E if bit 0 of #REGb is clear.
 $F45A JR Z,$F45E    ; }
 $F45C LD A,$76      ; #REGa=#N$76.
@label=PlayLife_Store
*$F45E LD ($E118),A  ; Which bit is tested for a destroyed map cell.
 $F461 OR %11110000  ; Set the bits of #REGa that are set in #N$F0.
 $F463 LD ($A9B8),A  ; Which bit is set on a destroyed map cell.
 $F466 LD ($ABDE),A  ; Which bit is set on a destroyed map cell.
 $F469 CALL $DCA1    ; Call #R$DCA1.
; Continue on to #R$F46C.

; Run Life
;
; Runs the frames of a life one at a time until the ship has been
; destroyed (when the explosion counter at #R$8F53 is #N($0C) or more) or the
; planet has been completed (when the flag at #R$96AB is #N($FF)).
@label=RunLife
c$F46C CALL $C374    ; Call #R$C374.
 $F46F CALL $CC77    ; Call #R$CC77.
 $F472 CALL $87AF    ; Call #R$87AF.
 $F475 CALL $8D42    ; Call #R$8D42.
 $F478 CALL $F23B    ; Call #R$F23B.
 $F47B LD A,($8F53)  ; The ship state.
 $F47E CP $0C        ; {Jump to #R$F48B if #REGa is #N$0C or more.
 $F480 JR NC,$F48B   ; }
 $F482 LD A,($96AB)  ; The crystal-delivery flag.
 $F485 INC A         ; Advance #REGa.
 $F486 JR NZ,$F46C   ; Jump to #R$F46C if the zero flag is clear.
 $F488 JP $F52A      ; Jump to #R$F52A.

; Explode Ship
;
; Used by the routine at #R$F46C.
; .
; Runs the frames of the explosion of the ship, once it has been
; destroyed, with the scroll speeds at zero and the fuel gauge empty, until the
; explosion counter at #R$8F53 gets to #N($50). It then plays a tune, fades out
; the playfield and takes away a life, and goes on to #R$F440.
; .
; #HTML(#AUDIO0(ship-destroyed-tune.wav)(#INCLUDE(ShipDestroyedTune)))
@label=ExplodeShip
c$F48B XOR A         ; Clear #REGa.
 $F48C LD ($CCBB),A  ; Update the horizontal scroll speed.
 $F48F LD ($CCBA),A  ; Update the vertical scroll speed.
 $F492 LD HL,$BE00   ; The rotate step of doubling a number.
 $F495 LD ($CC4B),HL ; Update the fuel level.
 $F498 CALL $C4ED    ; Call #R$C4ED.
 $F49B CALL $C6D2    ; Call #R$C6D2.
@label=ExplodeShip_Loop
*$F49E CALL $C374    ; Call #R$C374.
 $F4A1 CALL $9F4E    ; Call #R$9F4E.
 $F4A4 CALL $CC77    ; Call #R$CC77.
 $F4A7 CALL $8D42    ; Call #R$8D42.
 $F4AA CALL $C1CE    ; Call #R$C1CE.
 $F4AD CALL $CC77    ; Call #R$CC77.
 $F4B0 LD A,($8F53)  ; The ship state.
 $F4B3 CP $50        ; {Jump to #R$F49E if #REGa is not #N$50.
 $F4B5 JR NZ,$F49E   ; }
 $F4B7 LD DE,$F4DD   ; The tune: ship destroyed.
 $F4BA CALL $9AA9    ; Call #R$9AA9.
 $F4BD CALL $9EF5    ; Call #R$9EF5.
 $F4C0 CALL $F4C6    ; Call #R$F4C6.
 $F4C3 JP $F440      ; Jump to #R$F440.

; Lose Life
;
; Used by the routine at #R$F48B.
; .
; Saves the height of the stack of units and takes a ship away from the
; current player. If there are none left the game is over for the player.
; Otherwise, in a game with two players, the players are swapped.
@label=LoseLife
c$F4C6 LD A,($C905)  ; The stack height.
 $F4C9 LD ($F600),A  ; Update the height of the stack of units that the ship
                     ; carries.
 $F4CC LD A,($F5ED)  ; The ships remaining.
; See #POKE(infinite_ships,Infinite Ships).
 $F4CF DEC A         ; Step #REGa back.
 $F4D0 LD ($F5ED),A  ; Update the ships remaining.
 $F4D3 JR Z,$F4FC    ; Jump to #R$F4FC if the zero flag is set.
 $F4D5 LD A,($F2E2)  ; The two player flag.
 $F4D8 AND A         ; {Call #R$F591 if #REGa is not zero.
 $F4D9 CALL NZ,$F591 ; }
 $F4DC RET           ; Return.

; Tune: Ship Destroyed
;
; The notes that are played when the ship has been destroyed. The tune
; ends with #N($FF).
@label=TuneShipDestroyed
b$F4DD DEFB $1E,$1C,$1B,$19,$58,$D9,$FF

; Tune: Game Start
;
; The notes that are played when a game starts. The tune ends with
; #N($FF).
@label=TuneGameStart
b$F4E4 DEFB $2A,$2C,$2A,$27,$29,$29,$29,$25,$E7,$FF

; Print Player
;
; Used by the routines at #R$F422, #R$F4FC and #R$F591.
; .
; Prints the number of the current player, which is player one or player
; two, with the text at #R$F5DB.
@label=PrintPlayer
c$F4EE LD A,($CA1C)  ; The current player.
 $F4F1 ADD A,$1B     ; Add #N$1B to #REGa.
 $F4F3 LD ($F5E6),A  ; The digit of the player.
 $F4F6 LD DE,$F5DB   ; The text: player.
 $F4F9 JP $A115      ; Jump to #R$A115.

; Game Over
;
; Used by the routine at #R$F4C6.
; .
; Ends the game for the current player. It prints the number of the
; player and the text GAME OVER, updates the high score and plays a tune. Then
; it waits for a while or until the 0 key is pressed, clears the playfield and
; (with two players) swaps the players.
; .
; #HTML(#AUDIO0(game-over-tune.wav)(#INCLUDE(GameOverTune)))
@label=GameOver
c$F4FC CALL $F4EE    ; Call #R$F4EE.
 $F4FF LD DE,$F5CE   ; The text: game over.
 $F502 CALL $A115    ; Call #R$A115.
 $F505 CALL $F54D    ; Call #R$F54D.
 $F508 LD DE,$F580   ; The tune: game over.
 $F50B CALL $9AA9    ; Call #R$9AA9.
 $F50E LD B,$0C      ; #REGb=#N$0C.
@label=GameOver_Wait
*$F510 CALL $A802    ; Call #R$A802.
 $F513 LD A,$EF      ; #REGa=#N$EF.
 $F515 OUT ($FD),A   ; Send #REGa to port #N$FD.
 $F517 IN A,($FE)    ; Read port #N$FE.
 $F519 AND %00000001 ; Keep the bits of #REGa that are set in #N$01.
 $F51B JR Z,$F51F    ; Jump to #R$F51F if the zero flag is set.
 $F51D DJNZ $F510    ; Decrease #REGb and jump to #R$F510 until none remain.
@label=GameOver_Done
*$F51F CALL $9F2C    ; Call #R$9F2C.
 $F522 LD A,($F2E2)  ; The two player flag.
 $F525 AND A         ; {Call #R$F591 if #REGa is not zero.
 $F526 CALL NZ,$F591 ; }
 $F529 RET           ; Return.

; Finish Planet
;
; Used by the routine at #R$F46C.
; .
; Used when the planet has been completed. It clears the playfield, runs
; #R$83D6 and plays a tune. After a short delay it clears the playfield and the
; map cells at #R$F5EA again, and carries on with #R$F440.
; .
; #HTML(#AUDIO0(planet-complete-tune.wav)(#INCLUDE(PlanetCompleteTune)))
@label=FinishPlanet
c$F52A CALL $9F2C    ; Call #R$9F2C.
 $F52D CALL $83D6    ; Call #R$83D6.
 $F530 LD DE,$F56A   ; The tune: planet complete.
 $F533 CALL $9AA9    ; Call #R$9AA9.
 $F536 LD B,$0E      ; #REGb=#N$0E.
@label=FinishPlanet_Wait
*$F538 CALL $A802    ; Call #R$A802.
 $F53B DJNZ $F538    ; Decrease #REGb and jump to #R$F538 until none remain.
 $F53D CALL $9F2C    ; Call #R$9F2C.
 $F540 XOR A         ; Clear #REGa.
 $F541 LD ($F5EA),A  ; Update the bitmap of map cells.
 $F544 LD ($F5EB),A  ; The second byte of the map-cell bitmap.
 $F547 LD ($F5EC),A  ; The third byte of the map-cell bitmap.
 $F54A JP $F440      ; Jump to #R$F440.

; Update High Score
;
; Used by the routine at #R$F4FC.
; .
; Compares the score at #R$C9F0 with the high score at #R$CA16, one digit
; at a time, starting at the left. If the score is higher it is copied to the
; high score.
@label=UpdateHighScore
c$F54D LD HL,$CA16   ; The high-score digits.
 $F550 LD DE,$C9F0   ; The player 1 score digits.
 $F553 LD B,$06      ; #REGb=#N$06.
@label=UpdateHighScore_Compare
*$F555 LD A,(DE)     ; Read #REGde.
 $F556 CP (HL)       ; {Return if #REGa is less than the byte at #REGhl.
 $F557 RET C         ; }
 $F558 JR NZ,$F55E   ; Jump to #R$F55E if the zero flag is clear.
 $F55A INC HL        ; Advance #REGhl.
 $F55B INC DE        ; Advance #REGde.
 $F55C DJNZ $F555    ; Decrease #REGb and jump to #R$F555 until none remain.
@label=UpdateHighScore_Update
*$F55E LD DE,$CA16   ; The high-score digits.
 $F561 LD HL,$C9F0   ; The player 1 score digits.
 $F564 LD BC,$0006   ; #REGbc=#N$06.
 $F567 LDIR          ; Copy #REGbc bytes from #REGhl to #REGde.
 $F569 RET           ; Return.

; Tune: Planet Complete
;
; The notes that are played when a planet has been completed. The tune
; ends with #N($FF).
@label=TunePlanetComplete
b$F56A DEFB $A5,$25,$25,$25,$A9,$25,$25,$25
 $F572 DEFB $AC,$A4,$A5,$6C,$2C,$AE,$AC,$AA
 $F57A DEFB $AE,$AC,$A4,$A5,$99,$FF

; Tune: Game Over
;
; The notes that are played when the game is over. The tune ends with
; #N($FF).
@label=TuneGameOver
b$F580 DEFB $2E,$2C,$2A,$2C,$2A,$29,$2A,$29
 $F588 DEFB $27,$22,$1E,$22,$27,$27,$27,$27
 $F590 DEFB $FF

; Swap Players
;
; Used by the routines at #R$F3BD, #R$F4C6 and #R$F4FC.
; .
; Does nothing if the second player has no ships. Otherwise it swaps the
; state of the two players, and the records for the scores and the numbers of
; ships that are printed at the top of the screen, so that the state of the
; player who is up is always at #R$F5E7. If the flag at #R$CA1C is #N($99) it
; goes no further. If not it changes the number of the player, prints it and
; clears the playfield.
@label=SwapPlayers
c$F591 LD A,($F656)  ; The other player's ships.
 $F594 AND A         ; {Return if #REGa is zero.
 $F595 RET Z         ; }
 $F596 LD DE,$F5E7   ; The current player state.
 $F599 LD HL,$F650   ; The other player state.
 $F59C LD B,$69      ; #REGb=#N$69.
 $F59E CALL $F5C4    ; Call #R$F5C4.
 $F5A1 LD DE,$C9EC   ; The player 1 score text.
 $F5A4 LD HL,$C9FC   ; The player 2 score text.
 $F5A7 LD B,$10      ; #REGb=#N$10.
 $F5A9 CALL $F5C4    ; Call #R$F5C4.
 $F5AC LD A,($CA1C)  ; The current player.
 $F5AF CP $99        ; {Return if #REGa is #N$99.
 $F5B1 RET Z         ; }
 $F5B2 XOR %00000001 ; Flip the bits of #REGa that are set in #N$01.
 $F5B4 LD ($CA1C),A  ; The other player is now up.
 $F5B7 CALL $F4EE    ; Call #R$F4EE.
 $F5BA LD B,$08      ; #REGb=#N$08.
@label=SwapPlayers_Delay
*$F5BC CALL $A802    ; Call #R$A802.
 $F5BF DJNZ $F5BC    ; Decrease #REGb and jump to #R$F5BC until none remain.
 $F5C1 JP $9F2C      ; Jump to #R$9F2C.

; Swap Bytes
;
; Used by the routine at #R$F591.
; .
; Swaps two blocks of memory.
;
; B Number of bytes
; DE Address of the first block
; HL Address of the second block
@label=SwapBytes
c$F5C4 LD C,(HL)     ; Read #REGhl into #REGc.
 $F5C5 LD A,(DE)     ; Read #REGde.
 $F5C6 LD (HL),A     ; Write #REGa where #REGhl points.
 $F5C7 LD A,C        ; #REGa=#REGc.
 $F5C8 LD (DE),A     ; Write #REGa where #REGde points.
 $F5C9 INC HL        ; Advance #REGhl.
 $F5CA INC DE        ; Advance #REGde.
 $F5CB DJNZ $F5C4    ; Decrease #REGb and jump to #R$F5C4 until none remain.
 $F5CD RET           ; Return.
; View the equivalent code in;
; #LIST
; { #BUBBLER$A2E6 }
; LIST#

; Text: Game Over
;
; The text record for the words GAME OVER.
@label=TextGameOver
b$F5CE DEFB $30,$4F,$C6,$09
 $F5D2 DEFB $06,$00,$0C,$04,$26,$0E,$15,$04,$11 ; "GAME OVER"

; Text: Player
;
; The text record for the number of the player. The last character, which
; is changed by #R$F4EE, is the digit one or two.
@label=TextPlayer
b$F5DB DEFB $38,$67,$C5,$08
 $F5DF DEFB $0F,$0B,$00,$18,$04,$11,$26,$00 ; "PLAYER 1"

; Current Player State
;
; The state of the player who is up. The state of the other player is at
; #R$F650 in the same layout, and #R$F591 swaps the two.
@label=CurrentPlayerState
g$F5E7 DEFB $00,$00,$00 ; Score (binary coded decimal, see #R$925E)
@label=CurrentPlayerState_MapCells
 $F5EA DEFB $00,$00,$00 ; Bitmap of map cells (see #R$ABF3)
 $F5ED DEFB $03         ; Ships that are left
@label=CurrentPlayerState_Parts
 $F5EE DEFB $00         ; {Flags for the parts that have been fitted to the
 $F5EF DEFB $00         ; ship
 $F5F0 DEFB $00         ;
 $F5F1 DEFB $00         ;
 $F5F2 DEFB $00         ;
 $F5F3 DEFB $00         ;
 $F5F4 DEFB $00         ;
 $F5F5 DEFB $00         ;
 $F5F6 DEFB $00         ; }
 $F5F7 DEFB $00         ; Set when item number #N($09) has been picked up (see
                        ; #R$C1CE)
 $F5F8 DEFB $00         ; Not used
 $F5F9 DEFB $00         ; Planet number, from #N($00) to #N($04)
 $F5FA DEFB $0D         ; Map column of the position that the ship restarts at
 $F5FB DEFB $07         ; Map row of the position that the ship restarts at
 $F5FC DEFB $90         ; {Position of the ship: horizontal then vertical
 $F5FD DEFB $B7         ; }
 $F5FE DEFB $78         ; {Scroll offsets: horizontal then vertical
 $F5FF DEFB $40         ; }
 $F600 DEFB $00         ; Height of the stack of units that the ship carries
 $F601 DEFB $FF         ; Item that is being carried, or #N($FF) if there is
                        ; none
 $F602 DEFB $00         ; Number of crystals
 $F603 DEFB $00         ; Control device: keyboard, Kempston, Cursor or
                        ; Interface 2

