; Copy Game Down
;
; Used by the routine at #R$5B80.
; .
; Used by the loader before the game starts: #R$5B80 calls this routine
; to move the encrypted game from #N$5E80 down to #N$5C80. The helper at
; #R$6000@loader copies it here from #R$6022@loader. The routine is in the
; area of memory where the shift tables are built afterwards, so it is
; overwritten when the game starts.
@label=CopyGameDown
c$FC00 LD HL,$5E80   ; Set the source address in #REGhl.
 $FC03 LD DE,$5C80   ; Set the destination address in #REGde.
 $FC06 LD BC,$9D80   ; Set the number of bytes to copy in #REGbc.
 $FC09 LDIR          ; Copy the game down.
 $FC0B RET           ; Return.
; The next four bytes are not used.
 $FC0C LD SP,$FE00   ; Set the stack pointer to #N$FE00.
 $FC0F DI            ; Disable interrupts.

