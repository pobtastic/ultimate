; Draw Bitmap
;
; Used by the routines at #R$8690, #R$CA3F, #R$CACB, #R$CBAE and #R$F26C.
; .
; Draws a bitmap on the screen. The bitmap starts with its width in bytes
; and its height in rows, followed by the bytes for each row. The position is
; that of the bottom row, and the rows are drawn going up the screen.
;
;   DE Address of the bitmap
;   HL Position (#REGh is the pixel row and #REGl is the pixel column)
; O:DE Address after the bitmap
@label=DrawBitmap
c$C96F PUSH HL       ; Stash #REGhl on the stack.
 $C970 LD A,(DE)     ; Read #REGde.
 $C971 LD B,A        ; #REGb=#REGa.
 $C972 INC DE        ; Advance #REGde.
 $C973 LD A,(DE)     ; Read #REGde.
 $C974 LD C,A        ; #REGc=#REGa.
 $C975 INC DE        ; Advance #REGde.
 $C976 CALL $A149    ; Call #R$A149.
 $C979 LD A,B        ; #REGa=#REGb.
 $C97A LD ($5C1C),A  ; The width of the bitmap.
@label=DrawBitmap_Row
*$C97D PUSH HL       ; Stash #REGhl on the stack.
 $C97E LD A,($5C1C)  ; The width of the bitmap.
 $C981 LD B,A        ; #REGb=#REGa.
@label=DrawBitmap_Loop
*$C982 LD A,(DE)     ; Read #REGde.
 $C983 LD (HL),A     ; Write #REGa where #REGhl points.
 $C984 INC DE        ; Advance #REGde.
 $C985 INC HL        ; Advance #REGhl.
 $C986 DJNZ $C982    ; Decrease #REGb and jump to #R$C982 until none remain.
 $C988 POP HL        ; Bring #REGhl back off the stack.
 $C989 CALL $A1C3    ; Call #R$A1C3.
 $C98C DEC C         ; Step #REGc back.
 $C98D JR NZ,$C97D   ; Jump to #R$C97D if the zero flag is clear.
 $C98F POP HL        ; Bring #REGhl back off the stack.
 $C990 RET           ; Return.

; Fill Attributes
;
; Used by the routines at #R$8666, #R$8F54, #R$9BDA, #R$AE98, #R$B5B5, #R$C5FF,
; #R$CA3F, #R$CAA7, #R$CACB, #R$F1BD and #R$F419.
; .
; Fills an area of the attributes with one value. The area starts with
; its width, its height and the attribute. The position is that of the bottom
; row of the area, and the rows are filled going up the screen.
;
; DE Address of the area
; HL Position (#REGh is the pixel row and #REGl is the pixel column)
@label=FillAttributes
c$C991 LD A,(DE)     ; Read #REGde.
 $C992 LD B,A        ; #REGb=#REGa.
 $C993 INC DE        ; Advance #REGde.
 $C994 LD A,(DE)     ; Read #REGde.
 $C995 LD C,A        ; #REGc=#REGa.
 $C996 CALL $A170    ; Call #R$A170.
 $C999 INC DE        ; Advance #REGde.
 $C99A LD A,(DE)     ; Read #REGde.
 $C99B INC DE        ; Advance #REGde.
 $C99C PUSH DE       ; Stash #REGde on the stack.
 $C99D LD D,A        ; #REGd=#REGa.
 $C99E LD E,B        ; #REGe=#REGb.
@label=FillAttributes_Row
*$C99F PUSH HL       ; Stash #REGhl on the stack.
 $C9A0 LD B,E        ; #REGb=#REGe.
@label=FillAttributes_Loop
*$C9A1 LD (HL),D     ; Write #REGd where #REGhl points.
 $C9A2 INC HL        ; Advance #REGhl.
 $C9A3 DJNZ $C9A1    ; Decrease #REGb and jump to #R$C9A1 until none remain.
 $C9A5 POP HL        ; Bring #REGhl back off the stack.
 $C9A6 PUSH BC       ; Stash #REGbc on the stack.
 $C9A7 LD BC,$0020   ; #REGbc=#N$20.
 $C9AA AND A         ; Is #REGa zero?
 $C9AB SBC HL,BC     ; Subtract #REGbc and the carry from #REGhl.
 $C9AD POP BC        ; Bring #REGbc back off the stack.
 $C9AE DEC C         ; Step #REGc back.
 $C9AF JR NZ,$C99F   ; Jump to #R$C99F if the zero flag is clear.
 $C9B1 POP DE        ; Bring #REGde back off the stack.
 $C9B2 RET           ; Return.

; Copy Attributes
;
; Not used. Copies attributes from the bytes that follow the width and
; height of an area, rather than filling the area with one value as
; #R$C991 does.
;
; DE Address of the area
; HL Position (#REGh is the pixel row and #REGl is the pixel column)
@label=CopyAttributes
c$C9B3 PUSH HL       ; Stash #REGhl on the stack.
 $C9B4 LD A,(DE)     ; Read #REGde.
 $C9B5 LD B,A        ; #REGb=#REGa.
 $C9B6 INC DE        ; Advance #REGde.
 $C9B7 LD A,(DE)     ; Read #REGde.
 $C9B8 LD C,A        ; #REGc=#REGa.
 $C9B9 CALL $A170    ; Call #R$A170.
 $C9BC LD A,B        ; #REGa=#REGb.
 $C9BD LD ($5C1C),A  ; The width of the attribute area.
 $C9C0 INC DE        ; Advance #REGde.
@label=CopyAttributes_Row
*$C9C1 PUSH HL       ; Stash #REGhl on the stack.
 $C9C2 LD A,($5C1C)  ; The width of the attribute area.
 $C9C5 LD B,A        ; #REGb=#REGa.
@label=CopyAttributes_Byte
*$C9C6 LD A,(DE)     ; Read #REGde.
 $C9C7 LD (HL),A     ; Write #REGa where #REGhl points.
 $C9C8 INC DE        ; Advance #REGde.
 $C9C9 INC HL        ; Advance #REGhl.
 $C9CA DJNZ $C9C6    ; Decrease #REGb and jump to #R$C9C6 until none remain.
 $C9CC POP HL        ; Bring #REGhl back off the stack.
 $C9CD PUSH DE       ; Stash #REGde on the stack.
 $C9CE LD DE,$0020   ; #REGde=#N$20.
 $C9D1 AND A         ; Is #REGa zero?
 $C9D2 SBC HL,DE     ; Subtract #REGde and the carry from #REGhl.
 $C9D4 POP DE        ; Bring #REGde back off the stack.
 $C9D5 DEC C         ; Step #REGc back.
 $C9D6 JR NZ,$C9C1   ; Jump to #R$C9C1 if the zero flag is clear.
 $C9D8 POP HL        ; Bring #REGhl back off the stack.
 $C9D9 RET           ; Return.

; HUD Text
;
; The eight text records that #R$CA3F prints at the top of the screen,
; in the format that #R$A115 prints: the column, the row, the attribute, the
; number of characters and then the characters. The digits of the two scores
; and of the numbers of ships are changed as the game goes on. A zero ends the
; records.
@label=HUDText
b$C9DA DEFB $00,$07,$47,$05         ; Player 1: "SCORE" label
 $C9DE DEFB $12,$02,$0E,$11,$04
 $C9E3 DEFB $D8,$07,$47,$05         ; Player 2: "SCORE" label
 $C9E7 DEFB $12,$02,$0E,$11,$04
@label=HUDText_Player1Score
 $C9EC DEFB $00,$0F,$46,$06         ; Player 1: score
@label=HUDText_Player1ScoreDigits
 $C9F0 DEFB $1A,$1A,$1A,$1A,$1A,$1A
@label=HUDText_Player1Ships
 $C9F6 DEFB $50,$0A,$45,$02         ; Player 1: ships left
 $C9FA DEFB $1A,$1D
@label=HUDText_Player2Score
 $C9FC DEFB $D0,$0F,$46,$06         ; Player 2: score
@label=HUDText_Player2ScoreDigits
 $CA00 DEFB $1A,$1A,$1A,$1A,$1A,$1A
 $CA06 DEFB $A0,$0A,$45,$02         ; Player 2: ships left
 $CA0A DEFB $1A,$1D
 $CA0C DEFB $78,$07,$44,$02         ; "HI" label
 $CA10 DEFB $07,$08
 $CA12 DEFB $68,$0F,$46,$06         ; High score
@label=HUDText_HighScoreDigits
 $CA16 DEFB $1A,$1B,$1A,$1A,$1A,$1A
 $CA1C DEFB $00

; Frame Parameters
;
; The values that #R$CACB uses to draw the frame round the playfield.
; The addresses are screen addresses, and #R$CA3F sets up the two tables.
@label=FrameParameters
g$CA1D DEFW $57C0       ; Left vertical line
 $CA1F DEFW $57DD       ; Right vertical line
 $CA21 DEFB $A0         ; Number of rows in the vertical lines
 $CA22 DEFW $56E1       ; Bottom horizontal lines
 $CA24 DEFW $4641       ; Top horizontal lines
 $CA26 DEFW $0000       ; Address of the corner table (set by #R$CA3F)
 $CA28 DEFB $06         ; Number of ticks along each edge
 $CA29 DEFW $0000       ; Address of the tick table (set by #R$CA3F)
 $CA2B DEFB $16         ; Pixel row of the top edge
 $CA2C DEFB $E8         ; Pixel column of the right edge
 $CA2D DEFB $1C         ; Length of the horizontal lines, in bytes
@label=FrameParameters_Second
 $CA2E DEFB $14,$02,$47 ; Attribute area for the panel behind the text

; Print Ships Remaining
;
; Used by the routines at #R$9020 and #R$CA3F.
; .
; Prints the number of ships that player 1 has left, which is one less
; than the number that is stored.
@label=PrintShipsRemaining
c$CA31 LD A,($F5ED)  ; The ships remaining.
 $CA34 ADD A,$19     ; Add #N$19 to #REGa.
 $CA36 LD ($C9FB),A  ; The digit of the ships that are left.
 $CA39 LD DE,$C9F6   ; The player 1 ships text.
 $CA3C JP $A115      ; Jump to #R$A115.

; Draw HUD
;
; Used by the routines at #R$F422 and #R$F440.
; .
; Draws the status panel at the top of the screen and the frame round the
; playfield. The panel has the scores, the numbers of ships with a ship icon
; beside each, and the high score. The frame has the sides, the lines along
; the top and bottom, the corners and some ticks. Last of all it draws the
; fuel gauge at the right.
; .
; #PUSHS #UDGTABLE { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$CA3F,stop=$C990,clear=1,sp=$FE00)
; #SCR$02(status-panel) } UDGTABLE# #POPS
@label=DrawHUD
c$CA3F LD A,$46      ; #REGa=#N$46.
 $CA41 LD ($C9EE),A  ; Player one's score is bright yellow.
 $CA44 LD A,$42      ; #REGa=#N$42.
 $CA46 LD ($C9FE),A  ; Player two's score is bright red.
 $CA49 LD HL,$0F30   ; #REGhl=#N$0F30.
 $CA4C LD DE,$CA2E   ; The second copy of the frame parameters.
 $CA4F CALL $C991    ; Call #R$C991.
 $CA52 CALL $CA31    ; Call #R$CA31.
 $CA55 LD A,($F656)  ; The other player's ships.
 $CA58 ADD A,$1A     ; Add #N$1A to #REGa.
 $CA5A LD ($CA0B),A  ; The digit of the other player's ships.
 $CA5D LD DE,$C9DA   ; The hud text.
 $CA60 LD B,$08      ; #REGb=#N$08.
 $CA62 CALL $83CE    ; Call #R$83CE.
 $CA65 LD HL,$0B30   ; #REGhl=#N$0B30.
 $CA68 LD DE,$C927   ; The ship icon.
 $CA6B CALL $C96F    ; Call #R$C96F.
 $CA6E LD HL,$0BB0   ; #REGhl=#N$0BB0.
 $CA71 LD DE,$C927   ; The ship icon.
 $CA74 CALL $C96F    ; Call #R$C96F.
@label=DrawHUD_Frame
 $CA77 LD IX,$CA1D   ; The frame parameters.
 $CA7B LD DE,$CBF8   ; The frame corner table.
 $CA7E LD (IX+$09),E ; Write #REGe to offset #N$09 of #REGix.
 $CA81 LD (IX+$0A),D ; Write #REGd to offset #N$0A of #REGix.
 $CA84 LD DE,$CBE5   ; The frame tick table.
 $CA87 LD (IX+$0C),E ; Write #REGe to offset #N$0C of #REGix.
 $CA8A LD (IX+$0D),D ; Write #REGd to offset #N$0D of #REGix.
 $CA8D CALL $CACB    ; Call #R$CACB.
 $CA90 CALL $CABD    ; Call #R$CABD.
 $CA93 CALL $CBAE    ; Call #R$CBAE.
 $CA96 LD HL,$37F0   ; #REGhl=#N$37F0.
 $CA99 PUSH HL       ; Stash #REGhl on the stack.
 $CA9A LD DE,$CBA8   ; The fuel gauge attributes.
 $CA9D CALL $C991    ; Call #R$C991.
 $CAA0 POP HL        ; Bring #REGhl back off the stack.
 $CAA1 LD DE,$CB66   ; The fuel label graphic.
 $CAA4 JP $C96F      ; Jump to #R$C96F.

; Colour Fuel Gauge
;
; Used by the routine at #R$CC77.
; .
; Used on odd frames. When the fuel is low (the gauge level is at least
; #N($98)) the colour of the fuel gauge alternates between red and yellow
; every other frame, otherwise it is yellow. #R$CABD is the entry point that
; always uses yellow.
@label=ColourFuelGauge
c$CAA7 LD A,($9A64)  ; Fetch the frame counter from #R$9A64.
 $CAAA LD B,A        ; Keep it, so the next bit can be tested as well.
 $CAAB AND %00000001 ; Is this an odd frame?
 $CAAD RET Z         ; Return on an even frame.
 $CAAE LD A,($CC4C)  ; Fetch the row of the top of the fuel.
 $CAB1 CP $98        ; {Use yellow if the tank is not low.
 $CAB3 JR C,$CABD    ; }
 $CAB5 BIT 1,B       ; {Use yellow on the frames when bit 1 is clear.
 $CAB7 JR Z,$CABD    ; }
 $CAB9 LD A,$42      ; Otherwise use red (#N$42).
 $CABB JR $CABF      ; Fill the gauge with it.
; This entry point is used by the routine at #R$CA3F.
@label=ColourFuelGauge_Yellow
*$CABD LD A,$46      ; The normal colour of the gauge is yellow (#N$46).
@label=ColourFuelGauge_Fill
*$CABF LD ($CBAD),A  ; Store the chosen colour in the gauge attributes.
 $CAC2 LD HL,$BFF0   ; The gauge hangs from the right of the bottom row.
 $CAC5 LD DE,$CBAB   ; The attribute area of the gauge.
 $CAC8 JP $C991      ; Fill that area.

; Draw Frame
;
; Used by the routines at #R$CA3F and #R$F26C.
; .
; Draws the frame round the playfield from the values in the table at
; #R$CA1D: a vertical line at each side, a double horizontal line at the top
; and bottom, a graphic at each of the four corners with a coloured line along
; each edge, and then the ticks along the edges.
; .
; #PUSHS #UDGTABLE { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$F26C,stop=$F28B,clear=1,sp=$FE00)
; #SCR$02(playfield-frame) } UDGTABLE# #POPS
;
; IX Address of the table (#R$CA1D)
@label=DrawFrame
c$CACB LD L,(IX+$00) ; The low byte of the address of the left side.
 $CACE LD H,(IX+$01) ; The high byte of the address of the left side.
 $CAD1 LD E,(IX+$02) ; The low byte of the address of the right side.
 $CAD4 LD D,(IX+$03) ; The high byte of the address of the right side.
 $CAD7 LD B,(IX+$04) ; The number of rows in the two sides.
@label=DrawFrame_Sides
*$CADA LD (HL),$66   ; Plot the patterned byte #N$66 on the left side.
 $CADC LD A,$66      ; The same byte for the right side.
 $CADE LD (DE),A     ; Plot it on the right side.
 $CADF CALL $A1C3    ; Move the left side up one pixel row.
 $CAE2 CALL $A1B3    ; Move the right side up one pixel row.
 $CAE5 DJNZ $CADA    ; Repeat for each row of the sides.
 $CAE7 LD L,(IX+$05) ; The low byte of the address of the bottom rules.
 $CAEA LD H,(IX+$06) ; The high byte of the address of the bottom rules.
 $CAED LD E,(IX+$07) ; The low byte of the address of the top rules.
 $CAF0 LD D,(IX+$08) ; The high byte of the address of the top rules.
 $CAF3 CALL $CC38    ; Draw one pixel row of the top and bottom rules.
 $CAF6 CALL $CC38    ; Draw the next pixel row of those rules.
 $CAF9 DEC H         ; Move the bottom rule up one pixel row.
 $CAFA DEC H         ; Move the bottom rule up another pixel row.
 $CAFB DEC D         ; Move the top rule up one pixel row.
 $CAFC DEC D         ; Move the top rule up another pixel row.
 $CAFD CALL $CC38    ; Draw one pixel row of the inner rules.
 $CB00 CALL $CC38    ; Draw the next pixel row of the inner rules.
 $CB03 LD DE,$CC14   ; The corner graphics start at #R$CC14.
 $CB06 LD ($CE3A),DE ; Keep that address for the next corner.
 $CB0A LD E,(IX+$09) ; The low byte of the address of the corner table.
 $CB0D LD D,(IX+$0A) ; The high byte of the address of the corner table.
 $CB10 LD B,$04      ; There are four corners.
@label=DrawFrame_Corners
*$CB12 PUSH BC       ; Keep the number of corners still to draw.
 $CB13 CALL $CBF1    ; Read the position of this corner graphic.
 $CB16 PUSH DE       ; Keep the place in the corner table.
 $CB17 LD DE,($CE3A) ; The graphic for this corner.
 $CB1B CALL $C96F    ; Draw the corner graphic.
 $CB1E LD ($CE3A),DE ; The next corner graphic follows this one.
 $CB22 POP DE        ; Back to the corner table.
 $CB23 CALL $CBF1    ; Read the position of the coloured edge.
 $CB26 CALL $C991    ; Colour that edge.
 $CB29 POP BC        ; Bring back the number of corners.
 $CB2A DJNZ $CB12    ; Repeat for each corner.
 $CB2C LD B,(IX+$0B) ; The number of ticks along each edge.
 $CB2F LD E,(IX+$0C) ; The low byte of the address of the tick table.
 $CB32 LD D,(IX+$0D) ; The high byte of the address of the tick table.
@label=DrawFrame_Ticks
*$CB35 PUSH BC       ; Keep the number of ticks still to draw.
 $CB36 LD A,(DE)     ; The pixel column of this tick.
 $CB37 LD L,A        ; That column is its horizontal position.
 $CB38 LD H,(IX+$0E) ; The pixel row of the top edge.
 $CB3B PUSH DE       ; Keep the place in the tick table.
 $CB3C LD DE,$C94D   ; The top and bottom tick is #R$C94D.
 $CB3F CALL $C96F    ; Draw the tick on the top edge.
 $CB42 LD H,$BE      ; The bottom edge is pixel row #N$BE.
 $CB44 LD DE,$C94D   ; The same top and bottom tick.
 $CB47 CALL $C96F    ; Draw the tick on the bottom edge.
 $CB4A POP DE        ; Back to the tick table.
 $CB4B INC DE        ; The next byte is the pixel row of the side ticks.
 $CB4C LD A,(DE)     ; That row.
 $CB4D LD H,A        ; It is their vertical position.
 $CB4E LD L,$00      ; The left edge is pixel column zero.
 $CB50 PUSH DE       ; Keep the place in the tick table.
 $CB51 LD DE,$C955   ; The side tick is #R$C955.
 $CB54 CALL $C96F    ; Draw the tick on the left edge.
 $CB57 LD L,(IX+$0F) ; The pixel column of the right edge.
 $CB5A LD DE,$C955   ; The same side tick.
 $CB5D CALL $C96F    ; Draw the tick on the right edge.
 $CB60 POP DE        ; Back to the tick table.
 $CB61 INC DE        ; Move on to the next tick.
 $CB62 POP BC        ; Bring back the number of ticks.
 $CB63 DJNZ $CB35    ; Repeat for each tick.
 $CB65 RET           ; Return.

