; an item to carry, or the number of a part to fit }
; TABLE#
@label=ShipObject
g$C8E5 DEFB $00,$00,$60,$00,$08,$6F,$00,$00,$00,$00,$00,$00,$00,$47,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$60,$6F,$00

