 $7099 DEFB $40,$77,$58         ; Type #N($05), length #N($08), at #N($40) by
                                ; #N($77).
 $709C DEFB $40,$B7,$F4         ; Type #N($0F), length #N($04), at #N($40) by
                                ; #N($B7).
 $709F DEFB $A8,$97,$28         ; Type #N($02), length #N($08), at #N($A8) by
                                ; #N($97).
 $70A2 DEFB $A8,$B7,$E2         ; Type #N($0E), length #N($02), at #N($A8) by
                                ; #N($B7).
; Tiles #N($62), #N($9E).
 $70A5 DEFB $FF                 ; Prefix bytes.
 $70A6 DEFB $05                 ; Number of segments: #N(#PEEK(#PC)).
 $70A7 DEFB $40,$3B,$77,$11,$00 ; Type #N($07), length #N($07), at #N($40) by
                                ; #N($3B).
 $70AC DEFB $28,$97,$08,$10,$00 ; Type #N($00), length #N($08), at #N($28) by
                                ; #N($97).
 $70B1 DEFB $28,$2F,$B3         ; Type #N($0B), length #N($03), at #N($28) by
                                ; #N($2F).
 $70B4 DEFB $38,$37,$C1         ; Type #N($0C), length #N($01), at #N($38) by
                                ; #N($37).
 $70B7 DEFB $20,$97,$54         ; Type #N($05), length #N($04), at #N($20) by
                                ; #N($97).
; Tiles #N($63).
 $70BA DEFB $02                 ; Number of segments: #N(#PEEK(#PC)).
 $70BB DEFB $40,$77,$F6         ; Type #N($0F), length #N($06), at #N($40) by
                                ; #N($77).
 $70BE DEFB $08,$B7,$98         ; Type #N($09), length #N($08), at #N($08) by
                                ; #N($B7).
; Tiles #N($64).
 $70C1 DEFB $06                 ; Number of segments: #N(#PEEK(#PC)).
 $70C2 DEFB $60,$37,$02,$11,$13 ; Type #N($00), length #N($02), at #N($60) by
                                ; #N($37).
 $70C7 DEFB $60,$9B,$72,$11,$13 ; Type #N($07), length #N($02), at #N($60) by
                                ; #N($9B).
 $70CC DEFB $48,$67,$33         ; Type #N($03), length #N($03), at #N($48) by
                                ; #N($67).
 $70CF DEFB $58,$97,$D3         ; Type #N($0D), length #N($03), at #N($58) by
                                ; #N($97).
 $70D2 DEFB $A0,$67,$63         ; Type #N($06), length #N($03), at #N($A0) by
                                ; #N($67).
 $70D5 DEFB $90,$97,$A3         ; Type #N($0A), length #N($03), at #N($90) by
                                ; #N($97).

; Tune: Title Screen
;
; The notes of the tune that plays on the title screen, which end with
; #N($FF).
@label=TuneTitleScreen
b$70D8 DEFB $27,$27,$29,$2A,$29,$29,$2A,$2C
 $70E0 DEFB $2A,$2A,$2C,$2E,$2C,$2C,$2A,$29
 $70E8 DEFB $27,$27,$29,$2A,$29,$29,$2A,$2C
 $70F0 DEFB $2A,$2A,$2C,$2E,$2C,$2C,$2A,$29
 $70F8 DEFB $27,$1B,$29,$2A,$29,$1D,$2A,$2C
 $7100 DEFB $2A,$1E,$2C,$2E,$2C,$20,$2A,$25
 $7108 DEFB $27,$1B,$29,$2A,$29,$1D,$2A,$2C
 $7110 DEFB $2A,$1E,$2C,$2E,$2C,$20,$2A,$25
 $7118 DEFB $27,$1B,$27,$1B,$27,$1B,$27,$29
 $7120 DEFB $2A,$1E,$25,$1E,$25,$1E,$25,$27
 $7128 DEFB $23,$20,$23,$20,$23,$20,$63,$1E
 $7130 DEFB $22,$65,$19,$22,$66,$1B,$2C,$1B
 $7138 DEFB $1B,$2A,$1B,$29,$1B,$27,$27,$1B
 $7140 DEFB $27,$27,$1B,$27,$27,$1B,$2C,$1B
 $7148 DEFB $1B,$2A,$1B,$29,$1B,$27,$27,$1B
 $7150 DEFB $27,$27,$1B,$27,$27,$2E,$1E,$2E
 $7158 DEFB $2F,$31,$1E,$31,$2E,$2C,$1D,$2C
 $7160 DEFB $2E,$2F,$1D,$2F,$2C,$2A,$1B,$2A
 $7168 DEFB $2C,$2E,$1B,$2E,$2A,$29,$1A,$29
 $7170 DEFB $2A,$2C,$1A,$2A,$29,$27,$27,$29
 $7178 DEFB $2A,$29,$29,$2A,$2C,$2A,$2A,$2C
 $7180 DEFB $2E,$2C,$2C,$2A,$29,$27,$27,$29
 $7188 DEFB $2A,$29,$29,$2A,$2C,$2A,$2A,$2C
 $7190 DEFB $2E,$2C,$2C,$2A,$29,$27,$1B,$27
 $7198 DEFB $1B,$27,$1B,$27,$29,$2A,$1E,$25
 $71A0 DEFB $1E,$25,$1E,$25,$27,$23,$20,$23
 $71A8 DEFB $20,$23,$20,$63,$1E,$22,$65,$19
 $71B0 DEFB $22,$66,$1B,$2C,$1B,$1B,$2A,$1B
 $71B8 DEFB $29,$1B,$27,$27,$1B,$27,$27,$1B
 $71C0 DEFB $27,$27,$1B,$2C,$1B,$1B,$2A,$1B
 $71C8 DEFB $29,$1B,$27,$27,$1B,$27,$27,$1B
 $71D0 DEFB $27,$E7,$FF

; Make Click
;
; Used by the routines at #R$7293 and #R$72CF.
; .
; Makes a click with the speaker: the speaker is on for a time that is
; set by #REGb and off for a time that is set by #REGd. #R$7297 uses it to make
; noise.
; .
; #HTML(#AUDIO0(click.wav)(#INCLUDE(Click)))
;
; B Length of the time that the speaker is on
; D Length of the time that the speaker is off
@label=MakeClick
c$71D3 LD A,$10      ; Turn the speaker on.
 $71D5 OUT ($FE),A   ; Send that to the speaker.
@label=MakeClick_Delay
*$71D7 DJNZ $71D7    ; Hold the speaker on for the time in #REGb.
 $71D9 XOR A         ; Turn the speaker off.
 $71DA OUT ($FE),A   ; Send that to the speaker.
 $71DC LD B,D        ; The off-time becomes the delay.
@label=MakeClick_Wait
*$71DD DJNZ $71DD    ; Hold the speaker off for that time.
 $71DF RET           ; Return.
; View the equivalent code in;
; #LIST
; { #BUBBLER$9E86 }
; LIST#

; Play Square Wave
;
; Used by the routines at #R$71F0, #R$7217, #R$7234, #R$724C and #R$7263.
; .
; Makes one cycle of a square wave with the speaker. The speaker is on
; for as long as it is off, which is set by #REGb: the higher it is, the lower
; the note.
; .
; #HTML(#AUDIO0(beep.wav)(#INCLUDE(Beep)))
;
;   B Half the length of the cycle
; O:B Unchanged
@label=PlaySquareWave
c$71E0 LD A,$10      ; Turn the speaker on.
 $71E2 OUT ($FE),A   ; Send that to the speaker.
 $71E4 LD A,B        ; Keep the half-period.
@label=PlaySquareWave_Delay
*$71E5 DJNZ $71E5    ; Hold this half of the cycle.
 $71E7 LD B,A        ; Restore the half-period.
 $71E8 XOR A         ; Turn the speaker off.
 $71E9 OUT ($FE),A   ; Send that to the speaker.
 $71EB LD A,B        ; Keep the half-period again.
@label=PlaySquareWave_Wait
*$71EC DJNZ $71EC    ; Hold the other half of the cycle.
 $71EE LD B,A        ; Restore the half-period.
 $71EF RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B702 }
; { #BUBBLER$9E93 }
; { #GUNFRIGHT$AF66 }
; { #KNIGHTLORE$B4ED }
; { #MARTIANOIDS$C062 }
; { #NIGHTSHADE$C471 }
; { #PENTAGRAM$D682 }
; LIST#

; Play Arrival Sound
;
; Used by the routine at #R$DDBF.
; .
; Plays the sound that goes with the end of the scroll at the start of a
; life, which is a rising sweep of #N($20) beeps. The entry point at #R$71F4
; makes the beeps for any sweep.
; .
; #HTML(#AUDIO0(arrival-sound.wav)(#INCLUDE(ArrivalSound)))
@label=PlayArrivalSound
c$71F0 LD C,$20      ; The arrival sweep has #N($20) beeps.
 $71F2 LD D,$70      ; The lowest beep has half-period #N$70.
; This entry point is used by the routines at #R$71FE, #R$725C, #R$7275 and
; #R$7318.
@label=PlaySweep
*$71F4 LD A,C        ; The pitch starts at the number of beeps left.
 $71F5 ADD A,D       ; Add the base pitch.
 $71F6 LD B,A        ; That is the half-period of this beep.
 $71F7 CALL $71E0    ; Call #R$71E0.
 $71FA DEC C         ; One beep of the sweep has been played.
 $71FB JR NZ,$71F4   ; Jump to #R$71F4 if the zero flag is clear.
 $71FD RET           ; Return.

; Play Pick-Up Sound
;
; Used by the routine at #R$AAD7.
; .
; Plays the sound of the ship picking up an object, which is a rising
; sweep of #N($10) beeps.
; .
; #HTML(#AUDIO0(pick-up-sound.wav)(#INCLUDE(PickUpSound)))
@label=PlayPickUpSound
c$71FE LD C,$10      ; The pick-up sweep has #N($10) beeps.
 $7200 LD D,$40      ; The lowest beep has half-period #N$40.
 $7202 JR $71F4      ; Jump to #R$71F4.

; Play Unused Sound
;
; Not used. Makes a noise of #N($17) clicks.
; .
; #HTML(#AUDIO0(unused-sound.wav)(#INCLUDE(UnusedSound)))
@label=PlayUnusedSound
c$7204 LD C,$17      ; The unused noise has #N($17) clicks.
 $7206 LD E,C        ; Use that count as the click pattern.
 $7207 JP $7297      ; Jump to #R$7297.

; Play Object Warble
;
; Used by the routine at #R$96D8.
; .
; Does nothing once the ship is exploding (the counter at #R$8F53 is
; #N($0A) or more). Otherwise it makes a warble that depends on the age of the
; object at offset #N($15) of #REGix, and then carries on at #R$7217.
; .
; #HTML(#AUDIO0(object-warble.wav)(#INCLUDE(ObjectWarble)))
;
; IX Address of the object
@label=PlayObjectWarble
c$720A LD A,($8F53)  ; The ship state.
 $720D CP $0A        ; {Return if #REGa is #N$0A or more.
 $720F RET NC        ; }
 $7210 LD A,(IX+$15) ; Read offset #N$15 of #REGix.
 $7213 AND %00111111 ; Keep the bits of #REGa that are set in #N$3F.
 $7215 RR A          ; Rotate #REGa right through the carry.
; Continue on to #R$7217.

; Play Warble
;
; Used by the routine at #R$72AB.
; .
; Makes a warble of four beeps that alternate between two notes. Nothing
; is played if the stage is #N($10) or more or is #N($07) or #N($08).
; .
; #HTML(#AUDIO0(warble.wav)(#INCLUDE(Warble)))
;
; A Stage
@label=PlayWarble
c$7217 CP $10        ; {Return if #REGa is #N$10 or more.
 $7219 RET NC        ; }
 $721A CP $07        ; {Jump to #R$7221 if #REGa is less than #N$07.
 $721C JR C,$7221    ; }
 $721E CP $09        ; {Return if #REGa is less than #N$09.
 $7220 RET C         ; }
@label=PlayWarble_Play
*$7221 AND %00001111 ; Keep the bits of #REGa that are set in #N$0F.
 $7223 ADD A,A       ; Double the stage to spread the two notes.
 $7224 ADD A,$48     ; Add the base pitch of the warble.
 $7226 LD B,A        ; That is the first half-period.
 $7227 LD C,$04      ; The warble is four beeps.
@label=PlayWarble_Loop
*$7229 LD A,B        ; Start from the current half-period.
 $722A XOR %00101010 ; Flip the bits of #REGa that are set in #N$2A.
 $722C LD B,A        ; Keep the note for the next beep.
 $722D CALL $71E0    ; Call #R$71E0.
 $7230 DEC C         ; One beep of the warble has been played.
 $7231 JR NZ,$7229   ; Jump to #R$7229 if the zero flag is clear.
 $7233 RET           ; Return.

; Play Flutter Sound
;
; Used by the routine at #R$B414.
; .
; Plays a flutter of beeps for which the length and the notes depend on
; the frame counter.
; .
; #HTML(#AUDIO0(flutter-sound.wav)(#INCLUDE(FlutterSound)))
@label=PlayFlutterSound
c$7234 LD A,($9A64)  ; The frame counter.
 $7237 AND %00000111 ; Keep the bits of #REGa that are set in #N$07.
 $7239 INC A         ; The flutter is at least one beep long.
 $723A ADD A,A       ; Double the length of the flutter.
 $723B ADD A,A       ; Double the length again.
 $723C ADD A,A       ; Double the length once more.
 $723D LD D,A        ; That many half-periods will be played.
@label=PlayFlutterSound_Loop
*$723E LD A,D        ; The next note starts from the count left.
 $723F XOR %00000111 ; Flip the bits of #REGa that are set in #N$07.
 $7241 INC A         ; The half-period is one more than the count.
 $7242 LD B,A        ; That is the half-period of this beep.
 $7243 CALL $71E0    ; Call #R$71E0.
 $7246 DEC D         ; One count of the flutter has been used.
 $7247 RET Z         ; Return if the zero flag is set.
 $7248 DEC D         ; A second count has been used.
 $7249 RET Z         ; Return if the zero flag is set.
 $724A JR $723E      ; Jump to #R$723E.

; Play Hit Sound
;
; Used by the routines at #R$83D6, #R$8E2D, #R$8F54, #R$9015, #R$9020, #R$917C,
; #R$94A8 and #R$9572.
; .
; Plays a falling note of #N($10) beeps. It is used when an object is
; hit, destroyed or damaged.
; .
; #HTML(#AUDIO0(hit-sound.wav)(#INCLUDE(HitSound)))
@label=PlayHitSound
c$724C LD C,$10      ; The falling note has #N($10) beeps.
; This entry point is used by the routine at #R$72CA.
@label=PlayHitSound_Loop
*$724E LD A,C        ; The pitch starts at the number of beeps left.
 $724F ADD A,A       ; Double it.
 $7250 ADD A,A       ; Double it again, so the note falls quickly.
 $7251 CPL           ; Invert it so the note falls as the count does.
 $7252 AND %01111111 ; Keep the bits of #REGa that are set in #N$7F.
 $7254 LD B,A        ; That is the half-period of this beep.
 $7255 CALL $71E0    ; Call #R$71E0.
 $7258 DEC C         ; One beep of the falling note has been played.
 $7259 JR NZ,$724E   ; Jump to #R$724E if the zero flag is clear.
 $725B RET           ; Return.

; Play Change Sound
;
; Used by the routine at #R$F1BD.
; .
; Plays a rising sweep of #N($0A) beeps. It is used when the colour of
; the ship changes.
; .
; #HTML(#AUDIO0(change-sound.wav)(#INCLUDE(ChangeSound)))
@label=PlayChangeSound
c$725C LD C,$0A      ; The colour-change sweep has #N($0A) beeps.
 $725E LD D,$80      ; The lowest beep has half-period #N$80.
 $7260 JP $71F4      ; Jump to #R$71F4.

; Play Bump Sound
;
; Used by the routine at #R$BA21.
; .
; Plays #N($0F) beeps that alternate between a very low note and a high
; note. It is used when an object hits the terrain.
; .
; #HTML(#AUDIO0(bump-sound.wav)(#INCLUDE(BumpSound)))
@label=PlayBumpSound
c$7263 LD C,$0F      ; The bump is #N($0F) beeps.
@label=PlayBumpSound_Loop
*$7265 LD A,C        ; Take the number of beeps still left.
 $7266 XOR %00000010 ; Flip the bits of #REGa that are set in #N$02.
 $7268 AND %00000100 ; Keep the bits of #REGa that are set in #N$04.
 $726A ADD A,A       ; Double the selected pitch.
 $726B ADD A,A       ; Double it again.
 $726C ADD A,A       ; Double it once more.
 $726D LD B,A        ; That is the half-period of this beep.
 $726E CALL $71E0    ; Call #R$71E0.
 $7271 DEC C         ; One beep of the bump has been played.
 $7272 JR NZ,$7265   ; Jump to #R$7265 if the zero flag is clear.
 $7274 RET           ; Return.

; Play Moving Sound
;
; Used by the routine at #R$94A8.
; .
; Used by an object while it moves. Does nothing on even frames. If bit 6
; of offset #N($16) of the object is clear it plays a short sweep. If not it
; plays a different sweep, but only once every four frames.
; .
; #HTML(#AUDIO0(moving-sound.wav)(#INCLUDE(MovingSound)))
;
; IX Address of the object
@label=PlayMovingSound
c$7275 LD A,($9A64)   ; The frame counter.
 $7278 AND %00000001  ; Keep the bits of #REGa that are set in #N$01.
 $727A RET Z          ; Return if the zero flag is set.
 $727B LD C,$04       ; The short sweep has four beeps.
 $727D LD D,$0F       ; Its lowest beep has half-period #N$0F.
 $727F BIT 6,(IX+$16) ; {Jump to #R$71F4 if bit 6 of offset #N$16 of #REGix is
 $7283 JP Z,$71F4     ; clear.}
 $7286 LD A,($9A64)   ; The frame counter.
 $7289 AND %00000011  ; Keep the bits of #REGa that are set in #N$03.
 $728B RET NZ         ; Return if the zero flag is clear.
 $728C LD C,$03       ; The other sweep has three beeps.
 $728E LD D,$1B       ; Its lowest beep has half-period #N$1B.
 $7290 JP $71F4       ; Jump to #R$71F4.

; Play Crash Sound
;
; Used by the routine at #R$BA21.
; .
; Plays a burst of noise of #N($1C) clicks. It is used when the ship hits
; the terrain. The entry point at #R$7297 makes the noise for any number of
; clicks.
; .
; #HTML(#AUDIO0(crash-sound.wav)(#INCLUDE(CrashSound)))
@label=PlayCrashSound
c$7293 LD C,$1C      ; The crash is #N($1C) clicks.
@label=PlayCrashSound_Pattern
 $7295 LD E,$27      ; The crash uses pattern #N$27.
; This entry point is used by the routines at #R$7204, #R$72A5, #R$72AB,
; #R$72F2, #R$7303 and #R$7311.
@label=PlayNoise
*$7297 LD A,C        ; The click length starts from the clicks left.
 $7298 XOR E         ; Flip the bits of #REGa that are set in #REGe.
 $7299 ADD A,A       ; Double it to make the on-time.
 $729A LD B,A        ; That on-time is passed to the click.
 $729B AND %00011111 ; Keep the bits of #REGa that are set in #N$1F.
 $729D LD D,A        ; The low five bits are the off-time.
 $729E CALL $71D3    ; Call #R$71D3.
 $72A1 DEC C         ; One click of the noise has been played.
 $72A2 JR NZ,$7297   ; Jump to #R$7297 if the zero flag is clear.
 $72A4 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #BUBBLER$9ED1 }
; LIST#

; Play Short Crash Sound
;
; Used by the routines at #R$90A7 and #R$B6EC.
; .
; Plays a shorter burst of noise of eight clicks.
; .
; #HTML(#AUDIO0(short-crash-sound.wav)(#INCLUDE(ShortCrashSound)))
@label=PlayShortCrashSound
c$72A5 LD C,$08      ; The short crash is eight clicks.
 $72A7 LD E,$03      ; It uses pattern #N$03.
 $72A9 JR $7297      ; Jump to #R$7297.

; Play Explosion Sound
;
; Used by the routine at #R$8D42.
; .
; Plays the sound of the explosion of the ship, for each step of the
; counter at #R$8F53 until it reaches #N($2D). It makes a warble first and then
; either a falling note (every eighth step), noise (on the odd steps) or
; nothing.
; .
; #HTML(#AUDIO0(explosion-sound.wav)(#INCLUDE(ExplosionSound)))
@label=PlayExplosionSound
c$72AB LD A,($8F53)  ; The ship state.
 $72AE CP $2D        ; {Return if #REGa is #N$2D or more.
 $72B0 RET NC        ; }
 $72B1 SUB $0A       ; Subtract #N$0A from #REGa.
 $72B3 CALL $7217    ; Call #R$7217.
 $72B6 LD A,($8F53)  ; The ship state.
 $72B9 LD B,A        ; Keep the explosion step.
 $72BA AND %00000111 ; Keep the bits of #REGa that are set in #N$07.
 $72BC JR Z,$72CA    ; Jump to #R$72CA if the zero flag is set.
 $72BE BIT 0,B       ; {Return if bit 0 of #REGb is clear.
 $72C0 RET Z         ; }
 $72C1 LD A,B        ; The pattern comes from the step.
 $72C2 SRL A         ; Shift #REGa right.
 $72C4 LD E,A        ; That is the click pattern.
 $72C5 LD C,$0B      ; This step of the explosion is #N($0B) clicks.
 $72C7 JP $7297      ; Jump to #R$7297.

; Play Explosion Hit Sound
;
; Used by the routine at #R$72AB.
; .
; Plays a falling note of seven beeps, which #R$72AB uses every eighth
; step.
; .
; #HTML(#AUDIO0(explosion-hit-sound.wav)(#INCLUDE(ExplosionHitSound)))
@label=PlayExplosionHitSound
c$72CA LD C,$07      ; The eighth step is a falling note of seven beeps.
 $72CC JP $724E      ; Jump to #R$724E.

; Play Beam Sound
;
; Used by the routine at #R$9BDA.
; .
; Plays the noise of a beam, using clicks that depend on the first three
; bytes of the object of the beam.
; .
; #HTML(#AUDIO0(beam-sound.wav)(#INCLUDE(BeamSound)))
;
; IX Address of the beam
@label=PlayBeamSound
c$72CF LD A,(IX+$00) ; Read offset #N$00 of #REGix.
 $72D2 XOR (IX+$01)  ; Flip the bits of #REGa that are set in the byte at offset #N$01 of
                     ; #REGix.
 $72D5 AND %00001111 ; Keep the bits of #REGa that are set in #N$0F.
 $72D7 ADD A,$08     ; Add #N$08 to #REGa.
 $72D9 LD C,A        ; That is the number of clicks in the beam.
 $72DA LD A,(IX+$02) ; Read offset #N$02 of #REGix.
 $72DD AND %00011111 ; Keep the bits of #REGa that are set in #N$1F.
 $72DF LD E,A        ; The third byte is the click pattern.
@label=PlayBeamSound_Loop
*$72E0 LD A,C        ; Mix the clicks still left with the pattern.
 $72E1 ADD A,E       ; #REGa gains #REGe.
 $72E2 AND %00001111 ; Keep the bits of #REGa that are set in #N$0F.
 $72E4 ADD A,A       ; Double the mixed value.
 $72E5 LD B,A        ; Keep it as the on-time.
 $72E6 LD A,E        ; The off-time starts from the pattern.
 $72E7 ADD A,B       ; #REGa gains #REGb.
 $72E8 ADD A,A       ; Double the sum.
 $72E9 SUB B         ; Subtract #REGb from #REGa.
 $72EA LD D,A        ; That is the off-time of this click.
 $72EB CALL $71D3    ; Call #R$71D3.
 $72EE DEC C         ; One click of the beam has been played.
 $72EF JR NZ,$72E0   ; Jump to #R$72E0 if the zero flag is clear.
 $72F1 RET           ; Return.

; Play Shot Sound
;
; Used by the routine at #R$B752.
; .
; Plays noise that is used when a shot starts. The noise is different if
; bit 7 of offset #N($16) of the object is set.
; .
; #HTML(#AUDIO0(shot-sound.wav)(#INCLUDE(ShotSound)))
;
; IX Address of the object
@label=PlayShotSound
c$72F2 LD C,$0F       ; A normal shot is #N($0F) clicks.
 $72F4 LD E,$17       ; It uses pattern #N$17.
 $72F6 BIT 7,(IX+$16) ; {Jump to #R$7297 if bit 7 of offset #N$16 of #REGix is
 $72FA JP Z,$7297     ; clear.}
 $72FD LD C,E         ; The other shot uses the pattern as its length.
 $72FE LD E,$20       ; And pattern #N$20.
 $7300 JP $7297       ; Jump to #R$7297.

; Play Patterned Noise
;
; Used by the routine at #R$9572.
; .
; Plays noise for which the number of clicks and the pattern depend on a
; number.
; .
; #HTML(#AUDIO0(patterned-noise.wav)(#INCLUDE(PatternedNoise)))
;
; A Number from #N($00) to #N($03)
@label=PlayPatternedNoise
c$7303 ADD A,$02     ; Add #N$02 to #REGa.
 $7305 ADD A,A       ; Double the value.
 $7306 ADD A,A       ; Double it again to get the number of clicks.
 $7307 LD C,A        ; That is how many clicks are played.
 $7308 CPL           ; Invert #REGa.
 $7309 ADD A,$06     ; Add #N$06 to #REGa.
 $730B AND %00011111 ; Keep the bits of #REGa that are set in #N$1F.
 $730D LD E,A        ; That is the click pattern.
 $730E JP $7297      ; Jump to #R$7297.

; Play Noise Burst
;
; Used by the routine at #R$882B.
; .
; Plays a burst of noise of ten clicks.
; .
; #HTML(#AUDIO0(noise-burst.wav)(#INCLUDE(NoiseBurst)))
@label=PlayNoiseBurst
c$7311 LD C,$0A      ; The burst is ten clicks.
 $7313 LD E,$22      ; It uses pattern #N$22.
 $7315 JP $7297      ; Jump to #R$7297.

; Play Removal Sound
;
; Used by the routine at #R$900B.
; .
; Plays a rising sweep of ten beeps. It is used when an object is
; removed.
; .
; #HTML(#AUDIO0(removal-sound.wav)(#INCLUDE(RemovalSound)))
@label=PlayRemovalSound
c$7318 LD C,$0A      ; The removal sweep has ten beeps.
 $731A LD D,$18      ; The lowest beep has half-period #N$18.
 $731C JP $71F4      ; Jump to #R$71F4.

