 $9B51 DEFB $CB,$03,$1D
 $9B54 DEFB $A3,$03,$1F
 $9B57 DEFB $7D,$03,$21
 $9B5A DEFB $59,$03,$23
 $9B5D DEFB $38,$03,$25
 $9B60 DEFB $18,$03,$27
 $9B63 DEFB $FA,$02,$29
 $9B66 DEFB $DD,$02,$2C
 $9B69 DEFB $C2,$02,$2E
 $9B6C DEFB $A9,$02,$31
 $9B6F DEFB $91,$02,$34
 $9B72 DEFB $7B,$02,$37
 $9B75 DEFB $66,$02,$3A
 $9B78 DEFB $51,$02,$3E
 $9B7B DEFB $3F,$02,$41
 $9B7E DEFB $2D,$02,$45
 $9B81 DEFB $1C,$02,$49
 $9B84 DEFB $0C,$02,$4E
 $9B87 DEFB $FD,$01,$52
 $9B8A DEFB $EF,$01,$57
 $9B8D DEFB $E2,$01,$5D
 $9B90 DEFB $D5,$01,$62
