 $98C0 DEFW $797A
 $98C2 DEFW $7C38
 $98C4 DEFW $7C5A
 $98C6 DEFW $7C7C
 $98C8 DEFW $7CA8
 $98CA DEFW $7C9E
 $98CC DEFW $7CBB
 $98CE DEFW $7CB2
 $98D0 DEFW $7CBB
 $98D2 DEFW $C927
 $98D4 DEFW $98D8
 $98D6 DEFW $89CF
 $98D8 DEFB $02,$10,$07,$E0,$18,$18,$20,$04
 $98E0 DEFB $40,$02,$41,$82,$83,$C1,$84,$21
 $98E8 DEFB $8E,$71,$9E,$79,$BE,$7D,$9C,$39
 $98F0 DEFB $4F,$F0,$40,$02,$20,$04,$18,$18
