 $F209 DEFB $F8,$BE,$00,$07,$20,$01,$72 ; Bottom right
 $F210 DEFB $00,$07,$00,$B7,$01,$16,$72 ; Top left
 $F217 DEFB $F8,$07,$F8,$B7,$01,$16,$72 ; Top right

