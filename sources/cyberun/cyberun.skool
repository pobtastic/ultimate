 $A57D RET           ; Return.

; Find Buffer Address
;
; Used by the routine at #R$A303.
; .
; Finds the address in the buffer at #N($F800) of the top left of a sprite
; in the rectangle that is being drawn by #R$A303.
;
;   H Vertical position
;   L Horizontal position
; O:HL Address in the buffer
@label=FindBufferAddress
c$A57E LD A,($5C2C)  ; Fetch the left of the rectangle.
 $A581 LD C,A        ; Store it in #REGc.
 $A582 LD A,L        ; Fetch the horizontal position.
 $A583 SUB C         ; Subtract the left of the rectangle.
 $A584 SRL A         ; {Divide it by eight to get the number of bytes across.
 $A586 SRL A         ;
 $A588 SRL A         ; }
 $A58A LD L,A        ; Store it in #REGl.
 $A58B LD A,($5C2D)  ; Fetch the bottom of the rectangle.
 $A58E SUB H         ; Subtract the vertical position to get the number of rows
                     ; up.
 $A58F JR Z,$A59C    ; Jump to #R$A59C if the sprite is at the bottom.
 $A591 LD C,A        ; Store the number of rows in #REGc.
 $A592 LD A,($CE35)  ; Fetch the number of bytes in a row.
 $A595 LD H,A        ; Store it in #REGh.
@label=FindBufferAddress_Row
*$A596 LD A,L        ; Fetch the offset.
 $A597 ADD A,H       ; Add the number of bytes in a row.
 $A598 LD L,A        ; Store the offset.
 $A599 DEC C         ; Count the rows.
 $A59A JR NZ,$A596   ; Loop back to #R$A596 for each row.
@label=FindBufferAddress_Page
*$A59C LD H,$F8      ; Use the buffer.
 $A59E RET           ; Return.

; Draw Sprites Directly
;
; Used by the routines at #R$C27F, #R$C374, #R$C4ED, #R$C5FF and #R$C6D2.
; .
; Erases one sprite and draws another straight on the screen instead of
; using a buffer. The rows of the two sprites are dealt with one at a time,
; alternating between an erased row and a drawn row, so that they stay in step.
; The sprite that is lower on the screen starts first, as the rows of a
; sprite go up the screen, and its first rows are done by themselves until the
; other sprite starts. The sprites are set up by #R$A266 and #R$A27A, which
; store the number of rows at #N($5C1C) and #N($5C1D). The first sprite is
; erased using the alternate registers and the second sprite is drawn using
; the main registers.
;
; DE Address of the data of the second sprite
; DE' Address of the data of the first sprite
; HL Screen address of the second sprite
; HL' Screen address of the first sprite
; IX Routine that draws the second sprite
; IY Routine that erases the first sprite
@label=DrawSpritesDirectly
c$A59F LD A,L        ; Fetch the low byte of the screen address of the second
                     ; sprite.
 $A5A0 LD ($5C29),A  ; Store it as the start of a row.
 $A5A3 EXX           ; Switch to the first sprite.
 $A5A4 LD A,L        ; Fetch the low byte of its screen address.
 $A5A5 LD ($5C28),A  ; Store it as the start of a row.
 $A5A8 EXX           ; Switch back to the second sprite.
 $A5A9 LD A,($5C1D)  ; Fetch the number of rows of the second sprite.
 $A5AC EX AF,AF'     ; Keep it in the alternate accumulator.
 $A5AD LD A,($5C1C)  ; Fetch the number of rows of the first sprite.
 $A5B0 AND A         ; Test it.
 $A5B1 JP Z,$A61C    ; Jump to #R$A61C if the first sprite has no rows.
 $A5B4 LD A,($5C1D)  ; Fetch the number of rows of the second sprite.
 $A5B7 AND A         ; Test it.
 $A5B8 JP Z,$A61C    ; Jump to #R$A61C if the second sprite has no rows.
 $A5BB LD A,($A289)  ; Fetch the vertical position of the first sprite.
 $A5BE LD C,A        ; Store it in #REGc.
 $A5BF LD A,($A28A)  ; Fetch the vertical position of the second sprite.
 $A5C2 SUB C         ; Subtract the position of the first sprite.
 $A5C3 JP Z,$A61C    ; Jump to #R$A61C if they start on the same row.
 $A5C6 JR NC,$A5EB   ; Jump to #R$A5EB if the second sprite is the lower one.
; The first sprite is the lower one, so do its first rows by themselves.
 $A5C8 NEG           ; Make the difference positive.
 $A5CA LD C,A        ; Store it in #REGc.
 $A5CB LD A,($5C1C)  ; Fetch the number of rows of the first sprite.
 $A5CE SUB C         ; Take off the difference.
 $A5CF LD ($A289),A  ; Store it for later.
 $A5D2 JR C,$A5D8    ; Jump to #R$A5D8 if the first sprite has fewer rows than
                     ; that.
 $A5D4 LD A,C        ; Otherwise use the difference as the number of rows to
                     ; do.
 $A5D5 LD ($5C1C),A  ; Store it.
@label=DrawSpritesDirectly_First
*$A5D8 XOR A         ; Clear #REGa.
 $A5D9 EX AF,AF'     ; Make the second sprite have no rows for now.
 $A5DA CALL $A61C    ; Do the rows of the first sprite.
 $A5DD EXX           ; Switch to the second sprite.
 $A5DE LD A,($A289)  ; Fetch the number of rows that are left for the first
                     ; sprite.
 $A5E1 LD ($5C1C),A  ; Store it.
 $A5E4 LD A,($5C1D)  ; Fetch the number of rows of the second sprite.
 $A5E7 EX AF,AF'     ; Restore it.
 $A5E8 JP $A61C      ; Jump to #R$A61C to do the rows of both sprites.
; The second sprite is the lower one, so do its first rows by
; themselves.
@label=DrawSpritesDirectly_Second
*$A5EB LD C,A        ; Store the difference in #REGc.
 $A5EC LD A,($5C1D)  ; Fetch the number of rows of the second sprite.
 $A5EF SUB C         ; Take off the difference.
 $A5F0 LD ($A28A),A  ; Store it for later.
 $A5F3 JR C,$A5F7    ; Jump to #R$A5F7 if the second sprite has fewer rows than
                     ; that.
 $A5F5 LD A,C        ; Otherwise use the difference as the number of rows to
                     ; do.
 $A5F6 EX AF,AF'     ; Store it.
@label=DrawSpritesDirectly_SecondRows
*$A5F7 LD A,($5C1C)  ; Fetch the number of rows of the first sprite.
 $A5FA LD ($A289),A  ; Keep it.
 $A5FD XOR A         ; Clear #REGa.
 $A5FE LD ($5C1C),A  ; Make the first sprite have no rows for now.
 $A601 CALL $A61C    ; Do the rows of the second sprite.
 $A604 LD A,($A289)  ; Fetch the number of rows of the first sprite.
 $A607 LD ($5C1C),A  ; Restore it.
 $A60A LD A,($A28A)  ; Fetch the number of rows that are left for the second
                     ; sprite.
 $A60D EX AF,AF'     ; Store it.
 $A60E JP $A61C      ; Jump to #R$A61C to do the rows of both sprites.
; This entry point is used by the routine at #R$A66F.
@label=DrawSpritesDirectly_SecondRow
*$A611 EX AF,AF'     ; Switch to the count of the second sprite.
 $A612 LD A,($5C1C)  ; Fetch the number of rows of the first sprite.
 $A615 DEC A         ; Take one off.
 $A616 RET M         ; Return if there are none left.
 $A617 LD ($5C1C),A  ; Store it.
 $A61A JP (IY)       ; Erase a row of the first sprite.
; This entry point is used by the routine at #R$A678.
@label=DrawSpritesDirectly_Row
*$A61C LD A,($5C1C)  ; Fetch the number of rows of the first sprite.
 $A61F DEC A         ; Take one off.
 $A620 JP M,$A669    ; Jump to #R$A669 if there are none left.
 $A623 LD ($5C1C),A  ; Store it.
 $A626 EXX           ; Switch to the first sprite.
 $A627 JP (IY)       ; Erase a row of the first sprite.

; Erase Aligned Row Directly
;
; Erases one row of a sprite that is aligned to a byte from the screen.
; The entry point depends on the width of the sprite in bytes, from six bytes
; at #R$A629 to one byte at #R$A647. Each byte clears the pixels of the screen
; that are set in the sprite.
;
; DE' Address of the data of the sprite
; HL' Screen address of the row
@label=EraseAlignedRowDirectly
c$A629 LD A,(DE)     ; Fetch a byte of the sprite.
 $A62A CPL           ; Invert it.
 $A62B AND (HL)      ; Clear the pixels of the screen.
 $A62C LD (HL),A     ; Store the byte.
 $A62D INC L         ; Move on to the next byte of the screen.
 $A62E INC DE        ; Move on to the next byte of the sprite.
@label=EraseAlignedRowDirectly_Second
 $A62F LD A,(DE)     ; Fetch a byte of the sprite.
 $A630 CPL           ; Invert it.
 $A631 AND (HL)      ; Clear the pixels of the screen.
 $A632 LD (HL),A     ; Store the byte.
 $A633 INC L         ; Move on to the next byte of the screen.
 $A634 INC DE        ; Move on to the next byte of the sprite.
@label=EraseAlignedRowDirectly_Third
 $A635 LD A,(DE)     ; Fetch a byte of the sprite.
 $A636 CPL           ; Invert it.
 $A637 AND (HL)      ; Clear the pixels of the screen.
 $A638 LD (HL),A     ; Store the byte.
 $A639 INC L         ; Move on to the next byte of the screen.
 $A63A INC DE        ; Move on to the next byte of the sprite.
@label=EraseAlignedRowDirectly_Fourth
 $A63B LD A,(DE)     ; Fetch a byte of the sprite.
 $A63C CPL           ; Invert it.
 $A63D AND (HL)      ; Clear the pixels of the screen.
 $A63E LD (HL),A     ; Store the byte.
 $A63F INC L         ; Move on to the next byte of the screen.
 $A640 INC DE        ; Move on to the next byte of the sprite.
@label=EraseAlignedRowDirectly_Fifth
 $A641 LD A,(DE)     ; Fetch a byte of the sprite.
 $A642 CPL           ; Invert it.
 $A643 AND (HL)      ; Clear the pixels of the screen.
 $A644 LD (HL),A     ; Store the byte.
 $A645 INC L         ; Move on to the next byte of the screen.
 $A646 INC DE        ; Move on to the next byte of the sprite.
@label=EraseAlignedRowDirectly_Sixth
 $A647 LD A,(DE)     ; Fetch a byte of the sprite.
 $A648 CPL           ; Invert it.
 $A649 AND (HL)      ; Clear the pixels of the screen.
 $A64A LD (HL),A     ; Store the byte.
 $A64B INC DE        ; Move on to the next byte of the sprite.
; This entry point is used by the routine at #R$A7A4.
@label=EraseAlignedRowDirectly_Next
*$A64C LD A,($5C28)  ; Fetch the low byte of the screen address of the start of
                     ; the row.
 $A64F LD L,A        ; Restore it.
 $A650 DEC H         ; Move up a pixel row.
 $A651 LD A,H        ; Fetch the high byte.
 $A652 INC A         ; Add one.
 $A653 AND %00000111 ; Keep the bits that give the pixel row.
 $A655 JP NZ,$A66F   ; Jump to #R$A66F if the row is still in the same cell.
 $A658 LD A,L        ; Fetch the low byte.
 $A659 SUB $20       ; Move up a row of cells.
 $A65B LD L,A        ; Store it.
 $A65C LD ($5C28),A  ; Store it as the start of the row.
 $A65F JP C,$A66F    ; Jump to #R$A66F if that crossed a third of the screen.
 $A662 LD A,H        ; Fetch the high byte.
 $A663 ADD A,$08     ; Add eight to correct it.
 $A665 LD H,A        ; Store it.
 $A666 JP $A66F      ; Jump to #R$A66F.

; Next Row Of Second Sprite
;
; Used by the routine at #R$A59F.
; .
; Used by #R$A59F when the first sprite has no rows left: it carries on
; with the rows of the second sprite until they are done.
@label=NextRowOfSecondSprite
c$A669 EX AF,AF'     ; Switch to the count of the second sprite.
 $A66A DEC A         ; Take one off.
 $A66B RET M         ; Return if there are none left.
 $A66C EX AF,AF'     ; Switch back.
 $A66D JP (IX)       ; Draw a row of the second sprite.

; Draw Next Row
;
; Used by the routine at #R$A629.
; .
; Used by #R$A59F after a row of the first sprite has been erased: it
; draws a row of the second sprite, or erases another row of the first sprite
; when the second sprite has no rows left.
@label=DrawNextRow
c$A66F EX AF,AF'     ; Switch to the count of the second sprite.
 $A670 DEC A         ; Take one off.
 $A671 JP M,$A611    ; Jump to #R$A611 if there are none left.
 $A674 EX AF,AF'     ; Switch back.
 $A675 EXX           ; Switch to the second sprite.
 $A676 JP (IX)       ; Draw a row of the second sprite.

