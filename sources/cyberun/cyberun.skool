 $F18A DEFB $58,$A7,$44,$0B                                                 ; Control
                                                                            ; option
 $F18E DEFB $08,$0D,$13,$04,$11,$05,$00,$02,$04,$26,$25                     ; "INTERFACE
                                                                            ; II"
 $F199 DEFB $50,$BF,$72,$0C                                                 ; Copyright
 $F19D DEFB $26,$26,$00,$27,$02,$27,$06,$27,$1B,$23,$22,$1F                 ; "
