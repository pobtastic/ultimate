; Colour Ship
;
; Used by the routine at #R$C374.
; .
; Fills the attributes that the ship covers with its colour, which is
; white normally, yellow while the stack of units is full and cyan while the
; timer at #R$896F is running (changing back to the normal colour every eight
; frames during the last #N($20) frames). If the colour has changed it makes
; the sound at #R$725C.
@label=ColourShip
c$F1BD LD B,$47      ; #REGb=#N$47.
 $F1BF LD A,($C905)  ; The stack height.
 $F1C2 CP $12        ; {Jump to #R$F1C8 if #REGa is not #N$12.
 $F1C4 JR NZ,$F1C8   ; }
 $F1C6 LD B,$46      ; #REGb=#N$46.
@label=ColourShip_Timer
*$F1C8 LD C,B        ; #REGc=#REGb.
 $F1C9 LD A,($896F)  ; The falling timer.
 $F1CC AND A         ; {Jump to #R$F1DD if #REGa is zero.
 $F1CD JR Z,$F1DD    ; }
 $F1CF LD B,$45      ; #REGb=#N$45.
 $F1D1 CP $20        ; {Jump to #R$F1DD if #REGa is #N$20 or more.
 $F1D3 JR NC,$F1DD   ; }
 $F1D5 LD A,($9A64)  ; The frame counter.
 $F1D8 AND %00001000 ; Keep the bits of #REGa that are set in #N$08.
 $F1DA JR Z,$F1DD    ; Jump to #R$F1DD if the zero flag is set.
 $F1DC LD B,C        ; #REGb=#REGc.
@label=ColourShip_Fill
*$F1DD LD A,($F201)  ; The colour the ship was drawn in.
 $F1E0 CP B          ; Compare #REGa with #REGb.
 $F1E1 PUSH BC       ; Stash #REGbc on the stack.
 $F1E2 CALL NZ,$725C ; Call #R$725C if the zero flag is clear.
 $F1E5 POP BC        ; Bring #REGbc back off the stack.
 $F1E6 LD HL,($C902) ; Fetch the word at #N$C902 into #REGhl.
 $F1E9 LD A,($C1A9)  ; The height of the ship.
 $F1EC ADD A,$07     ; Add #N$07 to #REGa.
 $F1EE SRL A         ; Shift #REGa right.
 $F1F0 SRL A         ; Shift #REGa right.
 $F1F2 SRL A         ; Shift #REGa right.
 $F1F4 LD C,A        ; #REGc=#REGa.
 $F1F5 LD ($F200),BC ; The size and the new colour of the ship.
 $F1F9 LD DE,$F1FF   ; The ship attribute area.
 $F1FC JP $C991      ; Jump to #R$C991.

; Ship Attribute Area
;
; The area of attributes that #R$F1BD fills: the width, the height in
; rows and the attribute.
@label=ShipAttributeArea
g$F1FF DEFB $06,$02,$47

