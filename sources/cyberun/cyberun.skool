; Adjust Terrain Slope
;
; Used by the routine at #R$D9A8.
; .
; Works out how much to adjust the drawing of a terrain tile when it
; is next to a sloping tile. The tile codes #N$90 to #N$93 are the four slope
; tiles; the codes of the two tiles under consideration are held at #R$5C33 and
; #R$5C34.
;
;   E Direction flag set by the caller
;   IX Address of the object
; O:C Number of extra rows to draw
; O:L Adjusted vertical position
@label=AdjustTerrainSlope
c$8347 LD A,(IX+$01) ; Fetch the map column of the object.
 $834A AND A         ; Test it.
 $834B RET Z         ; Return if it is zero.
 $834C LD HL,($5C33) ; Fetch the two tile codes from #R$5C33 into #REGhl.
 $834F LD BC,$0000   ; Clear the adjustment (#REGb) and the extra row count
                     ; (#REGc).
 $8352 CALL $83A1    ; Check the first tile code.
 $8355 CALL $838B    ; Check the second tile code.
; Slope tile #N$91 can add an extra row.
 $8358 LD A,L        ; Fetch the first tile code.
 $8359 CP $91        ; {Jump to #R$8366 if it is not slope tile #N$91.
 $835B JR NZ,$8366   ; }
 $835D BIT 7,H       ; {Jump to #R$8366 if the second tile code is a special tile (bit 7 is
 $835F JR NZ,$8366   ; set).}
 $8361 LD A,E        ; Fetch the direction flag.
 $8362 AND A         ; {Test it and jump to #R$8366 if it is set.
 $8363 JR NZ,$8366   ; }
 $8365 INC C         ; Add an extra row.
; Slope tile #N$93 can add an extra row too.
@label=AdjustTerrainSlope_Tile93
*$8366 LD A,L        ; Fetch the first tile code.
 $8367 CP $93        ; {Jump to #R$837D if it is not slope tile #N$93.
 $8369 JR NZ,$837D   ; }
 $836B LD A,($CCBB)  ; Fetch the scroll speed from #R$CCBB.
 $836E AND A         ; Test it.
 $836F JR NZ,$8378   ; Jump to #R$8378 if the screen is scrolling.
 $8371 LD A,($BA8D)  ; Fetch the vertical position from #R$BA8D.
 $8374 AND %00000111 ; Test the bottom three bits.
 $8376 JR Z,$837D    ; Jump to #R$837D if they are all zero.
@label=AdjustTerrainSlope_AddRow
*$8378 LD A,E        ; Fetch the direction flag.
 $8379 AND A         ; Test it.
 $837A JR NZ,$837D   ; Jump to #R$837D if it is set.
 $837C INC C         ; Add an extra row.
; Return the adjusted vertical position and the extra row count.
@label=AdjustTerrainSlope_Return
*$837D LD HL,($BA8D) ; Fetch the position from #R$BA8D into #REGhl.
 $8380 LD A,L        ; {Add the adjustment in #REGb to the low byte of the
 $8381 ADD A,B       ; position.
 $8382 LD L,A        ; }
 $8383 LD A,$00      ; {Clear #REGa, then add the extra row count to it.
 $8385 ADD A,C       ; }
 $8386 LD C,A        ; Copy the extra row count back into #REGc.
 $8387 LD ($5C24),A  ; Store the extra row count in #R$5C24.
 $838A RET           ; Return.

; Adjust Second Slope Tile
;
; Used by the routine at #R$8347.
; .
; Looks at the second tile code of the pair for #R$8347.
;
;   C Extra row count
;   E Direction flag
; O:C Updated extra row count
@label=AdjustTerrainSlope_Second
c$838B LD A,($5C34)  ; Fetch the second tile code from #R$5C34.
 $838E CP $93        ; {Jump to #R$839C if it is slope tile #N$93.
 $8390 JR Z,$839C    ; }
 $8392 CP $92        ; {Jump to #R$8397 if it is slope tile #N$92.
 $8394 JR Z,$8397    ; }
 $8396 RET           ; Return, as no other tile needs adjusting.
@label=AdjustTerrainSlope_Second92
*$8397 LD A,E        ; Fetch the direction flag.
 $8398 AND A         ; Test it.
 $8399 RET Z         ; Return if it is clear.
 $839A INC C         ; Add an extra row.
 $839B RET           ; Return.
@label=AdjustTerrainSlope_Second93
*$839C LD A,E        ; Fetch the direction flag.
 $839D AND A         ; Test it.
 $839E RET NZ        ; Return if it is set.
 $839F INC C         ; Add an extra row.
 $83A0 RET           ; Return.

; Adjust First Slope Tile
;
; Used by the routine at #R$8347.
; .
; Looks at the first tile code of the pair for #R$8347.
;
;   C Extra row count
;   E Direction flag
;   L Vertical position
; O:B Adjustment
; O:C Updated extra row count
@label=AdjustTerrainSlope_First
c$83A1 LD A,($5C33)  ; Fetch the first tile code from #R$5C33.
 $83A4 CP $90        ; {Jump to #R$83B2 if it is slope tile #N$90.
 $83A6 JR Z,$83B2    ; }
 $83A8 CP $91        ; Is it slope tile #N$91?
 $83AA RET NZ        ; Return if not, as no other tile needs adjusting.
 $83AB LD A,E        ; Fetch the direction flag.
 $83AC AND A         ; Test it.
 $83AD JR Z,$83C7    ; Jump to #R$83C7 if it is clear.
 $83AF LD B,$07      ; Set the adjustment to #N$07.
 $83B1 RET           ; Return.
@label=AdjustTerrainSlope_First90
*$83B2 LD B,$07      ; Set the adjustment to #N$07.
 $83B4 LD A,E        ; Fetch the direction flag.
 $83B5 AND A         ; Test it.
 $83B6 RET Z         ; Return if it is clear.
 $83B7 LD B,$00      ; Clear the adjustment.
 $83B9 LD A,($CCBB)  ; Fetch the scroll speed from #R$CCBB.
 $83BC BIT 7,A       ; Is the scroll speed negative?
 $83BE RET NZ        ; Return if so.
 $83BF AND A         ; Test the scroll speed.
 $83C0 RET Z         ; Return if the screen is not scrolling.
 $83C1 LD A,L        ; {Fetch the bottom three bits of the vertical position.
 $83C2 AND $07       ; }
 $83C4 JR NZ,$83C7   ; Jump to #R$83C7 if they are not all zero.
 $83C6 INC C         ; Add an extra row.
@label=AdjustTerrainSlope_Scroll
*$83C7 LD A,($CCBB)  ; Fetch the scroll speed from #R$CCBB.
 $83CA NEG           ; Negate it.
 $83CC LD B,A        ; Use it as the adjustment.
 $83CD RET           ; Return.

; Print Text Repeatedly
;
; Used by the routines at #R$83D6, #R$CA3F and #R$F26C.
; .
; Calls #R$A115 several times with the same text record.
; .
; #PUSHS #UDGTABLE { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$83CE,stop=$83D5,clear=1,de=$F112,bc=$0C00,sp=$FE00)
; #SCR$02(repeated-title) } UDGTABLE# #POPS
;
; B Number of times to print the text
; DE Address of the text record
@label=PrintTextRepeatedly
c$83CE PUSH BC       ; Save the counter.
 $83CF CALL $A115    ; Print the text record.
 $83D2 POP BC        ; Restore the counter.
 $83D3 DJNZ $83CE    ; Decrease the counter by one and loop back to #R$83CE until none
                     ; remain.
 $83D5 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #BUBBLER$E1BD }
; LIST#

; Complete Planet
;
; Used by the routine at #R$F52A.
; .
; Shows the "planet completed" message and sets up the next planet. The
; text records at #R$84A9 are printed, with the name of the planet just
; finished and the name of the next planet filled in, then the player is
; rewarded with a sound and a short delay before new item sites are chosen
; for the next planet.
;
; .
;
; Print the first four lines of the message.
@label=CompletePlanet
c$83D6 LD DE,$84A9   ; Use the first text record at #R$84A9.
 $83D9 LD B,$04      ; Set a counter in #REGb for four records.
 $83DB CALL $83CE    ; Print the four text records.
; Fill in the name of the planet just completed.
 $83DE LD A,($F5F9)  ; Fetch the planet number from #R$F5F9.
 $83E1 ADD A,A       ; {Multiply it by sixteen, the length of a name in
 $83E2 ADD A,A       ; #R$8459.
 $83E3 ADD A,A       ;
 $83E4 ADD A,A       ; }
 $83E5 LD HL,$8459   ; {Use the table of planet names and add the offset.
 $83E8 CALL $9BCF    ; }
 $83EB LD DE,$8505   ; Use the planet name slot in the text record at #R$8501.
 $83EE LD C,$10      ; Set the length of the name in #REGc.
 $83F0 LDIR          ; Copy the name of the planet just finished into the text
                     ; record.
; Fill in the name of the next planet, wrapping round after the last one.
 $83F2 LD A,($F5F9)  ; Fetch the planet number again.
 $83F5 CP $04        ; {Jump to #R$8401 if it is not the last planet.
 $83F7 JR NZ,$8401   ; }
 $83F9 LD A,$FF      ; {Set the planet number to #N($FF), so that it wraps to zero when
 $83FB LD ($F5F9),A  ; incremented below.}
 $83FE LD HL,$8459   ; Use the first planet name.
@label=CompletePlanet_NextName
*$8401 LD DE,$8527   ; Use the planet name slot in the text record at #R$8523.
 $8404 LD C,$0F      ; Set the length of the name in #REGc.
 $8406 LDIR          ; Copy the name of the next planet into the text record.
; Print the planet names, then the rest of the message.
 $8408 LD DE,$8501   ; Use the text record at #R$8501.
 $840B CALL $A115    ; Print the record.
 $840E LD HL,$5268   ; {Set the screen position parameters in #R$96AC...
 $8411 LD ($96AC),HL ; }
 $8414 LD HL,$0A73   ; {...and #R$96AE.
 $8417 LD ($96AE),HL ; }
 $841A LD A,($F5F9)  ; {Move on to the next planet number.
 $841D INC A         ;
 $841E LD ($F5F9),A  ; }
 $8421 LD B,$04      ; Set a counter in #REGb for four records.
 $8423 CALL $83CE    ; Print the remaining four text records.
; Reward the player.
 $8426 LD A,$06      ; {Set the bytes at #R$F601 and #R$F602 to #N$06.
 $8428 LD ($F601),A  ;
 $842B LD ($F602),A  ; }
 $842E LD B,$0A      ; Set a counter in #REGb for #N$0A repetitions.
@label=CompletePlanet_Loop
*$8430 PUSH BC       ; Save the counter.
 $8431 LD BC,$5000   ; {Add #N$5000 points to the score of player one.
 $8434 CALL $925E    ; }
 $8437 CALL $724C    ; Play the explosion sound.
 $843A LD D,$FF      ; {Delay for a short while.
 $843C CALL $A802    ; }
 $843F POP BC        ; Restore the counter.
 $8440 DJNZ $8430    ; Decrease the counter by one and loop back to #R$8430 until none
                     ; remain.
; Choose the item sites for the next planet.
 $8442 LD DE,$F64C   ; Use the table of item sites for player two.
 $8445 LD IY,$61BB   ; Use the list of pool numbers at #R$61BB.
 $8449 CALL $6117    ; Choose the item sites.
 $844C LD A,($CA1C)  ; Fetch the player count flag from #R$CA1C.
 $844F INC A         ; {Turn it into a mask in #REGe.
 $8450 XOR $03       ;
 $8452 CPL           ;
 $8453 RRCA          ;
 $8454 RRCA          ;
 $8455 LD E,A        ; }
 $8456 JP $9A8A      ; Clear the table at #R$5C94 (masked with #REGe) and carry
                     ; on.

; Planet Names
;
; The names of the five planets, sixteen characters each, padded with
; spaces. The text uses the game's own character set: #N$00 to #N$19 are the
; letters "A" to "Z", #N$1A to #N$23 are the digits "0" to "9" and #N$26 is a
; space.
@label=PlanetNames
b$8459 DEFB $26,$26,$26,$26,$13,$08,$13,$00,$0D,$26,$1E,$26,$26,$26,$26,$26
 $8469 DEFB $26,$26,$26,$26,$06,$00,$0C,$0C,$00,$26,$1C,$21,$26,$26,$26,$26
 $8479 DEFB $26,$26,$26,$0F,$11,$0E,$13,$0E,$0D,$08,$14,$0C,$26,$26,$26,$26
 $8489 DEFB $26,$0C,$04,$06,$00,$0B,$0E,$0D,$26,$0F,$11,$08,$0C,$04,$26,$26
 $8499 DEFB $19,$00,$11,$13,$00,$0D,$26,$0F,$04,$0D,$03,$14,$0B,$0E,$12,$26

