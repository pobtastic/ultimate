 $9BBD DEFB $59,$01,$E9
 $9BC0 DEFB $54,$01,$F7

; Read Keyboard Port
;
; Used by the routines at #R$9A9A and #R$B16F.
; .
; Reads a row of keys, or all of them at once. The bits of the result
; that are set are the keys that are pressed.
;
;   A Row selector (the high byte of the port address)
; O:A Keys pressed in the bottom five bits
; O:F The zero flag is set if no key is pressed
@label=ReadKeyboardPort
c$9BC3 OUT ($FD),A   ; Output the selector to a port (this has no other
                     ; effect).
 $9BC5 IN A,($FE)    ; Read the row selected by #REGa.
 $9BC7 CPL           ; Invert the bits.
 $9BC8 AND %00011111 ; Keep the five bits for the keys.
 $9BCA RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B759 }
; { #GUNFRIGHT$D0DB }
; { #KNIGHTLORE$B5F7 }
; { #NIGHTSHADE$E239 }
; { #PENTAGRAM$B952 }
; LIST#

; Random Numbers
;
; The two random bytes made by the routine at #R$F23B, followed by the
; address of the next byte of memory it will mix in (high byte first).
@label=RandomNumbers
g$9BCB DEFB $17      ; First random byte.
 $9BCC DEFB $8E      ; Second random byte.
 $9BCD DEFB $A0,$00  ; Address of the next byte to mix in.

; Add A To HL
;
; Used by the routines at #R$6113, #R$83D6, #R$8690, #R$86E4, #R$882B, #R$89D3,
; #R$8CB2, #R$9234, #R$92B4, #R$938D, #R$9457, #R$9572, #R$96D8, #R$9724,
; #R$9AB4, #R$9BDA, #R$A1FB, #R$A303, #R$A8D9, #R$AA37, #R$AAD7, #R$AC08,
; #R$B09C, #R$C374, #R$C5FF, #R$DCA1, #R$E08F, #R$E114, #R$F311 and #R$F39E.
; .
; Adds an unsigned number to #REGhl.
;
;   A The number
;   HL The address
; O:HL The new address
@label=AddAToHL
c$9BCF ADD A,L       ; Add #REGa to #REGl.
 $9BD0 LD L,A        ; Copy it to #REGl.
 $9BD1 LD A,H        ; Fetch #REGh.
 $9BD2 ADC A,$00     ; Add #N$00 with carry.
 $9BD4 LD H,A        ; Copy it to #REGh.
 $9BD5 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CE06 }
; { #ATICATAC$926C }
; { #KNIGHTLORE$D4F2 }
; { #NIGHTSHADE$E596 }
; { #PENTAGRAM$B519 }
; LIST#

; Beam Variables
;
; The state shared by the four flickering beams drawn by #R$9BDA.
@label=BeamVariables
g$9BD6 DEFB $00      ; The pattern of the beams, which is zero while they are switched
                     ; off.
 $9BD7 DEFB $00      ; The attribute of the beams.
 $9BD8 DEFB $01      ; The number of frames until the beams change.
 $9BD9 DEFB $00      ; Set to #N$01 when at least one beam was drawn this
                     ; frame.

; Update Beams
;
; Used by the routine at #R$DDF8.
; .
; Draws, erases and flickers the horizontal beams that cross the screen
; from the visible map tiles numbered #N($A6), and hurts the ship when it
; touches one. There are up to four beams, one for each of the four tiles
; around the ship that are held at #N$DC91. The beams are switched on and off
; at random intervals with a random pattern and colour. A beam is skipped when
; the bit for its cell of the map is set in the three bytes from #N($F5EA),
; which are cleared when a planet is completed. What the tile #N($A6) looks
; like is not yet known.
@label=UpdateBeams
c$9BDA LD A,($5C3C)    ; Fetch the special sequence flag.
 $9BDD AND A           ; Test it.
 $9BDE RET NZ          ; Return if a special sequence (such as landing) is
                       ; under way.
 $9BDF LD A,($9D2F)    ; Fetch the delay left after the ship was last hit.
 $9BE2 AND A           ; Test it.
 $9BE3 JR Z,$9BEB      ; Jump to #R$9BEB if the delay is over.
 $9BE5 DEC A           ; Decrease the delay.
 $9BE6 LD ($9D2F),A    ; Store it.
 $9BE9 JR $9BFE        ; Jump to #R$9BFE.
; Set up the hit box of the ship, which is #N($28) by #N($10) pixels at
; the fixed horizontal position of #N($64).
@label=UpdateBeams_SetHitBox
*$9BEB LD A,($5C38)    ; Fetch the vertical position of the ship.
 $9BEE ADD A,$08       ; Move down by #N$08 to the top of the hit box.
 $9BF0 LD H,A          ; Store it in #REGh.
 $9BF1 LD L,$64        ; Set the horizontal position to #N$64.
 $9BF3 LD D,$10        ; Set the height to #N$10.
 $9BF5 LD E,$28        ; Set the width to #N$28.
 $9BF7 LD ($ABA4),HL   ; Store the position of the hit box.
 $9BFA LD ($ABA6),DE   ; Store the size of the hit box.
; Look for a map tile numbered #N$A6 around the ship, or a beam that is
; still being drawn.
@label=UpdateBeams_Look
*$9BFE LD B,$04        ; Set the counter to four.
 $9C00 LD IY,$9D43     ; Use the table of beams at #R$9D43.
 $9C04 LD HL,$DC91     ; Use the four tiles around the ship.
@label=UpdateBeams_LookLoop
*$9C07 LD A,(HL)       ; Fetch a tile.
 $9C08 CP $A6          ; {Jump to #R$9C1E if it is tile #N$A6.
 $9C0A JR Z,$9C1E      ; }
 $9C0C INC HL          ; Move on to the next tile.
 $9C0D LD A,(IY+$00)   ; Fetch the beam address.
 $9C10 AND A           ; Test it.
 $9C11 JR NZ,$9C1E     ; Jump to #R$9C1E if a beam is still being drawn.
 $9C13 INC IY          ; {Move on to the next beam.
 $9C15 INC IY          ;
 $9C17 INC IY          ;
 $9C19 INC IY          ; }
 $9C1B DJNZ $9C07      ; Loop back to #R$9C07 for each of the four.
 $9C1D RET             ; Return if there is nothing to do.
; Count down to the next change of the beams.
@label=UpdateBeams_Timer
*$9C1E LD IX,$9BD6     ; Use the beam variables.
 $9C22 DEC (IX+$02)    ; Decrease the timer.
 $9C25 JR NZ,$9C60     ; Jump to #R$9C60 unless it has run out.
 $9C27 LD (IX+$00),$00 ; Switch the beams off.
 $9C2B LD A,($9BCB)    ; Fetch a random number.
 $9C2E BIT 0,A         ; {Jump to #R$9C55 if the beams stay off.
 $9C30 JR Z,$9C55      ; }
; Choose the colour and pattern of the new beams.
 $9C32 LD A,($9BCC)    ; Fetch another random number.
 $9C35 AND %00000111   ; Keep the bottom three bits for the colour.
 $9C37 JR NZ,$9C3B     ; Jump to #R$9C3B unless the colour is black.
 $9C39 LD A,$05        ; Use cyan instead.
@label=UpdateBeams_Colour
*$9C3B LD B,A          ; Save the colour.
 $9C3C ADD A,$40       ; Make it bright.
 $9C3E LD (IX+$01),A   ; Set the attribute of the beams.
 $9C41 LD A,($9BCB)    ; Fetch the first random number again.
 $9C44 AND %00000111   ; Keep the bottom three bits.
 $9C46 XOR B           ; Combine them with the colour.
 $9C47 LD HL,$9DA9     ; Use the table of patterns.
 $9C4A CALL $9BCF      ; Add the index.
 $9C4D LD A,(HL)       ; Fetch a pattern.
 $9C4E LD (IX+$00),A   ; Set the pattern of the beams.
 $9C51 LD B,$1F        ; The beams stay on for up to #N$20 frames.
 $9C53 JR $9C57        ; Jump to #R$9C57.
@label=UpdateBeams_Off
*$9C55 LD B,$0F        ; The beams stay off for up to #N$10 frames.
; Choose how long it is until the next change.
@label=UpdateBeams_Interval
*$9C57 LD A,($9BCC)    ; Fetch a random number.
 $9C5A CPL             ; Invert it.
 $9C5B AND B           ; Limit it to the range chosen.
 $9C5C INC A           ; Make sure it is at least one.
 $9C5D LD (IX+$02),A   ; Set the timer.
; Now deal with each beam in turn. The beams are done in the order
; #N($00), #N($02), #N($01) and then #N($03).
@label=UpdateBeams_Beams
*$9C60 XOR A           ; Clear #REGa.
 $9C61 LD ($9BD9),A    ; Note that no beam has been drawn yet.
 $9C64 LD IY,$9D43     ; Use the table of beams.
@label=UpdateBeams_Next
*$9C68 LD ($5C1E),A    ; Store the number of the beam.
 $9C6B LD A,(IY+$00)   ; Fetch the screen address of the beam last drawn.
 $9C6E AND A           ; Test it.
 $9C6F JR Z,$9C80      ; Jump to #R$9C80 if there is no beam.
 $9C71 LD L,(IY+$00)   ; {Fetch the screen address into #REGhl.
 $9C74 LD H,(IY+$01)   ; }
 $9C77 LD B,(IY+$02)   ; Fetch the length of the beam into #REGb.
 $9C7A LD C,(IY+$03)   ; Fetch the pattern of the beam into #REGc.
 $9C7D CALL $9D25      ; Erase the beam.
@label=UpdateBeams_Erased
*$9C80 LD (IY+$00),$00 ; Forget the beam.
 $9C84 LD A,($5C1E)    ; Fetch the number of the beam.
 $9C87 LD HL,($CE57)   ; Fetch the position of the ship on the map.
 $9C8A BIT 0,A         ; {Jump to #R$9C8F if bit 0 of the beam number is clear.
 $9C8C JR Z,$9C8F      ; }
 $9C8E INC H           ; Move to the next row of the map.
@label=UpdateBeams_Row
*$9C8F BIT 1,A         ; {Jump to #R$9C94 if bit 1 of the beam number is clear.
 $9C91 JR Z,$9C94      ; }
 $9C93 INC L           ; Move to the next column of the map.
@label=UpdateBeams_Cell
*$9C94 EX DE,HL        ; Copy the position into #REGde.
 $9C95 CALL $AC08      ; Find the byte and bit that go with the cell.
 $9C98 LD A,B          ; Fetch the bit number...
 $9C99 ADD A,$46       ; ...and add the opcode of BIT 0,(HL) (#N$46).
 $9C9B LD ($9C9F),A    ; Modify the instruction at #R$9C9E to test that bit.
 $9C9E BIT 0,(HL)      ; {Jump to #R$9CEE if the bit of the cell is set.
 $9CA0 JR NZ,$9CEE     ; }
 $9CA2 LD HL,$DC91     ; Use the four tiles around the ship.
 $9CA5 LD A,($5C1E)    ; Fetch the number of the beam.
 $9CA8 CALL $9BCF      ; Add it to the address.
 $9CAB LD A,(HL)       ; Fetch the tile.
 $9CAC CP $A6          ; {Jump to #R$9CEE if it is not tile #N$A6.
 $9CAE JR NZ,$9CEE     ; }
 $9CB0 LD A,(IX+$00)   ; Fetch the pattern of the beams.
 $9CB3 AND A           ; Test it.
 $9CB4 JR Z,$9CEE      ; Jump to #R$9CEE if the beams are off.
 $9CB6 LD HL,($CE45)   ; Fetch the first scroll position.
 $9CB9 LD DE,($CE41)   ; Fetch the second scroll position.
 $9CBD CALL $9D53      ; Work out the extent of the beam.
 $9CC0 LD A,B          ; Fetch its length.
 $9CC1 AND A           ; Test it.
 $9CC2 JR Z,$9CEE      ; Jump to #R$9CEE if there is no beam.
 $9CC4 CALL $9D30      ; Draw the beam.
 $9CC7 LD HL,($BF83)   ; Fetch the position of the beam.
 $9CCA LD A,(IY+$02)   ; Fetch its length.
 $9CCD LD ($B625),A    ; Store it as the width of the attributes to colour.
 $9CD0 ADD A,A         ; {Multiply it by eight to get the length in pixels.
 $9CD1 ADD A,A         ;
 $9CD2 ADD A,A         ; }
 $9CD3 LD D,A          ; Store it in #REGd.
 $9CD4 LD A,($9D2F)    ; Fetch the delay left after the last hit.
 $9CD7 AND A           ; Test it.
 $9CD8 PUSH HL         ; Save the position.
 $9CD9 CALL Z,$9D0E    ; Check whether the ship has been hit, if the delay is
                       ; over.
 $9CDC POP HL          ; Restore the position.
 $9CDD LD A,(IX+$01)   ; Fetch the attribute of the beam.
 $9CE0 LD ($B627),A    ; Store it in the parameters.
 $9CE3 LD DE,$B625     ; Use the parameters.
 $9CE6 CALL $C991      ; Colour the beam.
 $9CE9 OR %00000001    ; Make #REGa non-zero.
 $9CEB LD ($9BD9),A    ; Note that a beam has been drawn.
@label=UpdateBeams_Advance
*$9CEE INC IY          ; {Move on to the next beam.
 $9CF0 INC IY          ;
 $9CF2 INC IY          ;
 $9CF4 INC IY          ; }
 $9CF6 LD A,($5C1E)    ; Fetch the number of the beam.
 $9CF9 CP $03          ; {Jump to #R$9D06 if it was the last, beam #N$03.
 $9CFB JR Z,$9D06      ; }
 $9CFD XOR %00000010   ; Choose the next beam.
 $9CFF JP NZ,$9C68     ; Jump to #R$9C68 if it is now beam #N$02 or #N$03.
 $9D02 INC A           ; Otherwise it is beam #N$01.
 $9D03 JP $9C68        ; Jump to #R$9C68.
@label=UpdateBeams_Sound
*$9D06 LD A,($9BD9)    ; Fetch the flag that says whether a beam was drawn.
 $9D09 AND A           ; Test it.
 $9D0A RET Z           ; Return if not.
 $9D0B JP $72CF        ; Make the sound of the beams.

; Check Beam Hit
;
; Used by the routine at #R$9BDA.
; .
; Checks whether the ship is touching a beam, and if so hurts it.
@label=CheckBeamHit
c$9D0E LD A,($96AB)  ; Fetch the delivery flag from #R$96AB.
 $9D11 AND A         ; Test it.
 $9D12 RET NZ        ; Return if it is set.
 $9D13 LD E,$01      ; Set the height of the beam to one pixel.
 $9D15 CALL $AB98    ; Test whether the beam touches the hit box of the ship.
 $9D18 LD A,($5C1C)  ; Fetch the result of the test.
 $9D1B AND A         ; Test it.
 $9D1C RET Z         ; Return if the beam missed.
 $9D1D LD A,$10      ; Wait #N$10 frames before the beam can hurt the ship
                     ; again.
 $9D1F LD ($9D2F),A  ; Store the delay.
 $9D22 JP $8F76      ; Damage the ship.

; Erase Beam
;
; Used by the routine at #R$9BDA.
; .
; Clears the pixels of a beam, which is a row of bytes that all share the
; same pattern.
;
; B Number of bytes
; C Pattern of each byte
; HL Screen address of the first byte
@label=EraseBeam
c$9D25 LD A,C        ; {Invert the pattern.
 $9D26 CPL           ;
 $9D27 LD C,A        ; }
@label=EraseBeam_Loop
*$9D28 LD A,C        ; Fetch the inverted pattern.
 $9D29 AND (HL)      ; {Clear the pixels.
 $9D2A LD (HL),A     ; }
 $9D2B INC L         ; Move on to the next byte of the row.
 $9D2C DJNZ $9D28    ; Loop back to #R$9D28 for each byte.
 $9D2E RET           ; Return.

; Beam Hit Delay
;
; The number of frames that remain before a beam can hurt the ship again.
@label=BeamHitDelay
g$9D2F DEFB $00

; Draw Beam
;
; Used by the routine at #R$9BDA.
; .
; Records a beam in the table at #R$9D43 and draws it.
;
; B Number of bytes
; C Pattern of each byte
; HL Screen address of the first byte
; IY Address of the entry in the table
@label=DrawBeam
c$9D30 LD (IY+$00),L ; Record the low byte of the screen address.
 $9D33 LD (IY+$01),H ; Record the high byte of the screen address.
 $9D36 LD (IY+$02),B ; Record the number of bytes.
 $9D39 LD (IY+$03),C ; Record the pattern.
@label=DrawBeam_Loop
*$9D3C LD A,C        ; Fetch the pattern.
 $9D3D OR (HL)       ; {Set the pixels.
 $9D3E LD (HL),A     ; }
 $9D3F INC L         ; Move on to the next byte of the row.
 $9D40 DJNZ $9D3C    ; Loop back to #R$9D3C for each byte.
 $9D42 RET           ; Return.

; Beam Table
;
; Four entries of four bytes, one for each beam that is currently drawn:
; the screen address (low byte first), the number of bytes and the pattern.
@label=BeamTable
g$9D43 DEFB $00,$00,$00,$00
 $9D47 DEFB $00,$00,$00,$00
 $9D4B DEFB $00,$00,$00,$00
 $9D4F DEFB $00,$00,$00,$00

; Find Beam Extent
;
; Used by the routine at #R$9BDA.
; .
; Works out where a beam is drawn and how long it is. The beam number
; is held at #N$5C1E: bit 0 selects the side of the screen on the horizontal
; axis and bit 1 selects the side on the vertical axis. The screen address that
; is returned is where the beam starts.
;
;   DE Second scroll position (from #N$CE41)
;   HL First scroll position (from #N$CE45)
;   IX Address of the beam variables
; O:B Length of the beam in bytes, or zero if there is no beam
; O:C Pattern of each byte, rotated to match the fine scroll
; O:HL Screen address of the start of the beam
@label=FindBeamExtent
c$9D53 LD B,$00      ; Start with a length of zero.
 $9D55 LD A,($5C1E)  ; Fetch the number of the beam.
 $9D58 BIT 0,A       ; Test bit 0.
 $9D5A LD A,H        ; Fetch the high byte of the first position.
 $9D5B JR NZ,$9D64   ; Jump to #R$9D64 if bit 0 is set.
 $9D5D CP $21        ; Is the position at least #N$21?
 $9D5F RET NC        ; Return if so, as there is no beam.
 $9D60 LD A,$81      ; Use #N$81 as the offset.
 $9D62 JR $9D69      ; Jump to #R$9D69.
@label=FindBeamExtent_Right
*$9D64 CP $21        ; Is the position below #N$21?
 $9D66 RET C         ; Return if so, as there is no beam.
 $9D67 LD A,$21      ; Use #N$21 as the offset.
@label=FindBeamExtent_Y
*$9D69 ADD A,D       ; Add the second position to get the vertical pixel
                     ; position.
 $9D6A LD D,A        ; Store it in #REGd.
 $9D6B LD A,($5C1E)  ; Fetch the number of the beam.
 $9D6E BIT 1,A       ; {Jump to #R$9D79 if bit 1 is set.
 $9D70 JR NZ,$9D79   ; }
 $9D72 LD A,$E8      ; Take the first position from #N$E8...
 $9D74 SUB L         ; ...to get the length in pixels.
 $9D75 LD E,$08      ; The beam starts at the horizontal position #N$08.
 $9D77 JR $9D80      ; Jump to #R$9D80.
@label=FindBeamExtent_Far
*$9D79 LD A,$E8      ; Add the second position to #N$E8...
 $9D7B ADD A,E       ; ...to get the horizontal start.
 $9D7C LD E,A        ; Store it in #REGe.
 $9D7D LD A,L        ; Fetch the first position.
 $9D7E SUB $08       ; Take #N$08 off to get the length in pixels.
@label=FindBeamExtent_Length
*$9D80 LD ($BF83),DE ; Store the start of the beam.
 $9D84 LD B,A        ; Copy the length in pixels.
 $9D85 AND %00000111 ; Keep the bottom three bits.
 $9D87 JR Z,$9D8D    ; Jump to #R$9D8D if the length is a whole number of
                     ; bytes.
 $9D89 LD A,B        ; Round the length up...
 $9D8A ADD A,$08     ; ...to the next whole byte.
 $9D8C LD B,A        ; Store it in #REGb.
@label=FindBeamExtent_Bytes
*$9D8D SRL B         ; {Divide the length by eight.
 $9D8F SRL B         ;
 $9D91 SRL B         ; }
 $9D93 RET Z         ; Return if the length is zero.
 $9D94 LD C,(IX+$00) ; Fetch the pattern of the beams.
 $9D97 LD A,($CE41)  ; Fetch the fine scroll.
 $9D9A AND %00000111 ; Keep the bottom three bits.
 $9D9C JR Z,$9DA3    ; Jump to #R$9DA3 if there is no fine scroll.
@label=FindBeamExtent_Rotate
*$9D9E RRC C         ; Rotate the pattern.
 $9DA0 DEC A         ; Count down.
 $9DA1 JR NZ,$9D9E   ; Loop back to #R$9D9E until the pattern matches the fine
                     ; scroll.
@label=FindBeamExtent_Address
*$9DA3 LD HL,($BF83) ; Fetch the start of the beam.
 $9DA6 JP $A149      ; Jump to #R$A149.

; Beam Patterns
;
; The eight patterns that a beam can have.
@label=BeamPatterns
g$9DA9 DEFB $E7,$E3,$C1,$81,$C3,$4D,$FF,$F7

; Test Boxes Overlap
;
; Used by the routines at #R$8E2D, #R$8ECA, #R$917C, #R$A8F4, #R$AB98 and
; #R$BA21.
; .
; Tests whether a box overlaps another box. The first box is described
; by four bytes: the horizontal position of the left edge, the vertical
; position, the width and the height. The vertical test passes when the
; vertical position of the first box minus that of the second is less than the
; height of the first box, or when the vertical position of the second box minus
; that of the first is less than the height of the second box.
;
;   D Width of the second box
;   E Height of the second box
;   H Vertical position of the second box
;   L Horizontal position of the second box
;   IX Address of the first box
; O:A Value of #N$5C1C
; O:F The zero flag is set if the boxes do not overlap
@label=TestBoxesOverlap
c$9DB1 CALL $9DBB    ; Test whether the boxes overlap horizontally.
 $9DB4 LD A,($5C1C)  ; Fetch the result.
 $9DB7 AND A         ; Test it.
 $9DB8 RET Z         ; Return if they do not.
 $9DB9 JR $9DD8      ; Jump to #R$9DD8 to test whether they overlap vertically.

; Test Horizontal Overlap
;
; Used by the routine at #R$9DB1.
; .
; Tests whether two boxes overlap horizontally. The result is stored in
; #N$5C1C.
;
; D Width of the second box
; L Horizontal position of the second box
; IX Address of the first box
@label=TestHorizontalOverlap
c$9DBB XOR A          ; Clear the result.
 $9DBC LD ($5C1C),A   ; Store it.
 $9DBF LD A,(IX+$00)  ; Fetch the left edge of the first box.
 $9DC2 SUB L          ; Subtract the left edge of the second box.
 $9DC3 JR C,$9DC8     ; Jump to #R$9DC8 if the first box starts to the left of
                      ; the second.
 $9DC5 CP D           ; Does the first box start within the width of the
                      ; second?
 $9DC6 JR C,$9DD2     ; Jump to #R$9DD2 if so.
@label=TestHorizontalOverlap_Left
*$9DC8 LD A,(IX+$00)  ; Fetch the left edge of the first box.
 $9DCB CP L           ; Is it to the right of the second box?
 $9DCC RET NC         ; Return if so, as the boxes do not overlap.
 $9DCD ADD A,(IX+$02) ; Add the width of the first box to get its right edge.
 $9DD0 CP L           ; Is it to the left of the second box?
 $9DD1 RET C          ; Return if so, as the boxes do not overlap.
; This entry point is used by the routines at #R$9DD8, #R$9E35 and #R$9E7A.
@label=SetOverlapFlag
*$9DD2 LD A,$01       ; Set the result to #N($01).
 $9DD4 LD ($5C1C),A   ; Store it.
 $9DD7 RET            ; Return.

; Test Vertical Overlap
;
; Used by the routine at #R$9DB1.
; .
; Tests whether two boxes overlap vertically. The result is stored in
; #N$5C1C.
;
; E Height of the second box
; H Vertical position of the second box
; IX Address of the first box
@label=TestVerticalOverlap
c$9DD8 XOR A         ; Clear the result.
 $9DD9 LD ($5C1C),A  ; Store it.
 $9DDC LD A,(IX+$01) ; Fetch the top of the first box.
 $9DDF SUB H         ; Subtract the position of the second box.
 $9DE0 CP (IX+$03)   ; Is it less than the height of the first box?
 $9DE3 JR C,$9DD2    ; Jump to #R$9DD2 if so.
 $9DE5 LD A,H        ; Fetch the position of the second box.
 $9DE6 SUB (IX+$01)  ; Subtract the top of the first box.
 $9DE9 CP E          ; Is it less than the height of the second box?
 $9DEA RET NC        ; Return if not, as the boxes do not overlap.
 $9DEB JP $9DD2      ; Jump to #R$9DD2.

; Find Slope Overlap
;
; Used by the routines at #R$9E35 and #R$9E7A.
; .
; Part of the test for a box touching an object with a sloping face. It
; checks the position of the box against the vertical limits of the object and
; works out how far up the slope the box reaches. Bit 7 of the byte at
; offset #N($04) of the object selects which way the slope runs. Purpose not
; yet known beyond this.
;
;   C Steepness of the slope
;   E Height of the box
;   H Vertical position of the box
;   L Horizontal position of the box
;   IX Address of the object
; O:B Distance up the slope
@label=FindSlopeOverlap
c$9DEE LD A,H         ; Fetch the vertical position of the box.
 $9DEF CP (IX+$03)    ; Compare it with the lower limit of the object.
 $9DF2 RET C          ; Return if it is below.
 $9DF3 BIT 7,(IX+$04) ; {Jump to #R$9E08 if bit 7 is set.
 $9DF7 JR NZ,$9E08    ; }
 $9DF9 CP (IX+$01)    ; Compare the position with the upper limit of the
                      ; object.
 $9DFC JR C,$9E16     ; Jump to #R$9E16 if it is below.
 $9DFE SUB E          ; Subtract the height of the box.
 $9DFF CP (IX+$01)    ; Compare it with the upper limit.
 $9E02 RET NC         ; Return if the box is entirely above the object.
 $9E03 LD H,(IX+$01)  ; Clip the vertical position to the upper limit.
 $9E06 JR $9E16       ; Jump to #R$9E16.
@label=FindSlopeOverlap_Reverse
*$9E08 SUB E          ; Subtract the height of the box.
 $9E09 LD H,A         ; Store it as the vertical position.
 $9E0A CP (IX+$01)    ; Compare it with the upper limit of the object.
 $9E0D RET NC         ; Return if it is above.
 $9E0E CP (IX+$03)    ; Compare it with the lower limit of the object.
 $9E11 JR NC,$9E16    ; Jump to #R$9E16 if it is above.
 $9E13 LD H,(IX+$03)  ; Clip the vertical position to the lower limit.
@label=FindSlopeOverlap_Horizontal
*$9E16 LD A,L         ; Fetch the horizontal position of the box.
 $9E17 CP (IX+$02)    ; Compare it with the horizontal limit of the object.
 $9E1A JR Z,$9E1D     ; Jump to #R$9E1D if they are the same.
 $9E1C RET NC         ; Return if the box is beyond the limit.
@label=FindSlopeOverlap_Found
*$9E1D LD A,$01       ; Set the result to #N($01).
 $9E1F LD ($5C1C),A   ; Store it.
 $9E22 LD A,(IX+$01)  ; Fetch the upper limit of the object.
 $9E25 SUB H          ; Subtract the vertical position to get the distance up
                      ; the slope.
 $9E26 LD B,A         ; Store it in #REGb.
 $9E27 LD A,C         ; Fetch the steepness of the slope.
 $9E28 CP $02         ; Is it #N($02)?
 $9E2A RET Z          ; Return if so.
 $9E2B SRL B          ; Halve the distance.
 $9E2D CP $03         ; Is the steepness #N($03)?
 $9E2F RET Z          ; Return if so.
 $9E30 SLA B          ; {Otherwise multiply the halved distance by four.
 $9E32 SLA B          ; }
 $9E34 RET            ; Return.

; Test Slope Collision
;
; Used by the routine at #R$BA21.
; .
; Tests whether a box touches an object with a sloping face. Bits 6 and 7
; of the byte at offset #N($04) of the object select one of four ways the slope
; can face, and the bottom three bits are the steepness. The result is stored
; in #N($5C1C), and when the box does touch the object the depth that it
; has gone into the slope is stored in #N($5C1A). The position of the box
; comes from #N($CE3A) and its size from #N($CE3C).
;
; IX Address of the object
@label=TestSlopeCollision
c$9E35 XOR A         ; Clear the result.
 $9E36 LD ($5C1C),A  ; Store it.
 $9E39 LD HL,($CE3A) ; Fetch the position of the box.
 $9E3C LD DE,($CE3C) ; Fetch the size of the box.
 $9E40 LD A,(IX+$04) ; Fetch the slope flags.
 $9E43 AND %00000111 ; Keep the steepness.
 $9E45 LD C,A        ; Store it in #REGc.
 $9E46 LD A,(IX+$04) ; Fetch the slope flags again.
 $9E49 AND %11000000 ; Keep the direction bits.
 $9E4B JR Z,$9E5D    ; Jump to #R$9E5D if both are clear.
 $9E4D CP $40        ; {Jump to #R$9EA5 if it is the second direction.
 $9E4F JP Z,$9EA5    ; }
 $9E52 CP $80        ; {Jump to #R$9EC0 if it is the third direction.
 $9E54 JP Z,$9EC0    ; }
 $9E57 CP $C0        ; {Jump to #R$9ED9 if it is the fourth direction.
 $9E59 JP Z,$9ED9    ; }
 $9E5C RET           ; Return.
@label=TestSlopeCollision_Down
*$9E5D CALL $9DEE    ; Find the overlap with the slope.
; This entry point is used by the routine at #R$9E7A.
@label=TestSlopeCollision_Depth
*$9E60 LD A,($5C1C)  ; Fetch the result.
 $9E63 AND A         ; Test it.
 $9E64 RET Z         ; Return if the box does not overlap.
 $9E65 DEC A         ; Reduce the result to zero.
 $9E66 LD ($5C1C),A  ; Store it.
 $9E69 LD A,D        ; Fetch the width of the box.
 $9E6A ADD A,L       ; Add the horizontal position.
 $9E6B LD L,A        ; Store it in #REGl.
 $9E6C LD A,(IX+$00) ; Fetch the left edge of the object.
 $9E6F ADD A,B       ; Add the distance up the slope.
 $9E70 SUB L         ; Subtract the right edge of the box.
 $9E71 RET NC        ; Return if the box is clear of the slope.
 $9E72 NEG           ; Make the depth positive.
 $9E74 LD ($5C1A),A  ; Store the depth.
 $9E77 JP $9DD2      ; Jump to #R$9DD2 to say that the box touches the slope.

; Find Mirrored Slope Overlap
;
; Finds the overlap with a slope that faces the other way by swapping
; the horizontal edges of the object, calling #R$9DEE and swapping them back.
;
; IX Address of the object
@label=FindMirroredSlopeOverlap
c$9E7A LD A,(IX+$00) ; Fetch the left edge of the object.
 $9E7D LD B,(IX+$02) ; Fetch the right limit of the object.
 $9E80 LD (IX+$00),B ; Store the right limit as the left edge.
 $9E83 LD (IX+$02),A ; Store the left edge as the right limit.
 $9E86 CALL $9DEE    ; Find the overlap with the slope.
 $9E89 LD A,(IX+$00) ; Fetch the left edge of the object.
 $9E8C LD C,(IX+$02) ; Fetch the right limit of the object.
 $9E8F LD (IX+$00),C ; Store the right limit as the left edge.
 $9E92 LD (IX+$02),A ; Store the left edge as the right limit.
 $9E95 LD A,($5C1C)  ; Fetch the result.
 $9E98 AND A         ; Test it.
 $9E99 RET Z         ; Return if the box does not overlap.
 $9E9A LD A,L        ; Fetch the horizontal position of the box.
 $9E9B ADD A,D       ; Add the width of the box.
 $9E9C CP (IX+$02)   ; Compare it with the right limit of the object.
 $9E9F RET NC        ; Return if it is further to the right.
 $9EA0 XOR A         ; Clear the result.
 $9EA1 LD ($5C1C),A  ; Store it.
 $9EA4 RET           ; Return.
; This entry point is used by the routine at #R$9E35.
@label=TestSlopeCollision_Mirrored
*$9EA5 CALL $9E7A    ; Find the overlap with the mirrored slope.
@label=TestSlopeCollision_MirroredDepth
*$9EA8 LD A,($5C1C)  ; Fetch the result.
 $9EAB AND A         ; Test it.
 $9EAC RET Z         ; Return if the box does not overlap.
 $9EAD DEC A         ; Reduce the result to zero.
 $9EAE LD ($5C1C),A  ; Store it.
 $9EB1 LD A,(IX+$00) ; Fetch the left edge of the object.
 $9EB4 SUB B         ; Subtract the distance up the slope.
 $9EB5 SUB L         ; Subtract the horizontal position of the box.
 $9EB6 RET C         ; Return if the box is clear of the slope.
 $9EB7 RET Z         ; Return if the depth is zero.
 $9EB8 NEG           ; Make the depth positive.
 $9EBA LD ($5C1A),A  ; Store the depth.
 $9EBD JP $9DD2      ; Jump to #R$9DD2 to say that the box touches the slope.
; This entry point is used by the routine at #R$9E35.
@label=TestSlopeCollision_Up
*$9EC0 CALL $9DEE    ; Find the overlap with the slope.
 $9EC3 LD A,B        ; Fetch the distance up the slope.
 $9EC4 NEG           ; Negate it.
 $9EC6 LD B,A        ; Store it.
 $9EC7 LD A,($5C1C)  ; Fetch the result.
 $9ECA AND A         ; Test it.
 $9ECB RET Z         ; Return if the box does not overlap.
 $9ECC LD A,L        ; Fetch the horizontal position of the box.
 $9ECD ADD A,D       ; Add the width of the box.
 $9ECE CP (IX+$00)   ; Compare it with the left edge of the object.
 $9ED1 JP NC,$9EA8   ; Jump to #R$9EA8 if it is further to the right.
 $9ED4 XOR A         ; Clear the result.
 $9ED5 LD ($5C1C),A  ; Store it.
 $9ED8 RET           ; Return.
; This entry point is used by the routine at #R$9E35.
@label=TestSlopeCollision_UpMirrored
*$9ED9 CALL $9E7A    ; Find the overlap with the mirrored slope.
 $9EDC LD A,B        ; Fetch the distance up the slope.
 $9EDD NEG           ; Negate it.
 $9EDF LD B,A        ; Store it.
 $9EE0 JP $9E60      ; Jump to #R$9E60.

; Read Pause Keys
;
; Used by the routines at #R$9F4E and #R$9F54.
; .
; Tests the SPACE and CAPS SHIFT keys.
;
; O:F The zero flag is set if either key is pressed
@label=ReadPauseKeys
c$9EE3 LD A,$7F      ; Select the keyboard row with SPACE.
 $9EE5 OUT ($FD),A   ; Put the row on the address lines.
 $9EE7 IN A,($FE)    ; Read the keyboard.
 $9EE9 AND %00000001 ; Keep the bit for SPACE.
 $9EEB RET Z         ; Return if SPACE is pressed.
 $9EEC LD A,$FE      ; Select the keyboard row with CAPS SHIFT.
 $9EEE OUT ($FD),A   ; Put the row on the address lines.
 $9EF0 IN A,($FE)    ; Read the keyboard.
 $9EF2 AND %00000001 ; Keep the bit for CAPS SHIFT.
 $9EF4 RET           ; Return.

; Fade Out And Clear Playfield
;
; Used by the routine at #R$F48B.
; .
; Dissolves the playfield pixel by pixel and then clears it.
@label=FadeOutAndClearPlayfield
c$9EF5 LD HL,$B708   ; Use the bottom left of the playfield.
 $9EF8 CALL $9EFE    ; Dissolve it.
 $9EFB JP $9F2C      ; Clear the playfield.

; Fade Out Playfield
;
; Used by the routine at #R$9EF5.
; .
; Dissolves the playfield, which is #N($1C) bytes wide and #N($A0) rows
; high, by sixteen passes that each clear some pixels using the patterns at
; #R$9F44.
;
; HL Position of the bottom left of the playfield
@label=FadeOutPlayfield
c$9EFE CALL $A149    ; Find the screen address.
 $9F01 LD DE,$9F44   ; Use the patterns.
 $9F04 LD ($CE3A),HL ; Store the screen address.
 $9F07 LD A,$10      ; Set the number of passes to sixteen.
@label=FadeOutPlayfield_Pass
*$9F09 EX AF,AF'     ; Save the number of passes.
 $9F0A LD HL,($CE3A) ; Fetch the screen address of the top left.
 $9F0D LD C,$A0      ; Set the number of rows to #N($A0).
@label=FadeOutPlayfield_Row
*$9F0F LD B,$1C      ; Set the number of bytes in a row to #N($1C).
 $9F11 PUSH HL       ; Save the address of the start of the row.
@label=FadeOutPlayfield_Byte
*$9F12 LD A,(DE)     ; Fetch a pattern.
 $9F13 AND (HL)      ; Clear some of the pixels of the byte of the screen.
 $9F14 LD (HL),A     ; Store the byte.
 $9F15 INC L         ; Move on to the next byte.
 $9F16 INC DE        ; Move on to the next pattern.
 $9F17 LD A,(DE)     ; Fetch it.
 $9F18 AND A         ; Test it.
 $9F19 JR NZ,$9F1E   ; Jump to #R$9F1E unless it is the end of the patterns.
 $9F1B LD DE,$9F44   ; Go back to the first pattern.
@label=FadeOutPlayfield_Next
*$9F1E DJNZ $9F12    ; Loop back to #R$9F12 for each byte of the row.
 $9F20 POP HL        ; Restore the address of the start of the row.
 $9F21 CALL $A1C3    ; Move up to the next row.
 $9F24 DEC C         ; Decrease the number of rows.
 $9F25 JR NZ,$9F0F   ; Loop back to #R$9F0F for each row.
 $9F27 EX AF,AF'     ; Restore the number of passes.
 $9F28 DEC A         ; Decrease it.
 $9F29 JR NZ,$9F09   ; Loop back to #R$9F09 for each pass.
 $9F2B RET           ; Return.

; Clear Playfield
;
; Used by the routines at #R$9EF5, #R$F422, #R$F4FC, #R$F52A and #R$F591.
; .
; Clears the pixels of the playfield, which is #N($1C) bytes wide and
; #N($A0) rows high.
; .
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After #R$9F2C }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$F26C,stop=$F2D0,clear=1,sp=$FE00)
; #SCR$02(playfield-before) |
; #SIM(start=$9F2C,stop=$9F43,sp=$FE00)
; #SCR$02(playfield-after) } UDGTABLE# #POPS
@label=ClearPlayfield
c$9F2C LD HL,$B708   ; Use the bottom left of the playfield.
 $9F2F CALL $A149    ; Find the screen address.
 $9F32 LD C,$A0      ; Set the number of rows to #N($A0).
@label=ClearPlayfield_Row
*$9F34 LD B,$1C      ; Set the number of bytes in a row to #N($1C).
 $9F36 PUSH HL       ; Save the address of the start of the row.
@label=ClearPlayfield_Byte
*$9F37 LD (HL),$00   ; Clear a byte.
 $9F39 INC HL        ; Move on to the next byte.
 $9F3A DJNZ $9F37    ; Loop back to #R$9F37 for each byte of the row.
 $9F3C POP HL        ; Restore the address of the start of the row.
 $9F3D CALL $A1C3    ; Move up to the next row.
 $9F40 DEC C         ; Decrease the number of rows.
 $9F41 JR NZ,$9F34   ; Loop back to #R$9F34 for each row.
 $9F43 RET           ; Return.

; Dissolve Patterns
;
; The masks used by #R$9EFE, ending with a zero.
@label=DissolvePatterns
b$9F44 DEFB $7F,$EF,$BF,$FF,$FE,$DF,$FB,$F7,$FD,$00

; Check Pause
;
; Used by the routine at #R$F48B.
; .
; Pauses the game if SPACE or CAPS SHIFT is pressed, and carries on once
; one of them is pressed again.
@label=CheckPause
c$9F4E CALL $9EE3    ; Test the pause keys.
 $9F51 RET NZ        ; Return if neither is pressed.
 $9F52 JR $9F5B      ; Jump to #R$9F5B.

; Check Pause And Silence
;
; Used by the routine at #R$C4ED.
; .
; As #R$9F4E, but first calls #R$C5FF when the game is about to pause.
@label=CheckPauseAndSilence
c$9F54 CALL $9EE3    ; Test the pause keys.
 $9F57 RET NZ        ; Return if neither is pressed.
 $9F58 CALL $C5FF    ; Call #R$C5FF.
; This entry point is used by the routine at #R$9F4E.
@label=CheckPause_WaitRelease
*$9F5B CALL $9F71    ; Wait a short while.
 $9F5E CALL $9EE3    ; Test the pause keys.
 $9F61 JR Z,$9F5B    ; Loop back to #R$9F5B until they are released.
@label=CheckPause_WaitPress
*$9F63 CALL $9F71    ; Wait a short while.
 $9F66 CALL $9EE3    ; Test the pause keys.
 $9F69 JR NZ,$9F63   ; Loop back to #R$9F63 until one is pressed.
@label=CheckPause_WaitReleaseAgain
*$9F6B CALL $9EE3    ; Test the pause keys.
 $9F6E JR Z,$9F6B    ; Loop back to #R$9F6B until they are released.
 $9F70 RET           ; Return.

; Short Delay
;
; Used by the routine at #R$9F54.
; .
; Waits for a short time.
@label=ShortDelay
c$9F71 LD D,$40      ; Set the delay.
 $9F73 JP $A802      ; Wait.

; Font
;
; The letters and symbols that are printed by #R$A115. Each glyph is
; seven bytes, stored from the bottom row to the top. The letters A to Z are
; numbered #N($00) to #N($19), the digits 0 to 9 are #N($1A) to #N($23), the
; space is #N($26) and the full stop is #N($27).
@label=Font
b$9F76 DEFB $8E,$8E,$8E,$FE,$8E,$8E,$FE
 $9F7D DEFB $FE,$E2,$E2,$FC,$E2,$E2,$FE
 $9F84 DEFB $FE,$8E,$8E,$80,$8E,$8E,$FE
 $9F8B DEFB $FC,$8E,$8E,$8E,$8E,$8E,$FE
 $9F92 DEFB $FE,$E0,$E0,$FE,$E0,$E0,$FC
 $9F99 DEFB $E0,$E0,$E0,$FE,$E0,$E0,$FE
 $9FA0 DEFB $FE,$8E,$9E,$80,$8E,$8E,$FE
 $9FA7 DEFB $E2,$E2,$E2,$FE,$E2,$E2,$E2
 $9FAE DEFB $38,$38,$38,$38,$38,$38,$38
 $9FB5 DEFB $7C,$1C,$1C,$1C,$1C,$1C,$1C
 $9FBC DEFB $8E,$8E,$8E,$FC,$E2,$E2,$E2
 $9FC3 DEFB $7C,$70,$70,$70,$70,$70,$70
 $9FCA DEFB $BA,$BA,$BA,$BA,$BA,$BA,$FE
 $9FD1 DEFB $8E,$8E,$8E,$8E,$8E,$8E,$FE
 $9FD8 DEFB $FE,$E2,$E2,$E2,$E2,$E2,$FE
 $9FDF DEFB $E0,$E0,$FE,$E2,$E2,$E2,$FE
 $9FE6 DEFB $FE,$EC,$EC,$EC,$EC,$FC,$FC
 $9FED DEFB $8E,$8E,$8E,$FC,$E2,$E2,$FE
 $9FF4 DEFB $FE,$8E,$8E,$1E,$E0,$E2,$FE
 $9FFB DEFB $38,$38,$38,$38,$38,$38,$FE
 $A002 DEFB $FE,$E2,$E2,$E2,$E2,$E2,$E2
 $A009 DEFB $18,$3C,$7E,$E2,$E2,$E2,$E2
 $A010 DEFB $FE,$B9,$B9,$B9,$B9,$B9,$B9
 $A017 DEFB $8E,$8E,$8E,$7C,$E2,$E2,$E2
 $A01E DEFB $38,$38,$FE,$E2,$E2,$E2,$E2
 $A025 DEFB $FE,$8E,$E0,$38,$0E,$E2,$FE
 $A02C DEFB $FE,$F2,$EA,$EA,$EA,$E6,$FE
 $A033 DEFB $1C,$1C,$1C,$1C,$1C,$1C,$3C
 $A03A DEFB $FE,$8E,$80,$FE,$0E,$8E,$FC
 $A041 DEFB $FE,$8E,$0E,$3C,$0E,$8E,$FE
 $A048 DEFB $1C,$1C,$FE,$9C,$9C,$9C,$FC
 $A04F DEFB $FE,$8E,$0E,$FE,$80,$8E,$FE
 $A056 DEFB $FE,$8E,$8E,$FE,$80,$82,$FE
 $A05D DEFB $38,$38,$1C,$1C,$8E,$8E,$FE
 $A064 DEFB $FE,$8E,$8E,$7C,$E2,$E2,$FE
 $A06B DEFB $FE,$E2,$02,$FE,$E2,$E2,$FE
 $A072 DEFB $00,$00,$00,$00,$00,$00,$00
 $A079 DEFB $FE,$6C,$6C,$6C,$6C,$6C,$FE
 $A080 DEFB $00,$00,$00,$00,$00,$00,$00
 $A087 DEFB $18,$18,$00,$00,$00,$00,$00
 $A08E DEFB $00,$00,$7E,$7E,$00,$00,$00
 $A095 DEFB $00,$00,$00,$00,$04,$03,$03
 $A09C DEFB $00,$00,$0F,$1F,$0F,$00,$00
 $A0A3 DEFB $00,$00,$FF,$FF,$FF,$00,$00
 $A0AA DEFB $00,$00,$F0,$F8,$F0,$00,$00
; View the equivalent code in;
; #LIST
; { #BUBBLER$64E0 }
; LIST#

; Print Character
;
; Used by the routine at #R$A115.
; .
; Prints one character of text. The character is drawn from the bottom
; row to the top, so the screen address moves up the screen. The instruction at
; #R$A0C9 is changed by #R$A115 to either carry straight on or to jump to
; #R$A0DB, which prints wide characters.
;
;   B' Attribute
;   DE Address of the character code
;   HL Screen address
;   HL' Attribute address
; O:HL Screen address of the next character
; O:HL' Attribute address of the next character
@label=PrintCharacter
c$A0B1 PUSH DE       ; Save the address of the character code.
 $A0B2 LD A,(DE)     ; Fetch the character code.
 $A0B3 PUSH HL       ; Save the screen address.
 $A0B4 LD L,A        ; {Multiply the character code by eight...
 $A0B5 LD H,$00      ;
 $A0B7 ADD HL,HL     ;
 $A0B8 ADD HL,HL     ;
 $A0B9 ADD HL,HL     ; }
 $A0BA LD E,A        ; {...and subtract the character code to get seven times
 $A0BB LD D,$00      ; the code.
 $A0BD AND A         ;
 $A0BE SBC HL,DE     ; }
 $A0C0 LD DE,$9F76   ; {Add the address of the font to get the address of the
 $A0C3 ADD HL,DE     ; glyph.}
 $A0C4 EX DE,HL      ; Put the address of the glyph in #REGde.
 $A0C5 POP HL        ; Fetch the screen address.
 $A0C6 PUSH HL       ; Save it again.
 $A0C7 LD B,$07      ; Set the number of rows of the glyph to seven.
@label=PrintCharacter_Mode
*$A0C9 JR $A0C9      ; Jump to #R$A0CB for narrow characters, or to #R$A0DB for
                     ; wide ones.
@label=PrintCharacter_Row
*$A0CB LD A,(DE)     ; Fetch a row of the glyph.
 $A0CC LD (HL),A     ; Draw it.
 $A0CD INC DE        ; Move on to the next row of the glyph.
 $A0CE CALL $A1C3    ; Move up a row of the screen.
 $A0D1 DJNZ $A0CB    ; Loop back to #R$A0CB for each of the seven rows.
 $A0D3 EXX           ; Switch to the attribute registers.
 $A0D4 LD (HL),B     ; Set the attribute of the character.
 $A0D5 INC HL        ; Move on to the next attribute cell.
 $A0D6 EXX           ; Switch back to the screen registers.
 $A0D7 POP HL        ; Restore the screen address.
 $A0D8 INC HL        ; Move on to the next character cell.
 $A0D9 POP DE        ; Restore the address of the character code.
 $A0DA RET           ; Return.
; View the equivalent code in;
; #LIST
; { #BUBBLER$A97A }
; LIST#

; Print Wide Character
;
; Prints one character of text at double width, using the table at
; #N$5C84 to double each nibble of the glyph into a byte. The character takes
; two cells across and two cells high of attributes.
;
;   B' Attribute
;   DE Address of the character code
;   DE' Value of #N($0020)
;   HL Screen address
;   HL' Attribute address
; O:HL Screen address two cells to the right
; O:HL' Attribute address two cells to the right
@label=PrintWideCharacter
c$A0DB LD A,$07      ; Set the number of rows to seven.
 $A0DD LD B,$5C      ; Use the table of doubled nibbles.
@label=PrintWideCharacter_Row
*$A0DF EX AF,AF'     ; Save the number of rows.
 $A0E0 LD A,(DE)     ; Fetch a row of the glyph.
 $A0E1 SRL A         ; {Move the top nibble to the bottom.
 $A0E3 SRL A         ;
 $A0E5 SRL A         ;
 $A0E7 SRL A         ; }
 $A0E9 ADD A,$84     ; Add the offset of the table to the nibble.
 $A0EB LD C,A        ; Put it in #REGc.
 $A0EC LD A,(BC)     ; Fetch the doubled nibble.
 $A0ED LD (HL),A     ; Draw it on the left.
 $A0EE DEC H         ; Move up a pixel row.
 $A0EF LD (HL),A     ; Draw it again.
 $A0F0 INC H         ; Move back down.
 $A0F1 INC HL        ; Move on to the right cell.
 $A0F2 LD A,(DE)     ; Fetch the row of the glyph again.
 $A0F3 AND %00001111 ; Keep the bottom nibble.
 $A0F5 ADD A,$84     ; Add the offset of the table.
 $A0F7 LD C,A        ; Put it in #REGc.
 $A0F8 LD A,(BC)     ; Fetch the doubled nibble.
 $A0F9 LD (HL),A     ; Draw it on the right.
 $A0FA DEC H         ; Move up a pixel row.
 $A0FB LD (HL),A     ; Draw it again.
 $A0FC DEC HL        ; Move back to the left cell.
 $A0FD INC DE        ; Move on to the next row of the glyph.
 $A0FE CALL $A1C3    ; Move up a row of the screen.
 $A101 EX AF,AF'     ; Restore the number of rows.
 $A102 DEC A         ; Decrease it.
 $A103 JR NZ,$A0DF   ; Loop back to #R$A0DF for each row.
 $A105 EXX           ; Switch to the attribute registers.
 $A106 LD (HL),B     ; Set the attribute of the cell at the left.
 $A107 SBC HL,DE     ; Move up to the attribute cell above.
 $A109 LD (HL),B     ; Set its attribute.
 $A10A INC HL        ; Move on to the right.
 $A10B LD (HL),B     ; Set the attribute of the cell above on the right.
 $A10C ADD HL,DE     ; Move back down.
 $A10D LD (HL),B     ; Set the attribute of the cell on the right.
 $A10E INC HL        ; Move on to the next cell.
 $A10F EXX           ; Switch back to the screen registers.
 $A110 POP HL        ; Restore the screen address.
 $A111 INC HL        ; {Move on two cells.
 $A112 INC HL        ; }
 $A113 POP DE        ; Restore the address of the character code.
 $A114 RET           ; Return.

; Print Text
;
; Used by the routines at #R$83CE, #R$83D6, #R$925E, #R$CA31, #R$F4EE and
; #R$F4FC.
; .
; Prints a line of text. The text is held in a record made of the
; horizontal pixel position, the vertical pixel position, the attribute, the
; number of characters and then the characters. Bit 7 of the attribute makes
; the text wide.
; .
; #PUSHS #UDGTABLE { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$A115,stop=$A148,clear=1,de=$F112,sp=$FE00)
; #SCR$02(printed-title) } UDGTABLE# #POPS
;
;   DE Address of the text record
; O:DE Address of the byte after the record
@label=PrintText
c$A115 XOR A         ; Select normal characters.
 $A116 LD ($A0CA),A  ; Change the instruction at #R$A0C9 to match.
 $A119 LD A,(DE)     ; {Fetch the horizontal position.
 $A11A LD L,A        ; }
 $A11B INC DE        ; Move on to the vertical position.
 $A11C LD A,(DE)     ; Fetch the vertical position.
 $A11D LD H,A        ; Move on to the attribute.
 $A11E INC DE        ; Save the address of the attribute.
 $A11F PUSH DE       ; Save the position.
 $A120 PUSH HL       ; {Find the screen address.
 $A121 CALL $A149    ; }
 $A124 EXX           ; Switch to the attribute registers.
 $A125 POP HL        ; Restore the position.
 $A126 CALL $A170    ; Find the attribute address.
 $A129 POP DE        ; Restore the address of the attribute.
 $A12A LD A,(DE)     ; Fetch the attribute.
 $A12B BIT 7,A       ; {Jump to #R$A13A if the text is not wide.
 $A12D JR Z,$A13A    ; }
 $A12F LD A,$10      ; Select wide characters.
 $A131 LD ($A0CA),A  ; Change the instruction at #R$A0C9 to match.
 $A134 LD A,(DE)     ; Fetch the attribute again.
 $A135 AND %01111111 ; Remove the flag.
 $A137 LD DE,$0020   ; Set the offset between rows of attributes.
@label=PrintText_Attribute
*$A13A LD B,A        ; Store the attribute.
 $A13B EXX           ; Switch back to the screen registers.
 $A13C INC DE        ; Move on to the number of characters.
 $A13D LD A,(DE)     ; Fetch it.
 $A13E LD B,A        ; Store it in #REGb.
@label=PrintText_Loop
*$A13F PUSH BC       ; Save the number of characters.
 $A140 INC DE        ; Move on to the next character.
 $A141 CALL $A0B1    ; Print the character.
 $A144 POP BC        ; Restore the number of characters.
 $A145 DJNZ $A13F    ; Loop back to #R$A13F for each character.
 $A147 INC DE        ; Move on to the byte after the record.
 $A148 RET           ; Return.

; Get Screen Address
;
; Used by the routines at #R$9D53, #R$9EFE, #R$9F2C, #R$A115, #R$A266, #R$A28B,
; #R$A303, #R$A8A5, #R$AA37, #R$C27F, #R$C374, #R$C4ED, #R$C5FF, #R$C6D2,
; #R$C96F, #R$CC77, #R$D937, #R$D9A8 and #R$DD79.
; .
; Finds the address in the display file of a pixel position. The
; vertical position is the number of the row of pixels, counted from the top
; of the screen, so #N($BF) is the bottom row.
;
;   H Vertical position
;   L Horizontal position
; O:HL Screen address
@label=GetScreenAddress
c$A149 LD A,L        ; Fetch the horizontal position.
 $A14A RRC A         ; {Divide it by eight.
 $A14C RRC A         ;
 $A14E RRC A         ; }
 $A150 AND %00011111 ; Keep the five bits of the column.
 $A152 LD L,A        ; Store it in #REGl.
 $A153 LD A,H        ; Fetch the vertical position.
 $A154 RLC A         ; {Multiply it by four.
 $A156 RLC A         ; }
 $A158 AND %11100000 ; Keep the bits that give the row of the cell.
 $A15A OR L          ; Combine them with the column.
 $A15B LD L,A        ; Store the low byte of the address.
 $A15C LD A,H        ; Fetch the vertical position.
 $A15D AND %00000111 ; Keep the bits that give the pixel row within the cell.
 $A15F EX AF,AF'     ; Save them.
 $A160 LD A,H        ; Fetch the vertical position.
 $A161 RRC A         ; {Divide it by eight.
 $A163 RRC A         ;
 $A165 RRC A         ; }
 $A167 AND %00011000 ; Keep the bits that give the third of the screen.
 $A169 OR %01000000  ; Add the address of the display file.
 $A16B LD H,A        ; Store the high byte of the address.
 $A16C EX AF,AF'     ; Restore the pixel row.
 $A16D OR H          ; Combine it with the high byte.
 $A16E LD H,A        ; Store the high byte of the address.
 $A16F RET           ; Return.
; View the equivalent code in;
; #LIST
; { #BUBBLER$A9FE }
; LIST#

; Find Attribute Address
;
; Used by the routines at #R$A115, #R$C032, #R$C4ED, #R$C991, #R$C9B3 and
; #R$CF38.
; .
; Finds the address in the attribute file of a pixel position. The
; vertical position is the number of the row of pixels, counted from the top
; of the screen.
;
;   H Vertical position
;   L Horizontal position
; O:HL Attribute address
@label=AttributeAddress
c$A170 PUSH BC       ; Stash #REGbc on the stack.
 $A171 LD A,L        ; Fetch the horizontal position.
 $A172 RRC A         ; {Divide it by eight.
 $A174 RRC A         ;
 $A176 RRC A         ; }
 $A178 AND %00011111 ; Keep the five bits of the column.
 $A17A LD L,A        ; Store it in #REGl.
 $A17B LD A,H        ; Fetch the vertical position.
 $A17C RLC A         ; {Multiply it by four.
 $A17E RLC A         ; }
 $A180 LD C,A        ; Keep a copy.
 $A181 AND %11100000 ; Keep the bits that give the row of the cell.
 $A183 OR L          ; Combine them with the column.
 $A184 LD L,A        ; Store the low byte of the address.
 $A185 LD A,C        ; Fetch the multiplied vertical position.
 $A186 AND %00000011 ; Keep the bits that give the third of the screen.
 $A188 OR %01011000  ; Add the address of the attribute file.
 $A18A LD H,A        ; Store the high byte of the address.
 $A18B POP BC        ; Bring #REGbc back off the stack.
 $A18C RET           ; Return.

; Run Object Handler
;
; Used by the routine at #R$8D42.
; .
; Jumps to the routine that handles an object, which is picked from the
; table at #R$AF25 by the type of the object.
;
; IX Address of the object
@label=RunObjectHandler
c$A18D LD A,(IX+$00) ; Fetch the type of the object.
 $A190 SUB $13       ; Take off #N($13), the first type with a handler.
 $A192 LD E,A        ; {Put the result in #REGde.
 $A193 LD D,$00      ; }
 $A195 LD HL,$AF25   ; Use the table of handlers.
 $A198 ADD HL,DE     ; {Add the offset twice to get the address of the entry.
 $A199 ADD HL,DE     ; }
 $A19A LD A,(HL)     ; {Fetch the address of the handler into #REGhl.
 $A19B INC HL        ;
 $A19C LD H,(HL)     ;
 $A19D LD L,A        ; }
 $A19E JP (HL)       ; Jump to the handler.

; Fetch Object Frame Table
;
; Used by the routines at #R$C032, #R$C4ED and #R$C7A3.
; .
; Fetches the entry for the type of an object from the table at #R$AF3D.
;
;   IX Address of the object
; O:DE The entry
@label=FetchObjectFrameTable
c$A19F LD C,(IX+$00) ; Fetch the type of the object.
 $A1A2 LD HL,$AF3D   ; Use the table.
 $A1A5 CALL $A1AA    ; Fetch the entry.
 $A1A8 EX DE,HL      ; Put it in #REGde.
 $A1A9 RET           ; Return.

; Get Table Entry
;
; Used by the routines at #R$97DF, #R$A19F, #R$A234, #R$A247, #R$AA37, #R$B09C
; and #R$B897.
; .
; Fetches a word from a table.
;
;   C Index
;   HL Address of the table
; O:HL The word
@label=GetTableEntry
c$A1AA LD B,$00      ; Clear #REGb.
 $A1AC ADD HL,BC     ; {Add the index twice to get the address of the entry.
 $A1AD ADD HL,BC     ; }
 $A1AE LD A,(HL)     ; Fetch the low byte.
 $A1AF INC HL        ; Move on to the high byte.
 $A1B0 LD H,(HL)     ; Fetch the high byte.
 $A1B1 LD L,A        ; Put the low byte in #REGl.
 $A1B2 RET           ; Return.

; Move Up A Row In DE
;
; Used by the routines at #R$A8A5 and #R$CACB.
; .
; Moves a screen address up one pixel row.
;
;   DE Screen address
; O:DE Screen address of the row above
@label=MoveUpARowDE
c$A1B3 DEC D         ; Move up a pixel row.
 $A1B4 LD A,D        ; Fetch the high byte of the address.
 $A1B5 INC A         ; Add one.
 $A1B6 AND %00000111 ; Keep the bits that give the pixel row.
 $A1B8 RET NZ        ; Return if the row is still in the same cell.
 $A1B9 LD A,E        ; Fetch the low byte of the address.
 $A1BA SUB $20       ; Move up a row of cells.
 $A1BC LD E,A        ; Store it.
 $A1BD RET C         ; Return if that crossed a third of the screen.
 $A1BE LD A,D        ; Fetch the high byte of the address.
 $A1BF ADD A,$08     ; Add eight to correct it.
 $A1C1 LD D,A        ; Store it.
 $A1C2 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #NIGHTSHADE$C28A }
; LIST#

; Move Up A Row
;
; Used by the routines at #R$9EFE, #R$9F2C, #R$A0B1, #R$A0DB, #R$AA37, #R$B336,
; #R$B356, #R$C96F, #R$CACB, #R$CBAE, #R$D86A, #R$DB29, #R$DB5B, #R$DCA1 and
; #R$E41C.
; .
; Moves a screen address up one pixel row.
;
;   HL Screen address
; O:HL Screen address of the row above
@label=MoveUpARow
c$A1C3 DEC H         ; Move up a pixel row.
 $A1C4 LD A,H        ; Fetch the high byte of the address.
 $A1C5 INC A         ; Add one.
 $A1C6 AND %00000111 ; Keep the bits that give the pixel row.
 $A1C8 RET NZ        ; Return if the row is still in the same cell.
 $A1C9 LD A,L        ; Fetch the low byte of the address.
 $A1CA SUB $20       ; Move up a row of cells.
 $A1CC LD L,A        ; Store it.
 $A1CD RET C         ; Return if that crossed a third of the screen.
 $A1CE LD A,H        ; Fetch the high byte of the address.
 $A1CF ADD A,$08     ; Add eight to correct it.
 $A1D1 LD H,A        ; Store it.
 $A1D2 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9F03 }
; { #LUNARJETMAN$85F6 }
; LIST#

; Sprite Positions
;
; The positions and sizes of the two sprites that are drawn together by
; #R$A303. The first sprite is the one that is erased and the second sprite is
; the one that is drawn.
@label=SpritePositions
g$A1D3 DEFB $00      ; Horizontal position of the first sprite.
 $A1D4 DEFB $00      ; Vertical position of the first sprite.
 $A1D5 DEFB $00      ; Horizontal position of the second sprite.
 $A1D6 DEFB $00      ; Vertical position of the second sprite.
 $A1D7 DEFB $00      ; Number of rows of the first sprite.
 $A1D8 DEFB $00      ; Number of rows of the second sprite.

; Clip Second Sprite
;
; Used by the routines at #R$AD48 and #R$C032.
; .
; Fetches the header of the second sprite and clips it to the playfield.
;
;   DE Address of the sprite
; O:B Number of rows
; O:C Index of the routine that draws the sprite
; O:DE Address of the first row of data
; O:H Width in bytes
@label=ClipSecondSprite
c$A1D9 LD HL,($A1D5) ; Fetch the position of the second sprite.
 $A1DC CALL $A223    ; Read the header of the sprite.
 $A1DF LD A,($A1D6)  ; Fetch the vertical position.
 $A1E2 CALL $A1FB    ; Clip the sprite at the top and bottom of the playfield.
 $A1E5 LD A,L        ; Fetch the clipped vertical position.
 $A1E6 LD ($A1D6),A  ; Store it.
 $A1E9 RET           ; Return.

; Clip First Sprite
;
; Used by the routines at #R$AD27 and #R$C032.
; .
; Fetches the header of the first sprite and clips it to the playfield.
;
;   DE Address of the sprite
; O:B Number of rows
; O:C Index of the routine that draws the sprite
; O:DE Address of the first row of data
; O:H Width in bytes
@label=ClipFirstSprite
c$A1EA LD HL,($A1D3) ; Fetch the position of the first sprite.
 $A1ED CALL $A223    ; Read the header of the sprite.
 $A1F0 LD A,($A1D4)  ; Fetch the vertical position.
 $A1F3 CALL $A1FB    ; Clip the sprite at the top and bottom of the playfield.
 $A1F6 LD A,L        ; Fetch the clipped vertical position.
 $A1F7 LD ($A1D4),A  ; Store it.
 $A1FA RET           ; Return.

; Clip Sprite Vertically
;
; Used by the routines at #R$A1D9 and #R$A1EA.
; .
; Clips a sprite so that it lies between #N($17) and #N($B7) on the
; vertical axis, which is the playfield. The position of a sprite is its bottom
; row and its rows go up from there, so rows below the playfield are skipped
; by moving on the address of the data, and rows above it are not drawn.
;
;   A Vertical position
;   B Number of rows
;   DE Address of the first row of data
;   H Width in bytes
; O:B Number of rows to draw
; O:DE Address of the first row of data to draw
; O:L Vertical position of the first row to draw
@label=ClipSpriteVertically
c$A1FB LD L,A        ; Store the vertical position.
 $A1FC SUB $17       ; Subtract #N($17), the top of the playfield.
 $A1FE SUB B         ; Subtract the number of rows.
 $A1FF JR NC,$A206   ; Jump to #R$A206 if the sprite does not go past the top.
 $A201 LD A,L        ; Fetch the vertical position.
 $A202 SUB $17       ; Subtract #N($17) to get the number of rows that fit.
 $A204 LD B,A        ; Store it as the number of rows.
 $A205 RET           ; Return.
@label=ClipSpriteVertically_Top
*$A206 LD A,L        ; Fetch the vertical position.
 $A207 SUB $B7       ; Subtract #N($B7), the bottom of the playfield.
 $A209 RET Z         ; Return if the sprite starts exactly at the bottom.
 $A20A RET C         ; Return if the sprite starts above the bottom.
 $A20B LD L,A        ; Store the number of rows that are below the bottom.
 $A20C LD A,B        ; Fetch the number of rows.
 $A20D SUB L         ; Take off the rows that are below the bottom.
 $A20E LD B,A        ; Store it.
 $A20F XOR A         ; Clear #REGa.
@label=ClipSpriteVertically_Skip
*$A210 ADD A,H       ; Add the width for each row that is below the bottom.
 $A211 DEC L         ; Count down.
 $A212 JR NZ,$A210   ; Loop back to #R$A210 for each row.
 $A214 EX DE,HL      ; Put the address of the data in #REGhl.
 $A215 CALL $9BCF    ; Skip the data for the rows below the bottom.
 $A218 EX DE,HL      ; Put the address back in #REGde.
 $A219 LD L,$B7      ; Start at the bottom of the playfield.
 $A21B RET           ; Return.

; Read Sprite Size
;
; Used by the routine at #R$C4ED.
; .
; Reads the width and the number of rows from the header of a sprite.
;
;   DE Address of the sprite
; O:B Number of rows
; O:DE Address of the first row of data
; O:H Width in bytes
@label=ReadSpriteSize
c$A21C LD A,(DE)     ; Fetch the width.
 $A21D LD H,A        ; Store it in #REGh.
 $A21E INC DE        ; Move on to the number of rows.
 $A21F LD A,(DE)     ; Fetch it.
 $A220 LD B,A        ; Store it in #REGb.
 $A221 INC DE        ; Move on to the data.
 $A222 RET           ; Return.

; Read Sprite Header
;
; Used by the routines at #R$A1D9 and #R$A1EA.
; .
; Reads the width and the number of rows from the header of a sprite and
; works out which of the routines that draw sprites to use. Sprites that are not
; aligned to a byte (a horizontal position that has bits 1 and 2 not both
; clear) need a routine that shifts the sprite, which are the first five entries
; of the tables at #R$A294 and #R$A2AA.
;
;   DE Address of the sprite
;   L Horizontal position
; O:B Number of rows
; O:C Index of the routine that draws the sprite
; O:DE Address of the first row of data
; O:H Width in bytes
@label=ReadSpriteHeader
c$A223 LD A,(DE)     ; Fetch the width.
 $A224 LD H,A        ; Store it in #REGh.
 $A225 LD C,A        ; Copy it to #REGc.
 $A226 DEC C         ; Take one off to get the index for a sprite that must be
                     ; shifted.
 $A227 INC DE        ; Move on to the number of rows.
 $A228 LD A,(DE)     ; Fetch it.
 $A229 LD B,A        ; Store it in #REGb.
 $A22A INC DE        ; Move on to the data.
 $A22B LD A,L        ; Fetch the horizontal position.
 $A22C AND %00000110 ; Only bits 1 and 2.
 $A22E RET NZ        ; Return if the sprite must be shifted.
 $A22F LD A,$05      ; Add five to the index for a sprite that is aligned.
 $A231 ADD A,C       ; {Store it in #REGc.
 $A232 LD C,A        ; }
 $A233 RET           ; Return.

; Select Erase Sprite
;
; Used by the routines at #R$AD27 and #R$C032.
; .
; Sets up the first sprite, which is the sprite that is erased by
; #R$A303.
;
;   B Number of rows
;   C Index of the routine that erases the sprite
;   H Width in bytes
; O:B High byte of the shift table to use
; O:IY Address of the routine that erases the sprite
@label=SelectEraseSprite
c$A234 LD A,B        ; Fetch the number of rows.
 $A235 LD ($A1D7),A  ; Store it.
 $A238 LD A,H        ; Fetch the width.
 $A239 LD ($5C28),A  ; Store it.
 $A23C LD HL,$A294   ; Use the table of routines that erase sprites.
 $A23F CALL $A1AA    ; Fetch the address of the routine.
 $A242 PUSH HL       ; {Put it in #REGiy.
 $A243 POP IY        ; }
 $A245 JR $A25D      ; Jump to #R$A25D.

; Select Draw Sprite
;
; Used by the routines at #R$AD48 and #R$C032.
; .
; Sets up the second sprite, which is the sprite that is drawn by
; #R$A303.
;
;   B Number of rows
;   C Index of the routine that draws the sprite
;   H Width in bytes
; O:B High byte of the shift table to use
; O:IX Address of the routine that draws the sprite
@label=SelectDrawSprite
c$A247 LD A,B        ; Fetch the number of rows.
 $A248 LD ($A1D8),A  ; Store it.
 $A24B LD A,H        ; Fetch the width.
 $A24C LD ($5C29),A  ; Store it.
 $A24F LD HL,$A2AA   ; Use the table of routines that draw sprites.
 $A252 CALL $A1AA    ; Fetch the address of the routine.
 $A255 PUSH HL       ; {Put it in #REGix.
 $A256 POP IX        ; }
 $A258 LD A,($A1D5)  ; Fetch the horizontal position of the second sprite.
 $A25B JR $A260      ; Jump to #R$A260.
; This entry point is used by the routine at #R$A234.
@label=SelectEraseSprite_Position
*$A25D LD A,($A1D3)  ; Fetch the horizontal position of the first sprite.
@label=SelectEraseSprite_Shift
*$A260 AND %00000110 ; Only bits 1 and 2, which are the number of pixels to
                     ; shift by.
 $A262 ADD A,$F8     ; Add the high byte of the shift table that does no
                     ; shifting.
 $A264 LD B,A        ; Store it in #REGb.
 $A265 RET           ; Return.

; Set Second Row Group
;
; Used by the routine at #R$C4ED.
; .
; Sets up the counters that are used by #R$A59F for the second sprite,
; and finds the screen address of the sprite. Purpose not yet known.
;
;   B Number of rows
;   H Width in bytes
; O:HL Screen address
@label=SetSecondRowGroup
c$A266 LD A,($BF84)  ; Fetch the vertical position from #N$BF84.
 $A269 LD ($A28A),A  ; Store it.
 $A26C LD A,B        ; Fetch the number of rows.
 $A26D LD ($5C1D),A  ; Store it.
 $A270 LD A,H        ; Fetch the width.
 $A271 LD ($5C29),A  ; Store it.
 $A274 LD HL,($BF83) ; Fetch the position.
 $A277 JP $A149      ; Find the screen address.

; Set First Row Group
;
; Used by the routine at #R$C4ED.
; .
; Sets up the counters that are used by #R$A59F for the first sprite.
; Purpose not yet known.
;
; B Number of rows
; H Width in bytes
@label=SetFirstRowGroup
c$A27A LD A,($BF84)  ; Fetch the vertical position from #N$BF84.
 $A27D LD ($A289),A  ; Store it.
 $A280 LD A,B        ; Fetch the number of rows.
 $A281 LD ($5C1C),A  ; Store it.
 $A284 LD A,H        ; Fetch the width.
 $A285 LD ($5C28),A  ; Store it.
 $A288 RET           ; Return.

; Row Offsets
;
; Two vertical positions that are used by #R$A59F.
@label=RowOffsets
g$A289 DEFB $00
 $A28A DEFB $00

; Find Object Screen Address
;
; Used by the routines at #R$B414, #R$B483, #R$B5B5 and #R$B628.
; .
; Finds the screen address of a position that is held in an object.
;
;   IX Address of the object
; O:HL Screen address
@label=FindObjectScreenAddress
c$A28B LD L,(IX+$0B) ; Fetch the horizontal position.
 $A28E LD H,(IX+$0C) ; Fetch the vertical position.
 $A291 JP $A149      ; Find the screen address.

; Erase Routine Table
;
; The routines that erase a sprite, picked by the index from #R$A223. The
; first five are for sprites that have to be shifted, from one to five bytes
; wide. The last six are for sprites that are aligned, from one to six bytes
; wide.
@label=EraseRoutineTable
w$A294 DEFW $A719
 $A296 DEFW $A70B
 $A298 DEFW $A6FD
 $A29A DEFW $A6EF
 $A29C DEFW $A6E1
 $A29E DEFW $A6D0
 $A2A0 DEFW $A6CA
 $A2A2 DEFW $A6C4
 $A2A4 DEFW $A6BE
 $A2A6 DEFW $A6B8
 $A2A8 DEFW $A6B2

; Draw Routine Table
;
; The routines that draw a sprite, picked by the index from #R$A223. The
; first five are for sprites that have to be shifted, from one to five bytes
; wide. The last six are for sprites that are aligned, from one to six bytes
; wide.
@label=DrawRoutineTable
w$A2AA DEFW $A78C
 $A2AC DEFW $A780
 $A2AE DEFW $A774
 $A2B0 DEFW $A768
 $A2B2 DEFW $A75C
 $A2B4 DEFW $A74C
 $A2B6 DEFW $A747
 $A2B8 DEFW $A742
 $A2BA DEFW $A73D
 $A2BC DEFW $A738
 $A2BE DEFW $A733

; Add Speeds To Position
;
; Adds two speeds to the two coordinates of an object. Nothing in the
; game refers to this routine.
;
; IX Address of the object
@label=AddSpeedsToPosition
c$A2C0 LD A,(IX+$02) ; Fetch the first coordinate.
 $A2C3 LD B,(IX+$05) ; Fetch the first speed.
 $A2C6 ADD A,B       ; Add the speed.
 $A2C7 LD (IX+$02),A ; Store the coordinate.
 $A2CA LD A,(IX+$03) ; Fetch the second coordinate.
 $A2CD LD B,(IX+$06) ; Fetch the second speed.
 $A2D0 ADD A,B       ; Add the speed.
 $A2D1 LD (IX+$03),A ; Store the coordinate.
 $A2D4 RET           ; Return.

; Subtract Speeds From Position
;
; Subtracts two speeds from the two coordinates of an object. Nothing in
; the game refers to this routine.
;
; IX Address of the object
@label=SubtractSpeedsFromPosition
c$A2D5 LD A,(IX+$02) ; Fetch the first coordinate.
 $A2D8 LD B,(IX+$05) ; Fetch the first speed.
 $A2DB SUB B         ; Subtract the speed.
 $A2DC LD (IX+$02),A ; Store the coordinate.
 $A2DF LD A,(IX+$03) ; Fetch the second coordinate.
 $A2E2 LD B,(IX+$06) ; Fetch the second speed.
 $A2E5 SUB B         ; Subtract the speed.
 $A2E6 LD (IX+$03),A ; Store the coordinate.
 $A2E9 RET           ; Return.

; Reset Sprites
;
; Used by the routines at #R$8D42, #R$938D, #R$9572, #R$AC60 and #R$C032.
; .
; Sets both sprites to have no rows and no width, and clears the flag that
; makes #R$A303 clip at the edge of the playfield.
@label=ResetSprites
c$A2EA LD HL,$0000   ; Clear #REGhl.
 $A2ED LD ($A1D7),HL ; Set the number of rows of both sprites to zero.
 $A2F0 LD ($5C28),HL ; Set the width of both sprites to zero.
 $A2F3 XOR A         ; Clear #REGa.
 $A2F4 LD ($A2FA),A  ; Clear the flag at #R$A2FA.
 $A2F7 RET           ; Return.

; Sprite Variables
;
; Variables used by #R$A303.
@label=SpriteVariables
g$A2F8 DEFB $00                             ; Width of the first sprite in
                                            ; bytes.
 $A2F9 DEFB $00                             ; Width of the second sprite in
                                            ; bytes.
@label=SpriteVariables_RightEdge
 $A2FA DEFB $00                             ; Set when #R$A303 is to draw sprites that reach beyond the right
                                            ; of the playfield, which makes it take #N($60) off both horizontal positions.
 $A2FB DEFB $EF,$AF,$AD,$8D,$89,$09,$08,$00 ; Masks used to dissolve the second sprite, which are picked by the
                                            ; value at #N($A302).

; Draw Sprites
;
; Used by the routines at #R$AD1B and #R$C032.
; .
; Erases one sprite and draws another without flicker. It works out the
; rectangle that holds both sprites (which is at most seven bytes wide), copies
; that part of the screen to a buffer at #N($F800), erases the first sprite
; from the buffer, draws the second sprite into the buffer and then copies the
; buffer back to the screen. The sprites are set up by #R$A234, #R$A247 and
; #R$A1D9 or #R$A1EA. A sprite with no rows is not drawn.
;
; B High byte of the shift table for the second sprite
; B' High byte of the shift table for the first sprite
; DE Address of the data of the second sprite
; DE' Address of the data of the first sprite
; IX Routine that draws the second sprite
; IY Routine that erases the first sprite
@label=DrawSprites
c$A303 PUSH DE       ; Save the address of the data of the second sprite.
 $A304 PUSH BC       ; Stash #REGbc on the stack.
 $A305 LD HL,($5C28) ; Fetch the widths of the two sprites in bytes.
 $A308 LD ($A2F8),HL ; Keep a copy of the widths.
 $A30B ADD HL,HL     ; {Multiply the widths by eight to get them in pixels.
 $A30C ADD HL,HL     ;
 $A30D ADD HL,HL     ; }
 $A30E LD ($5C28),HL ; Store the widths in pixels.
 $A311 LD A,($A1D7)  ; Fetch the number of rows of the first sprite.
 $A314 AND A         ; Test it.
 $A315 JR NZ,$A31D   ; Jump to #R$A31D if the sprite has rows.
 $A317 LD HL,($A1D5) ; Copy the position of the second sprite...
 $A31A LD ($A1D3),HL ; ...to the first sprite.
@label=DrawSprites_SecondPosition
*$A31D LD A,($A1D8)  ; Fetch the number of rows of the second sprite.
 $A320 AND A         ; Test it.
 $A321 JR NZ,$A329   ; Jump to #R$A329 if the sprite has rows.
 $A323 LD HL,($A1D3) ; Copy the position of the first sprite...
 $A326 LD ($A1D5),HL ; ...to the second sprite.
@label=DrawSprites_Wrapped
*$A329 LD A,($A2FA)  ; Fetch the flag for sprites beyond the right of the
                     ; playfield.
 $A32C AND A         ; Test it.
 $A32D JR Z,$A33F    ; Jump to #R$A33F if it is not set.
 $A32F LD A,($A1D3)  ; Fetch the horizontal position of the first sprite.
 $A332 SUB $60       ; Take off #N($60).
 $A334 LD ($A1D3),A  ; Store it.
 $A337 LD A,($A1D5)  ; Fetch the horizontal position of the second sprite.
 $A33A SUB $60       ; Take off #N($60).
 $A33C LD ($A1D5),A  ; Store it.
; Find the bottom of the rectangle, which is the larger of the vertical
; positions of the two sprites (the rows of a sprite go up from its position).
@label=DrawSprites_Top
*$A33F LD A,($A1D4)  ; Fetch the vertical position of the first sprite.
 $A342 LD E,A        ; Store it in #REGe.
 $A343 LD A,($A1D6)  ; Fetch the vertical position of the second sprite.
 $A346 LD D,A        ; Store it in #REGd.
 $A347 CP E          ; Is the second sprite higher than the first?
 $A348 JR NC,$A34B   ; Jump to #R$A34B if so.
 $A34A LD A,E        ; Use the position of the first sprite.
@label=DrawSprites_TopFound
*$A34B LD ($5C2D),A  ; Store the bottom of the rectangle.
 $A34E LD H,A        ; Keep it in #REGh.
; Find the top of the rectangle, which gives the number of rows.
 $A34F LD BC,($A1D7) ; Fetch the number of rows of each sprite.
 $A353 LD A,E        ; {Take the number of rows from the position of the first
 $A354 SUB C         ; sprite...
 $A355 LD E,A        ; }
 $A356 LD A,D        ; {...and from the position of the second sprite.
 $A357 SUB B         ; }
 $A358 CP E          ; Is the top of the second sprite higher than that of the
                     ; first?
 $A359 JR NC,$A35C   ; Jump to #R$A35C if not.
 $A35B LD E,A        ; Use the top of the second sprite.
@label=DrawSprites_BottomFound
*$A35C LD A,H        ; {Take the top from the bottom...
 $A35D SUB E         ; }
 $A35E INC A         ; ...and add one to get the number of rows of the
                     ; rectangle.
 $A35F LD ($CE37),A  ; Store it.
; Find the left of the rectangle, which is the lowest of the horizontal
; positions of the two sprites, rounded down to a whole byte.
 $A362 LD A,($A1D3)  ; Fetch the horizontal position of the first sprite.
 $A365 LD E,A        ; Store it in #REGe.
 $A366 LD A,($A1D5)  ; Fetch the horizontal position of the second sprite.
 $A369 LD D,A        ; Store it in #REGd.
 $A36A CP E          ; Is the second sprite further to the left?
 $A36B JR C,$A36E    ; Jump to #R$A36E if so.
 $A36D LD A,E        ; Use the position of the first sprite.
@label=DrawSprites_Left
*$A36E AND %11111000 ; Round down to a whole byte.
 $A370 LD ($5C2C),A  ; Store the left of the rectangle.
 $A373 LD L,A        ; Keep it in #REGl.
; Find the right of the rectangle, which gives the number of bytes in each
; row.
 $A374 LD BC,($5C28) ; Fetch the widths of the sprites in pixels.
 $A378 LD A,E        ; {Work out the right of the first sprite relative to the
 $A379 SUB L         ; left.
 $A37A ADD A,C       ;
 $A37B LD E,A        ; }
 $A37C LD A,D        ; {Work out the right of the second sprite relative to the
 $A37D SUB L         ; left.
 $A37E ADD A,B       ; }
 $A37F CP E          ; Is the second sprite further to the right?
 $A380 JR NC,$A383   ; Jump to #R$A383 if so.
 $A382 LD A,E        ; Use the right of the first sprite.
@label=DrawSprites_Right
*$A383 ADD A,$06     ; Add six to allow for shifting.
 $A385 LD C,A        ; Store it in #REGc.
 $A386 SRL A         ; {Divide it by eight to get the number of bytes in a row.
 $A388 SRL A         ;
 $A38A SRL A         ; }
 $A38C LD ($CE35),A  ; Store it.
 $A38F LD A,($A2FA)  ; Fetch the flag for sprites beyond the right of the
                     ; playfield.
 $A392 AND A         ; Test it.
 $A393 JP Z,$A3F6    ; Jump to #R$A3F6 if it is not set.
; The sprites reach beyond the right of the playfield. Work out how many
; bytes of each row are beyond #N($A8), then copy that many from the left of
; the playfield at the end of each row of the buffer.
 $A396 LD A,L        ; Fetch the left of the rectangle.
 $A397 ADD A,C       ; Add the width in pixels.
 $A398 SUB $A8       ; Take off #N($A8).
 $A39A SRL A         ; {Divide it by eight.
 $A39C SRL A         ;
 $A39E SRL A         ; }
 $A3A0 LD B,A        ; Store the number of bytes beyond in #REGb.
 $A3A1 LD A,($CE35)  ; Fetch the number of bytes in a row.
 $A3A4 SUB B         ; Subtract the bytes beyond.
 $A3A5 LD ($A531),A  ; Store it as the amount to skip at #R$A530.
 $A3A8 LD ($A3DC),A  ; Store it as the amount to skip at #R$A3DB.
 $A3AB LD E,A        ; Start the copy that far along each row of the buffer.
 $A3AC LD A,B        ; Fetch the number of bytes beyond.
 $A3AD XOR %00000111 ; Flip the bottom three bits.
 $A3AF DEC A         ; {Turn it into a distance to jump into a run of copies...
 $A3B0 ADD A,A       ;
 $A3B1 ADD A,$03     ; }
 $A3B3 LD ($A520),A  ; ...and store it for the copy back to the screen at
                     ; #R$A51F.
 $A3B6 LD ($A3CB),A  ; Store it for the copy to the buffer at #R$A3CA.
 $A3B9 LD C,$FF      ; Set the counter that is used by LDI.
 $A3BB LD D,$F8      ; Use the buffer.
 $A3BD LD L,$08      ; Use the left of the playfield.
 $A3BF CALL $A149    ; Find the screen address.
 $A3C2 LD ($CE43),HL ; Keep the screen address of the left of the playfield.
 $A3C5 LD A,($CE37)  ; Fetch the number of rows.
 $A3C8 LD B,A        ; Store it in #REGb.
@label=DrawSprites_WrapRow
*$A3C9 PUSH HL       ; Save the screen address of the row.
@label=DrawSprites_WrapJump
*$A3CA DJNZ $A3CA    ; Jump into the run of copies.
 $A3CC JP $A43E      ; Jump to #R$A43E when the rows are done.
@label=DrawSprites_WrapCopy
 $A3CF LDI           ; Copy a byte of the row to the buffer.
 $A3D1 LDI           ; Copy a byte of the row to the buffer.
 $A3D3 LDI           ; Copy a byte of the row to the buffer.
 $A3D5 LDI           ; Copy a byte of the row to the buffer.
 $A3D7 LDI           ; Copy a byte of the row to the buffer.
 $A3D9 LDI           ; Copy a byte of the row to the buffer.
 $A3DB LD A,$00      ; Move to the start of the next row of the buffer.
 $A3DD ADD A,E       ; Add the amount to skip.
 $A3DE LD E,A        ; Store it in #REGe.
 $A3DF POP HL        ; Restore the screen address of the row.
 $A3E0 DEC H         ; Move up a pixel row.
 $A3E1 LD A,H        ; Fetch the high byte.
 $A3E2 INC A         ; Add one.
 $A3E3 AND %00000111 ; Keep the bits that give the pixel row.
 $A3E5 JP NZ,$A3C9   ; Jump to #R$A3C9 if the row is still in the same cell.
 $A3E8 LD A,L        ; Fetch the low byte.
 $A3E9 SUB $20       ; Move up a row of cells.
 $A3EB LD L,A        ; Store it.
 $A3EC JP C,$A3C9    ; Jump to #R$A3C9 if that crossed a third of the screen.
 $A3EF LD A,H        ; Fetch the high byte.
 $A3F0 ADD A,$08     ; Add eight to correct it.
 $A3F2 LD H,A        ; Store it.
 $A3F3 JP $A3C9      ; Jump to #R$A3C9.
; Copy the rectangle from the screen to the buffer.
@label=DrawSprites_Copy
*$A3F6 LD DE,$F800   ; Use the buffer.
 $A3F9 LD A,($CE35)  ; Fetch the number of bytes in a row.
 $A3FC XOR %00000111 ; Flip the bottom three bits.
 $A3FE ADD A,A       ; {Turn it into a distance to jump into a run of copies...
 $A3FF ADD A,$03     ; }
 $A401 LD ($A553),A  ; ...and store it for the copy back to the screen at
                     ; #R$A552.
 $A404 LD ($A415),A  ; Store it for the copy to the buffer at #R$A414.
 $A407 CALL $A149    ; Find the screen address of the bottom left of the
                     ; rectangle.
 $A40A LD ($CE43),HL ; Keep it.
 $A40D LD C,$FF      ; Set the counter that is used by LDI.
 $A40F LD A,($CE37)  ; Fetch the number of rows.
 $A412 LD B,A        ; Store it in #REGb.
@label=DrawSprites_CopyRow
*$A413 PUSH HL       ; Save the screen address of the row.
@label=DrawSprites_CopyJump
 $A414 DJNZ $A413    ; Jump into the run of copies.
 $A416 JP $A43E      ; Jump to #R$A43E when the rows are done.
@label=DrawSprites_CopyBytes
 $A419 LDI           ; Copy a byte of the row to the buffer.
 $A41B LDI           ; Copy a byte of the row to the buffer.
 $A41D LDI           ; Copy a byte of the row to the buffer.
 $A41F LDI           ; Copy a byte of the row to the buffer.
 $A421 LDI           ; Copy a byte of the row to the buffer.
 $A423 LDI           ; Copy a byte of the row to the buffer.
 $A425 LDI           ; Copy a byte of the row to the buffer.
 $A427 POP HL        ; Restore the screen address of the row.
 $A428 DEC H         ; Move up a pixel row.
 $A429 LD A,H        ; Fetch the high byte.
 $A42A INC A         ; Add one.
 $A42B AND %00000111 ; Keep the bits that give the pixel row.
 $A42D JP NZ,$A413   ; Jump to #R$A413 if the row is still in the same cell.
 $A430 LD A,L        ; Fetch the low byte.
 $A431 SUB $20       ; Move up a row of cells.
 $A433 LD L,A        ; Store it.
 $A434 JP C,$A413    ; Jump to #R$A413 if that crossed a third of the screen.
 $A437 LD A,H        ; Fetch the high byte.
 $A438 ADD A,$08     ; Add eight to correct it.
 $A43A LD H,A        ; Store it.
 $A43B JP $A413      ; Jump to #R$A413.
; Erase the first sprite from the buffer.
@label=DrawSprites_Erase
*$A43E POP HL        ; Discard the extra screen address.
 $A43F POP BC        ; Bring #REGbc back off the stack.
 $A440 POP DE        ; Restore the address of the data of the second sprite.
 $A441 EXX           ; Switch to the registers of the first sprite.
 $A442 LD A,($A1D7)  ; Fetch the number of rows of the first sprite.
 $A445 AND A         ; Test it.
 $A446 JP Z,$A469    ; Jump to #R$A469 if there is nothing to erase.
 $A449 LD HL,($A1D3) ; Fetch the position of the first sprite.
 $A44C CALL $A57E    ; Find its address in the buffer.
 $A44F LD A,($A2F8)  ; Fetch the width of the first sprite.
 $A452 LD C,A        ; Store it in #REGc.
 $A453 LD A,B        ; Fetch the high byte of the shift table.
 $A454 CP $F8        ; {Jump to #R$A459 if the sprite is not aligned to a byte.
 $A456 JR NZ,$A459   ; }
 $A458 DEC C         ; An aligned sprite is one byte narrower.
@label=DrawSprites_EraseSkip
*$A459 LD A,($CE35)  ; Fetch the number of bytes in a row.
 $A45C SUB C         ; Take off the width to get the amount to skip to the next
                     ; row.
 $A45D LD ($A6D6),A  ; Store it at #R$A6D5 for aligned sprites...
 $A460 LD ($A728),A  ; ...and at #R$A727 for shifted sprites.
 $A463 LD A,($A1D7)  ; Fetch the number of rows of the first sprite.
 $A466 EX AF,AF'     ; Store it.
 $A467 JP (IY)       ; Erase the sprite.
; This entry point is used by the routines at #R$A6B2 and #R$A6E1.
; .
; Draw the second sprite into the buffer.
@label=DrawSprites_Draw
*$A469 EXX           ; Switch to the registers of the second sprite (the main
                     ; set).
 $A46A LD A,($A1D8)  ; Fetch the number of rows of the second sprite.
 $A46D AND A         ; Test it.
 $A46E JP Z,$A4CB    ; Jump to #R$A4CB if there is nothing to draw.
 $A471 LD HL,($A1D5) ; Fetch the position of the second sprite.
 $A474 CALL $A57E    ; Find its address in the buffer.
 $A477 LD A,($A2F9)  ; Fetch the width of the second sprite.
 $A47A LD C,A        ; Store it in #REGc.
 $A47B LD A,B        ; Fetch the high byte of the shift table.
 $A47C CP $F8        ; {Jump to #R$A481 if the sprite is not aligned to a byte.
 $A47E JR NZ,$A481   ; }
 $A480 DEC C         ; An aligned sprite is one byte narrower.
@label=DrawSprites_DrawSkip
*$A481 LD A,($CE35)  ; Fetch the number of bytes in a row.
 $A484 SUB C         ; Take off the width to get the amount to skip to the next
                     ; row.
 $A485 LD ($A751),A  ; Store it at #R$A750 for aligned sprites...
 $A488 LD ($A799),A  ; ...and at #R$A798 for shifted sprites.
 $A48B DEC A         ; Take one off.
 $A48C LD ($A4C5),A  ; Store it at #R$A4C4.
 $A48F LD ($BA8D),HL ; Keep the address of the sprite in the buffer.
 $A492 LD A,($A1D8)  ; Fetch the number of rows of the second sprite.
 $A495 EX AF,AF'     ; Store it.
 $A496 JP (IX)       ; Draw the sprite.
; This entry point is used by the routines at #R$A733 and #R$A75C.
; .
; When the value at #N($A302) is not zero, dissolve the second sprite in
; the buffer by clearing some of its pixels using one of the masks at
; #R$A2FB.
@label=DrawSprites_Dissolve
*$A498 LD A,($A302)  ; Fetch the dissolve value.
 $A49B AND A         ; Test it.
 $A49C JP Z,$A4CB    ; Jump to #R$A4CB if the sprite is not dissolving.
 $A49F AND %00001111 ; Keep the bottom four bits.
 $A4A1 LD HL,$A2FA   ; Use the masks.
 $A4A4 CALL $9BCF    ; Add the dissolve value.
 $A4A7 LD D,(HL)     ; Fetch the mask.
 $A4A8 LD HL,($BA8D) ; Fetch the address of the sprite in the buffer.
 $A4AB LD A,($A2F9)  ; Fetch the width of the second sprite.
 $A4AE LD E,A        ; Store it in #REGe.
 $A4AF LD A,($A1D8)  ; Fetch the number of rows of the second sprite.
 $A4B2 LD C,A        ; Store it in #REGc.
 $A4B3 LD A,($A1D5)  ; Fetch the horizontal position of the second sprite.
 $A4B6 AND %00000111 ; Keep the bottom three bits.
 $A4B8 JR Z,$A4BB    ; Jump to #R$A4BB if the sprite is aligned to a byte.
 $A4BA INC E         ; A shifted sprite is one byte wider.
@label=DrawSprites_DissolveRow
*$A4BB LD B,E        ; Set the number of bytes in a row.
@label=DrawSprites_DissolveByte
*$A4BC LD A,D        ; Fetch the mask.
 $A4BD AND (HL)      ; Apply it to the byte.
 $A4BE LD (HL),A     ; Store the byte.
 $A4BF RRC D         ; Rotate the mask.
 $A4C1 INC L         ; Move on to the next byte.
 $A4C2 DJNZ $A4BC    ; Loop back to #R$A4BC for each byte of the row.
 $A4C4 LD A,$00      ; Move on to the start of the next row of the buffer.
 $A4C6 ADD A,L       ; Add the amount to skip.
 $A4C7 LD L,A        ; Store it in #REGl.
 $A4C8 DEC C         ; Count the rows.
 $A4C9 JR NZ,$A4BB   ; Loop back to #R$A4BB for each row.
; Copy the buffer back to the screen, without going past the left or
; right edge of the playfield.
@label=DrawSprites_CopyBack
*$A4CB LD DE,($CE43) ; Fetch the screen address of the bottom left of the
                     ; rectangle.
 $A4CF LD HL,$F800   ; Use the buffer.
 $A4D2 LD A,($A2FA)  ; Fetch the flag for sprites beyond the right of the
                     ; playfield.
 $A4D5 AND A         ; Test it.
 $A4D6 JR Z,$A4DF    ; Jump to #R$A4DF if it is not set.
 $A4D8 LD A,($A531)  ; Fetch the amount to skip.
 $A4DB LD L,A        ; Start the copy that far along each row of the buffer.
 $A4DC JP $A518      ; Jump to #R$A518.
@label=DrawSprites_Clip
*$A4DF LD A,($CE35)  ; Fetch the number of bytes in a row.
 $A4E2 ADD A,A       ; {Multiply it by eight to get the width in pixels.
 $A4E3 ADD A,A       ;
 $A4E4 ADD A,A       ; }
 $A4E5 LD B,A        ; Store it in #REGb.
 $A4E6 LD A,($5C2C)  ; Fetch the left of the rectangle.
 $A4E9 AND A         ; Test it.
 $A4EA JR Z,$A4F5    ; Jump to #R$A4F5 if it is zero.
 $A4EC LD C,A        ; Store the left in #REGc.
 $A4ED ADD A,$17     ; Add #N($17).
 $A4EF ADD A,B       ; Add the width in pixels.
 $A4F0 JP NC,$A54B   ; Jump to #R$A54B if the rectangle ends within the screen.
 $A4F3 JR $A4FD      ; Jump to #R$A4FD.
@label=DrawSprites_ClipLeft
*$A4F5 INC E         ; Skip the first byte of the buffer...
 $A4F6 INC L         ; ...and the first byte of the screen.
 $A4F7 LD A,($CE35)  ; Fetch the number of bytes in a row.
 $A4FA DEC A         ; Take one off.
 $A4FB JR $A506      ; Jump to #R$A506.
@label=DrawSprites_ClipRight
*$A4FD LD A,$EE      ; Subtract the left from #N($EE)...
 $A4FF SUB C         ; ...to get the width that fits.
 $A500 SRL A         ; {Divide it by eight to get the number of bytes.
 $A502 SRL A         ;
 $A504 SRL A         ; }
@label=DrawSprites_ClipSkip
*$A506 LD B,A        ; Store the number of bytes to copy in #REGb.
 $A507 LD A,($CE35)  ; Fetch the number of bytes in a row.
 $A50A SUB B         ; Subtract the number of bytes to copy.
 $A50B LD ($A531),A  ; Store it as the amount to skip at #R$A530.
 $A50E LD A,B        ; Fetch the number of bytes to copy.
 $A50F XOR %00000111 ; Flip the bottom three bits.
 $A511 DEC A         ; {Work out the distance to jump into the run of copies...
 $A512 ADD A,A       ;
 $A513 ADD A,$03     ; }
 $A515 LD ($A520),A  ; ...and store it at #R$A51F.
@label=DrawSprites_ClipRows
*$A518 LD C,$FF      ; Set the counter that is used by LDI.
 $A51A LD A,($CE37)  ; Fetch the number of rows.
 $A51D LD B,A        ; Store it in #REGb.
@label=DrawSprites_ClipRow
*$A51E PUSH DE       ; Save the screen address of the row.
@label=DrawSprites_ClipJump
 $A51F DJNZ $A51E    ; Jump into the run of copies.
 $A521 JP $A57C      ; Jump to #R$A57C when the rows are done.
@label=DrawSprites_ClipBytes
 $A524 LDI           ; Copy a byte of the row to the screen.
 $A526 LDI           ; Copy a byte of the row to the screen.
 $A528 LDI           ; Copy a byte of the row to the screen.
 $A52A LDI           ; Copy a byte of the row to the screen.
 $A52C LDI           ; Copy a byte of the row to the screen.
 $A52E LDI           ; Copy a byte of the row to the screen.
 $A530 LD A,$00      ; Move to the start of the next row of the buffer.
 $A532 ADD A,L       ; Add the amount to skip.
 $A533 LD L,A        ; Store it in #REGl.
 $A534 POP DE        ; Restore the screen address of the row.
 $A535 DEC D         ; Move up a pixel row.
 $A536 LD A,D        ; Fetch the high byte.
 $A537 INC A         ; Add one.
 $A538 AND %00000111 ; Keep the bits that give the pixel row.
 $A53A JP NZ,$A51E   ; Jump to #R$A51E if the row is still in the same cell.
 $A53D LD A,E        ; Fetch the low byte.
 $A53E SUB $20       ; Move up a row of cells.
 $A540 LD E,A        ; Store it.
 $A541 JP C,$A51E    ; Jump to #R$A51E if that crossed a third of the screen.
 $A544 LD A,D        ; Fetch the high byte.
 $A545 ADD A,$08     ; Add eight to correct it.
 $A547 LD D,A        ; Store it.
 $A548 JP $A51E      ; Jump to #R$A51E.
@label=DrawSprites_CopyAll
*$A54B LD A,($CE37)  ; Fetch the number of rows.
 $A54E LD B,A        ; Store it in #REGb.
 $A54F LD C,$FF      ; Set the counter that is used by LDI.
@label=DrawSprites_CopyAllRow
*$A551 PUSH DE       ; Save the screen address of the row.
@label=DrawSprites_CopyAllJump
*$A552 DJNZ $A552    ; Jump into the run of copies.
 $A554 JP $A57C      ; Jump to #R$A57C when the rows are done.
@label=DrawSprites_CopyAllBytes
 $A557 LDI           ; Copy a byte of the row to the screen.
 $A559 LDI           ; Copy a byte of the row to the screen.
 $A55B LDI           ; Copy a byte of the row to the screen.
 $A55D LDI           ; Copy a byte of the row to the screen.
 $A55F LDI           ; Copy a byte of the row to the screen.
 $A561 LDI           ; Copy a byte of the row to the screen.
 $A563 LDI           ; Copy a byte of the row to the screen.
 $A565 POP DE        ; Restore the screen address of the row.
 $A566 DEC D         ; Move up a pixel row.
 $A567 LD A,D        ; Fetch the high byte.
 $A568 INC A         ; Add one.
 $A569 AND %00000111 ; Keep the bits that give the pixel row.
 $A56B JP NZ,$A551   ; Jump to #R$A551 if the row is still in the same cell.
 $A56E LD A,E        ; Fetch the low byte.
 $A56F SUB $20       ; Move up a row of cells.
 $A571 LD E,A        ; Store it.
 $A572 JP C,$A551    ; Jump to #R$A551 if that crossed a third of the screen.
 $A575 LD A,D        ; Fetch the high byte.
