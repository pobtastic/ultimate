 $82C2 DEFB $00,$00,$6E,$00,$00 ;
 $82C7 DEFB $00,$00,$CF,$00,$00 ;
 $82CC DEFB $00,$00,$9F,$00,$00 ;
 $82D1 DEFB $00,$00,$00,$00,$00 ;
 $82D6 DEFB $0C,$0B,$FF,$FF,$60 ;
 $82DB DEFB $18,$37,$FF,$FF,$D8 ;
 $82E0 DEFB $00,$00,$00,$00,$00 ;
 $82E5 DEFB $E0,$55,$FF,$FF,$FB ;
 $82EA DEFB $E0,$2A,$FF,$FF,$FB ;
 $82EF DEFB $E0,$55,$FF,$FF,$FB ;
 $82F4 DEFB $00,$00,$00,$00,$00 ;
 $82F9 DEFB $38,$15,$7F,$FF,$EC ;
 $82FE DEFB $0E,$0A,$BF,$FF,$B0 ; }

; Sprite: Type 0D Frame 0B
;
; A sprite for objects of type #N$0D: it is used when the bottom four
; bits of offset #N($13) are #N$0B (see #R$ADBE).
@label=SpriteType0D_Frame0B
b$8303 DEFB $03         ; Width = #N(#PEEK(#PC)) bytes.
 $8304 DEFB $16         ; Height = #N(#PEEK(#PC)) pixels.
 $8305 DEFB $78,$00,$00 ; {#SPRITEDATA(type-0d-frame-0b*)
 $8308 DEFB $67,$00,$00 ;
 $830B DEFB $5B,$C0,$00 ;
 $830E DEFB $5F,$E0,$00 ;
 $8311 DEFB $3D,$F4,$00 ;
 $8314 DEFB $38,$7B,$00 ;
 $8317 DEFB $3D,$95,$86 ;
 $831A DEFB $1B,$EA,$C6 ;
 $831D DEFB $0B,$F5,$40 ;
 $8320 DEFB $07,$9A,$A0 ;
 $8323 DEFB $07,$0D,$40 ;
 $8326 DEFB $07,$9E,$A0 ;
