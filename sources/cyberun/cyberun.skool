; Draw Mirrored Row Directly
;
; Draws one row of a sprite that is flipped from left to right on the
; screen. Each byte of the sprite has its bits reversed by the table that
; #REGb points to, and the screen is filled from right to left. The entry point
; depends on the width of the sprite in bytes, from six bytes at #R$A7D6 to one
; byte at #R$A7F9.
;
; B High byte of the table that reverses bits
; DE Address of the data of the sprite
; HL Screen address of the right of the row
@label=DrawMirroredRowDirectly
c$A7D6 LD A,(DE)     ; Fetch a byte of the sprite.
 $A7D7 LD C,A        ; Use it to look up the byte with the bits reversed.
 $A7D8 LD A,(BC)     ; Fetch it.
 $A7D9 OR (HL)       ; Set the pixels of the screen.
 $A7DA LD (HL),A     ; Store the byte.
 $A7DB DEC L         ; Move on to the next byte of the screen to the left.
 $A7DC INC DE        ; Move on to the next byte of the sprite.
@label=DrawMirroredRowDirectly_Second
 $A7DD LD A,(DE)     ; Fetch a byte of the sprite.
 $A7DE LD C,A        ; Use it to look up the byte with the bits reversed.
