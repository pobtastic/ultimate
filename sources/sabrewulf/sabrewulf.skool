; Play Orchid Flash Beep
;
; Used by the routine at #R$AEEF.
; .
; Plays a short, low beep of eight cycles. It is made when the player
; changes between white and the colour of the orchid, as the effect of the
; orchid wears off (see #R$AEEF).
; .
; #HTML(#AUDIO0(orchid-flash-beep.wav)(#INCLUDE(OrchidFlashBeep)))
@label=PlayOrchidFlashBeep
c$BEC6 LD BC,$A008   ; Set the half-period in #REGb to #N$A0 and the number of cycles in
                     ; #REGc to #N$08.
 $BEC9 JP $BF6D      ; Jump to #R$BF6D to play the beep.

; Play Flame Sound
;
; Used by the routine at #R$9D91.
; .
; Plays sixteen cycles of a tone, with a half-period taken from the table
; at #R$BEDE. The entry used depends on the low four bits of the frame counter,
; which gives the flame a crackling sound.
; .
; #HTML(#AUDIO0(flame-sound.wav)(#INCLUDE(FlameSound)))
@label=PlayFlameSound
c$BECC LD BC,$BEDE   ; Point #REGbc at the flame sound table at #R$BEDE.
 $BECF LD A,($9693)  ; Fetch the low byte of the game timer from #R$9693.
 $BED2 AND %00001111 ; Keep only bits 0-3.
 $BED4 LD L,A        ; {Use it as the offset into the table.
 $BED5 LD H,$00      ; }
 $BED7 ADD HL,BC     ; Add the table to find the half-period.
 $BED8 LD B,(HL)     ; Fetch the half-period of the tone from the table into
                     ; #REGb.
 $BED9 LD C,$10      ; Set the number of cycles in #REGc to #N$10.
 $BEDB JP $BF6D      ; Jump to #R$BF6D to play the sound.

; Flame Sound Table
;
; The half-periods used by #R$BECC.
@label=FlameSoundTable
b$BEDE DEFB $20,$30,$40,$50,$60,$70,$80,$90
 $BEE6 DEFB $40,$60,$40,$60,$40,$60,$40,$60

; Play Explosion Sound
;
; Used by the routine at #R$A4A6.
; .
; Plays sixteen short tones to make a burst of noise. The half-period of
; each tone is the low seven bits of a byte of the ROM, which is read from an
; address made from the low five bits of the frame counter (the high byte) and
; the random seed (the low byte).
; .
; #HTML(#AUDIO0(explosion.wav)(#INCLUDE(Explosion)))
@label=PlayExplosionSound
c$BEEE LD A,($9695)  ; {Fetch the random seed from #R$9695 into #REGl.
 $BEF1 LD L,A        ; }
 $BEF2 LD A,($9693)  ; Fetch the low byte of the game timer from #R$9693.
 $BEF5 AND %00011111 ; Keep only bits 0-4.
 $BEF7 LD H,A        ; Store the result in #REGh, so #REGhl points to a byte of
                     ; the ROM.
 $BEF8 LD E,$10      ; Set the number of tones in #REGe to #N$10.
@label=PlayExplosionSound_Loop
*$BEFA LD A,(HL)     ; Fetch a byte of the ROM, to use as noise.
 $BEFB INC HL        ; Move on to the next byte of the ROM.
 $BEFC AND %01111111 ; Keep only bits 0-6.
 $BEFE LD B,A        ; Store the result in #REGb (the half-period).
 $BEFF LD C,$02      ; Set the number of cycles of each tone in #REGc to #N$02.
 $BF01 CALL $BF6D    ; Play the tone.
 $BF04 DEC E         ; {Decrease the tone counter by one and loop back to #R$BEFA until all
 $BF05 JR NZ,$BEFA   ; of the tones have been played.}
 $BF07 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$B489 }
; LIST#

; Play Appearing Sound
;
; Used by the routine at #R$A3C5.
; .
; Plays six cycles of a tone with a half-period which depends on the low
; three bits of the sprite ID, so the sound changes as the sprite changes.
; .
; #HTML(#AUDIO0(appearing-sound.wav)(#INCLUDE(AppearingSound)))
;
; IX Actor record
@label=PlayAppearingSound
c$BF08 LD A,(IX+$00) ; Fetch the sprite ID of the actor.
 $BF0B CPL           ; Flip the bits.
 $BF0C RRCA          ; {Rotate right three times.
 $BF0D RRCA          ;
 $BF0E RRCA          ; }
 $BF0F AND %11100000 ; Keep only bits 5-7.
 $BF11 LD B,A        ; Store the result in #REGb (the half-period).
 $BF12 LD C,$06      ; Set the number of cycles in #REGc to #N$06.
 $BF14 JP $BF6D      ; Jump to #R$BF6D to play the sound.

; Play Warble Sound
;
; Used by the routines at #R$9EB3, #R$9F16, #R$AB74 and #R$AD69.
; .
; Plays #N$30 tones, using #R$BF74. The pitch of each one is worked out
; from a counter which counts down from #N$30, which gives a warbling sound.
; #HTML(#AUDIO0(warble-sound.wav)(#INCLUDE(WarbleSound)))
@label=PlayWarbleSound
c$BF17 LD C,$30      ; Set the number of tones in #REGc to #N$30.
@label=PlayWarbleSound_Loop
*$BF19 LD A,C        ; Fetch the tone counter.
 $BF1A OR %00011000  ; Set bits 3-4.
 $BF1C DAA           ; Decimal adjust the result, so the pitch jumps about.
 $BF1D LD B,A        ; Store the result in #REGb (the half-period).
 $BF1E CALL $BF74    ; Play the tone.
 $BF21 DEC C         ; {Decrease the tone counter by one and loop back to #R$BF19 until all
 $BF22 JR NZ,$BF19   ; of the tones have been played.}
 $BF24 RET           ; Return.

; Play High Tone
;
; Used by the routines at #R$A323 and #R$B743.
; .
; Plays a steady tone of #N$30 cycles, using #N$40 as the pitch delay.
; #HTML(#AUDIO0(high-tone.wav)(#INCLUDE(HighTone)))
@label=PlayHighTone
c$BF25 LD BC,$4030   ; Set the half-period in #REGb to #N$40 and the number of cycles in
                     ; #REGc to #N$30.
 $BF28 JR $BF6D      ; Jump to #R$BF6D to play the tone.

; Play Low Tone
;
; Used by the routines at #R$A737, #R$AEA1 and #R$B6D7.
; .
; Plays a steady tone of #N$10 cycles, using #N$80 as the pitch delay
; (so it is lower in pitch than #R$BF25).
; #HTML(#AUDIO0(low-tone.wav)(#INCLUDE(LowTone)))
@label=PlayLowTone
c$BF2A LD BC,$8010   ; Set the half-period in #REGb to #N$80 and the number of cycles in
                     ; #REGc to #N$10.
 $BF2D JR $BF6D      ; Jump to #R$BF6D to play the tone.

; Play Noise Sound
;
; Used by the routine at #R$AA00.
; .
; Plays #N$30 tones, each with a pitch worked out from the counter, which
; gives a noisy sound.
; #HTML(#AUDIO0(noise-sound.wav)(#INCLUDE(NoiseSound)))
@label=PlayNoiseSound
c$BF2F LD C,$30      ; Set the number of tones in #REGc to #N$30.
@label=PlayNoiseSound_Loop
*$BF31 LD A,C        ; Fetch the tone counter.
 $BF32 XOR %01010101 ; Flip bits 0, 2, 4 and 6.
 $BF34 ADD A,C       ; Add the tone counter.
 $BF35 LD B,A        ; Store the result in #REGb (the half-period).
 $BF36 CALL $BF74    ; Play the tone.
 $BF39 DEC C         ; {Decrease the tone counter by one and loop back to #R$BF31 until all
 $BF3A JR NZ,$BF31   ; of the tones have been played.}
 $BF3C RET           ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$AF22 }
; { #MARTIANOIDS$C04E }
; { #NIGHTSHADE$C3AA }
; { #PENTAGRAM$D5E4 }
; LIST#

; Play Amulet Piece Sound
;
; Used by the routine at #R$AB74.
; .
; Plays eight cycles of a tone. The half-period is the distance to the
; nearest amulet piece, plus the X and Y positions of the actor, rotated left
; twice.
; .
; #HTML(#AUDIO0(amulet-piece-sound.wav)(#INCLUDE(AmuletPieceSound)))
;
; A Distance to the nearest amulet piece
; IX Actor record
@label=PlayAmuletPieceSound
c$BF3D ADD A,(IX+$03) ; Add the X position of the actor to the distance.
 $BF40 ADD A,(IX+$04) ; Add the Y position of the actor to the distance.
 $BF43 RLCA           ; {Rotate left twice.
 $BF44 RLCA           ; }
 $BF45 LD B,A         ; Store the result in #REGb (the half-period).
 $BF46 LD C,$08       ; Set the number of cycles in #REGc to #N$08.
 $BF48 JP $BF6D       ; Jump to #R$BF6D to play the sound.

; Play Footstep Sound
;
; Used by the routines at #R$ADD0 and #R$AEEF.
; .
; Makes the sound of a footstep when a player has moved. The footstep
; counter at #R$96B3 is incremented and a short tone is played whenever the low
; three bits are zero, which alternates between two pitches (using bit 3). A
; cyan player (the effect of a cyan orchid) is quicker, so the
; counter is incremented twice.
; .
; #HTML(#AUDIO0(footstep-sound.wav)(#INCLUDE(FootstepSound)))
;
; IX Actor record
@label=PlayFootstepSound
c$BF4B CALL $BF54    ; Make the footstep sound.
 $BF4E LD A,(IX+$05) ; Fetch the colour of the player.
 $BF51 CP $45        ; {Return unless the player is cyan (#COLOUR$45), who makes the
 $BF53 RET NZ        ; footstep sound a second time.}
; Increment the counter and make the sound if it is time for one.
@label=PlayFootstepSound_Step
*$BF54 LD HL,$96B3   ; Point #REGhl at the footstep counter at #R$96B3.
 $BF57 INC (HL)      ; Increase the footstep counter by one.
 $BF58 LD A,(HL)     ; Fetch the footstep counter.
 $BF59 BIT 3,A       ; {Jump to #R$BF65 if bit 3 of the counter is zero.
 $BF5B JR Z,$BF65    ; }
 $BF5D AND %00000111 ; Keep only bits 0-2.
 $BF5F RET NZ        ; Return unless the footstep counter is a multiple of
                     ; eight.
 $BF60 LD BC,$4004   ; Set the half-period in #REGb to #N$40 and the number of cycles in
                     ; #REGc to #N$04.
 $BF63 JR $BF6D      ; Jump to #R$BF6D to play the sound.
@label=PlayFootstepSound_Low
*$BF65 AND %00000111 ; Keep only bits 0-2.
 $BF67 RET NZ        ; Return unless the footstep counter is a multiple of
                     ; eight.
 $BF68 LD BC,$6004   ; Set the half-period in #REGb to #N$60 and the number of cycles in
                     ; #REGc to #N$04.
 $BF6B JR $BF6D      ; Jump to #R$BF6D to play the sound.

; Play Wave Sequence
;
; Used by the routines at #R$A9BE, #R$BEC6, #R$BECC, #R$BEEE, #R$BF08, #R$BF25,
; #R$BF2A, #R$BF3D and #R$BF4B.
; .
; Plays a number of cycles of a square wave, one after the other.
;
; B Duration of wave
; C Number of times to repeat
@label=PlayWaveSequence
c$BF6D CALL $BF74    ; Play a cycle of the wave.
 $BF70 DEC C         ; {Decrease the repeat counter by one and loop back to #R$BF6D until
 $BF71 JR NZ,$BF6D   ; all of the cycles have been played.}
 $BF73 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #LUNARJETMAN$B92D }
; LIST#

; Play Square Wave
;
; Used by the routines at #R$BF17, #R$BF2F and #R$BF6D.
; .
; Plays a single cycle of a square wave: the speaker is turned on for the
; duration and then off for the same duration.
;
; B Duration of wave
@label=PlaySquareWave
c$BF74 LD A,$10      ; #REGa=#N$10 (bit 4 turns the speaker on).
 $BF76 OUT ($FE),A   ; Write #REGa to port #N$FE (border black, speaker on).
 $BF78 LD A,B        ; Stash the duration in #REGa.
@label=PlaySquareWave_Loop
*$BF79 DJNZ $BF79    ; Decrease duration by one and loop back to #R$BF79 until
                     ; it is zero.
 $BF7B LD B,A        ; Restore the duration to #REGb.
 $BF7C XOR A         ; #REGa=#N$00.
 $BF7D OUT ($FE),A   ; Write #REGa to port #N$FE (border black, speaker off).
 $BF7F LD A,B        ; Stash the duration in #REGa.
@label=Silence_Loop
*$BF80 DJNZ $BF80    ; Decrease duration by one and loop back to #R$BF80 until
                     ; it is zero.
 $BF82 LD B,A        ; Restore the duration to #REGb.
 $BF83 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$B4ED }
; { #LUNARJETMAN$B8DA }
; { #MARTIANOIDS$C062 }
; { #PSSST$64AA }
; LIST#

; Sprite Table
;
; The table of sprites, with an entry for each of the #N$C4 sprite IDs. An
; entry is the address of the sprite for the ID (see #R$B928). The sprite ID is
; the first byte of an actor record.
; .
; A sprite is stored as its width in bytes, then its height in pixels, and then
; the pixel data: one byte for every byte of the width, for each row of the
; sprite. Sprites have no mask, as they are drawn using XOR. Several sprite IDs
; can share one sprite when an animation repeats a frame.
@label=SpritesTable
w$BF84 DEFW $C10C    ; Sprite ID: #R(#PEEK(#PC) + #PEEK(#PC + $01) *
                     ; $100)(#N((#PC - $BF84) / $02)) #SPRITENAME((#PC - $BF84)
                     ; / $02).
 $BF86 DEFW $D822    ; Sprite ID: #R(#PEEK(#PC) + #PEEK(#PC + $01) *
                     ; $100)(#N((#PC - $BF84) / $02)) #SPRITENAME((#PC - $BF84)
                     ; / $02).
 $BF88 DEFW $D84E    ; Sprite ID: #R(#PEEK(#PC) + #PEEK(#PC + $01) *
                     ; $100)(#N((#PC - $BF84) / $02)) #SPRITENAME((#PC - $BF84)
                     ; / $02).
 $BF8A DEFW $D889    ; Sprite ID: #R(#PEEK(#PC) + #PEEK(#PC + $01) *
                     ; $100)(#N((#PC - $BF84) / $02)) #SPRITENAME((#PC - $BF84)
                     ; / $02).
 $BF8C DEFW $D8D0    ; Sprite ID: #R(#PEEK(#PC) + #PEEK(#PC + $01) *
                     ; $100)(#N((#PC - $BF84) / $02)) #SPRITENAME((#PC - $BF84)
                     ; / $02).
 $BF8E DEFW $D917    ; Sprite ID: #R(#PEEK(#PC) + #PEEK(#PC + $01) *
                     ; $100)(#N((#PC - $BF84) / $02)) #SPRITENAME((#PC - $BF84)
                     ; / $02).
 $BF90 DEFW $D95E    ; Sprite ID: #R(#PEEK(#PC) + #PEEK(#PC + $01) *
                     ; $100)(#N((#PC - $BF84) / $02)) #SPRITENAME((#PC - $BF84)
                     ; / $02).
 $BF92 DEFW $C10C    ; Sprite ID: #R(#PEEK(#PC) + #PEEK(#PC + $01) *
                     ; $100)(#N((#PC - $BF84) / $02)) #SPRITENAME((#PC - $BF84)
                     ; / $02).
 $BF94 DEFW $D747    ; Sprite ID: #R(#PEEK(#PC) + #PEEK(#PC + $01) *
                     ; $100)(#N((#PC - $BF84) / $02)) #SPRITENAME((#PC - $BF84)
                     ; / $02).
 $BF96 DEFW $D78E    ; Sprite ID: #R(#PEEK(#PC) + #PEEK(#PC + $01) *
