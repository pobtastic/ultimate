; Immortal Data
;
; The table of actors, which runs from here to #R$982E. Every actor is
; held in a #N$0C byte record, and #R$99AA handles each record in turn, using
; the sprite ID to choose the handler (see #R$9B3E).
; .
; A record is made up of:
; #TABLE(default,centre,left)
; { =h Byte | =h Contents }
; { #N$00 | Sprite ID (zero for an empty record) }
; { #N$01 | Room }
; { #N$02 | Hit direction or counter }
; { #N$03 | X position }
; { #N$04 | Y position }
; { #N$05 | Colour }
; { #N$06 | X velocity, in sixteenths of a pixel }
; { #N$07 | Y velocity, in sixteenths of a pixel }
; { #N$08-#N$0B | Used in different ways by different actors }
; TABLE#
; .
; The first #N$0C records are the player and the actors which are always
; present, which are set up from #R$AC77. They are followed by the nasties
; (#R$9792), the orchid (#R$97DA), the objects (#R$97E6) and the pieces of the
; amulet (#R$97FE).
;
; .
;
; The record of the player.
@label=ImmortalData
g$9702 DEFB $00                             ; Sprite ID.
 $9703 DEFB $00                             ; Room.
 $9704 DEFB $00                             ; Hit direction.
 $9705 DEFB $00                             ; X position.
 $9706 DEFB $00                             ; Y position.
 $9707 DEFB $00                             ; Colour.
 $9708 DEFB $00                             ; X velocity.
 $9709 DEFB $00                             ; Y velocity.
 $970A DEFB $00,$00,$00                     ; Not used.
 $970D DEFB $00                             ; Amulet pieces collected. Bits 0-3 are set for the pieces which have
                                            ; been collected and bit 7 is set when a piece has just been collected.
; The records of the other actors which are always present.
@label=ImmortalData_Actors
 $970E DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; {Rhino.
 $9716 DEFB $00,$00,$00,$00                 ; }
 $971A DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; {Rhino.
 $9722 DEFB $00,$00,$00,$00                 ; }
 $9726 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; {Rhino.
 $972E DEFB $00,$00,$00,$00                 ; }
 $9732 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; {Rhino.
 $973A DEFB $00,$00,$00,$00                 ; }
 $973E DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; {Tribesman.
 $9746 DEFB $00,$00,$00,$00                 ; }
 $974A DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; {Tribesman.
 $9752 DEFB $00,$00,$00,$00                 ; }
 $9756 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; {Tribesman.
 $975E DEFB $00,$00,$00,$00                 ; }
@label=ImmortalData_SpareFlame
 $9762 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; {Spare record for a flame.
 $976A DEFB $00,$00,$00,$00                 ; }
 $976E DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; {Wulf.
 $9776 DEFB $00,$00,$00,$00                 ; }
 $977A DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; {Hippo.
 $9782 DEFB $00,$00,$00,$00                 ; }
 $9786 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; {The Guardian.
 $978E DEFB $00,$00,$00,$00                 ; }

; Nastie Data
;
; The records of the six nasties. A nastie is started in an empty record
; by #R$9A68.
@label=NastieData
g$9792 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $979A DEFB $00,$00,$00,$00
 $979E DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $97A6 DEFB $00,$00,$00,$00
 $97AA DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $97B2 DEFB $00,$00,$00,$00
 $97B6 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $97BE DEFB $00,$00,$00,$00
 $97C2 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $97CA DEFB $00,$00,$00,$00
 $97CE DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $97D6 DEFB $00,$00,$00,$00

