; Print Character
;
; Used by the routines at #R$B29F, #R$B53D, #R$B5CC, #R$B6D7 and #R$B7CD.
; .
; Prints a character from the font pointed to by the system variable CHARS
; onto the screen, at an address on the screen, and moves to the next column.
; .
; #PUSHS #UDGTABLE(default,centre)
; { =h Before }
; { #SIM(start=$9960,stop=$9979,clear=1,sp=$5B40)
; #SCR$02,$00,$00,$20,$02(character-before) }
; { =h After #R$B589 }
; { #SIM(start=$B589,stop=$0000,a=$53,hl=$4004,sp=$5B40)
; #SCR$02,$00,$00,$20,$02(character-after) } UDGTABLE# #POPS
;
;   A ASCII value to print
;   HL Screen address
; O:HL Screen address of the next character
@label=PrintScreen
c$B589 PUSH BC       ; {Stash #REGbc, #REGde and #REGhl on the stack.
 $B58A PUSH DE       ;
 $B58B PUSH HL       ; }
 $B58C LD L,A        ; {Use the character code as the offset into the font.
 $B58D LD H,$00      ; }
 $B58F ADD HL,HL     ; {Multiply the offset by eight (the number of bytes in a
 $B590 ADD HL,HL     ; character).
 $B591 ADD HL,HL     ; }
 $B592 LD DE,($5C36) ; Fetch the address of the font from
                     ; #SKOOLKID$5C36(CHARS).
 $B596 ADD HL,DE     ; {#REGde=#REGhl + #N$3C00. For examples of usage;
 $B597 EX DE,HL      ; #TABLE(default,centre,centre,centre,centre,centre)
                     ; { =h Letter | =h ASCII Value | =h * 8 (offset) | =h CHARS + offset }
                     ; #FOREACH($55,$4C,$54,$49,$4D,$41,$54,$45)(value,
                     ; { #LET(result=$3C00 + value * $08) "#CHR(value)" | #N(value) | #N(value * 8) | #SKOOLKID($3D00,{result})(#N({result})) }
                     ; )
                     ; TABLE#}
; Print the character to the screen.
 $B598 POP HL        ; Restore the screen address.
; This entry point is used by the routine at #R$B7CD.
@label=PrintScreen_Write
*$B599 LD B,$08      ; Set the number of pixel lines in #REGb to #N$08.
@label=PrintScreen_Loop
*$B59B LD A,(DE)     ; {Draw a pixel line of the character.
 $B59C LD (HL),A     ; }
 $B59D INC DE        ; Move onto the next pixel line of the character.
 $B59E INC H         ; Move onto the next pixel line of the screen.
 $B59F DJNZ $B59B    ; Decrease the pixel line counter by one and loop back to #R$B59B
                     ; until all eight pixel lines have been drawn.
 $B5A1 POP DE        ; {Restore the registers from the stack.
 $B5A2 POP BC        ; }
; Reset #REGhl and move to the next column, ready to print the next character.
 $B5A3 LD A,H        ; {#REGh=#REGh - #N$08 (reset the display line).
 $B5A4 SUB $08       ;
 $B5A6 LD H,A        ; }
 $B5A7 INC L         ; Move onto the next column.
 $B5A8 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$A1D3 }
; { #COOKIE$7468 }
; { #JETPAC$714C }
; { #LUNARJETMAN$89EF }
; { #MARTIANOIDS$B5CB }
; { #NIGHTSHADE$CB19 }
; { #PSSST$73CD }
; { #TRANZAM$6C96 }
; { #UNDERWURLDE$98DF }
; LIST#

; Add Points To Score
;
; Used by the routines at #R$A1AB, #R$A323 and #R$A4B3.
; .
; Adds points to the score of the active player. The scores are held as
; three bytes, each with two BCD digits. The new score is then printed by
; #R$B5CC.
; .
; #PUSHS #UDGTABLE(default,centre)
; { =h Before }
; { #SIM(start=$9960,stop=$998F,clear=1,sp=$5B40)
; #SCR$02,$00,$00,$20,$02(add-points-before) }
; { =h After #R$B5A9 }
; { #SIM(start=$B5A9,stop=$0000,bc=$0150,sp=$5B40)
; #SCR$02,$00,$00,$20,$02(add-points-after) } UDGTABLE# #POPS
;
; BC Points to add to score
;
; Check the active player.
@label=AddPointsToScore
c$B5A9 LD A,($969E)  ; {Jump to #R$B5B4 if the active player is 2UP.
 $B5AC AND A         ;
 $B5AD JR NZ,$B5B4   ; }
; Set the score address for 1UP.
 $B5AF LD HL,$969A   ; Point #REGhl at the score of 1UP at #R$969A.
 $B5B2 JR $B5B7      ; Jump to #R$B5B7.
; Set the score address for 2UP.
@label=AddPointsToScore_2UP
*$B5B4 LD HL,$969D   ; Point #REGhl at the score of 2UP at #R$969D.
; Process adding the points to the appropriate score.
@label=AddPointsToScore_Start
*$B5B7 LD A,(HL)     ; Fetch the lowest pair of digits of the score.
 $B5B8 ADD A,C       ; {Add the low byte of the points to the digits (in BCD).
 $B5B9 DAA           ; }
 $B5BA LD (HL),A     ; Store the new lowest pair of digits.
 $B5BB DEC HL        ; Move onto the middle pair of digits.
 $B5BC LD A,(HL)     ; Fetch the middle pair of digits of the score.
 $B5BD ADC A,B       ; {Add the high byte of the points to the digits, plus the carry (in
 $B5BE DAA           ; BCD).}
 $B5BF LD (HL),A     ; Store the new middle pair of digits.
 $B5C0 DEC HL        ; Move onto the highest pair of digits.
 $B5C1 LD A,(HL)     ; Fetch the highest pair of digits of the score.
 $B5C2 ADC A,$00     ; {Add the carry to the digits (in BCD).
 $B5C4 DAA           ; }
 $B5C5 LD (HL),A     ; Store the new highest pair of digits.
; Check the active player.
 $B5C6 LD A,($969E)  ; {Jump to #R$B5D4 if the active player is 2UP.
 $B5C9 AND A         ;
 $B5CA JR NZ,$B5D4   ; }
; View the equivalent code in;
; #LIST
; { #COOKIE$7415 }
; { #JETPAC$70F9 }
; { #LUNARJETMAN$899C }
; { #PSSST$737A }
; { #TRANZAM$6046 }
; { #UNDERWURLDE$A045 }
; LIST#

; Print Scores
;
; Used by the routine at #R$9960.
; .
; Prints the score of player 1, the score of player 2 or the high score on
; the screen as six digits. Each of the entry points sets the screen address and
; the score to print and joins the code at #R$B5E2.
; .
; #PUSHS #UDGTABLE(default,centre)
; { =h Before }
; { #SIM(start=$9960,stop=$9986,clear=1,sp=$5B40)
; #SCR$02,$00,$00,$20,$02(scores-before) }
; { =h After #R$B5CC }
; { #SIM(start=$9986,stop=$998F,sp=$5B40)
; #SCR$02,$00,$00,$20,$02(scores-after) } UDGTABLE# #POPS
;
; .
;
; Sets up the 1UP score.
@label=Score_1UP
c$B5CC LD HL,$4021   ; Set the screen address of the 1UP score in #REGhl.
 $B5CF LD DE,$9698   ; Point #REGde at the score of 1UP at #R$9698.
 $B5D2 JR $B5E2      ; Jump to #R$B5E2 to print the score.
; This entry point is used by the routines at #R$9960 and #R$B5A9.
; .
; Sets up the 2UP score.
@label=Score_2UP
*$B5D4 LD HL,$4039   ; Set the screen address of the 2UP score in #REGhl.
 $B5D7 LD DE,$969B   ; Point #REGde at the score of 2UP at #R$969B.
 $B5DA JR $B5E2      ; Jump to #R$B5E2 to print the score.
; This entry point is used by the routines at #R$9960 and #R$B61E.
; .
; Sets up the HI score.
@label=Score_HI
*$B5DC LD HL,$402D   ; Set the screen address of the high score in #REGhl.
 $B5DF LD DE,$B304   ; Point #REGde at the top high score at #R$B304.
; Prints the score.
@label=PrintScore
*$B5E2 LD B,$03      ; Set the number of bytes of the score in #REGb to #N$03.
; This entry point is used by the routines at #R$9CC6 and #R$B29F.
@label=PrintScore_Loop
*$B5E4 LD A,(DE)     ; Fetch a pair of digits of the score.
 $B5E5 RRCA          ; {Move the upper digit into the lower four bits.
 $B5E6 RRCA          ;
 $B5E7 RRCA          ;
 $B5E8 RRCA          ; }
 $B5E9 AND %00001111 ; Keep only bits 0-3.
 $B5EB ADD A,$30     ; Convert the digit to ASCII.
 $B5ED CALL $B589    ; Print the upper digit.
; This entry point is used by the routine at #R$9CC6.
@label=PrintScore_LowDigit
*$B5F0 LD A,(DE)     ; Fetch the pair of digits of the score again.
 $B5F1 AND %00001111 ; Keep only bits 0-3.
 $B5F3 ADD A,$30     ; Convert the digit to ASCII.
 $B5F5 CALL $B589    ; Print the lower digit.
 $B5F8 INC DE        ; Move onto the next pair of digits of the score.
 $B5F9 DJNZ $B5E4    ; Decrease the digit pair counter by one and loop back to #R$B5E4
                     ; until all six digits have been printed.
 $B5FB RET           ; Return.
; View the equivalent code in;
; #LIST
; { #COOKIE$7438 }
; { #JETPAC$711C }
; { #LUNARJETMAN$89BF }
; { #PSSST$739D }
; { #TRANZAM$6CB6 }
; LIST#

; New High Score
;
; Used by the routine at #R$AAA4.
; .
; Called when the game has ended to see whether either of the scores has
; made it into the hall of fame. The player with the highest score is dealt
; with first (see #R$B61E) and then the other player, so if both players have
; scored enough the higher score is entered first.
; .
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After #R$B5FC }
; { #SIM(start=$9960,stop=$998F,clear=1,sp=$5B40)
; #SIM(start=$99A7,stop=$99AA,sp=$5B40)
; #SCR$01(new-high-score-before)
; | #POKES$9698,$11;$9699,$50;$969A,$00
; #SIM(start=$B5FC,stop=$B6A5,sp=$5B40)
; #SCR$01(new-high-score-after) } UDGTABLE# #POPS
@label=NewHighScore
c$B5FC LD HL,$9698   ; Point #REGhl at the score of 1UP at #R$9698.
 $B5FF LD DE,$969B   ; Point #REGde at the score of 2UP at #R$969B.
 $B602 CALL $B6B2    ; Compare the two scores.
 $B605 LD A,$00      ; {Clear the hall of fame updated flag in #R$96BA (without changing the
 $B607 LD ($96BA),A  ; flags).}
 $B60A JR Z,$B610    ; {Jump to #R$B610 if the score of 1UP is higher than (or equal to) the
 $B60C JR C,$B610    ; score of 2UP.}
 $B60E CPL           ; Flip the bits to make 2UP the active player.
 $B60F EX DE,HL      ; Swap the score pointers, so #REGhl points to the score
                     ; of 2UP.
@label=NewHighScore_Process
*$B610 LD ($969E),A  ; Set the active player to the one with the highest score.
 $B613 CALL $B61E    ; Enter the high score.
 $B616 EX DE,HL      ; Swap the score pointers back, so #REGhl points to the
                     ; other score.
 $B617 LD A,($969E)  ; Fetch the active player from #R$969E.
 $B61A CPL           ; Flip the bits to switch to the other player.
 $B61B LD ($969E),A  ; Set the other player as the active player.
; View the equivalent code in;
; #LIST
; { #MARTIANOIDS$B958 }
; LIST#

; Enter High Score
;
; Used by the routine at #R$B5FC.
; .
; Works out whether a score is high enough to go in the hall of fame. If
; it is then every entry below it is moved down a place, the score is put in
; the gap and the player is asked to register their initials (see #R$B6D7).
; .
; The number of places that the score beat is stored in #R$96BB, so #N$01 means
; that the score only beat the sixth place and #N$06 means that it is the new
; top score.
; .
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After #R$B61E }
; { #SIM(start=$9960,stop=$998F,clear=1,sp=$5B40)
; #SIM(start=$99A7,stop=$99AA,sp=$5B40)
; #SCR$01(enter-high-score-before)
; | #POKES$9698,$08;$9699,$00;$969A,$00
; #SIM(start=$B61E,stop=$B6A5,hl=$9698,sp=$5B40)
; #SCR$01(enter-high-score-after) } UDGTABLE# #POPS
;
; HL Pointer to the score of the player
@label=NewHighScore_Enter
c$B61E PUSH DE       ; Stash the score pointers on the stack.
 $B61F PUSH HL       ; Stash #REGhl on the stack.
; We hold six high scores. Start at the sixth one and compare it to the
; score, moving up while the score is greater.
 $B620 LD B,$06      ; Set the number of high scores in #REGb to #N$06.
 $B622 LD DE,$B322   ; Point #REGde at the sixth high score at #R$B322.
@label=NewHighScore_Position_Loop
*$B625 CALL $B6B2    ; Compare the high score with the score of the player.
 $B628 JR NC,$B62F   ; Jump to #R$B62F if the high score is not lower than the score of the
                     ; player.
 $B62A CALL $B6AB    ; Move back to the previous high score.
 $B62D DJNZ $B625    ; Decrease the high score counter by one and loop back to #R$B625
                     ; until all of the high scores have been checked.
@label=NewHighScore_PositionFound
*$B62F LD A,B        ; Fetch the position of the first high score that was not
                     ; beaten.
 $B630 CP $06        ; {Jump to #R$B6A8 if the score did not beat any of the
 $B632 JR Z,$B6A8    ; high scores.}
; Move the entries down. The sixth entry moves into the buffer at #R$B328.
 $B634 LD HL,$B322   ; Point #REGhl at the sixth high score at #R$B322.
 $B637 LD DE,$B328   ; Point #REGde at the new high score buffer at #R$B328.
 $B63A LD A,B        ; Fetch the position of the first high score that was not
                     ; beaten.
 $B63B NEG           ; Negate the position.
 $B63D ADD A,$06     ; #REGa=#REGa+#N$06 (the number of places beaten).
 $B63F LD ($96BB),A  ; Store the result at #R$96BB.
@label=NewHighScore_Move_Loop
*$B642 LD BC,$0006   ; Set the size of a high score entry in #REGbc to #N$0006.
 $B645 PUSH HL       ; Stash the pointer to the high score on the stack.
 $B646 LDIR          ; Copy the high score down one place.
 $B648 POP DE        ; Restore the pointer to the high score into #REGde.
 $B649 LD L,E        ; {Copy the pointer into #REGhl.
 $B64A LD H,D        ; }
 $B64B CALL $B6AB    ; Move back to the previous high score.
 $B64E EX DE,HL      ; Swap #REGde and #REGhl so the pointers are one entry
                     ; higher.
 $B64F DEC A         ; {Decrease the number of places beaten by one and loop back to #R$B642
 $B650 JR NZ,$B642   ; until all of the high scores have been moved down.}
; Write the score into the gap.
 $B652 POP HL        ; Restore the pointer to the score of the player from the
                     ; stack.
 $B653 PUSH HL       ; Stash the pointer to the score of the player on the
                     ; stack again.
 $B654 LD BC,$0003   ; Set the number of bytes of the score in #REGbc to
                     ; #N$0003.
 $B657 LDIR          ; Copy the score into the hall of fame.
 $B659 PUSH DE       ; Stash the pointer to the initials on the stack.
 $B65A CALL $B5DC    ; Print the new high score.
 $B65D LD A,($96BA)  ; {Jump to #R$B66D if the hall of fame has already been
 $B660 AND A         ; shown.
 $B661 JR NZ,$B66D   ; }
 $B663 INC A         ; Set the hall of fame updated flag.
 $B664 LD ($96BA),A  ; Store the flag in #R$96BA.
 $B667 LD HL,$61C6   ; Point #REGhl at the room data at #R$61C6.
 $B66A CALL $BBF7    ; Draw the room.
@label=NewHighScore_Update_ClearPanel
*$B66D CALL $B2D8    ; Clear the panel.
; Updates the text for the appropriate player number.
 $B670 LD A,($969E)  ; Fetch the active player from #R$969E.
 $B673 AND A         ; Is this 1UP or 2UP?
 $B674 LD A,$B1      ; #REGa=#N$B1 (ASCII "1"+#N$80).
 $B676 JR Z,$B679    ; Jump to #R$B679 if the current player is 1UP.
 $B678 INC A         ; Else, #REGa=#N$B2 (ASCII "2"+#N$80).
; Overwrite the copy: #PUSHS
; #TABLE(default,centre,centre)
; { =h Byte | =h Copy }
; { #N$B1 | #POKES$B783,$B1 "#STR($B77C)" }
; { #N$B2 | #POKES$B783,$B2 "#STR($B77C)" }
; TABLE#
; #POPS
@label=NewHighScore_Update_Player
*$B679 LD ($B783),A  ; Write #REGa to #R$B77C(#N$B783).
; Work out which of the #R$B6C5 to use.
 $B67C LD A,($96BB)  ; {Fetch the number of places beaten from #R$96BB into
 $B67F LD B,A        ; #REGb.}
 $B680 LD A,$FD      ; #REGa=#N$FD (as #N$FD+#N$03=#N$00 - so the offset is
                     ; then pointing at the #R$B6C5(base address)).
@label=NewHighScore_Suffix_Loop
*$B682 ADD A,$03     ; Move onto the next suffix.
 $B684 DJNZ $B682    ; Decrease the position counter by one and loop back to #R$B682 until
                     ; the offset has been found.
; Fetch the appropriate position suffix.
 $B686 LD C,A        ; {Create an offset in #REGbc.
 $B687 LD B,$00      ; }
 $B689 LD HL,$B6C5   ; {#REGhl=#R$B6C5 + offset.
 $B68C ADD HL,BC     ; }
 $B68D LD DE,$B79C   ; #REGde=#R$B795(#N$B79C).
 $B690 LD BC,$0003   ; #REGbc=#N$0003 (counter).
; Overwrite the copy: #PUSHS
; #TABLE(default,centre,centre)
; { =h Byte | =h Copy }
; { #N$00 | #FOR($00,$02)(n,#POKES($B79C+n,#PEEK($B6C5+n))) "#STR($B795)" }
; { #N$01 | #FOR($00,$02)(n,#POKES($B79C+n,#PEEK($B6C8+n))) "#STR($B795)" }
; { #N$02 | #FOR($00,$02)(n,#POKES($B79C+n,#PEEK($B6CB+n))) "#STR($B795)" }
; { #N$03 | #FOR($00,$02)(n,#POKES($B79C+n,#PEEK($B6CE+n))) "#STR($B795)" }
; { #N$04 | #FOR($00,$02)(n,#POKES($B79C+n,#PEEK($B6D1+n))) "#STR($B795)" }
; TABLE#
; #POPS
 $B693 LDIR          ; Copy #N$0003 bytes of data from #REGhl to
                     ; #R$B795(#N$B79C).
; Print the messaging to the screen.
 $B695 LD DE,$B755   ; Point #REGde at the attributes of the lines of text at
                     ; #R$B755.
 $B698 EXX           ; Switch to the shadow registers.
 $B699 LD HL,$B75D   ; Point #REGhl' at the positions of the lines of text at
                     ; #R$B75D.
 $B69C LD DE,$B76D   ; Point #REGde' at the lines of text at #R$B76D.
; There are eight lines of text.
 $B69F LD B,$08      ; Set the number of lines of text in the shadow #REGb register to
                     ; #N$08.
 $B6A1 CALL $B47F    ; Print the lines of text.
 $B6A4 POP DE        ; Restore the pointer to the initials from the stack.
 $B6A5 CALL $B6D7    ; Let the player enter their initials.
@label=NewHighScore_Finish
*$B6A8 POP HL        ; Restore the pointer to the score of the player from the
                     ; stack.
 $B6A9 POP DE        ; Restore #REGde from the stack.
 $B6AA RET           ; Return.
; View the equivalent code in;
; #LIST
; { #MARTIANOIDS$B970 }
; LIST#

; Previous High Score
;
; Used by the routine at #R$B61E.
; .
; Moves a pointer to a high score back to the previous entry (from the 6th
; entry towards the 1st one). Each entry is six bytes long.
;
;   DE Pointer to an entry
; O:DE Pointer to the entry before it
@label=NewHighScore_Next
c$B6AB DEC DE        ; {Decrease #REGde by six.
 $B6AC DEC DE        ;
 $B6AD DEC DE        ;
 $B6AE DEC DE        ;
 $B6AF DEC DE        ;
 $B6B0 DEC DE        ; }
 $B6B1 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #MARTIANOIDS$B9E7 }
; LIST#

; Compare Scores
;
; Used by the routines at #R$B5FC and #R$B61E.
; .
; Compares the scores pointed to by #REGde and #REGhl. They are held as
; three bytes, with the most significant digits first.
;
;   DE Pointer to a score
;   HL Pointer to a score
; O:F Carry set if the score at #REGde is less than the score at #REGhl. Zero
; .   set if they are equal
@label=NewHighScore_Compare
c$B6B2 PUSH BC       ; {Stash #REGbc, #REGde and #REGhl on the stack.
 $B6B3 PUSH DE       ;
 $B6B4 PUSH HL       ; }
; Scores are held in three bytes.
 $B6B5 LD B,$03      ; Set the number of bytes of the score in #REGb to #N$03.
@label=NewHighScore_Compare_Loop
*$B6B7 LD A,(DE)     ; Fetch a pair of digits of the first score.
 $B6B8 CP (HL)       ; Compare it with the pair of digits of the second score.
 $B6B9 JR C,$B6C1    ; Jump to #R$B6C1 if the first score is lower.
 $B6BB JR NZ,$B6C1   ; Jump to #R$B6C1 if the first score is higher.
 $B6BD INC HL        ; {Move onto the next pair of digits of both scores.
 $B6BE INC DE        ; }
 $B6BF DJNZ $B6B7    ; Decrease the digit pair counter by one and loop back to #R$B6B7
                     ; until all three pairs of digits have been compared.
@label=NewHighScore_Compare_Return
*$B6C1 POP HL        ; {Restore #REGhl, #REGde and #REGbc from the stack.
 $B6C2 POP DE        ;
 $B6C3 POP BC        ; }
 $B6C4 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #MARTIANOIDS$B9EE }
; LIST#

; Messaging: High Score Suffixes
;
; The text for the place of a score which has beaten the sixth entry down
; to the second one. These are used to complete the message on the new high
; score screen. The last entry is blank, as a new top score is just "highest".
@label=HighScore_Suffixes
t$B6C5 DEFM "6TH"    ; "#STR(#PC,$04,$03)".
 $B6C8 DEFM "5TH"    ; "#STR(#PC,$04,$03)".
 $B6CB DEFM "4TH"    ; "#STR(#PC,$04,$03)".
 $B6CE DEFM "3RD"    ; "#STR(#PC,$04,$03)".
 $B6D1 DEFM "2ND"    ; "#STR(#PC,$04,$03)".
 $B6D4 DEFM "   "    ; "#STR(#PC,$04,$03)".

; Enter Initials
;
; Used by the routine at #R$B61E.
; .
; Lets the player choose three initials for the hall of fame, using the
; controls (see #R$B0A3). "Left" and "right" step through the letters (space
; followed by "A" to "Z"), and "fire" accepts the letter and moves to the next
; one. The initials are written to the hall of fame and drawn on the screen.
; .
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After #R$B6D7 }
; { #SIM(start=$9960,stop=$998F,clear=1,sp=$5B40)
; #SIM(start=$99A7,stop=$99AA,sp=$5B40)
; #POKES$9698,$11;$9699,$50;$969A,$00
; #SIM(start=$B5FC,stop=$B6A5,sp=$5B40)
; #SCR$02,$04,$05,$18,$10(enter-initials-before)
; | #SIM(start=$B709,stop=$B707,a=$20,hl=$506D,sp=$5B40)
; #SCR$02,$04,$05,$18,$10(enter-initials-after) } UDGTABLE# #POPS
;
; DE Address of the initials in the hall of fame
@label=EnterInitials
c$B6D7 LD B,$03      ; Set the number of initials in #REGb to #N$03.
 $B6D9 LD HL,$506D   ; #REGhl=#N($506D,$04,$04) (the screen address of the
                     ; first letter).
@label=EnterInitials_Letter
*$B6DC LD A,$20      ; Set the letter to a space (the first choice for each
                     ; initial).
@label=EnterInitials_Wait
*$B6DE PUSH AF       ; Stash the letter on the stack.
 $B6DF CALL $B0A3    ; Read the controls.
 $B6E2 POP AF        ; Restore the letter from the stack.
 $B6E3 BIT 4,C       ; {Jump to #R$B71B if "FIRE" is being pressed.
 $B6E5 JR NZ,$B71B   ; }
 $B6E7 BIT 0,C       ; {Jump to #R$B6F1 if "LEFT" is being pressed.
 $B6E9 JR NZ,$B6F1   ; }
 $B6EB BIT 1,C       ; {Jump to #R$B709 if "RIGHT" is being pressed.
 $B6ED JR NZ,$B709   ; }
 $B6EF JR $B6DE      ; Jump to #R$B6DE to wait for the controls.
; Choose the previous letter.
@label=EnterInitials_Previous
*$B6F1 CALL $B743    ; Pause and play a high tone.
 $B6F4 DEC A         ; Move back to the previous letter.
 $B6F5 CP $40        ; {Jump to #R$B6FB unless the letter is the one before "A"
 $B6F7 JR NZ,$B6FB   ; (#N$40).}
 $B6F9 LD A,$20      ; Wrap round to a space.
@label=EnterInitials_Previous_Wrap
*$B6FB CP $1F        ; {Jump to #R$B701 unless the letter is the one before a
 $B6FD JR NZ,$B701   ; space (#N$1F).}
 $B6FF LD A,$5A      ; Wrap round to "Z".
; Print the letter without moving along.
@label=EnterInitials_Print
*$B701 PUSH AF       ; Stash the letter on the stack.
 $B702 CALL $B589    ; Print the letter.
 $B705 POP AF        ; Restore the letter from the stack.
 $B706 DEC L         ; Move back to the column of the letter.
 $B707 JR $B6DE      ; Jump to #R$B6DE.
; Choose the next letter.
@label=EnterInitials_Next
*$B709 CALL $B743    ; Pause and play a high tone.
 $B70C INC A         ; Move on to the next letter.
 $B70D CP $5B        ; {Jump to #R$B713 unless the letter is the one after "Z"
 $B70F JR NZ,$B713   ; (#N$5B).}
 $B711 LD A,$20      ; Wrap round to a space.
@label=EnterInitials_Next_Wrap
*$B713 CP $21        ; {Jump to #R$B701 unless the letter is the one after a
 $B715 JR NZ,$B701   ; space (#N$21).}
 $B717 LD A,$41      ; Wrap round to "A".
 $B719 JR $B701      ; Jump to #R$B701.
; Accept the letter. First wait for "fire" to be released.
@label=EnterInitials_Accept
*$B71B PUSH AF       ; Stash the letter on the stack.
 $B71C CALL $B0A3    ; Read the controls.
 $B71F POP AF        ; Restore the letter from the stack.
 $B720 BIT 4,C       ; {Jump to #R$B71B until "FIRE" has been released.
 $B722 JR NZ,$B71B   ; }
 $B724 LD (DE),A     ; Write the letter into the hall of fame.
 $B725 INC DE        ; Move to the next letter in the hall of fame.
 $B726 PUSH AF       ; Stash the letter on the stack.
 $B727 PUSH BC       ; Stash the initials counter on the stack.
 $B728 CALL $B589    ; Print the chosen letter.
 $B72B INC L         ; Leave a gap before the next letter.
 $B72C CALL $BF2A    ; Play a low tone.
 $B72F LD BC,$0000   ; Set the delay counter in #REGbc to zero.
@label=EnterInitials_Delay
*$B732 DEC BC        ; Decrease the delay counter by one.
 $B733 LD A,B        ; {Test whether the delay counter is zero.
 $B734 OR C          ; }
 $B735 JR NZ,$B732   ; Loop back to #R$B732 until the delay is over.
 $B737 POP BC        ; Restore the initials counter from the stack.
 $B738 POP AF        ; Restore the letter from the stack.
 $B739 DJNZ $B6DC    ; Decrease the letter counter by one and loop back to #R$B6DC until
                     ; all three letters have been chosen.
; Introduce a pause by counting down from #N($10000,$04,$04) before
; returning (this jumps to a routine which returns).
 $B73B LD B,$01      ; Set the pause multiplier in #REGb to #N$01.
 $B73D LD HL,$0000   ; Set the pause counter in #REGhl to zero.
 $B740 JP $A1FF      ; Jump to #R$A1FF to pause before returning.
; View the equivalent code in;
; #LIST
; { #MARTIANOIDS$BA19 }
; LIST#

; Delay And Beep
;
; Used by the routine at #R$B6D7.
; .
; Used while the player chooses their initials. Pauses for a short time
; and then plays a high tone.
; .
; #HTML(#AUDIO0(high-tone.wav)(#INCLUDE(HighTone)))
@label=NewHighScore_Return
c$B743 PUSH AF       ; {Stash the registers on the stack.
 $B744 PUSH BC       ;
 $B745 PUSH HL       ; }
; Introduce a pause by counting down from #N($8000,$04,$04).
 $B746 LD B,$01      ; Set the pause multiplier in #REGb to #N$01.
 $B748 LD HL,$8000   ; Set the pause counter in #REGhl to #N($8000,$04,$04).
 $B74B CALL $A1FF    ; Pause.
 $B74E CALL $BF25    ; Play a high tone.
 $B751 POP HL        ; {Restore the registers from the stack.
 $B752 POP BC        ;
 $B753 POP AF        ; }
 $B754 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #MARTIANOIDS$BA93 }
; LIST#

; New High Score Attribute Table
;
; The attribute used for each of the eight lines of text of the new high
; score screen.
@label=NewHighScore_Attributes
b$B755 DEFB $45      ; {#TABLE(default,centre)
 $B756 DEFB $45      ; { =h Byte(n) | =h Menu Item }
 $B757 DEFB $45      ; { #N$01 | CONGRATULATIONS }
 $B758 DEFB $45      ; { #N$02 | PLAYER }
 $B759 DEFB $45      ; { #N$03 | YOU HAVE ACHIEVED }
 $B75A DEFB $43      ; { #N$04 | TODAYS HIGHEST }
 $B75B DEFB $43      ; { #N$05 | SCORE }
 $B75C DEFB $47      ; { #N$06 | PLEASE REGISTER }
                     ; { #N$07 | YOUR INITIALS }
                     ; { #N$08 | - - - }
                     ; TABLE#}

; New High Score Position Table
;
; The X and Y positions (in pixels) of each of the eight lines of text of
; the new high score screen.
@label=NewHighScore_Position
b$B75D DEFB $40,$28  ; {#TABLE(default,centre,centre,centre)
 $B75F DEFB $60,$38  ; { =h X Position | =h Y Position | =h Menu Item }
 $B761 DEFB $38,$48  ; { #N(#EVAL(#PEEK(#PC+$00) / $08)) | #N(#EVAL(#PEEK(#PC+$01)) / $08) | CONGRATULATIONS }
 $B763 DEFB $38,$58  ; { #N(#EVAL(#PEEK(#PC+$02) / $08)) | #N(#EVAL(#PEEK(#PC+$03)) / $08) | PLAYER }
 $B765 DEFB $68,$68  ; { #N(#EVAL(#PEEK(#PC+$04) / $08)) | #N(#EVAL(#PEEK(#PC+$05)) / $08) | YOU HAVE ACHIEVED }
 $B767 DEFB $40,$78  ; { #N(#EVAL(#PEEK(#PC+$06) / $08)) | #N(#EVAL(#PEEK(#PC+$07)) / $08) | TODAYS HIGHEST }
 $B769 DEFB $48,$88  ; { #N(#EVAL(#PEEK(#PC+$08) / $08)) | #N(#EVAL(#PEEK(#PC+$09)) / $08) | SCORE }
 $B76B DEFB $68,$98  ; { #N(#EVAL(#PEEK(#PC+$0A) / $08)) | #N(#EVAL(#PEEK(#PC+$0B)) / $08) | PLEASE REGISTER }
                     ; { #N(#EVAL(#PEEK(#PC+$0C) / $08)) | #N(#EVAL(#PEEK(#PC+$0D)) / $08) | YOUR INITIALS }
                     ; { #N(#EVAL(#PEEK(#PC+$0E) / $08)) | #N(#EVAL(#PEEK(#PC+$0F)) / $08) | - - - }
                     ; TABLE#}

; Messaging: New High Score Screen Text
;
; The eight lines of text of the new high score screen. The last character
; of each string has bit 7 set.
@label=NewHighScore_Text
t$B76D DEFM "CONGRATULATION","S"+$80   ; "#STR(#PC)".
; This is altered by the code at #R$B679.
 $B77C DEFM "PLAYER "                  ; "PLAYER ".
@label=NewHighScore_Text_PlayerNumber
 $B783 DEFM " "+$80                    ; The player number, which is set by
                                       ; #R$B679.
 $B784 DEFM "YOU HAVE ACHIEVE","D"+$80 ; "#STR(#PC)".
; This is altered by the code at #R$B68D.
 $B795 DEFM "TODAYS "                  ; "TODAYS ".
@label=NewHighScore_Text_Position
 $B79C DEFM "   "                      ; The position reached, with its suffix (for example "6TH"), which
                                       ; is set by #R$B68D.
 $B79F DEFM " HIGHES","T"+$80          ; " HIGHEST".
 $B7A7 DEFM "SCOR","E"+$80             ; "#STR(#PC)".
 $B7AC DEFM "PLEASE REGISTE","R"+$80   ; "#STR(#PC)".
 $B7BB DEFM "YOUR INITIAL","S"+$80     ; "#STR(#PC)".
 $B7C8 DEFM "- - ","-"+$80             ; "#STR(#PC)".

; Display Lives
;
; Used by the routines at #R$9F6A, #R$A2F8, #R$AA27 and #R$B1B7.
; .
; Shows the number of lives of each player at the top of the screen as a
; digit followed by a small picture of Sabreman. If a player has no lives left
; then spaces are printed. The lives of player 1 are on the left and the lives
; of player 2 are on the right.
; .
; #PUSHS #UDGTABLE(default,centre)
; { =h Before }
; { #SIM(start=$9960,stop=$998F,clear=1,sp=$5B40)
; #SIM(start=$99A7,stop=$99AA,sp=$5B40)
; #SCR$02,$00,$00,$20,$02(display-lives-before) }
; { =h After #R$B7CD }
; { #POKES$96BD,$05
; #SIM(start=$B7CD,stop=$0000,sp=$5B40)
; #SCR$02,$00,$00,$20,$02(display-lives-after) } UDGTABLE# #POPS
;
; .
;
; Controller for 1UP lives.
@label=DisplayPlayerLives
c$B7CD LD HL,$4008   ; Set the screen address of the 1UP lives in #REGhl.
 $B7D0 CALL $B7FE    ; Fetch the number of lives of 1UP.
 $B7D3 AND A         ; {Jump to #R$B7EF if 1UP has no lives left.
 $B7D4 JR Z,$B7EF    ; }
 $B7D6 CALL $B7E2    ; Display the lives of 1UP.
; Controller for 2UP lives.
@label=Controller2UPLives
*$B7D9 LD HL,$4016   ; Set the screen address of the 2UP lives in #REGhl.
 $B7DC CALL $B80C    ; Fetch the number of lives of 2UP.
 $B7DF AND A         ; {Jump to #R$B7F4 if 2UP has no lives left.
 $B7E0 JR Z,$B7F4    ; }
; Handles displaying the lives count and UDG character.
@label=HandlerDisplayLives
*$B7E2 ADD A,$30     ; Convert the number of lives to an ASCII digit.
 $B7E4 CALL $B589    ; Print the number of lives.
 $B7E7 LD DE,$B814   ; Point #REGde at the life icon at #R$B814.
 $B7EA PUSH BC       ; {Stash #REGbc and #REGde on the stack, ready for
 $B7EB PUSH DE       ; #R$B599.}
 $B7EC JP $B599      ; Jump to #R$B599 to draw the life icon.
; 1UP has no lives.
@label=Handler1UPNoLives
*$B7EF CALL $B7F4    ; Clear the lives of 1UP.
 $B7F2 JR $B7D9      ; Jump to #R$B7D9.
; 2UP has no lives.
@label=Handler2UPNoLives
*$B7F4 LD A,$20      ; Set the character to a space.
 $B7F6 CALL $B589    ; Print a space, to clear the number of lives.
 $B7F9 LD A,$20      ; Set the character to a space.
 $B7FB JP $B589      ; Print a space, to clear the life icon.
; Return the 1UP player's lives left.
@label=FetchLives_1UP
*$B7FE LD A,($969E)  ; {Jump to #R$B808 if the active player is 2UP (so 1UP is
 $B801 AND A         ; inactive).
 $B802 JR NZ,$B808   ; }
; Return currently active players lives left.
@label=ActivePlayerLives
*$B804 LD A,($96BD)  ; Fetch the lives of the active player from #R$96BD.
 $B807 RET           ; Return.
; Return inactive players lives left.
@label=InactivePlayerLives
*$B808 LD A,($96E0)  ; Fetch the lives of the inactive player from #R$96E0.
 $B80B RET           ; Return.
; Return the 2UP player's lives left.
@label=FetchLives_2UP
*$B80C LD A,($969E)  ; {Jump to #R$B808 if the active player is 1UP (so 2UP is
 $B80F AND A         ; inactive).
 $B810 JR Z,$B808    ; }
 $B812 JR $B804      ; Jump to #R$B804.
; View the equivalent code in;
; #LIST
; { #COOKIE$7378 }
; { #JETPAC$70A4 }
; { #LUNARJETMAN$894F }
; { #PSSST$7325 }
; LIST#

; The UDG for the lives icon
;
; The graphic which #R$B7CD draws for each of the lives of the player.
@label=UDG_Life
b$B814 DEFB %00011000 ; {#UDGTABLE(default,centre) { #UDG#(#PC),attr=$07 }
 $B815 DEFB %00100100 ; UDGTABLE#
 $B816 DEFB %00111100 ;
 $B817 DEFB %01111110 ;
 $B818 DEFB %01011010 ;
 $B819 DEFB %00111100 ;
 $B81A DEFB %00111100 ;
 $B81B DEFB %01100110 ; }

; Slide Actor Past Objects
;
; Used by the routines at #R$9B0D, #R$9D91, #R$9E72, #R$A4D7, #R$A54F, #R$A858,
; #R$A9BE, #R$AB74, #R$AD07, #R$ADD0 and #R$AEEF.
; .
; Stops an actor moving through the objects of the room. The new position
; of the actor is tested with #R$B873 against each of the objects in the
; layout of the room (the pointers to the layouts are in #R$6166, found from
; the room with #R$6066). If it overlaps with an object then the movement is
; tried in the X direction only and the Y direction only so that the actor can
; slide along the object. If neither works then the actor is left where it
; was.
; .
; The Y position of an actor is the position of its feet, and the Y position
; of an object is the top of it.
;
;   B Height of the actor
;   C Width of the actor
;   DE New position of the actor, with Y in #REGd and X in #REGe
;   IX Actor record
; O:DE The position that the actor can move to
@label=SlideActorPastObjects
c$B81C PUSH IX       ; {Stash the actor record and the size of the actor on the
 $B81E PUSH BC       ; stack.}
 $B81F LD L,(IX+$03) ; Fetch the X position of the actor.
 $B822 LD H,(IX+$04) ; Fetch the Y position of the actor.
 $B825 LD ($96AE),HL ; Remember the old X position in #R$96AE and the old Y position in
                     ; #R$96AF.
 $B828 LD L,(IX+$01) ; Fetch the room of the actor.
 $B82B LD H,$00      ; Clear #REGh.
 $B82D LD BC,$6066   ; {Add the layout table at #R$6066 to find the layout number of the
 $B830 ADD HL,BC     ; room.}
 $B831 LD L,(HL)     ; Fetch the layout number of the room.
 $B832 LD H,$00      ; Clear #REGh.
 $B834 ADD HL,HL     ; Double it, as each pointer is two bytes.
 $B835 LD BC,$6166   ; {Add the table of object lists at #R$6166 to find the pointer to the
 $B838 ADD HL,BC     ; list of objects.}
 $B839 LD A,(HL)     ; Fetch the low byte of the address of the list of
                     ; objects.
 $B83A INC HL        ; Move to the high byte.
 $B83B LD H,(HL)     ; Fetch the high byte of the address of the list of
                     ; objects.
 $B83C LD L,A        ; Combine the low byte with the high byte.
 $B83D PUSH HL       ; {Point #REGix at the list of objects.
 $B83E POP IX        ; }
 $B840 POP BC        ; Restore the size of the actor from the stack.
; Test the new position.
 $B841 PUSH IX       ; Stash the pointer to the list of objects on the stack.
 $B843 CALL $B873    ; Test whether the new position overlaps with an object.
 $B846 POP IX        ; Restore the pointer to the list of objects from the
                     ; stack.
 $B848 JR NC,$B870   ; Jump to #R$B870 if the new position does not overlap
                     ; with an object.
; Try moving in the X direction only.
 $B84A PUSH DE       ; Stash the new position on the stack.
 $B84B LD A,($96AF)  ; Fetch the old Y position.
 $B84E LD D,A        ; Use the old Y position instead.
 $B84F PUSH IX       ; Stash the pointer to the list of objects on the stack.
 $B851 CALL $B873    ; Test whether moving in the X direction only overlaps
                     ; with an object.
 $B854 POP IX        ; Restore the pointer to the list of objects from the
                     ; stack.
 $B856 POP DE        ; Restore the new position from the stack.
 $B857 JR NC,$B85D   ; Jump to #R$B85D if the actor can move in the X
                     ; direction.
 $B859 LD A,($96AE)  ; {Keep the old X position, as the actor cannot move in the X
 $B85C LD E,A        ; direction.}
; Try moving in the Y direction only.
@label=SlideActorPastObjects_Vertical
*$B85D PUSH DE       ; Stash the new position on the stack.
 $B85E LD A,($96AE)  ; {Use the old X position instead.
 $B861 LD E,A        ; }
 $B862 PUSH IX       ; Stash the pointer to the list of objects on the stack.
 $B864 CALL $B873    ; Test whether moving in the Y direction only overlaps
                     ; with an object.
 $B867 POP IX        ; Restore the pointer to the list of objects from the
                     ; stack.
 $B869 POP DE        ; Restore the new position from the stack.
 $B86A JR NC,$B870   ; Jump to #R$B870 if the actor can move in the Y
                     ; direction.
 $B86C LD A,($96AF)  ; {Keep the old Y position, as the actor cannot move in the Y
 $B86F LD D,A        ; direction.}
@label=SlideActorPastObjects_Return
*$B870 POP IX        ; Restore the actor record from the stack.
 $B872 RET           ; Return.

; Test Object Overlap
;
; Used by the routine at #R$B81C.
; .
; Tests whether an actor at a position would overlap with any object in a
; list. The list is made up of four byte entries. The first two bytes are the
; address of the graphic of the object, then the X and Y positions of the
; object. The list ends with an address of zero. The first two bytes of the
; graphic are the height in pixels and the width in bytes.
;
;   B Height of the actor
;   C Width of the actor
;   D Y position of the actor
;   E X position of the actor
;   IX Pointer to the list of objects
; O:F Carry flag set if the actor overlaps with an object
@label=TestObjectOverlap
c$B873 LD L,(IX+$00) ; Fetch the low byte of the address of the object.
 $B876 LD H,(IX+$01) ; Fetch the high byte of the address of the object.
 $B879 LD A,H        ; {Combine the bytes to check for zero.
 $B87A OR L          ; }
 $B87B RET Z         ; Return if the address is zero (the end of the list), with the
                     ; carry flag reset.
 $B87C LD A,(HL)     ; Fetch the height of the object in pixels.
 $B87D INC HL        ; Move to the width of the object.
 $B87E LD H,(HL)     ; Fetch the width of the object in bytes.
 $B87F LD L,A        ; Set the height of the object in #REGl.
 $B880 LD A,H        ; Fetch the width of the object in bytes.
 $B881 RLCA          ; {Multiply by eight.
 $B882 RLCA          ;
 $B883 RLCA          ; }
 $B884 AND %11111000 ; Keep only bits 3-7.
 $B886 LD H,A        ; #REGh=the width of the object in pixels.
; Compare the X positions.
 $B887 LD A,E        ; Fetch the X position of the actor.
 $B888 SUB (IX+$02)  ; Subtract the X position of the object.
 $B88B JP P,$B8A7    ; Jump to #R$B8A7 if the actor is not to the left of the
                     ; object.
 $B88E CPL           ; Flip the bits to get the distance from the object, less
                     ; one.
 $B88F CP C          ; Compare with the width of the actor.
@label=TestObjectOverlap_Horizontal
*$B890 JR NC,$B89D   ; Jump to #R$B89D if the actor is too far away.
; Compare the Y positions.
 $B892 LD A,D        ; Fetch the Y position of the actor.
 $B893 SUB L         ; Subtract the height of the object.
 $B894 SUB (IX+$03)  ; Subtract the Y position of the object.
 $B897 JP P,$B8AA    ; Jump to #R$B8AA if the feet of the actor are below the
                     ; object.
 $B89A CPL           ; Flip the bits to get the distance from the object, less
                     ; one.
 $B89B CP L          ; Compare with the height of the object.
@label=TestObjectOverlap_Return
*$B89C RET C         ; Return if the actor overlaps with the object.
; Move on to the next object.
@label=TestObjectOverlap_Next
*$B89D INC IX        ; {Move #REGix on four bytes.
 $B89F INC IX        ;
 $B8A1 INC IX        ;
 $B8A3 INC IX        ; }
 $B8A5 JR $B873      ; Jump to #R$B873.
; The actor is to the right of the object so compare with the width of the
; object.
@label=TestObjectOverlap_Right
*$B8A7 CP H          ; Compare with the width of the object.
 $B8A8 JR $B890      ; Jump to #R$B890.
; The feet of the actor are below the object, so compare with the height
; of the actor.
@label=TestObjectOverlap_Below
*$B8AA CP B          ; Compare with the height of the actor.
 $B8AB JR $B89C      ; Jump to #R$B89C.

; Calculate Screen Address
;
; Used by the routines at #R$B29F, #R$B52D, #R$B53D, #R$B939, #R$B969 and
; #R$BBF7.
; .
; Converts pixel coordinates into the address of the byte in the display
; file that holds the pixel.
;
;   H Y coordinate
;   L X coordinate
; O:HL Screen address
;
; The low byte is made up of the column (bits 0-4) and the character row
; within the third of the screen (bits 5-7).
@label=ScreenAddress
c$B8AD LD A,L        ; #REGa=#REGl.
 $B8AE RRCA          ; {Divide the X coordinate by #N$08 to get the column.
 $B8AF RRCA          ;
 $B8B0 RRCA          ; }
 $B8B1 AND %00011111 ; Keep only bits 0-4.
 $B8B3 LD L,A        ; #REGl=#REGa.
 $B8B4 LD A,H        ; #REGa=#REGh.
 $B8B5 RLCA          ; {Multiply the Y coordinate by #N$04, which moves bits 3-5 into bits
 $B8B6 RLCA          ; 5-7.}
 $B8B7 AND %11100000 ; Keep only bits 5-7.
 $B8B9 OR L          ; Merge in the column.
 $B8BA LD L,A        ; #REGl=#REGa.
; The high byte is made up of the third of the screen (bits 3-4) and the
; pixel line within the character (bits 0-2).
 $B8BB LD A,H        ; #REGa=#REGh.
 $B8BC AND %00000111 ; Keep only bits 0-2 (the pixel line).
 $B8BE EX AF,AF'     ; Store the pixel line in #REGaf'.
 $B8BF LD A,H        ; #REGa=#REGh.
 $B8C0 RRCA          ; {Divide the Y coordinate by #N$08.
 $B8C1 RRCA          ;
 $B8C2 RRCA          ; }
 $B8C3 AND %00011000 ; Keep only bits 3-4 (the third of the screen).
 $B8C5 OR %01000000  ; Set bit 6 to point to the display file.
 $B8C7 LD H,A        ; #REGh=#REGa.
 $B8C8 EX AF,AF'     ; Fetch the pixel line from #REGaf'.
 $B8C9 OR H          ; Merge in the third of the screen.
 $B8CA LD H,A        ; #REGh=#REGa.
 $B8CB RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9BA2 }
; { #COOKIE$76E3 }
; { #JETPAC$7308 }
; { #LUNARJETMAN$851E }
; { #MARTIANOIDS$BD4B }
; { #PSSST$759A }
; { #TRANZAM$6F10 }
; { #UNDERWURLDE$ADF8 }
; LIST#

; Screen Address One Pixel Below
;
; Used by the routines at #R$B2D8 and #R$BBF7.
; .
; Calculates the address of the pixel line below the one at a screen
; address, taking into consideration the layout of the display file.
;
;   HL Current screen address
; O:HL Screen address of the pixel line below
@label=ScreenPosition1PixelBelow
c$B8CC INC H         ; Increment #REGh to move down one pixel on screen.
 $B8CD LD A,H        ; #REGa=#REGh.
 $B8CE AND %00000111 ; Keep only bits 0-2.
 $B8D0 RET NZ        ; If a character line has not been crossed then return.
 $B8D1 LD A,L        ; {#REGl=#REGl+#N$20.
 $B8D2 ADD A,$20     ;
 $B8D4 LD L,A        ; }
 $B8D5 AND %11100000 ; Keep only bits 5-7.
 $B8D7 RET Z         ; If a new section of the screen has not been crossed then
                     ; return.
 $B8D8 LD A,H        ; {#REGh=#REGh-#N$08.
 $B8D9 SUB $08       ;
 $B8DB LD H,A        ; }
 $B8DC RET           ; Return.
; View the equivalent code in;
; #LIST
; { #MARTIANOIDS$BD3A }
; { #UNDERWURLDE$9C2B }
; LIST#

; Calculate Attribute Address
;
; Used by the routines at #R$A680, #R$AEA1, #R$B52D, #R$B53D, #R$BB24 and
; #R$BBF7.
;
;   HL Pixel address co-ordinates
; O:HL Attribute buffer address
;
; Converts a given pixel address to the associated attribute buffer address.
@label=AttributeAddress
c$B8DD PUSH BC       ; Stash #REGbc on the stack.
 $B8DE LD A,L        ; Horizontal co-ordinate.
 $B8DF RRCA          ; {Divide by #N$08.
 $B8E0 RRCA          ;
 $B8E1 RRCA          ; }
 $B8E2 AND %00011111 ; Keep only bits 0-4 (#N$00-#N$1F / minimum-maximum
                     ; horizontal screen values).
 $B8E4 LD L,A        ; Store this back in #REGl.
 $B8E5 LD A,H        ; Vertical co-ordinate.
 $B8E6 RLCA          ; {Multiply by #N$04.
 $B8E7 RLCA          ; }
 $B8E8 LD C,A        ; Store this in #REGc temporarily.
 $B8E9 AND %11100000 ; Keep only bits 5-7.
 $B8EB OR L          ; Set the bits from #REGl.
 $B8EC LD L,A        ; #REGl=#REGa.
 $B8ED LD A,C        ; Fetch the stored value from #REGc.
 $B8EE AND %00000011 ; Keep only bits 0-1.
 $B8F0 OR %01011000  ; Set MSB of the attribute buffer #N$58. This ensures our
                     ; value is >= #R$5800.
 $B8F2 LD H,A        ; Store this back in #REGh.
 $B8F3 POP BC        ; Restore #REGbc from the stack.
 $B8F4 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9BD2 }
; { #COOKIE$7534 }
; { #JETPAC$720E }
; { #LUNARJETMAN$8506 }
; { #MARTIANOIDS$BD6A }
; { #PSSST$748F }
; { #UNDERWURLDE$ADE0 }
; LIST#

; Remove Entity
;
; Used by the routine at #R$AD46.
; .
; Removes an entity from the screen, by drawing the sprite at the old
; position that was saved by #R$BB0B. The sprites are drawn with XOR so this
; erases the sprite. No new sprite is drawn, so the row count of the new sprite
; is zero.
; .
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After #R$B8F5 }
; { #SIM(start=$9960,stop=$998F,clear=1,sp=$5B40)
; #SIM(start=$99A7,stop=$99AA,sp=$5B40)
; #SIM(start=$B919,stop=$0000,ix=$970E,sp=$5B40)
; #SIM(start=$BB24,stop=$0000,ix=$970E,sp=$5B40)
; #SIM(start=$BB0B,stop=$0000,ix=$970E,sp=$5B40)
; #SCR$03,$0C,$0D,$08,$06(remove-entity-before)
; | #SIM(start=$B8F5,stop=$0000,ix=$970E,sp=$5B40)
; #SCR$03,$0C,$0D,$08,$06(remove-entity-after) } UDGTABLE# #POPS
@label=RemoveEntity
c$B8F5 CALL $B939    ; Prepare the registers for the sprite at its old
                     ; position.
 $B8F8 EXX           ; Switch to the shadow registers.
 $B8F9 XOR A         ; {Set #REGa and #REGc to #N$00.
 $B8FA LD C,A        ; }
 $B8FB LD ($96A4),A  ; Write #N$00 to #R$96A4.
 $B8FE EXX           ; Switch back to the normal registers.
 $B8FF JP $B9DA      ; Jump to #R$B9DA.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9F56 }
; { #COOKIE$7607 }
; { #JETPAC$72A5 }
; { #PSSST$7526 }
; { #TRANZAM$7139 }
; { #UNDERWURLDE$9636 }
; LIST#

; Build Shift Table
;
; Used by the routine at #R$9960.
; .
; Builds a lookup table in the top #N$1000 bytes of memory (#N$F000 to
; #N$FFFF) which the sprite drawing routines use to position a sprite at any
; pixel.
; .
; For every byte value, and for each of the eight possible pixel offsets, the
; value shifted left by that many bits is stored as a 16-bit number. The low
; byte is written to the page at #N$FF - (#N$02 * offset) and the high byte to
; the page below it, both at the position given by the byte value.
;
; .
;
; Work through each byte value in turn, starting with #N$00.
@label=BuildShiftTable
c$B902 LD L,$00      ; #REGl=#N$00 (the byte value).
; Start with no shift (#REGe holds the low byte and #REGd the high byte
; of the shifted value).
@label=BuildShiftTable_Value
*$B904 LD D,$00      ; #REGd=#N$00.
 $B906 LD E,L        ; #REGe=#REGl.
 $B907 LD H,$FF      ; #REGh=#N$FF (the page for the first low byte).
 $B909 LD B,$08      ; #REGb=#N$08 (counter, one for each pixel offset).
; Store the low and the high byte, then shift the 16-bit value left by one
; bit for the next offset.
@label=BuildShiftTable_Offset
*$B90B LD (HL),E     ; Write the low byte.
 $B90C DEC H         ; Move down a page.
 $B90D LD (HL),D     ; Write the high byte.
 $B90E DEC H         ; Move down a page.
 $B90F SLA E         ; Shift #REGe left one bit (bit 7 goes into the carry
                     ; flag).
 $B911 RL D          ; Rotate #REGd left one bit, bringing in the carry flag.
 $B913 DJNZ $B90B    ; Decrease counter by one and loop back to #R$B90B until
                     ; zero.
 $B915 INC L         ; Move onto the next byte value.
 $B916 JR NZ,$B904   ; Jump back to #R$B904 until every byte value has been
                     ; done.
 $B918 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #UNDERWURLDE$9613 }
; LIST#

; Draw Entity
;
; Used by the routines at #R$9A68, #R$A1AB, #R$A234, #R$A323, #R$A43B, #R$AD63,
; #R$AECF, #R$B12F and #R$BBBB.
; .
; Draws an entity on the screen, at its current position, using XOR.
; Nothing is erased, as the entity has no old sprite on the screen, so the row
; count of the old sprite is zero.
; .
; The attributes are set separately by #R$BB24.
;
; IX Actor record
;
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After #R$B919 and #R$BB24 }
; { #SIM(start=$9960,stop=$998F,clear=1,sp=$5B40)
; #SIM(start=$99A7,stop=$99AA,sp=$5B40)
; #SCR$03,$0C,$0D,$08,$06(entity-before)
; | #SIM(start=$B919,stop=$0000,ix=$970E,sp=$5B40)
; #SIM(start=$BB24,stop=$0000,ix=$970E,sp=$5B40)
; #SCR$03,$0C,$0D,$08,$06(entity-after) } UDGTABLE# #POPS
@label=DrawEntity
c$B919 CALL $B969    ; Prepare the registers for the sprite at its new
                     ; position.
 $B91C EXX           ; Switch to the shadow registers, which belong to the old
                     ; sprite.
 $B91D XOR A         ; {Write #N$00 to #R$96A3 as there are no rows of the old sprite to
 $B91E LD ($96A3),A  ; draw.}
 $B921 LD C,A        ; #REGc=#N$00.
 $B922 JP $B9DA      ; Jump to #R$B9DA to draw the sprite.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9F4A }
; { #COOKIE$7617 }
; { #JETPAC$72B5 }
; { #PSSST$7536 }
; { #TRANZAM$7149 }
; { #UNDERWURLDE$962A }
; LIST#

; Get Sprite "A"
;
; Used by the routine at #R$B939.
; .
; Looks up the address of the data of the sprite whose ID was saved by
; #R$BB0B.
;
; O:DE The sprite address
@label=GetSpriteA
c$B925 LD A,($969F)  ; #REGa=*#R$969F.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9E86 }
; { #UNDERWURLDE$9643 }
; LIST#
; .
; Continue on to #R$B928.

; Fetch Sprite
;
; Used by the routine at #R$B934.
; .
; Looks up the address of the data of a sprite in the table at #R$BF84.
;
;   A The Sprite ID
; O:DE The sprite address
@label=FetchSprite
c$B928 LD L,A        ; {Create an offset in #REGhl.
 $B929 LD H,$00      ; }
 $B92B ADD HL,HL     ; #REGhl=#REGhl * 2.
 $B92C LD BC,$BF84   ; {#REGhl=#R$BF84 + offset.
 $B92F ADD HL,BC     ; }
 $B930 LD E,(HL)     ; {#REGde=the sprite address.
 $B931 INC HL        ;
 $B932 LD D,(HL)     ; }
 $B933 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9E89 }
; { #LUNARJETMAN$8568 }
; { #UNDERWURLDE$9646 }
; LIST#

; Fetch Actor Sprite
;
; Used by the routine at #R$B969.
; .
; Looks up the address of the data of the sprite of an actor.
;
;   IX Actor record
; O:DE The sprite address
@label=FetchActorSprite
c$B934 LD A,(IX+$00) ; #REGa=*#REGix+#N$00 (sprite reference).
 $B937 JR $B928      ; Jump to #R$B928.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9E96 }
; { #LUNARJETMAN$857F }
; { #UNDERWURLDE$9652 }
; LIST#

; Prepare Draw 2/ 3 Byte Sprite
;
; Used by the routines at #R$B8F5 and #R$B9A9.
; .
; Gets the registers ready to draw the sprite of an entity at its old
; position, which was saved by #R$BB0B.
; .
; The shift table page is put in #REGb, the screen address of the bottom row is
; put in #REGhl and the pointer to the pixel data is put in #REGde. The operand
; of the jump at #R$BA12 is changed so that the unrolled code that follows it
; draws the right number of bytes for each row, and the number of rows is stored
; in #R$96A3.
;
; O:B Page of the shift table
; O:C #N$00
; O:DE Address of the pixel data
; O:HL Screen address of the bottom row
@label=PrepDraw23
c$B939 CALL $B925    ; Fetch the address of the sprite data in #REGde.
 $B93C LD HL,($96A0) ; Fetch the old X position into #REGl and the old Y position into
                     ; #REGh from #R$96A0.
 $B93F LD A,L        ; #REGa=#REGl.
 $B940 DEC A         ; Subtract one.
 $B941 RLCA          ; Multiply by two (rotate left).
 $B942 AND %00001110 ; Keep only bits 1-3.
 $B944 OR %11110000  ; Set bits 4-7 to point at the pages #N$F0 to #N$FF.
 $B946 LD B,A        ; Store the page of the shift table in #REGb.
 $B947 LD A,(DE)     ; Fetch the width of the sprite in bytes.
 $B948 INC DE        ; Move on to the height of the sprite.
 $B949 NEG           ; Negate the width.
 $B94B AND %00000111 ; Keep only bits 0-2.
 $B94D ADD A,A       ; {Multiply by four.
 $B94E ADD A,A       ; }
 $B94F LD C,A        ; Store the result in #REGc.
 $B950 ADD A,A       ; Multiply by two.
 $B951 ADD A,C       ; Add the result so that it is multiplied by twelve (the size of the
                     ; code for one byte of the row).
 $B952 LD C,A        ; Store the offset in #REGc.
 $B953 LD A,L        ; #REGa=#REGl.
 $B954 AND %00000111 ; Keep only the pixel offset (bits 0-2).
 $B956 LD A,C        ; Fetch the offset.
 $B957 JR NZ,$B95B   ; Jump to #R$B95B if the sprite does not start on a character
                     ; boundary.
 $B959 ADD A,$06     ; Add #N$06 to the offset to skip the first six bytes of the code for
                     ; the first byte of the row, as no cell to the left is needed.
@label=PrepDraw23_SetJump
*$B95B LD ($BA13),A  ; Change the operand of the jump at #R$BA12.
 $B95E LD A,(DE)     ; Fetch the height of the sprite.
 $B95F INC DE        ; Move on to the pixel data.
 $B960 LD ($96A3),A  ; Write the number of rows of the old sprite to #R$96A3.
 $B963 CALL $B8AD    ; Convert the position into the screen address.
 $B966 LD C,$00      ; #REGc=#N$00.
 $B968 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9F80 }
; { #UNDERWURLDE$9657 }
; LIST#

; Prepare Draw 2 Byte Sprite
;
; Used by the routines at #R$B919 and #R$B9A9.
; .
; Gets the registers ready to draw the sprite of the entity that #REGix
; points at, at its current position.
; .
; It does what #R$B939 does for the old sprite, but it uses the position and the
; sprite of the entity, changes the operand of the jump at #R$BA91 (used by the
; code at #R$BA8C) and stores the number of rows in #R$96A4 and #R$96A5. The
; number of character cells that the sprite covers in each row (one more than
; the width if the sprite is not aligned to a character boundary) is stored in
; #R$96A6.
;
;   IX Actor record
; O:B Page of the shift table
; O:C #N$00
; O:DE Address of the pixel data
; O:HL Screen address of the bottom row
@label=PrepDraw2
c$B969 CALL $B934    ; Fetch the address of the sprite data in #REGde.
 $B96C LD L,(IX+$03) ; Fetch the X position of the entity into #REGl.
 $B96F LD H,(IX+$04) ; Fetch the Y position of the entity into #REGh.
 $B972 LD A,L        ; #REGa=#REGl.
 $B973 DEC A         ; Subtract one.
 $B974 RLCA          ; Multiply by two (rotate left).
 $B975 AND %00001110 ; Keep only bits 1-3.
 $B977 OR %11110000  ; Set bits 4-7 to point at the pages #N$F0 to #N$FF.
 $B979 LD B,A        ; Store the page of the shift table in #REGb.
 $B97A LD A,L        ; #REGa=#REGl.
 $B97B AND %00000111 ; Keep only the pixel offset (bits 0-2).
 $B97D LD A,(DE)     ; Fetch the width of the sprite in bytes.
 $B97E JR Z,$B981    ; Jump to #R$B981 if the sprite starts on a character
                     ; boundary.
 $B980 INC A         ; Add one for the extra cell that the shifted sprite
                     ; needs.
@label=PrepDraw2_StoreCells
*$B981 LD ($96A6),A  ; Write the number of cells in each row to #R$96A6.
 $B984 LD A,(DE)     ; Fetch the width of the sprite in bytes.
 $B985 INC DE        ; Move on to the height of the sprite.
 $B986 NEG           ; Negate the width.
 $B988 AND %00000111 ; Keep only bits 0-2.
 $B98A ADD A,A       ; {Multiply by four.
 $B98B ADD A,A       ; }
 $B98C LD C,A        ; Store the result in #REGc.
 $B98D ADD A,A       ; Multiply by two.
 $B98E ADD A,C       ; Add the result so that it is multiplied by twelve (the size of the
                     ; code for one byte of the row).
 $B98F LD C,A        ; Store the offset in #REGc.
 $B990 LD A,L        ; #REGa=#REGl.
 $B991 AND %00000111 ; Keep only the pixel offset (bits 0-2).
 $B993 LD A,C        ; Fetch the offset.
 $B994 JR NZ,$B998   ; Jump to #R$B998 if the sprite does not start on a character
                     ; boundary.
 $B996 ADD A,$06     ; Add #N$06 to the offset to skip the first six bytes of the code for
                     ; the first byte of the row, as no cell to the left is needed.
@label=PrepDraw2_SetJump
*$B998 LD ($BA92),A  ; Change the operand of the jump at #R$BA91.
 $B99B LD A,(DE)     ; Fetch the height of the sprite.
 $B99C INC DE        ; Move on to the pixel data.
 $B99D LD ($96A4),A  ; Write the number of rows of the new sprite to #R$96A4.
 $B9A0 LD ($96A5),A  ; Write the height of the sprite to #R$96A5.
 $B9A3 CALL $B8AD    ; Convert the position into the screen address.
 $B9A6 LD C,$00      ; #REGc=#N$00.
 $B9A8 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9F9F }
; { #UNDERWURLDE$9689 }
; LIST#

; Display Entity
;
; Used by the routines at #R$A680, #R$AD5D and #R$AEEF.
; .
; Moves an entity on the screen, by erasing the sprite at its old position
; (saved by #R$BB0B) and drawing it at its new one.
; .
; Both sprites are drawn with XOR, a row at a time, so that the rows are
; alternated between the two sprites and the screen is never without the sprite
; for long. If the sprites are offset vertically, the rows of the sprite that
; has no matching row in the other one are drawn first.
; .
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After #R$B9A9 and #R$BB24 }
; { #SIM(start=$9960,stop=$998F,clear=1,sp=$5B40)
; #SIM(start=$99A7,stop=$99AA,sp=$5B40)
; #SIM(start=$B919,stop=$0000,ix=$970E,sp=$5B40)
; #SIM(start=$BB24,stop=$0000,ix=$970E,sp=$5B40)
; #SIM(start=$BB0B,stop=$0000,ix=$970E,sp=$5B40)
; #SCR$03,$0A,$0B,$0E,$08(display-entity-before)
; | #POKES$9711,$80;$9712,$7B
; #SIM(start=$B9A9,stop=$0000,ix=$970E,sp=$5B40)
; #SIM(start=$BB24,stop=$0000,ix=$970E,sp=$5B40)
; #SCR$03,$0A,$0B,$0E,$08(display-entity-after) } UDGTABLE# #POPS
;
; IX Actor record
@label=DisplayEntity
c$B9A9 CALL $B969    ; Prepare the registers for the sprite at its new
                     ; position.
 $B9AC EXX           ; Switch to the registers of the old sprite.
 $B9AD CALL $B939    ; Prepare the registers for the sprite at its old
                     ; position.
 $B9B0 LD A,($96A1)  ; Fetch the old Y position from #R$96A1.
 $B9B3 SUB (IX+$04)  ; Subtract the new Y position of the entity.
 $B9B6 JP Z,$B9F4    ; Jump to #R$B9F4 if the Y position has not changed.
 $B9B9 JP M,$B9CB    ; Jump to #R$B9CB if the sprite has moved down the screen.
; The old sprite is lower than the new one, so draw the bottom rows of the
; old sprite on their own first.
 $B9BC LD C,A        ; Copy the number of rows that stand alone to #REGc.
 $B9BD LD A,($96A3)  ; Fetch the number of rows of the old sprite from #R$96A3.
 $B9C0 CP C          ; Compare it with the number of rows that stand alone.
 $B9C1 JP C,$B9F4    ; Jump to #R$B9F4 if the old sprite has no more rows than that, so
                     ; that the sprites do not overlap and are each drawn in full.
 $B9C4 SUB C         ; Subtract the number of rows that stand alone.
 $B9C5 LD ($96A3),A  ; Write the number of rows that remain to #R$96A3.
 $B9C8 JP $B9DA      ; Jump to #R$B9DA to draw those rows of the old sprite on
                     ; their own.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9FCA }
; { #COOKIE$75CC }
; { #JETPAC$726A }
; { #PSSST$74EB }
; { #TRANZAM$7101 }
; { #TRANZAM$7108 }
; { #UNDERWURLDE$96F7 }
; LIST#

; Display Entity Moved Down
;
; Used by the routine at #R$B9A9.
; .
; Used by #R$B9A9 when the new sprite is lower than the old one. The
; bottom rows of the new sprite are drawn on their own first.
;
; A Old Y position minus the new Y position (negative)
@label=DisplayEntity_NewLower
c$B9CB EXX           ; Switch to the registers of the new sprite.
 $B9CC NEG           ; Make the difference positive.
 $B9CE LD C,A        ; Copy the number of rows that stand alone to #REGc.
 $B9CF LD A,($96A4)  ; Fetch the number of rows of the new sprite from #R$96A4.
 $B9D2 CP C          ; Compare it with the number of rows that stand alone.
 $B9D3 JP C,$B9F3    ; Jump to #R$B9F3 if the new sprite has no more rows than that, so
                     ; that the sprites do not overlap and are each drawn in full.
 $B9D6 SUB C         ; Subtract the number of rows that stand alone.
 $B9D7 JP $BA07      ; Jump to #R$BA07 to store the number of rows that remain and draw
                     ; those rows of the new sprite on their own.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9FEC }
; { #COOKIE$75EE }
; { #JETPAC$728C }
; { #PSSST$750D }
; { #TRANZAM$712A }
; { #UNDERWURLDE$9719 }
; LIST#

; XOR Sprite Loop
;
; Used by the routines at #R$B8F5, #R$B919 and #R$B9A9.
; .
; Draws the old sprite and the new sprite a row at a time, alternating
; between the two, until every row of both has been drawn. The set of registers
; that is current on entry belongs to the old sprite, which is drawn by
; #R$BA0D. The other set belongs to the new sprite, which is drawn by #R$BA8C.
; .
; In each set #REGhl is the screen address of the next row (the sprites are
; drawn from the bottom row upwards), #REGde points at the pixel data and #REGb
; is the page of the shift table. #REGc counts the rows that remain.
; .
; When both counts reach zero, the counts that are held in #R$96A3 (old sprite)
; and #R$96A4 (new sprite) are loaded and the whole process repeats. The
; routine returns when those are zero as well. This allows the rows that have
; no partner to be drawn first (see #R$B9A9).
;
; .
;
; Draw a row of the old sprite, if it has any rows left.
@label=XORSpriteLoop
c$B9DA LD A,C        ; Fetch the row count of the old sprite.
 $B9DB AND A         ; Set the flags.
 $B9DC JR Z,$B9EE    ; Jump to #R$B9EE if there are no rows left.
 $B9DE DEC C         ; Decrease the row count.
 $B9DF CALL $BA0D    ; Draw a row of the old sprite.
; Draw a row of the new sprite, if it has any rows left.
 $B9E2 EXX           ; Switch to the registers of the new sprite.
 $B9E3 LD A,C        ; Fetch the row count of the new sprite.
 $B9E4 AND A         ; Set the flags.
 $B9E5 JR Z,$B9EB    ; Jump to #R$B9EB if there are no rows left.
@label=XORSpriteLoop_NewRow
*$B9E7 DEC C         ; Decrease the row count.
 $B9E8 CALL $BA8C    ; Draw a row of the new sprite.
@label=XORSpriteLoop_OldRow
*$B9EB EXX           ; Switch to the registers of the old sprite.
 $B9EC JR $B9DA      ; Jump to #R$B9DA to draw the next pair of rows.
; The old sprite has no rows left, so draw the rest of the new sprite.
@label=XORSpriteLoop_NewOnly
*$B9EE EXX           ; Switch to the registers of the new sprite.
 $B9EF LD A,C        ; Fetch the row count of the new sprite.
 $B9F0 AND A         ; Set the flags.
 $B9F1 JR NZ,$B9E7   ; Jump to #R$B9E7 if there are rows left.
; This entry point is used by the routine at #R$B9CB.
@label=XORSpriteLoop_Done
*$B9F3 EXX           ; Switch to the registers of the old sprite.
; This entry point is used by the routine at #R$B9A9.
; .
; Both of the counts are zero. Load the row counts that were stored by the
; preparation routines and go round again, unless they are zero too.
@label=XORSpriteLoop_Reload
*$B9F4 LD A,($96A3)  ; Fetch the number of rows of the old sprite from #R$96A3.
 $B9F7 LD C,A        ; Copy the number of rows to #REGc.
 $B9F8 LD A,($96A4)  ; Fetch the number of rows of the new sprite from #R$96A4.
 $B9FB OR C          ; Combine it with the number of rows of the old sprite.
 $B9FC RET Z         ; Return if there are no rows left to draw.
 $B9FD XOR A         ; #REGa=#N$00.
 $B9FE LD ($96A3),A  ; Write #REGa to #R$96A3.
 $BA01 EXX           ; Switch to the registers of the new sprite.
 $BA02 LD A,($96A4)  ; Fetch the number of rows of the new sprite from #R$96A4.
 $BA05 LD C,A        ; Copy the number of rows to #REGc.
 $BA06 XOR A         ; #REGa=#N$00.
; This entry point is used by the routine at #R$B9CB.
@label=XORSpriteLoop_StoreNew
*$BA07 LD ($96A4),A  ; Write #REGa to #R$96A4.
 $BA0A EXX           ; Switch to the registers of the old sprite.
 $BA0B JR $B9DA      ; Jump to #R$B9DA to start drawing rows.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9E9B }
; { #COOKIE$763A }
; { #LUNARJETMAN$858E }
; { #UNDERWURLDE$9728 }
; LIST#

; Draw Old Entity Row
;
; Used by the routine at #R$B9DA.
; .
; Draws one row of the old sprite, using XOR, and moves up to the next
; row.
; .
; The row is drawn by unrolled code with one piece of #N$0C bytes for each byte
; of the row (up to eight bytes, with the last piece being longer so it can stop
; at the right of the screen). The operand of the jump at #R$BA12 is changed by
; #R$B939 so that the jump lands on the first piece that is needed. If the
; sprite is aligned to a character boundary the jump goes six bytes further in,
; which leaves out the first write.
;
;   B Page of the shift table
;   C Number of rows left
;   DE Pointer to the pixel data
;   HL Screen address of the row
; O:C Number of rows left
; O:DE Pointer to the next row of pixel data
; O:HL Screen address of the next row
@label=DrawOldEntityRow
c$BA0D LD A,C        ; Copy the row count to #REGa.
 $BA0E EX AF,AF'     ; Store the row count in #REGaf'.
 $BA0F LD A,(DE)     ; Fetch the first byte of the row.
 $BA10 LD C,A        ; Copy it to #REGc to use as the index into the shift
                     ; table.
 $BA11 PUSH HL       ; Stash the screen address on the stack.
*$BA12 JR $BA12      ; Jump into the unrolled code. The operand of this instruction is
                     ; changed by #R$B939.
@label=DrawOldEntityRow_Byte_1
 $BA14 LD A,(DE)     ; {Byte 1 of the row: look up the shifted byte for the left
 $BA15 LD C,A        ; cell and XOR it onto the screen.
 $BA16 LD A,(BC)     ;
 $BA17 XOR (HL)      ;
 $BA18 LD (HL),A     ;
 $BA19 INC L         ; }
@label=DrawOldEntityRow_Byte_1_Right
 $BA1A INC B         ; {Look up the shifted byte for the cell to the right and XOR it
 $BA1B LD A,(BC)     ; onto the screen, then move on to the next byte of pixel data.
 $BA1C XOR (HL)      ;
 $BA1D LD (HL),A     ;
 $BA1E DEC B         ;
 $BA1F INC DE        ; }
@label=DrawOldEntityRow_Byte_2
 $BA20 LD A,(DE)     ; {Byte 2 of the row: look up the shifted byte for the left
 $BA21 LD C,A        ; cell and XOR it onto the screen.
 $BA22 LD A,(BC)     ;
 $BA23 XOR (HL)      ;
 $BA24 LD (HL),A     ;
 $BA25 INC L         ; }
@label=DrawOldEntityRow_Byte_2_Right
 $BA26 INC B         ; {Look up the shifted byte for the cell to the right and XOR it
 $BA27 LD A,(BC)     ; onto the screen, then move on to the next byte of pixel data.
 $BA28 XOR (HL)      ;
 $BA29 LD (HL),A     ;
 $BA2A DEC B         ;
 $BA2B INC DE        ; }
@label=DrawOldEntityRow_Byte_3
 $BA2C LD A,(DE)     ; {Byte 3 of the row: look up the shifted byte for the left
 $BA2D LD C,A        ; cell and XOR it onto the screen.
 $BA2E LD A,(BC)     ;
 $BA2F XOR (HL)      ;
 $BA30 LD (HL),A     ;
 $BA31 INC L         ; }
@label=DrawOldEntityRow_Byte_3_Right
 $BA32 INC B         ; {Look up the shifted byte for the cell to the right and XOR it
 $BA33 LD A,(BC)     ; onto the screen, then move on to the next byte of pixel data.
 $BA34 XOR (HL)      ;
 $BA35 LD (HL),A     ;
 $BA36 DEC B         ;
 $BA37 INC DE        ; }
@label=DrawOldEntityRow_Byte_4
 $BA38 LD A,(DE)     ; {Byte 4 of the row: look up the shifted byte for the left
 $BA39 LD C,A        ; cell and XOR it onto the screen.
 $BA3A LD A,(BC)     ;
 $BA3B XOR (HL)      ;
 $BA3C LD (HL),A     ;
 $BA3D INC L         ; }
@label=DrawOldEntityRow_Byte_4_Right
 $BA3E INC B         ; {Look up the shifted byte for the cell to the right and XOR it
 $BA3F LD A,(BC)     ; onto the screen, then move on to the next byte of pixel data.
 $BA40 XOR (HL)      ;
 $BA41 LD (HL),A     ;
 $BA42 DEC B         ;
 $BA43 INC DE        ; }
@label=DrawOldEntityRow_Byte_5
 $BA44 LD A,(DE)     ; {Byte 5 of the row: look up the shifted byte for the left
 $BA45 LD C,A        ; cell and XOR it onto the screen.
 $BA46 LD A,(BC)     ;
 $BA47 XOR (HL)      ;
 $BA48 LD (HL),A     ;
 $BA49 INC L         ; }
@label=DrawOldEntityRow_Byte_5_Right
 $BA4A INC B         ; {Look up the shifted byte for the cell to the right and XOR it
 $BA4B LD A,(BC)     ; onto the screen, then move on to the next byte of pixel data.
 $BA4C XOR (HL)      ;
 $BA4D LD (HL),A     ;
 $BA4E DEC B         ;
 $BA4F INC DE        ; }
@label=DrawOldEntityRow_Byte_6
 $BA50 LD A,(DE)     ; {Byte 6 of the row: look up the shifted byte for the left
 $BA51 LD C,A        ; cell and XOR it onto the screen.
 $BA52 LD A,(BC)     ;
 $BA53 XOR (HL)      ;
 $BA54 LD (HL),A     ;
 $BA55 INC L         ; }
@label=DrawOldEntityRow_Byte_6_Right
 $BA56 INC B         ; {Look up the shifted byte for the cell to the right and XOR it
 $BA57 LD A,(BC)     ; onto the screen, then move on to the next byte of pixel data.
 $BA58 XOR (HL)      ;
 $BA59 LD (HL),A     ;
 $BA5A DEC B         ;
 $BA5B INC DE        ; }
@label=DrawOldEntityRow_Byte_7
 $BA5C LD A,(DE)     ; {Byte 7 of the row: look up the shifted byte for the left
 $BA5D LD C,A        ; cell and XOR it onto the screen.
 $BA5E LD A,(BC)     ;
 $BA5F XOR (HL)      ;
 $BA60 LD (HL),A     ;
 $BA61 INC L         ; }
@label=DrawOldEntityRow_Byte_7_Right
 $BA62 INC B         ; {Look up the shifted byte for the cell to the right and XOR it
 $BA63 LD A,(BC)     ; onto the screen, then move on to the next byte of pixel data.
 $BA64 XOR (HL)      ;
 $BA65 LD (HL),A     ;
 $BA66 DEC B         ;
 $BA67 INC DE        ; }
@label=DrawOldEntityRow_Byte_8
 $BA68 LD A,(DE)     ; {Byte 8 of the row: look up the shifted byte for the left cell
 $BA69 LD C,A        ; and XOR it onto the screen.
 $BA6A LD A,(BC)     ;
 $BA6B XOR (HL)      ;
 $BA6C LD (HL),A     ;
 $BA6D INC L         ; }
@label=DrawOldEntityRow_Byte_8_Right
 $BA6E LD A,L        ; #REGa=#REGl.
 $BA6F AND %00011111 ; Keep only bits 0-4.
 $BA71 JR Z,$BA78    ; Jump to #R$BA78 if the first cell was at the right of the
                     ; screen, as the second cell is then not written.
 $BA73 INC B         ; {Look up the shifted byte for the cell to the right and XOR it
 $BA74 LD A,(BC)     ; onto the screen.
 $BA75 XOR (HL)      ;
 $BA76 LD (HL),A     ;
 $BA77 DEC B         ; }
@label=DrawOldEntityRow_Byte_8_Next
*$BA78 INC DE        ; Move on to the next byte of pixel data.
 $BA79 EX AF,AF'     ; Fetch the row count from #REGaf'.
 $BA7A LD C,A        ; Copy the row count to #REGc.
 $BA7B POP HL        ; Restore the screen address from the stack.
 $BA7C DEC H         ; Move up one pixel line.
 $BA7D LD A,H        ; #REGa=#REGh.
 $BA7E CPL           ; Flip the bits.
 $BA7F AND %00000111 ; Keep only the pixel line bits (bits 0-2).
 $BA81 RET NZ        ; Return if the move up stayed inside the same character
                     ; cell.
 $BA82 LD A,L        ; {Subtract #N$20 from the low byte to move up to the previous
 $BA83 SUB $20       ; character row.
 $BA85 LD L,A        ; }
 $BA86 RET C         ; Return if the move up stayed inside the same third of
                     ; the screen.
 $BA87 LD A,H        ; {Add #N$08 to the high byte to move up to the previous third of the
 $BA88 ADD A,$08     ; screen.
 $BA8A LD H,A        ; }
 $BA8B RET           ; Return.
; View the equivalent code in;
; #LIST
; { #UNDERWURLDE$975B }
; LIST#

; Draw New Entity Row
;
; Used by the routine at #R$B9DA.
; .
; Draws one row of the new sprite, using XOR, and moves up to the next
; row. It is a copy of #R$BA0D that uses the jump at #R$BA91, which is changed
; by #R$B969.
;
;   B Page of the shift table
;   C Number of rows left
;   DE Pointer to the pixel data
;   HL Screen address of the row
; O:C Number of rows left
; O:DE Pointer to the next row of pixel data
; O:HL Screen address of the next row
@label=DrawNewEntityRow
c$BA8C LD A,C        ; Copy the row count to #REGa.
 $BA8D EX AF,AF'     ; Store the row count in #REGaf'.
 $BA8E LD A,(DE)     ; Fetch the first byte of the row.
 $BA8F LD C,A        ; Copy it to #REGc to use as the index into the shift
                     ; table.
 $BA90 PUSH HL       ; Stash the screen address on the stack.
*$BA91 JR $BA91      ; Jump into the unrolled code. The operand of this instruction is
                     ; changed by #R$B969.
@label=DrawNewEntityRow_Byte_1
 $BA93 LD A,(DE)     ; {Byte 1 of the row: look up the shifted byte for the left
 $BA94 LD C,A        ; cell and XOR it onto the screen.
 $BA95 LD A,(BC)     ;
 $BA96 XOR (HL)      ;
 $BA97 LD (HL),A     ;
 $BA98 INC L         ; }
@label=DrawNewEntityRow_Byte_1_Right
 $BA99 INC B         ; {Look up the shifted byte for the cell to the right and XOR it
 $BA9A LD A,(BC)     ; onto the screen, then move on to the next byte of pixel data.
 $BA9B XOR (HL)      ;
 $BA9C LD (HL),A     ;
 $BA9D DEC B         ;
 $BA9E INC DE        ; }
@label=DrawNewEntityRow_Byte_2
 $BA9F LD A,(DE)     ; {Byte 2 of the row: look up the shifted byte for the left
 $BAA0 LD C,A        ; cell and XOR it onto the screen.
 $BAA1 LD A,(BC)     ;
 $BAA2 XOR (HL)      ;
 $BAA3 LD (HL),A     ;
 $BAA4 INC L         ; }
@label=DrawNewEntityRow_Byte_2_Right
 $BAA5 INC B         ; {Look up the shifted byte for the cell to the right and XOR it
 $BAA6 LD A,(BC)     ; onto the screen, then move on to the next byte of pixel data.
 $BAA7 XOR (HL)      ;
 $BAA8 LD (HL),A     ;
 $BAA9 DEC B         ;
 $BAAA INC DE        ; }
@label=DrawNewEntityRow_Byte_3
 $BAAB LD A,(DE)     ; {Byte 3 of the row: look up the shifted byte for the left
 $BAAC LD C,A        ; cell and XOR it onto the screen.
 $BAAD LD A,(BC)     ;
 $BAAE XOR (HL)      ;
 $BAAF LD (HL),A     ;
 $BAB0 INC L         ; }
@label=DrawNewEntityRow_Byte_3_Right
 $BAB1 INC B         ; {Look up the shifted byte for the cell to the right and XOR it
 $BAB2 LD A,(BC)     ; onto the screen, then move on to the next byte of pixel data.
 $BAB3 XOR (HL)      ;
 $BAB4 LD (HL),A     ;
 $BAB5 DEC B         ;
 $BAB6 INC DE        ; }
@label=DrawNewEntityRow_Byte_4
 $BAB7 LD A,(DE)     ; {Byte 4 of the row: look up the shifted byte for the left
 $BAB8 LD C,A        ; cell and XOR it onto the screen.
 $BAB9 LD A,(BC)     ;
 $BABA XOR (HL)      ;
 $BABB LD (HL),A     ;
 $BABC INC L         ; }
@label=DrawNewEntityRow_Byte_4_Right
 $BABD INC B         ; {Look up the shifted byte for the cell to the right and XOR it
 $BABE LD A,(BC)     ; onto the screen, then move on to the next byte of pixel data.
 $BABF XOR (HL)      ;
 $BAC0 LD (HL),A     ;
 $BAC1 DEC B         ;
 $BAC2 INC DE        ; }
@label=DrawNewEntityRow_Byte_5
 $BAC3 LD A,(DE)     ; {Byte 5 of the row: look up the shifted byte for the left
 $BAC4 LD C,A        ; cell and XOR it onto the screen.
 $BAC5 LD A,(BC)     ;
 $BAC6 XOR (HL)      ;
 $BAC7 LD (HL),A     ;
 $BAC8 INC L         ; }
@label=DrawNewEntityRow_Byte_5_Right
 $BAC9 INC B         ; {Look up the shifted byte for the cell to the right and XOR it
 $BACA LD A,(BC)     ; onto the screen, then move on to the next byte of pixel data.
 $BACB XOR (HL)      ;
 $BACC LD (HL),A     ;
 $BACD DEC B         ;
 $BACE INC DE        ; }
@label=DrawNewEntityRow_Byte_6
 $BACF LD A,(DE)     ; {Byte 6 of the row: look up the shifted byte for the left
 $BAD0 LD C,A        ; cell and XOR it onto the screen.
 $BAD1 LD A,(BC)     ;
 $BAD2 XOR (HL)      ;
 $BAD3 LD (HL),A     ;
 $BAD4 INC L         ; }
@label=DrawNewEntityRow_Byte_6_Right
 $BAD5 INC B         ; {Look up the shifted byte for the cell to the right and XOR it
 $BAD6 LD A,(BC)     ; onto the screen, then move on to the next byte of pixel data.
 $BAD7 XOR (HL)      ;
 $BAD8 LD (HL),A     ;
 $BAD9 DEC B         ;
 $BADA INC DE        ; }
@label=DrawNewEntityRow_Byte_7
 $BADB LD A,(DE)     ; {Byte 7 of the row: look up the shifted byte for the left
 $BADC LD C,A        ; cell and XOR it onto the screen.
 $BADD LD A,(BC)     ;
 $BADE XOR (HL)      ;
 $BADF LD (HL),A     ;
 $BAE0 INC L         ; }
@label=DrawNewEntityRow_Byte_7_Right
 $BAE1 INC B         ; {Look up the shifted byte for the cell to the right and XOR it
 $BAE2 LD A,(BC)     ; onto the screen, then move on to the next byte of pixel data.
 $BAE3 XOR (HL)      ;
 $BAE4 LD (HL),A     ;
 $BAE5 DEC B         ;
 $BAE6 INC DE        ; }
@label=DrawNewEntityRow_Byte_8
 $BAE7 LD A,(DE)     ; {Byte 8 of the row: look up the shifted byte for the left cell
 $BAE8 LD C,A        ; and XOR it onto the screen.
 $BAE9 LD A,(BC)     ;
 $BAEA XOR (HL)      ;
 $BAEB LD (HL),A     ;
 $BAEC INC L         ; }
@label=DrawNewEntityRow_Byte_8_Right
 $BAED LD A,L        ; #REGa=#REGl.
 $BAEE AND %00011111 ; Keep only bits 0-4.
 $BAF0 JR Z,$BAF7    ; Jump to #R$BAF7 if the first cell was at the right of the
                     ; screen, as the second cell is then not written.
 $BAF2 INC B         ; {Look up the shifted byte for the cell to the right and XOR it
 $BAF3 LD A,(BC)     ; onto the screen.
 $BAF4 XOR (HL)      ;
 $BAF5 LD (HL),A     ;
 $BAF6 DEC B         ; }
@label=DrawNewEntityRow_Byte_8_Next
*$BAF7 INC DE        ; Move on to the next byte of pixel data.
 $BAF8 EX AF,AF'     ; Fetch the row count from #REGaf'.
 $BAF9 LD C,A        ; Copy the row count to #REGc.
 $BAFA POP HL        ; Restore the screen address from the stack.
 $BAFB DEC H         ; Move up one pixel line.
 $BAFC LD A,H        ; #REGa=#REGh.
 $BAFD CPL           ; Flip the bits.
 $BAFE AND %00000111 ; Keep only the pixel line bits (bits 0-2).
 $BB00 RET NZ        ; Return if the move up stayed inside the same character
                     ; cell.
 $BB01 LD A,L        ; {Subtract #N$20 from the low byte to move up to the previous
 $BB02 SUB $20       ; character row.
 $BB04 LD L,A        ; }
 $BB05 RET C         ; Return if the move up stayed inside the same third of
                     ; the screen.
 $BB06 LD A,H        ; {Add #N$08 to the high byte to move up to the previous third of the
 $BB07 ADD A,$08     ; screen.
 $BB09 LD H,A        ; }
 $BB0A RET           ; Return.
; View the equivalent code in;
; #LIST
; { #UNDERWURLDE$97E1 }
; LIST#

; Store Entity
;
; Used by the routines at #R$9D91, #R$9E72, #R$9EB3, #R$9F16, #R$A3C5, #R$A3E0,
; #R$A42A, #R$A4D7, #R$A54F, #R$A61B, #R$A680, #R$A858, #R$A8F5, #R$A964,
; #R$A9BE, #R$AA0D, #R$AB74, #R$AD07, #R$ADD0, #R$AEEF and #R$B12F.
; .
; Saves the position, the sprite ID and the room of an actor, so that the
; sprite can be erased from its old position later (see #R$B9A9 and #R$B8F5).
; The values are saved in #R$96A0 (X), #R$96A1 (Y), #R$969F (sprite ID) and
; #R$96A2 (room).
;
; IX Actor Entity
@label=StoreEntity
c$BB0B LD A,(IX+$03) ; {Copy the X position of the actor to #R$96A0.
 $BB0E LD ($96A0),A  ; }
 $BB11 LD A,(IX+$04) ; {Copy the Y position of the actor to #R$96A1.
 $BB14 LD ($96A1),A  ; }
 $BB17 LD A,(IX+$00) ; {Copy the sprite ID of the actor to #R$969F.
 $BB1A LD ($969F),A  ; }
 $BB1D LD A,(IX+$01) ; {Copy the room of the actor to #R$96A2.
 $BB20 LD ($96A2),A  ; }
 $BB23 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9FFB }
; { #COOKIE$76D0 }
; { #JETPAC$7327 }
; { #PSSST$75B9 }
; { #TRANZAM$71ED }
; { #UNDERWURLDE$989F }
; LIST#

; Colour Entity
;
; Used by the routines at #R$A31A, #R$AD5D, #R$AD63 and #R$AEEF.
; .
; Colours the attribute cells covered by the sprite that has just been
; drawn with #R$B919 using the colour held in byte #N$05 of the actor. Only
; cells with a black paper are changed (see #R$BB45), so the colour of anything
; already drawn behind the sprite is kept.
;
; IX Actor Entity
@label=ColourEntity
c$BB24 LD L,(IX+$03) ; Fetch the X position of the actor.
 $BB27 LD H,(IX+$04) ; Fetch the Y position of the actor.
 $BB2A LD D,(IX+$05) ; Fetch the colour of the actor.
 $BB2D LD A,($96A6)  ; {Fetch the number of columns the sprite covers from #R$96A6 into
 $BB30 LD B,A        ; #REGb.}
 $BB31 LD A,H        ; {Invert the Y position.
 $BB32 CPL           ; }
 $BB33 AND %00000111 ; Keep only bits 0-2.
 $BB35 LD C,A        ; Stash the pixel line offset in #REGc.
 $BB36 LD A,($96A5)  ; Fetch the height of the sprite from #R$96A5.
 $BB39 ADD A,C       ; Add the pixel line offset.
 $BB3A ADD A,$08     ; Add #N$08.
 $BB3C RRCA          ; {Divide by eight to get the number of attribute rows.
 $BB3D RRCA          ;
 $BB3E RRCA          ; }
 $BB3F AND %00011111 ; Keep only bits 0-4.
 $BB41 LD C,A        ; Set the number of rows to colour in #REGc.
 $BB42 CALL $B8DD    ; Convert the position into an attribute address.
; View the equivalent code in;
; #LIST
; { #UNDERWURLDE$9867 }
; LIST#
; .
; Continue on to #R$BB45.

; Colour Rows
;
; Used by the routine at #R$A680.
; .
; Colours #REGc rows of #REGb attribute cells, working upwards from the
; attribute address in #REGhl. A cell is only changed if its paper is black.
;
; B The number of columns
; C The number of rows
; D The attribute value to write
; HL The attribute buffer address of the bottom-left cell
@label=ColourRows
c$BB45 PUSH BC       ; {Stash the counters and the start of the row on the
 $BB46 PUSH HL       ; stack.}
@label=ColourRows_Loop
*$BB47 LD A,(HL)     ; Fetch the attribute.
 $BB48 AND %00111000 ; Keep only bits 3-5 (the paper).
 $BB4A JR NZ,$BB4D   ; Jump to #R$BB4D if the paper is not black.
 $BB4C LD (HL),D     ; Colour the cell with the colour of the actor.
@label=ColourRows_Next
*$BB4D INC L         ; Move on to the next column.
 $BB4E DJNZ $BB47    ; Decrease the column counter by one and loop back to #R$BB47 until
                     ; all of the columns have been coloured.
 $BB50 POP HL        ; Restore the start of the row from the stack.
 $BB51 LD BC,$0020   ; #REGbc=#N($0020,$04,$04).
 $BB54 AND A         ; Reset the carry flag.
 $BB55 SBC HL,BC     ; Move up one row of attributes.
 $BB57 POP BC        ; Restore the counters from the stack.
 $BB58 DEC C         ; {Decrease the row counter by one and loop back to #R$BB45 until all
 $BB59 JR NZ,$BB45   ; of the rows have been coloured.}
 $BB5B RET           ; Return.
; View the equivalent code in;
; #LIST
; { #UNDERWURLDE$9888 }
; LIST#

; Clear Play Area
;
; Used by the routines at #R$9F6A, #R$A207, #R$A234, #R$AA6A, #R$B12F, #R$B1D4,
; #R$B205 and #R$B3D5.
; .
; Clears the top third of the screen, but only from below the banner. The
; banner is left untouched.
;
; .
;
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$9960,stop=$998F,clear=1,sp=$5B40)
; #SIM(start=$99A7,stop=$99AA,sp=$5B40)
; #SCR$01(clear-before)
; | #SIM(start=$BB5C,stop=$0000,sp=$5B40)
; #SCR$01(clear-after) } UDGTABLE# #POPS
@label=ClearPlayArea
c$BB5C LD HL,$4040   ; #REGhl=#N$4040(screen buffer).
; Here #REGd contains the value to be written (#N$00) and #REGe holds the number of rows of pixels to act on
;       (the full height of a character block).
 $BB5F LD DE,$0008   ; #REGde=#N($0008,$04,$04).
; #REGb holds the number of columns (i.e. #N$20 == full width of the screen), and #REGc is a
;       counter for how many rows to clear (i.e. the top third would usually be #N$08 rows, but the banner takes up
;       two - hence this initialises to #N$06).
 $BB62 LD BC,$2006   ; #REGbc=#N$2006.
@label=ClearPlayArea_ClearLine
*$BB65 PUSH BC       ; {Stash #REGbc and #REGhl on the stack.
 $BB66 PUSH HL       ; }
@label=ClearPlayArea_ClearLine_Start
*$BB67 PUSH BC       ; Stash #REGbc on the stack.
@label=ClearPlayArea_ClearLine_Loop
*$BB68 LD (HL),D     ; Write #N$00 (#REGd) to the screen (#REGhl).
 $BB69 INC L         ; Move "right" onto the next column.
 $BB6A DJNZ $BB68    ; Decrease the width counter by one and loop back to
                     ; #R$BB68 until counter is zero.
; Resets the width counter ready for the next loop.
 $BB6C POP BC        ; Restore #REGbc from the stack.
 $BB6D DEC C         ; Decrease the number of rows counter by one.
 $BB6E JR NZ,$BB67   ; Jump back to #R$BB67 unless #REGc is zero.
; Resets the screen buffer to where the clearing started for this loop, then
; moves down one character block.
 $BB70 POP HL        ; Restore #REGhl from the stack.
 $BB71 INC H         ; Increments #REGh by one.
 $BB72 POP BC        ; Restore #REGbc from the stack.
 $BB73 DEC E         ; Decrease the pixel row counter by one.
 $BB74 JR NZ,$BB65   ; Jump back to #R$BB65 unless #REGe is zero.
; Clears the other two thirds of the screen, so now the screen only contains
; the banner.
 $BB76 LD HL,$4800   ; #REGhl=#N$4800(screen buffer).
 $BB79 JP $BB84      ; Jump to #R$BB84.

; Clear Play Area Attribute Buffer
;
; Used by the routines at #R$9F6A, #R$A207, #R$A234, #R$AA6A, #R$B12F, #R$B1D4,
; #R$B205 and #R$B3D5.
; .
; Sets the attributes of the play area to #N$40, which is everything
; except the two rows at the top of the screen that hold the banner.
@label=ClearPlayArea_Attributes
c$BB7C LD HL,$5840   ; #REGhl=#N$5840(attribute buffer).
 $BB7F JR $BB92      ; Jump to #R$BB92.

; Reset Screen Buffer
;
; Used by the routine at #R$9960.
@label=ResetScreen
c$BB81 LD HL,$4000   ; #REGhl=#R$4000(screen buffer).
; This entry point is used by the routine at #R$BB5C.
@label=ResetScreen_FromAddress
*$BB84 LD B,$58      ; #REGb=#N$58 (i.e. finish once we reach the start of
                     ; #R$5800(attribute buffer)).
 $BB86 LD C,$00      ; #REGc=#N$00 (value to write).
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CE60 }
; { #ATICATAC$80B4 }
; { #COOKIE$74D4 }
; { #CYBERUN$9A7E }
; { #GUNFRIGHT$D6DB }
; { #JETPAC$71B8 }
; { #KNIGHTLORE$D544 }
; { #LUNARJETMAN$84AD }
; { #NIGHTSHADE$E5A8 }
; { #PSSST$7439 }
; { #TRANZAM$7211 }
; LIST#
; .
; Continue on to #R$BB88 to blank the screen buffer.

; Fill Memory
;
; Used by the routine at #R$BB8F.
;
; HL Target address
; B Single byte representing the MSB of the end address (will always end on LSB
; . #N$00)
; C Value to write
@label=ResetCopier
c$BB88 LD (HL),C     ; Write #REGc to the target address.
 $BB89 INC HL        ; Increment the target address by one.
 $BB8A LD A,H        ; {Are we finished yet? Check the MSB of the target vs.
 $BB8B CP B          ; #REGb.}
 $BB8C JR NZ,$BB88   ; Keep looping back to #R$BB88 until there is no
                     ; carry-over.
 $BB8E RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$80BB }
; { #COOKIE$74DB }
; { #JETPAC$71BF }
; { #LUNARJETMAN$84B4 }
; { #PSSST$7440 }
; { #TRANZAM$7218 }
; LIST#

; Reset Attribute Buffer
;
; Used by the routine at #R$9960.
@label=ResetAttributes
c$BB8F LD HL,$5800   ; #REGhl=#R$5800(attribute buffer).
; This entry point is used by the routine at #R$BB7C.
@label=ResetAttributes_FromAddress
*$BB92 LD B,$5B      ; Set the end of the attribute buffer in #REGb to #N$5B.
 $BB94 LD C,$40      ; Set the value to write in #REGc to #N$40.
 $BB96 JR $BB88      ; Jump to #R$BB88.
; View the equivalent code in;
; #LIST
; { #ATICATAC$80C2 }
; { #JETPAC$71C6 }
; { #LUNARJETMAN$84BB }
; { #PSSST$7447 }
; { #TRANZAM$7200 }
; LIST#

; Add Accumulator To Address
;
; This code is not used. Adds #REGa to #REGhl.
;
;   A Number to add
;   HL Address
; O:HL The address plus the number
u$BB98 DEFB $85      ; #REGa=#REGa+#REGl.
 $BB99 DEFB $6F      ; #REGl=#REGa.
 $BB9A DEFB $7C      ; #REGa=#REGh.
 $BB9B DEFB $CE,$00  ; Add the carry to #REGa.
 $BB9D DEFB $67      ; #REGh=#REGa.
 $BB9E DEFB $C9      ; Return.

; Clear Buffers
;
; Used by the routine at #R$9960.
;
; .
;
; Writes #N$00 to every address from #R$9692 to #R$995A.
@label=ClearBuffers
c$BB9F LD HL,$9692   ; Point #REGhl at the first game variable at #R$9692.
 $BBA2 LD BC,$02C8   ; Set the number of bytes to clear in #REGbc to #N$02C8.
; This entry point is used by the routine at #R$9960.
@label=ClearBuffers_Loop
*$BBA5 LD (HL),$00   ; Clear a byte of the game variables.
 $BBA7 INC HL        ; Move onto the next byte.
 $BBA8 DEC BC        ; Decrease the byte counter by one.
 $BBA9 LD A,B        ; {Loop back to #R$BBA5 until all of the bytes have been
 $BBAA OR C          ; cleared.
 $BBAB JR NZ,$BBA5   ; }
 $BBAD RET           ; Return.

; Draw Room Contents
;
; Used by the routine at #R$BBDD.
; .
; Calls the routines which set up the contents of the room (#R$A79F,
; #R$A763 and #R$A33B) and then draws every actor in the room with #R$BBBB.
@label=DrawRoomContents
c$BBAE CALL $A79F    ; Save the orchid of the room.
 $BBB1 CALL $A763    ; Load the orchid of the room.
 $BBB4 CALL $A33B    ; Set up the objects in the room.
 $BBB7 CALL $BBBB    ; Draw the actors in the room.
 $BBBA RET           ; Return.

; Draw Room Actors
;
; Used by the routine at #R$BBAE.
; .
; Works through the actor table from #R$970E and draws (with #R$B919)
; every actor whose room (byte #N$01) is the same as the room the player is
; in (#R$9703).
@label=DrawRoomActors
c$BBBB PUSH IX       ; Stash the actor record pointer on the stack.
 $BBBD LD IX,$970E   ; Point #REGix at the first actor after the player at
                     ; #R$970E.
; Draw the actor if it is in the same room as the player.
@label=DrawRoomActors_Loop
*$BBC1 LD A,($9703)  ; Fetch the room of the player from #R$9703.
 $BBC4 CP (IX+$01)   ; {Draw the actor if it is in the room of the player.
 $BBC7 CALL Z,$B919  ; }
; Move on to the next actor, until the end of the actor table is reached.
 $BBCA LD DE,$000C   ; Set the size of an actor record in #REGde to #N$000C.
 $BBCD ADD IX,DE     ; Move onto the next actor.
 $BBCF PUSH IX       ; {Copy the pointer to the actor into #REGhl.
 $BBD1 POP HL        ; }
 $BBD2 LD DE,$982E   ; Point #REGde at the end of the actor table at #R$982E.
 $BBD5 AND A         ; {Subtract the end of the actor table from the pointer to
 $BBD6 SBC HL,DE     ; the actor.}
 $BBD8 JR C,$BBC1    ; Jump to #R$BBC1 if there are more actors to draw.
 $BBDA POP IX        ; Restore the actor record pointer from the stack.
 $BBDC RET           ; Return.

; Draw Current Room
;
; Used by the routines at #R$A234, #R$B12F and #R$B1D4.
; .
; Looks up the room data for the room the actor is in, using the layout
; table at #R$6066 to find the room in the room table at #R$6166, draws the
; room with #R$BBF7 and then carries on to #R$BBAE to draw its contents.
;
; IX Actor Entity
@label=DrawCurrentRoom
c$BBDD LD L,(IX+$01) ; Fetch the room of the actor.
 $BBE0 LD H,$00      ; Clear #REGh.
 $BBE2 LD BC,$6066   ; Point #REGbc at the table of room layouts at #R$6066.
 $BBE5 ADD HL,BC     ; Add the table to the room to find the layout number of
                     ; the room.
 $BBE6 LD L,(HL)     ; Fetch the layout number of the room.
 $BBE7 LD H,$00      ; Clear #REGh.
 $BBE9 ADD HL,HL     ; Double the layout number (each pointer to room data is a
                     ; word).
 $BBEA LD BC,$6166   ; Point #REGbc at the table of pointers to room data at
                     ; #R$6166.
 $BBED ADD HL,BC     ; Add the table to find the pointer to the room data.
 $BBEE LD A,(HL)     ; Fetch the low byte of the address of the room data.
 $BBEF INC HL        ; Move onto the high byte.
 $BBF0 LD H,(HL)     ; Fetch the high byte of the address of the room data.
 $BBF1 LD L,A        ; Combine the low byte with the high byte.
 $BBF2 CALL $BBF7    ; Draw the room.
 $BBF5 JR $BBAE      ; Jump to #R$BBAE to set up the contents of the room.

; Draw Room
;
; Used by the routines at #R$9F6A, #R$B3D5, #R$B61E and #R$BBDD.
; .
; Draws the graphics of a room. The room data is a list of graphics, each
; with the address of the graphic and the position to draw it at. Each graphic
; is drawn with #R$BC0B.
;
; HL The Room Data memory address (e.g. #R$61C6, #R$6200)
;
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$9960,stop=$998F,clear=1,sp=$5B40)
; #SIM(start=$AC6B,stop=$AC76,sp=$5B40)
; #SCR$01(room-before)
; | #SIM(start=$BBDD,stop=$BBF5,ix=$9702,sp=$5B40)
; #SCR$01(room-after) } UDGTABLE# #POPS
; .
; The room data is held as: #TABLE(default,centre)
; { =h Byte | =h Type }
; { #N$01 | =r2 Room Graphic Data Address }
; { #N$02 }
; { #N$03 | X Position }
; { #N$04 | Y Position }
; TABLE#
; And is terminated when #N($0000, $04, $04) is reached.
; .
; Fetch the room data graphic address.
@label=DrawRoom
c$BBF7 LD E,(HL)     ; {Fetch the address of the graphic.
 $BBF8 INC HL        ;
 $BBF9 LD D,(HL)     ; }
 $BBFA LD A,E        ; {Return if the end of the room data has been reached (the address is
 $BBFB OR D          ; zero).
 $BBFC RET Z         ; }
; Fetch the X/ Y position data.
 $BBFD INC HL        ; Move onto the X position of the graphic.
 $BBFE LD C,(HL)     ; {Fetch the X position into #REGc and the Y position into
 $BBFF INC HL        ; #REGb.
 $BC00 LD B,(HL)     ; }
 $BC01 INC HL        ; Move onto the next graphic in the room data.
 $BC02 PUSH HL       ; Stash the pointer to the room data on the stack.
 $BC03 LD H,B        ; {Copy the position into #REGhl.
 $BC04 LD L,C        ; }
 $BC05 CALL $BC0B    ; Draw the graphic.
 $BC08 POP HL        ; Restore the pointer to the room data from the stack.
 $BC09 JR $BBF7      ; Jump back to #R$BBF7 to draw the next graphic.
; This entry point is used by the routine at #R$A207.
; .
; At the point of processing; #REGhl contains X/ Y position data, #REGde
; contains the room data graphic address (and #REGbc is throwaway).
@label=DrawRoom_Process
*$BC0B PUSH HL       ; Stash the position of the graphic on the stack.
 $BC0C CALL $B8AD    ; Convert the position into a screen address.
 $BC0F LD A,(DE)     ; {Fetch the height of the graphic into #REGc.
 $BC10 LD C,A        ; }
 $BC11 INC DE        ; Increment #REGde by one.
 $BC12 LD A,(DE)     ; {Fetch the width of the graphic into #REGb.
 $BC13 LD B,A        ; }
 $BC14 INC DE        ; Increment #REGde by one.
@label=DrawRoom_Row_Loop
*$BC15 PUSH BC       ; Stash the counters on the stack.
@label=DrawRoom_Write_Row
*$BC16 LD A,(DE)     ; Fetch a byte of the graphic.
 $BC17 CPL           ; Invert the bits.
 $BC18 LD (HL),A     ; Draw the byte on the screen.
 $BC19 INC L         ; Move onto the next column.
 $BC1A INC DE        ; Move onto the next byte of the graphic.
 $BC1B DJNZ $BC16    ; Decrease the width counter by one and loop back to
                     ; #R$BC16 until counter is zero.
 $BC1D POP BC        ; Restore the counters from the stack.
 $BC1E LD A,L        ; {Move back to the first column.
 $BC1F SUB B         ;
 $BC20 LD L,A        ; }
 $BC21 CALL $B8CC    ; Move down to the next pixel line.
 $BC24 DEC C         ; {Decrease the height counter by one and loop back to
 $BC25 JR NZ,$BC15   ; #R$BC15 until counter is zero.}
 $BC27 POP HL        ; Restore the position of the graphic from the stack.
 $BC28 CALL $B8DD    ; Convert the position into an attribute address.
; Now set the attributes.
 $BC2B LD A,(DE)     ; {Fetch the height of the attribute data into #REGc.
 $BC2C INC DE        ;
 $BC2D LD C,A        ; }
 $BC2E LD A,(DE)     ; {Fetch the width of the attribute data into #REGb.
 $BC2F INC DE        ;
 $BC30 LD B,A        ; }
 $BC31 LD A,($96B2)  ; {Jump to #R$BC49 if #R$96B2 is not zero, to use the second set of
 $BC34 AND A         ; attributes.
 $BC35 JR NZ,$BC49   ; }
@label=DrawRoom_Attribute_Row_Loop
*$BC37 PUSH BC       ; Stash the counters on the stack.
 $BC38 PUSH HL       ; Stash the start of the row on the stack.
@label=DrawRoom_Attribute_Loop
*$BC39 LD A,(DE)     ; Fetch an attribute.
 $BC3A INC DE        ; Move onto the next attribute.
 $BC3B LD (HL),A     ; Set the attribute on the screen.
 $BC3C INC L         ; Move onto the next column.
 $BC3D DJNZ $BC39    ; Decrease the width counter by one and loop back to #R$BC39 until
                     ; counter is zero.
 $BC3F POP HL        ; Restore the start of the row from the stack.
 $BC40 LD BC,$0020   ; #REGbc=#N($0020,$04,$04).
 $BC43 ADD HL,BC     ; Move down one row of attributes.
 $BC44 POP BC        ; Restore the counters from the stack.
 $BC45 DEC C         ; {Decrease the row counter by one and loop back to #R$BC37 until all
 $BC46 JR NZ,$BC37   ; of the rows of attributes have been set.}
 $BC48 RET           ; Return.
; Use the second set of attributes, by skipping over the first set.
@label=DrawRoom_Second_Attributes
*$BC49 PUSH BC       ; Stash the counters on the stack.
 $BC4A XOR A         ; Start the total at zero.
 $BC4B LD ($96B2),A  ; Clear #R$96B2, so the first set of attributes is used
                     ; next time.
@label=DrawRoom_Skip_Attributes
*$BC4E ADD A,C       ; Add the height to #REGa, once for each column, to find the size of
                     ; the first set.
 $BC4F DJNZ $BC4E    ; Decrease #REGb by one and loop back to #R$BC4E until it
                     ; is zero.
 $BC51 LD C,A        ; #REGc=#REGa.
 $BC52 LD B,$00      ; #REGb=#N$00.
 $BC54 EX DE,HL      ; Swap #REGde and #REGhl.
 $BC55 ADD HL,BC     ; Move the attribute data pointer past the first set.
 $BC56 EX DE,HL      ; Swap #REGde and #REGhl back.
 $BC57 POP BC        ; Restore the counters from the stack.
 $BC58 JR $BC37      ; Jump to #R$BC37.

; Multiply A By DE
;
; This code is not used. Multiplies #REGa by #REGde.
;
;   A Number to multiply by
;   DE Number to multiply
; O:HL The result
@label=MultiplyAByDE
u$BC5A DEFB $21,$00,$00 ; #REGhl=#N($0000,$04,$04).
 $BC5D DEFB $06,$08     ; #REGb=#N$08 (the number of bits).
 $BC5F DEFB $29         ; Double the result.
 $BC60 DEFB $07         ; Rotate the next bit of #REGa into the carry flag.
 $BC61 DEFB $30,$01     ; Jump to #R$BC64 if the bit is not set.
 $BC63 DEFB $19         ; Add #REGde to the result.
 $BC64 DEFB $10,$F9     ; Decrease the bit counter by one and loop back to #R$BC5F until it is
                        ; zero.
 $BC66 DEFB $C9         ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9AAD }
; { #TRANZAM$6F2F }
; { #UNDERWURLDE$AC68 }
; LIST#

; Music Data
;
; Each byte of music data is a note and the data is terminated by #N$FF.
; Bits 0-5 select the note from the table at #R$BDD2 (zero is a rest) and bits
; 6-7 hold the length of the note minus one (so a note lasts for between one and
; four units). See #R$BD7B.
; .
; This is the main tune, played when the game is completed and on the game
; selection screen. #HTML(#AUDIO0(main-tune.wav)(#INCLUDE(MainTune)))
@label=MusicData_GameComplete
b$BC67 DEFB $19,$1D,$20,$25,$29,$20,$25,$29,$19,$1D,$20,$25,$29,$25,$20,$1D
@label=MusicData_GameComplete_Loop
 $BC77 DEFB $1B,$1E,$22,$27,$2A,$22,$27,$2A,$1B,$1E,$22,$27,$2A,$27,$22,$1E
 $BC87 DEFB $18,$1B,$20,$24,$27,$20,$24,$27,$18,$1B,$20,$24,$27,$24,$20,$1B
 $BC97 DEFB $19,$1D,$20,$25,$29,$20,$25,$29,$19,$1D,$20,$25,$29,$25,$20,$1D
 $BCA7 DEFB $19,$1D,$22,$29,$2E,$22,$29,$2E,$19,$1D,$22,$29,$2E,$29,$22,$1D
 $BCB7 DEFB $19,$1B,$1F,$22,$27,$1F,$22,$27,$19,$1B,$1F,$22,$27,$22,$1F,$1B
 $BCC7 DEFB $1B,$20,$24,$27,$2C,$24,$27,$2C,$1B,$20,$24,$27,$2C,$27,$24,$20
 $BCD7 DEFB $18,$19,$1D,$20,$25,$1D,$20,$25,$18,$19,$1D,$20,$25,$20,$1D,$19
 $BCE7 DEFB $16,$19,$1D,$20,$25,$1D,$20,$25,$16,$19,$1D,$20,$25,$20,$1D,$19
 $BCF7 DEFB $13,$16,$1B,$1F,$25,$1B,$1F,$25,$13,$16,$1B,$1F,$25,$1F,$1B,$16
 $BD07 DEFB $14,$18,$1B,$20,$24,$1B,$20,$24,$14,$18,$1B,$20,$24,$20,$1B,$18
 $BD17 DEFB $19,$1D,$20,$25,$29,$20,$25,$29,$19,$1D,$20,$25,$29,$25,$20,$1D
 $BD27 DEFB $FF
; This is the tune played when the game is over.
; #HTML(#AUDIO0(game-over-tune.wav)(#INCLUDE(GameOverTune)))
@label=MusicData_GameOver
 $BD28 DEFB $18,$21,$1D,$17,$20,$1D,$16,$1F,$1C,$1D,$FF
; This is the tune played with the poems.
; #HTML(#AUDIO0(poem-tune.wav)(#INCLUDE(PoemTune)))
@label=MusicData_Poem
 $BD33 DEFB $67,$69,$6A,$6C,$6A,$69,$67,$65,$27
 $BD3C DEFB $29,$27,$29,$27,$29,$27,$29,$A7,$FF
; This is the tune played when a new game is started.
; #HTML(#AUDIO0(start-up-tune.wav)(#INCLUDE(StartUpTune)))
@label=MusicData_GameInitialisation
 $BD45 DEFB $59,$14,$17,$59,$14,$17
 $BD4B DEFB $19,$1C,$14,$1C,$99,$FF

; Play Music Until Key Pressed
;
; Used by the routine at #R$B3D5.
; .
; Plays a tune in the same way as #R$BD6E, but stops as soon as any key
; is pressed. The key press is then handled by the game selection menu (see
; #R$B3D5), as if it had been read there.
; .
; #HTML(#AUDIO0(main-tune.wav)(#INCLUDE(MainTune)))
;
; DE Music data terminated by #N$FF
@label=PlayMusic_WaitKey
c$BD51 DI            ; Disable interrupts.
; Check for any key being pressed.
@label=PlayMusic_WaitKey_Loop
*$BD52 XOR A         ; Select every row of the keyboard.
 $BD53 OUT ($FD),A   ; Write #REGa to port #N$FD (this has no effect).
 $BD55 IN A,($FE)    ; Read every half-row of the keyboard at once (the high byte of the
                     ; port number is zero).
 $BD57 CPL           ; Flip the bits.
 $BD58 AND %00011111 ; Keep only bits 0-4.
 $BD5A JR Z,$BD64    ; Jump to #R$BD64 if no keys were pressed.
; A key was pressed, so stop playing and hand over to the game menu.
 $BD5C LD A,($9692)  ; Fetch the game options from #R$9692.
 $BD5F INC SP        ; {Discard the return address.
 $BD60 INC SP        ; }
 $BD61 JP $B422      ; Jump to #R$B422 to handle the key press in the game
                     ; selection menu.
; This is identical to #R$BD6E except it also handles exiting on a keypress.
@label=PlayMusic_WaitKey_Process
*$BD64 LD A,(DE)     ; Fetch the next note.
 $BD65 CP $FF        ; {Jump to #R$BD79 if the end of the tune has been reached
 $BD67 JR Z,$BD79    ; (#N$FF).}
 $BD69 CALL $BD7B    ; Play the note.
 $BD6C JR $BD52      ; Jump to #R$BD52 to check for a key press.

; Play Music
;
; Used by the routines at #R$9960, #R$9F6A, #R$A234 and #R$AA6A.
; .
; Plays a tune, one note at a time with #R$BD7B, until the #N$FF
; terminator is found. Interrupts are disabled while the tune plays.
; .
; The tunes played by this routine are:
; #TABLE(default,centre,centre)
; { =h Tune | =h Sound }
; { Start-up Tune
; | #HTML(#AUDIO0(start-up-tune.wav)(#INCLUDE(StartUpTune))) }
; { Main Tune
; | #HTML(#AUDIO0(main-tune.wav)(#INCLUDE(MainTune))) }
; { Poem Tune
; | #HTML(#AUDIO0(poem-tune.wav)(#INCLUDE(PoemTune))) }
; { Game Over Tune
; | #HTML(#AUDIO0(game-over-tune.wav)(#INCLUDE(GameOverTune))) }
; TABLE#
;
; DE Music data terminated by #N$FF
@label=PlayMusic
c$BD6E DI            ; Disable interrupts.
@label=PlayMusic_Loop
*$BD6F LD A,(DE)     ; Fetch the next note.
 $BD70 CP $FF        ; {Jump to #R$BD79 if the end of the tune has been reached
 $BD72 JR Z,$BD79    ; (#N$FF).}
 $BD74 CALL $BD7B    ; Play the note.
 $BD77 JR $BD6F      ; Jump to #R$BD6F for the next note.
; View the equivalent code in;
; #LIST
; { #COOKIE$6568 }
; { #KNIGHTLORE$B2CF }
; { #MARTIANOIDS$C0CF }
; LIST#

; Finish Playing Music
;
; Used by the routines at #R$BD51 and #R$BD6E.
; .
; Enables interrupts again once a tune has finished.
@label=PlayMusic_Return
c$BD79 EI            ; Enable interrupts.
 $BD7A RET           ; Return.

; Play Note
;
; Used by the routines at #R$BD51 and #R$BD6E.
; .
; Plays a single note, or a rest if the note is zero. A note is looked up
; in the table at #R$BDD2, which has four bytes per note: two bytes which set
; the length of the delays between speaker changes (the pitch), followed by a
; 16-bit count of the number of cycles to play. The count is multiplied by the
; length held in bits 6-7 of the music data byte plus one.
; .
; Each cycle sets the border (and speaker) to black for a delay and then turns
; the speaker on for the same delay.
;
; A Music data byte
; DE Music data terminated by #N$FF
@label=PlayNote
c$BD7B AND %00111111 ; Keep only bits 0-5 (the note).
 $BD7D JR Z,$BDBC    ; Jump to #R$BDBC if the note is a rest (zero).
 $BD7F LD L,A        ; {Use the note as the offset into the table of notes.
 $BD80 LD H,$00      ; }
 $BD82 ADD HL,HL     ; {Multiply the offset by four (the size of an entry) and add the table
 $BD83 ADD HL,HL     ; of notes at #R$BDD2.
 $BD84 LD BC,$BDD2   ;
 $BD87 ADD HL,BC     ; }
; Read the table entry for the note: two bytes of pitch delay and then
; the 16-bit number of cycles.
 $BD88 LD B,(HL)     ; {Fetch the pitch delay of the note into #REGb and #REGc.
 $BD89 INC HL        ;
 $BD8A LD C,(HL)     ;
 $BD8B INC HL        ; }
 $BD8C LD A,(HL)     ; {Fetch the number of cycles of the note into #REGhl.
 $BD8D INC HL        ;
 $BD8E LD H,(HL)     ;
 $BD8F LD L,A        ; }
; Multiply the number of cycles by the length of the note.
 $BD90 LD A,(DE)     ; Fetch the music data byte.
 $BD91 RLCA          ; {Rotate bits 6-7 (the length of the note) into bits 0-1.
 $BD92 RLCA          ; }
 $BD93 AND %00000011 ; Keep only bits 0-1.
 $BD95 INC A         ; Add one, so #REGa holds the length of the note.
 $BD96 PUSH DE       ; Stash the music data pointer on the stack.
 $BD97 LD E,L        ; {Copy the number of cycles into #REGde.
 $BD98 LD D,H        ; }
@label=PlayMusic_Multiply
*$BD99 DEC A         ; {Decrease the length counter by one and jump to #R$BD9F once the
 $BD9A JR Z,$BD9F    ; length has been multiplied in.}
 $BD9C ADD HL,DE     ; Add the number of cycles to the total.
 $BD9D JR $BD99      ; Jump back to #R$BD99.
@label=PlayMusic_MultiplyDone
*$BD9F POP DE        ; Restore the music data pointer from the stack.
; Play one cycle: the speaker is off for the delay and then on for the
; same delay.
@label=PlayMusic_Cycle
*$BDA0 PUSH BC       ; Stash the pitch delay on the stack.
 $BDA1 XOR A         ; Set the speaker to off.
 $BDA2 OUT ($FE),A   ; Write #REGa to port #N$FE (border black, speaker off).
@label=PlayMusic_OffDelay
*$BDA4 DJNZ $BDA4    ; Decrease #REGb by one and loop back to #R$BDA4 until it
                     ; is zero.
 $BDA6 DEC C         ; {Decrease #REGc by one and jump back to #R$BDA4 until it
 $BDA7 JR NZ,$BDA4   ; is zero.}
 $BDA9 POP BC        ; Restore the pitch delay from the stack.
 $BDAA PUSH BC       ; Stash the pitch delay on the stack.
 $BDAB LD A,$10      ; Set the speaker to on (bit 4).
 $BDAD OUT ($FE),A   ; Write #REGa to port #N$FE (border black, speaker on).
@label=PlayMusic_OnDelay
*$BDAF DJNZ $BDAF    ; Decrease #REGb by one and loop back to #R$BDAF until it
                     ; is zero.
 $BDB1 DEC C         ; {Decrease #REGc by one and jump back to #R$BDAF until it
 $BDB2 JR NZ,$BDAF   ; is zero.}
 $BDB4 POP BC        ; Restore the pitch delay from the stack.
 $BDB5 DEC HL        ; Decrease the cycle counter by one.
 $BDB6 LD A,H        ; {Loop back to #R$BDA0 until all of the cycles of the note have been
 $BDB7 OR L          ; played.
 $BDB8 JR NZ,$BDA0   ; }
 $BDBA INC DE        ; Move on to the next note.
 $BDBB RET           ; Return.
; A rest is a silent delay, which lasts for as many units as the length of
; the note.
@label=PlayMusic_Rest
*$BDBC LD A,(DE)     ; Fetch the music data byte.
 $BDBD INC DE        ; Move on to the next note.
 $BDBE RLCA          ; {Rotate left twice, so bits 6-7 become bits 0-1.
 $BDBF RLCA          ; }
 $BDC0 AND %00000011 ; Keep only bits 0-1.
 $BDC2 INC A         ; Add one, so #REGa holds the length of the rest.
 $BDC3 LD L,A        ; Store the length of the rest in #REGl.
 $BDC4 LD BC,$430B   ; Set the length of one unit of the rest in #REGbc to
                     ; #N$430B.
@label=PlayMusic_RestUnit
*$BDC7 PUSH BC       ; Stash the length of the unit on the stack.
@label=PlayMusic_RestDelay
*$BDC8 DEC BC        ; Decrease the unit counter by one.
 $BDC9 LD A,B        ; {Loop back to #R$BDC8 until the unit has passed.
 $BDCA OR C          ;
 $BDCB JR NZ,$BDC8   ; }
 $BDCD POP BC        ; Restore the length of the unit from the stack.
 $BDCE DEC L         ; {Decrease the length of the rest by one and loop back to #R$BDC7
 $BDCF JR NZ,$BDC7   ; until the rest is over.}
 $BDD1 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$B2DA }
; { #MARTIANOIDS$C0DA }
; LIST#

; Music Note Table
;
; The pitch delays and cycle counts for each of the notes (see
; #R$BD7B). Each entry is four bytes: the delay as two bytes, followed by the
; 16-bit number of cycles to play, which gets larger as the pitch rises so that
; every note lasts the same length of time. Entry #N$00 is unused as it is a
; rest.
@label=MusicNotes
b$BDD2 DEFB $00,$00,$00,$00
 $BDD6 DEFB $F4,$0A,$08,$00
 $BDDA DEFB $65,$0A,$09,$00
 $BDDE DEFB $DE,$09,$09,$00
 $BDE2 DEFB $5E,$09,$0A,$00
 $BDE6 DEFB $E7,$08,$0A,$00
 $BDEA DEFB $75,$08,$0B,$00
 $BDEE DEFB $0A,$08,$0C,$00
 $BDF2 DEFB $A5,$07,$0C,$00
 $BDF6 DEFB $45,$07,$0D,$00
 $BDFA DEFB $EB,$06,$0E,$00
 $BDFE DEFB $96,$06,$0F,$00
 $BE02 DEFB $46,$06,$0F,$00
 $BE06 DEFB $FA,$05,$10,$00
 $BE0A DEFB $B3,$05,$11,$00
 $BE0E DEFB $6F,$05,$12,$00
 $BE12 DEFB $2F,$05,$13,$00
 $BE16 DEFB $F3,$04,$15,$00
 $BE1A DEFB $F3,$04,$16,$00
 $BE1E DEFB $85,$04,$17,$00
 $BE22 DEFB $52,$04,$19,$00
 $BE26 DEFB $23,$04,$1A,$00
 $BE2A DEFB $F6,$03,$1C,$00
 $BE2E DEFB $CB,$03,$1D,$00
 $BE32 DEFB $A3,$03,$1F,$00
 $BE36 DEFB $7D,$03,$21,$00
 $BE3A DEFB $59,$03,$23,$00
 $BE3E DEFB $38,$03,$25,$00
 $BE42 DEFB $18,$03,$27,$00
 $BE46 DEFB $FA,$02,$29,$00
 $BE4A DEFB $DD,$02,$2C,$00
 $BE4E DEFB $C2,$02,$2E,$00
