; Write Menu Line
;
; Used by the routine at #R$B473.
; .
; Prints a line of text with an attribute, for the game selection menu and
; the hall of fame. The shadow registers hold the text pointer (#REGde') and the
; screen address (#REGhl'), and the normal registers hold the attribute address
; (#REGhl). The attribute is taken from #R$96A8. Printing is done by the code
; in #R$B53D.
; .
; #PUSHS #UDGTABLE(default,centre)
; { =h Before }
; { #SIM(start=$9960,stop=$998F,clear=1,sp=$5B40)
; #SIM(start=$B3D5,stop=$B3E6,sp=$5B40)
; #SIM(start=$B473,stop=$B47F,sp=$5B40)
; #SCR$02,$02,$05,$1C,$03(menu-line-before) }
; { =h After #R$B52D }
; { #SIM(start=$B47F,stop=$B495,sp=$5B40)
; #SCR$02,$02,$05,$1C,$03(menu-line-after) } UDGTABLE# #POPS
;
; HL Position of the text, with the Y position in #REGh and the X position in
; .  #REGl (both in pixels)
; DE' Pointer to the text, which ends with a character that has bit 7 set
@label=MenuWriteText
c$B52D PUSH HL       ; Stash the position of the line of text on the stack.
 $B52E CALL $B8AD    ; Convert the position into a screen address.
 $B531 LD A,($96A8)  ; Fetch the attribute of the line of text from #R$96A8.
 $B534 EX AF,AF'     ; Stash the attribute in the shadow #REGaf register.
 $B535 EXX           ; Switch to the shadow registers.
 $B536 POP HL        ; Restore the position of the line of text from the stack.
 $B537 CALL $B8DD    ; Convert the position into an attribute address.
 $B53A JP $B549      ; Jump to #R$B549 to print the line of text.
; View the equivalent code in;
; #LIST
; { #ATICATAC$7D8A }
; { #COOKIE$63E0 }
; { #JETPAC$62FF }
; { #LUNARJETMAN$81AB }
; { #PSSST$62E7 }
; { #TRANZAM$5F97 }
; { #UNDERWURLDE$91B0 }
; LIST#

; Print Colour String
;
; Used by the routines at #R$A034, #R$AA6A and #R$B563.
; .
; Prints a string at the position given, which has its attribute as the
; first byte. The last character of the string has bit 7 set. The attribute is
; written to each of the positions of the characters.
; .
; #PUSHS #UDGTABLE(default,centre)
; { =h Before }
; { #SIM(start=$9960,stop=$9979,clear=1,sp=$5B40)
; #SCR$02,$00,$00,$20,$02(colour-string-before) }
; { =h After #R$B53D }
; { #SIM(start=$B53D,stop=$0000,hl=$0078,de=$B586,sp=$5B40)
; #SCR$02,$00,$00,$20,$02(colour-string-after) } UDGTABLE# #POPS
;
; HL Position of the text, with the Y position in #REGh and the X position in
; .  #REGl (both in pixels)
; DE Pointer to string data
@label=PrintStringColour
c$B53D PUSH HL       ; Stash the position of the string on the stack.
 $B53E CALL $B8AD    ; Convert the position into a screen address.
 $B541 LD A,(DE)     ; Fetch the attribute of the string.
 $B542 EX AF,AF'     ; Stash the attribute in the shadow #REGaf register.
 $B543 INC DE        ; Move onto the text of the string.
 $B544 EXX           ; Switch to the shadow registers.
 $B545 POP HL        ; Restore the position of the string from the stack.
 $B546 CALL $B8DD    ; Convert the position into an attribute address.
; This entry point is used by the routine at #R$B52D.
@label=PrintString_Loop
*$B549 EXX           ; Switch back to the normal registers.
 $B54A LD A,(DE)     ; Fetch the next character of the string.
 $B54B BIT 7,A       ; {Jump to #R$B55A if this is the last character of the string (bit 7
 $B54D JR NZ,$B55A   ; is set).}
 $B54F CALL $B589    ; Print the character.
 $B552 INC DE        ; Move onto the next character of the string.
 $B553 EXX           ; Switch to the shadow registers.
 $B554 EX AF,AF'     ; Fetch the attribute.
 $B555 LD (HL),A     ; Set the attribute of the character on the screen.
 $B556 INC L         ; Move onto the next column.
 $B557 EX AF,AF'     ; Stash the attribute in the shadow #REGaf register.
 $B558 JR $B549      ; Jump back to #R$B549 to print the next character.
; Because the last character contains the terminator, it needs to be handled
; separately.
@label=PrintString_LastCharacter
*$B55A AND %01111111 ; Keep only bits 0-6 (i.e. strip the bit 7 terminator).
 $B55C CALL $B589    ; Print the last character of the string.
 $B55F EXX           ; Switch to the shadow registers.
 $B560 EX AF,AF'     ; Fetch the attribute.
 $B561 LD (HL),A     ; Set the attribute of the last character on the screen.
 $B562 RET           ; Return.
