; Amulet Graphics Table
;
; The graphics which make up the amulet on the amulet screen (see
; #R$A207). There are four entries of four bytes, each of which is the address
; of a graphic followed by its X and Y position, and then a zero address ends
; the table. The first entry is used for the first bit of the amulet pieces
; collected (see #R$970D).
; .
; The graphics are the amulet outlines at #R$E3A0, #R$E494, #R$E588 and #R$E67C.
@label=AmuletGraphicsTable
b$C374 DEFW $E67C    ; Graphic #R(#PEEK(#PC) + #PEEK(#PC + $01) * $100).
 $C376 DEFB $80,$58  ; X/ Y position.
 $C378 DEFW $E588    ; Graphic #R(#PEEK(#PC) + #PEEK(#PC + $01) * $100).
 $C37A DEFB $50,$58  ; X/ Y position.
 $C37C DEFW $E494    ; Graphic #R(#PEEK(#PC) + #PEEK(#PC + $01) * $100).
 $C37E DEFB $80,$38  ; X/ Y position.
 $C380 DEFW $E3A0    ; Graphic #R(#PEEK(#PC) + #PEEK(#PC + $01) * $100).
 $C382 DEFB $50,$38  ; X/ Y position.
 $C384 DEFW $0000    ; Terminator.

; Special Room (Game Completed)
;
; This is the room data showing on the Game Completed screen. See #R$9F6A.
; .
; #UDGTABLE
; { #ROOM(#PC)(room-complete) }
; UDGTABLE#
@label=Room_Special_Complete
w$C386 DEFW $E1EC    ; Background graphic #R(#PEEK(#PC) + #PEEK(#PC + $01) *
                     ; $100).
 $C388 DEFB $40,$58  ; X/ Y position = #N(#EVAL(#PEEK(#PC) / $08)) /
                     ; #N(#EVAL(#PEEK(#PC + $01) / $08)).
 $C38A DEFW $0000    ; Terminator.

