; Game Options
;
; The options chosen on the game selection menu (see #R$B3D5).
; #TABLE(default,centre,left)
; { =h Bit(s) | =h Meaning }
; { 0 | Set for a 2 player game, reset for a 1 player game }
; { 1-2 | The controls (see below) }
; TABLE#
; #TABLE(default,centre,left)
; { =h Bits 1-2 | =h Controls }
; { #N$00 | Keyboard }
; { #N$01 | Kempston Joystick }
; { #N$02 | Cursor Joystick }
; { #N$03 | Interface II Joystick }
; TABLE#
@label=GameOptions
g$9692 DEFB $00
; View the equivalent code in;
; #LIST
; { #UNDERWURLDE$8ED5 }
; LIST#

; Game Timer
;
; A 16-bit counter which is incremented by #R$9A1D each time every actor
; has been processed.
@label=GameTimer
g$9693 DEFB $00
@label=GameTimer_High
 $9694 DEFB $00

; Random Number
;
; An 8-bit pseudo-random seed. It is updated each time an actor handler
; is run (#R$99D0) and once per pass of the actor table (#R$9A1D).
@label=RandomNumber
g$9695 DEFB $00

; Last Frame
;
; The value of #SKOOLKID$5C78(FRAMES) the last time #R$99B2 saw a new
; frame.
@label=LastFrame
g$9696 DEFB $00

; Frame Updated
;
; Has the frame been updated? This is set by #R$99BC and cleared by
; #R$99F0 once the player's actor has been processed.
; #TABLE(default,centre,centre) { =h Value | =h Updated? }
; { #N$00 | Not updated }
; { #N$01 | Updated }
; TABLE#
@label=FrameUpdated
g$9697 DEFB $00

; 1UP Score
;
; The score of player 1, held as three bytes with two BCD digits in each.
; The most significant byte is first.
@label=1UP_Score_1
g$9698 DEFB $00      ; Byte #1.
@label=1UP_Score_2
 $9699 DEFB $00      ; Byte #2.
@label=1UP_Score_3
 $969A DEFB $00      ; Byte #3.

; 2UP Score
;
; The score of player 2, held as three bytes with two BCD digits in each.
; The most significant byte is first.
@label=2UP_Score_1
g$969B DEFB $00      ; Byte #1.
@label=2UP_Score_2
 $969C DEFB $00      ; Byte #2.
@label=2UP_Score_3
 $969D DEFB $00      ; Byte #3.

; Active Player
;
; Which player is currently active.
; #TABLE(default,centre,centre) { =h Value | =h Player }
; { #N$00 | 1UP }
; { #N$FF | 2UP }
; TABLE#
@label=Flag_ActivePlayer
g$969E DEFB $00

; Previous Sprite Id
;
; The sprite ID of the actor that #R$BB0B last saved. #R$B925 uses it to
; find the sprite that has to be erased, together with the saved position and
; room.
@label=Previous_Sprite_Id
g$969F DEFB $00

; Previous X Position
;
; The X position of the actor that #R$BB0B last saved.
@label=Previous_X_Position
g$96A0 DEFB $00

; Previous Y Position
;
; The Y position of the actor that #R$BB0B last saved.
@label=Previous_Y_Position
g$96A1 DEFB $00

; Previous Room
;
; The room of the actor that #R$BB0B last saved.
@label=Previous_Room
g$96A2 DEFB $00

; Old Sprite Row Count
;
; The number of rows of the old sprite that #R$B9A9 has still to draw. It
; is set up by #R$B939, and is zero when there is no old sprite to erase (see
; #R$B919).
@label=Old_Sprite_Row_Count
g$96A3 DEFB $00

; New Sprite Row Count
;
; The number of rows of the new sprite that #R$B9A9 has still to draw. It
; is set up by #R$B969, and is zero when there is no new sprite to draw (see
; #R$B8F5).
@label=New_Sprite_Row_Count
g$96A4 DEFB $00

; New Sprite Height
;
; The height in pixels of the new sprite. It is set up by #R$B969 and used
; by #R$BB24.
@label=New_Sprite_Height
g$96A5 DEFB $00

; New Sprite Width
;
; The number of character cells that each row of the new sprite covers. It
; is one more than the width of the sprite in bytes when the sprite does not
; start on a character boundary. It is set up by #R$B969 and used by #R$BB24.
@label=New_Sprite_Width
g$96A6 DEFB $00

; Unused
;
; Cleared when the game starts. The game does not use it.
@label=Unused_After_New_Sprite_Width
u$96A7 DEFB $00

; Current menu item colour attribute
;
; The attribute of the line of the game selection menu that is being
; printed (see #R$B473 and #R$B52D).
@label=Current_MenuAttribute
g$96A8 DEFB $00

; Saved Actor Pointer
;
; The address of the actor being processed when a new frame started. See
; #R$99BC and #R$99F0.
@label=SavedActorPointer
g$96A9 DEFW $0000

; Moved Actor Room
;
; The room of the actor that #R$AFE8 last moved, saved before it moves so
; that the room it was in is known if it changes room (see #R$A79F).
@label=Moved_Actor_Room
g$96AB DEFB $00

; Player Controls
;
; The controls being pressed by the player, as read by #R$B0A3 (after the
; magenta orchid has reversed them). There is a bit for each of left (bit 0),
; right (bit 1), up (bit 2), down (bit 3) and fire (bit 4).
@label=Player_Controls
g$96AC DEFB $00

; Actor Width
;
; The width in pixels of the actor that is being moved. Each actor
; handler sets it before moving the actor with #R$AFE8 and #R$A44B, so that the
; actor can be kept on the screen.
@label=Actor_Width
g$96AD DEFB $00

; Actor Old X Position
;
; The X position of the actor before it moved, saved by #R$B81C when it
; stops the actor moving through the objects in the room.
@label=Actor_Old_X_Position
g$96AE DEFB $00

; Actor Old Y Position
;
; The Y position of the actor before it moved, saved by #R$B81C when it
; stops the actor moving through the objects in the room.
@label=Actor_Old_Y_Position
g$96AF DEFB $00

; Orchid Effect Timer
;
; The time left of the effect of an orchid on the player, or zero if there
; is no effect. It is set by #R$A737 (to #N$C0) and #R$AE8F (to #N$60), and is
; counted down by #R$AE7A every other frame. When it reaches zero the player
; goes back to the normal colour. While it is below #N$2F the player flashes
; between the colour of the orchid and white.
@label=OrchidEffectTimer
g$96B0 DEFB $00

; Nastie Spawn Delay
;
; A delay between nasties appearing. It is counted down by #R$9A3C each
; time every actor has been processed, and a new nastie can only start when it
; is zero. It is set to #N$10 at the start of a turn (see #R$B1B7) and when the
; player has died (see #R$AA27).
@label=NastieSpawnDelay
g$96B1 DEFB $00

; Attribute Set Flag
;
; If this is not zero then #R$BC0B uses the second set of attributes of a
; graphic, if it has one, and resets this to zero. #R$A207 sets it to draw the
; pieces of the amulet that have been collected in full colour.
@label=AttributeSetFlag
g$96B2 DEFB $00

; Footstep Counter
;
; Incremented by #R$BF4B each time a player moves. It times the sound of
; the footsteps.
@label=FootstepCounter
g$96B3 DEFB $00

; Flame Spawn Delay
;
; A delay before a flame can start. It is counted down by #R$9ABC while
; the flame record at #R$9762 is empty. It is set to #N$80 at the start of a
; turn, when the player has died and when the player moves to another room, and
; to #N$10 when a flame has been blown up (see #R$A4A1).
@label=FlameSpawnDelay
g$96B4 DEFB $00

; Game Delay Timer
;
; At the beginning of each player turn there is a delay to allow the
; player to be ready for play.
; #TABLE(default,centre,centre)
; { =h Value | =h Game Mode }
; { #N$80 | 1UP }
; { #N$FF | 2UP }
; TABLE#
; The larger delay for a 2UP game is useful for swapping players controls.
@label=GameDelayTimer
g$96B5 DEFB $00

; Percentage Hundreds
;
; The hundreds digit of the percentage of the jungle that has been
; explored, which is worked out by #R$9CC6.
@label=Percentage_Hundreds
g$96B6 DEFB $00

; Previous Game Options
;
; The game selection menu uses this to remember the options that it last
; saw (see #R$B43E), so that the countdown to the hall of fame is restarted when
; the options change.
; .
; It is also used by #R$9CC6 to hold the tens and units digits of the
; percentage of the jungle that has been explored.
@label=PreviousGameOptions
g$96B7 DEFB $00

; Hall Of Fame Timer
;
; Counter for game selection screen, which tells the routine when to flip
; to display the Hall Of Fame (see #R$B272).
@label=HallOfFame_Timer
g$96B8 DEFW $0000

; Hall Of Fame Updated Flag
;
; Set to #N$01 when a score has been entered into the hall of fame, and
; cleared by #R$B5FC. #R$AAA4 shows the hall of fame at the end of the game if
; it is set.
@label=HallOfFameUpdated
g$96BA DEFB $00

; High Score Position
;
; Used when calculating the players position in the high score table.
; It is the number of places that the score beat (see #R$B61E).
@label=HighScorePosition
g$96BB DEFB $00

; Active Player: Unknown
;
; Purpose not yet known. It is cleared by #R$B21E and swapped with
; #R$96DF by #R$B235 when the players change, but it is never read.
@label=ActivePlayer_Unknown
g$96BC DEFB $00

; Active Player Lives
;
; The number of lives of the active player.
@label=ActivePlayer_Lives
g$96BD DEFB $00

; Active Player: Nastie Limit
;
; The maximum number of nasties that can be in the room of the player at
; once, which is set by #R$B21E.
@label=ActivePlayer_NastieLimit
g$96BE DEFB $00

; Visited Rooms
;
; A bitmap of the rooms which the active player has visited, with a bit
; for each of the #N($0100,$04,$04) rooms (see #R$9D23).
@label=VisitedRooms
