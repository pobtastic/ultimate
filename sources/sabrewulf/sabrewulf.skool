; Print Banner
;
; Used by the routine at #R$9960.
; .
; Prints the score labels "1UP", "HI" and "2UP" at the top of the screen.
; .
; #PUSHS #UDGTABLE(default,centre)
; { =h Before }
; { #SIM(start=$9960,stop=$9979,clear=1,sp=$5B40)
; #SCR$02,$00,$00,$20,$02(banner-before) }
; { =h After #R$B563 }
; { #SIM(start=$9979,stop=$997C,sp=$5B40)
; #SCR$02,$00,$00,$20,$02(banner-after) } UDGTABLE# #POPS
;
; .
;
; Prints "1UP".
@label=PrintBanner
c$B563 LD HL,$0010       ; Set the position of the "1UP" label in #REGhl (the Y position is
                         ; #N$00 and the X position is #N$10).
 $B566 LD DE,$B57E       ; Point #REGde at the "1UP" label at #R$B57E.
 $B569 CALL $B53D        ; Print the "1UP" label.
; Prints "HI".
 $B56C LD HL,$0078       ; Set the position of the "HI" label in #REGhl (the Y position is
                         ; #N$00 and the X position is #N$78).
 $B56F LD DE,$B586       ; Point #REGde at the "HI" label at #R$B586.
 $B572 CALL $B53D        ; Print the "HI" label.
; Prints "2UP".
 $B575 LD HL,$00D8       ; Set the position of the "2UP" label in #REGhl (the Y position is
                         ; #N$00 and the X position is #N$D8).
 $B578 LD DE,$B582       ; Point #REGde at the "2UP" label at #R$B582.
 $B57B JP $B53D          ; Print the "2UP" label.
; Banner text data.
@label=1UP_Text
 $B57E DEFM $45          ; {"1UP" (#COLOUR(#PEEK(#PC)) is the attribute).
 $B57F DEFM "1U","P"+$80 ; }
@label=2UP_Text
 $B582 DEFM $45          ; {"2UP" (#COLOUR(#PEEK(#PC)) is the attribute).
 $B583 DEFM "2U","P"+$80 ; }
@label=HI_Text
 $B586 DEFM $57          ; {"HI" (#COLOUR(#PEEK(#PC)) is the attribute).
 $B587 DEFM "H","I"+$80  ; }
; View the equivalent code in;
; #LIST
