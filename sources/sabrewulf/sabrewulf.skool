; Test Player Progress
;
; Used by the routines at #R$ADD0 and #R$AEEF.
; .
; Called once per frame for the player. Checks whether the game has been
; completed and whether an amulet piece has just been collected.
;
; IX Actor record of the player
;
; The game is complete if the player is in room #N$88 and is above the
; half-way point of the screen.
@label=TestPlayerProgress
c$A18C LD A,(IX+$01)  ; Fetch the room of the player.
 $A18F CP $88         ; {Jump to #R$A19F if the player is not in room #N$88.
 $A191 JR NZ,$A19F    ; }
 $A193 LD A,(IX+$04)  ; Fetch the Y position of the player.
 $A196 CP $80         ; {Jump to #R$A19F if the player has not reached the top half of the
 $A198 JR NC,$A19F    ; screen (the Y position is #N$80 or more).}
; The game is over, so discard the return address as #R$9F6A never
; returns to the caller.
 $A19A INC SP         ; {Discard the return address.
 $A19B INC SP         ; }
 $A19C JP $9F6A       ; Jump to #R$9F6A to complete the game.
; Show the amulet if a piece has just been collected.
@label=TestPlayerProgress_ShowAmulet
*$A19F BIT 7,(IX+$0B) ; {Return unless the "show the amulet" flag
 $A1A3 RET Z          ; (bit 7 of the amulet pieces collected, see #R$970D) is set.
                      ; }
 $A1A4 RES 7,(IX+$0B) ; Reset the "show the amulet" flag as it has been dealt
                      ; with.
 $A1A8 JP $A207       ; Jump to #R$A207 to show the amulet.

; Handler: Amulet Piece
;
; Handles the four amulet pieces (sprite IDs #N$90 to #N$93), which are
; placed in the rooms by #R$A255. The piece flashes when it is in the room
; the player is in and when the player touches it, it is collected.
; .
; Collecting a piece sets the bit in #R$970D that corresponds to the piece,
; sets bit 7 of the same byte so that the amulet is shown by #R$A18C, and
; awards 7500 points.
;
; IX Actor record of the amulet piece
;
; Do nothing unless the piece is in the same room as the player.
@label=HandlerAmuletPiece
c$A1AB LD A,($9703)    ; Fetch the room of the player from #R$9703.
 $A1AE CP (IX+$01)     ; Compare with the room of the amulet piece.
 $A1B1 RET NZ          ; Return if the amulet piece is in a different room to
                       ; the player.
 $A1B2 LD BC,$0C0C     ; Set how far above and to the right of the amulet piece the player
                       ; can be in #REGbc to #N$0C0C (see #R$AB01).
; Every other frame, cycle the piece through the colours #N$44 to #N$47.
 $A1B5 LD A,($9693)    ; Fetch the low byte of the game timer from #R$9693.
 $A1B8 AND %00000001   ; Keep only bit 0.
 $A1BA JR NZ,$A1C7     ; Jump to #R$A1C7 if bit 0 is set
                       ; (the colour only changes on alternate passes).
 $A1BC LD A,(IX+$05)   ; Fetch the colour of the amulet piece.
 $A1BF INC A           ; Move on to the next colour.
 $A1C0 AND %00000011   ; Keep only bits 0-1.
 $A1C2 OR %01000100    ; Set bits 2 and 6, giving a bright ink colour of
                       ; #N$04-#N$07.
 $A1C4 LD (IX+$05),A   ; Set the new colour of the amulet piece.
; Test whether the player is touching the piece.
@label=AmuletPiece_TestTouch
*$A1C7 CALL $AB01      ; Test whether the player is touching the amulet piece.
 $A1CA JP NC,$A31A     ; Jump to #R$A31A to draw the amulet piece if the player is not
                       ; touching it.
; The piece has been collected, so work out which bit to set.
 $A1CD LD A,($970D)    ; Fetch the amulet pieces collected from #R$970D.
 $A1D0 OR %10000000    ; Set bit 7 (the "show the amulet" flag).
 $A1D2 LD C,A          ; Stash the new amulet pieces collected in #REGc.
 $A1D3 LD A,(IX+$00)   ; Fetch the sprite ID of the amulet piece.
 $A1D6 SUB $90         ; Subtract #N$90 to get the number of the amulet piece.
 $A1D8 JR Z,$A1F3      ; Jump to #R$A1F3 if this is the first amulet piece.
 $A1DA DEC A           ; Move on to the next piece number.
 $A1DB JR Z,$A1F7      ; Jump to #R$A1F7 if this is the second amulet piece.
 $A1DD DEC A           ; Move on to the next piece number.
 $A1DE JR Z,$A1FB      ; Jump to #R$A1FB if this is the third amulet piece.
 $A1E0 SET 3,C         ; Set bit 3 of the amulet pieces collected, as this is the fourth
                       ; piece.
@label=AmuletPiece_Collected
*$A1E2 LD A,C          ; Fetch the new amulet pieces collected.
 $A1E3 LD ($970D),A    ; Store the amulet pieces collected in #R$970D.
 $A1E6 CALL $B919      ; Erase the amulet piece from the screen.
 $A1E9 LD (IX+$00),$00 ; Remove the amulet piece by setting its sprite ID to
                       ; #N$00.
; Add 7500 points to the player's score.
 $A1ED LD BC,$7500     ; Set the points to award in #REGbc to 7500 (stored as
                       ; BCD).
 $A1F0 JP $B5A9        ; Jump to #R$B5A9 to add the points to the score.
; Set the bit for the first, second or third piece.
@label=AmuletPiece_First
*$A1F3 SET 0,C         ; Set bit 0 of the amulet pieces collected for the first
                       ; piece.
 $A1F5 JR $A1E2        ; Jump to #R$A1E2.
@label=AmuletPiece_Second
*$A1F7 SET 1,C         ; Set bit 1 of the amulet pieces collected for the
                       ; second piece.
 $A1F9 JR $A1E2        ; Jump to #R$A1E2.
@label=AmuletPiece_Third
*$A1FB SET 2,C         ; Set bit 2 of the amulet pieces collected for the third
                       ; piece.
 $A1FD JR $A1E2        ; Jump to #R$A1E2.

; Pause
;
; Used by the routines at #R$A234, #R$AA6A, #R$B6D7 and #R$B743.
; .
; A simple delay loop. #REGhl is counted down to zero, which is repeated
; #REGb times. As #REGhl wraps around when it is zero, every pass after the
; first one counts through all #N$10000 values.
;
; B Number of times to count down #REGhl
; HL Start value for the first count down
@label=Pause
c$A1FF DEC HL        ; Decrease the delay counter in #REGhl by one.
 $A200 LD A,L        ; {Loop back to #R$A1FF until the delay counter in #REGhl
 $A201 OR H          ; is zero.
 $A202 JR NZ,$A1FF   ; }
 $A204 DJNZ $A1FF    ; Decrease the number of delays in #REGb by one and loop back to
                     ; #R$A1FF until all of the delays have been done.
 $A206 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #MARTIANOIDS$BD32 }
; LIST#

; Show Amulet
;
; Used by the routine at #R$A18C.
; .
; Clears the play area and draws the amulet in the middle of the screen.
; The amulet is drawn as four graphics, one for each piece. Every piece is
; drawn as a plain red silhouette, unless it has been collected, in which case
; it is drawn in full colour. Each of the graphics is drawn by #R$BC0B, which
; holds two sets of attributes for each graphic, the second of which is only
; used when #R$96B2 is set.
; .
; Once the amulet has been drawn the poem is shown by #R$A234.
; .
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After #R$A207 }
; { #SIM(start=$9960,stop=$998F,clear=1,sp=$5B40)
; #SIM(start=$99A7,stop=$99AA,sp=$5B40)
; #POKES$970D,$07
; #SCR$01(show-amulet-before)
; | #SIM(start=$A207,stop=$A234,ix=$9702,sp=$5B40)
; #SCR$01(show-amulet-after) } UDGTABLE# #POPS
;
; IX Actor record of the player
@label=ShowAmulet
c$A207 CALL $BB7C    ; Clear the attribute buffer of the play area.
 $A20A CALL $BB5C    ; Clear the play area.
 $A20D LD A,(IX+$0B) ; Fetch the amulet pieces collected from #R$970D.
 $A210 LD C,A        ; Stash the amulet pieces collected in #REGc.
 $A211 LD HL,$C374   ; Point #REGhl at the table of amulet graphics and positions at
                     ; #R$C374.
; Draw each of the amulet pieces in turn.
@label=ShowAmulet_Loop
*$A214 LD E,(HL)     ; {Fetch the address of the next graphic from the table
 $A215 INC HL        ; into #REGde.
 $A216 LD D,(HL)     ; }
 $A217 LD A,E        ; {Jump to #R$A234 if the end of the table has been reached
 $A218 OR D          ; (the address is zero).
 $A219 JR Z,$A234    ; }
 $A21B INC HL        ; Move onto the position of the graphic.
 $A21C SRL C         ; Shift the collected flag for this amulet piece out of #REGc and into
                     ; the carry flag.
 $A21E JR NC,$A225   ; Jump to #R$A225 if the amulet piece has not been
                     ; collected.
 $A220 LD A,$01      ; {Write #N$01 to #R$96B2 so that the graphic is drawn in
 $A222 LD ($96B2),A  ; full colour.}
@label=ShowAmulet_Draw
*$A225 PUSH BC       ; Stash the amulet pieces remaining on the stack.
 $A226 LD C,(HL)     ; {Fetch the position of the graphic from the table
 $A227 INC HL        ; (#REGc is the X position and #REGb the Y position).
 $A228 LD B,(HL)     ; }
 $A229 INC HL        ; Move onto the next table entry.
 $A22A PUSH HL       ; Stash the table pointer on the stack.
 $A22B LD H,B        ; {Copy the position to #REGhl.
 $A22C LD L,C        ; }
 $A22D CALL $BC0B    ; Draw the graphic of the amulet piece.
 $A230 POP HL        ; {Restore the table pointer and the amulet pieces remaining from the
 $A231 POP BC        ; stack.}
 $A232 JR $A214      ; Jump back to #R$A214 to draw the next amulet piece.

; Show Poem
;
; Used by the routine at #R$A207.
; .
; Shows the poem for the pieces of the amulet which have been collected,
; plays a tune, waits for a while and then restores the play area. This is
; reached when #R$A207 has finished drawing the amulet.
; .
; #HTML(#AUDIO0(poem-tune.wav)(#INCLUDE(PoemTune)))
; .
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After #R$A234 }
; { #SIM(start=$9960,stop=$998F,clear=1,sp=$5B40)
; #SIM(start=$99A7,stop=$99AA,sp=$5B40)
; #POKES$970D,$05
; #SIM(start=$A207,stop=$A234,ix=$9702,sp=$5B40)
; #SCR$01(show-poem-before)
; | #SIM(start=$A234,stop=$A237,ix=$9702,sp=$5B40)
; #SCR$01(show-poem-after) } UDGTABLE# #POPS
;
; .
;
; Display the poem copy.
@label=HandlerPoems
c$A234 CALL $A01B    ; Display the poem.
; Play music.
 $A237 LD HL,$0000   ; Set #REGhl to #N$0000.
 $A23A LD DE,$BD33   ; Point #REGde at the poem tune at #R$BD33.
 $A23D CALL $BD6E    ; Play the tune.
; Pause so the player has a chance to read and listen.
 $A240 LD B,$08      ; Set the number of delays in #REGb to #N$08.
 $A242 CALL $A1FF    ; Pause so that the player can read the poem.
 $A245 CALL $AC28    ; Check if the game is paused.
; Put the room back as it was.
 $A248 CALL $BB7C    ; Clear the attribute buffer of the play area.
 $A24B CALL $BB5C    ; Clear the play area.
 $A24E CALL $BBDD    ; Draw the current room.
 $A251 CALL $B919    ; Redraw the player.
 $A254 RET           ; Return.

; Place Amulet Pieces
;
; Used by the routine at #R$B21E.
; .
; Sets up the four amulet pieces in #R$97FE. The random seed in #R$9695
; selects one of eight sets of four rooms (see #R$A29D) and each piece is put
; at the first position in the room's layout (see #R$DC6C). The pieces are
; numbered #N$90 to #N$93 and are all drawn in bright yellow (#N$46).
; .
; This is used when a new game is started.
@label=PlaceAmuletPieces
c$A255 LD IX,$97FE     ; Point #REGix at the first amulet piece record at
                       ; #R$97FE.
 $A259 LD A,($9695)    ; Fetch the random seed from #R$9695.
 $A25C AND %00000111   ; Keep only bits 0-2.
 $A25E LD L,A          ; Stash the set number in #REGl.
 $A25F LD H,$00        ; Clear #REGh.
 $A261 ADD HL,HL       ; {Multiply the set number by four, as there are four rooms in each
 $A262 ADD HL,HL       ; set.}
 $A263 LD BC,$A29D     ; Point #REGbc at the sets of amulet piece rooms at
                       ; #R$A29D.
 $A266 ADD HL,BC       ; Add the set offset to get the address of the chosen
                       ; set of rooms.
 $A267 EX DE,HL        ; Point #REGde at the chosen set of rooms.
; There are four pieces of the amulet to collect.
 $A268 LD B,$04        ; Set the amulet piece counter in #REGb to #N$04.
@label=PlaceAmuletPieces_Loop
*$A26A PUSH BC         ; Stash the amulet piece counter on the stack.
 $A26B LD A,B          ; Copy the amulet piece counter to #REGa.
 $A26C ADD A,$8F       ; Add #N$8F, giving a sprite ID of #N$90 to #N$93.
 $A26E LD (IX+$00),A   ; Set the sprite ID of the amulet piece.
 $A271 LD A,(DE)       ; Fetch the room for this amulet piece.
 $A272 INC DE          ; Move onto the next room in the set.
 $A273 LD (IX+$01),A   ; Set the room of the amulet piece.
; Find the layout of the room, and from it the position of the piece.
 $A276 LD L,A          ; Use the room as the offset into the layout table.
 $A277 LD H,$00        ; Clear #REGh.
 $A279 LD BC,$6066     ; Point #REGbc at the layout table at #R$6066.
 $A27C ADD HL,BC       ; Add the layout table address to get the address of the layout number
                       ; for the room.
 $A27D LD L,(HL)       ; Fetch the layout number.
 $A27E LD H,$00        ; Clear #REGh.
 $A280 ADD HL,HL       ; {Multiply the layout number by eight, as there are eight bytes of
 $A281 ADD HL,HL       ; positions for each layout.
 $A282 ADD HL,HL       ; }
 $A283 LD BC,$DC6C     ; Point #REGbc at the table of object positions at
                       ; #R$DC6C.
 $A286 ADD HL,BC       ; Add the table address to get the first position for
                       ; the layout.
 $A287 LD A,(HL)       ; Fetch the X position.
 $A288 INC HL          ; Move onto the Y position.
 $A289 LD (IX+$03),A   ; Set the X position of the amulet piece.
 $A28C LD A,(HL)       ; Fetch the Y position.
 $A28D LD (IX+$04),A   ; Set the Y position of the amulet piece.
 $A290 LD (IX+$05),$46 ; Set the colour of the amulet piece to #COLOUR$46.
 $A294 LD BC,$000C     ; Set the size of an actor record in #REGbc to #N$0C.
 $A297 ADD IX,BC       ; Move onto the next actor record.
 $A299 POP BC          ; Restore the amulet piece counter from the stack.
 $A29A DJNZ $A26A      ; Decrease the amulet piece counter by one and loop back to #R$A26A
                       ; until all four pieces have been placed.
 $A29C RET             ; Return.

; Amulet Piece Rooms
;
; Eight sets of four rooms. One of the sets is chosen at random by
; #R$A255 and the four amulet pieces are placed in its rooms, in the order
; #N$93, #N$92, #N$91 and #N$90.
@label=Initialisation_Amulet
b$A29D DEFB $43,$91,$4D,$CB ; Set 1.
 $A2A1 DEFB $9D,$AC,$2D,$26 ; Set 2.
 $A2A5 DEFB $E1,$73,$44,$2D ; Set 3.
 $A2A9 DEFB $35,$C3,$4D,$A9 ; Set 4.
 $A2AD DEFB $8A,$4D,$E1,$52 ; Set 5.
 $A2B1 DEFB $43,$58,$39,$E7 ; Set 6.
 $A2B5 DEFB $59,$A7,$E2,$91 ; Set 7.
 $A2B9 DEFB $26,$35,$CB,$A3 ; Set 8.

; Generate Room Objects
;
; Used by the routine at #R$B21E.
; .
; Fills a table of #N$0200 bytes at #R$DDEC with the objects (see
; #R$A33B) which are to be found in the rooms. There are two bytes for each of
; the #N$0100 rooms, so each room can hold up to two objects.
; .
; A byte is taken from the ROM (starting at an address made from #R$9693 and
; the frame counter, so it is effectively random) for each byte of the table.
; If the ROM byte is #N$80 or more then the table byte is zero, which means
; there is no object. Otherwise the table byte is made up from:
; #LIST
; { Bits 6-7: which of the room's four positions to use (taken from the byte
; count) }
; { Bits 0-3: the type of object (taken from the random seed at #R$9695) }
; LIST#
; This is used when a new game is started.
@label=GenerateRoomObjects
c$A2BD LD HL,$DDEC   ; Point #REGhl at the table of room objects at #R$DDEC.
 $A2C0 LD A,($5C78)  ; {Fetch the low byte of #SKOOLKID$5C78(FRAMES) into
 $A2C3 LD E,A        ; #REGe.}
 $A2C4 LD A,($9693)  ; Fetch the low byte of the game timer from #R$9693.
 $A2C7 AND %00011111 ; Keep only bits 0-4.
 $A2C9 LD D,A        ; Use it as the high byte of the ROM address in #REGd, so #REGde
                     ; points into the ROM.
 $A2CA LD BC,$0200   ; Set the number of bytes in the table in #REGbc to
                     ; #N$0200.
@label=GenerateRoomObjects_Loop
*$A2CD LD A,(DE)     ; Fetch a (random) byte from the ROM.
 $A2CE INC DE        ; Move onto the next ROM byte.
 $A2CF CP $80        ; {Jump to #R$A2DC if the ROM byte is less than #N$80.
 $A2D1 JR C,$A2DC    ; }
 $A2D3 LD (HL),$00   ; Write #N$00 to the table, so there is no object here.
@label=GenerateRoomObjects_Next
 $A2D5 INC HL        ; Move onto the next table byte.
@label=GenerateRoomObjects_Count
*$A2D6 DEC BC        ; Decrease the byte counter by one.
 $A2D7 LD A,B        ; {Loop back to #R$A2CD until all #N$0200 bytes of the table have been
 $A2D8 OR C          ; done.
 $A2D9 JR NZ,$A2CD   ; }
 $A2DB RET           ; Return.
; Make the table byte for an object.
@label=GenerateRoomObjects_Object
*$A2DC PUSH BC       ; Stash the byte counter on the stack.
 $A2DD LD A,C        ; Fetch the low byte of the byte counter.
 $A2DE RRCA          ; {Rotate the low byte of the byte counter right twice.
 $A2DF RRCA          ; }
 $A2E0 AND %11000000 ; Keep only bits 6-7.
 $A2E2 LD C,A        ; Stash the position bits in #REGc.
 $A2E3 LD A,($9695)  ; Fetch the random seed from #R$9695.
 $A2E6 AND %00001111 ; Keep only bits 0-3.
 $A2E8 OR C          ; Combine the position and the object type.
 $A2E9 LD (HL),A     ; Write the table byte for the object.
 $A2EA INC HL        ; Move onto the next table byte.
; Update the random seed.
 $A2EB LD A,R        ; Fetch the Z80 refresh register.
 $A2ED LD C,A        ; Stash it in #REGc.
 $A2EE LD A,($9695)  ; Fetch the random seed from #R$9695.
 $A2F1 ADD A,C       ; Add the refresh register value to the seed.
 $A2F2 LD ($9695),A  ; Store the new random seed in #R$9695.
 $A2F5 POP BC        ; Restore the byte counter from the stack.
 $A2F6 JR $A2D6      ; Jump back to #R$A2D6.

; Add Life
;
; Used by the routine at #R$A305.
; .
; Gives the player an extra life, up to a maximum of nine, and updates
; the lives on the screen.
@label=AddLife
c$A2F8 LD A,($96BD)  ; Fetch the number of lives from #R$96BD.
 $A2FB CP $09        ; {Return if the player already has #N$09 lives.
 $A2FD RET NC        ; }
 $A2FE INC A         ; Add a life.
 $A2FF LD ($96BD),A  ; Store the number of lives in #R$96BD.
 $A302 JP $B7CD      ; Jump to #R$B7CD to update the lives display.

; Handler: Extra Life
;
; Handles the extra life (sprite ID #N$85). If the player touches it then
; a life is added, otherwise it is drawn.
;
; IX Actor record of the extra life
@label=HandlerExtraLife
c$A305 LD BC,$0C0C   ; Set how far above and to the right of the extra life the player can
                     ; be in #REGbc to #N$0C0C (see #R$AB01).
 $A308 CALL $AB01    ; Test whether the player is touching the extra life.
 $A30B JR NC,$A31A   ; Jump to #R$A31A to draw the extra life if the player is not touching
                     ; it.
 $A30D CALL $A2F8    ; Add a life.
 $A310 JR $A323      ; Jump to #R$A323 to collect the extra life.

; Handler: Pickup
;
; Handles the pickups (sprite IDs #N$80 to #N$84 and #N$86 to #N$8F). If
; the player touches one then it is collected, otherwise it is drawn.
;
; IX Actor record of the pickup
@label=HandlerPickup
c$A312 LD BC,$0C0C   ; Set how far above and to the right of the pickup the player can be
                     ; in #REGbc to #N$0C0C (see #R$AB01).
 $A315 CALL $AB01    ; Test whether the player is touching the pickup.
 $A318 JR C,$A323    ; Jump to #R$A323 to collect the pickup if the player is
                     ; touching it.

; Colour Pickup
;
; Used by the routines at #R$A1AB and #R$A305.
; .
; Sets the attributes of the screen cells covered by a pickup, which is a
; sprite #N$10 pixels high and two cells wide, using #R$BB24.
;
; IX Actor record of the pickup
@label=ColourPickup
c$A31A LD HL,$0210   ; Set the height of the pickup in #REGl to #N$10 and the number of
                     ; columns in #REGh to #N$02.
 $A31D LD ($96A5),HL ; Store the height and the number of columns in #R$96A5
                     ; and #R$96A6.
 $A320 JP $BB24      ; Jump to #R$BB24 to colour the pickup.

; Collect Pickup
;
; Used by the routines at #R$A305 and #R$A312.
; .
; Collects a pickup: it is erased from the screen, removed from the
; table of room objects so that it does not come back, and is worth 150
; points. A tone is then played by #R$BF25.
; .
; #HTML(#AUDIO0(high-tone.wav)(#INCLUDE(HighTone)))
;
; IX Actor record of the pickup
@label=CollectPickup
c$A323 CALL $B919      ; Erase the pickup from the screen.
; Remove the object from the table of objects in the room.
 $A326 LD L,(IX+$06)   ; Fetch the low byte of the address of the pickup's entry in the table
                       ; of room objects.
 $A329 LD H,(IX+$07)   ; Fetch the high byte of the address of the pickup's
                       ; entry.
 $A32C LD (HL),$00     ; Clear the table entry so that the pickup is gone from
                       ; the room.
 $A32E LD (IX+$00),$00 ; Remove the pickup by setting its sprite ID to #N$00.
; Add 150 points to the player's score.
 $A332 LD BC,$0150     ; Set the points to award in #REGbc to 150 (stored as
                       ; BCD).
 $A335 CALL $B5A9      ; Add the points to the score.
 $A338 JP $BF25        ; Jump to #R$BF25 to play the high tone.

; Set Up Room Objects
;
; Used by the routines at #R$B1D4 and #R$BBAE.
; .
; Creates the actors for the objects which are in the room the player is
; in. Each room has two entries in the table built by #R$A2BD, and each of the
; entries which is not zero is turned into one of the two actors in
; #R$97E6.
;
; IX Actor record of the player
;
; Clear the first object and create it from the first table entry.
@label=SetUpRoomObjects
c$A33B LD DE,$97E6   ; Point #REGde at the record of the first object at
                     ; #R$97E6.
 $A33E XOR A         ; Clear #REGa.
 $A33F LD (DE),A     ; Clear the sprite ID of the first object.
 $A340 CALL $A39C    ; Find the entries in the table of room objects for the
                     ; room.
 $A343 LD A,(HL)     ; Fetch the first table entry for the room.
 $A344 AND A         ; {Jump to #R$A34A if there is no object in the first
 $A345 JR Z,$A34A    ; entry.}
 $A347 CALL $A356    ; Create the first object.
; Clear the second object and create it from the second table entry.
@label=SetUpRoomObjects_Second
*$A34A LD DE,$97F2   ; Point #REGde at the record of the second object at
                     ; #R$97F2.
 $A34D XOR A         ; Clear #REGa.
 $A34E LD (DE),A     ; Clear the sprite ID of the second object.
 $A34F CALL $A39C    ; Find the entries in the table of room objects for the
                     ; room.
 $A352 INC HL        ; Move onto the second table entry for the room.
 $A353 LD A,(HL)     ; Fetch the second table entry for the room.
 $A354 AND A         ; {Return if there is no object in the second entry.
 $A355 RET Z         ; }
; Continue on to #R$A356.

; Create Object
;
; Used by the routine at #R$A33B.
; .
; Creates an object actor from an entry in the table of room objects (see
; #R$A2BD). The actor is set up as follows:
; #TABLE(default,centre,left)
; { =h Byte | =h Contents }
; { #N$00 | The sprite ID, which is #N$80 plus the type of the object (bits 0-3
; of the table entry) }
; { #N$01 | The room the player is in }
; { #N$03 | The X position }
; { #N$04 | The Y position }
; { #N$05 | The colour, see #R$A3A7 }
; { #N$06 | The address of the table entry, which #R$A323 clears when the
; object is collected }
; TABLE#
;
; A The table entry
; DE Address of the actor record
; HL Address of the table entry
; IX Actor record of the player
@label=CreateObject
c$A356 PUSH HL       ; Stash the address of the table entry on the stack.
 $A357 LD C,A        ; Stash the table entry in #REGc.
 $A358 AND %00001111 ; Keep only the object type (bits 0-3).
 $A35A ADD A,$80     ; Add #N$80 to get the sprite ID.
 $A35C LD (DE),A     ; Set the sprite ID of the object.
 $A35D INC DE        ; Move onto the room of the object.
 $A35E LD A,(IX+$01) ; Fetch the room of the player.
 $A361 LD (DE),A     ; Set the room of the object.
 $A362 INC DE        ; {Move onto the X position of the object.
 $A363 INC DE        ; }
; Find the positions for the layout of the room.
 $A364 LD L,A        ; Use the room as the offset into the layout table.
 $A365 LD H,$00      ; Clear #REGh.
 $A367 PUSH DE       ; Stash the pointer to the actor record on the stack.
 $A368 LD DE,$6066   ; Point #REGde at the layout table at #R$6066.
 $A36B ADD HL,DE     ; Add the layout table address to get the address of the layout number
                     ; for the room.
 $A36C LD L,(HL)     ; Fetch the layout number of the room.
 $A36D LD H,$00      ; Clear #REGh.
 $A36F ADD HL,HL     ; {Multiply #REGhl by eight, as there are eight bytes of positions for
 $A370 ADD HL,HL     ; each layout.
 $A371 ADD HL,HL     ; }
; Use bits 6-7 of the table entry to choose one of the four positions.
 $A372 LD A,C        ; Fetch the table entry.
 $A373 RLCA          ; {Rotate it left three times.
 $A374 RLCA          ;
 $A375 RLCA          ; }
 $A376 AND %00000110 ; Keep only bits 1-2.
 $A378 LD E,A        ; Stash the position offset in #REGe.
 $A379 LD D,$00      ; Clear #REGd.
 $A37B ADD HL,DE     ; Add the position offset to the layout offset.
 $A37C LD DE,$DC6C   ; Point #REGde at the table of object positions at
                     ; #R$DC6C.
 $A37F ADD HL,DE     ; Add the table address to get the address of the
                     ; position.
 $A380 POP DE        ; Restore the pointer to the actor record from the stack.
 $A381 LD A,(HL)     ; Fetch the X position.
 $A382 INC HL        ; Move onto the Y position.
 $A383 LD (DE),A     ; Set the X position of the object.
 $A384 INC DE        ; Move onto the Y position of the object.
 $A385 LD A,(HL)     ; Fetch the Y position.
 $A386 LD (DE),A     ; Set the Y position of the object.
 $A387 INC DE        ; Move onto the colour of the object.
; Look up the colour for the type of the object.
 $A388 LD A,C        ; Fetch the table entry.
 $A389 AND %00001111 ; Keep only bits 0-3.
 $A38B LD C,A        ; Stash the object type in #REGc.
 $A38C LD B,$00      ; Clear #REGb.
 $A38E LD HL,$A3A7   ; Point #REGhl at the table of object colours at #R$A3A7.
 $A391 ADD HL,BC     ; Add the object type to get the address of the colour.
 $A392 LD A,(HL)     ; Fetch the colour of the object.
 $A393 LD (DE),A     ; Set the colour of the object.
 $A394 INC DE        ; Move onto the address of the table entry in the actor
                     ; record.
 $A395 POP HL        ; Restore the address of the table entry from the stack.
 $A396 LD A,L        ; Fetch the low byte of the address of the table entry.
 $A397 LD (DE),A     ; Store it in the actor record.
 $A398 INC DE        ; Move onto the high byte.
 $A399 LD A,H        ; Fetch the high byte of the address of the table entry.
 $A39A LD (DE),A     ; Store it in the actor record.
 $A39B RET           ; Return.

; Find Room Objects
;
; Used by the routine at #R$A33B.
; .
; Finds the entries in the table of room objects which belong to the room
; an actor is in.
;
;   IX Actor record
; O:HL Address of the first of the two table entries for the room
@label=FindRoomObjects
c$A39C LD L,(IX+$01) ; Fetch the room of the actor.
 $A39F LD H,$00      ; Clear #REGh.
 $A3A1 ADD HL,HL     ; Double the room, as there are two entries for each room.
 $A3A2 LD BC,$DDEC   ; Point #REGbc at the table of room objects at #R$DDEC.
 $A3A5 ADD HL,BC     ; Add the table address to get the address of the entries for the
                     ; room.
 $A3A6 RET           ; Return.

; Object Colours
;
; The attribute used for each type of object (bits 0-3 of the entry in
; the table of room objects, see #R$A356). The five colours are repeated for
; the sixteen types.
@label=ObjectColours
b$A3A7 DEFB $42      ; #COLOUR(#PEEK(#PC)).
 $A3A8 DEFB $43      ; #COLOUR(#PEEK(#PC)).
 $A3A9 DEFB $44      ; #COLOUR(#PEEK(#PC)).
 $A3AA DEFB $45      ; #COLOUR(#PEEK(#PC)).
 $A3AB DEFB $46      ; #COLOUR(#PEEK(#PC)).
 $A3AC DEFB $42      ; #COLOUR(#PEEK(#PC)).
 $A3AD DEFB $43      ; #COLOUR(#PEEK(#PC)).
 $A3AE DEFB $44      ; #COLOUR(#PEEK(#PC)).
 $A3AF DEFB $45      ; #COLOUR(#PEEK(#PC)).
 $A3B0 DEFB $46      ; #COLOUR(#PEEK(#PC)).
 $A3B1 DEFB $42      ; #COLOUR(#PEEK(#PC)).
 $A3B2 DEFB $43      ; #COLOUR(#PEEK(#PC)).
 $A3B3 DEFB $44      ; #COLOUR(#PEEK(#PC)).
 $A3B4 DEFB $45      ; #COLOUR(#PEEK(#PC)).
 $A3B5 DEFB $46      ; #COLOUR(#PEEK(#PC)).
 $A3B6 DEFB $42      ; #COLOUR(#PEEK(#PC)).

; Test Attack Overlap
;
; Used by the routine at #R$A3C5.
; .
; Tests whether the player is attacking with the sword (sprite IDs #N$20
; to #N$2F) and is touching an actor. The size of the area used for the test is
; set up here for #R$AB01, which does the work.
;
;   IX Actor record
; O:F Carry flag set if the player is attacking and touching the actor
@label=TestAttackOverlap
c$A3B7 LD A,($9702)  ; Fetch the sprite ID of the player from #R$9702.
 $A3BA SUB $20       ; Subtract #N$20 (the first attacking Sabreman sprite ID).
 $A3BC CP $10        ; {Return if the player is not attacking (the carry flag
 $A3BE RET NC        ; is reset).}
 $A3BF LD BC,$0C10   ; Set how far above and to the right of the actor the player can be in
                     ; #REGbc to #N$0C10.
 $A3C2 JP $AB01      ; Jump to #R$AB01 to test whether the player is touching
                     ; the actor.

; Handler: Appearing Nastie
;
; Handles a nastie which is appearing (sprite IDs #N$01 to #N$05). Each
; time it is handled the sprite ID goes up by one, until it reaches #N$06 and
; #R$A3E0 turns it into a real nastie. If the player attacks it while it is
; appearing then it is blown up by #R$A4A6, and if it is in a different room to
; the player it is counted off by #R$A493.
;
; IX Nastie record
;
; Count off the nastie if it is not in the same room as the player.
@label=HandlerAppearingNastie
c$A3C5 LD A,($9703)  ; Fetch the room of the player from #R$9703.
 $A3C8 CP (IX+$01)   ; {Jump to #R$A493 if the nastie is in a different room to
 $A3CB JP NZ,$A493   ; the player.}
 $A3CE CALL $BB0B    ; Remember the previous position of the nastie.
; Blow up the nastie if the player is attacking it.
 $A3D1 CALL $A3B7    ; Test whether the player is attacking the nastie.
 $A3D4 JP C,$A4A6    ; Jump to #R$A4A6 to blow up the nastie if the player is
                     ; attacking it.
; Move the nastie on to the next sprite and make a sound, the pitch of
; which depends on the sprite ID.
 $A3D7 INC (IX+$00)  ; Move the nastie on to the next appearing sprite.
 $A3DA CALL $BF08    ; Play the appearing sound.
 $A3DD JP $AD5D      ; Jump to #R$AD5D to display the nastie.

; Handler: Choose Nastie
;
; Handles a nastie which has finished appearing (sprite ID #N$06) by
; choosing which type of nastie it is going to be. The types are held in
; #R$A41A. At the start of the game only the first eight types are possible,
; but each amulet piece which has been collected makes two more types possible.
;
; IX Nastie record
;
; Count off the nastie if it is not in the same room as the player.
@label=HandlerChooseNastie
c$A3E0 LD A,($9703)  ; Fetch the room of the player from #R$9703.
 $A3E3 CP (IX+$01)   ; {Jump to #R$A493 if the nastie is in a different room to
 $A3E6 JP NZ,$A493   ; the player.}
 $A3E9 CALL $BB0B    ; Remember the previous position of the nastie.
; Count the amulet pieces which have been collected.
 $A3EC LD A,($970D)  ; Fetch the amulet pieces collected from #R$970D.
 $A3EF LD C,$00      ; Clear the number of amulet pieces collected in #REGc.
 $A3F1 LD B,$04      ; Set the amulet piece counter in #REGb to #N$04.
@label=HandlerChooseNastie_Loop
*$A3F3 RRCA          ; Rotate the flag for the next amulet piece into the carry
                     ; flag.
 $A3F4 JR NC,$A3F7   ; Jump to #R$A3F7 if the amulet piece has not been
                     ; collected.
 $A3F6 INC C         ; Count the amulet piece.
@label=HandlerChooseNastie_Next
*$A3F7 DJNZ $A3F3    ; Decrease the amulet piece counter by one and loop back to #R$A3F3
                     ; until all four pieces have been checked.
; Work out how many types of nastie are possible: #N$08 plus twice the
; number of pieces collected.
 $A3F9 SLA C         ; Double the number of amulet pieces collected.
 $A3FB LD A,C        ; Copy it to #REGa.
 $A3FC ADD A,$08     ; Add #N$08.
 $A3FE LD C,A        ; Stash the number of nastie types possible in #REGc.
; Choose a type at random, using the counter. If it is not one of the
; types which are possible then use only the first eight.
 $A3FF LD A,($9693)  ; Fetch the low byte of the game timer from #R$9693.
 $A402 AND %00001111 ; Keep only bits 0-3.
 $A404 CP C          ; {Jump to #R$A409 if the type is possible.
 $A405 JR C,$A409    ; }
 $A407 AND %00000111 ; Keep only bits 0-2.
@label=HandlerChooseNastie_Type
*$A409 LD C,A        ; Stash the type in #REGc.
 $A40A LD B,$00      ; Clear #REGb.
 $A40C LD HL,$A41A   ; Point #REGhl at the table of nastie types at #R$A41A.
 $A40F ADD HL,BC     ; Add the type to get the address of the sprite ID.
 $A410 LD A,(HL)     ; Fetch the sprite ID for the type.
 $A411 LD (IX+$00),A ; Set the sprite ID of the nastie.
 $A414 CALL $A5CD    ; Choose a velocity for the nastie.
 $A417 JP $AD5D      ; Jump to #R$AD5D to display the nastie.

; Nastie Types
;
; The sprite ID for each type of nastie, which is chosen by #R$A3E0. The
; first eight are possible from the start of the game, and the others are only
; possible once enough amulet pieces have been collected.
@label=SpriteReference
b$A41A DEFB $60      ; #LET(result=$BF84 + (#PEEK(#PC) * $02)) Sprite ID:
                     ; #R(#PEEK({result}) + #PEEK({result} + $01) *
                     ; $100)(#N(#PEEK(#PC))) #SPRITENAME(#PEEK(#PC))
 $A41B DEFB $64      ; #LET(result=$BF84 + (#PEEK(#PC) * $02)) Sprite ID:
                     ; #R(#PEEK({result}) + #PEEK({result} + $01) *
                     ; $100)(#N(#PEEK(#PC))) #SPRITENAME(#PEEK(#PC))
 $A41C DEFB $68      ; #LET(result=$BF84 + (#PEEK(#PC) * $02)) Sprite ID:
                     ; #R(#PEEK({result}) + #PEEK({result} + $01) *
                     ; $100)(#N(#PEEK(#PC))) #SPRITENAME(#PEEK(#PC))
 $A41D DEFB $6C      ; #LET(result=$BF84 + (#PEEK(#PC) * $02)) Sprite ID:
                     ; #R(#PEEK({result}) + #PEEK({result} + $01) *
                     ; $100)(#N(#PEEK(#PC))) #SPRITENAME(#PEEK(#PC))
 $A41E DEFB $70      ; #LET(result=$BF84 + (#PEEK(#PC) * $02)) Sprite ID:
                     ; #R(#PEEK({result}) + #PEEK({result} + $01) *
                     ; $100)(#N(#PEEK(#PC))) #SPRITENAME(#PEEK(#PC))
 $A41F DEFB $74      ; #LET(result=$BF84 + (#PEEK(#PC) * $02)) Sprite ID:
                     ; #R(#PEEK({result}) + #PEEK({result} + $01) *
                     ; $100)(#N(#PEEK(#PC))) #SPRITENAME(#PEEK(#PC))
 $A420 DEFB $78      ; #LET(result=$BF84 + (#PEEK(#PC) * $02)) Sprite ID:
                     ; #R(#PEEK({result}) + #PEEK({result} + $01) *
                     ; $100)(#N(#PEEK(#PC))) #SPRITENAME(#PEEK(#PC))
 $A421 DEFB $60      ; #LET(result=$BF84 + (#PEEK(#PC) * $02)) Sprite ID:
                     ; #R(#PEEK({result}) + #PEEK({result} + $01) *
                     ; $100)(#N(#PEEK(#PC))) #SPRITENAME(#PEEK(#PC))
 $A422 DEFB $98      ; #LET(result=$BF84 + (#PEEK(#PC) * $02)) Sprite ID:
                     ; #R(#PEEK({result}) + #PEEK({result} + $01) *
                     ; $100)(#N(#PEEK(#PC))) #SPRITENAME(#PEEK(#PC))
 $A423 DEFB $9C      ; #LET(result=$BF84 + (#PEEK(#PC) * $02)) Sprite ID:
                     ; #R(#PEEK({result}) + #PEEK({result} + $01) *
                     ; $100)(#N(#PEEK(#PC))) #SPRITENAME(#PEEK(#PC))
 $A424 DEFB $B0      ; #LET(result=$BF84 + (#PEEK(#PC) * $02)) Sprite ID:
                     ; #R(#PEEK({result}) + #PEEK({result} + $01) *
                     ; $100)(#N(#PEEK(#PC))) #SPRITENAME(#PEEK(#PC))
 $A425 DEFB $B4      ; #LET(result=$BF84 + (#PEEK(#PC) * $02)) Sprite ID:
                     ; #R(#PEEK({result}) + #PEEK({result} + $01) *
                     ; $100)(#N(#PEEK(#PC))) #SPRITENAME(#PEEK(#PC))
 $A426 DEFB $B8      ; #LET(result=$BF84 + (#PEEK(#PC) * $02)) Sprite ID:
                     ; #R(#PEEK({result}) + #PEEK({result} + $01) *
                     ; $100)(#N(#PEEK(#PC))) #SPRITENAME(#PEEK(#PC))
 $A427 DEFB $BC      ; #LET(result=$BF84 + (#PEEK(#PC) * $02)) Sprite ID:
                     ; #R(#PEEK({result}) + #PEEK({result} + $01) *
                     ; $100)(#N(#PEEK(#PC))) #SPRITENAME(#PEEK(#PC))
 $A428 DEFB $C0      ; #LET(result=$BF84 + (#PEEK(#PC) * $02)) Sprite ID:
                     ; #R(#PEEK({result}) + #PEEK({result} + $01) *
                     ; $100)(#N(#PEEK(#PC))) #SPRITENAME(#PEEK(#PC))
 $A429 DEFB $98      ; #LET(result=$BF84 + (#PEEK(#PC) * $02)) Sprite ID:
                     ; #R(#PEEK({result}) + #PEEK({result} + $01) *
                     ; $100)(#N(#PEEK(#PC))) #SPRITENAME(#PEEK(#PC))

; Handler: Dying Nastie
;
; Handles a nastie which is being blown up (sprite IDs #N$08 to #N$0C).
; Each time it is handled the sprite ID goes up by one until it reaches #N$0D,
; when #R$A43B removes it.
;
; IX Nastie record
@label=HandlerDyingNastie
c$A42A LD A,($9703)  ; Fetch the room of the player from #R$9703.
 $A42D CP (IX+$01)   ; {Jump to #R$A446 if the nastie is in a different room to
 $A430 JR NZ,$A446   ; the player.}
 $A432 CALL $BB0B    ; Remember the previous position of the nastie.
 $A435 INC (IX+$00)  ; Move the nastie on to the next dying sprite.
 $A438 JP $AD5D      ; Jump to #R$AD5D to display the nastie.

; Handler: Remove Nastie
;
; Handles a nastie which has finished being blown up (sprite ID #N$0D).
; The nastie is erased if it is in the same room as the player and the actor
; record is then emptied.
;
; IX Nastie record
@label=HandlerRemoveNastie
c$A43B LD A,($9703)    ; Fetch the room of the player from #R$9703.
 $A43E CP (IX+$01)     ; {Jump to #R$A446 if the nastie is in a different room
 $A441 JR NZ,$A446     ; to the player.}
 $A443 CALL $B919      ; Erase the nastie from the screen.
; This entry point is used by the routine at #R$A42A.
@label=RemoveExplosion
*$A446 LD (IX+$00),$00 ; Empty the record by setting the sprite ID to #N$00.
 $A44A RET             ; Return.

; Calculate New Position
;
; Used by the routines at #R$9D91, #R$A4D7 and #R$A54F.
; .
; Works out where an actor will be after it has moved by its velocities
; (see #REGix+#N$06 and #REGix+#N$07), keeping it on the screen. The velocities
; are in sixteenths of a pixel.
; .
; The X position is kept between #N$00 and #N($0100,$04,$04) minus the width
; (held in #R$96AD) and the Y position between #N$27 and #N$BF.
;
;   IX Actor record
; O:B Bit 0 is set if the actor hit the left or right of the screen, bit 1 is
; .   set if it hit the top or bottom
; O:D The new Y position
; O:E The new X position
@label=CalculateNewPosition
c$A44B LD B,$00       ; Clear the edge flags in #REGb.
 $A44D LD A,($96AD)   ; Fetch the width of the actor from #R$96AD.
 $A450 LD C,A         ; Stash the width in #REGc.
; Work out the new X position.
 $A451 LD A,(IX+$06)  ; Fetch the X velocity of the actor.
 $A454 CALL $B031     ; Convert the X velocity to pixels.
 $A457 JP M,$A47D     ; Jump to #R$A47D if the actor is moving left.
 $A45A ADD A,(IX+$03) ; Add the X position of the actor.
 $A45D LD E,A         ; Stash the new X position in #REGe.
 $A45E ADD A,C        ; Add the width of the actor.
 $A45F JR C,$A476     ; Jump to #R$A476 if the actor would go off the right edge of the
                      ; screen.
; Work out the new Y position.
@label=CalculateNewPosition_Y
*$A461 LD A,(IX+$07)  ; Fetch the Y velocity of the actor.
 $A464 CALL $B031     ; Convert the Y velocity to pixels.
 $A467 JP M,$A488     ; Jump to #R$A488 if the actor is moving up.
 $A46A ADD A,(IX+$04) ; Add the Y position of the actor.
 $A46D LD D,A         ; Stash the new Y position in #REGd.
 $A46E CP $BF         ; {Return if the actor is not off the bottom of the
 $A470 RET C          ; screen (#N$BF).}
 $A471 LD D,$BF       ; Limit the Y position to the bottom of the screen
                      ; (#N$BF).
@label=CalculateNewPosition_HitY
*$A473 SET 1,B        ; Set the top or bottom edge flag (bit 1).
 $A475 RET            ; Return.
; The actor hit the right of the screen.
@label=CalculateNewPosition_HitRight
*$A476 LD A,C         ; Fetch the width of the actor.
 $A477 NEG            ; Negate it to give the X position which puts the actor against the
                      ; right of the screen.
 $A479 LD E,A         ; Stash it in #REGe as the new X position.
 $A47A SET 0,B        ; Set the left or right edge flag (bit 0).
 $A47C RET            ; Return.
; The actor is moving left.
@label=CalculateNewPosition_Left
*$A47D ADD A,(IX+$03) ; Add the X position of the actor.
 $A480 LD E,A         ; Stash the new X position in #REGe.
 $A481 JR C,$A461     ; Jump to #R$A461 if the actor is still on the screen.
 $A483 LD E,$00       ; Limit the X position to the left edge of the screen
                      ; (#N$00).
 $A485 SET 0,B        ; Set the left or right edge flag (bit 0).
 $A487 RET            ; Return.
; The actor is moving up.
@label=CalculateNewPosition_Up
*$A488 ADD A,(IX+$04) ; Add the Y position of the actor.
 $A48B LD D,A         ; Stash the new Y position in #REGd.
 $A48C CP $27         ; {Return if the actor is not off the top of the screen
 $A48E RET NC         ; (the Y position is #N$27 or more).}
 $A48F LD D,$27       ; Limit the Y position to the top of the screen (#N$27).
 $A491 JR $A473       ; Jump to #R$A473 to set the top or bottom edge flag.

; Expire Actor
;
; Used by the routines at #R$9D91, #R$A3C5, #R$A3E0, #R$A4D7 and #R$A54F.
; .
; Counts off an actor which is in a different room to the player. Once it
; has been counted off #N$40 times it is removed.
;
; IX Actor record
@label=ExpireActor
c$A493 INC (IX+$08)    ; Increase the time the actor has spent in another room
                       ; by one.
 $A496 LD A,(IX+$08)   ; Fetch the time the actor has spent in another room.
 $A499 CP $40          ; {Return if the actor has spent less than #N$40 in
 $A49B RET C           ; another room.}
 $A49C LD (IX+$00),$00 ; Empty the record by setting the sprite ID to #N$00.
 $A4A0 RET             ; Return.

; Blow Up Flame
;
; Used by the routine at #R$9D91.
; .
; Blows up a flame which has burnt for its full time. This sets a delay of
; #N$10 in #R$96B4 before another flame can be started and then blows up the
; actor.
;
; IX Flame record
@label=BlowUpFlame
c$A4A1 LD A,$10      ; {Set the flame spawn delay in #R$96B4 to #N$10.
 $A4A3 LD ($96B4),A  ; }

; Blow Up Actor
;
; Used by the routines at #R$9D91, #R$A3C5, #R$A4D7 and #R$A54F.
; .
; Plays an explosion noise, awards points for the actor and starts the
; actor on the sprites for blowing up (sprite IDs #N$08 to #N$0D, which are
; handled by #R$A42A and #R$A43B).
;
; IX Actor record
@label=BlowUpActor
c$A4A6 CALL $BEEE      ; Play the explosion sound.
 $A4A9 CALL $A4B3      ; Award points for the actor.
 $A4AC LD (IX+$00),$08 ; Set the sprite ID of the actor to #N$08
                       ; (#SPRITENAME$08).
 $A4B0 JP $AD5D        ; Jump to #R$AD5D to display the actor.

; Award Actor Points
;
; Used by the routine at #R$A4A6.
; .
; Adds points to the score for blowing up an actor. The points are 100
; plus a value of #N$65, #N$75, #N$85 or #N$95 depending on bits 1-2 of the
; sprite ID, so they are 165, 175, 185 or 195.
;
; IX Actor record
@label=AwardActorPoints
c$A4B3 LD A,(IX+$00) ; Fetch the sprite ID of the actor.
 $A4B6 RLCA          ; {Rotate the sprite ID left three times.
 $A4B7 RLCA          ;
 $A4B8 RLCA          ; }
 $A4B9 AND %00110000 ; Keep only the type of the actor (bits 4-5).
 $A4BB ADD A,$65     ; Add #N$65.
 $A4BD LD C,A        ; Stash the low byte of the points in #REGc.
 $A4BE LD B,$01      ; Set the high byte of the points in #REGb to #N$01.
 $A4C0 JP $B5A9      ; Jump to #R$B5A9 to add the points to the score.

; Face Direction
;
; Used by the routine at #R$A4D7.
; .
; Updates the sprite ID of an actor so that it faces the way it is moving
; and flips its animation frame. Bit 1 of the sprite ID is set when the X
; velocity is positive, and bit 0 of the sprite ID is flipped.
;
; IX Actor record
@label=FaceDirection
c$A4C3 LD A,(IX+$06) ; Fetch the X velocity of the actor.
 $A4C6 RLCA          ; {Rotate the X velocity left twice, so that the direction
 $A4C7 RLCA          ; is in bit 1.}
 $A4C8 AND %00000010 ; Keep only the direction bit (bit 1).
 $A4CA LD C,A        ; Stash the direction bit in #REGc.
 $A4CB LD A,(IX+$00) ; Fetch the sprite ID of the actor.
 $A4CE AND %11111101 ; Keep only bits 0 and 2-7.
 $A4D0 OR C          ; Merge in the direction bit.
 $A4D1 XOR %00000011 ; Flip bits 0 and 1.
 $A4D3 LD (IX+$00),A ; Set the new sprite ID of the actor.
 $A4D6 RET           ; Return.

; Handler: Chasing Nastie
;
; Handles the nastie types which chase the player: the bat (sprite IDs
; #N$68 to #N$6B), the lizard (#N$74 to #N$77) and the snake (#N$78 to #N$7B).
; Every time they are handled the velocity of the nastie is changed by #N$08
; towards the position of the player, up to a maximum of #N$30 in each
; direction (see #R$AFD0).
; .
; The nastie bounces off the edges of the screen, is stopped by objects in the
; room, and is blown up (by #R$A4A6) if it touches the player or if the
; player is not alive.
;
; IX Nastie record
;
; Count off the nastie if it is not in the same room as the player.
@label=HandlerChasingNastie
c$A4D7 LD A,($9703)   ; Fetch the room of the player from #R$9703.
 $A4DA CP (IX+$01)    ; {Jump to #R$A493 if the nastie is in a different room
 $A4DD JR NZ,$A493    ; to the player.}
 $A4DF LD A,$17       ; {Set the width of the nastie in #R$96AD to #N$17.
 $A4E1 LD ($96AD),A   ; }
 $A4E4 CALL $BB0B     ; Remember the previous position of the nastie.
; Blow up the nastie if the player is not alive.
 $A4E7 LD A,($9702)   ; Fetch the sprite ID of the player from #R$9702.
 $A4EA SUB $10        ; Subtract #N$10 (the first Sabreman sprite ID).
 $A4EC CP $20         ; {Jump to #R$A4A6 to blow up the nastie if the player is
 $A4EE JR NC,$A4A6    ; not alive.}
 $A4F0 LD BC,$3008    ; Set the maximum velocity in #REGb to #N$30 and the amount to change
                      ; the velocity by in #REGc to #N$08.
; Change the X velocity towards the player.
 $A4F3 LD A,($9705)   ; Fetch the X position of the player from #R$9705.
 $A4F6 SUB (IX+$03)   ; Subtract the X position of the nastie.
 $A4F9 JR Z,$A506     ; Jump to #R$A506 if the positions are the same, with a velocity of
                      ; zero.
 $A4FB LD A,C         ; Fetch the amount to change the velocity by.
 $A4FC JR NC,$A500    ; Jump to #R$A500 if the player is to the right of the
                      ; nastie.
 $A4FE NEG            ; Negate the amount to change the velocity by.
@label=HandlerChasingNastie_AddX
*$A500 ADD A,(IX+$06) ; Add the X velocity of the nastie.
 $A503 CALL $AFD0     ; Limit the X velocity.
@label=HandlerChasingNastie_StoreX
*$A506 LD (IX+$06),A  ; Set the X velocity of the nastie.
; Change the Y velocity towards the player.
 $A509 LD A,($9706)   ; Fetch the Y position of the player from #R$9706.
 $A50C CP (IX+$04)    ; Compare with the Y position of the nastie.
 $A50F JR Z,$A51C     ; Jump to #R$A51C if the positions are the same (#REGa still holds the
                      ; Y position of the player at this point, and this is what is used as the Y
                      ; velocity).
 $A511 LD A,C         ; Fetch the amount to change the velocity by.
 $A512 JR NC,$A516    ; Jump to #R$A516 if the player is below the nastie.
 $A514 NEG            ; Negate the amount to change the velocity by.
@label=HandlerChasingNastie_AddY
*$A516 ADD A,(IX+$07) ; Add the Y velocity of the nastie.
 $A519 CALL $AFD0     ; Limit the Y velocity.
@label=HandlerChasingNastie_StoreY
*$A51C LD (IX+$07),A  ; Set the Y velocity of the nastie.
; Move the nastie, bouncing it off the edges of the screen.
 $A51F CALL $A4C3     ; Make the nastie face the way it is moving.
 $A522 CALL $A44B     ; Work out the new position of the nastie.
 $A525 BIT 0,B        ; {Jump to #R$A545 if the nastie has hit the left or right edge of the
 $A527 JR NZ,$A545    ; screen.}
 $A529 BIT 1,B        ; {Jump to #R$A54A if the nastie has hit the top or bottom edge of the
 $A52B JR NZ,$A54A    ; screen.}
; This entry point is used by the routines at #R$A545 and #R$A54A.
; .
; Stop the nastie moving through objects in the room.
@label=HandlerChasingNastie_Move
*$A52D LD BC,$1717    ; Set the height and width of the nastie in #REGb and
                      ; #REGc to #N$17.
 $A530 CALL $B81C     ; Stop the nastie passing through objects in the room.
 $A533 LD (IX+$03),E  ; Set the X position of the nastie.
 $A536 LD (IX+$04),D  ; Set the Y position of the nastie.
; Blow up the nastie if it touches the player, otherwise draw it.
 $A539 LD BC,$1313    ; Set the reach used to test whether the nastie is touching the player
                      ; in #REGbc to #N$1313.
 $A53C CALL $AB36     ; Test whether the nastie is touching the player.
 $A53F JP NC,$AD5D    ; Jump to #R$AD5D to display the nastie if it is not touching the
                      ; player.
 $A542 JP $A4A6       ; Jump to #R$A4A6 to blow up the nastie.

; Bounce Nastie Horizontally
;
; Used by the routine at #R$A4D7.
; .
; Reverses the X velocity of a chasing nastie which has hit the left or
; right of the screen.
;
; IX Nastie record
@label=BounceNastieHorizontally
c$A545 CALL $A5A9    ; Reverse the X velocity of the nastie.
 $A548 JR $A52D      ; Jump to #R$A52D.

; Bounce Nastie Vertically
;
; Used by the routine at #R$A4D7.
; .
; Reverses the Y velocity of a chasing nastie which has hit the top or
; bottom of the screen.
;
; IX Nastie record
@label=BounceNastieVertically
c$A54A CALL $A5BA    ; Reverse the Y velocity of the nastie.
 $A54D JR $A52D      ; Jump to #R$A52D.

; Handler: Wandering Nastie
;
; Handles the nastie types which wander about: the spider (sprite IDs
; #N$60 to #N$63), scorpion (#N$64 to #N$67), parrot (#N$6C to #N$6F), monkey
; (#N$70 to #N$73) and all of the nastie types which are only possible later
; in the game (#N$98 to #N$9F and #N$B0 to #N$C3).
; .
; The nastie moves with a velocity chosen by #R$A5CD, which also makes it pause
; for a while. It chooses a new velocity when the timer in #REGix+#N$02 runs
; out or when it is blocked. It bounces off the edges of the screen, is stopped
; by objects in the room, and is blown up (by #R$A4A6) if it touches the player
; or if the player is not alive.
;
; IX Nastie record
;
; Count off the nastie if it is not in the same room as the player.
@label=HandlerWanderingNastie
c$A54F LD A,($9703)  ; Fetch the room of the player from #R$9703.
 $A552 CP (IX+$01)   ; {Jump to #R$A493 if the nastie is in a different room to
 $A555 JP NZ,$A493   ; the player.}
 $A558 LD A,$17      ; {Set the width of the nastie in #R$96AD to #N$17.
 $A55A LD ($96AD),A  ; }
 $A55D CALL $BB0B    ; Remember the previous position of the nastie.
; Blow up the nastie if the player is not alive.
 $A560 LD A,($9702)  ; Fetch the sprite ID of the player from #R$9702.
 $A563 SUB $10       ; Subtract #N$10 (the first Sabreman sprite ID).
 $A565 CP $20        ; {Jump to #R$A4A6 to blow up the nastie if the player is
 $A567 JP NC,$A4A6   ; not alive.}
; Choose a new velocity when the timer has run out.
 $A56A DEC (IX+$02)  ; {Decrease the velocity timer by one and choose a new velocity if it
 $A56D CALL Z,$A5CD  ; has run out.}
; Skip the move if the nastie is not moving.
 $A570 LD A,(IX+$06) ; Fetch the X velocity of the nastie.
 $A573 OR (IX+$07)   ; Combine it with the Y velocity.
 $A576 JR Z,$A59D    ; Jump to #R$A59D if the nastie is not moving.
; Move the nastie, bouncing it off the edges of the screen.
 $A578 CALL $A44B    ; Work out the new position of the nastie.
 $A57B BIT 0,B       ; {Jump to #R$A5C3 if the nastie has hit the left or right edge of the
 $A57D JR NZ,$A5C3   ; screen.}
 $A57F BIT 1,B       ; {Jump to #R$A5C8 if the nastie has hit the top or bottom edge of the
 $A581 JR NZ,$A5C8   ; screen.}
; This entry point is used by the routines at #R$A5C3 and #R$A5C8.
; .
; Stop the nastie moving through objects in the room. If it did not
; manage to move then choose a new velocity.
@label=HandlerWanderingNastie_Move
*$A583 LD BC,$1717   ; Set the height and width of the nastie in #REGb and
                     ; #REGc to #N$17.
 $A586 CALL $B81C    ; Stop the nastie passing through objects in the room.
 $A589 CALL $AAED    ; Test whether the nastie has stayed where it was.
 $A58C CALL Z,$A5CD  ; Choose a new velocity if the nastie has stayed where it
                     ; was.
; Flip the animation frame and store the new position.
 $A58F LD A,(IX+$00) ; Fetch the sprite ID of the nastie.
 $A592 XOR %00000001 ; Flip bit 0.
 $A594 LD (IX+$00),A ; Set the new sprite ID of the nastie.
 $A597 LD (IX+$03),E ; Set the X position of the nastie.
 $A59A LD (IX+$04),D ; Set the Y position of the nastie.
; Blow up the nastie if it touches the player, otherwise draw it.
@label=HandlerWanderingNastie_Touch
*$A59D LD BC,$1313   ; Set the reach used to test whether the nastie is touching the player
                     ; in #REGbc to #N$1313.
 $A5A0 CALL $AB36    ; Test whether the nastie is touching the player.
 $A5A3 JP NC,$AD5D   ; Jump to #R$AD5D to display the nastie if it is not touching the
                     ; player.
 $A5A6 JP $A4A6      ; Jump to #R$A4A6 to blow up the nastie.

; Reverse X Velocity
;
; Used by the routines at #R$9E04, #R$A545 and #R$A5C3.
; .
; Reverses the X velocity of an actor and flips bit 1 of its sprite ID,
; so that it faces the other way.
;
; IX Actor record
@label=ReverseXVelocity
c$A5A9 LD A,(IX+$06) ; Fetch the X velocity of the actor.
 $A5AC NEG           ; Reverse the X velocity.
 $A5AE LD (IX+$06),A ; Set the new X velocity of the actor.
 $A5B1 LD A,(IX+$00) ; Fetch the sprite ID of the actor.
 $A5B4 XOR %00000010 ; Flip bit 1 (the direction the actor is facing).
 $A5B6 LD (IX+$00),A ; Set the new sprite ID of the actor.
 $A5B9 RET           ; Return.

; Reverse Y Velocity
;
; Used by the routines at #R$9E09, #R$A54A and #R$A5C8.
; .
; Reverses the Y velocity of an actor.
;
; IX Actor record
@label=ReverseYVelocity
c$A5BA LD A,(IX+$07) ; Fetch the Y velocity of the actor.
 $A5BD NEG           ; Reverse the Y velocity.
 $A5BF LD (IX+$07),A ; Set the new Y velocity of the actor.
 $A5C2 RET           ; Return.

; Bounce Wandering Nastie Horizontally
;
; Used by the routine at #R$A54F.
; .
; Reverses the X velocity of a wandering nastie which has hit the left
; or right of the screen.
;
; IX Nastie record
@label=BounceWanderingNastieHorizontally
c$A5C3 CALL $A5A9    ; Reverse the X velocity of the nastie.
 $A5C6 JR $A583      ; Jump to #R$A583.

; Bounce Wandering Nastie Vertically
;
; Used by the routine at #R$A54F.
; .
; Reverses the Y velocity of a wandering nastie which has hit the top or
; bottom of the screen.
;
; IX Nastie record
@label=BounceWanderingNastieVertically
c$A5C8 CALL $A5BA    ; Reverse the Y velocity of the nastie.
 $A5CB JR $A583      ; Jump to #R$A583.

; Choose Velocity
;
; Used by the routines at #R$A3E0 and #R$A54F.
; .
; Chooses the velocity for a wandering actor. If it is moving then it is
; stopped (by #R$A609). If it has stopped then it is given a random X velocity
; and a random Y velocity from #R$A601, and the sprite is made to face the way
; it is going.
;
; IX Actor record
@label=ChooseVelocity
c$A5CD LD A,(IX+$06)  ; Fetch the X velocity of the actor.
 $A5D0 OR (IX+$07)    ; Combine it with the Y velocity.
 $A5D3 JR NZ,$A609    ; Jump to #R$A609 to stop the actor if it is moving.
; Choose the X velocity.
 $A5D5 LD A,($9695)   ; Fetch the random seed from #R$9695.
 $A5D8 AND %00000111  ; Keep only bits 0-2.
 $A5DA LD L,A         ; Stash the velocity index in #REGl.
 $A5DB LD H,$00       ; Clear #REGh.
 $A5DD LD BC,$A601    ; Point #REGbc at the table of velocities at #R$A601.
 $A5E0 ADD HL,BC      ; Add the table address to get the address of the
                      ; velocity.
 $A5E1 LD A,(HL)      ; Fetch the velocity from the table.
 $A5E2 LD (IX+$06),A  ; Set the X velocity of the actor.
 $A5E5 BIT 7,A        ; {Jump to #R$A5FB if the actor is moving right.
 $A5E7 JR Z,$A5FB     ; }
 $A5E9 RES 1,(IX+$00) ; Reset bit 1 of the sprite ID so that the actor faces
                      ; left.
; Choose the Y velocity.
@label=ChooseVelocity_Y
*$A5ED LD A,($5C78)   ; Fetch the low byte of #SKOOLKID$5C78(FRAMES).
 $A5F0 AND %00000111  ; Keep only bits 0-2.
 $A5F2 LD L,A         ; Stash the velocity index in #REGl.
 $A5F3 LD H,$00       ; Clear #REGh.
 $A5F5 ADD HL,BC      ; Add the table address to get the address of the
                      ; velocity.
 $A5F6 LD A,(HL)      ; Fetch the velocity from the table.
 $A5F7 LD (IX+$07),A  ; Set the Y velocity of the actor.
 $A5FA RET            ; Return.
; The actor is moving to the right.
@label=ChooseVelocity_Right
*$A5FB SET 1,(IX+$00) ; Set bit 1 of the sprite ID so that the actor faces
                      ; right.
 $A5FF JR $A5ED       ; Jump to #R$A5ED to choose the Y velocity.

; Velocity Table
;
; The velocities which can be chosen by #R$A5CD, in sixteenths of a
; pixel. Four of them are negative (up or left) and four are positive (down or
; right).
@label=VelocityTable
b$A601 DEFB $A0      ; {Negative velocities.
 $A602 DEFB $B0      ;
 $A603 DEFB $C0      ;
 $A604 DEFB $D0      ; }
 $A605 DEFB $30      ; {Positive velocities.
 $A606 DEFB $40      ;
 $A607 DEFB $50      ;
 $A608 DEFB $60      ; }

; Stop Actor
;
; Used by the routine at #R$A5CD.
; .
; Stops an actor moving and sets its timer to a random value between #N$08
; and #N$0F, which is how long it stays still for.
;
; IX Actor record
@label=StopActor
c$A609 XOR A         ; {Stop the actor by clearing its X and Y velocities.
 $A60A LD (IX+$06),A ;
 $A60D LD (IX+$07),A ; }
 $A610 LD A,($9695)  ; Fetch the random seed from #R$9695.
 $A613 AND %00000111 ; Keep only bits 0-2.
 $A615 OR %00001000  ; Set bit 3.
 $A617 LD (IX+$02),A ; Set the velocity timer of the actor.
 $A61A RET           ; Return.

; Handler: Stand Up (After Yellow Orchid)
;
; Handles the player while they are lying down after touching a yellow
; orchid (sprite IDs #N$43 and #N$47, see #R$AE8F). Once the orchid effect
; timer in #R$96B0 has run out the player is turned back into a walking
; Sabreman (sprite IDs #N$10 to #N$17).
;
; IX Actor record of the player
@label=HandlerYellowOrchid_StandUp
c$A61B CALL $BB0B    ; Remember the previous position of the player.
; This entry point is used by the routine at #R$AE8F.
@label=HandlerYellowOrchid_StandUp_CountDown
*$A61E CALL $AE7A    ; Count down the orchid effect.
 $A621 JR NZ,$A62D   ; Jump to #R$A62D if the orchid effect has not yet run
                     ; out.
 $A623 LD A,(IX+$00) ; Fetch the sprite ID of the player.
 $A626 AND %00000111 ; Keep only bits 0-2.
 $A628 OR %00010000  ; Set bit 4, giving a Sabreman sprite ID of #N$10 to
                     ; #N$17.
 $A62A LD (IX+$00),A ; Set the new sprite ID of the player.
@label=HandlerYellowOrchid_StandUp_Skip
*$A62D JP $AF7A      ; Jump to #R$AF7A.

; Bring Actor Closer
;
; Used by the routines at #R$9EB3 and #R$AB74.
; .
; Moves an actor which is two or more rows of rooms away from the player
; to a room in the row above or below the player (never the player's own room),
; placing it at the position in #R$D6A6 for the layout of the new room. Half
; of the time it is moved to the row above, and half of the time to the row
; below.
;
; IX Actor record
@label=BringActorCloser
c$A630 LD A,($9703)  ; Fetch the room of the player from #R$9703.
 $A633 CP (IX+$01)   ; Compare with the room of the actor.
 $A636 RET Z         ; Return if the actor is in the same room as the player.
 $A637 LD B,A        ; Stash the room of the player in #REGb.
; Work out how many rows of rooms are between the player and the actor.
 $A638 RRCA          ; {Rotate the room of the player right four times.
 $A639 RRCA          ;
 $A63A RRCA          ;
 $A63B RRCA          ; }
 $A63C AND %00001111 ; Keep only bits 0-3.
 $A63E LD C,A        ; Stash the row of the player in #REGc.
 $A63F LD A,(IX+$01) ; Fetch the room of the actor.
 $A642 RRCA          ; {Rotate the room of the actor right four times.
 $A643 RRCA          ;
 $A644 RRCA          ;
 $A645 RRCA          ; }
 $A646 AND %00001111 ; Keep only bits 0-3.
 $A648 SUB C         ; Subtract the row of the player to get the number of rows between
                     ; them.
 $A649 JP P,$A64E    ; Jump to #R$A64E if the number of rows is positive.
 $A64C NEG           ; Make the number of rows positive.
@label=BringActorCloser_Distance
*$A64E CP $02        ; Compare with #N$02.
 $A650 RET C         ; Return if the actor is less than two rows away.
; Choose the row above or below the player at random.
 $A651 LD A,($9695)  ; Fetch the random seed from #R$9695.
 $A654 AND %00000001 ; Keep only bit 0.
 $A656 JR NZ,$A678   ; Jump to #R$A678 to use the row below the player if bit 0
                     ; is set.
 $A658 LD A,B        ; Fetch the room of the player.
 $A659 SUB $10       ; Subtract #N$10 to get the room above.
; This entry point is used by the routine at #R$A678.
@label=BringActorCloser_CheckRoom
*$A65B JR C,$A67D    ; Jump to #R$A67D if there is no room above.
; This entry point is used by the routine at #R$A67D.
@label=BringActorCloser_Room
*$A65D AND %11111100 ; Keep only bits 2-7 (the row, and the column in groups of
                     ; four).
 $A65F LD C,A        ; Stash the result in #REGc.
 $A660 LD A,(IX+$01) ; Fetch the room of the actor.
 $A663 AND %00000011 ; Keep only bits 0-1.
 $A665 OR C          ; Merge in the new room.
 $A666 CP B          ; Compare with the room of the player.
 $A667 RET Z         ; Return if the new room is the room of the player.
; Put the actor in the new room.
 $A668 LD (IX+$01),A ; Set the new room of the actor.
 $A66B CALL $A7D4    ; Find the position of the actor in the new room.
 $A66E LD A,(HL)     ; Fetch the X position from the table.
 $A66F LD (IX+$03),A ; Set the X position of the actor.
 $A672 INC HL        ; Move onto the Y position.
 $A673 LD A,(HL)     ; Fetch the Y position from the table.
 $A674 LD (IX+$04),A ; Set the Y position of the actor.
 $A677 RET           ; Return.

; Choose Room Below
;
; Used by the routine at #R$A630.
; .
; Chooses the room below the player for #R$A630.
;
; B Room of the player
@label=ChooseRoomBelow
c$A678 LD A,B        ; Fetch the room of the player.
 $A679 ADD A,$10     ; Add #N$10 to get the room below.
 $A67B JR $A65B      ; Jump to #R$A65B.

; Choose Player Room
;
; Used by the routine at #R$A630.
; .
; Used by #R$A630 when there is no room above or below the player, so
; the room of the player is used instead.
;
; B Room of the player
@label=ChoosePlayerRoom
c$A67D LD A,B        ; Fetch the room of the player.
 $A67E JR $A65D      ; Jump to #R$A65D.

; Handler: Orchid
;
; Handles an orchid (sprite IDs #N$48 to #N$4F). An orchid goes through a
; cycle of growing, staying in bloom for a short time, shrinking and then
; staying hidden for a while. The lowest three bits of the sprite ID are the
; stage of growth and a timer in #REGix+#N$06 and #REGix+#N$07 counts down how
; long it is before the next change (see #R$A6D4). The timer only counts down
; while the player is alive and the game delay timer in #R$96B5 is zero.
; .
; Once the orchid has finished growing it can be touched by the player (see
; #R$A737). The stem of the orchid is coloured bright green and the flower is
; coloured with the colour of the orchid.
;
; IX Actor record of the orchid
@label=HandlerOrchid
c$A680 CALL $BB0B    ; Remember the previous position of the orchid.
 $A683 LD L,(IX+$06) ; {Fetch the timer of the orchid.
 $A686 LD H,(IX+$07) ; }
 $A689 LD A,H        ; {Jump to #R$A6D4 to change the stage of the orchid if the timer is
 $A68A OR L          ; zero.
 $A68B JR Z,$A6D4    ; }
; Count down the timer if the player is alive and the game delay is over.
 $A68D LD A,($9702)  ; Fetch the sprite ID of the player from #R$9702.
 $A690 SUB $10       ; Subtract #N$10 (the first Sabreman sprite ID).
 $A692 CP $20        ; {Jump to #R$A69D if the player is not alive.
 $A694 JR NC,$A69D   ; }
 $A696 LD A,($96B5)  ; Fetch the start-of-turn delay from #R$96B5.
 $A699 AND A         ; Set the flags.
 $A69A JR NZ,$A69D   ; Jump to #R$A69D if the start-of-turn delay is still
                     ; running.
 $A69C DEC HL        ; Decrease the timer by one.
; This entry point is used by the routine at #R$A70D.
@label=HandlerOrchid_StoreTimer
*$A69D LD (IX+$06),L ; {Store the timer of the orchid.
 $A6A0 LD (IX+$07),H ; }
 $A6A3 CALL $A737    ; Test whether the player is touching the orchid.
; This entry point is used by the routines at #R$A6D4 and #R$A70D.
@label=HandlerOrchid_Draw
*$A6A6 CALL $B9A9    ; Display the orchid.
; Colour the stem of the orchid.
 $A6A9 LD L,(IX+$03) ; {Fetch the X and Y position of the orchid.
 $A6AC LD H,(IX+$04) ; }
 $A6AF CALL $B8DD    ; Find the attribute address of the orchid.
 $A6B2 LD C,$01      ; Set the number of rows in #REGc to #N$01.
 $A6B4 LD D,$44      ; Set the colour in #REGd to #N$44 (bright green).
 $A6B6 LD B,$02      ; Set the number of columns in #REGb to #N$02.
 $A6B8 CALL $A6C8    ; Colour the stem of the orchid.
; Colour the flower if the orchid has started to grow.
 $A6BB LD A,(IX+$00) ; Fetch the sprite ID of the orchid.
 $A6BE AND %00000111 ; Keep only the stage of growth (bits 0-2).
 $A6C0 RET Z         ; Return if the orchid is hidden.
 $A6C1 LD C,$01      ; Set the number of rows in #REGc to #N$01.
 $A6C3 LD D,(IX+$05) ; Fetch the colour of the orchid into #REGd.
 $A6C6 LD B,$02      ; Set the number of columns in #REGb to #N$02.
; The orchid is one column wider when it is not fully grown.
@label=HandlerOrchid_Colour
*$A6C8 LD A,(IX+$00) ; Fetch the sprite ID of the orchid.
 $A6CB CPL           ; Flip the bits, so that a fully grown orchid gives zero.
 $A6CC AND %00000111 ; Keep only bits 0-2.
 $A6CE JR NZ,$A6D1   ; Jump to #R$A6D1 if the orchid is not fully grown.
 $A6D0 INC B         ; Add one to the number of columns.
@label=HandlerOrchid_ColourRows
*$A6D1 JP $BB45      ; Jump to #R$BB45 to colour the rows.

; Change Orchid Stage
;
; Used by the routine at #R$A680.
; .
; Called when the timer of an orchid has run out. Every other frame the
; growth stage of the orchid (the lowest three bits of the sprite ID) is moved
; on by one. Whether it grows or shrinks depends on bit 3 of #REGix+#N$02.
; When it has finished growing the timer is set to #N$10, and when it has
; finished shrinking a new colour is chosen and the timer is set to a random
; value between #N$80 and #N$BF.
;
; IX Actor record of the orchid
@label=ChangeOrchidStage
c$A6D4 LD A,($9693)  ; Fetch the low byte of the game timer from #R$9693.
 $A6D7 AND %00000001 ; Keep only bit 0.
 $A6D9 JR NZ,$A6A6   ; Jump to #R$A6A6 to just display the orchid if bit 0 is
                     ; set.
 $A6DB LD A,(IX+$02) ; Fetch the direction of growth of the orchid.
 $A6DE AND A         ; Set the flags.
 $A6DF JR Z,$A70D    ; Jump to #R$A70D if the orchid is growing.
; The orchid is shrinking.
 $A6E1 DEC (IX+$00)  ; Move the orchid back to the previous stage of growth.
 $A6E4 LD A,(IX+$00) ; Fetch the sprite ID of the orchid.
 $A6E7 AND %00000111 ; Keep only bits 0-2.
 $A6E9 JR NZ,$A6A6   ; Jump to #R$A6A6 if the orchid has not finished
                     ; shrinking.
; The orchid has gone, so choose a new colour for the next time.
 $A6EB LD A,($5C78)  ; Fetch the low byte of #SKOOLKID$5C78(FRAMES).
 $A6EE AND %00001111 ; Keep only bits 0-3.
 $A6F0 LD L,A        ; Stash the colour index in #REGl.
 $A6F1 LD H,$00      ; Clear #REGh.
 $A6F3 LD BC,$A6FD   ; Point #REGbc at the table of orchid colours at #R$A6FD.
 $A6F6 ADD HL,BC     ; Add the table address to get the address of the colour.
 $A6F7 LD A,(HL)     ; Fetch the colour from the table.
 $A6F8 LD (IX+$05),A ; Set the colour of the orchid.
 $A6FB JR $A71A      ; Jump to #R$A71A to swap the direction of growth.

; Orchid Colours
;
; The colours which an orchid can have, chosen at random by #R$A6D4. The
; colours are bright red, magenta, cyan, yellow and white. White (#N$47) is
; more likely than the others.
@label=OrchidColour
b$A6FD DEFB $42      ; #COLOUR(#PEEK(#PC)).
 $A6FE DEFB $43      ; #COLOUR(#PEEK(#PC)).
 $A6FF DEFB $45      ; #COLOUR(#PEEK(#PC)).
 $A700 DEFB $46      ; #COLOUR(#PEEK(#PC)).
 $A701 DEFB $43      ; #COLOUR(#PEEK(#PC)).
 $A702 DEFB $45      ; #COLOUR(#PEEK(#PC)).
 $A703 DEFB $46      ; #COLOUR(#PEEK(#PC)).
 $A704 DEFB $42      ; #COLOUR(#PEEK(#PC)).
 $A705 DEFB $45      ; #COLOUR(#PEEK(#PC)).
 $A706 DEFB $46      ; #COLOUR(#PEEK(#PC)).
 $A707 DEFB $42      ; #COLOUR(#PEEK(#PC)).
 $A708 DEFB $43      ; #COLOUR(#PEEK(#PC)).
 $A709 DEFB $47      ; #COLOUR(#PEEK(#PC)).
 $A70A DEFB $47      ; #COLOUR(#PEEK(#PC)).
 $A70B DEFB $47      ; #COLOUR(#PEEK(#PC)).
 $A70C DEFB $47      ; #COLOUR(#PEEK(#PC)).

; Grow Orchid
;
; Used by the routine at #R$A6D4.
; .
; Moves a growing orchid on to the next stage. When it is fully grown
; (the lowest three bits of the sprite ID are all set) the direction of
; growth is changed (see #R$A71A). Otherwise the orchid is just drawn.
;
; IX Actor record of the orchid
@label=GrowOrchid
c$A70D INC (IX+$00)  ; Move the orchid on to the next stage of growth.
 $A710 LD A,(IX+$00) ; Fetch the sprite ID of the orchid.
 $A713 CPL           ; Flip the bits, so that a fully grown orchid gives zero.
 $A714 AND %00000111 ; Keep only bits 0-2.
 $A716 JR Z,$A71A    ; Jump to #R$A71A if the orchid is fully grown.
 $A718 JR $A6A6      ; Jump to #R$A6A6 to display the orchid.
; This entry point is used by the routine at #R$A6D4.
; .
; Swap between growing and shrinking and set the timer.
@label=GrowOrchid_Swap
*$A71A LD A,(IX+$02) ; Fetch the direction of growth of the orchid.
 $A71D XOR %00001000 ; Flip bit 3 to swap between growing and shrinking.
 $A71F LD (IX+$02),A ; Set the new direction of growth of the orchid.
 $A722 JR NZ,$A731   ; Jump to #R$A731 if the orchid is now shrinking.
; The orchid has finished shrinking, so it stays hidden for #N$80 to #N$BF
; frames.
 $A724 LD A,($5C78)  ; Fetch the low byte of #SKOOLKID$5C78(FRAMES).
 $A727 AND %00111111 ; Keep only bits 0-5.
 $A729 ADD A,$80     ; Add #N$80.
 $A72B LD L,A        ; Stash the hidden time in #REGl.
 $A72C LD H,$00      ; Clear #REGh.
 $A72E JP $A69D      ; Jump to #R$A69D to store the hidden time as the timer.
; The orchid has finished growing, so it stays in bloom for #N$10 frames.
@label=GrowOrchid_Bloom
*$A731 LD HL,$0010   ; Set the time the orchid stays in bloom in #REGhl to
                     ; #N$0010.
 $A734 JP $A69D      ; Jump to #R$A69D to store the bloom time as the timer.

; Test Orchid Touched
;
; Used by the routine at #R$A680.
; .
; Tests whether the player is touching an orchid which is fully grown.
; If so then the orchid shrinks away (its timer is zeroed), the effect timer in
; #R$96B0 is started and the player takes on the colour of the orchid. If the
; orchid is white (#N$47) then the effect timer is reset instead, which
; removes any effect. A low tone is played.
;
; IX Actor record of the orchid
@label=TestOrchidTouched
c$A737 LD A,(IX+$00) ; Fetch the sprite ID of the orchid.
 $A73A CPL           ; Flip the bits, so that a fully grown orchid gives zero.
 $A73B AND %00000111 ; Keep only bits 0-2.
 $A73D RET NZ        ; Return if the orchid is not fully grown.
 $A73E LD BC,$0F0F   ; Set the reach used to test whether the player is touching the orchid
                     ; in #REGbc to #N$0F0F.
 $A741 CALL $AB01    ; Test whether the player is touching the orchid.
 $A744 RET NC        ; Return if the player is not touching the orchid.
 $A745 LD A,$C0      ; {Set the orchid effect timer in #R$96B0 to #N$C0.
 $A747 LD ($96B0),A  ; }
 $A74A XOR A         ; Clear #REGa.
 $A74B LD (IX+$06),A ; Clear the low byte of the timer of the orchid.
 $A74E LD (IX+$07),A ; Clear the high byte of the timer of the orchid.
 $A751 LD A,(IX+$05) ; Fetch the colour of the orchid.
 $A754 LD ($9707),A  ; Set the colour of the player to the colour of the
                     ; orchid.
 $A757 CP $47        ; {Jump to #R$BF2A to play the low tone if the orchid is
 $A759 JP NZ,$BF2A   ; not white.}
 $A75C XOR A         ; {Clear the orchid effect timer in #R$96B0, as a white orchid has no
 $A75D LD ($96B0),A  ; effect.}
 $A760 JP $BF2A      ; Jump to #R$BF2A to play the low tone.

; Load Orchid
;
; Used by the routines at #R$B1D4 and #R$BBAE.
; .
; Sets up the orchid for the room the player is in, using the state of the
; orchid held in #R$A7F8 and its position in #R$D6A6. The record is built in
; #R$97DA. This is the opposite of #R$A79F.
;
; IX Actor record of the player
@label=LoadOrchid
c$A763 LD A,(IX+$01) ; Fetch the room of the player.
 $A766 CALL $A7E8    ; Find the state of the orchid for the room.
 $A769 LD DE,$97DA   ; Point #REGde at the orchid's actor record at #R$97DA.
 $A76C LD C,(HL)     ; {Fetch the state of the orchid from the table into #REGc
 $A76D INC HL        ; and #REGb.
 $A76E LD B,(HL)     ; }
 $A76F LD A,C        ; Copy the first byte of the state to #REGa.
 $A770 AND %00000111 ; Keep only the stage of growth (bits 0-2).
 $A772 OR %01001000  ; Set bits 3 and 6, giving a sprite ID of #N$48 to #N$4F.
 $A774 LD (DE),A     ; Set the sprite ID of the orchid.
 $A775 INC DE        ; Move onto the room of the orchid.
 $A776 LD A,(IX+$01) ; Fetch the room of the player.
 $A779 LD (DE),A     ; Set the room of the orchid.
 $A77A INC DE        ; Move onto the direction of growth of the orchid.
 $A77B LD A,C        ; Copy the first byte of the state to #REGa.
 $A77C AND %00001000 ; Keep only the direction of growth (bit 3).
 $A77E LD (DE),A     ; Set the direction of growth of the orchid.
 $A77F INC DE        ; Move onto the X position of the orchid.
 $A780 CALL $A7D4    ; Find the position of the orchid for the room.
 $A783 LD A,(HL)     ; Fetch the X position of the orchid.
 $A784 INC HL        ; Move onto the Y position.
 $A785 LD (DE),A     ; Set the X position of the orchid.
 $A786 INC DE        ; Move onto the Y position of the orchid.
 $A787 LD A,(HL)     ; Fetch the Y position of the orchid.
 $A788 LD (DE),A     ; Set the Y position of the orchid.
 $A789 INC DE        ; Move onto the colour of the orchid.
 $A78A LD A,B        ; Copy the second byte of the state to #REGa.
 $A78B AND %00000111 ; Keep only the colour (bits 0-2).
 $A78D OR %01000000  ; Set bit 6 (bright).
 $A78F LD (DE),A     ; Set the colour of the orchid.
 $A790 INC DE        ; Move onto the timer of the orchid.
 $A791 LD A,B        ; Copy the second byte of the state to #REGa.
 $A792 AND %11111000 ; Keep only the low bits of the timer (bits 3-7).
 $A794 LD (DE),A     ; Set the low byte of the timer of the orchid.
 $A795 INC DE        ; Move onto the high byte of the timer.
 $A796 LD A,C        ; Copy the first byte of the state to #REGa.
 $A797 RRCA          ; {Rotate the first byte of the state right four times.
 $A798 RRCA          ;
 $A799 RRCA          ;
 $A79A RRCA          ; }
 $A79B AND %00001111 ; Keep only the high bits of the timer (bits 0-3).
 $A79D LD (DE),A     ; Set the high byte of the timer of the orchid.
 $A79E RET           ; Return.

; Save Orchid
;
; Used by the routine at #R$BBAE.
; .
; Stores the state of the orchid in #R$97DA back into the table in
; #R$A7F8, for the room which it was in (held in #R$96AB), so that it is as it
; was left when the player returns to the room. This is the opposite of
; #R$A763.
@label=SaveOrchid
c$A79F LD A,($96AB)  ; Fetch the room of the orchid from #R$96AB.
 $A7A2 CALL $A7E8    ; Find the state of the orchid for the room.
 $A7A5 PUSH IX       ; Stash the actor pointer on the stack.
 $A7A7 LD IX,$97DA   ; Point #REGix at the orchid's actor record at #R$97DA.
 $A7AB LD A,(IX+$00) ; Fetch the sprite ID of the orchid.
 $A7AE AND %00000111 ; Keep only the stage of growth (bits 0-2).
 $A7B0 LD C,A        ; Stash the stage of growth in #REGc.
 $A7B1 LD A,(IX+$02) ; Fetch the direction of growth of the orchid.
 $A7B4 AND %00001000 ; Keep only the direction of growth (bit 3).
 $A7B6 OR C          ; Merge in the stage of growth.
 $A7B7 LD C,A        ; Stash the stage and direction of growth in #REGc.
 $A7B8 LD A,(IX+$07) ; Fetch the high byte of the timer of the orchid.
 $A7BB RLCA          ; {Rotate the high byte of the timer left four times.
 $A7BC RLCA          ;
 $A7BD RLCA          ;
 $A7BE RLCA          ; }
 $A7BF AND %11110000 ; Keep only bits 4-7.
 $A7C1 OR C          ; Merge in the stage and direction of growth.
 $A7C2 LD (HL),A     ; Store the first byte of the state in the table.
 $A7C3 INC HL        ; Move onto the second byte of the state.
 $A7C4 LD A,(IX+$05) ; Fetch the colour of the orchid.
 $A7C7 AND %00000111 ; Keep only the colour (bits 0-2).
 $A7C9 LD B,A        ; Stash the colour in #REGb.
 $A7CA LD A,(IX+$06) ; Fetch the low byte of the timer of the orchid.
 $A7CD AND %11111000 ; Keep only the low bits of the timer (bits 3-7).
 $A7CF OR B          ; Merge in the colour.
 $A7D0 LD (HL),A     ; Store the second byte of the state in the table.
 $A7D1 POP IX        ; Restore the actor pointer from the stack.
 $A7D3 RET           ; Return.

; Find Orchid Position
;
; Used by the routines at #R$A630 and #R$A763.
; .
; Finds the entry in #R$D6A6 for the layout of the room an actor is in.
;
;   IX Actor record
; O:HL Address of the X and Y position of the orchid
@label=HandlerOrchidPosition
c$A7D4 PUSH BC       ; Stash #REGbc on the stack.
; Fetch the layout of the room.
 $A7D5 LD L,(IX+$01) ; Fetch the room of the actor.
 $A7D8 LD H,$00      ; Clear #REGh.
 $A7DA LD BC,$6066   ; Point #REGbc at the layout table at #R$6066.
 $A7DD ADD HL,BC     ; Add the layout table address to get the address of the layout number
                     ; for the room.
; Fetch the orchid position for the layout.
 $A7DE LD L,(HL)     ; Fetch the layout number of the room.
 $A7DF LD H,$00      ; Clear #REGh.
 $A7E1 ADD HL,HL     ; Double the layout number, as there are two bytes of position for
                     ; each layout.
 $A7E2 LD BC,$D6A6   ; Point #REGbc at the table of orchid positions at
                     ; #R$D6A6.
 $A7E5 ADD HL,BC     ; Add the table address to get the address of the position for the
                     ; layout.
 $A7E6 POP BC        ; Restore #REGbc from the stack.
 $A7E7 RET           ; Return.

; Find Orchid State
;
; Used by the routines at #R$A763 and #R$A79F.
; .
; Finds the entry in #R$A7F8 for the layout of a room.
;
;   A Room
; O:HL Address of the state of the orchid
;
; Fetch the layout of the room.
@label=HandlerOrchidType
c$A7E8 LD L,A        ; {Use the room as the offset into the layout table.
 $A7E9 LD H,$00      ; }
 $A7EB LD BC,$6066   ; Point #REGbc at the layout table at #R$6066.
 $A7EE ADD HL,BC     ; Add the layout table address to get the address of the layout number
                     ; for the room.
; Fetch the state of the orchid for the layout.
 $A7EF LD L,(HL)     ; Fetch the layout number of the room.
 $A7F0 LD H,$00      ; Clear #REGh.
 $A7F2 ADD HL,HL     ; Double the layout number, as there are two bytes of state for each
                     ; layout.
 $A7F3 LD BC,$A7F8   ; Point #REGbc at the table of orchid states at #R$A7F8.
 $A7F6 ADD HL,BC     ; Add the table address to get the address of the state for the
                     ; layout.
 $A7F7 RET           ; Return.

; Table: Orchid Types
;
; The state of the orchid for each of the #N$30 room layouts, held as two
; bytes. This is the state when the game starts, and is updated by #R$A79F
; as the player moves between rooms.
; #TABLE(default,centre,left)
; { =h Byte | =h Bits | =h Contents }
; { #N$00 | 0-2 | The stage of growth }
; { | 3 | The direction of growth (set when the orchid is shrinking) }
; { | 4-7 | The high byte of the timer }
; { #N$01 | 0-2 | The colour }
; { | 3-7 | The low byte of the timer }
; TABLE#
@label=TableOrchidTypes
b$A7F8 DEFB $00,$02
 $A7FA DEFB $0F,$03
 $A7FC DEFB $00,$05
 $A7FE DEFB $0F,$06
 $A800 DEFB $00,$02
 $A802 DEFB $0F,$03
 $A804 DEFB $00,$05
 $A806 DEFB $0F,$06
 $A808 DEFB $00,$02
 $A80A DEFB $0F,$03
 $A80C DEFB $00,$05
 $A80E DEFB $0F,$06
 $A810 DEFB $00,$02
 $A812 DEFB $0F,$03
 $A814 DEFB $00,$05
 $A816 DEFB $0F,$06
 $A818 DEFB $00,$02
 $A81A DEFB $0F,$03
 $A81C DEFB $00,$05
 $A81E DEFB $0F,$06
 $A820 DEFB $00,$02
 $A822 DEFB $0F,$03
 $A824 DEFB $00,$05
 $A826 DEFB $0F,$06
 $A828 DEFB $00,$02
 $A82A DEFB $0F,$03
 $A82C DEFB $00,$05
 $A82E DEFB $0F,$06
 $A830 DEFB $00,$02
 $A832 DEFB $0F,$03
 $A834 DEFB $00,$05
 $A836 DEFB $0F,$06
 $A838 DEFB $00,$02
 $A83A DEFB $0F,$03
 $A83C DEFB $00,$05
 $A83E DEFB $0F,$06
 $A840 DEFB $00,$02
 $A842 DEFB $0F,$03
 $A844 DEFB $00,$05
 $A846 DEFB $0F,$06
 $A848 DEFB $00,$02
 $A84A DEFB $0F,$03
 $A84C DEFB $00,$05
 $A84E DEFB $0F,$06
 $A850 DEFB $00,$02
 $A852 DEFB $0F,$03
 $A854 DEFB $00,$05
 $A856 DEFB $0F,$06

; Handler: Wulf
;
; Handles the Sabre Wulf (sprite IDs #N$50 to #N$57) when it is
; running. Bit 2 of the sprite ID is set when the Wulf is facing right.
; .
; Each time the Wulf is handled it animates, works out whether to head for
; the player (see #R$A922) or pounce at them (see #R$A8B2), moves with its
; velocity (see #R$AFE8), turns around if it was blocked and then hurts the
; player if it is touching them.
;
; IX Actor record of the Wulf
@label=HandlerWulf
c$A858 CALL $BB0B    ; Remember the previous position of the Wulf.
 $A85B LD A,$20      ; {Set the width of the Wulf in #R$96AD to #N$20.
 $A85D LD ($96AD),A  ; }
 $A860 CALL $AC0E    ; Animate the Wulf.
 $A863 CALL $A922    ; Choose the direction of the Wulf.
 $A866 CALL $A8B2    ; Test whether the Wulf should pounce.
; This entry point is used by the routine at #R$A964.
@label=HandlerWulf_Move
*$A869 CALL $AFE8    ; Work out the new position of the Wulf.
; Stop the Wulf moving through objects in the room. If it did not manage
; to move then turn it around.
 $A86C LD BC,$171F   ; Set the height of the Wulf in #REGb to #N$17 and the width in #REGc
                     ; to #N$1F.
 $A86F CALL $B81C    ; Stop the Wulf passing through objects in the room.
 $A872 CALL $AAED    ; Test whether the Wulf has stayed where it was.
 $A875 JR NZ,$A87A   ; Jump to #R$A87A if the Wulf has moved.
 $A877 CALL $ADB3    ; Turn the Wulf around.
@label=HandlerWulf_Position
*$A87A LD (IX+$03),E ; Set the X position of the Wulf.
 $A87D LD (IX+$04),D ; Set the Y position of the Wulf.
; This entry point is used by the routine at #R$A8F5.
; .
; The Wulf can only hurt the player if the player is in the same room and
; has the normal colour.
@label=HandlerWulf_Touch
*$A880 LD A,($9707)  ; Fetch the colour of the player from #R$9707.
 $A883 CP $47        ; {Jump to #R$A8AF if the player does not have the normal colour
 $A885 JR NZ,$A8AF   ; (#COLOUR$47).}
 $A887 LD A,($9703)  ; Fetch the room of the player from #R$9703.
 $A88A CP (IX+$01)   ; {Jump to #R$A8AF if the Wulf is in a different room to
 $A88D JR NZ,$A8AF   ; the player.}
 $A88F LD BC,$0F1C   ; Set the reach used to test whether the Wulf is touching the player
                     ; in #REGbc to #N$0F1C.
 $A892 CALL $AB01    ; Test whether the Wulf is touching the player.
 $A895 JR NC,$A8AF   ; Jump to #R$A8AF if the Wulf is not touching the player.
; Knock the player in the direction the Wulf is facing.
 $A897 LD A,(IX+$00) ; Fetch the sprite ID of the Wulf.
 $A89A CPL           ; Flip the bits.
 $A89B RRCA          ; {Rotate right twice, so bit 2 is now in bit 0.
 $A89C RRCA          ; }
 $A89D AND %00000001 ; Keep only bit 0.
 $A89F INC A         ; Add one, giving a hit direction of #N$01 or #N$02.
 $A8A0 LD ($9704),A  ; Store the hit direction in #R$9704.
; Turn the Wulf around unless the player is attacking.
 $A8A3 LD A,($9702)  ; Fetch the sprite ID of the player from #R$9702.
 $A8A6 SUB $20       ; Subtract #N$20 (the first attacking Sabreman sprite ID).
 $A8A8 CP $10        ; {Jump to #R$A8AF if the player is attacking.
 $A8AA JR C,$A8AF    ; }
 $A8AC CALL $ADB3    ; Turn the Wulf around.
@label=HandlerWulf_Draw
*$A8AF JP $AD46      ; Jump to #R$AD46 to update the Wulf.

; Test Wulf Pounce
;
; Used by the routine at #R$A858.
; .
; Makes the Wulf pounce (sprite IDs #N$58 and #N$5C) when it is moving
; left, is in the same room as the player, is to the right of the player and
; the player is attacking to the right (sprite IDs #N$28 to #N$2F).
; #R$A8E4 does the same for a Wulf moving right.
;
; IX Actor record of the Wulf
@label=TestWulfPounce
c$A8B2 LD A,($9703)    ; Fetch the room of the player from #R$9703.
 $A8B5 CP (IX+$01)     ; {Return if the Wulf is in a different room to the
 $A8B8 RET NZ          ; player.}
 $A8B9 LD A,(IX+$02)   ; Fetch the pounce timer of the Wulf.
 $A8BC AND %11110000   ; Keep only bits 4-7.
 $A8BE RET NZ          ; Return if the Wulf is pouncing already.
 $A8BF LD A,(IX+$06)   ; Fetch the X velocity of the Wulf.
 $A8C2 AND A           ; {Jump to #R$A8E4 if the Wulf is moving right.
 $A8C3 JP P,$A8E4      ; }
 $A8C6 LD A,($9705)    ; Fetch the X position of the player from #R$9705.
 $A8C9 CP (IX+$03)     ; {Return if the player is not to the left of the Wulf.
 $A8CC RET NC          ; }
 $A8CD LD A,($9702)    ; Fetch the sprite ID of the player from #R$9702.
 $A8D0 SUB $28         ; Subtract #N$28.
 $A8D2 CP $08          ; {Return if the player is not attacking to the right.
 $A8D4 RET NC          ; }
; This entry point is used by the routine at #R$A8E4.
; .
; Start the pounce.
@label=TestWulfPounce_Start
*$A8D5 LD A,(IX+$00)   ; Fetch the sprite ID of the Wulf.
 $A8D8 AND %11111100   ; Keep only bits 2-7.
 $A8DA OR %00001000    ; Set bit 3, giving a sprite ID of #N$58 or #N$5C.
 $A8DC LD (IX+$00),A   ; Set the new sprite ID of the Wulf.
 $A8DF LD (IX+$02),$0F ; Set the pounce timer of the Wulf to #N$0F.
 $A8E3 RET             ; Return.

; Test Wulf Pounce Right
;
; Used by the routine at #R$A8B2.
; .
; Makes a Wulf which is moving right pounce when the player is to the
; right of it and is attacking to the left (sprite IDs #N$20 to #N$27). See
; #R$A8B2.
;
; IX Actor record of the Wulf
@label=TestWulfPounceRight
c$A8E4 LD A,($9705)  ; Fetch the X position of the player from #R$9705.
 $A8E7 CP (IX+$03)   ; {Return if the player is to the left of the Wulf.
 $A8EA RET C         ; }
 $A8EB LD A,($9702)  ; Fetch the sprite ID of the player from #R$9702.
 $A8EE SUB $20       ; Subtract #N$20 (the first attacking Sabreman sprite ID).
 $A8F0 CP $08        ; {Return if the player is not attacking to the left.
 $A8F2 RET NC        ; }
 $A8F3 JR $A8D5      ; Jump to #R$A8D5 to start the pounce.

; Handler: Wulf Pouncing
;
; Handles the first frame of the Wulf pouncing (sprite IDs #N$58 and
; #N$5C). The timer in #REGix+#N$02 counts down while the player is not
; attacking in the direction the Wulf is facing, and when it runs out the Wulf
; moves on to the second frame, which is handled by #R$A964. The Wulf can
; hurt the player in the same way as in #R$A858.
;
; IX Actor record of the Wulf
@label=HandlerWulfPouncing
c$A8F5 CALL $BB0B      ; Remember the previous position of the Wulf.
 $A8F8 LD A,($9703)    ; Fetch the room of the player from #R$9703.
 $A8FB CP (IX+$01)     ; {Jump to #R$A913 if the Wulf is in a different room to
 $A8FE JR NZ,$A913     ; the player.}
 $A900 LD A,($9702)    ; Fetch the sprite ID of the player from #R$9702.
 $A903 SUB $20         ; Subtract #N$20 (the first attacking Sabreman sprite
                       ; ID).
 $A905 CP $10          ; {Jump to #R$A913 if the player is not attacking.
 $A907 JR NC,$A913     ; }
 $A909 RRCA            ; Rotate right, so that the direction of the attack is
                       ; in bit 2.
 $A90A AND %00000100   ; Keep only bit 2.
 $A90C XOR (IX+$00)    ; Combine with the sprite ID of the Wulf, so bit 2 shows whether the
                       ; directions differ.
 $A90F AND %00000100   ; Keep only bit 2.
 $A911 JR NZ,$A91F     ; Jump to #R$A91F if the player is attacking in the
                       ; other direction.
@label=HandlerWulfPouncing_Timer
*$A913 DEC (IX+$02)    ; {Decrease the pounce timer by one and jump to #R$A91F if it is not
 $A916 JR NZ,$A91F     ; zero.}
 $A918 INC (IX+$00)    ; Move the Wulf on to the second frame of the pounce.
 $A91B LD (IX+$02),$08 ; Set the pounce timer of the Wulf to #N$08.
@label=HandlerWulfPouncing_Touch
*$A91F JP $A880        ; Jump to #R$A880 to test whether the Wulf is touching
                       ; the player.

; Choose Wulf Direction
;
; Used by the routine at #R$A858.
; .
; Sets the direction of the Wulf. If the Wulf is not in the same row of
; rooms as the player then nothing happens, except that #REGix+#N$02 is reset.
; Otherwise, if #REGix+#N$02 is zero, it is set to #N$01 and the Wulf is
; sent to the left or the right depending on whether the player is in a room
; to its left or right. If they are in the same room then the X positions are
; used instead (see #R$A95A).
;
; IX Actor record of the Wulf
@label=ChooseWulfDirection
c$A922 LD A,($9703)    ; Fetch the room of the player from #R$9703.
 $A925 AND %11110000   ; Keep only bits 4-7.
 $A927 LD C,A          ; Stash the row of the player in #REGc.
 $A928 LD A,(IX+$01)   ; Fetch the room of the Wulf.
 $A92B AND %11110000   ; Keep only bits 4-7.
 $A92D CP C            ; {Jump to #R$A935 if the Wulf is in the same row as the
 $A92E JR Z,$A935      ; player.}
 $A930 LD (IX+$02),$00 ; Clear the direction chosen flag of the Wulf.
 $A934 RET             ; Return.
@label=ChooseWulfDirection_SameRow
*$A935 LD A,(IX+$02)   ; Fetch the direction chosen flag of the Wulf.
 $A938 AND A           ; {Return if the direction has already been chosen.
 $A939 RET NZ          ; }
 $A93A LD (IX+$02),$01 ; Set the direction chosen flag of the Wulf.
 $A93E LD A,($9703)    ; Fetch the room of the player from #R$9703.
 $A941 CP (IX+$01)     ; {Jump to #R$A95A if the Wulf is in the same room as
 $A944 JR Z,$A95A      ; the player.}
 $A946 JR NC,$A951     ; Jump to #R$A951 if the player is to the right of the
                       ; Wulf.
; This entry point is used by the routine at #R$A95A.
@label=ChooseWulfDirection_Left
*$A948 LD (IX+$06),$C0 ; Set the X velocity of the Wulf to #N$C0 (moving left).
 $A94C RES 2,(IX+$00)  ; Reset bit 2 of the sprite ID so that the Wulf faces
                       ; left.
 $A950 RET             ; Return.

; Send Wulf Right
;
; Used by the routines at #R$A922 and #R$A95A.
; .
; Sends the Wulf to the right.
;
; IX Actor record of the Wulf
@label=SendWulfRight
c$A951 LD (IX+$06),$40 ; Set the X velocity of the Wulf to #N$40 (moving
                       ; right).
 $A955 SET 2,(IX+$00)  ; Set bit 2 of the sprite ID so that the Wulf faces
                       ; right.
 $A959 RET             ; Return.

; Compare Wulf Position
;
; Used by the routine at #R$A922.
; .
; Sends the Wulf to the left if the player is to its left, or otherwise
; to the right. This is used when the Wulf and the player are in the same
; room.
;
; IX Actor record of the Wulf
@label=CompareWulfPosition
c$A95A LD A,($9705)  ; Fetch the X position of the player from #R$9705.
 $A95D CP (IX+$03)   ; {Jump to #R$A948 if the player is to the left of the
 $A960 JR C,$A948    ; Wulf.}
 $A962 JR $A951      ; Jump to #R$A951.

; Handler: Wulf Landing
;
; Handles the second frame of the Wulf pouncing (sprite IDs #N$59 and
; #N$5D). When the timer in #REGix+#N$02 runs out the Wulf goes back to
; running with a faster velocity than before.
;
; IX Actor record of the Wulf
@label=HandlerWulfLanding
c$A964 CALL $BB0B      ; Remember the previous position of the Wulf.
 $A967 DEC (IX+$02)    ; {Decrease the pounce timer by one and jump to #R$A982 if it is not
 $A96A JR NZ,$A982     ; zero.}
 $A96C RES 3,(IX+$00)  ; Reset bit 3 of the sprite ID to go back to running.
 $A970 LD (IX+$02),$10 ; Set the pounce timer of the Wulf to #N$10.
 $A974 LD A,(IX+$06)   ; Fetch the X velocity of the Wulf.
 $A977 AND A           ; {Jump to #R$A97D if the velocity is positive.
 $A978 JP P,$A97D      ; }
 $A97B SUB $40         ; Subtract #N$40 if the velocity is negative.
@label=HandlerWulfLanding_Velocity
*$A97D ADD A,$20       ; Add #N$20, making the velocity faster in either
                       ; direction.
 $A97F LD (IX+$06),A   ; Set the new X velocity of the Wulf.
@label=HandlerWulfLanding_Move
*$A982 JP $A869        ; Jump to #R$A869 to move the Wulf.

; Knock Player Back
;
; Used by the routines at #R$ADD0 and #R$AEEF.
; .
; Starts the player flying after they have been hit, using the hit
; direction in #REGa (taken from #R$9704). Bit 7 of the hit direction makes
; the player fall straight down instead (see #R$A9AB). A hit direction of
; #N$02 sends the player to the left (see #R$A9A0) and otherwise the player
; is sent to the right. The sprite IDs #N$40 to #N$47 are then handled by
; #R$A9BE, #R$AA0D and #R$A61B.
;
; A The hit direction
; IX Actor record of the player
@label=KnockPlayerBack
c$A985 LD (IX+$02),$20 ; Set the hit counter of the player to #N$20.
 $A989 BIT 7,A         ; {Jump to #R$A9AB to make the player fall down if bit 7
 $A98B JR NZ,$A9AB     ; is set.}
 $A98D LD (IX+$07),$00 ; Clear the Y velocity of the player.
 $A991 CP $02          ; {Jump to #R$A9A0 if the player is to be sent to the left
 $A993 JR Z,$A9A0      ; (the hit direction is #N$02).}
 $A995 LD (IX+$00),$40 ; Set the sprite ID of the player to #N$40
                       ; (#SPRITENAME$40).
 $A999 LD (IX+$06),$03 ; Set the X velocity of the player to #N$03 (moving
                       ; right).
 $A99D JP $AD5D        ; Jump to #R$AD5D to display the player.

; Knock Player Left
;
; Used by the routine at #R$A985.
; .
; Sends the player flying to the left.
;
; IX Actor record of the player
@label=KnockPlayerLeft
c$A9A0 LD (IX+$00),$44 ; Set the sprite ID of the player to #N$44
                       ; (#SPRITENAME$44).
 $A9A4 LD (IX+$06),$FD ; Set the X velocity of the player to #N$FD (moving
                       ; left).
 $A9A8 JP $AD5D        ; Jump to #R$AD5D to display the player.

; Knock Player Down
;
; Used by the routine at #R$A985.
; .
; Makes the player fall down the screen at the middle of the screen.
;
; IX Actor record of the player
@label=KnockPlayerDown
c$A9AB LD (IX+$00),$40 ; Set the sprite ID of the player to #N$40
                       ; (#SPRITENAME$40).
 $A9AF LD (IX+$06),$00 ; Clear the X velocity of the player.
 $A9B3 LD (IX+$07),$04 ; Set the Y velocity of the player to #N$04 (falling).
 $A9B7 LD (IX+$03),$78 ; Set the X position of the player to #N$78
                       ; (the middle of the screen).
 $A9BB JP $AD5D        ; Jump to #R$AD5D to display the player.

; Handler: Flying Sabreman
;
; Handles the player while they are flying through the air after being
; hit (sprite IDs #N$40 and #N$44). The player moves with the velocity set up
; by #R$A985 and falls to the ground when they hit an object or the edge of
; the play area. A sound is played with a pitch which changes with the
; counter in #REGix+#N$02.
;
; IX Actor record of the player
@label=HandlerFlyingSabreman
c$A9BE CALL $BB0B     ; Remember the previous position of the player.
; Add the velocities to the position.
 $A9C1 LD A,(IX+$06)  ; Fetch the X velocity of the player.
 $A9C4 ADD A,(IX+$03) ; Add the X position of the player.
 $A9C7 LD E,A         ; Stash the new X position in #REGe.
 $A9C8 LD A,(IX+$04)  ; Fetch the Y position of the player.
 $A9CB ADD A,(IX+$07) ; Add the Y velocity of the player.
 $A9CE LD D,A         ; Stash the new Y position in #REGd.
 $A9CF LD BC,$170F    ; Set the height of the player in #REGb to #N$17 and the width in
                      ; #REGc to #N$0F.
 $A9D2 CALL $B81C     ; Stop the player passing through objects in the room.
 $A9D5 CALL $AAED     ; Test whether the player has stayed where it was.
 $A9D8 JR Z,$AA00     ; Jump to #R$AA00 if the player did not move.
 $A9DA LD A,E         ; Fetch the new X position.
 $A9DB CP $04         ; {Jump to #R$AA00 if the player is off the left of the
 $A9DD JR C,$AA00     ; play area.}
 $A9DF CP $EC         ; {Jump to #R$AA00 if the player is off the right of the
 $A9E1 JR NC,$AA00    ; play area.}
 $A9E3 LD A,D         ; Fetch the new Y position.
 $A9E4 CP $28         ; {Jump to #R$AA00 if the player is off the top of the
 $A9E6 JR C,$AA00     ; play area.}
 $A9E8 CP $C0         ; {Jump to #R$AA00 if the player is off the bottom of the
 $A9EA JR NC,$AA00    ; play area.}
 $A9EC LD (IX+$03),E  ; Set the X position of the player.
 $A9EF LD (IX+$04),D  ; Set the Y position of the player.
 $A9F2 CALL $AD5D     ; Display the player.
; Play a sound which changes with the counter.
 $A9F5 INC (IX+$02)   ; Increase the flying counter of the player by one.
 $A9F8 LD B,(IX+$02)  ; Fetch the flying counter as the duration of the wave in
                      ; #REGb.
 $A9FB LD C,$04       ; Set the number of waves in #REGc to #N$04.
 $A9FD JP $BF6D       ; Jump to #R$BF6D to play the sound.

; Land Sabreman
;
; Used by the routine at #R$A9BE.
; .
; Makes the player sit down after flying through the air. The sprite ID
; goes up by one (to #N$41 or #N$45), a counter of #N$3F is set, the player
; is drawn and a noise is played.
;
; IX Actor record of the player
@label=LandSabreman
c$AA00 INC (IX+$00)    ; Move the player on to the sitting sprite.
 $AA03 LD (IX+$02),$3F ; Set the sitting counter of the player to #N$3F.
 $AA07 CALL $AD5D      ; Display the player.
 $AA0A JP $BF2F        ; Jump to #R$BF2F to play the noise.

; Handler: Sitting Sabreman
;
; Handles the player after they have landed (sprite IDs #N$41, #N$42,
; #N$45 and #N$46). When the counter in #REGix+#N$02 runs out the player
; either starts again or loses a life (see #R$AA27). If the player has no
; lives left then they are shown as dead when the counter reaches #N$30.
;
; IX Actor record of the player
@label=HandlerSittingSabreman
c$AA0D CALL $BB0B    ; Remember the previous position of the player.
 $AA10 DEC (IX+$02)  ; {Decrease the sitting counter by one and jump to #R$AA27 if it has
 $AA13 JR Z,$AA27    ; run out.}
 $AA15 LD A,($96BD)  ; Fetch the number of lives from #R$96BD.
 $AA18 AND A         ; {Jump to #R$AA57 if the player has lives left.
 $AA19 JR NZ,$AA57   ; }
 $AA1B LD A,(IX+$02) ; Fetch the sitting counter of the player.
 $AA1E CP $30        ; {Jump to #R$AA57 if the sitting counter is not #N$30.
 $AA20 JR NZ,$AA57   ; }
 $AA22 INC (IX+$00)  ; Move the player on to the dead sprite.
 $AA25 JR $AA57      ; Jump to #R$AA57.

; Handle Player Death
;
; Used by the routines at #R$9F6A and #R$AA0D.
; .
; Called when the player has finished being shown as dead or sitting
; (see #R$AA0D). Depending on the number of players and the number of lives
; left this will either put the player back on their feet with one life less,
; end the game for the player, or hand over to the other player.
;
; IX Actor record of the player
;
; Is this a one or two player game?
@label=HandlePlayerDeath
c$AA27 LD A,($9692)    ; Fetch the game options from #R$9692.
 $AA2A AND %00000001   ; Keep only bit 0.
 $AA2C JR NZ,$AA5A     ; Jump to #R$AA5A if this is a two player game.
; This is a one player game.
@label=HandlePlayerDeath_OnePlayer
*$AA2E LD A,($96BD)    ; {Jump to #R$AAA4 if the player has no lives left.
 $AA31 AND A           ;
 $AA32 JR Z,$AAA4      ; }
 $AA34 LD HL,$96BD     ; Point #REGhl at the number of lives at #R$96BD.
; See #POKE(infinite_lives_player_1,Infinite Lives Player 1).
 $AA37 DEC (HL)        ; Decrease the number of lives by one.
 $AA38 CALL $B7CD      ; Update the lives display.
; Put the player back on their feet with the normal colour.
 $AA3B LD A,(IX+$00)   ; Fetch the sprite ID of the player.
 $AA3E AND %00000111   ; Keep only bits 0-2.
 $AA40 OR %00010000    ; Set bit 4, giving a sprite ID of #N$10 to #N$17.
 $AA42 LD (IX+$00),A   ; Set the new sprite ID of the player.
 $AA45 LD (IX+$05),$47 ; Set the colour of the player to #COLOUR$47.
; Remove any orchid effect and delay the nastie and flame spawning.
 $AA49 XOR A           ; {Clear the orchid effect timer in #R$96B0.
 $AA4A LD ($96B0),A    ; }
 $AA4D LD A,$10        ; {Set the nastie spawn delay in #R$96B1 to #N$10.
 $AA4F LD ($96B1),A    ; }
 $AA52 LD A,$80        ; {Set the flame spawn delay in #R$96B4 to #N$80.
 $AA54 LD ($96B4),A    ; }
; This entry point is used by the routine at #R$AA0D.
@label=HandlePlayerDeath_Draw
*$AA57 JP $AD5D        ; Jump to #R$AD5D to display the player.
; This is a two player game.
@label=HandlePlayerDeath_TwoPlayer
*$AA5A LD A,($96E0)    ; {Jump to #R$AA2E if the other player has no lives
 $AA5D AND A           ; left.
 $AA5E JR Z,$AA2E      ; }
 $AA60 LD A,($96BD)    ; Fetch the number of lives of this player from #R$96BD.
 $AA63 AND A           ; {Show the game over message if this player has no
 $AA64 CALL Z,$AA9C    ; lives left.}
 $AA67 JP $B205        ; Jump to #R$B205 to swap over to the other player.

; Game Over
;
; Used by the routines at #R$AA9C and #R$AAA4.
; .
; Shows the "GAME OVER PLAYER" message, with the percentage of the jungle
; explored, and plays a tune. The message is for player 1 when entered at
; #R$AA6A and for player 2 when entered at #R$AA98.
; .
; #HTML(#AUDIO0(game-over-tune.wav)(#INCLUDE(GameOverTune)))
; .
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After #R$AA6A }
; { #SIM(start=$9960,stop=$998F,clear=1,sp=$5B40)
; #SIM(start=$99A7,stop=$99AA,sp=$5B40)
; #SCR$01(game-over-before)
; | #POKES$96BF,$FF,$0A
; #SIM(start=$AA6A,stop=$AA8A,sp=$5B40)
; #SCR$01(game-over-after) } UDGTABLE# #POPS
;
; .
;
; #HTML(Set up altering the "GAME OVER PLAYER <em>X</em>" message for 1UP.)
@label=GameOver_1UP_Messaging
c$AA6A LD A,"1"+$80  ; #REGa="1" + #N$80 (escape character).
; Print the messaging and pause to show it for a period of time.
@label=GameOver_Write
*$AA6C LD ($AAD3),A  ; Write ASCII player number to
                     ; #R$AAC1(#N$AAD3)(GameOver_Text).
 $AA6F CALL $BB7C    ; Clear the attribute buffer of the play area.
 $AA72 CALL $BB5C    ; Clear the play area.
 $AA75 LD DE,$AAD4   ; Point #REGde at the "ADVENTURE COMPLETED" message at
                     ; #R$AAD4.
 $AA78 LD HL,$7820   ; Set the print position in #REGhl
                     ; (#REGl is the X position and #REGh is the Y position) to #N$7820.
 $AA7B CALL $B53D    ; Print the message.
 $AA7E LD DE,$AAC1   ; Point #REGde at the "GAME OVER PLAYER" message at
                     ; #R$AAC1.
 $AA81 LD HL,$6038   ; Set the print position in #REGhl to #N$6038.
 $AA84 CALL $B53D    ; Print the message.
 $AA87 CALL $9CC6    ; Print the percentage of the jungle explored.
 $AA8A LD DE,$BD28   ; Point #REGde at the game over tune at #R$BD28.
 $AA8D CALL $BD6E    ; Play the tune.
; Introduce a pause by counting down from #N$10000 twice.
 $AA90 LD B,$02      ; Set the number of delays in #REGb to #N$02.
 $AA92 LD HL,$0000   ; Set the delay counter in #REGhl to #N$0000
                     ; (which counts down from #N$10000).
 $AA95 JP $A1FF      ; Jump to #R$A1FF to pause.
; This entry point is used by the routines at #R$AA9C and #R$AAA4.
; .
; #HTML(Set up altering the "GAME OVER PLAYER <em>X</em>" message for 2UP.)
@label=GameOver_2UP
*$AA98 LD A,"2"+$80  ; #REGa="2" + #N$80 (escape character).
 $AA9A JR $AA6C      ; Jump to #R$AA6C.
; View the equivalent code in;
; #LIST
; { #LUNARJETMAN$A8E3 }
; { #TRANZAM$6353 }
; LIST#

; Show Current Game Over
;
; Used by the routine at #R$AA27.
; .
; Shows the game over message for whichever player is active. This simply
; returns when it is done, as the game continues after the message.
@label=GameOver_Controller
c$AA9C LD A,($969E)  ; {Jump to #R$AA6A to show the message for 1UP if player 1 is active
 $AA9F AND A         ; (#R$969E is zero).
 $AAA0 JR Z,$AA6A    ; }
 $AAA2 JR $AA98      ; Jump to #R$AA98 to show the message for 2UP.

; End Game
;
; Used by the routine at #R$AA27.
; .
; Ends the game: shows the game over message for the active player, lets
; the player enter their name if they have a high score, shows the Hall of
; Fame if a new score has been entered and then returns to the game selection
; screen at #R$998F.
@label=GameOver_ControllerRestart
c$AAA4 LD A,($969E)  ; {Jump to #R$AABC if player 2 is active (#R$969E is not
 $AAA7 AND A         ; zero).
 $AAA8 JR NZ,$AABC   ; }
@label=GameOver_Scores
 $AAAA CALL $AA6A    ; Show the game over message for 1UP.
@label=GameOver_NewHighScore
*$AAAD CALL $B5FC    ; Check for a new high score.
 $AAB0 LD A,($96BA)  ; {Jump to #R$AAB9 if the hall of fame has not been updated
 $AAB3 AND A         ; (#R$96BA is zero).
 $AAB4 JR Z,$AAB9    ; }
 $AAB6 CALL $B27E    ; Show the hall of fame.
@label=GameOver_Restart
*$AAB9 JP $998F      ; Jump to #R$998F to restart the game.
@label=GameOver_Restart2UP
*$AABC CALL $AA98    ; Show the game over message for 2UP.
 $AABF JR $AAAD      ; Jump to #R$AAAD.

; Messaging: Game Over
;
; This message is altered directly to change from "1" to "2" for the
; correct player. See #R$AA6A and #R$AA98.
@label=GameOver_Text
t$AAC1 DEFB $47                         ; Attribute: #COLOUR(#PEEK(#PC)).
 $AAC2 DEFM "GAME OVER PLAYER ","1"+$80 ; #HTML("GAME OVER PLAYER <em>X</em>".)

; Messaging: Adventure Completed
;
; The message shown on the game over screen, which is the heading for the
; percentage of the jungle explored (see #R$9CC6). The message finishes with a
; percent sign.
@label=AdventureCompleted_Text
t$AAD4 DEFB $47                               ; Attribute: #COLOUR(#PEEK(#PC)).
 $AAD5 DEFM "ADVENTURE COMPLETED    ","%"+$80 ; "#STR(#PC)".

; Test Position Unchanged
;
; Used by the routines at #R$9D91, #R$9E72, #R$A54F, #R$A858, #R$A9BE, #R$ABDE,
; #R$AD07, #R$ADD0 and #R$AEEF.
; .
; Tests whether the position an actor has been moved to is the same as the
; position it started from.
;
;   DE The new position of the actor (#REGe is X and #REGd is Y)
;   IX Actor record
; O:F Zero flag set if the position is the same as the position in the record
@label=TestPositionUnchanged
c$AAED LD A,E        ; Fetch the new X position of the actor.
 $AAEE XOR (IX+$03)  ; Compare the new X position with the X position of the
                     ; actor.
 $AAF1 RET NZ        ; Return if the X positions are different.
 $AAF2 LD A,D        ; Fetch the new Y position of the actor.
 $AAF3 XOR (IX+$04)  ; Compare the new Y position with the Y position of the
                     ; actor.
 $AAF6 RET           ; Return.

; Test Position Partly Unchanged
;
; Tests whether either the X position or the Y position an actor has been
; moved to is the same as the one it started from. This routine is not used.
;
;   DE The new position of the actor (#REGe is X and #REGd is Y)
;   IX Actor record
; O:F Zero flag set if either the X or Y position is the same
@label=TestPositionPartlyUnchanged
u$AAF7 DEFB $7B             ; Fetch the new X position of the actor.
 $AAF8 DEFB $DD,$BE,$03,$C8 ; Return if the X positions are the same.
 $AAFC DEFB $7A             ; Fetch the new Y position of the actor.
 $AAFD DEFB $DD,$BE,$04     ; Compare the new Y position with the Y position of
                            ; the actor.
 $AB00 DEFB $C9             ; Return.

; Test Player Touching Actor
;
; Used by the routines at #R$9B0D, #R$9D91, #R$A1AB, #R$A305, #R$A312, #R$A3B7,
; #R$A737, #R$A858 and #R$AB36.
; .
; Tests whether the player is touching an actor. The reach in #REGb and
; #REGc is how far the player can be above and to the right of the position of
; the actor, and the reach below and to the left is fixed:
; #TABLE(default,centre,centre,centre)
; { =h Player | =h Left | =h Below }
; { Walking (sprite IDs #N$10 to #N$1F) | #N$0C | #N$0F }
; { Attacking (sprite IDs #N$20 to #N$2F) | #N$1C | #N$0F }
; TABLE#
; No touching takes place while the game delay in #R$96B5 is running, or if
; the player is not walking or attacking.
;
;   B How far above the actor the player can be
;   C How far to the right of the actor the player can be
;   IX Actor record
; O:F Carry flag set if the player is touching the actor
@label=TestPlayerTouchingActor
c$AB01 LD A,($96B5)  ; Fetch the start-of-turn delay from #R$96B5.
 $AB04 AND A         ; {Return (with the carry flag reset) if the start-of-turn delay is
 $AB05 RET NZ        ; running.}
 $AB06 LD A,($9702)  ; Fetch the sprite ID of the player from #R$9702.
 $AB09 SUB $10       ; Subtract #N$10 (the first Sabreman sprite ID).
 $AB0B CP $20        ; {Return if the player is not walking or attacking.
 $AB0D RET NC        ; }
; This entry point is used by the routine at #R$9EB3.
@label=TestPlayerTouchingActor_Reach
*$AB0E LD HL,$0F0C   ; Set the reach below the actor in #REGh to #N$0F and the reach to the
                     ; left in #REGl to #N$0C.
 $AB11 CP $10        ; {Jump to #R$AB18 if the player is walking.
 $AB13 JR C,$AB18    ; }
 $AB15 LD HL,$0F1C   ; Set the longer reach to the left of an attacking player in #REGl to
                     ; #N$1C.
; Compare the X positions.
@label=TestPlayerTouchingActor_X
*$AB18 LD A,($9705)  ; Fetch the X position of the player from #R$9705.
 $AB1B SUB (IX+$03)  ; Subtract the X position of the actor to get the
                     ; horizontal distance.
 $AB1E JR C,$AB2C    ; Jump to #R$AB2C if the player is to the left of the
                     ; actor.
 $AB20 CP C          ; Compare the distance with the reach to the right.
@label=TestPlayerTouchingActor_TooFarRight
*$AB21 RET NC        ; Return if the player is too far to the right.
; Compare the Y positions.
@label=TestPlayerTouchingActor_Y
 $AB22 LD A,($9706)  ; Fetch the Y position of the player from #R$9706.
 $AB25 SUB (IX+$04)  ; Subtract the Y position of the actor to get the vertical
                     ; distance.
 $AB28 JR C,$AB31    ; Jump to #R$AB31 if the player is above the actor.
 $AB2A CP H          ; Compare the distance with the reach below.
@label=TestPlayerTouchingActor_Return
*$AB2B RET           ; Return.
; The player is to the left of the actor.
@label=TestPlayerTouchingActor_Left
*$AB2C NEG           ; Make the distance positive.
 $AB2E CP L          ; Compare the distance with the reach to the left.
 $AB2F JR $AB21      ; Jump to #R$AB21.
; The player is above the actor.
@label=TestPlayerTouchingActor_Above
*$AB31 NEG           ; Make the distance positive.
 $AB33 CP B          ; Compare the distance with the reach above.
 $AB34 JR $AB2B      ; Jump to #R$AB2B.

; Test Actor Hurting Player
;
; Used by the routines at #R$9E72, #R$9EB3, #R$A4D7, #R$A54F, #R$AB74 and
; #R$AD07.
; .
; Tests whether an actor is touching the player, and if so whether the
; actor hurts the player. The test is only made when the player has the normal
; colour of #N$47 (see #R$A737) and is in the same room as the actor.
; .
; If the player is walking, or is attacking in the direction away from the
; actor, then they are hit and the direction they are hit in is written to
; #R$9704 (#N$01 if bit 0 of #REGd is set, or #N$02 otherwise). If the player is
; attacking towards the actor then the actor is hit and no hit direction is
; written.
;
;   B How far above the actor the player can be
;   C How far to the right of the actor the player can be
;   D Bit 0 is set if the hit direction should be #N$01
;   IX Actor record
; O:F Carry flag set if the actor is touching the player
@label=TestActorHurtingPlayer
c$AB36 LD A,($9707)  ; Fetch the colour of the player from #R$9707.
 $AB39 SUB $47       ; Subtract #N$47 (the normal colour).
 $AB3B AND A         ; {Return if the player does not have the normal colour.
 $AB3C RET NZ        ; }
; This entry point is used by the routine at #R$9F16.
@label=TestActorHurtingPlayer_Room
*$AB3D LD A,($9703)  ; Fetch the room of the player from #R$9703.
 $AB40 SUB (IX+$01)  ; Subtract the room of the actor.
 $AB43 AND A         ; {Return if the actor is in a different room to the
 $AB44 RET NZ        ; player.}
 $AB45 CALL $AB01    ; Test whether the player is touching the actor.
; See #POKE(immunity,Immunity).
 $AB48 RET NC        ; Return if the player is not touching the actor.
 $AB49 LD A,($9702)  ; Fetch the sprite ID of the player from #R$9702.
 $AB4C SUB $10       ; Subtract #N$10 (the first Sabreman sprite ID).
 $AB4E CP $10        ; {Jump to #R$AB5E if the player is walking.
 $AB50 JR C,$AB5E    ; }
 $AB52 BIT 3,A       ; {Jump to #R$AB6A if the player is attacking to the right
 $AB54 JR NZ,$AB6A   ; (bit 3 of the sprite ID is set).}
; The player is attacking to the left.
 $AB56 LD A,($9705)  ; Fetch the X position of the player from #R$9705.
 $AB59 SUB (IX+$03)  ; Subtract the X position of the actor.
 $AB5C JR NC,$AB68   ; Jump to #R$AB68 if the actor is to the left of the
                     ; player.
; Hurt the player.
@label=TestActorHurtingPlayer_Hit
*$AB5E BIT 0,D       ; Test whether the hit direction should be #N$01 (bit 0 of
                     ; #REGd).
 $AB60 LD A,$01      ; Set the hit direction in #REGa to #N$01.
 $AB62 JR NZ,$AB65   ; Jump to #R$AB65 if bit 0 of #REGd is set.
 $AB64 INC A         ; Set the hit direction in #REGa to #N$02.
@label=TestActorHurtingPlayer_Direction
*$AB65 LD ($9704),A  ; Store the hit direction in #R$9704.
@label=TestActorHurtingPlayer_Touching
*$AB68 SCF           ; Set the carry flag (the actor is touching the player).
 $AB69 RET           ; Return.
; The player is attacking to the right.
@label=TestActorHurtingPlayer_Right
*$AB6A LD A,($9705)  ; Fetch the X position of the player from #R$9705.
 $AB6D SUB (IX+$03)  ; Subtract the X position of the actor.
 $AB70 JR C,$AB68    ; Jump to #R$AB68 if the actor is to the right of the
                     ; player.
 $AB72 JR $AB5E      ; Jump to #R$AB5E to hurt the player.

; Handler: Tribesman
;
; Handles a tribesman (sprite IDs #N$38 to #N$3F). Bit 2 of the sprite ID
; is set when the tribesman is facing right.
; .
; A tribesman wanders about the room with the velocity chosen by #R$ABDE. If
; it touches the player then it hurts the player and is thrown away (see
; #R$ABEF). When a tribesman is close to an amulet piece which has not been
; collected (see #R$9D41) it flashes yellow and plays a sound.
;
; IX Actor record of the tribesman
@label=HandlerTribesman
c$AB74 CALL $A630      ; Bring the tribesman closer to the player if it is two or more rows
                       ; away.
 $AB77 CALL $BB0B      ; Remember the previous position of the tribesman.
 $AB7A LD A,$10        ; {Set the width of the tribesman in #R$96AD to #N$10.
 $AB7C LD ($96AD),A    ; }
 $AB7F CALL $AFE8      ; Work out the new position of the tribesman.
 $AB82 LD BC,$170F     ; Set the height of the tribesman in #REGb to #N$17 and the width in
                       ; #REGc to #N$0F.
 $AB85 CALL $B81C      ; Stop the tribesman passing through objects in the
                       ; room.
 $AB88 CALL $ABDE      ; Choose a new velocity if the tribesman did not manage
                       ; to move.
 $AB8B LD (IX+$03),E   ; Set the X position of the tribesman.
 $AB8E LD (IX+$04),D   ; Set the Y position of the tribesman.
 $AB91 CALL $AC0E      ; Animate the tribesman.
; Test whether the tribesman has touched the player.
 $AB94 LD A,(IX+$00)   ; Fetch the sprite ID of the tribesman.
 $AB97 RRCA            ; {Rotate right twice, so bit 2 is now in bit 0.
 $AB98 RRCA            ; }
 $AB99 AND %00000001   ; Keep only the direction bit (bit 0).
 $AB9B LD D,A          ; Stash the hit direction in #REGd (used by #R$AB36).
 $AB9C LD BC,$0F0C     ; Set the reach used to test whether the tribesman is touching the
                       ; player in #REGbc to #N$0F0C.
 $AB9F CALL $AB36      ; Test whether the tribesman is hurting the player.
 $ABA2 JR NC,$ABB6     ; Jump to #R$ABB6 if the tribesman is not touching the
                       ; player.
; Throw the tribesman away from the player.
 $ABA4 LD A,($9702)    ; Fetch the sprite ID of the player from #R$9702.
 $ABA7 AND %00001000   ; Keep only the direction the player is facing (bit 3).
 $ABA9 JR Z,$ABDA      ; Jump to #R$ABDA if the player is facing left.
 $ABAB LD A,$40        ; Set the X velocity in #REGa to #N$40 (moving right).
@label=HandlerTribesman_Throw
*$ABAD LD BC,$AC24     ; Point #REGbc at the table of tribesman velocities at
                       ; #R$AC24.
 $ABB0 CALL $ABEF      ; Set the velocity of the tribesman.
 $ABB3 CALL $BF17      ; Play the warble sound.
; Flash the tribesman and make a sound if an amulet piece is close.
@label=HandlerTribesman_Amulet
*$ABB6 CALL $9D41      ; Test whether an amulet piece is close.
 $ABB9 JP NC,$AD46     ; Jump to #R$AD46 to update the tribesman if no amulet
                       ; piece is close.
 $ABBC LD C,A          ; Stash the distance to the amulet piece in #REGc.
 $ABBD LD A,($9703)    ; Fetch the room of the player from #R$9703.
 $ABC0 CP (IX+$01)     ; Compare with the room of the tribesman.
 $ABC3 JP NZ,$AD46     ; Jump to #R$AD46 to update the tribesman if it is in a different room
                       ; to the player.
 $ABC6 LD A,C          ; Fetch the distance to the amulet piece.
 $ABC7 CALL $BF3D      ; Play the amulet piece sound.
 $ABCA LD A,(IX+$05)   ; Fetch the colour of the tribesman.
 $ABCD PUSH AF         ; Stash the colour on the stack.
 $ABCE LD (IX+$05),$46 ; Set the colour of the tribesman to #COLOUR$46 (bright
                       ; yellow).
 $ABD2 CALL $AD46      ; Update the tribesman.
 $ABD5 POP AF          ; Restore the colour of the tribesman from the stack.
 $ABD6 LD (IX+$05),A   ; Set the colour of the tribesman.
 $ABD9 RET             ; Return.
@label=HandlerTribesman_ThrowLeft
*$ABDA LD A,$C0        ; Set the X velocity in #REGa to #N$C0 (moving left).
 $ABDC JR $ABAD        ; Jump to #R$ABAD.

; Choose Tribesman Velocity
;
; Used by the routine at #R$AB74.
; .
; Chooses a new velocity for a tribesman if it did not manage to move.
; The velocities are held in #R$AC24, so each one has a one in four chance of
; being chosen for each direction.
;
; DE The new position of the tribesman (#REGe is X and #REGd is Y)
; IX Actor record of the tribesman
@label=ChooseTribesmanVelocity
c$ABDE CALL $AAED    ; Test whether the tribesman has stayed where it was.
 $ABE1 RET NZ        ; Return if the tribesman has moved.
 $ABE2 LD BC,$AC24   ; Point #REGbc at the table of tribesman velocities at
                     ; #R$AC24.
 $ABE5 LD A,($9695)  ; Fetch the random seed from #R$9695.
 $ABE8 AND %00000011 ; Keep only bits 0-1.
 $ABEA LD L,A        ; Stash the velocity index in #REGl.
 $ABEB LD H,$00      ; Clear #REGh.
 $ABED ADD HL,BC     ; Add the table address to get the address of the
                     ; velocity.
 $ABEE LD A,(HL)     ; Fetch the X velocity from the table.

; Set Tribesman Velocity
;
; Used by the routine at #R$AB74.
; .
; Sets the X velocity of a tribesman and makes it face the way it is
; going, then chooses a random Y velocity.
;
; A The X velocity
; BC Address of the table of velocities at #R$AC24
; IX Actor record of the tribesman
@label=SetTribesmanVelocity
c$ABEF LD (IX+$06),A  ; Set the X velocity of the tribesman.
 $ABF2 AND A          ; {Jump to #R$AC08 if the tribesman is moving left.
 $ABF3 JP M,$AC08     ; }
 $ABF6 SET 2,(IX+$00) ; Set bit 2 of the sprite ID so that the tribesman faces
                      ; right.
@label=SetTribesmanVelocity_Y
*$ABFA LD A,($5C78)   ; Fetch the low byte of #SKOOLKID$5C78(FRAMES).
 $ABFD AND %00000011  ; Keep only bits 0-1.
 $ABFF LD L,A         ; Stash the velocity index in #REGl.
 $AC00 LD H,$00       ; Clear #REGh.
 $AC02 ADD HL,BC      ; Add the table address to get the address of the
                      ; velocity.
 $AC03 LD A,(HL)      ; Fetch the Y velocity from the table.
 $AC04 LD (IX+$07),A  ; Set the Y velocity of the tribesman.
 $AC07 RET            ; Return.
; The tribesman is moving left.
@label=SetTribesmanVelocity_Left
*$AC08 RES 2,(IX+$00) ; Reset bit 2 of the sprite ID so that the tribesman
                      ; faces left.
 $AC0C JR $ABFA       ; Jump to #R$ABFA.

; Animate Actor
;
; Used by the routines at #R$A858 and #R$AB74.
; .
; Every other frame, moves an actor on to the next frame of its animation
; by incrementing the lowest two bits of the sprite ID (so the animation is
; the four frames of the sprite with the same upper bits).
;
; IX Actor record
@label=AnimateActor
c$AC0E LD A,($9693)  ; Fetch the low byte of the game timer from #R$9693.
 $AC11 AND %00000001 ; Keep only bit 0.
 $AC13 RET NZ        ; Return if bit 0 is set
                     ; (the actor only animates on alternate passes).
 $AC14 LD A,(IX+$00) ; Fetch the sprite ID of the actor.
 $AC17 LD C,A        ; Stash the sprite ID in #REGc.
 $AC18 INC A         ; Move on to the next frame.
 $AC19 AND %00000011 ; Keep only bits 0-1.
 $AC1B LD B,A        ; Stash the new frame in #REGb.
 $AC1C LD A,C        ; Fetch the old sprite ID.
 $AC1D AND %11111100 ; Keep only bits 2-7.
 $AC1F OR B          ; Merge in the new frame.
 $AC20 LD (IX+$00),A ; Set the new sprite ID of the actor.
 $AC23 RET           ; Return.

; Tribesman Velocities
;
; The velocities which a tribesman can be given by #R$ABDE, in sixteenths
; of a pixel. Two are negative (up or left) and two are positive (down or
; right).
@label=TribesmanVelocities
b$AC24 DEFB $D0      ; {Negative velocities.
 $AC25 DEFB $E0      ; }
 $AC26 DEFB $20      ; {Positive velocities.
 $AC27 DEFB $30      ; }

; Pause Game
;
; Used by the routines at #R$9A1D, #R$9F6A and #R$A234.
; .
; Pauses the game if SPACE (or CAPS SHIFT) is being pressed on its own.
; While the game is paused the border flashes. Pressing SPACE (or CAPS SHIFT)
; again carries on with the game, and the border is set back to black.
@label=PauseGame
c$AC28 EI            ; Enable interrupts.
 $AC29 LD A,$7E      ; {Read from the keyboard (#N$7E is also written to port #N$FD);
 $AC2B OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $AC2D IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { =r2 #N$7E | SPACE | FULL-STOP | M | N | B }
                     ; { Shift | Z | X | C | V }
                     ; TABLE#}
 $AC2F BIT 0,A       ; {Return if neither SPACE nor CAPS SHIFT is being
 $AC31 RET NZ        ; pressed.}
 $AC32 CPL           ; Flip the bits so that the keys being pressed are set.
 $AC33 AND %00011110 ; Keep only the other keys on this row (bits 1-4).
 $AC35 RET NZ        ; Return if any other key is being pressed.
; Wait for the key to be released.
@label=PauseGame_Release
*$AC36 LD A,$7E      ; {Read from the keyboard (#N$7E is also written to port #N$FD);
 $AC38 OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $AC3A IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { =r2 #N$7E | SPACE | FULL-STOP | M | N | B }
                     ; { Shift | Z | X | C | V }
                     ; TABLE#}
 $AC3C BIT 0,A       ; {Jump back to #R$AC36 until SPACE and CAPS SHIFT have
 $AC3E JR Z,$AC36    ; been released.}
; Flash the border every frame until the key is pressed again.
@label=PauseGame_Loop
*$AC40 LD HL,$5C78   ; Point #REGhl at #SKOOLKID$5C78(FRAMES).
 $AC43 LD A,(HL)     ; Fetch the frame counter.
@label=PauseGame_Frame
*$AC44 CP (HL)       ; {Jump back to #R$AC44 until the frame counter changes.
 $AC45 JR Z,$AC44    ; }
 $AC47 LD A,D        ; Fetch the border flash counter from #REGd.
 $AC48 ADD A,$04     ; Add #N$04 to the border flash counter.
 $AC4A LD D,A        ; Store the border flash counter in #REGd.
 $AC4B RLCA          ; {Rotate left twice, so bit 7 is now in bit 1.
 $AC4C RLCA          ; }
 $AC4D AND %00000010 ; Keep only bit 1.
 $AC4F OR %00000001  ; Set bit 0, so the border alternates between blue and
                     ; magenta.
 $AC51 OUT ($FE),A   ; Set the border colour.
 $AC53 LD A,$7E      ; {Read from the keyboard (#N$7E is also written to port #N$FD);
 $AC55 OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $AC57 IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { =r2 #N$7E | SPACE | FULL-STOP | M | N | B }
                     ; { Shift | Z | X | C | V }
                     ; TABLE#}
 $AC59 BIT 0,A       ; {Jump back to #R$AC40 until SPACE or CAPS SHIFT is pressed to
 $AC5B JR NZ,$AC40   ; unpause.}
; Wait for the key to be released again.
@label=PauseGame_Release_Again
*$AC5D LD A,$7E      ; {Read from the keyboard (#N$7E is also written to port #N$FD);
 $AC5F OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $AC61 IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { =r2 #N$7E | SPACE | FULL-STOP | M | N | B }
                     ; { Shift | Z | X | C | V }
                     ; TABLE#}
 $AC63 BIT 0,A       ; {Jump back to #R$AC5D until SPACE and CAPS SHIFT have
 $AC65 JR Z,$AC5D    ; been released.}
 $AC67 XOR A         ; Select black for the border.
 $AC68 OUT ($FE),A   ; Set the border colour.
 $AC6A RET           ; Return.

; Reset Actors
;
; Used by the routine at #R$B21E.
; .
; Copies the initial state of the #N$0C actors in #R$AC77 into the actor
; table at #R$9702, which sets up the player and the immortal actors for a new
; game.
@label=ResetActors
c$AC6B LD HL,$AC77   ; Point #REGhl at the initial state of the actors at
                     ; #R$AC77.
 $AC6E LD DE,$9702   ; Point #REGde at the actor table at #R$9702.
 $AC71 LD BC,$0090   ; Set the number of bytes to copy in #REGbc to #N$0090 (#N$0C actors
                     ; of #N$0C bytes).
 $AC74 LDIR          ; Copy the actors.
 $AC76 RET           ; Return.

; Initial Actors
;
; The initial state of the player and the immortal actors, copied into
; #R$9702 by #R$AC6B. Each is a #N$0C byte actor record (see #R$9702). The
; spare record is used for flames.
@label=InitialActors
b$AC77 DEFB $10,$A8,$00,$78,$70,$47,$00,$00,$00,$00,$00,$00 ; Player
                                                            ; (#SPRITENAME$10)
                                                            ; in room #N$A8.
 $AC83 DEFB $30,$98,$00,$70,$83,$43,$D0,$00,$00,$00,$00,$00 ; Rhino
                                                            ; (#SPRITENAME$30)
                                                            ; in room #N$98.
 $AC8F DEFB $32,$07,$00,$70,$3F,$43,$30,$00,$00,$00,$00,$00 ; Rhino
                                                            ; (#SPRITENAME$32)
                                                            ; in room #N$07.
 $AC9B DEFB $30,$F3,$00,$70,$83,$43,$D0,$00,$00,$00,$00,$00 ; Rhino
                                                            ; (#SPRITENAME$30)
                                                            ; in room #N$F3.
 $ACA7 DEFB $32,$98,$00,$70,$3F,$43,$30,$00,$00,$00,$00,$00 ; Rhino
                                                            ; (#SPRITENAME$32)
                                                            ; in room #N$98.
 $ACB3 DEFB $3C,$A7,$00,$50,$50,$42,$02,$02,$00,$00,$00,$00 ; Tribesman
                                                            ; (#SPRITENAME$3C)
                                                            ; in room #N$A7.
 $ACBF DEFB $3C,$44,$00,$50,$50,$43,$02,$FE,$00,$00,$00,$00 ; Tribesman
                                                            ; (#SPRITENAME$3C)
                                                            ; in room #N$44.
 $ACCB DEFB $3C,$E2,$00,$30,$78,$45,$FD,$FD,$00,$00,$00,$00 ; Tribesman
                                                            ; (#SPRITENAME$3C)
                                                            ; in room #N$E2.
 $ACD7 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00 ; Spare record for
                                                            ; a flame.
 $ACE3 DEFB $50,$F6,$00,$70,$3F,$45,$C0,$00,$00,$00,$00,$00 ; Wulf
                                                            ; (#SPRITENAME$50)
                                                            ; in room #N$F6.
 $ACEF DEFB $A0,$83,$00,$78,$87,$46,$E0,$00,$00,$00,$00,$00 ; Hippo
                                                            ; (#SPRITENAME$A0)
                                                            ; in room #N$83.
 $ACFB DEFB $94,$88,$00,$70,$87,$45,$00,$00,$00,$00,$00,$00 ; The Guardian
                                                            ; (#SPRITENAME$94)
                                                            ; in room #N$88.

; Handler: Rhino
;
; Handles a rhino (sprite IDs #N$30 to #N$33). Bit 1 of the sprite ID is
; set when the rhino is facing right.
; .
; The rhino moves with its X velocity (see #R$AFE8) and stops and turns
; around if it is blocked, when its speed is also reset. If it touches the
; player then the player is hurt and the rhino turns around, unless the player
; is attacking, in which case the rhino is knocked back instead (see
; #R$AD69).
;
; IX Actor record of the rhino
@label=HandlerRhino
c$AD07 CALL $BB0B    ; Remember the previous position of the rhino.
 $AD0A CALL $AD93    ; Animate the rhino.
 $AD0D LD A,$20      ; {Set the width of the rhino in #R$96AD to #N$20.
 $AD0F LD ($96AD),A  ; }
 $AD12 CALL $AFE8    ; Work out the new position of the rhino.
; Stop the rhino moving through objects in the room. If it did not manage
; to move then turn it around.
 $AD15 LD BC,$171F   ; Set the height of the rhino in #REGb to #N$17 and the width in #REGc
                     ; to #N$1F.
 $AD18 CALL $B81C    ; Stop the rhino passing through objects in the room.
 $AD1B CALL $AAED    ; Test whether the rhino has stayed where it was.
 $AD1E JR NZ,$AD28   ; Jump to #R$AD28 if the rhino has moved.
 $AD20 LD A,$30      ; Set the speed of the rhino in #REGa to #N$30.
 $AD22 CALL $AD86    ; Set the speed of the rhino, keeping its direction.
 $AD25 CALL $ADA2    ; Turn the rhino around.
; This entry point is used by the routine at #R$9E72.
@label=HandlerRhino_Position
*$AD28 LD (IX+$03),E ; Set the X position of the rhino.
 $AD2B LD (IX+$04),D ; Set the Y position of the rhino.
; Test whether the rhino has touched the player.
 $AD2E LD A,(IX+$00) ; Fetch the sprite ID of the rhino.
 $AD31 RRCA          ; Rotate right, so bit 1 is now in bit 0.
 $AD32 AND %00000001 ; Keep only bit 0.
 $AD34 LD D,A        ; Store the result in #REGd (the hit direction for
                     ; #R$AB36).
 $AD35 LD BC,$0F1C   ; Set the reach used to test whether the rhino is touching the player
                     ; in #REGbc to #N$0F1C.
 $AD38 CALL $AB36    ; Test whether the rhino is hurting the player.
 $AD3B JR NC,$AD46   ; Jump to #R$AD46 if the rhino is not touching the player.
 $AD3D LD A,($9704)  ; Fetch the hit direction of the player from #R$9704.
 $AD40 AND A         ; {Jump to #R$AD69 if the player was not hit, which means the rhino was
 $AD41 JR Z,$AD69    ; hit by the sword.}
 $AD43 CALL $ADA2    ; Turn the rhino around.

; Update Actor
;
; Used by the routines at #R$9E72, #R$A858, #R$AB74, #R$AD07 and #R$AD69.
; .
; Updates the display of an actor which has been moved. If the actor is in
; the same room as the player then it is drawn (see #R$AD57). If the actor is
; not in the room of the player but it was in the room last time (the room is
; held in #R$96A2) then it is removed from the screen.
;
; IX Actor record
@label=UpdateActor
c$AD46 LD A,($9703)  ; Fetch the room of the player from #R$9703.
 $AD49 LD C,A        ; Stash the room of the player in #REGc.
 $AD4A CP (IX+$01)   ; {Jump to #R$AD57 if the actor is in the same room as the
 $AD4D JR Z,$AD57    ; player.}
 $AD4F LD A,($96A2)  ; Fetch the previous room of the actor from #R$96A2.
 $AD52 CP C          ; {Return if the actor was not in the room of the player.
 $AD53 RET NZ        ; }
 $AD54 JP $B8F5      ; Jump to #R$B8F5 to remove the actor from the screen.

; Update Actor In Room
;
; Used by the routine at #R$AD46.
; .
; Draws an actor which is in the same room as the player. If the actor
; was in the room last time then it is moved with #R$B9A9, otherwise it has
; just arrived and is drawn with #R$B919. The attributes of the actor are then
; set.
;
; C Room of the player
; IX Actor record
@label=UpdateActorInRoom
c$AD57 LD A,($96A2)  ; Fetch the previous room of the actor from #R$96A2.
 $AD5A CP C          ; {Jump to #R$AD63 if the actor has just arrived in the
 $AD5B JR NZ,$AD63   ; room.}

; Display Actor
;
; Used by the routines at #R$9D91, #R$9EB3, #R$9F16, #R$A3C5, #R$A3E0, #R$A42A,
; #R$A4A6, #R$A4D7, #R$A54F, #R$A985, #R$A9A0, #R$A9AB, #R$A9BE, #R$AA00,
; #R$AA27 and #R$ADD0.
; .
; Moves an actor on the screen and sets its attributes.
;
; IX Actor record
@label=DisplayActor
c$AD5D CALL $B9A9    ; Move the actor on the screen.
 $AD60 JP $BB24      ; Jump to #R$BB24 to colour the actor.

; Draw Actor
;
; Used by the routine at #R$AD57.
; .
; Draws an actor on the screen and sets its attributes.
;
; IX Actor record
@label=DrawActor
c$AD63 CALL $B919    ; Draw the actor on the screen.
 $AD66 JP $BB24      ; Jump to #R$BB24 to colour the actor.

; Knock Back Rhino
;
; Used by the routine at #R$AD07.
; .
; Turns a rhino which has been hit by the sword of the player and sends it
; away from the player with a velocity of #N$60 (to the right) or #N$A0 (to the
; left), depending on which way the player is facing. A warble is played.
;
; IX Actor record of the rhino
@label=KnockBackRhino
c$AD69 LD A,($9702)   ; Fetch the sprite ID of the player from #R$9702.
 $AD6C BIT 3,A        ; {Jump to #R$AD7E if the player is attacking to the right (bit 3 of
 $AD6E JR NZ,$AD7E    ; the sprite ID is set).}
 $AD70 RES 1,(IX+$00) ; Reset bit 1 of the sprite ID so the rhino faces left.
 $AD74 LD A,$A0       ; Set the X velocity in #REGa to #N$A0 (moving left).
@label=KnockBackRhino_Velocity
*$AD76 LD (IX+$06),A  ; Set the X velocity of the rhino.
 $AD79 CALL $BF17     ; Play the warble sound.
 $AD7C JR $AD46       ; Jump to #R$AD46 to update the rhino.
@label=KnockBackRhino_Right
*$AD7E SET 1,(IX+$00) ; Set bit 1 of the sprite ID so the rhino faces right.
 $AD82 LD A,$60       ; Set the X velocity in #REGa to #N$60 (moving right).
 $AD84 JR $AD76       ; Jump to #R$AD76.

; Set Velocity Magnitude
;
; Used by the routine at #R$AD07.
; .
; Sets the speed of the X velocity of an actor but keeps the direction it
; is moving in.
;
; A The speed
; IX Actor record
@label=SetVelocityMagnitude
c$AD86 BIT 7,(IX+$06) ; {Jump to #R$AD8F if the actor is moving right.
 $AD8A JP P,$AD8F     ; }
 $AD8D NEG            ; Negate the speed.
@label=SetVelocityMagnitude_Store
*$AD8F LD (IX+$06),A  ; Set the X velocity of the actor.
 $AD92 RET            ; Return.

; Animate Rhino
;
; Used by the routines at #R$9E72, #R$9F16 and #R$AD07.
; .
; Every other frame, flips bit 0 of the sprite ID of an actor to give it
; the next frame of animation.
;
; IX Actor record
@label=AnimateRhino
c$AD93 LD A,($9693)  ; Fetch the low byte of the game timer from #R$9693.
 $AD96 AND %00000001 ; Keep only bit 0.
 $AD98 RET NZ        ; Return if bit 0 is set (the actor only animates on alternate
                     ; passes).
 $AD99 LD A,(IX+$00) ; Fetch the sprite ID of the actor.
 $AD9C XOR %00000001 ; Flip bit 0 to give the next frame of animation.
 $AD9E LD (IX+$00),A ; Set the new sprite ID of the actor.
 $ADA1 RET           ; Return.

; Turn Rhino Around
;
; Used by the routines at #R$9EB3 and #R$AD07.
; .
; Turns a rhino around, by flipping bit 1 of the sprite ID and reversing
; the X velocity.
;
; IX Actor record
@label=TurnRhinoAround
c$ADA2 LD A,(IX+$00) ; Fetch the sprite ID of the rhino.
 $ADA5 XOR %00000010 ; Flip bit 1 (the direction the rhino is facing).
 $ADA7 LD (IX+$00),A ; Set the new sprite ID of the rhino.
; This entry point is used by the routine at #R$ADB3.
@label=TurnRhinoAround_Velocity
*$ADAA LD A,(IX+$06) ; Fetch the X velocity of the actor.
 $ADAD NEG           ; Reverse the X velocity.
 $ADAF LD (IX+$06),A ; Set the new X velocity of the actor.
 $ADB2 RET           ; Return.

; Turn Wulf Around
;
; Used by the routine at #R$A858.
; .
; Turns a Wulf or a tribesman around, by flipping bit 2 of the sprite ID
; and reversing the X velocity.
;
; IX Actor record
@label=TurnWulfAround
c$ADB3 LD A,(IX+$00) ; Fetch the sprite ID of the actor.
 $ADB6 XOR %00000100 ; Flip bit 2 (the direction the actor is facing).
 $ADB8 LD (IX+$00),A ; Set the new sprite ID of the actor.
 $ADBB JR $ADAA      ; Jump to #R$ADAA to reverse the X velocity.

; Handler: Empty
;
; The handler for the sprite IDs which are not used. It does nothing.
@label=HandlerEmpty
c$ADBD RET           ; Return.
 $ADBE RET           ; Return.

; Start Attack
;
; Used by the routine at #R$AEEF.
; .
; Turns a walking Sabreman into an attacking one with a sword. The new
; sprite ID is #N$20 to #N$2F and depends on the direction the player was
; facing.
;
; IX Actor record of the player
@label=StartAttack
c$ADBF LD A,(IX+$00) ; Fetch the sprite ID of the player.
 $ADC2 RLCA          ; Rotate left, so that bit 2 (set when facing right or down) is moved
                     ; into bit 3.
 $ADC3 AND %00001111 ; Keep only bits 0-3.
 $ADC5 OR %00100000  ; Set bit 5.
 $ADC7 LD (IX+$00),A ; Set the new sprite ID of the player.
 $ADCA LD A,$18      ; {Set the width of an attacking player in #R$96AD to
 $ADCC LD ($96AD),A  ; #N$18.}
 $ADCF RET           ; Return.

; Handler: Attacking Sabreman
;
; Handles the player while they are attacking with the sword (sprite IDs
; #N$20 to #N$2F). Bit 3 of the sprite ID is set when the player is attacking
; to the right.
; .
; While the player is holding down "fire" they can move about with a fixed
; speed in any direction. When "fire" is released, or if the player has an
; orchid effect, the player is made to walk again by #R$AE34. If the player
; has been hit (the hit direction in #REGix+#N$02 is not zero) then they are
; knocked back by #R$A985.
;
; IX Actor record of the player
@label=PlayerMovement
c$ADD0 CALL $BB0B    ; Remember the previous position of the player.
 $ADD3 CALL $A18C    ; Check the progress of the player.
 $ADD6 LD A,$10      ; {Set the width of the player in #R$96AD to #N$10.
 $ADD8 LD ($96AD),A  ; }
 $ADDB LD A,(IX+$02) ; Fetch the hit direction of the player.
 $ADDE AND A         ; {Jump to #R$A985 if the player has been hit.
 $ADDF JP NZ,$A985   ; }
; Initialise the player movement (#N($0000,$04,$04) == no movement).
 $ADE2 LD DE,$0000   ; Clear the movement of the player in #REGde.
; Read the controls.
 $ADE5 CALL $B0A3    ; Read the controls.
; Check if the player is under the influence of an orchid.
 $ADE8 LD A,(IX+$05) ; Fetch the colour of the player.
 $ADEB CP $47        ; {Jump to #R$AE34 if the player is not using attribute
 $ADED JR NZ,$AE34   ; #COLOUR$47.}
; Check that "fire" is still being pressed.
 $ADEF BIT 4,C       ; {Jump to #R$AE34 if "fire" is not being pressed.
 $ADF1 JR Z,$AE34    ; }
; Handle "right".
 $ADF3 BIT 1,C       ; {Jump to #R$ADFB if "right" is not being pressed.
 $ADF5 JR Z,$ADFB    ; }
 $ADF7 LD A,E        ; {Add #N$20 to the X movement in #REGe.
 $ADF8 ADD A,$20     ;
 $ADFA LD E,A        ; }
; Handle "left".
@label=PlayerMovement_Left
*$ADFB BIT 0,C       ; {Jump to #R$AE03 if "left" is not being pressed.
 $ADFD JR Z,$AE03    ; }
 $ADFF LD A,E        ; {Subtract #N$20 from the X movement in #REGe.
 $AE00 SUB $20       ;
 $AE02 LD E,A        ; }
; Handle "up".
@label=PlayerMovement_Up
*$AE03 BIT 2,C       ; {Jump to #R$AE0B if "up" is not being pressed.
 $AE05 JR Z,$AE0B    ; }
 $AE07 LD A,D        ; {Subtract #N$20 from the Y movement in #REGd.
 $AE08 SUB $20       ;
 $AE0A LD D,A        ; }
; Handle "down".
@label=PlayerMovement_Down
*$AE0B BIT 3,C       ; {Jump to #R$AE13 if "down" is not being pressed.
 $AE0D JR Z,$AE13    ; }
 $AE0F LD A,D        ; {Add #N$20 to the Y movement in #REGd.
 $AE10 ADD A,$20     ;
 $AE12 LD D,A        ; }
; Update the player actor record and move the player.
@label=PlayerMovement_Move
*$AE13 LD (IX+$06),E ; Set the X velocity of the player.
 $AE16 LD (IX+$07),D ; Set the Y velocity of the player.
 $AE19 CALL $AFE8    ; Work out the new position of the player.
 $AE1C LD BC,$160E   ; Set the height of the player in #REGb to #N$16 and the width in
                     ; #REGc to #N$0E.
 $AE1F CALL $B81C    ; Stop the player passing through objects in the room.
 $AE22 CALL $AE4B    ; Animate the attacking player.
 $AE25 CALL $AAED    ; Test whether the player has stayed where it was.
 $AE28 LD (IX+$03),E ; Set the X position of the player.
 $AE2B LD (IX+$04),D ; Set the Y position of the player.
 $AE2E CALL NZ,$BF4B ; Play the footstep sound if the player moved.
 $AE31 JP $AD5D      ; Jump to #R$AD5D to display the player.

; Stop Attack
;
; Used by the routine at #R$ADD0.
; .
; Turns an attacking Sabreman back into a walking one, which faces right
; if the player was attacking to the right and left otherwise. The sprite IDs
; used are #N$14 and #N$10.
;
; C The controls
; DE The movement
; IX Actor record of the player
@label=StopAttack
c$AE34 BIT 3,(IX+$00) ; {Jump to #R$AE47 if the player was attacking to the left (bit 3 of
 $AE38 JR Z,$AE47     ; the sprite ID is reset).}
 $AE3A LD A,$14       ; Set the walking sprite ID in #REGa to #N$14.
; This entry point is used by the routine at #R$AE47.
@label=StopAttack_Sprite
*$AE3C LD (IX+$00),A  ; Set the sprite ID of the player.
 $AE3F LD A,$10       ; {Set the width of the player in #R$96AD to #N$10.
 $AE41 LD ($96AD),A   ; }
 $AE44 JP $AF1C       ; Jump to #R$AF1C to carry on with the controls.

; Stop Attack Left
;
; Used by the routine at #R$AE34.
; .
; Used by #R$AE34 to use the sprite ID for a walking Sabreman which is
; facing left.
@label=StopAttackLeft
c$AE47 LD A,$10      ; Set the walking sprite ID in #REGa to #N$10.
 $AE49 JR $AE3C      ; Jump to #R$AE3C.

; Animate Attack
;
; Used by the routine at #R$ADD0.
; .
; Sets the direction and animation of an attacking Sabreman. If the X
; velocity is positive then bit 3 of the sprite ID is set and the player
; attacks to the right, and if it is negative then bit 3 is reset. Every four
; frames the sprite is changed to one of the first eight frames at random.
;
; IX Actor record of the player
@label=AnimateAttack
c$AE4B LD A,(IX+$06) ; Fetch the X velocity of the player.
 $AE4E AND A         ; {Jump to #R$AE5C if the player is not moving left or
 $AE4F JR Z,$AE5C    ; right.}
 $AE51 JP M,$AE73    ; Jump to #R$AE73 if the player is moving left.
 $AE54 LD A,(IX+$00) ; Fetch the sprite ID of the player.
 $AE57 OR %00001000  ; Set bit 3 (attacking to the right).
@label=AnimateAttack_Store
*$AE59 LD (IX+$00),A ; Set the new sprite ID of the player.
@label=AnimateAttack_Frame
*$AE5C LD A,($5C78)  ; Fetch the low byte of #SKOOLKID$5C78(FRAMES).
 $AE5F AND %00000011 ; Keep only bits 0-1.
 $AE61 RET NZ        ; Return if this is not every fourth frame.
 $AE62 LD C,(IX+$00) ; Fetch the sprite ID of the player into #REGc.
 $AE65 LD A,($9695)  ; Fetch the random seed from #R$9695.
 $AE68 AND %00000111 ; Keep only bits 0-2.
 $AE6A LD B,A        ; Stash the random animation frame in #REGb.
 $AE6B LD A,C        ; Fetch the sprite ID of the player.
 $AE6C AND %11111000 ; Keep only bits 3-7.
 $AE6E OR B          ; Merge in the animation frame.
 $AE6F LD (IX+$00),A ; Set the new sprite ID of the player.
 $AE72 RET           ; Return.
@label=AnimateAttack_Left
*$AE73 LD A,(IX+$00) ; Fetch the sprite ID of the player.
 $AE76 AND %11110111 ; Keep only bits 0-2 and 4-7, which resets bit 3 (attacking to
                     ; the left).
 $AE78 JR $AE59      ; Jump to #R$AE59.

; Count Down Orchid Effect
;
; Used by the routines at #R$A61B and #R$AEEF.
; .
; Every other frame, counts down the orchid effect timer in #R$96B0. When
; the timer reaches zero the player goes back to the normal colour. The zero
; flag is set when the timer is zero or has just reached zero.
;
;   IX Actor record of the player
; O:F Zero flag set if the orchid effect is over
@label=HandlerOrchidTimer
c$AE7A LD A,($5C78)    ; Fetch the low byte of #SKOOLKID$5C78(FRAMES).
 $AE7D AND %00000001   ; Keep only bit 0.
 $AE7F RET NZ          ; Return every other frame.
 $AE80 LD A,($96B0)    ; Fetch the orchid effect timer from #R$96B0.
; See #POKE(always_walk_fast,Always walk fast).
 $AE83 AND A           ; {Return if there is no orchid effect.
 $AE84 RET Z           ; }
 $AE85 DEC A           ; Decrease the orchid effect timer by one.
 $AE86 LD ($96B0),A    ; Store the orchid effect timer in #R$96B0.
 $AE89 RET NZ          ; Return if the orchid effect has not run out.
 $AE8A LD (IX+$05),$47 ; Set the colour of the player back to #COLOUR$47.
 $AE8E RET             ; Return.

; Start Yellow Orchid Effect
;
; Used by the routine at #R$AEEF.
; .
; Makes the player sit down because of the yellow orchid, for a time of
; #N$60 (the orchid effect timer). The sprite ID is #N$43 if the player is
; facing left or #N$47 if the player is facing right, and the player is then
; handled by #R$A61B.
;
; IX Actor record of the player
;
; Fetch the current sprite ID of Sabreman.
@label=HandlerYellowOrchid
c$AE8F LD A,(IX+$00) ; Fetch the sprite ID of the player.
; This will leave either #N$00 or #N$04.
 $AE92 AND %00000100 ; Keep only bit 2.
; Add on #N$43.
 $AE94 OR %01000011  ; Set bits 0-1, 6.
; The resulting sprite ID will be either #R$D2B0(#SPRITENAME$43) or
; #R$D32A(#SPRITENAME($47)).
 $AE96 LD (IX+$00),A ; Set the new sprite ID of the player.
 $AE99 LD A,$60      ; {Set the orchid effect timer in #R$96B0 to #N$60.
 $AE9B LD ($96B0),A  ; }
 $AE9E JP $A61E      ; Jump to #R$A61E to count down the orchid effect.

; Flash Score Label
;
; Used by the routine at #R$AECF.
; .
; Used while the game is waiting to start the active player. Makes a low
; tone every sixteen frames and flashes the score label of the active player
; ("1UP" or "2UP").
;
; HL Address of the delay counter in #R$96B5
@label=ScoreLabelFlash
c$AEA1 LD A,(HL)     ; Fetch the start-of-turn delay.
 $AEA2 AND %00001111 ; Keep only bits 0-3.
 $AEA4 CALL Z,$BF2A  ; Play the low tone if the start-of-turn delay is a multiple of #N$10
                     ; (every sixteenth frame).
 $AEA7 LD A,($969E)  ; {Jump to #R$AECA to flash the 2UP score label if 2UP is the active
 $AEAA AND A         ; player (#R$969E is not zero).
 $AEAB JR NZ,$AECA   ; }
; Flash 1UP score label.
 $AEAD LD HL,$0010   ; #REGhl=#N($00,$02,$03),#N($10,$02,$03) (position of the
                     ; 1UP score label).
; Set flash state for the 3-attributes of the score label.
@label=FlashText
*$AEB0 CALL $B8DD    ; Find the attribute address of the score label.
 $AEB3 LD B,$03      ; Set the letter counter in #REGb to #N$03 (one for each letter of a
                     ; score label).
@label=FlashText_Loop
*$AEB5 LD A,(HL)     ; Fetch the attribute byte.
 $AEB6 OR %10000000  ; Ensure bit 7 is set (the flash bit).
 $AEB8 LD (HL),A     ; Write the attribute byte back.
 $AEB9 INC HL        ; Move onto the next attribute.
 $AEBA DJNZ $AEB5    ; Decrease the letter counter by one and loop back to #R$AEB5 until
                     ; all three letters have been flashed.
 $AEBC RET           ; Return.
; This entry point is used by the routine at #R$AECF.
; .
; Unset flash state for the 3-attributes of the score label.
@label=UnsetFlashText
*$AEBD CALL $B8DD    ; Find the attribute address of the score label.
 $AEC0 LD B,$03      ; Set the letter counter in #REGb to #N$03 (one for each letter of a
                     ; score label).
@label=UnsetFlashText_Loop
*$AEC2 LD A,(HL)     ; Fetch the attribute byte.
 $AEC3 AND %01111111 ; Keep only bits 0-6 (i.e. everything except the flash
                     ; bit).
 $AEC5 LD (HL),A     ; Write the attribute byte back.
 $AEC6 INC HL        ; Move onto the next attribute.
 $AEC7 DJNZ $AEC2    ; Decrease the letter counter by one and loop back to #R$AEC2 until
                     ; all three letters have been unflashed.
 $AEC9 RET           ; Return.
; Flash 2UP score label.
@label=FlashScoreLabel2UP
*$AECA LD HL,$00D8   ; #REGhl=#N($00,$02,$03),#N($D8,$02,$03) (position of the
                     ; 2UP score label).
 $AECD JR $AEB0      ; Jump to #R$AEB0.
; View the equivalent code in;
; #LIST
; { #COOKIE$7020 }
; { #LUNARJETMAN$8C3E }
; LIST#

; Game Play Entry
;
; Handles Sabreman while walking (sprite IDs #N$10 to #N$1F), but first
; deals with the delay at the start of each turn. While the delay timer in
; #R$96B5 is running, the player is neither drawn nor controlled and the score
; label of the player is flashed by #R$AEA1. When the delay ends the flash
; is turned off, the player is drawn and the normal handling at #R$AEEF
; starts.
;
; IX Actor record of the player
@label=GamePlayEntry
c$AECF LD HL,$96B5   ; {Jump to #R$AEEF if the start-of-turn delay in #R$96B5
 $AED2 LD A,(HL)     ; is zero.
 $AED3 AND A         ;
 $AED4 JR Z,$AEEF    ; }
 $AED6 DEC (HL)      ; Decrease the start-of-turn delay by one.
 $AED7 JR NZ,$AEA1   ; Jump to #R$AEA1 to flash the score label if the start-of-turn delay
                     ; is still running.
 $AED9 LD A,($969E)  ; {Jump to #R$AEEA if 2UP is the active player (#R$969E is
 $AEDC AND A         ; not zero).
 $AEDD JR NZ,$AEEA   ; }
; Handle turning off flash for 1UP score label.
 $AEDF LD HL,$0010   ; #REGhl=#N($00,$02,$03),#N($10,$02,$03) (position of the
                     ; 1UP score label).
@label=Game1UP_UnsetFlash
*$AEE2 CALL $AEBD    ; Stop the score label flashing.
 $AEE5 CALL $B919    ; Draw the player.
 $AEE8 JR $AEEF      ; Jump to #R$AEEF.
; Handle turning off flash for 2UP score label.
@label=Game2UP_UnsetFlash
*$AEEA LD HL,$00D8   ; #REGhl=#N($00,$02,$03),#N($D8,$02,$03) (position of 2UP
                     ; label).
 $AEED JR $AEE2      ; Jump to #R$AEE2.
; View the equivalent code in;
; #LIST
; { #COOKIE$7048 }
; { #JETPAC$73B2 }
; { #PSSST$6DBA }
; LIST#

; Game Play Start
;
; Used by the routine at #R$AECF.
; .
; Handles Sabreman while walking (sprite IDs #N$10 to #N$1F). The
; controls are read, with the effects of the orchids applied, and turned into
; an acceleration of #N$07 in each direction. The player is then moved, tested
; against the objects in the room and the walking animation is updated. If
; "fire" is pressed then the player starts to attack (see #R$ADBF). The
; velocities are then reduced by one so the player slides to a halt. Finally
; the player is displayed.
; .
; The effect of an orchid depends on the colour of the player: yellow
; (#COLOUR$46) makes the player sit down, magenta (#COLOUR$43) reverses the
; controls, red (#COLOUR$42) lowers the top speed and cyan (#COLOUR$45)
; increases the top speed. The colour white (#COLOUR$47) is normal.
;
; IX Actor record of the player
@label=GamePlay_Start
c$AEEF CALL $BB0B      ; Remember the previous position of the player.
; See #POKE(less_animals,Less Animals).
 $AEF2 CALL $A18C      ; Check the progress of the player.
; Is Sabreman yellow?
 $AEF5 LD A,(IX+$05)   ; Fetch the colour of the player.
 $AEF8 CP $46          ; {Jump to #R$AE8F if the player is yellow (#COLOUR$46).
 $AEFA JR Z,$AE8F      ; }
 $AEFC CALL $AE7A      ; Count down the orchid effect.
 $AEFF LD A,$10        ; {Set the width of the player in #R$96AD to #N$10.
 $AF01 LD ($96AD),A    ; }
; Check whether the player has been hit.
 $AF04 LD A,(IX+$02)   ; Fetch the hit direction of the player.
 $AF07 AND A           ; {Jump to #R$A985 if the player has been hit.
 $AF08 JP NZ,$A985     ; }
 $AF0B LD DE,$0000     ; Clear the movement of the player in #REGde.
 $AF0E CALL $B0A3      ; Read the controls.
; Is Sabreman magenta?
 $AF11 LD A,(IX+$05)   ; Fetch the colour of the player.
 $AF14 CP $43          ; {Jump to #R$AF1C if the player is not magenta
 $AF16 JR NZ,$AF1C     ; (#COLOUR$43).}
; Handles reversing the controls as a result of the magenta orchid.
 $AF18 LD A,C          ; Fetch the controls.
 $AF19 XOR %00001111   ; Flip bits 0-3 (swapping left with right and up with
                       ; down).
 $AF1B LD C,A          ; Store the reversed controls in #REGc.
; This entry point is used by the routine at #R$AE34.
@label=GamePlay_Controls
*$AF1C LD A,C          ; Fetch the controls.
 $AF1D LD ($96AC),A    ; Store the controls in #R$96AC.
; Turn the controls into an acceleration in #REGe (X) and #REGd (Y).
 $AF20 LD A,E          ; Fetch the X acceleration.
 $AF21 LD B,$07        ; Set the amount to accelerate by in #REGb to #N$07.
 $AF23 BIT 1,C         ; {Jump to #R$AF28 if "right" is not being pressed.
 $AF25 JR Z,$AF28      ; }
 $AF27 ADD A,B         ; Add the acceleration for "right".
@label=GamePlay_Left
*$AF28 BIT 0,C         ; {Jump to #R$AF2D if "left" is not being pressed.
 $AF2A JR Z,$AF2D      ; }
 $AF2C SUB B           ; Subtract the acceleration for "left".
@label=GamePlay_AccelerationX
*$AF2D LD E,A          ; Store the X acceleration in #REGe.
 $AF2E LD A,D          ; Fetch the Y acceleration.
 $AF2F BIT 3,C         ; {Jump to #R$AF34 if "down" is not being pressed.
 $AF31 JR Z,$AF34      ; }
 $AF33 ADD A,B         ; Add the acceleration for "down".
@label=GamePlay_Up
*$AF34 BIT 2,C         ; {Jump to #R$AF39 if "up" is not being pressed.
 $AF36 JR Z,$AF39      ; }
 $AF38 SUB B           ; Subtract the acceleration for "up".
@label=GamePlay_AccelerationY
*$AF39 LD D,A          ; Store the Y acceleration in #REGd.
 $AF3A CALL $AFAC      ; Accelerate the player.
 $AF3D CALL $AFE8      ; Work out the new position of the player.
 $AF40 LD BC,$160E     ; Set the height of the player in #REGb to #N$16 and the width in
                       ; #REGc to #N$0E.
 $AF43 CALL $B81C      ; Stop the player passing through objects in the room.
 $AF46 CALL $B053      ; Update the direction the player is facing.
 $AF49 CALL $AAED      ; Test whether the player has stayed where it was.
 $AF4C LD (IX+$03),E   ; Set the X position of the player.
 $AF4F LD (IX+$04),D   ; Set the Y position of the player.
 $AF52 CALL NZ,$BF4B   ; Play the footstep sound if the player has moved.
; Is Sabreman white?
 $AF55 LD A,(IX+$05)   ; Fetch the colour of the player.
 $AF58 CP $47          ; {Jump to #R$AF66 if the player is not white
 $AF5A JR NZ,$AF66     ; (#COLOUR$47).}
 $AF5C LD A,($96AC)    ; Fetch the controls from #R$96AC.
 $AF5F BIT 4,A         ; {Jump to #R$AF66 if "fire" is not being pressed.
 $AF61 JR Z,$AF66      ; }
 $AF63 CALL $ADBF      ; Start an attack.
; Reduce the velocities by one.
@label=GamePlay_Friction
*$AF66 LD A,(IX+$06)   ; Fetch the X velocity of the player.
 $AF69 LD B,$01        ; Set the amount to reduce the velocity by in #REGb to
                       ; #N$01.
 $AF6B CALL $B047      ; Reduce the X velocity.
 $AF6E LD (IX+$06),A   ; Set the new X velocity of the player.
 $AF71 LD A,(IX+$07)   ; Fetch the Y velocity of the player.
 $AF74 CALL $B047      ; Reduce the Y velocity.
 $AF77 LD (IX+$07),A   ; Set the new Y velocity of the player.
; This entry point is used by the routine at #R$A61B.
; .
; Display the player. While an orchid effect is about to wear off (the
; timer in #R$96B0 is below #N$2F) the player flashes between the colour of
; the orchid and white, with a sound at the start of each phase.
@label=GamePlay_Display
*$AF7A CALL $B9A9      ; Move the player on the screen.
 $AF7D LD A,($96B0)    ; Fetch the orchid effect timer from #R$96B0.
 $AF80 AND A           ; {Jump to #R$BB24 to colour the player if there is no
 $AF81 JP Z,$BB24      ; orchid effect.}
 $AF84 CP $2F          ; {Jump to #R$BB24 to colour the player if the orchid effect timer is
 $AF86 JP NC,$BB24     ; #N$2F or more.}
 $AF89 AND %00001111   ; Keep only bits 0-3.
 $AF8B CP $08          ; {Jump to #R$AFA4 if bit 3 of the orchid effect timer
 $AF8D JR NC,$AFA4     ; is set.}
 $AF8F AND %00000111   ; Keep only bits 0-2.
 $AF91 CALL Z,$BEC6    ; Play the orchid flash beep if the timer is at the start of the white
                       ; phase.
 $AF94 LD A,(IX+$05)   ; Fetch the colour of the player (the colour of the
                       ; orchid).
 $AF97 PUSH AF         ; Stash the colour of the orchid on the stack.
 $AF98 LD (IX+$05),$47 ; Set the colour of the player to #COLOUR$47.
 $AF9C CALL $BB24      ; Colour the player.
 $AF9F POP AF          ; Restore the colour of the orchid from the stack.
 $AFA0 LD (IX+$05),A   ; Set the colour of the player back to the colour of the
                       ; orchid.
 $AFA3 RET             ; Return.
; The player is drawn in the colour of the orchid.
@label=GamePlay_OrchidPhase
*$AFA4 AND %00000111   ; Keep only bits 0-2.
 $AFA6 CALL Z,$BEC6    ; Play the orchid flash beep if the timer is at the start of the
                       ; orchid phase.
 $AFA9 JP $BB24        ; Jump to #R$BB24 to colour the player.

; Accelerate Player
;
; Used by the routine at #R$AEEF.
; .
; Adds an acceleration to the velocity of the player in both directions
; and limits the result to the top speed (see #R$AFC1).
;
; D Y acceleration
; E X acceleration
; IX Actor record of the player
@label=AcceleratePlayer
c$AFAC LD A,E         ; Fetch the X acceleration.
 $AFAD ADD A,(IX+$06) ; Add the X velocity of the player.
 $AFB0 CALL $AFC1     ; Limit the X velocity.
 $AFB3 LD (IX+$06),A  ; Set the new X velocity of the player.
 $AFB6 LD A,D         ; Fetch the Y acceleration.
 $AFB7 ADD A,(IX+$07) ; Add the Y velocity of the player.
 $AFBA CALL $AFC1     ; Limit the Y velocity.
 $AFBD LD (IX+$07),A  ; Set the new Y velocity of the player.
 $AFC0 RET            ; Return.

; Limit Player Velocity
;
; Used by the routine at #R$AFAC.
; .
; Limits a velocity to the top speed of the player, which depends on the
; colour of the player. The top speed is #N$20 for red (#COLOUR$42), #N$40 for
; cyan (#COLOUR$45) and #N$30 otherwise. The velocity may be negative.
;
;   A Velocity
;   IX Actor record of the player
; O:A The limited velocity
@label=LimitPlayerVelocity
c$AFC1 PUSH AF       ; Stash the velocity on the stack.
 $AFC2 LD A,(IX+$05) ; Fetch the colour of the player.
 $AFC5 CP $42        ; {Jump to #R$AFE0 if the player is red (#COLOUR$42), which slows the
 $AFC7 JR Z,$AFE0    ; player.}
 $AFC9 CP $45        ; {Jump to #R$AFE4 if the player is cyan (#COLOUR$45), which speeds the
 $AFCB JR Z,$AFE4    ; player up.}
 $AFCD LD B,$30      ; Set the normal maximum speed in #REGb to #N$30.
; This entry point is used by the routines at #R$AFE0 and #R$AFE4.
@label=LimitPlayerVelocity_Restore
*$AFCF POP AF        ; Restore the velocity from the stack.

; Limit Velocity
;
; Used by the routine at #R$A4D7.
; .
; Limits a signed velocity to a maximum speed.
;
;   A Velocity
;   B Maximum speed
; O:A The limited velocity
@label=LimitVelocity
c$AFD0 JP M,$AFD7    ; Jump to #R$AFD7 if the velocity is negative.
 $AFD3 CP B          ; {Return if the velocity is less than the maximum speed.
 $AFD4 RET C         ; }
 $AFD5 LD A,B        ; Limit the velocity to the maximum speed.
 $AFD6 RET           ; Return.
@label=LimitVelocity_Negative
*$AFD7 NEG           ; Make the velocity positive.
 $AFD9 CP B          ; {Jump to #R$AFDD if the speed is less than the maximum
 $AFDA JR C,$AFDD    ; speed.}
 $AFDC LD A,B        ; Limit the speed to the maximum speed.
@label=LimitVelocity_Restore
*$AFDD NEG           ; Make the velocity negative again.
 $AFDF RET           ; Return.

; Set Slow Speed Limit
;
; Used by the routine at #R$AFC1.
; .
; Used by #R$AFC1 for the red orchid effect.
@label=SetSlowSpeedLimit
c$AFE0 LD B,$20      ; Set the slow maximum speed in #REGb to #N$20.
 $AFE2 JR $AFCF      ; Jump to #R$AFCF.

; Set Fast Speed Limit
;
; Used by the routine at #R$AFC1.
; .
; Used by #R$AFC1 for the cyan orchid effect.
@label=SetFastSpeedLimit
c$AFE4 LD B,$40      ; Set the fast maximum speed in #REGb to #N$40.
 $AFE6 JR $AFCF      ; Jump to #R$AFCF.

; Move Actor
;
; Used by the routines at #R$9E72, #R$9F16, #R$A858, #R$AB74, #R$AD07, #R$ADD0
; and #R$AEEF.
; .
; Works out the new position of an actor from its velocities. The
; velocities are signed and in units of one sixteenth of a pixel, so they are
; first scaled by #R$B031. The new position is returned in #REGe and #REGd and
; is not written to the actor record.
; .
; If the actor would move off the screen it is moved to the neighbouring room
; instead, using #R$B187 (left), #R$B19F (right), #R$B12F (below) or #R$B1AB
; (above). The top of the screen is at #N$28, the bottom at #N$C0 and the
; width of the actor (held in #R$96AD) is taken into account at the right.
;
;   IX Actor record
; O:D New Y position
; O:E New X position
@label=MoveActor
c$AFE8 LD A,(IX+$01)  ; {Store the room of the actor in #R$96AB.
 $AFEB LD ($96AB),A   ; }
 $AFEE LD D,(IX+$04)  ; Fetch the Y position of the actor into #REGd.
 $AFF1 LD A,(IX+$06)  ; Fetch the X velocity of the actor.
 $AFF4 CALL $B031     ; Convert the X velocity to whole pixels.
 $AFF7 AND A          ; {Jump to #R$B01A if the actor is moving left.
 $AFF8 JP M,$B01A     ; }
; The actor is moving right.
 $AFFB ADD A,(IX+$03) ; Add the X position of the actor.
 $AFFE LD E,A         ; Stash the new X position in #REGe.
 $AFFF LD A,($96AD)   ; Fetch the width of the actor from #R$96AD.
 $B002 ADD A,E        ; Add the new X position to find the right edge of the
                      ; actor.
 $B003 JP C,$B19F     ; Jump to #R$B19F if the actor has left the screen on the
                      ; right.
; This entry point is used by the routine at #R$B01A.
; .
; Now move the actor up or down.
@label=MoveActor_Vertical
*$B006 LD A,(IX+$07)  ; Fetch the Y velocity of the actor.
 $B009 CALL $B031     ; Convert the Y velocity to whole pixels.
 $B00C AND A          ; {Jump to #R$B027 if the actor is moving up.
 $B00D JP M,$B027     ; }
 $B010 ADD A,(IX+$04) ; Add the Y position of the actor.
 $B013 LD D,A         ; Stash the new Y position in #REGd.
 $B014 CP $C0         ; {Jump to #R$B12F if the actor has left the screen at
 $B016 JP NC,$B12F    ; the bottom.}
 $B019 RET            ; Return.

; Move Actor Left
;
; Used by the routine at #R$AFE8.
; .
; Used by #R$AFE8 when the actor is moving left. The new X position is
; found by taking the speed away from the current position. If it goes below
; zero the actor has moved into the room on the left.
;
; A X velocity in pixels (negative)
; D New Y position
; IX Actor record
@label=MoveActorLeft
c$B01A NEG           ; Make the speed positive.
 $B01C LD E,A        ; Stash the speed in #REGe.
 $B01D LD A,(IX+$03) ; Fetch the X position of the actor.
 $B020 SUB E         ; Subtract the speed.
 $B021 LD E,A        ; Stash the new X position in #REGe.
 $B022 JP C,$B187    ; Jump to #R$B187 if the actor has left the screen on the
                     ; left.
 $B025 JR $B006      ; Jump to #R$B006 to move the actor vertically.

; Move Actor Up
;
; Used by the routine at #R$AFE8.
; .
; Used by #R$AFE8 when the actor is moving up. If the new Y position is
; less than #N$28 the actor has moved into the room above.
;
; A Y velocity in pixels (negative)
; E New X position
; IX Actor record
@label=MoveActorUp
c$B027 ADD A,(IX+$04) ; Add the Y position of the actor.
 $B02A LD D,A         ; Stash the new Y position in #REGd.
 $B02B CP $28         ; {Jump to #R$B1AB if the actor has left the screen at
 $B02D JP C,$B1AB     ; the top.}
 $B030 RET            ; Return.

; Get Whole Pixels
;
; Used by the routines at #R$A44B and #R$AFE8.
; .
; Divides a signed velocity by sixteen, to give the number of whole
; pixels to move. The direction is kept. For example, #N$30 gives #N$03 and
; #N$D0 (-#N$30) gives #N$FD (-#N$03).
;
;   A Velocity
; O:A Pixels to move
@label=GetWholePixels
c$B031 AND A         ; {Jump to #R$B040 if the velocity is positive.
 $B032 JP P,$B040    ; }
 $B035 NEG           ; Make the velocity positive.
 $B037 RRCA          ; {Divide by sixteen (by rotating right four times).
 $B038 RRCA          ;
 $B039 RRCA          ;
 $B03A RRCA          ; }
 $B03B AND %00001111 ; Keep only bits 0-3.
 $B03D NEG           ; Make the result negative again.
 $B03F RET           ; Return.
@label=GetWholePixels_Positive
*$B040 RRCA          ; {Divide by sixteen (by rotating right four times).
 $B041 RRCA          ;
 $B042 RRCA          ;
 $B043 RRCA          ; }
 $B044 AND %00001111 ; Keep only bits 0-3.
 $B046 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$8F80 }
; LIST#

; Reduce Velocity
;
; Used by the routine at #R$AEEF.
; .
; Moves a signed velocity towards zero by a given amount. It will not go
; past zero.
;
;   A Velocity
;   B Amount to reduce the speed by
; O:A The new velocity
@label=ReduceVelocity
c$B047 AND A         ; {Jump to #R$B04F if the velocity is positive.
 $B048 JP P,$B04F    ; }
 $B04B ADD A,B       ; Add the amount to reduce the velocity by to the negative
                     ; velocity.
 $B04C RET NC        ; Return if the velocity is still negative.
 $B04D XOR A         ; Set the velocity to zero.
 $B04E RET           ; Return.
@label=ReduceVelocity_Positive
*$B04F SUB B         ; Subtract the amount to reduce the velocity by from the positive
                     ; velocity.
 $B050 RET NC        ; Return if the velocity is still positive.
 $B051 XOR A         ; Set the velocity to zero.
 $B052 RET           ; Return.

; Update Player Direction
;
; Used by the routine at #R$AEEF.
; .
; Sets the direction the player faces to match the way the player has
; moved. Bits 2-3 of the sprite ID hold the direction: #N$00 is left, #N$04
; is right, #N$08 is up and #N$0C is down. The vertical movement is tested
; first, so if the player has moved both horizontally and vertically then the
; horizontal direction is used. The walking animation is also advanced (see
; #R$B078).
;
; D New Y position
; E New X position
; IX Actor record of the player
@label=UpdatePlayerDirection
c$B053 CALL $B078    ; Animate the walking player.
 $B056 LD A,D        ; Fetch the new Y position.
 $B057 CP (IX+$04)   ; {Jump to #R$B066 if the player has not moved up or down.
 $B05A JR Z,$B066    ; }
 $B05C LD A,(IX+$00) ; Fetch the sprite ID of the player.
 $B05F JR C,$B099    ; Jump to #R$B099 if the player has moved up.
 $B061 OR %00001100  ; Set bits 2-3, so the player faces down.
; This entry point is used by the routine at #R$B099.
@label=UpdatePlayerDirection_Store
*$B063 LD (IX+$00),A ; Set the new sprite ID of the player.
@label=UpdatePlayerDirection_Horizontal
*$B066 LD A,E        ; Fetch the new X position.
 $B067 CP (IX+$03)   ; {Return if the player has not moved left or right.
 $B06A RET Z         ; }
 $B06B LD A,(IX+$00) ; Fetch the sprite ID of the player.
 $B06E JR C,$B09F    ; Jump to #R$B09F if the player has moved left.
 $B070 AND %11110011 ; Keep only bits 0-1, 4-7.
 $B072 OR %00000100  ; Set bit 2, so the player faces right.
; This entry point is used by the routine at #R$B09F.
@label=UpdatePlayerDirection_Write
*$B074 LD (IX+$00),A ; Set the new sprite ID of the player.
 $B077 RET           ; Return.

; Animate Walk
;
; Used by the routine at #R$B053.
; .
; Every other frame, if the player has moved, adds one to the animation
; frame in bits 0-1 of the sprite ID (wrapping from #N$03 round to #N$00).
;
; D New Y position
; E New X position
; IX Actor record of the player
@label=AnimateWalk
c$B078 LD A,($5C78)  ; Fetch the low byte of #SKOOLKID$5C78(FRAMES).
 $B07B AND %00000001 ; Keep only bit 0.
 $B07D RET NZ        ; Return if this is an odd frame.
 $B07E LD A,D        ; Fetch the new Y position.
 $B07F XOR (IX+$04)  ; Find the difference from the Y position of the player.
 $B082 LD C,A        ; Stash the Y difference in #REGc.
 $B083 LD A,E        ; Fetch the new X position.
 $B084 XOR (IX+$03)  ; Find the difference from the X position of the player.
 $B087 OR C          ; {Return if the player has not moved.
 $B088 RET Z         ; }
 $B089 LD A,(IX+$00) ; Fetch the sprite ID of the player.
 $B08C LD C,A        ; Stash the sprite ID in #REGc.
 $B08D INC A         ; Move on to the next frame of animation.
 $B08E AND %00000011 ; Keep only bits 0-1.
 $B090 LD B,A        ; Stash the new frame in #REGb.
 $B091 LD A,C        ; Fetch the old sprite ID.
 $B092 AND %11111100 ; Keep only bits 2-7.
 $B094 OR B          ; Merge in the new frame.
 $B095 LD (IX+$00),A ; Set the new sprite ID of the player.
 $B098 RET           ; Return.

; Face Up
;
; Used by the routine at #R$B053.
; .
; Used by #R$B053 to set the direction of the sprite to up.
;
; A Sprite ID
; IX Actor record of the player
@label=FaceUp
c$B099 AND %11110011 ; Keep only bits 0-1, 4-7.
 $B09B OR %00001000  ; Set bit 3.
 $B09D JR $B063      ; Jump to #R$B063.

; Face Left
;
; Used by the routine at #R$B053.
; .
; Used by #R$B053 to set the direction of the sprite to left.
;
; A Sprite ID
; IX Actor record of the player
@label=FaceLeft
c$B09F AND %11110011 ; Keep only bits 0-1, 4-7.
 $B0A1 JR $B074      ; Jump to #R$B074.

; Handler: Controls
;
; Used by the routines at #R$ADD0, #R$AEEF and #R$B6D7.
; .
; Reads the controls using the method chosen in the game options (see
; #R$9692): the keyboard, a Kempston joystick, a Cursor joystick or an
; Interface II joystick. Each of the routines returns the controls in #REGc,
; with a bit set for each direction or button pressed.
; #TABLE(default,centre,centre)
; { =h Bit | =h Action }
; { 0 | Left }
; { 1 | Right }
; { 2 | Up }
; { 3 | Down }
; { 4 | Fire }
; TABLE#
;
; O:C Controls
@label=HandlerControls
c$B0A3 LD A,($9692)  ; Fetch the game options from #R$9692.
 $B0A6 RRCA          ; Rotate out the number of players bit (bit 0).
 $B0A7 AND %00000011 ; Keep only bits 0-1 (Kempston and Cursor joystick
                     ; options).
 $B0A9 JR Z,$B0FA    ; Jump to #R$B0FA if the keyboard was selected (both control bits are
                     ; reset).
 $B0AB DEC A         ; {Jump to #R$B0D9 if the Kempston joystick was selected.
 $B0AC JR Z,$B0D9    ; }
 $B0AE DEC A         ; {Jump to #R$B103 if the Cursor joystick was selected.
 $B0AF JR Z,$B103    ; }
; View the equivalent code in;
; #LIST
; { #LUNARJETMAN$8F90 }
; LIST#
; .
; Else, handle Interface II joystick - it's the only option left.
; .
; Continue on to #R$B0B1.

; Controls: Interface II Joystick
;
; Reads an Interface II joystick, which is mapped onto the keys "6" to
; "0".
;
; O:A Joystick controls
; O:C Joystick controls
;
; Initialise the controls as "none" in #REGc.
@label=ReadInterfaceIIJoystick
c$B0B1 LD C,$00      ; Clear the controls in #REGc.
 $B0B3 LD A,$EF      ; {Read from the keyboard;
 $B0B5 OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $B0B7 IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$EF | 0 | 9 | 8 | 7 | 6 }
                     ; TABLE#}
; Check joystick "FIRE".
@label=ReadInterfaceIIJoystick_Fire
 $B0B9 BIT 0,A       ; {Jump to #R$B0BF if "FIRE" (key "0") is not being
 $B0BB JR NZ,$B0BF   ; pressed.}
 $B0BD SET 4,C       ; Set the "FIRE" bit (bit 4) of the controls in #REGc.
; Check joystick "UP".
@label=ReadInterfaceIIJoystick_Up
*$B0BF BIT 1,A       ; {Jump to #R$B0C5 if "UP" (key "9") is not being pressed.
 $B0C1 JR NZ,$B0C5   ; }
 $B0C3 SET 2,C       ; Set the "UP" bit (bit 2) of the controls in #REGc.
; Check joystick "DOWN".
@label=ReadInterfaceIIJoystick_Down
*$B0C5 BIT 2,A       ; {Jump to #R$B0CB if "DOWN" (key "8") is not being
 $B0C7 JR NZ,$B0CB   ; pressed.}
 $B0C9 SET 3,C       ; Set the "DOWN" bit (bit 3) of the controls in #REGc.
; Check joystick "RIGHT".
@label=ReadInterfaceIIJoystick_Right
*$B0CB BIT 3,A       ; {Jump to #R$B0D1 if "RIGHT" (key "7") is not being
 $B0CD JR NZ,$B0D1   ; pressed.}
 $B0CF SET 1,C       ; Set the "RIGHT" bit (bit 1) of the controls in #REGc.
; Check joystick "LEFT".
@label=ReadInterfaceIIJoystick_Left
*$B0D1 BIT 4,A       ; {Jump to #R$B0D7 if "LEFT" (key "6") is not being
 $B0D3 JR NZ,$B0D7   ; pressed.}
 $B0D5 SET 0,C       ; Set the "LEFT" bit (bit 0) of the controls in #REGc.
@label=HandlerInterfaceIIJoystick
*$B0D7 LD A,C        ; Fetch the controls.
 $B0D8 RET           ; Return.

; Controls: Kempston Joystick
;
; Used by the routine at #R$B0A3.
; .
; Reads a Kempston joystick from port #N$1F. A bit is set in the port for
; each direction or button pressed, which is moved onto the matching bit of
; the controls.
;
; O:A Joystick controls
; O:C Joystick controls
@label=ReadKempstonJoystick
c$B0D9 IN A,($1F)    ; Read the joystick port into #REGa.
; Initialise the controls as "none" in #REGc.
 $B0DB LD C,$00      ; Clear the controls in #REGc.
; Check joystick "RIGHT".
@label=ReadKempstonJoystick_Right
 $B0DD BIT 0,A       ; {Jump to #R$B0E3 if "RIGHT" is not being pressed.
 $B0DF JR Z,$B0E3    ; }
 $B0E1 SET 1,C       ; Set the "RIGHT" bit (bit 1) of the controls in #REGc.
; Check joystick "LEFT".
@label=ReadKempstonJoystick_Left
*$B0E3 BIT 1,A       ; {Jump to #R$B0E9 if "LEFT" is not being pressed.
 $B0E5 JR Z,$B0E9    ; }
 $B0E7 SET 0,C       ; Set the "LEFT" bit (bit 0) of the controls in #REGc.
; Check joystick "DOWN".
@label=ReadKempstonJoystick_Down
*$B0E9 BIT 2,A       ; {Jump to #R$B0EF if "DOWN" is not being pressed.
 $B0EB JR Z,$B0EF    ; }
 $B0ED SET 3,C       ; Set the "DOWN" bit (bit 3) of the controls in #REGc.
; Check joystick "UP".
@label=ReadKempstonJoystick_Up
*$B0EF BIT 3,A       ; {Jump to #R$B0F5 if "UP" is not being pressed.
 $B0F1 JR Z,$B0F5    ; }
 $B0F3 SET 2,C       ; Set the "UP" bit (bit 2) of the controls in #REGc.
; Check joystick "FIRE".
@label=ReadKempstonJoystick_Fire
*$B0F5 AND %00010000 ; Keep only bit 4 ("FIRE").
 $B0F7 OR C          ; {Merge the other controls into the "FIRE" bit and store the controls
 $B0F8 LD C,A        ; in #REGc.}
 $B0F9 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #COOKIE$6FB0 }
; { #JETPAC$733A }
; { #LUNARJETMAN$8F9B }
; { #MARTIANOIDS$B0B4 }
; { #PSSST$75CC }
; { #TRANZAM$6188 }
; LIST#

; Controls: Keyboard
;
; Used by the routine at #R$B0A3.
; .
; Reads the keys "Q", "W", "E", "R" and "T" and uses them directly as the
; controls, so "Q" is left, "W" is right, "E" is up, "R" is down and "T" is
; fire.
;
; O:C Keyboard controls
@label=ReadKeyboard
c$B0FA LD A,$FB      ; {Read from the keyboard;
 $B0FC OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $B0FE IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$FB | Q | W | E | R | T }
                     ; TABLE#}
 $B100 CPL           ; Flip the bits.
 $B101 LD C,A        ; Store the controls in #REGc.
 $B102 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #LUNARJETMAN$8F9F }
; LIST#

; Controls: Cursor Joystick
;
; Used by the routine at #R$B0A3.
; .
; Reads a Cursor joystick, which is mapped onto the keys "5" to "8" and
; "0".
;
; O:C Joystick controls
;
; Initialise the controls as "none" in #REGc.
@label=ReadCursorJoystick
c$B103 LD C,$00      ; Clear the controls in #REGc.
; The cursor keys are covered by different ports.
@label=HandleCursorJoystick_Port_F7
 $B105 LD A,$F7      ; {Read from the keyboard;
 $B107 OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $B109 IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$F7 | 1 | 2 | 3 | 4 | 5 }
                     ; TABLE#}
; Check joystick "LEFT".
@label=ReadCursorJoystick_Left
 $B10B BIT 4,A       ; {Jump to #R$B111 if "LEFT" (key "5") is not being
 $B10D JR NZ,$B111   ; pressed.}
 $B10F SET 0,C       ; Set the "LEFT" bit (bit 0) of the controls in #REGc.
; Handle the other port.
@label=HandleCursorJoystick_Port_EF
*$B111 LD A,$EF      ; {Read from the keyboard;
 $B113 OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $B115 IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$EF | 0 | 9 | 8 | 7 | 6 }
                     ; TABLE#}
; Check joystick "DOWN".
@label=ReadCursorJoystick_Down
 $B117 BIT 4,A       ; {Jump to #R$B11D if "DOWN" (key "6") is not being
 $B119 JR NZ,$B11D   ; pressed.}
 $B11B SET 3,C       ; Set the "DOWN" bit (bit 3) of the controls in #REGc.
; Check joystick "UP".
@label=ReadCursorJoystick_Up
*$B11D BIT 3,A       ; {Jump to #R$B123 if "UP" (key "7") is not being pressed.
 $B11F JR NZ,$B123   ; }
 $B121 SET 2,C       ; Set the "UP" bit (bit 2) of the controls in #REGc.
; Check joystick "RIGHT".
@label=ReadCursorJoystick_Right
*$B123 BIT 2,A       ; {Jump to #R$B129 if "RIGHT" (key "8") is not being
 $B125 JR NZ,$B129   ; pressed.}
 $B127 SET 1,C       ; Set the "RIGHT" bit (bit 1) of the controls in #REGc.
; Check joystick "FIRE".
@label=ReadCursorJoystick_Fire
*$B129 BIT 0,A       ; {Return if "FIRE" (key "0") is not being pressed.
 $B12B RET NZ        ; }
 $B12C SET 4,C       ; Set the "FIRE" bit (bit 4) of the controls in #REGc.
 $B12E RET           ; Return.
; View the equivalent code in;
; #LIST
; { #COOKIE$6FD7 }
; { #LUNARJETMAN$8F6A }
; LIST#

; Enter Room Below
;
; Used by the routine at #R$AFE8.
; .
; Used by #R$AFE8 when an actor has gone off the bottom of the screen.
; The actor is put at the top of the room below (the room number increases by
; #N$10) and its X position is changed to the entry point of the room, which
; is held in #R$6036 for the layout of the room (see #R$6066).
; .
; If the actor is not the player (the sprite ID is not #N$10 to #N$2F) then
; that is all. If it is the player then the new room is drawn and the delay
; before the flames appear is started.
;
;   IX Actor record
; O:D New Y position
; O:E New X position
@label=EnterRoomBelow
c$B12F LD D,$27      ; Set the Y position to the top of the play area (#N$27).
 $B131 LD A,(IX+$01) ; Fetch the room of the actor.
 $B134 ADD A,$10     ; Move to the room below.
 $B136 LD (IX+$01),A ; Set the new room of the actor.
 $B139 LD L,A        ; {Use the room as the offset into the layout table.
 $B13A LD H,$00      ; }
 $B13C LD BC,$6066   ; {Add the layout table at #R$6066 to get the address of the layout
 $B13F ADD HL,BC     ; number.}
 $B140 LD L,(HL)     ; Fetch the layout number of the room.
 $B141 LD H,$00      ; Clear #REGh.
 $B143 LD BC,$6036   ; {Add the table of entry X positions at #R$6036 to get the address of
 $B146 ADD HL,BC     ; the X position.}
 $B147 LD E,(HL)     ; Fetch the X position at which the actor enters the room.
; This entry point is used by the routines at #R$B187 and #R$B1AB.
; .
; This is where the other routines to enter a room join in.
@label=EnterRoom
*$B148 LD A,(IX+$00) ; Fetch the sprite ID of the actor.
 $B14B SUB $10       ; Subtract #N$10 (the first Sabreman sprite ID).
 $B14D CP $20        ; {Return if the actor is not the player.
 $B14F RET NC        ; }
 $B150 PUSH DE       ; Stash the new position on the stack.
 $B151 CALL $BB7C    ; Clear the attribute buffer of the play area.
 $B154 CALL $BB5C    ; Clear the play area.
 $B157 CALL $BBDD    ; Draw the new room.
 $B15A CALL $BB0B    ; Remember the previous position of the player.
 $B15D CALL $B919    ; Draw the player.
 $B160 CALL $9D23    ; Mark the new room as visited.
 $B163 POP DE        ; Restore the new position from the stack.
 $B164 LD A,$80      ; {Set the flame spawn delay in #R$96B4 to #N$80.
 $B166 LD ($96B4),A  ; }
 $B169 RET           ; Return.

; Update Moved Actor
;
; This code is not used. If the actor was in the room of the player (the
; room saved in #R$96AB) then it is removed from the screen. If the actor is
; now in the room of the player then it is drawn and stored.
;
; DE Position of the actor
; IX Actor record
u$B16A DEFB $3A,$AB,$96 ; #REGa=*#R$96AB.
 $B16D DEFB $47         ; Store the room in #REGb.
 $B16E DEFB $3A,$03,$97 ; #REGa=*#R$9703 (the room of the player).
 $B171 DEFB $B8         ; Compare with the room in #REGb.
 $B172 DEFB $D5         ; Stash #REGde on the stack.
 $B173 DEFB $CC,$F5,$B8 ; Call #R$B8F5 if the actor was in the room of the
                        ; player.
 $B176 DEFB $D1         ; Restore #REGde from the stack.
 $B177 DEFB $3A,$03,$97 ; #REGa=*#R$9703 (the room of the player).
 $B17A DEFB $DD,$BE,$01 ; Compare with #REGix+#N$01 (the room of the actor).
 $B17D DEFB $C0         ; Return if the actor is not in the room of the player.
 $B17E DEFB $D5         ; Stash #REGde on the stack.
 $B17F DEFB $CD,$19,$B9 ; Draw the actor.
 $B182 DEFB $CD,$0B,$BB ; Remember the position of the actor.
 $B185 DEFB $D1         ; Restore #REGde from the stack.
 $B186 DEFB $C9         ; Return.

; Enter Room Left
;
; Used by the routine at #R$B01A.
; .
; Used by #R$AFE8 when an actor has gone off the left of the screen. The
; actor is put at the right of the room to the left (the room number is one
; less, but the room stays in the same row of the map) and its X position is
; set so that its right edge is at the edge of the screen.
;
;   IX Actor record
; O:E New X position
@label=EnterRoomLeft
c$B187 LD A,($96AD)  ; Fetch the width of the actor from #R$96AD.
 $B18A NEG           ; Negate the width.
 $B18C DEC A         ; Subtract one.
 $B18D LD E,A        ; Stash the new X position in #REGe.
 $B18E LD A,(IX+$01) ; Fetch the room of the actor.
 $B191 LD C,A        ; Stash the room in #REGc.
 $B192 DEC A         ; Move to the room on the left.
; This entry point is used by the routine at #R$B19F.
@label=EnterRoomLeft_Row
*$B193 AND %00001111 ; Keep only bits 0-3 (the column).
 $B195 LD B,A        ; Stash the column in #REGb.
 $B196 LD A,C        ; Fetch the old room.
 $B197 AND %11110000 ; Keep only bits 4-7 (the row).
 $B199 OR B          ; Merge in the new column.
 $B19A LD (IX+$01),A ; Set the new room of the actor.
 $B19D JR $B148      ; Jump to #R$B148.

; Enter Room Right
;
; Used by the routine at #R$AFE8.
; .
; Used by #R$AFE8 when an actor has gone off the right of the screen. The
; actor is put at the left of the room to the right (the room number is one
; more, but the room stays in the same row of the map).
;
;   IX Actor record
; O:E New X position
@label=EnterRoomRight
c$B19F LD E,$00      ; Set the X position to the left edge of the screen
                     ; (#N$00).
 $B1A1 LD A,(IX+$01) ; Fetch the room of the actor.
 $B1A4 LD C,A        ; Stash the room in #REGc.
 $B1A5 INC A         ; Move to the room on the right.
 $B1A6 LD (IX+$01),A ; Set the new room of the actor.
 $B1A9 JR $B193      ; Jump to #R$B193.

; Enter Room Above
;
; Used by the routine at #R$B027.
; .
; Used by #R$AFE8 when an actor has gone off the top of the screen. The
; actor is put at the bottom of the room above (the room number decreases by
; #N$10) without changing its X position.
;
;   IX Actor record
; O:D New Y position
@label=EnterRoomAbove
c$B1AB LD D,$BF      ; Set the Y position to the bottom of the play area
                     ; (#N$BF).
 $B1AD LD A,(IX+$01) ; Fetch the room of the actor.
 $B1B0 SUB $10       ; Subtract #N$10 to move to the room above.
 $B1B2 LD (IX+$01),A ; Set the new room of the actor.
 $B1B5 JR $B148      ; Jump to #R$B148.

; Start Turn
;
; Used by the routine at #R$B1D4.
; .
; Sets up the delays at the start of a turn of a player, removes any
; orchid effect, takes one life from the player and displays the new number of
; lives. The start-of-turn delay (#R$96B5) is also what flashes the score
; label of the player (see #R$AECF).
@label=StartTurn
c$B1B7 LD HL,$9702   ; Point #REGhl at the player's actor at #R$9702.
 $B1BA LD A,$10      ; {Set the nastie spawn delay in #R$96B1 to #N$10.
 $B1BC LD ($96B1),A  ; }
 $B1BF LD A,$80      ; {Set the flame spawn delay in #R$96B4 to #N$80.
 $B1C1 LD ($96B4),A  ; }
 $B1C4 LD A,$80      ; {Set the start-of-turn delay in #R$96B5 to #N$80.
 $B1C6 LD ($96B5),A  ; }
 $B1C9 XOR A         ; {Clear the orchid effect timer in #R$96B0.
 $B1CA LD ($96B0),A  ; }
 $B1CD LD HL,$96BD   ; Point #REGhl at the number of lives at #R$96BD.
; See #POKE(infinite_lives_player_2,Infinite Lives Player 2).
 $B1D0 DEC (HL)      ; Decrease the number of lives by one.
 $B1D1 JP $B7CD      ; Jump to #R$B7CD to update the lives display.

; Initialise Game
;
; Used by the routine at #R$9960.
; .
; Sets up the state of both players ready for a new game, builds the first
; room and starts the turn of player 1. A one player game gives player 2 no
; lives.
; .
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After #R$B1D4 }
; { #SIM(start=$9960,stop=$998F,clear=1,sp=$5B40)
; #SCR$01(initialise-game-before)
; | #SIM(start=$99A7,stop=$99AA,sp=$5B40)
; #SCR$01(initialise-game-after) } UDGTABLE# #POPS
;
; .
;
; Initialise player 2.
@label=InitialiseGame
c$B1D4 CALL $B21E    ; Initialise the player.
 $B1D7 CALL $B235    ; Swap over to the other player.
; Initialise player 1.
 $B1DA CALL $B21E    ; Initialise the player.
; Always start on player 1.
 $B1DD XOR A         ; {Set the active player to 1UP in #R$969E.
 $B1DE LD ($969E),A  ; }
 $B1E1 CALL $BB7C    ; Clear the attribute buffer of the play area.
 $B1E4 CALL $BB5C    ; Clear the play area.
 $B1E7 LD A,($9692)  ; Fetch the game options from #R$9692.
 $B1EA AND %00000001 ; Keep only bit 0.
 $B1EC JR NZ,$B1F1   ; Jump to #R$B1F1 if this is a two player game.
 $B1EE LD ($96E0),A  ; Set the number of lives of player 2 in #R$96E0 to zero.
; This entry point is used by the routine at #R$B205.
; .
; This is also where the next player joins in after the other player has
; died.
@label=InitialiseGame_StartTurn
*$B1F1 CALL $B1B7    ; Start the turn.
 $B1F4 LD IX,$9702   ; Point #REGix at the player's actor at #R$9702.
 $B1F8 CALL $9D23    ; Mark the room as visited.
 $B1FB CALL $A763    ; Load the orchid for the room.
 $B1FE CALL $A33B    ; Set up the objects in the room.
 $B201 CALL $BBDD    ; Draw the current room.
 $B204 RET           ; Return.

; Switch Player
;
; Used by the routine at #R$AA27.
; .
; Used when a player has died in a two player game. Swaps over the state
; of the two players, clears the screen and makes the new player stand up with
; the normal colour, then carries on at #R$B1F1.
@label=SwitchPlayer
c$B205 CALL $B235      ; Swap over the states of the two players.
 $B208 CALL $BB7C      ; Clear the attribute buffer of the play area.
 $B20B CALL $BB5C      ; Clear the play area.
 $B20E LD A,(IX+$00)   ; Fetch the sprite ID of the player.
 $B211 AND %00000111   ; Keep only bits 0-2.
 $B213 OR %00010000    ; Set bit 4, giving a sprite ID of #N$10 to #N$17.
 $B215 LD (IX+$00),A   ; Set the new sprite ID of the player.
 $B218 LD (IX+$05),$47 ; Set the colour of the player to #COLOUR$47.
 $B21C JR $B1F1        ; Jump to #R$B1F1 to start the turn.

; Initialise Player
;
; Used by the routine at #R$B1D4.
; .
; Sets up the state of the current player: five lives, a limit of three
; nasties per room, and a new set of actors, amulet pieces and room objects.
;
; .
;
; Set starting lives.
@label=InitialisePlayer
c$B21E LD A,$05      ; {Set the number of lives in #R$96BD to #N$05.
 $B220 LD ($96BD),A  ; }
 $B223 LD A,$03      ; {Set the nastie limit in #R$96BE to #N$03.
 $B225 LD ($96BE),A  ; }
 $B228 XOR A         ; {Clear #R$96BC (purpose not yet known, as this is never
 $B229 LD ($96BC),A  ; read).}
 $B22C CALL $AC6B    ; Reset the actors.
 $B22F CALL $A255    ; Place the amulet pieces.
 $B232 JP $A2BD      ; Jump to #R$A2BD to generate the objects in the rooms.

; 1UP/ 2UP Swapper
;
; Used by the routines at #R$B1D4 and #R$B205.
; .
; Swaps over the state of player 1 and player 2, by swapping three blocks
; of memory with the stored copy for the other player. The active player flag
; in #R$969E is also flipped. The blocks swapped are:
; #TABLE(default,centre,centre,centre)
; { =h Active | =h Stored | =h Bytes }
; { #R$96BC | #R$96DF | #N($0023,$04,$04) }
; { #R$DDEC | #R$DFEC | #N($0200,$04,$04) }
; { #R$9702 | #R$982E | #N($012C,$04,$04) }
; TABLE#
@label=ChangePlayer
c$B235 LD A,($969E)  ; Fetch the active player from #R$969E.
 $B238 CPL           ; Flip the bits to switch to the other player.
 $B239 LD ($969E),A  ; Store the new active player in #R$969E.
; These are all the player states.
 $B23C LD HL,$96BC   ; Point #REGhl at the state of the active player at
                     ; #R$96BC.
 $B23F LD DE,$96DF   ; Point #REGde at the state of the inactive player at
                     ; #R$96DF.
 $B242 LD BC,$0023   ; Set the number of bytes to swap in #REGbc to #N$0023.
 $B245 CALL $B25D    ; Swap the bytes.
; These are the room objects.
 $B248 LD HL,$DDEC   ; Point #REGhl at the room objects of the active player at
                     ; #R$DDEC.
 $B24B LD DE,$DFEC   ; Point #REGde at the room objects of the inactive player
                     ; at #R$DFEC.
 $B24E LD BC,$0200   ; Set the number of bytes to swap in #REGbc to #N$0200.
 $B251 CALL $B25D    ; Swap the bytes.
; And these are the actors.
 $B254 LD HL,$9702   ; Point #REGhl at the actors of the active player at
                     ; #R$9702.
 $B257 LD DE,$982E   ; Point #REGde at the actors of the inactive player at
                     ; #R$982E.
 $B25A LD BC,$012C   ; Set the number of bytes to swap in #REGbc to #N$012C.
; Swap the bytes at #REGhl and #REGde, for the number of bytes in #REGbc.
@label=ChangePlayer_Loop
*$B25D LD A,(DE)     ; Fetch a byte of the inactive player's data.
 $B25E EX AF,AF'     ; Switch to the shadow #REGaf register.
 $B25F LD A,(HL)     ; {Copy a byte of the active player's data over the inactive player's
 $B260 LD (DE),A     ; data.}
 $B261 EX AF,AF'     ; Switch back to the normal #REGaf register.
 $B262 LD (HL),A     ; Write the inactive player's byte over the active
                     ; player's data.
 $B263 INC DE        ; Move onto the next byte of the inactive player's data.
 $B264 INC HL        ; Move onto the next byte of the active player's data.
 $B265 DEC BC        ; Decrease the byte counter by one.
 $B266 LD A,B        ; {Loop back to #R$B25D until all of the bytes have been
 $B267 OR C          ; swapped.
 $B268 JR NZ,$B25D   ; }
 $B26A RET           ; Return.
; View the equivalent code in;
; #LIST
; { #COOKIE$6416 }
; { #JETPAC$616A }
; { #LUNARJETMAN$A880 }
; { #PSSST$613B }
; LIST#

; Initialise Hall Of Fame Timer
;
; Used by the routine at #R$B272.
; .
; Sets the counter which counts the time left before the hall of fame is
; shown from the game selection menu (see #R$B272) to #N($0300,$04,$04).
@label=InitialiseHallOfFameTimer
c$B26B LD HL,$0300   ; {Set the hall of fame timer in #R$96B8 to #N$0300.
 $B26E LD ($96B8),HL ; }
 $B271 RET           ; Return.

; Handler: Hall Of Fame
;
; Used by the routine at #R$B43E.
; .
; Called from the game selection menu (see #R$B43E). If the options have
; been changed then the counter is set again. Otherwise the counter in #R$96B8
; is decreased, and when it reaches zero the hall of fame is shown (see
; #R$B29F). The hall of fame stays on screen until a key is pressed, or until
; about twelve times #N($FFFF,$04,$04) loops of the delay have passed. The
; game selection menu is then drawn again.
; .
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After #R$B272 }
; { #SIM(start=$9960,stop=$998F,clear=1,sp=$5B40)
; #SIM(start=$B3D5,stop=$B3EC,sp=$5B40)
; #SCR$01(handler-hall-of-fame-before)
; | #POKES$96B8,$01;$96B9,$00
; #SIM(start=$B43E,stop=$B286,sp=$5B40)
; #SCR$01(handler-hall-of-fame-after) } UDGTABLE# #POPS
;
; F Zero flag set if the options have not changed
@label=HandlerHallOfFame
c$B272 JR NZ,$B26B   ; Jump to #R$B26B to restart the hall of fame timer if the options
                     ; have been changed.
 $B274 LD HL,($96B8) ; {Decrease the hall of fame timer in #R$96B8 by one.
 $B277 DEC HL        ;
 $B278 LD ($96B8),HL ; }
 $B27B LD A,H        ; {Return unless the hall of fame timer has run out.
 $B27C OR L          ;
 $B27D RET NZ        ; }
; This entry point is used by the routine at #R$AAA4.
@label=HandlerHallOfFame_Show
*$B27E CALL $B29F    ; Show the hall of fame.
 $B281 LD B,$0C      ; Set the number of waits in #REGb to #N$0C.
 $B283 LD HL,$0000   ; Set the wait counter in #REGhl to zero.
; Wait for a key to be pressed or for the time to run out.
@label=HandlerHallOfFame_Wait
*$B286 XOR A         ; Select every row of the keyboard.
 $B287 OUT ($FD),A   ; Select the keyboard rows (this does nothing on a 48K).
 $B289 IN A,($FE)    ; Read the keyboard.
 $B28B CPL           ; Flip the bits.
 $B28C AND %00011111 ; Keep only bits 0-4.
 $B28E JR NZ,$B297   ; Jump to #R$B297 if a key has been pressed.
 $B290 DEC HL        ; Decrease the wait counter by one.
 $B291 LD A,H        ; {Loop back to #R$B286 until the wait counter is zero.
 $B292 OR L          ;
 $B293 JR NZ,$B286   ; }
 $B295 DJNZ $B286    ; Decrease the number of waits by one and loop back to #R$B286 until
                     ; all of the waits are done.
@label=HandlerHallOfFame_Finish
*$B297 CALL $B2D8    ; Clear the panel.
 $B29A CALL $B473    ; Print the game selection menu.
 $B29D JR $B26B      ; Jump to #R$B26B to restart the hall of fame timer.
; View the equivalent code in;
; #LIST
; { #MARTIANOIDS$B760 }
; { #MARTIANOIDS$B76C }
; LIST#

; Show Hall Of Fame
;
; Used by the routine at #R$B272.
; .
; Clears the panel in the middle of the screen, prints the eight lines of
; text of the hall of fame (the title, the six positions and the copyright
; message) and then prints the six scores and initials from #R$B304, one under
; the other.
; .
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After #R$B29F }
; { #SIM(start=$9960,stop=$998F,clear=1,sp=$5B40)
; #SIM(start=$B3D5,stop=$B3EC,sp=$5B40)
; #SCR$01(hall-of-fame-before)
; | #SIM(start=$B27E,stop=$B281,sp=$5B40)
; #SCR$01(hall-of-fame-after) } UDGTABLE# #POPS
@label=HallOfFame
c$B29F CALL $B2D8    ; Clear the panel.
 $B2A2 LD DE,$B32E   ; Point #REGde at the attributes of the lines of text at
                     ; #R$B32E.
 $B2A5 EXX           ; Switch to the shadow registers.
 $B2A6 LD HL,$B336   ; Point #REGhl' at the positions of the lines of text at
                     ; #R$B336.
 $B2A9 LD DE,$B346   ; Point #REGde' at the lines of text at #R$B346.
; There are eight lines of text.
 $B2AC LD B,$08      ; Set the number of lines of text in the shadow #REGb register to
                     ; #N$08.
 $B2AE CALL $B47F    ; Print the lines of text.
; Print the scores. #REGc is the counter for the six positions.
 $B2B1 LD BC,$0306   ; Set the number of scores in #REGc to #N$06 (and #REGb to
                     ; #N$03).
 $B2B4 LD DE,$B304   ; Point #REGde at the first high score at #R$B304.
 $B2B7 LD HL,$4868   ; #REGhl=#N($4868,$04,$04) (the Y position of the first score is
                     ; #N$48 and the X position is #N$68).
@label=HallOfFame_Loop
*$B2BA PUSH BC       ; Stash the score counter on the stack.
 $B2BB PUSH HL       ; Stash the position of the score on the stack.
 $B2BC CALL $B8AD    ; Convert the position into a screen address.
 $B2BF CALL $B5E4    ; Print the score.
 $B2C2 LD B,$03      ; Set the number of initials in #REGb to #N$03.
 $B2C4 INC L         ; {Move three characters to the right.
 $B2C5 INC L         ;
 $B2C6 INC L         ; }
; Print the three initials.
@label=HallOfFame_Initials
*$B2C7 LD A,(DE)     ; Fetch an initial.
 $B2C8 INC DE        ; Move onto the next initial.
 $B2C9 CALL $B589    ; Print the initial.
 $B2CC DJNZ $B2C7    ; Decrease the initial counter by one and loop back to #R$B2C7 until
                     ; all three initials have been printed.
 $B2CE POP HL        ; Restore the position of the score from the stack.
 $B2CF LD A,H        ; Fetch the Y position.
 $B2D0 ADD A,$10     ; Add #N$10 to move down two lines of text.
 $B2D2 LD H,A        ; Set the new Y position.
 $B2D3 POP BC        ; Restore the score counter from the stack.
 $B2D4 DEC C         ; {Decrease the score counter by one and loop back to #R$B2BA until all
 $B2D5 JR NZ,$B2BA   ; six scores have been printed.}
 $B2D7 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #MARTIANOIDS$B78C }
; LIST#

; Clear Panel
;
; Used by the routines at #R$B272, #R$B29F and #R$B61E.
; .
; Clears the panel which is used for the hall of fame and for entering a
; new high score. The panel is #N$18 characters wide, #N$10 characters high
; and starts at column #N$04 of row #N$05. The attributes are set to #N$00 and
; the pixels are set to zero.
; .
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After #R$B2D8 }
; { #SIM(start=$9960,stop=$998F,clear=1,sp=$5B40)
; #SIM(start=$B3D5,stop=$B3EC,sp=$5B40)
; #SIM(start=$B27E,stop=$B281,sp=$5B40)
; #SCR$01(clear-panel-before)
; | #SIM(start=$B297,stop=$B29A,sp=$5B40)
; #SCR$01(clear-panel-after) } UDGTABLE# #POPS
;
; .
;
; Clear the attributes.
@label=HallOfFame_Clear
c$B2D8 LD HL,$58A4   ; Point #REGhl at the first attribute of the panel.
 $B2DB LD BC,$1810   ; #REGbc=#N($1810,$04,$04) (#REGb is the width and #REGc is the number
                     ; of rows).
 $B2DE LD DE,$0020   ; #REGde=#N($0020,$04,$04) (the number of bytes to the
                     ; next row).
@label=HallOfFame_Clear_Attribute_Rows
*$B2E1 PUSH BC       ; Stash the counters on the stack.
 $B2E2 PUSH HL       ; Stash the start of the row on the stack.
@label=HallOfFame_Clear_Attribute_Row
*$B2E3 LD (HL),$00   ; Clear the attribute.
 $B2E5 INC L         ; Move to the next column.
 $B2E6 DJNZ $B2E3    ; Decrease #REGb by one and loop back to #R$B2E3 until the row
                     ; is done.
 $B2E8 POP HL        ; Restore the start of the row from the stack.
 $B2E9 ADD HL,DE     ; Move down to the next row.
 $B2EA POP BC        ; Restore the counters from the stack.
 $B2EB DEC C         ; {Decrease the row counter by one and loop back to #R$B2E1 until all
 $B2EC JR NZ,$B2E1   ; of the rows are done.}
; Clear the pixels.
 $B2EE LD HL,$40A4   ; Point #REGhl at the first pixel line of the panel.
 $B2F1 LD BC,$1880   ; #REGbc=#N($1880,$04,$04) (#REGb is the width and #REGc is the number
                     ; of pixel lines).
@label=HallOfFame_Clear_Pixel_Lines
*$B2F4 PUSH BC       ; Stash the counters on the stack.
 $B2F5 PUSH HL       ; Stash the start of the pixel line on the stack.
@label=HallOfFame_Clear_Pixel_Line
*$B2F6 LD (HL),$00   ; Clear a byte of the pixel line.
 $B2F8 INC L         ; Move to the next column.
 $B2F9 DJNZ $B2F6    ; Decrease #REGb by one and loop back to #R$B2F6 until the line
                     ; is done.
 $B2FB POP HL        ; Restore the start of the pixel line from the stack.
 $B2FC CALL $B8CC    ; Move down to the next pixel line.
 $B2FF POP BC        ; Restore the counters from the stack.
 $B300 DEC C         ; {Decrease the pixel line counter by one and loop back to #R$B2F4
 $B301 JR NZ,$B2F4   ; until all of the pixel lines are done.}
 $B303 RET           ; Return.

; High Scores
;
; Each high score slot uses 3-bytes for the score with the players initials.
; .
; Most other Ultimate games only hold the high score.
;
; .
;
; Top score.
@label=Top_HighScore_1
g$B304 DEFB $10      ; Byte #1.
@label=Top_HighScore_2
 $B305 DEFB $22      ; Byte #2.
@label=Top_HighScore_3
 $B306 DEFB $75      ; Byte #3.
@label=Top_HighScore_Initials
 $B307 DEFM "ULT"    ; "#STR(#PC,$04,$03)".
; 2nd place.
@label=Pos_2_HighScore_1
 $B30A DEFB $05      ; Byte #1.
@label=Pos_2_HighScore_2
 $B30B DEFB $51      ; Byte #2.
@label=Pos_2_HighScore_3
 $B30C DEFB $50      ; Byte #3.
@label=Pos_2_HighScore_Initials
 $B30D DEFM "ACG"    ; "#STR(#PC,$04,$03)".
; 3rd place.
@label=Pos_3_HighScore_1
 $B310 DEFB $03      ; Byte #1.
@label=Pos_3_HighScore_2
 $B311 DEFB $78      ; Byte #2.
@label=Pos_3_HighScore_3
 $B312 DEFB $95      ; Byte #3.
@label=Pos_3_HighScore_Initials
 $B313 DEFM "CTJ"    ; "#STR(#PC,$04,$03)".
; 4th place.
@label=Pos_4_HighScore_1
 $B316 DEFB $02      ; Byte #1.
@label=Pos_4_HighScore_2
 $B317 DEFB $43      ; Byte #2.
@label=Pos_4_HighScore_3
 $B318 DEFB $20      ; Byte #3.
@label=Pos_4_HighScore_Initials
 $B319 DEFM "TDJ"    ; "#STR(#PC,$04,$03)".
; 5th place.
@label=Pos_5_HighScore_1
 $B31C DEFB $01      ; Byte #1.
@label=Pos_5_HighScore_2
 $B31D DEFB $27      ; Byte #2.
@label=Pos_5_HighScore_3
 $B31E DEFB $75      ; Byte #3.
@label=Pos_5_HighScore_Initials
 $B31F DEFM "JSL"    ; "#STR(#PC,$04,$03)".
; 6th place.
@label=Pos_6_HighScore_1
 $B322 DEFB $00      ; Byte #1.
@label=Pos_6_HighScore_2
 $B323 DEFB $82      ; Byte #2.
@label=Pos_6_HighScore_3
 $B324 DEFB $50      ; Byte #3.
@label=Pos_6_HighScore_Initials
 $B325 DEFM "CLW"    ; "#STR(#PC,$04,$03)".
; New high score entry buffer.
@label=New_HighScore_1
 $B328 DEFB $00      ; Byte #1.
@label=New_HighScore_2
 $B329 DEFB $00      ; Byte #2.
@label=New_HighScore_3
 $B32A DEFB $00      ; Byte #3.
@label=New_HighScore_Initials
 $B32B DEFM "   "    ; "#STR(#PC,$04,$03)".
; View the equivalent code in;
; #LIST
; { #JETPAC$5CF0 }
; { #LUNARJETMAN$5E06 }
; { #PSSST$5E00 }
; { #TRANZAM$5E49 }
; LIST#

; Hall Of Fame Attribute Table
;
; The attribute used for each of the eight lines of text of the hall of
; fame: white for the title and the first two positions, yellow for the third
; and fourth positions, cyan for the fifth and sixth and white for the
; copyright message.
@label=HallOfFame_Attributes
b$B32E DEFB $47      ; {#TABLE(default,centre)
 $B32F DEFB $47      ; { =h Byte(n) | =h Menu Item }
 $B330 DEFB $47      ; { #N$01 | ULTIMATE HALL OF FAME }
 $B331 DEFB $46      ; { #N$02 | 1ST }
 $B332 DEFB $46      ; { #N$03 | 2ND }
 $B333 DEFB $45      ; { #N$04 | 3RD }
 $B334 DEFB $45      ; { #N$05 | 4TH }
 $B335 DEFB $47      ; { #N$06 | 5TH }
                     ; { #N$07 | 6TH }
                     ; { #N$08 | © 1984 A.C.G. }
                     ; TABLE#}

; Hall Of Fame Position Table
;
; The X and Y positions (in pixels) of each of the eight lines of text of
; the hall of fame.
@label=HallOfFame_Position
b$B336 DEFB $28,$30  ; {#TABLE(default,centre,centre,centre)
 $B338 DEFB $38,$48  ; { =h X Position | =h Y Position | =h Menu Item }
 $B33A DEFB $38,$58  ; { #N(#EVAL(#PEEK(#PC+$00) / $08)) | #N(#EVAL(#PEEK(#PC+$01)) / $08) | ULTIMATE HALL OF FAME }
 $B33C DEFB $38,$68  ; { #N(#EVAL(#PEEK(#PC+$02) / $08)) | #N(#EVAL(#PEEK(#PC+$03)) / $08) | 1ST }
 $B33E DEFB $38,$78  ; { #N(#EVAL(#PEEK(#PC+$04) / $08)) | #N(#EVAL(#PEEK(#PC+$05)) / $08) | 2ND }
 $B340 DEFB $38,$88  ; { #N(#EVAL(#PEEK(#PC+$06) / $08)) | #N(#EVAL(#PEEK(#PC+$07)) / $08) | 3RD }
 $B342 DEFB $38,$98  ; { #N(#EVAL(#PEEK(#PC+$08) / $08)) | #N(#EVAL(#PEEK(#PC+$09)) / $08) | 4TH }
 $B344 DEFB $48,$B0  ; { #N(#EVAL(#PEEK(#PC+$0A) / $08)) | #N(#EVAL(#PEEK(#PC+$0B)) / $08) | 5TH }
                     ; { #N(#EVAL(#PEEK(#PC+$0C) / $08)) | #N(#EVAL(#PEEK(#PC+$0D)) / $08) | 6TH }
                     ; { #N(#EVAL(#PEEK(#PC+$0E) / $08)) | #N(#EVAL(#PEEK(#PC+$0F)) / $08) | © 1984 A.C.G }
                     ; TABLE#}

; Messaging: Hall Of Fame Screen Text
;
; The eight lines of text of the hall of fame. The last character of each
; string has bit 7 set.
@label=HallOfFame_Text
t$B346 DEFM "ULTIMATE HALL OF FAM","E"+$80 ; "#STR(#PC)".
 $B35B DEFM "1ST              "," "+$80    ; "#STR(#PC,$04)".
 $B36D DEFM "2ND              "," "+$80    ; "#STR(#PC,$04)".
 $B37F DEFM "3RD              "," "+$80    ; "#STR(#PC,$04)".
 $B391 DEFM "4TH              "," "+$80    ; "#STR(#PC,$04)".
 $B3A3 DEFM "5TH              "," "+$80    ; "#STR(#PC,$04)".
 $B3B5 DEFM "6TH              "," "+$80    ; "#STR(#PC,$04)".
 $B3C7 DEFM $7F," 1984  A.C.G","."+$80     ; "#STR(#PC)".

; Handler: Game Menu
;
; Used by the routine at #R$9960.
; .
; Shows the game selection menu and waits for the player to start the
; game. The keys are:
; #TABLE(default,centre,centre)
; { =h Key | =h Action }
; { 1 | One player game }
; { 2 | Two player game }
; { 3 | Keyboard controls }
; { 4 | Kempston joystick }
; { 5 | Cursor joystick }
; { 6 | Interface II joystick }
; { 0 | Start the game }
; TABLE#
; The choices are stored in #R$9692.
; .
; The tune at #R$BC67 is played while the menu is waiting, and a key press
; stops it. While nothing is changed the hall of fame is shown after a time
; (see #R$B272).
; .
; #HTML(#AUDIO0(main-tune.wav)(#INCLUDE(MainTune)))
; .
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$9960,stop=$998F,clear=1,sp=$5B40)
; #SCR$01(game-menu-before)
; | #SIM(start=$B3D5,stop=$B3EC,sp=$5B40)
; #SCR$01(game-menu-after) } UDGTABLE# #POPS
@label=HandlerGameMenu
c$B3D5 LD A,$FF      ; {Set the last seen options in #R$96B7 to #N$FF.
 $B3D7 LD ($96B7),A  ; }
 $B3DA CALL $BB7C    ; Clear the attribute buffer of the play area.
 $B3DD CALL $BB5C    ; Clear the play area.
 $B3E0 LD HL,$61C6   ; #REGhl=#R$61C6.
 $B3E3 CALL $BBF7    ; Draw the room.
 $B3E6 CALL $B473    ; Print the game selection menu.
 $B3E9 CALL $B43E    ; Update the flashing selections.
 $B3EC LD DE,$BC67   ; Point #REGde at the music at #R$BC67.
 $B3EF CALL $BD51    ; Play the music until a key is pressed.
@label=HandlerGameMenu_Loop
*$B3F2 CALL $B473    ; Print the game selection menu.
 $B3F5 LD A,$F7      ; {Read from the keyboard;
 $B3F7 OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $B3F9 IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$F7 | 1 | 2 | 3 | 4 | 5 }
                     ; TABLE#}
 $B3FB CPL           ; Flip the bits.
 $B3FC LD E,A        ; Store the result in #REGe.
 $B3FD LD A,($9692)  ; Fetch the game options from #R$9692.
; Handle 1UP game selection.
@label=GameSelect_Check1UP
 $B400 BIT 0,E       ; {Jump to #R$B406 if key "1" ("1 PLAYER GAME") has not
 $B402 JR Z,$B406    ; been pressed.}
 $B404 RES 0,A       ; Select a one player game by resetting bit 0.
; Handle 2UP game selection.
@label=GameSelect_Check2UP
*$B406 BIT 1,E       ; {Jump to #R$B40C if key "2" ("2 PLAYER GAME") has not
 $B408 JR Z,$B40C    ; been pressed.}
 $B40A SET 0,A       ; Select a two player game by setting bit 0.
; Handle Keyboard selection.
@label=GameSelect_CheckKeyboard
*$B40C BIT 2,E       ; {Jump to #R$B412 if key "3" ("KEYBOARD") has not been
 $B40E JR Z,$B412    ; pressed.}
 $B410 AND %11111001 ; Select the keyboard by clearing the control method.
; Handle Kempston Joystick selection.
@label=GameSelect_CheckKempston
*$B412 BIT 3,E       ; {Jump to #R$B41A if key "4" ("KEMPSTON JOYSTICK") has not been
 $B414 JR Z,$B41A    ; pressed.}
 $B416 AND %11111001 ; Clear the control method.
 $B418 OR %00000010  ; Select the Kempston joystick by setting control method
                     ; #N$02.
; Handle Cursor Joystick selection.
@label=GameSelect_CheckCursor
*$B41A BIT 4,E       ; {Jump to #R$B422 if key "5" ("CURSOR JOYSTICK") has not
 $B41C JR Z,$B422    ; been pressed.}
 $B41E AND %11111001 ; Clear the control method.
 $B420 OR %00000100  ; Select the Cursor joystick by setting control method
                     ; #N$04.
; This entry point is used by the routine at #R$BD51.
@label=GameSelect_ReadSecondKeyRow
*$B422 LD C,A        ; Stash the game options in #REGc.
 $B423 LD A,$EF      ; {Read from the keyboard;
 $B425 OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $B427 IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$EF | 0 | 9 | 8 | 7 | 6 }
                     ; TABLE#}
 $B429 CPL           ; Flip the bits.
 $B42A LD E,A        ; Store the result in #REGe.
 $B42B LD A,C        ; Restore the game options to #REGa.
; Handle Interface II Joystick selection.
@label=GameSelect_CheckInterface2
 $B42C BIT 4,E       ; {Jump to #R$B432 if key "6" ("INTERFACE II") has not
 $B42E JR Z,$B432    ; been pressed.}
 $B430 OR %00000110  ; Select the Interface II joystick by setting control method
                     ; #N$06.
@label=GameSelect_StoreOptions
*$B432 LD ($9692),A  ; Store the game options in #R$9692.
; Handle starting a new game.
@label=GameSelect_Start
 $B435 BIT 0,E       ; {Return if key "0" ("START GAME") has been pressed.
 $B437 RET NZ        ; }
 $B438 CALL $B43E    ; Update the flashing selections.
 $B43B JP $B3F2      ; Jump to #R$B3F2.

; Update Game Menu
;
; Used by the routine at #R$B3D5.
; .
; Called when the selections on the game selection menu may have changed.
; Records the selections in #R$96B7 and counts down to the hall of fame (see
; #R$B272) and then makes the two selected options (the number of players and
; the controls) flash, and the others not.
; .
; #PUSHS #UDGTABLE(default,centre)
; { =h Before }
; { #SIM(start=$9960,stop=$998F,clear=1,sp=$5B40)
; #SIM(start=$B3D5,stop=$B3E9,sp=$5B40)
; #SCR$02,$02,$04,$1C,$0E(update-menu-before) }
; { =h After #R$B43E }
; { #SIM(start=$B3E9,stop=$B3EC,sp=$5B40)
; #SCR$02,$02,$04,$1C,$0E(update-menu-after) } UDGTABLE# #POPS
@label=HallOfFameCheck
c$B43E LD HL,$96B7   ; Point #REGhl at the last seen options at #R$96B7.
 $B441 LD A,($9692)  ; Fetch the game options from #R$9692.
 $B444 CP (HL)       ; Compare the game options with the last ones seen.
 $B445 LD ($96B7),A  ; Store the game options as the last ones seen.
 $B448 CALL $B272    ; Check the hall of fame timer.
; Handle flashing each selection.
 $B44B LD HL,$B498   ; Point #REGhl at the attributes of the selections at
                     ; #R$B498.
 $B44E LD A,($9692)  ; Fetch the game options from #R$9692.
 $B451 LD C,A        ; Stash the game options in #REGc.
; There are two player options to choose from (1UP or 2UP game).
 $B452 LD B,$02      ; Set the number of player options in #REGb to #N$02.
 $B454 AND %00000001 ; Keep only bit 0 (the player options).
 $B456 CALL $B463    ; Flash the selected player option.
 $B459 LD A,C        ; Restore the game options to #REGa.
 $B45A RRCA          ; Rotate out the number of players bit.
 $B45B AND %00000011 ; Keep only bits 0-1 (the control options).
; There are four control methods to choose from.
 $B45D LD B,$04      ; Set the number of control methods in #REGb to #N$04.
 $B45F CALL $B463    ; Flash the selected control method.
 $B462 RET           ; Return.
; Selection flashing routine.
@label=HandlerMenuAttributeFlash
*$B463 AND A         ; {Jump to #R$B46D if this is not the selected option.
 $B464 JR NZ,$B46D   ; }
@label=MenuAttributeSet
*$B466 SET 7,(HL)    ; Make the selection flash.
 $B468 JR $B46F      ; Jump to #R$B46F.
@label=HandlerMenuAttributeFlash_Loop
*$B46A DEC A         ; Decrease the selection counter by one.
 $B46B JR Z,$B466    ; Jump to #R$B466 if this is the selected option.
@label=MenuAttributeUnset
*$B46D RES 7,(HL)    ; Stop the selection flashing.
@label=MenuAttributeNext
*$B46F INC HL        ; Move onto the attribute of the next option.
 $B470 DJNZ $B46A    ; Decrease the option counter by one and loop back to #R$B46A until
                     ; all of the options have been done.
 $B472 RET           ; Return.

; Game Selection Menu
;
; Used by the routines at #R$B272 and #R$B3D5.
; .
; Prints the eight lines of text of the game selection menu, each with
; its own attribute (see #R$B498), at the positions in #R$B4A0. The entry point
; at #R$B47F is also used to print the hall of fame, which has its own tables.
; .
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After #R$B473 }
; { #SIM(start=$9960,stop=$998F,clear=1,sp=$5B40)
; #SIM(start=$B3D5,stop=$B3E6,sp=$5B40)
; #SCR$01(selection-menu-before)
; | #SIM(start=$B3E6,stop=$B3E9,sp=$5B40)
; #SCR$01(selection-menu-after) } UDGTABLE# #POPS
@label=GameMenu
c$B473 LD DE,$B498   ; Point #REGde at the attributes of the lines of text at
                     ; #R$B498.
 $B476 EXX           ; Switch to the shadow registers.
 $B477 LD HL,$B4A0   ; Point #REGhl' at the positions of the lines of text at
                     ; #R$B4A0.
 $B47A LD DE,$B4B0   ; Point #REGde' at the lines of text at #R$B4B0.
; There are eight lines of text.
 $B47D LD B,$08      ; Set the number of lines of text in the shadow #REGb register to
                     ; #N$08.
; This entry point is used by the routines at #R$B29F and #R$B61E.
@label=GameMenu_Loop
*$B47F EXX           ; Switch back to the normal registers.
 $B480 LD A,(DE)     ; {Copy the attribute of the line of text to #R$96A8.
 $B481 LD ($96A8),A  ; }
 $B484 INC DE        ; Move onto the attribute of the next line of text.
 $B485 EXX           ; Switch to the shadow registers.
 $B486 PUSH BC       ; Stash the line counter on the stack.
 $B487 LD A,(HL)     ; Fetch the X position of the line of text.
 $B488 INC HL        ; {Move onto the position of the next line of text.
 $B489 INC HL        ; }
 $B48A PUSH HL       ; Stash the position pointer on the stack.
 $B48B DEC HL        ; Move back to the Y position of the line of text.
 $B48C LD H,(HL)     ; Set the Y position in #REGh.
 $B48D LD L,A        ; Set the X position in #REGl.
 $B48E CALL $B52D    ; Print the line of text.
 $B491 EXX           ; Switch to the shadow registers.
 $B492 POP HL        ; {Restore the position pointer and the line counter from
 $B493 POP BC        ; the stack.}
 $B494 INC DE        ; Move onto the next line of text.
 $B495 DJNZ $B47F    ; Decrease the line counter by one and loop back to #R$B47F until all
                     ; of the lines of text have been printed.
 $B497 RET           ; Return.
