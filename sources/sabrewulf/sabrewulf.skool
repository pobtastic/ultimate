; TABLE#
@label=Poem_2_Copy
t$A0A7 DEFB $18,$80                             ; X / Y position.
 $A0A9 DEFB $47                                 ; Attribute.
 $A0AA DEFM "TWO PIECES FOUND ARE YOUR","S"+$80 ; "#STR(#PC)".
 $A0C4 DEFB $60,$90                             ; X / Y position.
