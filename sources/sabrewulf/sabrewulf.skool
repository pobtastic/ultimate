 $BE56 DEFB $91,$02,$34,$00
 $BE5A DEFB $7B,$02,$37,$00
 $BE5E DEFB $66,$02,$3A,$00
 $BE62 DEFB $51,$02,$3E,$00
 $BE66 DEFB $3F,$02,$41,$00
 $BE6A DEFB $2D,$02,$45,$00
 $BE6E DEFB $1C,$02,$49,$00
 $BE72 DEFB $0C,$02,$4E,$00
 $BE76 DEFB $FD,$01,$52,$00
 $BE7A DEFB $EF,$01,$57,$00
 $BE7E DEFB $E2,$01,$5D,$00
 $BE82 DEFB $D5,$01,$62,$00
 $BE86 DEFB $C9,$01,$68,$00
 $BE8A DEFB $BD,$01,$6E,$00
 $BE8E DEFB $B3,$01,$75,$00
 $BE92 DEFB $A9,$01,$7B,$00
 $BE96 DEFB $9F,$01,$83,$00
 $BE9A DEFB $96,$01,$8B,$00
 $BE9E DEFB $8E,$01,$93,$00
 $BEA2 DEFB $86,$01,$9C,$00
 $BEA6 DEFB $7E,$01,$A5,$00
 $BEAA DEFB $77,$01,$AF,$00
 $BEAE DEFB $71,$01,$B9,$00
 $BEB2 DEFB $6A,$01,$C4,$00
 $BEB6 DEFB $64,$01,$D0,$00
 $BEBA DEFB $5F,$01,$DC,$00
 $BEBE DEFB $59,$01,$E9,$00
 $BEC2 DEFB $54,$01,$F7,$00
; View the equivalent code in;
; #LIST
; { #COOKIE$6594 }
