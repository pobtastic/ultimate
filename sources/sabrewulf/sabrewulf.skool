; Sprite: None
;
; The blank sprite. Its width and height are both zero, so nothing is
; drawn. It is used by the sprite IDs which show nothing: #N$00, #N$07,
; #N$0E-#N$0F, #N$5A-#N$5B, #N$5E-#N$5F, #N$7C-#N$7F and #N$96-#N$97 (see
; #R$BF84).
@label=Sprite_None
b$C10C DEFB $00      ; Width = #N(#PEEK(#PC)) bytes.
 $C10D DEFB $00      ; Height = #N(#PEEK(#PC)) pixels.

