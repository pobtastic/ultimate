; Print Percentage Explored
;
; Used by the routine at #R$AA6A.
; .
; Works out how much of the jungle the player has explored and prints the
; result as a percentage on the game over screen.
; .
; The number of rooms visited (the bits set in the bitmap at #R$96BF) plus the
; number of amulet pieces collected (the bits set in the low four bits of
; #R$970D) is converted into a percentage of #N($0104,$04,$04) (the #N$0100
; rooms plus the four amulet pieces). The result is held as two BCD bytes in
; #R$96B6 (the hundreds) and #R$96B7 (the tens and units) before being printed.
; .
; #PUSHS #UDGTABLE(default,centre)
; { =h Before }
; { #SIM(start=$9960,stop=$998F,clear=1,sp=$5B40)
; #SIM(start=$99A7,stop=$99AA,sp=$5B40)
; #POKES$96BF,$FF,$0A
; #SIM(start=$AA6A,stop=$AA87,sp=$5B40)
; #SCR$02,$02,$0B,$1C,$06(percentage-before) }
; { =h After #R$9CC6 }
; { #SIM(start=$AA87,stop=$AA8A,sp=$5B40)
; #SCR$02,$02,$0B,$1C,$06(percentage-after) } UDGTABLE# #POPS
;
; .
;
; Count the number of rooms which have been visited.
@label=PrintRoomsVisited
c$9CC6 LD DE,$0000   ; Set the count of rooms visited and amulet pieces collected in #REGde
                     ; to #N$0000.
 $9CC9 LD BC,$0820   ; Set the bit counter in #REGb to #N$08 and the byte counter in #REGc
                     ; to #N$20.
 $9CCC LD HL,$96BF   ; Point #REGhl at the visited rooms bitmap at #R$96BF.
@label=PrintRoomsVisited_CountByte
*$9CCF PUSH BC       ; Stash the counters on the stack.
 $9CD0 LD A,(HL)     ; Fetch the next byte of the visited rooms bitmap.
 $9CD1 INC HL        ; Move onto the next byte of the bitmap.
@label=PrintRoomsVisited_CountBit
*$9CD2 RRCA          ; Rotate the bit for the next room into the carry flag.
 $9CD3 JR NC,$9CD6   ; Jump to #R$9CD6 if the room has not been visited.
 $9CD5 INC DE        ; Add the room to the count in #REGde.
@label=PrintRoomsVisited_NextBit
*$9CD6 DJNZ $9CD2    ; Decrease the bit counter by one and loop back to #R$9CD2 until all
                     ; eight rooms in the byte have been checked.
 $9CD8 POP BC        ; Restore the counters from the stack.
 $9CD9 DEC C         ; {Decrease the byte counter by one and jump back to #R$9CCF until all
 $9CDA JR NZ,$9CCF   ; #N$20 bytes of the bitmap have been counted.}
; Add the number of amulet pieces which have been collected.
 $9CDC LD A,($970D)  ; Fetch the amulet pieces collected from #R$970D.
 $9CDF LD B,$04      ; Set the amulet piece counter in #REGb to #N$04.
@label=PrintRoomsVisited_CountPiece
*$9CE1 RRCA          ; Rotate the flag for the next amulet piece into the carry
                     ; flag.
 $9CE2 JR NC,$9CE5   ; Jump to #R$9CE5 if the amulet piece has not been
                     ; collected.
 $9CE4 INC DE        ; Add the amulet piece to the count in #REGde.
@label=PrintRoomsVisited_NextPiece
*$9CE5 DJNZ $9CE1    ; Decrease the amulet piece counter by one and loop back to #R$9CE1
                     ; until all four pieces have been checked.
; Multiply the count by #N$6276 (#N$10000 * #N$64 / #N($0104,$04,$04)) by
; repeated addition. Every time the sum in #REGhl overflows the carry is added
; to #REGa, which is kept in BCD, so #REGa ends up holding the percentage.
 $9CE7 LD BC,$6276   ; Set the multiplier in #REGbc to #N$6276.
 $9CEA LD HL,$0000   ; Clear the running total in #REGhl.
 $9CED XOR A         ; Clear the percentage in #REGa.
@label=PrintRoomsVisited_Multiply
*$9CEE ADD HL,BC     ; Add the multiplier to the running total.
 $9CEF ADC A,$00     ; Add any carry to the percentage.
 $9CF1 DAA           ; Adjust the percentage to be a BCD number.
 $9CF2 DEC DE        ; Decrease the count of rooms and amulet pieces by one.
 $9CF3 PUSH AF       ; Stash the percentage so far on the stack.
 $9CF4 LD A,E        ; {Jump to #R$9CFB if the count has run out.
 $9CF5 OR D          ;
 $9CF6 JR Z,$9CFB    ; }
 $9CF8 POP AF        ; Restore the percentage so far from the stack.
 $9CF9 JR $9CEE      ; Jump back to #R$9CEE to keep adding.
; Round the result up and store the percentage as BCD.
@label=PrintRoomsVisited_Store
*$9CFB POP AF        ; Restore the percentage from the stack.
 $9CFC LD BC,$0028   ; Set the rounding value in #REGbc to #N$0028.
 $9CFF ADD HL,BC     ; Add the rounding value to the running total.
 $9D00 ADC A,$00     ; Add any carry to the percentage.
 $9D02 DAA           ; Adjust the percentage to be a BCD number.
 $9D03 LD ($96B7),A  ; Store the tens and units of the percentage in #R$96B7.
 $9D06 LD A,$00      ; Set the hundreds in #REGa to #N$00.
 $9D08 ADC A,$00     ; Add the carry flag (the percentage is #N$100 if it is
                     ; set).
 $9D0A DAA           ; Adjust the hundreds to be a BCD number.
 $9D0B LD ($96B6),A  ; Store the hundreds of the percentage in #R$96B6.
; Print the percentage, leaving out the hundreds digit if it is zero.
 $9D0E LD HL,$48F8   ; Set the print position in #REGhl to #N$48F8 in the
                     ; screen buffer.
 $9D11 LD DE,$96B6   ; Point #REGde at the percentage at #R$96B6.
 $9D14 LD B,$01      ; Set the number of bytes to print in #REGb to #N$01.
 $9D16 LD A,(DE)     ; {Jump to #R$9D1E if the hundreds are zero.
 $9D17 AND A         ;
 $9D18 JR Z,$9D1E    ; }
 $9D1A INC B         ; Print both bytes of the percentage.
 $9D1B JP $B5F0      ; Jump to #R$B5F0 to print the low digit of the first byte and then
                     ; the digits of the second byte.
@label=PrintRoomsVisited_SkipHundreds
*$9D1E INC HL        ; Move the print position on past the unused hundreds
                     ; digit.
 $9D1F INC DE        ; Move onto the tens and units of the percentage.
 $9D20 JP $B5E4      ; Jump to #R$B5E4 to print both digits of the byte.
; View the equivalent code in;
; #LIST
; { #ATICATAC$96C9 }
; LIST#

; Visit Room
;
; Used by the routines at #R$B12F and #R$B1D4.
; .
; Marks the room that an actor is in as having been visited, by setting
; its bit in the bitmap at #R$96BF (the bitmap holds one bit for each of the
; #N($0100,$04,$04) rooms). This uses self-modifying code: the second byte of
; the "SET n,(HL)" instruction at #R$9D3E is overwritten to select the bit.
;
; IX Actor record
;
; Work out which byte of the bitmap holds the bit for the room.
@label=VisitRoom
c$9D23 LD A,(IX+$01) ; Fetch the room of the actor.
 $9D26 LD C,A        ; Stash the room in #REGc.
 $9D27 RRCA          ; {Divide the room by #N$08
 $9D28 RRCA          ; (each byte of the bitmap holds the bits for #N$08 rooms).
 $9D29 RRCA          ; }
 $9D2A AND %00011111 ; Keep only bits 0-4.
 $9D2C LD L,A        ; {Use it as the offset into the visited rooms bitmap.
 $9D2D LD H,$00      ; }
; Work out which bit of that byte is needed and modify the instruction.
 $9D2F LD A,C        ; Fetch the room.
 $9D30 RLCA          ; {Multiply by #N$08 so that the low three bits of the room are in bits
 $9D31 RLCA          ; 3-5.
 $9D32 RLCA          ; }
 $9D33 AND %00111000 ; Keep only the bit number (bits 3-5).
 $9D35 OR %11000110  ; Set bits 1-2, 6-7 (to make the second byte of "SET
                     ; n,(HL)").
 $9D37 LD ($9D3F),A  ; Write this into the second byte of the instruction at
                     ; #R$9D3E.
; Set the bit.
 $9D3A LD BC,$96BF   ; {Add the start of the visited rooms bitmap at #R$96BF to
 $9D3D ADD HL,BC     ; the offset.}
 $9D3E SET 0,(HL)    ; Set the bit for the room in the bitmap.
 $9D40 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$96AF }
; { #KNIGHTLORE$D219 }
; LIST#

; Test Amulet Proximity
;
; Used by the routine at #R$AB74.
; .
; Tests whether an actor is close to any of the four amulet pieces which
; have not been collected yet (those with a non-zero sprite ID in the records
; at #R$97FE). A piece counts as close if either of these is true:
; #LIST
; { the column of the room (bits 0-3 of the room number) matches the column
; of the room of the piece and the X positions are less than #N$10 apart }
; { the row of the room (bits 4-7 of the room number) matches the row of the
; room of the piece and the Y positions are less than #N$10 apart }
; LIST#
; The room is only compared in part so the test does not require the actor and
; the piece to be in exactly the same room.
;
;   IX Actor record
; O:A The distance to the piece which is close
; O:F Carry flag set if an amulet piece is close
;
; Check each of the four amulet piece records in turn.
@label=TestAmuletProximity
c$9D41 LD DE,$000B   ; Set the offset to the next amulet piece in #REGde to
                     ; #N$0B.
 $9D44 LD HL,$97FE   ; Point #REGhl at the first amulet piece record at
                     ; #R$97FE.
 $9D47 LD B,$04      ; Set the amulet piece counter in #REGb to #N$04.
@label=TestAmuletProximity_Loop
*$9D49 LD A,(HL)     ; Fetch the sprite ID of the amulet piece.
 $9D4A INC HL        ; Move onto the room of the amulet piece.
 $9D4B AND A         ; {Jump to #R$9D66 if the amulet piece is not present.
 $9D4C JR Z,$9D66    ; }
; Compare the columns of the rooms.
 $9D4E LD A,(HL)     ; Fetch the room of the amulet piece.
 $9D4F AND %00001111 ; Keep only the column of the room (bits 0-3).
 $9D51 LD C,A        ; Stash the column of the amulet piece in #REGc.
 $9D52 LD A,(IX+$01) ; Fetch the room of the actor.
 $9D55 AND %00001111 ; Keep only the column of the room (bits 0-3).
 $9D57 CP C          ; {Jump to #R$9D6B if the actor is in the same column as the amulet
 $9D58 JR Z,$9D6B    ; piece.}
; Compare the rows of the rooms.
@label=TestAmuletProximity_Rows
*$9D5A LD A,(HL)     ; Fetch the room of the amulet piece.
 $9D5B AND %11110000 ; Keep only the row of the room (bits 4-7).
 $9D5D LD C,A        ; Stash the row of the amulet piece in #REGc.
 $9D5E LD A,(IX+$01) ; Fetch the room of the actor.
 $9D61 AND %11110000 ; Keep only the row of the room (bits 4-7).
 $9D63 CP C          ; {Jump to #R$9D7D if the actor is in the same row as the
 $9D64 JR Z,$9D7D    ; amulet piece.}
; Move on to the next piece.
@label=TestAmuletProximity_Next
*$9D66 ADD HL,DE     ; Move onto the next amulet piece.
 $9D67 DJNZ $9D49    ; Decrease the amulet piece counter by one and loop back to #R$9D49
                     ; until all four pieces have been checked.
 $9D69 AND A         ; Clear the carry flag (no amulet piece is close).
 $9D6A RET           ; Return.
; The columns are the same so compare the X positions.
@label=TestAmuletProximity_Columns
*$9D6B INC HL        ; {Move onto the X position of the amulet piece.
 $9D6C INC HL        ; }
 $9D6D LD A,(HL)     ; Fetch the X position of the amulet piece.
 $9D6E DEC HL        ; {Move back onto the room of the amulet piece.
 $9D6F DEC HL        ; }
 $9D70 SUB (IX+$03)  ; Subtract the X position of the actor to get the
                     ; horizontal distance.
 $9D73 JP P,$9D78    ; Jump to #R$9D78 if the distance is positive.
 $9D76 NEG           ; Make the distance positive.
@label=TestAmuletProximity_Columns_Positive
*$9D78 CP $10        ; {Jump to #R$9D5A if the horizontal distance is #N$10 or
 $9D7A JR NC,$9D5A   ; more.}
 $9D7C RET           ; Return with the carry flag set (the amulet piece is
                     ; close).
; The rows are the same so compare the Y positions.
@label=TestAmuletProximity_Rows_Same
*$9D7D INC HL        ; {Move onto the Y position of the amulet piece.
 $9D7E INC HL        ;
 $9D7F INC HL        ; }
 $9D80 LD A,(HL)     ; Fetch the Y position of the amulet piece.
 $9D81 DEC HL        ; {Move back onto the room of the amulet piece.
 $9D82 DEC HL        ;
 $9D83 DEC HL        ; }
 $9D84 SUB (IX+$04)  ; Subtract the Y position of the actor to get the vertical
                     ; distance.
 $9D87 JP P,$9D8C    ; Jump to #R$9D8C if the distance is positive.
 $9D8A NEG           ; Make the distance positive.
@label=TestAmuletProximity_Rows_Same_Positive
*$9D8C CP $10        ; {Jump to #R$9D66 if the vertical distance is #N$10 or
 $9D8E JR NC,$9D66   ; more.}
 $9D90 RET           ; Return with the carry flag set (the amulet piece is
                     ; close).

; Handler: Flame
;
; Handles a flame (sprite IDs #N$34-#N$37) which has been started by
; #R$9ABC. A flame which is not in the player's room is counted off by
; #R$A493. In the player's room it burns for a limited time, drifting around
; in a random direction (which is changed by #R$9E0E whenever its timer runs
; out or it is blocked) and bouncing off the edges of the screen. It flickers
; by changing sprite and colour every time it is handled, and it plays a
; crackling sound. If it touches the player (while the player is coloured
; #COLOUR$47) the player is hit. When its time is up, or the player is dead,
; the flame is blown up.
;
; IX Flame record
;
; Count off the flame if it is not in the same room as the player.
@label=HandlerFlame
c$9D91 LD A,($9703)  ; Fetch the room of the player from #R$9703.
 $9D94 CP (IX+$01)   ; {Jump to #R$A493 if the flame is in a different room to
 $9D97 JP NZ,$A493   ; the player.}
 $9D9A LD A,$17      ; {Write #N$17 to #R$96AD (the width of the flame).
 $9D9C LD ($96AD),A  ; }
 $9D9F CALL $BB0B    ; Remember the previous position of the flame.
; Explode the flame if the player is not alive.
 $9DA2 LD A,($9702)  ; Fetch the sprite ID of the player.
 $9DA5 SUB $10       ; Subtract #N$10 (the first Sabreman sprite ID).
 $9DA7 CP $20        ; {Jump to #R$A4A6 if the player is not alive.
 $9DA9 JP NC,$A4A6   ; }
; Explode the flame when its lifetime runs out.
 $9DAC DEC (IX+$08)  ; {Decrease the lifetime of the flame by one and jump to #R$A4A1 if it
 $9DAF JP Z,$A4A1    ; has run out.}
; Choose a new direction when the direction timer has run out.
 $9DB2 DEC (IX+$02)  ; {Decrease the direction timer by one and choose a new direction if it
 $9DB5 CALL Z,$9E0E  ; has run out.}
; Work out the new position of the flame and bounce off the edges of the
; screen.
 $9DB8 CALL $A44B    ; Work out the new position of the flame.
 $9DBB BIT 0,B       ; {Jump to #R$9E04 if the flame has hit the left or right edge of the
 $9DBD JR NZ,$9E04   ; screen.}
 $9DBF BIT 1,B       ; {Jump to #R$9E09 if the flame has hit the top or bottom edge of the
 $9DC1 JR NZ,$9E09   ; screen.}
; This entry point is used by the routines at #R$9E04 and #R$9E09.
; .
; Stop the flame moving through objects in the room. If it did not manage
; to move then choose a new direction.
@label=HandlerFlame_Move
*$9DC3 LD BC,$170F   ; Set the height of the flame in #REGb to #N$17 and the width in #REGc
                     ; to #N$0F.
 $9DC6 CALL $B81C    ; Stop the flame passing through objects in the room.
 $9DC9 CALL $AAED    ; Test whether the flame has stayed where it was.
 $9DCC CALL Z,$9E0E  ; Choose a new direction if the flame has stayed where it
                     ; was.
; Flicker the flame by choosing one of the four flame sprites and a colour
; at random.
 $9DCF LD A,($9695)  ; Fetch the random seed from #R$9695.
 $9DD2 AND %00000011 ; Keep only bits 0-1.
 $9DD4 OR %00110100  ; Set bits 2, 4-5.
 $9DD6 LD (IX+$00),A ; Set the sprite ID of the flame.
 $9DD9 CALL $9E64    ; Choose a colour for the flame.
 $9DDC LD (IX+$05),A ; Set the colour of the flame.
; Store the new position.
 $9DDF LD (IX+$03),E ; Set the X position of the flame.
 $9DE2 LD (IX+$04),D ; Set the Y position of the flame.
; Hit the player if the flame touches the player, but only if the player
; is coloured #COLOUR$47.
 $9DE5 LD A,($9707)  ; Fetch the colour of the player from #R$9707.
 $9DE8 CP $47        ; {Jump to #R$9DFE if the player is not coloured
 $9DEA JR NZ,$9DFE   ; #COLOUR$47.}
 $9DEC LD BC,$130F   ; Set the height of the flame in #REGb to #N$13 and the width in #REGc
                     ; to #N$0F.
 $9DEF CALL $AB01    ; Test whether the flame is touching the player.
 $9DF2 JR NC,$9DFE   ; Jump to #R$9DFE if the flame is not touching the player.
 $9DF4 LD A,($9705)  ; Fetch the X position of the player from #R$9705.
 $9DF7 RLCA          ; Rotate bit 7 (which half of the screen the player is in)
                     ; into bit 0.
 $9DF8 AND %00000001 ; Keep only bit 0.
 $9DFA INC A         ; Add one, so the hit direction is #N$01 or #N$02.
 $9DFB LD ($9704),A  ; Store the hit direction in #R$9704 (the player's state).
; Draw the flame and make the crackling sound.
@label=HandlerFlame_Draw
*$9DFE CALL $AD5D    ; Display the flame.
 $9E01 JP $BECC      ; Jump to #R$BECC to play the flame sound.

; Bounce Flame Horizontally
;
; Used by the routine at #R$9D91.
; .
; Reverses the horizontal direction of a flame and carries on moving it.
;
; IX Flame record
@label=BounceFlameHorizontally
c$9E04 CALL $A5A9    ; Reverse the X velocity of the flame.
 $9E07 JR $9DC3      ; Jump to #R$9DC3 to carry on moving the flame.

; Bounce Flame Vertically
;
; Used by the routine at #R$9D91.
; .
; Reverses the vertical direction of a flame and carries on moving it.
;
; IX Flame record
@label=BounceFlameVertically
c$9E09 CALL $A5BA    ; Reverse the Y velocity of the flame.
 $9E0C JR $9DC3      ; Jump to #R$9DC3 to carry on moving the flame.

; Choose Flame Direction
;
; Used by the routine at #R$9D91.
; .
; Starts a new direction timer for a flame (#N$40 frames) and chooses its
; velocity. On every other call the velocity is random: the X velocity comes
; from the table at #R$9E5C and the Y velocity from the counter and the Z80
; refresh register. On the other calls the flame heads towards the player
; (see #R$9E2F).
;
; IX Flame record
@label=ChooseFlameDirection
c$9E0E LD (IX+$02),$40 ; Set the direction timer of the flame to #N$40.
 $9E12 LD A,($9693)    ; Fetch the low byte of the game timer from #R$9693.
 $9E15 AND %00000001   ; Keep only bit 0.
 $9E17 JR NZ,$9E2F     ; Jump to #R$9E2F to aim the flame at the player if bit 0 of the pass
                       ; counter is set.
; Choose a random velocity.
 $9E19 LD A,($9695)    ; Fetch the random seed from #R$9695.
 $9E1C AND %00000111   ; Keep only bits 0-2.
 $9E1E CALL $9E53      ; Fetch a velocity from the table.
 $9E21 LD (IX+$06),A   ; Set the X velocity of the flame.
 $9E24 LD A,R          ; Fetch the Z80 refresh register as a source of
                       ; randomness.
 $9E26 LD C,A          ; Stash it in #REGc.
 $9E27 LD A,($9693)    ; Fetch the low byte of the game timer from #R$9693.
 $9E2A ADD A,C         ; Add the refresh register value.
 $9E2B LD (IX+$07),A   ; Set the Y velocity of the flame.
 $9E2E RET             ; Return.

; Aim Flame At Player
;
; Used by the routine at #R$9E0E.
; .
; Sets the velocity of a flame so that it heads in the direction of the
; player: the X velocity is #N$C0 (left) or #N$40 (right) and the Y velocity is
; set to #N$40 (down). If the player is above the flame then the code at
; #R$9E4E writes #N$40 to the X velocity again instead of changing the Y
; velocity, so the Y velocity is left as it was.
;
; IX Flame record
@label=AimFlameAtPlayer
c$9E2F LD A,($9705)    ; Fetch the X position of the player from #R$9705.
 $9E32 CP (IX+$03)     ; {Jump to #R$9E48 if the player is to the left of the
 $9E35 JR C,$9E48      ; flame.}
 $9E37 LD (IX+$06),$40 ; Set the X velocity of the flame to #N$40 (moving
                       ; right).
; This entry point is used by the routine at #R$9E48.
@label=AimFlameAtPlayer_Vertical
*$9E3B LD A,($9706)    ; Fetch the Y position of the player from #R$9706.
 $9E3E CP (IX+$04)     ; {Jump to #R$9E4E if the player is above the flame.
 $9E41 JR C,$9E4E      ; }
 $9E43 LD (IX+$07),$40 ; Set the Y velocity of the flame to #N$40 (moving
                       ; down).
 $9E47 RET             ; Return.

; Aim Flame Left
;
; Used by the routine at #R$9E2F.
; .
; Sets the X velocity of a flame so that it moves left.
;
; IX Flame record
@label=AimFlameLeft
c$9E48 LD (IX+$06),$C0 ; Set the X velocity of the flame to #N$C0 (moving
                       ; left).
 $9E4C JR $9E3B        ; Jump to #R$9E3B to aim vertically.

; Aim Flame Up
;
; Used by the routine at #R$9E2F.
; .
; Reached when the player is above a flame. This writes #N$40 to the X
; velocity (*#REGix+#N$06) of the flame and not to the Y velocity
; (*#REGix+#N$07), which looks like a mistake in the original code.
;
; IX Flame record
@label=AimFlameUp
c$9E4E LD (IX+$06),$40 ; Set the X velocity of the flame to #N$40.
 $9E52 RET             ; Return.

; Fetch Flame Velocity
;
; Used by the routine at #R$9E0E.
; .
; Reads a velocity from the table at #R$9E5C.
;
;   A Index into the table (#N$00-#N$07)
; O:A The velocity
@label=FetchFlameVelocity
c$9E53 LD BC,$9E5C   ; Point #REGbc at the table of flame velocities at
                     ; #R$9E5C.
 $9E56 LD L,A        ; {Use the index as the offset into the table.
 $9E57 LD H,$00      ; }
 $9E59 ADD HL,BC     ; Add the table address to get the address of the
                     ; velocity.
 $9E5A LD A,(HL)     ; Fetch the velocity from the table.
 $9E5B RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$C645 }
; LIST#

; Table: Flame Velocities
;
; The X velocities which a flame can be given by #R$9E0E. Values from
; #N$80 are negative (the flame moves left).
@label=FlameVelocities
b$9E5C DEFB $50
 $9E5D DEFB $60
 $9E5E DEFB $70
 $9E5F DEFB $60
 $9E60 DEFB $80
 $9E61 DEFB $90
 $9E62 DEFB $A0
 $9E63 DEFB $B0

; Choose Flame Colour
;
; Used by the routine at #R$9D91.
; .
; Chooses a colour for the flame from the low bits of the random seed
; at #R$9695. The result is a bright ink colour from red to white.
;
; O:A The colour
@label=ChooseFlameColour
c$9E64 LD A,($9695)  ; Fetch the random seed from #R$9695.
 $9E67 AND %00000111 ; Keep only bits 0-2.
 $9E69 CP $02        ; {Jump to #R$9E6F if the colour is #N$02 or more.
 $9E6B JR NC,$9E6F   ; }
 $9E6D OR %00000110  ; Set bits 1-2.
@label=ChooseFlameColour_Bright
*$9E6F OR %01000000  ; Set bit 6 (bright).
 $9E71 RET           ; Return.

; Handler: Hippo And Warthog
;
; Handles a hippo (sprite IDs #N$A0-#N$A3) or a warthog (sprite IDs
; #N$A8-#N$AB) which is awake. The animal walks along (see #R$AFE8), animating
; as it goes, and stays in the same direction until it is blocked by
; something in the room, at which point it falls asleep (bit 2 of the sprite
; ID is set, see #R$9EB3). If the animal has bumped into the player then it
; stands still for a short while (the counter in *#REGix+#N$02 is counted
; down) and, if the player is hurt, the player is hit.
;
; IX Actor record
@label=HandlerHippoWarthog
c$9E72 CALL $BB0B     ; Remember the previous position of the animal.
 $9E75 CALL $AD93     ; Animate the animal.
 $9E78 LD A,$20       ; {Write #N$20 to #R$96AD (the width of the animal).
 $9E7A LD ($96AD),A   ; }
; Stand still while the pause counter is running.
 $9E7D LD A,(IX+$02)  ; Fetch the pause counter of the animal.
 $9E80 AND A          ; {Jump to #R$9E99 if the animal is still paused.
 $9E81 JR NZ,$9E99    ; }
; Work out the new position of the animal and stop it walking through
; objects in the room.
 $9E83 CALL $AFE8     ; Move the animal.
 $9E86 LD BC,$171F    ; Set the height of the animal in #REGb to #N$17 and the width in
                      ; #REGc to #N$1F.
 $9E89 CALL $B81C     ; Stop the animal passing through objects in the room.
; Carry on if the animal moved. If it is stuck then put it to sleep.
 $9E8C CALL $AAED     ; Test whether the animal has stayed where it was.
 $9E8F JP NZ,$AD28    ; Jump to #R$AD28 if the animal has moved.
 $9E92 SET 2,(IX+$00) ; Set bit 2 of the sprite ID to put the animal to sleep.
 $9E96 JP $AD46       ; Jump to #R$AD46 to update the animal.
; Count down the pause and test whether the animal has hit the player.
@label=HandlerHippoWarthog_Pause
*$9E99 DEC A          ; Decrease the pause counter by one.
 $9E9A LD (IX+$02),A  ; Store the pause counter.
 $9E9D LD E,(IX+$03)  ; Fetch the X position of the animal into #REGe.
 $9EA0 LD D,(IX+$04)  ; Fetch the Y position of the animal into #REGd.
 $9EA3 LD A,(IX+$00)  ; Fetch the sprite ID of the animal.
 $9EA6 RRCA           ; Rotate the direction bit (bit 1) into bit 0.
 $9EA7 AND %00000001  ; Keep only bit 0.
 $9EA9 LD D,A         ; Set the direction the animal is facing in #REGd.
 $9EAA LD BC,$0F1C    ; Set how far above and to the right of the animal the player can be
                      ; in #REGbc to #N$0F1C.
 $9EAD CALL $AB36     ; Test whether the animal has hurt the player.
 $9EB0 JP $AD46       ; Jump to #R$AD46 to update the animal.

; Handler: Sleeping Hippo And Warthog
;
; Handles a hippo (sprite IDs #N$A4-#N$A7) or a warthog (sprite IDs
; #N$AC-#N$AF) which is asleep. If #R$A630 has moved the animal to another room
; then it wakes up as a hippo or a warthog chosen at random (see #R$9F06).
; .
; If the player touches the animal (see #R$AB36), unless the start-of-turn delay
; is running or the player is not alive, then the animal wakes up, turns around,
; stands still for a short while (the counter in *#REGix+#N$02) and makes a
; noise.
;
; IX Actor record
;
; If the animal has been moved to another room then wake it up.
@label=HandlerSleepingHippoWarthog
c$9EB3 LD C,(IX+$01)   ; Fetch the room of the animal into #REGc.
 $9EB6 PUSH BC         ; Stash the room on the stack.
 $9EB7 CALL $A630      ; Move the animal into the row above or below the player if it is two
                       ; or more rows away.
 $9EBA POP BC          ; Restore the old room of the animal from the stack.
 $9EBB LD A,(IX+$01)   ; Fetch the new room of the animal.
 $9EBE CP C            ; Compare with the old room.
 $9EBF CALL NZ,$9F06   ; Wake the animal up if it has moved to a different
                       ; room.
; Do nothing else unless the animal is in the same room as the player.
 $9EC2 LD A,($9703)    ; Fetch the room of the player from #R$9703.
 $9EC5 CP (IX+$01)     ; Compare with the room of the animal.
 $9EC8 RET NZ          ; Return if the animal is in a different room to the
                       ; player.
 $9EC9 CALL $BB0B      ; Remember the previous position of the animal.
 $9ECC LD A,$20        ; {Write #N$20 to #R$96AD (the width of the animal).
 $9ECE LD ($96AD),A    ; }
 $9ED1 LD A,(IX+$00)   ; Fetch the sprite ID of the animal.
 $9ED4 RRCA            ; Rotate the direction bit (bit 1) into bit 0.
 $9ED5 AND %00000001   ; Keep only bit 0.
 $9ED7 LD D,A          ; Set the direction the animal is facing in #REGd.
 $9ED8 LD BC,$0F1C     ; Set how far above and to the right of the animal the player can be
                       ; in #REGbc to #N$0F1C.
 $9EDB LD A,($96B5)    ; Fetch the start-of-turn delay from #R$96B5.
 $9EDE AND A           ; Set the flags.
 $9EDF JR NZ,$9F01     ; Jump to #R$9F01 if the start-of-turn delay is running.
 $9EE1 LD A,($9702)    ; Fetch the sprite ID of the player from #R$9702.
 $9EE4 SUB $10         ; Subtract #N$10 (the first Sabreman sprite ID).
 $9EE6 CP $20          ; {Jump to #R$9F01 if the player is not alive.
 $9EE8 JR NC,$9F01     ; }
 $9EEA CALL $AB36      ; Test whether the animal is touching the player.
@label=HandlerSleepingHippoWarthog_Touch
*$9EED JP NC,$AD5D     ; Jump to #R$AD5D to display the animal if the player is not touching
                       ; it.
; The player is touching the animal so it wakes up and turns around.
 $9EF0 RES 2,(IX+$00)  ; Reset bit 2 of the sprite ID to wake the animal up.
 $9EF4 CALL $ADA2      ; Turn the animal around.
 $9EF7 LD (IX+$02),$0F ; Set the pause counter of the animal to #N$0F so that it stands
                       ; still.
 $9EFB CALL $AD5D      ; Display the animal.
 $9EFE JP $BF17        ; Jump to #R$BF17 to play the warble sound.
; Test whether the player is touching the animal, without hurting the
; player.
@label=HandlerSleepingHippoWarthog_NoHurt
*$9F01 CALL $AB0E      ; Test whether the player is touching the animal.
 $9F04 JR $9EED        ; Jump to #R$9EED.

; Wake Animal
;
; Used by the routine at #R$9EB3.
; .
; Wakes up a hippo or a warthog by resetting bit 2 of the sprite ID. Bit 3
; of the sprite ID is set from bit 3 of the random seed, which makes it a
; warthog (set) or a hippo (reset).
;
; IX Actor record
@label=WakeAnimal
c$9F06 LD A,($9695)  ; Fetch the random seed from #R$9695.
 $9F09 AND %00001000 ; Keep only bit 3.
 $9F0B LD C,A        ; Stash bit 3 of the random seed in #REGc.
 $9F0C LD A,(IX+$00) ; Fetch the sprite ID of the animal.
 $9F0F AND %11110011 ; Keep only bits 0-1 and 4-7.
 $9F11 OR C          ; Merge in bit 3 from the random seed.
 $9F12 LD (IX+$00),A ; Store the new sprite ID of the animal.
 $9F15 RET           ; Return.

; Handler: Guardian
;
; Handles the guardian (sprite IDs #N$94-#N$95). Nothing happens unless
; the guardian is in the same room as the player.
; .
; Until all four pieces of the amulet have been collected (see #R$970D) the
; guardian is animated, and if it touches the player (see #R$AB3D) then the
; player is hit with a hit direction of #N$80, which makes the player fall
; straight down.
; .
; Once all four pieces have been collected the guardian steps aside to let the
; player past. It walks to the left if the X position of the player is #N$80 or
; more, but it does not move further left than #N$40. Otherwise it walks to the
; right, but it does not move further right than #N$BF.
;
; IX Actor record
@label=HandlerGuardian
c$9F16 LD A,($9703)    ; Fetch the room of the player from #R$9703.
 $9F19 CP (IX+$01)     ; Compare with the room of the guardian.
 $9F1C RET NZ          ; Return if the guardian is in a different room.
 $9F1D CALL $BB0B      ; Remember the previous position of the guardian.
 $9F20 LD A,($970D)    ; Fetch the amulet pieces collected from #R$970D.
 $9F23 AND %00001111   ; Keep only bits 0-3.
 $9F25 CP $0F          ; {Jump to #R$9F40 if all four amulet pieces have been
 $9F27 JR Z,$9F40      ; collected.}
 $9F29 CALL $AD93      ; Animate the guardian.
 $9F2C LD BC,$170F     ; Set how far above and to the right of the guardian the player can be
                       ; in #REGbc to #N$170F.
 $9F2F CALL $AB3D      ; Test whether the guardian is touching the player.
 $9F32 JP NC,$AD5D     ; Jump to #R$AD5D to display the guardian if the player is not
                       ; touching it.
 $9F35 LD A,$80        ; {Set the hit direction of the player in #R$9704 to
 $9F37 LD ($9704),A    ; #N$80.}
 $9F3A CALL $BF17      ; Play the warble sound.
 $9F3D JP $AD5D        ; Jump to #R$AD5D to display the guardian.
; All four pieces have been collected. Walk to the left if the player is
; in the right half of the screen.
@label=HandlerGuardian_StepAside
*$9F40 LD A,($9705)    ; Fetch the X position of the player from #R$9705.
 $9F43 BIT 7,A         ; {Jump to #R$9F5D if the player is in the left half of
 $9F45 JR Z,$9F5D      ; the screen.}
 $9F47 LD (IX+$06),$E0 ; Set the X velocity of the guardian to #N$E0 (walking
                       ; to the left).
 $9F4B CALL $AFE8      ; Work out the new position of the guardian.
 $9F4E LD A,E          ; Fetch the new X position of the guardian.
 $9F4F CP $40          ; Compare with #N$40.
@label=HandlerGuardian_Limit
*$9F51 JP C,$AD5D      ; Jump to #R$AD5D to display the guardian if it has reached the limit
                       ; of its walk.
 $9F54 LD (IX+$03),E   ; Set the new X position of the guardian.
 $9F57 CALL $AD93      ; Animate the guardian.
 $9F5A JP $AD5D        ; Jump to #R$AD5D to display the guardian.
; Walk to the right.
@label=HandlerGuardian_Right
*$9F5D LD (IX+$06),$20 ; Set the X velocity of the guardian to #N$20 (walking
                       ; to the right).
 $9F61 CALL $AFE8      ; Work out the new position of the guardian.
 $9F64 LD A,E          ; Fetch the new X position of the guardian.
 $9F65 CP $C0          ; Compare with #N$C0.
 $9F67 CCF             ; Invert the carry flag.
 $9F68 JR $9F51        ; Jump to #R$9F51.

; Game Complete
;
; Used by the routine at #R$A18C.
; .
; Shows the "Game Complete" screen when the player has reached the end of
; the game (see #R$A18C). The play area is cleared and the room data at
; #R$C386 is drawn, followed by the six messages at #R$9F91, and then the tune
; at #R$BC67 is played.
; .
; The player is then left with no lives, so that #R$AA27 ends the game for the
; player (or hands over to the other player in a two player game).
; .
; #HTML(#AUDIO0(main-tune.wav)(#INCLUDE(MainTune)))
; .
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #SIM(start=$9960,stop=$998F,clear=1,sp=$5B40)
; #SIM(start=$99A7,stop=$99AA,sp=$5B40)
; #SCR$01(game-complete-before)
; | #SIM(start=$9F6A,stop=$9F7E,sp=$5B40)
; #SCR$01(game-complete-after) } UDGTABLE# #POPS
;
; .
;
; Clear down the play area.
@label=GameComplete
c$9F6A CALL $BB7C    ; Clear the attribute buffer of the play area.
 $9F6D CALL $BB5C    ; Clear the play area.
; Display the "Game Complete" screen.
 $9F70 LD HL,$C386   ; Point #REGhl at the room data for the "Game Complete" screen at
                     ; #R$C386.
 $9F73 CALL $BBF7    ; Draw the room.
; Display the "Game Complete" messaging.
 $9F76 LD DE,$9F91   ; Point #REGde at the "Game Complete" messages at #R$9F91.
; There are six messages. Calling #R$A036 skips setting up the counter.
 $9F79 LD B,$06      ; Set the message counter in #REGb to #N$06.
 $9F7B CALL $A036    ; Print the messages.
; Play the tune and then check if the game is being paused.
 $9F7E LD DE,$BC67   ; Point #REGde at the tune at #R$BC67.
 $9F81 CALL $BD6E    ; Play the tune.
 $9F84 CALL $AC28    ; Check if the game is paused.
; The game is over, so the player has no lives left.
 $9F87 XOR A         ; {Set the number of lives in #R$96BD to #N$00.
 $9F88 LD ($96BD),A  ; }
 $9F8B CALL $B7CD    ; Update the lives display.
 $9F8E JP $AA27      ; Jump to #R$AA27 to end the game.

; Messaging: Congratulations
;
; #TABLE(default,centre,centre,centre)
; { =h X Position | =h Y Position | =h Attribute | =h Text }
; #FOREACH($9F91,$9F9C,$9FB6,$9FD1,$9FF0,$A003)(n,{ #N(#EVAL(#PEEKn / $08)) | #N(#EVAL(#PEEK(n + $01) / $08)) | #N(#PEEK(n + $02)) | #STR(n + $03) })
; TABLE#
; .
; The six messages printed by #R$9F6A. Each message is an X position, a Y
; position and an attribute, followed by the text, whose last character has bit
; 7 set (see #R$B53D).
@label=GameComplete_Copy
t$9F91 DEFB $60,$20                                     ; X / Y position.
 $9F93 DEFB $47                                         ; Attribute.
 $9F94 DEFM "THE NEX","T"+$80                           ; "#STR(#PC)".
 $9F9C DEFB $28,$30                                     ; X / Y position.
 $9F9E DEFB $47                                         ; Attribute.
 $9F9F DEFM "ADVENTURES OF SABRE MA","N"+$80            ; "#STR(#PC)".
 $9FB6 DEFB $20,$40                                     ; X / Y position.
 $9FB8 DEFB $47                                         ; Attribute.
 $9FB9 DEFM "WILL BE CONTINUED IN TH","E"+$80           ; "#STR(#PC)".
 $9FD1 DEFB $10,$88                                     ; X / Y position.
 $9FD3 DEFB $45                                         ; Attribute.
 $9FD4 DEFM "THE UNDER-WURLDE ",$7F," COPYRIGH","T"+$80 ; "#STR(#PC)".
 $9FF0 DEFB $48,$98                                     ; X / Y position.
 $9FF2 DEFB $45                                         ; Attribute.
 $9FF3 DEFM "1984 A.C.G. LTD","."+$80                   ; "#STR(#PC)".
 $A003 DEFB $30,$A8                                     ; X / Y position.
 $A005 DEFB $45                                         ; Attribute.
 $A006 DEFM "-ALL RIGHTS RESERVED","-"+$80              ; "#STR(#PC)".

; Display Poem
;
; Used by the routine at #R$A234.
; .
; Prints one of the four poems at the bottom of the screen. Which poem is
; shown depends on how many amulet pieces the player has collected (the number
; of bits set in the low four bits of #R$970D): poem 1 for one piece, poem 2
; for two pieces, poem 3 for three pieces and poem 4 for all four.
; .
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After #R$A01B }
; { #SIM(start=$9960,stop=$998F,clear=1,sp=$5B40)
; #SIM(start=$99A7,stop=$99AA,sp=$5B40)
; #POKES$970D,$0F
; #SIM(start=$A207,stop=$A234,ix=$9702,sp=$5B40)
; #SCR$01(display-poem-before)
; | #SIM(start=$A01B,stop=$0000,ix=$9702,sp=$5B40)
; #SCR$01(display-poem-after) } UDGTABLE# #POPS
;
; IX Actor record of the player
;
; Count the number of amulet pieces which have been collected.
@label=DisplayPoem
c$A01B LD A,(IX+$0B) ; Fetch the amulet pieces collected from the actor record.
 $A01E LD BC,$0400   ; Set the amulet piece counter in #REGb to #N$04 and the number of
                     ; pieces collected in #REGc to #N$00.
@label=Poem_CollectCollected_Loop
*$A021 RRCA          ; Rotate the flag for the next amulet piece into the carry
                     ; flag.
 $A022 JR NC,$A025   ; Jump to #R$A025 if the amulet piece has not been
                     ; collected.
 $A024 INC C         ; Count the amulet piece.
@label=Poem_CollectCollected_Skip
*$A025 DJNZ $A021    ; Decrease the amulet piece counter by one and loop back to #R$A021
                     ; until all four pieces have been checked.
 $A027 LD A,C        ; Fetch the number of amulet pieces collected.
; Choose the poem to display.
 $A028 DEC A         ; {Jump to #R$A046 to show poem 1 if only one amulet piece has been
 $A029 JR Z,$A046    ; collected.}
 $A02B DEC A         ; {Jump to #R$A04B to show poem 2 if two amulet pieces have been
 $A02C JR Z,$A04B    ; collected.}
 $A02E DEC A         ; {Jump to #R$A050 to show poem 3 if three amulet pieces have been
 $A02F JR Z,$A050    ; collected.}
; Otherwise display poem 4.
 $A031 LD DE,$A13B   ; Point #REGde at the first message of poem 4 at #R$A13B.

; Print Messages
;
; Used by the routine at #R$A046.
; .
; Prints a number of messages on the screen. Each message is held as an X
; position, a Y position, an attribute byte and the text (see #R$A055), and is
; printed by #R$B53D.
;
; B The number of messages to print
; DE The address of the first message
@label=Poem_Start
c$A034 LD B,$04      ; Set the message counter in #REGb to #N$04.
; This entry point is used by the routine at #R$9F6A.
; .
; Print each message in turn.
@label=Poem_Loop
*$A036 EX DE,HL      ; {Fetch the X position into #REGl and the Y position into #REGh of the
 $A037 LD E,(HL)     ; message, leaving #REGde pointing at the attribute byte.
 $A038 INC HL        ;
 $A039 LD D,(HL)     ;
 $A03A INC HL        ;
 $A03B EX DE,HL      ; }
 $A03C PUSH BC       ; Stash the message counter on the stack.
 $A03D CALL $B53D    ; Print the message.
 $A040 EXX           ; Switch to the shadow registers.
 $A041 INC DE        ; Move onto the next message.
 $A042 POP BC        ; Restore the message counter from the stack.
 $A043 DJNZ $A036    ; Decrease the message counter by one and loop back to #R$A036 until
                     ; all of the messages have been printed.
 $A045 RET           ; Return.

; Select Poem
;
; Used by the routine at #R$A01B.
; .
; Points #REGde at the first message of a poem and then prints it (#N$04
; lines) by jumping into #R$A034.
;
; .
;
; Poem 1.
@label=Poem_1_Reference
c$A046 LD DE,$A055   ; Point #REGde at the first message of poem 1 at #R$A055.
 $A049 JR $A034      ; Jump to #R$A034 to print the poem.
; This entry point is used by the routine at #R$A01B.
; .
; Poem 2.
@label=Poem_2_Reference
*$A04B LD DE,$A0A7   ; Point #REGde at the first message of poem 2 at #R$A0A7.
 $A04E JR $A034      ; Jump to #R$A034 to print the poem.
; This entry point is used by the routine at #R$A01B.
; .
; Poem 3.
@label=Poem_3_Reference
*$A050 LD DE,$A0F4   ; Point #REGde at the first message of poem 3 at #R$A0F4.
 $A053 JR $A034      ; Jump to #R$A034 to print the poem.

; Messaging: Poem 1
;
; The poem shown when one piece of the amulet has
; been collected (see #R$A01B). It is made up of four messages, each
; of which is an X position, a Y position (both in pixels), an
; attribute byte and then the text, with bit 7 set on the last
; character.
; .
; #TABLE(default,centre,centre,centre)
; { =h X Position | =h Y Position | =h Attribute | =h Text }
; #FOREACH($A055,$A071,$A07E,$A097)(n,{ #N(#EVAL(#PEEKn / $08)) | #N(#EVAL(#PEEK(n + $01) / $08)) | #N(#PEEK(n + $02)) | #STR(n + $03) })
; TABLE#
@label=Poem_1_Copy
t$A055 DEFB $20,$80                            ; X / Y position.
 $A057 DEFB $47                                ; Attribute.
 $A058 DEFM "ONE PIECE IS ALL THAT YO","U"+$80 ; "#STR(#PC)".
 $A071 DEFB $58,$90                            ; X / Y position.
 $A073 DEFB $47                                ; Attribute.
 $A074 DEFM "HAVE FOUN","D"+$80                ; "#STR(#PC)".
 $A07E DEFB $28,$A0                            ; X / Y position.
 $A080 DEFB $45                                ; Attribute.
 $A081 DEFM "COLLECT THREE MORE AN","D"+$80    ; "#STR(#PC)".
 $A097 DEFB $48,$B0                            ; X / Y position.
 $A099 DEFB $45                                ; Attribute.
 $A09A DEFM "OUTWARD BOUN","D"+$80             ; "#STR(#PC)".

