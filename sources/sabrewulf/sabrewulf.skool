; Security Check
;
; Used by the routine at #R$6000.
; .
; The first routine run once the game has been decrypted. It checks the
; second byte of the #SKOOLKID$5C78(FRAMES) system variable (#N$5C79). If this
; is not #N$7D the routine returns, and as the stack pointer was set to
; #N$6000 by #R$6000 the return address is taken from the first two bytes of
; that routine instead of from a caller.
@label=SecurityCheck
c$995A LD A,($5C79)  ; Fetch the second byte of the #SKOOLKID$5C78(FRAMES) system variable
                     ; (#N$5C79).
 $995D CP $7D        ; {Return unless that byte is #N$7D.
 $995F RET NZ        ; }
; Continue on to #R$9960.
; .
; View the equivalent code in;
; #LIST
; { #COOKIE$5F00 }
; { #JETPAC$61E5 }
; { #LUNARJETMAN$8000 }
; { #PSSST$61C6 }
; { #TRANZAM$5F00 }
; LIST#

; Game Initialisation
;
; Clears the game variables, the screen and the attribute buffer, builds
; the lookup table used when drawing sprites (#R$B902) and colours and draws
; the banner and score line. The game selection menu (#R$B3D5) is shown, then
; the game variables are cleared again, the scores are printed, the start-up
; jingle (the music data at #R$BD45) is played and #R$B1D4 sets up both
; players and the first room before the main loop at #R$99AA is entered.
; .
; #HTML(#AUDIO0(start-up-tune.wav)(#INCLUDE(StartUpTune)))
;
; .
;
; #PUSHS #UDGTABLE { #SIM(start=$9960,stop=$998F,clear=1,sp=$5B40)
; #SIM(start=$99A7,stop=$99AA,sp=$5B40)
; #SCR$02(game-start) }
; { #SCR$01,$00,$16,$20,$02(jungle-strip) } UDGTABLE# #POPS
@label=GameInitialisation
c$9960 CALL $BB9F    ; Clear the game variables.
 $9963 XOR A         ; {Set the border to #INK$00.
 $9964 OUT ($FE),A   ; }
 $9966 CALL $BB8F    ; Clear the attribute buffer.
 $9969 CALL $BB81    ; Reset the screen buffer.
 $996C CALL $B902    ; Build the shift table used when drawing sprites.
; Set the attributes for the top banner (the whole line is #COLOUR$47).
 $996F LD HL,$5800   ; Set the attribute pointer in #REGhl to the start of the attribute
                     ; buffer at #N$5800.
 $9972 LD BC,$2047   ; Set the column counter in #REGb to #N$20 and the banner colour in
                     ; #REGc to #COLOUR$47.
@label=CreateWindow_Loop_Banner
*$9975 LD (HL),C     ; Write the banner colour to the attribute buffer.
 $9976 INC L         ; Move onto the next column.
 $9977 DJNZ $9975    ; Decrease the column counter by one and loop back to #R$9975 until
                     ; all #N$20 columns have been coloured.
 $9979 CALL $B563    ; Print the banner.
; Set the attributes for the score line (the whole line is #COLOUR$46).
 $997C LD HL,$5820   ; Set the attribute pointer in #REGhl to the start of the score line
                     ; at #N$5820.
 $997F LD BC,$2046   ; Set the column counter in #REGb to #N$20 and the score line colour
                     ; in #REGc to #COLOUR$46.
@label=CreateWindow_Loop_Score
*$9982 LD (HL),C     ; Write the score line colour to the attribute buffer.
 $9983 INC L         ; Move onto the next column.
 $9984 DJNZ $9982    ; Decrease the column counter by one and loop back to #R$9982 until
                     ; all #N$20 columns have been coloured.
; Print the 1UP, 2UP and HI scores on the score line.
 $9986 CALL $B5CC    ; Print the 1UP score.
 $9989 CALL $B5D4    ; Print the 2UP score.
 $998C CALL $B5DC    ; Print the high score.
; This entry point is used by the routine at #R$AAA4.
; .
; Show the game selection menu and wait for a game to be chosen. This is
; also where the game restarts when a game is over.
@label=Game_Restart
*$998F CALL $B3D5    ; Show the game menu.
; Write #N$00 to every address from #R$9698 to #N$9959 (the scores, the
; player data, the actor table and the other game variables).
 $9992 LD HL,$9698   ; Set the start of the game variables in #REGhl to
                     ; #R$9698.
 $9995 LD BC,$02C2   ; Set the number of bytes to clear in #REGbc to #N$02C2.
 $9998 CALL $BBA5    ; Clear the game variables.
; Print the (now zero) 1UP and 2UP scores.
 $999B CALL $B5CC    ; Print the 1UP score.
 $999E CALL $B5D4    ; Print the 2UP score.
; Play the start-up jingle.
 $99A1 LD DE,$BD45   ; Point #REGde at #R$BD45.
 $99A4 CALL $BD6E    ; Play the start-up tune.
; Set up both players and the first room, then carry on into the main
; loop.
 $99A7 CALL $B1D4    ; Set up the players and the first room.
; Continue on to #R$99AA.
; .
; View the equivalent code in;
; #LIST
; { #ATICATAC$7C19 }
; { #JETPAC$61EB }
; { #LUNARJETMAN$800A }
; { #PSSST$61CD }
; { #TRANZAM$5F07 }
; LIST#

; Run Main Loop
;
; Used by the routine at #R$9A1D.
; .
; Every actor (the player, the animals, the tribesmen, the objects and so
; on) is held in a #N$0C byte record in the actor table, which runs from
; #R$9702 to #R$982E. The first byte of each record is the sprite ID, and this
; is also the index into the jump table at #R$9B3E which selects the handler
; routine for the actor.
; .
; The handler for one actor is run per pass of #R$99B2. When the frame counter
; changes the actor currently being processed is
; remembered in #R$96A9 (this happens every frame, 50 times a second), the
; player's actor (#R$9702) is processed straight away and then the loop
; carries on from where it was interrupted. Once every actor has been
; processed, #R$9A1D runs.
@label=MainLoop
c$99AA LD SP,$6000   ; Set the stack pointer to #R$6000.
 $99AD EI            ; Enable interrupts.
 $99AE LD IX,$970E   ; Point #REGix at the first actor after the player, at
                     ; #R$970E.
; This entry point is used by the routine at #R$99F0.
; .
; Check if the frame counter has changed since the last time through.
@label=MainLoop_NextActor
*$99B2 LD A,($5C78)  ; {Fetch the low byte of the frame counter from #SKOOLKID$5C78(FRAMES)
 $99B5 LD C,A        ; into #REGc.}
 $99B6 LD A,($9696)  ; Fetch the frame counter from the previous pass from
                     ; #R$9696.
 $99B9 CP C          ; {Jump to #R$99D0 if the frame counter has not changed.
 $99BA JR Z,$99D0    ; }
@label=FrameUpdate
 $99BC DI            ; Disable interrupts.
 $99BD LD A,($5C78)  ; {Remember the new frame counter in #R$9696.
 $99C0 LD ($9696),A  ; }
 $99C3 LD A,$01      ; {Set the frame updated flag in #R$9697.
 $99C5 LD ($9697),A  ; }
 $99C8 LD ($96A9),IX ; Remember which actor was being processed in #R$96A9.
 $99CC LD IX,$9702   ; Point #REGix at the player's actor at #R$9702.
; Update the random number seed using the Z80 refresh register.
@label=MainLoop_RunHandler
*$99D0 LD A,R        ; Fetch the Z80 refresh register as a source of
                     ; randomness.
 $99D2 LD C,A        ; Stash it in #REGc.
 $99D3 LD A,($9695)  ; Fetch the random seed from #R$9695.
 $99D6 ADC A,C       ; Mix in the refresh register value and the carry flag.
 $99D7 LD ($9695),A  ; Store the new random seed in #R$9695.
; Run the handler for this actor. The handler returns to #R$99F0, so push
; that address first, then use the sprite ID to find the handler in the jump
; table.
 $99DA LD HL,$99F0   ; {Stash the return address #R$99F0 on the stack so the handler returns
 $99DD PUSH HL       ; to it.}
 $99DE LD BC,$9B3E   ; Point #REGbc at the handler jump table at #R$9B3E.
; See #POKE(see_ending,See Ending).
 $99E1 LD A,(IX+$00) ; {Fetch the sprite ID of the actor into #REGhl.
 $99E4 LD L,A        ;
 $99E5 LD H,$00      ; }
 $99E7 ADD HL,HL     ; Double the sprite ID to get the offset into the jump
                     ; table.
 $99E8 ADD HL,BC     ; Add the jump table address to get the address of the
                     ; actor's entry.
 $99E9 LD A,(HL)     ; {Fetch the address of the handler from the jump table.
 $99EA INC HL        ;
 $99EB LD H,(HL)     ;
 $99EC LD L,A        ; }
 $99ED JP $5CB0      ; Jump to #R$5CB0, which jumps to the address held in
                     ; #REGhl.

; Next Actor
;
; Moves on to the next actor in the actor table. If a new frame has just
; started only the player's actor is processed before the interrupted pass
; carries on; otherwise the loop runs until the end of the actor table is
; reached.
@label=NextActor
c$99F0 LD DE,$000C   ; Set the size of an actor record in #REGde to #N$0C.
 $99F3 ADD IX,DE     ; Move onto the next actor.
 $99F5 PUSH IX       ; {Copy the actor pointer to #REGhl (using the stack).
 $99F7 POP HL        ; }
 $99F8 LD A,($9697)  ; Fetch the frame updated flag from #R$9697.
 $99FB AND A         ; {Jump to #R$9A18 if the frame has just updated.
 $99FC JR NZ,$9A18   ; }
 $99FE LD DE,$982E   ; Point #REGde at the end of the actor table at #R$982E.
@label=NextActor_Compare
*$9A01 AND A         ; {Subtract the end of the actor table from the actor
 $9A02 SBC HL,DE     ; pointer.}
 $9A04 JR C,$99B2    ; Jump to #R$99B2 if there are more actors to process.
; The end of the range has been reached. If this was just the player's
; actor then go back to where the interrupted pass left off; otherwise the pass
; through the actor table is complete.
 $9A06 LD A,($9697)  ; Fetch the frame updated flag from #R$9697.
 $9A09 AND A         ; {Jump to #R$9A1D if the frame has not just updated
 $9A0A JR Z,$9A1D    ; (every actor has been processed).}
 $9A0C LD IX,($96A9) ; Restore the actor which was being processed before the frame updated
                     ; from #R$96A9.
 $9A10 XOR A         ; {Clear the frame updated flag in #R$9697.
 $9A11 LD ($9697),A  ; }
 $9A14 EI            ; Enable interrupts.
 $9A15 JP $99B2      ; Jump to #R$99B2.
; The frame has just updated, so only the player's actor is processed
; before the interrupted pass is resumed (i.e. stop once #REGix reaches the
; second actor).
@label=NextActor_FrameUpdated
*$9A18 LD DE,$970E   ; Point #REGde at the second actor record at #R$970E.
 $9A1B JR $9A01      ; Jump to #R$9A01.

; Update Counters And Housekeeping
;
; Used by the routine at #R$99F0.
; .
; Runs once every time all of the actors have been processed. It updates
; the counter and the random number seed and then calls the pause check and
; the other per-pass routines before going back to the main loop.
@label=UpdateCounters
c$9A1D LD HL,($9693) ; Fetch the game timer from #R$9693.
 $9A20 INC HL        ; {Increment the game timer and write it back to #R$9693.
 $9A21 LD ($9693),HL ; }
 $9A24 LD A,($9695)  ; Fetch the random seed from #R$9695.
 $9A27 ADD A,L       ; {Add the low byte of the game timer to the random seed.
 $9A28 LD L,A        ; }
 $9A29 LD A,($5C78)  ; Fetch the frame counter from #SKOOLKID$5C78(FRAMES).
 $9A2C ADD A,L       ; Mix the frame counter into the random seed.
 $9A2D LD ($9695),A  ; Store the new random seed in #R$9695.
 $9A30 CALL $AC28    ; Check if the game is paused.
 $9A33 CALL $9A3C    ; Try to spawn a nastie.
 $9A36 CALL $9ABC    ; Try to spawn a flame.
 $9A39 JP $99AA      ; Jump back to the start of the main loop.

; Spawn Nastie
;
; Used by the routine at #R$9A1D.
; .
; Called once every time all of the actors have been processed. If the
; start-of-turn delay is over, the nastie spawn delay has run out and the
; player is alive, this looks for an empty record in the nastie table at
; #R$9792 and, if one is found, tries to start a new nastie in it with
; #R$9A68.
;
; .
;
; Return if the start-of-turn delay is still running.
@label=SpawnNastie
c$9A3C LD A,($96B5)  ; {Return if the start-of-turn delay in #R$96B5 is not
 $9A3F AND A         ; zero.
 $9A40 RET NZ        ; }
; Count down the delay between nasties appearing.
 $9A41 LD A,($96B1)  ; {Jump to #R$9A4C if the nastie spawn delay in #R$96B1 is
 $9A44 AND A         ; zero.
 $9A45 JR Z,$9A4C    ; }
 $9A47 DEC A         ; Decrease the nastie spawn delay by one.
 $9A48 LD ($96B1),A  ; Store the nastie spawn delay in #R$96B1.
 $9A4B RET           ; Return.
; Return unless the player is alive (the sprite ID of the player's actor
; is in the range #N$10-#N$2F).
@label=SpawnNastie_Ready
*$9A4C LD A,($9702)  ; Fetch the sprite ID of the player's actor from #R$9702.
 $9A4F SUB $10       ; Subtract #N$10 (the first Sabreman sprite ID).
 $9A51 CP $20        ; {Return if the player is not alive.
 $9A53 RET NC        ; }
; Look for an empty record in the nastie table.
 $9A54 LD IX,$9792   ; Point #REGix at the first nastie record at #R$9792.
 $9A58 LD DE,$000C   ; Set the size of an actor record in #REGde to #N$0C.
 $9A5B LD B,$06      ; Set the nastie record counter in #REGb to #N$06.
@label=SpawnNastie_Loop
*$9A5D LD A,(IX+$00) ; Fetch the sprite ID of the nastie.
 $9A60 AND A         ; {Jump to #R$9A68 if the record is empty.
 $9A61 JR Z,$9A68    ; }
 $9A63 ADD IX,DE     ; Move onto the next nastie record.
 $9A65 DJNZ $9A5D    ; Decrease the nastie record counter by one and loop back to #R$9A5D
                     ; until all six records have been checked.
 $9A67 RET           ; Return.

; Start Nastie
;
; Used by the routine at #R$9A3C.
; .
; Turns an empty nastie record into a nastie which is just appearing,
; unless the player's room already holds the maximum number of nasties
; (#R$96BE) or the position chosen by #R$9B0D is unsuitable. The nastie starts
; as the first of the five "appearing" sprites (sprite ID #N$01), in one of
; four colours chosen from the table at #R$9AB8 using the low bits of the
; counter at #R$9693.
;
; IX Empty nastie record
;
; Count the nasties which are already in the player's room.
@label=StartNastie
c$9A68 LD HL,$9792     ; Point #REGhl at the first nastie record at #R$9792.
 $9A6B LD B,$06        ; Set the nastie record counter in #REGb to #N$06.
 $9A6D LD D,$00        ; Set the number of nasties in the player's room in
                       ; #REGd to #N$00.
 $9A6F LD A,($9703)    ; {Fetch the player's room from #R$9703 into #REGe.
 $9A72 LD E,A          ; }
@label=StartNastie_CountLoop
*$9A73 LD A,(HL)       ; Fetch the sprite ID of the nastie.
 $9A74 AND A           ; {Jump to #R$9A7E if the record is empty.
 $9A75 JR Z,$9A7E      ; }
 $9A77 INC HL          ; Move onto the room of the nastie.
 $9A78 LD A,E          ; {Compare the room of the nastie with the player's
 $9A79 CP (HL)         ; room.}
 $9A7A DEC HL          ; Move back to the sprite ID.
 $9A7B JR NZ,$9A7E     ; Jump to #R$9A7E if the nastie is in a different room.
 $9A7D INC D           ; Count the nastie.
@label=StartNastie_NextRecord
*$9A7E LD A,$0C        ; Set the size of an actor record in #REGa to #N$0C.
 $9A80 CALL $9B37      ; Move #REGhl onto the next nastie record.
 $9A83 DJNZ $9A73      ; Decrease the nastie record counter by one and loop back to #R$9A73
                       ; until all six records have been checked.
; Return if the room already holds the maximum number of nasties.
 $9A85 LD A,($96BE)    ; Fetch the maximum number of nasties allowed in a room
                       ; from #R$96BE.
 $9A88 CP D            ; {Return if the room already holds the maximum number
 $9A89 RET Z           ; of nasties.}
; Choose where the nastie will appear and return if the position is not
; suitable (the carry flag is set).
 $9A8A CALL $9B0D      ; Choose a position for the nastie.
 $9A8D RET C           ; Return if the position is unsuitable.
; Choose a colour for the nastie from the four in the table.
 $9A8E LD A,($9693)    ; Fetch the low byte of the game timer from #R$9693.
 $9A91 AND %00000011   ; Keep only bits 0-1.
 $9A93 LD L,A          ; {Use it as the offset into the colour table.
 $9A94 LD H,$00        ; }
 $9A96 LD BC,$9AB8     ; {Add the address of the colour table to get the address of the
 $9A99 ADD HL,BC       ; colour.}
 $9A9A LD A,(HL)       ; Fetch the colour of the nastie from the table.
 $9A9B LD (IX+$05),A   ; Set the colour of the nastie.
; Start the nastie as the first "appearing" sprite.
 $9A9E LD (IX+$00),$01 ; Set the sprite ID of the nastie to #N$01 (appearing).
; This entry point is used by the routine at #R$9ABC.
; .
; Clear the movement and state bytes of the new actor and draw it.
@label=StartActor_Reset
*$9AA2 XOR A           ; {Clear the velocities and counters of the actor.
 $9AA3 LD (IX+$06),A   ;
 $9AA6 LD (IX+$07),A   ;
 $9AA9 LD (IX+$08),A   ;
 $9AAC LD (IX+$09),A   ;
 $9AAF LD (IX+$0A),A   ;
 $9AB2 LD (IX+$0B),A   ; }
 $9AB5 JP $B919        ; Draw the actor.

; Nastie Colour Table
;
; The colours which a nastie can appear in, chosen using bits 0-1 of
; the counter at #R$9693.
@label=NastieColours
b$9AB8 DEFB $42      ; #COLOUR(#PEEK(#PC)).
 $9AB9 DEFB $43      ; #COLOUR(#PEEK(#PC)).
 $9ABA DEFB $45      ; #COLOUR(#PEEK(#PC)).
 $9ABB DEFB $46      ; #COLOUR(#PEEK(#PC)).

; Spawn Flame
;
; Used by the routine at #R$9A1D.
; .
; Called once every time all of the actors have been processed, after
; #R$9A3C. If the start-of-turn delay is over, the player is alive and the
; actor record at #R$9762 is empty then a counter (#R$96B4) is counted down;
; when it reaches zero a flame (sprite ID #N$34) is started at a position
; chosen by #R$9AE9, unless that position is unsuitable.
;
; .
;
; Return unless the player is alive (the sprite ID of the player's actor
; is in the range #N$10-#N$2F).
@label=SpawnFlame
c$9ABC LD A,($9702)    ; Fetch the sprite ID of the player's actor from
                       ; #R$9702.
 $9ABF SUB $10         ; Subtract #N$10 (the first Sabreman sprite ID).
 $9AC1 CP $20          ; {Return if the player is not alive.
 $9AC3 RET NC          ; }
; Return if the start-of-turn delay is still running.
 $9AC4 LD A,($96B5)    ; {Return if the start-of-turn delay in #R$96B5 is not
 $9AC7 AND A           ; zero.
 $9AC8 RET NZ          ; }
; Return if the record is already in use.
 $9AC9 LD DE,$9762     ; Point #REGde at the flame's actor record at #R$9762.
 $9ACC LD A,(DE)       ; Fetch the sprite ID of the flame's actor.
 $9ACD AND A           ; {Return if the flame is already in use.
 $9ACE RET NZ          ; }
; Count down the delay before the next flame appears.
 $9ACF LD HL,$96B4     ; Point #REGhl at the flame spawn delay at #R$96B4.
 $9AD2 LD A,(HL)       ; Fetch the flame spawn delay.
 $9AD3 AND A           ; {Jump to #R$9AD8 if the flame spawn delay has run out.
 $9AD4 JR Z,$9AD8      ; }
 $9AD6 DEC (HL)        ; Decrease the flame spawn delay by one.
 $9AD7 RET NZ          ; Return if the flame spawn delay is not zero yet.
; The delay has run out so try to start a flame.
@label=SpawnFlame_Start
*$9AD8 PUSH DE         ; {Point #REGix at the flame's actor record (using the
 $9AD9 POP IX          ; stack).}
 $9ADB CALL $9AE9      ; Choose a position for the flame.
 $9ADE RET C           ; Return if the position is unsuitable.
 $9ADF LD (IX+$00),$34 ; Set the sprite ID of the actor to #N$34 (flame).
 $9AE3 LD (IX+$05),$46 ; Set the colour of the flame to #COLOUR$46.
 $9AE7 JR $9AA2        ; Jump to #R$9AA2 to start the flame.

; Place Flame
;
; Used by the routine at #R$9ABC.
; .
; Chooses a position for a new flame. Depending on bit 0 of the counter at
; #R$9693 the flame is either placed in the same column as the player (with a
; position from the frame counter for its row, see #R$9B18) or in the same row
; as the player (see #R$9AF9). It then finishes by checking the position, see
; #R$9B23.
;
;   IX Flame record
; O:F Carry flag set if the position is unsuitable
@label=PlaceFlame
c$9AE9 LD A,($9693)  ; Fetch the low byte of the game timer from #R$9693.
 $9AEC AND %00000001 ; Keep only bit 0.
 $9AEE JR NZ,$9AF9   ; Jump to #R$9AF9 if the flame is to appear in the same row as the
                     ; player.
; Use the same X position as the player.
 $9AF0 LD A,($9705)  ; Fetch the X position of the player from #R$9705.
 $9AF3 LD (IX+$03),A ; Set the X position of the flame.
 $9AF6 LD E,A        ; Copy the X position to #REGe.
 $9AF7 JR $9B18      ; Jump to #R$9B18 to choose the Y position.

; Place Flame In Row
;
; Used by the routine at #R$9AE9.
; .
; Places a new flame at the same Y position as the player and at a random
; X position.
;
;   IX Flame record
; O:F Carry flag set if the position is unsuitable
;
; Use the same Y position as the player.
@label=PlaceFlame_InRow
c$9AF9 LD A,($9706)  ; Fetch the Y position of the player from #R$9706.
 $9AFC LD (IX+$04),A ; Set the Y position of the flame.
 $9AFF LD D,A        ; Copy the Y position to #REGd.
; Use a random X position between #N$30 and #N$AF.
 $9B00 LD A,($9695)  ; Fetch the random seed from #R$9695.
 $9B03 AND %01111111 ; Keep only bits 0-6.
 $9B05 ADD A,$30     ; Add #N$30.
 $9B07 LD E,A        ; Copy the X position to #REGe.
 $9B08 LD (IX+$03),A ; Set the X position of the flame.
 $9B0B JR $9B23      ; Jump to #R$9B23 to test the position.

; Choose Position
;
; Used by the routine at #R$9A68.
; .
; Chooses a random position for an actor which is about to appear in the
; player's room, both the X and Y coordinates are between #N$30 and #N$AF. The
; position is rejected if the actor would overlap the player (see #R$AB01) or
; an object in the room (see #R$B81C).
;
;   IX Actor record
; O:DE The Y and X position (#REGd and #REGe)
; O:F Carry flag set if the position is unsuitable
;
; Use a random X position.
@label=ChoosePosition
c$9B0D LD A,($9695)  ; Fetch the random seed from #R$9695.
 $9B10 AND %01111111 ; Keep only bits 0-6.
 $9B12 ADD A,$30     ; Add #N$30.
 $9B14 LD E,A        ; Copy the X position to #REGe.
; See #POKE(less_enemies,Less Enemies).
 $9B15 LD (IX+$03),A ; Set the X position of the actor.
; This entry point is used by the routine at #R$9AE9.
; .
; Use a Y position based on the frame counter.
@label=ChoosePosition_SetY
*$9B18 LD A,($5C78)  ; Fetch the frame counter from #SKOOLKID$5C78(FRAMES).
 $9B1B AND %01111111 ; Keep only bits 0-6.
 $9B1D ADD A,$30     ; Add #N$30.
 $9B1F LD D,A        ; Copy the Y position to #REGd.
 $9B20 LD (IX+$04),A ; Set the Y position of the actor.
; This entry point is used by the routine at #R$9AF9.
; .
; Put the actor in the player's room and test the position.
@label=ChoosePosition_Test
*$9B23 LD A,($9703)  ; Fetch the player's room from #R$9703.
 $9B26 LD (IX+$01),A ; Set the room of the actor to the player's room.
 $9B29 LD BC,$1717   ; Set the height and width of the actor in #REGb and #REGc
                     ; to #N$17.
 $9B2C CALL $AB01    ; Check whether the actor overlaps the player.
 $9B2F RET C         ; Return if the actor would overlap the player.
 $9B30 LD BC,$1717   ; Set the height and width of the actor in #REGb and #REGc
                     ; to #N$17.
 $9B33 CALL $B81C    ; Check whether the actor overlaps an object in the room.
 $9B36 RET           ; Return.

; Add A To HL
;
; Used by the routine at #R$9A68.
; .
; Adds an unsigned number to #REGhl.
;
;   A The number
;   HL The address
; O:HL The new address
@label=AddAToHL
c$9B37 ADD A,L       ; Add #REGa to #REGl.
 $9B38 LD L,A        ; Copy it to #REGl.
 $9B39 LD A,H        ; Fetch #REGh.
 $9B3A ADC A,$00     ; Add #N$00 with carry.
 $9B3C LD H,A        ; Copy it to #REGh.
 $9B3D RET           ; Return.
; View the equivalent code in;
; #LIST
; { #KNIGHTLORE$D4F2 }
; LIST#

; Jump Table
;
; The handler address for each sprite ID (#N$00-#N$C3), which is #N$C4
; entries of two bytes each. The table is indexed by the sprite ID of
; an actor (see #R$99AA). Every handler is called with #REGix pointing at the
; actor record. Sprite IDs which have no behaviour of their own point at
; #R$ADBD.
; .
; Each run of sprite IDs below has the same handler; the sprite names are
; given by #R$BF84.
@label=JumpTable
w$9B3E DEFW $ADBD    ; Sprite ID #N$00: no sprite, handled by #R$ADBD.
 $9B40 DEFW $A3C5    ; {Sprite IDs #N$01-#N$05: appearing nastie, handled by
 $9B42 DEFW $A3C5    ; #R$A3C5.
 $9B44 DEFW $A3C5    ;
 $9B46 DEFW $A3C5    ;
 $9B48 DEFW $A3C5    ; }
 $9B4A DEFW $A3E0    ; Sprite ID #N$06: choose nastie, handled by #R$A3E0.
 $9B4C DEFW $ADBD    ; Sprite ID #N$07: none, handled by #R$ADBD.
 $9B4E DEFW $A42A    ; {Sprite IDs #N$08-#N$0C: dying nastie, handled by
 $9B50 DEFW $A42A    ; #R$A42A.
 $9B52 DEFW $A42A    ;
 $9B54 DEFW $A42A    ;
 $9B56 DEFW $A42A    ; }
 $9B58 DEFW $A43B    ; Sprite ID #N$0D: remove nastie, handled by #R$A43B.
 $9B5A DEFW $ADBD    ; {Sprite IDs #N$0E-#N$0F: none, handled by #R$ADBD.
 $9B5C DEFW $ADBD    ; }
 $9B5E DEFW $AECF    ; {Sprite IDs #N$10-#N$1F: walking Sabreman, handled by
 $9B60 DEFW $AECF    ; #R$AECF.
 $9B62 DEFW $AECF    ;
 $9B64 DEFW $AECF    ;
 $9B66 DEFW $AECF    ;
 $9B68 DEFW $AECF    ;
 $9B6A DEFW $AECF    ;
 $9B6C DEFW $AECF    ;
 $9B6E DEFW $AECF    ;
 $9B70 DEFW $AECF    ;
 $9B72 DEFW $AECF    ;
 $9B74 DEFW $AECF    ;
 $9B76 DEFW $AECF    ;
 $9B78 DEFW $AECF    ;
 $9B7A DEFW $AECF    ;
 $9B7C DEFW $AECF    ; }
 $9B7E DEFW $ADD0    ; {Sprite IDs #N$20-#N$2F: attacking Sabreman, handled by
 $9B80 DEFW $ADD0    ; #R$ADD0.
 $9B82 DEFW $ADD0    ;
 $9B84 DEFW $ADD0    ;
 $9B86 DEFW $ADD0    ;
 $9B88 DEFW $ADD0    ;
 $9B8A DEFW $ADD0    ;
 $9B8C DEFW $ADD0    ;
 $9B8E DEFW $ADD0    ;
 $9B90 DEFW $ADD0    ;
 $9B92 DEFW $ADD0    ;
 $9B94 DEFW $ADD0    ;
 $9B96 DEFW $ADD0    ;
 $9B98 DEFW $ADD0    ;
 $9B9A DEFW $ADD0    ;
 $9B9C DEFW $ADD0    ; }
 $9B9E DEFW $AD07    ; {Sprite IDs #N$30-#N$33: rhino, handled by #R$AD07.
 $9BA0 DEFW $AD07    ;
 $9BA2 DEFW $AD07    ;
 $9BA4 DEFW $AD07    ; }
 $9BA6 DEFW $9D91    ; {Sprite IDs #N$34-#N$37: flame, handled by #R$9D91.
 $9BA8 DEFW $9D91    ;
 $9BAA DEFW $9D91    ;
 $9BAC DEFW $9D91    ; }
 $9BAE DEFW $AB74    ; {Sprite IDs #N$38-#N$3F: tribesman, handled by #R$AB74.
 $9BB0 DEFW $AB74    ;
 $9BB2 DEFW $AB74    ;
 $9BB4 DEFW $AB74    ;
 $9BB6 DEFW $AB74    ;
 $9BB8 DEFW $AB74    ;
 $9BBA DEFW $AB74    ;
 $9BBC DEFW $AB74    ; }
 $9BBE DEFW $A9BE    ; Sprite ID #N$40: flying Sabreman, handled by #R$A9BE.
 $9BC0 DEFW $AA0D    ; {Sprite IDs #N$41-#N$42: sitting Sabreman, handled by
 $9BC2 DEFW $AA0D    ; #R$AA0D.}
 $9BC4 DEFW $A61B    ; Sprite ID #N$43: Sabreman standing up, handled by
                     ; #R$A61B.
 $9BC6 DEFW $A9BE    ; Sprite ID #N$44: flying Sabreman, handled by #R$A9BE.
 $9BC8 DEFW $AA0D    ; {Sprite IDs #N$45-#N$46: sitting Sabreman, handled by
 $9BCA DEFW $AA0D    ; #R$AA0D.}
 $9BCC DEFW $A61B    ; Sprite ID #N$47: Sabreman standing up, handled by
                     ; #R$A61B.
 $9BCE DEFW $A680    ; {Sprite IDs #N$48-#N$4F: orchid, handled by #R$A680.
 $9BD0 DEFW $A680    ;
 $9BD2 DEFW $A680    ;
 $9BD4 DEFW $A680    ;
 $9BD6 DEFW $A680    ;
 $9BD8 DEFW $A680    ;
 $9BDA DEFW $A680    ;
 $9BDC DEFW $A680    ; }
 $9BDE DEFW $A858    ; {Sprite IDs #N$50-#N$57: Wulf, handled by #R$A858.
 $9BE0 DEFW $A858    ;
 $9BE2 DEFW $A858    ;
 $9BE4 DEFW $A858    ;
 $9BE6 DEFW $A858    ;
 $9BE8 DEFW $A858    ;
 $9BEA DEFW $A858    ;
 $9BEC DEFW $A858    ; }
 $9BEE DEFW $A8F5    ; Sprite ID #N$58: Wulf pouncing, handled by #R$A8F5.
 $9BF0 DEFW $A964    ; Sprite ID #N$59: Wulf landing, handled by #R$A964.
 $9BF2 DEFW $ADBD    ; {Sprite IDs #N$5A-#N$5B: none, handled by #R$ADBD.
 $9BF4 DEFW $ADBD    ; }
 $9BF6 DEFW $A8F5    ; Sprite ID #N$5C: Wulf pouncing, handled by #R$A8F5.
