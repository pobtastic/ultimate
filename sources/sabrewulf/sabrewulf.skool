i$5B00

; Decryption Routine
;
; The bytes in this region are all #N$00 in the snapshot used for this
; disassembly (the routine is not present in memory), so the instructions below
; are the documented operation of the loader's decryption routine rather than
; something that can be checked against the bytes here.
;
; .
;
; Runs "CPL" on each byte starting from #R$6000.
@label=Decryption
c$5B80 NOP           ; {#REGhl=#R$6000.
 $5B81 NOP           ;
 $5B82 NOP           ; }
@label=Decryption_Loop
 $5B83 NOP           ; #REGa=#REGhl.
 $5B84 NOP           ; CPL operation.
 $5B85 NOP           ; Write #REGa back to #REGhl.
 $5B86 NOP           ; Increment #REGhl by one.
 $5B87 NOP           ; Return.
; View the equivalent code in #LUNARJETMAN$5B80.
; .
; Earlier Ultimate games use a much simpler mechanism;
; #LIST
; { #COOKIE$5B80 }
; { #JETPAC$5B80 }
; { #PSSST$5B80 }
; { #TRANZAM$5B80 }
; LIST#

i$5B88

; Indirect Jump
;
; Used by the routine at #R$99AA.
@label=IndirectJump
c$5CB0 JP (HL)       ; Jump to the address held in #REGhl.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$5CB0 }
; { #LUNARJETMAN$5CB0 }
; { #NIGHTSHADE$5CB0 }
; { #PSSST$5CB0 }
; { #TRANZAM$5CB0 }
; LIST#

i$5CB1

; Game Entry Point
;
; Where the game starts once it has been decrypted. The stack is set up
; just below this routine and control passes to the security check at #R$995A.
@label=GameEntry
c$6000 DI            ; Disable interrupts.
 $6001 LD SP,$6000   ; Set the stack pointer to #N$6000.
 $6004 JP $995A      ; Jump to #R$995A.
; View the equivalent code in;
; #LIST
; { #COOKIE$5B80 }
; { #JETPAC$5B80 }
; { #TRANZAM$5B80 }
; { #UNDERWURLDE$7680 }
; LIST#

; Messaging: Copyright
;
; The copyright notice of the game. Nothing in the code refers to it.
@label=CopyrightNotice
t$6007 DEFM "COPYRIGHT 1984 A.C.G. LTD. ALL RIGHTS RESERVED." ; "#STR(#PC,$04,$2F)".

; Room Entry X Positions
;
; The X position at which an actor is placed when it enters a room from
; above (see #R$B12F). There is one byte for each of the #N$30 room layouts, and
; the layout of a room is found from the table at #R$6066.
@label=RoomEntryXPositions
b$6036 DEFB $00,$00,$00,$70,$A8,$78,$78,$00,$78,$78,$78,$78,$00,$00,$00,$78
 $6046 DEFB $78,$78,$00,$00,$00,$78,$00,$78,$78,$78,$00,$00,$78,$00,$00,$00
 $6056 DEFB $78,$00,$70,$70,$A8,$68,$00,$68,$68,$68,$00,$78,$00,$78,$00,$78

; Layout
;
; The room layout table. There is one byte for each of the #N$100 rooms,
; with the room number as the index (the room to the left or right is one more
; or less and the room below or above is #N$10 more or less). Each byte is the
; number of the layout of the room, which is the index into #R$6036 and
; #R$6166.
