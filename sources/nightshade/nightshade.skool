@label=Tune_Menu
b$C770 DEFB $19,$1E,$21,$1E,$19,$1E,$21,$1E,$1D,$20,$23,$20
 $C77C DEFB $1D,$20,$23,$20,$1E,$21,$25,$21,$1E,$21,$25,$21
 $C788 DEFB $20,$23,$26,$23,$20,$23,$26,$23,$21,$25,$28,$25
 $C794 DEFB $21,$25,$28,$25,$23,$26,$29,$26,$23,$26,$29,$26
 $C7A0 DEFB $25,$2A,$2D,$2A,$25,$2A,$2D,$2A,$26,$29,$2C,$29
