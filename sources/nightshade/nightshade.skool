 $C728 DEFB $3F,$02,$41
 $C72B DEFB $2D,$02,$45
 $C72E DEFB $1C,$02,$49
 $C731 DEFB $0C,$02,$4E
 $C734 DEFB $FD,$01,$52
 $C737 DEFB $EF,$01,$57
 $C73A DEFB $E2,$01,$5D
 $C73D DEFB $D5,$01,$62
 $C740 DEFB $C9,$01,$68
