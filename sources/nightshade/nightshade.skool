; The pitch of each of the notes that can be played. Each note has three
; bytes: the delay for the speaker, the multiplier for the delay, and the number
; of cycles that make up one unit of length. Note #N$00 is a rest, and has no
; entry.
@label=NoteTable
b$C6B9 DEFB $00,$00,$00
 $C6BC DEFB $F4,$0A,$08
 $C6BF DEFB $65,$0A,$09
 $C6C2 DEFB $DE,$09,$09
 $C6C5 DEFB $5E,$09,$0A
