                                                                                                            ; #N$2F:
                                                                                                            ; #R$DA00.
 $D5F9 DEFW $D9A3,$D9A3,$D9A3,$D9A3,$D9A3,$D9A3,$D9A3,$D9A3,$D9A3,$D9A3,$D9A3,$D9A3,$D9A3,$D9A3,$D9A3,$D9A3 ; Types
