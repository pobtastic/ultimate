 $C6CB DEFB $75,$08,$0B
 $C6CE DEFB $0A,$08,$0C
 $C6D1 DEFB $A5,$07,$0C
 $C6D4 DEFB $45,$07,$0D
 $C6D7 DEFB $EB,$06,$0E
 $C6DA DEFB $96,$06,$0F
 $C6DD DEFB $46,$06,$0F
 $C6E0 DEFB $FA,$05,$10
 $C6E3 DEFB $B3,$05,$11
 $C6E6 DEFB $6F,$05,$12
 $C6E9 DEFB $2F,$05,$13
 $C6EC DEFB $F3,$04,$15
 $C6EF DEFB $F3,$04,$16
 $C6F2 DEFB $85,$04,$17
 $C6F5 DEFB $52,$04,$19
 $C6F8 DEFB $23,$04,$1A
 $C6FB DEFB $F6,$03,$1C
 $C6FE DEFB $CB,$03,$1D
 $C701 DEFB $A3,$03,$1F
 $C704 DEFB $7D,$03,$21
 $C707 DEFB $59,$03,$23
 $C70A DEFB $38,$03,$25
 $C70D DEFB $18,$03,$27
 $C710 DEFB $FA,$02,$29
