; Ignore Object
;
; The routine for objects that do nothing.
@label=IgnoreObject
c$D6D5 RET           ; Return.

; Create Fragments
;
; Used by the routine at #R$D80C.
; .
; Creates four fragments (objects of type #N$8C) at the position of an
; object, in the four objects from #R$BCCE. Each fragment flies off in a
; different direction.
;
; IY Object
;
; Create four fragments at the object's position.
@label=CreateFragments
c$D6D6 LD HL,$BCCE   ; {Point #REGhl at the first fragment, and set a counter for four
 $D6D9 LD B,$04      ; fragments.}
; Copy the position and send this fragment on its way.
@label=CreateFragments_Loop
*$D6DB LD (HL),$8C   ; {Set the type of the fragment.
 $D6DD INC HL        ; }
 $D6DE PUSH IY       ; {Point #REGde at the position of the object, and set a counter for
 $D6E0 POP DE        ; four bytes.
 $D6E1 INC DE        ;
 $D6E2 LD C,$04      ; }
@label=CreateFragments_Position
*$D6E4 LD A,(DE)     ; {Copy the position of the object into the fragment, and loop back
 $D6E5 INC DE        ; until all of it has been copied.
 $D6E6 LD (HL),A     ;
 $D6E7 INC HL        ;
 $D6E8 DEC C         ;
 $D6E9 JR NZ,$D6E4   ; }
 $D6EB LD (HL),$0C   ; {Set the speed of the fragment to #N$0C.
 $D6ED INC HL        ; }
 $D6EE LD A,B        ; {Work out the direction of the fragment from the counter, so that the
 $D6EF DEC A         ; four fragments fly off in different directions.
 $D6F0 RRCA          ;
 $D6F1 RRCA          ;
 $D6F2 AND $C0       ; }
 $D6F4 LD (HL),A     ; {Set the direction of the fragment, and move on to the
 $D6F5 INC HL        ; width.
 $D6F6 INC HL        ; }
 $D6F7 LD (HL),$10   ; {Set the width of the fragment to #N$10.
 $D6F9 INC HL        ; }
 $D6FA LD (HL),$10   ; Set the depth of the fragment to #N$10.
 $D6FC INC HL        ; {Move on to the sprite offsets.
 $D6FD INC HL        ;
 $D6FE INC HL        ; }
 $D6FF LD (HL),$F4   ; {Set the X offset of the sprite.
 $D701 INC HL        ; }
 $D702 LD (HL),$04   ; Set the Y offset of the sprite.
 $D704 INC HL        ; {Move on to the next fragment.
 $D705 INC HL        ;
 $D706 INC HL        ; }
 $D707 DJNZ $D6DB    ; Loop back until all four fragments have been created.
 $D709 RET           ; Return.

; Update Fragment
;
; The routine for objects of type #N$8C to #N($8F), the fragments that fly
; out of a monster that has been destroyed. A fragment moves in a straight line,
; and turns into a burst when it hits something.
@label=UpdateFragment
c$D70A RES 1,(IX+$07)  ; Clear the flag that shows that the fragment has been
                       ; drawn.
 $D70E LD A,(IX+$05)   ; {Set the velocity of the fragment from its speed and
 $D711 CALL $DCE0      ; direction.}
 $D714 CALL $DE59      ; Check whether the scenery blocks the move.
 $D717 CALL $DD01      ; Move the fragment.
 $D71A CALL $CEF8      ; Change the sprite of the fragment.
 $D71D BIT 0,(IX+$07)  ; {Return if the fragment has not hit anything.
 $D721 RET Z           ; }
 $D722 LD (IX+$00),$0C ; {Turn the fragment into a burst and return.
 $D726 RET             ; }

; Update Speed Bonus
;
; The routine for objects of type #N($02), the bonuses
; that make the player move faster. A bonus vanishes when
; the player is more than four cells away.
; When the player touches it, the bonus turns into a burst and the player's
; speed is raised for #N$FF frames.
;
; .
;
; Vanish if the player is too far away.
@label=UpdateSpeedBonus
c$D727 LD C,$04        ; {Set the distance to #N$04 cells and check whether the bonus is that
 $D729 CALL $C069      ; close to the player.}
 $D72C JR C,$D733      ; Jump to #R$D733 if it is.
 $D72E LD (IX+$00),$00 ; {Remove the bonus, because the player is too far away,
 $D732 RET             ; and return.}
; Raise the player's speed when the bonus is touched.
@label=UpdateSpeedBonus_Close
*$D733 CALL $C55F      ; {Return if the bonus is not touching the player.
 $D736 RET NC          ; }
 $D737 LD (IX+$00),$0C ; Turn the bonus into a burst.
 $D73B LD A,$FF        ; {Make the speed bonus last for #N$FF frames.
 $D73D LD ($BBF5),A    ; }
 $D740 LD A,$12        ; {Raise the player's top speed to #N$12.
 $D742 LD ($BBBE),A    ; }
 $D745 LD HL,$0105     ; {Start the speed bonus sound, which is sound effect #N$01 and has
 $D748 LD ($BBF9),HL   ; five notes.}
 $D74B RET             ; Return.

; Update Health Bonus
;
; The routine for objects of type #N($03), the bonuses that restore the
; player's health. A bonus vanishes when the player is more than four cells
; away. When the player touches it, the bonus turns into a burst and the
; player's health is made full.
;
; .
;
; Vanish if the player is too far away.
@label=UpdateHealthBonus
c$D74C LD C,$04        ; {Set the distance to #N$04 cells and check whether the bonus is that
 $D74E CALL $C069      ; close to the player.}
 $D751 JR C,$D758      ; Jump to #R$D758 if it is.
 $D753 LD (IX+$00),$00 ; {Remove the bonus, because the player is too far away,
 $D757 RET             ; and return.}
; Restore the player's health when the bonus is touched.
@label=UpdateHealthBonus_Close
*$D758 CALL $C55F      ; {Return if the bonus is not touching the player.
 $D75B RET NC          ; }
 $D75C LD (IX+$00),$0C ; Turn the bonus into a burst.
 $D760 LD A,$03        ; {Give the player full health.
 $D762 LD ($BBF3),A    ; }
 $D765 LD HL,$0207     ; {Start the health bonus sound, which is sound effect #N$02 and has
 $D768 LD ($BBF9),HL   ; seven notes.}
 $D76B RET             ; Return.

; Spawn Bonus
;
; Used by the routine at #R$BDFE.
; .
; Makes a bonus appear near the player, in the object at #R$BD0E, if there
; is not one already. The bonus is a speed bonus (type #N$02) or a health bonus
; (type #N$03), depending on the frame counter. It is placed in a cell that is
; not solid and is at least two cells from the player, at a random place within
; the cell.
;
; .
;
; Return if a bonus is already there.
@label=SpawnBonus
c$D76C LD IX,$BD0E     ; Use the object for the bonus.
 $D770 LD A,(IX+$00)   ; {Return if there is a bonus already.
 $D773 AND A           ;
 $D774 RET NZ          ; }
; Choose a cell that is not solid and not too close.
 $D775 CALL $C5BB      ; Update the random number generator.
 $D778 LD A,($BC90)    ; {Fetch the column and the row of the player's cell.
 $D77B LD L,A          ;
 $D77C LD A,($BC92)    ;
 $D77F LD H,A          ; }
 $D780 LD A,($BBAA)    ; {Choose a column that is the same as the player's, or four on, from
 $D783 AND $07         ; the random seed.
 $D785 AND $FC         ; }
 $D787 ADD A,L         ; {Add the choice to the column, and keep it within the
 $D788 AND $1F         ; village.
 $D78A LD L,A          ; }
 $D78B LD (IX+$02),A   ; Set the column of the bonus.
 $D78E LD A,($BBAB)    ; {Choose a row from four back to three on, using the second random
 $D791 AND $07         ; seed.
 $D793 ADD A,$FC       ;
 $D795 ADD A,H         ; }
 $D796 LD H,A          ; {Add the choice to the row, and set the row of the
 $D797 AND $1F         ; bonus.
 $D799 LD (IX+$04),A   ; }
 $D79C CALL $E051      ; Find the tile of the cell.
 $D79F DEC A           ; {Return if the tile is solid (#N$01 or #N$02).
 $D7A0 CP $02          ;
 $D7A2 RET C           ; }
 $D7A3 LD C,$02        ; {Set the distance to two cells.
 $D7A5 CALL $C069      ; }
 $D7A8 RET C           ; Check whether the cell is closer to the player than that, and return
                       ; if it is.
; Place the bonus in the cell.
 $D7A9 LD A,($BBB2)    ; {Make the type of the bonus #N$02 or #N($03), from the frame counter,
 $D7AC AND $01         ; and set it.
 $D7AE OR $02          ;
 $D7B0 LD (IX+$00),A   ; }
 $D7B3 LD A,($BBAA)    ; {Set the position of the bonus along the X axis within the cell to a
 $D7B6 AND $7F         ; random place.
 $D7B8 ADD A,$40       ;
 $D7BA LD (IX+$01),A   ; }
 $D7BD LD A,($BBAB)    ; {Set the position of the bonus along the Y axis within the cell to a
 $D7C0 AND $7F         ; random place.
 $D7C2 ADD A,$40       ;
 $D7C4 LD (IX+$03),A   ; }
 $D7C7 LD (IX+$08),$10 ; Set the width of the bonus to #N$10.
 $D7CB LD (IX+$09),$10 ; Set the depth of the bonus to #N$10.
 $D7CF LD (IX+$0C),$F4 ; Set the X offset of the sprite.
 $D7D3 LD (IX+$0D),$04 ; Set the Y offset of the sprite.
 $D7D7 RET             ; Return.

; Update Burst
;
; The routine for objects of type #N$0C to #N($0F), the
; bursts that show an object being destroyed. The burst
; changes to the next sprite, and the object is removed
; after the fourth sprite and a random sound is played.
@label=UpdateBurst
c$D7D8 INC (IX+$00)   ; {Change to the next sprite, and jump to #R$D7E8 unless that was the
 $D7DB LD A,(IX+$00)  ; last one.
 $D7DE AND $03        ;
 $D7E0 JR NZ,$D7E8    ; }
 $D7E2 LD (IX+$00),A  ; {Remove the burst, and play a random sound.
 $D7E5 JP $C435       ; }
@label=UpdateBurst_Next
*$D7E8 RES 1,(IX+$07) ; {Clear the flag that shows that the burst has been
 $D7EC RET            ; drawn, and return.}

; Update Shot
;
; The routine for objects of type #N$50 to #N($5F), the shots that the
; player fires. A shot moves in a straight line, and turns into a burst when it
; hits something.
;
; .
;
; Move the shot along both axes.
@label=UpdateShot
c$D7ED LD A,(IX+$05)   ; {Set the velocity of the shot from its speed and
 $D7F0 CALL $DCE0      ; direction.}
 $D7F3 CALL $CEF8      ; Change the sprite of the shot.
 $D7F6 CALL $DE59      ; Check whether the scenery blocks the move along one
                       ; axis.
 $D7F9 CALL $DD01      ; Move the shot.
 $D7FC CALL $DE5D      ; Check whether the scenery blocks the move along the
                       ; other axis.
 $D7FF CALL $DD01      ; Move the shot.
; Burst if the shot has hit something.
 $D802 BIT 0,(IX+$07)  ; {Return if the shot has not hit anything.
 $D806 RET Z           ; }
 $D807 LD (IX+$00),$0C ; {Turn the shot into a burst and return.
 $D80B RET             ; }

; Update Thrown Item
;
; The routine for objects of type #N$08 to #N($0B), the items that the
; player has thrown. The item flies in a straight line. If it hits the object
; that is four places along the object table (the monster that it belongs to),
; the monster is destroyed, #N$25 hundred points are added to the score and the
; monster explodes into fragments. If the item hits something else, it lands and
; becomes an item that can be picked up again (type #N$04 to #N$07).
@label=UpdateThrownItem
c$D80C LD A,(IX+$05)   ; {Set the velocity of the item from its speed and
 $D80F CALL $DCE0      ; direction.}
 $D812 CALL $DE59      ; Check whether the scenery blocks the move along one
                       ; axis.
 $D815 CALL $DD01      ; Move the item.
 $D818 CALL $DE5D      ; Check whether the scenery blocks the move along the
                       ; other axis.
 $D81B CALL $DD01      ; Move the item.
 $D81E CALL $C554      ; {Check whether the item has hit its monster, and jump to #R$D833 if
 $D821 JR C,$D833      ; it has.}
 $D823 BIT 0,(IX+$07)  ; {Return if the item has not hit the scenery.
 $D827 RET Z           ; }
 $D828 LD A,(IX+$00)   ; {Change the type of the item to the one for an item that is lying on
 $D82B AND $03         ; the ground, and return.
 $D82D OR $04          ;
 $D82F LD (IX+$00),A   ;
 $D832 RET             ; }
; The item has hit its monster.
@label=UpdateThrownItem_Hit
*$D833 LD (IY+$00),$84 ; Change the monster into a flash (type #N$84).
 $D837 LD (IX+$00),$0C ; Turn the item into a burst.
 $D83B LD BC,$2500     ; {Add #N$25 hundred points to the score.
 $D83E CALL $C2ED      ; }
 $D841 CALL $D6D6      ; Create fragments from the monster.
 $D844 JP $C1FD        ; Jump to #R$C1FD.

; Update Destroyed Monster
;
; The routine for objects of type #N$84 to #N($87), the flash that shows a
; monster that has been destroyed. The border of the screen is set to a colour
; from the frame counter, and on every other frame the object moves on to the
; next sprite. It is removed after the fourth sprite.
@label=UpdateDestroyedMonster
c$D847 LD A,($BBB2)  ; {Set the colour of the border from the frame counter.
 $D84A RLCA          ;
 $D84B RLCA          ;
 $D84C RLCA          ;
 $D84D AND $38       ;
 $D84F LD ($BBFB),A  ; }
 $D852 LD A,($BBB2)  ; {Return unless the frame counter is odd.
 $D855 AND $01       ;
 $D857 RET Z         ; }
 $D858 INC (IX+$00)  ; {Move on to the next sprite, and return unless it was
 $D85B LD A,(IX+$00) ; the last.
 $D85E AND $03       ;
 $D860 RET NZ        ; }
 $D861 LD (IX+$00),A ; {Remove the object and return.
 $D864 RET           ; }

; Check Monsters Defeated
;
; Used by the routine at #R$BDFE.
; .
; Checks whether all four monsters have been destroyed and their fragments
; have gone. If so, the game is over (see #R$CC56). Returns if any monster is
; still alive, or any of its fragments is still moving.
;
; .
;
; Return if any monster is still alive.
@label=CheckMonstersDefeated
c$D865 LD HL,$BD5E    ; {Point #REGhl at the first monster, set the distance from one object
 $D868 LD DE,$0010    ; to the next (#N$0010 bytes), set a counter for four monsters and clear #REGa.
 $D86B LD B,$04       ;
 $D86D XOR A          ; }
@label=CheckMonstersDefeated_Monsters
*$D86E OR (HL)        ; {Combine the type of the monster with the others, and loop back until
 $D86F ADD HL,DE      ; all four have been checked.
 $D870 DJNZ $D86E     ; }
 $D872 RET NZ         ; Return if any monster is still alive.
; Return if any fragment is still in the view.
 $D873 LD IX,$BCCE    ; {Point #REGix at the first of the four fragments, and set a counter
 $D877 LD B,$04       ; for four.}
@label=CheckMonstersDefeated_Fragments
*$D879 LD A,(IX+$00)  ; {Jump to #R$D887 if the object is not a fragment.
 $D87C SUB $8C        ;
 $D87E CP $04         ;
 $D880 JR NC,$D887    ; }
 $D882 BIT 1,(IX+$07) ; {Return if the fragment has been drawn, because it is
 $D886 RET NZ         ; still in view.}
@label=CheckMonstersDefeated_Next
*$D887 ADD IX,DE      ; {Move on to the next object and loop back until all four have been
 $D889 DJNZ $D879     ; checked.}
 $D88B JP $CC56       ; Finish the game.

; Place Items
;
; Used by the routine at #R$BDFE.
; .
; Places the four items that the monsters need (type #N$04 to #N$07) in
; random cells of the village that are not solid, in the objects from #R$BD1E.
; The cells come from bytes of the ROM, starting from a random place.
;
; .
;
; Point at the first item and a random place in the ROM.
@label=PlaceItems
c$D88E CALL $C5B4    ; Increase the frame counter, and update the random number
                     ; generator.
 $D891 LD IY,$BD1E   ; {Point #REGiy at the first object, and set a counter of
 $D895 LD B,$04      ; four items.}
 $D897 LD DE,($BBAA) ; {Make a random address in the first #N$1000 bytes of the
 $D89B LD A,D        ; ROM.
 $D89C AND $0F       ;
 $D89E LD D,A        ; }
; Place an item in a cell that is not solid.
@label=PlaceItems_Cell
*$D89F LD A,(DE)     ; {Fetch a column from the ROM.
 $D8A0 INC DE        ;
 $D8A1 AND $1F       ;
 $D8A3 LD L,A        ; }
 $D8A4 LD A,(DE)     ; {Fetch a row from the ROM.
 $D8A5 INC DE        ;
 $D8A6 AND $1F       ;
 $D8A8 LD H,A        ; }
 $D8A9 PUSH BC       ; {Find the tile of the cell.
 $D8AA PUSH HL       ;
 $D8AB CALL $D564    ;
 $D8AE POP HL        ;
 $D8AF POP BC        ; }
 $D8B0 DEC A         ; {Try another cell if the tile is solid (#N$01 or #N$02).
 $D8B1 CP $02        ;
 $D8B3 JR C,$D89F    ; }
 $D8B5 PUSH BC       ; {Keep the counter, the address in the ROM and the cell.
 $D8B6 PUSH DE       ;
 $D8B7 PUSH HL       ; }
 $D8B8 LD HL,$D8D7   ; {Copy the template for an item into the object, and move on to the
 $D8BB LD BC,$0010   ; next object.
 $D8BE PUSH IY       ;
 $D8C0 POP DE        ;
 $D8C1 ADD IY,BC     ;
 $D8C3 LDIR          ; }
 $D8C5 POP HL        ; {Restore the cell, the ROM address and the counter from
 $D8C6 POP DE        ; the stack.
 $D8C7 POP BC        ; }
 $D8C8 LD A,B        ; {Set the type of the item.
 $D8C9 ADD A,$03     ;
 $D8CB LD (IY-$10),A ; }
 $D8CE LD (IY-$0E),L ; {Set the column and the row of the item.
 $D8D1 LD (IY-$0C),H ; }
 $D8D4 DJNZ $D89F    ; Loop back until all four items have been placed.
 $D8D6 RET           ; Return.

; Item Template
;
; The initial state of an item, copied into the object table by #R$D88E
; (see #R$BC8E for the fields). The size is #N$08 by #N$08.
@label=ItemTemplate
b$D8D7 DEFB $00,$80,$00,$80,$00,$00,$00,$00,$08,$08,$00,$00,$F4,$04,$00,$00

; Place Monsters
;
; Used by the routine at #R$BDFE.
; .
; Places the four monsters (type #N($60), #N($64), #N$68
; and #N$6C) in random cells of the village that are not
; solid, in the objects from #R$BD5E. The
; cells come from bytes of the ROM, starting from a random place.
;
; .
;
; Point at the first monster and a random place in the ROM.
@label=PlaceMonsters
c$D8E7 CALL $C5B4    ; Increase the frame counter, and update the random number
                     ; generator.
 $D8EA LD IY,$BD5E   ; {Point #REGiy at the first object, and set a counter of four
 $D8EE LD B,$04      ; monsters.}
 $D8F0 LD DE,($BBAA) ; {Make a random address in the first #N$1000 bytes of the
 $D8F4 LD A,D        ; ROM.
 $D8F5 AND $0F       ;
 $D8F7 LD D,A        ; }
; Place a monster in a cell that is not solid.
@label=PlaceMonsters_Cell
*$D8F8 LD A,(DE)     ; {Fetch a column from the ROM.
 $D8F9 INC DE        ;
 $D8FA AND $1F       ;
 $D8FC LD L,A        ; }
 $D8FD LD A,(DE)     ; {Fetch a row from the ROM.
 $D8FE INC DE        ;
 $D8FF AND $1F       ;
 $D901 LD H,A        ; }
 $D902 PUSH BC       ; {Find the tile of the cell.
 $D903 PUSH HL       ;
 $D904 CALL $D564    ;
 $D907 POP HL        ;
 $D908 POP BC        ; }
 $D909 DEC A         ; {Try another cell if the tile is solid (#N$01 or #N$02).
 $D90A CP $02        ;
 $D90C JR C,$D8F8    ; }
 $D90E PUSH BC       ; {Keep the counter, the address in the ROM and the cell.
 $D90F PUSH DE       ;
 $D910 PUSH HL       ; }
 $D911 LD HL,$D932   ; {Copy the template for a monster into the object, and move on to the
 $D914 LD BC,$0010   ; next object.
 $D917 PUSH IY       ;
 $D919 POP DE        ;
 $D91A ADD IY,BC     ;
 $D91C LDIR          ; }
 $D91E POP HL        ; {Restore the cell, the ROM address and the counter from
 $D91F POP DE        ; the stack.
 $D920 POP BC        ; }
 $D921 LD A,B        ; {Set the type of the monster from the counter.
 $D922 ADD A,A       ;
 $D923 ADD A,A       ;
 $D924 ADD A,$5C     ;
 $D926 LD (IY-$10),A ; }
 $D929 LD (IY-$0E),L ; {Set the column and the row of the monster.
 $D92C LD (IY-$0C),H ; }
 $D92F DJNZ $D8F8    ; Loop back until all four monsters have been placed.
 $D931 RET           ; Return.

; Monster Template
;
; The initial state of a monster, copied into the object table by #R$D8E7
; (see #R$BC8E for the fields). The speed is #N$04 and the size is #N$10 by
; #N$10.
@label=MonsterTemplate
b$D932 DEFB $00,$80,$00,$80,$00,$04,$00,$00,$10,$10,$00,$00,$F4,$04,$00,$00

; Update Monster Item
;
; The routine for objects of type #N$04 to #N($07), the
; items that the monsters need, lying in the village. When
; the player touches one, the item is
; picked up.
@label=UpdateMonsterItem
c$D942 CALL $C55F    ; {Return if the item is not touching the player.
 $D945 RET NC        ; }
 $D946 LD HL,$0304   ; {Start the item sound, which is sound effect #N$03 and has four
 $D949 LD ($BBF9),HL ; notes.}
 $D94C JP $C489      ; Pick up the item.

; Update Monster
;
; The routine for objects of type #N$60 to #N($6F), the
; monsters. A monster moves about, changing direction from
; time to time, and kills the player if it
; touches the player.
@label=UpdateMonster
c$D94F LD A,(IX+$00) ; {Set the offset of the pitches for the monster from its
 $D952 RLCA          ; type.
 $D953 RLCA          ;
 $D954 AND $F0       ;
 $D956 LD C,A        ;
 $D957 LD B,$00      ; }
 $D959 LD HL,$C35D   ; {Play the sound for the monster if it has been drawn. #REGbc holds
 $D95C CALL $C335    ; only the offset of the pitches, so they are read from the ROM, and the address
                     ; of the table that is loaded into #REGhl is not used.}
 $D95F LD A,(IX+$05) ; {Set the velocity of the monster from its speed and
 $D962 CALL $DCE0    ; direction.}
 $D965 CALL $DE59    ; Check whether the scenery blocks the move.
 $D968 CALL $DD01    ; Move the monster.
 $D96B CALL $DD28    ; Turn the monster to a new direction if its timer has run
                     ; out.
 $D96E CALL $D978    ; Choose the sprite from the direction that the monster
                     ; faces.
; See #POKE(immunity_to_monsters,Immunity To Monsters).
 $D971 CALL $C55F    ; {Return if the monster is not touching the player.
 $D974 RET NC        ; }
 $D975 JP $CEC4      ; Kill the player.

; Set Sprite From Direction
;
; Used by the routines at #R$C083 and #R$D94F.
; .
; Sets the sprite of an object from the direction that it is facing. Bit 1
; of the type is set from the direction, bit 0 is flipped, and the flip flag is
; set from the direction, with both the sprite and the flip changed when the
; view is rotated.
;
; IX Object
@label=SetSpriteFromDirection
c$D978 LD A,($BBBA)  ; {Fetch whether the view is turned round, and double it.
 $D97B ADD A,A       ;
 $D97C LD B,A        ; }
 $D97D LD A,(IX+$06) ; {Work out bit 1 of the type from the direction.
 $D980 SUB $40       ;
 $D982 RLCA          ;
 $D983 RLCA          ;
 $D984 AND $02       ;
 $D986 LD C,A        ; }
 $D987 LD A,(IX+$00) ; {Set bit 1 of the type from the direction, flip bit 0 to change the
 $D98A AND $FD       ; frame, and flip bit 1 as well if the view is rotated.
 $D98C OR C          ;
 $D98D XOR $01       ;
 $D98F XOR B         ;
 $D990 LD (IX+$00),A ; }
 $D993 LD A,(IX+$06) ; {Fetch the direction of the object, and keep bit 6.
 $D996 AND $40       ;
 $D998 LD C,A        ; }
 $D999 LD A,(IX+$07) ; {Set the flip flag of the object from it.
 $D99C AND $BF       ;
 $D99E OR C          ;
 $D99F LD (IX+$07),A ; }
 $D9A2 RET           ; Return.

; Update Village Item
;
; The routine for objects of type #N$30 to #N($3F), the
; items that appear in the village (see #R$C5CE). An item
; wanders about at random while the player
; stays in the cell that it appeared in, and is picked up when the player
; touches it. It turns into a burst, and goes back to the items that are
; available, when the player has gone from the cell or is dead.
@label=UpdateVillageItem
c$D9A3 LD A,($BC8E)    ; {Jump to #R$D9D6 if the player is not there (the type of the player
 $D9A6 SUB $10         ; is not #N$10 to #N$2F).
 $D9A8 CP $20          ;
 $D9AA JR NC,$D9D6     ; }
 $D9AC LD A,($BC90)    ; {Jump to #R$D9DC if the player is not in the column of
 $D9AF CP (IX+$02)     ; the item.
 $D9B2 JR NZ,$D9DC     ; }
 $D9B4 LD A,($BC92)    ; {Jump to #R$D9DC if the player is not in the row of
 $D9B7 CP (IX+$04)     ; the item.
 $D9BA JR NZ,$D9DC     ; }
 $D9BC LD B,$04        ; Use #N$04 bits for the velocity.
 $D9BE CALL $DDCF      ; Choose a random velocity.
 $D9C1 CALL $DE0D      ; Set the direction that the item is facing from its
                       ; velocity.
 $D9C4 CALL $DD01      ; Move the item.
 $D9C7 CALL $CEF8      ; Change the sprite of the item.
 $D9CA CALL $C55F      ; {Return if the item is not touching the player.
 $D9CD RET NC          ; }
 $D9CE CALL $C489      ; Pick up the item.
 $D9D1 LD (IX+$00),$0C ; {Turn the item into a burst and return.
 $D9D5 RET             ; }
; The player is dead.
@label=UpdateVillageItem_Dead
*$D9D6 LD (IX+$00),$0D ; {Turn the item into a burst, with a different sprite, and jump to
 $D9DA JR $D9E0        ; #R$D9E0.}
; The player has left the cell.
@label=UpdateVillageItem_Left
*$D9DC LD (IX+$00),$0C ; Turn the item into a burst.
; Add the item to the items that are available for the kind of tile.
@label=UpdateVillageItem_Return
*$D9E0 LD C,(IX+$05)   ; {Fetch the kind of tile that the item was found on.
 $D9E3 LD B,$00        ; }
 $D9E5 LD HL,$BBCE     ; {Point at the number of items for the kind of tile.
 $D9E8 ADD HL,BC       ; }
 $D9E9 INC (HL)        ; Add one to the number of items that are available.
 $D9EA RET             ; Return.

; Update Bumping Body
;
; The routine for objects of type #N$16 and #N($1E), which is the body of
; the player when the legs have bumped into something. The body stays in this
; pose while the legs are flagged as having bumped into something, and goes back
; to normal otherwise.
@label=UpdateBumpingBody
c$D9EB LD A,(IX-$09) ; {Update the body as normal (see #R$DA00) if the legs have not bumped
 $D9EE BIT 0,A       ; into something.
 $D9F0 JR Z,$DA00    ; }
 $D9F2 LD (IX+$07),A ; Copy the flags of the legs.
 $D9F5 LD A,(IX-$10) ; {Set the type to the bumping pose (sprite #N$06) for the kind of
 $D9F8 AND $F8       ; legs.
 $D9FA OR $06        ;
 $D9FC LD (IX+$00),A ; }
 $D9FF RET           ; Return.

; Update Player Body
;
; Used by the routine at #R$D9EB.
; .
; The routine for objects of type #N$20 to #N($2F), the
; body of the player. The body follows the legs (the object
; before it), and has the same sprite
; number as the legs. A sound is played when the legs bump into something, and
; the body then changes to the bumping pose. When the player is standing still,
; the body occasionally looks around.
@label=UpdatePlayerBody
c$DA00 PUSH IX         ; {Use the position of the body as the destination of the copy
 $DA02 POP DE          ; (using the stack).
 $DA03 INC DE          ; }
 $DA04 LD HL,$FFF0     ; {Use the position of the legs as the source of the
 $DA07 ADD HL,DE       ; copy.}
 $DA08 LD BC,$0005     ; {Copy the position and the speed of the legs.
 $DA0B LDIR            ; }
 $DA0D LD A,(IX-$0A)   ; {Jump to #R$DA46 if the turn counter of the legs is
 $DA10 AND $07         ; zero.
 $DA12 JR Z,$DA46      ; }
@label=UpdatePlayerBody_Copy
*$DA14 LD A,(IX-$10)   ; {Make the type of the body from the type of the legs.
 $DA17 AND $0F         ;
 $DA19 OR $20          ;
 $DA1B LD (IX+$00),A   ; }
 $DA1E LD (IX+$06),$00 ; Clear the direction and timer of the body.
 $DA22 LD A,(IX-$09)   ; {Copy the flags of the legs.
 $DA25 LD (IX+$07),A   ; }
@label=UpdatePlayerBody_Bump
*$DA28 BIT 0,(IX-$09)  ; {Return if the legs have not bumped into something.
 $DA2C RET Z           ; }
 $DA2D LD A,(IX+$00)   ; {Play the sound for a bump, unless the body is in the bumping pose
 $DA30 AND $07         ; already.
 $DA32 CP $06          ;
 $DA34 CALL NZ,$C3AA   ; }
 $DA37 LD A,(IX-$10)   ; {Make the type of the body from the type of the legs, but with the
 $DA3A AND $F8         ; lowest three bits set to #N$06 for the bumping pose.
 $DA3C OR $06          ;
 $DA3E LD (IX+$00),A   ; }
 $DA41 LD (IX+$06),$00 ; Clear the direction and timer of the body.
 $DA45 RET             ; Return.
; The player is standing still, so the body looks around from time to
; time.
@label=UpdatePlayerBody_Idle
*$DA46 LD A,(IX+$06)   ; {Jump to #R$DA72 if the timer of the body has not run
 $DA49 AND A           ; out.
 $DA4A JR NZ,$DA72     ; }
 $DA4C LD A,($BBAA)    ; {Jump to #R$DA14 unless the random seed is less than
 $DA4F CP $08          ; #N$08.
 $DA51 JR NC,$DA14     ; }
 $DA53 AND $01         ; {Choose between two poses from the random seed.
 $DA55 LD C,A          ; }
 $DA56 LD A,(IX-$10)   ; {Set the type of the body to one of the poses for
 $DA59 AND $08         ; looking around.
 $DA5B OR $26          ;
 $DA5D OR C            ;
 $DA5E LD (IX+$00),A   ; }
 $DA61 LD A,R          ; {Set the timer of the body to a random time of two to
 $DA63 AND $07         ; nine frames.
 $DA65 ADD A,$02       ;
 $DA67 LD (IX+$06),A   ; }
 $DA6A LD A,(IX-$09)   ; {Copy the flags of the legs.
 $DA6D LD (IX+$07),A   ; }
 $DA70 JR $DA28        ; Jump to #R$DA28.
@label=UpdatePlayerBody_Timer
*$DA72 DEC A           ; {Count down the timer of the body.
 $DA73 LD (IX+$06),A   ; }
 $DA76 JR Z,$DA14      ; Jump to #R$DA14 if the timer has run out.
 $DA78 JR $DA28        ; Jump to #R$DA28.

; Update Player Legs
;
; The routine for objects of type #N$10 to #N$15 and #N$18 to #N($1D), the
; legs of the player. While the player is materialising, the timer at #R$BC02 is
; advanced by two each frame and the player just flickers into view. Once the
; player is solid, it reads the controls and moves the player.
@label=UpdatePlayerLegs
c$DA7A RES 0,(IX+$07)  ; Clear the flag for a collision.
 $DA7E LD HL,$BC02     ; {Advance the timer for materialising by two.
 $DA81 LD A,(HL)       ;
 $DA82 ADD A,$02       ;
 $DA84 LD (HL),A       ; }
 $DA85 CP $4C          ; {Jump to #R$DAB1 if the player is still materialising.
 $DA87 JR C,$DAB1      ; }
 $DA89 LD (HL),$70     ; Set the timer to the value for a solid player (#N$70).
 $DA8B LD HL,$BBF5     ; {Fetch the time that the speed bonus has left, and skip the next part
 $DA8E LD A,(HL)       ; if it is zero.
 $DA8F AND A           ;
 $DA90 JR Z,$DA9E      ; }
 $DA92 DEC (HL)        ; {Count down the time, and skip the next part if there
 $DA93 JR NZ,$DA9E     ; is some left.}
 $DA95 LD A,$0A        ; {Set the maximum speed back to the normal #N$0A.
 $DA97 LD ($BBBE),A    ; }
 $DA9A LD (IX+$05),$08 ; Set the speed of the player to #N$08.
@label=UpdatePlayerLegs_Controls
*$DA9E CALL $E241      ; Read the controls.
 $DAA1 LD E,C          ; Keep the controls in #REGe.
 $DAA2 CALL $DB68      ; Check whether the key to turn the view has been
                       ; pressed.
 $DAA5 CALL $DB89      ; Work out the direction that the player is facing.
 $DAA8 PUSH DE         ; Keep the controls.
 $DAA9 CALL $DC60      ; Move the player.
 $DAAC POP DE          ; Restore the controls from the stack.
 $DAAD CALL $DAB7      ; Throw an item if the fire button was pressed.
 $DAB0 RET             ; Return.
; The player is materialising.
@label=UpdatePlayerLegs_Materialising
*$DAB1 CALL $DC14      ; Set the sprite of the player.
 $DAB4 JP $C463        ; Play the sound for materialising.

; Throw Item
;
; Used by the routine at #R$DA7A.
; .
; Throws the last item that was picked up, if the fire button has been
; pressed and the previous throw has finished. An item that belongs to a monster
; (items #N$01 to #N$04) is dropped into the object for the monster. Any other
; item becomes a shot, in one of the two objects from #R$BCAE; if both are busy,
; the one that was not used last is turned into a burst.
;
; E Controls
;
; See #POKE(no_throw_delay,No Throw Delay).
@label=ThrowItem
c$DAB7 LD HL,$BBC8     ; {Fetch the time left before another item can be
 $DABA LD A,(HL)       ; thrown.
 $DABB AND A           ;
 $DABC JR Z,$DAC0      ; }
 $DABE DEC (HL)        ; {Count down the time and return if it has not run out.
 $DABF RET             ; }
@label=ThrowItem_Ready
*$DAC0 BIT 3,E         ; {Return if the fire button has not been pressed.
 $DAC2 RET Z           ; }
 $DAC3 LD HL,$BC0D     ; {Point #REGhl at the last place in the inventory, and set a counter
 $DAC6 LD B,$0B        ; of eleven places.}
@label=ThrowItem_Find
*$DAC8 LD A,(HL)       ; {Jump to #R$DAD0 if there is an item in this place.
 $DAC9 AND A           ;
 $DACA JR NZ,$DAD0     ; }
 $DACC DEC HL          ; {Move to the place before it and loop back until all of the places
 $DACD DJNZ $DAC8      ; have been checked.}
 $DACF RET             ; Return.
; An item has been found. Monster items are dropped; any other item
; becomes a shot.
@label=ThrowItem_Found
*$DAD0 CP $05          ; {Jump to #R$DB43 if the item is one of the monster items (#N$01 to
 $DAD2 JR C,$DB43      ; #N$04).}
 $DAD4 LD IY,$BCAE     ; {Point #REGiy at the first shot, and set the size of an object to
 $DAD8 LD DE,$0010     ; #N$0010 bytes.}
 $DADB LD C,$02        ; Set a counter of two shots.
@label=ThrowItem_Shot
*$DADD LD A,(IY+$00)   ; {Jump to #R$DAFD if this shot is free.
 $DAE0 AND A           ;
 $DAE1 JR Z,$DAFD      ; }
 $DAE3 ADD IY,DE       ; {Move on to the next shot and loop back until both
 $DAE5 DEC C           ; have been checked.
 $DAE6 JR NZ,$DADD     ; }
 $DAE8 LD HL,$BCAE     ; Choose the shot that was not used last.
 $DAEB LD A,($BBF4)    ; {Fetch which shot was used last (#N$00 or #N$10).
 $DAEE AND $10         ;
 $DAF0 LD C,A          ; }
 $DAF1 LD B,$00        ; Set the offset of the shot.
 $DAF3 ADD HL,BC       ; Point at the shot.
 $DAF4 LD A,(HL)       ; {Fetch the type of the shot, and subtract #N$50.
 $DAF5 SUB $50         ;
 $DAF7 CP $10          ; }
 $DAF9 RET NC          ; Return if the shot has not got a type of #N$50 to
                       ; #N$5F.
 $DAFA LD (HL),$0C     ; Turn the shot into a burst.
 $DAFC RET             ; Return.
; This shot is free, so the item is copied from the player into it.
@label=ThrowItem_Free
*$DAFD LD A,($BBF4)    ; {Change the shot that was used last.
 $DB00 XOR $10         ;
 $DB02 LD ($BBF4),A    ; }
 $DB05 PUSH BC         ; {Keep the counter and the place in the inventory.
 $DB06 PUSH HL         ; }
 $DB07 LD A,(HL)       ; {Fetch the item and remove it from the inventory.
 $DB08 LD (HL),$00     ; }
 $DB0A LD HL,$BC8E     ; Use the player as the source of the copy.
 $DB0D PUSH IY         ; {Use the shot as the destination of the copy (using the
 $DB0F POP DE          ; stack).}
 $DB10 LD BC,$0010     ; {Copy the player into the shot.
 $DB13 LDIR            ; }
 $DB15 ADD A,A         ; {Make the type of the shot from the item.
 $DB16 ADD A,A         ;
 $DB17 ADD A,$3C       ; }
@label=ThrowItem_Set
*$DB19 LD (IY+$00),A   ; Set the type of the object.
 $DB1C LD (IY+$05),$0C ; Set the speed of the object to #N$0C.
 $DB20 LD A,$10        ; {Set the width and the depth of the object to #N$10.
 $DB22 LD (IY+$08),A   ;
 $DB25 LD (IY+$09),A   ; }
 $DB28 LD (IY+$0C),$F8 ; Set the X offset of the sprite.
 $DB2C LD (IY+$0D),$04 ; Set the Y offset of the sprite.
 $DB30 LD A,$02        ; {Set the time before the next throw to two frames.
 $DB32 LD ($BBC8),A    ; }
 $DB35 POP HL          ; {Restore the inventory place and the counter from the
 $DB36 POP BC          ; stack.}
 $DB37 LD A,B          ; {Work out the number of the place counted from the start of the
 $DB38 NEG             ; inventory.
 $DB3A ADD A,$0C       ;
 $DB3C LD B,A          ; }
 $DB3D CALL $C4A4      ; Redraw the item in the inventory tube.
 $DB40 JP $C3F4        ; Jump to #R$C3F4.
; The item is one of the monster items, which is dropped into the object
; for the monster.
@label=ThrowItem_Drop
*$DB43 PUSH BC         ; {Keep the counter, the place in the inventory and the
 $DB44 PUSH HL         ; item.
 $DB45 PUSH AF         ; }
 $DB46 LD (HL),$00     ; Remove the item from the inventory.
 $DB48 NEG             ; {Work out the offset of the object from the number of
 $DB4A ADD A,$04       ; the item.
 $DB4C ADD A,A         ;
 $DB4D ADD A,A         ;
 $DB4E ADD A,A         ;
 $DB4F ADD A,A         ; }
 $DB50 LD HL,$BD1E     ; {Find the object for the monster.
 $DB53 CALL $E596      ; }
 $DB56 PUSH HL         ; {Point #REGiy at the object, and keep the address of
 $DB57 PUSH HL         ; the object.
 $DB58 POP IY          ;
 $DB5A POP DE          ; }
 $DB5B LD HL,$BC8E     ; {Copy the player into the object.
 $DB5E LD BC,$0010     ;
 $DB61 LDIR            ; }
 $DB63 POP AF          ; {Make the type of the object from the item, and jump
 $DB64 ADD A,$07       ; to #R$DB19.
 $DB66 JR $DB19        ; }

; Check Rotate Key
;
; Used by the routine at #R$DA7A.
; .
; Turns the view around when the key to turn the view has been pressed and
; then released. The view is turned by flipping the rotation flag at #R$BBBA,
; and the player is given a short turn counter. The compass is redrawn.
;
; E Controls
;
; Wait until the key has been pressed and then released.
@label=CheckRotateKey
c$DB68 LD HL,$BBBD   ; Find the flag for the key being held.
 $DB6B BIT 5,E       ; {Jump to #R$DB72 unless the key is pressed.
 $DB6D JR Z,$DB72    ; }
 $DB6F LD (HL),$01   ; {Flag that the key is being held, and return.
 $DB71 RET           ; }
@label=CheckRotateKey_Released
*$DB72 LD A,(HL)     ; {Return if the key was not being held.
 $DB73 AND A         ;
 $DB74 RET Z         ; }
; Flip the view and redraw the compass.
 $DB75 LD (HL),$00   ; Flag that the key is no longer being held.
 $DB77 LD HL,$BBBA   ; {Flip the rotation of the view.
 $DB7A LD A,(HL)     ;
 $DB7B XOR $01       ;
 $DB7D LD (HL),A     ; }
 $DB7E LD A,($BC94)  ; {Give the player a turn counter of at least two.
 $DB81 OR $02        ;
 $DB83 LD ($BC94),A  ; }
 $DB86 JP $C29A      ; Jump to #R$C29A.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$CD0C }
; LIST#

; Choose Direction
;
; Used by the routine at #R$DA7A.
; .
; Works out the direction that the player is facing from the controls,
; which is held in bits 6 and 7 of the direction and timer of the player (0 is
; up the screen, 1 is right, 2 is down and 3 is left). A turn takes a few
; frames, which are counted in the lowest bits of the timer.
; .
; With the keyboard or when the option for directional control is not set, the
; controls for left and right turn the player. When it is set, the player turns
; towards the direction that the controls give, one quarter at a time, and moves
; when it faces that way.
;
;   E Controls
;   IX Player
; O:E Controls, with bit 2 set only if the player is to move forward
;
; Jump to #R$DC14 while a turn is still counting.
@label=ChooseDirection
c$DB89 LD A,(IX+$06) ; Fetch the direction and the time left in a turn.
 $DB8C AND %00000111 ; Keep the time left in a turn.
 $DB8E JR Z,$DB95    ; Jump to #R$DB95 if the player is not turning.
; Count down the turn counter, and set the sprite of the player.
 $DB90 DEC (IX+$06)  ; Count down the time.
 $DB93 JR $DC14      ; Jump to #R$DC14.
; Use the keyboard unless a joystick is set to give a direction.
@label=ChooseDirection_Controls
*$DB95 LD HL,$BBB0   ; Point #REGhl at #R$BBB0.
 $DB98 LD A,(HL)     ; Fetch #R$BBB0.
 $DB99 AND %00000110 ; Keep the bits for the controls.
 $DB9B JR Z,$DBFE    ; Jump to #R$DBFE if the controls are the keyboard.
 $DB9D BIT 3,(HL)    ; {Jump to #R$DBFE if the option for directional control
 $DB9F JR Z,$DBFE    ; is not set.}
; Swap the controls for left and right, and up and down, if the view is
; rotated.
 $DBA1 LD A,($BBBA)  ; Fetch #R$BBBA.
 $DBA4 AND %00000001 ; Keep the lowest bit.
 $DBA6 CALL NZ,$DC43 ; Call #R$DC43 if the view is rotated.
; Turn towards the direction that is pressed.
 $DBA9 BIT 0,E       ; {Jump to #R$DBB1 if the control for left is used.
 $DBAB JR NZ,$DBB1   ; }
 $DBAD BIT 2,E       ; {Jump to #R$DBC0 if the control for up is used.
 $DBAF JR NZ,$DBC0   ; }
; The controls are not for up.
@label=ChooseDirection_Right
*$DBB1 BIT 1,E       ; {Jump to #R$DBE6 if the control for right is used.
 $DBB3 JR NZ,$DBE6   ; }
 $DBB5 BIT 4,E       ; {Jump to #R$DBED if the control for down is used.
 $DBB7 JR NZ,$DBED   ; }
 $DBB9 BIT 0,E       ; {Jump to #R$DBF4 if the control for left is used.
 $DBBB JR NZ,$DBF4   ; }
; Clear the control for up, and return.
 $DBBD RES 2,E       ; Clear bit 2 of the controls.
 $DBBF RET           ; Return.
; The controls are for up.
@label=ChooseDirection_Up
*$DBC0 LD A,(IX+$06) ; Fetch the direction of the player.
; How far is the heading from the direction that is wanted?
@label=ChooseDirection_Turn
*$DBC3 AND %11000000 ; Keep only the heading.
 $DBC5 RES 2,E       ; Clear bit 2 of the controls.
 $DBC7 JR Z,$DBFB    ; Jump to #R$DBFB if the player already faces that way.
 $DBC9 CP $40        ; {Jump to #R$DBD8 if the player has to turn back by a
 $DBCB JR Z,$DBD8    ; quarter.}
 $DBCD CP $C0        ; {Jump to #R$DBDF if the player has to turn on by a
 $DBCF JR Z,$DBDF    ; quarter.}
; Choose which way to turn from the random seed, as the player has to turn
; right round.
 $DBD1 LD A,($BBAA)  ; Fetch the random seed.
 $DBD4 CP $80        ; {Jump to #R$DBDF if it is less than #N$80.
 $DBD6 JR C,$DBDF    ; }
; Turn back a quarter.
@label=ChooseDirection_TurnBack
*$DBD8 LD A,(IX+$06) ; Fetch the direction of the player.
 $DBDB SUB $40       ; Take a quarter turn off it.
 $DBDD JR $DC0F      ; Jump to #R$DC0F.
; Turn on a quarter.
@label=ChooseDirection_TurnOn
*$DBDF LD A,(IX+$06) ; Fetch the direction of the player.
 $DBE2 ADD A,$40     ; Add a quarter turn to it.
 $DBE4 JR $DC0F      ; Jump to #R$DC0F.
; The controls are for right.
@label=ChooseDirection_WantRight
*$DBE6 LD A,(IX+$06) ; Fetch the direction of the player.
 $DBE9 SUB $40       ; Take a quarter turn off it.
 $DBEB JR $DBC3      ; Jump to #R$DBC3.
; The controls are for down.
@label=ChooseDirection_WantDown
*$DBED LD A,(IX+$06) ; Fetch the direction of the player.
 $DBF0 SUB $80       ; Take two quarter turns off it.
 $DBF2 JR $DBC3      ; Jump to #R$DBC3.
; The controls are for left.
@label=ChooseDirection_WantLeft
*$DBF4 LD A,(IX+$06) ; Fetch the direction of the player.
 $DBF7 SUB $C0       ; Take three quarter turns off it.
 $DBF9 JR $DBC3      ; Jump to #R$DBC3.
; The player faces the way that was asked.
@label=ChooseDirection_Forward
*$DBFB SET 2,E       ; {Set the control for moving forward, and return.
 $DBFD RET           ; }
; Left and right turn the player a quarter.
@label=ChooseDirection_Relative
*$DBFE LD A,(IX+$06) ; Fetch the direction of the player.
; Turn the player back by a quarter if the control for left is used.
 $DC01 BIT 0,E       ; {Jump to #R$DC09 if left is not pressed.
 $DC03 JR Z,$DC09    ; }
 $DC05 SUB $40       ; Take a quarter turn off the heading.
 $DC07 OR %00000001  ; Start a turn.
; Right turns the player the other way.
@label=ChooseDirection_RelativeRight
*$DC09 BIT 1,E       ; {Jump to #R$DC11 if right is not pressed.
 $DC0B JR Z,$DC11    ; }
 $DC0D ADD A,$40     ; Add a quarter turn to the heading.
; Start a turn and store the heading.
@label=ChooseDirection_Counter
*$DC0F OR %00000001  ; Start a turn.
@label=ChooseDirection_Set
*$DC11 LD (IX+$06),A ; Set the direction of the player.
; Continue on to #R$DC14.
; .
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$CB86 }
; LIST#

; Set Facing Flags
;
; Used by the routines at #R$DA7A and #R$DB89.
; .
; Sets the sprite of the legs of the player from the direction. Bits 6 and
; 7 of the flags (to flip the sprite) and bit 3 of the type (to choose between
; the two sets of sprites) are taken from the table at #R$DCDC, which is turned
; around by two places when the view is rotated.
;
; IX Player
;
; Look up the flags and the sprite set for the direction.
@label=SetFacingFlags
c$DC14 LD A,(IX+$06) ; {Fetch the direction of the player.
 $DC17 RLCA          ;
 $DC18 RLCA          ;
 $DC19 AND $03       ;
 $DC1B LD L,A        ; }
 $DC1C LD A,($BBBA)  ; {Turn it around if the view is rotated.
 $DC1F ADD A,A       ;
 $DC20 XOR L         ;
 $DC21 LD L,A        ; }
 $DC22 LD H,$00      ; Clear the high byte.
 $DC24 LD BC,$DCDC   ; {Find the entry in the table.
 $DC27 ADD HL,BC     ; }
; Set the flip flags and the sprite set of the legs.
 $DC28 LD A,(HL)     ; {Fetch the flags from the table.
 $DC29 AND $C0       ;
 $DC2B LD C,A        ; }
 $DC2C LD A,(IX+$07) ; {Set the flip flags of the legs.
 $DC2F AND $3F       ;
 $DC31 OR C          ;
 $DC32 LD (IX+$07),A ; }
 $DC35 LD A,(HL)     ; {Fetch the sprite set from the table.
 $DC36 AND $08       ;
 $DC38 LD C,A        ; }
 $DC39 LD A,(IX+$00) ; {Set the sprite set of the legs.
 $DC3C AND $F7       ;
 $DC3E OR C          ;
 $DC3F LD (IX+$00),A ; }
 $DC42 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$CC13 }
; LIST#

; Swap Controls
;
; Used by the routine at #R$DB89.
; .
; Swaps the controls for left and right, and up and down, which turns the
; controls around when the view is rotated. The control for fire is not changed.
;
;   E Controls
; O:E Controls swapped
;
; Swap left with right.
@label=SwapControls
c$DC43 LD A,E        ; {Keep the control for fire.
 $DC44 AND $08       ; }
 $DC46 BIT 0,E       ; {Make the control for right the control for left.
 $DC48 JR Z,$DC4C    ; }
 $DC4A SET 1,A       ; Set the control for left.
@label=SwapControls_Left
*$DC4C BIT 1,E       ; {Make the control for left the control for right.
 $DC4E JR Z,$DC52    ; }
 $DC50 SET 0,A       ; Set the control for right.
; Swap up with down.
@label=SwapControls_Down
*$DC52 BIT 2,E       ; {Make the control for down the control for up.
 $DC54 JR Z,$DC58    ; }
 $DC56 SET 4,A       ; Set the control for up.
@label=SwapControls_Up
*$DC58 BIT 4,E       ; {Make the control for up the control for down.
 $DC5A JR Z,$DC5E    ; }
 $DC5C SET 2,A       ; Set the control for down.
@label=SwapControls_Return
*$DC5E LD E,A        ; {Keep the controls and return.
 $DC5F RET           ; }
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$CD23 }
; LIST#

; Move Player
;
; Used by the routine at #R$DA7A.
; .
; Moves the player. When the control to move forward is used, the speed of
; the player is raised towards the maximum speed in #R$BBBE. Otherwise the
; player slows down and stops at a position that is a multiple of eight units
; from the edge of a cell.
;
; E Controls
; IX Player
;
; Walk if bit 2 is set.
@label=MovePlayer
c$DC60 BIT 2,E       ; {Jump to #R$DCA8 if the control to move forward is used.
 $DC62 JR NZ,$DCA8   ; }
; Otherwise slow down in the direction of the heading.
 $DC64 LD A,(IX+$06) ; Fetch the direction.
 $DC67 RLCA          ; {Move the direction into the lowest two bits.
 $DC68 RLCA          ; }
 $DC69 AND %00000011 ; Keep only the direction.
; Jump to the routine for the direction, to find the part of the position
; that is along the way that the player is moving.
 $DC6B LD BC,$DC71   ; Point #REGbc at #R$DC71.
 $DC6E JP $D593      ; Jump to #R$D593.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$CC42 }
; LIST#

; Slow Down Routines
;
; The routines that #R$DC60 runs to start slowing down the player, for
; each of the four directions.
@label=SlowDownRoutines
w$DC71 DEFW $DC79
 $DC73 DEFW $DC92
 $DC75 DEFW $DC97
 $DC77 DEFW $DC9E

; Slow Player Down
;
; Slows the player down when no control is used to move. The distance to
; the next position that is a multiple of eight units is found, and the speed is
; the distance (up to four units).
;
; IX Player
;
; Heading zero.
@label=SlowPlayerDown
c$DC79 LD A,(IX+$03)   ; Fetch the Y position of the player (moving up the
                       ; screen).
; Find the distance to the next multiple of eight.
@label=SlowPlayerDown_Distance
*$DC7C AND %00000111   ; Keep the lowest three bits.
 $DC7E JR Z,$DCA3      ; Jump to #R$DCA3 if the position is a multiple of
                       ; eight.
 $DC80 NEG             ; {Work out the distance to the next multiple of eight
 $DC82 ADD A,$08       ; units.}
 $DC84 LD C,$04        ; Set a speed of four.
 $DC86 CP C            ; {Jump to #R$DC8F if the distance is four or more.
 $DC87 JR NC,$DC8F     ; }
; Halve the greatest speed, and jump to #R$DC8F if the distance is two or
; more.
 $DC89 SRL C           ; Halve the speed.
 $DC8B CP C            ; {Jump to #R$DC8F if the distance is two or more.
 $DC8C JR NC,$DC8F     ; }
 $DC8E LD C,A          ; Use the distance.
; Move the player at this speed.
@label=SlowPlayerDown_Speed
*$DC8F LD A,C          ; {Set the speed and move the player.
 $DC90 JR $DCB5        ; }
; Heading one.
@label=SlowPlayerDown_Right
 $DC92 LD A,(IX+$01)   ; Fetch the X position of the player (moving right).
 $DC95 JR $DC7C        ; Jump to #R$DC7C.
; Heading two.
@label=SlowPlayerDown_Down
 $DC97 LD A,(IX+$03)   ; Fetch the Y position of the player (moving down the
                       ; screen).
; Heading two or three.
@label=SlowPlayerDown_Negate
*$DC9A NEG             ; Make it negative.
 $DC9C JR $DC7C        ; Jump to #R$DC7C.
; Heading three.
@label=SlowPlayerDown_Left
 $DC9E LD A,(IX+$01)   ; Fetch the X position of the player (moving left).
 $DCA1 JR $DC9A        ; Jump to #R$DC9A.
; The player is at a multiple of eight, so the player stops.
@label=SlowPlayerDown_Stop
*$DCA3 LD (IX+$05),$00 ; {Set the speed of the player to zero and return.
 $DCA7 RET             ; }
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$CC5B }
; LIST#

; Speed Player Up
;
; Used by the routine at #R$DC60.
; .
; Raises the speed of the player half of the way towards the maximum
; speed, keeping it even, and then moves the player.
@label=SpeedPlayerUp
c$DCA8 LD A,($BBBE)   ; {Work out the new speed, which is the average of the current speed
 $DCAB SUB (IX+$05)   ; and the maximum speed (#R$BBBE), made even.
 $DCAE SRL A          ;
 $DCB0 ADD A,(IX+$05) ;
 $DCB3 AND $FE        ; }
; This entry point is used by the routine at #R$DC79.
; .
; Set the speed, move the player and animate the legs.
@label=MovePlayer_Speed
*$DCB5 LD (IX+$05),A  ; Set the speed of the player.
 $DCB8 CALL $DCE0     ; Set the velocity of the player from its speed and
                      ; direction.
 $DCBB CALL $DE59     ; Test whether the move is blocked by the scenery.
 $DCBE CALL $DD01     ; Move the player.
 $DCC1 CALL $BF48     ; Mark the cell that the player is in as visited.
 $DCC4 CALL $C400     ; Play the sound for walking.
 $DCC7 LD A,(IX+$00)  ; {Move on to the next sprite for the legs, from #N$00 to
 $DCCA LD C,A         ; #N$05.
 $DCCB INC A          ;
 $DCCC AND $07        ;
 $DCCE CP $06         ;
 $DCD0 JR C,$DCD3     ; }
 $DCD2 XOR A          ; Clear the sprite number if it went past #N$05.
@label=MovePlayer_SetLegs
*$DCD3 LD B,A         ; {Set the type of the legs.
 $DCD4 LD A,C         ;
 $DCD5 AND $F8        ;
 $DCD7 OR B           ;
 $DCD8 LD (IX+$00),A  ; }
 $DCDB RET            ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$CC8A }
; LIST#

; Player Sprite Table
;
; The flags and the sprite set for each direction of the legs of the
; player. Bits 6 and 7 are the flags for the sprite (bit 6 is to flip it), and
; bit 3 is bit 3 of the type of the legs.
@label=PlayerSpriteTable
b$DCDC DEFB $40,$08,$48,$00

; Set Velocity From Speed
;
; Used by the routines at #R$C083, #R$D70A, #R$D7ED, #R$D80C, #R$D94F and
; #R$DCA8.
; .
; Sets the velocity of an object along the X and Y axes from its speed and
; the direction that it faces. Only one axis is used, and the velocity is
; negative for the directions that face down the screen and to the left.
;
; A Speed
; IX Object
;
; Put the speed on the X axis.
@label=SetVelocityFromSpeed
c$DCE0 LD H,$00       ; {Make the speed the X velocity, with no Y velocity.
 $DCE2 LD L,A         ; }
 $DCE3 BIT 6,(IX+$06) ; {Jump to #R$DCEC if the direction is along x.
 $DCE7 JR NZ,$DCEC    ; }
; Put the speed on the Y axis.
 $DCE9 LD H,A         ; {Make the speed the Y velocity, with no X velocity.
 $DCEA LD L,$00       ; }
; Make the speed negative for down and left.
@label=SetVelocityFromSpeed_Sign
*$DCEC BIT 7,(IX+$06) ; {Jump to #R$DCFA unless the direction faces down the screen or to the
 $DCF0 JR Z,$DCFA     ; left.}
; Negate the velocity along both axes.
 $DCF2 LD A,L         ; {Make the X velocity negative.
 $DCF3 NEG            ;
 $DCF5 LD L,A         ; }
 $DCF6 LD A,H         ; {Make the Y velocity negative.
 $DCF7 NEG            ;
 $DCF9 LD H,A         ; }
; Store the velocities.
@label=SetVelocityFromSpeed_Set
*$DCFA LD (IX+$0A),L  ; Set the X velocity of the object.
 $DCFD LD (IX+$0B),H  ; {Set the Y velocity and return.
 $DD00 RET            ; }
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$CCC2 }
; LIST#

; Move Object
;
; Used by the routines at #R$BFF1, #R$C083, #R$CE89, #R$D70A, #R$D7ED, #R$D80C,
; #R$D94F, #R$D9A3 and #R$DCA8.
; .
; Moves an object by adding its velocity along each axis to its position.
;
; IX Object
@label=MoveObject
c$DD01 LD A,(IX+$0A) ; {Add the velocity along the X axis to the X position of
 $DD04 CALL $E0E5    ; the object.
 $DD07 LD C,(IX+$01) ;
 $DD0A LD B,(IX+$02) ;
 $DD0D ADD HL,BC     ;
 $DD0E LD (IX+$01),L ;
 $DD11 LD (IX+$02),H ; }
 $DD14 LD A,(IX+$0B) ; {Add the velocity along the Y axis to the Y position of
 $DD17 CALL $E0E5    ; the object.
 $DD1A LD C,(IX+$03) ;
 $DD1D LD B,(IX+$04) ;
 $DD20 ADD HL,BC     ;
 $DD21 LD (IX+$03),L ;
 $DD24 LD (IX+$04),H ; }
 $DD27 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$CCE5 }
; LIST#

; Update Direction
;
; Used by the routines at #R$C083 and #R$D94F.
; .
; Changes the direction that an object is facing when the timer for the
; direction has run out (the lowest five bits of the direction and timer) or the
; object has hit something. The object turns a quarter to the left or to the
; right, chosen from the random seed, or, if it has been flagged as chasing the
; player (bit 5 of the flags), turns towards the player. A new timer is set.
;
; IX Object
;
; Change direction at once if the object has hit a wall.
@label=UpdateDirection
c$DD28 BIT 0,(IX+$07) ; {Jump to #R$DD3D if the object has hit something.
 $DD2C JR NZ,$DD3D    ; }
; Count down the timer, and return unless it has run out.
 $DD2E DEC (IX+$06)   ; Count down the timer.
 $DD31 LD A,(IX+$06)  ; Fetch the timer.
 $DD34 AND %00011111  ; Keep the bottom five bits.
 $DD36 RET NZ         ; Return unless the timer has run out.
 $DD37 BIT 5,(IX+$07) ; {Jump to #R$DD58 if the object chases the player.
 $DD3B JR NZ,$DD58    ; }
; Turn left or right and set a new timer.
@label=UpdateDirection_Random
*$DD3D LD A,($BBAA)   ; Fetch a random number.
 $DD40 CP $80         ; Compare it with #N$80.
 $DD42 LD A,(IX+$06)  ; Fetch the direction and timer.
 $DD45 JR NC,$DD54    ; Jump to #R$DD54 to turn back if the random number is
                      ; #N$80 or more.
 $DD47 ADD A,$40      ; Turn on a quarter.
; Set a timer from the second random seed, set the direction and return.
@label=UpdateDirection_Timer
*$DD49 LD C,A         ; Keep the new direction in #REGc.
 $DD4A LD A,($BBAB)   ; Fetch another random number.
 $DD4D AND %00111111  ; Keep the bottom six bits.
 $DD4F OR C           ; Combine it with the direction.
 $DD50 LD (IX+$06),A  ; Store the new direction.
 $DD53 RET            ; Return.
; The random number was #N$80 or more, so turn back.
@label=UpdateDirection_Back
*$DD54 SUB $40        ; Turn back a quarter.
 $DD56 JR $DD49       ; Jump to #R$DD49.
; The object chases the player, so work out where the player is compared
; with the direction that the object is facing.
@label=UpdateDirection_Chase
*$DD58 CALL $DD99     ; Find the direction towards the player.
 $DD5B LD C,A         ; Keep it.
 $DD5C LD A,(IX+$06)  ; {Work out how far the object has to turn.
 $DD5F RLCA           ;
 $DD60 RLCA           ;
 $DD61 SUB C          ;
 $DD62 AND $03        ; }
 $DD64 LD BC,$DD6A    ; {Jump to the routine for the amount.
 $DD67 JP $D593       ; }
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$B82A }
; LIST#

; Turn Routines
;
; The routines that #R$DD28 runs to turn an object towards the player, by
; the amount that it has to turn: none, a quarter back, right round and a
; quarter on.
@label=TurnRoutines
w$DD6A DEFW $DD81
 $DD6C DEFW $DD79
 $DD6E DEFW $DD72
 $DD70 DEFW $DD92

; Turn Towards Player
;
; Turns an object towards the player, by a quarter back (from #R$DD79), by
; a quarter on (from #R$DD92) or, from #R$DD72, right round by turning a quarter
; in a direction chosen from the random seed. The direction gets a timer of one
; to sixteen.
;
; IX Object
@label=TurnTowardsPlayer
c$DD72 LD A,($BBAB)  ; {Fetch the random seed, and jump to #R$DD92 if it is
 $DD75 CP $80        ; less than #N$80.
 $DD77 JR C,$DD92    ; }
@label=TurnTowardsPlayer_Back
 $DD79 LD A,(IX+$06) ; {Turn back a quarter.
 $DD7C SUB $40       ; }
@label=TurnTowardsPlayer_Set
*$DD7E LD (IX+$06),A ; Set the direction.
@label=TurnTowardsPlayer_Timer
 $DD81 LD A,(IX+$06) ; {Fetch the direction, and keep only the direction.
 $DD84 AND $C0       ;
 $DD86 LD C,A        ; }
 $DD87 LD A,($BBAA)  ; {Set a timer of one to sixteen from the random seed.
 $DD8A AND $0F       ;
 $DD8C INC A         ;
 $DD8D OR C          ;
 $DD8E LD (IX+$06),A ; }
 $DD91 RET           ; Return.
@label=TurnTowardsPlayer_On
*$DD92 LD A,(IX+$06) ; {Turn on a quarter, and jump to #R$DD7E.
 $DD95 ADD A,$40     ;
 $DD97 JR $DD7E      ; }

; Find Direction To Player
;
; Used by the routine at #R$DD28.
; .
; Works out which of the four directions an object has to face to move
; towards the player, using the axis along which the player is furthest away.
;
;   IX Object
; O:A The direction (0 up, 1 right, 2 down and 3 left)
;
; Find the axis along which the player is furthest away.
@label=FindDirectionToPlayer
c$DD99 LD HL,($BC8F) ; {Work out the distance along the X axis from the object to the
 $DD9C LD E,(IX+$01) ; player.
 $DD9F LD D,(IX+$02) ;
 $DDA2 AND A         ;
 $DDA3 SBC HL,DE     ; }
 $DDA5 PUSH HL       ; Stash the signed distance on the stack.
 $DDA6 BIT 7,H       ; {Make it positive, and keep it in #REGde.
 $DDA8 CALL NZ,$E0DD ;
 $DDAB EX DE,HL      ; }
 $DDAC LD HL,($BC91) ; {Work out the distance along the Y axis from the object to the
 $DDAF LD C,(IX+$03) ; player.
 $DDB2 LD B,(IX+$04) ;
 $DDB5 AND A         ;
 $DDB6 SBC HL,BC     ; }
 $DDB8 PUSH HL       ; Stash the signed distance on the stack.
 $DDB9 BIT 7,H       ; {Make it positive.
 $DDBB CALL NZ,$E0DD ; }
 $DDBE AND A         ; {Compare it with the distance along the X axis, and start with the
 $DDBF SBC HL,DE     ; direction up the screen.
 $DDC1 LD A,$00      ; }
 $DDC3 POP HL        ; {Restore the distances from the stack.
 $DDC4 POP DE        ; }
 $DDC5 JR NC,$DDC9   ; Jump to #R$DDC9 if the player is further along the Y
                     ; axis.
 $DDC7 INC A         ; {Use the direction to the right, and use the distance along the X
 $DDC8 EX DE,HL      ; axis.}
; Reverse the direction if the player is at a negative distance.
@label=FindDirectionToPlayer_Sign
*$DDC9 BIT 7,H       ; {Return if the player is not at a negative distance.
 $DDCB RET Z         ; }
 $DDCC ADD A,$02     ; {Use the opposite direction, and return.
 $DDCE RET           ; }

; Choose Random Velocity
;
; Used by the routines at #R$CE89 and #R$D9A3.
; .
; Chooses a new random velocity along both axes for an object when the
; timer has run out (the lowest six bits of the direction and timer) or when the
; object is not moving. The velocity along each axis is an even number, chosen
; from the random seeds. A new timer is set from the memory refresh register.
;
; B Number of random bits to use for each velocity
; IX Object
@label=ChooseRandomVelocity
c$DDCF DEC (IX+$06)  ; {Count down the timer, and jump to #R$DDE0 if it has run
 $DDD2 LD A,(IX+$06) ; out.
 $DDD5 AND $3F       ;
 $DDD7 JR Z,$DDE0    ; }
 $DDD9 LD A,(IX+$0A) ; {Return if the object is moving.
 $DDDC OR (IX+$0B)   ;
 $DDDF RET NZ        ; }
@label=ChooseRandomVelocity_Choose
*$DDE0 LD A,($BBAA)  ; {Choose the velocity along the X axis from the first
 $DDE3 LD C,A        ; random seed.
 $DDE4 CALL $DDFC    ;
 $DDE7 LD (IX+$0A),A ; }
 $DDEA LD A,($BBAB)  ; {Choose the velocity along the Y axis from the second
 $DDED LD C,A        ; random seed.
 $DDEE CALL $DDFC    ;
 $DDF1 LD (IX+$0B),A ; }
 $DDF4 LD A,R        ; {Set a random timer.
 $DDF6 AND $3F       ;
 $DDF8 LD (IX+$06),A ; }
 $DDFB RET           ; Return.

; Choose Velocity
;
; Used by the routine at #R$DDCF.
; .
; Makes a random velocity from a random number. The velocity is two for
; each of the bits that are not set in the lowest bits of the number, and it is
; negative if the next bit is not set.
;
;   B Number of bits to use
;   C Random number
; O:A Velocity
@label=ChooseVelocity
c$DDFC PUSH BC       ; {Keep the registers, and start with a velocity of zero.
 $DDFD XOR A         ; }
@label=ChooseVelocity_Loop
*$DDFE RR C          ; {Test the next bit of the random number, and jump to #R$DE04 if it is
 $DE00 JR C,$DE04    ; set.}
 $DE02 ADD A,$02     ; Add two to the velocity.
@label=ChooseVelocity_Next
*$DE04 DJNZ $DDFE    ; Loop back until all the bits have been used.
 $DE06 RR C          ; {Test the next bit for the sign, restore the registers and return if
 $DE08 POP BC        ; it is set.
 $DE09 RET C         ; }
 $DE0A NEG           ; {Make the velocity negative and return.
 $DE0C RET           ; }

; Set Direction From Velocity
;
; Used by the routines at #R$BFF1, #R$CE89 and #R$D9A3.
; .
; Makes an object face the direction that it is moving in, and tests
; whether it can move that way. The direction along the X axis is used first,
; and then the one along the Y axis, so that an object that is moving along both
; axes ends up facing along the Y axis (if the velocity along that axis is not
; zero).
;
; IX Object
;
; Face along the X axis first.
@label=SetDirectionFromVelocity
c$DE0D LD A,(IX+$0A)   ; {Jump to #R$DE33 if the velocity along the X axis is
 $DE10 AND A           ; zero.
 $DE11 JR Z,$DE33      ; }
 $DE13 LD A,$40        ; {Face right...
 $DE15 JP P,$DE1A      ; }
 $DE18 OR %10000000    ; ... or face left, if the velocity is negative.
@label=SetDirectionFromVelocity_X
*$DE1A LD C,A          ; Keep the direction.
 $DE1B LD A,(IX+$06)   ; {Set the direction of the object.
 $DE1E AND $3F         ;
 $DE20 OR C            ;
 $DE21 LD (IX+$06),A   ; }
 $DE24 LD A,(IX+$0B)   ; {Stash the velocity along the Y axis, and set it to
 $DE27 PUSH AF         ; zero.
 $DE28 LD (IX+$0B),$00 ; }
 $DE2C CALL $DE59      ; Test whether the object can move that way.
 $DE2F POP AF          ; {Restore the velocity along the Y axis from the stack.
 $DE30 LD (IX+$0B),A   ; }
; Then face along the Y axis.
@label=SetDirectionFromVelocity_Y
*$DE33 LD A,(IX+$0B)   ; {Return if the velocity along the Y axis is zero.
 $DE36 AND A           ;
 $DE37 RET Z           ; }
 $DE38 LD A,$00        ; {Face up the screen...
 $DE3A JP P,$DE3F      ; }
 $DE3D OR %10000000    ; ... or face down the screen, if the velocity is
                       ; negative.
@label=SetDirectionFromVelocity_Set
*$DE3F LD C,A          ; Keep the direction.
 $DE40 LD A,(IX+$06)   ; {Set the direction of the object.
 $DE43 AND $3F         ;
 $DE45 OR C            ;
 $DE46 LD (IX+$06),A   ; }
 $DE49 LD A,(IX+$0A)   ; {Keep the velocity along the X axis, and set it to
 $DE4C PUSH AF         ; zero.
 $DE4D LD (IX+$0A),$00 ; }
 $DE51 CALL $DE5D      ; Test whether the object can move that way.
 $DE54 POP AF          ; {Restore the velocity along the X axis from the stack.
 $DE55 LD (IX+$0A),A   ; }
 $DE58 RET             ; Return.

; Test Move
;
; Used by the routines at #R$C083, #R$D70A, #R$D7ED, #R$D80C, #R$D94F, #R$DCA8
; and #R$DE0D.
; .
; Tests whether an object can move in the direction that it is facing, by
; testing the cells that its front edge touches (including the cells that the
; velocity takes it into) for walls. A wall changes the velocity so that the
; object stops at the wall, and sets the flag for a collision (bit 0 of the
; flags).
;
; IX Object
;
; Clear bit 0 of the flags, then run the routine for the heading.
@label=TestMove
c$DE59 RES 0,(IX+$07) ; Clear the flag for a collision.
; This entry point is used by the routines at #R$D7ED, #R$D80C and #R$DE0D.
; .
; Run the routine for the heading, without clearing the flag.
@label=TestMove_Keep
*$DE5D LD A,(IX+$06)  ; Fetch the direction that the object is facing.
 $DE60 RLCA           ; {Move the direction into the lowest two bits.
 $DE61 RLCA           ; }
 $DE62 AND %00000011  ; Keep only the direction.
; Run the routine for the direction.
 $DE64 LD BC,$DE6A    ; Point #REGbc at #R$DE6A.
 $DE67 JP $D593       ; Jump to #R$D593.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$CD8C }
; LIST#

; Test Move Routines
;
; The routines that #R$DE5D runs to test a move, for each of the four
; directions (up the screen, right, down the screen and left).
@label=TestMoveRoutines
w$DE6A DEFW $DE72
 $DE6C DEFW $DED3
 $DE6E DEFW $DF34
 $DE70 DEFW $DF97

; Test Move Up
;
; Tests the move of an object that is facing up the screen (along the
; positive Y axis). The front edge is at the Y position plus the depth of the
; object, and it is tested from the left corner to the right corner, in the cell
; that the edge is in and then in the next one along the Y axis that the
; velocity takes the object into. Each cell is tested by #R$DFFA.
;
;   IX Object
; O:F The carry flag is set if there was a collision
@label=TestMoveUp
c$DE72 LD L,(IX+$01) ; {Fetch the X position of the object.
 $DE75 LD H,(IX+$02) ; }
 $DE78 LD C,(IX+$08) ; {Fetch the half width of the object.
 $DE7B LD B,$00      ; }
 $DE7D AND A         ; {Subtract it to get the left edge, and keep it in
 $DE7E SBC HL,BC     ; #REGde.
 $DE80 EX DE,HL      ; }
 $DE81 LD L,(IX+$03) ; {Fetch the Y position of the object.
 $DE84 LD H,(IX+$04) ; }
 $DE87 LD C,(IX+$09) ; {Add the half depth to get the front edge.
 $DE8A ADD HL,BC     ; }
 $DE8B PUSH DE       ; {Save the left edge and the front edge.
 $DE8C PUSH HL       ; }
 $DE8D CALL $DFFA    ; Check whether the front left corner of the object hits a
                     ; wall.
 $DE90 POP DE        ; {Get the edges back, with the registers swapped over.
 $DE91 POP HL        ; }
 $DE92 RET C         ; Return if the object hit a wall.
 $DE93 PUSH HL       ; {Save the edges again.
 $DE94 PUSH DE       ; }
 $DE95 LD C,(IX+$08) ; {Work out the width of the object.
 $DE98 SLA C         ;
 $DE9A LD B,$00      ; }
 $DE9C LD A,H        ; Keep the cell of the left edge.
 $DE9D ADD HL,BC     ; Work out the right edge.
 $DE9E CP H          ; {Jump to #R$DEC5 if the right edge is in the same cell as the left
 $DE9F JR Z,$DEC5    ; edge.}
 $DEA1 EX DE,HL      ; Use the right edge.
 $DEA2 CALL $DFFA    ; Check whether the front right corner of the object hits
                     ; a wall.
 $DEA5 POP HL        ; {Get the edges back.
 $DEA6 POP DE        ; }
 $DEA7 RET C         ; Return if the object hit a wall.
 $DEA8 LD C,(IX+$0B) ; {Fetch the velocity along the Y axis.
 $DEAB LD B,$00      ; }
 $DEAD LD A,H        ; Keep the cell of the front edge.
 $DEAE ADD HL,BC     ; Work out where the velocity takes the front edge to.
 $DEAF CP H          ; {Return if the front edge stays in the same cell.
 $DEB0 RET Z         ; }
 $DEB1 PUSH DE       ; {Save the edges.
 $DEB2 PUSH HL       ; }
 $DEB3 CALL $DFFA    ; Check whether the front left corner hits a wall in the
                     ; next cell.
 $DEB6 POP DE        ; {Get the edges back, with the registers swapped over.
 $DEB7 POP HL        ; }
 $DEB8 RET C         ; Return if the object hit a wall.
 $DEB9 LD C,(IX+$08) ; {Work out the width of the object.
 $DEBC SLA C         ;
 $DEBE LD B,$00      ; }
 $DEC0 ADD HL,BC     ; Work out the right edge.
 $DEC1 EX DE,HL      ; Use the right edge.
; Check whether the front right corner hits a wall in the next cell.
 $DEC2 JP $DFFA      ; Jump to #R$DFFA.
; The left and right edges are in the same cell.
@label=TestMoveUp_SameCell
*$DEC5 POP HL        ; {Get the edges back.
 $DEC6 POP DE        ; }
 $DEC7 LD C,(IX+$0B) ; {Fetch the velocity along the Y axis.
 $DECA LD B,$00      ; }
 $DECC LD A,H        ; Keep the cell of the front edge.
 $DECD ADD HL,BC     ; Work out where the velocity takes the front edge to.
 $DECE CP H          ; {Return if the front edge stays in the same cell.
 $DECF RET Z         ; }
; Check whether the front edge hits a wall in the next cell.
 $DED0 JP $DFFA      ; Jump to #R$DFFA.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$CDA5 }
; LIST#

; Test Move Right
;
; Tests the move of an object that is facing to the right (along the
; positive X axis), in the same way as #R$DE72. The front edge is at the X
; position plus the half width of the object, and it is tested from the top
; corner to the bottom corner. Each cell is tested by #R$E013.
;
;   IX Object
; O:F The carry flag is set if there was a collision
@label=TestMoveRight
c$DED3 LD L,(IX+$01) ; {Fetch the X position of the object.
 $DED6 LD H,(IX+$02) ; }
 $DED9 LD C,(IX+$08) ; {Fetch the half width of the object.
 $DEDC LD B,$00      ; }
 $DEDE ADD HL,BC     ; Add it to get the front edge.
 $DEDF EX DE,HL      ; Keep the front edge.
 $DEE0 LD L,(IX+$03) ; {Fetch the Y position of the object.
 $DEE3 LD H,(IX+$04) ; }
 $DEE6 LD C,(IX+$09) ; Fetch the half depth of the object.
 $DEE9 AND A         ; {Subtract it to get the first side edge.
 $DEEA SBC HL,BC     ; }
 $DEEC PUSH DE       ; {Save the edges.
 $DEED PUSH HL       ; }
 $DEEE CALL $E013    ; Check whether the first corner of the front edge hits a
                     ; wall.
 $DEF1 POP HL        ; {Get the edges back.
 $DEF2 POP DE        ; }
 $DEF3 RET C         ; Return if the object hit a wall.
 $DEF4 PUSH DE       ; {Save the edges again.
 $DEF5 PUSH HL       ; }
 $DEF6 LD C,(IX+$09) ; {Work out the depth of the object.
 $DEF9 SLA C         ;
 $DEFB LD B,$00      ; }
 $DEFD LD A,H        ; Keep the cell of the first side edge.
 $DEFE ADD HL,BC     ; Work out the second side edge.
 $DEFF CP H          ; {Jump to #R$DF25 if the second side edge is in the same cell as the
 $DF00 JR Z,$DF25    ; first.}
 $DF02 CALL $E013    ; Check whether the second corner of the front edge hits a
                     ; wall.
 $DF05 POP DE        ; {Get the edges back, with the registers swapped over.
 $DF06 POP HL        ; }
 $DF07 RET C         ; Return if the object hit a wall.
 $DF08 LD C,(IX+$0A) ; {Fetch the velocity along the X axis.
 $DF0B LD B,$00      ; }
 $DF0D LD A,H        ; Keep the cell of the front edge.
 $DF0E ADD HL,BC     ; Work out where the velocity takes the front edge to.
 $DF0F CP H          ; {Return if the front edge stays in the same cell.
 $DF10 RET Z         ; }
@label=TestMoveRight_Next
 $DF11 EX DE,HL      ; Use the new position of the front edge.
 $DF12 PUSH DE       ; {Save the edges.
 $DF13 PUSH HL       ; }
 $DF14 CALL $E013    ; Check whether the first corner hits a wall in the next
                     ; cell.
 $DF17 POP HL        ; {Get the edges back.
 $DF18 POP DE        ; }
 $DF19 RET C         ; Return if the object hit a wall.
 $DF1A LD C,(IX+$09) ; {Work out the depth of the object.
 $DF1D SLA C         ;
 $DF1F LD B,$00      ; }
 $DF21 ADD HL,BC     ; Work out the second side edge.
; Check whether the second corner hits a wall in the next cell.
 $DF22 JP $E013      ; Jump to #R$E013.
; The side edges are in the same cell.
@label=TestMoveRight_SameCell
*$DF25 POP DE        ; {Get the edges back, with the registers swapped over.
 $DF26 POP HL        ; }
 $DF27 LD C,(IX+$0A) ; {Fetch the velocity along the X axis.
 $DF2A LD B,$00      ; }
 $DF2C LD A,H        ; Keep the cell of the front edge.
 $DF2D ADD HL,BC     ; Work out where the velocity takes the front edge to.
 $DF2E CP H          ; {Return if the front edge stays in the same cell.
 $DF2F RET Z         ; }
 $DF30 EX DE,HL      ; Use the new position of the front edge.
; Check whether the first corner hits a wall in the next cell.
 $DF31 JP $E013      ; Jump to #R$E013.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$CE08 }
; LIST#

; Test Move Down
;
; Tests the move of an object that is facing down the screen (along the
; negative Y axis), in the same way as #R$DE72. The front edge is at the Y
; position minus the half depth of the object, and it is tested from the left
; corner to the right corner. Each cell is tested by #R$E00B.
;
;   IX Object
; O:F The carry flag is set if there was a collision
@label=TestMoveDown
c$DF34 LD L,(IX+$01) ; {Fetch the X position of the object.
 $DF37 LD H,(IX+$02) ; }
 $DF3A LD C,(IX+$08) ; {Fetch the half width of the object.
 $DF3D LD B,$00      ; }
 $DF3F AND A         ; {Subtract it to get the left edge, and keep it in
 $DF40 SBC HL,BC     ; #REGde.
 $DF42 EX DE,HL      ; }
 $DF43 LD L,(IX+$03) ; {Fetch the Y position of the object.
 $DF46 LD H,(IX+$04) ; }
 $DF49 LD C,(IX+$09) ; Fetch the half depth of the object.
 $DF4C AND A         ; {Subtract it to get the front edge.
 $DF4D SBC HL,BC     ; }
 $DF4F PUSH DE       ; {Save the edges.
 $DF50 PUSH HL       ; }
 $DF51 CALL $E00B    ; Check whether the front left corner of the object hits a
                     ; wall.
 $DF54 POP DE        ; {Get the edges back, with the registers swapped over.
 $DF55 POP HL        ; }
 $DF56 RET C         ; Return if the object hit a wall.
 $DF57 PUSH HL       ; {Save the edges again.
 $DF58 PUSH DE       ; }
 $DF59 LD C,(IX+$08) ; {Work out the width of the object.
 $DF5C SLA C         ;
 $DF5E LD B,$00      ; }
 $DF60 LD A,H        ; Keep the cell of the left edge.
 $DF61 ADD HL,BC     ; Work out the right edge.
 $DF62 CP H          ; {Jump to #R$DF89 if the right edge is in the same cell as the left
 $DF63 JR Z,$DF89    ; edge.}
 $DF65 EX DE,HL      ; Use the right edge.
 $DF66 CALL $E00B    ; Check whether the front right corner of the object hits
                     ; a wall.
 $DF69 POP HL        ; {Get the edges back.
 $DF6A POP DE        ; }
 $DF6B RET C         ; Return if the object hit a wall.
; Check the cells after the move.
 $DF6C LD C,(IX+$0B) ; Fetch the velocity along the Y axis.
 $DF6F LD B,$FF      ; Make it a negative word in #REGbc.
; Work out the position that the velocity takes the front edge to, and
; return if it is in the same cell.
 $DF71 LD A,H        ; {Find the front edge after the move.
 $DF72 ADD HL,BC     ; }
 $DF73 CP H          ; {Return if it is in the same cell.
 $DF74 RET Z         ; }
 $DF75 PUSH DE       ; {Save the edges.
 $DF76 PUSH HL       ; }
 $DF77 CALL $E00B    ; Check whether the front left corner hits a wall in the
                     ; next cell.
 $DF7A POP DE        ; {Get the edges back, with the registers swapped over.
 $DF7B POP HL        ; }
 $DF7C RET C         ; Return if the object hit a wall.
 $DF7D LD C,(IX+$08) ; {Work out the width of the object.
 $DF80 SLA C         ;
 $DF82 LD B,$00      ; }
 $DF84 ADD HL,BC     ; Work out the right edge.
 $DF85 EX DE,HL      ; Use the right edge.
; Check whether the front right corner hits a wall in the next cell.
 $DF86 JP $E00B      ; Jump to #R$E00B.
; The left and right edges are in the same cell.
@label=TestMoveDown_SameCell
*$DF89 POP HL        ; {Get the edges back.
 $DF8A POP DE        ; }
; Fetch the velocity along the Y axis, which is negative.
 $DF8B LD C,(IX+$0B) ; Fetch the velocity along the Y axis.
 $DF8E LD B,$FF      ; Make it a negative word in #REGbc.
; Work out the position that the velocity takes the front edge to, and
; return if it is in the same cell.
 $DF90 LD A,H        ; {Find the front edge after the move.
 $DF91 ADD HL,BC     ; }
 $DF92 CP H          ; {Return if it is in the same cell.
 $DF93 RET Z         ; }
; Check whether the front edge hits a wall in the next cell.
 $DF94 JP $E00B      ; Jump to #R$E00B.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$CE6B }
; LIST#

; Test Move Left
;
; Tests the move of an object that is facing to the left (along the
; negative X axis), in the same way as #R$DE72. The front edge is at the X
; position minus the half width of the object, and it is tested from the top
; corner to the bottom corner. Each cell is tested by #R$E020.
;
;   IX Object
; O:F The carry flag is set if there was a collision
@label=TestMoveLeft
c$DF97 LD L,(IX+$01) ; {Fetch the X position of the object.
 $DF9A LD H,(IX+$02) ; }
 $DF9D LD C,(IX+$08) ; {Fetch the half width of the object.
 $DFA0 LD B,$00      ; }
 $DFA2 AND A         ; {Subtract it to get the front edge, and keep it in
 $DFA3 SBC HL,BC     ; #REGde.
 $DFA5 EX DE,HL      ; }
 $DFA6 LD L,(IX+$03) ; {Fetch the Y position of the object.
 $DFA9 LD H,(IX+$04) ; }
 $DFAC LD C,(IX+$09) ; Fetch the half depth of the object.
 $DFAF AND A         ; {Subtract it to get the first side edge.
 $DFB0 SBC HL,BC     ; }
 $DFB2 PUSH DE       ; {Save the edges.
 $DFB3 PUSH HL       ; }
 $DFB4 CALL $E020    ; Check whether the first corner of the front edge hits a
                     ; wall.
 $DFB7 POP HL        ; {Get the edges back, with the registers swapped over.
 $DFB8 POP DE        ; }
 $DFB9 RET C         ; Return if the object hit a wall.
 $DFBA PUSH DE       ; {Save the edges again.
 $DFBB PUSH HL       ; }
 $DFBC LD C,(IX+$09) ; {Work out the depth of the object.
 $DFBF SLA C         ;
 $DFC1 LD B,$00      ; }
 $DFC3 LD A,H        ; {Work out the second side edge.
 $DFC4 ADD HL,BC     ; }
 $DFC5 CP H          ; {Jump to #R$DFEB if the second side edge is in the same cell as the
 $DFC6 JR Z,$DFEB    ; first.}
 $DFC8 CALL $E020    ; Check whether the second corner of the front edge hits a
                     ; wall.
 $DFCB POP DE        ; {Get the edges back.
 $DFCC POP HL        ; }
 $DFCD RET C         ; Return if the object hit a wall.
; Check the cells after the move.
 $DFCE LD C,(IX+$0A) ; Fetch the velocity along the X axis.
 $DFD1 LD B,$FF      ; Make it a negative word in #REGbc.
; Work out the position that the velocity takes the front edge to, and
; return if it is in the same cell.
 $DFD3 LD A,H        ; {Find the front edge after the move.
 $DFD4 ADD HL,BC     ; }
 $DFD5 CP H          ; {Return if it is in the same cell.
 $DFD6 RET Z         ; }
 $DFD7 EX DE,HL      ; Use the new position of the front edge.
 $DFD8 PUSH DE       ; {Save the edges.
 $DFD9 PUSH HL       ; }
 $DFDA CALL $E020    ; Check whether the first corner hits a wall in the next
                     ; cell.
 $DFDD POP HL        ; {Get the edges back, with the registers swapped over.
 $DFDE POP DE        ; }
 $DFDF RET C         ; Return if the object hit a wall.
 $DFE0 LD C,(IX+$09) ; {Work out the depth of the object.
 $DFE3 SLA C         ;
 $DFE5 LD B,$00      ; }
 $DFE7 ADD HL,BC     ; Work out the second side edge.
; Check whether the second corner hits a wall in the next cell.
 $DFE8 JP $E020      ; Jump to #R$E020.
; The side edges are in the same cell.
@label=TestMoveLeft_SameCell
*$DFEB POP DE        ; {Get the edges back.
 $DFEC POP HL        ; }
; Fetch the velocity along the X axis, which is negative.
 $DFED LD C,(IX+$0A) ; Fetch the velocity along the X axis.
 $DFF0 LD B,$FF      ; Make it a negative word in #REGbc.
; Work out the position that the velocity takes the front edge to, and
; return if it is in the same cell.
 $DFF2 LD A,H        ; {Find the front edge after the move.
 $DFF3 ADD HL,BC     ; }
 $DFF4 CP H          ; {Return if it is in the same cell.
 $DFF5 RET Z         ; }
 $DFF6 EX DE,HL      ; Use the new position of the front edge.
; Check whether the first corner hits a wall in the next cell.
 $DFF7 JP $E020      ; Jump to #R$E020.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$CED0 }
; LIST#

; Test Cell Moving Up
;
; Used by the routine at #R$DE72.
; .
; Tests an object that is moving up the screen (along the positive Y axis)
; against the walls in one cell. If the object hits a wall then its velocity
; along the Y axis is reduced by twice the depth that it has gone into the wall,
; and the flag for a collision is set.
;
;   DE X position to test
;   HL Y position to test
;   IX Object
; O:F The carry flag is set if there was a collision
;
; Check the walls, then push the object back if it is touching one.
@label=TestCellMovingUp
c$DFFA CALL $E0A0     ; Check whether the object hits a wall in the cell.
 $DFFD RET NC         ; Return if it did not.
; This entry point is used by the routine at #R$E00B.
; .
; Reduce the velocity along the Y axis.
@label=ReduceVelocityY
*$DFFE ADD A,A        ; Double the depth.
 $DFFF ADD A,(IX+$0B) ; {Add it to the velocity along the Y axis, which stops the object at
 $E002 LD (IX+$0B),A  ; the wall.}
; This entry point is used by the routine at #R$E013.
; .
; Set the flag for a collision.
@label=SetCollisionFlag
*$E005 SET 0,(IX+$07) ; Set the flag for a collision.
 $E009 SCF            ; {Set the carry flag and return.
 $E00A RET            ; }

; Test Cell Moving Down
;
; Used by the routine at #R$DF34.
; .
; Tests an object that is moving down the screen (along the negative Y
; axis) against the walls in one cell, in the same way as #R$DFFA.
;
;   DE X position to test
;   HL Y position to test
;   IX Object
; O:F The carry flag is set if there was a collision
@label=TestCellMovingDown
c$E00B CALL $E0A0    ; Check whether the object hits a wall in the cell.
 $E00E RET NC        ; Return if it did not.
 $E00F NEG           ; {Make the depth positive, and jump to #R$DFFE to reduce
 $E011 JR $DFFE      ; the velocity.}

; Test Cell Moving Right
;
; Used by the routine at #R$DED3.
; .
; Tests an object that is moving to the right (along the positive X axis)
; against the walls in one cell. If the object hits a wall then its velocity
; along the X axis is reduced by twice the depth that it has gone into the wall,
; and the flag for a collision is set.
;
;   DE X position to test
;   HL Y position to test
;   IX Object
; O:F The carry flag is set if there was a collision
;
; Check the walls, then push the object back if it is touching one.
@label=TestCellMovingRight
c$E013 CALL $E063     ; Check whether the object hits a wall in the cell.
 $E016 RET NC         ; Return if it did not.
; This entry point is used by the routine at #R$E020.
; .
; Reduce the velocity along the X axis.
@label=ReduceVelocityX
*$E017 ADD A,A        ; Double the depth.
 $E018 ADD A,(IX+$0A) ; {Add it to the velocity along the X axis, which stops the object at
 $E01B LD (IX+$0A),A  ; the wall.}
 $E01E JR $E005       ; Jump to #R$E005 to set the flag for a collision.

; Test Cell Moving Left
;
; Used by the routine at #R$DF97.
; .
; Tests an object that is moving to the left (along the negative X axis)
; against the walls in one cell, in the same way as #R$E013.
;
;   DE X position to test
;   HL Y position to test
;   IX Object
; O:F The carry flag is set if there was a collision
@label=TestCellMovingLeft
c$E020 CALL $E063    ; Check whether the object hits a wall in the cell.
 $E023 RET NC        ; Return if it did not.
 $E024 NEG           ; {Make the depth positive, and jump to #R$E017 to reduce
 $E026 JR $E017      ; the velocity.}

; Find Position In Cell
;
; Used by the routines at #R$E063 and #R$E0A0.
; .
; Finds where an object is in a cell. The position in the cell is half the
; distance from the corner, plus #N$40. #R$E051 finds the tile of that cell.
;
;   D Column of the cell
;   H Row of the cell
;   IX Object
; O:E The position of the object along the X axis in the cell
; O:D The position of the object along the Y axis in the cell
; O:L The column of the cell
; O:H The row of the cell
;
; Keep the row and column, and find the corner of the cell.
@label=FindPositionInCell
c$E028 LD B,H        ; {Keep the row in #REGb and the column in #REGc.
 $E029 LD C,D        ; }
 $E02A PUSH BC       ; Stash the row and column on the stack.
 $E02B LD C,$00      ; {Clear the lowest byte of the column and of the row, to give the
 $E02D LD E,C        ; position of the corner of the cell.}
; Find the horizontal position of the object in the cell.
 $E02E LD L,(IX+$01) ; {Fetch the X position of the object.
 $E031 LD H,(IX+$02) ; }
 $E034 AND A         ; {Subtract the X position of the corner of the cell.
 $E035 SBC HL,DE     ; }
 $E037 SRL H         ; {Halve the distance.
 $E039 RR L          ; }
 $E03B LD A,L        ; {Add the offset, to give the position of the object along the X axis
 $E03C ADD A,$40     ; in the cell.
 $E03E LD E,A        ; }
; Find the vertical position of the object in the cell.
 $E03F LD L,(IX+$03) ; {Fetch the Y position of the object.
 $E042 LD H,(IX+$04) ; }
 $E045 AND A         ; {Subtract the Y position of the corner of the cell.
 $E046 SBC HL,BC     ; }
 $E048 SRL H         ; {Halve the distance.
 $E04A RR L          ; }
 $E04C LD A,L        ; {Add the offset, to give the position of the object along the Y axis
 $E04D ADD A,$40     ; in the cell.
 $E04F LD D,A        ; }
 $E050 POP HL        ; Get the column and the row back.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$CF67 }
; LIST#

; Find Map Tile
;
; Used by the routines at #R$BF48, #R$C5CE, #R$CDE8 and #R$D76C.
; .
; Finds the tile at a cell of the map, which is 32 cells wide and 32 cells
; high.
;
;   L Column of the cell
;   H Row of the cell
; O:A The tile (zero for no tile)
; O:F The zero flag is set if there is no tile
@label=FindMapTile
c$E051 LD A,L        ; {Save the column, and start with the row.
 $E052 LD L,H        ;
 $E053 LD H,$00      ; }
 $E055 ADD HL,HL     ; {Multiply the row by thirty-two.
 $E056 ADD HL,HL     ;
 $E057 ADD HL,HL     ;
 $E058 ADD HL,HL     ;
 $E059 ADD HL,HL     ; }
 $E05A OR L          ; {Add the column.
 $E05B LD L,A        ; }
 $E05C LD BC,$5E04   ; {Add the address of the map.
 $E05F ADD HL,BC     ; }
 $E060 LD A,(HL)     ; {Fetch the tile and return.
 $E061 AND A         ;
 $E062 RET           ; }

; Check Walls Vertical First
;
; Used by the routines at #R$E013 and #R$E020.
; .
; Tests an object against the walls in a cell, by testing it against each
; rectangle of the tile of the cell in turn, with the position along the Y axis
; first. The rectangles are four bytes each (the X and Y positions of the
; centre, then the half width and half depth), and a zero X position ends the
; list.
;
;   DE X position to test
;   HL Y position to test
;   IX Object
; O:A The depth into the wall along the X axis (negative)
; O:F The carry flag is set if there was a collision
;
; Find the cell and its rectangle list.
@label=CheckWallsVerticalFirst
c$E063 CALL $E028    ; Call #R$E028.
; Find the list of rectangles for the tile.
 $E066 LD BC,$6334   ; Point #REGbc at #R$6334.
 $E069 CALL $D589    ; Call #R$D589.
 $E06C PUSH HL       ; {Copy the rectangle list to #REGiy
 $E06D POP IY        ; (using the stack).}
; Test the next rectangle.
@label=CheckWallsVerticalFirst_Loop
*$E06F LD A,(IY+$00) ; {Return if this is the end of the
 $E072 AND A         ; list.
 $E073 RET Z         ; }
; Jump to #R$E07D if the object is not touching the rectangle.
 $E074 CALL $E0C4    ; Call #R$E0C4.
 $E077 JR NC,$E07D   ; Jump to #R$E07D if the object is not touching the
                     ; rectangle.
; Return if the object is touching the rectangle.
 $E079 CALL $E087    ; Call #R$E087.
 $E07C RET C         ; Return if the object is touching the rectangle.
; Move on to the next rectangle.
@label=CheckWallsVerticalFirst_Next
*$E07D INC IY        ; {Move on to the next rectangle.
 $E07F INC IY        ;
 $E081 INC IY        ;
 $E083 INC IY        ; }
 $E085 JR $E06F      ; Jump to #R$E06F.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$CFA1 }
; LIST#

; Check Overlap Along X
;
; Used by the routines at #R$E063 and #R$E0A0.
; .
; Checks whether an object overlaps a rectangle along the X axis, using
; the position that the velocity takes the object to.
;
;   E Position of the object along the X axis in the cell
;   IX Object
;   IY Rectangle
; O:A The depth that the object has gone into the rectangle (negative)
; O:F The carry flag is set if the object overlaps the rectangle
;
; Find the sum of the half widths.
@label=CheckOverlapAlongX
c$E087 LD A,(IX+$08)  ; {Work out the combined half widths of the object and
 $E08A SRL A          ; the rectangle.
 $E08C ADD A,(IY+$02) ;
 $E08F LD C,A         ; }
; Find the distance between the middles.
 $E090 LD A,(IX+$0A)  ; Fetch the velocity along x.
 $E093 SRA A          ; {Add half of it to the position, then find the distance from the
 $E095 ADD A,E        ; middle of the rectangle.
 $E096 SUB (IY+$00)   ; }
; Make the distance positive, then subtract the sum.
 $E099 JP P,$E09E     ; {Make the distance positive.
 $E09C NEG            ; }
; Subtract the combined half widths and return.
@label=CheckOverlapAlongX_Depth
*$E09E SUB C          ; Subtract the sum.
 $E09F RET            ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$CFC5 }
; LIST#

; Check Walls Horizontal First
;
; Used by the routines at #R$DFFA and #R$E00B.
; .
; Tests an object against the walls in a cell, in the same way as #R$E063
; but with the position along the X axis first.
;
;   DE X position to test
;   HL Y position to test
;   IX Object
; O:A The depth into the wall along the Y axis (negative)
; O:F The carry flag is set if there was a collision
;
; Find the cell and its rectangle list.
@label=CheckWallsHorizontalFirst
c$E0A0 CALL $E028    ; Call #R$E028.
; Find the list of rectangles for the tile.
 $E0A3 LD BC,$6334   ; Point #REGbc at #R$6334.
 $E0A6 CALL $D589    ; Call #R$D589.
 $E0A9 PUSH HL       ; {Copy the rectangle list to #REGiy
 $E0AA POP IY        ; (using the stack).}
; Test the next rectangle.
@label=CheckWallsHorizontalFirst_Loop
*$E0AC LD A,(IY+$00) ; {Return if this is the end of the
 $E0AF AND A         ; list.
 $E0B0 RET Z         ; }
 $E0B1 CALL $E087    ; Call #R$E087.
 $E0B4 JR NC,$E0BA   ; Jump to #R$E0BA if the object is
                     ; not touching the rectangle.
 $E0B6 CALL $E0C4    ; Call #R$E0C4.
 $E0B9 RET C         ; Return if the object is touching
                     ; the rectangle.
; Move on to the next rectangle.
@label=CheckWallsHorizontalFirst_Next
*$E0BA INC IY        ; {Move on to the next rectangle.
 $E0BC INC IY        ;
 $E0BE INC IY        ;
 $E0C0 INC IY        ; }
 $E0C2 JR $E0AC      ; Jump to #R$E0AC.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$CFDE }
; LIST#

; Check Overlap Along Y
;
; Used by the routines at #R$E063 and #R$E0A0.
; .
; Checks whether an object overlaps a rectangle along the Y axis, using
; the position that the velocity takes the object to.
;
;   D Position of the object along the Y axis in the cell
;   IX Object
;   IY Rectangle
; O:A The depth that the object has gone into the rectangle (negative)
; O:F The carry flag is set if the object overlaps the rectangle
;
; Find the sum of the half depths.
@label=CheckOverlapAlongY
c$E0C4 LD A,(IX+$09)  ; {Work out the combined half depths of the object and
 $E0C7 SRL A          ; the rectangle.
 $E0C9 ADD A,(IY+$03) ;
 $E0CC LD C,A         ; }
; Find the distance between the middles.
 $E0CD LD A,(IX+$0B)  ; Fetch the velocity along y.
 $E0D0 SRA A          ; {Add half of it to the position, then find the distance from the
 $E0D2 ADD A,D        ; middle of the rectangle.
 $E0D3 SUB (IY+$01)   ; }
; Make the distance positive, then subtract the sum.
 $E0D6 JP P,$E0DB     ; {Make the distance positive.
 $E0D9 NEG            ; }
@label=CheckOverlapAlongY_Depth
*$E0DB SUB C          ; Subtract the sum.
 $E0DC RET            ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$D002 }
; LIST#

; Negate HL
;
; Used by the routines at #R$C55F and #R$DD99.
; .
; Makes #REGhl negative.
;
;   HL The word
; O:HL The negative of the word
;
; Invert both bytes, then add one.
@label=NegateHL
c$E0DD LD A,L        ; {Invert the low byte.
 $E0DE CPL           ;
 $E0DF LD L,A        ; }
 $E0E0 LD A,H        ; {Invert the high byte.
 $E0E1 CPL           ;
 $E0E2 LD H,A        ; }
 $E0E3 INC HL        ; Add one.
 $E0E4 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$D01B }
; { #LUNARJETMAN$8947 }
; { #MARTIANOIDS$B4B1 }
; { #TRANZAM$6BF6 }
; LIST#

; Sign Extend A
;
; Used by the routine at #R$DD01.
; .
; Makes a signed number into a signed word.
;
;   A The number
; O:HL The word
;
; Put the number in the low byte. The high byte is zero, or #N$FF if the
; number is negative.
@label=SignExtendA
c$E0E5 LD L,A        ; Make the number the low byte.
 $E0E6 XOR A         ; Start with a high byte of zero.
 $E0E7 BIT 7,L       ; {Jump to #R$E0EC if the number is not negative.
 $E0E9 JR Z,$E0EC    ; }
 $E0EB CPL           ; Use #N$FF for the high byte if the number is negative.
@label=SignExtendA_Set
*$E0EC LD H,A        ; Set the high byte.
 $E0ED RET           ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$D023 }
; LIST#

; Multiply A By DE
;
; Used by the routine at #R$E353.
; .
; Multiplies #REGa by #REGde.
;
;   A The first number
;   DE The second number
; O:HL The product
;
; Clear the product and count the bits.
@label=MultiplyAByDE
c$E0EE LD HL,$0000   ; Set #REGhl to #N($0000,$04,$04).
 $E0F1 LD B,$08      ; Set #REGb to #N$08.
; Shift the product and add when the next bit is set.
@label=MultiplyAByDE_Loop
*$E0F3 ADD HL,HL     ; Double #REGhl.
 $E0F4 RLCA          ; {Jump to #R$E0F8 if the carry flag is not set.
 $E0F5 JR NC,$E0F8   ; }
 $E0F7 ADD HL,DE     ; Add #REGde to #REGhl.
@label=MultiplyAByDE_Next
*$E0F8 DJNZ $E0F3    ; Loop back until all the bits have been used.
 $E0FA RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CE0D }
; { #ATICATAC$9AAD }
; { #GUNFRIGHT$D03E }
; { #KNIGHTLORE$D4F9 }
; { #TRANZAM$6F2F }
; { #UNDERWURLDE$AC68 }
; LIST#

; Build Shift Tables
;
; Used by the routine at #R$BDFE.
; .
; Builds the tables that the sprite drawing routines use to shift graphics
; sideways, and the table that reverses the bits in a byte.
; .
; There are three pairs of 256-byte pages for shifting a byte by two, four and
; six pixels (the low byte of the shifted result is in the first page of each
; pair, counting down from #N($FF), and the high byte is in
; the second). #N$FA to #N$FF hold the shifts of the bytes as
; they are, and #N$F2 to #N$F7 hold the shifts of the bytes
; with their bits reversed. The page at #R$F900 holds the
; bytes with their bits reversed.
;
; .
;
; Build the tables for the bytes as they are.
@label=BuildShiftTables
c$E0FB LD L,$00      ; Start with the byte at #N$00.
; Start with the byte as a 16-bit number, and point #REGhl at the first
; page of the tables.
@label=BuildShiftTables_Normal
*$E0FD LD D,$00      ; {Make the word the byte.
 $E0FF LD E,L        ; }
 $E100 LD H,$FF      ; Start at page #N$FF.
 $E102 LD B,$03      ; Set a count of #N$03 pairs.
; Shift the word left by two bits and store it.
@label=BuildShiftTables_NormalLoop
*$E104 SLA E         ; {Shift the word left by two bits.
 $E106 RL D          ;
 $E108 SLA E         ;
 $E10A RL D          ; }
 $E10C LD (HL),E     ; {Store the pair in the next two pages.
 $E10D DEC H         ;
 $E10E LD (HL),D     ;
 $E10F DEC H         ; }
 $E110 DJNZ $E104    ; Jump to #R$E104 if there are any left.
; Move on to the next byte, and loop back until all 256 have been done.
 $E112 INC L         ; Move on to the next byte.
 $E113 JR NZ,$E0FD   ; Jump to #R$E0FD if there are any left.
; Build the tables for the bytes with their bits reversed.
 $E115 LD L,$00      ; Start with the byte at #N$00.
@label=BuildShiftTables_Reversed
*$E117 LD D,$00      ; Clear the high byte of the word.
 $E119 LD B,$08      ; {Set a count of #N$08 bits, and copy the byte into
 $E11B LD A,L        ; #REGa.}
; Turn the bits of the byte round.
@label=BuildShiftTables_Reverse
*$E11C RRCA          ; {Move the next bit into #REGc from the other end.
 $E11D RL C          ; }
 $E11F DJNZ $E11C    ; Jump to #R$E11C if there are any left.
; Start with the reversed byte as a 16-bit number, and point #REGhl at the
; first page of the reversed tables.
 $E121 LD E,C        ; Make the low byte the reversed byte.
 $E122 LD H,$F7      ; Start at page #N$F7.
 $E124 LD B,$03      ; Set a count of #N$03 pairs.
; Shift the word left by two bits and store it.
@label=BuildShiftTables_ReversedLoop
*$E126 SLA E         ; {Shift the word left by two bits.
 $E128 RL D          ;
 $E12A SLA E         ;
 $E12C RL D          ; }
 $E12E LD (HL),E     ; {Store the pair in the next two pages.
 $E12F DEC H         ;
 $E130 LD (HL),D     ;
 $E131 DEC H         ; }
 $E132 DJNZ $E126    ; Jump to #R$E126 if there are any left.
; Move on to the next byte, and loop back until all 256 have been done.
 $E134 INC L         ; Move on to the next byte.
 $E135 JR NZ,$E117   ; Jump to #R$E117 if there are any left.
; Build the table of reversed bytes.
 $E137 LD HL,$F900   ; Point #REGhl at #R$F900.
@label=BuildShiftTables_ReverseTable
*$E13A LD D,L        ; {Start with the byte, and count eight bits.
 $E13B LD B,$08      ; }
@label=BuildShiftTables_ReverseBits
*$E13D SRL D         ; {Move the lowest bit of the byte into the other end of
 $E13F RL E          ; #REGe.}
 $E141 DJNZ $E13D    ; Jump to #R$E13D if there are any left.
 $E143 LD (HL),E     ; Store the byte turned round.
 $E144 INC L         ; Move on to the next byte.
 $E145 JR NZ,$E13A   ; Jump to #R$E13A if there are any left.
 $E147 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$D4FD }
; LIST#

; Copy Pixels To Screen
;
; Used by the routine at #R$E200.
; .
; Copies the pixels of the screen buffer onto the screen, using the stack
; to copy two bytes at a time.
;
; .
;
; Keep the stack pointer, and point it at the playfield on the screen.
@label=CopyPixelsToScreen
c$E148 LD ($BBAE),SP ; Save the stack pointer.
 $E14C LD SP,$4FFD   ; Point the stack pointer at the end of the last row of the playing
                     ; area on the screen.
 $E14F LD B,$70      ; Set a count of #N$70 rows.
 $E151 LD HL,$E5DB   ; Point #REGhl at the end of the first row of the buffer.
; Copy a row from the buffer to the screen.
@label=CopyPixelsToScreen_Row
*$E154 LD D,(HL)     ; {Copy the last twenty bytes of the row from the buffer onto the
 $E155 DEC HL        ; screen, two at a time.
 $E156 LD E,(HL)     ;
 $E157 DEC HL        ;
 $E158 PUSH DE       ;
 $E159 LD D,(HL)     ;
 $E15A DEC HL        ;
 $E15B LD E,(HL)     ;
 $E15C DEC HL        ;
 $E15D PUSH DE       ;
 $E15E LD D,(HL)     ;
 $E15F DEC HL        ;
 $E160 LD E,(HL)     ;
 $E161 DEC HL        ;
 $E162 PUSH DE       ;
 $E163 LD D,(HL)     ;
 $E164 DEC HL        ;
 $E165 LD E,(HL)     ;
 $E166 DEC HL        ;
 $E167 PUSH DE       ;
 $E168 LD D,(HL)     ;
 $E169 DEC HL        ;
 $E16A LD E,(HL)     ;
 $E16B DEC HL        ;
 $E16C PUSH DE       ;
 $E16D LD D,(HL)     ;
 $E16E DEC HL        ;
 $E16F LD E,(HL)     ;
 $E170 DEC HL        ;
 $E171 PUSH DE       ;
 $E172 LD D,(HL)     ;
 $E173 DEC HL        ;
 $E174 LD E,(HL)     ;
 $E175 DEC HL        ;
 $E176 PUSH DE       ;
 $E177 LD D,(HL)     ;
 $E178 DEC HL        ;
 $E179 LD E,(HL)     ;
 $E17A DEC HL        ;
 $E17B PUSH DE       ;
 $E17C LD D,(HL)     ;
 $E17D DEC HL        ;
 $E17E LD E,(HL)     ;
 $E17F DEC HL        ;
 $E180 PUSH DE       ;
 $E181 LD D,(HL)     ;
 $E182 DEC HL        ;
 $E183 LD E,(HL)     ;
 $E184 DEC HL        ;
 $E185 PUSH DE       ; }
 $E186 LD D,(HL)     ; {Copy the first two bytes of the row onto the screen.
 $E187 DEC HL        ;
 $E188 LD E,(HL)     ;
 $E189 PUSH DE       ; }
 $E18A EX DE,HL      ; Keep the address in the buffer in #REGde.
; Move up one pixel line on the screen.
 $E18B LD HL,$FF16   ; {Work out the address on the screen of the end of the row above,
 $E18E ADD HL,SP     ; which is one pixel row up.}
; Jump to #R$E1A1 unless that is the last pixel row of a character row.
 $E18F LD A,H        ; {Test whether it has crossed into the previous character
 $E190 CPL           ; row.}
 $E191 AND %00000111 ; Keep the bits for the pixel line.
 $E193 JP NZ,$E1A1   ; Jump to #R$E1A1 if it has not.
; Move to the previous character row.
 $E196 LD A,L        ; {Subtract #N$20 from the low byte.
 $E197 SUB $20       ;
 $E199 LD L,A        ; }
 $E19A JP C,$E1A1    ; Jump to #R$E1A1 if that is in the previous third.
 $E19D LD A,H        ; {Move up to the last pixel row of the character row.
 $E19E ADD A,$08     ;
 $E1A0 LD H,A        ; }
; Point at the next row.
@label=CopyPixelsToScreen_Next
*$E1A1 LD SP,HL      ; Point the stack pointer at the row on the screen.
 $E1A2 LD HL,$002D   ; {Move on to the end of the next row of the buffer.
 $E1A5 ADD HL,DE     ; }
 $E1A6 DJNZ $E154    ; Loop back until all of the rows have been copied.
; Restore the stack pointer.
 $E1A8 LD SP,($BBAE) ; Get the stack pointer back.
 $E1AC RET           ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$D04B }
; LIST#
; .
; The buffer holds 112 rows of 24 bytes, and the top row of the buffer is the
; bottom row of the playing area, so the rows of the buffer are copied from the
; bottom of the screen upwards. Only the 22 bytes of each row that are inside
; the border are copied, which are bytes 2 to 23 of the row.

; Copy Attributes To Screen
;
; Used by the routine at #R$E200.
; .
; Copies the attributes of the attribute buffer onto the screen, in the
; same way as #R$E148. The buffer holds 14 rows of 24 bytes, and the top row of
; the buffer is the bottom row of the playing area.
;
; .
;
; Point the stack at the last row of attributes.
@label=CopyAttributesToScreen
c$E1AD LD ($BBAE),SP ; {Save the stack pointer, point it at the end of the last row of
 $E1B1 LD SP,$59FD   ; attributes of the playing area, count 14 rows, and point #REGhl at the end of
 $E1B4 LD B,$0E      ; the first row of the buffer.
 $E1B6 LD HL,$F05B   ; }
; Copy a row and step up the screen.
@label=CopyAttributesToScreen_Row
*$E1B9 LD D,(HL)     ; {Copy the last twenty bytes of the row from the buffer onto the
 $E1BA DEC HL        ; screen, two at a time.
 $E1BB LD E,(HL)     ;
 $E1BC DEC HL        ;
 $E1BD PUSH DE       ;
 $E1BE LD D,(HL)     ;
 $E1BF DEC HL        ;
 $E1C0 LD E,(HL)     ;
 $E1C1 DEC HL        ;
 $E1C2 PUSH DE       ;
 $E1C3 LD D,(HL)     ;
 $E1C4 DEC HL        ;
 $E1C5 LD E,(HL)     ;
 $E1C6 DEC HL        ;
 $E1C7 PUSH DE       ;
 $E1C8 LD D,(HL)     ;
 $E1C9 DEC HL        ;
 $E1CA LD E,(HL)     ;
 $E1CB DEC HL        ;
 $E1CC PUSH DE       ;
 $E1CD LD D,(HL)     ;
 $E1CE DEC HL        ;
 $E1CF LD E,(HL)     ;
 $E1D0 DEC HL        ;
 $E1D1 PUSH DE       ;
 $E1D2 LD D,(HL)     ;
 $E1D3 DEC HL        ;
 $E1D4 LD E,(HL)     ;
 $E1D5 DEC HL        ;
 $E1D6 PUSH DE       ;
 $E1D7 LD D,(HL)     ;
 $E1D8 DEC HL        ;
 $E1D9 LD E,(HL)     ;
 $E1DA DEC HL        ;
 $E1DB PUSH DE       ;
 $E1DC LD D,(HL)     ;
 $E1DD DEC HL        ;
 $E1DE LD E,(HL)     ;
 $E1DF DEC HL        ;
 $E1E0 PUSH DE       ;
 $E1E1 LD D,(HL)     ;
 $E1E2 DEC HL        ;
 $E1E3 LD E,(HL)     ;
 $E1E4 DEC HL        ;
 $E1E5 PUSH DE       ;
 $E1E6 LD D,(HL)     ;
 $E1E7 DEC HL        ;
 $E1E8 LD E,(HL)     ;
 $E1E9 DEC HL        ;
 $E1EA PUSH DE       ; }
 $E1EB LD D,(HL)     ; {Copy the first two bytes of the row onto the screen.
 $E1EC DEC HL        ;
 $E1ED LD E,(HL)     ;
 $E1EE PUSH DE       ; }
 $E1EF EX DE,HL      ; Keep the buffer address in #REGde.
 $E1F0 LD HL,$FFF6   ; {Move up one row of attributes on the screen.
 $E1F3 ADD HL,SP     ;
 $E1F4 LD SP,HL      ; }
 $E1F5 LD HL,$002D   ; {Move on to the end of the next row of the buffer.
 $E1F8 ADD HL,DE     ; }
 $E1F9 DJNZ $E1B9    ; Loop back until all of the rows have been copied.
 $E1FB LD SP,($BBAE) ; {Get the stack pointer back and return.
 $E1FF RET           ; }

; Copy Buffers To Screen
;
; Used by the routine at #R$BDFE.
; .
; Copies the pixels and the attributes of the screen buffer onto the
; screen, and then clears the buffer.
; .
; #PUSHS #UDGTABLE { =h Before | =h After #R$E200 }
; { #SIM(start=$BE04,stop=$BE18,sp=$5E00,r=$80,clear=1)
; #SIM(start=$BE18,stop=$BE24)
; #SIM(start=$BE2D,stop=$BE71)
; #SIM(start=$CF08,stop=$0000,sp=$5BF0)
; #SCR$02,$05,$00,$1A,$12(copy-buffers-before)
; | #SIM(start=$E200,stop=$0000,sp=$5BF0)
; #SCR$02,$05,$00,$1A,$12(copy-buffers-after) } UDGTABLE# #POPS
@label=CopyBuffersToScreen
c$E200 CALL $E148    ; Copy the pixels to the screen.
 $E203 CALL $E1AD    ; Copy the attributes to the screen.
; This entry point is used by the routines at #R$BDFE, #R$C8CA and #R$CC56.
; .
; Clear the screen buffer.
@label=ClearScreenBuffer
*$E206 LD HL,$F194   ; Point #REGhl at the end of the attribute buffer.
 $E209 LD A,($BBFB)  ; {Make the attribute from white ink and the colour in #R$BBFB, which
 $E20C OR $47        ; is used for the paper.
 $E20E LD E,A        ;
 $E20F LD D,A        ; }
 $E210 LD B,$0E      ; {Fill the 14 rows of the attribute buffer with it.
 $E212 CALL $E21D    ; }
 $E215 LD HL,$F044   ; {Clear the 112 rows of the pixel buffer.
 $E218 LD DE,$0000   ;
 $E21B LD B,$70      ; }

; Fill Buffer
;
; Used by the routine at #R$E200.
; .
; Fills a buffer with a word, by pushing it onto the stack. The buffer is
; filled downwards from the address in #REGhl.
;
;   B Number of rows of 24 bytes
;   DE Word to fill the buffer with
;   HL Address after the end of the buffer
; O:HL Address of the start of the buffer
;
; Keep the stack pointer, and point it at the end of the buffer.
@label=FillBuffer
c$E21D LD ($BBAE),SP ; Save the stack pointer.
 $E221 LD SP,HL      ; Point the stack pointer at the end of the buffer.
; Fill a row.
@label=FillBuffer_Row
*$E222 PUSH DE       ; {Fill a row of 24 bytes by pushing twelve words onto the
 $E223 PUSH DE       ; stack.
 $E224 PUSH DE       ;
 $E225 PUSH DE       ;
 $E226 PUSH DE       ;
 $E227 PUSH DE       ;
 $E228 PUSH DE       ;
 $E229 PUSH DE       ;
 $E22A PUSH DE       ;
 $E22B PUSH DE       ;
 $E22C PUSH DE       ;
 $E22D PUSH DE       ; }
 $E22E DJNZ $E222    ; Loop back until all of the rows have been filled.
; Keep the start of the buffer, and restore the stack pointer.
 $E230 LD HL,$0000   ; {Fetch the address of the start of the buffer.
 $E233 ADD HL,SP     ; }
 $E234 LD SP,($BBAE) ; Get the stack pointer back.
 $E238 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$D0B7 }
; LIST#

; Read Keyboard Port
;
; Used by the routines at #R$C63D, #R$C8CA, #R$E250, #R$E2AE, #R$E2DA, #R$E31C
; and #R$E32C.
; .
; Reads some rows of the keyboard. The row selector is also written to
; port #N$FD (with the selector as the high byte of the address), which does
; nothing on a 48K Spectrum and is not part of any sound; the keyboard is read
; with the same selector straight afterwards.
;
;   A Row selector (a bit which is reset selects the row)
; O:A Keys pressed, in bits 0 to 4 (a bit is set when a key is pressed)
; O:F Zero flag set if no key is pressed
;
; Write the selector, then read the keys.
@label=ReadKeyboardPort
c$E239 OUT ($FD),A   ; Write the half-row selector to port #N$FD. The ULA only responds to
                     ; even port numbers, so this has no effect on the 48K Spectrum, but it leaves
                     ; the selector in #REGa for the next instruction.
 $E23B IN A,($FE)    ; Read the rows of the keyboard.
; Make the pressed keys into set bits, and return.
 $E23D CPL           ; Invert the bits, so that a bit is set for a key which is
                     ; pressed.
 $E23E AND %00011111 ; Keep only bits 0 to 4.
 $E240 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B759 }
; { #CYBERUN$9BC3 }
; { #GUNFRIGHT$D0DB }
; { #KNIGHTLORE$B5F7 }
; { #PENTAGRAM$B952 }
; LIST#

; Read Controls
;
; Used by the routine at #R$DA7A.
; .
; Reads the controls using the method in bits 1 and 2 of #R$BBB0, and
; keeps them in #R$BC01. The methods are the keyboard, a Kempston joystick, a
; Cursor joystick and a Sinclair joystick.
; #TABLE(default,centre,centre)
; { =h Bit | =h Meaning }
; { #N$00 | Left }
; { #N$01 | Right }
; { #N$02 | Forward }
; { #N$03 | Fire }
; { #N$04 | Down }
; { #N$05 | Turning the view }
; TABLE#
;
; O:C Controls
;
; Fetch the control method from #R$BBB0.
@label=ReadControls
c$E241 LD A,($BBB0)  ; Fetch #R$BBB0.
 $E244 RRCA          ; Move the type of controls into the low bits.
 $E245 AND %00000011 ; Keep the two bits.
 $E247 JP Z,$E2DA    ; Jump to #R$E2DA to read the keyboard if it is the
                     ; keyboard.
 $E24A DEC A         ; {Jump to #R$E289 if it is a Kempston joystick.
 $E24B JR Z,$E289    ; }
 $E24D DEC A         ; {Jump to #R$E2AE if it is a Cursor joystick.
 $E24E JR Z,$E2AE    ; }
; Continue on to #R$E250.
; .
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C8FF }
; { #GUNFRIGHT$D0E3 }
; { #KNIGHTLORE$D022 }
; LIST#

; Read Interface 2 Joystick
;
; Reads the controls from the Interface 2 joysticks, which are the keys 1
; to 5 for the first joystick and 6 to 0 for the second joystick. The joysticks
; use the keys left, right, down, up and fire in that order, so the keys of the
; first joystick are reversed to put them in the same order as the keys of the
; second joystick.
;
; O:C The controls
;
; Reverse the keys 1 to 5.
@label=ReadInterface2Joystick
c$E250 LD A,$F7      ; {Read from the keyboard;
 $E252 CALL $E239    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$F7 | 1 | 2 | 3 | 4 | 5 }
                     ; TABLE#}
; Save the registers, and count five keys.
 $E255 PUSH BC       ; Stash #REGbc on the stack.
 $E256 LD B,$05      ; Set #REGb to #N$05.
@label=ReadInterface2Joystick_Reverse
*$E258 RRA           ; Rotate #REGa right.
 $E259 RL C          ; Rotate #REGc left.
 $E25B DJNZ $E258    ; Jump to #R$E258 until #REGb is zero.
; Get the registers back, and keep the reversed keys.
 $E25D LD A,C        ; Copy #REGc to #REGa.
 $E25E POP BC        ; Restore #REGbc from the stack.
 $E25F LD C,A        ; Copy it to #REGc.
; Merge the keys 6 to 0.
 $E260 LD A,$EF      ; {Read from the keyboard;
 $E262 CALL $E239    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$EF | 0 | 9 | 8 | 7 | 6 }
                     ; TABLE#}
 $E265 OR C          ; Combine them with the keys 1 to 5, so that the joysticks are the
                     ; same.
; Set the controls from the keys.
 $E266 LD C,$00      ; Start with none of the controls.
 $E268 BIT 0,A       ; {Set the control for fire if the key for fire is
 $E26A JR Z,$E26E    ; pressed.
 $E26C SET 3,C       ; }
@label=ReadInterface2Joystick_Forward
*$E26E BIT 1,A       ; {Set the control for forward if the key for up is
 $E270 JR Z,$E274    ; pressed.
 $E272 SET 2,C       ; }
@label=ReadInterface2Joystick_Down
*$E274 BIT 2,A       ; {Set the control for down if the key for down is
 $E276 JR Z,$E27A    ; pressed.
 $E278 SET 4,C       ; }
@label=ReadInterface2Joystick_Right
*$E27A BIT 3,A       ; {Set the control for right if the key for right is
 $E27C JR Z,$E280    ; pressed.
 $E27E SET 1,C       ; }
@label=ReadInterface2Joystick_Left
*$E280 BIT 4,A       ; {Set the control for left if the key for left is
 $E282 JR Z,$E286    ; pressed.
 $E284 SET 0,C       ; }
@label=ReadInterface2Joystick_ViewKey
*$E286 JP $E31C      ; Jump to #R$E31C to read the key for turning the view.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C91B }
; { #GUNFRIGHT$D0F2 }
; { #KNIGHTLORE$D03E }
; LIST#

; Read Kempston Joystick
;
; Used by the routine at #R$E241.
; .
; Reads the controls from a Kempston joystick.
@label=ReadKempstonJoystick
c$E289 IN A,($1F)    ; {Read the joystick, and start with none of the controls.
 $E28B LD C,$00      ; }
 $E28D BIT 0,A       ; {Set the control for right if the joystick is pushed
 $E28F JR Z,$E293    ; right.
 $E291 SET 1,C       ; }
@label=ReadKempstonJoystick_Left
*$E293 BIT 1,A       ; {Set the control for left if the joystick is pushed
 $E295 JR Z,$E299    ; left.
 $E297 SET 0,C       ; }
@label=ReadKempstonJoystick_Down
*$E299 BIT 2,A       ; {Set the control for down if the joystick is pushed
 $E29B JR Z,$E29F    ; down.
 $E29D SET 4,C       ; }
@label=ReadKempstonJoystick_Forward
*$E29F BIT 3,A       ; {Set the control for forward if the joystick is pushed
 $E2A1 JR Z,$E2A5    ; up.
 $E2A3 SET 2,C       ; }
@label=ReadKempstonJoystick_Fire
*$E2A5 BIT 4,A       ; {Set the control for fire if the fire button is pressed.
 $E2A7 JR Z,$E2AB    ;
 $E2A9 SET 3,C       ; }
@label=ReadKempstonJoystick_ViewKey
*$E2AB JP $E31C      ; Jump to #R$E31C to read the key for turning the view.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C954 }
; { #GUNFRIGHT$D12B }
; { #KNIGHTLORE$D077 }
; LIST#

; Read Cursor Joystick
;
; Used by the routine at #R$E241.
; .
; Reads the controls from a cursor joystick, which uses the keys 5 for
; left, 8 for right, 7 for up, 6 for down and 0 for fire.
;
; O:C The controls
;
; Left from the 1-5 row.
@label=ReadCursorJoystick
c$E2AE LD C,$00      ; Start with none of the controls.
 $E2B0 LD A,$F7      ; {Read from the keyboard;
 $E2B2 CALL $E239    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$F7 | 1 | 2 | 3 | 4 | 5 }
                     ; TABLE#}
 $E2B5 BIT 4,A       ; {Set the control for left if the key 5 is pressed.
 $E2B7 JR Z,$E2BB    ;
 $E2B9 SET 0,C       ; }
; Fire, up, right and down from the 0-9 row.
@label=ReadCursorJoystick_SecondRow
*$E2BB LD A,$EF      ; {Read from the keyboard;
 $E2BD CALL $E239    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$EF | 0 | 9 | 8 | 7 | 6 }
                     ; TABLE#}
 $E2C0 BIT 0,A       ; {Set the control for fire if the key 0 is pressed.
 $E2C2 JR Z,$E2C6    ;
 $E2C4 SET 3,C       ; }
@label=ReadCursorJoystick_Forward
*$E2C6 BIT 3,A       ; {Set the control for forward if the key 7 is pressed.
 $E2C8 JR Z,$E2CC    ;
 $E2CA SET 2,C       ; }
@label=ReadCursorJoystick_Right
*$E2CC BIT 2,A       ; {Set the control for right if the key 8 is pressed.
 $E2CE JR Z,$E2D2    ;
 $E2D0 SET 1,C       ; }
; Set the control for down if the key 6 is pressed, and jump to #R$E31C to
; read the key for turning the view.
@label=ReadCursorJoystick_Down
*$E2D2 BIT 4,A       ; {Jump to #R$E31C if bit 4 of #REGa is clear.
 $E2D4 JR Z,$E31C    ; }
 $E2D6 SET 4,C       ; Set bit 4 of #REGc.
 $E2D8 JR $E31C      ; Jump to #R$E31C.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$C979 }
; { #GUNFRIGHT$D150 }
; { #KNIGHTLORE$D09C }
; LIST#

; Read Keyboard
;
; Used by the routine at #R$E241.
; .
; Reads the controls from the keyboard. Left is X, V, M or B, right is C
; or N, forward is any key from A to G or from H to ENTER, fire is any key from
; Q to T or from Y to P, and down is any key from 1 to 5 or from 6 to 0.
;
; .
;
; Read left and right from CAPS SHIFT to V.
@label=ReadKeyboard
c$E2DA LD A,$FE      ; {Read from the keyboard;
 $E2DC CALL $E239    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$FE | CAPS SHIFT | Z | X | C | V }
                     ; TABLE#}
 $E2DF RRCA          ; {Move the keys X and C into bits 0 and 1, for left and
 $E2E0 RRCA          ; right.}
 $E2E1 BIT 2,A       ; {Set the control for left as well if the key V is
 $E2E3 JR Z,$E2E7    ; pressed.
 $E2E5 SET 0,A       ; }
; Keep left and right, and read SPACE to B.
@label=ReadKeyboard_Right
*$E2E7 AND %00000011 ; Keep bits 0 and 1.
 $E2E9 LD C,A        ; Put them in #REGc.
 $E2EA LD A,$7F      ; {Read from the keyboard;
 $E2EC CALL $E239    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$7F | SPACE | SYMBOL SHIFT | M | N | B }
                     ; TABLE#}
 $E2EF BIT 2,A       ; {Set the control for left if the key M is pressed.
 $E2F1 JR Z,$E2F5    ;
 $E2F3 SET 0,C       ; }
; Set the control for right if N is pressed.
@label=ReadKeyboard_KeyN
*$E2F5 BIT 3,A       ; {Set the control for right if the key N is pressed.
 $E2F7 JR Z,$E2FB    ;
 $E2F9 SET 1,C       ; }
; Set the control for left if B is pressed.
@label=ReadKeyboard_KeyB
*$E2FB BIT 4,A       ; {Set the control for left if the key B is pressed.
 $E2FD JR Z,$E301    ;
 $E2FF SET 0,C       ; }
; Set the control for forward if any key from A to G or H to ENTER is
; pressed.
@label=ReadKeyboard_Forward
*$E301 LD A,$BD      ; {Read from the keyboard;
 $E303 CALL $E239    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$BD | A / ENTER | S / L | D / K | F / J | G / H }
                     ; TABLE#}
 $E306 JR Z,$E30A    ; {Set the control for forward if any of them are pressed.
 $E308 SET 2,C       ; }
; Set the control for fire if any key from Q to T or Y to P is pressed.
@label=ReadKeyboard_Fire
*$E30A LD A,$DB      ; {Read from the keyboard;
 $E30C CALL $E239    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$DB | Q / P | W / O | E / I | R / U | T / Y }
                     ; TABLE#}
 $E30F JR Z,$E313    ; {Set the control for fire if any of them are pressed.
 $E311 SET 3,C       ; }
; Set the control for down if any key from 1 to 5 or 6 to 0 is pressed.
@label=ReadKeyboard_Down
*$E313 LD A,$E7      ; {Read from the keyboard;
 $E315 CALL $E239    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$E7 | 1 / 0 | 2 / 9 | 3 / 8 | 4 / 7 | 5 / 6 }
                     ; TABLE#}
 $E318 JR Z,$E31C    ; {Set the control for down if any of them are pressed.
 $E31A SET 4,C       ; }

; Read View Key
;
; Used by the routines at #R$E250, #R$E289, #R$E2AE and #R$E2DA.
; .
; Reads the key for turning the view (Z or SYMBOL SHIFT), and keeps the
; controls in #R$BC01.
;
; C Controls
;
; Read the key which turns the view.
@label=ReadViewKey
c$E31C LD A,$7E      ; {Read from the keyboard;
 $E31E CALL $E239    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$7E | SHIFT / SPACE | Z / SYM | X / M | C / N | V / B }
                     ; TABLE#}
 $E321 BIT 1,A       ; {Set the control for turning the view if the key Z or SYMBOL SHIFT is
 $E323 JR Z,$E327    ; pressed.
 $E325 SET 5,C       ; }
@label=ReadViewKey_Store
*$E327 LD A,C        ; {Store the controls and return.
 $E328 LD ($BC01),A  ;
 $E32B RET           ; }

; Pause Game
;
; Used by the routine at #R$BDFE.
; .
; Pauses the game if CAPS SHIFT or SPACE is pressed on its own. The game
; continues when the key has been pressed again.
;
; .
;
; Return unless CAPS SHIFT or SPACE is pressed on its own.
@label=PauseGame
c$E32C LD A,$7E      ; {Read from the keyboard;
 $E32E CALL $E239    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$7E | SHIFT / SPACE | Z / SYM | X / M | C / N | V / B }
                     ; TABLE#}
 $E331 BIT 0,A       ; {Return if neither of the keys CAPS SHIFT or SPACE is
 $E333 RET Z         ; pressed.}
; Return if any of the other keys is pressed too.
 $E334 AND %00011110 ; Keep bits 1 to 4.
 $E336 RET NZ        ; Return if any of them is set.
; Wait for the key to be let go of, then pressed and let go of again.
@label=PauseGame_Release
*$E337 LD A,$7E      ; {Read the keys.
 $E339 CALL $E239    ; }
 $E33C BIT 0,A       ; {Jump to #R$E337 if bit 0 is set.
 $E33E JR NZ,$E337   ; }
; Wait for a key to be pressed.
@label=PauseGame_Press
*$E340 LD A,$7E      ; {Read the keys.
 $E342 CALL $E239    ; }
 $E345 BIT 0,A       ; {Jump to #R$E340 if bit 0 is not set.
 $E347 JR Z,$E340    ; }
; Wait for the key to be released.
@label=PauseGame_ReleaseAgain
*$E349 LD A,$7E      ; {Read the keys.
 $E34B CALL $E239    ; }
 $E34E BIT 0,A       ; {Jump to #R$E349 if bit 0 is set.
 $E350 JR NZ,$E349   ; }
 $E352 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CE22 }
; { #GUNFRIGHT$D206 }
; { #KNIGHTLORE$D50E }
; LIST#

; Flip Sprite
;
; Used by the routine at #R$E3FF.
; .
; Turns a sprite upside down or round (or back again) when the flags of an
; object say that it should be the other way up or round from how it was last
; time. The sprite is changed in place, with bits 7 (upside down) and 6
; (reversed) of its first byte showing how it is.
; .
; A sprite is made of a byte for the width in characters (bits 0 to 3) and the
; flags, a byte for the number of rows, and then the rows, with the bottom row
; first. Each row has a pair of bytes for each character: the mask and then the
; pixels.
;
;   IX Object
; O:DE Address of the sprite
@label=FlipSprite
c$E353 LD A,(IX+$00) ; Fetch the type of the object.
 $E356 LD BC,$6E9E   ; {Find the address of the sprite in the table of sprites.
 $E359 CALL $D589    ; }
 $E35C EX DE,HL      ; {Move the address of the sprite into #REGde and keep it.
 $E35D PUSH DE       ; }
 $E35E LD A,(DE)     ; {Jump to #R$E39A if the sprite is already the right way
 $E35F XOR (IX+$07)  ; up.
 $E362 AND $80       ;
 $E364 JR Z,$E39A    ; }
; Turn the sprite upside down, by swapping the rows.
 $E366 LD A,(DE)     ; {Flip the flag for being upside down.
 $E367 XOR $80       ;
 $E369 LD (DE),A     ; }
 $E36A RLCA          ; {Work out the number of bytes in a row (two for each
 $E36B AND $1E       ; character).
 $E36D LD B,A        ; }
 $E36E INC DE        ; {Fetch the number of rows of the sprite.
 $E36F LD A,(DE)     ;
 $E370 LD C,A        ; }
 $E371 INC DE        ; {Point at the first row, and keep the address.
 $E372 PUSH DE       ; }
 $E373 LD E,B        ; {Set the number of bytes in a row.
 $E374 LD D,$00      ; }
 $E376 CALL $E0EE    ; Work out the number of bytes in the sprite.
 $E379 POP DE        ; {Work out the address of the end of the sprite, and move it into
 $E37A ADD HL,DE     ; #REGde.
 $E37B EX DE,HL      ; }
 $E37C LD A,B        ; {Point #REGhl at the start of the second row.
 $E37D CALL $E596    ; }
 $E380 DEC DE        ; {Point #REGhl at the end of the first row, and #REGde at the end of
 $E381 DEC HL        ; the last row.}
 $E382 SRL C         ; Work out the number of pairs of rows to swap.
@label=FlipSprite_Rows
*$E384 PUSH BC       ; Keep the number of bytes in a row and the number of
                     ; rows.
@label=FlipSprite_Bytes
*$E385 LD A,(DE)     ; {Swap the bytes of the two rows, from the end backwards, until the
 $E386 LD C,(HL)     ; whole of both rows has been swapped.
 $E387 LD (HL),A     ;
 $E388 LD A,C        ;
 $E389 LD (DE),A     ;
 $E38A DEC HL        ;
 $E38B DEC DE        ;
 $E38C DJNZ $E385    ; }
 $E38E POP BC        ; Get the number of bytes in a row and the number of rows
                     ; back.
 $E38F LD A,B        ; {Move #REGhl on to the end of the next row down.
 $E390 CALL $E596    ;
 $E393 LD A,B        ;
 $E394 CALL $E596    ; }
 $E397 DEC C         ; {Loop back until all of the pairs of rows have been
 $E398 JR NZ,$E384   ; swapped.}
; Turn the sprite round, by reversing the rows.
@label=FlipSprite_Reverse
*$E39A POP DE        ; {Fetch the address of the sprite.
 $E39B PUSH DE       ; }
 $E39C LD A,(DE)     ; {Jump to #R$E3D4 if the sprite is already the right way
 $E39D XOR (IX+$07)  ; round.
 $E3A0 AND $40       ;
 $E3A2 JR Z,$E3D4    ; }
; This entry point is used by the routine at #R$E3D6.
@label=FlipSprite_Mirror
*$E3A4 LD A,(DE)     ; {Flip the flag for being reversed.
 $E3A5 XOR $40       ;
 $E3A7 LD (DE),A     ; }
 $E3A8 AND $0F       ; {Fetch the width of the sprite in characters.
 $E3AA LD B,A        ;
 $E3AB LD C,A        ; }
 $E3AC INC DE        ; {Fetch the number of rows of the sprite, and keep it.
 $E3AD LD A,(DE)     ;
 $E3AE EX AF,AF'     ; }
 $E3AF INC DE        ; {Start with the first row.
 $E3B0 EX DE,HL      ; }
 $E3B1 PUSH HL       ; {Point #REGhl' at the first row, and #REGb' at
 $E3B2 EXX           ; the table for reversing bits.
 $E3B3 POP HL        ;
 $E3B4 LD B,$F9      ;
 $E3B6 EXX           ; }
@label=FlipSprite_Row
*$E3B7 EXX           ; {Reverse the bits of the mask of a character, using the
 $E3B8 LD C,(HL)     ; table.
 $E3B9 LD A,(BC)     ;
 $E3BA LD E,A        ; }
 $E3BB INC HL        ; {Reverse the bits of the pixels of the character.
 $E3BC LD C,(HL)     ;
 $E3BD LD A,(BC)     ;
 $E3BE LD D,A        ; }
 $E3BF INC HL        ; {Keep them on the stack, and loop back until the row has
 $E3C0 PUSH DE       ; been done.
 $E3C1 EXX           ;
 $E3C2 DJNZ $E3B7    ; }
 $E3C4 LD B,C        ; Count the characters again.
@label=FlipSprite_Store
*$E3C5 POP DE        ; {Put the characters back in the row, in the reverse
 $E3C6 LD (HL),E     ; order.
 $E3C7 INC HL        ;
 $E3C8 LD (HL),D     ;
 $E3C9 INC HL        ;
 $E3CA DJNZ $E3C5    ; }
 $E3CC EX AF,AF'     ; {Jump to #R$E3D4 when all the rows have been done.
 $E3CD DEC A         ;
 $E3CE JR Z,$E3D4    ; }
 $E3D0 EX AF,AF'     ; {Count the characters again, and loop back to do the
 $E3D1 LD B,C        ; next row.
 $E3D2 JR $E3B7      ; }
@label=FlipSprite_Done
*$E3D4 POP DE        ; {Get the address of the sprite back, and return.
 $E3D5 RET           ; }
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$D174 }
; { #KNIGHTLORE$D865 }
; LIST#

; Mirror Sprite
;
; Used by the routine at #R$C1FD.
; .
; Turns a sprite round, and flips the flag in the sprite that shows
; whether it is reversed.
;
; DE Address of the sprite
@label=MirrorSprite
c$E3D6 PUSH DE       ; {Keep the address of the sprite, and jump to #R$E3A4 to
 $E3D7 JR $E3A4      ; reverse it.}

; Draw Object
;
; Used by the routine at #R$CFF2.
; .
; Draws an object, if it is on the screen. The position of the object is
; worked out from its position in the world and the offsets of its sprite, and
; kept in the object.
; .
; #PUSHS #UDGTABLE { =h After #R$E3D9 }
; { #SIM(start=$BE04,stop=$BE18,sp=$5E00,r=$80,clear=1)
; #SIM(start=$BE18,stop=$BE24)
; #SIM(start=$BE2D,stop=$BE71)
; #POKES$BC02,$70
; #SIM(start=$E3D9,stop=$0000,ix=$BC9E,sp=$5BF0)
; #SIM(start=$E3D9,stop=$0000,ix=$BC8E,sp=$5BF0)
; #SIM(start=$E200,stop=$0000,sp=$5BF0)
; #SCR$02,$05,$00,$1A,$12(draw-object) } UDGTABLE# #POPS
;
; IX Object
;
; Clip the X position of the sprite.
@label=DrawObject
c$E3D9 CALL $D4F3     ; Work out the position of the object on the screen.
 $E3DC LD HL,($BBB6)  ; {Return if the position along the X axis is outside the
 $E3DF LD A,H         ; screen.
 $E3E0 AND A          ;
 $E3E1 RET NZ         ; }
 $E3E2 LD A,L         ; {Add the offset of the sprite along the X axis, and return if that is
 $E3E3 ADD A,(IX+$0C) ; past the right edge of the window.
 $E3E6 CP $CB         ;
 $E3E8 RET NC         ; }
 $E3E9 CP $10         ; {Return if it is past the left edge, and set the X position of the
 $E3EB RET C          ; sprite.
 $E3EC LD (IX+$0E),A  ; }
; Clip the Y position of the sprite.
 $E3EF LD HL,($BBB8)  ; {Return if the position along the Y axis is outside the
 $E3F2 LD A,H         ; screen.
 $E3F3 AND A          ;
 $E3F4 RET NZ         ; }
 $E3F5 LD A,L         ; {Add the offset of the sprite along the Y axis, and return if that is
 $E3F6 ADD A,(IX+$0D) ; past the top edge of the window.
 $E3F9 CP $B8         ;
 $E3FB RET NC         ; }
 $E3FC LD (IX+$0F),A  ; Set the Y position of the sprite.

; Draw Sprite
;
; Used by the routine at #R$CD10.
; .
; Draws the sprite of an object in the screen buffer, with its mask. The
; sprite is clipped at the top and bottom of the window by its position. A
; sprite is drawn by popping its bytes off the stack, so the code that does the
; drawing changes itself to fit the sprite.
; .
; Only the rows of a player sprite that the timer at #R$BC02 allows are drawn,
; so the player appears from the bottom to the top while materialising.
; .
; The bottom of the buffer is the top of the window, and the rows of a sprite
; are stored from the bottom upwards, so a sprite starts at its Y position and
; is drawn towards the top of the screen.
;
; IX Object
@label=DrawSprite
c$E3FF CALL $E353      ; Turn the sprite round or upside down, if it needs it.
 $E402 LD A,(IX+$0E)   ; {Work out the position of the sprite in a character, in pixels
 $E405 AND $06         ; (#N($00), #N($02), #N$04 or #N$06).}
 $E407 JP Z,$E48E      ; Jump to #R$E48E if the sprite is on a character
                       ; boundary.
 $E40A OR $F8          ; {Make the high byte of the address of the table for shifting the
 $E40C LD H,A          ; sprite.}
 $E40D LD A,(DE)       ; {Fetch the width of the sprite, and add one for the part that is
 $E40E INC DE          ; shifted into the next character.
 $E40F AND $07         ;
 $E411 INC A           ;
 $E412 LD B,A          ; }
 $E413 LD ($BBC2),A    ; Keep the number of characters to draw.
 $E416 DEC A           ; {Double the width of the sprite in characters.
 $E417 AND $07         ;
 $E419 ADD A,A         ;
 $E41A LD C,A          ; }
 $E41B ADD A,A         ; {Multiply it by nine, to make eighteen bytes of code for each
 $E41C ADD A,A         ; character.
 $E41D ADD A,A         ;
 $E41E ADD A,C         ; }
 $E41F NEG             ; {Subtract the length of the code from the end of the
 $E421 ADD A,$5A       ; shifted row.}
; Change the code to jump into the row.
@label=DrawSprite_Patch
*$E423 LD ($E4CC),A    ; Set the offset of the jump in the code.
 $E426 LD A,B          ; {Work out the number of bytes to move on to the next row, and set it
 $E427 CPL             ; in the code.
 $E428 ADD A,$1A       ;
 $E42A LD ($E52A),A    ; }
 $E42D EX DE,HL        ; Start with the sprite.
 $E42E LD A,(IX+$00)   ; {Check whether the object is one of the legs or the body of the
 $E431 SUB $10         ; player.
 $E433 CP $20          ; }
 $E435 LD A,$70        ; Use a height of #N$70 (the whole window).
 $E437 JR NC,$E43C     ; Jump to #R$E43C unless it is the player.
 $E439 LD A,($BC02)    ; Use the height of the player while materialising.
; Clip the sprite at the top and bottom of the window.
@label=DrawSprite_Clip
*$E43C LD C,A          ; Keep the height.
 $E43D LD A,(IX+$0F)   ; {Work out the position of the sprite in the window, and jump to
 $E440 SUB $48         ; #R$E46E if it starts below the window.
 $E442 JR C,$E46E      ; }
 $E444 SUB C           ; {Return if it starts above the height of the window.
 $E445 RET NC          ; }
 $E446 NEG             ; Work out the number of rows that fit between the sprite and the top
                       ; of the window.
 $E448 CP (HL)         ; {Jump to #R$E44C if fewer rows fit than there are in
 $E449 JR C,$E44C      ; the sprite.}
 $E44B LD A,(HL)       ; Otherwise use the number of rows of the sprite.
@label=DrawSprite_Rows
*$E44C INC HL          ; {Point at the first row of the sprite, and keep the number of rows to
 $E44D LD ($BBC3),A    ; draw.}
; Set up the registers, and draw the rows of the sprite.
@label=DrawSprite_Draw
*$E450 EX DE,HL        ; {Keep the address of the sprite.
 $E451 PUSH HL         ; }
 $E452 LD L,(IX+$0E)   ; {Fetch the position of the sprite.
 $E455 LD H,(IX+$0F)   ; }
 $E458 CALL $E53A      ; Find the address of the position in the screen buffer.
 $E45B LD C,L          ; {Move it into #REGbc.
 $E45C LD B,H          ; }
 $E45D POP HL          ; Get the address of the sprite back.
 $E45E LD ($BBAE),SP   ; Keep the stack pointer.
 $E462 EX DE,HL        ; {Point the stack pointer at the sprite.
 $E463 LD SP,HL        ;
 $E464 EX DE,HL        ; }
 $E465 SET 1,(IX+$07)  ; Flag that the object has been drawn.
 $E469 LD A,($BBC3)    ; Fetch the number of rows to draw.
 $E46C JR $E4C9        ; Jump to #R$E4C9 to draw them.
; The sprite starts below the window, so skip the rows that are not
; visible.
@label=DrawSprite_Below
*$E46E NEG             ; {Work out the number of rows to skip.
 $E470 LD C,A          ; }
 $E471 LD A,(HL)       ; {Work out the number of rows that are left.
 $E472 SUB C           ; }
 $E473 RET M           ; {Return if no rows are left.
 $E474 RET Z           ; }
 $E475 LD ($BBC3),A    ; {Keep the number of rows to draw, and clear #REGb.
 $E478 LD B,$00        ; }
 $E47A DEC HL          ; {Fetch the width of the sprite.
 $E47B LD A,(HL)       ;
 $E47C AND $3F         ; }
 $E47E INC HL          ; {Point at the first row.
 $E47F INC HL          ; }
 $E480 SLA C           ; {Work out the number of bytes that make up a row, and
 $E482 RL B            ; double it.}
@label=DrawSprite_Skip
*$E484 ADD HL,BC       ; {Skip the rows, one at a time.
 $E485 DEC A           ;
 $E486 JR NZ,$E484     ; }
 $E488 LD (IX+$0F),$48 ; Start the sprite at the bottom of the window.
 $E48C JR $E450        ; Jump to #R$E450 to draw the sprite.
; The sprite is on a character boundary.
@label=DrawSprite_Aligned
*$E48E LD A,(DE)       ; {Fetch the width of the sprite.
 $E48F INC DE          ;
 $E490 AND $0F         ; }
 $E492 LD ($BBC2),A    ; Keep the number of characters to draw.
 $E495 LD B,A          ; Make it the count of characters.
 $E496 ADD A,A         ; {Multiply it by eight.
 $E497 ADD A,A         ;
 $E498 ADD A,A         ; }
 $E499 NEG             ; Negate it.
 $E49B SUB $06         ; Take off the length of the code that is left after the
                       ; characters.
 $E49D JR $E423        ; Jump to #R$E423 to change the code.

; Draw Aligned Columns
;
; The code that draws a row of a sprite that is on a character boundary.
; There is a copy of the code for each of up to five characters, and the code is
; entered at the one that leaves the number of characters of the sprite, by
; #R$E3FF. Each character takes a mask and pixels from the stack, and puts them
; on the screen buffer: the pixels under the mask are cleared, and then the
; pixels of the sprite are set.
;
; BC Address in the screen buffer
;
; Draw the first character.
@label=DrawAlignedColumns
@label=DrawAlignedColumns_Five
c$E49F POP DE        ; Take the mask and the pixels of the first character from
                     ; the stack.
 $E4A0 LD A,(BC)     ; Fetch the byte of the screen buffer.
 $E4A1 CPL           ; {Clear the pixels under the mask, and set the pixels of
 $E4A2 OR E          ; the sprite.
 $E4A3 CPL           ;
 $E4A4 OR D          ; }
 $E4A5 LD (BC),A     ; {Put the byte in the screen buffer, and move on to the
 $E4A6 INC BC        ; next byte.}
; Draw the second character.
@label=DrawAlignedColumns_Four
 $E4A7 POP DE        ; Take the mask and the pixels of the second character
                     ; from the stack.
 $E4A8 LD A,(BC)     ; Fetch the byte of the screen buffer.
 $E4A9 CPL           ; {Clear the pixels under the mask, and set the pixels of
 $E4AA OR E          ; the sprite.
 $E4AB CPL           ;
 $E4AC OR D          ; }
 $E4AD LD (BC),A     ; {Put the byte in the screen buffer, and move on to the
 $E4AE INC BC        ; next byte.}
; Draw the third character.
@label=DrawAlignedColumns_Three
 $E4AF POP DE        ; Take the mask and the pixels of the third character from
                     ; the stack.
 $E4B0 LD A,(BC)     ; Fetch the byte of the screen buffer.
 $E4B1 CPL           ; {Clear the pixels under the mask, and set the pixels of
 $E4B2 OR E          ; the sprite.
 $E4B3 CPL           ;
 $E4B4 OR D          ; }
 $E4B5 LD (BC),A     ; {Put the byte in the screen buffer, and move on to the
 $E4B6 INC BC        ; next byte.}
; Draw the fourth character.
@label=DrawAlignedColumns_Two
 $E4B7 POP DE        ; Take the mask and the pixels of the fourth character
                     ; from the stack.
 $E4B8 LD A,(BC)     ; Fetch the byte of the screen buffer.
 $E4B9 CPL           ; {Clear the pixels under the mask, and set the pixels of
 $E4BA OR E          ; the sprite.
 $E4BB CPL           ;
 $E4BC OR D          ; }
 $E4BD LD (BC),A     ; {Put the byte in the screen buffer, and move on to the
 $E4BE INC BC        ; next byte.}
; Draw the fifth character.
@label=DrawAlignedColumns_One
 $E4BF POP DE        ; Take the mask and the pixels of the fifth character from
                     ; the stack.
 $E4C0 LD A,(BC)     ; Fetch the byte of the screen buffer.
 $E4C1 CPL           ; {Clear the pixels under the mask, and set the pixels of
 $E4C2 OR E          ; the sprite.
 $E4C3 CPL           ;
 $E4C4 OR D          ; }
 $E4C5 LD (BC),A     ; Put the byte in the screen buffer.
 $E4C6 JP $E528      ; Jump to #R$E528 to move on to the next row.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$D08F }
; { #GUNFRIGHT$BE5B }
; { #KNIGHTLORE$D780 }
; { #PENTAGRAM$B44F }
; LIST#

; Draw Sprite Row
;
; Used by the routines at #R$E3FF and #R$E528.
; .
; Starts drawing a row of a sprite, by jumping into the code for the width
; of the sprite. The offset of the jump is set by #R$E3FF.
;
; A' Number of rows left to draw
; BC Address in the screen buffer
@label=DrawSpriteRow
c$E4C9 EX AF,AF'     ; Keep the number of rows left to draw.
 $E4CA LD A,(BC)     ; Fetch the first byte of the row from the screen buffer.
@label=DrawSpriteRow_Jump
*$E4CB JR $E4CB      ; Jump into the row to draw the characters (the offset is changed by
                     ; the code that sets up the drawing).

; Draw Shifted Columns
;
; The code that draws a row of a sprite that has been shifted by two, four
; or six pixels. There is a copy of the code for each of up to five characters,
; and the code is entered at the one that leaves the number of characters of the
; sprite, from #R$E4C9.
; .
; Each character takes a mask and pixels from the stack. The shifted halves of
; them come from the tables that #R$E0FB builds, with the high byte of the
; address of the table in #REGh, and the low byte of the address from the mask
; or the pixels. The part that goes into the first character of the screen
; buffer is combined with what is left over from the previous character, and the
; part that goes into the next character is kept for the next time.
;
; A The first byte of the row in the screen buffer
; BC Address in the screen buffer
; H Page of the table for the first parts of the shifted bytes
;
; The jump starts here for five columns.
@label=DrawShiftedColumns
@label=DrawShiftedColumns_Five
c$E4CD CPL           ; {Invert the screen byte, and fetch the mask into #REGe and the pixels
 $E4CE POP DE        ; into #REGd.}
 $E4CF LD L,E        ; {Clear the screen bits under the part of the mask which is in this
 $E4D0 OR (HL)       ; byte.
 $E4D1 CPL           ; }
 $E4D2 LD L,D        ; {Add the part of the pixels which is in this byte.
 $E4D3 OR (HL)       ; }
; Put the byte in the screen buffer, move on to the next byte and point
; #REGh at the table for the second parts.
 $E4D4 LD (BC),A     ; {Store the byte and move on to the next.
 $E4D5 INC BC        ; }
 $E4D6 INC H         ; {Point #REGh at the table for the bits which move into the next byte,
 $E4D7 LD L,E        ; and fetch that screen byte.
 $E4D8 LD A,(BC)     ; }
 $E4D9 CPL           ; {Clear the screen bits under the part of the mask which has moved
 $E4DA OR (HL)       ; into it.
 $E4DB CPL           ; }
 $E4DC LD L,D        ; {Add the part of the pixels which has moved into it.
 $E4DD OR (HL)       ; }
 $E4DE DEC H         ; Point #REGh back at the first table.
; The jump starts here for four columns.
@label=DrawShiftedColumns_Four
 $E4DF CPL           ; {Invert the screen byte, and fetch the mask into #REGe and the pixels
 $E4E0 POP DE        ; into #REGd.}
 $E4E1 LD L,E        ; {Clear the screen bits under the part of the mask which is in this
 $E4E2 OR (HL)       ; byte.
 $E4E3 CPL           ; }
 $E4E4 LD L,D        ; {Add the part of the pixels which is in this byte.
 $E4E5 OR (HL)       ; }
; Put the byte in the screen buffer, move on to the next byte and point
; #REGh at the table for the second parts.
 $E4E6 LD (BC),A     ; {Store the byte and move on to the next.
 $E4E7 INC BC        ; }
 $E4E8 INC H         ; {Point #REGh at the table for the bits which move into the next byte,
 $E4E9 LD L,E        ; and fetch that screen byte.
 $E4EA LD A,(BC)     ; }
 $E4EB CPL           ; {Clear the screen bits under the part of the mask which has moved
 $E4EC OR (HL)       ; into it.
 $E4ED CPL           ; }
 $E4EE LD L,D        ; {Add the part of the pixels which has moved into it.
 $E4EF OR (HL)       ; }
 $E4F0 DEC H         ; Point #REGh back at the first table.
; The jump starts here for three columns.
@label=DrawShiftedColumns_Three
 $E4F1 CPL           ; {Invert the screen byte, and fetch the mask into #REGe and the pixels
 $E4F2 POP DE        ; into #REGd.}
 $E4F3 LD L,E        ; {Clear the screen bits under the part of the mask which is in this
 $E4F4 OR (HL)       ; byte.
 $E4F5 CPL           ; }
 $E4F6 LD L,D        ; {Add the part of the pixels which is in this byte.
 $E4F7 OR (HL)       ; }
; Put the byte in the screen buffer, move on to the next byte and point
; #REGh at the table for the second parts.
 $E4F8 LD (BC),A     ; {Store the byte and move on to the next.
 $E4F9 INC BC        ; }
 $E4FA INC H         ; {Point #REGh at the table for the bits which move into the next byte,
 $E4FB LD L,E        ; and fetch that screen byte.
 $E4FC LD A,(BC)     ; }
 $E4FD CPL           ; {Clear the screen bits under the part of the mask which has moved
 $E4FE OR (HL)       ; into it.
 $E4FF CPL           ; }
 $E500 LD L,D        ; {Add the part of the pixels which has moved into it.
 $E501 OR (HL)       ; }
 $E502 DEC H         ; Point #REGh back at the first table.
; The jump starts here for two columns.
@label=DrawShiftedColumns_Two
 $E503 CPL           ; {Invert the screen byte, and fetch the mask into #REGe and the pixels
 $E504 POP DE        ; into #REGd.}
 $E505 LD L,E        ; {Clear the screen bits under the part of the mask which is in this
 $E506 OR (HL)       ; byte.
 $E507 CPL           ; }
 $E508 LD L,D        ; {Add the part of the pixels which is in this byte.
 $E509 OR (HL)       ; }
; Put the byte in the screen buffer, move on to the next byte and point
; #REGh at the table for the second parts.
 $E50A LD (BC),A     ; {Store the byte and move on to the next.
 $E50B INC BC        ; }
 $E50C INC H         ; {Point #REGh at the table for the bits which move into the next byte,
 $E50D LD L,E        ; and fetch that screen byte.
 $E50E LD A,(BC)     ; }
 $E50F CPL           ; {Clear the screen bits under the part of the mask which has moved
 $E510 OR (HL)       ; into it.
 $E511 CPL           ; }
 $E512 LD L,D        ; {Add the part of the pixels which has moved into it.
 $E513 OR (HL)       ; }
 $E514 DEC H         ; Point #REGh back at the first table.
; The jump starts here for one column.
@label=DrawShiftedColumns_One
 $E515 CPL           ; {Invert the screen byte, and fetch the mask into #REGe and the pixels
 $E516 POP DE        ; into #REGd.}
 $E517 LD L,E        ; {Clear the screen bits under the part of the mask which is in this
 $E518 OR (HL)       ; byte.
 $E519 CPL           ; }
 $E51A LD L,D        ; {Add the part of the pixels which is in this byte.
 $E51B OR (HL)       ; }
; Put the byte in the screen buffer, move on to the next byte and point
; #REGh at the table for the second parts.
 $E51C LD (BC),A     ; {Store the byte and move on to the next.
 $E51D INC BC        ; }
 $E51E INC H         ; {Point #REGh at the table for the bits which move into the next byte,
 $E51F LD L,E        ; and fetch that screen byte.
 $E520 LD A,(BC)     ; }
 $E521 CPL           ; {Clear the screen bits under the part of the mask which has moved
 $E522 OR (HL)       ; into it.
 $E523 CPL           ; }
 $E524 LD L,D        ; {Add the part of the pixels which has moved into it.
 $E525 OR (HL)       ; }
 $E526 DEC H         ; Point #REGh back at the first table.
@label=DrawShiftedColumns_Last
 $E527 LD (BC),A     ; Put the part of the last character that is left over in the screen
                     ; buffer.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$BE8A }
; LIST#

; End Sprite Row
;
; Used by the routine at #R$E49F.
; .
; Moves on to the next row of a sprite after one has been drawn. The
; number that is added to the address in the screen buffer is set by #R$E3FF.
;
; BC Address in the screen buffer
@label=EndSpriteRow
c$E528 LD A,C        ; {Add the number of bytes to the next row to the low byte of the
 $E529 ADD A,$00     ; address (the number is set by the code that sets up the drawing).
 $E52B LD C,A        ; }
 $E52C LD A,B        ; {Add the carry to the high byte.
 $E52D ADC A,$00     ;
 $E52F LD B,A        ; }
 $E530 EX AF,AF'     ; Get the number of rows left back.
 $E531 DEC A         ; Count down the number of rows.
 $E532 JP NZ,$E4C9   ; Loop back to draw the next row.
 $E535 LD SP,($BBAE) ; {Get the stack pointer back, and return.
 $E539 RET           ; }

; Calculate Buffer Address
;
; Used by the routines at #R$D2B2, #R$D425 and #R$E3FF.
; .
; Works out the address in the screen buffer of a position in the window.
; The buffer is 24 bytes wide.
;
;   H Y position (from #N$48 at the first row of the buffer)
;   L X position
; O:HL Address in the screen buffer
;
; Work out the column and 24 times the row.
@label=CalculateBufferAddress
c$E53A PUSH BC       ; Stash #REGbc on the stack.
 $E53B SRL L         ; {Divide the X position by eight.
 $E53D SRL L         ;
 $E53F SRL L         ; }
 $E541 LD A,L        ; {Keep the column, and start with the Y position.
 $E542 LD L,H        ;
 $E543 LD H,$00      ; }
 $E545 ADD HL,HL     ; {Multiply the Y position by eight.
 $E546 ADD HL,HL     ;
 $E547 ADD HL,HL     ; }
 $E548 LD C,L        ; {Keep the result.
 $E549 LD B,H        ; }
 $E54A ADD HL,HL     ; {Multiply by two more, and add it to get 24 times the Y
 $E54B ADD HL,BC     ; position.}
; Add the column and the address of the buffer.
 $E54C LD C,A        ; {Add the X position divided by eight.
 $E54D LD B,$00      ; }
 $E54F ADD HL,BC     ; Add the column.
 $E550 LD BC,$DF02   ; {Add the address of the buffer.
 $E553 ADD HL,BC     ; }
 $E554 POP BC        ; {Restore #REGbc from the stack and return.
 $E555 RET           ; }
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$D233 }
; LIST#

; Calculate Screen Address
;
; Used by the routines at #R$C489 and #R$C9EF.
; .
; Works out the address on the screen of a position given in pixels,
; measured from the bottom left of the screen.
;
;   H Y position (from the bottom of the screen)
;   L X position
; O:HL Screen address
@label=CalculateScreenAddress
c$E556 PUSH DE       ; {Keep #REGde, and put the position in it.
 $E557 EX DE,HL      ; }
 $E558 LD A,E        ; {Work out the column from the X position.
 $E559 RRCA          ;
 $E55A RRCA          ;
 $E55B RRCA          ;
 $E55C AND $1F       ;
 $E55E LD L,A        ; }
 $E55F LD A,D        ; {Work out the character row within a third of the screen, from the Y
 $E560 CPL           ; position measured from the top.
 $E561 RLCA          ;
 $E562 RLCA          ;
 $E563 AND $E0       ;
 $E565 OR L          ;
 $E566 LD L,A        ; }
 $E567 LD A,D        ; {Work out the third of the screen.
 $E568 CPL           ;
 $E569 RRCA          ;
 $E56A RRCA          ;
 $E56B RRCA          ;
 $E56C AND $18       ;
 $E56E LD H,A        ; }
 $E56F LD A,D        ; {Work out the pixel row within the character, and make the high byte
 $E570 CPL           ; of the address.
 $E571 AND $07       ;
 $E573 OR H          ;
 $E574 ADD A,$38     ;
 $E576 LD H,A        ; }
 $E577 POP DE        ; {Get #REGde back and return.
 $E578 RET           ; }
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$D135 }
; { #GUNFRIGHT$D24F }
; LIST#

; Calculate Attribute Address
;
; Used by the routines at #R$BDFE, #R$CD10 and #R$D356.
; .
; Works out the address in the attribute buffer of a position in the
; window. The buffer is 24 bytes wide, and has a row for each eight rows of the
; screen buffer.
;
;   H Y position (from #N$48 at the first row of the buffer)
;   L X position
; O:HL Address in the attribute buffer
;
; Work out 24 times the character row.
@label=CalculateAttributeAddress
c$E579 PUSH BC       ; Stash #REGbc on the stack.
 $E57A LD C,L        ; Keep the X position.
 $E57B LD A,H        ; {Work out the Y position at the start of its character
 $E57C AND $F8       ; row.
 $E57E LD L,A        ;
 $E57F LD H,$00      ; }
 $E581 LD A,C        ; {Fetch the X position, and copy the Y position into
 $E582 LD C,L        ; #REGbc.
 $E583 LD B,H        ; }
 $E584 ADD HL,HL     ; {Multiply the Y position by three, to make 24 times the
 $E585 ADD HL,BC     ; row.}
; Add the column and the address of the attribute buffer.
 $E586 SRL A         ; {Work out the column from the X position.
 $E588 SRL A         ;
 $E58A SRL A         ; }
 $E58C LD C,A        ; {Make the column into a 16-bit number.
 $E58D LD B,$00      ; }
 $E58F ADD HL,BC     ; Add the column.
 $E590 LD BC,$EF6A   ; {Add the address of the attribute buffer.
 $E593 ADD HL,BC     ; }
 $E594 POP BC        ; {Restore #REGbc from the stack and return.
 $E595 RET           ; }

; Add A To HL
;
; Used by the routines at #R$BDFE, #R$C1FD, #R$C661, #R$D425, #R$DAB7 and
; #R$E353.
; .
; Adds an unsigned number to #REGhl.
;
;   A The number
;   HL The address
; O:HL The new address
@label=AddAToHL
c$E596 ADD A,L       ; Add #REGa to #REGl.
 $E597 LD L,A        ; Copy it to #REGl.
 $E598 LD A,H        ; Fetch #REGh.
 $E599 ADC A,$00     ; Add #N$00 with carry.
 $E59B LD H,A        ; Copy it to #REGh.
 $E59C RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CE06 }
; { #ATICATAC$926C }
; { #CYBERUN$9BCF }
; { #KNIGHTLORE$D4F2 }
; { #PENTAGRAM$B519 }
; LIST#

; Clear Screen
;
; Used by the routines at #R$BDFE and #R$CC56.
; .
; Clears the whole screen to white ink on black paper, and sets the border
; to black.
; .
; #PUSHS #UDGTABLE { =h Before | =h After #R$E59D }
; { #SIM(start=$BE04,stop=$BE18,sp=$5E00,r=$80,clear=1)
; #SIM(start=$BE18,stop=$BE24)
; #SIM(start=$BE2D,stop=$BE71)
; #SIM(start=$BE71,stop=$BECD)
; #SIM(start=$BECD,stop=$BED0)
; #SCR$02(clear-screen-before)
; | #SIM(start=$E59D,stop=$0000,sp=$5BF0)
; #SCR$02(clear-screen-after) } UDGTABLE# #POPS
;
; .
;
; Clear the pixels, the attributes and the border.
@label=ClearScreen
c$E59D CALL $E5A8    ; Clear the pixels.
 $E5A0 CALL $E5B0    ; Clear the attributes.
 $E5A3 LD A,$00      ; {Set the border to black.
 $E5A5 OUT ($FE),A   ; }
 $E5A7 RET           ; Return.

; Clear Pixels
;
; Used by the routine at #R$E59D.
; .
; Clears the pixels of the screen.
@label=ClearPixels
c$E5A8 LD HL,$4000   ; {Point at #N$4000 (in the screen buffer), and count the
 $E5AB LD BC,$1800   ; bytes.}
 $E5AE JR $E5BA      ; Jump to #R$E5BA to clear them.
