@label=ObjectHandlerTable
w$D599 DEFW $D6D5,$D6D5                                                                                     ; Types
                                                                                                            ; #N$00 and
                                                                                                            ; #N$01:
                                                                                                            ; #R$D6D5.
 $D59D DEFW $D727                                                                                           ; Type
                                                                                                            ; #N$02:
                                                                                                            ; #R$D727.
 $D59F DEFW $D74C                                                                                           ; Type
                                                                                                            ; #N$03:
                                                                                                            ; #R$D74C.
 $D5A1 DEFW $D942,$D942,$D942,$D942                                                                         ; Types
