                                                                                                            ; #N$0F:
                                                                                                            ; #R$D7D8.
 $D5B9 DEFW $DA7A,$DA7A,$DA7A,$DA7A,$DA7A,$DA7A                                                             ; Types
                                                                                                            ; #N$10 to
                                                                                                            ; #N$15:
                                                                                                            ; #R$DA7A.
