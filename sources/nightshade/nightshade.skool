i$5B00

; Decryption Routine
;
; The stub that the tape loader runs after loading the game, which
; arrives scrambled at #N$6000 (#N$8800 bytes of it). It unscrambles the game
; in place, moves it down by #N$0200 bytes so that it starts at #R$5E00, and
; jumps there.
; .
; Each pair of bytes is unscrambled by a single RLD: the low nibble of the
; first byte of the pair is replaced by the high nibble of the second byte,
; the high nibble of the second byte by its low nibble, and the low nibble of
; the second byte by the old low nibble of the first byte.
; .
; The routine also sets bit 7 of the memory refresh register #REGr. Nothing
; in the game ever clears that bit, and the game resets the computer if it is
; clear when the check at #R$C1DB runs, which defeats any attempt to start the
; game without going through this stub. The random number generator at #R$C5BB
; also reads #REGr, so that bit keeps those values in the range #N$80 to
; #N$FF.
;
; .
;
; Set bit 7 of the memory refresh register for the random
; number generator.
@label=Decryption
c$5B80 DI            ; Disable interrupts.
 $5B81 LD A,R        ; Fetch the memory refresh register into #REGa.
 $5B83 OR %10000000  ; Set bit 7. The Z80 leaves that bit as it is written,
                     ; so #R$C5BB always mixes a value from #N$80 to #N$FF into the
                     ; random number.
 $5B85 LD R,A        ; Write #REGa back to the memory refresh register.
; Unscramble the whole game, a pair of bytes at a time.
 $5B87 LD DE,$6000   ; Set #REGde to #N($6000), the first byte of the first
                     ; pair.
 $5B8A LD HL,$6001   ; Set #REGhl to #N($6001), the second byte of the first
                     ; pair.
 $5B8D LD BC,$4400   ; Set a pair counter in #REGbc to #N$4400.
@label=Decryption_Loop
*$5B90 LD A,(DE)     ; Fetch the first byte of the pair.
 $5B91 RLD           ; Rotate the nibbles of the pair.
 $5B93 LD (DE),A     ; Write the unscrambled first byte back.
 $5B94 INC DE        ; {Move #REGde on to the first byte of the next pair.
 $5B95 INC DE        ; }
 $5B96 INC HL        ; {Move #REGhl on to the second byte of the next pair.
 $5B97 INC HL        ; }
 $5B98 DEC BC        ; Decrease the pair counter by one.
 $5B99 LD A,B        ; {Jump to #R$5B90 until every pair has been unscrambled.
 $5B9A OR C          ;
 $5B9B JR NZ,$5B90   ; }
; Move the unscrambled game down so that it starts at #R$5E00.
 $5B9D LD HL,$6000   ; {Move #N$8800 bytes from #N$6000 down to #R$5E00.
 $5BA0 LD DE,$5E00   ;
 $5BA3 LD BC,$8800   ;
 $5BA6 LDIR          ; }
 $5BA8 JP $5E00      ; Jump to #R$5E00 to start the game.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$5B80 }
; { #LUNARJETMAN$5B80 }
; LIST#

i$5BAB

; Indirect Jump
;
; Used by the routine at #R$D593.
; .
; Jumps to the routine whose address is already held in #REGhl. It is the
; byte #N$E9 (JP (HL)) that the tape loader leaves in the system variable
; #SKOOLKID$5CB0(NMIADD), which the game borrows as a trampoline.
;
; HL Jump address
@label=IndirectJump
c$5CB0 JP (HL)       ; Jump to the address held in #REGhl.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$5CB0 }
; { #LUNARJETMAN$5CB0 }
; { #SABREWULF$5CB0 }
; { #TRANZAM$5CB0 }
; LIST#

i$5CB1

; Game Entry Point
;
; Used by the routine at #R$5B80.
; .
; The start of the game, which the #R$5B80 stub jumps to once the game has
; been unscrambled and moved into place.
@label=GameEntry
c$5E00 DI            ; Disable interrupts.
 $5E01 JP $BDFE      ; Jump to #R$BDFE.

; Map
;
; The map of the village. It is #N$20 cells wide and #N$20 cells high, and
; each byte holds the tile that is in one cell, which is a number from #N$00 to
; #N$23. Tile #N$00 is open ground, and tile #N$01 is the solid tile that fills
; the edge of the village and much of the rest of it. The other tiles are the
; trees, graves, walls and other things that stand in the village. The cell is
; found from the column and the row by #R$E051, and the tile decides how it is
; drawn (see #R$62A4) and what the player can walk through (see #R$6334). The
; whole village is shown on the #LINK(Map)(Map) page.
; .
; When the view is turned round, the map is read backwards from the end.
@label=Map
