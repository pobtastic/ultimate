; Border Characters
;
; The twenty characters that draw the border around the playing area and
; the frame of the menu (see #R$CA55 and #R$CA9D). The font pointer is set to
; this address to print them.
@label=BorderCharacters
b$BB0A DEFB $06,$05,$03,$07,$0E,$1C,$38,$70
 $BB12 DEFB $E0,$C0,$A0,$60,$70,$38,$1C,$0E
 $BB1A DEFB $70,$38,$1C,$0E,$06,$01,$03,$07
