                                                                                                            ; #N$07:
                                                                                                            ; #R$D942.
 $D5A9 DEFW $D80C,$D80C,$D80C,$D80C                                                                         ; Types
                                                                                                            ; #N$08 to
                                                                                                            ; #N$0B:
