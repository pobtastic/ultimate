; Draw Inventory Tube
;
; Used by the routine at #R$BDFE.
; .
; Draws the tube down the left of the screen that holds the items that the
; player is carrying: two vertical bars joined at the bottom.
; .
; #PUSHS #UDGTABLE { =h After #R$C83F }
; { #SIM(start=$BE04,stop=$BE18,sp=$5E00,r=$80,clear=1)
; #SIM(start=$BE18,stop=$BE24)
; #SIM(start=$C83F,stop=$0000,sp=$5BF0)
; #SCR$02,$01,$00,$04,$18(inventory-tube) } UDGTABLE# #POPS
@label=DrawInventoryTube
c$C83F LD A,$43      ; {Use bright magenta ink (attribute #N$43), and keep it for colouring
 $C841 EX AF,AF'     ; the tube.}
 $C842 LD HL,$6CB6   ; {Set the font to the characters of the tube.
 $C845 LD ($BBAC),HL ; }
 $C848 LD HL,$4001   ; Set the screen position of the top of the left
                     ; bar to #N$4001 (in the screen buffer).
 $C84B XOR A         ; {Print the top of the bar.
 $C84C CALL $CB5B    ; }
 $C84F CALL $CB71    ; Move down a row.
 $C852 LD A,$01      ; {Choose the side of the bar as the character, and #N$16 as the number
 $C854 LD B,$16      ; of rows.}
 $C856 CALL $C87E    ; Print the side of the left bar.
; Print the bottom of the tube.
 $C859 LD A,$02      ; {Print the bottom left corner.
 $C85B CALL $CB5B    ; }
 $C85E INC L         ; Move one position to the right.
 $C85F LD A,$03      ; {Print the first part of the bottom.
 $C861 CALL $CB5B    ; }
 $C864 INC L         ; Move one position to the right.
 $C865 LD A,$03      ; {Print the second part of the bottom.
 $C867 CALL $CB5B    ; }
 $C86A INC L         ; Move one position to the right.
 $C86B LD A,$04      ; {Print the bottom right corner.
 $C86D CALL $CB5B    ; }
; Print the right bar.
 $C870 LD HL,$4004   ; Set the screen position of the top of the right
                     ; bar to #N$4004 (in the screen buffer).
 $C873 XOR A         ; {Print the top of the bar.
 $C874 CALL $CB5B    ; }
 $C877 CALL $CB71    ; Move down a row.
 $C87A LD A,$01      ; {Choose the side of the bar as the character, and #N$16 as the number
 $C87C LD B,$16      ; of rows.}
; Prints a column of characters.
@label=PrintCharacterColumn
*$C87E PUSH AF       ; Keep the character.
 $C87F CALL $CB5B    ; Print the character.
 $C882 CALL $CB71    ; Move down a row.
 $C885 POP AF        ; Get the character back.
 $C886 DJNZ $C87E    ; Loop back until the whole column has been printed.
 $C888 RET           ; Return.

; Colour Attribute Column
;
; Used by the routine at #R$D356.
; .
; Sets a column of two attributes, down a number of rows of the attribute
; buffer.
;
; A Attribute
; B Number of rows
; HL Address in the attribute buffer
@label=ColourAttributeColumn
c$C889 LD E,A        ; {Add the flash colour used in the last frame (#R$BBFC) to the
 $C88A LD A,($BBFC)  ; attribute.
 $C88D OR E          ; }
 $C88E LD DE,$0017   ; Set the distance to the first attribute in the next row
                     ; (#N$18 minus one).
@label=ColourAttributeColumn_Loop
*$C891 LD (HL),A     ; {Set two attributes and move down a row, and loop back until all of
 $C892 INC HL        ; the rows have been coloured.
 $C893 LD (HL),A     ;
 $C894 ADD HL,DE     ;
 $C895 DJNZ $C891    ; }
 $C897 RET           ; Return.

; Colour Player Attributes
;
; Used by the routine at #R$BDFE.
; .
; Sets a block of two attributes across, down a number of rows of the
; attribute buffer. The first attribute is made bright. Nothing is coloured when
; the player is dead.
;
; A' Attribute
; B Number of rows
; HL Address in the attribute buffer
;
; Return if the player is dead.
@label=ColourPlayerAttributes
c$C898 EX AF,AF'     ; Keep the attribute.
 $C899 LD A,($BC8E)  ; {Return if the player is dead.
 $C89C AND A         ;
 $C89D RET Z         ; }
 $C89E EX AF,AF'     ; Get the attribute back.
; Colour two attributes down each row.
 $C89F LD E,A        ; {Add the flash colour used in the last frame (#R$BBFC) to the
 $C8A0 LD A,($BBFC)  ; attribute.
 $C8A3 OR E          ; }
 $C8A4 LD DE,$0017   ; Set the distance to the first attribute in the next row
                     ; (#N$18 minus one).
@label=ColourPlayerAttributes_Loop
*$C8A7 OR $40        ; {Set the first attribute (bright) and the second attribute
 $C8A9 LD (HL),A     ; (not bright), move down a row, and loop back until all of the rows have been
 $C8AA INC HL        ; coloured.
 $C8AB AND $3F       ;
 $C8AD LD (HL),A     ;
 $C8AE ADD HL,DE     ;
 $C8AF DJNZ $C8A7    ; }
 $C8B1 RET           ; Return.

; Fill Attribute Rectangle
;
; Used by the routine at #R$CD10.
; .
; Sets a rectangle of attributes in the attribute buffer.
;
; A Attribute
; B Width
; C Height
; HL Address in the attribute buffer
;
; Work out the distance from one row to the next.
@label=FillAttributeRectangle
c$C8B2 LD E,A        ; {Add the flash colour used in the last frame (#R$BBFC) to the
 $C8B3 LD A,($BBFC)  ; attribute, and keep it.
 $C8B6 OR E          ;
 $C8B7 EX AF,AF'     ; }
 $C8B8 LD A,$18      ; {Work out how far to move on from the end of one row of the rectangle
 $C8BA SUB B         ; to the start of the next.
 $C8BB LD E,A        ;
 $C8BC LD D,$00      ;
 $C8BE EX AF,AF'     ; }
; Fill each row of the rectangle.
@label=FillAttributeRectangle_Row
*$C8BF PUSH BC       ; Keep the width and the height.
@label=FillAttributeRectangle_Loop
*$C8C0 LD (HL),A     ; {Set the attributes of one row of the rectangle.
 $C8C1 INC HL        ;
 $C8C2 DJNZ $C8C0    ; }
 $C8C4 ADD HL,DE     ; {Move on to the start of the next row, and loop back until all of the
 $C8C5 POP BC        ; rows have been set.
 $C8C6 DEC C         ;
 $C8C7 JR NZ,$C8BF   ; }
 $C8C9 RET           ; Return.

; Game Selection Menu
;
; Used by the routine at #R$BDFE.
; .
; Shows the game selection menu, plays a tune, and waits for the options
; for the controls to be chosen. The game starts when the "0" key is pressed.
; .
; The control method is held in bits 1 and 2 of #R$BBB0, and bit 3 is set when
; directional control has been chosen.
; .
; #PUSHS #UDGTABLE { #SIM(start=$BE04,stop=$BE18,sp=$5E00,r=$80,clear=1)
; #SIM(start=$BE18,stop=$BE24)
; #SIM(start=$C8CA,stop=$C8E1)
; #SCR$02(game-selection-menu) } UDGTABLE# #POPS
;
; .
;
; Prepare the menu.
@label=GameMenu
c$C8CA XOR A         ; {Write #N$00 to *#R$BBBF.
 $C8CB LD ($BBBF),A  ; }
 $C8CE LD HL,$C962   ; Point #REGhl at #R$C962.
 $C8D1 LD B,$08      ; Set the number of lines to #N$08.
@label=GameMenu_Unflash
*$C8D3 RES 7,(HL)    ; Stop the line flashing.
 $C8D5 INC HL        ; Move on to the next line.
 $C8D6 DJNZ $C8D3    ; Jump to #R$C8D3 until all of the
                     ; lines are done.
 $C8D8 CALL $E206    ; Call #R$E206.
 $C8DB CALL $CA2B    ; Call #R$CA2B.
 $C8DE CALL $C949    ; Call #R$C949.
; Read the keys that choose the control method.
@label=GameMenu_Loop
*$C8E1 CALL $CA2B    ; Call #R$CA2B.
; #HTML(#AUDIO0(main-tune.wav)(#INCLUDE(MainTune)))
 $C8E4 LD DE,$C770   ; Point #REGde at #R$C770.
 $C8E7 CALL $C63D    ; Call #R$C63D.
; Read the keys "1" to "5".
 $C8EA LD A,$F7      ; {Read from the keyboard;
 $C8EC CALL $E239    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$F7 | 1 | 2 | 3 | 4 | 5 }
                     ; TABLE#}
 $C8EF LD E,A        ; Keep the keys that are pressed in
                     ; #REGe.
 $C8F0 LD A,($BBB0)  ; Fetch #R$BBB0.
 $C8F3 LD ($BBB1),A  ; Set #R$BBB1.
 $C8F6 BIT 0,E       ; {Jump to #R$C8FC if "1" is not
 $C8F8 JR Z,$C8FC    ; pressed.}
 $C8FA AND %11111001 ; Choose the keyboard.
; Choose a joystick if one of those keys is pressed.
@label=GameMenu_Key2
*$C8FC BIT 1,E       ; {Jump to #R$C904 if "2" is not
 $C8FE JR Z,$C904    ; pressed.}
 $C900 AND %11111001 ; Clear bits 1 and 2.
 $C902 OR %00000010  ; Choose the Kempston joystick.
@label=GameMenu_Key3
*$C904 BIT 2,E       ; {Jump to #R$C90C if "3" is not
 $C906 JR Z,$C90C    ; pressed.}
 $C908 AND %11111001 ; Clear bits 1 and 2.
 $C90A OR %00000100  ; Choose the cursor joystick.
@label=GameMenu_Key4
*$C90C BIT 3,E       ; {Jump to #R$C912 if "4" is not
 $C90E JR Z,$C912    ; pressed.}
 $C910 OR %00000110  ; Choose Interface II.
@label=GameMenu_SetMethod
*$C912 LD ($BBB0),A  ; Set #R$BBB0.
; Toggle directional control once for each press of "5".
 $C915 LD HL,$BBBD   ; Point #REGhl at #R$BBBD.
 $C918 BIT 4,E       ; {Jump to #R$C945 if "5" is not
 $C91A JR Z,$C945    ; pressed.}
 $C91C BIT 0,(HL)    ; {Jump to #R$C92A if "5" was pressed
 $C91E JR NZ,$C92A   ; last time as well.}
 $C920 SET 0,(HL)    ; Set bit 0 of #R$BBBD.
 $C922 LD A,($BBB0)  ; Fetch #R$BBB0.
 $C925 XOR %00001000 ; Toggle directional control.
 $C927 LD ($BBB0),A  ; Set #R$BBB0.
; Start the game if "0" is pressed.
@label=GameMenu_Check
*$C92A LD HL,$BBB1   ; Point #REGhl at #R$BBB1.
 $C92D CP (HL)       ; Compare with the previous options.
 $C92E LD DE,$C7F4   ; Point #REGde at #R$C7F4.
 $C931 CALL NZ,$C656 ; Call #R$C656 if the control method
                     ; has changed.
 $C934 LD A,$EF      ; {Read from the keyboard;
 $C936 CALL $E239    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$EF | 0 | 9 | 8 | 7 | 6 }
                     ; TABLE#}
 $C939 BIT 0,A       ; {Return if "0" is pressed.
 $C93B RET NZ        ; }
 $C93C CALL $C5B4    ; Call #R$C5B4.
 $C93F CALL $C949    ; Call #R$C949.
 $C942 JP $C8E1      ; Jump to #R$C8E1.
; "5" has been released.
@label=GameMenu_Key5Released
*$C945 RES 0,(HL)    ; Reset bit 0 of #R$BBBD.
 $C947 JR $C92A      ; Jump to #R$C92A.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$BA7E }
; { #KNIGHTLORE$BD0C }
; { #MARTIANOIDS$BB12 }
; { #PENTAGRAM$BB74 }
; LIST#

; Flash Menu Options
;
; Used by the routine at #R$C8CA.
; .
; Makes the line of the menu for
; the selected control method flash, and
; the line for directional control if that
; is on.
;
; .
;
; Flash the chosen control method.
@label=FlashMenuOptions
c$C949 LD HL,$C963   ; Point #REGhl at #R$C963.
 $C94C LD A,($BBB0)  ; Fetch #R$BBB0.
 $C94F RRCA          ; Move the method to bits 0 and 1.
 $C950 AND %00000011 ; Keep only bits 0 and 1.
 $C952 LD B,$04      ; Set a counter of #N$04 lines.
 $C954 CALL $CA1B    ; Call #R$CA1B.
; Flash directional control if it is
; on.
 $C957 RES 7,(HL)    ; Reset bit 7 of the attribute.
 $C959 LD A,($BBB0)  ; Fetch #R$BBB0.
 $C95C AND %00001000 ; Keep only bit 3.
 $C95E RET Z         ; Return if it is off.
 $C95F SET 7,(HL)    ; Set bit 7 of the attribute.
 $C961 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$BAFB }
; { #KNIGHTLORE$BD89 }
; { #PENTAGRAM$BBD8 }
; LIST#

; Menu Line Attributes
;
; The attribute of each of the eight lines of the menu. Bit 7 (flash) is
; set for the lines that have been chosen.
@label=MenuLineAttributes
b$C962 DEFB $43      ; The title: #COLOUR(#PEEK(#PC)).
@label=MenuLineAttributes_ControlMethods
 $C963 DEFB $44      ; The four methods of control: #COLOUR(#PEEK(#PC)).
 $C964 DEFB $44      ; The four methods of control: #COLOUR(#PEEK(#PC)).
 $C965 DEFB $44      ; The four methods of control: #COLOUR(#PEEK(#PC)).
 $C966 DEFB $44      ; The four methods of control: #COLOUR(#PEEK(#PC)).
@label=MenuLineAttributes_DirectionalControl
 $C967 DEFB $45      ; Directional control: #COLOUR(#PEEK(#PC)).
 $C968 DEFB $47      ; Start game: #COLOUR(#PEEK(#PC)).
 $C969 DEFB $47      ; The copyright notice: #COLOUR(#PEEK(#PC)).

; Menu Line Positions
;
; The screen position of each of the eight lines of the menu.
@label=MenuLinePositions
w$C96A DEFW $9F58,$8F30,$7F30,$6F30,$5F30,$4F30,$3F30,$1F50

; Messaging: Menu Text
;
; The text of each of the eight lines of the menu. The last character of
; each has bit 7 set. The character after the year is the copyright symbol.
@label=MenuText
t$C97A DEFM "NIGHT SHAD","E"+$80           ; "NIGHT SHADE".
 $C985 DEFM "1 KEYBOAR","D"+$80            ; "1 KEYBOARD".
 $C98F DEFM "2 KEMPSTON JOYSTIC","K"+$80   ; "2 KEMPSTON JOYSTICK".
 $C9A2 DEFM "3 CURSOR JOYSTIC","K"+$80     ; "3 CURSOR JOYSTICK".
 $C9B3 DEFM "4 INTERFACE I","I"+$80        ; "4 INTERFACE II".
 $C9C1 DEFM "5 DIRECTIONAL CONTRO","L"+$80 ; "5 DIRECTIONAL CONTROL".
 $C9D6 DEFM "0 START GAM","E"+$80          ; "0 START GAME".
 $C9E2 DEFM "; 1985 A:C:G",":"+$80         ; Copyright symbol, "1985 A.C.G.".

; Print String
;
; Used by the routine at #R$CA2B.
; .
; Prints a string in the main font, at a position given in pixels measured
; from the bottom left of the screen. The string ends with a character that has
; bit 7 set. The attribute for the whole string is in #REGaf', unless
; the string is printed by entering at #R$C9FC, which takes the attribute from
; the first byte of the string.
; .
; #PUSHS #UDGTABLE { =h After #R$C9EF }
; { #SIM(start=$BE04,stop=$BE18,sp=$5E00,r=$80,clear=1)
; #SIM(start=$BE18,stop=$BE24)
; #SIM(start=$C9EF,stop=$0000,xa=$46,de=$C985,hl=$8F40,sp=$5BF0)
; #SCR$02,$07,$05,$0C,$03(print-string) } UDGTABLE# #POPS
;
; A' Attribute
; DE Address of the string
; HL Position (X in #REGl, Y in #REGh)
;
; Set the font and find the screen address.
@label=PrintString
c$C9EF PUSH HL       ; Stash the position on the stack.
 $C9F0 LD HL,$6B5E   ; {Write #N$6B5E to #R$BBAC.
 $C9F3 LD ($BBAC),HL ; }
 $C9F6 POP HL        ; Restore the position from the stack.
 $C9F7 CALL $E556    ; Call #R$E556.
 $C9FA JR $CA0A      ; Jump to #R$CA0A.
; This entry point is used by the routines at #R$BDFE and #R$CC56.
; .
; Prints a string that starts with an attribute.
@label=PrintStringWithAttribute
*$C9FC PUSH HL       ; Stash the position on the stack.
 $C9FD LD HL,$6B5E   ; {Write #N$6B5E to #R$BBAC.
 $CA00 LD ($BBAC),HL ; }
 $CA03 POP HL        ; Restore the position from the stack.
 $CA04 CALL $E556    ; Call #R$E556.
 $CA07 LD A,(DE)     ; Fetch the attribute.
 $CA08 INC DE        ; Move on to the string.
 $CA09 EX AF,AF'     ; Keep the attribute in #REGaf'.
; Print each character of the string.
@label=PrintString_Loop
*$CA0A LD A,(DE)     ; Fetch the next character.
 $CA0B INC DE        ; Move on to the next character.
 $CA0C BIT 7,A       ; {Jump to #R$CA16 if it is the last
 $CA0E JR NZ,$CA16   ; one.}
 $CA10 CALL $CB5B    ; Call #R$CB5B.
 $CA13 INC L         ; Move on to the next position.
 $CA14 JR $CA0A      ; Jump to #R$CA0A.
; Print the last character.
@label=PrintString_Last
*$CA16 AND %01111111 ; Keep bits 0 to 6.
 $CA18 JP $CB5B      ; Jump to #R$CB5B.

; Set Flashing Attribute
;
; Used by the routine at #R$C949.
; .
; Sets bit 7 of the attribute of
; one line of text in a list of lines, and
; resets it for the other lines.
;
; A The number of the line
; B Number of lines
; HL Address of the attributes
;
; Flash one line and steady the rest.
@label=SetFlashingAttribute
c$CA1B AND A         ; {Jump to #R$CA25 if the line is not
 $CA1C JR NZ,$CA25   ; the first.}
@label=FlashChosenLine_Flash
*$CA1E SET 7,(HL)    ; Set bit 7 of the attribute.
 $CA20 JR $CA27      ; Jump to #R$CA27.
@label=FlashChosenLine_Next
*$CA22 DEC A         ; {Jump to #R$CA1E if this is the
 $CA23 JR Z,$CA1E    ; line.}
@label=FlashChosenLine_NoFlash
*$CA25 RES 7,(HL)    ; Reset bit 7 of the attribute.
@label=FlashChosenLine_Skip
*$CA27 INC HL        ; Move on to the next line.
 $CA28 DJNZ $CA22    ; Jump to #R$CA22 until all of the
                     ; lines have been done.
 $CA2A RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$BC15 }
; { #PENTAGRAM$BB64 }
; LIST#

; Display Menu
;
; Used by the routine at #R$C8CA.
; .
; Prints the eight lines of the game selection menu. The first time that
; it is called it also draws the frame around the screen.
;
; .
;
; Point at the menu colours,
; positions and text.
@label=DisplayMenu
c$CA2B LD DE,$C962   ; Point #REGde at #R$C962.
 $CA2E EXX           ; Switch to the shadow registers.
 $CA2F LD HL,$C96A   ; Point #REGhl at #R$C96A.
 $CA32 LD DE,$C97A   ; Point #REGde at #R$C97A.
 $CA35 LD B,$08      ; Set the number of lines to #N$08.
; Print one line from the three lists.
@label=DisplayMenu_Loop
*$CA37 LD A,(HL)     ; Fetch the x position.
 $CA38 INC HL        ; {Move on to the next pair of
 $CA39 INC HL        ; positions.}
 $CA3A PUSH HL       ; Stash the address of the next pair
                     ; on the stack.
 $CA3B DEC HL        ; Point #REGhl at the y position.
 $CA3C LD H,(HL)     ; Fetch the y position.
 $CA3D LD L,A        ; Set the x position.
 $CA3E EXX           ; Switch to the shadow registers.
 $CA3F LD A,(DE)     ; Fetch the attribute of the line.
 $CA40 INC DE        ; Move on to the next attribute.
 $CA41 EX AF,AF'     ; Keep the attribute in #REGaf'.
 $CA42 EXX           ; Switch back to the main registers.
 $CA43 CALL $C9EF    ; Call #R$C9EF.
 $CA46 POP HL        ; Restore the address of the next
                     ; pair from the stack.
 $CA47 DJNZ $CA37    ; Jump to #R$CA37 until all of the
                     ; lines have been printed.
; Draw the frame the first time.
 $CA49 LD A,($BBBF)  ; {Return if #R$BBBF is set.
 $CA4C AND A         ;
 $CA4D RET NZ        ; }
 $CA4E INC A         ; {Write #N$01 to *#R$BBBF.
 $CA4F LD ($BBBF),A  ; }
 $CA52 JP $CA9D      ; Jump to #R$CA9D.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$BC25 }
; { #KNIGHTLORE$BEB3 }
; { #PENTAGRAM$BCB4 }
; LIST#
; .
; #PUSHS #UDGTABLE { =h Before | =h After #R$CA2B }
; { #SIM(start=$BE04,stop=$BE18,sp=$5E00,r=$80,clear=1)
; #SIM(start=$BE18,stop=$BE24)
; #SCR$02(print-menu-lines-before)
; | #SIM(start=$CA2B,stop=$0000,sp=$5BF0)
; #SCR$02(print-menu-lines-after) } UDGTABLE# #POPS

; Draw Playing Area Border
;
; Used by the routine at #R$BDFE.
; .
; Draws the border around the playing area, in yellow on red.
; .
; #PUSHS #UDGTABLE { =h After #R$CA55 }
; { #SIM(start=$BE04,stop=$BE18,sp=$5E00,r=$80,clear=1)
; #SIM(start=$BE18,stop=$BE24)
; #SIM(start=$CA55,stop=$0000,sp=$5BF0)
; #SCR$02,$05,$00,$1A,$12(playing-area-border) } UDGTABLE# #POPS
;
; .
;
; Set the colour and the font.
@label=DrawPlayingAreaBorder
c$CA55 LD A,$16      ; {Use yellow ink on red paper (attribute #N$16), and keep it in
 $CA57 EX AF,AF'     ; #REGaf'.}
 $CA58 LD HL,$BB0A   ; {Set the font to the characters of the border.
 $CA5B LD ($BBAC),HL ; }
 $CA5E LD DE,$CAE5   ; Point at the characters of the border.
; Draw the four corners.
 $CA61 LD HL,$4005   ; {Draw the top left corner at #N$4005 (in the screen
 $CA64 CALL $CB3E    ; buffer).}
 $CA67 LD HL,$401D   ; {Draw the top right corner at #N$401D (in the screen
 $CA6A CALL $CB3E    ; buffer).}
 $CA6D LD HL,$5005   ; {Draw the bottom left corner at #N$5005 (in the screen
 $CA70 CALL $CB3E    ; buffer).}
 $CA73 LD HL,$501D   ; {Draw the bottom right corner at #N$501D (in the screen
 $CA76 CALL $CB3E    ; buffer).}
; Draw the top and bottom edges.
 $CA79 LD HL,$4007   ; {Draw the top edge, eleven blocks long, at
 $CA7C LD B,$0B      ; #N$4007 (in the screen buffer).
 $CA7E CALL $CAFD    ; }
 $CA81 LD HL,$5007   ; {Draw the bottom edge, eleven blocks long, at
 $CA84 LD B,$0B      ; #N$5007 (in the screen buffer).
 $CA86 CALL $CAFD    ; }
; Draw the sides.
 $CA89 INC DE        ; {Point at the characters of the sides.
 $CA8A INC DE        ;
 $CA8B INC DE        ;
 $CA8C INC DE        ; }
 $CA8D LD HL,$4045   ; {Draw the left edge, seven blocks long, at
 $CA90 LD B,$07      ; #N$4045 (in the screen buffer).
 $CA92 CALL $CB09    ; }
 $CA95 LD HL,$405D   ; {Draw the right edge, seven blocks long, at
 $CA98 LD B,$07      ; #N$405D (in the screen buffer).
 $CA9A JP $CB09      ; }

; Draw Frame
;
; Used by the routines at #R$CA2B and #R$CC56.
; .
; Draws the frame around the whole screen, in yellow on blue.
; .
; #PUSHS #UDGTABLE { =h After #R$CA9D }
; { #SIM(start=$BE04,stop=$BE18,sp=$5E00,r=$80,clear=1)
; #SIM(start=$BE18,stop=$BE24)
; #SIM(start=$CA9D,stop=$0000,sp=$5BF0)
; #SCR$02(screen-frame) } UDGTABLE# #POPS
;
; .
;
; Set the colour and the font.
@label=DrawFrame
c$CA9D LD A,$4E      ; {Use bright yellow ink on blue paper (attribute #N$4E), and keep it
 $CA9F EX AF,AF'     ; in #REGaf'.}
 $CAA0 LD HL,$BB0A   ; {Set the font to the characters of the border.
 $CAA3 LD ($BBAC),HL ; }
 $CAA6 LD DE,$CAE5   ; Point at the characters of the border.
; Draw the four corners.
 $CAA9 LD HL,$4000   ; {Draw the top left corner at #N$4000 (in the screen
 $CAAC CALL $CB3E    ; buffer).}
 $CAAF LD HL,$401E   ; {Draw the top right corner at #N$401E (in the screen
 $CAB2 CALL $CB3E    ; buffer).}
 $CAB5 LD HL,$50C0   ; {Draw the bottom left corner at #N$50C0 (in the screen
 $CAB8 CALL $CB3E    ; buffer).}
 $CABB LD HL,$50DE   ; {Draw the bottom right corner at #N$50DE (in the screen
 $CABE CALL $CB3E    ; buffer).}
; Draw the top and bottom edges.
 $CAC1 LD HL,$4002   ; {Draw the top edge, fourteen blocks long, at
 $CAC4 LD B,$0E      ; #N$4002 (in the screen buffer).
 $CAC6 CALL $CAFD    ; }
 $CAC9 LD HL,$50C2   ; {Draw the bottom edge, fourteen blocks long, at
 $CACC LD B,$0E      ; #N$50C2 (in the screen buffer).
 $CACE CALL $CAFD    ; }
; Draw the sides.
 $CAD1 INC DE        ; {Point at the characters of the sides.
 $CAD2 INC DE        ;
 $CAD3 INC DE        ;
 $CAD4 INC DE        ; }
 $CAD5 LD HL,$4040   ; {Draw the left edge, ten blocks long, at
 $CAD8 LD B,$0A      ; #N$4040 (in the screen buffer).
 $CADA CALL $CB09    ; }
 $CADD LD HL,$405E   ; {Draw the right edge, ten blocks long, at
 $CAE0 LD B,$0A      ; #N$405E (in the screen buffer).
 $CAE2 JP $CB09      ; }

; Border Block Characters
;
; The characters that make up the border and the frame: four blocks of two
; by two characters for the corners, one for the top and bottom edges, and one
; for the sides.
@label=BorderBlockCharacters
b$CAE5 DEFB $08,$09,$0A,$0B
 $CAE9 DEFB $09,$0C,$0D,$0E
 $CAED DEFB $0A,$13,$12,$10
 $CAF1 DEFB $0F,$0E,$10,$11
 $CAF5 DEFB $04,$05,$06,$07
 $CAF9 DEFB $00,$01,$02,$03

; Draw Horizontal Edge
;
; Used by the routines at #R$CA55 and #R$CA9D.
; .
; Draws a number of blocks of two by two characters along a row.
;
; A' Attribute
; B Number of blocks
; DE Address of the four characters in a block
; HL Screen address of the first block
@label=DrawHorizontalEdge
c$CAFD PUSH BC       ; {Stash the count and the characters on the
 $CAFE PUSH DE       ; stack.}
 $CAFF CALL $CB3E    ; Call #R$CB3E.
 $CB02 INC L         ; {Move on two positions to the right.
 $CB03 INC L         ; }
 $CB04 POP DE        ; {Restore the count and the characters from the
 $CB05 POP BC        ; stack.}
 $CB06 DJNZ $CAFD    ; Jump to #R$CAFD until all of the
                     ; blocks have been drawn.
 $CB08 RET           ; Return.

; Draw Vertical Edge
;
; Used by the routines at #R$CA55 and #R$CA9D.
; .
; Draws a number of blocks of two by two characters down a column.
;
; A' Attribute
; B Number of blocks
; DE Address of the four characters in a block
; HL Screen address of the first block
@label=DrawVerticalEdge
c$CB09 PUSH BC       ; {Stash the count and the characters on the
 $CB0A PUSH DE       ; stack.}
 $CB0B CALL $CB3E    ; Call #R$CB3E.
 $CB0E CALL $CB71    ; {Move down two rows.
 $CB11 CALL $CB71    ; }
 $CB14 POP DE        ; {Restore the count and the characters from the
 $CB15 POP BC        ; stack.}
 $CB16 DJNZ $CB09    ; Jump to #R$CB09 until all of the
                     ; blocks have been drawn.
 $CB18 RET           ; Return.

; Print Character
;
; Used by the routine at #R$CB5B.
; .
; Prints a character on the screen, using
; the font whose address is held in #R$BBAC.
; A space is drawn as #N($3C), which is blank
; in this font. The eight rows are written
; going down the screen, and the address is
; left at the top of the character.
; .
; #PUSHS #UDGTABLE { =h After #R$CB19 }
; { #SIM(start=$BE04,stop=$BE18,sp=$5E00,r=$80,clear=1)
; #SIM(start=$BE18,stop=$BE24)
; #POKES$BBAC,$5E;$BBAD,$6B
; #SIM(start=$CB19,stop=$0000,a=$41,hl=$40E8,sp=$5BF0)
; #SCR$02,$07,$06,$03,$03(print-character) } UDGTABLE# #POPS
;
;   A The character
;   A' Attribute
;   HL Screen address of the top row
; O:HL Screen address of the top row
;
; Turn a space into the font space.
@label=PrintScreen
c$CB19 CP $20        ; {Jump to #R$CB1F if it is not a space.
 $CB1B JR NZ,$CB1F   ; }
 $CB1D LD A,$3C      ; Use the font space (#N$3C).
; This entry point is used by the routine at #R$C489.
; .
; Find the glyph.
@label=PrintGlyph
*$CB1F PUSH BC       ; {Stash #REGbc, #REGde and the
 $CB20 PUSH DE       ; screen address on the stack.
 $CB21 PUSH HL       ; }
 $CB22 LD L,A        ; {Set #REGhl to the character.
 $CB23 LD H,$00      ; }
 $CB25 ADD HL,HL     ; {Multiply the character by eight.
 $CB26 ADD HL,HL     ;
 $CB27 ADD HL,HL     ; }
; Add the font address.
 $CB28 LD DE,($BBAC) ; Fetch #R$BBAC.
 $CB2C ADD HL,DE     ; Add it to get the glyph address.
 $CB2D EX DE,HL      ; Point #REGde at the glyph.
 $CB2E POP HL        ; Restore the screen address from the stack.
; Copy eight rows down the screen.
 $CB2F LD B,$08      ; Set a counter of #N$08 rows.
@label=PrintGlyph_Loop
*$CB31 LD A,(DE)     ; Fetch a row of the glyph.
 $CB32 INC DE        ; Move on to the next row of the glyph.
 $CB33 LD (HL),A     ; Copy it to the screen.
 $CB34 INC H         ; Move #REGhl down a row.
 $CB35 DJNZ $CB31    ; Jump to #R$CB31 until all eight
                     ; rows have been written.
; Move back to the top of the character.
 $CB37 POP DE        ; {Restore #REGde and #REGbc from the
 $CB38 POP BC        ; stack.}
 $CB39 LD A,H        ; {Move #REGhl back to the top row.
 $CB3A SUB $08       ;
 $CB3C LD H,A        ; }
 $CB3D RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$A1D3 }
; { #COOKIE$7468 }
; { #JETPAC$714C }
; { #LUNARJETMAN$89EF }
; { #MARTIANOIDS$B5CB }
; { #PSSST$73CD }
; { #SABREWULF$B589 }
; { #TRANZAM$6C96 }
; { #UNDERWURLDE$98DF }
; LIST#

; Print Character Block
;
; Used by the routines at #R$C2C8, #R$CA55, #R$CA9D, #R$CAFD, #R$CB09 and
; #R$CC1D.
; .
; Prints a block of four characters, in two rows of two, with the same
; attribute.
;
;   A' Attribute
;   DE Address of the four characters
;   HL Screen address of the top left character
; O:DE Address after the four characters
;
; Print the top row of the block.
@label=PrintCharacterBlock
c$CB3E PUSH HL       ; Stash the screen address on the stack.
 $CB3F LD A,(DE)     ; {Print the top left character and move
 $CB40 INC DE        ; to the right.
 $CB41 CALL $CB5B    ;
 $CB44 INC L         ; }
 $CB45 LD A,(DE)     ; {Print the top right character and
 $CB46 INC DE        ; move back to the left.
 $CB47 CALL $CB5B    ;
 $CB4A DEC L         ; }
; Print the bottom row of the block.
 $CB4B CALL $CB71    ; Call #R$CB71.
 $CB4E LD A,(DE)     ; {Print the bottom left character and
 $CB4F INC DE        ; move to the right.
 $CB50 CALL $CB5B    ;
 $CB53 INC L         ; }
 $CB54 LD A,(DE)     ; {Print the bottom right character.
 $CB55 INC DE        ;
 $CB56 CALL $CB5B    ; }
 $CB59 POP HL        ; Restore the screen address from the
                     ; stack.
 $CB5A RET           ; Return.

; Print Character With Attribute
;
; Used by the routines at #R$C29A, #R$C314, #R$C83F, #R$C9EF and #R$CB3E.
; .
; Prints a character on the screen and
; sets its attribute.
;
; A The character
; A' Attribute
; HL Screen address
;
; Print the pixels, then the attribute.
@label=PrintCharacterWithAttribute
c$CB5B CALL $CB19    ; Call #R$CB19.
 $CB5E PUSH DE       ; {Stash #REGde and #REGhl on the
 $CB5F PUSH HL       ; stack.}
 $CB60 LD A,H        ; Copy the high byte of the screen
                     ; address.
 $CB61 RRCA          ; {Move it into the attribute file
 $CB62 RRCA          ; range.
 $CB63 RRCA          ; }
 $CB64 AND %00000011 ; Keep bits 0 and 1.
 $CB66 LD H,A        ; Set the high byte.
 $CB67 LD DE,$5800   ; Set #REGde to #N$5800.
 $CB6A ADD HL,DE     ; Add it to get the attribute
                     ; address.
 $CB6B EX AF,AF'     ; Switch to #REGaf'.
 $CB6C LD (HL),A     ; Set the attribute of the character.
 $CB6D EX AF,AF'     ; Switch back.
 $CB6E POP HL        ; {Restore #REGhl and #REGde from the
 $CB6F POP DE        ; stack.}
 $CB70 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$D639 }
; LIST#

; Move Down Row
;
; Used by the routines at #R$C489, #R$C83F, #R$CB09, #R$CB3E and #R$CC1D.
; .
; Moves a screen address down by one character row.
;
;   HL The screen address
; O:HL The new screen address
@label=MoveDownRow
c$CB71 LD A,L        ; {Add thirty-two to the low byte.
 $CB72 ADD A,$20     ;
 $CB74 LD L,A        ; }
 $CB75 RET NC        ; Return if it has not gone into the
                     ; next third.
 $CB76 LD A,H        ; {Add eight to the high byte.
 $CB77 ADD A,$08     ;
 $CB79 LD H,A        ; }
 $CB7A RET           ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$D64F }
; { #MARTIANOIDS$B6B2 }
; { #UNDERWURLDE$98D5 }
; LIST#

; Choose Start Position
;
; Used by the routine at #R$BDFE.
; .
; Chooses a random cell of the village for the player to start in,
; avoiding cells that are solid (tiles #N$01 and #N$02), and stores its column
; and row in the template for the player at #R$CC36.
;
; .
;
; Pick a random cell that is not solid.
@label=ChooseStartPosition
c$CB7B CALL $C5BB    ; Update the random number generator.
 $CB7E LD DE,($BBAA) ; Fetch the random number.
@label=ChooseStartPosition_Cell
*$CB82 LD A,D        ; {Turn the random number into a place in the map of the
 $CB83 AND $03       ; village.
 $CB85 LD D,A        ; }
 $CB86 LD HL,$5E04   ; {Find the tile in the map.
 $CB89 ADD HL,DE     ; }
 $CB8A LD A,(HL)     ; {Jump to #R$CB93 to use this cell unless the tile is solid
 $CB8B DEC A         ; (#N$01 or #N$02).
 $CB8C CP $02        ;
 $CB8E JR NC,$CB93   ; }
 $CB90 INC DE        ; {Otherwise move on to the next cell and try again.
 $CB91 JR $CB82      ; }
; Store the column and the row in the template.
@label=ChooseStartPosition_Found
*$CB93 LD A,E        ; {Store the column of the cell in the template for the
 $CB94 AND $1F       ; player.
 $CB96 LD ($CC38),A  ; }
 $CB99 RL E          ; {Shift the place in the map left three times, which moves the row of
 $CB9B RL D          ; the cell into the lowest five bits of #REGd.
 $CB9D RL E          ;
 $CB9F RL D          ;
 $CBA1 RL E          ;
 $CBA3 RL D          ; }
 $CBA5 LD A,D        ; {Store the row of the cell in the template for the
 $CBA6 AND $1F       ; player.
 $CBA8 LD ($CC3A),A  ; }
 $CBAB RET           ; Return.

; Check Player Dead
;
; Used by the routine at #R$BDFE.
; .
; Checks whether the player has died. If so, a new life is started (or the
; game is over if there are no lives left).
; .
; The routine also checks that the instruction at #R$CBDD has not been changed,
; which is part of the copy protection. The computer is reset if it has been.
@label=CheckPlayerDead
c$CBAC LD A,($BC8E)  ; {Return if the player is still alive.
 $CBAF AND A         ;
 $CBB0 RET NZ        ; }
; See #POKE(infinite_lives,Infinite Lives).
 $CBB1 LD A,($CBDD)  ; {Fetch the opcode of the instruction at #R$CBDD, and reset the
 $CBB4 CP $35        ; computer by jumping to #R$C1F9 unless it is #N$35 (DEC (HL)).
 $CBB6 JP NZ,$C1F9   ; }
 $CBB9 LD A,($BBCD)  ; {Fetch the number of lives left and jump to #R$CBC5 to start a new
 $CBBC AND A         ; life if there are none.
 $CBBD JR Z,$CBC5    ; }
 $CBBF LD DE,$C839   ; {Play the tune for losing a life.
 $CBC2 CALL $C656    ; }

; Start New Life
;
; Used by the routines at #R$BDFE and #R$CBAC.
; .
; Starts a new life for the player: sets up the objects for the player,
; sets the player's health, uses up a life and shows the lives that are left.
; The game is over when no lives are left.
@label=StartNewLife
c$CBC5 LD HL,$CC36   ; {Copy the template for the two objects that make up the player
 $CBC8 LD DE,$BC8E   ; (legs and body) into the object table.
 $CBCB LD BC,$0020   ;
 $CBCE LDIR          ; }
 $CBD0 LD A,$28      ; {Set the player's materialise timer to #N$28.
 $CBD2 LD ($BC02),A  ; }
 $CBD5 LD A,$03      ; {Give the player #N$03 health.
 $CBD7 LD ($BBF3),A  ; }
; See #POKE(infinite_lives,Infinite Lives).
 $CBDA LD HL,$BBCD   ; {Use up a life, and jump to #R$CC56 if there were none
 $CBDD DEC (HL)      ; left.
 $CBDE JP M,$CC56    ; }
 $CBE1 CALL $C057    ; Remove the ghosts and other short-lived objects.
 $CBE4 LD IX,$BC8E   ; {Point #REGix at the player and mark the cell that the player starts
 $CBE8 CALL $BF56    ; in as visited.}
; Draw the lives that are left.
 $CBEB LD HL,$7AEF   ; {Set the font to the knight icons, and use bright white ink
 $CBEE LD ($BBAC),HL ; (attribute #N$47).
 $CBF1 LD A,$47      ;
 $CBF3 EX AF,AF'     ; }
 $CBF4 LD DE,$CC2E   ; {Point at the characters of an icon, and set the
 $CBF7 LD HL,$5045   ; screen address of the first icon to #N$5045
                     ; (in the screen buffer).}
 $CBFA LD A,($BBCD)  ; {Find the number of lives left, and work out the number of lives that
 $CBFD LD B,A        ; have been used (#N$05 minus the lives left).
 $CBFE NEG           ;
 $CC00 ADD A,$05     ;
 $CC02 LD C,A        ; }
@label=StartNewLife_LifeLoop
*$CC03 LD A,B        ; {Jump to #R$CC0E if there are no more lives left to
 $CC04 AND A         ; draw.
 $CC05 JR Z,$CC0E    ; }
 $CC07 CALL $CC1D    ; {Draw an icon, move on two positions and loop back until all of the
 $CC0A INC L         ; lives left have been drawn.
 $CC0B INC L         ;
 $CC0C DJNZ $CC03    ; }
@label=StartNewLife_UsedLives
*$CC0E LD A,$41      ; {Use blue ink (attribute #N$41) for the lives that have
 $CC10 EX AF,AF'     ; been used.}
 $CC11 LD A,C        ; {Return if no lives have been used.
 $CC12 AND A         ;
 $CC13 RET Z         ; }
 $CC14 LD B,A        ; Set a counter for the lives that have been used.
@label=StartNewLife_UsedLoop
*$CC15 CALL $CC1D    ; {Draw an icon, move on two positions and loop back until all of the
 $CC18 INC L         ; used lives have been drawn.
 $CC19 INC L         ;
 $CC1A DJNZ $CC15    ; }
 $CC1C RET           ; Return.

; Draw Life Icon
;
; Used by the routine at #R$CBC5.
; .
; Draws the icon of a knight that shows a life, which is two blocks of two
; by two characters, one above the other.
; .
; #PUSHS #UDGTABLE { =h After #R$CC1D }
; { #SIM(start=$BE04,stop=$BE18,sp=$5E00,r=$80,clear=1)
; #SIM(start=$BE18,stop=$BE24)
; #POKES$BBAC,$EF;$BBAD,$7A
; #SIM(start=$CC1D,stop=$0000,xa=$47,de=$CC2E,hl=$5060,sp=$5BF0)
; #SCR$02,$00,$12,$03,$05(life-icon) } UDGTABLE# #POPS
;
; A' Attribute
; DE Address of the characters
; HL Screen address
;
; Draw the top block, then the bottom block.
@label=DrawLifeIcon
c$CC1D PUSH DE       ; {Stash the address of the characters and the screen address on the
 $CC1E PUSH HL       ; stack.}
 $CC1F CALL $CB3E    ; Draw the top block.
 $CC22 CALL $CB71    ; {Move down two rows.
 $CC25 CALL $CB71    ; }
 $CC28 CALL $CB3E    ; Draw the bottom block.
 $CC2B POP HL        ; {Get the address of the characters and the screen address back, and
 $CC2C POP DE        ; return.
 $CC2D RET           ; }

; Life Icon Characters
;
; The characters of the two blocks that make up a life icon.
@label=LifeIconCharacters
b$CC2E DEFB $00,$01,$02,$03
 $CC32 DEFB $04,$05,$06,$07

; Player Template
;
; The initial state of the two objects that make up the player, copied
; into the object table by #R$CBC5 (see #R$BC8E for the fields). The column and
; the row of the first object are set by #R$CB7B before it is used.
; .
; The first object is the player's legs and the second is the body.
@label=PlayerTemplate
b$CC36 DEFB $18,$80,$00,$80,$00,$00,$40,$00,$10,$10,$00,$00,$F4,$02,$00,$00 ; The legs
                                                                            ; (type
                                                                            ; #N$18).
 $CC46 DEFB $20,$00,$00,$00,$00,$00,$00,$00,$10,$10,$00,$00,$F4,$0D,$00,$00 ; The body
                                                                            ; (type
                                                                            ; #N$20).

; Game Over
;
; Used by the routines at #R$CBC5 and #R$D865.
; .
; Shows the game over screen, with the percentage of the game that has
; been completed and the score, and plays a tune. A new game is started if any
; of the monsters is still alive. Otherwise all of the monsters have been
; killed, so the ending is shown.
; .
; #PUSHS #UDGTABLE { #SIM(start=$BE04,stop=$BE18,sp=$5E00,r=$80,clear=1)
; #SIM(start=$BE18,stop=$BE24)
; #POKES$BBFE,$37;$BBC9,$00;$BBCA,$12;$BBCB,$30
; #SIM(start=$CC56,stop=$CC8C,sp=$5BF0)
; #SCR$02(game-over) } UDGTABLE# #POPS
;
; .
;
; Show the game over screen.
@label=GameOver
c$CC56 CALL $BEDF    ; Work out the percentage of the game that has been
                     ; completed.
 $CC59 CALL $E59D    ; {Clear the screen and draw the frame.
 $CC5C CALL $CA9D    ; }
 $CC5F LD HL,$8758   ; {Print "GAME OVER".
 $CC62 LD DE,$CDAF   ;
 $CC65 CALL $C9FC    ; }
 $CC68 LD HL,$6F38   ; {Print "PERCENTAGE OF GAME".
 $CC6B CALL $C9FC    ; }
 $CC6E LD HL,$5F48   ; {Print "COMPLETED =".
 $CC71 CALL $C9FC    ; }
 $CC74 LD HL,$4748   ; {Print "SCORE".
 $CC77 CALL $C9FC    ; }
 $CC7A LD HL,$4894   ; {Use bright cyan ink (attribute #N$45), and print
 $CC7D LD A,$45      ; the percentage at #N$4894 (in the screen buffer).
 $CC7F EX AF,AF'     ;
 $CC80 CALL $BF36    ; }
 $CC83 LD HL,$48F0   ; {Use bright yellow ink (attribute #N$46), and print
 $CC86 LD A,$46      ; the score at #N$48F0 (in the screen buffer).
 $CC88 EX AF,AF'     ;
 $CC89 CALL $C305    ; }
; Play the tune.
 $CC8C LD DE,$C803   ; {Play the game over tune.
 $CC8F CALL $C656    ; }
 $CC92 LD B,$04      ; {Wait for about half a second.
 $CC94 CALL $CDDF    ; }
; Start a new game if any of the monsters is still alive.
 $CC97 LD HL,$BD5E   ; {Point at the first monster, set the distance from one object to the
 $CC9A LD DE,$0010   ; next (#N$0010 bytes) and set a counter for the four monsters.
 $CC9D LD B,$04      ; }
@label=GameOver_CheckMonsters
*$CC9F LD A,(HL)     ; {Start a new game, keeping the settings, if this monster is still
 $CCA0 SUB $60       ; alive.
 $CCA2 CP $10        ;
 $CCA4 JP C,$BE0F    ; }
 $CCA7 ADD HL,DE     ; {Move on to the next monster and loop back until all four have been
 $CCA8 DJNZ $CC9F    ; checked.}
; All four monsters have been killed. Set up the ending.
 $CCAA CALL $CD02    ; Remove all of the objects.
 $CCAD LD IX,$BC8E   ; {Point #REGix at the first object, point at the table of pieces for
 $CCB1 LD HL,$CCE4   ; the ending, set the distance from one object to the next (#N$0010 bytes) and
 $CCB4 LD DE,$0010   ; set a counter for ten pieces.
 $CCB7 LD B,$0A      ; }
@label=GameOver_Pieces
*$CCB9 LD A,(HL)     ; {Set the type and the velocities of a piece, clear its flags and
 $CCBA INC HL        ; offsets, and loop back until all ten pieces have been set up.
 $CCBB LD (IX+$00),A ;
 $CCBE LD A,(HL)     ;
 $CCBF INC HL        ;
 $CCC0 LD (IX+$0A),A ;
 $CCC3 LD A,(HL)     ;
 $CCC4 INC HL        ;
 $CCC5 LD (IX+$0B),A ;
 $CCC8 XOR A         ;
 $CCC9 LD (IX+$07),A ;
 $CCCC LD (IX+$0C),A ;
 $CCCF LD (IX+$0D),A ;
 $CCD2 ADD IX,DE     ;
 $CCD4 DJNZ $CCB9    ; }
 $CCD6 CALL $E59D    ; Clear the screen.
 $CCD9 LD A,$01      ; {Flag that the game has been finished.
 $CCDB LD ($BBFF),A  ; }
 $CCDE CALL $E206    ; Clear the playing area.
 $CCE1 JP $BE71      ; Jump to #R$BE71 to show the ending.

; Ending Pieces
;
; The ten objects of the ending, used by #R$CC56. Each has a type, and the
; X and Y screen position that is stored in the fields at offsets #N$0A and
; #N$0B.
; .
; The first five are the pieces of the title graphic in a row, then four ghosts,
; then the large piece of the title graphic.
@label=EndingPieces
b$CCE4 DEFB $99,$50,$60
 $CCE7 DEFB $9A,$60,$60
 $CCEA DEFB $9B,$70,$60
 $CCED DEFB $9C,$80,$60
 $CCF0 DEFB $9D,$90,$60
 $CCF3 DEFB $90,$10,$80
 $CCF6 DEFB $92,$D0,$80
 $CCF9 DEFB $94,$10,$80
 $CCFC DEFB $96,$D0,$80
 $CCFF DEFB $98,$60,$48

; Remove All Objects
;
; Used by the routine at #R$CC56.
; .
; Removes every object by setting the types of all #N$17 objects to zero.
@label=RemoveAllObjects
c$CD02 LD HL,$BC8E   ; {Point at the object table, set the distance from one object to the
 $CD05 LD DE,$0010   ; next (#N$0010 bytes) and set a counter for the #N$17 objects.
 $CD08 LD B,$17      ; }
@label=RemoveAllObjects_Loop
*$CD0A LD (HL),$00   ; {Remove an object, and loop back until all of them have
 $CD0C ADD HL,DE     ; been removed.
 $CD0D DJNZ $CD0A    ; }
 $CD0F RET           ; Return.

; Update Logo Piece
;
; The routine for objects of type #N$98 to #N($9D), the
; pieces of the title graphic that are shown during the
; ending. Each piece stays where it was
; placed. It is drawn, and its attributes are set to bright white.
; .
; The large piece (type #N$98) is the last piece in the object table, and waits
; for the ghosts before it: when the object before it has gone, the ending is
; over and the game starts again.
; .
; #PUSHS #UDGTABLE { #SIM(start=$BE04,stop=$BE18,sp=$5E00,r=$80,clear=1)
; #SIM(start=$BE18,stop=$BE24)
; #SIM(start=$BE2D,stop=$BE71)
; #SIM(start=$CCAA,stop=$CCE1,sp=$5BF0)
; #SIM(start=$CD16,stop=$0000,ix=$BC8E,sp=$5BF0)
; #SIM(start=$CD16,stop=$0000,ix=$BC9E,sp=$5BF0)
; #SIM(start=$CD16,stop=$0000,ix=$BCAE,sp=$5BF0)
; #SIM(start=$CD16,stop=$0000,ix=$BCBE,sp=$5BF0)
; #SIM(start=$CD16,stop=$0000,ix=$BCCE,sp=$5BF0)
; #SIM(start=$CD16,stop=$0000,ix=$BD1E,sp=$5BF0)
; #SIM(start=$E200,stop=$0000,sp=$5BF0)
; #SCR$02(ending-logo) } UDGTABLE# #POPS
@label=UpdateLogoPiece
c$CD10 LD A,(IX-$10) ; {Jump to #R$CD4F if the object before this one has gone, which means
 $CD13 AND A         ; the ending is over.
 $CD14 JR Z,$CD4F    ; }
; The smaller pieces start here, as they do not wait.
@label=UpdateLogoPiece_Small
 $CD16 LD A,$47      ; {Use bright white ink (attribute #N$47).
 $CD18 LD ($BC00),A  ; }
; This entry point is used by the routine at #R$CD58.
; .
; Draw the piece, and set its attributes.
@label=UpdateLogoPiece_Draw
*$CD1B LD A,(IX+$0A) ; {Copy the X and Y position of the piece
 $CD1E LD (IX+$0E),A ; (kept where the velocities usually are) into the position of the sprite.
 $CD21 LD A,(IX+$0B) ;
 $CD24 LD (IX+$0F),A ; }
 $CD27 CALL $E3FF    ; Draw the sprite.
 $CD2A LD L,(IX+$0E) ; {Fetch the screen position of the sprite.
 $CD2D LD H,(IX+$0F) ; }
 $CD30 CALL $E579    ; Turn the position into an address in the attribute
                     ; buffer.
 $CD33 LD A,($BBC3)  ; {Fetch the number of rows of the sprite that were drawn.
 $CD36 LD C,A        ; }
 $CD37 LD A,(IX+$0B) ; {Add the position of the sprite within a
 $CD3A AND $07       ; character cell and #N($05), to get the height of the
 $CD3C ADD A,C       ; sprite in pixels.
 $CD3D ADD A,$05     ; }
 $CD3F RRCA          ; {Divide by eight to get the height in characters.
 $CD40 RRCA          ;
 $CD41 RRCA          ;
 $CD42 AND $1F       ;
 $CD44 LD C,A        ; }
 $CD45 LD A,($BBC2)  ; {Fetch the width of the sprite in characters.
 $CD48 LD B,A        ; }
 $CD49 LD A,($BC00)  ; Fetch the attribute.
 $CD4C JP $C8B2      ; Jump to #R$C8B2.
; The ending is over.
@label=UpdateLogoPiece_Finished
*$CD4F LD DE,$C81A   ; {Play the tune for completing the game, and start a new
 $CD52 CALL $C656    ; game.
 $CD55 JP $BE0F      ; }

; Update Ending Ghost
;
; The routine for objects of type #N$90 to #N($97), the ghosts that are
; shown during the ending. A ghost moves sideways towards the large piece of the
; title graphic, and then drops down the screen and goes away. It does not start
; until the ghost before it has gone.
;
; .
;
; Wait for the previous ghost, then move sideways.
@label=UpdateEndingGhost
c$CD58 LD A,(IX+$00)  ; {Flip the sprite of the ghost to its other frame.
 $CD5B XOR $01        ;
 $CD5D LD (IX+$00),A  ; }
 $CD60 LD A,(IX-$10)  ; {Return if the object before this one is a ghost that
 $CD63 SUB $90        ; is still there.
 $CD65 CP $08         ;
 $CD67 RET C          ; }
 $CD68 CALL $C39D     ; Play a tone that falls in pitch each time.
 $CD6B LD A,($BD28)   ; {Work out how far the ghost is from the middle of the large piece of
 $CD6E ADD A,$04      ; the title graphic (plus #N$04), limited to four pixels.
 $CD70 CALL $CD9E     ; }
 $CD73 AND A          ; {Jump to #R$CD8A if the ghost has arrived.
 $CD74 JR Z,$CD8A     ; }
 $CD76 ADD A,(IX+$0A) ; {Move the ghost sideways by that amount.
 $CD79 LD (IX+$0A),A  ; }
; Draw the ghost.
@label=UpdateEndingGhost_Draw
*$CD7C LD A,(IX+$00)  ; {Set the colour of the ghost from its sprite
 $CD7F RRCA           ; (bright red, magenta, green or cyan).
 $CD80 AND $03        ;
 $CD82 ADD A,$42      ;
 $CD84 LD ($BC00),A   ; }
 $CD87 JP $CD1B       ; Draw the ghost.
; Drop the ghost down the screen.
@label=UpdateEndingGhost_Drop
*$CD8A LD A,(IX+$0B)  ; {Move the ghost down the screen by four pixels, and jump to #R$CD7C
 $CD8D SUB $04        ; to draw it unless it has reached the bottom.
 $CD8F LD (IX+$0B),A  ;
 $CD92 CP $30         ;
 $CD94 JR NC,$CD7C    ; }
 $CD96 XOR A          ; {Stop the falling tone and remove the ghost.
 $CD97 LD ($BBF9),A   ;
 $CD9A LD (IX+$00),A  ;
 $CD9D RET            ; }

; Limit Distance
;
; Used by the routine at #R$CD58.
; .
; Subtracts a position from a target and limits the difference to four
; pixels in either direction.
;
;   A Target position
;   IX Object
; O:A The distance to move, from #N$FC to #N$04
@label=LimitDistance
c$CD9E SUB (IX+$0A)  ; {Work out how far the object is from the target along the X axis, and
 $CDA1 JR C,$CDA9    ; jump to #R$CDA9 if the target is on the left.}
 $CDA3 CP $04        ; {Return if the distance is less than four.
 $CDA5 RET C         ; }
 $CDA6 LD A,$04      ; {Limit the distance to four and return.
 $CDA8 RET           ; }
@label=LimitDistance_Negative
*$CDA9 CP $FC        ; {Return if the distance is #N$FC or more, which means it is less than
 $CDAB RET NC        ; four to the left.}
 $CDAC LD A,$FC      ; {Limit the distance to minus four and return.
 $CDAE RET           ; }

; Messaging: Game Over Text
;
; The strings that are shown on the game over screen. Each string starts
; with its attribute.
@label=GameOverText
t$CDAF DEFM $47                         ; {Attribute: #COLOUR(#PEEK(#PC)) +
 $CDB0 DEFM "GAME  OVE","R"+$80         ; "GAME  OVER".}
 $CDBA DEFM $45                         ; {Attribute: #COLOUR(#PEEK(#PC)) +
 $CDBB DEFM "PERCENTAGE OF GAM","E"+$80 ; "PERCENTAGE OF GAME".}
 $CDCD DEFM $45                         ; {Attribute: #COLOUR(#PEEK(#PC)) +
 $CDCE DEFM "COMPLETED ","="+$80        ; "COMPLETED =".}
 $CDD9 DEFM $46                         ; {Attribute: #COLOUR(#PEEK(#PC)) +
 $CDDA DEFM "SCOR","E"+$80              ; "SCORE".}

; Pause For Half A Second
;
; Used by the routine at #R$CC56.
; .
; Waits for about half a second.
@label=Wait
c$CDDF LD HL,$0000   ; Set the counter to zero, so that it counts down #N$10000
                     ; times.
@label=Wait_Loop
*$CDE2 DEC HL        ; {Count down until the counter is zero.
 $CDE3 LD A,H        ;
 $CDE4 OR L          ;
 $CDE5 JR NZ,$CDE2   ; }
 $CDE7 RET           ; Return.

; Spawn Ball
;
; Used by the routine at #R$BDFE.
; .
; Starts a ball (a type #N$80 object, which turns into a creature - see
; #R$C164) in one of the short-lived objects at #R$BD9E. It is done on every
; fourth frame, once the player has finished materialising, and the ball is
; placed in a cell that is next to the player or the same one as the player, as
; long as that cell is not solid.
@label=SpawnBall
c$CDE8 LD A,($BC02)   ; {Return unless the player has finished materialising.
 $CDEB CP $70         ;
 $CDED RET NZ         ; }
 $CDEE LD A,($BBB2)   ; {Return unless this is the fourth frame
 $CDF1 CPL            ; (the frame counter is #N$03 modulo four).
 $CDF2 AND $03        ;
 $CDF4 RET NZ         ; }
 $CDF5 LD IY,$BD9E    ; {Point at the first short-lived object, set the distance from one
 $CDF9 LD DE,$0010    ; object to the next (#N$0010 bytes) and set a counter for the six objects.
 $CDFC LD B,$06       ; }
@label=SpawnBall_Loop
*$CDFE LD A,(IY+$00)  ; {Jump to #R$CE09 if the object is free.
 $CE01 AND A          ;
 $CE02 JR Z,$CE09     ; }
 $CE04 ADD IY,DE      ; {Move on to the next object and loop back until all six have been
 $CE06 DJNZ $CDFE     ; checked.}
 $CE08 RET            ; Return, as there is no free object.
@label=SpawnBall_Found
*$CE09 LD HL,$CE79    ; Point at the template for a ball.
 $CE0C PUSH IY        ; {Point #REGde at the free object (using the stack).
 $CE0E POP DE         ; }
 $CE0F LD BC,$0010    ; {Copy the template into the object.
 $CE12 LDIR           ; }
; Choose the cell for the ball: the player's cell, with the column and row
; each moved by one cell, or not moved, using the random seeds.
 $CE14 LD A,($BC90)   ; {Fetch the column and row of the player's cell.
 $CE17 LD L,A         ;
 $CE18 LD A,($BC92)   ;
 $CE1B LD H,A         ; }
 $CE1C LD A,($BBAA)   ; {Jump to #R$CE2A to keep the column as it is if the first random
 $CE1F CP $55         ; number is less than #N$55.
 $CE21 JR C,$CE2A     ; }
 $CE23 CP $AA         ; {Jump to #R$CE29 to move the ball on one column if the number is less
 $CE25 JR C,$CE29     ; than #N$AA.}
 $CE27 DEC L          ; {Move the ball back one column...
 $CE28 DEC L          ; }
@label=SpawnBall_NextColumn
*$CE29 INC L          ; ... or on one column.
@label=SpawnBall_Row
*$CE2A LD A,($BBAB)   ; {Jump to #R$CE38 to keep the row as it is if the second random number
 $CE2D CP $55         ; is less than #N$55.
 $CE2F JR C,$CE38     ; }
 $CE31 CP $AA         ; {Jump to #R$CE37 to move the ball on one row if the number is less
 $CE33 JR C,$CE37     ; than #N$AA.}
 $CE35 DEC H          ; {Move the ball back one row...
 $CE36 DEC H          ; }
@label=SpawnBall_NextRow
*$CE37 INC H          ; ... or on one row.
@label=SpawnBall_Place
*$CE38 LD A,L         ; {Wrap the column round, to stay within the village.
 $CE39 AND $1F        ;
 $CE3B LD L,A         ; }
 $CE3C LD A,H         ; {Wrap the row round, to stay within the village.
 $CE3D AND $1F        ;
 $CE3F LD H,A         ; }
 $CE40 PUSH HL        ; {Find out what kind of tile is in the cell.
 $CE41 CALL $E051     ;
 $CE44 POP HL         ; }
 $CE45 DEC A          ; {Return without making a ball if the tile is solid
 $CE46 CP $02         ; (#N$01 or #N$02).
 $CE48 RET C          ; }
 $CE49 LD (IY+$02),L  ; {Set the column and the row of the ball.
 $CE4C LD (IY+$04),H  ; }
; Choose the position of the ball within the cell using the random seeds.
 $CE4F CALL $C5BB     ; Update the random number generator.
 $CE52 LD A,($BBAA)   ; {Fetch the first random number and jump to #R$CE5B if it is less than
 $CE55 CP $C0         ; #N$C0.
 $CE57 JR C,$CE5B     ; }
 $CE59 SUB $40        ; Bring the number into the range #N$80 to #N$BF.
@label=SpawnBall_X
*$CE5B ADD A,$20      ; {Add #N$20 to get a position within the cell from
 $CE5D LD (IY+$01),A  ; #N$20 to #N($DF), and set it as the X position of the ball.
                      ; }
 $CE60 LD A,($BBAB)   ; {Fetch the second random number and jump to #R$CE69 if it is less
 $CE63 CP $C0         ; than #N$C0.
 $CE65 JR C,$CE69     ; }
 $CE67 SUB $40        ; Bring the number into the range #N$80 to #N$BF.
@label=SpawnBall_Y
*$CE69 ADD A,$20      ; {Add #N$20 to get a position within the cell from
 $CE6B LD (IY+$03),A  ; #N$20 to #N($DF), and set it as the Y position of the ball.
                      ; }
 $CE6E LD A,($BBB2)   ; {Return if the frame counter is #N$80 or more.
 $CE71 CP $80         ;
 $CE73 RET NC         ; }
 $CE74 SET 5,(IY+$07) ; {Set the flag that makes the ball chase the player, and
 $CE78 RET            ; return.}

; Ball Template
;
; The initial state of a ball, copied into the object table by #R$CDE8
; (see #R$BC8E for the fields). The type is #N($80), the speed is #N$06 and the
; size is #N$10 by #N$10.
@label=BallTemplate
b$CE79 DEFB $80,$00,$00,$00,$00,$06,$00,$00,$10,$10,$00,$00,$F4,$04,$00,$00

; Update Spore
;
; The routine for objects of type #N$40 to #N($4F), the spores. A spore
; wanders about at random, and vanishes when the player is more than three cells
; away. If a shot hits it, both the spore and the shot burst. If the player
; touches it, the spore bursts and the player is hurt. Either way, #N$05 hundred
; points are added to the score.
;
; .
;
; Wander, then flip the sprite if the view is turned.
@label=UpdateSpore
c$CE89 LD B,$07      ; Use #N$07 as the number of random bits for the velocity.
 $CE8B CALL $DDCF    ; Choose a new random velocity when the timer has run out.
 $CE8E CALL $DE0D    ; Make the spore face the way that it is moving.
 $CE91 CALL $DD01    ; Move the spore.
 $CE94 CALL $CEF8    ; Animate the spore.
 $CE97 LD A,($BBBA)  ; {Check whether the view is turned round, to flip the
 $CE9A RRCA          ; sprite to match.
 $CE9B RRCA          ;
 $CE9C AND $40       ;
 $CE9E LD C,A        ; }
 $CE9F LD A,(IX+$07) ; {Set or clear the flip flag of the spore.
 $CEA2 AND $BF       ;
 $CEA4 OR C          ;
 $CEA5 LD (IX+$07),A ; }
; Vanish, burst, or hurt the player.
 $CEA8 LD C,$03      ; {Set the distance to #N$03 cells and check whether the spore is that
 $CEAA CALL $C069    ; close to the player.}
 $CEAD JR NC,$CEF3   ; Jump to #R$CEF3 to remove the spore if it is further
                     ; away.
 $CEAF CALL $C538    ; {Check whether a shot has hit the spore, and jump to #R$CEE5 if it
 $CEB2 JR C,$CEE5    ; has.}
 $CEB4 CALL $C55F    ; {Check whether the spore is touching the player, and return if it is
 $CEB7 RET NC        ; not.}
 $CEB8 CALL $CEED    ; Add the points for the spore to the score.

; Hurt Player
;
; Used by the routines at #R$BFF1 and #R$C083.
; .
; Turns the object that has touched the player into a burst, and takes one
; point of health from the player. When the player has no health left, the
; player dies.
;
; IX Object that touched the player
@label=HurtPlayer
c$CEBB LD (IX+$00),$0C ; Turn the object that touched the player into a burst.
; See #POKE(infinite_health,Infinite Health).
 $CEBF LD HL,$BBF3     ; {Take one point of health from the player, and return if there is
 $CEC2 DEC (HL)        ; some left.
 $CEC3 RET NZ          ; }
; Continue on to #R$CEC4.

; Kill Player
;
; Used by the routine at #R$D94F.
; .
; Kills the player by turning both of the player's objects into bursts.
; The position and the direction of the player are kept in the template at
; #R$CC36 so that the next life starts in the same place.
;
; .
;
; Keep the place of the player for the next life.
@label=KillPlayer
c$CEC4 LD A,($BC90)  ; {Keep the column of the player in the template for the
 $CEC7 LD ($CC38),A  ; next life.}
 $CECA LD A,($BC92)  ; {Keep the row of the player in the template.
 $CECD LD ($CC3A),A  ; }
 $CED0 LD A,($BC94)  ; {Keep the direction and timer of the player in the
 $CED3 LD ($CC3C),A  ; template.}
 $CED6 LD A,($BC95)  ; {Keep the flags of the player in the template.
 $CED9 LD ($CC3D),A  ; }
; Turn both of the player's objects into bursts.
 $CEDC LD A,$0C      ; {Turn both of the player's objects into bursts.
 $CEDE LD ($BC8E),A  ;
 $CEE1 LD ($BC9E),A  ; }
 $CEE4 RET           ; Return.

; Burst Spore And Shot
;
; Used by the routine at #R$CE89.
; .
; Turns the shot and the spore into bursts, and adds #N$05 hundred points
; to the score.
;
; IX Spore
; IY Shot
@label=BurstSporeAndShot
c$CEE5 LD (IY+$00),$0C ; Turn the shot into a burst.
 $CEE9 LD (IX+$00),$0C ; Turn the spore into a burst.
; This entry point is used by the routine at #R$CE89.
@label=BurstSporeAndShot_Score
*$CEED LD BC,$0005     ; {Add #N$05 hundred points to the score.
 $CEF0 JP $C2ED        ; }
; This entry point is used by the routine at #R$CE89.
; .
; The spore is too far from the player, so remove it.
@label=BurstSporeAndShot_Remove
*$CEF3 LD (IX+$00),$00 ; {Remove the spore and return.
 $CEF7 RET             ; }

; Next Sprite Number
;
; Used by the routines at #R$BFF1, #R$CE89, #R$D70A, #R$D7ED and #R$D9A3.
; .
; Moves an object on to the next of its four sprites, by adding one to the
; lowest two bits of the type and wrapping around.
;
; IX Object
@label=NextSpriteNumber
c$CEF8 LD A,(IX+$00) ; {Add one to the lowest two bits of the type, wrapping round, to
 $CEFB LD C,A        ; choose the next sprite.
 $CEFC INC A         ;
 $CEFD AND $03       ;
 $CEFF LD B,A        ; }
 $CF00 LD A,C        ; {Put them back in the type of the object.
 $CF01 AND $FC       ;
 $CF03 OR B          ;
 $CF04 LD (IX+$00),A ; }
 $CF07 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$B18C }
; { #GUNFRIGHT$CCAE }
; { #KNIGHTLORE$B98C }
; { #MARTIANOIDS$B063 }
; LIST#

; Draw View
;
; Used by the routine at #R$BDFE.
; .
; Draws the view of the village in the pixel buffer, as seen from the
; player. The view is made of cells of the map, drawn from the furthest to the
; nearest, with the objects that are in each cell drawn after the cell.
; .
; The cells around the player are drawn in an order that depends on which of the
; five cells beside the player's cell are not empty. A pattern of five bits is
; made from them and used to find an entry in the table at #R$6204, which is
; made of five bytes for each pattern. Each byte gives one cell to draw: bits 0
; and 1 choose what to draw (0 for only the objects in the cell, 1 for the cell
; with its walls, 2 for the cell); bits 4 and 5 give the column (0 for one back,
; 1 for one on, 2 or 3 for the same one); and bits 6 and 7 give the row in the
; same way.
; .
; #PUSHS #UDGTABLE { =h Before | =h After #R$CF08 }
; { #SIM(start=$BE04,stop=$BE18,sp=$5E00,r=$80,clear=1)
; #SIM(start=$BE18,stop=$BE24)
; #SIM(start=$BE2D,stop=$BE71)
; #SCR$02,$05,$00,$1A,$12(draw-view-before)
; | #SIM(start=$CF08,stop=$0000,sp=$5BF0)
; #SIM(start=$E200,stop=$0000,sp=$5BF0)
; #SCR$02,$05,$00,$1A,$12(draw-view-after) } UDGTABLE# #POPS
@label=DrawView
c$CF08 LD HL,$E001   ; {Mark the columns that are outside the view as already drawn
 $CF0B LD ($BBBB),HL ; (see #R$BBBB).}
 $CF0E LD A,($BC90)  ; {Fetch the column and the row of the player's cell.
 $CF11 LD L,A        ;
 $CF12 LD A,($BC92)  ;
 $CF15 LD H,A        ; }
 $CF16 CALL $D17D    ; Turn them into the column and the row in the view, if the view is
                     ; turned round.
 $CF19 PUSH HL       ; Keep the player's cell.
 $CF1A LD E,$00      ; Start with an empty pattern of cells.
; Make the pattern of the five cells next to the player's cell that are
; not empty.
 $CF1C DEC L         ; {Set bit 0 if the cell one column back and one row on is
 $CF1D INC H         ; not empty.
 $CF1E CALL $D564    ;
 $CF21 JR Z,$CF25    ;
 $CF23 SET 0,E       ; }
@label=DrawView_Pattern1
*$CF25 POP HL        ; {Set bit 1 if the cell one column back is not empty.
 $CF26 PUSH HL       ;
 $CF27 DEC L         ;
 $CF28 CALL $D564    ;
 $CF2B JR Z,$CF2F    ;
 $CF2D SET 1,E       ; }
@label=DrawView_Pattern2
*$CF2F POP HL        ; {Set bit 2 if the cell one row on is not empty.
 $CF30 PUSH HL       ;
 $CF31 INC H         ;
 $CF32 CALL $D564    ;
 $CF35 JR Z,$CF39    ;
 $CF37 SET 2,E       ; }
@label=DrawView_Pattern3
*$CF39 POP HL        ; {Set bit 3 if the cell one column back and one row back
 $CF3A PUSH HL       ; is not empty.
 $CF3B DEC L         ;
 $CF3C DEC H         ;
 $CF3D CALL $D564    ;
 $CF40 JR Z,$CF44    ;
 $CF42 SET 3,E       ; }
@label=DrawView_Pattern4
*$CF44 POP HL        ; {Set bit 4 if the cell one column on and one row on is
 $CF45 PUSH HL       ; not empty.
 $CF46 INC L         ;
 $CF47 INC H         ;
 $CF48 CALL $D564    ;
 $CF4B JR Z,$CF4F    ;
 $CF4D SET 4,E       ; }
; Find the entry in the table at #R$6204 for the pattern.
@label=DrawView_FindEntry
*$CF4F LD D,$00      ; {Find the entry in the table for the pattern, and set a counter for
 $CF51 LD A,E        ; five cells.
 $CF52 EX DE,HL      ;
 $CF53 LD E,L        ;
 $CF54 LD D,H        ;
 $CF55 ADD HL,HL     ;
 $CF56 ADD HL,HL     ;
 $CF57 ADD HL,DE     ;
 $CF58 LD DE,$6204   ;
 $CF5B ADD HL,DE     ;
 $CF5C EX DE,HL      ;
 $CF5D LD B,$05      ; }
@label=DrawView_Cell
*$CF5F POP HL        ; {Get the player's cell back and fetch the next byte of
 $CF60 PUSH HL       ; the entry.
 $CF61 LD A,(DE)     ;
 $CF62 INC DE        ; }
 $CF63 BIT 5,A       ; {Keep the column as it is if bit 5 is set.
 $CF65 JR NZ,$CF6E   ; }
 $CF67 BIT 4,A       ; {Jump to #R$CF6D to move the column back one if bit 4 is
 $CF69 JR Z,$CF6D    ; clear.}
 $CF6B INC L         ; {Move the column on two...
 $CF6C INC L         ; }
@label=DrawView_ColumnBack
*$CF6D DEC L         ; ... and back one, to give one on.
@label=DrawView_Row
*$CF6E BIT 7,A       ; {Keep the row as it is if bit 7 is set.
 $CF70 JR NZ,$CF79   ; }
 $CF72 BIT 6,A       ; {Jump to #R$CF78 to move the row back one if bit 6 is
 $CF74 JR Z,$CF78    ; clear.}
 $CF76 INC H         ; {Move the row on two...
 $CF77 INC H         ; }
@label=DrawView_RowBack
*$CF78 DEC H         ; ... and back one, to give one on.
@label=DrawView_Select
*$CF79 AND $03       ; {Keep the counter and the address of the entry, and make #R$CF8D the
 $CF7B PUSH BC       ; address to return to.
 $CF7C PUSH DE       ;
 $CF7D LD DE,$CF8D   ;
 $CF80 PUSH DE       ; }
 $CF81 JP Z,$CFAA    ; Draw only the objects in the cell if bits 0 and 1 are 0.
 $CF84 DEC A         ; {Draw the cell with its walls if bits 0 and 1 are 1.
 $CF85 JP Z,$D372    ; }
 $CF88 DEC A         ; {Draw the cell if bits 0 and 1 are 2.
 $CF89 JP Z,$D19D    ; }
 $CF8C POP DE        ; Throw away the address to return to.
@label=DrawView_Next
 $CF8D POP DE        ; {Get the address of the entry and the counter back, and loop back
 $CF8E POP BC        ; until all five cells have been drawn.
 $CF8F DJNZ $CF5F    ; }
; Draw the player's cell and the three cells next to it that are nearer to
; the viewer, with the objects in each.
 $CF91 POP HL        ; {Draw the player's cell, and the objects in it.
 $CF92 PUSH HL       ;
 $CF93 CALL $CFA5    ; }
 $CF96 POP HL        ; {Draw the cell one row back, and the objects in it.
 $CF97 PUSH HL       ;
 $CF98 DEC H         ;
 $CF99 CALL $CFA5    ; }
 $CF9C POP HL        ; {Draw the cell one column on, and the objects in it.
 $CF9D PUSH HL       ;
 $CF9E INC L         ;
 $CF9F CALL $CFA5    ; }
 $CFA2 POP HL        ; {Move to the cell one column on and one row back, and draw it and its
 $CFA3 INC L         ; objects in the routine that follows.
 $CFA4 DEC H         ; }
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$C0F8 }
; LIST#

; Draw Cell And Objects
;
; Used by the routine at #R$CF08.
; .
; Draws a cell of the map and then the objects that are in it.
;
; H Row in the view
; L Column in the view
@label=DrawCellAndObjects
c$CFA5 PUSH HL       ; {Draw the cell.
 $CFA6 CALL $D19D    ;
 $CFA9 POP HL        ; }
; This entry point is used by the routine at #R$CF08.
; .
; Draw only the objects in the cell.
@label=DrawObjectsInCell
*$CFAA CALL $CFAF    ; {Make a list of the objects in the cell, and draw them in the routine
 $CFAD JR $CFF2      ; that follows.}

; Find Objects In Cell
;
; Used by the routine at #R$CFA5.
; .
; Makes a list at #R$D15D of the addresses of all of the objects which are
; in a cell. The list ends with a zero word.
;
; HL The cell: the column in #REGl and the row in #REGh
;
; Point at the list and the first object slot.
@label=FindObjectsInCell
c$CFAF LD IY,$D15D   ; Point #REGiy at #R$D15D.
 $CFB3 LD IX,$BC8E   ; Point #REGix at #R$BC8E.
; Turn the cell round if the view is rotated.
 $CFB7 CALL $D17D    ; Call #R$D17D.
 $CFBA EX DE,HL      ; Keep the column in #REGe and the row in #REGd.
; Look at this slot.
@label=FindObjectsInCell_Loop
*$CFBB LD A,(IX+$00) ; {Jump to #R$CFDA to move on if the object is free.
 $CFBE AND A         ;
 $CFBF JR Z,$CFDA    ; }
 $CFC1 LD A,E        ; {Jump to #R$CFDA to move on if the object is not in the
 $CFC2 CP (IX+$02)   ; column.
 $CFC5 JR NZ,$CFDA   ; }
 $CFC7 LD A,D        ; {Jump to #R$CFDA to move on if the object is not in the
 $CFC8 CP (IX+$04)   ; row.
 $CFCB JR NZ,$CFDA   ; }
 $CFCD PUSH IX       ; {Copy the address of the object into #REGhl (using the
 $CFCF POP HL        ; stack).}
 $CFD0 LD (IY+$00),L ; {Add the address of the object to the list.
 $CFD3 LD (IY+$01),H ; }
 $CFD6 INC IY        ; {Move on to the next place in the list.
 $CFD8 INC IY        ; }
; Move on to the next object.
@label=FindObjectsInCell_Next
*$CFDA LD BC,$0010   ; {Move on to the next object slot.
 $CFDD ADD IX,BC     ; }
 $CFDF PUSH IX       ; {Copy the address of the object to #REGhl (using the
 $CFE1 POP HL        ; stack).}
; See whether every slot has been looked at.
 $CFE2 LD BC,$BDFE   ; {Check whether the end of the object table at #R$BDFE has been
 $CFE5 AND A         ; reached.
 $CFE6 SBC HL,BC     ; }
; Go back for the next slot.
 $CFE8 JR C,$CFBB    ; Loop back until all #N$17 objects have been checked.
; End the list.
 $CFEA XOR A         ; {Write a zero word to the end of the list.
 $CFEB LD (IY+$00),A ;
 $CFEE LD (IY+$01),A ; }
 $CFF1 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$C1A4 }
; LIST#

; Draw Objects In List
;
; Used by the routine at #R$CFA5.
; .
; Draws the objects in the list at #R$D15D, which are the objects in one
; cell. The objects are drawn so that the ones further from the viewer come
; first. Each time it takes the first object in the list which has not been
; drawn, compares it with each of the rest, and swaps it for any object which
; should be drawn before it. It then draws the object it is left with, and marks
; it as drawn by clearing bit 7 of the high byte of its address in the list.
;
; .
;
; Find the first object in the list which has not been drawn.
@label=DrawObjectsInList
c$CFF2 LD HL,$D15D    ; Point #REGhl at #R$D15D.
@label=DrawObjectsInList_Next
*$CFF5 LD E,(HL)      ; {Fetch the address of the next object into #REGde.
 $CFF6 INC HL         ;
 $CFF7 LD D,(HL)      ;
 $CFF8 INC HL         ; }
 $CFF9 LD A,D         ; {Return if this is the end of the list.
 $CFFA OR E           ;
 $CFFB RET Z          ; }
 $CFFC BIT 7,D        ; {Skip the entry if the object has been drawn already.
 $CFFE JR Z,$CFF5     ; }
; Remember where the next place in the list is.
 $D000 LD ($BBC4),HL  ; Set #R$BBC4.
 $D003 PUSH DE        ; {Copy the address of the object into #REGix (using the
 $D004 POP IX         ; stack).}
; Compare this object with each of the others which have not been drawn.
@label=DrawObjectsInList_Compare
*$D006 LD E,(HL)      ; {Fetch the address of the next object into #REGde.
 $D007 INC HL         ;
 $D008 LD D,(HL)      ;
 $D009 INC HL         ; }
; Draw the first object if this is the end of the list.
 $D00A LD A,D         ; {Jump to #R$D094 to draw the object if it is the zero word that marks
 $D00B OR E           ; the end of the list.
 $D00C JP Z,$D094     ; }
 $D00F BIT 7,D        ; {Skip the entry if the object has been drawn already.
 $D011 JR Z,$D006     ; }
; Remember where the next place in the list is.
 $D013 LD ($BBC6),HL  ; Set #R$BBC6.
 $D016 PUSH DE        ; {Copy the address of the object into #REGiy (using the
 $D017 POP IY         ; stack).}
 $D019 LD C,$00       ; Clear the number which says how the objects compare.
; Compare the objects from side to side. The number in #REGc stays at zero
; if the first object starts after the second ends, becomes two if the second
; starts after the first ends, and becomes one if they overlap.
 $D01B LD A,(IY+$01)  ; {Fetch the horizontal position of the second object and add its
 $D01E ADD A,(IY+$08) ; horizontal size.}
 $D021 RRA            ; {Halve it, add #N$40 and keep the result in #REGb.
 $D022 ADD A,$40      ;
 $D024 LD B,A         ; }
; Work out the smallest extent of the object at #REGix, and subtract the
; largest extent of the object at #REGiy.
 $D025 LD A,(IX+$01)  ; {Fetch the horizontal position of the first object and subtract its
 $D028 SUB (IX+$08)   ; horizontal size.}
 $D02B RRA            ; {Halve it and add #N$40.
 $D02C ADD A,$40      ; }
 $D02E SUB B          ; {Jump to #R$D049 if the first object starts after the
 $D02F JR NC,$D049    ; second ends.}
; Work out the largest extent of the object at #REGix.
 $D031 LD A,(IX+$01)  ; {Fetch the horizontal position of the first object and add its
 $D034 ADD A,(IX+$08) ; horizontal size.}
 $D037 RRA            ; {Halve it, add #N$40 and keep the result in #REGb.
 $D038 ADD A,$40      ;
 $D03A LD B,A         ; }
; Work out the smallest extent of the object at #REGiy, and subtract the
; largest extent of the object at #REGix.
 $D03B LD A,(IY+$01)  ; {Fetch the horizontal position of the second object and subtract its
 $D03E SUB (IY+$08)   ; horizontal size.}
 $D041 RRA            ; {Halve it and add #N$40.
 $D042 ADD A,$40      ; }
 $D044 SUB B          ; {Jump to #R$D048 if the second object starts before the
 $D045 JR C,$D048     ; first ends.}
 $D047 INC C          ; Add one.
@label=DrawObjectsInList_Overlap
*$D048 INC C          ; Add one more.
; Compare the objects from front to back in the same way. This time the
; number in #REGc has zero, three or six added to it.
@label=DrawObjectsInList_Y
*$D049 LD A,(IY+$03)  ; {Fetch the vertical position of the second object and add its
 $D04C ADD A,(IY+$09) ; vertical size.}
 $D04F RRA            ; {Halve it, add #N$40 and keep the result in #REGb.
 $D050 ADD A,$40      ;
 $D052 LD B,A         ; }
; Work out the smallest extent of the object at #REGix, and subtract the
; largest extent of the object at #REGiy.
 $D053 LD A,(IX+$03)  ; {Fetch the vertical position of the first object and subtract its
 $D056 SUB (IX+$09)   ; vertical size.}
 $D059 RRA            ; {Halve it and add #N$40.
 $D05A ADD A,$40      ; }
 $D05C SUB B          ; Subtract the end of the second object.
 $D05D LD A,C         ; Fetch the number.
 $D05E JR NC,$D07B    ; Jump to #R$D07B if the object at #REGix is wholly
                      ; beyond it.
; Work out the largest extent of the object at #REGix.
 $D060 LD A,(IX+$03)  ; {Fetch the vertical position of the first object and add its vertical
 $D063 ADD A,(IX+$09) ; size.}
 $D066 RRA            ; {Halve it, add #N$40 and keep the result in #REGb.
 $D067 ADD A,$40      ;
 $D069 LD B,A         ; }
; Work out the smallest extent of the object at #REGiy, and subtract the
; largest extent of the object at #REGix.
 $D06A LD A,(IY+$03)  ; {Fetch the vertical position of the second object and subtract its
 $D06D SUB (IY+$09)   ; vertical size.}
 $D070 RRA            ; {Halve it and add #N$40.
 $D071 ADD A,$40      ; }
 $D073 SUB B          ; Subtract the end of the first object.
 $D074 LD A,C         ; Fetch the number.
 $D075 JR C,$D079     ; Jump to #R$D079 if they overlap.
 $D077 ADD A,$03      ; Add three.
@label=DrawObjectsInList_YOverlap
*$D079 ADD A,$03      ; Add three more.
@label=DrawObjectsInList_Relation
*$D07B LD C,A         ; Keep the number in #REGc.
; Fetch the rotation of the view.
 $D07C LD A,($BBBA)   ; Fetch #R$BBBA.
 $D07F AND %00000001  ; Test the lowest bit.
 $D081 JR Z,$D087     ; Jump to #R$D087 if the view is not rotated.
 $D083 LD A,C         ; {Add #N$09 to the number, to use the second half of the
 $D084 ADD A,$09      ; table.
 $D086 LD C,A         ; }
; Run the routine in the table at #R$D0A0 for the relation, which does
; nothing if the object at #REGix is to be drawn first, and otherwise makes the
; object at #REGiy the object at #REGix (see #R$D0C5), or compares them further.
@label=DrawObjectsInList_Choose
*$D087 LD A,C         ; Fetch the number.
 $D088 LD BC,$D0A0    ; Point #REGbc at #R$D0A0.
; Run the routine for the number.
 $D08B CALL $D593     ; Call #R$D593.
; Fetch the place in the list after the second object.
 $D08E LD HL,($BBC6)  ; Fetch #R$BBC6.
; Go back to compare the next object.
 $D091 JP $D006       ; Jump to #R$D006.
; There are no more objects to compare with, so the first object is the
; one to draw. Mark it as drawn, using the place kept at #R$BBC4.
@label=DrawObjectsInList_Draw
*$D094 LD HL,($BBC4)  ; {Mark the entry for the object at #REGix as drawn.
 $D097 DEC HL         ;
 $D098 RES 7,(HL)     ; }
; Draw the object.
 $D09A CALL $E3D9     ; Draw the object.
; Go back to find the next object to draw.
 $D09D JP $CFF2       ; Go back to draw the objects that are left in the list.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$C1E7 }
; LIST#

; Object Order Table
;
; The routines that #R$CFF2 runs to decide which of two objects to draw
; first, chosen by the relation between them. The relation is made from the
; relation along the X axis (0 to 2) and three times the relation along the Y
; axis (0 to 2), and nine is added to it when the view is rotated. The routine
; is #R$D0C4 if the first object stays, #R$D0C5 if the second object is chosen,
; and #R$D0D0 if they have to be compared further.
@label=ObjectOrderTable
w$D0A0 DEFW $D0C4
 $D0A2 DEFW $D0C4
 $D0A4 DEFW $D0C4
 $D0A6 DEFW $D0C5
 $D0A8 DEFW $D0D0
 $D0AA DEFW $D0C4
 $D0AC DEFW $D0C5
 $D0AE DEFW $D0C5
 $D0B0 DEFW $D0C4
 $D0B2 DEFW $D0C4
 $D0B4 DEFW $D0C5
 $D0B6 DEFW $D0C5
 $D0B8 DEFW $D0C4
 $D0BA DEFW $D0D0
 $D0BC DEFW $D0C5
 $D0BE DEFW $D0C4
 $D0C0 DEFW $D0C4
 $D0C2 DEFW $D0C4

; Keep Object
;
; Does nothing, which leaves the object at #REGix as the one to draw
; first.
@label=KeepObject
c$D0C4 RET           ; Return.

; Choose Other Object
;
; Used by the routine at #R$D0D0.
; .
; Makes the object at #REGiy the one to draw first.
;
;   IY Object
; O:IX Object
@label=ChooseOtherObject
c$D0C5 LD HL,($BBC6) ; {Make the place in the list the place of the object at
 $D0C8 LD ($BBC4),HL ; #REGiy.}
 $D0CB PUSH IY       ; {Make that object the one to draw first (using the
 $D0CD POP IX        ; stack).}
 $D0CF RET           ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$C2BA }
; LIST#

; Compare Object Depths
;
; Decides which of two objects that overlap along both axes is drawn
; first, by working out a value for each from the corners of the object, in
; units of half a cell, that measures how far it is along the diagonal of the
; view. The object at #REGix is kept if its value is not less than that of the
; object at #REGiy, otherwise the object at #REGiy is chosen. The edges which it
; uses are different when the view is rotated.
;
; IX The address of the first object
; IY The address of the second object
;
; Jump to #R$D125 if the view is turned round.
@label=CompareObjectDepths
c$D0D0 LD A,($BBBA)   ; Fetch the rotation of the view.
 $D0D3 AND %00000001  ; Test the lowest bit.
 $D0D5 JR NZ,$D125    ; Jump if the view is rotated.
; Find the number for the second object, in #REGde.
 $D0D7 LD A,(IY+$01)  ; {Fetch the horizontal position, add the horizontal size, halve it and
 $D0DA ADD A,(IY+$08) ; add #N$40.
 $D0DD RRA            ;
 $D0DE ADD A,$40      ; }
 $D0E0 LD C,A         ; {Keep it in #REGbc.
 $D0E1 LD B,$00       ; }
; Work out the smallest Y extent of the object at #REGiy.
 $D0E3 LD A,(IY+$03)  ; {Fetch the vertical position, subtract the vertical size, halve it
 $D0E6 SUB (IY+$09)   ; and add #N$40.
 $D0E9 RRA            ;
 $D0EA ADD A,$40      ; }
 $D0EC LD L,A         ; {Make the top edge a sixteen bit number in #REGhl.
 $D0ED LD H,$00       ; }
 $D0EF AND A          ; {Subtract the X extent from the Y extent, to measure how far along
 $D0F0 SBC HL,BC      ; the diagonal of the view the object is.}
 $D0F2 LD BC,$0100    ; {Add #N$0100.
 $D0F5 ADD HL,BC      ; }
 $D0F6 SRL H          ; {Divide the result by two...
 $D0F8 RR L           ; }
 $D0FA EX DE,HL       ; Keep the result for the object at #REGiy.
; Find the number for the first object, in #REGhl, in the same way.
 $D0FB LD A,(IX+$01)  ; {Fetch the horizontal position, add the horizontal size, halve it and
 $D0FE ADD A,(IX+$08) ; add #N$40.
 $D101 RRA            ;
 $D102 ADD A,$40      ; }
 $D104 LD C,A         ; {Keep it in #REGbc.
 $D105 LD B,$00       ; }
 $D107 LD A,(IX+$03)  ; {Fetch the smallest Y extent of the object at #REGix.
 $D10A SUB (IX+$09)   ; }
@label=CompareObjectDepths_Second
*$D10D RRA            ; {Halve it and add #N$40.
 $D10E ADD A,$40      ; }
 $D110 LD L,A         ; {Make the top edge a sixteen bit number in #REGhl.
 $D111 LD H,$00       ; }
 $D113 AND A          ; {Subtract the horizontal edge.
 $D114 SBC HL,BC      ; }
 $D116 LD BC,$0100    ; {Add #N$0100.
 $D119 ADD HL,BC      ; }
 $D11A SRL H          ; {Divide the result by two.
 $D11C RR L           ; }
 $D11E AND A          ; {Subtract the result for the object at #REGiy.
 $D11F SBC HL,DE      ; }
 $D121 RET NC         ; Return if the value for the object at #REGix is not less, which
                      ; keeps it as the one to draw first.
 $D122 JP $D0C5       ; Choose the object at #REGiy instead.
; Find the numbers when the view is rotated. The number for the first
; object goes in #REGde...
@label=CompareObjectDepths_Rotated
*$D125 LD A,(IX+$01)  ; {Fetch the horizontal position, subtract the horizontal size, halve
 $D128 SUB (IX+$08)   ; it and add #N$40.
 $D12B RRA            ;
 $D12C ADD A,$40      ; }
 $D12E LD C,A         ; {Keep it in #REGbc.
 $D12F LD B,$00       ; }
; Work out the largest Y extent of the object at #REGix.
 $D131 LD A,(IX+$03)  ; {Fetch the vertical position, add the vertical size, halve it and add
 $D134 ADD A,(IX+$09) ; #N$40.
 $D137 RRA            ;
 $D138 ADD A,$40      ; }
 $D13A LD L,A         ; {Make the lower edge a sixteen bit number in #REGhl.
 $D13B LD H,$00       ; }
 $D13D AND A          ; {Subtract the horizontal edge.
 $D13E SBC HL,BC      ; }
 $D140 LD BC,$0100    ; {Add #N$0100.
 $D143 ADD HL,BC      ; }
 $D144 SRL H          ; {Divide the result by two...
 $D146 RR L           ; }
 $D148 EX DE,HL       ; Keep the result for the object at #REGix.
; ...and the number for the second object is found in #REGhl by the end of
; the routine above.
 $D149 LD A,(IY+$01)  ; {Fetch the horizontal position, subtract the horizontal size, halve
 $D14C SUB (IY+$08)   ; it and add #N$40.
 $D14F RRA            ;
 $D150 ADD A,$40      ; }
 $D152 LD C,A         ; {Keep it in #REGbc.
 $D153 LD B,$00       ; }
 $D155 LD A,(IY+$03)  ; {Fetch the largest Y extent of the object at #REGiy.
 $D158 ADD A,(IY+$09) ; }
; Go to find the number.
 $D15B JR $D10D       ; Jump to #R$D10D to compare the results.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$C2C5 }
; LIST#

; Object List
;
; The list of the objects in a cell that is being drawn, made by #R$CFAF.
@label=ObjectList
s$D15D DEFS $20

; Convert Cell
;
; Used by the routines at #R$CF08 and #R$CFAF.
; .
; Converts the column and the row of a cell between the map and the view,
; which are the same unless the view is rotated, when both are turned around.
;
;   H Row
;   L Column
; O:H Row converted
; O:L Column converted
@label=ConvertCell
c$D17D LD A,($BBBA)  ; {Return if the view is not turned round.
 $D180 AND $01       ;
 $D182 RET Z         ; }
 $D183 LD A,L        ; {Turn the column round by subtracting it from #N$1F.
 $D184 CPL           ;
 $D185 AND $1F       ;
 $D187 LD L,A        ; }
 $D188 LD A,H        ; {Turn the row round by subtracting it from #N$1F.
 $D189 CPL           ;
 $D18A AND $1F       ;
 $D18C LD H,A        ; }
 $D18D RET           ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$C372 }
; LIST#

; Convert Position
;
; Used by the routine at #R$D4F3.
; .
; Converts a position along one axis of the map into the position in the
; view, which is the same unless the view is rotated, when the position is
; turned around.
;
;   H Tile
;   L Fraction
; O:H Tile converted
; O:L Fraction converted
@label=ConvertPosition
c$D18E LD A,($BBBA)  ; {Return if the view is not turned round.
 $D191 AND $01       ;
 $D193 RET Z         ; }
 $D194 LD A,L        ; {Turn the fraction round.
 $D195 CPL           ;
 $D196 LD L,A        ; }
 $D197 LD A,H        ; {Turn the tile round by subtracting it from #N$1F.
 $D198 CPL           ;
 $D199 AND $1F       ;
 $D19B LD H,A        ; }
 $D19C RET           ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$C383 }
; LIST#

; Draw Cell
;
; Used by the routines at #R$CF08 and #R$CFA5.
; .
; Draws a cell of the map from the two lists of strips for its tile. Each
; list is made of sixteen strips, which are drawn along the edge of the cell:
; the first list from left to right and the second list from right to left.
; Nothing is drawn if the cell is empty. When the view is rotated, the lists are
; drawn in the opposite order.
;
; L The column
; H The row
;
; Find the code of the cell.
@label=DrawCell
c$D19D CALL $D564    ; Call #R$D564.
 $D1A0 RET Z         ; Return if there is nothing in the cell.
; Double the code to make the number of its first list.
 $D1A1 ADD A,A       ; Double the code.
 $D1A2 PUSH AF       ; Stash it on the stack.
; Find the position of the cell on the screen.
 $D1A3 CALL $D508    ; Work out the position of the cell on the screen.
 $D1A6 POP AF        ; {Get the number of the list back, and keep it again.
 $D1A7 PUSH AF       ; }
; Draw the second list at the bottom when the view is rotated.
 $D1A8 LD HL,$BBBA   ; {Jump to #R$D1F2 if the view is turned round.
 $D1AB BIT 0,(HL)    ;
 $D1AD JR NZ,$D1F2   ; }
; Draw the edges at the bottom.
 $D1AF CALL $D1FA    ; Call #R$D1FA.
; Get the number of the list back and make it the number of the second
; list.
 $D1B2 POP AF        ; Restore the list number from the stack.
 $D1B3 OR %00000001  ; Use the second list.
; Draw the edges at the top, starting from the right corner of the cell.
@label=DrawCell_RightToLeft
*$D1B5 LD HL,($BBB6) ; {Move the position back to the last strip that was
 $D1B8 LD DE,$FFF0   ; drawn.
 $D1BB ADD HL,DE     ;
 $D1BC LD ($BBB6),HL ; }
 $D1BF LD BC,$62A4   ; Point #REGbc at #R$62A4.
; Find the address of the list.
 $D1C2 CALL $D589    ; Call #R$D589.
 $D1C5 PUSH HL       ; {Copy the list address to #REGiy (using the stack).
 $D1C6 POP IY        ; }
; Draw tiles as they are.
 $D1C8 XOR A         ; {Write #N$00 to *#R$BBF2.
 $D1C9 LD ($BBF2),A  ; }
 $D1CC LD BC,$0801   ; Set a count of eight tiles, and swap each for its pair.
; Draw eight tiles going up and to the left.
@label=DrawCell_Down
*$D1CF CALL $D273    ; Call #R$D273.
 $D1D2 CALL $D255    ; Call #R$D255.
 $D1D5 DJNZ $D1CF    ; Jump to #R$D1CF if there are any left.
; Move down by eight pixels to start the second run.
 $D1D7 LD HL,($BBB8) ; {Move the position of the strips up one step.
 $D1DA LD DE,$FFF8   ;
 $D1DD ADD HL,DE     ;
 $D1DE LD ($BBB8),HL ; }
; Draw the rest of the tiles flipped.
 $D1E1 LD A,$01      ; {Write #N$01 to *#R$BBF2.
 $D1E3 LD ($BBF2),A  ; }
 $D1E6 LD BC,$0801   ; Set a count of eight tiles, and swap each for its pair.
; Draw eight tiles going down and to the left.
@label=DrawCell_Up
*$D1E9 CALL $D273    ; Call #R$D273.
 $D1EC CALL $D26E    ; Call #R$D26E.
 $D1EF DJNZ $D1E9    ; Jump to #R$D1E9 if there are any left.
 $D1F1 RET           ; Return.
; The view is rotated, so draw the second list at the bottom and the first
; at the top.
@label=DrawCell_Rotated
*$D1F2 OR %00000001  ; Use the second list.
; Draw the edges at the bottom.
 $D1F4 CALL $D1FA    ; Call #R$D1FA.
 $D1F7 POP AF        ; Restore the list number from the stack.
; Draw the edges at the top.
 $D1F8 JR $D1B5      ; Jump to #R$D1B5.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$C392 }
; LIST#

; Draw Strips Left To Right
;
; Used by the routine at #R$D19D.
; .
; Draws a list of sixteen strips along the edge of a cell from left to
; right: eight strips going up and to the right, and then eight going down and
; to the right, which are mirrored.
;
; A The number of the list in the table at #R$62A4
;
; Find the address of the list.
@label=DrawStripsLeftToRight
c$D1FA LD BC,$62A4   ; Point #REGbc at #R$62A4.
 $D1FD CALL $D589    ; Call #R$D589.
 $D200 PUSH HL       ; {Copy the list address to #REGiy (using the stack).
 $D201 POP IY        ; }
; Draw tiles as they are.
 $D203 XOR A         ; {Write #N$00 to *#R$BBF2.
 $D204 LD ($BBF2),A  ; }
 $D207 LD BC,$0800   ; Set a count of eight tiles, without swapping any.
; Draw eight tiles going up and to the right.
@label=DrawStripsLeftToRight_Up
*$D20A CALL $D273    ; Call #R$D273.
 $D20D CALL $D24B    ; Call #R$D24B.
 $D210 DJNZ $D20A    ; Jump to #R$D20A if there are any left.
; Move down by eight pixels to start the second run.
 $D212 LD HL,($BBB8) ; {Move the position of the strips down one step.
 $D215 LD DE,$0008   ;
 $D218 ADD HL,DE     ;
 $D219 LD ($BBB8),HL ; }
; Draw the rest of the tiles flipped.
 $D21C LD A,$01      ; {Write #N$01 to *#R$BBF2.
 $D21E LD ($BBF2),A  ; }
 $D221 LD BC,$0800   ; Set a count of eight tiles, without swapping any.
; Draw eight tiles going down and to the right.
@label=DrawStripsLeftToRight_Down
*$D224 CALL $D273    ; Call #R$D273.
 $D227 CALL $D232    ; Call #R$D232.
 $D22A DJNZ $D224    ; Jump to #R$D224 if there are any left.
 $D22C RET           ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$C3EF }
; LIST#

; Step Down Right
;
; Used by the routine at #R$D372.
; .
; Moves the position of the strips down eight pixels and right sixteen
; pixels.
@label=StepDownRight
c$D22D LD DE,$0008   ; {Set the step down to eight.
 $D230 JR $D239      ; }
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$C422 }
; LIST#

; Step Down Right In List
;
; Used by the routine at #R$D1FA.
; .
; Moves the position of the strips down eight pixels and right sixteen
; pixels, and moves on to the next strip in the list.
@label=StepDownRightInList
c$D232 LD DE,$0008   ; Set the step down to eight.
; This entry point is used by the routine at #R$D24B.
; .
; Move on to the next strip in the list, and move the position.
@label=StepInList
*$D235 INC IY        ; {Move on to the next strip in the list.
 $D237 INC IY        ; }
; This entry point is used by the routines at #R$D22D and #R$D250.
; .
; Move the position of the strips down by the step (in #REGde) and right
; sixteen pixels.
@label=StepRight
*$D239 LD HL,($BBB8) ; {Add the step to the Y position of the strips.
 $D23C ADD HL,DE     ;
 $D23D LD ($BBB8),HL ; }
 $D240 LD HL,($BBB6) ; {Add sixteen to the X position of the strips.
 $D243 LD DE,$0010   ;
 $D246 ADD HL,DE     ;
 $D247 LD ($BBB6),HL ; }
 $D24A RET           ; Return.

; Step Up Right In List
;
; Used by the routine at #R$D1FA.
; .
; Moves the position of the strips up eight pixels and right sixteen
; pixels, and moves on to the next strip in the list.
@label=StepUpRightInList
c$D24B LD DE,$FFF8   ; {Set the step up to eight, and move on to the next strip
 $D24E JR $D235      ; in the list.}

; Step Up Right
;
; Used by the routine at #R$D372.
; .
; Moves the position of the strips up eight pixels and right sixteen
; pixels.
@label=StepUpRight
c$D250 LD DE,$FFF8   ; {Set the step up to eight and move the position.
 $D253 JR $D239      ; }

; Step Down Left In List
;
; Used by the routine at #R$D19D.
; .
; Moves the position of the strips down eight pixels and left sixteen
; pixels, and moves on to the next strip in the list.
@label=StepDownLeftInList
c$D255 LD DE,$0008   ; Set the step down to eight.
; This entry point is used by the routine at #R$D26E.
; .
; Move on to the next strip in the list, and move the position by the step
; (in #REGde) and left sixteen pixels.
@label=StepLeftInList
*$D258 INC IY        ; {Move on to the next strip in the list.
 $D25A INC IY        ; }
 $D25C LD HL,($BBB8) ; {Add the step to the Y position of the strips.
 $D25F ADD HL,DE     ;
 $D260 LD ($BBB8),HL ; }
 $D263 LD HL,($BBB6) ; {Subtract sixteen from the X position of the strips.
 $D266 LD DE,$FFF0   ;
 $D269 ADD HL,DE     ;
 $D26A LD ($BBB6),HL ; }
 $D26D RET           ; Return.

; Step Up Left In List
;
; Used by the routine at #R$D19D.
; .
; Moves the position of the strips up eight pixels and left sixteen
; pixels, and moves on to the next strip in the list.
@label=StepUpLeftInList
c$D26E LD DE,$FFF8   ; {Set the step up to eight and move the position.
 $D271 JR $D258      ; }

; Draw Strip
;
; Used by the routines at #R$D19D and #R$D1FA.
; .
; Draws one strip of a cell, which is a graphic that is sixteen pixels
; wide. A strip is not drawn if its position is outside the view.
;
; C Variant of the strip (0 or 1)
; IY Entry in the list of strips
;
; Return if the tile is outside the play area horizontally.
@label=DrawStrip
c$D273 LD DE,($BBB6) ; Fetch #R$BBB6 into #REGde.
 $D277 LD HL,$00CF   ; {Return if it is further to the right than #N$00CF.
 $D27A AND A         ;
 $D27B SBC HL,DE     ;
 $D27D RET C         ; }
 $D27E LD HL,$0010   ; {Return if it is not further to the right than #N$0010.
 $D281 SBC HL,DE     ;
 $D283 RET NC        ; }
; Return if the tile is off the screen vertically.
 $D284 LD HL,($BBB8) ; Fetch #R$BBB8.
 $D287 LD A,H        ; {Return if the high byte is not zero.
 $D288 AND A         ;
 $D289 RET NZ        ; }
; Fetch the tile and find its image.
 $D28A LD D,L        ; Keep the low byte of the vertical position in #REGd.
 $D28B LD A,C        ; Fetch the swap flag.
 $D28C PUSH BC       ; Stash the count of tiles on the stack.
 $D28D LD C,(IY+$00) ; {Fetch the tile number into #REGbc.
 $D290 LD B,$00      ; }
; Combine the variant with the entry for the strip in the table at
; #R$6542.
 $D292 LD HL,$6542   ; {Find the entry for the tile in #R$6542.
 $D295 ADD HL,BC     ; }
 $D296 XOR (HL)      ; Combine it with the swap flag, to make the number of the
                     ; image.
; Find the address of the image.
 $D297 LD BC,$6FDC   ; Point #REGbc at #R$6FDC.
 $D29A CALL $D589    ; Call #R$D589.
; Draw the image.
 $D29D CALL $D2B2    ; Draw the graphic.
 $D2A0 POP BC        ; Restore the count of tiles from the stack.
 $D2A1 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$C468 }
; LIST#

; Clip Edge Strip Top
;
; Used by the routine at #R$D2B2.
; .
; Skips the rows of a strip that are
; below #R$E5C4. #REGa is the number of those
; rows, negated. It starts drawing at #N$48 and
; jumps to #R$D2C1.
;
; A The number of rows below the buffer, negated
; HL The address of the strip
;
; Skip the rows that are below the buffer.
@label=ClipEdgeStripTop
c$D2A2 NEG           ; {Make the number of rows positive and keep it in #REGc.
 $D2A4 LD C,A        ; }
 $D2A5 LD A,(HL)     ; {Fetch the height of the strip.
 $D2A6 INC HL        ; }
 $D2A7 SUB C         ; Subtract the rows that are below.
 $D2A8 RET M         ; {Return if there are none left.
 $D2A9 RET Z         ; }
 $D2AA LD B,$00      ; {Skip the image data for those rows.
 $D2AC ADD HL,BC     ;
 $D2AD ADD HL,BC     ; }
 $D2AE LD D,$48      ; Set the vertical position to #N$48.
 $D2B0 JR $D2C1      ; Jump to #R$D2C1.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$C497 }
; LIST#

; Draw Strip Graphic
;
; Used by the routine at #R$D273.
; .
; Draws a strip which is sixteen pixels
; wide into #R$E5C4, combining it with what is
; already there. The strip starts with a byte
; for the number of rows, followed by two bytes
; for each row. It is drawn from the bottom row
; up, and is cut off at the bottom and top of
; the buffer. The position is in #R$BBB6 and
; the strip is moved to the right by #N($00),
; #N($02), #N$04 or #N$06 pixels, using #R$FA00
; and #R$F200. The strip is flipped if #R$BBF2
; is not zero.
; .
; #PUSHS #UDGTABLE { =h After #R$D2B2 }
; { #SIM(start=$BE04,stop=$BE18,sp=$5E00,r=$80,clear=1)
; #SIM(start=$BE18,stop=$BE24)
; #SIM(start=$BE2D,stop=$BE71)
; #SIM(start=$D2B2,stop=$0000,de=$7850,hl=$6FE4,sp=$5BF0)
; #SIM(start=$E200,stop=$0000,sp=$5BF0)
; #SCR$02,$05,$00,$1A,$12(draw-strip-graphic) } UDGTABLE# #POPS
;
; D The vertical position of the bottom of the strip
; E The horizontal position of the strip
; HL The address of the graphic
;
; Clip the strip to the buffer.
@label=DrawStripGraphic
c$D2B2 LD A,D        ; {Subtract #N$48 from the vertical position.
 $D2B3 SUB $48       ; }
 $D2B5 JR C,$D2A2    ; Jump to #R$D2A2 if it is below the bottom.
 $D2B7 SUB $70       ; Subtract #N$70.
 $D2B9 RET NC        ; Return if it is above the top.
 $D2BA NEG           ; Make it the number of rows in the buffer.
 $D2BC CP (HL)       ; {Jump to #R$D2C0 if it is fewer.
 $D2BD JR C,$D2C0    ; }
 $D2BF LD A,(HL)     ; Use the height of the strip.
; Draw the rows that are in the buffer.
@label=DrawStripGraphic_Height
*$D2C0 INC HL        ; Move on to the first row of the graphic.
; This entry point is used by the routine at #R$D2A2.
@label=DrawStripGraphic_Draw
*$D2C1 EX AF,AF'     ; Keep the number of rows in #REGa'.
 $D2C2 EX DE,HL      ; Put the position in #REGhl.
 $D2C3 CALL $E53A    ; Call #R$E53A.
 $D2C6 EX DE,HL      ; Switch the buffer and the graphic.
 $D2C7 LD ($BBAE),SP ; Set #R$BBAE.
 $D2CB LD SP,HL      ; Point the stack at the graphic.
; Choose the draw path.
 $D2CC LD A,($BBB6)  ; Fetch #R$BBB6.
 $D2CF AND %00000110 ; Keep bits 1 and 2.
 $D2D1 JR Z,$D323    ; Jump to #R$D323 if the strip is aligned.
 $D2D3 OR %11110000  ; Set the high bits of the page.
 $D2D5 LD H,A        ; Set #REGh.
 $D2D6 LD A,($BBF2)  ; Fetch #R$BBF2.
 $D2D9 AND A         ; {Jump to #R$D302 if it is set.
 $D2DA JR NZ,$D302   ; }
 $D2DC SET 3,H       ; Set bit 3 of #REGh.
 $D2DE EX AF,AF'     ; Switch in the number of rows.
; Draw a shifted row.
@label=DrawStripGraphic_Shifted
*$D2DF EX AF,AF'     ; Keep the number of rows in #REGa'.
 $D2E0 POP BC        ; {Fetch a row and point at the first byte.
 $D2E1 LD L,C        ; }
 $D2E2 LD A,(DE)     ; {Combine the bits which stay with the first byte of the
 $D2E3 OR (HL)       ; buffer.
 $D2E4 LD (DE),A     ; }
 $D2E5 INC DE        ; {Move on to the next byte and page.
 $D2E6 INC H         ; }
 $D2E7 LD A,(DE)     ; {Combine the bits which moved on from the first byte.
 $D2E8 OR (HL)       ; }
 $D2E9 DEC H         ; {Point at the second byte of the graphic.
 $D2EA LD L,B        ; }
 $D2EB OR (HL)       ; {Combine its bits which stay and store the byte.
 $D2EC LD (DE),A     ; }
 $D2ED INC DE        ; {Move on to the next byte and page.
 $D2EE INC H         ; }
 $D2EF LD A,(DE)     ; {Combine the bits which moved on with the next byte of
 $D2F0 OR (HL)       ; the buffer.
 $D2F1 LD (DE),A     ; }
 $D2F2 DEC H         ; Go back to the first page.
 $D2F3 EX DE,HL      ; {Move on to the next row of the buffer.
 $D2F4 LD BC,$0016   ;
 $D2F7 ADD HL,BC     ;
 $D2F8 EX DE,HL      ; }
 $D2F9 EX AF,AF'     ; Switch in the number of rows.
 $D2FA DEC A         ; Count it down.
 $D2FB JR NZ,$D2DF   ; Jump to #R$D2DF until the rows are done.
; Put the stack back.
@label=DrawStripGraphic_Done
*$D2FD LD SP,($BBAE) ; {Fetch #R$BBAE and return.
 $D301 RET           ; }
; Draw a shifted row that is flipped.
@label=DrawStripGraphic_MirroredShifted
*$D302 EX AF,AF'     ; Switch in the number of rows.
@label=DrawStripGraphic_MirroredLoop
*$D303 EX AF,AF'     ; Keep the number of rows in #REGa'.
 $D304 POP BC        ; {Fetch a row and point at the second byte.
 $D305 LD L,B        ; }
 $D306 LD A,(DE)     ; {Combine the bits which stay with the first byte of the
 $D307 OR (HL)       ; buffer.
 $D308 LD (DE),A     ; }
 $D309 INC DE        ; {Move on to the next byte and page.
 $D30A INC H         ; }
 $D30B LD A,(DE)     ; {Combine the bits which moved on.
 $D30C OR (HL)       ; }
 $D30D DEC H         ; {Point at the first byte of the graphic.
 $D30E LD L,C        ; }
 $D30F OR (HL)       ; {Combine its bits which stay and store the byte.
 $D310 LD (DE),A     ; }
 $D311 INC DE        ; {Move on to the next byte and page.
 $D312 INC H         ; }
 $D313 LD A,(DE)     ; {Combine the bits which moved on with the next byte of
 $D314 OR (HL)       ; the buffer.
 $D315 LD (DE),A     ; }
 $D316 DEC H         ; Go back to the first page.
 $D317 EX DE,HL      ; {Move on to the next row of the buffer.
 $D318 LD BC,$0016   ;
 $D31B ADD HL,BC     ;
 $D31C EX DE,HL      ; }
 $D31D EX AF,AF'     ; Switch in the number of rows.
 $D31E DEC A         ; Count it down.
 $D31F JR NZ,$D303   ; Jump to #R$D303 until the rows are done.
 $D321 JR $D2FD      ; Jump to #R$D2FD.
; Draw an aligned strip.
@label=DrawStripGraphic_Aligned
*$D323 EX DE,HL      ; Put the buffer address in #REGhl.
 $D324 LD A,($BBF2)  ; {Fetch #R$BBF2 and test it.
 $D327 AND A         ; }
 $D328 JR NZ,$D33E   ; Jump to #R$D33E if it is set.
 $D32A LD BC,$0017   ; Set #REGbc to #N$0017.
 $D32D EX AF,AF'     ; Switch in the number of rows.
@label=DrawStripGraphic_AlignedLoop
*$D32E EX AF,AF'     ; Keep the number of rows in #REGa'.
 $D32F POP DE        ; Fetch a row of the graphic.
 $D330 LD A,(HL)     ; {Combine the first byte with the buffer.
 $D331 OR E          ;
 $D332 LD (HL),A     ; }
 $D333 INC HL        ; Move on to the next byte of the buffer.
 $D334 LD A,(HL)     ; {Combine the second byte with the buffer.
 $D335 OR D          ;
 $D336 LD (HL),A     ; }
 $D337 ADD HL,BC     ; Move on to the next row of the buffer.
 $D338 EX AF,AF'     ; Switch in the number of rows.
 $D339 DEC A         ; Count it down.
 $D33A JR NZ,$D32E   ; Jump to #R$D32E until the rows are done.
 $D33C JR $D2FD      ; Jump to #R$D2FD.
; Draw an aligned strip that is flipped.
@label=DrawStripGraphic_AlignedMirrored
*$D33E LD B,$F9      ; Point #REGb at #R$F900.
 $D340 EX AF,AF'     ; Switch in the number of rows.
@label=DrawStripGraphic_AlignedMirroredLoop
*$D341 EX AF,AF'     ; Keep the number of rows in #REGa'.
 $D342 POP DE        ; Fetch a row of the graphic.
 $D343 LD C,D        ; Point at the second byte, turned round.
 $D344 LD A,(BC)     ; {Combine it with the first byte of the buffer.
 $D345 OR (HL)       ;
 $D346 LD (HL),A     ; }
 $D347 INC HL        ; Move on to the next byte of the buffer.
 $D348 LD C,E        ; Point at the first byte, turned round.
 $D349 LD A,(BC)     ; {Combine it with the second byte of the buffer.
 $D34A OR (HL)       ;
 $D34B LD (HL),A     ; }
 $D34C LD DE,$0017   ; {Move on to the next row of the buffer.
 $D34F ADD HL,DE     ; }
 $D350 EX AF,AF'     ; Switch in the number of rows.
 $D351 DEC A         ; Count it down.
 $D352 JR NZ,$D341   ; Jump to #R$D341 until the rows are done.
 $D354 JR $D2FD      ; Jump to #R$D2FD.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$C4A7 }
; LIST#

; Colour Wall Column
;
; Used by the routine at #R$D3C2.
; .
; Sets the attributes of a column of
; #R$F044 from the strip to the bottom of the
; view. The colour is bright green, cyan, yellow
; or white, from the lowest two bits of #R$BBC0.
;
; D The vertical position of the strip
; E The horizontal position of the strip
;
; Return unless the strip is in the view.
@label=ColourWallColumn
c$D356 LD A,D        ; {Return if it is below the bottom of the view.
 $D357 SUB $BF       ;
 $D359 RET NC        ; }
 $D35A NEG           ; Make the number of pixel rows to the bottom.
 $D35C SRL A         ; {Divide it by eight.
 $D35E SRL A         ;
 $D360 SRL A         ; }
 $D362 RET Z         ; Return if there are none.
; Colour the column.
 $D363 LD B,A        ; Set the number of character rows.
 $D364 EX DE,HL      ; Put the position in #REGhl.
 $D365 CALL $E579    ; Call #R$E579.
 $D368 LD A,($BBC0)  ; Fetch #R$BBC0.
 $D36B AND %00000011 ; Keep the lowest two bits.
 $D36D OR %01000100  ; Make the colour bright green, cyan, yellow or white.
 $D36F JP $C889      ; Jump to #R$C889.

; Draw Cell With Walls
;
; Used by the routine at #R$CF08.
; .
; Draws the walls of a building in a cell
; of the village, using the lists of strips in
; #R$62A4. The list is chosen from the tile of
; the cell and #R$BBBA. Nothing is drawn if the
; cell is empty. A list holds sixteen steps of
; two strips each, one above the other. They
; are drawn in two runs of eight, going up and
; to the right and then down and to the right,
; with the second run flipped by #R$BBF2, to
; make the two walls which can be seen. Each
; step is drawn by #R$D3C2, and nothing more is
; drawn when all of the bits in #R$BBBB are set.
;
; HL The cell: the column in #REGl and the row in #REGh
;
; Find the list of strips.
@label=DrawCellWithWalls
c$D372 CALL $D564    ; Call #R$D564.
 $D375 RET Z         ; Return if the cell is empty.
 $D376 LD ($BBC0),A  ; Set #R$BBC0.
 $D379 ADD A,A       ; Double the tile.
 $D37A LD HL,$BBBA   ; {Add #R$BBBA.
 $D37D OR (HL)       ; }
 $D37E LD BC,$62A4   ; Point #REGbc at #R$62A4.
 $D381 CALL $D589    ; Call #R$D589.
 $D384 PUSH HL       ; {Copy the list address to #REGiy (using the stack).
 $D385 POP IY        ; }
; Find the position and draw strips as they are.
 $D387 CALL $D508    ; Call #R$D508.
 $D38A XOR A         ; {Write #N$00 to *#R$BBF2.
 $D38B LD ($BBF2),A  ; }
 $D38E LD B,$08      ; Set a count of #N$08.
; Draw eight steps going up and to the right.
@label=DrawCellWithWalls_Up
*$D390 CALL $D3C2    ; Call #R$D3C2.
 $D393 LD HL,($BBBB) ; Fetch #R$BBBB.
 $D396 LD A,L        ; {Return if all sixteen bits are set.
 $D397 AND H         ;
 $D398 CPL           ;
 $D399 AND A         ;
 $D39A RET Z         ; }
 $D39B CALL $D250    ; Call #R$D250.
 $D39E DJNZ $D390    ; Jump to #R$D390 if there are any left.
; Move up by eight pixels to start the second run.
 $D3A0 LD HL,($BBB8) ; {Move #R$BBB8 up by eight pixels.
 $D3A3 LD DE,$0008   ;
 $D3A6 ADD HL,DE     ;
 $D3A7 LD ($BBB8),HL ; }
; Draw the rest of the strips flipped.
 $D3AA LD A,$01      ; {Write #N$01 to *#R$BBF2.
 $D3AC LD ($BBF2),A  ; }
 $D3AF LD B,$08      ; Set a count of #N$08.
; Draw eight steps going down and to the right.
@label=DrawCellWithWalls_Down
*$D3B1 CALL $D3C2    ; Call #R$D3C2.
 $D3B4 LD HL,($BBBB) ; Fetch #R$BBBB.
 $D3B7 LD A,L        ; {Return if all sixteen bits are set.
 $D3B8 AND H         ;
 $D3B9 CPL           ;
 $D3BA AND A         ;
 $D3BB RET Z         ; }
 $D3BC CALL $D22D    ; Call #R$D22D.
 $D3BF DJNZ $D3B1    ; Jump to #R$D3B1 if there are any left.
 $D3C1 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$C54B }
; LIST#

; Draw Wall Strips
;
; Used by the routine at #R$D372.
; .
; Draws two wall strips, one above the
; other, for a step along the edge of a cell. A
; bit in #R$BBBB is set to record that the
; column has a wall in it, and if it already has
; one the step is skipped. The horizontal
; position in #R$BBB6 chooses the bit, and is
; written into the BIT instruction at #R$D3E2
; and the SET instruction at #R$D3C2(#N$D3E6).
; The lower strip is drawn at #R$BBB8 by
; #R$D425, the column is coloured by #R$D356,
; and the upper strip #N$40 above it. The step
; is skipped if either position is off the
; screen. It always moves on to the next two
; strips of the list.
;
; BC The count of steps in #REGb
; IY The address of the first strip of the step in its list
;
; Return unless the column is on the screen.
@label=DrawWallStrips
c$D3C2 LD HL,($BBB6) ; Fetch #R$BBB6.
 $D3C5 LD A,H        ; {Jump to #R$D410 if it is off the screen.
 $D3C6 AND A         ;
 $D3C7 JR NZ,$D410   ; }
; Keep the position and change the BIT and SET
; instructions.
 $D3C9 LD A,L        ; {Keep the horizontal position in #REGe.
 $D3CA LD E,A        ; }
 $D3CB RRCA          ; Move the bits which say which sixteen pixels it is in...
 $D3CC AND %00111000 ; ...to make the number of a bit...
 $D3CE OR %01000110  ; ...in the second byte of a BIT instruction.
 $D3D0 LD ($D3E3),A  ; Store it as the second byte of the BIT instruction at
                     ; #R$D3E2.
 $D3D3 OR %10000000  ; Change it to the second byte of a SET instruction.
 $D3D5 LD ($D3E7),A  ; Store it as the second byte of the SET instruction
                     ; at #R$D3C2(#N$D3E7).
; Choose the byte of #R$BBBB.
 $D3D8 LD A,L        ; Fetch the horizontal position again.
 $D3D9 RLCA          ; Move the top bit of the horizontal position...
 $D3DA AND %00000001 ; ...into a single bit.
 $D3DC LD HL,$BBBB   ; Point #REGhl at #R$BBBB.
 $D3DF JR Z,$D3E2    ; Jump to #R$D3E2 if the position is in the first half of
                     ; the screen.
 $D3E1 INC HL        ; Point #REGhl at the second byte of the flags.
; Test and set the flag for this column.
@label=DrawWallStrips_Test
*$D3E2 BIT 0,(HL)    ; {Jump to #R$D410 if there is already a wall there.
 $D3E4 JR NZ,$D410   ; }
 $D3E6 SET 0,(HL)    ; Set the bit.
; Draw the lower strip and colour the column.
 $D3E8 LD HL,($BBB8) ; Fetch #R$BBB8.
 $D3EB LD A,H        ; {Jump to #R$D410 if it is off the screen.
 $D3EC AND A         ;
 $D3ED JR NZ,$D410   ; }
 $D3EF LD D,L        ; Keep the low byte of the vertical position in #REGd.
 $D3F0 PUSH BC       ; {Stash the count of steps and the position on the stack.
 $D3F1 PUSH DE       ; }
 $D3F2 CALL $D425    ; Call #R$D425.
 $D3F5 POP DE        ; {Restore the position from the stack and stash it again.
 $D3F6 PUSH DE       ; }
 $D3F7 CALL $D356    ; Call #R$D356.
 $D3FA POP DE        ; Restore the position from the stack.
 $D3FB INC IY        ; Move on to the next strip of the list.
; Draw the upper strip.
 $D3FD LD HL,($BBB8) ; Fetch #R$BBB8.
 $D400 LD BC,$0040   ; Set #REGbc to #N$0040.
 $D403 ADD HL,BC     ; Move up by that much.
 $D404 LD A,H        ; {Jump to #R$D40C if it is off the screen.
 $D405 AND A         ;
 $D406 JR NZ,$D40C   ; }
 $D408 LD D,L        ; Keep the low byte of the vertical position in #REGd.
 $D409 CALL $D425    ; Call #R$D425.
; Restore the count and move on.
@label=DrawWallStrips_Done
*$D40C POP BC        ; Restore the count of steps from the stack.
 $D40D INC IY        ; Move on to the next strip of the list.
 $D40F RET           ; Return.
; There is nothing to draw, so skip both of the strips.
@label=DrawWallStrips_Skip
*$D410 INC IY        ; {Move on past the two strips of the list.
 $D412 INC IY        ; }
 $D414 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$C59B }
; LIST#

; Clip Wall Strip Top
;
; Used by the routine at #R$D425.
; .
; Skips the rows of a wall strip that are
; below #R$E5C4. #REGa is the number of those
; rows, negated. It starts drawing at #N$48 and
; jumps to #R$D43D.
;
; A The number of rows below the buffer, negated
; HL The address of the graphic
;
; Skip the rows that are below the buffer.
@label=ClipWallStripTop
c$D415 NEG           ; {Make the number of rows positive and keep it in #REGc.
 $D417 LD C,A        ; }
 $D418 LD A,(HL)     ; {Fetch the height of the graphic.
 $D419 INC HL        ; }
 $D41A SUB C         ; Subtract the rows that are below.
 $D41B RET M         ; {Return if there are none left.
 $D41C RET Z         ; }
 $D41D LD B,$00      ; {Skip the image data for those rows.
 $D41F ADD HL,BC     ;
 $D420 ADD HL,BC     ; }
 $D421 LD D,$48      ; Set the vertical position to #N$48.
 $D423 JR $D43D      ; Jump to #R$D43D.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$C5E9 }
; LIST#

; Draw Wall Strip
;
; Used by the routine at #R$D3C2.
; .
; Draws a wall strip, sixteen pixels wide,
; into #R$E5C4. The graphic has the same format
; as #R$D2B2, but it replaces the buffer. The
; masks from #R$D4EF are written into the AND
; instructions. The graphic is flipped if
; #R$BBF2 is not zero.
;
; D The vertical position of the bottom of the strip
; E The horizontal position of the strip
; IY The address of the strip number
;
; Find the graphic and clip it to the buffer.
@label=DrawWallStrip
c$D425 LD A,(IY+$00) ; Fetch the strip number.
 $D428 LD BC,$6E36   ; Point #REGbc at #R$6E36.
 $D42B CALL $D589    ; Call #R$D589.
 $D42E LD A,D        ; {Subtract #N$48 from the vertical position.
 $D42F SUB $48       ; }
 $D431 JR C,$D415    ; Jump to #R$D415 if it is below the bottom.
 $D433 SUB $70       ; Subtract #N$70.
 $D435 RET NC        ; Return if it is above the top.
 $D436 NEG           ; Make it the number of rows in the buffer.
 $D438 CP (HL)       ; Compare it with the height of the graphic.
 $D439 JR C,$D43C    ; Jump to #R$D43C if it is fewer.
 $D43B LD A,(HL)     ; Use the height of the graphic.
; Draw the rows that are in the buffer.
@label=DrawWallStrip_Height
*$D43C INC HL        ; Move on to the first row of the graphic.
; This entry point is used by the routine at #R$D415.
@label=DrawWallStrip_Draw
*$D43D EX AF,AF'     ; Keep the number of rows in #REGa'.
 $D43E EX DE,HL      ; Put the position in #REGhl.
 $D43F CALL $E53A    ; Call #R$E53A.
 $D442 EX DE,HL      ; Switch the buffer and the graphic.
 $D443 PUSH HL       ; Stash the graphic on the stack.
; Write the masks from #R$D4EF into the AND
; instructions.
 $D444 LD A,($BBB6)  ; Fetch #R$BBB6.
 $D447 RRCA          ; Move the shift into the lowest bits.
 $D448 AND %00000011 ; Keep the lowest two bits.
 $D44A LD HL,$D4EF   ; Point #REGhl at #R$D4EF.
 $D44D CALL $E596    ; Call #R$E596.
 $D450 LD A,(HL)     ; Fetch the mask.
 $D451 LD ($D47C),A  ; {Set the left-hand AND operands.
 $D454 LD ($D4A3),A  ; }
 $D457 CPL           ; Complement the mask.
 $D458 LD ($D48A),A  ; {Set the right-hand AND operands.
 $D45B LD ($D4B2),A  ; }
; Choose the draw path.
 $D45E POP HL        ; Restore the graphic from the stack.
 $D45F LD ($BBAE),SP ; Set #R$BBAE.
 $D463 LD SP,HL      ; Point the stack at the graphic.
 $D464 LD A,($BBB6)  ; Fetch #R$BBB6.
 $D467 AND %00000110 ; Keep bits 1 and 2.
 $D469 JR Z,$D4C2    ; Jump to #R$D4C2 if the graphic is aligned.
 $D46B OR %11110000  ; Set the high bits of the page.
 $D46D LD H,A        ; Set #REGh.
 $D46E LD A,($BBF2)  ; Fetch #R$BBF2.
 $D471 AND A         ; {Jump to #R$D49D if it is set.
 $D472 JR NZ,$D49D   ; }
 $D474 SET 3,H       ; Set bit 3 of #REGh.
 $D476 EX AF,AF'     ; Switch in the number of rows.
; Draw a shifted row.
@label=DrawWallStrip_Shifted
*$D477 EX AF,AF'     ; Keep the number of rows in #REGa'.
 $D478 POP BC        ; {Fetch a row and point at the first byte.
 $D479 LD L,C        ; }
 $D47A LD A,(DE)     ; Fetch the first byte of the buffer.
 $D47B AND %00000000 ; Keep the bits which are not covered.
 $D47D OR (HL)       ; {Combine it and store the byte.
 $D47E LD (DE),A     ; }
 $D47F INC DE        ; {Move on to the next byte and page.
 $D480 INC H         ; }
 $D481 LD A,(HL)     ; Look up the bits which moved on.
 $D482 DEC H         ; Go back to the first page.
 $D483 LD L,B        ; Point at the second byte of the graphic.
 $D484 OR (HL)       ; {Combine it and store the byte.
 $D485 LD (DE),A     ; }
 $D486 INC DE        ; {Move on to the next byte and page.
 $D487 INC H         ; }
 $D488 LD A,(DE)     ; Fetch the third byte of the buffer.
 $D489 AND %00000000 ; Keep the bits which are not covered.
 $D48B OR (HL)       ; {Combine it and store the byte.
 $D48C LD (DE),A     ; }
 $D48D DEC H         ; Go back to the first page.
 $D48E EX DE,HL      ; {Move on to the next row of the buffer.
 $D48F LD BC,$0016   ;
 $D492 ADD HL,BC     ;
 $D493 EX DE,HL      ; }
 $D494 EX AF,AF'     ; Switch in the number of rows.
 $D495 DEC A         ; Count it down.
 $D496 JR NZ,$D477   ; Jump to #R$D477 until the rows are done.
; Put the stack back.
@label=DrawWallStrip_Done
*$D498 LD SP,($BBAE) ; {Fetch #R$BBAE and return.
 $D49C RET           ; }
; Draw a shifted row that is flipped.
@label=DrawWallStrip_MirroredShifted
*$D49D EX AF,AF'     ; Switch in the number of rows.
@label=DrawWallStrip_MirroredLoop
*$D49E EX AF,AF'     ; Keep the number of rows in #REGa'.
 $D49F POP BC        ; {Fetch a row and point at the second byte.
 $D4A0 LD L,B        ; }
 $D4A1 LD A,(DE)     ; Fetch the first byte of the buffer.
 $D4A2 AND %00000000 ; Keep the bits which are not covered.
 $D4A4 OR (HL)       ; {Combine it and store the byte.
 $D4A5 LD (DE),A     ; }
 $D4A6 INC DE        ; {Move on to the next byte and page.
 $D4A7 INC H         ; }
 $D4A8 LD B,(HL)     ; Look up the bits which moved on.
 $D4A9 DEC H         ; Go back to the first page.
 $D4AA LD L,C        ; Point at the first byte of the graphic.
 $D4AB LD A,(HL)     ; Fetch the bits which stay.
 $D4AC OR B          ; {Combine them and store the byte.
 $D4AD LD (DE),A     ; }
 $D4AE INC DE        ; {Move on to the next byte and page.
 $D4AF INC H         ; }
 $D4B0 LD A,(DE)     ; Fetch the third byte of the buffer.
 $D4B1 AND %00000000 ; Keep the bits which are not covered.
 $D4B3 OR (HL)       ; {Combine it and store the byte.
 $D4B4 LD (DE),A     ; }
 $D4B5 DEC H         ; Go back to the first page.
 $D4B6 EX DE,HL      ; {Move on to the next row of the buffer.
 $D4B7 LD BC,$0016   ;
 $D4BA ADD HL,BC     ;
 $D4BB EX DE,HL      ; }
 $D4BC EX AF,AF'     ; Switch in the number of rows.
 $D4BD DEC A         ; Count it down.
 $D4BE JR NZ,$D49E   ; Jump to #R$D49E until the rows are done.
 $D4C0 JR $D498      ; Jump to #R$D498.
; Draw an aligned graphic.
@label=DrawWallStrip_Aligned
*$D4C2 EX DE,HL      ; Put the buffer address in #REGhl.
 $D4C3 LD A,($BBF2)  ; {Fetch #R$BBF2 and test it.
 $D4C6 AND A         ; }
 $D4C7 JR NZ,$D4D9   ; Jump to #R$D4D9 if it is set.
 $D4C9 LD BC,$0017   ; Set #REGbc to #N$0017.
 $D4CC EX AF,AF'     ; Switch in the number of rows.
@label=DrawWallStrip_AlignedLoop
*$D4CD EX AF,AF'     ; Keep the number of rows in #REGa'.
 $D4CE POP DE        ; Fetch a row of the graphic.
 $D4CF LD (HL),E     ; {Store the first byte and move on.
 $D4D0 INC HL        ; }
 $D4D1 LD (HL),D     ; Store the second byte.
 $D4D2 ADD HL,BC     ; Move on to the next row of the buffer.
 $D4D3 EX AF,AF'     ; Switch in the number of rows.
 $D4D4 DEC A         ; Count it down.
 $D4D5 JR NZ,$D4CD   ; Jump to #R$D4CD until the rows are done.
 $D4D7 JR $D498      ; Jump to #R$D498.
; Draw an aligned graphic that is flipped.
@label=DrawWallStrip_AlignedMirrored
*$D4D9 LD B,$F9      ; Point #REGb at #R$F900.
 $D4DB EX AF,AF'     ; Switch in the number of rows.
@label=DrawWallStrip_AlignedMirroredLoop
*$D4DC EX AF,AF'     ; Keep the number of rows in #REGa'.
 $D4DD POP DE        ; Fetch a row of the graphic.
 $D4DE LD C,D        ; Point at the second byte, turned round.
 $D4DF LD A,(BC)     ; {Store it in the first byte of the buffer.
 $D4E0 LD (HL),A     ; }
 $D4E1 INC HL        ; Move on to the next byte of the buffer.
 $D4E2 LD C,E        ; Point at the first byte, turned round.
 $D4E3 LD A,(BC)     ; {Store it in the second byte of the buffer.
 $D4E4 LD (HL),A     ; }
 $D4E5 LD DE,$0017   ; {Move on to the next row of the buffer.
 $D4E8 ADD HL,DE     ; }
 $D4E9 EX AF,AF'     ; Switch in the number of rows.
 $D4EA DEC A         ; Count it down.
 $D4EB JR NZ,$D4DC   ; Jump to #R$D4DC until the rows are done.
 $D4ED JR $D498      ; Jump to #R$D498.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$C5F9 }
; LIST#

; Wall Strip Masks
;
; The four masks used by #R$D425 to keep
; the bits of the buffer on the left of a wall
; strip. The index is the shift to the right in
; twos of pixels: #N($00), #N($02), #N$04 or
; #N$06.
@label=WallStripMasks
b$D4EF DEFB $00      ; Shift #N$00: #N$00.
 $D4F0 DEFB $C0      ; Shift #N$02: #N$C0.
 $D4F1 DEFB $F0      ; Shift #N$04: #N$F0.
 $D4F2 DEFB $FC      ; Shift #N$06: #N$FC.
; View the equivalent data in;
; #LIST
; { #GUNFRIGHT$C6C3 }
; LIST#

; Project Object
;
; Used by the routine at #R$E3D9.
; .
; Works out where an object is on the
; screen, in the same way as #R$D508. It fetches
; the position from the slot, calls #R$D18E, and
; jumps to #R$D515. The result is put in #R$BBB6
; and #R$BBB8.
;
; IX The address of the object
;
; Fetch the position and convert it.
@label=ProjectObject
c$D4F3 LD L,(IX+$03) ; {Fetch the vertical position.
 $D4F6 LD H,(IX+$04) ; }
 $D4F9 CALL $D18E    ; Call #R$D18E.
 $D4FC PUSH HL       ; Stash it on the stack.
 $D4FD LD L,(IX+$01) ; {Fetch the horizontal position.
 $D500 LD H,(IX+$02) ; }
 $D503 CALL $D18E    ; Call #R$D18E.
 $D506 JR $D515      ; Jump to #R$D515.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$C6C7 }
; LIST#

; Project Cell
;
; Used by the routines at #R$D19D and #R$D372.
; .
; Works out where the corner of the cell
; last set by #R$D564 is on the screen. With the
; distances from the player as dx and dy, the
; horizontal position is (dx + dy + #N$00F0) /
; 2 and the vertical position is (dy - dx +
; #N$01B0) / 4. They are put in #R$BBB6 and
; #R$BBB8. When bit 0 of #R$BBBA is set, the
; player's position is turned round.
;
; .
;
; Set the position of the corner of the
; cell.
@label=ProjectCell
c$D508 LD A,($BBB5)  ; {Fetch #R$BBB5 as a position in #REGhl.
 $D50B LD L,$00      ;
 $D50D LD H,A        ; }
 $D50E PUSH HL       ; Stash it on the stack.
 $D50F LD A,($BBB4)  ; {Fetch #R$BBB4 as a position in #REGhl.
 $D512 LD L,$00      ;
 $D514 LD H,A        ; }
; This entry point is used by the routine at #R$D4F3.
; .
; Find the position on the screen. #REGhl
; is the horizontal position, and the vertical
; position is on the stack.
@label=ProjectCell_Position
*$D515 LD DE,($BC8F) ; Fetch the player's horizontal
                     ; position from #R$BC8E(#N$BC8F).
 $D519 LD A,($BBBA)  ; Fetch #R$BBBA.
 $D51C AND %00000001 ; Keep the lowest bit.
 $D51E JR Z,$D528    ; Jump to #R$D528 if the view is not rotated.
 $D520 LD A,E        ; {Complement #REGe.
 $D521 CPL           ;
 $D522 LD E,A        ; }
 $D523 LD A,D        ; {Complement #REGd.
 $D524 CPL           ; }
 $D525 AND %00011111 ; Keep the lowest five bits.
 $D527 LD D,A        ; Set #REGd.
; Find the horizontal distance.
@label=ProjectCell_X
*$D528 AND A         ; {Subtract the player's position.
 $D529 SBC HL,DE     ; }
 $D52B EX DE,HL      ; Copy the distance into #REGde.
 $D52C POP HL        ; Restore the vertical position from the stack.
; Find the vertical distance.
 $D52D LD BC,($BC91) ; Fetch the player's vertical
                     ; position from #R$BC8E(#N$BC91).
 $D531 LD A,($BBBA)  ; Fetch #R$BBBA.
 $D534 AND %00000001 ; Keep the lowest bit.
 $D536 JR Z,$D540    ; Jump to #R$D540 if the view is not rotated.
 $D538 LD A,C        ; {Complement #REGc.
 $D539 CPL           ;
 $D53A LD C,A        ; }
 $D53B LD A,B        ; {Complement #REGb.
 $D53C CPL           ; }
 $D53D AND %00011111 ; Keep the lowest five bits.
 $D53F LD B,A        ; Set #REGb.
; Work out the screen position.
@label=ProjectCell_Y
*$D540 AND A         ; {Subtract the player's position.
 $D541 SBC HL,BC     ; }
 $D543 PUSH HL       ; Stash the distance on the stack.
 $D544 LD BC,$00F0   ; Set #REGbc to #N$00F0.
 $D547 ADD HL,DE     ; {Add the two distances and #N$00F0.
 $D548 ADD HL,BC     ; }
 $D549 SRA H         ; {Halve it.
 $D54B RR L          ; }
 $D54D LD ($BBB6),HL ; Set #R$BBB6.
 $D550 POP HL        ; Restore the vertical distance from the stack.
 $D551 AND A         ; {Subtract the horizontal distance.
 $D552 SBC HL,DE     ; }
 $D554 LD BC,$01B0   ; Set #REGbc to #N$01B0.
 $D557 ADD HL,BC     ; Add it.
 $D558 SRA H         ; {Divide it by four.
 $D55A RR L          ;
 $D55C SRA H         ;
 $D55E RR L          ; }
 $D560 LD ($BBB8),HL ; {Set #R$BBB8 and return.
 $D563 RET           ; }
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$C6DC }
; LIST#

; Get Map Cell
;
; Used by the routines at #R$CF08, #R$D19D, #R$D372, #R$D88E and #R$D8E7.
; .
; Fetches the tile of a cell from #R$5E04,
; which is thirty-two rows of thirty-two. #REGl
; is the column and #REGh is the row. It sets
; #R$BBB4 and #R$BBB5. When bit 0 of #R$BBBA is
; set, the map is read from the end.
;
;   HL The cell: the column in #REGl and the row in #REGh
; O:A The tile for the cell
; O:F The zero flag is set if the cell is empty
;
; Work out the number of the cell.
@label=GetMapCell
c$D564 LD ($BBB4),HL ; Set #R$BBB4 and #R$BBB5.
 $D567 LD A,L        ; {Put the column in #REGa and the row in #REGhl.
 $D568 LD L,H        ;
 $D569 LD H,$00      ; }
 $D56B ADD HL,HL     ; {Multiply the row by #N$20.
 $D56C ADD HL,HL     ;
 $D56D ADD HL,HL     ;
 $D56E ADD HL,HL     ;
 $D56F ADD HL,HL     ; }
 $D570 OR L          ; {Add the column.
 $D571 LD L,A        ; }
; Point at the map.
 $D572 LD BC,$5E04   ; Point #REGbc at #R$5E04.
 $D575 LD A,($BBBA)  ; Fetch #R$BBBA.
 $D578 AND %00000001 ; Keep the lowest bit.
 $D57A JR Z,$D585    ; Jump to #R$D585 if the view is not rotated.
; Read from the end.
 $D57C LD A,L        ; {Complement #REGhl.
 $D57D CPL           ;
 $D57E LD L,A        ;
 $D57F LD A,H        ;
 $D580 CPL           ;
 $D581 LD H,A        ; }
 $D582 LD BC,$6204   ; Point #REGbc past #R$5E04.
; Fetch the tile.
@label=GetMapCell_Tile
*$D585 ADD HL,BC     ; Add the address of the map.
 $D586 LD A,(HL)     ; {Fetch the tile and return.
 $D587 AND A         ;
 $D588 RET           ; }
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$C738 }
; LIST#

; Get Table Entry
;
; Used by the routines at #R$C1FD, #R$C3BD, #R$D19D, #R$D1FA, #R$D273, #R$D372,
; #R$D425, #R$D593, #R$E063, #R$E0A0 and #R$E353.
; .
; Fetches the word at #REGbc plus twice
; #REGa into #REGhl.
;
;   A The number of the entry
;   BC The address of the table
; O:HL The word from the table
;
; Find the address of the entry.
@label=GetTableEntry
c$D589 LD L,A        ; {Put the number of the entry in #REGhl.
 $D58A LD H,$00      ; }
 $D58C ADD HL,HL     ; Double it.
 $D58D ADD HL,BC     ; Add the address of the table.
; Fetch the word.
 $D58E LD A,(HL)     ; Fetch the low byte.
 $D58F INC HL        ; Move on to the high byte.
 $D590 LD H,(HL)     ; Fetch it into #REGh.
 $D591 LD L,A        ; {Put the low byte in #REGl and return.
 $D592 RET           ; }
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$C75C }
; { #MARTIANOIDS$C010 }
; { #PENTAGRAM$D692 }
; LIST#

; Jump To Table Routine
;
; Used by the routines at #R$BDFE, #R$C083, #R$CFF2, #R$DC60, #R$DD28 and
; #R$DE59.
; .
; Calls #R$D589 to fetch a routine from a
; table, then jumps to #R$5CB0 so that the
; routine returns to the caller of this one.
;
; A The number of the entry
; BC The address of the table
;
; Fetch the address and jump to it.
@label=JumpToTableRoutine
c$D593 CALL $D589    ; Call #R$D589.
 $D596 JP $5CB0      ; Jump to #R$5CB0.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$C766 }
; LIST#

