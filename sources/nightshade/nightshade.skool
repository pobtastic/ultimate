; Attribute Buffer
;
; The buffer that the attributes of the playing area are made in before
; they are copied to the screen. It is #N$18 bytes wide and #N$0E rows high.
@label=AttributeBuffer
s$F044 DEFS $17
@label=AttributeBuffer_FirstRowEnd
 $F05B DEFS $0139

; Unused
;
; #N$6C bytes that the game does not use.
@label=AttributeBuffer_End
s$F194 DEFS $6C

; Reversed Shift Tables
;
; Six pages of tables that are built by #R$E0FB, which shift the bytes
; with their bits reversed by two, four and six pixels. For each shift there is
; a page for the low byte of the result and a page for the high byte. The
; contents at the time of the snapshot are left over from loading.
@label=ReversedShiftTables
s$F200 DEFS $0600

; Unused
;
; A page that the game does not use.
s$F800 DEFS $0100

; Reverse Bits Table
;
; The table that is built by #R$E0FB, which holds each byte with its bits
; reversed. The contents at the time of the snapshot are left over from loading.
@label=ReverseBitsTable
s$F900 DEFS $0100

