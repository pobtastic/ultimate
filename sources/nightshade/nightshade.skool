; { #TRANZAM$7211 }
; LIST#

; Clear Attributes
;
; Used by the routine at #R$E59D.
; .
; Sets the attributes of the screen to white ink on black paper.
@label=ClearAttributes
c$E5B0 LD HL,$5800   ; {Point at #N$5800 (in the attribute buffer), and count
 $E5B3 LD BC,$0300   ; the bytes.}
 $E5B6 LD E,$47      ; Use the attribute for white ink on black paper.
 $E5B8 JR $E5BC      ; Jump to #R$E5BC to fill them.

; Fill Memory
;
; Used by the routines at #R$BDFE and #R$E5A8.
; .
; Fills an area of memory with zero. The entry point at #R$E5BC fills it
; with the byte in #REGe.
;
; BC Number of bytes
; HL Address of the first byte
@label=FillMemory
c$E5BA LD E,$00      ; Set #REGe to #N$00.
; This entry point is used by the routine at #R$E5B0.
; .
; Fill the memory, and loop back until all of the bytes have been filled.
@label=FillMemory_WithValue
*$E5BC LD (HL),E     ; Write #REGe.
 $E5BD INC HL        ; Increment #REGhl.
 $E5BE DEC BC        ; Decrement #REGbc.
 $E5BF LD A,B        ; {Jump to #R$E5BC if #REGbc is not zero.
 $E5C0 OR C          ;
 $E5C1 JR NZ,$E5BC   ; }
 $E5C3 RET           ; Return.
