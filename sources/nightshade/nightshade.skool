 $D619 DEFW $CE89,$CE89,$CE89,$CE89,$CE89,$CE89,$CE89,$CE89,$CE89,$CE89,$CE89,$CE89,$CE89,$CE89,$CE89,$CE89 ; Types
                                                                                                            ; #N$40 to
                                                                                                            ; #N$4F:
                                                                                                            ; #R$CE89.
 $D639 DEFW $D7ED,$D7ED,$D7ED,$D7ED,$D7ED,$D7ED,$D7ED,$D7ED,$D7ED,$D7ED,$D7ED,$D7ED,$D7ED,$D7ED,$D7ED,$D7ED ; Types
