;
; SkoolKit ref file for Nightshade
;
; To build the HTML disassembly, run these commands:
;   tap2sna.py @nightshade.t2s
;   sna2skool.py -H -c sources/nightshade/nightshade.ctl Nightshade.z80 \
;     > sources/nightshade/nightshade.skool
;   skool2html.py -H sources/nightshade/nightshade.skool -T dark -T wide -toOa

