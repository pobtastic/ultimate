[Game+]
Canonical=
OgImage=
GameIndexUrl=

[Template:Layout]
<!DOCTYPE html>
<html lang="en">
<head>
<title>{Game[Game]}: {SkoolKit[title]}</title>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content="{Game[Game]}: {SkoolKit[title]}. Complete ZX Spectrum RAM disassembly." />
<meta property="og:title" content="{Game[Game]}: {SkoolKit[title]}" />
<meta property="og:description" content="{Game[Game]}: {SkoolKit[title]}. Complete ZX Spectrum RAM disassembly." />
<meta property="og:site_name" content="ArcadeGeek" />
<# if(SkoolKit[page_id]=='GameIndex') #>
<meta property="og:type" content="website" />
<# else #>
<meta property="og:type" content="article" />
<# endif #>
<# if(Game[Canonical]) #>
<link rel="canonical" href="{Game[Canonical]}" />
<meta property="og:url" content="{Game[Canonical]}" />
<# endif #>
<# if(Game[OgImage]) #>
<meta property="og:image" content="{Game[OgImage]}" />
<meta name="twitter:card" content="summary_large_image" />
<# else #>
<meta name="twitter:card" content="summary" />
<# endif #>
<script type="application/ld+json">
{{
  "@context": "https://schema.org",
  "@graph": [
    {{
      "@type": "WebSite",
      "@id": "https://skoolkit.arcadegeek.co.uk/#website",
      "name": "ArcadeGeek",
      "url": "https://skoolkit.arcadegeek.co.uk/"
    }},
    {{
<# if(SkoolKit[page_id]=='GameIndex') #>
      "@type": "WebPage",
<# else #>
      "@type": "TechArticle",
<# endif #>
      "headline": "{Game[Game]}: {SkoolKit[title]}",
      "name": "{Game[Game]}: {SkoolKit[title]}",
      "description": "{Game[Game]}: {SkoolKit[title]}. Complete ZX Spectrum RAM disassembly.",
      "inLanguage": "en",
      "isPartOf": {{"@id": "https://skoolkit.arcadegeek.co.uk/#website"}},
      "author": {{
        "@type": "Organization",
        "name": "ArcadeGeek",
        "url": "https://www.arcadegeek.co.uk/"
      }},
      "about": {{
        "@type": "VideoGame",
        "name": "{Game[Game]}",
        "gamePlatform": "ZX Spectrum"
      }}
<# if(Game[Canonical]) #>
      ,"url": "{Game[Canonical]}"
<# endif #>
<# if(Game[OgImage]) #>
      ,"image": "{Game[OgImage]}"
<# endif #>
    }},
    {{
      "@type": "BreadcrumbList",
      "itemListElement": [
        {{
          "@type": "ListItem",
          "position": 1,
          "name": "ArcadeGeek",
          "item": "https://skoolkit.arcadegeek.co.uk/"
        }},
        {{
          "@type": "ListItem",
          "position": 2,
          "name": "{Game[Game]}"
<# if(Game[GameIndexUrl]) #>
          ,"item": "{Game[GameIndexUrl]}"
<# endif #>
        }}
<# if(SkoolKit[page_id]!='GameIndex') #>
        ,{{
          "@type": "ListItem",
          "position": 3,
          "name": "{SkoolKit[title]}"
<# if(Game[Canonical]) #>
          ,"item": "{Game[Canonical]}"
<# endif #>
        }}
<# endif #>
      ]
    }}
  ]
}}
</script>
<# foreach($css,SkoolKit[stylesheets]) #>
<link rel="stylesheet" type="text/css" href="{$css[href]}" />
<# endfor #>
<!-- Global site tag (gtag.js) - Google Analytics -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-75RERFCHBG"></script>
<script>
window.dataLayer = window.dataLayer || [];
function gtag(){{dataLayer.push(arguments);}}
gtag('js', new Date());
gtag('config', 'G-75RERFCHBG');
</script>
<# foreach($js,SkoolKit[javascripts]) #>
<script type="text/javascript" src="{$js[src]}"></script>
<# endfor #>
</head>
<body class="{SkoolKit[page_id]}">
<table class="header">
<tr>
<# if(SkoolKit[page_header][0]) #>
<td class="page-header">{SkoolKit[page_header][0]}</td>
<# endif #>
<# if(SkoolKit[page_id]=='GameIndex') #>
<td class="logo">{Game[Logo]}</td>
<# else #>
<td class="logo"><a href="{SkoolKit[index_href]}">{Game[Logo]}</a></td>
<# endif #>
<td class="page-header">{SkoolKit[page_header][1]}</td>
</tr>
</table>
<# include({SkoolKit[include]}) #>
<# include(footer) #>
</body>
</html>
