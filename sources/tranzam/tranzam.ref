)

#DEF(#CAR(id,attr=$07)(fname)
  #SPRITE($id,$7F24,$attr)($fname)
)

#DEF(#CARNAME(id)
  #MAP($id)(
    ?,
    0:"Car: Frame 1",
    1:"Car: Frame 2",
    2:"Car: Frame 3",
    3:"Car: Frame 4",
    4:"Car: Frame 5",
    5:"Car: Frame 6",
    6:"Car: Frame 7",
    7:"Car: Frame 8",
    8:"Car: Frame 9",
