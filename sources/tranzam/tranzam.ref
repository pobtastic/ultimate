)

#DEF(#SIDEBAR()
  #LET(data=$7691)
  #LET(attr=$7751)
  #TABLE(default)
  #FOR($00,$17)(y,{ #FOR(0,7)||x|#UDG($74B1 + #PEEK((y * 8) + x + {data}) * $08,attr=#PEEK((y * 8) + {attr} + x))|| })
  TABLE#
)
