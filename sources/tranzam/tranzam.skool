;
; A copyright message, which is not used by the game.
@label=Text_Copyright
t$7F8B DEFM "COPYRIGHT 1983 A.C.G. ALL RIGHTS RESERVED" ; "COPYRIGHT 1983
                                                        ; A.C.G. ALL RIGHTS
                                                        ; RESERVED".

