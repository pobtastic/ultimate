i$5B00

; Game Entry Point
;
; The entry point of the game. The code and data from #N$5F01 onwards are
; held one byte higher in memory than they are used, so they are moved down by
; one byte before control is passed to #R$5F00.
@label=GameEntry
c$5B80 DI            ; Disable interrupts.
 $5B81 LD HL,$5F01   ; {Move #N$20FF bytes from #N$5F01 to #N$5F00.
 $5B84 LD DE,$5F00   ;
 $5B87 LD BC,$20FF   ;
 $5B8A LDIR          ; }
 $5B8C JP $5F00      ; Jump to #R$5F00.
; View the equivalent code in;
; #LIST
; { #COOKIE$5B80 }
; { #JETPAC$5B80 }
; { #PSSST$5B80 }
; { #SABREWULF$6000 }
; { #UNDERWURLDE$67F2 }
; LIST#
; .
; Later Ultimate games use more advanced decryption mechanisms;
; #LIST
; { #ATICATAC$5B80 }
; { #LUNARJETMAN$5B80 }
; LIST#

i$5B8F

; Indirect Jump
;
; Used by the routine at #R$6009.
; .
; Jumps to the handler address already held in #REGhl. This is the byte
; #N$E9 (JP (HL)) which sits in the Spectrum system variable
; #SKOOLKID$5CB0(NMIADD), reused as a trampoline.
;
; HL Jump address
@label=IndirectJump
c$5CB0 JP (HL)       ; Jump to the address held in #REGhl.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$5CB0 }
; { #LUNARJETMAN$5CB0 }
; { #NIGHTSHADE$5CB0 }
; { #SABREWULF$5CB0 }
; LIST#

i$5CB1

; Best Time
;
; The best time so far, as three BCD bytes. The hours are a single digit
; (in the low nibble). See #R$5E31 for the time of the current game.
@label=BestTime_1
g$5E00 DEFB $00      ; Hours.
@label=BestTime_2
 $5E01 DEFB $06      ; Minutes.
@label=BestTime_3
 $5E02 DEFB $00      ; Seconds.

; Flag: Best Time
;
; When a value for "Best Time" exists this will be #N$01 else it'll be #N$00.
@label=Flag_BestTime
g$5E03 DEFB $00

; Player X Position
;
; The position of the player's car along the map. It is a 24-bit number
; made up of a fraction of a map unit and then the position in map units. The
; fraction is needed because the car moves by less than one map unit each frame
; (see #R$6D73). The map is #N$1800 map units wide.
@label=PlayerMapPosition_Fraction
g$5E04 DEFB $2C      ; Fraction of a map unit.
@label=PlayerMapPosition
 $5E05 DEFW $0E30    ; Position in map units.

; Player Y Position
;
; The position of the player's car up the map, in the same way as
; #R$5E04. The map is #N$0C00 map units high.
@label=PlayerMapPositionY_Fraction
g$5E07 DEFB $00      ; Fraction of a map unit.
@label=PlayerMapPositionY
 $5E08 DEFW $0000    ; Position in map units.

; Fuel
;
; The amount of fuel in the tank, which is shown on the fuel gauge. It is
; used up as the car moves (see #R$6E7E) and set to #N$C0FF by a refuel (see
; #R$7012). The car is out of fuel when the high byte is #N$00.
@label=Fuel_LSB
g$5E0A DEFB $00      ; Low byte.
@label=Fuel_MSB
 $5E0B DEFB $00      ; High byte (#N$C0 is a full tank).

; Temperature
;
; The temperature of the engine, which is shown on the temperature gauge.
; It goes up to #N$C0, rising at high speeds and falling at low speeds (see
; #R$6E95). The car slows down as if it has no fuel when the temperature is
; #N$A0 or more.
@label=Temperature
g$5E0C DEFB $3A

; Speed
;
; The speed of the player's car, which is shown on the speed gauge. It
; goes from #N$00 to #N$C0 (see #R$6D07).
@label=Speed
g$5E0D DEFB $EF

; Unknown
;
; Only ever written to, with #N$0000, when a new car is set up (see
; #R$63C1). Purpose not yet known.
@label=Unknown_5E0E
g$5E0E DEFB $22,$22

; Player Direction
;
; The direction that the player's car is facing, as a #N$0400 step
; circle: #N$0000 is straight up and the car turns clockwise as the number
; increases. Steering changes it by #N$18 each frame (see #R$6E43).
@label=Player_Direction
g$5E10 DEFB $AF      ; Low byte.
 $5E11 DEFB $3A      ; High byte (the quadrant, #N$00-#N$03).

; Unused
;
; This byte is not referenced by the game.
@label=Unused_5E12
g$5E12 DEFB $F5

; Object Quadrant
;
; Which side of the player's car the object being drawn is on, found by
; #R$6B47 and used by #R$6F3C. Bit 1 is set when the object is to the left of
; the car.
@label=Object_Quadrant
g$5E13 DEFB $AC

; Object Screen Position
;
; The position on the screen of the object being drawn, which is worked
; out by #R$6F3C. The values are not used again after that.
@label=Object_Screen_X
g$5E14 DEFB $36      ; X position.
@label=Object_Screen_Y
 $5E15 DEFB $0E      ; Y position.

; Unused
;
; This byte is not referenced by the game.
@label=Unused_5E16
g$5E16 DEFB $00

; Object Distance X
;
; The horizontal distance (always positive, in map units) from the
; player's car to the object being drawn, which is worked out by #R$6B47.
@label=Object_Distance_X
g$5E17 DEFB $00

; Object Distance Y
;
; The vertical distance (always positive, in map units) from the
; player's car to the object being drawn, which is worked out by #R$6B47.
@label=Object_Distance_Y
g$5E18 DEFB $06

; Current Object
;
; The address of the first entry in #R$7811 which might be in view of the
; player's car. #R$6B47 starts from here, and it is kept up to date by #R$6BFE
; and #R$6C2D.
@label=CurrentObject
g$5E19 DEFW $0000

; Flag: Pointer Moved Back
;
; Set to #N$01 by #R$6C2D when it has moved the pointer at #R$5E19 back
; to an earlier map point, else #N$00.
@label=Flag_PointerMovedBack
g$5E1B DEFB $2C

; Previous Distance
;
; The distance to the previous map point, kept by #R$6C2D when it is
; moving the pointer at #R$5E19 forwards.
@label=PreviousDistance
g$5E1C DEFW $0E30

; Object Sprite ID
;
; The sprite ID that is used to draw the object being drawn by #R$6F3C.
; This is the same as #R$5E1F, unless the object is a place name.
@label=ObjectSpriteID
g$5E1E DEFB $00

; Active Object
;
; The sprite ID of the entry in #R$7811 that is being drawn by #R$6B47.
; Bit 6 is set for a place name, and a collected cup is #N$60.
@label=ActiveObject
g$5E1F DEFB $00

; Actor Buffer
;
; The old state of the actor whose sprite is being erased and drawn again
; (see #R$71ED and #R$7101).
@label=Actor_Position_X
g$5E20 DEFB $00      ; X Position.
@label=Actor_Position_Y
 $5E21 DEFB $00      ; Y Position.
@label=Actor_SpriteID
 $5E22 DEFB $00      ; Sprite ID (#N$00 if there is no sprite to erase).
@label=HeightPixels
 $5E23 DEFB $3A      ; Height (in pixels).
@label=WidthBytes
 $5E24 DEFB $EF      ; Width (in bytes).
@label=CurrentSpriteHeight
 $5E25 DEFB $22      ; Number of lines of the old sprite left to erase.
@label=HeightLines
 $5E26 DEFB $22      ; Number of lines of the new sprite left to draw.

; Actor Screen Position
;
; The position of the sprite being coloured by #R$704B.
@label=ActorScreenPosition
g$5E27 DEFB $AF      ; X Position.
 $5E28 DEFB $3A      ; Y Position.

; Game Timer
;
; 16-bit counter starting at 0x0000 and counting +1 for each pass of the
; main loop (see #R$6A87). This continues until the game is over. Counter loops
; around after reaching #N$FFFF.
@label=GameTimer
g$5E29 DEFW $ACF5

; Unused
;
; This byte is not referenced by the game.
@label=Unused_5E2B
g$5E2B DEFB $36

; Width Counter
;
; Temporary counter used when drawing sprites.
@label=WidthCounter
g$5E2C DEFB $0E

; Miles
;
; The miles travelled, as six BCD digits (see #R$6D12 and #R$6CDE).
@label=Miles
g$5E2D DEFB $00      ; Digits 1 and 2.
 $5E2E DEFB $00      ; Digits 3 and 4. Each time this changes the player is awarded
                     ; points.
 $5E2F DEFB $06      ; Digits 5 and 6.

; Miles Fraction
;
; The fraction of a mile that has been travelled, which carries over into
; the miles when it overflows (see #R$6D12).
@label=Miles_Fraction
g$5E30 DEFB $00

; Time
;
; The time taken in the current game, as three BCD bytes. The hours are a
; single digit (in the low nibble). See #R$64C7.
@label=Time_1
g$5E31 DEFB $00      ; Hours.
@label=Time_2
 $5E32 DEFB $2C      ; Minutes.
@label=Time_3
 $5E33 DEFB $30      ; Seconds.

; Player World Co-ordinates
;
; The inverted low byte of #R$5E05 and the low byte of #R$5E08 from the
; last time that the terrain dots were moved (see #R$6588).
@label=PlayerWorldPosition
g$5E34 DEFB $0E,$00  ; Player X/ Y position in relation to the whole "World".

; Player Marker Address
;
; The screen address of the player's marker on the map in the sidebar (see
; #R$653E).
@label=PlayerMarker_Address
g$5E36 DEFW $0000

; Player Marker Byte
;
; The byte of the screen that is covered up by the player's marker on the
; map (see #R$6557).
@label=PlayerMarker_Byte
g$5E38 DEFB $00

; Current Place
;
; This value will either be the current Place ID or #N$FF to indicate being open to entering a new place (to
;       avoid repetition).
@label=CurrentPlaceID
g$5E39 DEFB $00      ; Current Place ID or #N$FF.

; Object Map Pointer
;
; The address of the entry in #R$7811 which follows the object that was
; last drawn, which is used to find the sprite ID of a cup or other object that
; has been reached.
@label=ObjectMapPointer
g$5E3A DEFW $EF3A

; Cups Collected
@label=Cups_Collected
g$5E3C DEFB $22

; Player Lives
@label=Player_Lives
g$5E3D DEFB $22

; Game Options
;
; #TABLE(default,centre,centre)
; { =h Byte | =h Binary | =h Option }
; { #N$00 | #EVAL($00, $02, $08) | Keyboard }
; { #N$02 | #EVAL($02, $02, $08) | Joystick }
; TABLE#
@label=GameOptions
g$5E3E DEFB $AF
; View the equivalent code in;
; #LIST
; { #UNDERWURLDE$8ED5 }
; LIST#

; Current menu item colour attribute
@label=Current_MenuAttribute
g$5E3F DEFB $3A

; Old Sprite Shift
;
; The number of pixels that the old sprite is shifted to the right by (see
; #R$70B2).
@label=OldSpriteShift
g$5E40 DEFB $F5

; New Sprite Shift
;
; The number of pixels that the new sprite is shifted to the right by (see
; #R$70D2).
@label=NewSpriteShift
g$5E41 DEFB $C0

; Object Attribute
;
; The attribute of the object being drawn, which is worked out by
; #R$6B47.
@label=ObjectAttribute
g$5E42 DEFB $32

; Flag: Day or Night
;
; #TABLE(default,centre,centre)
; { =h Byte | =h Flag }
; { #N$00 | Day }
; { #N$01 | Night }
; TABLE#
@label=Flag_DayNight
g$5E43 DEFB $33

; Background Attribute
@label=Background_Attribute
g$5E44 DEFB $34

; Bounce Counter
;
; Set to #N$05 when the car bounces off the edge of the map, and counted
; down by #R$6E43 while the bounce sound is made.
@label=BounceCounter
g$5E45 DEFB $32

; Sound Counter
;
; Used as a counter for the cup collection and refuelling sounds.
@label=SoundCounter
g$5E46 DEFB $34

; Sound Store
@label=SoundStore
g$5E47 DEFB $0E

; Temporary Text Item X Position
;
; Used for the indent for;
; #LIST
; { #R$5F6C(Game Menu items) }
; { #R$607D(Congratulations Messaging) }
; LIST#
@label=Temp_Text_Pos_X
g$5E48 DEFB $00

; High Score
;
; 3-byte representation of the score.
@label=High_Score
g$5E49 DEFB $00      ; Byte #1.
@label=High_Score_2
 $5E4A DEFB $80      ; Byte #2.
@label=High_Score_3
 $5E4B DEFB $5B      ; Byte #3.
; View the equivalent code in;
; #LIST
; { #COOKIE$5F09 }
; { #JETPAC$5CF0 }
; { #LUNARJETMAN$5E06 }
; { #PSSST$5E00 }
; { #SABREWULF$B304 }
; LIST#

; Score
;
; 3-byte representation of the score.
@label=Score_1
g$5E4C DEFB $00      ; Byte #1.
@label=Score_2
 $5E4D DEFB $0D      ; Byte #2.
@label=Score_3
 $5E4E DEFB $00      ; Byte #3.

; Last Place Visited
;
; The sprite ID of the last place that the car has refuelled at, so that
; the points for reaching a place are only awarded once in a row (see
; #R$7001). It is reset when a new car is set up.
@label=LastPlaceVisited
g$5E4F DEFB $00

; Objects
;
; The objects that are in view, which are drawn by #R$6F3C and removed by
; #R$6AF5. The sprite ID has bit 7 set when the object has been seen this
; frame, and the sprite ID is #N$00 when the slot is not used. The game only
; uses the first seven slots.
;
; .
;
; Object #N($01 + (#PC - $5E50) / $03).
@label=Object_1_State
g$5E50 DEFB $00      ; Sprite ID.
@label=Object_1_X
 $5E51 DEFB $00      ; X Position.
 $5E52 DEFB $00      ; Y Position.
; Object #N($01 + (#PC - $5E50) / $03).
@label=Object_2_State
 $5E53 DEFB $00      ; Sprite ID.
 $5E54 DEFB $00      ; X Position.
 $5E55 DEFB $00      ; Y Position.
; Object #N($01 + (#PC - $5E50) / $03).
@label=Object_3_State
 $5E56 DEFB $00      ; Sprite ID.
 $5E57 DEFB $00      ; X Position.
 $5E58 DEFB $00      ; Y Position.
; Object #N($01 + (#PC - $5E50) / $03).
@label=Object_4_State
 $5E59 DEFB $00      ; Sprite ID.
 $5E5A DEFB $00      ; X Position.
 $5E5B DEFB $00      ; Y Position.
; Object #N($01 + (#PC - $5E50) / $03).
@label=Object_5_State
 $5E5C DEFB $00      ; Sprite ID.
 $5E5D DEFB $00      ; X Position.
 $5E5E DEFB $00      ; Y Position.
; Object #N($01 + (#PC - $5E50) / $03).
@label=Object_6_State
 $5E5F DEFB $00      ; Sprite ID.
 $5E60 DEFB $00      ; X Position.
 $5E61 DEFB $00      ; Y Position.
; Object #N($01 + (#PC - $5E50) / $03).
@label=Object_7_State
 $5E62 DEFB $00      ; Sprite ID.
 $5E63 DEFB $00      ; X Position.
 $5E64 DEFB $00      ; Y Position.
; Object #N($01 + (#PC - $5E50) / $03).
@label=Object_8_State
 $5E65 DEFB $00      ; Sprite ID.
 $5E66 DEFB $00      ; X Position.
 $5E67 DEFB $00      ; Y Position.

; Radar Blips
;
; The three blips on the radar (see #R$625C): the first car, the second car
; and the nearest cup. Each is four bytes: the column and row where the blip is
; drawn, and then the column and row where it will be drawn next. A column and
; row of #N$00 and #N$00 mean that there is no blip.
@label=RadarBlips
g$5E68 DEFB $00,$00,$00,$00
 $5E6C DEFB $00,$00,$00,$00
 $5E70 DEFB $00,$00,$00,$00

; Miles Checkpoint
;
; The middle byte of the miles (#R$5E2E) the last time that points were
; awarded for it by #R$6D12.
@label=MilesCheckpoint
g$5E74 DEFB $00

; Unused
;
; These bytes are not referenced by the game.
@label=Unused_5E75
g$5E75 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5E7D DEFB $00,$00,$00

; Player Entity
;
; The first of the three entities that the main loop handles (see
; #R$6009); #R$6A15 holds the initial values. This one is the player's car.
; The first byte is the state, which says what the entity is doing (#N$01 when
; driving and #N$03 when exploding). The player's car is drawn in the centre of
; the play area, so its position is not used for movement.
@label=Entity_Player
g$5E80 DEFB $00                         ; State.
 $5E81 DEFB $00                         ; X position on the screen.
 $5E82 DEFB $00                         ; Y position on the screen.
 $5E83 DEFB $00                         ; Attribute.
 $5E84 DEFB $00                         ; Timer for the explosion (see
                                        ; #R$6318).
 $5E85 DEFB $00,$00,$00,$00,$00,$00,$00 ; Purpose not yet known.

; First Car Entity
;
; The first of the two cars that chase the player. See #R$6633 for what
; each of the fields means.
@label=Entity_Car_1
g$5E8C DEFB $00      ; State, or the sprite ID while the car is being drawn.
 $5E8D DEFB $00      ; X position on the screen.
 $5E8E DEFB $00      ; Y position on the screen.
 $5E8F DEFB $00      ; Colour.
@label=Entity_Car_1_X
 $5E90 DEFW $0000    ; X position.
@label=Entity_Car_1_Y
 $5E92 DEFW $0000    ; Y position.
 $5E94 DEFB $00      ; X speed.
 $5E95 DEFB $00      ; Y speed.
 $5E96 DEFB $00      ; Flags.
 $5E97 DEFB $00      ; Sprite ID.

; Second Car Entity
;
; The second of the two cars that chase the player. See #R$6633 for what
; each of the fields means.
@label=Entity_Car_2
g$5E98 DEFB $00      ; State, or the sprite ID while the car is being drawn.
 $5E99 DEFB $00      ; X position on the screen.
 $5E9A DEFB $00      ; Y position on the screen.
 $5E9B DEFB $00      ; Colour.
@label=Entity_Car_2_X
 $5E9C DEFW $0000    ; X position.
@label=Entity_Car_2_Y
 $5E9E DEFW $0000    ; Y position.
 $5EA0 DEFB $00      ; X speed.
 $5EA1 DEFB $00      ; Y speed.
 $5EA2 DEFB $00      ; Flags.
 $5EA3 DEFB $00      ; Sprite ID.

; Unused
;
; These bytes are not referenced by the game; #R$6A73 uses the address as
; the end of the entities.
@label=Entities_End
g$5EA4 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5EAC DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5EB4 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5EBC DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5EC4 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5ECC DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5ED4 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5EDC DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5EE4 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5EEC DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5EF4 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $5EFC DEFB $00,$00,$00,$00

; Security Check
;
; Used by the routine at #R$5B80.
; .
; The game only starts when the second byte of #SKOOLKID$5C78(FRAMES) is
; #N$58. If it is any other value then this returns to the caller instead of
; running the game.
@label=SecurityCheck
c$5F00 DI            ; Disable interrupts.
 $5F01 LD A,($5C79)  ; Fetch the second byte of #SKOOLKID$5C78(FRAMES).
 $5F04 CP $58        ; {Return if #REGa is not equal to #N$58.
 $5F06 RET NZ        ; }
; Continue on to #R$5F07.
; .
; View the equivalent code in;
; #LIST
; { #ATICATAC$6000 }
; { #COOKIE$5F00 }
; { #JETPAC$61E5 }
; { #LUNARJETMAN$8000 }
; { #PSSST$61C6 }
; { #SABREWULF$995A }
; LIST#

; Game Initialisation
;
; Clears the game variables, builds the day time game window and then runs
; the game selection menu until the player chooses to start a game.
;
; .
;
; Blank the game variables.
@label=GameInitialisation
c$5F07 LD HL,$5E00   ; {Write #N$00 to the #N$00A4 bytes from #N($5E00, $04, $04) to
 $5F0A LD DE,$5E01   ; #N($5EA3, $04, $04).
 $5F0D LD BC,$00A3   ;
 $5F10 LD (HL),$00   ;
 $5F12 LDIR          ; }
 $5F14 LD HL,$FFFF   ; {Write #N$FFFF to #R$5E00 (the best time) - this isn't used anywhere
 $5F17 LD ($5E00),HL ; until #R$5E03 is set.}
; This entry point is used by the routine at #R$6353.
; .
; Entered again when a game is over, to return to the game selection menu.
@label=Game_Restart
*$5F1A LD HL,$FFFF   ; {Write #N$FFFF to #R$5E34.
 $5F1D LD ($5E34),HL ; }
 $5F20 LD SP,$5E00   ; Set the stack pointer to #N($5E00, $04, $04).
 $5F23 CALL $6175    ; Set the day time attributes using #R$6175.
 $5F26 CALL $68A0    ; Create the game window using #R$68A0.
; Print the menu, then check the keyboard for the player's choice.
@label=GameSelect_Loop
*$5F29 CALL $5F6C    ; Print the game selection menu using #R$5F6C.
; The "Best Time Today" banner only shows when one is set. The flag at
; #R$5E03 toggles it on/ off.
 $5F2C LD A,($5E03)  ; {If #R$5E03 is not zero, call #R$6483.
 $5F2F AND A         ;
 $5F30 CALL NZ,$6483 ; }
 $5F33 LD A,($5E3E)  ; {Take a copy of the control options from #R$5E3E.
 $5F36 LD D,A        ; }
 $5F37 LD A,$F7      ; {Read from the keyboard;
 $5F39 OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $5F3B IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$F7 | 1 | 2 | 3 | 4 | 5 }
                     ; TABLE#}
 $5F3D CPL           ; Flip the bits, so a pressed key is now a set bit.
; Handle keyboard selection.
@label=GameSelect_CheckKeyboard
 $5F3E BIT 0,A       ; {Jump to #R$5F44 if key "1" has not been pressed ("1
 $5F40 JR Z,$5F44    ; KEYBOARD").}
 $5F42 RES 1,D       ; Reset bit 1 of the options in #REGd, to select the
                     ; keyboard.
; Handle joystick selection.
@label=GameSelect_CheckJoystick
*$5F44 BIT 1,A       ; {Jump to #R$5F4A if key "2" has not been pressed ("2
 $5F46 JR Z,$5F4A    ; JOYSTICK").}
 $5F48 SET 1,D       ; Set bit 1 of the options in #REGd, to select the
                     ; joystick.
; Handle starting a new game.
@label=GameSelect_CheckStart
*$5F4A BIT 2,A       ; {Jump to #R$5FEF if key "3" has been pressed ("3 START
 $5F4C JP NZ,$5FEF   ; GAME").}
; Store the choice, then flash the selected menu line.
 $5F4F LD A,D        ; {Save the control options back to #R$5E3E.
 $5F50 LD ($5E3E),A  ; }
 $5F53 LD HL,$5FA8   ; Point #REGhl at the colour of the first selectable menu line
                     ; (#R$5FA8), which skips the title.
 $5F56 LD A,($5E3E)  ; {Fetch the control options from #R$5E3E into #REGc.
 $5F59 LD C,A        ; }
 $5F5A BIT 1,C       ; {If the joystick option is selected, jump to #R$5F65.
 $5F5C JR NZ,$5F65   ; }
; Set the first menu item, unset the second.
@label=MenuAttributeSetFirst
 $5F5E SET 7,(HL)    ; Set the FLASH attribute for the first selection.
 $5F60 INC HL        ; Move on to the colour of the second menu line.
 $5F61 RES 7,(HL)    ; Unset the FLASH attribute for the second selection.
 $5F63 JR $5F29      ; Jump to #R$5F29.
; Unset the first menu item, set the second.
@label=MenuAttributeSetSecond
*$5F65 RES 7,(HL)    ; Unset the FLASH attribute for the first selection.
 $5F67 INC HL        ; Move onto the next menu attribute.
 $5F68 SET 7,(HL)    ; Set the FLASH attribute for the second selection.
 $5F6A JR $5F29      ; Jump to #R$5F29.
; View the equivalent code in;
; #LIST
; { #ATICATAC$7C19 }
; { #COOKIE$6298 }
; { #JETPAC$61EB }
; { #LUNARJETMAN$800A }
; { #PSSST$61CD }
; { #SABREWULF$9960 }
; LIST#

; Game Selection Menu
;
; Used by the routine at #R$5F07.
; .
; Prints the five lines of the game selection menu. The X position of the
; text is #N$68 (held at #R$5E48), the colour of each line comes from the table
; at #R$5FA7, the Y positions come from the table at #R$5FAC and the text itself
; is held at #R$5FB1.
; The shadow registers hold the pointer to the Y positions (#REGhl'), the pointer to the text (#REGde') and the line counter (#REGb'). The main registers hold the pointer to the attributes (#REGde).
; #PUSHS #UDGTABLE { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$5F07,stop=$5F29,clear=1,sp=$5E00)
; #SIM(start=$5F29,stop=$5F2C)
; #SCR$02(game-selection-menu) } UDGTABLE# #POPS
@label=GameMenu
c$5F6C LD A,$68      ; {Write the X position of the menu text, #N$68, to
 $5F6E LD ($5E48),A  ; #R$5E48.}
 $5F71 LD DE,$5FA7   ; Point #REGde at the table of menu line colours
                     ; (#R$5FA7).
 $5F74 EXX           ; Switch to the shadow registers.
 $5F75 LD HL,$5FAC   ; Point #REGhl' at the table of menu line Y positions
                     ; (#R$5FAC).
 $5F78 LD DE,$5FB1   ; Point #REGde' at the menu text (#R$5FB1).
; There are five lines of text.
 $5F7B LD B,$05      ; Set the line counter to #N$05, one for each line of the
                     ; menu.
; This entry point is used by the routine at #R$607D.
@label=GameMenu_Loop
*$5F7D EXX           ; Switch back to the main registers.
 $5F7E LD A,(DE)     ; {Fetch the colour of this menu line and write it to
 $5F7F LD ($5E3F),A  ; #R$5E3F.}
 $5F82 INC DE        ; Move on to the colour of the next menu line.
 $5F83 EXX           ; Switch to the shadow registers.
 $5F84 PUSH BC       ; Stash the line counter on the stack.
 $5F85 LD A,(HL)     ; Fetch the Y position of this menu line.
 $5F86 INC HL        ; Move on to the Y position of the next menu line.
 $5F87 PUSH HL       ; Stash the Y position pointer on the stack.
 $5F88 LD H,A        ; Set #REGh to the Y position of the line.
 $5F89 LD A,($5E48)  ; {Set #REGl to the X position of the text, from #R$5E48.
 $5F8C LD L,A        ; }
 $5F8D CALL $5F97    ; Print the line of text using #R$5F97.
 $5F90 EXX           ; Switch to the shadow registers.
 $5F91 POP HL        ; {Restore the Y position pointer and the line counter
 $5F92 POP BC        ; from the stack.}
 $5F93 INC DE        ; Move the text pointer on to the start of the next line
                     ; of text.
 $5F94 DJNZ $5F7D    ; Decrease the line counter by one and loop back to #R$5F7D until all
                     ; of the lines have been printed.
 $5F96 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$7CAF }
; { #COOKIE$6332 }
; { #JETPAC$6260 }
; { #LUNARJETMAN$80D1 }
; { #PSSST$6250 }
; { #SABREWULF$B473 }
; { #UNDERWURLDE$90E4 }
; LIST#

; Write Menu Line
;
; Used by the routines at #R$5F6C, #R$6353, #R$63FF and #R$6483.
; .
; Prints a line of text and sets the attributes for it. The last character
; of the text has bit 7 set. The attribute is held at #R$5E3F.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$5F07,stop=$5F29,clear=1,sp=$5E00)
; #SIM(start=$5F6C,stop=$5F8D)
; #SCR$04,$09,$03,$14,$03(write-menu-line-before)
; | #SIM(start=$5F8D,stop=$5F90)
; #SCR$04,$09,$03,$14,$03(write-menu-line-after) } UDGTABLE# #POPS
;
; HL Pixel co-ordinates (#REGh is the Y position, #REGl the X position)
; DE Pointer to the text
@label=MenuWriteText
c$5F97 PUSH HL       ; Stash the text position on the stack.
 $5F98 CALL $6F10    ; Convert the text position to a screen address using
                     ; #R$6F10.
 $5F9B LD A,($5E3F)  ; Fetch the colour of the line from #R$5E3F.
 $5F9E EX AF,AF'     ; Hold the colour in #REGa' ready for the string printer.
 $5F9F EXX           ; Switch to the shadow registers.
 $5FA0 POP HL        ; Restore the text position from the stack.
 $5FA1 CALL $7097    ; Convert the text position to an attribute address using
                     ; #R$7097.
 $5FA4 JP $6524      ; Jump to #R$6524 to print the text and set the
                     ; attributes.
; View the equivalent code in;
; #LIST
; { #ATICATAC$7D8A }
; { #COOKIE$63E0 }
; { #JETPAC$62FF }
; { #LUNARJETMAN$81AB }
; { #PSSST$62E7 }
; { #SABREWULF$B52D }
; { #UNDERWURLDE$91B0 }
; LIST#

; Game Select Attribute Table
;
; One attribute byte per menu line. The routines that flash the
; selected line set or clear FLASH in the byte for the line being
; updated. The first byte belongs to the title, so the flashing code
; starts at #R$5FA8.
@label=GameSelection_Attributes
b$5FA7 DEFB $60      ; {#TABLE(default,centre)
@label=GameSelection_Attributes_Options
 $5FA8 DEFB $47      ; { =h Byte(n) | =h Menu Item }
 $5FA9 DEFB $47      ; { #N$01 | Game Selection }
 $5FAA DEFB $60      ; { #N$02 | 1 Keyboard }
 $5FAB DEFB $70      ; { #N$03 | 2 Joystick }
                     ; { #N$04 | 3 Start Game }
                     ; { #N$05 | © 1983 A.C.G. }
                     ; TABLE#}
; View the equivalent code in;
; #LIST
; { #ATICATAC$7CEA }
; { #COOKIE$635E }
; { #JETPAC$628D }
; { #LUNARJETMAN$810E }
; { #PSSST$627C }
; { #SABREWULF$B498 }
; { #UNDERWURLDE$9119 }
; LIST#

; Game Select Y Position Table
@label=GameSelection_Position
b$5FAC DEFB $20      ; {#TABLE(default,centre,centre)
 $5FAD DEFB $48      ; { =h Byte(n) | =h Position | =h Menu Item }
 $5FAE DEFB $58      ; { #N$01 | #EVAL(#PEEK(#PC+$00) / $08) | Game Selection }
 $5FAF DEFB $78      ; { #N$02 | #EVAL(#PEEK(#PC+$01) / $08) | 1 Keyboard }
 $5FB0 DEFB $B8      ; { #N$03 | #EVAL(#PEEK(#PC+$02) / $08) | 2 Joystick }
                     ; { #N$04 | #EVAL(#PEEK(#PC+$03) / $08) | 3 Start Game }
                     ; { #N$05 | #EVAL(#PEEK(#PC+$04) / $08) | © 1983 A.C.G. }
                     ; TABLE#}
; View the equivalent code in;
; #LIST
; { #ATICATAC$7CF1 }
; { #COOKIE$6365 }
; { #JETPAC$6293 }
; { #LUNARJETMAN$8115 }
; { #PSSST$6282 }
; { #SABREWULF$B4A0 }
; { #UNDERWURLDE$911F }
; LIST#

; Messaging: Game Selection Screen Text
@label=GameSelection_Text
t$5FB1 DEFM "GAME SELECTIO","N"+$80 ; "GAME SELECTION".
 $5FBF DEFM "1  KEYBOAR","D"+$80    ; "1  KEYBOARD".
 $5FCA DEFM "2  JOYSTIC","K"+$80    ; "2  JOYSTICK".
 $5FD5 DEFM "3  START GAM","E"+$80  ; "3  START GAME".
 $5FE2 DEFM $7F                     ; {"© 1983 A.C.G.".
 $5FE3 DEFM " 1983 A.C.G","."+$80   ; }
; View the equivalent code in;
; #LIST
; { #ATICATAC$7CF8 }
; { #COOKIE$636C }
; { #JETPAC$6299 }
; { #LUNARJETMAN$811C }
; { #PSSST$6288 }
; { #UNDERWURLDE$9125 }
; LIST#

; Start Game
;
; Used by the routine at #R$5F07.
; .
; Resets the frame counter, the number of lives and the score, creates a
; new game, and then falls into the main loop.
@label=StartGame
c$5FEF XOR A         ; {Write #N$00 to #LIST { #SKOOLKID$5C78(FRAMES) } {
 $5FF0 LD ($5C78),A  ; #R$5E74 } LIST#
 $5FF3 LD ($5E74),A  ; }
; Reset the players life count.
 $5FF6 LD A,$03      ; {Set the number of lives to #N$03.
 $5FF8 LD ($5E3D),A  ; }
; Reset the players score (#N$03 digits).
 $5FFB LD HL,$5E4C   ; Point #REGhl at the score (#R$5E4C).
 $5FFE LD B,$03      ; Set the byte counter to #N$03, as the score is held in
                     ; three bytes.
@label=ResetScore_Loop
*$6000 LD (HL),$00   ; Clear a byte of the score.
 $6002 INC HL        ; Move on to the next byte of the score.
 $6003 DJNZ $6000    ; Decrease the byte counter by one and loop back to #R$6000 until the
                     ; whole score has been cleared.
 $6005 EI            ; Enable interrupts.
 $6006 CALL $6391    ; Set up a new game using #R$6391.
; View the equivalent code in;
; #LIST
; { #ATICATAC$7D9A }
; { #COOKIE$6428 }
; { #JETPAC$6333 }
; { #LUNARJETMAN$81BB }
; { #PSSST$632D }
; LIST#

; Run Main Loop
;
; Used by the routines at #R$63FF and #R$6A87.
; .
; The game loop. Each pass runs the handler for each of the three entities
; held from #R$5E80 (the player's car and the two opponent cars), in turn. The
; handler is chosen by the entity state held in the first byte of the entity,
; using the table at #R$6028. Once every entity has been handled #R$6A73 plays
; the engine sound, checks for a pause and starts the loop again.
; #TABLE(default,centre,centre)
; { =h State | =h Meaning }
; { #N$00 | Inactive }
; { #N$01 | Player car driving }
; { #N$02 | Opponent car driving }
; { #N$03 | Player car exploding }
; TABLE#
@label=MainLoop_NewPass
c$6009 LD IX,$5E80   ; Point #REGix at the first entity, the player's car
                     ; (#R$5E80).
 $600D LD SP,$5E00   ; Set the stack pointer to #N($5E00, $04, $04).
; This entry point is used by the routine at #R$6A73.
; .
; Dispatch the handler for this entity.
@label=MainLoop
*$6010 LD HL,$6A73   ; {Stash #R$6A73 on the stack as the return address for
 $6013 PUSH HL       ; the handler.}
 $6014 LD HL,$6028   ; Point #REGhl at the table of handlers (#R$6028).
 $6017 LD A,(IX+$00) ; Fetch the entity state from *#REGix+#N$00.
 $601A RLCA          ; Rotate the state left, ready to use it as an index into the table of
                     ; words.
 $601B AND %01111110 ; Keep only bits 1-6.
 $601D LD C,A        ; {Make the offset into the table of handlers in #REGbc.
 $601E LD B,$00      ; }
 $6020 ADD HL,BC     ; Add the offset to the address of the table.
 $6021 LD A,(HL)     ; {Fetch the address of the handler from the table into
 $6022 INC HL        ; #REGhl.
 $6023 LD H,(HL)     ;
 $6024 LD L,A        ; }
 $6025 JP $5CB0      ; Jump to the handler via #R$5CB0.

; Main Jump Table
;
; The handler for each entity state, indexed by the state held in the
; first byte of the entity (see #R$6009).
@label=JumpTable_Main
w$6028 DEFW $6030    ; State #N$00: #R$6030 (the entity is inactive).
 $602A DEFW $6A9B    ; State #N$01: #R$6A9B (the player's car is driving).
 $602C DEFW $6633    ; State #N$02: #R$6633 (an opponent car is driving).
 $602E DEFW $6318    ; State #N$03: #R$6318 (the player's car is exploding).

; Instant Return
;
; The handler for an inactive entity. It does nothing.
@label=Return
c$6030 RET           ; Return.

; Messaging: Score/ Hi-Score Text
;
; The line of text printed along the top of the play area by #R$68F2. The
; first byte is the colour attribute (#COLOUR$70). The score is printed over the
; first run of spaces by #R$6CB6 and the high score over the last run by
; #R$6CBE.
@label=Text_ScoreHi
t$6031 DEFM $70
 $6032 DEFM "SC         HI      "," "+$80

; Add Points To Score
;
; Used by the routines at #R$63FF, #R$6D12 and #R$6F3C.
; .
; Adds a number of points to the score, using BCD arithmetic, and then
; prints the new score. The score is held as three BCD bytes from #R$5E4C, the
; least significant byte being the last.
;
; B Points to add (hundreds and thousands, as BCD)
; C Points to add (units and tens, as BCD)
@label=AddPointsToScore
c$6046 LD HL,$5E4E   ; Point #REGhl at the units and tens of the score
                     ; (#R$5E4E).
 $6049 LD A,(HL)     ; Fetch the units and tens of the score.
 $604A ADD A,C       ; {Add the units and tens of the points to it, using BCD.
 $604B DAA           ; }
 $604C LD (HL),A     ; Write the new units and tens back to the score.
 $604D DEC HL        ; Move on to the hundreds and thousands of the score.
 $604E LD A,(HL)     ; Fetch the hundreds and thousands of the score.
 $604F ADC A,B       ; {Add the hundreds and thousands of the points, plus any carry, using
 $6050 DAA           ; BCD.}
 $6051 LD (HL),A     ; Write the new hundreds and thousands back to the score.
 $6052 DEC HL        ; Move on to the ten thousands and hundred thousands of
                     ; the score.
 $6053 LD A,(HL)     ; Fetch the ten thousands and hundred thousands of the
                     ; score.
 $6054 ADC A,$00     ; {Add any carry from the hundreds and thousands to it,
 $6056 DAA           ; using BCD.}
 $6057 LD (HL),A     ; Write the new ten thousands and hundred thousands back
                     ; to the score.
 $6058 JP $6CB6      ; Jump to #R$6CB6 to print the new score.
; View the equivalent code in;
; #LIST
; { #ATICATAC$A19C }
; { #BUBBLER$9662 }
; { #COOKIE$7415 }
; { #CYBERUN$925E }
; { #JETPAC$70F9 }
; { #LUNARJETMAN$899C }
; { #MARTIANOIDS$B573 }
; { #NIGHTSHADE$C2ED }
; { #PENTAGRAM$BB29 }
; { #PSSST$737A }
; { #SABREWULF$B5A9 }
; { #UNDERWURLDE$A045 }
; LIST#

; Check High Score
;
; Used by the routine at #R$6353.
; .
; Compares the score with the high score, one byte at a time starting with
; the most significant. If the score is higher then it is copied over the high
; score.
@label=CheckHighScore
c$605B LD DE,$5E48   ; Point #REGde at the byte before the high score (#N$5E48), as the
                     ; pointer is incremented before each byte is compared.
 $605E LD HL,$5E4B   ; Point #REGhl at the byte before the score (#N$5E4B), as the pointer
                     ; is incremented before each byte is compared.
 $6061 LD B,$03      ; Set the byte counter to #N$03, as the scores are held in three
                     ; bytes.
@label=CheckHighScore_Loop
*$6063 INC HL        ; Move on to the next byte of the score.
 $6064 INC DE        ; Move on to the next byte of the high score.
 $6065 LD A,(DE)     ; {Compare the byte of the high score with the same byte
 $6066 CP (HL)       ; of the score.}
 $6067 JR C,$606E    ; If the score byte is higher than the high score byte then jump to
                     ; #R$606E, as there is a new high score.
 $6069 JR Z,$606C    ; If the two bytes are the same then jump to #R$606C to compare the
                     ; next byte.
 $606B RET NC        ; Return if the score byte is lower than the high score
                     ; byte.
@label=CheckHighScore_Skip
*$606C DJNZ $6063    ; Decrease the byte counter by one and loop back to #R$6063 until all
                     ; three bytes have been compared.
; A new High Score has been made, so update #R$5E49(HighScore).
@label=NewHighScore
*$606E LD B,$03      ; Set the byte counter to #N$03, as the scores are held in three
                     ; bytes.
 $6070 LD HL,$5E4C   ; Point #REGhl at the score (#R$5E4C).
 $6073 LD DE,$5E49   ; Point #REGde at the high score (#R$5E49).
@label=NewHighScore_CopyLoop
*$6076 LD A,(HL)     ; {Copy a byte of the score to the high score.
 $6077 LD (DE),A     ; }
 $6078 INC HL        ; Move on to the next byte of the score.
 $6079 INC DE        ; Move on to the next byte of the high score.
 $607A DJNZ $6076    ; Decrease the byte counter by one and loop back to #R$6076 until the
                     ; whole score has been copied.
 $607C RET           ; Return.
; View the equivalent code in;
; #LIST
; { #COOKIE$73D3 }
; { #JETPAC$6398 }
; LIST#

; Display Congratulations Messaging
;
; Used by the routine at #R$63FF.
; .
; Prints the four lines of the message shown when all eight cups have been
; collected. It sets up the shadow registers, as #R$5F6C does, and then reuses
; the printing loop at #R$5F7D.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$5F07,stop=$5F29,clear=1,sp=$5E00)
; #SIM(start=$5FEF,stop=$6010,sp=$5E00)
; #SIM(start=$6414,stop=$641A)
; #SCR$01(congratulations-before)
; | #SIM(start=$641A,stop=$641D)
; #SCR$01(congratulations-after) } UDGTABLE# #POPS
@label=DisplayCongratsMessaging
c$607D LD A,$50      ; {Write the X position of the message text, #N$50, to
 $607F LD ($5E48),A  ; #R$5E48.}
 $6082 LD DE,$6091   ; Point #REGde at the table of line colours (#R$6091).
 $6085 EXX           ; Switch to the shadow registers.
 $6086 LD HL,$6095   ; Point #REGhl' at the table of line Y positions
                     ; (#R$6095).
 $6089 LD DE,$6099   ; Point #REGde' at the congratulations text (#R$6099).
 $608C LD B,$04      ; Set the line counter to #N$04, one for each line of the
                     ; message.
 $608E JP $5F7D      ; Jump to #R$5F7D to print the lines of the message.

; Congratulations Attributes
;
; The colour attribute of each line of the congratulations message
; (#COLOUR$70).
@label=CongratsMessaging_Attributes
b$6091 DEFB $70,$70,$70,$70

; Congratulations Y Positions
;
; The Y position, in pixels, of each line of the congratulations message.
@label=CongratsMessaging_Position
b$6095 DEFB $10      ; {#TABLE(default,centre,centre)
 $6096 DEFB $20      ; { =h Byte(n) | =h Position | =h Menu Item }
 $6097 DEFB $30      ; { #N$01 | #EVAL(#PEEK(#PC+$00) / $08) | "CONGRATULATIONS YOU" }
 $6098 DEFB $40      ; { #N$02 | #EVAL(#PEEK(#PC+$01) / $08) | " HAVE SUCCESSFULLY" }
                     ; { #N$03 | #EVAL(#PEEK(#PC+$02) / $08) | "COLLECTED THE EIGHT" }
                     ; { #N$04 | #EVAL(#PEEK(#PC+$03) / $08) | " CUPS OF ULTIMATE" }
                     ; TABLE#}

; Messaging: Congratulations
@label=Message_Congrats
t$6099 DEFM "CONGRATULATIONS YO","U"+$80 ; "CONGRATULATIONS YOU".
 $60AC DEFM " HAVE SUCCESSFULL","Y"+$80  ; " HAVE SUCCESSFULLY".
 $60BE DEFM "COLLECTED THE EIGH","T"+$80 ; "COLLECTED THE EIGHT".
 $60D1 DEFM " CUPS OF ULTIMATE","."+$80  ; " CUPS OF ULTIMATE".

; Sounds: Bounce
;
; Used by the routines at #R$6E00 and #R$6E19.
; .
; Plays eight groups of four square waves using #R$614B. The period of
; each group comes from one of the first eight bytes of the ROM, with bit 7 set
; (so the period is never less than #N$80). This is the sound made when the car
; reaches the edge of the map.
; #HTML(#AUDIO0(bounce.wav)(#INCLUDE(Bounce)))
@label=SoundsBounce
c$60E3 LD HL,$0000   ; Point #REGhl at the start of the ROM, which supplies the periods of
                     ; the waves.
 $60E6 LD C,$08      ; Set the group counter to #N$08, one for each group of
                     ; waves.
@label=SoundsBounce_Loop
*$60E8 LD E,$04      ; Set the wave counter to #N$04, for the waves in each
                     ; group.
 $60EA LD A,(HL)     ; Fetch the next ROM byte.
 $60EB INC HL        ; Move on to the next ROM byte.
 $60EC AND %01111111 ; Keep only bits 0-6.
 $60EE OR %10000000  ; Set bit 7.
 $60F0 LD D,A        ; Set the period of the waves in this group.
@label=SoundsBounce_Play
*$60F1 CALL $614B    ; Play a square wave using #R$614B.
 $60F4 DEC E         ; {Decrease the wave counter by one and loop back to #R$60F1 until all
 $60F5 JR NZ,$60F1   ; of the waves in the group have been played.}
 $60F7 DEC C         ; {Decrease the group counter by one and loop back to #R$60E8 until all
 $60F8 JR NZ,$60E8   ; of the groups have been played.}
 $60FA RET           ; Return.
; View the equivalent code in;
; #LIST
; { #UNDERWURLDE$A173 }
; LIST#

; Play Sound
;
; Used by the routines at #R$6106 and #R$614B.
; .
; Flips the speaker bit (bit 4) of the value held at #R$5E47 and writes
; the result to port #N$FE. The lower bits of the value set the border colour.
@label=PlaySound
c$60FB LD A,($5E47)  ; Fetch the speaker and border state from #R$5E47.
 $60FE XOR %00010000 ; Flip bit 4 (the speaker).
 $6100 LD ($5E47),A  ; Write the new speaker and border state back to #R$5E47.
 $6103 OUT ($FE),A   ; Write the state to port #N$FE, which sets the speaker and the border
                     ; colour.
 $6105 RET           ; Return.

; Play Noise
;
; Used by the routine at #R$6633.
; .
; Steps through the first #N$0400 bytes of the ROM and flips the speaker,
; using #R$60FB, for every byte which has bit 4 set. The ROM contents are used
; as a source of noise. This is the sound made when an opponent car hits an
; obstacle.
; #HTML(#AUDIO0(noise.wav)(#INCLUDE(Noise)))
@label=PlayNoise
c$6106 LD HL,$0000   ; Point #REGhl at the start of the ROM, which is the source of the
                     ; noise.
 $6109 LD BC,$0400   ; Set the byte counter to #N$0400.
@label=PlayNoise_Loop
*$610C LD A,(HL)     ; Fetch the next ROM byte.
 $610D INC HL        ; Move on to the next ROM byte.
 $610E AND %00010000 ; Keep only bit 4.
 $6110 JR Z,$6115    ; Jump to #R$6115 if bit 4 is not set.
 $6112 CALL $60FB    ; Flip the speaker using #R$60FB.
@label=PlayNoise_Next
*$6115 DEC BC        ; Decrease the byte counter by one.
 $6116 LD A,B        ; {Loop back to #R$610C until all #N$0400 bytes have been
 $6117 OR C          ; used.
 $6118 JR NZ,$610C   ; }
 $611A RET           ; Return.

; Sounds: Cup/ Refuel
;
; Used by the routine at #R$6A9B.
; .
; Plays the next step of the sound made when a cup is collected or the car
; is refuelled. This is called every frame but only makes a sound on every other
; frame.
; The step counter is held at #R$5E46. For the refuel sound it counts down from
; #N$07 and bit 7 is clear; each step has a higher pitch than the one before.
; For the cup sound it starts at #N$87 (bit 7 set) and each step has a lower
; pitch than the one before. Each step plays #N$20 square waves using #R$614B,
; and there are six of them.
; The cup sound: #HTML(#AUDIO0(cup-collected.wav)(#INCLUDE(CupCollected)))
; The refuel sound: #HTML(#AUDIO0(refuel.wav)(#INCLUDE(Refuel)))
@label=SoundsCupRefuel
c$611B LD A,($5E29)  ; Fetch the game timer from #R$5E29.
 $611E AND %00000001 ; Keep only bit 0.
 $6120 RET NZ        ; Return on every other frame.
 $6121 LD HL,$5E46   ; Point #REGhl at the step counter (#R$5E46).
 $6124 LD A,(HL)     ; Fetch the step counter.
 $6125 BIT 7,A       ; {Jump to #R$613E if bit 7 is set, as that is the cup
 $6127 JR NZ,$613E   ; sound.}
 $6129 AND A         ; {Return if the step counter is zero, as there is no
 $612A RET Z         ; sound to play.}
 $612B DEC A         ; Decrease the step counter by one.
 $612C LD (HL),A     ; Write the new step counter back to #R$5E46.
 $612D RET Z         ; Return if the step counter has reached zero, as the
                     ; sound is over.
; Work out the period of the waves from the step counter.
@label=SoundsRefuel
*$612E RLCA          ; {Multiply the step counter by #N$04, by rotating it left
 $612F RLCA          ; twice.}
 $6130 AND %00011100 ; Keep only bits 2-4.
 $6132 OR %00100000  ; Set bit 5.
 $6134 LD D,A        ; Set the period of the waves.
 $6135 LD C,$20      ; Set the wave counter to #N$20.
@label=SoundsCupRefuel_Loop
*$6137 CALL $614B    ; Play a square wave using #R$614B.
 $613A DEC C         ; {Decrease the wave counter by one and loop back to #R$6137 until all
 $613B JR NZ,$6137   ; #N$20 waves have been played.}
 $613D RET           ; Return.
; The cup sound keeps bit 7 set in the step counter, and inverts the step
; so that the pitch falls rather than rises.
@label=SoundsCup
*$613E AND %01111111 ; Keep only the step counter (bits 0-6).
 $6140 RET Z         ; Return if the step counter is zero, as the sound is
                     ; over.
 $6141 DEC A         ; Decrease the step counter by one.
 $6142 OR %10000000  ; Set bit 7 so that the sound stays the cup sound.
 $6144 LD (HL),A     ; Write the new step counter back to #R$5E46.
 $6145 AND %01111111 ; Keep only the step counter (bits 0-6).
 $6147 RET Z         ; Return if the step counter has reached zero.
 $6148 CPL           ; Flip the bits, so that the pitch falls with each step.
 $6149 JR $612E      ; Jump to #R$612E.

; Play Square Wave
;
; Used by the routines at #R$60E3, #R$611B and #R$6158.
; .
; Plays one cycle of a square wave. The speaker is flipped, then flipped
; back again after a delay of the same length.
;
; D Delay count for each half of the wave
@label=PlaySquareWave
c$614B CALL $60FB    ; Flip the speaker using #R$60FB.
 $614E LD B,D        ; Set the delay counter to the period of the wave.
@label=PlaySquareWave_Loop_1
*$614F DJNZ $614F    ; Decrease the delay counter by one and loop back to #R$614F until the
                     ; first half of the wave is over.
 $6151 CALL $60FB    ; Flip the speaker using #R$60FB.
 $6154 LD B,D        ; Set the delay counter to the period of the wave.
@label=PlaySquareWave_Loop_2
*$6155 DJNZ $6155    ; Decrease the delay counter by one and loop back to #R$6155 until the
                     ; second half of the wave is over.
 $6157 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #LUNARJETMAN$B8DA }
; LIST#

; Sounds: Engine
;
; Used by the routine at #R$6A73.
; .
; Plays the engine sound: four square waves using #R$614B. The period of
; the waves is #N$3F minus the speed divided by #N$04, so the faster the car is
; going, the higher the pitch. There is no sound when the car is stationary.
; #HTML(#AUDIO0(engine.wav)(#INCLUDE(Engine)))
@label=SoundsEngine
c$6158 LD A,($5E0D)  ; Fetch the speed of the car from #R$5E0D.
 $615B AND A         ; {Return if the car is stationary.
 $615C RET Z         ; }
 $615D RRCA          ; {Divide the speed by #N$04, by rotating it right twice.
 $615E RRCA          ; }
 $615F CPL           ; Flip the bits, so the faster the car the shorter the
                     ; period.
 $6160 AND %00111111 ; Keep only bits 0-5.
 $6162 LD D,A        ; Set the period of the waves.
 $6163 LD C,$04      ; Set the wave counter to #N$04.
 $6165 LD A,($5E80)  ; {If #R$5E80 is #N$03 then jump to #R$616E.
 $6168 CP $03        ;
 $616A JR Z,$616E    ; }
 $616C LD B,$0C      ; Set the delay counter to #N$0C (this has no effect, as it is
                     ; overwritten).
@label=SoundsEngine_Loop
*$616E CALL $614B    ; Play a square wave using #R$614B.
 $6171 DEC C         ; {Decrease the wave counter by one and loop back to #R$616E until all
 $6172 JR NZ,$616E   ; #N$04 waves have been played.}
 $6174 RET           ; Return.

; Set Day Playarea Attributes
;
; Used by the routines at #R$5F07, #R$6353 and #R$63FF.
; .
; Selects day time, using bright black on yellow (#COLOUR$70) for the play
; area background.
@label=SetDayAttributes
c$6175 XOR A         ; {Write #N$00 (day time) to #R$5E43.
 $6176 LD ($5E43),A  ; }
 $6179 LD A,$70      ; Use the day time background attribute, #N$70.
; Continue on to #R$617B.

; Set Background Attribute
;
; Used by the routine at #R$617F.
; .
; Stores the attribute used for the play area background.
;
; A Background attribute
@label=SetBackgroundAttr
c$617B LD ($5E44),A  ; Write the attribute to #R$5E44, the background of the
                     ; play area.
 $617E RET           ; Return.

; Set Night Playarea Attributes
;
; Used by the routine at #R$6353.
; .
; Selects night time, using bright black on black (#COLOUR$40) for the
; play area background.
@label=SetNightAttributes
c$617F LD A,$01      ; {Write #N$01 (night time) to #R$5E43.
 $6181 LD ($5E43),A  ; }
 $6184 LD A,$40      ; Use the night time background attribute, #N$40.
 $6186 JR $617B      ; Jump to #R$617B.

; Controls: Kempston Joystick
;
; Used by the routines at #R$618C, #R$61C2 and #R$61E0.
; .
; Reads the Kempston joystick. The bits are flipped so that, as with the
; keyboard routines, a direction which is pressed is a reset bit: bit 0 is
; right, bit 1 is left, bit 2 is down (brake) and bit 3 is up (accelerate).
;
; O:A Joystick controls
@label=ReadKempstonJoystick
c$6188 IN A,($1F)    ; Read the Kempston joystick (port #N$1F) into #REGa.
 $618A CPL           ; Flip the bits.
 $618B RET           ; Return.
; View the equivalent code in;
; #LIST
; { #JETPAC$733A }
; { #LUNARJETMAN$8F9B }
; { #SABREWULF$B0D9 }
; LIST#

; Input: Left/ Right
;
; Used by the routine at #R$6E43.
; .
; Reads the steering controls. From the keyboard the car steers left with
; Z, C, M or B, and steers right with X, V, N or FULL-STOP.
;
; O:A #N$FD if left is pressed, #N$FE if right is pressed, else #N$FF
;
; Check if this should be read from the Kempston joystick instead?
@label=ReadInputLR
c$618C LD A,($5E3E)  ; {If #R$5E3E indicates the control method is via the Kempston joystick
 $618F BIT 1,A       ; then jump to #R$6188.
 $6191 JR NZ,$6188   ; }
; Check for "Left" and "Right" button inputs for port #N$FE.
 $6193 LD A,$FE      ; {Read from the keyboard;
 $6195 OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $6197 IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$FE | SHIFT | Z | X | C | V }
                     ; TABLE#}
 $6199 AND %00011110 ; Keep only bits 1-4 (stripping out the SHIFT key).
 $619B CP $1E        ; {If none of these keys have been pressed, jump to
 $619D JR Z,$61A7    ; #R$61A7.}
 $619F AND %00010100 ; Keep only bits 2 ("X") and 4 ("V").
 $61A1 CP $14        ; {If neither key is pressed ("Z" or "C" is) jump to
 $61A3 JR Z,$61B9    ; #R$61B9.}
 $61A5 JR $61BC      ; Else "X" or "V" was pressed, so jump to #R$61BC.
; Check for "Left" and "Right" button input for port #N$7F.
@label=ReadInputLR_7F
*$61A7 LD A,$7F      ; {Read from the keyboard;
 $61A9 OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $61AB IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$7F | SPACE | FULL-STOP | M | N | B }
                     ; TABLE#}
 $61AD AND %00011110 ; Keep only bits 1-4 (stripping out the SPACE key).
 $61AF CP $1E        ; {If none of these keys have been pressed, jump to
 $61B1 JR Z,$61BF    ; #R$61BF.}
 $61B3 AND %00010100 ; Keep only bits 2 ("M") and 4 ("B").
 $61B5 CP $14        ; {If neither key is pressed ("N" or "FULL-STOP" is) jump
 $61B7 JR Z,$61BC    ; to #R$61BC.}
; Return "Left" button pressed.
@label=Input_Left
*$61B9 LD A,$FD      ; #REGa=#EVAL($FD, $02, $08).
 $61BB RET           ; Return.
; Return "Right" button pressed.
@label=Input_Right
*$61BC LD A,$FE      ; #REGa=#EVAL($FE, $02, $08).
 $61BE RET           ; Return.
; This entry point is used by the routines at #R$61C2 and #R$61E0.
; .
; Return "no input".
@label=Input_None
*$61BF LD A,$FF      ; #REGa=#EVAL($FF, $02, $08).
 $61C1 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #JETPAC$733E }
; LIST#

; Input: Brake
;
; Used by the routine at #R$6D12.
; .
; Reads the brake control. From the keyboard any key in the rows A to G,
; or ENTER to H, applies the brake.
;
; O:A #N$FB if the brake is pressed, else #N$FF
;
; Check if this should be read from the Kempston joystick instead?
@label=ReadInputBrake
c$61C2 LD A,($5E3E)  ; {If #R$5E3E indicates the control method is via the Kempston joystick
 $61C5 BIT 1,A       ; then jump to #R$6188.
 $61C7 JR NZ,$6188   ; }
; Check for "Brake" button input.
 $61C9 LD B,$02      ; Set the keyboard row counter to #N$02.
 $61CB LD A,$FD      ; #REGa=#N$FD (the first keyboard row).
@label=ReadInputBrake_Loop
*$61CD OUT ($FD),A   ; {Read from the keyboard;
 $61CF IN A,($FE)    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$FD | A | S | D | F | G }
                     ; { #N$BF | ENTER | L | K | J | H }
                     ; TABLE#}
 $61D1 AND %00011111 ; Keep only bits 0-4.
 $61D3 CP $1F        ; {If any buttons were pressed jump to #R$61DD.
 $61D5 JR NZ,$61DD   ; }
 $61D7 LD A,$BF      ; #REGa=#N$BF (the second keyboard row).
 $61D9 DJNZ $61CD    ; Decrease the keyboard row counter by one and loop back to #R$61CD
                     ; until both rows have been checked.
 $61DB JR $61BF      ; Jump to #R$61BF.
; Return "Brake" button pressed.
@label=Input_Brake
*$61DD LD A,$FB      ; #REGa=#EVAL($FB, $02, $08).
 $61DF RET           ; Return.
; View the equivalent code in;
; #LIST
; { #JETPAC$7374 }
; LIST#

; Input: Accelerate
;
; Used by the routine at #R$6D12.
; .
; Reads the accelerator control. From the keyboard any key in the rows Q
; to T, or P to Y, accelerates the car.
;
; O:A #N$F7 if accelerate is pressed, else #N$FF
;
; Check if this should be read from the Kempston joystick instead?
@label=ReadInputAccelerate
c$61E0 LD A,($5E3E)  ; {If #R$5E3E indicates the control method is via the Kempston joystick
 $61E3 BIT 1,A       ; then jump to #R$6188.
 $61E5 JR NZ,$6188   ; }
; Check for "Accelerator" button input.
 $61E7 LD B,$02      ; Set the keyboard row counter to #N$02.
 $61E9 LD A,$FB      ; #REGa=#N$FB (the first keyboard row).
@label=ReadInputAccelerate_Loop
*$61EB OUT ($FD),A   ; {Read from the keyboard;
 $61ED IN A,($FE)    ; #TABLE(default,centre,centre,centre,centre,centre,centre)
                     ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$FB | Q | W | E | R | T }
                     ; { #N$DF | P | O | I | U | Y }
                     ; TABLE#}
 $61EF AND %00011111 ; Keep only bits 0-4.
 $61F1 CP $1F        ; {If any buttons were pressed jump to #R$61FB.
 $61F3 JR NZ,$61FB   ; }
 $61F5 LD A,$DF      ; #REGa=#N$DF (the second keyboard row).
 $61F7 DJNZ $61EB    ; Decrease the keyboard row counter by one and loop back to #R$61EB
                     ; until both rows have been checked.
 $61F9 JR $61BF      ; Jump to #R$61BF.
; Return "Accelerator" button pressed.
@label=Input_Accelerate
*$61FB LD A,$F7      ; #REGa=#EVAL($F7, $02, $08).
 $61FD RET           ; Return.
; View the equivalent code in;
; #LIST
; { #JETPAC$7393 }
; LIST#

; Offset Blip Left
;
; Used by the routine at #R$6212.
; .
; Continues #R$6212 when the target is to the left of the player (or level
; with it). The horizontal distance is scaled to radar pixels and taken away
; from the centre column of the radar. If the target is too far away then the
; blip is hidden.
;
; HL Horizontal distance from the target to the player
; IX Radar blip record
@label=OffsetBlipLeft
c$61FE CALL $6253    ; Call #R$6253 to multiply the distance by #N$04, which leaves the
                     ; distance in radar pixels in #REGh.
 $6201 LD A,$0C      ; #REGa=#N$0C (the centre column of the radar).
 $6203 SUB H         ; Take the distance away from the centre column to give the column to
                     ; the left of the player.
 $6204 JR C,$624D    ; If the target is more than #N$0C pixels to the left then jump to
                     ; #R$624D.
 $6206 JR $622A      ; Jump to #R$622A to store the column.

; Offset Blip Down
;
; Used by the routine at #R$6212.
; .
; Continues #R$6212 when the target is not further up the map than the
; player. The vertical distance is scaled to radar pixels and added to the
; centre row of the radar. If the target is too far away then the blip is
; hidden.
;
; HL Vertical distance from the target to the player
; IX Radar blip record
@label=OffsetBlipDown
c$6208 CALL $6253    ; Call #R$6253 to multiply the distance by #N$04, which leaves the
                     ; distance in radar pixels in #REGh.
 $620B LD A,$0E      ; Start from the centre row of the radar (#N$0E).
 $620D SUB H         ; Take the distance away from the centre row (flipped to a row below
                     ; the centre at #R$6245).
 $620E JR C,$624D    ; If the target is more than #N$0E pixels away then jump
                     ; to #R$624D.
 $6210 JR $6245      ; Jump to #R$6245 to convert this into a row below the centre of the
                     ; radar.

; Locate Radar Blip
;
; Used by the routines at #R$625C and #R$62DA.
; .
; Works out where a target is shown on the radar. The radar is centred on
; the player and one radar pixel covers #N$20 map units. The column
; (#N$00-#N$18) and row (#N$00-#N$1C) are stored in the third and fourth bytes
; of the blip record, measured from the top left of the radar. If the target is
; more than #N$0C pixels to the left or right of the player, or more than #N$0E
; pixels above or below, then both are set to #N$00 and the blip is hidden.
;
; BC Target X position (doubled)
; DE Target Y position (doubled)
; IX Radar blip record
;
; Work out the horizontal distance between the player and the target.
@label=LocateRadarBlip
c$6212 LD HL,($5E05) ; #REGhl=player X map position (#R$5E05).
 $6215 SLA L         ; {Double the value so it matches the scale of the target
 $6217 RL H          ; position.}
 $6219 AND A         ; Reset the carry flag.
 $621A SBC HL,BC     ; Work out the horizontal distance from the target to the
                     ; player.
 $621C JR NC,$61FE   ; If the target is not to the right of the player then jump to
                     ; #R$61FE.
; The target is to the right of the player, so make the distance positive.
 $621E CALL $6BF6    ; Call #R$6BF6.
 $6221 CALL $6253    ; Call #R$6253 to multiply the distance by #N$04, which leaves the
                     ; distance in radar pixels in #REGh.
 $6224 LD A,$0C      ; Start from the centre column of the radar (#N$0C).
 $6226 CP H          ; Compare the distance with #N$0C.
 $6227 JR C,$624D    ; If the target is more than #N$0C pixels to the right then jump to
                     ; #R$624D.
 $6229 ADD A,H       ; Add the distance to the centre column to give the column to the
                     ; right of the player.
; This entry point is used by the routine at #R$61FE.
; .
; Store the column and do the same for the vertical distance.
@label=LocateRadarBlip_StoreColumn
*$622A LD (IX+$02),A ; Store the column in the blip record.
 $622D LD HL,($5E08) ; #REGhl=player Y map position (#R$5E08).
 $6230 SLA L         ; {Double the value so it matches the scale of the target
 $6232 RL H          ; position.}
 $6234 AND A         ; Reset the carry flag.
 $6235 SBC HL,DE     ; Work out the vertical distance from the target to the
                     ; player.
 $6237 JR NC,$6208   ; If the target is not further up the map than the player then jump to
                     ; #R$6208.
; The target is further up the map than the player, so make the distance
; positive.
 $6239 CALL $6BF6    ; Call #R$6BF6.
 $623C CALL $6253    ; Call #R$6253 to multiply the distance by #N$04, which leaves the
                     ; distance in radar pixels in #REGh.
 $623F LD A,$0E      ; Start from the centre row of the radar (#N$0E).
 $6241 CP H          ; Compare the distance with #N$0E.
 $6242 JR C,$624D    ; If the target is more than #N$0E pixels away then jump
                     ; to #R$624D.
 $6244 ADD A,H       ; Add the distance to the centre row.
; This entry point is used by the routine at #R$6208.
; .
; Rows are counted down the radar, so flip the value to give the row above
; the centre.
@label=LocateRadarBlip_FlipRow
*$6245 NEG           ; Negate #REGa.
 $6247 ADD A,$1C     ; Add #N$1C so the row counts down from the top of the
                     ; radar.
; This entry point is used by the routine at #R$624D.
; .
; Store the row.
@label=LocateRadarBlip_StoreRow
*$6249 LD (IX+$03),A ; Store the row in the blip record.
 $624C RET           ; Return.

; Hide Radar Blip
;
; Used by the routines at #R$61FE, #R$6208, #R$6212 and #R$62DA.
; .
; Hides a blip by setting its column to #N$00, then jumps into #R$6212 to
; set its row to #N$00 as well.
;
; IX Radar blip record
@label=HideRadarBlip
c$624D XOR A         ; {Write #N$00 to the column of the blip record.
 $624E LD (IX+$02),A ; }
 $6251 JR $6249      ; Jump to #R$6249.

; Multiply HL By Four
;
; Used by the routines at #R$61FE, #R$6208, #R$6212 and #R$62DA.
; .
; Used to convert a distance (in doubled map units) into radar pixels,
; which are then found in #REGh.
;
;   HL Value
; O:HL Value multiplied by #N$04
@label=MultiplyHLByFour
c$6253 LD B,$02      ; Set the shift counter to #N$02.
@label=MultiplyHLByFour_Loop
*$6255 RL L          ; {Rotate #REGhl left by one place.
 $6257 RL H          ; }
 $6259 DJNZ $6255    ; Decrease the shift counter by one and loop back to #R$6255 until
                     ; both shifts have been done.
 $625B RET           ; Return.

; Update Radar
;
; Used by the routine at #R$6A9B.
; .
; Updates the radar. A blip is shown by clearing a #N$02 by #N$02 block of
; pixels, and removed again by setting them. The player is always the blip at
; the centre. The other blips are the two cars (at #R$5E8C and #R$5E98) and the
; first cup within range, which are tracked by three four-byte records starting
; at #R$5E68. The first two bytes of a record hold the column and row that were
; drawn last time and the next two bytes hold the new column and row, or zero if
; the target is not on the radar.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$5F07,stop=$5F29,clear=1,sp=$5E00)
; #SIM(start=$5FEF,stop=$6010,sp=$5E00)
; #SIM(start=$6010,stop=$6AAE,sp=$5E00)
; #SCR$06,$00,$0A,$05,$05(update-radar-before)
; | #SIM(start=$6AAE,stop=$6AB1)
; #SCR$06,$00,$0A,$05,$05(update-radar-after) } UDGTABLE# #POPS
;
; .
;
; Draw the player at the centre of the radar.
@label=UpdateRadar
c$625C LD HL,$6513   ; #REGhl=#N$6513 (the pixel column and row of the centre of the
                     ; radar).
 $625F LD BC,$0202   ; #REGbc=#N($0202, $04, $04) (the size of a blip).
 $6262 CALL $6991    ; Call #R$6991 to clear the pixels.
; Work out the new position of each blip.
 $6265 LD IX,$5E68   ; Point #REGix at the first blip record (#R$5E68).
 $6269 LD BC,($5E90) ; Fetch the X position of the car at #R$5E8C from #R$5E90.
 $626D LD DE,($5E92) ; Fetch the Y position of the car at #R$5E8C from #R$5E92.
 $6271 CALL $6212    ; Call #R$6212.
 $6274 LD BC,$0004   ; Set the size of a blip record, #N$04.
 $6277 ADD IX,BC     ; Point #REGix at the next blip record.
 $6279 LD BC,($5E9C) ; Fetch the X position of the car at #R$5E98 from #R$5E9C.
 $627D LD DE,($5E9E) ; Fetch the Y position of the car at #R$5E98 from #R$5E9E.
 $6281 CALL $6212    ; Call #R$6212.
 $6284 LD BC,$0004   ; Set the size of a blip record, #N$04.
 $6287 ADD IX,BC     ; Point #REGix at the next blip record.
 $6289 CALL $62DA    ; Call #R$62DA to find a cup to show.
; Now move each blip. This takes two passes: the first removes the blip
; from where it was last time and the second draws it at the new position.
 $628C LD IX,$5E68   ; Point #REGix at the first blip record (#R$5E68).
 $6290 LD C,$03      ; Set the blip counter to #N$03.
@label=UpdateRadar_Loop
*$6292 LD B,$02      ; Set the pass counter to #N$02.
 $6294 LD L,(IX+$00) ; Fetch the column of the blip.
 $6297 LD H,(IX+$01) ; Fetch the row of the blip.
@label=UpdateRadar_Pass
*$629A LD A,L        ; {If the blip is not on the radar then jump to #R$62D5.
 $629B OR H          ;
 $629C JR Z,$62D5    ; }
 $629E LD A,L        ; {Add #N$07 (the left edge of the radar) to the column.
 $629F ADD A,$07     ;
 $62A1 LD L,A        ; }
 $62A2 LD A,H        ; {Add #N$57 (the top edge of the radar) to the row.
 $62A3 ADD A,$57     ;
 $62A5 LD H,A        ; }
 $62A6 DEC B         ; Decrease the pass counter by one.
 $62A7 PUSH BC       ; Stash the counters on the stack.
 $62A8 JR NZ,$62C6   ; If this was the first pass then jump to #R$62C6.
; This is the second pass, so draw the blip at its new position.
 $62AA LD BC,$0202   ; #REGbc=#N($0202, $04, $04) (the size of a blip).
 $62AD CALL $6991    ; Call #R$6991 to clear the pixels.
 $62B0 POP BC        ; Restore the counters from the stack.
; The new position becomes the position that was drawn.
@label=UpdateRadar_Next
*$62B1 LD A,(IX+$02) ; Fetch the new column of the blip.
 $62B4 LD (IX+$00),A ; Store it as the column drawn.
 $62B7 LD A,(IX+$03) ; Fetch the new row of the blip.
 $62BA LD (IX+$01),A ; Store it as the row drawn.
 $62BD LD DE,$0004   ; Set the size of a blip record, #N$04.
 $62C0 ADD IX,DE     ; Point #REGix at the next blip record.
 $62C2 DEC C         ; {Decrease the blip counter by one and loop back to #R$6292 until all
 $62C3 JR NZ,$6292   ; #N$03 blips have been done.}
 $62C5 RET           ; Return.
; This is the first pass, so remove the blip from where it was drawn last
; time.
@label=UpdateRadar_RemoveBlip
*$62C6 LD BC,$0202   ; #REGbc=#N($0202, $04, $04) (the size of a blip).
 $62C9 CALL $6998    ; Call #R$6998 to set the pixels.
 $62CC POP BC        ; Restore the counters from the stack.
@label=UpdateRadar_NewPosition
*$62CD LD L,(IX+$02) ; Fetch the new column of the blip.
 $62D0 LD H,(IX+$03) ; Fetch the new row of the blip.
 $62D3 JR $629A      ; Jump to #R$629A for the second pass.
; There is no blip at this position.
@label=UpdateRadar_Hidden
*$62D5 DEC B         ; {Decrease the pass counter by one and jump to #R$62B1 if both passes
 $62D6 JR Z,$62B1    ; are done.}
 $62D8 JR $62CD      ; Jump to #R$62CD for the second pass.

; Locate Radar Cup
;
; Used by the routine at #R$625C.
; .
; Finds a cup to show on the radar. Each of the #N$08 cups in #R$721F is
; checked in turn: if the map entry still has the cup sprite ID (#N$20) and the
; cup is less than #N$0C cells (of #N$20 map units) from the player
; horizontally, then it is placed on the radar by #R$6212. Only the first such
; cup is used. If there is no cup then the blip is hidden.
;
; IX Radar blip record
;
; Find the player's horizontal position in cells.
@label=CollisionCup
c$62DA LD HL,($5E05) ; Fetch the player's X position on the map from #R$5E05.
 $62DD SLA L         ; {Double the value so it matches the scale used by the
 $62DF RL H          ; radar.}
 $62E1 CALL $6253    ; Call #R$6253 to multiply the position by #N$04, which leaves the
                     ; position in cells in #REGh.
 $62E4 LD C,H        ; Keep the player's X position in cells in #REGc.
 $62E5 LD HL,$721F   ; Point #REGhl at the table of cup map addresses
                     ; (#R$721F).
 $62E8 LD B,$08      ; Set the cup counter to #N$08, one for each cup.
; Fetch the address of the cup from #R$721F.
@label=CollisionCup_Loop
*$62EA LD E,(HL)     ; Fetch the low byte of the map address of this cup.
 $62EB INC HL        ; Move on to the high byte.
 $62EC LD D,(HL)     ; Fetch the high byte of the map address of this cup.
 $62ED INC HL        ; Move on to the next cup in the table.
; Check this is still a valid cup (that it hasn't been collected already).
 $62EE INC DE        ; {Point #REGde at the sprite ID of the map entry.
 $62EF INC DE        ; }
 $62F0 LD A,(DE)     ; {If this is not a cup (the sprite ID is not #N$20) then jump to
 $62F1 CP $20        ; #R$6301.
 $62F3 JR NZ,$6301   ; }
; This is still a valid cup, so process it.
 $62F5 DEC DE        ; {Point #REGde back at the start of the map entry.
 $62F6 DEC DE        ; }
 $62F7 LD A,(DE)     ; Fetch the X position of the cup.
 $62F8 SUB C         ; Subtract the player's X position to give the horizontal
                     ; distance.
 $62F9 JR NC,$62FD   ; {Make the distance positive.
 $62FB NEG           ; }
@label=CollisionCup_Test_X
*$62FD CP $0C        ; {If the cup is less than #N$0C cells away then jump to
 $62FF JR C,$6306    ; #R$6306.}
@label=CollisionCup_Next
*$6301 DJNZ $62EA    ; Decrease the cup counter by one and loop back to #R$62EA until all
                     ; of the cups have been checked.
 $6303 JP $624D      ; There is no cup in range so jump to #R$624D to hide the
                     ; blip.
; Convert the position of the cup to the same scale used by #R$6212.
@label=CollisionCup_Test_Y
*$6306 LD A,(DE)     ; Fetch the X position of the cup.
 $6307 INC DE        ; Point #REGde at the Y position of the cup.
 $6308 LD H,A        ; Keep the X position of the cup in #REGh.
 $6309 LD A,(DE)     ; Fetch the Y position of the cup.
 $630A LD D,A        ; Keep the Y position of the cup in #REGd.
 $630B CALL $6B30    ; Call #R$6B30 to set #REGde to the cup Y position multiplied by
                     ; #N$20.
 $630E EX DE,HL      ; Swap the #REGde and #REGhl registers.
 $630F CALL $6B2B    ; Call #R$6B2B to set #REGde to the cup X position multiplied by
                     ; #N$40.
 $6312 EX DE,HL      ; Swap the #REGde and #REGhl registers.
 $6313 LD B,H        ; Move the high byte of the doubled X position into #REGb.
 $6314 LD C,L        ; Move the low byte of the doubled X position into #REGc.
 $6315 JP $6212      ; Jump to #R$6212 to place the blip (#REGbc is the cup X position and
                     ; #REGde is the cup Y position, both doubled).
; View the equivalent code in;
; #LIST
; { #PSSST$63AA }
; LIST#

; Handle Explosion
;
; Runs while the car is exploding (state #N$03 in the first byte of the
; player entity at #R$5E80). The explosion timer (the fifth byte of the entity,
; which starts at #N$C0) counts down and when it reaches zero the game is over.
; Every four frames the sprite alternates between sprite IDs #N$21 and #N$22
; (the sprites at #R$7473 and #R$7494).
; The only sound while the car is exploding is the engine note, as the speed
; is set to #N$01 on every frame (see #R$6158).
; #HTML(#AUDIO0(explosion.wav)(#INCLUDE(Explosion)))
;
; IX Player entity (#R$5E80)
;
; #PUSHS #UDGTABLE(default,centre,centre,centre)
; { =h Before | =h Explosion 1 | =h Explosion 2 }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$5F07,stop=$5F29,clear=1,sp=$5E00)
; #SIM(start=$5FEF,stop=$6010,sp=$5E00)
; #SIM(start=$6010,stop=$6A87,sp=$5E00)
; #SCR$04,$11,$0A,$06,$05(explosion-before)
; | #POKES$5E80,$03;$5E84,$A5
; #SIM(start=$6009,stop=$6A87,sp=$5E00)
; #SCR$04,$11,$0A,$06,$05(explosion-frame-1)
; | #POKES$5E84,$A1
; #SIM(start=$6009,stop=$6A87,sp=$5E00)
; #SCR$04,$11,$0A,$06,$05(explosion-frame-2) } UDGTABLE# #POPS
@label=HandlerExplosion
c$6318 LD A,(IX+$0B)   ; Fetch the sprite ID of the current explosion frame from the end of
                       ; the entity.
 $631B LD (IX+$00),A   ; Write #REGa to the first byte of the entity, as this is the sprite
                       ; ID that #R$71ED copies.
 $631E CALL $71ED      ; Call #R$71ED to copy the position and sprite ID of the
                       ; entity.
 $6321 CALL $6557      ; Call #R$6557 to keep the player's marker on the map
                       ; flashing.
; Count down the length of the explosion.
 $6324 DEC (IX+$04)    ; {Decrease the explosion timer by one and jump to #R$6353 if the
 $6327 JR Z,$6353      ; explosion has finished.}
 $6329 LD A,(IX+$04)   ; Fetch the explosion timer.
 $632C AND %00000011   ; Keep only bits 0-1.
 $632E JR NZ,$6340     ; If the result is not zero then keep the same sprite and jump to
                       ; #R$6340.
 $6330 BIT 2,(IX+$04)  ; {If bit 2 of the explosion timer is not set then jump
 $6334 JR Z,$633C      ; to #R$633C.}
 $6336 LD (IX+$0B),$21 ; Write #N$21 to the sprite ID.
 $633A JR $6340        ; Jump to #R$6340.
; The other frame of the explosion.
@label=HandlerExplosion_Frame2
*$633C LD (IX+$0B),$22 ; Write #N$22 to the sprite ID.
; Redraw the explosion.
@label=HandlerExplosion_Draw
*$6340 LD A,(IX+$0B)   ; Fetch the sprite ID of the current explosion frame.
 $6343 LD (IX+$00),A   ; Write #REGa to the first byte of the entity, as this is the sprite
                       ; ID that #R$7101 draws.
 $6346 CALL $7101      ; Call #R$7101 to erase the old sprite and draw the new
                       ; one.
 $6349 LD (IX+$00),$03 ; Write #N$03 (the exploding state) to the first byte of
                       ; the entity.
 $634D LD A,$01        ; {Set the speed of the car to #N$01, which leaves the engine making a
 $634F LD ($5E0D),A    ; low note.}
 $6352 RET             ; Return.

; Game Over
;
; Used by the routine at #R$6318.
; .
; Reached when the explosion has finished. Takes a life away. If there are
; lives left then the next car starts at #R$63A7, otherwise the best time is
; checked, "GAME OVER" is shown for a short while and the game restarts.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$5F07,stop=$5F29,clear=1,sp=$5E00)
; #SIM(start=$5F29,stop=$5F2C)
; #SIM(start=$5FEF,stop=$6010,sp=$5E00)
; #SIM(start=$6010,stop=$6A87,sp=$5E00)
; #POKES$5E3D,$00
; #SCR$01(game-over-before)
; | #SIM(start=$6353,stop=$637E)
; #SCR$01(game-over-after) } UDGTABLE# #POPS
@label=GameOver
c$6353 CALL $7139    ; Call #R$7139 to erase the explosion.
 $6356 CALL $617F    ; Switch to night time using #R$617F.
; Give a 50/50 chance of "Night Driver" mode.
 $6359 LD A,R        ; Fetch a random number (from the Z80 refresh register).
 $635B AND %00000001 ; Keep only bit 0.
 $635D JR Z,$6362    ; If the random bit is clear then jump to #R$6362, keeping
                     ; night time.
; Else set "day" time.
 $635F CALL $6175    ; Switch back to day time using #R$6175.
; See #POKE(infinite_lives,Infinite Lives).
@label=GameOver_Skip
*$6362 LD HL,$5E3D   ; Point #REGhl at the number of lives (#R$5E3D).
 $6365 DEC (HL)      ; Take a life away.
 $6366 JP P,$63A7    ; If the number of lives is not negative then jump to
                     ; #R$63A7.
; Else, trigger the game over events.
 $6369 LD (HL),$00   ; Set the number of lives to #N$00.
 $636B POP HL        ; Remove the return address (#R$6A73) pushed by the main loop from the
                     ; stack.
 $636C CALL $605B    ; Check for a new high score using #R$605B.
 $636F CALL $6175    ; Switch to day time using #R$6175.
 $6372 CALL $68A0    ; Create the game window using #R$68A0.
; Print the "Game Over" messaging.
 $6375 LD HL,$5878   ; #REGhl=#N($5878, $04, $04) (pixel co-ordinates: #REGh is the Y
                     ; position and #REGl is the X position).
 $6378 LD DE,$63DA   ; Point #REGde at the "GAME OVER" text (#R$63DA).
 $637B CALL $5F97    ; Print the text using #R$5F97.
; Display the text for a short time.
 $637E LD B,$04      ; Set the delay count to #N$04.
 $6380 CALL $6386    ; Wait using #R$6386.
 $6383 JP $5F1A      ; Jump to #R$5F1A to go back to the game selection menu.
; View the equivalent code in;
; #LIST
; { #ATICATAC$8C35 }
; { #COOKIE$6BE0 }
; { #LUNARJETMAN$A8E3 }
; { #PSSST$60FD }
; { #SABREWULF$AA6A }
; LIST#

; Delay Loop
;
; Used by the routines at #R$6353, #R$63FF and #R$6919.
; .
; A pure delay. #REGhl counts down from zero, round through #N$FFFF, back
; to zero again, and this is repeated #REGb times.
;
; B Number of times to execute the delay
@label=Delay
c$6386 LD HL,$0000   ; Set the delay counter to #N$0000, which counts down
                     ; through #N$FFFF.
; From #REGhl being set above (and for each loop), decrementing
; #N($0000, $04, $04) by one gives #N$FFFF.
@label=Delay_Loop
*$6389 DEC HL        ; Decrease the delay counter by one.
 $638A LD A,L        ; {Loop back to #R$6389 until the delay counter is zero.
 $638B OR H          ;
 $638C JR NZ,$6389   ; }
 $638E DJNZ $6389    ; Decrease the repeat count by one and loop back to #R$6389 until the
                     ; delay has been repeated #REGb times.
 $6390 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #MARTIANOIDS$BD32 }
; LIST#

; Initialise New Game
;
; Used by the routine at #R$5FEF.
; .
; Sets up a new game with three lives, no cups collected, and the miles
; and time reset. Continues into #R$63A7 which sets up the first car.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$5F07,stop=$5F29,clear=1,sp=$5E00)
; #SIM(start=$5FEF,stop=$6006,sp=$5E00)
; #SCR$02,$00,$00,$08,$18(new-game-before)
; | #SIM(start=$6006,stop=$6009)
; #SCR$02,$00,$00,$08,$18(new-game-after) } UDGTABLE# #POPS
@label=NewGame
c$6391 LD A,$03      ; {Write starting lives to #R$5E3D (duplicate of #R$5FF6 - possibly so
 $6393 LD ($5E3D),A  ; POKEs would appear to not work?)}
; This entry point is used by the routine at #R$63FF.
@label=NewGame_ResetCups
*$6396 XOR A         ; {Set the number of cups collected to #N$00.
 $6397 LD ($5E3C),A  ; }
 $639A CALL $6498    ; Put the cups back at new positions using #R$6498.
; Reset miles and time.
 $639D LD HL,$5E2D   ; Point #REGhl at the miles (#R$5E2D).
 $63A0 LD B,$07      ; Set the byte counter to #N$07, to cover the miles and
                     ; the time.
@label=GameInit_Reset
*$63A2 LD (HL),$00   ; Clear a byte of the miles and time.
 $63A4 INC HL        ; Move on to the next byte.
 $63A5 DJNZ $63A2    ; Decrease the byte counter by one and loop back to #R$63A2 until the
                     ; miles and time have been cleared.
; This entry point is used by the routine at #R$6353.
; .
; Set up a new car.
@label=PlayerInit
*$63A7 CALL $68A0    ; Create the game window using #R$68A0.
 $63AA CALL $653E    ; Call #R$653E to find where the player's marker is on the
                     ; map.
 $63AD CALL $656E    ; Call #R$656E to save the screen byte at the position of
                     ; the marker.
 $63B0 CALL $6BFE    ; Find the first object using #R$6BFE.
 $63B3 CALL $6A09    ; Set up the entities using #R$6A09.
 $63B6 LD HL,$C000   ; {Write #N($C000, $04, $04) (the maximum value for fuel)
 $63B9 LD ($5E0A),HL ; to #R$5E0A.}
 $63BC LD H,$00      ; {Write #N($0000, $04, $04) to; #LIST { #R$5E0C } { #R$5E0E } {
 $63BE LD ($5E0C),HL ; #R$5E10 } LIST#
 $63C1 LD ($5E0E),HL ;
 $63C4 LD ($5E10),HL ; }
 $63C7 LD HL,$0C40   ; {Set the player's X position on the map (#R$5E05) to
 $63CA LD ($5E05),HL ; #N($0C40, $04, $04).}
 $63CD LD HL,$0640   ; {Set the player's Y position on the map (#R$5E08) to
 $63D0 LD ($5E08),HL ; #N($0640, $04, $04).}
 $63D3 XOR A         ; {Clear the last place visited (#R$5E4F).
 $63D4 LD ($5E4F),A  ; }
 $63D7 JP $6BFE      ; Jump to #R$6BFE to find the first object.
; View the equivalent code in;
; #LIST
; { #COOKIE$63F0 }
; { #LUNARJETMAN$A84C }
; LIST#

; Messaging: Game Over
@label=Message_GameOver
t$63DA DEFM "GAME OVE","R"+$80       ; "GAME OVER".
@label=Message_YourTime
 $63E3 DEFM "YOUR TIME WA","S"+$80   ; "YOUR TIME WAS".
@label=Message_BestTime
 $63F0 DEFM "BEST TIME TODA","Y"+$80 ; "BEST TIME TODAY".

; Handler: Pick Up Cup
;
; Used by the routine at #R$702A.
; .
; Awards the points for a cup, which are #N$0200 for the first cup up to
; #N$1600 for the eighth (the number of cups already collected plus one,
; doubled, in hundreds). If this was the last of the eight cups then the
; "congratulations" messaging is shown along with the time taken, "Best Time
; Today" is updated if it has been beaten, and a new round starts (without
; resetting the lives). Otherwise the number of cups collected is displayed.
;
; .
;
; Calculate number of points to award.
@label=HandlerCup
c$63FF LD A,($5E3C)  ; Fetch the number of cups collected so far (#R$5E3C).
 $6402 INC A         ; {Work out the points as (cups collected + #N$01) *
 $6403 ADD A,A       ; #N$02, in BCD.
 $6404 DAA           ; }
; Adds points to score.
 $6405 LD B,A        ; Set the points to award, in hundreds (as BCD).
 $6406 LD C,$00      ; Set the units and tens of the points to #N$00.
 $6408 CALL $6046    ; Add the points to the score using #R$6046.
; Handle incrementing the cup counter.
 $640B LD HL,$5E3C   ; {Increment #R$5E3C by one.
 $640E INC (HL)      ; }
; Have all the cups been collected?
 $640F LD A,(HL)     ; Fetch the number of cups collected.
 $6410 CP $08        ; {If fewer than #N$08 cups have been collected then jump to #R$646C to
 $6412 JR C,$646C    ; display the count.}
; All cups have been collected, display the "congratulations" messaging.
 $6414 CALL $6175    ; Switch to day time using #R$6175.
 $6417 CALL $68A0    ; Create the game window using #R$68A0.
 $641A CALL $607D    ; Display the congratulations message using #R$607D.
; Writes the line "YOUR TIME WAS".
 $641D LD HL,$5868   ; #REGhl=#N($5868, $04, $04) (pixel co-ordinates: #REGh is the Y
                     ; position and #REGl is the X position).
 $6420 LD DE,$63E3   ; Point #REGde at the "YOUR TIME WAS" text (#R$63E3).
 $6423 CALL $5F97    ; Print the text using #R$5F97.
; Set #REGhl to where the time itself will display.
 $6426 LD HL,$6880   ; #REGhl=#N($6880, $04, $04) (pixel co-ordinates: #REGh is the Y
                     ; position and #REGl is the X position).
 $6429 CALL $6F10    ; Call #R$6F10 to convert this into a screen address.
 $642C CALL $6CEC    ; Display the time taken using #R$6CEC.
; Has a "Best Time Today" been set yet?
 $642F LD A,($5E03)  ; {If #R$5E03 is zero then jump to #R$645A.
 $6432 AND A         ;
 $6433 JR Z,$645A    ; }
 $6435 CALL $6483    ; Display the best time so far using #R$6483.
; Compare the time taken with the best time, one byte at a time starting
; with the most significant.
 $6438 LD HL,$5E00   ; Point #REGhl at the best time (#R$5E00).
 $643B LD DE,$5E31   ; Point #REGde at the time taken (#R$5E31).
 $643E LD B,$03      ; Set the byte counter to #N$03.
@label=BestTime_Compare
*$6440 LD A,(DE)     ; {Compare the byte of the time at #REGde against the byte of the best
 $6441 CP (HL)       ; time at #REGhl.}
 $6442 JR C,$645E    ; If the time is less than the best time then jump to
                     ; #R$645E.
 $6444 JR Z,$6448    ; If the bytes are the same then jump to #R$6448.
 $6446 JR $644C      ; The time is more than the best time, so jump to #R$644C.
@label=BestTime_Compare_Next
*$6448 INC HL        ; Move onto the next #R$5E00 byte.
 $6449 INC DE        ; Move onto the next #R$5E31 byte.
 $644A DJNZ $6440    ; Decrease the byte counter by one and loop back to #R$6440 until all
                     ; of the bytes have been compared.
; This entry point is used by the routine at #R$645A.
; .
; Create a short pause, then start the next round.
@label=HandlerCup_Delay
*$644C LD B,$0C      ; Set the delay count to #N$0C.
 $644E CALL $6386    ; Pause using #R$6386.
 $6451 CALL $6396    ; Call #R$6396 to reset the cups and set up a new car, which returns
                     ; here.
 $6454 LD SP,$5E00   ; Set the stack pointer to #N($5E00, $04, $04).
 $6457 JP $6009      ; Jump to #R$6009.

; Update "Best Time Today"
;
; Used by the routine at #R$63FF.
; .
; Reached when no "Best Time Today" has been set yet. Sets the flag to say
; that one exists, then stores the time taken as the best time.
@label=BestTime_Set
c$645A INC A         ; Make #REGa #N$01 (it is zero here).
 $645B LD ($5E03),A  ; Set the "Best Time Today" flag at #R$5E03.
; This entry point is used by the routine at #R$63FF.
@label=BestTime_Update
*$645E LD HL,($5E31) ; {Write #R$5E31 to #R$5E00.
 $6461 LD ($5E00),HL ;
 $6464 LD A,($5E33)  ;
 $6467 LD ($5E02),A  ; }
 $646A JR $644C      ; Jump to #R$644C.

; Display Cups Collected
;
; Used by the routines at #R$63FF and #R$68A0.
; .
; Shows a cup sprite and the number of cups collected.
;
; .
;
; Prints the cup sprite to the screen.
@label=DisplayCupsCollected
c$646C LD HL,$672E   ; #REGhl=#N($672E, $04, $04) (pixel co-ordinates: #REGh is the Y
                     ; position and #REGl is the X position).
 $646F LD DE,$7F4A   ; Point #REGde at the cup sprite (#R$7F4A).
 $6472 CALL $70DB    ; Call #R$70DB to set up the sprite at these co-ordinates.
 $6475 CALL $714C    ; Call #R$714C to draw the sprite.
; Print the "cups collected" count to the screen.
 $6478 LD DE,$5E3C   ; Point #REGde at the number of cups collected (#R$5E3C).
 $647B LD HL,$48C6   ; Set the screen address of the count, #N$48C6.
 $647E LD B,$01      ; Set the digit counter to #N$01.
 $6480 JP $6CD2      ; Jump to #R$6CD2 to print the count as a single digit.

; Display Best Time
;
; Used by the routines at #R$5F07 and #R$63FF.
; .
; Shows the "BEST TIME TODAY" line and the best time.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$5F07,stop=$5F29,clear=1,sp=$5E00)
; #SIM(start=$5FEF,stop=$6010,sp=$5E00)
; #SIM(start=$5F29,stop=$5F2C)
; #POKES$5E00,$01;$5E01,$23;$5E02,$45;$5E03,$01
; #SCR$03,$08,$11,$18,$05(display-best-time-before)
; | #SIM(start=$5F2C,stop=$5F33)
; #SCR$03,$08,$11,$18,$05(display-best-time-after) } UDGTABLE# #POPS
;
; .
;
; Writes the line "BEST TIME TODAY".
@label=DisplayBestTime
c$6483 LD HL,$9060   ; #REGhl=#N($9060, $04, $04) (pixel co-ordinates: #REGh is the Y
                     ; position and #REGl is the X position).
 $6486 LD DE,$63F0   ; Point #REGde at the "BEST TIME TODAY" text (#R$63F0).
 $6489 CALL $5F97    ; Print the line using #R$5F97.
; Set #REGhl to where the time itself will display.
 $648C LD HL,$A080   ; #REGhl=#N($A080, $04, $04) (pixel co-ordinates: #REGh is the Y
                     ; position and #REGl is the X position).
 $648F CALL $6F10    ; Call #R$6F10 to convert this into a screen address.
; Point to Best Time.
 $6492 LD DE,$5E00   ; Point #REGde at the best time (#R$5E00).
 $6495 JP $6CFD      ; Jump to #R$6CFD.

; Randomise Cup Positions
;
; Used by the routine at #R$6391.
; .
; Gives every cup on the map a new Y position from #N$20 to #N$9F, putting
; back any cups which have been collected. The numbers come from the ROM, read
; from a random address in the first #N$4000 bytes (the low byte of the address
; is whatever is in #REGe).
@label=RandomiseCups
c$6498 LD BC,$7CD6   ; Point #REGbc at the end of the map (#R$7CD6, one byte past the end
                     ; of #R$7811).
 $649B LD A,R        ; Fetch a random number (from the Z80 refresh register).
; Limit the number to 0-63.
 $649D AND %00111111 ; Keep only bits 0-5.
 $649F LD D,A        ; Use it as the high byte of a random ROM address, held in
                     ; #REGd.
 $64A0 LD HL,$0000   ; #REGhl=#N($0000, $04, $04).
 $64A3 ADD HL,DE     ; {Add #REGde to #REGhl then swap them over (this leaves #REGde
 $64A4 EX DE,HL      ; unchanged).}
 $64A5 LD HL,$7813   ; #REGhl=#R$7811(#N$7813) (the sprite ID of the first map
                     ; entry).
; Check the sprite ID of each map entry.
@label=RandomiseCups_Loop
*$64A8 LD A,(HL)     ; Fetch the sprite ID of the map entry.
 $64A9 CP $20        ; {If this is a cup (#REGa is #N$20) then jump to #R$64B3.
 $64AB JR Z,$64B3    ; }
 $64AD CP $60        ; {If this is not a collected cup (#REGa is not #N$60) then jump to
 $64AF JR NZ,$64BC   ; #R$64BC.}
 $64B1 LD (HL),$20   ; Put the cup back by writing #N$20 as the sprite ID.
; Write a new random Y position.
@label=HandlerSpriteCup
*$64B3 DEC HL        ; Point #REGhl at the Y position of the cup.
 $64B4 LD A,(DE)     ; Fetch a random byte from the ROM.
 $64B5 INC DE        ; Move on to the next ROM address.
 $64B6 AND %01111111 ; Keep only bits 0-6.
 $64B8 ADD A,$20     ; Add #N$20 so that the Y position is between #N$20 and
                     ; #N$9F.
 $64BA LD (HL),A     ; Store the new Y position of the cup.
 $64BB INC HL        ; Point #REGhl back at the sprite ID of the map entry.
; Move on to the sprite ID of the next map entry, and check if the end of
; the map has been reached.
@label=RandomiseCups_Next
*$64BC INC HL        ; {Increment #REGhl by three.
 $64BD INC HL        ;
 $64BE INC HL        ; }
 $64BF PUSH HL       ; Stash the map pointer on the stack.
 $64C0 AND A         ; Reset the carry flag.
 $64C1 SBC HL,BC     ; Work out how far the map pointer is from the end of the
                     ; map.
 $64C3 POP HL        ; Restore the map pointer from the stack.
 $64C4 JR C,$64A8    ; If the map pointer is before the end of the map then jump to
                     ; #R$64A8.
 $64C6 RET           ; Return.

; Handler: Update Time
;
; Used by the routine at #R$6A9B.
; .
; Adds one second to the time taken every #N$32 frames. The time is held
; as three BCD bytes from #R$5E31: hours (a single digit), minutes and seconds.
@label=HandlerTime
c$64C7 LD A,($5C78)  ; Fetch the frame counter from #SKOOLKID$5C78(FRAMES).
 $64CA CP $32        ; {Return if less than #N$32 frames (one second) have
 $64CC RET C         ; passed.}
 $64CD SUB $32       ; Take #N$32 frames off the frame counter.
 $64CF LD ($5C78),A  ; Write the remaining frames back to
                     ; #SKOOLKID$5C78(FRAMES).
; Update the time from the smallest unit upwards.
; .
; Handles the "seconds".
 $64D2 LD HL,$5E33   ; Point #REGhl at the seconds of the time (#R$5E33).
 $64D5 LD A,(HL)     ; Grab the seconds.
 $64D6 INC A         ; Add one second.
 $64D7 DAA           ; {Convert to BCD and write seconds back to #R$5E33.
 $64D8 LD (HL),A     ; }
 $64D9 CP $60        ; {Return unless seconds have reached #N$60.
 $64DB RET NZ        ; }
 $64DC LD (HL),$00   ; Reset seconds to #N$00.
; Handles the "minutes".
 $64DE DEC HL        ; Point #REGhl at the minutes of the time (#R$5E32).
 $64DF LD A,(HL)     ; Grab the minutes.
 $64E0 INC A         ; Add one minute.
 $64E1 DAA           ; {Convert to BCD and write minutes back to #R$5E32.
 $64E2 LD (HL),A     ; }
 $64E3 CP $60        ; {Return unless minutes have reached #N$60.
 $64E5 RET NZ        ; }
 $64E6 LD (HL),$00   ; Reset minutes to #N$00.
; Handles the "hours".
 $64E8 DEC HL        ; Point #REGhl at the hours of the time (#R$5E31).
 $64E9 LD A,(HL)     ; Grab the hours.
 $64EA INC A         ; Add one hour.
 $64EB DAA           ; Convert to BCD.
 $64EC AND %00001111 ; Keep only bits 0-3 (so the hours are a single digit).
 $64EE LD (HL),A     ; Write hours back to #R$5E31.
 $64EF RET           ; Return.

; Display Place Name
;
; Used by the routine at #R$6F3C.
; .
; Prints the name of a place on the bottom line of the screen. Nothing
; happens unless bit 6 of the sprite ID of the map entry is set, which marks it
; as a place name. Bits 0-5 are then the number of the name in #R$722F. The
; number plus one is written to #R$5E39 so that #R$6A9B knows a place name is
; being shown.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$5F07,stop=$5F29,clear=1,sp=$5E00)
; #SIM(start=$5FEF,stop=$6010,sp=$5E00)
; #SCR$03,$08,$15,$18,$03(place-name-before)
; | #POKES$5DFE,$DA;$5DFF,$6F
; #SIM(start=$64F0,stop=$6FDA,a=$42,sp=$5DFE)
; #SCR$03,$08,$15,$18,$03(place-name-after) } UDGTABLE# #POPS
;
; A Bits 0-6 of #R$5E1F
@label=DisplayPlaceName
c$64F0 BIT 6,A       ; {Return if bit 6 of #REGa is not set (i.e. not a place
 $64F2 RET Z         ; name).}
; Strip out the bit which indicates the need to display the place name.
 $64F3 AND %00111111 ; Keep only bits 0-5.
 $64F5 LD DE,$0005   ; Set the minimum length of a place name without the "end-of-string"
                     ; bit (e.g. "TUCSO(N)"), #N($0005, $04, $04).
 $64F8 LD HL,$722F   ; Point #REGhl at the table of place names (#R$722F).
 $64FB INC A         ; {Write the number of the place name plus one to #R$5E39.
 $64FC LD ($5E39),A  ; }
 $64FF DEC A         ; {Set the place name counter to the number of the place
 $6500 LD B,A        ; name.}
 $6501 JR Z,$650B    ; If it is the first place name then there is no need to search, so
                     ; jump to #R$650B.
; Speed up (slightly) searching through place names by adding #REGde
; (#N($0005, $04, $04)) to the start address.
@label=DisplayPlaceName_Search
*$6503 ADD HL,DE     ; Add the minimum length of a place name to the pointer.
; Search for the end of the current place name.
@label=DisplayPlaceName_Loop
*$6504 BIT 7,(HL)    ; If bit 7 (the "end-of-string" flag) is not set...
 $6506 INC HL        ; Increment #REGhl by one.
 $6507 JR Z,$6504    ; ...then jump to #R$6504.
; #REGb stores the entry number of the place name, so keep going until we
; find it.
 $6509 DJNZ $6503    ; Decrease the place name counter by one and loop back to #R$6503
                     ; until the right place name has been reached.
; Output the place name to the screen.
@label=DisplayPlaceName_Print
*$650B EX DE,HL      ; Swap the registers, so that #REGde points at the place
                     ; name.
 $650C LD HL,$B868   ; #REGhl=#N$B868 (pixel co-ordinates: #REGh is the Y position and
                     ; #REGl is the X position).
 $650F PUSH HL       ; Stash the pixel co-ordinates on the stack.
 $6510 CALL $6F10    ; Convert them to a screen address using #R$6F10.
 $6513 LD A,$70      ; Set the attribute of the place name to #COLOUR$70.
 $6515 EX AF,AF'     ; Keep the attribute in the shadow #REGaf register.
 $6516 JR $651F      ; Jump to #R$651F.

; Print Colour String
;
; Used by the routines at #R$68A0, #R$6919 and #R$6A9B.
; .
; Prints a string of characters and sets the attribute of each one. The
; first byte of the string is the attribute and the last character of the string
; has bit 7 set.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$5F07,stop=$5F29,clear=1,sp=$5E00)
; #SIM(start=$5F26,stop=$68F2)
; #SCR$04,$08,$00,$18,$01(print-colour-string-before)
; | #SIM(start=$68F2,stop=$68F8)
; #SCR$04,$08,$00,$18,$01(print-colour-string-after) } UDGTABLE# #POPS
;
; HL Pixel co-ordinates (#REGh is the Y position, #REGl the X position)
; DE Pointer to string data
@label=PrintStringColour
c$6518 PUSH HL       ; Stash the pixel co-ordinates on the stack.
 $6519 CALL $6F10    ; Convert them to a screen address using #R$6F10.
 $651C LD A,(DE)     ; Fetch the attribute from the first byte of the string.
 $651D EX AF,AF'     ; Keep the attribute in the shadow #REGaf register.
 $651E INC DE        ; Increment #REGde by one to point to the text of the
                     ; string.
; This entry point is used by the routines at #R$64F0 and #R$6919.
@label=PrintStringColour_UseAttribute
*$651F EXX           ; Switch to the shadow registers.
 $6520 POP HL        ; Restore the pixel co-ordinates from the stack.
 $6521 CALL $7097    ; Find the attribute address of the cell using #R$7097.
; This entry point is used by the routine at #R$5F97.
; .
; Print each character, and set its attribute.
@label=PrintString_Loop
*$6524 EXX           ; Switch back to the normal registers.
 $6525 LD A,(DE)     ; Fetch the character to print.
 $6526 BIT 7,A       ; {If bit 7 is set (which signifies the end of the string), jump to
 $6528 JR NZ,$6535   ; #R$6535.}
 $652A CALL $6C96    ; Print the character using #R$6C96.
 $652D INC DE        ; Move on to the next character of the string.
 $652E EXX           ; Switch to the shadow registers.
 $652F EX AF,AF'     ; Switch to the shadow #REGaf register.
 $6530 LD (HL),A     ; Copy the attribute byte to the screen.
 $6531 INC L         ; Move on to the next cell on the row.
 $6532 EX AF,AF'     ; Switch to the shadow #REGaf register.
 $6533 JR $6524      ; Jump to #R$6524.
; Because the last character contains the terminator, it needs to be
; handled separately.
@label=PrintString_LastCharacter
*$6535 AND %01111111 ; Keep only bits 0-6 (i.e. strip the bit 7 terminator).
 $6537 CALL $6C96    ; Print the last character using #R$6C96.
 $653A EXX           ; Switch to the shadow registers.
 $653B EX AF,AF'     ; Switch to the shadow #REGaf register.
 $653C LD (HL),A     ; Copy the attribute byte to the screen.
 $653D RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$A1F3 }
; { #COOKIE$7488 }
; { #JETPAC$716C }
; { #LUNARJETMAN$8A11 }
; { #MARTIANOIDS$BD99 }
; { #PSSST$73ED }
; { #SABREWULF$B53D }
; { #UNDERWURLDE$9C3C }
; LIST#

; Locate Player Marker
;
; Used by the routines at #R$6391 and #R$6557.
; .
; Works out where the player's marker belongs on the map in the sidebar,
; where one pixel is #N$80 units of the player's position. The marker is at
; #REGh=#N$47 - the Y position / #N$80 and #REGl=#N$08 + the X position / #N$80.
;
; O:HL Pixel co-ordinates of the marker (#REGh is the Y position and #REGl is
; .    the X position)
@label=LocatePlayerMarker
c$653E LD DE,($5E08) ; Fetch the player's Y position on the map (#R$5E08).
 $6542 SLA E         ; {Double it, so that #REGd holds the Y position / #N$80.
 $6544 RL D          ; }
 $6546 LD A,$47      ; Start from #N$47, the bottom of the map.
 $6548 SUB D         ; Take the Y position away, as the map counts up from the
                     ; bottom.
 $6549 LD D,A        ; Keep the Y position of the marker in #REGd.
 $654A LD HL,($5E05) ; Fetch the player's X position on the map (#R$5E05).
 $654D SLA L         ; {Double it, so that #REGh holds the X position / #N$80.
 $654F RL H          ; }
 $6551 LD A,H        ; Fetch the X position / #N$80.
 $6552 ADD A,$08     ; Add #N$08, the X position of the left edge of the map.
 $6554 LD L,A        ; Set the X position of the marker in #REGl.
 $6555 LD H,D        ; Set the Y position of the marker in #REGh.
 $6556 RET           ; Return.

; Flash Player Marker
;
; Used by the routines at #R$6318 and #R$6A9B.
; .
; Shows the player's position on the map in the sidebar as a pixel which
; flashes on and off every #N$08 frames. When the marker moves, the screen byte
; it was covering is put back, using the copy saved in #R$5E38. The address of
; that byte is held in #R$5E36.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Marker on | =h Marker off }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$5F07,stop=$5F29,clear=1,sp=$5E00)
; #SIM(start=$5FEF,stop=$6010,sp=$5E00)
; #POKES$5E05,$C0;$5E06,$0C;$5E08,$98;$5E09,$05
; #SIM(start=$6010,stop=$6AAB,sp=$5E00)
; #POKES$5E29,$08
; #SIM(start=$6AAB,stop=$6AAE)
; #SCR$08,$02,$06,$05,$03(flash-marker-on)
; | #POKES$5E29,$00
; #SIM(start=$6AAB,stop=$6AAE)
; #SCR$08,$02,$06,$05,$03(flash-marker-off) } UDGTABLE# #POPS
@label=FlashPlayerMarker
c$6557 CALL $653E    ; Work out the pixel co-ordinates of the marker using
                     ; #R$653E.
; Has the marker moved? The saved value is a screen address, whereas
; #REGhl holds pixel co-ordinates, so these are only equal by coincidence.
 $655A PUSH HL       ; Stash the pixel co-ordinates on the stack.
 $655B LD DE,($5E36) ; Fetch the screen address saved for the marker (#R$5E36).
 $655F AND A         ; Reset the carry flag.
 $6560 SBC HL,DE     ; Compare the pixel co-ordinates with the saved screen
                     ; address.
 $6562 POP HL        ; Restore the pixel co-ordinates from the stack.
 $6563 JR Z,$657A    ; Jump to #R$657A if the result was zero.
; Put back the screen byte that was covered by the marker.
 $6565 PUSH HL       ; Stash the pixel co-ordinates on the stack.
 $6566 LD HL,($5E36) ; Fetch the screen address of the byte the marker covered
                     ; (#R$5E36).
 $6569 LD A,($5E38)  ; Fetch the screen byte that the marker covered (#R$5E38).
 $656C LD (HL),A     ; Put the screen byte back.
 $656D POP HL        ; Restore the pixel co-ordinates from the stack.
; This entry point is used by the routine at #R$6391.
; .
; Save the screen byte at the position of the marker.
@label=FlashPlayerMarker_SaveByte
*$656E PUSH HL       ; Stash the pixel co-ordinates on the stack.
 $656F CALL $6F10    ; Convert the pixel co-ordinates to a screen address using
                     ; #R$6F10.
 $6572 LD ($5E36),HL ; Save the screen address of the marker at #R$5E36.
 $6575 LD A,(HL)     ; Fetch the screen byte at the marker.
 $6576 LD ($5E38),A  ; Save the screen byte at #R$5E38.
 $6579 POP HL        ; Restore the pixel co-ordinates from the stack.
; Flash the marker, setting the pixel on one phase and clearing it on the
; other.
@label=FlashPlayerMarker_Flash
*$657A LD BC,$0101   ; Set the size of the marker, a single pixel (#N($0101,
                     ; $04, $04)).
 $657D LD A,($5E29)  ; Fetch the game timer from #R$5E29.
 $6580 AND %00001000 ; Keep only bit 3, which changes every #N$08 frames.
 $6582 JP NZ,$6998   ; If the bit is set then jump to #R$6998 to draw the
                     ; marker.
 $6585 JP $6991      ; Else jump to #R$6991 to remove the marker.

; Update Terrain Dots
;
; Used by the routine at #R$6A9B.
; .
; Moves the dots which are scattered over the play area, to give the
; impression that the car is moving. Nothing happens unless the car has moved
; since last time. Each of the #N$10 dots at #R$65FD is then redrawn by #R$65B1.
; The low bytes of the player's X (flipped) and Y positions are saved in #R$5E34
; so the dots can be erased from where they were drawn.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$5F07,stop=$5F29,clear=1,sp=$5E00)
; #SIM(start=$5FEF,stop=$6010,sp=$5E00)
; #SIM(start=$6010,stop=$6AB1,sp=$5E00)
; #SCR$02,$09,$03,$16,$12(terrain-dots-before)
; | #SIM(start=$6AB1,stop=$6AB4)
; #SCR$02,$09,$03,$16,$12(terrain-dots-after) } UDGTABLE# #POPS
@label=UpdateTerrainDots
c$6588 LD HL,($5E34) ; Fetch the player position used last time (#R$5E34).
 $658B LD A,($5E05)  ; Fetch the low byte of the player's X position on the map
                     ; (#R$5E05).
 $658E CPL           ; Flip all the bits, as the dots move the opposite way to
                     ; the car.
 $658F LD E,A        ; Keep the flipped X position in #REGe.
 $6590 LD A,($5E08)  ; {Fetch the low byte of the player's Y position on the map (#R$5E08)
 $6593 LD D,A        ; and keep it in #REGd.}
; Check if the player has moved.
 $6594 AND A         ; Reset the carry flag.
 $6595 PUSH HL       ; Stash #REGhl on the stack.
 $6596 SBC HL,DE     ; Compare the new player position with the position used
                     ; last time.
 $6598 POP HL        ; Restore #REGhl from the stack.
 $6599 RET Z         ; Return if the player has not moved.
 $659A PUSH DE       ; Stash the new player position on the stack.
 $659B LD IX,$65FD   ; Point #REGix at the first terrain dot (#R$65FD).
 $659F LD B,$10      ; Set the dot counter to #N$10.
@label=UpdateTerrainDots_Loop
*$65A1 PUSH BC       ; Stash the dot counter on the stack.
 $65A2 CALL $65B1    ; Update the dot using #R$65B1.
 $65A5 INC IX        ; {Point #REGix at the next dot.
 $65A7 INC IX        ; }
 $65A9 POP BC        ; Restore the dot counter from the stack.
 $65AA DJNZ $65A1    ; Decrease the dot counter by one and loop back to #R$65A1 until all
                     ; #N$10 dots have been updated.
 $65AC POP HL        ; Restore the new player position from the stack.
 $65AD LD ($5E34),HL ; Write #REGhl to #R$5E34.
 $65B0 RET           ; Return.

; Update Terrain Dot
;
; Used by the routine at #R$6588.
; .
; Erases a terrain dot if it has been drawn, then draws it at its new
; position if that is inside the play area. The attribute of the cell containing
; the dot is also set. A dot is drawn as a #N$02 by #N$02 block of pixels.
;
; D Low byte of the player Y map position
; E Low byte of the player X map position (flipped)
; IX Terrain dot (an entry in #R$65FD)
@label=UpdateTerrainDot
c$65B1 LD BC,$0202    ; Set the size of a dot (#N($0202, $04, $04)).
 $65B4 BIT 0,(IX+$00) ; {If bit 0 of the X position is set (the dot has been drawn) then call
 $65B8 CALL NZ,$6980  ; #R$6980 to erase it.}
; Work out the X position of the dot on the screen.
 $65BB LD A,(IX+$00)  ; Fetch the X position of the dot.
 $65BE AND %11111110  ; Keep only bits 1-7.
 $65C0 NEG            ; Negate it, as the dots move the opposite way to the
                      ; car.
 $65C2 ADD A,E        ; Add the player's X position to give the X position of the dot on the
                      ; screen.
 $65C3 CP $48         ; {Return if this is before the left edge of the play area (less than
 $65C5 RET C          ; #N$48).}
 $65C6 CP $F8         ; {Return if this is after the right edge of the play area (#N$F8 or
 $65C8 RET NC         ; more).}
 $65C9 LD L,A         ; Set the X position on the screen in #REGl.
; Work out the Y position of the dot on the screen.
 $65CA LD A,D         ; Fetch the player's Y position.
 $65CB SUB (IX+$01)   ; Take the Y position of the dot away to give the Y position on the
                      ; screen.
 $65CE CP $08         ; {Return if this is above the top of the play area (less
 $65D0 RET C          ; than #N$08).}
 $65D1 CP $B8         ; {Return if this is below the bottom of the play area
 $65D3 RET NC         ; (#N$B8 or more).}
 $65D4 LD H,A         ; Set the Y position on the screen in #REGh.
; Draw the dot.
 $65D5 SET 0,(IX+$00) ; Set bit 0 of the X position to show that the dot has
                      ; been drawn.
 $65D9 LD BC,$0202    ; #REGbc=#N$0202 (the size of a dot).
 $65DC PUSH HL        ; Stash the pixel co-ordinates on the stack.
 $65DD CALL $6998     ; Call #R$6998.
 $65E0 POP HL         ; Restore the pixel co-ordinates from the stack.
 $65E1 PUSH DE        ; Stash #REGde on the stack.
 $65E2 CALL $7097     ; Find the attribute address of the cell using #R$7097.
 $65E5 POP DE         ; Restore #REGde from the stack.
; Set the attribute of the cell. At night this is the background attribute
; with white ink, so the dot can be seen. In the day it is the background
; attribute.
 $65E6 LD A,($5E43)   ; {Jump to #R$65F8 if #R$5E43 is zero.
 $65E9 AND A          ;
 $65EA JR Z,$65F8     ; }
 $65EC LD A,($5E44)   ; Fetch the background attribute (#R$5E44).
 $65EF OR %00000111   ; Set bits 0-2, which gives white ink so the dot can be
                      ; seen.
@label=UpdateTerrainDot_Apply
*$65F1 LD C,A         ; Keep the new attribute in #REGc.
 $65F2 LD A,(HL)      ; Fetch the current attribute of the cell.
 $65F3 CP $76         ; {Return if the attribute is already #N$76.
 $65F5 RET Z          ; }
 $65F6 LD (HL),C      ; Set the attribute of the cell.
 $65F7 RET            ; Return.
@label=UpdateTerrainDot_Day
*$65F8 LD A,($5E44)   ; Fetch the background attribute (#R$5E44).
 $65FB JR $65F1       ; Jump to #R$65F1.

; Terrain Dots
;
; The #N$10 dots scattered over the play area. Each entry is two bytes:
; the X position and the Y position of the dot. Bit 0 of the X position is
; set when the dot is drawn.
@label=TerrainDots
b$65FD DEFB $00,$E0  ; Entity #N($01 + (#PC - $65FD) / $02) X/ Y co-ordinates.
 $65FF DEFB $10,$A0  ; Entity #N($01 + (#PC - $65FD) / $02) X/ Y co-ordinates.
 $6601 DEFB $20,$20  ; Entity #N($01 + (#PC - $65FD) / $02) X/ Y co-ordinates.
 $6603 DEFB $30,$FF  ; Entity #N($01 + (#PC - $65FD) / $02) X/ Y co-ordinates.
 $6605 DEFB $40,$60  ; Entity #N($01 + (#PC - $65FD) / $02) X/ Y co-ordinates.
 $6607 DEFB $60,$E0  ; Entity #N($01 + (#PC - $65FD) / $02) X/ Y co-ordinates.
 $6609 DEFB $70,$10  ; Entity #N($01 + (#PC - $65FD) / $02) X/ Y co-ordinates.
 $660B DEFB $80,$70  ; Entity #N($01 + (#PC - $65FD) / $02) X/ Y co-ordinates.
 $660D DEFB $90,$B0  ; Entity #N($01 + (#PC - $65FD) / $02) X/ Y co-ordinates.
 $660F DEFB $A0,$20  ; Entity #N($01 + (#PC - $65FD) / $02) X/ Y co-ordinates.
 $6611 DEFB $B0,$FF  ; Entity #N($01 + (#PC - $65FD) / $02) X/ Y co-ordinates.
 $6613 DEFB $C0,$60  ; Entity #N($01 + (#PC - $65FD) / $02) X/ Y co-ordinates.
 $6615 DEFB $D0,$E0  ; Entity #N($01 + (#PC - $65FD) / $02) X/ Y co-ordinates.
 $6617 DEFB $E0,$00  ; Entity #N($01 + (#PC - $65FD) / $02) X/ Y co-ordinates.
 $6619 DEFB $F0,$40  ; Entity #N($01 + (#PC - $65FD) / $02) X/ Y co-ordinates.
 $661B DEFB $F0,$B0  ; Entity #N($01 + (#PC - $65FD) / $02) X/ Y co-ordinates.

; Reduce Car X Position
;
; Used by the routine at #R$6633.
; .
; Continues #R$6633 when the car is moving towards lower X positions.
; Takes the distance away from the X position, stopping at zero.
;
; DE X position of the car
; HL Distance to move
@label=ReduceCarX
c$661D EX DE,HL      ; Swap #REGde and #REGhl so that #REGhl is the X position and #REGde
                     ; is the distance.
 $661E AND A         ; Reset the carry flag.
 $661F SBC HL,DE     ; #REGhl=#REGhl - #REGde.
 $6621 JR NC,$6659   ; If the result is not negative then jump to #R$6659.
 $6623 LD HL,$0000   ; #REGhl=#N($0000, $04, $04) (stop at zero).
 $6626 JR $6659      ; Jump to #R$6659.

; Reduce Car Y Position
;
; Used by the routine at #R$6633.
; .
; Continues #R$6633 when the car is moving towards lower Y positions.
; Takes the distance away from the Y position, stopping at zero.
;
; DE Y position of the car
; HL Distance to move
@label=ReduceCarY
c$6628 EX DE,HL      ; Swap #REGde and #REGhl so that #REGhl is the Y position and #REGde
                     ; is the distance.
 $6629 AND A         ; Reset the carry flag.
 $662A SBC HL,DE     ; #REGhl=#REGhl - #REGde.
 $662C JR NC,$6681   ; If the result is not negative then jump to #R$6681.
 $662E LD HL,$0000   ; #REGhl=#N($0000, $04, $04) (stop at zero).
 $6631 JR $6681      ; Jump to #R$6681.

; Handler: Car
;
; Moves and draws one of the two cars (the entities at #R$5E8C and
; #R$5E98), which chase the player. The car is drawn at its position relative to
; the player, but only when it is closer than #N$58 map units in both
; directions. It is then steered towards the player, bounces off objects, and
; destroys the player if it hits.
; #TABLE(default,centre,centre)
; { =h Byte | =h Contents }
; { #N$00 | State (#N$02), or the sprite ID while the car is being drawn }
; { #N$01 | X position on the screen }
; { #N$02 | Y position on the screen }
; { #N$03 | Colour (#N$00 or #N$02), or the attribute while the car is drawn }
; { #N$04-#N$05 | X position (twice the map position) }
; { #N$06-#N$07 | Y position (twice the map position) }
; { #N$08 | X speed (bit 7: moving to lower X; bits 0-4: speed) }
; { #N$09 | Y speed (bit 7: moving to lower Y; bits 0-4: speed) }
; { #N$0A | Flags (bit 0: car is drawn; bit 7: faster car) }
; { #N$0B | Sprite ID }
; TABLE#
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$5F07,stop=$5F29,clear=1,sp=$5E00)
; #SIM(start=$5FEF,stop=$6010,sp=$5E00)
; #SIM(start=$6010,stop=$6A87,sp=$5E00)
; #SCR$02,$08,$00,$18,$18(handler-car-before)
; | #POKES$5E90,$C0;$5E91,$18;$5E92,$B0;$5E93,$0C
; #SIM(start=$6009,stop=$6A87,sp=$5E00)
; #SCR$02,$08,$00,$18,$18(handler-car-after) } UDGTABLE# #POPS
;
; IX Car entity
;
; Draw the car using the sprite ID from the last frame.
@label=HandlerCar
c$6633 LD A,(IX+$0B)   ; Fetch the sprite ID of the car from the last frame.
 $6636 LD (IX+$00),A   ; Write #REGa to the first byte of the entity, as this is the sprite
                       ; ID that #R$71ED copies.
 $6639 CALL $71ED      ; Call #R$71ED to copy the position and sprite ID of the
                       ; entity.
; Move the car in the X direction. The distance moved is the X speed
; divided by #N$04, or by #N$02 for the faster car.
 $663C LD D,(IX+$05)   ; #REGd=high byte of the X position.
 $663F LD E,(IX+$04)   ; #REGe=low byte of the X position.
 $6642 LD A,(IX+$08)   ; Fetch the X speed of the car.
 $6645 BIT 7,(IX+$0A)  ; {If the car is the faster car (bit 7 of the flags is set) then jump
 $6649 JR NZ,$664C     ; to #R$664C.}
 $664B RRA             ; Halve the speed again, as this is not the faster car.
@label=HandlerCar_ScaleSpeedX
*$664C RRA             ; Halve the speed.
 $664D AND %00001111   ; Keep only bits 0-3 to give the distance to move.
 $664F LD L,A          ; {#REGhl=the distance to move.
 $6650 LD H,$00        ; }
 $6652 BIT 7,(IX+$08)  ; {If the car is moving towards lower X then jump to #R$661D to
 $6656 JR NZ,$661D     ; subtract the distance.}
 $6658 ADD HL,DE       ; Add the distance to the X position.
; This entry point is used by the routine at #R$661D.
@label=HandlerCar_StoreX
*$6659 LD (IX+$05),H   ; Store the high byte of the new X position.
 $665C LD (IX+$04),L   ; Store the low byte of the new X position.
 $665F SRL H           ; {Halve the X position (to match the scale of the
 $6661 RR L            ; player position).}
 $6663 PUSH HL         ; Stash the X position on the stack.
; Move the car in the Y direction in the same way.
 $6664 LD D,(IX+$07)   ; #REGd=high byte of the Y position.
 $6667 LD E,(IX+$06)   ; #REGe=low byte of the Y position.
 $666A LD A,(IX+$09)   ; #REGa=Y speed.
 $666D BIT 7,(IX+$0A)  ; {If bit 7 of the flags is set then jump to #R$6674.
 $6671 JR NZ,$6674     ; }
 $6673 RRA             ; Divide #REGa by two.
@label=HandlerCar_ScaleSpeedY
*$6674 RRA             ; Divide #REGa by two.
 $6675 AND %00001111   ; Keep only bits 0-3.
 $6677 LD L,A          ; {#REGhl=the distance to move.
 $6678 LD H,$00        ; }
 $667A BIT 7,(IX+$09)  ; {If the car is moving towards lower Y then jump to #R$6628 to
 $667E JR NZ,$6628     ; subtract the distance.}
 $6680 ADD HL,DE       ; Add the distance to the Y position.
; This entry point is used by the routine at #R$6628.
@label=HandlerCar_StoreY
*$6681 LD (IX+$07),H   ; Store the high byte of the new Y position.
 $6684 LD (IX+$06),L   ; Store the low byte of the new Y position.
 $6687 SRL H           ; {Halve the Y position (to match the scale of the
 $6689 RR L            ; player position).}
; Work out the distance between the car and the player, and which side of
; the player the car is on. This is kept in the shadow #REGaf register: bit 0 is
; set if the car is below the player and bit 1 is set if the car is to the left
; of the player.
 $668B LD DE,($5E08)   ; Fetch the player's Y position on the map (#R$5E08).
 $668F XOR A           ; {Reset the shadow #REGaf register.
 $6690 EX AF,AF'       ; }
 $6691 SBC HL,DE       ; Take the player's Y position away from the Y position
                       ; of the car.
 $6693 JR NC,$669C     ; If the car is not below the player then jump to
                       ; #R$669C.
 $6695 CALL $6BF6      ; Call #R$6BF6 to make the distance positive.
 $6698 EX AF,AF'       ; Switch to the shadow #REGaf register.
 $6699 LD A,$01        ; Set bit 0 by making #REGa #N$01, as the car is below
                       ; the player.
 $669B EX AF,AF'       ; Switch back to the normal #REGaf register.
; Do the same for the X direction.
@label=HandlerCar_DistanceX
*$669C EX (SP),HL      ; Swap the Y distance with the X position on the stack.
 $669D LD DE,($5E05)   ; Fetch the player's X position on the map (#R$5E05).
 $66A1 AND A           ; Reset the carry flag.
 $66A2 SBC HL,DE       ; Take the player's X position away from the X position
                       ; of the car.
 $66A4 JR NC,$66AD     ; If the car is not to the left of the player then jump
                       ; to #R$66AD.
 $66A6 CALL $6BF6      ; Call #R$6BF6 to make the distance positive.
 $66A9 EX AF,AF'       ; Switch to the shadow #REGaf register.
 $66AA OR %00000010    ; Set bit 1.
 $66AC EX AF,AF'       ; Switch back to the normal #REGaf register.
@label=HandlerCar_CheckVisible
*$66AD POP DE          ; Fetch the Y distance from the player.
 $66AE EX AF,AF'       ; Switch to the shadow #REGaf register.
 $66AF LD C,A          ; Keep the direction flags in #REGc.
; The car is only drawn when both distances are less than #N$58.
 $66B0 LD A,H          ; {Jump to #R$6741 if either distance is more than
 $66B1 OR D            ; #N$FF.
 $66B2 JP NZ,$6741     ; }
 $66B5 LD A,L          ; {Jump to #R$6741 if the X distance is #N$58 or more.
 $66B6 CP $58          ;
 $66B8 JP NC,$6741     ; }
 $66BB LD A,E          ; {Jump to #R$6741 if the Y distance is #N$58 or more.
 $66BC CP $58          ;
 $66BE JP NC,$6741     ; }
; Work out the position of the car on the screen. The player is at #N$98
; across and #N$68 down.
 $66C1 BIT 0,C         ; {If the car is below the player then jump to #R$66C7.
 $66C3 JR NZ,$66C7     ; }
 $66C5 NEG             ; Negate the Y distance, as the car is above the player.
@label=HandlerCar_AddPlayerY
*$66C7 ADD A,$68       ; Add #N$68 (the Y position of the player).
 $66C9 LD (IX+$02),A   ; Store the Y position of the car.
 $66CC BIT 1,C         ; Check if the car is to the left of the player.
 $66CE LD A,L          ; Fetch the X distance from the player.
 $66CF JR Z,$66D3      ; If the car is not to the left of the player then jump
                       ; to #R$66D3.
 $66D1 NEG             ; Negate the X distance, as the car is to the left of
                       ; the player.
@label=HandlerCar_AddPlayerX
*$66D3 ADD A,$98       ; Add #N$98 (the X position of the player).
 $66D5 LD (IX+$01),A   ; Store the X position of the car.
; Choose which of the #N$10 car sprites to use, so that the car points in
; the direction it is moving. The quadrant of travel comes from the direction
; bits (bit 7) of the two speeds, and the angle within it from #R$683B using the
; top three bits of each speed.
 $66D8 PUSH BC         ; Stash the direction flags on the stack.
 $66D9 LD A,(IX+$09)   ; {Fetch the Y speed and keep it in #REGe.
 $66DC LD E,A          ; }
 $66DD RLCA            ; Rotate #REGa left so that bit 0 is the direction bit
                       ; of the Y speed.
 $66DE LD C,(IX+$08)   ; {Fetch the X speed and keep it in #REGb.
 $66E1 LD B,C          ; }
 $66E2 RLC C           ; Rotate #REGc left so that bit 0 is the direction bit
                       ; of the X speed.
 $66E4 XOR C           ; Exclusive OR #REGa with #REGc.
 $66E5 AND %00000001   ; Keep only bit 0.
 $66E7 SLA C           ; Shift #REGc left so that bit 1 is the direction bit of
                       ; the X speed.
 $66E9 OR C            ; Combine the bits.
 $66EA AND %00000011   ; Keep only bits 0-1 (the quadrant).
 $66EC SLA A           ; {Multiply the quadrant by #N$04.
 $66EE SLA A           ; }
 $66F0 LD C,A          ; Keep the quadrant in #REGc.
 $66F1 LD A,B          ; Fetch the X speed.
 $66F2 RRA             ; {Divide the X speed by four.
 $66F3 RRA             ; }
 $66F4 AND %00000111   ; Keep only bits 0-2.
 $66F6 LD B,A          ; Keep the X speed bits in #REGb.
 $66F7 LD A,E          ; Fetch the Y speed.
 $66F8 RLA             ; Rotate #REGa left.
 $66F9 AND %00111000   ; Keep only bits 3-5.
 $66FB OR B            ; Combine with the X speed bits.
 $66FC LD E,A          ; #REGe=the index into the table.
 $66FD LD D,$00        ; #REGd=#N$00.
 $66FF LD HL,$683B     ; Point #REGhl at the table of angles (#R$683B).
 $6702 ADD HL,DE       ; Add the index to the start of the table.
 $6703 LD A,(HL)       ; Fetch the angle from the table.
 $6704 CP $FF          ; Compare the angle with #N$FF.
 $6706 JR Z,$671D      ; If the car has no speed then keep the same sprite and jump to
                       ; #R$671D.
 $6708 BIT 2,C         ; {Jump to #R$6712 if the quadrant is not odd.
 $670A JR Z,$6712      ; }
 $670C NEG             ; Negate the angle.
 $670E INC C           ; {Add #N$04 to #REGc.
 $670F INC C           ;
 $6710 INC C           ;
 $6711 INC C           ; }
@label=HandlerCar_SetSprite
*$6712 ADD A,C         ; Add the quadrant.
 $6713 AND %00001111   ; Keep only bits 0-3.
 $6715 ADD A,$10       ; Add #N$10 to get the sprite ID.
 $6717 LD (IX+$0B),A   ; Store the sprite ID.
 $671A LD (IX+$00),A   ; Write the sprite ID to the first byte of the entity, as this is the
                       ; sprite ID that #R$7101 draws.
; Set the colour of the car, which depends on whether it is day or night,
; then draw it.
@label=HandlerCar_Colour
*$671D LD C,(IX+$03)   ; Fetch the colour of the car.
 $6720 LD A,($5E43)    ; Fetch the day/night flag (#R$5E43).
 $6723 PUSH BC         ; Stash #REGbc on the stack.
 $6724 LD B,$00        ; Clear the high byte of the table index.
 $6726 ADD A,C         ; Add the colour to the day/night flag.
 $6727 LD C,A          ; Keep the index into the table of car attributes in
                       ; #REGc.
 $6728 LD HL,$6837     ; Point #REGhl at the table of car attributes (#R$6837).
 $672B ADD HL,BC       ; Add the index to the start of the table.
 $672C LD A,(HL)       ; Fetch the attribute of the car.
 $672D LD (IX+$03),A   ; Write the attribute to the colour byte of the entity.
 $6730 CALL $7101      ; Call #R$7101 to erase the old car and draw the new
                       ; one.
 $6733 CALL $704B      ; Call #R$704B to set the attributes of the car.
 $6736 POP BC          ; Restore #REGbc from the stack.
 $6737 LD (IX+$03),C   ; Put the colour back in the entity.
 $673A POP BC          ; Restore the direction flags from the stack.
 $673B SET 0,(IX+$0A)  ; Set bit 0 of the flags (the car is drawn).
 $673F JR $6750        ; Jump to #R$6750.
; The car is too far away to be seen. If it was drawn then erase it.
@label=HandlerCar_TooFar
*$6741 BIT 0,(IX+$0A)  ; {If the car has not been drawn then jump to #R$6750.
 $6745 JR Z,$6750      ; }
 $6747 RES 0,(IX+$0A)  ; Reset bit 0 of the flags (the car is no longer drawn).
 $674B PUSH BC         ; Stash the direction flags on the stack.
 $674C CALL $7139      ; Call #R$7139 to erase the car.
 $674F POP BC          ; Restore the direction flags from the stack.
; Steer the car towards the player, starting with the X speed.
@label=HandlerCar_SteerX
*$6750 BIT 1,C         ; Check if the car is to the left of the player.
 $6752 LD A,(IX+$08)   ; Fetch the X speed.
 $6755 JR NZ,$6799     ; If the car is to the left of the player then jump to
                       ; #R$6799.
; The car is to the right of the player, so it wants to move towards lower
; X.
 $6757 BIT 7,A         ; {If the car is moving towards higher X then jump to #R$6786 to slow
 $6759 JR Z,$6786      ; it down.}
 $675B AND %00011111   ; Keep only bits 0-4 (the speed).
@label=HandlerCar_SpeedUpX
*$675D BIT 7,(IX+$0A)  ; {If it is the faster car then jump to #R$6791.
 $6761 JR NZ,$6791     ; }
 $6763 CP $1F          ; Compare the speed with the limit of #N$1F.
@label=HandlerCar_CheckLimitX
*$6765 JR NC,$676A     ; If the speed is at the limit then jump to #R$676A.
 $6767 INC (IX+$08)    ; Increase the X speed by one.
; Do the same for the Y speed.
@label=HandlerCar_SteerY
*$676A BIT 0,C         ; Check if the car is below the player.
 $676C LD A,(IX+$09)   ; Fetch the Y speed.
 $676F JR NZ,$67B2     ; If it is then jump to #R$67B2.
; The car is above the player, so it wants to move towards lower Y.
 $6771 BIT 7,A         ; {If the car is moving towards higher Y then jump to #R$67A7 to slow
 $6773 JR Z,$67A7      ; it down.}
 $6775 AND %00011111   ; Keep only bits 0-4 (the speed).
@label=HandlerCar_SpeedUpY
*$6777 BIT 7,(IX+$0A)  ; {If it is the faster car then jump to #R$6795.
 $677B JR NZ,$6795     ; }
 $677D CP $1F          ; Compare the speed with the limit of #N$1F.
@label=HandlerCar_CheckLimitY
*$677F JR NC,$67BE     ; If the speed is at the limit then jump to #R$67BE.
 $6781 INC (IX+$09)    ; Increase the Y speed by one.
 $6784 JR $67BE        ; Jump to #R$67BE.
; Slow the car down. When it stops, the direction bit is set so that the
; car speeds up in the opposite direction.
@label=HandlerCar_SlowDownX
*$6786 DEC (IX+$08)    ; Decrease the X speed by one.
 $6789 JR NZ,$676A     ; If the speed is not zero then jump to #R$676A.
 $678B SET 7,(IX+$08)  ; Set bit 7 of the X speed.
 $678F JR $676A        ; Jump to #R$676A.
; The limit on the speed of the faster car is lower.
@label=HandlerCar_LimitX
*$6791 CP $15          ; Compare the speed with the limit of #N$15.
 $6793 JR $6765        ; Jump to #R$6765.
@label=HandlerCar_LimitY
*$6795 CP $15          ; Compare the speed with the limit of #N$15.
 $6797 JR $677F        ; Jump to #R$677F.
; The car is to the left of the player, so it wants to move towards higher
; X.
@label=HandlerCar_SteerLeft
*$6799 BIT 7,A         ; {If the car is moving towards higher X then jump to #R$675D to speed
 $679B JR Z,$675D      ; it up.}
 $679D AND %00011111   ; Keep only bits 0-4 (the speed).
 $679F JR NZ,$6786     ; If the car is still moving then jump to #R$6786 to
                       ; slow it down.
 $67A1 LD (IX+$08),$00 ; Set the X speed to zero.
 $67A5 JR $676A        ; Jump to #R$676A.
@label=HandlerCar_SlowDownY
*$67A7 DEC (IX+$09)    ; Decrease the Y speed by one.
 $67AA JR NZ,$67BE     ; If the speed is not zero then jump to #R$67BE.
 $67AC SET 7,(IX+$09)  ; Set bit 7 of the Y speed.
 $67B0 JR $67BE        ; Jump to #R$67BE.
; The car is below the player, so it wants to move towards higher Y.
@label=HandlerCar_SteerBelow
*$67B2 BIT 7,A         ; {If the car is moving towards higher Y then jump to #R$6777 to speed
 $67B4 JR Z,$6777      ; it up.}
 $67B6 AND %00011111   ; Keep only bits 0-4 (the speed).
 $67B8 JR NZ,$67A7     ; If the car is still moving then jump to #R$67A7 to
                       ; slow it down.
 $67BA LD (IX+$09),$00 ; Set the Y speed to zero.
; Put the state back, then check whether the car has hit an object.
@label=HandlerCar_Collisions
*$67BE LD (IX+$00),$02 ; Write #N$02 (the car state) to the first byte of the
                       ; entity.
 $67C2 BIT 0,(IX+$0A)  ; {Return if the car is not drawn.
 $67C6 RET Z           ; }
 $67C7 LD HL,$5E50     ; Point #REGhl at the first object (#R$5E50).
 $67CA LD B,$07        ; Set the object counter to #N$07.
@label=HandlerCar_ObjectLoop
*$67CC BIT 6,(HL)      ; {If bit 6 of the object (a place name or collected cup) is set then
 $67CE JR NZ,$6807     ; jump to #R$6807 to skip it.}
 $67D0 INC HL          ; Move on to the X position of the object.
 $67D1 LD A,(HL)       ; Fetch the X position of the object.
 $67D2 SUB (IX+$01)    ; Take the X position of the car away to give the
                       ; distance.
 $67D5 JP P,$67DA      ; If the result is positive then jump to #R$67DA.
 $67D8 NEG             ; Negate #REGa.
@label=HandlerCar_CheckDistanceX
*$67DA CP $0A          ; {If the object is #N$0A or more pixels away then jump
 $67DC JR NC,$6808     ; to #R$6808.}
 $67DE INC HL          ; Move on to the Y position of the object.
 $67DF LD A,(HL)       ; Fetch the Y position of the object.
 $67E0 SUB (IX+$02)    ; Take the Y position of the car away to give the
                       ; distance.
 $67E3 JP P,$67E8      ; If the result is positive then jump to #R$67E8.
 $67E6 NEG             ; Negate #REGa.
@label=HandlerCar_CheckDistanceY
*$67E8 CP $0A          ; {If the object is #N$0A or more pixels away then jump
 $67EA JR NC,$6809     ; to #R$6809.}
; The car has hit the object. Bounce off it, turning the car around in the
; X direction and changing the Y speed by a random amount.
 $67EC LD A,R          ; Fetch a random number (from the Z80 refresh register).
 $67EE AND %00001111   ; Keep only bits 0-3.
 $67F0 OR %10000000    ; Set bit 7.
 $67F2 LD B,A          ; Keep the random change in #REGb.
 $67F3 LD A,(IX+$09)   ; Fetch the Y speed.
 $67F6 XOR B           ; Change the Y speed by the random number.
 $67F7 LD (IX+$09),A   ; Store the Y speed.
 $67FA LD A,(IX+$08)   ; Fetch the X speed.
 $67FD XOR %10000000   ; Flip bit 7 to turn the car around in the X direction.
 $67FF LD (IX+$08),A   ; Store the X speed.
 $6802 CALL $6106      ; Call #R$6106 to play a noise.
 $6805 JR $681A        ; Jump to #R$681A.
; Move on to the next object.
@label=HandlerCar_NextObject
*$6807 INC HL          ; Move on to the X position of the object.
@label=HandlerCar_NextObject_FromX
*$6808 INC HL          ; Move on to the Y position of the object.
@label=HandlerCar_NextObject_FromY
*$6809 INC HL          ; Move on to the next object.
 $680A DJNZ $67CC      ; Decrease the object counter by one and loop back to #R$67CC until
                       ; all #N$07 objects have been checked.
; The car has not hit anything. There is a small chance of the X speed
; being changed.
 $680C LD A,R          ; Fetch a random number (from the Z80 refresh register).
 $680E AND %01111111   ; Keep only bits 0-6.
 $6810 JR NZ,$681A     ; If it is not zero (which is most of the time) then
                       ; jump to #R$681A.
 $6812 LD A,(IX+$08)   ; Fetch the X speed.
 $6815 XOR %00001111   ; Flip bits 0-3 to change the X speed.
 $6817 LD (IX+$08),A   ; Store the X speed.
; Check if the car has hit the player, which is when the car is less than
; #N$0C pixels away in both directions.
@label=HandlerCar_PlayerCollision
*$681A LD A,(IX+$01)   ; Fetch the X position of the car.
 $681D SUB $98         ; #REGa=#REGa - #N$98 (the X position of the player).
 $681F JP P,$6824      ; If the result is positive then jump to #R$6824.
 $6822 NEG             ; Negate #REGa.
@label=HandlerCar_PlayerDistanceX
*$6824 CP $0C          ; Compare the distance with #N$0C.
; See #POKE(immune_to_cars,Immune To Cars).
 $6826 RET NC          ; Return if the car is #N$0C or more pixels away.
 $6827 LD A,(IX+$02)   ; Fetch the Y position of the car.
 $682A SUB $68         ; #REGa=#REGa - #N$68 (the Y position of the player).
 $682C JP P,$6831      ; If the result is positive then jump to #R$6831.
 $682F NEG             ; Negate #REGa.
@label=HandlerCar_PlayerDistanceY
*$6831 CP $0C          ; Compare the distance with #N$0C.
 $6833 RET NC          ; Return if the car is #N$0C or more pixels away.
 $6834 JP $703E        ; Jump to #R$703E to destroy the player.

; Car Attributes
;
; The attribute for each colour of car. There is one pair of bytes for
; each colour (#N$00 and #N$02), the first byte of which is used in the day and
; the second at night.
@label=CarAttributes
b$6837 DEFB $71,$44
 $6839 DEFB $70,$43

; Car Direction Table
;
; The angle of travel of a car, which is #N$00 when moving vertically and
; #N$04 when moving horizontally. Each row is for a different value of bits 2-4
; of the Y speed and each column is for a different value of bits 2-4 of the X
; speed. The first entry is #N$FF as the car is not moving.
@label=CarDirectionTable
b$683B DEFB $FF,$04,$04,$04,$04,$04,$04,$04
 $6843 DEFB $00,$02,$03,$03,$03,$03,$04,$04
 $684B DEFB $00,$01,$02,$02,$03,$03,$03,$03
 $6853 DEFB $00,$01,$01,$02,$02,$03,$03,$03
 $685B DEFB $00,$01,$01,$02,$02,$02,$02,$03
 $6863 DEFB $00,$01,$01,$01,$02,$02,$02,$02
 $686B DEFB $00,$00,$01,$01,$01,$02,$02,$02
 $6873 DEFB $00,$00,$01,$01,$01,$02,$02,$02

; Display Lives
;
; Used by the routine at #R$68A0.
; .
; Draws one car icon in the bottom row of the sidebar for each life
; remaining in #R$5E3D.
;
; .
;
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$5F07,stop=$5F29,clear=1,sp=$5E00)
; #SIM(start=$5FEF,stop=$68C7,sp=$5E00)
; #SCR$03,$00,$15,$08,$03(display-lives-before)
; | #SIM(start=$68C7,stop=$68CA)
; #SCR$03,$00,$15,$08,$03(display-lives-after) } UDGTABLE# #POPS
@label=DisplayPlayerLives
c$687B LD A,($5E3D)  ; {Return if there are no lives left (#R$5E3D).
 $687E AND A         ;
 $687F RET Z         ; }
 $6880 LD B,A        ; Set the lives counter to the number of lives (#R$5E3D).
 $6881 LD HL,$BC08   ; #REGhl=#N$BC08 (pixel co-ordinates: #REGh is the Y position and
                     ; #REGl is the X position of the first car).
 $6884 XOR A         ; {Write #N$00 to #R$5E41.
 $6885 LD ($5E41),A  ; }
@label=DisplayPlayerLives_Loop
*$6888 LD DE,$7CD6   ; Point #REGde at the car sprite (#R$7CD6).
 $688B CALL $6891    ; Print a car using #R$6891.
 $688E DJNZ $6888    ; Decrease the lives counter by one and loop back to #R$6888 until a
                     ; car has been shown for every life.
 $6890 RET           ; Return.
; Print the player sprite.
@label=DisplayPlayerLives_Print
*$6891 PUSH BC       ; {Stash the lives counter and the pixel co-ordinates on
 $6892 PUSH HL       ; the stack.}
 $6893 CALL $70DB    ; Call #R$70DB to set up the sprite at the co-ordinates in
                     ; #REGhl.
 $6896 CALL $714C    ; Call #R$714C to draw the sprite.
 $6899 POP HL        ; {Restore the pixel co-ordinates and the lives counter
 $689A POP BC        ; from the stack.}
; Move onto the next life "slot".
 $689B LD A,L        ; {Add #N$10 to the X position, ready for the next car.
 $689C ADD A,$10     ;
 $689E LD L,A        ; }
 $689F RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$A2CE }
; { #COOKIE$7378 }
; { #JETPAC$70A4 }
; { #LUNARJETMAN$894F }
; { #PSSST$7325 }
; LIST#

; Create Game Window
;
; Used by the routines at #R$5F07, #R$6353, #R$6391 and #R$63FF.
; .
; Builds the game screen from scratch. The screen and attribute buffers
; are cleared, then the sidebar, the map, the cup count, the lives, the score
; headings and the border of the play area are drawn.
;
; .
;
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$5F07,stop=$68A0,clear=1,sp=$5E00)
; #SCR$01(create-window-before)
; | #SIM(start=$68A0,stop=$5F29)
; #SCR$01(create-window-after) } UDGTABLE# #POPS
@label=CreateWindow
c$68A0 LD HL,$5E68   ; Point #REGhl at the radar blip records (#R$5E68).
 $68A3 LD BC,$0C00   ; #REGbc=#N($0C00, $04, $04) (#REGb is the counter for the #N$0C
                     ; bytes and #REGc is #N$00).
@label=CreateWindow_ClearBlips
*$68A6 LD (HL),C     ; Clear a byte of the radar blip records.
 $68A7 INC HL        ; Increment #REGhl by one.
 $68A8 DJNZ $68A6    ; Decrease the byte counter by one and loop back to #R$68A6 until all
                     ; #N$0C bytes have been cleared.
 $68AA LD HL,$FFFF   ; {Write #N$FFFF to #R$5E34 (so the terrain dots are drawn
 $68AD LD ($5E34),HL ; afresh).}
 $68B0 LD HL,$65FD   ; Point #REGhl at the first terrain dot (#R$65FD).
 $68B3 LD B,$10      ; Set the dot counter to #N$10.
@label=CreateWindow_Terrain
*$68B5 RES 0,(HL)    ; Reset bit 0 of the byte #REGhl is pointing to (the dot is not
                     ; drawn).
 $68B7 INC HL        ; {Move on to the next terrain dot.
 $68B8 INC HL        ; }
 $68B9 DJNZ $68B5    ; Decrease the dot counter by one and loop back to #R$68B5 until all
                     ; #N$10 dots are marked as not drawn.
 $68BB CALL $7200    ; Call #R$7200 to reset the attribute buffer.
 $68BE CALL $69BC    ; Call #R$69BC to draw the sidebar.
 $68C1 CALL $6949    ; Call #R$6949 to plot the map points.
 $68C4 CALL $646C    ; Call #R$646C to display the cups collected.
 $68C7 CALL $687B    ; Call #R$687B to display the lives.
 $68CA CALL $6CDE    ; Call #R$6CDE to display the miles and time.
; Draw the border of the play area, by setting a row of attributes along
; the top and bottom and a column along each side.
 $68CD LD HL,$5808   ; #REGhl=#N$5808 (the attribute address of the top left).
 $68D0 LD BC,$1801   ; #REGbc=#N($1801, $04, $04) (#N$18 across and #N$01
                     ; down).
 $68D3 PUSH BC       ; Stash #REGbc on the stack.
 $68D4 CALL $6900    ; Set the attributes of the top row using #R$6900.
 $68D7 LD HL,$5AE8   ; #REGhl=#N$5AE8 (the attribute address of the bottom
                     ; left).
 $68DA POP BC        ; Restore #REGbc from the stack.
 $68DB CALL $6900    ; Set the attributes of the bottom row using #R$6900.
 $68DE LD HL,$5828   ; #REGhl=#N$5828 (the attribute address of the left side).
 $68E1 LD BC,$0116   ; #REGbc=#N($0116, $04, $04) (#N$01 across and #N$16
                     ; down).
 $68E4 PUSH BC       ; Stash #REGbc on the stack.
 $68E5 CALL $6900    ; Stash the size of the side on the stack.
 $68E8 POP BC        ; Restore #REGbc from the stack.
 $68E9 LD HL,$583F   ; #REGhl=#N$583F (the attribute address of the right
                     ; side).
 $68EC CALL $6900    ; Set the attributes of the right side using #R$6900.
; Print the "SCORE" and "HI-SCORE" headings and the scores.
 $68EF LD HL,$0050   ; #REGhl=#N($0050, $04, $04) (pixel co-ordinates: #REGh is the Y
                     ; position and #REGl is the X position).
 $68F2 LD DE,$6031   ; Point #REGde at the "SCORE" and "HI-SCORE" headings
                     ; (#R$6031).
 $68F5 CALL $6518    ; Print the headings using #R$6518.
 $68F8 CALL $6CB6    ; Call #R$6CB6 to print the score.
 $68FB CALL $6CBE    ; Call #R$6CBE to print the high score.
 $68FE JR $6919      ; Jump to #R$6919.
; View the equivalent code in;
; #LIST
; { #JETPAC$608A }
; { #LUNARJETMAN$84D8 }
; LIST#

; Set PlayArea Attributes
;
; Used by the routine at #R$68A0.
; .
; Fills a block of the attribute buffer with #N$76 (#COLOUR$76), which
; forms part of the border of the play area.
;
; B Width of the block (in cells)
; C Height of the block (in rows)
; HL Attribute address of the top left of the block
@label=AttributesPlayArea
c$6900 LD E,B        ; Keep the width of the block in #REGe.
@label=AttributesPlayArea_Row
*$6901 LD B,E        ; Set the cell counter to the width of the block.
 $6902 PUSH HL       ; Stash the address of the start of the row on the stack.
@label=AttributesPlayArea_Column
*$6903 LD (HL),$76   ; Set the attribute of the cell to #N$76.
 $6905 INC HL        ; Increment #REGhl by one.
 $6906 DJNZ $6903    ; Decrease the cell counter by one and loop back to #R$6903 until the
                     ; row is done.
 $6908 POP HL        ; Restore the address of the start of the row from the
                     ; stack.
 $6909 CALL $6910    ; Call #R$6910 to move down a row.
 $690C DEC C         ; Decrease the row counter by one.
 $690D JR NZ,$6901   ; Jump back to #R$6901 until all of the rows have been
                     ; done.
 $690F RET           ; Return.

; Move Down One Row
;
; Used by the routines at #R$6900 and #R$69BC.
; .
; Adds #N$20 to an address, which moves it down by one character row in
; the attribute buffer or the screen buffer (for as long as it stays within the
; same third of the screen).
;
;   HL Current address
; O:HL Address one row down
@label=MoveDownOneRow
c$6910 LD A,L        ; {#REGl=#REGl + #N$20 (one row).
 $6911 ADD A,$20     ;
 $6913 LD L,A        ; }
 $6914 LD A,H        ; {#REGh=#REGh + #N$00 (but include the carry from above).
 $6915 ADC A,$00     ;
 $6917 LD H,A        ; }
 $6918 RET           ; Return.

; Display Night Driver Text
;
; Used by the routine at #R$68A0.
; .
; If it is night, shows "NIGHT DRIVER" for a short time and then removes
; it again.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$5F07,stop=$5F29,clear=1,sp=$5E00)
; #SIM(start=$617F,stop=$617E)
; #SIM(start=$5F26,stop=$6919)
; #SCR$03,$08,$06,$18,$05(night-driver-before)
; | #SIM(start=$6919,stop=$6927)
; #SCR$03,$08,$06,$18,$05(night-driver-after) } UDGTABLE# #POPS
@label=DisplayNightDriver
c$6919 LD A,($5E43)  ; {Return if #R$5E43 is zero (i.e. it is "day").
 $691C AND A         ;
 $691D RET Z         ; }
; Else it is night so handle the interlude to display "Night Driver".
 $691E LD HL,$4070   ; #REGhl=#N$4070 (pixel co-ordinates: #REGh is the Y position and
                     ; #REGl is the X position).
 $6921 LD DE,$693C   ; Point #REGde at the "NIGHT DRIVER" text (#R$693C).
 $6924 CALL $6518    ; Print the text using #R$6518.
; Display the text for a short time.
 $6927 LD B,$04      ; Set the delay count to #N$04.
 $6929 CALL $6386    ; Wait using #R$6386.
; Remove the messaging.
 $692C LD HL,$4070   ; #REGhl=#N$4070 (pixel co-ordinates: #REGh is the Y position and
                     ; #REGl is the X position).
 $692F PUSH HL       ; Stash the pixel co-ordinates on the stack.
 $6930 CALL $6F10    ; Convert them to a screen address using #R$6F10.
 $6933 LD A,$00      ; Set the attribute to #N$00, which hides the text.
 $6935 EX AF,AF'     ; Keep the attribute in the shadow #REGaf register.
 $6936 LD DE,$6AE5   ; Point #REGde at the blank text (#R$6AE5).
 $6939 JP $651F      ; Jump to #R$651F to print the blank text.

; Messaging: Night Driver
;
; The attribute byte, followed by the text. The last character has bit 7
; set.
@label=NightDriver_Text
t$693C DEFM $47                   ; {"NIGHT DRIVER" (#COLOUR(#PEEK(#PC)) is the
 $693D DEFM "NIGHT DRIVE","R"+$80 ; attribute).}

; Plot Map Points
;
; Used by the routine at #R$68A0.
; .
; Plots a dot on the map in the sidebar for every entry in the map points
; table at #R$7811, except place names and collected cups (which are marked with
; #N$60). One pixel on the map is #N$80 map units.
;
; .
;
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$5F07,stop=$68C1,clear=1,sp=$5E00)
; #SCR$03,$00,$05,$08,$05(plot-map-before)
; | #SIM(start=$68C1,stop=$68C4)
; #SCR$03,$00,$05,$08,$05(plot-map-after) } UDGTABLE# #POPS
@label=PlotMapPoints
c$6949 LD BC,$7811   ; Point #REGbc at the map points (#R$7811).
@label=PlotMapPoints_Loop
*$694C LD HL,$4708   ; #REGhl=#N$4708 (pixel co-ordinates of the bottom left of the map:
                     ; #REGh is the Y position and #REGl is the X position).
; Handle the X co-ordinate.
 $694F LD A,(BC)     ; Fetch the X position of the map point.
 $6950 INC BC        ; Increment the map pointer in #REGbc by one.
; Scale the X co-ordinate for the smaller map display output.
 $6951 SRL A         ; {Divide the X position by #N$04 to scale it for the map.
 $6953 SRL A         ; }
 $6955 LD E,A        ; Keep the scaled X position in #REGe.
; Handle the Y co-ordinate.
 $6956 LD A,(BC)     ; Fetch the Y position of the map point.
 $6957 INC BC        ; Increment the map pointer in #REGbc by one.
; Scale the Y co-ordinate for the smaller map display output.
 $6958 SRL A         ; {Divide the Y position by #N$08 to scale it for the map.
 $695A SRL A         ;
 $695C SRL A         ; }
 $695E LD D,A        ; Keep the scaled Y position in #REGd.
; Calculate the pixel co-ordinates of our currently processed map point.
 $695F LD A,H        ; {Take the scaled Y position away from the Y pixel position, as the
 $6960 SUB D         ; map counts up from the bottom.
 $6961 LD H,A        ; }
 $6962 LD A,L        ; {Add the scaled X position to the X pixel position.
 $6963 ADD A,E       ;
 $6964 LD L,A        ; }
; Handle the map point "type" - place names are excluded.
 $6965 LD A,(BC)     ; Fetch the sprite ID of the map point.
 $6966 INC BC        ; Increment the map pointer in #REGbc by one. Now pointing to the next
                     ; record.
 $6967 PUSH BC       ; Stash the pointer to the next map point on the stack.
 $6968 LD BC,$0101   ; #REGbc=#N($0101, $04, $04) (a single pixel, used in
                     ; #R$6998).
; Skip place names - they don't show a marker on the map.
 $696B BIT 6,A       ; {If bit 6 is set then this is a place name so skip and jump to
 $696D JR Z,$6976    ; #R$6976.}
 $696F CP $60        ; {If #REGa is #N$60 (a collected cup), jump to #R$6976.
 $6971 JR Z,$6976    ; }
 $6973 CALL $6998    ; Plot the point using #R$6998.
; Check if finished. The stack contains the start of the next record, or
; the first byte past the end of the map points.
@label=PlotMapPoints_Continue
*$6976 POP BC        ; Restore the pointer to the next map point from the
                     ; stack.
 $6977 LD HL,$7CD6   ; Point #REGhl at the end of the map points (#R$7CD6, one byte past
                     ; the end of #R$7811).
 $697A AND A         ; Reset the carry flag.
 $697B SBC HL,BC     ; Compare the map pointer with the end of the map points.
 $697D JR NZ,$694C   ; If the end of the map points has not been reached then jump to
                     ; #R$694C.
 $697F RET           ; Return.

; Handler: Terrain Dots
;
; Used by the routine at #R$65B1.
; .
; Erases a terrain dot from where it was drawn. The position is worked out
; from the player position that was saved in #R$5E34 when the dots were last
; updated.
;
; IX One of the #N$10 #R$65FD entities
@label=HandlerTerrainDots
c$6980 RES 0,(IX+$00) ; Reset bit 0 of the given Terrain Dot entity (it is no
                      ; longer drawn).
 $6984 LD HL,($5E34)  ; Fetch the player position used last time (#R$5E34).
 $6987 LD A,L         ; {#REGl=player X - terrain dot X.
 $6988 SUB (IX+$00)   ;
 $698B LD L,A         ; }
 $698C LD A,H         ; {#REGh=player Y - terrain dot Y.
 $698D SUB (IX+$01)   ;
 $6990 LD H,A         ; }

; Clear Pixels
;
; Used by the routines at #R$625C and #R$6557.
; .
; Clears a block of pixels. Writes the opcode operand for #N$86 (which
; makes #R$69AE reset a bit) to #R$69A6(#N$69A7), then continues at #R$699D.
;
; B Height of the block in pixels
; C Width of the block in pixels
; HL Pixel co-ordinates of the bottom left of the block (#REGh is the Y
; .  position and #REGl is the X position)
@label=ClearPixels
c$6991 LD A,$86      ; {Write #N$86 to #R$69A6(#N$69A7).
 $6993 LD ($69A7),A  ; }
 $6996 JR $699D      ; Jump to #R$699D.

; Set Pixels
;
; Used by the routines at #R$625C, #R$6557, #R$65B1 and #R$6949.
; .
; Sets a block of pixels. Writes the opcode operand for #N$C6 (which makes
; #R$69AE set a bit) to #R$69A6(#N$69A7), then continues at #R$699D.
;
; B Height of the block in pixels
; C Width of the block in pixels
; HL Pixel co-ordinates of the bottom left of the block (#REGh is the Y
; .  position and #REGl is the X position)
@label=SetPixels
c$6998 LD A,$C6      ; {Write #N$C6 to #R$69A6(#N$69A7).
 $699A LD ($69A7),A  ; }

; Plot Pixels
;
; Used by the routine at #R$6991.
; .
; Sets or clears a block of pixels, going up from the bottom row and
; across from the left column. Which of the two depends on the operands that
; have been written by #R$6991 or #R$6998.
;
; B Height of the block in pixels
; C Width of the block in pixels
; HL Pixel co-ordinates of the bottom left of the block (#REGh is the Y
; .  position and #REGl is the X position)
@label=PlotPixels
c$699D PUSH BC       ; {Stash #REGbc and #REGhl on the stack.
 $699E PUSH HL       ; }
 $699F LD A,L        ; #REGa=#REGl.
 $69A0 CPL           ; Flip the bits.
 $69A1 RLCA          ; {#REGa=#REGa * #N$08.
 $69A2 RLCA          ;
 $69A3 RLCA          ; }
 $69A4 AND %00111000 ; Keep only bits 3-5.
; #TABLE(default,centre,centre)
; { =h,c3 Self modifying code }
; { =h Altered From | =h Bytes | =h bits |  }
; { #R$6991 | #N$86 | #EVAL($86, $02) }
; { #R$6998 | #N$C6 | #EVAL($C6, $02) }
; TABLE#
 $69A6 OR %11000110  ; Set bits 1-2, 6-7 (this operand is modified).
 $69A8 LD ($69AF),A  ; Store #REGa as the opcode of the instruction at
                     ; #R$69AE(#N$69AF).
 $69AB CALL $6F10    ; Call #R$6F10.
@label=PlotPixels_Column
*$69AE SET 0,(HL)    ; Set (or reset) the bit of the byte at #REGhl for this
                     ; pixel.
 $69B0 CALL $6ECB    ; Call #R$6ECB to move up one pixel.
 $69B3 DJNZ $69AE    ; Decrease the height counter by one and loop back to #R$69AE until
                     ; the whole column has been set (or cleared).
 $69B5 POP HL        ; {Restore #REGhl and #REGbc from the stack.
 $69B6 POP BC        ; }
 $69B7 INC L         ; Move on to the next pixel column.
 $69B8 DEC C         ; {Decrease the width counter by one and loop back to #R$699D until all
 $69B9 JR NZ,$699D   ; of the columns have been done.}
 $69BB RET           ; Return.

; Draw HUD Panel
;
; Used by the routine at #R$68A0.
; .
; Draws the sidebar (the leftmost #N$08 columns of the screen) from the
; tile layout at #R$7691 and the attributes at #R$7751. Each tile is printed
; with #R$6C96 while the character set pointer refers to the tiles at #R$74B1.
;
; .
;
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$5F07,stop=$68BE,clear=1,sp=$5E00)
; #SCR$02,$00,$00,$08,$18(draw-sidebar-before)
; | #SIM(start=$68BE,stop=$68C1)
; #SCR$02,$00,$00,$08,$18(draw-sidebar-after) } UDGTABLE# #POPS
@label=DrawHUDPanel
c$69BC LD HL,($5C36) ; {Stash #SKOOLKID$5C36(CHARS) on the stack.
 $69BF PUSH HL       ; }
 $69C0 LD HL,$74B1   ; {Write #R$74B1 to #SKOOLKID$5C36(CHARS).
 $69C3 LD ($5C36),HL ; }
 $69C6 LD HL,$7691   ; Point #REGhl at the tile layout of the sidebar
                     ; (#R$7691).
 $69C9 LD DE,$7751   ; Point #REGde at the attributes of the sidebar (#R$7751).
 $69CC EXX           ; Switch to the shadow registers.
 $69CD LD HL,$4000   ; Point #REGhl' at the screen buffer (#N$4000).
 $69D0 LD DE,$5800   ; Point #REGde' at the attribute buffer (#N$5800).
 $69D3 LD C,$18      ; Set the row counter to #N$18, the height of the sidebar.
 $69D5 LD A,$08      ; {Write #N$08 (width of the sidebar) to #R$5E2C.
 $69D7 LD ($5E2C),A  ; }
@label=DrawHUDPanel_Loop
*$69DA LD A,($5E2C)  ; {Set the tile counter to the width of the sidebar
 $69DD LD B,A        ; (#R$5E2C).}
 $69DE PUSH HL       ; {Stash the buffer addresses of the start of this row on
 $69DF PUSH DE       ; the stack.}
@label=DrawHUDPanel_LineLoop
*$69E0 EXX           ; Switch back to the normal registers.
 $69E1 LD A,(HL)     ; Fetch the tile from the sidebar layout.
 $69E2 INC HL        ; Move on to the next tile.
 $69E3 EXX           ; Switch to the shadow registers.
; Now using the screen data held by the shadow registers.
 $69E4 CALL $6C96    ; Print the tile using #R$6C96.
 $69E7 EXX           ; Switch back to the normal registers.
 $69E8 LD A,(DE)     ; Fetch the attribute of the tile from the sidebar
                     ; attributes.
 $69E9 INC DE        ; Move on to the next attribute.
 $69EA EXX           ; Switch to the shadow registers.
 $69EB LD (DE),A     ; Write the sidebar attribute data to the attribute
                     ; buffer.
 $69EC INC DE        ; Increment the attribute buffer pointer by one.
 $69ED DJNZ $69E0    ; Decrease the tile counter by one and loop back to #R$69E0 until the
                     ; whole row has been drawn.
; Restore the attribute buffer address for the start of this line.
 $69EF POP HL        ; Restore #REGhl' from the stack.
 $69F0 CALL $6910    ; Call #R$6910 to move down a row.
 $69F3 EX DE,HL      ; Exchange #REGde' and #REGhl' so that #REGde' holds the attribute
                     ; address for the next row (#REGhl' is overwritten below).
; Restore the screen buffer address for the start of this line.
 $69F4 POP HL        ; Restore #REGhl' from the stack.
 $69F5 CALL $6910    ; Call #R$6910 to move down a row.
; Account for the Spectrum screen layout in memory.
 $69F8 LD A,L        ; Fetch the low byte of the screen buffer address.
 $69F9 AND %11100000 ; Keep only bits 5-7.
 $69FB JR NZ,$6A01   ; Jump to #R$6A01 if we're not crossing a screen section.
 $69FD LD A,H        ; {Else #REGh'=#REGh'+#N$07.
 $69FE ADD A,$07     ;
 $6A00 LD H,A        ; }
@label=DrawHUDPanel_Skip
*$6A01 DEC C         ; Decrease the row counter by one.
 $6A02 JR NZ,$69DA   ; Jump back to #R$69DA until all of the rows have been
                     ; drawn.
; All done! Finish by reverting the change to #SKOOLKID$5C36(CHARS) and
; returning.
 $6A04 POP HL        ; {Restore #SKOOLKID$3D00(CHARSET) from the stack and write it back to
 $6A05 LD ($5C36),HL ; #SKOOLKID$5C36(CHARS).}
 $6A08 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #LUNARJETMAN$8BBB }
; LIST#

; Initialise Entities
;
; Used by the routine at #R$6391.
; .
; Sets up the player's car and the two opponent cars (the three entities
; at #R$5E80) from the template at #R$6A15.
@label=InitialiseEntities
c$6A09 LD HL,$6A15   ; Point #REGhl at the entity template (#R$6A15).
 $6A0C LD DE,$5E80   ; Point #REGde at the entities (#R$5E80).
 $6A0F LD BC,$0024   ; #REGbc=#N($0024, $04, $04) (#N$03 entities of #N$0C
                     ; bytes each).
 $6A12 LDIR          ; Copy the template to the entities.
 $6A14 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #UNDERWURLDE$A3DD }
; LIST#

; Entity Template
;
; The initial values copied to the entities at #R$5E80 by #R$6A09. The
; first byte of each entity is the state used by #R$6009: #N$01 for the player's
; car driving and #N$02 for an opponent car driving.
@label=EntityTemplate
b$6A15 DEFB $01,$98,$68,$72,$C0,$00,$00,$00,$00,$00,$00,$02 ; Player's car.
 $6A21 DEFB $02,$80,$00,$00,$80,$00,$80,$00,$00,$00,$00,$02 ; First opponent
                                                            ; car.
 $6A2D DEFB $02,$80,$00,$02,$80,$2F,$80,$17,$00,$00,$80,$02 ; Second opponent
                                                            ; car.

; Draw Player
;
; Used by the routine at #R$6A9B.
; .
; Draws the car in the centre of the play area, using the frame from
; #R$7F24 which matches the current direction.
;
; .
;
; #PUSHS #UDGTABLE(default,centre,centre,centre)
; { =h Before | =h After #R$6A39 | =h After #R$7064 }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$5F07,stop=$5F29,clear=1,sp=$5E00)
; #SIM(start=$5FEF,stop=$6010,sp=$5E00)
; #SIM(start=$6010,stop=$6AB9,sp=$5E00)
; #SCR$04,$11,$0A,$06,$05(draw-player-before)
; | #SIM(start=$6AB9,stop=$6ABC)
; #SCR$04,$11,$0A,$06,$05(draw-player-drawn)
; | #SIM(start=$6ABC,stop=$6ACB)
; #SCR$04,$11,$0A,$06,$05(draw-player-coloured) } UDGTABLE# #POPS
@label=DrawPlayer
c$6A39 LD HL,($5E10) ; Fetch the direction the car is facing (#R$5E10).
 $6A3C LD BC,$0020   ; #REGbc=#N($0020, $04, $04) (half of a step between two of the #N$10
                     ; directions, so the direction is rounded to the nearest).
 $6A3F ADD HL,BC     ; #REGhl=#REGhl + #REGbc.
 $6A40 LD A,H        ; #REGa=#REGh.
 $6A41 AND %00000011 ; Keep only bits 0-1.
; Shift the top two bits of #REGl into the bottom of #REGa to make a
; direction between #N$00 and #N$0F.
 $6A43 RL L          ; {Rotate #REGl left and shift its top bit into #REGa.
 $6A45 RLA           ;
 $6A46 RL L          ;
 $6A48 RLA           ; }
 $6A49 SLA A         ; Double #REGa to use it as an index into a table of
                     ; words.
 $6A4B LD HL,$7F24   ; Point #REGhl at the table of player sprites (#R$7F24).
 $6A4E LD C,A        ; {Create an offset in #REGbc.
 $6A4F LD B,$00      ; }
 $6A51 ADD HL,BC     ; #REGhl=#R$7F24 + offset.
 $6A52 LD E,(HL)     ; {Fetch the pointer to the sprite of the player for this direction
 $6A53 INC HL        ; into #REGde.
 $6A54 LD D,(HL)     ; }
; The player is drawn statically in the centre of the play area.
 $6A55 LD HL,$4F93   ; Set the screen address to draw the player at, the centre of the play
                     ; area (#N$4F93).
; The player sprite is #N$02 bytes in width.
 $6A58 LD A,$02      ; {Write #N$02 to #R$5E2C.
 $6A5A LD ($5E2C),A  ; }
 $6A5D LD A,(DE)     ; Fetch the height of the sprite.
 $6A5E INC DE        ; Increment #REGde by one to point to the sprite data.
 $6A5F LD C,A        ; Keep the height of the sprite in #REGc as the row
                     ; counter.
@label=DrawPlayer_NextRow
*$6A60 LD A,($5E2C)  ; {Set the byte counter to the width of the sprite
 $6A63 LD B,A        ; (#R$5E2C).}
 $6A64 PUSH HL       ; Stash the screen address of the start of the row on the
                     ; stack.
@label=DrawPlayer_NextCol
*$6A65 LD A,(DE)     ; {Copy a byte from #REGde (the player sprite data) to #REGhl (the
 $6A66 LD (HL),A     ; screen position).}
 $6A67 INC DE        ; Move on to the next byte of sprite data.
 $6A68 INC L         ; Move on to the next screen byte.
 $6A69 DJNZ $6A65    ; Decrease the byte counter by one and loop back to #R$6A65 until the
                     ; row has been drawn.
 $6A6B POP HL        ; Restore the screen address of the start of the row from
                     ; the stack.
 $6A6C CALL $6ECB    ; Call #R$6ECB to move up one pixel line.
 $6A6F DEC C         ; {Decrease the row counter by one and jump to #R$6A60 until all of the
 $6A70 JR NZ,$6A60   ; rows have been drawn.}
 $6A72 RET           ; Return.

; Move On To Next Entity
;
; The return address for every entity handler (see #R$6010). Moves on to
; the next entity or, when all of the entities have been handled, plays the
; engine sound and then waits while the game is paused.
@label=NextEntity
c$6A73 LD DE,$000C   ; Set the size of an entity (#N($000C, $04, $04)).
 $6A76 ADD IX,DE     ; #REGix=#REGix + #REGde (point to the next entity).
 $6A78 PUSH IX       ; {Copy the entity pointer into #REGhl (using the stack to
 $6A7A POP HL        ; do so).}
 $6A7B LD BC,$5EA4   ; Point #REGbc at the end of the entities (#R$5EA4, the first byte
                     ; after the last entity).
 $6A7E AND A         ; Reset the carry flag.
 $6A7F SBC HL,BC     ; Compare the entity pointer with the end of the entities.
 $6A81 JP C,$6010    ; Jump to #R$6010 if there is another entity to handle.
 $6A84 CALL $6158    ; Call #R$6158 to play the engine sound.

; Pause Game
;
; Waits for as long as "SHIFT" is held down, then counts the frame and
; starts the main loop again.
@label=Pause_Loop
c$6A87 LD A,$FE      ; {Read from the keyboard;
 $6A89 OUT ($FD),A   ; #TABLE(default,centre,centre,centre,centre,centre,centre)
 $6A8B IN A,($FE)    ; { =h,r2 Port Number | =h,c5 Bit }
                     ; { =h 0 | =h 1 | =h 2 | =h 3 | =h 4 }
                     ; { #N$FE | SHIFT | Z | X | C | V }
                     ; TABLE#}
 $6A8D BIT 0,A       ; {Is "SHIFT" being pressed? If it is then jump back to
 $6A8F JR Z,$6A87    ; #R$6A87.}
 $6A91 LD HL,($5E29) ; Fetch the game timer from #R$5E29.
 $6A94 INC HL        ; Add one to the game timer, as a frame has passed.
 $6A95 LD ($5E29),HL ; Write the new game timer back to #R$5E29.
 $6A98 JP $6009      ; Jump to #R$6009 to handle the entities again.

; Handler: Player
;
; Handles the player's car while it is being driven (entity state #N$01).
; Draws the objects and the car, then updates the radar, the terrain dots, the
; sidebar and the sounds.
;
; IX The player entity (#R$5E80)
@label=HandlerPlayer
c$6A9B PUSH IX       ; Stash #REGix on the stack.
; Reset the current place so that it can be set again if a place is in
; view.
 $6A9D LD A,$FF      ; {Write #N$FF to #R$5E39.
 $6A9F LD ($5E39),A  ; }
 $6AA2 CALL $6B47    ; Call #R$6B47 to draw the objects that are in view.
 $6AA5 CALL $6AF5    ; Call #R$6AF5 to remove the objects that are no longer in
                     ; view.
 $6AA8 CALL $6D12    ; Call #R$6D12 to update the miles, the speed, the position, the
                     ; steering and the fuel.
 $6AAB CALL $6557    ; Call #R$6557 to flash the player marker on the map.
 $6AAE CALL $625C    ; Call #R$625C to update the radar.
 $6AB1 CALL $6588    ; Call #R$6588 to update the terrain dots.
 $6AB4 CALL $611B    ; Call #R$611B to make the cup and refuel sounds.
 $6AB7 POP IX        ; Restore #REGix from the stack.
; Draw and colourise the player sprite.
 $6AB9 CALL $6A39    ; Call #R$6A39.
 $6ABC LD HL,$5993   ; Point #REGhl at the attribute buffer location of the player
                     ; (#N$5993).
 $6ABF LD BC,$0202   ; #REGbc=#N($0202, $04, $04) (height * width in bytes).
; Merge the player sprite colour in with the current background colour.
 $6AC2 LD A,($5E44)  ; Fetch the background attribute (#R$5E44).
 $6AC5 OR %00000010  ; Set bit 1 (RED).
 $6AC7 LD D,A        ; Keep the attribute to colour the car with in #REGd.
 $6AC8 CALL $7064    ; Colour the car using #R$7064.
; Handles updating the dashboard values.
 $6ACB CALL $64C7    ; Call #R$64C7 to update the time.
 $6ACE CALL $6CDE    ; Call #R$6CDE to display the miles and the time.
; Remove the place name from the screen when no place is in view any more.
 $6AD1 LD A,($5E39)  ; Fetch the place name flag (#R$5E39).
 $6AD4 AND A         ; {Return if #R$5E39 is zero (the name has already been
 $6AD5 RET Z         ; removed).}
 $6AD6 INC A         ; Add one, so that #N$FF becomes #N$00.
 $6AD7 RET NZ        ; Return if #REGa is not zero (a place is in view; it is only zero
                     ; here when the value was #N$FF, see #R$6A9D).
 $6AD8 LD ($5E39),A  ; Clear the place name flag (#R$5E39) so that this is only
                     ; done once.
 $6ADB LD HL,$B868   ; #REGhl=#N$B868 (pixel co-ordinates).
 $6ADE LD DE,$6AE4   ; Point #REGde at the blank text (#R$6AE4).
 $6AE1 JP $6518      ; Jump to #R$6518 to overwrite the place name with spaces.

; Messaging: Blank Place Name
;
; Used to overwrite the place name on the screen. The first byte is the
; attribute, followed by the spaces to print.
@label=Blank_Text_Attribute
t$6AE4 DEFB $76                       ; Attribute: #N$76 (bright yellow ink on
                                      ; yellow paper).
@label=Blank_Text
 $6AE5 DEFM "               "," "+$80 ; Contains #N$0F spaces, the last with
                                      ; bit 7 set.

; Handler: Objects
;
; Used by the routine at #R$6A9B.
; .
; Looks after the objects (#N$07 slots from #R$5E50). #R$6B47 sets bit 7
; of the sprite ID of each object that is in view, so for each slot this clears
; that bit for objects still in view, erases the objects which are no longer in
; view and frees their slots. Empty slots just waste a little time.
@label=HandlerObjects
c$6AF5 LD HL,$5E50   ; Point #REGhl at the first object (#R$5E50).
 $6AF8 LD B,$07      ; Set the object counter to #N$07.
@label=CheckObjectActive
*$6AFA BIT 7,(HL)    ; {If bit 7 is not set on the current objects sprite ID value, jump to
 $6AFC JR Z,$6B12    ; #R$6B12.}
 $6AFE RES 7,(HL)    ; Reset bit 7 of the sprite ID.
 $6B00 JR $6B0C      ; Jump to #R$6B0C.
; This entry point is used by the routine at #R$6B12.
; .
; An empty slot; spend some time so that the frame takes about as long as
; it does for a used one.
@label=HandlerObjects_EmptySlot
*$6B02 PUSH HL       ; Stash #REGhl on the stack.
; See #POKE(make_the_game_go_faster,Make The Game Go Faster).
 $6B03 LD HL,$0118   ; Set the delay counter to #N($0118, $04, $04).
@label=ObjectPauseLoop
*$6B06 DEC HL        ; Decrease the delay counter by one.
 $6B07 LD A,H        ; {Loop back to #R$6B06 until the delay counter is zero.
 $6B08 OR L          ;
 $6B09 JR NZ,$6B06   ; }
 $6B0B POP HL        ; Restore #REGhl from the stack.
@label=NextObject
*$6B0C INC HL        ; {Move on to the Y position of the object.
 $6B0D INC HL        ; }
; This entry point is used by the routine at #R$6B12.
@label=NextObject_2
*$6B0E INC HL        ; Move on to the next object.
 $6B0F DJNZ $6AFA    ; Decrease the object counter by one and loop back to #R$6AFA until
                     ; all #N$07 objects have been checked.
 $6B11 RET           ; Return.

; Erase Object
;
; Used by the routine at #R$6AF5.
; .
; Erases an object that is no longer in view and empties its slot. An
; empty slot is handled by the pause loop at #R$6B02 instead.
;
; HL The object slot
; B Number of object slots left to handle
@label=EraseObject
c$6B12 LD A,(HL)     ; Fetch the sprite ID of the object.
 $6B13 AND A         ; {If #REGa is zero then the slot is empty, so jump to
 $6B14 JR Z,$6B02    ; #R$6B02.}
 $6B16 PUSH BC       ; {Stash #REGbc and #REGhl on the stack.
 $6B17 PUSH HL       ; }
 $6B18 PUSH HL       ; {Point #REGix at the object (using the stack to do so).
 $6B19 POP IX        ; }
 $6B1B CALL $71ED    ; Copy the position and sprite ID of the object using
                     ; #R$71ED.
 $6B1E CALL $7139    ; Call #R$7139 to erase the object from the screen.
 $6B21 POP HL        ; Restore #REGhl from the stack.
 $6B22 XOR A         ; Set #REGa to #N$00, ready to empty the slot.
 $6B23 LD (HL),A     ; Empty the slot by clearing the sprite ID of the object.
 $6B24 INC HL        ; Increment #REGhl by one.
 $6B25 LD (HL),A     ; Write #N$00 to the next byte of the object.
 $6B26 INC HL        ; Increment #REGhl by one.
 $6B27 LD (HL),A     ; Write #N$00 to the final byte of the object.
 $6B28 POP BC        ; Restore #REGbc from the stack.
 $6B29 JR $6B0E      ; Jump to #R$6B0E.

; Scale Value
;
; Used by the routine at #R$62DA.
; .
; Converts a map position held in a single byte into map units, by
; shifting #REGd right through #REGe so that #REGde is #REGd * #N$0100 shifted
; right by a fixed number of bits. #R$6B2B multiplies by #N$40, #R$6B30
; multiplies by #N$20 (used for the X position of a map point) and #R$6B3D
; multiplies by #N$10 (used for the Y position of a map point).
;
;   D Value to scale
; O:DE Scaled value
@label=ScaleValue
c$6B2B PUSH BC       ; Stash #REGbc on the stack.
 $6B2C LD B,$02      ; Set the shift counter to #N$02.
 $6B2E JR $6B33      ; Jump to #R$6B33.
; This entry point is used by the routines at #R$62DA, #R$6B47, #R$6BFE and
; #R$6C2D.
; .
; Multiply by #N$20.
@label=ScaleValue_DivideByEight
*$6B30 PUSH BC       ; Stash #REGbc on the stack.
 $6B31 LD B,$03      ; Set the shift counter to #N$03.
@label=ScaleValue_Shift
*$6B33 LD E,$00      ; Clear the low byte of the scaled value.
@label=ScaleValue_Loop
*$6B35 SRL D         ; Shift #REGd right, moving bit 0 into the carry flag.
 $6B37 RR E          ; Rotate the carry flag into #REGe.
 $6B39 DJNZ $6B35    ; Decrease the shift counter by one and loop back to #R$6B35 until all
                     ; of the shifts have been done.
 $6B3B POP BC        ; Restore #REGbc from the stack.
 $6B3C RET           ; Return.
; This entry point is used by the routine at #R$6B47.
; .
; Multiply by #N$10.
@label=ScaleValue_DivideBySixteen
*$6B3D PUSH BC       ; Stash #REGbc on the stack.
 $6B3E LD B,$04      ; Set the shift counter to #N$04.
 $6B40 JR $6B33      ; Jump to #R$6B33.

; Set Day Object Attributes Pointer
;
; Used by the routine at #R$6B47.
; .
; Points #REGhl at the attributes for the objects in the daytime, then
; rejoins #R$6B47 where the sprite ID is read.
@label=SetDayObjectAttributes
c$6B42 LD HL,$6BE6   ; Point #REGhl at the day time object attributes
                     ; (#R$6BE6).
 $6B45 JR $6B7F      ; Jump to #R$6B7F.

; Draw Objects
;
; Used by the routine at #R$6A9B.
; .
; Goes through the map points (#R$7811), from the one that #R$5E19 points
; to, and draws each one that is in view of the player's car. The map points are
; in order of their X position, so it stops at the first one which is more than
; #N$60 map units away horizontally. Map points which are too far away
; vertically are skipped.
;
; .
;
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$5F07,stop=$5F29,clear=1,sp=$5E00)
; #SIM(start=$5FEF,stop=$6010,sp=$5E00)
; #POKES$5E05,$C0;$5E06,$0C;$5E08,$98;$5E09,$05
; #SIM(start=$6BFE,stop=$6C29,sp=$5E00)
; #SIM(start=$6010,stop=$6AA2,sp=$5E00)
; #SCR$02,$08,$00,$18,$18(draw-objects-before)
; | #SIM(start=$6AA2,stop=$6AA5)
; #SCR$02,$08,$00,$18,$18(draw-objects-after) } UDGTABLE# #POPS
@label=DrawObjects
c$6B47 LD BC,($5E19)        ; Fetch the first map point that might be in view
                            ; (#R$5E19).
; Handle the next map point. #REGa' is used to hold flags which say which
; side of the player's car the map point is on; bit 1 is set when it is to the
; right and bit 0 is set when it is higher up the map.
@label=DrawObjects_Next
*$6B4B XOR A                ; Prepare to clear the direction flags.
 $6B4C EX AF,AF'            ; Exchange #REGa with #REGa' to clear the flags.
 $6B4D LD A,(BC)            ; Fetch the X position of the map point.
 $6B4E INC BC               ; Move on to the Y position of the map point.
 $6B4F LD D,A               ; Keep the X position in #REGd.
 $6B50 CALL $6B30           ; Call #R$6B30 to convert it to map units in
                            ; #REGde.
 $6B53 LD HL,($5E05)        ; Fetch the player's X position on the map
                            ; (#R$5E05).
 $6B56 AND A                ; {#REGhl=#REGhl - #REGde (the horizontal distance
 $6B57 SBC HL,DE            ; to the map point).}
 $6B59 JR NC,$6B62          ; Jump to #R$6B62 if the map point is not to the right of the player's
                            ; car.
 $6B5B CALL $6BF6           ; Call #R$6BF6 to make the distance positive.
 $6B5E EX AF,AF'            ; Switch to the flags.
 $6B5F XOR %00000010        ; Flip bit 1 (the map point is to the right).
 $6B61 EX AF,AF'            ; Switch back.
@label=DrawObjects_CheckRangeX
*$6B62 PUSH HL              ; Stash the distance on the stack.
 $6B63 EX DE,HL             ; Keep the distance in #REGde.
 $6B64 LD HL,$0060          ; Set the furthest distance in view, #N($0060, $04,
                            ; $04).
 $6B67 AND A                ; {Take the distance away from the furthest
 $6B68 SBC HL,DE            ; distance in view.}
 $6B6A POP HL               ; Restore the distance (#REGhl) from the stack.
 $6B6B RET C                ; Return if the map point is more than #N$60 units
                            ; away horizontally.
 $6B6C LD A,L               ; Fetch the horizontal distance (the low byte).
 $6B6D LD ($5E17),A         ; Store the horizontal distance in #R$5E17.
 $6B70 LD A,(BC)            ; Fetch the Y position of the map point.
 $6B71 INC BC               ; Move on to the sprite ID of the map point.
 $6B72 LD D,A               ; Keep the Y position in #REGd.
 $6B73 CALL $6B3D           ; Call #R$6B3D to convert it to map units in
                            ; #REGde.
; Pick the attributes for the objects; they depend on the time of day.
 $6B76 LD A,($5E43)         ; Fetch the day/night flag (#R$5E43).
 $6B79 AND A                ; {If it is day time then jump to #R$6B42.
 $6B7A JR Z,$6B42           ; }
 $6B7C LD HL,$6BD6          ; Point #REGhl at the night time object attributes
                            ; (#R$6BD6).
; This entry point is used by the routine at #R$6B42.
@label=DrawObjects_Sprite
*$6B7F LD A,(BC)            ; Fetch the sprite ID of the map point.
 $6B80 INC BC               ; Move on to the next map point.
 $6B81 LD ($5E1F),A         ; Store the sprite ID in #R$5E1F.
; Cups, place names and collected cups all use the first attribute.
 $6B84 CP $20               ; {Jump to #R$6BD3 if this is a cup (#N$20).
 $6B86 JR Z,$6BD3           ; }
 $6B88 CP $40               ; {Jump to #R$6BD3 if this is a place name or a collected cup (#N$40 or
 $6B8A JR NC,$6BD3          ; more).}
 $6B8C ADD A,L              ; {Add the sprite ID to the pointer to find the attribute for this
 $6B8D LD L,A               ; sprite.
 $6B8E LD A,H               ;
 $6B8F ADC A,$00            ;
 $6B91 LD H,A               ; }
@label=DrawObjects_Attribute
*$6B92 LD A,($5E44)         ; Fetch the background attribute (#R$5E44).
 $6B95 OR (HL)              ; Merge the colour of the object with the
                            ; background.
 $6B96 LD ($5E42),A         ; Store the attribute of the object in #R$5E42.
 $6B99 LD HL,($5E08)        ; Fetch the player's Y position on the map
                            ; (#R$5E08).
 $6B9C AND A                ; {#REGhl=#REGhl - #REGde (the vertical distance to
 $6B9D SBC HL,DE            ; the map point).}
 $6B9F JR NC,$6BA8          ; Jump to #R$6BA8 if the map point is not higher up the map than the
                            ; player's car.
 $6BA1 CALL $6BF6           ; Call #R$6BF6 to make the distance positive.
 $6BA4 EX AF,AF'            ; Switch to the flags.
 $6BA5 XOR %00000001        ; Flip bit 0 (the map point is higher up the map).
 $6BA7 EX AF,AF'            ; Switch back.
@label=DrawObjects_CheckRangeY
*$6BA8 PUSH HL              ; Stash the distance on the stack.
 $6BA9 EX DE,HL             ; Keep the distance in #REGde.
 $6BAA LD HL,$0060          ; Set the furthest distance in view, #N($0060, $04,
                            ; $04).
 $6BAD AND A                ; {Take the distance away from the furthest
 $6BAE SBC HL,DE            ; distance in view.}
 $6BB0 POP HL               ; Restore the distance (#REGhl) from the stack.
 $6BB1 JR C,$6B4B           ; Jump to #R$6B4B if the map point is more than #N$60 units away
                            ; vertically.
 $6BB3 LD A,L               ; Fetch the vertical distance (the low byte).
 $6BB4 LD ($5E18),A         ; Store the vertical distance in #R$5E18.
; Use the flags to look up the quadrant of the map point.
 $6BB7 EX AF,AF'            ; Switch to the direction flags.
 $6BB8 LD E,A               ; Use the direction flags as the index into the
                            ; quadrant table.
 $6BB9 LD D,$00             ; Clear the high byte of the index.
 $6BBB LD HL,$6BCF          ; Point #REGhl at the quadrant table (#R$6BCF).
 $6BBE ADD HL,DE            ; Add the index to the start of the table.
 $6BBF LD A,(HL)            ; Fetch the quadrant.
 $6BC0 LD ($5E13),A         ; Store the quadrant in #R$5E13.
 $6BC3 LD ($5E3A),BC        ; Store the map point pointer in #R$5E3A.
 $6BC7 PUSH BC              ; Stash #REGbc on the stack.
 $6BC8 CALL $6F3C           ; Call #R$6F3C to place the object on the screen.
 $6BCB POP BC               ; Restore #REGbc from the stack.
 $6BCC JP $6B4B             ; Jump to #R$6B4B.
; The quadrant for each combination of the flags in #REGa'. Bit 1 of the
; quadrant is set when the object is to the left of the player's car.
@label=DrawObjects_QuadrantTable
 $6BCF DEFB $02,$03,$01,$00 ;
; Use the first attribute for cups, place names and collected cups.
@label=DrawObjects_FirstAttribute
*$6BD3 XOR A                ; #REGa=#N$00 (this has no effect, as #REGa is
                            ; loaded again below).
 $6BD4 JR $6B92             ; Jump to #R$6B92.

; Night Object Attributes
;
; The colour of each object at night, indexed by sprite ID. It is merged
; with the background attribute at #R$5E44.
@label=NightObjectAttributes
b$6BD6 DEFB $43,$46,$45,$44,$47,$42,$44,$44
 $6BDE DEFB $44,$44,$45,$47,$44,$45,$46,$47

; Day Object Attributes
;
; The colour of each object in the daytime, indexed by sprite ID. It is
; merged with the background attribute at #R$5E44.
@label=DayObjectAttributes
b$6BE6 DEFB $43,$40,$41,$42,$42,$41,$40,$40
 $6BEE DEFB $40,$40,$41,$42,$42,$41,$40,$41

; Negate HL
;
; Used by the routines at #R$6212, #R$6633, #R$6B47 and #R$6C82.
; .
; Makes #REGhl negative.
;
;   HL The word
; O:HL The negative of the word
;
; Invert both bytes, then add one.
@label=NegateHL
c$6BF6 LD A,L        ; {Invert the low byte.
 $6BF7 CPL           ;
 $6BF8 LD L,A        ; }
 $6BF9 LD A,H        ; {Invert the high byte.
 $6BFA CPL           ;
 $6BFB LD H,A        ; }
 $6BFC INC HL        ; Increment #REGhl by one.
 $6BFD RET           ; Return.
; View the equivalent code in;
; #LIST
; { #GUNFRIGHT$D01B }
; { #MARTIANOIDS$B4B1 }
; { #NIGHTSHADE$E0DD }
; { #UNDERWURLDE$ADD6 }
; LIST#

; Find First Object
;
; Used by the routine at #R$6391.
; .
; Finds the first map point whose X position is not less than the player's
; X position minus #N$60, and writes its address to #R$5E19. If there is not one
; then the pointer is reset to the start of the map points.
@label=FindFirstObject
c$6BFE LD BC,$7811   ; Point #REGbc at the first map point (#R$7811).
 $6C01 LD HL,($5E05) ; Fetch the player's X position on the map (#R$5E05).
 $6C04 LD DE,$0060   ; Set the furthest distance in view, #N($0060, $04, $04).
 $6C07 AND A         ; {#REGhl=#REGhl - #REGde (the left edge of the view).
 $6C08 SBC HL,DE     ; }
 $6C0A EX DE,HL      ; Exchange #REGde and #REGhl.
@label=FindFirstObject_Next
*$6C0B EX DE,HL      ; Exchange them back so #REGhl holds the left edge of the
                     ; view again.
 $6C0C LD A,(BC)     ; Fetch the X position of the map point.
 $6C0D INC BC        ; Move on to the Y position of the map point.
 $6C0E LD D,A        ; Keep the X position in #REGd.
 $6C0F CALL $6B30    ; Call #R$6B30 to convert it to map units in #REGde.
 $6C12 EX DE,HL      ; Exchange #REGde and #REGhl.
 $6C13 AND A         ; {#REGhl=#REGhl - #REGde (the distance from the left edge of the
 $6C14 SBC HL,DE     ; view).}
 $6C16 JR NC,$6C2A   ; Jump to #R$6C2A if the map point is not to the left of the left
                     ; edge.
 $6C18 INC BC        ; {Move on to the next map point.
 $6C19 INC BC        ; }
 $6C1A LD HL,$7CD6   ; Point #REGhl at the end of the map points (#R$7CD6, one byte past
                     ; the end of #R$7811).
 $6C1D AND A         ; {#REGhl=#REGhl - #REGbc.
 $6C1E SBC HL,BC     ; }
 $6C20 JR NZ,$6C0B   ; Jump to #R$6C0B if there are more map points.
 $6C22 LD BC,$7811   ; Point #REGbc at the first map point (#R$7811), to go back to the
                     ; start.
@label=FindFirstObject_Store
*$6C25 LD ($5E19),BC ; Write #REGbc to #R$5E19.
 $6C29 RET           ; Return.
@label=FindFirstObject_Found
*$6C2A DEC BC        ; Decrease #REGbc by one (back to the X position).
 $6C2B JR $6C25      ; Jump to #R$6C25.

; Update Current Object
;
; Used by the routine at #R$6D73.
; .
; Moves the pointer at #R$5E19 so that it still points to the first map
; point which is within #N$60 map units of the player's X position.
@label=UpdateCurrentObject
c$6C2D XOR A         ; {Write #N$00 to #R$5E1B (it is set to #N$01 if the pointer moves
 $6C2E LD ($5E1B),A  ; back).}
 $6C31 LD BC,($5E19) ; Fetch the pointer to the first map point in view
                     ; (#R$5E19).
; Look at the earlier map points to see if the pointer has to move back.
@label=UpdateCurrentObject_Back
*$6C35 DEC BC        ; {Decrease #REGbc by three (to the previous map point).
 $6C36 DEC BC        ;
 $6C37 DEC BC        ; }
 $6C38 LD A,(BC)     ; Fetch the X position of the map point.
 $6C39 LD D,A        ; Keep the X position in #REGd.
 $6C3A CALL $6B30    ; Call #R$6B30 to convert it to map units in #REGde.
 $6C3D CALL $6C82    ; Find how far the map point is from the player using
                     ; #R$6C82.
 $6C40 JR NC,$6C49   ; Jump to #R$6C49 if the map point is not close enough.
 $6C42 LD A,$01      ; {Write #N$01 to #R$5E1B.
 $6C44 LD ($5E1B),A  ; }
 $6C47 JR $6C35      ; Jump to #R$6C35.
@label=UpdateCurrentObject_Moved
*$6C49 LD A,($5E1B)  ; Fetch the flag which says whether the pointer moved back
                     ; (#R$5E1B).
 $6C4C AND A         ; {Jump to #R$6C57 if the pointer did not move back.
 $6C4D JR Z,$6C57    ; }
 $6C4F INC BC        ; {Increment #REGbc by three (to the first map point which is close
 $6C50 INC BC        ; enough).
 $6C51 INC BC        ; }
@label=UpdateCurrentObject_Store
*$6C52 LD ($5E19),BC ; Write #REGbc to #R$5E19.
 $6C56 RET           ; Return.
; Check whether the pointer has to move forward.
@label=UpdateCurrentObject_Forward
*$6C57 LD BC,($5E19) ; Fetch the pointer to the first map point in view
                     ; (#R$5E19).
 $6C5B LD A,(BC)     ; Fetch the X position of the map point.
 $6C5C LD D,A        ; Keep the X position in #REGd.
 $6C5D CALL $6B30    ; Call #R$6B30 to convert it to map units in #REGde.
 $6C60 CALL $6C82    ; Find how far the map point is from the player using
                     ; #R$6C82.
 $6C63 RET C         ; Return if the map point is close enough.
@label=UpdateCurrentObject_Closer
*$6C64 LD ($5E1C),HL ; Write the distance to #R$5E1C.
@label=UpdateCurrentObject_NextPoint
*$6C67 INC BC        ; {Increment #REGbc by three (to the next map point).
 $6C68 INC BC        ;
 $6C69 INC BC        ; }
 $6C6A LD A,(BC)     ; Fetch the X position of the map point.
 $6C6B LD D,A        ; Keep the X position in #REGd.
 $6C6C CALL $6B30    ; Call #R$6B30 to convert it to map units in #REGde.
 $6C6F CALL $6C82    ; Find how far the map point is from the player using
                     ; #R$6C82.
 $6C72 JR C,$6C52    ; Jump to #R$6C52 if the map point is close enough.
 $6C74 PUSH HL       ; Stash the distance on the stack.
 $6C75 LD DE,($5E1C) ; Fetch the previous distance from #R$5E1C.
 $6C79 AND A         ; {#REGhl=#REGhl - #REGde.
 $6C7A SBC HL,DE     ; }
 $6C7C POP HL        ; Restore the distance (#REGhl) from the stack.
 $6C7D JR Z,$6C67    ; Jump to #R$6C67 if the distance is the same as before.
 $6C7F JR C,$6C64    ; Jump to #R$6C64 if the map point is nearer than the
                     ; previous one.
 $6C81 RET           ; Return.

; Get Map Distance
;
; Used by the routine at #R$6C2D.
; .
; Finds the distance between the first co-ordinate of the player's map
; position at #R$5E05 and the value in #REGde. The carry flag is set when the
; distance is less than #N$0060.
;
;   DE Map position
; O:HL Distance
; O:F The carry flag is set when the distance is less than #N$0060
@label=GetMapDistance
c$6C82 LD HL,($5E05) ; Fetch the player's X position on the map (#R$5E05).
 $6C85 AND A         ; {#REGhl=#REGhl - #REGde.
 $6C86 SBC HL,DE     ; }
 $6C88 JR NC,$6C8D   ; Jump to #R$6C8D if there was no carry.
 $6C8A CALL $6BF6    ; Call #R$6BF6.
@label=GetMapDistance_Compare
*$6C8D PUSH HL       ; Stash #REGhl on the stack.
 $6C8E LD DE,$0060   ; Set the furthest distance in view, #N($0060, $04, $04).
 $6C91 AND A         ; {Compare the distance with the furthest distance in
 $6C92 SBC HL,DE     ; view.}
 $6C94 POP HL        ; Restore #REGhl from the stack.
 $6C95 RET           ; Return.

; Print Character
;
; Used by the routines at #R$6518, #R$69BC and #R$6CB6.
;
; A ASCII value to print
; HL Screen address
@label=PrintScreen
c$6C96 PUSH BC       ; {Stash #REGbc, #REGde and #REGhl on the stack.
 $6C97 PUSH DE       ;
 $6C98 PUSH HL       ; }
 $6C99 LD L,A        ; {Set #REGhl to the character code.
 $6C9A LD H,$00      ; }
 $6C9C ADD HL,HL     ; {Calculate offset for ASCII character (#REGhl=#REGhl *
 $6C9D ADD HL,HL     ; 8).
 $6C9E ADD HL,HL     ; }
 $6C9F LD DE,($5C36) ; #REGde=#SKOOLKID$5C36(CHARS).
 $6CA3 ADD HL,DE     ; {#REGde=#REGhl + #N$3C00. For examples of usage;
 $6CA4 EX DE,HL      ; #TABLE(default,centre,centre,centre,centre,centre)
                     ; { =h Letter | =h ASCII Value | =h * 8 (offset) | =h CHARS + offset }
                     ; #FOREACH($55,$4C,$54,$49,$4D,$41,$54,$45)(value,
                     ; { #LET(result=$3C00 + value * $08) "#CHR(value)" | #N(value) | #N(value * 8) | #SKOOLKID($3D00,{result})(#N({result})) }
                     ; )
                     ; TABLE#}
; Print the character to the screen.
 $6CA5 POP HL        ; Restore #REGhl, containing the screen buffer location,
                     ; from the stack.
 $6CA6 LD B,$08      ; #REGb=#N$08 (#N$08 rows of pixels).
@label=PrintScreen_Loop
*$6CA8 LD A,(DE)     ; {Copy a byte of the character to the screen buffer.
 $6CA9 LD (HL),A     ; }
 $6CAA INC DE        ; Move on to the next byte of the character.
 $6CAB INC H         ; Move onto the next pixel line.
 $6CAC DJNZ $6CA8    ; Decrease the pixel row counter by one and loop back to #R$6CA8 until
                     ; all #N$08 rows have been drawn.
 $6CAE POP DE        ; {Restore #REGde and #REGbc from the stack.
 $6CAF POP BC        ; }
; Reset #REGhl and move to the next column, ready to print the next character.
 $6CB0 LD A,H        ; {#REGh=#REGh - #N$08 (reset the display line).
 $6CB1 SUB $08       ;
 $6CB3 LD H,A        ; }
 $6CB4 INC L         ; Move on to the next screen column.
 $6CB5 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$A1D3 }
; { #COOKIE$7468 }
; { #JETPAC$714C }
; { #LUNARJETMAN$89EF }
; { #MARTIANOIDS$B5CB }
; { #NIGHTSHADE$CB19 }
; { #PSSST$73CD }
; { #SABREWULF$B589 }
; { #UNDERWURLDE$98DF }
; LIST#

; Print Scores
;
; Used by the routines at #R$6046 and #R$68A0.
; .
; Prints the score or the high score at the top of the screen, as six BCD
; digits. The same code (from #R$6CC4) also prints other BCD numbers, such as
; the miles and the time.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$5F07,stop=$5F29,clear=1,sp=$5E00)
; #SIM(start=$5FEF,stop=$6010,sp=$5E00)
; #SCR$04,$08,$00,$18,$01(print-scores-before)
; | #POKES$5E4C,$12;$5E4D,$34;$5E4E,$50;$5E49,$98;$5E4A,$76;$5E4B,$54
; #SIM(start=$68F8,stop=$68FE)
; #SCR$04,$08,$00,$18,$01(print-scores-after) } UDGTABLE# #POPS
;
; .
;
; Sets up the player score.
@label=Score_1UP
c$6CB6 LD HL,$400D   ; #REGhl=#N$400D (screen location of the score).
 $6CB9 LD DE,$5E4C   ; Point #REGde at the score (#R$5E4C).
 $6CBC JR $6CC4      ; Jump to #R$6CC4.
; This entry point is used by the routine at #R$68A0.
; .
; Sets up the HI score.
@label=Score_HI
*$6CBE LD HL,$4018   ; #REGhl=#N$4018 (screen location of the high score).
 $6CC1 LD DE,$5E49   ; Point #REGde at the high score (#R$5E49).
; Prints the score. Entering at #R$6CC6 prints #REGb bytes (two digits
; each) of the BCD number at #REGde to the screen location in #REGhl.
@label=PrintScore
*$6CC4 LD B,$03      ; Set the byte counter to #N$03 (a score is #N$03 bytes, so #N$06
                     ; digits).
; This entry point is used by the routine at #R$6CDE.
@label=PrintScore_Loop
*$6CC6 LD A,(DE)     ; Fetch the next byte of the number, which holds two
                     ; digits.
 $6CC7 RRCA          ; {#REGa=#REGa / #N$10 (the first digit).
 $6CC8 RRCA          ;
 $6CC9 RRCA          ;
 $6CCA RRCA          ; }
 $6CCB AND %00001111 ; Keep only bits 0-3.
 $6CCD ADD A,$30     ; Add #N$30 to convert the digit to ASCII.
 $6CCF CALL $6C96    ; Call #R$6C96 to print the digit.
; This entry point is used by the routines at #R$646C, #R$6CDE and #R$6CFD.
; .
; Prints the second digit of the byte; entering here skips the first
; digit.
@label=PrintScore_SecondDigit
*$6CD2 LD A,(DE)     ; Fetch the byte again, for the second digit.
 $6CD3 AND %00001111 ; Keep only bits 0-3.
 $6CD5 ADD A,$30     ; Add #N$30 to convert the digit to ASCII.
 $6CD7 CALL $6C96    ; Call #R$6C96 to print the digit.
 $6CDA INC DE        ; Move on to the next byte of the number.
 $6CDB DJNZ $6CC6    ; Decrease the byte counter by one and loop back to #R$6CC6 until all
                     ; of the bytes have been printed.
 $6CDD RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$A1AE }
; { #COOKIE$7438 }
; { #JETPAC$711C }
; { #LUNARJETMAN$89BF }
; { #PSSST$739D }
; { #SABREWULF$B5CC }
; LIST#

; Display Miles/ Time
;
; Used by the routines at #R$68A0 and #R$6A9B.
; .
; Prints the miles travelled (six digits) and the time (one digit for the
; hours, two for the minutes and two for the seconds) in the sidebar.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$5F07,stop=$5F29,clear=1,sp=$5E00)
; #SIM(start=$5FEF,stop=$6010,sp=$5E00)
; #SCR$04,$00,$00,$08,$05(display-miles-before)
; | #POKES$5E2D,$01;$5E2E,$23;$5E2F,$45;$5E31,$01;$5E32,$23;$5E33,$45
; #SIM(start=$68CA,stop=$68CD)
; #SCR$04,$00,$00,$08,$05(display-miles-after) } UDGTABLE# #POPS
@label=DisplayMiles
c$6CDE LD HL,$4061   ; Set the screen position of the miles, #N$4061.
 $6CE1 LD DE,$5E2D   ; Point #REGde at the miles (#R$5E2D).
 $6CE4 LD B,$03      ; Set the byte counter to #N$03 (the miles are #N$03 bytes, so #N$06
                     ; digits).
 $6CE6 CALL $6CC6    ; Print the miles using #R$6CC6.
 $6CE9 LD HL,$4021   ; Set the screen position of the time, #N$4021.
; This entry point is used by the routine at #R$63FF.
@label=DisplayTime_Minutes
*$6CEC LD DE,$5E31   ; Point #REGde at the time (#R$5E31).
 $6CEF LD B,$02      ; Set the byte counter to #N$02 (the single hours digit and the two
                     ; minutes digits).
 $6CF1 CALL $6CD2    ; Call #R$6CD2 to skip the first digit of the hours byte.
 $6CF4 LD DE,$5E33   ; Point #REGde at the seconds (#R$5E33).
; This entry point is used by the routine at #R$6CFD.
@label=DisplayTime_Seconds
*$6CF7 INC HL        ; Move on one column to leave a gap before the seconds.
 $6CF8 LD B,$01      ; Set the byte counter to #N$01 (the two seconds digits).
 $6CFA JP $6CC6      ; Jump to #R$6CC6 to print the seconds.

; Print Best Time
;
; Used by the routine at #R$6483.
; .
; Prints a time (such as the best time at #R$5E00) in the same way as
; #R$6CEC.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$5F07,stop=$5F29,clear=1,sp=$5E00)
; #SIM(start=$5FEF,stop=$6010,sp=$5E00)
; #SIM(start=$5F29,stop=$5F2C)
; #POKES$5E00,$01;$5E01,$23;$5E02,$45;$5E03,$01
; #SIM(start=$5F2C,stop=$6492)
; #SCR$03,$08,$11,$18,$05(print-best-time-before)
; | #SIM(start=$6492,stop=$5F33)
; #SCR$03,$08,$11,$18,$05(print-best-time-after) } UDGTABLE# #POPS
;
; DE Address of the time
; HL Screen location
;
; Print the first two digits.
@label=PrintBestTime
c$6CFD LD B,$02      ; Set the byte counter to #N$02.
 $6CFF CALL $6CD2    ; Print the hours and minutes using #R$6CD2.
; Print the final digit.
 $6D02 LD DE,$5E02   ; Point #REGde at the seconds of the time (#R$5E02).
 $6D05 JR $6CF7      ; Jump to #R$6CF7.

; Increase Speed
;
; Used by the routine at #R$6D12.
; .
; Adds #N$04 to the speed, unless that would take it to the top speed of
; #N$C0 or more, in which case the speed is left as it is.
@label=HandlerCanAccelerate
c$6D07 LD A,($5E0D)  ; Fetch the speed of the car (#R$5E0D).
 $6D0A ADD A,$04     ; Add #N$04 to the speed.
 $6D0C CP $C0        ; {Jump to #R$6D76 if the speed has reached the top speed (#N$C0 or
 $6D0E JR NC,$6D76   ; more).}
 $6D10 JR $6D73      ; Jump to #R$6D73 to write the new speed.

; Update Player Car
;
; Used by the routine at #R$6A9B.
; .
; Called once a frame for the player's car. Adds to the miles travelled,
; handles the accelerator and the brake, then moves the car, steers it and uses
; up fuel.
; #TABLE(default,centre,centre)
; { =h Address | =h Meaning }
; { #R$5E04 | X position of the car (#N$03 bytes, the top two are in map units) }
; { #R$5E07 | Y position of the car (#N$03 bytes, the top two are in map units) }
; { #R$5E10 | Direction of the car (#N$0400 is a full turn) }
; TABLE#
;
; .
;
; Add the speed to the odometer.
@label=UpdatePlayerCar
c$6D12 LD C,$00      ; Set the miles carry to #N$00.
 $6D14 LD A,($5E0D)  ; Fetch the speed of the car (#R$5E0D).
 $6D17 RLA           ; {Rotate the top bit of #REGa into #REGc.
 $6D18 RL C          ; }
 $6D1A RLA           ; {Rotate the top bit of #REGa into #REGc again (this multiplies the
 $6D1B RL C          ; speed by #N$04).}
 $6D1D LD HL,$5E30   ; Point #REGhl at the fraction of a mile (#R$5E30).
 $6D20 ADD A,(HL)    ; Add the scaled speed to the fraction of a mile.
 $6D21 LD (HL),A     ; Write the fraction of a mile back.
 $6D22 LD A,C        ; Fetch the carry from the speed.
 $6D23 LD B,$03      ; Set the byte counter to #N$03 (the miles are stored in
                     ; three bytes).
; Working backwards, add onto the odometer.
@label=CalcMiles
*$6D25 DEC HL        ; Move back to the previous byte of the miles.
 $6D26 ADC A,(HL)    ; Add the carry to the byte of the miles.
 $6D27 DAA           ; Convert the result to BCD.
 $6D28 LD (HL),A     ; Write the byte of the miles back.
 $6D29 LD A,$00      ; Clear the carry value, keeping the carry flag.
 $6D2B DJNZ $6D25    ; Decrease the byte counter by one and loop back to #R$6D25 until all
                     ; three bytes of the miles have been done.
; Award some points every time the middle byte of the miles changes.
 $6D2D LD A,($5E74)  ; {Fetch the middle byte of the miles as it was last time (#R$5E74)
 $6D30 LD L,A        ; and keep it in #REGl.}
 $6D31 LD A,($5E2E)  ; Fetch the middle byte of the miles (#R$5E2E).
 $6D34 CP L          ; {Jump to #R$6D40 if the middle byte of the miles has not
 $6D35 JR Z,$6D40    ; changed.}
 $6D37 LD ($5E74),A  ; Store the new middle byte of the miles in #R$5E74.
 $6D3A LD BC,$0010   ; Set the points to add, #N($0010, $04, $04).
 $6D3D CALL $6046    ; Add the points to the score using #R$6046.
@label=UpdatePlayerCar_CheckFuel
*$6D40 LD HL,($5E05) ; #REGhl=#R$5E05 (the value is not used).
; Check fuel.
 $6D43 LD A,($5E0B)  ; Fetch the fuel level (#R$5E0B).
; See #POKE(infinite_fuel,Infinite Fuel).
 $6D46 AND A         ; {Jump to #R$6D56 if there is still some fuel.
 $6D47 JR NZ,$6D56   ; }
; Handle being out of fuel (or too hot): slow down gradually, but allow
; the car to be driven again when it is slow enough.
@label=UpdatePlayerCar_NoFuel
*$6D49 LD A,($5E0D)  ; Fetch the speed of the car (#R$5E0D).
 $6D4C CP $33        ; {Jump to #R$6D5D if the speed is below #N$33, so the car can be
 $6D4E JR C,$6D5D    ; driven again.}
 $6D50 DEC A         ; Slow the car down by one.
 $6D51 LD ($5E0D),A  ; Write the speed back to #R$5E0D.
 $6D54 JR $6D64      ; Jump to #R$6D64.
; Check the temperature.
@label=UpdatePlayerCar_CheckTemperature
*$6D56 LD A,($5E0C)  ; Fetch the temperature (#R$5E0C).
; See #POKE(infinite_temperature,Infinite Temperature).
 $6D59 CP $A0        ; {Jump to #R$6D49 if the temperature is #N$A0 or more.
 $6D5B JR NC,$6D49   ; }
; Check the accelerator.
@label=UpdatePlayerCar_Accelerate
*$6D5D CALL $61E0    ; Check if the accelerator is pressed using #R$61E0.
 $6D60 BIT 3,A       ; {Jump to #R$6D07 if the accelerator is pressed.
 $6D62 JR Z,$6D07    ; }
; Check the brake.
@label=UpdatePlayerCar_Brake
*$6D64 CALL $61C2    ; Check if the brake is pressed using #R$61C2.
 $6D67 BIT 2,A       ; {Jump to #R$6D76 if the brake is not pressed.
 $6D69 JR NZ,$6D76   ; }
 $6D6B LD A,($5E0D)  ; Fetch the speed of the car (#R$5E0D).
 $6D6E SUB $10       ; Subtract #N$10 from the speed.
 $6D70 JR NC,$6D73   ; Jump to #R$6D73 if the speed did not go below zero.
 $6D72 XOR A         ; Set the speed to #N$00.

; Set Speed
;
; Used by the routines at #R$6D07 and #R$6D12.
; .
; Stores the new speed, draws the speed gauge and moves the car. The
; direction is split into the quadrant (the top two bits, held in #R$5E11) and
; the position in that quadrant (the top five bits of #R$5E10). The table at
; #R$7F6B is then used to share out the speed between the Y and X directions;
; the X part uses the table from the other end.
;
; A Speed
@label=HandlerAccelerate
c$6D73 LD ($5E0D),A  ; Write the new speed to #R$5E0D.
; This entry point is used by the routines at #R$6D07 and #R$6D12.
; .
; Draw the speed gauge.
@label=HandlerAccelerate_Gauge
*$6D76 LD A,($5E0D)  ; Fetch the speed of the car (#R$5E0D).
 $6D79 LD HL,$49E2   ; Set the screen location of the speed gauge, #N$49E2.
 $6D7C CALL $6EDE    ; Draw the speed gauge using #R$6EDE.
; Work out the direction.
 $6D7F LD A,($5E11)  ; Fetch the quadrant of the direction (#R$5E11).
 $6D82 INC A         ; Add one to the quadrant.
 $6D83 LD C,A        ; Keep the quadrant in #REGc.
 $6D84 LD A,($5E10)  ; Fetch the direction (#R$5E10).
 $6D87 RRA           ; {Shift #REGa right three times.
 $6D88 RRA           ;
 $6D89 RRA           ; }
 $6D8A AND %00011111 ; Keep bits 0-4.
 $6D8C BIT 0,C       ; {Jump to #R$6D92 if bit 0 of #REGc is set.
 $6D8E JR NZ,$6D92   ; }
 $6D90 XOR %00011111 ; Reverse bits 0-4 (the position in the quadrant is measured the
                     ; other way round).
@label=HandlerAccelerate_TableIndex
*$6D92 LD E,A        ; Use the position in the quadrant as the index into the
                     ; table.
 $6D93 LD D,$00      ; Clear the high byte of the index.
 $6D95 PUSH DE       ; Stash the index on the stack.
 $6D96 LD HL,$7F6B   ; Point #REGhl at the table which shares out the speed
                     ; (#R$7F6B).
 $6D99 ADD HL,DE     ; Add the index to the start of the table.
 $6D9A LD A,($5E0D)  ; {Fetch the speed of the car (#R$5E0D) and keep it in
 $6D9D LD E,A        ; #REGe.}
 $6D9E LD D,$00      ; Clear the high byte of the speed.
 $6DA0 PUSH DE       ; Stash #REGde (the speed) on the stack.
 $6DA1 LD A,(HL)     ; Fetch the share of the speed from the table.
 $6DA2 CALL $6F2F    ; Call #R$6F2F to multiply #REGa by the speed.
; Move the car in the Y direction.
 $6DA5 LD A,($5E09)  ; Fetch the top byte of the Y position of the car (#R$5E07
                     ; + #N$02).
 $6DA8 LD DE,($5E07) ; #REGde=#R$5E07.
 $6DAC CALL $6EC2    ; Call #R$6EC2 to divide the result by #N$20.
 $6DAF BIT 1,C       ; {Jump to #R$6DEF if the car is moving to a lower Y
 $6DB1 JR NZ,$6DEF   ; position.}
 $6DB3 ADD HL,DE     ; Add the result to the Y position.
 $6DB4 ADC A,$00     ; Carry any overflow into the top byte.
 $6DB6 CP $0C        ; {Jump to #R$6E00 if the Y position reached the edge of the map
 $6DB8 JR NC,$6E00   ; (#N$0C).}
; This entry point is used by the routine at #R$6DEF.
@label=HandlerAccelerate_StoreY
*$6DBA LD ($5E09),A  ; Write the top byte of the Y position.
 $6DBD LD ($5E07),HL ; Write the rest of the Y position.
; This entry point is used by the routine at #R$6E00.
; .
; Move the car in the X direction.
@label=HandlerAccelerate_MoveX
*$6DC0 POP HL        ; Restore the speed from the stack.
 $6DC1 POP DE        ; Restore the offset from the stack.
 $6DC2 PUSH HL       ; Stash the speed on the stack.
 $6DC3 LD HL,$7F8A   ; Point #REGhl at the end of the table which shares out the speed
                     ; (#R$7F8A).
 $6DC6 AND A         ; Clear the carry flag.
 $6DC7 SBC HL,DE     ; #REGhl=#R$7F8A - offset (this reads the table from the
                     ; other end).
 $6DC9 LD A,(HL)     ; Fetch the share of the speed from the table.
 $6DCA POP DE        ; Restore the speed from the stack.
 $6DCB CALL $6F2F    ; Call #R$6F2F to multiply #REGa by the speed.
 $6DCE LD A,($5E06)  ; Fetch the top byte of the X position of the car (#R$5E04
                     ; + #N$02).
 $6DD1 LD DE,($5E04) ; #REGde=#R$5E04.
 $6DD5 CALL $6EC2    ; Call #R$6EC2 to divide the result by #N$20.
 $6DD8 DEC C         ; Decrease #REGc by one.
 $6DD9 BIT 1,C       ; {Jump to #R$6E32 if the car is moving to a lower X
 $6DDB JR NZ,$6E32   ; position.}
 $6DDD ADD HL,DE     ; Add the result to the X position.
 $6DDE ADC A,$00     ; Carry any overflow into the top byte.
 $6DE0 CP $18        ; {Jump to #R$6E19 if the X position reached the edge of the map
 $6DE2 JR NC,$6E19   ; (#N$18).}
; This entry point is used by the routine at #R$6E32.
@label=HandlerAccelerate_StoreX
*$6DE4 LD ($5E04),HL ; Write the rest of the X position.
 $6DE7 LD ($5E06),A  ; Write the top byte of the X position.
; This entry point is used by the routine at #R$6E19.
@label=HandlerAccelerate_UpdateObject
*$6DEA CALL $6C2D    ; Call #R$6C2D.
 $6DED JR $6E43      ; Jump to #R$6E43.

; Subtract Y Movement
;
; Used by the routine at #R$6D73.
; .
; Moves the car to a lower Y position. If it would go below the start of
; the map then it bounces off the edge instead.
@label=SubtractY
c$6DEF EX DE,HL      ; #REGhl=Y position.
 $6DF0 AND A         ; {Subtract the result of the multiplication from the Y
 $6DF1 SBC HL,DE     ; position.}
 $6DF3 SBC A,$00     ; Borrow from the top byte.
 $6DF5 JR NZ,$6DBA   ; Jump to #R$6DBA if the top byte is not zero.
 $6DF7 EX AF,AF'     ; Switch to the shadow flags.
 $6DF8 LD A,H        ; #REGa=#REGh.
 $6DF9 CP $80        ; {Jump to #R$6E00 if the position is below #N$80 in the
 $6DFB JR C,$6E00    ; second byte.}
 $6DFD EX AF,AF'     ; Switch back.
 $6DFE JR $6DBA      ; Jump to #R$6DBA.

; Bounce Off Y Edge
;
; Used by the routines at #R$6D73 and #R$6DEF.
; .
; Reverses the direction in Y, sounds the bounce and carries on with the X
; direction.
@label=BounceY
c$6E00 LD A,($5E11)  ; Fetch the quadrant of the direction (#R$5E11).
 $6E03 XOR %00000001 ; Flip bit 0 to reverse the direction in Y.
 $6E05 LD ($5E11),A  ; Write the quadrant back to #R$5E11.
 $6E08 LD A,($5E10)  ; Fetch the direction (#R$5E10).
 $6E0B CPL           ; Flip all the bits to reverse the direction within the
                     ; quadrant.
 $6E0C LD ($5E10),A  ; Write the direction back to #R$5E10.
 $6E0F LD A,$05      ; Set the bounce counter to #N$05.
 $6E11 LD ($5E45),A  ; Write the bounce counter to #R$5E45.
 $6E14 CALL $60E3    ; Make the bounce sound using #R$60E3.
 $6E17 JR $6DC0      ; Jump to #R$6DC0.

; Bounce Off X Edge
;
; Used by the routines at #R$6D73 and #R$6E32.
; .
; Reverses the direction in X, sounds the bounce and carries on.
@label=BounceX
c$6E19 LD A,($5E11)  ; Fetch the quadrant of the direction (#R$5E11).
 $6E1C XOR %00000011 ; Flip bits 0 and 1.
 $6E1E LD ($5E11),A  ; Write the quadrant back to #R$5E11.
 $6E21 LD A,($5E10)  ; Fetch the direction (#R$5E10).
 $6E24 CPL           ; Flip all the bits.
 $6E25 LD ($5E10),A  ; Write the direction back to #R$5E10.
 $6E28 LD A,$05      ; Set the bounce counter to #N$05.
 $6E2A LD ($5E45),A  ; Write the bounce counter to #R$5E45.
 $6E2D CALL $60E3    ; Make the bounce sound using #R$60E3.
 $6E30 JR $6DEA      ; Jump to #R$6DEA.

; Subtract X Movement
;
; Used by the routine at #R$6D73.
; .
; Moves the car to a lower X position. If it would go below the start of
; the map then it bounces off the edge instead.
@label=SubtractX
c$6E32 EX DE,HL      ; #REGhl=X position.
 $6E33 AND A         ; {Subtract the result of the multiplication from the X
 $6E34 SBC HL,DE     ; position.}
 $6E36 SBC A,$00     ; Borrow from the top byte.
 $6E38 JR NZ,$6DE4   ; Jump to #R$6DE4 if the top byte is not zero.
 $6E3A EX AF,AF'     ; Switch to the shadow flags.
 $6E3B LD A,H        ; #REGa=#REGh.
 $6E3C CP $80        ; {Jump to #R$6E19 if the position is below #N$80 in the
 $6E3E JR C,$6E19    ; second byte.}
 $6E40 EX AF,AF'     ; Switch back.
 $6E41 JR $6DE4      ; Jump to #R$6DE4.

; Handle Steering And Fuel
;
; Used by the routine at #R$6D73.
; .
; Counts down the bounce, steers the car, uses up fuel and updates the
; temperature and the gauges.
;
; .
;
; Count down the bounce; the sound is only made while this is not zero.
@label=HandlerSteering
c$6E43 LD A,($5E45)  ; Fetch the bounce counter (#R$5E45).
 $6E46 AND A         ; {Jump to #R$6E54 if the bounce is over.
 $6E47 JR Z,$6E54    ; }
 $6E49 DEC A         ; Count down the bounce.
 $6E4A LD ($5E45),A  ; Write the bounce counter back to #R$5E45.
 $6E4D JR Z,$6E51    ; Jump to #R$6E51 if the counter is now zero.
 $6E4F LD A,$02      ; #REGa=#N$02.
@label=HandlerSteering_StoreSound
*$6E51 LD ($5E47),A  ; Write #REGa to #R$5E47.
; Steer the car.
@label=HandlerSteering_Steer
*$6E54 CALL $618C    ; Read the steering keys using #R$618C.
 $6E57 LD HL,($5E10) ; Point #REGhl at the direction (#R$5E10).
 $6E5A LD E,$18      ; Set the amount to turn by, #N$18.
 $6E5C BIT 1,A       ; {Jump to #R$6E76 if left is pressed.
 $6E5E JP Z,$6E76    ; }
 $6E61 BIT 0,A       ; {Jump to #R$6E6C if right is pressed.
 $6E63 JP Z,$6E6C    ; }
 $6E66 LD E,$00      ; Set the amount to turn by to #N$00, as the car is going
                     ; straight on.
 $6E68 JR $6E7E      ; Jump to #R$6E7E.
; This instruction is never used.
 $6E6A LD E,$18      ; #REGe=#N$18.
; Turn right.
@label=HandlerSteering_TurnRight
*$6E6C LD D,$00      ; Clear the high byte of the amount to turn by.
 $6E6E ADD HL,DE     ; Add the amount to turn by to the direction.
 $6E6F LD ($5E10),HL ; Write the direction back to #R$5E10.
 $6E72 JR $6E7E      ; Jump to #R$6E7E.
; This instruction is never used.
 $6E74 LD E,$18      ; #REGe=#N$18.
; Turn left.
@label=HandlerSteering_TurnLeft
*$6E76 LD D,$00      ; Clear the high byte of the amount to turn by.
 $6E78 AND A         ; {Take the amount to turn by away from the direction.
 $6E79 SBC HL,DE     ; }
 $6E7B LD ($5E10),HL ; Write the direction back to #R$5E10.
; Don't "use fuel" on every frame. This routine uses the last two bits of
; the #R$5E29(GameTimer) (i.e. a number between 0-3) to only process every
; fourth frame.
@label=HandlerFuel
*$6E7E LD A,($5E29)  ; Fetch the game timer (#R$5E29).
 $6E81 AND %00000011 ; Keep only bits 0-1.
 $6E83 JR NZ,$6E9B   ; If the result is not zero then jump to #R$6E9B.
; Handles "using" fuel.
 $6E85 LD A,($5E0D)  ; Fetch the speed of the car (#R$5E0D).
 $6E88 LD C,A        ; Use the speed as the amount of fuel to use, in #REGc.
 $6E89 LD B,$00      ; Clear the high byte of the amount of fuel to use.
 $6E8B LD HL,($5E0A) ; Fetch the fuel (#R$5E0A).
; A higher speed uses more fuel.
 $6E8E SBC HL,BC     ; #REGhl=#REGhl (fuel) - #REGbc (speed).
 $6E90 JR C,$6E95    ; If there's "carry" (i.e. if the player has run out of fuel) jump to
                     ; #R$6E95.
 $6E92 LD ($5E0A),HL ; Write #REGhl to #R$5E0A.
@label=FuelSkipWrite
*$6E95 CP $B0        ; {If the current speed is more than #N$B0 (top speed)
 $6E97 JR NC,$6EAF   ; jump to #R$6EAF.}
 $6E99 CP $60        ; Compare current speed with #N$60.
; Handle the temperature gauge.
@label=HandlerTemperatureGauge
*$6E9B LD A,($5E0C)  ; Fetch the temperature (#R$5E0C).
 $6E9E JR C,$6EBC    ; If there's carry set (this could be either from #R$6E99 or #R$6E81)
                     ; then jump to #R$6EBC.
@label=DrawTemperatureGauge
*$6EA0 LD HL,$5162   ; Set the screen location of the temperature gauge,
                     ; #N($5162, $04, $04).
 $6EA3 CALL $6EDE    ; Draw the temperature gauge using #R$6EDE.
; Handle the fuel gauge.
 $6EA6 LD A,($5E0B)  ; Fetch the fuel level (#R$5E0B).
 $6EA9 LD HL,$5122   ; Set the screen location of the fuel gauge, #N($5122,
                     ; $04, $04).
 $6EAC JP $6EDE      ; Draw the fuel gauge using #R$6EDE.
; Handle the temperature gauge at maximum speed.
@label=TemperatureMaxSpeed
*$6EAF LD A,($5E0C)  ; Fetch the temperature (#R$5E0C).
; Check if the temperature is already at the upper limit.
 $6EB2 CP $C0        ; {If the current temperature is more than #N$C0 jump to
 $6EB4 JR NC,$6EA0   ; #R$6EA0.}
; Go ahead and increase the temperature...
 $6EB6 INC A         ; Increase the temperature by one.
@label=UpdateTemperature
*$6EB7 LD ($5E0C),A  ; Write the new temperature back to #R$5E0C.
 $6EBA JR $6EA0      ; Jump to #R$6EA0.
; Handles dropping the temperature gauge.
@label=TemperatureDrop
*$6EBC AND A         ; {If the current temperature is at zero jump to #R$6EA0.
 $6EBD JR Z,$6EA0    ; }
 $6EBF DEC A         ; Decrease the temperature by one.
 $6EC0 JR $6EB7      ; Jump to #R$6EB7.

; Divide By Thirty-Two
;
; Used by the routine at #R$6D73.
; .
; Shifts #REGhl right by five bits, which divides it by #N$20.
;
;   HL Value
; O:HL Value divided by #N$20
@label=DivideByThirtyTwo
c$6EC2 LD B,$05      ; Set the shift counter to #N$05.
@label=DivideByThirtyTwo_Loop
*$6EC4 SRL H         ; Shift #REGh right, moving bit 0 into the carry flag.
 $6EC6 RR L          ; Rotate the carry flag into #REGl from the top.
 $6EC8 DJNZ $6EC4    ; Decrease the shift counter by one and loop back to #R$6EC4 until all
                     ; five shifts have been done.
 $6ECA RET           ; Return.

; Screen Address One Pixel Above
;
; Used by the routines at #R$699D, #R$6A39, #R$7170 and #R$71BC.
; .
; Calculates the new address for writing a sprite pixel, in an upward
; direction, taking into consideration the screen memory layout.
;
;   HL Current position
; O:HL Address for new position
@label=ScreenPosition1PixelAbove
c$6ECB DEC H         ; Decrement #REGh to move up one pixel on screen.
 $6ECC LD A,H        ; {Store the inverted result in #REGa.
 $6ECD CPL           ; }
 $6ECE AND %00000111 ; Keep only bits 0-2.
 $6ED0 RET NZ        ; If a character line has not been crossed then return.
 $6ED1 LD A,L        ; {Else subtract #N$20 from #REGl.
 $6ED2 SUB $20       ;
 $6ED4 LD L,A        ; }
 $6ED5 CPL           ; Invert the bits in #REGa.
 $6ED6 AND %11100000 ; Keep only bits 5-7.
 $6ED8 RET Z         ; If a new section of the screen has not been crossed then
                     ; return.
 $6ED9 LD A,H        ; {Else add #N$08 to #REGh and return.
 $6EDA ADD A,$08     ;
 $6EDC LD H,A        ;
 $6EDD RET           ; }
; View the equivalent code in;
; #LIST
; { #ATICATAC$9F03 }
; { #LUNARJETMAN$85F6 }
; { #UNDERWURLDE$AE71 }
; LIST#

; Draw Gauge Line
;
; Used by the routines at #R$6D73 and #R$6E43.
;
; HL Screen location to draw the gauge
; A Current Gauge Level
;
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$5F07,stop=$5F29,clear=1,sp=$5E00)
; #SIM(start=$5FEF,stop=$6010,sp=$5E00)
; #POKES$5E0B,$60;$5E0C,$80
; #SIM(start=$6010,stop=$6EA0,sp=$5E00)
; #SCR$03,$00,$0F,$08,$06(draw-gauge-before)
; | #SIM(start=$6EA0,stop=$6A87)
; #SCR$03,$00,$0F,$08,$06(draw-gauge-after) } UDGTABLE# #POPS
@label=DrawGaugeLine
c$6EDE SRL A         ; {Scale the gauge level down by #N$04 to give the number of pixels to
 $6EE0 SRL A         ; fill, in #REGc.
 $6EE2 LD C,A        ; }
; Decrease gauge count by #N$08 and keep looping around until what's left is <
; #N$08 - then handle this part separately.
@label=DrawGaugeLine_Loop
*$6EE3 LD A,C        ; {Take #N$08 away from the pixel count.
 $6EE4 SUB $08       ; }
 $6EE6 JR C,$6EF0    ; If gauge count < #N$08 then jump to #R$6EF0.
 $6EE8 LD C,A        ; Keep the remaining pixel count in #REGc.
 $6EE9 LD A,$FF      ; Set a full line of pixels, #N$FF.
 $6EEB CALL $6EFD    ; Draw a full cell of the gauge using #R$6EFD.
 $6EEE JR $6EE3      ; Jump to #R$6EE3.
; Handles drawing the last section of the gauge level.
@label=DrawGaugeScreen_Last
*$6EF0 LD B,$00      ; Create an offset in #REGbc (#REGb=#N$00, #REGc=gauge
                     ; count).
 $6EF2 PUSH HL       ; Stash the gauge screen location temporarily.
 $6EF3 LD HL,$6F07   ; {Point #REGhl at the gauge data (#R$6F07 + the remaining pixel
 $6EF6 ADD HL,BC     ; count).}
 $6EF7 LD A,(HL)     ; Fetch the pixels for the end of the gauge.
 $6EF8 POP HL        ; Restore the gauge screen location from the stack.
 $6EF9 CALL $6EFD    ; Call #R$6EFD.
 $6EFC XOR A         ; #REGa=#N$00 (no pixels - i.e. masking).
; Writes #REGa to the screen.
@label=DrawGaugeScreen
*$6EFD PUSH HL       ; Stash the gauge screen location temporarily.
 $6EFE LD B,$07      ; #REGb=#N$07 (counter for number of lines to draw).
@label=DrawGaugeScreen_Loop
*$6F00 LD (HL),A     ; Write #REGa to the screen location held by #REGhl.
 $6F01 INC H         ; Increment #REGh by one to move onto the next row.
 $6F02 DJNZ $6F00    ; Decrease counter by one and loop back to #R$6F00 until
                     ; counter is zero.
 $6F04 POP HL        ; Restore the original gauge screen location from the
                     ; stack.
 $6F05 INC L         ; Increment #REGl by one to move onto the next column.
 $6F06 RET           ; Return.
; Gauge data; each value corresponds to a "full" line for #N$09 decreasing values. This completes the "end"
;       section when drawing a gauge line.
@label=GaugeData
 $6F07 DEFB $00      ; {#UDG(#PC)
 $6F08 DEFB $80      ;
 $6F09 DEFB $C0      ;
 $6F0A DEFB $E0      ;
 $6F0B DEFB $F0      ;
 $6F0C DEFB $F8      ;
 $6F0D DEFB $FC      ;
 $6F0E DEFB $FE      ;
 $6F0F DEFB $FF      ; }

; Calculate Screen Address
;
; Used by the routines at #R$5F97, #R$63FF, #R$6483, #R$64F0, #R$6518, #R$6557,
; #R$6919, #R$699D, #R$70B2 and #R$70D2.
; .
; Converts pixel co-ordinates into the matching address in the screen
; buffer.
;
;   HL Pixel co-ordinates (#REGh is the Y position, counting down from the top
; .    of the screen, and #REGl is the X position)
; O:HL Screen buffer address
@label=ScreenAddress
c$6F10 LD A,L        ; #REGa=#REGl.
 $6F11 RRCA          ; {#REGa=#REGa / #N$08.
 $6F12 RRCA          ;
 $6F13 RRCA          ; }
 $6F14 AND %00011111 ; Keep only bits 0-4.
 $6F16 LD L,A        ; #REGl=#REGa.
 $6F17 LD A,H        ; #REGa=#REGh.
 $6F18 RLCA          ; {#REGa=#REGa * #N$04.
 $6F19 RLCA          ; }
 $6F1A AND %11100000 ; Keep only bits 5-7.
 $6F1C OR L          ; Set the bits from #REGl.
 $6F1D LD L,A        ; #REGl=#REGa.
 $6F1E LD A,H        ; #REGa=#REGh.
 $6F1F AND %00000111 ; Keep only bits 0-2.
 $6F21 EX AF,AF'     ; Switch to the shadow #REGaf register.
 $6F22 LD A,H        ; #REGa=#REGh.
 $6F23 RRCA          ; {#REGa=#REGa / #N$08.
 $6F24 RRCA          ;
 $6F25 RRCA          ; }
 $6F26 AND %00011000 ; Keep only bits 3-4.
 $6F28 OR %01000000  ; Set bit 6.
 $6F2A LD H,A        ; #REGh=#REGa.
 $6F2B EX AF,AF'     ; Switch to the shadow #REGaf register.
 $6F2C OR H          ; Set the bits from #REGh.
 $6F2D LD H,A        ; #REGh=#REGa.
 $6F2E RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9BA2 }
; { #COOKIE$76E3 }
; { #JETPAC$7308 }
; { #LUNARJETMAN$851E }
; { #MARTIANOIDS$BD4B }
; { #PSSST$759A }
; { #SABREWULF$B8AD }
; { #UNDERWURLDE$ADF8 }
; LIST#

; Multiply A By DE
;
; Used by the routine at #R$6D73.
; .
; Multiplies #REGa by #REGde, by adding #REGde to the result for each bit
; of #REGa which is set.
;
;   A The first number
;   DE The second number
; O:HL Result
@label=MultiplyAByDE
c$6F2F LD HL,$0000   ; #REGhl=#N($0000, $04, $04).
 $6F32 LD B,$08      ; Set the bit counter to #N$08.
@label=MultiplyAByDE_Loop
*$6F34 ADD HL,HL     ; Shift the result left.
 $6F35 RLCA          ; Rotate the next bit of #REGa into the carry flag.
 $6F36 JR NC,$6F39   ; Jump to #R$6F39 if the bit is not set.
 $6F38 ADD HL,DE     ; Add #REGde to the result.
@label=MultiplyAByDE_Next
*$6F39 DJNZ $6F34    ; Decrease the bit counter by one and loop back to #R$6F34 until all
                     ; #N$08 bits have been used.
 $6F3B RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CE0D }
; { #ATICATAC$9AAD }
; { #GUNFRIGHT$D03E }
; { #KNIGHTLORE$D4F9 }
; { #NIGHTSHADE$E0EE }
; { #SABREWULF$BC5A }
; { #UNDERWURLDE$AC68 }
; LIST#

; Place Object
;
; Used by the routine at #R$6B47.
; .
; Works out where an object found by #R$6B47 is on the screen and draws
; it. The object's slot in the table at #R$5E50 is found (or a free slot is
; used), the old sprite is erased, the new one is drawn and coloured, and then
; the car is checked to see if it has hit the object. The car is at the centre
; of the play area, so the screen position of the object is its distance from
; the car (#R$5E17 and #R$5E18) added to, or subtracted from, the position of
; the car (#N$98 and #N$68).
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$5F07,stop=$5F29,clear=1,sp=$5E00)
; #SIM(start=$5FEF,stop=$6010,sp=$5E00)
; #POKES$5E05,$C0;$5E06,$0C;$5E08,$98;$5E09,$05
; #SIM(start=$6BFE,stop=$6C29,sp=$5E00)
; #SIM(start=$6010,stop=$6BC8,sp=$5E00)
; #SCR$04,$11,$11,$06,$05(place-object-before)
; | #SIM(start=$6BC8,stop=$6BCB)
; #SCR$04,$11,$11,$06,$05(place-object-after) } UDGTABLE# #POPS
;
; .
;
; Work out the Y position. Return if the object is off the top or bottom
; of the screen.
@label=PlaceObject
c$6F3C LD A,($5E13)  ; {Fetch the quadrant of the object (#R$5E13) and keep it
 $6F3F LD C,A        ; in #REGc.}
 $6F40 INC A         ; Increment #REGa by one.
 $6F41 AND %00000011 ; Keep only bits 0-1.
 $6F43 BIT 1,A       ; Test bit 1.
 $6F45 LD A,($5E18)  ; Fetch the vertical distance from the car (#R$5E18).
 $6F48 JR NZ,$6F4C   ; Jump to #R$6F4C if bit 1 was set.
 $6F4A NEG           ; Make the distance negative.
@label=PlaceObject_AddCarY
*$6F4C ADD A,$68     ; #REGa=#REGa + #N$68 (the Y position of the car).
 $6F4E CP $C0        ; {Return if the Y position is #N$C0 or more.
 $6F50 RET NC        ; }
 $6F51 CP $10        ; {Return if the Y position is less than #N$10.
 $6F53 RET C         ; }
 $6F54 LD ($5E15),A  ; Write the Y position to #R$5E15.
 $6F57 LD H,A        ; Keep the Y position in #REGh.
; Work out the X position. Return if the object is off the left or right
; of the screen.
 $6F58 LD A,($5E17)  ; Fetch the horizontal distance from the car (#R$5E17).
 $6F5B CP $58        ; {Return if the distance is #N$58 or more.
 $6F5D RET NC        ; }
 $6F5E BIT 1,C       ; {Jump to #R$6F64 if the object is to the right of the
 $6F60 JR Z,$6F64    ; car.}
 $6F62 NEG           ; Make the distance negative.
@label=PlaceObject_AddCarX
*$6F64 ADD A,$98     ; #REGa=#REGa + #N$98 (the X position of the car).
 $6F66 LD ($5E14),A  ; Write the X position to #R$5E14.
 $6F69 LD L,A        ; Keep the X position in #REGl.
; Collected cups are not drawn, and place names are drawn as a fuel pump
; (sprite #N$07).
 $6F6A LD A,($5E1F)  ; Fetch the sprite ID of the map point (#R$5E1F).
 $6F6D CP $60        ; {Return if this is a collected cup.
 $6F6F RET Z         ; }
 $6F70 CP $20        ; {Jump to #R$6F7A if this is a cup.
 $6F72 JR Z,$6F7A    ; }
 $6F74 BIT 6,A       ; {Jump to #R$6F7A if this is not a place name.
 $6F76 JR Z,$6F7A    ; }
 $6F78 LD A,$07      ; Use the fuel pump sprite, #N$07.
@label=PlaceObject_Sprite
*$6F7A LD ($5E1E),A  ; Write the sprite ID to #R$5E1E.
 $6F7D PUSH HL       ; Stash the screen position on the stack.
 $6F7E EX DE,HL      ; Keep the screen position in #REGde.
; Look for the object in the table of objects that are already on the
; screen; it is the same object if it is within #N$0A pixels in both directions.
 $6F7F LD B,$07      ; Set the slot counter to #N$07 (the number of object
                     ; slots).
 $6F81 LD HL,$5E51   ; Point #REGhl at the X position of the first object
                     ; (#R$5E51).
@label=PlaceObject_Search
*$6F84 LD A,(HL)     ; Fetch the X position of the object in the slot.
 $6F85 SUB E         ; Subtract the new X position.
 $6F86 JP P,$6F8B    ; Jump to #R$6F8B if the difference is positive.
 $6F89 NEG           ; Make the difference positive.
@label=PlaceObject_CompareX
*$6F8B CP $0A        ; {Jump to #R$6FAC if the object is #N$0A or more pixels
 $6F8D JR NC,$6FAC   ; away.}
 $6F8F INC HL        ; Move on to the Y position.
 $6F90 LD A,(HL)     ; Fetch the Y position of the object in the slot.
 $6F91 SUB D         ; Subtract the new Y position.
 $6F92 JP P,$6F97    ; Jump to #R$6F97 if the difference is positive.
 $6F95 NEG           ; Make the difference positive.
@label=PlaceObject_CompareY
*$6F97 CP $0A        ; {Jump to #R$6FAD if the object is #N$0A or more pixels
 $6F99 JR NC,$6FAD   ; away.}
; The object is already on the screen. Store its old state so that the old
; sprite is erased when the new one is drawn.
 $6F9B PUSH HL       ; Stash the address of the Y position on the stack.
 $6F9C DEC HL        ; {Move back to the sprite ID.
 $6F9D DEC HL        ; }
 $6F9E PUSH HL       ; {Point #REGix at the object (using the stack to do so).
 $6F9F POP IX        ; }
 $6FA1 LD A,($5E1E)  ; Fetch the new sprite ID (#R$5E1E).
 $6FA4 LD (HL),A     ; Write the new sprite ID to the object.
 $6FA5 CALL $71ED    ; Copy the details of the object using #R$71ED.
 $6FA8 POP HL        ; Restore the address of the Y position from the stack.
 $6FA9 POP DE        ; Restore the screen position from the stack.
 $6FAA JR $6FC1      ; Jump to #R$6FC1.
; Move on to the next object.
@label=PlaceObject_Next
*$6FAC INC HL        ; Increment #REGhl by one.
@label=PlaceObject_Skip
*$6FAD INC HL        ; {Increment #REGhl by two (to the X position of the next
 $6FAE INC HL        ; object).}
 $6FAF DJNZ $6F84    ; Decrease the slot counter by one and loop back to #R$6F84 until all
                     ; of the slots have been checked.
; The object is not on the screen yet, so look for a free slot.
 $6FB1 POP DE        ; Restore the screen position from the stack.
 $6FB2 LD HL,$5E50   ; Point #REGhl at the first object slot (#R$5E50).
 $6FB5 LD B,$07      ; Set the slot counter to #N$07 (the number of object
                     ; slots).
 $6FB7 XOR A         ; Set #REGa to #N$00.
 $6FB8 LD ($5E22),A  ; Write #REGa to #R$5E22 (there is no old sprite to
                     ; erase).
; This entry point is used by the routine at #R$7024.
@label=PlaceObject_FindSlot
*$6FBB LD A,(HL)     ; Fetch the sprite ID of the slot.
 $6FBC AND A         ; Test whether the slot is empty.
 $6FBD JR NZ,$7024   ; Jump to #R$7024 if the slot is used.
 $6FBF INC HL        ; {Move on to the Y position.
 $6FC0 INC HL        ; }
; Store the object in its slot.
@label=PlaceObject_Store
*$6FC1 LD (HL),D     ; Write the Y position.
; See #POKE(invisible_obstacles,Invisible Obstacles).
 $6FC2 DEC HL        ; Move back to the X position.
 $6FC3 LD (HL),E     ; Write the X position.
 $6FC4 DEC HL        ; Move back to the sprite ID.
 $6FC5 LD A,($5E1E)  ; Fetch the new sprite ID (#R$5E1E).
 $6FC8 OR %10000000  ; Set bit 7 (so that #R$6AF5 knows that the object is still in
                     ; view).
 $6FCA LD (HL),A     ; Write the sprite ID.
 $6FCB PUSH HL       ; {#REGix=#REGhl (using the stack to do so).
 $6FCC POP IX        ; }
 $6FCE LD A,($5E1F)  ; Fetch the sprite ID of the map point (#R$5E1F).
 $6FD1 CP $20        ; {Jump to #R$6FDA if this is a cup.
 $6FD3 JR Z,$6FDA    ; }
 $6FD5 AND %01111111 ; Keep only bits 0-6.
 $6FD7 CALL $64F0    ; Display the place name using #R$64F0.
; Erase the old sprite, draw the new one and colour it.
@label=PlaceObject_Draw
*$6FDA CALL $7101    ; Draw the object using #R$7101.
 $6FDD LD L,(IX+$01) ; Fetch the X position of the object.
 $6FE0 LD H,(IX+$02) ; Fetch the Y position of the object.
 $6FE3 LD A,($5E42)  ; {Fetch the attribute of the object (#R$5E42) and keep it
 $6FE6 LD D,A        ; in #REGd.}
 $6FE7 CALL $7052    ; Colour the object using #R$7052.
; Check if the car is near enough to the object to have hit it.
 $6FEA LD A,($5E17)  ; Fetch the horizontal distance from the car (#R$5E17).
; See #POKE(immune_to_obstacles,Immune To Obstacles).
 $6FED CP $0A        ; {Return if the object is #N$0A or more pixels away in X.
 $6FEF RET NC        ; }
 $6FF0 LD A,($5E18)  ; Fetch the vertical distance from the car (#R$5E18).
 $6FF3 CP $0A        ; {Return if the object is #N$0A or more pixels away in Y.
 $6FF5 RET NC        ; }
 $6FF6 LD A,($5E1F)  ; Fetch the sprite ID of the map point (#R$5E1F).
 $6FF9 CP $20        ; {Jump to #R$702A if this is a cup.
 $6FFB JR Z,$702A    ; }
 $6FFD BIT 6,A       ; {Jump to #R$7038 if this is not a place name.
 $6FFF JR Z,$7038    ; }
; The car has reached a place. Add #N$50 points the first time that this
; place is visited, and then refuel.
 $7001 LD C,A        ; Keep the place in #REGc.
 $7002 LD A,($5E4F)  ; Fetch the last place visited (#R$5E4F).
 $7005 CP C          ; {Jump to #R$7012 if this is the same place as the last
 $7006 JR Z,$7012    ; one.}
 $7008 LD A,C        ; Fetch the place.
 $7009 LD ($5E4F),A  ; Write the place as the last place visited (#R$5E4F).
 $700C LD BC,$0050   ; Set the points to award, #N($0050, $04, $04).
 $700F CALL $6046    ; Add the points to the score using #R$6046.
@label=PlaceObject_Refuel
*$7012 LD HL,$C0FF   ; Set the fuel to a full tank, #N$C0FF.
 $7015 LD ($5E0A),HL ; Write the fuel to #R$5E0A.
 $7018 LD A,($5E46)  ; Fetch the step counter of the sound (#R$5E46).
 $701B AND %01111111 ; Keep only bits 0-6.
 $701D RET NZ        ; Return if a sound is already being made.
 $701E LD A,$07      ; Set the step counter to #N$07, which starts the refuel
                     ; sound.
 $7020 LD ($5E46),A  ; Write the step counter to #R$5E46.
 $7023 RET           ; Return.

; Next Object Slot
;
; Used by the routine at #R$6F3C.
; .
; Moves on to the next slot when looking for a free slot for an object. If
; all of the slots are used then the object is not drawn.
@label=NextObjectSlot
c$7024 INC HL        ; {Increment #REGhl by three.
 $7025 INC HL        ;
 $7026 INC HL        ; }
 $7027 DJNZ $6FBB    ; Decrease the slot counter by one and loop back to #R$6FBB until all
                     ; of the slots have been checked.
 $7029 RET           ; Return.

; Collect Cup
;
; Used by the routine at #R$6F3C.
; .
; The car has reached a cup. Marks the cup as collected on the map, starts
; the cup sound and then handles picking up the cup.
@label=CollectCup
c$702A LD HL,($5E3A) ; Fetch the pointer to the map point after the cup
                     ; (#R$5E3A).
 $702D DEC HL        ; Move back to the sprite ID.
 $702E LD (HL),$60   ; Write #N$60 (a collected cup) to the map point.
 $7030 LD A,$87      ; Set the step counter to #N$87, which starts the cup
                     ; sound.
 $7032 LD ($5E46),A  ; Write the step counter to #R$5E46.
 $7035 JP $63FF      ; Jump to #R$63FF.

; Hit Object
;
; Used by the routine at #R$6F3C.
; .
; The car has hit an object. Changes the object to a tombstone (sprite
; #N$0F), removes the two cars and makes the player's car explode.
@label=HitObject
c$7038 LD HL,($5E3A) ; Fetch the pointer to the map point after the object
                     ; (#R$5E3A).
 $703B DEC HL        ; Move back to the sprite ID.
 $703C LD (HL),$0F   ; Write #N$0F (a tombstone) to the map point.
; This entry point is used by the routine at #R$6633.
@label=HitObject_DestroyPlayer
*$703E XOR A         ; {Write #N$00 to #LIST { #R$5E8C } { #R$5E98 } LIST#
 $703F LD ($5E8C),A  ;
 $7042 LD ($5E98),A  ; }
 $7045 LD A,$03      ; {Write #N$03 to #R$5E80 (the player's car is exploding).
 $7047 LD ($5E80),A  ; }
 $704A RET           ; Return.

; Colourise Sprite
;
; Used by the routine at #R$6633.
; .
; Sets the attributes under a sprite to the attribute of the actor. The
; sprite is coloured from the bottom upwards and the attributes of the top row
; of the screen and of the border (#N$76) are left alone. Entering at #R$7052
; (#REGd is the attribute and #REGhl is the position of the bottom left of the
; sprite in pixels) or at #R$7064 (#REGb is the width and #REGc is the height in
; attribute cells, #REGd is the attribute and #REGhl is the attribute buffer
; address of the bottom left) uses the normal registers instead of the shadow
; registers.
;
; IX Actor entity
@label=ColouriseSprite
c$704B EXX           ; Switch to the shadow registers.
 $704C LD HL,($5E27) ; Fetch the position of the sprite (#R$5E27).
 $704F LD D,(IX+$03) ; #REGd'=the attribute of the actor.
; This entry point is used by the routine at #R$6F3C.
; .
; Work out the size of the sprite in attribute cells.
@label=ColouriseSprite_Position
*$7052 CALL $7097    ; Call #R$7097 to convert the pixel co-ordinates into an attribute
                     ; buffer address.
 $7055 LD A,($5E24)  ; #REGa=#R$5E24 (the width of the sprite in bytes).
 $7058 LD B,A        ; Keep the width in #REGb.
 $7059 LD A,($5E23)  ; #REGa=#R$5E23 (the height of the sprite in pixels).
 $705C RRCA          ; {#REGa=#REGa / #N$04.
 $705D RRCA          ; }
 $705E INC A         ; Increment #REGa by one.
 $705F RRCA          ; #REGa=#REGa / #N$02.
 $7060 AND %00011111 ; Keep only bits 0-4.
 $7062 INC A         ; Increment #REGa by one.
 $7063 LD C,A        ; #REGc=#REGa (the number of rows).
; This entry point is used by the routine at #R$6A9B.
; .
; Colour each of the rows, going upwards.
@label=ColouriseSprite_Block
*$7064 LD E,B        ; Keep the width in #REGe.
@label=ColouriseSprite_Loop1
*$7065 PUSH HL       ; Stash the address of the start of the row on the stack.
@label=ColouriseSprite_Loop2
*$7066 LD A,H        ; #REGa=#REGh.
 $7067 CP $5B        ; {Jump to #R$7089 if the address is beyond the end of the attribute
 $7069 JR NC,$7089   ; buffer.}
 $706B PUSH HL       ; {Stash #REGhl and #REGbc on the stack.
 $706C PUSH BC       ; }
 $706D LD BC,$5820   ; #REGbc=#N$5820 (the start of the second row of
                     ; attributes).
 $7070 AND A         ; {#REGhl=#REGhl - #REGbc.
 $7071 SBC HL,BC     ; }
 $7073 POP BC        ; {Restore #REGbc and #REGhl from the stack.
 $7074 POP HL        ; }
 $7075 JR C,$7089    ; Jump to #R$7089 if the address is in the top row of
                     ; attributes.
 $7077 LD A,(HL)     ; Fetch the current attribute of the cell.
 $7078 CP $76        ; {Jump to #R$707D if this is a border attribute (#N$76).
 $707A JR Z,$707D    ; }
 $707C LD (HL),D     ; Write the attribute of the actor.
@label=ColouriseSprite_NextColumn
*$707D INC L         ; Move onto the next column.
 $707E LD A,L        ; #REGa=#REGl.
 $707F AND %00011111 ; Keep only bits 0-4.
 $7081 JR NZ,$7087   ; Jump to #R$7087 if the address is still in the same row.
 $7083 LD A,L        ; {Move back to the start of the row (this is for when the actor is
 $7084 SUB $20       ; partly off the right of the screen).
 $7086 LD L,A        ; }
@label=ColouriseSprite_Next
*$7087 DJNZ $7066    ; Decrease the column counter by one and loop back to #R$7066 until
                     ; the whole row has been coloured.
@label=ColouriseSprite_NextRow
*$7089 POP HL        ; Restore the address of the start of the row from the
                     ; stack.
 $708A PUSH BC       ; Stash #REGbc on the stack.
 $708B AND A         ; Clear the carry flag.
 $708C LD BC,$0020   ; Set the size of a row, #N($0020, $04, $04).
 $708F SBC HL,BC     ; Move up a row.
 $7091 POP BC        ; Restore #REGbc from the stack.
 $7092 LD B,E        ; Reset the width counter.
 $7093 DEC C         ; Decrease the row counter by one.
 $7094 JR NZ,$7065   ; Loop back to #R$7065 until all of the rows have been
                     ; coloured.
 $7096 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #LUNARJETMAN$8733 }
; LIST#

; Calculate Attribute Address
;
; Used by the routines at #R$5F97, #R$6518, #R$65B1 and #R$704B.
;
;   HL Pixel address co-ordinates
; O:HL Attribute buffer address
;
; Converts a given pixel address to the associated attribute buffer address.
@label=AttributeAddress
c$7097 LD A,L        ; Horizontal co-ordinate.
 $7098 RRCA          ; {Divide by #N$08.
 $7099 RRCA          ;
 $709A RRCA          ; }
 $709B AND %00011111 ; Keep only bits 0-4 (#N$00-#N$1F / minimum-maximum
                     ; horizontal screen values).
 $709D LD L,A        ; Store this back in #REGl.
 $709E LD A,H        ; Vertical co-ordinate.
 $709F RLCA          ; {Multiply by #N$04.
 $70A0 RLCA          ; }
 $70A1 LD C,A        ; Store this in #REGc temporarily.
 $70A2 AND %11100000 ; Keep only bits 5-7.
 $70A4 OR L          ; Set the bits from #REGl.
 $70A5 LD L,A        ; #REGl=#REGa.
 $70A6 LD A,C        ; Fetch the stored value from #REGc.
 $70A7 AND %00000011 ; Keep only bits 0-1.
 $70A9 OR %01011000  ; Set MSB of the attribute buffer #N$58. This ensures our value
                     ; is >= #N$5800.
 $70AB LD H,A        ; Store this back in #REGh.
 $70AC RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9BD2 }
; { #COOKIE$7534 }
; { #JETPAC$720E }
; { #LUNARJETMAN$8506 }
; { #PSSST$748F }
; { #UNDERWURLDE$ADE0 }
; LIST#

; Get Visible Height
;
; Used by the routines at #R$70B2 and #R$70D2.
; .
; Works out how many lines of a sprite can be drawn upwards from a
; position without reaching the top row of the screen (which is not part of the
; play area).
;
;   H Y position of the sprite
; O:C Number of lines
@label=GetVisibleHeight
c$70AD LD A,H        ; Fetch the Y position of the sprite.
 $70AE SUB $08       ; Take #N$08 away, as the top row of the screen is not part of the
                     ; play area.
 $70B0 LD C,A        ; Keep the number of lines that can be drawn in #REGc.
 $70B1 RET           ; Return.

; Prepare Old Sprite
;
; Used by the routines at #R$7101 and #R$7139.
; .
; Prepares to erase the sprite of an actor from where it was last drawn,
; using the old state held in the actor buffer at #R$5E20. Points #REGde to the
; sprite data, #REGhl to the screen address, stores the pixel shift in #R$5E40
; and the number of lines to erase in #R$5E25.
;
; O:DE Sprite data (after the height)
; O:HL Screen address of the bottom left of the sprite
; O:C #N$00
@label=PrepareOldSprite
c$70B2 CALL $7155    ; Call #R$7155 to fetch the sprite.
 $70B5 LD HL,($5E20) ; Fetch the old position of the sprite (#R$5E20).
 $70B8 LD A,L        ; #REGa=#REGl.
 $70B9 NEG           ; Make #REGa negative.
 $70BB AND %00000111 ; Keep only bits 0-2.
 $70BD LD ($5E40),A  ; Write the pixel shift to #R$5E40.
 $70C0 CALL $70AD    ; Work out how many lines can be drawn using #R$70AD.
 $70C3 CALL $6F10    ; Convert the position into a screen address using
                     ; #R$6F10.
 $70C6 LD A,(DE)     ; Fetch the height of the sprite.
 $70C7 CP C          ; {Jump to #R$70CB if the height is no more than the number of lines
 $70C8 JR C,$70CB    ; that can be drawn.}
 $70CA LD A,C        ; Use the number of lines that can be drawn, as the sprite is too
                     ; tall.
@label=PrepareOldSprite_Rows
*$70CB LD ($5E25),A  ; Write the number of lines to #R$5E25.
; View the equivalent code in;
; #LIST
; { #COOKIE$7557 }
; { #PSSST$7542 }
; LIST#
; .
; Continue on to #R$70CE.

; Skip Sprite Height
;
; Used by the routine at #R$70D2.
; .
; Points #REGde to the sprite data (after the height) and clears the line
; counter.
;
;   DE Sprite
; O:DE Sprite data
; O:C #N$00
@label=NextSprite
c$70CE LD C,$00      ; #REGc=#N$00.
 $70D0 INC DE        ; Increment #REGde by one to point to the next sprite
                     ; header value.
 $70D1 RET           ; Return.

; Prepare Actor Sprite
;
; Used by the routines at #R$7101 and #R$7149.
; .
; Prepares to draw the sprite of an actor at its new position. Points
; #REGde to the sprite data and #REGhl to the screen address, stores the pixel
; shift in #R$5E41, the width in bytes in #R$5E24 and the number of lines to
; draw in #R$5E26 and #R$5E23.
;
;   IX Actor entity
; O:DE Sprite data (after the height)
; O:HL Screen address of the bottom left of the sprite
; O:C #N$00
@label=PrepareActorSprite
c$70D2 CALL $7168    ; Call #R$7168 to fetch the sprite.
@label=PrepareActorSprite_Position
 $70D5 LD L,(IX+$01) ; #REGl=X position of the actor.
 $70D8 LD H,(IX+$02) ; #REGh=Y position of the actor.
; This entry point is used by the routines at #R$646C and #R$687B.
@label=PrepareActorSprite_Shift
*$70DB LD A,L        ; #REGa=#REGl.
 $70DC NEG           ; Make #REGa negative.
 $70DE AND %00000111 ; Keep only bits 0-2.
 $70E0 LD ($5E41),A  ; Write the pixel shift to #R$5E41.
 $70E3 LD A,$02      ; Set the width of the sprite in bytes, #N$02.
 $70E5 JR Z,$70E8    ; Jump to #R$70E8 if the sprite is not shifted.
 $70E7 INC A         ; Increment #REGa by one (a shifted sprite is one byte
                     ; wider).
@label=PrepareActorSprite_Width
*$70E8 LD ($5E24),A  ; Write the width to #R$5E24.
 $70EB LD ($5E27),HL ; Write the position to #R$5E27.
 $70EE CALL $70AD    ; Work out how many lines can be drawn using #R$70AD.
 $70F1 CALL $6F10    ; Convert the position into a screen address using
                     ; #R$6F10.
 $70F4 LD A,(DE)     ; Fetch the height of the sprite.
 $70F5 CP C          ; {Jump to #R$70F9 if the height is no more than the number of lines
 $70F6 JR C,$70F9    ; that can be drawn.}
 $70F8 LD A,C        ; Use the number of lines that can be drawn, as the sprite is too
                     ; tall.
@label=PrepareActorSprite_Rows
*$70F9 LD ($5E26),A  ; Write the number of lines to #R$5E26.
 $70FC LD ($5E23),A  ; Write the number of lines to #R$5E23.
 $70FF JR $70CE      ; Jump to #R$70CE.
; View the equivalent code in;
; #LIST
; { #COOKIE$7584 }
; LIST#

; Display Entity
;
; Used by the routines at #R$6318, #R$6633 and #R$6F3C.
; .
; Erases the sprite of an actor from where it was last drawn (the old
; state held in the actor buffer at #R$5E20) and draws it at its new position.
; Both sprites are handled a line at a time by #R$7170, but if the old and the
; new Y positions are different then the lines of one sprite that stick out
; below the other are handled first.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$5F07,stop=$5F29,clear=1,sp=$5E00)
; #SIM(start=$5FEF,stop=$6010,sp=$5E00)
; #POKES$5E05,$C0;$5E06,$0C;$5E08,$98;$5E09,$05
; #SIM(start=$6BFE,stop=$6C29,sp=$5E00)
; #SIM(start=$6010,stop=$6FDA,sp=$5E00)
; #SCR$04,$11,$11,$06,$05(display-entity-before)
; | #SIM(start=$6FDA,stop=$6FDD)
; #SCR$04,$11,$11,$06,$05(display-entity-after) } UDGTABLE# #POPS
;
; IX Actor entity
@label=DisplayEntity
c$7101 LD A,($5E22)  ; Fetch the sprite ID of the old sprite (#R$5E22).
 $7104 AND A         ; {Jump to #R$7149 if there is no old sprite, as there is nothing to
 $7105 JP Z,$7149    ; erase.}
 $7108 CALL $70D2    ; Call #R$70D2 to prepare the new sprite.
 $710B EXX           ; Switch to the shadow registers (to keep the new sprite).
 $710C CALL $70B2    ; Call #R$70B2 to prepare the old sprite.
 $710F LD A,($5E21)  ; #REGa=#R$5E21 (the old Y position).
 $7112 SUB (IX+$02)  ; Subtract the new Y position.
 $7115 JP Z,$71D1    ; Jump to #R$71D1 if the old and new Y positions are the
                     ; same.
 $7118 JP M,$712A    ; Jump to #R$712A if the new sprite is lower down than the
                     ; old sprite.
 $711B LD C,A        ; #REGc=the number of lines that the old sprite sticks out below the
                     ; new sprite.
 $711C LD A,($5E25)  ; #REGa=#R$5E25 (the number of lines in the old sprite).
 $711F CP C          ; {Jump to #R$71D1 if the old sprite has fewer lines than
 $7120 JP C,$71D1    ; this.}
 $7123 SUB C         ; Subtract the lines that stick out.
 $7124 LD ($5E25),A  ; Write the number of lines left to #R$5E25.
 $7127 JP $7170      ; Jump to #R$7170 to erase the lines that stick out.
; The new sprite is lower down, so it has some lines to draw before any
; lines are erased.
@label=DisplayEntity_NewLower
*$712A EXX           ; Switch to the shadow registers (the new sprite).
 $712B NEG           ; Make the result positive.
 $712D LD C,A        ; #REGc=the number of lines that the new sprite sticks out below the
                     ; old sprite.
 $712E LD A,($5E26)  ; #REGa=#R$5E26 (the number of lines in the new sprite).
 $7131 CP C          ; {Jump to #R$71D0 if the new sprite has fewer lines than
 $7132 JP C,$71D0    ; this.}
 $7135 SUB C         ; Subtract the lines that stick out.
 $7136 JP $71E4      ; Jump to #R$71E4 to store the number of lines left and to draw the
                     ; lines that stick out.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9FCA }
; { #COOKIE$75CC }
; { #JETPAC$726A }
; { #PSSST$74EB }
; { #SABREWULF$B9A9 }
; { #UNDERWURLDE$96F7 }
; LIST#

; Remove Entity
;
; Used by the routines at #R$6353, #R$6633 and #R$6B12.
; .
; Erases the sprite of an actor from where it was last drawn (the old
; state held in the actor buffer at #R$5E20), without drawing it again.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$5F07,stop=$5F29,clear=1,sp=$5E00)
; #SIM(start=$5FEF,stop=$6010,sp=$5E00)
; #POKES$5E05,$C0;$5E06,$0C;$5E08,$98;$5E09,$05
; #SIM(start=$6BFE,stop=$6C29,sp=$5E00)
; #SIM(start=$6010,stop=$6FEA,sp=$5E00)
; #SCR$04,$11,$11,$06,$05(remove-entity-before)
; | #SIM(start=$6B1B,stop=$6B21)
; #SCR$04,$11,$11,$06,$05(remove-entity-after) } UDGTABLE# #POPS
@label=RemoveEntity
c$7139 CALL $70B2    ; Call #R$70B2 to prepare the old sprite.
 $713C EXX           ; Switch to the shadow registers.
 $713D XOR A         ; Set #REGa to #N$00.
 $713E LD C,A        ; #REGc=#REGa (there are no lines of the new sprite to
                     ; draw).
 $713F LD ($5E26),A  ; {Write #N$00 to; #LIST { #R$5E26 } { #R$5E23 } LIST#
 $7142 LD ($5E23),A  ; }
 $7145 EXX           ; Switch back to the normal registers.
 $7146 JP $7170      ; Jump to #R$7170.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9F56 }
; { #COOKIE$7607 }
; { #JETPAC$72A5 }
; { #PSSST$7526 }
; { #SABREWULF$B8F5 }
; { #UNDERWURLDE$9636 }
; LIST#

; Draw Entity
;
; Used by the routine at #R$7101.
; .
; Draws the sprite of an actor at its position, when there is no old
; sprite to erase.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$5F07,stop=$5F29,clear=1,sp=$5E00)
; #SIM(start=$5FEF,stop=$6010,sp=$5E00)
; #POKES$5E05,$C0;$5E06,$0C;$5E08,$98;$5E09,$05
; #SIM(start=$6BFE,stop=$6C29,sp=$5E00)
; #SIM(start=$6010,stop=$7149,sp=$5E00)
; #SCR$04,$11,$11,$06,$05(draw-entity-before)
; | #SIM(start=$7149,stop=$6FDD)
; #SCR$04,$11,$11,$06,$05(draw-entity-after) } UDGTABLE# #POPS
;
; IX Actor entity
@label=DrawEntity
c$7149 CALL $70D2    ; Call #R$70D2 to prepare the new sprite.
; This entry point is used by the routines at #R$646C and #R$687B.
@label=DrawEntity_NoOldSprite
*$714C EXX           ; Switch to the shadow registers.
 $714D XOR A         ; {Write #N$00 to #R$5E25 (there are no lines of the old sprite to
 $714E LD ($5E25),A  ; erase).}
 $7151 LD C,A        ; #REGc=#REGa.
 $7152 JP $7170      ; Jump to #R$7170.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9F4A }
; { #COOKIE$7617 }
; { #JETPAC$72B5 }
; { #SABREWULF$B919 }
; { #UNDERWURLDE$962A }
; LIST#

; Fetch Sprite
;
; Used by the routine at #R$70B2.
; .
; Finds the sprite for the sprite ID in the actor buffer (#R$5E22), or
; when entering at #R$7158 the sprite for the sprite ID in #REGa. The sprite
; data starts with the height in lines. Each line is two bytes.
;
; O:DE Sprite
@label=FetchSprite
c$7155 LD A,($5E22)  ; Fetch the sprite ID from the actor buffer (#R$5E22).
; This entry point is used by the routine at #R$7168.
@label=GetSprite
*$7158 DEC A         ; {Work out the offset into the table of sprites.
 $7159 SLA A         ; }
 $715B AND %01111110 ; Keep only bits 1-6.
 $715D LD HL,$7F06   ; #REGhl=#R$7F06.
 $7160 LD C,A        ; {Create an offset in #REGbc.
 $7161 LD B,$00      ; }
 $7163 ADD HL,BC     ; #REGhl=#R$7F06 + offset.
 $7164 LD E,(HL)     ; {#REGde=fetch sprite address pointed to by #REGhl.
 $7165 INC HL        ;
 $7166 LD D,(HL)     ; }
 $7167 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #COOKIE$7623 }
; { #LUNARJETMAN$8568 }
; { #UNDERWURLDE$9646 }
; LIST#

; Fetch Actor Sprite
;
; Used by the routine at #R$70D2.
; .
; Finds the sprite for the sprite ID of an actor.
;
;   IX Actor entity
; O:DE Sprite
@label=FetchActorSprite
c$7168 LD A,(IX+$00) ; Load the sprite ID from the currently active actor.
 $716B JR $7158      ; Jump to #R$7158.
; View the equivalent code in;
; #LIST
; { #UNDERWURLDE$9652 }
; LIST#

; Erase Line Without Shift
;
; Used by the routine at #R$7170.
; .
; Used by #R$7170 when the sprite is not shifted. Puts the screen address
; in #REGhl, keeping the sprite pointer on the stack, and carries on with the
; first byte of the line.
@label=MaskSprite_Unshifted
c$716D EX (SP),HL    ; Swap #REGhl with the value on the stack.
 $716E JR $718F      ; Jump to #R$718F.

; Mask Sprite
;
; Used by the routines at #R$7101, #R$7139, #R$7149, #R$71BC and #R$71CB.
; .
; Erases the old sprite and draws the new sprite, a line at a time going
; up the screen. One line of the old sprite is erased by clearing its bits from
; the screen, then one line of the new sprite is drawn, and so on until both are
; done. The old sprite is held in the normal registers and the new sprite in the
; shadow registers. In each set #REGc holds the number of lines left, #REGde the
; sprite data and #REGhl the screen address.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$5F07,stop=$5F29,clear=1,sp=$5E00)
; #SIM(start=$5FEF,stop=$6010,sp=$5E00)
; #POKES$5E05,$C0;$5E06,$0C;$5E08,$98;$5E09,$05
; #SIM(start=$6BFE,stop=$6C29,sp=$5E00)
; #SIM(start=$6010,stop=$7170,sp=$5E00)
; #SCR$04,$11,$11,$06,$05(mask-sprite-before)
; | #SIM(start=$7170,stop=$6FDD)
; #SCR$04,$11,$11,$06,$05(mask-sprite-after) } UDGTABLE# #POPS
@label=MaskSprite
c$7170 LD A,C        ; {Jump to #R$71CB if there are no more lines of the old
 $7171 AND A         ; sprite.
 $7172 JR Z,$71CB    ; }
 $7174 DEC C         ; Decrease the number of lines left by one.
 $7175 PUSH HL       ; Stash the screen address on the stack.
 $7176 LD A,($5E40)  ; {Fetch the number of pixels to shift by (#R$5E40) and keep the pixel
 $7179 LD B,A        ; shift in #REGb.}
 $717A EX DE,HL      ; #REGhl=sprite data and #REGde=screen address.
 $717B PUSH DE       ; Stash the screen address on the stack.
 $717C LD D,(HL)     ; #REGd=the first byte of this line of the sprite.
 $717D INC HL        ; Increment the sprite data pointer by one.
 $717E LD E,(HL)     ; #REGe=the second byte of this line of the sprite.
 $717F INC HL        ; Increment the sprite data pointer by one.
 $7180 AND A         ; {Jump to #R$716D if the sprite is not shifted.
 $7181 JR Z,$716D    ; }
 $7183 EX DE,HL      ; #REGhl=sprite data and #REGde=this line of the sprite.
 $7184 XOR A         ; #REGa=#N$00.
@label=MaskSprite_ShiftErase
*$7185 ADD HL,HL     ; Shift the line of the sprite left.
 $7186 ADC A,A       ; Rotate the bit that was shifted out into #REGa.
 $7187 DJNZ $7185    ; Decrease counter by one and loop back to #R$7185 until counter is
                     ; zero.
 $7189 EX DE,HL      ; #REGde=the shifted line of the sprite and #REGhl=sprite
                     ; data.
 $718A EX (SP),HL    ; #REGhl=screen address (the sprite data pointer goes on
                     ; the stack).
 $718B CPL           ; Invert the bits of the first byte of the line.
 $718C AND (HL)      ; Remove the bits from the screen.
 $718D LD (HL),A     ; Write the byte back to the screen.
 $718E INC L         ; Move onto the next screen byte.
; This entry point is used by the routine at #R$716D.
@label=MaskSprite_EraseBytes
*$718F LD A,D        ; #REGa=#REGd.
 $7190 CPL           ; Invert the bits.
 $7191 AND (HL)      ; Remove the bits from the screen.
 $7192 LD (HL),A     ; Write the byte back to the screen.
 $7193 INC L         ; Move onto the next screen byte.
 $7194 LD A,E        ; #REGa=#REGe.
 $7195 CPL           ; Invert the bits.
 $7196 AND (HL)      ; Remove the bits from the screen.
 $7197 LD (HL),A     ; Write the byte back to the screen.
 $7198 POP DE        ; Restore the sprite data pointer from the stack.
 $7199 POP HL        ; Restore the screen address of the start of the line from
                     ; the stack.
 $719A CALL $6ECB    ; Call #R$6ECB to move up a line.
; Now draw one line of the new sprite.
 $719D EXX           ; Switch to the shadow registers (the new sprite).
 $719E LD A,C        ; #REGa=#REGc.
 $719F AND A         ; {Jump to #R$71C8 if there are no more lines of the new
 $71A0 JR Z,$71C8    ; sprite.}
; This entry point is used by the routine at #R$71CB.
@label=MaskSprite_Draw
*$71A2 DEC C         ; Decrease the number of lines left by one.
 $71A3 PUSH HL       ; Stash the screen address on the stack.
 $71A4 LD A,($5E41)  ; {Fetch the number of pixels to shift by (#R$5E41) and keep the pixel
 $71A7 LD B,A        ; shift in #REGb.}
 $71A8 EX DE,HL      ; #REGhl=sprite data and #REGde=screen address.
 $71A9 PUSH DE       ; Stash the screen address on the stack.
 $71AA LD D,(HL)     ; #REGd=the first byte of this line of the sprite.
 $71AB INC HL        ; Increment the sprite data pointer by one.
 $71AC LD E,(HL)     ; #REGe=the second byte of this line of the sprite.
 $71AD INC HL        ; Increment the sprite data pointer by one.
 $71AE AND A         ; {Jump to #R$71EA if the sprite is not shifted.
 $71AF JR Z,$71EA    ; }
 $71B1 EX DE,HL      ; #REGhl=sprite data and #REGde=this line of the sprite.
 $71B2 XOR A         ; #REGa=#N$00.
@label=MaskSprite_ShiftDraw
*$71B3 ADD HL,HL     ; Shift the line of the sprite left.
 $71B4 ADC A,A       ; Rotate the bit that was shifted out into #REGa.
 $71B5 DJNZ $71B3    ; Decrease counter by one and loop back to #R$71B3 until counter is
                     ; zero.
 $71B7 EX DE,HL      ; #REGde=the shifted line of the sprite and #REGhl=sprite
                     ; data.
 $71B8 EX (SP),HL    ; #REGhl=screen address (the sprite data pointer goes on
                     ; the stack).
 $71B9 OR (HL)       ; Merge the first byte of the line with the screen.
 $71BA LD (HL),A     ; Write the byte back to the screen.
 $71BB INC L         ; Move onto the next screen byte.
; View the equivalent code in;
; #LIST
; { #LUNARJETMAN$8A5C }
; LIST#

; Draw Two Bytes
;
; Used by the routine at #R$71EA.
; .
; Draws the last two bytes of a line of the new sprite and moves up a
; line.
@label=DrawTwoBytes
c$71BC LD A,D        ; #REGa=#REGd.
 $71BD OR (HL)       ; {Merge the bits from #REGhl with #REGd and write the result back to
 $71BE LD (HL),A     ; #REGhl.}
 $71BF INC L         ; Increment #REGl by one.
 $71C0 LD A,E        ; #REGa=#REGe.
 $71C1 OR (HL)       ; {Merge the bits from #REGhl with #REGe and write the result back to
 $71C2 LD (HL),A     ; #REGhl.}
 $71C3 POP DE        ; {Restore #REGde and #REGhl from the stack.
 $71C4 POP HL        ; }
 $71C5 CALL $6ECB    ; Call #R$6ECB.
; This entry point is used by the routine at #R$7170.
@label=MaskSprite_Next
*$71C8 EXX           ; Switch to the normal registers.
 $71C9 JR $7170      ; Jump to #R$7170.

; Update Sprite Size
;
; Used by the routine at #R$7170.
; .
; Used by #R$7170 when all of the lines of the old sprite have been
; erased. If there are lines of the new sprite left then they are drawn,
; otherwise the number of lines left of both sprites is updated, so that the
; lines which stick out can be handled.
@label=ActorUpdateSizeNext
c$71CB EXX           ; Switch to the shadow registers (the new sprite).
 $71CC LD A,C        ; #REGa=#REGc.
 $71CD AND A         ; Test the number of lines left.
 $71CE JR NZ,$71A2   ; Jump to #R$71A2 if there are lines of the new sprite
                     ; left to draw.
; This entry point is used by the routine at #R$7101.
@label=ActorUpdateSizeFlipReg
*$71D0 EXX           ; Switch to the normal registers.
; This entry point is used by the routine at #R$7101.
@label=ActorUpdateSize
*$71D1 LD A,($5E25)  ; {Fetch the number of lines left of the old sprite (#R$5E25) and keep
 $71D4 LD C,A        ; it in #REGc.}
 $71D5 LD A,($5E26)  ; Fetch the number of lines left of the new sprite
                     ; (#R$5E26).
 $71D8 OR C          ; Combine the lines left of the old sprite and the new
                     ; sprite.
 $71D9 RET Z         ; Return if there are no lines left in either.
 $71DA XOR A         ; {Write #N$00 to #R$5E25.
 $71DB LD ($5E25),A  ; }
 $71DE EXX           ; Switch to the shadow registers.
 $71DF LD A,($5E26)  ; {Fetch the number of lines left of the new sprite (#R$5E26) and keep
 $71E2 LD C,A        ; it in #REGc.}
 $71E3 XOR A         ; Set #REGa to #N$00.
; This entry point is used by the routine at #R$7101.
@label=ActorUpdateHeightAndMask
*$71E4 LD ($5E26),A  ; Write the number of lines left of the new sprite to
                     ; #R$5E26.
 $71E7 EXX           ; Switch to the normal registers.
 $71E8 JR $7170      ; Jump to #R$7170.

; Draw Line Without Shift
;
; Used by the routine at #R$7170.
; .
; Used by #R$7170 when the sprite is not shifted. Puts the screen address
; in #REGhl, keeping the sprite pointer on the stack, and draws the line.
@label=MaskSprite_DrawUnshifted
c$71EA EX (SP),HL    ; Swap #REGhl with the value on the stack.
 $71EB JR $71BC      ; Jump to #R$71BC.

; Store Entity
;
; Used by the routines at #R$6318, #R$6633, #R$6B12 and #R$6F3C.
; .
; Copies the position and the sprite ID of an actor into the actor buffer
; at #R$5E20, so that its sprite can be erased from there the next time it is
; drawn.
;
; IX Actor entity
@label=StoreEntity
c$71ED LD A,(IX+$01) ; {Copy the X position of the actor to #R$5E20.
 $71F0 LD ($5E20),A  ; }
 $71F3 LD A,(IX+$02) ; {Copy the Y position of the actor to #R$5E21.
 $71F6 LD ($5E21),A  ; }
 $71F9 LD A,(IX+$00) ; {Copy the sprite ID of the actor to #R$5E22.
 $71FC LD ($5E22),A  ; }
 $71FF RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$9FFB }
; { #COOKIE$76D0 }
; { #JETPAC$7327 }
; { #PSSST$75B9 }
; { #SABREWULF$BB0B }
; { #UNDERWURLDE$989F }
; LIST#

; Reset Attribute Buffer
;
; Used by the routine at #R$68A0.
; .
; Sets the border to black, clears the screen with #R$7211, then fills the
; attribute file with the background attribute at #R$5E44.
; #PUSHS #UDGTABLE(default,centre,centre)
; { =h Before | =h After }
; { #POKES$5C36,$00;$5C37,$3C
; #SIM(start=$5F07,stop=$5F29,clear=1,sp=$5E00)
; #SIM(start=$5FEF,stop=$6010,sp=$5E00)
; #SIM(start=$6010,stop=$6A87,sp=$5E00)
; #SCR$01(reset-attributes-before)
; | #SIM(start=$68BB,stop=$68BE)
; #SCR$01(reset-attributes-after) } UDGTABLE# #POPS
@label=ResetAttributes
c$7200 XOR A         ; {Set the border to #INK$00.
 $7201 OUT ($FE),A   ; }
 $7203 CALL $7211    ; Call #R$7211.
 $7206 LD HL,$5800   ; Point #REGhl at the attribute buffer (#N$5800).
 $7209 LD B,$5B      ; #REGb=#N$5B (i.e. finish once we reach the end of the attribute
                     ; buffer).
 $720B LD A,($5E44)  ; {Fetch the background attribute (#R$5E44) as the value
 $720E LD C,A        ; to write.}
 $720F JR $7218      ; Jump to #R$7218.
; View the equivalent code in;
; #LIST
; { #ATICATAC$80C2 }
; { #COOKIE$74E2 }
; { #JETPAC$71C6 }
; { #LUNARJETMAN$84BB }
; { #PSSST$7447 }
; { #SABREWULF$BB8F }
; LIST#

; Reset Screen Buffer
;
; Used by the routine at #R$7200.
; .
; Clears the display file by filling it with #N$00. The screen attributes
; are left as they were.
@label=ResetScreen
c$7211 LD HL,$4000   ; #REGhl=#N$4000 (screen buffer).
 $7214 LD B,$58      ; #REGb=#N$58 (i.e. finish once we reach the start of the attribute
                     ; buffer).
 $7216 LD C,$00      ; #REGc=#N$00 (value to write).
; View the equivalent code in;
; #LIST
; { #ALIENEIGHT$CE60 }
; { #ATICATAC$80B4 }
; { #COOKIE$74D4 }
; { #CYBERUN$9A7E }
; { #GUNFRIGHT$D6DB }
; { #JETPAC$71B8 }
; { #KNIGHTLORE$D544 }
; { #LUNARJETMAN$84AD }
; { #NIGHTSHADE$E5A8 }
; { #PSSST$7439 }
; { #SABREWULF$BB81 }
; LIST#
; .
; Continue on to #R$7218 to blank the screen buffer.

; Fill Memory
;
; Used by the routine at #R$7200.
;
; HL Target address
; B Single byte representing the MSB of the end address (will always end on LSB
; . #N$00)
; C Value to write
@label=ResetCopier
c$7218 LD (HL),C     ; Write #REGc to the target address.
 $7219 INC HL        ; Increment the target address by one.
 $721A LD A,H        ; {Are we finished yet? Check the MSB of the target vs.
 $721B CP B          ; #REGb.}
 $721C JR C,$7218    ; Keep looping back to #R$7218 until there is no
                     ; carry-over.
 $721E RET           ; Return.
; View the equivalent code in;
; #LIST
; { #ATICATAC$80BB }
; { #COOKIE$74DB }
; { #JETPAC$71BF }
; { #LUNARJETMAN$84B4 }
; { #PSSST$7440 }
; { #SABREWULF$BB88 }
; LIST#

; Cup Table
;
; Links to the entry in #R$7811 for every cup. The Y position of each cup
; is chosen at random when a round starts (see #R$6498).
@label=CupTable
w$721F DEFW $783B    ; Cup #N($01 + (#PC - $721F) / $02).
 $7221 DEFW $78B6    ; Cup #N($01 + (#PC - $721F) / $02).
 $7223 DEFW $796D    ; Cup #N($01 + (#PC - $721F) / $02).
 $7225 DEFW $7A0F    ; Cup #N($01 + (#PC - $721F) / $02).
 $7227 DEFW $7AC9    ; Cup #N($01 + (#PC - $721F) / $02).
 $7229 DEFW $7B5C    ; Cup #N($01 + (#PC - $721F) / $02).
 $722B DEFW $7C0D    ; Cup #N($01 + (#PC - $721F) / $02).
 $722D DEFW $7CAC    ; Cup #N($01 + (#PC - $721F) / $02).

; Messaging: Place Names
;
; The names of the places that can be visited. A place on the map has bit
; 6 of its sprite ID set and the rest of the ID is the number of its name in
; this list (see #R$64F0). The last character of each name has bit 7 set.
@label=PlaceNames
t$722F DEFM " LOS ANGELE","S"+$80   ; "LOS ANGELES".
 $723B DEFM "SAN FRANCISC","O"+$80  ; "SAN FRANCISCO".
 $7248 DEFM "  SAN DIEG","O"+$80    ; "SAN DIEGO".
 $7253 DEFM "   SEATTL","E"+$80     ; "SEATTLE".
