 $5A00 DEFB $47,$47,$47,$47,$47,$47,$47,$47,$47,$47,$47,$47,$47,$47,$47,$47,$47,$47,$00,$47,$47,$47,$47,$47,$47,$47,$47,$47,$47,$47,$46,$46 ;
