[Player:Car]
#TABLE(default,centre,centre,centre,centre)
  { =h,c4 Day Colours }
  { =h Frame 1 | =h Frame 2 | =h Frame 3 | =h Frame 4 }
  { #CAR$00,attr=$72(car-01-colour*) | #CAR$01,attr=$72(car-02-colour*) | #CAR$02,attr=$72(car-03-colour*) | #CAR$03,attr=$72(car-04-colour*) }
  { =h Frame 5 | =h Frame 6 | =h Frame 7 | =h Frame 8 }
  { #CAR$04,attr=$72(car-05-colour*) | #CAR$05,attr=$72(car-06-colour*) | #CAR$06,attr=$72(car-07-colour*) | #CAR$07,attr=$72(car-08-colour*) }
  { =h Frame 9 | =h Frame 10 | =h Frame 11 | =h Frame 12 }
  { #CAR$08,attr=$72(car-09-colour*) | #CAR$09,attr=$72(car-0A-colour*) | #CAR$0A,attr=$72(car-0B-colour*) | #CAR$0B,attr=$72(car-0C-colour*) }
  { =h Frame 13 | =h Frame 14 | =h Frame 15 | =h Frame 16 }
  { #CAR$0C,attr=$72(car-0D-colour*) | #CAR$0D,attr=$72(car-0E-colour*) | #CAR$0E,attr=$72(car-0F-colour*) | #CAR$0F,attr=$72(car-10-colour*) }
TABLE#

#FRAMES(car-01-colour,10;car-02-colour;car-03-colour;car-04-colour;car-05-colour;car-06-colour;car-07-colour;car-08-colour;car-09-colour;car-0A-colour;car-0B-colour;car-0C-colour;car-0D-colour;car-0E-colour;car-0F-colour;car-10-colour)(car-colour-ani)

